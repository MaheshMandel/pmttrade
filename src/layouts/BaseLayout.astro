---
import { fitMetaDescription } from '../lib/metaDescription';
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import {
  LOCALES,
  LOCALE_BCP47,
  LOCALE_HREFLANG,
  LOCALE_DIR,
  DEFAULT_LOCALE,
  type Locale,
} from '../i18n/config';
import { switchLocalePath, localizedPath } from '../i18n/utils';
import { SALE_END } from '../data/sale';
import { subscriptionOfferExtras } from '../lib/schema';
import { publicAssetExists } from '../lib/media';
import pricingConfig from '../../public/pricing-config.json';
import untranslatedGuides from '../data/untranslatedGuides.json';

// Sale cutover as epoch ms — exposed to the client as window.SALE_END so the
// banner countdown and the dynamic pricing both read one shared value.
const saleEndMs = new Date(SALE_END).getTime();
const saleActive = !Number.isFinite(saleEndMs) || saleEndMs > Date.now();

// JSON-LD Offer prices previously hardcoded the pre-sale figures (135/500),
// disagreeing with the live banner and pricing cards, which both read
// pricing-config.json. Site-wide Offer.price should reflect what a visitor
// actually pays right now, not the regular price — falls back to
// regularPrice (the true list price) once the sale ends, not the inflated
// originalPrice used only as the banner's crossed-out anchor.
const quarterlyPlan = Object.values(pricingConfig.plans).find(
  (p: any) => p.enabled && p.period === '91 Days',
) as { price: number; regularPrice?: number } | undefined;
const annualPlan = Object.values(pricingConfig.plans).find(
  (p: any) => p.enabled && p.period === 'year',
) as { price: number; regularPrice?: number } | undefined;
const currentPrice = (plan: { price: number; regularPrice?: number } | undefined, fallback: number) =>
  plan == null ? fallback : saleActive ? plan.price : (plan.regularPrice ?? plan.price);
const quarterlyDisplayPrice = currentPrice(quarterlyPlan, 135);
const annualDisplayPrice = currentPrice(annualPlan, 500);

// Computed against regularPrice (the true list price, 500) rather than the
// banner's inflated originalPrice (600) anchor, so this claim can't overstate
// the real discount — reads live, never goes stale once the sale ends.
const annualRegularPrice = annualPlan?.regularPrice ?? 500;
const annualPercentOff = saleActive
  ? Math.round((1 - annualDisplayPrice / annualRegularPrice) * 100)
  : 0;
const saleDescriptionSuffix =
  annualPercentOff > 0 ? ` Save ${annualPercentOff}% on the annual plan for a limited time.` : '';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  ogImage?: string;
  ogType?: string;
  robots?: string;
  canonical?: string;
  ldJson?: object | object[];
  keywords?: string;
  // English-only pages (no translated versions exist): emit no hreflang alternates for other locales.
  englishOnly?: boolean;
}

const {
  locale,
  title: rawTitle,
  description: rawDescription,
  ogImage = '/assets/og-default.webp',
  ogType = 'website',
  robots,
  canonical: canonicalOverride,
  ldJson,
  keywords,
  englishOnly = false,
} = Astro.props;

// SERP titles truncate around 60 chars and measured CTR drops past that. Pages
// append " | PickMyTrade" on their own, so when a title runs long, drop the
// brand suffix (the domain already carries the brand) rather than editing
// every page. Titles still over 60 after this need shortening at the source.
const MAX_TITLE_LENGTH = 60;
const title =
  rawTitle.length > MAX_TITLE_LENGTH
    ? rawTitle.replace(/\s*[|\-–—]\s*PickMyTrade\s*$/, '')
    : rawTitle;

// Keep the snippet within what search results display (see lib/metaDescription.ts).
const metaDescription = fitMetaDescription(rawDescription);

const site = Astro.site ?? new URL('http://localhost:4321');

// FE-29: a how-to/debugging guide whose locale copy is still the English text is
// kept out of the index (noindex,follow), canonicalised to the English URL and
// carries no locale hreflang. Generated by scripts/find-untranslated-guides.mjs.
const _segments = Astro.url.pathname.split('/').filter(Boolean);
const _hasLocalePrefix = _segments.length > 0 && (LOCALES as readonly string[]).includes(_segments[0]) && _segments[0] !== DEFAULT_LOCALE;
const _guideKey = _hasLocalePrefix ? _segments.slice(1, 3).join('/') : '';
const untranslatedLocalePage =
  _hasLocalePrefix &&
  ((untranslatedGuides as Record<string, string[]>)[_guideKey] ?? []).includes(_segments[0]);

// Every other locale page is translated and indexable.
const robotsDirective = untranslatedLocalePage
  ? 'noindex, follow'
  : robots ??
    'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1';

// ~345 how-to/debugging pages pass an ogImage that doesn't exist in public/
// (screenshot never captured) — fall back to the site default rather than
// advertising a 404 og:image/twitter:image in the social preview and SERP.
const DEFAULT_OG_IMAGE = '/assets/og-default.webp';
const resolvedOgImage = publicAssetExists(ogImage) ? ogImage : DEFAULT_OG_IMAGE;
const ogImageUrl = new URL(resolvedOgImage, site).href;

// Same 404 images leak into page-level Article/etc. schema `image` fields
// (each page builds its own ldJson object with a hardcoded path). Rather than
// edit every page, sanitize any `image` string in the merged ldJson here: if
// it doesn't resolve to a real public/ file, point it at the same fallback.
function sanitizeSchemaImages(node: unknown): unknown {
  if (Array.isArray(node)) return node.map(sanitizeSchemaImages);
  if (node !== null && typeof node === 'object') {
    const out: Record<string, unknown> = {};
    for (const [key, value] of Object.entries(node as Record<string, unknown>)) {
      if (key === 'image' && typeof value === 'string') {
        let pathname: string | null = null;
        try {
          pathname = new URL(value).pathname;
        } catch {
          pathname = value.startsWith('/') ? value : null;
        }
        out[key] = pathname && publicAssetExists(pathname)
          ? value
          : new URL(DEFAULT_OG_IMAGE, site).href;
        continue;
      }
      out[key] = sanitizeSchemaImages(value);
    }
    return out;
  }
  return node;
}

// Normalize to a single trailing-slash form so canonical + hreflang match the sitemap
const withSlash = (p: string) => (p.endsWith('/') ? p : `${p}/`);
const path = withSlash(Astro.url.pathname);
const canonical = untranslatedLocalePage
  ? new URL(withSlash(switchLocalePath(path, DEFAULT_LOCALE)), site).href
  : canonicalOverride ?? new URL(path, site).href;

const alternates = (englishOnly || untranslatedLocalePage ? [DEFAULT_LOCALE] : LOCALES).map((l) => ({
  hreflang: LOCALE_HREFLANG[l],
  href: new URL(withSlash(switchLocalePath(path, l)), site).href,
}));
// Only the 404 page passes robots="noindex" (plain, no follow).
const isErrorPage = robots === 'noindex';
const xDefault = new URL(
  withSlash(switchLocalePath(path, DEFAULT_LOCALE)),
  site,
).href;

// Canonical entity IDs so AI engines resolve ONE Organization across every page.
const SITE_URL = 'https://pickmytrade.trade';
const ORG_ID = `${SITE_URL}/#organization`;
const SOFTWARE_ID = `${SITE_URL}/#software`;
const WEBSITE_ID = `${SITE_URL}/#website`;
const PRICING_URL = `${SITE_URL}/pages/pricing/`;

// Declared external profiles AI models use for entity resolution.
const orgSameAs = [
  // Third-party profiles only: no own domains, blogs or Discord invite (FE-31).
  'https://x.com/pickmytrade',
  'https://www.instagram.com/pickmytrade',
  'https://www.linkedin.com/company/pickmytrade',
  'https://www.youtube.com/@PickMyTrade',
  'https://sourceforge.net/software/product/PickMyTrade/',
  'https://www.trustpilot.com/review/pickmytrade.trade',
  // TODO: add Wikidata Q-item URL once created.
];

const organizationNode = {
  '@type': 'Organization',
  '@id': ORG_ID,
  name: 'PickMyTrade',
  url: SITE_URL,
  logo: {
    '@type': 'ImageObject',
    url: `${SITE_URL}/assets/logo.webp`,
  },
  description:
    'Company behind PickMyTrade, a TradingView-to-broker automation platform for futures, forex, options and CFD traders.',
  foundingDate: '2023', // only the year is verified
  sameAs: orgSameAs,
  contactPoint: {
    '@type': 'ContactPoint',
    email: 'support@pickmytrade.com',
    contactType: 'customer support',
  },
};

// SoftwareApplication is now its own @id-linked entity (no longer type-mixed with
// Organization), and advertises the REAL paid pricing instead of price:0.
const softwareNode = {
  '@type': 'SoftwareApplication',
  '@id': SOFTWARE_ID,
  name: 'PickMyTrade',
  url: SITE_URL,
  applicationCategory: 'FinanceApplication',
  operatingSystem: 'Web',
  description:
    `TradingView-to-broker automation platform for futures, forex, options and CFD trading. Connects TradingView alerts to Tradovate, Rithmic, TradeStation, Interactive Brokers, TradeLocker, ProjectX, and other brokers.${saleDescriptionSuffix}`,
  publisher: { '@id': ORG_ID },
  offers: [
    {
      '@type': 'Offer',
      name: 'Monthly',
      price: 50,
      priceCurrency: 'USD',
      category: 'subscription',
      availability: 'https://schema.org/InStock',
      url: PRICING_URL,
      ...subscriptionOfferExtras,
    },
    {
      '@type': 'Offer',
      name: 'Quarterly',
      price: quarterlyDisplayPrice,
      priceCurrency: 'USD',
      category: 'subscription',
      availability: 'https://schema.org/InStock',
      url: PRICING_URL,
      ...subscriptionOfferExtras,
    },
    {
      '@type': 'Offer',
      name: 'Annual',
      price: annualDisplayPrice,
      priceCurrency: 'USD',
      category: 'subscription',
      availability: 'https://schema.org/InStock',
      url: PRICING_URL,
      ...subscriptionOfferExtras,
    },
    {
      '@type': 'Offer',
      name: 'Free Trial',
      price: 0,
      priceCurrency: 'USD',
      description: '7-day free trial, no credit card required',
      availability: 'https://schema.org/InStock',
      url: PRICING_URL,
      ...subscriptionOfferExtras,
    },
  ],
};

// WebSite schema with sitelinks searchbox
const websiteNode = {
  '@type': 'WebSite',
  '@id': WEBSITE_ID,
  name: 'PickMyTrade',
  url: SITE_URL,
  publisher: { '@id': ORG_ID },
};

// Single @graph keeps all three entities @id-linked instead of looking like
// separate, unrelated entities to crawlers.
const globalGraph = {
  '@context': 'https://schema.org',
  '@graph': [organizationNode, softwareNode, websiteNode],
};

const globalLdJson = [globalGraph];
const pageLdJson = (
  ldJson
    ? Array.isArray(ldJson)
      ? [...globalLdJson, ...ldJson]
      : [...globalLdJson, ldJson]
    : globalLdJson
).map(sanitizeSchemaImages);
---

<!doctype html>
<html
  lang={LOCALE_BCP47[locale]}
  dir={LOCALE_DIR[locale]}>
  <head>
    <meta charset='UTF-8' />
    <meta
      name='viewport'
      content='width=device-width, initial-scale=1, viewport-fit=cover'
    />
    <meta
      name='generator'
      content={Astro.generator}
    />

    <title>{title}</title>
    <meta
      name='description'
      content={metaDescription}
    />
    <meta
      name='robots'
      content={robotsDirective}
    />
    {
      keywords && (
        <meta
          name='keywords'
          content={keywords}
        />
      )
    }
    <meta
      name='author'
      content='PickMyTrade'
    />
    {
      /* The 404 page is served for unknown URLs and is noindex: no canonical/hreflang
         pointing at a non-existent /404/ route. */
      !isErrorPage && (
        <link
          rel='canonical'
          href={canonical}
        />
      )
    }

    {
      !isErrorPage &&
        alternates.map((alt) => (
          <link
            rel='alternate'
            hreflang={alt.hreflang}
            href={alt.href}
          />
        ))
    }
    {
      !isErrorPage && (
        <link
          rel='alternate'
          hreflang='x-default'
          href={xDefault}
        />
      )
    }

    <meta
      property='og:type'
      content={ogType}
    />
    <meta
      property='og:site_name'
      content='PickMyTrade'
    />
    <meta
      property='og:title'
      content={title}
    />
    <meta
      property='og:description'
      content={metaDescription}
    />
    <meta
      property='og:url'
      content={canonical}
    />
    <meta
      property='og:image'
      content={ogImageUrl}
    />
    <meta
      property='og:image:width'
      content='1200'
    />
    <meta
      property='og:image:height'
      content='630'
    />
    <meta
      property='og:locale'
      content={LOCALE_BCP47[locale]}
    />
    {
      LOCALES.filter((l) => l !== locale).map((l) => (
        <meta
          property='og:locale:alternate'
          content={LOCALE_BCP47[l]}
        />
      ))
    }

    <meta
      name='twitter:card'
      content='summary_large_image'
    />
    <meta
      name='twitter:site'
      content='@pickmytrade'
    />
    <meta
      name='twitter:title'
      content={title}
    />
    <meta
      name='twitter:description'
      content={metaDescription}
    />
    <meta
      name='twitter:image'
      content={ogImageUrl}
    />

    <link
      rel='icon'
      type='image/png'
      sizes='16x16'
      href='/assets/logo.png'
    />
    <link
      rel='icon'
      type='image/webp'
      href='/assets/logo.webp'
    />

    <!-- Preconnects -->
    <link
      rel='preconnect'
      href='https://fonts.googleapis.com'
    />
    <link
      rel='preconnect'
      href='https://fonts.gstatic.com'
      crossorigin
    />
    <link
      rel='preconnect'
      href='https://cdnjs.cloudflare.com'
    />

    <!-- Font Awesome — async swap-in via print-media trick (same pattern as the
         Google Fonts link below) so it no longer blocks first paint; icons pop
         in once the stylesheet loads instead of delaying render. -->
    <link
      rel='stylesheet'
      href='https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css'
      crossorigin='anonymous'
      referrerpolicy='no-referrer'
      media='print'
      onload="this.media='all'"
    />
    <noscript>
      <link
        rel='stylesheet'
        href='https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css'
        crossorigin='anonymous'
        referrerpolicy='no-referrer'
      />
    </noscript>

    <!-- Inter + Electrolize fonts — non-blocking -->
    <link
      href='https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Electrolize&display=optional'
      rel='stylesheet'
      media='print'
      onload="this.media='all'"
    />

    <!-- Speculation Rules: prefetch the highest-traffic next-click targets so
         the following navigation starts from a warm cache. `moderate` fires on
         hover/pointerdown rather than eagerly, so this costs nothing for
         visitors who never head that way. Prefetch (document only) rather than
         prerender — no third-party script executes ahead of a real click. -->
    <script
      type='speculationrules'
      is:inline
      set:html={JSON.stringify({
        prefetch: [
          {
            source: 'list',
            urls: [
              localizedPath(locale, 'pages/pricing'),
              localizedPath(locale, 'supported-propfirms'),
              localizedPath(locale, 'compare'),
            ],
            eagerness: 'moderate',
          },
        ],
      })}
    />

    <!-- Sale cutover (single source of truth: src/data/sale.ts) — read by the
         banner countdown and the dynamic pricing renderer -->
    <script
      is:inline
      set:html={`window.SALE_END=${saleEndMs};`}
    />

    <!-- Structured data: org + website always; page-specific ldJson merged in -->
    {
      pageLdJson.map((item) => (
        <script
          type='application/ld+json'
          set:html={JSON.stringify(item)}
        />
      ))
    }

    <!-- UTM first-touch attribution + referral cookie — must run synchronously before any redirect -->
    <script is:inline>
      (function () {
        var params = new URLSearchParams(window.location.search);
        var utmKeys = [
          'utm_source',
          'utm_medium',
          'utm_campaign',
          'utm_content',
          'utm_term',
        ];
        var captured = {};
        utmKeys.forEach(function (key) {
          var val = params.get(key);
          if (val) captured[key] = val;
        });
        var host = window.location.hostname;
        var isIp = /^\d{1,3}(\.\d{1,3}){3}$/.test(host);
        var isLocal = host === 'localhost';
        if (!captured.utm_source) {
          if (document.cookie.indexOf('pmt_utm=') !== -1) {
            var expiry = 'expires=Thu, 01 Jan 1970 00:00:00 GMT';
            document.cookie = 'pmt_utm=; ' + expiry + '; path=/; SameSite=Lax';
            if (!isIp && !isLocal) {
              var hp = host.split('.');
              var clearDomain =
                hp.length >= 2 ? '.' + hp.slice(-2).join('.') : host;
              document.cookie =
                'pmt_utm=; ' +
                expiry +
                '; path=/; domain=' +
                clearDomain +
                '; SameSite=Lax';
            }
          }
          return;
        }
        var expires = new Date();
        expires.setDate(expires.getDate() + 30);
        var cookieParts = [
          'pmt_utm=' + encodeURIComponent(JSON.stringify(captured)),
          'expires=' + expires.toUTCString(),
          'path=/',
        ];
        if (!isIp && !isLocal) {
          var parts = host.split('.');
          var rootDomain =
            parts.length >= 2 ? '.' + parts.slice(-2).join('.') : host;
          cookieParts.push('domain=' + rootDomain);
        }
        cookieParts.push('SameSite=Lax');
        document.cookie = cookieParts.join('; ');
      })();
      // FE-26: read only ?referral= (or legacy ?ref=). The old queryString.split('=')[1]
      // took the value of whichever param came first (e.g. utm_source=x), corrupting attribution.
      (function () {
        var qs = new URLSearchParams(window.location.search);
        var referralCode = qs.get('referral') || qs.get('ref');
        if (!referralCode || !/^[\w-]{1,64}$/.test(referralCode)) return;
        var host = window.location.hostname;
        var parts = [
          'referral=' + encodeURIComponent(referralCode),
          'max-age=' + 30 * 24 * 60 * 60,
          'path=/',
        ];
        if (!/^\d{1,3}(\.\d{1,3}){3}$/.test(host) && host !== 'localhost') {
          var hp = host.split('.');
          parts.push(
            'domain=' + (hp.length >= 2 ? '.' + hp.slice(-2).join('.') : host)
          );
        }
        parts.push('SameSite=Lax');
        document.cookie = parts.join('; ');
      })();
    </script>
  </head>
  <body class='min-h-dvh flex flex-col'>
    <Navbar locale={locale} />
    <main class='flex-1'>
      <slot />
    </main>
    <Footer locale={locale} />

    <!-- Navbar positioning + sale countdown — run immediately after navbar is in DOM -->
    <script is:inline>
      window.positionNavbar = function positionNavbar() {
        var navBar = document.getElementById('nav-bar');
        if (!navBar) return;
        var h = navBar.offsetHeight + 'px';
        // Only write when it actually changes — avoids a forced reflow/repaint every tick.
        if (document.body.style.paddingTop !== h) {
          document.body.style.paddingTop = h;
          document.documentElement.style.setProperty('--navbar-height', h);
        }
      };

      var SALE_TARGET_DATE = window.SALE_END;
      var saleBannerState = ''; // '', 'shown', or 'hidden' — tracks last applied state

      window.updateSaleBanner = function updateSaleBanner() {
        var saleBanner = document.getElementById('sale-banner');
        if (!saleBanner) return;
        var difference = SALE_TARGET_DATE - Date.now();

        if (difference <= 0) {
          // Hide once; subsequent ticks are no-ops.
          if (saleBannerState !== 'hidden') {
            saleBanner.style.display = 'none';
            saleBannerState = 'hidden';
            window.positionNavbar();
          }
          return;
        }

        // Reveal once; subsequent ticks only refresh countdown numbers (if any).
        if (saleBannerState !== 'shown') {
          saleBanner.style.display = '';
          saleBanner.classList.remove('hidden');
          saleBannerState = 'shown';
          window.positionNavbar();
        }

        var daysEl = document.getElementById('countdown-days');
        var hoursEl = document.getElementById('countdown-hours');
        var minutesEl = document.getElementById('countdown-minutes');
        var secondsEl = document.getElementById('countdown-seconds');
        if (daysEl && hoursEl && minutesEl && secondsEl) {
          daysEl.textContent = Math.floor(difference / (1000 * 60 * 60 * 24));
          hoursEl.textContent = Math.floor(
            (difference % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60),
          );
          minutesEl.textContent = Math.floor(
            (difference % (1000 * 60 * 60)) / (1000 * 60),
          );
          secondsEl.textContent = Math.floor((difference % (1000 * 60)) / 1000);
        }
      };

      window.initCountdown = function initCountdown() {
        window.updateSaleBanner();
        setInterval(window.updateSaleBanner, 1000);
        window.addEventListener('resize', window.positionNavbar);
      };

      window.initCountdown();
    </script>

    <!-- LiveAgent chat — loaded on first user interaction (facade pattern).
         The widget pulls ~18 requests plus its own script execution. Firing on
         requestIdleCallback still landed all of that inside the measurement
         window right after load, where it competed with first paint. Gating on
         the first real signal of engagement (scroll / pointer / touch / key)
         keeps it off the critical path for visitors who bounce, while anyone
         who actually engages still gets the widget within a few hundred ms.
         A long idle fallback covers passive readers who never interact. -->
    <script is:inline>
      (function () {
        var loaded = false;
        var EVENTS = ['pointerdown', 'touchstart', 'keydown', 'scroll', 'mousemove'];

        function loadLiveAgent() {
          if (loaded) return;
          loaded = true;
          EVENTS.forEach(function (e) {
            window.removeEventListener(e, loadLiveAgent, { passive: true });
          });

          var script = document.createElement('script');
          script.id = 'la_x2s6df8d';
          script.defer = true;
          script.src = 'https://pickmytrade.ladesk.com/scripts/track.js';
          script.onload = script.onreadystatechange = function () {
            var rs = this.readyState;
            if (rs && rs !== 'complete' && rs !== 'loaded') return;
            if (typeof LiveAgent !== 'undefined')
              LiveAgent.createButton('vp1ob390', this);
          };
          document.body.appendChild(script);
        }

        function arm() {
          EVENTS.forEach(function (e) {
            window.addEventListener(e, loadLiveAgent, { passive: true, once: true });
          });
          // Fallback so a visitor who reads without interacting still gets chat.
          setTimeout(loadLiveAgent, 15000);
        }

        if (document.readyState === 'complete') {
          arm();
        } else {
          window.addEventListener('load', arm);
        }
      })();
    </script>

    <!-- Locale persistence in localStorage -->
    <script is:inline define:vars={{ locale }}>
      try {
        localStorage.setItem('locale', locale);
      } catch (_) {}
    </script>

    <!-- Lenis smooth scrolling — Vite-processed ES module -->
    <script>
      import Lenis from 'lenis';

      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const lenis = new Lenis({ duration: 1.1 });

        document.querySelectorAll('a[href^="#"]').forEach((link) => {
          link.addEventListener('click', (e) => {
            const id = link.getAttribute('href');
            if (!id || id === '#') return;
            const target = document.querySelector(id);
            if (!target) return;
            e.preventDefault();
            const navBar = document.getElementById('nav-bar');
            const offset = -(navBar?.offsetHeight ?? 80);
            lenis.scrollTo(target as HTMLElement, { offset });
          });
        });

        const raf = (time: number) => {
          lenis.raf(time);
          requestAnimationFrame(raf);
        };
        requestAnimationFrame(raf);
      }
    </script>
  </body>
</html>
