---
import { useTranslations } from "../i18n/utils";
import { LOCALE_BCP47 } from "../i18n/config";
import type { Locale } from "../i18n/config";

interface Props {
  locale: Locale;
  lastUpdated: string; // ISO date, e.g. "2026-07-29"
}

const { locale, lastUpdated } = Astro.props;
const t = useTranslations(locale);

const formatted = new Date(lastUpdated).toLocaleDateString(LOCALE_BCP47[locale], {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<div class="inline-flex flex-wrap items-center gap-2 px-4 py-2 bg-blue-900/20 border border-blue-500/20 rounded-full text-sm text-gray-400 mb-8">
  <i class="fa-solid fa-user-shield text-blue-400 text-xs" aria-hidden="true"></i>
  <span class="text-gray-200 font-medium">{t("byline.reviewed_by")}</span>
  <span class="hidden sm:inline text-blue-400/60 text-xs">({t("byline.credentials")})</span>
  <span class="text-blue-500/40" aria-hidden="true">&middot;</span>
  <span>{t("byline.last_updated")} <time datetime={lastUpdated} class="text-gray-300 font-medium">{formatted}</time></span>
</div>
