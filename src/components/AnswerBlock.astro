---
// FE-45 citability pattern for money pages: a short answer under the H1, one
// fact table with an "as of" date, a "Not supported" list and a visible
// reviewer + updated line. All copy is passed in already translated.
interface Props {
  answer: string;
  factsHeading: string;
  facts: { label: string; value: string }[];
  asOfLabel: string;
  asOfDate: string; // ISO yyyy-mm-dd
  notSupportedHeading: string;
  notSupported: string[];
  reviewedBy: string;
  updatedLabel: string;
  updatedDate: string; // ISO yyyy-mm-dd
  locale: string;
}
const {
  answer, factsHeading, facts, asOfLabel, asOfDate, notSupportedHeading,
  notSupported, reviewedBy, updatedLabel, updatedDate, locale,
} = Astro.props as Props;
const fmt = (iso: string) =>
  new Date(iso + 'T00:00:00Z').toLocaleDateString(locale, { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
---
<section class="py-12 border-b border-blue-900/30 bg-[#002040]" aria-label={factsHeading}>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <p class="text-lg sm:text-xl text-white leading-relaxed mb-6" data-answer-block>{answer}</p>

    <div class="overflow-x-auto rounded-xl border border-blue-500/30">
      <table class="w-full text-left text-sm sm:text-base">
        <caption class="text-left px-4 py-3 font-semibold text-blue-400 bg-blue-900/20">
          {factsHeading} <span class="text-gray-400 font-normal">({asOfLabel} <time datetime={asOfDate}>{fmt(asOfDate)}</time>)</span>
        </caption>
        <tbody>
          {facts.map((f) => (
            <tr class="border-t border-white/10">
              <th scope="row" class="px-4 py-3 font-medium text-gray-300 w-2/5 align-top">{f.label}</th>
              <td class="px-4 py-3 text-white">{f.value}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <h2 class="text-xl font-bold text-white mt-8 mb-3">{notSupportedHeading}</h2>
    <ul class="list-disc pl-6 space-y-2 text-gray-300">
      {notSupported.map((n) => <li>{n}</li>)}
    </ul>

    <p class="mt-6 text-sm text-gray-400">
      {reviewedBy} · {updatedLabel} <time datetime={updatedDate}>{fmt(updatedDate)}</time>
    </p>
  </div>
</section>
