---
import { useTranslations } from "../i18n/utils";
import type { Locale } from "../i18n/config";
import pricingConfig from "../../public/pricing-config.json";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

// Banner pricing is derived from the annual plan in pricing-config.json (the
// same source the JSON-LD Offer in BaseLayout reads) so the crossed-out
// anchor and the sale price shown here can't drift from what's declared
// elsewhere on the page.
const annualPlan = Object.values(pricingConfig.plans).find(
  (p: any) => p.enabled && p.period === "year"
) as { price: number; originalPrice: number | null } | undefined;
const oldPrice = annualPlan?.originalPrice ?? 500;
const newPrice = annualPlan?.price ?? 350;

// Twinkling star field — scattered across the navy background.
const STARS = [
  { top: "22%", left: "40%", size: 5, c: "#F8FAFC", d: "0s" },
  { top: "68%", left: "37%", size: 4, c: "#3B82F6", d: "0.6s" },
  { top: "30%", left: "54%", size: 6, c: "#DC2626", d: "1.1s" },
  { top: "74%", left: "60%", size: 4, c: "#F8FAFC", d: "0.3s" },
  { top: "18%", left: "66%", size: 5, c: "#3B82F6", d: "1.4s" },
  { top: "58%", left: "72%", size: 4, c: "#DC2626", d: "0.9s" },
  { top: "26%", left: "82%", size: 6, c: "#F8FAFC", d: "0.4s" },
  { top: "70%", left: "88%", size: 5, c: "#3B82F6", d: "1.2s" },
  { top: "42%", left: "94%", size: 4, c: "#DC2626", d: "0.7s" },
  { top: "48%", left: "47%", size: 4, c: "#F8FAFC", d: "1.6s" },
];
---

<a id="sale-banner" href="#pricing" class="eb-root" aria-label={t("sale_banner.aria_label")}>
  <div class="eb-banner">

    <!-- Faint city skyline background -->
    <img src="/assets/banner/buildings.webp" class="eb-buildings" alt="" aria-hidden="true" width="900" height="600" loading="lazy" fetchpriority="low" />

    <!-- Twinkling stars across the background -->
    <div class="eb-stars" aria-hidden="true">
      {STARS.map((s) => (
        <span
          class="eb-star"
          style={`top:${s.top};left:${s.left};width:${s.size}px;height:${s.size}px;background:${s.c};animation-delay:${s.d};`}
        />
      ))}
    </div>

    <!-- Waving flag — top-left, bleeds out -->
    <img src="/assets/banner/flag.webp" class="eb-flag" alt="" aria-hidden="true" width="345" height="230" loading="lazy" fetchpriority="low" />

    <!-- Statue of Liberty — bottom-left -->
    <img src="/assets/banner/statue.webp" class="eb-statue" alt="" aria-hidden="true" width="153" height="230" loading="lazy" fetchpriority="low" />

    <!-- Statue of Liberty — bottom-right -->
    <img src="/assets/banner/statue.webp" class="eb-statue-right" alt="" aria-hidden="true" width="153" height="230" loading="lazy" fetchpriority="low" />

    <!-- Three-column grid -->
    <div class="eb-grid">

      <!-- LEFT: combined sale text image -->
      <div class="eb-col-left">
        <img
          src="/assets/banner/sale-text.webp"
          class="eb-sale-text"
          alt="US Independence Sale — Big Savings, Limited Time Only"
          width="563"
          height="375"
          loading="eager"
        />
      </div>

      <div class="eb-divider"></div>

      <!-- CENTER: pricing -->
      <div class="eb-col-center">
        <p class="eb-section-label">
          <span class="eb-rule"></span>{t("sale_banner.limited_deal")}<span class="eb-rule"></span>
        </p>

        <div class="eb-price-card">
          <span class="eb-price-glow" aria-hidden="true"></span>
          <div class="eb-price-stack">
            <span class="eb-price-old">
              <span class="eb-curr-sm">$</span>{oldPrice}
            </span>
            <span class="eb-save-badge">{t("sale_banner.save_pct")}</span>
          </div>
          <span class="eb-price-new">
            <span class="eb-curr-lg">$</span>{newPrice}
            <span class="eb-per-yr">{t("sale_banner.period")}</span>
          </span>
        </div>
      </div>

      <div class="eb-divider"></div>

      <!-- RIGHT: countdown -->
      <div class="eb-col-right">
        <p class="eb-section-label">
          <span class="eb-rule"></span>{t("sale_banner.ends_in")}<span class="eb-rule"></span>
        </p>
        <div class="eb-timer-row" aria-label={t("sale_banner.ends_in")}>
          <div class="eb-cd-unit">
            <div class="eb-timer-box"><span id="countdown-days" class="eb-timer-value">00</span></div>
            <span class="eb-timer-label">{t("sale_banner.unit_days")}</span>
          </div>
          <span class="eb-colon" aria-hidden="true">:</span>
          <div class="eb-cd-unit">
            <div class="eb-timer-box"><span id="countdown-hours" class="eb-timer-value">00</span></div>
            <span class="eb-timer-label">{t("sale_banner.unit_hours")}</span>
          </div>
          <span class="eb-colon" aria-hidden="true">:</span>
          <div class="eb-cd-unit">
            <div class="eb-timer-box"><span id="countdown-minutes" class="eb-timer-value">00</span></div>
            <span class="eb-timer-label">{t("sale_banner.unit_minutes")}</span>
          </div>
          <span class="eb-colon" aria-hidden="true">:</span>
          <div class="eb-cd-unit">
            <div class="eb-timer-box"><span id="countdown-seconds" class="eb-timer-value">00</span></div>
            <span class="eb-timer-label">{t("sale_banner.unit_seconds")}</span>
          </div>
        </div>
      </div>

    </div>
  </div>
</a>

<!-- Self-contained visibility guard: fail-open (shown by default), hide only once the
     sale has actually ended. Runs on every page independently of BaseLayout's script. -->
<script is:inline>
  (function () {
    var el = document.getElementById('sale-banner');
    if (!el) return;
    // Sale cutover comes from the shared global (set by BaseLayout from src/data/sale.ts).
    // If it's missing, fail open (NaN comparison is false) and keep the banner shown.
    if (Date.now() >= window.SALE_END) {
      el.style.display = 'none';
      if (typeof window.positionNavbar === 'function') window.positionNavbar();
    }
  })();
</script>

<!-- Countdown digit "tick" animation, powered by Motion — mirrors the AnimatePresence
     slide+fade used for the same countdown in the dashboard app (ConfettiBanner.jsx):
     the outgoing digit slides down and fades out while the incoming digit slides up
     and fades in, both with a spring(stiffness:320, damping:24).
     BaseLayout's inline script owns the actual countdown values (writes textContent
     every second and hides the banner at zero) — this only watches those elements and
     replays the transition when a digit changes, so the tick logic stays in one place. -->
<script>
  import { animate } from "motion";

  const UNIT_IDS = ["countdown-days", "countdown-hours", "countdown-minutes", "countdown-seconds"];
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const spring = { type: "spring", stiffness: 320, damping: 24 } as const;

  if (!reduceMotion) {
    for (const id of UNIT_IDS) {
      const digit = document.getElementById(id);
      const box = digit?.closest(".eb-timer-box");
      if (!digit || !box) continue;

      let last = digit.textContent;
      const observer = new MutationObserver(() => {
        const next = digit.textContent;
        if (next === last) return;

        // Ghost of the outgoing value — slides down and fades out.
        const ghost = document.createElement("span");
        ghost.className = "eb-timer-value eb-timer-ghost";
        ghost.textContent = last;
        box.appendChild(ghost);
        animate(ghost, { y: [0, 18], opacity: [1, 0] }, spring).finished.then(() => ghost.remove());

        // Incoming value — slides up and fades in.
        animate(digit, { y: [-18, 0], opacity: [0, 1] }, spring);

        last = next;
      });
      observer.observe(digit, { childList: true, characterData: true, subtree: true });
    }
  }
</script>
