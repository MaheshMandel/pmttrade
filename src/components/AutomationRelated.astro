---
/**
 * Sibling cross-link module for the /automation/ template family, mirroring the
 * "Related" section the /copier/ pages already carry.
 *
 * Before this existed the automation pages were structurally orphaned: every
 * related-firm module on the site pointed at /copier/ URLs, so no automation
 * page linked to another. This renders three sibling automation guides plus the
 * same-firm copier page, which is the closest-intent page on the site.
 */
import { useTranslations, localizedPath } from "../i18n/utils";
import type { Locale } from "../i18n/config";
import { findAutomationFirm, siblingAutomationFirms } from "../data/automationFirms";

interface Props {
  locale: Locale;
  /** Slug of the page rendering this module, e.g. "tradovate-to-tradeify-automation". */
  slug: string;
}

const { locale, slug } = Astro.props;
const t = useTranslations(locale);

const current = findAutomationFirm(slug);
const siblings = siblingAutomationFirms(slug);
---

<section class="py-16 border-t border-blue-900/30 bg-[#002040]">
  <div class="max-w-7xl mx-auto px-4">
    <p class="text-gray-400 text-sm mb-6">
      {t("automation.shared_hub_crosslink_pre" as any)}
      <a
        href={localizedPath(locale, "futures-trading-bot")}
        class="text-blue-400 hover:text-blue-300 underline">
        {t("automation.shared_hub_crosslink_text" as any)}
      </a>
      {t("automation.shared_hub_crosslink_post" as any)}
    </p>
    <h3 class="text-xl font-bold text-white mb-6">
      {t("automation.shared_related_h3" as any)}
    </h3>
    <div class="grid sm:grid-cols-3 gap-4">
      {
        siblings.map((firm) => (
          <a
            href={localizedPath(locale, `automation/${firm.slug}`)}
            class="bg-[#12121a] rounded-lg p-4 border border-gray-800 hover:border-gray-600 transition">
            <span class="text-white font-medium">
              {t(`automation.${firm.nameKey}` as any)}
            </span>
          </a>
        ))
      }
    </div>

    {
      current?.copierSlug && (
        <p class="text-gray-400 text-sm mt-6">
          {t("automation.shared_copier_crosslink_pre" as any)}
          <a
            href={localizedPath(locale, `copier/${current.copierSlug}`)}
            class="text-blue-400 hover:text-blue-300 underline">
            {t(`automation.${current.nameKey}` as any)}{" "}
            {t("automation.shared_copier_crosslink_suffix" as any)}
          </a>
          .
        </p>
      )
    }
  </div>
</section>
