---
import { brokers } from "../data/brokers";
import { useTranslations, localizedPath } from "../i18n/utils";
import { LOCALES, LOCALE_LABELS, type Locale } from "../i18n/config";
import { switchLocalePath } from "../i18n/utils";
import Banner from "./SaleBanner.astro";
import { SALE_END } from "../data/sale";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const home = localizedPath(locale);
const pathname = Astro.url.pathname;

// FE-16: the banner previously always rendered server-side (with the
// countdown frozen at 00:00:00:00) and relied on client-side JS to hide it
// once SALE_END passed — invisible to a human with JS enabled, but GPTBot,
// ClaudeBot and PerplexityBot don't execute JS, so they read a permanently
// "ending" sale straight out of the server HTML. Gate the render itself on
// the sale actually being live, server-side, so an expired promo never
// ships in the markup at all.
const saleActive = Date.now() < new Date(SALE_END).getTime();
---

<header id="nav-bar" class="navbar-header fixed top-0 left-0 right-0 z-[60] w-full flex flex-col">
  {saleActive && <Banner locale={locale} />}

  <div id="navbar-inner" class="bg-[#003366] w-full flex flex-row justify-between items-center lg:px-8 px-3 border-b border-white/10 transition-shadow duration-300 [font-family:'Inter',system-ui,sans-serif]">

    <!-- Logo -->
    <a href={home} class="flex items-center gap-2.5 py-3">
      <img src="/assets/logo.webp" alt="PickMyTrade - Connect TradingView to Tradovate" class="w-9 h-7" width="1563" height="1563" loading="eager" />
      <span class="font-bold hidden sm:inline text-white text-[15px] tracking-tight">PickMyTrade</span>
    </a>

    <nav class="flex items-center gap-0.5">

      <!-- Desktop links -->
      <a href={`${home}#howitworks`} class="relative hidden lg:inline-flex items-center px-3.5 py-5 text-[13.5px] font-semibold text-white/80 hover:text-white transition-colors duration-200 group">
        {t("nav.how_it_works")}
        <span class="absolute bottom-3 left-3.5 right-3.5 h-[2px] bg-white rounded-full scale-x-0 group-hover:scale-x-100 transition-transform duration-250 origin-left opacity-60"></span>
      </a>
      <a href={localizedPath(locale, "pages/affiliate-program")} class="relative hidden lg:inline-flex items-center px-3.5 py-5 text-[13.5px] font-semibold text-white/80 hover:text-white transition-colors duration-200 group">
        {t("nav.affiliate")}
        <span class="absolute bottom-3 left-3.5 right-3.5 h-[2px] bg-white rounded-full scale-x-0 group-hover:scale-x-100 transition-transform duration-250 origin-left opacity-60"></span>
      </a>
      <a href={`${home}#pricing`} class="relative hidden lg:inline-flex items-center px-3.5 py-5 text-[13.5px] font-semibold text-white/80 hover:text-white transition-colors duration-200 group">
        {t("nav.pricing")}
        <span class="absolute bottom-3 left-3.5 right-3.5 h-[2px] bg-white rounded-full scale-x-0 group-hover:scale-x-100 transition-transform duration-250 origin-left opacity-60"></span>
      </a>
      <a href="https://docs.pickmytrade.trade/docs/" class="relative hidden lg:inline-flex items-center px-3.5 py-5 text-[13.5px] font-semibold text-white/80 hover:text-white transition-colors duration-200 group">
        {t("nav.docs")}
        <span class="absolute bottom-3 left-3.5 right-3.5 h-[2px] bg-white rounded-full scale-x-0 group-hover:scale-x-100 transition-transform duration-250 origin-left opacity-60"></span>
      </a>
      <a href="https://blog.pickmytrade.trade" target="_blank" rel="noopener" class="relative hidden lg:inline-flex items-center px-3.5 py-5 text-[13.5px] font-semibold text-white/80 hover:text-white transition-colors duration-200 group">
        {t("nav.blog")}
        <span class="absolute bottom-3 left-3.5 right-3.5 h-[2px] bg-white rounded-full scale-x-0 group-hover:scale-x-100 transition-transform duration-250 origin-left opacity-60"></span>
      </a>

      <!-- Broker dropdown (desktop) -->
      <div class="relative group hidden lg:block">
        <button class="relative inline-flex items-center gap-1 px-3.5 py-5 text-[13.5px] font-medium text-white/80 hover:text-white transition-colors duration-200 focus:outline-none group/btn">
          <span class="font-semibold">{t("nav.brokers")}</span>
          <svg class="w-3.5 h-3.5 mt-0.5 transition-transform duration-200 group-hover/btn:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
          </svg>
          <span class="absolute bottom-3 left-3.5 right-3.5 h-[2px] bg-white rounded-full scale-x-0 group-hover:scale-x-100 transition-transform duration-250 origin-left opacity-60"></span>
        </button>
        <div class="absolute left-0 top-full pt-1 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 translate-y-1 group-hover:translate-y-0 z-50">
          <div class="w-44 bg-white rounded-xl shadow-xl shadow-black/20 border border-gray-100 overflow-hidden py-1.5">
            {brokers.map((broker) => (
              <a
                href={broker.key === "tradovate" ? home : broker.url}
                target={broker.target}
                rel={broker.target === "_blank" ? "noopener noreferrer" : undefined}
                class="flex items-center gap-2.5 px-4 py-2.5 text-sm text-gray-700 hover:text-[#003366] hover:bg-[#003366]/[0.06] transition-colors duration-150 font-medium"
              >
                {broker.name}
              </a>
            ))}
          </div>
        </div>
      </div>

      <!-- Language switcher (desktop) -->
      <div class="relative group hidden lg:block ml-1">
        <button class="inline-flex items-center gap-1 px-3 py-2 rounded-lg text-white/70 hover:text-white hover:bg-white/10 transition-all duration-200 text-[13px] font-medium focus:outline-none" aria-label="Select language">
          {locale.toUpperCase()}
          <svg class="w-3 h-3 transition-transform duration-200 group-hover:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
          </svg>
        </button>
        <div class="absolute right-0 top-full pt-1 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 translate-y-1 group-hover:translate-y-0 z-50">
          <div class="w-36 bg-white rounded-xl shadow-xl shadow-black/20 border border-gray-100 overflow-hidden py-1.5">
            {LOCALES.map((l) => (
              <a
                href={switchLocalePath(pathname, l)}
                class={`block px-4 py-2.5 text-sm font-medium transition-colors duration-150 ${
                  l === locale
                    ? "text-[#0F3EC3] font-semibold bg-[#0F3EC3]/[0.07]"
                    : "text-gray-700 hover:text-[#003366] hover:bg-[#003366]/[0.06]"
                }`}
              >
                {LOCALE_LABELS[l]}
              </a>
            ))}
          </div>
        </div>
      </div>

      <!-- Divider -->
      <div class="hidden lg:block w-px h-5 bg-white/20 mx-2.5"></div>

      <!-- Sign Up -->
      <a href="https://app.pickmytrade.trade/?register=true"
        class="hidden lg:inline-flex items-center px-4 py-2 rounded-lg text-[13.5px] font-semibold text-white bg-[#0F3EC3] border border-[#2B77EE] hover:bg-[#0d35a8] transition-all duration-200 active:scale-95">
        {t("nav.signup")}
      </a>

      <!-- Login -->
      <a href="https://app.pickmytrade.trade"
        class="hidden lg:inline-flex items-center px-4 py-2 rounded-lg text-[13.5px] font-semibold text-[#0F3EC3] bg-white border border-[#2B77EE] hover:bg-gray-50 transition-all duration-200 ml-1.5 active:scale-95">
        {t("nav.login")}
      </a>

      <!-- Hamburger (mobile) -->
      <button id="mobile-menu-btn" aria-label={t("nav.menu_open")} aria-expanded="false" aria-controls="mobile-menu"
        class="lg:hidden flex flex-col justify-center items-center w-10 h-10 gap-[5px] rounded-lg hover:bg-white/10 transition-colors focus:outline-none ml-1">
        <span id="ham-bar-1" class="block w-5 h-[1.5px] bg-white transition-all duration-300 origin-center"></span>
        <span id="ham-bar-2" class="block w-5 h-[1.5px] bg-white transition-all duration-300"></span>
        <span id="ham-bar-3" class="block w-5 h-[1.5px] bg-white transition-all duration-300 origin-center"></span>
      </button>
    </nav>
  </div>

  <!-- Mobile menu overlay -->
  <div id="mobile-menu" role="dialog" aria-modal="true" aria-label="Navigation menu"
    class="fixed inset-0 z-[55] lg:hidden pointer-events-none">
    <div id="mobile-menu-backdrop" class="absolute inset-0 bg-black/60 backdrop-blur-sm opacity-0 transition-opacity duration-300"></div>
    <div id="mobile-menu-panel"
      class="absolute top-0 left-0 h-full w-[min(300px,85vw)] bg-[#001e40] flex flex-col shadow-2xl border-r border-white/10 -translate-x-full transition-transform duration-300 ease-in-out [font-family:'Inter',system-ui,sans-serif]">

      <!-- Panel header -->
      <div class="flex items-center justify-between px-5 py-4 border-b border-white/10 bg-[#003366]">
        <a href={home} class="flex items-center gap-2.5">
          <img src="/assets/logo.webp" alt="PickMyTrade" class="w-8 h-7" width="1563" height="1563" loading="lazy" />
          <span class="font-bold text-white text-sm tracking-tight">PickMyTrade</span>
        </a>
        <button id="mobile-menu-close" aria-label={t("nav.menu_close")}
          class="w-8 h-8 flex items-center justify-center rounded-lg text-gray-300 hover:text-white hover:bg-white/10 transition-colors focus:outline-none">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>
      </div>

      <nav class="flex-1 overflow-y-auto px-3 py-4 space-y-0.5">
        <a href={`${home}#howitworks`}
          class="mob-nav-link flex items-center gap-3 px-3.5 py-3 rounded-xl text-gray-200 hover:text-white hover:bg-white/10 transition-all duration-150 text-sm font-medium group">
          <span class="w-7 h-7 rounded-lg bg-white/10 flex items-center justify-center shrink-0 group-hover:bg-white/15 transition-colors">
            <svg class="w-3.5 h-3.5 text-blue-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z"/>
            </svg>
          </span>
          {t("nav.how_it_works")}
        </a>
        <a href={localizedPath(locale, "pages/affiliate-program")}
          class="mob-nav-link flex items-center gap-3 px-3.5 py-3 rounded-xl text-gray-200 hover:text-white hover:bg-white/10 transition-all duration-150 text-sm font-medium group">
          <span class="w-7 h-7 rounded-lg bg-white/10 flex items-center justify-center shrink-0 group-hover:bg-white/15 transition-colors">
            <svg class="w-3.5 h-3.5 text-blue-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0"/>
            </svg>
          </span>
          {t("nav.affiliate")}
        </a>
        <a href={`${home}#pricing`}
          class="mob-nav-link flex items-center gap-3 px-3.5 py-3 rounded-xl text-gray-200 hover:text-white hover:bg-white/10 transition-all duration-150 text-sm font-medium group">
          <span class="w-7 h-7 rounded-lg bg-white/10 flex items-center justify-center shrink-0 group-hover:bg-white/15 transition-colors">
            <svg class="w-3.5 h-3.5 text-blue-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
          </span>
          {t("nav.pricing")}
        </a>
        <a href="https://docs.pickmytrade.trade/docs/"
          class="flex items-center gap-3 px-3.5 py-3 rounded-xl text-gray-200 hover:text-white hover:bg-white/10 transition-all duration-150 text-sm font-medium group">
          <span class="w-7 h-7 rounded-lg bg-white/10 flex items-center justify-center shrink-0 group-hover:bg-white/15 transition-colors">
            <svg class="w-3.5 h-3.5 text-blue-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
            </svg>
          </span>
          {t("nav.docs")}
        </a>
        <a href="https://blog.pickmytrade.trade" target="_blank" rel="noopener"
          class="flex items-center gap-3 px-3.5 py-3 rounded-xl text-gray-200 hover:text-white hover:bg-white/10 transition-all duration-150 text-sm font-medium group">
          <span class="w-7 h-7 rounded-lg bg-white/10 flex items-center justify-center shrink-0 group-hover:bg-white/15 transition-colors">
            <svg class="w-3.5 h-3.5 text-blue-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"/>
            </svg>
          </span>
          {t("nav.blog")}
        </a>

        <!-- Brokers accordion -->
        <div>
          <button id="mob-brokers-toggle"
            class="w-full flex items-center justify-between gap-3 px-3.5 py-3 rounded-xl text-gray-200 hover:text-white hover:bg-white/10 transition-all duration-150 text-sm font-medium focus:outline-none group">
            <span class="flex items-center gap-3">
              <span class="w-7 h-7 rounded-lg bg-white/10 flex items-center justify-center shrink-0 group-hover:bg-white/15 transition-colors">
                <svg class="w-3.5 h-3.5 text-blue-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 6l3 1m0 0l-3 9a5.002 5.002 0 006.001 0M6 7l3 9M6 7l6-2m6 2l3-1m-3 1l-3 9a5.002 5.002 0 006.001 0M18 7l3 9m-3-9l-6-2m0-2v2m0 16V5m0 16H9m3 0h3"/>
                </svg>
              </span>
              {t("nav.brokers")}
            </span>
            <svg id="mob-brokers-chevron" class="w-4 h-4 text-gray-400 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
            </svg>
          </button>
          <div id="mob-broker-list" class="hidden pl-[52px] pr-3 pb-1 space-y-0.5 mt-0.5">
            {brokers.map((broker) => (
              <a
                href={broker.key === "tradovate" ? home : broker.url}
                target={broker.target}
                rel={broker.target === "_blank" ? "noopener noreferrer" : undefined}
                class="mob-nav-link flex items-center gap-2 px-3 py-2.5 rounded-lg text-gray-300 hover:text-white hover:bg-white/10 transition-all duration-150 text-sm"
              >
                <span class="w-1 h-1 rounded-full bg-blue-300/60 shrink-0"></span>
                {broker.name}
              </a>
            ))}
          </div>
        </div>

        <!-- Language switcher (mobile) -->
        <div class="px-3.5 pt-2 pb-1">
          <p class="text-gray-400 text-[11px] font-semibold uppercase tracking-widest mb-2.5">{t("nav.language")}</p>
          <div class="flex gap-1.5 flex-wrap">
            {LOCALES.map((l) => (
              <a
                href={switchLocalePath(pathname, l)}
                class={`px-3 py-1.5 rounded-lg text-[13px] font-medium transition-all duration-150 ${
                  l === locale
                    ? "bg-[#0F3EC3] text-white border border-[#2B77EE]"
                    : "bg-white/10 text-gray-300 hover:bg-white/15 hover:text-white"
                }`}
              >
                {LOCALE_LABELS[l]}
              </a>
            ))}
          </div>
        </div>
      </nav>

      <!-- Mobile CTA buttons -->
      <div class="px-4 py-5 border-t border-white/10 space-y-2.5">
        <a href="https://app.pickmytrade.trade/?register=true"
          class="flex items-center justify-center w-full px-6 py-2.5 rounded-xl border border-[#2B77EE] text-white bg-[#0F3EC3] hover:bg-[#0d35a8] transition-all duration-200 font-semibold text-sm active:scale-[0.98]">
          Sign Up Free
        </a>
        <a href="https://app.pickmytrade.trade"
          class="flex items-center justify-center w-full px-6 py-2.5 rounded-xl border border-[#2B77EE] bg-white text-[#0F3EC3] hover:bg-gray-50 transition-all duration-200 font-semibold text-sm active:scale-[0.98]">
          Log In
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  // Scroll-aware navbar shadow
  const navInner = document.getElementById('navbar-inner');
  window.addEventListener('scroll', () => {
    if (window.scrollY > 10) {
      navInner?.classList.add('shadow-lg', 'shadow-black/30');
    } else {
      navInner?.classList.remove('shadow-lg', 'shadow-black/30');
    }
  }, { passive: true });

  // Mobile menu open/close
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const panel = document.getElementById('mobile-menu-panel');
  const backdrop = document.getElementById('mobile-menu-backdrop');
  const closeBtn = document.getElementById('mobile-menu-close');
  const bar1 = document.getElementById('ham-bar-1');
  const bar2 = document.getElementById('ham-bar-2');
  const bar3 = document.getElementById('ham-bar-3');

  function openMenu() {
    if (!menu || !panel || !backdrop || !btn) return;
    menu.classList.remove('pointer-events-none');
    panel.classList.remove('-translate-x-full');
    backdrop.classList.remove('opacity-0');
    backdrop.classList.add('opacity-100');
    btn.setAttribute('aria-expanded', 'true');
    if (bar1 && bar2 && bar3) {
      bar1.style.transform = 'rotate(45deg) translate(3.5px, 3.5px)';
      bar2.style.opacity = '0';
      bar3.style.transform = 'rotate(-45deg) translate(3.5px, -3.5px)';
    }
    document.body.style.overflow = 'hidden';
  }

  function closeMenu() {
    if (!menu || !panel || !backdrop || !btn) return;
    panel.classList.add('-translate-x-full');
    backdrop.classList.remove('opacity-100');
    backdrop.classList.add('opacity-0');
    btn.setAttribute('aria-expanded', 'false');
    if (bar1 && bar2 && bar3) {
      bar1.style.transform = '';
      bar2.style.opacity = '';
      bar3.style.transform = '';
    }
    document.body.style.overflow = '';
    setTimeout(() => { menu.classList.add('pointer-events-none'); }, 300);
  }

  btn?.addEventListener('click', openMenu);
  closeBtn?.addEventListener('click', closeMenu);
  backdrop?.addEventListener('click', closeMenu);
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeMenu(); });

  document.querySelectorAll('.mob-nav-link').forEach((link) => {
    link.addEventListener('click', closeMenu);
  });

  // Brokers accordion
  const brokersToggle = document.getElementById('mob-brokers-toggle');
  const brokersList = document.getElementById('mob-broker-list');
  const brokersChevron = document.getElementById('mob-brokers-chevron');

  brokersToggle?.addEventListener('click', () => {
    const isOpen = !brokersList?.classList.contains('hidden');
    brokersList?.classList.toggle('hidden', isOpen);
    if (brokersChevron) {
      brokersChevron.style.transform = isOpen ? '' : 'rotate(180deg)';
    }
  });
</script>
