---
// Marks the sticky section-nav link for the section currently in view. Progressive enhancement only.
---
<script>
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>(".secnav a[data-target]"));
  const targets = links.map((a) => document.getElementById(a.dataset.target!)).filter((el): el is HTMLElement => !!el);
  if ("IntersectionObserver" in window && targets.length) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          links.forEach((a) => a.removeAttribute("aria-current"));
          const cur = links.find((a) => a.dataset.target === e.target.id);
          cur?.setAttribute("aria-current", "true");
          // Centre the active link inside the (horizontally scrollable) nav ONLY. Never scrollIntoView():
          // on a position:sticky element it scrolls the PAGE back up to the nav's original position,
          // which made the page snap up while the scrollbar was being dragged.
          const bar = cur?.closest("ul");
          if (cur && bar && bar.scrollWidth > bar.clientWidth) {
            const left = cur.getBoundingClientRect().left - bar.getBoundingClientRect().left + bar.scrollLeft;
            bar.scrollTo({ left: left - (bar.clientWidth - cur.offsetWidth) / 2, behavior: "smooth" });
          }
        }
      },
      { rootMargin: "-30% 0px -60% 0px" },
    );
    targets.forEach((t) => io.observe(t));
  }
</script>
