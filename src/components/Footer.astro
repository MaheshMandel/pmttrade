---
import { brokers } from '../data/brokers';
import { useTranslations, localizedPath } from '../i18n/utils';
import type { Locale } from '../i18n/config';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const home = localizedPath(locale);
---

<footer class='bg-[#0a0a0f] border-t border-gray-800'>
  <div class='max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16'>
    <!-- Top Section -->
    <div
      class='flex flex-col lg:flex-row justify-between items-start lg:items-center gap-8 pb-12 border-b border-gray-800'>
      <div class='flex items-center gap-3'>
        <a
          href={home}
          class='flex items-center gap-2'>
          <img
            src='/assets/logo.webp'
            alt='PickMyTrade'
            class='w-10 h-8'
            width='1563'
            height='1563'
            loading='lazy'
          />
          <span class='text-xl font-bold text-white'>PickMyTrade</span>
        </a>
        <span class='hidden sm:inline-block text-gray-500 mx-3'>|</span>
        <p class='hidden sm:block text-gray-400 text-sm'>
          {t('footer.tagline')}
        </p>
      </div>
      <div class='flex items-center gap-4'>
        <a
          href='https://discord.gg/FkJ7g7498S'
          target='_blank'
          rel='noopener'
          aria-label='PickMyTrade on Discord'
          class='w-10 h-10 rounded-lg bg-gray-800 hover:bg-gray-700 flex items-center justify-center text-gray-400 hover:text-white transition'>
          <i class='fab fa-discord text-lg' aria-hidden='true'></i>
        </a>
        <a
          href='https://twitter.com/pickmytrade'
          target='_blank'
          rel='noopener'
          aria-label='PickMyTrade on Twitter/X'
          class='w-10 h-10 rounded-lg bg-gray-800 hover:bg-gray-700 flex items-center justify-center text-gray-400 hover:text-white transition'>
          <i class='fab fa-twitter text-lg' aria-hidden='true'></i>
        </a>
        <a
          href='https://app.pickmytrade.trade/?register=true'
          class='ml-2 px-6 py-2.5 bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium rounded-lg transition'>
          {t('footer.cta')}
        </a>
      </div>
    </div>

    <!-- Links Grid -->
    <div class='grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-7 gap-8 pt-12'>
      <!-- Brokers -->
      <div>
        <h3
          class='text-white font-semibold text-sm uppercase tracking-wider mb-4'>
          {t('footer.brokers_heading')}
        </h3>
        <ul class='space-y-3 text-sm'>
          {
            brokers.map((broker) => (
              <li>
                <a
                  href={broker.key === 'tradovate' ? localizedPath(locale, 'tradingview-to-tradovate') : broker.url}
                  target={broker.target}
                  rel={
                    broker.target === '_blank'
                      ? 'noopener noreferrer'
                      : undefined
                  }
                  class='text-gray-400 hover:text-white transition'>
                  {broker.name}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Prop Firms -->
      <div>
        <h3
          class='text-white font-semibold text-sm uppercase tracking-wider mb-4'>
          {t('footer.propfirms_heading')}
        </h3>
        <ul class='space-y-3 text-sm'>
          <li>
            <a
              href={localizedPath(
                locale,
                'copier/tradovate-to-take-profit-trader-copier',
              )}
              class='text-gray-400 hover:text-white transition'
              >{t('footer.link_take_profit')}</a>
          </li>
          <li>
            <a
              href={localizedPath(
                locale,
                'copier/tradovate-to-blue-guardian-futures-copier',
              )}
              class='text-gray-400 hover:text-white transition'
              >{t('footer.link_blue_guardian')}</a>
          </li>
          <li>
            <a
              href={localizedPath(
                locale,
                'copier/tradovate-to-fundednext-futures-copier',
              )}
              class='text-gray-400 hover:text-white transition'
              >{t('footer.link_fundednext')}</a>
          </li>
          <li>
            <a
              href={localizedPath(
                locale,
                'copier/tradovate-to-top-one-futures-copier',
              )}
              class='text-gray-400 hover:text-white transition'
              >{t('footer.link_top_one')}</a>
          </li>
          <li>
            <a
              href={localizedPath(
                locale,
                'copier/tradovate-to-bulenox-copier',
              )}
              class='text-gray-400 hover:text-white transition'
              >{t('footer.link_bulenox')}</a>
          </li>
          <li>
            <a
              href={localizedPath(locale, 'supported-propfirms')}
              class='text-gray-400 hover:text-white transition'
              >{t('footer.link_supported')}</a>
          </li>
          <li>
            <a
              href={localizedPath(
                locale,
                'copier/tradovate-to-tradeday-copier',
              )}
              class='text-gray-400 hover:text-white transition'
              >{t('footer.link_tradeday_copier')}</a>
          </li>
        </ul>
      </div>

      <!-- Use Cases -->
      <div>
        <h3
          class='text-white font-semibold text-sm uppercase tracking-wider mb-4'>
          {t('footer.usecases_heading')}
        </h3>
        <ul class='space-y-3 text-sm'>
          <li>
            <a
              href={localizedPath(locale, 'use-cases/pinescript-developers')}
              class='text-gray-400 hover:text-white transition'
              >{t('footer.link_pinescript')}</a>
          </li>
          <li>
            <a
              href={localizedPath(locale, 'use-cases/multi-account-traders')}
              class='text-gray-400 hover:text-white transition'
              >{t('footer.link_multi_account')}</a>
          </li>
          <li>
            <a
              href={localizedPath(locale, 'tradingview-automation')}
              class='text-gray-400 hover:text-white transition'
              >{t('footer.link_tradingview')}</a>
          </li>
          <li>
            <a
              href={localizedPath(locale, 'tradingview-webhook-to-broker')}
              class='text-gray-400 hover:text-white transition'
              >{t('footer.link_webhook_broker')}</a>
          </li>
        </ul>
      </div>

      <!-- Resources -->
      <div>
        <h3
          class='text-white font-semibold text-sm uppercase tracking-wider mb-4'>
          {t('footer.resources_heading')}
        </h3>
        <ul class='space-y-3 text-sm'>
          <li>
            <a
              href={localizedPath(locale, 'pages/pricing')}
              class='text-gray-400 hover:text-white transition'
              >{t('footer.link_pricing')}</a>
          </li>
          <li>
            <a
              href='https://docs.pickmytrade.trade/docs/'
              class='text-gray-400 hover:text-white transition'
              >{t('footer.link_docs')}</a>
          </li>
          <li>
            <a
              href={localizedPath(locale, 'how-to')}
              class='text-gray-400 hover:text-white transition'
              >{t('footer.link_how_to')}</a>
          </li>
          <li>
            <a
              href={localizedPath(locale, 'debugging')}
              class='text-gray-400 hover:text-white transition'
              >{t('footer.link_debugging')}</a>
          </li>
          <li>
            <a
              href={localizedPath(locale, 'pages/affiliate-program')}
              class='text-gray-400 hover:text-white transition'
              >{t('footer.link_affiliate')}</a>
          </li>
          <li>
            <a
              href='https://blog.pickmytrade.trade'
              class='text-gray-400 hover:text-white transition'
              >{t('footer.link_blog')}</a>
          </li>
          <li>
            <a
              href='https://discord.gg/FkJ7g7498S'
              target='_blank'
              rel='noopener'
              class='text-gray-400 hover:text-white transition'
              >{t('footer.link_discord')}</a>
          </li>
          <li>
            <a
              href={localizedPath(locale, 'broker-faq/tradovate-faq')}
              class='text-gray-400 hover:text-white transition'
              >{t('footer.link_faq')}</a>
          </li>
          <li>
            <a
              href={localizedPath(locale, 'prop-firm-faq')}
              class='text-gray-400 hover:text-white transition'
              >{t('footer.link_prop_firm_faq')}</a>
          </li>
          <li>
            <a
              href={localizedPath(locale, 'resources')}
              class='text-gray-400 hover:text-white transition'
              >{t('footer.link_partners')}</a>
          </li>
          <li>
            <a
              href={localizedPath(locale, 'automated-trading-software')}
              class='text-gray-400 hover:text-white transition'
              >{t('footer.link_automated_trading')}</a>
          </li>
          <li>
            <a
              href={localizedPath(locale, 'pickmytrade-review')}
              class='text-gray-400 hover:text-white transition'
              >{t('footer.link_review')}</a>
          </li>
        </ul>
      </div>

      <!-- Compare -->
      <div>
        <h3
          class='text-white font-semibold text-sm uppercase tracking-wider mb-4'>
          {t('footer.compare_heading')}
        </h3>
        <ul class='space-y-3 text-sm'>
          <li>
            <a
              href={localizedPath(locale, 'compare')}
              class='text-gray-400 hover:text-white transition font-medium'
              >{t('footer.link_compare_hub')}</a>
          </li>
          <li>
            <a
              href={localizedPath(locale, 'compare/pickmytrade-vs-traderspost')}
              class='text-gray-400 hover:text-white transition'
              >{t('footer.link_vs_traderspost')}</a>
          </li>
          <li>
            <a
              href={localizedPath(locale, 'compare/pickmytrade-vs-pineconnector')}
              class='text-gray-400 hover:text-white transition'
              >{t('footer.link_vs_pineconnector')}</a>
          </li>
          <li>
            <a
              href={localizedPath(locale, 'compare/pickmytrade-vs-alertdragon')}
              class='text-gray-400 hover:text-white transition'
              >{t('footer.link_vs_alertdragon')}</a>
          </li>
          <li>
            <a
              href={`https://pickmytrade.io${localizedPath(locale, 'compare/pickmytrade-vs-3commas')}`}
              class='text-gray-400 hover:text-white transition'
              >{t('footer.link_vs_3commas')}</a>
          </li>
          <li>
            <a
              href={localizedPath(locale, 'compare/pickmytrade-vs-tradecopia')}
              class='text-gray-400 hover:text-white transition'
              >{t('footer.link_vs_tradecopia')}</a>
          </li>
          <li>
            <a
              href={localizedPath(locale, 'compare/pickmytrade-vs-tradesyncer')}
              class='text-gray-400 hover:text-white transition'
              >{t('footer.link_vs_tradesyncer')}</a>
          </li>
        </ul>
      </div>

      <!-- Company -->
      <div>
        <h3
          class='text-white font-semibold text-sm uppercase tracking-wider mb-4'>
          {t('footer.company_heading')}
        </h3>
        <ul class='space-y-3 text-sm'>
          <li>
            <a
              href={localizedPath(locale, 'pages/about')}
              class='text-gray-400 hover:text-white transition'
              >{t('footer.link_about')}</a>
          </li>
          <li>
            <a
              href={localizedPath(locale, 'pages/contact-us')}
              class='text-gray-400 hover:text-white transition'
              >{t('footer.link_contact')}</a>
          </li>
          <li>
            <a
              href={localizedPath(locale, 'pages/security')}
              class='text-gray-400 hover:text-white transition'
              >{t('footer.link_security')}</a>
          </li>
          <li>
            <a
              href='https://pickmytrade.com/'
              class='text-gray-400 hover:text-white transition'
              >{t('footer.link_company_home')}</a>
          </li>
        </ul>
      </div>

      <!-- Legal -->
      <div>
        <h3
          class='text-white font-semibold text-sm uppercase tracking-wider mb-4'>
          {t('footer.legal_heading')}
        </h3>
        <ul class='space-y-3 text-sm'>
          <li>
            <a
              href={localizedPath(locale, 'legal/disclaimer')}
              class='text-gray-400 hover:text-white transition'
              >{t('footer.link_disclaimer')}</a>
          </li>
          <li>
            <a
              href={localizedPath(locale, 'legal/privacy')}
              class='text-gray-400 hover:text-white transition'
              >{t('footer.link_privacy')}</a>
          </li>
          <li>
            <a
              href={localizedPath(locale, 'legal/terms-and-conditions')}
              class='text-gray-400 hover:text-white transition'
              >{t('footer.link_terms')}</a>
          </li>
        </ul>
      </div>
    </div>
  </div>

  <!-- Disclaimer Section -->
  <div class='bg-gradient-to-r from-blue-600 to-blue-700'>
    <div class='max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8'>
      <div class='text-xs text-white/80 space-y-3 leading-relaxed'>
        <p>
          <strong>{t('footer.risk_disclosure_title')}:</strong>
          {t('footer.risk_disclosure')}
        </p>
        <p>
          <strong>{t('footer.testimonial_disclosure_title')}:</strong>
          {t('footer.testimonial_disclosure')}
        </p>
        <p>
          <strong>{t('footer.third_party_disclaimer_title')}:</strong>
          {t('footer.third_party_disclaimer')}
        </p>
        <p>
          <strong>{t('footer.general_disclaimer_title')}:</strong>
          {t('footer.general_disclaimer')}
        </p>
      </div>

      <!-- Cross-domain routing block -->
      <p class='mt-4 text-center text-xs text-white/90'>
        {t('footer.routing_tradovate_q')}
        <a href='https://pickmytrade.trade/' class='underline hover:text-white'>pickmytrade.trade</a>.
        {t('footer.routing_other_broker_q')}
        <a href='https://pickmytrade.io/' class='underline hover:text-white'>pickmytrade.io</a>.
        {t('footer.routing_company_q')}
        <a href='https://pickmytrade.com/' class='underline hover:text-white'>pickmytrade.com</a>.
      </p>

      <!-- NAP / Entity info -->
      <div
        class='mt-6 pt-6 border-t border-white/20 flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-xs text-white/80'>
        <span
          itemscope
          itemtype='https://schema.org/Organization'>
          <strong itemprop='name'>PickMyTrade Pvt. Ltd.</strong>
        </span>
        <span class='flex items-center gap-2'>
          <i class='fas fa-envelope text-white/60'></i>
          <!-- email_off: opts this address out of Cloudflare Email Address
               Obfuscation, which otherwise rewrites it to a JS-decoded
               [email protected] placeholder that non-JS AI crawlers read as
               broken text. -->
          <!--email_off-->
          <a
            href='mailto:support@pickmytrade.com'
            class='text-white/90 hover:text-white'
            >support@pickmytrade.com</a
          >
          <!--email_on-->
        </span>
        <span class='flex items-center gap-2'
          ><i class='fas fa-globe text-white/60'></i>pickmytrade.trade</span
        >
      </div>

      <div
        class='mt-4 pt-4 border-t border-white/20 flex flex-col sm:flex-row justify-between items-center gap-4'>
        <p class='text-sm text-white'>
          © <span id='footer-year'></span> PickMyTrade Pvt. Ltd. {
            t('footer.rights')
          }
          <span class='block sm:inline text-white/60'>{t('footer.official_domains')}</span>
        </p>
        <div class='flex items-center gap-6 text-sm text-white/80'>
          <span class='flex items-center gap-2'>
            <i class='fas fa-users text-white/60'></i>
            {t('footer.traders_stat')}
          </span>
          <span class='flex items-center gap-2'>
            <i class='fas fa-chart-line text-white/60'></i>
            {t('footer.trades_stat')}
          </span>
        </div>
      </div>
    </div>
  </div>
</footer>

<script is:inline>
  var yearEl = document.getElementById('footer-year');
  if (yearEl) yearEl.textContent = new Date().getFullYear();
</script>
