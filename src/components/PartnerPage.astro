---
import FaqItem from "./FaqItem.astro";
import { localizedPath, useTranslations } from "../i18n/utils";
import type { Locale } from "../i18n/config";
import { PARTNER_CATEGORIES, categoryLabel } from "../data/partners";

export interface PartnerFaq {
  q: string;
  a: string;
}

export interface PartnerOffering {
  title: string;
  text: string;
}

export interface PartnerPageData {
  partnerName: string;
  websiteUrl: string;
  categoryName: string;
  metaTitle: string;
  metaDescription: string;
  h1: string;
  subhead: string;
  readTime: string;
  hookText: string;
  hookBullets: string[];
  stats: { n: string; l: string }[];
  aboutHeading: string;
  aboutParagraphs: string[];
  offeringsHeading: string;
  offerings: PartnerOffering[];
  whyHeading: string;
  whyParagraph: string;
  pullQuote: string;
  prosConsHeading: string;
  strengths: string[];
  limitations: string[];
  faqHeading: string;
  faqs: PartnerFaq[];
  pairingHeading: string;
  pairingParagraph: string;
  howItWorks: string[];
  pairingFaqs: PartnerFaq[];
  disclosureText: string;
}

interface Props {
  locale: Locale;
  data: PartnerPageData;
}

const { locale, data } = Astro.props;
const t = useTranslations(locale);

const categoryAnchor =
  PARTNER_CATEGORIES.find((c) => c.name === data.categoryName)?.anchor ??
  data.categoryName.toLowerCase().replace(/[^a-z0-9]+/g, "-");
const categoryDisplay = categoryLabel(data.categoryName, locale);

const CARD_ACCENTS = [
  { border: "border-blue-500/30", bg: "from-blue-900/20 to-blue-900/5", icon: "text-blue-400" },
  { border: "border-green-500/30", bg: "from-green-900/20 to-green-900/5", icon: "text-green-400" },
  { border: "border-purple-500/30", bg: "from-purple-900/20 to-purple-900/5", icon: "text-purple-400" },
  { border: "border-yellow-500/30", bg: "from-yellow-900/20 to-yellow-900/5", icon: "text-yellow-400" },
];
---

<div class="bg-[#001429]">
  <!-- Hero -->
  <section class="py-16 lg:py-24 border-b border-blue-900/30 bg-gradient-to-b from-[#001429] to-[#002040]">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <a
        href={`${localizedPath(locale, "resources")}#${categoryAnchor}`}
        class="inline-block px-4 py-2 bg-blue-600/20 text-blue-400 rounded-full text-sm font-semibold mb-6 border border-blue-500/30 uppercase electrolize hover:bg-blue-600/30 transition-colors"
      >
        {categoryDisplay}
      </a>
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold text-white mb-6 tracking-tight">
        {data.h1}
      </h1>
      <p class="text-xl md:text-2xl text-gray-300 max-w-3xl mx-auto leading-relaxed mb-4">
        {data.subhead}
      </p>
      <p class="text-sm text-gray-500 mb-4">{categoryDisplay} &middot; {data.readTime}</p>
      <a
        href={data.websiteUrl}
        target="_blank"
        rel="noopener nofollow"
        class="inline-flex items-center gap-1.5 text-sm text-blue-400 hover:text-blue-300 underline mb-10"
      >
        {data.partnerName} <i class="fa-solid fa-arrow-up-right-from-square text-[10px]" aria-hidden="true"></i>
      </a>

      <div class="text-left bg-gradient-to-br from-blue-900/20 to-blue-900/5 border border-blue-500/30 rounded-2xl p-6 md:p-8 mb-10">
        <p class="text-gray-200 leading-relaxed mb-4">
          <strong class="text-white">{t("partner_page.hook_label")}</strong> {data.hookText}
        </p>
        <ul class="space-y-2">
          {data.hookBullets.map((b) => (
            <li class="flex items-start gap-3 text-gray-300">
              <i class="fa-solid fa-circle-check text-blue-400 mt-1 text-xs flex-shrink-0" aria-hidden="true"></i>
              <span>{b}</span>
            </li>
          ))}
        </ul>
      </div>

      <div class="grid grid-cols-3 gap-4 max-w-2xl mx-auto">
        {data.stats.map((s) => (
          <div class="text-center">
            <div class="text-2xl md:text-3xl font-bold text-blue-400 electrolize">{s.n}</div>
            <div class="text-xs md:text-sm text-gray-400 uppercase tracking-wider mt-1">{s.l}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- About -->
  <section class="py-16 border-b border-gray-800">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold text-white mb-4">{data.aboutHeading}</h2>
      {data.aboutParagraphs.map((p) => (
        <p class="text-gray-300 mb-4 leading-relaxed last:mb-0">{p}</p>
      ))}
    </div>
  </section>

  <!-- Offerings -->
  <section class="py-16 md:py-24 border-b border-blue-900/30 bg-gradient-to-b from-[#002040] to-[#001429]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl md:text-4xl font-bold text-white mb-12 text-center tracking-tight">{data.offeringsHeading}</h2>
      <div class="grid md:grid-cols-2 gap-6">
        {data.offerings.map((o, i) => {
          const accent = CARD_ACCENTS[i % CARD_ACCENTS.length];
          return (
            <div class={`bg-gradient-to-br ${accent.bg} border ${accent.border} rounded-xl p-6`}>
              <h4 class="text-xl font-bold text-white mb-2">{o.title}</h4>
              <p class="text-gray-300 leading-relaxed">{o.text}</p>
            </div>
          );
        })}
      </div>
    </div>
  </section>

  <!-- Why traders rely on it -->
  <section class="py-16 border-b border-gray-800">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold text-white mb-4">{data.whyHeading}</h2>
      <p class="text-gray-300 leading-relaxed">{data.whyParagraph}</p>
    </div>
  </section>

  <!-- Pull quote -->
  <section class="py-16 border-b border-blue-900/30 bg-gradient-to-b from-[#001429] to-[#002040]">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <i class="fa-solid fa-quote-left text-blue-500/40 text-3xl mb-6" aria-hidden="true"></i>
      <blockquote class="text-xl md:text-2xl text-gray-200 italic font-medium leading-relaxed">
        {data.pullQuote}
      </blockquote>
    </div>
  </section>

  <!-- Pros & Cons -->
  <section class="py-16 border-b border-gray-800">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl md:text-4xl font-bold text-white mb-12 text-center tracking-tight">{data.prosConsHeading}</h2>
      <div class="grid md:grid-cols-2 gap-8">
        <div>
          <h3 class="text-lg font-bold text-green-400 mb-6 uppercase tracking-wider text-sm"><i class="fa-solid fa-check-circle mr-2"></i>{t("partner_page.strengths_label")}</h3>
          <div class="space-y-3">
            {data.strengths.map((s) => (
              <div class="flex items-start gap-3">
                <i class="fa-solid fa-check-circle text-green-400 mt-1 flex-shrink-0"></i>
                <span class="text-gray-300">{s}</span>
              </div>
            ))}
          </div>
        </div>
        <div>
          <h3 class="text-lg font-bold text-gray-400 mb-6 uppercase tracking-wider text-sm"><i class="fa-solid fa-minus-circle mr-2"></i>{t("partner_page.limitations_label")}</h3>
          <div class="space-y-3">
            {data.limitations.map((l) => (
              <div class="flex items-start gap-3">
                <i class="fa-solid fa-minus-circle text-gray-400 mt-1 flex-shrink-0"></i>
                <span class="text-gray-300">{l}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-16 border-b border-blue-900/30 bg-gradient-to-b from-[#002040] to-[#001429]">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl md:text-4xl font-bold text-white mb-10 text-center tracking-tight">{data.faqHeading}</h2>
      <div class="space-y-4">
        {data.faqs.map((f) => (
          <FaqItem question={f.q}>
            <p>{f.a}</p>
          </FaqItem>
        ))}
      </div>
    </div>
  </section>

  <!-- PickMyTrade pairing -->
  <section class="py-16 md:py-24 border-b border-gray-800">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <span class="inline-block px-4 py-2 bg-blue-600/20 text-blue-400 rounded-full text-sm font-semibold mb-4 border border-blue-500/30 uppercase electrolize">
        {t("partner_page.related_tool")}
      </span>
      <h2 class="text-3xl md:text-4xl font-bold text-white mb-4 tracking-tight">{data.pairingHeading}</h2>
      <p class="text-gray-300 leading-relaxed mb-8">{data.pairingParagraph}</p>

      <div class="flex flex-wrap gap-3 mb-10">
        <span class="px-4 py-2 bg-white/5 border border-white/10 rounded-full text-sm text-gray-300">{t("partner_page.trust_traders")}</span>
        <span class="px-4 py-2 bg-white/5 border border-white/10 rounded-full text-sm text-gray-300">{t("partner_page.trust_trades")}</span>
        <span class="px-4 py-2 bg-white/5 border border-white/10 rounded-full text-sm text-gray-300">{t("partner_page.trust_execution")}</span>
        <span class="px-4 py-2 bg-white/5 border border-white/10 rounded-full text-sm text-gray-300">{t("partner_page.trust_trial")}</span>
      </div>

      <h3 class="text-xl font-bold text-white mb-4">{t("partner_page.how_it_works")}</h3>
      <ul class="space-y-3 mb-10">
        {data.howItWorks.map((s) => (
          <li class="flex items-start gap-3 text-gray-300">
            <i class="fa-solid fa-arrow-right text-blue-400 mt-1 flex-shrink-0"></i>
            <span>{s}</span>
          </li>
        ))}
      </ul>

      <div class="space-y-4 mb-10">
        {data.pairingFaqs.map((f) => (
          <FaqItem question={f.q}>
            <p>{f.a}</p>
          </FaqItem>
        ))}
      </div>

      <div class="flex flex-col sm:flex-row gap-4">
        <a
          href="https://app.pickmytrade.trade/?register=true"
          class="inline-flex items-center justify-center gap-2 px-8 py-4 bg-gradient-to-r from-blue-600 to-blue-700 hover:from-blue-700 hover:to-blue-800 text-white rounded-xl font-bold transition-all transform hover:scale-105 shadow-xl"
        >
          <i class="fas fa-rocket"></i> {t("partner_page.cta_start_trial")}
        </a>
        <a
          href="https://docs.pickmytrade.trade/docs/"
          target="_blank"
          rel="noopener"
          class="inline-flex items-center justify-center gap-2 px-8 py-4 bg-white/10 hover:bg-white/20 text-white rounded-xl font-bold border border-white/20 transition-all"
        >
          <i class="fas fa-book"></i> {t("partner_page.cta_view_docs")}
        </a>
      </div>
    </div>
  </section>

  <!-- Disclosure -->
  <section class="py-10 px-4" aria-label="Disclosure">
    <div class="max-w-4xl mx-auto">
      <p class="text-xs text-white/40 leading-relaxed italic">{data.disclosureText}</p>
    </div>
  </section>
</div>
