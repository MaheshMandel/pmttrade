---
import { useTranslations } from "../i18n/utils";
import type { Locale } from "../i18n/config";
import pricingConfig from "../../public/pricing-config.json";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

// Banner pricing is derived from the annual plan in pricing-config.json (the
// same source the JSON-LD Offer in BaseLayout reads) so the crossed-out
// anchor and the sale price shown here can't drift from what's declared
// elsewhere on the page.
const annualPlan = Object.values(pricingConfig.plans).find(
  (p: any) => p.enabled && p.period === "year"
) as { price: number; originalPrice: number | null } | undefined;
const oldPrice = annualPlan?.originalPrice ?? 500;
const newPrice = annualPlan?.price ?? 350;
---

<a id="sale-banner" href="#pricing" class="ss-root" aria-label={t("sale_banner.aria_label")}>
  <div class="ss-banner">

    <!-- Palm trees -->
    <div class="ss-palm ss-palm-left" aria-hidden="true">
      <svg width="36" height="64" viewBox="0 0 30 55">
        <path d="M14 55 Q13 35, 15 14" stroke="#5C3A1E" stroke-width="2.5" fill="none" stroke-linecap="round"/>
        <path d="M15 14 Q4 7, -2 13 Q5 10, 15 14 Z" fill="#2E7D32"/>
        <path d="M15 14 Q26 7, 32 13 Q25 10, 15 14 Z" fill="#388E3C"/>
        <path d="M15 14 Q8 3, 3 -2 Q11 4, 15 14 Z" fill="#43A047"/>
        <path d="M15 14 Q22 3, 27 -2 Q19 4, 15 14 Z" fill="#2E7D32"/>
        <circle cx="15" cy="13" r="1.5" fill="#5C3A1E"/>
        <circle cx="13" cy="14" r="1.2" fill="#5C3A1E"/>
      </svg>
    </div>
    <div class="ss-palm ss-palm-right" aria-hidden="true">
      <svg width="36" height="64" viewBox="0 0 30 55" style="transform: scaleX(-1);">
        <path d="M14 55 Q13 35, 15 14" stroke="#5C3A1E" stroke-width="2.5" fill="none" stroke-linecap="round"/>
        <path d="M15 14 Q4 7, -2 13 Q5 10, 15 14 Z" fill="#2E7D32"/>
        <path d="M15 14 Q26 7, 32 13 Q25 10, 15 14 Z" fill="#388E3C"/>
        <path d="M15 14 Q8 3, 3 -2 Q11 4, 15 14 Z" fill="#43A047"/>
        <path d="M15 14 Q22 3, 27 -2 Q19 4, 15 14 Z" fill="#2E7D32"/>
        <circle cx="15" cy="13" r="1.5" fill="#5C3A1E"/>
        <circle cx="13" cy="14" r="1.2" fill="#5C3A1E"/>
      </svg>
    </div>

    <!-- Sun -->
    <div class="ss-sun" aria-hidden="true">
      <svg width="40" height="40" viewBox="0 0 40 40">
        <g stroke="#FFB400" stroke-width="2" stroke-linecap="round">
          <line x1="20" y1="2"  x2="20" y2="6"/>
          <line x1="20" y1="34" x2="20" y2="38"/>
          <line x1="2"  y1="20" x2="6"  y2="20"/>
          <line x1="34" y1="20" x2="38" y2="20"/>
          <line x1="6"  y1="6"  x2="9"  y2="9"/>
          <line x1="31" y1="31" x2="34" y2="34"/>
          <line x1="6"  y1="34" x2="9"  y2="31"/>
          <line x1="31" y1="9"  x2="34" y2="6"/>
        </g>
        <circle cx="20" cy="20" r="9" fill="#FFD93D"/>
        <circle cx="20" cy="20" r="6" fill="#FFB400"/>
      </svg>
    </div>

    <!-- Clouds -->
    <span class="ss-cloud ss-cloud-1" aria-hidden="true">
      <svg width="48" height="22" viewBox="0 0 48 22"><ellipse cx="10" cy="14" rx="8" ry="6" fill="#fff"/><ellipse cx="24" cy="10" rx="11" ry="8" fill="#fff"/><ellipse cx="38" cy="14" rx="8" ry="6" fill="#fff"/></svg>
    </span>
    <span class="ss-cloud ss-cloud-2" aria-hidden="true">
      <svg width="38" height="18" viewBox="0 0 38 18"><ellipse cx="8" cy="11" rx="6" ry="5" fill="#fff"/><ellipse cx="19" cy="8" rx="8" ry="6" fill="#fff"/><ellipse cx="30" cy="11" rx="6" ry="5" fill="#fff"/></svg>
    </span>
    <span class="ss-cloud ss-cloud-3" aria-hidden="true">
      <svg width="44" height="20" viewBox="0 0 44 20"><ellipse cx="9" cy="13" rx="7" ry="5" fill="#fff"/><ellipse cx="22" cy="9" rx="10" ry="7" fill="#fff"/><ellipse cx="35" cy="13" rx="7" ry="5" fill="#fff"/></svg>
    </span>

    <!-- Life preservers -->
    <span class="ss-ring ss-ring-1" aria-hidden="true">
      <svg width="22" height="22" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10" fill="#D8242F"/><circle cx="12" cy="12" r="6" fill="#fff"/><rect x="11" y="1" width="2" height="22" fill="#fff"/><rect x="1" y="11" width="22" height="2" fill="#fff"/><circle cx="12" cy="12" r="3" fill="#0B6FA8"/></svg>
    </span>
    <span class="ss-ring ss-ring-2" aria-hidden="true">
      <svg width="18" height="18" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10" fill="#D8242F"/><circle cx="12" cy="12" r="6" fill="#fff"/><rect x="11" y="1" width="2" height="22" fill="#fff"/><rect x="1" y="11" width="22" height="2" fill="#fff"/><circle cx="12" cy="12" r="3" fill="#0B6FA8"/></svg>
    </span>

    <!-- Main content -->
    <div class="ss-content">
      <span class="ss-title">
        <span class="ss-title-early">{t("sale_banner.title_early")}</span>
        <em class="ss-title-sale">{t("sale_banner.title_sale")}</em>
      </span>
      <div class="ss-pricing">
        <span class="ss-old-price">
          <span class="ss-currency">$</span>{oldPrice}
          <span class="ss-strike" aria-hidden="true"></span>
        </span>
        <span class="ss-new-price-wrap">
          <span class="ss-new-price"><span class="ss-currency">$</span>{newPrice}</span>
          <span class="ss-period">/yr</span>
        </span>
      </div>
      <span class="ss-countdown" aria-label={t("sale_banner.ends_in")}>
        <span class="ss-cd-label">{t("sale_banner.ends_in")}</span>
        <span class="ss-cd-unit"><span id="countdown-days" class="ss-cd-value">00</span><span class="ss-cd-unit-label">{t("sale_banner.unit_days")}</span></span>
        <span class="ss-cd-sep" aria-hidden="true">:</span>
        <span class="ss-cd-unit"><span id="countdown-hours" class="ss-cd-value">00</span><span class="ss-cd-unit-label">{t("sale_banner.unit_hours")}</span></span>
        <span class="ss-cd-sep" aria-hidden="true">:</span>
        <span class="ss-cd-unit"><span id="countdown-minutes" class="ss-cd-value">00</span><span class="ss-cd-unit-label">{t("sale_banner.unit_minutes")}</span></span>
        <span class="ss-cd-sep" aria-hidden="true">:</span>
        <span class="ss-cd-unit"><span id="countdown-seconds" class="ss-cd-value">00</span><span class="ss-cd-unit-label">{t("sale_banner.unit_seconds")}</span></span>
      </span>

      <span class="ss-cta">
        <span class="ss-cta-star" aria-hidden="true">★</span>
        {t("sale_banner.save_now")}
      </span>
    </div>

  </div>
</a>

<!-- Countdown "tick" animation: BaseLayout's inline script owns the actual countdown
     values (writes textContent every second and hides the banner at zero); this only
     watches those elements and replays a CSS pop-in animation when a digit changes. -->
<script>
  const UNIT_IDS = ["countdown-days", "countdown-hours", "countdown-minutes", "countdown-seconds"];
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (!reduceMotion) {
    for (const id of UNIT_IDS) {
      const el = document.getElementById(id);
      if (!el) continue;

      let last = el.textContent;
      const observer = new MutationObserver(() => {
        if (el.textContent === last) return;
        last = el.textContent;
        el.style.animation = "none";
        void el.offsetWidth; // force reflow so the animation restarts
        el.style.animation = "";
      });
      observer.observe(el, { childList: true, characterData: true, subtree: true });
    }
  }
</script>
