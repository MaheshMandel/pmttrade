---
interface Props {
  question: string;
}

const { question } = Astro.props;
---

<div class="faq-item">
  <button type="button" class="faq-question">
    <span>{question}</span>
    <div class="faq-icon">
      <i class="fa-solid fa-plus" aria-hidden="true"></i>
    </div>
  </button>
  <div class="faq-answer">
    <slot />
  </div>
</div>

<script>
  const faqs = document.querySelectorAll<HTMLElement>('.faq-item');

  faqs.forEach((faq) => {
    const question = faq.querySelector<HTMLElement>('.faq-question');
    const answer = faq.querySelector<HTMLElement>('.faq-answer');
    const icon = faq.querySelector<HTMLElement>('.faq-icon');
    if (!question || !answer) return;

    question.addEventListener('click', () => {
      const isActive = answer.classList.contains('active');

      document.querySelectorAll('.faq-answer.active').forEach((el) => el.classList.remove('active'));
      document.querySelectorAll('.faq-icon.active').forEach((el) => el.classList.remove('active'));

      if (!isActive) {
        answer.classList.add('active');
        icon?.classList.add('active');
      }
    });
  });
</script>
