---
import BaseLayout from "../../layouts/BaseLayout.astro";
import FaqItem from "../../components/FaqItem.astro";
import { getLocalePaths, useTranslations, localizedPath } from "../../i18n/utils";
import type { Locale } from "../../i18n/config";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };
const t = useTranslations(locale);

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [1, 2, 3, 4, 5, 6].map((n) => ({
    "@type": "Question",
    "name": t(`pickmytrade_review.faq_${n}_q` as any),
    "acceptedAnswer": { "@type": "Answer", "text": t(`pickmytrade_review.faq_${n}_a` as any) },
  })),
};

const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": `${SITE_URL}${withSlash(localizedPath(locale))}` },
    { "@type": "ListItem", "position": 2, "name": "PickMyTrade Review", "item": `${SITE_URL}${withSlash(localizedPath(locale, "pickmytrade-review"))}` },
  ],
};

const supportedBrokers = ["Tradovate", "Rithmic", "Interactive Brokers", "TradeStation", "TradeLocker", "ProjectX", "Match-Trader", "Tradier (Beta)", "cTrader (Beta)", "Ironbeam (Beta)"];
---

<BaseLayout
  locale={locale}
  title={t("pickmytrade_review.meta_title")}
  description={t("pickmytrade_review.meta_description")}
  ldJson={[faqSchema, breadcrumbSchema]}
>
  <style>
    .electrolize-regular { font-family: 'Electrolize', sans-serif; font-weight: 400; }
    .gradient-text { background: linear-gradient(135deg, #2B77EE, #0F3EC3); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; }
  </style>

  <div class="bg-[#001429]">
    <!-- Hero -->
    <section class="py-16 lg:py-24 border-b border-blue-900/30 bg-gradient-to-b from-[#001429] to-[#002040]">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <span class="inline-block px-4 py-2 bg-blue-600/20 text-blue-400 rounded-full text-sm font-semibold mb-6 border border-blue-500/30 uppercase electrolize-regular">
          {t("pickmytrade_review.hero_badge")}
        </span>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold text-white mb-6 tracking-tight">
          {t("pickmytrade_review.hero_h1")}
        </h1>
        <p class="text-xl md:text-2xl text-gray-300 max-w-3xl mx-auto leading-relaxed mb-8">
          {t("pickmytrade_review.hero_subtitle")}
        </p>
        <a href="https://app.pickmytrade.trade/?register=true"
          class="inline-flex items-center gap-2 px-8 py-4 bg-gradient-to-r from-blue-600 to-blue-700 hover:from-blue-700 hover:to-blue-800 text-white rounded-xl font-bold transition-all transform hover:scale-105 shadow-xl">
          <i class="fas fa-rocket"></i> {t("pickmytrade_review.hero_cta")}
        </a>
      </div>
    </section>

    <!-- What Is -->
    <section class="py-16 border-b border-gray-800">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-3xl font-bold text-white mb-4">{t("pickmytrade_review.whatis_h2")}</h2>
        <p class="text-gray-300 mb-4 leading-relaxed">{t("pickmytrade_review.whatis_p1")}</p>
        <p class="text-gray-300 leading-relaxed">{t("pickmytrade_review.whatis_p2")}</p>
      </div>
    </section>

    <!-- Features -->
    <section class="py-16 md:py-24 border-b border-blue-900/30 bg-gradient-to-b from-[#002040] to-[#001429]">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-3xl md:text-4xl font-bold text-white mb-12 text-center tracking-tight">{t("pickmytrade_review.features_h2")}</h2>
        <div class="grid md:grid-cols-2 gap-6">
          <div class="bg-gradient-to-br from-blue-900/20 to-blue-900/5 border border-blue-500/30 rounded-xl p-6">
            <h4 class="text-xl font-bold text-white mb-2">{t("pickmytrade_review.feat_1_title")}</h4>
            <p class="text-gray-300 leading-relaxed">{t("pickmytrade_review.feat_1_text")}</p>
          </div>
          <div class="bg-gradient-to-br from-green-900/20 to-green-900/5 border border-green-500/30 rounded-xl p-6">
            <h4 class="text-xl font-bold text-white mb-2">{t("pickmytrade_review.feat_2_title")}</h4>
            <p class="text-gray-300 leading-relaxed">{t("pickmytrade_review.feat_2_text")}</p>
          </div>
          <div class="bg-gradient-to-br from-purple-900/20 to-purple-900/5 border border-purple-500/30 rounded-xl p-6">
            <h4 class="text-xl font-bold text-white mb-2">{t("pickmytrade_review.feat_3_title")}</h4>
            <p class="text-gray-300 leading-relaxed">{t("pickmytrade_review.feat_3_text")}</p>
          </div>
          <div class="bg-gradient-to-br from-yellow-900/20 to-yellow-900/5 border border-yellow-500/30 rounded-xl p-6">
            <h4 class="text-xl font-bold text-white mb-2">{t("pickmytrade_review.feat_4_title")}</h4>
            <p class="text-gray-300 leading-relaxed">{t("pickmytrade_review.feat_4_text")}</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Pricing -->
    <section class="py-16 border-b border-gray-800">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h2 class="text-3xl font-bold text-white mb-4">{t("pickmytrade_review.pricing_h2")}</h2>
        <p class="text-gray-300 text-lg max-w-2xl mx-auto">{t("pickmytrade_review.pricing_p")}</p>
      </div>
    </section>

    <!-- Supported Brokers -->
    <section class="py-16 border-b border-blue-900/30 bg-gradient-to-b from-[#001429] to-[#002040]">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">{t("pickmytrade_review.brokers_h2")}</h2>
        <p class="text-gray-300 text-lg max-w-2xl mx-auto mb-10">{t("pickmytrade_review.brokers_subtitle")}</p>
        <div class="flex flex-wrap justify-center gap-3">
          {supportedBrokers.map((broker) => (
            <span class="px-4 py-2 bg-blue-600/20 text-blue-400 rounded-full text-sm font-semibold border border-blue-500/30 electrolize-regular">{broker}</span>
          ))}
        </div>
      </div>
    </section>

    <!-- Honest Considerations -->
    <section class="py-16 border-b border-gray-800">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-3xl font-bold text-white mb-4">{t("pickmytrade_review.considerations_h2")}</h2>
        <p class="text-gray-300 mb-4 leading-relaxed">{t("pickmytrade_review.considerations_p1")}</p>
        <p class="text-gray-300 mb-4 leading-relaxed">{t("pickmytrade_review.considerations_p2")}</p>
        <p class="text-gray-300 leading-relaxed">{t("pickmytrade_review.considerations_p3")}</p>
      </div>
    </section>

    <!-- FAQ -->
    <section class="py-16 border-b border-blue-900/30 bg-gradient-to-b from-[#002040] to-[#001429]">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
          <span class="inline-block px-4 py-2 bg-blue-600/20 text-blue-400 rounded-full text-sm font-semibold mb-4 border border-blue-500/30 uppercase electrolize-regular">{t("pickmytrade_review.faq_badge")}</span>
          <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">{t("pickmytrade_review.faq_h2")}</h2>
        </div>
        <div class="space-y-4">
          {[1, 2, 3, 4, 5, 6].map((n) => (
            <FaqItem question={t(`pickmytrade_review.faq_${n}_q` as any)}>
              <p>{t(`pickmytrade_review.faq_${n}_a` as any)}</p>
            </FaqItem>
          ))}
        </div>
      </div>
    </section>

    <!-- Verdict -->
    <section class="py-16 border-b border-gray-800">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-3xl font-bold text-white mb-4">{t("pickmytrade_review.verdict_h2")}</h2>
        <p class="text-gray-300 leading-relaxed">{t("pickmytrade_review.verdict_p")}</p>
      </div>
    </section>

    <!-- Alternatives -->
    <section class="py-16 border-b border-gray-800">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h2 class="text-3xl font-bold text-white mb-4">{t("pickmytrade_review.alternatives_h2")}</h2>
        <p class="text-gray-300 text-lg max-w-2xl mx-auto mb-8">{t("pickmytrade_review.alternatives_p")}</p>
        <a href={localizedPath(locale, "compare")}
          class="inline-flex items-center gap-2 px-8 py-4 bg-white/10 hover:bg-white/20 text-white rounded-xl font-bold border border-white/20 transition-all">
          <i class="fas fa-scale-balanced"></i> {t("pickmytrade_review.alternatives_cta")}
        </a>
      </div>
    </section>

    <!-- CTA -->
    <section class="py-16">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <div class="bg-gradient-to-r from-blue-600/20 to-purple-600/20 rounded-3xl p-12 border border-blue-500/30">
          <h2 class="text-3xl font-bold mb-4">{t("pickmytrade_review.cta_h2")}</h2>
          <p class="text-gray-300 mb-8 max-w-2xl mx-auto">{t("pickmytrade_review.cta_text")}</p>
          <div class="flex flex-col sm:flex-row justify-center gap-4">
            <a href="https://app.pickmytrade.trade/?register=true"
              class="inline-flex items-center justify-center gap-2 px-8 py-4 bg-gradient-to-r from-blue-600 to-blue-700 hover:from-blue-700 hover:to-blue-800 text-white rounded-xl font-bold transition-all transform hover:scale-105 shadow-xl">
              <i class="fas fa-rocket"></i> {t("pickmytrade_review.cta_primary")}
            </a>
            <a href={localizedPath(locale, "pages/pricing")}
              class="inline-flex items-center justify-center gap-2 px-8 py-4 bg-white/10 hover:bg-white/20 text-white rounded-xl font-bold border border-white/20 transition-all">
              <i class="fas fa-tag"></i> {t("pickmytrade_review.cta_secondary")}
            </a>
          </div>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
