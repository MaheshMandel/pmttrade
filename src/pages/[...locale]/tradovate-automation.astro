---
import BaseLayout from "../../layouts/BaseLayout.astro";
import FaqItem from "../../components/FaqItem.astro";
import { getLocalePaths, useTranslations, localizedPath } from "../../i18n/utils";
import type { Locale } from "../../i18n/config";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };
const t = useTranslations(locale);

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [1, 2, 3, 4, 5, 6, 7, 8].map((n) => ({
    "@type": "Question",
    "name": t(`tradovate_automation.faq_${n}_q` as any),
    "acceptedAnswer": { "@type": "Answer", "text": t(`tradovate_automation.faq_${n}_a` as any) },
  })),
};

const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": `${SITE_URL}${withSlash(localizedPath(locale))}` },
    { "@type": "ListItem", "position": 2, "name": "TradingView Automation", "item": `${SITE_URL}${withSlash(localizedPath(locale, "tradingview-automation"))}` },
    { "@type": "ListItem", "position": 3, "name": "Tradovate Automated Trading", "item": `${SITE_URL}${withSlash(localizedPath(locale, "tradovate-automation"))}` },
  ],
};

---

<BaseLayout
  locale={locale}
  title={t("tradovate_automation.meta_title")}
  description={t("tradovate_automation.meta_description")}
  ldJson={[faqSchema, breadcrumbSchema]}
>
  <style>
    .electrolize-regular { font-family: 'Electrolize', sans-serif; font-weight: 400; }
    .gradient-text { background: linear-gradient(135deg, #2B77EE, #0F3EC3); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; }
  </style>

  <div class="bg-[#001429]">
    <!-- Hero -->
    <section class="py-16 lg:py-24 border-b border-blue-900/30 bg-gradient-to-b from-[#001429] to-[#002040]">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <span class="inline-block px-4 py-2 bg-blue-600/20 text-blue-400 rounded-full text-sm font-semibold mb-6 border border-blue-500/30 uppercase electrolize-regular">
          {t("tradovate_automation.hero_badge")}
        </span>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold text-white mb-6 tracking-tight">
          {t("tradovate_automation.hero_h1_pre")} <span class="gradient-text">{t("tradovate_automation.hero_h1_gradient")}</span>
        </h1>
        <p class="text-xl md:text-2xl text-gray-300 max-w-3xl mx-auto leading-relaxed mb-8">
          {t("tradovate_automation.hero_subtitle")}
        </p>
        <a href="https://app.pickmytrade.trade/?register=true"
          class="inline-flex items-center gap-2 px-8 py-4 bg-gradient-to-r from-blue-600 to-blue-700 hover:from-blue-700 hover:to-blue-800 text-white rounded-xl font-bold transition-all transform hover:scale-105 shadow-xl">
          <i class="fas fa-rocket"></i> {t("tradovate_automation.hero_cta")}
        </a>
      </div>
    </section>

    <!-- Why Automate -->
    <section class="py-16 border-b border-gray-800">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-3xl font-bold text-white mb-4">{t("tradovate_automation.why_h2")}</h2>
        <p class="text-gray-300 mb-4 leading-relaxed">{t("tradovate_automation.why_p1")}</p>
        <p class="text-gray-300 leading-relaxed">{t("tradovate_automation.why_p2")}</p>
      </div>
    </section>

    <!-- Methods -->
    <section class="py-16 md:py-24 border-b border-blue-900/30 bg-gradient-to-b from-[#002040] to-[#001429]">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
          <h2 class="text-3xl md:text-4xl font-bold text-white mb-4 tracking-tight">{t("tradovate_automation.methods_h2")}</h2>
          <p class="text-gray-300 text-lg max-w-2xl mx-auto">{t("tradovate_automation.methods_subtitle")}</p>
        </div>
        <div class="space-y-6">
          <div class="bg-gradient-to-br from-gray-800/50 to-gray-900/50 rounded-xl p-6 border border-gray-700/50 hover:border-green-500/50 transition-all duration-300">
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 bg-gradient-to-br from-green-500/20 to-green-600/20 rounded-xl flex items-center justify-center">
                <i class="fas fa-bolt text-green-400 text-xl"></i>
              </div>
              <div>
                <h4 class="text-xl font-bold text-white mb-2">{t("tradovate_automation.method1_h4")} <span class="text-green-400 text-sm">{t("tradovate_automation.method1_recommended")}</span></h4>
                <p class="text-gray-300 leading-relaxed">{t("tradovate_automation.method1_p")}</p>
              </div>
            </div>
          </div>
          <div class="bg-gradient-to-br from-gray-800/50 to-gray-900/50 rounded-xl p-6 border border-gray-700/50 hover:border-blue-500/50 transition-all duration-300">
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 bg-gradient-to-br from-blue-500/20 to-blue-600/20 rounded-xl flex items-center justify-center">
                <i class="fas fa-copy text-blue-400 text-xl"></i>
              </div>
              <div>
                <h4 class="text-xl font-bold text-white mb-2">{t("tradovate_automation.method2_h4")}</h4>
                <p class="text-gray-300 leading-relaxed">{t("tradovate_automation.method2_p")}</p>
              </div>
            </div>
          </div>
          <div class="bg-gradient-to-br from-gray-800/50 to-gray-900/50 rounded-xl p-6 border border-gray-700/50 hover:border-red-500/50 transition-all duration-300">
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 bg-gradient-to-br from-red-500/20 to-red-600/20 rounded-xl flex items-center justify-center">
                <i class="fas fa-times text-red-400 text-xl"></i>
              </div>
              <div>
                <h4 class="text-xl font-bold text-white mb-2">{t("tradovate_automation.method3_h4")}</h4>
                <p class="text-gray-300 leading-relaxed">{t("tradovate_automation.method3_p")}</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- What Can You Automate -->
    <section class="py-16 md:py-24 border-b border-gray-800">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
          <h2 class="text-3xl md:text-4xl font-bold text-white mb-4 tracking-tight">{t("tradovate_automation.whatcan_h2")}</h2>
          <p class="text-gray-300 text-lg max-w-2xl mx-auto">{t("tradovate_automation.whatcan_subtitle")}</p>
        </div>
        <div class="grid md:grid-cols-2 gap-6">
          <div class="bg-gradient-to-br from-blue-900/20 to-blue-900/5 border border-blue-500/30 rounded-xl p-6">
            <h4 class="text-xl font-bold text-white mb-2">{t("tradovate_automation.whatcan_1_title")}</h4>
            <p class="text-gray-300 leading-relaxed">{t("tradovate_automation.whatcan_1_text")}</p>
          </div>
          <div class="bg-gradient-to-br from-green-900/20 to-green-900/5 border border-green-500/30 rounded-xl p-6">
            <h4 class="text-xl font-bold text-white mb-2">{t("tradovate_automation.whatcan_2_title")}</h4>
            <p class="text-gray-300 leading-relaxed">{t("tradovate_automation.whatcan_2_text")}</p>
          </div>
          <div class="bg-gradient-to-br from-purple-900/20 to-purple-900/5 border border-purple-500/30 rounded-xl p-6">
            <h4 class="text-xl font-bold text-white mb-2">{t("tradovate_automation.whatcan_3_title")}</h4>
            <p class="text-gray-300 leading-relaxed">{t("tradovate_automation.whatcan_3_text")}</p>
          </div>
          <div class="bg-gradient-to-br from-yellow-900/20 to-yellow-900/5 border border-yellow-500/30 rounded-xl p-6">
            <h4 class="text-xl font-bold text-white mb-2">{t("tradovate_automation.whatcan_4_title")}</h4>
            <p class="text-gray-300 leading-relaxed">{t("tradovate_automation.whatcan_4_text")}</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Prop Firm Section -->
    <section class="py-16 border-b border-blue-900/30 bg-gradient-to-b from-[#001429] to-[#002040]">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-3xl font-bold text-white mb-4">{t("tradovate_automation.propfirm_h2")}</h2>
        <p class="text-gray-300 mb-4 leading-relaxed">{t("tradovate_automation.propfirm_p1")}</p>
        <p class="text-gray-300 leading-relaxed">{t("tradovate_automation.propfirm_p2")}</p>
      </div>
    </section>

    <!-- Pricing -->
    <section class="py-16 border-b border-gray-800">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h2 class="text-3xl font-bold text-white mb-4">{t("tradovate_automation.pricing_h2")}</h2>
        <p class="text-gray-300 text-lg max-w-2xl mx-auto">{t("tradovate_automation.pricing_p")}</p>
      </div>
    </section>

    <!-- FAQ -->
    <section class="py-16 border-b border-gray-800">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
          <span class="inline-block px-4 py-2 bg-blue-600/20 text-blue-400 rounded-full text-sm font-semibold mb-4 border border-blue-500/30 uppercase electrolize-regular">{t("tradovate_automation.faq_badge")}</span>
          <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">{t("tradovate_automation.faq_h2")}</h2>
        </div>
        <div class="space-y-4">
          {[1, 2, 3, 4, 5, 6, 7, 8].map((n) => (
            <FaqItem question={t(`tradovate_automation.faq_${n}_q` as any)}>
              <p>{t(`tradovate_automation.faq_${n}_a` as any)}</p>
            </FaqItem>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="py-16">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <div class="bg-gradient-to-r from-blue-600/20 to-purple-600/20 rounded-3xl p-12 border border-blue-500/30">
          <h2 class="text-3xl font-bold mb-4">{t("tradovate_automation.cta_h2")}</h2>
          <p class="text-gray-300 mb-8 max-w-2xl mx-auto">{t("tradovate_automation.cta_text")}</p>
          <div class="flex flex-col sm:flex-row justify-center gap-4">
            <a href="https://app.pickmytrade.trade/?register=true"
              class="inline-flex items-center justify-center gap-2 px-8 py-4 bg-gradient-to-r from-blue-600 to-blue-700 hover:from-blue-700 hover:to-blue-800 text-white rounded-xl font-bold transition-all transform hover:scale-105 shadow-xl">
              <i class="fas fa-rocket"></i> {t("tradovate_automation.cta_primary")}
            </a>
            <a href={localizedPath(locale, "pages/pricing")}
              class="inline-flex items-center justify-center gap-2 px-8 py-4 bg-white/10 hover:bg-white/20 text-white rounded-xl font-bold border border-white/20 transition-all">
              <i class="fas fa-tag"></i> {t("tradovate_automation.cta_secondary")}
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Related -->
    <section class="py-16 border-t border-blue-900/30 bg-[#002040]">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <h3 class="text-xl font-bold text-white mb-6">{t("tradovate_automation.related_h3")}</h3>
        <div class="grid sm:grid-cols-3 gap-4">
          <a href={localizedPath(locale, "tradingview-to-tradovate")} class="bg-[#12121a] rounded-lg p-4 border border-gray-800 hover:border-gray-600 transition">
            <span class="text-white font-medium">{t("tradovate_automation.related_1_title")}</span>
            <p class="text-gray-500 text-sm">{t("tradovate_automation.related_1_text")}</p>
          </a>
          <a href={localizedPath(locale, "tradovate-trade-copier")} class="bg-[#12121a] rounded-lg p-4 border border-gray-800 hover:border-gray-600 transition">
            <span class="text-white font-medium">{t("tradovate_automation.related_2_title")}</span>
            <p class="text-gray-500 text-sm">{t("tradovate_automation.related_2_text")}</p>
          </a>
          <a href={localizedPath(locale, "supported-propfirms")} class="bg-[#12121a] rounded-lg p-4 border border-gray-800 hover:border-gray-600 transition">
            <span class="text-white font-medium">{t("tradovate_automation.related_3_title")}</span>
            <p class="text-gray-500 text-sm">{t("tradovate_automation.related_3_text")}</p>
          </a>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
