---
import BaseLayout from "../../layouts/BaseLayout.astro";
import FaqItem from "../../components/FaqItem.astro";
import { getLocalePaths, useTranslations, localizedPath } from "../../i18n/utils";
import type { Locale } from "../../i18n/config";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };
const t = useTranslations(locale);

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": Array.from({ length: 14 }, (_, i) => i + 1).map((n) => ({
    "@type": "Question",
    "name": t(`tradovate_copier.faq_${n}_q` as any),
    "acceptedAnswer": { "@type": "Answer", "text": t(`tradovate_copier.faq_${n}_a` as any) },
  })),
};

const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": t("tradovate_copier.breadcrumb_home"), "item": `${SITE_URL}${withSlash(localizedPath(locale))}` },
    { "@type": "ListItem", "position": 2, "name": t("tradovate_copier.breadcrumb_current"), "item": `${SITE_URL}${withSlash(localizedPath(locale, "tradovate-trade-copier"))}` },
  ],
};


// Full literal class strings so Tailwind's static scanner can see and
// generate each utility — see note in tradingview-to-tradovate.astro.
const featureIcons = [
  { key: "feat_1", icon: "fa-layer-group", wrap: "bg-gradient-to-br from-blue-900/20 to-blue-900/5 border border-blue-500/30 hover:border-blue-500/50", iconBg: "bg-blue-500/20", iconText: "text-blue-400" },
  { key: "feat_2", icon: "fa-sliders", wrap: "bg-gradient-to-br from-purple-900/20 to-purple-900/5 border border-purple-500/30 hover:border-purple-500/50", iconBg: "bg-purple-500/20", iconText: "text-purple-400" },
  { key: "feat_3", icon: "fa-rotate", wrap: "bg-gradient-to-br from-green-900/20 to-green-900/5 border border-green-500/30 hover:border-green-500/50", iconBg: "bg-green-500/20", iconText: "text-green-400" },
  { key: "feat_4", icon: "fa-shield-halved", wrap: "bg-gradient-to-br from-yellow-900/20 to-yellow-900/5 border border-yellow-500/30 hover:border-yellow-500/50", iconBg: "bg-yellow-500/20", iconText: "text-yellow-400" },
  { key: "feat_5", icon: "fa-cloud", wrap: "bg-gradient-to-br from-red-900/20 to-red-900/5 border border-red-500/30 hover:border-red-500/50", iconBg: "bg-red-500/20", iconText: "text-red-400" },
  { key: "feat_6", icon: "fa-hand-pointer", wrap: "bg-gradient-to-br from-cyan-900/20 to-cyan-900/5 border border-cyan-500/30 hover:border-cyan-500/50", iconBg: "bg-cyan-500/20", iconText: "text-cyan-400" },
];
---

<BaseLayout
  locale={locale}
  title={t("tradovate_copier.meta_title")}
  description={t("tradovate_copier.meta_description")}
  keywords={t("tradovate_copier.keywords")}
  ldJson={[faqSchema, breadcrumbSchema]}
>
  <style>
    .prose-section p { margin-bottom: 1rem; line-height: 1.8; }
  </style>

  <div class="bg-[#001429]">
    <!-- Breadcrumb -->
    <nav aria-label="Breadcrumb" class="bg-[#001429] py-4 border-b border-white/5">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <ol class="flex items-center gap-2 text-sm text-gray-400">
          <li><a href={localizedPath(locale)} class="hover:text-blue-400 transition">{t("tradovate_copier.breadcrumb_home")}</a></li>
          <li>/</li>
          <li class="text-white font-semibold">{t("tradovate_copier.breadcrumb_current")}</li>
        </ol>
      </div>
    </nav>

    <!-- Hero -->
    <section class="py-16 lg:py-24 border-b border-blue-900/30 bg-gradient-to-b from-[#001429] to-[#002040]">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <span class="inline-block px-4 py-2 bg-blue-600/20 text-blue-400 rounded-full text-sm font-semibold mb-6 border border-blue-500/30 tracking-wide uppercase electrolize-regular">
          {t("tradovate_copier.hero_badge")}
        </span>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold text-white mb-6 tracking-tight leading-tight">
          {t("tradovate_copier.hero_h1_pre")} <span class="gradient-text">{t("tradovate_copier.hero_h1_highlight")}</span>
        </h1>
        <p class="text-xl md:text-2xl text-gray-300 max-w-3xl mx-auto leading-relaxed mb-8">
          {t("tradovate_copier.hero_subtitle")}
        </p>

        <div class="flex flex-col sm:flex-row gap-4 justify-center items-center mb-4">
          <a href="https://app.pickmytrade.trade/?register=true"
            class="inline-flex items-center justify-center px-8 py-4 text-base font-semibold text-white bg-gradient-to-r from-blue-600 to-blue-700 rounded-lg hover:from-blue-700 hover:to-blue-800 transition-all duration-300 shadow-lg hover:shadow-blue-500/50 hover:scale-105 electrolize-regular">
            {t("tradovate_copier.hero_cta_primary")}
            <i class="fa-solid fa-arrow-right ml-2" aria-hidden="true"></i>
          </a>
          <a href="#how-it-works"
            class="inline-flex items-center justify-center px-8 py-4 text-base font-semibold text-blue-400 bg-white/5 backdrop-blur-sm border border-blue-500/30 rounded-lg hover:bg-white/10 transition-all duration-300 electrolize-regular">
            {t("tradovate_copier.hero_cta_secondary")}
          </a>
        </div>
        <p class="text-xs text-gray-400 mb-8">{t("tradovate_copier.hero_note")}</p>

        <div class="flex flex-wrap justify-center gap-3 text-sm">
          <div class="flex items-center gap-2 bg-white/5 backdrop-blur-sm border border-white/10 rounded-full px-4 py-2">
            <i class="fa-solid fa-users text-blue-400" aria-hidden="true"></i>
            <span class="text-gray-300">{t("tradovate_copier.trust_1")}</span>
          </div>
          <div class="flex items-center gap-2 bg-white/5 backdrop-blur-sm border border-white/10 rounded-full px-4 py-2">
            <i class="fa-solid fa-chart-line text-blue-400" aria-hidden="true"></i>
            <span class="text-gray-300">{t("tradovate_copier.trust_3")}</span>
          </div>
          <div class="flex items-center gap-2 bg-white/5 backdrop-blur-sm border border-white/10 rounded-full px-4 py-2">
            <i class="fa-solid fa-shield-halved text-blue-400" aria-hidden="true"></i>
            <span class="text-gray-300">{t("tradovate_copier.trust_4")}</span>
          </div>
        </div>
      </div>
    </section>

    <!-- What is -->
    <section class="py-16 border-b border-blue-900/30">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 prose-section">
        <h2 class="text-3xl font-bold text-white">{t("tradovate_copier.whatis_h2")}</h2>
        <p class="text-gray-300">{t("tradovate_copier.whatis_p1")}</p>
        <p class="text-gray-300">{t("tradovate_copier.whatis_p2")}</p>
        <p class="text-gray-300">{t("tradovate_copier.whatis_p3")}</p>
      </div>
    </section>

    <!-- Two modes -->
    <section class="py-16 lg:py-20 border-b border-blue-900/30 bg-gradient-to-b from-[#001429] to-[#002040]">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
          <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">{t("tradovate_copier.modes_h2")}</h2>
          <p class="text-gray-400 max-w-2xl mx-auto">{t("tradovate_copier.modes_subtitle")}</p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="bg-gradient-to-br from-blue-900/20 to-blue-900/5 border border-blue-500/30 rounded-xl p-6">
            <div class="w-12 h-12 bg-blue-500/20 rounded-lg flex items-center justify-center mb-4">
              <i class="fa-solid fa-bolt text-blue-400 text-xl" aria-hidden="true"></i>
            </div>
            <h3 class="text-lg font-bold text-white mb-2">{t("tradovate_copier.mode_1_title")}</h3>
            <p class="text-sm text-gray-300 leading-relaxed">{t("tradovate_copier.mode_1_text")}</p>
          </div>
          <div class="bg-gradient-to-br from-blue-900/20 to-blue-900/5 border border-blue-500/30 rounded-xl p-6">
            <div class="w-12 h-12 bg-blue-500/20 rounded-lg flex items-center justify-center mb-4">
              <i class="fa-solid fa-hand-pointer text-blue-400 text-xl" aria-hidden="true"></i>
            </div>
            <h3 class="text-lg font-bold text-white mb-2">{t("tradovate_copier.mode_2_title")}</h3>
            <p class="text-sm text-gray-300 leading-relaxed">{t("tradovate_copier.mode_2_text")}</p>
          </div>
        </div>
        <p class="mt-8 text-center text-sm text-gray-400 max-w-3xl mx-auto">{t("tradovate_copier.modes_footnote")}</p>
      </div>
    </section>

    <!-- TradingView trade copier -->
    <section class="py-16 border-b border-blue-900/30">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 prose-section">
        <h2 class="text-3xl font-bold text-white">{t("tradovate_copier.tvcopier_h2")}</h2>
        <p class="text-gray-300">{t("tradovate_copier.tvcopier_p1")}</p>
        <p class="text-gray-300">{t("tradovate_copier.tvcopier_p2")}</p>
        <p class="text-gray-300">
          {t("tradovate_copier.tvcopier_p3_pre")} <a href={localizedPath(locale, "tradingview-to-tradovate")} class="text-blue-400 hover:text-blue-300 underline">{t("tradovate_copier.tvcopier_p3_link")}</a>{t("tradovate_copier.tvcopier_p3_post")} <a href={localizedPath(locale, "tradingview-trade-copier")} class="text-blue-400 hover:text-blue-300 underline">{t("tradovate_copier.tvcopier_p3_link2")}</a>{t("tradovate_copier.tvcopier_p3_end")}
        </p>
      </div>
    </section>

    <!-- Prop-firm -->
    <section class="py-16 border-b border-blue-900/30 bg-gradient-to-b from-[#001429] to-[#002040]">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 prose-section">
        <span class="inline-block px-4 py-2 bg-purple-600/20 text-purple-400 rounded-full text-sm font-semibold mb-6 border border-purple-500/30 uppercase electrolize-regular">
          {t("tradovate_copier.trust_4")}
        </span>
        <h2 class="text-3xl font-bold text-white">{t("tradovate_copier.propfirm_h2")}</h2>
        <p class="text-gray-300">{t("tradovate_copier.propfirm_p1")}</p>
        <p class="text-gray-300">{t("tradovate_copier.propfirm_p2")}</p>
        <p class="text-gray-300">{t("tradovate_copier.propfirm_p3")}</p>
        <a href={localizedPath(locale, "supported-propfirms")} class="inline-flex items-center gap-2 text-sm font-semibold text-blue-400 hover:text-white transition">
          {t("tradovate_copier.propfirm_link")} <i class="fa-solid fa-arrow-right text-xs" aria-hidden="true"></i>
        </a>
      </div>
    </section>

    <!-- Multi-account / futures -->
    <section class="py-16 border-b border-blue-900/30">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 prose-section">
        <h2 class="text-3xl font-bold text-white">{t("tradovate_copier.multiaccount_h2")}</h2>
        <p class="text-gray-300">{t("tradovate_copier.multiaccount_p1")}</p>
        <p class="text-gray-300">{t("tradovate_copier.multiaccount_p2")}</p>
        <h3 class="text-xl font-bold text-white mt-8">{t("tradovate_copier.futures_h3")}</h3>
        <p class="text-gray-300">{t("tradovate_copier.futures_p1")}</p>
        <p class="text-gray-300">{t("tradovate_copier.futures_p2")}</p>
      </div>
    </section>

    <!-- Features grid -->
    <section class="py-16 lg:py-20 border-b border-blue-900/30 bg-gradient-to-b from-[#001429] to-[#002040]">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
          <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">{t("tradovate_copier.features_h2")}</h2>
          <p class="text-gray-400 max-w-2xl mx-auto">{t("tradovate_copier.features_subtitle")}</p>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {featureIcons.map((f) => (
            <div class={`${f.wrap} rounded-xl p-6 transition-all`}>
              <div class={`w-12 h-12 ${f.iconBg} rounded-lg flex items-center justify-center mb-4`}>
                <i class={`fa-solid ${f.icon} ${f.iconText} text-xl`} aria-hidden="true"></i>
              </div>
              <h3 class="text-lg font-bold text-white mb-2">{t(`tradovate_copier.${f.key}_title` as any)}</h3>
              <p class="text-sm text-gray-300 leading-relaxed">{t(`tradovate_copier.${f.key}_text` as any)}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- How to set up -->
    <section id="how-it-works" class="py-16 lg:py-20 border-b border-blue-900/30 scroll-mt-20">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
          <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">{t("tradovate_copier.howto_h2")}</h2>
          <p class="text-gray-400 max-w-2xl mx-auto">{t("tradovate_copier.howto_subtitle")}</p>
        </div>

        <ol class="space-y-4">
          {[1, 2, 3, 4, 5].map((step) => (
            <li class="flex gap-4 bg-gradient-to-br from-blue-900/20 to-blue-900/5 border border-blue-500/30 rounded-xl p-6">
              <span class="shrink-0 w-9 h-9 rounded-lg bg-blue-600 text-white font-bold flex items-center justify-center">{step}</span>
              <div>
                <h3 class="font-bold text-white text-base mb-1">{t(`tradovate_copier.howto_step${step}_title` as any)}</h3>
                <p class="text-sm text-gray-300 leading-relaxed">{t(`tradovate_copier.howto_step${step}_text` as any)}</p>
              </div>
            </li>
          ))}
        </ol>

        <div class="mt-8 text-center">
          <a href="https://docs.pickmytrade.trade/docs/" class="inline-flex items-center gap-2 text-sm font-semibold text-blue-400 hover:text-white transition">
            {t("tradovate_copier.howto_docs_link")} <i class="fa-solid fa-arrow-up-right-from-square text-xs" aria-hidden="true"></i>
          </a>
        </div>
      </div>
    </section>

    <!-- Pricing -->
    <section id="pricing" class="py-16 lg:py-20 border-b border-blue-900/30 bg-gradient-to-b from-[#001429] to-[#002040] scroll-mt-20">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">{t("tradovate_copier.pricing_h2")}</h2>
        <p class="text-gray-400 max-w-2xl mx-auto mb-12">{t("tradovate_copier.pricing_subtitle")}</p>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5 max-w-2xl mx-auto">
          <div class="bg-gradient-to-br from-blue-900/30 to-blue-800/10 rounded-xl p-7 border border-blue-500/30">
            <p class="text-sm text-blue-400 uppercase tracking-wider electrolize-regular mb-2">{t("tradovate_copier.pricing_monthly_label")}</p>
            <p class="text-4xl font-bold text-white mb-1">{t("tradovate_copier.pricing_monthly_price")}<span class="text-base font-normal text-gray-400">{t("tradovate_copier.pricing_monthly_period")}</span></p>
            <p class="text-sm text-gray-400">{t("tradovate_copier.pricing_monthly_note")}</p>
          </div>
          <div class="relative bg-gradient-to-br from-blue-800/40 to-blue-900/20 rounded-xl p-7 border border-blue-500">
            <span class="absolute -top-3 left-1/2 -translate-x-1/2 bg-blue-600 text-white text-xs font-semibold px-3 py-1 rounded-full">{t("tradovate_copier.pricing_yearly_badge")}</span>
            <p class="text-sm text-blue-400 uppercase tracking-wider electrolize-regular mb-2">{t("tradovate_copier.pricing_yearly_label")}</p>
            <p class="text-4xl font-bold text-white mb-1">{t("tradovate_copier.pricing_yearly_price")}<span class="text-base font-normal text-gray-400">{t("tradovate_copier.pricing_yearly_period")}</span></p>
            <p class="text-sm text-gray-400">{t("tradovate_copier.pricing_yearly_note")}</p>
          </div>
        </div>
        <div class="mt-8">
          <a href="https://app.pickmytrade.trade/?register=true"
            class="inline-flex items-center px-8 py-3.5 rounded-lg text-sm font-semibold text-white bg-gradient-to-r from-blue-600 to-blue-700 hover:from-blue-700 hover:to-blue-800 transition-all duration-300 shadow-lg hover:shadow-blue-500/50 electrolize-regular">
            {t("tradovate_copier.pricing_cta")} <i class="fa-solid fa-arrow-right ml-2" aria-hidden="true"></i>
          </a>
          <p class="mt-4 text-xs text-gray-500">{t("tradovate_copier.pricing_footer")}</p>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section id="faq" class="py-16 border-b border-blue-900/30">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
          <span class="inline-block px-4 py-2 bg-blue-600/20 text-blue-400 rounded-full text-sm font-semibold mb-4 border border-blue-500/30 uppercase electrolize-regular">
            FAQ
          </span>
          <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">{t("tradovate_copier.faq_h2")}</h2>
          <p class="text-gray-400">{t("tradovate_copier.faq_subtitle")}</p>
        </div>

        <div class="faq-content space-y-4">
          {Array.from({ length: 14 }, (_, i) => i + 1).map((n) => (
            <FaqItem question={t(`tradovate_copier.faq_${n}_q` as any)}>
              <p>{t(`tradovate_copier.faq_${n}_a` as any)}</p>
            </FaqItem>
          ))}
        </div>
      </div>
    </section>

    <!-- Final CTA -->
    <section class="py-16">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <div class="bg-gradient-to-r from-blue-600/20 to-purple-600/20 rounded-3xl p-12 border border-blue-500/30">
          <h2 class="text-3xl font-bold mb-4 text-white">{t("tradovate_copier.cta_h2")}</h2>
          <p class="text-gray-300 mb-8 max-w-2xl mx-auto">{t("tradovate_copier.cta_text")}</p>
          <div class="flex flex-col sm:flex-row justify-center gap-4">
            <a href="https://app.pickmytrade.trade/?register=true"
              class="inline-flex items-center justify-center gap-2 px-8 py-4 bg-gradient-to-r from-blue-600 to-blue-700 hover:from-blue-700 hover:to-blue-800 text-white rounded-xl font-bold transition-all transform hover:scale-105 shadow-xl">
              <i class="fas fa-rocket"></i> {t("tradovate_copier.cta_primary")}
            </a>
            <a href="https://docs.pickmytrade.trade/docs/"
              class="inline-flex items-center justify-center gap-2 px-8 py-4 bg-white/10 hover:bg-white/20 text-white rounded-xl font-bold border border-white/20 transition-all">
              <i class="fas fa-book"></i> {t("tradovate_copier.cta_docs")}
            </a>
          </div>
        </div>

        <div class="mt-12 pt-8 border-t border-white/10">
          <p class="text-xs uppercase tracking-widest text-gray-400 mb-4 electrolize-regular">{t("tradovate_copier.related_label")}</p>
          <div class="flex flex-wrap items-center justify-center gap-x-5 gap-y-2 text-sm">
            <a href={localizedPath(locale, "tradingview-to-tradovate")} class="text-blue-400 hover:text-white transition">{t("tradovate_copier.related_link1")}</a>
            <span class="text-gray-700">|</span>
            <a href={localizedPath(locale, "tradingview-trade-copier")} class="text-blue-400 hover:text-white transition">{t("tradovate_copier.related_link2")}</a>
            <span class="text-gray-700">|</span>
            <a href={localizedPath(locale, "use-cases/multi-account-traders")} class="text-blue-400 hover:text-white transition">{t("tradovate_copier.related_link3")}</a>
            <span class="text-gray-700">|</span>
            <a href={localizedPath(locale, "supported-propfirms")} class="text-blue-400 hover:text-white transition">{t("tradovate_copier.related_link4")}</a>
            <span class="text-gray-700">|</span>
            <a href={localizedPath(locale, "pages/pricing")} class="text-blue-400 hover:text-white transition">{t("tradovate_copier.related_link5")}</a>
          </div>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
