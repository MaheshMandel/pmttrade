---
import BaseLayout from "../../layouts/BaseLayout.astro";
import FaqItem from "../../components/FaqItem.astro";
import { getLocalePaths, useTranslations, localizedPath } from "../../i18n/utils";
import type { Locale } from "../../i18n/config";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };
const t = useTranslations(locale);

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": Array.from({ length: 14 }, (_, i) => i + 1).map((n) => ({
    "@type": "Question",
    "name": t(`tv_copier.faq_${n}_q` as any),
    "acceptedAnswer": { "@type": "Answer", "text": t(`tv_copier.faq_${n}_a` as any) },
  })),
};

const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": t("tv_copier.breadcrumb_home"), "item": `${SITE_URL}${withSlash(localizedPath(locale))}` },
    { "@type": "ListItem", "position": 2, "name": t("tv_copier.breadcrumb_current"), "item": `${SITE_URL}${withSlash(localizedPath(locale, "tradingview-trade-copier"))}` },
  ],
};


const oneSignalCards = [
  { key: "onesignal_card1", icon: "fa-1" },
  { key: "onesignal_card2", icon: "fa-arrows-split-up-and-left" },
  { key: "onesignal_card3", icon: "fa-infinity" },
];

const assetCards = [
  { key: "asset_futures", icon: "fa-chart-column", wrap: "bg-gradient-to-br from-blue-900/20 to-blue-900/5 border border-blue-500/30", iconBg: "bg-blue-500/20", iconText: "text-blue-400" },
  { key: "asset_stocks", icon: "fa-building-columns", wrap: "bg-gradient-to-br from-green-900/20 to-green-900/5 border border-green-500/30", iconBg: "bg-green-500/20", iconText: "text-green-400" },
];

const brokers = [
  { n: 1, href: "tradovate-trade-copier", internal: true },
  { n: 2, href: "https://pickmytrade.io/broker/tradingview-to-rithmic/" },
  { n: 3, href: "https://pickmytrade.io/broker/tradingview-to-ib/" },
  { n: 4, href: "https://pickmytrade.io/broker/tradingview-to-tradestation/" },
  { n: 5, href: "https://pickmytrade.io/broker/tradingview-to-tradelocker/" },
  { n: 6, href: "https://pickmytrade.io/broker/tradingview-to-projectx/" },
  { n: 7, href: "https://pickmytrade.io/broker/tradingview-to-matchtrader/" },
  { n: 8, href: "https://pickmytrade.io/broker/tradingview-to-tradier/" },
  { n: 9, href: "https://pickmytrade.io/broker/tradingview-to-ctrader/" },
  { n: 10, href: "https://pickmytrade.io/broker/tradingview-to-ironbeam/" },
];

const stats = [1, 2, 3];
---

<BaseLayout
  locale={locale}
  title={t("tv_copier.meta_title")}
  description={t("tv_copier.meta_description")}
  keywords={t("tv_copier.keywords")}
  ldJson={[faqSchema, breadcrumbSchema]}
>
  <style>
    .prose-section p { margin-bottom: 1rem; line-height: 1.8; }
  </style>

  <div class="bg-[#001429]">
    <!-- Breadcrumb -->
    <nav aria-label="Breadcrumb" class="bg-[#001429] py-4 border-b border-white/5">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <ol class="flex items-center gap-2 text-sm text-gray-400">
          <li><a href={localizedPath(locale)} class="hover:text-blue-400 transition">{t("tv_copier.breadcrumb_home")}</a></li>
          <li>/</li>
          <li class="text-white font-semibold">{t("tv_copier.breadcrumb_current")}</li>
        </ol>
      </div>
    </nav>

    <!-- Hero -->
    <section class="py-16 lg:py-24 border-b border-blue-900/30 bg-gradient-to-b from-[#001429] to-[#002040]">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <span class="inline-block px-4 py-2 bg-blue-600/20 text-blue-400 rounded-full text-sm font-semibold mb-6 border border-blue-500/30 tracking-wide uppercase electrolize-regular">
          {t("tv_copier.hero_badge")}
        </span>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold text-white mb-6 tracking-tight leading-tight">
          <span class="gradient-text">{t("tv_copier.hero_h1")}</span>
        </h1>
        <p class="text-xl md:text-2xl text-gray-300 max-w-3xl mx-auto leading-relaxed mb-8">
          {t("tv_copier.hero_subtitle")}
        </p>

        <div class="flex flex-col sm:flex-row gap-4 justify-center items-center mb-4">
          <a href="https://app.pickmytrade.trade/?register=true"
            class="inline-flex items-center justify-center px-8 py-4 text-base font-semibold text-white bg-gradient-to-r from-blue-600 to-blue-700 rounded-lg hover:from-blue-700 hover:to-blue-800 transition-all duration-300 shadow-lg hover:shadow-blue-500/50 hover:scale-105 electrolize-regular">
            {t("tv_copier.hero_cta_primary")}
            <i class="fa-solid fa-arrow-right ml-2" aria-hidden="true"></i>
          </a>
          <a href="#how-it-works"
            class="inline-flex items-center justify-center px-8 py-4 text-base font-semibold text-blue-400 bg-white/5 backdrop-blur-sm border border-blue-500/30 rounded-lg hover:bg-white/10 transition-all duration-300 electrolize-regular">
            {t("tv_copier.hero_cta_secondary")}
          </a>
        </div>
        <p class="text-xs text-gray-400 mb-8">{t("tv_copier.hero_note")}</p>

        <div class="flex flex-wrap justify-center gap-3 text-sm">
          <div class="flex items-center gap-2 bg-white/5 backdrop-blur-sm border border-white/10 rounded-full px-4 py-2">
            <i class="fa-solid fa-users text-blue-400" aria-hidden="true"></i>
            <span class="text-gray-300">{t("tv_copier.trust_1")}</span>
          </div>
          <div class="flex items-center gap-2 bg-white/5 backdrop-blur-sm border border-white/10 rounded-full px-4 py-2">
            <i class="fa-solid fa-chart-line text-blue-400" aria-hidden="true"></i>
            <span class="text-gray-300">{t("tv_copier.trust_3")}</span>
          </div>
        </div>
      </div>
    </section>

    <!-- What is -->
    <section class="py-16 border-b border-blue-900/30">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 prose-section">
        <h2 class="text-3xl font-bold text-white">{t("tv_copier.whatis_h2")}</h2>
        <p class="text-gray-300">{t("tv_copier.whatis_p1")}</p>
        <p class="text-gray-300">{t("tv_copier.whatis_p2")}</p>
        <p class="text-gray-300">{t("tv_copier.whatis_p3")}</p>
      </div>
    </section>

    <!-- One signal, unlimited accounts -->
    <section class="py-16 border-b border-blue-900/30 bg-gradient-to-b from-[#001429] to-[#002040]">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 prose-section">
        <h2 class="text-3xl font-bold text-white">{t("tv_copier.onesignal_h2")}</h2>
        <p class="text-gray-300">{t("tv_copier.onesignal_p1")}</p>
        <p class="text-gray-300">{t("tv_copier.onesignal_p2")}</p>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mt-8 not-prose">
          {oneSignalCards.map((c) => (
            <div class="bg-blue-900/20 border border-blue-500/30 rounded-xl p-5">
              <i class={`fa-solid ${c.icon} text-blue-400 mb-2 text-lg`} aria-hidden="true"></i>
              <h3 class="font-bold text-white text-base mb-1">{t(`tv_copier.${c.key}_title` as any)}</h3>
              <p class="text-xs sm:text-sm text-gray-400 leading-relaxed">{t(`tv_copier.${c.key}_text` as any)}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Two modes -->
    <section class="py-16 lg:py-20 border-b border-blue-900/30">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
          <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">{t("tv_copier.modes_h2")}</h2>
          <p class="text-gray-400 max-w-2xl mx-auto">{t("tv_copier.modes_subtitle")}</p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="bg-gradient-to-br from-blue-900/20 to-blue-900/5 border border-blue-500/30 rounded-xl p-6">
            <div class="w-12 h-12 bg-blue-500/20 rounded-lg flex items-center justify-center mb-4">
              <i class="fa-solid fa-hand-pointer text-blue-400 text-xl" aria-hidden="true"></i>
            </div>
            <h3 class="text-lg font-bold text-white mb-2">{t("tv_copier.mode_1_title")}</h3>
            <p class="text-sm text-gray-300 leading-relaxed">{t("tv_copier.mode_1_text")}</p>
          </div>
          <div class="bg-gradient-to-br from-blue-900/20 to-blue-900/5 border border-blue-500/30 rounded-xl p-6">
            <div class="w-12 h-12 bg-blue-500/20 rounded-lg flex items-center justify-center mb-4">
              <i class="fa-solid fa-robot text-blue-400 text-xl" aria-hidden="true"></i>
            </div>
            <h3 class="text-lg font-bold text-white mb-2">{t("tv_copier.mode_2_title")}</h3>
            <p class="text-sm text-gray-300 leading-relaxed">{t("tv_copier.mode_2_text")}</p>
          </div>
        </div>
        <p class="mt-8 text-center text-sm text-gray-400 max-w-3xl mx-auto">{t("tv_copier.modes_footnote")}</p>
      </div>
    </section>

    <!-- Prop firm -->
    <section class="py-16 border-b border-blue-900/30 bg-gradient-to-b from-[#001429] to-[#002040]">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 prose-section">
        <h2 class="text-3xl font-bold text-white">{t("tv_copier.propfirm_h2")}</h2>
        <p class="text-gray-300">{t("tv_copier.propfirm_p1")}</p>
        <p class="text-gray-300">{t("tv_copier.propfirm_p2")}</p>
        <a href={localizedPath(locale, "use-cases/multi-account-traders")} class="inline-flex items-center gap-2 text-sm font-semibold text-blue-400 hover:text-white transition">
          {t("tv_copier.propfirm_link")} <i class="fa-solid fa-arrow-right text-xs" aria-hidden="true"></i>
        </a>
      </div>
    </section>

    <!-- Multi-user -->
    <section class="py-16 border-b border-blue-900/30">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 prose-section">
        <span class="inline-block px-4 py-2 bg-purple-600/20 text-purple-400 rounded-full text-sm font-semibold mb-6 border border-purple-500/30 uppercase electrolize-regular">
          <i class="fa-solid fa-user-group mr-1.5" aria-hidden="true"></i> Multi-User
        </span>
        <h2 class="text-3xl font-bold text-white">{t("tv_copier.multiuser_h2")}</h2>
        <p class="text-gray-300">{t("tv_copier.multiuser_p1")}</p>
        <p class="text-gray-300">{t("tv_copier.multiuser_p2")}</p>
        <p class="text-gray-300">{t("tv_copier.multiuser_p3")}</p>
      </div>
    </section>

    <!-- Brokers grid -->
    <section id="brokers" class="py-16 lg:py-20 border-b border-blue-900/30 bg-gradient-to-b from-[#001429] to-[#002040]">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12 max-w-3xl mx-auto">
          <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">{t("tv_copier.brokers_h2")}</h2>
          <p class="text-gray-400">{t("tv_copier.brokers_subtitle")}</p>
        </div>
        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-4">
          {brokers.map((b) => (
            <a
              href={b.internal ? localizedPath(locale, b.href) : b.href}
              target={b.internal ? undefined : "_blank"}
              rel={b.internal ? undefined : "noopener noreferrer"}
              class={`group rounded-xl p-4 transition-all hover:-translate-y-1 ${b.internal ? "bg-blue-600/20 border border-blue-500/60" : "bg-blue-900/20 border border-blue-500/30 hover:border-blue-500/60"}`}
            >
              <h3 class="font-bold text-white text-sm sm:text-base mb-1">{t(`tv_copier.broker_${b.n}_name` as any)}</h3>
              <p class="text-xs text-gray-400">{t(`tv_copier.broker_${b.n}_text` as any)}</p>
            </a>
          ))}
        </div>
        <p class="text-gray-500 text-xs mt-6 text-center max-w-3xl mx-auto">{t("tv_copier.brokers_footnote")}</p>
      </div>
    </section>

    <!-- Multi-asset -->
    <section class="py-16 border-b border-blue-900/30">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-3xl font-bold text-white mb-4">{t("tv_copier.multiasset_h2")}</h2>
        <p class="text-gray-300 leading-relaxed mb-8">{t("tv_copier.multiasset_p1")}</p>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          {assetCards.map((a) => (
            <div class={`${a.wrap} rounded-xl p-5`}>
              <div class={`w-10 h-10 ${a.iconBg} rounded-lg flex items-center justify-center mb-3`}>
                <i class={`${a.brand ? "fa-brands" : "fa-solid"} ${a.icon} ${a.iconText}`} aria-hidden="true"></i>
              </div>
              <h3 class="font-bold text-white text-base mb-1">{t(`tv_copier.${a.key}_title` as any)}</h3>
              <p class="text-xs sm:text-sm text-gray-400 leading-relaxed">{t(`tv_copier.${a.key}_text` as any)}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Per-account sizing -->
    <section class="py-16 border-b border-blue-900/30 bg-gradient-to-b from-[#001429] to-[#002040]">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 prose-section">
        <h2 class="text-3xl font-bold text-white">{t("tv_copier.sizing_h2")}</h2>
        <p class="text-gray-300">{t("tv_copier.sizing_p1")}</p>
        <p class="text-gray-300">{t("tv_copier.sizing_p2")}</p>
      </div>
    </section>

    <!-- How it works (3 stage) -->
    <section id="how-it-works" class="py-16 lg:py-20 border-b border-blue-900/30 scroll-mt-20">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12 max-w-2xl mx-auto">
          <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">{t("tv_copier.howitworks_h2")}</h2>
          <p class="text-gray-400">{t("tv_copier.howitworks_subtitle")}</p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {[1, 2, 3].map((n) => (
            <div class="bg-gradient-to-br from-blue-900/20 to-blue-900/5 border border-blue-500/30 rounded-xl p-6">
              <div class="text-blue-400 text-sm font-bold mb-2 electrolize-regular uppercase">{t(`tv_copier.stage_${n}_label` as any)}</div>
              <h3 class="text-lg font-bold text-white mb-2">{t(`tv_copier.stage_${n}_title` as any)}</h3>
              <p class="text-sm text-gray-300 leading-relaxed">{t(`tv_copier.stage_${n}_text` as any)}</p>
            </div>
          ))}
        </div>
        <p class="mt-8 text-center text-sm text-gray-400 max-w-3xl mx-auto">
          {t("tv_copier.howitworks_footer_pre")} <a href={localizedPath(locale, "tradingview-to-tradovate")} class="text-blue-400 hover:text-blue-300 underline">{t("tv_copier.howitworks_footer_link")}</a>{t("tv_copier.howitworks_footer_post")}
        </p>
      </div>
    </section>

    <!-- vs alternatives -->
    <section class="py-16 border-b border-blue-900/30">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 prose-section">
        <h2 class="text-3xl font-bold text-white">{t("tv_copier.vsalt_h2")}</h2>
        <p class="text-gray-300">{t("tv_copier.vsalt_p1")}</p>
        <p class="text-gray-300">{t("tv_copier.vsalt_p2")}</p>
        <p class="text-gray-300">
          {t("tv_copier.vsalt_p3_pre")} <a href={localizedPath(locale, "compare/pickmytrade-vs-traderspost")} class="text-blue-400 hover:text-blue-300 underline">{t("tv_copier.vsalt_p3_link")}</a>{t("tv_copier.vsalt_p3_end")}
        </p>
      </div>
    </section>

    <!-- Pricing -->
    <section id="pricing" class="py-16 lg:py-20 border-b border-blue-900/30 bg-gradient-to-b from-[#001429] to-[#002040] scroll-mt-20">
      <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">{t("tv_copier.pricing_h2")}</h2>
        <p class="text-gray-300 leading-relaxed mb-6 max-w-2xl mx-auto">{t("tv_copier.pricing_p1")}</p>
        <div class="flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-sm text-gray-200 mb-8">
          <span class="flex items-center gap-2"><i class="fa-solid fa-check text-blue-400" aria-hidden="true"></i> {t("tv_copier.pricing_check1")}</span>
          <span class="flex items-center gap-2"><i class="fa-solid fa-check text-blue-400" aria-hidden="true"></i> {t("tv_copier.pricing_check2")}</span>
          <span class="flex items-center gap-2"><i class="fa-solid fa-check text-blue-400" aria-hidden="true"></i> {t("tv_copier.pricing_check3")}</span>
        </div>
        <a href="https://app.pickmytrade.trade/?register=true"
          class="inline-flex items-center px-8 py-3.5 rounded-lg text-sm font-semibold text-white bg-gradient-to-r from-blue-600 to-blue-700 hover:from-blue-700 hover:to-blue-800 transition-all duration-300 shadow-lg hover:shadow-blue-500/50 electrolize-regular">
          {t("tv_copier.pricing_cta")} <i class="fa-solid fa-arrow-right ml-2" aria-hidden="true"></i>
        </a>
        <p class="mt-3 text-xs text-gray-400">{t("tv_copier.pricing_footer_pre")} <a href={localizedPath(locale, "pages/pricing")} class="text-blue-400 hover:text-blue-300 underline">{t("tv_copier.pricing_footer_link")}</a>.</p>
      </div>
    </section>

    <!-- Proof / stats -->
    <section class="py-16 border-b border-blue-900/30">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-9">
          <h2 class="text-3xl font-bold text-white mb-3">{t("tv_copier.proof_h2")}</h2>
          <p class="text-gray-400 max-w-2xl mx-auto">{t("tv_copier.proof_subtitle")}</p>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          {stats.map((n) => (
            <div class="bg-blue-900/20 border border-blue-500/30 rounded-xl p-5 text-center">
              <div class="text-2xl font-bold text-white">{t(`tv_copier.stat_${n}_value` as any)}</div>
              <div class="text-xs text-gray-400 mt-1">{t(`tv_copier.stat_${n}_label` as any)}</div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section id="faq" class="py-16 border-b border-blue-900/30 bg-gradient-to-b from-[#001429] to-[#002040]">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
          <span class="inline-block px-4 py-2 bg-blue-600/20 text-blue-400 rounded-full text-sm font-semibold mb-4 border border-blue-500/30 uppercase electrolize-regular">
            FAQ
          </span>
          <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">{t("tv_copier.faq_h2")}</h2>
          <p class="text-gray-400">{t("tv_copier.faq_subtitle")}</p>
        </div>

        <div class="faq-content space-y-4">
          {Array.from({ length: 14 }, (_, i) => i + 1).map((n) => (
            <FaqItem question={t(`tv_copier.faq_${n}_q` as any)}>
              <p>{t(`tv_copier.faq_${n}_a` as any)}</p>
            </FaqItem>
          ))}
        </div>
      </div>
    </section>

    <!-- Final CTA -->
    <section class="py-16">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <div class="bg-gradient-to-r from-blue-600/20 to-purple-600/20 rounded-3xl p-12 border border-blue-500/30">
          <h2 class="text-3xl font-bold mb-4 text-white">{t("tv_copier.cta_h2")}</h2>
          <p class="text-gray-300 mb-8 max-w-2xl mx-auto">{t("tv_copier.cta_text")}</p>
          <div class="flex flex-col sm:flex-row justify-center gap-4">
            <a href="https://app.pickmytrade.trade/?register=true"
              class="inline-flex items-center justify-center gap-2 px-8 py-4 bg-gradient-to-r from-blue-600 to-blue-700 hover:from-blue-700 hover:to-blue-800 text-white rounded-xl font-bold transition-all transform hover:scale-105 shadow-xl">
              <i class="fas fa-rocket"></i> {t("tv_copier.cta_primary")}
            </a>
            <a href="https://docs.pickmytrade.trade/docs/"
              class="inline-flex items-center justify-center gap-2 px-8 py-4 bg-white/10 hover:bg-white/20 text-white rounded-xl font-bold border border-white/20 transition-all">
              <i class="fas fa-book"></i> {t("tv_copier.cta_docs")}
            </a>
          </div>
        </div>

        <div class="mt-12 pt-8 border-t border-white/10">
          <p class="text-xs uppercase tracking-widest text-gray-400 mb-4 electrolize-regular">{t("tv_copier.related_label")}</p>
          <div class="flex flex-wrap items-center justify-center gap-x-5 gap-y-2 text-sm">
