---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import "../../../styles/compare-editorial.css";
import CompareSpy from "../../../components/CompareSpy.astro";
import { getLocalePaths } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import Localize from "../../../components/Localize.astro";
import { makeTr, localizeLd } from "../../../i18n/compare-i18n.mjs";
import AuthorByline from "../../../components/AuthorByline.astro";

// Compare pages are translated (de/es/fr/it): text is swapped in by <Localize> from src/i18n/compare/<locale>.json.
export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };
const tr = makeTr(locale);
const title = tr("PickMyTrade vs TradersPost 2026: Price Per Live Account");
const description = tr("TradersPost charges per live account and per asset class. PickMyTrade is $50 with unlimited accounts under one broker login. Compared, checked Sept 2026.");
const lastUpdated = "2026-09-23";

const faqsEn = [
  {
    "question": "Is TradersPost cheaper than PickMyTrade?",
    "answer": "For one live account in one asset class, yes, by a dollar a month: Starter is $49 against our $50, and billed yearly the two are twenty cents apart. The gap opens at the second account, because TradersPost charges $10 a month for each extra live account and we do not charge for extra accounts under the same broker login."
  },
  {
    "question": "How many accounts does one PickMyTrade subscription cover?",
    "answer": "One subscription covers unlimited accounts under one broker login. Five Apex accounts under a single Tradovate login all automate on one $50 subscription. If your accounts sit under separate broker logins, each login needs its own subscription, so count your logins before you compare totals."
  },
  {
    "question": "Can I automate a live account during the TradersPost free trial?",
    "answer": "No. Its trial automates paper accounts only: on a live account you submit each order by hand until you pay, and its FAQ says the account is disabled when the trial ends, checked 22 September 2026. Ours takes no credit card and gives full access, so you can watch a live order first."
  },
  {
    "question": "Does TradersPost copy trades between accounts?",
    "answer": "It routes one signal to the accounts you select, which it calls parallel account execution and includes on paid plans. It is not a broker-level copier: its own blog says it does not offer copying that listens for broker-level trades. PickMyTrade has both, including a Tradovate admin account whose trades copy to followers with quantity multipliers."
  },
  {
    "question": "Does PickMyTrade have daily loss limits?",
    "answer": "Yes. Daily and weekly profit and loss limits on each connected account, the hours automation is allowed to trade, and a pause switch. They are settings you configure, not a guarantee, so match them to your firm's rules. No daily or weekly loss limit was found in TradersPost's pricing page, strategy field reference or Command Pad docs on 22 September 2026."
  },
  {
    "question": "Can I use PickMyTrade with prop firm accounts?",
    "answer": "Yes, on the platforms it supports — any prop firm that offers Tradovate, Rithmic or ProjectX accounts, including TopstepX. Firms set their own rules on automation and copy trading, and those rules change, so read yours before you go live. TradersPost publishes a per-firm policy table worth reading whichever tool you pick."
  }
];
const faqs = faqsEn.map((f) => ({ question: tr(f.question), answer: tr(f.answer) }));

const ld = [
  { "@context": "https://schema.org", ...{
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "PickMyTrade",
      "item": "https://pickmytrade.trade/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Compare",
      "item": "https://pickmytrade.trade/compare/"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": "PickMyTrade vs TradersPost",
      "item": "https://pickmytrade.trade/compare/pickmytrade-vs-traderspost/"
    }
  ]
} },
  { "@context": "https://schema.org", ...{
  "@type": "WebPage",
  "@id": "https://pickmytrade.trade/compare/pickmytrade-vs-traderspost/#webpage",
  "url": "https://pickmytrade.trade/compare/pickmytrade-vs-traderspost/",
  "name": "PickMyTrade vs TradersPost",
  "datePublished": "2026-09-23",
  "dateModified": "2026-09-23",
  "publisher": {
    "@id": "https://pickmytrade.trade/#organization"
  }
} },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "@id": "https://pickmytrade.trade/compare/pickmytrade-vs-traderspost/#faq",
    mainEntity: faqs.map((f) => ({
      "@type": "Question",
      name: f.question,
      acceptedAnswer: { "@type": "Answer", text: f.answer },
    })),
  },
];
const ldLocalized = localizeLd(ld, locale, tr);
---
<BaseLayout locale={locale} title={title} description={description} ldJson={ldLocalized}>
<Localize locale={locale}>
<div class="ed">
<header class="hero">
<div class="wrap">
<nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">›</span><a href="/compare/">Compare</a><span aria-hidden="true">›</span><span aria-current="page">PickMyTrade vs TradersPost</span></nav>
<div class="hero-grid">
<div class="hero-copy">
<p class="eyebrow">Head-to-head comparison · 2026</p>
<div class="byline" data-i18n-skip="true"><AuthorByline locale={locale} lastUpdated={lastUpdated} /></div>
<h1>PickMyTrade vs TradersPost</h1>
<p class="lede">{description}</p>

<div class="actions"><a class="btn btn-primary" href="https://app.pickmytrade.trade/?register=true">Start free trial</a><a class="btn btn-quiet" href="#side-by-side">Skip to the comparison table <span aria-hidden="true">→</span></a></div>
</div>
<div class="hero-visual"><div class="vs" role="group" aria-label="PickMyTrade compared with TradersPost"><div class="vs-row"><div class="vs-side vs-own"><div class="vs-mark" aria-hidden="true">P</div><div class="vs-name">PickMyTrade</div><div class="vs-note">$50/month · one plan</div></div><div class="vs-mid"><span>vs</span></div><div class="vs-side"><div class="vs-mark" aria-hidden="true">T</div><div class="vs-name">TradersPost</div><div class="vs-note">Compared on its own published pages</div></div></div></div></div>
</div>
<ul class="standards in-hero">
<li><i class="fa-solid fa-check" aria-hidden="true"></i><span>50,000+ traders served</span></li>
<li><i class="fa-solid fa-check" aria-hidden="true"></i><span>7-day free trial, no credit card</span></li>
<li><i class="fa-solid fa-check" aria-hidden="true"></i><span>Runs in the cloud — your computer can be off</span></li>
<li><i class="fa-solid fa-check" aria-hidden="true"></i><span>Tradovate connects by OAuth, with no API fee</span></li>
</ul>
</div>
</header>

<nav class="secnav" aria-label="On this page">
<div class="wrap secnav-inner">
<ul>
<li><a href="#the-price-matched-like-for-like" data-target="the-price-matched-like-for-like">Price</a></li>
<li><a href="#side-by-side" data-target="side-by-side">Side by side</a></li>
<li><a href="#why-traders-choose-pickmytrade" data-target="why-traders-choose-pickmytrade">Why PickMyTrade</a></li>
<li><a href="#moving-from-traderspost" data-target="moving-from-traderspost">Switching</a></li>
<li><a href="#frequently-asked-questions" data-target="frequently-asked-questions">FAQ</a></li>
</ul>
<a class="btn btn-primary btn-sm" href="https://app.pickmytrade.trade/?register=true">Start free trial</a>
</div>
</nav>

<section id="the-price-matched-like-for-like" class="sec">
<div class="wrap">
<div class="head">
<p class="eyebrow">Price</p>
<h2>The price, matched like for like</h2>
</div>
<div class="stats3">
<div class="stat"><span class="v">$50</span><span class="l">per month, one plan</span></div>
<div class="stat"><span class="v">$500</span><span class="l">per year</span></div>
<div class="stat"><span class="v">7 days</span><span class="l">free trial, no card</span></div>
</div>
        <p class="prose">TradersPost opens its comparison with <span class="pr">$49</span> against our <span class="pr">$50</span> and stops there. That Starter plan buys one live account and one asset class. Each extra live account is <span class="pr">$10</span> a month, and a second asset class moves you to Basic at <span class="pr">$99</span>. The deciding number is not the plan price but your live-account and asset-class count.</p>
        <div class="table-scroll" tabindex="0" role="region" aria-label="Comparison table">
<table>
<caption>Monthly list prices as published by each company. TradersPost checked 22 September 2026.</caption>
<thead><tr><th scope="col">What you actually run</th><th scope="col">TradersPost</th><th scope="col" class="own">PickMyTrade</th></tr></thead>
<tbody>
<tr><th scope="row">1 live account, futures only</th><td>Starter, <span class="pr">$49</span> (<span class="pr">$499.80</span> billed yearly)</td><td class="own"><span class="pr">$50</span> (<span class="pr">$500</span> billed yearly)</td></tr>
<tr><th scope="row">5 live futures accounts under one broker login</th><td>Starter plus 4 live add-ons at <span class="pr">$10</span> each = <span class="pr">$89</span></td><td class="own"><span class="pr">$50</span></td></tr>
<tr><th scope="row">Futures on one broker, stocks on another</th><td>Basic, <span class="pr">$99</span> (2 asset classes)</td><td class="own"><span class="pr">$100</span> — two broker logins, one subscription each</td></tr>
<tr><th scope="row">Futures on one broker, stocks and options on another</th><td>Pro, <span class="pr">$199</span> (3 asset classes)</td><td class="own"><span class="pr">$100</span> — two broker logins</td></tr>
</tbody>
</table>
</div>
        <p class="prose">At one live account TradersPost is genuinely a dollar cheaper, and billed yearly the two are twenty cents apart. That anchor is honest, and it holds right up to the second account.</p>
        <p class="prose">Our billing unit is the broker login. One Tradovate login holding five Apex accounts automates all five on a single <span class="pr">$50</span> subscription, however many you add. A different broker is a different login, so Tradovate plus TradeStation is two subscriptions — which is why TradersPost Basic at <span class="pr">$99</span> beats our <span class="pr">$100</span> on futures plus stocks. Count your logins before you compare totals; that is where our math stops helping you.</p>
        <p class="prose"><strong>Before you start either trial.</strong> The TradersPost trial automates paper accounts only: on a live account you submit every order by hand until you pay, and its FAQ says the account is disabled when the trial ends. Ours takes no credit card and gives full access. Its comparison page also lists our trial as five days; it is seven, checked 22 September 2026. The same page says PickMyTrade caps webhooks at 1,000 signals a month. We have no webhook, alert or signal cap, on any plan.</p>
        <p class="prose"><a href="/pages/pricing/">PickMyTrade pricing</a> · <a href="https://traderspost.io/pricing" target="_blank" rel="noopener noreferrer">TradersPost pricing</a></p>
</div>
</section>

<section id="side-by-side" class="sec band">
<div class="wrap">
<div class="head">
<p class="eyebrow">Side by side</p>
<h2>Side by side</h2>
</div>
<div class="table-scroll" tabindex="0" role="region" aria-label="Comparison table">
<table>
<caption>What each product does, from each company's own pages. TradersPost checked 22 September 2026.</caption>
<thead><tr><th scope="col">Decision</th><th scope="col" class="own">PickMyTrade</th><th scope="col">TradersPost</th></tr></thead>
<tbody>
<tr><th scope="row">Billing unit</th><td class="own"><span class="pr">$50</span> a month, unlimited accounts under one broker login; a second login, including a second broker, needs its own subscription at the same price. <a href="/pages/pricing/">Pricing</a></td><td>Tiered plan, plus <span class="pr">$10</span> a month per extra live account and <span class="pr">$5</span> per paper account, plus asset-class gates. <a href="https://traderspost.io/pricing" target="_blank" rel="noopener noreferrer">Source</a></td></tr>
<tr><th scope="row">Brokers</th><td class="own">Tradovate, Rithmic, ProjectX, Interactive Brokers, TradeStation, Tradier, TradeLocker, Match-Trader. <a href="https://pickmytrade.io/broker/">Broker guides</a></td><td>16 brokers plus its own paper broker, including Alpaca, Robinhood and crypto venues. No Rithmic, TradeLocker or Match-Trader, not even on its wait list. <a href="https://traderspost.io/connections" target="_blank" rel="noopener noreferrer">Source</a></td></tr>
<tr><th scope="row">Markets</th><td class="own">Futures; stocks and options (Interactive Brokers, TradeStation, Tradier, single-leg on Tradier); forex and CFDs (TradeLocker, Match-Trader)</td><td>Stocks, options including index options, futures, crypto. Its IBKR route is beta and stocks only; forex is "coming soon". <a href="https://traderspost.io/connections" target="_blank" rel="noopener noreferrer">Source</a></td></tr>
<tr><th scope="row">Trade copier</th><td class="own">A Tradovate admin account's trades copy to followers, each with a quantity multiplier. <a href="https://docs.pickmytrade.trade/docs/tradingview-to-tradovate-trade-copier/" target="_blank" rel="noopener noreferrer">Guide</a></td><td>No broker-level copier. Its blog states it does not offer trade copying that listens for broker-level trades</td></tr>
<tr><th scope="row">One signal to several accounts</th><td class="own">Included, with per-account sizing. <a href="https://docs.pickmytrade.trade/docs/place-trades-in-multiple-accounts/" target="_blank" rel="noopener noreferrer">Guide</a></td><td>Parallel account execution on paid plans, within the plan's account allowance. <a href="https://traderspost.io/pricing" target="_blank" rel="noopener noreferrer">Source</a></td></tr>
<tr><th scope="row">Daily and weekly loss limits</th><td class="own">Per account, plus trading-time windows and a pause switch. <a href="https://docs.pickmytrade.trade/docs/trading-risk-settings/" target="_blank" rel="noopener noreferrer">Guide</a></td><td>None found in its pricing page, strategy field reference or Command Pad docs on 22 September 2026; its session limits cover manual trading</td></tr>
<tr><th scope="row">Changing a stop after entry</th><td class="own">Update the stop or target on an open position, breakeven with an offset, partial close, reverse. <a href="https://docs.pickmytrade.trade/docs/breakeven-offset-tradovate-automation-pickmytrade/" target="_blank" rel="noopener noreferrer">Breakeven</a></td><td>Its FAQ says you cannot update stop losses held at the broker that were set at entry</td></tr>
<tr><th scope="row">ProjectX brackets</th><td class="own">Brackets via Auto OCO on ProjectX, including TopstepX</td><td>Its docs say ProjectX prop-firm accounts do not currently support bracket orders through TradersPost</td></tr>
<tr><th scope="row">Where it runs</th><td class="own">Cloud, except Interactive Brokers: TWS or IB Gateway and the PickMyTrade IB application must stay running. <a href="https://docs.pickmytrade.io/docs/interactive-brokers-trading-setup/" target="_blank" rel="noopener noreferrer">IBKR setup</a></td><td>Hosted. No VPS, no Tradovate API purchase</td></tr>
<tr><th scope="row">Free trial</th><td class="own">7 days, no credit card, full access including live accounts</td><td>7 days. Live accounts are manual-submit only; automation runs on paper accounts. <a href="https://traderspost.io/pricing" target="_blank" rel="noopener noreferrer">Source</a></td></tr>
<tr><th scope="row">Journal and published API</th><td class="own">Neither offered</td><td>Neither offered. Its API page is a wait list. <a href="https://traderspost.io/api" target="_blank" rel="noopener noreferrer">Source</a></td></tr>
</tbody>
</table>
</div>
        <p class="prose">Four cells in TradersPost's own comparison are wrong about us, checked 22 September 2026: the trial is 7 days, not 5; trailing stops work on Tradovate and ProjectX; brackets do attach a stop and a target at entry; and our asset classes are given as futures and stocks, which drops options, forex and CFDs.</p>
</div>
</section>

<section id="why-traders-choose-pickmytrade" class="sec">
<div class="wrap">
<div class="head">
<p class="eyebrow">Why PickMyTrade</p>
<h2>Why traders choose PickMyTrade</h2>
</div>
<div class="cards">
<article class="card"><h3>Accounts under one login cost nothing extra</h3><p>Every account under the same broker login runs on one <span class="pr">$50</span> subscription, each with its own size. A second broker login is a second subscription at the same <span class="pr">$50,</span> with the same features — there is no higher tier to climb to. <a href="https://docs.pickmytrade.trade/docs/place-trades-in-multiple-accounts/" target="_blank" rel="noopener noreferrer">Multi-account setup</a>.</p></article>
<article class="card"><h3>The copier and the loss limits are not an upgrade</h3><p>Trade on a Tradovate admin account and every follower copies it with its own quantity multiplier. Set daily and weekly profit and loss limits per account, and the hours automation may trade. Both are in the same <span class="pr">$50</span>. <a href="https://docs.pickmytrade.trade/docs/tradingview-to-tradovate-trade-copier/" target="_blank" rel="noopener noreferrer">Copier</a> · <a href="https://docs.pickmytrade.trade/docs/trading-risk-settings/" target="_blank" rel="noopener noreferrer">Risk settings</a>.</p></article>
<article class="card"><h3>The alert manages the trade, not just the entry</h3><p>Stop loss and take profit by points, percentage, price, ticks or total P/L. Brackets and OCO, trailing stops on Tradovate and ProjectX, breakeven with an offset, changes to an open position, partial closes, reversals. <a href="https://docs.pickmytrade.trade/docs/tradingview-json-alert-configuration/" target="_blank" rel="noopener noreferrer">Alert setup</a> · <a href="https://docs.pickmytrade.trade/docs/configure-trailing-stop-loss/" target="_blank" rel="noopener noreferrer">Trailing stop</a>.</p></article>
<article class="card"><h3>Three routes TradersPost does not have</h3><p>Rithmic, TradeLocker and Match-Trader are not on its connections page or its wait list. That covers Rithmic prop accounts, and forex and CFDs today rather than "coming soon". <a href="https://pickmytrade.io/broker/">Guides</a>.</p></article>
<article class="card"><h3>A trial that places live orders</h3><p>Seven days, no credit card, full access. Connect a live account and watch a real order fill before you decide, which is the one thing a paper account cannot tell you.</p></article>
</div>
</div>
</section>

<section id="moving-from-traderspost" class="sec">
<div class="wrap">
<div class="head">
<p class="eyebrow">Switching</p>
<h2>Moving from TradersPost</h2>
</div>
<div class="measure">
<ol class="steps">
<li><span class="n">1</span><p><strong>Start the trial and connect one broker.</strong> Tradovate signs in with OAuth; the other seven have setup guides.</p></li>
<li><span class="n">2</span><p><strong>Rebuild the alert message.</strong> Generate the PickMyTrade JSON and paste it into your TradingView alert with our webhook URL. TradersPost payloads and field names do not carry across.</p></li>
<li><span class="n">3</span><p><strong>Set accounts, sizing, exits and limits.</strong> Pick which accounts get the alert and at what size, set the stop and target, then the daily and weekly limits and the trading hours.</p></li>
<li><span class="n">4</span><p><strong>Test on a demo account, then switch one at a time.</strong> Check the order at your broker, and disconnect that account from TradersPost before going live, so only one tool sends it orders.</p></li>
</ol>
</div>
</div>
</section>

<section id="frequently-asked-questions" class="sec band">
<div class="wrap">
<div class="faq-wrap">
<p class="eyebrow">FAQ</p>
<h2>Frequently asked questions</h2>
<div class="faq">
{faqs.map((f) => (
<details>
<summary><span>{f.question}</span><i aria-hidden="true"></i></summary>
<div class="ans"><p>{f.answer}</p></div>
</details>
))}
</div>
</div>
</div>
</section>

<section id="sources" class="sec sec-quiet" aria-label="Sources and disclosure">
<div class="wrap">
<div class="measure">
<p class="eyebrow">Sources</p>
<h2 class="h-sm">Sources and disclosure</h2>
<p class="src-p">Prepared by PickMyTrade. TradersPost details come from its own pages, checked 22 September 2026: <a href="https://traderspost.io/pricing" target="_blank" rel="noopener noreferrer">pricing</a>, <a href="https://traderspost.io/connections" target="_blank" rel="noopener noreferrer">connections</a>, <a href="https://traderspost.io/compare/traderspost-vs-pickmytrade" target="_blank" rel="noopener noreferrer">its PickMyTrade comparison</a> and <a href="https://traderspost.io/api" target="_blank" rel="noopener noreferrer">its API page</a>, plus its blog and docs. Prices change; check both sites first. <a href="/compare/">All comparisons</a>.</p>
<p class="src-p risk"><strong>Risk disclosure.</strong> Trading futures involves substantial risk of loss and is not suitable for every investor. Past performance is not indicative of future results. The content on this page is for educational and informational purposes only and does not constitute financial, investment, or trading advice. Only trade with capital you can afford to lose.</p>
</div>
</div>
</section>

<section class="cta-sec">
<div class="wrap">
<div class="cta">
<div>
<h2 class="h-sm">Ready to get started?</h2>
<p>Connect your broker and run your own alert on a 7-day free trial. No credit card.</p>
</div>
<div class="cta-actions">
<a class="btn btn-primary" href="https://app.pickmytrade.trade/?register=true">Start your 7-day free trial <span aria-hidden="true">→</span></a>
<a class="btn btn-quiet" href="/pages/pricing/">See pricing <span aria-hidden="true">→</span></a>
</div>
</div>
</div>
</section>
</div>
</Localize>

<CompareSpy />
</BaseLayout>
