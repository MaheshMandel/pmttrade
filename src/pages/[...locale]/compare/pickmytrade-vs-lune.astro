---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import "../../../styles/compare-editorial.css";
import CompareSpy from "../../../components/CompareSpy.astro";
import { getLocalePaths } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import Localize from "../../../components/Localize.astro";
import { makeTr, localizeLd } from "../../../i18n/compare-i18n.mjs";
import AuthorByline from "../../../components/AuthorByline.astro";

// Compare pages are translated (de/es/fr/it): text is swapped in by <Localize> from src/i18n/compare/<locale>.json.
export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };
const tr = makeTr(locale);
const title = tr("PickMyTrade vs Lune (2026): Price, Brokers, Trade Copier");
const description = tr("Lune sells automation and copying as two products. PickMyTrade includes both at $50. Compare brokers, markets, risk limits and a 7-day trial, no card.");
const lastUpdated = "2026-09-23";

const faqsEn = [
  {
    "question": "Is PickMyTrade more expensive than Lune?",
    "answer": "It depends on how many jobs you need. Lune's Auto Trader is $49 against our $50, so for alerts alone Lune is a dollar cheaper. Add copying and Lune becomes two products at about $75 a month after its two-product discount, while PickMyTrade stays at $50 with both included. Prices checked 22 September 2026."
  },
  {
    "question": "Do I need a Tradovate API token to use PickMyTrade?",
    "answer": "No. PickMyTrade connects to Tradovate with OAuth. There is no separate Tradovate API subscription and no token to generate. Lune's review of PickMyTrade says otherwise; that step is not part of our setup, and you should not buy anything at Tradovate before connecting."
  },
  {
    "question": "Does the PickMyTrade trial need a credit card?",
    "answer": "No. The trial is 7 days with full access and no credit card. Lune's trial is also seven days, but its own pages state that a card is required and that it is charged when the trial ends."
  },
  {
    "question": "How many brokers does PickMyTrade connect to?",
    "answer": "Eight: Tradovate, Rithmic, ProjectX including TopstepX, Interactive Brokers, TradeStation, Tradier, TradeLocker and Match-Trader. Futures run on the first three, stocks and options on Interactive Brokers, TradeStation and Tradier, and forex and CFDs on TradeLocker and Match-Trader."
  },
  {
    "question": "How many accounts does one PickMyTrade subscription cover?",
    "answer": "One subscription covers unlimited accounts under one broker login. Five Apex accounts under a single Tradovate login all automate on one $50 subscription. If your accounts sit under separate broker logins, each login needs its own subscription, and that is the case where Lune's connection tier can work out cheaper."
  },
  {
    "question": "Can PickMyTrade copy trades between different platforms?",
    "answer": "No. Our copier runs from a Tradovate admin account to Tradovate follower accounts, with a quantity multiplier per account. If you need a leader on one futures platform driving followers on another, Lune's copier does that and ours does not."
  },
  {
    "question": "Can I use PickMyTrade with prop firm accounts?",
    "answer": "Yes, on the platforms it supports — any prop firm that offers Tradovate, Rithmic or ProjectX accounts, including TopstepX. Firms set their own rules on automation and copy trading, so check yours before going live. Neither tool can enforce a firm's rules for you, and Lune's own risk documentation says the same."
  }
];
const faqs = faqsEn.map((f) => ({ question: tr(f.question), answer: tr(f.answer) }));

const ld = [
  { "@context": "https://schema.org", ...{
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "PickMyTrade",
      "item": "https://pickmytrade.trade/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Compare",
      "item": "https://pickmytrade.trade/compare/"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": "PickMyTrade vs Lune",
      "item": "https://pickmytrade.trade/compare/pickmytrade-vs-lune/"
    }
  ]
} },
  { "@context": "https://schema.org", ...{
  "@type": "WebPage",
  "@id": "https://pickmytrade.trade/compare/pickmytrade-vs-lune/#webpage",
  "url": "https://pickmytrade.trade/compare/pickmytrade-vs-lune/",
  "name": "PickMyTrade vs Lune",
  "datePublished": "2026-09-23",
  "dateModified": "2026-09-23",
  "publisher": {
    "@id": "https://pickmytrade.trade/#organization"
  }
} },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "@id": "https://pickmytrade.trade/compare/pickmytrade-vs-lune/#faq",
    mainEntity: faqs.map((f) => ({
      "@type": "Question",
      name: f.question,
      acceptedAnswer: { "@type": "Answer", text: f.answer },
    })),
  },
];
const ldLocalized = localizeLd(ld, locale, tr);
---
<BaseLayout locale={locale} title={title} description={description} ldJson={ldLocalized}>
<Localize locale={locale}>
<div class="ed">
<header class="hero">
<div class="wrap">
<nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">›</span><a href="/compare/">Compare</a><span aria-hidden="true">›</span><span aria-current="page">PickMyTrade vs Lune</span></nav>
<div class="hero-grid">
<div class="hero-copy">
<p class="eyebrow">Head-to-head comparison · 2026</p>
<div class="byline" data-i18n-skip="true"><AuthorByline locale={locale} lastUpdated={lastUpdated} /></div>
<h1>PickMyTrade vs Lune</h1>
<p class="lede">{description}</p>

<div class="actions"><a class="btn btn-primary" href="https://app.pickmytrade.trade/?register=true">Start free trial</a><a class="btn btn-quiet" href="#side-by-side">Skip to the comparison table <span aria-hidden="true">→</span></a></div>
</div>
<div class="hero-visual"><div class="vs" role="group" aria-label="PickMyTrade compared with Lune"><div class="vs-row"><div class="vs-side vs-own"><div class="vs-mark" aria-hidden="true">P</div><div class="vs-name">PickMyTrade</div><div class="vs-note">$50/month · one plan</div></div><div class="vs-mid"><span>vs</span></div><div class="vs-side"><div class="vs-mark" aria-hidden="true">L</div><div class="vs-name">Lune</div><div class="vs-note">Compared on its own published pages</div></div></div></div></div>
</div>
<ul class="standards in-hero">
<li><i class="fa-solid fa-check" aria-hidden="true"></i><span>50,000+ traders served</span></li>
<li><i class="fa-solid fa-check" aria-hidden="true"></i><span>7-day free trial, no credit card</span></li>
<li><i class="fa-solid fa-check" aria-hidden="true"></i><span>Runs in the cloud — your computer can be off</span></li>
<li><i class="fa-solid fa-check" aria-hidden="true"></i><span>Tradovate connects by OAuth, with no API fee</span></li>
</ul>
</div>
</header>

<nav class="secnav" aria-label="On this page">
<div class="wrap secnav-inner">
<ul>
<li><a href="#the-price-matched-like-for-like" data-target="the-price-matched-like-for-like">Price</a></li>
<li><a href="#side-by-side" data-target="side-by-side">Side by side</a></li>
<li><a href="#where-lune-s-review-of-pickmytrade-is-out-of-date" data-target="where-lune-s-review-of-pickmytrade-is-out-of-date">Corrections</a></li>
<li><a href="#why-traders-choose-pickmytrade" data-target="why-traders-choose-pickmytrade">Why PickMyTrade</a></li>
<li><a href="#moving-from-lune" data-target="moving-from-lune">Switching</a></li>
<li><a href="#frequently-asked-questions" data-target="frequently-asked-questions">FAQ</a></li>
</ul>
<a class="btn btn-primary btn-sm" href="https://app.pickmytrade.trade/?register=true">Start free trial</a>
</div>
</nav>

<section id="the-price-matched-like-for-like" class="sec">
<div class="wrap">
<div class="head">
<p class="eyebrow">Price</p>
<h2>The price, matched like for like</h2>
</div>
<div class="stats3">
<div class="stat"><span class="v">$50</span><span class="l">per month, one plan</span></div>
<div class="stat"><span class="v">$500</span><span class="l">per year</span></div>
<div class="stat"><span class="v">7 days</span><span class="l">free trial, no card</span></div>
</div>
        <p class="prose">Lune sells five products separately — journal, Auto Trader, indicators, strategies and trade copier — then charges again for capacity through a connection tier. So the comparison is not Auto Trader against our <span class="pr">$50</span>. It is Auto Trader <em>plus</em> the Trade Copier, because on Lune those are two purchases.</p>
        <div class="table-scroll" tabindex="0" role="region" aria-label="Comparison table">
<table>
<caption>Monthly prices as published by each company. Lune's pricing page and product pages checked 22 September 2026. Lune's bundle discount of 15% for two products is applied where two products are needed.</caption>
<thead><tr><th scope="col">What you need</th><th scope="col">Lune</th><th scope="col" class="own">PickMyTrade</th></tr></thead>
<tbody>
<tr><th scope="row">TradingView alerts to futures accounts, no copying</th><td>Auto Trader, <span class="pr">$49</span></td><td class="own"><span class="pr">$50</span></td></tr>
<tr><th scope="row">Copying from a leader you trade by hand, no alerts</th><td>Trade Copier, <span class="pr">$39</span></td><td class="own"><span class="pr">$50</span></td></tr>
<tr><th scope="row">TradingView alerts <em>and</em> a copier</th><td>Auto Trader + Trade Copier, <span class="pr">$75</span> after the two-product discount</td><td class="own"><span class="pr">$50</span></td></tr>
<tr><th scope="row">The same, with more than 10 accounts under one broker login</th><td>Add the Pro connection tier, <span class="pr">$40</span> → about <span class="pr">$109</span></td><td class="own"><span class="pr">$50</span></td></tr>
<tr><th scope="row">The same, with accounts spread over 3–5 separate broker logins</th><td>Pro connections cover 5 logins → about <span class="pr">$109</span></td><td class="own"><span class="pr">$150</span>–<span class="pr">$250,</span> because each login needs its own subscription</td></tr>
<tr><th scope="row">Stocks, options, forex or CFDs from the same alerts</th><td>Not offered. Lune's connection products are futures-only</td><td class="own"><span class="pr">$50</span></td></tr>
</tbody>
</table>
</div>
        <p class="prose"><strong>The worked example.</strong> Five Apex accounts under one Tradovate login, driven by a TradingView strategy, fills copied across all five. On PickMyTrade that is one <span class="pr">$50</span> subscription, because one subscription covers unlimited accounts under one broker login. On Lune it is Auto Trader plus the Trade Copier at <span class="pr">$75,</span> with the included Starter connections covering it. Move those five accounts onto five separate logins and it flips: Lune's Pro tier covers five logins for <span class="pr">$40</span> more, while we need five subscriptions. You should know that here rather than after you pay us.</p>
        <p class="prose"><a href="/pages/pricing/">PickMyTrade pricing</a> · <a href="https://lunefi.com/pricing" target="_blank" rel="noopener noreferrer">Lune pricing</a></p>
</div>
</section>

<section id="side-by-side" class="sec band">
<div class="wrap">
<div class="head">
<p class="eyebrow">Side by side</p>
<h2>Side by side</h2>
</div>
<div class="table-scroll" tabindex="0" role="region" aria-label="Comparison table">
<table>
<caption>What each product does, from each company's own pages and documentation. Lune checked 22 September 2026.</caption>
<thead><tr><th scope="col">Decision</th><th scope="col" class="own">PickMyTrade</th><th scope="col">Lune</th></tr></thead>
<tbody>
<tr><th scope="row">How you are billed</th><td class="own">One plan, <span class="pr">$50</span> a month or <span class="pr">$500</span> a year, every feature. One subscription covers unlimited accounts under one broker login; a second login needs its own</td><td>Per product, plus a connection tier. Starter is included (2 connections, 10 accounts each); Pro <span class="pr">$40</span>; Ultra <span class="pr">$90,</span> labelled unlimited but capped at 150 accounts. <a href="https://lunefi.com/pricing" target="_blank" rel="noopener noreferrer">Source</a></td></tr>
<tr><th scope="row">Markets</th><td class="own">Futures; stocks and options through Interactive Brokers, TradeStation and Tradier (Tradier options are single-leg); forex and CFDs through TradeLocker and Match-Trader</td><td>Futures. Lune's own FAQ says its connection-based products are futures-only</td></tr>
<tr><th scope="row">Brokers and platforms</th><td class="own">Tradovate, Rithmic, ProjectX including TopstepX, Interactive Brokers, TradeStation, Tradier, TradeLocker, Match-Trader. <a href="https://pickmytrade.io/broker/">Broker guides</a></td><td>Four futures platforms, plus a paper-trading connection</td></tr>
<tr><th scope="row">TradingView automation</th><td class="own">Strategy and indicator alerts, plus TrendSpider, in the <span class="pr">$50</span> plan. <a href="https://docs.pickmytrade.trade/docs/tradingview-json-alert-configuration/" target="_blank" rel="noopener noreferrer">Alert setup</a></td><td>Auto Trader, <span class="pr">$49</span> a month or <span class="pr">$470</span> a year. <a href="https://lunefi.com/products/auto-trader" target="_blank" rel="noopener noreferrer">Source</a></td></tr>
<tr><th scope="row">Trade copier</th><td class="own">Included. Tradovate admin account to followers, with a quantity multiplier per account. <a href="https://docs.pickmytrade.trade/docs/tradingview-to-tradovate-trade-copier/" target="_blank" rel="noopener noreferrer">Guide</a></td><td>A separate product from <span class="pr">$39</span>. Copies between its four futures platforms in any leader and follower combination, with per-follower sizing and automatic mini and micro conversion. <a href="https://lunefi.com/products/trade-copier/tradovate" target="_blank" rel="noopener noreferrer">Source</a></td></tr>
<tr><th scope="row">Account risk limits</th><td class="own">Daily and weekly profit and loss limits per account, trading-time windows, pause, news filter on Tradovate. <a href="https://docs.pickmytrade.trade/docs/trading-risk-settings/" target="_blank" rel="noopener noreferrer">Guide</a></td><td>Included with any connection product: daily limits, position caps, kill switch, blackout windows. Lune's risk documentation says its controls do not read or enforce a prop firm's rules</td></tr>
<tr><th scope="row">Order management</th><td class="own">SL and TP five ways, brackets and OCO, trailing stop on Tradovate and ProjectX, breakeven with offset, SL/TP updates on an open trade, partial close, reverse, symbol mapping, futures rollover. <a href="https://docs.pickmytrade.trade/docs/configure-trailing-stop-loss/" target="_blank" rel="noopener noreferrer">Trailing</a> · <a href="https://docs.pickmytrade.trade/docs/breakeven-offset-tradovate-automation-pickmytrade/" target="_blank" rel="noopener noreferrer">Breakeven</a></td><td>Market, limit and stop orders, take-profit and stop-loss brackets placed as real broker orders, partial exits and adds</td></tr>
<tr><th scope="row">Trade journal</th><td class="own">Not offered</td><td><span class="pr">$39,</span> or free once two paid products are selected</td></tr>
<tr><th scope="row">Where it runs</th><td class="own">In the cloud. Interactive Brokers is the exception: TWS or IB Gateway plus the PickMyTrade IB application must stay running. <a href="https://docs.pickmytrade.io/docs/interactive-brokers-trading-setup/" target="_blank" rel="noopener noreferrer">IBKR setup</a></td><td>In the cloud, with no VPS</td></tr>
<tr><th scope="row">Free trial</th><td class="own">7 days, no credit card, full access. Tradovate connects by <a href="https://docs.pickmytrade.trade/docs/faqs/" target="_blank" rel="noopener noreferrer">OAuth</a>, with no API purchase</td><td>7 days, card required. Lune's page says the card is charged when the trial ends; its terms say fees are non-refundable except where the law requires. Tradovate is OAuth here too</td></tr>
</tbody>
</table>
</div>
</div>
</section>

<section id="where-lune-s-review-of-pickmytrade-is-out-of-date" class="sec">
<div class="wrap">
<div class="head">
<p class="eyebrow">Corrections</p>
<h2>Where Lune's review of PickMyTrade is out of date</h2>
</div>
<p class="prose">Lune publishes a page titled "PickMyTrade Review 2026", written in a third-party voice by a named editor and published on 11 May 2026. It has not been updated since. Several statements in it about us are wrong, and two would cost a reader money or time, so we are correcting them here with the date we checked. Every fact below is in our own documentation, linked above.</p>
        <div class="table-scroll" tabindex="0" role="region" aria-label="Comparison table">
<table>
<caption>Statements in Lune's PickMyTrade review, checked against our own documentation on 23 September 2026.</caption>
<thead><tr><th scope="col">What the review says</th><th scope="col">What is actually the case</th></tr></thead>
<tbody>
<tr><th scope="row">Setup requires you to "generate an API token in Tradovate settings"</th><td>No. PickMyTrade connects to Tradovate with OAuth. There is no Tradovate API subscription to buy and no token to generate. This is the correction that matters most, because it puts a purchase in front of a step that does not need one.</td></tr>
<tr><th scope="row">To start, "verify your email and add payment for the <span class="pr">$50</span>/month plan"</th><td>The trial is 7 days with full access and no credit card. The <span class="pr">$50</span> price is right; the card is not.</td></tr>
<tr><th scope="row">PickMyTrade "connects to five main brokers", and TradeLocker is listed as a futures route</th><td>Ten brokers: Tradovate, Rithmic, ProjectX including TopstepX, Interactive Brokers, TradeStation, Tradier, TradeLocker, Match-Trader, cTrader (Beta) and Ironbeam (Beta). The review's table leaves out ProjectX, Tradier and Match-Trader. TradeLocker and Match-Trader are forex and CFD routes, not futures.</td></tr>
<tr><th scope="row">"Over 10,000 traders use it", plus a total number of trades</th><td>PickMyTrade has served 50,000+ traders. We do not publish a trade total, so that figure did not come from us.</td></tr>
<tr><th scope="row">Launched "from Evanston, Illinois"</th><td>PickMyTrade is PickMyTrade Pvt. Ltd., registered in India.</td></tr>
<tr><th scope="row">Risk management summarised as "Basic (limits, retries)"</th><td>Daily and weekly profit and loss limits per account, trading-time windows, a pause switch, a news filter on Tradovate, SL and TP five ways, brackets and OCO, trailing stops on Tradovate and ProjectX, breakeven with offset, partial close and reverse.</td></tr>
<tr><th scope="row">A fixed prop-firm count is attached to PickMyTrade</th><td>We do not publish one. Support is by platform: any firm that issues Tradovate, Rithmic or ProjectX accounts. Firms set their own rules on automation and copy trading.</td></tr>
</tbody>
</table>
</div>
        <p class="prose">The review's claims about Lune itself — its journal, its indicator and strategy products, its prop-firm coverage — are Lune's own published statements about its own product, and we have left them alone.</p>
</div>
</section>

<section id="why-traders-choose-pickmytrade" class="sec band">
<div class="wrap">
<div class="head">
<p class="eyebrow">Why PickMyTrade</p>
<h2>Why traders choose PickMyTrade</h2>
</div>
<div class="cards">
<article class="card"><h3>One price covers the second job, and the third</h3><p>Automation, the copier, per-account risk limits and every order type sit in the same <span class="pr">$50</span>. No cart to configure, no capacity tier to add when the fourth account arrives. <a href="/pages/pricing/">See pricing</a>.</p></article>
<article class="card"><h3>Your next broker is probably already included</h3><p>Tradovate, Rithmic and ProjectX for futures. Interactive Brokers, TradeStation and Tradier for stocks and options. TradeLocker and Match-Trader for forex and CFDs. Lune's connection products are futures-only, so this is the difference no discount closes. <a href="https://pickmytrade.io/broker/">Broker guides</a>.</p></article>
<article class="card"><h3>Limits that hold when you are not watching</h3><p>Daily and weekly profit and loss limits on each account, plus the hours automation may trade. They are settings, not guarantees — match them to your firm's rules, and read those rules first. <a href="https://docs.pickmytrade.trade/docs/trading-risk-settings/" target="_blank" rel="noopener noreferrer">Risk settings</a>.</p></article>
<article class="card"><h3>Manage the trade after entry</h3><p>Stop loss and take profit by points, percentage, price, ticks or total P/L. Brackets, trailing stops, breakeven with an offset, SL/TP changes on an open position, partial closes and reversals, all from the alert. <a href="https://docs.pickmytrade.trade/docs/tradingview-json-alert-configuration/" target="_blank" rel="noopener noreferrer">Alert setup</a>.</p></article>
<article class="card"><h3>Nothing to keep running, and no card to try it</h3><p>Alerts execute in the cloud with your computer off and no VPS to rent; Interactive Brokers is the one exception. The trial is seven days with no credit card.</p></article>
</div>
</div>
</section>

<section id="moving-from-lune" class="sec band">
<div class="wrap">
<div class="head">
<p class="eyebrow">Switching</p>
<h2>Moving from Lune</h2>
</div>
<div class="measure">
<ol class="steps">
<li><span class="n">1</span><p><strong>Start the free trial and connect your broker.</strong> Sign in to Tradovate with OAuth, or follow the guide for Rithmic, ProjectX or whichever broker you trade.</p></li>
<li><span class="n">2</span><p><strong>Rebuild the alert message.</strong> Generate it in the PickMyTrade dashboard and paste it into your TradingView alert with our webhook URL. Lune's alert format does not carry across as it is.</p></li>
<li><span class="n">3</span><p><strong>Set accounts, sizing and exits.</strong> Choose which accounts receive the alert and at what size, then the stop loss, take profit and any trailing or breakeven rules. If you copy, nominate the admin account first.</p></li>
<li><span class="n">4</span><p><strong>Test, then switch one account at a time.</strong> Run it on a demo account and check the order at your broker. Turn Lune's automation off for that account before going live, so only one tool is placing orders. Cancel Lune once every account has moved, because its terms say fees are non-refundable.</p></li>
</ol>
</div>
</div>
</section>

<section id="frequently-asked-questions" class="sec">
<div class="wrap">
<div class="faq-wrap">
<p class="eyebrow">FAQ</p>
<h2>Frequently asked questions</h2>
<div class="faq">
{faqs.map((f) => (
<details>
<summary><span>{f.question}</span><i aria-hidden="true"></i></summary>
<div class="ans"><p>{f.answer}</p></div>
</details>
))}
</div>
</div>
</div>
</section>

<section id="sources" class="sec sec-quiet" aria-label="Sources and disclosure">
<div class="wrap">
<div class="measure">
<p class="eyebrow">Sources</p>
<h2 class="h-sm">Sources and disclosure</h2>
<p class="src-p">Prepared and published by PickMyTrade. Lune details come from its own pages, checked 22 September 2026: <a href="https://lunefi.com/pricing" target="_blank" rel="noopener noreferrer">pricing</a>, <a href="https://lunefi.com/products/auto-trader" target="_blank" rel="noopener noreferrer">Auto Trader</a>, <a href="https://lunefi.com/products/trade-copier/tradovate" target="_blank" rel="noopener noreferrer">Trade Copier</a> and its <a href="https://lunefi.com/blog/pickmytrade-review-2026-tradingview-automation-futures-prop-traders" target="_blank" rel="noopener noreferrer">PickMyTrade review</a> of 11 May 2026. Our own figures come from our <a href="/pages/pricing/">pricing</a>, <a href="https://pickmytrade.io/broker/">broker</a> and <a href="https://docs.pickmytrade.trade/docs/faqs/" target="_blank" rel="noopener noreferrer">documentation</a> pages. Prices and features change on both sides; check before you buy. If anything here is wrong, tell us and we will correct it and date the change.</p>
<p class="src-p risk"><strong>Risk disclosure.</strong> Trading futures involves substantial risk of loss and is not suitable for every investor. Past performance is not indicative of future results. The content on this page is for educational and informational purposes only and does not constitute financial, investment, or trading advice. Only trade with capital you can afford to lose.</p>
</div>
</div>
</section>

<section class="cta-sec">
<div class="wrap">
<div class="cta">
<div>
<h2 class="h-sm">Ready to get started?</h2>
<p>Connect your broker and run your own alert on a 7-day free trial. No credit card.</p>
</div>
<div class="cta-actions">
<a class="btn btn-primary" href="https://app.pickmytrade.trade/?register=true">Start your 7-day free trial <span aria-hidden="true">→</span></a>
<a class="btn btn-quiet" href="/pages/pricing/">See pricing <span aria-hidden="true">→</span></a>
</div>
</div>
</div>
</section>
</div>
</Localize>

<CompareSpy />
</BaseLayout>
