---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import "../../../styles/compare-editorial.css";
import CompareSpy from "../../../components/CompareSpy.astro";
import { getLocalePaths } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import Localize from "../../../components/Localize.astro";
import { makeTr, localizeLd } from "../../../i18n/compare-i18n.mjs";
import AuthorByline from "../../../components/AuthorByline.astro";

// Compare pages are translated (de/es/fr/it): text is swapped in by <Localize> from src/i18n/compare/<locale>.json.
export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };
const tr = makeTr(locale);
const title = tr("PickMyTrade vs CrossTrade (2026): Price, Brokers, Copier");
const description = tr("CrossTrade or PickMyTrade? Matched tier for tier it is $49 vs $50. Compare brokers, the trade copier, risk limits and a 7-day free trial with no card.");
const lastUpdated = "2026-09-23";

const faqsEn = [
  {
    "question": "Is PickMyTrade more expensive than CrossTrade?",
    "answer": "For the same capability, the two are within a dollar of each other. CrossTrade's copier and Account Manager risk controls start on its $49 Pro plan; PickMyTrade is $50 with both included. CrossTrade Standard at $29 is cheaper if you only need webhooks to Tradovate or NinjaTrader 8 and never copy a trade to a second account."
  },
  {
    "question": "Do I need NinjaTrader to use either tool?",
    "answer": "No. Both connect to Tradovate in the cloud without NinjaTrader. CrossTrade's NinjaTrader 8 add-on is for traders who already work inside NinjaTrader. With PickMyTrade, NinjaTrader accounts that log in through Tradovate work with the Tradovate integration."
  },
  {
    "question": "How many accounts does one PickMyTrade subscription cover?",
    "answer": "One subscription covers unlimited accounts under one broker login. Five Apex accounts under a single Tradovate login all automate on one $50 subscription. If your accounts sit under separate broker logins, each login needs its own subscription."
  },
  {
    "question": "Does my computer need to stay on?",
    "answer": "Not for Tradovate, Rithmic, ProjectX or the other cloud routes — alerts execute with your machine off. Interactive Brokers is the exception, because TWS or IB Gateway and the PickMyTrade IB application have to keep running."
  },
  {
    "question": "Does PickMyTrade have a trade journal or an API?",
    "answer": "No to both. If a built-in journal or a published API matters to you, CrossTrade includes both on every plan. PickMyTrade covers execution: alerts, copying, order management and account risk limits."
  },
  {
    "question": "Can I use PickMyTrade with prop firm accounts?",
    "answer": "Yes, on the platforms it supports — any prop firm that offers Tradovate, Rithmic or ProjectX accounts, including TopstepX. Firms set their own rules on automation and copy trading, so check yours before going live."
  },
  {
    "question": "Do I have to buy Tradovate API access?",
    "answer": "No. PickMyTrade connects to Tradovate with OAuth, so there is no separate Tradovate API subscription."
  }
];
const faqs = faqsEn.map((f) => ({ question: tr(f.question), answer: tr(f.answer) }));

const ld = [
  { "@context": "https://schema.org", ...{
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "PickMyTrade",
      "item": "https://pickmytrade.trade/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Compare",
      "item": "https://pickmytrade.trade/compare/"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": "PickMyTrade vs CrossTrade",
      "item": "https://pickmytrade.trade/compare/pickmytrade-vs-crosstrade/"
    }
  ]
} },
  { "@context": "https://schema.org", ...{
  "@type": "WebPage",
  "@id": "https://pickmytrade.trade/compare/pickmytrade-vs-crosstrade/#webpage",
  "url": "https://pickmytrade.trade/compare/pickmytrade-vs-crosstrade/",
  "name": "PickMyTrade vs CrossTrade",
  "datePublished": "2026-09-23",
  "dateModified": "2026-09-23",
  "publisher": {
    "@id": "https://pickmytrade.trade/#organization"
  }
} },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "@id": "https://pickmytrade.trade/compare/pickmytrade-vs-crosstrade/#faq",
    mainEntity: faqs.map((f) => ({
      "@type": "Question",
      name: f.question,
      acceptedAnswer: { "@type": "Answer", text: f.answer },
    })),
  },
];
const ldLocalized = localizeLd(ld, locale, tr);
---
<BaseLayout locale={locale} title={title} description={description} ldJson={ldLocalized}>
<Localize locale={locale}>
<div class="ed">
<header class="hero">
<div class="wrap">
<nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">›</span><a href="/compare/">Compare</a><span aria-hidden="true">›</span><span aria-current="page">PickMyTrade vs CrossTrade</span></nav>
<div class="hero-grid">
<div class="hero-copy">
<p class="eyebrow">Head-to-head comparison · 2026</p>
<div class="byline" data-i18n-skip="true"><AuthorByline locale={locale} lastUpdated={lastUpdated} /></div>
<h1>PickMyTrade vs CrossTrade</h1>
<p class="lede">{description}</p>

<div class="actions"><a class="btn btn-primary" href="https://app.pickmytrade.trade/?register=true">Start free trial</a><a class="btn btn-quiet" href="#side-by-side">Skip to the comparison table <span aria-hidden="true">→</span></a></div>
</div>
<div class="hero-visual"><div class="vs" role="group" aria-label="PickMyTrade compared with CrossTrade"><div class="vs-row"><div class="vs-side vs-own"><div class="vs-mark" aria-hidden="true">P</div><div class="vs-name">PickMyTrade</div><div class="vs-note">$50/month · one plan</div></div><div class="vs-mid"><span>vs</span></div><div class="vs-side"><div class="vs-mark" aria-hidden="true">C</div><div class="vs-name">CrossTrade</div><div class="vs-note">Compared on its own published pages</div></div></div></div></div>
</div>
<ul class="standards in-hero">
<li><i class="fa-solid fa-check" aria-hidden="true"></i><span>50,000+ traders served</span></li>
<li><i class="fa-solid fa-check" aria-hidden="true"></i><span>7-day free trial, no credit card</span></li>
<li><i class="fa-solid fa-check" aria-hidden="true"></i><span>Runs in the cloud — your computer can be off</span></li>
<li><i class="fa-solid fa-check" aria-hidden="true"></i><span>Tradovate connects by OAuth, with no API fee</span></li>
</ul>
</div>
</header>

<nav class="secnav" aria-label="On this page">
<div class="wrap secnav-inner">
<ul>
<li><a href="#the-price-matched-like-for-like" data-target="the-price-matched-like-for-like">Price</a></li>
<li><a href="#side-by-side" data-target="side-by-side">Side by side</a></li>
<li><a href="#why-traders-choose-pickmytrade" data-target="why-traders-choose-pickmytrade">Why PickMyTrade</a></li>
<li><a href="#moving-from-crosstrade" data-target="moving-from-crosstrade">Switching</a></li>
<li><a href="#frequently-asked-questions" data-target="frequently-asked-questions">FAQ</a></li>
</ul>
<a class="btn btn-primary btn-sm" href="https://app.pickmytrade.trade/?register=true">Start free trial</a>
</div>
</nav>

<section id="the-price-matched-like-for-like" class="sec">
<div class="wrap">
<div class="head">
<p class="eyebrow">Price</p>
<h2>The price, matched like for like</h2>
</div>
<div class="stats3">
<div class="stat"><span class="v">$50</span><span class="l">per month, one plan</span></div>
<div class="stat"><span class="v">$500</span><span class="l">per year</span></div>
<div class="stat"><span class="v">7 days</span><span class="l">free trial, no card</span></div>
</div>
        <p class="prose">CrossTrade's comparison puts its <span class="pr">$29</span> Standard plan next to our <span class="pr">$50</span> and calls the difference <span class="pr">$21</span> a month. Standard does not include the trade copier or the Account Manager risk controls. Once you need either, the plan to compare is CrossTrade Pro at <span class="pr">$49</span> — a dollar below PickMyTrade, with fewer brokers behind it.</p>
        <div class="table-scroll" tabindex="0" role="region" aria-label="Comparison table">
<table>
<caption>Monthly prices as published by each company. CrossTrade checked 22 September 2026.</caption>
<thead><tr><th scope="col">What you need</th><th scope="col">CrossTrade</th><th scope="col" class="own">PickMyTrade</th></tr></thead>
<tbody>
<tr><th scope="row">TradingView alerts to Tradovate or NinjaTrader 8, no copying</th><td>Standard, <span class="pr">$29</span></td><td class="own"><span class="pr">$50</span></td></tr>
<tr><th scope="row">The same, plus a trade copier and account loss limits</th><td>Pro, <span class="pr">$49</span></td><td class="own"><span class="pr">$50</span></td></tr>
<tr><th scope="row">Alerts to Rithmic, ProjectX, Interactive Brokers, TradeStation, Tradier, TradeLocker or Match-Trader</th><td>Not offered — its cloud route is Tradovate</td><td class="own">Same <span class="pr">$50</span> plan, whichever broker you choose</td></tr>
<tr><th scope="row">Built-in trade journal and published API</th><td>Included from <span class="pr">$29</span></td><td class="own">Not offered</td></tr>
</tbody>
</table>
</div>
        <p class="prose">One PickMyTrade subscription covers unlimited accounts under one broker login. If you hold five Apex accounts under a single Tradovate login, one <span class="pr">$50</span> subscription automates all five. A second, separate Tradovate login needs its own subscription — worth checking before you compare totals.</p>
        <p class="prose"><a href="/pages/pricing/">PickMyTrade pricing</a> · <a href="https://crosstrade.io/pricing" target="_blank" rel="noopener noreferrer">CrossTrade pricing</a></p>
</div>
</section>

<section id="side-by-side" class="sec band">
<div class="wrap">
<div class="head">
<p class="eyebrow">Side by side</p>
<h2>Side by side</h2>
</div>
<div class="table-scroll" tabindex="0" role="region" aria-label="Comparison table">
<table>
<caption>What each product does, from each company's own documentation. Checked 22 September 2026.</caption>
<thead><tr><th scope="col">Decision</th><th scope="col" class="own">PickMyTrade</th><th scope="col">CrossTrade</th></tr></thead>
<tbody>
<tr><th scope="row">Brokers and platforms</th><td class="own">Tradovate, Rithmic, ProjectX, Interactive Brokers, TradeStation, Tradier, TradeLocker, Match-Trader. <a href="https://pickmytrade.io/broker/">Broker guides</a></td><td>Tradovate in the cloud, plus a native NinjaTrader 8 add-on. <a href="https://crosstrade.io/tradovate" target="_blank" rel="noopener noreferrer">Source</a></td></tr>
<tr><th scope="row">Markets</th><td class="own">Futures; stocks and options through Interactive Brokers, TradeStation and Tradier; forex and CFDs through TradeLocker and Match-Trader</td><td>Futures. Its own comparison sends stock and options traders to PickMyTrade. <a href="https://crosstrade.io/compare/crosstrade-vs-pickmytrade" target="_blank" rel="noopener noreferrer">Source</a></td></tr>
<tr><th scope="row">Trade copier</th><td class="own">Included. Admin account to followers on Tradovate, with a quantity multiplier per account. <a href="https://docs.pickmytrade.trade/docs/tradingview-to-tradovate-trade-copier/" target="_blank" rel="noopener noreferrer">Guide</a></td><td>Included from the <span class="pr">$49</span> Pro plan. <a href="https://crosstrade.io/trade-copier" target="_blank" rel="noopener noreferrer">Source</a></td></tr>
<tr><th scope="row">One alert to several accounts</th><td class="own">Yes, each account with its own size. <a href="https://docs.pickmytrade.trade/docs/place-trades-in-multiple-accounts/" target="_blank" rel="noopener noreferrer">Guide</a></td><td>Signal and execution copying on Pro</td></tr>
<tr><th scope="row">Account risk limits</th><td class="own">Daily and weekly profit and loss limits on each account, plus trading-time windows. <a href="https://docs.pickmytrade.trade/docs/trading-risk-settings/" target="_blank" rel="noopener noreferrer">Guide</a></td><td>Account Manager controls, from the <span class="pr">$49</span> Pro plan</td></tr>
<tr><th scope="row">Order tools</th><td class="own">Stop loss and take profit five ways, brackets, trailing stops on Tradovate and ProjectX, breakeven with offset, SL/TP updates on an open trade, partial close, reverse. <a href="https://docs.pickmytrade.trade/docs/configure-trailing-stop-loss/" target="_blank" rel="noopener noreferrer">Trailing</a> · <a href="https://docs.pickmytrade.trade/docs/breakeven-offset-tradovate-automation-pickmytrade/" target="_blank" rel="noopener noreferrer">Breakeven</a></td><td>Saved bracket templates, trailing and breakeven rules</td></tr>
<tr><th scope="row">Where it runs</th><td class="own">In the cloud. Interactive Brokers is the exception: TWS or IB Gateway must stay running. <a href="https://docs.pickmytrade.io/docs/interactive-brokers-trading-setup/" target="_blank" rel="noopener noreferrer">IBKR setup</a></td><td>Tradovate in the cloud; the NinjaTrader 8 workflow runs inside NinjaTrader</td></tr>
<tr><th scope="row">NinjaTrader</th><td class="own">NinjaTrader accounts that log in through Tradovate work with the Tradovate integration. No NinjaTrader 8 add-on</td><td>Native NinjaTrader 8 add-on</td></tr>
<tr><th scope="row">Trade journal</th><td class="own">Not offered</td><td>Included on every plan</td></tr>
<tr><th scope="row">Published API</th><td class="own">Not offered</td><td>Included on every plan</td></tr>
<tr><th scope="row">Free trial</th><td class="own">7 days, no credit card</td><td>7 days, no credit card</td></tr>
</tbody>
</table>
</div>
</div>
</section>

<section id="why-traders-choose-pickmytrade" class="sec">
<div class="wrap">
<div class="head">
<p class="eyebrow">Why PickMyTrade</p>
<h2>Why traders choose PickMyTrade</h2>
</div>
<div class="cards">
<article class="card"><h3>Your next broker is already supported</h3><p>Tradovate, Rithmic and ProjectX for futures and prop firm accounts. Interactive Brokers, TradeStation and Tradier for stocks and options. TradeLocker and Match-Trader for forex and CFDs. Every one of them runs on the same <span class="pr">$50</span> plan with the same features — you never move to a different product or a higher tier as your trading changes. Each broker login is its own subscription, so two logins means two subscriptions. <a href="https://pickmytrade.io/broker/">See the broker guides</a>.</p></article>
<article class="card"><h3>The copier is not a higher tier</h3><p>Trade on an admin account and every follower account copies it, each with its own quantity multiplier. It is in the <span class="pr">$50</span> plan, alongside everything else. <a href="https://docs.pickmytrade.trade/docs/tradingview-to-tradovate-trade-copier/" target="_blank" rel="noopener noreferrer">Read the copier guide</a>.</p></article>
<article class="card"><h3>Limits that hold when you are not watching</h3><p>Set daily and weekly profit and loss limits on each connected account, plus the hours automation is allowed to trade. They are settings, not promises — set them to match your firm's rules. <a href="https://docs.pickmytrade.trade/docs/trading-risk-settings/" target="_blank" rel="noopener noreferrer">Risk settings</a>.</p></article>
<article class="card"><h3>Manage the trade after entry</h3><p>Stop loss and take profit by points, percentage, price, ticks or total P/L. Brackets, trailing stops, breakeven with an offset, SL/TP changes on an open position, partial closes and reversals — all driven from the TradingView alert. <a href="https://docs.pickmytrade.trade/docs/tradingview-json-alert-configuration/" target="_blank" rel="noopener noreferrer">Alert setup</a>.</p></article>
<article class="card"><h3>Nothing to keep running</h3><p>Alerts execute in the cloud with your computer off and no VPS to rent. Interactive Brokers is the one exception: TWS or IB Gateway and the PickMyTrade IB application need to stay running.</p></article>
<article class="card"><h3>No Tradovate API fee</h3><p>Tradovate connects by OAuth, so there is no separate Tradovate API subscription to buy before you can automate. <a href="https://docs.pickmytrade.trade/docs/faqs/" target="_blank" rel="noopener noreferrer">Tradovate FAQ</a>.</p></article>
</div>
</div>
</section>

<section id="moving-from-crosstrade" class="sec">
<div class="wrap">
<div class="head">
<p class="eyebrow">Switching</p>
<h2>Moving from CrossTrade</h2>
</div>
<div class="measure">
<ol class="steps">
<li><span class="n">1</span><p><strong>Start the free trial and connect your broker.</strong> Sign in to Tradovate with OAuth, or follow the guide for Rithmic, ProjectX or whichever broker you trade.</p></li>
<li><span class="n">2</span><p><strong>Build the PickMyTrade alert message.</strong> Generate it in the dashboard and paste it into your TradingView alert with the PickMyTrade webhook URL. CrossTrade's command format does not carry across as it is.</p></li>
<li><span class="n">3</span><p><strong>Set accounts, sizing and exits.</strong> Choose which accounts receive the alert and at what size, then the stop loss, take profit and any trailing or breakeven rules.</p></li>
<li><span class="n">4</span><p><strong>Test, then switch one account at a time.</strong> Run it on a demo account and check the order at your broker. Turn CrossTrade's automation off for that account before going live, so only one tool is placing orders.</p></li>
</ol>
</div>
</div>
</section>

<section id="frequently-asked-questions" class="sec band">
<div class="wrap">
<div class="faq-wrap">
<p class="eyebrow">FAQ</p>
<h2>Frequently asked questions</h2>
<div class="faq">
{faqs.map((f) => (
<details>
<summary><span>{f.question}</span><i aria-hidden="true"></i></summary>
<div class="ans"><p>{f.answer}</p></div>
</details>
))}
</div>
</div>
</div>
</section>

<section id="sources" class="sec sec-quiet" aria-label="Sources and disclosure">
<div class="wrap">
<div class="measure">
<p class="eyebrow">Sources</p>
<h2 class="h-sm">Sources and disclosure</h2>
<p class="src-p">Prepared by PickMyTrade. CrossTrade details come from its own pages, checked 22 September 2026: <a href="https://crosstrade.io/pricing" target="_blank" rel="noopener noreferrer">pricing</a>, <a href="https://crosstrade.io/compare/crosstrade-vs-pickmytrade" target="_blank" rel="noopener noreferrer">its PickMyTrade comparison</a>, <a href="https://crosstrade.io/tradovate" target="_blank" rel="noopener noreferrer">Tradovate</a> and <a href="https://crosstrade.io/trade-copier" target="_blank" rel="noopener noreferrer">trade copier</a>. Prices and features change; check both sites before you buy.</p>
<p class="src-p risk"><strong>Risk disclosure.</strong> Trading futures involves substantial risk of loss and is not suitable for every investor. Past performance is not indicative of future results. The content on this page is for educational and informational purposes only and does not constitute financial, investment, or trading advice. Only trade with capital you can afford to lose.</p>
</div>
</div>
</section>

<section class="cta-sec">
<div class="wrap">
<div class="cta">
<div>
<h2 class="h-sm">Ready to get started?</h2>
<p>Connect your broker and run your own alert on a 7-day free trial. No credit card.</p>
</div>
<div class="cta-actions">
<a class="btn btn-primary" href="https://app.pickmytrade.trade/?register=true">Start your 7-day free trial <span aria-hidden="true">→</span></a>
<a class="btn btn-quiet" href="/pages/pricing/">See pricing <span aria-hidden="true">→</span></a>
</div>
</div>
</div>
</section>
</div>
</Localize>

<CompareSpy />
</BaseLayout>
