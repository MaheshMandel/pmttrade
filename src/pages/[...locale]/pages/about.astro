---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import {
  getLocalePaths,
  useTranslations,
  localizedPath,
} from '../../../i18n/utils';
import type { Locale } from '../../../i18n/config';

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };
const t = useTranslations(locale);

const SITE_URL = 'https://pickmytrade.trade';
const withSlash = (p: string) => (p.endsWith('/') ? p : `${p}/`);

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  'itemListElement': [
    { '@type': 'ListItem', 'position': 1, 'name': 'Home', 'item': `${SITE_URL}${withSlash(localizedPath(locale))}` },
    { '@type': 'ListItem', 'position': 2, 'name': 'About', 'item': `${SITE_URL}${withSlash(localizedPath(locale, 'pages/about'))}` },
  ],
};
---

<BaseLayout
  locale={locale}
  title={t('about.meta_title')}
  description={t('about.meta_description')}
  ldJson={[breadcrumbSchema]}>
  <div class='bg-[#001429]'>
    <!-- Hero Section -->
    <section class='pt-8 pb-16 px-4'>
      <div class='container mx-auto max-w-7xl text-center'>
        <span
          class='electrolize-regular inline-block px-4 py-2 bg-blue-600/20 text-blue-400 rounded-full text-sm font-semibold mb-6 border border-blue-500/30 uppercase'>
          {t('about.hero_badge')}
        </span>
        <h1
          class='text-4xl sm:text-5xl lg:text-6xl font-bold text-white mb-6 tracking-tight'>
          {t('about.hero_title')}<br /><span class='gradient-text'
            >{t('about.hero_title_highlight')}</span
          >
        </h1>
        <p class='text-xl text-gray-300 max-w-3xl mx-auto leading-relaxed mb-4'>
          {t('about.hero_subtitle')}
        </p>
        <p class='text-xs text-white/50'>
          <i class='far fa-clock mr-1'></i>{t('about.hero_last_updated')}
          <time datetime='2026-04-28'>April 28, 2026</time>
        </p>
      </div>
    </section>

    <!-- Stats Section -->
    <section class='py-12 px-4'>
      <div class='container mx-auto max-w-7xl'>
        <div class='grid grid-cols-2 md:grid-cols-4 gap-6'>
          <div
            class='bg-white/5 backdrop-blur-sm rounded-2xl p-6 border border-white/10 text-center'>
            <div class='text-3xl md:text-4xl font-bold text-blue-400 mb-2'>
              {t('about.stat_traders_value')}
            </div>
            <div class='text-gray-400 text-sm'>
              {t('about.stat_traders_label')}
            </div>
          </div>
          <div
            class='bg-white/5 backdrop-blur-sm rounded-2xl p-6 border border-white/10 text-center'>
            <div class='text-3xl md:text-4xl font-bold text-green-400 mb-2'>
              {t('about.stat_trades_value')}
            </div>
            <div class='text-gray-400 text-sm'>
              {t('about.stat_trades_label')}
            </div>
          </div>
          <div
            class='bg-white/5 backdrop-blur-sm rounded-2xl p-6 border border-white/10 text-center'>
            <div class='text-3xl md:text-4xl font-bold text-purple-400 mb-2'>
              {t('about.stat_propfirms_value')}
            </div>
            <div class='text-gray-400 text-sm'>
              {t('about.stat_propfirms_label')}
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Our Story -->
    <section class='py-16 px-4 border-t border-blue-900/30'>
      <div class='container mx-auto max-w-7xl'>
        <div class='grid lg:grid-cols-2 gap-12 items-center'>
          <div>
            <span
              class='inline-block px-4 py-2 bg-blue-600/20 text-blue-400 rounded-full text-sm font-semibold mb-4 border border-blue-500/30'
              >{t('about.story_badge')}</span
            >
            <h2 class='text-3xl md:text-4xl font-bold text-white mb-6'>
              {t('about.story_title')}
            </h2>
            <div class='space-y-4 text-gray-300 leading-relaxed'>
              <p>{t('about.story_p1')}</p>
              <p>{t('about.story_p2')}</p>
              <p>{t('about.story_p3')}</p>
            </div>
          </div>
          <div class='space-y-6'>
            <div
              class='bg-white/5 backdrop-blur-sm rounded-xl p-6 border border-white/10'>
              <div class='flex items-start gap-4'>
                <div
                  class='w-12 h-12 bg-gradient-to-br from-blue-600 to-blue-700 rounded-lg flex items-center justify-center flex-shrink-0'>
                  <i class='fas fa-bolt text-white text-xl'></i>
                </div>
                <div>
                  <h3 class='text-white font-bold text-lg mb-2'>
                    {t('about.feature_execution_title')}
                  </h3>
                  <p class='text-gray-400 text-sm'>
                    {t('about.feature_execution_desc')}
                  </p>
                </div>
              </div>
            </div>
            <div
              class='bg-white/5 backdrop-blur-sm rounded-xl p-6 border border-white/10'>
              <div class='flex items-start gap-4'>
                <div
                  class='w-12 h-12 bg-gradient-to-br from-green-600 to-green-700 rounded-lg flex items-center justify-center flex-shrink-0'>
                  <i class='fas fa-shield-halved text-white text-xl'></i>
                </div>
                <div>
                  <h3 class='text-white font-bold text-lg mb-2'>
                    {t('about.feature_security_title')}
                  </h3>
                  <p class='text-gray-400 text-sm'>
                    {t('about.feature_security_desc')}
                  </p>
                </div>
              </div>
            </div>
            <div
              class='bg-white/5 backdrop-blur-sm rounded-xl p-6 border border-white/10'>
              <div class='flex items-start gap-4'>
                <div
                  class='w-12 h-12 bg-gradient-to-br from-purple-600 to-purple-700 rounded-lg flex items-center justify-center flex-shrink-0'>
                  <i class='fas fa-users text-white text-xl'></i>
                </div>
                <div>
                  <h3 class='text-white font-bold text-lg mb-2'>
                    {t('about.feature_community_title')}
                  </h3>
                  <p class='text-gray-400 text-sm'>
                    {t('about.feature_community_desc')}
                  </p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Mission Section -->
    <section class='py-16 px-4 border-t border-blue-900/30'>
      <div class='container mx-auto max-w-7xl text-center'>
        <span
          class='inline-block px-4 py-2 bg-green-600/20 text-green-400 rounded-full text-sm font-semibold mb-4 border border-green-500/30'
          >{t('about.mission_badge')}</span
        >
        <h2 class='text-3xl md:text-4xl font-bold text-white mb-6'>
          {t('about.mission_title')}
        </h2>
        <p
          class='text-xl text-gray-300 max-w-3xl mx-auto leading-relaxed mb-12'>
          {t('about.mission_subtitle')}
        </p>
        <div class='grid md:grid-cols-3 gap-8'>
          <div
            class='bg-white/5 backdrop-blur-sm rounded-xl p-8 border border-white/10'>
            <div
              class='w-14 h-14 bg-gradient-to-br from-blue-600 to-blue-700 rounded-xl flex items-center justify-center mx-auto mb-4'>
              <i class='fas fa-code text-white text-xl'></i>
            </div>
            <h3 class='text-white font-bold text-lg mb-3'>
              {t('about.mission_no_code_title')}
            </h3>
            <p class='text-gray-400 text-sm leading-relaxed'>
              {t('about.mission_no_code_desc')}
            </p>
          </div>
          <div
            class='bg-white/5 backdrop-blur-sm rounded-xl p-8 border border-white/10'>
            <div
              class='w-14 h-14 bg-gradient-to-br from-green-600 to-green-700 rounded-xl flex items-center justify-center mx-auto mb-4'>
              <i class='fas fa-dollar-sign text-white text-xl'></i>
            </div>
            <h3 class='text-white font-bold text-lg mb-3'>
              {t('about.mission_affordable_title')}
            </h3>
            <p class='text-gray-400 text-sm leading-relaxed'>
              {t('about.mission_affordable_desc')}
            </p>
          </div>
          <div
            class='bg-white/5 backdrop-blur-sm rounded-xl p-8 border border-white/10'>
            <div
              class='w-14 h-14 bg-gradient-to-br from-purple-600 to-purple-700 rounded-xl flex items-center justify-center mx-auto mb-4'>
              <i class='fas fa-headset text-white text-xl'></i>
            </div>
            <h3 class='text-white font-bold text-lg mb-3'>
              {t('about.mission_support_title')}
            </h3>
            <p class='text-gray-400 text-sm leading-relaxed'>
              {t('about.mission_support_desc')}
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- What We Support -->
    <section class='py-16 px-4 border-t border-blue-900/30'>
      <div class='container mx-auto max-w-7xl'>
        <div class='text-center mb-12'>
          <span
            class='inline-block px-4 py-2 bg-yellow-600/20 text-yellow-400 rounded-full text-sm font-semibold mb-4 border border-yellow-500/30'
            >{t('about.platform_badge')}</span
          >
          <h2 class='text-3xl md:text-4xl font-bold text-white mb-4'>
            {t('about.platform_title')}
          </h2>
          <p class='text-gray-300 text-lg max-w-2xl mx-auto'>
            {t('about.platform_subtitle')}
          </p>
        </div>
        <div class='grid md:grid-cols-2 gap-8'>
          <div
            class='bg-white/5 backdrop-blur-sm rounded-xl p-6 border border-white/10'>
            <h3 class='text-white font-bold text-lg mb-4'>
              <i class='fas fa-chart-line text-blue-400 mr-2'></i>{
                t('about.platform_brokers_heading')
              }
            </h3>
            <ul class='space-y-2 text-gray-300'>
              <li class='flex items-center gap-2'>
                <i class='fas fa-check text-green-400 text-sm'></i>
                {t('about.platform_broker_1')}
              </li>
              <li class='flex items-center gap-2'>
                <i class='fas fa-check text-green-400 text-sm'></i>
                {t('about.platform_broker_2')}
              </li>
              <li class='flex items-center gap-2'>
                <i class='fas fa-check text-green-400 text-sm'></i>
                {t('about.platform_broker_3')}
              </li>
              <li class='flex items-center gap-2'>
                <i class='fas fa-check text-green-400 text-sm'></i>
                {t('about.platform_broker_4')}
              </li>
              <li class='flex items-center gap-2'>
                <i class='fas fa-check text-green-400 text-sm'></i>
                {t('about.platform_broker_5')}
              </li>
              <li class='flex items-center gap-2'>
                <i class='fas fa-check text-green-400 text-sm'></i>
                ProjectX
              </li>
              <li class='flex items-center gap-2'>
                <i class='fas fa-check text-green-400 text-sm'></i>
                Match-Trader
              </li>
              <li class='flex items-center gap-2'>
                <i class='fas fa-check text-green-400 text-sm'></i>
                Tradier (Beta)
              </li>
              <li class='flex items-center gap-2'>
                <i class='fas fa-check text-green-400 text-sm'></i>
                cTrader (Beta)
              </li>
              <li class='flex items-center gap-2'>
                <i class='fas fa-check text-green-400 text-sm'></i>
                Ironbeam (Beta)
              </li>
            </ul>
          </div>
          <div
            class='bg-white/5 backdrop-blur-sm rounded-xl p-6 border border-white/10'>
            <h3 class='text-white font-bold text-lg mb-4'>
              <i class='fas fa-building text-purple-400 mr-2'></i>{
                t('about.platform_propfirms_heading')
              }
            </h3>
            <ul class='space-y-2 text-gray-300'>
              <li class='flex items-center gap-2'>
                <i class='fas fa-check text-green-400 text-sm'></i>
                {t('about.platform_propfirm_1')}
              </li>
              <li class='flex items-center gap-2'>
                <i class='fas fa-check text-green-400 text-sm'></i>
                {t('about.platform_propfirm_2')}
              </li>
              <li class='flex items-center gap-2'>
                <i class='fas fa-check text-green-400 text-sm'></i>
                {t('about.platform_propfirm_3')}
              </li>
              <li class='flex items-center gap-2'>
                <i class='fas fa-check text-green-400 text-sm'></i>
                {t('about.platform_propfirm_4')}
              </li>
              <li class='flex items-center gap-2'>
                <i class='fas fa-check text-green-400 text-sm'></i>
                <a
                  href={localizedPath(locale, 'supported-propfirms')}
                  class='text-blue-400 hover:text-blue-300 underline'
                  >{t('about.propfirms_link_text')}</a>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class='py-16 px-4 border-t border-blue-900/30'>
      <div class='container mx-auto max-w-4xl text-center'>
        <div
          class='bg-gradient-to-r from-blue-600/20 to-purple-600/20 rounded-3xl p-12 border border-blue-500/30'>
          <h2 class='text-3xl font-bold text-white mb-4'>
            {t('about.cta_title')}
          </h2>
          <p class='text-gray-300 mb-8 max-w-2xl mx-auto'>
            {t('about.cta_subtitle')}
          </p>
          <div class='flex flex-col sm:flex-row justify-center gap-4'>
            <a
              href='https://app.pickmytrade.trade/?register=true'
              class='electrolize-regular inline-flex items-center justify-center gap-2 px-8 py-4 bg-gradient-to-r from-blue-600 to-blue-700 hover:from-blue-700 hover:to-blue-800 text-white rounded-xl font-bold transition-all transform hover:scale-105 shadow-xl'>
              <i class='fas fa-rocket'></i>
              {t('about.cta_primary')}
            </a>
            <a
              href={localizedPath(locale, 'pages/contact-us')}
              class='electrolize-regular inline-flex items-center justify-center gap-2 px-8 py-4 bg-white/10 hover:bg-white/20 text-white rounded-xl font-bold border border-white/20'>
              <i class='fas fa-envelope'></i>
              {t('about.cta_secondary')}
            </a>
          </div>
          <p class='text-sm text-gray-400 mt-6'>
            <!-- email_off: see Footer.astro — keeps Cloudflare from
                 rewriting this into a JS-decoded placeholder. -->
            <!--email_off-->
            {t('about.founder_contact_pre')}<a
              href='mailto:support@pickmytrade.com'
              class='text-blue-400 hover:text-blue-300 underline'
              >support@pickmytrade.com</a
            >{t('about.founder_contact_post')}
            <!--email_on-->
          </p>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
