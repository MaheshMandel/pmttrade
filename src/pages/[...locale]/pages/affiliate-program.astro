---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getLocalePaths, useTranslations, localizedPath } from '../../../i18n/utils';
import type { Locale } from '../../../i18n/config';

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };
const t = useTranslations(locale);

const SITE_URL = 'https://pickmytrade.trade';
const withSlash = (p: string) => (p.endsWith('/') ? p : `${p}/`);

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  'itemListElement': [
    { '@type': 'ListItem', 'position': 1, 'name': 'Home', 'item': `${SITE_URL}${withSlash(localizedPath(locale))}` },
    { '@type': 'ListItem', 'position': 2, 'name': 'Affiliate Program', 'item': `${SITE_URL}${withSlash(localizedPath(locale, 'pages/affiliate-program'))}` },
  ],
};
---

<BaseLayout
  locale={locale}
  title={t('affiliate.meta_title')}
  description={t('affiliate.meta_description')}
  ldJson={[breadcrumbSchema]}>
  <style>
    .shine-text {
      background: linear-gradient(90deg, #32c6fc, #80e8ff, #32c6fc);
      background-size: 200% auto;
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      animation: shine 3s linear infinite;
    }
    @keyframes shine {
      to {
        background-position: 200% center;
      }
    }
    .card-hover {
      transition:
        transform 0.3s ease,
        box-shadow 0.3s ease;
    }
    .card-hover:hover {
      transform: translateY(-6px);
      box-shadow: 0 20px 40px rgba(0, 87, 168, 0.25);
    }
    .step-connector {
      display: none;
    }
    @media (min-width: 768px) {
      .step-connector {
        display: block;
      }
    }
    #affiliateModal:not(.hidden),
    #contactModal:not(.hidden) {
      display: flex;
    }
  </style>

  <!-- HERO SECTION -->
  <section
    class='relative pt-32 pb-24 px-6 bg-linear-to-b from-[#000d1a] via-[#001429] to-[#001d38] flex flex-col justify-center items-center text-center overflow-hidden'>
    <!-- Background glow blobs -->
    <div
      class='absolute top-20 left-1/4 w-96 h-96 bg-[#0057A8]/20 rounded-full blur-3xl pointer-events-none'>
    </div>
    <div
      class='absolute bottom-10 right-1/4 w-80 h-80 bg-[#32C6FC]/10 rounded-full blur-3xl pointer-events-none'>
    </div>

    <p
      class='text-sm bg-[#0084d1]/30 border border-[#0084d1]/40 px-4 py-1.5 rounded-full font-semibold inline-block mb-6 text-[#32C6FC] tracking-wide uppercase'>
      {t('affiliate.hero_badge')}
    </p>
    <h1
      class='text-4xl sm:text-6xl font-extrabold leading-tight mb-6 max-w-5xl text-white'>
      {t('affiliate.hero_title_pre')}
      <span class='shine-text'>{t('affiliate.hero_title_highlight')}</span>
      {t('affiliate.hero_title_post')}
    </h1>
    <p class='max-w-2xl mx-auto text-gray-400 text-lg leading-relaxed mb-10'>
      {t('affiliate.hero_subtitle')}
    </p>

    <div class='flex flex-col sm:flex-row gap-4 justify-center'>
      <a
        href='https://app.pickmytrade.trade/?register=true'
        target='_blank'
        class='bg-[#0057A8] hover:bg-[#004080] text-white font-bold py-3 px-8 rounded-full shadow-lg transition-all duration-300 text-base'>
        {t('affiliate.hero_cta_primary')}
      </a>
      <a
        href='#how-it-works'
        class='border border-white/20 hover:border-white/40 text-white font-semibold py-3 px-8 rounded-full transition-all duration-300 text-base backdrop-blur-sm'>
        {t('affiliate.hero_cta_secondary')}
      </a>
    </div>
  </section>

  <!-- PROGRAM OPTIONS -->
  <section class='py-24 bg-[#001429] text-center'>
    <p
      class='text-sm bg-[#0084d1]/30 border border-[#0084d1]/40 px-4 py-1.5 rounded-full font-semibold inline-block mb-4 text-[#32C6FC] tracking-wide uppercase'>
      {t('affiliate.programs_badge')}
    </p>
    <h2
      class='text-4xl sm:text-5xl font-extrabold mb-4 text-white tracking-tight'>
      {t('affiliate.programs_title')}
    </h2>
    <p class='text-gray-400 mb-16 max-w-xl mx-auto'>
      {t('affiliate.programs_subtitle')}
    </p>

    <div
      class='flex flex-col md:flex-row justify-center gap-8 px-6 max-w-7xl mx-auto'>
      <!-- Affiliate Card -->
      <div
        class='card-hover bg-linear-to-br from-[#001d38] to-[#002a50] border border-[#0057A8]/40 text-white p-10 rounded-2xl shadow-xl flex-1 flex flex-col items-center text-center'>
        <div
          class='w-16 h-16 rounded-2xl bg-[#0057A8]/20 flex items-center justify-center mb-6'>
          <i
            class='fa-solid fa-users text-[32px] text-[#32C6FC]' aria-hidden='true'
          ></i>
        </div>
        <h3 class='text-2xl font-bold mb-2 text-white'>
          {t('affiliate.card_affiliate_title')}
        </h3>
        <p
          class='text-xs text-[#32C6FC] font-semibold uppercase tracking-widest mb-5'>
          {t('affiliate.card_affiliate_badge')}
        </p>
        <p class='mb-8 leading-relaxed text-gray-400 text-sm flex-1'>
          {t('affiliate.card_affiliate_desc')}
        </p>
        <button
          id='openAffiliateBtn'
          class='w-full bg-[#0057A8] hover:bg-[#004080] text-white px-8 py-3 rounded-xl font-semibold shadow-md transition-all duration-300'>
          {t('affiliate.card_affiliate_cta')}
        </button>
      </div>

      <!-- Partner Card -->
      <div
        class='card-hover bg-linear-to-br from-[#001d38] to-[#002a50] border border-[#33B5FF]/40 text-white p-10 rounded-2xl shadow-xl flex-1 flex flex-col items-center text-center'>
        <div
          class='w-16 h-16 rounded-2xl bg-[#33B5FF]/20 flex items-center justify-center mb-6'>
          <i
            class='fa-solid fa-handshake text-[32px] text-[#33B5FF]' aria-hidden='true'
          ></i>
        </div>
        <h3 class='text-2xl font-bold mb-2 text-white'>
          {t('affiliate.card_partner_title')}
        </h3>
        <p
          class='text-xs text-[#33B5FF] font-semibold uppercase tracking-widest mb-5'>
          {t('affiliate.card_partner_badge')}
        </p>
        <p class='mb-8 leading-relaxed text-gray-400 text-sm flex-1'>
          {t('affiliate.card_partner_desc')}
        </p>
        <button
          id='openModalBtn'
          class='w-full bg-[#33B5FF] hover:bg-[#1A9FFF] text-white px-8 py-3 rounded-xl font-semibold shadow-md transition-all duration-300'>
          {t('affiliate.card_partner_cta')}
        </button>
      </div>
    </div>
  </section>

  <!-- BENEFITS -->
  <section class='py-24 bg-[#000d1a] text-center'>
    <p
      class='text-sm bg-[#0084d1]/30 border border-[#0084d1]/40 px-4 py-1.5 rounded-full font-semibold inline-block mb-4 text-[#32C6FC] tracking-wide uppercase'>
      {t('affiliate.benefits_badge')}
    </p>
    <h2 class='text-4xl font-bold mb-4 text-white'>
      {t('affiliate.benefits_title')}
    </h2>
    <p class='text-gray-400 mb-16 max-w-xl mx-auto'>
      {t('affiliate.benefits_subtitle')}
    </p>

    <div class='grid grid-cols-1 md:grid-cols-3 gap-6 px-6 max-w-7xl mx-auto'>
      <div
        class='card-hover bg-[#001d38] border border-[#50D32C]/20 p-8 rounded-2xl shadow-lg flex flex-col items-center text-center'>
        <div
          class='w-14 h-14 rounded-2xl mb-5 bg-[#CDFAAB]/10 flex items-center justify-center'>
          <i
            class='fa-solid fa-dollar-sign text-[28px] text-[#50D32C]' aria-hidden='true'
          ></i>
        </div>
        <h3 class='text-lg font-bold mb-3 text-white'>
          {t('affiliate.benefit_1_title')}
        </h3>
        <p class='text-gray-400 text-sm leading-relaxed'>
          {t('affiliate.benefit_1_desc')}
        </p>
      </div>

      <div
        class='card-hover bg-[#001d38] border border-[#206AFC]/20 p-8 rounded-2xl shadow-lg flex flex-col items-center text-center'>
        <div
          class='w-14 h-14 rounded-2xl mb-5 bg-[#A5CCFE]/10 flex items-center justify-center'>
          <i
            class='fa-solid fa-cookie-bite text-[28px] text-[#206AFC]' aria-hidden='true'
          ></i>
        </div>
        <h3 class='text-lg font-bold mb-3 text-white'>
          {t('affiliate.benefit_2_title')}
        </h3>
        <p class='text-gray-400 text-sm leading-relaxed'>
          {t('affiliate.benefit_2_desc')}
        </p>
      </div>

      <div
        class='card-hover bg-[#001d38] border border-[#a102f4]/20 p-8 rounded-2xl shadow-lg flex flex-col items-center text-center'>
        <div
          class='w-14 h-14 rounded-2xl mb-5 bg-[#EE99FD]/10 flex items-center justify-center'>
          <i
            class='fa-solid fa-infinity text-[28px] text-[#a102f4]' aria-hidden='true'
          ></i>
        </div>
        <h3 class='text-lg font-bold mb-3 text-white'>
          {t('affiliate.benefit_3_title')}
        </h3>
        <p class='text-gray-400 text-sm leading-relaxed'>
          {t('affiliate.benefit_3_desc')}
        </p>
      </div>
    </div>
  </section>

  <!-- GET STARTED -->
  <section
    id='how-it-works'
    class='py-24 bg-linear-to-b from-[#001429] to-[#001d38] text-center'>
    <p
      class='text-sm bg-[#0084d1]/30 border border-[#0084d1]/40 px-4 py-1.5 rounded-full font-semibold inline-block mb-4 text-[#32C6FC] tracking-wide uppercase'>
      {t('affiliate.steps_badge')}
    </p>
    <h2 class='text-4xl font-bold mb-4 text-white'>
      {t('affiliate.steps_title')}
    </h2>
    <p class='text-gray-400 mb-16 max-w-xl mx-auto'>
      {t('affiliate.steps_subtitle')}
    </p>

    <div
      class='grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6 px-6 max-w-7xl mx-auto mb-20'>
      <div
        class='card-hover bg-[#001d38] border border-white/10 p-7 rounded-2xl shadow-lg flex flex-col items-center text-center'>
        <div
          class='w-12 h-12 rounded-xl mb-4 bg-blue-500/20 flex items-center justify-center'>
          <i
            class='fa-solid fa-right-to-bracket text-[24px] text-blue-400' aria-hidden='true'
          ></i>
        </div>
        <span
          class='text-xs font-bold text-blue-400 uppercase tracking-widest mb-2'
          >{t('affiliate.step_1_badge')}</span
        >
        <h3 class='text-base font-bold mb-2 text-white'>
          {t('affiliate.step_1_title')}
        </h3>
        <p class='text-gray-400 text-sm'>{t('affiliate.step_1_desc')}</p>
      </div>

      <div
        class='card-hover bg-[#001d38] border border-white/10 p-7 rounded-2xl shadow-lg flex flex-col items-center text-center'>
        <div
          class='w-12 h-12 rounded-xl mb-4 bg-purple-500/20 flex items-center justify-center'>
          <i
            class='fa-solid fa-link text-[24px] text-purple-400' aria-hidden='true'
          ></i>
        </div>
        <span
          class='text-xs font-bold text-purple-400 uppercase tracking-widest mb-2'
          >{t('affiliate.step_2_badge')}</span
        >
        <h3 class='text-base font-bold mb-2 text-white'>
          {t('affiliate.step_2_title')}
        </h3>
        <p class='text-gray-400 text-sm'>{t('affiliate.step_2_desc')}</p>
      </div>

      <div
        class='card-hover bg-[#001d38] border border-white/10 p-7 rounded-2xl shadow-lg flex flex-col items-center text-center'>
        <div
          class='w-12 h-12 rounded-xl mb-4 bg-pink-500/20 flex items-center justify-center'>
          <i
            class='fa-solid fa-paper-plane text-[24px] text-pink-400' aria-hidden='true'
          ></i>
        </div>
        <span
          class='text-xs font-bold text-pink-400 uppercase tracking-widest mb-2'
          >{t('affiliate.step_3_badge')}</span
        >
        <h3 class='text-base font-bold mb-2 text-white'>
          {t('affiliate.step_3_title')}
        </h3>
        <p class='text-gray-400 text-sm'>{t('affiliate.step_3_desc')}</p>
      </div>

      <div
        class='card-hover bg-[#001d38] border border-white/10 p-7 rounded-2xl shadow-lg flex flex-col items-center text-center'>
        <div
          class='w-12 h-12 rounded-xl mb-4 bg-yellow-500/20 flex items-center justify-center'>
          <i
            class='fa-solid fa-chart-column text-[24px] text-yellow-400' aria-hidden='true'
          ></i>
        </div>
        <span
          class='text-xs font-bold text-yellow-400 uppercase tracking-widest mb-2'
          >{t('affiliate.step_4_badge')}</span
        >
        <h3 class='text-base font-bold mb-2 text-white'>
          {t('affiliate.step_4_title')}
        </h3>
        <p class='text-gray-400 text-sm'>{t('affiliate.step_4_desc')}</p>
      </div>

      <div
        class='card-hover bg-[#001d38] border border-white/10 p-7 rounded-2xl shadow-lg flex flex-col items-center text-center'>
        <div
          class='w-12 h-12 rounded-xl mb-4 bg-green-500/20 flex items-center justify-center'>
          <i
            class='fa-solid fa-dollar-sign text-[24px] text-green-400' aria-hidden='true'
          ></i>
        </div>
        <span
          class='text-xs font-bold text-green-400 uppercase tracking-widest mb-2'
          >{t('affiliate.step_5_badge')}</span
        >
        <h3 class='text-base font-bold mb-2 text-white'>
          {t('affiliate.step_5_title')}
        </h3>
        <p class='text-gray-400 text-sm'>{t('affiliate.step_5_desc')}</p>
      </div>

      <div
        class='card-hover bg-[#001d38] border border-white/10 p-7 rounded-2xl shadow-lg flex flex-col items-center text-center'>
        <div
          class='w-12 h-12 rounded-xl mb-4 bg-indigo-500/20 flex items-center justify-center'>
          <i
            class='fa-solid fa-award text-[24px] text-indigo-400' aria-hidden='true'
          ></i>
        </div>
        <span
          class='text-xs font-bold text-indigo-400 uppercase tracking-widest mb-2'
          >{t('affiliate.step_6_badge')}</span
        >
        <h3 class='text-base font-bold mb-2 text-white'>
          {t('affiliate.step_6_title')}
        </h3>
        <p class='text-gray-400 text-sm'>{t('affiliate.step_6_desc')}</p>
      </div>
    </div>

    <!-- CTA Section -->
    <div
      class='relative bg-linear-to-r from-[#001d38] to-[#002a50] border border-[#0057A8]/40 rounded-2xl py-14 px-8 flex flex-col items-center max-w-3xl mx-auto overflow-hidden'>
      <div
        class='absolute top-0 right-0 w-60 h-60 bg-[#0057A8]/10 rounded-full blur-3xl pointer-events-none -translate-y-1/2 translate-x-1/2'>
      </div>
      <h2 class='text-3xl font-extrabold mb-3 text-center text-white'>
        {t('affiliate.cta_title')}
      </h2>
      <p class='text-base mb-8 text-center text-gray-400 max-w-lg'>
        {t('affiliate.cta_subtitle')}
      </p>
      <a
        href='https://app.pickmytrade.io/?register=true'
        target='_blank'
        class='bg-[#0057A8] hover:bg-[#004080] text-white font-bold py-3.5 px-10 rounded-full shadow-lg transition-all duration-300 text-base'>
        {t('affiliate.cta_btn')}
      </a>
    </div>
  </section>

  <!-- AFFILIATE MODAL -->
  <div
    id='affiliateModal'
    class='fixed inset-0 z-50 items-center justify-center bg-black/60 backdrop-blur-sm hidden'>
    <div
      class='bg-[#001d38] border border-[#0057A8]/40 rounded-2xl shadow-2xl p-8 max-w-md w-full mx-4 text-center relative'>
      <button
        id='closeModalBtn'
        class='absolute top-4 right-4 text-gray-400 hover:text-white transition-colors w-8 h-8 flex items-center justify-center rounded-full hover:bg-white/10'>
        <i
          class='fa-solid fa-xmark text-[20px]' aria-hidden='true'
        ></i>
      </button>
      <div
        class='w-14 h-14 rounded-2xl bg-[#0057A8]/20 flex items-center justify-center mx-auto mb-5'>
        <i
          class='fa-solid fa-users text-[28px] text-[#32C6FC]' aria-hidden='true'
        ></i>
      </div>
      <h4 class='text-2xl font-bold mb-2 text-white'>
        {t('affiliate.modal_affiliate_title')}
      </h4>
      <p class='mb-6 text-gray-400 text-sm leading-relaxed'>
        {t('affiliate.modal_affiliate_desc')}
      </p>
      <div class='flex flex-col sm:flex-row gap-3 justify-center'>
        <button
          id='signUpBtn'
          class='flex-1 bg-[#0057A8] hover:bg-[#004080] text-white px-6 py-2.5 rounded-xl font-semibold shadow transition-all duration-200'>
          {t('affiliate.modal_affiliate_signup')}
        </button>
        <button
          id='viewDocsBtn'
          class='flex-1 border border-[#0057A8]/50 hover:border-[#0057A8] text-[#32C6FC] px-6 py-2.5 rounded-xl font-semibold transition-all duration-200'>
          {t('affiliate.modal_affiliate_docs')}
        </button>
      </div>
    </div>
  </div>

  <!-- CONTACT MODAL -->
  <div
    id='contactModal'
    class='fixed inset-0 z-50 items-center justify-center bg-black/60 backdrop-blur-sm hidden'>
    <div
      class='bg-[#001d38] border border-[#33B5FF]/40 rounded-2xl shadow-2xl p-8 max-w-md w-full mx-4 text-center relative'>
      <button
        id='closeContactModalBtn'
        class='absolute top-4 right-4 text-gray-400 hover:text-white transition-colors w-8 h-8 flex items-center justify-center rounded-full hover:bg-white/10'>
        <i
          class='fa-solid fa-xmark text-[20px]' aria-hidden='true'
        ></i>
      </button>
      <div
        class='w-14 h-14 rounded-2xl bg-[#33B5FF]/20 flex items-center justify-center mx-auto mb-5'>
        <i
          class='fa-solid fa-envelope text-[28px] text-[#33B5FF]' aria-hidden='true'
        ></i>
      </div>
      <h4 class='text-2xl font-bold mb-2 text-white'>
        {t('affiliate.modal_contact_title')}
      </h4>
      <p class='mb-5 text-gray-400 text-sm leading-relaxed'>
        {t('affiliate.modal_contact_desc')}
      </p>
      <div class='mb-6'>
        <a
          href='mailto:support@pickmytrade.com'
          class='inline-block bg-[#001429] border border-[#33B5FF]/30 text-[#33B5FF] px-4 py-2 rounded-xl font-mono text-sm hover:border-[#33B5FF]/60 transition-colors'>
          support@pickmytrade.com
        </a>
      </div>
      <button
        id='connectBtn'
        class='w-full bg-[#33B5FF] hover:bg-[#1A9FFF] text-white px-6 py-2.5 rounded-xl font-semibold shadow transition-all duration-200'>
        {t('affiliate.modal_contact_btn')}
      </button>
    </div>
  </div>

  <script>
    document.addEventListener('DOMContentLoaded', function () {
      const partnershipEmail = 'support@pickmytrade.com';

      const openModalBtn = document.getElementById('openModalBtn');
      const contactModal = document.getElementById('contactModal');
      const connectBtn = document.getElementById('connectBtn');
      const closeContactModalBtn = document.getElementById(
        'closeContactModalBtn',
      );
      const closeModalBtn = document.getElementById('closeModalBtn');
      const openAffiliateBtn = document.getElementById('openAffiliateBtn');
      const affiliateModal = document.getElementById('affiliateModal');
      const viewDocsBtn = document.getElementById('viewDocsBtn');
      const signUpBtn = document.getElementById('signUpBtn');

      openModalBtn?.addEventListener('click', () =>
        contactModal?.classList.remove('hidden'),
      );
      openAffiliateBtn?.addEventListener('click', () =>
        affiliateModal?.classList.remove('hidden'),
      );
      closeModalBtn?.addEventListener('click', () =>
        affiliateModal?.classList.add('hidden'),
      );
      closeContactModalBtn?.addEventListener('click', () =>
        contactModal?.classList.add('hidden'),
      );

      affiliateModal?.addEventListener('click', (e) => {
        if (e.target === affiliateModal) affiliateModal.classList.add('hidden');
      });
      contactModal?.addEventListener('click', (e) => {
        if (e.target === contactModal) contactModal.classList.add('hidden');
      });

      connectBtn?.addEventListener('click', () => {
        window.location.href = `mailto:${partnershipEmail}?subject=Partner%20Program%20Inquiry`;
      });
      viewDocsBtn?.addEventListener('click', () => {
        window.open(
          'https://docs.pickmytrade.trade/docs/referral-system/',
          '_blank',
        );
      });
      signUpBtn?.addEventListener('click', () => {
        window.open('https://app.pickmytrade.trade/?register=true');
      });
    });
  </script>
</BaseLayout>
