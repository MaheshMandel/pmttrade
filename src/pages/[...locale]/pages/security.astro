---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getLocalePaths, useTranslations, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };
const t = useTranslations(locale);

const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": `${SITE_URL}${withSlash(localizedPath(locale))}` },
    { "@type": "ListItem", "position": 2, "name": "Security", "item": `${SITE_URL}${withSlash(localizedPath(locale, "pages/security"))}` },
  ],
};
---

<BaseLayout
  locale={locale}
  title={t("security.meta_title")}
  description={t("security.meta_description")}
  ldJson={[breadcrumbSchema]}
>
  <div>
    <!-- Hero -->
    <section class="py-16 lg:py-24 border-b border-blue-900/30 bg-linear-to-b from-[#001429] to-[#002040]">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <span class="electrolize-regular inline-block px-4 py-2 bg-green-600/20 text-green-400 rounded-full text-sm font-semibold mb-4 border border-green-500/30 uppercase">{t("security.hero_badge")}</span>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold text-white mb-6 tracking-tight">{t("security.hero_title")}<br><span class="gradient-text">{t("security.hero_title_highlight")}</span></h1>
        <p class="text-xl md:text-2xl text-gray-300 max-w-3xl mx-auto mb-4">{t("security.hero_subtitle")}</p>
        <p class="text-xs text-white/50 mb-8"><i class="far fa-clock mr-1"></i>{t("security.hero_last_updated")} <time datetime="2026-04-28">April 28, 2026</time></p>
        <div class="flex flex-wrap justify-center gap-3 text-sm">
          <div class="flex items-center gap-2 bg-white/5 border border-white/10 rounded-full px-4 py-2"><i class="fa-solid fa-shield-alt text-green-400"></i><span class="text-gray-300">{t("security.badge_oauth")}</span></div>
          <div class="flex items-center gap-2 bg-white/5 border border-white/10 rounded-full px-4 py-2"><i class="fa-solid fa-lock text-blue-400"></i><span class="text-gray-300">{t("security.badge_encryption")}</span></div>
          <div class="flex items-center gap-2 bg-white/5 border border-white/10 rounded-full px-4 py-2"><i class="fa-solid fa-server text-purple-400"></i><span class="text-gray-300">{t("security.badge_infrastructure")}</span></div>
        </div>
      </div>
    </section>

    <!-- Trust Badges -->
    <section class="py-12 border-b border-gray-800 bg-[#002040]">
      <div class="max-w-7xl mx-auto px-4">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
          <article class="bg-linear-to-br from-gray-800/50 to-gray-900/50 rounded-xl p-6 border border-gray-700/50">
            <div class="text-3xl font-bold text-blue-400 mb-2">{t("security.stat_traders_value")}</div>
            <p class="text-gray-400 text-sm">{t("security.stat_traders_label")}</p>
          </article>
          <article class="bg-linear-to-br from-gray-800/50 to-gray-900/50 rounded-xl p-6 border border-gray-700/50">
            <div class="text-3xl font-bold text-green-400 mb-2">{t("security.stat_trades_value")}</div>
            <p class="text-gray-400 text-sm">{t("security.stat_trades_label")}</p>
          </article>
          <article class="bg-linear-to-br from-gray-800/50 to-gray-900/50 rounded-xl p-6 border border-gray-700/50">
            <div class="text-3xl font-bold text-purple-400 mb-2">{t("security.stat_uptime_value")}</div>
            <p class="text-gray-400 text-sm">{t("security.stat_uptime_label")}</p>
          </article>
          <article class="bg-linear-to-br from-gray-800/50 to-gray-900/50 rounded-xl p-6 border border-gray-700/50">
            <div class="text-3xl font-bold text-yellow-400 mb-2">{t("security.stat_incidents_value")}</div>
            <p class="text-gray-400 text-sm">{t("security.stat_incidents_label")}</p>
          </article>
        </div>
      </div>
    </section>

    <!-- Security Features -->
    <section class="py-16 md:py-24 border-b border-blue-900/30 bg-linear-to-b from-[#002040] to-[#001429]">
      <div class="max-w-7xl mx-auto px-4">
        <div class="text-center mb-12">
          <span class="inline-block px-4 py-2 bg-blue-600/20 text-blue-400 rounded-full text-sm font-semibold mb-4 border border-blue-500/30">{t("security.features_badge")}</span>
          <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">{t("security.features_title")}</h2>
          <p class="text-gray-300 text-lg max-w-2xl mx-auto">{t("security.features_subtitle")}</p>
        </div>
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
          <article class="group bg-linear-to-br from-gray-800/50 to-gray-900/50 rounded-xl p-6 border border-gray-700/50 hover:border-green-500/50 transition-all hover:-translate-y-2">
            <div class="w-14 h-14 bg-green-500/20 rounded-xl flex items-center justify-center mb-4"><i class="fas fa-key text-green-400 text-2xl"></i></div>
            <h3 class="text-xl font-bold text-white mb-2">{t("security.feature_oauth_title")}</h3>
            <p class="text-gray-300">{t("security.feature_oauth_desc")}</p>
          </article>
          <article class="group bg-linear-to-br from-gray-800/50 to-gray-900/50 rounded-xl p-6 border border-gray-700/50 hover:border-blue-500/50 transition-all hover:-translate-y-2">
            <div class="w-14 h-14 bg-blue-500/20 rounded-xl flex items-center justify-center mb-4"><i class="fas fa-lock text-blue-400 text-2xl"></i></div>
            <h3 class="text-xl font-bold text-white mb-2">{t("security.feature_ssl_title")}</h3>
            <p class="text-gray-300">{t("security.feature_ssl_desc")}</p>
          </article>
          <article class="group bg-linear-to-br from-gray-800/50 to-gray-900/50 rounded-xl p-6 border border-gray-700/50 hover:border-purple-500/50 transition-all hover:-translate-y-2">
            <div class="w-14 h-14 bg-purple-500/20 rounded-xl flex items-center justify-center mb-4"><i class="fas fa-user-shield text-purple-400 text-2xl"></i></div>
            <h3 class="text-xl font-bold text-white mb-2">{t("security.feature_no_withdrawal_title")}</h3>
            <p class="text-gray-300">{t("security.feature_no_withdrawal_desc")}</p>
          </article>
          <article class="group bg-linear-to-br from-gray-800/50 to-gray-900/50 rounded-xl p-6 border border-gray-700/50 hover:border-yellow-500/50 transition-all hover:-translate-y-2">
            <div class="w-14 h-14 bg-yellow-500/20 rounded-xl flex items-center justify-center mb-4"><i class="fas fa-cloud text-yellow-400 text-2xl"></i></div>
            <h3 class="text-xl font-bold text-white mb-2">{t("security.feature_cloud_title")}</h3>
            <p class="text-gray-300">{t("security.feature_cloud_desc")}</p>
          </article>
          <article class="group bg-linear-to-br from-gray-800/50 to-gray-900/50 rounded-xl p-6 border border-gray-700/50 hover:border-red-500/50 transition-all hover:-translate-y-2">
            <div class="w-14 h-14 bg-red-500/20 rounded-xl flex items-center justify-center mb-4"><i class="fas fa-fire-alt text-red-400 text-2xl"></i></div>
            <h3 class="text-xl font-bold text-white mb-2">{t("security.feature_firewall_title")}</h3>
            <p class="text-gray-300">{t("security.feature_firewall_desc")}</p>
          </article>
          <article class="group bg-linear-to-br from-gray-800/50 to-gray-900/50 rounded-xl p-6 border border-gray-700/50 hover:border-indigo-500/50 transition-all hover:-translate-y-2">
            <div class="w-14 h-14 bg-indigo-500/20 rounded-xl flex items-center justify-center mb-4"><i class="fas fa-history text-indigo-400 text-2xl"></i></div>
            <h3 class="text-xl font-bold text-white mb-2">{t("security.feature_audit_title")}</h3>
            <p class="text-gray-300">{t("security.feature_audit_desc")}</p>
          </article>
        </div>
      </div>
    </section>

    <!-- OAuth Explanation -->
    <section class="py-16 md:py-24 border-b border-gray-800 bg-[#001429]">
      <div class="max-w-7xl mx-auto px-4">
        <div class="grid md:grid-cols-2 gap-12 items-center">
          <div>
            <span class="inline-block px-4 py-2 bg-green-600/20 text-green-400 rounded-full text-sm font-semibold mb-4 border border-green-500/30">{t("security.oauth_badge")}</span>
            <h2 class="text-3xl md:text-4xl font-bold text-white mb-6">{t("security.oauth_title")}</h2>
            <p class="text-gray-300 mb-4">{t("security.oauth_p1")}</p>
            <p class="text-gray-300 mb-4"><strong class="text-white">{t("security.oauth_p2_pre")}</strong>{t("security.oauth_p2_post")}</p>
            <ul class="space-y-3">
              <li class="flex items-start gap-3"><i class="fas fa-check-circle text-green-400 mt-1"></i><span class="text-gray-300">{t("security.oauth_li1")}</span></li>
              <li class="flex items-start gap-3"><i class="fas fa-check-circle text-green-400 mt-1"></i><span class="text-gray-300">{t("security.oauth_li2")}</span></li>
              <li class="flex items-start gap-3"><i class="fas fa-check-circle text-green-400 mt-1"></i><span class="text-gray-300">{t("security.oauth_li3")}</span></li>
              <li class="flex items-start gap-3"><i class="fas fa-check-circle text-green-400 mt-1"></i><span class="text-gray-300">{t("security.oauth_li4")}</span></li>
            </ul>
          </div>
          <div class="bg-linear-to-br from-gray-800/50 to-gray-900/50 rounded-2xl p-8 border border-gray-700/50">
            <div class="text-center mb-6"><i class="fas fa-shield-alt text-green-400 text-5xl"></i></div>
            <h3 class="text-xl font-bold text-white text-center mb-4">{t("security.token_can_title")}</h3>
            <ul class="space-y-2 mb-6">
              <li class="flex items-center gap-3 text-green-400"><i class="fas fa-check"></i><span>{t("security.token_can_1")}</span></li>
              <li class="flex items-center gap-3 text-green-400"><i class="fas fa-check"></i><span>{t("security.token_can_2")}</span></li>
              <li class="flex items-center gap-3 text-green-400"><i class="fas fa-check"></i><span>{t("security.token_can_3")}</span></li>
              <li class="flex items-center gap-3 text-green-400"><i class="fas fa-check"></i><span>{t("security.token_can_4")}</span></li>
            </ul>
            <h3 class="text-xl font-bold text-white text-center mb-4">{t("security.token_cannot_title")}</h3>
            <ul class="space-y-2">
              <li class="flex items-center gap-3 text-red-400"><i class="fas fa-times"></i><span>{t("security.token_cannot_1")}</span></li>
              <li class="flex items-center gap-3 text-red-400"><i class="fas fa-times"></i><span>{t("security.token_cannot_2")}</span></li>
              <li class="flex items-center gap-3 text-red-400"><i class="fas fa-times"></i><span>{t("security.token_cannot_3")}</span></li>
              <li class="flex items-center gap-3 text-red-400"><i class="fas fa-times"></i><span>{t("security.token_cannot_4")}</span></li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- Data Privacy -->
    <section class="py-16 md:py-24 border-b border-blue-900/30 bg-linear-to-b from-[#001429] to-[#002040]">
      <div class="max-w-7xl mx-auto px-4">
        <div class="text-center mb-12">
          <span class="inline-block px-4 py-2 bg-blue-600/20 text-blue-400 rounded-full text-sm font-semibold mb-4 border border-blue-500/30">{t("security.privacy_badge")}</span>
          <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">{t("security.privacy_title")}</h2>
        </div>
        <div class="grid md:grid-cols-2 gap-8">
          <article class="bg-linear-to-br from-gray-800/50 to-gray-900/50 rounded-xl p-8 border border-gray-700/50">
            <h3 class="text-xl font-bold text-white mb-4"><i class="fas fa-database text-blue-400 mr-2"></i>{t("security.store_title")}</h3>
            <ul class="space-y-3 text-gray-300">
              <li class="flex items-start gap-3"><i class="fas fa-circle text-blue-400 text-xs mt-2"></i><span>{t("security.store_li1")}</span></li>
              <li class="flex items-start gap-3"><i class="fas fa-circle text-blue-400 text-xs mt-2"></i><span>{t("security.store_li2")}</span></li>
              <li class="flex items-start gap-3"><i class="fas fa-circle text-blue-400 text-xs mt-2"></i><span>{t("security.store_li3")}</span></li>
              <li class="flex items-start gap-3"><i class="fas fa-circle text-blue-400 text-xs mt-2"></i><span>{t("security.store_li4")}</span></li>
            </ul>
          </article>
          <article class="bg-linear-to-br from-gray-800/50 to-gray-900/50 rounded-xl p-8 border border-gray-700/50">
            <h3 class="text-xl font-bold text-white mb-4"><i class="fas fa-ban text-red-400 mr-2"></i>{t("security.never_store_title")}</h3>
            <ul class="space-y-3 text-gray-300">
              <li class="flex items-start gap-3"><i class="fas fa-times text-red-400 mt-1"></i><span>{t("security.never_store_li1")}</span></li>
              <li class="flex items-start gap-3"><i class="fas fa-times text-red-400 mt-1"></i><span>{t("security.never_store_li2")}</span></li>
              <li class="flex items-start gap-3"><i class="fas fa-times text-red-400 mt-1"></i><span>{t("security.never_store_li3")}</span></li>
              <li class="flex items-start gap-3"><i class="fas fa-times text-red-400 mt-1"></i><span>{t("security.never_store_li4")}</span></li>
            </ul>
          </article>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="py-16 md:py-24 border-b border-gray-800 bg-[#002040]">
      <div class="max-w-4xl mx-auto px-4">
        <div class="text-center mb-12">
          <span class="inline-block px-4 py-2 bg-blue-600/20 text-blue-400 rounded-full text-sm font-semibold mb-4 border border-blue-500/30">{t("security.faq_badge")}</span>
          <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">{t("security.faq_title")}</h2>
        </div>
        <div class="space-y-4">
          <article class="bg-linear-to-br from-gray-800/50 to-gray-900/50 rounded-xl p-6 border border-gray-700/50">
            <h3 class="text-lg font-bold text-white mb-2">{t("security.faq_1_q")}</h3>
            <p class="text-gray-300">{t("security.faq_1_a")}</p>
          </article>
          <article class="bg-linear-to-br from-gray-800/50 to-gray-900/50 rounded-xl p-6 border border-gray-700/50">
            <h3 class="text-lg font-bold text-white mb-2">{t("security.faq_2_q")}</h3>
            <p class="text-gray-300">{t("security.faq_2_a")}</p>
          </article>
          <article class="bg-linear-to-br from-gray-800/50 to-gray-900/50 rounded-xl p-6 border border-gray-700/50">
            <h3 class="text-lg font-bold text-white mb-2">{t("security.faq_3_q")}</h3>
            <p class="text-gray-300">{t("security.faq_3_a")}</p>
          </article>
          <article class="bg-linear-to-br from-gray-800/50 to-gray-900/50 rounded-xl p-6 border border-gray-700/50">
            <h3 class="text-lg font-bold text-white mb-2">{t("security.faq_4_q")}</h3>
            <p class="text-gray-300">{t("security.faq_4_a")}</p>
          </article>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="py-20 md:py-32 bg-[#002040]">
      <div class="max-w-4xl mx-auto px-4">
        <div class="bg-linear-to-br from-green-900/30 to-blue-900/30 rounded-2xl p-8 lg:p-12 border border-green-500/20 text-center">
          <div class="w-20 h-20 bg-linear-to-br from-green-500 to-green-600 rounded-full flex items-center justify-center mx-auto mb-6"><i class="fas fa-shield-alt text-white text-3xl"></i></div>
          <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold text-white mb-4">{t("security.cta_title")}</h2>
          <p class="text-xl text-gray-300 mb-8 max-w-2xl mx-auto">{t("security.cta_subtitle")}</p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center mb-6">
            <a href="https://app.pickmytrade.trade/?register=true" class="electrolize-regular inline-flex items-center justify-center gap-2 px-8 py-4 bg-linear-to-r from-blue-600 to-blue-700 hover:from-blue-700 hover:to-blue-800 text-white rounded-xl font-bold transition-all transform hover:scale-105 shadow-xl"><i class="fas fa-rocket"></i> {t("security.cta_btn_trial")}</a>
            <a href={localizedPath(locale, 'pages/contact-us')} class="inline-flex items-center justify-center gap-2 px-8 py-4 bg-white/10 hover:bg-white/20 text-white rounded-xl font-bold border border-white/20"><i class="fas fa-envelope"></i> {t("security.cta_btn_contact")}</a>
          </div>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
