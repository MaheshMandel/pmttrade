---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getLocalePaths, useTranslations, localizedPath } from '../../../i18n/utils';
import type { Locale } from '../../../i18n/config';

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };
const t = useTranslations(locale);

const SITE_URL = 'https://pickmytrade.trade';
const withSlash = (p: string) => (p.endsWith('/') ? p : `${p}/`);

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  'itemListElement': [
    { '@type': 'ListItem', 'position': 1, 'name': 'Home', 'item': `${SITE_URL}${withSlash(localizedPath(locale))}` },
    { '@type': 'ListItem', 'position': 2, 'name': 'Contact Us', 'item': `${SITE_URL}${withSlash(localizedPath(locale, 'pages/contact-us'))}` },
  ],
};
---

<BaseLayout
  locale={locale}
  title={t('contact.meta_title')}
  description={t('contact.meta_description')}
  ldJson={[breadcrumbSchema]}>
  <!-- Hero Section -->
  <section class='pt-8 pb-16 px-4 bg-[#001429]'>
    <div class='container mx-auto max-w-7xl'>
      <div class='text-center mb-12'>
        <span
          class='inline-block px-4 py-2 bg-blue-600/20 text-blue-400 rounded-full text-sm font-semibold mb-6 border border-blue-500/30 electrolize-regular'>
          {t('contact.hero_badge')}
        </span>
        <h1
          class='text-5xl sm:text-6xl font-bold text-white mb-6 tracking-tight'>
          {t('contact.hero_title')}
        </h1>
        <p class='text-xl text-gray-300 max-w-2xl mx-auto leading-relaxed'>
          {t('contact.hero_subtitle')}
        </p>
      </div>
    </div>
  </section>

  <!-- Contact Methods Section -->
  <section class='py-12 px-4 bg-[#001429]'>
    <div class='container mx-auto max-w-7xl'>
      <div class='grid md:grid-cols-2 gap-8 mb-16'>
        <!-- Email Support Card -->
        <!-- email_off: keeps Cloudflare Email Address Obfuscation from rewriting
             the address into a JS-decoded [email protected] placeholder, which
             non-JS AI crawlers read as broken text on the contact page. -->
        <!--email_off-->
        <a
          href='mailto:support@pickmytrade.com'
          class='group relative bg-white/5 backdrop-blur-sm rounded-2xl p-8 border border-white/10 hover:border-blue-500/50 transition-all duration-300 hover:transform hover:scale-105'>
          <div
            class='absolute top-0 right-0 w-32 h-32 bg-blue-600/10 rounded-full blur-3xl group-hover:bg-blue-600/20 transition-all duration-300'>
          </div>
          <div class='relative'>
            <div
              class='w-16 h-16 bg-linear-to-br from-blue-600 to-blue-700 rounded-xl flex items-center justify-center mb-6 group-hover:shadow-lg group-hover:shadow-blue-600/50 transition-all duration-300'>
              <i class='fas fa-envelope text-white text-2xl'></i>
            </div>
            <h3 class='text-2xl font-bold text-white mb-3'>
              {t('contact.email_support_title')}
            </h3>
            <p class='text-gray-300 mb-4 leading-relaxed'>
              {t('contact.email_support_desc')}
            </p>
            <div
              class='flex items-center text-blue-400 font-semibold group-hover:text-blue-300 transition-colors'>
              <span>{t('contact.email_display')}</span>
              <i
                class='fas fa-arrow-right ml-2 group-hover:translate-x-2 transition-transform duration-300'
              ></i>
            </div>
          </div>
        </a>
        <!--email_on-->

        <!-- Discord Community Card -->
        <a
          href='https://discord.gg/FkJ7g7498S'
          target='_blank'
          class='group relative bg-white/5 backdrop-blur-sm rounded-2xl p-8 border border-white/10 hover:border-purple-500/50 transition-all duration-300 hover:transform hover:scale-105'>
          <div
            class='absolute top-0 right-0 w-32 h-32 bg-purple-600/10 rounded-full blur-3xl group-hover:bg-purple-600/20 transition-all duration-300'>
          </div>
          <div class='relative'>
            <div
              class='w-16 h-16 bg-linear-to-br from-purple-600 to-purple-700 rounded-xl flex items-center justify-center mb-6 group-hover:shadow-lg group-hover:shadow-purple-600/50 transition-all duration-300'>
              <i class='fab fa-discord text-white text-2xl'></i>
            </div>
            <h3 class='text-2xl font-bold text-white mb-3'>
              {t('contact.discord_title')}
            </h3>
            <p class='text-gray-300 mb-4 leading-relaxed'>
              {t('contact.discord_desc')}
            </p>
            <div
              class='flex items-center text-purple-400 font-semibold group-hover:text-purple-300 transition-colors'>
              <span>{t('contact.discord_link_text')}</span>
              <i
                class='fas fa-arrow-right ml-2 group-hover:translate-x-2 transition-transform duration-300'
              ></i>
            </div>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- Resources Section -->
  <section class='py-16 px-4 bg-linear-to-b from-[#001429] to-[#002040]'>
    <div class='container mx-auto max-w-7xl'>
      <div class='text-center mb-12'>
        <h2 class='text-4xl font-bold text-white mb-4'>
          {t('contact.resources_title')}
        </h2>
        <p class='text-gray-300 text-lg max-w-2xl mx-auto'>
          {t('contact.resources_subtitle')}
        </p>
      </div>

      <div class='grid md:grid-cols-3 gap-8'>
        <!-- YouTube Tutorials -->
        <a
          href='https://youtu.be/DfUYaURJnDQ?si=OKSJvGGkWocKWRit'
          target='_blank'
          class='group bg-white/5 backdrop-blur-sm rounded-xl p-6 border border-white/10 hover:border-red-500/50 transition-all duration-300'>
          <div
            class='w-12 h-12 bg-linear-to-br from-red-600 to-red-700 rounded-lg flex items-center justify-center mb-4 group-hover:shadow-lg group-hover:shadow-red-600/50 transition-all duration-300'>
            <i class='fab fa-youtube text-white text-xl'></i>
          </div>
          <h3 class='text-xl font-bold text-white mb-3'>
            {t('contact.youtube_title')}
          </h3>
          <p class='text-gray-300 text-sm leading-relaxed'>
            {t('contact.youtube_desc')}
          </p>
        </a>

        <!-- Documentation -->
        <a
          href='https://docs.pickmytrade.trade/docs/'
          target='_blank'
          class='group bg-white/5 backdrop-blur-sm rounded-xl p-6 border border-white/10 hover:border-blue-500/50 transition-all duration-300'>
          <div
            class='w-12 h-12 bg-linear-to-br from-blue-600 to-blue-700 rounded-lg flex items-center justify-center mb-4 group-hover:shadow-lg group-hover:shadow-blue-600/50 transition-all duration-300'>
            <i class='fas fa-book text-white text-xl'></i>
          </div>
          <h3 class='text-xl font-bold text-white mb-3'>
            {t('contact.docs_title')}
          </h3>
          <p class='text-gray-300 text-sm leading-relaxed'>
            {t('contact.docs_desc')}
          </p>
        </a>

        <!-- FAQs -->
        <a
          href='https://docs.pickmytrade.trade/docs/'
          target='_blank'
          class='group bg-white/5 backdrop-blur-sm rounded-xl p-6 border border-white/10 hover:border-green-500/50 transition-all duration-300'>
          <div
            class='w-12 h-12 bg-linear-to-br from-green-600 to-green-700 rounded-lg flex items-center justify-center mb-4 group-hover:shadow-lg group-hover:shadow-green-600/50 transition-all duration-300'>
            <i class='fas fa-circle-question text-white text-xl'></i>
          </div>
          <h3 class='text-xl font-bold text-white mb-3'>
            {t('contact.faq_title')}
          </h3>
          <p class='text-gray-300 text-sm leading-relaxed'>
            {t('contact.faq_desc')}
          </p>
        </a>
      </div>
    </div>
  </section>

  <!-- Response Time Info -->
  <section class='py-12 px-4 bg-[#002040]'>
    <div class='container mx-auto max-w-4xl'>
      <div
        class='bg-linear-to-r from-blue-600/10 to-purple-600/10 backdrop-blur-sm rounded-2xl p-8 border border-blue-500/20'>
        <div class='flex flex-col md:flex-row items-center gap-6'>
          <div
            class='w-16 h-16 bg-blue-600 rounded-full flex items-center justify-center shrink-0'>
            <i class='fas fa-clock text-white text-2xl'></i>
          </div>
          <div class='text-center md:text-left'>
            <h3 class='text-2xl font-bold text-white mb-2'>
              {t('contact.response_title')}
            </h3>
            <p class='text-gray-300 leading-relaxed'>
              {t('contact.response_label_email')}
              <span class='text-blue-400 font-semibold'
                >{t('contact.response_email_time')}</span
              >
              {t('contact.response_separator')}
              {t('contact.response_label_discord')}
              <span class='text-purple-400 font-semibold'
                >{t('contact.response_discord_time')}</span
              >
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
