---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import AuthorByline from '../../../components/AuthorByline.astro';
import {
  getLocalePaths,
  useTranslations,
  localizedPath,
} from '../../../i18n/utils';
import type { Locale } from '../../../i18n/config';
import { pricingFaq } from '../../../lib/schema';

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };
const t = useTranslations(locale);
const faqSchema = pricingFaq(t);

const SITE_URL = 'https://pickmytrade.trade';
const withSlash = (p: string) => (p.endsWith('/') ? p : `${p}/`);

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  'itemListElement': [
    { '@type': 'ListItem', 'position': 1, 'name': 'Home', 'item': `${SITE_URL}${withSlash(localizedPath(locale))}` },
    { '@type': 'ListItem', 'position': 2, 'name': 'Pricing', 'item': `${SITE_URL}${withSlash(localizedPath(locale, 'pages/pricing'))}` },
  ],
};
---

<BaseLayout
  locale={locale}
  title={t('pricing.meta_title')}
  description={t('pricing.meta_description')}
  ldJson={[faqSchema, breadcrumbSchema]}>
  <div class='bg-[#001429]'>
    <!-- Hero Section -->
    <section class='pt-8 pb-12 px-4'>
      <div class='container mx-auto max-w-7xl text-center'>
        <span
          class='electrolize-regular inline-block px-4 py-2 bg-green-600/20 text-green-400 rounded-full text-sm font-semibold mb-6 border border-green-500/30 uppercase'>
          {t('pricing.hero_badge')}
        </span>
        <h1
          class='text-4xl sm:text-5xl lg:text-6xl font-bold text-white mb-6 tracking-tight'>
          {t('pricing.hero_h1_pre')}<br /><span class='gradient-text'
            >{t('pricing.hero_h1_gradient')}</span
          >
        </h1>
        <p class='text-xl text-gray-300 max-w-3xl mx-auto leading-relaxed mb-6'>
          {t('pricing.hero_subtitle')}
        </p>
        <!-- Static, server-rendered pricing summary (extractable by AI crawlers without JS) -->
        <p
          class='text-base text-white/85 max-w-3xl mx-auto leading-relaxed mb-4'>
          <strong class='text-white'>{t('pricing.hero_summary_label')}</strong>
          <strong class='text-blue-400'
            >{t('pricing.hero_summary_monthly')}</strong
          >
          {t('pricing.hero_summary_or')}
          <strong class='text-blue-400'
            >{t('pricing.hero_summary_yearly')}</strong
          >
          {t('pricing.hero_summary_desc')}
        </p>
        <!-- Condensed CTA, server-rendered directly under the price line.
             The plan cards below are built client-side from pricing-config.json,
             so on a 375px viewport nothing actionable used to reach the first
             screen — a visitor had to scroll past ~800px of copy before any
             purchase action appeared on the highest-intent page on the site.
             This keeps one action within the fold on mobile without duplicating
             the card renderer's sale/regular price logic. -->
        <div class='flex justify-center mb-6'>
          <a
            href='https://app.pickmytrade.trade/?register=true'
            class='inline-flex items-center gap-2 bg-blue-600 hover:bg-blue-500 text-white font-bold px-7 py-3.5 rounded-xl shadow-lg shadow-blue-600/30 transition-all hover:scale-105'>
            <i
              class='fas fa-rocket'
              aria-hidden='true'></i>
            {t('pricing.cta_btn')}
          </a>
        </div>

        <div class='flex justify-center'>
          <AuthorByline locale={locale} lastUpdated='2026-07-29' />
        </div>
      </div>
    </section>

    <!-- Pricing Cards (same dynamic system as homepage) -->
    <section
      id='pricing'
      class='w-full py-12 px-5 sm:px-0 mx-auto'>
      <div
        id='pricing-cards-container'
        class='flex gap-6 lg:gap-8 justify-center mx-auto flex-nowrap overflow-x-auto max-w-[1650px] px-4 pb-2'>
        <!-- Cards dynamically rendered from pricing-config.json by script.js -->
      </div>

      <!-- Cancellation & Refund Policy -->
      <p class='text-sm text-gray-400 text-center mt-4'>
        {t('pricing.refund_note')}
        <!-- email_off: opts this address out of Cloudflare Email Address
             Obfuscation, which otherwise rewrites it to a JS-decoded
             [email protected] placeholder that non-JS AI crawlers read as
             broken text on the site's highest-intent page. -->
        <!--email_off-->
        <a
          href='mailto:support@pickmytrade.com'
          class='text-blue-400 hover:text-blue-300 underline'
          >support@pickmytrade.com</a
        >.
        <!--email_on-->
      </p>

      <!-- Trust Indicators -->
      <div class='mt-16 max-w-7xl mx-auto'>
        <div class='grid md:grid-cols-2 gap-6 px-4'>
          <div
            class='flex flex-col items-center text-center p-6 bg-white/5 backdrop-blur-sm rounded-xl border border-white/10 hover:border-blue-600/50 transition-all'>
            <div
              class='w-16 h-16 rounded-full bg-blue-500/20 flex items-center justify-center mb-4'>
              <i class='fas fa-lock text-blue-400 text-2xl'></i>
            </div>
            <h3 class='text-white font-bold text-lg mb-2'>
              {t('pricing.trust_1_title')}
            </h3>
            <p class='text-white/70 text-sm'>{t('pricing.trust_1_text')}</p>
          </div>
          <div
            class='flex flex-col items-center text-center p-6 bg-white/5 backdrop-blur-sm rounded-xl border border-white/10 hover:border-blue-600/50 transition-all'>
            <div
              class='w-16 h-16 rounded-full bg-purple-500/20 flex items-center justify-center mb-4'>
              <i class='fas fa-headset text-purple-400 text-2xl'></i>
            </div>
            <h3 class='text-white font-bold text-lg mb-2'>
              {t('pricing.trust_2_title')}
            </h3>
            <p class='text-white/70 text-sm'>{t('pricing.trust_2_text')}</p>
          </div>
        </div>
      </div>
    </section>

    <!-- All Plans Include -->
    <section class='py-16 px-4 border-t border-blue-900/30'>
      <div class='container mx-auto max-w-7xl'>
        <div class='text-center mb-12'>
          <h2 class='text-3xl md:text-4xl font-bold text-white mb-4'>
            {t('pricing.includes_h2')}
          </h2>
          <p class='text-gray-300 text-lg'>{t('pricing.includes_subtitle')}</p>
        </div>
        <div class='grid sm:grid-cols-2 lg:grid-cols-3 gap-6'>
          <div
            class='flex items-start gap-4 bg-white/5 rounded-xl p-5 border border-white/10'>
            <div
              class='w-10 h-10 bg-blue-600/20 rounded-lg flex items-center justify-center flex-shrink-0'>
              <i class='fas fa-infinity text-blue-400'></i>
            </div>
            <div>
              <h3 class='text-white font-bold mb-1'>
                {t('pricing.feat_1_title')}
              </h3>
              <p class='text-gray-400 text-sm'>{t('pricing.feat_1_text')}</p>
            </div>
          </div>
          <div
            class='flex items-start gap-4 bg-white/5 rounded-xl p-5 border border-white/10'>
            <div
              class='w-10 h-10 bg-green-600/20 rounded-lg flex items-center justify-center flex-shrink-0'>
              <i class='fas fa-layer-group text-green-400'></i>
            </div>
            <div>
              <h3 class='text-white font-bold mb-1'>
                {t('pricing.feat_2_title')}
              </h3>
              <p class='text-gray-400 text-sm'>{t('pricing.feat_2_text')}</p>
            </div>
          </div>
          <div
            class='flex items-start gap-4 bg-white/5 rounded-xl p-5 border border-white/10'>
            <div
              class='w-10 h-10 bg-purple-600/20 rounded-lg flex items-center justify-center flex-shrink-0'>
              <i class='fas fa-users text-purple-400'></i>
            </div>
            <div>
              <h3 class='text-white font-bold mb-1'>
                {t('pricing.feat_3_title')}
              </h3>
              <p class='text-gray-400 text-sm'>{t('pricing.feat_3_text')}</p>
            </div>
          </div>
          <div
            class='flex items-start gap-4 bg-white/5 rounded-xl p-5 border border-white/10'>
            <div
              class='w-10 h-10 bg-yellow-600/20 rounded-lg flex items-center justify-center flex-shrink-0'>
              <i class='fas fa-bolt text-yellow-400'></i>
            </div>
            <div>
              <h3 class='text-white font-bold mb-1'>
                {t('pricing.feat_4_title')}
              </h3>
              <p class='text-gray-400 text-sm'>{t('pricing.feat_4_text')}</p>
            </div>
          </div>
          <div
            class='flex items-start gap-4 bg-white/5 rounded-xl p-5 border border-white/10'>
            <div
              class='w-10 h-10 bg-red-600/20 rounded-lg flex items-center justify-center flex-shrink-0'>
              <i class='fas fa-shield-halved text-red-400'></i>
            </div>
            <div>
              <h3 class='text-white font-bold mb-1'>
                {t('pricing.feat_5_title')}
              </h3>
              <p class='text-gray-400 text-sm'>{t('pricing.feat_5_text')}</p>
            </div>
          </div>
          <div
            class='flex items-start gap-4 bg-white/5 rounded-xl p-5 border border-white/10'>
            <div
              class='w-10 h-10 bg-cyan-600/20 rounded-lg flex items-center justify-center flex-shrink-0'>
              <i class='fas fa-headset text-cyan-400'></i>
            </div>
            <div>
              <h3 class='text-white font-bold mb-1'>
                {t('pricing.feat_6_title')}
              </h3>
              <p class='text-gray-400 text-sm'>{t('pricing.feat_6_text')}</p>
            </div>
          </div>
        </div>
        <p class='text-center text-gray-400 text-sm mt-8'>
          {t('pricing.futures_bot_crosslink_pre')}<a
            href={localizedPath(locale, 'futures-trading-bot')}
            class='text-blue-400 hover:text-blue-300 underline'
            >{t('pricing.futures_bot_crosslink_link')}</a
          >{t('pricing.futures_bot_crosslink_post')}
        </p>
      </div>
    </section>

    <!-- FAQ Section -->
    <section class='py-16 px-4 border-t border-blue-900/30'>
      <div class='container mx-auto max-w-4xl'>
        <div class='text-center mb-12'>
          <span
            class='inline-block px-4 py-2 bg-blue-600/20 text-blue-400 rounded-full text-sm font-semibold mb-4 border border-blue-500/30'
            >{t('pricing.faq_badge')}</span
          >
          <h2 class='text-3xl md:text-4xl font-bold text-white mb-4'>
            {t('pricing.faq_h2')}
          </h2>
        </div>
        <div class='space-y-6'>
          <div
            class='bg-white/5 backdrop-blur-sm rounded-xl p-6 border border-white/10'>
            <h3 class='text-white font-bold text-lg mb-2'>
              {t('pricing.faq_1_q')}
            </h3>
            <p class='text-gray-300 leading-relaxed'>{t('pricing.faq_1_a')}</p>
          </div>
          <div
            class='bg-white/5 backdrop-blur-sm rounded-xl p-6 border border-white/10'>
            <h3 class='text-white font-bold text-lg mb-2'>
              {t('pricing.faq_2_q')}
            </h3>
            <p class='text-gray-300 leading-relaxed'>{t('pricing.faq_2_a')}</p>
          </div>
          <div
            class='bg-white/5 backdrop-blur-sm rounded-xl p-6 border border-white/10'>
            <h3 class='text-white font-bold text-lg mb-2'>
              {t('pricing.faq_3_q')}
            </h3>
            <p class='text-gray-300 leading-relaxed'>{t('pricing.faq_3_a')}</p>
          </div>
          <div
            class='bg-white/5 backdrop-blur-sm rounded-xl p-6 border border-white/10'>
            <h3 class='text-white font-bold text-lg mb-2'>
              {t('pricing.faq_4_q')}
            </h3>
            <p class='text-gray-300 leading-relaxed'>{t('pricing.faq_4_a')}</p>
          </div>
          <div
            class='bg-white/5 backdrop-blur-sm rounded-xl p-6 border border-white/10'>
            <h3 class='text-white font-bold text-lg mb-2'>
              {t('pricing.faq_5_q')}
            </h3>
            <p class='text-gray-300 leading-relaxed'>
              {t('pricing.faq_5_a_pre')}
              <a
                href={localizedPath(locale, 'supported-propfirms')}
                class='text-blue-400 hover:text-blue-300 underline'
                >{t('pricing.faq_5_a_link')}</a
              >{t('pricing.faq_5_a_post')}
            </p>
          </div>
          <div
            class='bg-white/5 backdrop-blur-sm rounded-xl p-6 border border-white/10'>
            <h3 class='text-white font-bold text-lg mb-2'>
              {t('pricing.faq_6_q')}
            </h3>
            <p class='text-gray-300 leading-relaxed'>{t('pricing.faq_6_a')}</p>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class='py-16 px-4 border-t border-blue-900/30'>
      <div class='container mx-auto max-w-4xl text-center'>
        <div
          class='bg-gradient-to-r from-blue-600/20 to-purple-600/20 rounded-3xl p-12 border border-blue-500/30'>
          <h2 class='text-3xl font-bold text-white mb-4'>
            {t('pricing.cta_h2')}
          </h2>
          <p class='text-gray-300 mb-8 max-w-2xl mx-auto'>
            {t('pricing.cta_text')}
          </p>
          <a
            href='https://app.pickmytrade.trade/?register=true'
            class='electrolize-regular inline-flex items-center justify-center gap-2 px-8 py-4 bg-gradient-to-r from-blue-600 to-blue-700 hover:from-blue-700 hover:to-blue-800 text-white rounded-xl font-bold transition-all transform hover:scale-105 shadow-xl'>
            <i class='fas fa-rocket'></i>
            {t('pricing.cta_btn')}
          </a>
        </div>
      </div>
    </section>
  </div>

  <script type="module" src="/script.js"></script>
</BaseLayout>
