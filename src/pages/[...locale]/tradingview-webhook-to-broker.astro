---
import BaseLayout from "../../layouts/BaseLayout.astro";
import FaqItem from "../../components/FaqItem.astro";
import { getLocalePaths, useTranslations, localizedPath } from "../../i18n/utils";
import type { Locale } from "../../i18n/config";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };
const t = useTranslations(locale);

const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const pageUrl = `${SITE_URL}${withSlash(localizedPath(locale, "tradingview-webhook-to-broker"))}`;

// Broker-agnostic directory — Tradovate stays on this site, the rest are set up on pickmytrade.io.
const brokerLinks = [
  { name: "Tradovate", href: localizedPath(locale, "tradingview-to-tradovate") },
  { name: "Rithmic", href: "https://pickmytrade.io/broker/tradingview-to-rithmic/" },
  { name: "Interactive Brokers", href: "https://pickmytrade.io/broker/tradingview-to-ib/" },
  { name: "TradeStation", href: "https://pickmytrade.io/broker/tradingview-to-tradestation/" },
  { name: "TradeLocker", href: "https://pickmytrade.io/broker/tradingview-to-tradelocker/" },
  { name: "ProjectX / TopstepX", href: "https://pickmytrade.io/broker/tradingview-to-projectx/" },
  { name: "Match-Trader", href: "https://pickmytrade.io/broker/tradingview-to-matchtrader/" },
  { name: "Tradier (Beta)", href: "https://pickmytrade.io/broker/tradingview-to-tradier/" },
  { name: "cTrader (Beta)", href: "https://pickmytrade.io/broker/tradingview-to-ctrader/" },
  { name: "Ironbeam (Beta)", href: "https://pickmytrade.io/broker/tradingview-to-ironbeam/" },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": Array.from({ length: 8 }, (_, i) => i + 1).map((n) => ({
    "@type": "Question",
    "name": t(`webhook_broker.faq_${n}_q` as any),
    "acceptedAnswer": { "@type": "Answer", "text": t(`webhook_broker.faq_${n}_a` as any) },
  })),
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": `${SITE_URL}${withSlash(localizedPath(locale))}` },
    { "@type": "ListItem", "position": 2, "name": "TradingView Webhook to Broker", "item": pageUrl },
  ],
};

const webhookJsonExample = `{
	"symbol": "NQ1!",
	"date": "{{timenow}}",
	"data": "buy",
	"quantity": 2,
	"risk_percentage": 0,
	"order_type": "MKT",
	"token": "At8tLtTtYtEt8t8tHtWtPtOtR",
	"multiple_accounts": [
		{
			"token": "UnyTGjYrtvhSW65-Iuds",
			"account_id": "DEMO2001",
			"quantity_multiplier": 1
		}
	]
}`;
---

<BaseLayout
  locale={locale}
  title={t("webhook_broker.meta_title")}
  description={t("webhook_broker.meta_description")}
  ldJson={[faqSchema, breadcrumbSchema]}
>
  <style>
    .electrolize-regular {
      font-family: 'Electrolize', sans-serif;
    }

    .gradient-text {
      background: linear-gradient(135deg, #2B77EE, #0F3EC3);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    .code-block {
      background: #0a1628;
      border-left: 3px solid #2B77EE;
      font-family: 'Courier New', monospace;
    }
  </style>

  <div class="bg-[#001429]">
    <!-- Hero -->
    <section class="py-16 lg:py-24 border-b border-blue-900/30 bg-gradient-to-b from-[#001429] to-[#002040]">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <span class="inline-block px-4 py-2 bg-blue-600/20 text-blue-400 rounded-full text-sm font-semibold mb-6 border border-blue-500/30 tracking-wide uppercase electrolize-regular">{t("webhook_broker.hero_badge")}</span>
        <h1 id="webhook-hero-heading" class="text-4xl sm:text-5xl lg:text-6xl font-bold text-white mb-6 tracking-tight leading-tight">
          {t("webhook_broker.hero_h1_pre")} <span class="gradient-text">{t("webhook_broker.hero_h1_highlight")}</span>
        </h1>
        <p id="webhook-hero-subtitle" class="text-xl md:text-2xl text-gray-300 max-w-3xl mx-auto leading-relaxed mb-8">
          {t("webhook_broker.hero_subtitle")}
        </p>
        <a href="#anatomy"
          class="inline-flex items-center justify-center px-8 py-4 text-base font-semibold text-white bg-gradient-to-r from-blue-600 to-blue-700 rounded-lg hover:from-blue-700 hover:to-blue-800 transition-all duration-300 shadow-lg hover:shadow-blue-500/50 hover:scale-105 electrolize-regular">
          {t("webhook_broker.hero_cta")}
          <i class="fa-solid fa-arrow-down ml-2" aria-hidden="true"></i>
        </a>
      </div>
    </section>

    <!-- What is a webhook -->
    <section class="py-14 sm:py-16 border-b border-blue-900/30">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-2xl sm:text-3xl font-bold text-white mb-5">{t("webhook_broker.secA_h2")}</h2>
        <p class="text-gray-300 leading-relaxed mb-4">{t("webhook_broker.secA_p1")}</p>
        <p class="text-gray-300 leading-relaxed">{t("webhook_broker.secA_p2")}</p>
      </div>
    </section>

    <!-- Three-hop path -->
    <section class="py-16 lg:py-20 border-b border-blue-900/30 bg-gradient-to-b from-[#001429] to-[#002040]">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-3xl sm:text-4xl font-bold text-white mb-12 text-center">{t("webhook_broker.secB_h2")}</h2>
        <div class="grid md:grid-cols-3 gap-8">
          <div class="bg-gradient-to-br from-blue-900/20 to-blue-900/5 border border-blue-500/30 rounded-xl p-8">
            <div class="w-12 h-12 bg-blue-500/20 rounded-lg flex items-center justify-center mb-4">
              <i class="fa-solid fa-bell text-blue-400 text-xl" aria-hidden="true"></i>
            </div>
            <h3 class="text-xl font-bold text-white mb-3">{t("webhook_broker.secB_step1_title")}</h3>
            <p class="text-gray-300 text-sm leading-relaxed">{t("webhook_broker.secB_step1_desc")}</p>
          </div>
          <div class="bg-gradient-to-br from-purple-900/20 to-purple-900/5 border border-purple-500/30 rounded-xl p-8">
            <div class="w-12 h-12 bg-purple-500/20 rounded-lg flex items-center justify-center mb-4">
              <i class="fa-solid fa-diagram-project text-purple-400 text-xl" aria-hidden="true"></i>
            </div>
            <h3 class="text-xl font-bold text-white mb-3">{t("webhook_broker.secB_step2_title")}</h3>
            <p class="text-gray-300 text-sm leading-relaxed">{t("webhook_broker.secB_step2_desc")}</p>
          </div>
          <div class="bg-gradient-to-br from-green-900/20 to-green-900/5 border border-green-500/30 rounded-xl p-8">
            <div class="w-12 h-12 bg-green-500/20 rounded-lg flex items-center justify-center mb-4">
              <i class="fa-solid fa-check-double text-green-400 text-xl" aria-hidden="true"></i>
            </div>
            <h3 class="text-xl font-bold text-white mb-3">{t("webhook_broker.secB_step3_title")}</h3>
            <p class="text-gray-300 text-sm leading-relaxed">{t("webhook_broker.secB_step3_desc")}</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Anatomy of a webhook alert -->
    <section id="anatomy" class="py-16 lg:py-20 border-b border-blue-900/30">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-3xl sm:text-4xl font-bold text-white mb-4 text-center">{t("webhook_broker.secC_h2")}</h2>
        <p class="text-gray-300 leading-relaxed max-w-3xl mx-auto text-center mb-12">{t("webhook_broker.secC_p1")}</p>

        <div class="grid lg:grid-cols-2 gap-8">
          <div>
            <div class="bg-blue-900/30 border border-blue-500/20 rounded-lg p-5 mb-6">
              <p class="text-sm text-gray-200 leading-relaxed"><i class="fa-solid fa-link text-blue-400 mr-2" aria-hidden="true"></i>{t("webhook_broker.secC_url_label")}</p>
            </div>
            <p class="text-sm text-gray-300 leading-relaxed mb-6">{t("webhook_broker.secC_json_note")}</p>

            <div class="space-y-3">
              <div class="bg-gray-800/50 rounded-lg p-4 border border-gray-700">
                <code class="text-blue-400 font-mono text-sm">symbol</code>
                <p class="text-gray-400 text-xs mt-1">{t("webhook_broker.secC_field_symbol_desc")}</p>
              </div>
              <div class="bg-gray-800/50 rounded-lg p-4 border border-gray-700">
                <code class="text-blue-400 font-mono text-sm">data</code>
                <p class="text-gray-400 text-xs mt-1">{t("webhook_broker.secC_field_data_desc")}</p>
              </div>
              <div class="bg-gray-800/50 rounded-lg p-4 border border-gray-700">
                <code class="text-blue-400 font-mono text-sm">quantity / risk_percentage</code>
                <p class="text-gray-400 text-xs mt-1">{t("webhook_broker.secC_field_quantity_desc")}</p>
              </div>
              <div class="bg-gray-800/50 rounded-lg p-4 border border-gray-700">
                <code class="text-blue-400 font-mono text-sm">order_type</code>
                <p class="text-gray-400 text-xs mt-1">{t("webhook_broker.secC_field_order_type_desc")}</p>
              </div>
              <div class="bg-gray-800/50 rounded-lg p-4 border border-gray-700">
                <code class="text-blue-400 font-mono text-sm">token</code>
                <p class="text-gray-400 text-xs mt-1">{t("webhook_broker.secC_field_token_desc")}</p>
              </div>
              <div class="bg-gray-800/50 rounded-lg p-4 border border-gray-700">
                <code class="text-blue-400 font-mono text-sm">multiple_accounts</code>
                <p class="text-gray-400 text-xs mt-1">{t("webhook_broker.secC_field_multiple_accounts_desc")}</p>
              </div>
            </div>
          </div>

          <div class="code-block rounded-2xl p-6 border border-gray-700 self-start">
            <div class="flex items-center gap-2 mb-4">
              <div class="w-3 h-3 bg-red-500 rounded-full"></div>
              <div class="w-3 h-3 bg-yellow-500 rounded-full"></div>
              <div class="w-3 h-3 bg-green-500 rounded-full"></div>
            </div>
            <pre class="text-sm overflow-x-auto"><code class="text-green-400">{webhookJsonExample}</code></pre>
          </div>
        </div>
      </div>
    </section>

    <!-- Broker directory -->
    <section class="py-16 lg:py-20 border-b border-blue-900/30 bg-gradient-to-b from-[#002040] to-[#001429]">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-10">
          <h2 class="text-3xl sm:text-4xl font-bold text-white mb-4">{t("webhook_broker.secD_h2")}</h2>
          <p class="text-gray-400 max-w-2xl mx-auto">{t("webhook_broker.secD_subtitle")}</p>
        </div>

        <div class="bg-gradient-to-br from-gray-800/50 to-gray-900/50 backdrop-blur-sm rounded-2xl border border-gray-700/50 overflow-hidden">
          <table class="w-full text-sm">
            <thead>
              <tr class="border-b border-gray-700 bg-gray-800/50">
                <th class="text-left px-6 py-4 text-gray-400 font-semibold">{t("webhook_broker.secD_col_broker")}</th>
                <th class="text-right px-6 py-4 text-gray-400 font-semibold">{t("webhook_broker.secD_col_guide")}</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-700/50">
              {brokerLinks.map((broker) => (
                <tr class="hover:bg-gray-800/30 transition-colors">
                  <td class="px-6 py-4 text-white font-medium">{broker.name}</td>
                  <td class="px-6 py-4 text-right">
                    <a href={broker.href} target={broker.href.startsWith("http") ? "_blank" : undefined}
                      rel={broker.href.startsWith("http") ? "noopener noreferrer" : undefined}
                      class="inline-flex items-center gap-1.5 text-blue-400 hover:text-blue-300 font-semibold">
                      <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
                    </a>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- Security -->
    <section class="py-16 lg:py-20 border-b border-blue-900/30">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
          <h2 class="text-3xl sm:text-4xl font-bold text-white mb-4">{t("webhook_broker.secE_h2")}</h2>
          <p class="text-gray-300 max-w-3xl mx-auto leading-relaxed">{t("webhook_broker.secE_p1")}</p>
        </div>
        <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
          <div class="bg-blue-900/20 border border-blue-500/30 rounded-xl p-6">
            <i class="fa-solid fa-key text-blue-400 text-2xl mb-3" aria-hidden="true"></i>
            <h3 class="text-white font-bold mb-2">{t("webhook_broker.secE_card1_title")}</h3>
            <p class="text-gray-400 text-sm leading-relaxed">{t("webhook_broker.secE_card1_desc")}</p>
          </div>
          <div class="bg-purple-900/20 border border-purple-500/30 rounded-xl p-6">
            <i class="fa-solid fa-lock text-purple-400 text-2xl mb-3" aria-hidden="true"></i>
            <h3 class="text-white font-bold mb-2">{t("webhook_broker.secE_card2_title")}</h3>
            <p class="text-gray-400 text-sm leading-relaxed">{t("webhook_broker.secE_card2_desc")}</p>
          </div>
          <div class="bg-green-900/20 border border-green-500/30 rounded-xl p-6">
            <i class="fa-solid fa-list-check text-green-400 text-2xl mb-3" aria-hidden="true"></i>
            <h3 class="text-white font-bold mb-2">{t("webhook_broker.secE_card3_title")}</h3>
            <p class="text-gray-400 text-sm leading-relaxed">{t("webhook_broker.secE_card3_desc")}</p>
          </div>
          <div class="bg-yellow-900/20 border border-yellow-500/30 rounded-xl p-6">
            <i class="fa-solid fa-gauge-high text-yellow-400 text-2xl mb-3" aria-hidden="true"></i>
            <h3 class="text-white font-bold mb-2">{t("webhook_broker.secE_card4_title")}</h3>
            <p class="text-gray-400 text-sm leading-relaxed">{t("webhook_broker.secE_card4_desc")}</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Troubleshooting -->
    <section class="py-16 lg:py-20 border-b border-blue-900/30 bg-gradient-to-b from-[#001429] to-[#002040]">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
          <h2 class="text-3xl sm:text-4xl font-bold text-white mb-4">{t("webhook_broker.secF_h2")}</h2>
          <p class="text-gray-400 max-w-2xl mx-auto">{t("webhook_broker.secF_subtitle")}</p>
        </div>
        <div class="grid md:grid-cols-2 gap-6">
          <div class="bg-red-900/10 border border-red-500/20 rounded-xl p-6">
            <h3 class="text-white font-bold mb-2 flex items-center gap-2"><i class="fa-solid fa-triangle-exclamation text-red-400" aria-hidden="true"></i>{t("webhook_broker.secF_item1_title")}</h3>
            <p class="text-gray-400 text-sm leading-relaxed">{t("webhook_broker.secF_item1_desc")}</p>
          </div>
          <div class="bg-red-900/10 border border-red-500/20 rounded-xl p-6">
            <h3 class="text-white font-bold mb-2 flex items-center gap-2"><i class="fa-solid fa-triangle-exclamation text-red-400" aria-hidden="true"></i>{t("webhook_broker.secF_item2_title")}</h3>
            <p class="text-gray-400 text-sm leading-relaxed">{t("webhook_broker.secF_item2_desc")}</p>
          </div>
          <div class="bg-red-900/10 border border-red-500/20 rounded-xl p-6">
            <h3 class="text-white font-bold mb-2 flex items-center gap-2"><i class="fa-solid fa-triangle-exclamation text-red-400" aria-hidden="true"></i>{t("webhook_broker.secF_item3_title")}</h3>
            <p class="text-gray-400 text-sm leading-relaxed">{t("webhook_broker.secF_item3_desc")}</p>
          </div>
          <div class="bg-red-900/10 border border-red-500/20 rounded-xl p-6">
            <h3 class="text-white font-bold mb-2 flex items-center gap-2"><i class="fa-solid fa-triangle-exclamation text-red-400" aria-hidden="true"></i>{t("webhook_broker.secF_item4_title")}</h3>
            <p class="text-gray-400 text-sm leading-relaxed">{t("webhook_broker.secF_item4_desc")}</p>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section id="faq" class="py-20 bg-gray-800/50 text-white">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
          <h2 class="text-3xl font-bold text-white mb-2 text-center">{t("webhook_broker.faq_h2")}</h2>
        </div>
        <div class="faq-content space-y-4">
          {Array.from({ length: 8 }, (_, i) => i + 1).map((n) => (
            <FaqItem question={t(`webhook_broker.faq_${n}_q` as any)}>
              <p>{t(`webhook_broker.faq_${n}_a` as any)}</p>
            </FaqItem>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="py-16 lg:py-20">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h2 class="text-3xl sm:text-4xl font-bold text-white mb-4">{t("webhook_broker.cta_h2")}</h2>
        <p class="text-gray-300 max-w-2xl mx-auto mb-8">{t("webhook_broker.cta_subtitle")}</p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="https://app.pickmytrade.trade/?register=true"
            class="inline-flex items-center justify-center px-8 py-4 text-base font-semibold text-white bg-gradient-to-r from-blue-600 to-blue-700 rounded-lg hover:from-blue-700 hover:to-blue-800 transition-all duration-300 shadow-lg hover:shadow-blue-500/50 hover:scale-105 electrolize-regular">
            {t("webhook_broker.cta_primary")}
          </a>
          <a href={localizedPath(locale, "tradingview-automation")}
            class="inline-flex items-center justify-center px-8 py-4 text-base font-semibold text-blue-400 border border-blue-500/50 bg-white/5 rounded-lg hover:bg-white/10 transition-all duration-300 electrolize-regular">
            {t("webhook_broker.cta_secondary")}
          </a>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
