---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getLocalePaths, useTranslations, localizedPath } from "../../i18n/utils";
import type { Locale } from "../../i18n/config";

export const getStaticPaths = getLocalePaths;

interface Props {
  locale: Locale;
  robots?: string;
  canonical?: string;
}

const { locale, robots, canonical } = Astro.props as Props;
const t = useTranslations(locale);

const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const pageUrl = `${SITE_URL}${withSlash(localizedPath(locale))}`;

// Mirror the visible homepage FAQ block as FAQPage JSON-LD so AI engines can cite
// the Q&As. Multi-part answers (3 & 4) are flattened to match what's on the page.
const faqAnswer3 = `${t("home.faq_3_a_intro")} ${t("home.faq_3_brokers_heading")} ${t("home.faq_3_broker_1")}, ${t("home.faq_3_broker_2")}, ${t("home.faq_3_broker_3")}, ${t("home.faq_3_broker_4")}, ${t("home.faq_3_broker_5")}. ${t("home.faq_3_propfirms_heading")} ${t("home.faq_3_propfirm_1")}, ${t("home.faq_3_propfirm_2")}, ${t("home.faq_3_propfirm_3")}, ${t("home.faq_3_propfirm_4")}. ${t("home.faq_3_important_label")} ${t("home.faq_3_important_text")}`;
const faqAnswer4 = `${t("home.faq_4_a_intro")} 1) ${t("home.faq_4_step_1")}. 2) ${t("home.faq_4_step_2")}. 3) ${t("home.faq_4_step_3_pre")} ${t("home.faq_4_step_3_sub_1")}; ${t("home.faq_4_step_3_sub_2")}; ${t("home.faq_4_step_3_sub_3")}. ${t("home.faq_4_conclusion")} ${t("home.faq_4_note_label")} ${t("home.faq_4_note_text")}`;

// Finding S5: the homepage was the only route with no BreadcrumbList (every
// other page — /compare, /prop-firm-faq, etc. — already carries one). Single-item
// trail is the correct representation of the root page itself.
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": pageUrl },
  ],
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    { "@type": "Question", "name": t("home.faq_1_q"), "acceptedAnswer": { "@type": "Answer", "text": t("home.faq_1_a") } },
    { "@type": "Question", "name": t("home.faq_2_q"), "acceptedAnswer": { "@type": "Answer", "text": t("home.faq_2_a") } },
    { "@type": "Question", "name": t("home.faq_3_q"), "acceptedAnswer": { "@type": "Answer", "text": faqAnswer3 } },
    { "@type": "Question", "name": t("home.faq_4_q"), "acceptedAnswer": { "@type": "Answer", "text": faqAnswer4 } },
    { "@type": "Question", "name": t("home.faq_5_q"), "acceptedAnswer": { "@type": "Answer", "text": t("home.faq_5_a") } },
    { "@type": "Question", "name": t("home.faq_6_q"), "acceptedAnswer": { "@type": "Answer", "text": t("home.faq_6_a") } },
    { "@type": "Question", "name": t("home.faq_7_q"), "acceptedAnswer": { "@type": "Answer", "text": t("home.faq_7_a") } },
    { "@type": "Question", "name": t("home.faq_8_q"), "acceptedAnswer": { "@type": "Answer", "text": t("home.faq_8_a") } }
  ]
};

// Restores the two embedded product-demo videos as VideoObject entities — dropped
// during the static-HTML-to-Astro migration even though both videos are still
// embedded further down this page.
const video1Schema = {
  "@context": "https://schema.org",
  "@type": "VideoObject",
  "name": "How to Automate TradingView to Tradovate with PickMyTrade",
  "description": "Step-by-step tutorial showing how to set up automated trading from TradingView to Tradovate using PickMyTrade.",
  "thumbnailUrl": `${SITE_URL}/assets/automation_with_PMT.webp`,
  "uploadDate": "2025-03-19T01:21:59-07:00",
  "duration": "PT19M38S",
  "contentUrl": "https://www.youtube.com/watch?v=evcKBn3JlBA",
  "embedUrl": "https://www.youtube.com/embed/evcKBn3JlBA",
};
const video2Schema = {
  "@context": "https://schema.org",
  "@type": "VideoObject",
  "name": "Execute Manual Trades from TradingView to Tradovate",
  "description": "Learn how to place manual trades from TradingView directly to your Tradovate account using PickMyTrade.",
  "thumbnailUrl": `${SITE_URL}/assets/manual_trade_from_TV.webp`,
  "uploadDate": "2025-03-26T11:30:49-07:00",
  "duration": "PT1M47S",
  "contentUrl": "https://www.youtube.com/watch?v=qqD6TxrKIc0",
  "embedUrl": "https://www.youtube.com/embed/qqD6TxrKIc0",
};

// Speakable selectors point at real, existing elements (ids added to the hero H1,
// hero description, and tool-answer paragraph below) rather than the old static
// page's classes, which no longer exist in the Tailwind-based markup.
const speakableSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": `${pageUrl}#webpage`,
  "url": pageUrl,
  "speakable": {
    "@type": "SpeakableSpecification",
    "cssSelector": ["#hero-heading", "#hero-description", "#tradovate-tool-answer"],
  },
};
---

<BaseLayout
  locale={locale}
  title={t("home.meta_title")}
  description={t("home.meta_description")}
  robots={robots}
  canonical={canonical}
  ldJson={[faqSchema, breadcrumbSchema, speakableSchema, video1Schema, video2Schema]}
>
  <div class="relative mt-0 bg-[#001429]">
    <section class="relative overflow-hidden">
      <!-- Background depth layers -->
      <div class="absolute inset-0 bg-gradient-to-br from-[#000d1f] via-[#001429] to-[#001d3d]"></div>
      <div class="absolute inset-0 opacity-[0.035]" style="background-image: linear-gradient(rgba(43,119,238,0.6) 1px, transparent 1px), linear-gradient(90deg, rgba(43,119,238,0.6) 1px, transparent 1px); background-size: 64px 64px;"></div>
      <div class="absolute top-1/3 -left-20 w-[480px] h-[480px] bg-blue-700/8 rounded-full blur-[110px] pointer-events-none"></div>
      <div class="absolute bottom-0 right-0 w-[420px] h-[420px] bg-blue-500/6 rounded-full blur-[100px] pointer-events-none"></div>

      <div class="relative z-10 w-full px-5 lg:px-10">
        <div class="max-w-7xl mx-auto w-full flex flex-col items-center text-center pt-24 pb-16">

          <!-- Badge -->
          <div class="mb-4 inline-flex items-center gap-2 bg-[#111111]/80 border border-white/20 rounded-full px-4 py-1.5">
            <p class="text-zinc-300 electrolize-regular font-bold uppercase text-xs tracking-widest">
              {t("home.hero_badge")}</p>
          </div>

          <!-- H1 — one size step smaller below sm so the hero CTAs stay within
               the first screen on a 375px device. -->
          <h1 id="hero-heading" class="text-3xl sm:text-5xl font-bold text-[#2B77EE] mb-5 tracking-tight leading-[1.1]">
            {t("home.hero_h1")}
          </h1>


          <!-- Broker links — a single horizontally-scrollable row on mobile
               instead of 8 pills wrapping across 4 stacked rows, which together
               with the H1 pushed both CTAs below the fold at 375x812. Reverts to
               the normal centred wrap from sm up, so desktop is unchanged. -->
          <div id="broker-links"
            class="hero-broker-strip flex flex-nowrap overflow-x-auto justify-start
                   sm:flex-wrap sm:overflow-visible sm:justify-center
                   gap-2 mt-4 mb-5 max-w-5xl w-full sm:w-auto">
            <!-- Broker links will be dynamically loaded here -->
          </div>
          <script src="/broker-loader.js" defer></script>

          <!-- Description -->
          <p id="hero-description" class="max-w-5xl text-base md:text-lg mb-7 text-gray-300 leading-relaxed">
            {t("home.hero_description_pre")} <br />{t("home.hero_description_post")}
          </p>

          <!-- CTAs -->
          <div class="flex flex-col sm:flex-row gap-4 mb-7 w-full sm:w-auto">
            <a href="https://app.pickmytrade.trade/?register=true"
              class="px-7 py-2.5 text-lg rounded-xl font-semibold shadow-lg transition-all duration-300
                     hover:shadow-[0_0_28px_8px_rgba(43,119,238,0.38)] hover:-translate-y-0.5 hover:cursor-pointer
                     electrolize-regular bg-gradient-to-r from-[#0F3EC3] to-[#2B77EE] text-white text-center"
              itemprop="url">
              {t("home.hero_cta_signup")}
            </a>
            <a href="https://app.pickmytrade.trade"
              class="px-7 py-2.5 text-lg rounded-xl font-semibold shadow-lg transition-all duration-300
                     hover:shadow-[0_0_28px_8px_rgba(43,119,238,0.2)] hover:-translate-y-0.5 hover:cursor-pointer
                     electrolize-regular border border-[#2B77EE]/50 bg-white/5 text-white hover:bg-white/10 hover:border-[#2B77EE]/80 text-center">
              {t("home.hero_cta_login")}
            </a>
          </div>

          <!-- Trust badges -->
          <div class="flex flex-wrap justify-center gap-3 text-sm">
            <div class="flex items-center gap-2 bg-white/5 backdrop-blur-sm border border-white/10 rounded-full px-4 py-2 hover:bg-white/10 transition-all">
              <i class="fa-solid fa-check-circle text-green-400" aria-hidden="true"></i>
              <span class="text-gray-300">{t("home.trust_badge_1")}</span>
            </div>
            <div class="flex items-center gap-2 bg-white/5 backdrop-blur-sm border border-white/10 rounded-full px-4 py-2 hover:bg-white/10 transition-all">
              <i class="fa-solid fa-credit-card text-blue-400" aria-hidden="true"></i>
              <span class="text-gray-300">{t("home.trust_badge_2")}</span>
            </div>
            <div class="flex items-center gap-2 bg-white/5 backdrop-blur-sm border border-white/10 rounded-full px-4 py-2 hover:bg-white/10 transition-all">
              <i class="fa-solid fa-infinity text-purple-400" aria-hidden="true"></i>
              <span class="text-gray-300">{t("home.trust_badge_3")}</span>
            </div>
            <div class="flex items-center gap-2 bg-white/5 backdrop-blur-sm border border-white/10 rounded-full px-4 py-2 hover:bg-white/10 transition-all">
              <i class="fa-solid fa-bolt text-yellow-400" aria-hidden="true"></i>
              <span class="text-gray-300">{t("home.trust_badge_4")}</span>
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- Tradovate Automation Tool — direct-answer block for AI/search citability -->
    <section id="tradovate-automation-tool" class="w-full py-16 md:py-20 mx-auto bg-[#001429]">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-8">
          <span
            class="inline-block px-4 py-2 bg-blue-600/20 text-blue-400 rounded-full text-sm font-semibold mb-4 border border-blue-500/30">
            {t("home.tradovate_tool_badge")}
          </span>
          <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold text-white tracking-tight">
            {t("home.tradovate_tool_h2")}
          </h2>
        </div>

        <div
          class="bg-gradient-to-br from-gray-800/50 to-gray-900/50 backdrop-blur-sm rounded-2xl p-6 md:p-10 border border-gray-700/50">
          <p id="tradovate-tool-answer" class="text-lg text-gray-200 leading-relaxed">
            {t("home.tradovate_tool_answer")}
          </p>

          <div class="flex flex-wrap gap-3 mt-6">
            <span
              class="inline-flex items-center gap-2 bg-white/5 border border-white/10 rounded-full px-4 py-2 text-sm text-gray-300">
              <i class="fa-solid fa-code text-blue-400" aria-hidden="true"></i>{t("home.tradovate_tool_point_1")}
            </span>
            <span
              class="inline-flex items-center gap-2 bg-white/5 border border-white/10 rounded-full px-4 py-2 text-sm text-gray-300">
              <i class="fa-solid fa-bolt text-yellow-400" aria-hidden="true"></i>{t("home.tradovate_tool_point_2")}
            </span>
            <span
              class="inline-flex items-center gap-2 bg-white/5 border border-white/10 rounded-full px-4 py-2 text-sm text-gray-300">
              <i class="fa-solid fa-building text-purple-400" aria-hidden="true"></i>{t("home.tradovate_tool_point_3")}
            </span>
          </div>

          <p class="text-gray-300 leading-relaxed mt-6">
            {t("home.tradovate_tool_links_pre")}<a href={localizedPath(locale, "use-cases/multi-account-traders")}
              class="text-blue-400 font-semibold hover:text-blue-300 underline underline-offset-2">{t("home.tradovate_tool_copier_link")}</a>{t("home.tradovate_tool_links_mid")}<a
              href={localizedPath(locale, "tradingview-automation")}
              class="text-blue-400 font-semibold hover:text-blue-300 underline underline-offset-2">{t("home.tradovate_tool_guide_link")}</a>{t("home.tradovate_tool_links_post")}
          </p>
          <p class="text-gray-400 text-sm mt-3">
            {t("home.futures_bot_crosslink_pre")}<a href={localizedPath(locale, "futures-trading-bot")}
              class="text-blue-400 hover:text-blue-300 underline underline-offset-2">{t("home.futures_bot_crosslink_link")}</a>{t("home.futures_bot_crosslink_post")}
          </p>

          <div class="mt-8">
            <a href="https://app.pickmytrade.trade/?register=true"
              class="inline-flex items-center gap-2 bg-gradient-to-r from-blue-600 to-blue-700 hover:from-blue-700 hover:to-blue-800 text-white px-7 py-3 rounded-xl font-semibold transition-all duration-300 transform hover:scale-105 hover:shadow-lg">
              {t("home.tradovate_tool_cta")}
              <i class="fas fa-arrow-right"></i>
            </a>
          </div>
        </div>
      </div>
    </section>

    <section id="howitworks"
      class="w-full py-16 md:py-24 lg:py-32 mx-auto bg-gradient-to-b from-[#001429] to-[#002040]">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <!-- Header -->
        <div class="text-center mb-16">
          <span
            class="inline-block px-4 py-2 bg-blue-600/20 text-blue-400 rounded-full text-sm font-semibold mb-4 border border-blue-500/30">
            {t("home.hiw_badge")}
          </span>
          <h2 class="text-4xl md:text-5xl lg:text-6xl font-bold text-white mb-6 tracking-tight">
            {t("home.hiw_h2")}
          </h2>
          <p class="text-xl text-gray-300 max-w-3xl mx-auto leading-relaxed">
            {t("home.hiw_subtitle_pre")} <span class="text-blue-400 font-semibold">{t("home.hiw_subtitle_strategy")}</span> {t("home.hiw_subtitle_mid_1")}
            <span class="text-purple-500 font-semibold">{t("home.hiw_subtitle_no_webapi")}</span>{t("home.hiw_subtitle_mid_2")}
            <span class="text-purple-500 font-semibold">{t("home.hiw_subtitle_no_card")}</span>{t("home.hiw_subtitle_mid_3")}
            <span class="font-bold text-white">{t("home.hiw_subtitle_trial")}</span>{t("home.hiw_subtitle_post")}
          </p>
        </div>

        <!-- Steps Grid -->
        <div class="relative">
          <!-- Connection Line (Desktop) -->
          <div
            class="hidden lg:block absolute top-24 left-0 right-0 h-0.5 bg-gradient-to-r from-blue-500 via-purple-500 to-blue-500 opacity-30"
            style="width: calc(100% - 8rem); margin-left: 4rem;"></div>

          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 relative">

            <!-- Step 1 -->
            <div
              class="group relative bg-gradient-to-br from-gray-800/50 to-gray-900/50 backdrop-blur-sm rounded-2xl p-8 border border-gray-700/50 hover:border-blue-500/50 transition-all duration-300 hover:shadow-2xl hover:shadow-blue-500/20 hover:-translate-y-2">
              <!-- Step Number Badge -->
              <div
                class="absolute -top-4 left-8 w-12 h-12 bg-gradient-to-br from-blue-500 to-blue-600 rounded-full flex items-center justify-center shadow-lg border-4 border-[#001429] group-hover:scale-110 transition-transform duration-300">
                <span class="text-white font-bold text-xl">1</span>
              </div>

              <div class="mt-6">
                <div
                  class="w-16 h-16 mb-4 bg-gradient-to-br from-blue-500/20 to-blue-600/20 rounded-xl flex items-center justify-center group-hover:scale-110 transition-transform duration-300">
                  <i class="fa-solid fa-user-plus text-3xl text-blue-400"></i>
                </div>

                <h3 class="text-2xl font-bold text-white mb-3 group-hover:text-blue-400 transition-colors duration-300">
                  {t("home.step_1_h3")}
                </h3>
                <p class="text-gray-300 leading-relaxed mb-6">
                  {t("home.step_1_p_pre")} <span class="text-blue-400 font-medium">{t("home.step_1_p_highlight")}</span> {t("home.step_1_p_post")}
                </p>

                <a href="https://app.pickmytrade.trade/?register=true"
                  class="inline-flex items-center justify-center gap-2 w-full bg-gradient-to-r from-blue-600 to-blue-700 hover:from-blue-700 hover:to-blue-800 text-white font-semibold py-3 px-6 rounded-lg transition-all duration-300 transform hover:scale-105 hover:shadow-lg group/btn">
                  <span>{t("home.step_1_btn")}</span>
                  <i class="fa-solid fa-arrow-right group-hover/btn:translate-x-1 transition-transform"></i>
                </a>
              </div>
            </div>

            <!-- Step 2 -->
            <div
              class="group relative bg-gradient-to-br from-gray-800/50 to-gray-900/50 backdrop-blur-sm rounded-2xl p-8 border border-gray-700/50 hover:border-blue-500/50 transition-all duration-300 hover:shadow-2xl hover:shadow-blue-500/20 hover:-translate-y-2">
              <div
                class="absolute -top-4 left-8 w-12 h-12 bg-gradient-to-br from-blue-500 to-blue-600 rounded-full flex items-center justify-center shadow-lg border-4 border-[#001429] group-hover:scale-110 transition-transform duration-300">
                <span class="text-white font-bold text-xl">2</span>
              </div>

              <div class="mt-6">
                <div
                  class="w-16 h-16 mb-4 bg-gradient-to-br from-blue-500/20 to-blue-600/20 rounded-xl flex items-center justify-center group-hover:scale-110 transition-transform duration-300">
                  <i class="fa-solid fa-link text-3xl text-blue-400"></i>
                </div>

                <h3 class="text-2xl font-bold text-white mb-3 group-hover:text-blue-400 transition-colors duration-300">
                  {t("home.step_2_h3")}
                </h3>
                <p class="text-gray-300 leading-relaxed mb-6">
                  <Fragment set:html={t("home.step_2_p_full")} />
                </p>

                <a href="https://app.pickmytrade.trade/?register=true"
                  class="inline-flex items-center justify-center gap-2 w-full bg-gradient-to-r from-blue-600 to-blue-700 hover:from-blue-700 hover:to-blue-800 text-white font-semibold py-3 px-6 rounded-lg transition-all duration-300 transform hover:scale-105 hover:shadow-lg group/btn">
                  <span>{t("home.step_2_btn")}</span>
                  <i class="fa-solid fa-arrow-right group-hover/btn:translate-x-1 transition-transform"></i>
                </a>
              </div>
            </div>

            <!-- Step 3 -->
            <div
              class="group relative bg-gradient-to-br from-gray-800/50 to-gray-900/50 backdrop-blur-sm rounded-2xl p-8 border border-gray-700/50 hover:border-blue-500/50 transition-all duration-300 hover:shadow-2xl hover:shadow-blue-500/20 hover:-translate-y-2">
              <div
                class="absolute -top-4 left-8 w-12 h-12 bg-gradient-to-br from-blue-500 to-blue-600 rounded-full flex items-center justify-center shadow-lg border-4 border-[#001429] group-hover:scale-110 transition-transform duration-300">
                <span class="text-white font-bold text-xl">3</span>
              </div>

              <div class="mt-6">
                <div
                  class="w-16 h-16 mb-4 bg-gradient-to-br from-blue-500/20 to-blue-600/20 rounded-xl flex items-center justify-center group-hover:scale-110 transition-transform duration-300">
                  <i class="fa-solid fa-bell text-3xl text-blue-400"></i>
                </div>

                <h3 class="text-2xl font-bold text-white mb-3 group-hover:text-blue-400 transition-colors duration-300">
                  {t("home.step_3_h3")}
                </h3>
                <p class="text-gray-300 leading-relaxed mb-6">
                  {t("home.step_3_p_pre")} <span class="text-blue-400 font-medium">{t("home.step_3_p_highlight_1")}</span>{t("home.step_3_p_mid")}
                  <span class="font-medium">{t("home.step_3_p_highlight_2")}</span>{t("home.step_3_p_post")}
                </p>

                <a href="https://app.pickmytrade.trade/?register=true"
                  class="inline-flex items-center justify-center gap-2 w-full bg-gradient-to-r from-blue-600 to-blue-700 hover:from-blue-700 hover:to-blue-800 text-white font-semibold py-3 px-6 rounded-lg transition-all duration-300 transform hover:scale-105 hover:shadow-lg group/btn">
                  <span>{t("home.step_3_btn")}</span>
                  <i class="fa-solid fa-arrow-right group-hover/btn:translate-x-1 transition-transform"></i>
                </a>
              </div>
            </div>

            <!-- Step 4 -->
            <div
              class="group relative bg-gradient-to-br from-gray-800/50 to-gray-900/50 backdrop-blur-sm rounded-2xl p-8 border border-gray-700/50 hover:border-blue-500/50 transition-all duration-300 hover:shadow-2xl hover:shadow-blue-500/20 hover:-translate-y-2">
              <div
                class="absolute -top-4 left-8 w-12 h-12 bg-gradient-to-br from-blue-500 to-blue-600 rounded-full flex items-center justify-center shadow-lg border-4 border-[#001429] group-hover:scale-110 transition-transform duration-300">
                <span class="text-white font-bold text-xl">4</span>
              </div>

              <div class="mt-6">
                <div
                  class="w-16 h-16 mb-4 bg-gradient-to-br from-blue-500/20 to-blue-600/20 rounded-xl flex items-center justify-center group-hover:scale-110 transition-transform duration-300">
                  <i class="fa-solid fa-rocket text-3xl text-blue-400"></i>
                </div>

                <h3 class="text-2xl font-bold text-white mb-3 group-hover:text-blue-400 transition-colors duration-300">
                  {t("home.step_4_h3")}
                </h3>
                <p class="text-gray-300 leading-relaxed mb-6">
                  {t("home.step_4_p_pre")} <span class="text-blue-400 font-medium">{t("home.step_4_p_highlight")}</span> {t("home.step_4_p_post")}
                </p>

                <a href="https://www.tradingview.com/" target="_blank"
                  class="inline-flex items-center justify-center gap-2 w-full bg-gradient-to-r from-blue-600 to-blue-700 hover:from-blue-700 hover:to-blue-800 text-white font-semibold py-3 px-6 rounded-lg transition-all duration-300 transform hover:scale-105 hover:shadow-lg group/btn">
                  <span>{t("home.step_4_btn")}</span>
                  <i class="fa-solid fa-arrow-right group-hover/btn:translate-x-1 transition-transform"></i>
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
    <section class="w-full py-12 md:py-24 lg:py-32  mx-auto">
      <div class="grid items-center justify-center gap-4">
