---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import FaqItem from "../../../components/FaqItem.astro";
import { getLocalePaths, useTranslations, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { subscriptionOfferExtras } from "../../../lib/schema";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };
const t = useTranslations(locale);

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [1, 2, 3, 4, 5, 6, 7, 8].map((n) => ({
    "@type": "Question",
    "name": t(`copier.take_profit_faq_${n}_q` as any),
    "acceptedAnswer": { "@type": "Answer", "text": t(`copier.take_profit_faq_${n}_a` as any) },
  })),
};

const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": t("copier.shared_breadcrumb_home"), "item": `${SITE_URL}${withSlash(localizedPath(locale))}` },
    { "@type": "ListItem", "position": 2, "name": "Trade Copiers", "item": `${SITE_URL}${withSlash(localizedPath(locale, "tradovate-trade-copier"))}` },
    { "@type": "ListItem", "position": 3, "name": t("copier.take_profit_name"), "item": `${SITE_URL}${withSlash(localizedPath(locale, "copier/tradovate-to-take-profit-trader-copier"))}` },
  ],
};


const productSchema = {
  "@context": "https://schema.org",
  "@type": "Product",
  "name": "PickMyTrade Take Profit Trader Trade Copier",
  "image": `${SITE_URL}/assets/logo.png`,
  "description": "Cloud trade copier that copies one TradingView alert or one manual trade across your Take Profit Trader accounts on Tradovate. Per-account multipliers, under 200ms order processing on our side, self-owned accounts only. No VPS, no coding.",
  "brand": { "@type": "Brand", "name": "PickMyTrade" },
  "url": `${SITE_URL}${withSlash(localizedPath(locale, "copier/tradovate-to-take-profit-trader-copier"))}`,
  "offers": {
    "@type": "Offer",
    "price": "50.00",
    "priceCurrency": "USD",
    "priceValidUntil": "2026-12-31",
    "availability": "https://schema.org/InStock",
    "url": `${SITE_URL}${withSlash(localizedPath(locale, "pages/pricing"))}`,
    "description": "$50 per month or $500 per year. 7-day free trial, no credit card required.",
    ...subscriptionOfferExtras,
  },
};
---

<BaseLayout
  locale={locale}
  title={t("copier.take_profit_meta_title")}
  description={t("copier.take_profit_meta_description")}
  ldJson={[faqSchema, breadcrumbSchema, productSchema]}
>
  <style>
    .electrolize-regular { font-family: 'Electrolize', sans-serif; }
    .gradient-text { background: linear-gradient(135deg, #2B77EE, #0F3EC3); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; }
  </style>

  <div class="bg-[#001429]">
    <!-- Hero -->
    <section class="py-16 lg:py-24 border-b border-blue-900/30 bg-gradient-to-b from-[#001429] to-[#002040]">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center">
          <span class="inline-block px-4 py-2 bg-blue-600/20 text-blue-400 rounded-full text-sm font-semibold mb-4 border border-blue-500/30 tracking-wide uppercase" electrolize-regular>{t("copier.take_profit_hero_badge")}</span>
          <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold text-white mb-6 tracking-tight leading-tight">
            {t("copier.take_profit_h1")}
          </h1>
          <p class="text-xl md:text-2xl text-gray-300 max-w-3xl mx-auto leading-relaxed">
            {t("copier.take_profit_hero_subtitle")}
          </p>
          <div class="flex flex-wrap justify-center mt-8 gap-3 sm:gap-4 text-sm sm:text-base">
            <div class="flex items-center gap-2 bg-white/5 backdrop-blur-sm border border-white/10 rounded-full px-4 py-2 hover:bg-white/10 transition-all">
              <i class="fa-solid fa-check-circle text-green-400" aria-hidden="true"></i>
              <span class="text-gray-300">{t("copier.shared_hero_feat1")}</span>
            </div>
            <div class="flex items-center gap-2 bg-white/5 backdrop-blur-sm border border-white/10 rounded-full px-4 py-2 hover:bg-white/10 transition-all">
              <i class="fa-solid fa-bolt text-yellow-400" aria-hidden="true"></i>
              <span class="text-gray-300">{t("copier.shared_hero_feat2")}</span>
            </div>
            <div class="flex items-center gap-2 bg-white/5 backdrop-blur-sm border border-white/10 rounded-full px-4 py-2 hover:bg-white/10 transition-all">
              <i class="fa-solid fa-infinity text-purple-400" aria-hidden="true"></i>
              <span class="text-gray-300">{t("copier.shared_hero_feat3")}</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Introduction -->
    <section class="py-16 border-b border-gray-800">
      <div class="max-w-4xl mx-auto px-4">
        <h2 class="text-2xl font-bold text-white mb-4">{t("copier.shared_intro_h2")}</h2>
        <h3 class="text-xl text-gray-200 mb-6">{t("copier.shared_intro_h3_pre")}{t("copier.take_profit_name")}</h3>
        <p class="text-gray-400 mb-4">{t("copier.take_profit_intro_p1")}</p>
        <p class="text-gray-400 mb-4">{t("copier.take_profit_intro_p2")}</p>
        <p class="text-gray-400">{t("copier.take_profit_intro_p3")}</p>
      </div>
    </section>

    <!-- Methods -->
    <section class="py-16 md:py-24 border-b border-blue-900/30 bg-gradient-to-b from-[#002040] to-[#001429]">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
          <span class="inline-block px-4 py-2 bg-blue-600/20 text-blue-400 rounded-full text-sm font-semibold mb-4 border border-blue-500/30">
            {t("copier.shared_methods_badge")}
          </span>
          <h2 class="text-3xl md:text-4xl font-bold text-white mb-4 tracking-tight">{t("copier.shared_methods_h2_pre")}{t("copier.take_profit_name")}</h2>
          <p class="text-gray-300 text-lg max-w-2xl mx-auto">{t("copier.shared_methods_subtitle")}</p>
        </div>
        <div class="space-y-6">
          <div class="group bg-gradient-to-br from-gray-800/50 to-gray-900/50 backdrop-blur-sm rounded-xl p-6 border border-gray-700/50 hover:border-green-500/50 transition-all duration-300 hover:shadow-2xl hover:shadow-green-500/20 hover:-translate-y-2">
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 bg-gradient-to-br from-green-500/20 to-green-600/20 rounded-xl flex items-center justify-center group-hover:scale-110 transition-transform duration-300">
                <i class="fas fa-check text-green-400 text-xl"></i>
              </div>
              <div>
                <h4 class="text-xl font-bold text-white mb-2 group-hover:text-green-400 transition-colors">{t("copier.shared_method1_h4_pre")}<span class="text-green-400 text-sm">{t("copier.shared_method1_recommended")}</span></h4>
                <p class="text-gray-300 leading-relaxed">{t("copier.shared_method1_p_pre")}{t("copier.take_profit_name")}{t("copier.shared_method1_p_post")}</p>
              </div>
            </div>
          </div>
          <div class="group bg-gradient-to-br from-gray-800/50 to-gray-900/50 backdrop-blur-sm rounded-xl p-6 border border-gray-700/50 hover:border-yellow-500/50 transition-all duration-300 hover:shadow-2xl hover:shadow-yellow-500/20 hover:-translate-y-2">
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 bg-gradient-to-br from-yellow-500/20 to-yellow-600/20 rounded-xl flex items-center justify-center group-hover:scale-110 transition-transform duration-300">
                <i class="fas fa-code text-yellow-400 text-xl"></i>
              </div>
              <div>
                <h4 class="text-xl font-bold text-white mb-2 group-hover:text-yellow-400 transition-colors">{t("copier.shared_method2_h4")}</h4>
                <p class="text-gray-300 leading-relaxed">{t("copier.shared_method2_p")}</p>
              </div>
            </div>
          </div>
          <div class="group bg-gradient-to-br from-gray-800/50 to-gray-900/50 backdrop-blur-sm rounded-xl p-6 border border-gray-700/50 hover:border-red-500/50 transition-all duration-300 hover:shadow-2xl hover:shadow-red-500/20 hover:-translate-y-2">
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 bg-gradient-to-br from-red-500/20 to-red-600/20 rounded-xl flex items-center justify-center group-hover:scale-110 transition-transform duration-300">
                <i class="fas fa-times text-red-400 text-xl"></i>
              </div>
              <div>
                <h4 class="text-xl font-bold text-white mb-2 group-hover:text-red-400 transition-colors">{t("copier.shared_method3_h4")}</h4>
                <p class="text-gray-300 leading-relaxed">{t("copier.shared_method3_p")}</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Step-by-Step -->
    <section class="py-16 md:py-24 border-b border-gray-800">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
          <span class="inline-block px-4 py-2 bg-blue-600/20 text-blue-400 rounded-full text-sm font-semibold mb-4 border border-blue-500/30">
            {t("copier.shared_steps_badge")}
          </span>
          <h2 class="text-3xl md:text-4xl font-bold text-white mb-4 tracking-tight">{t("copier.shared_steps_h2")}</h2>
          <p class="text-gray-300 text-lg max-w-2xl mx-auto">{t("copier.shared_steps_subtitle_pre")}{t("copier.take_profit_name")}{t("copier.shared_steps_subtitle_post")}</p>
        </div>
        <div class="space-y-6">
          <div class="group bg-gradient-to-br from-gray-800/50 to-gray-900/50 backdrop-blur-sm rounded-xl p-6 border border-gray-700/50 hover:border-blue-500/50 transition-all duration-300">
            <div class="flex gap-6">
              <div class="w-12 h-12 bg-gradient-to-br from-blue-500 to-blue-600 rounded-full flex items-center justify-center text-white font-bold flex-shrink-0 shadow-lg group-hover:scale-110 transition-transform">1</div>
              <div>
                <h4 class="text-xl font-bold text-white mb-2 group-hover:text-blue-400 transition-colors">{t("copier.shared_step1_h4")}</h4>
                <p class="text-gray-300 leading-relaxed">{t("copier.shared_step1_p_pre")}<a href="https://app.pickmytrade.trade/?register=true" class="text-blue-400 hover:underline font-semibold">{t("copier.shared_step1_p_link")}</a>{t("copier.shared_step1_p_post")}</p>
              </div>
            </div>
          </div>
          <div class="group bg-gradient-to-br from-gray-800/50 to-gray-900/50 backdrop-blur-sm rounded-xl p-6 border border-gray-700/50 hover:border-blue-500/50 transition-all duration-300">
            <div class="flex gap-6">
              <div class="w-12 h-12 bg-gradient-to-br from-blue-500 to-blue-600 rounded-full flex items-center justify-center text-white font-bold flex-shrink-0 shadow-lg group-hover:scale-110 transition-transform">2</div>
              <div>
                <h4 class="text-xl font-bold text-white mb-2 group-hover:text-blue-400 transition-colors">{t("copier.shared_step2_h4_pre")}{t("copier.take_profit_name")}{t("copier.shared_step2_h4_post")}</h4>
                <p class="text-gray-300 leading-relaxed">{t("copier.shared_step2_p_pre")}{t("copier.take_profit_name")}{t("copier.shared_step2_p_post")}</p>
              </div>
            </div>
          </div>
          <div class="group bg-gradient-to-br from-gray-800/50 to-gray-900/50 backdrop-blur-sm rounded-xl p-6 border border-gray-700/50 hover:border-blue-500/50 transition-all duration-300">
            <div class="flex gap-6">
              <div class="w-12 h-12 bg-gradient-to-br from-blue-500 to-blue-600 rounded-full flex items-center justify-center text-white font-bold flex-shrink-0 shadow-lg group-hover:scale-110 transition-transform">3</div>
              <div>
                <h4 class="text-xl font-bold text-white mb-2 group-hover:text-blue-400 transition-colors">{t("copier.shared_step3_h4")}</h4>
                <p class="text-gray-300 leading-relaxed">{t("copier.shared_step3_p")}</p>
              </div>
            </div>
          </div>
          <div class="group bg-gradient-to-br from-gray-800/50 to-gray-900/50 backdrop-blur-sm rounded-xl p-6 border border-gray-700/50 hover:border-blue-500/50 transition-all duration-300">
            <div class="flex gap-6">
              <div class="w-12 h-12 bg-gradient-to-br from-blue-500 to-blue-600 rounded-full flex items-center justify-center text-white font-bold flex-shrink-0 shadow-lg group-hover:scale-110 transition-transform">4</div>
              <div>
                <h4 class="text-xl font-bold text-white mb-2 group-hover:text-blue-400 transition-colors">{t("copier.shared_step4_h4")}</h4>
                <p class="text-gray-300 leading-relaxed">{t("copier.shared_step4_p")}</p>
              </div>
            </div>
          </div>
          <div class="group bg-gradient-to-br from-gray-800/50 to-gray-900/50 backdrop-blur-sm rounded-xl p-6 border border-green-700/50 hover:border-green-500/50 transition-all duration-300">
            <div class="flex gap-6">
              <div class="w-12 h-12 bg-gradient-to-br from-green-500 to-green-600 rounded-full flex items-center justify-center text-white font-bold flex-shrink-0 shadow-lg group-hover:scale-110 transition-transform">5</div>
              <div>
                <h4 class="text-xl font-bold text-white mb-2 group-hover:text-green-400 transition-colors">{t("copier.shared_step5_h4")}</h4>
                <p class="text-gray-300 leading-relaxed">{t("copier.shared_step5_p_pre")}{t("copier.take_profit_name")}{t("copier.shared_step5_p_post")}</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Features -->
    <section class="py-16 md:py-24 border-b border-blue-900/30 bg-gradient-to-b from-[#002040] to-[#001429]">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
          <span class="inline-block px-4 py-2 bg-blue-600/20 text-blue-400 rounded-full text-sm font-semibold mb-4 border border-blue-500/30">
            {t("copier.shared_features_badge")}
          </span>
          <h2 class="text-3xl md:text-4xl font-bold text-white mb-4 tracking-tight">{t("copier.shared_features_h2_pre")}{t("copier.take_profit_name")}</h2>
          <p class="text-gray-300 text-lg max-w-2xl mx-auto">{t("copier.shared_features_subtitle")}</p>
        </div>
        <div class="grid md:grid-cols-2 gap-6">
          <div class="group bg-gradient-to-br from-gray-800/50 to-gray-900/50 backdrop-blur-sm rounded-xl p-6 border border-gray-700/50 hover:border-blue-500/50 transition-all duration-300 hover:shadow-2xl hover:shadow-blue-500/20 hover:-translate-y-2">
            <div class="w-14 h-14 bg-gradient-to-br from-blue-500/20 to-blue-600/20 rounded-xl flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
              <i class="fas fa-shield-alt text-blue-400 text-2xl"></i>
            </div>
            <h4 class="text-xl font-bold text-white mb-2 group-hover:text-blue-400 transition-colors">{t("copier.shared_feat1_h4")}</h4>
            <p class="text-gray-300 leading-relaxed">{t("copier.take_profit_feat1_p")}</p>
          </div>
          <div class="group bg-gradient-to-br from-gray-800/50 to-gray-900/50 backdrop-blur-sm rounded-xl p-6 border border-gray-700/50 hover:border-green-500/50 transition-all duration-300 hover:shadow-2xl hover:shadow-green-500/20 hover:-translate-y-2">
            <div class="w-14 h-14 bg-gradient-to-br from-green-500/20 to-green-600/20 rounded-xl flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
              <i class="fas fa-bolt text-green-400 text-2xl"></i>
            </div>
            <h4 class="text-xl font-bold text-white mb-2 group-hover:text-green-400 transition-colors">{t("copier.shared_feat2_h4")}</h4>
            <p class="text-gray-300 leading-relaxed">{t("copier.shared_feat2_p_pre")}{t("copier.take_profit_name")}{t("copier.shared_feat2_p_post")}</p>
          </div>
          <div class="group bg-gradient-to-br from-gray-800/50 to-gray-900/50 backdrop-blur-sm rounded-xl p-6 border border-gray-700/50 hover:border-purple-500/50 transition-all duration-300 hover:shadow-2xl hover:shadow-purple-500/20 hover:-translate-y-2">
            <div class="w-14 h-14 bg-gradient-to-br from-purple-500/20 to-purple-600/20 rounded-xl flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
              <i class="fas fa-users text-purple-400 text-2xl"></i>
            </div>
            <h4 class="text-xl font-bold text-white mb-2 group-hover:text-purple-400 transition-colors">{t("copier.shared_feat3_h4")}</h4>
            <p class="text-gray-300 leading-relaxed">{t("copier.take_profit_feat3_p")}</p>
          </div>
          <div class="group bg-gradient-to-br from-gray-800/50 to-gray-900/50 backdrop-blur-sm rounded-xl p-6 border border-gray-700/50 hover:border-yellow-500/50 transition-all duration-300 hover:shadow-2xl hover:shadow-yellow-500/20 hover:-translate-y-2">
            <div class="w-14 h-14 bg-gradient-to-br from-yellow-500/20 to-yellow-600/20 rounded-xl flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
              <i class="fas fa-chart-line text-yellow-400 text-2xl"></i>
            </div>
            <h4 class="text-xl font-bold text-white mb-2 group-hover:text-yellow-400 transition-colors">{t("copier.shared_feat4_h4")}</h4>
            <p class="text-gray-300 leading-relaxed">{t("copier.shared_feat4_p")}</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Use Cases -->
    <section class="py-16 border-b border-gray-800">
      <div class="max-w-4xl mx-auto px-4">
        <h2 class="text-2xl font-bold text-white mb-8">{t("copier.shared_usecases_h3_pre")}{t("copier.take_profit_name")}{t("copier.shared_usecases_h3_post")}</h2>
        <div class="space-y-6">
          <div class="flex gap-4"><div class="w-2 bg-cyan-500 rounded-full"></div><div><h4 class="font-semibold text-white">{t("copier.take_profit_usecase1_h4")}</h4><p class="text-gray-400">{t("copier.take_profit_usecase1_p")}</p></div></div>
          <div class="flex gap-4"><div class="w-2 bg-blue-500 rounded-full"></div><div><h4 class="font-semibold text-white">{t("copier.shared_usecase2_h4")}</h4><p class="text-gray-400">{t("copier.shared_usecase2_p_pre")}{t("copier.take_profit_name")}{t("copier.shared_usecase2_p_post")}</p></div></div>
          <div class="flex gap-4"><div class="w-2 bg-purple-500 rounded-full"></div><div><h4 class="font-semibold text-white">{t("copier.shared_usecase3_h4")}</h4><p class="text-gray-400">{t("copier.shared_usecase3_p_pre")}{t("copier.take_profit_name")}{t("copier.shared_usecase3_p_post")}</p></div></div>
        </div>
      </div>
    </section>

    <!-- Best Practices -->
    <section class="py-16 border-b border-blue-900/30 bg-[#002040]">
      <div class="max-w-4xl mx-auto px-4">
        <h2 class="text-2xl font-bold text-white mb-8">{t("copier.shared_bestpractices_h3_pre")}{t("copier.take_profit_name")}{t("copier.shared_bestpractices_h3_post")}</h2>
        <div class="space-y-4">
          <div class="bg-[#12121a] rounded-lg p-4 border border-gray-800 flex gap-4"><div class="text-blue-400"><i class="fas fa-lightbulb"></i></div><div><h4 class="font-semibold text-white">{t("copier.shared_practice1_h4")}</h4><p class="text-gray-400 text-sm">{t("copier.shared_practice1_p")}</p></div></div>
          <div class="bg-[#12121a] rounded-lg p-4 border border-gray-800 flex gap-4"><div class="text-green-400"><i class="fas fa-balance-scale"></i></div><div><h4 class="font-semibold text-white">{t("copier.shared_practice2_h4")}</h4><p class="text-gray-400 text-sm">{t("copier.shared_practice2_p")}</p></div></div>
          <div class="bg-[#12121a] rounded-lg p-4 border border-gray-800 flex gap-4"><div class="text-cyan-400"><i class="fas fa-clock"></i></div><div><h4 class="font-semibold text-white">{t("copier.take_profit_practice3_h4")}</h4><p class="text-gray-400 text-sm">{t("copier.take_profit_practice3_p")}</p></div></div>
        </div>
      </div>
    </section>

    <!-- Compliance / Hedge Section -->
    <section class="py-16 border-b border-blue-900/30 bg-gradient-to-b from-[#001429] to-[#002040]">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 prose-section">
        <span class="inline-block px-4 py-2 bg-yellow-600/20 text-yellow-400 rounded-full text-sm font-semibold mb-6 border border-yellow-500/30 uppercase electrolize-regular">
          {t("copier.shared_bestpractices_h2")}
        </span>
        <h2 class="text-3xl font-bold text-white mb-4">{t("copier.take_profit_hedge_h2")}</h2>
        <div class="prose prose-lg prose-invert max-w-none">
          <p class="text-gray-400 mb-4">{t("copier.take_profit_hedge_p1")}</p>
          <p class="text-gray-400 mb-4">{t("copier.take_profit_hedge_p2")}</p>
          <p class="text-gray-400">{t("copier.take_profit_hedge_p3")}</p>
        </div>
      </div>
    </section>

    <!-- Pricing Section -->
    <section class="py-16 border-b border-gray-800">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h2 class="text-3xl font-bold text-white mb-4">{t("copier.take_profit_pricing_h2")}</h2>
        <p class="text-gray-300 text-lg max-w-2xl mx-auto">{t("copier.take_profit_pricing_p")}</p>
      </div>
    </section>

    <!-- Why PickMyTrade Section -->
    <section class="py-16 md:py-24 border-b border-blue-900/30 bg-gradient-to-b from-[#002040] to-[#001429]">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
          <h2 class="text-3xl md:text-4xl font-bold text-white mb-4 tracking-tight">{t("copier.take_profit_why_h2")}</h2>
        </div>
