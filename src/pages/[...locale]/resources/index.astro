---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getLocalePaths, localizedPath, useTranslations } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { PARTNER_CATEGORIES, PARTNERS, categoryLabel } from "../../../data/partners";
import { guidesBySection } from "../../../data/guides";

const DEBUGGING_GUIDES = guidesBySection("debugging");
const HOWTO_GUIDES = guidesBySection("how-to");

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };
const t = useTranslations(locale);

const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);

const collectionSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "PickMyTrade Ecosystem Guide",
  url: `${SITE_URL}${withSlash(localizedPath(locale, "resources"))}`,
  description:
    "Independent guides to the market-data, charting, education, prop-firm research, journaling, and TradingView indicator tools futures traders already use, and how each pairs with PickMyTrade's TradingView-to-broker automation.",
  isPartOf: { "@type": "WebSite", name: "PickMyTrade", url: SITE_URL },
  publisher: { "@id": `${SITE_URL}/#organization` },
  datePublished: "2026-08-17",
  dateModified: "2026-08-17",
  hasPart: PARTNERS.map((p) => ({
    "@type": "WebPage",
    name: p.name,
    url: `${SITE_URL}${withSlash(localizedPath(locale, p.slug))}`,
  })),
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: `${SITE_URL}${withSlash(localizedPath(locale))}` },
    { "@type": "ListItem", position: 2, name: "Resources", item: `${SITE_URL}${withSlash(localizedPath(locale, "resources"))}` },
  ],
};
---

<BaseLayout
  locale={locale}
  title={t("partners_hub.meta_title")}
  description={t("partners_hub.meta_description")}
  ldJson={[collectionSchema, breadcrumbSchema]}
>
  <div class="bg-[#001429]">
    <!-- Hero -->
    <section class="py-16 lg:py-24 border-b border-blue-900/30 bg-gradient-to-b from-[#001429] to-[#002040]">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <span class="inline-block px-4 py-2 bg-blue-600/20 text-blue-400 rounded-full text-sm font-semibold mb-6 border border-blue-500/30 uppercase electrolize">
          {t("partners_hub.badge")}
        </span>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold text-white mb-6 tracking-tight">
          {t("partners_hub.h1")}
        </h1>
        <p class="text-xl md:text-2xl text-gray-300 max-w-3xl mx-auto leading-relaxed">
          {t("partners_hub.subtitle")}
        </p>
      </div>
    </section>

    <!-- Categories -->
    <section class="py-16 md:py-24">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        {PARTNER_CATEGORIES.map((category, i) => {
          const items = PARTNERS.filter((p) => p.category === category.name);
          return (
            <div id={category.anchor} class={i === 0 ? "scroll-mt-24" : "scroll-mt-24 mt-16"}>
              <h2 class="text-2xl md:text-3xl font-bold text-white mb-8 pb-3 border-b-2 border-[#2B77EE] tracking-tight">
                {categoryLabel(category.name, locale)}
              </h2>
              <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                {items.map((p) => (
                  <a
                    href={localizedPath(locale, p.slug)}
                    class="bg-[#00203f] border border-white/10 rounded-xl p-5 hover:border-[#2B77EE]/50 hover:bg-[#002850] transition-all group"
                  >
                    <h3 class="text-white font-bold text-lg electrolize group-hover:text-[#2B77EE] transition-colors mb-2">
                      {p.name}
                    </h3>
                    <p class="text-gray-400 text-sm mb-3 leading-relaxed">{p.blurb[locale]}</p>
                    <span class="text-[#2B77EE] text-xs font-semibold inline-flex items-center gap-1 group-hover:gap-2 transition-all">
                      {t("partners_hub.read_guide")} <i class="fa-solid fa-arrow-right text-[10px]"></i>
                    </span>
                  </a>
                ))}
              </div>
            </div>
          );
        })}
      </div>
    </section>

    <!-- Troubleshooting & Setup Guides -->
    <section id="troubleshooting-guides" class="py-16 md:py-24 border-t border-blue-900/30 bg-gradient-to-b from-[#001429] to-[#002040]">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between gap-4 mb-8 pb-3 border-b-2 border-[#2B77EE] flex-wrap">
          <h2 class="text-2xl md:text-3xl font-bold text-white tracking-tight">
            {t("partners_hub.debugging_section_heading")}
          </h2>
          <a href={localizedPath(locale, "debugging")} class="text-[#2B77EE] text-sm font-semibold inline-flex items-center gap-1 hover:gap-2 transition-all">
            {t("partners_hub.view_all")} <i class="fa-solid fa-arrow-right text-[10px]"></i>
          </a>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
          {DEBUGGING_GUIDES.map((g) => (
            <a
              href={localizedPath(locale, `debugging/${g.slug}`)}
              class="bg-[#00203f] border border-white/10 rounded-xl p-5 hover:border-[#2B77EE]/50 hover:bg-[#002850] transition-all group"
            >
              <span class="inline-block px-2.5 py-1 bg-blue-600/20 text-blue-400 rounded-full text-[10px] font-semibold mb-3 border border-blue-500/30 uppercase electrolize">
                {g.badge}
              </span>
              <h3 class="text-white font-bold text-lg electrolize group-hover:text-[#2B77EE] transition-colors mb-2">
                {g.title[locale]}
              </h3>
              <p class="text-gray-400 text-sm mb-3 leading-relaxed">{g.description[locale]}</p>
              <span class="text-[#2B77EE] text-xs font-semibold inline-flex items-center gap-1 group-hover:gap-2 transition-all">
                {t("partners_hub.read_guide")} <i class="fa-solid fa-arrow-right text-[10px]"></i>
              </span>
            </a>
          ))}
        </div>

        <div class="flex items-center justify-between gap-4 mt-16 mb-8 pb-3 border-b-2 border-[#2B77EE] flex-wrap">
          <h2 class="text-2xl md:text-3xl font-bold text-white tracking-tight">
            {t("partners_hub.howto_section_heading")}
          </h2>
          <a href={localizedPath(locale, "how-to")} class="text-[#2B77EE] text-sm font-semibold inline-flex items-center gap-1 hover:gap-2 transition-all">
            {t("partners_hub.view_all")} <i class="fa-solid fa-arrow-right text-[10px]"></i>
          </a>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
          {HOWTO_GUIDES.map((g) => (
            <a
              href={localizedPath(locale, `how-to/${g.slug}`)}
              class="bg-[#00203f] border border-white/10 rounded-xl p-5 hover:border-[#2B77EE]/50 hover:bg-[#002850] transition-all group"
            >
              <span class="inline-block px-2.5 py-1 bg-blue-600/20 text-blue-400 rounded-full text-[10px] font-semibold mb-3 border border-blue-500/30 uppercase electrolize">
                {g.badge}
              </span>
              <h3 class="text-white font-bold text-lg electrolize group-hover:text-[#2B77EE] transition-colors mb-2">
                {g.title[locale]}
              </h3>
              <p class="text-gray-400 text-sm mb-3 leading-relaxed">{g.description[locale]}</p>
              <span class="text-[#2B77EE] text-xs font-semibold inline-flex items-center gap-1 group-hover:gap-2 transition-all">
                {t("partners_hub.read_guide")} <i class="fa-solid fa-arrow-right text-[10px]"></i>
              </span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="py-16 border-t border-blue-900/30">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <div class="bg-gradient-to-r from-blue-600/20 to-purple-600/20 rounded-3xl p-12 border border-blue-500/30">
          <h2 class="text-3xl font-bold text-white mb-4">{t("partners_hub.cta_heading")}</h2>
          <p class="text-gray-300 mb-8 max-w-2xl mx-auto">
            {t("partners_hub.cta_text")}
          </p>
          <div class="flex flex-col sm:flex-row justify-center gap-4">
            <a
              href="https://app.pickmytrade.trade/?register=true"
              class="inline-flex items-center justify-center gap-2 px-8 py-4 bg-gradient-to-r from-blue-600 to-blue-700 hover:from-blue-700 hover:to-blue-800 text-white rounded-xl font-bold transition-all transform hover:scale-105 shadow-xl"
            >
              <i class="fas fa-rocket"></i> {t("partners_hub.cta_primary")}
            </a>
            <a
              href={localizedPath(locale, "pages/pricing")}
              class="inline-flex items-center justify-center gap-2 px-8 py-4 bg-white/10 hover:bg-white/20 text-white rounded-xl font-bold border border-white/20 transition-all"
            >
              <i class="fas fa-tag"></i> {t("partners_hub.cta_secondary")}
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Disclosure -->
    <section class="py-10 px-4 border-t border-white/10" aria-label="Disclosure">
      <div class="max-w-4xl mx-auto">
        <p class="text-xs text-white/40 leading-relaxed italic">
          {t("partners_hub.disclosure")}
        </p>
      </div>
    </section>
  </div>
</BaseLayout>
