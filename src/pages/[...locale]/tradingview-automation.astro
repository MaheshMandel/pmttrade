---
import BaseLayout from "../../layouts/BaseLayout.astro";
import FaqItem from "../../components/FaqItem.astro";
import { getLocalePaths, useTranslations, localizedPath } from "../../i18n/utils";
import type { Locale } from "../../i18n/config";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };
const t = useTranslations(locale);

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": Array.from({ length: 10 }, (_, i) => i + 1).map((n) => ({
    "@type": "Question",
    "name": t(`tradingview_automation.faq_${n}_q` as any),
    "acceptedAnswer": { "@type": "Answer", "text": t(`tradingview_automation.faq_${n}_a` as any) },
  })),
};

const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);

// Section D broker grid — Tradovate stays on this site, the rest are set up on pickmytrade.io.
const brokerLinks = [
  { name: "Tradovate", href: localizedPath(locale, "tradingview-to-tradovate") },
  { name: "Rithmic", href: "https://pickmytrade.io/broker/tradingview-to-rithmic/" },
  { name: "Interactive Brokers", href: "https://pickmytrade.io/broker/tradingview-to-ib/" },
  { name: "TradeStation", href: "https://pickmytrade.io/broker/tradingview-to-tradestation/" },
  { name: "TradeLocker", href: "https://pickmytrade.io/broker/tradingview-to-tradelocker/" },
  { name: "ProjectX / TopstepX", href: "https://pickmytrade.io/broker/tradingview-to-projectx/" },
  { name: "Match-Trader", href: "https://pickmytrade.io/broker/tradingview-to-matchtrader/" },
  { name: "Tradier (Beta)", href: "https://pickmytrade.io/broker/tradingview-to-tradier/" },
  { name: "cTrader (Beta)", href: "https://pickmytrade.io/broker/tradingview-to-ctrader/" },
  { name: "Ironbeam (Beta)", href: "https://pickmytrade.io/broker/tradingview-to-ironbeam/" },
];

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": `${SITE_URL}${withSlash(localizedPath(locale))}` },
    { "@type": "ListItem", "position": 2, "name": "TradingView Automation", "item": `${SITE_URL}${withSlash(localizedPath(locale, "tradingview-automation"))}` },
  ],
};

---

<BaseLayout
  locale={locale}
  title={t("tradingview_automation.meta_title")}
  description={t("tradingview_automation.meta_description")}
  ldJson={[faqSchema, breadcrumbSchema]}
>
  <style>
    .electrolize-regular {
      font-family: 'Electrolize', sans-serif;
    }

    .gradient-text {
      background: linear-gradient(135deg, #2B77EE, #0F3EC3);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    .code-block {
      background: #0a1628;
      border-left: 3px solid #2B77EE;
      font-family: 'Courier New', monospace;
    }

    .decision-box {
      background: linear-gradient(135deg, #1e3a8a 0%, #1e40af 100%);
    }
  </style>

  <div class="bg-[#001429]">
    <!-- Hero Section -->
    <section class="py-16 lg:py-24 border-b border-blue-900/30 bg-gradient-to-b from-[#001429] to-[#002040]">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
          <span
            class="inline-block px-4 py-2 bg-blue-600/20 text-blue-400 rounded-full text-sm font-semibold mb-6 border border-blue-500/30 tracking-wide uppercase electrolize-regular">{t("tradingview_automation.hero_badge")}</span>
          <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold text-white mb-6 tracking-tight leading-tight">
            {t("tradingview_automation.hero_h1_pre")} <span class="gradient-text">{t("tradingview_automation.hero_h1_highlight")}</span>
          </h1>
          <p class="text-xl md:text-2xl text-gray-300 max-w-4xl mx-auto leading-relaxed mb-8">
            {t("tradingview_automation.hero_subtitle")}
          </p>
        </div>

        <!-- Visual Flow Diagram -->
        <div class="max-w-4xl mx-auto mb-12">
          <div class="flex flex-col md:flex-row items-center justify-center gap-6">
            <div class="flex-1 text-center">
              <div
                class="w-24 h-24 mx-auto bg-white/70 backdrop-blur-sm rounded-xl flex items-center justify-center mb-4 shadow-lg p-4 border border-white/20">
                <img src="/assets/TV-black-short-logo.svg" alt="TradingView" class="w-full h-full object-contain" width="64" height="64" loading="lazy">
              </div>
              <h3 class="text-lg font-bold text-white mb-2">{t("tradingview_automation.hero_flow_tradingview_title")}</h3>
              <p class="text-sm text-gray-400">{t("tradingview_automation.hero_flow_tradingview_subtitle")}</p>
            </div>

            <div class="flex items-center justify-center">
              <i class="fa-solid fa-arrow-right text-blue-400 text-2xl transform md:rotate-0 rotate-90"
                aria-hidden="true"></i>
            </div>

            <div class="flex-1 text-center">
              <div
                class="w-24 h-24 mx-auto bg-white/70 backdrop-blur-sm rounded-xl flex items-center justify-center mb-4 shadow-lg p-4 border border-white/20">
                <img src="/assets/logo.webp" alt="PickMyTrade" class="w-full h-full object-contain" width="64" height="64" loading="lazy">
              </div>
              <h3 class="text-lg font-bold text-white mb-2">{t("tradingview_automation.hero_flow_pickmytrade_title")}</h3>
              <p class="text-sm text-gray-400">{t("tradingview_automation.hero_flow_pickmytrade_subtitle")}</p>
            </div>

            <div class="flex items-center justify-center">
              <i class="fa-solid fa-arrow-right text-blue-400 text-2xl transform md:rotate-0 rotate-90"
                aria-hidden="true"></i>
            </div>

            <div class="flex-1 text-center">
              <div
                class="w-24 h-24 mx-auto bg-white/70 backdrop-blur-sm rounded-xl flex items-center justify-center mb-4 shadow-lg p-4 border border-white/20">
                <img src="/assets/Tradovate.webp" alt="Tradovate" class="w-full h-full object-contain" width="64" height="64" loading="lazy">
              </div>
              <h3 class="text-lg font-bold text-white mb-2">{t("tradingview_automation.hero_flow_tradovate_title")}</h3>
              <p class="text-sm text-gray-400">{t("tradingview_automation.hero_flow_tradovate_subtitle")}</p>
            </div>
          </div>
        </div>

        <div class="text-center">
          <p class="text-gray-400 mb-8">
            <i class="fa-solid fa-book-open text-blue-400 mr-2" aria-hidden="true"></i>
            {t("tradingview_automation.hero_guide_note")}
          </p>
          <a href="#getting-started"
            class="inline-flex items-center justify-center px-8 py-4 text-base font-semibold text-white bg-gradient-to-r from-blue-600 to-blue-700 rounded-lg hover:from-blue-700 hover:to-blue-800 transition-all duration-300 shadow-lg hover:shadow-blue-500/50 hover:scale-105 electrolize-regular">
            {t("tradingview_automation.hero_cta")}
            <i class="fa-solid fa-arrow-down ml-2" aria-hidden="true"></i>
          </a>
        </div>
      </div>
    </section>

    <!-- Does TradingView Have Automated Trading Section -->
    <section class="py-14 sm:py-16 border-b border-blue-900/30">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-2xl sm:text-3xl font-bold text-white mb-5">{t("tradingview_automation.secA_h2")}</h2>
        <p class="text-gray-300 leading-relaxed mb-4">{t("tradingview_automation.secA_p1")}</p>
        <p class="text-gray-300 leading-relaxed">{t("tradingview_automation.secA_p2")}</p>
      </div>
    </section>

    <!-- How TradingView Automation Works (Webhook Flow) Section -->
    <section class="py-14 sm:py-16 border-b border-blue-900/30 bg-gradient-to-b from-[#001429] to-[#002040]">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-2xl sm:text-3xl font-bold text-white mb-5">{t("tradingview_automation.secB_h2")}</h2>
        <p class="text-gray-300 leading-relaxed mb-4">{t("tradingview_automation.secB_p1")}</p>
        <p class="text-gray-300 leading-relaxed mb-4">
          <strong class="text-white">{t("tradingview_automation.secB_webhook_label")}</strong> {t("tradingview_automation.secB_webhook_text")}
        </p>
        <p class="text-gray-300 leading-relaxed mb-4">
          <strong class="text-white">{t("tradingview_automation.secB_vps_label")}</strong> {t("tradingview_automation.secB_vps_text")}
        </p>
        <p class="text-gray-400 text-sm">
          {t("tradingview_automation.secB_related_pre")} <a href={localizedPath(locale, "tradovate-automation")} class="text-blue-400 hover:text-blue-300 underline">{t("tradingview_automation.secB_related_link1_text")}</a> {t("tradingview_automation.secB_related_mid")} <a href={localizedPath(locale, "tradovate-trade-copier")} class="text-blue-400 hover:text-blue-300 underline">{t("tradingview_automation.secB_related_link2_text")}</a> {t("tradingview_automation.secB_related_post")}
        </p>
        <p class="text-gray-400 text-sm mt-3">
          {t("tradingview_automation.futures_bot_crosslink_pre")}<a href={localizedPath(locale, "futures-trading-bot")} class="text-blue-400 hover:text-blue-300 underline">{t("tradingview_automation.futures_bot_crosslink_link")}</a>{t("tradingview_automation.futures_bot_crosslink_post")}
        </p>
      </div>
    </section>

    <!-- Getting Started Section -->
    <section id="getting-started" class="py-16 lg:py-20 border-b border-blue-900/30">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16">
          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-white mb-4">
            {t("tradingview_automation.getting_started_h2_pre")} <span class="gradient-text">{t("tradingview_automation.getting_started_h2_highlight")}</span>
          </h2>
          <p class="text-lg text-gray-400 max-w-3xl mx-auto">
            {t("tradingview_automation.getting_started_subtitle")}
          </p>
        </div>

        <div class="grid md:grid-cols-2 gap-8 mb-12">
          <!-- Account Creation -->
          <div class="bg-gradient-to-br from-blue-900/20 to-blue-900/5 border border-blue-500/30 rounded-xl p-8">
            <div class="flex items-center gap-3 mb-6">
              <div class="w-12 h-12 bg-blue-500/20 rounded-lg flex items-center justify-center">
                <i class="fa-solid fa-user-plus text-blue-400 text-xl" aria-hidden="true"></i>
              </div>
              <h3 class="text-2xl font-bold text-white">{t("tradingview_automation.account_creation_title")}</h3>
            </div>
            <p class="text-gray-300 leading-relaxed mb-6">
              {t("tradingview_automation.account_creation_desc")}
            </p>

            <div
              class="bg-gradient-to-r from-blue-900/40 to-cyan-900/40 border-2 border-blue-500/50 rounded-xl p-6 shadow-lg">
              <div class="flex items-start gap-4">
                <div class="w-12 h-12 bg-blue-500/30 rounded-lg flex items-center justify-center flex-shrink-0">
                  <i class="fa-solid fa-circle-info text-blue-400 text-2xl" aria-hidden="true"></i>
                </div>
                <div>
                  <div class="flex items-center gap-2 mb-3">
                    <h4 class="text-xl font-bold text-white">{t("tradingview_automation.account_note_title")}</h4>
                    <span
                      class="px-3 py-1 bg-blue-500/20 text-blue-300 rounded-full text-xs font-semibold uppercase tracking-wide border border-blue-500/30">{t("tradingview_automation.account_note_badge")}</span>
                  </div>
                  <p class="text-base text-gray-200 leading-relaxed">
                    {t("tradingview_automation.account_note_text_pre")} <strong class="text-white">{t("tradingview_automation.account_note_text_strong1")}</strong> {t("tradingview_automation.account_note_text_mid")} <strong class="text-blue-300">{t("tradingview_automation.account_note_text_strong2")}</strong>{t("tradingview_automation.account_note_text_post")}
                  </p>
                </div>
              </div>
            </div>
          </div>

          <!-- Connecting Tradovate -->
          <div class="bg-gradient-to-br from-purple-900/20 to-purple-900/5 border border-purple-500/30 rounded-xl p-8">
            <div class="flex items-center gap-3 mb-6">
              <div class="w-12 h-12 bg-purple-500/20 rounded-lg flex items-center justify-center">
                <i class="fa-solid fa-plug text-purple-400 text-xl" aria-hidden="true"></i>
              </div>
              <h3 class="text-2xl font-bold text-white">{t("tradingview_automation.connect_tradovate_title")}</h3>
            </div>

            <div class="space-y-4 mb-6">
              <div class="flex items-start gap-3">
                <div
                  class="w-8 h-8 bg-purple-600 rounded-full flex items-center justify-center flex-shrink-0 text-white font-bold">
                  1
                </div>
                <div>
                  <p class="text-gray-300">{t("tradingview_automation.connect_step1")}</p>
                </div>
              </div>
              <div class="flex items-start gap-3">
                <div
                  class="w-8 h-8 bg-purple-600 rounded-full flex items-center justify-center flex-shrink-0 text-white font-bold">
                  2
                </div>
                <div>
                  <p class="text-gray-300">{t("tradingview_automation.connect_step2")}</p>
                </div>
              </div>
              <div class="flex items-start gap-3">
                <div
                  class="w-8 h-8 bg-purple-600 rounded-full flex items-center justify-center flex-shrink-0 text-white font-bold">
                  3
                </div>
                <div>
                  <p class="text-gray-300">{t("tradingview_automation.connect_step3")}</p>
                </div>
              </div>
            </div>

            <div class="grid grid-cols-2 gap-4">
              <div class="bg-blue-900/30 border border-blue-500/30 rounded-lg p-4">
                <div class="flex items-center gap-2 mb-2">
                  <i class="fa-solid fa-flask text-blue-400" aria-hidden="true"></i>
                  <h4 class="text-white font-semibold text-sm">{t("tradingview_automation.demo_mode_title")}</h4>
                </div>
                <p class="text-xs text-gray-300">{t("tradingview_automation.demo_mode_desc")}</p>
              </div>
              <div class="bg-green-900/30 border border-green-500/30 rounded-lg p-4">
                <div class="flex items-center gap-2 mb-2">
                  <i class="fa-solid fa-landmark text-green-400" aria-hidden="true"></i>
                  <h4 class="text-white font-semibold text-sm">{t("tradingview_automation.live_mode_title")}</h4>
                </div>
                <p class="text-xs text-gray-300">{t("tradingview_automation.live_mode_desc")}</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Strategy vs Indicator Decision Section -->
    <section class="py-16 lg:py-20 border-b border-blue-900/30 bg-gradient-to-b from-[#001429] to-[#002040]">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16">
          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-white mb-4">
            {t("tradingview_automation.decision_h2_pre")} <span class="gradient-text">{t("tradingview_automation.decision_h2_highlight")}</span>
          </h2>
          <p class="text-lg text-gray-400 max-w-3xl mx-auto">
            {t("tradingview_automation.decision_subtitle")}
          </p>
        </div>

        <div class="grid md:grid-cols-2 gap-8 max-w-5xl mx-auto">
          <!-- TradingView Strategy -->
          <div
            class="bg-gradient-to-br from-blue-900/30 to-blue-900/10 border-2 border-blue-500/40 rounded-xl overflow-hidden hover:border-blue-500/60 transition-all">
            <div class="bg-blue-900/40 px-8 py-6 border-b border-blue-500/30">
              <div class="flex items-center gap-4 mb-3">
                <div class="w-14 h-14 bg-blue-500/30 rounded-lg flex items-center justify-center">
                  <i class="fa-solid fa-gears text-blue-400 text-2xl" aria-hidden="true"></i>
                </div>
                <div>
                  <h3 class="text-2xl font-bold text-white">TradingView</h3>
                  <h4 class="text-xl font-bold gradient-text">{t("tradingview_automation.strategy_type_label")}</h4>
                </div>
              </div>
            </div>
            <div class="p-8 space-y-6">
              <div>
                <h4 class="text-white font-bold mb-2 flex items-center gap-2">
                  <i class="fa-solid fa-search text-blue-400" aria-hidden="true"></i>
                  {t("tradingview_automation.strategy_identify_title")}
                </h4>
                <p class="text-gray-300 text-sm leading-relaxed">
                  {t("tradingview_automation.strategy_identify_desc")}
                </p>
              </div>

              <div>
                <h4 class="text-white font-bold mb-2 flex items-center gap-2">
                  <i class="fa-solid fa-bell text-blue-400" aria-hidden="true"></i>
                  {t("tradingview_automation.strategy_alert_title")}
                </h4>
                <p class="text-gray-300 text-sm leading-relaxed mb-2">
                  {t("tradingview_automation.strategy_alert_desc_pre")} <strong class="text-white">{t("tradingview_automation.strategy_alert_desc_strong")}</strong>{t("tradingview_automation.strategy_alert_desc_post")} <code
                    class="text-blue-400 bg-black/30 px-2 py-1 rounded">{`{{strategy.order.action}}`}</code> {t("tradingview_automation.strategy_alert_desc_post2")}
                </p>
              </div>

              <div>
                <h4 class="text-white font-bold mb-2 flex items-center gap-2">
                  <i class="fa-solid fa-list-check text-blue-400" aria-hidden="true"></i>
                  {t("tradingview_automation.strategy_orders_title")}
                </h4>
                <p class="text-gray-300 text-sm leading-relaxed">
                  {t("tradingview_automation.strategy_orders_desc_pre")} <strong class="text-white">{t("tradingview_automation.strategy_orders_desc_strong")}</strong> {t("tradingview_automation.strategy_orders_desc_post")} <strong
                    class="text-blue-500">
                    <a target="_blank"
                      href="https://docs.pickmytrade.trade/docs/automating-tradingview-strategies-with-limit-orders/">{t("tradingview_automation.strategy_orders_link_text")}</a>
                  </strong>{t("tradingview_automation.strategy_orders_desc_close")}
                </p>
              </div>

              <div>
                <h4 class="text-white font-bold mb-2 flex items-center gap-2">
                  <i class="fa-solid fa-star text-blue-400" aria-hidden="true"></i>
                  {t("tradingview_automation.strategy_bestfor_title")}
                </h4>
                <p class="text-gray-300 text-sm leading-relaxed">
                  {t("tradingview_automation.strategy_bestfor_desc")}
                </p>
              </div>
            </div>
          </div>

          <!-- TradingView Indicator -->
          <div
            class="bg-gradient-to-br from-purple-900/30 to-purple-900/10 border-2 border-purple-500/40 rounded-xl overflow-hidden hover:border-purple-500/60 transition-all">
            <div class="bg-purple-900/40 px-8 py-6 border-b border-purple-500/30">
              <div class="flex items-center gap-4 mb-3">
                <div class="w-14 h-14 bg-purple-500/30 rounded-lg flex items-center justify-center">
                  <i class="fa-solid fa-chart-line text-purple-400 text-2xl" aria-hidden="true"></i>
                </div>
                <div>
                  <h3 class="text-2xl font-bold text-white">TradingView</h3>
                  <h4 class="text-xl font-bold gradient-text">{t("tradingview_automation.indicator_type_label")}</h4>
                </div>
              </div>
            </div>
            <div class="p-8 space-y-6">
              <div>
                <h4 class="text-white font-bold mb-2 flex items-center gap-2">
                  <i class="fa-solid fa-search text-purple-400" aria-hidden="true"></i>
                  {t("tradingview_automation.indicator_identify_title")}
                </h4>
                <p class="text-gray-300 text-sm leading-relaxed">
                  {t("tradingview_automation.indicator_identify_desc")}
                </p>
              </div>

              <div>
                <h4 class="text-white font-bold mb-2 flex items-center gap-2">
                  <i class="fa-solid fa-bell text-purple-400" aria-hidden="true"></i>
                  {t("tradingview_automation.indicator_alert_title")}
                </h4>
                <p class="text-gray-300 text-sm leading-relaxed mb-2">
                  {t("tradingview_automation.indicator_alert_desc_pre")} <strong class="text-white">{t("tradingview_automation.indicator_alert_desc_strong")}</strong>{t("tradingview_automation.indicator_alert_desc_post")}
                </p>
              </div>

              <div>
                <h4 class="text-white font-bold mb-2 flex items-center gap-2">
                  <i class="fa-solid fa-list-check text-purple-400" aria-hidden="true"></i>
                  {t("tradingview_automation.indicator_orders_title")}
                </h4>
                <p class="text-gray-300 text-sm leading-relaxed">
                  {t("tradingview_automation.indicator_orders_desc_pre")} <strong class="text-white">{t("tradingview_automation.indicator_orders_desc_strong")}</strong>{t("tradingview_automation.indicator_orders_desc_post")}
                </p>
              </div>

              <div>
                <h4 class="text-white font-bold mb-2 flex items-center gap-2">
                  <i class="fa-solid fa-star text-purple-400" aria-hidden="true"></i>
                  {t("tradingview_automation.indicator_bestfor_title")}
                </h4>
                <p class="text-gray-300 text-sm leading-relaxed">
                  {t("tradingview_automation.indicator_bestfor_desc")}
                </p>
              </div>
            </div>
          </div>
        </div>

        <div class="mt-12 text-center">
          <div
            class="inline-block bg-gradient-to-r from-blue-900/30 to-purple-900/30 border border-blue-500/30 rounded-xl p-8 max-w-3xl">
            <h3 class="text-xl font-bold text-white mb-3 flex items-center justify-center gap-2">
              <i class="fa-solid fa-circle-question text-blue-400" aria-hidden="true"></i>
              {t("tradingview_automation.not_sure_title")}
            </h3>
            <p class="text-gray-300 leading-relaxed">
              {t("tradingview_automation.not_sure_desc_pre")} <strong class="text-white">{t("tradingview_automation.not_sure_desc_strong1")}</strong>{t("tradingview_automation.not_sure_desc_mid")} <strong class="text-white">{t("tradingview_automation.not_sure_desc_strong2")}</strong>{t("tradingview_automation.not_sure_desc_post")}
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Strategy / Indicator / Alert Variant Map Section -->
