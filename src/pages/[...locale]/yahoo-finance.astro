const data = DATA[locale];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: data.faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: `${SITE_URL}${withSlash(localizedPath(locale))}` },
    { "@type": "ListItem", position: 2, name: "Resources", item: `${SITE_URL}${withSlash(localizedPath(locale, "resources"))}` },
    { "@type": "ListItem", position: 3, name: "Yahoo Finance", item: `${SITE_URL}${withSlash(localizedPath(locale, "yahoo-finance"))}` },
  ],
};

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: data.metaTitle,
  description: data.metaDescription,
  image: `${SITE_URL}/assets/logo.png`,
  author: { "@type": "Organization", name: "PickMyTrade", url: SITE_URL },
  publisher: { "@type": "Organization", name: "PickMyTrade", logo: { "@type": "ImageObject", url: `${SITE_URL}/assets/logo.png` } },
  datePublished: "2026-08-17",
  dateModified: "2026-08-17",
  mainEntityOfPage: { "@type": "WebPage", "@id": `${SITE_URL}${withSlash(localizedPath(locale, "yahoo-finance"))}` },
};

---

<BaseLayout
  locale={locale}
  robots={locale === "en" ? undefined : "noindex, follow"}
  englishOnly
  title={`${data.metaTitle} | PickMyTrade`}
  description={data.metaDescription}
  ogType="article"
  ldJson={[breadcrumbSchema, faqSchema, articleSchema]}
>
  <PartnerPage locale={locale} data={data} />
</BaseLayout>
