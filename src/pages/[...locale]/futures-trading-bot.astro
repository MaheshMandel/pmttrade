---
import BaseLayout from "../../layouts/BaseLayout.astro";
import FaqItem from "../../components/FaqItem.astro";
import { getLocalePaths, useTranslations, localizedPath } from "../../i18n/utils";
import type { Locale } from "../../i18n/config";
import { AUTOMATION_FIRMS } from "../../data/automationFirms";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };
const t = useTranslations(locale);

const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const PAGE_URL = `${SITE_URL}${withSlash(localizedPath(locale, "futures-trading-bot"))}`;

// Tradovate stays on this site; every other broker is set up on pickmytrade.io
// (same split used by tradingview-automation.astro's brokerLinks).
const brokerLinks = [
  { name: "Tradovate", href: localizedPath(locale, "tradingview-to-tradovate") },
  { name: "Rithmic", href: "https://pickmytrade.io/broker/tradingview-to-rithmic/" },
  { name: "Interactive Brokers", href: "https://pickmytrade.io/broker/tradingview-to-ib/" },
  { name: "TradeStation", href: "https://pickmytrade.io/broker/tradingview-to-tradestation/" },
  { name: "TradeLocker", href: "https://pickmytrade.io/broker/tradingview-to-tradelocker/" },
  { name: "ProjectX / TopstepX", href: "https://pickmytrade.io/broker/tradingview-to-projectx/" },
  { name: "Match-Trader", href: "https://pickmytrade.io/broker/tradingview-to-matchtrader/" },
  { name: "Tradier (Beta)", href: "https://pickmytrade.io/broker/tradingview-to-tradier/" },
  { name: "cTrader (Beta)", href: "https://pickmytrade.io/broker/tradingview-to-ctrader/" },
  { name: "Ironbeam (Beta)", href: "https://pickmytrade.io/broker/tradingview-to-ironbeam/" },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": Array.from({ length: 10 }, (_, i) => i + 1).map((n) => ({
    "@type": "Question",
    "name": t(`futures_trading_bot.faq_${n}_q` as any),
    "acceptedAnswer": { "@type": "Answer", "text": t(`futures_trading_bot.faq_${n}_a` as any) },
  })),
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": t("automation.shared_breadcrumb_home" as any), "item": `${SITE_URL}${withSlash(localizedPath(locale))}` },
    { "@type": "ListItem", "position": 2, "name": "Futures Trading Bot", "item": PAGE_URL },
  ],
};

---

<BaseLayout
  locale={locale}
  title={t("futures_trading_bot.meta_title")}
  description={t("futures_trading_bot.meta_description")}
  ldJson={[faqSchema, breadcrumbSchema]}
>
  <style>
    .electrolize-regular {
      font-family: 'Electrolize', sans-serif;
    }
    .gradient-text {
      background: linear-gradient(135deg, #2B77EE, #0F3EC3);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }
  </style>

  <div class="bg-[#001429]">
    <!-- Breadcrumb -->
    <nav aria-label="Breadcrumb" class="bg-[#001429] border-b border-blue-900/30 pt-2">
      <ol class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3 flex flex-wrap items-center gap-2 text-xs text-gray-400">
        <li><a href={localizedPath(locale)} class="hover:text-white transition">{t("automation.shared_breadcrumb_home" as any)}</a></li>
        <li aria-hidden="true" class="text-gray-600">/</li>
        <li aria-current="page" class="text-[#7FB8F9]">Futures Trading Bot</li>
      </ol>
    </nav>

    <!-- Hero Section -->
    <section class="py-16 lg:py-24 border-b border-blue-900/30 bg-gradient-to-b from-[#001429] to-[#002040]">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
          <span class="inline-block px-4 py-2 bg-blue-600/20 text-blue-400 rounded-full text-sm font-semibold mb-6 border border-blue-500/30 tracking-wide uppercase electrolize-regular">
            {t("futures_trading_bot.hero_badge")}
          </span>
          <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold text-white mb-6 tracking-tight leading-tight">
            {t("futures_trading_bot.hero_h1_pre")} <span class="gradient-text">{t("futures_trading_bot.hero_h1_highlight")}</span>
          </h1>
          <p class="text-xl md:text-2xl text-gray-300 max-w-4xl mx-auto leading-relaxed mb-8">
            {t("futures_trading_bot.hero_subtitle")}
          </p>
        </div>

        <div class="flex flex-wrap gap-3 justify-center mb-8">
          <a href="https://app.pickmytrade.trade/?register=true"
            class="inline-flex items-center justify-center px-8 py-4 text-base font-semibold text-white bg-gradient-to-r from-blue-600 to-blue-700 rounded-lg hover:from-blue-700 hover:to-blue-800 transition-all duration-300 shadow-lg hover:shadow-blue-500/50 hover:scale-105 electrolize-regular">
            {t("futures_trading_bot.hero_cta")}
            <i class="fa-solid fa-arrow-right ml-2" aria-hidden="true"></i>
          </a>
          <a href="#how-it-works"
            class="inline-flex items-center justify-center px-8 py-4 text-base font-semibold text-blue-300 bg-white/5 border border-blue-500/40 rounded-lg hover:bg-white/10 transition-all duration-300">
            {t("futures_trading_bot.hero_cta_secondary")}
          </a>
        </div>
        <p class="text-center text-xs text-gray-400 mb-10">{t("futures_trading_bot.hero_note")}</p>

        <div class="flex flex-wrap items-center justify-center gap-x-8 gap-y-4 text-sm">
          <span class="flex items-center gap-2 text-gray-200"><i class="fa-solid fa-users text-blue-400" aria-hidden="true"></i> {t("futures_trading_bot.hero_stat_1")}</span>
          <span class="flex items-center gap-2 text-gray-200"><i class="fa-solid fa-chart-line text-blue-400" aria-hidden="true"></i> {t("futures_trading_bot.hero_stat_2")}</span>
          <span class="flex items-center gap-2 text-gray-200"><i class="fa-solid fa-gauge-high text-blue-400" aria-hidden="true"></i> {t("futures_trading_bot.hero_stat_3")}</span>
          <span class="flex items-center gap-2 text-gray-200"><i class="fa-solid fa-cloud text-blue-400" aria-hidden="true"></i> {t("futures_trading_bot.hero_stat_4")}</span>
        </div>
      </div>
    </section>

    <!-- What is a futures trading bot -->
    <section class="py-14 sm:py-16 border-b border-blue-900/30">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-2xl sm:text-3xl font-bold text-white mb-5">{t("futures_trading_bot.secA_h2")}</h2>
        <p class="text-gray-300 leading-relaxed mb-4">{t("futures_trading_bot.secA_p1")}</p>
        <p class="text-gray-300 leading-relaxed mb-4">{t("futures_trading_bot.secA_p2")}</p>
        <p class="text-gray-300 leading-relaxed">{t("futures_trading_bot.secA_p3")}</p>
      </div>
    </section>

    <!-- How it works -->
    <section id="how-it-works" class="py-16 lg:py-20 border-b border-blue-900/30 bg-gradient-to-b from-[#001429] to-[#002040]">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
          <h2 class="text-3xl sm:text-4xl font-bold text-white mb-4">{t("futures_trading_bot.secB_h2")}</h2>
          <p class="text-lg text-gray-400 max-w-3xl mx-auto">{t("futures_trading_bot.secB_subtitle")}</p>
        </div>

        <div class="grid md:grid-cols-3 gap-6 mb-10">
          <div class="bg-gradient-to-br from-blue-900/20 to-blue-900/5 border border-blue-500/30 rounded-xl p-8">
            <div class="w-12 h-12 bg-blue-500/20 rounded-lg flex items-center justify-center mb-4">
              <i class="fa-solid fa-chart-line text-blue-400 text-xl" aria-hidden="true"></i>
            </div>
            <h3 class="text-xl font-bold text-white mb-2">{t("futures_trading_bot.step1_title")}</h3>
            <p class="text-sm text-gray-300 leading-relaxed">{t("futures_trading_bot.step1_desc")}</p>
          </div>
          <div class="bg-gradient-to-br from-purple-900/20 to-purple-900/5 border border-purple-500/30 rounded-xl p-8">
            <div class="w-12 h-12 bg-purple-500/20 rounded-lg flex items-center justify-center mb-4">
              <i class="fa-solid fa-bolt text-purple-400 text-xl" aria-hidden="true"></i>
            </div>
            <h3 class="text-xl font-bold text-white mb-2">{t("futures_trading_bot.step2_title")}</h3>
            <p class="text-sm text-gray-300 leading-relaxed">{t("futures_trading_bot.step2_desc")}</p>
          </div>
          <div class="bg-gradient-to-br from-green-900/20 to-green-900/5 border border-green-500/30 rounded-xl p-8">
            <div class="w-12 h-12 bg-green-500/20 rounded-lg flex items-center justify-center mb-4">
              <i class="fa-solid fa-circle-check text-green-400 text-xl" aria-hidden="true"></i>
            </div>
            <h3 class="text-xl font-bold text-white mb-2">{t("futures_trading_bot.step3_title")}</h3>
            <p class="text-sm text-gray-300 leading-relaxed">{t("futures_trading_bot.step3_desc")}</p>
          </div>
        </div>

        <p class="text-center text-gray-400 text-sm max-w-3xl mx-auto">
          {t("futures_trading_bot.secB_note_pre")}<a href={localizedPath(locale, "tradingview-automation")} class="text-blue-400 hover:text-blue-300 underline">{t("futures_trading_bot.secB_note_link")}</a>{t("futures_trading_bot.secB_note_post")}
        </p>
      </div>
    </section>

    <!-- Supported futures brokers -->
    <section class="py-14 sm:py-16 border-b border-blue-900/30">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-4xl mx-auto mb-8">
          <h2 class="text-2xl sm:text-3xl font-bold text-white mb-5">{t("futures_trading_bot.secC_h2")}</h2>
          <p class="text-gray-300 leading-relaxed mb-4">{t("futures_trading_bot.secC_p1")}</p>
          <p class="text-gray-300 leading-relaxed">{t("futures_trading_bot.secC_p2")}</p>
        </div>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
          {
            brokerLinks.map((broker) => (
              <a
                href={broker.href}
                target={broker.href.startsWith("http") ? "_blank" : undefined}
                rel={broker.href.startsWith("http") ? "noopener noreferrer" : undefined}
                class="text-center bg-blue-900/20 border border-blue-500/30 rounded-lg px-3 py-4 text-sm text-gray-200 hover:text-white hover:border-blue-500/60 transition"
              >
                {broker.name}
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Supported prop firms -->
    <section class="py-14 sm:py-16 border-b border-blue-900/30 bg-gradient-to-b from-[#001429] to-[#002040]">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-4xl mx-auto mb-8">
          <h2 class="text-2xl sm:text-3xl font-bold text-white mb-5">{t("futures_trading_bot.secD_h2")}</h2>
          <p class="text-gray-300 leading-relaxed">{t("futures_trading_bot.secD_p1")}</p>
        </div>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-6">
          {
            AUTOMATION_FIRMS.map((firm) => (
              <a
                href={localizedPath(locale, `automation/${firm.slug}`)}
                class="text-center bg-purple-900/20 border border-purple-500/30 rounded-lg px-3 py-4 text-sm text-gray-200 hover:text-white hover:border-purple-500/60 transition"
              >
                {t(`automation.${firm.nameKey}` as any)}
              </a>
            ))
          }
        </div>
        <p class="text-gray-400 text-xs max-w-3xl">{t("futures_trading_bot.secD_note")}</p>
      </div>
    </section>

    <!-- Risk tools -->
    <section class="py-16 lg:py-20 border-b border-blue-900/30">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
          <h2 class="text-3xl sm:text-4xl font-bold text-white mb-4">{t("futures_trading_bot.secE_h2")}</h2>
          <p class="text-lg text-gray-400 max-w-3xl mx-auto">{t("futures_trading_bot.secE_subtitle")}</p>
        </div>
        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
          <div class="bg-gradient-to-br from-blue-900/20 to-blue-900/5 border border-blue-500/30 rounded-xl p-6">
            <div class="w-10 h-10 bg-blue-500/20 rounded-lg flex items-center justify-center mb-3">
              <i class="fa-solid fa-bullseye text-blue-400" aria-hidden="true"></i>
            </div>
            <h3 class="font-bold text-white mb-2">{t("futures_trading_bot.feat1_title")}</h3>
            <p class="text-sm text-gray-300 leading-relaxed">{t("futures_trading_bot.feat1_desc")}</p>
          </div>
          <div class="bg-gradient-to-br from-cyan-900/20 to-cyan-900/5 border border-cyan-500/30 rounded-xl p-6">
            <div class="w-10 h-10 bg-cyan-500/20 rounded-lg flex items-center justify-center mb-3">
              <i class="fa-solid fa-arrows-left-right text-cyan-400" aria-hidden="true"></i>
            </div>
            <h3 class="font-bold text-white mb-2">{t("futures_trading_bot.feat2_title")}</h3>
            <p class="text-sm text-gray-300 leading-relaxed">{t("futures_trading_bot.feat2_desc")}</p>
          </div>
          <div class="bg-gradient-to-br from-purple-900/20 to-purple-900/5 border border-purple-500/30 rounded-xl p-6">
            <div class="w-10 h-10 bg-purple-500/20 rounded-lg flex items-center justify-center mb-3">
              <i class="fa-solid fa-coins text-purple-400" aria-hidden="true"></i>
            </div>
            <h3 class="font-bold text-white mb-2">{t("futures_trading_bot.feat3_title")}</h3>
            <p class="text-sm text-gray-300 leading-relaxed">{t("futures_trading_bot.feat3_desc")}</p>
          </div>
          <div class="bg-gradient-to-br from-red-900/20 to-red-900/5 border border-red-500/30 rounded-xl p-6">
            <div class="w-10 h-10 bg-red-500/20 rounded-lg flex items-center justify-center mb-3">
              <i class="fa-solid fa-shield-halved text-red-400" aria-hidden="true"></i>
            </div>
            <h3 class="font-bold text-white mb-2">{t("futures_trading_bot.feat4_title")}</h3>
            <p class="text-sm text-gray-300 leading-relaxed">{t("futures_trading_bot.feat4_desc")}</p>
          </div>
        </div>
        <p class="text-center text-gray-400 text-sm">
          {t("futures_trading_bot.secE_cta_pre")}<a href={localizedPath(locale, "tradingview-automation")} class="text-blue-400 hover:text-blue-300 underline">{t("futures_trading_bot.secE_cta_link")}</a>{t("futures_trading_bot.secE_cta_post")}
        </p>
      </div>
    </section>

    <!-- FAQ -->
    <section class="py-16 lg:py-20 border-b border-blue-900/30 bg-gradient-to-b from-[#001429] to-[#002040]">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-10">
          <h2 class="text-3xl sm:text-4xl font-bold text-white mb-3">{t("futures_trading_bot.faq_h2")}</h2>
          <p class="text-gray-400">{t("futures_trading_bot.faq_subtitle")}</p>
        </div>
        <div class="space-y-2">
          {
            Array.from({ length: 10 }, (_, i) => i + 1).map((n) => (
              <FaqItem question={t(`futures_trading_bot.faq_${n}_q` as any)}>
                <p>{t(`futures_trading_bot.faq_${n}_a` as any)}</p>
              </FaqItem>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Final CTA -->
    <section class="py-16 lg:py-20">
      <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h2 class="text-3xl sm:text-4xl font-bold text-white mb-4">{t("futures_trading_bot.final_cta_h2")}</h2>
        <p class="text-lg text-gray-400 mb-8">{t("futures_trading_bot.final_cta_subtitle")}</p>
        <a href="https://app.pickmytrade.trade/?register=true"
          class="inline-flex items-center justify-center px-8 py-4 text-base font-semibold text-white bg-gradient-to-r from-blue-600 to-blue-700 rounded-lg hover:from-blue-700 hover:to-blue-800 transition-all duration-300 shadow-lg hover:shadow-blue-500/50 hover:scale-105 electrolize-regular">
          {t("futures_trading_bot.final_cta_button")}
          <i class="fa-solid fa-arrow-right ml-2" aria-hidden="true"></i>
        </a>
        <p class="mt-3 text-xs text-gray-400">{t("futures_trading_bot.final_cta_note")}</p>
      </div>
    </section>
  </div>
</BaseLayout>
