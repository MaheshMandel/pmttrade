---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "trading-is-temporarily-halted";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/debugging/${SLUG}`;

const META_TITLE = "Tradovate 'Trading Is Temporarily Halted' Message";
const META_DESCRIPTION =
  "Tradovate trading is temporarily halted? Check for a platform outage and your account's risk or liquidation status before you retry.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Tradovate-Meldung „Trading Is Temporarily Halted“", es: "Mensaje «Trading Is Temporarily Halted» de Tradovate", fr: "Message « Trading Is Temporarily Halted » de Tradovate", it: "Messaggio «Trading Is Temporarily Halted» di Tradovate" },
  dek: { en: "You're in a position and Tradovate slaps a “Trading is temporarily halted” banner across the screen. It's almost never about the order you just sent. Here's what actually causes it and how to tell the five sources apart.", de: "Sie sind in einer Position und Tradovate blendet quer über den Bildschirm das Banner “Trading is temporarily halted” ein. Es hat fast nie mit der Order zu tun, die Sie gerade gesendet haben. Hier erfahren Sie, was es tatsächlich auslöst und wie Sie die fünf Quellen unterscheiden.", es: "Está en una posición y Tradovate le muestra en pantalla el banner “Trading is temporarily halted”. Casi nunca tiene que ver con la orden que acaba de enviar. Aquí le explicamos qué lo causa realmente y cómo distinguir las cinco fuentes.", fr: "Vous êtes en position et Tradovate affiche en travers de l'écran la bannière “Trading is temporarily halted”. Cela ne concerne presque jamais l'ordre que vous venez d'envoyer. Voici ce qui le provoque réellement et comment distinguer les cinq sources.", it: "È in posizione e Tradovate mostra a tutto schermo il banner “Trading is temporarily halted”. Non riguarda quasi mai l'ordine che ha appena inviato. Ecco cosa lo causa davvero e come distinguere le cinque fonti." },
  readTime: { en: "8 min read", de: "8 Min. Lesezeit", es: "Lectura de 8 min", fr: "Lecture : 8 min", it: "Lettura di 8 min" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "You're long ES, the tape is moving your way, and then Tradovate slaps a <em>&ldquo;Trading is temporarily halted&rdquo;</em> banner across the screen and locks you out. Few things rattle a futures trader more. Here's the part that trips people up: it's almost never about the order you just sent. That banner means order routing got <em>suspended</em> somewhere above your ticket, a platform incident, a clearing- or prop-firm-side event, an account-level risk restriction, or an exchange halt. And these things recur. On June 12, 2025, a global Google Cloud outage took Tradovate and NinjaTrader offline for roughly four and a half hours. You'll often see the halt travel with its cousins, <em>&ldquo;order rejected,&rdquo;</em> <em>&ldquo;No quote available. Please contact support,&rdquo;</em> or the eye-popping <em>&ldquo;AutoLiq 50000.0%.&rdquo;</em> Below is what the message actually means in 2026, the five things that cause it, and how PickMyTrade stops a halt from snowballing into a pile of duplicate, rejected orders." },
    {
      type: "checklist",
      heading: "Quick Checklist for a Tradovate Trading Halt",
      items: [
        "<strong class='text-white'>Check the status page first.</strong> Open the Tradovate service-status page (status.tradovate.com, or your prop firm's branded <code>&hellip;tradovate.com/service-status</code> mirror) to see if a platform-wide incident is already logged.",
        "<strong class='text-white'>Confirm it isn't just you.</strong> If the halt hits every symbol and every account, it's an outage or an exchange event, not something wrong with your order.",
        "<strong class='text-white'>Check your account's risk/liquidation state.</strong> A daily loss limit or a Liquidation-Only restriction halts <em>your</em> account only, while everyone else keeps trading.",
        "<strong class='text-white'>Look for an exchange halt.</strong> If one contract (say, ES) is frozen but the rest trade, the exchange may have paused that instrument.",
        "<strong class='text-white'>Don't panic-retry.</strong> Hammering the button trips rate limits and captcha lockouts, and it can leave duplicate &ldquo;ghost&rdquo; orders that fill after the halt clears.",
        "<strong class='text-white'>Watch open positions on a backup connection</strong>, the mobile app or a broker phone desk, and retry once, only after the all-clear.",
      ],
    },
    { type: "heading", text: "What “Trading Is Temporarily Halted” Means" },
    { type: "paragraph", html: "The message means Tradovate has <strong class='text-white'>suspended new order routing</strong> for you right now. That's different from a single order getting rejected for a bad quantity or price. This is a broader pause that usually applies to every order you try to place, and often to every account you hold. Because the block sits above the order ticket, resizing or nudging the limit price won't clear it." },
    { type: "paragraph", html: "There are two very different flavors of this halt, and telling them apart is the whole game. The first is <strong class='text-white'>system-wide</strong>: Tradovate, its cloud provider, your prop firm, or the exchange has paused trading for a lot of users at once. The second is <strong class='text-white'>account-specific</strong>: your own Risk Settings, a margin event, or a compliance rule has restricted only your account. One quick test usually settles it, can other symbols or other accounts trade?" },
    { type: "paragraph", html: "Two things make this message stressful. First, it can pop up <em>with your position still open</em>, so you sit there watching the market move while you can't act through the platform. Second, during broker- or clearing-side incidents, <strong class='text-white'>margin requirements can be raised temporarily</strong>, and that's exactly what produces those absurd <em>&ldquo;AutoLiq 50000.0%&rdquo;</em> rejection strings during an outage. None of that is your order's fault. It's the platform protecting itself while it steadies." },
    { type: "heading", text: "Top Causes of a Tradovate Trading Halt in 2026" },
    { type: "heading", text: "1. A Platform-Wide Tradovate Incident or Outage" },
    { type: "paragraph", html: "The most common trigger is simple: Tradovate, or the infrastructure it runs on, is having a bad moment. When that happens, the <em>&ldquo;trading has temporarily halted&rdquo;</em> message hits <strong class='text-white'>every</strong> account and every symbol at the same instant. The June 12, 2025 Google Cloud outage is the textbook case: a dependency failed, and multiple platforms including Tradovate and NinjaTrader went dark for hours. When the cause is platform-wide, there's no setting on your end to change, you confirm the incident and wait for the fix." },
    { type: "heading", text: "2. A Clearing-Firm or Prop-Firm-Side Halt" },
    { type: "paragraph", html: "Even when Tradovate's own status page is green, your <strong class='text-white'>clearing firm or prop firm</strong> can halt trading on the accounts it administers. In a January 2025 event, Apex paused Tradovate accounts while it was <em>&ldquo;addressing a temporary issue impacting Tradovate accounts&rdquo;</em>, a &ldquo;Peak Balance Discrepancy&rdquo;, and kept trading <em>&ldquo;temporarily halted until further notice&rdquo;</em> while it worked with Tradovate. Funded, evaluation, and PAPEX-style accounts were all affected, and margin requirements were raised during the window. If you trade through a prop firm, this is a very common source of the halt, and the firm, not Tradovate, owns the fix." },
    { type: "heading", text: "3. An Account-Level Risk or Liquidation Restriction" },
    { type: "paragraph", html: "If the halt hits only <em>you</em>, the cause is usually your own account state. When a <strong class='text-white'>daily loss limit, weekly loss limit, or profit target</strong> in your Risk Settings is reached, Tradovate flattens your positions and flips the account into a restricted, close-only state where new entries are blocked. On prop and evaluation accounts, those limits are set and locked by the firm. This is a completely different animal from a platform outage: the market's fine, but your account is paused until the next session, the next week, or a firm reset." },
    { type: "heading", text: "4. An Exchange-Level Trading Halt" },
    { type: "paragraph", html: "Sometimes the halt is coming from the exchange, and Tradovate is only relaying it. CME uses several price-control mechanisms that can pause a contract: <strong class='text-white'>price limits and circuit breakers</strong> on U.S. equity index futures (the familiar 7%, 13%, and 20% levels, with 10-minute halts at the first two), and <strong class='text-white'>Velocity Logic</strong>, which briefly suspends a contract, and its associated options, when price moves too far, too fast, within a short lookback window. If one instrument is frozen while others trade normally, an exchange-level halt is the likely answer. These are protective, temporary, and they clear on the exchange's schedule. No client-side fix applies." },
    { type: "heading", text: "5. A Brief Market-Data or Connection Drop" },
    { type: "paragraph", html: "A short data-feed interruption or a dropped connection can surface as a halt-like state too, sometimes paired with <em>&ldquo;No quote available. Please contact support.&rdquo;</em> Without a live quote, Tradovate won't route a fresh order. This is usually the shortest-lived cause, a reconnect or a page reload often restores routing once the feed catches up." },
    { type: "heading", text: "How to Fix a Tradovate Trading Halt: Step-by-Step" },
    { type: "heading", text: "Fixing a Platform-Wide Incident" },
    {
      type: "list",
      items: [
        "Open the Tradovate <strong class='text-white'>service-status page</strong> (status.tradovate.com, or your prop firm's branded <code>&hellip;tradovate.com/service-status</code> mirror) and look for an active incident.",
        "If an incident is posted, there's nothing to change on your end, note the &ldquo;monitoring/resolved&rdquo; timestamps and wait for the all-clear.",
        "Keep an eye on <strong class='text-white'>open positions through a second channel</strong>, the mobile app, or your broker's phone desk, so you're not blind if you need to exit.",
        "Once the incident is marked resolved, retry a single order to confirm routing is back before you resume normal size.",
      ],
    },
    { type: "heading", text: "Fixing a Prop-Firm or Clearing-Side Halt" },
    {
      type: "list",
      items: [
        "Check your prop firm's status page and any email/Discord announcements, clearing-side halts are usually communicated by the firm, not Tradovate.",
        "<strong class='text-white'>Stop firing rejected orders.</strong> During these events, margin can be temporarily elevated and orders will bounce; retries just clutter your log and risk rate-limit lockouts.",
        "Contact your <strong class='text-white'>prop provider's</strong> support to confirm scope and expected resolution, Tradovate can't lift a firm-administered halt.",
        "Reconcile your positions once trading reopens, in case anything filled or got flattened during the window.",
      ],
    },
    { type: "heading", text: "Fixing an Account-Level Risk Restriction" },
    {
      type: "list",
      items: [
        "Open the <strong class='text-white'>Accounts</strong> module and check whether your account shows a restricted or Liquidation-Only state rather than a global outage.",
        "On a <strong class='text-white'>self-funded</strong> live or demo account, open <strong class='text-white'>Risk Settings</strong> and review the daily/weekly loss limit and profit target, raise or clear the one that was reached, then save.",
        "On a <strong class='text-white'>prop/evaluation</strong> account you can't self-edit; contact the firm and ask whether it resets at the next session or needs a manual reset.",
        "Confirm the change saved, go back to the order ticket, and place one test order.",
      ],
    },
    { type: "heading", text: "Fixing an Exchange-Level Halt" },
    {
      type: "list",
      items: [
        "Check whether <strong class='text-white'>only one instrument</strong> is frozen while the rest trade, that points to the exchange, not Tradovate.",
        "Wait out the exchange pause; equity-index circuit-breaker halts and Velocity Logic suspensions are short and clear automatically.",
        "Manage risk on <strong class='text-white'>correlated instruments</strong> you can still trade if you need exposure while the halted contract is paused.",
        "Resume on the halted contract once the exchange lifts the pause, don't stack pending orders that could all fill at once on the reopen.",
      ],
    },
    { type: "heading", text: "Troubleshooting Table" },
    {
      type: "table",
      headers: ["Message / State", "Meaning", "Fix"],
      rows: [
        ["&ldquo;Trading is temporarily halted&rdquo; (all symbols/accounts)", "Platform-wide Tradovate or cloud-provider incident", "Check the status page; wait for the posted resolution, then retry once"],
        ["Halt only on prop/funded accounts", "Clearing- or prop-firm-side event (e.g. a balance/margin issue)", "Follow the firm's announcement; contact the prop provider, not Tradovate"],
        ["Halt on your account only, positions auto-closed", "Account-level Risk Setting (loss limit/profit target) reached", "Edit Risk Settings on a self-funded account, or wait for the session/week reset"],
        ["One contract frozen, others trade", "Exchange circuit breaker / Velocity Logic pause", "Wait out the exchange halt; it clears automatically"],
        ["&ldquo;No quote available. Please contact support.&rdquo;", "Market-data feed drop; no live quote to route against", "Reconnect/reload; wait for the feed to restore"],
        ["&ldquo;AutoLiq 50000.0%&rdquo; on rejection", "Temporarily raised margin during an incident", "Don't retry blindly; wait for the incident to clear, then reduce size"],
      ],
    },
    { type: "heading", text: "Prevent This with PickMyTrade" },
    { type: "paragraph", html: "No tool can override a Tradovate outage or an exchange circuit breaker, those clear on their own schedule. What compounds the damage is what happens <em>during</em> the halt: duplicate retries, orders that &ldquo;ghost&rdquo; fill after you thought they cancelled, and one account drifting out of sync with the rest. PickMyTrade links your TradingView alerts straight to Tradovate and adds a safety layer that keeps a temporary halt from turning into a mess:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Qty / Symbol Validation</strong>, blocks malformed or oversized orders before they're sent, so a halt window doesn't get flooded with entries that would only bounce.",
        "<strong class='text-white'>Entitlement &amp; Risk Filters</strong>, respects prop-firm limits and data-agreement state, so automation isn't firing into an account that's already restricted.",
        "<strong class='text-white'>Rate-Limit-Safe Routing</strong>, spaces out order flow instead of hammering, which avoids the captcha and 429 lockouts that panic-retries trigger.",
        "<strong class='text-white'>Multi-Account Sync</strong>, mirrors the corrected order across every connected account once routing is healthy again, so one account doesn't silently lag the others.",
      ],
    },
    { type: "paragraph", html: "The goal is simple: when Tradovate says &ldquo;halted,&rdquo; your automation waits cleanly and resumes on the next valid session, no duplicate fills, no runaway retries." },
  ], de: [
    { type: "paragraph",html: "Sie sind long ES, der Markt läuft in Ihre Richtung, und dann blendet Tradovate das Banner <em>&ldquo;Trading is temporarily halted&rdquo;</em> quer über den Bildschirm ein und sperrt Sie aus. Wenige Dinge verunsichern einen Futures-Trader mehr. Hier der Teil, der viele verwirrt: Es geht fast nie um die Order, die Sie gerade gesendet haben. Das Banner bedeutet, dass das Order-Routing irgendwo oberhalb Ihres Tickets <em>ausgesetzt</em> wurde, durch einen Plattformvorfall, ein Ereignis auf Seiten von Clearing- oder Prop-Firma, eine Risikobeschränkung auf Kontoebene oder einen Börsenhalt. Und diese Dinge wiederholen sich. Am 12. Juni 2025 legte ein globaler Google-Cloud-Ausfall Tradovate und NinjaTrader für etwa viereinhalb Stunden lahm. Oft tritt der Halt zusammen mit seinen Verwandten auf, <em>&ldquo;order rejected&rdquo;,</em> <em>&ldquo;No quote available. Please contact support&rdquo;</em> oder dem schockierenden <em>&ldquo;AutoLiq 50000.0%&rdquo;.</em> Im Folgenden lesen Sie, was die Meldung 2026 tatsächlich bedeutet, welche fünf Ursachen sie hat und wie PickMyTrade verhindert, dass ein Halt zu einem Haufen doppelter, abgelehnter Orders eskaliert." },
    {
      type: "checklist",
      heading: "Kurze Checkliste für einen Tradovate-Trading-Halt",
      items: [
        "<strong class='text-white'>Prüfen Sie zuerst die Statusseite.</strong> Öffnen Sie die Service-Status-Seite von Tradovate (status.tradovate.com oder den Mirror Ihrer Prop-Firma <code>&hellip;tradovate.com/service-status</code>), um zu sehen, ob bereits ein plattformweiter Vorfall erfasst ist.",
        "<strong class='text-white'>Bestätigen Sie, dass es nicht nur Sie betrifft.</strong> Trifft der Halt jedes Symbol und jedes Konto, ist es ein Ausfall oder ein Börsenereignis, nichts stimmt mit Ihrer Order nicht.",
        "<strong class='text-white'>Prüfen Sie den Risiko-/Liquidationszustand Ihres Kontos.</strong> Ein tägliches Verlustlimit oder eine Liquidation-Only-Beschränkung stoppt nur <em>Ihr</em> Konto, während alle anderen weiterhandeln.",
        "<strong class='text-white'>Suchen Sie nach einem Börsenhalt.</strong> Ist ein Kontrakt (etwa ES) eingefroren, der Rest wird aber gehandelt, hat die Börse womöglich dieses Instrument pausiert.",
        "<strong class='text-white'>Keine Panik-Wiederholungen.</strong> Das wiederholte Drücken des Buttons löst Ratenlimits und Captcha-Sperren aus und kann doppelte &ldquo;Geister&rdquo;-Orders hinterlassen, die nach Ende des Halts gefüllt werden.",
        "<strong class='text-white'>Beobachten Sie offene Positionen über eine Ersatzverbindung</strong>, die Mobile-App oder einen telefonischen Broker-Desk, und versuchen Sie es erst nach der Entwarnung einmal erneut.",
      ],
    },
    { type: "heading",text: "Was „Trading Is Temporarily Halted“ bedeutet" },
    { type: "paragraph",html: "Die Meldung bedeutet, dass Tradovate das <strong class='text-white'>Routing neuer Orders</strong> für Sie derzeit ausgesetzt hat. Das unterscheidet sich von einer einzelnen Order, die wegen falscher Menge oder falschem Preis abgelehnt wird. Es ist eine breitere Pause, die in der Regel jede Order betrifft, die Sie zu platzieren versuchen, und oft jedes Konto, das Sie halten. Da die Sperre oberhalb des Order-Tickets liegt, hilft weder das Ändern der Größe noch das Anpassen des Limitpreises." },
    { type: "paragraph",html: "Es gibt zwei sehr unterschiedliche Varianten dieses Halts, und sie auseinanderzuhalten ist das Entscheidende. Die erste ist <strong class='text-white'>systemweit</strong>: Tradovate, sein Cloud-Anbieter, Ihre Prop-Firma oder die Börse hat den Handel für viele Nutzer gleichzeitig pausiert. Die zweite ist <strong class='text-white'>kontospezifisch</strong>: Ihre eigenen Risk Settings, ein Margin-Ereignis oder eine Compliance-Regel haben nur Ihr Konto eingeschränkt. Ein schneller Test klärt es meist: Können andere Symbole oder andere Konten handeln?" },
    { type: "paragraph",html: "Zwei Dinge machen diese Meldung stressig. Erstens kann sie erscheinen, <em>während Ihre Position noch offen ist</em>, sodass Sie zusehen, wie sich der Markt bewegt, während Sie über die Plattform nicht handeln können. Zweitens können bei Vorfällen auf Broker- oder Clearing-Seite die <strong class='text-white'>Margin-Anforderungen vorübergehend erhöht werden</strong>, und genau das erzeugt diese absurden Ablehnungstexte <em>&ldquo;AutoLiq 50000.0%&rdquo;</em> während eines Ausfalls. Nichts davon ist die Schuld Ihrer Order. Die Plattform schützt sich selbst, während sie sich stabilisiert." },
    { type: "heading",text: "Die häufigsten Ursachen eines Tradovate-Trading-Halts 2026" },
    { type: "heading",text: "1. Ein plattformweiter Tradovate-Vorfall oder Ausfall" },
    { type: "paragraph",html: "Der häufigste Auslöser ist schlicht: Tradovate oder die Infrastruktur, auf der es läuft, hat einen schlechten Moment. Dann trifft die Meldung <em>&ldquo;trading has temporarily halted&rdquo;</em> <strong class='text-white'>jedes</strong> Konto und jedes Symbol im selben Augenblick. Der Google-Cloud-Ausfall vom 12. Juni 2025 ist der Musterfall: Eine Abhängigkeit fiel aus, und mehrere Plattformen, darunter Tradovate und NinjaTrader, waren stundenlang offline. Ist die Ursache plattformweit, gibt es auf Ihrer Seite keine Einstellung zu ändern, Sie bestätigen den Vorfall und warten auf die Behebung." },
    { type: "heading",text: "2. Ein Halt auf Seiten der Clearing- oder Prop-Firma" },
    { type: "paragraph",html: "Selbst wenn die Statusseite von Tradovate grün ist, kann Ihre <strong class='text-white'>Clearing- oder Prop-Firma</strong> den Handel auf den von ihr verwalteten Konten anhalten. Bei einem Ereignis im Januar 2025 pausierte Apex Tradovate-Konten, während es <em>&ldquo;addressing a temporary issue impacting Tradovate accounts&rdquo;</em> behob, eine &ldquo;Peak Balance Discrepancy&rdquo;, und hielt den Handel <em>&ldquo;temporarily halted until further notice&rdquo;</em>, während es mit Tradovate zusammenarbeitete. Funded-, Evaluierungs- und PAPEX-artige Konten waren alle betroffen, und die Margin-Anforderungen wurden in diesem Zeitraum erhöht. Handeln Sie über eine Prop-Firma, ist dies eine sehr häufige Quelle des Halts, und die Firma, nicht Tradovate, ist für die Lösung zuständig." },
    { type: "heading",text: "3. Eine Risiko- oder Liquidationsbeschränkung auf Kontoebene" },
    { type: "paragraph",html: "Trifft der Halt nur <em>Sie</em>, ist die Ursache meist Ihr eigener Kontozustand. Wird ein <strong class='text-white'>tägliches Verlustlimit, wöchentliches Verlustlimit oder Gewinnziel</strong> in Ihren Risk Settings erreicht, stellt Tradovate Ihre Positionen glatt und versetzt das Konto in einen eingeschränkten Nur-Schließen-Zustand, in dem neue Einstiege blockiert sind. Bei Prop- und Evaluierungskonten werden diese Limits von der Firma gesetzt und gesperrt. Das ist etwas völlig anderes als ein Plattformausfall: Der Markt ist in Ordnung, aber Ihr Konto ist bis zur nächsten Sitzung, zur nächsten Woche oder zu einem Reset durch die Firma pausiert." },
    { type: "heading",text: "4. Ein Handelshalt auf Börsenebene" },
    { type: "paragraph",html: "Manchmal kommt der Halt von der Börse, und Tradovate gibt ihn nur weiter. Die CME nutzt mehrere Preiskontrollmechanismen, die einen Kontrakt pausieren können: <strong class='text-white'>Preislimits und Circuit Breaker</strong> bei US-Aktienindex-Futures (die bekannten Stufen von 7 %, 13 % und 20 %, mit 10-minütigen Halts bei den ersten beiden) und <strong class='text-white'>Velocity Logic</strong>, die einen Kontrakt und die zugehörigen Optionen kurzzeitig aussetzt, wenn sich der Preis innerhalb eines kurzen Rückblickfensters zu weit und zu schnell bewegt. Ist ein Instrument eingefroren, während andere normal gehandelt werden, ist ein Halt auf Börsenebene die wahrscheinliche Antwort. Diese sind schützend, temporär und lösen sich nach dem Zeitplan der Börse. Eine clientseitige Lösung gibt es nicht." },
    { type: "heading",text: "5. Ein kurzer Marktdaten- oder Verbindungsausfall" },
    { type: "paragraph",html: "Eine kurze Unterbrechung des Datenfeeds oder eine unterbrochene Verbindung kann ebenfalls als haltähnlicher Zustand erscheinen, manchmal zusammen mit <em>&ldquo;No quote available. Please contact support.&rdquo;</em> Ohne Live-Kurs routet Tradovate keine neue Order. Das ist meist die kurzlebigste Ursache, ein Reconnect oder ein Seiten-Reload stellt das Routing häufig wieder her, sobald der Feed aufholt." },
    { type: "heading",text: "So beheben Sie einen Tradovate-Trading-Halt: Schritt für Schritt" },
    { type: "heading",text: "Einen plattformweiten Vorfall beheben" },
    {
      type: "list",
      items: [
        "Öffnen Sie die <strong class='text-white'>Service-Status-Seite</strong> von Tradovate (status.tradovate.com oder den Mirror Ihrer Prop-Firma <code>&hellip;tradovate.com/service-status</code>) und suchen Sie nach einem aktiven Vorfall.",
        "Ist ein Vorfall veröffentlicht, gibt es auf Ihrer Seite nichts zu ändern, notieren Sie die Zeitstempel für &ldquo;monitoring/resolved&rdquo; und warten Sie auf die Entwarnung.",
        "Behalten Sie <strong class='text-white'>offene Positionen über einen zweiten Kanal</strong> im Blick, die Mobile-App oder den telefonischen Desk Ihres Brokers, damit Sie nicht blind sind, falls Sie aussteigen müssen.",
        "Sobald der Vorfall als behoben markiert ist, senden Sie eine einzelne Order, um zu bestätigen, dass das Routing zurück ist, bevor Sie mit normaler Größe weitermachen.",
      ],
    },
    { type: "heading",text: "Einen Halt der Prop- oder Clearing-Firma beheben" },
    {
      type: "list",
      items: [
        "Prüfen Sie die Statusseite Ihrer Prop-Firma sowie E-Mail-/Discord-Ankündigungen, Halts auf Clearing-Seite werden in der Regel von der Firma kommuniziert, nicht von Tradovate.",
        "<strong class='text-white'>Hören Sie auf, abgelehnte Orders zu senden.</strong> Bei diesen Ereignissen kann die Margin vorübergehend erhöht sein und Orders prallen ab; Wiederholungen füllen nur Ihr Protokoll und riskieren Ratenlimit-Sperren.",
        "Kontaktieren Sie den Support Ihres <strong class='text-white'>Prop-Anbieters</strong>, um Umfang und erwartete Lösung zu erfahren, Tradovate kann einen von der Firma verwalteten Halt nicht aufheben.",
        "Gleichen Sie Ihre Positionen ab, sobald der Handel wieder öffnet, falls in der Zwischenzeit etwas gefüllt oder glattgestellt wurde.",
      ],
    },
    { type: "heading",text: "Eine Risikobeschränkung auf Kontoebene beheben" },
    {
      type: "list",
      items: [
        "Öffnen Sie das Modul <strong class='text-white'>Accounts</strong> und prüfen Sie, ob Ihr Konto einen eingeschränkten oder Liquidation-Only-Zustand statt eines globalen Ausfalls zeigt.",
        "Öffnen Sie bei einem <strong class='text-white'>selbstfinanzierten</strong> Live- oder Demokonto die <strong class='text-white'>Risk Settings</strong> und prüfen Sie das tägliche/wöchentliche Verlustlimit und das Gewinnziel, erhöhen oder löschen Sie das erreichte, und speichern Sie.",
        "Bei einem <strong class='text-white'>Prop-/Evaluierungs</strong>-Konto können Sie dies nicht selbst bearbeiten; kontaktieren Sie die Firma und fragen Sie, ob es sich zur nächsten Sitzung zurücksetzt oder einen manuellen Reset braucht.",
        "Bestätigen Sie, dass die Änderung gespeichert wurde, kehren Sie zum Order-Ticket zurück und platzieren Sie eine Test-Order.",
      ],
    },
    { type: "heading",text: "Einen Halt auf Börsenebene beheben" },
    {
      type: "list",
      items: [
        "Prüfen Sie, ob <strong class='text-white'>nur ein Instrument</strong> eingefroren ist, während der Rest gehandelt wird, das deutet auf die Börse hin, nicht auf Tradovate.",
        "Warten Sie die Börsenpause ab; Circuit-Breaker-Halts bei Aktienindizes und Velocity-Logic-Aussetzungen sind kurz und lösen sich automatisch.",
        "Steuern Sie Risiko über <strong class='text-white'>korrelierte Instrumente</strong>, die Sie noch handeln können, falls Sie Exposure brauchen, während der gestoppte Kontrakt pausiert.",
        "Setzen Sie den gestoppten Kontrakt fort, sobald die Börse die Pause aufhebt, stapeln Sie keine Pending-Orders, die bei der Wiedereröffnung alle gleichzeitig gefüllt werden könnten.",
      ],
    },
    { type: "heading",text: "Tabelle zur Fehlerbehebung" },
    { type: "table", headers: ["Meldung / Zustand","Bedeutung","Lösung"], rows: [
      ["&ldquo;Trading is temporarily halted&rdquo; (alle Symbole/Konten)","Plattformweiter Vorfall bei Tradovate oder Cloud-Anbieter","Statusseite prüfen; auf die veröffentlichte Lösung warten, dann einmal erneut versuchen"],
      ["Halt nur bei Prop-/Funded-Konten","Ereignis auf Clearing- oder Prop-Firmen-Seite (z. B. ein Saldo-/Margin-Problem)","Der Ankündigung der Firma folgen; den Prop-Anbieter kontaktieren, nicht Tradovate"],
      ["Halt nur bei Ihrem Konto, Positionen automatisch geschlossen","Risk Setting auf Kontoebene (Verlustlimit/Gewinnziel) erreicht","Risk Settings bei einem selbstfinanzierten Konto bearbeiten oder den Reset der Sitzung/Woche abwarten"],
      ["Ein Kontrakt eingefroren, andere werden gehandelt","Circuit Breaker der Börse / Velocity-Logic-Pause","Den Börsenhalt abwarten; er löst sich automatisch"],
      ["&ldquo;No quote available. Please contact support.&rdquo;","Marktdatenfeed unterbrochen; kein Live-Kurs zum Routen","Neu verbinden/neu laden; auf die Wiederherstellung des Feeds warten"],
      ["&ldquo;AutoLiq 50000.0%&rdquo; bei Ablehnung","Vorübergehend erhöhte Margin während eines Vorfalls","Nicht blind wiederholen; den Vorfall abwarten, dann die Größe reduzieren"],
    ] },
    { type: "heading",text: "Verhindern Sie das mit PickMyTrade" },
    { type: "paragraph",html: "Kein Tool kann einen Tradovate-Ausfall oder einen Circuit Breaker der Börse außer Kraft setzen, diese lösen sich nach eigenem Zeitplan. Den Schaden vergrößert, was <em>während</em> des Halts geschieht: doppelte Wiederholungen, Orders, die als &ldquo;Geister&rdquo; gefüllt werden, nachdem Sie dachten, sie seien storniert, und ein Konto, das gegenüber den übrigen aus dem Takt gerät. PickMyTrade verbindet Ihre TradingView-Alerts direkt mit Tradovate und ergänzt eine Sicherheitsschicht, die verhindert, dass aus einem vorübergehenden Halt ein Chaos wird:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Mengen-/Symbol-Validierung</strong>, blockiert fehlerhafte oder zu große Orders vor dem Senden, sodass das Halt-Fenster nicht mit Einstiegen überflutet wird, die ohnehin nur abprallen würden.",
        "<strong class='text-white'>Berechtigungs- &amp; Risikofilter</strong>, respektiert Limits der Prop-Firma und den Status der Datenvereinbarung, sodass die Automatisierung nicht in ein bereits eingeschränktes Konto feuert.",
        "<strong class='text-white'>Ratenlimit-sicheres Routing</strong>, taktet den Orderfluss, statt zu hämmern, und vermeidet so die Captcha- und 429-Sperren, die Panik-Wiederholungen auslösen.",
        "<strong class='text-white'>Multi-Account-Sync</strong>, spiegelt die korrigierte Order auf alle verbundenen Konten, sobald das Routing wieder gesund ist, sodass kein Konto unbemerkt hinter den anderen zurückbleibt.",
      ],
    },
    { type: "paragraph",html: "Das Ziel ist einfach: Wenn Tradovate &ldquo;halted&rdquo; meldet, wartet Ihre Automatisierung sauber ab und setzt in der nächsten gültigen Sitzung fort, ohne doppelte Fills und ohne ausufernde Wiederholungen." },
  ], es: [
    { type: "paragraph",html: "Está largo en ES, el mercado se mueve a su favor y entonces Tradovate le muestra en pantalla el banner <em>&ldquo;Trading is temporarily halted&rdquo;</em> y lo bloquea. Pocas cosas inquietan más a un trader de futuros. Y aquí está lo que confunde a la gente: casi nunca tiene que ver con la orden que acaba de enviar. Ese banner significa que el enrutamiento de órdenes quedó <em>suspendido</em> en algún punto por encima de su ticket: un incidente de la plataforma, un evento de la casa de compensación o de la prop firm, una restricción de riesgo a nivel de cuenta o una suspensión de la bolsa. Y estas cosas se repiten. El 12 de junio de 2025, una caída global de Google Cloud dejó fuera de línea a Tradovate y NinjaTrader durante unas cuatro horas y media. Con frecuencia verá la suspensión acompañada de sus parientes, <em>&ldquo;order rejected&rdquo;,</em> <em>&ldquo;No quote available. Please contact support&rdquo;</em> o el llamativo <em>&ldquo;AutoLiq 50000.0%&rdquo;.</em> A continuación encontrará qué significa realmente el mensaje en 2026, las cinco causas que lo provocan y cómo PickMyTrade evita que una suspensión se convierta en una montaña de órdenes duplicadas y rechazadas." },
    {
      type: "checklist",
      heading: "Lista rápida para una suspensión de trading en Tradovate",
      items: [
        "<strong class='text-white'>Compruebe primero la página de estado.</strong> Abra la página de estado del servicio de Tradovate (status.tradovate.com, o el espejo de marca de su prop firm <code>&hellip;tradovate.com/service-status</code>) para ver si ya hay registrado un incidente de toda la plataforma.",
        "<strong class='text-white'>Confirme que no es solo usted.</strong> Si la suspensión afecta a todos los símbolos y todas las cuentas, es una caída o un evento de la bolsa, no algo mal en su orden.",
        "<strong class='text-white'>Revise el estado de riesgo/liquidación de su cuenta.</strong> Un límite de pérdida diaria o una restricción de solo liquidación suspende únicamente <em>su</em> cuenta, mientras todos los demás siguen operando.",
        "<strong class='text-white'>Busque una suspensión de la bolsa.</strong> Si un contrato (por ejemplo ES) está congelado pero el resto opera, la bolsa puede haber pausado ese instrumento.",
        "<strong class='text-white'>No reintente presa del pánico.</strong> Martillear el botón activa límites de frecuencia y bloqueos por captcha, y puede dejar órdenes &ldquo;fantasma&rdquo; duplicadas que se ejecutan después de que termine la suspensión.",
        "<strong class='text-white'>Vigile las posiciones abiertas en una conexión de respaldo</strong>, la aplicación móvil o la mesa telefónica de su bróker, y reintente una sola vez, solo tras la señal de normalidad.",
      ],
    },
    { type: "heading",text: "Qué significa «Trading Is Temporarily Halted»" },
    { type: "paragraph",html: "El mensaje significa que Tradovate ha <strong class='text-white'>suspendido el enrutamiento de nuevas órdenes</strong> para usted en este momento. Eso es distinto de que una sola orden sea rechazada por una cantidad o un precio incorrectos. Es una pausa más amplia que normalmente se aplica a todas las órdenes que intente colocar y a menudo a todas las cuentas que tenga. Como el bloqueo está por encima del ticket de órdenes, cambiar el tamaño o retocar el precio límite no lo resolverá." },
    { type: "paragraph",html: "Hay dos variantes muy distintas de esta suspensión, y distinguirlas es la clave. La primera es <strong class='text-white'>a nivel de sistema</strong>: Tradovate, su proveedor de nube, su prop firm o la bolsa han pausado la negociación para muchos usuarios a la vez. La segunda es <strong class='text-white'>específica de la cuenta</strong>: sus propios Risk Settings, un evento de margen o una regla de cumplimiento han restringido solo su cuenta. Una prueba rápida suele aclararlo: ¿pueden operar otros símbolos u otras cuentas?" },
    { type: "paragraph",html: "Dos cosas hacen estresante este mensaje. Primero, puede aparecer <em>con su posición todavía abierta</em>, de modo que se queda viendo cómo se mueve el mercado sin poder actuar a través de la plataforma. Segundo, durante incidentes del lado del bróker o de la casa de compensación, los <strong class='text-white'>requisitos de margen pueden elevarse temporalmente</strong>, y eso es exactamente lo que produce esas absurdas cadenas de rechazo <em>&ldquo;AutoLiq 50000.0%&rdquo;</em> durante una caída. Nada de eso es culpa de su orden. Es la plataforma protegiéndose mientras se estabiliza." },
    { type: "heading",text: "Principales causas de una suspensión de trading en Tradovate en 2026" },
    { type: "heading",text: "1. Un incidente o caída de toda la plataforma Tradovate" },
    { type: "paragraph",html: "El desencadenante más común es simple: Tradovate, o la infraestructura sobre la que funciona, está pasando un mal momento. Cuando eso ocurre, el mensaje <em>&ldquo;trading has temporarily halted&rdquo;</em> afecta a <strong class='text-white'>todas</strong> las cuentas y a todos los símbolos en el mismo instante. La caída de Google Cloud del 12 de junio de 2025 es el caso de manual: falló una dependencia y varias plataformas, incluidas Tradovate y NinjaTrader, quedaron fuera de servicio durante horas. Cuando la causa es de toda la plataforma, no hay ningún ajuste que cambiar de su lado; confirme el incidente y espere a la corrección." },
    { type: "heading",text: "2. Una suspensión del lado de la casa de compensación o de la prop firm" },
    { type: "paragraph",html: "Incluso cuando la página de estado de Tradovate está en verde, su <strong class='text-white'>casa de compensación o prop firm</strong> puede suspender la negociación en las cuentas que administra. En un evento de enero de 2025, Apex pausó cuentas de Tradovate mientras <em>&ldquo;addressing a temporary issue impacting Tradovate accounts&rdquo;</em>, una &ldquo;Peak Balance Discrepancy&rdquo;, y mantuvo la negociación <em>&ldquo;temporarily halted until further notice&rdquo;</em> mientras trabajaba con Tradovate. Las cuentas financiadas, de evaluación y de tipo PAPEX se vieron afectadas, y los requisitos de margen se elevaron durante ese periodo. Si opera a través de una prop firm, esta es una fuente muy habitual de la suspensión, y la solución es de la firma, no de Tradovate." },
    { type: "heading",text: "3. Una restricción de riesgo o de liquidación a nivel de cuenta" },
    { type: "paragraph",html: "Si la suspensión le afecta solo a <em>usted</em>, la causa suele ser el estado de su propia cuenta. Cuando se alcanza un <strong class='text-white'>límite de pérdida diaria, límite de pérdida semanal u objetivo de beneficio</strong> en sus Risk Settings, Tradovate cierra sus posiciones y pasa la cuenta a un estado restringido de solo cierre en el que se bloquean las nuevas entradas. En cuentas de prop firms y de evaluación, esos límites los fija y los bloquea la firma. Es un animal completamente distinto de una caída de la plataforma: el mercado está bien, pero su cuenta queda en pausa hasta la siguiente sesión, la semana siguiente o un restablecimiento de la firma." },
    { type: "heading",text: "4. Una suspensión de negociación a nivel de bolsa" },
    { type: "paragraph",html: "A veces la suspensión viene de la bolsa y Tradovate solo la retransmite. CME usa varios mecanismos de control de precios que pueden pausar un contrato: <strong class='text-white'>límites de precio y circuit breakers</strong> en futuros de índices bursátiles de EE. UU. (los conocidos niveles del 7 %, 13 % y 20 %, con suspensiones de 10 minutos en los dos primeros) y <strong class='text-white'>Velocity Logic</strong>, que suspende brevemente un contrato y sus opciones asociadas cuando el precio se mueve demasiado lejos y demasiado rápido dentro de una ventana corta de observación. Si un instrumento está congelado mientras otros operan con normalidad, es probable que se trate de una suspensión de la bolsa. Son medidas protectoras, temporales, y se resuelven según el calendario de la bolsa. No hay ninguna solución del lado del cliente." },
    { type: "heading",text: "5. Una breve caída de datos de mercado o de conexión" },
    { type: "paragraph",html: "Una breve interrupción del flujo de datos o una conexión caída también pueden aparecer como un estado similar a una suspensión, a veces junto con <em>&ldquo;No quote available. Please contact support.&rdquo;</em> Sin una cotización en vivo, Tradovate no enruta una orden nueva. Suele ser la causa de menor duración; una reconexión o recargar la página a menudo restablece el enrutamiento una vez que el flujo se pone al día." },
    { type: "heading",text: "Cómo resolver una suspensión de trading en Tradovate: paso a paso" },
    { type: "heading",text: "Resolver un incidente de toda la plataforma" },
    {
      type: "list",
      items: [
        "Abra la <strong class='text-white'>página de estado del servicio</strong> de Tradovate (status.tradovate.com, o el espejo de marca de su prop firm <code>&hellip;tradovate.com/service-status</code>) y busque un incidente activo.",
        "Si hay un incidente publicado, no hay nada que cambiar de su lado; anote las marcas de tiempo de &ldquo;monitoring/resolved&rdquo; y espere la señal de normalidad.",
        "Vigile las <strong class='text-white'>posiciones abiertas por un segundo canal</strong>, la aplicación móvil o la mesa telefónica de su bróker, para no quedarse ciego si necesita salir.",
        "Cuando el incidente figure como resuelto, reintente una sola orden para confirmar que el enrutamiento ha vuelto antes de retomar el tamaño normal.",
      ],
    },
    { type: "heading",text: "Resolver una suspensión de la prop firm o de la casa de compensación" },
    {
      type: "list",
      items: [
        "Consulte la página de estado de su prop firm y cualquier anuncio por correo o Discord; las suspensiones del lado de la compensación suelen comunicarlas la firma, no Tradovate.",
        "<strong class='text-white'>Deje de enviar órdenes rechazadas.</strong> Durante estos eventos el margen puede estar temporalmente elevado y las órdenes rebotarán; los reintentos solo ensucian su registro y arriesgan bloqueos por límite de frecuencia.",
        "Contacte con el soporte de su <strong class='text-white'>proveedor de prop</strong> para confirmar el alcance y la resolución prevista; Tradovate no puede levantar una suspensión administrada por la firma.",
        "Concilie sus posiciones cuando se reanude la negociación, por si algo se ejecutó o se cerró durante ese intervalo.",
      ],
    },
    { type: "heading",text: "Resolver una restricción de riesgo a nivel de cuenta" },
    {
      type: "list",
      items: [
        "Abra el módulo <strong class='text-white'>Accounts</strong> y compruebe si su cuenta muestra un estado restringido o de solo liquidación en lugar de una caída global.",
        "En una cuenta real o demo <strong class='text-white'>autofinanciada</strong>, abra <strong class='text-white'>Risk Settings</strong> y revise el límite de pérdida diaria/semanal y el objetivo de beneficio, eleve o elimine el que se alcanzó y guarde.",
        "En una cuenta de <strong class='text-white'>prop/evaluación</strong> no puede editarlo usted mismo; contacte con la firma y pregunte si se restablece en la siguiente sesión o necesita un restablecimiento manual.",
        "Confirme que el cambio se guardó, vuelva al ticket de órdenes y coloque una orden de prueba.",
      ],
    },
    { type: "heading",text: "Resolver una suspensión a nivel de bolsa" },
    {
      type: "list",
      items: [
        "Compruebe si <strong class='text-white'>solo un instrumento</strong> está congelado mientras el resto opera; eso apunta a la bolsa, no a Tradovate.",
        "Espere a que termine la pausa de la bolsa; las suspensiones por circuit breaker en índices bursátiles y por Velocity Logic son breves y se levantan solas.",
        "Gestione el riesgo en <strong class='text-white'>instrumentos correlacionados</strong> que aún pueda operar si necesita exposición mientras el contrato suspendido está en pausa.",
        "Reanude en el contrato suspendido cuando la bolsa levante la pausa; no acumule órdenes pendientes que podrían ejecutarse todas a la vez en la reapertura.",
      ],
    },
    { type: "heading",text: "Tabla de solución de problemas" },
    { type: "table", headers: ["Mensaje / Estado","Significado","Solución"], rows: [
      ["&ldquo;Trading is temporarily halted&rdquo; (todos los símbolos/cuentas)","Incidente de toda la plataforma de Tradovate o del proveedor de nube","Revise la página de estado; espere la resolución publicada y luego reintente una vez"],
      ["Suspensión solo en cuentas de prop/financiadas","Evento de la casa de compensación o de la prop firm (p. ej., un problema de saldo/margen)","Siga el anuncio de la firma; contacte con el proveedor de prop, no con Tradovate"],
      ["Suspensión solo en su cuenta, posiciones cerradas automáticamente","Se alcanzó un Risk Setting a nivel de cuenta (límite de pérdida/objetivo de beneficio)","Edite los Risk Settings en una cuenta autofinanciada, o espere al restablecimiento de la sesión/semana"],
      ["Un contrato congelado, los demás operan","Circuit breaker de la bolsa / pausa de Velocity Logic","Espere a que pase la suspensión de la bolsa; se levanta automáticamente"],
      ["&ldquo;No quote available. Please contact support.&rdquo;","Caída del flujo de datos de mercado; sin cotización en vivo para enrutar","Reconecte/recargue; espere a que se restablezca el flujo"],
      ["&ldquo;AutoLiq 50000.0%&rdquo; en un rechazo","Margen elevado temporalmente durante un incidente","No reintente a ciegas; espere a que pase el incidente y luego reduzca el tamaño"],
    ] },
    { type: "heading",text: "Evite este problema con PickMyTrade" },
    { type: "paragraph",html: "Ninguna herramienta puede anular una caída de Tradovate ni un circuit breaker de la bolsa; se resuelven según su propio calendario. Lo que agrava el daño es lo que ocurre <em>durante</em> la suspensión: reintentos duplicados, órdenes que se ejecutan como &ldquo;fantasma&rdquo; después de que usted creyó que se habían cancelado y una cuenta que se desincroniza respecto al resto. PickMyTrade vincula sus alertas de TradingView directamente con Tradovate y añade una capa de seguridad que evita que una suspensión temporal se convierta en un desastre:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Validación de cantidad / símbolo</strong>, bloquea órdenes mal formadas o demasiado grandes antes de enviarlas, para que la ventana de suspensión no se inunde de entradas que solo rebotarían.",
        "<strong class='text-white'>Filtros de derechos &amp; riesgo</strong>, respeta los límites de la prop firm y el estado del acuerdo de datos, de modo que la automatización no dispare contra una cuenta ya restringida.",
        "<strong class='text-white'>Enrutamiento seguro frente a límites de frecuencia</strong>, espacia el flujo de órdenes en lugar de martillear, lo que evita los bloqueos por captcha y 429 que desencadenan los reintentos presa del pánico.",
        "<strong class='text-white'>Sincronización multicuenta</strong>, replica la orden corregida en todas las cuentas conectadas cuando el enrutamiento vuelve a estar sano, para que una cuenta no se retrase en silencio respecto a las demás.",
      ],
    },
    { type: "paragraph",html: "El objetivo es sencillo: cuando Tradovate dice &ldquo;halted&rdquo;, su automatización espera con limpieza y se reanuda en la siguiente sesión válida, sin ejecuciones duplicadas ni reintentos descontrolados." },
  ], fr: [
    { type: "paragraph",html: "Vous êtes à l'achat sur ES, le marché évolue dans votre sens, puis Tradovate affiche en travers de l'écran la bannière <em>&ldquo;Trading is temporarily halted&rdquo;</em> et vous bloque. Peu de choses déstabilisent davantage un trader de contrats à terme. Voici ce qui piège les gens : il ne s'agit presque jamais de l'ordre que vous venez d'envoyer. Cette bannière signifie que le routage des ordres a été <em>suspendu</em> quelque part au-dessus de votre ticket : un incident de plateforme, un événement côté société de compensation ou prop firm, une restriction de risque au niveau du compte, ou un arrêt de la bourse. Et ces choses se répètent. Le 12 juin 2025, une panne mondiale de Google Cloud a mis Tradovate et NinjaTrader hors ligne pendant environ quatre heures et demie. Vous verrez souvent l'arrêt voyager avec ses cousins, <em>&ldquo;order rejected&rdquo;,</em> <em>&ldquo;No quote available. Please contact support&rdquo;</em> ou le saisissant <em>&ldquo;AutoLiq 50000.0%&rdquo;.</em> Vous trouverez ci-dessous ce que le message signifie réellement en 2026, les cinq causes qui le provoquent et comment PickMyTrade évite qu'un arrêt ne dégénère en un tas d'ordres en double et rejetés." },
    {
      type: "checklist",
      heading: "Liste de vérification rapide pour un arrêt du trading Tradovate",
      items: [
        "<strong class='text-white'>Vérifiez d'abord la page d'état.</strong> Ouvrez la page d'état du service de Tradovate (status.tradovate.com, ou le miroir de votre prop firm <code>&hellip;tradovate.com/service-status</code>) pour voir si un incident à l'échelle de la plateforme est déjà consigné.",
        "<strong class='text-white'>Confirmez que cela ne vous concerne pas seul.</strong> Si l'arrêt touche tous les symboles et tous les comptes, c'est une panne ou un événement de bourse, et non un problème de votre ordre.",
        "<strong class='text-white'>Vérifiez l'état de risque/liquidation de votre compte.</strong> Une limite de perte quotidienne ou une restriction Liquidation-Only suspend uniquement <em>votre</em> compte, tandis que tout le monde continue de trader.",
        "<strong class='text-white'>Cherchez un arrêt de la bourse.</strong> Si un contrat (par exemple ES) est gelé mais que le reste se négocie, la bourse a peut-être mis cet instrument en pause.",
        "<strong class='text-white'>Ne réessayez pas dans la panique.</strong> Marteler le bouton déclenche des limites de débit et des blocages par captcha, et peut laisser des ordres &ldquo;fantômes&rdquo; en double qui s'exécutent après la fin de l'arrêt.",
        "<strong class='text-white'>Surveillez les positions ouvertes sur une connexion de secours</strong>, l'application mobile ou le desk téléphonique de votre courtier, et réessayez une seule fois, uniquement après la fin d'alerte.",
      ],
    },
    { type: "heading",text: "Ce que signifie « Trading Is Temporarily Halted »" },
    { type: "paragraph",html: "Le message signifie que Tradovate a <strong class='text-white'>suspendu le routage des nouveaux ordres</strong> pour vous à l'instant. C'est différent d'un ordre unique rejeté pour une quantité ou un prix incorrect. Il s'agit d'une pause plus large qui s'applique généralement à chaque ordre que vous essayez de passer, et souvent à chaque compte que vous détenez. Comme le blocage se situe au-dessus du ticket d'ordre, redimensionner ou retoucher le prix limite ne le lèvera pas." },
    { type: "paragraph",html: "Il existe deux variantes très différentes de cet arrêt, et les distinguer est l'essentiel. La première est <strong class='text-white'>à l'échelle du système</strong> : Tradovate, son fournisseur cloud, votre prop firm ou la bourse a mis le trading en pause pour de nombreux utilisateurs à la fois. La seconde est <strong class='text-white'>propre au compte</strong> : vos propres Risk Settings, un événement de marge ou une règle de conformité n'ont restreint que votre compte. Un test rapide tranche généralement : d'autres symboles ou d'autres comptes peuvent-ils trader ?" },
    { type: "paragraph",html: "Deux choses rendent ce message stressant. D'abord, il peut apparaître <em>alors que votre position est toujours ouverte</em>, de sorte que vous regardez le marché bouger sans pouvoir agir via la plateforme. Ensuite, lors d'incidents côté courtier ou société de compensation, les <strong class='text-white'>exigences de marge peuvent être relevées temporairement</strong>, et c'est précisément ce qui produit ces absurdes chaînes de rejet <em>&ldquo;AutoLiq 50000.0%&rdquo;</em> pendant une panne. Rien de tout cela n'est la faute de votre ordre. C'est la plateforme qui se protège pendant qu'elle se stabilise." },
    { type: "heading",text: "Principales causes d'un arrêt du trading Tradovate en 2026" },
    { type: "heading",text: "1. Un incident ou une panne à l'échelle de la plateforme Tradovate" },
    { type: "paragraph",html: "Le déclencheur le plus courant est simple : Tradovate, ou l'infrastructure sur laquelle elle repose, traverse un mauvais moment. Dans ce cas, le message <em>&ldquo;trading has temporarily halted&rdquo;</em> frappe <strong class='text-white'>tous</strong> les comptes et tous les symboles au même instant. La panne de Google Cloud du 12 juin 2025 en est le cas d'école : une dépendance est tombée et plusieurs plateformes, dont Tradovate et NinjaTrader, ont été hors service pendant des heures. Quand la cause touche toute la plateforme, il n'y a aucun réglage à modifier de votre côté : vous confirmez l'incident et attendez le correctif." },
    { type: "heading",text: "2. Un arrêt côté société de compensation ou prop firm" },
    { type: "paragraph",html: "Même lorsque la page d'état de Tradovate est au vert, votre <strong class='text-white'>société de compensation ou prop firm</strong> peut suspendre le trading sur les comptes qu'elle administre. Lors d'un événement de janvier 2025, Apex a suspendu des comptes Tradovate pendant qu'elle <em>&ldquo;addressing a temporary issue impacting Tradovate accounts&rdquo;</em>, une &ldquo;Peak Balance Discrepancy&rdquo;, et a maintenu le trading <em>&ldquo;temporarily halted until further notice&rdquo;</em> pendant qu'elle travaillait avec Tradovate. Les comptes financés, d'évaluation et de type PAPEX ont tous été touchés, et les exigences de marge ont été relevées pendant cette période. Si vous tradez via une prop firm, c'est une source très courante de cet arrêt, et c'est la société, et non Tradovate, qui détient la correction." },
    { type: "heading",text: "3. Une restriction de risque ou de liquidation au niveau du compte" },
    { type: "paragraph",html: "Si l'arrêt ne touche que <em>vous</em>, la cause est généralement l'état de votre propre compte. Lorsqu'une <strong class='text-white'>limite de perte quotidienne, limite de perte hebdomadaire ou un objectif de profit</strong> de vos Risk Settings est atteint, Tradovate clôture vos positions et fait basculer le compte dans un état restreint de clôture seule où les nouvelles entrées sont bloquées. Sur les comptes de prop firm et d'évaluation, ces limites sont fixées et verrouillées par la société. C'est un cas complètement différent d'une panne de plateforme : le marché va bien, mais votre compte est en pause jusqu'à la séance suivante, la semaine suivante ou une réinitialisation par la société." },
    { type: "heading",text: "4. Un arrêt de trading au niveau de la bourse" },
    { type: "paragraph",html: "Parfois l'arrêt vient de la bourse et Tradovate ne fait que le relayer. Le CME utilise plusieurs mécanismes de contrôle des prix qui peuvent mettre un contrat en pause : des <strong class='text-white'>limites de prix et coupe-circuits</strong> sur les contrats à terme sur indices actions américains (les niveaux bien connus de 7 %, 13 % et 20 %, avec des arrêts de 10 minutes pour les deux premiers) et la <strong class='text-white'>Velocity Logic</strong>, qui suspend brièvement un contrat, et ses options associées, lorsque le prix bouge trop loin et trop vite dans une courte fenêtre d'observation. Si un instrument est gelé alors que les autres se négocient normalement, un arrêt au niveau de la bourse est la réponse probable. Ces mesures sont protectrices, temporaires, et se résolvent selon le calendrier de la bourse. Aucune correction côté client ne s'applique." },
    { type: "heading",text: "5. Une brève coupure des données de marché ou de la connexion" },
    { type: "paragraph",html: "Une courte interruption du flux de données ou une connexion perdue peut aussi apparaître comme un état semblable à un arrêt, parfois accompagné de <em>&ldquo;No quote available. Please contact support.&rdquo;</em> Sans cotation en direct, Tradovate ne route pas de nouvel ordre. C'est généralement la cause la plus brève : une reconnexion ou un rechargement de page rétablit souvent le routage une fois que le flux a rattrapé son retard." },
    { type: "heading",text: "Comment corriger un arrêt du trading Tradovate : pas à pas" },
    { type: "heading",text: "Traiter un incident à l'échelle de la plateforme" },
    {
      type: "list",
      items: [
        "Ouvrez la <strong class='text-white'>page d'état du service</strong> de Tradovate (status.tradovate.com, ou le miroir de votre prop firm <code>&hellip;tradovate.com/service-status</code>) et cherchez un incident actif.",
        "Si un incident est publié, il n'y a rien à modifier de votre côté ; notez les horodatages &ldquo;monitoring/resolved&rdquo; et attendez la fin d'alerte.",
        "Gardez un œil sur vos <strong class='text-white'>positions ouvertes via un second canal</strong>, l'application mobile ou le desk téléphonique de votre courtier, afin de ne pas être aveugle si vous devez sortir.",
        "Une fois l'incident marqué comme résolu, réessayez un seul ordre pour confirmer que le routage est revenu avant de reprendre une taille normale.",
      ],
    },
    { type: "heading",text: "Traiter un arrêt côté prop firm ou société de compensation" },
    {
      type: "list",
      items: [
        "Consultez la page d'état de votre prop firm et les annonces par e-mail/Discord ; les arrêts côté compensation sont généralement communiqués par la société, pas par Tradovate.",
        "<strong class='text-white'>Cessez d'envoyer des ordres rejetés.</strong> Pendant ces événements, la marge peut être temporairement relevée et les ordres rebondiront ; les nouvelles tentatives encombrent seulement votre journal et risquent des blocages par limite de débit.",
        "Contactez le support de votre <strong class='text-white'>fournisseur de prop</strong> pour confirmer la portée et la résolution prévue ; Tradovate ne peut pas lever un arrêt administré par la société.",
        "Rapprochez vos positions à la réouverture du trading, au cas où quelque chose aurait été exécuté ou clôturé pendant l'intervalle.",
      ],
    },
    { type: "heading",text: "Traiter une restriction de risque au niveau du compte" },
    {
      type: "list",
      items: [
        "Ouvrez le module <strong class='text-white'>Accounts</strong> et vérifiez si votre compte affiche un état restreint ou Liquidation-Only plutôt qu'une panne globale.",
        "Sur un compte réel ou démo <strong class='text-white'>autofinancé</strong>, ouvrez <strong class='text-white'>Risk Settings</strong> et passez en revue la limite de perte quotidienne/hebdomadaire et l'objectif de profit, relevez ou supprimez celui qui a été atteint, puis enregistrez.",
        "Sur un compte de <strong class='text-white'>prop/évaluation</strong>, vous ne pouvez pas le modifier vous-même ; contactez la société et demandez s'il se réinitialise à la séance suivante ou nécessite une réinitialisation manuelle.",
        "Confirmez que la modification a été enregistrée, revenez au ticket d'ordre et passez un ordre de test.",
      ],
    },
    { type: "heading",text: "Traiter un arrêt au niveau de la bourse" },
    {
      type: "list",
      items: [
        "Vérifiez si <strong class='text-white'>un seul instrument</strong> est gelé alors que le reste se négocie ; cela pointe vers la bourse, pas vers Tradovate.",
        "Attendez la fin de la pause de la bourse ; les arrêts par coupe-circuit sur indices actions et les suspensions Velocity Logic sont brefs et se lèvent automatiquement.",
        "Gérez le risque sur des <strong class='text-white'>instruments corrélés</strong> que vous pouvez encore trader si vous avez besoin d'exposition pendant que le contrat arrêté est en pause.",
        "Reprenez sur le contrat arrêté une fois que la bourse lève la pause ; n'empilez pas d'ordres en attente qui pourraient tous être exécutés en même temps à la réouverture.",
      ],
    },
    { type: "heading",text: "Tableau de dépannage" },
    { type: "table", headers: ["Message / État","Signification","Solution"], rows: [
      ["&ldquo;Trading is temporarily halted&rdquo; (tous symboles/comptes)","Incident à l'échelle de la plateforme Tradovate ou du fournisseur cloud","Consultez la page d'état ; attendez la résolution publiée, puis réessayez une fois"],
      ["Arrêt uniquement sur les comptes prop/financés","Événement côté société de compensation ou prop firm (p. ex. un problème de solde/marge)","Suivez l'annonce de la société ; contactez le fournisseur de prop, pas Tradovate"],
      ["Arrêt sur votre compte seulement, positions clôturées automatiquement","Risk Setting au niveau du compte (limite de perte/objectif de profit) atteint","Modifiez les Risk Settings sur un compte autofinancé, ou attendez la réinitialisation de la séance/semaine"],
      ["Un contrat gelé, les autres se négocient","Coupe-circuit de la bourse / pause Velocity Logic","Attendez la fin de l'arrêt de la bourse ; il se lève automatiquement"],
      ["&ldquo;No quote available. Please contact support.&rdquo;","Coupure du flux de données de marché ; aucune cotation en direct pour router","Reconnectez/rechargez ; attendez le rétablissement du flux"],
      ["&ldquo;AutoLiq 50000.0%&rdquo; sur un rejet","Marge temporairement relevée pendant un incident","Ne réessayez pas à l'aveugle ; attendez la fin de l'incident, puis réduisez la taille"],
    ] },
    { type: "heading",text: "Évitez ce problème avec PickMyTrade" },
    { type: "paragraph",html: "Aucun outil ne peut passer outre une panne de Tradovate ou un coupe-circuit de la bourse ; ils se résolvent selon leur propre calendrier. Ce qui aggrave les dégâts, c'est ce qui se passe <em>pendant</em> l'arrêt : nouvelles tentatives en double, ordres qui s'exécutent comme des &ldquo;fantômes&rdquo; après que vous les pensiez annulés, et un compte qui se désynchronise des autres. PickMyTrade relie vos alertes TradingView directement à Tradovate et ajoute une couche de sécurité qui empêche un arrêt temporaire de tourner au chaos :" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Validation de la quantité / du symbole</strong>, bloque les ordres mal formés ou surdimensionnés avant leur envoi, afin que la fenêtre d'arrêt ne soit pas inondée d'entrées qui ne feraient que rebondir.",
        "<strong class='text-white'>Filtres de droits &amp; de risque</strong>, respecte les limites de la prop firm et l'état de l'accord de données, de sorte que l'automatisation ne tire pas dans un compte déjà restreint.",
        "<strong class='text-white'>Routage respectueux des limites de débit</strong>, espace le flux d'ordres au lieu de marteler, ce qui évite les blocages par captcha et 429 que déclenchent les nouvelles tentatives paniquées.",
        "<strong class='text-white'>Synchronisation multi-comptes</strong>, réplique l'ordre corrigé sur tous les comptes connectés une fois le routage de nouveau sain, afin qu'un compte ne prenne pas silencieusement du retard sur les autres.",
      ],
    },
    { type: "paragraph",html: "Le but est simple : quand Tradovate annonce &ldquo;halted&rdquo;, votre automatisation attend proprement et reprend à la prochaine séance valide, sans exécutions en double ni nouvelles tentatives incontrôlées." },
  ], it: [
    { type: "paragraph",html: "È long su ES, il mercato si muove a suo favore e poi Tradovate mostra a tutto schermo il banner <em>&ldquo;Trading is temporarily halted&rdquo;</em> e la blocca. Poche cose scuotono di più un trader di futures. Ecco la parte che trae in inganno: non riguarda quasi mai l'ordine che ha appena inviato. Quel banner significa che l'instradamento degli ordini è stato <em>sospeso</em> da qualche parte sopra il suo ticket: un incidente della piattaforma, un evento lato clearing o prop firm, una restrizione di rischio a livello di conto o un halt di borsa. E queste cose si ripetono. Il 12 giugno 2025 un'interruzione globale di Google Cloud ha messo offline Tradovate e NinjaTrader per circa quattro ore e mezza. Spesso vedrà l'halt accompagnarsi ai suoi cugini, <em>&ldquo;order rejected&rdquo;,</em> <em>&ldquo;No quote available. Please contact support&rdquo;</em> o l'eclatante <em>&ldquo;AutoLiq 50000.0%&rdquo;.</em> Di seguito trova cosa significa davvero il messaggio nel 2026, le cinque cause che lo provocano e come PickMyTrade evita che un halt degeneri in un mucchio di ordini duplicati e rifiutati." },
    {
      type: "checklist",
      heading: "Checklist rapida per un halt del trading su Tradovate",
      items: [
        "<strong class='text-white'>Controlli prima la pagina di stato.</strong> Apra la pagina di stato del servizio di Tradovate (status.tradovate.com, o il mirror della sua prop firm <code>&hellip;tradovate.com/service-status</code>) per vedere se è già registrato un incidente a livello di piattaforma.",
        "<strong class='text-white'>Confermi che non riguarda solo lei.</strong> Se l'halt colpisce ogni simbolo e ogni conto, è un'interruzione o un evento di borsa, non qualcosa che non va nel suo ordine.",
        "<strong class='text-white'>Controlli lo stato di rischio/liquidazione del suo conto.</strong> Un limite di perdita giornaliero o una restrizione Liquidation-Only blocca solo <em>il suo</em> conto, mentre tutti gli altri continuano a operare.",
        "<strong class='text-white'>Cerchi un halt di borsa.</strong> Se un contratto (per esempio ES) è congelato ma il resto si negozia, la borsa potrebbe aver messo in pausa quello strumento.",
        "<strong class='text-white'>Non riprovi in preda al panico.</strong> Martellare il pulsante fa scattare limiti di frequenza e blocchi captcha e può lasciare ordini &ldquo;fantasma&rdquo; duplicati che vengono eseguiti dopo la fine dell'halt.",
        "<strong class='text-white'>Monitori le posizioni aperte su una connessione di riserva</strong>, l'app mobile o il desk telefonico del suo broker, e riprovi una sola volta, solo dopo il via libera.",
      ],
    },
    { type: "heading",text: "Cosa significa «Trading Is Temporarily Halted»" },
    { type: "paragraph",html: "Il messaggio significa che Tradovate ha <strong class='text-white'>sospeso l'instradamento dei nuovi ordini</strong> per lei in questo momento. È diverso da un singolo ordine rifiutato per quantità o prezzo errati. È una pausa più ampia che di solito si applica a ogni ordine che prova a inserire, e spesso a ogni conto che possiede. Poiché il blocco si trova sopra il ticket dell'ordine, ridimensionare o ritoccare il prezzo limite non lo rimuoverà." },
    { type: "paragraph",html: "Esistono due varianti molto diverse di questo halt e distinguerle è la chiave. La prima è <strong class='text-white'>a livello di sistema</strong>: Tradovate, il suo fornitore cloud, la sua prop firm o la borsa ha messo in pausa il trading per molti utenti contemporaneamente. La seconda è <strong class='text-white'>specifica del conto</strong>: i suoi Risk Settings, un evento di margine o una regola di compliance hanno limitato solo il suo conto. Un test rapido di solito chiarisce: altri simboli o altri conti riescono a operare?" },
    { type: "paragraph",html: "Due cose rendono stressante questo messaggio. Primo, può comparire <em>con la sua posizione ancora aperta</em>, per cui resta a guardare il mercato muoversi senza poter agire dalla piattaforma. Secondo, durante incidenti lato broker o clearing, i <strong class='text-white'>requisiti di margine possono essere aumentati temporaneamente</strong>, ed è esattamente ciò che produce quelle assurde stringhe di rifiuto <em>&ldquo;AutoLiq 50000.0%&rdquo;</em> durante un'interruzione. Niente di tutto ciò è colpa del suo ordine. È la piattaforma che si protegge mentre si stabilizza." },
    { type: "heading",text: "Principali cause di un halt del trading su Tradovate nel 2026" },
    { type: "heading",text: "1. Un incidente o un'interruzione a livello dell'intera piattaforma Tradovate" },
    { type: "paragraph",html: "Il fattore scatenante più comune è semplice: Tradovate, o l'infrastruttura su cui gira, sta attraversando un brutto momento. In quel caso il messaggio <em>&ldquo;trading has temporarily halted&rdquo;</em> colpisce <strong class='text-white'>ogni</strong> conto e ogni simbolo nello stesso istante. L'interruzione di Google Cloud del 12 giugno 2025 è il caso da manuale: una dipendenza è caduta e diverse piattaforme, tra cui Tradovate e NinjaTrader, sono rimaste offline per ore. Quando la causa riguarda l'intera piattaforma, non c'è alcuna impostazione da cambiare da parte sua: conferma l'incidente e attende la correzione." },
    { type: "heading",text: "2. Un halt lato società di clearing o prop firm" },
    { type: "paragraph",html: "Anche quando la pagina di stato di Tradovate è verde, la sua <strong class='text-white'>società di clearing o prop firm</strong> può bloccare il trading sui conti che amministra. In un evento di gennaio 2025, Apex ha messo in pausa i conti Tradovate mentre <em>&ldquo;addressing a temporary issue impacting Tradovate accounts&rdquo;</em>, una &ldquo;Peak Balance Discrepancy&rdquo;, e ha mantenuto il trading <em>&ldquo;temporarily halted until further notice&rdquo;</em> mentre lavorava con Tradovate. Conti funded, di valutazione e di tipo PAPEX sono stati tutti interessati, e i requisiti di margine sono stati aumentati in quel periodo. Se opera tramite una prop firm, questa è una fonte molto comune dell'halt, e la correzione è della società, non di Tradovate." },
    { type: "heading",text: "3. Una restrizione di rischio o di liquidazione a livello di conto" },
    { type: "paragraph",html: "Se l'halt colpisce solo <em>lei</em>, la causa è di solito lo stato del suo conto. Quando viene raggiunto un <strong class='text-white'>limite di perdita giornaliero, limite di perdita settimanale o target di profitto</strong> nei suoi Risk Settings, Tradovate chiude le sue posizioni e porta il conto in uno stato ristretto di sola chiusura in cui i nuovi ingressi sono bloccati. Sui conti prop e di valutazione, quei limiti sono impostati e bloccati dalla società. È un animale completamente diverso da un'interruzione della piattaforma: il mercato è a posto, ma il suo conto è in pausa fino alla prossima sessione, alla prossima settimana o a un reset della società." },
    { type: "heading",text: "4. Un halt di trading a livello di borsa" },
    { type: "paragraph",html: "A volte l'halt arriva dalla borsa e Tradovate si limita a ritrasmetterlo. Il CME usa diversi meccanismi di controllo dei prezzi che possono mettere in pausa un contratto: <strong class='text-white'>limiti di prezzo e circuit breaker</strong> sui futures su indici azionari USA (i noti livelli del 7%, 13% e 20%, con halt di 10 minuti nei primi due) e la <strong class='text-white'>Velocity Logic</strong>, che sospende brevemente un contratto, e le opzioni associate, quando il prezzo si muove troppo e troppo in fretta entro una breve finestra di osservazione. Se uno strumento è congelato mentre altri si negoziano normalmente, la risposta probabile è un halt a livello di borsa. Sono misure protettive, temporanee, e si risolvono secondo i tempi della borsa. Non si applica alcuna correzione lato client." },
    { type: "heading",text: "5. Una breve interruzione dei dati di mercato o della connessione" },
    { type: "paragraph",html: "Una breve interruzione del feed di dati o una connessione caduta può comparire anch'essa come stato simile a un halt, a volte insieme a <em>&ldquo;No quote available. Please contact support.&rdquo;</em> Senza una quotazione live, Tradovate non instrada un nuovo ordine. Di solito è la causa di più breve durata: una riconnessione o un ricaricamento della pagina spesso ripristina l'instradamento una volta che il feed si è riallineato." },
    { type: "heading",text: "Come risolvere un halt del trading su Tradovate: passo dopo passo" },
    { type: "heading",text: "Risolvere un incidente a livello di piattaforma" },
    {
      type: "list",
      items: [
        "Apra la <strong class='text-white'>pagina di stato del servizio</strong> di Tradovate (status.tradovate.com, o il mirror della sua prop firm <code>&hellip;tradovate.com/service-status</code>) e cerchi un incidente attivo.",
        "Se è pubblicato un incidente, non c'è nulla da cambiare da parte sua; annoti i timestamp &ldquo;monitoring/resolved&rdquo; e attenda il via libera.",
        "Tenga d'occhio le <strong class='text-white'>posizioni aperte tramite un secondo canale</strong>, l'app mobile o il desk telefonico del suo broker, per non restare alla cieca se deve uscire.",
        "Quando l'incidente è contrassegnato come risolto, riprovi un solo ordine per confermare che l'instradamento sia tornato prima di riprendere la dimensione normale.",
      ],
    },
    { type: "heading",text: "Risolvere un halt lato prop firm o società di clearing" },
    {
      type: "list",
      items: [
        "Controlli la pagina di stato della sua prop firm e gli eventuali annunci via e-mail/Discord; gli halt lato clearing di solito vengono comunicati dalla società, non da Tradovate.",
        "<strong class='text-white'>Smetta di inviare ordini rifiutati.</strong> Durante questi eventi il margine può essere temporaneamente elevato e gli ordini rimbalzeranno; i tentativi ripetuti ingombrano solo il suo registro e rischiano blocchi per limite di frequenza.",
        "Contatti il supporto del suo <strong class='text-white'>fornitore prop</strong> per confermare portata e risoluzione prevista; Tradovate non può revocare un halt amministrato dalla società.",
        "Riconcili le sue posizioni alla riapertura del trading, nel caso in cui qualcosa sia stato eseguito o chiuso durante l'intervallo.",
