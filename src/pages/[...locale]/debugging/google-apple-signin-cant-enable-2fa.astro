---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "google-apple-signin-cant-enable-2fa";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/debugging/${SLUG}`;

const META_TITLE = "Tradovate Google/Apple Login Can't Enable 2FA";
const META_DESCRIPTION =
  "Signed in with Google or Apple and can't turn on two-factor login? Recover your username, set a password, then enable 2FA on standard credentials.";

// Short SEO title (<=60 chars) for locales where the shared h1 is too long for a SERP title.
const TITLE_OVERRIDE: Partial<Record<Locale, string>> = { de: "Tradovate: 2FA per Google-/Apple-Login nicht aktivierbar", es: "Tradovate: Google/Apple no permite activar la 2FA", fr: "Tradovate : connexion Google/Apple bloque l'activation 2FA", it: "Tradovate: accesso Google/Apple impedisce l'attivazione 2FA" };

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Tradovate: Google-/Apple-Login lässt sich 2FA nicht aktivieren", es: "Tradovate: el inicio de sesión con Google/Apple no permite activar la 2FA", fr: "Tradovate : la connexion Google/Apple empêche d'activer la 2FA", it: "Tradovate: l'accesso con Google/Apple non permette di attivare la 2FA" },
  dek: { en: "You click the 2FA toggle and nothing happens, or it asks for a password you never created. Here's why a Google or Apple sign-in blocks 2FA, and the five-minute fix.", de: "Sie klicken auf den 2FA-Schalter und nichts passiert, oder es wird ein Passwort verlangt, das Sie nie erstellt haben. Hier erfahren Sie, warum eine Google- oder Apple-Anmeldung 2FA blockiert – und die Fünf-Minuten-Lösung.", es: "Hace clic en el interruptor de 2FA y no ocurre nada, o le pide una contraseña que nunca creó. Aquí le explicamos por qué un inicio de sesión con Google o Apple bloquea la 2FA, y la solución de cinco minutos.", fr: "Vous cliquez sur l'interrupteur 2FA et rien ne se passe, ou il vous demande un mot de passe que vous n'avez jamais créé. Voici pourquoi une connexion Google ou Apple bloque la 2FA, et la solution en cinq minutes.", it: "Clicca sull'interruttore della 2FA e non succede nulla, oppure le viene chiesta una password che non ha mai creato. Ecco perché un accesso con Google o Apple blocca la 2FA, e la soluzione in cinque minuti." },
  readTime: { en: "6 min read", de: "6 Minuten Lesezeit", es: "Lectura de 6 minutos", fr: "Lecture de 6 minutes", it: "Lettura di 6 minuti" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "You went to lock down your account, found the two-factor authentication control, clicked it, and nothing happened. Or a box popped up asking for a password you're sure you never created. That's the classic symptom of an account you built with the &ldquo;Sign in with Google&rdquo; or &ldquo;Sign in with Apple&rdquo; button, and it's not a bug. Those buttons hand off the whole login to Google or Apple, so your account never got its own password. 2FA needs one to confirm it's really you before it switches on." },
    { type: "paragraph", html: "The fix is short: give the account a proper username and password, sign in with those instead of the social button, then flip 2FA on. You keep the Google or Apple option too, so nothing you already use breaks. Here's the full walk-through." },
    { type: "heading", text: "What You'll Need Before You Start" },
    { type: "paragraph", html: "Nothing exotic. You need access to the email inbox tied to your account, because that's where your username and the password reset land. Set aside five minutes and do this on a desktop browser rather than the phone app, since the settings screens are easier to navigate there. If you use an authenticator app for other logins, have your phone nearby so you can add it in the same sitting." },
    { type: "heading", text: "Why the 2FA Toggle Refuses to Work" },
    { type: "paragraph", html: "When you sign in with Google or Apple, you're proving your identity to <em>them</em>, and they vouch for you to Tradovate. Handy, but it leaves a gap. Two-factor authentication is a second lock stacked on top of a password, and the platform confirms you own that first lock before it arms the second one. On a social-login account there is no first lock to confirm, so the control either does nothing or throws up a password prompt you can't answer." },
    { type: "paragraph", html: "The moment you add a real username and password to the same account, that gap closes. You don't lose the Google or Apple shortcut. You're just giving the account a second front door, and 2FA can finally verify you through it." },
    { type: "paragraph", html: "This tends to bite at the worst time. Maybe your prop firm asked you to switch on 2FA, or you're wiring up a new device and want the extra protection, or you just read one too many stories about account takeovers and decided to tighten things up. Whatever pushed you here, the block is the same and so is the cure. Spend the few minutes once and you won't run into it again." },
    { type: "heading", text: "The Fix, Step by Step" },
    { type: "heading", text: "Step 1: Recover Your Username" },
    { type: "paragraph", html: "A social-login account still has a username on file, it was just generated for you and you've probably never seen it. On the login screen, use the username recovery link (it sits near the password fields, usually labeled something like &ldquo;Forgot username&rdquo; or &ldquo;Retrieve username&rdquo;). Enter the email address tied to your account and submit." },
    { type: "paragraph", html: "Check your inbox. The email contains your full username, which for a Google or Apple account tends to be a long, machine-generated string. Copy it exactly, including any odd characters, and keep that email open. You'll paste this in the next two steps." },
    { type: "heading", text: "Step 2: Set a Password" },
    { type: "paragraph", html: "Now create the password the account never had. Open the password reset link (usually &ldquo;Forgot password&rdquo; on the same login screen, or a link inside the recovery email). Paste the long username from Step 1, then set a password you'll actually remember. Confirm it, and you're done building the missing credential." },
    { type: "paragraph", html: "Pick something strong here. This password becomes the anchor for every security layer you add afterward, so it's worth the extra few seconds." },
    { type: "heading", text: "Step 3: Sign In With the Username and Password, Not the Social Button" },
    { type: "paragraph", html: "This is the step people skip, and it's the one that matters. Go back to the login page and type your recovered username and your new password into the fields. Do <strong class='text-white'>not</strong> click &ldquo;Sign in with Google&rdquo; or &ldquo;Sign in with Apple&rdquo; this time. The platform has to see you authenticate with the password credential, otherwise it still treats you as a social-login session and the 2FA control stays dead." },
    { type: "heading", text: "Step 4: Clean Up Your Username (Optional but Worth It)" },
    { type: "paragraph", html: "That auto-generated username is ugly and hard to type. Once you're signed in with the password, open Application Settings (the three-slider icon in the top-right corner) and go to the profile tab. There's a Change Username option. Set something you'll remember, enter your current password to confirm, and save. From now on you can log in with a clean username and password, or still tap the Google or Apple button. Both routes reach the same account." },
    { type: "heading", text: "Turn On 2FA and Add a Stronger Method" },
    { type: "paragraph", html: "With a real password in place, the security control finally cooperates. In Application Settings, open the security tab, find the 2-Factor Authentication control, and switch it on. A prompt asks for your password, which is exactly the point of everything above. Enter it, confirm, and the base layer is live. From then on, signing in from a new device or browser triggers an emailed verification code." },
    { type: "paragraph", html: "The email code is the floor, not the ceiling. Scroll below the 2FA toggle and you'll find options to add a stronger second factor. Here's how they compare:" },
    {
      type: "table",
      headers: ["Method", "How it verifies you", "Good to know"],
      rows: [
        ["Email code (base 2FA)", "A code is emailed to your account address on a new device or browser", "On by default once you enable 2FA; depends on inbox access"],
        ["Authenticator app (TOTP)", "A rotating 6-digit code from an app like Google Authenticator or Authy", "Works offline; the most reliable everyday option"],
        ["SMS code", "A text message to your phone on each login attempt", "Convenient, but tied to cell signal and your carrier"],
        ["Security key", "A physical hardware key you tap or plug in", "Strongest option; you need the key on hand every time"],
      ],
    },
    { type: "paragraph", html: "If you trade from one main machine, a TOTP authenticator app is the sweet spot. Set it up while you're already in the security settings so you're not scrambling later." },
    { type: "paragraph", html: "One heads-up once 2FA is armed: the first login from any new computer, phone, or browser needs approval before it'll route orders." },
    { type: "heading", text: "If the Platform Hangs Right After the Switch" },
    { type: "paragraph", html: "Flipping your login method and turning on 2FA in one sitting sometimes leaves the platform churning on a loading screen. It's a sync delay, not a lockout. Give it a little time, then sign out and sign back in with your username and password. In most cases it clears on its own within the hour." },
    { type: "paragraph", html: "If it's still stuck after that, the usual suspects apply: an out-of-sync system clock, a stale browser cache, or a session lingering on another device." },
    { type: "heading", text: "Still Won't Switch On? Run This Checklist" },
    { type: "paragraph", html: "If you did all of the above and the control still won't cooperate, walk through these before you reach out to support:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Confirm how you logged in this session.</strong> If you tapped the Google or Apple button out of habit, the platform still sees a social session. Sign out and log back in by typing your username and password.",
        "<strong class='text-white'>Check you're using the recovered username, not your email.</strong> The username and the account email are two different things. The 2FA prompt wants the password attached to that username.",
        "<strong class='text-white'>Make sure the password actually saved.</strong> If the reset didn't complete, there's still no credential to verify. Run the password reset again and watch for the confirmation.",
        "<strong class='text-white'>Look for a lingering session on another device.</strong> A second active session can leave settings changes half-applied. Sign out everywhere, then start fresh on one device.",
        "<strong class='text-white'>Prop or evaluation account?</strong> The firm may own the login. Numbers and rules vary by firm and account size, so check your firm's current instructions before changing credentials.",
      ],
    },
    { type: "heading", text: "Quick Recap" },
    { type: "paragraph", html: "A pure Google or Apple account can't turn on 2FA because it has no password for the second lock to verify. Recover your username by email, set a password, then sign in with that username and password instead of the social button. Optionally tidy up the username, enable 2FA in the security settings, and add an authenticator app for a stronger second factor. The Google and Apple shortcuts keep working the whole time, so you lose nothing and gain a properly locked-down account." },
  ], de: [
    { type: "paragraph", html: "Sie wollten Ihr Konto absichern, fanden die Einstellung für die Zwei-Faktor-Authentifizierung, klickten darauf, und nichts geschah. Oder es erschien ein Fenster, das nach einem Passwort fragte, das Sie sich sicher waren, nie erstellt zu haben. Das ist das klassische Symptom eines Kontos, das Sie mit der Schaltfläche &ldquo;Mit Google anmelden&rdquo; oder &ldquo;Mit Apple anmelden&rdquo; erstellt haben, und es ist kein Fehler. Diese Schaltflächen übergeben den gesamten Login an Google oder Apple, sodass Ihr Konto nie ein eigenes Passwort erhalten hat. 2FA benötigt eines, um zu bestätigen, dass Sie es wirklich sind, bevor es aktiviert wird." },
    { type: "paragraph", html: "Die Lösung ist kurz: Geben Sie dem Konto einen richtigen Benutzernamen und ein Passwort, melden Sie sich damit statt über die Social-Login-Schaltfläche an, und aktivieren Sie dann 2FA. Sie behalten auch die Google- oder Apple-Option, sodass nichts, was Sie bereits nutzen, kaputtgeht. Hier ist die vollständige Anleitung." },
    { type: "heading", text: "Was Sie vor dem Start benötigen" },
    { type: "paragraph", html: "Nichts Exotisches. Sie benötigen Zugriff auf das E-Mail-Postfach, das mit Ihrem Konto verknüpft ist, denn dort landen Ihr Benutzername und das Passwort-Reset. Nehmen Sie sich fünf Minuten Zeit und erledigen Sie dies in einem Desktop-Browser statt in der Handy-App, da sich die Einstellungsbildschirme dort einfacher navigieren lassen. Wenn Sie für andere Logins eine Authenticator-App verwenden, halten Sie Ihr Telefon bereit, damit Sie sie in einem Rutsch hinzufügen können." },
    { type: "heading", text: "Warum sich der 2FA-Schalter weigert zu funktionieren" },
    { type: "paragraph", html: "Wenn Sie sich mit Google oder Apple anmelden, beweisen Sie Ihre Identität gegenüber <em>diesen</em>, und sie bürgen für Sie gegenüber Tradovate. Praktisch, aber es hinterlässt eine Lücke. Die Zwei-Faktor-Authentifizierung ist ein zweites Schloss, das auf einem Passwort aufbaut, und die Plattform bestätigt, dass Sie im Besitz dieses ersten Schlosses sind, bevor sie das zweite scharf schaltet. Bei einem Social-Login-Konto gibt es kein erstes Schloss zu bestätigen, sodass die Einstellung entweder gar nichts tut oder eine Passwortabfrage anzeigt, die Sie nicht beantworten können." },
    { type: "paragraph", html: "Sobald Sie demselben Konto einen echten Benutzernamen und ein Passwort hinzufügen, schließt sich diese Lücke. Sie verlieren dabei nicht die Google- oder Apple-Abkürzung. Sie geben dem Konto lediglich eine zweite Eingangstür, und 2FA kann Sie darüber endlich verifizieren." },
    { type: "paragraph", html: "Das fällt einem meist im ungünstigsten Moment auf die Füße. Vielleicht hat Ihre Prop-Firma Sie gebeten, 2FA zu aktivieren, oder Sie richten ein neues Gerät ein und wollen den zusätzlichen Schutz, oder Sie haben einfach eine Geschichte über Kontoübernahmen zu viel gelesen und beschlossen, alles sicherer zu machen. Was auch immer Sie hierher geführt hat, die Blockade ist dieselbe und die Lösung ebenso. Investieren Sie die paar Minuten einmal, und Sie werden nicht wieder darauf stoßen." },
    { type: "heading", text: "Die Lösung, Schritt für Schritt" },
    { type: "heading", text: "Schritt 1: Ihren Benutzernamen wiederherstellen" },
    { type: "paragraph", html: "Ein Social-Login-Konto hat trotzdem einen hinterlegten Benutzernamen, er wurde nur automatisch für Sie generiert, und Sie haben ihn wahrscheinlich nie gesehen. Verwenden Sie auf dem Anmeldebildschirm den Link zur Benutzernamen-Wiederherstellung (er befindet sich in der Nähe der Passwortfelder, meist mit einer Beschriftung wie &ldquo;Benutzername vergessen&rdquo; oder &ldquo;Benutzername abrufen&rdquo;). Geben Sie die mit Ihrem Konto verknüpfte E-Mail-Adresse ein und senden Sie das Formular ab." },
    { type: "paragraph", html: "Prüfen Sie Ihr Postfach. Die E-Mail enthält Ihren vollständigen Benutzernamen, der bei einem Google- oder Apple-Konto meist eine lange, maschinell generierte Zeichenfolge ist. Kopieren Sie ihn exakt, einschließlich aller ungewöhnlichen Zeichen, und lassen Sie diese E-Mail geöffnet. Sie werden ihn in den nächsten beiden Schritten einfügen." },
    { type: "heading", text: "Schritt 2: Ein Passwort festlegen" },
    { type: "paragraph", html: "Erstellen Sie nun das Passwort, das das Konto nie hatte. Öffnen Sie den Link zum Zurücksetzen des Passworts (meist &ldquo;Passwort vergessen&rdquo; auf demselben Anmeldebildschirm oder ein Link in der Wiederherstellungs-E-Mail). Fügen Sie den langen Benutzernamen aus Schritt 1 ein und legen Sie dann ein Passwort fest, das Sie sich tatsächlich merken können. Bestätigen Sie es, und Sie haben die fehlende Zugangsinformation erstellt." },
    { type: "paragraph", html: "Wählen Sie hier etwas Starkes. Dieses Passwort wird zum Anker für jede Sicherheitsebene, die Sie danach hinzufügen, sodass sich die paar zusätzlichen Sekunden lohnen." },
    { type: "heading", text: "Schritt 3: Mit Benutzername und Passwort anmelden, nicht über die Social-Login-Schaltfläche" },
    { type: "paragraph", html: "Das ist der Schritt, den viele überspringen, und es ist der entscheidende. Gehen Sie zurück zur Anmeldeseite und geben Sie Ihren wiederhergestellten Benutzernamen und Ihr neues Passwort in die Felder ein. Klicken Sie dieses Mal <strong class='text-white'>nicht</strong> auf &ldquo;Mit Google anmelden&rdquo; oder &ldquo;Mit Apple anmelden&rdquo;. Die Plattform muss sehen, dass Sie sich mit der Passwort-Zugangsdaten authentifizieren, sonst behandelt sie Sie weiterhin als Social-Login-Sitzung, und die 2FA-Einstellung bleibt inaktiv." },
    { type: "heading", text: "Schritt 4: Ihren Benutzernamen aufräumen (optional, aber lohnenswert)" },
    { type: "paragraph", html: "Dieser automatisch generierte Benutzername ist unschön und schwer zu tippen. Sobald Sie mit dem Passwort angemeldet sind, öffnen Sie Application Settings (das Drei-Schieberegler-Symbol oben rechts) und gehen Sie zur Profil-Registerkarte. Dort gibt es die Option Change Username. Legen Sie etwas fest, das Sie sich merken können, geben Sie zur Bestätigung Ihr aktuelles Passwort ein und speichern Sie. Ab sofort können Sie sich mit einem übersichtlichen Benutzernamen und Passwort anmelden oder weiterhin die Google- oder Apple-Schaltfläche antippen. Beide Wege führen zum selben Konto." },
    { type: "heading", text: "2FA aktivieren und eine stärkere Methode hinzufügen" },
    { type: "paragraph", html: "Sobald ein echtes Passwort vorhanden ist, kooperiert die Sicherheitseinstellung endlich. Öffnen Sie in Application Settings die Registerkarte Sicherheit, suchen Sie die Einstellung 2-Factor Authentication und schalten Sie sie ein. Eine Abfrage verlangt Ihr Passwort, was genau der Sinn all dessen oben ist. Geben Sie es ein, bestätigen Sie, und die Basisebene ist aktiv. Von da an löst eine Anmeldung von einem neuen Gerät oder Browser einen per E-Mail versendeten Bestätigungscode aus." },
    { type: "paragraph", html: "Der E-Mail-Code ist die Untergrenze, nicht die Obergrenze. Scrollen Sie unterhalb des 2FA-Schalters, und Sie finden Optionen, um einen stärkeren zweiten Faktor hinzuzufügen. So schneiden sie im Vergleich ab:" },
    {
      type: "table",
      headers: ["Methode", "Wie sie Sie verifiziert", "Gut zu wissen"],
      rows: [
        ["E-Mail-Code (Basis-2FA)", "Ein Code wird bei einem neuen Gerät oder Browser an die E-Mail-Adresse Ihres Kontos gesendet", "Standardmäßig aktiv, sobald Sie 2FA aktivieren; abhängig vom Zugriff auf das Postfach"],
        ["Authenticator-App (TOTP)", "Ein rotierender 6-stelliger Code aus einer App wie Google Authenticator oder Authy", "Funktioniert offline; die zuverlässigste Option für den Alltag"],
        ["SMS-Code", "Eine Textnachricht an Ihr Telefon bei jedem Anmeldeversuch", "Praktisch, aber abhängig vom Mobilfunkempfang und Ihrem Anbieter"],
        ["Sicherheitsschlüssel", "Ein physischer Hardware-Schlüssel, den Sie antippen oder anschließen", "Stärkste Option; Sie benötigen den Schlüssel jedes Mal griffbereit"],
      ],
    },
    { type: "paragraph", html: "Wenn Sie von einem Hauptgerät aus handeln, ist eine TOTP-Authenticator-App der Sweet Spot. Richten Sie sie ein, solange Sie bereits in den Sicherheitseinstellungen sind, damit Sie später nicht in Eile sind." },
    { type: "paragraph", html: "Ein Hinweis, sobald 2FA scharf geschaltet ist: Die erste Anmeldung von einem neuen Computer, Telefon oder Browser benötigt eine Bestätigung, bevor Orders geroutet werden." },
    { type: "heading", text: "Wenn die Plattform direkt nach der Umstellung hängen bleibt" },
    { type: "paragraph", html: "Wenn Sie Ihre Anmeldemethode ändern und 2FA in einem Rutsch aktivieren, bleibt die Plattform manchmal auf einem Ladebildschirm hängen. Das ist eine Synchronisierungsverzögerung, keine Aussperrung. Geben Sie ihr etwas Zeit, melden Sie sich dann ab und wieder mit Ihrem Benutzernamen und Passwort an. In den meisten Fällen löst sich das innerhalb einer Stunde von selbst." },
    { type: "paragraph", html: "Wenn es danach immer noch hängt, gelten die üblichen Verdächtigen: eine nicht synchronisierte Systemuhr, ein veralteter Browser-Cache oder eine noch aktive Sitzung auf einem anderen Gerät." },
    { type: "heading", text: "Lässt sich immer noch nicht aktivieren? Diese Checkliste durchgehen" },
    { type: "paragraph", html: "Wenn Sie all das oben Genannte getan haben und die Einstellung immer noch nicht mitspielt, gehen Sie diese Punkte durch, bevor Sie sich an den Support wenden:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Prüfen Sie, wie Sie sich in dieser Sitzung angemeldet haben.</strong> Wenn Sie aus Gewohnheit auf die Google- oder Apple-Schaltfläche getippt haben, sieht die Plattform weiterhin eine Social-Login-Sitzung. Melden Sie sich ab und wieder an, indem Sie Ihren Benutzernamen und Ihr Passwort eintippen.",
        "<strong class='text-white'>Prüfen Sie, ob Sie den wiederhergestellten Benutzernamen verwenden, nicht Ihre E-Mail-Adresse.</strong> Der Benutzername und die Konto-E-Mail sind zwei verschiedene Dinge. Die 2FA-Abfrage möchte das Passwort, das mit diesem Benutzernamen verknüpft ist.",
        "<strong class='text-white'>Stellen Sie sicher, dass das Passwort tatsächlich gespeichert wurde.</strong> Wenn das Zurücksetzen nicht abgeschlossen wurde, gibt es weiterhin keine Zugangsdaten zum Überprüfen. Führen Sie das Zurücksetzen des Passworts erneut durch und achten Sie auf die Bestätigung.",
        "<strong class='text-white'>Suchen Sie nach einer noch aktiven Sitzung auf einem anderen Gerät.</strong> Eine zweite aktive Sitzung kann Einstellungsänderungen halb angewendet lassen. Melden Sie sich überall ab und beginnen Sie dann frisch auf einem Gerät.",
        "<strong class='text-white'>Prop- oder Evaluierungskonto?</strong> Möglicherweise gehört der Login der Firma. Zahlen und Regeln variieren je nach Firma und Kontogröße, prüfen Sie daher die aktuellen Anweisungen Ihrer Firma, bevor Sie Zugangsdaten ändern.",
      ],
    },
    { type: "heading", text: "Kurze Zusammenfassung" },
    { type: "paragraph", html: "Ein reines Google- oder Apple-Konto kann 2FA nicht aktivieren, weil es kein Passwort hat, das das zweite Schloss überprüfen könnte. Stellen Sie Ihren Benutzernamen per E-Mail wieder her, legen Sie ein Passwort fest, und melden Sie sich dann mit diesem Benutzernamen und Passwort statt über die Social-Login-Schaltfläche an. Räumen Sie optional den Benutzernamen auf, aktivieren Sie 2FA in den Sicherheitseinstellungen und fügen Sie eine Authenticator-App für einen stärkeren zweiten Faktor hinzu. Die Google- und Apple-Abkürzungen funktionieren die ganze Zeit weiter, sodass Sie nichts verlieren und ein ordentlich abgesichertes Konto gewinnen." },
  ], es: [
    { type: "paragraph", html: "Fue a proteger su cuenta, encontró el control de autenticación de dos factores, hizo clic en él y no ocurrió nada. O apareció un cuadro pidiéndole una contraseña que está seguro de no haber creado nunca. Ese es el síntoma clásico de una cuenta creada con el botón &ldquo;Iniciar sesión con Google&rdquo; o &ldquo;Iniciar sesión con Apple&rdquo;, y no es un error. Esos botones delegan todo el inicio de sesión en Google o Apple, por lo que su cuenta nunca tuvo su propia contraseña. La 2FA necesita una para confirmar que realmente es usted antes de activarse." },
    { type: "paragraph", html: "La solución es breve: dele a la cuenta un nombre de usuario y una contraseña propios, inicie sesión con ellos en lugar del botón social, y luego active la 2FA. También conserva la opción de Google o Apple, así que nada de lo que ya usa se rompe. Aquí tiene la guía completa." },
    { type: "heading", text: "Qué necesita antes de empezar" },
    { type: "paragraph", html: "Nada exótico. Necesita acceso a la bandeja de entrada de correo vinculada a su cuenta, porque ahí llegan su nombre de usuario y el restablecimiento de contraseña. Dedique cinco minutos y hágalo en un navegador de escritorio en lugar de la app del teléfono, ya que las pantallas de configuración son más fáciles de recorrer allí. Si usa una app de autenticación para otros inicios de sesión, tenga su teléfono a mano para añadirla en la misma sesión." },
    { type: "heading", text: "Por qué el interruptor de 2FA se niega a funcionar" },
    { type: "paragraph", html: "Cuando inicia sesión con Google o Apple, está demostrando su identidad ante <em>ellos</em>, y ellos responden por usted ante Tradovate. Práctico, pero deja un vacío. La autenticación de dos factores es un segundo candado que se apoya sobre una contraseña, y la plataforma confirma que usted posee ese primer candado antes de activar el segundo. En una cuenta de inicio de sesión social no hay ningún primer candado que confirmar, por lo que el control no hace nada o muestra una solicitud de contraseña que no puede responder." },
    { type: "paragraph", html: "En el momento en que añade un nombre de usuario y una contraseña reales a la misma cuenta, ese vacío se cierra. No pierde el atajo de Google o Apple. Simplemente le está dando a la cuenta una segunda puerta de entrada, y la 2FA finalmente puede verificarlo a través de ella." },
    { type: "paragraph", html: "Esto suele aparecer en el peor momento. Tal vez su prop firm le pidió activar la 2FA, o está configurando un nuevo dispositivo y quiere la protección adicional, o simplemente leyó demasiadas historias sobre robos de cuentas y decidió reforzar la seguridad. Sea cual sea el motivo que lo trajo hasta aquí, el bloqueo es el mismo y también lo es la solución. Dedique esos minutos una vez y no volverá a encontrárselo." },
    { type: "heading", text: "La solución, paso a paso" },
    { type: "heading", text: "Paso 1: recupere su nombre de usuario" },
    { type: "paragraph", html: "Una cuenta de inicio de sesión social igualmente tiene un nombre de usuario registrado, simplemente se generó automáticamente para usted y probablemente nunca lo ha visto. En la pantalla de inicio de sesión, use el enlace de recuperación de nombre de usuario (se encuentra cerca de los campos de contraseña, normalmente con una etiqueta como &ldquo;Olvidé mi nombre de usuario&rdquo; o &ldquo;Recuperar nombre de usuario&rdquo;). Introduzca la dirección de correo vinculada a su cuenta y envíe." },
    { type: "paragraph", html: "Revise su bandeja de entrada. El correo contiene su nombre de usuario completo, que en el caso de una cuenta de Google o Apple suele ser una cadena larga generada automáticamente. Cópielo exactamente, incluidos los caracteres raros, y mantenga ese correo abierto. Lo pegará en los dos pasos siguientes." },
    { type: "heading", text: "Paso 2: establezca una contraseña" },
    { type: "paragraph", html: "Ahora cree la contraseña que la cuenta nunca tuvo. Abra el enlace de restablecimiento de contraseña (normalmente &ldquo;Olvidé mi contraseña&rdquo; en la misma pantalla de inicio de sesión, o un enlace dentro del correo de recuperación). Pegue el nombre de usuario largo del paso 1 y luego establezca una contraseña que realmente vaya a recordar. Confírmela, y habrá terminado de crear la credencial que faltaba." },
    { type: "paragraph", html: "Elija algo robusto aquí. Esta contraseña se convierte en el ancla de cada capa de seguridad que añada después, así que vale la pena dedicar unos segundos extra." },
    { type: "heading", text: "Paso 3: inicie sesión con el nombre de usuario y la contraseña, no con el botón social" },
    { type: "paragraph", html: "Este es el paso que la gente se salta, y es el que importa. Vuelva a la página de inicio de sesión y escriba su nombre de usuario recuperado y su nueva contraseña en los campos. Esta vez, <strong class='text-white'>no</strong> haga clic en &ldquo;Iniciar sesión con Google&rdquo; ni en &ldquo;Iniciar sesión con Apple&rdquo;. La plataforma tiene que verlo autenticarse con la credencial de contraseña; de lo contrario, sigue tratándolo como una sesión de inicio social y el control de 2FA permanece inactivo." },
    { type: "heading", text: "Paso 4: ordene su nombre de usuario (opcional, pero recomendable)" },
    { type: "paragraph", html: "Ese nombre de usuario autogenerado es feo y difícil de escribir. Una vez que haya iniciado sesión con la contraseña, abra Application Settings (el icono de tres controles deslizantes en la esquina superior derecha) y vaya a la pestaña de perfil. Ahí hay una opción Change Username. Establezca algo que recuerde, introduzca su contraseña actual para confirmar y guarde. A partir de ahora puede iniciar sesión con un nombre de usuario y contraseña más limpios, o seguir pulsando el botón de Google o Apple. Ambas rutas llegan a la misma cuenta." },
    { type: "heading", text: "Active la 2FA y añada un método más robusto" },
    { type: "paragraph", html: "Con una contraseña real ya establecida, el control de seguridad por fin coopera. En Application Settings, abra la pestaña de seguridad, busque el control 2-Factor Authentication y actívelo. Un aviso pide su contraseña, que es exactamente el objetivo de todo lo anterior. Introdúzcala, confirme, y la capa base queda activa. A partir de entonces, iniciar sesión desde un dispositivo o navegador nuevo activa un código de verificación enviado por correo." },
    { type: "paragraph", html: "El código por correo es el mínimo, no el máximo. Desplácese hacia abajo del interruptor de 2FA y encontrará opciones para añadir un segundo factor más robusto. Así se comparan:" },
    {
      type: "table",
      headers: ["Método", "Cómo le verifica", "Bueno saberlo"],
      rows: [
        ["Código por correo (2FA base)", "Se envía un código por correo a la dirección de su cuenta en un dispositivo o navegador nuevo", "Activo por defecto al habilitar la 2FA; depende del acceso a la bandeja de entrada"],
        ["App de autenticación (TOTP)", "Un código rotativo de 6 dígitos de una app como Google Authenticator o Authy", "Funciona sin conexión; la opción más fiable para el uso diario"],
        ["Código SMS", "Un mensaje de texto a su teléfono en cada intento de inicio de sesión", "Cómodo, pero depende de la señal móvil y de su operador"],
        ["Llave de seguridad", "Una llave física de hardware que toca o conecta", "La opción más sólida; necesita la llave a mano cada vez"],
      ],
    },
    { type: "paragraph", html: "Si opera desde una única máquina principal, una app de autenticación TOTP es el punto óptimo. Configúrela mientras ya está en la configuración de seguridad, para no tener que apresurarse después." },
    { type: "paragraph", html: "Un aviso una vez que la 2FA está activada: el primer inicio de sesión desde cualquier ordenador, teléfono o navegador nuevo necesita aprobación antes de que se enruten órdenes." },
    { type: "heading", text: "Si la plataforma se cuelga justo después del cambio" },
    { type: "paragraph", html: "Cambiar su método de inicio de sesión y activar la 2FA en la misma sesión a veces deja la plataforma dando vueltas en una pantalla de carga. Es un retraso de sincronización, no un bloqueo. Déle un poco de tiempo, luego cierre sesión y vuelva a iniciarla con su nombre de usuario y contraseña. En la mayoría de los casos se resuelve solo en menos de una hora." },
    { type: "paragraph", html: "Si sigue atascado después de eso, se aplican los sospechosos habituales: un reloj del sistema desincronizado, una caché del navegador desactualizada, o una sesión que persiste en otro dispositivo." },
    { type: "heading", text: "¿Sigue sin activarse? Revise esta lista de verificación" },
    { type: "paragraph", html: "Si hizo todo lo anterior y el control sigue sin cooperar, revise estos puntos antes de contactar con soporte:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Confirme cómo inició sesión en esta sesión.</strong> Si pulsó el botón de Google o Apple por costumbre, la plataforma sigue viendo una sesión social. Cierre sesión y vuelva a entrar escribiendo su nombre de usuario y contraseña.",
        "<strong class='text-white'>Compruebe que está usando el nombre de usuario recuperado, no su correo electrónico.</strong> El nombre de usuario y el correo de la cuenta son dos cosas distintas. La solicitud de 2FA quiere la contraseña asociada a ese nombre de usuario.",
        "<strong class='text-white'>Asegúrese de que la contraseña se guardó realmente.</strong> Si el restablecimiento no se completó, aún no hay ninguna credencial que verificar. Ejecute de nuevo el restablecimiento de contraseña y esté atento a la confirmación.",
        "<strong class='text-white'>Busque una sesión que siga activa en otro dispositivo.</strong> Una segunda sesión activa puede dejar los cambios de configuración aplicados solo a medias. Cierre sesión en todas partes y empiece de nuevo en un solo dispositivo.",
        "<strong class='text-white'>¿Cuenta de prop firm o de evaluación?</strong> Es posible que la firma sea la propietaria del acceso. Los números y las reglas varían según la firma y el tamaño de la cuenta, así que consulte las instrucciones actuales de su firma antes de cambiar credenciales.",
      ],
    },
    { type: "heading", text: "Resumen rápido" },
    { type: "paragraph", html: "Una cuenta puramente de Google o Apple no puede activar la 2FA porque no tiene contraseña que el segundo candado pueda verificar. Recupere su nombre de usuario por correo, establezca una contraseña y luego inicie sesión con ese nombre de usuario y contraseña en lugar del botón social. De forma opcional, ordene el nombre de usuario, active la 2FA en la configuración de seguridad y añada una app de autenticación para un segundo factor más robusto. Los atajos de Google y Apple siguen funcionando todo el tiempo, así que no pierde nada y gana una cuenta correctamente protegida." },
  ], fr: [
    { type: "paragraph", html: "Vous êtes allé sécuriser votre compte, avez trouvé le contrôle d'authentification à deux facteurs, cliqué dessus, et rien ne s'est passé. Ou une fenêtre est apparue demandant un mot de passe dont vous êtes certain de ne jamais l'avoir créé. C'est le symptôme classique d'un compte créé avec le bouton &ldquo;Se connecter avec Google&rdquo; ou &ldquo;Se connecter avec Apple&rdquo;, et ce n'est pas un bug. Ces boutons délèguent la connexion entière à Google ou Apple, de sorte que votre compte n'a jamais eu son propre mot de passe. La 2FA en a besoin d'un pour confirmer qu'il s'agit bien de vous avant de s'activer." },
    { type: "paragraph", html: "La solution est simple : donnez au compte un identifiant et un mot de passe en bonne et due forme, connectez-vous avec ceux-ci plutôt qu'avec le bouton social, puis activez la 2FA. Vous conservez également l'option Google ou Apple, donc rien de ce que vous utilisez déjà ne cesse de fonctionner. Voici le guide complet." },
    { type: "heading", text: "Ce dont vous avez besoin avant de commencer" },
    { type: "paragraph", html: "Rien d'exotique. Vous avez besoin d'accéder à la boîte mail liée à votre compte, car c'est là qu'atterrissent votre identifiant et la réinitialisation du mot de passe. Prévoyez cinq minutes et faites cela sur un navigateur de bureau plutôt que sur l'application mobile, car les écrans de paramètres y sont plus faciles à parcourir. Si vous utilisez une application d'authentification pour d'autres connexions, gardez votre téléphone à portée de main afin de pouvoir l'ajouter dans la foulée." },
    { type: "heading", text: "Pourquoi l'interrupteur 2FA refuse de fonctionner" },
    { type: "paragraph", html: "Lorsque vous vous connectez avec Google ou Apple, vous prouvez votre identité <em>à eux</em>, et ils se portent garants de vous auprès de Tradovate. Pratique, mais cela laisse une faille. L'authentification à deux facteurs est un second verrou empilé sur un mot de passe, et la plateforme confirme que vous possédez ce premier verrou avant d'armer le second. Sur un compte à connexion sociale, il n'y a aucun premier verrou à confirmer, si bien que le contrôle ne fait rien ou affiche une demande de mot de passe à laquelle vous ne pouvez pas répondre." },
    { type: "paragraph", html: "Dès que vous ajoutez un véritable identifiant et un mot de passe au même compte, cette faille se referme. Vous ne perdez pas le raccourci Google ou Apple. Vous donnez simplement au compte une seconde porte d'entrée, et la 2FA peut enfin vous vérifier par ce biais." },
    { type: "paragraph", html: "Cela a tendance à survenir au pire moment. Peut-être que votre prop firm vous a demandé d'activer la 2FA, ou vous configurez un nouvel appareil et voulez cette protection supplémentaire, ou vous avez simplement lu une histoire de trop sur des piratages de comptes et décidé de renforcer la sécurité. Quelle que soit la raison qui vous amène ici, le blocage est le même, tout comme la solution. Consacrez ces quelques minutes une fois pour toutes et vous n'y serez plus confronté." },
    { type: "heading", text: "La solution, étape par étape" },
    { type: "heading", text: "Étape 1 : récupérez votre identifiant" },
    { type: "paragraph", html: "Un compte à connexion sociale possède tout de même un identifiant enregistré, il a simplement été généré automatiquement pour vous et vous ne l'avez probablement jamais vu. Sur l'écran de connexion, utilisez le lien de récupération d'identifiant (il se trouve près des champs de mot de passe, généralement intitulé quelque chose comme &ldquo;Identifiant oublié&rdquo; ou &ldquo;Récupérer l'identifiant&rdquo;). Saisissez l'adresse e-mail liée à votre compte et validez." },
    { type: "paragraph", html: "Vérifiez votre boîte mail. L'e-mail contient votre identifiant complet, qui pour un compte Google ou Apple tend à être une longue chaîne générée automatiquement. Copiez-le exactement, y compris les caractères inhabituels, et gardez cet e-mail ouvert. Vous le collerez dans les deux prochaines étapes." },
    { type: "heading", text: "Étape 2 : définissez un mot de passe" },
    { type: "paragraph", html: "Créez maintenant le mot de passe que le compte n'a jamais eu. Ouvrez le lien de réinitialisation du mot de passe (généralement &ldquo;Mot de passe oublié&rdquo; sur le même écran de connexion, ou un lien dans l'e-mail de récupération). Collez l'identifiant long de l'étape 1, puis définissez un mot de passe dont vous vous souviendrez réellement. Confirmez-le, et vous aurez terminé de créer l'identifiant manquant." },
    { type: "paragraph", html: "Choisissez quelque chose de solide ici. Ce mot de passe devient l'ancrage de chaque couche de sécurité que vous ajouterez ensuite, ces quelques secondes supplémentaires en valent donc la peine." },
    { type: "heading", text: "Étape 3 : connectez-vous avec l'identifiant et le mot de passe, pas avec le bouton social" },
    { type: "paragraph", html: "C'est l'étape que les gens sautent, et c'est celle qui compte. Retournez à la page de connexion et saisissez votre identifiant récupéré et votre nouveau mot de passe dans les champs. Cette fois, ne cliquez <strong class='text-white'>pas</strong> sur &ldquo;Se connecter avec Google&rdquo; ni sur &ldquo;Se connecter avec Apple&rdquo;. La plateforme doit vous voir vous authentifier avec l'identifiant de mot de passe, sinon elle continue de vous traiter comme une session de connexion sociale et le contrôle 2FA reste inactif." },
    { type: "heading", text: "Étape 4 : nettoyez votre identifiant (facultatif, mais utile)" },
    { type: "paragraph", html: "Cet identifiant généré automatiquement est peu élégant et difficile à saisir. Une fois connecté avec le mot de passe, ouvrez Application Settings (l'icône à trois curseurs dans le coin supérieur droit) et allez dans l'onglet profil. Il y a une option Change Username. Définissez quelque chose dont vous vous souviendrez, saisissez votre mot de passe actuel pour confirmer, puis enregistrez. Désormais, vous pouvez vous connecter avec un identifiant et un mot de passe simples, ou toujours appuyer sur le bouton Google ou Apple. Les deux chemins mènent au même compte." },
    { type: "heading", text: "Activez la 2FA et ajoutez une méthode plus robuste" },
    { type: "paragraph", html: "Avec un véritable mot de passe en place, le contrôle de sécurité coopère enfin. Dans Application Settings, ouvrez l'onglet sécurité, trouvez le contrôle 2-Factor Authentication et activez-le. Une invite demande votre mot de passe, ce qui est exactement le but de tout ce qui précède. Saisissez-le, confirmez, et la couche de base est active. Dès lors, se connecter depuis un nouvel appareil ou navigateur déclenche un code de vérification envoyé par e-mail." },
    { type: "paragraph", html: "Le code par e-mail est le minimum, pas le maximum. Faites défiler sous l'interrupteur 2FA et vous trouverez des options pour ajouter un second facteur plus robuste. Voici comment ils se comparent :" },
    {
      type: "table",
      headers: ["Méthode", "Comment elle vous vérifie", "Bon à savoir"],
      rows: [
        ["Code par e-mail (2FA de base)", "Un code est envoyé par e-mail à l'adresse de votre compte sur un nouvel appareil ou navigateur", "Activé par défaut dès que vous activez la 2FA ; dépend de l'accès à la boîte mail"],
        ["Application d'authentification (TOTP)", "Un code rotatif à 6 chiffres provenant d'une application comme Google Authenticator ou Authy", "Fonctionne hors ligne ; l'option la plus fiable au quotidien"],
        ["Code SMS", "Un SMS envoyé à votre téléphone à chaque tentative de connexion", "Pratique, mais dépend du signal mobile et de votre opérateur"],
        ["Clé de sécurité", "Une clé physique que vous touchez ou branchez", "Option la plus solide ; vous devez avoir la clé sur vous à chaque fois"],
      ],
    },
    { type: "paragraph", html: "Si vous tradez depuis une seule machine principale, une application d'authentification TOTP est l'option idéale. Configurez-la pendant que vous êtes déjà dans les paramètres de sécurité, pour ne pas vous précipiter plus tard." },
    { type: "paragraph", html: "Un point important une fois la 2FA armée : la première connexion depuis un nouvel ordinateur, téléphone ou navigateur nécessite une approbation avant que les ordres puissent être routés." },
    { type: "heading", text: "Si la plateforme se fige juste après le changement" },
    { type: "paragraph", html: "Changer votre méthode de connexion et activer la 2FA en une seule fois laisse parfois la plateforme tourner en boucle sur un écran de chargement. C'est un délai de synchronisation, pas un blocage. Laissez-lui un peu de temps, puis déconnectez-vous et reconnectez-vous avec votre identifiant et votre mot de passe. Dans la plupart des cas, cela se résout tout seul en moins d'une heure." },
    { type: "paragraph", html: "Si cela reste bloqué après cela, les suspects habituels s'appliquent : une horloge système désynchronisée, un cache de navigateur obsolète, ou une session persistante sur un autre appareil." },
    { type: "heading", text: "Toujours impossible à activer ? Passez en revue cette liste de vérification" },
    { type: "paragraph", html: "Si vous avez fait tout ce qui précède et que le contrôle refuse toujours de coopérer, passez en revue ces points avant de contacter le support :" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Confirmez comment vous vous êtes connecté lors de cette session.</strong> Si vous avez appuyé sur le bouton Google ou Apple par habitude, la plateforme voit toujours une session sociale. Déconnectez-vous et reconnectez-vous en saisissant votre identifiant et votre mot de passe.",
        "<strong class='text-white'>Vérifiez que vous utilisez l'identifiant récupéré, pas votre e-mail.</strong> L'identifiant et l'e-mail du compte sont deux choses différentes. L'invite 2FA veut le mot de passe rattaché à cet identifiant.",
        "<strong class='text-white'>Vérifiez que le mot de passe a bien été enregistré.</strong> Si la réinitialisation ne s'est pas terminée, il n'y a toujours aucun identifiant à vérifier. Relancez la réinitialisation du mot de passe et surveillez la confirmation.",
        "<strong class='text-white'>Recherchez une session persistante sur un autre appareil.</strong> Une deuxième session active peut laisser les modifications de paramètres à moitié appliquées. Déconnectez-vous partout, puis repartez de zéro sur un seul appareil.",
        "<strong class='text-white'>Compte prop firm ou d'évaluation ?</strong> La firme peut détenir les identifiants de connexion. Les chiffres et les règles varient selon la firme et la taille du compte, vérifiez donc les instructions actuelles de votre firme avant de modifier vos identifiants.",
      ],
    },
    { type: "heading", text: "Récapitulatif rapide" },
    { type: "paragraph", html: "Un compte purement Google ou Apple ne peut pas activer la 2FA car il n'a aucun mot de passe que le second verrou puisse vérifier. Récupérez votre identifiant par e-mail, définissez un mot de passe, puis connectez-vous avec cet identifiant et ce mot de passe plutôt qu'avec le bouton social. Vous pouvez éventuellement nettoyer l'identifiant, activer la 2FA dans les paramètres de sécurité, et ajouter une application d'authentification pour un second facteur plus robuste. Les raccourcis Google et Apple continuent de fonctionner tout du long, vous ne perdez donc rien et gagnez un compte correctement verrouillé." },
  ], it: [
    { type: "paragraph", html: "È andato a proteggere il suo conto, ha trovato il controllo per l'autenticazione a due fattori, ci ha cliccato sopra e non è successo nulla. Oppure è comparsa una finestra che chiedeva una password che è sicuro di non aver mai creato. Questo è il sintomo classico di un conto creato con il pulsante &ldquo;Accedi con Google&rdquo; o &ldquo;Accedi con Apple&rdquo;, e non è un bug. Questi pulsanti delegano l'intero accesso a Google o Apple, quindi il suo conto non ha mai avuto una password propria. La 2FA ne richiede una per confermare che è davvero lei prima di attivarsi." },
    { type: "paragraph", html: "La soluzione è breve: assegni al conto un nome utente e una password adeguati, effettui l'accesso con questi invece del pulsante social, quindi attivi la 2FA. Manterrà comunque l'opzione Google o Apple, quindi nulla di ciò che già usa smetterà di funzionare. Ecco la procedura completa." },
    { type: "heading", text: "Cosa le serve prima di iniziare" },
    { type: "paragraph", html: "Niente di esotico. Le serve l'accesso alla casella email collegata al suo conto, perché è lì che arrivano il nome utente e il reset della password. Si ritagli cinque minuti e lo faccia da un browser desktop anziché dall'app del telefono, poiché le schermate delle impostazioni sono più facili da navigare lì. Se usa un'app di autenticazione per altri accessi, tenga il telefono a portata di mano così da poterla aggiungere nella stessa sessione." },
    { type: "heading", text: "Perché l'interruttore della 2FA si rifiuta di funzionare" },
    { type: "paragraph", html: "Quando accede con Google o Apple, sta dimostrando la sua identità a <em>loro</em>, ed è lui a garantire per lei presso Tradovate. Comodo, ma lascia una lacuna. L'autenticazione a due fattori è un secondo lucchetto sovrapposto a una password, e la piattaforma conferma che lei possiede quel primo lucchetto prima di attivare il secondo. Su un conto con accesso social non c'è alcun primo lucchetto da confermare, quindi il controllo non fa nulla oppure mostra una richiesta di password a cui non può rispondere." },
    { type: "paragraph", html: "Nel momento in cui aggiunge un vero nome utente e una password allo stesso conto, quella lacuna si chiude. Non perde la scorciatoia Google o Apple. Sta semplicemente dando al conto una seconda porta d'ingresso, e la 2FA può finalmente verificarla attraverso di essa." },
    { type: "paragraph", html: "Questo tende a manifestarsi nel momento peggiore. Forse la sua prop firm le ha chiesto di attivare la 2FA, oppure sta configurando un nuovo dispositivo e vuole la protezione extra, o ha semplicemente letto una storia di troppo su furti di account e ha deciso di rafforzare la sicurezza. Qualunque cosa l'abbia portata qui, il blocco è lo stesso e così la cura. Dedichi questi pochi minuti una volta sola e non ci si imbatterà più." },
    { type: "heading", text: "La soluzione, passo dopo passo" },
    { type: "heading", text: "Passo 1: recuperi il suo nome utente" },
    { type: "paragraph", html: "Un conto con accesso social ha comunque un nome utente registrato, è stato semplicemente generato automaticamente per lei e probabilmente non l'ha mai visto. Nella schermata di accesso, usi il link di recupero del nome utente (si trova vicino ai campi della password, di solito etichettato come &ldquo;Nome utente dimenticato&rdquo; o &ldquo;Recupera nome utente&rdquo;). Inserisca l'indirizzo email collegato al suo conto e invii." },
    { type: "paragraph", html: "Controlli la sua casella email. Il messaggio contiene il suo nome utente completo, che per un conto Google o Apple tende a essere una lunga stringa generata automaticamente. Lo copi esattamente, inclusi eventuali caratteri insoliti, e tenga quell'email aperta. Lo incollerà nei prossimi due passaggi." },
    { type: "heading", text: "Passo 2: imposti una password" },
    { type: "paragraph", html: "Ora crei la password che il conto non ha mai avuto. Apra il link di reset della password (di solito &ldquo;Password dimenticata&rdquo; nella stessa schermata di accesso, oppure un link all'interno dell'email di recupero). Incolli il nome utente lungo ottenuto al passo 1, quindi imposti una password che ricorderà davvero. La confermi, e avrà completato la creazione della credenziale mancante." },
    { type: "paragraph", html: "Scelga qualcosa di robusto qui. Questa password diventa l'ancora per ogni livello di sicurezza che aggiungerà in seguito, quindi vale la pena dedicare qualche secondo in più." },
    { type: "heading", text: "Passo 3: effettui l'accesso con nome utente e password, non con il pulsante social" },
    { type: "paragraph", html: "Questo è il passaggio che le persone saltano, ed è quello che conta davvero. Torni alla pagina di accesso e digiti nei campi il nome utente recuperato e la nuova password. Questa volta <strong class='text-white'>non</strong> clicchi su &ldquo;Accedi con Google&rdquo; o &ldquo;Accedi con Apple&rdquo;. La piattaforma deve vederla autenticarsi con la credenziale della password, altrimenti continua a trattarla come una sessione di accesso social e il controllo della 2FA resta inattivo." },
    { type: "heading", text: "Passo 4: sistemi il suo nome utente (facoltativo, ma consigliato)" },
    { type: "paragraph", html: "Quel nome utente generato automaticamente è brutto e difficile da digitare. Una volta effettuato l'accesso con la password, apra Application Settings (l'icona a tre cursori nell'angolo in alto a destra) e vada alla scheda del profilo. È presente un'opzione Change Username. Imposti qualcosa che ricorderà, inserisca la password attuale per confermare e salvi. Da ora in poi potrà accedere con un nome utente e una password puliti, oppure continuare a toccare il pulsante Google o Apple. Entrambi i percorsi portano allo stesso conto." },
    { type: "heading", text: "Attivi la 2FA e aggiunga un metodo più robusto" },
    { type: "paragraph", html: "Con una password reale ormai impostata, il controllo di sicurezza finalmente collabora. In Application Settings, apra la scheda sicurezza, trovi il controllo 2-Factor Authentication e lo attivi. Una richiesta chiede la sua password, che è esattamente lo scopo di tutto quanto sopra. La inserisca, confermi, e il livello base è attivo. Da quel momento, accedere da un nuovo dispositivo o browser attiva un codice di verifica inviato via email." },
    { type: "paragraph", html: "Il codice via email è il minimo, non il massimo. Scorra sotto l'interruttore della 2FA e troverà opzioni per aggiungere un secondo fattore più robusto. Ecco come si confrontano:" },
    {
      type: "table",
      headers: ["Metodo", "Come la verifica", "Utile sapere"],
      rows: [
        ["Codice via email (2FA base)", "Un codice viene inviato via email all'indirizzo del suo conto su un nuovo dispositivo o browser", "Attivo di default una volta abilitata la 2FA; dipende dall'accesso alla casella email"],
        ["App di autenticazione (TOTP)", "Un codice rotante a 6 cifre generato da un'app come Google Authenticator o Authy", "Funziona offline; l'opzione più affidabile per l'uso quotidiano"],
        ["Codice SMS", "Un messaggio di testo al suo telefono a ogni tentativo di accesso", "Comodo, ma dipende dal segnale cellulare e dal suo operatore"],
        ["Chiave di sicurezza", "Una chiave fisica hardware da toccare o collegare", "L'opzione più solida; deve avere la chiave a portata di mano ogni volta"],
      ],
    },
    { type: "paragraph", html: "Se fa trading da un'unica macchina principale, un'app di autenticazione TOTP è la soluzione ideale. La configuri mentre è già nelle impostazioni di sicurezza, così non dovrà affrettarsi in seguito." },
    { type: "paragraph", html: "Un avviso una volta attivata la 2FA: il primo accesso da un nuovo computer, telefono o browser richiede un'approvazione prima che possa instradare ordini." },
    { type: "heading", text: "Se la piattaforma si blocca subito dopo la modifica" },
    { type: "paragraph", html: "Cambiare il metodo di accesso e attivare la 2FA nella stessa sessione a volte lascia la piattaforma bloccata su una schermata di caricamento. È un ritardo di sincronizzazione, non un blocco. Le dia un po' di tempo, poi esca e rientri con il suo nome utente e password. Nella maggior parte dei casi si risolve da solo entro un'ora." },
    { type: "paragraph", html: "Se dopo tutto ciò resta bloccato, si applicano i soliti sospetti: un orologio di sistema non sincronizzato, una cache del browser obsoleta, o una sessione ancora attiva su un altro dispositivo." },
    { type: "heading", text: "Non si attiva ancora? Segua questa checklist" },
    { type: "paragraph", html: "Se ha fatto tutto quanto sopra e il controllo continua a non cooperare, verifichi questi punti prima di contattare l'assistenza:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Verifichi come ha effettuato l'accesso in questa sessione.</strong> Se ha toccato il pulsante Google o Apple per abitudine, la piattaforma continua a vedere una sessione social. Esca e rientri digitando il suo nome utente e la sua password.",
        "<strong class='text-white'>Verifichi di usare il nome utente recuperato, non la sua email.</strong> Il nome utente e l'email del conto sono due cose diverse. La richiesta della 2FA vuole la password associata a quel nome utente.",
        "<strong class='text-white'>Si assicuri che la password sia stata effettivamente salvata.</strong> Se il reset non si è completato, non c'è ancora alcuna credenziale da verificare. Esegua di nuovo il reset della password e verifichi la conferma.",
        "<strong class='text-white'>Cerchi una sessione ancora attiva su un altro dispositivo.</strong> Una seconda sessione attiva può lasciare le modifiche alle impostazioni applicate solo a metà. Esca ovunque, quindi ricominci da capo su un solo dispositivo.",
        "<strong class='text-white'>Conto prop firm o di valutazione?</strong> La firm potrebbe possedere le credenziali di accesso. Numeri e regole variano per firm e dimensione del conto, quindi verifichi le istruzioni attuali della sua firm prima di modificare le credenziali.",
      ],
    },
    { type: "heading", text: "Riepilogo rapido" },
    { type: "paragraph", html: "Un conto puramente Google o Apple non può attivare la 2FA perché non ha una password che il secondo lucchetto possa verificare. Recuperi il suo nome utente via email, imposti una password, quindi effettui l'accesso con quel nome utente e password invece del pulsante social. Facoltativamente, sistemi il nome utente, attivi la 2FA nelle impostazioni di sicurezza e aggiunga un'app di autenticazione per un secondo fattore più robusto. Le scorciatoie Google e Apple continuano a funzionare per tutto il tempo, quindi non perde nulla e ottiene un conto adeguatamente protetto." },
  ] },
  ctaHeading: { en: "Don't Let a Login Prompt Slow Your Strategy", de: "Lassen Sie sich von einer Login-Abfrage nicht Ihre Strategie bremsen", es: "No deje que una solicitud de inicio de sesión frene su estrategia", fr: "Ne laissez pas une invite de connexion ralentir votre stratégie", it: "Non lasci che una richiesta di accesso rallenti la sua strategia" },
  ctaText: { en: "PickMyTrade fires your TradingView signals straight into Tradovate, hands-free, even while you're sorting out account security settings.", de: "PickMyTrade leitet Ihre TradingView-Signale freihändig direkt an Tradovate weiter – auch während Sie die Sicherheitseinstellungen Ihres Kontos einrichten.", es: "PickMyTrade envía sus señales de TradingView directamente a Tradovate, sin intervención manual, incluso mientras está resolviendo la configuración de seguridad de su cuenta.", fr: "PickMyTrade transmet vos signaux TradingView directement à Tradovate, sans intervention manuelle, même pendant que vous réglez les paramètres de sécurité de votre compte.", it: "PickMyTrade invia i suoi segnali TradingView direttamente a Tradovate, senza intervento manuale, anche mentre sta sistemando le impostazioni di sicurezza del conto." },
  ctaButtonText: { en: "Start Your Free 7-Day Trial", de: "Starten Sie Ihre kostenlose 5-Tage-Testversion", es: "Inicie su prueba gratuita de 5 días", fr: "Démarrez votre essai gratuit de 5 jours", it: "Inizi la sua prova gratuita di 5 giorni" },
  ctaUrl: "https://app.pickmytrade.trade/?register=true&utm_source=content&utm_medium=debugging",
  faqHeading: { en: "Frequently Asked Questions", de: "Häufig gestellte Fragen", es: "Preguntas frecuentes", fr: "Questions fréquentes", it: "Domande frequenti" },
  faqs: { en: [
    { q: "Why can't I enable 2FA when I signed in with Google or Apple?", a: "Two-factor authentication verifies you with a password before it arms itself, and an account created purely through Google or Apple sign-in never set one. Add a username and password credential to the same account first, then the 2FA control will work." },
    { q: "Does setting a password remove my Google or Apple sign-in?", a: "No. Adding a username and password gives your account a second way in. You can still use the Google or Apple button, or type your new username and password. Both point at the same account and the same funds." },
    { q: "How do I find my username if I only ever used Google or Apple sign-in?", a: "Use the username recovery link on the login screen and enter the email tied to your account. The full username is emailed to you. For social-login accounts it is usually a long auto-generated string, which you can change to something readable later." },
    { q: "Can I use an authenticator app instead of email codes?", a: "The base 2FA layer emails a verification code when you sign in from a new device or browser. After that layer is on, you can add stronger methods in the security settings, including a TOTP authenticator app, SMS codes, or a hardware security key." },
    { q: "The platform hangs on loading right after I switched credentials. What now?", a: "A short sync delay right after you switch credentials or flip on 2FA is normal. Give it a little time, then sign out and back in. If it still hangs, clear your browser cache or try a different browser before contacting support." },
    { q: "Does my prop firm account work the same way?", a: "Not always. Some firms manage the login credentials on evaluation accounts for you, so the steps and available security options can differ. Check your firm's current login instructions before changing anything." },
  ], de: [
    { q: "Warum kann ich 2FA nicht aktivieren, wenn ich mich mit Google oder Apple angemeldet habe?", a: "Die Zwei-Faktor-Authentifizierung verifiziert Sie mit einem Passwort, bevor sie sich scharf schaltet, und ein Konto, das ausschließlich über Google- oder Apple-Login erstellt wurde, hat nie eines festgelegt. Fügen Sie zunächst demselben Konto einen Benutzernamen und ein Passwort hinzu, dann funktioniert die 2FA-Einstellung." },
    { q: "Entfernt das Festlegen eines Passworts meine Google- oder Apple-Anmeldung?", a: "Nein. Das Hinzufügen eines Benutzernamens und Passworts gibt Ihrem Konto einen zweiten Zugangsweg. Sie können weiterhin die Google- oder Apple-Schaltfläche nutzen oder Ihren neuen Benutzernamen und Ihr Passwort eingeben. Beide führen zum selben Konto und denselben Geldern." },
    { q: "Wie finde ich meinen Benutzernamen, wenn ich immer nur die Google- oder Apple-Anmeldung genutzt habe?", a: "Nutzen Sie den Link zur Benutzernamen-Wiederherstellung auf dem Anmeldebildschirm und geben Sie die mit Ihrem Konto verknüpfte E-Mail-Adresse ein. Der vollständige Benutzername wird Ihnen per E-Mail zugesandt. Bei Social-Login-Konten ist es meist eine lange, automatisch generierte Zeichenfolge, die Sie später in etwas Lesbares ändern können." },
    { q: "Kann ich eine Authenticator-App anstelle von E-Mail-Codes verwenden?", a: "Die Basis-2FA-Ebene sendet einen Bestätigungscode per E-Mail, wenn Sie sich von einem neuen Gerät oder Browser anmelden. Sobald diese Ebene aktiv ist, können Sie in den Sicherheitseinstellungen stärkere Methoden hinzufügen, darunter eine TOTP-Authenticator-App, SMS-Codes oder einen Hardware-Sicherheitsschlüssel." },
    { q: "Die Plattform hängt beim Laden direkt nachdem ich die Zugangsdaten gewechselt habe. Was jetzt?", a: "Eine kurze Synchronisierungsverzögerung direkt nach dem Wechsel der Zugangsdaten oder dem Aktivieren von 2FA ist normal. Geben Sie ihr etwas Zeit, melden Sie sich dann ab und wieder an. Hängt es immer noch, leeren Sie den Browser-Cache oder probieren Sie einen anderen Browser, bevor Sie den Support kontaktieren." },
    { q: "Funktioniert mein Prop-Firm-Konto genauso?", a: "Nicht immer. Manche Firmen verwalten die Zugangsdaten für Evaluierungskonten selbst, sodass sich die Schritte und verfügbaren Sicherheitsoptionen unterscheiden können. Prüfen Sie die aktuellen Anmeldeanweisungen Ihrer Firma, bevor Sie etwas ändern." },
  ], es: [
    { q: "¿Por qué no puedo activar la 2FA si inicié sesión con Google o Apple?", a: "La autenticación de dos factores lo verifica con una contraseña antes de activarse, y una cuenta creada únicamente mediante el inicio de sesión con Google o Apple nunca estableció una. Añada primero una credencial de nombre de usuario y contraseña a esa misma cuenta, y entonces el control de 2FA funcionará." },
    { q: "¿Establecer una contraseña elimina mi inicio de sesión con Google o Apple?", a: "No. Añadir un nombre de usuario y una contraseña le da a su cuenta una segunda vía de acceso. Puede seguir usando el botón de Google o Apple, o escribir su nuevo nombre de usuario y contraseña. Ambos apuntan a la misma cuenta y los mismos fondos." },
    { q: "¿Cómo encuentro mi nombre de usuario si solo he usado el inicio de sesión con Google o Apple?", a: "Use el enlace de recuperación de nombre de usuario en la pantalla de inicio de sesión e introduzca el correo vinculado a su cuenta. El nombre de usuario completo se le envía por correo. En las cuentas de inicio de sesión social suele ser una cadena larga generada automáticamente, que puede cambiar más tarde por algo legible." },
    { q: "¿Puedo usar una app de autenticación en lugar de códigos por correo?", a: "La capa base de 2FA envía un código de verificación por correo cuando inicia sesión desde un dispositivo o navegador nuevo. Una vez activa esa capa, puede añadir métodos más robustos en la configuración de seguridad, incluida una app de autenticación TOTP, códigos SMS o una llave de seguridad de hardware." },
    { q: "La plataforma se cuelga al cargar justo después de cambiar las credenciales. ¿Qué hago?", a: "Un breve retraso de sincronización justo después de cambiar las credenciales o activar la 2FA es normal. Déle un poco de tiempo, luego cierre sesión y vuelva a entrar. Si sigue colgada, borre la caché del navegador o pruebe con otro navegador antes de contactar con soporte." },
    { q: "¿Mi cuenta de prop firm funciona de la misma manera?", a: "No siempre. Algunas firmas gestionan las credenciales de inicio de sesión de las cuentas de evaluación por usted, por lo que los pasos y las opciones de seguridad disponibles pueden diferir. Consulte las instrucciones de inicio de sesión actuales de su firma antes de cambiar nada." },
  ], fr: [
    { q: "Pourquoi ne puis-je pas activer la 2FA alors que je me suis connecté avec Google ou Apple ?", a: "L'authentification à deux facteurs vous vérifie avec un mot de passe avant de s'armer, et un compte créé uniquement via une connexion Google ou Apple n'en a jamais défini un. Ajoutez d'abord un identifiant et un mot de passe à ce même compte, puis le contrôle 2FA fonctionnera." },
    { q: "Définir un mot de passe supprime-t-il ma connexion Google ou Apple ?", a: "Non. Ajouter un identifiant et un mot de passe donne à votre compte un second moyen d'accès. Vous pouvez toujours utiliser le bouton Google ou Apple, ou saisir votre nouvel identifiant et mot de passe. Les deux mènent au même compte et aux mêmes fonds." },
    { q: "Comment trouver mon identifiant si je n'ai toujours utilisé que la connexion Google ou Apple ?", a: "Utilisez le lien de récupération d'identifiant sur l'écran de connexion et saisissez l'e-mail lié à votre compte. L'identifiant complet vous est envoyé par e-mail. Pour les comptes à connexion sociale, il s'agit généralement d'une longue chaîne générée automatiquement, que vous pourrez remplacer plus tard par quelque chose de lisible." },
    { q: "Puis-je utiliser une application d'authentification au lieu des codes par e-mail ?", a: "La couche 2FA de base envoie un code de vérification par e-mail lorsque vous vous connectez depuis un nouvel appareil ou navigateur. Une fois cette couche activée, vous pouvez ajouter des méthodes plus robustes dans les paramètres de sécurité, notamment une application d'authentification TOTP, des codes SMS ou une clé de sécurité matérielle." },
    { q: "La plateforme se fige au chargement juste après que j'ai changé mes identifiants. Que faire ?", a: "Un court délai de synchronisation juste après le changement d'identifiants ou l'activation de la 2FA est normal. Laissez-lui un peu de temps, puis déconnectez-vous et reconnectez-vous. Si cela reste bloqué, videz le cache de votre navigateur ou essayez un autre navigateur avant de contacter le support." },
    { q: "Mon compte prop firm fonctionne-t-il de la même manière ?", a: "Pas toujours. Certaines firmes gèrent elles-mêmes les identifiants de connexion des comptes d'évaluation, de sorte que les étapes et les options de sécurité disponibles peuvent différer. Vérifiez les instructions de connexion actuelles de votre firme avant de modifier quoi que ce soit." },
  ], it: [
    { q: "Perché non riesco ad attivare la 2FA se ho effettuato l'accesso con Google o Apple?", a: "L'autenticazione a due fattori la verifica con una password prima di attivarsi, e un conto creato esclusivamente tramite l'accesso con Google o Apple non ne ha mai impostata una. Aggiunga prima una credenziale di nome utente e password a quello stesso conto, quindi il controllo della 2FA funzionerà." },
    { q: "Impostare una password rimuove il mio accesso con Google o Apple?", a: "No. Aggiungere un nome utente e una password dà al suo conto un secondo modo di accedere. Può comunque usare il pulsante Google o Apple, oppure digitare il suo nuovo nome utente e password. Entrambi portano allo stesso conto e agli stessi fondi." },
    { q: "Come trovo il mio nome utente se ho sempre usato solo l'accesso con Google o Apple?", a: "Usi il link di recupero del nome utente nella schermata di accesso e inserisca l'email collegata al suo conto. Il nome utente completo le verrà inviato via email. Per i conti con accesso social è di solito una lunga stringa generata automaticamente, che potrà poi cambiare in qualcosa di più leggibile." },
    { q: "Posso usare un'app di autenticazione al posto dei codici via email?", a: "Il livello base della 2FA invia un codice di verifica via email quando accede da un nuovo dispositivo o browser. Una volta attivo quel livello, può aggiungere metodi più robusti nelle impostazioni di sicurezza, tra cui un'app di autenticazione TOTP, codici SMS o una chiave di sicurezza hardware." },
    { q: "La piattaforma si blocca durante il caricamento subito dopo aver cambiato le credenziali. Cosa faccio?", a: "Un breve ritardo di sincronizzazione subito dopo aver cambiato le credenziali o attivato la 2FA è normale. Le dia un po' di tempo, poi esca e rientri. Se resta ancora bloccata, cancelli la cache del browser o provi un browser diverso prima di contattare l'assistenza." },
    { q: "Il mio conto prop firm funziona allo stesso modo?", a: "Non sempre. Alcune firm gestiscono le credenziali di accesso dei conti di valutazione per suo conto, quindi i passaggi e le opzioni di sicurezza disponibili possono differire. Verifichi le istruzioni di accesso attuali della sua firm prima di modificare qualsiasi cosa." },
  ] },
  relatedHeading: { en: "Related Guides", de: "Verwandte Anleitungen", es: "Guías relacionadas", fr: "Guides associés", it: "Guide correlate" },
  disclosureText: { en: "This guide is for educational and informational purposes only and is not financial, investment, or trading advice. Trading futures and other leveraged products carries a substantial risk of loss and is not suitable for every investor. PickMyTrade is an independent third-party automation platform and is not affiliated with, endorsed by, or sponsored by Tradovate, Inc. or Bookmap. All related names, logos, and trademarks are the property of their respective owners. Platform features and steps change over time, so always confirm the current process in the official platform documentation before acting.", de: "Diese Anleitung dient ausschließlich Bildungs- und Informationszwecken und stellt keine Finanz-, Anlage- oder Handelsberatung dar. Der Handel mit Futures und anderen gehebelten Produkten birgt ein erhebliches Verlustrisiko und ist nicht für jeden Anleger geeignet. PickMyTrade ist eine unabhängige Drittanbieter-Automatisierungsplattform und steht in keiner Verbindung zu Tradovate, Inc. oder Bookmap und wird von diesen weder unterstützt noch gesponsert. Alle zugehörigen Namen, Logos und Marken sind Eigentum ihrer jeweiligen Inhaber. Plattformfunktionen und -schritte ändern sich im Laufe der Zeit, bestätigen Sie daher vor dem Handeln stets den aktuellen Ablauf in der offiziellen Plattformdokumentation.", es: "Esta guía tiene fines exclusivamente educativos e informativos y no constituye asesoramiento financiero, de inversión ni de trading. Operar con futuros y otros productos apalancados conlleva un riesgo sustancial de pérdida y no es adecuado para todos los inversores. PickMyTrade es una plataforma de automatización independiente de terceros y no está afiliada, respaldada ni patrocinada por Tradovate, Inc. ni por Bookmap. Todos los nombres, logotipos y marcas relacionados son propiedad de sus respectivos titulares. Las funciones y los pasos de la plataforma cambian con el tiempo, por lo que siempre debe confirmar el proceso actual en la documentación oficial de la plataforma antes de actuar.", fr: "Ce guide est fourni à des fins éducatives et informatives uniquement et ne constitue pas un conseil financier, d'investissement ou de trading. Le trading de contrats à terme et d'autres produits à effet de levier comporte un risque substantiel de perte et ne convient pas à tous les investisseurs. PickMyTrade est une plateforme d'automatisation tierce indépendante et n'est affiliée à Tradovate, Inc. ou à Bookmap, ni approuvée ni parrainée par elles. Tous les noms, logos et marques associés sont la propriété de leurs détenteurs respectifs. Les fonctionnalités et les étapes de la plateforme évoluent avec le temps ; confirmez donc toujours le processus actuel dans la documentation officielle de la plateforme avant d'agir.", it: "Questa guida ha scopo esclusivamente educativo e informativo e non costituisce consulenza finanziaria, di investimento o di trading. Fare trading su futures e altri prodotti a leva comporta un rischio sostanziale di perdita e non è adatto a tutti gli investitori. PickMyTrade è una piattaforma di automazione indipendente di terze parti e non è affiliata, sostenuta o sponsorizzata da Tradovate, Inc. o Bookmap. Tutti i nomi, i loghi e i marchi correlati sono di proprietà dei rispettivi titolari. Le funzionalità e i passaggi della piattaforma cambiano nel tempo, quindi confermi sempre il processo attuale nella documentazione ufficiale della piattaforma prima di agire." },
};
const data: GuideArticleData = resolveGuideContent(content, locale, related);

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: data.faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: `${SITE_URL}${withSlash(localizedPath(locale))}` },
    { "@type": "ListItem", position: 2, name: "Debugging", item: `${SITE_URL}${withSlash(localizedPath(locale, "debugging"))}` },
    { "@type": "ListItem", position: 3, name: content.h1[locale], item: `${SITE_URL}${withSlash(localizedPath(locale, `debugging/${SLUG}`))}` },
  ],
};

const articleSchema = {
  "@context": "https://schema.org",
