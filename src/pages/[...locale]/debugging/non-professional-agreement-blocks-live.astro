---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "non-professional-agreement-blocks-live";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/debugging/${SLUG}`;

const META_TITLE = "Tradovate Live Orders Blocked: Data Agreement";
const META_DESCRIPTION =
  "Tradovate market data agreement not signed? Enable live data and sign the Non-Professional agreement to unblock live orders and stop rejections.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Tradovate-Live-Orders blockiert: Datenvereinbarung", es: "Órdenes reales de Tradovate bloqueadas: acuerdo de datos", fr: "Ordres réels Tradovate bloqués : accord de données", it: "Ordini live Tradovate bloccati: accordo sui dati" },
  dek: { en: "You funded a live Tradovate account and every order bounces, manual clicks, API calls, TradingView alerts alike. Before you tear apart your strategy, check the boring stuff: an unsigned market data agreement blocks live orders entirely.", de: "Sie haben ein Live-Tradovate-Konto finanziert, und jede Order prallt ab: manuelle Klicks, API-Aufrufe, TradingView-Alerts gleichermaßen. Bevor Sie Ihre Strategie zerlegen, prüfen Sie das Banale: Eine nicht unterzeichnete Marktdatenvereinbarung blockiert Live-Orders vollständig.", es: "Fondeó una cuenta real de Tradovate y todas las órdenes rebotan: clics manuales, llamadas a la API, alertas de TradingView por igual. Antes de desmontar su estrategia, revise lo aburrido: un acuerdo de datos de mercado sin firmar bloquea por completo las órdenes reales.", fr: "Vous avez approvisionné un compte Tradovate réel et chaque ordre rebondit : clics manuels, appels API, alertes TradingView sans distinction. Avant de démonter votre stratégie, vérifiez l'évidence : un accord de données de marché non signé bloque entièrement les ordres réels.", it: "Ha finanziato un conto Tradovate live e ogni ordine rimbalza: clic manuali, chiamate API, alert di TradingView senza distinzione. Prima di smontare la sua strategia, controlli la cosa banale: un accordo sui dati di mercato non firmato blocca completamente gli ordini live." },
  readTime: { en: "7 min read", de: "7 Min. Lesezeit", es: "Lectura de 7 min", fr: "Lecture : 7 min", it: "Lettura di 7 min" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "You funded a live Tradovate account, wired up your automation, fired an order, and nothing goes through. Manual clicks bounce. API calls fail. Your TradingView alerts land as rejections. Before you tear apart your strategy, check the boring stuff, because in 2026 one of the most common reasons a brand-new live or funded Tradovate account can't place a single order has nothing to do with your setup or your balance: the <strong class='text-white'>market data agreement is unsigned</strong>. No signed agreement means no entitlement to real-time data, and no live quote to price your order against." },
    { type: "paragraph", html: "It shows up wearing a few different masks: delayed “orange” symbols, a <strong class='text-white'>“No quote available”</strong> rejection, a <strong class='text-white'>“risk parameters”</strong> rejection, or, on the API side, an error that reads <strong class='text-white'>“Live account is required.”</strong> Every one of them traces back to the same fix. Sign the <strong class='text-white'>Non-Professional Market Data Agreement</strong>, subscribe to live data, and let the entitlement activate before you trade. Below is every cause and its fix, plus how automating with PickMyTrade keeps you from firing orders into an account that isn't data-live yet." },
    {
      type: "checklist",
      heading: "Quick Checklist for Blocked Live Orders",
      items: [
        "<strong class='text-white'>Confirm the data agreement is signed.</strong> On first login to a live account, Tradovate prompts you to sign the CME market data agreement. Skip it and live orders won't route.",
        "<strong class='text-white'>Make sure you chose Non-Professional.</strong> Picking Professional (or leaving it unsigned) changes your entitlement and data billing. Most retail traders qualify as Non-Professional.",
        "<strong class='text-white'>Check the symbol color and data state.</strong> Orange or delayed symbol names and empty bid/ask fields mean the feed isn't live yet, and orders will reject.",
        "<strong class='text-white'>Subscribe to live market data.</strong> A signed agreement plus an active real-time subscription for the exchange (for example, CME) is what lets you price and place orders.",
        "<strong class='text-white'>Wait for activation, then re-login.</strong> Entitlements can take anywhere from about 10 to 90 minutes to switch on. Log out and back in to pick them up.",
        "<strong class='text-white'>Prop and evaluation accounts are different.</strong> On a firm-owned eval account you usually can't self-subscribe. The firm enables data, so contact them if it's still delayed.",
      ],
    },
    { type: "heading", text: "What “Live Account Is Required” and Blocked Live Orders Mean" },
    { type: "paragraph", html: "When you open a live Tradovate brokerage account (or a funded/evaluation account routed through Tradovate), the platform won't stream you real-time exchange data until you've accepted the exchange's market data agreement. That agreement is where you self-certify your <strong class='text-white'>Non-Professional</strong> status. Until it's signed, your account is entitled only to delayed data. Tradovate typically shows a <strong class='text-white'>10-minute delay</strong>, and delayed symbols render with their name in <strong class='text-white'>orange</strong> instead of the normal color." },
    { type: "paragraph", html: "Here's the part that catches automators off guard: <strong class='text-white'>live data isn't just a “nice to have” for charts, it's required to place orders.</strong> Tradovate needs a valid, real-time quote to price and risk-check an order at submit time. With no live entitlement, a market order has no firm quote to fill against, so it bounces as <strong class='text-white'>“No quote available. Please contact support,”</strong> while the entitlement check itself can fail and return a <strong class='text-white'>“risk parameters”</strong> rejection. For API and bot-driven flows it's even more blunt: if your integration tries to add a market-data entitlement subscription before the agreement is signed, Tradovate's API returns an error meaning <strong class='text-white'>“Live account is required,”</strong> its way of telling you the user hasn't completed the market data agreement yet." },
    { type: "heading", text: "Top Causes of Blocked Live Orders in 2026" },
    { type: "heading", text: "1. The market data agreement was never signed" },
    { type: "paragraph", html: "This is the single most common cause on a fresh live or funded account. The <strong class='text-white'>first time</strong> you log into the live platform, Tradovate prompts you to review and sign the CME (and, where relevant, other exchange) market data agreement. Close that prompt, log in from a device that didn't surface it, or assume it's optional, and your account stays on delayed data, which means live orders can't be priced. Tradovate also notes this agreement generally has to be completed from a <strong class='text-white'>computer/web login</strong> the first time, not the mobile app." },
    { type: "heading", text: "2. You signed as Professional instead of Non-Professional" },
    { type: "paragraph", html: "The agreement asks you to certify your data status. Most individual retail traders trading their own money qualify as <strong class='text-white'>Non-Professional</strong>, which carries the lower, retail data entitlement. If you accidentally certified as <strong class='text-white'>Professional</strong>, your entitlement and data billing change, and that mismatch can leave your account without the live feed you expected. The fix isn't self-serve, you generally have to contact Tradovate support to correct the selection." },
    { type: "heading", text: "3. Data hasn't activated yet (or the feed dropped)" },
    { type: "paragraph", html: "Signing and subscribing doesn't flip data on instantly. Activation commonly takes <strong class='text-white'>10 to 90 minutes</strong> depending on demand, and you typically have to <strong class='text-white'>log out and back in</strong> to pick up the new entitlement. Trade inside that window and you'll still see delayed quotes and “no quote available.” Feeds can also drop during very low-volume periods and need a fresh login." },
    { type: "heading", text: "4. No active real-time data subscription" },
    { type: "paragraph", html: "The agreement is one half; an <strong class='text-white'>active subscription</strong> to the exchange's real-time feed is the other. A live Tradovate brokerage account includes free Level 1 CME Group and EUREX real-time data with every plan, but the subscription still has to be switched on alongside a signed agreement. Fees for higher data levels or other exchanges vary, so check Tradovate's current market-data pricing rather than assuming a fixed number." },
    { type: "heading", text: "5. It's a prop / evaluation account controlled by the firm" },
    { type: "paragraph", html: "On funded and evaluation accounts, Tradovate usually doesn't own the account, the <strong class='text-white'>prop firm</strong> does. That means the firm, not you, enables or fixes the market data feed, and you often <strong class='text-white'>can't</strong> self-subscribe from inside Tradovate. If you're on an Apex, Topstep, FundedNext, or similar account and data is delayed, the agreement and subscription are handled on the firm's side, so the fix routes through them." },
    { type: "heading", text: "How to Fix Blocked Live Orders: Step-by-Step" },
    { type: "heading", text: "Fixing an unsigned or mis-signed agreement" },
    { type: "paragraph", html: "<ol><li>Log into the Tradovate <strong class='text-white'>web trader from a computer</strong> (not the mobile app for the first-time signing).</li><li>Open the <strong class='text-white'>Account / Settings</strong> menu and find the <strong class='text-white'>market data / agreements</strong> section. Confirm the <strong class='text-white'>Non-Professional Market Data Agreement</strong> shows as signed. Menu wording changes between builds, so look for the market data agreement label on your current version.</li><li>If it's unsigned, complete and accept it, selecting <strong class='text-white'>Non-Professional</strong> status (assuming you qualify as a retail, self-directed trader).</li><li>If it shows <strong class='text-white'>Professional</strong> and that's wrong, don't try to toggle it yourself. <strong class='text-white'>Contact Tradovate support</strong> to correct the certification, since the wrong status affects both entitlement and billing.</li></ol>" },
    { type: "heading", text: "Turning on live market data and letting it activate" },
    { type: "paragraph", html: "<ol><li>Open <strong class='text-white'>Application Settings</strong> in the web trader and go to the <strong class='text-white'>Subscriptions / Market Data</strong> area.</li><li><strong class='text-white'>Subscribe</strong> to the real-time feed for the exchange you trade (for example, the CME bundle for ES, NQ, MES, and MNQ). A funded live account includes free Level 1 CME/EUREX data, but the subscription still has to be switched on.</li><li><strong class='text-white'>Wait for activation, about 10 to 90 minutes, then log out and back in.</strong> Live symbols should display in their normal color with a moving bid/ask instead of orange, delayed quotes.</li><li>Do <strong class='text-white'>not</strong> place orders until you've confirmed the feed is live. Trading against delayed or missing quotes is how traders get surprise fills and rejections.</li></ol>" },
    { type: "heading", text: "Fixing it for API and automated trading" },
    { type: "paragraph", html: "<ol><li>Make sure the <strong class='text-white'>human account holder has signed the agreement first</strong>, the API can't bypass it. If your code calls the entitlement-subscription endpoint before the agreement is accepted, Tradovate returns the <strong class='text-white'>“Live account is required”</strong> error, which specifically means the market data agreement isn't signed yet.</li><li>Once the agreement is signed and data has activated, re-authenticate your API session so it inherits the new entitlement, and confirm you're hitting the correct <strong class='text-white'>live</strong> host (not the demo endpoint).</li><li>Keep your automation from firing during the activation window. Queue or pause orders until a live quote is confirmed.</li></ol>" },
    { type: "heading", text: "Fixing it on a prop / evaluation account" },
    { type: "paragraph", html: "Sign any agreement the firm asks you to during onboarding, the Non-Professional certification still applies. If symbols are still delayed after signing and a re-login, <strong class='text-white'>contact the prop firm's support, not Tradovate</strong>. Only the firm can enable or repair data on an account it owns. Give activation the full window (up to about 90 minutes) before you escalate." },
    { type: "heading", text: "Troubleshooting Table" },
    {
      type: "table",
      headers: ["Error / symptom", "Meaning", "Fix"],
      rows: [
        ["No quote available. Please contact support.", "No live real-time quote to price the order at submit time", "Sign the Non-Professional agreement, subscribe to live data, re-login, and confirm a live bid/ask before ordering"],
        ["Risk parameters", "The order failed an account entitlement / risk check (data not live counts)", "Confirm the data agreement and subscription are active; also check your Risk Settings limits"],
        ["Live account is required (API)", "An entitlement subscription was requested before the market data agreement was signed", "Have the account holder sign the agreement first, then re-auth the API session"],
        ["Orange / delayed symbol names, empty quotes", "Account is on delayed data, not live", "Sign the agreement, subscribe, wait ~10–90 min, then log out and back in"],
        ["Signed as Professional by mistake", "Wrong data certification changes entitlement and billing", "Contact Tradovate support to correct the status to Non-Professional"],
        ["Prop/eval account still delayed after signing", "Data is controlled by the firm, not self-subscribable", "Contact the prop firm's support to enable the feed"],
      ],
    },
    { type: "heading", text: "Prevent This with PickMyTrade" },
    { type: "paragraph", html: "PickMyTrade links your TradingView alerts straight to Tradovate and adds guardrails so you're not firing orders into an account that isn't data-live yet:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Entitlement &amp; data-aware routing</strong>, designed to route orders through an account that's set up for live trading, cutting down on “no quote available” surprises from an unprovisioned feed.",
        "<strong class='text-white'>Symbol &amp; quantity validation</strong>, checks the contract and size before the order is sent, so bad symbols and oversized quantities get caught early instead of bouncing back.",
        "<strong class='text-white'>Risk &amp; agreement awareness</strong>, helps you keep alert flow aligned with your account's live-trading and prop-firm state, so entitlement-driven “risk parameters” rejections are less likely.",
        "<strong class='text-white'>Multi-account sync</strong>, mirrors a corrected, validated order across all connected accounts instead of firing rejects everywhere at once.",
      ],
    },
    { type: "paragraph", html: "The payoff: fewer stalled entries, fewer mystery rejections on day one of a new live account, and cleaner logs when you do need to debug." },
  ], de: [
    { type: "paragraph",html: "Sie haben ein Live-Tradovate-Konto finanziert, Ihre Automatisierung verbunden, eine Order ausgelöst, und nichts geht durch. Manuelle Klicks prallen ab. API-Aufrufe schlagen fehl. Ihre TradingView-Alerts landen als Ablehnungen. Bevor Sie Ihre Strategie auseinandernehmen, prüfen Sie das Banale, denn im Jahr 2026 hat einer der häufigsten Gründe, warum ein brandneues Live- oder Funded-Tradovate-Konto keine einzige Order platzieren kann, nichts mit Ihrem Setup oder Ihrem Kontostand zu tun: Die <strong class='text-white'>Marktdatenvereinbarung ist nicht unterzeichnet</strong>. Keine unterzeichnete Vereinbarung bedeutet keine Berechtigung für Echtzeitdaten und keinen Live-Kurs, an dem Ihre Order bepreist werden kann." },
    { type: "paragraph",html: "Es zeigt sich in verschiedenen Masken: verzögerte „orange“ Symbole, eine Ablehnung mit <strong class='text-white'>“No quote available”</strong>, eine Ablehnung mit <strong class='text-white'>“risk parameters”</strong> oder auf der API-Seite ein Fehler mit dem Text <strong class='text-white'>“Live account is required.”</strong> Jeder davon führt auf dieselbe Lösung zurück. Unterzeichnen Sie die <strong class='text-white'>Non-Professional Market Data Agreement</strong>, abonnieren Sie Live-Daten und lassen Sie die Berechtigung aktivieren, bevor Sie handeln. Unten finden Sie jede Ursache mit ihrer Lösung und erfahren, wie die Automatisierung mit PickMyTrade verhindert, dass Sie Orders in ein Konto feuern, das noch nicht datenlive ist." },
    {
      type: "checklist",
      heading: "Kurze Checkliste bei blockierten Live-Orders",
      items: [
        "<strong class='text-white'>Bestätigen Sie, dass die Datenvereinbarung unterzeichnet ist.</strong> Beim ersten Login in ein Live-Konto fordert Tradovate Sie auf, die CME-Marktdatenvereinbarung zu unterzeichnen. Überspringen Sie das, werden Live-Orders nicht geroutet.",
        "<strong class='text-white'>Stellen Sie sicher, dass Sie Non-Professional gewählt haben.</strong> Professional zu wählen (oder nicht zu unterzeichnen) ändert Ihre Berechtigung und Datenabrechnung. Die meisten Privathändler qualifizieren sich als Non-Professional.",
        "<strong class='text-white'>Prüfen Sie Symbolfarbe und Datenstatus.</strong> Orange oder verzögerte Symbolnamen und leere Bid/Ask-Felder bedeuten, dass der Feed noch nicht live ist, und Orders werden abgelehnt.",
        "<strong class='text-white'>Abonnieren Sie Live-Marktdaten.</strong> Eine unterzeichnete Vereinbarung plus ein aktives Echtzeit-Abonnement für die Börse (zum Beispiel CME) ermöglicht es Ihnen, Orders zu bepreisen und zu platzieren.",
        "<strong class='text-white'>Warten Sie die Aktivierung ab und melden Sie sich neu an.</strong> Berechtigungen können etwa 10 bis 90 Minuten brauchen, bis sie aktiv sind. Melden Sie sich ab und wieder an, damit sie greifen.",
        "<strong class='text-white'>Prop- und Evaluierungskonten sind anders.</strong> Bei einem firmeneigenen Evaluierungskonto können Sie in der Regel nicht selbst abonnieren. Die Firma aktiviert die Daten, wenden Sie sich also an sie, wenn sie weiterhin verzögert sind.",
      ],
    },
    { type: "heading",text: "Was „Live Account Is Required“ und blockierte Live-Orders bedeuten" },
    { type: "paragraph",html: "Wenn Sie ein Live-Tradovate-Brokerkonto (oder ein über Tradovate geroutetes Funded-/Evaluierungskonto) eröffnen, streamt die Plattform keine Echtzeit-Börsendaten, bis Sie die Marktdatenvereinbarung der Börse akzeptiert haben. In dieser Vereinbarung bescheinigen Sie selbst Ihren <strong class='text-white'>Non-Professional</strong>-Status. Bis sie unterzeichnet ist, berechtigt Ihr Konto nur zu verzögerten Daten. Tradovate zeigt typischerweise eine <strong class='text-white'>Verzögerung von 10 Minuten</strong>, und verzögerte Symbole werden mit ihrem Namen in <strong class='text-white'>Orange</strong> statt in der normalen Farbe dargestellt." },
    { type: "paragraph",html: "Hier ist der Teil, der Automatisierer kalt erwischt: <strong class='text-white'>Live-Daten sind nicht nur ein „Nice-to-have“ für Charts, sie sind zum Platzieren von Orders erforderlich.</strong> Tradovate benötigt zum Zeitpunkt der Übermittlung einen gültigen Echtzeit-Kurs, um eine Order zu bepreisen und das Risiko zu prüfen. Ohne Live-Berechtigung hat eine Market-Order keinen festen Kurs für den Fill und prallt als <strong class='text-white'>“No quote available. Please contact support”</strong> ab, während die Berechtigungsprüfung selbst fehlschlagen und eine Ablehnung mit <strong class='text-white'>“risk parameters”</strong> zurückgeben kann. Bei API- und bot-gesteuerten Abläufen ist es noch deutlicher: Versucht Ihre Integration, ein Marktdaten-Berechtigungsabonnement hinzuzufügen, bevor die Vereinbarung unterzeichnet ist, gibt die Tradovate-API einen Fehler zurück, der <strong class='text-white'>“Live account is required”</strong> bedeutet, also die Art, Ihnen mitzuteilen, dass der Nutzer die Marktdatenvereinbarung noch nicht abgeschlossen hat." },
    { type: "heading",text: "Häufigste Ursachen blockierter Live-Orders im Jahr 2026" },
    { type: "heading",text: "1. Die Marktdatenvereinbarung wurde nie unterzeichnet" },
    { type: "paragraph",html: "Das ist die häufigste Einzelursache bei einem frischen Live- oder Funded-Konto. Beim <strong class='text-white'>ersten Mal</strong>, wenn Sie sich in die Live-Plattform einloggen, fordert Tradovate Sie auf, die Marktdatenvereinbarung der CME (und gegebenenfalls anderer Börsen) zu prüfen und zu unterzeichnen. Schließen Sie diese Aufforderung, loggen Sie sich von einem Gerät ein, das sie nicht angezeigt hat, oder gehen Sie davon aus, dass sie optional ist, bleibt Ihr Konto bei verzögerten Daten, wodurch Live-Orders nicht bepreist werden können. Tradovate weist außerdem darauf hin, dass diese Vereinbarung beim ersten Mal in der Regel über einen <strong class='text-white'>Computer-/Web-Login</strong> abgeschlossen werden muss, nicht in der mobilen App." },
    { type: "heading",text: "2. Sie haben als Professional statt als Non-Professional unterzeichnet" },
    { type: "paragraph",html: "Die Vereinbarung verlangt von Ihnen die Angabe Ihres Datenstatus. Die meisten Privatanleger, die mit eigenem Geld handeln, qualifizieren sich als <strong class='text-white'>Non-Professional</strong>, was die günstigere Privatkunden-Datenberechtigung mit sich bringt. Wenn Sie versehentlich als <strong class='text-white'>Professional</strong> zertifiziert haben, ändern sich Ihre Berechtigung und Datenabrechnung, und diese Abweichung kann dazu führen, dass Ihr Konto den erwarteten Live-Feed nicht erhält. Die Lösung ist keine Selbstbedienung, in der Regel müssen Sie den Tradovate-Support kontaktieren, um die Auswahl zu korrigieren." },
    { type: "heading",text: "3. Die Daten sind noch nicht aktiv (oder der Feed ist abgerissen)" },
    { type: "paragraph",html: "Unterzeichnen und Abonnieren schaltet die Daten nicht sofort frei. Die Aktivierung dauert je nach Auslastung üblicherweise <strong class='text-white'>10 bis 90 Minuten</strong>, und typischerweise müssen Sie sich <strong class='text-white'>ab- und wieder anmelden</strong>, damit die neue Berechtigung greift. Handeln Sie in diesem Zeitfenster, sehen Sie weiterhin verzögerte Kurse und „no quote available“. Feeds können auch in sehr umsatzarmen Phasen abreißen und brauchen einen frischen Login." },
    { type: "heading",text: "4. Kein aktives Echtzeitdaten-Abonnement" },
    { type: "paragraph",html: "Die Vereinbarung ist die eine Hälfte, ein <strong class='text-white'>aktives Abonnement</strong> des Echtzeit-Feeds der Börse die andere. Ein Live-Tradovate-Brokerkonto enthält bei jedem Tarif kostenlose Level-1-Echtzeitdaten von CME Group und EUREX, doch das Abonnement muss trotzdem zusammen mit einer unterzeichneten Vereinbarung eingeschaltet sein. Gebühren für höhere Datenstufen oder andere Börsen variieren, prüfen Sie daher die aktuellen Marktdaten-Preise von Tradovate, statt von einer festen Zahl auszugehen." },
    { type: "heading",text: "5. Es ist ein Prop-/Evaluierungskonto, das die Firma kontrolliert" },
    { type: "paragraph",html: "Bei Funded- und Evaluierungskonten gehört das Konto meist nicht Tradovate, sondern der <strong class='text-white'>Prop-Firma</strong>. Das heißt, die Firma, nicht Sie, aktiviert oder repariert den Marktdatenfeed, und Sie können innerhalb von Tradovate oft <strong class='text-white'>nicht</strong> selbst abonnieren. Wenn Sie ein Apex-, Topstep-, FundedNext- oder ähnliches Konto haben und die Daten verzögert sind, werden Vereinbarung und Abonnement auf Seiten der Firma erledigt, die Lösung läuft also über sie." },
    { type: "heading",text: "So beheben Sie blockierte Live-Orders: Schritt für Schritt" },
    { type: "heading",text: "Eine nicht oder falsch unterzeichnete Vereinbarung beheben" },
    { type: "paragraph",html: "<ol><li>Melden Sie sich im Tradovate-<strong class='text-white'>Web-Trader von einem Computer</strong> aus an (nicht in der mobilen App für die erstmalige Unterzeichnung).</li><li>Öffnen Sie das Menü <strong class='text-white'>Account / Settings</strong> und suchen Sie den Bereich <strong class='text-white'>market data / agreements</strong>. Bestätigen Sie, dass die <strong class='text-white'>Non-Professional Market Data Agreement</strong> als unterzeichnet angezeigt wird. Die Menübezeichnungen ändern sich zwischen Versionen, suchen Sie daher in Ihrer aktuellen Version nach der Bezeichnung der Marktdatenvereinbarung.</li><li>Ist sie nicht unterzeichnet, füllen Sie sie aus und akzeptieren Sie sie, wobei Sie den Status <strong class='text-white'>Non-Professional</strong> wählen (sofern Sie sich als selbstständiger Privathändler qualifizieren).</li><li>Wenn dort <strong class='text-white'>Professional</strong> steht und das falsch ist, versuchen Sie nicht, es selbst umzuschalten. <strong class='text-white'>Kontaktieren Sie den Tradovate-Support</strong>, um die Zertifizierung zu korrigieren, da der falsche Status sowohl Berechtigung als auch Abrechnung beeinflusst.</li></ol>" },
    { type: "heading",text: "Live-Marktdaten einschalten und aktivieren lassen" },
    { type: "paragraph",html: "<ol><li>Öffnen Sie im Web-Trader die <strong class='text-white'>Application Settings</strong> und gehen Sie zum Bereich <strong class='text-white'>Subscriptions / Market Data</strong>.</li><li><strong class='text-white'>Abonnieren</strong> Sie den Echtzeit-Feed für die Börse, an der Sie handeln (zum Beispiel das CME-Bundle für ES, NQ, MES und MNQ). Ein finanziertes Live-Konto enthält kostenlose Level-1-Daten von CME/EUREX, aber das Abonnement muss trotzdem eingeschaltet werden.</li><li><strong class='text-white'>Warten Sie auf die Aktivierung, etwa 10 bis 90 Minuten, und melden Sie sich dann ab und wieder an.</strong> Live-Symbole sollten in der normalen Farbe mit sich bewegendem Bid/Ask erscheinen statt in orangefarbenen, verzögerten Kursen.</li><li>Platzieren Sie <strong class='text-white'>keine</strong> Orders, bevor Sie bestätigt haben, dass der Feed live ist. Gegen verzögerte oder fehlende Kurse zu handeln ist der Weg zu überraschenden Fills und Ablehnungen.</li></ol>" },
    { type: "heading",text: "Für API und automatisierten Handel beheben" },
    { type: "paragraph",html: "<ol><li>Stellen Sie sicher, dass der <strong class='text-white'>menschliche Kontoinhaber die Vereinbarung zuerst unterzeichnet hat</strong>, die API kann sie nicht umgehen. Ruft Ihr Code den Endpunkt für das Berechtigungsabonnement auf, bevor die Vereinbarung akzeptiert ist, gibt Tradovate den Fehler <strong class='text-white'>“Live account is required”</strong> zurück, der konkret bedeutet, dass die Marktdatenvereinbarung noch nicht unterzeichnet ist.</li><li>Sobald die Vereinbarung unterzeichnet und die Daten aktiv sind, authentifizieren Sie Ihre API-Sitzung neu, damit sie die neue Berechtigung übernimmt, und bestätigen Sie, dass Sie den richtigen <strong class='text-white'>Live</strong>-Host (nicht den Demo-Endpunkt) ansprechen.</li><li>Verhindern Sie, dass Ihre Automatisierung während des Aktivierungsfensters feuert. Stellen Sie Orders in eine Warteschlange oder pausieren Sie sie, bis ein Live-Kurs bestätigt ist.</li></ol>" },
    { type: "heading",text: "Auf einem Prop-/Evaluierungskonto beheben" },
    { type: "paragraph",html: "Unterzeichnen Sie jede Vereinbarung, die die Firma beim Onboarding von Ihnen verlangt, die Non-Professional-Zertifizierung gilt weiterhin. Sind die Symbole nach dem Unterzeichnen und einem erneuten Login immer noch verzögert, <strong class='text-white'>kontaktieren Sie den Support der Prop-Firma, nicht Tradovate</strong>. Nur die Firma kann Daten auf einem ihr gehörenden Konto aktivieren oder reparieren. Geben Sie der Aktivierung das volle Zeitfenster (bis zu etwa 90 Minuten), bevor Sie eskalieren." },
    { type: "heading",text: "Fehlerbehebungstabelle" },
    { type: "table", headers: ["Fehler / Symptom","Bedeutung","Lösung"], rows: [
      ["Meldung „No quote available. Please contact support.“","Kein Echtzeit-Live-Kurs, um die Order zum Zeitpunkt der Übermittlung zu bepreisen","Non-Professional-Vereinbarung unterzeichnen, Live-Daten abonnieren, neu anmelden und vor dem Ordern ein Live-Bid/Ask bestätigen"],
      ["Ablehnung „Risk parameters“","Die Order hat eine Prüfung der Kontoberechtigung / des Risikos nicht bestanden (nicht live geschaltete Daten zählen dazu)","Bestätigen, dass Datenvereinbarung und Abonnement aktiv sind; prüfen Sie außerdem Ihre Limits in den Risk Settings"],
      ["API-Fehler „Live account is required“","Ein Berechtigungsabonnement wurde angefordert, bevor die Marktdatenvereinbarung unterzeichnet war","Den Kontoinhaber die Vereinbarung zuerst unterzeichnen lassen, dann die API-Sitzung neu authentifizieren"],
      ["Orange / verzögerte Symbolnamen, leere Kurse","Das Konto hat verzögerte Daten, keine Live-Daten","Vereinbarung unterzeichnen, abonnieren, etwa 10–90 Min. warten, dann ab- und wieder anmelden"],
      ["Versehentlich als Professional unterzeichnet","Die falsche Datenzertifizierung ändert Berechtigung und Abrechnung","Tradovate-Support kontaktieren, um den Status auf Non-Professional zu korrigieren"],
      ["Prop-/Evaluierungskonto nach dem Unterzeichnen weiterhin verzögert","Die Daten werden von der Firma kontrolliert und sind nicht selbst abonnierbar","Den Support der Prop-Firma kontaktieren, um den Feed zu aktivieren"],
    ] },
    { type: "heading",text: "Mit PickMyTrade vorbeugen" },
    { type: "paragraph",html: "PickMyTrade verbindet Ihre TradingView-Alerts direkt mit Tradovate und ergänzt Leitplanken, damit Sie keine Orders in ein Konto feuern, das noch nicht datenlive ist:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Berechtigungs- &amp; datenbewusstes Routing</strong>, konzipiert, Orders über ein Konto zu routen, das für den Live-Handel eingerichtet ist, und so „no quote available“-Überraschungen durch einen nicht bereitgestellten Feed zu verringern.",
        "<strong class='text-white'>Symbol- &amp; Mengenvalidierung</strong>, prüft Kontrakt und Größe vor dem Senden der Order, sodass fehlerhafte Symbole und überdimensionierte Mengen früh abgefangen werden, statt zurückzuprallen.",
        "<strong class='text-white'>Risiko- &amp; Vereinbarungsbewusstsein</strong>, hilft Ihnen, den Alert-Fluss an den Live-Handels- und Prop-Firm-Status Ihres Kontos anzupassen, sodass berechtigungsbedingte „risk parameters“-Ablehnungen unwahrscheinlicher werden.",
        "<strong class='text-white'>Multi-Account-Sync</strong>, spiegelt eine korrigierte, validierte Order auf alle verbundenen Konten, statt überall gleichzeitig Ablehnungen zu feuern.",
      ],
    },
    { type: "paragraph",html: "Der Gewinn: weniger ins Stocken geratene Einstiege, weniger rätselhafte Ablehnungen am ersten Tag eines neuen Live-Kontos und sauberere Logs, wenn Sie doch einmal debuggen müssen." },
  ], es: [
    { type: "paragraph",html: "Fondeó una cuenta real de Tradovate, conectó su automatización, lanzó una orden y no pasa nada. Los clics manuales rebotan. Las llamadas a la API fallan. Sus alertas de TradingView llegan como rechazos. Antes de desmontar su estrategia, revise lo aburrido, porque en 2026 una de las razones más comunes por las que una cuenta real o fondeada de Tradovate recién creada no puede colocar ni una sola orden no tiene nada que ver con su configuración ni con su saldo: el <strong class='text-white'>acuerdo de datos de mercado no está firmado</strong>. Sin acuerdo firmado no hay derecho a datos en tiempo real ni cotización en vivo con la que valorar su orden." },
    { type: "paragraph",html: "Se presenta con varias máscaras: símbolos “naranjas” retrasados, un rechazo <strong class='text-white'>“No quote available”</strong>, un rechazo <strong class='text-white'>“risk parameters”</strong> o, en el lado de la API, un error que dice <strong class='text-white'>“Live account is required.”</strong> Todos remiten a la misma solución. Firme el <strong class='text-white'>Non-Professional Market Data Agreement</strong>, suscríbase a datos en vivo y deje que el derecho se active antes de operar. A continuación encontrará cada causa y su solución, además de cómo automatizar con PickMyTrade evita que dispare órdenes contra una cuenta que aún no tiene datos en vivo." },
    {
      type: "checklist",
      heading: "Lista rápida para órdenes reales bloqueadas",
      items: [
        "<strong class='text-white'>Confirme que el acuerdo de datos está firmado.</strong> En el primer inicio de sesión en una cuenta real, Tradovate le pide firmar el acuerdo de datos de mercado del CME. Si lo omite, las órdenes reales no se enrutan.",
        "<strong class='text-white'>Asegúrese de haber elegido Non-Professional.</strong> Elegir Professional (o dejarlo sin firmar) cambia su derecho y la facturación de datos. La mayoría de los operadores minoristas califican como Non-Professional.",
        "<strong class='text-white'>Compruebe el color del símbolo y el estado de los datos.</strong> Nombres de símbolo naranjas o retrasados y campos bid/ask vacíos significan que el feed aún no está activo y las órdenes se rechazarán.",
        "<strong class='text-white'>Suscríbase a datos de mercado en vivo.</strong> Un acuerdo firmado más una suscripción activa en tiempo real a la bolsa (por ejemplo, CME) es lo que le permite valorar y colocar órdenes.",
        "<strong class='text-white'>Espere la activación y vuelva a iniciar sesión.</strong> Los derechos pueden tardar entre unos 10 y 90 minutos en activarse. Cierre sesión y vuelva a entrar para que se apliquen.",
        "<strong class='text-white'>Las cuentas prop y de evaluación son distintas.</strong> En una cuenta de evaluación propiedad de la firma normalmente no puede suscribirse por su cuenta. La firma habilita los datos, así que contáctela si siguen retrasados.",
      ],
    },
    { type: "heading",text: "Qué significan “Live Account Is Required” y las órdenes reales bloqueadas" },
    { type: "paragraph",html: "Cuando abre una cuenta de corretaje real de Tradovate (o una cuenta fondeada/de evaluación enrutada a través de Tradovate), la plataforma no le transmite datos en tiempo real de la bolsa hasta que haya aceptado el acuerdo de datos de mercado de la bolsa. En ese acuerdo usted certifica por sí mismo su condición de <strong class='text-white'>Non-Professional</strong>. Hasta que se firma, su cuenta solo tiene derecho a datos retrasados. Tradovate suele mostrar un <strong class='text-white'>retraso de 10 minutos</strong>, y los símbolos retrasados se muestran con su nombre en <strong class='text-white'>naranja</strong> en lugar del color normal." },
    { type: "paragraph",html: "Esta es la parte que pilla desprevenidos a quienes automatizan: <strong class='text-white'>los datos en vivo no son solo algo “agradable de tener” para los gráficos, son necesarios para colocar órdenes.</strong> Tradovate necesita una cotización válida en tiempo real para valorar y comprobar el riesgo de una orden en el momento del envío. Sin derecho en vivo, una orden de mercado no tiene una cotización firme contra la que ejecutarse, por lo que rebota como <strong class='text-white'>“No quote available. Please contact support,”</strong> mientras que la propia comprobación de derechos puede fallar y devolver un rechazo <strong class='text-white'>“risk parameters”</strong>. Para los flujos de API y de bots es aún más directo: si su integración intenta añadir una suscripción de derecho de datos de mercado antes de que se firme el acuerdo, la API de Tradovate devuelve un error que significa <strong class='text-white'>“Live account is required,”</strong> su forma de decirle que el usuario aún no ha completado el acuerdo de datos de mercado." },
    { type: "heading",text: "Principales causas de órdenes reales bloqueadas en 2026" },
    { type: "heading",text: "1. El acuerdo de datos de mercado nunca se firmó" },
    { type: "paragraph",html: "Esta es la causa más común en una cuenta real o fondeada nueva. La <strong class='text-white'>primera vez</strong> que inicia sesión en la plataforma real, Tradovate le pide revisar y firmar el acuerdo de datos de mercado del CME (y, cuando proceda, de otras bolsas). Si cierra ese aviso, inicia sesión desde un dispositivo que no lo mostró o supone que es opcional, su cuenta se queda con datos retrasados, lo que significa que las órdenes reales no se pueden valorar. Tradovate también señala que este acuerdo generalmente debe completarse la primera vez desde un <strong class='text-white'>inicio de sesión en ordenador/web</strong>, no desde la aplicación móvil." },
    { type: "heading",text: "2. Firmó como Professional en lugar de Non-Professional" },
    { type: "paragraph",html: "El acuerdo le pide certificar su condición de datos. La mayoría de los operadores minoristas que operan con su propio dinero califican como <strong class='text-white'>Non-Professional</strong>, que conlleva el derecho de datos minorista, más económico. Si certificó por error como <strong class='text-white'>Professional</strong>, su derecho y la facturación de datos cambian, y ese desajuste puede dejar su cuenta sin el feed en vivo que esperaba. La solución no es de autoservicio: normalmente debe contactar con el soporte de Tradovate para corregir la selección." },
    { type: "heading",text: "3. Los datos aún no se han activado (o el feed se cayó)" },
    { type: "paragraph",html: "Firmar y suscribirse no activa los datos al instante. La activación suele tardar <strong class='text-white'>de 10 a 90 minutos</strong> según la demanda, y normalmente tiene que <strong class='text-white'>cerrar sesión y volver a iniciarla</strong> para que se aplique el nuevo derecho. Si opera dentro de esa ventana, seguirá viendo cotizaciones retrasadas y “no quote available”. Los feeds también pueden caerse en periodos de muy bajo volumen y necesitar un nuevo inicio de sesión." },
    { type: "heading",text: "4. Sin suscripción activa a datos en tiempo real" },
    { type: "paragraph",html: "El acuerdo es una mitad; una <strong class='text-white'>suscripción activa</strong> al feed en tiempo real de la bolsa es la otra. Una cuenta de corretaje real de Tradovate incluye datos en tiempo real de Nivel 1 de CME Group y EUREX gratuitos con cada plan, pero la suscripción aún debe estar activada junto con un acuerdo firmado. Las tarifas de niveles de datos superiores u otras bolsas varían, así que consulte los precios vigentes de datos de mercado de Tradovate en lugar de suponer una cifra fija." },
    { type: "heading",text: "5. Es una cuenta prop / de evaluación controlada por la firma" },
    { type: "paragraph",html: "En cuentas fondeadas y de evaluación, Tradovate normalmente no es el dueño de la cuenta, lo es la <strong class='text-white'>prop firm</strong>. Eso significa que la firma, no usted, habilita o repara el feed de datos de mercado, y a menudo <strong class='text-white'>no</strong> puede suscribirse por su cuenta desde Tradovate. Si tiene una cuenta de Apex, Topstep, FundedNext o similar y los datos están retrasados, el acuerdo y la suscripción se gestionan por parte de la firma, así que la solución pasa por ella." },
    { type: "heading",text: "Cómo solucionar las órdenes reales bloqueadas: paso a paso" },
    { type: "heading",text: "Solucionar un acuerdo sin firmar o mal firmado" },
    { type: "paragraph",html: "<ol><li>Inicie sesión en el <strong class='text-white'>web trader de Tradovate desde un ordenador</strong> (no en la aplicación móvil para la primera firma).</li><li>Abra el menú <strong class='text-white'>Account / Settings</strong> y busque la sección <strong class='text-white'>market data / agreements</strong>. Confirme que el <strong class='text-white'>Non-Professional Market Data Agreement</strong> figura como firmado. La redacción de los menús cambia entre versiones, así que busque la etiqueta del acuerdo de datos de mercado en su versión actual.</li><li>Si no está firmado, complételo y acéptelo, seleccionando el estado <strong class='text-white'>Non-Professional</strong> (suponiendo que califique como operador minorista y autónomo).</li><li>Si figura <strong class='text-white'>Professional</strong> y eso es incorrecto, no intente cambiarlo usted mismo. <strong class='text-white'>Contacte con el soporte de Tradovate</strong> para corregir la certificación, ya que un estado erróneo afecta tanto al derecho como a la facturación.</li></ol>" },
    { type: "heading",text: "Activar los datos de mercado en vivo y dejar que se activen" },
    { type: "paragraph",html: "<ol><li>Abra <strong class='text-white'>Application Settings</strong> en el web trader y vaya al área <strong class='text-white'>Subscriptions / Market Data</strong>.</li><li><strong class='text-white'>Suscríbase</strong> al feed en tiempo real de la bolsa en la que opera (por ejemplo, el paquete CME para ES, NQ, MES y MNQ). Una cuenta real fondeada incluye datos de Nivel 1 de CME/EUREX gratuitos, pero la suscripción aún debe activarse.</li><li><strong class='text-white'>Espere la activación, de unos 10 a 90 minutos, y luego cierre sesión y vuelva a iniciarla.</strong> Los símbolos en vivo deberían mostrarse en su color normal con un bid/ask en movimiento en lugar de cotizaciones naranjas retrasadas.</li><li><strong class='text-white'>No</strong> coloque órdenes hasta confirmar que el feed está activo. Operar contra cotizaciones retrasadas o ausentes es la forma de llevarse ejecuciones y rechazos inesperados.</li></ol>" },
    { type: "heading",text: "Solucionarlo para la API y el trading automatizado" },
    { type: "paragraph",html: "<ol><li>Asegúrese de que el <strong class='text-white'>titular humano de la cuenta haya firmado primero el acuerdo</strong>; la API no puede saltárselo. Si su código llama al endpoint de suscripción de derechos antes de aceptar el acuerdo, Tradovate devuelve el error <strong class='text-white'>“Live account is required”</strong>, que significa específicamente que el acuerdo de datos de mercado aún no está firmado.</li><li>Una vez firmado el acuerdo y activados los datos, vuelva a autenticar su sesión de API para que herede el nuevo derecho y confirme que apunta al host <strong class='text-white'>real</strong> correcto (no al endpoint demo).</li><li>Evite que su automatización dispare durante la ventana de activación. Ponga las órdenes en cola o en pausa hasta confirmar una cotización en vivo.</li></ol>" },
    { type: "heading",text: "Solucionarlo en una cuenta prop / de evaluación" },
    { type: "paragraph",html: "Firme cualquier acuerdo que la firma le pida durante la incorporación; la certificación Non-Professional sigue aplicándose. Si los símbolos siguen retrasados tras firmar y volver a iniciar sesión, <strong class='text-white'>contacte con el soporte de la prop firm, no con Tradovate</strong>. Solo la firma puede habilitar o reparar los datos de una cuenta de su propiedad. Dé a la activación toda la ventana (hasta unos 90 minutos) antes de escalar." },
    { type: "heading",text: "Tabla de solución de problemas" },
    { type: "table", headers: ["Error / síntoma","Significado","Solución"], rows: [
      ["Mensaje “No quote available. Please contact support.”","No hay cotización en tiempo real en vivo para valorar la orden en el momento del envío","Firme el acuerdo Non-Professional, suscríbase a datos en vivo, vuelva a iniciar sesión y confirme un bid/ask en vivo antes de ordenar"],
      ["Rechazo “Risk parameters”","La orden no superó una comprobación de derechos de la cuenta / riesgo (los datos no activos cuentan)","Confirme que el acuerdo de datos y la suscripción están activos; revise también los límites de sus Risk Settings"],
      ["Error de API “Live account is required”","Se solicitó una suscripción de derechos antes de firmar el acuerdo de datos de mercado","Que el titular de la cuenta firme primero el acuerdo y luego vuelva a autenticar la sesión de API"],
      ["Nombres de símbolo naranjas / retrasados, cotizaciones vacías","La cuenta tiene datos retrasados, no en vivo","Firme el acuerdo, suscríbase, espere unos 10–90 min y luego cierre sesión y vuelva a iniciarla"],
      ["Firmado como Professional por error","La certificación de datos incorrecta cambia el derecho y la facturación","Contacte con el soporte de Tradovate para corregir el estado a Non-Professional"],
      ["Cuenta prop/de evaluación aún retrasada tras firmar","Los datos los controla la firma y no se pueden contratar por cuenta propia","Contacte con el soporte de la prop firm para que active el feed"],
    ] },
    { type: "heading",text: "Evítelo con PickMyTrade" },
    { type: "paragraph",html: "PickMyTrade conecta sus alertas de TradingView directamente con Tradovate y añade salvaguardas para que no dispare órdenes contra una cuenta que aún no tiene datos en vivo:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Enrutamiento consciente de derechos &amp; datos</strong>, diseñado para enrutar órdenes a través de una cuenta configurada para operar en real, reduciendo las sorpresas de “no quote available” por un feed sin aprovisionar.",
        "<strong class='text-white'>Validación de símbolo &amp; cantidad</strong>, comprueba el contrato y el tamaño antes de enviar la orden, de modo que los símbolos incorrectos y las cantidades excesivas se detectan pronto en lugar de rebotar.",
        "<strong class='text-white'>Conciencia de riesgo &amp; acuerdo</strong>, le ayuda a mantener el flujo de alertas alineado con el estado de operativa real y de prop firm de su cuenta, de modo que los rechazos “risk parameters” por derechos sean menos probables.",
        "<strong class='text-white'>Sincronización multicuenta</strong>, replica una orden corregida y validada en todas las cuentas conectadas en lugar de disparar rechazos en todas a la vez.",
      ],
    },
    { type: "paragraph",html: "El resultado: menos entradas bloqueadas, menos rechazos misteriosos el primer día de una cuenta real nueva y registros más limpios cuando sí necesite depurar." },
  ], fr: [
    { type: "paragraph",html: "Vous avez approvisionné un compte Tradovate réel, branché votre automatisation, déclenché un ordre, et rien ne passe. Les clics manuels rebondissent. Les appels API échouent. Vos alertes TradingView arrivent sous forme de rejets. Avant de démonter votre stratégie, vérifiez l'évidence, car en 2026 l'une des raisons les plus courantes pour lesquelles un compte Tradovate réel ou financé tout neuf ne peut passer aucun ordre n'a rien à voir avec votre configuration ni votre solde : l'<strong class='text-white'>accord de données de marché n'est pas signé</strong>. Pas d'accord signé, pas de droit aux données en temps réel et aucune cotation en direct pour valoriser votre ordre." },
    { type: "paragraph",html: "Cela se présente sous plusieurs masques : des symboles « orange » retardés, un rejet <strong class='text-white'>“No quote available”</strong>, un rejet <strong class='text-white'>“risk parameters”</strong> ou, côté API, une erreur qui indique <strong class='text-white'>“Live account is required.”</strong> Toutes ramènent à la même solution. Signez la <strong class='text-white'>Non-Professional Market Data Agreement</strong>, abonnez-vous aux données en direct et laissez le droit s'activer avant de trader. Vous trouverez ci-dessous chaque cause et sa solution, ainsi que la façon dont l'automatisation avec PickMyTrade vous évite d'envoyer des ordres vers un compte qui n'a pas encore de données en direct." },
    {
      type: "checklist",
      heading: "Liste de vérification rapide pour les ordres réels bloqués",
      items: [
        "<strong class='text-white'>Confirmez que l'accord de données est signé.</strong> À la première connexion à un compte réel, Tradovate vous invite à signer l'accord de données de marché du CME. Si vous l'ignorez, les ordres réels ne sont pas routés.",
        "<strong class='text-white'>Vérifiez que vous avez choisi Non-Professional.</strong> Choisir Professional (ou laisser non signé) modifie votre droit et la facturation des données. La plupart des traders particuliers sont éligibles au statut Non-Professional.",
        "<strong class='text-white'>Contrôlez la couleur du symbole et l'état des données.</strong> Des noms de symboles orange ou retardés et des champs bid/ask vides signifient que le flux n'est pas encore en direct, et les ordres seront rejetés.",
        "<strong class='text-white'>Abonnez-vous aux données de marché en direct.</strong> Un accord signé plus un abonnement temps réel actif à la bourse (par exemple le CME) vous permet de valoriser et de passer des ordres.",
        "<strong class='text-white'>Attendez l'activation, puis reconnectez-vous.</strong> Les droits peuvent mettre d'environ 10 à 90 minutes pour s'activer. Déconnectez-vous puis reconnectez-vous pour les prendre en compte.",
        "<strong class='text-white'>Les comptes prop et d'évaluation sont différents.</strong> Sur un compte d'évaluation appartenant à une firme, vous ne pouvez généralement pas vous abonner vous-même. La firme active les données ; contactez-la si elles sont toujours retardées.",
      ],
    },
    { type: "heading",text: "Ce que signifient « Live Account Is Required » et les ordres réels bloqués" },
    { type: "paragraph",html: "Lorsque vous ouvrez un compte de courtage Tradovate réel (ou un compte financé/d'évaluation routé via Tradovate), la plateforme ne vous diffuse pas de données de bourse en temps réel tant que vous n'avez pas accepté l'accord de données de marché de la bourse. C'est dans cet accord que vous certifiez vous-même votre statut <strong class='text-white'>Non-Professional</strong>. Tant qu'il n'est pas signé, votre compte n'a droit qu'à des données retardées. Tradovate affiche généralement un <strong class='text-white'>retard de 10 minutes</strong>, et les symboles retardés s'affichent avec leur nom en <strong class='text-white'>orange</strong> au lieu de la couleur habituelle." },
    { type: "paragraph",html: "Voici ce qui surprend les automatiseurs : <strong class='text-white'>les données en direct ne sont pas seulement un « plus » pour les graphiques, elles sont indispensables pour passer des ordres.</strong> Tradovate a besoin d'une cotation valide en temps réel pour valoriser un ordre et contrôler le risque au moment de la soumission. Sans droit en direct, un ordre au marché n'a pas de cotation ferme contre laquelle s'exécuter ; il rebondit donc avec <strong class='text-white'>“No quote available. Please contact support,”</strong> tandis que la vérification du droit elle-même peut échouer et renvoyer un rejet <strong class='text-white'>“risk parameters”</strong>. Pour les flux API et pilotés par bot, c'est encore plus net : si votre intégration tente d'ajouter un abonnement de droit de données de marché avant la signature de l'accord, l'API de Tradovate renvoie une erreur signifiant <strong class='text-white'>“Live account is required,”</strong> sa façon de vous dire que l'utilisateur n'a pas encore rempli l'accord de données de marché." },
    { type: "heading",text: "Principales causes d'ordres réels bloqués en 2026" },
    { type: "heading",text: "1. L'accord de données de marché n'a jamais été signé" },
    { type: "paragraph",html: "C'est la cause la plus fréquente sur un compte réel ou financé tout neuf. <strong class='text-white'>La première fois</strong> que vous vous connectez à la plateforme réelle, Tradovate vous invite à examiner et à signer l'accord de données de marché du CME (et, le cas échéant, d'autres bourses). Si vous fermez cette invite, vous connectez depuis un appareil qui ne l'a pas affichée ou supposez qu'elle est facultative, votre compte reste sur des données retardées, ce qui signifie que les ordres réels ne peuvent pas être valorisés. Tradovate précise aussi que cet accord doit généralement être rempli la première fois depuis une <strong class='text-white'>connexion ordinateur/web</strong>, et non depuis l'application mobile." },
    { type: "heading",text: "2. Vous avez signé en tant que Professional au lieu de Non-Professional" },
    { type: "paragraph",html: "L'accord vous demande de certifier votre statut de données. La plupart des traders particuliers qui tradent leur propre argent sont éligibles au statut <strong class='text-white'>Non-Professional</strong>, qui donne droit aux données particulier, moins chères. Si vous avez certifié par erreur <strong class='text-white'>Professional</strong>, votre droit et la facturation des données changent, et ce décalage peut priver votre compte du flux en direct attendu. La correction n'est pas en libre-service : vous devez généralement contacter le support de Tradovate pour rectifier la sélection." },
    { type: "heading",text: "3. Les données ne sont pas encore activées (ou le flux a décroché)" },
    { type: "paragraph",html: "Signer et s'abonner n'active pas les données instantanément. L'activation prend couramment <strong class='text-white'>de 10 à 90 minutes</strong> selon la demande, et vous devez généralement <strong class='text-white'>vous déconnecter puis vous reconnecter</strong> pour prendre en compte le nouveau droit. Si vous tradez dans cette fenêtre, vous verrez encore des cotations retardées et « no quote available ». Les flux peuvent aussi décrocher pendant les périodes de très faible volume et nécessiter une nouvelle connexion." },
    { type: "heading",text: "4. Aucun abonnement actif aux données en temps réel" },
    { type: "paragraph",html: "L'accord n'est qu'une moitié ; un <strong class='text-white'>abonnement actif</strong> au flux temps réel de la bourse en est l'autre. Un compte de courtage Tradovate réel inclut gratuitement les données temps réel de niveau 1 du CME Group et d'EUREX avec chaque forfait, mais l'abonnement doit tout de même être activé en plus d'un accord signé. Les frais pour des niveaux de données supérieurs ou d'autres bourses varient ; consultez donc les tarifs actuels des données de marché de Tradovate plutôt que de supposer un montant fixe." },
    { type: "heading",text: "5. C'est un compte prop / d'évaluation contrôlé par la firme" },
    { type: "paragraph",html: "Sur les comptes financés et d'évaluation, Tradovate n'est généralement pas propriétaire du compte : c'est la <strong class='text-white'>prop firm</strong>. Cela signifie que c'est la firme, et non vous, qui active ou répare le flux de données de marché, et que vous ne pouvez souvent <strong class='text-white'>pas</strong> vous abonner vous-même depuis Tradovate. Si vous avez un compte Apex, Topstep, FundedNext ou similaire et que les données sont retardées, l'accord et l'abonnement sont gérés côté firme, et la solution passe donc par elle." },
    { type: "heading",text: "Comment corriger les ordres réels bloqués : étape par étape" },
    { type: "heading",text: "Corriger un accord non signé ou mal signé" },
    { type: "paragraph",html: "<ol><li>Connectez-vous au <strong class='text-white'>web trader de Tradovate depuis un ordinateur</strong> (et non depuis l'application mobile pour la première signature).</li><li>Ouvrez le menu <strong class='text-white'>Account / Settings</strong> et trouvez la section <strong class='text-white'>market data / agreements</strong>. Confirmez que la <strong class='text-white'>Non-Professional Market Data Agreement</strong> apparaît comme signée. Le libellé des menus change selon les versions ; cherchez donc l'intitulé de l'accord de données de marché dans votre version actuelle.</li><li>S'il n'est pas signé, remplissez-le et acceptez-le en sélectionnant le statut <strong class='text-white'>Non-Professional</strong> (si vous êtes éligible en tant que trader particulier autonome).</li><li>Si c'est <strong class='text-white'>Professional</strong> qui est indiqué et que c'est faux, n'essayez pas de le modifier vous-même. <strong class='text-white'>Contactez le support de Tradovate</strong> pour corriger la certification, car un mauvais statut affecte à la fois le droit et la facturation.</li></ol>" },
    { type: "heading",text: "Activer les données de marché en direct et les laisser s'activer" },
    { type: "paragraph",html: "<ol><li>Ouvrez <strong class='text-white'>Application Settings</strong> dans le web trader et allez dans la zone <strong class='text-white'>Subscriptions / Market Data</strong>.</li><li><strong class='text-white'>Abonnez-vous</strong> au flux temps réel de la bourse sur laquelle vous tradez (par exemple le bundle CME pour ES, NQ, MES et MNQ). Un compte réel financé inclut gratuitement les données de niveau 1 CME/EUREX, mais l'abonnement doit tout de même être activé.</li><li><strong class='text-white'>Attendez l'activation, environ 10 à 90 minutes, puis déconnectez-vous et reconnectez-vous.</strong> Les symboles en direct doivent s'afficher dans leur couleur normale avec un bid/ask mobile au lieu de cotations orange retardées.</li><li>Ne passez <strong class='text-white'>pas</strong> d'ordres avant d'avoir confirmé que le flux est en direct. Trader contre des cotations retardées ou absentes est la meilleure façon d'obtenir des exécutions et des rejets surprises.</li></ol>" },
    { type: "heading",text: "Corriger pour l'API et le trading automatisé" },
    { type: "paragraph",html: "<ol><li>Assurez-vous que le <strong class='text-white'>titulaire humain du compte a d'abord signé l'accord</strong> ; l'API ne peut pas le contourner. Si votre code appelle le point de terminaison d'abonnement aux droits avant l'acceptation de l'accord, Tradovate renvoie l'erreur <strong class='text-white'>“Live account is required”</strong>, qui signifie précisément que l'accord de données de marché n'est pas encore signé.</li><li>Une fois l'accord signé et les données activées, réauthentifiez votre session API pour qu'elle hérite du nouveau droit, et vérifiez que vous visez bien l'hôte <strong class='text-white'>réel</strong> (et non le point de terminaison démo).</li><li>Empêchez votre automatisation de se déclencher pendant la fenêtre d'activation. Mettez les ordres en file d'attente ou en pause jusqu'à ce qu'une cotation en direct soit confirmée.</li></ol>" },
    { type: "heading",text: "Corriger sur un compte prop / d'évaluation" },
    { type: "paragraph",html: "Signez tout accord que la firme vous demande lors de l'intégration ; la certification Non-Professional s'applique toujours. Si les symboles restent retardés après la signature et une nouvelle connexion, <strong class='text-white'>contactez le support de la prop firm, pas Tradovate</strong>. Seule la firme peut activer ou réparer les données d'un compte qui lui appartient. Laissez toute la fenêtre d'activation (jusqu'à environ 90 minutes) avant d'escalader." },
    { type: "heading",text: "Tableau de dépannage" },
    { type: "table", headers: ["Erreur / symptôme","Signification","Solution"], rows: [
      ["Message « No quote available. Please contact support. »","Aucune cotation temps réel en direct pour valoriser l'ordre au moment de la soumission","Signer l'accord Non-Professional, s'abonner aux données en direct, se reconnecter et confirmer un bid/ask en direct avant d'ordonner"],
      ["Rejet « Risk parameters »","L'ordre a échoué à un contrôle de droit du compte / de risque (des données non en direct comptent)","Confirmer que l'accord de données et l'abonnement sont actifs ; vérifier aussi les limites de vos Risk Settings"],
      ["Erreur API « Live account is required »","Un abonnement de droit a été demandé avant la signature de l'accord de données de marché","Faire d'abord signer l'accord par le titulaire du compte, puis réauthentifier la session API"],
      ["Noms de symboles orange / retardés, cotations vides","Le compte est sur des données retardées, pas en direct","Signer l'accord, s'abonner, attendre environ 10–90 min, puis se déconnecter et se reconnecter"],
      ["Signé par erreur en tant que Professional","La mauvaise certification de données modifie le droit et la facturation","Contacter le support de Tradovate pour corriger le statut en Non-Professional"],
      ["Compte prop/d'évaluation toujours retardé après la signature","Les données sont contrôlées par la firme, non souscriptibles par soi-même","Contacter le support de la prop firm pour faire activer le flux"],
    ] },
    { type: "heading",text: "Évitez cela avec PickMyTrade" },
    { type: "paragraph",html: "PickMyTrade relie directement vos alertes TradingView à Tradovate et ajoute des garde-fous pour que vous n'envoyiez pas d'ordres vers un compte qui n'a pas encore de données en direct :" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Routage tenant compte des droits &amp; des données</strong>, conçu pour router les ordres via un compte configuré pour le trading réel, en réduisant les surprises « no quote available » dues à un flux non approvisionné.",
        "<strong class='text-white'>Validation du symbole &amp; de la quantité</strong>, vérifie le contrat et la taille avant l'envoi de l'ordre, afin que les mauvais symboles et les quantités excessives soient repérés tôt au lieu de rebondir.",
        "<strong class='text-white'>Prise en compte du risque &amp; de l'accord</strong>, vous aide à garder le flux d'alertes aligné sur l'état de trading réel et de prop firm de votre compte, pour que les rejets « risk parameters » liés aux droits soient moins probables.",
        "<strong class='text-white'>Synchronisation multi-comptes</strong>, reproduit un ordre corrigé et validé sur tous les comptes connectés au lieu de déclencher des rejets partout à la fois.",
      ],
    },
    { type: "paragraph",html: "Le bénéfice : moins d'entrées bloquées, moins de rejets mystérieux le premier jour d'un nouveau compte réel et des journaux plus propres lorsque vous devez déboguer." },
  ], it: [
    { type: "paragraph",html: "Ha finanziato un conto Tradovate live, collegato la sua automazione, lanciato un ordine, e non passa niente. I clic manuali rimbalzano. Le chiamate API falliscono. I suoi alert di TradingView arrivano come rifiuti. Prima di smontare la sua strategia, controlli la cosa banale, perché nel 2026 uno dei motivi più comuni per cui un conto Tradovate live o finanziato appena aperto non riesce a inviare nemmeno un ordine non ha nulla a che fare con la sua configurazione o con il suo saldo: l'<strong class='text-white'>accordo sui dati di mercato non è firmato</strong>. Nessun accordo firmato significa nessun diritto ai dati in tempo reale e nessuna quotazione live con cui prezzare il suo ordine." },
    { type: "paragraph",html: "Si presenta con maschere diverse: simboli “arancioni” ritardati, un rifiuto <strong class='text-white'>“No quote available”</strong>, un rifiuto <strong class='text-white'>“risk parameters”</strong> oppure, lato API, un errore che recita <strong class='text-white'>“Live account is required.”</strong> Tutti riconducono alla stessa soluzione. Firmi la <strong class='text-white'>Non-Professional Market Data Agreement</strong>, si abboni ai dati live e lasci attivare il diritto prima di operare. Di seguito trova ogni causa con la sua soluzione, più come l'automazione con PickMyTrade evita di inviare ordini a un conto che non ha ancora i dati live." },
    {
      type: "checklist",
      heading: "Checklist rapida per ordini live bloccati",
      items: [
        "<strong class='text-white'>Confermi che l'accordo sui dati sia firmato.</strong> Al primo accesso a un conto live, Tradovate le chiede di firmare l'accordo sui dati di mercato del CME. Se lo salta, gli ordini live non vengono instradati.",
        "<strong class='text-white'>Si assicuri di aver scelto Non-Professional.</strong> Scegliere Professional (o lasciare non firmato) modifica il suo diritto e la fatturazione dei dati. La maggior parte dei trader retail si qualifica come Non-Professional.",
        "<strong class='text-white'>Controlli il colore del simbolo e lo stato dei dati.</strong> Nomi di simbolo arancioni o ritardati e campi bid/ask vuoti significano che il feed non è ancora live e gli ordini verranno rifiutati.",
        "<strong class='text-white'>Si abboni ai dati di mercato live.</strong> Un accordo firmato più un abbonamento attivo in tempo reale per la borsa (per esempio CME) è ciò che le permette di prezzare e inviare ordini.",
        "<strong class='text-white'>Attenda l'attivazione, poi rientri.</strong> I diritti possono impiegare da circa 10 a 90 minuti per attivarsi. Esca e rientri per recepirli.",
        "<strong class='text-white'>I conti prop e di valutazione sono diversi.</strong> Su un conto di valutazione di proprietà della firm di solito non può abbonarsi da solo. È la firm ad abilitare i dati, quindi la contatti se sono ancora ritardati.",
      ],
    },
    { type: "heading",text: "Cosa significano “Live Account Is Required” e gli ordini live bloccati" },
    { type: "paragraph",html: "Quando apre un conto di brokeraggio Tradovate live (o un conto finanziato/di valutazione instradato tramite Tradovate), la piattaforma non le trasmette dati di borsa in tempo reale finché non ha accettato l'accordo sui dati di mercato della borsa. In quell'accordo lei autocertifica il proprio status <strong class='text-white'>Non-Professional</strong>. Finché non è firmato, il suo conto ha diritto solo a dati ritardati. Tradovate mostra tipicamente un <strong class='text-white'>ritardo di 10 minuti</strong>, e i simboli ritardati vengono visualizzati con il nome in <strong class='text-white'>arancione</strong> anziché nel colore normale." },
    { type: "paragraph",html: "Ecco la parte che coglie di sorpresa chi automatizza: <strong class='text-white'>i dati live non sono solo un “di più” per i grafici, sono necessari per inviare ordini.</strong> Tradovate ha bisogno di una quotazione valida in tempo reale per prezzare e verificare il rischio di un ordine al momento dell'invio. Senza diritto live, un ordine a mercato non ha una quotazione ferma su cui eseguirsi, quindi rimbalza come <strong class='text-white'>“No quote available. Please contact support,”</strong> mentre il controllo del diritto stesso può fallire e restituire un rifiuto <strong class='text-white'>“risk parameters”</strong>. Per i flussi API e dei bot è ancora più netto: se la sua integrazione tenta di aggiungere un abbonamento al diritto sui dati di mercato prima che l'accordo sia firmato, l'API di Tradovate restituisce un errore che significa <strong class='text-white'>“Live account is required,”</strong> il suo modo di dirle che l'utente non ha ancora completato l'accordo sui dati di mercato." },
    { type: "heading",text: "Principali cause di ordini live bloccati nel 2026" },
    { type: "heading",text: "1. L'accordo sui dati di mercato non è mai stato firmato" },
    { type: "paragraph",html: "È la singola causa più comune su un conto live o finanziato nuovo. <strong class='text-white'>La prima volta</strong> che accede alla piattaforma live, Tradovate le chiede di rivedere e firmare l'accordo sui dati di mercato del CME (e, ove rilevante, di altre borse). Se chiude quella richiesta, accede da un dispositivo che non l'ha mostrata o presume che sia facoltativa, il suo conto resta su dati ritardati, il che significa che gli ordini live non possono essere prezzati. Tradovate segnala inoltre che questo accordo deve in genere essere completato la prima volta da un <strong class='text-white'>accesso da computer/web</strong>, non dall'app mobile." },
    { type: "heading",text: "2. Ha firmato come Professional invece che come Non-Professional" },
    { type: "paragraph",html: "L'accordo le chiede di certificare il suo status dei dati. La maggior parte dei trader retail che operano con il proprio denaro si qualifica come <strong class='text-white'>Non-Professional</strong>, che comporta il diritto ai dati retail, più economico. Se ha certificato per errore come <strong class='text-white'>Professional</strong>, il suo diritto e la fatturazione dei dati cambiano, e quella discrepanza può lasciare il suo conto senza il feed live atteso. La soluzione non è self-service: in genere deve contattare il supporto di Tradovate per correggere la selezione." },
    { type: "heading",text: "3. I dati non si sono ancora attivati (o il feed è caduto)" },
    { type: "paragraph",html: "Firmare e abbonarsi non attiva i dati all'istante. L'attivazione richiede di solito <strong class='text-white'>da 10 a 90 minuti</strong> a seconda della domanda, e in genere deve <strong class='text-white'>uscire e rientrare</strong> per recepire il nuovo diritto. Se opera in quella finestra, vedrà ancora quotazioni ritardate e “no quote available”. I feed possono anche cadere nei periodi di volume molto basso e richiedere un nuovo login." },
    { type: "heading",text: "4. Nessun abbonamento attivo ai dati in tempo reale" },
    { type: "paragraph",html: "L'accordo è una metà; un <strong class='text-white'>abbonamento attivo</strong> al feed in tempo reale della borsa è l'altra. Un conto di brokeraggio Tradovate live include gratuitamente i dati in tempo reale di livello 1 di CME Group ed EUREX con ogni piano, ma l'abbonamento deve comunque essere attivato insieme a un accordo firmato. Le tariffe per livelli di dati superiori o altre borse variano, quindi controlli i prezzi attuali dei dati di mercato di Tradovate invece di presumere una cifra fissa." },
    { type: "heading",text: "5. È un conto prop / di valutazione controllato dalla firm" },
    { type: "paragraph",html: "Sui conti finanziati e di valutazione, Tradovate di solito non è il proprietario del conto: lo è la <strong class='text-white'>prop firm</strong>. Ciò significa che è la firm, non lei, ad abilitare o riparare il feed dei dati di mercato, e spesso <strong class='text-white'>non</strong> può abbonarsi da solo da Tradovate. Se ha un conto Apex, Topstep, FundedNext o simile e i dati sono ritardati, accordo e abbonamento sono gestiti dalla firm, quindi la soluzione passa da loro." },
    { type: "heading",text: "Come risolvere gli ordini live bloccati: passo dopo passo" },
    { type: "heading",text: "Risolvere un accordo non firmato o firmato in modo errato" },
    { type: "paragraph",html: "<ol><li>Acceda al <strong class='text-white'>web trader di Tradovate da un computer</strong> (non dall'app mobile per la prima firma).</li><li>Apra il menu <strong class='text-white'>Account / Settings</strong> e trovi la sezione <strong class='text-white'>market data / agreements</strong>. Confermi che la <strong class='text-white'>Non-Professional Market Data Agreement</strong> risulti firmata. La dicitura dei menu cambia tra le versioni, quindi cerchi l'etichetta dell'accordo sui dati di mercato nella sua versione attuale.</li><li>Se non è firmato, lo completi e lo accetti, selezionando lo status <strong class='text-white'>Non-Professional</strong> (presumendo che si qualifichi come trader retail autonomo).</li><li>Se risulta <strong class='text-white'>Professional</strong> e non è corretto, non provi a cambiarlo da solo. <strong class='text-white'>Contatti il supporto di Tradovate</strong> per correggere la certificazione, poiché lo status sbagliato influisce sia sul diritto sia sulla fatturazione.</li></ol>" },
    { type: "heading",text: "Attivare i dati di mercato live e lasciarli attivare" },
    { type: "paragraph",html: "<ol><li>Apra <strong class='text-white'>Application Settings</strong> nel web trader e vada all'area <strong class='text-white'>Subscriptions / Market Data</strong>.</li><li><strong class='text-white'>Si abboni</strong> al feed in tempo reale della borsa su cui opera (per esempio il bundle CME per ES, NQ, MES e MNQ). Un conto live finanziato include gratuitamente i dati di livello 1 di CME/EUREX, ma l'abbonamento deve comunque essere attivato.</li><li><strong class='text-white'>Attenda l'attivazione, circa 10–90 minuti, poi esca e rientri.</strong> I simboli live dovrebbero comparire nel colore normale con un bid/ask in movimento invece che in quotazioni arancioni ritardate.</li><li><strong class='text-white'>Non</strong> invii ordini finché non ha confermato che il feed è live. Operare contro quotazioni ritardate o assenti è il modo per avere esecuzioni e rifiuti a sorpresa.</li></ol>" },
    { type: "heading",text: "Risolvere per API e trading automatizzato" },
    { type: "paragraph",html: "<ol><li>Si assicuri che il <strong class='text-white'>titolare umano del conto abbia firmato prima l'accordo</strong>: l'API non può aggirarlo. Se il suo codice chiama l'endpoint di abbonamento ai diritti prima che l'accordo sia accettato, Tradovate restituisce l'errore <strong class='text-white'>“Live account is required”</strong>, che significa specificamente che l'accordo sui dati di mercato non è ancora firmato.</li><li>Una volta firmato l'accordo e attivati i dati, riautentichi la sua sessione API perché erediti il nuovo diritto e confermi di colpire l'host <strong class='text-white'>live</strong> corretto (non l'endpoint demo).</li><li>Eviti che la sua automazione scatti durante la finestra di attivazione. Metta in coda o in pausa gli ordini finché non è confermata una quotazione live.</li></ol>" },
    { type: "heading",text: "Risolvere su un conto prop / di valutazione" },
    { type: "paragraph",html: "Firmi qualsiasi accordo che la firm le chieda durante l'onboarding: la certificazione Non-Professional si applica comunque. Se i simboli sono ancora ritardati dopo la firma e un nuovo login, <strong class='text-white'>contatti il supporto della prop firm, non Tradovate</strong>. Solo la firm può abilitare o riparare i dati su un conto di sua proprietà. Dia all'attivazione l'intera finestra (fino a circa 90 minuti) prima di fare escalation." },
    { type: "heading",text: "Tabella di risoluzione dei problemi" },
    { type: "table", headers: ["Errore / sintomo","Significato","Soluzione"], rows: [
      ["Messaggio “No quote available. Please contact support.”","Nessuna quotazione live in tempo reale per prezzare l'ordine al momento dell'invio","Firmare l'accordo Non-Professional, abbonarsi ai dati live, rientrare e confermare un bid/ask live prima di ordinare"],
      ["Rifiuto “Risk parameters”","L'ordine non ha superato un controllo di diritto del conto / rischio (dati non live inclusi)","Confermare che accordo sui dati e abbonamento siano attivi; controllare anche i limiti nei Risk Settings"],
      ["Errore API “Live account is required”","È stato richiesto un abbonamento ai diritti prima che l'accordo sui dati di mercato fosse firmato","Far firmare prima l'accordo al titolare del conto, poi riautenticare la sessione API"],
      ["Nomi di simbolo arancioni / ritardati, quotazioni vuote","Il conto è su dati ritardati, non live","Firmare l'accordo, abbonarsi, attendere circa 10–90 min, poi uscire e rientrare"],
      ["Firmato come Professional per errore","La certificazione dei dati sbagliata modifica diritto e fatturazione","Contattare il supporto di Tradovate per correggere lo status in Non-Professional"],
      ["Conto prop/di valutazione ancora ritardato dopo la firma","I dati sono controllati dalla firm, non sottoscrivibili in autonomia","Contattare il supporto della prop firm per abilitare il feed"],
    ] },
    { type: "heading",text: "Lo eviti con PickMyTrade" },
    { type: "paragraph",html: "PickMyTrade collega i suoi alert di TradingView direttamente a Tradovate e aggiunge protezioni perché non invii ordini a un conto che non ha ancora i dati live:" },
    {
      type: "list",
      items: [
