---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "tradingview-addon-bid-ask-delay";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/debugging/${SLUG}`;

const META_TITLE = "Tradovate TradingView Addon Bid/Ask Delay & P&L";
const META_DESCRIPTION =
  "Tradovate TradingView addon bid/ask lagging? See why quotes and P&L differ from the platform and how to confirm your real fill on the live feed.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Tradovate TradingView-Add-on: Bid/Ask-Verzögerung & P&L", es: "Retraso de bid/ask y P&L en el add-on de TradingView para Tradovate", fr: "Décalage bid/ask et P&L de l'add-on TradingView pour Tradovate", it: "Ritardo bid/ask e P&L nell'add-on TradingView per Tradovate" },
  dek: { en: "The bid and ask freeze on your connected TradingView chart while the last price keeps ticking, and your open P&L reads green right up until it closes red. Here's why the add-on lags and which number to actually trust.", de: "Bid und Ask frieren in Ihrem verbundenen TradingView-Chart ein, während der letzte Kurs weiter tickt, und Ihr offenes P&L zeigt Grün, bis die Position rot schließt. Hier erfahren Sie, warum das Add-on hinterherhinkt und welcher Zahl Sie tatsächlich vertrauen sollten.", es: "El bid y el ask se congelan en su gráfico de TradingView conectado mientras el último precio sigue moviéndose, y su P&L abierto aparece en verde hasta que la operación cierra en rojo. Aquí le explicamos por qué el add-on se retrasa y en qué cifra debe confiar realmente.", fr: "Le bid et l'ask se figent sur votre graphique TradingView connecté alors que le dernier prix continue de bouger, et votre P&L ouvert reste vert jusqu'à la clôture en rouge. Voici pourquoi l'add-on est en retard et à quel chiffre vous fier réellement.", it: "Bid e ask si bloccano sul suo grafico TradingView collegato mentre l'ultimo prezzo continua a muoversi, e il suo P&L aperto resta verde fino a quando la posizione chiude in rosso. Ecco perché l'add-on è in ritardo e di quale numero fidarsi davvero." },
  readTime: { en: "7 min read", de: "7 Min. Lesezeit", es: "Lectura de 7 min", fr: "Lecture : 7 min", it: "Lettura di 7 min" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "When you're scalping fast movers like ES or NQ through the TradingView add-on for Tradovate, the number that gets you into trouble isn't the last price. It's the bid and the ask. On a connected chart, those two quotes can freeze for seconds, and sometimes for minutes, while the last-traded price keeps ticking along like nothing's wrong. The result is brutal. An open position reads plus 20 points of profit on the add-on, then closes as a <em>loss</em> the instant you hit the button. This isn't a TradingView bug you can clear with a refresh, and it's not the same thing as a &ldquo;non-tradable symbol&rdquo; error. The lag lives in the market-data feed behind your Tradovate connection, and that's exactly why the only P&amp;L you should trust is the one Tradovate's own platform shows you." },
    {
      type: "checklist",
      heading: "Quick Checklist for Lagging Bid/Ask and Mismatched P&L",
      items: [
        "<strong class='text-white'>Bid/ask frozen while the last price moves</strong>, you're reading a lagging quote, so confirm the live price on Tradovate directly before you act.",
        "<strong class='text-white'>Symbol name shown in orange</strong>, that's Tradovate's delayed-data flag; you don't have a live real-time subscription on that feed.",
        "<strong class='text-white'>Add-on P&amp;L doesn't match Tradovate's P&amp;L</strong>, trust the Tradovate Trader positions panel; the add-on can mark your position off a stale quote.",
        "<strong class='text-white'>No broker-side data subscription</strong>, TradingView data packages don't cover broker bid/ask quotes, so the subscription has to live on Tradovate.",
        "<strong class='text-white'>Multiple sessions open</strong>, extra browser tabs and devices each count as a session and can stall the connected feed, so run one.",
        "<strong class='text-white'>Fills diverging from the screen</strong>, your execution isn't broken; the delayed on-screen quote is what's misleading you.",
      ],
    },
    { type: "heading", text: "What “Lagging Bid/Ask and Mismatched P&L” Actually Means" },
    { type: "paragraph", html: "The TradingView add-on lets you place and manage Tradovate orders straight from a TradingView chart. But TradingView is a third-party front end. It only receives ask and bid prices from your broker <em>after</em> you log into the broker connection, and it relays whatever that feed hands it. So the rule is simple: if the data for a symbol is delayed on the broker platform, the ask and bid quotes will be delayed too, and data packages you buy on TradingView don't cover those broker quotes. When the Tradovate feed behind your connection is slow to push updates, the add-on faithfully draws a delayed bid and ask." },
    { type: "paragraph", html: "Here's why that quietly wrecks P&amp;L. Your unrealized profit and loss is a function of where the market <em>is right now</em> versus your entry. When the bid/ask the add-on marks against is stale, the profit number on the chart is being calculated against an old price. The last-traded print may look current, but the spread you'd actually cross to exit is behind. That's how the add-on shows green while the live market has already moved against you. It's common to see several P&amp;L displays disagree at the same moment, the connected TradingView chart, TradingView's unconnected paper trader, the Tradovate Trader desktop app, and the account summary panel can all show <em>different</em> numbers, with the real result only landing once the position closes on Tradovate's books." },
    { type: "paragraph", html: "The takeaway isn't &ldquo;the add-on is unusable.&rdquo; It's that the add-on's displayed P&amp;L is a convenience mark, not the ledger. Tradovate's platform is the system of record, and its feed is what your orders actually fill against." },
    { type: "heading", text: "Top Causes of Bid/Ask Delay on the Tradovate Add-On" },
    { type: "heading", text: "1. The connected feed lags behind the last price" },
    { type: "paragraph", html: "The most common symptom is a bid and ask that update far slower than the last price. The spread can trail by seconds, and occasionally much longer during busy periods, while the candle and last price still look live. Because your exit crosses the spread, a stale bid/ask means the price you <em>think</em> you can exit at isn't the price the market will actually give you." },
    { type: "heading", text: "2. You're on delayed (non-subscribed) market data" },
    { type: "paragraph", html: "Tradovate delays market data by ten minutes for any username without a live real-time data subscription, and it flags this by showing the <strong class='text-white'>symbol name in orange</strong>. A live-funded Tradovate account includes free Level 1 CME Group data, but simulation and some evaluation setups may not have real-time data enabled by default. If your feed is on the ten-minute delay, every bid/ask, and therefore every P&amp;L mark, on the add-on is running ten minutes behind reality." },
    { type: "heading", text: "3. The add-on marks P&L off a stale quote" },
    { type: "paragraph", html: "Even a small quote lag gets inherited by the profit/loss figure. That's why you can watch the same open trade show one number on the TradingView add-on and a different number in Tradovate Trader. The add-on isn't lying on purpose, it's marking against the quote it was last handed. Whenever the two disagree, the Tradovate platform's number is the one that determines your actual balance." },
    { type: "heading", text: "4. Session conflicts and your TradingView plan tier" },
    { type: "paragraph", html: "Two separate factors compound the lag. First, sessions. Each TradingView browser tab counts as its own session, and running Tradovate across web, desktop, mobile, and several TradingView tabs at once can cause conflicts that freeze or stall the connected feed. Second, plan tier. Free TradingView plans refresh data on a slower cadence than a paid real-time plan, so part of what looks like &ldquo;broker lag&rdquo; can actually be the TradingView side updating less often." },
    { type: "heading", text: "5. It's Tradovate's feed, not TradingView itself" },
    { type: "paragraph", html: "The clearest tell that the problem is the broker feed and not the front end shows up when you compare brokers on the <em>same</em> TradingView interface. Other data feeds, AMP with CQG, for example, stay fast and real-time while the Tradovate connection lags. That points squarely at the specific data feed behind Tradovate, which is why the delay is specific to its data, and why the fixes below all center on Tradovate's own subscription and platform." },
    { type: "heading", text: "How to Fix Bid/Ask Delay and P&L Mismatch: Step-by-Step" },
    { type: "heading", text: "Confirm the true price and P&L on Tradovate first" },
    { type: "paragraph", html: "Before you touch a single setting, make this a habit: when the add-on and Tradovate disagree, believe Tradovate. Open the Tradovate Trader positions and orders panel, web or desktop, and read your open P&amp;L and the live bid/ask there. That's the feed your orders fill against, so it's the number that will hit your account. Never close a position purely off a green figure on the add-on if the Tradovate panel disagrees." },
    { type: "heading", text: "Get a real-time market-data subscription on the Tradovate side" },
    { type: "paragraph", html: "Because TradingView data packages don't cover broker bid/ask, the real-time subscription has to be on Tradovate. On a live-funded account that's usually the free Level 1 CME data included with your plan, you just need it enabled and the agreements signed. Exact plan inclusions and any exchange fees vary by account type and exchange, so check your current Tradovate plan and your exchange's rules rather than assuming. Once real-time data is active, the orange symbol name returns to its normal color and the bid/ask stops running on the ten-minute delay." },
    { type: "heading", text: "Sign the data agreement and restart your session" },
    { type: "paragraph", html: "A very common cause of a stuck delayed feed is an unsigned or un-refreshed market-data agreement. Log directly into Tradovate, not through TradingView, open the market-data and subscription area, then sign or re-accept the required exchange data agreement. Fully log out and back in so the connection re-reads your permissions, then reconnect TradingView to Tradovate. If you're on a prop-firm evaluation account, the firm usually controls the data entitlement, not you, so ask them to enable or refresh it." },
    { type: "heading", text: "Run a single session and verify real-time data" },
    { type: "paragraph", html: "Close extra TradingView tabs and any duplicate Tradovate logins so only one active session remains, then log back in on the single device you'll trade from. If you use TradingView's broker data verification for your live Tradovate account, complete it so you get real-time quotes without paying twice. If the add-on still lags after all of this while Tradovate's own platform is fast, treat it as a feed or front-end issue: trade and manage risk from the Tradovate platform, and report the discrepancy to Tradovate and TradingView support with timestamps." },
    { type: "heading", text: "Troubleshooting Table" },
    {
      type: "table",
      headers: ["Symptom", "What it means", "Fix"],
      rows: [
        ["Bid/ask frozen, last price still moving", "Quote feed behind the connection is lagging", "Confirm the live quote/P&L on Tradovate; don't exit off the stale spread"],
        ["Symbol name shown in orange", "Data is on the 10-minute delay (no live subscription)", "Enable real-time data on Tradovate; sign the agreement; restart session"],
        ["Add-on P&L &ne; Tradovate P&L", "Add-on is marking against a stale quote", "Trust the Tradovate positions panel as the system of record"],
        ["Delayed even after subscribing", "Data agreement unsigned or permissions not refreshed", "Re-sign the exchange data agreement and log out/in on Tradovate"],
        ["Feed stalls with several tabs open", "Session conflict across tabs/devices", "Run a single active session on one device"],
        ["Tradovate lags but other brokers are fast on TradingView", "Issue is specific to the Tradovate feed", "Manage from Tradovate's platform; report to support with timestamps"],
      ],
    },
    { type: "heading", text: "Prevent This with PickMyTrade" },
    { type: "paragraph", html: "If the root problem is &ldquo;I made a decision off a lagging on-screen quote,&rdquo; the durable fix is to take the eyeball out of the loop. PickMyTrade connects your TradingView strategy alerts straight to your Tradovate account so execution follows your logic, not a delayed spread:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Broker-side execution</strong>, orders route directly to your Tradovate account and fill on Tradovate's live matching engine, not against a chart's on-screen quote.",
        "<strong class='text-white'>Alert-driven, not eyeball-driven</strong>, trades trigger from your TradingView strategy and alert conditions, removing the &ldquo;I saw green, it closed red&rdquo; decision from a lagging bid/ask.",
        "<strong class='text-white'>Server-side reliability</strong>, the bridge runs on hosted infrastructure, so a frozen local browser tab doesn't strand your automation mid-trade.",
        "<strong class='text-white'>Multi-account sync</strong>, the same signal mirrors across your Tradovate accounts, using the broker's own fills as the single source of truth.",
      ],
    },
  ], de: [
    { type: "paragraph",html: "Wenn Sie schnelle Werte wie ES oder NQ über das TradingView-Add-on für Tradovate scalpen, ist nicht der letzte Kurs das Problem, sondern Bid und Ask. In einem verbundenen Chart können diese beiden Kurse sekundenlang, manchmal minutenlang einfrieren, während der zuletzt gehandelte Kurs ungerührt weitertickt. Das Ergebnis ist bitter. Eine offene Position zeigt im Add-on plus 20 Punkte Gewinn und schließt im Moment des Klicks als <em>Verlust</em>. Das ist kein TradingView-Fehler, den ein Neuladen beheben würde, und es ist nicht dasselbe wie die Fehlermeldung &ldquo;nicht handelbares Symbol&rdquo;. Die Verzögerung steckt im Marktdatenfeed hinter Ihrer Tradovate-Verbindung, und genau deshalb ist das einzige P&amp;L, dem Sie vertrauen sollten, das, welches die Plattform von Tradovate selbst anzeigt." },
    {
      type: "checklist",
      heading: "Kurze Checkliste bei verzögertem Bid/Ask und abweichendem P&L",
      items: [
        "<strong class='text-white'>Bid/Ask eingefroren, während sich der letzte Kurs bewegt</strong>, Sie lesen einen verzögerten Kurs, bestätigen Sie daher den Live-Preis direkt bei Tradovate, bevor Sie handeln.",
        "<strong class='text-white'>Symbolname orange dargestellt</strong>, das ist Tradovates Hinweis auf verzögerte Daten; für diesen Feed haben Sie kein aktives Echtzeit-Abonnement.",
        "<strong class='text-white'>P&amp;L des Add-ons stimmt nicht mit dem P&amp;L von Tradovate überein</strong>, vertrauen Sie dem Positionsfenster von Tradovate Trader; das Add-on kann Ihre Position anhand eines veralteten Kurses bewerten.",
        "<strong class='text-white'>Kein Datenabonnement auf Broker-Seite</strong>, TradingView-Datenpakete decken keine Bid/Ask-Kurse des Brokers ab, das Abonnement muss also bei Tradovate liegen.",
        "<strong class='text-white'>Mehrere Sitzungen geöffnet</strong>, zusätzliche Browser-Tabs und Geräte zählen jeweils als Sitzung und können den verbundenen Feed ausbremsen, nutzen Sie daher nur eine.",
        "<strong class='text-white'>Fills weichen vom Bildschirm ab</strong>, Ihre Ausführung ist nicht defekt; irreführend ist der verzögerte Kurs auf dem Bildschirm.",
      ],
    },
    { type: "heading",text: "Was „Verzögertes Bid/Ask und abweichendes P&L“ tatsächlich bedeutet" },
    { type: "paragraph",html: "Mit dem TradingView-Add-on platzieren und verwalten Sie Tradovate-Orders direkt aus einem TradingView-Chart. TradingView ist jedoch ein Front-End eines Drittanbieters. Es erhält Ask- und Bid-Kurse von Ihrem Broker erst, <em>nachdem</em> Sie sich in die Broker-Verbindung eingeloggt haben, und gibt weiter, was dieser Feed liefert. Die Regel ist also einfach: Sind die Daten eines Symbols auf der Broker-Plattform verzögert, sind auch die Ask- und Bid-Kurse verzögert, und auf TradingView gekaufte Datenpakete decken diese Broker-Kurse nicht ab. Liefert der Tradovate-Feed hinter Ihrer Verbindung Updates nur langsam, zeichnet das Add-on getreu ein verzögertes Bid und Ask." },
    { type: "paragraph",html: "Genau deshalb verfälscht das still Ihr P&amp;L. Ihr nicht realisierter Gewinn und Verlust ergibt sich daraus, wo der Markt <em>gerade jetzt</em> steht, verglichen mit Ihrem Einstieg. Ist das Bid/Ask, gegen das das Add-on bewertet, veraltet, wird die Gewinnzahl im Chart gegen einen alten Preis berechnet. Der zuletzt gehandelte Kurs mag aktuell aussehen, doch der Spread, den Sie zum Ausstieg tatsächlich überqueren würden, hinkt hinterher. So zeigt das Add-on Grün, während sich der Live-Markt längst gegen Sie bewegt hat. Es ist üblich, dass mehrere P&amp;L-Anzeigen gleichzeitig voneinander abweichen: Der verbundene TradingView-Chart, der nicht verbundene Paper-Trader von TradingView, die Tradovate-Trader-Desktop-App und das Kontoübersichtsfenster können alle <em>unterschiedliche</em> Zahlen zeigen, und das reale Ergebnis steht erst fest, wenn die Position in Tradovates Büchern geschlossen wird." },
    { type: "paragraph",html: "Die Schlussfolgerung lautet nicht &ldquo;das Add-on ist unbrauchbar&rdquo;. Das im Add-on angezeigte P&amp;L ist ein Komfortwert, nicht das Hauptbuch. Die Tradovate-Plattform ist das führende System, und gegen deren Feed werden Ihre Orders tatsächlich ausgeführt." },
    { type: "heading",text: "Die häufigsten Ursachen für Bid/Ask-Verzögerung im Tradovate-Add-on" },
    { type: "heading",text: "1. Der verbundene Feed hinkt dem letzten Kurs hinterher" },
    { type: "paragraph",html: "Das häufigste Symptom sind Bid und Ask, die sich weit langsamer aktualisieren als der letzte Kurs. Der Spread kann sekundenlang, in geschäftigen Phasen gelegentlich deutlich länger hinterherhinken, während Kerze und letzter Kurs noch live wirken. Da Ihr Ausstieg den Spread überquert, bedeutet ein veraltetes Bid/Ask, dass der Preis, zu dem Sie <em>glauben</em> aussteigen zu können, nicht der Preis ist, den der Markt Ihnen tatsächlich gibt." },
    { type: "heading",text: "2. Sie nutzen verzögerte (nicht abonnierte) Marktdaten" },
    { type: "paragraph",html: "Tradovate verzögert Marktdaten um zehn Minuten für jeden Benutzernamen ohne aktives Echtzeit-Datenabonnement und kennzeichnet das, indem der <strong class='text-white'>Symbolname orange</strong> angezeigt wird. Ein live finanziertes Tradovate-Konto enthält kostenlose Level-1-Daten der CME Group, doch Simulations- und manche Evaluierungskonten haben Echtzeitdaten möglicherweise nicht standardmäßig aktiviert. Läuft Ihr Feed mit der Zehn-Minuten-Verzögerung, hinkt jedes Bid/Ask und damit jede P&amp;L-Bewertung im Add-on zehn Minuten der Realität hinterher." },
    { type: "heading",text: "3. Das Add-on bewertet das P&L anhand eines veralteten Kurses" },
    { type: "paragraph",html: "Schon eine kleine Kursverzögerung überträgt sich auf die Gewinn-/Verlustzahl. Deshalb kann derselbe offene Trade im TradingView-Add-on eine Zahl und in Tradovate Trader eine andere zeigen. Das Add-on lügt nicht absichtlich, es bewertet gegen den Kurs, der ihm zuletzt übergeben wurde. Weichen beide voneinander ab, bestimmt die Zahl der Tradovate-Plattform Ihren tatsächlichen Kontostand." },
    { type: "heading",text: "4. Sitzungskonflikte und Ihr TradingView-Tarif" },
    { type: "paragraph",html: "Zwei getrennte Faktoren verstärken die Verzögerung. Erstens Sitzungen: Jeder TradingView-Browser-Tab zählt als eigene Sitzung, und wer Tradovate gleichzeitig im Web, am Desktop, mobil und in mehreren TradingView-Tabs nutzt, kann Konflikte auslösen, die den verbundenen Feed einfrieren oder ausbremsen. Zweitens der Tarif: Kostenlose TradingView-Tarife aktualisieren Daten in einem langsameren Takt als ein kostenpflichtiger Echtzeit-Tarif, sodass ein Teil dessen, was wie &ldquo;Broker-Verzögerung&rdquo; aussieht, tatsächlich daran liegt, dass die TradingView-Seite seltener aktualisiert." },
    { type: "heading",text: "5. Es ist Tradovates Feed, nicht TradingView selbst" },
    { type: "paragraph",html: "Das deutlichste Zeichen, dass das Problem im Broker-Feed und nicht im Front-End liegt, zeigt sich, wenn Sie Broker auf <em>derselben</em> TradingView-Oberfläche vergleichen. Andere Datenfeeds, etwa AMP mit CQG, bleiben schnell und in Echtzeit, während die Tradovate-Verbindung hinterherhinkt. Das deutet klar auf den spezifischen Datenfeed hinter Tradovate hin, weshalb die Verzögerung nur dessen Daten betrifft und alle folgenden Lösungen bei Tradovates eigenem Abonnement und eigener Plattform ansetzen." },
    { type: "heading",text: "Bid/Ask-Verzögerung und P&L-Abweichung beheben: Schritt für Schritt" },
    { type: "heading",text: "Bestätigen Sie zuerst den echten Preis und das P&L bei Tradovate" },
    { type: "paragraph",html: "Bevor Sie irgendeine Einstellung anfassen, machen Sie sich eines zur Gewohnheit: Wenn Add-on und Tradovate voneinander abweichen, glauben Sie Tradovate. Öffnen Sie das Positions- und Orders-Fenster von Tradovate Trader, Web oder Desktop, und lesen Sie dort Ihr offenes P&amp;L und das Live-Bid/Ask ab. Das ist der Feed, gegen den Ihre Orders ausgeführt werden, und damit die Zahl, die Ihr Konto trifft. Schließen Sie eine Position niemals nur aufgrund einer grünen Zahl im Add-on, wenn das Tradovate-Fenster etwas anderes zeigt." },
    { type: "heading",text: "Besorgen Sie sich ein Echtzeit-Marktdatenabonnement auf der Tradovate-Seite" },
    { type: "paragraph",html: "Da TradingView-Datenpakete kein Bid/Ask des Brokers abdecken, muss das Echtzeit-Abonnement bei Tradovate liegen. Bei einem live finanzierten Konto sind das in der Regel die kostenlosen Level-1-CME-Daten Ihres Tarifs, die Sie lediglich aktivieren und deren Vereinbarungen Sie unterzeichnen müssen. Genauer Leistungsumfang und eventuelle Börsengebühren variieren je nach Kontotyp und Börse, prüfen Sie daher Ihren aktuellen Tradovate-Tarif und die Regeln Ihrer Börse, statt Annahmen zu treffen. Sobald Echtzeitdaten aktiv sind, nimmt der orange Symbolname wieder seine normale Farbe an und Bid/Ask laufen nicht mehr mit der Zehn-Minuten-Verzögerung." },
    { type: "heading",text: "Unterzeichnen Sie die Datenvereinbarung und starten Sie Ihre Sitzung neu" },
    { type: "paragraph",html: "Eine sehr häufige Ursache für einen hängenden, verzögerten Feed ist eine nicht unterzeichnete oder nicht aktualisierte Marktdatenvereinbarung. Melden Sie sich direkt bei Tradovate an, nicht über TradingView, öffnen Sie den Bereich für Marktdaten und Abonnements und unterzeichnen bzw. bestätigen Sie die erforderliche Börsendatenvereinbarung erneut. Melden Sie sich vollständig ab und wieder an, damit die Verbindung Ihre Berechtigungen neu einliest, und verbinden Sie TradingView anschließend erneut mit Tradovate. Bei einem Prop-Firm-Evaluierungskonto steuert in der Regel die Firma die Datenberechtigung, nicht Sie, bitten Sie sie also, diese zu aktivieren oder zu aktualisieren." },
    { type: "heading",text: "Nutzen Sie eine einzige Sitzung und prüfen Sie die Echtzeitdaten" },
    { type: "paragraph",html: "Schließen Sie zusätzliche TradingView-Tabs und doppelte Tradovate-Logins, sodass nur eine aktive Sitzung übrig bleibt, und melden Sie sich dann auf dem einen Gerät an, von dem aus Sie handeln. Wenn Sie die Broker-Datenverifizierung von TradingView für Ihr Live-Tradovate-Konto verwenden, schließen Sie diese ab, damit Sie Echtzeitkurse erhalten, ohne doppelt zu zahlen. Hinkt das Add-on nach alldem weiter hinterher, während Tradovates eigene Plattform schnell ist, behandeln Sie es als Feed- oder Front-End-Problem: Handeln und steuern Sie das Risiko über die Tradovate-Plattform und melden Sie die Abweichung mit Zeitstempeln dem Support von Tradovate und TradingView." },
    { type: "heading",text: "Tabelle zur Fehlerbehebung" },
    { type: "table", headers: ["Symptom","Bedeutung","Lösung"], rows: [
      ["Bid/Ask eingefroren, letzter Kurs bewegt sich weiter","Der Kursfeed hinter der Verbindung hinkt hinterher","Bestätigen Sie Live-Kurs/P&L bei Tradovate; steigen Sie nicht anhand des veralteten Spreads aus"],
      ["Symbolname orange dargestellt","Die Daten laufen mit 10 Minuten Verzögerung (kein aktives Abonnement)","Echtzeitdaten bei Tradovate aktivieren; Vereinbarung unterzeichnen; Sitzung neu starten"],
      ["P&L des Add-ons &ne; P&L von Tradovate","Das Add-on bewertet anhand eines veralteten Kurses","Vertrauen Sie dem Positionsfenster von Tradovate als führendem System"],
      ["Auch nach dem Abonnieren verzögert","Datenvereinbarung nicht unterzeichnet oder Berechtigungen nicht aktualisiert","Börsendatenvereinbarung erneut unterzeichnen und bei Tradovate ab- und wieder anmelden"],
      ["Feed stockt bei mehreren geöffneten Tabs","Sitzungskonflikt über Tabs/Geräte hinweg","Nur eine aktive Sitzung auf einem Gerät nutzen"],
      ["Tradovate hinkt hinterher, andere Broker sind auf TradingView schnell","Das Problem betrifft speziell den Tradovate-Feed","Über die Tradovate-Plattform handeln; dem Support mit Zeitstempeln melden"],
    ] },
    { type: "heading",text: "Vermeiden Sie das mit PickMyTrade" },
    { type: "paragraph",html: "Wenn die eigentliche Ursache lautet &ldquo;Ich habe auf Basis eines verzögerten Kurses auf dem Bildschirm entschieden&rdquo;, besteht die dauerhafte Lösung darin, das Augenmaß aus dem Ablauf zu nehmen. PickMyTrade verbindet die Strategie-Alerts Ihrer TradingView-Strategie direkt mit Ihrem Tradovate-Konto, sodass die Ausführung Ihrer Logik folgt und nicht einem verzögerten Spread:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Ausführung auf Broker-Seite</strong>, Orders werden direkt an Ihr Tradovate-Konto geroutet und an Tradovates Live-Matching-Engine ausgeführt, nicht gegen einen Kurs auf dem Chart-Bildschirm.",
        "<strong class='text-white'>Alert-gesteuert statt nach Augenmaß</strong>, Trades werden durch Ihre TradingView-Strategie und Alert-Bedingungen ausgelöst, sodass die Entscheidung &ldquo;Ich sah Grün, es schloss rot&rdquo; aufgrund eines verzögerten Bid/Ask entfällt.",
        "<strong class='text-white'>Serverseitige Zuverlässigkeit</strong>, die Brücke läuft auf gehosteter Infrastruktur, sodass ein eingefrorener lokaler Browser-Tab Ihre Automatisierung nicht mitten im Trade stranden lässt.",
        "<strong class='text-white'>Multi-Account-Synchronisierung</strong>, dasselbe Signal wird auf Ihren Tradovate-Konten gespiegelt, wobei die eigenen Fills des Brokers als einzige Wahrheitsquelle dienen.",
      ],
    },
  ], es: [
    { type: "paragraph",html: "Cuando hace scalping en valores rápidos como ES o NQ mediante el add-on de TradingView para Tradovate, la cifra que le mete en problemas no es el último precio, sino el bid y el ask. En un gráfico conectado, esas dos cotizaciones pueden congelarse durante segundos, y a veces minutos, mientras el último precio negociado sigue avanzando como si nada. El resultado es duro. Una posición abierta marca más 20 puntos de beneficio en el add-on y cierra como una <em>pérdida</em> en el instante en que pulsa el botón. No es un fallo de TradingView que se solucione refrescando, y no es lo mismo que un error de &ldquo;símbolo no negociable&rdquo;. El retraso reside en el feed de datos de mercado detrás de su conexión con Tradovate, y por eso el único P&amp;L en el que debe confiar es el que muestra la propia plataforma de Tradovate." },
    {
      type: "checklist",
      heading: "Lista rápida para bid/ask retrasado y P&L desajustado",
      items: [
        "<strong class='text-white'>Bid/ask congelado mientras el último precio se mueve</strong>, está leyendo una cotización retrasada, así que confirme el precio en vivo directamente en Tradovate antes de actuar.",
        "<strong class='text-white'>Nombre del símbolo en naranja</strong>, es la marca de datos retrasados de Tradovate; no tiene una suscripción activa en tiempo real en ese feed.",
        "<strong class='text-white'>El P&amp;L del add-on no coincide con el P&amp;L de Tradovate</strong>, confíe en el panel de posiciones de Tradovate Trader; el add-on puede valorar su posición con una cotización obsoleta.",
        "<strong class='text-white'>Sin suscripción de datos en el bróker</strong>, los paquetes de datos de TradingView no cubren las cotizaciones bid/ask del bróker, así que la suscripción debe estar en Tradovate.",
        "<strong class='text-white'>Varias sesiones abiertas</strong>, las pestañas y dispositivos adicionales cuentan cada uno como una sesión y pueden detener el feed conectado, así que use solo una.",
        "<strong class='text-white'>Ejecuciones que no coinciden con la pantalla</strong>, su ejecución no está rota; lo que le engaña es la cotización retrasada en pantalla.",
      ],
    },
    { type: "heading",text: "Qué significa realmente “bid/ask retrasado y P&L desajustado”" },
    { type: "paragraph",html: "El add-on de TradingView le permite colocar y gestionar órdenes de Tradovate directamente desde un gráfico de TradingView. Pero TradingView es una interfaz de terceros. Solo recibe los precios ask y bid de su bróker <em>después</em> de que usted inicia sesión en la conexión del bróker, y retransmite lo que ese feed le entrega. La regla es sencilla: si los datos de un símbolo van retrasados en la plataforma del bróker, las cotizaciones ask y bid también irán retrasadas, y los paquetes de datos que compre en TradingView no cubren esas cotizaciones del bróker. Cuando el feed de Tradovate tarda en enviar actualizaciones, el add-on dibuja fielmente un bid y un ask retrasados." },
    { type: "paragraph",html: "Así es como eso arruina silenciosamente el P&amp;L. Su ganancia y pérdida no realizada es función de dónde está el mercado <em>ahora mismo</em> frente a su entrada. Cuando el bid/ask con el que el add-on valora está obsoleto, la cifra de beneficio del gráfico se calcula contra un precio antiguo. El último precio negociado puede parecer actual, pero el spread que realmente cruzaría para salir va por detrás. Así es como el add-on muestra verde mientras el mercado en vivo ya se ha movido en su contra. Es habitual ver varias pantallas de P&amp;L en desacuerdo al mismo tiempo: el gráfico de TradingView conectado, el paper trader no conectado de TradingView, la aplicación de escritorio Tradovate Trader y el panel de resumen de la cuenta pueden mostrar cifras <em>distintas</em>, y el resultado real solo aparece cuando la posición se cierra en los libros de Tradovate." },
    { type: "paragraph",html: "La conclusión no es &ldquo;el add-on es inutilizable&rdquo;. Es que el P&amp;L que muestra el add-on es una marca de conveniencia, no el libro contable. La plataforma de Tradovate es el sistema de registro, y su feed es contra el que se ejecutan realmente sus órdenes." },
    { type: "heading",text: "Principales causas del retraso de bid/ask en el add-on de Tradovate" },
    { type: "heading",text: "1. El feed conectado va por detrás del último precio" },
    { type: "paragraph",html: "El síntoma más común es un bid y un ask que se actualizan mucho más despacio que el último precio. El spread puede ir retrasado segundos, y en periodos de mucha actividad a veces mucho más, mientras la vela y el último precio parecen en vivo. Como su salida cruza el spread, un bid/ask obsoleto significa que el precio al que <em>cree</em> poder salir no es el que el mercado le dará realmente." },
    { type: "heading",text: "2. Está usando datos de mercado retrasados (sin suscripción)" },
    { type: "paragraph",html: "Tradovate retrasa los datos de mercado diez minutos para cualquier nombre de usuario sin una suscripción activa de datos en tiempo real, y lo señala mostrando el <strong class='text-white'>nombre del símbolo en naranja</strong>. Una cuenta de Tradovate con fondos reales incluye datos Level 1 de CME Group gratuitos, pero las cuentas de simulación y algunas configuraciones de evaluación pueden no tener los datos en tiempo real activados por defecto. Si su feed está en el retraso de diez minutos, cada bid/ask, y por tanto cada valoración de P&amp;L, en el add-on va diez minutos por detrás de la realidad." },
    { type: "heading",text: "3. El add-on valora el P&L con una cotización obsoleta" },
    { type: "paragraph",html: "Incluso un pequeño retraso de cotización lo hereda la cifra de ganancias y pérdidas. Por eso puede ver la misma operación abierta con una cifra en el add-on de TradingView y otra distinta en Tradovate Trader. El add-on no miente a propósito, valora contra la última cotización que recibió. Siempre que ambas discrepen, la cifra de la plataforma de Tradovate es la que determina su saldo real." },
    { type: "heading",text: "4. Conflictos de sesión y el nivel de su plan de TradingView" },
    { type: "paragraph",html: "Dos factores independientes agravan el retraso. Primero, las sesiones: cada pestaña del navegador de TradingView cuenta como una sesión propia, y usar Tradovate a la vez en web, escritorio, móvil y varias pestañas de TradingView puede causar conflictos que congelen o detengan el feed conectado. Segundo, el nivel del plan: los planes gratuitos de TradingView actualizan los datos con una cadencia más lenta que un plan de pago en tiempo real, de modo que parte de lo que parece &ldquo;retraso del bróker&rdquo; puede ser en realidad que el lado de TradingView se actualiza con menos frecuencia." },
    { type: "heading",text: "5. Es el feed de Tradovate, no TradingView en sí" },
    { type: "paragraph",html: "La señal más clara de que el problema está en el feed del bróker y no en la interfaz aparece al comparar brókeres en la <em>misma</em> interfaz de TradingView. Otros feeds de datos, AMP con CQG por ejemplo, se mantienen rápidos y en tiempo real mientras la conexión de Tradovate se retrasa. Eso apunta directamente al feed de datos concreto detrás de Tradovate, por lo que el retraso es propio de sus datos y por lo que todas las soluciones siguientes giran en torno a la suscripción y la plataforma de Tradovate." },
    { type: "heading",text: "Cómo corregir el retraso de bid/ask y el desajuste de P&L: paso a paso" },
    { type: "heading",text: "Confirme primero el precio y el P&L reales en Tradovate" },
    { type: "paragraph",html: "Antes de tocar ningún ajuste, adopte este hábito: cuando el add-on y Tradovate discrepen, crea a Tradovate. Abra el panel de posiciones y órdenes de Tradovate Trader, web o escritorio, y lea allí su P&amp;L abierto y el bid/ask en vivo. Ese es el feed contra el que se ejecutan sus órdenes, así que es la cifra que llegará a su cuenta. Nunca cierre una posición basándose solo en una cifra verde del add-on si el panel de Tradovate discrepa." },
    { type: "heading",text: "Obtenga una suscripción de datos de mercado en tiempo real del lado de Tradovate" },
    { type: "paragraph",html: "Como los paquetes de datos de TradingView no cubren el bid/ask del bróker, la suscripción en tiempo real debe estar en Tradovate. En una cuenta con fondos reales suele ser el Level 1 de CME gratuito incluido en su plan; solo necesita tenerlo activado y los acuerdos firmados. Las inclusiones exactas del plan y las posibles tarifas de la bolsa varían según el tipo de cuenta y la bolsa, así que revise su plan actual de Tradovate y las normas de su bolsa en lugar de suponer. Una vez activos los datos en tiempo real, el nombre del símbolo en naranja vuelve a su color normal y el bid/ask deja de ir con el retraso de diez minutos." },
    { type: "heading",text: "Firme el acuerdo de datos y reinicie su sesión" },
    { type: "paragraph",html: "Una causa muy común de un feed retrasado y atascado es un acuerdo de datos de mercado sin firmar o sin actualizar. Inicie sesión directamente en Tradovate, no a través de TradingView, abra el área de datos de mercado y suscripciones, y firme o vuelva a aceptar el acuerdo de datos de la bolsa requerido. Cierre sesión por completo y vuelva a entrar para que la conexión relea sus permisos, y después reconecte TradingView con Tradovate. Si está en una cuenta de evaluación de una prop firm, normalmente es la firma quien controla la autorización de datos, no usted, así que pídale que la active o actualice." },
    { type: "heading",text: "Use una sola sesión y verifique los datos en tiempo real" },
    { type: "paragraph",html: "Cierre las pestañas extra de TradingView y cualquier inicio de sesión duplicado de Tradovate para que quede una sola sesión activa, y vuelva a iniciar sesión en el único dispositivo desde el que operará. Si usa la verificación de datos del bróker de TradingView para su cuenta real de Tradovate, complétela para obtener cotizaciones en tiempo real sin pagar dos veces. Si tras todo esto el add-on sigue retrasado mientras la plataforma propia de Tradovate es rápida, trátelo como un problema de feed o de interfaz: opere y gestione el riesgo desde la plataforma de Tradovate e informe de la discrepancia al soporte de Tradovate y TradingView con marcas de tiempo." },
    { type: "heading",text: "Tabla de solución de problemas" },
    { type: "table", headers: ["Síntoma","Qué significa","Solución"], rows: [
      ["Bid/ask congelado, el último precio sigue moviéndose","El feed de cotizaciones detrás de la conexión va retrasado","Confirme la cotización/P&L en vivo en Tradovate; no salga basándose en el spread obsoleto"],
      ["Nombre del símbolo en naranja","Los datos tienen el retraso de 10 minutos (sin suscripción en vivo)","Active datos en tiempo real en Tradovate; firme el acuerdo; reinicie la sesión"],
      ["P&L del add-on &ne; P&L de Tradovate","El add-on valora con una cotización obsoleta","Confíe en el panel de posiciones de Tradovate como sistema de registro"],
      ["Retrasado incluso tras suscribirse","Acuerdo de datos sin firmar o permisos sin actualizar","Vuelva a firmar el acuerdo de datos de la bolsa y cierre e inicie sesión de nuevo en Tradovate"],
      ["El feed se detiene con varias pestañas abiertas","Conflicto de sesión entre pestañas/dispositivos","Mantenga una única sesión activa en un solo dispositivo"],
      ["Tradovate va retrasado pero otros brókeres son rápidos en TradingView","El problema es específico del feed de Tradovate","Gestione desde la plataforma de Tradovate; informe al soporte con marcas de tiempo"],
    ] },
    { type: "heading",text: "Evítelo con PickMyTrade" },
    { type: "paragraph",html: "Si el problema de fondo es &ldquo;tomé una decisión con una cotización retrasada en pantalla&rdquo;, la solución duradera es sacar el ojo del proceso. PickMyTrade conecta las alertas de su estrategia de TradingView directamente con su cuenta de Tradovate para que la ejecución siga su lógica y no un spread retrasado:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Ejecución del lado del bróker</strong>, las órdenes se enrutan directamente a su cuenta de Tradovate y se ejecutan en el motor de emparejamiento en vivo de Tradovate, no contra una cotización en pantalla del gráfico.",
        "<strong class='text-white'>Guiado por alertas, no por la vista</strong>, las operaciones se activan desde su estrategia de TradingView y sus condiciones de alerta, eliminando la decisión de &ldquo;vi verde, cerró en rojo&rdquo; causada por un bid/ask retrasado.",
        "<strong class='text-white'>Fiabilidad del lado del servidor</strong>, el puente funciona en infraestructura alojada, de modo que una pestaña local del navegador congelada no deja su automatización colgada a mitad de operación.",
        "<strong class='text-white'>Sincronización multicuenta</strong>, la misma señal se replica en sus cuentas de Tradovate, usando las propias ejecuciones del bróker como única fuente de verdad.",
      ],
    },
  ], fr: [
    { type: "paragraph",html: "Lorsque vous scalpez des valeurs rapides comme ES ou NQ via l'add-on TradingView pour Tradovate, ce qui vous met en difficulté n'est pas le dernier prix, mais le bid et l'ask. Sur un graphique connecté, ces deux cotations peuvent se figer pendant plusieurs secondes, parfois plusieurs minutes, tandis que le dernier prix échangé continue de bouger comme si de rien n'était. Le résultat est brutal. Une position ouverte affiche plus 20 points de gain dans l'add-on, puis se clôture en <em>perte</em> à l'instant où vous cliquez. Ce n'est pas un bug de TradingView qu'un rafraîchissement corrigerait, et ce n'est pas la même chose qu'une erreur de &ldquo;symbole non négociable&rdquo;. Le retard se situe dans le flux de données de marché derrière votre connexion Tradovate, et c'est précisément pourquoi le seul P&amp;L auquel vous devez vous fier est celui qu'affiche la plateforme de Tradovate elle-même." },
    {
      type: "checklist",
      heading: "Liste de contrôle rapide pour un bid/ask en retard et un P&L qui ne correspond pas",
      items: [
        "<strong class='text-white'>Bid/ask figés alors que le dernier prix bouge</strong>, vous lisez une cotation en retard : confirmez donc le prix en direct directement sur Tradovate avant d'agir.",
        "<strong class='text-white'>Nom du symbole affiché en orange</strong>, c'est l'indicateur de données différées de Tradovate ; vous n'avez pas d'abonnement temps réel actif sur ce flux.",
        "<strong class='text-white'>Le P&amp;L de l'add-on ne correspond pas au P&amp;L de Tradovate</strong>, fiez-vous au panneau des positions de Tradovate Trader ; l'add-on peut valoriser votre position sur une cotation périmée.",
        "<strong class='text-white'>Aucun abonnement de données côté courtier</strong>, les forfaits de données TradingView ne couvrent pas les cotations bid/ask du courtier ; l'abonnement doit donc être chez Tradovate.",
        "<strong class='text-white'>Plusieurs sessions ouvertes</strong>, les onglets et appareils supplémentaires comptent chacun comme une session et peuvent bloquer le flux connecté ; n'en utilisez donc qu'une.",
        "<strong class='text-white'>Exécutions différentes de l'écran</strong>, votre exécution n'est pas défaillante ; c'est la cotation différée affichée à l'écran qui vous induit en erreur.",
      ],
    },
    { type: "heading",text: "Ce que signifie réellement « bid/ask en retard et P&L qui ne correspond pas »" },
    { type: "paragraph",html: "L'add-on TradingView vous permet de passer et de gérer des ordres Tradovate directement depuis un graphique TradingView. Mais TradingView est une interface tierce. Il ne reçoit les prix ask et bid de votre courtier <em>qu'après</em> votre connexion au courtier, et relaie ce que ce flux lui fournit. La règle est donc simple : si les données d'un symbole sont différées sur la plateforme du courtier, les cotations ask et bid le seront aussi, et les forfaits de données achetés sur TradingView ne couvrent pas ces cotations du courtier. Lorsque le flux Tradovate derrière votre connexion tarde à pousser les mises à jour, l'add-on affiche fidèlement un bid et un ask différés." },
    { type: "paragraph",html: "Voici pourquoi cela fausse discrètement le P&amp;L. Votre gain ou perte latent dépend de l'endroit où se trouve le marché <em>à cet instant</em> par rapport à votre entrée. Lorsque le bid/ask sur lequel l'add-on valorise est périmé, le chiffre de profit du graphique est calculé sur un ancien prix. Le dernier prix échangé peut sembler à jour, mais le spread que vous franchiriez réellement pour sortir est en retard. C'est ainsi que l'add-on affiche du vert alors que le marché en direct a déjà tourné contre vous. Il est fréquent de voir plusieurs affichages de P&amp;L diverger au même moment : le graphique TradingView connecté, le paper trader TradingView non connecté, l'application de bureau Tradovate Trader et le panneau de synthèse du compte peuvent tous afficher des chiffres <em>différents</em>, le résultat réel n'étant connu qu'une fois la position clôturée dans les livres de Tradovate." },
    { type: "paragraph",html: "Il ne faut pas en conclure que &ldquo;l'add-on est inutilisable&rdquo;. Le P&amp;L affiché par l'add-on est une valorisation de confort, pas le registre comptable. La plateforme Tradovate est le système de référence, et c'est son flux qui sert réellement à exécuter vos ordres." },
    { type: "heading",text: "Principales causes du retard bid/ask sur l'add-on Tradovate" },
    { type: "heading",text: "1. Le flux connecté est en retard sur le dernier prix" },
    { type: "paragraph",html: "Le symptôme le plus courant est un bid et un ask qui se mettent à jour bien plus lentement que le dernier prix. Le spread peut avoir plusieurs secondes de retard, et parfois bien davantage pendant les périodes chargées, alors que la bougie et le dernier prix paraissent en direct. Comme votre sortie franchit le spread, un bid/ask périmé signifie que le prix auquel vous <em>pensez</em> pouvoir sortir n'est pas celui que le marché vous donnera réellement." },
    { type: "heading",text: "2. Vous êtes sur des données de marché différées (sans abonnement)" },
    { type: "paragraph",html: "Tradovate retarde les données de marché de dix minutes pour tout nom d'utilisateur sans abonnement actif aux données en temps réel, et le signale en affichant le <strong class='text-white'>nom du symbole en orange</strong>. Un compte Tradovate financé en réel inclut gratuitement les données Level 1 du CME Group, mais les comptes de simulation et certaines configurations d'évaluation peuvent ne pas avoir les données en temps réel activées par défaut. Si votre flux est sur le délai de dix minutes, chaque bid/ask, et donc chaque valorisation du P&amp;L, de l'add-on a dix minutes de retard sur la réalité." },
    { type: "heading",text: "3. L'add-on valorise le P&L sur une cotation périmée" },
    { type: "paragraph",html: "Même un léger retard de cotation se répercute sur le chiffre de gains et pertes. C'est pourquoi vous pouvez voir un même trade ouvert afficher un chiffre dans l'add-on TradingView et un autre dans Tradovate Trader. L'add-on ne ment pas volontairement, il valorise sur la dernière cotation reçue. Chaque fois que les deux divergent, c'est le chiffre de la plateforme Tradovate qui détermine votre solde réel." },
    { type: "heading",text: "4. Conflits de session et niveau de votre forfait TradingView" },
    { type: "paragraph",html: "Deux facteurs distincts aggravent le retard. D'abord, les sessions : chaque onglet de navigateur TradingView compte comme une session distincte, et utiliser Tradovate simultanément sur le web, le bureau, le mobile et plusieurs onglets TradingView peut provoquer des conflits qui figent ou bloquent le flux connecté. Ensuite, le niveau de forfait : les forfaits TradingView gratuits actualisent les données à une cadence plus lente qu'un forfait temps réel payant, si bien qu'une partie de ce qui ressemble à un &ldquo;retard du courtier&rdquo; peut en réalité venir d'une actualisation moins fréquente côté TradingView." },
    { type: "heading",text: "5. C'est le flux de Tradovate, pas TradingView lui-même" },
    { type: "paragraph",html: "Le signe le plus net que le problème vient du flux du courtier et non de l'interface apparaît lorsque vous comparez des courtiers sur la <em>même</em> interface TradingView. D'autres flux de données, AMP avec CQG par exemple, restent rapides et en temps réel alors que la connexion Tradovate prend du retard. Cela désigne clairement le flux de données propre à Tradovate, ce qui explique que le retard soit spécifique à ses données et que toutes les solutions ci-dessous s'articulent autour de l'abonnement et de la plateforme de Tradovate." },
    { type: "heading",text: "Corriger le retard bid/ask et l'écart de P&L : étape par étape" },
    { type: "heading",text: "Confirmez d'abord le vrai prix et le P&L sur Tradovate" },
    { type: "paragraph",html: "Avant de toucher le moindre réglage, prenez cette habitude : lorsque l'add-on et Tradovate divergent, croyez Tradovate. Ouvrez le panneau des positions et ordres de Tradovate Trader, web ou bureau, et lisez-y votre P&amp;L ouvert et le bid/ask en direct. C'est le flux sur lequel vos ordres sont exécutés, donc le chiffre qui touchera votre compte. Ne clôturez jamais une position uniquement sur un chiffre vert de l'add-on si le panneau Tradovate dit le contraire." },
    { type: "heading",text: "Obtenez un abonnement aux données de marché en temps réel côté Tradovate" },
    { type: "paragraph",html: "Comme les forfaits de données TradingView ne couvrent pas le bid/ask du courtier, l'abonnement temps réel doit se trouver chez Tradovate. Sur un compte financé en réel, il s'agit généralement des données Level 1 du CME gratuites incluses dans votre offre ; il suffit de les activer et de signer les accords. Les inclusions exactes de l'offre et les éventuels frais de bourse varient selon le type de compte et la bourse ; vérifiez donc votre offre Tradovate actuelle et les règles de votre bourse plutôt que de supposer. Une fois les données en temps réel actives, le nom du symbole orange retrouve sa couleur normale et le bid/ask n'est plus soumis au délai de dix minutes." },
    { type: "heading",text: "Signez l'accord de données et redémarrez votre session" },
    { type: "paragraph",html: "Une cause très fréquente d'un flux différé bloqué est un accord de données de marché non signé ou non actualisé. Connectez-vous directement à Tradovate, et non via TradingView, ouvrez la zone des données de marché et abonnements, puis signez ou acceptez à nouveau l'accord de données de la bourse requis. Déconnectez-vous complètement puis reconnectez-vous afin que la connexion relise vos autorisations, puis reconnectez TradingView à Tradovate. Si vous êtes sur un compte d'évaluation de prop firm, c'est généralement la firme qui gère l'autorisation des données, pas vous ; demandez-lui donc de l'activer ou de l'actualiser." },
    { type: "heading",text: "Utilisez une seule session et vérifiez les données en temps réel" },
    { type: "paragraph",html: "Fermez les onglets TradingView supplémentaires et toute connexion Tradovate en double afin qu'il ne reste qu'une seule session active, puis reconnectez-vous sur l'unique appareil depuis lequel vous tradez. Si vous utilisez la vérification des données du courtier de TradingView pour votre compte Tradovate réel, effectuez-la pour obtenir des cotations en temps réel sans payer deux fois. Si l'add-on reste en retard après tout cela alors que la plateforme de Tradovate est rapide, traitez-le comme un problème de flux ou d'interface : tradez et gérez le risque depuis la plateforme Tradovate, et signalez l'écart aux supports de Tradovate et de TradingView avec des horodatages." },
    { type: "heading",text: "Tableau de dépannage" },
    { type: "table", headers: ["Symptôme","Signification","Solution"], rows: [
      ["Bid/ask figés, le dernier prix bouge toujours","Le flux de cotations derrière la connexion est en retard","Confirmez la cotation/le P&L en direct sur Tradovate ; ne sortez pas sur le spread périmé"],
      ["Nom du symbole affiché en orange","Les données sont différées de 10 minutes (pas d'abonnement en direct)","Activez les données en temps réel sur Tradovate ; signez l'accord ; redémarrez la session"],
      ["P&L de l'add-on &ne; P&L de Tradovate","L'add-on valorise sur une cotation périmée","Fiez-vous au panneau des positions de Tradovate comme système de référence"],
      ["Toujours en retard après abonnement","Accord de données non signé ou autorisations non actualisées","Resignez l'accord de données de la bourse et déconnectez-vous puis reconnectez-vous sur Tradovate"],
      ["Le flux se bloque avec plusieurs onglets ouverts","Conflit de session entre onglets/appareils","Utilisez une seule session active sur un seul appareil"],
      ["Tradovate est en retard mais les autres courtiers sont rapides sur TradingView","Le problème est propre au flux de Tradovate","Gérez depuis la plateforme Tradovate ; signalez au support avec des horodatages"],
    ] },
    { type: "heading",text: "Évitez ce problème avec PickMyTrade" },
    { type: "paragraph",html: "Si le problème de fond est &ldquo;j'ai pris une décision sur une cotation en retard à l'écran&rdquo;, la solution durable consiste à retirer l'œil de la boucle. PickMyTrade relie directement les alertes de votre stratégie TradingView à votre compte Tradovate afin que l'exécution suive votre logique, et non un spread en retard :" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Exécution côté courtier</strong>, les ordres sont routés directement vers votre compte Tradovate et exécutés sur le moteur d'appariement en direct de Tradovate, et non sur une cotation affichée à l'écran du graphique.",
        "<strong class='text-white'>Piloté par alertes, pas à l'œil</strong>, les trades se déclenchent depuis votre stratégie TradingView et vos conditions d'alerte, supprimant la décision du type &ldquo;j'ai vu du vert, ça s'est clôturé en rouge&rdquo; causée par un bid/ask en retard.",
        "<strong class='text-white'>Fiabilité côté serveur</strong>, le pont tourne sur une infrastructure hébergée, de sorte qu'un onglet de navigateur local figé ne laisse pas votre automatisation en plan en plein trade.",
        "<strong class='text-white'>Synchronisation multi-comptes</strong>, le même signal est répliqué sur vos comptes Tradovate, en utilisant les exécutions propres du courtier comme source de vérité unique.",
      ],
    },
  ], it: [
    { type: "paragraph",html: "Quando fa scalping su strumenti veloci come ES o NQ tramite l'add-on TradingView per Tradovate, il numero che la mette nei guai non è l'ultimo prezzo, ma il bid e l'ask. Su un grafico collegato, queste due quotazioni possono bloccarsi per secondi, a volte per minuti, mentre l'ultimo prezzo scambiato continua a muoversi come se nulla fosse. Il risultato è brutale. Una posizione aperta mostra più 20 punti di profitto nell'add-on e poi chiude in <em>perdita</em> nel momento in cui preme il pulsante. Non è un bug di TradingView risolvibile con un aggiornamento, e non è la stessa cosa di un errore di &ldquo;simbolo non negoziabile&rdquo;. Il ritardo risiede nel feed dei dati di mercato dietro la sua connessione Tradovate, ed è esattamente per questo che l'unico P&amp;L di cui fidarsi è quello mostrato dalla piattaforma di Tradovate stessa." },
    {
      type: "checklist",
      heading: "Checklist rapida per bid/ask in ritardo e P&L non allineato",
      items: [
        "<strong class='text-white'>Bid/ask bloccati mentre l'ultimo prezzo si muove</strong>, sta leggendo una quotazione in ritardo, quindi confermi il prezzo reale direttamente su Tradovate prima di agire.",
        "<strong class='text-white'>Nome del simbolo in arancione</strong>, è l'indicatore di dati ritardati di Tradovate; non ha un abbonamento in tempo reale attivo su quel feed.",
        "<strong class='text-white'>Il P&amp;L dell'add-on non corrisponde al P&amp;L di Tradovate</strong>, si fidi del pannello posizioni di Tradovate Trader; l'add-on può valutare la sua posizione su una quotazione obsoleta.",
        "<strong class='text-white'>Nessun abbonamento dati lato broker</strong>, i pacchetti dati TradingView non coprono le quotazioni bid/ask del broker, quindi l'abbonamento deve essere su Tradovate.",
        "<strong class='text-white'>Più sessioni aperte</strong>, schede del browser e dispositivi aggiuntivi contano ciascuno come una sessione e possono bloccare il feed collegato, quindi ne usi una sola.",
        "<strong class='text-white'>Esecuzioni diverse dallo schermo</strong>, la sua esecuzione non è guasta; a trarla in inganno è la quotazione ritardata sullo schermo.",
      ],
    },
    { type: "heading",text: "Che cosa significa davvero “bid/ask in ritardo e P&L non allineato”" },
    { type: "paragraph",html: "L'add-on TradingView le permette di inserire e gestire ordini Tradovate direttamente da un grafico TradingView. Ma TradingView è un front-end di terze parti. Riceve i prezzi ask e bid dal suo broker solo <em>dopo</em> che lei ha effettuato l'accesso alla connessione del broker, e ritrasmette ciò che quel feed gli consegna. La regola è quindi semplice: se i dati di un simbolo sono ritardati sulla piattaforma del broker, anche le quotazioni ask e bid saranno ritardate, e i pacchetti dati acquistati su TradingView non coprono quelle quotazioni del broker. Quando il feed Tradovate dietro la sua connessione è lento nell'inviare aggiornamenti, l'add-on disegna fedelmente un bid e un ask ritardati." },
    { type: "paragraph",html: "Ecco perché questo rovina silenziosamente il P&amp;L. Il suo profitto e perdita non realizzati dipendono da dove si trova il mercato <em>in questo momento</em> rispetto al suo ingresso. Quando il bid/ask su cui l'add-on valuta è obsoleto, il profitto mostrato sul grafico viene calcolato su un prezzo vecchio. L'ultimo prezzo scambiato può sembrare aggiornato, ma lo spread che attraverserebbe realmente per uscire è indietro. È così che l'add-on mostra verde mentre il mercato reale si è già mosso contro di lei. È comune vedere più visualizzazioni del P&amp;L in disaccordo nello stesso momento: il grafico TradingView collegato, il paper trader non collegato di TradingView, l'app desktop Tradovate Trader e il pannello di riepilogo del conto possono mostrare numeri <em>diversi</em>, e il risultato reale si definisce solo quando la posizione viene chiusa nei libri di Tradovate." },
    { type: "paragraph",html: "La conclusione non è &ldquo;l'add-on è inutilizzabile&rdquo;. È che il P&amp;L mostrato dall'add-on è una valutazione di comodo, non il registro contabile. La piattaforma Tradovate è il sistema di riferimento, e il suo feed è quello su cui i suoi ordini vengono realmente eseguiti." },
    { type: "heading",text: "Cause principali del ritardo bid/ask nell'add-on Tradovate" },
    { type: "heading",text: "1. Il feed collegato è in ritardo rispetto all'ultimo prezzo" },
    { type: "paragraph",html: "Il sintomo più comune è un bid e un ask che si aggiornano molto più lentamente dell'ultimo prezzo. Lo spread può rimanere indietro di secondi, e occasionalmente molto di più nei periodi di intensa attività, mentre la candela e l'ultimo prezzo sembrano in tempo reale. Poiché la sua uscita attraversa lo spread, un bid/ask obsoleto significa che il prezzo a cui <em>pensa</em> di poter uscire non è quello che il mercato le darà davvero." },
    { type: "heading",text: "2. Sta usando dati di mercato ritardati (senza abbonamento)" },
    { type: "paragraph",html: "Tradovate ritarda i dati di mercato di dieci minuti per qualsiasi nome utente senza un abbonamento attivo ai dati in tempo reale, e lo segnala mostrando il <strong class='text-white'>nome del simbolo in arancione</strong>. Un conto Tradovate con fondi reali include gratuitamente i dati Level 1 di CME Group, ma i conti di simulazione e alcune configurazioni di valutazione potrebbero non avere i dati in tempo reale attivi per impostazione predefinita. Se il suo feed è sul ritardo di dieci minuti, ogni bid/ask, e quindi ogni valutazione del P&amp;L, nell'add-on è indietro di dieci minuti rispetto alla realtà." },
    { type: "heading",text: "3. L'add-on valuta il P&L su una quotazione obsoleta" },
    { type: "paragraph",html: "Anche un piccolo ritardo della quotazione viene ereditato dal dato di profitto/perdita. Ecco perché può vedere lo stesso trade aperto mostrare un numero nell'add-on TradingView e uno diverso in Tradovate Trader. L'add-on non mente di proposito, valuta sulla quotazione che gli è stata consegnata per ultima. Ogni volta che i due non coincidono, è il numero della piattaforma Tradovate a determinare il suo saldo effettivo." },
    { type: "heading",text: "4. Conflitti di sessione e livello del suo piano TradingView" },
    { type: "paragraph",html: "Due fattori distinti aggravano il ritardo. Primo, le sessioni: ogni scheda del browser di TradingView conta come una sessione a sé, e usare Tradovate contemporaneamente su web, desktop, mobile e più schede TradingView può causare conflitti che bloccano o rallentano il feed collegato. Secondo, il livello del piano: i piani TradingView gratuiti aggiornano i dati con una cadenza più lenta di un piano a pagamento in tempo reale, quindi parte di ciò che sembra un &ldquo;ritardo del broker&rdquo; può in realtà dipendere dal lato TradingView che si aggiorna meno spesso." },
    { type: "heading",text: "5. È il feed di Tradovate, non TradingView in sé" },
    { type: "paragraph",html: "Il segnale più chiaro che il problema è nel feed del broker e non nel front-end emerge quando si confrontano i broker sulla <em>stessa</em> interfaccia TradingView. Altri feed dati, AMP con CQG per esempio, restano veloci e in tempo reale mentre la connessione Tradovate è in ritardo. Questo indica chiaramente lo specifico feed dati dietro Tradovate, ed è per questo che il ritardo è specifico dei suoi dati e che tutte le soluzioni seguenti ruotano attorno all'abbonamento e alla piattaforma di Tradovate." },
    { type: "heading",text: "Come risolvere il ritardo bid/ask e lo sfasamento del P&L: passo dopo passo" },
    { type: "heading",text: "Confermi prima il prezzo e il P&L reali su Tradovate" },
    { type: "paragraph",html: "Prima di toccare qualsiasi impostazione, faccia di questo un'abitudine: quando l'add-on e Tradovate non concordano, creda a Tradovate. Apra il pannello posizioni e ordini di Tradovate Trader, web o desktop, e legga lì il suo P&amp;L aperto e il bid/ask in tempo reale. È il feed su cui vengono eseguiti i suoi ordini, quindi è il numero che inciderà sul suo conto. Non chiuda mai una posizione basandosi solo su una cifra verde dell'add-on se il pannello Tradovate dice altro." },
    { type: "heading",text: "Ottenga un abbonamento ai dati di mercato in tempo reale dal lato Tradovate" },
    { type: "paragraph",html: "Poiché i pacchetti dati TradingView non coprono il bid/ask del broker, l'abbonamento in tempo reale deve essere su Tradovate. Su un conto con fondi reali di solito sono i dati Level 1 CME gratuiti inclusi nel suo piano; deve solo attivarli e firmare gli accordi. Le inclusioni esatte del piano e le eventuali commissioni di borsa variano in base al tipo di conto e alla borsa, quindi verifichi il suo piano Tradovate attuale e le regole della borsa anziché dare per scontato. Una volta attivi i dati in tempo reale, il nome del simbolo arancione torna al suo colore normale e il bid/ask smette di viaggiare con il ritardo di dieci minuti." },
    { type: "heading",text: "Firmi l'accordo sui dati e riavvii la sessione" },
    { type: "paragraph",html: "Una causa molto comune di un feed ritardato bloccato è un accordo sui dati di mercato non firmato o non aggiornato. Acceda direttamente a Tradovate, non tramite TradingView, apra l'area dei dati di mercato e degli abbonamenti, quindi firmi o riaccetti l'accordo sui dati di borsa richiesto. Esca completamente e rientri affinché la connessione rilegga le sue autorizzazioni, poi ricolleghi TradingView a Tradovate. Se ha un conto di valutazione di una prop firm, di solito è la società a controllare l'autorizzazione ai dati, non lei, quindi le chieda di abilitarla o aggiornarla." },
    { type: "heading",text: "Usi una sola sessione e verifichi i dati in tempo reale" },
    { type: "paragraph",html: "Chiuda le schede TradingView in più e gli accessi duplicati a Tradovate in modo che resti una sola sessione attiva, poi acceda di nuovo dal singolo dispositivo da cui opererà. Se usa la verifica dati del broker di TradingView per il suo conto Tradovate reale, la completi per ottenere quotazioni in tempo reale senza pagare due volte. Se dopo tutto questo l'add-on resta in ritardo mentre la piattaforma di Tradovate è veloce, lo tratti come un problema di feed o di front-end: operi e gestisca il rischio dalla piattaforma Tradovate e segnali la discrepanza al supporto di Tradovate e TradingView con gli orari." },
    { type: "heading",text: "Tabella di risoluzione dei problemi" },
    { type: "table", headers: ["Sintomo","Cosa significa","Soluzione"], rows: [
      ["Bid/ask bloccati, l'ultimo prezzo si muove ancora","Il feed delle quotazioni dietro la connessione è in ritardo","Confermi quotazione/P&L reali su Tradovate; non esca in base allo spread obsoleto"],
      ["Nome del simbolo in arancione","I dati sono con ritardo di 10 minuti (nessun abbonamento in tempo reale)","Abiliti i dati in tempo reale su Tradovate; firmi l'accordo; riavvii la sessione"],
      ["P&L dell'add-on &ne; P&L di Tradovate","L'add-on valuta su una quotazione obsoleta","Si fidi del pannello posizioni di Tradovate come sistema di riferimento"],
      ["Ritardo anche dopo l'abbonamento","Accordo sui dati non firmato o autorizzazioni non aggiornate","Firmi di nuovo l'accordo sui dati di borsa e esca e rientri su Tradovate"],
      ["Il feed si blocca con più schede aperte","Conflitto di sessione tra schede/dispositivi","Usi una sola sessione attiva su un solo dispositivo"],
      ["Tradovate è in ritardo ma gli altri broker sono veloci su TradingView","Il problema è specifico del feed di Tradovate","Gestisca dalla piattaforma Tradovate; segnali al supporto con gli orari"],
    ] },
    { type: "heading",text: "Lo eviti con PickMyTrade" },
    { type: "paragraph",html: "Se il problema di fondo è &ldquo;ho deciso sulla base di una quotazione in ritardo sullo schermo&rdquo;, la soluzione duratura è togliere l'occhio dal ciclo. PickMyTrade collega gli alert della sua strategia TradingView direttamente al suo conto Tradovate, così l'esecuzione segue la sua logica e non uno spread in ritardo:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Esecuzione lato broker</strong>, gli ordini vengono instradati direttamente al suo conto Tradovate ed eseguiti sul motore di matching in tempo reale di Tradovate, non rispetto a una quotazione sullo schermo del grafico.",
        "<strong class='text-white'>Guidato dagli alert, non a occhio</strong>, i trade vengono attivati dalla sua strategia TradingView e dalle condizioni degli alert, eliminando la decisione del tipo &ldquo;ho visto verde, ha chiuso in rosso&rdquo; causata da un bid/ask in ritardo.",
        "<strong class='text-white'>Affidabilità lato server</strong>, il bridge gira su un'infrastruttura ospitata, così una scheda locale del browser bloccata non lascia la sua automazione a metà trade.",
        "<strong class='text-white'>Sincronizzazione multi-conto</strong>, lo stesso segnale viene replicato sui suoi conti Tradovate, usando le esecuzioni del broker come unica fonte di verità.",
      ],
    },
  ] },
  ctaHeading: { en: "Trade on Fills, Not a Lagging Quote", de: "Handeln Sie auf Basis von Fills, nicht eines verzögerten Kurses", es: "Opere con ejecuciones, no con una cotización retrasada", fr: "Tradez sur les exécutions, pas sur une cotation en retard", it: "Operi sulle esecuzioni, non su una quotazione in ritardo" },
  ctaText: { en: "Start your free 7-day trial, link alerts today and let your Tradovate fills, not a lagging quote, drive every trade.", de: "Starten Sie Ihre kostenlose 7-Tage-Testphase, verknüpfen Sie noch heute Ihre Alerts und lassen Sie Ihre Tradovate-Fills statt eines verzögerten Kurses jeden Trade steuern.", es: "Comience su prueba gratuita de 7 días, vincule sus alertas hoy mismo y deje que las ejecuciones de Tradovate, y no una cotización retrasada, guíen cada operación.", fr: "Commencez votre essai gratuit de 7 jours, reliez vos alertes dès aujourd'hui et laissez vos exécutions Tradovate, et non une cotation en retard, piloter chaque trade.", it: "Inizi la prova gratuita di 7 giorni, colleghi i suoi alert oggi stesso e lasci che siano le esecuzioni di Tradovate, non una quotazione in ritardo, a guidare ogni trade." },
  ctaButtonText: { en: "Start Your Free 7-Day Trial", de: "Starten Sie Ihre kostenlose 7-Tage-Testphase", es: "Comience su prueba gratuita de 7 días", fr: "Commencez votre essai gratuit de 7 jours", it: "Inizi la prova gratuita di 7 giorni" },
  ctaUrl: "https://app.pickmytrade.trade/?register=true&utm_source=content&utm_medium=debugging",
  faqHeading: { en: "Frequently Asked Questions", de: "Häufig gestellte Fragen", es: "Preguntas frecuentes", fr: "Questions fréquentes", it: "Domande frequenti" },
  faqs: { en: [
    { q: "Why does the TradingView add-on show a different P&L than Tradovate?", a: "The add-on marks your open profit and loss against the last bid/ask it received. When that quote is lagging, your P&L is calculated against an old price, so it can drift away from Tradovate's number. Tradovate's platform is the system of record, so believe its figure." },
    { q: "My last price looks live but the bid/ask is stuck. Is that possible?", a: "Yes, and it's the classic symptom. The last-traded price can keep updating while the bid and ask lag behind. Because you cross the spread to exit, a stale bid/ask can make a losing position look profitable." },
    { q: "Will buying a TradingView data package fix the delayed quotes?", a: "No. Data packages purchased on TradingView don't cover broker bid/ask quotes. The real-time subscription has to live on the broker side, which in this case means Tradovate." },
    { q: "What does the orange symbol name mean?", a: "Orange is Tradovate's way of telling you the data is delayed. Without a live real-time data subscription, Tradovate holds market data back by ten minutes. Enable real-time data and sign the exchange agreement to switch the feed to live." },
    { q: "Is the delay TradingView's fault or Tradovate's?", a: "The evidence points to the Tradovate data feed. On the same TradingView interface, other brokers' feeds such as CQG stay fast and real-time while the Tradovate connection lags, so the delay is specific to Tradovate's data." },
    { q: "I'm on a prop-firm evaluation account and my data is delayed. What do I do?", a: "On evaluation accounts the prop firm usually controls the market-data entitlement, not you. Contact the firm to enable or refresh real-time data. You often can't self-subscribe through Tradovate on those accounts." },
    { q: "How do I stop the feed from freezing when I have several tabs open?", a: "Each TradingView tab and each Tradovate login counts as its own session, and running many at once can cause conflicts. Log out everywhere, then sign back in on a single device and one tab." },
    { q: "Should I ever exit a trade based on the add-on's P&L number?", a: "Not when it disagrees with Tradovate. Use the add-on for convenience, but confirm the live quote and P&L on the Tradovate platform before you close, especially in fast markets." },
  ], de: [
    { q: "Warum zeigt das TradingView-Add-on ein anderes P&L als Tradovate an?", a: "Das Add-on bewertet Ihren offenen Gewinn und Verlust anhand des zuletzt empfangenen Bid/Ask. Hinkt dieser Kurs hinterher, wird Ihr P&L gegen einen veralteten Preis berechnet und kann deshalb von Tradovates Zahl abweichen. Die Tradovate-Plattform ist das führende System, vertrauen Sie also deren Wert." },
    { q: "Mein letzter Kurs wirkt live, aber Bid/Ask hängen fest. Ist das möglich?", a: "Ja, und es ist das klassische Symptom. Der zuletzt gehandelte Kurs kann sich weiter aktualisieren, während Bid und Ask hinterherhinken. Da Sie zum Ausstieg den Spread überqueren, kann ein veraltetes Bid/Ask eine Verlustposition profitabel aussehen lassen." },
    { q: "Behebt der Kauf eines TradingView-Datenpakets die verzögerten Kurse?", a: "Nein. Auf TradingView erworbene Datenpakete decken keine Bid/Ask-Kurse des Brokers ab. Das Echtzeit-Abonnement muss auf der Broker-Seite liegen, in diesem Fall also bei Tradovate." },
    { q: "Was bedeutet der orange Symbolname?", a: "Orange ist Tradovates Hinweis, dass die Daten verzögert sind. Ohne ein aktives Echtzeit-Datenabonnement hält Tradovate die Marktdaten zehn Minuten zurück. Aktivieren Sie Echtzeitdaten und unterzeichnen Sie die Börsenvereinbarung, um den Feed auf Live umzustellen." },
    { q: "Liegt die Verzögerung an TradingView oder an Tradovate?", a: "Die Indizien sprechen für den Tradovate-Datenfeed. Auf derselben TradingView-Oberfläche bleiben die Feeds anderer Broker wie CQG schnell und in Echtzeit, während die Tradovate-Verbindung hinterherhinkt. Die Verzögerung betrifft also speziell Tradovates Daten." },
    { q: "Ich nutze ein Prop-Firm-Evaluierungskonto und meine Daten sind verzögert. Was tun?", a: "Bei Evaluierungskonten steuert in der Regel die Prop Firm die Marktdaten-Berechtigung, nicht Sie. Wenden Sie sich an die Firma, damit sie Echtzeitdaten aktiviert oder erneuert. Oft können Sie bei solchen Konten nicht selbst über Tradovate abonnieren." },
    { q: "Wie verhindere ich, dass der Feed bei mehreren geöffneten Tabs einfriert?", a: "Jeder TradingView-Tab und jeder Tradovate-Login zählt als eigene Sitzung, und viele gleichzeitige Sitzungen können Konflikte verursachen. Melden Sie sich überall ab und dann nur auf einem Gerät und in einem Tab wieder an." },
    { q: "Sollte ich je anhand der P&L-Zahl des Add-ons aussteigen?", a: "Nicht, wenn sie von Tradovate abweicht. Nutzen Sie das Add-on zur Bequemlichkeit, bestätigen Sie aber vor dem Schließen den Live-Kurs und das P&L auf der Tradovate-Plattform, besonders in schnellen Märkten." },
  ], es: [
    { q: "¿Por qué el add-on de TradingView muestra un P&L distinto al de Tradovate?", a: "El add-on valora su ganancia y pérdida abierta con el último bid/ask que recibió. Cuando esa cotización va retrasada, su P&L se calcula contra un precio antiguo y puede alejarse de la cifra de Tradovate. La plataforma de Tradovate es el sistema de registro, así que crea en su cifra." },
    { q: "Mi último precio parece en vivo pero el bid/ask está atascado. ¿Es posible?", a: "Sí, y es el síntoma clásico. El último precio negociado puede seguir actualizándose mientras el bid y el ask se quedan atrás. Como usted cruza el spread para salir, un bid/ask obsoleto puede hacer que una posición perdedora parezca rentable." },
    { q: "¿Comprar un paquete de datos de TradingView soluciona las cotizaciones retrasadas?", a: "No. Los paquetes de datos comprados en TradingView no cubren las cotizaciones bid/ask del bróker. La suscripción en tiempo real debe estar del lado del bróker, que en este caso es Tradovate." },
    { q: "¿Qué significa el nombre del símbolo en naranja?", a: "El naranja es la forma en que Tradovate indica que los datos están retrasados. Sin una suscripción activa de datos en tiempo real, Tradovate retiene los datos de mercado diez minutos. Active los datos en tiempo real y firme el acuerdo con la bolsa para pasar el feed a en vivo." },
    { q: "¿El retraso es culpa de TradingView o de Tradovate?", a: "Las pruebas apuntan al feed de datos de Tradovate. En la misma interfaz de TradingView, los feeds de otros brókeres como CQG se mantienen rápidos y en tiempo real mientras la conexión de Tradovate se retrasa, por lo que el retraso es propio de los datos de Tradovate." },
    { q: "Estoy en una cuenta de evaluación de una prop firm y mis datos van retrasados. ¿Qué hago?", a: "En las cuentas de evaluación, normalmente es la prop firm quien controla la autorización de datos de mercado, no usted. Contacte con la firma para que active o actualice los datos en tiempo real. A menudo no puede suscribirse por su cuenta a través de Tradovate en esas cuentas." },
    { q: "¿Cómo evito que el feed se congele cuando tengo varias pestañas abiertas?", a: "Cada pestaña de TradingView y cada inicio de sesión de Tradovate cuenta como una sesión propia, y ejecutar muchas a la vez puede causar conflictos. Cierre sesión en todas partes y vuelva a iniciarla en un solo dispositivo y una sola pestaña." },
    { q: "¿Debería salir alguna vez de una operación basándome en el P&L del add-on?", a: "No cuando no coincida con Tradovate. Use el add-on por comodidad, pero confirme la cotización en vivo y el P&L en la plataforma de Tradovate antes de cerrar, sobre todo en mercados rápidos." },
