---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "prop-eval-use-demo-not-live";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/debugging/${SLUG}`;

const META_TITLE = "Tradovate Eval Login: Use Demo, Not Live";
const META_DESCRIPTION =
  "Tradovate eval login failing? Pick the Demo/Simulation environment, not Live, so your prop evaluation account connects without invalid-credential errors.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Tradovate-Eval-Login: Demo verwenden, nicht Live", es: "Inicio de sesión de evaluación en Tradovate: use Demo, no Live", fr: "Connexion Tradovate Eval : utilisez Demo, pas Live", it: "Login Tradovate Eval: usi Demo, non Live" },
  dek: { en: "Tradovate throws back a blunt 'Invalid credentials' even though what you typed is exactly right. Nine times out of ten the password isn't the problem, the environment is.", de: "Tradovate wirft ein knappes „Invalid credentials“ zurück, obwohl Ihre Eingabe exakt stimmt. In neun von zehn Fällen liegt es nicht am Passwort, sondern an der Umgebung.", es: "Tradovate le devuelve un seco «Invalid credentials» aunque lo que escribió sea exactamente correcto. Nueve de cada diez veces el problema no es la contraseña, sino el entorno.", fr: "Tradovate vous renvoie un sec « Invalid credentials » alors que ce que vous avez saisi est exactement correct. Neuf fois sur dix, ce n'est pas le mot de passe le problème, c'est l'environnement.", it: "Tradovate Le restituisce un secco «Invalid credentials» anche se ciò che ha digitato è esattamente corretto. Nove volte su dieci il problema non è la password, ma l'ambiente." },
  readTime: { en: "7 min read", de: "7 Min. Lesezeit", es: "Lectura de 7 min", fr: "Lecture : 7 min", it: "Lettura di 7 min" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "You copy the username and password straight off your prop firm dashboard, hit log in, and Tradovate throws back a blunt <strong class='text-white'>“Invalid credentials,”</strong> even though what you typed is exactly right. Nine times out of ten the password isn't the problem. The environment is. Every prop firm evaluation and every simulated-funded account lives on Tradovate's <strong class='text-white'>simulation</strong> engine, so you have to sign in through the <strong class='text-white'>Demo / Simulation</strong> environment, never <strong class='text-white'>Live</strong>. Choose Live and Tradovate goes hunting for your login in the real-brokerage system, where a prop evaluation account simply doesn't exist. So it rejects you, or worse, tries to nudge you into opening a personal live brokerage account instead. Here's why this demo-vs-live trap catches so many traders, the exact error variants you'll run into, and how to land on the right environment the first time, the same discipline that keeps automation like PickMyTrade routing your alerts to the account you actually meant." },
    {
      type: "checklist",
      heading: "Quick Checklist for Tradovate Eval Login Errors",
      items: [
        "<strong class='text-white'>Choose Demo / Simulation, not Live</strong>, evaluation and simulated-funded accounts only exist on Tradovate's simulation engine.",
        "<strong class='text-white'>Use the credentials from your prop dashboard</strong>, they're different from any personal Tradovate login you might have.",
        "<strong class='text-white'>Picked Live by mistake? Log out and reselect</strong>, sign out fully, then choose Simulation before you re-enter anything.",
        "<strong class='text-white'>On TradingView, pick the Demo tab</strong>, prop accounts connect as Demo; Live is only for personal Tradovate brokerage accounts.",
        "<strong class='text-white'>Watch for a dropped leading capital</strong>, pasted passwords sometimes get their first character auto-lowercased.",
        "<strong class='text-white'>Still blocked? Contact your prop firm</strong>, only the firm can confirm the account is active, enabled, and provisioned.",
      ],
    },
    { type: "heading", text: "What “Invalid Credentials” Really Means Here" },
    { type: "paragraph", html: "When Tradovate throws <strong class='text-white'>“Invalid credentials”</strong> at a prop-firm login, it isn't necessarily saying your username or password is wrong. It's saying the credentials don't match any account in the environment you picked. Tradovate runs two separate worlds: a <strong class='text-white'>Live</strong> environment for real, funded brokerage accounts, and a <strong class='text-white'>Demo / Simulation</strong> environment where every paper-trading and prop evaluation account lives. Your prop firm handed you a login that exists only in the simulation world." },
    { type: "paragraph", html: "Pick <strong class='text-white'>Live</strong> and Tradovate searches the real-brokerage database, finds nothing that matches, and rejects the sign-in, the identical message you'd get from a genuine typo. That's what makes this error so misleading. Traders re-type the password five times, reset it, and email support, when the fix is just flipping the environment toggle to Simulation. And seeing the words “Demo” or “Simulation” attached to your funded evaluation is <strong class='text-white'>expected and correct</strong>. It doesn't mean something's broken or that you're on the wrong account." },
    { type: "paragraph", html: "There's a second tell that you're in the wrong place. On the web login, selecting Live for a prop account can shove you toward a <strong class='text-white'>live account application</strong> form instead of logging you in, because Tradovate assumes you want to open a new personal brokerage account. If you suddenly find yourself being asked to apply for or fund a live account when all you wanted was to trade your evaluation, that's the demo-vs-live mix-up talking, not a problem with your prop firm." },
    { type: "heading", text: "Top Causes of the Wrong-Environment Login Failure" },
    { type: "heading", text: "1. You selected Live instead of Demo / Simulation" },
    { type: "paragraph", html: "This is the number-one cause, hands down. The login screen offers both environments, and it's easy to click Live out of habit or just because it's listed first. Your evaluation credentials don't exist in Live, so Tradovate rejects them." },
    { type: "heading", text: "2. You're using a personal Tradovate login, not the prop credentials" },
    { type: "paragraph", html: "The username and password your prop firm gives you are separate from any personal Tradovate account. Type your own Tradovate email and password into a prop evaluation and it won't match, and type prop credentials into Live and that won't match either. Use the exact login shown on your prop firm dashboard, nothing else." },
    { type: "heading", text: "3. A pasted password lost its leading capital or picked up a space" },
    { type: "paragraph", html: "Prop-firm passwords are usually auto-generated and case-sensitive. Some browsers and paste actions quietly lowercase the first character or tack on a trailing space, which reads as a wrong password. This looks identical to the environment error, so rule it out too." },
    { type: "heading", text: "4. On TradingView you connected on the Live tab" },
    { type: "paragraph", html: "When you link Tradovate inside TradingView's trading panel, you first choose whether to connect to a <strong class='text-white'>Live</strong> brokerage account or a <strong class='text-white'>Demo</strong> account. Prop-firm and evaluation accounts run on the simulation engine, so they connect under <strong class='text-white'>Demo</strong>. Pick Live in that modal and you'll slam into the same invalid-credentials wall." },
    { type: "heading", text: "5. The evaluation account isn't provisioned or enabled yet" },
    { type: "paragraph", html: "If you've confirmed you're on Demo/Simulation with the right credentials and it still won't log in, the account may not be fully activated on your prop firm's side. Provisioning can lag behind your purchase, and only the firm can enable it. This overlaps with a separate issue where the eval simply hasn't shown up yet after checkout." },
    { type: "heading", text: "How to Fix the Tradovate Eval Login: Step-by-Step" },
    { type: "heading", text: "Fix 1: Sign in through the Demo / Simulation environment" },
    {
      type: "steps",
      items: [
        { title: "Go to the Tradovate login", html: "Go to the Tradovate login, web trader or desktop app." },
        { title: "Enter your prop firm credentials", html: "Enter the username and password from your prop firm dashboard." },
        { title: "Select Demo / Simulation", html: "When you're prompted to choose an environment, select <strong class='text-white'>Demo / Simulation</strong>, not <strong class='text-white'>Live</strong>. On the web login this shows up as a choice between a Live option and a Simulation option. Prop accounts always belong to Simulation, so pick that one." },
        { title: "Accept the agreement and continue", html: "Accept any required agreement, then continue. Your evaluation account should load right up." },
      ],
    },
    { type: "paragraph", html: "If you already clicked Live and hit the error, don't keep hammering the button, <strong class='text-white'>log out completely first</strong>, then start over and choose Simulation. Repeated rapid attempts in the wrong environment can trip a rate-limit or captcha lockout on top of the original problem." },
    { type: "heading", text: "Fix 2: Use the exact prop-firm credentials" },
    {
      type: "steps",
      items: [
        { title: "Find the credentials block", html: "Open your prop firm dashboard and find the Tradovate login block, usually labelled as your platform username and password." },
        { title: "Copy the username exactly", html: "Copy the username exactly. Note the format your firm uses; some issue usernames in a pattern that looks nothing like a personal Tradovate email, so if yours doesn't match that pattern you may be grabbing the wrong login." },
        { title: "Check the password's case and spacing", html: "Paste the password, then click into the field and check that the <strong class='text-white'>first character wasn't lowercased</strong> and there's no leading or trailing space. If you're unsure, re-type it by hand." },
      ],
    },
    { type: "heading", text: "Fix 3: Connect through TradingView on the Demo tab" },
    {
      type: "steps",
      items: [
        { title: "Choose Tradovate as the broker", html: "In TradingView, open the <strong class='text-white'>Trading Panel</strong> and choose <strong class='text-white'>Tradovate</strong> as the broker." },
        { title: "Select Demo", html: "On the account-type screen, select <strong class='text-white'>Demo</strong> (not Live) for any prop-firm or evaluation account." },
        { title: "Enter your credentials to connect", html: "Enter your Tradovate/prop username and password to connect. Keep in mind that prop and evaluation users generally don't need to buy the TradingView add-on themselves, that's controlled by the prop firm." },
      ],
    },
    { type: "heading", text: "Fix 4: Confirm the account loaded and escalate if needed" },
    {
      type: "steps",
      items: [
        { title: "Confirm the account in the selector", html: "After you log in on Simulation, open the account selector and confirm your evaluation account is listed and selectable." },
        { title: "Pick the right one if you have several", html: "If you're running multiple evaluations, pick the correct one before you place a single order." },
        { title: "Contact your firm if it still fails", html: "If the account still won't appear or won't log in despite correct credentials on Simulation, the issue is on the firm's side, the account probably isn't activated yet. Contact your prop firm's support to confirm it's enabled and provisioned. Tradovate support can't see your firm's rules, drawdown, or activation state." },
      ],
    },
    { type: "heading", text: "Troubleshooting Table" },
    {
      type: "table",
      headers: ["Error / State", "What it means", "Fix"],
      rows: [
        ["Invalid credentials", "Login doesn't exist in the environment you chose (usually you picked Live)", "Log out, select Demo / Simulation, and re-enter the prop-firm credentials"],
        ["Pushed to a live account application", "You selected Live, so Tradovate assumes you want a personal brokerage account", "Cancel the application, log out, and sign in through Simulation instead"],
        ["Account shows “Demo” / “Simulation”", "Expected for evaluations and simulated-funded accounts", "Nothing to fix, this is correct; your account is set up properly"],
        ["Works in Demo but you still can't find the account", "You may be on the wrong environment or have multiple accounts", "Confirm Simulation, then use the account selector to pick the evaluation"],
        ["TradingView says invalid credentials", "You connected on the Live tab, or a typo in username/password", "Reconnect on the Demo tab with the exact prop credentials"],
        ["Correct env + correct login, still denied", "Evaluation isn't activated/provisioned by the firm yet", "Contact your prop firm to enable and provision the account"],
        ["Repeated failures then a captcha/lockout", "Too many wrong-environment attempts in a row", "Stop retrying, wait out the cooldown, then log in on Simulation"],
      ],
    },
    { type: "heading", text: "Prevent This with PickMyTrade" },
    { type: "paragraph", html: "Once you know your evaluation lives on the simulation engine, the goal is simple: connect to the <strong class='text-white'>right</strong> account once and stop fighting the demo-vs-live toggle every session. That's exactly where an automation layer earns its keep. PickMyTrade links your TradingView alerts to the specific Tradovate account you authorize, so your signals route where you intend them to instead of bouncing off the wrong environment each time you log in." },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Correct-Account Routing</strong>, connect the exact Demo/simulation prop account once, and every alert goes to that account, no re-picking Live vs Demo on every login.",
        "<strong class='text-white'>Multi-Account Sync</strong>, mirror the same signal across several evaluation accounts from one place, without logging each one in from scratch.",
        "<strong class='text-white'>Entitlement &amp; Risk Awareness</strong>, respects the prop firm's limits and data-agreement state, so orders aren't fired into an account that can't accept them.",
        "<strong class='text-white'>Set-Once Connection</strong>, a stored connection means you're not re-authenticating a browser session on every device you trade from.",
      ],
    },
  ], de: [
    { type: "paragraph",html: "Sie kopieren Benutzernamen und Passwort direkt aus dem Dashboard Ihrer Prop-Firma, klicken auf Login, und Tradovate wirft ein knappes <strong class='text-white'>„Invalid credentials“</strong> zurück, obwohl Ihre Eingabe exakt stimmt. In neun von zehn Fällen liegt es nicht am Passwort, sondern an der Umgebung. Jedes Evaluierungskonto einer Prop-Firma und jedes simuliert finanzierte Konto lebt auf Tradovates <strong class='text-white'>Simulations</strong>-Engine, daher müssen Sie sich über die Umgebung <strong class='text-white'>Demo / Simulation</strong> anmelden, niemals über <strong class='text-white'>Live</strong>. Wählen Sie Live, sucht Tradovate Ihren Login im echten Brokerage-System, in dem ein Prop-Evaluierungskonto schlicht nicht existiert. Also weist es Sie ab oder drängt Sie, schlimmer noch, stattdessen ein persönliches Live-Brokerage-Konto zu eröffnen. Hier erfahren Sie, warum diese Demo-vs.-Live-Falle so viele Trader erwischt, welche Fehlervarianten Ihnen begegnen und wie Sie gleich beim ersten Mal in der richtigen Umgebung landen, mit derselben Disziplin, mit der eine Automatisierung wie PickMyTrade Ihre Alerts an das Konto leitet, das Sie tatsächlich meinten." },
    {
      type: "checklist",
      heading: "Kurze Checkliste bei Tradovate-Eval-Login-Fehlern",
      items: [
        "<strong class='text-white'>Wählen Sie Demo / Simulation, nicht Live</strong>, Evaluierungs- und simuliert finanzierte Konten existieren nur auf Tradovates Simulations-Engine.",
        "<strong class='text-white'>Verwenden Sie die Zugangsdaten aus Ihrem Prop-Dashboard</strong>, sie unterscheiden sich von jedem persönlichen Tradovate-Login, den Sie eventuell haben.",
        "<strong class='text-white'>Versehentlich Live gewählt? Abmelden und neu wählen</strong>, melden Sie sich vollständig ab und wählen Sie Simulation, bevor Sie etwas erneut eingeben.",
        "<strong class='text-white'>In TradingView den Tab Demo wählen</strong>, Prop-Konten werden als Demo verbunden. Live ist nur für persönliche Tradovate-Brokerage-Konten.",
        "<strong class='text-white'>Auf einen verlorenen führenden Großbuchstaben achten</strong>, eingefügte Passwörter werden manchmal so verändert, dass das erste Zeichen kleingeschrieben wird.",
        "<strong class='text-white'>Immer noch blockiert? Kontaktieren Sie Ihre Prop-Firma</strong>, nur die Firma kann bestätigen, dass das Konto aktiv, freigeschaltet und bereitgestellt ist.",
      ],
    },
    { type: "heading",text: "Was „Invalid Credentials“ hier wirklich bedeutet" },
    { type: "paragraph",html: "Wenn Tradovate bei einem Prop-Firma-Login <strong class='text-white'>„Invalid credentials“</strong> ausgibt, heißt das nicht unbedingt, dass Ihr Benutzername oder Passwort falsch ist. Es heißt, dass die Zugangsdaten zu keinem Konto in der gewählten Umgebung passen. Tradovate betreibt zwei getrennte Welten: eine <strong class='text-white'>Live</strong>-Umgebung für echte, finanzierte Brokerage-Konten und eine <strong class='text-white'>Demo / Simulation</strong>-Umgebung, in der alle Paper-Trading- und Prop-Evaluierungskonten liegen. Ihre Prop-Firma hat Ihnen einen Login gegeben, der nur in der Simulationswelt existiert." },
    { type: "paragraph",html: "Wählen Sie <strong class='text-white'>Live</strong>, durchsucht Tradovate die Datenbank des echten Brokerage, findet nichts Passendes und weist die Anmeldung ab, mit exakt derselben Meldung wie bei einem echten Tippfehler. Genau das macht diesen Fehler so irreführend. Trader tippen das Passwort fünfmal neu, setzen es zurück und schreiben dem Support, dabei genügt es, den Umgebungsschalter auf Simulation umzulegen. Und dass bei Ihrem finanzierten Evaluierungskonto die Wörter „Demo“ oder „Simulation“ stehen, ist <strong class='text-white'>erwartbar und korrekt</strong>. Das bedeutet nicht, dass etwas kaputt ist oder Sie das falsche Konto nutzen." },
    { type: "paragraph",html: "Es gibt ein zweites Anzeichen dafür, dass Sie am falschen Ort sind. Beim Web-Login kann die Auswahl von Live für ein Prop-Konto Sie zu einem <strong class='text-white'>Antragsformular für ein Live-Konto</strong> schieben, statt Sie anzumelden, denn Tradovate nimmt an, dass Sie ein neues persönliches Brokerage-Konto eröffnen möchten. Wenn Sie plötzlich aufgefordert werden, ein Live-Konto zu beantragen oder zu finanzieren, obwohl Sie nur Ihre Evaluierung handeln wollten, ist das die Demo-vs.-Live-Verwechslung und kein Problem Ihrer Prop-Firma." },
    { type: "heading",text: "Die häufigsten Ursachen für den Login-Fehler wegen falscher Umgebung" },
    { type: "heading",text: "1. Sie haben Live statt Demo / Simulation gewählt" },
    { type: "paragraph",html: "Das ist ganz klar die Ursache Nummer eins. Der Login-Bildschirm bietet beide Umgebungen an, und man klickt leicht aus Gewohnheit auf Live oder einfach, weil es zuerst aufgeführt ist. Ihre Evaluierungs-Zugangsdaten existieren in Live nicht, daher weist Tradovate sie ab." },
    { type: "heading",text: "2. Sie verwenden einen persönlichen Tradovate-Login statt der Prop-Zugangsdaten" },
    { type: "paragraph",html: "Benutzername und Passwort, die Ihnen Ihre Prop-Firma gibt, sind getrennt von jedem persönlichen Tradovate-Konto. Geben Sie Ihre eigene Tradovate-E-Mail und Ihr eigenes Passwort in einer Prop-Evaluierung ein, passt es nicht, und geben Sie Prop-Zugangsdaten in Live ein, passt es ebenfalls nicht. Verwenden Sie exakt den Login aus Ihrem Prop-Firma-Dashboard, nichts anderes." },
    { type: "heading",text: "3. Ein eingefügtes Passwort hat den führenden Großbuchstaben verloren oder ein Leerzeichen bekommen" },
    { type: "paragraph",html: "Passwörter von Prop-Firmen sind meist automatisch generiert und unterscheiden Groß- und Kleinschreibung. Manche Browser und Einfügeaktionen schreiben das erste Zeichen stillschweigend klein oder hängen ein Leerzeichen an, was als falsches Passwort gewertet wird. Das sieht genauso aus wie der Umgebungsfehler, schließen Sie es also ebenfalls aus." },
    { type: "heading",text: "4. In TradingView haben Sie den Tab Live verbunden" },
    { type: "paragraph",html: "Wenn Sie Tradovate im Trading-Panel von TradingView verknüpfen, wählen Sie zuerst, ob Sie ein <strong class='text-white'>Live</strong>-Brokerage-Konto oder ein <strong class='text-white'>Demo</strong>-Konto verbinden. Prop-Firma- und Evaluierungskonten laufen auf der Simulations-Engine und werden daher unter <strong class='text-white'>Demo</strong> verbunden. Wählen Sie in diesem Dialog Live, laufen Sie gegen dieselbe Invalid-credentials-Wand." },
    { type: "heading",text: "5. Das Evaluierungskonto ist noch nicht bereitgestellt oder freigeschaltet" },
    { type: "paragraph",html: "Wenn Sie bestätigt haben, dass Sie in Demo/Simulation mit den richtigen Zugangsdaten sind und der Login trotzdem nicht klappt, ist das Konto auf Seiten Ihrer Prop-Firma womöglich noch nicht vollständig aktiviert. Die Bereitstellung kann dem Kauf hinterherhinken, und nur die Firma kann sie freischalten. Das überschneidet sich mit einem separaten Problem, bei dem die Evaluierung nach dem Checkout einfach noch nicht erschienen ist." },
    { type: "heading",text: "So beheben Sie den Tradovate-Eval-Login: Schritt für Schritt" },
    { type: "heading",text: "Lösung 1: Über die Umgebung Demo / Simulation anmelden" },
    {
      type: "steps",
      items: [
        { title: "Zum Tradovate-Login gehen", html: "Rufen Sie den Tradovate-Login auf, Web Trader oder Desktop-App." },
        { title: "Zugangsdaten Ihrer Prop-Firma eingeben", html: "Geben Sie Benutzernamen und Passwort aus dem Dashboard Ihrer Prop-Firma ein." },
        { title: "Demo / Simulation auswählen", html: "Wenn Sie aufgefordert werden, eine Umgebung zu wählen, wählen Sie <strong class='text-white'>Demo / Simulation</strong>, nicht <strong class='text-white'>Live</strong>. Beim Web-Login erscheint dies als Auswahl zwischen einer Live-Option und einer Simulations-Option. Prop-Konten gehören immer zu Simulation, wählen Sie also diese." },
        { title: "Vereinbarung akzeptieren und fortfahren", html: "Akzeptieren Sie die erforderliche Vereinbarung und fahren Sie fort. Ihr Evaluierungskonto sollte sofort laden." },
      ],
    },
    { type: "paragraph",html: "Haben Sie bereits Live gewählt und den Fehler erhalten, klicken Sie nicht immer wieder auf die Schaltfläche, <strong class='text-white'>melden Sie sich zuerst vollständig ab</strong>, beginnen Sie dann von vorn und wählen Sie Simulation. Wiederholte schnelle Versuche in der falschen Umgebung können zusätzlich zum ursprünglichen Problem eine Ratenbegrenzung oder eine Captcha-Sperre auslösen." },
    { type: "heading",text: "Lösung 2: Die exakten Zugangsdaten der Prop-Firma verwenden" },
    {
      type: "steps",
      items: [
        { title: "Den Zugangsdatenblock finden", html: "Öffnen Sie das Dashboard Ihrer Prop-Firma und suchen Sie den Tradovate-Login-Block, meist als Plattform-Benutzername und -Passwort bezeichnet." },
        { title: "Den Benutzernamen exakt kopieren", html: "Kopieren Sie den Benutzernamen exakt. Beachten Sie das Format Ihrer Firma. Manche vergeben Benutzernamen in einem Muster, das nichts mit einer persönlichen Tradovate-E-Mail gemein hat. Passt Ihrer nicht zu diesem Muster, greifen Sie möglicherweise zum falschen Login." },
        { title: "Groß-/Kleinschreibung und Leerzeichen des Passworts prüfen", html: "Fügen Sie das Passwort ein, klicken Sie dann ins Feld und prüfen Sie, dass das <strong class='text-white'>erste Zeichen nicht kleingeschrieben wurde</strong> und kein führendes oder nachgestelltes Leerzeichen vorhanden ist. Sind Sie unsicher, tippen Sie es von Hand neu ein." },
      ],
    },
    { type: "heading",text: "Lösung 3: Über TradingView im Tab Demo verbinden" },
    {
      type: "steps",
      items: [
        { title: "Tradovate als Broker wählen", html: "Öffnen Sie in TradingView das <strong class='text-white'>Trading Panel</strong> und wählen Sie <strong class='text-white'>Tradovate</strong> als Broker." },
        { title: "Demo auswählen", html: "Wählen Sie auf dem Bildschirm zur Kontoart <strong class='text-white'>Demo</strong> (nicht Live) für jedes Prop-Firma- oder Evaluierungskonto." },
        { title: "Zugangsdaten zum Verbinden eingeben", html: "Geben Sie Ihren Tradovate-/Prop-Benutzernamen und Ihr Passwort ein, um sich zu verbinden. Beachten Sie, dass Prop- und Evaluierungsnutzer das TradingView-Add-on im Allgemeinen nicht selbst kaufen müssen, das wird von der Prop-Firma gesteuert." },
      ],
    },
    { type: "heading",text: "Lösung 4: Prüfen, ob das Konto geladen wurde, und bei Bedarf eskalieren" },
    {
      type: "steps",
      items: [
        { title: "Das Konto in der Auswahl bestätigen", html: "Öffnen Sie nach der Anmeldung in Simulation die Kontoauswahl und bestätigen Sie, dass Ihr Evaluierungskonto aufgelistet und auswählbar ist." },
        { title: "Bei mehreren das richtige wählen", html: "Wenn Sie mehrere Evaluierungen betreiben, wählen Sie das richtige Konto, bevor Sie eine einzige Order platzieren." },
        { title: "Bei weiterem Fehler Ihre Firma kontaktieren", html: "Wenn das Konto trotz korrekter Zugangsdaten in Simulation weiterhin nicht erscheint oder sich nicht anmelden lässt, liegt das Problem auf Seiten der Firma, das Konto ist wahrscheinlich noch nicht aktiviert. Kontaktieren Sie den Support Ihrer Prop-Firma, um zu bestätigen, dass es freigeschaltet und bereitgestellt ist. Der Tradovate-Support kann weder die Regeln, das Drawdown noch den Aktivierungsstatus Ihrer Firma einsehen." },
      ],
    },
    { type: "heading",text: "Tabelle zur Fehlersuche" },
    { type: "table", headers: ["Fehler / Zustand","Was es bedeutet","Lösung"], rows: [
      ["Invalid credentials","Der Login existiert nicht in der gewählten Umgebung (meist haben Sie Live gewählt)","Abmelden, Demo / Simulation wählen und die Zugangsdaten der Prop-Firma erneut eingeben"],
      ["Weiterleitung zu einem Antrag für ein Live-Konto","Sie haben Live gewählt, daher nimmt Tradovate an, dass Sie ein persönliches Brokerage-Konto möchten","Antrag abbrechen, abmelden und stattdessen über Simulation anmelden"],
      ["Konto zeigt „Demo“ / „Simulation“","Bei Evaluierungen und simuliert finanzierten Konten erwartbar","Nichts zu beheben, das ist korrekt, Ihr Konto ist richtig eingerichtet"],
      ["Funktioniert in Demo, aber das Konto ist nicht auffindbar","Möglicherweise sind Sie in der falschen Umgebung oder haben mehrere Konten","Simulation bestätigen und dann über die Kontoauswahl die Evaluierung wählen"],
      ["TradingView meldet Invalid credentials","Sie haben im Tab Live verbunden, oder es gibt einen Tippfehler bei Benutzername/Passwort","Im Tab Demo mit den exakten Prop-Zugangsdaten neu verbinden"],
      ["Richtige Umgebung + richtiger Login, trotzdem abgelehnt","Die Evaluierung ist von der Firma noch nicht aktiviert/bereitgestellt","Ihre Prop-Firma kontaktieren, damit das Konto freigeschaltet und bereitgestellt wird"],
      ["Wiederholte Fehlschläge, dann Captcha/Sperre","Zu viele Versuche in falscher Umgebung hintereinander","Nicht mehr wiederholen, die Abkühlzeit abwarten, dann in Simulation anmelden"],
    ] },
    { type: "heading",text: "Vermeiden Sie das mit PickMyTrade" },
    { type: "paragraph",html: "Sobald Sie wissen, dass Ihre Evaluierung auf der Simulations-Engine läuft, ist das Ziel einfach: das <strong class='text-white'>richtige</strong> Konto einmal verbinden und nicht mehr in jeder Sitzung mit dem Demo-/Live-Schalter kämpfen. Genau hier zahlt sich eine Automatisierungsschicht aus. PickMyTrade verknüpft Ihre TradingView-Alerts mit dem konkreten Tradovate-Konto, das Sie autorisieren, sodass Ihre Signale dorthin gehen, wo Sie es wollen, statt bei jeder Anmeldung an der falschen Umgebung abzuprallen." },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Korrektes Account-Routing</strong>, verbinden Sie das exakte Demo-/Simulations-Prop-Konto einmal, und jeder Alert geht an dieses Konto, ohne bei jedem Login erneut Live oder Demo zu wählen.",
        "<strong class='text-white'>Multi-Account-Sync</strong>, spiegeln Sie dasselbe Signal von einer Stelle aus auf mehrere Evaluierungskonten, ohne jedes einzeln neu anzumelden.",
        "<strong class='text-white'>Berechtigungs- &amp; Risikobewusstsein</strong>, berücksichtigt die Limits der Prop-Firma und den Stand der Datenvereinbarung, sodass Orders nicht in ein Konto geschickt werden, das sie nicht annehmen kann.",
        "<strong class='text-white'>Einmal einrichten</strong>, eine gespeicherte Verbindung bedeutet, dass Sie auf jedem Gerät, von dem Sie handeln, keine Browsersitzung neu authentifizieren müssen.",
      ],
    },
  ], es: [
    { type: "paragraph",html: "Copia el usuario y la contraseña directamente desde el panel de su firma prop, pulsa iniciar sesión y Tradovate le devuelve un seco <strong class='text-white'>«Invalid credentials»</strong> aunque lo que escribió sea exactamente correcto. Nueve de cada diez veces el problema no es la contraseña. Es el entorno. Toda cuenta de evaluación de una firma prop y toda cuenta fondeada simulada vive en el motor de <strong class='text-white'>simulación</strong> de Tradovate, así que debe iniciar sesión a través del entorno <strong class='text-white'>Demo / Simulation</strong>, nunca de <strong class='text-white'>Live</strong>. Si elige Live, Tradovate busca su inicio de sesión en el sistema de corretaje real, donde una cuenta de evaluación prop sencillamente no existe. Por eso lo rechaza o, peor aún, intenta empujarlo a abrir en su lugar una cuenta de corretaje real personal. Aquí verá por qué esta trampa demo-vs-live atrapa a tantos traders, las variantes exactas del error que encontrará y cómo llegar al entorno correcto a la primera, con la misma disciplina que hace que una automatización como PickMyTrade dirija sus alertas a la cuenta que realmente quería." },
    {
      type: "checklist",
      heading: "Lista rápida para errores de inicio de sesión de evaluación en Tradovate",
      items: [
        "<strong class='text-white'>Elija Demo / Simulation, no Live</strong>, las cuentas de evaluación y fondeadas simuladas solo existen en el motor de simulación de Tradovate.",
        "<strong class='text-white'>Use las credenciales del panel de su firma prop</strong>, son distintas de cualquier inicio de sesión personal de Tradovate que pueda tener.",
        "<strong class='text-white'>¿Eligió Live por error? Cierre sesión y vuelva a elegir</strong>, salga por completo y luego elija Simulation antes de volver a introducir nada.",
        "<strong class='text-white'>En TradingView, elija la pestaña Demo</strong>, las cuentas prop se conectan como Demo; Live es solo para cuentas de corretaje personales de Tradovate.",
        "<strong class='text-white'>Vigile que no se haya perdido la mayúscula inicial</strong>, a veces las contraseñas pegadas tienen su primer carácter convertido a minúscula.",
        "<strong class='text-white'>¿Sigue bloqueado? Contacte con su firma prop</strong>, solo la firma puede confirmar que la cuenta está activa, habilitada y aprovisionada.",
      ],
    },
    { type: "heading",text: "Qué significa realmente «Invalid Credentials» aquí" },
    { type: "paragraph",html: "Cuando Tradovate lanza <strong class='text-white'>«Invalid credentials»</strong> en un inicio de sesión de firma prop, no necesariamente está diciendo que su usuario o contraseña sean incorrectos. Está diciendo que las credenciales no coinciden con ninguna cuenta del entorno que eligió. Tradovate opera dos mundos separados: un entorno <strong class='text-white'>Live</strong> para cuentas de corretaje reales y fondeadas, y un entorno <strong class='text-white'>Demo / Simulation</strong> donde viven todas las cuentas de paper trading y de evaluación prop. Su firma prop le entregó un inicio de sesión que existe solo en el mundo de simulación." },
    { type: "paragraph",html: "Si elige <strong class='text-white'>Live</strong>, Tradovate busca en la base de datos del corretaje real, no encuentra nada que coincida y rechaza el inicio de sesión con el mismo mensaje idéntico que recibiría por un error tipográfico genuino. Eso es lo que hace tan engañoso este error. Los traders reescriben la contraseña cinco veces, la restablecen y escriben a soporte, cuando la solución es simplemente cambiar el selector de entorno a Simulation. Y ver las palabras «Demo» o «Simulation» asociadas a su evaluación fondeada es <strong class='text-white'>esperado y correcto</strong>. No significa que algo esté roto ni que esté en la cuenta equivocada." },
    { type: "paragraph",html: "Hay una segunda señal de que está en el lugar equivocado. En el inicio de sesión web, seleccionar Live para una cuenta prop puede empujarle a un formulario de <strong class='text-white'>solicitud de cuenta real</strong> en lugar de iniciar sesión, porque Tradovate asume que quiere abrir una nueva cuenta de corretaje personal. Si de pronto se ve pidiendo solicitar o financiar una cuenta real cuando solo quería operar su evaluación, eso es la confusión demo-vs-live, no un problema con su firma prop." },
    { type: "heading",text: "Principales causas del fallo de inicio de sesión por entorno equivocado" },
    { type: "heading",text: "1. Seleccionó Live en lugar de Demo / Simulation" },
    { type: "paragraph",html: "Esta es la causa número uno, sin duda. La pantalla de inicio de sesión ofrece ambos entornos y es fácil hacer clic en Live por costumbre o simplemente porque aparece primero. Sus credenciales de evaluación no existen en Live, así que Tradovate las rechaza." },
    { type: "heading",text: "2. Está usando un inicio de sesión personal de Tradovate, no las credenciales prop" },
    { type: "paragraph",html: "El usuario y la contraseña que le da su firma prop son independientes de cualquier cuenta personal de Tradovate. Si escribe su propio correo y contraseña de Tradovate en una evaluación prop, no coincidirán, y si escribe credenciales prop en Live tampoco coincidirán. Use el inicio de sesión exacto que aparece en el panel de su firma prop, nada más." },
    { type: "heading",text: "3. Una contraseña pegada perdió su mayúscula inicial o ganó un espacio" },
    { type: "paragraph",html: "Las contraseñas de las firmas prop suelen generarse automáticamente y distinguen mayúsculas de minúsculas. Algunos navegadores y acciones de pegado convierten discretamente el primer carácter a minúscula o añaden un espacio al final, lo que se interpreta como una contraseña incorrecta. Se ve idéntico al error de entorno, así que descártelo también." },
    { type: "heading",text: "4. En TradingView conectó en la pestaña Live" },
    { type: "paragraph",html: "Cuando vincula Tradovate en el panel de trading de TradingView, primero elige si conectar una cuenta de corretaje <strong class='text-white'>Live</strong> o una cuenta <strong class='text-white'>Demo</strong>. Las cuentas de firma prop y de evaluación funcionan en el motor de simulación, por lo que se conectan en <strong class='text-white'>Demo</strong>. Si elige Live en ese modal, chocará con el mismo muro de credenciales no válidas." },
    { type: "heading",text: "5. La cuenta de evaluación aún no está aprovisionada o habilitada" },
    { type: "paragraph",html: "Si ha confirmado que está en Demo/Simulation con las credenciales correctas y aun así no entra, es posible que la cuenta no esté totalmente activada por parte de su firma prop. El aprovisionamiento puede retrasarse respecto a su compra, y solo la firma puede habilitarlo. Esto se solapa con un problema distinto en el que la evaluación simplemente no ha aparecido todavía tras el pago." },
    { type: "heading",text: "Cómo solucionar el inicio de sesión de evaluación en Tradovate: paso a paso" },
    { type: "heading",text: "Solución 1: inicie sesión a través del entorno Demo / Simulation" },
    {
      type: "steps",
      items: [
        { title: "Vaya al inicio de sesión de Tradovate", html: "Vaya al inicio de sesión de Tradovate, el web trader o la aplicación de escritorio." },
        { title: "Introduzca las credenciales de su firma prop", html: "Introduzca el usuario y la contraseña del panel de su firma prop." },
        { title: "Seleccione Demo / Simulation", html: "Cuando se le pida elegir un entorno, seleccione <strong class='text-white'>Demo / Simulation</strong>, no <strong class='text-white'>Live</strong>. En el inicio de sesión web aparece como una elección entre una opción Live y una opción Simulation. Las cuentas prop siempre pertenecen a Simulation, así que elija esa." },
        { title: "Acepte el acuerdo y continúe", html: "Acepte cualquier acuerdo requerido y continúe. Su cuenta de evaluación debería cargarse de inmediato." },
      ],
    },
    { type: "paragraph",html: "Si ya hizo clic en Live y obtuvo el error, no siga insistiendo en el botón, <strong class='text-white'>cierre sesión por completo primero</strong>, luego empiece de nuevo y elija Simulation. Los intentos rápidos y repetidos en el entorno equivocado pueden provocar un límite de frecuencia o un bloqueo por captcha además del problema original." },
    { type: "heading",text: "Solución 2: use las credenciales exactas de la firma prop" },
    {
      type: "steps",
      items: [
        { title: "Encuentre el bloque de credenciales", html: "Abra el panel de su firma prop y busque el bloque de inicio de sesión de Tradovate, normalmente etiquetado como usuario y contraseña de la plataforma." },
        { title: "Copie el usuario exactamente", html: "Copie el usuario exactamente. Fíjese en el formato que usa su firma; algunas emiten usuarios con un patrón que no se parece en nada a un correo personal de Tradovate, así que si el suyo no coincide con ese patrón puede que esté tomando el inicio de sesión equivocado." },
        { title: "Revise las mayúsculas y los espacios de la contraseña", html: "Pegue la contraseña, luego haga clic en el campo y compruebe que el <strong class='text-white'>primer carácter no se convirtió a minúscula</strong> y que no hay espacios iniciales ni finales. Si no está seguro, vuelva a escribirla a mano." },
      ],
    },
    { type: "heading",text: "Solución 3: conéctese a través de TradingView en la pestaña Demo" },
    {
      type: "steps",
      items: [
        { title: "Elija Tradovate como broker", html: "En TradingView, abra el <strong class='text-white'>Trading Panel</strong> y elija <strong class='text-white'>Tradovate</strong> como broker." },
        { title: "Seleccione Demo", html: "En la pantalla de tipo de cuenta, seleccione <strong class='text-white'>Demo</strong> (no Live) para cualquier cuenta de firma prop o de evaluación." },
        { title: "Introduzca sus credenciales para conectar", html: "Introduzca su usuario y contraseña de Tradovate/prop para conectar. Tenga en cuenta que los usuarios prop y de evaluación por lo general no necesitan comprar el complemento de TradingView por sí mismos; eso lo controla la firma prop." },
      ],
    },
    { type: "heading",text: "Solución 4: confirme que la cuenta cargó y escale si es necesario" },
    {
      type: "steps",
      items: [
        { title: "Confirme la cuenta en el selector", html: "Después de iniciar sesión en Simulation, abra el selector de cuentas y confirme que su cuenta de evaluación aparece en la lista y se puede seleccionar." },
        { title: "Elija la correcta si tiene varias", html: "Si ejecuta varias evaluaciones, elija la correcta antes de colocar una sola orden." },
        { title: "Contacte con su firma si sigue fallando", html: "Si la cuenta sigue sin aparecer o sin permitir el acceso a pesar de las credenciales correctas en Simulation, el problema está en el lado de la firma; lo más probable es que la cuenta aún no esté activada. Contacte con el soporte de su firma prop para confirmar que está habilitada y aprovisionada. El soporte de Tradovate no puede ver las reglas, el drawdown ni el estado de activación de su firma." },
      ],
    },
    { type: "heading",text: "Tabla de resolución de problemas" },
    { type: "table", headers: ["Error / Estado","Qué significa","Solución"], rows: [
      ["Invalid credentials","El inicio de sesión no existe en el entorno que eligió (normalmente eligió Live)","Cierre sesión, seleccione Demo / Simulation y vuelva a introducir las credenciales de la firma prop"],
      ["Le envía a una solicitud de cuenta real","Seleccionó Live, por lo que Tradovate asume que quiere una cuenta de corretaje personal","Cancele la solicitud, cierre sesión e inicie sesión mediante Simulation en su lugar"],
      ["La cuenta muestra «Demo» / «Simulation»","Es lo esperado en evaluaciones y cuentas fondeadas simuladas","No hay nada que arreglar, esto es correcto; su cuenta está bien configurada"],
      ["Funciona en Demo pero aun así no encuentra la cuenta","Puede que esté en el entorno equivocado o tenga varias cuentas","Confirme Simulation y luego use el selector de cuentas para elegir la evaluación"],
      ["TradingView dice credenciales no válidas","Conectó en la pestaña Live, o hay un error tipográfico en el usuario/contraseña","Vuelva a conectar en la pestaña Demo con las credenciales prop exactas"],
      ["Entorno correcto + inicio de sesión correcto, aun así denegado","La firma aún no ha activado/aprovisionado la evaluación","Contacte con su firma prop para que habilite y aprovisione la cuenta"],
      ["Fallos repetidos y luego captcha/bloqueo","Demasiados intentos seguidos en el entorno equivocado","Deje de reintentar, espere a que termine el tiempo de espera y luego inicie sesión en Simulation"],
    ] },
    { type: "heading",text: "Evítelo con PickMyTrade" },
    { type: "paragraph",html: "Una vez que sabe que su evaluación vive en el motor de simulación, el objetivo es sencillo: conectar la cuenta <strong class='text-white'>correcta</strong> una sola vez y dejar de pelear con el selector demo-vs-live en cada sesión. Ahí es exactamente donde una capa de automatización demuestra su valor. PickMyTrade vincula sus alertas de TradingView con la cuenta específica de Tradovate que usted autoriza, de modo que sus señales se enrutan adonde usted pretende en lugar de rebotar contra el entorno equivocado cada vez que inicia sesión." },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Enrutamiento a la cuenta correcta</strong>, conecte una vez la cuenta prop exacta Demo/simulación y cada alerta va a esa cuenta, sin volver a elegir Live o Demo en cada inicio de sesión.",
        "<strong class='text-white'>Sincronización multicuenta</strong>, replique la misma señal en varias cuentas de evaluación desde un solo lugar, sin iniciar sesión en cada una desde cero.",
        "<strong class='text-white'>Conciencia de permisos &amp; riesgo</strong>, respeta los límites de la firma prop y el estado del acuerdo de datos, de modo que no se envíen órdenes a una cuenta que no puede aceptarlas.",
        "<strong class='text-white'>Conexión de una sola vez</strong>, una conexión almacenada significa que no tiene que volver a autenticar una sesión de navegador en cada dispositivo desde el que opera.",
      ],
    },
  ], fr: [
    { type: "paragraph",html: "Vous copiez l'identifiant et le mot de passe directement depuis le tableau de bord de votre société prop, vous cliquez sur connexion, et Tradovate vous renvoie un sec <strong class='text-white'>« Invalid credentials »</strong> alors que ce que vous avez saisi est exactement correct. Neuf fois sur dix, ce n'est pas le mot de passe le problème. C'est l'environnement. Chaque compte d'évaluation d'une société prop et chaque compte financé simulé vit sur le moteur de <strong class='text-white'>simulation</strong> de Tradovate ; vous devez donc vous connecter via l'environnement <strong class='text-white'>Demo / Simulation</strong>, jamais <strong class='text-white'>Live</strong>. Si vous choisissez Live, Tradovate cherche votre connexion dans le système de courtage réel, où un compte d'évaluation prop n'existe tout simplement pas. Il vous rejette donc ou, pire, tente de vous pousser à ouvrir à la place un compte de courtage réel personnel. Voici pourquoi ce piège demo-vs-live attrape autant de traders, les variantes exactes de l'erreur que vous rencontrerez et comment atterrir dans le bon environnement du premier coup, avec la même discipline qui permet à une automatisation comme PickMyTrade d'acheminer vos alertes vers le compte que vous visiez réellement." },
    {
      type: "checklist",
      heading: "Liste de vérification rapide pour les erreurs de connexion Tradovate Eval",
      items: [
        "<strong class='text-white'>Choisissez Demo / Simulation, pas Live</strong>, les comptes d'évaluation et financés simulés n'existent que sur le moteur de simulation de Tradovate.",
        "<strong class='text-white'>Utilisez les identifiants du tableau de bord de votre société prop</strong>, ils sont différents de toute connexion Tradovate personnelle que vous pourriez avoir.",
        "<strong class='text-white'>Live choisi par erreur ? Déconnectez-vous et resélectionnez</strong>, déconnectez-vous complètement, puis choisissez Simulation avant de ressaisir quoi que ce soit.",
        "<strong class='text-white'>Dans TradingView, choisissez l'onglet Demo</strong>, les comptes prop se connectent en Demo ; Live est réservé aux comptes de courtage Tradovate personnels.",
        "<strong class='text-white'>Attention à la majuscule initiale perdue</strong>, les mots de passe collés voient parfois leur premier caractère passer automatiquement en minuscule.",
        "<strong class='text-white'>Toujours bloqué ? Contactez votre société prop</strong>, seule la société peut confirmer que le compte est actif, activé et provisionné.",
      ],
    },
    { type: "heading",text: "Ce que signifie réellement « Invalid Credentials » ici" },
    { type: "paragraph",html: "Lorsque Tradovate renvoie <strong class='text-white'>« Invalid credentials »</strong> sur une connexion de société prop, cela ne signifie pas forcément que votre identifiant ou votre mot de passe est faux. Cela signifie que les identifiants ne correspondent à aucun compte de l'environnement que vous avez choisi. Tradovate exploite deux univers distincts : un environnement <strong class='text-white'>Live</strong> pour les comptes de courtage réels et financés, et un environnement <strong class='text-white'>Demo / Simulation</strong> où vivent tous les comptes de paper trading et d'évaluation prop. Votre société prop vous a remis une connexion qui n'existe que dans l'univers de simulation." },
    { type: "paragraph",html: "Si vous choisissez <strong class='text-white'>Live</strong>, Tradovate parcourt la base de données du courtage réel, ne trouve rien qui corresponde et rejette la connexion, avec le message identique à celui d'une véritable faute de frappe. C'est ce qui rend cette erreur si trompeuse. Les traders retapent le mot de passe cinq fois, le réinitialisent et écrivent au support, alors que la solution consiste simplement à basculer le sélecteur d'environnement sur Simulation. Et voir les mots « Demo » ou « Simulation » associés à votre évaluation financée est <strong class='text-white'>normal et correct</strong>. Cela ne signifie pas que quelque chose est cassé ni que vous êtes sur le mauvais compte." },
    { type: "paragraph",html: "Il existe un second indice que vous n'êtes pas au bon endroit. Sur la connexion web, la sélection de Live pour un compte prop peut vous pousser vers un formulaire de <strong class='text-white'>demande de compte réel</strong> au lieu de vous connecter, car Tradovate suppose que vous voulez ouvrir un nouveau compte de courtage personnel. Si vous vous retrouvez soudain invité à demander ou à approvisionner un compte réel alors que vous vouliez simplement trader votre évaluation, c'est la confusion demo-vs-live qui parle, pas un problème de votre société prop." },
    { type: "heading",text: "Principales causes de l'échec de connexion dû au mauvais environnement" },
    { type: "heading",text: "1. Vous avez sélectionné Live au lieu de Demo / Simulation" },
    { type: "paragraph",html: "C'est la cause numéro un, sans conteste. L'écran de connexion propose les deux environnements, et il est facile de cliquer sur Live par habitude ou simplement parce qu'il est listé en premier. Vos identifiants d'évaluation n'existent pas dans Live ; Tradovate les rejette donc." },
    { type: "heading",text: "2. Vous utilisez une connexion Tradovate personnelle, pas les identifiants prop" },
    { type: "paragraph",html: "L'identifiant et le mot de passe que vous remet votre société prop sont distincts de tout compte Tradovate personnel. Saisissez votre propre e-mail et mot de passe Tradovate dans une évaluation prop et cela ne correspondra pas ; saisissez les identifiants prop dans Live et cela ne correspondra pas non plus. Utilisez exactement la connexion indiquée sur le tableau de bord de votre société prop, rien d'autre." },
    { type: "heading",text: "3. Un mot de passe collé a perdu sa majuscule initiale ou récupéré un espace" },
    { type: "paragraph",html: "Les mots de passe des sociétés prop sont généralement générés automatiquement et sensibles à la casse. Certains navigateurs et actions de collage passent discrètement le premier caractère en minuscule ou ajoutent un espace final, ce qui est interprété comme un mauvais mot de passe. Cela ressemble à s'y méprendre à l'erreur d'environnement ; écartez donc aussi cette piste." },
    { type: "heading",text: "4. Dans TradingView, vous vous êtes connecté sur l'onglet Live" },
    { type: "paragraph",html: "Lorsque vous liez Tradovate dans le panneau de trading de TradingView, vous choisissez d'abord de connecter un compte de courtage <strong class='text-white'>Live</strong> ou un compte <strong class='text-white'>Demo</strong>. Les comptes de société prop et d'évaluation fonctionnent sur le moteur de simulation ; ils se connectent donc sous <strong class='text-white'>Demo</strong>. Si vous choisissez Live dans cette fenêtre, vous vous heurterez au même mur d'identifiants invalides." },
    { type: "heading",text: "5. Le compte d'évaluation n'est pas encore provisionné ou activé" },
    { type: "paragraph",html: "Si vous avez confirmé que vous êtes sur Demo/Simulation avec les bons identifiants et que la connexion échoue toujours, le compte n'est peut-être pas entièrement activé côté société prop. Le provisionnement peut prendre du retard par rapport à votre achat, et seule la société peut l'activer. Cela recoupe un problème distinct où l'évaluation n'est simplement pas encore apparue après le paiement." },
    { type: "heading",text: "Comment corriger la connexion Tradovate Eval : pas à pas" },
    { type: "heading",text: "Correctif 1 : connectez-vous via l'environnement Demo / Simulation" },
    {
      type: "steps",
      items: [
        { title: "Accédez à la connexion Tradovate", html: "Accédez à la connexion Tradovate, le web trader ou l'application de bureau." },
        { title: "Saisissez les identifiants de votre société prop", html: "Saisissez l'identifiant et le mot de passe du tableau de bord de votre société prop." },
        { title: "Sélectionnez Demo / Simulation", html: "Lorsqu'on vous invite à choisir un environnement, sélectionnez <strong class='text-white'>Demo / Simulation</strong>, pas <strong class='text-white'>Live</strong>. Sur la connexion web, cela apparaît comme un choix entre une option Live et une option Simulation. Les comptes prop appartiennent toujours à Simulation ; choisissez donc celle-ci." },
        { title: "Acceptez l'accord et continuez", html: "Acceptez tout accord requis, puis continuez. Votre compte d'évaluation devrait se charger immédiatement." },
      ],
    },
    { type: "paragraph",html: "Si vous avez déjà cliqué sur Live et obtenu l'erreur, ne martelez pas le bouton, <strong class='text-white'>déconnectez-vous d'abord complètement</strong>, puis recommencez et choisissez Simulation. Des tentatives rapides et répétées dans le mauvais environnement peuvent déclencher une limitation de débit ou un verrouillage par captcha en plus du problème initial." },
    { type: "heading",text: "Correctif 2 : utilisez les identifiants exacts de la société prop" },
    {
      type: "steps",
      items: [
        { title: "Repérez le bloc d'identifiants", html: "Ouvrez le tableau de bord de votre société prop et trouvez le bloc de connexion Tradovate, généralement libellé comme l'identifiant et le mot de passe de la plateforme." },
        { title: "Copiez l'identifiant à l'identique", html: "Copiez l'identifiant à l'identique. Notez le format utilisé par votre société ; certaines émettent des identifiants selon un schéma qui ne ressemble en rien à un e-mail Tradovate personnel, donc si le vôtre ne correspond pas à ce schéma, vous prenez peut-être la mauvaise connexion." },
        { title: "Vérifiez la casse et les espaces du mot de passe", html: "Collez le mot de passe, puis cliquez dans le champ et vérifiez que le <strong class='text-white'>premier caractère n'est pas passé en minuscule</strong> et qu'il n'y a aucun espace initial ou final. En cas de doute, retapez-le à la main." },
      ],
    },
    { type: "heading",text: "Correctif 3 : connectez-vous via TradingView sur l'onglet Demo" },
    {
      type: "steps",
      items: [
        { title: "Choisissez Tradovate comme courtier", html: "Dans TradingView, ouvrez le <strong class='text-white'>Trading Panel</strong> et choisissez <strong class='text-white'>Tradovate</strong> comme courtier." },
        { title: "Sélectionnez Demo", html: "Sur l'écran du type de compte, sélectionnez <strong class='text-white'>Demo</strong> (pas Live) pour tout compte de société prop ou d'évaluation." },
        { title: "Saisissez vos identifiants pour vous connecter", html: "Saisissez votre identifiant et mot de passe Tradovate/prop pour vous connecter. Gardez à l'esprit que les utilisateurs prop et d'évaluation n'ont généralement pas besoin d'acheter eux-mêmes le module complémentaire TradingView ; cela est contrôlé par la société prop." },
      ],
    },
    { type: "heading",text: "Correctif 4 : confirmez que le compte s'est chargé et passez à l'échelon supérieur si nécessaire" },
    {
      type: "steps",
      items: [
        { title: "Confirmez le compte dans le sélecteur", html: "Après vous être connecté sur Simulation, ouvrez le sélecteur de compte et confirmez que votre compte d'évaluation est répertorié et sélectionnable." },
        { title: "Choisissez le bon si vous en avez plusieurs", html: "Si vous menez plusieurs évaluations, choisissez la bonne avant de passer le moindre ordre." },
        { title: "Contactez votre société si cela échoue toujours", html: "Si le compte n'apparaît toujours pas ou ne permet pas la connexion malgré des identifiants corrects sur Simulation, le problème vient de la société ; le compte n'est probablement pas encore activé. Contactez le support de votre société prop pour confirmer qu'il est activé et provisionné. Le support Tradovate ne peut pas voir les règles, le drawdown ni l'état d'activation de votre société." },
      ],
    },
    { type: "heading",text: "Tableau de dépannage" },
    { type: "table", headers: ["Erreur / État","Ce que cela signifie","Correctif"], rows: [
      ["Invalid credentials","La connexion n'existe pas dans l'environnement choisi (vous avez généralement choisi Live)","Déconnectez-vous, sélectionnez Demo / Simulation et ressaisissez les identifiants de la société prop"],
      ["Redirigé vers une demande de compte réel","Vous avez sélectionné Live ; Tradovate suppose donc que vous voulez un compte de courtage personnel","Annulez la demande, déconnectez-vous et connectez-vous plutôt via Simulation"],
      ["Le compte affiche « Demo » / « Simulation »","Normal pour les évaluations et les comptes financés simulés","Rien à corriger, c'est correct ; votre compte est bien configuré"],
      ["Fonctionne en Demo mais vous ne trouvez toujours pas le compte","Vous êtes peut-être dans le mauvais environnement ou avez plusieurs comptes","Confirmez Simulation, puis utilisez le sélecteur de compte pour choisir l'évaluation"],
      ["TradingView indique des identifiants invalides","Vous vous êtes connecté sur l'onglet Live, ou il y a une faute de frappe dans l'identifiant/le mot de passe","Reconnectez-vous sur l'onglet Demo avec les identifiants prop exacts"],
      ["Bon environnement + bonne connexion, toujours refusé","L'évaluation n'est pas encore activée/provisionnée par la société","Contactez votre société prop pour qu'elle active et provisionne le compte"],
      ["Échecs répétés puis captcha/verrouillage","Trop de tentatives de suite dans le mauvais environnement","Cessez de réessayer, attendez la fin du délai, puis connectez-vous sur Simulation"],
