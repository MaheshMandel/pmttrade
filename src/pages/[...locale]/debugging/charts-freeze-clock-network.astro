---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "charts-freeze-clock-network";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/debugging/${SLUG}`;

const META_TITLE = "Tradovate Charts Freeze: Clock Sync / Network";
const META_DESCRIPTION =
  "Tradovate charts freezing? Sync your system clock and switch to a stable wired connection to stop frozen charts and keep live data flowing.";

// Short SEO title (<=60 chars) for locales where the shared h1 is too long for a SERP title.
const TITLE_OVERRIDE: Partial<Record<Locale, string>> = { es: "Tradovate: gráficos congelados (reloj / red)", fr: "Tradovate : graphiques figés (horloge / réseau)", it: "Tradovate: grafici bloccati (orologio / rete)" };

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Tradovate-Charts frieren ein: Uhrsynchronisation / Netzwerk", es: "Los gráficos de Tradovate se congelan: sincronización del reloj / red", fr: "Les graphiques Tradovate se figent : synchronisation de l'horloge / réseau", it: "I grafici Tradovate si bloccano: sincronizzazione orologio / rete" },
  dek: { en: "Candles quit printing, the last price sticks, and the DOM goes quiet while the market keeps running without you. Here's why Tradovate charts freeze in 2026, and how to fix it fast.", de: "Kerzen hören auf zu drucken, der letzte Preis bleibt hängen, und das DOM verstummt, während der Markt ohne Sie weiterläuft. Hier erfahren Sie, warum Tradovate-Charts 2026 einfrieren und wie Sie es schnell beheben.", es: "Las velas dejan de imprimirse, el último precio se queda fijo y el DOM se queda en silencio mientras el mercado sigue corriendo sin ti. Aquí te explicamos por qué los gráficos de Tradovate se congelan en 2026 y cómo solucionarlo rápido.", fr: "Les bougies cessent de s'imprimer, le dernier prix reste figé, et le DOM se tait pendant que le marché continue de tourner sans vous. Voici pourquoi les graphiques Tradovate se figent en 2026, et comment y remédier rapidement.", it: "Le candele smettono di stamparsi, l'ultimo prezzo resta fisso e il DOM ammutolisce mentre il mercato continua a correre senza di te. Ecco perché i grafici Tradovate si bloccano nel 2026 e come risolverlo rapidamente." },
  readTime: { en: "7 min read", de: "7 Minuten Lesezeit", es: "Lectura de 7 minutos", fr: "Lecture de 7 minutes", it: "Lettura di 7 minuti" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "When you're scalping something fast like ES or NQ, nothing wrecks a setup quicker than a Tradovate chart that just stops. Candles quit printing, the last price sticks, and the DOM goes quiet while the market keeps running without you. The gut reaction is to assume the platform crashed or Tradovate is &ldquo;down.&rdquo; In 2026, though, the usual triggers are boring and local: a system clock that's drifted out of sync and an internet connection that isn't as stable as you think. Below is every cause of frozen Tradovate charts, the exact fix for each, and how routing your entries through automation like PickMyTrade keeps orders moving even when a chart hiccups." },
    {
      type: "checklist",
      heading: "Quick Checklist for Frozen Tradovate Charts",
      items: [
        "<strong class='text-white'>Sync your system clock</strong>, right-click the Windows taskbar clock, open date/time settings, turn on automatic time, and hit Sync now. A skewed clock on its own can hang the platform.",
        "<strong class='text-white'>Switch to wired Ethernet</strong>, a Wi-Fi drop, even a one-second one, freezes the live data stream. A cable is the single biggest reliability upgrade you can make.",
        "<strong class='text-white'>Log out and back in</strong>, this forces Tradovate to rebuild the data socket and usually un-sticks a frozen chart on the spot.",
        "<strong class='text-white'>Check the contract month</strong>, an expired or wrong contract shows a dead chart because no new ticks are coming in.",
        "<strong class='text-white'>Watch for orange symbols</strong>, an orange symbol name means delayed (not live) data, which looks a lot like a freeze.",
        "<strong class='text-white'>Close duplicate sessions</strong>, being logged in on web, desktop, mobile, and TradingView all at once can collide and stall your charts.",
      ],
    },
    { type: "heading", text: "What “Frozen Tradovate Charts” Actually Means" },
    { type: "paragraph", html: "There's rarely a pop-up error when a Tradovate chart freezes. You just notice the symptoms: the most recent candle stops advancing, the timestamp in the corner quits ticking forward, the DOM ladder goes still, and buttons feel dead or the screen hangs on Loading. On paper the account is often still &ldquo;connected,&rdquo; which is what makes it so disorienting, your platform looks alive while the data underneath it has stopped." },
    { type: "paragraph", html: "Under the hood, a trading platform needs a constant, uninterrupted line to both the market-data server and the account server. The moment that stream gets cut, a dropped packet, a Wi-Fi blip, or a mismatch between your PC and Tradovate's servers, the chart has nothing new to draw, so it freezes on the last frame it got. Two things break that handshake more than anything else: your computer's clock and your network." },
    { type: "heading", text: "Top Causes of Tradovate Charts Freezing" },
    { type: "heading", text: "1. An out-of-sync system clock" },
    { type: "paragraph", html: "This is the sneaky one. Secure connections and session tokens depend on your computer's clock closely matching the server's. If your PC time has drifted, which happens after sleep/wake cycles, on a dead CMOS battery, or when the clock was set by hand, Tradovate can hang on Loading, leave buttons unresponsive, or quietly stop updating charts. Because nothing looks wrong with your internet, the clock is the last thing anyone suspects." },
    { type: "heading", text: "2. An unstable or wireless network connection" },
    { type: "paragraph", html: "Charts stream live ticks, so any interruption shows up immediately. Wi-Fi is the usual suspect: a brief signal drop, router congestion, or a background download can starve the feed just long enough to freeze the display. A flaky modem, an overloaded router, or slow DNS lookups all produce the same result." },
    { type: "heading", text: "3. An expired or wrong contract month" },
    { type: "paragraph", html: "Futures contracts roll. If your chart is still pointed at an expired month, or a continuous placeholder symbol, no new trades are printing on that contract, so the chart looks permanently frozen even though the platform is perfectly healthy." },
    { type: "heading", text: "4. Delayed data instead of live data" },
    { type: "paragraph", html: "If your symbol name shows up in orange, you're on delayed data, not a live feed. Delayed charts jump and stall in ways that mimic a freeze. It happens when a market-data subscription or the required non-professional data agreement hasn't been completed." },
    { type: "heading", text: "5. Too many simultaneous sessions" },
    { type: "paragraph", html: "Logging into the same Tradovate account across the web app, desktop app, mobile app, and TradingView all at once can make sessions collide. When that happens, one of them can freeze, disconnect, or stop refreshing its charts." },
    { type: "heading", text: "How to Fix Tradovate Charts Freezing: Step-by-Step" },
    { type: "paragraph", html: "Work through these in order. The first two clear the large majority of freezes on their own." },
    { type: "heading", text: "Fix 1: Sync your system clock" },
    {
      type: "steps",
      items: [
        { title: "Open date/time settings", html: "Right-click the clock in the Windows taskbar and open the date/time settings, it's usually labeled Adjust date/time." },
        { title: "Turn on automatic time", html: "Turn Set time automatically to On." },
        { title: "Turn on automatic time zone", html: "Turn Set time zone automatically to On as well, and double-check that your time zone is correct." },
        { title: "Sync now", html: "Scroll to Additional settings and click Sync now. You should see a &ldquo;successfully synchronized&rdquo; confirmation with a timestamp." },
        { title: "Restart and check", html: "Restart the Tradovate app (or reload the web app) and check whether charts start ticking again." },
      ],
    },
    { type: "paragraph", html: "If Sync now fails, make sure the Windows Time service is running and that you've got an active internet connection, then try again. A clock that keeps drifting can also point to a dying motherboard battery worth replacing." },
    { type: "heading", text: "Fix 2: Switch to a stable, wired connection" },
    { type: "paragraph", html: "Give the data feed the uninterrupted pipe it needs." },
    {
      type: "steps",
      items: [
        { title: "Plug in an Ethernet cable", html: "Use a cable instead of leaning on Wi-Fi, it delivers a far more reliable, lower-latency data flow." },
        { title: "Power-cycle your modem and router", html: "Unplug both for about 30 seconds, then power them back up to clear temporary network faults." },
        { title: "Update your DNS", html: "Switch to a fast public resolver like Google (8.8.8.8) or Cloudflare (1.1.1.1) if lookups feel slow." },
        { title: "Close bandwidth-heavy background apps", html: "Cloud backups, video calls, and big downloads all compete with your live feed." },
      ],
    },
    { type: "heading", text: "Fix 3: Force Tradovate to reconnect and refresh the chart" },
    { type: "paragraph", html: "If the clock and network are both healthy but a chart is still stuck, rebuild the connection." },
    {
      type: "steps",
      items: [
        { title: "Log out and back in", html: "This tears down and re-establishes the data socket and clears most single-chart freezes." },
        { title: "Reload or restart the app", html: "Hit refresh in the web app, or fully close and reopen the desktop app, to clear a stale local display." },
        { title: "Reset the frozen chart", html: "Right-click the chart and choose the reset/reload option to re-fetch data from the server. The menu item usually reads Reset Chart or something close to it." },
        { title: "Prefer the dedicated desktop app", html: "For heavy sessions, it runs in a cleaner, self-contained environment, free of browser extensions and tab conflicts." },
      ],
    },
    { type: "heading", text: "Fix 4: Rule out contract, data, and session issues" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Confirm the contract month</strong>, switch your chart to the current front-month contract so live ticks resume.",
        "<strong class='text-white'>Fix delayed (orange) data</strong>, complete the required market-data subscription and non-professional agreement so your feed goes live. It can take a short while to activate.",
        "<strong class='text-white'>Kill duplicate sessions</strong>, log out everywhere (web, desktop, mobile, TradingView) and sign back in on a single device so sessions stop colliding.",
      ],
    },
    { type: "heading", text: "Troubleshooting Table" },
    {
      type: "table",
      headers: ["Symptom / state", "What it means", "Fix"],
      rows: [
        ["Chart hangs on &ldquo;Loading&rdquo;", "Clock skew or a broken handshake with the server", "Sync the system clock, then log out and back in"],
        ["Candles stop printing, timestamp frozen", "Live data stream was interrupted", "Switch to wired Ethernet; restart modem/router"],
        ["Buttons unresponsive after wake/sleep", "System clock drifted out of sync", "Turn on automatic time and click Sync now"],
        ["Symbol name shown in orange", "You're on delayed, not live, data", "Complete the market-data subscription and data agreement"],
        ["Chart never updates on one contract", "Expired or wrong contract month", "Roll the chart to the current front-month contract"],
        ["Freezes when TradingView + Tradovate are open together", "Too many simultaneous sessions colliding", "Log out everywhere, sign in on one device"],
        ["Freeze followed by &ldquo;Internal Server Error&rdquo;", "A wider platform/connection outage", "Wait for it to clear, monitor positions on a backup device"],
      ],
    },
    { type: "heading", text: "Prevent This With PickMyTrade" },
    { type: "paragraph", html: "A frozen chart is a display problem, but if your entries and exits live only on that chart, a freeze turns into a trading problem. PickMyTrade keeps order execution independent of your local screen:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Server-Side Execution</strong>, alerts route to Tradovate from our servers, so a frozen chart on your PC doesn't stop your entries or exits from going out.",
        "<strong class='text-white'>Rate-Limit-Safe Routing</strong>, order flow is spaced out so heavy activity doesn't trip Tradovate's request limits and stall your connection.",
        "<strong class='text-white'>Multi-Account Sync</strong>, the same order mirrors across every linked account, so one glitchy session never leaves your accounts out of step.",
        "<strong class='text-white'>Entitlement &amp; Risk Awareness</strong>, respects your data-agreement state and firm limits, so orders don't bounce for reasons that look like a freeze.",
      ],
    },
  ], de: [
    { type: "paragraph", html: "Wenn Sie etwas Schnelles wie ES oder NQ scalpen, ruiniert nichts ein Setup schneller als ein Tradovate-Chart, der einfach stehen bleibt. Kerzen hören auf zu drucken, der letzte Preis bleibt hängen, und das DOM verstummt, während der Markt ohne Sie weiterläuft. Die Bauchreaktion ist anzunehmen, dass die Plattform abgestürzt oder Tradovate &ldquo;down&rdquo; sei. 2026 sind die üblichen Auslöser jedoch banal und lokal: eine Systemuhr, die aus der Synchronisation geraten ist, und eine Internetverbindung, die nicht so stabil ist, wie Sie denken. Im Folgenden finden Sie jede Ursache für eingefrorene Tradovate-Charts, die genaue Lösung dafür und wie das Routen Ihrer Einstiege über eine Automatisierung wie PickMyTrade Orders weiter in Bewegung hält, selbst wenn ein Chart stockt." },
    {
      type: "checklist",
      heading: "Kurzcheckliste für eingefrorene Tradovate-Charts",
      items: [
        "<strong class='text-white'>Systemuhr synchronisieren</strong>, klicken Sie mit der rechten Maustaste auf die Windows-Taskleisten-Uhr, öffnen Sie die Datum-/Uhrzeit-Einstellungen, aktivieren Sie die automatische Zeit und klicken Sie auf Jetzt synchronisieren. Eine falsch eingestellte Uhr allein kann die Plattform zum Hängen bringen.",
        "<strong class='text-white'>Auf kabelgebundenes Ethernet umsteigen</strong>, ein WLAN-Aussetzer, selbst ein einsekündiger, friert den Live-Datenstream ein. Ein Kabel ist das größte Zuverlässigkeits-Upgrade, das Sie vornehmen können.",
        "<strong class='text-white'>Ab- und wieder anmelden</strong>, das zwingt Tradovate, den Daten-Socket neu aufzubauen, und löst meist sofort einen eingefrorenen Chart.",
        "<strong class='text-white'>Kontraktmonat prüfen</strong>, ein abgelaufener oder falscher Kontrakt zeigt einen toten Chart, weil keine neuen Ticks eingehen.",
        "<strong class='text-white'>Auf orangefarbene Symbole achten</strong>, ein orangefarbener Symbolname bedeutet verzögerte (nicht Live-)Daten, was einem Einfrieren sehr ähnlich sieht.",
        "<strong class='text-white'>Doppelte Sitzungen schließen</strong>, gleichzeitig auf Web, Desktop, Mobile und TradingView angemeldet zu sein, kann kollidieren und Ihre Charts ins Stocken bringen.",
      ],
    },
    { type: "heading", text: "Was „eingefrorene Tradovate-Charts“ tatsächlich bedeutet" },
    { type: "paragraph", html: "Es gibt selten eine Fehler-Popup-Meldung, wenn ein Tradovate-Chart einfriert. Sie bemerken einfach die Symptome: Die jüngste Kerze hört auf, sich weiterzubewegen, der Zeitstempel in der Ecke tickt nicht mehr weiter, die DOM-Leiter steht still, und Schaltflächen fühlen sich tot an oder der Bildschirm bleibt bei Loading hängen. Auf dem Papier ist das Konto oft noch &ldquo;verbunden,&rdquo; was es so verwirrend macht, Ihre Plattform wirkt lebendig, während die Daten darunter gestoppt sind." },
    { type: "paragraph", html: "Im Hintergrund benötigt eine Handelsplattform eine konstante, ununterbrochene Verbindung sowohl zum Marktdaten-Server als auch zum Konto-Server. In dem Moment, in dem dieser Stream unterbrochen wird, ein verlorenes Paket, ein WLAN-Aussetzer oder eine Diskrepanz zwischen Ihrem PC und Tradovates Servern, hat der Chart nichts Neues zu zeichnen, sodass er beim letzten erhaltenen Frame einfriert. Zwei Dinge stören dieses Handshake mehr als alles andere: die Uhr Ihres Computers und Ihr Netzwerk." },
    { type: "heading", text: "Häufigste Ursachen für eingefrorene Tradovate-Charts" },
    { type: "heading", text: "1. Eine nicht synchronisierte Systemuhr" },
    { type: "paragraph", html: "Das ist die heimtückische Ursache. Sichere Verbindungen und Sitzungs-Token hängen davon ab, dass die Uhr Ihres Computers eng mit der des Servers übereinstimmt. Ist die PC-Zeit verschoben, was nach Schlaf-/Aufwach-Zyklen, bei einer toten CMOS-Batterie oder wenn die Uhr manuell eingestellt wurde, passieren kann, kann Tradovate bei Loading hängen bleiben, Schaltflächen reaktionslos lassen oder Charts still nicht mehr aktualisieren. Da mit Ihrem Internet nichts falsch aussieht, ist die Uhr das Letzte, das jemand vermutet." },
    { type: "heading", text: "2. Eine instabile oder drahtlose Netzwerkverbindung" },
    { type: "paragraph", html: "Charts streamen Live-Ticks, sodass jede Unterbrechung sofort sichtbar wird. WLAN ist der übliche Verdächtige: Ein kurzer Signalabfall, Router-Überlastung oder ein Hintergrund-Download können den Feed lange genug aushungern, um die Anzeige einzufrieren. Ein unzuverlässiges Modem, ein überlasteter Router oder langsame DNS-Abfragen führen alle zum gleichen Ergebnis." },
    { type: "heading", text: "3. Ein abgelaufener oder falscher Kontraktmonat" },
    { type: "paragraph", html: "Futures-Kontrakte rollieren. Zeigt Ihr Chart noch auf einen abgelaufenen Monat oder ein kontinuierliches Platzhaltersymbol, werden auf diesem Kontrakt keine neuen Trades gedruckt, sodass der Chart dauerhaft eingefroren wirkt, obwohl die Plattform vollkommen gesund ist." },
    { type: "heading", text: "4. Verzögerte statt Live-Daten" },
    { type: "paragraph", html: "Erscheint Ihr Symbolname in Orange, befinden Sie sich auf verzögerten Daten, nicht auf einem Live-Feed. Verzögerte Charts springen und stocken auf eine Weise, die ein Einfrieren imitiert. Das passiert, wenn ein Marktdaten-Abonnement oder die erforderliche Nicht-Profi-Datenvereinbarung nicht abgeschlossen wurde." },
    { type: "heading", text: "5. Zu viele gleichzeitige Sitzungen" },
    { type: "paragraph", html: "Sich gleichzeitig mit demselben Tradovate-Konto in der Web-App, der Desktop-App, der Mobile-App und TradingView anzumelden, kann Sitzungen kollidieren lassen. Passiert das, kann eine davon einfrieren, sich trennen oder ihre Charts nicht mehr aktualisieren." },
    { type: "heading", text: "So beheben Sie eingefrorene Tradovate-Charts: Schritt für Schritt" },
    { type: "paragraph", html: "Arbeiten Sie diese der Reihe nach ab. Die ersten beiden beheben allein bereits die große Mehrheit der Einfrierungen." },
    { type: "heading", text: "Lösung 1: Systemuhr synchronisieren" },
    {
      type: "steps",
      items: [
        { title: "Datum-/Uhrzeit-Einstellungen öffnen", html: "Klicken Sie mit der rechten Maustaste auf die Uhr in der Windows-Taskleiste und öffnen Sie die Datum-/Uhrzeit-Einstellungen, meist als Datum/Uhrzeit anpassen bezeichnet." },
        { title: "Automatische Zeit aktivieren", html: "Schalten Sie Uhrzeit automatisch festlegen auf Ein." },
        { title: "Automatische Zeitzone aktivieren", html: "Schalten Sie auch Zeitzone automatisch festlegen auf Ein und prüfen Sie noch einmal, ob Ihre Zeitzone korrekt ist." },
        { title: "Jetzt synchronisieren", html: "Scrollen Sie zu Zusätzliche Einstellungen und klicken Sie auf Jetzt synchronisieren. Sie sollten eine Bestätigung „erfolgreich synchronisiert“ mit Zeitstempel sehen." },
        { title: "Neu starten und prüfen", html: "Starten Sie die Tradovate-App neu (oder laden Sie die Web-App neu) und prüfen Sie, ob die Charts wieder zu ticken beginnen." },
      ],
    },
    { type: "paragraph", html: "Schlägt Jetzt synchronisieren fehl, stellen Sie sicher, dass der Windows-Zeitdienst läuft und Sie eine aktive Internetverbindung haben, und versuchen Sie es dann erneut. Eine Uhr, die ständig abdriftet, kann auch auf eine sterbende Motherboard-Batterie hinweisen, die einen Austausch wert ist." },
    { type: "heading", text: "Lösung 2: Auf eine stabile, kabelgebundene Verbindung umsteigen" },
    { type: "paragraph", html: "Geben Sie dem Datenfeed die ununterbrochene Verbindung, die er braucht." },
    {
      type: "steps",
      items: [
        { title: "Ein Ethernet-Kabel anschließen", html: "Nutzen Sie ein Kabel statt sich auf WLAN zu verlassen, es liefert einen weit zuverlässigeren Datenfluss mit geringerer Latenz." },
        { title: "Modem und Router neu starten", html: "Ziehen Sie beide etwa 30 Sekunden lang aus der Steckdose und schalten Sie sie dann wieder ein, um vorübergehende Netzwerkfehler zu beheben." },
        { title: "DNS aktualisieren", html: "Wechseln Sie zu einem schnellen öffentlichen Resolver wie Google (8.8.8.8) oder Cloudflare (1.1.1.1), wenn Abfragen langsam wirken." },
        { title: "Bandbreitenintensive Hintergrund-Apps schließen", html: "Cloud-Backups, Videoanrufe und große Downloads konkurrieren alle mit Ihrem Live-Feed." },
      ],
    },
    { type: "heading", text: "Lösung 3: Tradovate zur erneuten Verbindung und Chart-Aktualisierung zwingen" },
    { type: "paragraph", html: "Sind Uhr und Netzwerk beide in Ordnung, ein Chart aber weiterhin hängen bleibt, bauen Sie die Verbindung neu auf." },
    {
      type: "steps",
      items: [
        { title: "Ab- und wieder anmelden", html: "Das baut den Daten-Socket ab und neu auf und behebt die meisten Einzel-Chart-Einfrierungen." },
        { title: "App neu laden oder neu starten", html: "Klicken Sie in der Web-App auf Neu laden, oder schließen und öffnen Sie die Desktop-App vollständig neu, um eine veraltete lokale Anzeige zu beheben." },
        { title: "Eingefrorenen Chart zurücksetzen", html: "Klicken Sie mit der rechten Maustaste auf den Chart und wählen Sie die Zurücksetzen-/Neuladen-Option, um Daten erneut vom Server abzurufen. Der Menüpunkt lautet üblicherweise Chart zurücksetzen oder ähnlich." },
        { title: "Die dedizierte Desktop-App bevorzugen", html: "Für intensive Sitzungen läuft sie in einer saubereren, in sich geschlossenen Umgebung, frei von Browser-Erweiterungen und Tab-Konflikten." },
      ],
    },
    { type: "heading", text: "Lösung 4: Kontrakt-, Daten- und Sitzungsprobleme ausschließen" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Kontraktmonat bestätigen</strong>, wechseln Sie Ihren Chart zum aktuellen Frontmonat-Kontrakt, damit Live-Ticks wieder eingehen.",
        "<strong class='text-white'>Verzögerte (orangefarbene) Daten beheben</strong>, schließen Sie das erforderliche Marktdaten-Abonnement und die Nicht-Profi-Vereinbarung ab, damit Ihr Feed live geht. Die Aktivierung kann eine Weile dauern.",
        "<strong class='text-white'>Doppelte Sitzungen beenden</strong>, melden Sie sich überall ab (Web, Desktop, Mobile, TradingView) und wieder auf nur einem Gerät an, damit Sitzungen nicht mehr kollidieren.",
      ],
    },
    { type: "heading", text: "Fehlerbehebungstabelle" },
    {
      type: "table",
      headers: ["Symptom / Zustand", "Was es bedeutet", "Lösung"],
      rows: [
        ["Chart bleibt bei „Loading“ hängen", "Uhrabweichung oder gestörtes Handshake mit dem Server", "Systemuhr synchronisieren, dann ab- und wieder anmelden"],
        ["Kerzen hören auf zu drucken, Zeitstempel eingefroren", "Live-Datenstream wurde unterbrochen", "Auf kabelgebundenes Ethernet umsteigen; Modem/Router neu starten"],
        ["Schaltflächen nach Aufwachen/Ruhezustand reaktionslos", "Systemuhr aus der Synchronisation geraten", "Automatische Zeit aktivieren und auf Jetzt synchronisieren klicken"],
        ["Symbolname wird orange angezeigt", "Sie befinden sich auf verzögerten, nicht Live-Daten", "Marktdaten-Abonnement und Datenvereinbarung abschließen"],
        ["Chart aktualisiert sich bei einem Kontrakt nie", "Abgelaufener oder falscher Kontraktmonat", "Chart auf den aktuellen Frontmonat-Kontrakt rollieren"],
        ["Friert ein, wenn TradingView + Tradovate gleichzeitig geöffnet sind", "Zu viele gleichzeitige Sitzungen kollidieren", "Überall abmelden, auf einem Gerät anmelden"],
        ["Einfrieren gefolgt von „Internal Server Error“", "Eine umfassendere Plattform-/Verbindungsstörung", "Abwarten, bis es behoben ist, Positionen auf einem Ausweichgerät überwachen"],
      ],
    },
    { type: "heading", text: "So verhindern Sie das mit PickMyTrade" },
    { type: "paragraph", html: "Ein eingefrorener Chart ist ein Anzeigeproblem, aber wenn Ihre Ein- und Ausstiege nur auf diesem Chart existieren, wird aus einem Einfrieren ein Handelsproblem. PickMyTrade hält die Order-Ausführung unabhängig von Ihrem lokalen Bildschirm:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Serverseitige Ausführung</strong>, Alerts werden von unseren Servern an Tradovate geleitet, sodass ein eingefrorener Chart auf Ihrem PC Ihre Ein- oder Ausstiege nicht davon abhält, hinauszugehen.",
        "<strong class='text-white'>Rate-Limit-sicheres Routing</strong>, der Orderfluss wird zeitlich gestaffelt, sodass hohe Aktivität Tradovates Anfragelimits nicht auslöst und Ihre Verbindung nicht blockiert.",
        "<strong class='text-white'>Multi-Konto-Synchronisierung</strong>, dieselbe Order spiegelt sich über jedes verknüpfte Konto, sodass eine fehlerhafte Sitzung Ihre Konten nie aus dem Takt bringt.",
        "<strong class='text-white'>Berechtigungs- &amp; Risikobewusstsein</strong>, respektiert Ihren Datenvereinbarungsstatus und Firmenlimits, sodass Orders nicht aus Gründen abgelehnt werden, die wie ein Einfrieren aussehen.",
      ],
