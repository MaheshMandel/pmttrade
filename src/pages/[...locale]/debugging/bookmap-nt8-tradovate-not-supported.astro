---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "bookmap-nt8-tradovate-not-supported";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/debugging/${SLUG}`;

const META_TITLE = "Bookmap + NT8 + Tradovate Setup Not Supported";
const META_DESCRIPTION =
  "Running Bookmap through NinjaTrader 8 to reach Tradovate isn't supported. Connect Bookmap straight to Tradovate or NinjaTrader instead, here's how.";

// Short SEO title (<=60 chars) for locales where the shared h1 is too long for a SERP title.
const TITLE_OVERRIDE: Partial<Record<Locale, string>> = { es: "Bookmap + NT8 + Tradovate: configuración no compatible" };

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Bookmap + NT8 + Tradovate-Setup nicht unterstützt", es: "La configuración de Bookmap + NT8 + Tradovate no es compatible", fr: "Configuration Bookmap + NT8 + Tradovate non prise en charge", it: "Configurazione Bookmap + NT8 + Tradovate non supportata" },
  dek: { en: "Bookmap doesn't chain through NinjaTrader to reach Tradovate, and no amount of data-plan tinkering builds that route. Here's why, and the two direct connections that actually work.", de: "Bookmap lässt sich nicht über NinjaTrader mit Tradovate verketten, und auch das Herumprobieren mit Datenpaketen baut diese Route nicht. Hier erfahren Sie, warum, und welche beiden direkten Verbindungen tatsächlich funktionieren.", es: "Bookmap no se puede encadenar a través de NinjaTrader para llegar a Tradovate, y por más que ajuste su plan de datos, esa ruta no se crea. Le explicamos por qué, y cuáles son las dos conexiones directas que sí funcionan.", fr: "Bookmap ne peut pas passer par NinjaTrader pour atteindre Tradovate, et aucun ajustement de votre forfait de données ne créera cette route. Voici pourquoi, et les deux connexions directes qui fonctionnent réellement.", it: "Bookmap non può essere collegato a Tradovate passando per NinjaTrader, e nessun intervento sul piano dati creerà questo percorso. Ecco perché, e quali sono le due connessioni dirette che funzionano davvero." },
  readTime: { en: "8 min read", de: "8 Minuten Lesezeit", es: "Lectura de 8 minutos", fr: "Lecture de 8 minutes", it: "Lettura di 8 minuti" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "You've got NinjaTrader 8 talking to your Tradovate account, and now you want Bookmap's heatmap sitting on top of that same feed, so you go looking for the setting that lets Bookmap borrow NinjaTrader's Tradovate connection, and it just isn't there. You'll hit it in a few flavors: “this connection doesn't seem possible,” “there's no guide for it,” or the hopeful assumption that paying to bump Level 1 up to Level 2 will finally light it up. Here's the short version, and I'll save you a support ticket: <strong class='text-white'>Bookmap doesn't chain through NinjaTrader to reach Tradovate.</strong> That three-app route isn't a supported configuration in 2026, and no amount of data-plan tinkering builds it. The good news is that both pieces you actually want, Bookmap on Tradovate, or Bookmap on NinjaTrader, work great as their own direct connections. Below I'll show you why the chain fails, exactly what to set up instead, and how to keep your order flow automated no matter which desktop app is charting." },
    {
      type: "checklist",
      heading: "Quick Checklist for the Bookmap + NT8 + Tradovate Setup",
      items: [
        "<strong class='text-white'>Stop trying to chain the three apps.</strong> Bookmap has no path that routes through NinjaTrader to grab your Tradovate connection, it isn't a supported setup.",
        "<strong class='text-white'>Pick one direct connection.</strong> Connect Bookmap <em>straight to Tradovate</em>, or <em>straight to NinjaTrader</em>, not one through the other.",
        "<strong class='text-white'>For Tradovate order flow in Bookmap</strong>, install Bookmap's Tradovate adapter and log in with your Tradovate/prop platform credentials.",
        "<strong class='text-white'>For NinjaTrader data in Bookmap</strong>, install Bookmap's NinjaTrader adapter and NinjaScript (Bookmap 7.3+); the depth you get depends on NinjaTrader's own feed.",
        "<strong class='text-white'>Don't expect full depth from Tradovate</strong>, it feeds Bookmap partial-depth CME data; use dxFeed, Rithmic, or CQG for data if you want a deeper book.",
        "<strong class='text-white'>Ask Bookmap, not NinjaTrader.</strong> The connection lives on Bookmap's side, so Bookmap support owns this question.",
      ],
    },
    { type: "heading", text: "What “Not Supported” Actually Means Here" },
    { type: "paragraph", html: "“Not supported” doesn't mean a button is broken or you fat-fingered a password. It means the specific arrangement you're picturing, Bookmap reading data and sending orders <em>via</em> NinjaTrader's live Tradovate session, was never built. There's no adapter for it, no NinjaScript for it, and no documentation for it, because it isn't a real signal path." },
    { type: "paragraph", html: "The reason is simpler than it looks once you see how Bookmap connects to anything. Bookmap talks to each broker or data vendor through its own dedicated adapter. There's a Tradovate adapter. There's a separate NinjaTrader adapter. Each one is a standalone connection that stands on its own two feet. Neither adapter reaches <em>through</em> the other. So when you connect Bookmap to NinjaTrader, Bookmap sees whatever NinjaTrader's licensed data feed hands it, it does not reach past NinjaTrader to open a fresh pipe into your Tradovate account." },
    { type: "paragraph", html: "That's why NinjaTrader's own support desk answers this exact question by sending you to Bookmap: the missing link isn't on the NinjaTrader side, it's that Bookmap simply doesn't offer a Tradovate-by-way-of-NinjaTrader mode. Once that clicks, the fix is obvious, stop trying to bridge three apps and connect Bookmap directly to the one you care about." },
    { type: "heading", text: "Top Causes of the Bookmap + NT8 + Tradovate Roadblock" },
    { type: "heading", text: "1. Bookmap's Adapters Are Standalone, Not Stackable" },
    { type: "paragraph", html: "This is the whole story in one line. Bookmap connects to Tradovate through the Tradovate adapter and to NinjaTrader through the NinjaTrader adapter, and those two are independent. There's no “use my NinjaTrader connection's Tradovate account” option because adapters don't nest inside each other. If you want Tradovate in Bookmap, you open the Tradovate adapter, full stop." },
    { type: "heading", text: "2. You're Treating NinjaTrader as a Data Gateway It Isn't" },
    { type: "paragraph", html: "A lot of people assume that because NinjaTrader is connected to Tradovate, anything connected to NinjaTrader inherits that Tradovate feed. It doesn't work that way for Bookmap. When Bookmap connects to NinjaTrader, it consumes NinjaTrader's <em>own</em> market data, whatever feed and entitlement NinjaTrader is licensed for, not a re-broadcast of your Tradovate session." },
    { type: "heading", text: "3. The Level 1 vs Level 2 Detour" },
    { type: "paragraph", html: "The classic wrong turn: “It only shows Level 1, so if I buy Level 2 the whole Bookmap-NinjaTrader-Tradovate thing will work.” Upgrading depth on your NinjaTrader feed genuinely changes how many levels Bookmap can paint (Level 2 is what shows full depth, up to 10 levels), but it does nothing to create a supported route from Bookmap through NinjaTrader into Tradovate. You'd be paying to improve a path that still doesn't lead where you want." },
    { type: "heading", text: "4. Tradovate's Depth Is Partial, Even Direct" },
    { type: "paragraph", html: "Even when you connect Bookmap straight to Tradovate the way you're supposed to, Tradovate feeds Bookmap <em>partial-depth</em> CME futures data, not the full order book a heatmap trader usually wants. So if your real goal is a rich depth-of-market picture, Tradovate-as-data alone may underwhelm you regardless of how you wire it. That's a data-source limitation, not a connection bug." },
    { type: "heading", text: "5. License Tier and Symbol Permissions" },
    { type: "paragraph", html: "Bookmap plans and data subscriptions govern which instruments and which depth you're allowed to see. If a symbol won't load after you connect, that's usually a licensing or entitlement question on the Bookmap and exchange side, a separate issue from the “not supported” chain, and one Bookmap support can sort out quickly." },
    { type: "heading", text: "How to Fix the Bookmap + Tradovate Setup in 2026: Step-by-Step" },
    { type: "heading", text: "Option A: Connect Bookmap Directly to Tradovate (Recommended)" },
    { type: "paragraph", html: "This is the clean, supported path when you want your Tradovate account inside Bookmap. Skip NinjaTrader entirely." },
    {
      type: "steps",
      items: [
        { title: "Open the connections area", html: "Open Bookmap and go to the connections area (the panel where you add and manage broker/data adapters)." },
        { title: "Install the Tradovate adapter", html: "Find and install the <strong class='text-white'>Tradovate</strong> adapter from Bookmap's connection list, then enable it." },
        { title: "Log in with your Tradovate credentials", html: "Log in with your <strong class='text-white'>Tradovate platform credentials</strong>, for a prop or evaluation account, use the trading login your firm issued for third-party software, not your dashboard email if the two differ." },
        { title: "Choose your connection mode", html: "Choose your connection mode: use <strong class='text-white'>Tradovate for both data and trading</strong>, or use <strong class='text-white'>Tradovate for order routing only</strong> and pick a separate data provider (see Option C)." },
        { title: "Enter symbols and enable trading", html: "Enter instrument symbols in the format Bookmap expects, confirm the connection turns active, and enable trading mode if you plan to send orders from Bookmap." },
      ],
    },
    { type: "heading", text: "Option B: Connect Bookmap Directly to NinjaTrader 8" },
    { type: "paragraph", html: "Use this when you specifically want NinjaTrader's data feed in Bookmap (not Tradovate's). It's a direct Bookmap-to-NinjaTrader link, and it stands alone." },
    {
      type: "steps",
      items: [
        { title: "Confirm you're on Bookmap 7.3+", html: "Make sure you're on <strong class='text-white'>Bookmap 7.3 or later</strong>, which is the floor for NinjaTrader 8 integration." },
        { title: "Install the NinjaTrader adapter", html: "Install Bookmap's <strong class='text-white'>NinjaTrader</strong> adapter inside Bookmap." },
        { title: "Import the Bookmap NinjaScript", html: "Import the <strong class='text-white'>Bookmap NinjaScript</strong> into NinjaTrader 8 so the two apps can talk." },
        { title: "Start the connection", html: "Start the connection in Bookmap. Remember the depth you get is whatever your NinjaTrader feed licenses, Level 1 shows top of book, Level 2 shows full depth up to 10 levels." },
        { title: "Nudge a blank heatmap", html: "If the heatmap stays empty, confirm the market is open, wait for a tick, and press <strong class='text-white'>F5</strong> on your NinjaTrader chart to nudge the data through." },
      ],
    },
    { type: "heading", text: "Option C: Keep Tradovate for Orders, Add a Full-Depth Data Feed" },
    { type: "paragraph", html: "If you want Tradovate execution but a deeper book than its partial-depth feed provides, split the roles inside Bookmap:" },
    {
      type: "steps",
      items: [
        { title: "Set Tradovate as execution", html: "Set up the <strong class='text-white'>Tradovate</strong> adapter as your <strong class='text-white'>order-routing / execution</strong> connection." },
        { title: "Add a full-depth data connection", html: "Add a dedicated <strong class='text-white'>market-data</strong> connection, <strong class='text-white'>dxFeed, Rithmic, or CQG</strong> are the common full-depth choices for CME futures." },
        { title: "Confirm both connections are active", html: "Confirm both connections are active, with data coming from the depth provider and orders going to Tradovate." },
        { title: "Check your plan covers it", html: "Double-check that your Bookmap plan and data subscription permit the symbols and depth you're after." },
      ],
    },
    { type: "heading", text: "Still Stuck? Take It to Bookmap" },
    { type: "paragraph", html: "Because every one of these connections lives on Bookmap's side, Bookmap support is the right desk, and it's exactly where NinjaTrader will send you anyway. Ask them to confirm which adapter matches your account, which data subscription you need for the depth you want, and whether your license tier covers your symbols. That one conversation clears up most of the “why won't this connect” confusion far faster than another round of settings-poking." },
    { type: "heading", text: "Troubleshooting Table" },
    {
      type: "table",
      headers: ["What you see", "What it means", "Fix"],
      rows: [
        ["“This connection doesn't seem possible” / no guide exists", "Bookmap has no adapter that routes through NinjaTrader to reach Tradovate", "Connect Bookmap directly to Tradovate, or directly to NinjaTrader, as separate connections"],
        ["NinjaTrader support tells you to contact Bookmap", "The connection lives on Bookmap's side, not NinjaTrader's", "Open a ticket with Bookmap support for adapter and subscription guidance"],
        ["Only Level 1 shows; buying Level 2 doesn't “unlock” the chain", "Depth upgrades affect the NinjaTrader feed, not a Tradovate-via-NinjaTrader route", "Connect straight to Tradovate for its feed, or use a full-depth data provider"],
        ["Heatmap looks shallow even on a direct Tradovate connection", "Tradovate sends Bookmap partial-depth CME data, not the full book", "Route orders via Tradovate, take data from dxFeed, Rithmic, or CQG"],
        ["Symbol won't load after connecting", "License tier or exchange data entitlement doesn't permit that instrument", "Confirm your Bookmap plan and data subscription cover the symbol"],
        ["NinjaTrader-fed heatmap stays blank", "No tick has arrived yet or the chart needs a refresh", "Confirm the market is open, wait for a tick, press F5 on the NinjaTrader chart"],
      ],
    },
    { type: "heading", text: "Prevent This With PickMyTrade" },
    { type: "paragraph", html: "The reason this setup trips people up is that they're trying to bolt three desktop apps together just to get their strategy's orders onto Tradovate. If order execution is the real goal, you don't need Bookmap or NinjaTrader in that path at all. PickMyTrade takes your TradingView alerts and sends them straight to Tradovate, so your fills never hinge on a fragile app-to-app-to-broker chain:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Direct Alert-to-Tradovate Routing</strong>, orders reach your Tradovate account without hopping through a charting app that isn't built to relay them.",
        "<strong class='text-white'>Keep Bookmap for What It's Good At</strong>, read the order-flow heatmap in Bookmap while your entries and exits fire automatically through a dedicated bridge.",
        "<strong class='text-white'>Environment &amp; Account Mapping</strong>, point each strategy at the correct Tradovate account and environment so live vs. simulation mix-ups don't cost you.",
        "<strong class='text-white'>Multi-Account Sync</strong>, mirror the same order across several accounts at once, no extra desktop plumbing required.",
      ],
    },
  ], de: [
    { type: "paragraph", html: "Sie haben NinjaTrader 8 mit Ihrem Tradovate-Konto verbunden, und jetzt möchten Sie Bookmaps Heatmap zusätzlich auf demselben Feed laufen lassen. Also suchen Sie nach der Einstellung, mit der Bookmap die Tradovate-Verbindung von NinjaTrader mitnutzt, und finden sie einfach nicht. Sie stoßen dabei auf verschiedene Varianten: „Diese Verbindung scheint nicht möglich zu sein”, „Dafür gibt es keine Anleitung” oder die hoffnungsvolle Annahme, dass ein Upgrade von Level 1 auf Level 2 das Problem endlich löst. Hier die Kurzfassung, die Ihnen ein Support-Ticket erspart: <strong class='text-white'>Bookmap lässt sich nicht über NinjaTrader mit Tradovate verketten.</strong> Diese Drei-Apps-Route ist 2026 keine unterstützte Konfiguration, und kein Herumprobieren mit Datenpaketen baut sie auf. Die gute Nachricht: Beide Bausteine, die Sie eigentlich wollen, Bookmap mit Tradovate oder Bookmap mit NinjaTrader, funktionieren hervorragend als eigenständige direkte Verbindungen. Im Folgenden zeige ich Ihnen, warum die Verkettung scheitert, was Sie stattdessen einrichten sollten, und wie Sie Ihren Orderfluss automatisiert halten, egal welche Desktop-App gerade chartet." },
    {
      type: "checklist",
      heading: "Kurz-Checkliste für das Bookmap + NT8 + Tradovate-Setup",
      items: [
        "<strong class='text-white'>Hören Sie auf, die drei Apps zu verketten.</strong> Bookmap hat keinen Weg, der über NinjaTrader läuft, um Ihre Tradovate-Verbindung zu übernehmen, das ist kein unterstütztes Setup.",
        "<strong class='text-white'>Wählen Sie eine direkte Verbindung.</strong> Verbinden Sie Bookmap <em>direkt mit Tradovate</em> oder <em>direkt mit NinjaTrader</em>, nicht eines über das andere.",
        "<strong class='text-white'>Für den Tradovate-Orderfluss in Bookmap</strong> installieren Sie Bookmaps Tradovate-Adapter und melden sich mit Ihren Tradovate-/Prop-Plattform-Zugangsdaten an.",
        "<strong class='text-white'>Für NinjaTrader-Daten in Bookmap</strong> installieren Sie Bookmaps NinjaTrader-Adapter und das NinjaScript (Bookmap 7.3+); die Tiefe, die Sie erhalten, hängt von NinjaTraders eigenem Feed ab.",
        "<strong class='text-white'>Erwarten Sie keine volle Tiefe von Tradovate</strong>, es liefert Bookmap nur CME-Daten mit Teiltiefe; nutzen Sie dxFeed, Rithmic oder CQG für Daten, wenn Sie ein tieferes Orderbuch wollen.",
        "<strong class='text-white'>Fragen Sie Bookmap, nicht NinjaTrader.</strong> Die Verbindung liegt auf Bookmaps Seite, daher ist der Bookmap-Support für diese Frage zuständig.",
      ],
    },
    { type: "heading", text: "Was „nicht unterstützt” hier wirklich bedeutet" },
    { type: "paragraph", html: "„Nicht unterstützt” bedeutet nicht, dass ein Button defekt ist oder Sie sich beim Passwort vertippt haben. Es bedeutet, dass genau die Konstellation, die Sie sich vorstellen, Bookmap liest Daten und sendet Orders <em>über</em> NinjaTraders laufende Tradovate-Sitzung, nie gebaut wurde. Es gibt dafür keinen Adapter, kein NinjaScript und keine Dokumentation, weil es schlicht keinen echten Signalpfad dafür gibt." },
    { type: "paragraph", html: "Der Grund ist einfacher, als es aussieht, sobald man versteht, wie Bookmap sich generell verbindet. Bookmap spricht mit jedem Broker oder Datenanbieter über einen eigenen dedizierten Adapter. Es gibt einen Tradovate-Adapter. Es gibt einen separaten NinjaTrader-Adapter. Jeder davon ist eine eigenständige Verbindung, die für sich alleine steht. Kein Adapter reicht <em>durch</em> den anderen hindurch. Wenn Sie Bookmap also mit NinjaTrader verbinden, sieht Bookmap genau das, was NinjaTraders lizenzierter Datenfeed liefert, es greift nicht über NinjaTrader hinaus, um eine neue Verbindung zu Ihrem Tradovate-Konto zu öffnen." },
    { type: "paragraph", html: "Deshalb verweist Sie der eigene Support von NinjaTrader bei genau dieser Frage an Bookmap: Das fehlende Glied liegt nicht auf der NinjaTrader-Seite, sondern daran, dass Bookmap schlicht keinen Modus „Tradovate über NinjaTrader” anbietet. Sobald das klar ist, ist die Lösung offensichtlich: Hören Sie auf, drei Apps zu verbinden, und schließen Sie Bookmap direkt an die eine App an, auf die es Ihnen wirklich ankommt." },
    { type: "heading", text: "Häufigste Ursachen für das Bookmap + NT8 + Tradovate-Problem" },
    { type: "heading", text: "1. Bookmaps Adapter sind eigenständig, nicht stapelbar" },
    { type: "paragraph", html: "Das ist die ganze Geschichte in einem Satz. Bookmap verbindet sich mit Tradovate über den Tradovate-Adapter und mit NinjaTrader über den NinjaTrader-Adapter, und diese beiden sind unabhängig voneinander. Es gibt keine Option „Tradovate-Konto meiner NinjaTrader-Verbindung nutzen”, weil sich Adapter nicht ineinander verschachteln lassen. Wenn Sie Tradovate in Bookmap wollen, öffnen Sie den Tradovate-Adapter, Punkt." },
    { type: "heading", text: "2. Sie behandeln NinjaTrader als Daten-Gateway, das es nicht ist" },
    { type: "paragraph", html: "Viele gehen davon aus, dass alles, was mit NinjaTrader verbunden ist, automatisch den Tradovate-Feed erbt, weil NinjaTrader mit Tradovate verbunden ist. Für Bookmap funktioniert das nicht so. Wenn Bookmap sich mit NinjaTrader verbindet, nutzt es NinjaTraders <em>eigene</em> Marktdaten, also genau den Feed und die Berechtigung, für die NinjaTrader lizenziert ist, und nicht eine Weiterleitung Ihrer Tradovate-Sitzung." },
    { type: "heading", text: "3. Der Umweg über Level 1 vs. Level 2" },
    { type: "paragraph", html: "Der klassische Irrweg: „Es zeigt nur Level 1, also wird alles funktionieren, wenn ich auf Level 2 upgrade.” Ein Upgrade der Tiefe Ihres NinjaTrader-Feeds ändert tatsächlich, wie viele Ebenen Bookmap darstellen kann (Level 2 zeigt die volle Tiefe, bis zu 10 Ebenen), schafft aber keinen unterstützten Weg von Bookmap über NinjaTrader zu Tradovate. Sie würden dafür bezahlen, einen Pfad zu verbessern, der trotzdem nicht dorthin führt, wo Sie hinwollen." },
    { type: "heading", text: "4. Tradovates Tiefe ist selbst direkt nur teilweise" },
    { type: "paragraph", html: "Selbst wenn Sie Bookmap wie vorgesehen direkt mit Tradovate verbinden, liefert Tradovate Bookmap nur <em>Teiltiefe</em>-CME-Futures-Daten, nicht das vollständige Orderbuch, das Heatmap-Trader in der Regel wollen. Wenn Ihr eigentliches Ziel also ein reichhaltiges Depth-of-Market-Bild ist, wird Tradovate allein als Datenquelle Sie unabhängig von der Verkabelung enttäuschen. Das ist eine Einschränkung der Datenquelle, kein Verbindungsfehler." },
    { type: "heading", text: "5. Lizenzstufe und Symbolberechtigungen" },
    { type: "paragraph", html: "Bookmap-Pläne und Datenabonnements bestimmen, welche Instrumente und welche Tiefe Sie sehen dürfen. Lädt ein Symbol nach dem Verbinden nicht, ist das meist eine Lizenz- oder Berechtigungsfrage auf Bookmap- und Börsenseite, ein separates Thema, losgelöst von der „nicht unterstützten” Verkettung, das der Bookmap-Support schnell klären kann." },
    { type: "heading", text: "So richten Sie das Bookmap + Tradovate-Setup 2026 korrekt ein: Schritt für Schritt" },
    { type: "heading", text: "Option A: Bookmap direkt mit Tradovate verbinden (empfohlen)" },
    { type: "paragraph", html: "Das ist der saubere, unterstützte Weg, wenn Sie Ihr Tradovate-Konto in Bookmap nutzen möchten. Lassen Sie NinjaTrader dabei komplett aus." },
    {
      type: "steps",
      items: [
        { title: "Öffnen Sie den Verbindungsbereich", html: "Öffnen Sie Bookmap und gehen Sie zum Verbindungsbereich (dem Bereich, in dem Sie Broker-/Datenadapter hinzufügen und verwalten)." },
        { title: "Installieren Sie den Tradovate-Adapter", html: "Suchen und installieren Sie den <strong class='text-white'>Tradovate</strong>-Adapter aus Bookmaps Verbindungsliste und aktivieren Sie ihn anschließend." },
        { title: "Melden Sie sich mit Ihren Tradovate-Zugangsdaten an", html: "Melden Sie sich mit Ihren <strong class='text-white'>Tradovate-Plattform-Zugangsdaten</strong> an. Bei einem Prop- oder Evaluierungskonto verwenden Sie den Trading-Login, den Ihre Firma für Drittanbieter-Software ausgestellt hat, nicht Ihre Dashboard-E-Mail, falls sich beide unterscheiden." },
        { title: "Wählen Sie Ihren Verbindungsmodus", html: "Wählen Sie Ihren Verbindungsmodus: Nutzen Sie <strong class='text-white'>Tradovate für Daten und Handel</strong>, oder nutzen Sie <strong class='text-white'>Tradovate nur für das Order-Routing</strong> und wählen Sie einen separaten Datenanbieter (siehe Option C)." },
        { title: "Geben Sie Symbole ein und aktivieren Sie den Handel", html: "Geben Sie Instrumentensymbole im von Bookmap erwarteten Format ein, bestätigen Sie, dass die Verbindung aktiv wird, und aktivieren Sie den Handelsmodus, wenn Sie Orders aus Bookmap senden möchten." },
      ],
    },
    { type: "heading", text: "Option B: Bookmap direkt mit NinjaTrader 8 verbinden" },
    { type: "paragraph", html: "Nutzen Sie das, wenn Sie speziell NinjaTraders Datenfeed in Bookmap wollen (nicht den von Tradovate). Es ist eine direkte Bookmap-zu-NinjaTrader-Verbindung, die für sich alleine steht." },
    {
      type: "steps",
      items: [
        { title: "Bestätigen Sie, dass Sie Bookmap 7.3+ nutzen", html: "Stellen Sie sicher, dass Sie <strong class='text-white'>Bookmap 7.3 oder neuer</strong> verwenden, das ist die Mindestversion für die NinjaTrader-8-Integration." },
        { title: "Installieren Sie den NinjaTrader-Adapter", html: "Installieren Sie Bookmaps <strong class='text-white'>NinjaTrader</strong>-Adapter innerhalb von Bookmap." },
        { title: "Importieren Sie das Bookmap-NinjaScript", html: "Importieren Sie das <strong class='text-white'>Bookmap-NinjaScript</strong> in NinjaTrader 8, damit die beiden Apps miteinander kommunizieren können." },
        { title: "Starten Sie die Verbindung", html: "Starten Sie die Verbindung in Bookmap. Denken Sie daran, dass die Tiefe, die Sie erhalten, davon abhängt, wofür Ihr NinjaTrader-Feed lizenziert ist, Level 1 zeigt das Top of Book, Level 2 zeigt volle Tiefe bis zu 10 Ebenen." },
        { title: "Bringen Sie eine leere Heatmap in Gang", html: "Bleibt die Heatmap leer, prüfen Sie, ob der Markt geöffnet ist, warten Sie auf einen Tick und drücken Sie <strong class='text-white'>F5</strong> auf Ihrem NinjaTrader-Chart, um die Daten anzustoßen." },
      ],
    },
    { type: "heading", text: "Option C: Tradovate für Orders behalten, vollen Datenfeed hinzufügen" },
    { type: "paragraph", html: "Wenn Sie die Ausführung über Tradovate wollen, aber ein tieferes Orderbuch als dessen Teiltiefen-Feed bietet, teilen Sie die Rollen innerhalb von Bookmap auf:" },
    {
      type: "steps",
      items: [
        { title: "Legen Sie Tradovate als Ausführung fest", html: "Richten Sie den <strong class='text-white'>Tradovate</strong>-Adapter als Ihre <strong class='text-white'>Order-Routing-/Ausführungs</strong>-Verbindung ein." },
        { title: "Fügen Sie eine Verbindung mit voller Tiefe hinzu", html: "Fügen Sie eine dedizierte <strong class='text-white'>Marktdaten</strong>-Verbindung hinzu, <strong class='text-white'>dxFeed, Rithmic oder CQG</strong> sind die gängigen Wahlmöglichkeiten mit voller Tiefe für CME-Futures." },
        { title: "Bestätigen Sie, dass beide Verbindungen aktiv sind", html: "Bestätigen Sie, dass beide Verbindungen aktiv sind, mit Daten vom Tiefenanbieter und Orders, die an Tradovate gehen." },
        { title: "Prüfen Sie, ob Ihr Plan das abdeckt", html: "Überprüfen Sie noch einmal, ob Ihr Bookmap-Plan und Ihr Datenabonnement die gewünschten Symbole und die gewünschte Tiefe erlauben." },
      ],
    },
    { type: "heading", text: "Immer noch festgefahren? Wenden Sie sich an Bookmap" },
    { type: "paragraph", html: "Da jede dieser Verbindungen auf Bookmaps Seite liegt, ist der Bookmap-Support die richtige Anlaufstelle, und genau dorthin wird Sie NinjaTrader ohnehin verweisen. Bitten Sie ihn, zu bestätigen, welcher Adapter zu Ihrem Konto passt, welches Datenabonnement Sie für die gewünschte Tiefe benötigen und ob Ihre Lizenzstufe Ihre Symbole abdeckt. Dieses eine Gespräch klärt die meiste „Warum verbindet sich das nicht”-Verwirrung deutlich schneller als eine weitere Runde des Einstellungen-Herumprobierens." },
    { type: "heading", text: "Fehlerbehebungstabelle" },
    {
      type: "table",
      headers: ["Was Sie sehen", "Was es bedeutet", "Lösung"],
      rows: [
        ["„Diese Verbindung scheint nicht möglich zu sein” / keine Anleitung vorhanden", "Bookmap hat keinen Adapter, der über NinjaTrader zu Tradovate führt", "Verbinden Sie Bookmap direkt mit Tradovate oder direkt mit NinjaTrader, als separate Verbindungen"],
        ["Der NinjaTrader-Support verweist Sie an Bookmap", "Die Verbindung liegt auf Bookmaps Seite, nicht auf der von NinjaTrader", "Eröffnen Sie ein Ticket beim Bookmap-Support für Hilfe zu Adapter und Abonnement"],
        ["Nur Level 1 wird angezeigt; der Kauf von Level 2 „öffnet” die Kette nicht", "Tiefen-Upgrades betreffen den NinjaTrader-Feed, nicht eine Tradovate-über-NinjaTrader-Route", "Verbinden Sie sich direkt mit Tradovate für dessen Feed, oder nutzen Sie einen Volltiefen-Datenanbieter"],
        ["Heatmap wirkt selbst bei direkter Tradovate-Verbindung flach", "Tradovate sendet Bookmap nur CME-Daten mit Teiltiefe, nicht das volle Orderbuch", "Leiten Sie Orders über Tradovate, beziehen Sie Daten von dxFeed, Rithmic oder CQG"],
        ["Symbol lädt nach dem Verbinden nicht", "Lizenzstufe oder Börsendatenberechtigung erlaubt dieses Instrument nicht", "Bestätigen Sie, dass Ihr Bookmap-Plan und Ihr Datenabonnement das Symbol abdecken"],
        ["Von NinjaTrader gespeiste Heatmap bleibt leer", "Es ist noch kein Tick eingetroffen, oder der Chart muss aktualisiert werden", "Prüfen Sie, ob der Markt geöffnet ist, warten Sie auf einen Tick, drücken Sie F5 im NinjaTrader-Chart"],
      ],
    },
    { type: "heading", text: "So vermeiden Sie das mit PickMyTrade" },
    { type: "paragraph", html: "Der Grund, warum dieses Setup Leute ins Stolpern bringt, ist, dass sie versuchen, drei Desktop-Apps aneinanderzukoppeln, nur um die Orders ihrer Strategie auf Tradovate zu bekommen. Wenn die Order-Ausführung das eigentliche Ziel ist, brauchen Sie in diesem Pfad weder Bookmap noch NinjaTrader. PickMyTrade nimmt Ihre TradingView-Alerts und sendet sie direkt an Tradovate, sodass Ihre Fills nie von einer fragilen App-zu-App-zu-Broker-Kette abhängen:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Direktes Alert-zu-Tradovate-Routing</strong>, Orders erreichen Ihr Tradovate-Konto, ohne über eine Charting-App zu laufen, die nicht dafür gebaut ist, sie weiterzuleiten.",
        "<strong class='text-white'>Nutzen Sie Bookmap für das, worin es gut ist</strong>, lesen Sie die Orderfluss-Heatmap in Bookmap, während Ihre Ein- und Ausstiege automatisch über eine dedizierte Brücke ausgelöst werden.",
        "<strong class='text-white'>Umgebungs- &amp; Kontozuordnung</strong>, weisen Sie jede Strategie dem korrekten Tradovate-Konto und der korrekten Umgebung zu, damit Verwechslungen zwischen Live und Simulation Sie nichts kosten.",
        "<strong class='text-white'>Multi-Konto-Synchronisierung</strong>, spiegeln Sie dieselbe Order gleichzeitig auf mehreren Konten, ohne zusätzliche Desktop-Verkabelung.",
      ],
    },
  ], es: [
    { type: "paragraph", html: "Tiene NinjaTrader 8 conectado a su cuenta de Tradovate, y ahora quiere que el mapa de calor de Bookmap se apoye en ese mismo feed. Así que busca la opción que permite a Bookmap tomar prestada la conexión de Tradovate de NinjaTrader, y simplemente no existe. Se topará con varias versiones del problema: «esta conexión no parece posible», «no hay guía para esto», o la esperanza de que pagar para pasar de Level 1 a Level 2 finalmente lo resuelva. Aquí va la versión corta, que le ahorrará un ticket de soporte: <strong class='text-white'>Bookmap no se puede encadenar a través de NinjaTrader para llegar a Tradovate.</strong> Esa ruta de tres aplicaciones no es una configuración compatible en 2026, y ningún ajuste del plan de datos la va a construir. La buena noticia es que las dos piezas que realmente quiere, Bookmap con Tradovate o Bookmap con NinjaTrader, funcionan muy bien como conexiones directas independientes. A continuación le explico por qué falla la cadena, qué configurar en su lugar, y cómo mantener su flujo de órdenes automatizado sin importar qué aplicación de escritorio esté graficando." },
    {
      type: "checklist",
      heading: "Lista de verificación rápida para la configuración de Bookmap + NT8 + Tradovate",
      items: [
        "<strong class='text-white'>Deje de intentar encadenar las tres aplicaciones.</strong> Bookmap no tiene ninguna vía que pase por NinjaTrader para tomar su conexión de Tradovate, no es una configuración compatible.",
        "<strong class='text-white'>Elija una conexión directa.</strong> Conecte Bookmap <em>directamente a Tradovate</em>, o <em>directamente a NinjaTrader</em>, no una a través de la otra.",
        "<strong class='text-white'>Para el flujo de órdenes de Tradovate en Bookmap</strong>, instale el adaptador de Tradovate de Bookmap e inicie sesión con sus credenciales de Tradovate o de la plataforma prop.",
        "<strong class='text-white'>Para los datos de NinjaTrader en Bookmap</strong>, instale el adaptador de NinjaTrader de Bookmap y el NinjaScript (Bookmap 7.3+); la profundidad que obtenga depende del propio feed de NinjaTrader.",
        "<strong class='text-white'>No espere profundidad completa de Tradovate</strong>, alimenta a Bookmap con datos de CME de profundidad parcial; use dxFeed, Rithmic o CQG para datos si quiere un libro más profundo.",
        "<strong class='text-white'>Pregunte a Bookmap, no a NinjaTrader.</strong> La conexión reside del lado de Bookmap, así que el soporte de Bookmap es responsable de esta cuestión.",
      ],
    },
    { type: "heading", text: "Qué significa realmente «no compatible» en este caso" },
    { type: "paragraph", html: "«No compatible» no significa que un botón esté roto o que se haya equivocado al escribir una contraseña. Significa que la disposición concreta que se imagina, Bookmap leyendo datos y enviando órdenes <em>a través de</em> la sesión activa de Tradovate en NinjaTrader, nunca se construyó. No existe un adaptador para ello, ni un NinjaScript, ni documentación, porque simplemente no es una ruta de señal real." },
    { type: "paragraph", html: "La razón es más simple de lo que parece en cuanto se entiende cómo se conecta Bookmap a cualquier cosa. Bookmap se comunica con cada bróker o proveedor de datos a través de su propio adaptador dedicado. Hay un adaptador de Tradovate. Hay un adaptador de NinjaTrader independiente. Cada uno es una conexión autónoma que se sostiene por sí misma. Ningún adaptador atraviesa <em>a través de</em> el otro. Así que cuando conecta Bookmap a NinjaTrader, Bookmap ve lo que sea que el feed de datos licenciado de NinjaTrader le entregue, no llega más allá de NinjaTrader para abrir una nueva vía hacia su cuenta de Tradovate." },
    { type: "paragraph", html: "Por eso el propio equipo de soporte de NinjaTrader responde a esta pregunta exacta remitiéndole a Bookmap: el eslabón que falta no está del lado de NinjaTrader, sino en que Bookmap simplemente no ofrece un modo «Tradovate a través de NinjaTrader». Una vez que esto queda claro, la solución es obvia: deje de intentar unir tres aplicaciones y conecte Bookmap directamente a la que realmente le interesa." },
    { type: "heading", text: "Principales causas del bloqueo de Bookmap + NT8 + Tradovate" },
    { type: "heading", text: "1. Los adaptadores de Bookmap son independientes, no combinables" },
    { type: "paragraph", html: "Esta es toda la historia en una línea. Bookmap se conecta a Tradovate a través del adaptador de Tradovate y a NinjaTrader a través del adaptador de NinjaTrader, y ambos son independientes. No existe la opción «usar la cuenta de Tradovate de mi conexión de NinjaTrader», porque los adaptadores no se anidan entre sí. Si quiere Tradovate en Bookmap, abre el adaptador de Tradovate, y punto." },
    { type: "heading", text: "2. Está tratando a NinjaTrader como una puerta de enlace de datos que no es" },
    { type: "paragraph", html: "Muchas personas asumen que, como NinjaTrader está conectado a Tradovate, cualquier cosa conectada a NinjaTrader hereda ese feed de Tradovate. Así no funciona con Bookmap. Cuando Bookmap se conecta a NinjaTrader, consume los datos de mercado <em>propios</em> de NinjaTrader, es decir, el feed y la autorización para los que NinjaTrader está licenciado, no una retransmisión de su sesión de Tradovate." },
    { type: "heading", text: "3. El desvío de Level 1 frente a Level 2" },
    { type: "paragraph", html: "El error clásico: «Solo muestra Level 1, así que si compro Level 2 todo el asunto Bookmap-NinjaTrader-Tradovate funcionará». Mejorar la profundidad de su feed de NinjaTrader realmente cambia cuántos niveles puede pintar Bookmap (Level 2 es lo que muestra profundidad completa, hasta 10 niveles), pero no hace nada para crear una ruta compatible desde Bookmap, pasando por NinjaTrader, hasta Tradovate. Estaría pagando para mejorar un camino que sigue sin llevarlo a donde quiere." },
    { type: "heading", text: "4. La profundidad de Tradovate es parcial, incluso en directo" },
    { type: "paragraph", html: "Incluso cuando conecta Bookmap directamente a Tradovate de la manera correcta, Tradovate alimenta a Bookmap con datos de futuros de CME de <em>profundidad parcial</em>, no con el libro de órdenes completo que suele querer un trader de mapas de calor. Así que si su verdadero objetivo es una imagen rica del depth-of-market, Tradovate como única fuente de datos puede decepcionarle sin importar cómo lo configure. Es una limitación de la fuente de datos, no un fallo de conexión." },
    { type: "heading", text: "5. Nivel de licencia y permisos de símbolos" },
    { type: "paragraph", html: "Los planes de Bookmap y las suscripciones de datos determinan qué instrumentos y qué profundidad puede ver. Si un símbolo no carga después de conectarse, suele ser una cuestión de licencia o de autorización por parte de Bookmap y del mercado, un asunto aparte de la cadena «no compatible», que el soporte de Bookmap puede resolver rápidamente." },
    { type: "heading", text: "Cómo corregir la configuración de Bookmap + Tradovate en 2026: paso a paso" },
    { type: "heading", text: "Opción A: conectar Bookmap directamente a Tradovate (recomendado)" },
    { type: "paragraph", html: "Este es el camino limpio y compatible cuando quiere su cuenta de Tradovate dentro de Bookmap. Salte NinjaTrader por completo." },
    {
      type: "steps",
      items: [
        { title: "Abra el área de conexiones", html: "Abra Bookmap y vaya al área de conexiones (el panel donde se añaden y gestionan los adaptadores de bróker/datos)." },
        { title: "Instale el adaptador de Tradovate", html: "Busque e instale el adaptador de <strong class='text-white'>Tradovate</strong> desde la lista de conexiones de Bookmap y actívelo." },
        { title: "Inicie sesión con sus credenciales de Tradovate", html: "Inicie sesión con sus <strong class='text-white'>credenciales de la plataforma Tradovate</strong>; para una cuenta prop o de evaluación, use el usuario de trading que su firma emitió para software de terceros, no su correo del panel si ambos difieren." },
        { title: "Elija su modo de conexión", html: "Elija su modo de conexión: use <strong class='text-white'>Tradovate tanto para datos como para trading</strong>, o use <strong class='text-white'>Tradovate solo para el enrutamiento de órdenes</strong> y elija un proveedor de datos independiente (ver Opción C)." },
        { title: "Ingrese símbolos y active el trading", html: "Ingrese los símbolos de los instrumentos en el formato que espera Bookmap, confirme que la conexión se activa, y active el modo de trading si planea enviar órdenes desde Bookmap." },
      ],
    },
    { type: "heading", text: "Opción B: conectar Bookmap directamente a NinjaTrader 8" },
    { type: "paragraph", html: "Use esto cuando quiera específicamente el feed de datos de NinjaTrader en Bookmap (no el de Tradovate). Es un enlace directo de Bookmap a NinjaTrader, y funciona por sí solo." },
    {
      type: "steps",
      items: [
        { title: "Confirme que tiene Bookmap 7.3 o superior", html: "Asegúrese de tener <strong class='text-white'>Bookmap 7.3 o posterior</strong>, que es el mínimo requerido para la integración con NinjaTrader 8." },
        { title: "Instale el adaptador de NinjaTrader", html: "Instale el adaptador de <strong class='text-white'>NinjaTrader</strong> de Bookmap dentro de Bookmap." },
        { title: "Importe el NinjaScript de Bookmap", html: "Importe el <strong class='text-white'>NinjaScript de Bookmap</strong> en NinjaTrader 8 para que ambas aplicaciones puedan comunicarse." },
        { title: "Inicie la conexión", html: "Inicie la conexión en Bookmap. Recuerde que la profundidad que obtenga es la que su feed de NinjaTrader tenga licenciada, Level 1 muestra el top of book, Level 2 muestra profundidad completa hasta 10 niveles." },
        { title: "Active un mapa de calor vacío", html: "Si el mapa de calor permanece vacío, confirme que el mercado está abierto, espere un tick y pulse <strong class='text-white'>F5</strong> en su gráfico de NinjaTrader para forzar el paso de los datos." },
      ],
    },
    { type: "heading", text: "Opción C: mantener Tradovate para las órdenes y añadir un feed de datos de profundidad completa" },
    { type: "paragraph", html: "Si quiere la ejecución de Tradovate pero un libro más profundo del que ofrece su feed de profundidad parcial, divida los roles dentro de Bookmap:" },
    {
      type: "steps",
      items: [
        { title: "Configure Tradovate como ejecución", html: "Configure el adaptador de <strong class='text-white'>Tradovate</strong> como su conexión de <strong class='text-white'>enrutamiento de órdenes/ejecución</strong>." },
        { title: "Añada una conexión de datos de profundidad completa", html: "Añada una conexión dedicada de <strong class='text-white'>datos de mercado</strong>, <strong class='text-white'>dxFeed, Rithmic o CQG</strong> son las opciones habituales de profundidad completa para futuros de CME." },
        { title: "Confirme que ambas conexiones están activas", html: "Confirme que ambas conexiones están activas, con los datos procedentes del proveedor de profundidad y las órdenes dirigidas a Tradovate." },
        { title: "Compruebe que su plan lo cubre", html: "Verifique dos veces que su plan de Bookmap y su suscripción de datos permiten los símbolos y la profundidad que busca." },
      ],
    },
    { type: "heading", text: "¿Sigue atascado? Llévelo a Bookmap" },
    { type: "paragraph", html: "Como cada una de estas conexiones reside del lado de Bookmap, el soporte de Bookmap es el mostrador correcto, y es exactamente adonde le remitirá NinjaTrader de todos modos. Pídales que confirmen qué adaptador corresponde a su cuenta, qué suscripción de datos necesita para la profundidad deseada, y si su nivel de licencia cubre sus símbolos. Esa única conversación resuelve la mayor parte de la confusión de «por qué no se conecta esto» mucho más rápido que otra ronda de ajustes." },
    { type: "heading", text: "Tabla de solución de problemas" },
    {
      type: "table",
      headers: ["Lo que ve", "Lo que significa", "Solución"],
      rows: [
        ["«Esta conexión no parece posible» / no existe una guía", "Bookmap no tiene ningún adaptador que pase por NinjaTrader para llegar a Tradovate", "Conecte Bookmap directamente a Tradovate, o directamente a NinjaTrader, como conexiones separadas"],
        ["El soporte de NinjaTrader le indica que contacte a Bookmap", "La conexión reside del lado de Bookmap, no del de NinjaTrader", "Abra un ticket con el soporte de Bookmap para orientación sobre el adaptador y la suscripción"],
        ["Solo se muestra Level 1; comprar Level 2 no «desbloquea» la cadena", "Las mejoras de profundidad afectan al feed de NinjaTrader, no a una ruta Tradovate-vía-NinjaTrader", "Conéctese directamente a Tradovate para su feed, o use un proveedor de datos de profundidad completa"],
        ["El mapa de calor se ve poco profundo incluso en una conexión directa a Tradovate", "Tradovate envía a Bookmap datos de CME de profundidad parcial, no el libro completo", "Enrute las órdenes a través de Tradovate, obtenga los datos de dxFeed, Rithmic o CQG"],
        ["El símbolo no carga tras conectarse", "El nivel de licencia o la autorización de datos del mercado no permite ese instrumento", "Confirme que su plan de Bookmap y su suscripción de datos cubren el símbolo"],
        ["El mapa de calor alimentado por NinjaTrader permanece en blanco", "Aún no ha llegado ningún tick o el gráfico necesita actualizarse", "Confirme que el mercado está abierto, espere un tick, pulse F5 en el gráfico de NinjaTrader"],
      ],
    },
    { type: "heading", text: "Evite esto con PickMyTrade" },
    { type: "paragraph", html: "La razón por la que esta configuración hace tropezar a la gente es que intentan unir tres aplicaciones de escritorio solo para llevar las órdenes de su estrategia a Tradovate. Si la ejecución de órdenes es el verdadero objetivo, no necesita ni Bookmap ni NinjaTrader en ese camino. PickMyTrade toma sus alertas de TradingView y las envía directamente a Tradovate, de modo que sus ejecuciones nunca dependen de una frágil cadena aplicación-aplicación-bróker:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Enrutamiento directo de alerta a Tradovate</strong>, las órdenes llegan a su cuenta de Tradovate sin pasar por una aplicación de gráficos que no está diseñada para retransmitirlas.",
        "<strong class='text-white'>Conserve Bookmap para lo que hace bien</strong>, lea el mapa de calor de flujo de órdenes en Bookmap mientras sus entradas y salidas se disparan automáticamente a través de un puente dedicado.",
        "<strong class='text-white'>Asignación de entorno y cuenta</strong>, dirija cada estrategia a la cuenta y el entorno de Tradovate correctos para que las confusiones entre modo real y simulado no le cuesten dinero.",
        "<strong class='text-white'>Sincronización multicuenta</strong>, replique la misma orden en varias cuentas a la vez, sin necesidad de configuración adicional de escritorio.",
      ],
    },
  ], fr: [
    { type: "paragraph", html: "Vous avez NinjaTrader 8 connecté à votre compte Tradovate, et vous voulez maintenant que la heatmap de Bookmap s'appuie sur ce même flux. Vous cherchez donc le paramètre qui permettrait à Bookmap d'emprunter la connexion Tradovate de NinjaTrader, et il n'existe tout simplement pas. Vous tomberez sur plusieurs variantes du problème : « cette connexion ne semble pas possible », « il n'existe aucun guide pour cela », ou l'espoir que payer pour passer du Level 1 au Level 2 finira par tout débloquer. Voici la version courte, qui vous évitera un ticket de support : <strong class='text-white'>Bookmap ne peut pas passer par NinjaTrader pour atteindre Tradovate.</strong> Ce trajet à trois applications n'est pas une configuration prise en charge en 2026, et aucun ajustement de forfait de données ne la créera. La bonne nouvelle, c'est que les deux éléments que vous recherchez réellement, Bookmap sur Tradovate ou Bookmap sur NinjaTrader, fonctionnent très bien en tant que connexions directes autonomes. Je vous explique ci-dessous pourquoi la chaîne échoue, ce qu'il faut configurer à la place, et comment garder votre flux d'ordres automatisé quelle que soit l'application de bureau utilisée pour le graphique." },
    {
      type: "checklist",
      heading: "Checklist rapide pour la configuration Bookmap + NT8 + Tradovate",
      items: [
        "<strong class='text-white'>Cessez d'essayer de chaîner les trois applications.</strong> Bookmap n'a aucun chemin qui passe par NinjaTrader pour récupérer votre connexion Tradovate, ce n'est pas une configuration prise en charge.",
        "<strong class='text-white'>Choisissez une connexion directe.</strong> Connectez Bookmap <em>directement à Tradovate</em>, ou <em>directement à NinjaTrader</em>, pas l'une via l'autre.",
        "<strong class='text-white'>Pour le flux d'ordres Tradovate dans Bookmap</strong>, installez l'adaptateur Tradovate de Bookmap et connectez-vous avec vos identifiants Tradovate ou de la plateforme prop.",
        "<strong class='text-white'>Pour les données NinjaTrader dans Bookmap</strong>, installez l'adaptateur NinjaTrader de Bookmap et le NinjaScript (Bookmap 7.3+) ; la profondeur obtenue dépend du flux propre à NinjaTrader.",
        "<strong class='text-white'>N'attendez pas une profondeur complète de la part de Tradovate</strong>, il fournit à Bookmap des données CME à profondeur partielle ; utilisez dxFeed, Rithmic ou CQG pour les données si vous voulez un carnet plus profond.",
        "<strong class='text-white'>Adressez-vous à Bookmap, pas à NinjaTrader.</strong> La connexion se situe du côté de Bookmap, c'est donc le support Bookmap qui gère cette question.",
      ],
    },
    { type: "heading", text: "Ce que « non pris en charge » signifie vraiment ici" },
    { type: "paragraph", html: "« Non pris en charge » ne signifie pas qu'un bouton est cassé ou que vous vous êtes trompé de mot de passe. Cela signifie que l'arrangement précis que vous imaginez, Bookmap lisant les données et envoyant des ordres <em>via</em> la session Tradovate active de NinjaTrader, n'a jamais été construit. Il n'existe ni adaptateur, ni NinjaScript, ni documentation pour cela, tout simplement parce que ce n'est pas un véritable chemin de signal." },
    { type: "paragraph", html: "La raison est plus simple qu'il n'y paraît une fois que l'on comprend comment Bookmap se connecte, quel que soit le cas. Bookmap communique avec chaque courtier ou fournisseur de données via son propre adaptateur dédié. Il existe un adaptateur Tradovate. Il existe un adaptateur NinjaTrader distinct. Chacun est une connexion autonome qui tient sur ses propres jambes. Aucun adaptateur ne traverse <em>l'autre</em>. Donc lorsque vous connectez Bookmap à NinjaTrader, Bookmap voit uniquement ce que le flux de données sous licence de NinjaTrader lui transmet, il n'atteint pas au-delà de NinjaTrader pour ouvrir un nouveau canal vers votre compte Tradovate." },
    { type: "paragraph", html: "C'est pourquoi le support de NinjaTrader répond à cette question précise en vous renvoyant vers Bookmap : le maillon manquant n'est pas du côté de NinjaTrader, c'est que Bookmap n'offre tout simplement pas de mode « Tradovate via NinjaTrader ». Une fois que c'est clair, la solution est évidente : cessez d'essayer de relier trois applications et connectez Bookmap directement à celle qui vous intéresse." },
    { type: "heading", text: "Principales causes du blocage Bookmap + NT8 + Tradovate" },
    { type: "heading", text: "1. Les adaptateurs de Bookmap sont autonomes, pas empilables" },
    { type: "paragraph", html: "Voilà toute l'histoire en une phrase. Bookmap se connecte à Tradovate via l'adaptateur Tradovate et à NinjaTrader via l'adaptateur NinjaTrader, et ces deux éléments sont indépendants. Il n'existe pas d'option « utiliser le compte Tradovate de ma connexion NinjaTrader », car les adaptateurs ne s'imbriquent pas les uns dans les autres. Si vous voulez Tradovate dans Bookmap, vous ouvrez l'adaptateur Tradovate, un point c'est tout." },
    { type: "heading", text: "2. Vous traitez NinjaTrader comme une passerelle de données qu'il n'est pas" },
    { type: "paragraph", html: "Beaucoup de gens supposent que, puisque NinjaTrader est connecté à Tradovate, tout ce qui est connecté à NinjaTrader hérite de ce flux Tradovate. Cela ne fonctionne pas ainsi pour Bookmap. Lorsque Bookmap se connecte à NinjaTrader, il consomme les données de marché <em>propres</em> à NinjaTrader, c'est-à-dire le flux et les droits pour lesquels NinjaTrader est sous licence, et non une retransmission de votre session Tradovate." },
    { type: "heading", text: "3. Le détour Level 1 contre Level 2" },
    { type: "paragraph", html: "L'erreur classique : « Ça n'affiche que le Level 1, donc si j'achète le Level 2, tout le système Bookmap-NinjaTrader-Tradovate va fonctionner. » Améliorer la profondeur de votre flux NinjaTrader change réellement le nombre de niveaux que Bookmap peut afficher (le Level 2 affiche la profondeur complète, jusqu'à 10 niveaux), mais cela ne crée en rien une route prise en charge de Bookmap, via NinjaTrader, vers Tradovate. Vous paieriez pour améliorer un chemin qui ne mène toujours pas là où vous voulez." },
    { type: "heading", text: "4. La profondeur de Tradovate reste partielle, même en direct" },
    { type: "paragraph", html: "Même lorsque vous connectez Bookmap directement à Tradovate comme prévu, Tradovate fournit à Bookmap des données de futures CME à <em>profondeur partielle</em>, et non le carnet d'ordres complet que recherche généralement un trader de heatmap. Donc si votre véritable objectif est une image riche du carnet d'ordres, Tradovate seul comme source de données pourrait vous décevoir, quelle que soit la façon dont vous le câblez. C'est une limite de la source de données, pas un bug de connexion." },
    { type: "heading", text: "5. Niveau de licence et autorisations de symboles" },
    { type: "paragraph", html: "Les forfaits Bookmap et les abonnements de données déterminent quels instruments et quelle profondeur vous êtes autorisé à voir. Si un symbole ne se charge pas après la connexion, c'est généralement une question de licence ou de droits du côté de Bookmap et de la bourse, un problème distinct de la chaîne « non prise en charge », que le support Bookmap peut résoudre rapidement." },
    { type: "heading", text: "Comment corriger la configuration Bookmap + Tradovate en 2026 : étape par étape" },
    { type: "heading", text: "Option A : connecter Bookmap directement à Tradovate (recommandé)" },
    { type: "paragraph", html: "Voici le chemin propre et pris en charge lorsque vous voulez votre compte Tradovate dans Bookmap. Ignorez complètement NinjaTrader." },
    {
      type: "steps",
      items: [
        { title: "Ouvrez la zone des connexions", html: "Ouvrez Bookmap et accédez à la zone des connexions (le panneau où vous ajoutez et gérez les adaptateurs de courtier/données)." },
        { title: "Installez l'adaptateur Tradovate", html: "Recherchez et installez l'adaptateur <strong class='text-white'>Tradovate</strong> depuis la liste des connexions de Bookmap, puis activez-le." },
        { title: "Connectez-vous avec vos identifiants Tradovate", html: "Connectez-vous avec vos <strong class='text-white'>identifiants de la plateforme Tradovate</strong> ; pour un compte prop ou d'évaluation, utilisez l'identifiant de trading fourni par votre firme pour les logiciels tiers, pas votre e-mail de tableau de bord s'ils diffèrent." },
        { title: "Choisissez votre mode de connexion", html: "Choisissez votre mode de connexion : utilisez <strong class='text-white'>Tradovate à la fois pour les données et le trading</strong>, ou utilisez <strong class='text-white'>Tradovate uniquement pour le routage des ordres</strong> et choisissez un fournisseur de données distinct (voir Option C)." },
        { title: "Saisissez les symboles et activez le trading", html: "Saisissez les symboles des instruments dans le format attendu par Bookmap, confirmez que la connexion devient active, et activez le mode trading si vous prévoyez d'envoyer des ordres depuis Bookmap." },
      ],
    },
    { type: "heading", text: "Option B : connecter Bookmap directement à NinjaTrader 8" },
    { type: "paragraph", html: "Utilisez cette option lorsque vous voulez spécifiquement le flux de données de NinjaTrader dans Bookmap (et non celui de Tradovate). C'est un lien direct Bookmap-NinjaTrader, autonome." },
    {
      type: "steps",
      items: [
        { title: "Vérifiez que vous êtes sur Bookmap 7.3+", html: "Assurez-vous d'utiliser <strong class='text-white'>Bookmap 7.3 ou une version ultérieure</strong>, la version minimale requise pour l'intégration NinjaTrader 8." },
        { title: "Installez l'adaptateur NinjaTrader", html: "Installez l'adaptateur <strong class='text-white'>NinjaTrader</strong> de Bookmap au sein de Bookmap." },
        { title: "Importez le NinjaScript Bookmap", html: "Importez le <strong class='text-white'>NinjaScript Bookmap</strong> dans NinjaTrader 8 pour que les deux applications puissent communiquer." },
        { title: "Démarrez la connexion", html: "Démarrez la connexion dans Bookmap. N'oubliez pas que la profondeur obtenue dépend de la licence de votre flux NinjaTrader, le Level 1 affiche le haut du carnet, le Level 2 affiche la profondeur complète jusqu'à 10 niveaux." },
        { title: "Relancez une heatmap vide", html: "Si la heatmap reste vide, vérifiez que le marché est ouvert, attendez un tick, et appuyez sur <strong class='text-white'>F5</strong> sur votre graphique NinjaTrader pour relancer le passage des données." },
      ],
    },
    { type: "heading", text: "Option C : conserver Tradovate pour les ordres et ajouter un flux de données à profondeur complète" },
    { type: "paragraph", html: "Si vous voulez l'exécution Tradovate mais un carnet plus profond que celui fourni par son flux à profondeur partielle, séparez les rôles au sein de Bookmap :" },
    {
      type: "steps",
      items: [
        { title: "Configurez Tradovate comme exécution", html: "Configurez l'adaptateur <strong class='text-white'>Tradovate</strong> comme votre connexion de <strong class='text-white'>routage d'ordres / exécution</strong>." },
        { title: "Ajoutez une connexion de données à profondeur complète", html: "Ajoutez une connexion <strong class='text-white'>de données de marché</strong> dédiée, <strong class='text-white'>dxFeed, Rithmic ou CQG</strong> sont les choix courants à profondeur complète pour les futures CME." },
        { title: "Confirmez que les deux connexions sont actives", html: "Confirmez que les deux connexions sont actives, avec les données provenant du fournisseur de profondeur et les ordres envoyés vers Tradovate." },
        { title: "Vérifiez que votre forfait le couvre", html: "Vérifiez bien que votre forfait Bookmap et votre abonnement de données autorisent les symboles et la profondeur recherchés." },
      ],
    },
    { type: "heading", text: "Toujours bloqué ? Adressez-vous à Bookmap" },
    { type: "paragraph", html: "Comme chacune de ces connexions se situe du côté de Bookmap, le support Bookmap est le bon interlocuteur, et c'est précisément là que NinjaTrader vous renverra de toute façon. Demandez-leur de confirmer quel adaptateur correspond à votre compte, quel abonnement de données vous faut-il pour la profondeur souhaitée, et si votre niveau de licence couvre vos symboles. Cette seule conversation résout la plupart des confusions du type « pourquoi ça ne se connecte pas » bien plus vite qu'une nouvelle série de réglages." },
    { type: "heading", text: "Tableau de dépannage" },
    {
      type: "table",
      headers: ["Ce que vous voyez", "Ce que cela signifie", "Solution"],
      rows: [
        ["« Cette connexion ne semble pas possible » / aucun guide n'existe", "Bookmap n'a aucun adaptateur passant par NinjaTrader pour atteindre Tradovate", "Connectez Bookmap directement à Tradovate, ou directement à NinjaTrader, en tant que connexions distinctes"],
        ["Le support NinjaTrader vous dit de contacter Bookmap", "La connexion se situe du côté de Bookmap, pas de celui de NinjaTrader", "Ouvrez un ticket auprès du support Bookmap pour des conseils sur l'adaptateur et l'abonnement"],
        ["Seul le Level 1 s'affiche ; acheter le Level 2 ne « débloque » pas la chaîne", "Les mises à niveau de profondeur affectent le flux NinjaTrader, pas une route Tradovate-via-NinjaTrader", "Connectez-vous directement à Tradovate pour son flux, ou utilisez un fournisseur de données à profondeur complète"],
        ["La heatmap paraît peu profonde même sur une connexion directe à Tradovate", "Tradovate envoie à Bookmap des données CME à profondeur partielle, pas le carnet complet", "Acheminez les ordres via Tradovate, récupérez les données depuis dxFeed, Rithmic ou CQG"],
        ["Le symbole ne se charge pas après la connexion", "Le niveau de licence ou les droits de données de la bourse ne permettent pas cet instrument", "Vérifiez que votre forfait Bookmap et votre abonnement de données couvrent le symbole"],
        ["La heatmap alimentée par NinjaTrader reste vide", "Aucun tick n'est encore arrivé, ou le graphique doit être actualisé", "Vérifiez que le marché est ouvert, attendez un tick, appuyez sur F5 sur le graphique NinjaTrader"],
      ],
    },
    { type: "heading", text: "Évitez ce problème avec PickMyTrade" },
    { type: "paragraph", html: "La raison pour laquelle cette configuration piège les gens, c'est qu'ils essaient d'assembler trois applications de bureau juste pour faire parvenir les ordres de leur stratégie à Tradovate. Si l'exécution des ordres est le véritable objectif, vous n'avez besoin ni de Bookmap ni de NinjaTrader dans ce chemin. PickMyTrade récupère vos alertes TradingView et les envoie directement à Tradovate, afin que vos exécutions ne dépendent jamais d'une chaîne fragile application-application-courtier :" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Routage direct des alertes vers Tradovate</strong>, les ordres atteignent votre compte Tradovate sans passer par une application de graphiques qui n'est pas conçue pour les relayer.",
        "<strong class='text-white'>Conservez Bookmap pour ce qu'il fait de mieux</strong>, lisez la heatmap du flux d'ordres dans Bookmap pendant que vos entrées et sorties se déclenchent automatiquement via un pont dédié.",
        "<strong class='text-white'>Mappage d'environnement et de compte</strong>, dirigez chaque stratégie vers le bon compte et environnement Tradovate afin que les confusions entre réel et simulation ne vous coûtent rien.",
        "<strong class='text-white'>Synchronisation multi-comptes</strong>, dupliquez le même ordre sur plusieurs comptes à la fois, sans plomberie de bureau supplémentaire.",
      ],
    },
  ], it: [
    { type: "paragraph", html: "Avete NinjaTrader 8 collegato al vostro account Tradovate, e ora volete che la heatmap di Bookmap si appoggi sullo stesso feed. Quindi cercate l'impostazione che permetta a Bookmap di prendere in prestito la connessione Tradovate di NinjaTrader, e semplicemente non esiste. La incontrerete in diverse varianti: «questa connessione non sembra possibile», «non esiste una guida per questo», oppure la speranza che pagare per passare da Level 1 a Level 2 risolva finalmente tutto. Ecco la versione breve, che vi risparmierà un ticket di assistenza: <strong class='text-white'>Bookmap non può essere collegato a Tradovate passando per NinjaTrader.</strong> Questo percorso a tre applicazioni non è una configurazione supportata nel 2026, e nessun intervento sul piano dati lo creerà. La buona notizia è che entrambi gli elementi che volete davvero, Bookmap su Tradovate o Bookmap su NinjaTrader, funzionano benissimo come connessioni dirette autonome. Di seguito vi spiego perché la catena fallisce, cosa configurare al suo posto, e come mantenere il vostro flusso di ordini automatizzato indipendentemente dall'app desktop usata per il grafico." },
    {
      type: "checklist",
      heading: "Checklist rapida per la configurazione Bookmap + NT8 + Tradovate",
      items: [
        "<strong class='text-white'>Smettete di provare a concatenare le tre app.</strong> Bookmap non ha alcun percorso che passi per NinjaTrader per acquisire la vostra connessione Tradovate, non è una configurazione supportata.",
        "<strong class='text-white'>Scegliete una connessione diretta.</strong> Collegate Bookmap <em>direttamente a Tradovate</em>, oppure <em>direttamente a NinjaTrader</em>, non una tramite l'altra.",
        "<strong class='text-white'>Per il flusso ordini Tradovate in Bookmap</strong>, installate l'adattatore Tradovate di Bookmap ed effettuate l'accesso con le credenziali Tradovate o della piattaforma prop.",
        "<strong class='text-white'>Per i dati NinjaTrader in Bookmap</strong>, installate l'adattatore NinjaTrader di Bookmap e il NinjaScript (Bookmap 7.3+); la profondità che otterrete dipende dal feed proprio di NinjaTrader.",
        "<strong class='text-white'>Non aspettatevi profondità completa da Tradovate</strong>, fornisce a Bookmap dati CME a profondità parziale; usate dxFeed, Rithmic o CQG per i dati se volete un book più profondo.",
        "<strong class='text-white'>Chiedete a Bookmap, non a NinjaTrader.</strong> La connessione risiede dal lato di Bookmap, quindi è l'assistenza Bookmap a occuparsi di questa domanda.",
      ],
    },
    { type: "heading", text: "Cosa significa davvero «non supportato» in questo caso" },
    { type: "paragraph", html: "«Non supportato» non significa che un pulsante è rotto o che avete sbagliato a digitare una password. Significa che la configurazione specifica che state immaginando, Bookmap che legge i dati e invia ordini <em>tramite</em> la sessione Tradovate attiva di NinjaTrader, non è mai stata costruita. Non esiste un adattatore per questo, non esiste un NinjaScript, e non esiste documentazione, perché semplicemente non è un percorso di segnale reale." },
    { type: "paragraph", html: "Il motivo è più semplice di quanto sembri, una volta capito come Bookmap si collega in generale. Bookmap comunica con ogni broker o fornitore di dati tramite un proprio adattatore dedicato. Esiste un adattatore Tradovate. Esiste un adattatore NinjaTrader separato. Ciascuno è una connessione autonoma che si regge da sola. Nessun adattatore passa <em>attraverso</em> l'altro. Quindi, quando collegate Bookmap a NinjaTrader, Bookmap vede solo ciò che il feed dati concesso in licenza da NinjaTrader gli fornisce, non va oltre NinjaTrader per aprire un nuovo canale verso il vostro account Tradovate." },
    { type: "paragraph", html: "Per questo lo stesso supporto di NinjaTrader risponde a questa domanda precisa rimandandovi a Bookmap: l'anello mancante non è dal lato di NinjaTrader, ma nel fatto che Bookmap semplicemente non offre una modalità «Tradovate tramite NinjaTrader». Una volta chiarito questo, la soluzione è evidente: smettete di provare a collegare tre app e collegate Bookmap direttamente a quella che vi interessa davvero." },
    { type: "heading", text: "Principali cause del blocco Bookmap + NT8 + Tradovate" },
    { type: "heading", text: "1. Gli adattatori di Bookmap sono autonomi, non sovrapponibili" },
    { type: "paragraph", html: "Questa è tutta la storia in una riga. Bookmap si collega a Tradovate tramite l'adattatore Tradovate e a NinjaTrader tramite l'adattatore NinjaTrader, e i due sono indipendenti. Non esiste l'opzione «usa l'account Tradovate della mia connessione NinjaTrader», perché gli adattatori non si annidano l'uno nell'altro. Se volete Tradovate in Bookmap, aprite l'adattatore Tradovate, punto." },
    { type: "heading", text: "2. State trattando NinjaTrader come un gateway dati che non è" },
    { type: "paragraph", html: "Molti presumono che, poiché NinjaTrader è collegato a Tradovate, tutto ciò che è collegato a NinjaTrader erediti quel feed Tradovate. Per Bookmap non funziona così. Quando Bookmap si collega a NinjaTrader, consuma i dati di mercato <em>propri</em> di NinjaTrader, ovvero il feed e l'abilitazione per cui NinjaTrader è concesso in licenza, non una ritrasmissione della vostra sessione Tradovate." },
    { type: "heading", text: "3. La deviazione Level 1 contro Level 2" },
    { type: "paragraph", html: "L'errore classico: «Mostra solo Level 1, quindi se acquisto Level 2 tutto il sistema Bookmap-NinjaTrader-Tradovate funzionerà». Aggiornare la profondità del vostro feed NinjaTrader cambia effettivamente quanti livelli Bookmap può disegnare (Level 2 è ciò che mostra la profondità completa, fino a 10 livelli), ma non crea in alcun modo un percorso supportato da Bookmap, tramite NinjaTrader, verso Tradovate. Stareste pagando per migliorare un percorso che comunque non porta dove volete." },
    { type: "heading", text: "4. La profondità di Tradovate è parziale, anche in diretta" },
    { type: "paragraph", html: "Anche quando collegate Bookmap direttamente a Tradovate nel modo previsto, Tradovate fornisce a Bookmap dati sui futures CME a <em>profondità parziale</em>, non il book completo che di solito un trader di heatmap desidera. Quindi, se il vostro vero obiettivo è un'immagine ricca della profondità di mercato, Tradovate come unica fonte dati potrebbe deludervi indipendentemente da come la configurate. Si tratta di un limite della fonte dati, non di un bug di connessione." },
    { type: "heading", text: "5. Livello di licenza e permessi sui simboli" },
    { type: "paragraph", html: "I piani Bookmap e gli abbonamenti dati determinano quali strumenti e quale profondità siete autorizzati a vedere. Se un simbolo non si carica dopo la connessione, di solito è una questione di licenza o di autorizzazione lato Bookmap ed exchange, un problema separato dalla catena «non supportata», che l'assistenza Bookmap può risolvere rapidamente." },
    { type: "heading", text: "Come correggere la configurazione Bookmap + Tradovate nel 2026: passo dopo passo" },
    { type: "heading", text: "Opzione A: collegare Bookmap direttamente a Tradovate (consigliato)" },
    { type: "paragraph", html: "Questo è il percorso pulito e supportato quando volete il vostro account Tradovate dentro Bookmap. Saltate del tutto NinjaTrader." },
    {
      type: "steps",
      items: [
        { title: "Aprite l'area delle connessioni", html: "Aprite Bookmap e andate nell'area delle connessioni (il pannello in cui si aggiungono e gestiscono gli adattatori broker/dati)." },
        { title: "Installate l'adattatore Tradovate", html: "Cercate e installate l'adattatore <strong class='text-white'>Tradovate</strong> dall'elenco delle connessioni di Bookmap, quindi attivatelo." },
        { title: "Accedete con le vostre credenziali Tradovate", html: "Accedete con le vostre <strong class='text-white'>credenziali della piattaforma Tradovate</strong>; per un account prop o di valutazione, usate il login di trading rilasciato dalla vostra firm per software di terze parti, non la vostra email della dashboard se i due differiscono." },
        { title: "Scegliete la modalità di connessione", html: "Scegliete la modalità di connessione: usate <strong class='text-white'>Tradovate sia per i dati che per il trading</strong>, oppure usate <strong class='text-white'>Tradovate solo per l'instradamento degli ordini</strong> e scegliete un fornitore di dati separato (vedi Opzione C)." },
        { title: "Inserite i simboli e attivate il trading", html: "Inserite i simboli degli strumenti nel formato previsto da Bookmap, confermate che la connessione diventi attiva, e attivate la modalità di trading se intendete inviare ordini da Bookmap." },
      ],
    },
    { type: "heading", text: "Opzione B: collegare Bookmap direttamente a NinjaTrader 8" },
    { type: "paragraph", html: "Usate questa opzione quando volete specificamente il feed dati di NinjaTrader in Bookmap (non quello di Tradovate). È un collegamento diretto Bookmap-NinjaTrader, autonomo." },
    {
      type: "steps",
      items: [
        { title: "Confermate di avere Bookmap 7.3+", html: "Assicuratevi di utilizzare <strong class='text-white'>Bookmap 7.3 o versione successiva</strong>, il requisito minimo per l'integrazione con NinjaTrader 8." },
        { title: "Installate l'adattatore NinjaTrader", html: "Installate l'adattatore <strong class='text-white'>NinjaTrader</strong> di Bookmap all'interno di Bookmap." },
        { title: "Importate il NinjaScript di Bookmap", html: "Importate il <strong class='text-white'>NinjaScript di Bookmap</strong> in NinjaTrader 8 in modo che le due app possano comunicare." },
        { title: "Avviate la connessione", html: "Avviate la connessione in Bookmap. Ricordate che la profondità che ottenete dipende da ciò per cui il vostro feed NinjaTrader è concesso in licenza, Level 1 mostra il top of book, Level 2 mostra la profondità completa fino a 10 livelli." },
        { title: "Sbloccate una heatmap vuota", html: "Se la heatmap resta vuota, verificate che il mercato sia aperto, attendete un tick e premete <strong class='text-white'>F5</strong> sul vostro grafico NinjaTrader per far passare i dati." },
      ],
    },
    { type: "heading", text: "Opzione C: mantenere Tradovate per gli ordini e aggiungere un feed dati a profondità completa" },
    { type: "paragraph", html: "Se volete l'esecuzione tramite Tradovate ma un book più profondo di quello offerto dal suo feed a profondità parziale, dividete i ruoli all'interno di Bookmap:" },
    {
      type: "steps",
      items: [
        { title: "Impostate Tradovate per l'esecuzione", html: "Configurate l'adattatore <strong class='text-white'>Tradovate</strong> come vostra connessione di <strong class='text-white'>instradamento ordini/esecuzione</strong>." },
        { title: "Aggiungete una connessione dati a profondità completa", html: "Aggiungete una connessione dedicata di <strong class='text-white'>dati di mercato</strong>, <strong class='text-white'>dxFeed, Rithmic o CQG</strong> sono le scelte più comuni a profondità completa per i futures CME." },
        { title: "Confermate che entrambe le connessioni sono attive", html: "Confermate che entrambe le connessioni sono attive, con i dati provenienti dal fornitore di profondità e gli ordini diretti a Tradovate." },
        { title: "Verificate che il vostro piano lo copra", html: "Verificate attentamente che il vostro piano Bookmap e l'abbonamento dati consentano i simboli e la profondità desiderati." },
      ],
    },
    { type: "heading", text: "Ancora bloccati? Rivolgetevi a Bookmap" },
    { type: "paragraph", html: "Poiché ciascuna di queste connessioni risiede dal lato di Bookmap, l'assistenza Bookmap è l'interlocutore giusto, ed è esattamente lì che NinjaTrader vi rimanderà comunque. Chiedete loro di confermare quale adattatore corrisponde al vostro account, quale abbonamento dati vi serve per la profondità desiderata, e se il vostro livello di licenza copre i vostri simboli. Questa singola conversazione chiarisce la maggior parte della confusione sul «perché non si connette» molto più velocemente di un altro giro di modifiche alle impostazioni." },
    { type: "heading", text: "Tabella di risoluzione dei problemi" },
    {
      type: "table",
      headers: ["Cosa vedete", "Cosa significa", "Soluzione"],
      rows: [
        ["«Questa connessione non sembra possibile» / non esiste una guida", "Bookmap non ha alcun adattatore che passi per NinjaTrader per raggiungere Tradovate", "Collegate Bookmap direttamente a Tradovate, oppure direttamente a NinjaTrader, come connessioni separate"],
        ["L'assistenza NinjaTrader vi dice di contattare Bookmap", "La connessione risiede dal lato di Bookmap, non da quello di NinjaTrader", "Aprite un ticket con l'assistenza Bookmap per indicazioni su adattatore e abbonamento"],
        ["Viene mostrato solo Level 1; acquistare Level 2 non «sblocca» la catena", "Gli aggiornamenti di profondità riguardano il feed NinjaTrader, non un percorso Tradovate-tramite-NinjaTrader", "Collegatevi direttamente a Tradovate per il suo feed, oppure usate un fornitore di dati a profondità completa"],
        ["La heatmap appare poco profonda anche con una connessione diretta a Tradovate", "Tradovate invia a Bookmap dati CME a profondità parziale, non il book completo", "Instradate gli ordini tramite Tradovate, prendete i dati da dxFeed, Rithmic o CQG"],
