---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "ninjatrader-apex-static-login-fails";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/debugging/${SLUG}`;

const META_TITLE = "NinjaTrader Apex Static Tradovate Login Fails";
const META_DESCRIPTION =
  "NinjaTrader desktop rejecting your Apex Tradovate login? Here's why the sign-in fails and the exact steps to fix it and connect your account fast.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "NinjaTrader: Apex-Static-Tradovate-Login schlägt fehl", es: "Falla el inicio de sesión de Tradovate con Apex Static en NinjaTrader", fr: "Échec de la connexion Tradovate Apex Static dans NinjaTrader", it: "Login Tradovate Apex Static non riuscito in NinjaTrader" },
  dek: { en: "Your Apex Tradovate username and password log you in fine on the Tradovate website, but NinjaTrader desktop still throws “Incorrect username and password.” Here's why the app wants a different login than Tradovate does, and how to get connected in a few minutes.", de: "Ihr Apex-Tradovate-Benutzername und Ihr Passwort funktionieren auf der Tradovate-Website einwandfrei, doch NinjaTrader Desktop meldet weiterhin „Incorrect username and password“. Hier erfahren Sie, warum die App einen anderen Login verlangt als Tradovate und wie Sie in wenigen Minuten verbunden sind.", es: "Su usuario y contraseña de Apex Tradovate funcionan bien en el sitio web de Tradovate, pero NinjaTrader de escritorio sigue mostrando “Incorrect username and password”. Le explicamos por qué la app pide un inicio de sesión distinto al de Tradovate y cómo conectarse en pocos minutos.", fr: "Votre identifiant et votre mot de passe Apex Tradovate fonctionnent sans problème sur le site de Tradovate, mais NinjaTrader desktop affiche toujours « Incorrect username and password ». Voici pourquoi l'application attend une autre connexion que Tradovate, et comment vous connecter en quelques minutes.", it: "Il suo nome utente e la sua password Apex Tradovate funzionano senza problemi sul sito di Tradovate, ma NinjaTrader desktop continua a mostrare “Incorrect username and password”. Ecco perché l'app richiede un login diverso da quello di Tradovate e come collegarsi in pochi minuti." },
  readTime: { en: "7 min read", de: "7 Min. Lesezeit", es: "Lectura de 7 min", fr: "Lecture : 7 min", it: "Lettura di 7 min" },
  lastUpdated: "2026-07-10",
  blocks: { en: [
    { type: "paragraph", html: "You bought an Apex static account, your Tradovate username and password log you in fine on the Tradovate website and the Tradovate desktop app, but the moment you type them into NinjaTrader desktop you get <strong class='text-white'>“Incorrect username and password. Please try again.”</strong> Same credentials, three different results. It feels like a broken account, but it almost never is. The real problem is that NinjaTrader has <em>two</em> completely separate logins, and the sign-in box you're staring at wants a different set of credentials than the one you're feeding it. Get that straight, run a current build, and add the connection the way Apex's Tradovate guide lays out, and you'll be routing orders in a few minutes. Below is exactly what's going on and how to fix it, plus where an automation bridge like PickMyTrade fits if you'd rather skip the desktop-login juggling altogether." },
    {
      type: "checklist",
      heading: "Quick Checklist for the NinjaTrader Apex Login Failure",
      items: [
        "<strong class='text-white'>Sign into the app with your NinjaTrader account.</strong> The desktop platform login wants your NinjaTrader Account Dashboard email and password, not your Tradovate/Apex login.",
        "<strong class='text-white'>Update to the latest 8.1.x build.</strong> NinjaTrader 8.0.x cannot connect to Tradovate at all; grab the current release (8.1.4.1 or later) from the Account Dashboard Download section.",
        "<strong class='text-white'>Enter Tradovate credentials under Connections &gt; Configure.</strong> Your Apex-issued Tradovate username and password belong on the connection, added inside the Control Center, not on the app's main sign-in screen.",
        "<strong class='text-white'>Choose Simulation, not Live.</strong> Apex accounts run in simulation mode; pick Simulation if NinjaTrader asks.",
        "<strong class='text-white'>Kill stray spaces.</strong> No leading or trailing space in the username or password, and no extra characters from copy-paste.",
        "<strong class='text-white'>Still stuck?</strong> Sync your Windows clock, then send log and trace files to NinjaTrader support from Control Center &gt; Help &gt; Email Support.",
      ],
    },
    { type: "heading", text: "Why the Login Fails: Two Logins, One Confusion" },
    { type: "paragraph", html: "Here's the piece nobody spells out clearly. NinjaTrader asks you to authenticate in two different places, and each place wants a different account." },
    { type: "paragraph", html: "The <strong class='text-white'>first login</strong> is the platform itself. When you open the NinjaTrader desktop app, it signs you into the Control Center using your <strong class='text-white'>NinjaTrader account</strong>, the email and password you created on the NinjaTrader Account Dashboard when you first set up the platform. This is the login that everything else hangs off of." },
    { type: "paragraph", html: "The <strong class='text-white'>second login</strong> is the trading connection. Once the Control Center is open, you add your broker or data feed under <strong class='text-white'>Connections &gt; Configure</strong>, and that's where your Tradovate username and password from Apex go. These two credential sets are entirely separate systems. The Tradovate login is only ever used to configure the connection; it is not what unlocks the app." },
    { type: "paragraph", html: "So when you paste your Apex Tradovate username into the app's sign-in prompt and it throws “Incorrect username and password,” the app isn't wrong. You handed it credentials for a system it doesn't check there. It's the same reason those credentials sail through on the Tradovate website: that site is Tradovate, so of course they work. NinjaTrader's front door is a different door." },
    { type: "paragraph", html: "One more thing that trips people up: the word <strong class='text-white'>“static.”</strong> Apex offers static-drawdown accounts alongside trailing-drawdown ones. “Static” only describes how your drawdown limit is calculated, a fixed number that doesn't trail your balance. It changes your risk rules, not your login. The connection steps are identical whether your Apex account is static or trailing, so don't go hunting for a special “static account” setting. There isn't one." },
    { type: "heading", text: "Top Causes of the NinjaTrader Apex Login Failure" },
    { type: "heading", text: "1. You're typing Tradovate credentials into the wrong box" },
    { type: "paragraph", html: "This is the number-one cause. The app's main sign-in wants your NinjaTrader account login. Your Tradovate/Apex login only works inside <strong class='text-white'>Connections &gt; Configure</strong>. Mix them up and you get “Incorrect username and password” every time, even though the details are perfectly valid." },
    { type: "heading", text: "2. You're on an old NinjaTrader 8.0.x build" },
    { type: "paragraph", html: "NinjaTrader 8.0.x releases predate Tradovate support and simply cannot make a Tradovate connection. If you installed the platform a while ago and never updated, no combination of correct credentials will connect a Tradovate account until you move to a current 8.1.x build." },
    { type: "heading", text: "3. Live was selected instead of Simulation" },
    { type: "paragraph", html: "Apex accounts operate in simulation mode. If NinjaTrader presented a Live vs Simulation choice when you added the connection and you picked Live, the connection gets created but never logs on. It looks like a credential failure; it's actually the wrong account type." },
    { type: "heading", text: "4. A stray space or copied character" },
    { type: "paragraph", html: "Copy-pasting the username or password from an email or PDF can drag in a leading space, a trailing space, or an invisible character. NinjaTrader treats that as part of the credential, and the logon fails. Retype both fields by hand if you're unsure." },
    { type: "heading", text: "5. Multi-provider mode isn't enabled" },
    { type: "paragraph", html: "To run a Tradovate connection alongside NinjaTrader's own data, the platform generally needs <strong class='text-white'>Multi-provider</strong> mode switched on. With it off, adding the connection can silently misbehave. It's a quick toggle and a restart." },
    { type: "heading", text: "How to Fix It: Step-by-Step" },
    {
      type: "steps",
      items: [
        { title: "Update NinjaTrader to the latest build", html: "Log in to your <strong class='text-white'>NinjaTrader Account Dashboard</strong> in a browser, open the <strong class='text-white'>Download</strong> section, and grab the newest desktop build (8.1.4.1 or later as of mid-2026). Close any running copy of NinjaTrader first, then run the installer. Updating this way keeps your custom configurations, workspaces, and add-ons intact, it doesn't wipe your setup." },
        { title: "Sign into the desktop app with your NinjaTrader account", html: "Open the freshly updated NinjaTrader Control Center. When it asks you to sign in, use your <strong class='text-white'>NinjaTrader account</strong> email and password, the same ones you use on the Account Dashboard. Do not use your Tradovate/Apex login here. If you can't remember the NinjaTrader password, reset it from the Account Dashboard, not from Tradovate." },
        { title: "Turn on Multi-provider mode", html: "In the Control Center, go to <strong class='text-white'>Tools &gt; Options &gt; General</strong> and enable the <strong class='text-white'>Multi-provider</strong> option, then click <strong class='text-white'>Apply</strong> and <strong class='text-white'>OK</strong>. Fully restart NinjaTrader so the change takes effect before you add the connection." },
        { title: "Add the Tradovate connection with your Apex credentials", html: "Now the part where your Tradovate login actually belongs: <ol><li>Log in to your Apex member dashboard and open the Tradovate section to confirm your <strong class='text-white'>Tradovate username and password</strong>. If you've never logged into Tradovate directly, sign in once at the Tradovate welcome page in a desktop browser and clear any first-time agreements.</li><li>Back in NinjaTrader, go to <strong class='text-white'>Connections &gt; Configure</strong>.</li><li>From the <strong class='text-white'>Available</strong> list, select the connection provider for Tradovate and add it. (The exact label your build shows for a Tradovate-hosted account can vary between releases, if you're unsure which entry to pick, follow the current Apex Tradovate x NinjaTrader connection guide, which names the exact selection for your version.)</li><li>Enter your <strong class='text-white'>Tradovate username and password</strong> from Apex. Type them by hand so no stray spaces sneak in.</li><li>If a <strong class='text-white'>Live vs Simulation</strong> choice appears, select <strong class='text-white'>Simulation</strong>. Apex accounts are simulation accounts.</li><li>Save the connection, then connect to it from <strong class='text-white'>Connections</strong> in the Control Center.</li></ol>" },
        { title: "If it still says logon failed", html: "<ol><li>Re-check the credentials character by character. Delete both fields and retype them; don't paste.</li><li>Sync your Windows clock: <strong class='text-white'>Settings &gt; Time &amp; language &gt; Date &amp; time</strong>, turn on <strong class='text-white'>Set time automatically</strong>, then click <strong class='text-white'>Sync now</strong>. A drifted clock breaks the handshake and reads as a logon failure.</li><li>Confirm you're truly on a current 8.1.x build (check <strong class='text-white'>Help &gt; About</strong>), not an 8.0.x install that happened to update its shortcut.</li><li>Still no luck? Send your logs to NinjaTrader: <strong class='text-white'>Control Center &gt; Help &gt; Email Support</strong>, set the recipient to Platform Technical Support, and make sure the <strong class='text-white'>Log and Trace files</strong> box is checked. Account-specific connection problems are best handled directly by their support, not guessed at.</li></ol>" },
      ],
    },
    { type: "heading", text: "Troubleshooting Table" },
    {
      type: "table",
      headers: ["Symptom", "What's actually wrong", "Fix"],
      rows: [
        ["“Incorrect username and password” in the NinjaTrader app sign-in", "You entered Tradovate/Apex credentials where NinjaTrader wants your NinjaTrader account login", "Sign into the app with your NinjaTrader Account Dashboard email/password; add Tradovate under Connections > Configure"],
        ["No Tradovate option appears, or the connection won't create", "Running an old 8.0.x build that can't connect to Tradovate", "Update to the latest 8.1.x build from the Account Dashboard Download section"],
        ["Connection created but never logs on", "Live was chosen instead of Simulation", "Recreate the connection and select Simulation as the account type"],
        ["Credentials look right but still “logon failed”", "Stray space/character, or drifted system clock", "Retype credentials by hand; sync the Windows clock and retry"],
        ["Second connection misbehaves next to NinjaTrader data", "Multi-provider mode is off", "Enable Multi-provider in Tools > Options > General, then restart"],
        ["Everything checks out and it still won't connect", "Account-specific issue on the connection", "Email log and trace files to NinjaTrader Platform Technical Support"],
      ],
    },
    { type: "heading", text: "Skip the Desktop-Login Juggling with PickMyTrade" },
    { type: "paragraph", html: "If you're on NinjaTrader mainly to route TradingView signals into your Apex Tradovate account, the whole two-login dance is friction you don't need. PickMyTrade bridges your TradingView alerts straight to Tradovate over one steady connection, so you're not re-entering credentials, babysitting a desktop session, or re-selecting Simulation every time you sit down." },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Link once, trade from anywhere</strong>, connect your Tradovate account a single time instead of logging a desktop platform in on every machine.",
        "<strong class='text-white'>TradingView to Tradovate, automated</strong>, alerts fire your entries, exits, and brackets without you touching a login box mid-session.",
        "<strong class='text-white'>Prop-account aware</strong>, route to your Apex simulation account correctly, so orders land where you intend.",
        "<strong class='text-white'>Multi-account copy</strong>, mirror one alert across several Tradovate accounts from one place, no per-account desktop login required.",
      ],
    },
  ], de: [
    { type: "paragraph",html: "Sie haben ein Apex-Static-Konto gekauft, Ihr Tradovate-Benutzername und Ihr Passwort funktionieren auf der Tradovate-Website und in der Tradovate-Desktop-App, doch sobald Sie sie in NinjaTrader Desktop eingeben, erscheint <strong class='text-white'>„Incorrect username and password. Please try again.“</strong> Dieselben Zugangsdaten, drei verschiedene Ergebnisse. Es fühlt sich an wie ein defektes Konto, ist es aber fast nie. Das eigentliche Problem: NinjaTrader hat <em>zwei</em> völlig getrennte Logins, und das Anmeldefeld, vor dem Sie sitzen, verlangt andere Zugangsdaten als die, die Sie eingeben. Klären Sie das, nutzen Sie einen aktuellen Build und legen Sie die Verbindung so an, wie es die Tradovate-Anleitung von Apex beschreibt, und Sie routen in wenigen Minuten Orders. Unten erfahren Sie genau, was passiert und wie Sie es beheben, plus wo eine Automatisierungsbrücke wie PickMyTrade ins Spiel kommt, wenn Sie das Desktop-Login-Jonglieren ganz überspringen möchten." },
    {
      type: "checklist",
      heading: "Schnell-Checkliste bei fehlgeschlagenem NinjaTrader-Apex-Login",
      items: [
        "<strong class='text-white'>Melden Sie sich in der App mit Ihrem NinjaTrader-Konto an.</strong> Der Login der Desktop-Plattform verlangt E-Mail-Adresse und Passwort Ihres NinjaTrader Account Dashboards, nicht Ihren Tradovate-/Apex-Login.",
        "<strong class='text-white'>Aktualisieren Sie auf den neuesten 8.1.x-Build.</strong> NinjaTrader 8.0.x kann sich überhaupt nicht mit Tradovate verbinden; laden Sie die aktuelle Version (8.1.4.1 oder neuer) im Bereich Download des Account Dashboards herunter.",
        "<strong class='text-white'>Geben Sie die Tradovate-Zugangsdaten unter Connections &gt; Configure ein.</strong> Ihr von Apex ausgestellter Tradovate-Benutzername und Ihr Passwort gehören zur Verbindung, die im Control Center hinzugefügt wird, nicht auf den Hauptanmeldebildschirm der App.",
        "<strong class='text-white'>Wählen Sie Simulation, nicht Live.</strong> Apex-Konten laufen im Simulationsmodus; wählen Sie Simulation, falls NinjaTrader danach fragt.",
        "<strong class='text-white'>Entfernen Sie versehentliche Leerzeichen.</strong> Kein führendes oder nachgestelltes Leerzeichen in Benutzername oder Passwort und keine zusätzlichen Zeichen vom Kopieren und Einfügen.",
        "<strong class='text-white'>Immer noch festgefahren?</strong> Synchronisieren Sie Ihre Windows-Uhr und senden Sie dann Log- und Trace-Dateien über Control Center &gt; Help &gt; Email Support an den NinjaTrader-Support.",
      ],
    },
    { type: "heading",text: "Warum der Login fehlschlägt: zwei Logins, eine Verwechslung" },
    { type: "paragraph",html: "Hier ist der Punkt, den niemand klar ausspricht. NinjaTrader verlangt eine Authentifizierung an zwei verschiedenen Stellen, und jede Stelle will ein anderes Konto." },
    { type: "paragraph",html: "Der <strong class='text-white'>erste Login</strong> ist die Plattform selbst. Wenn Sie die NinjaTrader-Desktop-App öffnen, meldet sie Sie mit Ihrem <strong class='text-white'>NinjaTrader-Konto</strong> im Control Center an, also mit der E-Mail-Adresse und dem Passwort, die Sie beim ersten Einrichten der Plattform im NinjaTrader Account Dashboard erstellt haben. An diesem Login hängt alles andere." },
    { type: "paragraph",html: "Der <strong class='text-white'>zweite Login</strong> ist die Handelsverbindung. Sobald das Control Center geöffnet ist, fügen Sie Ihren Broker oder Datenfeed unter <strong class='text-white'>Connections &gt; Configure</strong> hinzu, und genau dort gehören Ihr Tradovate-Benutzername und Ihr Passwort von Apex hin. Diese beiden Zugangsdaten gehören zu völlig getrennten Systemen. Der Tradovate-Login wird ausschließlich zum Einrichten der Verbindung verwendet; er entsperrt nicht die App." },
    { type: "paragraph",html: "Wenn Sie also Ihren Apex-Tradovate-Benutzernamen in die Anmeldeaufforderung der App einfügen und „Incorrect username and password“ erhalten, liegt die App nicht falsch. Sie haben ihr Zugangsdaten für ein System gegeben, das sie an dieser Stelle nicht prüft. Aus demselben Grund funktionieren diese Zugangsdaten problemlos auf der Tradovate-Website: Diese Seite ist Tradovate, natürlich funktionieren sie dort. Die Eingangstür von NinjaTrader ist eine andere Tür." },
    { type: "paragraph",html: "Noch etwas, das viele verwirrt: das Wort <strong class='text-white'>„Static“</strong>. Apex bietet neben Trailing-Drawdown-Konten auch Static-Drawdown-Konten an. „Static“ beschreibt nur, wie Ihr Drawdown-Limit berechnet wird: ein fester Wert, der Ihrem Kontostand nicht nachläuft. Es verändert Ihre Risikoregeln, nicht Ihren Login. Die Verbindungsschritte sind identisch, egal ob Ihr Apex-Konto Static oder Trailing ist; suchen Sie also nicht nach einer speziellen „Static-Konto“-Einstellung. Es gibt keine." },
    { type: "heading",text: "Die häufigsten Ursachen für den fehlgeschlagenen NinjaTrader-Apex-Login" },
    { type: "heading",text: "1. Sie tippen Tradovate-Zugangsdaten in das falsche Feld" },
    { type: "paragraph",html: "Das ist die Ursache Nummer eins. Die Hauptanmeldung der App verlangt Ihren NinjaTrader-Konto-Login. Ihr Tradovate-/Apex-Login funktioniert nur unter <strong class='text-white'>Connections &gt; Configure</strong>. Werden die beiden vertauscht, erhalten Sie jedes Mal „Incorrect username and password“, obwohl die Daten völlig korrekt sind." },
    { type: "heading",text: "2. Sie verwenden einen alten NinjaTrader-8.0.x-Build" },
    { type: "paragraph",html: "NinjaTrader-8.0.x-Versionen stammen aus der Zeit vor der Tradovate-Unterstützung und können schlicht keine Tradovate-Verbindung aufbauen. Haben Sie die Plattform vor einiger Zeit installiert und nie aktualisiert, verbindet keine Kombination korrekter Zugangsdaten ein Tradovate-Konto, bis Sie auf einen aktuellen 8.1.x-Build wechseln." },
    { type: "heading",text: "3. Live statt Simulation wurde ausgewählt" },
    { type: "paragraph",html: "Apex-Konten laufen im Simulationsmodus. Hat NinjaTrader beim Hinzufügen der Verbindung eine Auswahl zwischen Live und Simulation angezeigt und Sie haben Live gewählt, wird die Verbindung zwar angelegt, meldet sich aber nie an. Es sieht aus wie ein Zugangsdatenfehler; tatsächlich ist es der falsche Kontotyp." },
    { type: "heading",text: "4. Ein verirrtes Leerzeichen oder kopiertes Zeichen" },
    { type: "paragraph",html: "Beim Kopieren und Einfügen von Benutzername oder Passwort aus einer E-Mail oder einem PDF können ein führendes Leerzeichen, ein nachgestelltes Leerzeichen oder ein unsichtbares Zeichen mitkommen. NinjaTrader wertet das als Teil der Zugangsdaten, und die Anmeldung scheitert. Tippen Sie beide Felder von Hand neu ein, wenn Sie unsicher sind." },
    { type: "heading",text: "5. Der Multi-provider-Modus ist nicht aktiviert" },
    { type: "paragraph",html: "Um eine Tradovate-Verbindung parallel zu den eigenen Daten von NinjaTrader zu betreiben, muss in der Regel der Modus <strong class='text-white'>Multi-provider</strong> eingeschaltet sein. Ist er aus, kann das Hinzufügen der Verbindung stillschweigend fehlerhaft ablaufen. Es ist ein schneller Schalter und ein Neustart." },
    { type: "heading",text: "So beheben Sie es: Schritt für Schritt" },
    {
      type: "steps",
      items: [
        { title: "NinjaTrader auf den neuesten Build aktualisieren", html: "Melden Sie sich in einem Browser in Ihrem <strong class='text-white'>NinjaTrader Account Dashboard</strong> an, öffnen Sie den Bereich <strong class='text-white'>Download</strong> und laden Sie den neuesten Desktop-Build herunter (8.1.4.1 oder neuer, Stand Mitte 2026). Schließen Sie zuvor jede laufende Instanz von NinjaTrader und führen Sie dann das Installationsprogramm aus. Bei einem Update auf diesem Weg bleiben Ihre benutzerdefinierten Konfigurationen, Workspaces und Add-ons erhalten, Ihr Setup wird nicht gelöscht." },
        { title: "Mit Ihrem NinjaTrader-Konto in der Desktop-App anmelden", html: "Öffnen Sie das frisch aktualisierte NinjaTrader Control Center. Wenn es zur Anmeldung auffordert, verwenden Sie E-Mail-Adresse und Passwort Ihres <strong class='text-white'>NinjaTrader-Kontos</strong>, dieselben wie im Account Dashboard. Verwenden Sie hier nicht Ihren Tradovate-/Apex-Login. Wenn Sie das NinjaTrader-Passwort vergessen haben, setzen Sie es im Account Dashboard zurück, nicht bei Tradovate." },
        { title: "Multi-provider-Modus einschalten", html: "Gehen Sie im Control Center zu <strong class='text-white'>Tools &gt; Options &gt; General</strong> und aktivieren Sie die Option <strong class='text-white'>Multi-provider</strong>, klicken Sie dann auf <strong class='text-white'>Apply</strong> und <strong class='text-white'>OK</strong>. Starten Sie NinjaTrader vollständig neu, damit die Änderung greift, bevor Sie die Verbindung hinzufügen." },
        { title: "Die Tradovate-Verbindung mit Ihren Apex-Zugangsdaten hinzufügen", html: "Jetzt kommt der Teil, in den Ihr Tradovate-Login tatsächlich gehört: <ol><li>Melden Sie sich in Ihrem Apex-Mitglieder-Dashboard an und öffnen Sie den Tradovate-Bereich, um Ihren <strong class='text-white'>Tradovate-Benutzernamen und Ihr Passwort</strong> zu bestätigen. Haben Sie sich noch nie direkt bei Tradovate angemeldet, melden Sie sich einmal auf der Tradovate-Willkommensseite in einem Desktop-Browser an und bestätigen Sie alle Erstvereinbarungen.</li><li>Gehen Sie zurück in NinjaTrader zu <strong class='text-white'>Connections &gt; Configure</strong>.</li><li>Wählen Sie in der Liste <strong class='text-white'>Available</strong> den Verbindungsanbieter für Tradovate aus und fügen Sie ihn hinzu. (Die genaue Bezeichnung, die Ihr Build für ein bei Tradovate gehostetes Konto anzeigt, kann zwischen den Versionen variieren. Wenn Sie unsicher sind, welchen Eintrag Sie wählen sollen, folgen Sie der aktuellen Apex-Anleitung zur Tradovate-x-NinjaTrader-Verbindung, die die genaue Auswahl für Ihre Version nennt.)</li><li>Geben Sie Ihren <strong class='text-white'>Tradovate-Benutzernamen und Ihr Passwort</strong> von Apex ein. Tippen Sie sie von Hand ein, damit sich keine versehentlichen Leerzeichen einschleichen.</li><li>Erscheint eine Auswahl <strong class='text-white'>Live vs Simulation</strong>, wählen Sie <strong class='text-white'>Simulation</strong>. Apex-Konten sind Simulationskonten.</li><li>Speichern Sie die Verbindung und verbinden Sie sich dann im Control Center über <strong class='text-white'>Connections</strong> damit.</li></ol>" },
        { title: "Wenn es weiterhin „logon failed“ meldet", html: "<ol><li>Prüfen Sie die Zugangsdaten Zeichen für Zeichen. Löschen Sie beide Felder und tippen Sie sie neu ein; fügen Sie sie nicht per Einfügen ein.</li><li>Synchronisieren Sie Ihre Windows-Uhr: <strong class='text-white'>Settings &gt; Time &amp; language &gt; Date &amp; time</strong>, aktivieren Sie <strong class='text-white'>Set time automatically</strong> und klicken Sie dann auf <strong class='text-white'>Sync now</strong>. Eine abweichende Uhr stört den Handshake und wird als Anmeldefehler gelesen.</li><li>Vergewissern Sie sich, dass Sie wirklich einen aktuellen 8.1.x-Build verwenden (prüfen Sie <strong class='text-white'>Help &gt; About</strong>) und keine 8.0.x-Installation, deren Verknüpfung zufällig aktualisiert wurde.</li><li>Immer noch kein Erfolg? Senden Sie Ihre Logs an NinjaTrader: <strong class='text-white'>Control Center &gt; Help &gt; Email Support</strong>, setzen Sie den Empfänger auf Platform Technical Support und stellen Sie sicher, dass das Kästchen <strong class='text-white'>Log and Trace files</strong> aktiviert ist. Kontospezifische Verbindungsprobleme klärt am besten direkt deren Support, statt zu raten.</li></ol>" },
      ],
    },
    { type: "heading",text: "Tabelle zur Fehlerbehebung" },
    { type: "table", headers: ["Symptom","Was tatsächlich falsch ist","Lösung"], rows: [
      ["„Incorrect username and password“ bei der Anmeldung in der NinjaTrader-App","Sie haben Tradovate-/Apex-Zugangsdaten dort eingegeben, wo NinjaTrader Ihren NinjaTrader-Konto-Login erwartet","Melden Sie sich in der App mit E-Mail-Adresse/Passwort Ihres NinjaTrader Account Dashboards an; fügen Sie Tradovate unter Connections > Configure hinzu"],
      ["Es erscheint keine Tradovate-Option oder die Verbindung lässt sich nicht anlegen","Ein alter 8.0.x-Build, der sich nicht mit Tradovate verbinden kann","Auf den neuesten 8.1.x-Build aus dem Bereich Download des Account Dashboards aktualisieren"],
      ["Verbindung angelegt, meldet sich aber nie an","Live wurde statt Simulation gewählt","Verbindung neu anlegen und Simulation als Kontotyp wählen"],
      ["Zugangsdaten sehen richtig aus, aber weiterhin „logon failed“","Verirrtes Leerzeichen/Zeichen oder abweichende Systemuhr","Zugangsdaten von Hand neu eingeben; Windows-Uhr synchronisieren und erneut versuchen"],
      ["Zweite Verbindung verhält sich neben NinjaTrader-Daten fehlerhaft","Multi-provider-Modus ist aus","Multi-provider unter Tools > Options > General aktivieren, dann neu starten"],
      ["Alles stimmt und es verbindet sich trotzdem nicht","Kontospezifisches Problem bei der Verbindung","Log- und Trace-Dateien per E-Mail an NinjaTrader Platform Technical Support senden"],
    ] },
    { type: "heading",text: "Schluss mit dem Desktop-Login-Jonglieren mit PickMyTrade" },
    { type: "paragraph",html: "Wenn Sie NinjaTrader hauptsächlich nutzen, um TradingView-Signale in Ihr Apex-Tradovate-Konto zu routen, ist der ganze Zwei-Login-Tanz unnötige Reibung. PickMyTrade verbindet Ihre TradingView-Alerts über eine stabile Verbindung direkt mit Tradovate, sodass Sie weder Zugangsdaten erneut eingeben, noch eine Desktop-Sitzung beaufsichtigen, noch jedes Mal Simulation neu auswählen müssen, wenn Sie sich hinsetzen." },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Einmal verknüpfen, von überall handeln</strong>: Verbinden Sie Ihr Tradovate-Konto ein einziges Mal, statt eine Desktop-Plattform auf jedem Rechner anzumelden.",
        "<strong class='text-white'>TradingView zu Tradovate, automatisiert</strong>: Alerts lösen Ihre Einstiege, Ausstiege und Brackets aus, ohne dass Sie mitten in der Sitzung ein Anmeldefeld anfassen müssen.",
        "<strong class='text-white'>Prop-Konto-bewusst</strong>: Routet korrekt auf Ihr Apex-Simulationskonto, sodass Orders dort landen, wo Sie es beabsichtigen.",
        "<strong class='text-white'>Multi-Account-Kopie</strong>: Spiegeln Sie einen Alert von einem Ort aus auf mehrere Tradovate-Konten, ohne Desktop-Login pro Konto.",
      ],
    },
  ], es: [
    { type: "paragraph",html: "Compró una cuenta Apex static, su usuario y contraseña de Tradovate funcionan en el sitio web de Tradovate y en la app de escritorio de Tradovate, pero en cuanto los escribe en NinjaTrader de escritorio aparece <strong class='text-white'>“Incorrect username and password. Please try again.”</strong> Las mismas credenciales, tres resultados distintos. Parece una cuenta rota, pero casi nunca lo es. El problema real es que NinjaTrader tiene <em>dos</em> inicios de sesión completamente separados, y el cuadro de acceso que tiene delante pide credenciales distintas de las que está introduciendo. Aclare eso, use una versión actual y añada la conexión como indica la guía de Tradovate de Apex, y estará enrutando órdenes en pocos minutos. A continuación verá exactamente qué ocurre y cómo solucionarlo, además de dónde encaja un puente de automatización como PickMyTrade si prefiere saltarse por completo el malabarismo con los inicios de sesión de escritorio." },
    {
      type: "checklist",
      heading: "Lista de verificación rápida para el fallo de inicio de sesión de NinjaTrader con Apex",
      items: [
        "<strong class='text-white'>Inicie sesión en la app con su cuenta de NinjaTrader.</strong> El acceso de la plataforma de escritorio pide el correo electrónico y la contraseña de su NinjaTrader Account Dashboard, no su inicio de sesión de Tradovate/Apex.",
        "<strong class='text-white'>Actualice a la última versión 8.1.x.</strong> NinjaTrader 8.0.x no puede conectarse a Tradovate en absoluto; descargue la versión actual (8.1.4.1 o posterior) desde la sección Download del Account Dashboard.",
        "<strong class='text-white'>Introduzca las credenciales de Tradovate en Connections &gt; Configure.</strong> Su usuario y contraseña de Tradovate emitidos por Apex pertenecen a la conexión, que se añade dentro del Control Center, no a la pantalla de acceso principal de la app.",
        "<strong class='text-white'>Elija Simulation, no Live.</strong> Las cuentas de Apex funcionan en modo de simulación; seleccione Simulation si NinjaTrader se lo pregunta.",
        "<strong class='text-white'>Elimine los espacios sobrantes.</strong> Sin espacios iniciales ni finales en el usuario o la contraseña, y sin caracteres adicionales al copiar y pegar.",
        "<strong class='text-white'>¿Sigue atascado?</strong> Sincronice el reloj de Windows y envíe los archivos de registro y traza al soporte de NinjaTrader desde Control Center &gt; Help &gt; Email Support.",
      ],
    },
    { type: "heading",text: "Por qué falla el inicio de sesión: dos accesos, una confusión" },
    { type: "paragraph",html: "Esta es la pieza que nadie explica con claridad. NinjaTrader le pide autenticarse en dos lugares distintos, y cada lugar quiere una cuenta diferente." },
    { type: "paragraph",html: "El <strong class='text-white'>primer inicio de sesión</strong> es la propia plataforma. Al abrir la app de escritorio de NinjaTrader, esta le inicia sesión en el Control Center con su <strong class='text-white'>cuenta de NinjaTrader</strong>, el correo electrónico y la contraseña que creó en el NinjaTrader Account Dashboard cuando configuró la plataforma por primera vez. De este acceso depende todo lo demás." },
    { type: "paragraph",html: "El <strong class='text-white'>segundo inicio de sesión</strong> es la conexión de trading. Una vez abierto el Control Center, añade su bróker o proveedor de datos en <strong class='text-white'>Connections &gt; Configure</strong>, y es ahí donde van su usuario y contraseña de Tradovate de Apex. Estos dos conjuntos de credenciales pertenecen a sistemas totalmente independientes. El acceso de Tradovate solo se usa para configurar la conexión; no es lo que desbloquea la app." },
    { type: "paragraph",html: "Así que, cuando pega su usuario de Apex Tradovate en el cuadro de acceso de la app y aparece “Incorrect username and password”, la app no se equivoca. Le ha entregado credenciales de un sistema que no comprueba en ese punto. Es la misma razón por la que esas credenciales funcionan sin problema en el sitio web de Tradovate: ese sitio es Tradovate, así que, por supuesto, funcionan. La puerta de entrada de NinjaTrader es otra puerta." },
    { type: "paragraph",html: "Otra cosa que confunde a la gente: la palabra <strong class='text-white'>“static”</strong>. Apex ofrece cuentas con drawdown estático junto a las de drawdown móvil. “Static” solo describe cómo se calcula su límite de drawdown: una cifra fija que no sigue a su saldo. Cambia sus reglas de riesgo, no su inicio de sesión. Los pasos de conexión son idénticos tanto si su cuenta de Apex es static como trailing, así que no busque un ajuste especial de “cuenta static”. No existe." },
    { type: "heading",text: "Principales causas del fallo de inicio de sesión de NinjaTrader con Apex" },
    { type: "heading",text: "1. Está escribiendo credenciales de Tradovate en el cuadro equivocado" },
    { type: "paragraph",html: "Esta es la causa número uno. El acceso principal de la app pide el inicio de sesión de su cuenta de NinjaTrader. Su inicio de sesión de Tradovate/Apex solo funciona dentro de <strong class='text-white'>Connections &gt; Configure</strong>. Si los confunde, obtendrá “Incorrect username and password” siempre, aunque los datos sean perfectamente válidos." },
    { type: "heading",text: "2. Tiene una versión antigua 8.0.x de NinjaTrader" },
    { type: "paragraph",html: "Las versiones 8.0.x de NinjaTrader son anteriores a la compatibilidad con Tradovate y sencillamente no pueden establecer una conexión con Tradovate. Si instaló la plataforma hace tiempo y nunca la actualizó, ninguna combinación de credenciales correctas conectará una cuenta de Tradovate hasta que pase a una versión 8.1.x actual." },
    { type: "heading",text: "3. Se seleccionó Live en lugar de Simulation" },
    { type: "paragraph",html: "Las cuentas de Apex operan en modo de simulación. Si NinjaTrader le presentó una opción entre Live y Simulation al añadir la conexión y eligió Live, la conexión se crea pero nunca inicia sesión. Parece un fallo de credenciales; en realidad es el tipo de cuenta equivocado." },
    { type: "heading",text: "4. Un espacio sobrante o un carácter copiado" },
    { type: "paragraph",html: "Al copiar y pegar el usuario o la contraseña desde un correo o un PDF pueden colarse un espacio inicial, un espacio final o un carácter invisible. NinjaTrader lo trata como parte de la credencial y el inicio de sesión falla. Vuelva a escribir ambos campos a mano si tiene dudas." },
    { type: "heading",text: "5. El modo Multi-provider no está activado" },
    { type: "paragraph",html: "Para ejecutar una conexión de Tradovate junto con los datos propios de NinjaTrader, la plataforma suele necesitar el modo <strong class='text-white'>Multi-provider</strong> activado. Si está desactivado, añadir la conexión puede comportarse mal sin avisar. Es un ajuste rápido y un reinicio." },
    { type: "heading",text: "Cómo solucionarlo: paso a paso" },
    {
      type: "steps",
      items: [
        { title: "Actualice NinjaTrader a la última versión", html: "Inicie sesión en su <strong class='text-white'>NinjaTrader Account Dashboard</strong> en un navegador, abra la sección <strong class='text-white'>Download</strong> y descargue la versión de escritorio más reciente (8.1.4.1 o posterior a mediados de 2026). Cierre antes cualquier copia de NinjaTrader en ejecución y luego ejecute el instalador. Al actualizar de este modo se conservan sus configuraciones personalizadas, workspaces y complementos; no se borra su configuración." },
        { title: "Inicie sesión en la app de escritorio con su cuenta de NinjaTrader", html: "Abra el Control Center de NinjaTrader recién actualizado. Cuando le pida iniciar sesión, use el correo electrónico y la contraseña de su <strong class='text-white'>cuenta de NinjaTrader</strong>, los mismos que usa en el Account Dashboard. No use aquí su inicio de sesión de Tradovate/Apex. Si no recuerda la contraseña de NinjaTrader, restablézcala desde el Account Dashboard, no desde Tradovate." },
        { title: "Active el modo Multi-provider", html: "En el Control Center, vaya a <strong class='text-white'>Tools &gt; Options &gt; General</strong> y active la opción <strong class='text-white'>Multi-provider</strong>; después haga clic en <strong class='text-white'>Apply</strong> y en <strong class='text-white'>OK</strong>. Reinicie NinjaTrader por completo para que el cambio surta efecto antes de añadir la conexión." },
        { title: "Añada la conexión de Tradovate con sus credenciales de Apex", html: "Ahora llega la parte donde realmente va su inicio de sesión de Tradovate: <ol><li>Inicie sesión en su panel de miembro de Apex y abra la sección de Tradovate para confirmar su <strong class='text-white'>usuario y contraseña de Tradovate</strong>. Si nunca ha iniciado sesión directamente en Tradovate, hágalo una vez en la página de bienvenida de Tradovate desde un navegador de escritorio y acepte los acuerdos de primer uso.</li><li>De vuelta en NinjaTrader, vaya a <strong class='text-white'>Connections &gt; Configure</strong>.</li><li>En la lista <strong class='text-white'>Available</strong>, seleccione el proveedor de conexión de Tradovate y añádalo. (La etiqueta exacta que muestra su versión para una cuenta alojada en Tradovate puede variar entre versiones; si no está seguro de qué entrada elegir, siga la guía actual de conexión de Apex Tradovate x NinjaTrader, que indica la selección exacta para su versión.)</li><li>Introduzca su <strong class='text-white'>usuario y contraseña de Tradovate</strong> de Apex. Escríbalos a mano para que no se cuelen espacios sobrantes.</li><li>Si aparece una opción <strong class='text-white'>Live vs Simulation</strong>, seleccione <strong class='text-white'>Simulation</strong>. Las cuentas de Apex son cuentas de simulación.</li><li>Guarde la conexión y después conéctese a ella desde <strong class='text-white'>Connections</strong> en el Control Center.</li></ol>" },
        { title: "Si sigue apareciendo logon failed", html: "<ol><li>Vuelva a comprobar las credenciales carácter por carácter. Borre ambos campos y vuelva a escribirlos; no los pegue.</li><li>Sincronice el reloj de Windows: <strong class='text-white'>Settings &gt; Time &amp; language &gt; Date &amp; time</strong>, active <strong class='text-white'>Set time automatically</strong> y haga clic en <strong class='text-white'>Sync now</strong>. Un reloj desfasado rompe el handshake y se interpreta como un fallo de inicio de sesión.</li><li>Confirme que realmente usa una versión 8.1.x actual (compruebe <strong class='text-white'>Help &gt; About</strong>), y no una instalación 8.0.x cuyo acceso directo se actualizó por casualidad.</li><li>¿Sigue sin funcionar? Envíe sus registros a NinjaTrader: <strong class='text-white'>Control Center &gt; Help &gt; Email Support</strong>, establezca como destinatario Platform Technical Support y asegúrese de que la casilla <strong class='text-white'>Log and Trace files</strong> esté marcada. Los problemas de conexión específicos de una cuenta se resuelven mejor directamente con su soporte, sin adivinar.</li></ol>" },
      ],
    },
    { type: "heading",text: "Tabla de resolución de problemas" },
    { type: "table", headers: ["Síntoma","Qué falla realmente","Solución"], rows: [
      ["“Incorrect username and password” en el acceso de la app de NinjaTrader","Introdujo credenciales de Tradovate/Apex donde NinjaTrader pide el inicio de sesión de su cuenta de NinjaTrader","Inicie sesión en la app con el correo/contraseña de su NinjaTrader Account Dashboard; añada Tradovate en Connections > Configure"],
      ["No aparece ninguna opción de Tradovate o la conexión no se crea","Versión antigua 8.0.x que no puede conectarse a Tradovate","Actualice a la última versión 8.1.x desde la sección Download del Account Dashboard"],
      ["La conexión se crea pero nunca inicia sesión","Se eligió Live en lugar de Simulation","Vuelva a crear la conexión y seleccione Simulation como tipo de cuenta"],
      ["Las credenciales parecen correctas pero sigue “logon failed”","Espacio o carácter sobrante, o reloj del sistema desfasado","Vuelva a escribir las credenciales a mano; sincronice el reloj de Windows y reintente"],
      ["Una segunda conexión se comporta mal junto a los datos de NinjaTrader","El modo Multi-provider está desactivado","Active Multi-provider en Tools > Options > General y reinicie"],
      ["Todo es correcto y aun así no conecta","Problema específico de la cuenta en la conexión","Envíe por correo los archivos de registro y traza a NinjaTrader Platform Technical Support"],
    ] },
    { type: "heading",text: "Olvídese del malabarismo con los inicios de sesión de escritorio con PickMyTrade" },
    { type: "paragraph",html: "Si usa NinjaTrader principalmente para enrutar señales de TradingView a su cuenta de Apex Tradovate, todo el baile de los dos inicios de sesión es una fricción innecesaria. PickMyTrade conecta sus alertas de TradingView directamente con Tradovate mediante una conexión estable, de modo que no tiene que volver a introducir credenciales, vigilar una sesión de escritorio ni volver a seleccionar Simulation cada vez que se sienta a operar." },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Vincule una vez, opere desde cualquier lugar</strong>: conecte su cuenta de Tradovate una sola vez en lugar de iniciar sesión en una plataforma de escritorio en cada equipo.",
        "<strong class='text-white'>De TradingView a Tradovate, automatizado</strong>: las alertas disparan sus entradas, salidas y brackets sin que toque un cuadro de acceso en mitad de la sesión.",
        "<strong class='text-white'>Preparado para cuentas prop</strong>: enruta correctamente a su cuenta de simulación de Apex, para que las órdenes lleguen donde usted pretende.",
        "<strong class='text-white'>Copia multicuenta</strong>: replique una alerta en varias cuentas de Tradovate desde un solo lugar, sin inicio de sesión de escritorio por cuenta.",
      ],
    },
  ], fr: [
    { type: "paragraph",html: "Vous avez acheté un compte Apex static, votre identifiant et votre mot de passe Tradovate fonctionnent sur le site de Tradovate et dans l'application de bureau Tradovate, mais dès que vous les saisissez dans NinjaTrader desktop, vous obtenez <strong class='text-white'>« Incorrect username and password. Please try again. »</strong> Mêmes identifiants, trois résultats différents. On dirait un compte défaillant, mais ce n'est presque jamais le cas. Le vrai problème : NinjaTrader possède <em>deux</em> connexions totalement séparées, et la fenêtre de connexion devant vous attend d'autres identifiants que ceux que vous lui donnez. Clarifiez ce point, utilisez une version actuelle et ajoutez la connexion comme l'indique le guide Tradovate d'Apex, et vous routerez des ordres en quelques minutes. Vous trouverez ci-dessous ce qui se passe exactement et comment y remédier, ainsi que la place d'un pont d'automatisation comme PickMyTrade si vous préférez éviter complètement le jonglage entre connexions de bureau." },
    {
      type: "checklist",
      heading: "Liste de vérification rapide pour l'échec de connexion NinjaTrader Apex",
      items: [
        "<strong class='text-white'>Connectez-vous à l'application avec votre compte NinjaTrader.</strong> La connexion de la plateforme de bureau attend l'e-mail et le mot de passe de votre NinjaTrader Account Dashboard, pas votre connexion Tradovate/Apex.",
        "<strong class='text-white'>Mettez à jour vers la dernière version 8.1.x.</strong> NinjaTrader 8.0.x ne peut pas du tout se connecter à Tradovate ; téléchargez la version actuelle (8.1.4.1 ou ultérieure) dans la section Download du Account Dashboard.",
        "<strong class='text-white'>Saisissez les identifiants Tradovate dans Connections &gt; Configure.</strong> Votre identifiant et votre mot de passe Tradovate fournis par Apex appartiennent à la connexion ajoutée dans le Control Center, pas à l'écran de connexion principal de l'application.",
        "<strong class='text-white'>Choisissez Simulation, pas Live.</strong> Les comptes Apex fonctionnent en mode simulation ; sélectionnez Simulation si NinjaTrader vous le demande.",
        "<strong class='text-white'>Éliminez les espaces parasites.</strong> Aucun espace au début ni à la fin de l'identifiant ou du mot de passe, et aucun caractère superflu issu d'un copier-coller.",
        "<strong class='text-white'>Toujours bloqué ?</strong> Synchronisez l'horloge de Windows, puis envoyez les fichiers de journal et de trace au support NinjaTrader depuis Control Center &gt; Help &gt; Email Support.",
      ],
    },
    { type: "heading",text: "Pourquoi la connexion échoue : deux connexions, une confusion" },
    { type: "paragraph",html: "Voici l'élément que personne n'explique clairement. NinjaTrader vous demande de vous authentifier à deux endroits différents, et chaque endroit attend un compte différent." },
    { type: "paragraph",html: "La <strong class='text-white'>première connexion</strong> est la plateforme elle-même. Lorsque vous ouvrez l'application NinjaTrader desktop, elle vous connecte au Control Center avec votre <strong class='text-white'>compte NinjaTrader</strong>, l'e-mail et le mot de passe créés sur le NinjaTrader Account Dashboard lors de la première configuration de la plateforme. Tout le reste dépend de cette connexion." },
    { type: "paragraph",html: "La <strong class='text-white'>seconde connexion</strong> est la connexion de trading. Une fois le Control Center ouvert, vous ajoutez votre courtier ou votre flux de données sous <strong class='text-white'>Connections &gt; Configure</strong>, et c'est là que vont votre identifiant et votre mot de passe Tradovate d'Apex. Ces deux jeux d'identifiants relèvent de systèmes entièrement distincts. L'identifiant Tradovate ne sert qu'à configurer la connexion ; ce n'est pas lui qui déverrouille l'application." },
    { type: "paragraph",html: "Ainsi, lorsque vous collez votre identifiant Apex Tradovate dans la fenêtre de connexion de l'application et qu'elle affiche « Incorrect username and password », l'application n'a pas tort. Vous lui avez remis des identifiants d'un système qu'elle ne vérifie pas à cet endroit. C'est aussi la raison pour laquelle ces identifiants passent sans problème sur le site de Tradovate : ce site, c'est Tradovate, évidemment qu'ils y fonctionnent. La porte d'entrée de NinjaTrader est une autre porte." },
    { type: "paragraph",html: "Un autre point qui trompe beaucoup de monde : le mot <strong class='text-white'>« static »</strong>. Apex propose des comptes à drawdown statique à côté de comptes à drawdown glissant. « Static » décrit uniquement la façon dont votre limite de drawdown est calculée : un chiffre fixe qui ne suit pas votre solde. Cela change vos règles de risque, pas votre connexion. Les étapes de connexion sont identiques que votre compte Apex soit static ou trailing ; inutile donc de chercher un réglage spécial « compte static ». Il n'en existe pas." },
    { type: "heading",text: "Principales causes de l'échec de connexion NinjaTrader Apex" },
    { type: "heading",text: "1. Vous saisissez des identifiants Tradovate dans la mauvaise fenêtre" },
    { type: "paragraph",html: "C'est la cause numéro un. La connexion principale de l'application attend les identifiants de votre compte NinjaTrader. Votre connexion Tradovate/Apex ne fonctionne que dans <strong class='text-white'>Connections &gt; Configure</strong>. Si vous les confondez, vous obtenez « Incorrect username and password » à chaque fois, même si les données sont parfaitement valides." },
    { type: "heading",text: "2. Vous utilisez une ancienne version NinjaTrader 8.0.x" },
    { type: "paragraph",html: "Les versions 8.0.x de NinjaTrader sont antérieures à la prise en charge de Tradovate et ne peuvent tout simplement pas établir de connexion Tradovate. Si vous avez installé la plateforme il y a longtemps sans la mettre à jour, aucune combinaison d'identifiants corrects ne connectera un compte Tradovate tant que vous ne serez pas passé à une version 8.1.x actuelle." },
    { type: "heading",text: "3. Live a été sélectionné au lieu de Simulation" },
    { type: "paragraph",html: "Les comptes Apex fonctionnent en mode simulation. Si NinjaTrader vous a proposé un choix Live ou Simulation lors de l'ajout de la connexion et que vous avez choisi Live, la connexion est créée mais ne se connecte jamais. Cela ressemble à un échec d'identifiants ; en réalité, c'est le mauvais type de compte." },
    { type: "heading",text: "4. Un espace parasite ou un caractère copié" },
    { type: "paragraph",html: "Copier-coller l'identifiant ou le mot de passe depuis un e-mail ou un PDF peut entraîner un espace au début, un espace à la fin ou un caractère invisible. NinjaTrader les considère comme faisant partie de l'identifiant et la connexion échoue. Retapez les deux champs à la main en cas de doute." },
    { type: "heading",text: "5. Le mode Multi-provider n'est pas activé" },
    { type: "paragraph",html: "Pour faire tourner une connexion Tradovate parallèlement aux données propres de NinjaTrader, la plateforme a généralement besoin du mode <strong class='text-white'>Multi-provider</strong> activé. Désactivé, l'ajout de la connexion peut se comporter de façon erratique sans avertissement. C'est un réglage rapide et un redémarrage." },
    { type: "heading",text: "Comment le corriger : étape par étape" },
    {
      type: "steps",
      items: [
        { title: "Mettre à jour NinjaTrader vers la dernière version", html: "Connectez-vous à votre <strong class='text-white'>NinjaTrader Account Dashboard</strong> dans un navigateur, ouvrez la section <strong class='text-white'>Download</strong> et téléchargez la version de bureau la plus récente (8.1.4.1 ou ultérieure à la mi-2026). Fermez d'abord toute instance de NinjaTrader en cours, puis lancez l'installateur. Une mise à jour de cette manière conserve vos configurations personnalisées, vos workspaces et vos modules complémentaires intacts ; votre configuration n'est pas effacée." },
        { title: "Se connecter à l'application de bureau avec votre compte NinjaTrader", html: "Ouvrez le Control Center de NinjaTrader tout juste mis à jour. Lorsqu'il vous demande de vous connecter, utilisez l'e-mail et le mot de passe de votre <strong class='text-white'>compte NinjaTrader</strong>, les mêmes que sur le Account Dashboard. N'utilisez pas ici votre connexion Tradovate/Apex. Si vous ne vous souvenez plus du mot de passe NinjaTrader, réinitialisez-le depuis le Account Dashboard, pas depuis Tradovate." },
        { title: "Activer le mode Multi-provider", html: "Dans le Control Center, allez dans <strong class='text-white'>Tools &gt; Options &gt; General</strong> et activez l'option <strong class='text-white'>Multi-provider</strong>, puis cliquez sur <strong class='text-white'>Apply</strong> et <strong class='text-white'>OK</strong>. Redémarrez complètement NinjaTrader pour que la modification prenne effet avant d'ajouter la connexion." },
        { title: "Ajouter la connexion Tradovate avec vos identifiants Apex", html: "Voici maintenant l'endroit où votre connexion Tradovate a réellement sa place : <ol><li>Connectez-vous à votre tableau de bord membre Apex et ouvrez la section Tradovate pour confirmer votre <strong class='text-white'>identifiant et mot de passe Tradovate</strong>. Si vous ne vous êtes jamais connecté directement à Tradovate, connectez-vous une fois sur la page d'accueil de Tradovate dans un navigateur de bureau et acceptez les accords de première utilisation.</li><li>De retour dans NinjaTrader, allez dans <strong class='text-white'>Connections &gt; Configure</strong>.</li><li>Dans la liste <strong class='text-white'>Available</strong>, sélectionnez le fournisseur de connexion pour Tradovate et ajoutez-le. (Le libellé exact affiché par votre version pour un compte hébergé chez Tradovate peut varier d'une version à l'autre ; si vous ne savez pas quelle entrée choisir, suivez le guide actuel de connexion Apex Tradovate x NinjaTrader, qui indique la sélection exacte pour votre version.)</li><li>Saisissez votre <strong class='text-white'>identifiant et mot de passe Tradovate</strong> d'Apex. Tapez-les à la main pour éviter qu'un espace parasite ne s'y glisse.</li><li>Si un choix <strong class='text-white'>Live vs Simulation</strong> apparaît, sélectionnez <strong class='text-white'>Simulation</strong>. Les comptes Apex sont des comptes de simulation.</li><li>Enregistrez la connexion, puis connectez-vous-y depuis <strong class='text-white'>Connections</strong> dans le Control Center.</li></ol>" },
        { title: "Si « logon failed » s'affiche toujours", html: "<ol><li>Revérifiez les identifiants caractère par caractère. Effacez les deux champs et retapez-les ; ne les collez pas.</li><li>Synchronisez l'horloge de Windows : <strong class='text-white'>Settings &gt; Time &amp; language &gt; Date &amp; time</strong>, activez <strong class='text-white'>Set time automatically</strong>, puis cliquez sur <strong class='text-white'>Sync now</strong>. Une horloge décalée perturbe la négociation et se manifeste comme un échec de connexion.</li><li>Vérifiez que vous utilisez bien une version 8.1.x actuelle (consultez <strong class='text-white'>Help &gt; About</strong>), et non une installation 8.0.x dont le raccourci aurait simplement été mis à jour.</li><li>Toujours pas de résultat ? Envoyez vos journaux à NinjaTrader : <strong class='text-white'>Control Center &gt; Help &gt; Email Support</strong>, définissez le destinataire sur Platform Technical Support et assurez-vous que la case <strong class='text-white'>Log and Trace files</strong> est cochée. Les problèmes de connexion propres à un compte se traitent mieux directement avec leur support, sans conjectures.</li></ol>" },
      ],
    },
    { type: "heading",text: "Tableau de dépannage" },
    { type: "table", headers: ["Symptôme","Ce qui ne va réellement pas","Solution"], rows: [
      ["« Incorrect username and password » dans la connexion de l'application NinjaTrader","Vous avez saisi des identifiants Tradovate/Apex là où NinjaTrader attend la connexion de votre compte NinjaTrader","Connectez-vous à l'application avec l'e-mail/mot de passe de votre NinjaTrader Account Dashboard ; ajoutez Tradovate dans Connections > Configure"],
      ["Aucune option Tradovate n'apparaît, ou la connexion ne se crée pas","Ancienne version 8.0.x incapable de se connecter à Tradovate","Mettez à jour vers la dernière version 8.1.x depuis la section Download du Account Dashboard"],
      ["Connexion créée mais ne se connecte jamais","Live a été choisi au lieu de Simulation","Recréez la connexion et sélectionnez Simulation comme type de compte"],
      ["Les identifiants semblent corrects mais « logon failed » persiste","Espace/caractère parasite, ou horloge système décalée","Retapez les identifiants à la main ; synchronisez l'horloge de Windows et réessayez"],
      ["Une seconde connexion se comporte mal à côté des données NinjaTrader","Le mode Multi-provider est désactivé","Activez Multi-provider dans Tools > Options > General, puis redémarrez"],
      ["Tout est en ordre et la connexion échoue quand même","Problème propre au compte sur la connexion","Envoyez par e-mail les fichiers de journal et de trace à NinjaTrader Platform Technical Support"],
    ] },
    { type: "heading",text: "Fini le jonglage entre les connexions de bureau avec PickMyTrade" },
    { type: "paragraph",html: "Si vous utilisez NinjaTrader principalement pour router des signaux TradingView vers votre compte Apex Tradovate, toute cette danse à deux connexions est une friction inutile. PickMyTrade relie vos alertes TradingView directement à Tradovate via une connexion stable : vous n'avez plus à ressaisir vos identifiants, à surveiller une session de bureau ni à resélectionner Simulation chaque fois que vous vous installez." },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Liez une fois, tradez de partout</strong> : connectez votre compte Tradovate une seule fois au lieu de connecter une plateforme de bureau sur chaque machine.",
        "<strong class='text-white'>De TradingView à Tradovate, en automatique</strong> : les alertes déclenchent vos entrées, sorties et brackets sans que vous touchiez à une fenêtre de connexion en pleine session.",
        "<strong class='text-white'>Compatible comptes prop</strong> : route correctement vers votre compte de simulation Apex, pour que les ordres arrivent là où vous le souhaitez.",
        "<strong class='text-white'>Copie multi-comptes</strong> : reproduisez une alerte sur plusieurs comptes Tradovate depuis un seul endroit, sans connexion de bureau par compte.",
      ],
    },
  ], it: [
    { type: "paragraph",html: "Ha acquistato un account Apex static, il suo nome utente e la sua password Tradovate funzionano sul sito di Tradovate e nell'app desktop di Tradovate, ma nel momento in cui li digita in NinjaTrader desktop compare <strong class='text-white'>“Incorrect username and password. Please try again.”</strong> Stesse credenziali, tre risultati diversi. Sembra un account difettoso, ma quasi mai lo è. Il vero problema è che NinjaTrader ha <em>due</em> login completamente separati, e la casella di accesso che ha davanti richiede credenziali diverse da quelle che sta inserendo. Chiarisca questo punto, usi una build attuale e aggiunga la connessione come indica la guida Tradovate di Apex, e in pochi minuti starà instradando ordini. Di seguito trova cosa succede esattamente e come risolverlo, oltre a dove si inserisce un ponte di automazione come PickMyTrade se preferisce evitare del tutto il giocoliere dei login desktop." },
    {
      type: "checklist",
      heading: "Checklist rapida per il login non riuscito di NinjaTrader con Apex",
      items: [
        "<strong class='text-white'>Acceda all'app con il suo account NinjaTrader.</strong> L'accesso alla piattaforma desktop richiede l'e-mail e la password del suo NinjaTrader Account Dashboard, non il login Tradovate/Apex.",
        "<strong class='text-white'>Aggiorni all'ultima build 8.1.x.</strong> NinjaTrader 8.0.x non può collegarsi a Tradovate in alcun modo; scarichi la release attuale (8.1.4.1 o successiva) dalla sezione Download dell'Account Dashboard.",
        "<strong class='text-white'>Inserisca le credenziali Tradovate in Connections &gt; Configure.</strong> Il nome utente e la password Tradovate rilasciati da Apex appartengono alla connessione, aggiunta all'interno del Control Center, non alla schermata di accesso principale dell'app.",
        "<strong class='text-white'>Scelga Simulation, non Live.</strong> Gli account Apex funzionano in modalità simulazione; selezioni Simulation se NinjaTrader lo chiede.",
        "<strong class='text-white'>Elimini gli spazi di troppo.</strong> Nessuno spazio iniziale o finale nel nome utente o nella password e nessun carattere aggiuntivo dovuto a copia e incolla.",
        "<strong class='text-white'>Ancora bloccato?</strong> Sincronizzi l'orologio di Windows, poi invii i file di log e trace al supporto NinjaTrader da Control Center &gt; Help &gt; Email Support.",
      ],
    },
    { type: "heading",text: "Perché il login non riesce: due login, una confusione" },
    { type: "paragraph",html: "Ecco il punto che nessuno spiega con chiarezza. NinjaTrader le chiede di autenticarsi in due punti diversi, e ciascun punto richiede un account diverso." },
    { type: "paragraph",html: "Il <strong class='text-white'>primo login</strong> è la piattaforma stessa. Quando apre l'app desktop di NinjaTrader, questa la accede al Control Center con il suo <strong class='text-white'>account NinjaTrader</strong>, l'e-mail e la password create sul NinjaTrader Account Dashboard quando ha configurato la piattaforma per la prima volta. Da questo login dipende tutto il resto." },
    { type: "paragraph",html: "Il <strong class='text-white'>secondo login</strong> è la connessione di trading. Una volta aperto il Control Center, aggiunge il suo broker o il feed di dati in <strong class='text-white'>Connections &gt; Configure</strong>, ed è lì che vanno il suo nome utente e la password Tradovate di Apex. Questi due insiemi di credenziali appartengono a sistemi del tutto separati. Il login Tradovate serve solo a configurare la connessione; non è ciò che sblocca l'app." },
    { type: "paragraph",html: "Quindi, quando incolla il suo nome utente Apex Tradovate nella richiesta di accesso dell'app e compare “Incorrect username and password”, l'app non sbaglia. Le ha fornito credenziali di un sistema che in quel punto non controlla. È lo stesso motivo per cui quelle credenziali passano senza problemi sul sito di Tradovate: quel sito è Tradovate, quindi naturalmente funzionano. La porta d'ingresso di NinjaTrader è un'altra porta." },
    { type: "paragraph",html: "Un'altra cosa che confonde molti: la parola <strong class='text-white'>“static”</strong>. Apex offre account a drawdown statico accanto a quelli a drawdown mobile. “Static” descrive solo come viene calcolato il suo limite di drawdown: un valore fisso che non segue il saldo. Cambia le sue regole di rischio, non il suo login. I passaggi di connessione sono identici sia che il suo account Apex sia static sia trailing, quindi non cerchi un'impostazione speciale per “account static”. Non esiste." },
    { type: "heading",text: "Cause principali del login non riuscito di NinjaTrader con Apex" },
    { type: "heading",text: "1. Sta digitando le credenziali Tradovate nella casella sbagliata" },
    { type: "paragraph",html: "È la causa numero uno. L'accesso principale dell'app richiede il login del suo account NinjaTrader. Il suo login Tradovate/Apex funziona solo all'interno di <strong class='text-white'>Connections &gt; Configure</strong>. Se li scambia, ottiene “Incorrect username and password” ogni volta, anche se i dati sono perfettamente validi." },
    { type: "heading",text: "2. Sta usando una vecchia build NinjaTrader 8.0.x" },
    { type: "paragraph",html: "Le release NinjaTrader 8.0.x sono precedenti al supporto Tradovate e semplicemente non possono stabilire una connessione Tradovate. Se ha installato la piattaforma tempo fa e non l'ha mai aggiornata, nessuna combinazione di credenziali corrette collegherà un account Tradovate finché non passa a una build 8.1.x attuale." },
    { type: "heading",text: "3. È stato selezionato Live invece di Simulation" },
    { type: "paragraph",html: "Gli account Apex operano in modalità simulazione. Se NinjaTrader le ha presentato una scelta tra Live e Simulation durante l'aggiunta della connessione e lei ha scelto Live, la connessione viene creata ma non effettua mai l'accesso. Sembra un errore di credenziali; in realtà è il tipo di account sbagliato." },
    { type: "heading",text: "4. Uno spazio di troppo o un carattere copiato" },
    { type: "paragraph",html: "Copiando e incollando il nome utente o la password da un'e-mail o da un PDF possono finire con uno spazio iniziale, uno spazio finale o un carattere invisibile. NinjaTrader lo considera parte della credenziale e l'accesso fallisce. Ridigiti a mano entrambi i campi se ha dubbi." },
    { type: "heading",text: "5. La modalità Multi-provider non è abilitata" },
    { type: "paragraph",html: "Per eseguire una connessione Tradovate insieme ai dati propri di NinjaTrader, la piattaforma richiede in genere che la modalità <strong class='text-white'>Multi-provider</strong> sia attiva. Se è disattivata, l'aggiunta della connessione può comportarsi in modo anomalo senza avvisi. È un'impostazione rapida e un riavvio." },
    { type: "heading",text: "Come risolvere: passo dopo passo" },
    {
      type: "steps",
      items: [
        { title: "Aggiorni NinjaTrader all'ultima build", html: "Acceda al suo <strong class='text-white'>NinjaTrader Account Dashboard</strong> da un browser, apra la sezione <strong class='text-white'>Download</strong> e scarichi la build desktop più recente (8.1.4.1 o successiva a metà 2026). Chiuda prima qualsiasi copia di NinjaTrader in esecuzione, poi avvii il programma di installazione. Aggiornando in questo modo, le sue configurazioni personalizzate, i workspace e i componenti aggiuntivi restano intatti; la sua configurazione non viene cancellata." },
        { title: "Acceda all'app desktop con il suo account NinjaTrader", html: "Apra il Control Center di NinjaTrader appena aggiornato. Quando le chiede di accedere, usi l'e-mail e la password del suo <strong class='text-white'>account NinjaTrader</strong>, le stesse che usa sull'Account Dashboard. Non usi qui il suo login Tradovate/Apex. Se non ricorda la password di NinjaTrader, la reimposti dall'Account Dashboard, non da Tradovate." },
        { title: "Attivi la modalità Multi-provider", html: "Nel Control Center, vada su <strong class='text-white'>Tools &gt; Options &gt; General</strong> e abiliti l'opzione <strong class='text-white'>Multi-provider</strong>, poi clicchi su <strong class='text-white'>Apply</strong> e <strong class='text-white'>OK</strong>. Riavvii completamente NinjaTrader affinché la modifica abbia effetto prima di aggiungere la connessione." },
        { title: "Aggiunga la connessione Tradovate con le sue credenziali Apex", html: "Ora arriva la parte in cui il suo login Tradovate va davvero: <ol><li>Acceda alla sua dashboard membri di Apex e apra la sezione Tradovate per confermare il suo <strong class='text-white'>nome utente e la password Tradovate</strong>. Se non ha mai effettuato l'accesso direttamente a Tradovate, acceda una volta alla pagina di benvenuto di Tradovate da un browser desktop e accetti gli eventuali accordi del primo accesso.</li><li>Tornato in NinjaTrader, vada su <strong class='text-white'>Connections &gt; Configure</strong>.</li><li>Dall'elenco <strong class='text-white'>Available</strong>, selezioni il provider di connessione per Tradovate e lo aggiunga. (L'etichetta esatta mostrata dalla sua build per un account ospitato su Tradovate può variare tra le release; se non è sicuro di quale voce scegliere, segua la guida attuale alla connessione Apex Tradovate x NinjaTrader, che indica la selezione esatta per la sua versione.)</li><li>Inserisca il suo <strong class='text-white'>nome utente e la password Tradovate</strong> di Apex. Li digiti a mano in modo che non si insinui alcuno spazio di troppo.</li><li>Se compare una scelta <strong class='text-white'>Live vs Simulation</strong>, selezioni <strong class='text-white'>Simulation</strong>. Gli account Apex sono account di simulazione.</li><li>Salvi la connessione, poi si colleghi ad essa da <strong class='text-white'>Connections</strong> nel Control Center.</li></ol>" },
        { title: "Se continua a comparire logon failed", html: "<ol><li>Ricontrolli le credenziali carattere per carattere. Cancelli entrambi i campi e li ridigiti; non li incolli.</li><li>Sincronizzi l'orologio di Windows: <strong class='text-white'>Settings &gt; Time &amp; language &gt; Date &amp; time</strong>, attivi <strong class='text-white'>Set time automatically</strong>, poi clicchi su <strong class='text-white'>Sync now</strong>. Un orologio sfasato rompe l'handshake e viene letto come un errore di accesso.</li><li>Verifichi di usare davvero una build 8.1.x attuale (controlli <strong class='text-white'>Help &gt; About</strong>) e non un'installazione 8.0.x il cui collegamento si è semplicemente aggiornato.</li><li>Ancora nulla? Invii i suoi log a NinjaTrader: <strong class='text-white'>Control Center &gt; Help &gt; Email Support</strong>, imposti come destinatario Platform Technical Support e si assicuri che la casella <strong class='text-white'>Log and Trace files</strong> sia spuntata. I problemi di connessione specifici dell'account si risolvono meglio direttamente con il loro supporto, senza tirare a indovinare.</li></ol>" },
      ],
    },
    { type: "heading",text: "Tabella di risoluzione dei problemi" },
    { type: "table", headers: ["Sintomo","Cosa non va davvero","Soluzione"], rows: [
      ["“Incorrect username and password” nell'accesso dell'app NinjaTrader","Ha inserito credenziali Tradovate/Apex dove NinjaTrader richiede il login del suo account NinjaTrader","Acceda all'app con l'e-mail/password del suo NinjaTrader Account Dashboard; aggiunga Tradovate in Connections > Configure"],
      ["Non compare alcuna opzione Tradovate, oppure la connessione non si crea","Vecchia build 8.0.x che non può collegarsi a Tradovate","Aggiorni all'ultima build 8.1.x dalla sezione Download dell'Account Dashboard"],
      ["Connessione creata ma non effettua mai l'accesso","È stato scelto Live invece di Simulation","Ricrei la connessione e selezioni Simulation come tipo di account"],
      ["Le credenziali sembrano corrette ma continua “logon failed”","Spazio/carattere di troppo, oppure orologio di sistema sfasato","Ridigiti le credenziali a mano; sincronizzi l'orologio di Windows e riprovi"],
      ["Una seconda connessione si comporta in modo anomalo accanto ai dati NinjaTrader","La modalità Multi-provider è disattivata","Abiliti Multi-provider in Tools > Options > General, poi riavvii"],
      ["Tutto risulta a posto e non si collega comunque","Problema specifico dell'account sulla connessione","Invii via e-mail i file di log e trace a NinjaTrader Platform Technical Support"],
    ] },
    { type: "heading",text: "Basta con il giocoliere dei login desktop con PickMyTrade" },
    { type: "paragraph",html: "Se usa NinjaTrader principalmente per instradare segnali di TradingView verso il suo account Apex Tradovate, tutta la danza dei due login è un attrito inutile. PickMyTrade collega i suoi alert di TradingView direttamente a Tradovate tramite una connessione stabile, così non deve reinserire le credenziali, sorvegliare una sessione desktop o riselezionare Simulation ogni volta che si siede a operare." },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Colleghi una volta, operi da ovunque</strong>: connetta il suo account Tradovate una sola volta invece di accedere a una piattaforma desktop su ogni macchina.",
        "<strong class='text-white'>Da TradingView a Tradovate, in automatico</strong>: gli alert attivano i suoi ingressi, le uscite e i bracket senza che debba toccare una casella di accesso a sessione in corso.",
        "<strong class='text-white'>Consapevole degli account prop</strong>: instrada correttamente verso il suo account di simulazione Apex, così gli ordini arrivano dove intende.",
        "<strong class='text-white'>Copia multi-account</strong>: replichi un alert su più account Tradovate da un unico punto, senza login desktop per ciascun account.",
      ],
    },
  ] },
  ctaHeading: { en: "Skip the Desktop-Login Juggling", de: "Schluss mit dem Desktop-Login-Jonglieren", es: "Olvídese del malabarismo con los inicios de sesión de escritorio", fr: "Fini le jonglage entre les connexions de bureau", it: "Basta con il giocoliere dei login desktop" },
  ctaText: { en: "PickMyTrade bridges your TradingView alerts straight to your Apex Tradovate account, so you're not re-entering credentials or babysitting a NinjaTrader session.", de: "PickMyTrade verbindet Ihre TradingView-Alerts direkt mit Ihrem Apex-Tradovate-Konto, sodass Sie keine Zugangsdaten erneut eingeben oder eine NinjaTrader-Sitzung beaufsichtigen müssen.", es: "PickMyTrade conecta sus alertas de TradingView directamente con su cuenta de Apex Tradovate, de modo que no tiene que volver a introducir credenciales ni vigilar una sesión de NinjaTrader.", fr: "PickMyTrade relie directement vos alertes TradingView à votre compte Apex Tradovate : vous n'avez plus à ressaisir vos identifiants ni à surveiller une session NinjaTrader.", it: "PickMyTrade collega i suoi alert di TradingView direttamente al suo account Apex Tradovate, così non deve reinserire le credenziali né sorvegliare una sessione NinjaTrader." },
  ctaButtonText: { en: "Start Your Free 7-Day Trial", de: "Starten Sie Ihre kostenlose 7-Tage-Testphase", es: "Comience su prueba gratuita de 7 días", fr: "Commencez votre essai gratuit de 7 jours", it: "Inizi la prova gratuita di 7 giorni" },
  ctaUrl: "https://app.pickmytrade.trade/?register=true&utm_source=content&utm_medium=debugging",
  faqHeading: { en: "Frequently Asked Questions", de: "Häufig gestellte Fragen", es: "Preguntas frecuentes", fr: "Questions fréquentes", it: "Domande frequenti" },
  faqs: { en: [
    { q: "Why does my Apex Tradovate login work on the website but fail in NinjaTrader desktop?", a: "Because they use two different credential sets. The NinjaTrader desktop app signs you in with your NinjaTrader account (Account Dashboard) email and password, while your Tradovate username and password from Apex only work as a broker connection inside the platform. Typing the Tradovate login into the NinjaTrader app's sign-in box returns “Incorrect username and password” even though those same details work on the Tradovate site." },
    { q: "Which username and password do I use to sign into the NinjaTrader desktop platform?", a: "Use your NinjaTrader account credentials, the email and password you created for the NinjaTrader Account Dashboard when you set up the platform. That login opens the Control Center. Your Tradovate/Apex credentials are entered separately under Connections > Configure to add the trading connection, not at the app's main sign-in." },
    { q: "Do I need to update NinjaTrader to connect my Tradovate account?", a: "Yes. NinjaTrader 8.0.x builds cannot connect to Tradovate at all, so you need a recent 8.1.x build (8.1.4.1 or later as of mid-2026). Update from the Download section of your NinjaTrader Account Dashboard, close any running copy first, then reinstall. Updating keeps your custom settings and add-ons." },
    { q: "Should I pick Live or Simulation for my Apex account in NinjaTrader?", a: "Pick Simulation. Apex evaluation and funded accounts on Tradovate run in simulation mode, so if NinjaTrader shows a Live vs Simulation choice while you add the connection, choose Simulation. Selecting Live is a common reason the connection is created but never logs on." },
    { q: "Does the “static” account type change how I log in?", a: "No. “Static” refers to how the drawdown is calculated on your Apex account (a fixed drawdown rather than a trailing one). It's a risk-rule difference, not a login difference. The NinjaTrader connection steps and credentials are identical for static and trailing accounts." },
    { q: "I entered the right credentials but still get “logon failed.” What now?", a: "Check for a stray space at the start or end of the username or password, confirm you're on a current 8.1.x build, and sync your Windows clock (Settings > Time & language > Date & time > Set time automatically > Sync now). If it still fails, send your log and trace files to NinjaTrader support from Control Center > Help > Email Support." },
  ], de: [
    { q: "Warum funktioniert mein Apex-Tradovate-Login auf der Website, schlägt aber in NinjaTrader Desktop fehl?", a: "Weil zwei verschiedene Zugangsdaten im Spiel sind. Die NinjaTrader-Desktop-App meldet Sie mit der E-Mail-Adresse und dem Passwort Ihres NinjaTrader-Kontos (Account Dashboard) an, während Ihr Tradovate-Benutzername und -Passwort von Apex nur als Broker-Verbindung innerhalb der Plattform funktionieren. Geben Sie den Tradovate-Login in das Anmeldefeld der NinjaTrader-App ein, erhalten Sie „Incorrect username and password“, obwohl dieselben Daten auf der Tradovate-Seite funktionieren." },
    { q: "Welchen Benutzernamen und welches Passwort verwende ich zur Anmeldung an der NinjaTrader-Desktop-Plattform?", a: "Verwenden Sie Ihre NinjaTrader-Kontodaten, also die E-Mail-Adresse und das Passwort, die Sie beim Einrichten der Plattform für das NinjaTrader Account Dashboard erstellt haben. Mit diesem Login öffnet sich das Control Center. Ihre Tradovate-/Apex-Zugangsdaten geben Sie separat unter Connections > Configure ein, um die Handelsverbindung hinzuzufügen, nicht bei der Hauptanmeldung der App." },
    { q: "Muss ich NinjaTrader aktualisieren, um mein Tradovate-Konto zu verbinden?", a: "Ja. NinjaTrader-8.0.x-Builds können sich überhaupt nicht mit Tradovate verbinden, Sie benötigen also einen aktuellen 8.1.x-Build (8.1.4.1 oder neuer, Stand Mitte 2026). Aktualisieren Sie über den Bereich Download Ihres NinjaTrader Account Dashboards, schließen Sie zuvor jede laufende Instanz und installieren Sie dann neu. Ihre benutzerdefinierten Einstellungen und Add-ons bleiben beim Update erhalten." },
    { q: "Soll ich für mein Apex-Konto in NinjaTrader Live oder Simulation wählen?", a: "Wählen Sie Simulation. Apex-Evaluierungs- und Funded-Konten bei Tradovate laufen im Simulationsmodus. Zeigt NinjaTrader beim Hinzufügen der Verbindung eine Auswahl zwischen Live und Simulation an, wählen Sie daher Simulation. Die Auswahl von Live ist ein häufiger Grund dafür, dass die Verbindung zwar angelegt wird, sich aber nie anmeldet." },
    { q: "Ändert der Kontotyp „Static“ etwas an meiner Anmeldung?", a: "Nein. „Static“ bezeichnet, wie der Drawdown Ihres Apex-Kontos berechnet wird (ein fester Drawdown statt eines nachlaufenden). Das ist ein Unterschied bei den Risikoregeln, nicht beim Login. Die Verbindungsschritte und Zugangsdaten in NinjaTrader sind für Static- und Trailing-Konten identisch." },
    { q: "Ich habe die richtigen Zugangsdaten eingegeben, erhalte aber weiterhin „logon failed“. Was nun?", a: "Prüfen Sie, ob am Anfang oder Ende von Benutzername oder Passwort ein versehentliches Leerzeichen steht, vergewissern Sie sich, dass Sie einen aktuellen 8.1.x-Build verwenden, und synchronisieren Sie Ihre Windows-Uhr (Settings > Time & language > Date & time > Set time automatically > Sync now). Schlägt es weiterhin fehl, senden Sie Ihre Log- und Trace-Dateien über Control Center > Help > Email Support an den NinjaTrader-Support." },
  ], es: [
    { q: "¿Por qué mi inicio de sesión de Apex Tradovate funciona en el sitio web pero falla en NinjaTrader de escritorio?", a: "Porque se usan dos conjuntos de credenciales distintos. La app de escritorio de NinjaTrader le inicia sesión con el correo electrónico y la contraseña de su cuenta de NinjaTrader (Account Dashboard), mientras que su usuario y contraseña de Tradovate de Apex solo funcionan como conexión de bróker dentro de la plataforma. Si escribe el inicio de sesión de Tradovate en el cuadro de acceso de la app de NinjaTrader, obtendrá “Incorrect username and password” aunque esos mismos datos funcionen en el sitio de Tradovate." },
    { q: "¿Qué usuario y contraseña uso para iniciar sesión en la plataforma de escritorio de NinjaTrader?", a: "Use las credenciales de su cuenta de NinjaTrader, es decir, el correo electrónico y la contraseña que creó para el NinjaTrader Account Dashboard al configurar la plataforma. Ese inicio de sesión abre el Control Center. Sus credenciales de Tradovate/Apex se introducen por separado en Connections > Configure para añadir la conexión de trading, no en el acceso principal de la app." },
    { q: "¿Necesito actualizar NinjaTrader para conectar mi cuenta de Tradovate?", a: "Sí. Las versiones 8.0.x de NinjaTrader no pueden conectarse a Tradovate en absoluto, por lo que necesita una versión 8.1.x reciente (8.1.4.1 o posterior a mediados de 2026). Actualice desde la sección Download de su NinjaTrader Account Dashboard, cierre antes cualquier copia en ejecución y vuelva a instalar. Al actualizar se conservan sus ajustes personalizados y complementos." },
    { q: "¿Debo elegir Live o Simulation para mi cuenta de Apex en NinjaTrader?", a: "Elija Simulation. Las cuentas de evaluación y financiadas de Apex en Tradovate funcionan en modo de simulación, así que, si NinjaTrader le muestra una opción entre Live y Simulation al añadir la conexión, elija Simulation. Seleccionar Live es un motivo habitual por el que la conexión se crea pero nunca inicia sesión." },
    { q: "¿Cambia el tipo de cuenta “static” la forma de iniciar sesión?", a: "No. “Static” se refiere a cómo se calcula el drawdown de su cuenta de Apex (un drawdown fijo en lugar de uno móvil). Es una diferencia de reglas de riesgo, no de inicio de sesión. Los pasos de conexión y las credenciales de NinjaTrader son idénticos para cuentas static y trailing." },
    { q: "Introduje las credenciales correctas pero sigo viendo “logon failed”. ¿Qué hago?", a: "Compruebe que no haya un espacio sobrante al principio o al final del usuario o la contraseña, confirme que usa una versión 8.1.x actual y sincronice el reloj de Windows (Settings > Time & language > Date & time > Set time automatically > Sync now). Si sigue fallando, envíe sus archivos de registro y traza al soporte de NinjaTrader desde Control Center > Help > Email Support." },
  ], fr: [
    { q: "Pourquoi ma connexion Apex Tradovate fonctionne sur le site web mais échoue dans NinjaTrader desktop ?", a: "Parce que deux jeux d'identifiants distincts sont en jeu. L'application NinjaTrader desktop vous connecte avec l'e-mail et le mot de passe de votre compte NinjaTrader (Account Dashboard), tandis que votre identifiant et votre mot de passe Tradovate d'Apex ne servent que de connexion courtier à l'intérieur de la plateforme. Saisir l'identifiant Tradovate dans la fenêtre de connexion de NinjaTrader renvoie « Incorrect username and password », alors que ces mêmes données fonctionnent sur le site de Tradovate." },
    { q: "Quel identifiant et quel mot de passe dois-je utiliser pour me connecter à la plateforme NinjaTrader desktop ?", a: "Utilisez les identifiants de votre compte NinjaTrader, c'est-à-dire l'e-mail et le mot de passe que vous avez créés pour le NinjaTrader Account Dashboard lors de la configuration de la plateforme. Cette connexion ouvre le Control Center. Vos identifiants Tradovate/Apex se saisissent séparément dans Connections > Configure pour ajouter la connexion de trading, et non sur l'écran de connexion principal de l'application." },
    { q: "Dois-je mettre à jour NinjaTrader pour connecter mon compte Tradovate ?", a: "Oui. Les versions 8.0.x de NinjaTrader ne peuvent pas du tout se connecter à Tradovate ; il vous faut donc une version 8.1.x récente (8.1.4.1 ou ultérieure à la mi-2026). Mettez à jour depuis la section Download de votre NinjaTrader Account Dashboard, fermez d'abord toute instance en cours, puis réinstallez. La mise à jour conserve vos réglages personnalisés et vos modules complémentaires." },
    { q: "Dois-je choisir Live ou Simulation pour mon compte Apex dans NinjaTrader ?", a: "Choisissez Simulation. Les comptes d'évaluation et financés d'Apex sur Tradovate fonctionnent en mode simulation ; si NinjaTrader propose un choix entre Live et Simulation lors de l'ajout de la connexion, sélectionnez donc Simulation. Choisir Live est une cause fréquente de connexion créée mais qui ne se connecte jamais." },
    { q: "Le type de compte « static » change-t-il ma façon de me connecter ?", a: "Non. « Static » désigne la manière dont le drawdown de votre compte Apex est calculé (un drawdown fixe plutôt que glissant). C'est une différence de règles de risque, pas de connexion. Les étapes de connexion et les identifiants NinjaTrader sont identiques pour les comptes static et trailing." },
    { q: "J'ai saisi les bons identifiants mais j'obtiens toujours « logon failed ». Que faire ?", a: "Vérifiez qu'il n'y a pas d'espace parasite au début ou à la fin de l'identifiant ou du mot de passe, assurez-vous d'utiliser une version 8.1.x actuelle et synchronisez l'horloge de Windows (Settings > Time & language > Date & time > Set time automatically > Sync now). Si l'échec persiste, envoyez vos fichiers de journal et de trace au support NinjaTrader depuis Control Center > Help > Email Support." },
  ], it: [
    { q: "Perché il mio login Apex Tradovate funziona sul sito web ma non in NinjaTrader desktop?", a: "Perché entrano in gioco due insiemi di credenziali diversi. L'app desktop di NinjaTrader la accede con l'e-mail e la password del suo account NinjaTrader (Account Dashboard), mentre il suo nome utente e la password Tradovate di Apex funzionano solo come connessione broker all'interno della piattaforma. Digitando il login Tradovate nella casella di accesso dell'app NinjaTrader si ottiene “Incorrect username and password”, anche se gli stessi dati funzionano sul sito di Tradovate." },
    { q: "Quale nome utente e password uso per accedere alla piattaforma desktop NinjaTrader?", a: "Usi le credenziali del suo account NinjaTrader, cioè l'e-mail e la password create per il NinjaTrader Account Dashboard quando ha configurato la piattaforma. Questo login apre il Control Center. Le sue credenziali Tradovate/Apex vanno inserite separatamente in Connections > Configure per aggiungere la connessione di trading, non nell'accesso principale dell'app." },
    { q: "Devo aggiornare NinjaTrader per collegare il mio account Tradovate?", a: "Sì. Le build NinjaTrader 8.0.x non possono collegarsi a Tradovate in alcun modo, quindi serve una build 8.1.x recente (8.1.4.1 o successiva a metà 2026). Aggiorni dalla sezione Download del suo NinjaTrader Account Dashboard, chiuda prima qualsiasi copia in esecuzione e poi reinstalli. L'aggiornamento mantiene le sue impostazioni personalizzate e i componenti aggiuntivi." },
    { q: "Devo scegliere Live o Simulation per il mio account Apex in NinjaTrader?", a: "Scelga Simulation. Gli account di valutazione e finanziati di Apex su Tradovate funzionano in modalità simulazione, quindi, se NinjaTrader mostra una scelta tra Live e Simulation durante l'aggiunta della connessione, selezioni Simulation. Selezionare Live è un motivo frequente per cui la connessione viene creata ma non effettua mai l'accesso." },
    { q: "Il tipo di account “static” cambia il modo in cui effettuo l'accesso?", a: "No. “Static” si riferisce al modo in cui viene calcolato il drawdown del suo account Apex (un drawdown fisso anziché mobile). È una differenza nelle regole di rischio, non nel login. I passaggi di connessione e le credenziali di NinjaTrader sono identici per gli account static e trailing." },
    { q: "Ho inserito le credenziali giuste ma ottengo ancora “logon failed”. Cosa faccio?", a: "Controlli che non ci sia uno spazio di troppo all'inizio o alla fine del nome utente o della password, verifichi di usare una build 8.1.x attuale e sincronizzi l'orologio di Windows (Settings > Time & language > Date & time > Set time automatically > Sync now). Se continua a fallire, invii i file di log e trace al supporto NinjaTrader da Control Center > Help > Email Support." },
  ] },
