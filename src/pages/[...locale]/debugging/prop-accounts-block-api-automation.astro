---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "prop-accounts-block-api-automation";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/debugging/${SLUG}`;

const META_TITLE = "Tradovate Prop Accounts Block Direct API Bots";
const META_DESCRIPTION =
  "Tradovate prop accounts block direct API bots. Learn why funded accounts can't use personal API keys and how to automate within your firm's rules.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate API", de: "Tradovate API", es: "Tradovate API", fr: "Tradovate API", it: "Tradovate API" },
  h1: { en: META_TITLE, de: "Tradovate-Prop-Konten blockieren direkte API-Bots", es: "Las cuentas prop de Tradovate bloquean los bots de API directa", fr: "Les comptes prop Tradovate bloquent les bots API directs", it: "I conti prop Tradovate bloccano i bot API diretti" },
  dek: { en: "You generated a Tradovate API key, called /account/list, and your funded evaluation account is nowhere in the response. This isn't a bug in your script, here's why the door is closed and which compliant paths still let you automate.", de: "Sie haben einen Tradovate-API-Schlüssel erzeugt, /account/list aufgerufen, und Ihr finanziertes Evaluierungskonto fehlt in der Antwort. Das ist kein Fehler in Ihrem Skript. Hier erfahren Sie, warum die Tür verschlossen ist und welche regelkonformen Wege zur Automatisierung bleiben.", es: "Generó una clave de API de Tradovate, llamó a /account/list y su cuenta de evaluación financiada no aparece en la respuesta. No es un error de su script. Aquí le explicamos por qué la puerta está cerrada y qué vías conformes siguen permitiendo automatizar.", fr: "Vous avez généré une clé API Tradovate, appelé /account/list, et votre compte d'évaluation financé est introuvable dans la réponse. Ce n'est pas un bug de votre script. Voici pourquoi la porte est fermée et quelles voies conformes permettent encore d'automatiser.", it: "Ha generato una chiave API Tradovate, ha chiamato /account/list e il suo conto di valutazione finanziato non compare nella risposta. Non è un bug del suo script. Ecco perché la porta è chiusa e quali percorsi conformi permettono ancora di automatizzare." },
  readTime: { en: "8 min read", de: "8 Min. Lesezeit", es: "Lectura de 8 min", fr: "Lecture : 8 min", it: "Lettura di 8 min" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "You spun up a bot, generated a Tradovate API key, called <code>/account/list</code>, and your funded evaluation account is nowhere in the response. Or you tried to route an order and got an access-denied rejection, even though the exact same code runs fine on your personal demo. This isn't a bug in your script. Tradovate prop firm and evaluation accounts do not allow direct API access, and a personal Tradovate API key can't see or trade the accounts your prop firm manages. Worse, wiring an unauthorized bot into a funded account can breach your firm's terms and get the account failed. So before you burn another evaluation fee chasing phantom auth errors, let's be clear about why the door is closed, and which compliant paths still let you automate." },
    {
      type: "checklist",
      heading: "Quick Checklist for Prop Account API Automation",
      items: [
        "<strong class='text-white'>Confirm the account is prop/evaluation, not personal.</strong> Firm-managed accounts (Apex, the Topstep family, MyFundedFutures, Tradeify, and the rest) are provisioned under the firm's master and are excluded from personal API keys.",
        "<strong class='text-white'>Read your firm's automation policy first.</strong> Rules vary by firm and even by phase, evaluation versus live funded, so check your firm's current terms before you automate anything.",
        "<strong class='text-white'>Don't expect a personal API key to reach a prop account.</strong> It authenticates only to accounts under your own Tradovate username, not the firm's.",
        "<strong class='text-white'>Ask the firm, not Tradovate.</strong> Tradovate can't grant API rights on an account it doesn't own; only the prop firm can enable or approve automation.",
        "<strong class='text-white'>Use an authorized, non-API bridge.</strong> Vendor tools route your TradingView alerts to the firm's platform without needing an API key on the account itself.",
        "<strong class='text-white'>If you truly need API access, pick a firm or platform that offers it.</strong> Some firms (like TopstepX, powered by ProjectX) sell an API add-on, but with strict conditions.",
      ],
    },
    { type: "heading", text: "What “Prop Accounts Block Direct API Bots” Means" },
    { type: "paragraph", html: "A Tradovate API key is issued at the username level. When you log in to your own Tradovate account, enable the API Access add-on, and generate credentials, that key can authenticate and route orders for the accounts sitting under <em>your</em> username. A prop firm evaluation or funded account is a different animal: it's provisioned and controlled by the firm under the firm's master relationship with Tradovate, and you log in with firm-issued credentials. Even though these evaluation accounts are technically simulated (demo) accounts, they're still walled off from personal API access, the account simply won't show up in your <code>/account/list</code> response, so there's nothing for your bot to trade." },
    { type: "paragraph", html: "The block is both technical and contractual. On the technical side, your personal key has no entitlement to the firm's accounts, so calls come back with an empty account list or an access-denied error. On the contractual side, most prop firms' terms of use dictate <em>how</em>, and whether, you're allowed to automate on their capital. A bot that would be perfectly legal on your own live Tradovate account can be a straight-up rules violation on a funded account, and firms do enforce it." },
    { type: "paragraph", html: "The rule here is blunt: prop accounts do not allow direct API access, and there's no known workaround for doing anything API-related with a prop firm account. The right move is to take the request to your prop firm, not to Tradovate, because Tradovate can't hand out API rights on accounts it doesn't own." },
    { type: "heading", text: "Top Causes of Blocked Prop-Account Automation" },
    { type: "heading", text: "1. The account is firm-managed, not yours" },
    { type: "paragraph", html: "This is the big one. The evaluation or funded account belongs to the prop firm, and your personal Tradovate credentials, plus any API key derived from them, have no relationship to it. That's why the account never appears when your bot enumerates accounts, and why swapping keys or regenerating a secret changes exactly nothing." },
    { type: "heading", text: "2. Firm terms prohibit (or restrict) automation" },
    { type: "paragraph", html: "Even where a technical path exists, the firm's rulebook may forbid unattended bots, limit them to actively-monitored operation, or ban them outright during certain phases. Automation policies vary by firm and by account phase, a bot that's fine in the evaluation may be disallowed on the live funded account. Confirm your firm's current, published rules instead of assuming." },
    { type: "heading", text: "3. You're pointing a personal-account setup at a prop login" },
    { type: "paragraph", html: "A common misfire: code that works on your own demo or live Tradovate account fails the moment you feed it prop-firm credentials. The <code>deviceId</code>, entitlements, and account IDs your personal key relies on don't carry over. It looks like an auth or “access is denied” failure, but the real cause is that the credentials aren't entitled to route via API at all." },
    { type: "heading", text: "4. Expecting Tradovate to enable it" },
    { type: "paragraph", html: "Plenty of traders open a support ticket asking Tradovate to “turn on API access” for a funded account. Tradovate's position is that prop and evaluation accounts fall under the firm's provider relationship, so the firm, not Tradovate, controls what's enabled on them. Escalating to the wrong party just costs you time." },
    { type: "heading", text: "How to Fix Blocked Prop-Account Automation: Step-by-Step" },
    { type: "heading", text: "Verifying whether your account can use the API at all" },
    {
      type: "steps",
      items: [
        { title: "Log in and note the account type", html: "Log in with the exact credentials your prop firm issued and note the account type, evaluation/simulated, or live personal." },
        { title: "Call /account/list from your own key", html: "From your own Tradovate account (not the firm's), generate an API key and call <code>/account/list</code>. If the prop account is absent, you've confirmed it isn't reachable via your personal API." },
        { title: "Don't retry different keys", html: "Do <strong class='text-white'>not</strong> keep retrying different keys or hammering the auth endpoint. Repeated failed calls can trip Tradovate's rate limits or a time penalty and lock you out temporarily." },
      ],
    },
    { type: "heading", text: "Asking the prop firm the right way" },
    {
      type: "steps",
      items: [
        { title: "Ask the firm directly", html: "Contact your firm's support and ask directly whether API automation is permitted on your account tier, and under what conditions." },
        { title: "Request the approved setup", html: "If they support it, request the specific setup, some firms provide their own platform, key, or approved vendor list rather than raw Tradovate keys." },
        { title: "Get the rules in writing", html: "Attended versus unattended operation, allowed strategy types, and any VPS or remote-server restrictions. These differ by firm, so check your firm's current rules." },
      ],
    },
    { type: "heading", text: "Choosing a firm or platform that offers API access" },
    { type: "paragraph", html: "If direct API automation is a hard requirement, pick a firm whose platform is built for it. TopstepX, for example, is its own platform (powered by ProjectX, separate from Tradovate) and sells API access as a paid add-on that lets you build automated strategies and send REST and WebSocket orders. The guardrails are strict and enforced, though: <strong class='text-white'>all trading activity must originate from your personal device</strong>, and VPS, VPN, and remote servers are prohibited under the firm's terms, running a bot on cloud infrastructure can get you suspended or removed. API orders are also final, with no review or reversal, and evaluation-phase permissions may not carry over to a live funded account. Pricing and exact rules vary and change over time, so verify the current add-on cost and policy with the firm before you commit." },
    { type: "heading", text: "Automating Tradovate prop accounts without a raw API key" },
    {
      type: "steps",
      items: [
        { title: "Use an authorized bridge", html: "Use an authorized bridge that connects your TradingView strategy alerts to the firm's Tradovate platform without needing an API key on the account itself." },
        { title: "Configure risk mapping", html: "Configure quantity, symbol, and risk mapping so alerts respect the firm's contract caps and loss limits (these vary by firm and account size)." },
        { title: "Keep the connection scoped and confirmed", html: "Keep the bridge's account link scoped to what the firm allows, and confirm the approach against your firm's automation policy first." },
      ],
    },
    { type: "heading", text: "Troubleshooting Table" },
    {
      type: "table",
      headers: ["Symptom", "Meaning", "Fix"],
      rows: [
        ["Prop account missing from <code>/account/list</code>", "Your personal API key has no entitlement to firm-managed accounts", "Don't automate via a personal key; ask the firm for an approved method"],
        ["“Access is denied” / 401 on place order", "Credentials aren't entitled to route the prop account via API", "Confirm the account type; use an authorized bridge or firm-provided API"],
        ["Bot works on demo, fails on funded login", "Personal-account entitlements and device ID don't apply to prop accounts", "Switch to a firm-approved automation path"],
        ["Firm fails/flags the account after automating", "Automation breached the firm's terms of use", "Re-read current firm rules; only automate what's explicitly allowed"],
        ["Repeated auth retries lock you out", "Rate limit or time penalty from rapid failed calls", "Stop retrying, wait out the cooldown, fix the root entitlement"],
        ["VPS-hosted bot suspended (on firms that allow API)", "Firm requires personal-device execution and bans remote servers", "Run automation locally on your own machine per the firm's rules"],
      ],
    },
    { type: "heading", text: "Prevent This with PickMyTrade" },
    { type: "paragraph", html: "PickMyTrade is an authorized Tradovate vendor, so you can automate a firm-managed account without ever handing a raw API key to a bot:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>No-API-Key Routing</strong>, links your TradingView alerts straight to your Tradovate account through an approved integration, sidestepping the personal-API-key limitation entirely.",
        "<strong class='text-white'>Qty / Symbol Validation</strong>, blocks orders that would breach position caps before they're sent, so a bad alert doesn't trip a firm rule.",
        "<strong class='text-white'>Entitlement &amp; Risk Filters</strong>, respect prop-firm limits and account state, which vary by firm and account size, so check your firm's current rules.",
        "<strong class='text-white'>Multi-Account Sync</strong>, mirrors a validated order across the accounts you're allowed to trade, without a separate key per account.",
      ],
    },
  ], de: [
    { type: "paragraph",html: "Sie haben einen Bot aufgesetzt, einen Tradovate-API-Schlüssel erzeugt, <code>/account/list</code> aufgerufen, und Ihr finanziertes Evaluierungskonto fehlt in der Antwort. Oder Sie haben versucht, eine Order zu routen, und eine Zugriff-verweigert-Ablehnung erhalten, obwohl exakt derselbe Code auf Ihrer persönlichen Demo einwandfrei läuft. Das ist kein Fehler in Ihrem Skript. Tradovate-Prop-Firmen- und Evaluierungskonten erlauben keinen direkten API-Zugriff, und ein persönlicher Tradovate-API-Schlüssel kann die Konten, die Ihre Prop-Firma verwaltet, weder sehen noch handeln. Schlimmer noch: Ein nicht autorisierter Bot an einem finanzierten Konto kann gegen die Bedingungen Ihrer Firma verstoßen und dazu führen, dass das Konto durchfällt. Bevor Sie also eine weitere Evaluierungsgebühr für Phantom-Authentifizierungsfehler verbrennen, klären wir, warum die Tür verschlossen ist und welche regelkonformen Wege zur Automatisierung bleiben." },
    {
      type: "checklist",
      heading: "Kurze Checkliste für die API-Automatisierung bei Prop-Konten",
      items: [
        "<strong class='text-white'>Bestätigen Sie, dass das Konto ein Prop-/Evaluierungskonto und kein persönliches ist.</strong> Von Firmen verwaltete Konten (Apex, die Topstep-Familie, MyFundedFutures, Tradeify und die übrigen) werden unter dem Master der Firma bereitgestellt und sind von persönlichen API-Schlüsseln ausgeschlossen.",
        "<strong class='text-white'>Lesen Sie zuerst die Automatisierungsrichtlinie Ihrer Firma.</strong> Die Regeln unterscheiden sich je nach Firma und sogar je nach Phase, Evaluierung gegenüber Live-Finanzierung. Prüfen Sie daher die aktuellen Bedingungen Ihrer Firma, bevor Sie etwas automatisieren.",
        "<strong class='text-white'>Erwarten Sie nicht, dass ein persönlicher API-Schlüssel ein Prop-Konto erreicht.</strong> Er authentifiziert sich nur für Konten unter Ihrem eigenen Tradovate-Benutzernamen, nicht unter dem der Firma.",
        "<strong class='text-white'>Fragen Sie die Firma, nicht Tradovate.</strong> Tradovate kann keine API-Rechte für ein Konto vergeben, das ihm nicht gehört; nur die Prop-Firma kann Automatisierung aktivieren oder genehmigen.",
        "<strong class='text-white'>Nutzen Sie eine autorisierte Bridge ohne API.</strong> Anbieter-Tools routen Ihre TradingView-Alerts zur Plattform der Firma, ohne dass ein API-Schlüssel am Konto selbst nötig ist.",
        "<strong class='text-white'>Wenn Sie wirklich API-Zugriff brauchen, wählen Sie eine Firma oder Plattform, die ihn anbietet.</strong> Einige Firmen (wie TopstepX, betrieben von ProjectX) verkaufen ein API-Add-on, jedoch mit strengen Auflagen.",
      ],
    },
    { type: "heading",text: "Was „Prop-Konten blockieren direkte API-Bots“ bedeutet" },
    { type: "paragraph",html: "Ein Tradovate-API-Schlüssel wird auf Benutzernamen-Ebene ausgestellt. Wenn Sie sich bei Ihrem eigenen Tradovate-Konto anmelden, das API-Access-Add-on aktivieren und Zugangsdaten erzeugen, kann dieser Schlüssel sich authentifizieren und Orders für die Konten unter <em>Ihrem</em> Benutzernamen routen. Ein Evaluierungs- oder finanziertes Konto einer Prop-Firma ist etwas völlig anderes: Es wird von der Firma unter deren Master-Beziehung zu Tradovate bereitgestellt und kontrolliert, und Sie melden sich mit von der Firma ausgestellten Zugangsdaten an. Obwohl diese Evaluierungskonten technisch simulierte (Demo-)Konten sind, sind sie vom persönlichen API-Zugriff abgeschottet, das Konto taucht in Ihrer <code>/account/list</code>-Antwort schlicht nicht auf, es gibt also nichts, was Ihr Bot handeln könnte." },
    { type: "paragraph",html: "Die Sperre ist sowohl technisch als auch vertraglich. Technisch hat Ihr persönlicher Schlüssel keine Berechtigung für die Konten der Firma, die Aufrufe liefern daher eine leere Kontoliste oder einen Zugriff-verweigert-Fehler zurück. Vertraglich legen die Nutzungsbedingungen der meisten Prop-Firmen fest, <em>wie</em> und ob Sie mit deren Kapital automatisieren dürfen. Ein Bot, der auf Ihrem eigenen Live-Tradovate-Konto völlig legal wäre, kann auf einem finanzierten Konto ein glatter Regelverstoß sein, und Firmen setzen das durch." },
    { type: "paragraph",html: "Die Regel ist unmissverständlich: Prop-Konten erlauben keinen direkten API-Zugriff, und es ist kein Workaround bekannt, um bei einem Prop-Firmen-Konto irgendetwas mit der API zu tun. Der richtige Schritt ist, die Anfrage an Ihre Prop-Firma zu richten, nicht an Tradovate, denn Tradovate kann keine API-Rechte für Konten vergeben, die ihm nicht gehören." },
    { type: "heading",text: "Die häufigsten Ursachen für blockierte Automatisierung bei Prop-Konten" },
    { type: "heading",text: "1. Das Konto wird von der Firma verwaltet, es ist nicht Ihres" },
    { type: "paragraph",html: "Das ist der große Punkt. Das Evaluierungs- oder finanzierte Konto gehört der Prop-Firma, und Ihre persönlichen Tradovate-Zugangsdaten sowie jeder daraus abgeleitete API-Schlüssel haben keinerlei Beziehung dazu. Deshalb erscheint das Konto nie, wenn Ihr Bot die Konten auflistet, und deshalb ändert das Austauschen von Schlüsseln oder das Neuerzeugen eines Secrets genau nichts." },
    { type: "heading",text: "2. Die Bedingungen der Firma verbieten (oder beschränken) Automatisierung" },
    { type: "paragraph",html: "Selbst wo ein technischer Weg existiert, kann das Regelwerk der Firma unbeaufsichtigte Bots verbieten, sie auf aktiv überwachten Betrieb beschränken oder in bestimmten Phasen ganz untersagen. Die Automatisierungsrichtlinien unterscheiden sich je nach Firma und Kontophase, ein Bot, der in der Evaluierung in Ordnung ist, kann auf dem finanzierten Live-Konto verboten sein. Prüfen Sie die aktuellen, veröffentlichten Regeln Ihrer Firma, statt Annahmen zu treffen." },
    { type: "heading",text: "3. Sie richten ein Setup für persönliche Konten auf ein Prop-Login" },
    { type: "paragraph",html: "Ein häufiger Fehlgriff: Code, der auf Ihrem eigenen Demo- oder Live-Tradovate-Konto funktioniert, scheitert in dem Moment, in dem Sie ihm die Zugangsdaten einer Prop-Firma geben. Die <code>deviceId</code>, die Berechtigungen und die Konto-IDs, auf die sich Ihr persönlicher Schlüssel stützt, übertragen sich nicht. Es sieht nach einem Authentifizierungs- oder „access is denied“-Fehler aus, aber die eigentliche Ursache ist, dass die Zugangsdaten überhaupt nicht für das API-Routing berechtigt sind." },
    { type: "heading",text: "4. Sie erwarten, dass Tradovate es aktiviert" },
    { type: "paragraph",html: "Viele Trader eröffnen ein Support-Ticket bei Tradovate und bitten darum, den „API-Zugriff“ für ein finanziertes Konto einzuschalten. Tradovates Position ist, dass Prop- und Evaluierungskonten unter die Anbieterbeziehung der Firma fallen, die Firma und nicht Tradovate also kontrolliert, was darauf aktiviert ist. Sich an die falsche Stelle zu wenden kostet Sie nur Zeit." },
    { type: "heading",text: "Blockierte Prop-Konto-Automatisierung beheben: Schritt für Schritt" },
    { type: "heading",text: "Prüfen, ob Ihr Konto die API überhaupt nutzen kann" },
    {
      type: "steps",
      items: [
        { title: "Anmelden und den Kontotyp notieren", html: "Melden Sie sich mit genau den Zugangsdaten an, die Ihre Prop-Firma ausgestellt hat, und notieren Sie den Kontotyp: Evaluierung/simuliert oder persönlich live." },
        { title: "/account/list mit Ihrem eigenen Schlüssel aufrufen", html: "Erzeugen Sie in Ihrem eigenen Tradovate-Konto (nicht dem der Firma) einen API-Schlüssel und rufen Sie <code>/account/list</code> auf. Fehlt das Prop-Konto, haben Sie bestätigt, dass es über Ihre persönliche API nicht erreichbar ist." },
        { title: "Nicht verschiedene Schlüssel durchprobieren", html: "Probieren Sie <strong class='text-white'>nicht</strong> immer wieder andere Schlüssel aus und bombardieren Sie den Auth-Endpunkt nicht. Wiederholte fehlgeschlagene Aufrufe können die Ratenlimits oder eine Zeitstrafe von Tradovate auslösen und Sie vorübergehend aussperren." },
      ],
    },
    { type: "heading",text: "Die Prop-Firma richtig fragen" },
    {
      type: "steps",
      items: [
        { title: "Direkt bei der Firma nachfragen", html: "Wenden Sie sich an den Support Ihrer Firma und fragen Sie direkt, ob API-Automatisierung für Ihre Kontostufe zulässig ist und unter welchen Bedingungen." },
        { title: "Das genehmigte Setup anfordern", html: "Wenn sie es unterstützen, fordern Sie das konkrete Setup an, manche Firmen stellen eine eigene Plattform, einen eigenen Schlüssel oder eine Liste genehmigter Anbieter bereit statt roher Tradovate-Schlüssel." },
        { title: "Die Regeln schriftlich festhalten", html: "Beaufsichtigter oder unbeaufsichtigter Betrieb, erlaubte Strategietypen und etwaige VPS- oder Remote-Server-Beschränkungen. Diese unterscheiden sich je nach Firma, prüfen Sie daher die aktuellen Regeln Ihrer Firma." },
      ],
    },
    { type: "heading",text: "Eine Firma oder Plattform mit API-Zugriff wählen" },
    { type: "paragraph",html: "Wenn direkte API-Automatisierung eine harte Anforderung ist, wählen Sie eine Firma, deren Plattform dafür gebaut ist. TopstepX ist zum Beispiel eine eigene Plattform (betrieben von ProjectX, getrennt von Tradovate) und verkauft API-Zugriff als kostenpflichtiges Add-on, mit dem Sie automatisierte Strategien bauen und REST- und WebSocket-Orders senden können. Die Leitplanken sind jedoch streng und werden durchgesetzt: <strong class='text-white'>Alle Handelsaktivitäten müssen von Ihrem persönlichen Gerät ausgehen</strong>, und VPS, VPN und Remote-Server sind nach den Bedingungen der Firma untersagt, ein Bot auf Cloud-Infrastruktur kann zu einer Sperre oder zum Ausschluss führen. API-Orders sind außerdem endgültig, ohne Prüfung oder Rückabwicklung, und Berechtigungen aus der Evaluierungsphase gelten möglicherweise nicht für ein finanziertes Live-Konto. Preise und genaue Regeln variieren und ändern sich mit der Zeit, prüfen Sie daher vor einer Entscheidung die aktuellen Add-on-Kosten und Richtlinien bei der Firma." },
    { type: "heading",text: "Tradovate-Prop-Konten ohne rohen API-Schlüssel automatisieren" },
    {
      type: "steps",
      items: [
        { title: "Eine autorisierte Bridge nutzen", html: "Nutzen Sie eine autorisierte Bridge, die Ihre TradingView-Strategie-Alerts mit der Tradovate-Plattform der Firma verbindet, ohne dass ein API-Schlüssel am Konto selbst nötig ist." },
        { title: "Risiko-Zuordnung konfigurieren", html: "Konfigurieren Sie Menge, Symbol und Risikozuordnung so, dass Alerts die Kontraktlimits und Verlustgrenzen der Firma einhalten (diese variieren je nach Firma und Kontogröße)." },
        { title: "Verbindung eng begrenzt und bestätigt halten", html: "Halten Sie die Kontoverknüpfung der Bridge auf das beschränkt, was die Firma erlaubt, und prüfen Sie den Ansatz zuerst anhand der Automatisierungsrichtlinie Ihrer Firma." },
      ],
    },
    { type: "heading",text: "Tabelle zur Fehlerbehebung" },
    { type: "table", headers: ["Symptom","Bedeutung","Lösung"], rows: [
      ["Prop-Konto fehlt in <code>/account/list</code>","Ihr persönlicher API-Schlüssel hat keine Berechtigung für von Firmen verwaltete Konten","Nicht über einen persönlichen Schlüssel automatisieren; bei der Firma nach einer genehmigten Methode fragen"],
      ["„Access is denied“ / 401 bei Place Order","Die Zugangsdaten sind nicht berechtigt, das Prop-Konto per API zu routen","Kontotyp bestätigen; autorisierte Bridge oder von der Firma bereitgestellte API nutzen"],
      ["Bot funktioniert auf Demo, scheitert beim finanzierten Login","Berechtigungen und Geräte-ID persönlicher Konten gelten nicht für Prop-Konten","Zu einem von der Firma genehmigten Automatisierungsweg wechseln"],
      ["Firma lässt das Konto durchfallen oder markiert es nach der Automatisierung","Die Automatisierung hat gegen die Nutzungsbedingungen der Firma verstoßen","Aktuelle Firmenregeln erneut lesen; nur automatisieren, was ausdrücklich erlaubt ist"],
      ["Wiederholte Auth-Versuche sperren Sie aus","Ratenlimit oder Zeitstrafe durch schnelle fehlgeschlagene Aufrufe","Wiederholungen stoppen, die Abkühlzeit abwarten, die Ursache der Berechtigung beheben"],
      ["Auf VPS gehosteter Bot gesperrt (bei Firmen, die die API erlauben)","Die Firma verlangt Ausführung auf dem persönlichen Gerät und verbietet Remote-Server","Automatisierung gemäß den Regeln der Firma lokal auf Ihrem eigenen Rechner ausführen"],
    ] },
    { type: "heading",text: "Vorbeugen mit PickMyTrade" },
    { type: "paragraph",html: "PickMyTrade ist ein autorisierter Tradovate-Anbieter, sodass Sie ein von einer Firma verwaltetes Konto automatisieren können, ohne jemals einen rohen API-Schlüssel an einen Bot zu übergeben:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Routing ohne API-Schlüssel</strong>, verknüpft Ihre TradingView-Alerts über eine genehmigte Integration direkt mit Ihrem Tradovate-Konto und umgeht die Beschränkung persönlicher API-Schlüssel vollständig.",
        "<strong class='text-white'>Mengen-/Symbolvalidierung</strong>, blockiert Orders, die Positionslimits verletzen würden, bevor sie gesendet werden, damit ein fehlerhafter Alert keine Firmenregel auslöst.",
        "<strong class='text-white'>Berechtigungs- &amp; Risikofilter</strong>, beachten die Limits der Prop-Firma und den Kontostatus, die je nach Firma und Kontogröße variieren, prüfen Sie daher die aktuellen Regeln Ihrer Firma.",
        "<strong class='text-white'>Multi-Account-Sync</strong>, spiegelt eine validierte Order auf die Konten, die Sie handeln dürfen, ohne einen separaten Schlüssel pro Konto.",
      ],
    },
  ], es: [
    { type: "paragraph",html: "Montó un bot, generó una clave de API de Tradovate, llamó a <code>/account/list</code> y su cuenta de evaluación financiada no aparece en la respuesta. O intentó enrutar una orden y recibió un rechazo de acceso denegado, aunque exactamente el mismo código funciona bien en su demo personal. No es un error de su script. Las cuentas de firma prop y de evaluación de Tradovate no permiten acceso directo a la API, y una clave de API personal de Tradovate no puede ver ni operar las cuentas que gestiona su firma prop. Peor aún, conectar un bot no autorizado a una cuenta financiada puede infringir los términos de su firma y hacerle fallar la cuenta. Así que antes de quemar otra cuota de evaluación persiguiendo errores de autenticación fantasma, dejemos claro por qué la puerta está cerrada y qué vías conformes siguen permitiendo automatizar." },
    {
      type: "checklist",
      heading: "Lista rápida para la automatización por API en cuentas prop",
      items: [
        "<strong class='text-white'>Confirme que la cuenta es prop/de evaluación y no personal.</strong> Las cuentas gestionadas por firmas (Apex, la familia Topstep, MyFundedFutures, Tradeify y las demás) se aprovisionan bajo el maestro de la firma y están excluidas de las claves de API personales.",
        "<strong class='text-white'>Lea primero la política de automatización de su firma.</strong> Las reglas varían según la firma e incluso según la fase, evaluación frente a cuenta financiada real, así que consulte los términos vigentes de su firma antes de automatizar nada.",
        "<strong class='text-white'>No espere que una clave de API personal llegue a una cuenta prop.</strong> Solo se autentica en las cuentas bajo su propio nombre de usuario de Tradovate, no en las de la firma.",
        "<strong class='text-white'>Pregunte a la firma, no a Tradovate.</strong> Tradovate no puede conceder derechos de API sobre una cuenta que no le pertenece; solo la firma prop puede habilitar o aprobar la automatización.",
        "<strong class='text-white'>Use un puente autorizado que no sea de API.</strong> Las herramientas de proveedores enrutan sus alertas de TradingView a la plataforma de la firma sin necesidad de una clave de API en la propia cuenta.",
        "<strong class='text-white'>Si realmente necesita acceso por API, elija una firma o plataforma que lo ofrezca.</strong> Algunas firmas (como TopstepX, impulsada por ProjectX) venden un complemento de API, pero con condiciones estrictas.",
      ],
    },
    { type: "heading",text: "Qué significa “Las cuentas prop bloquean los bots de API directa”" },
    { type: "paragraph",html: "Una clave de API de Tradovate se emite a nivel de nombre de usuario. Cuando inicia sesión en su propia cuenta de Tradovate, activa el complemento API Access y genera credenciales, esa clave puede autenticarse y enrutar órdenes para las cuentas que cuelgan de <em>su</em> nombre de usuario. Una cuenta de evaluación o financiada de una firma prop es otra cosa: la aprovisiona y controla la firma bajo su relación maestra con Tradovate, y usted inicia sesión con credenciales emitidas por la firma. Aunque estas cuentas de evaluación son técnicamente cuentas simuladas (demo), siguen aisladas del acceso por API personal; la cuenta simplemente no aparece en su respuesta de <code>/account/list</code>, así que no hay nada que su bot pueda operar." },
    { type: "paragraph",html: "El bloqueo es a la vez técnico y contractual. En el plano técnico, su clave personal no tiene autorización sobre las cuentas de la firma, por lo que las llamadas devuelven una lista de cuentas vacía o un error de acceso denegado. En el plano contractual, los términos de uso de la mayoría de las firmas prop dictan <em>cómo</em>, y si, puede automatizar con su capital. Un bot que sería perfectamente legal en su propia cuenta real de Tradovate puede ser una infracción de reglas en una cuenta financiada, y las firmas lo hacen cumplir." },
    { type: "paragraph",html: "La regla aquí es tajante: las cuentas prop no permiten acceso directo a la API y no se conoce ninguna solución alternativa para hacer nada relacionado con la API con una cuenta de firma prop. Lo correcto es llevar la petición a su firma prop, no a Tradovate, porque Tradovate no puede conceder derechos de API sobre cuentas que no le pertenecen." },
    { type: "heading",text: "Principales causas de la automatización bloqueada en cuentas prop" },
    { type: "heading",text: "1. La cuenta la gestiona la firma, no es suya" },
    { type: "paragraph",html: "Este es el gran motivo. La cuenta de evaluación o financiada pertenece a la firma prop, y sus credenciales personales de Tradovate, junto con cualquier clave de API derivada de ellas, no tienen relación alguna con ella. Por eso la cuenta nunca aparece cuando su bot enumera las cuentas, y por eso cambiar de clave o regenerar un secreto no cambia absolutamente nada." },
    { type: "heading",text: "2. Los términos de la firma prohíben (o restringen) la automatización" },
    { type: "paragraph",html: "Incluso donde existe una vía técnica, el reglamento de la firma puede prohibir bots sin supervisión, limitarlos a un funcionamiento activamente monitorizado o vetarlos por completo en ciertas fases. Las políticas de automatización varían según la firma y la fase de la cuenta: un bot que está bien en la evaluación puede estar prohibido en la cuenta financiada real. Confirme las reglas vigentes y publicadas de su firma en lugar de asumir." },
    { type: "heading",text: "3. Está apuntando una configuración de cuenta personal a un acceso prop" },
    { type: "paragraph",html: "Un fallo común: código que funciona en su propia cuenta demo o real de Tradovate falla en cuanto le pasa credenciales de una firma prop. El <code>deviceId</code>, las autorizaciones y los IDs de cuenta en los que se apoya su clave personal no se trasladan. Parece un fallo de autenticación o de “access is denied”, pero la causa real es que las credenciales no están autorizadas en absoluto para enrutar por API." },
    { type: "heading",text: "4. Esperar que Tradovate lo habilite" },
    { type: "paragraph",html: "Muchos traders abren un ticket de soporte pidiendo a Tradovate que “active el acceso a la API” en una cuenta financiada. La postura de Tradovate es que las cuentas prop y de evaluación caen bajo la relación de proveedor de la firma, por lo que la firma, y no Tradovate, controla lo que está habilitado en ellas. Escalar a la parte equivocada solo le hace perder tiempo." },
    { type: "heading",text: "Cómo corregir la automatización bloqueada en una cuenta prop: paso a paso" },
    { type: "heading",text: "Verificar si su cuenta puede usar la API en absoluto" },
    {
      type: "steps",
      items: [
        { title: "Inicie sesión y anote el tipo de cuenta", html: "Inicie sesión con las credenciales exactas que emitió su firma prop y anote el tipo de cuenta: evaluación/simulada o real personal." },
        { title: "Llame a /account/list con su propia clave", html: "Desde su propia cuenta de Tradovate (no la de la firma), genere una clave de API y llame a <code>/account/list</code>. Si la cuenta prop no aparece, ha confirmado que no es accesible mediante su API personal." },
        { title: "No pruebe claves distintas", html: "<strong class='text-white'>No</strong> siga reintentando claves distintas ni martillee el endpoint de autenticación. Las llamadas fallidas repetidas pueden activar los límites de tasa o una penalización de tiempo de Tradovate y bloquearle temporalmente." },
      ],
    },
    { type: "heading",text: "Cómo preguntar a la firma prop de la manera correcta" },
    {
      type: "steps",
      items: [
        { title: "Pregunte directamente a la firma", html: "Contacte con el soporte de su firma y pregunte directamente si se permite la automatización por API en su nivel de cuenta y en qué condiciones." },
        { title: "Solicite la configuración aprobada", html: "Si lo admiten, pida la configuración concreta: algunas firmas ofrecen su propia plataforma, clave o lista de proveedores aprobados en lugar de claves de Tradovate en bruto." },
        { title: "Obtenga las reglas por escrito", html: "Funcionamiento supervisado o sin supervisión, tipos de estrategia permitidos y cualquier restricción de VPS o servidor remoto. Estas difieren según la firma, así que consulte las reglas vigentes de la suya." },
      ],
    },
    { type: "heading",text: "Elegir una firma o plataforma que ofrezca acceso por API" },
    { type: "paragraph",html: "Si la automatización por API directa es un requisito indispensable, elija una firma cuya plataforma esté pensada para ello. TopstepX, por ejemplo, es su propia plataforma (impulsada por ProjectX, independiente de Tradovate) y vende el acceso por API como complemento de pago que permite construir estrategias automatizadas y enviar órdenes por REST y WebSocket. Las salvaguardas son estrictas y se aplican: <strong class='text-white'>toda la actividad de trading debe originarse en su dispositivo personal</strong>, y VPS, VPN y servidores remotos están prohibidos según los términos de la firma; ejecutar un bot en infraestructura en la nube puede acarrear la suspensión o la expulsión. Además, las órdenes por API son definitivas, sin revisión ni reversión, y los permisos de la fase de evaluación pueden no trasladarse a una cuenta financiada real. Los precios y las reglas exactas varían y cambian con el tiempo, así que verifique el coste vigente del complemento y la política con la firma antes de comprometerse." },
    { type: "heading",text: "Automatizar cuentas prop de Tradovate sin una clave de API en bruto" },
    {
      type: "steps",
      items: [
        { title: "Use un puente autorizado", html: "Use un puente autorizado que conecte las alertas de su estrategia de TradingView con la plataforma Tradovate de la firma sin necesidad de una clave de API en la propia cuenta." },
        { title: "Configure la asignación de riesgo", html: "Configure la cantidad, el símbolo y la asignación de riesgo para que las alertas respeten los límites de contratos y de pérdida de la firma (estos varían según la firma y el tamaño de la cuenta)." },
        { title: "Mantenga la conexión acotada y confirmada", html: "Mantenga el vínculo de cuenta del puente limitado a lo que la firma permite y confirme el enfoque primero con la política de automatización de su firma." },
      ],
    },
    { type: "heading",text: "Tabla de resolución de problemas" },
    { type: "table", headers: ["Síntoma","Significado","Solución"], rows: [
      ["La cuenta prop falta en <code>/account/list</code>","Su clave de API personal no tiene autorización sobre cuentas gestionadas por firmas","No automatice con una clave personal; pida a la firma un método aprobado"],
      ["“Access is denied” / 401 al colocar una orden","Las credenciales no están autorizadas para enrutar la cuenta prop por API","Confirme el tipo de cuenta; use un puente autorizado o la API proporcionada por la firma"],
      ["El bot funciona en demo y falla con el acceso financiado","Las autorizaciones y el ID de dispositivo de la cuenta personal no se aplican a cuentas prop","Cambie a una vía de automatización aprobada por la firma"],
      ["La firma suspende o marca la cuenta tras automatizar","La automatización infringió los términos de uso de la firma","Relea las reglas vigentes de la firma; automatice solo lo que esté permitido de forma explícita"],
      ["Los reintentos repetidos de autenticación le bloquean","Límite de tasa o penalización de tiempo por llamadas fallidas rápidas","Deje de reintentar, espere el enfriamiento y corrija la autorización de raíz"],
      ["Bot alojado en VPS suspendido (en firmas que permiten la API)","La firma exige ejecución desde dispositivo personal y prohíbe servidores remotos","Ejecute la automatización en local en su propia máquina según las reglas de la firma"],
    ] },
    { type: "heading",text: "Prevéngalo con PickMyTrade" },
    { type: "paragraph",html: "PickMyTrade es un proveedor autorizado de Tradovate, de modo que puede automatizar una cuenta gestionada por una firma sin entregar nunca una clave de API en bruto a un bot:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Enrutamiento sin clave de API</strong>, vincula sus alertas de TradingView directamente con su cuenta de Tradovate mediante una integración aprobada, esquivando por completo la limitación de la clave de API personal.",
        "<strong class='text-white'>Validación de cantidad / símbolo</strong>, bloquea las órdenes que superarían los límites de posición antes de enviarlas, para que una alerta errónea no infrinja una regla de la firma.",
        "<strong class='text-white'>Filtros de autorización y riesgo</strong>, respetan los límites de la firma prop y el estado de la cuenta, que varían según la firma y el tamaño de la cuenta, así que consulte las reglas vigentes de su firma.",
        "<strong class='text-white'>Sincronización multicuenta</strong>, replica una orden validada en las cuentas que tiene permitido operar, sin una clave independiente por cuenta.",
      ],
    },
  ], fr: [
    { type: "paragraph",html: "Vous avez monté un bot, généré une clé API Tradovate, appelé <code>/account/list</code>, et votre compte d'évaluation financé est introuvable dans la réponse. Ou vous avez essayé de router un ordre et reçu un rejet « accès refusé », alors que exactement le même code fonctionne parfaitement sur votre démo personnelle. Ce n'est pas un bug de votre script. Les comptes de firme prop et d'évaluation Tradovate n'autorisent pas l'accès API direct, et une clé API Tradovate personnelle ne peut ni voir ni trader les comptes que gère votre firme prop. Pire, brancher un bot non autorisé sur un compte financé peut enfreindre les conditions de votre firme et vous faire échouer le compte. Avant de brûler un autre frais d'évaluation à courir après des erreurs d'authentification fantômes, clarifions pourquoi la porte est fermée et quelles voies conformes permettent encore d'automatiser." },
    {
      type: "checklist",
      heading: "Liste de contrôle rapide pour l'automatisation par API des comptes prop",
      items: [
        "<strong class='text-white'>Confirmez que le compte est prop/d'évaluation, et non personnel.</strong> Les comptes gérés par les firmes (Apex, la famille Topstep, MyFundedFutures, Tradeify et les autres) sont provisionnés sous le compte maître de la firme et exclus des clés API personnelles.",
        "<strong class='text-white'>Lisez d'abord la politique d'automatisation de votre firme.</strong> Les règles varient selon la firme et même selon la phase, évaluation ou compte financé réel : vérifiez donc les conditions en vigueur de votre firme avant d'automatiser quoi que ce soit.",
        "<strong class='text-white'>Ne vous attendez pas à ce qu'une clé API personnelle atteigne un compte prop.</strong> Elle ne s'authentifie que sur les comptes rattachés à votre propre nom d'utilisateur Tradovate, pas à celui de la firme.",
        "<strong class='text-white'>Demandez à la firme, pas à Tradovate.</strong> Tradovate ne peut pas accorder de droits API sur un compte qui ne lui appartient pas ; seule la firme prop peut activer ou approuver l'automatisation.",
        "<strong class='text-white'>Utilisez un pont autorisé, sans API.</strong> Des outils de fournisseurs routent vos alertes TradingView vers la plateforme de la firme sans nécessiter de clé API sur le compte lui-même.",
        "<strong class='text-white'>Si vous avez vraiment besoin d'un accès API, choisissez une firme ou une plateforme qui en propose.</strong> Certaines firmes (comme TopstepX, propulsée par ProjectX) vendent un module complémentaire API, mais avec des conditions strictes.",
      ],
    },
    { type: "heading",text: "Ce que signifie « Les comptes prop bloquent les bots API directs »" },
    { type: "paragraph",html: "Une clé API Tradovate est émise au niveau du nom d'utilisateur. Lorsque vous vous connectez à votre propre compte Tradovate, activez le module complémentaire API Access et générez des identifiants, cette clé peut s'authentifier et router des ordres pour les comptes rattachés à <em>votre</em> nom d'utilisateur. Un compte d'évaluation ou financé d'une firme prop est autre chose : il est provisionné et contrôlé par la firme dans le cadre de sa relation maître avec Tradovate, et vous vous connectez avec des identifiants émis par la firme. Même si ces comptes d'évaluation sont techniquement des comptes simulés (démo), ils restent isolés de l'accès API personnel : le compte n'apparaît tout simplement pas dans votre réponse <code>/account/list</code>, il n'y a donc rien que votre bot puisse trader." },
    { type: "paragraph",html: "Le blocage est à la fois technique et contractuel. Sur le plan technique, votre clé personnelle n'a aucun droit sur les comptes de la firme : les appels renvoient donc une liste de comptes vide ou une erreur d'accès refusé. Sur le plan contractuel, les conditions d'utilisation de la plupart des firmes prop dictent <em>comment</em>, et si, vous pouvez automatiser avec leur capital. Un bot parfaitement légal sur votre propre compte Tradovate réel peut constituer une violation pure et simple des règles sur un compte financé, et les firmes le font respecter." },
    { type: "paragraph",html: "La règle est nette : les comptes prop n'autorisent pas l'accès API direct, et aucune solution de contournement n'est connue pour faire quoi que ce soit en lien avec l'API sur un compte de firme prop. La bonne démarche consiste à adresser la demande à votre firme prop, pas à Tradovate, car Tradovate ne peut pas accorder de droits API sur des comptes qui ne lui appartiennent pas." },
    { type: "heading",text: "Principales causes du blocage de l'automatisation sur un compte prop" },
    { type: "heading",text: "1. Le compte est géré par la firme, il n'est pas à vous" },
    { type: "paragraph",html: "C'est la cause principale. Le compte d'évaluation ou financé appartient à la firme prop, et vos identifiants Tradovate personnels, ainsi que toute clé API qui en découle, n'ont aucun lien avec lui. C'est pourquoi le compte n'apparaît jamais lorsque votre bot énumère les comptes, et pourquoi changer de clé ou régénérer un secret ne change absolument rien." },
    { type: "heading",text: "2. Les conditions de la firme interdisent (ou restreignent) l'automatisation" },
    { type: "paragraph",html: "Même lorsqu'une voie technique existe, le règlement de la firme peut interdire les bots non surveillés, les limiter à un fonctionnement activement supervisé ou les bannir purement et simplement durant certaines phases. Les politiques d'automatisation varient selon la firme et la phase du compte : un bot acceptable en évaluation peut être interdit sur le compte financé réel. Confirmez les règles publiées et en vigueur de votre firme plutôt que de supposer." },
    { type: "heading",text: "3. Vous pointez une configuration de compte personnel vers un identifiant prop" },
    { type: "paragraph",html: "Une erreur courante : du code qui fonctionne sur votre propre compte démo ou réel Tradovate échoue dès que vous lui fournissez des identifiants de firme prop. Le <code>deviceId</code>, les droits et les identifiants de compte sur lesquels repose votre clé personnelle ne se transposent pas. Cela ressemble à un échec d'authentification ou à un « access is denied », mais la vraie cause est que les identifiants ne sont tout simplement pas habilités à router par API." },
    { type: "heading",text: "4. Vous attendez de Tradovate qu'il l'active" },
    { type: "paragraph",html: "De nombreux traders ouvrent un ticket de support pour demander à Tradovate d'« activer l'accès API » sur un compte financé. La position de Tradovate est que les comptes prop et d'évaluation relèvent de la relation fournisseur de la firme : c'est donc la firme, et non Tradovate, qui contrôle ce qui y est activé. S'adresser à la mauvaise partie ne fait que vous faire perdre du temps." },
    { type: "heading",text: "Comment corriger l'automatisation bloquée d'un compte prop : pas à pas" },
    { type: "heading",text: "Vérifier si votre compte peut utiliser l'API" },
    {
      type: "steps",
      items: [
        { title: "Connectez-vous et notez le type de compte", html: "Connectez-vous avec les identifiants exacts émis par votre firme prop et notez le type de compte : évaluation/simulé, ou réel personnel." },
        { title: "Appelez /account/list avec votre propre clé", html: "Depuis votre propre compte Tradovate (pas celui de la firme), générez une clé API et appelez <code>/account/list</code>. Si le compte prop est absent, vous avez confirmé qu'il n'est pas accessible via votre API personnelle." },
        { title: "N'essayez pas d'autres clés", html: "N'essayez <strong class='text-white'>pas</strong> sans cesse d'autres clés et ne martelez pas le point de terminaison d'authentification. Des appels échoués répétés peuvent déclencher les limites de débit de Tradovate ou une pénalité de temps et vous verrouiller temporairement." },
      ],
    },
    { type: "heading",text: "Interroger la firme prop de la bonne manière" },
    {
      type: "steps",
      items: [
        { title: "Demandez directement à la firme", html: "Contactez le support de votre firme et demandez directement si l'automatisation par API est autorisée pour votre niveau de compte, et à quelles conditions." },
        { title: "Demandez la configuration approuvée", html: "Si elle le permet, demandez la configuration précise : certaines firmes fournissent leur propre plateforme, clé ou liste de fournisseurs approuvés plutôt que des clés Tradovate brutes." },
        { title: "Obtenez les règles par écrit", html: "Fonctionnement supervisé ou non, types de stratégies autorisés et éventuelles restrictions de VPS ou de serveur distant. Elles diffèrent selon les firmes : vérifiez donc les règles en vigueur de la vôtre." },
      ],
    },
    { type: "heading",text: "Choisir une firme ou une plateforme qui offre l'accès API" },
    { type: "paragraph",html: "Si l'automatisation par API directe est une exigence ferme, choisissez une firme dont la plateforme est conçue pour cela. TopstepX, par exemple, est sa propre plateforme (propulsée par ProjectX, distincte de Tradovate) et vend l'accès API comme module complémentaire payant permettant de bâtir des stratégies automatisées et d'envoyer des ordres REST et WebSocket. Les garde-fous sont toutefois stricts et appliqués : <strong class='text-white'>toute l'activité de trading doit provenir de votre appareil personnel</strong>, et les VPS, VPN et serveurs distants sont interdits par les conditions de la firme ; exécuter un bot sur une infrastructure cloud peut entraîner une suspension ou une exclusion. Les ordres API sont par ailleurs définitifs, sans examen ni annulation, et les autorisations de la phase d'évaluation ne sont pas forcément reconduites sur un compte financé réel. Les tarifs et les règles exactes varient et évoluent avec le temps : vérifiez donc le coût actuel du module complémentaire et la politique auprès de la firme avant de vous engager." },
    { type: "heading",text: "Automatiser des comptes prop Tradovate sans clé API brute" },
    {
      type: "steps",
      items: [
        { title: "Utilisez un pont autorisé", html: "Utilisez un pont autorisé qui relie les alertes de votre stratégie TradingView à la plateforme Tradovate de la firme sans nécessiter de clé API sur le compte lui-même." },
        { title: "Configurez l'attribution du risque", html: "Configurez la quantité, le symbole et l'attribution du risque afin que les alertes respectent les plafonds de contrats et les limites de perte de la firme (ceux-ci varient selon la firme et la taille du compte)." },
        { title: "Gardez la connexion circonscrite et confirmée", html: "Maintenez le lien de compte du pont limité à ce que la firme autorise, et confirmez d'abord l'approche auprès de la politique d'automatisation de votre firme." },
      ],
    },
    { type: "heading",text: "Tableau de dépannage" },
    { type: "table", headers: ["Symptôme","Signification","Solution"], rows: [
      ["Le compte prop est absent de <code>/account/list</code>","Votre clé API personnelle n'a aucun droit sur les comptes gérés par une firme","N'automatisez pas via une clé personnelle ; demandez à la firme une méthode approuvée"],
      ["« Access is denied » / 401 lors du passage d'ordre","Les identifiants ne sont pas habilités à router le compte prop par API","Confirmez le type de compte ; utilisez un pont autorisé ou l'API fournie par la firme"],
      ["Le bot fonctionne en démo, échoue avec l'identifiant financé","Les droits et l'identifiant d'appareil du compte personnel ne s'appliquent pas aux comptes prop","Passez à une voie d'automatisation approuvée par la firme"],
      ["La firme fait échouer ou signale le compte après automatisation","L'automatisation a enfreint les conditions d'utilisation de la firme","Relisez les règles en vigueur de la firme ; n'automatisez que ce qui est explicitement autorisé"],
      ["Les tentatives d'authentification répétées vous verrouillent","Limite de débit ou pénalité de temps due à des appels échoués rapprochés","Cessez de réessayer, attendez la fin du délai et corrigez le droit d'accès à la racine"],
      ["Bot hébergé sur VPS suspendu (chez les firmes qui autorisent l'API)","La firme exige une exécution depuis l'appareil personnel et interdit les serveurs distants","Exécutez l'automatisation en local sur votre propre machine selon les règles de la firme"],
    ] },
    { type: "heading",text: "Évitez cela avec PickMyTrade" },
    { type: "paragraph",html: "PickMyTrade est un fournisseur Tradovate autorisé : vous pouvez donc automatiser un compte géré par une firme sans jamais confier une clé API brute à un bot :" },
    {
      type: "list",
