---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "tradovate-accounts-missing-ninjatrader-tab";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/debugging/${SLUG}`;

const META_TITLE = "Tradovate Accounts Missing in NinjaTrader Tab";
const META_DESCRIPTION =
  "Tradovate accounts connect in NinjaTrader but never list under the Accounts tab? Rename the db folder to OLDdb and repair the install to fix it fast.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Tradovate-Konten fehlen im NinjaTrader-Tab", es: "Las cuentas de Tradovate no aparecen en la pestaña de NinjaTrader", fr: "Comptes Tradovate absents de l'onglet NinjaTrader", it: "Account Tradovate mancanti nella scheda di NinjaTrader" },
  dek: { en: "NinjaTrader shows a green Connected light for your Tradovate account, but the Accounts tab stays empty. Here's why it's a local database problem, not a login problem, and how to rebuild it.", de: "NinjaTrader zeigt für Ihr Tradovate-Konto ein grünes Verbunden-Signal an, aber der Tab „Accounts“ bleibt leer. Warum das ein Problem der lokalen Datenbank und kein Login-Problem ist und wie Sie sie neu aufbauen.", es: "NinjaTrader muestra una luz verde de conexión para su cuenta de Tradovate, pero la pestaña Accounts sigue vacía. Por qué se trata de un problema de la base de datos local y no de inicio de sesión, y cómo reconstruirla.", fr: "NinjaTrader affiche un voyant vert Connected pour votre compte Tradovate, mais l'onglet Accounts reste vide. Pourquoi il s'agit d'un problème de base de données locale et non de connexion, et comment la reconstruire.", it: "NinjaTrader mostra una spia verde Connected per il Suo account Tradovate, ma la scheda Accounts resta vuota. Perché si tratta di un problema del database locale e non del login, e come ricostruirlo." },
  readTime: { en: "7 min read", de: "7 Min. Lesezeit", es: "Lectura de 7 min", fr: "Lecture : 7 min", it: "Lettura di 7 min" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "You typed in your Tradovate credentials, NinjaTrader said the connection went through, the little status light turned green, and yet the Accounts tab sits there empty. No account number to select, nothing to trade on, no way to place an order. It's one of the more maddening states in NinjaTrader because everything <em>looks</em> right except the one thing you actually need." },
    { type: "paragraph", html: "The short version: this is almost never a login problem and almost always a local database problem. NinjaTrader keeps your accounts, orders, and settings in a small database file on your own machine. When that file gets corrupted or falls out of sync, the connection can succeed while the accounts fail to load into the grid. The fix is to force NinjaTrader to rebuild that database from scratch by renaming its <code>db</code> folder to <code>OLDdb</code> and repairing the install." },
    { type: "quote", html: "<strong class='text-white'>Quick fix:</strong> Close NinjaTrader, back up your setup, rename <code>Documents\\NinjaTrader 8\\db</code> to <code>OLDdb</code>, repair NinjaTrader from Windows Control Panel, then relaunch and reconnect. Your Tradovate accounts should list normally against a clean database." },
    { type: "heading", text: "What You're Actually Seeing" },
    { type: "paragraph", html: "A connected-but-empty state has a specific fingerprint. The connection indicator in the Control Center shows Connected. Log messages don't scream &ldquo;logon failed.&rdquo; But when you open the Accounts tab, or try to drop an order on a chart or the SuperDOM, there's no account in the dropdown to route it to. Other connections you might run, like Rithmic, populate their accounts right away, which makes the Tradovate side look even more broken by comparison." },
    { type: "paragraph", html: "If you're routing a prop firm evaluation through NinjaTrader, the same symptom shows up when the firm's account never appears in the list even though the credentials clearly authenticated. Before you rebuild anything, rule out the two boring causes: a brand-new account that hasn't finished provisioning yet, and the wrong Account Type on the connection. A freshly purchased evaluation can take a little time to appear on the firm's side, so give a new account a bit of breathing room. If an account you've traded for weeks suddenly stops listing, that's your database talking, and the steps below are what you want." },
    { type: "heading", text: "Why the Connection Works but the Accounts Vanish" },
    { type: "paragraph", html: "NinjaTrader 8 stores almost everything locally: your accounts, your order history, your instruments, your trading hours templates, your workspaces. That data lives in a database inside <code>Documents\\NinjaTrader 8\\db</code>. When you connect to Tradovate, NinjaTrader authenticates against Tradovate's servers, pulls down the account list, and writes those rows into the local database so the Accounts tab can read them back." },
    { type: "paragraph", html: "Every step in that chain can succeed except the last one. If the local database is corrupted, has a malformed table, or is holding stale rows from an old session, the account data has nowhere clean to land. The connection reports success because the handshake with Tradovate genuinely worked, but the grid stays empty because it's reading from a broken store. This is why a plain reconnect, a password reset, or even a computer restart usually does nothing here. You're not fixing the thing that's broken. The database is, so the database is what has to be rebuilt." },
    { type: "paragraph", html: "That's also why the fix is so reliable. You're not patching the corruption, you're throwing the whole file away and letting NinjaTrader generate a fresh one on next launch." },
    { type: "heading", text: "Before You Touch Anything: Back Up" },
    { type: "paragraph", html: "Renaming the <code>db</code> folder is a clean reset, and a reset has a cost. You'll lose anything stored only in that database: custom trading hours, your instrument lists and custom instruments, locally stored trade history, saved Strategy Analyzer backtest results, and any simulation accounts you added by hand. None of that comes back on its own, so spend two minutes protecting it first." },
    { type: "paragraph", html: "Open the NinjaTrader Control Center, disconnect from any live connection, then go to <strong class='text-white'>Tools &gt; Export &gt; Backup File</strong>. Tick the items you care about (Configuration, Database, Workspaces, NinjaScript files, Templates, Historical Data as needed) and save the archive. By default it lands in <code>Documents\\NinjaTrader 8 Backup</code> with today's date as the file name." },
    { type: "paragraph", html: "If the repair goes smoothly, you may never need this archive. But if you find yourself missing a workspace or an instrument list afterward, you can restore selectively with <strong class='text-white'>Tools &gt; Import &gt; Backup File</strong> instead of rebuilding everything from memory." },
    { type: "heading", text: "The Fix: Rename the db Folder and Repair NinjaTrader" },
    { type: "paragraph", html: "Work through these in order. The whole thing takes about ten minutes, most of which is the repair running on its own." },
    {
      type: "steps",
      items: [
        { title: "Close NinjaTrader completely", html: "Fully shut NinjaTrader down. Don't just minimize it. If you're not sure it's really closed, check that no NinjaTrader process is still running in Task Manager. A rename won't work while the file is locked by an open instance." },
        { title: "Rename the db folder to OLDdb", html: "Open File Explorer and go to <code>Documents\\NinjaTrader 8</code>. Find the folder named <code>db</code>, right-click it, choose <strong class='text-white'>Rename</strong>, and change it to <code>OLDdb</code>. Renaming instead of deleting keeps the old data on disk as a safety net in case you need to fish something out of it later." },
        { title: "Repair the NinjaTrader install", html: "Open Windows <strong class='text-white'>Control Panel &gt; Programs and Features</strong> (Add or Remove Programs on newer Windows builds). Find <strong class='text-white'>NinjaTrader 8</strong> in the list, select it, and click <strong class='text-white'>Repair</strong> at the top of the program list. Let the repair run to completion without interrupting it. This step rebuilds the platform files and, because the original <code>db</code> folder is gone, prompts NinjaTrader to create a fresh, empty database the next time it starts." },
        { title: "Relaunch and reconnect to Tradovate", html: "Start NinjaTrader 8. It will build a new database on first launch, so give it a moment. Reconnect to your Tradovate account the way you normally do. With a clean database underneath it, the account list should populate and your accounts should finally appear in the Accounts tab, ready to trade." },
      ],
    },
    { type: "paragraph", html: "One lighter option to try before the full folder rename: NinjaTrader has a built-in repair tool at <strong class='text-white'>Control Center &gt; Tools &gt; Database Management &gt; Repair DB</strong>. Disconnect first, run it, and see if that clears the corruption without a rebuild. It doesn't always fix a stubborn case, but it's non-destructive, so it's worth a quick attempt when you'd rather not lose your local data." },
    { type: "heading", text: "If the Accounts Still Don't Show" },
    { type: "paragraph", html: "A rebuilt database fixes most cases, but if the grid is still empty after reconnecting, the problem is on the connection side rather than the database. Run down this list:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Account Type must be Simulation.</strong> For Tradovate-based prop firm accounts in NinjaTrader, the connection's Account Type is set to Simulation, not Live and not NinjaTrader Brokerage. The wrong type is a classic reason accounts never list.",
        "<strong class='text-white'>Enable Multi-Provider Mode.</strong> If you run more than one connection, this has to be on. Turn it on under <strong class='text-white'>Tools &gt; Options &gt; General &gt; Multi-Provider Mode</strong>, then restart NinjaTrader.",
        "<strong class='text-white'>Check credentials character by character.</strong> A stray space at the start or end of the username or password will block the account from loading. Retype them by hand rather than pasting.",
        "<strong class='text-white'>Sync your system clock.</strong> A drifting clock quietly breaks Tradovate connections. Set Windows time to sync automatically and force a sync.",
        "<strong class='text-white'>Confirm the version supports Tradovate.</strong> Older NinjaTrader builds can't connect to Tradovate at all. If you're on an early release, update the platform.",
      ],
    },
    { type: "paragraph", html: "Still stuck? Hand NinjaTrader the evidence. Go to <strong class='text-white'>Control Center &gt; Help &gt; Email Support</strong>, make sure the Log and Trace Files box is checked, and include a screenshot of the empty Accounts tab. Those trace files tell them exactly where the account load is failing." },
    { type: "heading", text: "Keep It From Happening Again" },
    { type: "paragraph", html: "Database corruption in NinjaTrader tends to come from hard crashes, force-quits, and interrupted shutdowns, so close the platform cleanly and let it finish writing before you power off. The single best habit is a regular backup. Run <strong class='text-white'>Tools &gt; Export &gt; Backup File</strong> on a schedule so that the next time the database goes sideways, the rename-and-repair is a five-minute inconvenience instead of a day of rebuilding your setup." },
    { type: "paragraph", html: "While you're tuning the integration, it's worth sorting out the two other Tradovate-through-NinjaTrader gotchas that trip people up: charts stuck on delayed 10-minute data, and stop orders that don't update to breakeven the way you expect. Both are quick to fix once you know where to look." },
  ], de: [
    { type: "paragraph",html: "Sie haben Ihre Tradovate-Zugangsdaten eingegeben, NinjaTrader meldet, dass die Verbindung steht, die kleine Statusleuchte ist grün geworden, und trotzdem bleibt der Tab „Accounts“ leer. Keine Kontonummer zur Auswahl, nichts, womit Sie handeln könnten, keine Möglichkeit, eine Order zu platzieren. Das ist einer der nervigsten Zustände in NinjaTrader, weil alles richtig <em>aussieht</em>, außer dem Einzigen, das Sie tatsächlich brauchen." },
    { type: "paragraph",html: "Die Kurzfassung: Das ist fast nie ein Login-Problem, sondern fast immer ein Problem der lokalen Datenbank. NinjaTrader speichert Ihre Konten, Orders und Einstellungen in einer kleinen Datenbankdatei auf Ihrem eigenen Rechner. Wird diese Datei beschädigt oder gerät sie aus dem Takt, kann die Verbindung gelingen, während die Konten nicht in das Raster geladen werden. Die Lösung besteht darin, NinjaTrader zu zwingen, diese Datenbank von Grund auf neu aufzubauen, indem Sie ihren Ordner <code>db</code> in <code>OLDdb</code> umbenennen und die Installation reparieren." },
    { type: "quote",html: "<strong class='text-white'>Schnelle Lösung:</strong> Schließen Sie NinjaTrader, sichern Sie Ihr Setup, benennen Sie <code>Documents\\NinjaTrader 8\\db</code> in <code>OLDdb</code> um, reparieren Sie NinjaTrader über die Windows-Systemsteuerung, starten Sie es neu und verbinden Sie sich erneut. Ihre Tradovate-Konten sollten dann normal gegen eine saubere Datenbank aufgelistet werden." },
    { type: "heading",text: "Was Sie tatsächlich sehen" },
    { type: "paragraph",html: "Ein Zustand „verbunden, aber leer“ hat einen ganz bestimmten Fingerabdruck. Die Verbindungsanzeige im Control Center zeigt Connected. Die Logmeldungen melden kein &ldquo;Logon failed&rdquo;. Doch wenn Sie den Tab „Accounts“ öffnen oder versuchen, eine Order auf einem Chart oder im SuperDOM zu platzieren, gibt es kein Konto im Dropdown, an das sie geleitet werden könnte. Andere Verbindungen, die Sie eventuell betreiben, etwa Rithmic, füllen ihre Konten sofort, wodurch die Tradovate-Seite im Vergleich noch defekter wirkt." },
    { type: "paragraph",html: "Wenn Sie eine Prop-Firm-Evaluierung über NinjaTrader leiten, zeigt sich dasselbe Symptom, wenn das Konto der Firma nie in der Liste erscheint, obwohl die Zugangsdaten eindeutig authentifiziert wurden. Schließen Sie, bevor Sie etwas neu aufbauen, die beiden banalen Ursachen aus: ein brandneues Konto, das noch nicht fertig bereitgestellt wurde, und den falschen Account Type bei der Verbindung. Eine frisch gekaufte Evaluierung kann auf Seiten der Firma etwas Zeit brauchen, bis sie erscheint, geben Sie einem neuen Konto also etwas Luft. Wenn ein Konto, mit dem Sie seit Wochen handeln, plötzlich nicht mehr aufgelistet wird, spricht Ihre Datenbank, und die folgenden Schritte sind genau das, was Sie brauchen." },
    { type: "heading",text: "Warum die Verbindung funktioniert, die Konten aber verschwinden" },
    { type: "paragraph",html: "NinjaTrader 8 speichert fast alles lokal: Ihre Konten, Ihre Orderhistorie, Ihre Instrumente, Ihre Vorlagen für Handelszeiten und Ihre Workspaces. Diese Daten liegen in einer Datenbank im Ordner <code>Documents\\NinjaTrader 8\\db</code>. Wenn Sie sich mit Tradovate verbinden, authentifiziert sich NinjaTrader gegenüber den Servern von Tradovate, lädt die Kontenliste herunter und schreibt diese Zeilen in die lokale Datenbank, damit der Tab „Accounts“ sie zurücklesen kann." },
    { type: "paragraph",html: "Jeder Schritt dieser Kette kann gelingen, außer dem letzten. Ist die lokale Datenbank beschädigt, hat sie eine fehlerhafte Tabelle oder enthält sie veraltete Zeilen aus einer alten Sitzung, haben die Kontodaten keinen sauberen Platz, an dem sie landen können. Die Verbindung meldet Erfolg, weil der Handshake mit Tradovate tatsächlich funktioniert hat, aber das Raster bleibt leer, weil es aus einem defekten Speicher liest. Deshalb bewirken ein einfacher Neuverbindungsversuch, ein Passwort-Reset oder sogar ein Neustart des Computers hier meist nichts. Sie beheben nicht das, was kaputt ist. Die Datenbank ist es, also muss die Datenbank neu aufgebaut werden." },
    { type: "paragraph",html: "Deshalb ist die Lösung auch so zuverlässig. Sie flicken die Beschädigung nicht, sondern werfen die gesamte Datei weg und lassen NinjaTrader beim nächsten Start eine frische erzeugen." },
    { type: "heading",text: "Bevor Sie etwas anfassen: Sichern Sie Ihre Daten" },
    { type: "paragraph",html: "Das Umbenennen des Ordners <code>db</code> ist ein sauberer Reset, und ein Reset hat seinen Preis. Sie verlieren alles, was nur in dieser Datenbank gespeichert ist: benutzerdefinierte Handelszeiten, Ihre Instrumentenlisten und benutzerdefinierten Instrumente, lokal gespeicherte Handelshistorie, gespeicherte Backtest-Ergebnisse des Strategy Analyzer und alle von Hand hinzugefügten Simulationskonten. Nichts davon kommt von selbst zurück. Nehmen Sie sich also zuerst zwei Minuten Zeit, um es zu schützen." },
    { type: "paragraph",html: "Öffnen Sie das NinjaTrader Control Center, trennen Sie alle aktiven Verbindungen und gehen Sie dann zu <strong class='text-white'>Tools &gt; Export &gt; Backup File</strong>. Haken Sie die Elemente an, die Ihnen wichtig sind (Configuration, Database, Workspaces, NinjaScript files, Templates, Historical Data nach Bedarf), und speichern Sie das Archiv. Standardmäßig landet es in <code>Documents\\NinjaTrader 8 Backup</code> mit dem heutigen Datum als Dateinamen." },
    { type: "paragraph",html: "Wenn die Reparatur reibungslos verläuft, brauchen Sie dieses Archiv womöglich nie. Falls Ihnen danach aber ein Workspace oder eine Instrumentenliste fehlt, können Sie selektiv mit <strong class='text-white'>Tools &gt; Import &gt; Backup File</strong> wiederherstellen, statt alles aus dem Gedächtnis neu aufzubauen." },
    { type: "heading",text: "Die Lösung: Ordner db umbenennen und NinjaTrader reparieren" },
    { type: "paragraph",html: "Gehen Sie diese Schritte der Reihe nach durch. Das Ganze dauert etwa zehn Minuten, die meiste Zeit davon läuft die Reparatur von allein." },
    {
      type: "steps",
      items: [
        { title: "NinjaTrader vollständig schließen", html: "Beenden Sie NinjaTrader komplett. Minimieren Sie es nicht nur. Wenn Sie nicht sicher sind, ob es wirklich geschlossen ist, prüfen Sie im Task-Manager, dass kein NinjaTrader-Prozess mehr läuft. Eine Umbenennung funktioniert nicht, solange die Datei von einer geöffneten Instanz gesperrt ist." },
        { title: "Den Ordner db in OLDdb umbenennen", html: "Öffnen Sie den Datei-Explorer und gehen Sie zu <code>Documents\\NinjaTrader 8</code>. Suchen Sie den Ordner namens <code>db</code>, klicken Sie ihn mit der rechten Maustaste an, wählen Sie <strong class='text-white'>Rename</strong> und ändern Sie den Namen in <code>OLDdb</code>. Durch das Umbenennen statt Löschen bleiben die alten Daten als Sicherheitsnetz auf der Festplatte, falls Sie später etwas daraus herausholen müssen." },
        { title: "Die NinjaTrader-Installation reparieren", html: "Öffnen Sie in Windows <strong class='text-white'>Control Panel &gt; Programs and Features</strong> (bei neueren Windows-Versionen „Apps &amp; Features“ bzw. Add or Remove Programs). Suchen Sie <strong class='text-white'>NinjaTrader 8</strong> in der Liste, wählen Sie es aus und klicken Sie oben in der Programmliste auf <strong class='text-white'>Repair</strong>. Lassen Sie die Reparatur vollständig durchlaufen, ohne sie zu unterbrechen. Dieser Schritt baut die Plattformdateien neu auf und veranlasst NinjaTrader, beim nächsten Start eine frische, leere Datenbank anzulegen, weil der ursprüngliche Ordner <code>db</code> nicht mehr vorhanden ist." },
        { title: "Neu starten und erneut mit Tradovate verbinden", html: "Starten Sie NinjaTrader 8. Beim ersten Start baut es eine neue Datenbank auf, geben Sie ihm also einen Moment. Verbinden Sie sich wie gewohnt erneut mit Ihrem Tradovate-Konto. Mit einer sauberen Datenbank darunter sollte sich die Kontenliste füllen und Ihre Konten sollten endlich im Tab „Accounts“ erscheinen, bereit zum Handeln." },
      ],
    },
    { type: "paragraph",html: "Eine mildere Option, die Sie vor dem vollständigen Umbenennen des Ordners ausprobieren können: NinjaTrader hat ein eingebautes Reparaturwerkzeug unter <strong class='text-white'>Control Center &gt; Tools &gt; Database Management &gt; Repair DB</strong>. Trennen Sie zuerst die Verbindung, führen Sie es aus und prüfen Sie, ob damit die Beschädigung ohne Neuaufbau behoben wird. Bei hartnäckigen Fällen hilft es nicht immer, aber es ist nicht destruktiv und daher einen kurzen Versuch wert, wenn Sie Ihre lokalen Daten lieber nicht verlieren möchten." },
    { type: "heading",text: "Wenn die Konten weiterhin nicht erscheinen" },
    { type: "paragraph",html: "Eine neu aufgebaute Datenbank behebt die meisten Fälle. Bleibt das Raster nach dem erneuten Verbinden jedoch leer, liegt das Problem eher auf der Verbindungsseite als an der Datenbank. Arbeiten Sie diese Liste ab:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Der Account Type muss Simulation sein.</strong> Bei Tradovate-basierten Prop-Firm-Konten in NinjaTrader ist der Account Type der Verbindung auf Simulation gesetzt, nicht auf Live und nicht auf NinjaTrader Brokerage. Der falsche Typ ist ein klassischer Grund dafür, dass Konten nie aufgelistet werden.",
        "<strong class='text-white'>Multi-Provider Mode aktivieren.</strong> Wenn Sie mehr als eine Verbindung betreiben, muss dieser eingeschaltet sein. Aktivieren Sie ihn unter <strong class='text-white'>Tools &gt; Options &gt; General &gt; Multi-Provider Mode</strong> und starten Sie NinjaTrader anschließend neu.",
        "<strong class='text-white'>Zugangsdaten Zeichen für Zeichen prüfen.</strong> Ein verirrtes Leerzeichen am Anfang oder Ende des Benutzernamens oder Passworts verhindert, dass das Konto geladen wird. Geben Sie sie von Hand neu ein, statt sie einzufügen.",
        "<strong class='text-white'>Systemuhr synchronisieren.</strong> Eine abdriftende Uhr stört Tradovate-Verbindungen unbemerkt. Stellen Sie die Windows-Zeit auf automatische Synchronisierung und erzwingen Sie eine Synchronisierung.",
        "<strong class='text-white'>Prüfen, ob die Version Tradovate unterstützt.</strong> Ältere NinjaTrader-Builds können sich überhaupt nicht mit Tradovate verbinden. Wenn Sie eine frühe Version nutzen, aktualisieren Sie die Plattform.",
      ],
    },
    { type: "paragraph",html: "Immer noch festgefahren? Geben Sie NinjaTrader die Beweise an die Hand. Gehen Sie zu <strong class='text-white'>Control Center &gt; Help &gt; Email Support</strong>, stellen Sie sicher, dass das Kontrollkästchen für Log- und Trace-Dateien aktiviert ist, und fügen Sie einen Screenshot des leeren Tabs „Accounts“ bei. Diese Trace-Dateien zeigen genau, wo das Laden der Konten fehlschlägt." },
    { type: "heading",text: "So verhindern Sie, dass es wieder passiert" },
    { type: "paragraph",html: "Datenbankbeschädigungen in NinjaTrader entstehen meist durch harte Abstürze, erzwungene Beendigungen und unterbrochene Herunterfahrvorgänge. Schließen Sie die Plattform daher sauber und lassen Sie sie das Schreiben abschließen, bevor Sie den Rechner ausschalten. Die beste Gewohnheit ist eine regelmäßige Sicherung. Führen Sie <strong class='text-white'>Tools &gt; Export &gt; Backup File</strong> nach einem festen Zeitplan aus, damit das Umbenennen und Reparieren beim nächsten Mal, wenn die Datenbank Probleme macht, eine Unannehmlichkeit von fünf Minuten statt eines Tages Wiederaufbau Ihres Setups ist." },
    { type: "paragraph",html: "Wenn Sie schon dabei sind, die Integration zu optimieren, lohnt es sich, die beiden anderen Stolperfallen bei Tradovate über NinjaTrader zu klären: Charts, die auf um 10 Minuten verzögerten Daten hängen bleiben, und Stop-Orders, die sich nicht wie erwartet auf Breakeven nachziehen. Beides ist schnell behoben, wenn Sie wissen, wo Sie nachsehen müssen." },
  ], es: [
    { type: "paragraph",html: "Introdujo sus credenciales de Tradovate, NinjaTrader indicó que la conexión se había establecido, la lucecita de estado se puso en verde y, aun así, la pestaña Accounts sigue vacía. Ningún número de cuenta que seleccionar, nada con lo que operar, ninguna forma de enviar una orden. Es uno de los estados más exasperantes de NinjaTrader porque todo <em>parece</em> correcto salvo lo único que realmente necesita." },
    { type: "paragraph",html: "La versión corta: casi nunca es un problema de inicio de sesión y casi siempre es un problema de la base de datos local. NinjaTrader guarda sus cuentas, órdenes y ajustes en un pequeño archivo de base de datos en su propio equipo. Cuando ese archivo se corrompe o pierde la sincronización, la conexión puede tener éxito mientras las cuentas no se cargan en la cuadrícula. La solución consiste en obligar a NinjaTrader a reconstruir esa base de datos desde cero renombrando su carpeta <code>db</code> a <code>OLDdb</code> y reparando la instalación." },
    { type: "quote",html: "<strong class='text-white'>Solución rápida:</strong> cierre NinjaTrader, haga una copia de seguridad de su configuración, renombre <code>Documents\\NinjaTrader 8\\db</code> a <code>OLDdb</code>, repare NinjaTrader desde el Panel de control de Windows, vuelva a abrirlo y reconéctese. Sus cuentas de Tradovate deberían aparecer con normalidad sobre una base de datos limpia." },
    { type: "heading",text: "Lo que realmente está viendo" },
    { type: "paragraph",html: "Un estado de conectado pero vacío tiene una huella muy concreta. El indicador de conexión del Control Center muestra Connected. Los mensajes del registro no gritan &ldquo;logon failed&rdquo;. Pero al abrir la pestaña Accounts, o al intentar colocar una orden en un gráfico o en el SuperDOM, no hay ninguna cuenta en el desplegable a la que enviarla. Otras conexiones que quizá utilice, como Rithmic, rellenan sus cuentas de inmediato, lo que hace que el lado de Tradovate parezca aún más roto en comparación." },
    { type: "paragraph",html: "Si dirige una evaluación de una prop firm a través de NinjaTrader, el mismo síntoma aparece cuando la cuenta de la firma nunca figura en la lista aunque las credenciales se hayan autenticado claramente. Antes de reconstruir nada, descarte las dos causas más banales: una cuenta nueva que aún no ha terminado de aprovisionarse y un Account Type incorrecto en la conexión. Una evaluación recién comprada puede tardar un poco en aparecer por parte de la firma, así que dé un poco de margen a una cuenta nueva. Si una cuenta con la que opera desde hace semanas deja de aparecer de repente, es su base de datos la que habla, y los pasos siguientes son los que necesita." },
    { type: "heading",text: "Por qué la conexión funciona pero las cuentas desaparecen" },
    { type: "paragraph",html: "NinjaTrader 8 almacena casi todo de forma local: sus cuentas, su historial de órdenes, sus instrumentos, sus plantillas de horarios de trading y sus espacios de trabajo. Esos datos residen en una base de datos dentro de <code>Documents\\NinjaTrader 8\\db</code>. Cuando se conecta a Tradovate, NinjaTrader se autentica en los servidores de Tradovate, descarga la lista de cuentas y escribe esas filas en la base de datos local para que la pestaña Accounts pueda leerlas." },
    { type: "paragraph",html: "Todos los pasos de esa cadena pueden salir bien excepto el último. Si la base de datos local está corrupta, tiene una tabla malformada o conserva filas obsoletas de una sesión antigua, los datos de la cuenta no tienen dónde aterrizar limpiamente. La conexión informa de éxito porque el protocolo de enlace con Tradovate realmente funcionó, pero la cuadrícula sigue vacía porque lee de un almacén dañado. Por eso, volver a conectar, restablecer la contraseña o incluso reiniciar el ordenador normalmente no sirve de nada aquí. No está arreglando lo que está roto. Lo roto es la base de datos, así que es la base de datos lo que hay que reconstruir." },
    { type: "paragraph",html: "Por eso la solución es tan fiable. No está parcheando la corrupción, sino descartando el archivo entero y dejando que NinjaTrader genere uno nuevo en el siguiente arranque." },
    { type: "heading",text: "Antes de tocar nada: haga una copia de seguridad" },
    { type: "paragraph",html: "Renombrar la carpeta <code>db</code> es un reinicio limpio, y un reinicio tiene un coste. Perderá todo lo que se almacene únicamente en esa base de datos: horarios de trading personalizados, sus listas de instrumentos e instrumentos personalizados, historial de operaciones almacenado localmente, resultados de backtest guardados del Strategy Analyzer y cualquier cuenta de simulación que haya añadido a mano. Nada de eso vuelve por sí solo, así que dedique dos minutos a protegerlo primero." },
    { type: "paragraph",html: "Abra el Control Center de NinjaTrader, desconéctese de cualquier conexión activa y vaya a <strong class='text-white'>Tools &gt; Export &gt; Backup File</strong>. Marque los elementos que le interesen (Configuration, Database, Workspaces, NinjaScript files, Templates, Historical Data según necesite) y guarde el archivo. De forma predeterminada se guarda en <code>Documents\\NinjaTrader 8 Backup</code> con la fecha de hoy como nombre de archivo." },
    { type: "paragraph",html: "Si la reparación va bien, quizá nunca necesite este archivo. Pero si después echa en falta un espacio de trabajo o una lista de instrumentos, puede restaurar de forma selectiva con <strong class='text-white'>Tools &gt; Import &gt; Backup File</strong> en lugar de reconstruirlo todo de memoria." },
    { type: "heading",text: "La solución: renombrar la carpeta db y reparar NinjaTrader" },
    { type: "paragraph",html: "Siga estos pasos en orden. Todo el proceso lleva unos diez minutos, la mayor parte de los cuales es la reparación ejecutándose por sí sola." },
    {
      type: "steps",
      items: [
        { title: "Cierre NinjaTrader por completo", html: "Cierre NinjaTrader del todo. No se limite a minimizarlo. Si no está seguro de que esté realmente cerrado, compruebe en el Administrador de tareas que no quede ningún proceso de NinjaTrader en ejecución. Un cambio de nombre no funcionará mientras una instancia abierta mantenga bloqueado el archivo." },
        { title: "Renombre la carpeta db a OLDdb", html: "Abra el Explorador de archivos y vaya a <code>Documents\\NinjaTrader 8</code>. Localice la carpeta llamada <code>db</code>, haga clic derecho sobre ella, elija <strong class='text-white'>Rename</strong> y cámbiele el nombre a <code>OLDdb</code>. Renombrar en lugar de eliminar mantiene los datos antiguos en el disco como red de seguridad por si más adelante necesita rescatar algo de ellos." },
        { title: "Repare la instalación de NinjaTrader", html: "Abra el <strong class='text-white'>Control Panel &gt; Programs and Features</strong> de Windows (Add or Remove Programs en las versiones más recientes de Windows). Busque <strong class='text-white'>NinjaTrader 8</strong> en la lista, selecciónelo y haga clic en <strong class='text-white'>Repair</strong> en la parte superior de la lista de programas. Deje que la reparación se ejecute hasta el final sin interrumpirla. Este paso reconstruye los archivos de la plataforma y, como la carpeta <code>db</code> original ya no existe, hace que NinjaTrader cree una base de datos nueva y vacía la próxima vez que se inicie." },
        { title: "Vuelva a abrir y reconéctese a Tradovate", html: "Inicie NinjaTrader 8. Creará una base de datos nueva en el primer arranque, así que concédale un momento. Reconéctese a su cuenta de Tradovate como lo hace habitualmente. Con una base de datos limpia por debajo, la lista de cuentas debería completarse y sus cuentas deberían aparecer por fin en la pestaña Accounts, listas para operar." },
      ],
    },
    { type: "paragraph",html: "Una opción más ligera que puede probar antes de renombrar la carpeta completa: NinjaTrader tiene una herramienta de reparación integrada en <strong class='text-white'>Control Center &gt; Tools &gt; Database Management &gt; Repair DB</strong>. Desconéctese primero, ejecútela y compruebe si elimina la corrupción sin necesidad de reconstruir. No siempre soluciona un caso obstinado, pero no es destructiva, por lo que merece un intento rápido cuando prefiere no perder sus datos locales." },
    { type: "heading",text: "Si las cuentas siguen sin aparecer" },
    { type: "paragraph",html: "Una base de datos reconstruida soluciona la mayoría de los casos, pero si la cuadrícula sigue vacía después de reconectarse, el problema está en el lado de la conexión y no en la base de datos. Revise esta lista:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>El Account Type debe ser Simulation.</strong> Para las cuentas de prop firm basadas en Tradovate en NinjaTrader, el Account Type de la conexión se establece en Simulation, no en Live ni en NinjaTrader Brokerage. Un tipo incorrecto es una razón clásica por la que las cuentas nunca aparecen.",
        "<strong class='text-white'>Active el Multi-Provider Mode.</strong> Si utiliza más de una conexión, debe estar activado. Actívelo en <strong class='text-white'>Tools &gt; Options &gt; General &gt; Multi-Provider Mode</strong> y reinicie NinjaTrader.",
        "<strong class='text-white'>Compruebe las credenciales carácter por carácter.</strong> Un espacio suelto al principio o al final del nombre de usuario o de la contraseña impedirá que la cuenta se cargue. Vuelva a escribirlas a mano en lugar de pegarlas.",
        "<strong class='text-white'>Sincronice el reloj del sistema.</strong> Un reloj desajustado rompe silenciosamente las conexiones de Tradovate. Configure la hora de Windows para que se sincronice automáticamente y fuerce una sincronización.",
        "<strong class='text-white'>Confirme que la versión admite Tradovate.</strong> Las versiones antiguas de NinjaTrader no pueden conectarse a Tradovate en absoluto. Si utiliza una versión inicial, actualice la plataforma.",
      ],
    },
    { type: "paragraph",html: "¿Sigue atascado? Entregue las pruebas a NinjaTrader. Vaya a <strong class='text-white'>Control Center &gt; Help &gt; Email Support</strong>, asegúrese de que la casilla de archivos de registro y de traza esté marcada e incluya una captura de pantalla de la pestaña Accounts vacía. Esos archivos de traza les indican exactamente dónde falla la carga de la cuenta." },
    { type: "heading",text: "Cómo evitar que vuelva a ocurrir" },
    { type: "paragraph",html: "La corrupción de la base de datos en NinjaTrader suele provenir de bloqueos bruscos, cierres forzados y apagados interrumpidos, así que cierre la plataforma de forma limpia y deje que termine de escribir antes de apagar el equipo. El mejor hábito es hacer copias de seguridad con regularidad. Ejecute <strong class='text-white'>Tools &gt; Export &gt; Backup File</strong> de forma programada para que, la próxima vez que la base de datos se estropee, renombrar y reparar sea una molestia de cinco minutos en lugar de un día entero reconstruyendo su configuración." },
    { type: "paragraph",html: "Mientras ajusta la integración, conviene resolver los otros dos problemas habituales de usar Tradovate a través de NinjaTrader que suelen causar tropiezos: gráficos atascados con datos retrasados de 10 minutos y órdenes stop que no se actualizan a breakeven como usted espera. Ambos se solucionan rápido una vez que sabe dónde mirar." },
  ], fr: [
    { type: "paragraph",html: "Vous avez saisi vos identifiants Tradovate, NinjaTrader a indiqué que la connexion était établie, le petit voyant d'état est passé au vert, et pourtant l'onglet Accounts reste désespérément vide. Aucun numéro de compte à sélectionner, rien sur quoi trader, aucun moyen de passer un ordre. C'est l'un des états les plus exaspérants de NinjaTrader, car tout <em>semble</em> correct, sauf la seule chose dont vous avez réellement besoin." },
    { type: "paragraph",html: "En résumé : ce n'est presque jamais un problème de connexion et presque toujours un problème de base de données locale. NinjaTrader conserve vos comptes, ordres et paramètres dans un petit fichier de base de données sur votre propre machine. Lorsque ce fichier est corrompu ou désynchronisé, la connexion peut réussir alors que les comptes ne se chargent pas dans la grille. La solution consiste à forcer NinjaTrader à reconstruire cette base de données de zéro en renommant son dossier <code>db</code> en <code>OLDdb</code> et en réparant l'installation." },
    { type: "quote",html: "<strong class='text-white'>Solution rapide :</strong> fermez NinjaTrader, sauvegardez votre configuration, renommez <code>Documents\\NinjaTrader 8\\db</code> en <code>OLDdb</code>, réparez NinjaTrader depuis le Panneau de configuration de Windows, puis relancez-le et reconnectez-vous. Vos comptes Tradovate devraient alors s'afficher normalement sur une base de données propre." },
    { type: "heading",text: "Ce que vous observez réellement" },
    { type: "paragraph",html: "Un état « connecté mais vide » a une signature bien précise. L'indicateur de connexion du Control Center affiche Connected. Les messages du journal ne crient pas &ldquo;logon failed&rdquo;. Mais lorsque vous ouvrez l'onglet Accounts, ou que vous essayez de placer un ordre sur un graphique ou sur le SuperDOM, aucun compte n'apparaît dans la liste déroulante pour l'acheminer. Les autres connexions que vous utilisez peut-être, comme Rithmic, remplissent leurs comptes immédiatement, ce qui fait paraître le côté Tradovate encore plus défaillant en comparaison." },
    { type: "paragraph",html: "Si vous acheminez une évaluation de prop firm via NinjaTrader, le même symptôme apparaît lorsque le compte de la société n'apparaît jamais dans la liste alors que les identifiants se sont clairement authentifiés. Avant de reconstruire quoi que ce soit, écartez les deux causes banales : un compte tout neuf dont le provisionnement n'est pas terminé, et un mauvais Account Type sur la connexion. Une évaluation fraîchement achetée peut mettre un peu de temps à apparaître côté société ; accordez donc un peu de marge à un nouveau compte. Si un compte que vous tradez depuis des semaines cesse soudain d'apparaître, c'est votre base de données qui parle, et les étapes ci-dessous sont ce qu'il vous faut." },
    { type: "heading",text: "Pourquoi la connexion fonctionne alors que les comptes disparaissent" },
    { type: "paragraph",html: "NinjaTrader 8 stocke presque tout en local : vos comptes, votre historique d'ordres, vos instruments, vos modèles d'horaires de trading, vos espaces de travail. Ces données résident dans une base à l'intérieur de <code>Documents\\NinjaTrader 8\\db</code>. Lorsque vous vous connectez à Tradovate, NinjaTrader s'authentifie auprès des serveurs de Tradovate, récupère la liste des comptes et écrit ces lignes dans la base locale afin que l'onglet Accounts puisse les relire." },
    { type: "paragraph",html: "Chaque étape de cette chaîne peut réussir, sauf la dernière. Si la base locale est corrompue, comporte une table malformée ou contient des lignes périmées d'une ancienne session, les données du compte n'ont nulle part où se poser proprement. La connexion signale un succès car la poignée de main avec Tradovate a réellement fonctionné, mais la grille reste vide parce qu'elle lit dans un stockage défaillant. C'est pourquoi une simple reconnexion, une réinitialisation de mot de passe, voire un redémarrage de l'ordinateur ne changent généralement rien ici. Vous ne réparez pas ce qui est cassé. Ce qui est cassé, c'est la base de données ; c'est donc elle qu'il faut reconstruire." },
    { type: "paragraph",html: "C'est aussi pourquoi la solution est si fiable. Vous ne rapiécez pas la corruption : vous jetez tout le fichier et laissez NinjaTrader en générer un nouveau au prochain lancement." },
    { type: "heading",text: "Avant de toucher à quoi que ce soit : sauvegardez" },
    { type: "paragraph",html: "Renommer le dossier <code>db</code> est une réinitialisation propre, et une réinitialisation a un coût. Vous perdrez tout ce qui n'est stocké que dans cette base : horaires de trading personnalisés, listes d'instruments et instruments personnalisés, historique de trades stocké localement, résultats de backtest enregistrés du Strategy Analyzer et tout compte de simulation ajouté à la main. Rien de tout cela ne reviendra seul ; prenez donc deux minutes pour le protéger d'abord." },
    { type: "paragraph",html: "Ouvrez le Control Center de NinjaTrader, déconnectez-vous de toute connexion active, puis allez dans <strong class='text-white'>Tools &gt; Export &gt; Backup File</strong>. Cochez les éléments qui vous importent (Configuration, Database, Workspaces, NinjaScript files, Templates, Historical Data selon vos besoins) et enregistrez l'archive. Par défaut, elle est placée dans <code>Documents\\NinjaTrader 8 Backup</code> avec la date du jour comme nom de fichier." },
    { type: "paragraph",html: "Si la réparation se passe bien, vous n'aurez peut-être jamais besoin de cette archive. Mais s'il vous manque ensuite un espace de travail ou une liste d'instruments, vous pouvez restaurer sélectivement avec <strong class='text-white'>Tools &gt; Import &gt; Backup File</strong> plutôt que de tout reconstruire de mémoire." },
    { type: "heading",text: "La solution : renommer le dossier db et réparer NinjaTrader" },
    { type: "paragraph",html: "Suivez ces étapes dans l'ordre. L'ensemble prend environ dix minutes, dont la majeure partie est la réparation qui s'exécute toute seule." },
    {
      type: "steps",
      items: [
        { title: "Fermer complètement NinjaTrader", html: "Arrêtez entièrement NinjaTrader. Ne vous contentez pas de le réduire. Si vous n'êtes pas sûr qu'il soit vraiment fermé, vérifiez dans le Gestionnaire des tâches qu'aucun processus NinjaTrader n'est encore en cours. Le renommage ne fonctionnera pas tant que le fichier est verrouillé par une instance ouverte." },
        { title: "Renommer le dossier db en OLDdb", html: "Ouvrez l'Explorateur de fichiers et allez dans <code>Documents\\NinjaTrader 8</code>. Repérez le dossier nommé <code>db</code>, faites un clic droit dessus, choisissez <strong class='text-white'>Rename</strong> et remplacez son nom par <code>OLDdb</code>. Renommer plutôt que supprimer conserve les anciennes données sur le disque comme filet de sécurité au cas où vous auriez besoin d'y récupérer quelque chose plus tard." },
        { title: "Réparer l'installation de NinjaTrader", html: "Ouvrez <strong class='text-white'>Control Panel &gt; Programs and Features</strong> de Windows (Add or Remove Programs sur les versions récentes de Windows). Repérez <strong class='text-white'>NinjaTrader 8</strong> dans la liste, sélectionnez-le et cliquez sur <strong class='text-white'>Repair</strong> en haut de la liste des programmes. Laissez la réparation aller jusqu'au bout sans l'interrompre. Cette étape reconstruit les fichiers de la plateforme et, comme le dossier <code>db</code> d'origine a disparu, amène NinjaTrader à créer une base neuve et vide au prochain démarrage." },
        { title: "Relancer et se reconnecter à Tradovate", html: "Démarrez NinjaTrader 8. Il construira une nouvelle base au premier lancement ; laissez-lui donc un instant. Reconnectez-vous à votre compte Tradovate comme d'habitude. Avec une base propre en dessous, la liste des comptes devrait se remplir et vos comptes devraient enfin apparaître dans l'onglet Accounts, prêts à trader." },
      ],
    },
    { type: "paragraph",html: "Une option plus légère à essayer avant le renommage complet du dossier : NinjaTrader dispose d'un outil de réparation intégré dans <strong class='text-white'>Control Center &gt; Tools &gt; Database Management &gt; Repair DB</strong>. Déconnectez-vous d'abord, lancez-le et voyez s'il élimine la corruption sans reconstruction. Il ne règle pas toujours un cas tenace, mais il n'est pas destructif ; il vaut donc un essai rapide si vous préférez ne pas perdre vos données locales." },
    { type: "heading",text: "Si les comptes n'apparaissent toujours pas" },
    { type: "paragraph",html: "Une base reconstruite règle la plupart des cas, mais si la grille reste vide après la reconnexion, le problème se situe du côté de la connexion et non de la base. Passez cette liste en revue :" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>L'Account Type doit être Simulation.</strong> Pour les comptes de prop firm basés sur Tradovate dans NinjaTrader, l'Account Type de la connexion est réglé sur Simulation, et non sur Live ni sur NinjaTrader Brokerage. Un mauvais type est une raison classique pour laquelle les comptes n'apparaissent jamais.",
        "<strong class='text-white'>Activer le Multi-Provider Mode.</strong> Si vous utilisez plusieurs connexions, il doit être activé. Activez-le dans <strong class='text-white'>Tools &gt; Options &gt; General &gt; Multi-Provider Mode</strong>, puis redémarrez NinjaTrader.",
        "<strong class='text-white'>Vérifier les identifiants caractère par caractère.</strong> Un espace parasite au début ou à la fin du nom d'utilisateur ou du mot de passe empêche le compte de se charger. Retapez-les à la main plutôt que de les coller.",
        "<strong class='text-white'>Synchroniser l'horloge du système.</strong> Une horloge qui dérive perturbe discrètement les connexions Tradovate. Réglez l'heure de Windows sur la synchronisation automatique et forcez une synchronisation.",
        "<strong class='text-white'>Confirmer que la version prend en charge Tradovate.</strong> Les anciennes versions de NinjaTrader ne peuvent pas du tout se connecter à Tradovate. Si vous utilisez une version ancienne, mettez la plateforme à jour.",
      ],
    },
    { type: "paragraph",html: "Toujours bloqué ? Fournissez les preuves à NinjaTrader. Allez dans <strong class='text-white'>Control Center &gt; Help &gt; Email Support</strong>, vérifiez que la case des fichiers de log et de trace est cochée et joignez une capture d'écran de l'onglet Accounts vide. Ces fichiers de trace leur indiquent précisément à quel endroit le chargement du compte échoue." },
    { type: "heading",text: "Comment éviter que cela se reproduise" },
    { type: "paragraph",html: "La corruption de la base de données dans NinjaTrader provient généralement de plantages brutaux, de fermetures forcées et d'arrêts interrompus ; fermez donc la plateforme proprement et laissez-la terminer l'écriture avant d'éteindre. La meilleure habitude reste la sauvegarde régulière. Exécutez <strong class='text-white'>Tools &gt; Export &gt; Backup File</strong> selon un calendrier, afin que, la prochaine fois que la base déraille, le renommage et la réparation soient un désagrément de cinq minutes plutôt qu'une journée passée à reconstruire votre configuration." },
    { type: "paragraph",html: "Pendant que vous peaufinez l'intégration, il vaut la peine de régler les deux autres pièges de Tradovate via NinjaTrader qui font trébucher : des graphiques bloqués sur des données différées de 10 minutes, et des ordres stop qui ne se mettent pas à jour au breakeven comme vous l'attendez. Les deux se corrigent vite une fois que vous savez où regarder." },
  ], it: [
    { type: "paragraph",html: "Ha inserito le Sue credenziali Tradovate, NinjaTrader ha detto che la connessione è riuscita, la piccola spia di stato è diventata verde, eppure la scheda Accounts resta vuota. Nessun numero di conto da selezionare, nulla su cui operare, nessun modo di inviare un ordine. È uno degli stati più esasperanti di NinjaTrader perché tutto <em>sembra</em> a posto tranne l'unica cosa di cui ha davvero bisogno." },
    { type: "paragraph",html: "La versione breve: non è quasi mai un problema di login ed è quasi sempre un problema del database locale. NinjaTrader conserva i Suoi account, ordini e impostazioni in un piccolo file di database sul Suo computer. Quando quel file si corrompe o va fuori sincronia, la connessione può riuscire mentre gli account non vengono caricati nella griglia. La soluzione è costringere NinjaTrader a ricostruire quel database da zero rinominando la sua cartella <code>db</code> in <code>OLDdb</code> e riparando l'installazione." },
    { type: "quote",html: "<strong class='text-white'>Soluzione rapida:</strong> chiuda NinjaTrader, faccia un backup della Sua configurazione, rinomini <code>Documents\\NinjaTrader 8\\db</code> in <code>OLDdb</code>, ripari NinjaTrader dal Pannello di controllo di Windows, quindi lo riavvii e si riconnetta. I Suoi account Tradovate dovrebbero comparire normalmente su un database pulito." },
    { type: "heading",text: "Cosa sta realmente vedendo" },
    { type: "paragraph",html: "Uno stato di connesso ma vuoto ha una firma ben precisa. L'indicatore di connessione nel Control Center mostra Connected. I messaggi di log non gridano &ldquo;logon failed&rdquo;. Ma quando apre la scheda Accounts, o prova a inserire un ordine su un grafico o sul SuperDOM, non c'è alcun account nel menu a tendina a cui instradarlo. Altre connessioni che potrebbe usare, come Rithmic, popolano subito i propri account, il che fa sembrare ancora più guasto il lato Tradovate al confronto." },
    { type: "paragraph",html: "Se instrada una valutazione di una prop firm tramite NinjaTrader, lo stesso sintomo si presenta quando l'account della società non compare mai nell'elenco anche se le credenziali si sono chiaramente autenticate. Prima di ricostruire qualsiasi cosa, escluda le due cause banali: un account nuovo di cui il provisioning non è ancora terminato e un Account Type sbagliato nella connessione. Una valutazione appena acquistata può impiegare un po' di tempo per comparire lato società, quindi lasci un po' di respiro a un account nuovo. Se un account che opera da settimane smette improvvisamente di comparire, a parlare è il Suo database, e i passaggi seguenti sono ciò che Le serve." },
    { type: "heading",text: "Perché la connessione funziona ma gli account spariscono" },
    { type: "paragraph",html: "NinjaTrader 8 memorizza quasi tutto in locale: i Suoi account, lo storico degli ordini, gli strumenti, i modelli di orari di trading, i workspace. Quei dati risiedono in un database all'interno di <code>Documents\\NinjaTrader 8\\db</code>. Quando si connette a Tradovate, NinjaTrader si autentica sui server di Tradovate, scarica l'elenco degli account e scrive quelle righe nel database locale in modo che la scheda Accounts possa rileggerle." },
    { type: "paragraph",html: "Ogni passaggio di quella catena può riuscire tranne l'ultimo. Se il database locale è corrotto, ha una tabella malformata o contiene righe obsolete di una vecchia sessione, i dati dell'account non hanno un posto pulito in cui atterrare. La connessione segnala successo perché l'handshake con Tradovate ha davvero funzionato, ma la griglia resta vuota perché legge da un archivio danneggiato. Ecco perché una semplice riconnessione, un reset della password o persino un riavvio del computer di solito non cambiano nulla. Non sta riparando ciò che è rotto. Ciò che è rotto è il database, quindi è il database che va ricostruito." },
    { type: "paragraph",html: "È anche per questo che la soluzione è così affidabile. Non sta rattoppando la corruzione: sta buttando via l'intero file e lasciando che NinjaTrader ne generi uno nuovo al prossimo avvio." },
    { type: "heading",text: "Prima di toccare qualsiasi cosa: faccia un backup" },
    { type: "paragraph",html: "Rinominare la cartella <code>db</code> è un reset pulito, e un reset ha un costo. Perderà tutto ciò che è memorizzato solo in quel database: orari di trading personalizzati, elenchi di strumenti e strumenti personalizzati, storico dei trade memorizzato localmente, risultati dei backtest salvati dello Strategy Analyzer e qualsiasi account di simulazione aggiunto a mano. Nulla di tutto ciò tornerà da solo, quindi dedichi prima due minuti a proteggerlo." },
    { type: "paragraph",html: "Apra il Control Center di NinjaTrader, si disconnetta da qualsiasi connessione attiva e vada su <strong class='text-white'>Tools &gt; Export &gt; Backup File</strong>. Spunti gli elementi che Le interessano (Configuration, Database, Workspaces, NinjaScript files, Templates, Historical Data secondo necessità) e salvi l'archivio. Per impostazione predefinita viene salvato in <code>Documents\\NinjaTrader 8 Backup</code> con la data odierna come nome del file." },
    { type: "paragraph",html: "Se la riparazione procede senza intoppi, potrebbe non aver mai bisogno di questo archivio. Ma se in seguito Le dovesse mancare un workspace o un elenco di strumenti, può ripristinare in modo selettivo con <strong class='text-white'>Tools &gt; Import &gt; Backup File</strong> invece di ricostruire tutto a memoria." },
    { type: "heading",text: "La soluzione: rinominare la cartella db e riparare NinjaTrader" },
    { type: "paragraph",html: "Segua questi passaggi in ordine. L'intera operazione richiede circa dieci minuti, la maggior parte dei quali è la riparazione che procede da sola." },
    {
      type: "steps",
      items: [
        { title: "Chiuda completamente NinjaTrader", html: "Chiuda del tutto NinjaTrader. Non si limiti a ridurlo a icona. Se non è sicuro che sia davvero chiuso, verifichi in Task Manager che non ci sia più alcun processo NinjaTrader in esecuzione. La ridenominazione non funziona finché il file è bloccato da un'istanza aperta." },
        { title: "Rinomini la cartella db in OLDdb", html: "Apra Esplora file e vada su <code>Documents\\NinjaTrader 8</code>. Individui la cartella chiamata <code>db</code>, faccia clic con il pulsante destro, scelga <strong class='text-white'>Rename</strong> e la rinomini in <code>OLDdb</code>. Rinominare invece di eliminare mantiene i vecchi dati sul disco come rete di sicurezza, nel caso in seguito dovesse recuperare qualcosa da essi." },
        { title: "Ripari l'installazione di NinjaTrader", html: "Apra <strong class='text-white'>Control Panel &gt; Programs and Features</strong> di Windows (Add or Remove Programs nelle versioni più recenti di Windows). Trovi <strong class='text-white'>NinjaTrader 8</strong> nell'elenco, lo selezioni e faccia clic su <strong class='text-white'>Repair</strong> nella parte superiore dell'elenco dei programmi. Lasci che la riparazione venga completata senza interromperla. Questo passaggio ricostruisce i file della piattaforma e, poiché la cartella <code>db</code> originale non c'è più, induce NinjaTrader a creare un database nuovo e vuoto al successivo avvio." },
        { title: "Riavvii e si riconnetta a Tradovate", html: "Avvii NinjaTrader 8. Costruirà un nuovo database al primo avvio, quindi gli conceda un momento. Si riconnetta al Suo account Tradovate come fa di solito. Con un database pulito alla base, l'elenco degli account dovrebbe popolarsi e i Suoi account dovrebbero finalmente comparire nella scheda Accounts, pronti per operare." },
      ],
    },
    { type: "paragraph",html: "Un'opzione più leggera da provare prima di rinominare l'intera cartella: NinjaTrader dispone di uno strumento di riparazione integrato in <strong class='text-white'>Control Center &gt; Tools &gt; Database Management &gt; Repair DB</strong>. Si disconnetta prima, lo esegua e verifichi se elimina la corruzione senza una ricostruzione. Non sempre risolve un caso ostinato, ma non è distruttivo, quindi vale un rapido tentativo quando preferisce non perdere i Suoi dati locali." },
    { type: "heading",text: "Se gli account continuano a non comparire" },
    { type: "paragraph",html: "Un database ricostruito risolve la maggior parte dei casi, ma se la griglia è ancora vuota dopo la riconnessione, il problema è sul lato della connessione e non del database. Verifichi questo elenco:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>L'Account Type deve essere Simulation.</strong> Per gli account di prop firm basati su Tradovate in NinjaTrader, l'Account Type della connessione è impostato su Simulation, non su Live né su NinjaTrader Brokerage. Il tipo sbagliato è un motivo classico per cui gli account non compaiono mai.",
        "<strong class='text-white'>Attivi il Multi-Provider Mode.</strong> Se usa più di una connessione, deve essere attivo. Lo attivi in <strong class='text-white'>Tools &gt; Options &gt; General &gt; Multi-Provider Mode</strong>, quindi riavvii NinjaTrader.",
        "<strong class='text-white'>Controlli le credenziali carattere per carattere.</strong> Uno spazio vagante all'inizio o alla fine del nome utente o della password impedisce il caricamento dell'account. Le digiti di nuovo a mano invece di incollarle.",
        "<strong class='text-white'>Sincronizzi l'orologio di sistema.</strong> Un orologio che va alla deriva compromette silenziosamente le connessioni Tradovate. Imposti l'ora di Windows sulla sincronizzazione automatica e forzi una sincronizzazione.",
        "<strong class='text-white'>Confermi che la versione supporti Tradovate.</strong> Le versioni più vecchie di NinjaTrader non possono connettersi affatto a Tradovate. Se usa una versione iniziale, aggiorni la piattaforma.",
      ],
    },
    { type: "paragraph",html: "Ancora bloccato? Fornisca le prove a NinjaTrader. Vada su <strong class='text-white'>Control Center &gt; Help &gt; Email Support</strong>, si assicuri che la casella dei file di log e di trace sia spuntata e includa uno screenshot della scheda Accounts vuota. Quei file di trace indicano esattamente dove fallisce il caricamento dell'account." },
    { type: "heading",text: "Come evitare che accada di nuovo" },
    { type: "paragraph",html: "La corruzione del database in NinjaTrader deriva in genere da crash improvvisi, chiusure forzate e arresti interrotti, quindi chiuda la piattaforma in modo pulito e la lasci terminare la scrittura prima di spegnere. L'abitudine migliore è un backup regolare. Esegua <strong class='text-white'>Tools &gt; Export &gt; Backup File</strong> secondo una pianificazione, in modo che la prossima volta che il database va in tilt, rinominare e riparare sia un fastidio di cinque minuti invece di un giorno speso a ricostruire la Sua configurazione." },
    { type: "paragraph",html: "Mentre perfeziona l'integrazione, vale la pena risolvere anche gli altri due inconvenienti di Tradovate tramite NinjaTrader che fanno inciampare: grafici bloccati su dati ritardati di 10 minuti e ordini stop che non si aggiornano al breakeven come si aspetta. Entrambi si sistemano in fretta una volta che sa dove guardare." },
  ] },
  ctaHeading: { en: "Stop Babysitting Local Databases", de: "Schluss mit der Pflege lokaler Datenbanken", es: "Deje de ocuparse de bases de datos locales", fr: "Cessez de materner des bases de données locales", it: "Smetta di accudire database locali" },
  ctaText: { en: "If NinjaTrader's local database keeps corrupting on you, PickMyTrade routes your TradingView alerts straight to your Tradovate or prop account with no desktop database to rot in the background.", de: "Wenn die lokale Datenbank von NinjaTrader immer wieder beschädigt wird, leitet PickMyTrade Ihre TradingView-Alerts direkt an Ihr Tradovate- oder Prop-Konto weiter, ganz ohne eine Desktop-Datenbank, die im Hintergrund verrottet.", es: "Si la base de datos local de NinjaTrader se corrompe una y otra vez, PickMyTrade envía sus alertas de TradingView directamente a su cuenta de Tradovate o de prop firm, sin ninguna base de datos de escritorio que se deteriore en segundo plano.", fr: "Si la base de données locale de NinjaTrader se corrompt sans cesse, PickMyTrade achemine vos alertes TradingView directement vers votre compte Tradovate ou prop firm, sans base de données de bureau qui se dégrade en arrière-plan.", it: "Se il database locale di NinjaTrader continua a corrompersi, PickMyTrade instrada i Suoi alert di TradingView direttamente al Suo account Tradovate o prop, senza alcun database desktop che si deteriori in background." },
  ctaButtonText: { en: "Start Your Free 7-Day Trial", de: "Starten Sie Ihre kostenlose 7-Tage-Testphase", es: "Comience su prueba gratuita de 7 días", fr: "Commencez votre essai gratuit de 7 jours", it: "Inizi la prova gratuita di 7 giorni" },
  ctaUrl: "https://app.pickmytrade.trade/?register=true&utm_source=content&utm_medium=debugging",
  faqHeading: { en: "Frequently Asked Questions", de: "Häufig gestellte Fragen", es: "Preguntas frecuentes", fr: "Questions fréquentes", it: "Domande frequenti" },
  faqs: { en: [
    { q: "Why do my Tradovate accounts connect but not show up in the NinjaTrader Accounts tab?", a: "The connection itself is fine, but NinjaTrader stores your accounts in a local SQLite database on your PC. When that database gets corrupted or out of sync, the login succeeds while the account rows never render in the Accounts tab. Renaming the db folder to OLDdb and repairing the install forces NinjaTrader to build a fresh database, which usually fixes it." },
    { q: "Will renaming the db folder delete my trades and settings?", a: "Yes. Renaming or deleting the db folder wipes your custom trading hours, instrument lists, locally stored trade history, saved backtest results, and any locally added simulation accounts. Create a NinjaTrader backup file first (Tools > Export > Backup File) so you can restore what you need afterward." },
    { q: "How long should Tradovate accounts take to appear in NinjaTrader?", a: "In most cases they show up in the Accounts tab within seconds of a successful connection. A brand-new prop evaluation can lag while the firm finishes provisioning it, so give a fresh account some time before assuming anything is broken. If an established account never lists, that points to a local database problem rather than a delay." },
    { q: "Do I need to reinstall NinjaTrader to fix this?", a: "No. A full reinstall is not required. Renaming the db folder and running the Repair option from Windows Control Panel > Programs and Features rebuilds the platform files and generates a clean database. Reinstalling is only a last resort if the repair does not resolve it." },
    { q: "The accounts still don't show after the repair. What now?", a: "Double-check that the connection Account Type is set to Simulation for Tradovate-based prop accounts, that Multi-Provider Mode is enabled, and that your username and password contain no leading or trailing spaces. Sync your system clock as well. If it still fails, send NinjaTrader your log and trace files through Control Center > Help > Email Support." },
  ], de: [
    { q: "Warum verbinden sich meine Tradovate-Konten, erscheinen aber nicht im NinjaTrader-Tab „Accounts“?", a: "Die Verbindung selbst ist in Ordnung, aber NinjaTrader speichert Ihre Konten in einer lokalen SQLite-Datenbank auf Ihrem PC. Wenn diese Datenbank beschädigt oder nicht synchron ist, gelingt die Anmeldung, doch die Kontenzeilen werden im Tab „Accounts“ nie angezeigt. Wenn Sie den Ordner db in OLDdb umbenennen und die Installation reparieren, erstellt NinjaTrader eine frische Datenbank, was das Problem in der Regel behebt." },
    { q: "Löscht das Umbenennen des Ordners db meine Trades und Einstellungen?", a: "Ja. Wenn Sie den Ordner db umbenennen oder löschen, gehen Ihre benutzerdefinierten Handelszeiten, Instrumentenlisten, lokal gespeicherte Handelshistorie, gespeicherte Backtest-Ergebnisse und alle lokal hinzugefügten Simulationskonten verloren. Erstellen Sie zuerst eine NinjaTrader-Sicherungsdatei (Tools > Export > Backup File), damit Sie anschließend wiederherstellen können, was Sie benötigen." },
    { q: "Wie lange sollte es dauern, bis Tradovate-Konten in NinjaTrader erscheinen?", a: "In den meisten Fällen erscheinen sie wenige Sekunden nach einer erfolgreichen Verbindung im Tab „Accounts“. Eine brandneue Prop-Evaluierung kann sich verzögern, während die Firma sie noch bereitstellt. Geben Sie einem frischen Konto daher etwas Zeit, bevor Sie von einem Defekt ausgehen. Wenn ein bereits bestehendes Konto nie aufgelistet wird, deutet das auf ein Problem mit der lokalen Datenbank statt auf eine Verzögerung hin." },
    { q: "Muss ich NinjaTrader neu installieren, um das zu beheben?", a: "Nein. Eine vollständige Neuinstallation ist nicht erforderlich. Wenn Sie den Ordner db umbenennen und die Option Repair in der Windows-Systemsteuerung unter Programme und Features ausführen, werden die Plattformdateien neu aufgebaut und eine saubere Datenbank erzeugt. Eine Neuinstallation ist nur der letzte Ausweg, falls die Reparatur das Problem nicht löst." },
    { q: "Die Konten erscheinen nach der Reparatur immer noch nicht. Was nun?", a: "Prüfen Sie noch einmal, ob der Account Type der Verbindung für Tradovate-basierte Prop-Konten auf Simulation gesetzt ist, ob der Multi-Provider Mode aktiviert ist und ob Ihr Benutzername und Ihr Passwort keine führenden oder nachgestellten Leerzeichen enthalten. Synchronisieren Sie außerdem Ihre Systemuhr. Wenn es weiterhin nicht klappt, senden Sie NinjaTrader Ihre Log- und Trace-Dateien über Control Center > Help > Email Support." },
  ], es: [
    { q: "¿Por qué mis cuentas de Tradovate se conectan pero no aparecen en la pestaña Accounts de NinjaTrader?", a: "La conexión en sí es correcta, pero NinjaTrader guarda sus cuentas en una base de datos SQLite local en su PC. Cuando esa base de datos se corrompe o pierde la sincronización, el inicio de sesión funciona, pero las filas de las cuentas nunca se muestran en la pestaña Accounts. Al renombrar la carpeta db a OLDdb y reparar la instalación, NinjaTrader crea una base de datos nueva, lo que normalmente lo soluciona." },
    { q: "¿Renombrar la carpeta db borrará mis operaciones y mi configuración?", a: "Sí. Renombrar o eliminar la carpeta db borra sus horarios de trading personalizados, listas de instrumentos, historial de operaciones almacenado localmente, resultados de backtest guardados y cualquier cuenta de simulación añadida localmente. Cree primero un archivo de copia de seguridad de NinjaTrader (Tools > Export > Backup File) para poder restaurar después lo que necesite." },
    { q: "¿Cuánto debería tardar en aparecer una cuenta de Tradovate en NinjaTrader?", a: "En la mayoría de los casos aparecen en la pestaña Accounts a los pocos segundos de una conexión correcta. Una evaluación de prop firm recién creada puede tardar mientras la firma termina de aprovisionarla, así que dé algo de tiempo a una cuenta nueva antes de suponer que algo falla. Si una cuenta ya existente nunca aparece, eso apunta a un problema de la base de datos local y no a un retraso." },
    { q: "¿Necesito reinstalar NinjaTrader para solucionarlo?", a: "No. No hace falta una reinstalación completa. Renombrar la carpeta db y ejecutar la opción Repair desde el Panel de control de Windows > Programas y características reconstruye los archivos de la plataforma y genera una base de datos limpia. Reinstalar es solo el último recurso si la reparación no lo resuelve." },
    { q: "Las cuentas siguen sin aparecer tras la reparación. ¿Qué hago?", a: "Compruebe de nuevo que el Account Type de la conexión esté en Simulation para las cuentas de prop firm basadas en Tradovate, que el Multi-Provider Mode esté activado y que su nombre de usuario y contraseña no contengan espacios al principio ni al final. Sincronice también el reloj del sistema. Si sigue fallando, envíe a NinjaTrader sus archivos de registro y de traza mediante Control Center > Help > Email Support." },
  ], fr: [
    { q: "Pourquoi mes comptes Tradovate se connectent-ils sans apparaître dans l'onglet Accounts de NinjaTrader ?", a: "La connexion elle-même est correcte, mais NinjaTrader stocke vos comptes dans une base de données SQLite locale sur votre PC. Lorsque cette base est corrompue ou désynchronisée, la connexion réussit alors que les lignes de comptes ne s'affichent jamais dans l'onglet Accounts. Renommer le dossier db en OLDdb et réparer l'installation oblige NinjaTrader à créer une nouvelle base, ce qui règle généralement le problème." },
    { q: "Renommer le dossier db supprimera-t-il mes trades et mes paramètres ?", a: "Oui. Renommer ou supprimer le dossier db efface vos horaires de trading personnalisés, vos listes d'instruments, l'historique des trades stocké localement, les résultats de backtest enregistrés et tous les comptes de simulation ajoutés localement. Créez d'abord un fichier de sauvegarde NinjaTrader (Tools > Export > Backup File) afin de pouvoir restaurer ensuite ce dont vous avez besoin." },
    { q: "Combien de temps les comptes Tradovate doivent-ils mettre à apparaître dans NinjaTrader ?", a: "Dans la plupart des cas, ils apparaissent dans l'onglet Accounts quelques secondes après une connexion réussie. Une toute nouvelle évaluation prop peut prendre du retard pendant que la société termine son provisionnement ; accordez donc un peu de temps à un compte récent avant de conclure à une panne. Si un compte ancien n'apparaît jamais, cela indique un problème de base de données locale plutôt qu'un délai." },
    { q: "Dois-je réinstaller NinjaTrader pour corriger cela ?", a: "Non. Une réinstallation complète n'est pas nécessaire. Renommer le dossier db et lancer l'option Repair depuis le Panneau de configuration de Windows > Programmes et fonctionnalités reconstruit les fichiers de la plateforme et génère une base propre. La réinstallation n'est qu'un dernier recours si la réparation ne résout pas le problème." },
    { q: "Les comptes n'apparaissent toujours pas après la réparation. Que faire ?", a: "Vérifiez à nouveau que l'Account Type de la connexion est réglé sur Simulation pour les comptes prop basés sur Tradovate, que le Multi-Provider Mode est activé et que votre nom d'utilisateur et votre mot de passe ne contiennent aucun espace au début ou à la fin. Synchronisez aussi l'horloge de votre système. Si cela échoue encore, envoyez vos fichiers de log et de trace à NinjaTrader via Control Center > Help > Email Support." },
  ], it: [
    { q: "Perché i miei account Tradovate si connettono ma non compaiono nella scheda Accounts di NinjaTrader?", a: "La connessione in sé è corretta, ma NinjaTrader memorizza i Suoi account in un database SQLite locale sul Suo PC. Quando quel database è corrotto o fuori sincronia, il login riesce ma le righe degli account non vengono mai visualizzate nella scheda Accounts. Rinominare la cartella db in OLDdb e riparare l'installazione costringe NinjaTrader a creare un database nuovo, il che di solito risolve il problema." },
    { q: "Rinominare la cartella db cancellerà i miei trade e le mie impostazioni?", a: "Sì. Rinominare o eliminare la cartella db cancella gli orari di trading personalizzati, gli elenchi di strumenti, lo storico dei trade memorizzato localmente, i risultati dei backtest salvati e tutti gli account di simulazione aggiunti localmente. Crei prima un file di backup di NinjaTrader (Tools > Export > Backup File) per poter ripristinare in seguito ciò che Le serve." },
    { q: "Quanto tempo devono impiegare gli account Tradovate per comparire in NinjaTrader?", a: "Nella maggior parte dei casi compaiono nella scheda Accounts entro pochi secondi da una connessione riuscita. Una nuova valutazione prop può subire ritardi mentre la società ne completa il provisioning, quindi conceda un po' di tempo a un account appena creato prima di ritenere che qualcosa non funzioni. Se un account già esistente non compare mai, ciò indica un problema del database locale e non un ritardo." },
    { q: "Devo reinstallare NinjaTrader per risolvere il problema?", a: "No. Non è necessaria una reinstallazione completa. Rinominare la cartella db ed eseguire l'opzione Repair da Pannello di controllo di Windows > Programmi e funzionalità ricostruisce i file della piattaforma e genera un database pulito. La reinstallazione è solo l'ultima risorsa se la riparazione non risolve il problema." },
    { q: "Gli account continuano a non comparire dopo la riparazione. E ora?", a: "Verifichi di nuovo che l'Account Type della connessione sia impostato su Simulation per gli account prop basati su Tradovate, che il Multi-Provider Mode sia attivato e che nome utente e password non contengano spazi iniziali o finali. Sincronizzi anche l'orologio di sistema. Se continua a non funzionare, invii a NinjaTrader i file di log e di trace tramite Control Center > Help > Email Support." },
  ] },
  relatedHeading: { en: "Related Guides", de: "Weiterführende Anleitungen", es: "Guías relacionadas", fr: "Guides associés", it: "Guide correlate" },
