---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "ninjatrader-no-accounts-found";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/debugging/${SLUG}`;

const META_TITLE = "NinjaTrader 'No Accounts Found' for Tradovate Eval";
const META_DESCRIPTION =
  "NinjaTrader says no accounts found with a Tradovate eval? Set the connection Account Type to Simulation, not Live, so your evaluation account appears.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "NinjaTrader „No Accounts Found“ bei Tradovate-Eval", es: "NinjaTrader «No Accounts Found» para una evaluación de Tradovate", fr: "NinjaTrader « No Accounts Found » pour une évaluation Tradovate", it: "NinjaTrader «No Accounts Found» per una valutazione Tradovate" },
  dek: { en: "The login worked, the connection went through, and the Accounts tab is still empty. Almost every time, it comes down to one setting: the Account Type you chose doesn't match the environment your evaluation actually lives on.", de: "Der Login hat funktioniert, die Verbindung steht, und der Reiter „Accounts“ ist trotzdem leer. Fast immer liegt es an einer einzigen Einstellung: Der gewählte Account Type passt nicht zur Umgebung, in der Ihre Evaluation tatsächlich liegt.", es: "El inicio de sesión funcionó, la conexión se estableció y la pestaña Accounts sigue vacía. Casi siempre se reduce a un solo ajuste: el Account Type que eligió no coincide con el entorno en el que realmente vive su evaluación.", fr: "La connexion a fonctionné, le lien est établi, et l'onglet Accounts reste vide. Presque à chaque fois, tout tient à un seul réglage : l'Account Type que vous avez choisi ne correspond pas à l'environnement sur lequel votre évaluation se trouve réellement.", it: "Il login ha funzionato, la connessione è stata stabilita, eppure la scheda Accounts resta vuota. Quasi sempre tutto dipende da un'unica impostazione: l'Account Type che ha scelto non corrisponde all'ambiente in cui si trova realmente la Sua valutazione." },
  readTime: { en: "7 min read", de: "7 Min. Lesezeit", es: "Lectura de 7 min", fr: "Lecture : 7 min", it: "Lettura di 7 min" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "You type in your Tradovate username and password, NinjaTrader connects without complaint, and then&hellip; nothing. The Accounts tab sits empty, or you get a flat <strong class='text-white'>“No accounts were found for this account type.”</strong> The credentials clearly worked, because you cleared the login step, so where did your evaluation account go? Almost every time, it comes down to one setting: the <strong class='text-white'>Account Type</strong> you chose in the NinjaTrader connection doesn't match the environment your account actually lives on. A Tradovate prop-firm evaluation runs on Tradovate's <strong class='text-white'>simulation</strong> engine, so the connection has to be set to <strong class='text-white'>Simulation</strong>, not <strong class='text-white'>Live</strong>. Pick Live and NinjaTrader goes hunting for your account in the real-brokerage world, finds none tied to those credentials, and reports zero accounts. Below I'll break down what the message really means, the handful of things that trigger it, and the exact steps to get your eval showing in the Accounts tab, plus how routing your alerts through automation keeps a fiddly desktop connection from standing between you and your fills." },
    {
      type: "checklist",
      heading: "Quick Checklist for the No-Accounts-Found Error",
      items: [
        "<strong class='text-white'>Set the Account Type to Simulation</strong> for any prop-firm or evaluation account, that's where these accounts live on Tradovate.",
        "<strong class='text-white'>Use the Tradovate credentials your firm issued</strong>, not your NinjaTrader Account Dashboard email and password.",
        "<strong class='text-white'>Enable Multi-provider</strong> (Tools &gt; Options/Settings &gt; General) and restart NinjaTrader if you're running more than one connection.",
        "<strong class='text-white'>One Account Type per connection</strong>, if you need both Live and Simulation, create a separate connection for each.",
        "<strong class='text-white'>Give a new evaluation time to provision</strong>, a freshly purchased account may not appear the instant you connect.",
        "<strong class='text-white'>Confirm you're on build 8.1.2.1 or later</strong>, NinjaTrader 8.0 can't connect to Tradovate in the first place.",
      ],
    },
    { type: "heading", text: "What “No Accounts Were Found for This Account Type” Means" },
    { type: "paragraph", html: "This message trips people up because the login itself went through. NinjaTrader handed your credentials to Tradovate, Tradovate accepted them, and a session opened. The word “found” is the tell: NinjaTrader connected fine, then asked Tradovate for the accounts that belong to you <em>in the environment you selected</em>, and got an empty list back." },
    { type: "paragraph", html: "Tradovate runs two separate worlds. There's a <strong class='text-white'>Live</strong> environment for real, directly funded brokerage accounts, and a <strong class='text-white'>Simulation</strong> environment where every paper-trading and prop-firm evaluation account lives. When your prop firm sets you up, your evaluation is created in the simulation world. The credentials they gave you only resolve to an account there. So if you leave the NinjaTrader connection on the Live Account Type, NinjaTrader queries the real-brokerage side, sees no accounts attached to that login, and shows “no accounts found.” Same credentials, wrong neighborhood." },
    { type: "paragraph", html: "Seeing the word “Simulation” attached to a funded-looking evaluation throws some traders off, but that's expected and correct. A prop evaluation is a simulated account with real rules and real payouts riding on it. It still connects through the simulation environment, and picking Simulation in NinjaTrader is exactly right." },
    { type: "heading", text: "Top Causes of the Empty Accounts Tab" },
    { type: "heading", text: "1. You picked the wrong Account Type (Live instead of Simulation)" },
    { type: "paragraph", html: "This is the number-one cause. The connection setup gives you an Account Type choice, and Live is easy to select by reflex, since a funded evaluation <em>feels</em> like it should be Live. But your evaluation credentials don't exist in the Live environment, so NinjaTrader can't find a single account and reports none. For a directly funded personal Tradovate account with your own money, Live is correct; for a prop evaluation, it isn't." },
    { type: "heading", text: "2. You're using the wrong credentials" },
    { type: "paragraph", html: "Prop-firm Tradovate logins are separate from your NinjaTrader Account Dashboard login. The dashboard email and password get you into NinjaTrader itself; the Tradovate platform credentials your firm sends you (often in a data-credentials message) are what the Tradovate connection needs. Enter the dashboard email where NinjaTrader expects the Tradovate login and, depending on the flow, you'll either fail to authenticate or connect to an environment with none of your accounts in it." },
    { type: "heading", text: "3. Multi-provider isn't enabled" },
    { type: "paragraph", html: "NinjaTrader ships with its own built-in simulator connection. To run a second connection alongside it, or to run several prop accounts at once, you have to turn on Multi-provider first. Skip that step and NinjaTrader may not let the Tradovate connection stand up properly, which shows as accounts that never populate. Each connection also handles a single Account Type, so a Live connection and a Simulation connection are two different entries." },
    { type: "heading", text: "4. The evaluation isn't activated or provisioned yet" },
    { type: "paragraph", html: "If the environment and credentials are right and the tab is still empty, the account may not be fully live on the firm's side. Provisioning can lag behind your purchase, and until the firm's system finishes creating and enabling the account, there's nothing for NinjaTrader to list. Some accounts also need you to sign in to the Tradovate web trader once and accept the data agreements before they'll surface in third-party software." },
    { type: "heading", text: "5. NinjaTrader 8.0 can't connect at all" },
    { type: "paragraph", html: "Older installs are a trap. NinjaTrader 8.0 predates Tradovate support and won't connect to a Tradovate account, so you can't even get to the account-listing stage. You need build <strong class='text-white'>8.1.2.1 or later</strong>. If you're not sure what you're running, this is worth checking before you spend time on Account Type settings." },
    { type: "heading", text: "How to Fix It: Step-by-Step" },
    { type: "heading", text: "Fix 1: Set the connection Account Type to Simulation" },
    { type: "paragraph", html: "<ol><li>Open the NinjaTrader <strong class='text-white'>Control Center</strong>, then go to <strong class='text-white'>Connections &gt; Configure</strong>.</li><li>Add a new connection or select your existing Tradovate connection to edit it.</li><li>Enter the <strong class='text-white'>Tradovate username and password your prop firm issued</strong> for the platform, not your NinjaTrader dashboard email.</li><li>Find the <strong class='text-white'>Account Type</strong> selector and set it to <strong class='text-white'>Simulation</strong> for a prop-firm or evaluation account. (Choose Live only for a personal, directly funded Tradovate brokerage account.)</li><li>Save, then connect. Give it a moment, and your evaluation should populate the <strong class='text-white'>Accounts</strong> tab. A healthy connection turns green in the Control Center.</li></ol>" },
    { type: "paragraph", html: "If you set up a Live connection earlier and got the error, don't just flip the setting mid-session and keep retrying. Disconnect fully, correct the Account Type, and reconnect cleanly. Hammering a failing connection over and over can trip a temporary lockout on top of the original problem." },
    { type: "heading", text: "Fix 2: Enable Multi-provider and confirm your credentials" },
    { type: "paragraph", html: "<ol><li>In the Control Center, open <strong class='text-white'>Tools &gt; Options</strong> (labeled <strong class='text-white'>Settings</strong> in some builds) and go to the <strong class='text-white'>General</strong> section.</li><li>Tick the <strong class='text-white'>Multi-provider</strong> checkbox, click <strong class='text-white'>OK</strong>, and <strong class='text-white'>restart NinjaTrader</strong> so the change takes effect.</li><li>Reopen <strong class='text-white'>Connections &gt; Configure</strong> and set up the Tradovate connection again if needed.</li><li>Double-check the login: paste the Tradovate username and password from your firm, then re-type them by hand to strip any stray leading space or auto-lowercased first character that copy-paste can introduce.</li></ol>" },
    { type: "heading", text: "Fix 3: Confirm activation, version, and escalate if needed" },
    { type: "paragraph", html: "<ol><li>Sign in to the Tradovate web trader once with the same credentials, complete any profile prompt, and accept the data agreements so the account is fully enabled for outside platforms.</li><li>Check your NinjaTrader build under <strong class='text-white'>Help &gt; About</strong>. If it starts with <strong class='text-white'>8.0</strong>, update to the latest NinjaTrader 8 release before anything else.</li><li>If a newly purchased evaluation still isn't listed, give it time to provision, then disconnect and reconnect on Simulation.</li><li>If the account never appears with the correct environment and credentials, the hold-up is on the firm's side. Contact your prop firm's support to confirm the evaluation is active and provisioned, Tradovate can't enable or see the status of a firm-owned account. Rules, drawdown limits, and account sizes vary by firm and account size, so check your firm's current terms.</li></ol>" },
    { type: "heading", text: "Troubleshooting Table" },
    {
      type: "table",
      headers: ["Symptom", "What it means", "Fix"],
      rows: [
        ["No accounts were found for this account type", "Login worked, but the environment you chose holds none of your accounts", "Set the connection Account Type to Simulation for an evaluation, then reconnect"],
        ["Accounts tab empty after connecting", "Wrong Account Type, wrong login, or Multi-provider off", "Confirm Simulation, use the firm-issued Tradovate credentials, and enable Multi-provider"],
        ["Account shows under Live with delayed data", "You're likely on the wrong environment for a prop eval", "Reconnect on Simulation; delayed data is a separate entitlement issue"],
        ["Correct environment + login, still nothing", "Evaluation isn't activated or provisioned by the firm yet", "Give it time, then contact your prop firm to enable and provision it"],
        ["Can't connect at all", "Running NinjaTrader 8.0, which can't reach Tradovate", "Update to build 8.1.2.1 or later, then set up the connection"],
        ["Repeated failures then a lockout", "Too many retries in the wrong environment", "Stop retrying, wait out the cooldown, then reconnect on Simulation"],
      ],
    },
    { type: "heading", text: "Prevent This With PickMyTrade" },
    { type: "paragraph", html: "Once you know your evaluation lives on the simulation engine, the aim is simple: connect to the right account once and stop wrestling the Live-vs-Simulation toggle every session. That's where an automation layer pulls its weight. PickMyTrade links your TradingView alerts straight to the specific Tradovate account you authorize, so your order flow doesn't depend on a desktop connection being set to exactly the right environment every time you sit down." },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Correct-Account Routing</strong>, authorize the exact evaluation account once, and every alert goes there, with no Account Type to re-pick on each launch.",
        "<strong class='text-white'>Direct Alert-to-Tradovate Delivery</strong>, orders reach your account without riding through a separate desktop platform that can quietly fall out of sync.",
        "<strong class='text-white'>Multi-Account Sync</strong>, mirror the same signal across several evaluations from one place, instead of standing up and configuring each connection by hand.",
        "<strong class='text-white'>Set-Once Connection</strong>, a stored link means you're not re-authenticating and re-selecting an environment on every device you trade from.",
      ],
    },
  ], de: [
    { type: "paragraph",html: "Sie geben Ihren Tradovate-Benutzernamen und Ihr Passwort ein, NinjaTrader verbindet sich ohne Beanstandung, und dann&hellip; nichts. Der Reiter „Accounts“ bleibt leer, oder Sie erhalten ein knappes <strong class='text-white'>„No accounts were found for this account type.“</strong> Die Zugangsdaten haben offensichtlich funktioniert, denn Sie haben den Login-Schritt überstanden. Wo ist also Ihr Evaluationskonto geblieben? Fast immer liegt es an einer einzigen Einstellung: Der <strong class='text-white'>Account Type</strong>, den Sie in der NinjaTrader-Verbindung gewählt haben, passt nicht zu der Umgebung, in der Ihr Konto tatsächlich liegt. Eine Tradovate-Prop-Firma-Evaluation läuft auf der <strong class='text-white'>Simulations</strong>-Engine von Tradovate, daher muss die Verbindung auf <strong class='text-white'>Simulation</strong> gesetzt sein, nicht auf <strong class='text-white'>Live</strong>. Wählen Sie Live, sucht NinjaTrader Ihr Konto in der Welt der echten Brokerage, findet keines, das mit diesen Zugangsdaten verknüpft ist, und meldet null Konten. Im Folgenden schlüssele ich auf, was die Meldung wirklich bedeutet, welche wenigen Dinge sie auslösen und mit welchen Schritten Ihre Eval im Reiter „Accounts“ erscheint, außerdem, wie das Routing Ihrer Alerts über eine Automatisierung verhindert, dass eine fummelige Desktop-Verbindung zwischen Ihnen und Ihren Ausführungen steht." },
    {
      type: "checklist",
      heading: "Kurze Checkliste für den Fehler „No Accounts Found“",
      items: [
        "<strong class='text-white'>Setzen Sie den Account Type auf Simulation</strong> für jedes Prop-Firma- oder Evaluationskonto, denn dort liegen diese Konten bei Tradovate.",
        "<strong class='text-white'>Verwenden Sie die von Ihrer Firma ausgestellten Tradovate-Zugangsdaten</strong>, nicht die E-Mail und das Passwort Ihres NinjaTrader Account Dashboards.",
        "<strong class='text-white'>Aktivieren Sie Multi-provider</strong> (Tools &gt; Options/Settings &gt; General) und starten Sie NinjaTrader neu, wenn Sie mehr als eine Verbindung betreiben.",
        "<strong class='text-white'>Ein Account Type pro Verbindung</strong>: Wenn Sie sowohl Live als auch Simulation benötigen, erstellen Sie für jeden eine eigene Verbindung.",
        "<strong class='text-white'>Geben Sie einer neuen Evaluation Zeit zur Bereitstellung</strong>: Ein frisch gekauftes Konto erscheint möglicherweise nicht im selben Moment, in dem Sie sich verbinden.",
        "<strong class='text-white'>Bestätigen Sie, dass Sie Build 8.1.2.1 oder höher verwenden</strong>: NinjaTrader 8.0 kann sich gar nicht erst mit Tradovate verbinden.",
      ],
    },
    { type: "heading",text: "Was „No Accounts Were Found for This Account Type“ bedeutet" },
    { type: "paragraph",html: "Diese Meldung irritiert, weil der Login selbst erfolgreich war. NinjaTrader hat Ihre Zugangsdaten an Tradovate übergeben, Tradovate hat sie akzeptiert, und eine Sitzung wurde geöffnet. Das Wort „found“ verrät es: NinjaTrader hat sich einwandfrei verbunden, dann Tradovate nach den Konten gefragt, die Ihnen <em>in der gewählten Umgebung</em> gehören, und eine leere Liste zurückerhalten." },
    { type: "paragraph",html: "Tradovate betreibt zwei getrennte Welten. Es gibt eine <strong class='text-white'>Live</strong>-Umgebung für echte, direkt finanzierte Brokerage-Konten und eine <strong class='text-white'>Simulation</strong>-Umgebung, in der jedes Papertrading- und Prop-Firma-Evaluationskonto liegt. Wenn Ihre Prop-Firma Sie einrichtet, wird Ihre Evaluation in der Simulationswelt angelegt. Die Zugangsdaten, die Sie erhalten haben, lösen nur dort zu einem Konto auf. Lassen Sie die NinjaTrader-Verbindung also auf dem Account Type Live, fragt NinjaTrader die Seite der echten Brokerage ab, sieht keine mit diesem Login verknüpften Konten und zeigt „no accounts found“. Gleiche Zugangsdaten, falsche Nachbarschaft." },
    { type: "paragraph",html: "Das Wort „Simulation“ bei einer scheinbar finanzierten Evaluation verunsichert manche Trader, ist aber erwartet und korrekt. Eine Prop-Evaluation ist ein simuliertes Konto mit echten Regeln und echten Auszahlungen. Sie verbindet sich dennoch über die Simulationsumgebung, und die Wahl von Simulation in NinjaTrader ist genau richtig." },
    { type: "heading",text: "Die häufigsten Ursachen für einen leeren Reiter „Accounts“" },
    { type: "heading",text: "1. Sie haben den falschen Account Type gewählt (Live statt Simulation)" },
    { type: "paragraph",html: "Das ist die Ursache Nummer eins. Die Verbindungseinrichtung bietet eine Auswahl für den Account Type, und Live wird reflexhaft gewählt, weil sich eine finanzierte Evaluation so <em>anfühlt</em>, als müsse sie Live sein. Doch Ihre Evaluations-Zugangsdaten existieren in der Live-Umgebung nicht, daher findet NinjaTrader kein einziges Konto und meldet keines. Für ein direkt finanziertes persönliches Tradovate-Konto mit Ihrem eigenen Geld ist Live richtig, für eine Prop-Evaluation nicht." },
    { type: "heading",text: "2. Sie verwenden die falschen Zugangsdaten" },
    { type: "paragraph",html: "Tradovate-Logins von Prop-Firmen sind vom Login Ihres NinjaTrader Account Dashboards getrennt. E-Mail und Passwort des Dashboards bringen Sie in NinjaTrader selbst hinein. Die Tradovate-Plattform-Zugangsdaten, die Ihre Firma Ihnen sendet (oft in einer Nachricht mit Datenzugangsdaten), braucht die Tradovate-Verbindung. Geben Sie die Dashboard-E-Mail dort ein, wo NinjaTrader den Tradovate-Login erwartet, scheitern Sie je nach Ablauf entweder an der Authentifizierung oder verbinden sich mit einer Umgebung, in der keines Ihrer Konten liegt." },
    { type: "heading",text: "3. Multi-provider ist nicht aktiviert" },
    { type: "paragraph",html: "NinjaTrader wird mit einer eigenen, eingebauten Simulator-Verbindung ausgeliefert. Um daneben eine zweite Verbindung oder mehrere Prop-Konten gleichzeitig zu betreiben, müssen Sie zuerst Multi-provider aktivieren. Überspringen Sie diesen Schritt, lässt NinjaTrader die Tradovate-Verbindung möglicherweise nicht richtig zustande kommen, was sich als Konten zeigt, die nie erscheinen. Jede Verbindung verarbeitet außerdem nur einen Account Type, daher sind eine Live-Verbindung und eine Simulation-Verbindung zwei verschiedene Einträge." },
    { type: "heading",text: "4. Die Evaluation ist noch nicht aktiviert oder bereitgestellt" },
    { type: "paragraph",html: "Wenn Umgebung und Zugangsdaten stimmen und der Reiter trotzdem leer ist, ist das Konto auf Seiten der Firma möglicherweise noch nicht vollständig live. Die Bereitstellung kann dem Kauf hinterherhinken, und solange das System der Firma das Konto nicht fertig angelegt und aktiviert hat, gibt es nichts, was NinjaTrader auflisten könnte. Bei manchen Konten müssen Sie sich außerdem einmal im Tradovate-Web-Trader anmelden und die Datenvereinbarungen akzeptieren, bevor sie in Drittanbieter-Software auftauchen." },
    { type: "heading",text: "5. NinjaTrader 8.0 kann sich gar nicht verbinden" },
    { type: "paragraph",html: "Ältere Installationen sind eine Falle. NinjaTrader 8.0 stammt aus der Zeit vor der Tradovate-Unterstützung und verbindet sich nicht mit einem Tradovate-Konto, sodass Sie nicht einmal bis zur Kontoauflistung kommen. Sie benötigen Build <strong class='text-white'>8.1.2.1 oder höher</strong>. Wenn Sie nicht sicher sind, was Sie verwenden, lohnt sich diese Prüfung, bevor Sie Zeit in die Einstellungen zum Account Type investieren." },
    { type: "heading",text: "So beheben Sie es: Schritt für Schritt" },
    { type: "heading",text: "Lösung 1: Setzen Sie den Account Type der Verbindung auf Simulation" },
    { type: "paragraph",html: "<ol><li>Öffnen Sie das NinjaTrader-<strong class='text-white'>Control Center</strong> und gehen Sie zu <strong class='text-white'>Connections &gt; Configure</strong>.</li><li>Fügen Sie eine neue Verbindung hinzu oder wählen Sie Ihre vorhandene Tradovate-Verbindung zum Bearbeiten aus.</li><li>Geben Sie den <strong class='text-white'>von Ihrer Prop-Firma für die Plattform ausgestellten Tradovate-Benutzernamen und das Passwort</strong> ein, nicht die E-Mail Ihres NinjaTrader-Dashboards.</li><li>Suchen Sie die Auswahl <strong class='text-white'>Account Type</strong> und setzen Sie sie bei einem Prop-Firma- oder Evaluationskonto auf <strong class='text-white'>Simulation</strong>. (Wählen Sie Live nur für ein persönliches, direkt finanziertes Tradovate-Brokerage-Konto.)</li><li>Speichern Sie und verbinden Sie sich. Warten Sie einen Moment, und Ihre Evaluation sollte den Reiter <strong class='text-white'>Accounts</strong> füllen. Eine gesunde Verbindung wird im Control Center grün.</li></ol>" },
    { type: "paragraph",html: "Wenn Sie zuvor eine Live-Verbindung eingerichtet und den Fehler erhalten haben, ändern Sie die Einstellung nicht einfach mitten in der Sitzung und versuchen es immer wieder. Trennen Sie die Verbindung vollständig, korrigieren Sie den Account Type und verbinden Sie sich sauber neu. Das wiederholte Bombardieren einer fehlschlagenden Verbindung kann zusätzlich zum ursprünglichen Problem eine vorübergehende Sperre auslösen." },
    { type: "heading",text: "Lösung 2: Aktivieren Sie Multi-provider und bestätigen Sie Ihre Zugangsdaten" },
    { type: "paragraph",html: "<ol><li>Öffnen Sie im Control Center <strong class='text-white'>Tools &gt; Options</strong> (in manchen Builds mit <strong class='text-white'>Settings</strong> beschriftet) und gehen Sie zum Bereich <strong class='text-white'>General</strong>.</li><li>Aktivieren Sie das Kontrollkästchen <strong class='text-white'>Multi-provider</strong>, klicken Sie auf <strong class='text-white'>OK</strong> und <strong class='text-white'>starten Sie NinjaTrader neu</strong>, damit die Änderung wirksam wird.</li><li>Öffnen Sie <strong class='text-white'>Connections &gt; Configure</strong> erneut und richten Sie die Tradovate-Verbindung bei Bedarf noch einmal ein.</li><li>Prüfen Sie den Login genau: Fügen Sie Tradovate-Benutzernamen und Passwort Ihrer Firma ein und tippen Sie sie dann von Hand neu ein, um ein überflüssiges führendes Leerzeichen oder ein automatisch kleingeschriebenes erstes Zeichen zu entfernen, das durch Copy-Paste entstehen kann.</li></ol>" },
    { type: "heading",text: "Lösung 3: Aktivierung und Version bestätigen, bei Bedarf eskalieren" },
    { type: "paragraph",html: "<ol><li>Melden Sie sich einmal mit denselben Zugangsdaten im Tradovate-Web-Trader an, schließen Sie eventuelle Profilabfragen ab und akzeptieren Sie die Datenvereinbarungen, damit das Konto für externe Plattformen vollständig freigeschaltet ist.</li><li>Prüfen Sie Ihren NinjaTrader-Build unter <strong class='text-white'>Help &gt; About</strong>. Beginnt er mit <strong class='text-white'>8.0</strong>, aktualisieren Sie zuerst auf das neueste NinjaTrader-8-Release.</li><li>Wird eine neu gekaufte Evaluation weiterhin nicht aufgelistet, geben Sie ihr Zeit zur Bereitstellung und trennen und verbinden Sie sich dann erneut auf Simulation.</li><li>Erscheint das Konto mit der richtigen Umgebung und den richtigen Zugangsdaten nie, liegt die Verzögerung auf Seiten der Firma. Wenden Sie sich an den Support Ihrer Prop-Firma, um zu bestätigen, dass die Evaluation aktiv und bereitgestellt ist. Tradovate kann ein Konto im Besitz einer Firma weder aktivieren noch dessen Status einsehen. Regeln, Drawdown-Limits und Kontogrößen unterscheiden sich je nach Firma und Kontogröße, prüfen Sie daher die aktuellen Bedingungen Ihrer Firma.</li></ol>" },
    { type: "heading",text: "Tabelle zur Fehlersuche" },
    { type: "table", headers: ["Symptom","Was es bedeutet","Lösung"], rows: [
      ["Meldung „No accounts were found for this account type“","Der Login hat funktioniert, aber die gewählte Umgebung enthält keines Ihrer Konten","Den Account Type der Verbindung für eine Evaluation auf Simulation setzen, dann neu verbinden"],
      ["Reiter „Accounts“ nach dem Verbinden leer","Falscher Account Type, falscher Login oder Multi-provider ausgeschaltet","Simulation bestätigen, von der Firma ausgestellte Tradovate-Zugangsdaten verwenden und Multi-provider aktivieren"],
      ["Konto erscheint unter Live mit verzögerten Daten","Sie befinden sich wahrscheinlich in der falschen Umgebung für eine Prop-Eval","Auf Simulation neu verbinden; verzögerte Daten sind eine separate Berechtigungsfrage"],
      ["Richtige Umgebung + Login, trotzdem nichts","Die Evaluation wurde von der Firma noch nicht aktiviert oder bereitgestellt","Zeit geben, dann Ihre Prop-Firma kontaktieren, damit sie aktiviert und bereitgestellt wird"],
      ["Verbindung gar nicht möglich","NinjaTrader 8.0 wird verwendet und kann Tradovate nicht erreichen","Auf Build 8.1.2.1 oder höher aktualisieren, dann die Verbindung einrichten"],
      ["Wiederholte Fehlschläge, dann Sperre","Zu viele Wiederholungen in der falschen Umgebung","Keine weiteren Versuche, die Abkühlzeit abwarten, dann auf Simulation neu verbinden"],
    ] },
    { type: "heading",text: "Verhindern Sie das mit PickMyTrade" },
    { type: "paragraph",html: "Sobald Sie wissen, dass Ihre Evaluation auf der Simulations-Engine liegt, ist das Ziel einfach: einmal mit dem richtigen Konto verbinden und nicht bei jeder Sitzung mit dem Umschalter Live oder Simulation ringen. Genau hier zahlt sich eine Automatisierungsschicht aus. PickMyTrade verknüpft Ihre TradingView-Alerts direkt mit dem bestimmten Tradovate-Konto, das Sie autorisieren, sodass Ihr Orderfluss nicht davon abhängt, dass eine Desktop-Verbindung bei jedem Start genau auf die richtige Umgebung gesetzt ist." },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Routing zum richtigen Konto</strong>: Autorisieren Sie das genaue Evaluationskonto einmal, und jeder Alert geht dorthin, ohne dass bei jedem Start ein Account Type neu gewählt werden muss.",
        "<strong class='text-white'>Direkte Zustellung von Alert zu Tradovate</strong>: Orders erreichen Ihr Konto, ohne über eine separate Desktop-Plattform zu laufen, die unbemerkt aus dem Takt geraten kann.",
        "<strong class='text-white'>Multi-Konto-Synchronisierung</strong>: Spiegeln Sie dasselbe Signal von einem Ort aus über mehrere Evaluationen, statt jede Verbindung von Hand aufzusetzen und zu konfigurieren.",
        "<strong class='text-white'>Einmalige Verbindung</strong>: Eine gespeicherte Verknüpfung bedeutet, dass Sie sich nicht auf jedem Gerät, mit dem Sie handeln, neu authentifizieren und eine Umgebung neu wählen müssen.",
      ],
    },
  ], es: [
    { type: "paragraph",html: "Escribe su nombre de usuario y contraseña de Tradovate, NinjaTrader se conecta sin quejas y entonces&hellip; nada. La pestaña Accounts queda vacía, o recibe un seco <strong class='text-white'>«No accounts were found for this account type.»</strong> Las credenciales claramente funcionaron, porque superó el paso de inicio de sesión, así que ¿adónde fue su cuenta de evaluación? Casi siempre se reduce a un solo ajuste: el <strong class='text-white'>Account Type</strong> que eligió en la conexión de NinjaTrader no coincide con el entorno en el que realmente vive su cuenta. Una evaluación de prop trading de Tradovate se ejecuta en el motor de <strong class='text-white'>simulación</strong> de Tradovate, por lo que la conexión debe configurarse como <strong class='text-white'>Simulation</strong>, no como <strong class='text-white'>Live</strong>. Si elige Live, NinjaTrader va a buscar su cuenta al mundo del bróker real, no encuentra ninguna vinculada a esas credenciales e informa de cero cuentas. A continuación desgloso qué significa realmente el mensaje, las pocas cosas que lo desencadenan y los pasos exactos para que su evaluación aparezca en la pestaña Accounts, además de cómo enrutar sus alertas mediante automatización evita que una conexión de escritorio quisquillosa se interponga entre usted y sus ejecuciones." },
    {
      type: "checklist",
      heading: "Lista de verificación rápida para el error No Accounts Found",
      items: [
        "<strong class='text-white'>Configure el Account Type en Simulation</strong> para cualquier cuenta de prop trading o de evaluación, porque ahí viven estas cuentas en Tradovate.",
        "<strong class='text-white'>Utilice las credenciales de Tradovate que emitió su firma</strong>, no el correo y la contraseña de su NinjaTrader Account Dashboard.",
        "<strong class='text-white'>Active Multi-provider</strong> (Tools &gt; Options/Settings &gt; General) y reinicie NinjaTrader si ejecuta más de una conexión.",
        "<strong class='text-white'>Un Account Type por conexión</strong>: si necesita tanto Live como Simulation, cree una conexión independiente para cada uno.",
        "<strong class='text-white'>Dé tiempo de aprovisionamiento a una evaluación nueva</strong>: una cuenta recién comprada puede no aparecer en el instante en que se conecta.",
        "<strong class='text-white'>Confirme que está en la compilación 8.1.2.1 o posterior</strong>: NinjaTrader 8.0 no puede conectarse a Tradovate en primer lugar.",
      ],
    },
    { type: "heading",text: "Qué significa «No Accounts Were Found for This Account Type»" },
    { type: "paragraph",html: "Este mensaje desconcierta porque el inicio de sesión en sí se completó. NinjaTrader entregó sus credenciales a Tradovate, Tradovate las aceptó y se abrió una sesión. La palabra «found» lo delata: NinjaTrader se conectó bien, luego pidió a Tradovate las cuentas que le pertenecen <em>en el entorno que seleccionó</em> y recibió una lista vacía." },
    { type: "paragraph",html: "Tradovate maneja dos mundos separados. Hay un entorno <strong class='text-white'>Live</strong> para cuentas de bróker reales, financiadas directamente, y un entorno <strong class='text-white'>Simulation</strong> donde vive toda cuenta de paper trading y de evaluación de prop trading. Cuando su firma de prop trading lo da de alta, su evaluación se crea en el mundo de simulación. Las credenciales que le dieron solo resuelven a una cuenta allí. Así que si deja la conexión de NinjaTrader en el Account Type Live, NinjaTrader consulta el lado del bróker real, no ve cuentas asociadas a ese acceso y muestra «no accounts found». Mismas credenciales, barrio equivocado." },
    { type: "paragraph",html: "Ver la palabra «Simulation» junto a una evaluación que parece fondeada desconcierta a algunos traders, pero es lo esperado y correcto. Una evaluación de prop trading es una cuenta simulada con reglas reales y pagos reales en juego. Aun así se conecta a través del entorno de simulación, y elegir Simulation en NinjaTrader es exactamente lo correcto." },
    { type: "heading",text: "Principales causas de la pestaña Accounts vacía" },
    { type: "heading",text: "1. Eligió el Account Type equivocado (Live en lugar de Simulation)" },
    { type: "paragraph",html: "Esta es la causa número uno. La configuración de la conexión le ofrece una opción de Account Type, y Live es fácil de elegir por reflejo, ya que una evaluación fondeada <em>parece</em> que debería ser Live. Pero las credenciales de su evaluación no existen en el entorno Live, por lo que NinjaTrader no puede encontrar ni una sola cuenta y no informa de ninguna. Para una cuenta personal de Tradovate financiada directamente con su propio dinero, Live es correcto; para una evaluación de prop trading, no." },
    { type: "heading",text: "2. Está usando las credenciales equivocadas" },
    { type: "paragraph",html: "Los accesos de Tradovate de las firmas de prop trading son independientes del acceso a su NinjaTrader Account Dashboard. El correo y la contraseña del panel le dan acceso al propio NinjaTrader; las credenciales de la plataforma Tradovate que le envía su firma (a menudo en un mensaje de credenciales de datos) son las que necesita la conexión de Tradovate. Si introduce el correo del panel donde NinjaTrader espera el acceso de Tradovate, según el flujo fallará la autenticación o se conectará a un entorno sin ninguna de sus cuentas." },
    { type: "heading",text: "3. Multi-provider no está activado" },
    { type: "paragraph",html: "NinjaTrader incluye su propia conexión de simulador integrada. Para ejecutar una segunda conexión junto a ella, o varias cuentas de prop trading a la vez, primero debe activar Multi-provider. Si omite ese paso, NinjaTrader puede no permitir que la conexión de Tradovate se establezca correctamente, lo que se manifiesta como cuentas que nunca se cargan. Además, cada conexión maneja un único Account Type, por lo que una conexión Live y una conexión Simulation son dos entradas distintas." },
    { type: "heading",text: "4. La evaluación aún no está activada ni aprovisionada" },
    { type: "paragraph",html: "Si el entorno y las credenciales son correctos y la pestaña sigue vacía, es posible que la cuenta aún no esté totalmente activa por parte de la firma. El aprovisionamiento puede ir por detrás de su compra, y hasta que el sistema de la firma termine de crear y habilitar la cuenta, NinjaTrader no tiene nada que listar. Algunas cuentas también requieren que inicie sesión una vez en el Tradovate web trader y acepte los acuerdos de datos antes de aparecer en software de terceros." },
    { type: "heading",text: "5. NinjaTrader 8.0 no puede conectarse en absoluto" },
    { type: "paragraph",html: "Las instalaciones antiguas son una trampa. NinjaTrader 8.0 es anterior al soporte de Tradovate y no se conectará a una cuenta de Tradovate, así que ni siquiera llega a la etapa de listado de cuentas. Necesita la compilación <strong class='text-white'>8.1.2.1 o posterior</strong>. Si no está seguro de lo que ejecuta, vale la pena comprobarlo antes de dedicar tiempo a los ajustes del Account Type." },
    { type: "heading",text: "Cómo solucionarlo: paso a paso" },
    { type: "heading",text: "Solución 1: configure el Account Type de la conexión en Simulation" },
    { type: "paragraph",html: "<ol><li>Abra el <strong class='text-white'>Control Center</strong> de NinjaTrader y vaya a <strong class='text-white'>Connections &gt; Configure</strong>.</li><li>Añada una nueva conexión o seleccione su conexión de Tradovate existente para editarla.</li><li>Introduzca el <strong class='text-white'>nombre de usuario y la contraseña de Tradovate que emitió su firma de prop trading</strong> para la plataforma, no el correo de su panel de NinjaTrader.</li><li>Busque el selector <strong class='text-white'>Account Type</strong> y configúrelo en <strong class='text-white'>Simulation</strong> para una cuenta de prop trading o de evaluación. (Elija Live solo para una cuenta personal de bróker de Tradovate financiada directamente.)</li><li>Guarde y conecte. Dele un momento y su evaluación debería llenar la pestaña <strong class='text-white'>Accounts</strong>. Una conexión sana se pone en verde en el Control Center.</li></ol>" },
    { type: "paragraph",html: "Si configuró antes una conexión Live y obtuvo el error, no se limite a cambiar el ajuste a mitad de sesión y seguir reintentando. Desconecte por completo, corrija el Account Type y vuelva a conectarse limpiamente. Bombardear una conexión que falla una y otra vez puede provocar un bloqueo temporal además del problema original." },
    { type: "heading",text: "Solución 2: active Multi-provider y confirme sus credenciales" },
    { type: "paragraph",html: "<ol><li>En el Control Center, abra <strong class='text-white'>Tools &gt; Options</strong> (con la etiqueta <strong class='text-white'>Settings</strong> en algunas compilaciones) y vaya a la sección <strong class='text-white'>General</strong>.</li><li>Marque la casilla <strong class='text-white'>Multi-provider</strong>, haga clic en <strong class='text-white'>OK</strong> y <strong class='text-white'>reinicie NinjaTrader</strong> para que el cambio surta efecto.</li><li>Vuelva a abrir <strong class='text-white'>Connections &gt; Configure</strong> y configure de nuevo la conexión de Tradovate si es necesario.</li><li>Revise bien el acceso: pegue el nombre de usuario y la contraseña de Tradovate de su firma y luego vuelva a escribirlos a mano para eliminar cualquier espacio inicial sobrante o un primer carácter pasado a minúscula automáticamente que el copiar y pegar pueda introducir.</li></ol>" },
    { type: "heading",text: "Solución 3: confirme la activación y la versión, y escale si es necesario" },
    { type: "paragraph",html: "<ol><li>Inicie sesión una vez en el Tradovate web trader con las mismas credenciales, complete cualquier aviso de perfil y acepte los acuerdos de datos para que la cuenta quede totalmente habilitada para plataformas externas.</li><li>Compruebe su compilación de NinjaTrader en <strong class='text-white'>Help &gt; About</strong>. Si empieza por <strong class='text-white'>8.0</strong>, actualice antes que nada a la última versión de NinjaTrader 8.</li><li>Si una evaluación recién comprada sigue sin aparecer, dele tiempo de aprovisionamiento y luego desconecte y vuelva a conectarse en Simulation.</li><li>Si la cuenta nunca aparece con el entorno y las credenciales correctos, el retraso está en el lado de la firma. Contacte con el soporte de su firma de prop trading para confirmar que la evaluación está activa y aprovisionada; Tradovate no puede habilitar ni ver el estado de una cuenta propiedad de una firma. Las reglas, los límites de drawdown y los tamaños de cuenta varían según la firma y el tamaño de la cuenta, así que revise los términos vigentes de su firma.</li></ol>" },
    { type: "heading",text: "Tabla de resolución de problemas" },
    { type: "table", headers: ["Síntoma","Qué significa","Solución"], rows: [
      ["Mensaje «No accounts were found for this account type»","El inicio de sesión funcionó, pero el entorno elegido no contiene ninguna de sus cuentas","Configure el Account Type de la conexión en Simulation para una evaluación y vuelva a conectarse"],
      ["Pestaña Accounts vacía tras conectarse","Account Type equivocado, acceso equivocado o Multi-provider desactivado","Confirme Simulation, use las credenciales de Tradovate emitidas por la firma y active Multi-provider"],
      ["La cuenta aparece en Live con datos retrasados","Probablemente está en el entorno equivocado para una evaluación de prop trading","Vuelva a conectarse en Simulation; los datos retrasados son un problema de derechos independiente"],
      ["Entorno y acceso correctos, y aun así nada","La firma aún no ha activado ni aprovisionado la evaluación","Dele tiempo y luego contacte con su firma de prop trading para que la habilite y la aprovisione"],
      ["No se puede conectar en absoluto","Ejecuta NinjaTrader 8.0, que no puede alcanzar Tradovate","Actualice a la compilación 8.1.2.1 o posterior y luego configure la conexión"],
      ["Fallos repetidos y luego un bloqueo","Demasiados reintentos en el entorno equivocado","Deje de reintentar, espere a que termine el enfriamiento y luego vuelva a conectarse en Simulation"],
    ] },
    { type: "heading",text: "Evítelo con PickMyTrade" },
    { type: "paragraph",html: "Una vez que sabe que su evaluación vive en el motor de simulación, el objetivo es simple: conectarse a la cuenta correcta una vez y dejar de pelearse con el interruptor Live o Simulation en cada sesión. Ahí es donde una capa de automatización demuestra su valor. PickMyTrade vincula sus alertas de TradingView directamente a la cuenta específica de Tradovate que usted autoriza, de modo que su flujo de órdenes no depende de que una conexión de escritorio esté configurada en el entorno exacto cada vez que se sienta a operar." },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Enrutamiento a la cuenta correcta</strong>: autorice la cuenta de evaluación exacta una vez y cada alerta va allí, sin tener que volver a elegir un Account Type en cada inicio.",
        "<strong class='text-white'>Entrega directa de alerta a Tradovate</strong>: las órdenes llegan a su cuenta sin pasar por una plataforma de escritorio independiente que puede desincronizarse sin que lo note.",
        "<strong class='text-white'>Sincronización multicuenta</strong>: replique la misma señal en varias evaluaciones desde un solo lugar, en lugar de levantar y configurar cada conexión a mano.",
        "<strong class='text-white'>Conexión de una sola vez</strong>: un vínculo almacenado significa que no tiene que volver a autenticarse ni a seleccionar un entorno en cada dispositivo desde el que opera.",
      ],
    },
  ], fr: [
    { type: "paragraph",html: "Vous saisissez votre nom d'utilisateur et votre mot de passe Tradovate, NinjaTrader se connecte sans broncher, puis&hellip; rien. L'onglet Accounts reste vide, ou vous obtenez un sec <strong class='text-white'>« No accounts were found for this account type. »</strong> Les identifiants ont manifestement fonctionné, puisque vous avez passé l'étape de connexion ; alors où est passé votre compte d'évaluation ? Presque à chaque fois, tout tient à un seul réglage : l'<strong class='text-white'>Account Type</strong> que vous avez choisi dans la connexion NinjaTrader ne correspond pas à l'environnement dans lequel se trouve réellement votre compte. Une évaluation de prop firm Tradovate fonctionne sur le moteur de <strong class='text-white'>simulation</strong> de Tradovate ; la connexion doit donc être réglée sur <strong class='text-white'>Simulation</strong>, et non sur <strong class='text-white'>Live</strong>. Choisissez Live et NinjaTrader part chercher votre compte dans le monde du courtage réel, n'en trouve aucun lié à ces identifiants et signale zéro compte. Ci-dessous, je détaille ce que le message signifie réellement, les quelques éléments qui le déclenchent et les étapes exactes pour faire apparaître votre évaluation dans l'onglet Accounts, ainsi que la manière dont l'acheminement de vos alertes par automatisation évite qu'une connexion de bureau capricieuse ne s'interpose entre vous et vos exécutions." },
    {
      type: "checklist",
      heading: "Liste de vérification rapide pour l'erreur No Accounts Found",
      items: [
        "<strong class='text-white'>Réglez l'Account Type sur Simulation</strong> pour tout compte de prop firm ou d'évaluation, car c'est là que ces comptes se trouvent chez Tradovate.",
        "<strong class='text-white'>Utilisez les identifiants Tradovate émis par votre firme</strong>, et non l'e-mail et le mot de passe de votre NinjaTrader Account Dashboard.",
        "<strong class='text-white'>Activez Multi-provider</strong> (Tools &gt; Options/Settings &gt; General) et redémarrez NinjaTrader si vous exécutez plus d'une connexion.",
        "<strong class='text-white'>Un Account Type par connexion</strong> : si vous avez besoin à la fois de Live et de Simulation, créez une connexion distincte pour chacun.",
        "<strong class='text-white'>Laissez à une nouvelle évaluation le temps d'être provisionnée</strong> : un compte fraîchement acheté peut ne pas apparaître à l'instant où vous vous connectez.",
        "<strong class='text-white'>Confirmez que vous êtes sur la build 8.1.2.1 ou ultérieure</strong> : NinjaTrader 8.0 ne peut pas se connecter à Tradovate en premier lieu.",
      ],
    },
    { type: "heading",text: "Ce que signifie « No Accounts Were Found for This Account Type »" },
    { type: "paragraph",html: "Ce message déroute parce que la connexion elle-même a abouti. NinjaTrader a transmis vos identifiants à Tradovate, Tradovate les a acceptés et une session s'est ouverte. Le mot « found » est révélateur : NinjaTrader s'est bien connecté, puis a demandé à Tradovate les comptes qui vous appartiennent <em>dans l'environnement que vous avez sélectionné</em>, et a reçu une liste vide." },
    { type: "paragraph",html: "Tradovate fait fonctionner deux mondes distincts. Il existe un environnement <strong class='text-white'>Live</strong> pour les comptes de courtage réels, financés directement, et un environnement <strong class='text-white'>Simulation</strong> où se trouve chaque compte de paper trading et d'évaluation de prop firm. Lorsque votre prop firm vous configure, votre évaluation est créée dans le monde de la simulation. Les identifiants qu'elle vous a fournis ne correspondent à un compte que là. Ainsi, si vous laissez la connexion NinjaTrader sur l'Account Type Live, NinjaTrader interroge le côté courtage réel, ne voit aucun compte rattaché à cette connexion et affiche « no accounts found ». Mêmes identifiants, mauvais quartier." },
    { type: "paragraph",html: "Voir le mot « Simulation » associé à une évaluation qui semble financée déconcerte certains traders, mais c'est attendu et correct. Une évaluation de prop firm est un compte simulé avec de vraies règles et de vrais retraits en jeu. Elle se connecte néanmoins via l'environnement de simulation, et choisir Simulation dans NinjaTrader est exactement ce qu'il faut." },
    { type: "heading",text: "Principales causes de l'onglet Accounts vide" },
    { type: "heading",text: "1. Vous avez choisi le mauvais Account Type (Live au lieu de Simulation)" },
    { type: "paragraph",html: "C'est la cause numéro un. La configuration de la connexion vous propose un choix d'Account Type, et Live se sélectionne facilement par réflexe, car une évaluation financée <em>donne l'impression</em> qu'elle devrait être en Live. Mais vos identifiants d'évaluation n'existent pas dans l'environnement Live ; NinjaTrader ne peut donc trouver aucun compte et n'en signale aucun. Pour un compte Tradovate personnel financé directement avec votre propre argent, Live est correct ; pour une évaluation de prop firm, non." },
    { type: "heading",text: "2. Vous utilisez les mauvais identifiants" },
    { type: "paragraph",html: "Les connexions Tradovate des prop firms sont distinctes de votre connexion NinjaTrader Account Dashboard. L'e-mail et le mot de passe du tableau de bord vous donnent accès à NinjaTrader lui-même ; les identifiants de la plateforme Tradovate que votre firme vous envoie (souvent dans un message d'identifiants de données) sont ceux dont la connexion Tradovate a besoin. Saisissez l'e-mail du tableau de bord là où NinjaTrader attend la connexion Tradovate et, selon le flux, vous échouerez à vous authentifier ou vous vous connecterez à un environnement ne contenant aucun de vos comptes." },
    { type: "heading",text: "3. Multi-provider n'est pas activé" },
    { type: "paragraph",html: "NinjaTrader est livré avec sa propre connexion de simulateur intégrée. Pour exécuter une seconde connexion à côté, ou plusieurs comptes de prop firm à la fois, vous devez d'abord activer Multi-provider. Si vous sautez cette étape, NinjaTrader peut ne pas laisser la connexion Tradovate s'établir correctement, ce qui se traduit par des comptes qui ne se remplissent jamais. Chaque connexion ne gère en outre qu'un seul Account Type ; une connexion Live et une connexion Simulation sont donc deux entrées différentes." },
    { type: "heading",text: "4. L'évaluation n'est pas encore activée ou provisionnée" },
    { type: "paragraph",html: "Si l'environnement et les identifiants sont corrects et que l'onglet reste vide, le compte n'est peut-être pas encore entièrement actif côté firme. Le provisionnement peut accuser un retard sur votre achat, et tant que le système de la firme n'a pas fini de créer et d'activer le compte, NinjaTrader n'a rien à lister. Certains comptes exigent aussi que vous vous connectiez une fois au Tradovate web trader et acceptiez les accords de données avant d'apparaître dans un logiciel tiers." },
    { type: "heading",text: "5. NinjaTrader 8.0 ne peut pas se connecter du tout" },
    { type: "paragraph",html: "Les anciennes installations sont un piège. NinjaTrader 8.0 est antérieur à la prise en charge de Tradovate et ne se connectera pas à un compte Tradovate ; vous ne pouvez donc même pas atteindre l'étape de listage des comptes. Il vous faut la build <strong class='text-white'>8.1.2.1 ou ultérieure</strong>. Si vous n'êtes pas sûr de ce que vous utilisez, cela vaut la peine d'être vérifié avant de passer du temps sur les réglages de l'Account Type." },
    { type: "heading",text: "Comment le corriger : étape par étape" },
    { type: "heading",text: "Correction 1 : réglez l'Account Type de la connexion sur Simulation" },
    { type: "paragraph",html: "<ol><li>Ouvrez le <strong class='text-white'>Control Center</strong> de NinjaTrader, puis allez dans <strong class='text-white'>Connections &gt; Configure</strong>.</li><li>Ajoutez une nouvelle connexion ou sélectionnez votre connexion Tradovate existante pour la modifier.</li><li>Saisissez le <strong class='text-white'>nom d'utilisateur et le mot de passe Tradovate émis par votre prop firm</strong> pour la plateforme, et non l'e-mail de votre tableau de bord NinjaTrader.</li><li>Trouvez le sélecteur <strong class='text-white'>Account Type</strong> et réglez-le sur <strong class='text-white'>Simulation</strong> pour un compte de prop firm ou d'évaluation. (Choisissez Live uniquement pour un compte de courtage Tradovate personnel, financé directement.)</li><li>Enregistrez, puis connectez-vous. Patientez un instant, et votre évaluation devrait remplir l'onglet <strong class='text-white'>Accounts</strong>. Une connexion saine passe au vert dans le Control Center.</li></ol>" },
    { type: "paragraph",html: "Si vous aviez configuré plus tôt une connexion Live et obtenu l'erreur, ne vous contentez pas de changer le réglage en pleine session et de continuer à réessayer. Déconnectez-vous complètement, corrigez l'Account Type et reconnectez-vous proprement. Marteler à répétition une connexion qui échoue peut déclencher un verrouillage temporaire en plus du problème d'origine." },
    { type: "heading",text: "Correction 2 : activez Multi-provider et confirmez vos identifiants" },
    { type: "paragraph",html: "<ol><li>Dans le Control Center, ouvrez <strong class='text-white'>Tools &gt; Options</strong> (intitulé <strong class='text-white'>Settings</strong> dans certaines builds) et allez à la section <strong class='text-white'>General</strong>.</li><li>Cochez la case <strong class='text-white'>Multi-provider</strong>, cliquez sur <strong class='text-white'>OK</strong> et <strong class='text-white'>redémarrez NinjaTrader</strong> pour que la modification prenne effet.</li><li>Rouvrez <strong class='text-white'>Connections &gt; Configure</strong> et configurez de nouveau la connexion Tradovate si nécessaire.</li><li>Vérifiez soigneusement la connexion : collez le nom d'utilisateur et le mot de passe Tradovate de votre firme, puis retapez-les à la main pour éliminer tout espace initial parasite ou premier caractère passé en minuscule automatiquement que le copier-coller peut introduire.</li></ol>" },
    { type: "heading",text: "Correction 3 : confirmez l'activation et la version, et escaladez si nécessaire" },
    { type: "paragraph",html: "<ol><li>Connectez-vous une fois au Tradovate web trader avec les mêmes identifiants, remplissez toute invite de profil et acceptez les accords de données afin que le compte soit pleinement activé pour les plateformes externes.</li><li>Vérifiez votre build NinjaTrader sous <strong class='text-white'>Help &gt; About</strong>. Si elle commence par <strong class='text-white'>8.0</strong>, mettez d'abord à jour vers la dernière version de NinjaTrader 8.</li><li>Si une évaluation fraîchement achetée n'est toujours pas listée, laissez-lui le temps d'être provisionnée, puis déconnectez-vous et reconnectez-vous sur Simulation.</li><li>Si le compte n'apparaît jamais avec le bon environnement et les bons identifiants, le blocage se situe côté firme. Contactez le support de votre prop firm pour confirmer que l'évaluation est active et provisionnée ; Tradovate ne peut ni activer ni voir le statut d'un compte appartenant à une firme. Les règles, les limites de drawdown et les tailles de compte varient selon la firme et la taille du compte ; vérifiez donc les conditions actuelles de votre firme.</li></ol>" },
    { type: "heading",text: "Tableau de dépannage" },
    { type: "table", headers: ["Symptôme","Ce que cela signifie","Solution"], rows: [
      ["Message « No accounts were found for this account type »","La connexion a fonctionné, mais l'environnement choisi ne contient aucun de vos comptes","Régler l'Account Type de la connexion sur Simulation pour une évaluation, puis se reconnecter"],
      ["Onglet Accounts vide après la connexion","Mauvais Account Type, mauvais identifiants ou Multi-provider désactivé","Confirmer Simulation, utiliser les identifiants Tradovate émis par la firme et activer Multi-provider"],
      ["Le compte apparaît sous Live avec des données différées","Vous êtes probablement dans le mauvais environnement pour une évaluation de prop firm","Se reconnecter sur Simulation ; les données différées relèvent d'un problème de droits distinct"],
      ["Bon environnement + bons identifiants, toujours rien","L'évaluation n'est pas encore activée ou provisionnée par la firme","Laisser du temps, puis contacter votre prop firm pour qu'elle l'active et la provisionne"],
      ["Connexion impossible","Vous utilisez NinjaTrader 8.0, qui ne peut pas joindre Tradovate","Mettre à jour vers la build 8.1.2.1 ou ultérieure, puis configurer la connexion"],
      ["Échecs répétés puis verrouillage","Trop de tentatives dans le mauvais environnement","Cesser de réessayer, attendre la fin du délai, puis se reconnecter sur Simulation"],
    ] },
    { type: "heading",text: "Évitez cela avec PickMyTrade" },
    { type: "paragraph",html: "Une fois que vous savez que votre évaluation se trouve sur le moteur de simulation, l'objectif est simple : vous connecter une fois au bon compte et cesser de lutter contre le bascule Live ou Simulation à chaque session. C'est là qu'une couche d'automatisation fait ses preuves. PickMyTrade relie vos alertes TradingView directement au compte Tradovate précis que vous autorisez, de sorte que votre flux d'ordres ne dépend pas du fait qu'une connexion de bureau soit réglée sur le bon environnement exact à chaque fois que vous vous installez pour trader." },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Routage vers le bon compte</strong> : autorisez une fois le compte d'évaluation exact, et chaque alerte y va, sans Account Type à rechoisir à chaque lancement.",
        "<strong class='text-white'>Livraison directe de l'alerte vers Tradovate</strong> : les ordres atteignent votre compte sans transiter par une plateforme de bureau distincte qui peut discrètement se désynchroniser.",
        "<strong class='text-white'>Synchronisation multi-comptes</strong> : répliquez le même signal sur plusieurs évaluations depuis un seul endroit, au lieu de monter et configurer chaque connexion à la main.",
        "<strong class='text-white'>Connexion à configurer une seule fois</strong> : un lien enregistré signifie que vous n'avez pas à vous réauthentifier ni à resélectionner un environnement sur chaque appareil depuis lequel vous tradez.",
      ],
    },
  ], it: [
    { type: "paragraph",html: "Digita il Suo nome utente e la password Tradovate, NinjaTrader si connette senza lamentele e poi&hellip; niente. La scheda Accounts resta vuota, oppure riceve un secco <strong class='text-white'>«No accounts were found for this account type.»</strong> Le credenziali hanno chiaramente funzionato, perché ha superato il passaggio di login, quindi dov'è finito il Suo conto di valutazione? Quasi sempre tutto dipende da un'unica impostazione: l'<strong class='text-white'>Account Type</strong> che ha scelto nella connessione NinjaTrader non corrisponde all'ambiente in cui si trova realmente il Suo conto. Una valutazione di prop firm Tradovate funziona sul motore di <strong class='text-white'>simulazione</strong> di Tradovate, quindi la connessione deve essere impostata su <strong class='text-white'>Simulation</strong>, non su <strong class='text-white'>Live</strong>. Se sceglie Live, NinjaTrader va a cercare il Suo conto nel mondo del brokeraggio reale, non ne trova nessuno associato a quelle credenziali e segnala zero conti. Di seguito spiego cosa significa davvero il messaggio, le poche cose che lo scatenano e i passaggi esatti per far comparire la Sua valutazione nella scheda Accounts, oltre a come instradare i Suoi alert tramite automazione eviti che una connessione desktop capricciosa si frapponga tra Lei e le Sue esecuzioni." },
    {
      type: "checklist",
      heading: "Checklist rapida per l'errore No Accounts Found",
      items: [
        "<strong class='text-white'>Imposti l'Account Type su Simulation</strong> per qualsiasi conto di prop firm o di valutazione, perché è lì che questi conti risiedono su Tradovate.",
        "<strong class='text-white'>Usi le credenziali Tradovate emesse dalla Sua azienda</strong>, non l'e-mail e la password del Suo NinjaTrader Account Dashboard.",
        "<strong class='text-white'>Abiliti Multi-provider</strong> (Tools &gt; Options/Settings &gt; General) e riavvii NinjaTrader se esegue più di una connessione.",
        "<strong class='text-white'>Un Account Type per connessione</strong>: se Le servono sia Live sia Simulation, crei una connessione separata per ciascuno.",
        "<strong class='text-white'>Dia a una nuova valutazione il tempo di essere predisposta</strong>: un conto appena acquistato potrebbe non comparire nell'istante in cui si connette.",
        "<strong class='text-white'>Confermi di essere sulla build 8.1.2.1 o successiva</strong>: NinjaTrader 8.0 non può connettersi a Tradovate in primo luogo.",
      ],
    },
    { type: "heading",text: "Cosa significa «No Accounts Were Found for This Account Type»" },
    { type: "paragraph",html: "Questo messaggio confonde perché il login stesso è andato a buon fine. NinjaTrader ha consegnato le Sue credenziali a Tradovate, Tradovate le ha accettate e si è aperta una sessione. La parola «found» è rivelatrice: NinjaTrader si è connesso correttamente, poi ha chiesto a Tradovate i conti che Le appartengono <em>nell'ambiente che ha selezionato</em> e ha ricevuto una lista vuota." },
    { type: "paragraph",html: "Tradovate gestisce due mondi separati. C'è un ambiente <strong class='text-white'>Live</strong> per conti di brokeraggio reali, finanziati direttamente, e un ambiente <strong class='text-white'>Simulation</strong> in cui risiede ogni conto di paper trading e di valutazione di prop firm. Quando la Sua prop firm La configura, la Sua valutazione viene creata nel mondo della simulazione. Le credenziali che Le hanno fornito corrispondono a un conto solo lì. Quindi, se lascia la connessione NinjaTrader sull'Account Type Live, NinjaTrader interroga il lato del brokeraggio reale, non vede conti associati a quel login e mostra «no accounts found». Stesse credenziali, quartiere sbagliato." },
    { type: "paragraph",html: "Vedere la parola «Simulation» associata a una valutazione che sembra finanziata disorienta alcuni trader, ma è previsto e corretto. Una valutazione di prop firm è un conto simulato con regole reali e pagamenti reali in gioco. Si connette comunque tramite l'ambiente di simulazione, e scegliere Simulation in NinjaTrader è esattamente giusto." },
    { type: "heading",text: "Cause principali della scheda Accounts vuota" },
    { type: "heading",text: "1. Ha scelto l'Account Type sbagliato (Live invece di Simulation)" },
    { type: "paragraph",html: "È la causa numero uno. La configurazione della connessione Le offre una scelta di Account Type, e Live si seleziona facilmente per riflesso, poiché una valutazione finanziata <em>sembra</em> dover essere Live. Ma le credenziali della Sua valutazione non esistono nell'ambiente Live, quindi NinjaTrader non riesce a trovare un solo conto e non ne segnala alcuno. Per un conto Tradovate personale finanziato direttamente con il Suo denaro, Live è corretto; per una valutazione di prop firm, no." },
    { type: "heading",text: "2. Sta usando le credenziali sbagliate" },
    { type: "paragraph",html: "I login Tradovate delle prop firm sono separati dal login del Suo NinjaTrader Account Dashboard. L'e-mail e la password della dashboard La fanno entrare in NinjaTrader stesso; le credenziali della piattaforma Tradovate che la Sua azienda Le invia (spesso in un messaggio di credenziali dati) sono quelle di cui ha bisogno la connessione Tradovate. Se inserisce l'e-mail della dashboard dove NinjaTrader si aspetta il login Tradovate, a seconda del flusso fallirà l'autenticazione oppure si connetterà a un ambiente privo di qualsiasi Suo conto." },
    { type: "heading",text: "3. Multi-provider non è abilitato" },
    { type: "paragraph",html: "NinjaTrader viene fornito con una propria connessione di simulatore integrata. Per eseguire una seconda connessione accanto ad essa, o più conti prop contemporaneamente, deve prima attivare Multi-provider. Se salta questo passaggio, NinjaTrader potrebbe non permettere alla connessione Tradovate di stabilirsi correttamente, il che si manifesta come conti che non si popolano mai. Inoltre ogni connessione gestisce un solo Account Type, quindi una connessione Live e una connessione Simulation sono due voci diverse." },
    { type: "heading",text: "4. La valutazione non è ancora attivata o predisposta" },
    { type: "paragraph",html: "Se l'ambiente e le credenziali sono corretti e la scheda resta vuota, il conto potrebbe non essere ancora pienamente attivo lato azienda. La predisposizione può essere in ritardo rispetto all'acquisto e, finché il sistema dell'azienda non ha finito di creare e abilitare il conto, NinjaTrader non ha nulla da elencare. Alcuni conti richiedono inoltre di accedere una volta al Tradovate web trader e di accettare gli accordi sui dati prima di comparire nei software di terze parti." },
    { type: "heading",text: "5. NinjaTrader 8.0 non può connettersi affatto" },
    { type: "paragraph",html: "Le vecchie installazioni sono una trappola. NinjaTrader 8.0 è precedente al supporto di Tradovate e non si connetterà a un conto Tradovate, quindi non si arriva nemmeno alla fase di elenco dei conti. Serve la build <strong class='text-white'>8.1.2.1 o successiva</strong>. Se non è sicuro di cosa stia eseguendo, vale la pena controllare prima di perdere tempo con le impostazioni dell'Account Type." },
    { type: "heading",text: "Come risolvere: passo dopo passo" },
    { type: "heading",text: "Correzione 1: imposti l'Account Type della connessione su Simulation" },
    { type: "paragraph",html: "<ol><li>Apra il <strong class='text-white'>Control Center</strong> di NinjaTrader, poi vada su <strong class='text-white'>Connections &gt; Configure</strong>.</li><li>Aggiunga una nuova connessione oppure selezioni la Sua connessione Tradovate esistente per modificarla.</li><li>Inserisca il <strong class='text-white'>nome utente e la password Tradovate emessi dalla Sua prop firm</strong> per la piattaforma, non l'e-mail della Sua dashboard NinjaTrader.</li><li>Trovi il selettore <strong class='text-white'>Account Type</strong> e lo imposti su <strong class='text-white'>Simulation</strong> per un conto di prop firm o di valutazione. (Scelga Live solo per un conto di brokeraggio Tradovate personale, finanziato direttamente.)</li><li>Salvi, poi si connetta. Attenda un momento e la Sua valutazione dovrebbe popolare la scheda <strong class='text-white'>Accounts</strong>. Una connessione sana diventa verde nel Control Center.</li></ol>" },
    { type: "paragraph",html: "Se in precedenza ha configurato una connessione Live e ha ottenuto l'errore, non si limiti a cambiare l'impostazione a sessione in corso e a continuare a riprovare. Si disconnetta completamente, corregga l'Account Type e si riconnetta in modo pulito. Martellare ripetutamente una connessione che fallisce può causare un blocco temporaneo oltre al problema originale." },
    { type: "heading",text: "Correzione 2: abiliti Multi-provider e confermi le Sue credenziali" },
    { type: "paragraph",html: "<ol><li>Nel Control Center, apra <strong class='text-white'>Tools &gt; Options</strong> (etichettato <strong class='text-white'>Settings</strong> in alcune build) e vada alla sezione <strong class='text-white'>General</strong>.</li><li>Spunti la casella <strong class='text-white'>Multi-provider</strong>, faccia clic su <strong class='text-white'>OK</strong> e <strong class='text-white'>riavvii NinjaTrader</strong> affinché la modifica abbia effetto.</li><li>Riapra <strong class='text-white'>Connections &gt; Configure</strong> e configuri di nuovo la connessione Tradovate, se necessario.</li><li>Ricontrolli il login: incolli il nome utente e la password Tradovate della Sua azienda, poi li digiti di nuovo a mano per eliminare eventuali spazi iniziali superflui o un primo carattere trasformato automaticamente in minuscolo che il copia-incolla può introdurre.</li></ol>" },
    { type: "heading",text: "Correzione 3: confermi attivazione e versione e, se necessario, faccia escalation" },
    { type: "paragraph",html: "<ol><li>Acceda una volta al Tradovate web trader con le stesse credenziali, completi eventuali richieste del profilo e accetti gli accordi sui dati, così che il conto sia pienamente abilitato per piattaforme esterne.</li><li>Controlli la Sua build NinjaTrader in <strong class='text-white'>Help &gt; About</strong>. Se inizia con <strong class='text-white'>8.0</strong>, aggiorni prima di tutto all'ultima versione di NinjaTrader 8.</li><li>Se una valutazione appena acquistata non è ancora elencata, Le dia il tempo di essere predisposta, poi si disconnetta e si riconnetta su Simulation.</li><li>Se il conto non compare mai con l'ambiente e le credenziali corretti, il ritardo è lato azienda. Contatti il supporto della Sua prop firm per confermare che la valutazione sia attiva e predisposta; Tradovate non può abilitare né vedere lo stato di un conto di proprietà di un'azienda. Regole, limiti di drawdown e dimensioni dei conti variano in base all'azienda e alla dimensione del conto, quindi controlli i termini attuali della Sua azienda.</li></ol>" },
    { type: "heading",text: "Tabella di risoluzione dei problemi" },
    { type: "table", headers: ["Sintomo","Cosa significa","Soluzione"], rows: [
      ["Messaggio «No accounts were found for this account type»","Il login ha funzionato, ma l'ambiente scelto non contiene alcuno dei Suoi conti","Impostare l'Account Type della connessione su Simulation per una valutazione, poi riconnettersi"],
      ["Scheda Accounts vuota dopo la connessione","Account Type sbagliato, login sbagliato o Multi-provider disattivato","Confermare Simulation, usare le credenziali Tradovate emesse dall'azienda e abilitare Multi-provider"],
      ["Il conto compare sotto Live con dati ritardati","Probabilmente si trova nell'ambiente sbagliato per una valutazione di prop firm","Riconnettersi su Simulation; i dati ritardati sono un problema di abilitazione separato"],
      ["Ambiente e login corretti, ancora niente","La valutazione non è ancora stata attivata o predisposta dall'azienda","Dare tempo, poi contattare la Sua prop firm perché la abiliti e la predisponga"],
      ["Impossibile connettersi","Esegue NinjaTrader 8.0, che non può raggiungere Tradovate","Aggiornare alla build 8.1.2.1 o successiva, poi configurare la connessione"],
      ["Errori ripetuti e poi blocco","Troppi tentativi nell'ambiente sbagliato","Smettere di riprovare, attendere la fine del periodo di attesa, poi riconnettersi su Simulation"],
    ] },
    { type: "heading",text: "Lo eviti con PickMyTrade" },
    { type: "paragraph",html: "Una volta che sa che la Sua valutazione risiede sul motore di simulazione, l'obiettivo è semplice: connettersi una volta al conto giusto e smettere di lottare ogni sessione con l'interruttore Live o Simulation. È qui che uno strato di automazione si fa valere. PickMyTrade collega i Suoi alert TradingView direttamente allo specifico conto Tradovate che autorizza, così il Suo flusso di ordini non dipende dal fatto che una connessione desktop sia impostata sull'ambiente esatto ogni volta che si siede a operare." },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Instradamento verso il conto corretto</strong>: autorizzi una volta l'esatto conto di valutazione e ogni alert va lì, senza dover riscegliere un Account Type a ogni avvio.",
        "<strong class='text-white'>Consegna diretta dall'alert a Tradovate</strong>: gli ordini raggiungono il Suo conto senza passare per una piattaforma desktop separata che può perdere la sincronizzazione senza che se ne accorga.",
        "<strong class='text-white'>Sincronizzazione multi-conto</strong>: replichi lo stesso segnale su più valutazioni da un unico posto, invece di montare e configurare a mano ogni connessione.",
        "<strong class='text-white'>Connessione una tantum</strong>: un collegamento memorizzato significa che non deve riautenticarsi né riselezionare un ambiente su ogni dispositivo da cui opera.",
      ],
    },
  ] },
  ctaHeading: { en: "Trade Rejection-Free", de: "Handeln ohne Ablehnungen", es: "Opere sin rechazos", fr: "Tradez sans rejet", it: "Operi senza rifiuti" },
  ctaText: { en: "Authorize the exact evaluation account once. PickMyTrade routes every alert there, with no Account Type to re-pick each session.", de: "Autorisieren Sie das genaue Evaluationskonto einmal. PickMyTrade leitet jeden Alert dorthin, ohne dass Sie bei jeder Sitzung einen Account Type neu wählen müssen.", es: "Autorice la cuenta de evaluación exacta una sola vez. PickMyTrade enruta cada alerta allí, sin tener que volver a elegir un Account Type en cada sesión.", fr: "Autorisez une seule fois le compte d'évaluation exact. PickMyTrade y achemine chaque alerte, sans Account Type à rechoisir à chaque session.", it: "Autorizzi una sola volta l'esatto conto di valutazione. PickMyTrade instrada ogni alert lì, senza dover riscegliere un Account Type a ogni sessione." },
  ctaButtonText: { en: "Start Your Free 7-Day Trial", de: "Starten Sie Ihre kostenlose 7-Tage-Testphase", es: "Comience su prueba gratuita de 7 días", fr: "Commencez votre essai gratuit de 7 jours", it: "Inizi la prova gratuita di 7 giorni" },
  ctaUrl: "https://app.pickmytrade.trade/?register=true&utm_source=content&utm_medium=debugging",
  faqHeading: { en: "Frequently Asked Questions", de: "Häufig gestellte Fragen", es: "Preguntas frecuentes", fr: "Questions fréquentes", it: "Domande frequenti" },
  faqs: { en: [
    { q: "Why does NinjaTrader say no accounts found when my Tradovate password worked?", a: "Because the login succeeded but the Account Type you picked in the connection doesn't hold your account. A prop-firm evaluation lives in Tradovate's simulation environment, so set the connection's Account Type to Simulation, not Live. Live searches the real-brokerage side, finds nothing tied to those credentials, and returns no accounts." },
    { q: "Should a Tradovate evaluation account be Live or Simulation in NinjaTrader?", a: "Simulation. Prop-firm evaluations and simulated-funded accounts run on Tradovate's simulation engine, so the connection's Account Type must be set to Simulation. Live is only for a real, directly funded Tradovate brokerage account with your own capital." },
    { q: "I selected Simulation and it still shows no accounts. Now what?", a: "Confirm you entered the Tradovate credentials your prop firm issued rather than your NinjaTrader Account Dashboard login, that the evaluation is activated on the firm's side, and that a freshly purchased account has had time to provision. Then disconnect, reconnect, and check the Accounts tab again." },
    { q: "Do I use my NinjaTrader login or my Tradovate login for the connection?", a: "Enter the Tradovate username and password issued for the platform. For prop-firm accounts that's a separate login from your NinjaTrader Account Dashboard email, usually delivered in a Tradovate data-credentials message from the firm." },
    { q: "Why do I need to enable Multi-provider in NinjaTrader?", a: "Multi-provider lets NinjaTrader run more than one connection at the same time, which you need when you keep the built-in simulator plus a Tradovate connection, or several prop accounts. Turn it on under Tools > Options (or Settings) > General, click OK, and restart the platform before adding the Tradovate connection." },
    { q: "The account shows up under Live but the data is delayed. Is that correct?", a: "For an evaluation, no. If an account appears under Live with delayed data or it isn't the eval you expected, you're likely on the wrong environment. Reconnect with the Account Type set to Simulation for a prop-firm evaluation. Delayed market data is a separate entitlement matter from the no-accounts error." },
    { q: "How long does a new evaluation take to appear in NinjaTrader?", a: "It can lag behind your purchase. A newly provisioned evaluation may take a while before it shows in the Control Center Accounts tab. Log out and back in, give it time, and if it still never appears with the correct environment and credentials, contact your prop firm to confirm the account is active." },
    { q: "Does my NinjaTrader version matter for this error?", a: "Yes, indirectly. NinjaTrader 8.0 cannot connect to Tradovate at all, so run build 8.1.2.1 or later. Get a working connection first, then fix the Account Type, and the evaluation will populate the Accounts tab." },
  ], de: [
    { q: "Warum meldet NinjaTrader „no accounts found“, obwohl mein Tradovate-Passwort funktioniert hat?", a: "Weil der Login erfolgreich war, der in der Verbindung gewählte Account Type Ihr Konto aber nicht enthält. Eine Prop-Firma-Evaluation liegt in der Simulationsumgebung von Tradovate. Setzen Sie den Account Type der Verbindung daher auf Simulation, nicht auf Live. Live durchsucht die Seite der echten Brokerage, findet nichts, das mit diesen Zugangsdaten verknüpft ist, und gibt keine Konten zurück." },
    { q: "Sollte ein Tradovate-Evaluationskonto in NinjaTrader Live oder Simulation sein?", a: "Simulation. Prop-Firma-Evaluationen und simulierte Funded-Konten laufen auf der Simulations-Engine von Tradovate, daher muss der Account Type der Verbindung auf Simulation stehen. Live ist nur für ein echtes, direkt finanziertes Tradovate-Brokerage-Konto mit Ihrem eigenen Kapital gedacht." },
    { q: "Ich habe Simulation gewählt und es werden trotzdem keine Konten angezeigt. Was nun?", a: "Prüfen Sie, dass Sie die von Ihrer Prop-Firma ausgestellten Tradovate-Zugangsdaten eingegeben haben und nicht Ihren Login des NinjaTrader Account Dashboards, dass die Evaluation auf Seiten der Firma aktiviert ist und dass ein frisch gekauftes Konto genügend Zeit zur Bereitstellung hatte. Trennen Sie dann die Verbindung, verbinden Sie sich erneut und prüfen Sie den Reiter „Accounts“ noch einmal." },
    { q: "Verwende ich für die Verbindung meinen NinjaTrader-Login oder meinen Tradovate-Login?", a: "Geben Sie den für die Plattform ausgestellten Tradovate-Benutzernamen und das Passwort ein. Bei Prop-Firma-Konten ist das ein separater Login neben der E-Mail Ihres NinjaTrader Account Dashboards, meist übermittelt in einer Tradovate-Nachricht mit Datenzugangsdaten der Firma." },
    { q: "Warum muss ich Multi-provider in NinjaTrader aktivieren?", a: "Mit Multi-provider kann NinjaTrader mehr als eine Verbindung gleichzeitig betreiben. Das brauchen Sie, wenn Sie neben dem eingebauten Simulator eine Tradovate-Verbindung oder mehrere Prop-Konten nutzen. Aktivieren Sie die Option unter Tools > Options (oder Settings) > General, klicken Sie auf OK und starten Sie die Plattform neu, bevor Sie die Tradovate-Verbindung hinzufügen." },
    { q: "Das Konto erscheint unter Live, aber die Daten sind verzögert. Ist das korrekt?", a: "Bei einer Evaluation nein. Wenn ein Konto unter Live mit verzögerten Daten erscheint oder nicht die erwartete Eval ist, befinden Sie sich wahrscheinlich in der falschen Umgebung. Verbinden Sie sich bei einer Prop-Firma-Evaluation erneut mit dem Account Type Simulation. Verzögerte Marktdaten sind eine separate Berechtigungsfrage und haben mit dem Fehler „no accounts“ nichts zu tun." },
    { q: "Wie lange dauert es, bis eine neue Evaluation in NinjaTrader erscheint?", a: "Es kann dem Kauf hinterherhinken. Eine neu bereitgestellte Evaluation kann eine Weile brauchen, bis sie im Reiter „Accounts“ des Control Centers auftaucht. Melden Sie sich ab und wieder an, geben Sie ihr Zeit, und wenn sie mit der richtigen Umgebung und den richtigen Zugangsdaten nie erscheint, wenden Sie sich an Ihre Prop-Firma, um zu bestätigen, dass das Konto aktiv ist." },
    { q: "Spielt meine NinjaTrader-Version bei diesem Fehler eine Rolle?", a: "Ja, indirekt. NinjaTrader 8.0 kann sich überhaupt nicht mit Tradovate verbinden, verwenden Sie also Build 8.1.2.1 oder höher. Stellen Sie zuerst eine funktionierende Verbindung her, korrigieren Sie dann den Account Type, und die Evaluation füllt den Reiter „Accounts“." },
  ], es: [
    { q: "¿Por qué NinjaTrader dice «no accounts found» si mi contraseña de Tradovate funcionó?", a: "Porque el inicio de sesión tuvo éxito, pero el Account Type que eligió en la conexión no contiene su cuenta. Una evaluación de una firma de prop trading vive en el entorno de simulación de Tradovate, así que configure el Account Type de la conexión como Simulation, no como Live. Live busca en el lado del bróker real, no encuentra nada vinculado a esas credenciales y devuelve cero cuentas." },
    { q: "¿Una cuenta de evaluación de Tradovate debe ser Live o Simulation en NinjaTrader?", a: "Simulation. Las evaluaciones de firmas de prop trading y las cuentas fondeadas simuladas funcionan en el motor de simulación de Tradovate, por lo que el Account Type de la conexión debe estar en Simulation. Live es solo para una cuenta de bróker de Tradovate real, financiada directamente con su propio capital." },
    { q: "Seleccioné Simulation y sigue sin mostrar cuentas. ¿Y ahora qué?", a: "Confirme que introdujo las credenciales de Tradovate que emitió su firma de prop trading y no el acceso de su NinjaTrader Account Dashboard, que la evaluación está activada por parte de la firma y que una cuenta recién comprada ha tenido tiempo de aprovisionarse. Luego desconecte, vuelva a conectar y revise de nuevo la pestaña Accounts." },
    { q: "¿Uso mi acceso de NinjaTrader o mi acceso de Tradovate para la conexión?", a: "Introduzca el nombre de usuario y la contraseña de Tradovate emitidos para la plataforma. En las cuentas de firmas de prop trading, es un acceso distinto del correo de su NinjaTrader Account Dashboard, normalmente entregado en un mensaje de credenciales de datos de Tradovate de la firma." },
    { q: "¿Por qué necesito activar Multi-provider en NinjaTrader?", a: "Multi-provider permite que NinjaTrader ejecute más de una conexión al mismo tiempo, algo que necesita cuando mantiene el simulador integrado más una conexión de Tradovate, o varias cuentas de prop trading. Actívelo en Tools > Options (o Settings) > General, haga clic en OK y reinicie la plataforma antes de añadir la conexión de Tradovate." },
    { q: "La cuenta aparece en Live pero los datos tienen retraso. ¿Es correcto?", a: "En una evaluación, no. Si una cuenta aparece en Live con datos retrasados o no es la evaluación que esperaba, probablemente está en el entorno equivocado. Vuelva a conectarse con el Account Type en Simulation para una evaluación de una firma de prop trading. Los datos de mercado retrasados son una cuestión de derechos aparte del error de «no accounts»." },
    { q: "¿Cuánto tarda en aparecer una evaluación nueva en NinjaTrader?", a: "Puede ir por detrás de su compra. Una evaluación recién aprovisionada puede tardar un tiempo en mostrarse en la pestaña Accounts del Control Center. Cierre sesión y vuelva a entrar, dele tiempo y, si nunca aparece con el entorno y las credenciales correctos, contacte con su firma de prop trading para confirmar que la cuenta está activa." },
    { q: "¿Importa mi versión de NinjaTrader para este error?", a: "Sí, indirectamente. NinjaTrader 8.0 no puede conectarse a Tradovate en absoluto, así que utilice la compilación 8.1.2.1 o posterior. Consiga primero una conexión funcional, luego corrija el Account Type y la evaluación llenará la pestaña Accounts." },
  ], fr: [
    { q: "Pourquoi NinjaTrader affiche-t-il « no accounts found » alors que mon mot de passe Tradovate a fonctionné ?", a: "Parce que la connexion a réussi, mais l'Account Type choisi dans la connexion ne contient pas votre compte. Une évaluation de prop firm se trouve dans l'environnement de simulation de Tradovate ; réglez donc l'Account Type de la connexion sur Simulation, et non sur Live. Live interroge le côté courtier réel, ne trouve rien lié à ces identifiants et ne renvoie aucun compte." },
    { q: "Un compte d'évaluation Tradovate doit-il être en Live ou en Simulation dans NinjaTrader ?", a: "Simulation. Les évaluations de prop firms et les comptes financés simulés fonctionnent sur le moteur de simulation de Tradovate ; l'Account Type de la connexion doit donc être réglé sur Simulation. Live est réservé à un véritable compte de courtage Tradovate financé directement avec votre propre capital." },
    { q: "J'ai sélectionné Simulation et aucun compte n'apparaît toujours. Et maintenant ?", a: "Vérifiez que vous avez saisi les identifiants Tradovate émis par votre prop firm et non votre connexion NinjaTrader Account Dashboard, que l'évaluation est activée côté firme et qu'un compte fraîchement acheté a eu le temps d'être provisionné. Puis déconnectez-vous, reconnectez-vous et vérifiez à nouveau l'onglet Accounts." },
    { q: "Dois-je utiliser ma connexion NinjaTrader ou ma connexion Tradovate pour la liaison ?", a: "Saisissez le nom d'utilisateur et le mot de passe Tradovate émis pour la plateforme. Pour les comptes de prop firm, il s'agit d'une connexion distincte de l'e-mail de votre NinjaTrader Account Dashboard, généralement livrée dans un message d'identifiants de données Tradovate envoyé par la firme." },
    { q: "Pourquoi dois-je activer Multi-provider dans NinjaTrader ?", a: "Multi-provider permet à NinjaTrader d'exécuter plus d'une connexion à la fois, ce dont vous avez besoin lorsque vous gardez le simulateur intégré en plus d'une connexion Tradovate, ou plusieurs comptes de prop firm. Activez-le sous Tools > Options (ou Settings) > General, cliquez sur OK et redémarrez la plateforme avant d'ajouter la connexion Tradovate." },
    { q: "Le compte apparaît sous Live mais les données sont différées. Est-ce normal ?", a: "Pour une évaluation, non. Si un compte apparaît sous Live avec des données différées ou n'est pas l'évaluation attendue, vous êtes probablement dans le mauvais environnement. Reconnectez-vous avec l'Account Type réglé sur Simulation pour une évaluation de prop firm. Les données de marché différées relèvent d'un droit distinct de l'erreur « no accounts »." },
    { q: "Combien de temps faut-il à une nouvelle évaluation pour apparaître dans NinjaTrader ?", a: "Elle peut accuser un retard par rapport à votre achat. Une évaluation nouvellement provisionnée peut mettre un certain temps avant d'apparaître dans l'onglet Accounts du Control Center. Déconnectez-vous puis reconnectez-vous, laissez-lui du temps, et si elle n'apparaît jamais avec le bon environnement et les bons identifiants, contactez votre prop firm pour confirmer que le compte est actif." },
    { q: "Ma version de NinjaTrader a-t-elle une importance pour cette erreur ?", a: "Oui, indirectement. NinjaTrader 8.0 ne peut tout simplement pas se connecter à Tradovate ; utilisez donc la build 8.1.2.1 ou ultérieure. Obtenez d'abord une connexion fonctionnelle, puis corrigez l'Account Type, et l'évaluation remplira l'onglet Accounts." },
  ], it: [
    { q: "Perché NinjaTrader dice «no accounts found» quando la mia password Tradovate ha funzionato?", a: "Perché il login è riuscito, ma l'Account Type scelto nella connessione non contiene il Suo conto. Una valutazione di prop firm si trova nell'ambiente di simulazione di Tradovate, quindi imposti l'Account Type della connessione su Simulation, non su Live. Live cerca sul lato del broker reale, non trova nulla associato a quelle credenziali e restituisce zero conti." },
    { q: "Un conto di valutazione Tradovate deve essere Live o Simulation in NinjaTrader?", a: "Simulation. Le valutazioni delle prop firm e i conti finanziati simulati funzionano sul motore di simulazione di Tradovate, quindi l'Account Type della connessione deve essere impostato su Simulation. Live è solo per un vero conto di brokeraggio Tradovate finanziato direttamente con il Suo capitale." },
    { q: "Ho selezionato Simulation e non compaiono ancora conti. E adesso?", a: "Verifichi di aver inserito le credenziali Tradovate emesse dalla Sua prop firm e non il login del Suo NinjaTrader Account Dashboard, che la valutazione sia attivata lato azienda e che un conto appena acquistato abbia avuto il tempo di essere predisposto. Poi si disconnetta, si riconnetta e controlli di nuovo la scheda Accounts." },
    { q: "Per la connessione uso il mio login NinjaTrader o il mio login Tradovate?", a: "Inserisca il nome utente e la password Tradovate emessi per la piattaforma. Per i conti delle prop firm si tratta di un login separato rispetto all'e-mail del Suo NinjaTrader Account Dashboard, di solito consegnato in un messaggio di credenziali dati Tradovate da parte dell'azienda." },
    { q: "Perché devo abilitare Multi-provider in NinjaTrader?", a: "Multi-provider permette a NinjaTrader di eseguire più di una connessione contemporaneamente, cosa che Le serve quando mantiene il simulatore integrato più una connessione Tradovate, oppure più conti prop. Lo attivi in Tools > Options (o Settings) > General, faccia clic su OK e riavvii la piattaforma prima di aggiungere la connessione Tradovate." },
    { q: "Il conto compare sotto Live ma i dati sono ritardati. È corretto?", a: "Per una valutazione, no. Se un conto compare sotto Live con dati ritardati o non è la valutazione che si aspettava, probabilmente si trova nell'ambiente sbagliato. Si riconnetta con l'Account Type impostato su Simulation per una valutazione di prop firm. I dati di mercato ritardati sono una questione di abilitazione separata rispetto all'errore «no accounts»." },
    { q: "Quanto tempo impiega una nuova valutazione a comparire in NinjaTrader?", a: "Può essere in ritardo rispetto all'acquisto. Una valutazione appena predisposta può impiegare un po' di tempo prima di comparire nella scheda Accounts del Control Center. Esca e riaccede, Le dia tempo e, se non compare mai con l'ambiente e le credenziali corretti, contatti la Sua prop firm per confermare che il conto sia attivo." },
    { q: "La mia versione di NinjaTrader influisce su questo errore?", a: "Sì, indirettamente. NinjaTrader 8.0 non può connettersi affatto a Tradovate, quindi usi la build 8.1.2.1 o successiva. Ottenga prima una connessione funzionante, poi corregga l'Account Type, e la valutazione popolerà la scheda Accounts." },
  ] },
