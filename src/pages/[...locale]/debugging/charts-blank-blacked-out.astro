---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "charts-blank-blacked-out";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/debugging/${SLUG}`;

const META_TITLE = "Tradovate Charts Blank / Completely Blacked Out";
const META_DESCRIPTION =
  "Tradovate charts blank or completely blacked out? Refresh, clear cache, reload your workspace, or switch to mobile to get your charts back fast.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Tradovate-Charts leer oder komplett schwarz", es: "Gráficos de Tradovate en blanco o completamente en negro", fr: "Graphiques Tradovate vides ou totalement noirs", it: "Grafici Tradovate vuoti o completamente neri" },
  dek: { en: "Most blank-chart episodes clear in a couple of minutes with a refresh, a cache clear, or a workspace reload. The ones that don't are usually a Tradovate-side outage, here's how to tell which camp you're in.", de: "Die meisten leeren Charts beheben sich innerhalb weniger Minuten durch ein Neuladen, das Leeren des Caches oder das erneute Laden eines Workspace. Wenn nicht, liegt meist eine Störung bei Tradovate vor. So erkennen Sie, welcher Fall bei Ihnen vorliegt.", es: "La mayoría de los episodios de gráficos en blanco se resuelven en un par de minutos con una actualización, un vaciado de caché o una recarga del espacio de trabajo. Los que no se resuelven suelen deberse a una interrupción del lado de Tradovate. Así puede saber en qué caso se encuentra.", fr: "La plupart des épisodes de graphiques vides se résolvent en quelques minutes grâce à une actualisation, un vidage du cache ou un rechargement de l'espace de travail. Ceux qui persistent sont généralement dus à une panne côté Tradovate. Voici comment savoir dans quel cas vous vous trouvez.", it: "La maggior parte degli episodi di grafici vuoti si risolve in pochi minuti con un aggiornamento, la pulizia della cache o il ricaricamento del workspace. Quelli che non si risolvono sono di solito dovuti a un'interruzione lato Tradovate. Ecco come capire in quale caso vi trovate." },
  readTime: { en: "8 min read", de: "8 Minuten Lesezeit", es: "Lectura de 8 minutos", fr: "Lecture de 8 minutes", it: "Lettura di 8 minuti" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "When you're trading fast-moving futures like ES or NQ, few things rattle you like opening Tradovate to a blank chart, or worse, the whole platform blacked out with no candles, no DOM, and no way to see where price is. It shows up in a few flavors: a solid black screen right after login, panels stuck on “loading,” charts that go blank the moment you add a new account, or a chart that draws but drops every one of its indicators. Here's the reassuring part: most blank-chart episodes clear in a couple of minutes with a refresh, a cache clear, or a workspace reload. The ones that don't are usually a Tradovate-side outage, and a quick status check tells you which camp you're in. This guide walks every fix in the order you should try them, plus how to keep your automation running when the chart UI won't cooperate." },
    {
      type: "checklist",
      heading: "Quick Checklist for Blank / Blacked-Out Charts",
      items: [
        "<strong class='text-white'>Refresh first (F5 on web)</strong>, a single reload clears most transient blank-chart glitches.",
        "<strong class='text-white'>Log out and back in</strong>, forces the platform to rebuild its session and re-request chart data.",
        "<strong class='text-white'>Reload your saved Workspace</strong>, a blank layout is often just a reset workspace, not lost charts.",
        "<strong class='text-white'>Clear cache and cookies</strong>, resolves corrupted-render blackouts on web and the desktop client.",
        "<strong class='text-white'>Switch to mobile or web</strong>, if desktop is blacked out, the app that still works keeps you covered.",
        "<strong class='text-white'>Check status.tradovate.com</strong>, a full, persistent blackout across devices usually means a server-side incident, not your machine.",
      ],
    },
    { type: "heading", text: "What “Blank / Blacked-Out Charts” Actually Means in Tradovate" },
    { type: "paragraph", html: "A blank or blacked-out chart means the platform loaded but the charting area failed to render, you get an empty panel, a black rectangle, or a screen frozen on “loading.” It's a display and data-delivery problem, not (usually) an account problem: your positions, orders, and balances are still intact on Tradovate's servers even when you can't see the chart. That distinction matters, because it tells you where to look. If only the chart canvas is dark, the fix is almost always local, a stale cache, a reset layout, or a rendering hiccup. If the entire platform is blacked out on every device you own, the problem has moved upstream to Tradovate's data feed or servers." },
    { type: "paragraph", html: "Two patterns make the point. A full black screen that survives closing the app, reopening it, and even restarting your computer is a classic local-render failure, the kind that clearing the cache often clears for good. And a blackout that hits the desktop and web apps while the smartphone app keeps working is the textbook signature of a front-end rendering or workspace issue, not an account lockout. Both tell you to fix the machine in front of you, not to panic about your account." },
    { type: "heading", text: "Top Causes of Blank Tradovate Charts" },
    { type: "heading", text: "1. A transient rendering glitch" },
    { type: "paragraph", html: "The most common cause is also the most harmless: the charting engine simply failed to paint the canvas after login, a tab switch, or a network blip. A single refresh usually fixes it. That's exactly why “have you tried refreshing?” is the first thing support asks." },
    { type: "heading", text: "2. A corrupted or overstuffed cache" },
    { type: "paragraph", html: "Tradovate's web and desktop clients cache scripts, data, and drawings locally. When that cache goes stale or corrupt, charts can render blank or black. Clearing the cache and cookies for the last week fixes a lot of these blackouts outright. The honest caveat: if you've already cleared cache, history, and cookies and nothing changes, you're likely looking at a different, often server-side, cause." },
    { type: "heading", text: "3. A reset or unloaded Workspace" },
    { type: "paragraph", html: "Tradovate's Workspaces feature saves your full layout, charts, DOM, timeframes, and indicators, so it reappears next session. If a workspace gets reset or fails to auto-load, the platform can open to an empty or blank layout that looks like broken charts but is really just a missing saved setup. Reloading the saved workspace restores everything." },
    { type: "heading", text: "4. Browser or GPU rendering conflicts (web)" },
    { type: "paragraph", html: "Because Tradovate charts render in the browser, an aggressive extension, an out-of-date browser, or a graphics-acceleration conflict can leave the chart canvas blank while the rest of the page loads fine. Trying a different browser, disabling extensions, or toggling the browser's hardware-acceleration setting frequently brings the chart back." },
    { type: "heading", text: "5. A Tradovate-side outage or data-feed incident" },
    { type: "paragraph", html: "Sometimes it isn't you at all. When charts are blacked out on desktop, web, and mobile at the same time, and cache clearing and reinstalls change nothing, it's almost always a platform incident. Tradovate has acknowledged bugs like this and pushed in-app notices when they happen, and the charts typically come back on their own once the incident clears." },
    { type: "heading", text: "How to Fix Blank / Blacked-Out Charts: Step-by-Step" },
    { type: "paragraph", html: "Work through these in order. Stop as soon as your charts come back, you rarely need every step." },
    { type: "heading", text: "Fixing a transient glitch: refresh and re-login" },
    {
      type: "steps",
      items: [
        { title: "Refresh the page", html: "On the web platform, press <strong class='text-white'>F5</strong> (or your browser's reload button) to refresh the page." },
        { title: "Log out completely, then back in", html: "If the chart is still blank, log out completely, then log back in. This rebuilds the session and re-requests chart history from scratch." },
        { title: "Fully close and reopen the desktop app", html: "On the desktop client, fully close and reopen the app instead of pressing F5." },
      ],
    },
    { type: "heading", text: "Fixing an unloaded layout: reload your Workspace" },
    {
      type: "steps",
      items: [
        { title: "Open the + (New) menu", html: "Open the <strong class='text-white'>+ (New)</strong> menu where new panels and saved layouts live." },
        { title: "Reload your saved Workspace", html: "Look for your previously saved Workspace in the list and click it to reload your full chart-and-DOM setup." },
        { title: "Rebuild and save if none exists", html: "If no saved workspace exists, rebuild the layout you want and save it so it restores automatically next time." },
      ],
    },
    { type: "heading", text: "Fixing a corrupted cache: clear cache and cookies" },
    {
      type: "steps",
      items: [
        { title: "Clear cached images and cookies", html: "On the web platform, open your browser's privacy or history settings and choose to clear <strong class='text-white'>cached images and files</strong> plus <strong class='text-white'>cookies</strong> for the recent period." },
        { title: "Reload and log back in", html: "Reload Tradovate and log back in. The platform will rebuild a clean cache." },
        { title: "Uninstall and reinstall if needed", html: "On the desktop client, if a refresh and re-login don't help, uninstall and reinstall the app to reset its local cache, but see the note below, because a reinstall won't help if the cause is server-side." },
      ],
    },
    { type: "heading", text: "Fixing a browser/GPU conflict (web only)" },
    {
      type: "steps",
      items: [
        { title: "Try a different browser", html: "Try loading Tradovate in a different, up-to-date browser to rule out an extension or version issue." },
        { title: "Disable interfering extensions", html: "Disable browser extensions (ad blockers, script blockers) that can interfere with chart rendering." },
        { title: "Toggle hardware acceleration", html: "Toggle your browser's hardware-acceleration (GPU) setting off, restart the browser, and reload, canvas-rendered charts are sensitive to graphics-driver conflicts." },
      ],
    },
    { type: "heading", text: "Fixing a full blackout: switch devices and check status" },
    {
      type: "steps",
      items: [
        { title: "Switch to web or mobile", html: "If desktop is blacked out, open Tradovate on <strong class='text-white'>web or the mobile app</strong>, the working client keeps you able to monitor and manage positions." },
        { title: "Check status.tradovate.com", html: "Check <strong class='text-white'>status.tradovate.com</strong> (or your environment's service-status page) for an active incident or maintenance window." },
        { title: "Wait it out and report if unresolved", html: "If a platform-wide incident is confirmed, wait for it to clear and manage risk through the device that still works or a backup connection. Report a persistent, undocumented blackout to Tradovate support." },
      ],
    },
    { type: "heading", text: "Troubleshooting Table" },
    {
      type: "table",
      headers: ["Symptom", "Likely meaning", "First fix"],
      rows: [
        ["Chart panel blank after login or tab switch", "Transient render glitch", "Refresh (F5) / reopen the app"],
        ["Solid black screen stuck on “loading”", "Corrupted cache or platform incident", "Clear cache and cookies; check status page"],
        ["Charts blank right after adding a new account", "Stale cached session", "Clear cache and cookies, then re-login"],
        ["Empty or missing layout on login", "Reset / unloaded Workspace", "Reload your saved Workspace"],
        ["Chart draws but indicators disappear", "Front-end rendering bug", "Refresh; remove and re-add the indicator"],
        ["Blacked out on desktop, mobile still works", "Local render or workspace issue", "Switch device; clear cache on the broken one"],
        ["Blacked out on every device at once", "Tradovate-side outage", "Check status.tradovate.com and wait it out"],
      ],
    },
    { type: "heading", text: "Prevent This with PickMyTrade" },
    { type: "paragraph", html: "A blank chart is a display problem, but if you're relying on that chart to click your entries and exits, a blackout can cost you a fill at exactly the wrong moment. PickMyTrade takes the chart UI out of the critical path by routing your TradingView alerts straight to your Tradovate account, so your strategy keeps executing even when the front-end won't render." },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Server-Side Order Routing</strong>, alerts fire directly into your Tradovate account, so a blacked-out chart doesn't block your entries or exits.",
        "<strong class='text-white'>Platform-Independent Execution</strong>, automation runs whether or not the desktop, web, or mobile chart is drawing on screen.",
        "<strong class='text-white'>Multi-Account Sync</strong>, mirrors each order across your connected accounts, so a UI glitch on one device doesn't desync the rest.",
        "<strong class='text-white'>Alert Logging</strong>, keeps a record of every signal so you can reconcile fills the moment your charts come back.",
      ],
    },
  ], de: [
    { type: "paragraph", html: "Wenn Sie schnelllebige Futures wie ES oder NQ handeln, gibt es wenig, das so beunruhigt wie ein Tradovate-Chart, der beim Öffnen leer bleibt, oder schlimmer noch, eine komplett schwarze Plattform ohne Kerzen, ohne DOM und ohne jede Möglichkeit zu sehen, wo der Preis steht. Das Problem zeigt sich in verschiedenen Formen: ein durchgehend schwarzer Bildschirm direkt nach dem Login, Panels, die bei „loading“ hängen bleiben, Charts, die leer werden, sobald Sie ein neues Konto hinzufügen, oder ein Chart, der zwar zeichnet, aber sämtliche Indikatoren verliert. Die gute Nachricht: Die meisten leeren Charts beheben sich innerhalb weniger Minuten durch ein Neuladen, das Leeren des Caches oder das erneute Laden eines Workspace. Wenn nicht, liegt meist eine Störung bei Tradovate vor, und ein kurzer Blick auf die Statusseite zeigt Ihnen, welcher Fall zutrifft. Diese Anleitung führt Sie durch jede Lösung in der Reihenfolge, in der Sie sie ausprobieren sollten, sowie durch Möglichkeiten, Ihre Automatisierung weiterlaufen zu lassen, wenn die Chart-Oberfläche nicht mitspielt." },
    {
      type: "checklist",
      heading: "Schnelle Checkliste für leere / schwarze Charts",
      items: [
        "<strong class='text-white'>Zuerst aktualisieren (F5 im Web)</strong>, ein einziges Neuladen behebt die meisten vorübergehenden Chart-Aussetzer.",
        "<strong class='text-white'>Abmelden und erneut anmelden</strong>, zwingt die Plattform, die Sitzung neu aufzubauen und die Chart-Daten erneut anzufordern.",
        "<strong class='text-white'>Gespeicherten Workspace neu laden</strong>, ein leeres Layout ist oft nur ein zurückgesetzter Workspace, keine verlorenen Charts.",
        "<strong class='text-white'>Cache und Cookies leeren</strong>, behebt durch fehlerhaftes Rendering verursachte Blackouts im Web und im Desktop-Client.",
        "<strong class='text-white'>Zu Mobile oder Web wechseln</strong>, ist der Desktop schwarz, hält Sie die noch funktionierende App handlungsfähig.",
        "<strong class='text-white'>status.tradovate.com prüfen</strong>, ein vollständiger, anhaltender Blackout auf allen Geräten bedeutet meist einen serverseitigen Vorfall, nicht ein Problem Ihres Geräts.",
      ],
    },
    { type: "heading", text: "Was „leere / schwarze Charts“ bei Tradovate tatsächlich bedeutet" },
    { type: "paragraph", html: "Ein leerer oder schwarzer Chart bedeutet, dass die Plattform geladen hat, der Chart-Bereich aber nicht gerendert werden konnte: Sie sehen ein leeres Panel, ein schwarzes Rechteck oder einen Bildschirm, der bei „loading“ hängen bleibt. Es handelt sich um ein Anzeige- und Datenzustellungsproblem, in der Regel nicht um ein Kontoproblem: Ihre Positionen, Orders und Salden bleiben auf Tradovates Servern intakt, auch wenn Sie den Chart nicht sehen können. Diese Unterscheidung ist wichtig, denn sie zeigt Ihnen, wo Sie suchen müssen. Ist nur die Chart-Fläche dunkel, liegt die Ursache fast immer lokal, etwa ein veralteter Cache, ein zurückgesetztes Layout oder ein Rendering-Aussetzer. Ist die gesamte Plattform auf allen Ihren Geräten schwarz, liegt das Problem weiter oben, bei Tradovates Datenfeed oder Servern." },
    { type: "paragraph", html: "Zwei Muster verdeutlichen das. Ein vollständig schwarzer Bildschirm, der das Schließen und Neuöffnen der App und sogar einen Neustart des Computers übersteht, ist ein klassischer lokaler Rendering-Fehler, den das Leeren des Caches oft endgültig behebt. Und ein Blackout, der Desktop- und Web-App betrifft, während die Smartphone-App weiterläuft, ist das Lehrbuchbeispiel für ein Frontend-Rendering- oder Workspace-Problem, nicht für eine Kontosperrung. Beides zeigt Ihnen: Beheben Sie das Problem am Gerät vor Ihnen, statt sich wegen Ihres Kontos zu sorgen." },
    { type: "heading", text: "Häufigste Ursachen für leere Tradovate-Charts" },
    { type: "heading", text: "1. Ein vorübergehender Rendering-Fehler" },
    { type: "paragraph", html: "Die häufigste Ursache ist zugleich die harmloseste: Die Chart-Engine hat die Zeichenfläche nach dem Login, einem Tab-Wechsel oder einer kurzen Netzwerkstörung einfach nicht gezeichnet. Ein einziges Neuladen behebt das meist. Genau deshalb fragt der Support als Erstes: „Haben Sie schon aktualisiert?“" },
    { type: "heading", text: "2. Ein beschädigter oder überfüllter Cache" },
    { type: "paragraph", html: "Die Web- und Desktop-Clients von Tradovate speichern Skripte, Daten und Zeichnungen lokal zwischen. Wird dieser Cache veraltet oder beschädigt, können Charts leer oder schwarz bleiben. Das Leeren von Cache und Cookies der letzten Woche behebt viele dieser Blackouts direkt. Ehrlich gesagt: Wenn Sie Cache, Verlauf und Cookies bereits geleert haben und sich nichts ändert, liegt wahrscheinlich eine andere, oft serverseitige, Ursache vor." },
    { type: "heading", text: "3. Ein zurückgesetzter oder nicht geladener Workspace" },
    { type: "paragraph", html: "Die Workspace-Funktion von Tradovate speichert Ihr komplettes Layout, Charts, DOM, Zeitrahmen und Indikatoren, damit es in der nächsten Sitzung wieder erscheint. Wird ein Workspace zurückgesetzt oder lädt er nicht automatisch, kann die Plattform mit einem leeren Layout starten, das wie defekte Charts aussieht, in Wirklichkeit aber nur eine fehlende gespeicherte Einrichtung ist. Das erneute Laden des gespeicherten Workspace stellt alles wieder her." },
    { type: "heading", text: "4. Browser- oder GPU-Rendering-Konflikte (Web)" },
    { type: "paragraph", html: "Da Tradovate-Charts im Browser gerendert werden, können eine aggressive Erweiterung, ein veralteter Browser oder ein Konflikt bei der Grafikbeschleunigung die Chart-Fläche leer lassen, während der Rest der Seite normal lädt. Ein anderer Browser, das Deaktivieren von Erweiterungen oder das Umschalten der Hardwarebeschleunigung im Browser bringt den Chart häufig zurück." },
    { type: "heading", text: "5. Eine Störung bei Tradovate oder ein Vorfall beim Datenfeed" },
    { type: "paragraph", html: "Manchmal liegt es überhaupt nicht an Ihnen. Sind Charts auf Desktop, Web und Mobile gleichzeitig schwarz und ändert sich weder durch Cache-Leeren noch durch Neuinstallation etwas, handelt es sich fast immer um einen Vorfall auf Plattformebene. Tradovate hat solche Fehler bereits bestätigt und dazu In-App-Hinweise veröffentlicht; die Charts kehren in der Regel von selbst zurück, sobald der Vorfall behoben ist." },
    { type: "heading", text: "So beheben Sie leere / schwarze Charts: Schritt für Schritt" },
    { type: "paragraph", html: "Gehen Sie diese Schritte der Reihe nach durch. Hören Sie auf, sobald Ihre Charts wieder erscheinen, selten sind alle Schritte nötig." },
    { type: "heading", text: "Vorübergehenden Fehler beheben: Aktualisieren und erneut anmelden" },
    {
      type: "steps",
      items: [
        { title: "Seite aktualisieren", html: "Drücken Sie auf der Web-Plattform <strong class='text-white'>F5</strong> (oder die Neuladen-Schaltfläche Ihres Browsers), um die Seite zu aktualisieren." },
        { title: "Vollständig abmelden und erneut anmelden", html: "Bleibt der Chart leer, melden Sie sich vollständig ab und anschließend wieder an. Dadurch wird die Sitzung neu aufgebaut und der Chart-Verlauf komplett neu angefordert." },
        { title: "Desktop-App vollständig schließen und neu öffnen", html: "Schließen Sie im Desktop-Client die App vollständig und öffnen Sie sie erneut, statt F5 zu drücken." },
      ],
    },
    { type: "heading", text: "Nicht geladenes Layout beheben: Workspace neu laden" },
    {
      type: "steps",
      items: [
        { title: "Das Menü + (Neu) öffnen", html: "Öffnen Sie das Menü <strong class='text-white'>+ (Neu)</strong>, in dem neue Panels und gespeicherte Layouts zu finden sind." },
        { title: "Gespeicherten Workspace neu laden", html: "Suchen Sie in der Liste nach Ihrem zuvor gespeicherten Workspace und klicken Sie darauf, um Ihre vollständige Chart- und DOM-Einrichtung neu zu laden." },
        { title: "Bei Bedarf neu erstellen und speichern", html: "Existiert kein gespeicherter Workspace, erstellen Sie das gewünschte Layout neu und speichern Sie es, damit es beim nächsten Mal automatisch wiederhergestellt wird." },
      ],
    },
    { type: "heading", text: "Beschädigten Cache beheben: Cache und Cookies leeren" },
    {
      type: "steps",
      items: [
        { title: "Zwischengespeicherte Bilder und Cookies löschen", html: "Öffnen Sie auf der Web-Plattform die Datenschutz- oder Verlaufseinstellungen Ihres Browsers und wählen Sie, für den letzten Zeitraum <strong class='text-white'>zwischengespeicherte Bilder und Dateien</strong> sowie <strong class='text-white'>Cookies</strong> zu löschen." },
        { title: "Neu laden und erneut anmelden", html: "Laden Sie Tradovate neu und melden Sie sich erneut an. Die Plattform baut daraufhin einen sauberen Cache auf." },
        { title: "Bei Bedarf deinstallieren und neu installieren", html: "Helfen Aktualisieren und erneutes Anmelden im Desktop-Client nicht, deinstallieren und installieren Sie die App neu, um den lokalen Cache zurückzusetzen. Beachten Sie jedoch den Hinweis unten, denn eine Neuinstallation hilft nicht, wenn die Ursache serverseitig liegt." },
      ],
    },
    { type: "heading", text: "Browser-/GPU-Konflikt beheben (nur Web)" },
    {
      type: "steps",
      items: [
        { title: "Anderen Browser ausprobieren", html: "Laden Sie Tradovate in einem anderen, aktuellen Browser, um ein Erweiterungs- oder Versionsproblem auszuschließen." },
        { title: "Störende Erweiterungen deaktivieren", html: "Deaktivieren Sie Browser-Erweiterungen (Werbeblocker, Skriptblocker), die das Chart-Rendering beeinträchtigen können." },
        { title: "Hardwarebeschleunigung umschalten", html: "Schalten Sie die Hardwarebeschleunigung (GPU) Ihres Browsers aus, starten Sie den Browser neu und laden Sie die Seite erneut, canvas-gerenderte Charts reagieren empfindlich auf Grafiktreiber-Konflikte." },
      ],
    },
    { type: "heading", text: "Vollständigen Blackout beheben: Gerät wechseln und Status prüfen" },
    {
      type: "steps",
      items: [
        { title: "Zu Web oder Mobile wechseln", html: "Ist der Desktop schwarz, öffnen Sie Tradovate im <strong class='text-white'>Web oder in der mobilen App</strong>, so bleiben Sie über den funktionierenden Client in der Lage, Positionen zu überwachen und zu verwalten." },
        { title: "status.tradovate.com prüfen", html: "Prüfen Sie <strong class='text-white'>status.tradovate.com</strong> (oder die Statusseite Ihrer Umgebung) auf einen aktiven Vorfall oder ein Wartungsfenster." },
        { title: "Abwarten und bei Bedarf melden", html: "Ist ein plattformweiter Vorfall bestätigt, warten Sie, bis er behoben ist, und steuern Sie Ihr Risiko über das noch funktionierende Gerät oder eine Ausweichverbindung. Melden Sie einen anhaltenden, nicht dokumentierten Blackout dem Tradovate-Support." },
      ],
    },
    { type: "heading", text: "Fehlerbehebungstabelle" },
    {
      type: "table",
      headers: ["Symptom", "Wahrscheinliche Ursache", "Erste Lösung"],
      rows: [
        ["Chart-Panel leer nach Login oder Tab-Wechsel", "Vorübergehender Rendering-Fehler", "Aktualisieren (F5) / App neu öffnen"],
        ["Durchgehend schwarzer Bildschirm bei „loading“", "Beschädigter Cache oder Plattform-Vorfall", "Cache und Cookies leeren; Statusseite prüfen"],
        ["Charts direkt nach Hinzufügen eines neuen Kontos leer", "Veraltete zwischengespeicherte Sitzung", "Cache und Cookies leeren, dann erneut anmelden"],
        ["Leeres oder fehlendes Layout beim Login", "Zurückgesetzter / nicht geladener Workspace", "Gespeicherten Workspace neu laden"],
        ["Chart wird gezeichnet, aber Indikatoren verschwinden", "Frontend-Rendering-Fehler", "Aktualisieren; Indikator entfernen und neu hinzufügen"],
        ["Schwarz auf dem Desktop, Mobile funktioniert noch", "Lokales Rendering- oder Workspace-Problem", "Gerät wechseln; Cache auf dem betroffenen Gerät leeren"],
        ["Auf allen Geräten gleichzeitig schwarz", "Störung bei Tradovate", "status.tradovate.com prüfen und abwarten"],
      ],
    },
    { type: "heading", text: "Mit PickMyTrade vorbeugen" },
    { type: "paragraph", html: "Ein leerer Chart ist zunächst ein Anzeigeproblem, aber wenn Sie beim Klicken Ihrer Ein- und Ausstiege auf diesen Chart angewiesen sind, kann ein Blackout Sie genau im falschen Moment eine Fill kosten. PickMyTrade nimmt die Chart-Oberfläche aus dem kritischen Pfad, indem Ihre TradingView-Alerts direkt an Ihr Tradovate-Konto weitergeleitet werden, sodass Ihre Strategie weiter ausgeführt wird, selbst wenn das Frontend nicht rendert." },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Serverseitiges Order-Routing</strong>, Alerts gehen direkt an Ihr Tradovate-Konto, sodass ein schwarzer Chart Ihre Ein- und Ausstiege nicht blockiert.",
        "<strong class='text-white'>Plattformunabhängige Ausführung</strong>, die Automatisierung läuft unabhängig davon, ob der Desktop-, Web- oder Mobile-Chart auf dem Bildschirm zeichnet.",
        "<strong class='text-white'>Multi-Account-Sync</strong>, spiegelt jede Order über alle verbundenen Konten, sodass ein UI-Fehler auf einem Gerät die anderen nicht aus dem Takt bringt.",
        "<strong class='text-white'>Alert-Protokollierung</strong>, hält jedes Signal fest, damit Sie Fills abgleichen können, sobald Ihre Charts wieder erscheinen.",
      ],
    },
  ], es: [
    { type: "paragraph", html: "Cuando opera futuros de movimiento rápido como el ES o el NQ, pocas cosas inquietan tanto como abrir Tradovate y encontrarse con un gráfico en blanco o, peor aún, toda la plataforma completamente en negro, sin velas, sin DOM y sin forma de ver dónde está el precio. Esto se presenta de varias formas: una pantalla completamente negra justo después de iniciar sesión, paneles atascados en «loading», gráficos que se ponen en blanco en el momento en que agrega una cuenta nueva, o un gráfico que se dibuja pero pierde todos sus indicadores. La parte tranquilizadora es esta: la mayoría de los episodios de gráficos en blanco se resuelven en un par de minutos con una actualización, un vaciado de caché o una recarga del espacio de trabajo. Los que no se resuelven suelen deberse a una interrupción del lado de Tradovate, y una comprobación rápida del estado le indica en qué caso se encuentra. Esta guía recorre cada solución en el orden en que debe probarlas, además de cómo mantener su automatización funcionando cuando la interfaz del gráfico no coopera." },
    {
      type: "checklist",
      heading: "Lista rápida de verificación para gráficos en blanco o en negro",
      items: [
        "<strong class='text-white'>Actualice primero (F5 en la web)</strong>, una sola recarga resuelve la mayoría de los fallos transitorios de gráficos en blanco.",
        "<strong class='text-white'>Cierre sesión y vuelva a iniciarla</strong>, obliga a la plataforma a reconstruir su sesión y volver a solicitar los datos del gráfico.",
        "<strong class='text-white'>Recargue su espacio de trabajo guardado</strong>, un diseño en blanco suele ser solo un espacio de trabajo reiniciado, no gráficos perdidos.",
        "<strong class='text-white'>Borre la caché y las cookies</strong>, resuelve los apagones por renderizado dañado en la web y en el cliente de escritorio.",
        "<strong class='text-white'>Cambie a móvil o web</strong>, si el escritorio está en negro, la aplicación que sigue funcionando le mantiene cubierto.",
        "<strong class='text-white'>Compruebe status.tradovate.com</strong>, un apagón total y persistente en todos los dispositivos suele indicar un incidente del lado del servidor, no de su equipo.",
      ],
    },
    { type: "heading", text: "Qué significa realmente que los «gráficos estén en blanco o en negro» en Tradovate" },
    { type: "paragraph", html: "Un gráfico en blanco o en negro significa que la plataforma cargó, pero el área del gráfico no logró renderizarse: obtiene un panel vacío, un rectángulo negro o una pantalla congelada en «loading». Es un problema de visualización y entrega de datos, no (por lo general) un problema de cuenta: sus posiciones, órdenes y saldos permanecen intactos en los servidores de Tradovate aunque no pueda ver el gráfico. Esa distinción importa, porque le indica dónde buscar. Si solo el lienzo del gráfico está oscuro, la solución casi siempre es local: una caché desactualizada, un diseño reiniciado o un fallo de renderizado. Si toda la plataforma está en negro en todos sus dispositivos, el problema se ha desplazado hacia el feed de datos o los servidores de Tradovate." },
    { type: "paragraph", html: "Dos patrones lo ilustran. Una pantalla completamente negra que persiste al cerrar la aplicación, volver a abrirla e incluso reiniciar el equipo es un fallo clásico de renderizado local, del tipo que borrar la caché suele resolver de forma definitiva. Y un apagón que afecta a las aplicaciones de escritorio y web mientras la aplicación del teléfono sigue funcionando es la firma clásica de un problema de renderizado del front-end o del espacio de trabajo, no de un bloqueo de cuenta. Ambos casos indican que debe solucionar el problema en el dispositivo que tiene delante, no preocuparse por su cuenta." },
    { type: "heading", text: "Principales causas de los gráficos en blanco de Tradovate" },
    { type: "heading", text: "1. Un fallo de renderizado transitorio" },
    { type: "paragraph", html: "La causa más común es también la más inofensiva: el motor de gráficos simplemente no logró dibujar el lienzo tras iniciar sesión, cambiar de pestaña o sufrir un corte de red breve. Una sola actualización suele solucionarlo. Por eso «¿ya probó a actualizar?» es lo primero que pregunta el soporte." },
    { type: "heading", text: "2. Una caché dañada o sobrecargada" },
    { type: "paragraph", html: "Los clientes web y de escritorio de Tradovate almacenan en caché localmente scripts, datos y dibujos. Cuando esa caché se vuelve obsoleta o se daña, los gráficos pueden renderizarse en blanco o en negro. Borrar la caché y las cookies de la última semana resuelve directamente muchos de estos apagones. La advertencia honesta: si ya borró la caché, el historial y las cookies y nada cambia, probablemente se enfrenta a una causa distinta, a menudo del lado del servidor." },
    { type: "heading", text: "3. Un espacio de trabajo reiniciado o no cargado" },
    { type: "paragraph", html: "La función de espacios de trabajo de Tradovate guarda todo su diseño (gráficos, DOM, marcos temporales e indicadores) para que reaparezca en la siguiente sesión. Si un espacio de trabajo se reinicia o no se carga automáticamente, la plataforma puede abrirse con un diseño vacío o en blanco que parece gráficos rotos, pero que en realidad es solo una configuración guardada ausente. Recargar el espacio de trabajo guardado lo restaura todo." },
    { type: "heading", text: "4. Conflictos de renderizado del navegador o la GPU (web)" },
    { type: "paragraph", html: "Como los gráficos de Tradovate se renderizan en el navegador, una extensión agresiva, un navegador desactualizado o un conflicto de aceleración gráfica pueden dejar el lienzo del gráfico en blanco mientras el resto de la página carga con normalidad. Probar con otro navegador, desactivar extensiones o alternar la configuración de aceleración por hardware del navegador suele devolver el gráfico." },
    { type: "heading", text: "5. Una interrupción del lado de Tradovate o un incidente del feed de datos" },
    { type: "paragraph", html: "A veces el problema no es suyo en absoluto. Cuando los gráficos están en negro en escritorio, web y móvil al mismo tiempo, y borrar la caché o reinstalar no cambia nada, casi siempre se trata de un incidente de la plataforma. Tradovate ha reconocido fallos de este tipo y publicado avisos en la aplicación cuando ocurren, y los gráficos suelen volver por sí solos una vez resuelto el incidente." },
    { type: "heading", text: "Cómo solucionar los gráficos en blanco o en negro: paso a paso" },
    { type: "paragraph", html: "Recorra estos pasos en orden. Deténgase en cuanto sus gráficos vuelvan, rara vez necesitará todos los pasos." },
    { type: "heading", text: "Solucionar un fallo transitorio: actualizar y volver a iniciar sesión" },
    {
      type: "steps",
      items: [
        { title: "Actualizar la página", html: "En la plataforma web, pulse <strong class='text-white'>F5</strong> (o el botón de recarga de su navegador) para actualizar la página." },
        { title: "Cerrar sesión por completo y volver a iniciarla", html: "Si el gráfico sigue en blanco, cierre sesión por completo y vuelva a iniciarla. Esto reconstruye la sesión y vuelve a solicitar el historial del gráfico desde cero." },
        { title: "Cerrar y volver a abrir por completo la aplicación de escritorio", html: "En el cliente de escritorio, cierre por completo la aplicación y vuelva a abrirla en lugar de pulsar F5." },
      ],
    },
    { type: "heading", text: "Solucionar un diseño no cargado: recargar su espacio de trabajo" },
    {
      type: "steps",
      items: [
        { title: "Abrir el menú + (Nuevo)", html: "Abra el menú <strong class='text-white'>+ (Nuevo)</strong>, donde se encuentran los paneles nuevos y los diseños guardados." },
        { title: "Recargar su espacio de trabajo guardado", html: "Busque su espacio de trabajo previamente guardado en la lista y haga clic en él para recargar su configuración completa de gráficos y DOM." },
        { title: "Reconstruir y guardar si no existe ninguno", html: "Si no existe ningún espacio de trabajo guardado, reconstruya el diseño que desea y guárdelo para que se restaure automáticamente la próxima vez." },
      ],
    },
    { type: "heading", text: "Solucionar una caché dañada: borrar caché y cookies" },
    {
      type: "steps",
      items: [
        { title: "Borrar imágenes en caché y cookies", html: "En la plataforma web, abra la configuración de privacidad o historial de su navegador y elija borrar <strong class='text-white'>imágenes y archivos en caché</strong> junto con las <strong class='text-white'>cookies</strong> del período reciente." },
        { title: "Recargar y volver a iniciar sesión", html: "Recargue Tradovate y vuelva a iniciar sesión. La plataforma reconstruirá una caché limpia." },
        { title: "Desinstalar y reinstalar si es necesario", html: "En el cliente de escritorio, si actualizar y volver a iniciar sesión no ayudan, desinstale y reinstale la aplicación para restablecer su caché local, pero consulte la nota siguiente, porque una reinstalación no ayudará si la causa es del lado del servidor." },
      ],
    },
    { type: "heading", text: "Solucionar un conflicto de navegador o GPU (solo web)" },
    {
      type: "steps",
      items: [
        { title: "Probar con otro navegador", html: "Intente cargar Tradovate en otro navegador actualizado para descartar un problema de extensión o de versión." },
        { title: "Desactivar extensiones que interfieran", html: "Desactive las extensiones del navegador (bloqueadores de anuncios, bloqueadores de scripts) que puedan interferir con el renderizado del gráfico." },
        { title: "Alternar la aceleración por hardware", html: "Desactive la configuración de aceleración por hardware (GPU) de su navegador, reinicie el navegador y recargue la página; los gráficos renderizados en lienzo son sensibles a los conflictos de controladores gráficos." },
      ],
    },
    { type: "heading", text: "Solucionar un apagón total: cambiar de dispositivo y comprobar el estado" },
    {
      type: "steps",
      items: [
        { title: "Cambiar a web o móvil", html: "Si el escritorio está en negro, abra Tradovate en <strong class='text-white'>la web o la aplicación móvil</strong>; el cliente que sigue funcionando le permite supervisar y gestionar posiciones." },
        { title: "Comprobar status.tradovate.com", html: "Compruebe <strong class='text-white'>status.tradovate.com</strong> (o la página de estado del servicio de su entorno) para ver si hay un incidente activo o una ventana de mantenimiento." },
        { title: "Esperar y reportar si no se resuelve", html: "Si se confirma un incidente en toda la plataforma, espere a que se resuelva y gestione el riesgo a través del dispositivo que sigue funcionando o una conexión de respaldo. Reporte al soporte de Tradovate un apagón persistente y no documentado." },
      ],
    },
    { type: "heading", text: "Tabla de solución de problemas" },
    {
      type: "table",
      headers: ["Síntoma", "Significado probable", "Primera solución"],
      rows: [
        ["Panel del gráfico en blanco tras iniciar sesión o cambiar de pestaña", "Fallo de renderizado transitorio", "Actualizar (F5) / reabrir la aplicación"],
        ["Pantalla completamente negra atascada en «loading»", "Caché dañada o incidente de la plataforma", "Borrar caché y cookies; comprobar la página de estado"],
        ["Gráficos en blanco justo después de agregar una cuenta nueva", "Sesión en caché obsoleta", "Borrar caché y cookies, luego volver a iniciar sesión"],
        ["Diseño vacío o ausente al iniciar sesión", "Espacio de trabajo reiniciado / no cargado", "Recargar su espacio de trabajo guardado"],
        ["El gráfico se dibuja pero los indicadores desaparecen", "Error de renderizado del front-end", "Actualizar; quitar y volver a añadir el indicador"],
        ["En negro en el escritorio, el móvil sigue funcionando", "Problema de renderizado local o de espacio de trabajo", "Cambiar de dispositivo; borrar la caché en el que falla"],
        ["En negro en todos los dispositivos a la vez", "Interrupción del lado de Tradovate", "Comprobar status.tradovate.com y esperar"],
      ],
    },
    { type: "heading", text: "Prevenir esto con PickMyTrade" },
    { type: "paragraph", html: "Un gráfico en blanco es un problema de visualización, pero si depende de ese gráfico para hacer clic en sus entradas y salidas, un apagón puede costarle una ejecución justo en el momento equivocado. PickMyTrade saca la interfaz del gráfico de la ruta crítica al enviar sus alertas de TradingView directamente a su cuenta de Tradovate, de modo que su estrategia sigue ejecutándose incluso cuando el front-end no se renderiza." },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Enrutamiento de órdenes del lado del servidor</strong>, las alertas se envían directamente a su cuenta de Tradovate, de modo que un gráfico en negro no bloquea sus entradas ni salidas.",
        "<strong class='text-white'>Ejecución independiente de la plataforma</strong>, la automatización funciona sin importar si el gráfico de escritorio, web o móvil se está dibujando en pantalla.",
        "<strong class='text-white'>Sincronización multicuenta</strong>, refleja cada orden en todas sus cuentas conectadas, de modo que un fallo de interfaz en un dispositivo no desincroniza el resto.",
        "<strong class='text-white'>Registro de alertas</strong>, mantiene un registro de cada señal para que pueda conciliar las ejecuciones en cuanto vuelvan sus gráficos.",
      ],
    },
  ], fr: [
    { type: "paragraph", html: "Lorsque vous tradez des futures qui évoluent rapidement comme le ES ou le NQ, peu de choses inquiètent autant que d'ouvrir Tradovate sur un graphique vide ou, pire, sur une plateforme entièrement noire, sans bougies, sans DOM et sans aucun moyen de voir où se situe le prix. Cela se manifeste sous plusieurs formes : un écran totalement noir juste après la connexion, des panneaux bloqués sur «loading», des graphiques qui deviennent vides dès que vous ajoutez un nouveau compte, ou un graphique qui se dessine mais perd tous ses indicateurs. Voici la bonne nouvelle : la plupart des épisodes de graphiques vides se résolvent en quelques minutes grâce à une actualisation, un vidage du cache ou un rechargement de l'espace de travail. Ceux qui persistent sont généralement dus à une panne côté Tradovate, et une vérification rapide du statut vous indique dans quel cas vous vous trouvez. Ce guide passe en revue chaque solution dans l'ordre où vous devriez les essayer, ainsi que la manière de garder votre automatisation en fonctionnement lorsque l'interface des graphiques ne coopère pas." },
    {
      type: "checklist",
      heading: "Liste de vérification rapide pour les graphiques vides ou noirs",
      items: [
        "<strong class='text-white'>Actualisez d'abord (F5 sur le web)</strong>, un simple rechargement résout la plupart des problèmes transitoires de graphiques vides.",
        "<strong class='text-white'>Déconnectez-vous puis reconnectez-vous</strong>, force la plateforme à reconstruire sa session et à redemander les données du graphique.",
        "<strong class='text-white'>Rechargez votre espace de travail enregistré</strong>, une mise en page vide n'est souvent qu'un espace de travail réinitialisé, pas des graphiques perdus.",
        "<strong class='text-white'>Videz le cache et les cookies</strong>, résout les pannes dues à un rendu corrompu sur le web et sur le client de bureau.",
        "<strong class='text-white'>Passez sur mobile ou sur le web</strong>, si le bureau est noir, l'application qui fonctionne encore vous permet de rester couvert.",
        "<strong class='text-white'>Vérifiez status.tradovate.com</strong>, une panne totale et persistante sur tous les appareils signifie généralement un incident côté serveur, pas un problème de votre machine.",
      ],
    },
    { type: "heading", text: "Ce que signifient réellement des «graphiques vides ou noirs» sur Tradovate" },
    { type: "paragraph", html: "Un graphique vide ou noir signifie que la plateforme a bien chargé, mais que la zone du graphique n'a pas réussi à s'afficher : vous obtenez un panneau vide, un rectangle noir ou un écran figé sur «loading». C'est un problème d'affichage et de livraison de données, et non (généralement) un problème de compte : vos positions, ordres et soldes restent intacts sur les serveurs de Tradovate même lorsque vous ne voyez pas le graphique. Cette distinction compte, car elle vous indique où chercher. Si seule la zone de dessin du graphique est sombre, la solution est presque toujours locale : un cache obsolète, une mise en page réinitialisée ou un accroc de rendu. Si la plateforme entière est noire sur tous vos appareils, le problème s'est déplacé en amont, vers le flux de données ou les serveurs de Tradovate." },
    { type: "paragraph", html: "Deux schémas illustrent cela. Un écran totalement noir qui persiste malgré la fermeture de l'application, sa réouverture, et même le redémarrage de votre ordinateur, est une défaillance classique de rendu local, du genre que le vidage du cache résout souvent définitivement. Et une panne qui touche les applications de bureau et web pendant que l'application smartphone continue de fonctionner est la signature typique d'un problème de rendu front-end ou d'espace de travail, et non d'un blocage de compte. Les deux vous indiquent de réparer l'appareil devant vous, plutôt que de vous inquiéter pour votre compte." },
    { type: "heading", text: "Principales causes des graphiques vides sur Tradovate" },
    { type: "heading", text: "1. Un accroc de rendu transitoire" },
    { type: "paragraph", html: "La cause la plus courante est aussi la plus inoffensive : le moteur de graphiques n'a tout simplement pas réussi à dessiner la zone après la connexion, un changement d'onglet ou une coupure réseau. Une simple actualisation le résout généralement. C'est exactement pourquoi «avez-vous essayé d'actualiser ?» est la première question posée par le support." },
    { type: "heading", text: "2. Un cache corrompu ou surchargé" },
    { type: "paragraph", html: "Les clients web et de bureau de Tradovate mettent en cache localement les scripts, les données et les dessins. Lorsque ce cache devient obsolète ou corrompu, les graphiques peuvent s'afficher vides ou noirs. Vider le cache et les cookies de la dernière semaine résout franchement bon nombre de ces pannes. La réserve honnête : si vous avez déjà vidé le cache, l'historique et les cookies et que rien ne change, vous êtes probablement face à une cause différente, souvent côté serveur." },
    { type: "heading", text: "3. Un espace de travail réinitialisé ou non chargé" },
    { type: "paragraph", html: "La fonctionnalité Espaces de travail de Tradovate enregistre votre mise en page complète, les graphiques, le DOM, les unités de temps et les indicateurs, afin qu'elle réapparaisse à la session suivante. Si un espace de travail est réinitialisé ou ne se charge pas automatiquement, la plateforme peut s'ouvrir sur une mise en page vide qui ressemble à des graphiques cassés, mais qui n'est en réalité qu'une configuration enregistrée manquante. Recharger l'espace de travail enregistré restaure tout." },
    { type: "heading", text: "4. Conflits de rendu du navigateur ou du GPU (web)" },
    { type: "paragraph", html: "Comme les graphiques Tradovate se rendent dans le navigateur, une extension agressive, un navigateur obsolète ou un conflit d'accélération graphique peuvent laisser la zone du graphique vide alors que le reste de la page se charge normalement. Essayer un autre navigateur, désactiver les extensions ou basculer le paramètre d'accélération matérielle du navigateur permet souvent de retrouver le graphique." },
    { type: "heading", text: "5. Une panne côté Tradovate ou un incident sur le flux de données" },
    { type: "paragraph", html: "Parfois, ce n'est pas vous du tout. Lorsque les graphiques sont noirs simultanément sur bureau, web et mobile, et que le vidage du cache et la réinstallation ne changent rien, il s'agit presque toujours d'un incident de plateforme. Tradovate a reconnu des bugs de ce type et publié des avis dans l'application lorsqu'ils surviennent, et les graphiques reviennent généralement d'eux-mêmes une fois l'incident résolu." },
    { type: "heading", text: "Comment résoudre les graphiques vides ou noirs : étape par étape" },
    { type: "paragraph", html: "Suivez ces étapes dans l'ordre. Arrêtez-vous dès que vos graphiques reviennent, vous n'avez rarement besoin de toutes les étapes." },
    { type: "heading", text: "Résoudre un accroc transitoire : actualiser et se reconnecter" },
    {
      type: "steps",
      items: [
        { title: "Actualiser la page", html: "Sur la plateforme web, appuyez sur <strong class='text-white'>F5</strong> (ou le bouton d'actualisation de votre navigateur) pour actualiser la page." },
        { title: "Se déconnecter complètement, puis se reconnecter", html: "Si le graphique est toujours vide, déconnectez-vous complètement, puis reconnectez-vous. Cela reconstruit la session et redemande l'historique du graphique depuis le début." },
        { title: "Fermer et rouvrir complètement l'application de bureau", html: "Sur le client de bureau, fermez complètement l'application puis rouvrez-la au lieu d'appuyer sur F5." },
      ],
    },
    { type: "heading", text: "Résoudre une mise en page non chargée : recharger votre espace de travail" },
    {
      type: "steps",
      items: [
        { title: "Ouvrir le menu + (Nouveau)", html: "Ouvrez le menu <strong class='text-white'>+ (Nouveau)</strong>, où se trouvent les nouveaux panneaux et les mises en page enregistrées." },
        { title: "Recharger votre espace de travail enregistré", html: "Recherchez votre espace de travail précédemment enregistré dans la liste et cliquez dessus pour recharger votre configuration complète de graphiques et de DOM." },
        { title: "Reconstruire et enregistrer si aucun n'existe", html: "Si aucun espace de travail enregistré n'existe, reconstruisez la mise en page souhaitée et enregistrez-la afin qu'elle se restaure automatiquement la prochaine fois." },
      ],
    },
    { type: "heading", text: "Résoudre un cache corrompu : vider le cache et les cookies" },
    {
      type: "steps",
      items: [
        { title: "Effacer les images en cache et les cookies", html: "Sur la plateforme web, ouvrez les paramètres de confidentialité ou d'historique de votre navigateur et choisissez d'effacer les <strong class='text-white'>images et fichiers en cache</strong> ainsi que les <strong class='text-white'>cookies</strong> de la période récente." },
        { title: "Recharger et se reconnecter", html: "Rechargez Tradovate et reconnectez-vous. La plateforme reconstruira un cache propre." },
        { title: "Désinstaller et réinstaller si nécessaire", html: "Sur le client de bureau, si l'actualisation et la reconnexion n'aident pas, désinstallez et réinstallez l'application pour réinitialiser son cache local, mais consultez la remarque ci-dessous, car une réinstallation n'aidera pas si la cause est côté serveur." },
      ],
    },
    { type: "heading", text: "Résoudre un conflit navigateur/GPU (web uniquement)" },
    {
      type: "steps",
      items: [
        { title: "Essayer un autre navigateur", html: "Essayez de charger Tradovate dans un autre navigateur à jour pour écarter un problème d'extension ou de version." },
        { title: "Désactiver les extensions qui interfèrent", html: "Désactivez les extensions du navigateur (bloqueurs de publicité, bloqueurs de scripts) qui peuvent interférer avec le rendu du graphique." },
        { title: "Basculer l'accélération matérielle", html: "Désactivez le paramètre d'accélération matérielle (GPU) de votre navigateur, redémarrez le navigateur et rechargez la page ; les graphiques rendus sur canvas sont sensibles aux conflits de pilotes graphiques." },
      ],
    },
    { type: "heading", text: "Résoudre une panne totale : changer d'appareil et vérifier le statut" },
    {
      type: "steps",
      items: [
        { title: "Passer sur le web ou le mobile", html: "Si le bureau est noir, ouvrez Tradovate sur <strong class='text-white'>le web ou l'application mobile</strong>, le client qui fonctionne encore vous permet de surveiller et de gérer vos positions." },
        { title: "Vérifier status.tradovate.com", html: "Vérifiez <strong class='text-white'>status.tradovate.com</strong> (ou la page de statut de service de votre environnement) pour un incident actif ou une fenêtre de maintenance." },
        { title: "Patienter et signaler si non résolu", html: "Si un incident à l'échelle de la plateforme est confirmé, attendez qu'il se résolve et gérez le risque via l'appareil qui fonctionne encore ou une connexion de secours. Signalez une panne persistante et non documentée au support Tradovate." },
      ],
