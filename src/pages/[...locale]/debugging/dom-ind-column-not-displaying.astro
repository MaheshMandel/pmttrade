---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "dom-ind-column-not-displaying";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/debugging/${SLUG}`;

const META_TITLE = "Tradovate DOM IND Column Not Showing Indicators";
const META_DESCRIPTION =
  "DOM IND column empty on the ladder? See why chart indicators won't show and the exact color-link and settings fixes to populate the indicators column.";

// Short SEO title (<=60 chars) for locales where the shared h1 is too long for a SERP title.
const TITLE_OVERRIDE: Partial<Record<Locale, string>> = { fr: "Tradovate : colonne IND du DOM sans indicateurs" };

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Tradovate: IND-Spalte im DOM zeigt keine Indikatoren", es: "Tradovate: la columna IND del DOM no muestra indicadores", fr: "Tradovate : la colonne IND du DOM n'affiche pas les indicateurs", it: "Tradovate: la colonna IND del DOM non mostra gli indicatori" },
  dek: { en: "Your chart is stacked with moving averages and the IND column on the DOM just sits there blank. It's a mirror, not a bug, and it only fills in when a specific chain of settings all point the same way. Here's exactly what has to line up.", de: "Ihr Chart ist voller gleitender Durchschnitte, doch die IND-Spalte im DOM bleibt einfach leer. Das ist ein Spiegel, kein Fehler, und er füllt sich nur, wenn eine bestimmte Kette von Einstellungen übereinstimmt. Hier erfahren Sie genau, was zusammenpassen muss.", es: "Su gráfico está repleto de medias móviles y la columna IND del DOM simplemente permanece en blanco. Es un espejo, no un error, y solo se rellena cuando una cadena específica de ajustes coincide. Aquí tiene exactamente lo que debe alinearse.", fr: "Votre graphique est chargé de moyennes mobiles et la colonne IND du DOM reste tout simplement vide. C'est un miroir, pas un bug, et elle ne se remplit que lorsqu'une chaîne précise de réglages s'aligne. Voici exactement ce qui doit correspondre.", it: "Il vostro grafico è pieno di medie mobili e la colonna IND del DOM resta semplicemente vuota. È uno specchio, non un bug, e si popola solo quando una catena specifica di impostazioni è allineata. Ecco esattamente cosa deve corrispondere." },
  readTime: { en: "8 min read", de: "8 Minuten Lesezeit", es: "Lectura de 8 minutos", fr: "Lecture de 8 minutes", it: "Lettura di 8 minuti" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "You've got the IND column showing on your DOM, your chart is stacked with moving averages, and yet the column just sits there blank. No values, no lines, nothing lining up with the ladder. It looks like a bug, and honestly it sometimes is. But the vast majority of the time the IND column is empty because of how Tradovate wires charts to the DOM, and that wiring is easy to get wrong without realizing it. The column doesn't generate anything on its own. It's a mirror of what's on a chart, and it only fills in when a specific chain of settings all point the same way. Get the chain right and the values snap onto the ladder. Here's exactly what has to line up, in what order to check it, and what to do when everything's correct and it <em>still</em> won't display." },
    {
      type: "checklist",
      heading: "Quick Checklist for an Empty IND Column",
      items: [
        "<strong class='text-white'>Open a chart of the same contract.</strong> The IND column pulls from a chart. No chart of that exact contract in the window means nothing to mirror.",
        "<strong class='text-white'>Use price-based indicators.</strong> Only overlays that sit on the price axis (moving averages, VWAP, Bollinger Bands) can map to a ladder price. Oscillators in a sub-panel can't.",
        "<strong class='text-white'>Turn on the show-indicators setting in the DOM.</strong> The DOM won't display chart indicators until you enable that option in its settings.",
        "<strong class='text-white'>Match the link colors.</strong> The DOM and the chart must share the same colored link dot. Gray means linking is off, and off means no hand-off.",
        "<strong class='text-white'>Keep them in the same window.</strong> The chart and DOM need to live in one window on the same contract for the values to cross over.",
        "<strong class='text-white'>Scroll the ladder to the value.</strong> If the indicator's price is off-screen, the column looks empty when it isn't. Scroll the DOM to that price.",
      ],
    },
    { type: "heading", text: "What the IND Column Actually Shows" },
    { type: "paragraph", html: "This is the piece most people miss, so it's worth being precise about it. The IND column on the DOM isn't a place where you add indicators. You can't click it and pick an EMA the way you would on a chart. Instead, it borrows indicators that already exist on a linked chart and paints their current value next to the matching price on the ladder. Think of it as a read-out, not a source. If a 20-period moving average is riding at 5,412.75 on your chart, the IND column drops that value onto the 5,412.75 row of the DOM so you can see, at a glance, where the average sits relative to the working book." },
    { type: "paragraph", html: "Because it's a mirror, an empty IND column almost never means the DOM is broken. It means the reflection isn't reaching it. Something upstream, on the chart or in the link between the two modules, is cutting the feed. When you frame the problem that way, debugging gets a lot faster: you stop poking at DOM columns and start checking the connection between the DOM and the chart it's supposed to be reading." },
    { type: "heading", text: "Why the Column Stays Empty" },
    { type: "heading", text: "1. There's no chart feeding it" },
    { type: "paragraph", html: "The IND column has to have something to reflect. If there's no chart open for the same contract as the DOM, there's nothing to pull. This trips people up when they trade a specific expiry on the DOM but have a chart open on a continuous symbol, or on a different contract month entirely. The DOM on ESU5 won't read indicators off a chart set to a rolling front-month proxy or to ESZ5. The contract has to match, exactly, on both sides." },
    { type: "heading", text: "2. The link colors don't match (or one is gray)" },
    { type: "paragraph", html: "This is the big one. Tradovate links modules together using a small colored dot on each module's tab. Modules that carry the same color are linked; a gray dot means linking is switched off for that module. The IND column rides on that link. If your DOM is on the blue link and the chart is on gray, or the chart is green and the DOM is orange, the indicator values have no bridge to travel across and the column stays blank. You can run several link colors at once to keep different groups of modules in sync, which is handy, but it also means it's easy to leave one module a color out of step without noticing." },
    { type: "heading", text: "3. The show-indicators setting is off" },
    { type: "paragraph", html: "Even with a matching-contract chart and matching link colors, the DOM won't paint indicator values until you tell it to. There's a setting in the DOM's own configuration that enables showing chart indicators on the ladder. If that's off, the IND column can appear as a column but never populate. It's a separate switch from the color link, and both have to be on together." },
    { type: "heading", text: "4. The indicators aren't price-based" },
    { type: "paragraph", html: "Here's a subtle one. The IND column places values at a <em>price</em> on the ladder. So it can only display indicators that actually have a price to sit at, the ones that overlay directly on the candles: moving averages, VWAP, Bollinger Bands, envelopes, pivot levels. An RSI, a MACD, a stochastic, those live in a separate panel on their own numeric scale. There's no price row on the DOM that corresponds to &ldquo;RSI is at 63,&rdquo; so they simply have nowhere to appear. If your chart only carries sub-panel oscillators, the IND column will stay empty no matter how perfectly everything else is linked." },
    { type: "heading", text: "5. The DOM is scrolled away from the value" },
    { type: "paragraph", html: "The ladder only shows a slice of prices around the current market. If a moving average is sitting well above or below where price is trading, its value is off the visible part of the DOM, and the IND column looks empty when it's actually just out of frame. Scroll the ladder up or down toward the indicator's price and the value shows up on its row." },
    { type: "heading", text: "How to Fix an Empty IND Column: Step by Step" },
    { type: "heading", text: "Step 1: Dock a chart of the same contract in the window" },
    { type: "paragraph", html: "Start with the source. Open a chart, set it to the identical contract your DOM is trading, and make sure both modules sit in the same window. Not a floating chart in a second window, not a chart parked on another workspace tab, the same window. Add at least one price overlay to it, a simple moving average is the easiest thing to verify with, so you have a value you can eyeball against the ladder." },
    { type: "heading", text: "Step 2: Turn on show-indicators in the DOM settings" },
    { type: "paragraph", html: "Open the DOM's settings from its menu and find the option that displays chart indicators on the DOM. Switch it on. This is the toggle that gives the IND column permission to paint anything at all. With it off, every other step still leaves you with a blank column, so do this before you go hunting for deeper problems." },
    { type: "heading", text: "Step 3: Set the DOM and chart to the same link color" },
    { type: "paragraph", html: "Click the colored link dot on the DOM's tab and pick a color, say blue. Then click the link dot on the chart's tab and set it to the same blue. Both dots now carry the same color, and neither is gray. That shared color is the bridge the indicator values travel across. If you're running other linked modules, just make sure the DOM and its indicator-source chart agree with each other; they don't have to match the rest of your layout." },
    { type: "heading", text: "Step 4: Confirm the values on the ladder" },
    { type: "paragraph", html: "With the contract matched, the setting on, and the colors aligned, the IND column should now show each indicator's value on its price row. Hover the cursor over a value on the DOM and Tradovate tells you which chart it's coming from, which is genuinely useful when you've got several charts of the same product open on different timeframes and you want to know whether that's the 5-minute EMA or the 15-minute one landing on the ladder." },
    { type: "heading", text: "Step 5: If it's still blank, scroll and re-toggle" },
    { type: "paragraph", html: "Nothing showing yet? Scroll the ladder toward where you can see the indicator sits on the chart, in case the value is simply off-screen. Still empty with the price in view? Flip the link color on both modules to gray and back to the shared color, which forces the connection to re-establish. Then close the DOM and reopen it. If that doesn't do it, reload the platform (a full refresh on web, or restart the desktop app) to clear a stale module state." },
    { type: "heading", text: "Troubleshooting Table" },
    {
      type: "table",
      headers: ["Symptom", "Likely cause", "Fix"],
      rows: [
        ["IND column present but completely empty", "Show-indicators setting off, or no linked chart", "Enable show-indicators in DOM settings and open a same-contract chart in the window"],
        ["Column stays blank despite a chart being open", "DOM and chart on different link colors, or one is gray", "Set both module link dots to the same non-gray color"],
        ["Some indicators show, others never do", "Non-price oscillators (RSI, MACD) have no price row to sit on", "Only price overlays map to the ladder; move oscillators to a chart panel and use overlays for the DOM"],
        ["Chart is open but ignored by the DOM", "Chart is on a different contract or in a separate window", "Match the exact contract and dock both modules in one window"],
        ["Values appear then vanish when price moves", "Ladder scrolled away from the indicator's price", "Scroll the DOM to the indicator's price level, or lock/auto-center the ladder"],
        ["Everything correct, still nothing", "Link acting as a visual cue without syncing", "Toggle link color off/on, reopen the DOM, reload the platform, then escalate to support"],
      ],
    },
    { type: "heading", text: "When It's a Genuine Defect, Not a Setting" },
    { type: "paragraph", html: "Let's be straight about it: there's a long-standing rough edge here. Sometimes the contract matches, the show-indicators setting is on, both link dots are the same color, the chart carries clean moving averages, and the IND column still refuses to populate. In that state the color link behaves like a visual label rather than a live connection, so changing the dots looks like it should do something but never actually syncs the modules. It's frustrating precisely because your configuration is correct." },
    { type: "paragraph", html: "When you hit that wall, run the mechanical resets first, they clear most of these cases: flip the link colors to gray and back on both modules, close and reopen the DOM, and reload the platform to drop any stale module state. Rebuild the DOM from scratch as a last local attempt, since a fresh module sometimes links cleanly where an old one won't. If it survives all of that, it's worth reporting to Tradovate support with the specifics, the exact contract, the indicators on the chart, the link colors on each module, and a screenshot of the empty column next to the chart, so they can see the setup is right and the display is the thing failing." },
    { type: "paragraph", html: "The deeper lesson is worth sitting with, though. The IND column is a nice glance-value convenience, but it's a display feature, and display features are the first thing to flake under load or after an update. If your trading actually depends on reacting when price touches a moving average or a VWAP, leaning on a column that occasionally goes blank is a fragile way to run. That's where taking the human eyeball out of the loop pays off." },
    { type: "heading", text: "A Sturdier Way to Trade Your Indicator Levels with PickMyTrade" },
    { type: "paragraph", html: "If the reason you want indicators on the ladder is to act the moment price interacts with one, the DOM read-out is the weak link even when it works. You still have to be watching, and you still have to click. A cleaner setup evaluates the condition where charting is strongest and then places the trade for you, so a blank IND column can never cost you a fill." },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Let the chart do the math.</strong> A platform like TradingView can watch price cross your moving average, VWAP, or any custom level and fire a webhook the instant it happens, no reliance on a DOM column rendering correctly.",
        "<strong class='text-white'>Route it straight to Tradovate.</strong> PickMyTrade takes that webhook and places the order on your Tradovate account automatically, turning the signal into an actual position instead of something you have to react to by eye.",
        "<strong class='text-white'>Mirror across accounts.</strong> The same indicator trigger can drive several evaluation or funded accounts at once, which no amount of DOM linking will do for you.",
        "<strong class='text-white'>Rate-limit-safe routing.</strong> Orders are spaced to stay inside Tradovate's request limits, so a burst of signals doesn't trip a lockout.",
      ],
    },
    { type: "paragraph", html: "Keep the DOM for what it's great at, resting orders and reading the book, and hand the &ldquo;act on this indicator level&rdquo; job to a pipeline that fires every time." },
  ], de: [
    { type: "paragraph", html: "Die IND-Spalte wird in Ihrem DOM angezeigt, Ihr Chart ist voller gleitender Durchschnitte, und trotzdem bleibt die Spalte einfach leer. Keine Werte, keine Linien, nichts, was mit dem Ladder übereinstimmt. Das sieht wie ein Fehler aus, und ehrlich gesagt ist es das manchmal auch. Aber in den allermeisten Fällen ist die IND-Spalte leer, weil Tradovate Charts auf eine bestimmte Weise mit dem DOM verdrahtet, und diese Verdrahtung lässt sich leicht falsch einstellen, ohne dass man es merkt. Die Spalte erzeugt nichts von selbst. Sie ist ein Spiegel dessen, was auf einem Chart zu sehen ist, und füllt sich nur, wenn eine bestimmte Kette von Einstellungen übereinstimmt. Stimmt die Kette, springen die Werte auf den Ladder. Hier erfahren Sie genau, was zusammenpassen muss, in welcher Reihenfolge Sie es prüfen, und was zu tun ist, wenn alles korrekt ist und es <em>trotzdem</em> nicht angezeigt wird." },
    {
      type: "checklist",
      heading: "Schnelle Checkliste für eine leere IND-Spalte",
      items: [
        "<strong class='text-white'>Öffnen Sie einen Chart desselben Kontrakts.</strong> Die IND-Spalte bezieht Daten von einem Chart. Ist kein Chart dieses exakten Kontrakts im Fenster geöffnet, gibt es nichts zu spiegeln.",
        "<strong class='text-white'>Verwenden Sie preisbasierte Indikatoren.</strong> Nur Overlays, die auf der Preisachse liegen (gleitende Durchschnitte, VWAP, Bollinger-Bänder), können auf einen Ladder-Preis abgebildet werden. Oszillatoren in einem Unterfenster können das nicht.",
        "<strong class='text-white'>Aktivieren Sie die Einstellung zum Anzeigen von Indikatoren im DOM.</strong> Der DOM zeigt keine Chart-Indikatoren an, bis Sie diese Option in den Einstellungen aktivieren.",
        "<strong class='text-white'>Passen Sie die Verknüpfungsfarben an.</strong> DOM und Chart müssen denselben farbigen Verknüpfungspunkt teilen. Grau bedeutet, dass die Verknüpfung deaktiviert ist, und deaktiviert bedeutet keine Übergabe.",
        "<strong class='text-white'>Halten Sie sie im selben Fenster.</strong> Chart und DOM müssen sich in einem Fenster auf demselben Kontrakt befinden, damit die Werte übertragen werden.",
        "<strong class='text-white'>Scrollen Sie den Ladder zum Wert.</strong> Liegt der Preis des Indikators außerhalb des sichtbaren Bereichs, wirkt die Spalte leer, obwohl sie es nicht ist. Scrollen Sie den DOM zu diesem Preis.",
      ],
    },
    { type: "heading", text: "Was die IND-Spalte tatsächlich anzeigt" },
    { type: "paragraph", html: "Das ist der Punkt, den die meisten übersehen, deshalb lohnt es sich, präzise zu sein. Die IND-Spalte im DOM ist keine Stelle, an der Sie Indikatoren hinzufügen. Sie können nicht darauf klicken und einen EMA auswählen wie auf einem Chart. Stattdessen leiht sie sich Indikatoren, die bereits auf einem verknüpften Chart existieren, und zeichnet deren aktuellen Wert neben den passenden Preis auf dem Ladder. Betrachten Sie sie als Anzeige, nicht als Quelle. Liegt ein gleitender 20-Perioden-Durchschnitt auf Ihrem Chart bei 5.412,75, legt die IND-Spalte diesen Wert auf die Zeile 5.412,75 des DOM, damit Sie auf einen Blick sehen, wo der Durchschnitt im Verhältnis zum Orderbuch liegt." },
    { type: "paragraph", html: "Weil es sich um einen Spiegel handelt, bedeutet eine leere IND-Spalte fast nie, dass der DOM defekt ist. Es bedeutet, dass die Spiegelung ihn nicht erreicht. Irgendetwas weiter vorne in der Kette, am Chart oder in der Verknüpfung zwischen den beiden Modulen, unterbricht die Übertragung. Wenn Sie das Problem so betrachten, geht die Fehlersuche viel schneller: Sie hören auf, an DOM-Spalten herumzudrücken, und beginnen, die Verbindung zwischen dem DOM und dem Chart zu prüfen, den er eigentlich lesen soll." },
    { type: "heading", text: "Warum die Spalte leer bleibt" },
    { type: "heading", text: "1. Kein Chart liefert Daten" },
    { type: "paragraph", html: "Die IND-Spalte muss etwas haben, das sie widerspiegeln kann. Ist kein Chart für denselben Kontrakt wie der DOM geöffnet, gibt es nichts abzurufen. Das stolpert Leute, wenn sie einen bestimmten Verfall auf dem DOM handeln, aber einen Chart mit einem fortlaufenden Symbol geöffnet haben, oder ganz auf einem anderen Kontraktmonat. Der DOM auf ESU5 liest keine Indikatoren von einem Chart, der auf einen rollierenden Front-Month-Proxy oder auf ESZ5 eingestellt ist. Der Kontrakt muss auf beiden Seiten exakt übereinstimmen." },
    { type: "heading", text: "2. Die Verknüpfungsfarben stimmen nicht überein (oder eine ist grau)" },
    { type: "paragraph", html: "Das ist der wichtigste Punkt. Tradovate verknüpft Module über einen kleinen farbigen Punkt auf dem Tab jedes Moduls. Module mit derselben Farbe sind verknüpft; ein grauer Punkt bedeutet, dass die Verknüpfung für dieses Modul ausgeschaltet ist. Die IND-Spalte hängt an dieser Verknüpfung. Ist Ihr DOM auf blau und der Chart auf grau, oder ist der Chart grün und der DOM orange, haben die Indikatorwerte keine Brücke zum Überqueren, und die Spalte bleibt leer. Sie können mehrere Verknüpfungsfarben gleichzeitig verwenden, um verschiedene Modulgruppen synchron zu halten, was praktisch ist, aber auch bedeutet, dass man leicht ein Modul mit einer abweichenden Farbe übersieht." },
    { type: "heading", text: "3. Die Einstellung zum Anzeigen von Indikatoren ist deaktiviert" },
    { type: "paragraph", html: "Selbst mit einem passenden Chart und übereinstimmenden Verknüpfungsfarben zeichnet der DOM keine Indikatorwerte, bis Sie ihm das ausdrücklich erlauben. In der eigenen Konfiguration des DOM gibt es eine Einstellung, die das Anzeigen von Chart-Indikatoren auf dem Ladder ermöglicht. Ist diese deaktiviert, kann die IND-Spalte zwar als Spalte erscheinen, füllt sich aber nie. Das ist ein separater Schalter zur Farbverknüpfung, und beide müssen zusammen aktiviert sein." },
    { type: "heading", text: "4. Die Indikatoren sind nicht preisbasiert" },
    { type: "paragraph", html: "Hier ist ein subtiler Punkt. Die IND-Spalte platziert Werte an einem <em>Preis</em> auf dem Ladder. Sie kann also nur Indikatoren anzeigen, die tatsächlich einen Preis haben, an dem sie sitzen können, also solche, die direkt über den Kerzen liegen: gleitende Durchschnitte, VWAP, Bollinger-Bänder, Envelopes, Pivot-Niveaus. Ein RSI, ein MACD, ein Stochastik-Oszillator leben in einem separaten Fenster auf ihrer eigenen numerischen Skala. Es gibt keine Preiszeile im DOM, die &ldquo;RSI liegt bei 63&rdquo; entspricht, also haben sie schlicht keinen Ort, um zu erscheinen. Trägt Ihr Chart nur Unterfenster-Oszillatoren, bleibt die IND-Spalte leer, egal wie perfekt alles andere verknüpft ist." },
    { type: "heading", text: "5. Der DOM ist vom Wert weggescrollt" },
    { type: "paragraph", html: "Der Ladder zeigt nur einen Ausschnitt der Preise rund um den aktuellen Markt. Liegt ein gleitender Durchschnitt deutlich über oder unter dem gehandelten Preis, befindet sich sein Wert außerhalb des sichtbaren Teils des DOM, und die IND-Spalte wirkt leer, obwohl sie sich eigentlich nur außerhalb des Rahmens befindet. Scrollen Sie den Ladder nach oben oder unten zum Preis des Indikators, und der Wert erscheint in seiner Zeile." },
    { type: "heading", text: "So beheben Sie eine leere IND-Spalte: Schritt für Schritt" },
    { type: "heading", text: "Schritt 1: Einen Chart desselben Kontrakts im Fenster andocken" },
    { type: "paragraph", html: "Beginnen Sie bei der Quelle. Öffnen Sie einen Chart, stellen Sie ihn auf denselben Kontrakt, den Ihr DOM handelt, und stellen Sie sicher, dass sich beide Module im selben Fenster befinden. Nicht ein schwebender Chart in einem zweiten Fenster, nicht ein Chart auf einem anderen Arbeitsbereich-Tab, sondern dasselbe Fenster. Fügen Sie mindestens ein Preis-Overlay hinzu, ein einfacher gleitender Durchschnitt lässt sich am leichtesten überprüfen, sodass Sie einen Wert haben, den Sie gegen den Ladder abgleichen können." },
    { type: "heading", text: "Schritt 2: Indikatoranzeige in den DOM-Einstellungen aktivieren" },
    { type: "paragraph", html: "Öffnen Sie die Einstellungen des DOM über sein Menü und suchen Sie die Option, die Chart-Indikatoren im DOM anzeigt. Schalten Sie sie ein. Das ist der Schalter, der der IND-Spalte überhaupt erst erlaubt, etwas zu zeichnen. Ist er deaktiviert, bleiben Sie trotz aller anderen Schritte mit einer leeren Spalte zurück – erledigen Sie das also, bevor Sie nach tiefer liegenden Problemen suchen." },
    { type: "heading", text: "Schritt 3: DOM und Chart auf dieselbe Verknüpfungsfarbe einstellen" },
    { type: "paragraph", html: "Klicken Sie auf den farbigen Verknüpfungspunkt im Tab des DOM und wählen Sie eine Farbe, sagen wir Blau. Klicken Sie dann auf den Verknüpfungspunkt im Tab des Charts und stellen Sie ihn auf dasselbe Blau. Beide Punkte tragen nun dieselbe Farbe, und keiner ist grau. Diese gemeinsame Farbe ist die Brücke, über die die Indikatorwerte reisen. Nutzen Sie andere verknüpfte Module, achten Sie einfach darauf, dass der DOM und sein Indikator-Quell-Chart übereinstimmen; sie müssen nicht mit dem Rest Ihres Layouts übereinstimmen." },
    { type: "heading", text: "Schritt 4: Die Werte auf dem Ladder bestätigen" },
    { type: "paragraph", html: "Stimmen Kontrakt, Einstellung und Farben, sollte die IND-Spalte nun den Wert jedes Indikators auf seiner Preiszeile anzeigen. Bewegen Sie den Cursor über einen Wert im DOM, und Tradovate zeigt Ihnen, von welchem Chart er stammt, was wirklich nützlich ist, wenn Sie mehrere Charts desselben Produkts auf verschiedenen Zeitrahmen geöffnet haben und wissen möchten, ob es sich um den 5-Minuten-EMA oder den 15-Minuten-EMA handelt, der auf dem Ladder landet." },
    { type: "heading", text: "Schritt 5: Ist sie immer noch leer, scrollen und erneut umschalten" },
    { type: "paragraph", html: "Noch immer nichts zu sehen? Scrollen Sie den Ladder dorthin, wo der Indikator laut Chart liegt, falls der Wert schlicht außerhalb des Bildschirms ist. Immer noch leer, obwohl der Preis sichtbar ist? Schalten Sie die Verknüpfungsfarbe an beiden Modulen auf Grau und dann zurück auf die gemeinsame Farbe, das erzwingt eine Neu-Herstellung der Verbindung. Schließen Sie dann den DOM und öffnen Sie ihn erneut. Hilft das nicht, laden Sie die Plattform neu (ein vollständiges Neuladen im Web oder ein Neustart der Desktop-App), um einen veralteten Modulstatus zu löschen." },
    { type: "heading", text: "Fehlerbehebungstabelle" },
    {
      type: "table",
      headers: ["Symptom", "Wahrscheinliche Ursache", "Lösung"],
      rows: [
        ["IND-Spalte vorhanden, aber vollständig leer", "Einstellung zum Anzeigen von Indikatoren deaktiviert oder kein verknüpfter Chart", "Anzeige von Indikatoren in den DOM-Einstellungen aktivieren und einen Chart desselben Kontrakts im Fenster öffnen"],
        ["Spalte bleibt trotz geöffnetem Chart leer", "DOM und Chart haben unterschiedliche Verknüpfungsfarben, oder eine ist grau", "Beide Modul-Verknüpfungspunkte auf dieselbe, nicht-graue Farbe einstellen"],
        ["Manche Indikatoren werden angezeigt, andere nie", "Nicht-preisbasierte Oszillatoren (RSI, MACD) haben keine Preiszeile, auf der sie sitzen können", "Nur Preis-Overlays werden auf den Ladder abgebildet; Oszillatoren in ein Chart-Panel verschieben und Overlays für den DOM verwenden"],
        ["Chart ist geöffnet, wird aber vom DOM ignoriert", "Chart befindet sich auf einem anderen Kontrakt oder in einem separaten Fenster", "Exakten Kontrakt abgleichen und beide Module in einem Fenster andocken"],
        ["Werte erscheinen und verschwinden dann bei Preisbewegung", "Ladder ist vom Preis des Indikators weggescrollt", "DOM zum Preisniveau des Indikators scrollen oder Ladder sperren/automatisch zentrieren"],
        ["Alles korrekt, trotzdem nichts", "Verknüpfung fungiert nur als optischer Hinweis ohne Synchronisierung", "Verknüpfungsfarbe aus-/einschalten, DOM neu öffnen, Plattform neu laden, dann an den Support eskalieren"],
      ],
    },
    { type: "heading", text: "Wenn es sich um einen echten Fehler handelt, nicht um eine Einstellung" },
    { type: "paragraph", html: "Seien wir ehrlich: Hier gibt es ein seit Langem bestehendes Problem. Manchmal stimmt der Kontrakt, die Einstellung zum Anzeigen von Indikatoren ist aktiviert, beide Verknüpfungspunkte haben dieselbe Farbe, der Chart trägt saubere gleitende Durchschnitte, und die IND-Spalte weigert sich trotzdem, sich zu füllen. In diesem Zustand verhält sich die Farbverknüpfung wie ein optisches Etikett statt einer tatsächlichen Verbindung, sodass das Ändern der Punkte etwas zu bewirken scheint, die Module aber nie tatsächlich synchronisiert. Das ist besonders frustrierend, weil Ihre Konfiguration korrekt ist." },
    { type: "paragraph", html: "Stoßen Sie an diese Wand, führen Sie zuerst die mechanischen Resets durch, sie beheben die meisten dieser Fälle: die Verknüpfungsfarben an beiden Modulen auf Grau und zurück schalten, den DOM schließen und neu öffnen, und die Plattform neu laden, um einen veralteten Modulstatus zu entfernen. Bauen Sie den DOM als letzten lokalen Versuch von Grund auf neu, da ein frisches Modul manchmal sauber verknüpft, wo ein altes das nicht tut. Übersteht das Problem all das, lohnt es sich, es dem Tradovate-Support mit Details zu melden: der genaue Kontrakt, die Indikatoren auf dem Chart, die Verknüpfungsfarben jedes Moduls und ein Screenshot der leeren Spalte neben dem Chart, damit dort erkannt werden kann, dass das Setup korrekt ist und die Anzeige das Problem ist." },
    { type: "paragraph", html: "Die tiefere Lektion lohnt sich jedoch, darüber nachzudenken. Die IND-Spalte ist eine nette Bequemlichkeit für einen schnellen Wertüberblick, aber sie ist eine Anzeigefunktion, und Anzeigefunktionen sind das Erste, was unter Last oder nach einem Update instabil wird. Hängt Ihr Trading tatsächlich davon ab, zu reagieren, wenn der Preis einen gleitenden Durchschnitt oder eine VWAP berührt, ist es eine fragile Vorgehensweise, sich auf eine Spalte zu verlassen, die gelegentlich leer wird. Genau da zahlt es sich aus, das menschliche Auge aus dem Kreislauf zu nehmen." },
    { type: "heading", text: "Ein robusterer Weg, Ihre Indikator-Levels mit PickMyTrade zu handeln" },
    { type: "paragraph", html: "Wollen Sie Indikatoren auf dem Ladder, um im Moment zu handeln, in dem der Preis mit einem interagiert, ist die DOM-Anzeige selbst dann das schwache Glied, wenn sie funktioniert. Sie müssen trotzdem beobachten, und Sie müssen trotzdem klicken. Ein sauberes Setup wertet die Bedingung dort aus, wo Charting am stärksten ist, und platziert dann den Trade für Sie, sodass eine leere IND-Spalte Sie nie eine Ausführung kosten kann." },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Lassen Sie den Chart rechnen.</strong> Eine Plattform wie TradingView kann beobachten, wenn der Preis Ihren gleitenden Durchschnitt, VWAP oder ein beliebiges benutzerdefiniertes Level kreuzt, und im selben Moment einen Webhook auslösen, ganz ohne darauf angewiesen zu sein, dass eine DOM-Spalte korrekt gerendert wird.",
        "<strong class='text-white'>Leiten Sie ihn direkt an Tradovate weiter.</strong> PickMyTrade nimmt diesen Webhook entgegen und platziert die Order automatisch auf Ihrem Tradovate-Konto, wodurch das Signal zu einer echten Position wird, statt zu etwas, auf das Sie mit dem Auge reagieren müssen.",
        "<strong class='text-white'>Spiegeln über mehrere Konten hinweg.</strong> Derselbe Indikator-Trigger kann mehrere Evaluierungs- oder finanzierte Konten gleichzeitig ansteuern – etwas, das keine noch so ausgefeilte DOM-Verknüpfung für Sie erledigt.",
        "<strong class='text-white'>Rate-Limit-sicheres Routing.</strong> Orders werden zeitlich gestaffelt, um innerhalb der Anfragelimits von Tradovate zu bleiben, sodass eine Signalflut keine Sperre auslöst.",
      ],
    },
    { type: "paragraph", html: "Nutzen Sie den DOM weiterhin für das, worin er stark ist – ruhende Orders und das Lesen des Orderbuchs –, und übergeben Sie die Aufgabe &ldquo;auf dieses Indikator-Level reagieren&rdquo; an eine Pipeline, die jedes Mal auslöst." },
  ], es: [
    { type: "paragraph", html: "Tiene la columna IND visible en su DOM, su gráfico está repleto de medias móviles, y aun así la columna simplemente permanece en blanco. Sin valores, sin líneas, nada que coincida con la escalera. Parece un error, y sinceramente a veces lo es. Pero la gran mayoría de las veces la columna IND está vacía por cómo Tradovate conecta los gráficos con el DOM, y esa conexión es fácil de configurar mal sin darse cuenta. La columna no genera nada por sí misma. Es un espejo de lo que hay en un gráfico, y solo se rellena cuando una cadena específica de ajustes coincide. Consiga que la cadena sea correcta y los valores encajan en la escalera. Aquí tiene exactamente lo que debe alinearse, en qué orden comprobarlo, y qué hacer cuando todo está correcto y <em>aun así</em> no se muestra." },
    {
      type: "checklist",
      heading: "Lista de verificación rápida para una columna IND vacía",
      items: [
        "<strong class='text-white'>Abra un gráfico del mismo contrato.</strong> La columna IND toma datos de un gráfico. Sin un gráfico de ese contrato exacto en la ventana, no hay nada que reflejar.",
        "<strong class='text-white'>Use indicadores basados en precio.</strong> Solo los overlays que se sitúan en el eje de precio (medias móviles, VWAP, bandas de Bollinger) pueden mapearse a un precio de la escalera. Los osciladores en un subpanel no pueden.",
        "<strong class='text-white'>Active la opción de mostrar indicadores en el DOM.</strong> El DOM no mostrará los indicadores del gráfico hasta que active esa opción en su configuración.",
        "<strong class='text-white'>Haga coincidir los colores de enlace.</strong> El DOM y el gráfico deben compartir el mismo punto de enlace de color. El gris significa que el enlace está desactivado, y desactivado significa que no hay traspaso.",
        "<strong class='text-white'>Manténgalos en la misma ventana.</strong> El gráfico y el DOM deben residir en una sola ventana sobre el mismo contrato para que los valores se transfieran.",
        "<strong class='text-white'>Desplace la escalera hasta el valor.</strong> Si el precio del indicador está fuera de pantalla, la columna parece vacía sin estarlo. Desplace el DOM hasta ese precio.",
      ],
    },
    { type: "heading", text: "Qué muestra realmente la columna IND" },
    { type: "paragraph", html: "Esta es la parte que a la mayoría se le escapa, así que vale la pena ser precisos al respecto. La columna IND del DOM no es un lugar donde se añaden indicadores. No puede hacer clic en ella y elegir una EMA como haría en un gráfico. En su lugar, toma prestados indicadores que ya existen en un gráfico enlazado y pinta su valor actual junto al precio correspondiente en la escalera. Piense en ella como una lectura, no como una fuente. Si una media móvil de 20 periodos está en 5.412,75 en su gráfico, la columna IND coloca ese valor en la fila 5.412,75 del DOM para que pueda ver, de un vistazo, dónde se sitúa la media respecto al libro de órdenes activo." },
    { type: "paragraph", html: "Como es un espejo, una columna IND vacía casi nunca significa que el DOM esté averiado. Significa que el reflejo no le está llegando. Algo antes en la cadena, en el gráfico o en el enlace entre los dos módulos, está cortando el flujo. Al plantear el problema así, la depuración es mucho más rápida: deja de tocar las columnas del DOM y empieza a comprobar la conexión entre el DOM y el gráfico que se supone que está leyendo." },
    { type: "heading", text: "Por qué la columna permanece vacía" },
    { type: "heading", text: "1. No hay ningún gráfico que la alimente" },
    { type: "paragraph", html: "La columna IND necesita algo que reflejar. Si no hay ningún gráfico abierto para el mismo contrato que el DOM, no hay nada que extraer. Esto suele confundir a quienes operan un vencimiento específico en el DOM pero tienen abierto un gráfico con un símbolo continuo, o directamente con un mes de contrato distinto. El DOM en ESU5 no leerá indicadores de un gráfico configurado con un proxy de mes frontal continuo o con ESZ5. El contrato debe coincidir, exactamente, en ambos lados." },
    { type: "heading", text: "2. Los colores de enlace no coinciden (o uno es gris)" },
    { type: "paragraph", html: "Este es el grande. Tradovate enlaza módulos mediante un pequeño punto de color en la pestaña de cada módulo. Los módulos que llevan el mismo color están enlazados; un punto gris significa que el enlace está desactivado para ese módulo. La columna IND depende de ese enlace. Si su DOM está en el enlace azul y el gráfico en gris, o el gráfico es verde y el DOM naranja, los valores del indicador no tienen puente por el que cruzar y la columna permanece en blanco. Puede ejecutar varios colores de enlace a la vez para mantener sincronizados distintos grupos de módulos, lo cual es útil, pero también significa que es fácil dejar un módulo con un color desincronizado sin darse cuenta." },
    { type: "heading", text: "3. La opción de mostrar indicadores está desactivada" },
    { type: "paragraph", html: "Incluso con un gráfico del contrato correcto y colores de enlace coincidentes, el DOM no pintará los valores del indicador hasta que se lo indique. Hay un ajuste en la propia configuración del DOM que habilita mostrar los indicadores del gráfico en la escalera. Si está desactivado, la columna IND puede aparecer como columna pero nunca se rellenará. Es un interruptor independiente del enlace de color, y ambos deben estar activados a la vez." },
    { type: "heading", text: "4. Los indicadores no están basados en el precio" },
    { type: "paragraph", html: "Aquí hay uno sutil. La columna IND coloca los valores en un <em>precio</em> de la escalera. Así que solo puede mostrar indicadores que realmente tengan un precio en el que situarse, los que se superponen directamente sobre las velas: medias móviles, VWAP, bandas de Bollinger, envolventes, niveles pivote. Un RSI, un MACD, un estocástico, esos viven en un panel separado en su propia escala numérica. No hay ninguna fila de precio en el DOM que corresponda a &ldquo;el RSI está en 63&rdquo;, así que simplemente no tienen dónde aparecer. Si su gráfico solo lleva osciladores de subpanel, la columna IND permanecerá vacía sin importar lo perfectamente enlazado que esté todo lo demás." },
    { type: "heading", text: "5. El DOM está desplazado lejos del valor" },
    { type: "paragraph", html: "La escalera solo muestra una porción de precios en torno al mercado actual. Si una media móvil está muy por encima o por debajo de donde cotiza el precio, su valor queda fuera de la parte visible del DOM, y la columna IND parece vacía cuando en realidad solo está fuera de encuadre. Desplace la escalera hacia arriba o hacia abajo hacia el precio del indicador y el valor aparecerá en su fila." },
    { type: "heading", text: "Cómo solucionar una columna IND vacía: paso a paso" },
    { type: "heading", text: "Paso 1: Acople un gráfico del mismo contrato en la ventana" },
    { type: "paragraph", html: "Empiece por la fuente. Abra un gráfico, configúrelo con el mismo contrato exacto que está operando su DOM, y asegúrese de que ambos módulos residan en la misma ventana. No un gráfico flotante en una segunda ventana, no un gráfico ubicado en otra pestaña del espacio de trabajo, la misma ventana. Añádale al menos un overlay de precio, una media móvil simple es lo más fácil para verificar, para que tenga un valor que pueda comparar a simple vista con la escalera." },
    { type: "heading", text: "Paso 2: active mostrar indicadores en la configuración del DOM" },
    { type: "paragraph", html: "Abra la configuración del DOM desde su menú y busque la opción que muestra los indicadores del gráfico en el DOM. Actívela. Este es el interruptor que le da a la columna IND permiso para pintar cualquier cosa. Con él desactivado, cualquier otro paso le sigue dejando con una columna en blanco, así que hágalo antes de buscar problemas más profundos." },
    { type: "heading", text: "Paso 3: configure el DOM y el gráfico con el mismo color de enlace" },
    { type: "paragraph", html: "Haga clic en el punto de enlace de color de la pestaña del DOM y elija un color, digamos azul. Luego haga clic en el punto de enlace de la pestaña del gráfico y configúrelo con ese mismo azul. Ambos puntos ahora llevan el mismo color, y ninguno es gris. Ese color compartido es el puente por el que viajan los valores del indicador. Si tiene otros módulos enlazados en funcionamiento, simplemente asegúrese de que el DOM y su gráfico fuente de indicadores coincidan entre sí; no necesitan coincidir con el resto de su diseño." },
    { type: "heading", text: "Paso 4: confirme los valores en la escalera" },
    { type: "paragraph", html: "Con el contrato coincidente, la opción activada y los colores alineados, la columna IND debería mostrar ahora el valor de cada indicador en su fila de precio. Pase el cursor sobre un valor en el DOM y Tradovate le indica de qué gráfico proviene, lo cual es realmente útil cuando tiene varios gráficos del mismo producto abiertos en distintos marcos temporales y quiere saber si es la EMA de 5 minutos o la de 15 la que aterriza en la escalera." },
    { type: "heading", text: "Paso 5: si sigue en blanco, desplácese y vuelva a alternar" },
    { type: "paragraph", html: "¿Nada aparece todavía? Desplace la escalera hasta donde puede ver que se sitúa el indicador en el gráfico, por si el valor simplemente está fuera de pantalla. ¿Sigue vacío con el precio a la vista? Cambie el color de enlace en ambos módulos a gris y vuelva al color compartido, lo que fuerza a restablecer la conexión. Luego cierre el DOM y vuelva a abrirlo. Si eso no funciona, recargue la plataforma (una recarga completa en la web, o reinicie la app de escritorio) para eliminar un estado de módulo obsoleto." },
    { type: "heading", text: "Tabla de solución de problemas" },
    {
      type: "table",
      headers: ["Síntoma", "Causa probable", "Solución"],
      rows: [
        ["La columna IND está presente pero completamente vacía", "La opción de mostrar indicadores está desactivada, o no hay ningún gráfico enlazado", "Active mostrar indicadores en la configuración del DOM y abra un gráfico del mismo contrato en la ventana"],
        ["La columna permanece en blanco a pesar de tener un gráfico abierto", "El DOM y el gráfico tienen colores de enlace distintos, o uno es gris", "Configure ambos puntos de enlace de módulo con el mismo color no gris"],
        ["Algunos indicadores se muestran, otros nunca", "Los osciladores no basados en precio (RSI, MACD) no tienen fila de precio en la que situarse", "Solo los overlays de precio se mapean a la escalera; mueva los osciladores a un panel del gráfico y use overlays para el DOM"],
        ["El gráfico está abierto pero el DOM lo ignora", "El gráfico está en un contrato distinto o en una ventana separada", "Haga coincidir el contrato exacto y acople ambos módulos en una sola ventana"],
        ["Los valores aparecen y luego desaparecen cuando el precio se mueve", "La escalera está desplazada lejos del precio del indicador", "Desplace el DOM al nivel de precio del indicador, o bloquee/autocentre la escalera"],
        ["Todo correcto, aun así nada", "El enlace actúa como una señal visual sin sincronizar", "Alterne el color de enlace apagado/encendido, vuelva a abrir el DOM, recargue la plataforma, luego escale al soporte"],
      ],
    },
    { type: "heading", text: "Cuando se trata de un defecto real, no de un ajuste" },
    { type: "paragraph", html: "Seamos claros al respecto: aquí hay un problema persistente de larga data. A veces el contrato coincide, la opción de mostrar indicadores está activada, ambos puntos de enlace son del mismo color, el gráfico lleva medias móviles limpias, y la columna IND aun así se niega a rellenarse. En ese estado, el enlace de color se comporta como una etiqueta visual en lugar de una conexión activa, así que cambiar los puntos parece que debería hacer algo, pero nunca sincroniza realmente los módulos. Es frustrante precisamente porque su configuración es correcta." },
    { type: "paragraph", html: "Cuando choque con ese muro, ejecute primero los reinicios mecánicos, resuelven la mayoría de estos casos: cambie los colores de enlace a gris y de vuelta en ambos módulos, cierre y vuelva a abrir el DOM, y recargue la plataforma para eliminar cualquier estado de módulo obsoleto. Reconstruya el DOM desde cero como último intento local, ya que un módulo nuevo a veces enlaza correctamente donde uno antiguo no lo hace. Si sobrevive a todo eso, vale la pena reportarlo al soporte de Tradovate con los detalles específicos: el contrato exacto, los indicadores en el gráfico, los colores de enlace de cada módulo, y una captura de pantalla de la columna vacía junto al gráfico, para que puedan ver que la configuración es correcta y que la visualización es lo que está fallando." },
    { type: "paragraph", html: "La lección más profunda merece que se reflexione sobre ella, sin embargo. La columna IND es una comodidad agradable para consultar valores de un vistazo, pero es una función de visualización, y las funciones de visualización son lo primero que falla bajo carga o tras una actualización. Si su trading realmente depende de reaccionar cuando el precio toca una media móvil o un VWAP, apoyarse en una columna que ocasionalmente se queda en blanco es una forma frágil de operar. Ahí es donde sacar el ojo humano del bucle da sus frutos." },
    { type: "heading", text: "Una forma más sólida de operar sus niveles de indicador con PickMyTrade" },
    { type: "paragraph", html: "Si la razón por la que quiere indicadores en la escalera es actuar en el momento en que el precio interactúa con uno de ellos, la lectura del DOM es el eslabón débil incluso cuando funciona. Aun así tiene que estar vigilando, y aun así tiene que hacer clic. Una configuración más limpia evalúa la condición donde la elaboración de gráficos es más fuerte y luego coloca la operación por usted, de modo que una columna IND en blanco nunca pueda costarle una ejecución." },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Deje que el gráfico haga los cálculos.</strong> Una plataforma como TradingView puede vigilar cuándo el precio cruza su media móvil, VWAP o cualquier nivel personalizado, y disparar un webhook en el instante en que ocurra, sin depender de que una columna del DOM se renderice correctamente.",
        "<strong class='text-white'>Enrútelo directamente a Tradovate.</strong> PickMyTrade toma ese webhook y coloca la orden en su cuenta de Tradovate automáticamente, convirtiendo la señal en una posición real en lugar de algo a lo que tiene que reaccionar a simple vista.",
        "<strong class='text-white'>Réplica entre cuentas.</strong> El mismo disparador de indicador puede impulsar varias cuentas de evaluación o financiadas a la vez, algo que ninguna cantidad de enlazado del DOM hará por usted.",
        "<strong class='text-white'>Enrutamiento seguro frente a límites de tasa.</strong> Las órdenes se espacian para mantenerse dentro de los límites de solicitud de Tradovate, de modo que una ráfaga de señales no provoque un bloqueo.",
      ],
    },
    { type: "paragraph", html: "Conserve el DOM para aquello en lo que sobresale, órdenes pendientes y lectura del libro de órdenes, y entregue la tarea de &ldquo;actuar sobre este nivel de indicador&rdquo; a un pipeline que se dispara siempre." },
  ], fr: [
    { type: "paragraph", html: "La colonne IND s'affiche sur votre DOM, votre graphique est chargé de moyennes mobiles, et pourtant la colonne reste tout simplement vide. Aucune valeur, aucune ligne, rien qui corresponde à l'échelle. Cela ressemble à un bug, et honnêtement, c'en est parfois un. Mais dans la grande majorité des cas, la colonne IND est vide à cause de la façon dont Tradovate relie les graphiques au DOM, et ce câblage est facile à mal régler sans s'en rendre compte. La colonne ne génère rien par elle-même. C'est un miroir de ce qui figure sur un graphique, et elle ne se remplit que lorsqu'une chaîne précise de réglages s'aligne. Obtenez cette chaîne correctement et les valeurs se calent sur l'échelle. Voici exactement ce qui doit correspondre, dans quel ordre le vérifier, et que faire lorsque tout est correct et que ça ne s'affiche <em>quand même</em> pas." },
    {
      type: "checklist",
      heading: "Liste de contrôle rapide pour une colonne IND vide",
      items: [
        "<strong class='text-white'>Ouvrez un graphique du même contrat.</strong> La colonne IND puise ses données d'un graphique. Sans graphique de ce contrat exact dans la fenêtre, il n'y a rien à refléter.",
        "<strong class='text-white'>Utilisez des indicateurs basés sur le prix.</strong> Seuls les overlays situés sur l'axe des prix (moyennes mobiles, VWAP, bandes de Bollinger) peuvent se mapper sur un prix de l'échelle. Les oscillateurs dans un sous-panneau ne le peuvent pas.",
        "<strong class='text-white'>Activez l'option d'affichage des indicateurs dans le DOM.</strong> Le DOM n'affichera pas les indicateurs du graphique tant que vous n'aurez pas activé cette option dans ses paramètres.",
        "<strong class='text-white'>Faites correspondre les couleurs de lien.</strong> Le DOM et le graphique doivent partager le même point de lien coloré. Le gris signifie que le lien est désactivé, et désactivé signifie aucun transfert.",
        "<strong class='text-white'>Gardez-les dans la même fenêtre.</strong> Le graphique et le DOM doivent résider dans une seule fenêtre sur le même contrat pour que les valeurs se transmettent.",
        "<strong class='text-white'>Faites défiler l'échelle jusqu'à la valeur.</strong> Si le prix de l'indicateur est hors écran, la colonne semble vide sans l'être. Faites défiler le DOM jusqu'à ce prix.",
      ],
    },
    { type: "heading", text: "Ce que la colonne IND affiche réellement" },
    { type: "paragraph", html: "C'est l'élément que la plupart des gens ratent, donc il vaut la peine d'être précis à ce sujet. La colonne IND du DOM n'est pas un endroit où vous ajoutez des indicateurs. Vous ne pouvez pas cliquer dessus et choisir une EMA comme vous le feriez sur un graphique. Elle emprunte plutôt des indicateurs qui existent déjà sur un graphique lié et peint leur valeur actuelle à côté du prix correspondant sur l'échelle. Considérez-la comme un affichage, pas une source. Si une moyenne mobile de 20 périodes se trouve à 5 412,75 sur votre graphique, la colonne IND dépose cette valeur sur la ligne 5 412,75 du DOM afin que vous puissiez voir, d'un coup d'œil, où se situe la moyenne par rapport au carnet en cours." },
    { type: "paragraph", html: "Comme c'est un miroir, une colonne IND vide ne signifie presque jamais que le DOM est cassé. Cela signifie que le reflet ne l'atteint pas. Quelque chose en amont, sur le graphique ou dans le lien entre les deux modules, coupe le flux. En abordant le problème de cette manière, le dépannage devient bien plus rapide : vous arrêtez de tripoter les colonnes du DOM et commencez à vérifier la connexion entre le DOM et le graphique qu'il est censé lire." },
    { type: "heading", text: "Pourquoi la colonne reste vide" },
    { type: "heading", text: "1. Aucun graphique ne l'alimente" },
    { type: "paragraph", html: "La colonne IND doit avoir quelque chose à refléter. S'il n'y a aucun graphique ouvert pour le même contrat que le DOM, il n'y a rien à extraire. Cela piège les gens lorsqu'ils tradent une échéance spécifique sur le DOM mais ont un graphique ouvert sur un symbole continu, ou sur un mois de contrat entièrement différent. Le DOM sur ESU5 ne lira pas les indicateurs d'un graphique réglé sur un proxy roulant du mois avant ou sur ESZ5. Le contrat doit correspondre, exactement, des deux côtés." },
    { type: "heading", text: "2. Les couleurs de lien ne correspondent pas (ou l'une est grise)" },
    { type: "paragraph", html: "C'est le point crucial. Tradovate relie les modules à l'aide d'un petit point coloré sur l'onglet de chaque module. Les modules qui portent la même couleur sont liés ; un point gris signifie que le lien est désactivé pour ce module. La colonne IND repose sur ce lien. Si votre DOM est sur le lien bleu et le graphique sur gris, ou si le graphique est vert et le DOM orange, les valeurs de l'indicateur n'ont aucun pont pour traverser et la colonne reste vide. Vous pouvez faire fonctionner plusieurs couleurs de lien à la fois pour garder différents groupes de modules synchronisés, ce qui est pratique, mais cela signifie aussi qu'il est facile de laisser un module avec une couleur décalée sans s'en apercevoir." },
    { type: "heading", text: "3. L'option d'affichage des indicateurs est désactivée" },
    { type: "paragraph", html: "Même avec un graphique correspondant au contrat et des couleurs de lien assorties, le DOM ne peindra pas les valeurs de l'indicateur tant que vous ne le lui dites pas. Il existe un réglage dans la configuration propre du DOM qui active l'affichage des indicateurs du graphique sur l'échelle. S'il est désactivé, la colonne IND peut apparaître comme colonne mais ne jamais se remplir. C'est un interrupteur distinct du lien de couleur, et les deux doivent être activés ensemble." },
    { type: "heading", text: "4. Les indicateurs ne sont pas basés sur le prix" },
    { type: "paragraph", html: "Voici un point subtil. La colonne IND place les valeurs à un <em>prix</em> sur l'échelle. Elle ne peut donc afficher que les indicateurs qui ont réellement un prix où se placer, ceux qui se superposent directement sur les bougies : moyennes mobiles, VWAP, bandes de Bollinger, enveloppes, niveaux pivots. Un RSI, un MACD, un stochastique, vivent dans un panneau séparé sur leur propre échelle numérique. Il n'existe aucune ligne de prix sur le DOM correspondant à &laquo;&nbsp;le RSI est à 63&nbsp;&raquo;, ils n'ont donc tout simplement nulle part où apparaître. Si votre graphique ne comporte que des oscillateurs en sous-panneau, la colonne IND restera vide, peu importe la perfection avec laquelle tout le reste est lié." },
    { type: "heading", text: "5. Le DOM est défilé loin de la valeur" },
    { type: "paragraph", html: "L'échelle n'affiche qu'une tranche de prix autour du marché actuel. Si une moyenne mobile se trouve bien au-dessus ou en dessous du prix négocié, sa valeur est hors de la partie visible du DOM, et la colonne IND semble vide alors qu'elle est en réalité simplement hors cadre. Faites défiler l'échelle vers le haut ou le bas vers le prix de l'indicateur et la valeur apparaît sur sa ligne." },
    { type: "heading", text: "Comment résoudre une colonne IND vide : étape par étape" },
    { type: "heading", text: "Étape 1 : ancrez un graphique du même contrat dans la fenêtre" },
    { type: "paragraph", html: "Commencez par la source. Ouvrez un graphique, réglez-le sur le contrat identique que votre DOM trade, et assurez-vous que les deux modules résident dans la même fenêtre. Pas un graphique flottant dans une seconde fenêtre, pas un graphique garé sur un autre onglet d'espace de travail, la même fenêtre. Ajoutez-lui au moins un overlay de prix, une simple moyenne mobile est le plus facile à vérifier, afin d'avoir une valeur que vous pouvez comparer visuellement à l'échelle." },
    { type: "heading", text: "Étape 2 : activez l'affichage des indicateurs dans les paramètres du DOM" },
    { type: "paragraph", html: "Ouvrez les paramètres du DOM depuis son menu et trouvez l'option qui affiche les indicateurs du graphique sur le DOM. Activez-la. C'est ce bouton qui donne à la colonne IND la permission de peindre quoi que ce soit. Désactivé, toutes les autres étapes vous laissent quand même avec une colonne vide, faites donc cela avant de partir à la chasse de problèmes plus profonds." },
    { type: "heading", text: "Étape 3 : réglez le DOM et le graphique sur la même couleur de lien" },
    { type: "paragraph", html: "Cliquez sur le point de lien coloré de l'onglet du DOM et choisissez une couleur, disons bleu. Puis cliquez sur le point de lien de l'onglet du graphique et réglez-le sur ce même bleu. Les deux points portent maintenant la même couleur, et aucun n'est gris. Cette couleur partagée est le pont sur lequel voyagent les valeurs de l'indicateur. Si vous exploitez d'autres modules liés, assurez-vous simplement que le DOM et son graphique source d'indicateurs concordent entre eux ; ils n'ont pas besoin de correspondre au reste de votre disposition." },
    { type: "heading", text: "Étape 4 : vérifiez les valeurs sur l'échelle" },
    { type: "paragraph", html: "Avec le contrat correspondant, le réglage activé et les couleurs alignées, la colonne IND devrait maintenant afficher la valeur de chaque indicateur sur sa ligne de prix. Survolez une valeur sur le DOM avec le curseur et Tradovate vous indique de quel graphique elle provient, ce qui est vraiment utile lorsque vous avez plusieurs graphiques du même produit ouverts sur différentes unités de temps et que vous voulez savoir s'il s'agit de l'EMA 5 minutes ou de l'EMA 15 minutes qui atterrit sur l'échelle." },
    { type: "heading", text: "Étape 5 : si elle est toujours vide, faites défiler et réactivez" },
    { type: "paragraph", html: "Rien ne s'affiche encore ? Faites défiler l'échelle vers l'endroit où vous voyez que l'indicateur se trouve sur le graphique, au cas où la valeur serait simplement hors écran. Toujours vide avec le prix en vue ? Basculez la couleur de lien sur les deux modules vers gris puis revenez à la couleur partagée, ce qui force le rétablissement de la connexion. Fermez ensuite le DOM et rouvrez-le. Si cela ne suffit pas, rechargez la plateforme (une actualisation complète sur le web, ou redémarrez l'application de bureau) pour effacer un état de module obsolète." },
    { type: "heading", text: "Tableau de dépannage" },
    {
      type: "table",
      headers: ["Symptôme", "Cause probable", "Solution"],
      rows: [
        ["La colonne IND est présente mais complètement vide", "L'option d'affichage des indicateurs est désactivée, ou aucun graphique n'est lié", "Activez l'affichage des indicateurs dans les paramètres du DOM et ouvrez un graphique du même contrat dans la fenêtre"],
        ["La colonne reste vide malgré un graphique ouvert", "Le DOM et le graphique ont des couleurs de lien différentes, ou l'une est grise", "Réglez les deux points de lien de module sur la même couleur non grise"],
        ["Certains indicateurs s'affichent, d'autres jamais", "Les oscillateurs non liés au prix (RSI, MACD) n'ont pas de ligne de prix où se placer", "Seuls les overlays de prix se mappent sur l'échelle ; déplacez les oscillateurs vers un panneau du graphique et utilisez des overlays pour le DOM"],
        ["Le graphique est ouvert mais ignoré par le DOM", "Le graphique est sur un contrat différent ou dans une fenêtre séparée", "Faites correspondre le contrat exact et ancrez les deux modules dans une seule fenêtre"],
        ["Les valeurs apparaissent puis disparaissent quand le prix bouge", "L'échelle est défilée loin du prix de l'indicateur", "Faites défiler le DOM jusqu'au niveau de prix de l'indicateur, ou verrouillez/auto-centrez l'échelle"],
        ["Tout est correct, toujours rien", "Le lien agit comme un repère visuel sans se synchroniser", "Basculez la couleur de lien désactivée/activée, rouvrez le DOM, rechargez la plateforme, puis escaladez au support"],
      ],
    },
    { type: "heading", text: "Quand il s'agit d'un véritable défaut, pas d'un réglage" },
    { type: "paragraph", html: "Soyons francs à ce sujet : il existe ici un problème persistant de longue date. Parfois le contrat correspond, l'option d'affichage des indicateurs est activée, les deux points de lien sont de la même couleur, le graphique porte des moyennes mobiles propres, et la colonne IND refuse quand même de se remplir. Dans cet état, le lien de couleur se comporte comme une étiquette visuelle plutôt qu'une connexion active, donc changer les points semble devoir faire quelque chose mais ne synchronise jamais réellement les modules. C'est frustrant précisément parce que votre configuration est correcte." },
    { type: "paragraph", html: "Lorsque vous heurtez ce mur, effectuez d'abord les réinitialisations mécaniques, elles résolvent la plupart de ces cas : basculez les couleurs de lien vers gris puis revenez sur les deux modules, fermez et rouvrez le DOM, et rechargez la plateforme pour supprimer tout état de module obsolète. Reconstruisez le DOM depuis zéro comme dernière tentative locale, car un module neuf se lie parfois proprement là où un ancien ne le fait pas. Si le problème survit à tout cela, il vaut la peine de le signaler au support Tradovate avec les détails précis, le contrat exact, les indicateurs sur le graphique, les couleurs de lien sur chaque module, et une capture d'écran de la colonne vide à côté du graphique, afin qu'ils puissent voir que la configuration est correcte et que l'affichage est ce qui échoue." },
    { type: "paragraph", html: "La leçon plus profonde mérite qu'on s'y attarde, cependant. La colonne IND est une commodité agréable pour un coup d'œil rapide, mais c'est une fonctionnalité d'affichage, et les fonctionnalités d'affichage sont les premières à flancher sous charge ou après une mise à jour. Si votre trading dépend réellement de réagir lorsque le prix touche une moyenne mobile ou un VWAP, s'appuyer sur une colonne qui devient occasionnellement vide est une manière fragile de fonctionner. C'est là que retirer l'œil humain de la boucle porte ses fruits." },
    { type: "heading", text: "Une façon plus solide de trader vos niveaux d'indicateur avec PickMyTrade" },
    { type: "paragraph", html: "Si la raison pour laquelle vous voulez des indicateurs sur l'échelle est d'agir dès que le prix interagit avec l'un d'eux, la lecture du DOM est le maillon faible même quand elle fonctionne. Vous devez quand même surveiller, et vous devez quand même cliquer. Une configuration plus propre évalue la condition là où le charting est le plus fort, puis passe le trade à votre place, de sorte qu'une colonne IND vide ne puisse jamais vous coûter une exécution." },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Laissez le graphique faire le calcul.</strong> Une plateforme comme TradingView peut surveiller le prix qui croise votre moyenne mobile, VWAP, ou tout niveau personnalisé et déclencher un webhook à l'instant où cela se produit, sans dépendre du bon rendu d'une colonne du DOM.",
        "<strong class='text-white'>Acheminez-le directement vers Tradovate.</strong> PickMyTrade prend ce webhook et passe l'ordre sur votre compte Tradovate automatiquement, transformant le signal en une position réelle au lieu d'être quelque chose auquel vous devez réagir à l'œil.",
        "<strong class='text-white'>Répliquez sur plusieurs comptes.</strong> Le même déclencheur d'indicateur peut piloter plusieurs comptes d'évaluation ou financés à la fois, ce qu'aucune liaison du DOM ne fera jamais pour vous.",
        "<strong class='text-white'>Routage sûr face aux limites de débit.</strong> Les ordres sont espacés pour rester dans les limites de requêtes de Tradovate, afin qu'une rafale de signaux ne déclenche pas de blocage.",
      ],
    },
    { type: "paragraph", html: "Gardez le DOM pour ce qu'il fait de mieux, les ordres en attente et la lecture du carnet, et confiez la tâche &laquo;&nbsp;agir sur ce niveau d'indicateur&nbsp;&raquo; à un pipeline qui se déclenche à chaque fois." },
  ], it: [
    { type: "paragraph", html: "Avete la colonna IND visibile sul vostro DOM, il vostro grafico è pieno di medie mobili, eppure la colonna resta semplicemente vuota. Nessun valore, nessuna linea, nulla che corrisponda alla scala. Sembra un bug, e onestamente a volte lo è. Ma nella stragrande maggioranza dei casi la colonna IND è vuota per come Tradovate collega i grafici al DOM, e quel collegamento è facile da configurare male senza accorgersene. La colonna non genera nulla da sola. È uno specchio di ciò che c'è su un grafico, e si popola solo quando una catena specifica di impostazioni è allineata. Impostate correttamente la catena e i valori si agganciano alla scala. Ecco esattamente cosa deve corrispondere, in che ordine verificarlo, e cosa fare quando tutto è corretto e <em>comunque</em> non viene visualizzato." },
    {
      type: "checklist",
      heading: "Checklist rapida per una colonna IND vuota",
      items: [
        "<strong class='text-white'>Aprite un grafico dello stesso contratto.</strong> La colonna IND attinge da un grafico. Senza un grafico di quel contratto esatto nella finestra, non c'è nulla da rispecchiare.",
        "<strong class='text-white'>Usate indicatori basati sul prezzo.</strong> Solo gli overlay posizionati sull'asse dei prezzi (medie mobili, VWAP, bande di Bollinger) possono essere mappati su un prezzo della scala. Gli oscillatori in un sotto-pannello non possono.",
        "<strong class='text-white'>Attivate l'impostazione per mostrare gli indicatori nel DOM.</strong> Il DOM non mostrerà gli indicatori del grafico finché non abilitate quell'opzione nelle sue impostazioni.",
        "<strong class='text-white'>Fate corrispondere i colori di collegamento.</strong> Il DOM e il grafico devono condividere lo stesso pallino di collegamento colorato. Il grigio significa che il collegamento è disattivato, e disattivato significa nessun passaggio di dati.",
        "<strong class='text-white'>Teneteli nella stessa finestra.</strong> Il grafico e il DOM devono trovarsi in un'unica finestra sullo stesso contratto affinché i valori vengano trasferiti.",
        "<strong class='text-white'>Scorrete la scala fino al valore.</strong> Se il prezzo dell'indicatore è fuori schermo, la colonna sembra vuota anche se non lo è. Scorrete il DOM fino a quel prezzo.",
      ],
    },
    { type: "heading", text: "Cosa mostra realmente la colonna IND" },
    { type: "paragraph", html: "Questo è l'aspetto che la maggior parte delle persone trascura, quindi vale la pena essere precisi al riguardo. La colonna IND del DOM non è un posto dove aggiungere indicatori. Non potete farci clic e scegliere una EMA come fareste su un grafico. Prende invece in prestito indicatori già presenti su un grafico collegato e ne dipinge il valore attuale accanto al prezzo corrispondente sulla scala. Consideratela una lettura, non una fonte. Se una media mobile a 20 periodi si trova a 5.412,75 sul vostro grafico, la colonna IND colloca quel valore sulla riga 5.412,75 del DOM, così potete vedere a colpo d'occhio dove si trova la media rispetto al book operativo." },
    { type: "paragraph", html: "Poiché è uno specchio, una colonna IND vuota quasi mai significa che il DOM è rotto. Significa che il riflesso non lo sta raggiungendo. Qualcosa a monte, sul grafico o nel collegamento tra i due moduli, sta interrompendo il flusso. Se inquadrate il problema in questo modo, la risoluzione diventa molto più veloce: smettete di armeggiare con le colonne del DOM e iniziate a controllare la connessione tra il DOM e il grafico che dovrebbe leggere." },
    { type: "heading", text: "Perché la colonna resta vuota" },
    { type: "heading", text: "1. Nessun grafico la alimenta" },
    { type: "paragraph", html: "La colonna IND deve avere qualcosa da rispecchiare. Se non c'è alcun grafico aperto per lo stesso contratto del DOM, non c'è nulla da estrarre. Questo trae in inganno chi fa trading su una scadenza specifica sul DOM ma ha un grafico aperto su un simbolo continuo, o su un mese contrattuale completamente diverso. Il DOM su ESU5 non leggerà gli indicatori da un grafico impostato su un proxy rolling del front-month o su ESZ5. Il contratto deve corrispondere esattamente su entrambi i lati." },
    { type: "heading", text: "2. I colori di collegamento non corrispondono (o uno è grigio)" },
    { type: "paragraph", html: "Questo è il punto cruciale. Tradovate collega i moduli tramite un piccolo pallino colorato sulla scheda di ciascun modulo. I moduli che portano lo stesso colore sono collegati; un pallino grigio significa che il collegamento è disattivato per quel modulo. La colonna IND dipende da quel collegamento. Se il vostro DOM è sul collegamento blu e il grafico è su grigio, oppure il grafico è verde e il DOM arancione, i valori dell'indicatore non hanno alcun ponte da attraversare e la colonna resta vuota. Potete usare più colori di collegamento contemporaneamente per mantenere sincronizzati diversi gruppi di moduli, il che è comodo, ma significa anche che è facile lasciare un modulo con un colore disallineato senza accorgersene." },
    { type: "heading", text: "3. L'impostazione per mostrare gli indicatori è disattivata" },
    { type: "paragraph", html: "Anche con un grafico del contratto corretto e colori di collegamento coincidenti, il DOM non dipingerà i valori dell'indicatore finché non glielo dite. C'è un'impostazione nella configurazione stessa del DOM che abilita la visualizzazione degli indicatori del grafico sulla scala. Se è disattivata, la colonna IND può apparire come colonna ma non popolarsi mai. È un interruttore separato dal collegamento colore, ed entrambi devono essere attivi insieme." },
    { type: "heading", text: "4. Gli indicatori non sono basati sul prezzo" },
    { type: "paragraph", html: "Ecco un aspetto sottile. La colonna IND colloca i valori a un <em>prezzo</em> sulla scala. Quindi può mostrare solo indicatori che hanno effettivamente un prezzo su cui posizionarsi, quelli che si sovrappongono direttamente alle candele: medie mobili, VWAP, bande di Bollinger, envelope, livelli pivot. Un RSI, un MACD, uno stocastico vivono in un pannello separato sulla propria scala numerica. Non esiste alcuna riga di prezzo nel DOM che corrisponda a &ldquo;l'RSI è a 63&rdquo;, quindi semplicemente non hanno dove apparire. Se il vostro grafico contiene solo oscillatori in sotto-pannello, la colonna IND resterà vuota, non importa quanto perfettamente sia collegato tutto il resto." },
    { type: "heading", text: "5. Il DOM è scorso lontano dal valore" },
    { type: "paragraph", html: "La scala mostra solo una fetta di prezzi attorno al mercato attuale. Se una media mobile si trova ben sopra o sotto il livello a cui viene scambiato il prezzo, il suo valore è fuori dalla parte visibile del DOM, e la colonna IND sembra vuota quando in realtà è semplicemente fuori inquadratura. Scorrete la scala su o giù verso il prezzo dell'indicatore e il valore comparirà sulla sua riga." },
    { type: "heading", text: "Come risolvere una colonna IND vuota: passo dopo passo" },
    { type: "heading", text: "Passaggio 1: agganciare un grafico dello stesso contratto nella finestra" },
    { type: "paragraph", html: "Iniziate dalla fonte. Aprite un grafico, impostatelo sullo stesso identico contratto che il vostro DOM sta tradando, e assicuratevi che entrambi i moduli risiedano nella stessa finestra. Non un grafico fluttuante in una seconda finestra, non un grafico parcheggiato su un'altra scheda dello spazio di lavoro, la stessa finestra. Aggiungetevi almeno un overlay di prezzo, una semplice media mobile è la cosa più facile da verificare, così avete un valore da confrontare a occhio con la scala." },
    { type: "heading", text: "Passaggio 2: attivare la visualizzazione degli indicatori nelle impostazioni del DOM" },
    { type: "paragraph", html: "Aprite le impostazioni del DOM dal suo menu e trovate l'opzione che mostra gli indicatori del grafico sul DOM. Attivatela. Questo è l'interruttore che dà alla colonna IND il permesso di disegnare qualsiasi cosa. Con esso disattivato, ogni altro passaggio vi lascia comunque con una colonna vuota, quindi fatelo prima di andare a caccia di problemi più profondi." },
    { type: "heading", text: "Passaggio 3: impostare DOM e grafico sullo stesso colore di collegamento" },
    { type: "paragraph", html: "Fate clic sul pallino di collegamento colorato sulla scheda del DOM e scegliete un colore, diciamo blu. Poi fate clic sul pallino di collegamento sulla scheda del grafico e impostatelo sullo stesso blu. Entrambi i pallini ora portano lo stesso colore, e nessuno è grigio. Quel colore condiviso è il ponte su cui viaggiano i valori dell'indicatore. Se state usando altri moduli collegati, assicuratevi semplicemente che il DOM e il suo grafico sorgente di indicatori concordino tra loro; non devono corrispondere al resto del vostro layout." },
    { type: "heading", text: "Passaggio 4: confermare i valori sulla scala" },
    { type: "paragraph", html: "Con il contratto corrispondente, l'impostazione attiva e i colori allineati, la colonna IND dovrebbe ora mostrare il valore di ciascun indicatore sulla sua riga di prezzo. Passate il cursore su un valore nel DOM e Tradovate vi indica da quale grafico proviene, il che è davvero utile quando avete diversi grafici dello stesso prodotto aperti su timeframe diversi e volete sapere se è l'EMA a 5 minuti o quella a 15 minuti ad atterrare sulla scala." },
    { type: "heading", text: "Passaggio 5: se è ancora vuota, scorrete e riattivate" },
    { type: "paragraph", html: "Non compare ancora nulla? Scorrete la scala verso il punto in cui vedete che l'indicatore si trova sul grafico, nel caso in cui il valore sia semplicemente fuori schermo. Ancora vuoto con il prezzo in vista? Cambiate il colore di collegamento su entrambi i moduli in grigio e poi tornate al colore condiviso, il che forza il ristabilirsi della connessione. Quindi chiudete il DOM e riapritelo. Se questo non funziona, ricaricate la piattaforma (un aggiornamento completo sul web, o riavviate l'app desktop) per eliminare uno stato del modulo obsoleto." },
    { type: "heading", text: "Tabella di risoluzione dei problemi" },
    {
      type: "table",
      headers: ["Sintomo", "Causa probabile", "Soluzione"],
      rows: [
        ["La colonna IND è presente ma completamente vuota", "Impostazione di visualizzazione indicatori disattivata, o nessun grafico collegato", "Abilitate la visualizzazione degli indicatori nelle impostazioni del DOM e aprite un grafico dello stesso contratto nella finestra"],
        ["La colonna resta vuota nonostante un grafico sia aperto", "DOM e grafico hanno colori di collegamento diversi, o uno è grigio", "Impostate entrambi i pallini di collegamento dei moduli sullo stesso colore non grigio"],
        ["Alcuni indicatori compaiono, altri mai", "Gli oscillatori non basati sul prezzo (RSI, MACD) non hanno una riga di prezzo su cui posizionarsi", "Solo gli overlay di prezzo si mappano sulla scala; spostate gli oscillatori in un pannello del grafico e usate overlay per il DOM"],
        ["Il grafico è aperto ma ignorato dal DOM", "Il grafico è su un contratto diverso o in una finestra separata", "Fate corrispondere il contratto esatto e agganciate entrambi i moduli in un'unica finestra"],
        ["I valori compaiono e poi spariscono quando il prezzo si muove", "La scala è scorsa lontano dal prezzo dell'indicatore", "Scorrete il DOM fino al livello di prezzo dell'indicatore, oppure bloccate/centrate automaticamente la scala"],
        ["Tutto corretto, comunque nulla", "Il collegamento funge da indicazione visiva senza sincronizzarsi", "Attivate/disattivate il colore di collegamento, riaprite il DOM, ricaricate la piattaforma, quindi rivolgetevi al supporto"],
      ],
    },
    { type: "heading", text: "Quando si tratta di un difetto reale, non di un'impostazione" },
    { type: "paragraph", html: "Siamo onesti al riguardo: qui c'è un problema persistente di lunga data. A volte il contratto corrisponde, l'impostazione di visualizzazione degli indicatori è attiva, entrambi i pallini di collegamento sono dello stesso colore, il grafico porta medie mobili pulite, e la colonna IND continua comunque a rifiutarsi di popolarsi. In quello stato il collegamento colore si comporta come un'etichetta visiva piuttosto che una connessione attiva, quindi cambiare i pallini sembra dover fare qualcosa ma non sincronizza mai davvero i moduli. È frustrante proprio perché la vostra configurazione è corretta." },
    { type: "paragraph", html: "Quando vi scontrate con quel muro, eseguite prima i reset meccanici, risolvono la maggior parte di questi casi: cambiate i colori di collegamento in grigio e poi tornate indietro su entrambi i moduli, chiudete e riaprite il DOM, e ricaricate la piattaforma per eliminare qualsiasi stato di modulo obsoleto. Ricostruite il DOM da zero come ultimo tentativo locale, poiché un modulo nuovo a volte si collega correttamente dove uno vecchio non lo fa. Se il problema sopravvive a tutto questo, vale la pena segnalarlo al supporto Tradovate con i dettagli specifici: il contratto esatto, gli indicatori sul grafico, i colori di collegamento di ciascun modulo, e uno screenshot della colonna vuota accanto al grafico, così possono vedere che la configurazione è corretta e che il problema è nella visualizzazione." },
    { type: "paragraph", html: "La lezione più profonda merita comunque una riflessione. La colonna IND è una comoda convenienza per un valore a colpo d'occhio, ma è una funzionalità di visualizzazione, e le funzionalità di visualizzazione sono le prime a vacillare sotto carico o dopo un aggiornamento. Se il vostro trading dipende realmente dal reagire quando il prezzo tocca una media mobile o un VWAP, affidarsi a una colonna che occasionalmente si svuota è un modo fragile di operare. È qui che togliere l'occhio umano dal ciclo ripaga." },
    { type: "heading", text: "Un modo più solido di fare trading sui vostri livelli di indicatore con PickMyTrade" },
    { type: "paragraph", html: "Se la ragione per cui volete indicatori sulla scala è agire nel momento in cui il prezzo interagisce con uno di essi, la lettura del DOM è l'anello debole anche quando funziona. Dovete comunque restare a guardare, e dovete comunque cliccare. Una configurazione più pulita valuta la condizione dove il charting è più forte e poi piazza l'operazione per voi, così una colonna IND vuota non può mai costarvi un'esecuzione." },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Lasciate che sia il grafico a fare i calcoli.</strong> Una piattaforma come TradingView può osservare il prezzo che incrocia la vostra media mobile, il VWAP o qualsiasi livello personalizzato e attivare un webhook nell'istante in cui accade, senza dipendere dal corretto rendering di una colonna del DOM.",
        "<strong class='text-white'>Instradatelo direttamente a Tradovate.</strong> PickMyTrade prende quel webhook e piazza l'ordine sul vostro account Tradovate automaticamente, trasformando il segnale in una posizione reale invece che qualcosa a cui dovete reagire a occhio.",
        "<strong class='text-white'>Replicate su più account.</strong> Lo stesso trigger dell'indicatore può guidare più account di valutazione o finanziati contemporaneamente, cosa che nessun collegamento del DOM potrà mai fare per voi.",
        "<strong class='text-white'>Instradamento sicuro rispetto ai rate limit.</strong> Gli ordini vengono distanziati per restare entro i limiti di richieste di Tradovate, così una raffica di segnali non innesca un blocco.",
      ],
    },
    { type: "paragraph", html: "Mantenete il DOM per ciò in cui eccelle, ordini in attesa e lettura del book, e affidate il compito di &ldquo;agire su questo livello di indicatore&rdquo; a una pipeline che si attiva ogni volta." },
  ] },
  ctaHeading: { en: "Turn Indicator Crosses Into Automatic Trades", de: "Verwandeln Sie Indikator-Kreuzungen in automatische Trades", es: "Convierta los cruces de indicadores en operaciones automáticas", fr: "Transformez les croisements d'indicateurs en trades automatiques", it: "Trasforma gli incroci degli indicatori in operazioni automatiche" },
