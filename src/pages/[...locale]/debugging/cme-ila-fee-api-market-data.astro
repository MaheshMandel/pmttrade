---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "cme-ila-fee-api-market-data";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/debugging/${SLUG}`;

const META_TITLE = "Tradovate API Needs CME ILA Fee (~$290/mo)";
const META_DESCRIPTION =
  "Tradovate CME ILA fee (~$290/mo) applies only to real-time API data, send orders on free 10-minute delayed data to skip it and automate cheaper.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate API", de: "Tradovate API", es: "Tradovate API", fr: "Tradovate API", it: "Tradovate API" },
  h1: { en: META_TITLE, de: "Tradovate API benötigt CME ILA-Gebühr (~290 $/Monat)", es: "La API de Tradovate necesita la tarifa CME ILA (~290 $/mes)", fr: "L'API Tradovate nécessite les frais CME ILA (~290 $/mois)", it: "L'API Tradovate richiede la tariffa CME ILA (~290 $/mese)" },
  dek: { en: "You request a real-time quote over the API and get &ldquo;Symbol is inaccessible,&rdquo; or you learn live data over the API needs a CME sub-vendor license around $290 a month. Here's the one distinction that saves most traders the fee entirely.", de: "Sie fordern über die API eine Echtzeit-Kursnotierung an und erhalten &ldquo;Symbol is inaccessible,&rdquo; oder Sie erfahren, dass Live-Daten über die API eine CME-Sub-Vendor-Lizenz für rund 290 $ pro Monat erfordern. Hier ist die eine Unterscheidung, die den meisten Tradern die Gebühr komplett erspart.", es: "Solicita una cotización en tiempo real a través de la API y recibe &ldquo;Symbol is inaccessible,&rdquo; o descubre que los datos en vivo a través de la API requieren una licencia de subproveedor de CME de unos 290 $ al mes. Esta es la única distinción que le ahorra la tarifa por completo a la mayoría de los traders.", fr: "Vous demandez une cotation en temps réel via l'API et recevez &ldquo;Symbol is inaccessible,&rdquo; ou vous découvrez que les données en direct via l'API nécessitent une licence de sous-fournisseur CME d'environ 290 $ par mois. Voici la seule distinction qui permet à la plupart des traders d'éviter entièrement ces frais.", it: "Richiede una quotazione in tempo reale tramite l'API e riceve &ldquo;Symbol is inaccessible,&rdquo; oppure scopre che i dati live tramite l'API richiedono una licenza da sub-vendor CME di circa 290 $ al mese. Ecco l'unica distinzione che permette alla maggior parte dei trader di evitare del tutto la tariffa." },
  readTime: { en: "8 min read", de: "8 Minuten Lesezeit", es: "Lectura de 8 minutos", fr: "Lecture de 8 minutes", it: "Lettura di 8 minuti" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "You wire up the Tradovate API, request a real-time quote over the WebSocket, and instead of streaming prices you get <strong class='text-white'>&ldquo;Symbol is inaccessible.&rdquo;</strong> Or you find out that live market data over the API is going to run you a CME sub-vendor license of <strong class='text-white'>around $290 a month</strong> on top of everything else. It's one of the most misunderstood costs in Tradovate automation, and it stops plenty of retail algo traders cold before they ever place an order. Here's the part almost nobody tells you up front: the <strong class='text-white'>CME ILA fee only covers real-time market data streamed through the API</strong>. It does <strong class='text-white'>not</strong> apply to sending orders. That one distinction is the difference between paying $290+ a month and paying nothing extra. Below, I'll walk through what the CME Information License Agreement (ILA) sub-vendor requirement actually is, why the API triggers it, and three ways to keep automating, including routing your signals through PickMyTrade so you never touch the fee at all." },
    {
      type: "checklist",
      heading: "Quick Checklist for the CME ILA API Fee",
      items: [
        "<strong class='text-white'>Are you paying for data, or for orders?</strong> Sending orders via the API does not require the CME ILA. Only streaming real-time Tradovate market data does. Get clear on which one you actually need.",
        "<strong class='text-white'>Seeing &ldquo;Symbol is inaccessible&rdquo;?</strong> That WebSocket response usually means your API session isn't entitled to real-time data for that symbol, not that the symbol is wrong.",
        "<strong class='text-white'>Look at free delayed data.</strong> Tradovate gives you 10-minute delayed data at no cost, which is plenty when your entry signals come from TradingView or another feed.",
        "<strong class='text-white'>Keep data off the API.</strong> If your Pine Script or indicator logic runs on TradingView, you don't need Tradovate's real-time API feed at all, use the API for execution only.",
        "<strong class='text-white'>Budget before you commit.</strong> Real-time API market-data licensing is priced by CME data tier and it moves over time, so confirm the current number with Tradovate and CME before you sign anything.",
        "<strong class='text-white'>Prop accounts play by different rules.</strong> On evaluation or funded accounts, the prop firm controls market data, so don't try to self-register as a sub-vendor there.",
      ],
    },
    { type: "heading", text: "What the CME ILA (Sub-Vendor) Requirement Means" },
    { type: "paragraph", html: "The <strong class='text-white'>CME Information License Agreement (ILA)</strong> is a market-data licensing agreement with CME Group, the exchange behind ES, NQ, CL, GC, and the rest of the CME/CBOT/NYMEX/COMEX futures you trade on Tradovate. When you consume real-time exchange data through a broker's user interface, the broker handles that licensing for you. Pull the exact same real-time data programmatically through the <strong class='text-white'>API</strong>, and CME treats you differently: you become a <strong class='text-white'>sub-vendor</strong> of the data, and you have to be registered and licensed as one." },
    { type: "paragraph", html: "This isn't a Tradovate invention. A CME ruling that took effect <strong class='text-white'>September 30, 2022</strong> changed the rules: to keep offering market data over the API, brokers now have to require any user who wants that data to register as a sub-vendor. In practice that means an ILA and a recurring fee, usually <strong class='text-white'>around $290 a month</strong> for the base tier, with broader or higher data tiers costing more. Since exchange data pricing shifts over time and varies by the tier you pick, treat any exact figure as a starting point and verify the current cost directly with Tradovate and CME." },
    { type: "paragraph", html: "Now the part that saves most traders money: <strong class='text-white'>the ILA covers market data, not order execution.</strong> You can authenticate to the API, place orders, modify them, and read your account and fills without ever registering as a sub-vendor. Sending trades through the API works fine without a CME ILA. The fee is a <strong class='text-white'>data</strong> cost, not an <strong class='text-white'>automation</strong> cost." },
    { type: "heading", text: "Top Causes of the CME ILA API Fee Surprise" },
    { type: "heading", text: "1. You assumed API access included real-time data" },
    { type: "paragraph", html: "Getting API access, the add-on plus your key and secret, is a separate thing from being entitled to stream real-time exchange data through that API. Access lets you connect and trade. Real-time market data over the API is the piece that drags in the CME sub-vendor requirement." },
    { type: "heading", text: "2. You tried to subscribe to real-time quotes over the WebSocket" },
    { type: "paragraph", html: "The moment your code calls the market-data endpoint, say a <code>md/subscribeQuote</code>-style request, for a live CME symbol without the entitlement, the feed either won't stream or comes back with <strong class='text-white'>&ldquo;Symbol is inaccessible.&rdquo;</strong> The error reads like a bad symbol, but it's really an entitlement and licensing gap." },
    { type: "heading", text: "3. You confused Tradovate's API add-on fee with the CME data fee" },
    { type: "paragraph", html: "There are two different charges here. Tradovate may bill a modest monthly <strong class='text-white'>API add-on</strong> to enable programmatic access, and CME bills the <strong class='text-white'>ILA data license</strong> separately. Stacking them together in your head makes the number look scarier than it is, and the big one, the ILA, is avoidable if you don't need real-time API data." },
    { type: "heading", text: "4. You're on a prop or evaluation account" },
    { type: "paragraph", html: "On funded or evaluation accounts, the prop firm, not you, owns and controls the market-data entitlement. Registering yourself as a CME sub-vendor on a prop account is the wrong path. Data problems there get solved by the firm." },
    { type: "heading", text: "5. Your strategy never needed Tradovate's real-time feed" },
    { type: "paragraph", html: "Plenty of automated strategies compute their entry and exit signals on <strong class='text-white'>TradingView</strong> (or another charting source) and only need Tradovate to execute. If that's you, paying CME ~$290 a month for a duplicate real-time feed is money spent on data you never touch." },
    { type: "heading", text: "How to Fix the CME ILA API Fee: Step-by-Step" },
    { type: "paragraph", html: "There are three legitimate routes, from cheapest to most expensive. Pick based on whether your strategy truly needs real-time data from the Tradovate API." },
    { type: "heading", text: "Fixing it with free 10-minute delayed data (cheapest)" },
    { type: "paragraph", html: "If your logic doesn't depend on live Tradovate ticks, you trade a slower timeframe, or your signals come from elsewhere, use Tradovate's free delayed data and skip the ILA entirely." },
    {
      type: "steps",
      items: [
        { title: "Know what &ldquo;delayed&rdquo; means", html: "Quotes and chart data lag real time by roughly 10 minutes, and they cost nothing." },
        { title: "Watch for the visual flag", html: "In the platform, delayed symbols are flagged visually, a symbol name shown in orange means delayed rather than live data." },
        { title: "Keep order routing on the API", html: "Placing and managing orders doesn't need the ILA, so execution stays fully live even while your data is delayed." },
        { title: "Confirm the lag is acceptable", html: "Only go this route if a ~10-minute data lag is acceptable for your strategy. It's no good for scalping or anything that keys off live ticks." },
      ],
    },
    { type: "heading", text: "Fixing it by moving market data off the API (recommended for most automation)" },
    { type: "paragraph", html: "The most common real-world setup is to execute through the Tradovate API but source signals from a feed you already pay for, so you never trip the CME sub-vendor requirement." },
    {
      type: "steps",
      items: [
        { title: "Generate signals where your charts live", html: "Generate your entry and exit signals where your charts already live, usually TradingView, on the real-time data plan you already have there." },
        { title: "Fire webhook alerts", html: "Fire those signals as webhook alerts to an automation layer, your own server or a bridge service." },
        { title: "Call the API for execution only", html: "Have that layer call the Tradovate API to place orders. Order placement doesn't require the ILA, so no CME data fee applies." },
        { title: "Pay once, on the charting side", html: "The result: you pay for real-time data once, on the charting side you were already using, and the API does execution only." },
      ],
    },
    { type: "heading", text: "Fixing it by licensing real-time API data (when you genuinely need it)" },
    { type: "paragraph", html: "If your strategy really does have to consume live Tradovate/CME data through the API, a latency-sensitive book-building or market-making style bot, for example, then the ILA is unavoidable and you should budget for it." },
    {
      type: "steps",
      items: [
        { title: "Contact Tradovate", html: "Contact Tradovate to start the CME sub-vendor / ILA registration for API market data." },
        { title: "Choose the right data tier", html: "Pricing varies by tier and changes over time, so get the current schedule in writing. The base tier is usually quoted around $290 a month, with broader tiers higher." },
        { title: "Complete the license paperwork", html: "Complete the sub-vendor license paperwork with CME as directed. This is a real exchange agreement, not a checkbox." },
        { title: "Confirm live data flows", html: "Once you're entitled, your API market-data subscriptions, real-time quote streams and the like, return live data instead of &ldquo;Symbol is inaccessible&rdquo; or delayed values." },
      ],
    },
    { type: "heading", text: "Troubleshooting Table" },
    {
      type: "table",
      headers: ["Error / Situation", "What it means", "Fix"],
      rows: [
        ["&ldquo;Symbol is inaccessible&rdquo; on <code>md/subscribeQuote</code>", "Your API session isn't entitled to real-time data for that symbol", "Use free delayed data, source data off-API, or license real-time via the CME ILA"],
        ["Quoted ~$290/month &ldquo;CME sub-vendor&rdquo; fee", "The CME ILA for streaming real-time data through the API", "Only pay it if you truly need live API data; orders don't require it"],
        ["API market data is 10 minutes behind", "You're on Tradovate's free delayed feed", "Fine for slower strategies; license real-time data only if you need live ticks"],
        ["Orders reject and you assume it's the ILA", "Order execution never needs the ILA", "Look elsewhere, risk limits, data agreements, contract/symbol, not the CME data license"],
        ["Symbol name shows in orange", "Visual flag for delayed (not live) data", "Expected on the free feed; no action needed unless you want live ticks"],
        ["Prop/eval account has no real-time data", "The prop firm controls the entitlement", "Contact the firm; don't self-register as a CME sub-vendor"],
      ],
    },
    { type: "heading", text: "Prevent This with PickMyTrade" },
    { type: "paragraph", html: "The cleanest way to sidestep the CME ILA fee is to keep your signals on the charting platform you already pay for and let a purpose-built bridge handle execution on Tradovate. That's exactly the model PickMyTrade runs, data stays on TradingView, orders route to Tradovate, and the ~$290/month CME data license never enters the picture." },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Data-off-API architecture</strong>, signals come from your TradingView plan and orders route to Tradovate for execution, so you don't consume real-time market data through the API and don't trigger the CME sub-vendor requirement.",
        "<strong class='text-white'>No personal API key juggling</strong>, you link your account once instead of managing your own API credentials and data entitlements per account.",
        "<strong class='text-white'>Qty / symbol validation</strong>, orders are checked against your configured contract, size, and risk before they're sent, so a bad signal doesn't fire a malformed order.",
        "<strong class='text-white'>Multi-account sync</strong>, mirror the same alert across multiple Tradovate accounts from one setup, without licensing data separately for each.",
      ],
    },
  ], de: [
    { type: "paragraph", html: "Sie richten die Tradovate API ein, fordern über den WebSocket eine Echtzeit-Kursnotierung an und erhalten statt streamender Kurse <strong class='text-white'>&ldquo;Symbol is inaccessible.&rdquo;</strong> Oder Sie stellen fest, dass Live-Marktdaten über die API zusätzlich eine CME-Sub-Vendor-Lizenz von <strong class='text-white'>rund 290 $ pro Monat</strong> kosten. Es ist einer der am meisten missverstandenen Kostenpunkte bei der Tradovate-Automatisierung und bringt viele Privatanleger-Algo-Trader gleich zu Beginn ins Stocken, noch bevor sie überhaupt eine Order aufgeben. Hier ist der Teil, den fast niemand von vornherein erklärt: Die <strong class='text-white'>CME-ILA-Gebühr deckt nur Echtzeit-Marktdaten ab, die über die API gestreamt werden</strong>. Sie gilt <strong class='text-white'>nicht</strong> für das Senden von Orders. Genau diese Unterscheidung macht den Unterschied zwischen 290 $+ pro Monat und keinen zusätzlichen Kosten aus. Im Folgenden erkläre ich, was die CME-Information-License-Agreement-(ILA)-Sub-Vendor-Anforderung eigentlich ist, warum die API sie auslöst, und drei Wege, wie Sie weiter automatisieren können – unter anderem, indem Sie Ihre Signale über PickMyTrade leiten, sodass Sie die Gebühr nie berühren." },
    {
      type: "checklist",
      heading: "Kurz-Checkliste für die CME-ILA-API-Gebühr",
      items: [
        "<strong class='text-white'>Zahlen Sie für Daten oder für Orders?</strong> Das Senden von Orders über die API erfordert keine CME ILA. Nur das Streamen von Tradovate-Echtzeit-Marktdaten tut das. Klären Sie zunächst, was Sie tatsächlich benötigen.",
        "<strong class='text-white'>Sehen Sie &ldquo;Symbol is inaccessible&rdquo;?</strong> Diese WebSocket-Antwort bedeutet in der Regel, dass Ihre API-Sitzung nicht zum Bezug von Echtzeitdaten für dieses Symbol berechtigt ist – nicht, dass das Symbol falsch ist.",
        "<strong class='text-white'>Prüfen Sie die kostenlosen verzögerten Daten.</strong> Tradovate stellt Ihnen kostenlos um 10 Minuten verzögerte Daten bereit, was völlig ausreicht, wenn Ihre Einstiegssignale von TradingView oder einer anderen Quelle stammen.",
        "<strong class='text-white'>Halten Sie Daten von der API fern.</strong> Wenn Ihre Pine-Script- oder Indikatorlogik auf TradingView läuft, benötigen Sie den Tradovate-Echtzeit-API-Feed überhaupt nicht – nutzen Sie die API nur zur Ausführung.",
        "<strong class='text-white'>Kalkulieren Sie, bevor Sie sich festlegen.</strong> Die Lizenzierung von Echtzeit-API-Marktdaten richtet sich nach der CME-Datenstufe und ändert sich im Laufe der Zeit. Bestätigen Sie daher den aktuellen Betrag bei Tradovate und CME, bevor Sie etwas unterschreiben.",
        "<strong class='text-white'>Für Prop-Konten gelten andere Regeln.</strong> Bei Evaluierungs- oder finanzierten Konten kontrolliert die Prop-Firma die Marktdaten. Versuchen Sie dort nicht, sich selbst als Sub-Vendor zu registrieren.",
      ],
    },
    { type: "heading", text: "Was die CME-ILA-(Sub-Vendor-)Anforderung bedeutet" },
    { type: "paragraph", html: "Das <strong class='text-white'>CME Information License Agreement (ILA)</strong> ist eine Marktdaten-Lizenzvereinbarung mit der CME Group, der Börse hinter ES, NQ, CL, GC und den übrigen CME-/CBOT-/NYMEX-/COMEX-Futures, die Sie auf Tradovate handeln. Wenn Sie Echtzeit-Börsendaten über die Benutzeroberfläche eines Brokers beziehen, übernimmt der Broker diese Lizenzierung für Sie. Beziehen Sie dieselben Echtzeitdaten programmatisch über die <strong class='text-white'>API</strong>, behandelt CME Sie anders: Sie werden zu einem <strong class='text-white'>Sub-Vendor</strong> der Daten und müssen als solcher registriert und lizenziert sein." },
    { type: "paragraph", html: "Das ist keine Erfindung von Tradovate. Eine CME-Regelung, die am <strong class='text-white'>30. September 2022</strong> in Kraft trat, änderte die Vorgaben: Um weiterhin Marktdaten über die API anzubieten, müssen Broker seither jeden Nutzer, der diese Daten will, zur Registrierung als Sub-Vendor verpflichten. In der Praxis bedeutet das eine ILA und eine wiederkehrende Gebühr, üblicherweise <strong class='text-white'>rund 290 $ pro Monat</strong> für die Basisstufe, wobei umfangreichere oder höhere Datenstufen mehr kosten. Da sich die Preise für Börsendaten mit der Zeit ändern und je nach gewählter Stufe variieren, betrachten Sie jede genannte Zahl nur als Ausgangspunkt und bestätigen Sie die aktuellen Kosten direkt bei Tradovate und CME." },
    { type: "paragraph", html: "Jetzt kommt der Teil, der den meisten Tradern Geld spart: <strong class='text-white'>Die ILA deckt Marktdaten ab, nicht die Orderausführung.</strong> Sie können sich bei der API authentifizieren, Orders aufgeben, ändern und Ihr Konto sowie Ihre Fills auslesen, ohne sich jemals als Sub-Vendor registrieren zu müssen. Das Senden von Trades über die API funktioniert einwandfrei ohne CME ILA. Die Gebühr ist eine <strong class='text-white'>Daten</strong>kosten, keine <strong class='text-white'>Automatisierungs</strong>kosten." },
    { type: "heading", text: "Häufigste Ursachen für die überraschende CME-ILA-API-Gebühr" },
    { type: "heading", text: "1. Sie gingen davon aus, dass der API-Zugang Echtzeitdaten einschließt" },
    { type: "paragraph", html: "Der API-Zugang – das Add-on plus Ihr Key und Secret – ist etwas anderes als die Berechtigung, Echtzeit-Börsendaten über diese API zu streamen. Der Zugang ermöglicht Ihnen Verbindung und Handel. Echtzeit-Marktdaten über die API sind der Punkt, der die CME-Sub-Vendor-Anforderung auslöst." },
    { type: "heading", text: "2. Sie haben versucht, Echtzeit-Kurse über den WebSocket zu abonnieren" },
    { type: "paragraph", html: "Sobald Ihr Code den Marktdaten-Endpunkt aufruft, etwa eine Anfrage im Stil von <code>md/subscribeQuote</code>, für ein Live-CME-Symbol ohne die entsprechende Berechtigung, streamt der Feed entweder nicht oder liefert <strong class='text-white'>&ldquo;Symbol is inaccessible.&rdquo;</strong> zurück. Der Fehler liest sich wie ein falsches Symbol, ist aber tatsächlich eine Berechtigungs- und Lizenzlücke." },
    { type: "heading", text: "3. Sie haben die API-Add-on-Gebühr von Tradovate mit der CME-Datengebühr verwechselt" },
    { type: "paragraph", html: "Hier gibt es zwei unterschiedliche Kostenpunkte. Tradovate berechnet möglicherweise ein moderates monatliches <strong class='text-white'>API-Add-on</strong>, um den programmatischen Zugang zu ermöglichen, und CME stellt die <strong class='text-white'>ILA-Datenlizenz</strong> separat in Rechnung. Wenn Sie beide gedanklich zusammenzählen, wirkt die Summe bedrohlicher, als sie ist – und der große Posten, die ILA, lässt sich vermeiden, wenn Sie keine Echtzeit-API-Daten benötigen." },
    { type: "heading", text: "4. Sie nutzen ein Prop- oder Evaluierungskonto" },
    { type: "paragraph", html: "Bei finanzierten oder Evaluierungskonten besitzt und kontrolliert die Prop-Firma – nicht Sie – die Marktdatenberechtigung. Sich bei einem Prop-Konto selbst als CME-Sub-Vendor zu registrieren, ist der falsche Weg. Datenprobleme werden dort von der Firma gelöst." },
    { type: "heading", text: "5. Ihre Strategie hat den Echtzeit-Feed von Tradovate nie gebraucht" },
    { type: "paragraph", html: "Viele automatisierte Strategien berechnen ihre Einstiegs- und Ausstiegssignale auf <strong class='text-white'>TradingView</strong> (oder einer anderen Chart-Quelle) und benötigen Tradovate nur zur Ausführung. Wenn das auf Sie zutrifft, zahlen Sie mit ~290 $ pro Monat an CME für einen doppelten Echtzeit-Feed, den Sie nie anfassen." },
    { type: "heading", text: "So beheben Sie die CME-ILA-API-Gebühr: Schritt für Schritt" },
    { type: "paragraph", html: "Es gibt drei legitime Wege, vom günstigsten zum teuersten. Wählen Sie danach, ob Ihre Strategie wirklich Echtzeitdaten von der Tradovate API benötigt." },
    { type: "heading", text: "Lösung mit kostenlosen, um 10 Minuten verzögerten Daten (am günstigsten)" },
    { type: "paragraph", html: "Wenn Ihre Logik nicht von Live-Tradovate-Ticks abhängt, Sie einen langsameren Zeitrahmen handeln oder Ihre Signale von anderswo kommen, nutzen Sie die kostenlosen verzögerten Daten von Tradovate und umgehen Sie die ILA vollständig." },
    {
      type: "steps",
      items: [
        { title: "Wissen, was &ldquo;delayed&rdquo; bedeutet", html: "Kurse und Chart-Daten hinken der Echtzeit um etwa 10 Minuten hinterher und kosten nichts." },
        { title: "Auf die visuelle Kennzeichnung achten", html: "In der Plattform werden verzögerte Symbole visuell gekennzeichnet – ein orange dargestellter Symbolname bedeutet verzögerte statt Live-Daten." },
        { title: "Orderrouting auf der API belassen", html: "Das Aufgeben und Verwalten von Orders benötigt keine ILA, sodass die Ausführung vollständig live bleibt, auch wenn Ihre Daten verzögert sind." },
        { title: "Bestätigen, dass die Verzögerung akzeptabel ist", html: "Wählen Sie diesen Weg nur, wenn eine Verzögerung von ~10 Minuten für Ihre Strategie akzeptabel ist. Für Scalping oder alles, was auf Live-Ticks reagiert, ist er ungeeignet." },
      ],
    },
    { type: "heading", text: "Lösung durch Auslagerung der Marktdaten von der API (für die meisten Automatisierungen empfohlen)" },
    { type: "paragraph", html: "Der in der Praxis häufigste Aufbau besteht darin, über die Tradovate API auszuführen, die Signale jedoch aus einem Feed zu beziehen, den Sie bereits bezahlen, sodass Sie die CME-Sub-Vendor-Anforderung nie auslösen." },
    {
      type: "steps",
      items: [
        { title: "Signale dort erzeugen, wo Ihre Charts liegen", html: "Erzeugen Sie Ihre Einstiegs- und Ausstiegssignale dort, wo Ihre Charts bereits liegen, meist TradingView, auf dem Echtzeitdatenplan, den Sie dort bereits haben." },
        { title: "Webhook-Alerts auslösen", html: "Senden Sie diese Signale als Webhook-Alerts an eine Automatisierungsebene, Ihren eigenen Server oder einen Bridge-Dienst." },
        { title: "Die API nur zur Ausführung aufrufen", html: "Lassen Sie diese Ebene die Tradovate API aufrufen, um Orders zu platzieren. Die Orderplatzierung erfordert keine ILA, sodass keine CME-Datengebühr anfällt." },
        { title: "Nur einmal zahlen, auf der Chart-Seite", html: "Das Ergebnis: Sie zahlen Echtzeitdaten nur einmal, auf der Chart-Seite, die Sie ohnehin schon genutzt haben, und die API übernimmt ausschließlich die Ausführung." },
      ],
    },
    { type: "heading", text: "Lösung durch Lizenzierung von Echtzeit-API-Daten (wenn Sie sie wirklich benötigen)" },
    { type: "paragraph", html: "Wenn Ihre Strategie tatsächlich Live-Tradovate-/CME-Daten über die API benötigt – etwa ein latenzsensibler Bot für Orderbuchaufbau oder Market-Making –, ist die ILA unvermeidlich, und Sie sollten sie einkalkulieren." },
    {
      type: "steps",
      items: [
        { title: "Tradovate kontaktieren", html: "Kontaktieren Sie Tradovate, um die CME-Sub-Vendor-/ILA-Registrierung für API-Marktdaten zu starten." },
        { title: "Die richtige Datenstufe wählen", html: "Die Preise variieren je nach Stufe und ändern sich mit der Zeit. Lassen Sie sich die aktuelle Preisliste schriftlich geben. Die Basisstufe wird meist mit rund 290 $ pro Monat angegeben, umfangreichere Stufen kosten mehr." },
        { title: "Die Lizenzunterlagen abschließen", html: "Schließen Sie die Sub-Vendor-Lizenzunterlagen wie von CME vorgegeben ab. Dies ist eine echte Börsenvereinbarung, kein bloßes Häkchen." },
        { title: "Bestätigen, dass Live-Daten fließen", html: "Sobald Sie berechtigt sind, liefern Ihre API-Marktdaten-Abonnements, etwa Echtzeit-Kurs-Streams, Live-Daten statt &ldquo;Symbol is inaccessible&rdquo; oder verzögerter Werte." },
      ],
    },
    { type: "heading", text: "Fehlerbehebungstabelle" },
    {
      type: "table",
      headers: ["Fehler/Situation", "Was es bedeutet", "Lösung"],
      rows: [
        ["&ldquo;Symbol is inaccessible&rdquo; bei <code>md/subscribeQuote</code>", "Ihre API-Sitzung ist für dieses Symbol nicht zu Echtzeitdaten berechtigt", "Kostenlose verzögerte Daten nutzen, Daten außerhalb der API beziehen oder Echtzeitdaten über die CME ILA lizenzieren"],
        ["Angebotene ~290 $/Monat &ldquo;CME-Sub-Vendor&rdquo;-Gebühr", "Die CME ILA für das Streamen von Echtzeitdaten über die API", "Nur zahlen, wenn Sie wirklich Live-API-Daten benötigen; Orders erfordern sie nicht"],
        ["API-Marktdaten sind 10 Minuten im Rückstand", "Sie nutzen den kostenlosen verzögerten Feed von Tradovate", "In Ordnung für langsamere Strategien; Echtzeitdaten nur lizenzieren, wenn Sie Live-Ticks benötigen"],
        ["Orders werden abgelehnt und Sie vermuten die ILA als Ursache", "Die Orderausführung benötigt nie die ILA", "Suchen Sie anderswo: Risikolimits, Datenvereinbarungen, Kontrakt/Symbol – nicht die CME-Datenlizenz"],
        ["Symbolname wird orange angezeigt", "Visuelle Kennzeichnung für verzögerte (nicht Live-) Daten", "Auf dem kostenlosen Feed zu erwarten; keine Maßnahme nötig, außer Sie wollen Live-Ticks"],
        ["Prop-/Evaluierungskonto hat keine Echtzeitdaten", "Die Prop-Firma kontrolliert die Berechtigung", "Wenden Sie sich an die Firma; registrieren Sie sich nicht selbst als CME-Sub-Vendor"],
      ],
    },
    { type: "heading", text: "So vermeiden Sie das mit PickMyTrade" },
    { type: "paragraph", html: "Der sauberste Weg, die CME-ILA-Gebühr zu umgehen, besteht darin, Ihre Signale auf der Chart-Plattform zu belassen, die Sie ohnehin bezahlen, und eine dafür gebaute Bridge die Ausführung auf Tradovate übernehmen zu lassen. Genau nach diesem Modell arbeitet PickMyTrade: Die Daten bleiben auf TradingView, Orders werden an Tradovate weitergeleitet, und die CME-Datenlizenz von ~290 $/Monat kommt nie ins Spiel." },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Daten-außerhalb-der-API-Architektur</strong> – Signale stammen aus Ihrem TradingView-Plan, und Orders werden zur Ausführung an Tradovate weitergeleitet, sodass Sie keine Echtzeit-Marktdaten über die API beziehen und die CME-Sub-Vendor-Anforderung nicht auslösen.",
        "<strong class='text-white'>Kein Jonglieren mit eigenen API-Schlüsseln</strong> – Sie verknüpfen Ihr Konto einmalig, statt eigene API-Zugangsdaten und Datenberechtigungen pro Konto zu verwalten.",
        "<strong class='text-white'>Mengen-/Symbolvalidierung</strong> – Orders werden vor dem Versand gegen Ihren konfigurierten Kontrakt, Ihre Größe und Ihr Risiko geprüft, sodass ein fehlerhaftes Signal keine fehlerhafte Order auslöst.",
        "<strong class='text-white'>Multi-Konten-Synchronisierung</strong> – spiegeln Sie denselben Alert über mehrere Tradovate-Konten aus einem einzigen Setup, ohne für jedes Konto separat Daten zu lizenzieren.",
      ],
