---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "position-auto-closed-5pm-overnight-margin";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/debugging/${SLUG}`;

const META_TITLE = "Tradovate Position Closed by Itself at 5PM CT";
const META_DESCRIPTION =
  "Tradovate position closed at 5PM CT? It's overnight margin: hold the higher requirement or exit before the daily reset to stop auto-liquidation.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Tradovate-Position um 5PM CT von selbst geschlossen", es: "Tradovate cerró su posición sola a las 5PM CT", fr: "Position Tradovate clôturée toute seule à 5PM CT", it: "Posizione Tradovate chiusa da sola alle 5PM CT" },
  dek: { en: "You log back in and Tradovate has already flattened your winning swing trade, right around the 5:00 PM Central session reset. No stop was hit, no error popped up. Here's what overnight margin actually does and how to stop it from happening again.", de: "Sie loggen sich wieder ein, und Tradovate hat Ihren gewinnbringenden Swing-Trade bereits glattgestellt, ungefähr zum Sitzungswechsel um 5:00 PM Central. Kein Stop wurde ausgelöst, keine Fehlermeldung erschien. Hier erfahren Sie, was die Overnight-Margin tatsächlich bewirkt und wie Sie verhindern, dass es erneut passiert.", es: "Vuelve a iniciar sesión y Tradovate ya ha cerrado su operación swing ganadora, justo en torno al reinicio de sesión de las 5:00 PM Central. No se activó ningún stop ni apareció ningún error. Aquí le explicamos qué hace realmente el margen overnight y cómo evitar que vuelva a ocurrir.", fr: "Vous vous reconnectez et Tradovate a déjà clôturé votre swing trade gagnant, vers la réinitialisation de session de 5:00 PM Central. Aucun stop n'a été touché, aucune erreur n'est apparue. Voici ce que fait réellement la marge overnight et comment éviter que cela se reproduise.", it: "Si riconnette e Tradovate ha già chiuso il Suo swing trade in guadagno, intorno al reset di sessione delle 5:00 PM Central. Nessuno stop è stato colpito, nessun errore è comparso. Ecco che cosa fa davvero il margine overnight e come evitare che accada di nuovo." },
  readTime: { en: "7 min read", de: "7 Min. Lesezeit", es: "Lectura de 7 min", fr: "Lecture : 7 min", it: "Lettura di 7 min" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "You shut the laptop with a winning swing trade still open. You log back in, and Tradovate has already flattened it for you, right around the 5:00 PM Central session reset. No stop was hit. No error popped up. The position just vanished. It's one of the most confusing things a new futures trader runs into on Tradovate, and it almost always traces back to one thing: <strong class='text-white'>overnight margin</strong>. When the daily futures session rolls over, the reduced intraday (“day”) margin that let you hold a big position disappears, and the full <strong class='text-white'>overnight (initial) margin</strong> takes its place. If your account can't cover that higher number, Tradovate liquidates the position, quietly, and sometimes with a fee attached. Here's the good news: once you understand the day-versus-overnight switch, it's completely predictable, and a tool like PickMyTrade can fire a clean exit before the cutoff so you're never the one getting force-closed." },
    {
      type: "checklist",
      heading: "Quick Checklist for a Position Auto-Closed at Session Reset",
      items: [
        "<strong class='text-white'>Holding through the daily close?</strong> Reduced day margin ends minutes before the session reset, you need the full overnight requirement to carry a position through it.",
        "<strong class='text-white'>Check your available margin buffer.</strong> The overnight (initial) requirement can be several times the intraday rate, so a size that's comfortable at 2 PM can be unfundable at 5 PM.",
        "<strong class='text-white'>Trading a large size on a small account?</strong> Fewer contracts (or micros) survive the reset; oversized positions get liquidated first.",
        "<strong class='text-white'>On a prop or evaluation account?</strong> Many firms flatten every open position at the session close as a hard rule, this varies by firm, so check your plan's current rules.",
        "<strong class='text-white'>Close before the cutoff</strong> if you don't intend to fund the overnight requirement.",
        "<strong class='text-white'>Open the Fills / Orders report</strong> and look for a broker-initiated liquidation stamped around the session-reset time.",
      ],
    },
    { type: "heading", text: "What “Position Closed by Itself at 5PM CT” Means" },
    { type: "paragraph", html: "Tradovate doesn't throw a pop-up error for this one, which is exactly why it feels random. What actually happened is a <strong class='text-white'>margin-driven auto-liquidation</strong> tied to the daily futures session rollover." },
    { type: "paragraph", html: "Futures don't trade 24 hours straight. Each product runs a trading day that closes and re-opens once a day. For many CME products that daily break lands in the late afternoon Central time, and the new session opens around <strong class='text-white'>5:00 PM CT</strong>. At that point all the counters reset. During the trading day, Tradovate lets you post a much smaller <strong class='text-white'>intraday (day) margin</strong> per contract, but that discount only exists while the session is live. Roughly 15 minutes before the daily close, the day-margin discount is pulled and the exchange's full <strong class='text-white'>initial / overnight margin</strong> applies to anything you're still holding." },
    { type: "paragraph", html: "If your account equity sits below that overnight requirement at the reset, Tradovate flattens the position to bring the account back inside its risk limits. So overnight holds aren't banned, they simply cost far more margin, and an undercapitalized position can't survive the switch. You can hold through the close; you just need a big enough account to fund the higher requirement. A well-capitalized account carries the same position through the reset without a hiccup." },
    { type: "heading", text: "Top Causes of a Position Closing Itself at the Reset" },
    { type: "heading", text: "1. Day margin expired and overnight margin took over" },
    { type: "paragraph", html: "This is the root cause in the vast majority of cases. Intraday margin is a temporary discount that only applies while the session is open. The overnight (initial) requirement, the number the exchange actually wants to carry risk while nobody is watching, can run many times higher than the day rate. The exact multiple and dollar figures vary by product, exchange, and your account, and they change over time, so confirm the current numbers on Tradovate's live margin schedule rather than trusting an old screenshot." },
    { type: "heading", text: "2. Account balance below the overnight requirement" },
    { type: "paragraph", html: "Even a “small” one- or two-contract position can blow past your available margin once the overnight requirement kicks in. If your net liquidation value or available margin is under the initial requirement at the reset, the position becomes a candidate for liquidation. Micro contracts (MES, MNQ, MCL, and the like) require far less overnight margin than their full-size minis, which is why they're the usual pick for holding through the close on a smaller account." },
    { type: "heading", text: "3. Prop-firm or evaluation-account overnight rules" },
    { type: "paragraph", html: "If you're trading a funded or evaluation account through a prop firm, the firm, not just Tradovate, can force a flatten at the session close. Plenty of evaluation programs prohibit holding positions overnight entirely and auto-close everything at the daily reset regardless of your margin. These rules vary by firm and account size, so check your firm's current rulebook before assuming it was a pure margin event." },
    { type: "heading", text: "4. Product-specific close times and settlement" },
    { type: "paragraph", html: "Not every contract resets at the same minute. Equity index, energy, metals, and ag products can have slightly different session-close and margin-cutoff times, platinum, for instance, runs on a schedule that differs from the typical one. If your position closed at a time that doesn't match your mental picture of “5 PM,” the specific product's session schedule is the first thing to check." },
    { type: "heading", text: "How to Fix and Prevent Session-Close Auto-Liquidation: Step-by-Step" },
    { type: "heading", text: "Confirm it was a margin liquidation, not a stop or disconnect" },
    {
      type: "steps",
      items: [
        { title: "Open the Fills report", html: "Open the <strong class='text-white'>Fills</strong> (or Orders / trade history) report for the day." },
        { title: "Check the closing fill's timestamp", html: "Find the closing fill and check its timestamp, a margin liquidation lands at or just after the session reset, not at your stop price." },
        { title: "Confirm who initiated the closing order", html: "Note whether the closing order was broker/system initiated rather than one of your own working orders. If so, it was an auto-liquidation, not a stop-out or a platform disconnect." },
      ],
    },
    { type: "heading", text: "Fund the overnight requirement (if you want to hold)" },
    {
      type: "steps",
      items: [
        { title: "Look up the current overnight margin", html: "Look up the current <strong class='text-white'>overnight / initial margin</strong> for your product on Tradovate's margin schedule." },
        { title: "Compare it to your available margin", html: "Compare it to your account's available margin, keeping a comfortable buffer above the requirement." },
        { title: "Add funds or cut contracts", html: "Add funds or cut contracts so your equity clears the overnight number well before the cutoff, deposits don't clear instantly, so don't leave it to the last minute." },
      ],
    },
    { type: "heading", text: "Close (or downsize) before the daily cutoff" },
    {
      type: "steps",
      items: [
        { title: "Decide ahead of time", html: "Decide before the session close whether you're carrying the position overnight." },
        { title: "Flatten manually if not", html: "If not, flatten it a few minutes before the reset from the Positions panel rather than letting the broker do it at market." },
        { title: "Scale down or roll into micros", html: "If you want to stay in the trade but can't fund full size, scale down or roll into micros so the smaller overnight requirement fits your account." },
      ],
    },
    { type: "heading", text: "Check your prop firm's overnight policy" },
    {
      type: "list",
      items: [
        "Open your firm's rulebook or dashboard and search for “overnight,” “hold,” or “flatten.”",
        "If overnight holds are disallowed, plan to be flat before the session close every day, no margin buffer overrides a firm-level flatten rule.",
        "When in doubt, ask your firm's support directly; the rule varies by firm and by account tier.",
      ],
    },
    { type: "heading", text: "Troubleshooting Table" },
    {
      type: "table",
      headers: ["What you see", "What it means", "Fix"],
      rows: [
        ["Position gone right at ~5 PM CT, no stop hit", "Day margin expired; overnight margin exceeded your equity", "Hold enough overnight margin, or exit before the reset"],
        ["Broker/system-initiated fill in the report", "Auto-liquidation, not a stop-out", "Fund the overnight requirement or downsize"],
        ["Closed even though margin looked fine", "Prop-firm rule flattens all positions overnight", "Check your firm's overnight-hold policy"],
        ["A liquidation fee appears on the statement", "Forced close triggered a liquidation charge", "Keep a buffer; fees and amounts vary, check the current schedule"],
        ["Only large (mini) positions closed", "Overnight requirement scales with size", "Carry fewer contracts or switch to micros overnight"],
        ["Position closed at an odd time, not 5 PM", "Product has a different session/margin schedule", "Verify that contract's session-close time"],
      ],
    },
    { type: "heading", text: "Prevent This with PickMyTrade" },
    { type: "paragraph", html: "PickMyTrade links your TradingView alerts straight to Tradovate, so your entries and exits fire on rules instead of on whether you happen to be awake at the session close:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Time-Based Exit Automation</strong>, send a “flatten before the reset” alert so open positions close on your schedule, not the broker's liquidation queue.",
        "<strong class='text-white'>Qty / Symbol Validation</strong>, keeps order size aligned with what your account can actually carry, cutting down oversized holds that can't clear overnight margin.",
        "<strong class='text-white'>Entitlement &amp; Risk Filters</strong>, respect prop-firm limits and account state so automated orders don't fight your firm's overnight rules.",
        "<strong class='text-white'>Multi-Account Sync</strong>, mirrors the same protective exit across every connected account at once.",
      ],
    },
  ], de: [
    { type: "paragraph",html: "Sie klappen den Laptop zu, während ein gewinnbringender Swing-Trade noch offen ist. Sie loggen sich wieder ein, und Tradovate hat ihn bereits für Sie glattgestellt, ungefähr zum Sitzungswechsel um 5:00 PM Central. Kein Stop wurde ausgelöst. Es gab keine Fehlermeldung. Die Position war einfach weg. Das ist eines der verwirrendsten Dinge, auf die ein neuer Futures-Trader bei Tradovate stößt, und fast immer geht es auf eine einzige Ursache zurück: die <strong class='text-white'>Overnight-Margin</strong>. Wenn die tägliche Futures-Sitzung wechselt, verschwindet die reduzierte Intraday-Margin („Day“-Margin), die Ihnen das Halten einer großen Position ermöglichte, und die volle <strong class='text-white'>Overnight-Margin (Initial Margin)</strong> tritt an ihre Stelle. Kann Ihr Konto diese höhere Zahl nicht decken, liquidiert Tradovate die Position, stillschweigend und manchmal mit einer Gebühr. Die gute Nachricht: Sobald Sie den Wechsel zwischen Day- und Overnight-Margin verstehen, ist er vollkommen vorhersehbar, und ein Tool wie PickMyTrade kann vor dem Cutoff einen sauberen Ausstieg auslösen, sodass nicht Sie zwangsgeschlossen werden." },
    {
      type: "checklist",
      heading: "Kurze Checkliste bei einer beim Sitzungswechsel automatisch geschlossenen Position",
      items: [
        "<strong class='text-white'>Halten Sie über den täglichen Handelsschluss?</strong> Die reduzierte Day-Margin endet Minuten vor dem Sitzungswechsel; Sie benötigen die volle Overnight-Anforderung, um eine Position darüber hinaus zu halten.",
        "<strong class='text-white'>Prüfen Sie Ihren verfügbaren Margin-Puffer.</strong> Die Overnight-Anforderung (Initial) kann ein Vielfaches des Intraday-Satzes betragen, sodass eine Größe, die um 2 PM komfortabel ist, um 5 PM nicht mehr finanzierbar sein kann.",
        "<strong class='text-white'>Handeln Sie große Größen auf einem kleinen Konto?</strong> Weniger Kontrakte (oder Micros) überstehen den Wechsel; überdimensionierte Positionen werden zuerst liquidiert.",
        "<strong class='text-white'>Auf einem Prop- oder Evaluierungskonto?</strong> Viele Firmen stellen jede offene Position zum Sitzungsschluss als feste Regel glatt, das variiert je Firma, prüfen Sie also die aktuellen Regeln Ihres Plans.",
        "<strong class='text-white'>Schließen Sie vor dem Cutoff</strong>, wenn Sie die Overnight-Anforderung nicht finanzieren wollen.",
        "<strong class='text-white'>Öffnen Sie den Fills-/Orders-Bericht</strong> und suchen Sie nach einer vom Broker veranlassten Liquidation, die rund um den Zeitpunkt des Sitzungswechsels gestempelt ist.",
      ],
    },
    { type: "heading",text: "Was „Position um 5PM CT von selbst geschlossen“ bedeutet" },
    { type: "paragraph",html: "Tradovate zeigt dafür keine Fehlermeldung als Pop-up an, und genau deshalb wirkt es zufällig. Was tatsächlich geschah, ist eine <strong class='text-white'>margin-bedingte automatische Liquidation</strong> im Zusammenhang mit dem täglichen Sitzungswechsel der Futures." },
    { type: "paragraph",html: "Futures werden nicht 24 Stunden am Stück gehandelt. Jedes Produkt hat einen Handelstag, der einmal täglich endet und wieder öffnet. Bei vielen CME-Produkten liegt diese tägliche Pause am späten Nachmittag Central Time, und die neue Sitzung öffnet gegen <strong class='text-white'>5:00 PM CT</strong>. Dann werden alle Zähler zurückgesetzt. Während des Handelstages erlaubt Tradovate pro Kontrakt eine deutlich kleinere <strong class='text-white'>Intraday-Margin (Day-Margin)</strong>, doch dieser Rabatt existiert nur, solange die Sitzung läuft. Etwa 15 Minuten vor dem täglichen Schluss wird der Day-Margin-Rabatt entzogen, und die volle <strong class='text-white'>Initial-/Overnight-Margin</strong> der Börse gilt für alles, was Sie noch halten." },
    { type: "paragraph",html: "Liegt Ihr Kontoeigenkapital beim Wechsel unter dieser Overnight-Anforderung, stellt Tradovate die Position glatt, um das Konto wieder innerhalb seiner Risikolimits zu bringen. Overnight-Positionen sind also nicht verboten, sie kosten lediglich weit mehr Margin, und eine unterkapitalisierte Position übersteht den Wechsel nicht. Sie können über den Handelsschluss halten; Sie brauchen nur ein ausreichend großes Konto, um die höhere Anforderung zu finanzieren. Ein gut kapitalisiertes Konto trägt dieselbe Position ohne Zwischenfall durch den Wechsel." },
    { type: "heading",text: "Häufigste Ursachen dafür, dass sich eine Position beim Wechsel selbst schließt" },
    { type: "heading",text: "1. Die Day-Margin ist abgelaufen und die Overnight-Margin hat übernommen" },
    { type: "paragraph",html: "Das ist in der überwiegenden Mehrheit der Fälle die Grundursache. Die Intraday-Margin ist ein vorübergehender Rabatt, der nur bei geöffneter Sitzung gilt. Die Overnight-Anforderung (Initial), also die Zahl, die die Börse wirklich will, um Risiko zu tragen, während niemand zusieht, kann ein Vielfaches des Day-Satzes betragen. Das genaue Vielfache und die Dollarbeträge variieren je nach Produkt, Börse und Ihrem Konto und ändern sich im Lauf der Zeit; prüfen Sie daher die aktuellen Zahlen im Live-Margin-Zeitplan von Tradovate, statt einem alten Screenshot zu vertrauen." },
    { type: "heading",text: "2. Kontostand unter der Overnight-Anforderung" },
    { type: "paragraph",html: "Selbst eine „kleine“ Position mit ein oder zwei Kontrakten kann Ihre verfügbare Margin übersteigen, sobald die Overnight-Anforderung greift. Liegt Ihr Nettoliquidationswert oder Ihre verfügbare Margin beim Wechsel unter der Initial-Anforderung, wird die Position zum Liquidationskandidaten. Micro-Kontrakte (MES, MNQ, MCL und ähnliche) erfordern weit weniger Overnight-Margin als ihre Full-Size-Minis, weshalb sie die übliche Wahl sind, um auf einem kleineren Konto über den Handelsschluss zu halten." },
    { type: "heading",text: "3. Overnight-Regeln von Prop-Firmen oder Evaluierungskonten" },
    { type: "paragraph",html: "Wenn Sie ein Funded- oder Evaluierungskonto über eine Prop-Firma handeln, kann die Firma, nicht nur Tradovate, zum Sitzungsschluss ein Glattstellen erzwingen. Viele Evaluierungsprogramme verbieten das Halten von Positionen über Nacht komplett und schließen beim täglichen Wechsel unabhängig von Ihrer Margin alles automatisch. Diese Regeln variieren je nach Firma und Kontogröße; prüfen Sie daher das aktuelle Regelwerk Ihrer Firma, bevor Sie annehmen, es sei ein reines Margin-Ereignis gewesen." },
    { type: "heading",text: "4. Produktspezifische Schlusszeiten und Abrechnung" },
    { type: "paragraph",html: "Nicht jeder Kontrakt wechselt zur selben Minute. Aktienindex-, Energie-, Metall- und Agrarprodukte können leicht abweichende Zeiten für Sitzungsschluss und Margin-Cutoff haben; Platin zum Beispiel folgt einem Zeitplan, der vom üblichen abweicht. Wurde Ihre Position zu einer Zeit geschlossen, die nicht Ihrer Vorstellung von „5 PM“ entspricht, ist der Sitzungszeitplan des jeweiligen Produkts das Erste, was Sie prüfen sollten." },
    { type: "heading",text: "So beheben und verhindern Sie die Liquidation beim Sitzungsschluss: Schritt für Schritt" },
    { type: "heading",text: "Bestätigen Sie, dass es eine Margin-Liquidation war, kein Stop und keine Trennung" },
    {
      type: "steps",
      items: [
        { title: "Fills-Bericht öffnen", html: "Öffnen Sie den <strong class='text-white'>Fills</strong>-Bericht (oder den Orders-/Trade-Verlauf) des Tages." },
        { title: "Zeitstempel der schließenden Ausführung prüfen", html: "Suchen Sie die schließende Ausführung und prüfen Sie ihren Zeitstempel: Eine Margin-Liquidation erfolgt zum oder kurz nach dem Sitzungswechsel, nicht zu Ihrem Stop-Kurs." },
        { title: "Prüfen, wer die schließende Order ausgelöst hat", html: "Beachten Sie, ob die schließende Order vom Broker/System ausgelöst wurde und nicht eine Ihrer eigenen aktiven Orders war. Wenn ja, handelte es sich um eine automatische Liquidation, nicht um einen Stop-out oder eine Plattformtrennung." },
      ],
    },
    { type: "heading",text: "Finanzieren Sie die Overnight-Anforderung (wenn Sie halten wollen)" },
    {
      type: "steps",
      items: [
        { title: "Aktuelle Overnight-Margin nachschlagen", html: "Schlagen Sie die aktuelle <strong class='text-white'>Overnight-/Initial-Margin</strong> Ihres Produkts im Margin-Zeitplan von Tradovate nach." },
        { title: "Mit Ihrer verfügbaren Margin vergleichen", html: "Vergleichen Sie sie mit der verfügbaren Margin Ihres Kontos und halten Sie einen komfortablen Puffer über der Anforderung." },
        { title: "Geld einzahlen oder Kontrakte reduzieren", html: "Zahlen Sie Geld ein oder reduzieren Sie Kontrakte, damit Ihr Eigenkapital die Overnight-Zahl deutlich vor dem Cutoff übersteigt; Einzahlungen werden nicht sofort gutgeschrieben, lassen Sie es also nicht bis zur letzten Minute." },
      ],
    },
    { type: "heading",text: "Schließen (oder verkleinern) Sie vor dem täglichen Cutoff" },
    {
      type: "steps",
      items: [
        { title: "Vorab entscheiden", html: "Entscheiden Sie vor dem Sitzungsschluss, ob Sie die Position über Nacht halten." },
        { title: "Andernfalls manuell glattstellen", html: "Wenn nicht, stellen Sie sie einige Minuten vor dem Wechsel über das Positions-Panel glatt, statt den Broker das zum Marktkurs erledigen zu lassen." },
        { title: "Verkleinern oder auf Micros umsteigen", html: "Wenn Sie im Trade bleiben möchten, die volle Größe aber nicht finanzieren können, reduzieren Sie die Größe oder wechseln Sie auf Micros, damit die kleinere Overnight-Anforderung zu Ihrem Konto passt." },
      ],
    },
    { type: "heading",text: "Prüfen Sie die Overnight-Regeln Ihrer Prop-Firma" },
    {
      type: "list",
      items: [
        "Öffnen Sie das Regelwerk oder das Dashboard Ihrer Firma und suchen Sie nach „overnight“, „hold“ oder „flatten“.",
        "Sind Overnight-Positionen untersagt, planen Sie, jeden Tag vor dem Sitzungsschluss flat zu sein; kein Margin-Puffer setzt eine Glattstellungsregel der Firma außer Kraft.",
        "Fragen Sie im Zweifel direkt beim Support Ihrer Firma nach; die Regel variiert je nach Firma und Kontostufe.",
      ],
    },
    { type: "heading",text: "Tabelle zur Fehlerbehebung" },
    { type: "table", headers: ["Was Sie sehen","Was es bedeutet","Lösung"], rows: [
      ["Position genau um ~5 PM CT weg, kein Stop ausgelöst","Day-Margin abgelaufen; Overnight-Margin überstieg Ihr Eigenkapital","Ausreichend Overnight-Margin vorhalten oder vor dem Wechsel aussteigen"],
      ["Vom Broker/System veranlasste Ausführung im Bericht","Automatische Liquidation, kein Stop-out","Overnight-Anforderung finanzieren oder verkleinern"],
      ["Geschlossen, obwohl die Margin in Ordnung aussah","Eine Prop-Firm-Regel stellt über Nacht alle Positionen glatt","Prüfen Sie die Overnight-Regeln Ihrer Firma"],
      ["Eine Liquidationsgebühr erscheint auf dem Kontoauszug","Die Zwangsschließung löste eine Liquidationsgebühr aus","Puffer vorhalten; Gebühren und Beträge variieren, prüfen Sie den aktuellen Gebührenplan"],
      ["Nur große (Mini-)Positionen wurden geschlossen","Die Overnight-Anforderung skaliert mit der Größe","Weniger Kontrakte halten oder über Nacht auf Micros wechseln"],
      ["Position zu einer ungewöhnlichen Zeit geschlossen, nicht um 5 PM","Das Produkt hat einen anderen Sitzungs-/Margin-Zeitplan","Sitzungsschlusszeit dieses Kontrakts prüfen"],
    ] },
    { type: "heading",text: "Verhindern Sie das mit PickMyTrade" },
    { type: "paragraph",html: "PickMyTrade verbindet Ihre TradingView-Alerts direkt mit Tradovate, sodass Ihre Einstiege und Ausstiege nach Regeln erfolgen und nicht davon abhängen, ob Sie zum Sitzungsschluss gerade wach sind:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Zeitbasierte Ausstiegsautomatisierung</strong>, senden Sie einen „Glattstellen vor dem Wechsel“-Alert, damit offene Positionen nach Ihrem Zeitplan schließen und nicht in der Liquidationswarteschlange des Brokers.",
        "<strong class='text-white'>Qty-/Symbol-Validierung</strong>, hält die Ordergröße im Einklang mit dem, was Ihr Konto tatsächlich tragen kann, und reduziert überdimensionierte Positionen, die die Overnight-Margin nicht erfüllen.",
        "<strong class='text-white'>Berechtigungs- &amp; Risikofilter</strong>, respektieren die Limits der Prop-Firma und den Kontostatus, damit automatisierte Orders nicht gegen die Overnight-Regeln Ihrer Firma arbeiten.",
        "<strong class='text-white'>Multi-Account-Synchronisation</strong>, spiegelt denselben Schutzausstieg gleichzeitig auf alle verbundenen Konten.",
      ],
    },
  ], es: [
    { type: "paragraph",html: "Cierra el portátil con una operación swing ganadora aún abierta. Vuelve a iniciar sesión y Tradovate ya la ha cerrado por usted, justo en torno al reinicio de sesión de las 5:00 PM Central. No se activó ningún stop. No apareció ningún error. La posición simplemente desapareció. Es una de las cosas más desconcertantes con las que se topa un trader de futuros nuevo en Tradovate, y casi siempre se debe a una sola cosa: el <strong class='text-white'>margen overnight</strong>. Cuando la sesión diaria de futuros se reinicia, desaparece el margen intradía reducido («day») que le permitía mantener una posición grande, y lo sustituye el <strong class='text-white'>margen overnight (inicial)</strong> completo. Si su cuenta no puede cubrir esa cifra más alta, Tradovate liquida la posición, en silencio y a veces con una comisión. La buena noticia: una vez que entiende el cambio entre margen intradía y overnight, es completamente predecible, y una herramienta como PickMyTrade puede lanzar una salida limpia antes del corte para que nunca sea usted quien sufra un cierre forzoso." },
    {
      type: "checklist",
      heading: "Lista de comprobación rápida para una posición cerrada automáticamente en el reinicio de sesión",
      items: [
        "<strong class='text-white'>¿Mantiene la posición durante el cierre diario?</strong> El margen intradía reducido termina minutos antes del reinicio de sesión; necesita el requisito overnight completo para mantener una posición a través de él.",
        "<strong class='text-white'>Compruebe su colchón de margen disponible.</strong> El requisito overnight (inicial) puede ser varias veces la tarifa intradía, así que un tamaño cómodo a las 2 PM puede ser inasumible a las 5 PM.",
        "<strong class='text-white'>¿Opera un tamaño grande en una cuenta pequeña?</strong> Menos contratos (o micros) sobreviven al reinicio; las posiciones sobredimensionadas son las primeras en liquidarse.",
        "<strong class='text-white'>¿En una cuenta prop o de evaluación?</strong> Muchas firmas cierran todas las posiciones abiertas al cierre de la sesión como norma estricta; varía según la firma, así que consulte las reglas vigentes de su plan.",
        "<strong class='text-white'>Cierre antes del corte</strong> si no tiene intención de financiar el requisito overnight.",
        "<strong class='text-white'>Abra el informe de Fills / Orders</strong> y busque una liquidación iniciada por el bróker con sello de hora en torno al reinicio de sesión.",
      ],
    },
    { type: "heading",text: "Qué significa «Posición cerrada sola a las 5PM CT»" },
    { type: "paragraph",html: "Tradovate no muestra una ventana de error para este caso, y por eso parece aleatorio. Lo que ocurrió realmente es una <strong class='text-white'>liquidación automática por margen</strong> vinculada al cambio diario de sesión de los futuros." },
    { type: "paragraph",html: "Los futuros no se negocian 24 horas seguidas. Cada producto tiene un día de negociación que cierra y reabre una vez al día. Para muchos productos de CME esa pausa diaria cae a última hora de la tarde, hora Central, y la nueva sesión abre en torno a las <strong class='text-white'>5:00 PM CT</strong>. En ese momento se reinician todos los contadores. Durante el día de negociación, Tradovate le permite aportar un <strong class='text-white'>margen intradía (day)</strong> por contrato mucho menor, pero ese descuento solo existe mientras la sesión está activa. Unos 15 minutos antes del cierre diario se retira el descuento de margen intradía y se aplica a todo lo que aún mantiene el <strong class='text-white'>margen inicial / overnight</strong> completo de la bolsa." },
    { type: "paragraph",html: "Si el capital de su cuenta está por debajo de ese requisito overnight en el reinicio, Tradovate cierra la posición para devolver la cuenta a sus límites de riesgo. Por tanto, mantener posiciones overnight no está prohibido; simplemente exige mucho más margen, y una posición infracapitalizada no sobrevive al cambio. Puede mantener durante el cierre; solo necesita una cuenta lo bastante grande para financiar el requisito más alto. Una cuenta bien capitalizada mantiene la misma posición durante el reinicio sin sobresaltos." },
    { type: "heading",text: "Principales causas de que una posición se cierre sola en el reinicio" },
    { type: "heading",text: "1. El margen intradía expiró y asumió el margen overnight" },
    { type: "paragraph",html: "Esta es la causa raíz en la gran mayoría de los casos. El margen intradía es un descuento temporal que solo se aplica mientras la sesión está abierta. El requisito overnight (inicial), la cifra que la bolsa realmente quiere para asumir riesgo mientras nadie mira, puede ser muchas veces superior a la tarifa intradía. El múltiplo exacto y las cifras en dólares varían según el producto, la bolsa y su cuenta, y cambian con el tiempo, así que confirme las cifras actuales en el calendario de márgenes en vivo de Tradovate en lugar de fiarse de una captura antigua." },
    { type: "heading",text: "2. Saldo de la cuenta por debajo del requisito overnight" },
    { type: "paragraph",html: "Incluso una posición «pequeña» de uno o dos contratos puede superar su margen disponible cuando entra en vigor el requisito overnight. Si su valor neto de liquidación o su margen disponible está por debajo del requisito inicial en el reinicio, la posición pasa a ser candidata a liquidación. Los contratos micro (MES, MNQ, MCL y similares) requieren mucho menos margen overnight que sus minis de tamaño completo, por eso son la elección habitual para mantener durante el cierre en una cuenta pequeña." },
    { type: "heading",text: "3. Reglas overnight de la prop firm o de la cuenta de evaluación" },
    { type: "paragraph",html: "Si opera una cuenta fondeada o de evaluación a través de una prop firm, la firma, y no solo Tradovate, puede forzar el cierre al final de la sesión. Muchos programas de evaluación prohíben por completo mantener posiciones overnight y cierran automáticamente todo en el reinicio diario, con independencia de su margen. Estas reglas varían según la firma y el tamaño de la cuenta, así que consulte el reglamento vigente de su firma antes de asumir que fue un evento puramente de margen." },
    { type: "heading",text: "4. Horas de cierre y liquidación específicas de cada producto" },
    { type: "paragraph",html: "No todos los contratos se reinician en el mismo minuto. Los productos de índices bursátiles, energía, metales y agrícolas pueden tener horas de cierre de sesión y de corte de margen ligeramente distintas; el platino, por ejemplo, sigue un calendario que difiere del habitual. Si su posición se cerró a una hora que no coincide con su idea de «las 5 PM», lo primero que debe comprobar es el calendario de sesión del producto concreto." },
    { type: "heading",text: "Cómo corregir y prevenir la liquidación al cierre de sesión: paso a paso" },
    { type: "heading",text: "Confirme que fue una liquidación por margen, no un stop ni una desconexión" },
    {
      type: "steps",
      items: [
        { title: "Abra el informe de Fills", html: "Abra el informe de <strong class='text-white'>Fills</strong> (o el historial de Orders / operaciones) del día." },
        { title: "Compruebe la marca de hora de la ejecución de cierre", html: "Localice la ejecución de cierre y compruebe su marca de hora: una liquidación por margen se produce en el reinicio de sesión o justo después, no a su precio de stop." },
        { title: "Confirme quién inició la orden de cierre", html: "Anote si la orden de cierre fue iniciada por el bróker o el sistema y no una de sus propias órdenes activas. Si es así, fue una liquidación automática, no un stop ni una desconexión de la plataforma." },
      ],
    },
    { type: "heading",text: "Financie el requisito overnight (si quiere mantener)" },
    {
      type: "steps",
      items: [
        { title: "Consulte el margen overnight vigente", html: "Consulte el <strong class='text-white'>margen overnight / inicial</strong> vigente de su producto en el calendario de márgenes de Tradovate." },
        { title: "Compárelo con su margen disponible", html: "Compárelo con el margen disponible de su cuenta, manteniendo un colchón cómodo por encima del requisito." },
        { title: "Añada fondos o reduzca contratos", html: "Añada fondos o reduzca contratos para que su capital supere la cifra overnight con holgura antes del corte; los depósitos no se acreditan al instante, así que no lo deje para el último minuto." },
      ],
    },
    { type: "heading",text: "Cierre (o reduzca) antes del corte diario" },
    {
      type: "steps",
      items: [
        { title: "Decídalo con antelación", html: "Decida antes del cierre de sesión si va a mantener la posición overnight." },
        { title: "Ciérrela manualmente si no", html: "Si no, ciérrela unos minutos antes del reinicio desde el panel de Positions en lugar de dejar que lo haga el bróker a mercado." },
        { title: "Reduzca o pase a micros", html: "Si quiere seguir en la operación pero no puede financiar el tamaño completo, reduzca o pase a micros para que el menor requisito overnight encaje con su cuenta." },
      ],
    },
    { type: "heading",text: "Consulte la política overnight de su prop firm" },
    {
      type: "list",
      items: [
        "Abra el reglamento o el panel de su firma y busque «overnight», «hold» o «flatten».",
        "Si no se permiten posiciones overnight, planifique estar flat antes del cierre de sesión cada día; ningún colchón de margen anula una norma de cierre a nivel de firma.",
        "En caso de duda, pregunte directamente al soporte de su firma; la norma varía según la firma y el nivel de cuenta.",
      ],
    },
    { type: "heading",text: "Tabla de solución de problemas" },
    { type: "table", headers: ["Qué ve","Qué significa","Solución"], rows: [
      ["Posición desaparecida justo a las ~5 PM CT, sin stop activado","El margen intradía expiró; el margen overnight superó su capital","Mantenga margen overnight suficiente o salga antes del reinicio"],
