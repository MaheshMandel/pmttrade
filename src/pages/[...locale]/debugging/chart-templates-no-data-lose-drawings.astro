---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "chart-templates-no-data-lose-drawings";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/debugging/${SLUG}`;

const META_TITLE = "Tradovate Chart Templates Don't Load Data";
const META_DESCRIPTION =
  "Tradovate chart templates open blank or drop your drawings? Learn what templates really save, why markups vanish, and how to keep your full setup.";

// Short SEO title (<=60 chars) for locales where the shared h1 is too long for a SERP title.
const TITLE_OVERRIDE: Partial<Record<Locale, string>> = { fr: "Tradovate : modèles de graphique sans données" };

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Tradovate-Chart-Vorlagen laden keine Daten", es: "Las plantillas de gráficos de Tradovate no cargan datos", fr: "Les modèles de graphique Tradovate ne chargent pas les données", it: "I modelli di grafico di Tradovate non caricano i dati" },
  dek: { en: "Chart template comes up with missing bars, or worse, every trendline you drew is gone? Here's exactly what a Tradovate template does and doesn't save, and how to keep your full setup with a workspace instead.", de: "Die Chart-Vorlage öffnet sich mit fehlenden Kerzen, oder schlimmer noch, jede Trendlinie, die Sie gezeichnet haben, ist verschwunden? Hier erfahren Sie genau, was eine Tradovate-Vorlage speichert und was nicht, und wie Sie Ihr komplettes Setup stattdessen mit einem Workspace erhalten.", es: "¿La plantilla de gráfico aparece con velas faltantes o, peor aún, cada línea de tendencia que dibujó ha desaparecido? Aquí le explicamos exactamente qué guarda y qué no guarda una plantilla de Tradovate, y cómo conservar toda su configuración con un workspace.", fr: "Le modèle de graphique s'ouvre avec des bougies manquantes, ou pire, chaque ligne de tendance que vous avez tracée a disparu ? Voici exactement ce qu'un modèle Tradovate enregistre et n'enregistre pas, et comment conserver votre configuration complète grâce à un espace de travail.", it: "Il modello di grafico si apre con candele mancanti o, peggio, ogni trendline disegnata è sparita? Ecco esattamente cosa salva e cosa non salva un modello Tradovate, e come conservare l'intera configurazione usando invece un workspace." },
  readTime: { en: "7 min read", de: "7 Minuten Lesezeit", es: "Lectura de 7 minutos", fr: "Lecture de 7 minutes", it: "Lettura di 7 minuti" },
  lastUpdated: "2026-07-08",
  heroImage: { src: `${IMG}/chart-templates-no-data-lose-drawings-1.png`, alt: { en: "Tradovate chart menu open with the Templates option and Save Template highlighted", de: "Geöffnetes Tradovate-Chart-Menü mit hervorgehobener Option Templates und Save Template", es: "Menú del gráfico de Tradovate abierto con la opción Templates y Save Template resaltadas", fr: "Menu du graphique Tradovate ouvert avec l'option Templates et Save Template mises en évidence", it: "Menu del grafico Tradovate aperto con l'opzione Templates e Save Template evidenziate" } },
  blocks: { en: [
    { type: "paragraph", html: "You saved a chart template, reopened it later, and the chart came up wrong. Maybe the bars are missing, maybe the space is just empty, or maybe the worst version happened and every trendline and level you drew during the session is gone. It's frustrating, because in futures your levels <em>are</em> the plan." },
    { type: "paragraph", html: "Here's the short answer before we get into the weeds: a Tradovate chart template was never designed to carry your drawings or force historical data to load. It stores your indicator setup and the chart's look, timeframe, style, colors, indicator parameters, and that's about the extent of it. Your trendlines, zones and horizontal levels belong to the <strong class='text-white'>workspace</strong>, not the template. So the reliable move is to save a full workspace for anything you want to keep, treat templates as a look-and-feel preset, and recreate a chart by hand when a template refuses to bring its data or markups along." },
    { type: "heading", text: "What a Chart Template Actually Saves" },
    { type: "paragraph", html: "This is where most of the confusion starts. A template in Tradovate saves indicator settings and chart appearance. It does not save the DOM, the window layout, or your drawings. When you apply it, you're loading a visual preset onto whatever chart is already open, you're not restoring a snapshot of your analysis." },
    { type: "paragraph", html: "To save one, open the chart's own menu (the small menu icon in the chart's top corner), go to the Templates option, and choose Save Template. Give it a clear name so you can find it again." },
    { type: "paragraph", html: "Here's the split that trips people up, laid out plainly:" },
    {
      type: "table",
      headers: ["Saved by a chart template", "NOT saved by a template"],
      rows: [
        ["Indicator selection and their parameters", "Trendlines, rays, horizontal levels"],
        ["Chart style (candles, bars, colors)", "Zones, rectangles, boxes, text notes"],
        ["Timeframe and chart appearance settings", "Window and multi-chart layout"],
        ["Reusable &ldquo;look&rdquo; you can apply to any chart", "The DOM / SuperDOM setup"],
        ["&mdash;", "Historical price data (it isn't re-fetched)"],
      ],
    },
    { type: "paragraph", html: "Read that right column again. Every item there is something people <em>expect</em> a template to hold, and none of it is included. Once you internalize that, most of the weird behavior stops being a mystery." },
    { type: "heading", text: "Why the Chart Loads With No Data" },
    { type: "paragraph", html: "Applying a template doesn't pull in price history. It swaps settings on the chart you're looking at. So if a chart opens blank or with a stretch of empty space, you're really looking at a data-loading problem sitting on top of a fresh template, two separate things that happen to show up together." },
    { type: "paragraph", html: "A couple of things fix this quickly:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Scroll back through the history.</strong> Dragging the chart to the left forces Tradovate to request older bars and fill the gap.",
        "<strong class='text-white'>Reload the chart or the app.</strong> A refresh often re-pulls the series cleanly when it loaded half-empty.",
        "<strong class='text-white'>Raise the minimum bars to load.</strong> If charts routinely open short on history, bumping this up preloads more data so indicators like EMA and VWAP have enough to calculate from the first candle.",
      ],
    },
    { type: "image", src: `${IMG}/chart-templates-no-data-lose-drawings-2.png`, alt: "Tradovate chart showing an empty gap where historical bars have not loaded, with the scroll-back area highlighted" },
    { type: "paragraph", html: "There's one more wrinkle worth knowing. A saved template has shown a habit of displaying only in the chart window it was created in, you'll see the checkmark next to its name, but it won't paint onto a different window. If that happens, apply the template from within the window you actually want it in, or just rebuild it there and save again. This is why the practical advice is to recreate charts manually where you can, rather than expecting a template to travel cleanly across every window." },
    { type: "heading", text: "Why Your Drawings Disappear" },
    { type: "paragraph", html: "Your levels aren't hiding in the template, they were never in it. Drawings attach to the chart object list inside a workspace. So when a template loads and your lines are gone, nothing broke; the template simply has no drawings to give." },
    { type: "paragraph", html: "Before you assume they're lost for good, check two things:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>The object list / eye icons.</strong> Open the chart's object list (the tree of indicators and drawings) and make sure the visibility eye next to each drawing is on. It's easy to hide a level by accident.",
        "<strong class='text-white'>The date you drew it on.</strong> A line anchored to a specific candle only shows when that candle is on screen. Scroll back to the day you drew it and it should reappear.",
      ],
    },
    { type: "image", src: `${IMG}/chart-templates-no-data-lose-drawings-3.png`, alt: "Tradovate chart object list panel showing indicators and drawings with the visibility eye icons" },
    { type: "paragraph", html: "There's also a known, long-running sync quirk where drawings vanish across app restarts, across devices, or when you drop to a lower timeframe. If your markups keep evaporating even after checking the two things above, that's a separate issue worth digging into on its own, and if the chart itself is loading short, that's a data-loading problem worth chasing down separately too." },
    { type: "heading", text: "The Reliable Fix: Save a Workspace, Rebuild Where Needed" },
    { type: "paragraph", html: "Templates are a nice-to-have for indicator presets. The thing that actually preserves your work is a workspace. A workspace captures your window layout, the charts, the indicators <em>and</em> the drawings on them, which is exactly the stuff a template drops." },
    {
      type: "steps",
      items: [
        { title: "Get the chart exactly how you want it", html: "Timeframe set, indicators added, levels and trendlines drawn." },
        { title: "Save the workspace", html: "From the Tradovate logo menu, open Workspaces and save the current workspace. Give it a name you'll recognize, like &ldquo;ES intraday.&rdquo;" },
        { title: "Optionally save a chart template too", html: "From the chart menu, so you can drop the same <em>look</em> onto a brand-new chart later without redrawing indicators." },
        { title: "Rebuild when a template won't cooperate", html: "When a template won't bring its data or markups into a window, stop fighting it, recreate the setup in that window and re-save the workspace. It's faster than troubleshooting a feature that isn't meant to do this." },
      ],
    },
    { type: "image", src: `${IMG}/chart-templates-no-data-lose-drawings-4.png`, alt: "Tradovate logo menu expanded showing the Workspaces option with Save and Load actions" },
    { type: "heading", text: "Quick Reference: Symptom, Cause, Fix" },
    {
      type: "table",
      headers: ["What you see", "Why it happens", "What to do"],
      rows: [
        ["Template loads, chart is blank / gaps", "Templates don't fetch price history", "Scroll back, reload, or raise minimum bars to load"],
        ["Template loads, drawings gone", "Drawings aren't stored in templates", "Save a workspace; check object list eye icons"],
        ["Template checkmarked but won't apply", "Template tends to stick to its origin window", "Apply it inside the target window or rebuild there"],
        ["Lines on ES missing on MES", "Drawings don't cross symbols", "Redraw per contract or keep both in one workspace"],
        ["Markups vanish after restart", "Known drawing-sync defect", "Scroll to the drawing's date; report to support"],
      ],
    },
    { type: "heading", text: "Stop Losing Your Setup Again" },
    { type: "paragraph", html: "A few habits keep this from biting you mid-session:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Save a workspace at the end of each session</strong>, not just when you remember. That's your real backup.",
        "<strong class='text-white'>Keep one clean, no-drawings template</strong> for a fast reset when a chart gets cluttered.",
        "<strong class='text-white'>Name templates and workspaces clearly</strong>, by instrument and style, so you're not guessing later.",
        "<strong class='text-white'>Don't expect templates to cross symbols.</strong> ES and MES are different instruments as far as your drawings are concerned.",
      ],
    },
    { type: "heading", text: "When It's Expected Behavior vs an Actual Bug" },
    { type: "paragraph", html: "Two of these are just how the platform works, and no amount of clicking will change them: a template not carrying drawings, and a template not re-fetching data. Save a workspace and move on." },
    { type: "paragraph", html: "The ones worth reporting are drawings that disappear after a restart despite being saved in a workspace, and a template that stubbornly refuses to apply to any window. Reach Tradovate through the in-platform chat or email so it's logged. If you're on a prop-firm or evaluation account and the problem is really missing market data rather than templates, your data is enabled by the firm, contact them, since Tradovate can't fix data on an account it doesn't own." },
  ], de: [
    { type: "paragraph", html: "Sie haben eine Chart-Vorlage gespeichert, sie später wieder geöffnet, und der Chart sah falsch aus. Vielleicht fehlen Kerzen, vielleicht ist der Bereich einfach leer, oder im schlimmsten Fall ist jede Trendlinie und jedes Level, das Sie während der Sitzung gezeichnet haben, verschwunden. Das ist frustrierend, denn im Futures-Handel <em>sind</em> Ihre Levels der Plan." },
    { type: "paragraph", html: "Hier die kurze Antwort, bevor wir ins Detail gehen: Eine Tradovate-Chart-Vorlage war nie dafür gedacht, Ihre Zeichnungen zu übertragen oder das Laden historischer Daten zu erzwingen. Sie speichert Ihr Indikator-Setup sowie das Aussehen des Charts, Zeitrahmen, Stil, Farben und Indikatorparameter, und das ist im Wesentlichen alles. Ihre Trendlinien, Zonen und horizontalen Levels gehören zum <strong class='text-white'>Workspace</strong>, nicht zur Vorlage. Der zuverlässige Weg ist daher, für alles, was Sie behalten möchten, einen vollständigen Workspace zu speichern, Vorlagen als Voreinstellung für Look-and-Feel zu behandeln und einen Chart von Hand neu aufzubauen, wenn eine Vorlage sich weigert, ihre Daten oder Markierungen mitzubringen." },
    { type: "heading", text: "Was eine Chart-Vorlage tatsächlich speichert" },
    { type: "paragraph", html: "Genau hier beginnt die meiste Verwirrung. Eine Vorlage in Tradovate speichert Indikatoreinstellungen und das Erscheinungsbild des Charts. Sie speichert nicht das DOM, das Fensterlayout oder Ihre Zeichnungen. Wenn Sie sie anwenden, laden Sie eine visuelle Voreinstellung auf den bereits geöffneten Chart – Sie stellen keinen Schnappschuss Ihrer Analyse wieder her." },
    { type: "paragraph", html: "Um eine zu speichern, öffnen Sie das Chart-eigene Menü (das kleine Menüsymbol in der oberen Ecke des Charts), gehen Sie zur Option Templates und wählen Sie Save Template. Geben Sie ihr einen eindeutigen Namen, damit Sie sie später wiederfinden." },
    { type: "paragraph", html: "Hier die Aufteilung, die Menschen häufig verwirrt, klar dargestellt:" },
    {
      type: "table",
      headers: ["Von einer Chart-Vorlage gespeichert", "NICHT von einer Vorlage gespeichert"],
      rows: [
        ["Indikatorauswahl und deren Parameter", "Trendlinien, Strahlen, horizontale Levels"],
        ["Chart-Stil (Kerzen, Balken, Farben)", "Zonen, Rechtecke, Boxen, Textnotizen"],
        ["Zeitrahmen und Chart-Erscheinungsbild-Einstellungen", "Fenster- und Multi-Chart-Layout"],
        ["Wiederverwendbarer &ldquo;Look&rdquo;, den Sie auf jeden Chart anwenden können", "Das DOM- / SuperDOM-Setup"],
        ["&mdash;", "Historische Kursdaten (werden nicht neu geladen)"],
      ],
    },
    { type: "paragraph", html: "Lesen Sie sich die rechte Spalte noch einmal durch. Jeder Punkt dort ist etwas, von dem Menschen <em>erwarten</em>, dass eine Vorlage es enthält, und nichts davon ist enthalten. Sobald Sie das verinnerlicht haben, hört das meiste seltsame Verhalten auf, ein Rätsel zu sein." },
    { type: "heading", text: "Warum der Chart ohne Daten lädt" },
    { type: "paragraph", html: "Das Anwenden einer Vorlage lädt keinen Kursverlauf nach. Sie tauscht lediglich die Einstellungen auf dem Chart aus, den Sie gerade betrachten. Wenn ein Chart also leer oder mit einem leeren Bereich öffnet, sehen Sie eigentlich ein Datenladeproblem, das über einer frisch angewendeten Vorlage liegt, zwei getrennte Dinge, die zufällig gemeinsam auftreten." },
    { type: "paragraph", html: "Ein paar Dinge beheben das schnell:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Scrollen Sie durch den Verlauf zurück.</strong> Wenn Sie den Chart nach links ziehen, zwingt das Tradovate dazu, ältere Kerzen anzufordern und die Lücke zu füllen.",
        "<strong class='text-white'>Laden Sie den Chart oder die App neu.</strong> Ein Neuladen zieht die Datenreihe oft sauber neu nach, wenn sie nur zur Hälfte geladen wurde.",
        "<strong class='text-white'>Erhöhen Sie Minimum Bars to Load.</strong> Wenn Charts routinemäßig mit zu wenig Verlauf öffnen, lädt eine Erhöhung dieses Werts mehr Daten vor, damit Indikatoren wie EMA und VWAP ab der ersten Kerze genug zum Berechnen haben.",
      ],
    },
    { type: "image", src: `${IMG}/chart-templates-no-data-lose-drawings-2.png`, alt: "Tradovate-Chart mit leerer Lücke, in der historische Kerzen nicht geladen wurden, mit hervorgehobenem Scroll-back-Bereich" },
    { type: "paragraph", html: "Es gibt noch eine weitere Eigenheit, die Sie kennen sollten. Eine gespeicherte Vorlage neigt dazu, sich nur in dem Chart-Fenster anzuzeigen, in dem sie erstellt wurde, Sie sehen zwar das Häkchen neben ihrem Namen, aber sie zeichnet sich nicht in einem anderen Fenster. Falls das passiert, wenden Sie die Vorlage innerhalb des Fensters an, in dem Sie sie tatsächlich haben möchten, oder bauen Sie sie dort einfach neu auf und speichern Sie erneut. Deshalb lautet der praktische Rat, Charts wo möglich manuell neu zu erstellen, anstatt zu erwarten, dass eine Vorlage sauber in jedes Fenster übergeht." },
    { type: "heading", text: "Warum Ihre Zeichnungen verschwinden" },
    { type: "paragraph", html: "Ihre Levels verstecken sich nicht in der Vorlage, sie waren nie darin. Zeichnungen sind an die Objektliste des Charts innerhalb eines Workspace gebunden. Wenn also eine Vorlage lädt und Ihre Linien weg sind, ist nichts kaputt; die Vorlage hat einfach keine Zeichnungen zu geben." },
    { type: "paragraph", html: "Bevor Sie annehmen, dass sie endgültig verloren sind, prüfen Sie zwei Dinge:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Die Objektliste / Augensymbole.</strong> Öffnen Sie die Objektliste des Charts (die Baumstruktur der Indikatoren und Zeichnungen) und stellen Sie sicher, dass das Sichtbarkeits-Auge neben jeder Zeichnung aktiviert ist. Es ist leicht, ein Level versehentlich auszublenden.",
        "<strong class='text-white'>Das Datum, an dem Sie sie gezeichnet haben.</strong> Eine Linie, die an einer bestimmten Kerze verankert ist, wird nur angezeigt, wenn diese Kerze auf dem Bildschirm sichtbar ist. Scrollen Sie zurück zu dem Tag, an dem Sie sie gezeichnet haben, dann sollte sie wieder erscheinen.",
      ],
    },
    { type: "image", src: `${IMG}/chart-templates-no-data-lose-drawings-3.png`, alt: "Tradovate-Chart-Objektlistenfeld mit Indikatoren und Zeichnungen sowie den Sichtbarkeits-Augensymbolen" },
    { type: "paragraph", html: "Es gibt außerdem eine bekannte, seit Langem bestehende Synchronisierungseigenheit, bei der Zeichnungen bei App-Neustarts, geräteübergreifend oder beim Wechsel zu einem niedrigeren Zeitrahmen verschwinden. Wenn Ihre Markierungen trotz Überprüfung der beiden obigen Punkte weiterhin verschwinden, ist das ein eigenständiges Problem, das es wert ist, gesondert untersucht zu werden, und wenn der Chart selbst zu wenig Verlauf lädt, ist das ebenfalls ein separates Datenladeproblem, das es zu verfolgen lohnt." },
    { type: "heading", text: "Die zuverlässige Lösung: Workspace speichern, bei Bedarf neu aufbauen" },
    { type: "paragraph", html: "Vorlagen sind ein nettes Extra für Indikator-Voreinstellungen. Das, was Ihre Arbeit tatsächlich bewahrt, ist ein Workspace. Ein Workspace erfasst Ihr Fensterlayout, die Charts, die Indikatoren <em>und</em> die Zeichnungen darauf, also genau das, was eine Vorlage fallen lässt." },
    {
      type: "steps",
      items: [
        { title: "Bringen Sie den Chart genau in die gewünschte Form", html: "Zeitrahmen eingestellt, Indikatoren hinzugefügt, Levels und Trendlinien gezeichnet." },
        { title: "Speichern Sie den Workspace", html: "Öffnen Sie über das Tradovate-Logo-Menü Workspaces und speichern Sie den aktuellen Workspace. Geben Sie ihm einen Namen, den Sie wiedererkennen, zum Beispiel &ldquo;ES intraday.&rdquo;" },
        { title: "Speichern Sie optional auch eine Chart-Vorlage", html: "Über das Chart-Menü, damit Sie später den gleichen <em>Look</em> auf einen komplett neuen Chart übertragen können, ohne Indikatoren neu zu zeichnen." },
        { title: "Bauen Sie neu auf, wenn eine Vorlage nicht mitspielt", html: "Wenn eine Vorlage ihre Daten oder Markierungen nicht in ein Fenster bringt, kämpfen Sie nicht länger dagegen an, erstellen Sie das Setup in diesem Fenster neu und speichern Sie den Workspace erneut. Das ist schneller, als eine Funktion zu debuggen, die das gar nicht leisten soll." },
      ],
    },
    { type: "image", src: `${IMG}/chart-templates-no-data-lose-drawings-4.png`, alt: "Erweitertes Tradovate-Logo-Menü mit der Option Workspaces sowie den Aktionen Save und Load" },
    { type: "heading", text: "Kurzübersicht: Symptom, Ursache, Lösung" },
    {
      type: "table",
      headers: ["Was Sie sehen", "Warum es passiert", "Was zu tun ist"],
      rows: [
        ["Vorlage lädt, Chart ist leer / hat Lücken", "Vorlagen laden keinen Kursverlauf", "Zurückscrollen, neu laden oder Minimum Bars to Load erhöhen"],
        ["Vorlage lädt, Zeichnungen sind weg", "Zeichnungen werden nicht in Vorlagen gespeichert", "Workspace speichern; Augensymbole in der Objektliste prüfen"],
        ["Vorlage mit Häkchen, wird aber nicht angewendet", "Vorlage bleibt tendenziell an ihrem Ursprungsfenster hängen", "Innerhalb des Zielfensters anwenden oder dort neu aufbauen"],
        ["Linien auf ES fehlen auf MES", "Zeichnungen wechseln nicht zwischen Symbolen", "Pro Kontrakt neu zeichnen oder beide in einem Workspace zusammenfassen"],
        ["Markierungen verschwinden nach Neustart", "Bekannter Zeichnungs-Synchronisierungsfehler", "Zum Datum der Zeichnung scrollen; dem Support melden"],
      ],
    },
    { type: "heading", text: "Verlieren Sie Ihr Setup nicht noch einmal" },
    { type: "paragraph", html: "Ein paar Gewohnheiten verhindern, dass Sie das mitten in der Sitzung erwischt:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Speichern Sie am Ende jeder Sitzung einen Workspace</strong>, nicht nur, wenn Sie daran denken. Das ist Ihr eigentliches Backup.",
        "<strong class='text-white'>Behalten Sie eine saubere Vorlage ohne Zeichnungen</strong> für einen schnellen Reset, wenn ein Chart überladen wirkt.",
        "<strong class='text-white'>Benennen Sie Vorlagen und Workspaces eindeutig</strong>, nach Instrument und Stil, damit Sie später nicht raten müssen.",
        "<strong class='text-white'>Erwarten Sie nicht, dass Vorlagen symbolübergreifend funktionieren.</strong> ES und MES sind, was Ihre Zeichnungen betrifft, unterschiedliche Instrumente.",
      ],
    },
    { type: "heading", text: "Wann es sich um erwartetes Verhalten handelt und wann um einen echten Fehler" },
    { type: "paragraph", html: "Zwei dieser Punkte sind einfach die Funktionsweise der Plattform, und kein noch so häufiges Klicken wird sie ändern: eine Vorlage, die keine Zeichnungen mitträgt, und eine Vorlage, die keine Daten neu lädt. Speichern Sie einen Workspace und machen Sie weiter." },
    { type: "paragraph", html: "Meldenswert sind Zeichnungen, die nach einem Neustart verschwinden, obwohl sie in einem Workspace gespeichert wurden, sowie eine Vorlage, die sich hartnäckig weigert, auf irgendein Fenster angewendet zu werden. Wenden Sie sich über den plattforminternen Chat oder per E-Mail an Tradovate, damit es protokolliert wird. Wenn Sie ein Prop-Firm- oder Evaluation-Konto haben und das Problem eigentlich fehlende Marktdaten statt Vorlagen betrifft, wird Ihr Datenzugang von der Firma freigeschaltet, kontaktieren Sie diese, da Tradovate keine Daten auf einem Konto reparieren kann, das nicht ihm gehört." },
  ], es: [
    { type: "paragraph", html: "Guardó una plantilla de gráfico, la volvió a abrir más tarde y el gráfico apareció mal. Quizás faltan velas, quizás el espacio está simplemente vacío, o quizás ocurrió la peor versión y cada línea de tendencia y nivel que dibujó durante la sesión ha desaparecido. Es frustrante, porque en futuros sus niveles <em>son</em> el plan." },
    { type: "paragraph", html: "Aquí está la respuesta breve antes de entrar en detalle: una plantilla de gráfico de Tradovate nunca fue diseñada para llevar sus dibujos ni para forzar la carga de datos históricos. Almacena su configuración de indicadores y el aspecto del gráfico, marco temporal, estilo, colores, parámetros de indicadores, y eso es prácticamente todo. Sus líneas de tendencia, zonas y niveles horizontales pertenecen al <strong class='text-white'>workspace</strong>, no a la plantilla. Así que la medida fiable es guardar un workspace completo para todo lo que quiera conservar, tratar las plantillas como un preset de aspecto visual y recrear un gráfico a mano cuando una plantilla se niegue a traer sus datos o marcas." },
    { type: "heading", text: "Qué guarda realmente una plantilla de gráfico" },
    { type: "paragraph", html: "Aquí es donde empieza la mayor parte de la confusión. Una plantilla en Tradovate guarda la configuración de indicadores y el aspecto del gráfico. No guarda el DOM, el diseño de la ventana ni sus dibujos. Al aplicarla, está cargando un preset visual sobre el gráfico que ya tiene abierto, no está restaurando una instantánea de su análisis." },
    { type: "paragraph", html: "Para guardar una, abra el propio menú del gráfico (el pequeño icono de menú en la esquina superior del gráfico), vaya a la opción Templates y elija Save Template. Dele un nombre claro para poder encontrarla de nuevo." },
    { type: "paragraph", html: "Aquí está la división que suele confundir a la gente, expuesta con claridad:" },
    {
      type: "table",
      headers: ["Guardado por una plantilla de gráfico", "NO guardado por una plantilla"],
      rows: [
        ["Selección de indicadores y sus parámetros", "Líneas de tendencia, rayos, niveles horizontales"],
        ["Estilo del gráfico (velas, barras, colores)", "Zonas, rectángulos, cuadros, notas de texto"],
        ["Marco temporal y configuración de apariencia del gráfico", "Diseño de ventana y multi-gráfico"],
        ["&ldquo;Aspecto&rdquo; reutilizable que puede aplicar a cualquier gráfico", "La configuración del DOM / SuperDOM"],
        ["&mdash;", "Datos históricos de precios (no se vuelven a cargar)"],
      ],
    },
    { type: "paragraph", html: "Lea de nuevo esa columna de la derecha. Cada elemento ahí es algo que la gente <em>espera</em> que una plantilla contenga, y nada de eso está incluido. Una vez que interioriza esto, la mayor parte del comportamiento extraño deja de ser un misterio." },
    { type: "heading", text: "Por qué el gráfico se carga sin datos" },
    { type: "paragraph", html: "Aplicar una plantilla no trae el historial de precios. Simplemente intercambia la configuración del gráfico que está viendo. Así que, si un gráfico se abre en blanco o con un tramo de espacio vacío, en realidad está ante un problema de carga de datos que coincide con una plantilla recién aplicada, dos cosas separadas que resultan aparecer juntas." },
    { type: "paragraph", html: "Un par de cosas solucionan esto rápidamente:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Desplácese hacia atrás en el historial.</strong> Arrastrar el gráfico hacia la izquierda obliga a Tradovate a solicitar velas más antiguas y llenar el hueco.",
        "<strong class='text-white'>Recargue el gráfico o la aplicación.</strong> Una actualización a menudo vuelve a traer la serie de forma limpia cuando se cargó solo a la mitad.",
        "<strong class='text-white'>Aumente Minimum Bars to Load.</strong> Si los gráficos suelen abrirse con poco historial, aumentar este valor precarga más datos para que indicadores como EMA y VWAP tengan suficiente para calcular desde la primera vela.",
      ],
    },
    { type: "image", src: `${IMG}/chart-templates-no-data-lose-drawings-2.png`, alt: "Gráfico de Tradovate que muestra un hueco vacío donde no se han cargado velas históricas, con el área de desplazamiento hacia atrás resaltada" },
    { type: "paragraph", html: "Hay otra particularidad que vale la pena conocer. Una plantilla guardada ha mostrado la tendencia de mostrarse solo en la ventana del gráfico en la que se creó, verá la marca de verificación junto a su nombre, pero no se aplicará en una ventana diferente. Si eso ocurre, aplique la plantilla desde dentro de la ventana en la que realmente la quiere, o simplemente reconstrúyala ahí y guárdela de nuevo. Por eso el consejo práctico es recrear los gráficos manualmente donde pueda, en lugar de esperar que una plantilla se traslade limpiamente a través de todas las ventanas." },
    { type: "heading", text: "Por qué desaparecen sus dibujos" },
    { type: "paragraph", html: "Sus niveles no están escondidos en la plantilla, nunca estuvieron ahí. Los dibujos se vinculan a la lista de objetos del gráfico dentro de un workspace. Así que cuando una plantilla se carga y sus líneas han desaparecido, nada se ha roto; la plantilla simplemente no tiene dibujos que ofrecer." },
    { type: "paragraph", html: "Antes de asumir que están perdidos para siempre, compruebe dos cosas:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>La lista de objetos / iconos de ojo.</strong> Abra la lista de objetos del gráfico (el árbol de indicadores y dibujos) y asegúrese de que el ojo de visibilidad junto a cada dibujo esté activado. Es fácil ocultar un nivel por accidente.",
        "<strong class='text-white'>La fecha en la que la dibujó.</strong> Una línea anclada a una vela específica solo se muestra cuando esa vela está en pantalla. Desplácese hasta el día en que la dibujó y debería reaparecer.",
      ],
    },
    { type: "image", src: `${IMG}/chart-templates-no-data-lose-drawings-3.png`, alt: "Panel de lista de objetos del gráfico de Tradovate que muestra indicadores y dibujos con los iconos de ojo de visibilidad" },
    { type: "paragraph", html: "También existe una particularidad de sincronización conocida y de larga data por la que los dibujos desaparecen al reiniciar la app, entre dispositivos o al bajar a un marco temporal inferior. Si sus marcas siguen evaporándose incluso después de comprobar los dos puntos anteriores, se trata de un problema aparte que merece investigarse por sí solo, y si el propio gráfico se está cargando con poco historial, eso también es un problema de carga de datos que vale la pena rastrear por separado." },
    { type: "heading", text: "La solución fiable: guardar un workspace y reconstruir donde sea necesario" },
    { type: "paragraph", html: "Las plantillas son algo agradable de tener para los presets de indicadores. Lo que realmente conserva su trabajo es un workspace. Un workspace captura el diseño de sus ventanas, los gráficos, los indicadores <em>y</em> los dibujos sobre ellos, que es exactamente lo que una plantilla deja fuera." },
    {
      type: "steps",
      items: [
        { title: "Configure el gráfico exactamente como lo quiere", html: "Marco temporal definido, indicadores añadidos, niveles y líneas de tendencia dibujados." },
        { title: "Guarde el workspace", html: "Desde el menú del logo de Tradovate, abra Workspaces y guarde el workspace actual. Dele un nombre que reconozca, como &ldquo;ES intraday.&rdquo;" },
        { title: "Opcionalmente, guarde también una plantilla de gráfico", html: "Desde el menú del gráfico, para poder aplicar más adelante el mismo <em>aspecto</em> a un gráfico completamente nuevo sin volver a añadir indicadores." },
        { title: "Reconstruya cuando una plantilla no coopere", html: "Cuando una plantilla no lleve sus datos o marcas a una ventana, deje de luchar contra ella, recree la configuración en esa ventana y vuelva a guardar el workspace. Es más rápido que intentar solucionar una función que no está pensada para hacer esto." },
      ],
    },
    { type: "image", src: `${IMG}/chart-templates-no-data-lose-drawings-4.png`, alt: "Menú del logo de Tradovate desplegado que muestra la opción Workspaces con las acciones Save y Load" },
    { type: "heading", text: "Referencia rápida: síntoma, causa, solución" },
    {
      type: "table",
      headers: ["Lo que ve", "Por qué ocurre", "Qué hacer"],
      rows: [
        ["La plantilla carga, el gráfico está en blanco / con huecos", "Las plantillas no traen historial de precios", "Desplácese hacia atrás, recargue o aumente Minimum Bars to Load"],
        ["La plantilla carga, los dibujos han desaparecido", "Los dibujos no se almacenan en las plantillas", "Guarde un workspace; compruebe los iconos de ojo en la lista de objetos"],
        ["La plantilla tiene la marca de verificación pero no se aplica", "La plantilla tiende a quedarse en su ventana de origen", "Aplíquela dentro de la ventana de destino o reconstrúyala ahí"],
        ["Las líneas en ES faltan en MES", "Los dibujos no se trasladan entre símbolos", "Vuelva a dibujar por contrato o mantenga ambos en un solo workspace"],
        ["Las marcas desaparecen tras reiniciar", "Defecto conocido de sincronización de dibujos", "Desplácese hasta la fecha del dibujo; informe al soporte"],
      ],
    },
    { type: "heading", text: "Deje de perder su configuración una y otra vez" },
    { type: "paragraph", html: "Algunos hábitos evitan que esto le afecte a mitad de sesión:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Guarde un workspace al final de cada sesión</strong>, no solo cuando se acuerde. Esa es su verdadera copia de seguridad.",
        "<strong class='text-white'>Mantenga una plantilla limpia y sin dibujos</strong> para un reinicio rápido cuando un gráfico se sature.",
        "<strong class='text-white'>Nombre las plantillas y workspaces con claridad</strong>, por instrumento y estilo, para no tener que adivinar más tarde.",
        "<strong class='text-white'>No espere que las plantillas funcionen entre símbolos.</strong> ES y MES son instrumentos diferentes en lo que respecta a sus dibujos.",
      ],
    },
    { type: "heading", text: "Cuándo es comportamiento esperado y cuándo es un error real" },
    { type: "paragraph", html: "Dos de estos son simplemente el funcionamiento de la plataforma, y no importa cuánto haga clic, no van a cambiar: una plantilla que no lleva dibujos y una plantilla que no vuelve a cargar datos. Guarde un workspace y siga adelante." },
    { type: "paragraph", html: "Vale la pena informar de los dibujos que desaparecen tras un reinicio a pesar de estar guardados en un workspace, y de una plantilla que se niega tercamente a aplicarse a cualquier ventana. Contacte con Tradovate a través del chat de la plataforma o por correo electrónico para que quede registrado. Si tiene una cuenta de prop firm o de evaluación y el problema es en realidad falta de datos de mercado y no de plantillas, su acceso a los datos lo habilita la firma, contáctela a ella, ya que Tradovate no puede solucionar datos en una cuenta que no le pertenece." },
  ], fr: [
    { type: "paragraph", html: "Vous avez enregistré un modèle de graphique, vous l'avez rouvert plus tard, et le graphique s'est affiché incorrectement. Peut-être que des bougies manquent, peut-être que l'espace est simplement vide, ou peut-être que le pire est arrivé et que chaque ligne de tendance et chaque niveau que vous avez tracés pendant la session ont disparu. C'est frustrant, car en trading de futures, vos niveaux <em>sont</em> le plan." },
    { type: "paragraph", html: "Voici la réponse courte avant d'entrer dans les détails : un modèle de graphique Tradovate n'a jamais été conçu pour transporter vos tracés ou forcer le chargement des données historiques. Il enregistre votre configuration d'indicateurs ainsi que l'apparence du graphique, l'échelle de temps, le style, les couleurs, les paramètres d'indicateurs, et c'est à peu près tout. Vos lignes de tendance, zones et niveaux horizontaux appartiennent à l'<strong class='text-white'>espace de travail</strong>, pas au modèle. La solution fiable consiste donc à enregistrer un espace de travail complet pour tout ce que vous voulez conserver, à considérer les modèles comme un préréglage d'apparence, et à recréer un graphique manuellement lorsqu'un modèle refuse d'apporter ses données ou ses annotations." },
    { type: "heading", text: "Ce qu'un modèle de graphique enregistre réellement" },
    { type: "paragraph", html: "C'est là que commence la majeure partie de la confusion. Un modèle dans Tradovate enregistre les réglages des indicateurs et l'apparence du graphique. Il n'enregistre pas le DOM, la disposition des fenêtres ni vos tracés. Lorsque vous l'appliquez, vous chargez un préréglage visuel sur le graphique déjà ouvert, vous ne restaurez pas un instantané de votre analyse." },
    { type: "paragraph", html: "Pour en enregistrer un, ouvrez le menu propre au graphique (la petite icône de menu dans le coin supérieur du graphique), accédez à l'option Templates et choisissez Save Template. Donnez-lui un nom clair afin de pouvoir le retrouver facilement." },
    { type: "paragraph", html: "Voici la répartition qui déroute souvent les utilisateurs, présentée clairement :" },
    {
      type: "table",
      headers: ["Enregistré par un modèle de graphique", "NON enregistré par un modèle"],
      rows: [
        ["Sélection des indicateurs et leurs paramètres", "Lignes de tendance, rayons, niveaux horizontaux"],
        ["Style du graphique (bougies, barres, couleurs)", "Zones, rectangles, boîtes, notes de texte"],
        ["Échelle de temps et réglages d'apparence du graphique", "Disposition des fenêtres et multi-graphiques"],
        ["&ldquo;Apparence&rdquo; réutilisable que vous pouvez appliquer à n'importe quel graphique", "La configuration du DOM / SuperDOM"],
        ["&mdash;", "Données de prix historiques (elles ne sont pas rechargées)"],
      ],
    },
    { type: "paragraph", html: "Relisez cette colonne de droite. Chaque élément qui s'y trouve est quelque chose que les utilisateurs <em>s'attendent</em> à voir dans un modèle, et rien de tout cela n'y est inclus. Une fois que vous avez intégré cela, la plupart des comportements étranges cessent d'être un mystère." },
    { type: "heading", text: "Pourquoi le graphique se charge sans données" },
    { type: "paragraph", html: "Appliquer un modèle ne récupère pas l'historique des prix. Cela remplace simplement les réglages sur le graphique que vous consultez. Donc, si un graphique s'ouvre vide ou avec une portion d'espace vide, vous êtes en réalité face à un problème de chargement des données qui se superpose à un modèle fraîchement appliqué, deux choses distinctes qui se manifestent en même temps." },
    { type: "paragraph", html: "Quelques actions résolvent rapidement ce problème :" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Faites défiler l'historique vers l'arrière.</strong> Faire glisser le graphique vers la gauche force Tradovate à demander des bougies plus anciennes et à combler l'écart.",
        "<strong class='text-white'>Rechargez le graphique ou l'application.</strong> Une actualisation récupère souvent la série proprement lorsqu'elle s'est chargée à moitié vide.",
        "<strong class='text-white'>Augmentez Minimum Bars to Load.</strong> Si les graphiques s'ouvrent régulièrement avec peu d'historique, augmenter ce paramètre précharge davantage de données afin que des indicateurs comme l'EMA et le VWAP disposent de suffisamment de données dès la première bougie.",
      ],
    },
    { type: "image", src: `${IMG}/chart-templates-no-data-lose-drawings-2.png`, alt: "Graphique Tradovate montrant un espace vide où les bougies historiques ne se sont pas chargées, avec la zone de défilement arrière mise en évidence" },
    { type: "paragraph", html: "Il existe une autre particularité à connaître. Un modèle enregistré a tendance à ne s'afficher que dans la fenêtre de graphique où il a été créé, vous verrez la coche à côté de son nom, mais il ne s'appliquera pas à une autre fenêtre. Si cela se produit, appliquez le modèle depuis la fenêtre où vous le voulez réellement, ou reconstruisez-le simplement là et enregistrez-le à nouveau. C'est pourquoi le conseil pratique est de recréer les graphiques manuellement lorsque c'est possible, plutôt que de s'attendre à ce qu'un modèle se transfère proprement d'une fenêtre à l'autre." },
    { type: "heading", text: "Pourquoi vos tracés disparaissent" },
    { type: "paragraph", html: "Vos niveaux ne se cachent pas dans le modèle, ils n'y ont jamais été. Les tracés sont rattachés à la liste d'objets du graphique à l'intérieur d'un espace de travail. Donc, lorsqu'un modèle se charge et que vos lignes ont disparu, rien n'est cassé ; le modèle n'a tout simplement aucun tracé à fournir." },
    { type: "paragraph", html: "Avant de supposer qu'ils sont définitivement perdus, vérifiez deux choses :" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>La liste d'objets / les icônes en forme d'œil.</strong> Ouvrez la liste d'objets du graphique (l'arborescence des indicateurs et des tracés) et assurez-vous que l'œil de visibilité à côté de chaque tracé est activé. Il est facile de masquer un niveau par accident.",
        "<strong class='text-white'>La date à laquelle vous l'avez tracée.</strong> Une ligne ancrée à une bougie spécifique ne s'affiche que lorsque cette bougie est à l'écran. Faites défiler jusqu'au jour où vous l'avez tracée et elle devrait réapparaître.",
      ],
    },
    { type: "image", src: `${IMG}/chart-templates-no-data-lose-drawings-3.png`, alt: "Panneau de la liste d'objets du graphique Tradovate montrant les indicateurs et les tracés avec les icônes en forme d'œil de visibilité" },
    { type: "paragraph", html: "Il existe également une anomalie de synchronisation connue et persistante où les tracés disparaissent lors des redémarrages de l'application, entre appareils, ou lorsque vous passez à une échelle de temps inférieure. Si vos annotations continuent de s'évaporer même après avoir vérifié les deux points ci-dessus, il s'agit d'un problème distinct qui mérite d'être examiné à part, et si le graphique lui-même se charge avec peu d'historique, c'est également un problème de chargement des données qu'il vaut la peine de traiter séparément." },
    { type: "heading", text: "La solution fiable : enregistrer un espace de travail, reconstruire si nécessaire" },
    { type: "paragraph", html: "Les modèles sont un atout appréciable pour les préréglages d'indicateurs. Ce qui préserve réellement votre travail, c'est un espace de travail. Un espace de travail capture la disposition de vos fenêtres, les graphiques, les indicateurs <em>et</em> les tracés qui s'y trouvent, soit exactement ce qu'un modèle laisse de côté." },
    {
      type: "steps",
      items: [
        { title: "Configurez le graphique exactement comme vous le souhaitez", html: "Échelle de temps réglée, indicateurs ajoutés, niveaux et lignes de tendance tracés." },
        { title: "Enregistrez l'espace de travail", html: "Depuis le menu du logo Tradovate, ouvrez Workspaces et enregistrez l'espace de travail actuel. Donnez-lui un nom que vous reconnaîtrez, comme &ldquo;ES intraday.&rdquo;" },
        { title: "Facultativement, enregistrez aussi un modèle de graphique", html: "Depuis le menu du graphique, afin de pouvoir appliquer plus tard la même <em>apparence</em> à un tout nouveau graphique sans redessiner les indicateurs." },
        { title: "Reconstruisez lorsqu'un modèle ne coopère pas", html: "Lorsqu'un modèle n'apporte pas ses données ou ses annotations dans une fenêtre, cessez de lutter contre lui, recréez la configuration dans cette fenêtre et réenregistrez l'espace de travail. C'est plus rapide que de dépanner une fonctionnalité qui n'est pas censée faire cela." },
      ],
    },
    { type: "image", src: `${IMG}/chart-templates-no-data-lose-drawings-4.png`, alt: "Menu du logo Tradovate développé montrant l'option Workspaces avec les actions Save et Load" },
    { type: "heading", text: "Référence rapide : symptôme, cause, solution" },
    {
      type: "table",
      headers: ["Ce que vous voyez", "Pourquoi cela se produit", "Que faire"],
      rows: [
        ["Le modèle se charge, le graphique est vide / présente des écarts", "Les modèles ne récupèrent pas l'historique des prix", "Faites défiler vers l'arrière, rechargez, ou augmentez Minimum Bars to Load"],
        ["Le modèle se charge, les tracés ont disparu", "Les tracés ne sont pas stockés dans les modèles", "Enregistrez un espace de travail ; vérifiez les icônes en forme d'œil de la liste d'objets"],
        ["Le modèle est coché mais ne s'applique pas", "Le modèle a tendance à rester attaché à sa fenêtre d'origine", "Appliquez-le dans la fenêtre cible ou reconstruisez-le là"],
        ["Les lignes sur ES manquent sur MES", "Les tracés ne se transfèrent pas entre symboles", "Retracez par contrat ou conservez les deux dans un même espace de travail"],
        ["Les annotations disparaissent après un redémarrage", "Défaut connu de synchronisation des tracés", "Faites défiler jusqu'à la date du tracé ; signalez-le au support"],
      ],
    },
    { type: "heading", text: "Ne perdez plus votre configuration" },
    { type: "paragraph", html: "Quelques habitudes vous évitent d'être pris au dépourvu en pleine session :" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Enregistrez un espace de travail à la fin de chaque session</strong>, pas seulement quand vous y pensez. C'est votre véritable sauvegarde.",
        "<strong class='text-white'>Conservez un modèle propre, sans tracés</strong>, pour une réinitialisation rapide lorsqu'un graphique devient encombré.",
        "<strong class='text-white'>Nommez clairement les modèles et espaces de travail</strong>, par instrument et par style, pour ne pas avoir à deviner plus tard.",
        "<strong class='text-white'>Ne comptez pas sur les modèles pour fonctionner d'un symbole à l'autre.</strong> ES et MES sont des instruments différents en ce qui concerne vos tracés.",
      ],
    },
    { type: "heading", text: "Quand il s'agit d'un comportement attendu et quand il s'agit d'un véritable bug" },
    { type: "paragraph", html: "Deux de ces éléments relèvent simplement du fonctionnement de la plateforme, et aucun clic n'y changera rien : un modèle qui ne transporte pas les tracés, et un modèle qui ne recharge pas les données. Enregistrez un espace de travail et passez à autre chose." },
    { type: "paragraph", html: "Ce qui mérite d'être signalé, ce sont les tracés qui disparaissent après un redémarrage bien qu'enregistrés dans un espace de travail, ainsi qu'un modèle qui refuse obstinément de s'appliquer à n'importe quelle fenêtre. Contactez Tradovate via le chat intégré à la plateforme ou par e-mail afin que ce soit consigné. Si vous disposez d'un compte prop firm ou d'évaluation et que le problème concerne en réalité des données de marché manquantes plutôt que les modèles, votre accès aux données est activé par la firme, contactez-la, car Tradovate ne peut pas résoudre un problème de données sur un compte qui ne lui appartient pas." },
  ], it: [
    { type: "paragraph", html: "Ha salvato un modello di grafico, lo ha riaperto più tardi e il grafico è apparso in modo errato. Forse mancano delle candele, forse lo spazio è semplicemente vuoto, oppure è successa la versione peggiore e ogni trendline e livello disegnati durante la sessione sono spariti. È frustrante, perché nei futures i suoi livelli <em>sono</em> il piano." },
    { type: "paragraph", html: "Ecco la risposta breve prima di entrare nei dettagli: un modello di grafico Tradovate non è mai stato pensato per trasportare i suoi disegni o forzare il caricamento dei dati storici. Memorizza la configurazione degli indicatori e l'aspetto del grafico, timeframe, stile, colori, parametri degli indicatori, e questo è praticamente tutto. Le sue trendline, zone e livelli orizzontali appartengono al <strong class='text-white'>workspace</strong>, non al modello. Quindi la mossa affidabile è salvare un workspace completo per tutto ciò che vuole conservare, trattare i modelli come un preset di aspetto grafico e ricreare un grafico manualmente quando un modello si rifiuta di portare con sé i dati o le annotazioni." },
    { type: "heading", text: "Cosa salva realmente un modello di grafico" },
    { type: "paragraph", html: "È qui che nasce gran parte della confusione. Un modello in Tradovate salva le impostazioni degli indicatori e l'aspetto del grafico. Non salva il DOM, il layout delle finestre o i suoi disegni. Quando lo applica, sta caricando un preset visivo sul grafico già aperto, non sta ripristinando uno snapshot della sua analisi." },
    { type: "paragraph", html: "Per salvarne uno, apra il menu del grafico stesso (la piccola icona del menu nell'angolo superiore del grafico), vada all'opzione Templates e scelga Save Template. Gli assegni un nome chiaro in modo da poterlo ritrovare facilmente." },
    { type: "paragraph", html: "Ecco la suddivisione che spesso confonde le persone, spiegata chiaramente:" },
    {
      type: "table",
      headers: ["Salvato da un modello di grafico", "NON salvato da un modello"],
      rows: [
        ["Selezione degli indicatori e i loro parametri", "Trendline, raggi, livelli orizzontali"],
        ["Stile del grafico (candele, barre, colori)", "Zone, rettangoli, riquadri, note di testo"],
        ["Timeframe e impostazioni di aspetto del grafico", "Layout delle finestre e multi-grafico"],
        ["&ldquo;Aspetto&rdquo; riutilizzabile che può applicare a qualsiasi grafico", "La configurazione del DOM / SuperDOM"],
        ["&mdash;", "Dati storici dei prezzi (non vengono ricaricati)"],
      ],
    },
    { type: "paragraph", html: "Rilegga quella colonna di destra. Ogni elemento presente è qualcosa che le persone <em>si aspettano</em> che un modello contenga, e nulla di tutto ciò è incluso. Una volta interiorizzato questo, la maggior parte dei comportamenti strani smette di essere un mistero." },
    { type: "heading", text: "Perché il grafico si carica senza dati" },
    { type: "paragraph", html: "Applicare un modello non recupera lo storico dei prezzi. Si limita a sostituire le impostazioni sul grafico che sta guardando. Quindi, se un grafico si apre vuoto o con un tratto di spazio vuoto, in realtà sta osservando un problema di caricamento dati che si sovrappone a un modello appena applicato, due cose separate che capitano di presentarsi insieme." },
    { type: "paragraph", html: "Un paio di cose risolvono rapidamente il problema:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Scorra all'indietro nella cronologia.</strong> Trascinare il grafico verso sinistra costringe Tradovate a richiedere candele più vecchie e a colmare il vuoto.",
        "<strong class='text-white'>Ricarichi il grafico o l'app.</strong> Un aggiornamento spesso recupera correttamente la serie quando si è caricata solo a metà.",
        "<strong class='text-white'>Aumenti Minimum Bars to Load.</strong> Se i grafici si aprono regolarmente con poco storico, aumentare questo valore precarica più dati in modo che indicatori come EMA e VWAP abbiano abbastanza dati per calcolare fin dalla prima candela.",
      ],
    },
    { type: "image", src: `${IMG}/chart-templates-no-data-lose-drawings-2.png`, alt: "Grafico Tradovate che mostra un vuoto in cui le candele storiche non sono state caricate, con l'area di scorrimento all'indietro evidenziata" },
    { type: "paragraph", html: "C'è un'altra particolarità che vale la pena conoscere. Un modello salvato ha mostrato la tendenza a comparire solo nella finestra del grafico in cui è stato creato, vedrà il segno di spunta accanto al suo nome, ma non si applicherà a una finestra diversa. Se succede, applichi il modello dall'interno della finestra in cui lo desidera davvero, oppure lo ricostruisca lì e lo salvi di nuovo. Per questo il consiglio pratico è ricreare i grafici manualmente dove possibile, invece di aspettarsi che un modello si trasferisca in modo pulito tra tutte le finestre." },
    { type: "heading", text: "Perché i suoi disegni scompaiono" },
    { type: "paragraph", html: "I suoi livelli non si nascondono nel modello, non ci sono mai stati. I disegni sono legati all'elenco oggetti del grafico all'interno di un workspace. Quindi, quando un modello si carica e le sue linee sono sparite, non si è rotto nulla; il modello semplicemente non ha disegni da offrire." },
    { type: "paragraph", html: "Prima di dare per scontato che siano persi per sempre, controlli due cose:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>L'elenco oggetti / le icone a forma di occhio.</strong> Apra l'elenco oggetti del grafico (l'albero di indicatori e disegni) e verifichi che l'occhio di visibilità accanto a ciascun disegno sia attivo. È facile nascondere un livello per errore.",
        "<strong class='text-white'>La data in cui lo ha disegnato.</strong> Una linea ancorata a una candela specifica appare solo quando quella candela è visibile a schermo. Torni indietro fino al giorno in cui lo ha disegnato e dovrebbe riapparire.",
      ],
    },
    { type: "image", src: `${IMG}/chart-templates-no-data-lose-drawings-3.png`, alt: "Pannello dell'elenco oggetti del grafico Tradovate che mostra indicatori e disegni con le icone a forma di occhio di visibilità" },
    { type: "paragraph", html: "Esiste inoltre una nota anomalia di sincronizzazione, presente da tempo, per cui i disegni scompaiono dopo il riavvio dell'app, tra dispositivi diversi o quando si passa a un timeframe inferiore. Se le sue annotazioni continuano a svanire anche dopo aver controllato i due punti precedenti, si tratta di un problema a sé stante che vale la pena approfondire separatamente, e se il grafico stesso si carica con poco storico, anche questo è un problema di caricamento dati da indagare a parte." },
    { type: "heading", text: "La soluzione affidabile: salvare un workspace, ricostruire dove necessario" },
    { type: "paragraph", html: "I modelli sono un extra gradito per i preset degli indicatori. Ciò che conserva davvero il suo lavoro è un workspace. Un workspace cattura il layout delle finestre, i grafici, gli indicatori <em>e</em> i disegni presenti su di essi, ovvero esattamente ciò che un modello lascia indietro." },
    {
      type: "steps",
      items: [
        { title: "Configuri il grafico esattamente come lo desidera", html: "Timeframe impostato, indicatori aggiunti, livelli e trendline disegnati." },
        { title: "Salvi il workspace", html: "Dal menu del logo Tradovate, apra Workspaces e salvi il workspace corrente. Gli assegni un nome che riconoscerà facilmente, come &ldquo;ES intraday.&rdquo;" },
        { title: "Facoltativamente, salvi anche un modello di grafico", html: "Dal menu del grafico, in modo da poter applicare in seguito lo stesso <em>aspetto</em> a un grafico completamente nuovo senza ridisegnare gli indicatori." },
        { title: "Ricostruisca quando un modello non collabora", html: "Quando un modello non porta i suoi dati o le sue annotazioni in una finestra, smetta di lottare contro di esso, ricrei la configurazione in quella finestra e salvi di nuovo il workspace. È più veloce che risolvere i problemi di una funzione che non è pensata per fare questo." },
      ],
    },
    { type: "image", src: `${IMG}/chart-templates-no-data-lose-drawings-4.png`, alt: "Menu del logo Tradovate espanso che mostra l'opzione Workspaces con le azioni Save e Load" },
    { type: "heading", text: "Riferimento rapido: sintomo, causa, soluzione" },
    {
      type: "table",
      headers: ["Cosa vede", "Perché accade", "Cosa fare"],
      rows: [
        ["Il modello si carica, il grafico è vuoto / presenta vuoti", "I modelli non recuperano lo storico dei prezzi", "Scorra all'indietro, ricarichi, oppure aumenti Minimum Bars to Load"],
        ["Il modello si carica, i disegni sono spariti", "I disegni non vengono memorizzati nei modelli", "Salvi un workspace; controlli le icone a forma di occhio nell'elenco oggetti"],
        ["Il modello ha il segno di spunta ma non si applica", "Il modello tende a restare legato alla finestra di origine", "Lo applichi all'interno della finestra di destinazione o lo ricostruisca lì"],
        ["Le linee su ES mancano su MES", "I disegni non passano da un simbolo all'altro", "Ridisegni per ciascun contratto oppure tenga entrambi in un unico workspace"],
        ["Le annotazioni scompaiono dopo il riavvio", "Difetto noto di sincronizzazione dei disegni", "Scorra fino alla data del disegno; lo segnali al supporto"],
      ],
    },
    { type: "heading", text: "Smetta di perdere di nuovo la sua configurazione" },
    { type: "paragraph", html: "Alcune abitudini evitano che questo la colga di sorpresa a metà sessione:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Salvi un workspace alla fine di ogni sessione</strong>, non solo quando se ne ricorda. Quello è il suo vero backup.",
        "<strong class='text-white'>Tenga un modello pulito, senza disegni</strong> per un reset rapido quando un grafico diventa disordinato.",
        "<strong class='text-white'>Assegni nomi chiari a modelli e workspace</strong>, per strumento e stile, così non dovrà indovinare in seguito.",
        "<strong class='text-white'>Non si aspetti che i modelli funzionino tra simboli diversi.</strong> ES e MES sono strumenti diversi per quanto riguarda i suoi disegni.",
      ],
    },
    { type: "heading", text: "Quando è un comportamento previsto e quando è un vero bug" },
    { type: "paragraph", html: "Due di questi comportamenti sono semplicemente il modo in cui funziona la piattaforma, e nessuna quantità di clic li cambierà: un modello che non porta con sé i disegni e un modello che non ricarica i dati. Salvi un workspace e vada avanti." },
    { type: "paragraph", html: "Vale la pena segnalare i disegni che scompaiono dopo un riavvio nonostante siano stati salvati in un workspace, e un modello che si rifiuta ostinatamente di applicarsi a qualsiasi finestra. Contatti Tradovate tramite la chat integrata nella piattaforma o via email, in modo che venga registrato. Se ha un account di una prop firm o di valutazione e il problema riguarda in realtà dati di mercato mancanti piuttosto che i modelli, il suo accesso ai dati viene abilitato dalla società, la contatti, poiché Tradovate non può risolvere problemi di dati su un account che non possiede." },
  ] },
  ctaHeading: { en: "Let Your Levels Trigger the Trade", de: "Lassen Sie Ihre Levels den Trade auslösen", es: "Deje que sus niveles activen la operación", fr: "Laissez vos niveaux déclencher le trade", it: "Lasci che i suoi livelli attivino il trade" },
  ctaText: { en: "Tired of a chart glitch costing you a fill? If your edge is a set of levels, you can let those levels trigger the trade instead of babysitting a chart, so a lost drawing or a blank template never means a missed setup.", de: "Haben Sie es satt, dass ein Chart-Fehler Sie eine Ausführung kostet? Wenn Ihr Edge auf einer Reihe von Levels basiert, können Sie diese Levels den Trade auslösen lassen, anstatt einen Chart ständig zu überwachen, sodass eine verlorene Zeichnung oder eine leere Vorlage nie ein verpasstes Setup bedeutet.", es: "¿Cansado de que un fallo en el gráfico le cueste una entrada? Si su ventaja se basa en un conjunto de niveles, puede dejar que esos niveles activen la operación en lugar de vigilar constantemente un gráfico, de modo que un dibujo perdido o una plantilla en blanco nunca signifiquen una configuración perdida.", fr: "Fatigué qu'un bug de graphique vous coûte une exécution ? Si votre avantage repose sur un ensemble de niveaux, vous pouvez laisser ces niveaux déclencher le trade au lieu de surveiller constamment un graphique, de sorte qu'un tracé perdu ou un modèle vide ne signifie jamais une opportunité manquée.", it: "Stanco che un problema del grafico le costi un'esecuzione? Se il suo vantaggio si basa su una serie di livelli, può lasciare che quei livelli attivino il trade invece di dover sorvegliare costantemente un grafico, in modo che un disegno perso o un modello vuoto non significhino mai un setup mancato." },
  ctaButtonText: { en: "Start Your Free 7-Day Trial", de: "Starten Sie Ihre kostenlose 5-Tage-Testversion", es: "Comience su prueba gratuita de 5 días", fr: "Démarrez votre essai gratuit de 5 jours", it: "Inizi la sua prova gratuita di 5 giorni" },
  ctaUrl: "https://app.pickmytrade.trade/?register=true&utm_source=content&utm_medium=debugging",
  faqHeading: { en: "Frequently Asked Questions", de: "Häufig gestellte Fragen", es: "Preguntas frecuentes", fr: "Questions fréquentes", it: "Domande frequenti" },
  faqs: { en: [
    { q: "Do Tradovate chart templates save my drawings and trendlines?", a: "No. A chart template stores your indicator setup and the chart's appearance, timeframe, style, colors and indicator parameters. Trendlines, horizontal levels and zones are not part of the template. Those live with the workspace, so if you want your markups back you need to save a workspace, not just a template." },
    { q: "Why does my Tradovate template load a blank chart with no data?", a: "Applying a template changes settings on the chart in front of you; it does not fetch fresh history. If the chart opens with gaps or empty space, that is a data-load issue rather than a template problem. Scroll back through the history to pull bars in, reload the chart, or increase the minimum bars to load so more history preloads." },
    { q: "How do I actually save my full Tradovate chart setup, including levels?", a: "Save a workspace. From the Tradovate logo menu, open Workspaces and save the current one. A workspace captures your window layout, chart, indicators and the drawings on it, which a template does not. Use templates for the look-and-feel and workspaces for the actual analysis you want to keep." },
    { q: "Why does my template only work in the chart window where I created it?", a: "Templates have shown a tendency to display only in the chart window they were built in, even with a checkmark next to the saved name. If a saved template will not apply to a different window, open the chart menu in that window and apply the template there, or recreate the setup manually and re-save it." },
    { q: "Can I move my drawings from ES to Micro ES (MES) with a template?", a: "Not natively. Templates carry indicator and appearance settings, not drawings, so lines drawn on ES will not transfer to MES or any other symbol. You have to redraw levels on each contract, or keep both charts inside one saved workspace so the annotations persist." },
  ], de: [
    { q: "Speichern Tradovate-Chart-Vorlagen meine Zeichnungen und Trendlinien?", a: "Nein. Eine Chart-Vorlage speichert Ihr Indikator-Setup sowie das Erscheinungsbild des Charts, Zeitrahmen, Stil, Farben und Indikatorparameter. Trendlinien, horizontale Levels und Zonen sind nicht Teil der Vorlage. Diese gehören zum Workspace, wenn Sie also Ihre Markierungen zurückhaben möchten, müssen Sie einen Workspace speichern, nicht nur eine Vorlage." },
    { q: "Warum lädt meine Tradovate-Vorlage einen leeren Chart ohne Daten?", a: "Das Anwenden einer Vorlage ändert die Einstellungen auf dem Chart vor Ihnen; sie lädt keinen neuen Verlauf. Wenn der Chart mit Lücken oder leerem Raum öffnet, ist das ein Datenladeproblem und kein Vorlagenproblem. Scrollen Sie durch den Verlauf zurück, um Kerzen nachzuladen, laden Sie den Chart neu, oder erhöhen Sie Minimum Bars to Load, damit mehr Verlauf vorgeladen wird." },
    { q: "Wie speichere ich mein komplettes Tradovate-Chart-Setup tatsächlich, einschließlich der Levels?", a: "Speichern Sie einen Workspace. Öffnen Sie über das Tradovate-Logo-Menü Workspaces und speichern Sie den aktuellen. Ein Workspace erfasst Ihr Fensterlayout, den Chart, die Indikatoren und die Zeichnungen darauf, was eine Vorlage nicht tut. Verwenden Sie Vorlagen für das Look-and-Feel und Workspaces für die tatsächliche Analyse, die Sie behalten möchten." },
    { q: "Warum funktioniert meine Vorlage nur in dem Chart-Fenster, in dem ich sie erstellt habe?", a: "Vorlagen neigen dazu, sich nur in dem Chart-Fenster anzuzeigen, in dem sie erstellt wurden, selbst wenn ein Häkchen neben dem gespeicherten Namen erscheint. Wenn sich eine gespeicherte Vorlage nicht auf ein anderes Fenster anwenden lässt, öffnen Sie das Chart-Menü in diesem Fenster und wenden Sie die Vorlage dort an, oder bauen Sie das Setup manuell neu auf und speichern Sie es erneut." },
    { q: "Kann ich meine Zeichnungen mit einer Vorlage von ES auf Micro ES (MES) übertragen?", a: "Nicht nativ. Vorlagen tragen Indikator- und Erscheinungsbild-Einstellungen, keine Zeichnungen, sodass auf ES gezeichnete Linien nicht auf MES oder ein anderes Symbol übertragen werden. Sie müssen Levels für jeden Kontrakt neu zeichnen oder beide Charts in einem gespeicherten Workspace zusammenfassen, damit die Annotationen erhalten bleiben." },
  ], es: [
    { q: "¿Las plantillas de gráficos de Tradovate guardan mis dibujos y líneas de tendencia?", a: "No. Una plantilla de gráfico almacena su configuración de indicadores y el aspecto del gráfico, marco temporal, estilo, colores y parámetros de indicadores. Las líneas de tendencia, los niveles horizontales y las zonas no forman parte de la plantilla. Esos elementos pertenecen al workspace, así que si quiere recuperar sus marcas necesita guardar un workspace, no solo una plantilla." },
    { q: "¿Por qué mi plantilla de Tradovate carga un gráfico en blanco sin datos?", a: "Aplicar una plantilla cambia la configuración del gráfico que tiene delante; no trae historial nuevo. Si el gráfico se abre con huecos o espacio vacío, se trata de un problema de carga de datos y no de un problema de plantilla. Desplácese hacia atrás en el historial para traer velas, recargue el gráfico, o aumente Minimum Bars to Load para que se precargue más historial." },
    { q: "¿Cómo guardo realmente toda mi configuración de gráfico de Tradovate, incluyendo los niveles?", a: "Guarde un workspace. Desde el menú del logo de Tradovate, abra Workspaces y guarde el actual. Un workspace captura el diseño de sus ventanas, el gráfico, los indicadores y los dibujos que contiene, algo que una plantilla no hace. Use las plantillas para el aspecto visual y los workspaces para el análisis real que quiere conservar." },
    { q: "¿Por qué mi plantilla solo funciona en la ventana del gráfico donde la creé?", a: "Las plantillas han mostrado la tendencia a mostrarse solo en la ventana del gráfico en la que se crearon, incluso con la marca de verificación junto al nombre guardado. Si una plantilla guardada no se aplica a una ventana diferente, abra el menú del gráfico en esa ventana y aplique la plantilla ahí, o recree la configuración manualmente y vuelva a guardarla." },
    { q: "¿Puedo trasladar mis dibujos de ES a Micro ES (MES) con una plantilla?", a: "No de forma nativa. Las plantillas llevan la configuración de indicadores y apariencia, no los dibujos, por lo que las líneas dibujadas en ES no se transferirán a MES ni a ningún otro símbolo. Tiene que volver a dibujar los niveles en cada contrato, o mantener ambos gráficos dentro de un mismo workspace guardado para que las anotaciones persistan." },
  ], fr: [
    { q: "Les modèles de graphique Tradovate enregistrent-ils mes tracés et lignes de tendance ?", a: "Non. Un modèle de graphique enregistre votre configuration d'indicateurs ainsi que l'apparence du graphique, l'échelle de temps, le style, les couleurs et les paramètres d'indicateurs. Les lignes de tendance, les niveaux horizontaux et les zones ne font pas partie du modèle. Ceux-ci relèvent de l'espace de travail, donc si vous voulez récupérer vos annotations, vous devez enregistrer un espace de travail, pas seulement un modèle." },
    { q: "Pourquoi mon modèle Tradovate charge-t-il un graphique vide sans données ?", a: "L'application d'un modèle modifie les réglages sur le graphique devant vous ; elle ne récupère pas un historique récent. Si le graphique s'ouvre avec des écarts ou un espace vide, il s'agit d'un problème de chargement des données plutôt que d'un problème de modèle. Faites défiler l'historique vers l'arrière pour récupérer des bougies, rechargez le graphique, ou augmentez Minimum Bars to Load afin de précharger davantage d'historique." },
    { q: "Comment enregistrer réellement toute ma configuration de graphique Tradovate, niveaux inclus ?", a: "Enregistrez un espace de travail. Depuis le menu du logo Tradovate, ouvrez Workspaces et enregistrez l'espace de travail actuel. Un espace de travail capture la disposition de vos fenêtres, le graphique, les indicateurs et les tracés qui s'y trouvent, ce qu'un modèle ne fait pas. Utilisez les modèles pour l'apparence et les espaces de travail pour l'analyse réelle que vous voulez conserver." },
    { q: "Pourquoi mon modèle ne fonctionne-t-il que dans la fenêtre de graphique où je l'ai créé ?", a: "Les modèles ont tendance à ne s'afficher que dans la fenêtre de graphique où ils ont été créés, même avec une coche à côté du nom enregistré. Si un modèle enregistré ne s'applique pas à une autre fenêtre, ouvrez le menu du graphique dans cette fenêtre et appliquez-y le modèle, ou recréez la configuration manuellement et réenregistrez-la." },
    { q: "Puis-je déplacer mes tracés d'ES vers Micro ES (MES) avec un modèle ?", a: "Pas nativement. Les modèles transportent les réglages d'indicateurs et d'apparence, pas les tracés, donc les lignes tracées sur ES ne se transféreront pas vers MES ou tout autre symbole. Vous devez retracer les niveaux sur chaque contrat, ou conserver les deux graphiques dans un même espace de travail enregistré afin que les annotations persistent." },
  ], it: [
    { q: "I modelli di grafico di Tradovate salvano i miei disegni e le trendline?", a: "No. Un modello di grafico memorizza la configurazione degli indicatori e l'aspetto del grafico, timeframe, stile, colori e parametri degli indicatori. Trendline, livelli orizzontali e zone non fanno parte del modello. Questi elementi appartengono al workspace, quindi se vuole recuperare le sue annotazioni deve salvare un workspace, non solo un modello." },
    { q: "Perché il mio modello Tradovate carica un grafico vuoto senza dati?", a: "Applicare un modello cambia le impostazioni sul grafico davanti a lei; non recupera storico nuovo. Se il grafico si apre con vuoti o spazio vuoto, si tratta di un problema di caricamento dati e non di un problema del modello. Torni indietro nella cronologia per recuperare le candele, ricarichi il grafico, oppure aumenti Minimum Bars to Load in modo che venga precaricato più storico." },
    { q: "Come faccio a salvare davvero l'intera configurazione del mio grafico Tradovate, livelli inclusi?", a: "Salvi un workspace. Dal menu del logo Tradovate, apra Workspaces e salvi quello corrente. Un workspace cattura il layout delle finestre, il grafico, gli indicatori e i disegni presenti su di esso, cosa che un modello non fa. Usi i modelli per l'aspetto grafico e i workspace per l'analisi vera e propria che vuole conservare." },
    { q: "Perché il mio modello funziona solo nella finestra del grafico in cui l'ho creato?", a: "I modelli hanno mostrato la tendenza a comparire solo nella finestra del grafico in cui sono stati creati, anche con il segno di spunta accanto al nome salvato. Se un modello salvato non si applica a una finestra diversa, apra il menu del grafico in quella finestra e applichi lì il modello, oppure ricrei la configurazione manualmente e la salvi di nuovo." },
    { q: "Posso spostare i miei disegni da ES a Micro ES (MES) con un modello?", a: "Non nativamente. I modelli portano con sé le impostazioni di indicatori e aspetto, non i disegni, quindi le linee disegnate su ES non verranno trasferite su MES o su qualsiasi altro simbolo. Deve ridisegnare i livelli su ciascun contratto, oppure mantenere entrambi i grafici in un unico workspace salvato affinché le annotazioni persistano." },
  ] },
