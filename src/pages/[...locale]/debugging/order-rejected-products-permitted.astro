---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "order-rejected-products-permitted";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/debugging/${SLUG}`;

const META_TITLE = "Tradovate Order Rejected: Products Permitted Limit";
const META_DESCRIPTION =
  "Fix a Products Permitted order rejection by adding the contract to your Risk Settings allow-list, or disable the restriction to trade the symbol again.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Tradovate-Order abgelehnt: Products-Permitted-Limit", es: "Orden rechazada en Tradovate: límite de Products Permitted", fr: "Ordre rejeté sur Tradovate : limite Products Permitted", it: "Ordine rifiutato su Tradovate: limite Products Permitted" },
  dek: { en: "An order on ES or CL bounces because the product itself isn't on the account's allow-list. Add it to Products Permitted, or turn the restriction off entirely.", de: "Eine Order auf ES oder CL wird abgelehnt, weil das Produkt selbst nicht auf der Positivliste des Kontos steht. Fügen Sie es zu Products Permitted hinzu oder schalten Sie die Beschränkung ganz ab.", es: "Una orden en ES o CL rebota porque el propio producto no está en la lista de permitidos de la cuenta. Añádalo a Products Permitted o desactive la restricción por completo.", fr: "Un ordre sur ES ou CL est rejeté parce que le produit lui-même ne figure pas sur la liste autorisée du compte. Ajoutez-le à Products Permitted, ou désactivez complètement la restriction.", it: "Un ordine su ES o CL viene respinto perché il prodotto stesso non è nella lista consentita del conto. Lo aggiunga a Products Permitted oppure disattivi del tutto la restrizione." },
  readTime: { en: "7 min read", de: "7 Min. Lesezeit", es: "Lectura de 7 min", fr: "Lecture : 7 min", it: "Lettura di 7 min" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "You send an order on ES or CL, and Tradovate kicks it right back with a rejection that points at the <strong class='text-white'>product itself</strong> not being permitted on the account. Nothing wrong with your size, your margin, or the session, the contract you're trying to trade simply isn't on the account's allow-list. That list is a Tradovate risk control called <strong class='text-white'>Products Permitted</strong>, and when it's switched on, only the products you've explicitly added can trade. Everything else gets refused before it ever hits the exchange. The fix is quick: add the contract to the Products Permitted list, or turn the restriction off entirely." },
    {
      type: "checklist",
      heading: "Quick Checklist for a \"Products Permitted\" Rejection",
      items: [
        "<strong class='text-white'>Read the rejection reason.</strong> It points at the product, not your quantity or funds, a tell that a permitted-products filter, not a size cap, is doing the blocking.",
        "<strong class='text-white'>Open your Risk Settings.</strong> Application Settings &rsaquo; Accounts &rsaquo; Risk Settings, then look at <strong class='text-white'>Products Permitted</strong> for that account.",
        "<strong class='text-white'>Add the product, or switch the filter off.</strong> Search for the contract (e.g. <code>ES</code>) and add it to the list, or disable Products Permitted so every product trades.",
        "<strong class='text-white'>Match the product, not the month.</strong> The list filters by product like <code>NQ</code> or <code>ES</code>, not by a specific expiration, so add the whole product.",
        "<strong class='text-white'>Micros and minis are separate entries.</strong> Permitting <code>NQ</code> doesn't automatically permit <code>MNQ</code>, add each one you actually trade.",
        "<strong class='text-white'>On a prop or evaluation account you usually can't self-edit.</strong> The firm owns the permitted list; check its allowed products or ask support.",
      ],
    },
    { type: "heading", text: "What the \"Products Permitted\" Rejection Means" },
    { type: "paragraph", html: "This is a <strong class='text-white'>risk check</strong>, not a market or connectivity problem. Products Permitted is a per-account allow-list inside Tradovate's Risk Settings. When it's enabled, you're telling the account: only trade these specific products. Any order for a contract that isn't on the list gets rejected <em>pre-trade</em>, it never routes to the exchange. So if the list holds only NQ and you fire an ES order, ES bounces. The account is doing exactly what it was configured to do." },
    { type: "paragraph", html: "That's the key difference from the other rejections that look similar on the surface. A &ldquo;maximum order quantity&rdquo; bounce is about <em>how many</em> contracts you sent. An &ldquo;insufficient margin&rdquo; bounce is about <em>money</em>. A Products Permitted bounce is about <em>which instrument</em> you tried to trade at all. Once you know it's the product filter, the fix is narrow and fast, you're either editing one list or flipping one switch." },
    { type: "paragraph", html: "One more thing worth nailing down early: this filter works at the <strong class='text-white'>product</strong> level. The list is built from products such as NQ, ES, or CL, not from a single expiration like ESU5. Add a product and its active contract is covered. If your rejection is instead about a contract that's expiring or a continuous symbol, that's a rollover problem, not a Products Permitted problem, and it needs a different fix." },
    { type: "heading", text: "Top Causes of the \"Products Permitted\" Rejection" },
    { type: "heading", text: "1. The Allow-List Is On and Your Symbol Isn't on It (Most Common)" },
    { type: "paragraph", html: "The everyday case: at some point Products Permitted got enabled on the account with a short list of products, and now you're trying to trade something outside it. Maybe you set it up months ago to keep yourself disciplined on one instrument, or a saved risk template carried it over. The contract you want is perfectly tradable, it's just not on your account's approved list yet." },
    { type: "heading", text: "2. You Restricted the Account to a Single Product and Forgot" },
    { type: "paragraph", html: "Traders who want to force focus sometimes permit only their main instrument, say, NQ, so a moment of boredom can't turn into a random CL scalp. That's a smart guardrail right up until the day you legitimately want to trade a second product and forget the gate is there. The rejection is your own past setting talking." },
    { type: "heading", text: "3. A Prop Firm Limited the Account to Specific Products" },
    { type: "paragraph", html: "Evaluation and funded accounts frequently ship with a fixed set of tradable products baked into the firm's risk profile. Some programs allow the full futures board; others restrict you to, for example, equity index futures and exclude energies, metals, or crypto. Which products are allowed varies by firm and by account type, so check your firm's current rules rather than assuming. On these accounts the permitted list is the firm's, not yours." },
    { type: "heading", text: "4. Micro vs. Mini, Close Symbols, Separate Products" },
    { type: "paragraph", html: "Here's the trap that catches people who think they've already added their instrument. In the permitted-products picker, a micro and its mini are typically <strong class='text-white'>separate entries</strong>. Permit <code>NQ</code> and your MNQ order can still be rejected, because <code>MNQ</code> is its own product. If you trade both sizes, both need to be on the list. Confirm the exact entries on your own screen, since the way products are grouped can shift between platform versions." },
    { type: "heading", text: "5. An Automated Strategy Sending a Product Outside the Set" },
    { type: "paragraph", html: "If the rejections come from a bot, a TradingView alert, or a copied strategy, the culprit is often a symbol mismatch: the strategy is firing a product your account was never set up to trade. One alert on the wrong instrument and the permitted-products filter refuses it every time it triggers, which can look like a broken automation when it's really a one-line list issue." },
    { type: "heading", text: "How to Fix the \"Products Permitted\" Rejection: Step-by-Step" },
    { type: "heading", text: "Fix A: Add the Product to the Permitted List (Accounts You Control)" },
    { type: "paragraph", html: "If the account is yours to configure, a personal live or demo account rather than a locked prop account, add the contract to the allow-list:" },
    {
      type: "steps",
      items: [
        { title: "Open Application Settings", html: "Open <strong class='text-white'>Application Settings</strong> from the top-right menu in Tradovate Trader (web or desktop)." },
        { title: "Go to Accounts, then Risk Settings", html: "Go to the <strong class='text-white'>Accounts</strong> tab and open <strong class='text-white'>Risk Settings</strong> for the account." },
        { title: "Find Products Permitted", html: "If it's already enabled, you'll see the current allow-list of products." },
        { title: "Search and add the product", html: "Use its search box to look up the product you want (type <code>ES</code>, <code>CL</code>, <code>MNQ</code>, whatever you're trading) and select it to add it." },
        { title: "Save and resend", html: "Save, then resend your order." },
      ],
    },
    { type: "heading", text: "Fix B: Turn the Restriction Off Entirely" },
    { type: "paragraph", html: "If you don't want a product allow-list at all, you'd rather trade the whole board freely, just disable the filter:" },
    {
      type: "steps",
      items: [
        { title: "Open Risk Settings", html: "Open the same <strong class='text-white'>Application Settings &rsaquo; Accounts &rsaquo; Risk Settings</strong> panel." },
        { title: "Toggle Products Permitted off", html: "Find <strong class='text-white'>Products Permitted</strong> and toggle the control <strong class='text-white'>off</strong>." },
        { title: "Save", html: "With no allow-list applied, any tradable product on the account routes normally." },
      ],
    },
    { type: "quote", html: "<strong>Heads up:</strong> Tradovate's risk panel lives under <em>Application Settings &rsaquo; Accounts &rsaquo; Risk Settings</em>, and the control you want is <em>Products Permitted</em>. Exact button placement, the label wording, and how the add-product search behaves can vary a little by platform version and by whether the account is prop-managed, so confirm against your own screen before you change anything." },
    { type: "heading", text: "Fix C: Prop / Evaluation Accounts (You Can't Self-Edit)" },
    { type: "paragraph", html: "On an evaluation or funded prop account, the permitted-products list belongs to the firm, and the controls in Tradovate will be greyed out or ignored. To trade a product that's being rejected:" },
    {
      type: "steps",
      items: [
        { title: "Check the firm's rules", html: "Check the firm's rules for which products its program allows, some restrict to index futures and block energies, metals, or crypto." },
        { title: "Switch products or ask support", html: "If your product isn't on the firm's approved set, trade one that is, or contact the firm's support to ask whether it can be added." },
        { title: "Don't override it inside Tradovate", html: "On some programs, editing risk settings can itself trip a compliance flag. Go through the firm." },
      ],
    },
    { type: "heading", text: "Fix D: Watch the Lock State Before You Change Anything" },
    { type: "paragraph", html: "Tradovate can lock risk settings once an account hits a limit, and if that lock is active, your edits won't stick until the next trading session begins (roughly the 5:00&ndash;6:00 PM ET reset window). There's a bigger warning too: a manually locked risk profile is deliberately hard to reverse, and Tradovate support can't simply unlock it for you. So before you lock a narrow permitted-products list, be sure it's the list you actually want to live with." },
    { type: "heading", text: "Troubleshooting Table" },
    {
      type: "table",
      headers: ["Symptom", "What it means", "Fix"],
      rows: [
        ["Rejection reason references the product, not size or funds", "Products Permitted is on and the symbol isn't listed", "Add the product to the list, or disable the filter"],
        ["Only one product trades; everything else is rejected", "The allow-list holds a single product", "Add the other products you want, or turn Products Permitted off"],
        ["Micro (<code>MNQ</code>) rejected while the mini (<code>NQ</code>) is allowed", "Micro and mini are separate products on the list", "Add the specific micro/mini product you trade"],
        ["Products Permitted control is greyed out", "Account is prop/eval; the firm owns the list", "Check the firm's allowed products or contact its support"],
        ["Your edits won't save", "Risk settings are locked for the session", "Wait for the next session reset, then edit"],
        ["Rejection mentions an expiring or continuous contract", "A rollover issue, not a product filter", "Roll to the active front-month contract instead"],
      ],
    },
    { type: "heading", text: "Prevent This With PickMyTrade" },
    { type: "paragraph", html: "If the rejection is hitting <strong class='text-white'>automated</strong> orders, a TradingView alert, a bot, or a copied strategy firing a product your account won't accept, the cleanest fix is to make sure the right symbol goes out in the first place. PickMyTrade sits between your alert and Tradovate and shapes each order before it routes:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Symbol mapping</strong>, translate a strategy's ticker to the exact Tradovate product symbol, so an alert lands on the instrument your account is actually set up to trade.",
        "<strong class='text-white'>Symbol validation</strong>, check each incoming alert's contract before it's sent, so a stray or wrong-product signal doesn't get blasted into a permitted-products wall over and over.",
        "<strong class='text-white'>Fixed sizing &amp; risk filters</strong>, keep quantity and account state inside the rules you're cleared for, so the same alert doesn't trip a size cap right after you clear the product one.",
        "<strong class='text-white'>Multi-account routing</strong>, send one alert to several Tradovate accounts, each with its own product setup, instead of firing an identical symbol everywhere and eating rejections on the ones that don't allow it.",
      ],
    },
    { type: "paragraph", html: "The result: the order that a permitted-products filter would have bounced goes out on the correct, allowed instrument and routes cleanly, so your automation keeps working instead of silently rejecting on every trigger." },
  ], de: [
    { type: "paragraph",html: "Sie senden eine Order auf ES oder CL, und Tradovate wirft sie sofort mit einer Ablehnung zurück, die darauf hinweist, dass das <strong class='text-white'>Produkt selbst</strong> auf dem Konto nicht zugelassen ist. An Ihrer Größe, Ihrer Margin oder der Sitzung ist nichts falsch, der Kontrakt, den Sie handeln möchten, steht schlicht nicht auf der Positivliste des Kontos. Diese Liste ist eine Tradovate-Risikokontrolle namens <strong class='text-white'>Products Permitted</strong>, und wenn sie eingeschaltet ist, können nur die Produkte gehandelt werden, die Sie ausdrücklich hinzugefügt haben. Alles andere wird abgelehnt, bevor es die Börse erreicht. Die Lösung ist schnell: Fügen Sie den Kontrakt zur Products-Permitted-Liste hinzu oder schalten Sie die Beschränkung ganz ab." },
    {
      type: "checklist",
      heading: "Kurze Checkliste bei einer „Products Permitted“-Ablehnung",
      items: [
        "<strong class='text-white'>Lesen Sie den Ablehnungsgrund.</strong> Er verweist auf das Produkt, nicht auf Ihre Menge oder Ihr Guthaben, ein Hinweis darauf, dass ein Filter für zulässige Produkte und kein Größenlimit blockiert.",
        "<strong class='text-white'>Öffnen Sie Ihre Risk Settings.</strong> Application Settings &rsaquo; Accounts &rsaquo; Risk Settings, und sehen Sie sich dann <strong class='text-white'>Products Permitted</strong> für dieses Konto an.",
        "<strong class='text-white'>Fügen Sie das Produkt hinzu oder schalten Sie den Filter ab.</strong> Suchen Sie den Kontrakt (z. B. <code>ES</code>) und fügen Sie ihn zur Liste hinzu, oder deaktivieren Sie Products Permitted, damit jedes Produkt gehandelt werden kann.",
        "<strong class='text-white'>Ordnen Sie das Produkt zu, nicht den Monat.</strong> Die Liste filtert nach Produkt wie <code>NQ</code> oder <code>ES</code>, nicht nach einem bestimmten Verfall, fügen Sie also das ganze Produkt hinzu.",
        "<strong class='text-white'>Micros und Minis sind getrennte Einträge.</strong> Das Zulassen von <code>NQ</code> erlaubt nicht automatisch <code>MNQ</code>, fügen Sie jeden hinzu, den Sie tatsächlich handeln.",
        "<strong class='text-white'>Bei einem Prop- oder Evaluierungskonto können Sie meist nichts selbst ändern.</strong> Die Firma besitzt die Liste zulässiger Produkte; prüfen Sie deren erlaubte Produkte oder fragen Sie den Support.",
      ],
    },
    { type: "heading",text: "Was die „Products Permitted“-Ablehnung bedeutet" },
    { type: "paragraph",html: "Das ist eine <strong class='text-white'>Risikoprüfung</strong>, kein Markt- oder Verbindungsproblem. Products Permitted ist eine kontobezogene Positivliste in den Risk Settings von Tradovate. Ist sie aktiviert, sagen Sie dem Konto: Handle nur diese bestimmten Produkte. Jede Order für einen Kontrakt, der nicht auf der Liste steht, wird <em>vor dem Handel</em> abgelehnt und nie an die Börse geroutet. Enthält die Liste also nur NQ und Sie feuern eine ES-Order, wird ES abgewiesen. Das Konto tut genau das, wofür es konfiguriert wurde." },
    { type: "paragraph",html: "Das ist der entscheidende Unterschied zu den anderen Ablehnungen, die oberflächlich ähnlich aussehen. Eine &ldquo;maximum order quantity&rdquo;-Ablehnung betrifft, <em>wie viele</em> Kontrakte Sie gesendet haben. Eine &ldquo;insufficient margin&rdquo;-Ablehnung betrifft <em>Geld</em>. Eine Products-Permitted-Ablehnung betrifft, <em>welches Instrument</em> Sie überhaupt handeln wollten. Sobald Sie wissen, dass es der Produktfilter ist, ist die Lösung eng und schnell, Sie bearbeiten entweder eine Liste oder legen einen Schalter um." },
    { type: "paragraph",html: "Noch etwas, das man früh festhalten sollte: Dieser Filter arbeitet auf <strong class='text-white'>Produktebene</strong>. Die Liste besteht aus Produkten wie NQ, ES oder CL, nicht aus einem einzelnen Verfall wie ESU5. Fügen Sie ein Produkt hinzu, ist sein aktiver Kontrakt abgedeckt. Betrifft Ihre Ablehnung stattdessen einen auslaufenden Kontrakt oder ein fortlaufendes Symbol, ist das ein Rollover-Problem, kein Products-Permitted-Problem, und erfordert eine andere Lösung." },
    { type: "heading",text: "Häufigste Ursachen der „Products Permitted“-Ablehnung" },
    { type: "heading",text: "1. Die Positivliste ist aktiv und Ihr Symbol steht nicht darauf (am häufigsten)" },
    { type: "paragraph",html: "Der Alltagsfall: Irgendwann wurde Products Permitted mit einer kurzen Produktliste für das Konto aktiviert, und jetzt versuchen Sie, etwas außerhalb davon zu handeln. Vielleicht haben Sie es vor Monaten eingerichtet, um sich auf ein Instrument zu disziplinieren, oder eine gespeicherte Risikovorlage hat es übernommen. Der gewünschte Kontrakt ist durchaus handelbar, er steht nur noch nicht auf der genehmigten Liste Ihres Kontos." },
    { type: "heading",text: "2. Sie haben das Konto auf ein einzelnes Produkt beschränkt und es vergessen" },
    { type: "paragraph",html: "Trader, die Fokus erzwingen wollen, erlauben manchmal nur ihr Hauptinstrument, etwa NQ, damit aus einem Moment der Langeweile kein zufälliger CL-Scalp wird. Das ist eine kluge Leitplanke, bis zu dem Tag, an dem Sie berechtigterweise ein zweites Produkt handeln wollen und vergessen, dass die Sperre da ist. Die Ablehnung ist Ihre eigene frühere Einstellung, die spricht." },
    { type: "heading",text: "3. Eine Prop-Firma hat das Konto auf bestimmte Produkte beschränkt" },
    { type: "paragraph",html: "Evaluierungs- und Funded-Konten werden häufig mit einem festen Satz handelbarer Produkte im Risikoprofil der Firma ausgeliefert. Manche Programme erlauben das gesamte Futures-Angebot; andere beschränken Sie beispielsweise auf Aktienindex-Futures und schließen Energie, Metalle oder Krypto aus. Welche Produkte erlaubt sind, variiert je nach Firma und Kontotyp, prüfen Sie daher die aktuellen Regeln Ihrer Firma, statt zu raten. Bei diesen Konten gehört die Liste zulässiger Produkte der Firma, nicht Ihnen." },
    { type: "heading",text: "4. Micro vs. Mini, ähnliche Symbole, getrennte Produkte" },
    { type: "paragraph",html: "Das ist die Falle, in die Leute tappen, die glauben, ihr Instrument bereits hinzugefügt zu haben. In der Auswahl der zulässigen Produkte sind ein Micro und sein Mini typischerweise <strong class='text-white'>getrennte Einträge</strong>. Erlauben Sie <code>NQ</code>, kann Ihre MNQ-Order trotzdem abgelehnt werden, weil <code>MNQ</code> ein eigenes Produkt ist. Handeln Sie beide Größen, müssen beide auf der Liste stehen. Bestätigen Sie die genauen Einträge auf Ihrem eigenen Bildschirm, da sich die Gruppierung der Produkte zwischen Plattformversionen ändern kann." },
    { type: "heading",text: "5. Eine automatisierte Strategie sendet ein Produkt außerhalb der Auswahl" },
    { type: "paragraph",html: "Stammen die Ablehnungen von einem Bot, einem TradingView-Alert oder einer kopierten Strategie, ist der Übeltäter oft eine Symbol-Abweichung: Die Strategie feuert ein Produkt, für das Ihr Konto nie eingerichtet wurde. Ein Alert auf das falsche Instrument, und der Filter für zulässige Produkte lehnt ihn bei jedem Auslösen ab, was wie eine defekte Automatisierung aussehen kann, obwohl es in Wahrheit ein Einzeiler in der Liste ist." },
    { type: "heading",text: "Die „Products Permitted“-Ablehnung beheben: Schritt für Schritt" },
    { type: "heading",text: "Lösung A: Produkt zur Liste zulässiger Produkte hinzufügen (Konten unter Ihrer Kontrolle)" },
    { type: "paragraph",html: "Wenn Sie das Konto selbst konfigurieren können, ein persönliches Live- oder Demokonto statt eines gesperrten Prop-Kontos, fügen Sie den Kontrakt zur Positivliste hinzu:" },
    {
      type: "steps",
      items: [
        { title: "Application Settings öffnen", html: "Öffnen Sie <strong class='text-white'>Application Settings</strong> über das Menü oben rechts in Tradovate Trader (Web oder Desktop)." },
        { title: "Zu Accounts, dann Risk Settings", html: "Wechseln Sie zum Tab <strong class='text-white'>Accounts</strong> und öffnen Sie <strong class='text-white'>Risk Settings</strong> für das Konto." },
        { title: "Products Permitted finden", html: "Wenn es bereits aktiviert ist, sehen Sie die aktuelle Positivliste der Produkte." },
        { title: "Produkt suchen und hinzufügen", html: "Suchen Sie im Suchfeld das gewünschte Produkt (geben Sie <code>ES</code>, <code>CL</code>, <code>MNQ</code> ein, was auch immer Sie handeln) und wählen Sie es aus, um es hinzuzufügen." },
        { title: "Speichern und erneut senden", html: "Speichern Sie und senden Sie Ihre Order erneut." },
      ],
    },
    { type: "heading",text: "Lösung B: Die Beschränkung ganz abschalten" },
    { type: "paragraph",html: "Wenn Sie überhaupt keine Produkt-Positivliste möchten und lieber das gesamte Angebot frei handeln, deaktivieren Sie einfach den Filter:" },
    {
      type: "steps",
      items: [
        { title: "Risk Settings öffnen", html: "Öffnen Sie dasselbe Panel <strong class='text-white'>Application Settings &rsaquo; Accounts &rsaquo; Risk Settings</strong>." },
        { title: "Products Permitted ausschalten", html: "Suchen Sie <strong class='text-white'>Products Permitted</strong> und schalten Sie das Steuerelement <strong class='text-white'>aus</strong>." },
        { title: "Speichern", html: "Ohne angewendete Positivliste wird jedes handelbare Produkt des Kontos normal geroutet." },
      ],
    },
    { type: "quote",html: "<strong>Hinweis:</strong> Das Risikopanel von Tradovate befindet sich unter <em>Application Settings &rsaquo; Accounts &rsaquo; Risk Settings</em>, und das gesuchte Steuerelement ist <em>Products Permitted</em>. Die genaue Platzierung der Schaltflächen, die Beschriftung und das Verhalten der Suche zum Hinzufügen von Produkten können je nach Plattformversion und danach, ob das Konto von einer Prop-Firma verwaltet wird, leicht variieren. Gleichen Sie daher mit Ihrem eigenen Bildschirm ab, bevor Sie etwas ändern." },
    { type: "heading",text: "Lösung C: Prop- / Evaluierungskonten (Sie können nicht selbst bearbeiten)" },
    { type: "paragraph",html: "Bei einem Evaluierungs- oder Funded-Prop-Konto gehört die Liste zulässiger Produkte der Firma, und die Steuerelemente in Tradovate sind ausgegraut oder werden ignoriert. So handeln Sie ein Produkt, das abgelehnt wird:" },
    {
      type: "steps",
      items: [
        { title: "Regeln der Firma prüfen", html: "Prüfen Sie die Regeln der Firma, welche Produkte deren Programm erlaubt, manche beschränken auf Index-Futures und sperren Energie, Metalle oder Krypto." },
        { title: "Produkt wechseln oder Support fragen", html: "Steht Ihr Produkt nicht auf der genehmigten Liste der Firma, handeln Sie ein erlaubtes oder fragen Sie den Support der Firma, ob es hinzugefügt werden kann." },
        { title: "Nicht in Tradovate überschreiben", html: "Bei manchen Programmen kann schon das Bearbeiten der Risikoeinstellungen eine Compliance-Markierung auslösen. Gehen Sie über die Firma." },
      ],
    },
    { type: "heading",text: "Lösung D: Achten Sie auf den Sperrstatus, bevor Sie etwas ändern" },
    { type: "paragraph",html: "Tradovate kann Risikoeinstellungen sperren, sobald ein Konto ein Limit erreicht, und ist diese Sperre aktiv, werden Ihre Änderungen erst mit Beginn der nächsten Handelssitzung wirksam (etwa im Reset-Fenster 17:00&ndash;18:00 Uhr ET). Es gibt auch eine größere Warnung: Ein manuell gesperrtes Risikoprofil ist absichtlich schwer rückgängig zu machen, und der Tradovate-Support kann es nicht einfach für Sie entsperren. Bevor Sie also eine enge Liste zulässiger Produkte sperren, stellen Sie sicher, dass es die Liste ist, mit der Sie tatsächlich leben wollen." },
    { type: "heading",text: "Fehlerbehebungstabelle" },
    { type: "table", headers: ["Symptom","Bedeutung","Lösung"], rows: [
      ["Der Ablehnungsgrund verweist auf das Produkt, nicht auf Größe oder Guthaben","Products Permitted ist aktiv und das Symbol ist nicht aufgeführt","Produkt zur Liste hinzufügen oder Filter deaktivieren"],
      ["Nur ein Produkt wird gehandelt; alles andere wird abgelehnt","Die Positivliste enthält ein einzelnes Produkt","Weitere gewünschte Produkte hinzufügen oder Products Permitted ausschalten"],
      ["Micro (<code>MNQ</code>) abgelehnt, während der Mini (<code>NQ</code>) erlaubt ist","Micro und Mini sind getrennte Produkte in der Liste","Das konkrete Micro-/Mini-Produkt hinzufügen, das Sie handeln"],
      ["Das Steuerelement Products Permitted ist ausgegraut","Konto ist Prop/Evaluierung; die Firma besitzt die Liste","Erlaubte Produkte der Firma prüfen oder deren Support kontaktieren"],
      ["Ihre Änderungen werden nicht gespeichert","Risikoeinstellungen sind für die Sitzung gesperrt","Auf den nächsten Sitzungs-Reset warten, dann bearbeiten"],
      ["Die Ablehnung erwähnt einen auslaufenden oder fortlaufenden Kontrakt","Ein Rollover-Problem, kein Produktfilter","Stattdessen auf den aktiven Front-Month-Kontrakt wechseln"],
    ] },
    { type: "heading",text: "Vermeiden Sie das mit PickMyTrade" },
    { type: "paragraph",html: "Betrifft die Ablehnung <strong class='text-white'>automatisierte</strong> Orders, einen TradingView-Alert, einen Bot oder eine kopierte Strategie, die ein Produkt feuert, das Ihr Konto nicht akzeptiert, besteht die sauberste Lösung darin, sicherzustellen, dass von vornherein das richtige Symbol hinausgeht. PickMyTrade sitzt zwischen Ihrem Alert und Tradovate und formt jede Order, bevor sie geroutet wird:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Symbol-Zuordnung</strong>, übersetzen Sie das Ticker-Symbol einer Strategie in das exakte Tradovate-Produktsymbol, damit ein Alert auf dem Instrument landet, für dessen Handel Ihr Konto tatsächlich eingerichtet ist.",
        "<strong class='text-white'>Symbol-Validierung</strong>, prüfen Sie den Kontrakt jedes eingehenden Alerts, bevor er gesendet wird, damit ein verirrtes Signal oder eines mit dem falschen Produkt nicht immer wieder gegen eine Wand zulässiger Produkte geschossen wird.",
        "<strong class='text-white'>Feste Größe &amp; Risikofilter</strong>, halten Sie Menge und Kontostatus innerhalb der Regeln, für die Sie freigegeben sind, damit derselbe Alert nicht gleich nach der Freigabe des Produkts ein Größenlimit auslöst.",
        "<strong class='text-white'>Multi-Account-Routing</strong>, senden Sie einen Alert an mehrere Tradovate-Konten mit jeweils eigener Produktkonfiguration, statt überall dasselbe Symbol zu feuern und bei den Konten, die es nicht erlauben, Ablehnungen einzustecken.",
      ],
    },
    { type: "paragraph",html: "Das Ergebnis: Die Order, die ein Filter für zulässige Produkte abgewiesen hätte, geht auf dem richtigen, erlaubten Instrument hinaus und wird sauber geroutet, sodass Ihre Automatisierung weiterläuft, statt bei jedem Auslösen stillschweigend abgelehnt zu werden." },
  ], es: [
    { type: "paragraph",html: "Envía una orden en ES o CL y Tradovate se la devuelve al instante con un rechazo que señala que el <strong class='text-white'>propio producto</strong> no está permitido en la cuenta. No hay nada malo con su tamaño, su margen o la sesión, simplemente el contrato que intenta operar no está en la lista de permitidos de la cuenta. Esa lista es un control de riesgo de Tradovate llamado <strong class='text-white'>Products Permitted</strong>, y cuando está activado, solo pueden operarse los productos que haya añadido explícitamente. Todo lo demás se rechaza antes de llegar al mercado. La solución es rápida: añada el contrato a la lista Products Permitted o desactive la restricción por completo." },
    {
      type: "checklist",
      heading: "Lista de comprobación rápida para un rechazo «Products Permitted»",
      items: [
        "<strong class='text-white'>Lea el motivo del rechazo.</strong> Señala el producto, no su cantidad ni sus fondos, una pista de que lo que bloquea es un filtro de productos permitidos, no un límite de tamaño.",
        "<strong class='text-white'>Abra sus Risk Settings.</strong> Application Settings &rsaquo; Accounts &rsaquo; Risk Settings, y luego mire <strong class='text-white'>Products Permitted</strong> de esa cuenta.",
        "<strong class='text-white'>Añada el producto o apague el filtro.</strong> Busque el contrato (p. ej. <code>ES</code>) y añádalo a la lista, o desactive Products Permitted para que opere cualquier producto.",
        "<strong class='text-white'>Asigne el producto, no el mes.</strong> La lista filtra por producto como <code>NQ</code> o <code>ES</code>, no por un vencimiento concreto, así que añada el producto completo.",
        "<strong class='text-white'>Micros y minis son entradas separadas.</strong> Permitir <code>NQ</code> no permite automáticamente <code>MNQ</code>, añada cada uno que realmente opere.",
        "<strong class='text-white'>En una cuenta prop o de evaluación normalmente no puede editarlo usted mismo.</strong> La firma es dueña de la lista de permitidos; consulte sus productos permitidos o pregunte al soporte.",
      ],
    },
    { type: "heading",text: "Qué significa el rechazo «Products Permitted»" },
    { type: "paragraph",html: "Es una <strong class='text-white'>comprobación de riesgo</strong>, no un problema de mercado ni de conectividad. Products Permitted es una lista de permitidos por cuenta dentro de los Risk Settings de Tradovate. Cuando está activada, le indica a la cuenta: opere solo estos productos concretos. Cualquier orden de un contrato que no esté en la lista se rechaza <em>antes de operar</em> y nunca se enruta al mercado. Así, si la lista solo contiene NQ y usted dispara una orden de ES, ES rebota. La cuenta hace exactamente lo que se configuró." },
    { type: "paragraph",html: "Esa es la diferencia clave con otros rechazos que se parecen en la superficie. Un rebote por &ldquo;maximum order quantity&rdquo; trata de <em>cuántos</em> contratos envió. Un rebote por &ldquo;insufficient margin&rdquo; trata de <em>dinero</em>. Un rebote por Products Permitted trata de <em>qué instrumento</em> intentó operar. Una vez que sabe que es el filtro de productos, la solución es acotada y rápida, o edita una lista o pulsa un interruptor." },
    { type: "paragraph",html: "Una cosa más que conviene fijar pronto: este filtro funciona a nivel de <strong class='text-white'>producto</strong>. La lista se construye con productos como NQ, ES o CL, no con un único vencimiento como ESU5. Añada un producto y su contrato activo queda cubierto. Si su rechazo trata en cambio de un contrato que vence o de un símbolo continuo, es un problema de renovación, no de Products Permitted, y necesita otra solución." },
    { type: "heading",text: "Principales causas del rechazo «Products Permitted»" },
    { type: "heading",text: "1. La lista de permitidos está activada y su símbolo no está en ella (la más común)" },
    { type: "paragraph",html: "El caso cotidiano: en algún momento se activó Products Permitted en la cuenta con una lista corta de productos, y ahora intenta operar algo fuera de ella. Quizá lo configuró hace meses para mantener la disciplina en un solo instrumento, o una plantilla de riesgo guardada lo arrastró. El contrato que quiere es perfectamente negociable, solo que aún no está en la lista aprobada de su cuenta." },
    { type: "heading",text: "2. Restringió la cuenta a un único producto y lo olvidó" },
    { type: "paragraph",html: "Los traders que quieren forzar el enfoque a veces permiten solo su instrumento principal, digamos NQ, para que un momento de aburrimiento no se convierta en un scalp aleatorio de CL. Es una buena barrera hasta el día en que legítimamente quiere operar un segundo producto y olvida que la puerta está ahí. El rechazo es su propio ajuste pasado hablando." },
    { type: "heading",text: "3. Una prop firm limitó la cuenta a productos concretos" },
    { type: "paragraph",html: "Las cuentas de evaluación y fondeadas suelen venir con un conjunto fijo de productos negociables integrado en el perfil de riesgo de la firma. Algunos programas permiten todo el tablero de futuros; otros le restringen, por ejemplo, a futuros de índices bursátiles y excluyen energía, metales o cripto. Qué productos se permiten varía según la firma y el tipo de cuenta, así que consulte las reglas vigentes de su firma en lugar de suponer. En estas cuentas la lista de permitidos es de la firma, no suya." },
    { type: "heading",text: "4. Micro frente a mini, símbolos parecidos, productos separados" },
    { type: "paragraph",html: "Esta es la trampa que atrapa a quienes creen haber añadido ya su instrumento. En el selector de productos permitidos, un micro y su mini suelen ser <strong class='text-white'>entradas separadas</strong>. Permita <code>NQ</code> y su orden de MNQ aún puede rechazarse, porque <code>MNQ</code> es su propio producto. Si opera ambos tamaños, ambos deben estar en la lista. Confirme las entradas exactas en su propia pantalla, ya que la forma de agrupar los productos puede cambiar entre versiones de la plataforma." },
    { type: "heading",text: "5. Una estrategia automatizada envía un producto fuera del conjunto" },
    { type: "paragraph",html: "Si los rechazos proceden de un bot, una alerta de TradingView o una estrategia copiada, el culpable suele ser una discrepancia de símbolo: la estrategia dispara un producto para el que su cuenta nunca se configuró. Una alerta sobre el instrumento equivocado y el filtro de productos permitidos la rechaza cada vez que se activa, lo que puede parecer una automatización rota cuando en realidad es un problema de una línea en la lista." },
    { type: "heading",text: "Cómo solucionar el rechazo «Products Permitted»: paso a paso" },
    { type: "heading",text: "Solución A: Añada el producto a la lista de permitidos (cuentas que usted controla)" },
    { type: "paragraph",html: "Si la cuenta es suya para configurar, una cuenta personal real o demo en lugar de una cuenta prop bloqueada, añada el contrato a la lista de permitidos:" },
    {
      type: "steps",
      items: [
        { title: "Abra Application Settings", html: "Abra <strong class='text-white'>Application Settings</strong> desde el menú superior derecho en Tradovate Trader (web o escritorio)." },
        { title: "Vaya a Accounts y luego a Risk Settings", html: "Vaya a la pestaña <strong class='text-white'>Accounts</strong> y abra <strong class='text-white'>Risk Settings</strong> de la cuenta." },
        { title: "Encuentre Products Permitted", html: "Si ya está activado, verá la lista de permitidos actual de productos." },
        { title: "Busque y añada el producto", html: "Use su cuadro de búsqueda para encontrar el producto que desea (escriba <code>ES</code>, <code>CL</code>, <code>MNQ</code>, lo que esté operando) y selecciónelo para añadirlo." },
        { title: "Guarde y vuelva a enviar", html: "Guarde y luego vuelva a enviar su orden." },
      ],
    },
    { type: "heading",text: "Solución B: Desactive la restricción por completo" },
    { type: "paragraph",html: "Si no quiere ninguna lista de productos permitidos y prefiere operar libremente todo el tablero, simplemente desactive el filtro:" },
    {
      type: "steps",
      items: [
        { title: "Abra Risk Settings", html: "Abra el mismo panel <strong class='text-white'>Application Settings &rsaquo; Accounts &rsaquo; Risk Settings</strong>." },
        { title: "Desactive Products Permitted", html: "Busque <strong class='text-white'>Products Permitted</strong> y ponga el control en <strong class='text-white'>off</strong>." },
        { title: "Guarde", html: "Sin lista de permitidos aplicada, cualquier producto negociable de la cuenta se enruta con normalidad." },
      ],
    },
    { type: "quote",html: "<strong>Aviso:</strong> el panel de riesgo de Tradovate se encuentra en <em>Application Settings &rsaquo; Accounts &rsaquo; Risk Settings</em>, y el control que necesita es <em>Products Permitted</em>. La ubicación exacta de los botones, la redacción de la etiqueta y el comportamiento de la búsqueda al añadir productos pueden variar ligeramente según la versión de la plataforma y según si la cuenta está gestionada por una prop firm, así que compruebe con su propia pantalla antes de cambiar nada." },
    { type: "heading",text: "Solución C: Cuentas prop / de evaluación (no puede editarlas usted mismo)" },
    { type: "paragraph",html: "En una cuenta prop de evaluación o fondeada, la lista de productos permitidos pertenece a la firma y los controles en Tradovate aparecerán en gris o se ignorarán. Para operar un producto que se está rechazando:" },
    {
      type: "steps",
      items: [
        { title: "Consulte las reglas de la firma", html: "Consulte las reglas de la firma sobre qué productos permite su programa, algunas restringen a futuros de índices y bloquean energía, metales o cripto." },
        { title: "Cambie de producto o pregunte al soporte", html: "Si su producto no está en el conjunto aprobado de la firma, opere uno que sí lo esté, o contacte con el soporte de la firma para preguntar si puede añadirse." },
        { title: "No lo anule dentro de Tradovate", html: "En algunos programas, editar los ajustes de riesgo puede activar por sí mismo una marca de cumplimiento. Pase por la firma." },
      ],
    },
    { type: "heading",text: "Solución D: Vigile el estado de bloqueo antes de cambiar nada" },
    { type: "paragraph",html: "Tradovate puede bloquear los ajustes de riesgo cuando una cuenta alcanza un límite y, si ese bloqueo está activo, sus cambios no se aplicarán hasta que comience la siguiente sesión de negociación (aproximadamente la ventana de reinicio de 5:00&ndash;6:00 PM ET). Hay además una advertencia mayor: un perfil de riesgo bloqueado manualmente es deliberadamente difícil de revertir, y el soporte de Tradovate no puede simplemente desbloquearlo por usted. Así que, antes de bloquear una lista estrecha de productos permitidos, asegúrese de que es la lista con la que realmente quiere vivir." },
    { type: "heading",text: "Tabla de resolución de problemas" },
    { type: "table", headers: ["Síntoma","Qué significa","Solución"], rows: [
      ["El motivo del rechazo hace referencia al producto, no al tamaño ni a los fondos","Products Permitted está activado y el símbolo no figura en la lista","Añada el producto a la lista o desactive el filtro"],
      ["Solo se opera un producto; todo lo demás se rechaza","La lista de permitidos contiene un único producto","Añada los demás productos que desee o desactive Products Permitted"],
      ["Micro (<code>MNQ</code>) rechazado mientras el mini (<code>NQ</code>) está permitido","Micro y mini son productos separados en la lista","Añada el producto micro/mini concreto que opera"],
      ["El control Products Permitted aparece en gris","La cuenta es prop/evaluación; la firma es dueña de la lista","Consulte los productos permitidos de la firma o contacte con su soporte"],
      ["Sus cambios no se guardan","Los ajustes de riesgo están bloqueados durante la sesión","Espere al siguiente reinicio de sesión y luego edite"],
      ["El rechazo menciona un contrato a punto de vencer o continuo","Un problema de renovación, no un filtro de productos","Pase en su lugar al contrato activo del mes más cercano"],
    ] },
    { type: "heading",text: "Evítelo con PickMyTrade" },
    { type: "paragraph",html: "Si el rechazo afecta a órdenes <strong class='text-white'>automatizadas</strong>, una alerta de TradingView, un bot o una estrategia copiada que dispara un producto que su cuenta no acepta, la solución más limpia es asegurarse de que salga el símbolo correcto desde el principio. PickMyTrade se sitúa entre su alerta y Tradovate y da forma a cada orden antes de enrutarla:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Asignación de símbolos</strong>, traduzca el ticker de una estrategia al símbolo exacto del producto de Tradovate, para que una alerta llegue al instrumento que su cuenta está realmente configurada para operar.",
        "<strong class='text-white'>Validación de símbolos</strong>, compruebe el contrato de cada alerta entrante antes de enviarla, para que una señal perdida o de un producto equivocado no se estrelle una y otra vez contra un muro de productos permitidos.",
        "<strong class='text-white'>Tamaño fijo y filtros de riesgo</strong>, mantenga la cantidad y el estado de la cuenta dentro de las reglas para las que está autorizado, para que la misma alerta no active un límite de tamaño justo después de que despeje el del producto.",
        "<strong class='text-white'>Enrutamiento multicuenta</strong>, envíe una alerta a varias cuentas de Tradovate, cada una con su propia configuración de productos, en lugar de disparar un símbolo idéntico en todas partes y acumular rechazos en las que no lo permiten.",
      ],
    },
    { type: "paragraph",html: "El resultado: la orden que un filtro de productos permitidos habría rechazado sale con el instrumento correcto y permitido y se enruta sin problemas, de modo que su automatización sigue funcionando en lugar de rechazar en silencio en cada activación." },
  ], fr: [
    { type: "paragraph",html: "Vous envoyez un ordre sur ES ou CL, et Tradovate vous le renvoie aussitôt avec un rejet indiquant que le <strong class='text-white'>produit lui-même</strong> n'est pas autorisé sur le compte. Rien ne cloche dans votre taille, votre marge ou la session, le contrat que vous tentez de négocier ne figure simplement pas sur la liste autorisée du compte. Cette liste est un contrôle de risque Tradovate appelé <strong class='text-white'>Products Permitted</strong>, et lorsqu'il est activé, seuls les produits que vous avez explicitement ajoutés peuvent être négociés. Tout le reste est refusé avant même d'atteindre la bourse. La solution est rapide : ajoutez le contrat à la liste Products Permitted, ou désactivez complètement la restriction." },
    {
      type: "checklist",
      heading: "Liste de contrôle rapide pour un rejet « Products Permitted »",
      items: [
        "<strong class='text-white'>Lisez la raison du rejet.</strong> Elle désigne le produit, pas votre quantité ni vos fonds, signe qu'un filtre de produits autorisés, et non un plafond de taille, est à l'origine du blocage.",
        "<strong class='text-white'>Ouvrez vos Risk Settings.</strong> Application Settings &rsaquo; Accounts &rsaquo; Risk Settings, puis regardez <strong class='text-white'>Products Permitted</strong> pour ce compte.",
        "<strong class='text-white'>Ajoutez le produit, ou désactivez le filtre.</strong> Recherchez le contrat (p. ex. <code>ES</code>) et ajoutez-le à la liste, ou désactivez Products Permitted pour que tous les produits soient négociables.",
        "<strong class='text-white'>Associez le produit, pas le mois.</strong> La liste filtre par produit comme <code>NQ</code> ou <code>ES</code>, et non par échéance précise ; ajoutez donc le produit entier.",
        "<strong class='text-white'>Micros et minis sont des entrées distinctes.</strong> Autoriser <code>NQ</code> n'autorise pas automatiquement <code>MNQ</code>, ajoutez chacun de ceux que vous négociez réellement.",
        "<strong class='text-white'>Sur un compte prop ou d'évaluation, vous ne pouvez généralement pas modifier vous-même.</strong> La firme détient la liste autorisée ; consultez ses produits autorisés ou contactez le support.",
      ],
    },
    { type: "heading",text: "Ce que signifie le rejet « Products Permitted »" },
    { type: "paragraph",html: "Il s'agit d'un <strong class='text-white'>contrôle de risque</strong>, pas d'un problème de marché ou de connectivité. Products Permitted est une liste autorisée par compte dans les Risk Settings de Tradovate. Lorsqu'elle est activée, vous dites au compte : ne négocie que ces produits précis. Tout ordre portant sur un contrat absent de la liste est rejeté <em>avant la transaction</em> et n'est jamais routé vers la bourse. Ainsi, si la liste ne contient que NQ et que vous tirez un ordre ES, ES est refusé. Le compte fait exactement ce pour quoi il a été configuré." },
    { type: "paragraph",html: "C'est la différence essentielle avec les autres rejets qui se ressemblent en surface. Un rejet « maximum order quantity » concerne <em>le nombre</em> de contrats envoyés. Un rejet « insufficient margin » concerne <em>l'argent</em>. Un rejet Products Permitted concerne <em>l'instrument</em> que vous avez tenté de négocier. Une fois que vous savez qu'il s'agit du filtre de produits, la correction est étroite et rapide, vous modifiez soit une liste, soit un interrupteur." },
    { type: "paragraph",html: "Un dernier point à fixer tôt : ce filtre fonctionne au niveau du <strong class='text-white'>produit</strong>. La liste est construite à partir de produits comme NQ, ES ou CL, et non d'une échéance unique comme ESU5. Ajoutez un produit et son contrat actif est couvert. Si votre rejet concerne plutôt un contrat proche de l'expiration ou un symbole continu, il s'agit d'un problème de roulement, pas d'un problème Products Permitted, et il demande une autre correction." },
    { type: "heading",text: "Principales causes du rejet « Products Permitted »" },
    { type: "heading",text: "1. La liste autorisée est activée et votre symbole n'y figure pas (le plus courant)" },
    { type: "paragraph",html: "Le cas quotidien : à un moment donné, Products Permitted a été activé sur le compte avec une courte liste de produits, et vous essayez maintenant de négocier quelque chose en dehors. Peut-être l'avez-vous configuré il y a des mois pour vous discipliner sur un seul instrument, ou un modèle de risque enregistré l'a reporté. Le contrat que vous voulez est parfaitement négociable, il ne figure simplement pas encore sur la liste approuvée de votre compte." },
    { type: "heading",text: "2. Vous avez restreint le compte à un seul produit et l'avez oublié" },
    { type: "paragraph",html: "Les traders qui veulent s'imposer de la concentration n'autorisent parfois que leur instrument principal, disons NQ, pour qu'un moment d'ennui ne se transforme pas en scalp aléatoire sur CL. C'est un garde-fou intelligent, jusqu'au jour où vous voulez légitimement négocier un second produit et oubliez que la barrière est là. Le rejet, c'est votre propre ancien paramètre qui parle." },
    { type: "heading",text: "3. Une prop firm a limité le compte à des produits précis" },
    { type: "paragraph",html: "Les comptes d'évaluation et financés sont fréquemment livrés avec un ensemble fixe de produits négociables intégré au profil de risque de la firme. Certains programmes autorisent tout le tableau des contrats à terme ; d'autres vous limitent, par exemple, aux contrats sur indices actions et excluent l'énergie, les métaux ou les cryptos. Les produits autorisés varient selon la firme et le type de compte ; consultez donc les règles actuelles de votre firme plutôt que de supposer. Sur ces comptes, la liste autorisée est celle de la firme, pas la vôtre." },
    { type: "heading",text: "4. Micro contre mini, symboles proches, produits distincts" },
    { type: "paragraph",html: "Voici le piège dans lequel tombent ceux qui pensent avoir déjà ajouté leur instrument. Dans le sélecteur de produits autorisés, un micro et son mini sont généralement des <strong class='text-white'>entrées distinctes</strong>. Autorisez <code>NQ</code> et votre ordre MNQ peut encore être rejeté, car <code>MNQ</code> est un produit à part entière. Si vous négociez les deux tailles, les deux doivent figurer sur la liste. Vérifiez les entrées exactes sur votre propre écran, car la façon dont les produits sont regroupés peut changer d'une version de la plateforme à l'autre." },
    { type: "heading",text: "5. Une stratégie automatisée envoie un produit en dehors de l'ensemble" },
    { type: "paragraph",html: "Si les rejets proviennent d'un bot, d'une alerte TradingView ou d'une stratégie copiée, le coupable est souvent une incohérence de symbole : la stratégie tire un produit pour lequel votre compte n'a jamais été configuré. Une alerte sur le mauvais instrument et le filtre de produits autorisés la refuse à chaque déclenchement, ce qui peut ressembler à une automatisation défaillante alors qu'il s'agit en réalité d'un simple problème de liste." },
    { type: "heading",text: "Résoudre le rejet « Products Permitted » : pas à pas" },
    { type: "heading",text: "Solution A : Ajouter le produit à la liste autorisée (comptes que vous contrôlez)" },
    { type: "paragraph",html: "Si le compte est à vous de configurer, un compte personnel réel ou démo plutôt qu'un compte prop verrouillé, ajoutez le contrat à la liste autorisée :" },
    {
      type: "steps",
      items: [
        { title: "Ouvrez Application Settings", html: "Ouvrez <strong class='text-white'>Application Settings</strong> depuis le menu en haut à droite dans Tradovate Trader (web ou bureau)." },
        { title: "Allez dans Accounts, puis Risk Settings", html: "Allez dans l'onglet <strong class='text-white'>Accounts</strong> et ouvrez <strong class='text-white'>Risk Settings</strong> pour le compte." },
        { title: "Trouvez Products Permitted", html: "S'il est déjà activé, vous verrez la liste autorisée actuelle des produits." },
        { title: "Recherchez et ajoutez le produit", html: "Utilisez sa zone de recherche pour trouver le produit souhaité (saisissez <code>ES</code>, <code>CL</code>, <code>MNQ</code>, ce que vous négociez) et sélectionnez-le pour l'ajouter." },
        { title: "Enregistrez et renvoyez", html: "Enregistrez, puis renvoyez votre ordre." },
      ],
    },
    { type: "heading",text: "Solution B : Désactiver complètement la restriction" },
    { type: "paragraph",html: "Si vous ne voulez aucune liste de produits autorisés et préférez négocier librement tout le tableau, désactivez simplement le filtre :" },
    {
      type: "steps",
      items: [
        { title: "Ouvrez Risk Settings", html: "Ouvrez le même panneau <strong class='text-white'>Application Settings &rsaquo; Accounts &rsaquo; Risk Settings</strong>." },
        { title: "Désactivez Products Permitted", html: "Trouvez <strong class='text-white'>Products Permitted</strong> et basculez le contrôle sur <strong class='text-white'>off</strong>." },
        { title: "Enregistrez", html: "Sans liste autorisée appliquée, tout produit négociable du compte est routé normalement." },
      ],
    },
    { type: "quote",html: "<strong>À noter :</strong> le panneau de risque de Tradovate se trouve sous <em>Application Settings &rsaquo; Accounts &rsaquo; Risk Settings</em>, et le contrôle à utiliser est <em>Products Permitted</em>. L'emplacement exact des boutons, le libellé de l'étiquette et le comportement de la recherche d'ajout de produit peuvent varier légèrement selon la version de la plateforme et selon que le compte est géré par une prop firm ; vérifiez donc sur votre propre écran avant de modifier quoi que ce soit." },
    { type: "heading",text: "Solution C : Comptes prop / d'évaluation (vous ne pouvez pas modifier vous-même)" },
    { type: "paragraph",html: "Sur un compte prop d'évaluation ou financé, la liste des produits autorisés appartient à la firme, et les contrôles dans Tradovate seront grisés ou ignorés. Pour négocier un produit qui est rejeté :" },
    {
      type: "steps",
      items: [
        { title: "Consultez les règles de la firme", html: "Consultez les règles de la firme sur les produits que son programme autorise, certaines se limitent aux contrats sur indices et bloquent l'énergie, les métaux ou les cryptos." },
        { title: "Changez de produit ou contactez le support", html: "Si votre produit ne figure pas dans l'ensemble approuvé de la firme, négociez-en un qui y figure, ou contactez le support de la firme pour demander s'il peut être ajouté." },
        { title: "Ne le contournez pas dans Tradovate", html: "Sur certains programmes, modifier les paramètres de risque peut lui-même déclencher un signalement de conformité. Passez par la firme." },
      ],
    },
    { type: "heading",text: "Solution D : Surveillez l'état de verrouillage avant de modifier quoi que ce soit" },
    { type: "paragraph",html: "Tradovate peut verrouiller les paramètres de risque une fois qu'un compte atteint une limite, et si ce verrouillage est actif, vos modifications ne seront prises en compte qu'au début de la prochaine session de trading (environ la fenêtre de réinitialisation de 17h00&ndash;18h00 ET). Il y a aussi un avertissement plus important : un profil de risque verrouillé manuellement est volontairement difficile à rétablir, et le support de Tradovate ne peut pas simplement le déverrouiller pour vous. Avant de verrouiller une liste étroite de produits autorisés, assurez-vous donc que c'est bien la liste avec laquelle vous voulez vivre." },
    { type: "heading",text: "Tableau de dépannage" },
    { type: "table", headers: ["Symptôme","Signification","Solution"], rows: [
      ["La raison du rejet fait référence au produit, pas à la taille ni aux fonds","Products Permitted est activé et le symbole n'est pas listé","Ajoutez le produit à la liste, ou désactivez le filtre"],
      ["Un seul produit se négocie ; tout le reste est rejeté","La liste autorisée contient un seul produit","Ajoutez les autres produits souhaités, ou désactivez Products Permitted"],
      ["Micro (<code>MNQ</code>) rejeté alors que le mini (<code>NQ</code>) est autorisé","Micro et mini sont des produits distincts dans la liste","Ajoutez le produit micro/mini précis que vous négociez"],
      ["Le contrôle Products Permitted est grisé","Le compte est prop/évaluation ; la firme détient la liste","Consultez les produits autorisés de la firme ou contactez son support"],
      ["Vos modifications ne s'enregistrent pas","Les paramètres de risque sont verrouillés pour la session","Attendez la prochaine réinitialisation de session, puis modifiez"],
      ["Le rejet mentionne un contrat proche de l'expiration ou continu","Un problème de roulement, pas un filtre de produit","Passez plutôt au contrat actif du mois le plus proche"],
    ] },
    { type: "heading",text: "Évitez-le avec PickMyTrade" },
    { type: "paragraph",html: "Si le rejet touche des ordres <strong class='text-white'>automatisés</strong>, une alerte TradingView, un bot ou une stratégie copiée qui tire un produit que votre compte n'accepte pas, la solution la plus propre consiste à s'assurer que le bon symbole part dès le départ. PickMyTrade se place entre votre alerte et Tradovate et façonne chaque ordre avant son routage :" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Association de symboles</strong>, traduisez le ticker d'une stratégie en symbole de produit Tradovate exact, afin qu'une alerte atterrisse sur l'instrument que votre compte est réellement configuré pour négocier.",
        "<strong class='text-white'>Validation de symboles</strong>, vérifiez le contrat de chaque alerte entrante avant son envoi, pour qu'un signal égaré ou portant sur le mauvais produit ne soit pas projeté en boucle contre un mur de produits autorisés.",
        "<strong class='text-white'>Dimensionnement fixe &amp; filtres de risque</strong>, maintenez la quantité et l'état du compte dans les règles pour lesquelles vous êtes autorisé, afin que la même alerte ne déclenche pas un plafond de taille juste après que vous avez réglé le problème du produit.",
        "<strong class='text-white'>Routage multi-comptes</strong>, envoyez une alerte à plusieurs comptes Tradovate, chacun avec sa propre configuration de produits, au lieu de tirer partout un symbole identique et d'encaisser des rejets sur les comptes qui ne l'autorisent pas.",
      ],
    },
    { type: "paragraph",html: "Le résultat : l'ordre qu'un filtre de produits autorisés aurait rejeté part sur l'instrument correct et autorisé et est routé proprement, de sorte que votre automatisation continue de fonctionner au lieu de rejeter silencieusement à chaque déclenchement." },
  ], it: [
    { type: "paragraph",html: "Invia un ordine su ES o CL, e Tradovate lo rimanda subito indietro con un rifiuto che indica che il <strong class='text-white'>prodotto stesso</strong> non è consentito sul conto. Non c'è nulla che non vada nella Sua dimensione, nel Suo margine o nella sessione, il contratto che sta cercando di negoziare semplicemente non è nella lista consentita del conto. Quella lista è un controllo di rischio di Tradovate chiamato <strong class='text-white'>Products Permitted</strong>, e quando è attivato, possono essere negoziati solo i prodotti che ha aggiunto esplicitamente. Tutto il resto viene rifiutato prima ancora di raggiungere la borsa. La soluzione è rapida: aggiunga il contratto alla lista Products Permitted oppure disattivi del tutto la restrizione." },
    {
      type: "checklist",
      heading: "Checklist rapida per un rifiuto «Products Permitted»",
      items: [
        "<strong class='text-white'>Legga il motivo del rifiuto.</strong> Indica il prodotto, non la Sua quantità o i Suoi fondi, un segnale che a bloccare è un filtro dei prodotti consentiti e non un limite di dimensione.",
        "<strong class='text-white'>Apra i Suoi Risk Settings.</strong> Application Settings &rsaquo; Accounts &rsaquo; Risk Settings, poi guardi <strong class='text-white'>Products Permitted</strong> per quel conto.",
        "<strong class='text-white'>Aggiunga il prodotto oppure disattivi il filtro.</strong> Cerchi il contratto (ad es. <code>ES</code>) e lo aggiunga alla lista, oppure disabiliti Products Permitted in modo che ogni prodotto sia negoziabile.",
        "<strong class='text-white'>Associ il prodotto, non il mese.</strong> La lista filtra per prodotto come <code>NQ</code> o <code>ES</code>, non per una specifica scadenza, quindi aggiunga l'intero prodotto.",
        "<strong class='text-white'>Micro e mini sono voci separate.</strong> Consentire <code>NQ</code> non consente automaticamente <code>MNQ</code>, aggiunga ciascuno di quelli che negozia davvero.",
        "<strong class='text-white'>Su un conto prop o di valutazione di solito non può modificarlo da solo.</strong> La società detiene la lista consentita; controlli i suoi prodotti ammessi o chieda al supporto.",
      ],
    },
    { type: "heading",text: "Che cosa significa il rifiuto «Products Permitted»" },
    { type: "paragraph",html: "Si tratta di un <strong class='text-white'>controllo di rischio</strong>, non di un problema di mercato o di connettività. Products Permitted è una lista consentita per conto all'interno dei Risk Settings di Tradovate. Quando è attivata, Lei dice al conto: negozia solo questi prodotti specifici. Qualsiasi ordine per un contratto che non è nella lista viene rifiutato <em>pre-trade</em> e non viene mai instradato alla borsa. Quindi, se la lista contiene solo NQ e Lei spara un ordine ES, ES viene respinto. Il conto sta facendo esattamente ciò per cui è stato configurato." },
    { type: "paragraph",html: "Questa è la differenza chiave rispetto agli altri rifiuti che in superficie sembrano simili. Un rimbalzo per &ldquo;maximum order quantity&rdquo; riguarda <em>quanti</em> contratti ha inviato. Un rimbalzo per &ldquo;insufficient margin&rdquo; riguarda il <em>denaro</em>. Un rimbalzo per Products Permitted riguarda <em>quale strumento</em> ha provato a negoziare. Una volta che sa che si tratta del filtro dei prodotti, la soluzione è mirata e veloce, modifica una lista o aziona un interruttore." },
    { type: "paragraph",html: "Un'altra cosa da fissare subito: questo filtro opera a livello di <strong class='text-white'>prodotto</strong>. La lista è costruita a partire da prodotti come NQ, ES o CL, non da una singola scadenza come ESU5. Aggiunga un prodotto e il suo contratto attivo è coperto. Se invece il Suo rifiuto riguarda un contratto in scadenza o un simbolo continuo, è un problema di rollover, non un problema di Products Permitted, e richiede una soluzione diversa." },
    { type: "heading",text: "Cause principali del rifiuto «Products Permitted»" },
    { type: "heading",text: "1. La lista consentita è attiva e il Suo simbolo non è presente (il più comune)" },
    { type: "paragraph",html: "Il caso quotidiano: a un certo punto Products Permitted è stato attivato sul conto con una breve lista di prodotti, e ora sta cercando di negoziare qualcosa al di fuori. Forse l'ha impostato mesi fa per mantenere la disciplina su un solo strumento, oppure un modello di rischio salvato l'ha riportato. Il contratto che desidera è perfettamente negoziabile, semplicemente non è ancora nella lista approvata del Suo conto." },
    { type: "heading",text: "2. Ha limitato il conto a un solo prodotto e se n'è dimenticato" },
    { type: "paragraph",html: "I trader che vogliono forzare la concentrazione a volte consentono solo il loro strumento principale, per esempio NQ, così un momento di noia non si trasforma in uno scalp casuale su CL. È una protezione intelligente fino al giorno in cui vuole legittimamente negoziare un secondo prodotto e dimentica che il blocco c'è. Il rifiuto è la Sua stessa impostazione passata che parla." },
    { type: "heading",text: "3. Una prop firm ha limitato il conto a prodotti specifici" },
    { type: "paragraph",html: "I conti di valutazione e finanziati spesso arrivano con un insieme fisso di prodotti negoziabili integrato nel profilo di rischio della società. Alcuni programmi consentono l'intero listino dei futures; altri La limitano, per esempio, ai futures sugli indici azionari ed escludono energia, metalli o criptovalute. I prodotti consentiti variano in base alla società e al tipo di conto, quindi consulti le regole attuali della Sua società invece di dare per scontato. Su questi conti la lista consentita è della società, non Sua." },
    { type: "heading",text: "4. Micro contro mini, simboli simili, prodotti separati" },
    { type: "paragraph",html: "Ecco la trappola in cui cadono chi pensa di aver già aggiunto il proprio strumento. Nel selettore dei prodotti consentiti, un micro e il suo mini sono tipicamente <strong class='text-white'>voci separate</strong>. Consenta <code>NQ</code> e il Suo ordine MNQ può ancora essere rifiutato, perché <code>MNQ</code> è un prodotto a sé. Se negozia entrambe le dimensioni, devono essere presenti entrambe nella lista. Confermi le voci esatte sul Suo schermo, poiché il modo in cui i prodotti sono raggruppati può cambiare tra le versioni della piattaforma." },
    { type: "heading",text: "5. Una strategia automatizzata invia un prodotto fuori dall'insieme" },
    { type: "paragraph",html: "Se i rifiuti provengono da un bot, da un alert di TradingView o da una strategia copiata, il colpevole è spesso una discrepanza di simbolo: la strategia spara un prodotto per cui il Suo conto non è mai stato configurato. Un alert sullo strumento sbagliato e il filtro dei prodotti consentiti lo rifiuta a ogni attivazione, il che può sembrare un'automazione guasta quando in realtà è un problema di una riga nella lista." },
    { type: "heading",text: "Come correggere il rifiuto «Products Permitted»: passo dopo passo" },
    { type: "heading",text: "Soluzione A: aggiungere il prodotto alla lista consentita (conti che controlla)" },
    { type: "paragraph",html: "Se il conto è Suo da configurare, un conto personale reale o demo anziché un conto prop bloccato, aggiunga il contratto alla lista consentita:" },
    {
      type: "steps",
      items: [
        { title: "Apra Application Settings", html: "Apra <strong class='text-white'>Application Settings</strong> dal menu in alto a destra in Tradovate Trader (web o desktop)." },
        { title: "Vada su Accounts, poi su Risk Settings", html: "Vada alla scheda <strong class='text-white'>Accounts</strong> e apra <strong class='text-white'>Risk Settings</strong> per il conto." },
        { title: "Trovi Products Permitted", html: "Se è già attivato, vedrà la lista consentita attuale dei prodotti." },
        { title: "Cerchi e aggiunga il prodotto", html: "Usi la sua casella di ricerca per cercare il prodotto desiderato (digiti <code>ES</code>, <code>CL</code>, <code>MNQ</code>, qualunque cosa negozi) e lo selezioni per aggiungerlo." },
        { title: "Salvi e reinvii", html: "Salvi, poi reinvii il Suo ordine." },
      ],
    },
    { type: "heading",text: "Soluzione B: disattivare del tutto la restrizione" },
    { type: "paragraph",html: "Se non vuole alcuna lista di prodotti consentiti e preferisce negoziare liberamente l'intero listino, disabiliti semplicemente il filtro:" },
    {
      type: "steps",
      items: [
        { title: "Apra Risk Settings", html: "Apra lo stesso pannello <strong class='text-white'>Application Settings &rsaquo; Accounts &rsaquo; Risk Settings</strong>." },
        { title: "Disattivi Products Permitted", html: "Trovi <strong class='text-white'>Products Permitted</strong> e porti il controllo su <strong class='text-white'>off</strong>." },
        { title: "Salvi", html: "Senza una lista consentita applicata, qualsiasi prodotto negoziabile sul conto viene instradato normalmente." },
      ],
    },
    { type: "quote",html: "<strong>Attenzione:</strong> il pannello di rischio di Tradovate si trova in <em>Application Settings &rsaquo; Accounts &rsaquo; Risk Settings</em>, e il controllo che Le serve è <em>Products Permitted</em>. L'esatta posizione dei pulsanti, la dicitura dell'etichetta e il comportamento della ricerca per l'aggiunta dei prodotti possono variare leggermente in base alla versione della piattaforma e al fatto che il conto sia gestito da una prop firm, quindi verifichi sul Suo schermo prima di modificare qualsiasi cosa." },
    { type: "heading",text: "Soluzione C: conti prop / di valutazione (non può modificare da solo)" },
    { type: "paragraph",html: "Su un conto prop di valutazione o finanziato, la lista dei prodotti consentiti appartiene alla società e i controlli in Tradovate saranno disattivati o ignorati. Per negoziare un prodotto che viene rifiutato:" },
    {
      type: "steps",
      items: [
        { title: "Controlli le regole della società", html: "Controlli le regole della società su quali prodotti il suo programma consente, alcune si limitano ai futures sugli indici e bloccano energia, metalli o criptovalute." },
        { title: "Cambi prodotto o chieda al supporto", html: "Se il Suo prodotto non è nell'insieme approvato dalla società, ne negozi uno che lo è, oppure contatti il supporto della società per chiedere se può essere aggiunto." },
        { title: "Non lo sovrascriva in Tradovate", html: "In alcuni programmi, modificare le impostazioni di rischio può di per sé far scattare una segnalazione di conformità. Passi dalla società." },
      ],
    },
    { type: "heading",text: "Soluzione D: controlli lo stato di blocco prima di modificare qualsiasi cosa" },
    { type: "paragraph",html: "Tradovate può bloccare le impostazioni di rischio quando un conto raggiunge un limite e, se tale blocco è attivo, le Sue modifiche non saranno applicate fino all'inizio della sessione di negoziazione successiva (circa la finestra di reset 17:00&ndash;18:00 ET). C'è anche un avviso più importante: un profilo di rischio bloccato manualmente è volutamente difficile da ripristinare, e il supporto di Tradovate non può semplicemente sbloccarlo per Lei. Quindi, prima di bloccare una lista ristretta di prodotti consentiti, si assicuri che sia la lista con cui vuole davvero convivere." },
    { type: "heading",text: "Tabella di risoluzione dei problemi" },
    { type: "table", headers: ["Sintomo","Significato","Soluzione"], rows: [
      ["Il motivo del rifiuto fa riferimento al prodotto, non a dimensione o fondi","Products Permitted è attivo e il simbolo non è elencato","Aggiunga il prodotto alla lista oppure disattivi il filtro"],
      ["Si negozia un solo prodotto; tutto il resto viene rifiutato","La lista consentita contiene un solo prodotto","Aggiunga gli altri prodotti desiderati oppure disattivi Products Permitted"],
      ["Micro (<code>MNQ</code>) rifiutato mentre il mini (<code>NQ</code>) è consentito","Micro e mini sono prodotti separati nella lista","Aggiunga lo specifico prodotto micro/mini che negozia"],
      ["Il controllo Products Permitted è disattivato","Il conto è prop/valutazione; la società detiene la lista","Controlli i prodotti consentiti dalla società o contatti il suo supporto"],
      ["Le Sue modifiche non vengono salvate","Le impostazioni di rischio sono bloccate per la sessione","Attenda il prossimo reset di sessione, poi modifichi"],
      ["Il rifiuto menziona un contratto in scadenza o continuo","Un problema di rollover, non un filtro di prodotto","Passi invece al contratto attivo del mese più vicino"],
    ] },
    { type: "heading",text: "Lo eviti con PickMyTrade" },
    { type: "paragraph",html: "Se il rifiuto colpisce ordini <strong class='text-white'>automatizzati</strong>, un alert di TradingView, un bot o una strategia copiata che spara un prodotto che il Suo conto non accetta, la soluzione più pulita è assicurarsi che parta fin dall'inizio il simbolo giusto. PickMyTrade si pone tra il Suo alert e Tradovate e modella ogni ordine prima che venga instradato:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Mappatura dei simboli</strong>, traduca il ticker di una strategia nell'esatto simbolo del prodotto Tradovate, così un alert arriva sullo strumento che il Suo conto è effettivamente configurato per negoziare.",
        "<strong class='text-white'>Validazione dei simboli</strong>, controlli il contratto di ogni alert in arrivo prima che venga inviato, così un segnale errante o di un prodotto sbagliato non viene scagliato ripetutamente contro un muro di prodotti consentiti.",
        "<strong class='text-white'>Dimensionamento fisso &amp; filtri di rischio</strong>, mantenga quantità e stato del conto entro le regole per cui è autorizzato, così lo stesso alert non fa scattare un limite di dimensione subito dopo che ha risolto quello del prodotto.",
        "<strong class='text-white'>Instradamento multi-account</strong>, invii un alert a più conti Tradovate, ciascuno con la propria configurazione dei prodotti, invece di sparare ovunque un simbolo identico e incassare rifiuti sui conti che non lo consentono.",
      ],
    },
    { type: "paragraph",html: "Il risultato: l'ordine che un filtro dei prodotti consentiti avrebbe respinto parte sullo strumento corretto e consentito e viene instradato in modo pulito, così la Sua automazione continua a funzionare invece di rifiutare in silenzio a ogni attivazione." },
  ] },
  ctaHeading: { en: "Route Every Alert to the Right Contract", de: "Routen Sie jeden Alert zum richtigen Kontrakt", es: "Dirija cada alerta al contrato correcto", fr: "Routez chaque alerte vers le bon contrat", it: "Instradi ogni alert sul contratto giusto" },
  ctaText: { en: "Start your free trial, map and validate every alert so your orders route to the right contract, every time.", de: "Starten Sie Ihre kostenlose Testphase, ordnen Sie jeden Alert zu und validieren Sie ihn, damit Ihre Orders jedes Mal zum richtigen Kontrakt geroutet werden.", es: "Comience su prueba gratuita, asigne y valide cada alerta para que sus órdenes se dirijan siempre al contrato correcto.", fr: "Commencez votre essai gratuit, associez et validez chaque alerte pour que vos ordres soient routés vers le bon contrat, à chaque fois.", it: "Inizi la prova gratuita, mappi e convalidi ogni alert in modo che i Suoi ordini vengano instradati sul contratto giusto, ogni volta." },
  ctaButtonText: { en: "Start Your Free 7-Day Trial", de: "Starten Sie Ihre kostenlose 7-Tage-Testphase", es: "Comience su prueba gratuita de 7 días", fr: "Commencez votre essai gratuit de 7 jours", it: "Inizi la prova gratuita di 7 giorni" },
  ctaUrl: "https://app.pickmytrade.trade/?register=true&utm_source=content&utm_medium=debugging",
  faqHeading: { en: "Frequently Asked Questions", de: "Häufig gestellte Fragen", es: "Preguntas frecuentes", fr: "Questions fréquentes", it: "Domande frequenti" },
  faqs: { en: [
    { q: "What does a Products Permitted rejection mean in Tradovate?", a: "It's a pre-trade risk rejection. Your account has a Products Permitted allow-list turned on in Risk Settings, and the contract you tried to trade isn't on that list. Tradovate refuses the order before it reaches the exchange. Add the product to the list, or turn the restriction off, and the order routes." },
    { q: "Where is the Products Permitted setting in Tradovate?", a: "Open Application Settings from the top-right menu, go to the Accounts tab, and open Risk Settings for the account. Products Permitted is one of the risk controls listed there, alongside Max Position Size and the loss limits." },
    { q: "How do I add a contract to the Products Permitted list?", a: "In Application Settings > Accounts > Risk Settings, find Products Permitted. Make sure the control is enabled, then use its search box to look up the product (for example ES) and select it to add it to the allow-list. Save and resend your order." },
    { q: "How do I turn off Products Permitted so any contract trades?", a: "In the same Risk Settings panel, disable the Products Permitted control. With the filter off, no product allow-list is applied, so any tradable contract on the account routes normally." },
    { q: "Why is my Products Permitted setting greyed out?", a: "Because the account is managed by a prop firm or evaluation program. The firm owns the risk profile, including which products you can trade, so the in-platform control is disabled or overridden. Only the firm can change which products are permitted on that account." },
    { q: "Does Products Permitted block by product or by contract month?", a: "By product. The list is built from products like NQ or ES, not from a specific expiration month. Adding a product covers its active contract; a rejection tied to an expiring or continuous symbol is a separate rollover issue, not a Products Permitted block." },
    { q: "I permitted NQ but my micro MNQ still gets rejected. Why?", a: "The micro and the mini are usually separate products in the permitted-products picker, so allowing NQ does not automatically allow MNQ. Add each product you actually trade to the list, or disable the restriction, and confirm the entries against your own screen." },
    { q: "Can PickMyTrade stop these rejections on automated orders?", a: "Yes. PickMyTrade maps and validates the symbol on every incoming alert before it reaches Tradovate, so a strategy only sends products your account is set up to trade. That keeps a webhook or bot from firing a contract your Products Permitted list would bounce." },
  ], de: [
    { q: "Was bedeutet eine Products-Permitted-Ablehnung in Tradovate?", a: "Es ist eine Pre-Trade-Risikoablehnung. In den Risk Settings Ihres Kontos ist eine Positivliste „Products Permitted“ aktiviert, und der Kontrakt, den Sie handeln wollten, steht nicht auf dieser Liste. Tradovate lehnt die Order ab, bevor sie die Börse erreicht. Fügen Sie das Produkt zur Liste hinzu oder schalten Sie die Beschränkung ab, dann wird die Order geroutet." },
    { q: "Wo finde ich die Einstellung Products Permitted in Tradovate?", a: "Öffnen Sie Application Settings über das Menü oben rechts, wechseln Sie zum Tab Accounts und öffnen Sie Risk Settings für das Konto. Products Permitted ist eine der dort aufgeführten Risikokontrollen, neben Max Position Size und den Verlustlimits." },
    { q: "Wie füge ich einen Kontrakt zur Products-Permitted-Liste hinzu?", a: "Suchen Sie unter Application Settings > Accounts > Risk Settings den Eintrag Products Permitted. Stellen Sie sicher, dass das Steuerelement aktiviert ist, suchen Sie dann im Suchfeld das Produkt (zum Beispiel ES) und wählen Sie es aus, um es zur Positivliste hinzuzufügen. Speichern Sie und senden Sie Ihre Order erneut." },
    { q: "Wie schalte ich Products Permitted ab, damit jeder Kontrakt gehandelt werden kann?", a: "Deaktivieren Sie im selben Panel Risk Settings das Steuerelement Products Permitted. Ist der Filter aus, wird keine Produkt-Positivliste angewendet, sodass jeder handelbare Kontrakt des Kontos normal geroutet wird." },
    { q: "Warum ist meine Einstellung Products Permitted ausgegraut?", a: "Weil das Konto von einer Prop-Firma oder einem Evaluierungsprogramm verwaltet wird. Die Firma besitzt das Risikoprofil, einschließlich der Frage, welche Produkte Sie handeln dürfen, daher ist das Steuerelement in der Plattform deaktiviert oder wird überschrieben. Nur die Firma kann ändern, welche Produkte auf diesem Konto zulässig sind." },
    { q: "Blockiert Products Permitted nach Produkt oder nach Kontraktmonat?", a: "Nach Produkt. Die Liste besteht aus Produkten wie NQ oder ES, nicht aus einem bestimmten Verfallsmonat. Das Hinzufügen eines Produkts deckt dessen aktiven Kontrakt ab; eine Ablehnung wegen eines auslaufenden oder fortlaufenden Symbols ist ein separates Rollover-Problem, keine Products-Permitted-Sperre." },
    { q: "Ich habe NQ erlaubt, aber mein Micro MNQ wird trotzdem abgelehnt. Warum?", a: "Micro und Mini sind in der Auswahl der zulässigen Produkte meist getrennte Produkte, daher erlaubt NQ nicht automatisch MNQ. Fügen Sie jedes Produkt, das Sie tatsächlich handeln, zur Liste hinzu oder deaktivieren Sie die Beschränkung, und gleichen Sie die Einträge mit Ihrem eigenen Bildschirm ab." },
    { q: "Kann PickMyTrade diese Ablehnungen bei automatisierten Orders verhindern?", a: "Ja. PickMyTrade ordnet das Symbol jedes eingehenden Alerts zu und validiert es, bevor es Tradovate erreicht, sodass eine Strategie nur Produkte sendet, für deren Handel Ihr Konto eingerichtet ist. So verhindern Sie, dass ein Webhook oder Bot einen Kontrakt feuert, den Ihre Products-Permitted-Liste abweisen würde." },
  ], es: [
    { q: "¿Qué significa un rechazo de Products Permitted en Tradovate?", a: "Es un rechazo de riesgo previo a la operación. Su cuenta tiene activada en Risk Settings una lista de permitidos Products Permitted, y el contrato que intentó operar no está en esa lista. Tradovate rechaza la orden antes de que llegue al mercado. Añada el producto a la lista o desactive la restricción y la orden se enrutará." },
    { q: "¿Dónde está el ajuste Products Permitted en Tradovate?", a: "Abra Application Settings desde el menú superior derecho, vaya a la pestaña Accounts y abra Risk Settings de la cuenta. Products Permitted es uno de los controles de riesgo que aparecen allí, junto con Max Position Size y los límites de pérdida." },
    { q: "¿Cómo añado un contrato a la lista Products Permitted?", a: "En Application Settings > Accounts > Risk Settings, busque Products Permitted. Asegúrese de que el control esté activado, luego use su cuadro de búsqueda para encontrar el producto (por ejemplo ES) y selecciónelo para añadirlo a la lista de permitidos. Guarde y vuelva a enviar su orden." },
    { q: "¿Cómo desactivo Products Permitted para que cualquier contrato pueda operarse?", a: "En el mismo panel Risk Settings, desactive el control Products Permitted. Con el filtro apagado no se aplica ninguna lista de productos permitidos, por lo que cualquier contrato negociable de la cuenta se enruta con normalidad." },
    { q: "¿Por qué mi ajuste Products Permitted aparece en gris?", a: "Porque la cuenta la gestiona una prop firm o un programa de evaluación. La firma es dueña del perfil de riesgo, incluidos los productos que puede operar, por lo que el control dentro de la plataforma está deshabilitado o anulado. Solo la firma puede cambiar qué productos están permitidos en esa cuenta." },
    { q: "¿Products Permitted bloquea por producto o por mes de contrato?", a: "Por producto. La lista se construye con productos como NQ o ES, no con un mes de vencimiento concreto. Añadir un producto cubre su contrato activo; un rechazo vinculado a un símbolo a punto de vencer o continuo es un problema de renovación aparte, no un bloqueo de Products Permitted." },
    { q: "Permití NQ pero mi micro MNQ sigue rechazándose. ¿Por qué?", a: "El micro y el mini suelen ser productos distintos en el selector de productos permitidos, por lo que permitir NQ no permite automáticamente MNQ. Añada a la lista cada producto que realmente opere, o desactive la restricción, y confirme las entradas en su propia pantalla." },
    { q: "¿Puede PickMyTrade evitar estos rechazos en las órdenes automatizadas?", a: "Sí. PickMyTrade asigna y valida el símbolo de cada alerta entrante antes de que llegue a Tradovate, de modo que una estrategia solo envía productos que su cuenta está configurada para operar. Así evita que un webhook o un bot dispare un contrato que su lista Products Permitted rechazaría." },
  ], fr: [
    { q: "Que signifie un rejet Products Permitted dans Tradovate ?", a: "C'est un rejet de risque pré-trade. Votre compte a une liste autorisée Products Permitted activée dans Risk Settings, et le contrat que vous avez tenté de négocier n'y figure pas. Tradovate refuse l'ordre avant qu'il n'atteigne la bourse. Ajoutez le produit à la liste, ou désactivez la restriction, et l'ordre sera routé." },
    { q: "Où se trouve le paramètre Products Permitted dans Tradovate ?", a: "Ouvrez Application Settings depuis le menu en haut à droite, allez dans l'onglet Accounts et ouvrez Risk Settings pour le compte. Products Permitted est l'un des contrôles de risque qui y figurent, aux côtés de Max Position Size et des limites de perte." },
    { q: "Comment ajouter un contrat à la liste Products Permitted ?", a: "Dans Application Settings > Accounts > Risk Settings, trouvez Products Permitted. Assurez-vous que le contrôle est activé, puis utilisez sa zone de recherche pour trouver le produit (par exemple ES) et sélectionnez-le pour l'ajouter à la liste autorisée. Enregistrez et renvoyez votre ordre." },
    { q: "Comment désactiver Products Permitted pour que n'importe quel contrat puisse être négocié ?", a: "Dans le même panneau Risk Settings, désactivez le contrôle Products Permitted. Le filtre étant éteint, aucune liste de produits autorisés n'est appliquée, et tout contrat négociable du compte est routé normalement." },
    { q: "Pourquoi mon paramètre Products Permitted est-il grisé ?", a: "Parce que le compte est géré par une prop firm ou un programme d'évaluation. La firme détient le profil de risque, y compris les produits que vous pouvez négocier, si bien que le contrôle dans la plateforme est désactivé ou remplacé. Seule la firme peut modifier les produits autorisés sur ce compte." },
    { q: "Products Permitted bloque-t-il par produit ou par mois de contrat ?", a: "Par produit. La liste est construite à partir de produits comme NQ ou ES, et non d'un mois d'échéance précis. Ajouter un produit couvre son contrat actif ; un rejet lié à un symbole proche de l'expiration ou continu est un problème de roulement distinct, pas un blocage Products Permitted." },
    { q: "J'ai autorisé NQ mais mon micro MNQ est toujours rejeté. Pourquoi ?", a: "Le micro et le mini sont généralement des produits distincts dans le sélecteur de produits autorisés ; autoriser NQ n'autorise donc pas automatiquement MNQ. Ajoutez à la liste chaque produit que vous négociez réellement, ou désactivez la restriction, et vérifiez les entrées sur votre propre écran." },
    { q: "PickMyTrade peut-il empêcher ces rejets sur les ordres automatisés ?", a: "Oui. PickMyTrade associe et valide le symbole de chaque alerte entrante avant qu'elle n'atteigne Tradovate, de sorte qu'une stratégie n'envoie que des produits que votre compte est configuré pour négocier. Cela évite qu'un webhook ou un bot ne tire un contrat que votre liste Products Permitted rejetterait." },
  ], it: [
    { q: "Che cosa significa un rifiuto Products Permitted in Tradovate?", a: "È un rifiuto di rischio pre-trade. Il Suo conto ha una lista consentita Products Permitted attivata in Risk Settings, e il contratto che ha provato a negoziare non è in quella lista. Tradovate rifiuta l'ordine prima che raggiunga la borsa. Aggiunga il prodotto alla lista, oppure disattivi la restrizione, e l'ordine verrà instradato." },
    { q: "Dove si trova l'impostazione Products Permitted in Tradovate?", a: "Apra Application Settings dal menu in alto a destra, vada alla scheda Accounts e apra Risk Settings per il conto. Products Permitted è uno dei controlli di rischio elencati lì, insieme a Max Position Size e ai limiti di perdita." },
    { q: "Come aggiungo un contratto alla lista Products Permitted?", a: "In Application Settings > Accounts > Risk Settings, trovi Products Permitted. Si assicuri che il controllo sia attivato, poi usi la sua casella di ricerca per cercare il prodotto (per esempio ES) e lo selezioni per aggiungerlo alla lista consentita. Salvi e reinvii il Suo ordine." },
    { q: "Come disattivo Products Permitted in modo che qualsiasi contratto possa essere negoziato?", a: "Nello stesso pannello Risk Settings, disabiliti il controllo Products Permitted. Con il filtro disattivato non viene applicata alcuna lista di prodotti consentiti, quindi qualsiasi contratto negoziabile sul conto viene instradato normalmente." },
    { q: "Perché l'impostazione Products Permitted è disattivata?", a: "Perché il conto è gestito da una prop firm o da un programma di valutazione. La società detiene il profilo di rischio, compresi i prodotti che può negoziare, quindi il controllo nella piattaforma è disabilitato o sovrascritto. Solo la società può modificare quali prodotti sono consentiti su quel conto." },
    { q: "Products Permitted blocca per prodotto o per mese di contratto?", a: "Per prodotto. La lista è costruita a partire da prodotti come NQ o ES, non da uno specifico mese di scadenza. Aggiungere un prodotto copre il suo contratto attivo; un rifiuto legato a un simbolo in scadenza o continuo è un problema di rollover separato, non un blocco Products Permitted." },
    { q: "Ho consentito NQ ma il mio micro MNQ viene comunque rifiutato. Perché?", a: "Il micro e il mini sono di solito prodotti separati nel selettore dei prodotti consentiti, quindi consentire NQ non consente automaticamente MNQ. Aggiunga alla lista ogni prodotto che negozia davvero, oppure disattivi la restrizione, e confermi le voci sul Suo schermo." },
    { q: "PickMyTrade può evitare questi rifiuti sugli ordini automatizzati?", a: "Sì. PickMyTrade mappa e convalida il simbolo di ogni alert in arrivo prima che raggiunga Tradovate, così una strategia invia solo prodotti che il Suo conto è configurato per negoziare. Questo impedisce a un webhook o a un bot di sparare un contratto che la Sua lista Products Permitted rifiuterebbe." },
  ] },
