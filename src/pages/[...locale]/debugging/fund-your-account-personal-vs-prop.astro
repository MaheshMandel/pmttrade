---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "fund-your-account-personal-vs-prop";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/debugging/${SLUG}`;

const META_TITLE = "Tradovate 'Fund Your Account' on Prop Login Fix";
const META_DESCRIPTION =
  "Tradovate 'Fund Your Account' on a prop login? Sign in with your firm's evaluation credentials so the funded account shows up instantly.";

// Short SEO title (<=60 chars) for locales where the shared h1 is too long for a SERP title.
const TITLE_OVERRIDE: Partial<Record<Locale, string>> = { es: "Tradovate “Fund Your Account” con login de prop firm", fr: "Tradovate « Fund Your Account » avec connexion prop firm", it: "Tradovate “Fund Your Account” con login prop firm" };

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Tradovate 'Fund Your Account' beim Prop-Login beheben", es: "Solución a 'Fund Your Account' de Tradovate con un login de prop firm", fr: "Corriger 'Fund Your Account' de Tradovate avec une connexion prop firm", it: "Come risolvere 'Fund Your Account' di Tradovate con un login prop firm" },
  dek: { en: "You cleared checkout on a prop evaluation and Tradovate is asking you to deposit money. Nothing's wrong, you're just signed into the wrong account. Here's the two-minute fix.", de: "Sie haben den Checkout für eine Prop-Evaluation abgeschlossen, und Tradovate fordert Sie auf, Geld einzuzahlen. Es ist nichts kaputt, Sie sind nur im falschen Konto angemeldet. Hier ist die Lösung in zwei Minuten.", es: "Completó el pago de una evaluación prop y Tradovate le pide que deposite dinero. No hay ningún problema, simplemente ha iniciado sesión en la cuenta equivocada. Aquí tiene la solución en dos minutos.", fr: "Vous avez terminé le paiement d'une évaluation prop et Tradovate vous demande de déposer de l'argent. Rien n'est cassé, vous êtes simplement connecté au mauvais compte. Voici la solution en deux minutes.", it: "Ha completato il checkout di una prop evaluation e Tradovate le chiede di depositare denaro. Non c'è alcun problema, ha semplicemente effettuato l'accesso all'account sbagliato. Ecco la soluzione in due minuti." },
  readTime: { en: "7 min read", de: "7 Minuten Lesezeit", es: "Lectura de 7 minutos", fr: "Lecture de 7 minutes", it: "Lettura di 7 minuti" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "You cleared checkout on a fresh prop evaluation, you open Tradovate to place your first trade, and instead of a funded balance and a live ladder, you get a <strong class='text-white'>&ldquo;Fund Your Account&rdquo;</strong> prompt asking you to deposit money. Take a breath. Nothing is broken, and you do <strong class='text-white'>not</strong> owe Tradovate a deposit. This is one of the most common first-login snags prop-firm traders hit, and it almost always comes down to one mix-up: you're signed in to the <em>wrong</em> Tradovate account. Your funded evaluation lives under the credentials your prop firm issued, not your personal Tradovate email, and not your prop-firm dashboard login. Here's exactly why the message shows up, how to clear it in under two minutes, and how automation like PickMyTrade keeps orders from ever firing into an empty account." },
    {
      type: "checklist",
      heading: "Quick Checklist for the “Fund Your Account” Prompt",
      items: [
        "<strong class='text-white'>Don't deposit a cent.</strong> A prop evaluation never needs your own money, the prompt is a false alarm, not a real funding requirement.",
        "<strong class='text-white'>Confirm which account you're in.</strong> The &ldquo;Fund Your Account&rdquo; screen means Tradovate loaded a personal or empty account, not your funded one.",
        "<strong class='text-white'>Use the firm's platform credentials.</strong> Log in with the trading username and password your prop firm issued (many firms use a <code>TRAD######</code>-style username), not your dashboard email.",
        "<strong class='text-white'>Pick the right environment.</strong> Evaluations and sim-funded accounts live on the Demo / Simulation side of the login, not Live.",
        "<strong class='text-white'>Log out fully first.</strong> Sign out of the personal account, and any second open session, before signing back in.",
        "<strong class='text-white'>Still empty after the correct login?</strong> The firm may not have provisioned the account yet, so contact your prop firm rather than Tradovate.",
      ],
    },
    { type: "heading", text: "What “Fund Your Account” Means" },
    { type: "paragraph", html: "Tradovate is both a brokerage <em>and</em> the trading platform that dozens of prop firms hand to their traders. When you open a brand-new <strong class='text-white'>personal</strong> Tradovate account with no deposit, the dashboard shows a &ldquo;Fund Your Account&rdquo; call-to-action nudging you to add money before you can trade a live balance. On a personal account, that's exactly right, the account genuinely has nothing in it." },
    { type: "paragraph", html: "A prop-firm evaluation or sim-funded account is a <em>separate</em> account entirely. The firm funds it with simulated capital and issues you dedicated login credentials for the Tradovate platform. Sign in with your own Tradovate email, or with the email and password you use for the firm's <em>dashboard</em> instead of the platform username the firm gave you, and Tradovate dutifully loads an account that has no balance, then asks you to fund it." },
    { type: "paragraph", html: "So the message isn't telling you your evaluation failed or vanished. It's telling you the account currently on screen is empty. The funded account isn't missing; you just aren't looking at it yet. Log in with the right credentials and it appears immediately." },
    { type: "heading", text: "Top Causes of “Fund Your Account” on a Prop Login" },
    { type: "heading", text: "1. You Logged In With Your Personal Tradovate Account" },
    { type: "paragraph", html: "If you've ever opened your own Tradovate account, even a free trial, your browser or app may auto-fill those saved credentials. Tradovate signs you into that personal account, sees no deposit, and shows the funding prompt. Your evaluation sits untouched under a different login." },
    { type: "heading", text: "2. You Used Your Prop-Firm Dashboard Email Instead of the Platform Username" },
    { type: "paragraph", html: "This is the single most frequent cause. Prop firms give you two sets of credentials that are easy to confuse:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Dashboard credentials</strong>, the email and password you registered with, used to log in to the firm's member portal where you buy evaluations, track rules, and request payouts.",
        "<strong class='text-white'>Platform credentials</strong>, a firm-issued trading username (Tradeify, for example, issues a <code>TRAD######</code>-format username) and a separate password, used only to log in to Tradovate itself.",
      ],
    },
    { type: "paragraph", html: "Type your dashboard email into the Tradovate login and it won't connect to your funded account, it either fails or drops you onto an unrelated account, which is what triggers the &ldquo;Fund Your Account&rdquo; screen." },
    { type: "heading", text: "3. You're on the Live Environment Instead of Demo / Simulation" },
    { type: "paragraph", html: "Most prop evaluations and sim-funded accounts run on Tradovate's simulated (Demo) environment, not Live. If the login environment toggle is set to Live, Tradovate looks for a live brokerage account you don't have, so it either can't find the evaluation or lands you on an empty account. The wording of this selector can change, so check the current label on the login screen." },
    { type: "heading", text: "4. The Evaluation Hasn't Been Provisioned Yet, or a Second Session Bumped You" },
    { type: "paragraph", html: "Right after purchase, there's often a short provisioning delay before the firm creates your Tradovate account. Log in too early and the account simply isn't there yet. Separately, Tradovate limits how many sessions you can hold at once, so a second open login, desktop plus TradingView, say, can knock you onto the wrong account state. Both resolve without any deposit; the specifics vary by firm, so check your firm's current onboarding rules." },
    { type: "heading", text: "How to Fix “Fund Your Account”: Step-by-Step" },
    {
      type: "steps",
      items: [
        { title: "Log out of Tradovate completely", html: "Sign out of the web, desktop, and mobile apps, and disconnect any TradingView broker link, so no stale personal session keeps you stuck on the empty account." },
        { title: "Open your prop firm's member dashboard and find the platform credentials", html: "Most firms display your Tradovate trading username and password on the dashboard, often near the top of the page or on the account/credentials panel. Copy the trading username (not your login email) and the firm-issued password." },
        { title: "Go to the Tradovate login and select the correct environment", html: "Open the Tradovate web trader (or the desktop/mobile app), and set the environment selector to Demo / Simulation for an evaluation or sim-funded account. Confirm the exact label on the current login screen before you sign in." },
        { title: "Enter the firm-issued username and password, then sign in", html: "Use the platform username you copied from the dashboard, and watch for capitalization, trailing spaces from a copy-paste, and caps lock. These credentials are typically fixed by the firm and can't be changed like a personal password." },
        { title: "Confirm the funded account now appears", html: "Once you're in, the funded evaluation should show in the account selector with its simulated balance, and the &ldquo;Fund Your Account&rdquo; prompt is gone. Select that account and you're ready to trade." },
      ],
    },
    { type: "heading", text: "If the Funded Account Still Doesn't Appear" },
    { type: "paragraph", html: "If you're certain you used the firm's platform credentials on the Demo environment and still see the funding prompt or an empty account:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Give provisioning time.</strong> Right after purchase, wait a short while and try again, the firm may still be creating the account behind the scenes. Provisioning windows vary by firm and product, so check your firm's current rules.",
        "<strong class='text-white'>Close every other session.</strong> Log out everywhere else (a second browser, the mobile app, a TradingView connection) so only one Tradovate session is active, then sign in fresh.",
        "<strong class='text-white'>Contact your prop firm, not Tradovate.</strong> Because the firm owns the evaluation account, only the firm can activate it, reset the trading password, or confirm it was created. Tradovate support can't restore or reissue an account it doesn't own.",
      ],
    },
    { type: "heading", text: "Troubleshooting Table" },
    {
      type: "table",
      headers: ["What you see", "What it means", "Fix"],
      rows: [
        ["&ldquo;Fund Your Account&rdquo; prompt after login", "You're on a personal or empty account, not the funded one", "Log out and sign in with the firm's platform credentials"],
        ["Login accepted but balance is $0 with a funding nudge", "Signed in with dashboard email instead of the trading username", "Use the TRAD######-style username from the firm dashboard"],
        ["Login rejected / &ldquo;Invalid Credentials&rdquo;", "Wrong username, wrong password, or wrong environment", "Re-copy the firm-issued username and password; pick Demo/Simulation"],
        ["Funded account missing right after purchase", "Evaluation not provisioned yet", "Wait for provisioning, then retry; contact the firm if it persists"],
        ["Bumped back to the wrong account randomly", "Too many active sessions", "Log out everywhere and keep a single Tradovate session"],
        ["Correct login, still no account", "Account not activated on the firm's side", "Contact the prop firm, only they can enable it"],
      ],
    },
    { type: "heading", text: "Prevent This with PickMyTrade" },
    { type: "paragraph", html: "Once you're on the right account, PickMyTrade links your TradingView alerts straight to that funded Tradovate account so you never trade blind:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Account-Aware Routing</strong>, orders map to the exact funded account you connected, so alerts can't leak into a personal or empty account.",
        "<strong class='text-white'>Connection &amp; Entitlement Checks</strong>, a broken or unauthorized broker link gets flagged before an alert tries to fire, instead of failing silently.",
        "<strong class='text-white'>Prop-Firm Risk Alignment</strong>, automation respects the evaluation's risk state so it plays by your firm's current rules.",
        "<strong class='text-white'>Multi-Account Sync</strong>, a validated order mirrors across every account you've connected, keeping copies in step.",
      ],
    },
  ], de: [
    { type: "paragraph", html: "Sie haben den Checkout für eine neue Prop-Evaluation abgeschlossen, öffnen Tradovate, um Ihren ersten Trade zu platzieren, und statt eines finanzierten Kontostands und einer Live-Ladder erhalten Sie eine <strong class='text-white'>&ldquo;Fund Your Account&rdquo;</strong>-Aufforderung, Geld einzuzahlen. Atmen Sie kurz durch. Es ist nichts kaputt, und Sie <strong class='text-white'>schulden</strong> Tradovate keine Einzahlung. Das ist eines der häufigsten Probleme, auf die Prop-Firm-Trader beim ersten Login stoßen, und es liegt fast immer an derselben Verwechslung: Sie sind im <em>falschen</em> Tradovate-Konto angemeldet. Ihre finanzierte Evaluation befindet sich unter den von Ihrer Prop-Firma ausgestellten Zugangsdaten, nicht unter Ihrer persönlichen Tradovate-E-Mail und nicht unter Ihrem Prop-Firm-Dashboard-Login. Hier erfahren Sie genau, warum diese Meldung erscheint, wie Sie sie in unter zwei Minuten beheben, und wie eine Automatisierung wie PickMyTrade verhindert, dass Orders jemals in ein leeres Konto ausgelöst werden." },
    {
      type: "checklist",
      heading: "Kurz-Checkliste für die Meldung &ldquo;Fund Your Account&rdquo;",
      items: [
        "<strong class='text-white'>Zahlen Sie keinen Cent ein.</strong> Eine Prop-Evaluation benötigt niemals Ihr eigenes Geld, die Aufforderung ist ein Fehlalarm, keine echte Finanzierungspflicht.",
        "<strong class='text-white'>Prüfen Sie, in welchem Konto Sie sich befinden.</strong> Der Bildschirm &ldquo;Fund Your Account&rdquo; bedeutet, dass Tradovate ein persönliches oder leeres Konto geladen hat, nicht Ihr finanziertes Konto.",
        "<strong class='text-white'>Verwenden Sie die Plattform-Zugangsdaten der Firma.</strong> Melden Sie sich mit dem Trading-Benutzernamen und dem Passwort an, die Ihre Prop-Firma ausgestellt hat (viele Firmen verwenden einen Benutzernamen im Format <code>TRAD######</code>), nicht mit Ihrer Dashboard-E-Mail.",
        "<strong class='text-white'>Wählen Sie die richtige Umgebung.</strong> Evaluationen und simuliert finanzierte Konten befinden sich auf der Demo-/Simulationsseite des Logins, nicht auf Live.",
        "<strong class='text-white'>Melden Sie sich zuerst vollständig ab.</strong> Melden Sie sich vom persönlichen Konto und jeder zweiten offenen Sitzung ab, bevor Sie sich erneut anmelden.",
        "<strong class='text-white'>Immer noch leer nach dem richtigen Login?</strong> Möglicherweise hat die Firma das Konto noch nicht bereitgestellt, kontaktieren Sie dann Ihre Prop-Firma und nicht Tradovate.",
      ],
    },
    { type: "heading", text: "Was &ldquo;Fund Your Account&rdquo; bedeutet" },
    { type: "paragraph", html: "Tradovate ist sowohl ein Broker <em>als auch</em> die Handelsplattform, die Dutzende von Prop-Firmen ihren Tradern zur Verfügung stellen. Wenn Sie ein brandneues <strong class='text-white'>persönliches</strong> Tradovate-Konto ohne Einzahlung öffnen, zeigt das Dashboard eine &ldquo;Fund Your Account&rdquo;-Aufforderung, die Sie dazu auffordert, Geld einzuzahlen, bevor Sie mit einem Live-Guthaben handeln können. Bei einem persönlichen Konto ist das genau richtig, das Konto enthält tatsächlich nichts." },
    { type: "paragraph", html: "Ein Prop-Firm-Evaluationskonto oder ein simuliert finanziertes Konto ist ein <em>komplett separates</em> Konto. Die Firma finanziert es mit simuliertem Kapital und stellt Ihnen eigene Zugangsdaten für die Tradovate-Plattform aus. Melden Sie sich mit Ihrer eigenen Tradovate-E-Mail an, oder mit der E-Mail und dem Passwort, die Sie für das <em>Dashboard</em> der Firma statt des von der Firma vergebenen Plattform-Benutzernamens verwenden, lädt Tradovate brav ein Konto ohne Guthaben und fordert Sie dann zur Einzahlung auf." },
    { type: "paragraph", html: "Die Meldung sagt also nicht, dass Ihre Evaluation fehlgeschlagen ist oder verschwunden ist. Sie sagt Ihnen, dass das aktuell angezeigte Konto leer ist. Das finanzierte Konto fehlt nicht, Sie schauen es sich nur noch nicht an. Melden Sie sich mit den richtigen Zugangsdaten an, und es erscheint sofort." },
    { type: "heading", text: "Häufigste Ursachen für &ldquo;Fund Your Account&rdquo; bei einem Prop-Login" },
    { type: "heading", text: "1. Sie haben sich mit Ihrem persönlichen Tradovate-Konto angemeldet" },
    { type: "paragraph", html: "Wenn Sie jemals ein eigenes Tradovate-Konto eröffnet haben, selbst eine kostenlose Testversion, kann Ihr Browser oder Ihre App diese gespeicherten Zugangsdaten automatisch ausfüllen. Tradovate meldet Sie in diesem persönlichen Konto an, sieht keine Einzahlung und zeigt die Finanzierungsaufforderung. Ihre Evaluation bleibt unter einem anderen Login unangetastet." },
    { type: "heading", text: "2. Sie haben Ihre Prop-Firm-Dashboard-E-Mail statt des Plattform-Benutzernamens verwendet" },
    { type: "paragraph", html: "Das ist die mit Abstand häufigste Ursache. Prop-Firmen geben Ihnen zwei Sätze von Zugangsdaten, die leicht zu verwechseln sind:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Dashboard-Zugangsdaten</strong>, die E-Mail und das Passwort, mit denen Sie sich registriert haben, verwendet zur Anmeldung im Mitgliederportal der Firma, wo Sie Evaluationen kaufen, Regeln verfolgen und Auszahlungen beantragen.",
        "<strong class='text-white'>Plattform-Zugangsdaten</strong>, ein von der Firma vergebener Trading-Benutzername (Tradeify vergibt zum Beispiel einen Benutzernamen im Format <code>TRAD######</code>) und ein separates Passwort, nur zur Anmeldung bei Tradovate selbst verwendet.",
      ],
    },
    { type: "paragraph", html: "Geben Sie Ihre Dashboard-E-Mail in den Tradovate-Login ein, verbindet sie sich nicht mit Ihrem finanzierten Konto, sie schlägt entweder fehl oder landet auf einem unzusammenhängenden Konto, was genau die &ldquo;Fund Your Account&rdquo;-Meldung auslöst." },
    { type: "heading", text: "3. Sie befinden sich in der Live-Umgebung statt in Demo/Simulation" },
    { type: "paragraph", html: "Die meisten Prop-Evaluationen und simuliert finanzierten Konten laufen in Tradovates simulierter (Demo-)Umgebung, nicht auf Live. Ist der Umgebungsschalter beim Login auf Live gestellt, sucht Tradovate nach einem Live-Broker-Konto, das Sie nicht haben, sodass es entweder die Evaluation nicht findet oder Sie auf einem leeren Konto landen. Die Bezeichnung dieses Auswahlfelds kann sich ändern, prüfen Sie daher die aktuelle Beschriftung auf dem Login-Bildschirm." },
    { type: "heading", text: "4. Die Evaluation wurde noch nicht bereitgestellt, oder eine zweite Sitzung hat Sie verdrängt" },
    { type: "paragraph", html: "Direkt nach dem Kauf gibt es oft eine kurze Bereitstellungsverzögerung, bevor die Firma Ihr Tradovate-Konto erstellt. Melden Sie sich zu früh an, existiert das Konto einfach noch nicht. Unabhängig davon begrenzt Tradovate, wie viele Sitzungen Sie gleichzeitig halten können, sodass ein zweiter offener Login, etwa Desktop plus TradingView, Sie auf den falschen Kontostatus verdrängen kann. Beides lässt sich ohne Einzahlung lösen; die Details variieren je nach Firma, prüfen Sie daher die aktuellen Onboarding-Regeln Ihrer Firma." },
    { type: "heading", text: "So beheben Sie &ldquo;Fund Your Account&rdquo;: Schritt für Schritt" },
    {
      type: "steps",
      items: [
        { title: "Melden Sie sich vollständig von Tradovate ab", html: "Melden Sie sich von der Web-, Desktop- und Mobil-App ab und trennen Sie jede TradingView-Broker-Verbindung, damit keine veraltete persönliche Sitzung Sie im leeren Konto festhält." },
        { title: "Öffnen Sie das Mitgliederdashboard Ihrer Prop-Firma und suchen Sie die Plattform-Zugangsdaten", html: "Die meisten Firmen zeigen Ihren Tradovate-Trading-Benutzernamen und das Passwort im Dashboard an, oft oben auf der Seite oder im Konto-/Zugangsdaten-Panel. Kopieren Sie den Trading-Benutzernamen (nicht Ihre Login-E-Mail) und das von der Firma vergebene Passwort." },
        { title: "Gehen Sie zum Tradovate-Login und wählen Sie die richtige Umgebung", html: "Öffnen Sie den Tradovate-Web-Trader (oder die Desktop-/Mobil-App) und stellen Sie den Umgebungsschalter für eine Evaluation oder ein simuliert finanziertes Konto auf Demo/Simulation. Bestätigen Sie die genaue Bezeichnung auf dem aktuellen Login-Bildschirm, bevor Sie sich anmelden." },
        { title: "Geben Sie den von der Firma vergebenen Benutzernamen und das Passwort ein und melden Sie sich an", html: "Verwenden Sie den Plattform-Benutzernamen, den Sie aus dem Dashboard kopiert haben, und achten Sie auf Groß-/Kleinschreibung, nachgestellte Leerzeichen durch Copy-Paste und die Feststelltaste. Diese Zugangsdaten sind in der Regel von der Firma festgelegt und lassen sich nicht wie ein persönliches Passwort ändern." },
        { title: "Bestätigen Sie, dass das finanzierte Konto nun erscheint", html: "Sobald Sie angemeldet sind, sollte die finanzierte Evaluation mit ihrem simulierten Guthaben in der Kontenauswahl erscheinen, und die &ldquo;Fund Your Account&rdquo;-Meldung ist verschwunden. Wählen Sie dieses Konto aus, und Sie sind bereit zu handeln." },
      ],
    },
    { type: "heading", text: "Wenn das finanzierte Konto weiterhin nicht erscheint" },
    { type: "paragraph", html: "Wenn Sie sicher sind, dass Sie die Plattform-Zugangsdaten der Firma in der Demo-Umgebung verwendet haben und weiterhin die Finanzierungsaufforderung oder ein leeres Konto sehen:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Geben Sie der Bereitstellung Zeit.</strong> Warten Sie direkt nach dem Kauf kurz und versuchen Sie es erneut, die Firma erstellt das Konto möglicherweise noch im Hintergrund. Die Bereitstellungszeiten variieren je nach Firma und Produkt, prüfen Sie daher die aktuellen Regeln Ihrer Firma.",
        "<strong class='text-white'>Schließen Sie jede andere Sitzung.</strong> Melden Sie sich überall sonst ab (ein zweiter Browser, die Mobil-App, eine TradingView-Verbindung), sodass nur eine Tradovate-Sitzung aktiv ist, und melden Sie sich dann neu an.",
        "<strong class='text-white'>Kontaktieren Sie Ihre Prop-Firma, nicht Tradovate.</strong> Da die Firma das Evaluationskonto besitzt, kann nur die Firma es aktivieren, das Trading-Passwort zurücksetzen oder bestätigen, dass es erstellt wurde. Der Tradovate-Support kann ein Konto, das ihm nicht gehört, nicht wiederherstellen oder neu ausstellen.",
      ],
    },
    { type: "heading", text: "Fehlerbehebungstabelle" },
    {
      type: "table",
      headers: ["Was Sie sehen", "Was es bedeutet", "Lösung"],
      rows: [
        ["Meldung &ldquo;Fund Your Account&rdquo; nach dem Login", "Sie befinden sich in einem persönlichen oder leeren Konto, nicht im finanzierten Konto", "Melden Sie sich ab und melden Sie sich mit den Plattform-Zugangsdaten der Firma an"],
        ["Login akzeptiert, aber Guthaben ist $0 mit Finanzierungshinweis", "Mit Dashboard-E-Mail statt Trading-Benutzernamen angemeldet", "Verwenden Sie den Benutzernamen im TRAD######-Format aus dem Firmen-Dashboard"],
        ["Login abgelehnt / &ldquo;Invalid Credentials&rdquo;", "Falscher Benutzername, falsches Passwort oder falsche Umgebung", "Kopieren Sie den von der Firma vergebenen Benutzernamen und das Passwort erneut; wählen Sie Demo/Simulation"],
        ["Finanziertes Konto fehlt direkt nach dem Kauf", "Evaluation noch nicht bereitgestellt", "Warten Sie auf die Bereitstellung und versuchen Sie es erneut; kontaktieren Sie die Firma, falls es anhält"],
        ["Zufällig zurück zum falschen Konto verdrängt", "Zu viele aktive Sitzungen", "Melden Sie sich überall ab und behalten Sie eine einzige Tradovate-Sitzung bei"],
        ["Korrekter Login, immer noch kein Konto", "Konto auf Seiten der Firma nicht aktiviert", "Kontaktieren Sie die Prop-Firma, nur sie kann es aktivieren"],
      ],
    },
    { type: "heading", text: "So verhindern Sie das mit PickMyTrade" },
    { type: "paragraph", html: "Sobald Sie im richtigen Konto sind, verknüpft PickMyTrade Ihre TradingView-Alerts direkt mit diesem finanzierten Tradovate-Konto, damit Sie nie blind handeln:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Kontobewusstes Routing</strong>, Orders werden exakt dem finanzierten Konto zugeordnet, mit dem Sie verbunden sind, sodass Alerts nicht in ein persönliches oder leeres Konto durchsickern können.",
        "<strong class='text-white'>Verbindungs- &amp; Berechtigungsprüfungen</strong>, eine defekte oder nicht autorisierte Broker-Verbindung wird erkannt, bevor ein Alert ausgelöst wird, statt stillschweigend zu scheitern.",
        "<strong class='text-white'>Prop-Firm-Risikoausrichtung</strong>, die Automatisierung respektiert den Risikostatus der Evaluation, sodass sie sich an die aktuellen Regeln Ihrer Firma hält.",
        "<strong class='text-white'>Multi-Konto-Synchronisierung</strong>, eine validierte Order wird über jedes verbundene Konto gespiegelt, sodass die Kopien synchron bleiben.",
      ],
    },
  ], es: [
    { type: "paragraph", html: "Completó el pago de una evaluación prop recién adquirida, abre Tradovate para colocar su primera operación y, en lugar de un saldo financiado y una ladder en vivo, recibe un aviso <strong class='text-white'>&ldquo;Fund Your Account&rdquo;</strong> que le pide depositar dinero. Respire hondo. No hay nada roto, y <strong class='text-white'>no</strong> le debe ningún depósito a Tradovate. Este es uno de los tropiezos más comunes en el primer inicio de sesión para los traders de prop firms, y casi siempre se reduce a una sola confusión: ha iniciado sesión en la cuenta <em>equivocada</em> de Tradovate. Su evaluación financiada vive bajo las credenciales que le emitió su prop firm, no bajo su correo personal de Tradovate ni bajo el inicio de sesión del panel de su prop firm. Aquí le explicamos exactamente por qué aparece este mensaje, cómo solucionarlo en menos de dos minutos, y cómo una automatización como PickMyTrade evita que las órdenes se disparen alguna vez hacia una cuenta vacía." },
    {
      type: "checklist",
      heading: "Lista rápida para el aviso &ldquo;Fund Your Account&rdquo;",
      items: [
        "<strong class='text-white'>No deposite ni un centavo.</strong> Una evaluación prop nunca necesita su propio dinero, el aviso es una falsa alarma, no un requisito real de financiamiento.",
        "<strong class='text-white'>Confirme en qué cuenta se encuentra.</strong> La pantalla &ldquo;Fund Your Account&rdquo; significa que Tradovate cargó una cuenta personal o vacía, no su cuenta financiada.",
        "<strong class='text-white'>Use las credenciales de la plataforma de la firma.</strong> Inicie sesión con el nombre de usuario y la contraseña de trading que le emitió su prop firm (muchas firmas usan un nombre de usuario con formato <code>TRAD######</code>), no con su correo del panel.",
        "<strong class='text-white'>Elija el entorno correcto.</strong> Las evaluaciones y cuentas financiadas por simulación viven en el lado Demo/Simulación del inicio de sesión, no en Live.",
        "<strong class='text-white'>Cierre sesión por completo primero.</strong> Cierre sesión en la cuenta personal, y en cualquier segunda sesión abierta, antes de volver a iniciar sesión.",
        "<strong class='text-white'>¿Sigue vacía tras el inicio de sesión correcto?</strong> Es posible que la firma aún no haya aprovisionado la cuenta, así que contacte a su prop firm en lugar de a Tradovate.",
      ],
    },
    { type: "heading", text: "Qué significa &ldquo;Fund Your Account&rdquo;" },
    { type: "paragraph", html: "Tradovate es tanto un bróker <em>como</em> la plataforma de trading que decenas de prop firms entregan a sus traders. Cuando abre una cuenta <strong class='text-white'>personal</strong> de Tradovate completamente nueva sin depósito, el panel muestra una llamada a la acción &ldquo;Fund Your Account&rdquo; que le anima a agregar dinero antes de poder operar con un saldo en vivo. En una cuenta personal, eso es exactamente correcto, la cuenta genuinamente no tiene nada." },
    { type: "paragraph", html: "Una cuenta de evaluación de prop firm o financiada por simulación es una cuenta <em>completamente separada</em>. La firma la financia con capital simulado y le emite credenciales de acceso dedicadas para la plataforma Tradovate. Si inicia sesión con su propio correo de Tradovate, o con el correo y la contraseña que usa para el <em>panel</em> de la firma en lugar del nombre de usuario de plataforma que le dio la firma, Tradovate carga fielmente una cuenta sin saldo y luego le pide que la financie." },
    { type: "paragraph", html: "Así que el mensaje no le está diciendo que su evaluación falló o desapareció. Le está diciendo que la cuenta actualmente en pantalla está vacía. La cuenta financiada no falta, simplemente aún no la está viendo. Inicie sesión con las credenciales correctas y aparecerá de inmediato." },
    { type: "heading", text: "Principales causas de &ldquo;Fund Your Account&rdquo; en un login de prop" },
    { type: "heading", text: "1. Inició sesión con su cuenta personal de Tradovate" },
    { type: "paragraph", html: "Si alguna vez abrió su propia cuenta de Tradovate, incluso una prueba gratuita, su navegador o app puede autocompletar esas credenciales guardadas. Tradovate le inicia sesión en esa cuenta personal, no ve depósito alguno y muestra el aviso de financiamiento. Su evaluación permanece intacta bajo un inicio de sesión distinto." },
    { type: "heading", text: "2. Usó el correo del panel de su prop firm en lugar del nombre de usuario de la plataforma" },
    { type: "paragraph", html: "Esta es la causa más frecuente con diferencia. Las prop firms le dan dos conjuntos de credenciales fáciles de confundir:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Credenciales del panel</strong>, el correo y la contraseña con los que se registró, usados para iniciar sesión en el portal de miembros de la firma, donde compra evaluaciones, sigue reglas y solicita pagos.",
        "<strong class='text-white'>Credenciales de plataforma</strong>, un nombre de usuario de trading emitido por la firma (Tradeify, por ejemplo, emite un nombre de usuario con formato <code>TRAD######</code>) y una contraseña separada, usados solo para iniciar sesión en Tradovate.",
      ],
    },
    { type: "paragraph", html: "Si escribe su correo del panel en el inicio de sesión de Tradovate, no conectará con su cuenta financiada, ya sea que falle o le lleve a una cuenta no relacionada, que es lo que activa la pantalla &ldquo;Fund Your Account&rdquo;." },
    { type: "heading", text: "3. Está en el entorno Live en lugar de Demo/Simulación" },
    { type: "paragraph", html: "La mayoría de las evaluaciones prop y cuentas financiadas por simulación funcionan en el entorno simulado (Demo) de Tradovate, no en Live. Si el selector de entorno del inicio de sesión está en Live, Tradovate busca una cuenta de bróker en vivo que usted no tiene, así que no encuentra la evaluación o le lleva a una cuenta vacía. La redacción de este selector puede cambiar, así que revise la etiqueta actual en la pantalla de inicio de sesión." },
    { type: "heading", text: "4. La evaluación aún no se ha aprovisionado, o una segunda sesión le desplazó" },
    { type: "paragraph", html: "Justo después de la compra, suele haber un breve retraso de aprovisionamiento antes de que la firma cree su cuenta de Tradovate. Si inicia sesión demasiado pronto, la cuenta simplemente aún no existe. Por separado, Tradovate limita cuántas sesiones puede mantener a la vez, así que un segundo inicio de sesión abierto, por ejemplo escritorio más TradingView, puede desplazarle a un estado de cuenta incorrecto. Ambos se resuelven sin ningún depósito; los detalles varían según la firma, así que revise las reglas de incorporación actuales de su firma." },
    { type: "heading", text: "Cómo solucionar &ldquo;Fund Your Account&rdquo;: paso a paso" },
    {
      type: "steps",
      items: [
        { title: "Cierre sesión por completo en Tradovate", html: "Cierre sesión en las apps web, de escritorio y móvil, y desconecte cualquier enlace de bróker de TradingView, para que ninguna sesión personal obsoleta le mantenga atascado en la cuenta vacía." },
        { title: "Abra el panel de miembros de su prop firm y localice las credenciales de plataforma", html: "La mayoría de las firmas muestran su nombre de usuario y contraseña de trading de Tradovate en el panel, a menudo cerca de la parte superior de la página o en el panel de cuenta/credenciales. Copie el nombre de usuario de trading (no su correo de inicio de sesión) y la contraseña emitida por la firma." },
        { title: "Vaya al inicio de sesión de Tradovate y seleccione el entorno correcto", html: "Abra el web trader de Tradovate (o la app de escritorio/móvil) y configure el selector de entorno en Demo/Simulación para una evaluación o cuenta financiada por simulación. Confirme la etiqueta exacta en la pantalla de inicio de sesión actual antes de iniciar sesión." },
        { title: "Introduzca el nombre de usuario y la contraseña emitidos por la firma, luego inicie sesión", html: "Use el nombre de usuario de plataforma que copió del panel, y esté atento a las mayúsculas, espacios al final por copiar y pegar, y el bloqueo de mayúsculas. Estas credenciales suelen ser fijadas por la firma y no pueden cambiarse como una contraseña personal." },
        { title: "Confirme que la cuenta financiada ahora aparece", html: "Una vez dentro, la evaluación financiada debería aparecer en el selector de cuentas con su saldo simulado, y el aviso &ldquo;Fund Your Account&rdquo; habrá desaparecido. Seleccione esa cuenta y estará listo para operar." },
      ],
    },
    { type: "heading", text: "Si la cuenta financiada sigue sin aparecer" },
    { type: "paragraph", html: "Si está seguro de que usó las credenciales de plataforma de la firma en el entorno Demo y sigue viendo el aviso de financiamiento o una cuenta vacía:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Dé tiempo al aprovisionamiento.</strong> Justo después de la compra, espere un poco y vuelva a intentarlo, la firma puede seguir creando la cuenta entre bastidores. Los tiempos de aprovisionamiento varían según la firma y el producto, así que revise las reglas actuales de su firma.",
        "<strong class='text-white'>Cierre todas las demás sesiones.</strong> Cierre sesión en todos los demás lugares (un segundo navegador, la app móvil, una conexión de TradingView) para que solo una sesión de Tradovate esté activa, y luego inicie sesión de nuevo.",
        "<strong class='text-white'>Contacte a su prop firm, no a Tradovate.</strong> Como la firma es dueña de la cuenta de evaluación, solo la firma puede activarla, restablecer la contraseña de trading o confirmar que fue creada. El soporte de Tradovate no puede restaurar ni reemitir una cuenta que no le pertenece.",
      ],
    },
    { type: "heading", text: "Tabla de solución de problemas" },
    {
      type: "table",
      headers: ["Lo que ve", "Lo que significa", "Solución"],
      rows: [
        ["Aviso &ldquo;Fund Your Account&rdquo; tras el inicio de sesión", "Está en una cuenta personal o vacía, no en la financiada", "Cierre sesión e inicie sesión con las credenciales de plataforma de la firma"],
        ["Login aceptado pero saldo de $0 con aviso de financiamiento", "Inició sesión con el correo del panel en lugar del nombre de usuario de trading", "Use el nombre de usuario con formato TRAD###### del panel de la firma"],
        ["Login rechazado / &ldquo;Invalid Credentials&rdquo;", "Nombre de usuario, contraseña o entorno incorrectos", "Vuelva a copiar el nombre de usuario y la contraseña emitidos por la firma; elija Demo/Simulación"],
        ["Cuenta financiada ausente justo después de la compra", "Evaluación aún no aprovisionada", "Espere el aprovisionamiento y reintente; contacte a la firma si persiste"],
        ["Desplazado aleatoriamente a la cuenta incorrecta", "Demasiadas sesiones activas", "Cierre sesión en todas partes y mantenga una sola sesión de Tradovate"],
        ["Login correcto, aún sin cuenta", "Cuenta no activada por parte de la firma", "Contacte a la prop firm, solo ellos pueden habilitarla"],
      ],
    },
    { type: "heading", text: "Evite esto con PickMyTrade" },
    { type: "paragraph", html: "Una vez que está en la cuenta correcta, PickMyTrade vincula sus alertas de TradingView directamente a esa cuenta financiada de Tradovate para que nunca opere a ciegas:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Enrutamiento consciente de la cuenta</strong>, las órdenes se asignan exactamente a la cuenta financiada que conectó, así las alertas no pueden filtrarse a una cuenta personal o vacía.",
        "<strong class='text-white'>Verificaciones de conexión y habilitación</strong>, un enlace de bróker roto o no autorizado se marca antes de que una alerta intente dispararse, en lugar de fallar en silencio.",
        "<strong class='text-white'>Alineación con el riesgo de la prop firm</strong>, la automatización respeta el estado de riesgo de la evaluación para cumplir con las reglas actuales de su firma.",
        "<strong class='text-white'>Sincronización multicuenta</strong>, una orden validada se refleja en cada cuenta que haya conectado, manteniendo las copias sincronizadas.",
      ],
    },
  ], fr: [
    { type: "paragraph", html: "Vous avez terminé le paiement d'une évaluation prop toute neuve, vous ouvrez Tradovate pour passer votre premier trade, et au lieu d'un solde financé et d'une ladder en direct, vous recevez une invite <strong class='text-white'>&ldquo;Fund Your Account&rdquo;</strong> vous demandant de déposer de l'argent. Respirez un coup. Rien n'est cassé, et vous ne <strong class='text-white'>devez</strong> aucun dépôt à Tradovate. C'est l'un des accrocs les plus courants à la première connexion pour les traders de prop firms, et cela revient presque toujours à une seule confusion : vous êtes connecté au <em>mauvais</em> compte Tradovate. Votre évaluation financée se trouve sous les identifiants émis par votre prop firm, pas sous votre e-mail Tradovate personnel, et pas sous votre identifiant de tableau de bord de prop firm. Voici exactement pourquoi ce message apparaît, comment le résoudre en moins de deux minutes, et comment une automatisation comme PickMyTrade empêche les ordres de jamais partir vers un compte vide." },
    {
      type: "checklist",
      heading: "Check-list rapide pour l'invite &ldquo;Fund Your Account&rdquo;",
      items: [
        "<strong class='text-white'>Ne déposez pas un centime.</strong> Une évaluation prop n'a jamais besoin de votre propre argent, l'invite est une fausse alerte, pas une véritable exigence de financement.",
        "<strong class='text-white'>Confirmez sur quel compte vous êtes.</strong> L'écran &ldquo;Fund Your Account&rdquo; signifie que Tradovate a chargé un compte personnel ou vide, pas votre compte financé.",
        "<strong class='text-white'>Utilisez les identifiants de plateforme de la firme.</strong> Connectez-vous avec le nom d'utilisateur et le mot de passe de trading émis par votre prop firm (de nombreuses firmes utilisent un nom d'utilisateur au format <code>TRAD######</code>), pas votre e-mail de tableau de bord.",
        "<strong class='text-white'>Choisissez le bon environnement.</strong> Les évaluations et comptes financés en simulation se trouvent du côté Demo/Simulation de la connexion, pas Live.",
        "<strong class='text-white'>Déconnectez-vous complètement d'abord.</strong> Déconnectez-vous du compte personnel, et de toute deuxième session ouverte, avant de vous reconnecter.",
        "<strong class='text-white'>Toujours vide après la bonne connexion ?</strong> La firme n'a peut-être pas encore provisionné le compte, contactez alors votre prop firm plutôt que Tradovate.",
      ],
    },
    { type: "heading", text: "Ce que signifie &ldquo;Fund Your Account&rdquo;" },
    { type: "paragraph", html: "Tradovate est à la fois un courtier <em>et</em> la plateforme de trading que des dizaines de prop firms remettent à leurs traders. Lorsque vous ouvrez un tout nouveau compte Tradovate <strong class='text-white'>personnel</strong> sans dépôt, le tableau de bord affiche un appel à l'action &ldquo;Fund Your Account&rdquo; vous incitant à ajouter de l'argent avant de pouvoir trader avec un solde réel. Sur un compte personnel, c'est exactement juste, le compte n'a réellement rien dedans." },
    { type: "paragraph", html: "Un compte d'évaluation de prop firm ou financé en simulation est un compte <em>entièrement séparé</em>. La firme le finance avec du capital simulé et vous délivre des identifiants de connexion dédiés pour la plateforme Tradovate. Connectez-vous avec votre propre e-mail Tradovate, ou avec l'e-mail et le mot de passe que vous utilisez pour le <em>tableau de bord</em> de la firme au lieu du nom d'utilisateur de plateforme que la firme vous a donné, et Tradovate charge consciencieusement un compte sans solde, puis vous demande de le financer." },
    { type: "paragraph", html: "Le message ne vous dit donc pas que votre évaluation a échoué ou disparu. Il vous dit que le compte actuellement à l'écran est vide. Le compte financé n'a pas disparu, vous ne le regardez simplement pas encore. Connectez-vous avec les bons identifiants et il apparaît immédiatement." },
    { type: "heading", text: "Principales causes de &ldquo;Fund Your Account&rdquo; sur une connexion prop" },
    { type: "heading", text: "1. Vous vous êtes connecté avec votre compte Tradovate personnel" },
    { type: "paragraph", html: "Si vous avez déjà ouvert votre propre compte Tradovate, même un essai gratuit, votre navigateur ou votre app peut auto-remplir ces identifiants enregistrés. Tradovate vous connecte à ce compte personnel, ne voit aucun dépôt, et affiche l'invite de financement. Votre évaluation reste intacte sous une connexion différente." },
    { type: "heading", text: "2. Vous avez utilisé l'e-mail du tableau de bord de votre prop firm au lieu du nom d'utilisateur de plateforme" },
    { type: "paragraph", html: "C'est de loin la cause la plus fréquente. Les prop firms vous donnent deux jeux d'identifiants faciles à confondre :" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Identifiants du tableau de bord</strong>, l'e-mail et le mot de passe avec lesquels vous vous êtes inscrit, utilisés pour vous connecter au portail membres de la firme, où vous achetez des évaluations, suivez les règles et demandez des paiements.",
        "<strong class='text-white'>Identifiants de plateforme</strong>, un nom d'utilisateur de trading émis par la firme (Tradeify, par exemple, délivre un nom d'utilisateur au format <code>TRAD######</code>) et un mot de passe distinct, utilisés uniquement pour vous connecter à Tradovate lui-même.",
      ],
    },
    { type: "paragraph", html: "Saisissez votre e-mail de tableau de bord dans la connexion Tradovate et cela ne se connectera pas à votre compte financé, cela échoue ou vous dépose sur un compte sans rapport, ce qui déclenche l'écran &ldquo;Fund Your Account&rdquo;." },
    { type: "heading", text: "3. Vous êtes sur l'environnement Live au lieu de Demo/Simulation" },
    { type: "paragraph", html: "La plupart des évaluations prop et des comptes financés en simulation fonctionnent sur l'environnement simulé (Demo) de Tradovate, pas Live. Si le sélecteur d'environnement de connexion est réglé sur Live, Tradovate recherche un compte de courtage réel que vous n'avez pas, donc soit il ne trouve pas l'évaluation, soit il vous dépose sur un compte vide. Le libellé de ce sélecteur peut changer, vérifiez donc l'étiquette actuelle sur l'écran de connexion." },
    { type: "heading", text: "4. L'évaluation n'a pas encore été provisionnée, ou une deuxième session vous a délogé" },
    { type: "paragraph", html: "Juste après l'achat, il y a souvent un court délai de provisionnement avant que la firme crée votre compte Tradovate. Connectez-vous trop tôt et le compte n'existe tout simplement pas encore. Par ailleurs, Tradovate limite le nombre de sessions que vous pouvez maintenir à la fois, donc une deuxième connexion ouverte, bureau plus TradingView par exemple, peut vous faire basculer vers le mauvais état de compte. Les deux se résolvent sans aucun dépôt ; les détails varient selon la firme, vérifiez donc les règles d'intégration actuelles de votre firme." },
    { type: "heading", text: "Comment résoudre &ldquo;Fund Your Account&rdquo; : étape par étape" },
    {
      type: "steps",
      items: [
        { title: "Déconnectez-vous complètement de Tradovate", html: "Déconnectez-vous des apps web, bureau et mobile, et déconnectez tout lien courtier TradingView, afin qu'aucune session personnelle obsolète ne vous laisse coincé sur le compte vide." },
        { title: "Ouvrez le tableau de bord membre de votre prop firm et trouvez les identifiants de plateforme", html: "La plupart des firmes affichent votre nom d'utilisateur et mot de passe de trading Tradovate sur le tableau de bord, souvent en haut de la page ou dans le panneau compte/identifiants. Copiez le nom d'utilisateur de trading (pas votre e-mail de connexion) et le mot de passe émis par la firme." },
        { title: "Allez à la connexion Tradovate et sélectionnez le bon environnement", html: "Ouvrez le web trader Tradovate (ou l'app bureau/mobile), et réglez le sélecteur d'environnement sur Demo/Simulation pour une évaluation ou un compte financé en simulation. Confirmez le libellé exact sur l'écran de connexion actuel avant de vous connecter." },
        { title: "Saisissez le nom d'utilisateur et le mot de passe émis par la firme, puis connectez-vous", html: "Utilisez le nom d'utilisateur de plateforme que vous avez copié depuis le tableau de bord, et surveillez la casse, les espaces en fin issus d'un copier-coller, et le verrouillage majuscules. Ces identifiants sont généralement fixés par la firme et ne peuvent pas être modifiés comme un mot de passe personnel." },
        { title: "Confirmez que le compte financé apparaît maintenant", html: "Une fois connecté, l'évaluation financée devrait apparaître dans le sélecteur de comptes avec son solde simulé, et l'invite &ldquo;Fund Your Account&rdquo; a disparu. Sélectionnez ce compte et vous êtes prêt à trader." },
      ],
    },
    { type: "heading", text: "Si le compte financé n'apparaît toujours pas" },
    { type: "paragraph", html: "Si vous êtes certain d'avoir utilisé les identifiants de plateforme de la firme sur l'environnement Demo et que vous voyez toujours l'invite de financement ou un compte vide :" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Laissez du temps au provisionnement.</strong> Juste après l'achat, attendez un peu et réessayez, la firme est peut-être encore en train de créer le compte en coulisses. Les délais de provisionnement varient selon la firme et le produit, vérifiez donc les règles actuelles de votre firme.",
        "<strong class='text-white'>Fermez toute autre session.</strong> Déconnectez-vous partout ailleurs (un deuxième navigateur, l'app mobile, une connexion TradingView) pour qu'une seule session Tradovate soit active, puis reconnectez-vous.",
        "<strong class='text-white'>Contactez votre prop firm, pas Tradovate.</strong> Comme la firme possède le compte d'évaluation, seule la firme peut l'activer, réinitialiser le mot de passe de trading, ou confirmer qu'il a été créé. Le support Tradovate ne peut pas restaurer ni réémettre un compte qu'il ne possède pas.",
      ],
    },
    { type: "heading", text: "Tableau de dépannage" },
    {
      type: "table",
      headers: ["Ce que vous voyez", "Ce que cela signifie", "Solution"],
      rows: [
        ["Invite &ldquo;Fund Your Account&rdquo; après la connexion", "Vous êtes sur un compte personnel ou vide, pas le compte financé", "Déconnectez-vous et reconnectez-vous avec les identifiants de plateforme de la firme"],
        ["Connexion acceptée mais solde de 0 $ avec invite de financement", "Connecté avec l'e-mail du tableau de bord au lieu du nom d'utilisateur de trading", "Utilisez le nom d'utilisateur au format TRAD###### du tableau de bord de la firme"],
        ["Connexion refusée / &ldquo;Invalid Credentials&rdquo;", "Mauvais nom d'utilisateur, mauvais mot de passe, ou mauvais environnement", "Recopiez le nom d'utilisateur et le mot de passe émis par la firme ; choisissez Demo/Simulation"],
        ["Compte financé manquant juste après l'achat", "Évaluation pas encore provisionnée", "Attendez le provisionnement, puis réessayez ; contactez la firme si cela persiste"],
        ["Renvoyé au mauvais compte aléatoirement", "Trop de sessions actives", "Déconnectez-vous partout et gardez une seule session Tradovate"],
        ["Connexion correcte, toujours aucun compte", "Compte non activé côté firme", "Contactez la prop firm, elle seule peut l'activer"],
      ],
    },
    { type: "heading", text: "Évitez cela avec PickMyTrade" },
    { type: "paragraph", html: "Une fois sur le bon compte, PickMyTrade relie vos alertes TradingView directement à ce compte Tradovate financé pour que vous ne tradiez jamais à l'aveugle :" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Routage conscient du compte</strong>, les ordres sont mappés exactement sur le compte financé que vous avez connecté, afin que les alertes ne puissent pas fuiter vers un compte personnel ou vide.",
        "<strong class='text-white'>Vérifications de connexion et d'habilitation</strong>, un lien courtier cassé ou non autorisé est signalé avant qu'une alerte n'essaie de se déclencher, au lieu d'échouer silencieusement.",
        "<strong class='text-white'>Alignement sur le risque de la prop firm</strong>, l'automatisation respecte l'état de risque de l'évaluation afin de respecter les règles actuelles de votre firme.",
        "<strong class='text-white'>Synchronisation multi-comptes</strong>, un ordre validé se reflète sur chaque compte que vous avez connecté, gardant les copies synchronisées.",
      ],
    },
  ], it: [
    { type: "paragraph", html: "Ha completato il checkout di una nuova prop evaluation, apre Tradovate per piazzare il primo trade e, invece di un saldo finanziato e di una ladder live, riceve un messaggio <strong class='text-white'>&ldquo;Fund Your Account&rdquo;</strong> che le chiede di depositare denaro. Faccia un respiro. Non c'è nulla di rotto, e non <strong class='text-white'>deve</strong> alcun deposito a Tradovate. Questo è uno degli inconvenienti più comuni al primo accesso per i trader delle prop firm, e quasi sempre si riduce a un solo equivoco: ha effettuato l'accesso all'account <em>sbagliato</em> di Tradovate. La sua evaluation finanziata si trova sotto le credenziali rilasciate dalla sua prop firm, non sotto la sua e-mail personale di Tradovate, e non sotto il login della dashboard della prop firm. Ecco esattamente perché appare questo messaggio, come risolverlo in meno di due minuti, e come un'automazione come PickMyTrade impedisce che gli ordini finiscano mai su un account vuoto." },
    {
      type: "checklist",
      heading: "Checklist rapida per il messaggio &ldquo;Fund Your Account&rdquo;",
      items: [
        "<strong class='text-white'>Non depositi un centesimo.</strong> Una prop evaluation non richiede mai denaro proprio, il messaggio è un falso allarme, non un vero requisito di finanziamento.",
        "<strong class='text-white'>Verifichi in quale account si trova.</strong> La schermata &ldquo;Fund Your Account&rdquo; significa che Tradovate ha caricato un account personale o vuoto, non il suo account finanziato.",
        "<strong class='text-white'>Usi le credenziali della piattaforma della firm.</strong> Effettui l'accesso con il nome utente e la password di trading rilasciati dalla sua prop firm (molte firm usano un nome utente in formato <code>TRAD######</code>), non la sua e-mail della dashboard.",
        "<strong class='text-white'>Scelga l'ambiente giusto.</strong> Le evaluation e gli account finanziati in simulazione si trovano nel lato Demo/Simulazione del login, non Live.",
        "<strong class='text-white'>Esca completamente prima di tutto.</strong> Esca dall'account personale, e da qualsiasi seconda sessione aperta, prima di accedere di nuovo.",
        "<strong class='text-white'>Ancora vuoto dopo il login corretto?</strong> È possibile che la firm non abbia ancora predisposto l'account, quindi contatti la sua prop firm anziché Tradovate.",
      ],
    },
    { type: "heading", text: "Cosa significa &ldquo;Fund Your Account&rdquo;" },
    { type: "paragraph", html: "Tradovate è sia un broker <em>sia</em> la piattaforma di trading che decine di prop firm consegnano ai loro trader. Quando apre un account Tradovate <strong class='text-white'>personale</strong> nuovo di zecca senza deposito, la dashboard mostra una call-to-action &ldquo;Fund Your Account&rdquo; che la invita ad aggiungere denaro prima di poter fare trading con un saldo live. Su un account personale, questo è esattamente corretto, l'account non contiene davvero nulla." },
    { type: "paragraph", html: "Un account di evaluation di una prop firm o finanziato in simulazione è un account <em>completamente separato</em>. La firm lo finanzia con capitale simulato e le rilascia credenziali di accesso dedicate per la piattaforma Tradovate. Se accede con la sua e-mail Tradovate personale, o con l'e-mail e la password che usa per la <em>dashboard</em> della firm invece del nome utente della piattaforma che le ha dato la firm, Tradovate carica diligentemente un account senza saldo e poi le chiede di finanziarlo." },
    { type: "paragraph", html: "Quindi il messaggio non le sta dicendo che la sua evaluation è fallita o è scomparsa. Le sta dicendo che l'account attualmente a schermo è vuoto. L'account finanziato non è scomparso; semplicemente non lo sta ancora guardando. Effettui l'accesso con le credenziali giuste e apparirà immediatamente." },
    { type: "heading", text: "Cause principali di &ldquo;Fund Your Account&rdquo; su un login prop" },
    { type: "heading", text: "1. Ha effettuato l'accesso con il suo account Tradovate personale" },
    { type: "paragraph", html: "Se ha mai aperto un proprio account Tradovate, anche una prova gratuita, il suo browser o app potrebbe autocompilare quelle credenziali salvate. Tradovate le fa accedere a quell'account personale, non vede alcun deposito e mostra il messaggio di finanziamento. La sua evaluation resta intatta sotto un login diverso." },
    { type: "heading", text: "2. Ha usato l'e-mail della dashboard della sua prop firm invece del nome utente della piattaforma" },
    { type: "paragraph", html: "Questa è di gran lunga la causa più frequente. Le prop firm le danno due set di credenziali facili da confondere:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Credenziali della dashboard</strong>, l'e-mail e la password con cui si è registrato, usate per accedere al portale membri della firm, dove acquista evaluation, monitora le regole e richiede i payout.",
        "<strong class='text-white'>Credenziali della piattaforma</strong>, un nome utente di trading rilasciato dalla firm (Tradeify, ad esempio, rilascia un nome utente in formato <code>TRAD######</code>) e una password separata, usati solo per accedere a Tradovate stesso.",
      ],
    },
    { type: "paragraph", html: "Se digita l'e-mail della dashboard nel login di Tradovate, non si collegherà al suo account finanziato, o fallisce oppure la porta su un account non correlato, ed è questo che attiva la schermata &ldquo;Fund Your Account&rdquo;." },
    { type: "heading", text: "3. È sull'ambiente Live invece che su Demo/Simulazione" },
    { type: "paragraph", html: "La maggior parte delle prop evaluation e degli account finanziati in simulazione funziona sull'ambiente simulato (Demo) di Tradovate, non su Live. Se il selettore di ambiente al login è impostato su Live, Tradovate cerca un account broker live che lei non ha, quindi non trova l'evaluation oppure la porta su un account vuoto. La dicitura di questo selettore può cambiare, quindi controlli l'etichetta attuale nella schermata di login." },
    { type: "heading", text: "4. L'evaluation non è ancora stata predisposta, oppure una seconda sessione l'ha spostata" },
    { type: "paragraph", html: "Subito dopo l'acquisto, spesso c'è un breve ritardo di provisioning prima che la firm crei il suo account Tradovate. Se accede troppo presto, l'account semplicemente non esiste ancora. Separatamente, Tradovate limita quante sessioni può mantenere contemporaneamente, quindi un secondo login aperto, ad esempio desktop più TradingView, può spostarla sullo stato di account sbagliato. Entrambi si risolvono senza alcun deposito; i dettagli variano a seconda della firm, quindi controlli le regole di onboarding attuali della sua firm." },
    { type: "heading", text: "Come risolvere &ldquo;Fund Your Account&rdquo;: passo dopo passo" },
    {
      type: "steps",
      items: [
        { title: "Esca completamente da Tradovate", html: "Esca dalle app web, desktop e mobile, e disconnetta qualsiasi collegamento broker TradingView, così nessuna sessione personale obsoleta la tiene bloccata sull'account vuoto." },
        { title: "Apra la dashboard membri della sua prop firm e trovi le credenziali della piattaforma", html: "La maggior parte delle firm mostra il suo nome utente e password di trading Tradovate nella dashboard, spesso vicino alla parte superiore della pagina o nel pannello account/credenziali. Copi il nome utente di trading (non la sua e-mail di login) e la password rilasciata dalla firm." },
        { title: "Vada al login di Tradovate e selezioni l'ambiente corretto", html: "Apra il web trader di Tradovate (o l'app desktop/mobile), e imposti il selettore di ambiente su Demo/Simulazione per un'evaluation o un account finanziato in simulazione. Confermi l'etichetta esatta nella schermata di login attuale prima di accedere." },
        { title: "Inserisca il nome utente e la password rilasciati dalla firm, quindi effettui l'accesso", html: "Usi il nome utente della piattaforma che ha copiato dalla dashboard, e faccia attenzione a maiuscole/minuscole, spazi finali da copia-incolla, e blocco maiuscole. Queste credenziali sono in genere fissate dalla firm e non possono essere cambiate come una password personale." },
        { title: "Confermi che l'account finanziato ora appare", html: "Una volta effettuato l'accesso, l'evaluation finanziata dovrebbe apparire nel selettore account con il suo saldo simulato, e il messaggio &ldquo;Fund Your Account&rdquo; è scomparso. Selezioni quell'account ed è pronto per fare trading." },
      ],
    },
    { type: "heading", text: "Se l'account finanziato continua a non apparire" },
    { type: "paragraph", html: "Se è sicuro di aver usato le credenziali della piattaforma della firm sull'ambiente Demo e continua a vedere il messaggio di finanziamento o un account vuoto:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Dia tempo al provisioning.</strong> Subito dopo l'acquisto, attenda un po' e riprovi, la firm potrebbe essere ancora impegnata a creare l'account dietro le quinte. I tempi di provisioning variano a seconda della firm e del prodotto, quindi controlli le regole attuali della sua firm.",
        "<strong class='text-white'>Chiuda ogni altra sessione.</strong> Esca da ogni altro posto (un secondo browser, l'app mobile, una connessione TradingView) in modo che sia attiva una sola sessione Tradovate, quindi effettui di nuovo l'accesso.",
        "<strong class='text-white'>Contatti la sua prop firm, non Tradovate.</strong> Poiché la firm possiede l'account di evaluation, solo la firm può attivarlo, reimpostare la password di trading, o confermare che è stato creato. Il supporto Tradovate non può ripristinare o riemettere un account che non possiede.",
      ],
    },
    { type: "heading", text: "Tabella di risoluzione dei problemi" },
    {
      type: "table",
      headers: ["Cosa vede", "Cosa significa", "Soluzione"],
      rows: [
        ["Messaggio &ldquo;Fund Your Account&rdquo; dopo il login", "È su un account personale o vuoto, non su quello finanziato", "Esca ed effettui l'accesso con le credenziali della piattaforma della firm"],
        ["Login accettato ma saldo di $0 con avviso di finanziamento", "Accesso effettuato con l'e-mail della dashboard invece del nome utente di trading", "Usi il nome utente in formato TRAD###### dalla dashboard della firm"],
        ["Login rifiutato / &ldquo;Invalid Credentials&rdquo;", "Nome utente, password o ambiente sbagliati", "Ricopi il nome utente e la password rilasciati dalla firm; scelga Demo/Simulazione"],
        ["Account finanziato mancante subito dopo l'acquisto", "Evaluation non ancora predisposta", "Attenda il provisioning, poi riprovi; contatti la firm se persiste"],
        ["Riportato casualmente sull'account sbagliato", "Troppe sessioni attive", "Esca da ovunque e mantenga una sola sessione Tradovate"],
        ["Login corretto, ancora nessun account", "Account non attivato lato firm", "Contatti la prop firm, solo loro possono abilitarlo"],
      ],
    },
    { type: "heading", text: "Prevenga tutto questo con PickMyTrade" },
    { type: "paragraph", html: "Una volta sull'account giusto, PickMyTrade collega i suoi alert di TradingView direttamente a quell'account Tradovate finanziato così non fa mai trading alla cieca:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Routing consapevole dell'account</strong>, gli ordini vengono mappati esattamente sull'account finanziato che ha collegato, così gli alert non possono finire su un account personale o vuoto.",
        "<strong class='text-white'>Controlli di connessione ed entitlement</strong>, un collegamento broker rotto o non autorizzato viene segnalato prima che un alert provi a scattare, invece di fallire silenziosamente.",
        "<strong class='text-white'>Allineamento al rischio della prop firm</strong>, l'automazione rispetta lo stato di rischio dell'evaluation così si attiene alle regole attuali della sua firm.",
        "<strong class='text-white'>Sincronizzazione multi-account</strong>, un ordine validato si riflette su ogni account collegato, mantenendo le copie sincronizzate.",
      ],
    },
  ] },
  ctaHeading: { en: "Trade Rejection-Free", de: "Handeln Sie ohne Ablehnungen", es: "Opere sin rechazos", fr: "Tradez sans rejets", it: "Faccia trading senza rifiuti" },
  ctaText: { en: "Once you're on the right funded account, PickMyTrade keeps every alert mapped to it, so orders never leak into an empty or personal account.", de: "Sobald Sie im richtigen finanzierten Konto sind, hält PickMyTrade jeden Alert diesem Konto zugeordnet, sodass Orders nie in ein leeres oder persönliches Konto durchsickern.", es: "Una vez que está en la cuenta financiada correcta, PickMyTrade mantiene cada alerta asignada a ella, para que las órdenes nunca se filtren a una cuenta vacía o personal.", fr: "Une fois sur le bon compte financé, PickMyTrade maintient chaque alerte mappée dessus, afin que les ordres ne fuient jamais vers un compte vide ou personnel.", it: "Una volta sull'account finanziato giusto, PickMyTrade mantiene ogni alert mappato su di esso, così gli ordini non finiscono mai su un account vuoto o personale." },
  ctaButtonText: { en: "Start Your Free 7-Day Trial", de: "Starten Sie Ihre kostenlose 5-Tage-Testversion", es: "Comience su prueba gratuita de 5 días", fr: "Démarrez votre essai gratuit de 5 jours", it: "Inizi la sua prova gratuita di 5 giorni" },
  ctaUrl: "https://app.pickmytrade.trade/?register=true&utm_source=content&utm_medium=debugging",
  faqHeading: { en: "Frequently Asked Questions", de: "Häufig gestellte Fragen", es: "Preguntas frecuentes", fr: "Questions fréquentes", it: "Domande frequenti" },
  faqs: { en: [
    { q: "Do I actually need to deposit money when Tradovate says “Fund Your Account” on my evaluation?", a: "No. A prop evaluation or sim-funded account is capitalized by the firm with simulated funds. The prompt only appears because you're viewing a personal or empty account. Never deposit your own money to clear it, log in with the firm's credentials instead." },
    { q: "What's the difference between my dashboard login and my Tradovate login?", a: "Your dashboard login is the email and password for the firm's member portal, where you buy evaluations and request payouts. Your Tradovate login is a separate, firm-issued trading username (often a TRAD###### format) and password used only to sign in to the platform. Mixing them up is the top cause of this error." },
    { q: "Where do I find my Tradovate trading credentials?", a: "They're displayed on your prop firm's dashboard, commonly near the top of the page or on the account/credentials panel. Copy the trading username and firm-issued password from there, not your registration email." },
    { q: "Which environment should I choose at login, Live or Demo?", a: "Evaluations and sim-funded accounts almost always run on the Demo / Simulation environment. Choosing Live makes Tradovate look for a live brokerage account you don't have. The exact label can change, so confirm it on the current login screen." },
    { q: "I used the right credentials but the funded account still isn't there. Why?", a: "The firm may not have finished provisioning the account after purchase, or you have too many active sessions. Wait a short while, log out everywhere, and try again. If it persists, only your prop firm can activate the account." },
    { q: "Can Tradovate support fix this for me?", a: "For prop-firm accounts, no. The firm owns and manages the evaluation account, so Tradovate can't reset the password or restore access to it. Contact your prop firm's support for anything account-specific." },
    { q: "Why does my personal Tradovate account keep loading instead of the evaluation?", a: "Saved credentials or auto-fill are signing you into your own account. Log out fully, clear the saved login if needed, and enter the firm-issued username and password manually." },
    { q: "Will this error affect my evaluation rules or reset my progress?", a: "No. Seeing “Fund Your Account” is just a display of an empty account you shouldn't be on, it doesn't touch your evaluation balance, drawdown, or trade history. Those live on the funded account under the firm's credentials." },
  ], de: [
    { q: "Muss ich wirklich Geld einzahlen, wenn Tradovate bei meiner Evaluation &ldquo;Fund Your Account&rdquo; anzeigt?", a: "Nein. Ein Evaluationskonto oder ein simuliert finanziertes Konto wird von der Firma mit simulierten Mitteln kapitalisiert. Die Aufforderung erscheint nur, weil Sie ein persönliches oder leeres Konto betrachten. Zahlen Sie niemals Ihr eigenes Geld ein, um sie zu beheben, melden Sie sich stattdessen mit den Zugangsdaten der Firma an." },
    { q: "Was ist der Unterschied zwischen meinem Dashboard-Login und meinem Tradovate-Login?", a: "Ihr Dashboard-Login ist die E-Mail und das Passwort für das Mitgliederportal der Firma, wo Sie Evaluationen kaufen und Auszahlungen beantragen. Ihr Tradovate-Login ist ein separater, von der Firma vergebener Trading-Benutzername (oft im Format TRAD######) und ein Passwort, das nur zur Anmeldung bei der Plattform verwendet wird. Diese zu verwechseln ist die häufigste Ursache für diesen Fehler." },
    { q: "Wo finde ich meine Tradovate-Trading-Zugangsdaten?", a: "Sie werden im Dashboard Ihrer Prop-Firma angezeigt, meist oben auf der Seite oder im Konto-/Zugangsdaten-Panel. Kopieren Sie den Trading-Benutzernamen und das von der Firma vergebene Passwort von dort, nicht Ihre Registrierungs-E-Mail." },
    { q: "Welche Umgebung sollte ich beim Login wählen, Live oder Demo?", a: "Evaluationen und simuliert finanzierte Konten laufen fast immer in der Demo-/Simulationsumgebung. Wählen Sie Live, sucht Tradovate nach einem Live-Broker-Konto, das Sie nicht haben. Die genaue Bezeichnung kann sich ändern, bestätigen Sie sie daher auf dem aktuellen Login-Bildschirm." },
    { q: "Ich habe die richtigen Zugangsdaten verwendet, aber das finanzierte Konto ist immer noch nicht da. Warum?", a: "Möglicherweise hat die Firma die Bereitstellung des Kontos nach dem Kauf noch nicht abgeschlossen, oder Sie haben zu viele aktive Sitzungen. Warten Sie kurz, melden Sie sich überall ab und versuchen Sie es erneut. Hält das Problem an, kann nur Ihre Prop-Firma das Konto aktivieren." },
    { q: "Kann der Tradovate-Support das für mich beheben?", a: "Bei Prop-Firm-Konten nein. Die Firma besitzt und verwaltet das Evaluationskonto, sodass Tradovate das Passwort nicht zurücksetzen oder den Zugriff wiederherstellen kann. Wenden Sie sich für alles Kontospezifische an den Support Ihrer Prop-Firma." },
    { q: "Warum lädt immer wieder mein persönliches Tradovate-Konto statt der Evaluation?", a: "Gespeicherte Zugangsdaten oder das automatische Ausfüllen melden Sie in Ihrem eigenen Konto an. Melden Sie sich vollständig ab, löschen Sie bei Bedarf den gespeicherten Login und geben Sie den von der Firma vergebenen Benutzernamen und das Passwort manuell ein." },
    { q: "Wirkt sich dieser Fehler auf meine Evaluationsregeln aus oder setzt er meinen Fortschritt zurück?", a: "Nein. &ldquo;Fund Your Account&rdquo; zu sehen, ist nur die Anzeige eines leeren Kontos, auf dem Sie nicht sein sollten, es berührt weder Ihren Evaluationssaldo, Ihren Drawdown noch Ihre Handelshistorie. Diese befinden sich auf dem finanzierten Konto unter den Zugangsdaten der Firma." },
  ], es: [
    { q: "¿Realmente necesito depositar dinero cuando Tradovate muestra &ldquo;Fund Your Account&rdquo; en mi evaluación?", a: "No. Una cuenta de evaluación prop o financiada por simulación es capitalizada por la firma con fondos simulados. El aviso solo aparece porque está viendo una cuenta personal o vacía. Nunca deposite su propio dinero para quitarlo, en su lugar inicie sesión con las credenciales de la firma." },
    { q: "¿Cuál es la diferencia entre mi login del panel y mi login de Tradovate?", a: "Su login del panel es el correo y la contraseña del portal de miembros de la firma, donde compra evaluaciones y solicita pagos. Su login de Tradovate es un nombre de usuario de trading independiente emitido por la firma (a menudo en formato TRAD######) y una contraseña usados solo para iniciar sesión en la plataforma. Confundirlos es la principal causa de este error." },
    { q: "¿Dónde encuentro mis credenciales de trading de Tradovate?", a: "Se muestran en el panel de su prop firm, comúnmente cerca de la parte superior de la página o en el panel de cuenta/credenciales. Copie de ahí el nombre de usuario de trading y la contraseña emitida por la firma, no su correo de registro." },
    { q: "¿Qué entorno debo elegir al iniciar sesión, Live o Demo?", a: "Las evaluaciones y cuentas financiadas por simulación casi siempre funcionan en el entorno Demo/Simulación. Elegir Live hace que Tradovate busque una cuenta de bróker en vivo que usted no tiene. La etiqueta exacta puede cambiar, así que confírmela en la pantalla de inicio de sesión actual." },
    { q: "Usé las credenciales correctas pero la cuenta financiada sigue sin aparecer. ¿Por qué?", a: "Es posible que la firma no haya terminado de aprovisionar la cuenta tras la compra, o que tenga demasiadas sesiones activas. Espere un poco, cierre sesión en todas partes e inténtelo de nuevo. Si persiste, solo su prop firm puede activar la cuenta." },
    { q: "¿Puede el soporte de Tradovate arreglar esto por mí?", a: "Para cuentas de prop firm, no. La firma posee y gestiona la cuenta de evaluación, así que Tradovate no puede restablecer la contraseña ni restaurar el acceso a ella. Contacte al soporte de su prop firm para cualquier asunto específico de la cuenta." },
    { q: "¿Por qué sigue cargando mi cuenta personal de Tradovate en lugar de la evaluación?", a: "Las credenciales guardadas o el autocompletado le están iniciando sesión en su propia cuenta. Cierre sesión por completo, borre el login guardado si es necesario, e introduzca manualmente el nombre de usuario y la contraseña emitidos por la firma." },
    { q: "¿Afectará este error a las reglas de mi evaluación o reiniciará mi progreso?", a: "No. Ver &ldquo;Fund Your Account&rdquo; es solo la visualización de una cuenta vacía en la que no debería estar, no afecta a su saldo de evaluación, drawdown ni historial de operaciones. Esos residen en la cuenta financiada bajo las credenciales de la firma." },
  ], fr: [
    { q: "Dois-je vraiment déposer de l'argent quand Tradovate affiche &ldquo;Fund Your Account&rdquo; sur mon évaluation ?", a: "Non. Un compte d'évaluation prop ou financé en simulation est capitalisé par la firme avec des fonds simulés. L'invite n'apparaît que parce que vous consultez un compte personnel ou vide. Ne déposez jamais votre propre argent pour la faire disparaître, connectez-vous plutôt avec les identifiants de la firme." },
    { q: "Quelle est la différence entre ma connexion au tableau de bord et ma connexion Tradovate ?", a: "Votre connexion au tableau de bord est l'e-mail et le mot de passe du portail membres de la firme, où vous achetez des évaluations et demandez des paiements. Votre connexion Tradovate est un nom d'utilisateur de trading distinct émis par la firme (souvent au format TRAD######) et un mot de passe utilisés uniquement pour vous connecter à la plateforme. Les confondre est la principale cause de cette erreur." },
    { q: "Où trouver mes identifiants de trading Tradovate ?", a: "Ils sont affichés sur le tableau de bord de votre prop firm, généralement en haut de la page ou dans le panneau compte/identifiants. Copiez-y le nom d'utilisateur de trading et le mot de passe émis par la firme, pas votre e-mail d'inscription." },
    { q: "Quel environnement dois-je choisir à la connexion, Live ou Demo ?", a: "Les évaluations et les comptes financés en simulation fonctionnent presque toujours sur l'environnement Demo/Simulation. Choisir Live fait que Tradovate recherche un compte de courtage réel que vous n'avez pas. Le libellé exact peut changer, confirmez-le donc sur l'écran de connexion actuel." },
    { q: "J'ai utilisé les bons identifiants mais le compte financé n'apparaît toujours pas. Pourquoi ?", a: "La firme n'a peut-être pas fini de provisionner le compte après l'achat, ou vous avez trop de sessions actives. Attendez un peu, déconnectez-vous partout et réessayez. Si cela persiste, seule votre prop firm peut activer le compte." },
    { q: "Le support Tradovate peut-il régler cela pour moi ?", a: "Pour les comptes de prop firm, non. La firme possède et gère le compte d'évaluation, donc Tradovate ne peut pas réinitialiser le mot de passe ni restaurer l'accès. Contactez le support de votre prop firm pour tout ce qui concerne spécifiquement le compte." },
    { q: "Pourquoi mon compte Tradovate personnel continue-t-il de se charger au lieu de l'évaluation ?", a: "Des identifiants enregistrés ou le remplissage automatique vous connectent à votre propre compte. Déconnectez-vous complètement, effacez la connexion enregistrée si nécessaire, et saisissez manuellement le nom d'utilisateur et le mot de passe émis par la firme." },
    { q: "Cette erreur affectera-t-elle les règles de mon évaluation ou réinitialisera-t-elle ma progression ?", a: "Non. Voir &ldquo;Fund Your Account&rdquo; n'est que l'affichage d'un compte vide sur lequel vous ne devriez pas être, cela ne touche ni votre solde d'évaluation, ni votre drawdown, ni votre historique de trades. Ceux-ci se trouvent sur le compte financé sous les identifiants de la firme." },
  ], it: [
    { q: "Devo davvero depositare denaro quando Tradovate mostra &ldquo;Fund Your Account&rdquo; sulla mia evaluation?", a: "No. Un account di evaluation prop o finanziato in simulazione viene capitalizzato dalla firm con fondi simulati. Il messaggio appare solo perché sta visualizzando un account personale o vuoto. Non depositi mai denaro proprio per farlo sparire, effettui invece l'accesso con le credenziali della firm." },
    { q: "Qual è la differenza tra il mio login della dashboard e il mio login Tradovate?", a: "Il suo login della dashboard è l'e-mail e la password per il portale membri della firm, dove acquista evaluation e richiede payout. Il suo login Tradovate è un nome utente di trading separato rilasciato dalla firm (spesso in formato TRAD######) e una password usati solo per accedere alla piattaforma. Confonderli è la causa principale di questo errore." },
    { q: "Dove trovo le mie credenziali di trading Tradovate?", a: "Sono mostrate nella dashboard della sua prop firm, di solito vicino alla parte superiore della pagina o nel pannello account/credenziali. Copi da lì il nome utente di trading e la password rilasciata dalla firm, non la sua e-mail di registrazione." },
    { q: "Quale ambiente devo scegliere al login, Live o Demo?", a: "Le evaluation e gli account finanziati in simulazione funzionano quasi sempre sull'ambiente Demo/Simulazione. Scegliere Live fa sì che Tradovate cerchi un account broker live che lei non ha. L'etichetta esatta può cambiare, quindi la confermi nella schermata di login attuale." },
    { q: "Ho usato le credenziali giuste ma l'account finanziato ancora non c'è. Perché?", a: "È possibile che la firm non abbia finito di predisporre l'account dopo l'acquisto, oppure che abbia troppe sessioni attive. Attenda un po', esca da ovunque e riprovi. Se persiste, solo la sua prop firm può attivare l'account." },
    { q: "Il supporto Tradovate può risolvere questo per me?", a: "Per gli account delle prop firm, no. La firm possiede e gestisce l'account di evaluation, quindi Tradovate non può reimpostare la password né ripristinare l'accesso. Contatti il supporto della sua prop firm per qualsiasi questione specifica dell'account." },
    { q: "Perché continua a caricarsi il mio account Tradovate personale invece dell'evaluation?", a: "Credenziali salvate o il completamento automatico la stanno facendo accedere al suo account personale. Esca completamente, cancelli il login salvato se necessario, e inserisca manualmente il nome utente e la password rilasciati dalla firm." },
    { q: "Questo errore influirà sulle regole della mia evaluation o azzererà i miei progressi?", a: "No. Vedere &ldquo;Fund Your Account&rdquo; è solo la visualizzazione di un account vuoto su cui non dovrebbe trovarsi, non tocca il saldo della sua evaluation, il drawdown o lo storico delle operazioni. Questi si trovano sull'account finanziato sotto le credenziali della firm." },
  ] },
