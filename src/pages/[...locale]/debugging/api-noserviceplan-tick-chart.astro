---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "api-noserviceplan-tick-chart";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/debugging/${SLUG}`;

const META_TITLE = "Tradovate API 'NoServicePlan' Tick-Chart Error";
const META_DESCRIPTION =
  "Fix Tradovate's NoServicePlan API error, the 'real-time market data required for tick-base charts' mismatch, by reconciling your data entitlement fast.";

// Short SEO title (<=60 chars) for locales where the shared h1 is too long for a SERP title.
const TITLE_OVERRIDE: Partial<Record<Locale, string>> = { de: "Tradovate-API-Fehler „NoServicePlan“ im Tick-Chart", es: "Tradovate API “NoServicePlan” en el gráfico de ticks", fr: "API Tradovate : « NoServicePlan » sur graphique en ticks", it: "API Tradovate: “NoServicePlan” sul grafico a tick" };

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate API", de: "Tradovate API", es: "Tradovate API", fr: "Tradovate API", it: "Tradovate API" },
  h1: { en: META_TITLE, de: "Tradovate-API-Fehler &ldquo;NoServicePlan&rdquo; beim Tick-Chart", es: "Error de la API de Tradovate &ldquo;NoServicePlan&rdquo; en el gráfico de ticks", fr: "Erreur API Tradovate &laquo; NoServicePlan &raquo; sur le graphique en ticks", it: "Errore API Tradovate &ldquo;NoServicePlan&rdquo; sul grafico a tick" },
  dek: { en: "You paid for the API module and subscribed to market data, and your bot still can't pull a tick chart. Platform data and API real-time data are two separate entitlements, and NoServicePlan means the server doesn't see the second one.", de: "Sie haben das API-Modul bezahlt und Marktdaten abonniert, doch Ihr Bot kann immer noch keinen Tick-Chart abrufen. Plattformdaten und Echtzeit-API-Daten sind zwei getrennte Berechtigungen, und NoServicePlan bedeutet, dass der Server die zweite nicht erkennt.", es: "Ha pagado el módulo de la API y se ha suscrito a los datos de mercado, y su bot todavía no puede obtener un gráfico de ticks. Los datos de la plataforma y los datos en tiempo real de la API son dos autorizaciones independientes, y NoServicePlan significa que el servidor no reconoce la segunda.", fr: "Vous avez payé le module API et souscrit aux données de marché, et votre bot n'arrive toujours pas à récupérer un graphique en ticks. Les données de la plateforme et les données API en temps réel sont deux droits d'accès distincts, et NoServicePlan signifie que le serveur ne reconnaît pas le second.", it: "Ha pagato il modulo API e si è abbonato ai dati di mercato, ma il suo bot non riesce ancora a ottenere un grafico a tick. I dati della piattaforma e i dati API in tempo reale sono due diritti separati, e NoServicePlan significa che il server non riconosce il secondo." },
  readTime: { en: "8 min read", de: "8 Minuten Lesezeit", es: "Lectura de 8 minutos", fr: "Lecture de 8 minutes", it: "Lettura di 8 minuti" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "You paid for the API module, you subscribed to market data inside Tradovate, and your bot still can't pull a tick chart. Instead of a data stream you get back a flat refusal: <code>A real-time market data subscription is required for tick-base charts</code>, error code <code>NoServicePlan</code>. It's maddening precisely because you <em>did</em> buy something. The catch is that Tradovate treats platform market data and API real-time market data as two separate entitlements, and <code>NoServicePlan</code> is the server telling you the plan it sees on your API session doesn't cover what a tick chart needs. This one rarely gets fixed by changing your code, it gets fixed by reconciling what you actually own with what the server recognizes. Here's the full breakdown." },
    {
      type: "checklist",
      heading: "Quick Checklist for \"NoServicePlan\"",
      items: [
        "<strong class='text-white'>Platform data ≠ API data</strong>, the subscription you accept in the Tradovate trader is not the same entitlement that authorizes real-time streaming over the API WebSocket.",
        "<strong class='text-white'>Tick charts demand a live feed</strong>, a tick-based chart is built from individual trades, so it can't run on delayed data. This is why the block is tick-specific.",
        "<strong class='text-white'>Real-time API data is CME-gated</strong>, streaming live exchange data through the API requires a CME sub-vendor arrangement and a server-side whitelist on your account.",
        "<strong class='text-white'>Prop/eval accounts are controlled upstream</strong>, you can't reconcile the plan yourself; the firm has to enable data.",
        "<strong class='text-white'>Entitlements drift</strong>, a plan that worked can fall out of sync after billing, a renewal, or a support edit. Re-authenticate, then contact support to reconcile.",
        "<strong class='text-white'>Workaround exists</strong>, request a time-based chart instead of ticks, or run orders-only automation and skip the real-time API feed entirely.",
      ],
    },
    { type: "heading", text: "What \"NoServicePlan\" Means" },
    { type: "paragraph", html: "Read the message literally and it makes sense: <em>a real-time market data subscription is required for tick-base charts</em>. The <code>NoServicePlan</code> code is the machine version of &ldquo;the service plan on this session doesn't include what you're asking for.&rdquo; Your WebSocket request was well-formed and it reached the server, nothing is wrong with your JSON or your token. The server simply looked at the market-data entitlement tied to your API login, didn't find a real-time plan that covers tick data, and bounced the request." },
    { type: "paragraph", html: "The reason people find this so confusing is that they've genuinely paid. They bought the API Access add-on. They accepted a market-data agreement in the Tradovate front end and can see live quotes on the web platform. So when the API refuses a tick chart, it feels like a bug. It isn't. Those two things sit in different lanes, and <code>NoServicePlan</code> lives in the lane you probably haven't set up yet." },
    { type: "heading", text: "Why Tick Charts Get Singled Out" },
    { type: "paragraph", html: "A tick chart isn't measured in time, it's measured in trades. Each bar closes after a set number of ticks (individual transactions) print, so the chart has to consume the live trade-by-trade stream to draw anything current. Delayed or snapshot data can't feed a live tick chart. That's why <code>NoServicePlan</code> calls out tick-base charts by name: a minute chart might tolerate delayed data in some contexts, but a real-time tick chart has no fallback. No live feed, no tick chart." },
    { type: "heading", text: "Top Causes of \"NoServicePlan\"" },
    { type: "heading", text: "1. Platform Market Data Mistaken for API Market Data" },
    { type: "paragraph", html: "This is the number-one cause. The market-data subscription you accept inside the Tradovate trader entitles the <em>platform</em>, the web and desktop apps, to show you live quotes. It does not automatically entitle the API WebSocket feed. Those are billed and licensed separately. If the only thing you've done is subscribe to data inside the trader UI, your API session still has no real-time plan attached, and every tick request comes back <code>NoServicePlan</code>." },
    { type: "heading", text: "2. No CME Sub-Vendor Registration / Whitelist" },
    { type: "paragraph", html: "Streaming real-time exchange data through the API is gated behind a CME arrangement. Tradovate registers API users as sub-vendors under the exchange's license, and until that's in place, and your account is whitelisted on Tradovate's side, the server has no real-time API plan to hand you. This carries a monthly exchange fee paid to the CME, not to Tradovate. Any specific dollar figure you find in an old post is likely stale; the amount depends on the exchange and your license type (non-professional vs. professional / non-display) and it changes, so confirm the current rate with the CME and Tradovate directly." },
    { type: "heading", text: "3. A Prop or Evaluation Account You Don't Control" },
    { type: "paragraph", html: "If your login is tied to a prop firm or an evaluation service, the data entitlements belong to that provider, not to you. You can't accept a data agreement or reconcile a plan on their account from inside Tradovate, the controls are managed upstream. An API session on an evaluation account will keep returning <code>NoServicePlan</code> on tick requests until the firm turns real-time data on for that account. The people to talk to are the firm's support, not Tradovate's." },
    { type: "heading", text: "4. A Drifted or Lapsed Entitlement" },
    { type: "paragraph", html: "Sometimes the plan was set up correctly and then fell out of sync. A billing cycle rolls over, a plan change gets applied, an agreement lapses, or a support-side account edit doesn't propagate cleanly, and suddenly a session that streamed tick data yesterday returns <code>NoServicePlan</code> today. This is exactly the &ldquo;mismatch the API doesn't recognize&rdquo; situation: your records say you're entitled, the server's don't. Re-authenticating clears the easy version (a stale session); the stubborn version needs support to reconcile the account." },
    { type: "heading", text: "5. Requesting Ticks When You Didn't Mean To" },
    { type: "paragraph", html: "Worth a sanity check: confirm your chart request is actually asking for a tick-based element and that you need it. Some libraries and wrappers default a chart request to a tick unit. If your strategy runs on minute or second bars, you may be triggering the strictest entitlement requirement without realizing it, switching the request to a time interval can quietly make the error disappear." },
    { type: "heading", text: "How to Fix \"NoServicePlan\": Step-by-Step" },
    {
      type: "steps",
      items: [
        { title: "Confirm which entitlement you actually have", html: "Log in to the Tradovate web or desktop platform with the same account your API key authenticates against. Open <strong class='text-white'>Application Settings</strong> and go to the market-data / subscriptions area. Note what's active. Seeing live quotes in the trader tells you the <em>platform</em> entitlement is on, it does not confirm an API real-time plan. Ask yourself the key question: have you completed a CME sub-vendor registration and been whitelisted for API market data? If not, that's your gap, and no code change will close it." },
        { title: "Set up real-time API data (if you truly need ticks)", html: "Contact the CME to register as a sub-vendor under their license arrangement for real-time futures data. Budget for the monthly exchange fee, it's paid to the CME, and the current amount varies by exchange and license type, so verify it before committing. Notify Tradovate support that you've registered, and ask them to <strong class='text-white'>whitelist your account for API market data</strong>. Once they confirm the whitelist, re-authenticate and re-issue your tick chart / <code>md/subscribeQuote</code> request. The plan should now resolve." },
        { title: "Reconcile a drifted entitlement with support", html: "First rule out a stale session: discard your cached access token, re-run the authentication flow, reconnect the market-data WebSocket, and retry. If tick requests still return <code>NoServicePlan</code> across <em>every</em> symbol, the plan itself is out of sync. This is not something you can force from the client. Open a ticket with Tradovate support. State plainly what you purchased (API Access, any data subscription, sub-vendor registration) and paste the exact error, including the <code>NoServicePlan</code> code and the tick-base message. Ask them to verify the real-time market-data plan is active and correctly attached to your API account, and to re-apply the whitelist if it lapsed. On a prop/eval account, send this request to the firm instead." },
        { title: "Or sidestep it entirely", html: "If you don't need ticks, change your chart request from a tick unit to a time interval (minute/second). This often clears the tick-specific block outright. If you don't need Tradovate's real-time feed at all, run <strong class='text-white'>orders-only</strong> automation, place orders, manage positions, and query the account without a real-time data plan. Source your live data from a third-party market-data vendor or use free delayed data for signals, and keep execution on Tradovate." },
      ],
    },
    { type: "heading", text: "Troubleshooting Table" },
    {
      type: "table",
      headers: ["Symptom", "Likely cause", "What to do"],
      rows: [
        ["NoServicePlan on a tick chart, but live quotes show in the trader UI", "Platform data active, API real-time data not entitled", "Set up CME sub-vendor registration and ask Tradovate to whitelist the account"],
        ["NoServicePlan on every symbol via API", "No real-time API plan attached to the session", "Complete API market-data entitlement, then re-authenticate"],
        ["Only a prop/eval account throws it", "Data controlled by the account provider", "Ask the prop firm to enable market data for that account"],
        ["Worked yesterday, fails today", "Entitlement drifted or lapsed after billing/renewal", "Re-authenticate; if it persists, have support reconcile the plan"],
        ["Fails only on tick units, minute charts load", "Tick charts require a live feed delayed data can't provide", "Switch to a time interval, or enable real-time data"],
        ["You don't actually need real-time API data", "Paying for a plan you won't use", "Run orders-only automation or use a third-party data source"],
      ],
    },
    { type: "heading", text: "Where PickMyTrade Fits" },
    { type: "paragraph", html: "Most people hitting <code>NoServicePlan</code> don't actually want to run a raw market-data pipe through the Tradovate API, they want their strategy to fire on Tradovate. PickMyTrade lets you do exactly that without touching the CME sub-vendor feed at all:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Signal on TradingView, execute on Tradovate</strong>, your charts and tick logic live in TradingView, so you never have to pull real-time data through the Tradovate API to trade it.",
        "<strong class='text-white'>Orders-only routing</strong>, PickMyTrade sends orders and manages positions, sidestepping the entire real-time API market-data entitlement that triggers NoServicePlan.",
        "<strong class='text-white'>Managed authentication</strong>, tokens and sessions stay fresh, so a stale login never masquerades as an entitlement problem.",
        "<strong class='text-white'>Multi-account sync</strong>, mirror the same alert across every connected account in one pass, no per-account data plan required.",
      ],
    },
  ], de: [
    { type: "paragraph", html: "Sie haben das API-Modul bezahlt, Sie haben Marktdaten innerhalb von Tradovate abonniert, und Ihr Bot kann trotzdem keinen Tick-Chart abrufen. Statt eines Datenstroms erhalten Sie eine klare Ablehnung: <code>A real-time market data subscription is required for tick-base charts</code>, Fehlercode <code>NoServicePlan</code>. Das ist besonders frustrierend, weil Sie <em>tatsächlich</em> etwas gekauft haben. Der Haken ist, dass Tradovate Plattform-Marktdaten und Echtzeit-API-Marktdaten als zwei getrennte Berechtigungen behandelt, und <code>NoServicePlan</code> ist die Meldung des Servers, dass der auf Ihrer API-Sitzung erkannte Plan nicht das abdeckt, was ein Tick-Chart benötigt. Dieses Problem lässt sich selten durch eine Codeänderung beheben, sondern nur, indem Sie das, was Sie tatsächlich besitzen, mit dem abgleichen, was der Server erkennt. Hier die vollständige Übersicht." },
    {
      type: "checklist",
      heading: "Kurz-Checkliste für &ldquo;NoServicePlan&rdquo;",
      items: [
        "<strong class='text-white'>Plattformdaten ≠ API-Daten</strong>, das Abonnement, das Sie im Tradovate-Trader akzeptieren, ist nicht dieselbe Berechtigung, die Echtzeit-Streaming über das API-WebSocket autorisiert.",
        "<strong class='text-white'>Tick-Charts benötigen einen Live-Feed</strong>, ein tickbasierter Chart wird aus einzelnen Trades erstellt und kann daher nicht mit verzögerten Daten arbeiten. Deshalb betrifft die Sperre speziell Ticks.",
        "<strong class='text-white'>Echtzeit-API-Daten sind an die CME gebunden</strong>, das Streamen von Live-Börsendaten über die API erfordert eine Sub-Vendor-Vereinbarung mit der CME und eine serverseitige Whitelist für Ihr Konto.",
        "<strong class='text-white'>Prop-/Eval-Konten werden vorgelagert kontrolliert</strong>, Sie können den Plan nicht selbst abgleichen; die Firma muss die Daten freischalten.",
        "<strong class='text-white'>Berechtigungen laufen auseinander</strong>, ein zuvor funktionierender Plan kann nach einer Abrechnung, einer Verlängerung oder einer Support-Änderung aus dem Takt geraten. Authentifizieren Sie sich erneut und kontaktieren Sie anschließend den Support zum Abgleich.",
        "<strong class='text-white'>Es gibt einen Workaround</strong>, fordern Sie statt Ticks einen zeitbasierten Chart an, oder nutzen Sie eine reine Order-Automatisierung und verzichten Sie ganz auf den Echtzeit-API-Feed.",
      ],
    },
    { type: "heading", text: "Was &ldquo;NoServicePlan&rdquo; bedeutet" },
    { type: "paragraph", html: "Liest man die Meldung wörtlich, ergibt sie Sinn: <em>a real-time market data subscription is required for tick-base charts</em>. Der Code <code>NoServicePlan</code> ist die maschinelle Version von &ldquo;der Service-Plan dieser Sitzung enthält nicht das, was Sie anfragen.&rdquo; Ihre WebSocket-Anfrage war korrekt formatiert und hat den Server erreicht, mit Ihrem JSON oder Ihrem Token stimmt nichts nicht. Der Server hat lediglich die mit Ihrem API-Login verknüpfte Marktdaten-Berechtigung geprüft, keinen Echtzeit-Plan gefunden, der Tick-Daten abdeckt, und die Anfrage abgelehnt." },
    { type: "paragraph", html: "Für viele ist das so verwirrend, weil sie tatsächlich bezahlt haben. Sie haben das Zusatzmodul API Access gekauft. Sie haben eine Marktdatenvereinbarung im Tradovate-Frontend akzeptiert und sehen Live-Kurse auf der Web-Plattform. Wenn die API dann einen Tick-Chart verweigert, fühlt sich das wie ein Fehler an. Ist es aber nicht. Diese beiden Dinge laufen auf getrennten Spuren, und <code>NoServicePlan</code> liegt in der Spur, die Sie wahrscheinlich noch nicht eingerichtet haben." },
    { type: "heading", text: "Warum Tick-Charts besonders betroffen sind" },
    { type: "paragraph", html: "Ein Tick-Chart wird nicht in Zeit gemessen, sondern in Trades. Jeder Balken schließt, nachdem eine festgelegte Anzahl von Ticks (einzelnen Transaktionen) erfasst wurde, daher muss der Chart den Live-Trade-für-Trade-Stream verarbeiten, um überhaupt etwas Aktuelles darzustellen. Verzögerte Daten oder Snapshots können einen Live-Tick-Chart nicht speisen. Deshalb nennt <code>NoServicePlan</code> tickbasierte Charts ausdrücklich: Ein Minuten-Chart toleriert in manchen Fällen verzögerte Daten, ein Echtzeit-Tick-Chart hat jedoch keine Rückfalloption. Kein Live-Feed, kein Tick-Chart." },
    { type: "heading", text: "Häufigste Ursachen für &ldquo;NoServicePlan&rdquo;" },
    { type: "heading", text: "1. Plattform-Marktdaten mit API-Marktdaten verwechselt" },
    { type: "paragraph", html: "Das ist die häufigste Ursache. Das Marktdaten-Abonnement, das Sie im Tradovate-Trader akzeptieren, berechtigt die <em>Plattform</em>, also die Web- und Desktop-Apps, dazu, Ihnen Live-Kurse anzuzeigen. Es berechtigt nicht automatisch den API-WebSocket-Feed. Beide werden separat abgerechnet und lizenziert. Wenn Sie lediglich Daten innerhalb der Trader-Oberfläche abonniert haben, ist Ihrer API-Sitzung weiterhin kein Echtzeit-Plan zugeordnet, und jede Tick-Anfrage liefert <code>NoServicePlan</code> zurück." },
    { type: "heading", text: "2. Keine CME-Sub-Vendor-Registrierung / Whitelist" },
    { type: "paragraph", html: "Das Streamen von Echtzeit-Börsendaten über die API ist an eine Vereinbarung mit der CME gebunden. Tradovate registriert API-Nutzer als Sub-Vendor unter der Lizenz der Börse, und solange das nicht eingerichtet ist und Ihr Konto nicht auf Seiten von Tradovate auf der Whitelist steht, hat der Server keinen Echtzeit-API-Plan, den er Ihnen zuweisen kann. Damit ist eine monatliche Börsengebühr verbunden, die an die CME gezahlt wird, nicht an Tradovate. Ein konkreter Betrag aus einem älteren Beitrag ist wahrscheinlich veraltet; die Höhe hängt von der Börse und Ihrem Lizenztyp ab (nicht-professionell vs. professionell / non-display) und ändert sich, bestätigen Sie den aktuellen Satz daher direkt bei der CME und bei Tradovate." },
    { type: "heading", text: "3. Ein Prop- oder Evaluierungskonto, das Sie nicht kontrollieren" },
    { type: "paragraph", html: "Wenn Ihr Login mit einer Prop-Firma oder einem Evaluierungsdienst verknüpft ist, gehören die Datenberechtigungen diesem Anbieter, nicht Ihnen. Sie können auf deren Konto keine Datenvereinbarung akzeptieren oder einen Plan innerhalb von Tradovate abgleichen, die Kontrolle liegt vorgelagert. Eine API-Sitzung auf einem Evaluierungskonto liefert bei Tick-Anfragen weiterhin <code>NoServicePlan</code>, bis die Firma Echtzeitdaten für dieses Konto aktiviert. Ansprechpartner ist der Support der Firma, nicht der von Tradovate." },
    { type: "heading", text: "4. Eine verschobene oder abgelaufene Berechtigung" },
    { type: "paragraph", html: "Manchmal wurde der Plan korrekt eingerichtet und ist danach aus dem Takt geraten. Ein Abrechnungszyklus wechselt, eine Planänderung wird angewendet, eine Vereinbarung läuft aus, oder eine Konto-Änderung seitens des Supports wird nicht sauber übernommen, und plötzlich liefert eine Sitzung, die gestern noch Tick-Daten gestreamt hat, heute <code>NoServicePlan</code>. Das ist genau die Situation, in der &ldquo;eine Diskrepanz vorliegt, die die API nicht erkennt&rdquo;: Ihre Unterlagen sagen, Sie sind berechtigt, die des Servers nicht. Eine erneute Authentifizierung behebt die einfache Variante (eine veraltete Sitzung); die hartnäckige Variante erfordert, dass der Support das Konto abgleicht." },
    { type: "heading", text: "5. Ticks anfordern, ohne es zu wollen" },
    { type: "paragraph", html: "Ein kurzer Sanity-Check lohnt sich: Prüfen Sie, ob Ihre Chart-Anfrage tatsächlich ein tickbasiertes Element anfordert und ob Sie das wirklich brauchen. Manche Bibliotheken und Wrapper stellen eine Chart-Anfrage standardmäßig auf eine Tick-Einheit. Wenn Ihre Strategie auf Minuten- oder Sekundenbalken läuft, lösen Sie möglicherweise unbewusst die strengste Berechtigungsanforderung aus, das Umstellen der Anfrage auf ein Zeitintervall kann den Fehler still und leise verschwinden lassen." },
    { type: "heading", text: "So beheben Sie &ldquo;NoServicePlan&rdquo;: Schritt für Schritt" },
    {
      type: "steps",
      items: [
        { title: "Prüfen Sie, welche Berechtigung Sie tatsächlich haben", html: "Melden Sie sich in der Tradovate-Web- oder Desktop-Plattform mit demselben Konto an, gegen das sich Ihr API-Schlüssel authentifiziert. Öffnen Sie <strong class='text-white'>Application Settings</strong> und wechseln Sie zum Bereich Marktdaten/Abonnements. Notieren Sie sich, was aktiv ist. Live-Kurse im Trader zu sehen bedeutet, dass die <em>Plattform</em>-Berechtigung aktiv ist, es bestätigt jedoch keinen Echtzeit-API-Plan. Stellen Sie sich die entscheidende Frage: Haben Sie eine CME-Sub-Vendor-Registrierung abgeschlossen und wurden für API-Marktdaten auf die Whitelist gesetzt? Falls nicht, ist das Ihre Lücke, und keine Codeänderung wird sie schließen." },
        { title: "Richten Sie Echtzeit-API-Daten ein (falls Sie wirklich Ticks benötigen)", html: "Wenden Sie sich an die CME, um sich im Rahmen ihrer Lizenzvereinbarung für Echtzeit-Futures-Daten als Sub-Vendor zu registrieren. Kalkulieren Sie die monatliche Börsengebühr ein, sie wird an die CME gezahlt, und der aktuelle Betrag variiert je nach Börse und Lizenztyp, prüfen Sie ihn also vor der Verpflichtung. Informieren Sie den Tradovate-Support über Ihre Registrierung und bitten Sie ihn, <strong class='text-white'>Ihr Konto für API-Marktdaten auf die Whitelist zu setzen</strong>. Sobald die Whitelist bestätigt ist, authentifizieren Sie sich erneut und senden Sie Ihre Tick-Chart- / <code>md/subscribeQuote</code>-Anfrage erneut. Der Plan sollte nun aufgelöst werden." },
        { title: "Gleichen Sie eine verschobene Berechtigung mit dem Support ab", html: "Schließen Sie zunächst eine veraltete Sitzung aus: Verwerfen Sie Ihr zwischengespeichertes Access-Token, führen Sie den Authentifizierungsablauf erneut aus, verbinden Sie das Marktdaten-WebSocket neu und versuchen Sie es erneut. Wenn Tick-Anfragen bei <em>jedem</em> Symbol weiterhin <code>NoServicePlan</code> zurückgeben, ist der Plan selbst aus dem Takt geraten. Das können Sie nicht clientseitig erzwingen. Eröffnen Sie ein Ticket beim Tradovate-Support. Beschreiben Sie klar, was Sie erworben haben (API Access, jegliches Datenabonnement, Sub-Vendor-Registrierung) und fügen Sie den genauen Fehler ein, einschließlich des Codes <code>NoServicePlan</code> und der Tick-Meldung. Bitten Sie sie, zu prüfen, ob der Echtzeit-Marktdaten-Plan aktiv und korrekt mit Ihrem API-Konto verknüpft ist, und die Whitelist erneut anzuwenden, falls sie abgelaufen ist. Bei einem Prop-/Eval-Konto senden Sie diese Anfrage stattdessen an die Firma." },
        { title: "Oder umgehen Sie das Problem ganz", html: "Wenn Sie keine Ticks benötigen, ändern Sie Ihre Chart-Anfrage von einer Tick-Einheit auf ein Zeitintervall (Minute/Sekunde). Das beseitigt die tickspezifische Sperre häufig sofort. Wenn Sie den Echtzeit-Feed von Tradovate überhaupt nicht benötigen, nutzen Sie eine reine <strong class='text-white'>Order</strong>-Automatisierung: Orders platzieren, Positionen verwalten und das Konto abfragen, ohne einen Echtzeit-Datenplan. Beziehen Sie Ihre Live-Daten von einem Drittanbieter für Marktdaten oder nutzen Sie kostenlose verzögerte Daten für Signale, und lassen Sie die Ausführung weiterhin über Tradovate laufen." },
      ],
    },
    { type: "heading", text: "Fehlerbehebungstabelle" },
    {
      type: "table",
      headers: ["Symptom", "Wahrscheinliche Ursache", "Was zu tun ist"],
      rows: [
        ["NoServicePlan bei einem Tick-Chart, aber Live-Kurse werden in der Trader-Oberfläche angezeigt", "Plattformdaten aktiv, keine Berechtigung für API-Echtzeitdaten", "CME-Sub-Vendor-Registrierung einrichten und Tradovate bitten, das Konto auf die Whitelist zu setzen"],
        ["NoServicePlan bei jedem Symbol über die API", "Kein Echtzeit-API-Plan mit der Sitzung verknüpft", "API-Marktdaten-Berechtigung abschließen und anschließend erneut authentifizieren"],
        ["Tritt nur bei einem Prop-/Eval-Konto auf", "Daten werden vom Kontoanbieter kontrolliert", "Bitten Sie die Prop-Firma, Marktdaten für dieses Konto zu aktivieren"],
        ["Hat gestern funktioniert, schlägt heute fehl", "Berechtigung nach Abrechnung/Verlängerung verschoben oder abgelaufen", "Erneut authentifizieren; bei anhaltendem Problem den Support zum Abgleich des Plans kontaktieren"],
        ["Schlägt nur bei Tick-Einheiten fehl, Minuten-Charts laden", "Tick-Charts benötigen einen Live-Feed, den verzögerte Daten nicht liefern können", "Auf ein Zeitintervall umstellen oder Echtzeitdaten aktivieren"],
        ["Sie benötigen eigentlich gar keine Echtzeit-API-Daten", "Sie zahlen für einen Plan, den Sie nicht nutzen", "Reine Order-Automatisierung nutzen oder auf eine Drittanbieter-Datenquelle zurückgreifen"],
      ],
    },
    { type: "heading", text: "Wo PickMyTrade ins Spiel kommt" },
    { type: "paragraph", html: "Die meisten Nutzer, die auf <code>NoServicePlan</code> stoßen, wollen gar keine rohe Marktdatenverbindung über die Tradovate-API betreiben, sie wollen, dass ihre Strategie auf Tradovate ausgeführt wird. Mit PickMyTrade können Sie genau das tun, ohne überhaupt den CME-Sub-Vendor-Feed anzufassen:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Signale in TradingView, Ausführung in Tradovate</strong>, Ihre Charts und Ihre Tick-Logik liegen in TradingView, sodass Sie nie Echtzeitdaten über die Tradovate-API abrufen müssen, um damit zu handeln.",
        "<strong class='text-white'>Reines Order-Routing</strong>, PickMyTrade sendet Orders und verwaltet Positionen, wodurch die gesamte Echtzeit-API-Marktdaten-Berechtigung, die NoServicePlan auslöst, umgangen wird.",
        "<strong class='text-white'>Verwaltete Authentifizierung</strong>, Tokens und Sitzungen bleiben aktuell, sodass sich ein veralteter Login nie als Berechtigungsproblem tarnt.",
        "<strong class='text-white'>Multi-Account-Synchronisierung</strong>, spiegeln Sie denselben Alert in einem Durchgang auf jedes verbundene Konto, ohne dass ein Datenplan pro Konto erforderlich ist.",
      ],
    },
  ], es: [
    { type: "paragraph", html: "Ha pagado el módulo de la API, se ha suscrito a los datos de mercado dentro de Tradovate, y su bot sigue sin poder obtener un gráfico de ticks. En lugar de un flujo de datos, recibe un rechazo tajante: <code>A real-time market data subscription is required for tick-base charts</code>, código de error <code>NoServicePlan</code>. Resulta exasperante precisamente porque <em>sí</em> ha comprado algo. La trampa es que Tradovate trata los datos de mercado de la plataforma y los datos de mercado en tiempo real de la API como dos autorizaciones independientes, y <code>NoServicePlan</code> es el servidor indicándole que el plan que ve en su sesión de la API no cubre lo que necesita un gráfico de ticks. Esto rara vez se soluciona cambiando su código, se soluciona conciliando lo que realmente posee con lo que el servidor reconoce. Aquí tiene el desglose completo." },
    {
      type: "checklist",
      heading: "Lista de verificación rápida para &ldquo;NoServicePlan&rdquo;",
      items: [
        "<strong class='text-white'>Datos de la plataforma ≠ datos de la API</strong>, la suscripción que acepta en el trader de Tradovate no es la misma autorización que habilita el streaming en tiempo real a través del WebSocket de la API.",
        "<strong class='text-white'>Los gráficos de ticks exigen un feed en vivo</strong>, un gráfico basado en ticks se construye a partir de operaciones individuales, por lo que no puede funcionar con datos retrasados. Por eso el bloqueo es específico de los ticks.",
        "<strong class='text-white'>Los datos de la API en tiempo real dependen de la CME</strong>, transmitir datos en vivo de la bolsa a través de la API requiere un acuerdo de subproveedor con la CME y una lista blanca del lado del servidor en su cuenta.",
        "<strong class='text-white'>Las cuentas prop/de evaluación se controlan aguas arriba</strong>, no puede conciliar el plan usted mismo; la empresa debe habilitar los datos.",
        "<strong class='text-white'>Las autorizaciones se desincronizan</strong>, un plan que funcionaba puede desincronizarse tras la facturación, una renovación o una modificación del soporte. Vuelva a autenticarse y luego contacte con el soporte para conciliarlo.",
        "<strong class='text-white'>Existe una solución alternativa</strong>, solicite un gráfico basado en tiempo en lugar de ticks, o ejecute una automatización de solo órdenes y prescinda por completo del feed de la API en tiempo real.",
      ],
    },
    { type: "heading", text: "Qué significa &ldquo;NoServicePlan&rdquo;" },
    { type: "paragraph", html: "Si se lee el mensaje literalmente, tiene sentido: <em>a real-time market data subscription is required for tick-base charts</em>. El código <code>NoServicePlan</code> es la versión automática de &ldquo;el plan de servicio de esta sesión no incluye lo que está solicitando.&rdquo; Su solicitud de WebSocket estaba bien formada y llegó al servidor, no hay nada mal en su JSON ni en su token. El servidor simplemente comprobó la autorización de datos de mercado vinculada a su inicio de sesión de la API, no encontró un plan en tiempo real que cubra los datos de ticks, y rechazó la solicitud." },
    { type: "paragraph", html: "El motivo por el que esto resulta tan confuso es que realmente han pagado. Compraron el complemento API Access. Aceptaron un acuerdo de datos de mercado en el frontend de Tradovate y pueden ver cotizaciones en vivo en la plataforma web. Así que cuando la API rechaza un gráfico de ticks, parece un error. No lo es. Esas dos cosas van por caminos distintos, y <code>NoServicePlan</code> pertenece al camino que probablemente todavía no ha configurado." },
    { type: "heading", text: "Por qué los gráficos de ticks reciben un trato especial" },
    { type: "paragraph", html: "Un gráfico de ticks no se mide en tiempo, se mide en operaciones. Cada barra se cierra tras registrarse un número determinado de ticks (transacciones individuales), por lo que el gráfico necesita consumir el flujo de operaciones en vivo para mostrar algo actual. Los datos retrasados o instantáneos no pueden alimentar un gráfico de ticks en vivo. Por eso <code>NoServicePlan</code> menciona explícitamente los gráficos basados en ticks: un gráfico de minutos puede tolerar datos retrasados en algunos contextos, pero un gráfico de ticks en tiempo real no tiene alternativa. Sin feed en vivo, no hay gráfico de ticks." },
    { type: "heading", text: "Principales causas de &ldquo;NoServicePlan&rdquo;" },
    { type: "heading", text: "1. Confundir los datos de mercado de la plataforma con los datos de mercado de la API" },
    { type: "paragraph", html: "Esta es la causa número uno. La suscripción a datos de mercado que acepta dentro del trader de Tradovate autoriza a la <em>plataforma</em>, las aplicaciones web y de escritorio, a mostrarle cotizaciones en vivo. No autoriza automáticamente el feed WebSocket de la API. Ambos se facturan y se licencian por separado. Si lo único que ha hecho es suscribirse a datos dentro de la interfaz del trader, su sesión de la API sigue sin tener ningún plan en tiempo real asociado, y cada solicitud de ticks devuelve <code>NoServicePlan</code>." },
    { type: "heading", text: "2. Sin registro de subproveedor de la CME ni lista blanca" },
    { type: "paragraph", html: "La transmisión de datos de bolsa en tiempo real a través de la API está condicionada a un acuerdo con la CME. Tradovate registra a los usuarios de la API como subproveedores bajo la licencia de la bolsa, y hasta que eso no esté en marcha, y su cuenta esté en la lista blanca del lado de Tradovate, el servidor no tiene ningún plan de API en tiempo real que asignarle. Esto conlleva una tarifa mensual de la bolsa que se paga a la CME, no a Tradovate. Cualquier cifra concreta que encuentre en una publicación antigua probablemente esté desactualizada; el importe depende de la bolsa y de su tipo de licencia (no profesional frente a profesional / non-display) y cambia, así que confirme la tarifa vigente directamente con la CME y con Tradovate." },
    { type: "heading", text: "3. Una cuenta prop o de evaluación que usted no controla" },
    { type: "paragraph", html: "Si su inicio de sesión está vinculado a una empresa prop o a un servicio de evaluación, las autorizaciones de datos pertenecen a ese proveedor, no a usted. No puede aceptar un acuerdo de datos ni conciliar un plan en su cuenta desde dentro de Tradovate, los controles se gestionan aguas arriba. Una sesión de la API en una cuenta de evaluación seguirá devolviendo <code>NoServicePlan</code> en las solicitudes de ticks hasta que la empresa active los datos en tiempo real para esa cuenta. Debe contactar con el soporte de la empresa, no con el de Tradovate." },
    { type: "heading", text: "4. Una autorización desincronizada o caducada" },
    { type: "paragraph", html: "A veces el plan se configuró correctamente y luego se desincronizó. Un ciclo de facturación se renueva, se aplica un cambio de plan, un acuerdo caduca, o una modificación de la cuenta por parte del soporte no se propaga correctamente, y de repente una sesión que ayer transmitía datos de ticks hoy devuelve <code>NoServicePlan</code>. Esta es exactamente la situación de &ldquo;discrepancia que la API no reconoce&rdquo;: sus registros dicen que tiene autorización, los del servidor no. Volver a autenticarse resuelve la versión sencilla (una sesión caducada); la versión persistente requiere que el soporte concilie la cuenta." },
    { type: "heading", text: "5. Solicitar ticks sin querer" },
    { type: "paragraph", html: "Vale la pena una comprobación rápida: confirme que su solicitud de gráfico realmente pide un elemento basado en ticks y que realmente lo necesita. Algunas bibliotecas y wrappers configuran por defecto una solicitud de gráfico en una unidad de ticks. Si su estrategia funciona con barras de minutos o segundos, puede estar activando sin darse cuenta el requisito de autorización más estricto; cambiar la solicitud a un intervalo de tiempo puede hacer que el error desaparezca discretamente." },
    { type: "heading", text: "Cómo solucionar &ldquo;NoServicePlan&rdquo;: paso a paso" },
    {
      type: "steps",
      items: [
        { title: "Confirme qué autorización tiene realmente", html: "Inicie sesión en la plataforma web o de escritorio de Tradovate con la misma cuenta con la que se autentica su clave de la API. Abra <strong class='text-white'>Application Settings</strong> y vaya a la sección de datos de mercado / suscripciones. Anote qué está activo. Ver cotizaciones en vivo en el trader le indica que la autorización de la <em>plataforma</em> está activa, pero no confirma un plan de la API en tiempo real. Hágase la pregunta clave: ¿ha completado un registro de subproveedor de la CME y ha sido incluido en la lista blanca para datos de mercado de la API? Si no es así, ahí está su brecha, y ningún cambio de código la cerrará." },
        { title: "Configure los datos de la API en tiempo real (si realmente necesita ticks)", html: "Póngase en contacto con la CME para registrarse como subproveedor bajo su acuerdo de licencia para datos de futuros en tiempo real. Presupueste la tarifa mensual de la bolsa, se paga a la CME, y el importe actual varía según la bolsa y el tipo de licencia, así que verifíquelo antes de comprometerse. Notifique al soporte de Tradovate que se ha registrado y pídales que <strong class='text-white'>incluyan su cuenta en la lista blanca para datos de mercado de la API</strong>. Una vez que confirmen la lista blanca, vuelva a autenticarse y reenvíe su solicitud de gráfico de ticks / <code>md/subscribeQuote</code>. El plan debería resolverse ahora." },
        { title: "Concilie una autorización desincronizada con el soporte", html: "Primero descarte una sesión caducada: elimine su token de acceso en caché, vuelva a ejecutar el proceso de autenticación, reconecte el WebSocket de datos de mercado y vuelva a intentarlo. Si las solicitudes de ticks siguen devolviendo <code>NoServicePlan</code> en <em>todos</em> los símbolos, el propio plan está desincronizado. Esto no es algo que pueda forzar desde el cliente. Abra un ticket con el soporte de Tradovate. Indique claramente qué ha adquirido (API Access, cualquier suscripción de datos, registro de subproveedor) y pegue el error exacto, incluido el código <code>NoServicePlan</code> y el mensaje de ticks. Pídales que verifiquen que el plan de datos de mercado en tiempo real está activo y correctamente vinculado a su cuenta de la API, y que vuelvan a aplicar la lista blanca si caducó. En una cuenta prop/de evaluación, envíe esta solicitud a la empresa en su lugar." },
        { title: "O evítelo por completo", html: "Si no necesita ticks, cambie su solicitud de gráfico de una unidad de ticks a un intervalo de tiempo (minuto/segundo). Esto suele eliminar directamente el bloqueo específico de ticks. Si no necesita en absoluto el feed en tiempo real de Tradovate, ejecute una automatización de <strong class='text-white'>solo órdenes</strong>: coloque órdenes, gestione posiciones y consulte la cuenta sin un plan de datos en tiempo real. Obtenga sus datos en vivo de un proveedor de datos de mercado externo o utilice datos retrasados gratuitos para las señales, y mantenga la ejecución en Tradovate." },
      ],
    },
    { type: "heading", text: "Tabla de solución de problemas" },
    {
      type: "table",
      headers: ["Síntoma", "Causa probable", "Qué hacer"],
      rows: [
        ["NoServicePlan en un gráfico de ticks, pero las cotizaciones en vivo aparecen en la interfaz del trader", "Datos de la plataforma activos, sin autorización de datos en tiempo real de la API", "Configure el registro de subproveedor de la CME y pida a Tradovate que incluya la cuenta en la lista blanca"],
        ["NoServicePlan en todos los símbolos a través de la API", "Ningún plan de API en tiempo real asociado a la sesión", "Complete la autorización de datos de mercado de la API y vuelva a autenticarse"],
        ["Solo ocurre en una cuenta prop/de evaluación", "Datos controlados por el proveedor de la cuenta", "Pida a la empresa prop que habilite los datos de mercado para esa cuenta"],
        ["Funcionaba ayer, falla hoy", "Autorización desincronizada o caducada tras facturación/renovación", "Vuelva a autenticarse; si persiste, pida al soporte que concilie el plan"],
        ["Falla solo con unidades de ticks, los gráficos de minutos cargan", "Los gráficos de ticks requieren un feed en vivo que los datos retrasados no pueden ofrecer", "Cambie a un intervalo de tiempo o active los datos en tiempo real"],
        ["En realidad no necesita datos de la API en tiempo real", "Está pagando por un plan que no va a utilizar", "Ejecute una automatización de solo órdenes o utilice una fuente de datos externa"],
      ],
    },
    { type: "heading", text: "Dónde encaja PickMyTrade" },
    { type: "paragraph", html: "La mayoría de las personas que se topan con <code>NoServicePlan</code> en realidad no quieren gestionar un flujo de datos de mercado sin procesar a través de la API de Tradovate, quieren que su estrategia se ejecute en Tradovate. PickMyTrade le permite hacer exactamente eso sin tocar en absoluto el feed de subproveedor de la CME:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Señales en TradingView, ejecución en Tradovate</strong>, sus gráficos y su lógica de ticks residen en TradingView, por lo que nunca tiene que obtener datos en tiempo real a través de la API de Tradovate para operar.",
        "<strong class='text-white'>Enrutamiento solo de órdenes</strong>, PickMyTrade envía órdenes y gestiona posiciones, evitando por completo la autorización de datos de mercado de la API en tiempo real que desencadena NoServicePlan.",
        "<strong class='text-white'>Autenticación gestionada</strong>, los tokens y las sesiones se mantienen actualizados, de modo que un inicio de sesión caducado nunca se hace pasar por un problema de autorización.",
        "<strong class='text-white'>Sincronización multicuenta</strong>, replique la misma alerta en cada cuenta conectada en una sola pasada, sin necesidad de un plan de datos por cuenta.",
      ],
    },
  ], fr: [
    { type: "paragraph", html: "Vous avez payé le module API, vous vous êtes abonné aux données de marché dans Tradovate, et votre bot n'arrive toujours pas à récupérer un graphique en ticks. Au lieu d'un flux de données, vous obtenez un refus catégorique : <code>A real-time market data subscription is required for tick-base charts</code>, code d'erreur <code>NoServicePlan</code>. C'est d'autant plus exaspérant que vous <em>avez bel et bien</em> acheté quelque chose. Le piège, c'est que Tradovate considère les données de marché de la plateforme et les données de marché en temps réel de l'API comme deux droits d'accès distincts, et <code>NoServicePlan</code> signifie que le serveur constate que le plan associé à votre session API ne couvre pas ce dont un graphique en ticks a besoin. Ce problème se résout rarement en modifiant votre code, mais en faisant correspondre ce que vous possédez réellement avec ce que le serveur reconnaît. Voici le détail complet." },
    {
      type: "checklist",
      heading: "Liste de contrôle rapide pour &laquo; NoServicePlan &raquo;",
      items: [
        "<strong class='text-white'>Données de la plateforme ≠ données de l'API</strong>, l'abonnement que vous acceptez dans le trader Tradovate n'est pas le même droit d'accès que celui qui autorise le streaming en temps réel via le WebSocket de l'API.",
        "<strong class='text-white'>Les graphiques en ticks exigent un flux en direct</strong>, un graphique basé sur les ticks est construit à partir de transactions individuelles et ne peut donc pas fonctionner avec des données différées. C'est pourquoi le blocage est spécifique aux ticks.",
        "<strong class='text-white'>Les données API en temps réel sont soumises à la CME</strong>, la diffusion de données de marché en direct via l'API nécessite un accord de sous-fournisseur avec la CME et une liste blanche côté serveur sur votre compte.",
        "<strong class='text-white'>Les comptes prop/d'évaluation sont contrôlés en amont</strong>, vous ne pouvez pas réconcilier le plan vous-même ; c'est à la société de l'activer.",
        "<strong class='text-white'>Les droits d'accès se désynchronisent</strong>, un plan qui fonctionnait peut se désynchroniser après une facturation, un renouvellement ou une modification par le support. Réauthentifiez-vous, puis contactez le support pour réconcilier la situation.",
        "<strong class='text-white'>Une solution de contournement existe</strong>, demandez un graphique basé sur le temps plutôt que sur les ticks, ou exécutez une automatisation limitée aux ordres et passez-vous entièrement du flux API en temps réel.",
      ],
    },
    { type: "heading", text: "Ce que signifie &laquo; NoServicePlan &raquo;" },
    { type: "paragraph", html: "En lisant le message au pied de la lettre, il prend tout son sens : <em>a real-time market data subscription is required for tick-base charts</em>. Le code <code>NoServicePlan</code> est la version machine de &laquo; le plan de service de cette session ne comprend pas ce que vous demandez &raquo;. Votre requête WebSocket était correctement formée et a bien atteint le serveur, rien ne cloche dans votre JSON ni dans votre jeton. Le serveur a simplement vérifié le droit d'accès aux données de marché associé à votre connexion API, n'a trouvé aucun plan en temps réel couvrant les données de ticks, et a rejeté la requête." },
    { type: "paragraph", html: "Ce qui rend cela si déroutant, c'est que les utilisateurs ont réellement payé. Ils ont acheté le module complémentaire API Access. Ils ont accepté un accord de données de marché dans l'interface Tradovate et voient des cotations en direct sur la plateforme web. Alors quand l'API refuse un graphique en ticks, cela ressemble à un bug. Ce n'en est pas un. Ces deux éléments suivent des voies différentes, et <code>NoServicePlan</code> se trouve dans la voie que vous n'avez probablement pas encore configurée." },
    { type: "heading", text: "Pourquoi les graphiques en ticks sont particulièrement visés" },
    { type: "paragraph", html: "Un graphique en ticks ne se mesure pas en temps, mais en transactions. Chaque barre se ferme après un nombre défini de ticks (transactions individuelles), le graphique doit donc consommer le flux de transactions en direct pour afficher quoi que ce soit d'actuel. Des données différées ou instantanées ne peuvent pas alimenter un graphique en ticks en direct. C'est pourquoi <code>NoServicePlan</code> cible nommément les graphiques en ticks : un graphique en minutes peut tolérer des données différées dans certains contextes, mais un graphique en ticks en temps réel n'a aucune solution de repli. Pas de flux en direct, pas de graphique en ticks." },
    { type: "heading", text: "Principales causes de &laquo; NoServicePlan &raquo;" },
    { type: "heading", text: "1. Confusion entre les données de marché de la plateforme et celles de l'API" },
    { type: "paragraph", html: "C'est la cause numéro un. L'abonnement aux données de marché que vous acceptez dans le trader Tradovate donne droit à la <em>plateforme</em>, les applications web et de bureau, d'afficher des cotations en direct. Il ne donne pas automatiquement droit au flux WebSocket de l'API. Ces deux éléments sont facturés et sous licence séparément. Si vous vous êtes contenté de vous abonner aux données dans l'interface du trader, votre session API n'a toujours aucun plan en temps réel associé, et chaque requête de ticks renvoie <code>NoServicePlan</code>." },
    { type: "heading", text: "2. Absence d'enregistrement en tant que sous-fournisseur CME / liste blanche" },
    { type: "paragraph", html: "La diffusion de données de marché en temps réel via l'API est conditionnée à un accord avec la CME. Tradovate enregistre les utilisateurs de l'API en tant que sous-fournisseurs sous la licence de la bourse, et tant que cela n'est pas en place, et que votre compte n'est pas inscrit sur liste blanche côté Tradovate, le serveur n'a aucun plan API en temps réel à vous attribuer. Cela implique des frais de bourse mensuels versés à la CME, et non à Tradovate. Tout montant précis trouvé dans un ancien message est probablement obsolète ; le montant dépend de la bourse et de votre type de licence (non professionnel ou professionnel / non-display) et il évolue, confirmez donc le tarif actuel directement auprès de la CME et de Tradovate." },
    { type: "heading", text: "3. Un compte prop ou d'évaluation que vous ne contrôlez pas" },
    { type: "paragraph", html: "Si votre connexion est liée à une société prop ou à un service d'évaluation, les droits d'accès aux données appartiennent à ce fournisseur, pas à vous. Vous ne pouvez pas accepter un accord de données ni réconcilier un plan sur leur compte depuis Tradovate, les contrôles sont gérés en amont. Une session API sur un compte d'évaluation continuera de renvoyer <code>NoServicePlan</code> sur les requêtes de ticks tant que la société n'active pas les données en temps réel pour ce compte. C'est le support de la société qu'il faut contacter, pas celui de Tradovate." },
    { type: "heading", text: "4. Un droit d'accès désynchronisé ou expiré" },
    { type: "paragraph", html: "Il arrive que le plan ait été correctement configuré, puis désynchronisé par la suite. Un cycle de facturation se renouvelle, un changement de plan est appliqué, un accord expire, ou une modification de compte côté support ne se propage pas correctement, et soudain une session qui diffusait des données de ticks hier renvoie <code>NoServicePlan</code> aujourd'hui. C'est exactement la situation où &laquo; l'API ne reconnaît pas la correspondance &raquo; : vos informations indiquent que vous avez le droit, celles du serveur non. Une réauthentification règle la version simple (une session périmée) ; la version tenace nécessite l'intervention du support pour réconcilier le compte." },
    { type: "heading", text: "5. Demander des ticks sans le vouloir" },
    { type: "paragraph", html: "Une vérification rapide s'impose : confirmez que votre requête de graphique demande réellement un élément basé sur les ticks et que vous en avez besoin. Certaines bibliothèques et wrappers configurent par défaut une requête de graphique sur une unité de ticks. Si votre stratégie fonctionne sur des barres en minutes ou en secondes, vous déclenchez peut-être sans le savoir l'exigence de droit d'accès la plus stricte ; passer la requête à un intervalle de temps peut discrètement faire disparaître l'erreur." },
    { type: "heading", text: "Comment résoudre &laquo; NoServicePlan &raquo; : étape par étape" },
    {
      type: "steps",
      items: [
        { title: "Vérifiez le droit d'accès dont vous disposez réellement", html: "Connectez-vous à la plateforme web ou de bureau Tradovate avec le même compte que celui utilisé par votre clé API pour s'authentifier. Ouvrez <strong class='text-white'>Application Settings</strong> et rendez-vous dans la section données de marché / abonnements. Notez ce qui est actif. Voir des cotations en direct dans le trader indique que le droit d'accès à la <em>plateforme</em> est actif, cela ne confirme pas un plan API en temps réel. Posez-vous la question clé : avez-vous terminé un enregistrement en tant que sous-fournisseur CME et été inscrit sur liste blanche pour les données de marché de l'API ? Si ce n'est pas le cas, c'est là votre manque, et aucune modification de code ne le comblera." },
        { title: "Configurez les données API en temps réel (si vous avez vraiment besoin des ticks)", html: "Contactez la CME pour vous enregistrer en tant que sous-fournisseur dans le cadre de leur accord de licence pour les données futures en temps réel. Prévoyez les frais de bourse mensuels, versés à la CME, dont le montant actuel varie selon la bourse et le type de licence, vérifiez-le donc avant de vous engager. Informez le support Tradovate que vous vous êtes enregistré, et demandez-lui d'<strong class='text-white'>inscrire votre compte sur liste blanche pour les données de marché de l'API</strong>. Une fois la liste blanche confirmée, réauthentifiez-vous et renvoyez votre requête de graphique en ticks / <code>md/subscribeQuote</code>. Le plan devrait alors se résoudre." },
        { title: "Réconciliez un droit d'accès désynchronisé avec le support", html: "Écartez d'abord l'hypothèse d'une session périmée : supprimez votre jeton d'accès mis en cache, relancez le processus d'authentification, reconnectez le WebSocket de données de marché, puis réessayez. Si les requêtes de ticks continuent de renvoyer <code>NoServicePlan</code> sur <em>tous</em> les symboles, c'est le plan lui-même qui est désynchronisé. Ce n'est pas quelque chose que vous pouvez forcer depuis le client. Ouvrez un ticket auprès du support Tradovate. Indiquez clairement ce que vous avez acheté (API Access, tout abonnement de données, enregistrement en tant que sous-fournisseur) et joignez l'erreur exacte, y compris le code <code>NoServicePlan</code> et le message relatif aux ticks. Demandez-leur de vérifier que le plan de données de marché en temps réel est actif et correctement associé à votre compte API, et de réappliquer la liste blanche si elle a expiré. Sur un compte prop/d'évaluation, adressez plutôt cette demande à la société." },
        { title: "Ou contournez complètement le problème", html: "Si vous n'avez pas besoin des ticks, remplacez votre requête de graphique d'une unité de ticks par un intervalle de temps (minute/seconde). Cela lève souvent directement le blocage spécifique aux ticks. Si vous n'avez pas du tout besoin du flux en temps réel de Tradovate, exécutez une automatisation <strong class='text-white'>uniquement pour les ordres</strong> : passez des ordres, gérez les positions et interrogez le compte sans plan de données en temps réel. Récupérez vos données en direct auprès d'un fournisseur tiers de données de marché ou utilisez des données différées gratuites pour les signaux, tout en gardant l'exécution sur Tradovate." },
      ],
    },
