---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "atm-auto-breakeven-not-moving";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/debugging/${SLUG}`;

const META_TITLE = "Tradovate ATM Auto Breakeven Stop Not Moving";
const META_DESCRIPTION =
  "ATM auto breakeven not moving your stop to break-even? A positive offset delays it, set the offset right (or to zero) so the stop moves as intended.";

// Short SEO title (<=60 chars) for locales where the shared h1 is too long for a SERP title.
const TITLE_OVERRIDE: Partial<Record<Locale, string>> = { es: "Tradovate: el stop auto breakeven ATM no se mueve", fr: "Tradovate : le stop auto breakeven ATM ne bouge pas", it: "Tradovate: lo stop auto breakeven ATM non si muove" };

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Tradovate ATM Auto Breakeven Stop bewegt sich nicht beheben", es: "Cómo solucionar que el stop de auto breakeven ATM de Tradovate no se mueva", fr: "Corriger le stop auto breakeven ATM de Tradovate qui ne bouge pas", it: "Come risolvere lo stop auto breakeven ATM di Tradovate che non si muove" },
  dek: { en: "Price sails past your profit trigger and the stop just sits there. Nine times out of ten it's the offset field, not a broken platform, here's how auto breakeven decides when to move.", de: "Der Preis segelt an Ihrem Profit-Trigger vorbei, und der Stop bleibt einfach liegen. Neun von zehn Mal ist es das Offset-Feld, keine kaputte Plattform, hier erfahren Sie, wie Auto Breakeven entscheidet, wann es sich bewegt.", es: "El precio pasa de largo su gatillo de beneficio y el stop simplemente se queda ahí. Nueve de cada diez veces es el campo de offset, no una plataforma rota, aquí tiene cómo decide auto breakeven cuándo moverse.", fr: "Le prix file au-delà de votre déclencheur de profit et le stop reste planté là. Neuf fois sur dix, c'est le champ d'offset, pas une plateforme défaillante, voici comment l'auto breakeven décide quand bouger.", it: "Il prezzo supera il vostro trigger di profitto e lo stop resta semplicemente fermo lì. Nove volte su dieci è il campo offset, non una piattaforma difettosa, ecco come l'auto breakeven decide quando muoversi." },
  readTime: { en: "7 min read", de: "7 Minuten Lesezeit", es: "Lectura de 7 minutos", fr: "Lecture de 7 minutes", it: "Lettura di 7 minuti" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "You set up an ATM strategy with auto breakeven so you never have to babysit a stop again. Price runs your way, sails past the profit trigger, and you glance up expecting your stop to be sitting safely at entry. Except it isn't. It's still parked at your original stop, and now you're sweating a pullback that shouldn't matter. If your Tradovate auto breakeven stop is not moving, the culprit is almost never a broken platform, it's a small setting doing exactly what it was told to do." },
    { type: "paragraph", html: "Nine times out of ten it's one field: the <strong class='text-white'>offset</strong>. A positive offset quietly delays the whole thing, because Tradovate won't place a break-even stop ahead of where price is trading. Below is how auto breakeven decides when to move the stop, why a positive offset holds it back, and how to set the trigger and offset so the stop snaps to break-even when you expect it to." },
    {
      type: "checklist",
      heading: "Quick checklist for an auto breakeven stop that won't move",
      items: [
        "<strong class='text-white'>Check the offset first.</strong> A positive offset makes price travel farther before the stop can move. Set it to None (zero) for a stop that lands exactly at break-even.",
        "<strong class='text-white'>Confirm the profit trigger was actually hit.</strong> Auto breakeven fires once, and only once, after the market moves your set distance in your favor.",
        "<strong class='text-white'>Match the units.</strong> Ticks, points, and dollars are not interchangeable. A trigger you think is small may be a distance the market never reaches.",
        "<strong class='text-white'>Make sure auto breakeven is enabled on the strategy you're using</strong>, and that you saved it and selected that named strategy on the order.",
        "<strong class='text-white'>Read the Orders panel, not just the chart.</strong> Confirm the working stop actually moved to your entry price rather than trusting a chart marker. Any offset that would put the stop in front of the market simply waits.",
      ],
    },
    { type: "heading", text: "How auto breakeven is supposed to work" },
    { type: "paragraph", html: "Auto breakeven inside a Tradovate ATM strategy is a <strong class='text-white'>stop-market order that jumps to your average entry price once a profit trigger is reached</strong>. Two settings control it:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Profit trigger</strong>, how far the market must move in your favor before the stop relocates. Cross it and the stop moves once, and only once, a one-shot relocation, not a continuous trail.",
        "<strong class='text-white'>Offset (the &ldquo;Plus&rdquo; field)</strong>, lands the stop at break-even <em>plus or minus</em> a set amount. A positive value pushes the stop past entry into a small locked profit; leave it at None and the stop moves to your exact entry price.",
      ],
    },
    { type: "paragraph", html: "Picture a long filled at 1000.00. The trigger arms after a six-tick move; price reaches 1001.50, the trigger fires, and the stop pulls to break-even. With a &ldquo;Plus&rdquo; of two ticks it lands at 1000.50 instead of dead-even, a small profit cushion. That's the design working. Trouble starts when the offset is bigger than you realize relative to the trigger." },
    { type: "heading", text: "The main reason the stop doesn't move: a positive offset" },
    { type: "paragraph", html: "Here's the rule that trips almost everyone up: <strong class='text-white'>Tradovate won't place a break-even stop ahead of the price action.</strong> A stop has to sit behind the market, below price on a long, above price on a short. A positive offset asks the platform to place the stop closer to (or past) your entry, so the market must travel far enough that this level ends up behind price before the stop can go there." },
    { type: "paragraph", html: "The practical effect is that the trigger distance and the offset <strong class='text-white'>stack</strong>. Say your trigger is four ticks and you add a one-tick positive offset: you expect the stop to move the instant you're four ticks up, but the offset adds a buffer on top of the trigger, so the stop can't be placed until price pushes further. If the offset is large relative to the trigger, the trigger &ldquo;fires&rdquo; but the stop can't go where you asked, so it looks like nothing happened. The feature isn't broken; it's waiting for price to clear the level you defined." },
    { type: "paragraph", html: "The fix is almost anticlimactic: for a true break-even move, set the offset to <strong class='text-white'>None (zero)</strong>. To lock a few ticks instead, keep the offset well under the trigger distance so price can run past it. Don't set a two-tick offset behind a two-tick trigger and expect the stop to move the second you're green, it can't." },
    { type: "heading", text: "Other reasons a Tradovate break-even stop won't move" },
    { type: "heading", text: "1. The profit trigger simply hasn't been reached yet" },
    { type: "paragraph", html: "The most mundane cause, worth ruling out first. Auto breakeven only moves the stop after the market travels your set distance in your favor. If price grazed profit but never reached the trigger, the stop stays exactly where it belongs. Count the distance from entry to the current price in the same unit your trigger uses." },
    { type: "heading", text: "2. The units don't mean what you think" },
    { type: "paragraph", html: "Trigger and offset values follow the unit configured for your strategy, commonly ticks, but they can be points, dollars, or a percentage. A &ldquo;4&rdquo; you assumed was four ticks might be four points, which on many contracts is a distance the market rarely covers in one push. If your trigger looks reasonable as a number but the stop never moves, verify the unit, this one detail turns a working setup into a dead one." },
    { type: "heading", text: "3. Auto breakeven isn't actually enabled on the strategy you're using" },
    { type: "paragraph", html: "ATM strategies are saved as named profiles, so it's easy to edit one, forget to save, or place the trade with a <em>different</em> strategy selected, or none at all. If the order isn't carrying the strategy that has auto breakeven turned on, nothing moves the stop. Open the strategy, confirm the auto breakeven trigger has a value (not blank), save it, and make sure that exact named strategy is selected when you enter." },
    { type: "heading", text: "4. Scaling out shifted your average entry" },
    { type: "paragraph", html: "Auto breakeven targets your <strong class='text-white'>average</strong> entry price, so scaling in or out moves that average and the break-even level with it. Pair that with a positive offset on a remaining contract and the target stop can land ahead of price again, so it waits. Don't assume the stop relocated just because one target filled; watch each fill and confirm where the working stop ends up." },
    { type: "heading", text: "5. A third-party platform is managing the move" },
    { type: "paragraph", html: "If you route orders through NinjaTrader, TradingView, or another front end, the break-even logic may live there rather than in a Tradovate ATM strategy, and the modification still has to reach Tradovate and be accepted. A stop that visibly &ldquo;moves to break-even&rdquo; on an external chart hasn't necessarily propagated to the broker. Reconcile against the Tradovate Orders report; if the working stop there still shows the original price, the update didn't land. That's a different problem than a native ATM offset." },
    { type: "heading", text: "How to make the break-even stop move when you expect it" },
    { type: "heading", text: "Set the offset deliberately" },
    {
      type: "list",
      items: [
        "Open your ATM strategy editor and find the auto breakeven <strong class='text-white'>profit trigger</strong> and <strong class='text-white'>offset (Plus)</strong> fields.",
        "For a stop that lands exactly at entry, set the offset to <strong class='text-white'>None (zero)</strong>.",
        "To lock a small profit instead, enter a positive offset clearly <em>smaller</em> than the trigger, so price can still clear the level and the stop can be placed behind it.",
        "Double-check the <strong class='text-white'>unit</strong> on both fields, ticks versus points versus dollars, so the numbers mean what you intend.",
        "Save the strategy, then confirm that same named strategy is selected on your order ticket before you enter.",
      ],
    },
    { type: "heading", text: "Verify the stop actually moved" },
    {
      type: "list",
      items: [
        "Once price clears your trigger distance, open the <strong class='text-white'>Orders</strong> panel and look at the working stop for the position.",
        "Confirm its price changed to your average entry (or entry plus your offset). If the price updated, auto breakeven fired correctly.",
        "If the stop price is unchanged well after the trigger was hit, reduce or zero the offset and retest, that's the setting holding it back.",
        "On multi-contract trades, recheck the panel after each partial fill, since your average entry shifts as you scale.",
      ],
    },
    { type: "paragraph", html: "One reminder on trigger sizing: tick sizes and sensible trigger distances vary by instrument, and prop-firm accounts sometimes layer their own rules on top. On a funded or evaluation account, check your firm's current rules, since those parameters vary by firm and account size." },
    { type: "heading", text: "Troubleshooting table" },
    {
      type: "table",
      headers: ["Symptom", "Likely cause", "Fix"],
      rows: [
        ["Stop never moves even after a clear profit", "Positive offset places the stop ahead of price, so it waits", "Set offset to None (zero), or keep it well under the trigger"],
        ["Stop moves later than expected", "Trigger distance and positive offset stack together", "Reduce the offset or raise the trigger to account for it"],
        ["Trigger looks small but never fires", "Unit mismatch, points or dollars instead of ticks", "Confirm and correct the unit on the trigger and offset"],
        ["Nothing happens on any trade", "Auto breakeven not enabled, not saved, or wrong strategy selected", "Enable it, save the strategy, and select it on the order"],
        ["Break-even shifts unexpectedly on multi-contract trades", "Average entry changed as you scaled out", "Recheck the Orders panel after each fill"],
        ["Stop moves on the external chart but not in Tradovate", "Third-party modification didn't reach the broker", "Reconcile against the Tradovate Orders report"],
      ],
    },
    { type: "heading", text: "Automate break-even stops with PickMyTrade" },
    { type: "paragraph", html: "Manual ATM offsets are a small setting with an outsized ability to go wrong, one wrong number and a stop that should protect you sits idle. If you'd rather define the logic once and have it fire the same way on every trade and account, PickMyTrade routes your TradingView alerts straight to Tradovate and handles the stop and break-even moves for you:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Break-even offset control</strong>, set your break-even and profit-lock distance in the alert so the stop moves the same way every time, without re-typing an offset per trade.",
        "<strong class='text-white'>Entry, stop, and target as one unit</strong>, the alert defines the full bracket, so the stop logic and the position always agree.",
        "<strong class='text-white'>Broker-side confirmation</strong>, orders route to Tradovate directly, so what you configure is what reaches the account.",
        "<strong class='text-white'>Multi-account sync</strong>, mirror the same break-even behavior across every connected account at once.",
      ],
    },
  ], de: [
    { type: "paragraph", html: "Sie richten eine ATM-Strategie mit Auto Breakeven ein, damit Sie nie wieder einen Stop babysitten müssen. Der Preis läuft in Ihre Richtung, segelt am Profit-Trigger vorbei, und Sie werfen einen Blick hinauf, in der Erwartung, dass Ihr Stop sicher am Einstieg liegt. Tut er aber nicht. Er sitzt immer noch bei Ihrem ursprünglichen Stop, und jetzt fürchten Sie einen Rücksetzer, der eigentlich egal sein sollte. Wenn sich Ihr Tradovate Auto-Breakeven-Stop nicht bewegt, ist der Übeltäter fast nie eine kaputte Plattform, es ist eine kleine Einstellung, die genau das tut, was ihr aufgetragen wurde." },
    { type: "paragraph", html: "Neun von zehn Mal ist es ein Feld: der <strong class='text-white'>Offset</strong>. Ein positiver Offset verzögert das Ganze still und leise, weil Tradovate keinen Breakeven-Stop vor dem aktuellen Preisniveau platziert. Im Folgenden erfahren Sie, wie Auto Breakeven entscheidet, wann der Stop bewegt wird, warum ein positiver Offset das zurückhält, und wie Sie Trigger und Offset einstellen, damit der Stop auf Breakeven einrastet, wenn Sie es erwarten." },
    {
      type: "checklist",
      heading: "Kurz-Checkliste für einen Auto-Breakeven-Stop, der sich nicht bewegt",
      items: [
        "<strong class='text-white'>Prüfen Sie zuerst den Offset.</strong> Ein positiver Offset lässt den Preis weiter laufen, bevor sich der Stop bewegen kann. Stellen Sie ihn auf None (null), für einen Stop, der exakt bei Breakeven landet.",
        "<strong class='text-white'>Bestätigen Sie, dass der Profit-Trigger tatsächlich erreicht wurde.</strong> Auto Breakeven feuert einmal, und nur einmal, nachdem sich der Markt um die eingestellte Distanz zu Ihren Gunsten bewegt hat.",
        "<strong class='text-white'>Gleichen Sie die Einheiten ab.</strong> Ticks, Punkte und Dollar sind nicht austauschbar. Ein Trigger, den Sie für klein halten, kann eine Distanz sein, die der Markt nie erreicht.",
        "<strong class='text-white'>Stellen Sie sicher, dass Auto Breakeven bei der verwendeten Strategie aktiviert ist</strong>, und dass Sie sie gespeichert und diese benannte Strategie bei der Order ausgewählt haben.",
        "<strong class='text-white'>Lesen Sie das Orders-Panel, nicht nur den Chart.</strong> Bestätigen Sie, dass sich der aktive Stop tatsächlich zu Ihrem Einstiegspreis bewegt hat, statt einem Chart-Marker zu vertrauen. Jeder Offset, der den Stop vor den Markt setzen würde, wartet schlicht.",
      ],
    },
    { type: "heading", text: "Wie Auto Breakeven eigentlich funktionieren soll" },
    { type: "paragraph", html: "Auto Breakeven innerhalb einer Tradovate ATM-Strategie ist eine <strong class='text-white'>Stop-Market-Order, die zu Ihrem durchschnittlichen Einstiegspreis springt, sobald ein Profit-Trigger erreicht ist</strong>. Zwei Einstellungen steuern das:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Profit-Trigger</strong>, wie weit sich der Markt zu Ihren Gunsten bewegen muss, bevor der Stop umzieht. Überschreiten Sie ihn, bewegt sich der Stop einmal, und nur einmal, eine einmalige Umsiedlung, kein kontinuierliches Nachziehen.",
        "<strong class='text-white'>Offset (das „Plus“-Feld)</strong>, lässt den Stop bei Breakeven <em>plus oder minus</em> einem festgelegten Betrag landen. Ein positiver Wert schiebt den Stop über den Einstieg hinaus in einen kleinen gesicherten Gewinn; belassen Sie ihn bei None, bewegt sich der Stop exakt zu Ihrem Einstiegspreis.",
      ],
    },
    { type: "paragraph", html: "Stellen Sie sich einen Long vor, der bei 1000,00 gefüllt wird. Der Trigger scharft sich nach einer Sechs-Tick-Bewegung; der Preis erreicht 1001,50, der Trigger feuert, und der Stop zieht auf Breakeven. Mit einem „Plus“ von zwei Ticks landet er bei 1000,50 statt exakt neutral, ein kleines Gewinnpolster. Das ist das Design, das funktioniert. Probleme beginnen, wenn der Offset größer ist, als Ihnen im Verhältnis zum Trigger bewusst ist." },
    { type: "heading", text: "Der Hauptgrund, warum sich der Stop nicht bewegt: ein positiver Offset" },
    { type: "paragraph", html: "Hier ist die Regel, die fast jeden zu Fall bringt: <strong class='text-white'>Tradovate platziert keinen Breakeven-Stop vor dem Preisgeschehen.</strong> Ein Stop muss hinter dem Markt liegen, unter dem Preis bei einem Long, über dem Preis bei einem Short. Ein positiver Offset verlangt von der Plattform, den Stop näher an (oder über) Ihren Einstieg zu setzen, sodass der Markt weit genug laufen muss, damit dieses Niveau hinter dem Preis landet, bevor der Stop dorthin kann." },
    { type: "paragraph", html: "Der praktische Effekt ist, dass sich Trigger-Distanz und Offset <strong class='text-white'>aufaddieren</strong>. Angenommen, Ihr Trigger liegt bei vier Ticks und Sie fügen einen Ein-Tick-positiven-Offset hinzu: Sie erwarten, dass sich der Stop in dem Moment bewegt, in dem Sie vier Ticks im Plus sind, aber der Offset fügt einen Puffer oben auf den Trigger, sodass der Stop erst platziert werden kann, wenn der Preis weiter drückt. Ist der Offset groß im Verhältnis zum Trigger, „feuert“ der Trigger, aber der Stop kann nicht dorthin, wohin Sie ihn gebeten haben, sodass es aussieht, als wäre nichts passiert. Das Feature ist nicht kaputt; es wartet darauf, dass der Preis das von Ihnen definierte Niveau räumt." },
    { type: "paragraph", html: "Die Lösung ist fast ernüchternd: Für eine echte Breakeven-Bewegung stellen Sie den Offset auf <strong class='text-white'>None (null)</strong>. Um stattdessen ein paar Ticks zu sichern, halten Sie den Offset deutlich unter der Trigger-Distanz, damit der Preis daran vorbeilaufen kann. Setzen Sie keinen Zwei-Tick-Offset hinter einen Zwei-Tick-Trigger und erwarten Sie, dass sich der Stop in der Sekunde bewegt, in der Sie im Plus sind, das kann nicht funktionieren." },
    { type: "heading", text: "Weitere Gründe, warum sich ein Tradovate Breakeven-Stop nicht bewegt" },
    { type: "heading", text: "1. Der Profit-Trigger wurde schlicht noch nicht erreicht" },
    { type: "paragraph", html: "Die banalste Ursache, die es zuerst auszuschließen lohnt. Auto Breakeven bewegt den Stop erst, nachdem der Markt Ihre eingestellte Distanz zu Ihren Gunsten zurückgelegt hat. Streifte der Preis nur den Gewinn, erreichte aber nie den Trigger, bleibt der Stop genau dort, wo er hingehört. Zählen Sie die Distanz vom Einstieg zum aktuellen Preis in derselben Einheit, die Ihr Trigger verwendet." },
    { type: "heading", text: "2. Die Einheiten bedeuten nicht, was Sie denken" },
    { type: "paragraph", html: "Trigger- und Offset-Werte folgen der für Ihre Strategie konfigurierten Einheit, üblicherweise Ticks, aber es können auch Punkte, Dollar oder ein Prozentsatz sein. Eine „4“, von der Sie annahmen, sie seien vier Ticks, könnte vier Punkte sein, was bei vielen Kontrakten eine Distanz ist, die der Markt selten in einem Zug abdeckt. Wirkt Ihr Trigger als Zahl vernünftig, der Stop bewegt sich aber nie, prüfen Sie die Einheit, dieses eine Detail macht aus einer funktionierenden Einrichtung eine tote." },
    { type: "heading", text: "3. Auto Breakeven ist auf der verwendeten Strategie tatsächlich nicht aktiviert" },
    { type: "paragraph", html: "ATM-Strategien werden als benannte Profile gespeichert, daher ist es leicht, eine zu bearbeiten, das Speichern zu vergessen oder den Trade mit einer <em>anderen</em> ausgewählten Strategie oder gar keiner zu platzieren. Trägt die Order nicht die Strategie mit aktiviertem Auto Breakeven, bewegt sich nichts. Öffnen Sie die Strategie, bestätigen Sie, dass der Auto-Breakeven-Trigger einen Wert hat (nicht leer ist), speichern Sie sie und stellen Sie sicher, dass genau diese benannte Strategie beim Einstieg ausgewählt ist." },
    { type: "heading", text: "4. Teilausstieg hat Ihren durchschnittlichen Einstieg verschoben" },
    { type: "paragraph", html: "Auto Breakeven zielt auf Ihren <strong class='text-white'>durchschnittlichen</strong> Einstiegspreis, sodass eine Zu- oder Verkleinerung der Position diesen Durchschnitt und damit das Breakeven-Niveau verschiebt. Kombiniert mit einem positiven Offset auf einen verbliebenen Kontrakt kann der Ziel-Stop erneut vor dem Preis landen, sodass er wartet. Nehmen Sie nicht an, dass sich der Stop umgesiedelt hat, nur weil ein Target gefüllt wurde; beobachten Sie jeden Fill und bestätigen Sie, wo der aktive Stop endet." },
    { type: "heading", text: "5. Eine Drittanbieter-Plattform verwaltet die Bewegung" },
    { type: "paragraph", html: "Wenn Sie Orders über NinjaTrader, TradingView oder ein anderes Frontend routen, kann die Breakeven-Logik dort statt in einer Tradovate ATM-Strategie liegen, und die Änderung muss trotzdem Tradovate erreichen und akzeptiert werden. Ein Stop, der auf einem externen Chart sichtbar „auf Breakeven wechselt“, hat sich nicht zwangsläufig zum Broker fortgepflanzt. Gleichen Sie es mit dem Tradovate-Orders-Report ab; zeigt der aktive Stop dort immer noch den ursprünglichen Preis, ist die Aktualisierung nicht angekommen. Das ist ein anderes Problem als ein nativer ATM-Offset." },
    { type: "heading", text: "So sorgen Sie dafür, dass sich der Breakeven-Stop bewegt, wenn Sie es erwarten" },
    { type: "heading", text: "Den Offset bewusst einstellen" },
    {
      type: "list",
      items: [
        "Öffnen Sie Ihren ATM-Strategie-Editor und finden Sie die Felder Auto-Breakeven <strong class='text-white'>Profit-Trigger</strong> und <strong class='text-white'>Offset (Plus)</strong>.",
        "Für einen Stop, der exakt beim Einstieg landet, stellen Sie den Offset auf <strong class='text-white'>None (null)</strong>.",
        "Um stattdessen einen kleinen Gewinn zu sichern, geben Sie einen positiven Offset ein, der deutlich <em>kleiner</em> als der Trigger ist, damit der Preis das Niveau noch räumen kann und der Stop dahinter platziert werden kann.",
        "Prüfen Sie doppelt die <strong class='text-white'>Einheit</strong> in beiden Feldern, Ticks gegenüber Punkten gegenüber Dollar, damit die Zahlen das bedeuten, was Sie beabsichtigen.",
        "Speichern Sie die Strategie, und bestätigen Sie dann, dass genau diese benannte Strategie auf Ihrem Order-Ticket ausgewählt ist, bevor Sie einsteigen.",
      ],
    },
    { type: "heading", text: "Verifizieren, dass sich der Stop tatsächlich bewegt hat" },
    {
      type: "list",
      items: [
        "Sobald der Preis Ihre Trigger-Distanz räumt, öffnen Sie das Panel <strong class='text-white'>Orders</strong> und sehen Sie sich den aktiven Stop für die Position an.",
        "Bestätigen Sie, dass sich sein Preis zu Ihrem durchschnittlichen Einstieg (oder Einstieg plus Offset) geändert hat. Hat sich der Preis aktualisiert, hat Auto Breakeven korrekt gefeuert.",
        "Ist der Stop-Preis auch lange nach dem Erreichen des Triggers unverändert, verringern oder nullen Sie den Offset und testen Sie erneut, das ist die Einstellung, die es zurückhält.",
        "Bei Trades mit mehreren Kontrakten prüfen Sie das Panel nach jedem Teil-Fill erneut, da sich Ihr durchschnittlicher Einstieg mit jeder Skalierung verschiebt.",
      ],
    },
    { type: "paragraph", html: "Eine Erinnerung zur Trigger-Größe: Tick-Größen und sinnvolle Trigger-Distanzen variieren je nach Instrument, und Prop-Firma-Konten legen manchmal ihre eigenen Regeln oben drauf. Prüfen Sie bei einem finanzierten oder Evaluierungskonto die aktuellen Regeln Ihrer Firma, da diese Parameter je nach Firma und Kontogröße variieren." },
    { type: "heading", text: "Fehlerbehebungstabelle" },
    {
      type: "table",
      headers: ["Symptom", "Wahrscheinliche Ursache", "Lösung"],
      rows: [
        ["Stop bewegt sich nie, selbst nach klarem Gewinn", "Positiver Offset platziert den Stop vor dem Preis, sodass er wartet", "Offset auf None (null) stellen oder deutlich unter dem Trigger halten"],
        ["Stop bewegt sich später als erwartet", "Trigger-Distanz und positiver Offset addieren sich", "Offset verringern oder Trigger erhöhen, um dies auszugleichen"],
        ["Trigger wirkt klein, feuert aber nie", "Einheiten-Fehler, Punkte oder Dollar statt Ticks", "Einheit bei Trigger und Offset bestätigen und korrigieren"],
        ["Bei keinem Trade passiert etwas", "Auto Breakeven nicht aktiviert, nicht gespeichert oder falsche Strategie ausgewählt", "Aktivieren, Strategie speichern und bei der Order auswählen"],
        ["Breakeven verschiebt sich unerwartet bei Multi-Kontrakt-Trades", "Durchschnittlicher Einstieg hat sich mit Teilausstieg geändert", "Orders-Panel nach jedem Fill erneut prüfen"],
        ["Stop bewegt sich im externen Chart, aber nicht in Tradovate", "Drittanbieter-Änderung hat den Broker nicht erreicht", "Mit dem Tradovate-Orders-Report abgleichen"],
      ],
    },
    { type: "heading", text: "Breakeven-Stops mit PickMyTrade automatisieren" },
    { type: "paragraph", html: "Manuelle ATM-Offsets sind eine kleine Einstellung mit unverhältnismäßig großem Potenzial, schiefzugehen, eine falsche Zahl, und ein Stop, der Sie schützen sollte, liegt untätig. Wenn Sie die Logik lieber einmal definieren und sie bei jedem Trade und jedem Konto gleich feuern lassen möchten, routet PickMyTrade Ihre TradingView-Alerts direkt zu Tradovate und übernimmt Stop- und Breakeven-Bewegungen für Sie:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Breakeven-Offset-Kontrolle</strong>, legen Sie Ihre Breakeven- und Gewinnsicherungs-Distanz im Alert fest, damit sich der Stop jedes Mal gleich bewegt, ohne einen Offset pro Trade neu einzutippen.",
        "<strong class='text-white'>Einstieg, Stop und Target als eine Einheit</strong>, der Alert definiert das gesamte Bracket, sodass Stop-Logik und Position immer übereinstimmen.",
        "<strong class='text-white'>Bestätigung auf Broker-Seite</strong>, Orders routen direkt zu Tradovate, sodass das, was Sie konfigurieren, auch beim Konto ankommt.",
        "<strong class='text-white'>Multi-Account-Sync</strong>, spiegelt dasselbe Breakeven-Verhalten über jedes verbundene Konto hinweg auf einmal.",
      ],
    },
  ], es: [
    { type: "paragraph", html: "Configura una estrategia ATM con auto breakeven para no tener que vigilar un stop nunca más. El precio corre a su favor, pasa de largo su gatillo de beneficio, y usted echa un vistazo esperando que su stop esté a salvo en el punto de entrada. Excepto que no lo está. Sigue aparcado en su stop original, y ahora está sudando ante un retroceso que no debería importar. Si el stop de auto breakeven de su Tradovate no se mueve, el culpable casi nunca es una plataforma rota, es un ajuste pequeño haciendo exactamente lo que se le indicó que hiciera." },
    { type: "paragraph", html: "Nueve de cada diez veces es un campo: el <strong class='text-white'>offset</strong>. Un offset positivo retrasa silenciosamente todo el proceso, porque Tradovate no colocará un stop de breakeven por delante de donde cotiza el precio. A continuación se explica cómo decide auto breakeven cuándo mover el stop, por qué un offset positivo lo retiene, y cómo configurar el gatillo y el offset para que el stop encaje en breakeven cuando usted lo espera." },
    {
      type: "checklist",
      heading: "Lista de verificación rápida para un stop de auto breakeven que no se mueve",
      items: [
        "<strong class='text-white'>Compruebe primero el offset.</strong> Un offset positivo hace que el precio recorra más distancia antes de que el stop pueda moverse. Configúrelo en Ninguno (cero) para un stop que aterrice exactamente en breakeven.",
        "<strong class='text-white'>Confirme que el gatillo de beneficio realmente se alcanzó.</strong> Auto breakeven se dispara una vez, y solo una vez, después de que el mercado se mueva la distancia que fijó a su favor.",
        "<strong class='text-white'>Haga coincidir las unidades.</strong> Ticks, puntos y dólares no son intercambiables. Un gatillo que cree pequeño puede ser una distancia que el mercado nunca alcanza.",
        "<strong class='text-white'>Asegúrese de que auto breakeven esté habilitado en la estrategia que está usando</strong>, y de que la guardó y seleccionó esa estrategia con nombre en la orden.",
        "<strong class='text-white'>Lea el panel de Órdenes, no solo el gráfico.</strong> Confirme que el stop activo realmente se movió a su precio de entrada en lugar de confiar en un marcador del gráfico. Cualquier offset que colocaría el stop delante del mercado simplemente espera.",
      ],
    },
    { type: "heading", text: "Cómo se supone que funciona el auto breakeven" },
    { type: "paragraph", html: "El auto breakeven dentro de una estrategia ATM de Tradovate es una <strong class='text-white'>orden stop de mercado que salta a su precio de entrada promedio una vez que se alcanza un gatillo de beneficio</strong>. Dos ajustes lo controlan:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Gatillo de beneficio</strong>, cuánto debe moverse el mercado a su favor antes de que el stop se reubique. Sobrepáselo y el stop se mueve una vez, y solo una vez, una reubicación de un solo disparo, no un trailing continuo.",
        "<strong class='text-white'>Offset (el campo &ldquo;Plus&rdquo;)</strong>, hace que el stop aterrice en breakeven <em>más o menos</em> una cantidad fijada. Un valor positivo empuja el stop más allá de la entrada hacia un pequeño beneficio asegurado; déjelo en Ninguno y el stop se mueve exactamente a su precio de entrada.",
      ],
    },
    { type: "paragraph", html: "Imagine una posición larga ejecutada a 1000.00. El gatillo se arma tras un movimiento de seis ticks; el precio alcanza 1001.50, el gatillo se dispara, y el stop tira hacia breakeven. Con un &ldquo;Plus&rdquo; de dos ticks, aterriza en 1000.50 en lugar de exactamente neutro, un pequeño colchón de beneficio. Eso es el diseño funcionando. Los problemas empiezan cuando el offset es mayor de lo que usted se da cuenta en relación con el gatillo." },
    { type: "heading", text: "La razón principal por la que el stop no se mueve: un offset positivo" },
    { type: "paragraph", html: "Aquí está la regla que hace tropezar a casi todo el mundo: <strong class='text-white'>Tradovate no colocará un stop de breakeven por delante de la acción del precio.</strong> Un stop tiene que situarse detrás del mercado, por debajo del precio en una posición larga, por encima del precio en una corta. Un offset positivo le pide a la plataforma que coloque el stop más cerca de (o más allá de) su entrada, así que el mercado debe recorrer suficiente distancia para que ese nivel acabe detrás del precio antes de que el stop pueda ir allí." },
    { type: "paragraph", html: "El efecto práctico es que la distancia del gatillo y el offset se <strong class='text-white'>acumulan</strong>. Digamos que su gatillo es de cuatro ticks y añade un offset positivo de un tick: usted espera que el stop se mueva en el instante en que esté cuatro ticks arriba, pero el offset añade un colchón encima del gatillo, así que el stop no puede colocarse hasta que el precio empuje más. Si el offset es grande en relación con el gatillo, el gatillo &ldquo;se dispara&rdquo; pero el stop no puede ir a donde usted pidió, así que parece que no ha pasado nada. La función no está rota; está esperando a que el precio despeje el nivel que usted definió." },
    { type: "paragraph", html: "La solución es casi decepcionante: para un movimiento de breakeven auténtico, configure el offset en <strong class='text-white'>Ninguno (cero)</strong>. Para asegurar unos pocos ticks en su lugar, mantenga el offset bien por debajo de la distancia del gatillo para que el precio pueda pasarlo. No configure un offset de dos ticks detrás de un gatillo de dos ticks y espere que el stop se mueva en el segundo en que esté en verde, no puede." },
    { type: "heading", text: "Otras razones por las que un stop de breakeven de Tradovate no se mueve" },
    { type: "heading", text: "1. El gatillo de beneficio simplemente aún no se ha alcanzado" },
    { type: "paragraph", html: "La causa más mundana, que vale la pena descartar primero. El auto breakeven solo mueve el stop después de que el mercado recorra la distancia fijada a su favor. Si el precio rozó el beneficio pero nunca alcanzó el gatillo, el stop permanece exactamente donde debe estar. Cuente la distancia desde la entrada hasta el precio actual en la misma unidad que usa su gatillo." },
    { type: "heading", text: "2. Las unidades no significan lo que usted piensa" },
    { type: "paragraph", html: "Los valores de gatillo y offset siguen la unidad configurada para su estrategia, comúnmente ticks, pero pueden ser puntos, dólares, o un porcentaje. Un &ldquo;4&rdquo; que usted asumió que eran cuatro ticks podría ser cuatro puntos, lo que en muchos contratos es una distancia que el mercado rara vez cubre de un solo empuje. Si su gatillo parece razonable como número pero el stop nunca se mueve, verifique la unidad, este único detalle convierte una configuración funcional en una muerta." },
    { type: "heading", text: "3. El auto breakeven en realidad no está habilitado en la estrategia que está usando" },
    { type: "paragraph", html: "Las estrategias ATM se guardan como perfiles con nombre, así que es fácil editar una, olvidar guardarla, o colocar la operación con una estrategia <em>distinta</em> seleccionada, o ninguna en absoluto. Si la orden no lleva la estrategia que tiene el auto breakeven activado, nada mueve el stop. Abra la estrategia, confirme que el gatillo de auto breakeven tiene un valor (no está en blanco), guárdela, y asegúrese de que esa estrategia con nombre exacta está seleccionada cuando entra." },
    { type: "heading", text: "4. Reducir posición desplazó su entrada promedio" },
    { type: "paragraph", html: "El auto breakeven apunta a su precio de entrada <strong class='text-white'>promedio</strong>, así que aumentar o reducir la posición mueve ese promedio y el nivel de breakeven con él. Combine eso con un offset positivo en un contrato restante y el stop objetivo puede volver a aterrizar por delante del precio, así que espera. No suponga que el stop se reubicó solo porque un objetivo se ejecutó; observe cada ejecución y confirme dónde termina el stop activo." },
    { type: "heading", text: "5. Una plataforma de terceros está gestionando el movimiento" },
    { type: "paragraph", html: "Si enruta órdenes a través de NinjaTrader, TradingView, u otro front end, la lógica de breakeven puede residir allí en lugar de en una estrategia ATM de Tradovate, y la modificación todavía tiene que llegar a Tradovate y ser aceptada. Un stop que visiblemente &ldquo;se mueve a breakeven&rdquo; en un gráfico externo no necesariamente se ha propagado al bróker. Concilie contra el reporte de Órdenes de Tradovate; si el stop activo allí todavía muestra el precio original, la actualización no llegó. Ese es un problema distinto al de un offset ATM nativo." },
    { type: "heading", text: "Cómo hacer que el stop de breakeven se mueva cuando lo espera" },
    { type: "heading", text: "Configure el offset deliberadamente" },
    {
      type: "list",
      items: [
        "Abra su editor de estrategia ATM y encuentre los campos <strong class='text-white'>gatillo de beneficio</strong> y <strong class='text-white'>offset (Plus)</strong> de auto breakeven.",
        "Para un stop que aterrice exactamente en la entrada, configure el offset en <strong class='text-white'>Ninguno (cero)</strong>.",
        "Para asegurar un pequeño beneficio en su lugar, introduzca un offset positivo claramente <em>menor</em> que el gatillo, para que el precio pueda seguir despejando el nivel y el stop pueda colocarse detrás de él.",
        "Vuelva a comprobar la <strong class='text-white'>unidad</strong> en ambos campos, ticks frente a puntos frente a dólares, para que los números signifiquen lo que usted pretende.",
        "Guarde la estrategia, luego confirme que esa misma estrategia con nombre está seleccionada en su ticket de orden antes de entrar.",
      ],
    },
    { type: "heading", text: "Verifique que el stop realmente se movió" },
    {
      type: "list",
      items: [
        "Una vez que el precio despeje la distancia de su gatillo, abra el panel de <strong class='text-white'>Órdenes</strong> y mire el stop activo de la posición.",
        "Confirme que su precio cambió a su entrada promedio (o entrada más su offset). Si el precio se actualizó, el auto breakeven se disparó correctamente.",
        "Si el precio del stop no cambia bastante después de que se alcanzó el gatillo, reduzca o ponga en cero el offset y vuelva a probar, ese es el ajuste que lo está reteniendo.",
        "En operaciones de varios contratos, vuelva a comprobar el panel después de cada ejecución parcial, ya que su entrada promedio se desplaza a medida que escala.",
      ],
    },
    { type: "paragraph", html: "Un recordatorio sobre el tamaño del gatillo: los tamaños de tick y las distancias de gatillo razonables varían según el instrumento, y las cuentas de firmas prop a veces superponen sus propias reglas. En una cuenta financiada o de evaluación, consulte las reglas actuales de su firma, ya que esos parámetros varían según la firma y el tamaño de la cuenta." },
    { type: "heading", text: "Tabla de solución de problemas" },
    {
      type: "table",
      headers: ["Síntoma", "Causa probable", "Solución"],
      rows: [
        ["El stop nunca se mueve incluso tras un beneficio claro", "Un offset positivo coloca el stop por delante del precio, así que espera", "Configure el offset en Ninguno (cero), o manténgalo bien por debajo del gatillo"],
        ["El stop se mueve más tarde de lo esperado", "La distancia del gatillo y el offset positivo se acumulan", "Reduzca el offset o eleve el gatillo para compensarlo"],
        ["El gatillo parece pequeño pero nunca se dispara", "Discrepancia de unidades, puntos o dólares en lugar de ticks", "Confirme y corrija la unidad del gatillo y el offset"],
        ["No pasa nada en ninguna operación", "Auto breakeven no habilitado, no guardado, o estrategia equivocada seleccionada", "Habilítelo, guarde la estrategia y selecciónela en la orden"],
        ["El breakeven se desplaza inesperadamente en operaciones de varios contratos", "La entrada promedio cambió al reducir posición", "Vuelva a comprobar el panel de Órdenes después de cada ejecución"],
        ["El stop se mueve en el gráfico externo pero no en Tradovate", "La modificación de terceros no llegó al bróker", "Concilie contra el reporte de Órdenes de Tradovate"],
      ],
    },
    { type: "heading", text: "Automatice los stops de breakeven con PickMyTrade" },
    { type: "paragraph", html: "Los offsets ATM manuales son un ajuste pequeño con una capacidad desproporcionada de salir mal, un número equivocado y un stop que debería protegerlo se queda inactivo. Si prefiere definir la lógica una vez y que se dispare de la misma manera en cada operación y cuenta, PickMyTrade enruta sus alertas de TradingView directamente a Tradovate y gestiona los movimientos de stop y breakeven por usted:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Control del offset de breakeven</strong>, fije su distancia de breakeven y de aseguramiento de beneficio en la alerta para que el stop se mueva de la misma manera cada vez, sin volver a escribir un offset por operación.",
        "<strong class='text-white'>Entrada, stop y objetivo como una sola unidad</strong>, la alerta define el bracket completo, así que la lógica del stop y la posición siempre concuerdan.",
        "<strong class='text-white'>Confirmación del lado del bróker</strong>, las órdenes se enrutan directamente a Tradovate, así que lo que usted configura es lo que llega a la cuenta.",
        "<strong class='text-white'>Sincronización multicuenta</strong>, refleja el mismo comportamiento de breakeven en todas las cuentas conectadas a la vez.",
      ],
    },
  ], fr: [
    { type: "paragraph", html: "Vous configurez une stratégie ATM avec auto breakeven pour ne plus jamais avoir à surveiller un stop. Le prix évolue en votre faveur, file au-delà du déclencheur de profit, et vous jetez un œil en vous attendant à ce que votre stop soit posé en sécurité à l'entrée. Sauf que ce n'est pas le cas. Il est toujours garé sur votre stop d'origine, et vous voilà à redouter un repli qui ne devrait pourtant pas compter. Si votre stop auto breakeven Tradovate ne bouge pas, le coupable n'est presque jamais une plateforme défaillante, c'est un petit réglage qui fait exactement ce qu'on lui a demandé." },
    { type: "paragraph", html: "Neuf fois sur dix, c'est un champ : l'<strong class='text-white'>offset</strong>. Un offset positif retarde discrètement tout le processus, car Tradovate ne placera pas un stop de breakeven en avant du niveau où le prix cote. Voici comment l'auto breakeven décide quand déplacer le stop, pourquoi un offset positif le retient, et comment régler le déclencheur et l'offset pour que le stop se cale sur le breakeven quand vous vous y attendez." },
    {
      type: "checklist",
      heading: "Liste de contrôle rapide pour un stop auto breakeven qui ne bouge pas",
      items: [
        "<strong class='text-white'>Vérifiez d'abord l'offset.</strong> Un offset positif oblige le prix à parcourir une distance plus grande avant que le stop ne puisse bouger. Réglez-le sur Aucun (zéro) pour un stop qui atterrit exactement au breakeven.",
        "<strong class='text-white'>Confirmez que le déclencheur de profit a réellement été atteint.</strong> L'auto breakeven se déclenche une fois, et une seule, après que le marché a bougé de la distance fixée en votre faveur.",
        "<strong class='text-white'>Faites correspondre les unités.</strong> Ticks, points et dollars ne sont pas interchangeables. Un déclencheur que vous pensez petit peut représenter une distance que le marché n'atteint jamais.",
        "<strong class='text-white'>Assurez-vous que l'auto breakeven est activé sur la stratégie que vous utilisez</strong>, et que vous l'avez enregistrée et sélectionné cette stratégie nommée sur l'ordre.",
        "<strong class='text-white'>Lisez le panneau Ordres, pas seulement le graphique.</strong> Confirmez que le stop en cours a bien bougé vers votre prix d'entrée plutôt que de vous fier à un marqueur graphique. Tout offset qui placerait le stop devant le marché attend simplement.",
      ],
    },
    { type: "heading", text: "Comment l'auto breakeven est censé fonctionner" },
    { type: "paragraph", html: "L'auto breakeven au sein d'une stratégie ATM Tradovate est un <strong class='text-white'>ordre stop au marché qui saute à votre prix d'entrée moyen une fois qu'un déclencheur de profit est atteint</strong>. Deux réglages le contrôlent :" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Déclencheur de profit</strong>, la distance que le marché doit parcourir en votre faveur avant que le stop ne se déplace. Une fois franchi, le stop bouge une fois, et une seule, un déplacement ponctuel, pas un suivi continu.",
        "<strong class='text-white'>Offset (le champ « Plus »)</strong>, fait atterrir le stop au breakeven <em>plus ou moins</em> un montant fixé. Une valeur positive pousse le stop au-delà de l'entrée vers un petit profit verrouillé ; laissez-le sur Aucun et le stop se déplace exactement à votre prix d'entrée.",
      ],
    },
    { type: "paragraph", html: "Imaginez une position longue exécutée à 1000,00. Le déclencheur s'arme après un mouvement de six ticks ; le prix atteint 1001,50, le déclencheur se déclenche, et le stop se cale au breakeven. Avec un « Plus » de deux ticks, il atterrit à 1000,50 au lieu de pile à zéro, un petit coussin de profit. C'est le design qui fonctionne. Les problèmes commencent lorsque l'offset est plus grand que vous ne le réalisez par rapport au déclencheur." },
    { type: "heading", text: "La raison principale pour laquelle le stop ne bouge pas : un offset positif" },
    { type: "paragraph", html: "Voici la règle qui piège presque tout le monde : <strong class='text-white'>Tradovate ne placera pas un stop de breakeven en avant de l'action du prix.</strong> Un stop doit se tenir derrière le marché, en dessous du prix pour une position longue, au-dessus pour une position courte. Un offset positif demande à la plateforme de placer le stop plus près de (ou au-delà de) votre entrée, si bien que le marché doit parcourir suffisamment de distance pour que ce niveau finisse derrière le prix avant que le stop puisse s'y rendre." },
    { type: "paragraph", html: "L'effet pratique est que la distance du déclencheur et l'offset se <strong class='text-white'>cumulent</strong>. Disons que votre déclencheur est de quatre ticks et que vous ajoutez un offset positif d'un tick : vous vous attendez à ce que le stop bouge dès que vous êtes à quatre ticks au-dessus, mais l'offset ajoute une marge par-dessus le déclencheur, si bien que le stop ne peut pas être placé tant que le prix ne pousse pas plus loin. Si l'offset est important par rapport au déclencheur, le déclencheur « se déclenche » mais le stop ne peut pas aller où vous l'avez demandé, si bien qu'il semble que rien ne se soit passé. La fonctionnalité n'est pas cassée ; elle attend que le prix dépasse le niveau que vous avez défini." },
    { type: "paragraph", html: "La correction est presque décevante de simplicité : pour un véritable déplacement au breakeven, réglez l'offset sur <strong class='text-white'>Aucun (zéro)</strong>. Pour verrouiller quelques ticks à la place, gardez l'offset bien en dessous de la distance du déclencheur pour que le prix puisse le dépasser. Ne réglez pas un offset de deux ticks derrière un déclencheur de deux ticks en vous attendant à ce que le stop bouge dès que vous êtes en positif, ce n'est pas possible." },
    { type: "heading", text: "Autres raisons pour lesquelles un stop breakeven Tradovate ne bouge pas" },
    { type: "heading", text: "1. Le déclencheur de profit n'a tout simplement pas encore été atteint" },
    { type: "paragraph", html: "La cause la plus banale, qu'il vaut la peine d'écarter en premier. L'auto breakeven ne déplace le stop qu'après que le marché a parcouru la distance fixée en votre faveur. Si le prix a effleuré le profit sans jamais atteindre le déclencheur, le stop reste exactement là où il doit être. Comptez la distance entre l'entrée et le prix actuel dans la même unité que celle utilisée par votre déclencheur." },
    { type: "heading", text: "2. Les unités ne signifient pas ce que vous croyez" },
    { type: "paragraph", html: "Les valeurs de déclencheur et d'offset suivent l'unité configurée pour votre stratégie, généralement des ticks, mais elles peuvent être des points, des dollars, ou un pourcentage. Un « 4 » que vous pensiez être quatre ticks pourrait être quatre points, ce qui sur de nombreux contrats représente une distance que le marché couvre rarement en une seule poussée. Si votre déclencheur semble raisonnable en tant que nombre mais que le stop ne bouge jamais, vérifiez l'unité, ce seul détail transforme une configuration fonctionnelle en configuration morte." },
    { type: "heading", text: "3. L'auto breakeven n'est en réalité pas activé sur la stratégie que vous utilisez" },
    { type: "paragraph", html: "Les stratégies ATM sont enregistrées comme des profils nommés, il est donc facile d'en modifier une, d'oublier de l'enregistrer, ou de passer l'ordre avec une stratégie <em>différente</em> sélectionnée, ou aucune du tout. Si l'ordre ne porte pas la stratégie dont l'auto breakeven est activé, rien ne déplace le stop. Ouvrez la stratégie, confirmez que le déclencheur d'auto breakeven a une valeur (non vide), enregistrez-la, et assurez-vous que cette stratégie nommée précise est sélectionnée lorsque vous entrez en position." },
    { type: "heading", text: "4. La réduction de position a déplacé votre entrée moyenne" },
    { type: "paragraph", html: "L'auto breakeven cible votre prix d'entrée <strong class='text-white'>moyen</strong>, donc augmenter ou réduire la position déplace cette moyenne et le niveau de breakeven avec elle. Combinez cela avec un offset positif sur un contrat restant, et le stop cible peut à nouveau atterrir devant le prix, si bien qu'il attend. Ne présumez pas que le stop a été déplacé simplement parce qu'un objectif s'est exécuté ; surveillez chaque exécution et confirmez où se situe finalement le stop en cours." },
    { type: "heading", text: "5. Une plateforme tierce gère le déplacement" },
    { type: "paragraph", html: "Si vous routez des ordres via NinjaTrader, TradingView, ou un autre front-end, la logique de breakeven peut résider là plutôt que dans une stratégie ATM Tradovate, et la modification doit tout de même atteindre Tradovate et être acceptée. Un stop qui « passe au breakeven » de manière visible sur un graphique externe ne s'est pas nécessairement propagé jusqu'au courtier. Recoupez avec le rapport Ordres de Tradovate ; si le stop en cours y affiche toujours le prix d'origine, la mise à jour n'est pas arrivée. C'est un problème différent d'un offset ATM natif." },
    { type: "heading", text: "Comment faire en sorte que le stop breakeven bouge quand vous vous y attendez" },
    { type: "heading", text: "Réglez l'offset délibérément" },
    {
      type: "list",
      items: [
        "Ouvrez votre éditeur de stratégie ATM et trouvez les champs <strong class='text-white'>déclencheur de profit</strong> et <strong class='text-white'>offset (Plus)</strong> de l'auto breakeven.",
        "Pour un stop qui atterrit exactement à l'entrée, réglez l'offset sur <strong class='text-white'>Aucun (zéro)</strong>.",
