---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "not-found-md-subscribequote";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/debugging/${SLUG}`;

const META_TITLE = "Tradovate 'Not Found: md/subscribeQuote' Fix";
const META_DESCRIPTION =
  "Seeing 'Not found: md/subscribeQuote'? Route quote subscriptions to the dedicated market-data WebSocket, not the account socket. Clear step-by-step fix.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate API", de: "Tradovate API", es: "Tradovate API", fr: "Tradovate API", it: "Tradovate API" },
  h1: { en: META_TITLE, de: "Tradovate 'Not Found: md/subscribeQuote' beheben", es: "Solución a Tradovate 'Not Found: md/subscribeQuote'", fr: "Correction de l'erreur Tradovate 'Not Found: md/subscribeQuote'", it: "Correzione dell'errore Tradovate 'Not Found: md/subscribeQuote'" },
  dek: { en: "Your auth flow works, your account socket is humming, and md/subscribeQuote still comes back Not found even though the endpoint is right there in the docs. You sent the request to the wrong WebSocket.", de: "Ihr Auth-Ablauf funktioniert, Ihr Konto-Socket läuft, und md/subscribeQuote liefert trotzdem Not found, obwohl der Endpunkt direkt in der Dokumentation steht. Sie haben die Anfrage an den falschen WebSocket gesendet.", es: "Su flujo de autenticación funciona, su socket de cuenta responde, y md/subscribeQuote sigue devolviendo Not found aunque el endpoint está ahí mismo en la documentación. Envió la solicitud al WebSocket equivocado.", fr: "Votre flux d'authentification fonctionne, votre socket de compte tourne sans problème, et md/subscribeQuote renvoie quand même Not found alors que l'endpoint figure bien dans la documentation. Vous avez envoyé la requête au mauvais WebSocket.", it: "Il Suo flusso di autenticazione funziona, il socket dell'account è attivo, e md/subscribeQuote restituisce comunque Not found anche se l'endpoint è proprio lì nella documentazione. Ha inviato la richiesta al WebSocket sbagliato." },
  readTime: { en: "7 min read", de: "7 Min. Lesezeit", es: "Lectura de 7 min", fr: "Lecture : 7 min", it: "Lettura di 7 min" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "Your auth flow worked, your account socket is humming along, and then you fire off a <code>md/subscribeQuote</code> to start streaming live prices and the server hands you back <code>Not found: md/subscribeQuote</code>, often mangled into something like <code>\"\\\"Not found: md/subscribeQuote\\\"\"</code> with escape characters piled on. The endpoint is right there in the docs. So why does Tradovate act like it doesn't exist?" },
    { type: "paragraph", html: "Here's the short version: you sent the request to the wrong WebSocket. Quote subscriptions don't live on the same connection you use to sync your account or place orders. Fix which socket the request goes to and the error clears. Let's walk through exactly why this happens, how to route it correctly, and what tends to break next once the frame finally lands." },
    { type: "heading", text: "What “Not Found” Actually Means Here" },
    { type: "paragraph", html: "Treat this like a 404 on a REST call. A 404 says the URL path doesn't exist on that server. Over Tradovate's WebSocket the logic is identical: every frame you send names an endpoint, and if the socket you're connected to doesn't serve that endpoint, the server replies <code>Not found</code> with the endpoint name echoed back at you." },
    { type: "paragraph", html: "Read that carefully, because it rules a lot out. It's not telling you your symbol is bad. It's not telling you your token expired. It's not telling you your JSON is malformed. It's telling you one thing: “there's no route for <code>md/subscribeQuote</code> on this connection.” And there's exactly one common reason for that." },
    { type: "heading", text: "The Cause: You're on the Account Socket, Not the Market-Data Socket" },
    { type: "paragraph", html: "Tradovate runs two separate WebSocket services, and they are not interchangeable. People wire up the first one, get it authorized, watch account and order data flow perfectly, and then assume that same connection handles everything. It doesn't." },
    {
      type: "list",
      items: [
        "<strong class='text-white'>The account / API socket</strong> handles orders, positions, fills, account sync, and the rest of the entity data. This is where <code>user/syncRequest</code>, <code>order/placeOrder</code>, and <code>account/list</code> belong. Live is <code>wss://live.tradovateapi.com/v1/websocket</code>; demo is <code>wss://demo.tradovateapi.com/v1/websocket</code>.",
        "<strong class='text-white'>The market-data socket</strong> handles live prices, quotes, the DOM, charts, histograms. This is where every <code>md/</code> endpoint lives, including <code>md/subscribeQuote</code>, <code>md/subscribeDOM</code>, and <code>md/getChart</code>. Live is <code>wss://md.tradovateapi.com/v1/websocket</code>; demo is <code>wss://md-demo.tradovateapi.com/v1/websocket</code>.",
      ],
    },
    { type: "paragraph", html: "Send <code>md/subscribeQuote</code> to the account socket and there's simply no matching route, so back comes <code>Not found: md/subscribeQuote</code>. The account socket won't drop a hint that you're knocking on the wrong door, it just reports the endpoint as missing. Here's the full host map so you can line up your environment:" },
    {
      type: "table",
      headers: ["Purpose", "Demo / Simulation", "Live"],
      rows: [
        ["REST auth base", "https://demo.tradovateapi.com/v1/", "https://live.tradovateapi.com/v1/"],
        ["Account / API socket (user/syncRequest, order/placeOrder)", "wss://demo.tradovateapi.com/v1/websocket", "wss://live.tradovateapi.com/v1/websocket"],
        ["Market-data socket (md/subscribeQuote, md/getChart)", "wss://md-demo.tradovateapi.com/v1/websocket", "wss://md.tradovateapi.com/v1/websocket"],
      ],
    },
    { type: "heading", text: "The Fix: Open and Authorize a Second Socket for Quotes" },
    { type: "paragraph", html: "You don't move your account socket. You <em>add</em> a market-data socket alongside it. Keep the account connection for orders and sync; open a brand-new WebSocket to the market-data host for prices. Here's the sequence that clears the error." },
    {
      type: "steps",
      items: [
        { title: "Grab both tokens from your auth response", html: "When you authenticate, Tradovate's response carries more than one token. Alongside the usual <code>accessToken</code> you'll see an <code>mdAccessToken</code> and an <code>expirationTime</code>. That second token isn't decoration, it's issued specifically for the market-data feed. Hold onto it." },
        { title: "Open the market-data WebSocket", html: "Connect to the market-data host that matches your environment: <code>wss://md-demo.tradovateapi.com/v1/websocket</code> if your token came from the demo auth endpoint, or <code>wss://md.tradovateapi.com/v1/websocket</code> if it came from live. Crossing a live token with the demo host (or the reverse) gets you bounced before the subscription ever matters. Wait for the socket's opening <code>o</code> frame before you send anything." },
        { title: "Authorize the socket first", html: "This is the step people skip. A fresh socket answers nothing until you authorize it. The very first frame you send must be the authorize frame carrying your token, use the <code>mdAccessToken</code> for the market-data connection. Tradovate frames are newline-delimited text, not raw JSON: the endpoint, the request id, an (often empty) query line, then the body. Send the authorize frame, wait for the response confirming the socket is authorized, and only then move on. Fire a subscription before this handshake completes and it won't be honored." },
        { title: "Now send md/subscribeQuote", html: "With the socket open and authorized, the subscription finally has a route. Send it as a frame in the same shape, with a JSON body naming a single contract. You can name the contract by its symbol string (like <code>ESU6</code> for the September 2026 E-mini S&amp;P) or by its numeric contract id, both work. The server acknowledges the request and then starts pushing quote events with the bid, ask, and last price for that contract. The <code>Not found</code> error is gone because the endpoint exists on the connection you're now using." },
      ],
    },
    { type: "quote", html: "<strong class='text-white'>Authorize frame:</strong><br><code>authorize<br>1<br><br>&lt;yourMdAccessToken&gt;</code><br><br><strong class='text-white'>Subscribe frame:</strong><br><code>md/subscribeQuote<br>2<br><br>{\"symbol\":\"ESU6\"}</code>" },
    { type: "heading", text: "Subscribe Once Per Symbol, Not in Bulk" },
    { type: "paragraph", html: "A quick trap worth naming: <code>md/subscribeQuote</code> takes a single symbol per call. There's no array form where you hand it a list and get everything at once. If you want to follow ES, NQ, and CL together, send three separate subscribe frames over the same market-data socket, each with its own request id. One socket can carry many live quote subscriptions at the same time, you just register them one at a time. When you're done with a contract, unsubscribe with <code>md/unsubscribeQuote</code> so you're not paying to receive a stream you no longer read." },
    { type: "heading", text: "What Breaks Next: the Socket's Right, But No Prices Show" },
    { type: "paragraph", html: "Once the not-found error clears, the next class of problem is different in nature. The request reaches the market-data engine now, so any failure from here is about <em>what</em> you asked for and <em>whether you're entitled to it</em>, not about a missing route." },
    { type: "heading", text: "“Symbol is inaccessible”" },
    { type: "paragraph", html: "If the subscribe call comes back with an inaccessible or unknown-symbol response, two things are usually in play. First, the symbol has to be a real, fully qualified front-month contract, <code>ESU6</code>, not the bare <code>ES</code> root, and not a contract that already expired and rolled to the next quarter. Second, your account needs the entitlements to see that data at all: the Contract Library plus an active exchange market-data subscription. Without those, a perfectly formed request still returns nothing usable. This is a distinct issue with its own fix." },
    { type: "heading", text: "The socket keeps dropping" },
    { type: "paragraph", html: "Tradovate's WebSocket expects a periodic heartbeat. If you connect, authorize, subscribe, and then go quiet, the server closes the connection and your quotes stop cold. Send an empty heartbeat frame on the interval Tradovate specifies (a short one, on the order of a couple of seconds) so the market-data socket stays open for as long as you need prices. A lot of “it worked for a minute then died” reports trace straight back to a missing heartbeat." },
    { type: "heading", text: "The token expired mid-session" },
    { type: "paragraph", html: "Access tokens don't last forever. If your market-data socket authorized fine at the start of the session and later stops responding, your token may simply have aged out. Renew it before it expires rather than waiting for calls to fail, then re-authorize the socket with the fresh token." },
    { type: "heading", text: "A Quick Checklist to Clear the Error" },
    {
      type: "table",
      headers: ["Check", "What to confirm"],
      rows: [
        ["Right socket", "md/subscribeQuote goes to md.tradovateapi.com (live) or md-demo.tradovateapi.com (demo), never the account socket."],
        ["Matching environment", "Live token → live market-data host; demo token → demo host."],
        ["Authorize first", "Send the authorize frame with your mdAccessToken before any md/ request."],
        ["Full contract symbol", "Use a fully qualified front-month symbol like ESU6, not the ES root or an expired contract."],
        ["One symbol per call", "Send a separate subscribe frame per contract; there's no bulk array form."],
        ["Heartbeats + token", "Keep the socket alive with heartbeats and renew the token before it expires."],
      ],
    },
    { type: "heading", text: "Skip the Raw Socket Wiring" },
    { type: "paragraph", html: "Most people who hit <code>Not found: md/subscribeQuote</code> aren't chasing a data-vendor project, they just want a strategy to trade on Tradovate without babysitting two sockets, two tokens, heartbeats, and frame formats. If that's you, there's a much shorter path than hand-coding the whole WebSocket layer." },
    { type: "paragraph", html: "For the problems that tend to show up right after this one, these guides go deeper: if your symbols come back inaccessible rather than not-found, that's a separate entitlement and symbol-format issue; to get real-time prices flowing in the first place, subscribing to Tradovate real-time market data is the starting point; and if your socket authorizes fine then quietly stops answering, that's usually the 90-minute access token expiring mid-session." },
  ], de: [
    { type: "paragraph",html: "Ihr Auth-Ablauf hat funktioniert, Ihr Konto-Socket läuft, und dann senden Sie ein <code>md/subscribeQuote</code>, um Live-Kurse zu streamen, und der Server antwortet mit <code>Not found: md/subscribeQuote</code>, oft verstümmelt zu etwas wie <code>\"\\\"Not found: md/subscribeQuote\\\"\"</code> mit gehäuften Escape-Zeichen. Der Endpunkt steht direkt in der Dokumentation. Warum tut Tradovate also so, als gäbe es ihn nicht?" },
    { type: "paragraph",html: "Die Kurzfassung: Sie haben die Anfrage an den falschen WebSocket gesendet. Kursabonnements liegen nicht auf derselben Verbindung, mit der Sie Ihr Konto synchronisieren oder Orders platzieren. Korrigieren Sie den Socket, an den die Anfrage geht, und der Fehler verschwindet. Gehen wir genau durch, warum das passiert, wie Sie korrekt routen und was als Nächstes typischerweise bricht, sobald der Frame endlich ankommt." },
    { type: "heading",text: "Was „Not Found“ hier tatsächlich bedeutet" },
    { type: "paragraph",html: "Behandeln Sie es wie ein 404 bei einem REST-Aufruf. Ein 404 sagt, dass der URL-Pfad auf diesem Server nicht existiert. Beim WebSocket von Tradovate gilt dieselbe Logik: Jeder gesendete Frame nennt einen Endpunkt, und wenn der Socket, mit dem Sie verbunden sind, diesen Endpunkt nicht bedient, antwortet der Server mit <code>Not found</code> und gibt den Endpunktnamen zurück." },
    { type: "paragraph",html: "Lesen Sie das genau, denn es schließt vieles aus. Es sagt nicht, dass Ihr Symbol falsch ist. Es sagt nicht, dass Ihr Token abgelaufen ist. Es sagt nicht, dass Ihr JSON fehlerhaft ist. Es sagt nur eines: „Für <code>md/subscribeQuote</code> gibt es auf dieser Verbindung keine Route.“ Und dafür gibt es genau einen häufigen Grund." },
    { type: "heading",text: "Die Ursache: Sie sind auf dem Konto-Socket, nicht auf dem Marktdaten-Socket" },
    { type: "paragraph",html: "Tradovate betreibt zwei getrennte WebSocket-Dienste, die nicht austauschbar sind. Viele richten den ersten ein, autorisieren ihn, sehen Konto- und Orderdaten einwandfrei fließen und nehmen dann an, dass dieselbe Verbindung alles erledigt. Das tut sie nicht." },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Der Konto-/API-Socket</strong> verarbeitet Orders, Positionen, Ausführungen, Kontosynchronisierung und die übrigen Entitätsdaten. Hier gehören <code>user/syncRequest</code>, <code>order/placeOrder</code> und <code>account/list</code> hin. Live ist <code>wss://live.tradovateapi.com/v1/websocket</code>; Demo ist <code>wss://demo.tradovateapi.com/v1/websocket</code>.",
        "<strong class='text-white'>Der Marktdaten-Socket</strong> verarbeitet Live-Kurse, Quotes, das DOM, Charts und Histogramme. Hier liegt jeder <code>md/</code>-Endpunkt, einschließlich <code>md/subscribeQuote</code>, <code>md/subscribeDOM</code> und <code>md/getChart</code>. Live ist <code>wss://md.tradovateapi.com/v1/websocket</code>; Demo ist <code>wss://md-demo.tradovateapi.com/v1/websocket</code>.",
      ],
    },
    { type: "paragraph",html: "Senden Sie <code>md/subscribeQuote</code> an den Konto-Socket, gibt es schlicht keine passende Route, und es kommt <code>Not found: md/subscribeQuote</code> zurück. Der Konto-Socket gibt keinen Hinweis, dass Sie an der falschen Tür klopfen, er meldet den Endpunkt einfach als fehlend. Hier die vollständige Host-Übersicht, damit Sie Ihre Umgebung abgleichen können:" },
    { type: "table", headers: ["Zweck","Demo / Simulation","Live"], rows: [
      ["REST-Auth-Basis","https://demo.tradovateapi.com/v1/","https://live.tradovateapi.com/v1/"],
      ["Konto-/API-Socket (user/syncRequest, order/placeOrder)","wss://demo.tradovateapi.com/v1/websocket","wss://live.tradovateapi.com/v1/websocket"],
      ["Marktdaten-Socket (md/subscribeQuote, md/getChart)","wss://md-demo.tradovateapi.com/v1/websocket","wss://md.tradovateapi.com/v1/websocket"],
    ] },
    { type: "heading",text: "Die Lösung: Einen zweiten Socket für Kurse öffnen und autorisieren" },
    { type: "paragraph",html: "Sie verschieben Ihren Konto-Socket nicht. Sie <em>fügen</em> daneben einen Marktdaten-Socket hinzu. Behalten Sie die Kontoverbindung für Orders und Synchronisierung bei; öffnen Sie einen neuen WebSocket zum Marktdaten-Host für Kurse. Diese Abfolge behebt den Fehler." },
    {
      type: "steps",
      items: [
        { title: "Beide Token aus Ihrer Auth-Antwort entnehmen", html: "Bei der Authentifizierung enthält die Antwort von Tradovate mehr als ein Token. Neben dem üblichen <code>accessToken</code> sehen Sie ein <code>mdAccessToken</code> und eine <code>expirationTime</code>. Dieses zweite Token ist keine Dekoration, es wird speziell für den Marktdaten-Feed ausgestellt. Bewahren Sie es auf." },
        { title: "Den Marktdaten-WebSocket öffnen", html: "Verbinden Sie sich mit dem Marktdaten-Host, der zu Ihrer Umgebung passt: <code>wss://md-demo.tradovateapi.com/v1/websocket</code>, wenn Ihr Token vom Demo-Auth-Endpunkt stammt, oder <code>wss://md.tradovateapi.com/v1/websocket</code>, wenn es vom Live-Endpunkt stammt. Ein Live-Token mit dem Demo-Host zu kreuzen (oder umgekehrt) führt zur Abweisung, noch bevor das Abonnement relevant wird. Warten Sie auf den öffnenden <code>o</code>-Frame des Sockets, bevor Sie etwas senden." },
        { title: "Den Socket zuerst autorisieren", html: "Diesen Schritt überspringen viele. Ein frischer Socket antwortet auf nichts, bis Sie ihn autorisieren. Der allererste gesendete Frame muss der authorize-Frame mit Ihrem Token sein, verwenden Sie für die Marktdatenverbindung das <code>mdAccessToken</code>. Tradovate-Frames sind zeilenweise getrennter Text, kein reines JSON: der Endpunkt, die Request-ID, eine (oft leere) Query-Zeile, dann der Body. Senden Sie den authorize-Frame, warten Sie auf die Antwort, die die Autorisierung des Sockets bestätigt, und fahren Sie erst dann fort. Wird ein Abonnement vor Abschluss dieses Handshakes gesendet, wird es nicht berücksichtigt." },
        { title: "Jetzt md/subscribeQuote senden", html: "Mit geöffnetem und autorisiertem Socket hat das Abonnement endlich eine Route. Senden Sie es als Frame in derselben Form, mit einem JSON-Body, der einen einzelnen Kontrakt benennt. Sie können den Kontrakt über seinen Symbol-String (wie <code>ESU6</code> für den E-mini S&amp;P vom September 2026) oder über seine numerische Kontrakt-ID benennen, beides funktioniert. Der Server bestätigt die Anfrage und beginnt dann, Quote-Ereignisse mit Bid, Ask und Last-Preis für diesen Kontrakt zu senden. Der Fehler <code>Not found</code> ist verschwunden, weil der Endpunkt auf der Verbindung existiert, die Sie jetzt nutzen." },
      ],
    },
    { type: "quote",html: "<strong class='text-white'>Authorize-Frame:</strong><br><code>authorize<br>1<br><br>&lt;yourMdAccessToken&gt;</code><br><br><strong class='text-white'>Subscribe-Frame:</strong><br><code>md/subscribeQuote<br>2<br><br>{\"symbol\":\"ESU6\"}</code>" },
    { type: "heading",text: "Einmal pro Symbol abonnieren, nicht gebündelt" },
    { type: "paragraph",html: "Eine kleine Falle, die man kennen sollte: <code>md/subscribeQuote</code> nimmt pro Aufruf ein einzelnes Symbol entgegen. Es gibt keine Array-Form, bei der Sie eine Liste übergeben und alles auf einmal erhalten. Wenn Sie ES, NQ und CL gemeinsam verfolgen möchten, senden Sie drei separate Subscribe-Frames über denselben Marktdaten-Socket, jeweils mit eigener Request-ID. Ein Socket kann viele Live-Kursabonnements gleichzeitig tragen, Sie registrieren sie nur einzeln nacheinander. Wenn Sie mit einem Kontrakt fertig sind, kündigen Sie mit <code>md/unsubscribeQuote</code>, damit Sie keinen Stream empfangen, den Sie nicht mehr lesen." },
    { type: "heading",text: "Was als Nächstes bricht: Der Socket stimmt, aber es erscheinen keine Kurse" },
    { type: "paragraph",html: "Sobald der Not-found-Fehler verschwunden ist, ist die nächste Problemklasse anderer Natur. Die Anfrage erreicht jetzt die Marktdaten-Engine, jeder weitere Fehler betrifft also <em>was</em> Sie angefordert haben und <em>ob Sie dazu berechtigt sind</em>, nicht eine fehlende Route." },
    { type: "heading",text: "„Symbol is inaccessible“" },
    { type: "paragraph",html: "Wenn der Subscribe-Aufruf mit einer Antwort „inaccessible“ oder „unknown symbol“ zurückkommt, spielen meist zwei Dinge eine Rolle. Erstens muss das Symbol ein echter, vollständig qualifizierter Front-Month-Kontrakt sein, <code>ESU6</code>, nicht der bloße Root <code>ES</code> und nicht ein bereits abgelaufener Kontrakt, der ins nächste Quartal gerollt wurde. Zweitens benötigt Ihr Konto die Berechtigungen, diese Daten überhaupt zu sehen: die Contract Library plus ein aktives Börsen-Marktdatenabonnement. Ohne diese liefert selbst eine perfekt geformte Anfrage nichts Brauchbares. Das ist ein eigenes Problem mit eigener Lösung." },
    { type: "heading",text: "Der Socket bricht immer wieder ab" },
    { type: "paragraph",html: "Der WebSocket von Tradovate erwartet einen periodischen Heartbeat. Wenn Sie sich verbinden, autorisieren, abonnieren und dann schweigen, schließt der Server die Verbindung und Ihre Kurse hören abrupt auf. Senden Sie einen leeren Heartbeat-Frame in dem von Tradovate vorgegebenen Intervall (ein kurzes, in der Größenordnung weniger Sekunden), damit der Marktdaten-Socket so lange offen bleibt, wie Sie Kurse benötigen. Viele Berichte vom Typ „es lief eine Minute, dann ging es kaputt“ lassen sich direkt auf einen fehlenden Heartbeat zurückführen." },
    { type: "heading",text: "Das Token ist mitten in der Sitzung abgelaufen" },
    { type: "paragraph",html: "Access-Token halten nicht ewig. Wenn Ihr Marktdaten-Socket zu Beginn der Sitzung einwandfrei autorisiert war und später nicht mehr antwortet, ist Ihr Token möglicherweise einfach abgelaufen. Erneuern Sie es, bevor es abläuft, statt zu warten, bis Aufrufe fehlschlagen, und autorisieren Sie den Socket dann mit dem neuen Token erneut." },
    { type: "heading",text: "Eine kurze Checkliste zur Fehlerbehebung" },
    { type: "table", headers: ["Prüfpunkt","Was zu bestätigen ist"], rows: [
      ["Richtiger Socket","md/subscribeQuote geht an md.tradovateapi.com (live) oder md-demo.tradovateapi.com (Demo), nie an den Konto-Socket."],
      ["Passende Umgebung","Live-Token → Live-Marktdaten-Host; Demo-Token → Demo-Host."],
      ["Zuerst autorisieren","Senden Sie den authorize-Frame mit Ihrem mdAccessToken vor jeder md/-Anfrage."],
      ["Vollständiges Kontrakt-Symbol","Verwenden Sie ein vollständig qualifiziertes Front-Month-Symbol wie ESU6, nicht den ES-Root oder einen abgelaufenen Kontrakt."],
      ["Ein Symbol pro Aufruf","Senden Sie pro Kontrakt einen eigenen Subscribe-Frame; es gibt keine Bulk-Array-Form."],
      ["Heartbeats + Token","Halten Sie den Socket mit Heartbeats am Leben und erneuern Sie das Token vor Ablauf."],
    ] },
    { type: "heading",text: "Verzichten Sie auf die manuelle Socket-Verdrahtung" },
    { type: "paragraph",html: "Die meisten, die auf <code>Not found: md/subscribeQuote</code> stoßen, verfolgen kein Datenanbieter-Projekt, sie möchten einfach, dass eine Strategie auf Tradovate handelt, ohne zwei Sockets, zwei Token, Heartbeats und Frame-Formate zu betreuen. Wenn das auf Sie zutrifft, gibt es einen deutlich kürzeren Weg, als die gesamte WebSocket-Schicht von Hand zu programmieren." },
    { type: "paragraph",html: "Für die Probleme, die typischerweise direkt danach auftreten, gehen diese Anleitungen tiefer: Wenn Ihre Symbole „inaccessible“ statt not-found zurückgeben, ist das ein separates Problem mit Berechtigungen und Symbolformat; um überhaupt Echtzeitkurse zu erhalten, ist das Abonnieren der Tradovate-Echtzeit-Marktdaten der Ausgangspunkt; und wenn Ihr Socket einwandfrei autorisiert und dann still nicht mehr antwortet, ist das meist das Ablaufen des 90-Minuten-Access-Tokens mitten in der Sitzung." },
  ], es: [
    { type: "paragraph",html: "Su flujo de autenticación funcionó, su socket de cuenta funciona sin problemas y entonces lanza un <code>md/subscribeQuote</code> para empezar a recibir precios en vivo y el servidor le devuelve <code>Not found: md/subscribeQuote</code>, a menudo deformado en algo como <code>\"\\\"Not found: md/subscribeQuote\\\"\"</code> con caracteres de escape acumulados. El endpoint está ahí mismo en la documentación. Entonces, ¿por qué Tradovate actúa como si no existiera?" },
    { type: "paragraph",html: "Esta es la versión corta: envió la solicitud al WebSocket equivocado. Las suscripciones de cotizaciones no viven en la misma conexión que usa para sincronizar su cuenta o colocar órdenes. Corrija a qué socket va la solicitud y el error desaparece. Veamos exactamente por qué ocurre, cómo enrutarlo correctamente y qué suele fallar a continuación una vez que el frame por fin llega." },
    { type: "heading",text: "Qué significa realmente “Not Found” aquí" },
    { type: "paragraph",html: "Trátelo como un 404 en una llamada REST. Un 404 indica que la ruta de la URL no existe en ese servidor. En el WebSocket de Tradovate la lógica es idéntica: cada frame que envía nombra un endpoint, y si el socket al que está conectado no sirve ese endpoint, el servidor responde <code>Not found</code> devolviéndole el nombre del endpoint." },
    { type: "paragraph",html: "Lea eso con atención, porque descarta muchas cosas. No le dice que su símbolo sea incorrecto. No le dice que su token haya expirado. No le dice que su JSON esté mal formado. Le dice una sola cosa: “no hay ninguna ruta para <code>md/subscribeQuote</code> en esta conexión”. Y hay exactamente una razón común para eso." },
    { type: "heading",text: "La causa: está en el socket de cuenta, no en el socket de datos de mercado" },
    { type: "paragraph",html: "Tradovate ejecuta dos servicios WebSocket separados que no son intercambiables. Mucha gente configura el primero, lo autoriza, ve que los datos de cuenta y órdenes fluyen perfectamente y luego asume que esa misma conexión se encarga de todo. No es así." },
    {
      type: "list",
      items: [
        "<strong class='text-white'>El socket de cuenta / API</strong> gestiona órdenes, posiciones, ejecuciones, sincronización de cuenta y el resto de datos de entidades. Aquí es donde pertenecen <code>user/syncRequest</code>, <code>order/placeOrder</code> y <code>account/list</code>. En vivo es <code>wss://live.tradovateapi.com/v1/websocket</code>; en demo es <code>wss://demo.tradovateapi.com/v1/websocket</code>.",
        "<strong class='text-white'>El socket de datos de mercado</strong> gestiona precios en vivo, cotizaciones, el DOM, gráficos e histogramas. Aquí es donde vive cada endpoint <code>md/</code>, incluidos <code>md/subscribeQuote</code>, <code>md/subscribeDOM</code> y <code>md/getChart</code>. En vivo es <code>wss://md.tradovateapi.com/v1/websocket</code>; en demo es <code>wss://md-demo.tradovateapi.com/v1/websocket</code>.",
      ],
    },
    { type: "paragraph",html: "Envíe <code>md/subscribeQuote</code> al socket de cuenta y simplemente no hay ruta coincidente, así que regresa <code>Not found: md/subscribeQuote</code>. El socket de cuenta no le insinuará que está llamando a la puerta equivocada, solo informa de que el endpoint falta. Aquí tiene el mapa completo de hosts para que alinee su entorno:" },
    { type: "table", headers: ["Propósito","Demo / Simulación","En vivo"], rows: [
      ["Base REST de autenticación","https://demo.tradovateapi.com/v1/","https://live.tradovateapi.com/v1/"],
      ["Socket de cuenta / API (user/syncRequest, order/placeOrder)","wss://demo.tradovateapi.com/v1/websocket","wss://live.tradovateapi.com/v1/websocket"],
      ["Socket de datos de mercado (md/subscribeQuote, md/getChart)","wss://md-demo.tradovateapi.com/v1/websocket","wss://md.tradovateapi.com/v1/websocket"],
    ] },
    { type: "heading",text: "La solución: abrir y autorizar un segundo socket para las cotizaciones" },
    { type: "paragraph",html: "No mueve su socket de cuenta. <em>Añade</em> un socket de datos de mercado a su lado. Mantenga la conexión de cuenta para órdenes y sincronización; abra un WebSocket nuevo al host de datos de mercado para los precios. Esta es la secuencia que elimina el error." },
    {
      type: "steps",
      items: [
        { title: "Tome ambos tokens de su respuesta de autenticación", html: "Al autenticarse, la respuesta de Tradovate incluye más de un token. Junto al habitual <code>accessToken</code> verá un <code>mdAccessToken</code> y un <code>expirationTime</code>. Ese segundo token no es decorativo, se emite específicamente para el feed de datos de mercado. Consérvelo." },
        { title: "Abra el WebSocket de datos de mercado", html: "Conéctese al host de datos de mercado que corresponda a su entorno: <code>wss://md-demo.tradovateapi.com/v1/websocket</code> si su token proviene del endpoint de autenticación demo, o <code>wss://md.tradovateapi.com/v1/websocket</code> si proviene del real. Cruzar un token real con el host demo (o al revés) hace que lo rechacen antes de que la suscripción importe. Espere al frame <code>o</code> de apertura del socket antes de enviar nada." },
        { title: "Autorice primero el socket", html: "Este es el paso que la gente omite. Un socket nuevo no responde a nada hasta que lo autoriza. El primer frame que envíe debe ser el frame authorize con su token, use el <code>mdAccessToken</code> para la conexión de datos de mercado. Los frames de Tradovate son texto delimitado por saltos de línea, no JSON en bruto: el endpoint, el id de solicitud, una línea de consulta (a menudo vacía) y luego el cuerpo. Envíe el frame authorize, espere la respuesta que confirma que el socket está autorizado y solo entonces continúe. Si lanza una suscripción antes de que se complete este handshake, no será atendida." },
        { title: "Ahora envíe md/subscribeQuote", html: "Con el socket abierto y autorizado, la suscripción por fin tiene una ruta. Envíela como un frame con la misma forma, con un cuerpo JSON que nombre un único contrato. Puede nombrar el contrato por su cadena de símbolo (como <code>ESU6</code> para el E-mini S&amp;P de septiembre de 2026) o por su id numérico de contrato, ambos funcionan. El servidor confirma la solicitud y luego empieza a enviar eventos de cotización con bid, ask y último precio de ese contrato. El error <code>Not found</code> desaparece porque el endpoint existe en la conexión que ahora usa." },
      ],
    },
    { type: "quote",html: "<strong class='text-white'>Frame authorize:</strong><br><code>authorize<br>1<br><br>&lt;yourMdAccessToken&gt;</code><br><br><strong class='text-white'>Frame subscribe:</strong><br><code>md/subscribeQuote<br>2<br><br>{\"symbol\":\"ESU6\"}</code>" },
    { type: "heading",text: "Suscríbase una vez por símbolo, no en bloque" },
    { type: "paragraph",html: "Una trampa rápida que conviene nombrar: <code>md/subscribeQuote</code> admite un único símbolo por llamada. No existe una forma de array en la que entregue una lista y obtenga todo de una vez. Si quiere seguir ES, NQ y CL a la vez, envíe tres frames de suscripción separados por el mismo socket de datos de mercado, cada uno con su propio id de solicitud. Un socket puede llevar muchas suscripciones de cotizaciones en vivo al mismo tiempo, solo las registra de una en una. Cuando termine con un contrato, cancele la suscripción con <code>md/unsubscribeQuote</code> para no recibir un flujo que ya no lee." },
    { type: "heading",text: "Qué falla a continuación: el socket es correcto, pero no aparecen precios" },
    { type: "paragraph",html: "Una vez que desaparece el error de no encontrado, la siguiente clase de problema es de naturaleza distinta. La solicitud ya llega al motor de datos de mercado, así que cualquier fallo a partir de aquí tiene que ver con <em>qué</em> pidió y <em>si tiene derecho a ello</em>, no con una ruta ausente." },
    { type: "heading",text: "“Symbol is inaccessible”" },
    { type: "paragraph",html: "Si la llamada de suscripción devuelve una respuesta de inaccesible o símbolo desconocido, normalmente intervienen dos factores. Primero, el símbolo debe ser un contrato de vencimiento más cercano real y totalmente cualificado, <code>ESU6</code>, no la raíz <code>ES</code> a secas, ni un contrato que ya venció y pasó al siguiente trimestre. Segundo, su cuenta necesita los permisos para ver esos datos: la Contract Library más una suscripción activa de datos de mercado de la bolsa. Sin ellos, una solicitud perfectamente formada sigue sin devolver nada utilizable. Es un problema distinto con su propia solución." },
    { type: "heading",text: "El socket se sigue cayendo" },
    { type: "paragraph",html: "El WebSocket de Tradovate espera un heartbeat periódico. Si se conecta, autoriza, se suscribe y luego se queda en silencio, el servidor cierra la conexión y sus cotizaciones se detienen en seco. Envíe un frame heartbeat vacío en el intervalo que especifica Tradovate (uno corto, del orden de un par de segundos) para que el socket de datos de mercado siga abierto el tiempo que necesite los precios. Muchos reportes de “funcionó un minuto y luego murió” se remontan directamente a la falta de un heartbeat." },
    { type: "heading",text: "El token expiró a mitad de sesión" },
    { type: "paragraph",html: "Los tokens de acceso no duran para siempre. Si su socket de datos de mercado se autorizó bien al inicio de la sesión y más tarde deja de responder, es posible que su token simplemente haya caducado. Renuévelo antes de que expire en lugar de esperar a que las llamadas fallen, y luego vuelva a autorizar el socket con el token nuevo." },
    { type: "heading",text: "Una lista de comprobación rápida para eliminar el error" },
    { type: "table", headers: ["Comprobación","Qué confirmar"], rows: [
      ["Socket correcto","md/subscribeQuote va a md.tradovateapi.com (real) o md-demo.tradovateapi.com (demo), nunca al socket de cuenta."],
      ["Entorno coincidente","Token real → host de datos de mercado real; token demo → host demo."],
      ["Autorizar primero","Envíe el frame authorize con su mdAccessToken antes de cualquier solicitud md/."],
      ["Símbolo de contrato completo","Use un símbolo de vencimiento más cercano totalmente cualificado como ESU6, no la raíz ES ni un contrato vencido."],
      ["Un símbolo por llamada","Envíe un frame de suscripción separado por contrato; no existe forma de array en bloque."],
      ["Heartbeats + token","Mantenga el socket vivo con heartbeats y renueve el token antes de que expire."],
    ] },
    { type: "heading",text: "Olvídese del cableado de sockets en bruto" },
    { type: "paragraph",html: "La mayoría de quienes se topan con <code>Not found: md/subscribeQuote</code> no persiguen un proyecto de proveedor de datos, solo quieren que una estrategia opere en Tradovate sin tener que vigilar dos sockets, dos tokens, heartbeats y formatos de frame. Si es su caso, hay un camino mucho más corto que programar a mano toda la capa de WebSocket." },
    { type: "paragraph",html: "Para los problemas que suelen aparecer justo después de este, estas guías profundizan más: si sus símbolos devuelven inaccesible en lugar de not-found, es un problema distinto de permisos y formato de símbolo; para que los precios en tiempo real fluyan en primer lugar, suscribirse a los datos de mercado en tiempo real de Tradovate es el punto de partida; y si su socket se autoriza bien y luego deja de responder en silencio, suele ser que el token de acceso de 90 minutos expira a mitad de sesión." },
  ], fr: [
    { type: "paragraph",html: "Votre flux d'authentification a fonctionné, votre socket de compte tourne sans problème, puis vous envoyez un <code>md/subscribeQuote</code> pour démarrer le flux de prix en direct et le serveur vous renvoie <code>Not found: md/subscribeQuote</code>, souvent déformé en quelque chose comme <code>\"\\\"Not found: md/subscribeQuote\\\"\"</code> avec des caractères d'échappement empilés. L'endpoint est bien dans la documentation. Alors pourquoi Tradovate agit-il comme s'il n'existait pas ?" },
    { type: "paragraph",html: "Voici la version courte : vous avez envoyé la requête au mauvais WebSocket. Les abonnements aux cotations ne vivent pas sur la même connexion que celle que vous utilisez pour synchroniser votre compte ou passer des ordres. Corrigez le socket auquel la requête est envoyée et l'erreur disparaît. Voyons précisément pourquoi cela arrive, comment router correctement et ce qui a tendance à casser ensuite une fois la trame enfin arrivée." },
    { type: "heading",text: "Ce que « Not Found » signifie réellement ici" },
    { type: "paragraph",html: "Traitez cela comme un 404 sur un appel REST. Un 404 indique que le chemin d'URL n'existe pas sur ce serveur. Sur le WebSocket de Tradovate, la logique est identique : chaque trame que vous envoyez nomme un endpoint, et si le socket auquel vous êtes connecté ne sert pas cet endpoint, le serveur répond <code>Not found</code> en vous renvoyant le nom de l'endpoint." },
    { type: "paragraph",html: "Lisez bien cela, car cela écarte beaucoup d'hypothèses. Il ne vous dit pas que votre symbole est mauvais. Il ne vous dit pas que votre jeton a expiré. Il ne vous dit pas que votre JSON est mal formé. Il vous dit une seule chose : « il n'existe aucune route pour <code>md/subscribeQuote</code> sur cette connexion ». Et il n'y a qu'une seule raison courante à cela." },
    { type: "heading",text: "La cause : vous êtes sur le socket de compte, pas sur le socket de données de marché" },
    { type: "paragraph",html: "Tradovate exploite deux services WebSocket distincts, qui ne sont pas interchangeables. Beaucoup câblent le premier, l'autorisent, voient les données de compte et d'ordres circuler parfaitement, puis supposent que cette même connexion gère tout. Ce n'est pas le cas." },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Le socket de compte / API</strong> gère les ordres, les positions, les exécutions, la synchronisation du compte et le reste des données d'entités. C'est ici que se trouvent <code>user/syncRequest</code>, <code>order/placeOrder</code> et <code>account/list</code>. En réel : <code>wss://live.tradovateapi.com/v1/websocket</code> ; en démo : <code>wss://demo.tradovateapi.com/v1/websocket</code>.",
        "<strong class='text-white'>Le socket de données de marché</strong> gère les prix en direct, les cotations, le DOM, les graphiques et les histogrammes. C'est ici que vit chaque endpoint <code>md/</code>, y compris <code>md/subscribeQuote</code>, <code>md/subscribeDOM</code> et <code>md/getChart</code>. En réel : <code>wss://md.tradovateapi.com/v1/websocket</code> ; en démo : <code>wss://md-demo.tradovateapi.com/v1/websocket</code>.",
      ],
    },
    { type: "paragraph",html: "Envoyez <code>md/subscribeQuote</code> au socket de compte et il n'existe tout simplement aucune route correspondante, d'où le retour de <code>Not found: md/subscribeQuote</code>. Le socket de compte ne vous laissera pas entendre que vous frappez à la mauvaise porte, il signale simplement que l'endpoint est manquant. Voici la carte complète des hôtes pour aligner votre environnement :" },
    { type: "table", headers: ["Usage","Démo / Simulation","Réel"], rows: [
      ["Base REST d'authentification","https://demo.tradovateapi.com/v1/","https://live.tradovateapi.com/v1/"],
      ["Socket de compte / API (user/syncRequest, order/placeOrder)","wss://demo.tradovateapi.com/v1/websocket","wss://live.tradovateapi.com/v1/websocket"],
      ["Socket de données de marché (md/subscribeQuote, md/getChart)","wss://md-demo.tradovateapi.com/v1/websocket","wss://md.tradovateapi.com/v1/websocket"],
    ] },
    { type: "heading",text: "La solution : ouvrir et autoriser un second socket pour les cotations" },
    { type: "paragraph",html: "Vous ne déplacez pas votre socket de compte. Vous <em>ajoutez</em> un socket de données de marché à côté. Conservez la connexion de compte pour les ordres et la synchronisation ; ouvrez un tout nouveau WebSocket vers l'hôte de données de marché pour les prix. Voici la séquence qui élimine l'erreur." },
    {
      type: "steps",
      items: [
        { title: "Récupérez les deux jetons dans votre réponse d'authentification", html: "Lorsque vous vous authentifiez, la réponse de Tradovate contient plus d'un jeton. À côté du <code>accessToken</code> habituel, vous verrez un <code>mdAccessToken</code> et un <code>expirationTime</code>. Ce second jeton n'est pas décoratif, il est émis spécifiquement pour le flux de données de marché. Conservez-le." },
        { title: "Ouvrez le WebSocket de données de marché", html: "Connectez-vous à l'hôte de données de marché correspondant à votre environnement : <code>wss://md-demo.tradovateapi.com/v1/websocket</code> si votre jeton provient de l'endpoint d'authentification démo, ou <code>wss://md.tradovateapi.com/v1/websocket</code> s'il provient du réel. Croiser un jeton réel avec l'hôte démo (ou l'inverse) vous fait rejeter avant même que l'abonnement n'ait de l'importance. Attendez la trame <code>o</code> d'ouverture du socket avant d'envoyer quoi que ce soit." },
        { title: "Autorisez d'abord le socket", html: "C'est l'étape que l'on saute. Un socket neuf ne répond à rien tant que vous ne l'avez pas autorisé. La toute première trame envoyée doit être la trame authorize portant votre jeton, utilisez le <code>mdAccessToken</code> pour la connexion de données de marché. Les trames Tradovate sont du texte délimité par des sauts de ligne, et non du JSON brut : l'endpoint, l'identifiant de requête, une ligne de requête (souvent vide), puis le corps. Envoyez la trame authorize, attendez la réponse confirmant que le socket est autorisé, et seulement ensuite passez à la suite. Si vous lancez un abonnement avant la fin de cette poignée de main, il ne sera pas pris en compte." },
        { title: "Envoyez maintenant md/subscribeQuote", html: "Avec le socket ouvert et autorisé, l'abonnement dispose enfin d'une route. Envoyez-le comme une trame de même forme, avec un corps JSON nommant un seul contrat. Vous pouvez désigner le contrat par sa chaîne de symbole (comme <code>ESU6</code> pour l'E-mini S&amp;P de septembre 2026) ou par son identifiant numérique de contrat, les deux fonctionnent. Le serveur accuse réception de la requête puis commence à pousser des événements de cotation avec le bid, l'ask et le dernier prix de ce contrat. L'erreur <code>Not found</code> disparaît parce que l'endpoint existe sur la connexion que vous utilisez désormais." },
      ],
    },
    { type: "quote",html: "<strong class='text-white'>Trame authorize :</strong><br><code>authorize<br>1<br><br>&lt;yourMdAccessToken&gt;</code><br><br><strong class='text-white'>Trame subscribe :</strong><br><code>md/subscribeQuote<br>2<br><br>{\"symbol\":\"ESU6\"}</code>" },
    { type: "heading",text: "Abonnez-vous une fois par symbole, pas en bloc" },
    { type: "paragraph",html: "Un piège rapide qu'il vaut la peine de nommer : <code>md/subscribeQuote</code> accepte un seul symbole par appel. Il n'existe pas de forme tableau où vous fournissez une liste pour tout obtenir d'un coup. Si vous voulez suivre ES, NQ et CL ensemble, envoyez trois trames d'abonnement distinctes sur le même socket de données de marché, chacune avec son propre identifiant de requête. Un socket peut porter de nombreux abonnements de cotations en direct simultanément, il suffit de les enregistrer un par un. Lorsque vous en avez fini avec un contrat, désabonnez-vous avec <code>md/unsubscribeQuote</code> pour ne pas recevoir un flux que vous ne lisez plus." },
    { type: "heading",text: "Ce qui casse ensuite : le socket est bon, mais aucun prix ne s'affiche" },
    { type: "paragraph",html: "Une fois l'erreur not-found disparue, la classe de problème suivante est d'une autre nature. La requête atteint désormais le moteur de données de marché ; tout échec à partir de là concerne donc <em>ce que</em> vous avez demandé et <em>si vous y avez droit</em>, et non une route manquante." },
    { type: "heading",text: "« Symbol is inaccessible »" },
    { type: "paragraph",html: "Si l'appel d'abonnement renvoie une réponse d'inaccessibilité ou de symbole inconnu, deux éléments sont généralement en jeu. D'abord, le symbole doit être un véritable contrat à échéance rapprochée, entièrement qualifié, <code>ESU6</code>, et non la racine <code>ES</code> seule, ni un contrat déjà expiré et basculé sur le trimestre suivant. Ensuite, votre compte a besoin des droits pour voir ces données : la Contract Library plus un abonnement actif aux données de marché de la bourse. Sans cela, une requête parfaitement formée ne renvoie rien d'exploitable. C'est un problème distinct, avec sa propre solution." },
    { type: "heading",text: "Le socket se coupe sans cesse" },
    { type: "paragraph",html: "Le WebSocket de Tradovate attend un heartbeat périodique. Si vous vous connectez, autorisez, vous abonnez puis restez silencieux, le serveur ferme la connexion et vos cotations s'arrêtent net. Envoyez une trame heartbeat vide à l'intervalle indiqué par Tradovate (un intervalle court, de l'ordre de quelques secondes) afin que le socket de données de marché reste ouvert aussi longtemps que vous avez besoin des prix. Beaucoup de signalements du type « ça a marché une minute puis c'est mort » remontent directement à un heartbeat manquant." },
    { type: "heading",text: "Le jeton a expiré en pleine session" },
    { type: "paragraph",html: "Les jetons d'accès ne durent pas éternellement. Si votre socket de données de marché s'est bien autorisé au début de la session puis cesse de répondre, votre jeton a peut-être simplement expiré. Renouvelez-le avant son expiration plutôt que d'attendre l'échec des appels, puis réautorisez le socket avec le nouveau jeton." },
    { type: "heading",text: "Une liste de vérification rapide pour éliminer l'erreur" },
    { type: "table", headers: ["Vérification","Ce qu'il faut confirmer"], rows: [
      ["Bon socket","md/subscribeQuote va vers md.tradovateapi.com (réel) ou md-demo.tradovateapi.com (démo), jamais vers le socket de compte."],
      ["Environnement cohérent","Jeton réel → hôte de données de marché réel ; jeton démo → hôte démo."],
      ["Autoriser d'abord","Envoyez la trame authorize avec votre mdAccessToken avant toute requête md/."],
      ["Symbole de contrat complet","Utilisez un symbole à échéance rapprochée entièrement qualifié comme ESU6, et non la racine ES ou un contrat expiré."],
      ["Un symbole par appel","Envoyez une trame d'abonnement distincte par contrat ; il n'existe pas de forme tableau en bloc."],
      ["Heartbeats + jeton","Maintenez le socket actif avec des heartbeats et renouvelez le jeton avant son expiration."],
    ] },
    { type: "heading",text: "Oubliez le câblage de sockets bruts" },
    { type: "paragraph",html: "La plupart de ceux qui rencontrent <code>Not found: md/subscribeQuote</code> ne poursuivent pas un projet de fournisseur de données, ils veulent simplement qu'une stratégie trade sur Tradovate sans avoir à surveiller deux sockets, deux jetons, des heartbeats et des formats de trame. Si c'est votre cas, il existe un chemin bien plus court que de coder à la main toute la couche WebSocket." },
    { type: "paragraph",html: "Pour les problèmes qui apparaissent souvent juste après celui-ci, ces guides vont plus loin : si vos symboles reviennent inaccessibles plutôt que not-found, il s'agit d'un problème distinct de droits et de format de symbole ; pour obtenir des prix en temps réel en premier lieu, s'abonner aux données de marché en temps réel de Tradovate est le point de départ ; et si votre socket s'autorise bien puis cesse silencieusement de répondre, c'est généralement le jeton d'accès de 90 minutes qui expire en pleine session." },
  ], it: [
    { type: "paragraph",html: "Il Suo flusso di autenticazione ha funzionato, il socket dell'account è attivo e poi invia un <code>md/subscribeQuote</code> per iniziare a ricevere i prezzi live e il server Le restituisce <code>Not found: md/subscribeQuote</code>, spesso storpiato in qualcosa come <code>\"\\\"Not found: md/subscribeQuote\\\"\"</code> con caratteri di escape accumulati. L'endpoint è proprio lì nella documentazione. Allora perché Tradovate si comporta come se non esistesse?" },
    { type: "paragraph",html: "Ecco la versione breve: ha inviato la richiesta al WebSocket sbagliato. Le sottoscrizioni alle quotazioni non risiedono sulla stessa connessione che usa per sincronizzare l'account o inviare ordini. Corregga il socket a cui va la richiesta e l'errore scompare. Vediamo esattamente perché succede, come instradare correttamente e che cosa tende a rompersi dopo, una volta che il frame arriva finalmente a destinazione." },
    { type: "heading",text: "Che cosa significa davvero “Not Found” qui" },
    { type: "paragraph",html: "Lo tratti come un 404 su una chiamata REST. Un 404 dice che il percorso URL non esiste su quel server. Sul WebSocket di Tradovate la logica è identica: ogni frame inviato nomina un endpoint, e se il socket a cui è connesso non serve quell'endpoint, il server risponde <code>Not found</code> restituendo il nome dell'endpoint." },
    { type: "paragraph",html: "Legga con attenzione, perché questo esclude molte cose. Non Le sta dicendo che il simbolo è sbagliato. Non Le sta dicendo che il token è scaduto. Non Le sta dicendo che il JSON è malformato. Le dice una sola cosa: “su questa connessione non esiste una route per <code>md/subscribeQuote</code>”. E c'è esattamente un motivo comune per questo." },
    { type: "heading",text: "La causa: è sul socket dell'account, non sul socket dei dati di mercato" },
    { type: "paragraph",html: "Tradovate gestisce due servizi WebSocket separati, e non sono intercambiabili. Molti configurano il primo, lo autorizzano, vedono i dati di account e ordini scorrere perfettamente e poi presumono che la stessa connessione gestisca tutto. Non è così." },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Il socket account / API</strong> gestisce ordini, posizioni, esecuzioni, sincronizzazione dell'account e il resto dei dati delle entità. È qui che si trovano <code>user/syncRequest</code>, <code>order/placeOrder</code> e <code>account/list</code>. Live è <code>wss://live.tradovateapi.com/v1/websocket</code>; demo è <code>wss://demo.tradovateapi.com/v1/websocket</code>.",
        "<strong class='text-white'>Il socket dei dati di mercato</strong> gestisce prezzi live, quotazioni, il DOM, grafici e istogrammi. È qui che vive ogni endpoint <code>md/</code>, inclusi <code>md/subscribeQuote</code>, <code>md/subscribeDOM</code> e <code>md/getChart</code>. Live è <code>wss://md.tradovateapi.com/v1/websocket</code>; demo è <code>wss://md-demo.tradovateapi.com/v1/websocket</code>.",
      ],
    },
    { type: "paragraph",html: "Invii <code>md/subscribeQuote</code> al socket dell'account e semplicemente non c'è alcuna route corrispondente, quindi torna <code>Not found: md/subscribeQuote</code>. Il socket dell'account non Le suggerirà che sta bussando alla porta sbagliata, segnala soltanto che l'endpoint manca. Ecco la mappa completa degli host per allineare il Suo ambiente:" },
    { type: "table", headers: ["Scopo","Demo / Simulazione","Live"], rows: [
      ["Base REST di autenticazione","https://demo.tradovateapi.com/v1/","https://live.tradovateapi.com/v1/"],
      ["Socket account / API (user/syncRequest, order/placeOrder)","wss://demo.tradovateapi.com/v1/websocket","wss://live.tradovateapi.com/v1/websocket"],
      ["Socket dei dati di mercato (md/subscribeQuote, md/getChart)","wss://md-demo.tradovateapi.com/v1/websocket","wss://md.tradovateapi.com/v1/websocket"],
    ] },
    { type: "heading",text: "La soluzione: aprire e autorizzare un secondo socket per le quotazioni" },
    { type: "paragraph",html: "Non sposta il socket dell'account. <em>Aggiunge</em> un socket dei dati di mercato accanto ad esso. Mantenga la connessione dell'account per ordini e sincronizzazione; apra un nuovo WebSocket verso l'host dei dati di mercato per i prezzi. Ecco la sequenza che elimina l'errore." },
    {
      type: "steps",
      items: [
        { title: "Prenda entrambi i token dalla risposta di autenticazione", html: "Quando si autentica, la risposta di Tradovate contiene più di un token. Accanto al consueto <code>accessToken</code> troverà un <code>mdAccessToken</code> e un <code>expirationTime</code>. Quel secondo token non è decorativo, viene emesso specificamente per il feed dei dati di mercato. Lo conservi." },
        { title: "Apra il WebSocket dei dati di mercato", html: "Si connetta all'host dei dati di mercato corrispondente al Suo ambiente: <code>wss://md-demo.tradovateapi.com/v1/websocket</code> se il token proviene dall'endpoint di autenticazione demo, oppure <code>wss://md.tradovateapi.com/v1/websocket</code> se proviene da quello live. Incrociare un token live con l'host demo (o viceversa) La fa respingere prima ancora che la sottoscrizione conti. Attenda il frame <code>o</code> di apertura del socket prima di inviare qualsiasi cosa." },
        { title: "Autorizzi prima il socket", html: "Questo è il passaggio che molti saltano. Un socket nuovo non risponde a nulla finché non lo autorizza. Il primissimo frame che invia deve essere il frame authorize con il Suo token, usi il <code>mdAccessToken</code> per la connessione dei dati di mercato. I frame di Tradovate sono testo delimitato da a capo, non JSON grezzo: l'endpoint, l'id della richiesta, una riga di query (spesso vuota), poi il corpo. Invii il frame authorize, attenda la risposta che conferma l'autorizzazione del socket e solo allora proceda. Se invia una sottoscrizione prima che questo handshake sia completato, non verrà accolta." },
        { title: "Ora invii md/subscribeQuote", html: "Con il socket aperto e autorizzato, la sottoscrizione ha finalmente una route. La invii come frame della stessa forma, con un corpo JSON che nomina un solo contratto. Può indicare il contratto tramite la stringa del simbolo (come <code>ESU6</code> per l'E-mini S&amp;P di settembre 2026) oppure tramite il suo id numerico di contratto, entrambi funzionano. Il server conferma la richiesta e poi inizia a inviare eventi di quotazione con bid, ask e ultimo prezzo di quel contratto. L'errore <code>Not found</code> scompare perché l'endpoint esiste sulla connessione che sta usando ora." },
      ],
    },
    { type: "quote",html: "<strong class='text-white'>Frame authorize:</strong><br><code>authorize<br>1<br><br>&lt;yourMdAccessToken&gt;</code><br><br><strong class='text-white'>Frame subscribe:</strong><br><code>md/subscribeQuote<br>2<br><br>{\"symbol\":\"ESU6\"}</code>" },
    { type: "heading",text: "Sottoscriva una volta per simbolo, non in blocco" },
    { type: "paragraph",html: "Una trappola rapida che vale la pena nominare: <code>md/subscribeQuote</code> accetta un solo simbolo per chiamata. Non esiste una forma ad array in cui passa una lista e ottiene tutto in una volta. Se vuole seguire ES, NQ e CL insieme, invii tre frame di sottoscrizione separati sullo stesso socket dei dati di mercato, ciascuno con il proprio id di richiesta. Un socket può portare molte sottoscrizioni di quotazioni live contemporaneamente, le registra semplicemente una alla volta. Quando ha finito con un contratto, annulli la sottoscrizione con <code>md/unsubscribeQuote</code> così non riceve un flusso che non legge più." },
    { type: "heading",text: "Che cosa si rompe dopo: il socket è giusto, ma non compaiono prezzi" },
    { type: "paragraph",html: "Una volta scomparso l'errore not-found, la classe di problemi successiva è di natura diversa. La richiesta ora raggiunge il motore dei dati di mercato, quindi qualsiasi errore da qui in poi riguarda <em>che cosa</em> ha richiesto e <em>se ne ha diritto</em>, non una route mancante." },
    { type: "heading",text: "“Symbol is inaccessible”" },
    { type: "paragraph",html: "Se la chiamata di sottoscrizione restituisce una risposta di inaccessibile o simbolo sconosciuto, di solito entrano in gioco due fattori. Primo, il simbolo deve essere un vero contratto front-month completamente qualificato, <code>ESU6</code>, non la sola radice <code>ES</code>, e non un contratto già scaduto e passato al trimestre successivo. Secondo, il Suo account ha bisogno dei permessi per vedere quei dati: la Contract Library più un abbonamento attivo ai dati di mercato dell'exchange. Senza questi, una richiesta perfettamente formata non restituisce nulla di utilizzabile. È un problema distinto con una propria soluzione." },
    { type: "heading",text: "Il socket continua a cadere" },
    { type: "paragraph",html: "Il WebSocket di Tradovate si aspetta un heartbeat periodico. Se si connette, autorizza, sottoscrive e poi resta in silenzio, il server chiude la connessione e le Sue quotazioni si fermano di colpo. Invii un frame heartbeat vuoto all'intervallo indicato da Tradovate (breve, nell'ordine di un paio di secondi) in modo che il socket dei dati di mercato resti aperto per tutto il tempo in cui servono i prezzi. Molte segnalazioni del tipo “ha funzionato per un minuto e poi si è interrotto” risalgono direttamente a un heartbeat mancante." },
    { type: "heading",text: "Il token è scaduto a metà sessione" },
    { type: "paragraph",html: "I token di accesso non durano per sempre. Se il socket dei dati di mercato si è autorizzato correttamente all'inizio della sessione e poi smette di rispondere, il Suo token potrebbe semplicemente essere scaduto. Lo rinnovi prima che scada invece di aspettare che le chiamate falliscano, poi riautorizzi il socket con il nuovo token." },
    { type: "heading",text: "Una rapida checklist per eliminare l'errore" },
    { type: "table", headers: ["Verifica","Che cosa confermare"], rows: [
      ["Socket giusto","md/subscribeQuote va a md.tradovateapi.com (live) o md-demo.tradovateapi.com (demo), mai al socket dell'account."],
      ["Ambiente coerente","Token live → host dati di mercato live; token demo → host demo."],
      ["Autorizzare prima","Invii il frame authorize con il Suo mdAccessToken prima di qualsiasi richiesta md/."],
      ["Simbolo di contratto completo","Usi un simbolo front-month completamente qualificato come ESU6, non la radice ES né un contratto scaduto."],
      ["Un simbolo per chiamata","Invii un frame di sottoscrizione separato per contratto; non esiste una forma ad array in blocco."],
      ["Heartbeat + token","Mantenga attivo il socket con gli heartbeat e rinnovi il token prima che scada."],
    ] },
    { type: "heading",text: "Salti il cablaggio dei socket grezzi" },
    { type: "paragraph",html: "La maggior parte di chi incontra <code>Not found: md/subscribeQuote</code> non sta inseguendo un progetto da fornitore di dati, vuole semplicemente che una strategia operi su Tradovate senza dover accudire due socket, due token, heartbeat e formati di frame. Se è il Suo caso, esiste un percorso molto più breve che programmare a mano l'intero livello WebSocket." },
    { type: "paragraph",html: "Per i problemi che tendono a comparire subito dopo questo, queste guide approfondiscono: se i Suoi simboli risultano inaccessibili anziché not-found, è un problema distinto di permessi e formato del simbolo; per far arrivare prezzi in tempo reale in primo luogo, sottoscrivere i dati di mercato in tempo reale di Tradovate è il punto di partenza; e se il Suo socket si autorizza correttamente e poi smette silenziosamente di rispondere, di solito è il token di accesso da 90 minuti che scade a metà sessione." },
  ] },
  ctaHeading: { en: "Skip the Raw Socket Wiring", de: "Verzichten Sie auf die manuelle Socket-Verdrahtung", es: "Olvídese del cableado de sockets en bruto", fr: "Oubliez le câblage de sockets bruts", it: "Salti il cablaggio dei socket grezzi" },
  ctaText: { en: "Want your TradingView strategy to trade Tradovate without wiring a single WebSocket frame yourself? See how PickMyTrade automates the whole order flow.", de: "Möchten Sie, dass Ihre TradingView-Strategie auf Tradovate handelt, ohne dass Sie selbst einen einzigen WebSocket-Frame verdrahten? Sehen Sie, wie PickMyTrade den gesamten Orderfluss automatisiert.", es: "¿Quiere que su estrategia de TradingView opere en Tradovate sin cablear usted mismo un solo frame de WebSocket? Descubra cómo PickMyTrade automatiza todo el flujo de órdenes.", fr: "Vous voulez que votre stratégie TradingView trade sur Tradovate sans câbler vous-même une seule trame WebSocket ? Découvrez comment PickMyTrade automatise tout le flux d'ordres.", it: "Vuole che la Sua strategia TradingView operi su Tradovate senza cablare personalmente un solo frame WebSocket? Scopra come PickMyTrade automatizza l'intero flusso di ordini." },
  ctaButtonText: { en: "Start Your Free 7-Day Trial", de: "Starten Sie Ihre kostenlose 7-Tage-Testphase", es: "Comience su prueba gratuita de 7 días", fr: "Commencez votre essai gratuit de 7 jours", it: "Inizi la prova gratuita di 7 giorni" },
  ctaUrl: "https://app.pickmytrade.trade/?register=true&utm_source=content&utm_medium=debugging",
  faqHeading: { en: "Frequently Asked Questions", de: "Häufig gestellte Fragen", es: "Preguntas frecuentes", fr: "Questions fréquentes", it: "Domande frequenti" },
  faqs: { en: [
    { q: "Why do I get “Not found: md/subscribeQuote” when the endpoint clearly exists?", a: "Because md/subscribeQuote only exists on Tradovate's market-data WebSocket, not the account socket you use for user/syncRequest and order/placeOrder. Send an md/ request to the account socket and the server has no route for it on that connection, so it echoes back Not found: md/subscribeQuote. Open a second connection to the market-data host and send the subscription there." },
    { q: "What is the correct market-data WebSocket URL?", a: "Live market data uses wss://md.tradovateapi.com/v1/websocket and demo uses wss://md-demo.tradovateapi.com/v1/websocket. Those are separate hosts from the account sockets. Confirm the current hostnames in Tradovate's developer docs before you commit them to code, since they can change." },
    { q: "Do I need a separate token to authorize the market-data socket?", a: "Tradovate's auth response returns two tokens, accessToken and mdAccessToken, plus an expiration time. The mdAccessToken is issued for the market-data feed, so use it to authorize the market-data socket. Each socket needs its own authorize frame first; an unauthorized socket answers nothing." },
    { q: "I fixed the socket but quotes never arrive or I get “Symbol is inaccessible”, why?", a: "That's a different problem. Once the request reaches the market-data engine it needs a valid, fully qualified front-month symbol plus entitlements: the Contract Library and an active exchange market-data subscription. Without those, the symbol comes back inaccessible even with a correct frame. On a prop or evaluation account, the firm usually controls that data." },
    { q: "Can I subscribe to multiple symbols in one call?", a: "No. Each md/subscribeQuote request takes a single symbol. To follow several contracts, send one subscribe request per symbol over the same market-data socket, each with its own request id. Keep the connection alive with heartbeats and one socket can hold many quote subscriptions at once." },
  ], de: [
    { q: "Warum erhalte ich „Not found: md/subscribeQuote“, obwohl der Endpunkt eindeutig existiert?", a: "Weil md/subscribeQuote nur auf dem Marktdaten-WebSocket von Tradovate existiert, nicht auf dem Konto-Socket, den Sie für user/syncRequest und order/placeOrder verwenden. Senden Sie eine md/-Anfrage an den Konto-Socket, hat der Server auf dieser Verbindung keine Route dafür und gibt Not found: md/subscribeQuote zurück. Öffnen Sie eine zweite Verbindung zum Marktdaten-Host und senden Sie das Abonnement dort." },
    { q: "Wie lautet die korrekte URL des Marktdaten-WebSockets?", a: "Live-Marktdaten verwenden wss://md.tradovateapi.com/v1/websocket und die Demo verwendet wss://md-demo.tradovateapi.com/v1/websocket. Das sind eigene Hosts, getrennt von den Konto-Sockets. Bestätigen Sie die aktuellen Hostnamen in der Entwicklerdokumentation von Tradovate, bevor Sie sie fest in Ihren Code übernehmen, da sie sich ändern können." },
    { q: "Brauche ich ein separates Token, um den Marktdaten-Socket zu autorisieren?", a: "Die Auth-Antwort von Tradovate liefert zwei Token, accessToken und mdAccessToken, sowie eine Ablaufzeit. Das mdAccessToken wird für den Marktdaten-Feed ausgestellt, verwenden Sie es also, um den Marktdaten-Socket zu autorisieren. Jeder Socket benötigt zuerst seinen eigenen authorize-Frame; ein nicht autorisierter Socket antwortet auf nichts." },
    { q: "Ich habe den Socket korrigiert, aber es kommen keine Kurse oder ich erhalte „Symbol is inaccessible“, warum?", a: "Das ist ein anderes Problem. Sobald die Anfrage die Marktdaten-Engine erreicht, benötigt sie ein gültiges, vollständig qualifiziertes Front-Month-Symbol sowie Berechtigungen: die Contract Library und ein aktives Börsen-Marktdatenabonnement. Ohne diese wird das Symbol trotz korrektem Frame als nicht zugänglich zurückgegeben. Bei einem Prop- oder Evaluierungskonto kontrolliert in der Regel die Firma diese Daten." },
    { q: "Kann ich mehrere Symbole in einem Aufruf abonnieren?", a: "Nein. Jede md/subscribeQuote-Anfrage nimmt ein einzelnes Symbol entgegen. Um mehrere Kontrakte zu verfolgen, senden Sie pro Symbol eine Abonnement-Anfrage über denselben Marktdaten-Socket, jeweils mit eigener Request-ID. Halten Sie die Verbindung mit Heartbeats aufrecht, dann kann ein Socket viele Kursabonnements gleichzeitig halten." },
  ], es: [
    { q: "¿Por qué recibo “Not found: md/subscribeQuote” si el endpoint claramente existe?", a: "Porque md/subscribeQuote solo existe en el WebSocket de datos de mercado de Tradovate, no en el socket de cuenta que usa para user/syncRequest y order/placeOrder. Si envía una solicitud md/ al socket de cuenta, el servidor no tiene ninguna ruta para ella en esa conexión y devuelve Not found: md/subscribeQuote. Abra una segunda conexión al host de datos de mercado y envíe allí la suscripción." },
    { q: "¿Cuál es la URL correcta del WebSocket de datos de mercado?", a: "Los datos de mercado en vivo usan wss://md.tradovateapi.com/v1/websocket y la demo usa wss://md-demo.tradovateapi.com/v1/websocket. Son hosts distintos de los sockets de cuenta. Confirme los nombres de host actuales en la documentación para desarrolladores de Tradovate antes de fijarlos en su código, ya que pueden cambiar." },
    { q: "¿Necesito un token aparte para autorizar el socket de datos de mercado?", a: "La respuesta de autenticación de Tradovate devuelve dos tokens, accessToken y mdAccessToken, además de un tiempo de expiración. El mdAccessToken se emite para el feed de datos de mercado, así que úselo para autorizar el socket de datos de mercado. Cada socket necesita primero su propio frame authorize; un socket no autorizado no responde a nada." },
    { q: "Arreglé el socket pero las cotizaciones nunca llegan o recibo “Symbol is inaccessible”, ¿por qué?", a: "Es un problema distinto. Una vez que la solicitud llega al motor de datos de mercado, necesita un símbolo de vencimiento más cercano válido y totalmente cualificado, además de los permisos: la Contract Library y una suscripción activa de datos de mercado de la bolsa. Sin ellos, el símbolo se devuelve inaccesible incluso con un frame correcto. En una cuenta prop o de evaluación, normalmente la firma controla esos datos." },
    { q: "¿Puedo suscribirme a varios símbolos en una sola llamada?", a: "No. Cada solicitud md/subscribeQuote admite un único símbolo. Para seguir varios contratos, envíe una solicitud de suscripción por símbolo a través del mismo socket de datos de mercado, cada una con su propio id de solicitud. Mantenga la conexión viva con heartbeats y un solo socket puede sostener muchas suscripciones de cotizaciones a la vez." },
  ], fr: [
    { q: "Pourquoi ai-je « Not found: md/subscribeQuote » alors que l'endpoint existe clairement ?", a: "Parce que md/subscribeQuote n'existe que sur le WebSocket de données de marché de Tradovate, pas sur le socket de compte que vous utilisez pour user/syncRequest et order/placeOrder. Si vous envoyez une requête md/ au socket de compte, le serveur n'a aucune route pour elle sur cette connexion et renvoie Not found: md/subscribeQuote. Ouvrez une seconde connexion vers l'hôte de données de marché et envoyez-y l'abonnement." },
    { q: "Quelle est l'URL correcte du WebSocket de données de marché ?", a: "Les données de marché en réel utilisent wss://md.tradovateapi.com/v1/websocket et la démo utilise wss://md-demo.tradovateapi.com/v1/websocket. Ce sont des hôtes distincts des sockets de compte. Vérifiez les noms d'hôte actuels dans la documentation développeur de Tradovate avant de les figer dans votre code, car ils peuvent changer." },
    { q: "Ai-je besoin d'un jeton distinct pour autoriser le socket de données de marché ?", a: "La réponse d'authentification de Tradovate renvoie deux jetons, accessToken et mdAccessToken, ainsi qu'un délai d'expiration. Le mdAccessToken est émis pour le flux de données de marché ; utilisez-le donc pour autoriser le socket de données de marché. Chaque socket a d'abord besoin de sa propre trame authorize ; un socket non autorisé ne répond à rien." },
    { q: "J'ai corrigé le socket mais les cotations n'arrivent jamais ou j'obtiens « Symbol is inaccessible », pourquoi ?", a: "C'est un autre problème. Une fois que la requête atteint le moteur de données de marché, elle nécessite un symbole de contrat à échéance rapprochée valide et entièrement qualifié, ainsi que des droits d'accès : la Contract Library et un abonnement actif aux données de marché de la bourse. Sans cela, le symbole est renvoyé comme inaccessible même avec une trame correcte. Sur un compte prop ou d'évaluation, c'est généralement la société qui contrôle ces données." },
    { q: "Puis-je m'abonner à plusieurs symboles en un seul appel ?", a: "Non. Chaque requête md/subscribeQuote accepte un seul symbole. Pour suivre plusieurs contrats, envoyez une requête d'abonnement par symbole sur le même socket de données de marché, chacune avec son propre identifiant de requête. Maintenez la connexion active avec des heartbeats et un seul socket peut porter de nombreux abonnements de cotations à la fois." },
  ], it: [
    { q: "Perché ricevo “Not found: md/subscribeQuote” quando l'endpoint esiste chiaramente?", a: "Perché md/subscribeQuote esiste solo sul WebSocket dei dati di mercato di Tradovate, non sul socket dell'account che usa per user/syncRequest e order/placeOrder. Se invia una richiesta md/ al socket dell'account, il server non ha alcuna route per essa su quella connessione e restituisce Not found: md/subscribeQuote. Apra una seconda connessione verso l'host dei dati di mercato e invii lì la sottoscrizione." },
    { q: "Qual è l'URL corretto del WebSocket dei dati di mercato?", a: "I dati di mercato live usano wss://md.tradovateapi.com/v1/websocket e la demo usa wss://md-demo.tradovateapi.com/v1/websocket. Sono host distinti dai socket dell'account. Verifichi i nomi host attuali nella documentazione per sviluppatori di Tradovate prima di inserirli nel codice, poiché possono cambiare." },
    { q: "Ho bisogno di un token separato per autorizzare il socket dei dati di mercato?", a: "La risposta di autenticazione di Tradovate restituisce due token, accessToken e mdAccessToken, più un tempo di scadenza. Il mdAccessToken viene emesso per il feed dei dati di mercato, quindi lo usi per autorizzare il socket dei dati di mercato. Ogni socket ha bisogno prima del proprio frame authorize; un socket non autorizzato non risponde a nulla." },
    { q: "Ho corretto il socket ma le quotazioni non arrivano mai oppure ricevo “Symbol is inaccessible”, perché?", a: "È un problema diverso. Una volta che la richiesta raggiunge il motore dei dati di mercato, richiede un simbolo di front-month valido e completamente qualificato più i relativi permessi: la Contract Library e un abbonamento attivo ai dati di mercato dell'exchange. Senza questi, il simbolo risulta inaccessibile anche con un frame corretto. Su un account prop o di valutazione, di solito è la società a controllare quei dati." },
    { q: "Posso sottoscrivere più simboli in una sola chiamata?", a: "No. Ogni richiesta md/subscribeQuote accetta un solo simbolo. Per seguire più contratti, invii una richiesta di sottoscrizione per simbolo sullo stesso socket dei dati di mercato, ciascuna con il proprio id di richiesta. Mantenga la connessione attiva con gli heartbeat e un solo socket può reggere molte sottoscrizioni di quotazioni contemporaneamente." },
  ] },
  relatedHeading: { en: "Related Guides", de: "Verwandte Anleitungen", es: "Guías relacionadas", fr: "Guides associés", it: "Guide correlate" },
