---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "tradingview-not-entitled-to-access-account";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/debugging/${SLUG}`;

const META_TITLE = "'TradingView Has Not Been Entitled' Tradovate Fix";
const META_DESCRIPTION =
  "TradingView has not been entitled to access your account? Enable the Tradovate add-on tools (or ask your prop firm) to clear the error and connect fast.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Tradovate-Lösung für „TradingView Has Not Been Entitled“", es: "Solución al error «TradingView Has Not Been Entitled» de Tradovate", fr: "Correctif Tradovate pour « TradingView Has Not Been Entitled »", it: "Soluzione Tradovate per «TradingView Has Not Been Entitled»" },
  dek: { en: "You hit Connect in TradingView and get a red banner instead of a live Tradovate account. It's an entitlement message, not a broken login, here's exactly which add-on toggle fixes it.", de: "Sie klicken in TradingView auf Connect und erhalten statt eines Live-Tradovate-Kontos ein rotes Banner. Es ist eine Berechtigungsmeldung, kein defekter Login, hier steht genau, welcher Add-on-Schalter das behebt.", es: "Pulsa Connect en TradingView y, en lugar de una cuenta de Tradovate en vivo, aparece un banner rojo. Es un mensaje de autorización, no un inicio de sesión roto; aquí le indicamos exactamente qué interruptor del add-on lo soluciona.", fr: "Vous cliquez sur Connect dans TradingView et obtenez une bannière rouge au lieu d'un compte Tradovate en direct. C'est un message d'autorisation, pas une connexion cassée : voici exactement quel interrupteur d'add-on le corrige.", it: "Clicca su Connect in TradingView e invece di un conto Tradovate live compare un banner rosso. È un messaggio di autorizzazione, non un login rotto: ecco esattamente quale interruttore dell'add-on lo risolve." },
  readTime: { en: "6 min read", de: "6 Min. Lesezeit", es: "Lectura de 6 min", fr: "Lecture : 6 min", it: "Lettura di 6 min" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "You line up a clean setup on ES or NQ, hit Connect in TradingView, and instead of a live Tradovate account you get a red banner: <strong class='text-white'>&ldquo;Tradingview has not been entitled to access your account.&rdquo;</strong> No orders route. Your chart-trading buttons stay greyed out. And the market keeps moving without you. It's one of the most common Tradovate connection errors going around, and here's the good news: it almost never means something is broken. It means a single add-on toggle hasn't been switched on yet. Below, I'll break down exactly what the entitlement error means, every reason it shows up, and how to clear it in a few minutes so your TradingView alerts reach Tradovate instead of getting stuck at the door." },
    {
      type: "checklist",
      heading: "Quick Checklist for the Entitlement Error",
      items: [
        "<strong class='text-white'>Add-on not enabled</strong>, turn on the Tradovate TradingView add-on tools inside Application Settings, then log out and back in.",
        "<strong class='text-white'>Prop / evaluation account</strong>, the add-on subscription is controlled by your firm. Ask them to enable the TradingView add-on for your account.",
        "<strong class='text-white'>Activation not yet propagated</strong>, enabling the add-on isn't always instant. Give it a few minutes (sometimes a few hours) and re-log.",
        "<strong class='text-white'>Wrong environment</strong>, make sure you're connecting to the correct Demo vs Live tab that matches your account.",
        "<strong class='text-white'>Stale TradingView session</strong>, disconnect the Tradovate broker in TradingView, refresh, and reconnect with fresh credentials.",
        "<strong class='text-white'>Account not tradable</strong>, an expired, disabled, or unfunded account can also refuse the entitlement handshake. Confirm the account is active first.",
      ],
    },
    { type: "heading", text: "What &ldquo;TradingView Has Not Been Entitled to Access Your Account&rdquo; Means" },
    { type: "paragraph", html: "The wording sounds alarming, but this is an <strong class='text-white'>entitlement (permission) message, not a login failure</strong>. Your Tradovate username and password are almost always fine. What Tradovate is telling TradingView is simple: <em>&ldquo;This account hasn't granted the TradingView add-on the right to trade on its behalf.&rdquo;</em> Tradovate treats third-party front-ends like TradingView as an optional integration that each account has to authorize explicitly through its <strong class='text-white'>Add-on tools</strong>. Until that authorization exists, Tradovate refuses the connection and TradingView shows you the &ldquo;not been entitled&rdquo; banner." },
    { type: "paragraph", html: "There are two ways that authorization gets granted. On a <strong class='text-white'>personal Tradovate account</strong>, you enable the TradingView add-on yourself in Application Settings. On a <strong class='text-white'>prop-firm or evaluation account</strong>, the firm provisions the add-on entitlement (Apex, Elite Trader Funding, Topstep-style evaluations, and the like), so even a perfect login fails until the firm flips it on for your account." },
    { type: "paragraph", html: "So the fix isn't to reset your password or reinstall anything. It's to make sure the TradingView add-on is enabled on the account you're connecting, wait for that entitlement to propagate, and then reconnect. Everything below walks through both paths." },
    { type: "heading", text: "Top Causes of the Entitlement Error" },
    { type: "heading", text: "1. The TradingView add-on is switched off in Tradovate" },
    { type: "paragraph", html: "This is the number-one cause. Tradovate ships the TradingView integration as an add-on that's <strong class='text-white'>off by default</strong>. If you've never opened the Add-on tools screen and enabled it, TradingView has nothing to connect to, and the entitlement handshake fails on the spot." },
    { type: "heading", text: "2. It's a prop-firm or evaluation account you can't self-enable" },
    { type: "paragraph", html: "Prop and evaluation accounts are owned by the funding firm, not by you. On these, the TradingView add-on subscription is enabled at the firm level. If your firm hasn't turned it on, or hasn't finished provisioning your account after purchase, you'll keep seeing the entitlement error no matter how many times you re-enter your credentials. Only the firm can enable the add-on on that account." },
    { type: "heading", text: "3. The add-on was enabled but hasn't propagated yet" },
    { type: "paragraph", html: "Enabling the add-on isn't always instant. After you toggle it on (or after your firm enables it), the entitlement can take anywhere from a couple of minutes to a few hours to fully activate across Tradovate's systems. Try to reconnect in the same second you enable it and you may still hit the error briefly." },
    { type: "heading", text: "4. You never logged out and back in after enabling it" },
    { type: "paragraph", html: "The entitlement is read when your Tradovate session starts. Enable the add-on while you're already logged in and the running session won't pick up the new permission. A fresh log out and log in is what actually loads the entitlement." },
    { type: "heading", text: "5. A stale TradingView broker session or wrong environment" },
    { type: "paragraph", html: "Sometimes the add-on is enabled correctly, but TradingView is still holding a stale broker session, or you're trying to connect to the wrong Demo/Live tab for the account you enabled. Disconnecting and reconnecting to the correct environment clears it." },
    { type: "heading", text: "How to Fix the Entitlement Error: Step-by-Step" },
    { type: "heading", text: "Fixing Cause 1 & 3: Enable the Tradovate add-on tools" },
    { type: "paragraph", html: "Do this on the account you're trying to trade (personal Tradovate accounts)." },
    {
      type: "steps",
      items: [
        { title: "Log in to the web platform", html: "Open the Tradovate web platform at <strong class='text-white'>trader.tradovate.com</strong> and log in." },
        { title: "Open Application Settings", html: "Open <strong class='text-white'>Application Settings</strong>, the menu in the top-right corner of the platform. On some builds it's labeled simply <strong class='text-white'>Settings</strong> or sits behind a hamburger (three-line) icon." },
        { title: "Select Add-on", html: "Select <strong class='text-white'>Add-on</strong> (also shown as <strong class='text-white'>Add-Ons</strong> or <strong class='text-white'>Add-on Tools</strong>) from the settings menu." },
        { title: "Activate the TradingView add-on", html: "Find the <strong class='text-white'>TradingView</strong> add-on and click <strong class='text-white'>Activate</strong> (or toggle the Add-on tools on). Confirm if prompted." },
        { title: "Wait for confirmation", html: "Wait for the confirmation that the add-on is active. Give it a few minutes to propagate. If TradingView is free on your plan, full activation can occasionally take a few hours." },
      ],
    },
    { type: "heading", text: "Fixing Cause 4: Log out and log back in" },
    { type: "paragraph", html: "The entitlement only loads on a fresh session:" },
    {
      type: "steps",
      items: [
        { title: "Log out completely", html: "<strong class='text-white'>Log out</strong> of the Tradovate web platform completely." },
        { title: "Log back in", html: "Log back in to <strong class='text-white'>trader.tradovate.com</strong>." },
        { title: "Confirm the account is active", html: "Confirm the account you want is active and tradable before you head back to TradingView." },
      ],
    },
    { type: "heading", text: "Fixing Cause 5: Reconnect from TradingView" },
    { type: "paragraph", html: "Once the add-on is active and you've re-logged into Tradovate:" },
    {
      type: "steps",
      items: [
        { title: "Open the Trading Panel", html: "In TradingView, open the <strong class='text-white'>Trading Panel</strong> at the bottom of the screen." },
        { title: "Select Tradovate", html: "Select <strong class='text-white'>Tradovate</strong> as the broker (disconnect any existing stale Tradovate session first if one is shown)." },
        { title: "Choose the correct environment", html: "Choose the correct environment tab, <strong class='text-white'>Demo</strong> for evaluation/simulated, <strong class='text-white'>Live</strong> for a funded/live account, matching the account you enabled." },
        { title: "Enter credentials and connect", html: "Enter your Tradovate credentials and click <strong class='text-white'>Connect</strong>." },
      ],
    },
    { type: "heading", text: "Fixing Cause 2: Ask your prop firm to enable the add-on" },
    { type: "paragraph", html: "If you're on a prop-firm or evaluation account and can't find or toggle the add-on yourself, the entitlement lives with the firm. Contact your funding firm's support and ask them to <strong class='text-white'>verify that the TradingView add-on subscription is correctly enabled for your account</strong>. Firms such as Apex Trader Funding and Elite Trader Funding handle this on their side. Once they confirm it's enabled, log out and back in and reconnect from TradingView. Provisioning after a new evaluation purchase can also take time, so if you just bought the account, give it a little while before assuming something's wrong." },
    { type: "heading", text: "Troubleshooting Table" },
    {
      type: "table",
      headers: ["Error / Symptom", "Meaning", "Fix"],
      rows: [
        ["&ldquo;Tradingview has not been entitled to access your account&rdquo;", "The TradingView add-on is not enabled on the account", "Enable Add-on tools in Tradovate Application Settings, then re-log"],
        ["Error persists right after enabling the add-on", "Entitlement hasn't propagated yet", "Wait a few minutes to a few hours, then log out and back in"],
        ["Error on a prop / evaluation account", "Firm-level add-on subscription not enabled", "Ask your prop firm to enable the TradingView add-on for your account"],
        ["Add-on enabled but still failing", "Session was started before the entitlement loaded", "Fully log out of Tradovate and log back in"],
        ["Connects but wrong account / no orders route", "Connected to the wrong Demo vs Live environment", "Disconnect in TradingView and reconnect on the correct tab"],
        ["Add-on toggle missing entirely", "Account is firm-owned or not yet provisioned", "Contact the firm; confirm the account is active and tradable"],
      ],
    },
    { type: "heading", text: "Prevent This with PickMyTrade" },
    { type: "paragraph", html: "The entitlement error is really about permissions and session state, exactly the kind of friction automation should absorb for you. PickMyTrade links your TradingView alerts straight to Tradovate so your strategy keeps routing even when the manual TradingView broker connection gets fussy." },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Entitlement & connection awareness</strong>, respects your account's data-agreement and add-on state so orders go through a healthy, authorized path.",
        "<strong class='text-white'>Demo / Live environment matching</strong>, routes to the correct account environment automatically, so you're not silently connected to the wrong tab.",
        "<strong class='text-white'>Rate-limit-safe routing</strong>, spaces out order flow so a burst of alerts never bounces off Tradovate's limits.",
        "<strong class='text-white'>Multi-account sync</strong>, mirrors the same alert across every connected account, including prop evaluations, in one shot.",
      ],
    },
  ], de: [
    { type: "paragraph",html: "Sie richten ein sauberes Setup auf ES oder NQ ein, klicken in TradingView auf Connect, und statt eines Live-Tradovate-Kontos erscheint ein rotes Banner: <strong class='text-white'>&ldquo;Tradingview has not been entitled to access your account.&rdquo;</strong> Keine Orders werden geroutet. Ihre Chart-Handelsbuttons bleiben ausgegraut. Und der Markt läuft ohne Sie weiter. Es ist einer der häufigsten Tradovate-Verbindungsfehler überhaupt, und die gute Nachricht: Er bedeutet fast nie, dass etwas kaputt ist. Es bedeutet, dass ein einzelner Add-on-Schalter noch nicht umgelegt wurde. Im Folgenden erkläre ich genau, was der Entitlement-Fehler bedeutet, aus welchen Gründen er auftritt und wie Sie ihn in wenigen Minuten beseitigen, damit Ihre TradingView-Alerts Tradovate erreichen, statt vor der Tür hängen zu bleiben." },
    {
      type: "checklist",
      heading: "Kurze Checkliste zum Entitlement-Fehler",
      items: [
        "<strong class='text-white'>Add-on nicht aktiviert</strong>, schalten Sie die Tradovate-TradingView-Add-on-Tools in den Application Settings ein und melden Sie sich dann ab und wieder an.",
        "<strong class='text-white'>Prop-/Evaluierungskonto</strong>, das Add-on-Abonnement wird von Ihrer Firma gesteuert. Bitten Sie sie, das TradingView-Add-on für Ihr Konto zu aktivieren.",
        "<strong class='text-white'>Aktivierung noch nicht übernommen</strong>, das Aktivieren des Add-ons ist nicht immer sofort wirksam. Geben Sie ihm ein paar Minuten (manchmal ein paar Stunden) und melden Sie sich neu an.",
        "<strong class='text-white'>Falsche Umgebung</strong>, stellen Sie sicher, dass Sie sich mit dem richtigen Demo- bzw. Live-Tab verbinden, der zu Ihrem Konto passt.",
        "<strong class='text-white'>Veraltete TradingView-Sitzung</strong>, trennen Sie den Tradovate-Broker in TradingView, aktualisieren Sie die Seite und verbinden Sie sich mit frischen Zugangsdaten erneut.",
        "<strong class='text-white'>Konto nicht handelbar</strong>, auch ein abgelaufenes, deaktiviertes oder nicht finanziertes Konto kann den Entitlement-Handshake verweigern. Bestätigen Sie zuerst, dass das Konto aktiv ist.",
      ],
    },
    { type: "heading",text: "Was &ldquo;TradingView has not been entitled to access your account&rdquo; bedeutet" },
    { type: "paragraph",html: "Der Wortlaut klingt alarmierend, doch es handelt sich um eine <strong class='text-white'>Entitlement-(Berechtigungs-)Meldung, nicht um einen Login-Fehler</strong>. Ihr Tradovate-Benutzername und Ihr Passwort sind fast immer in Ordnung. Tradovate teilt TradingView schlicht mit: <em>&ldquo;Dieses Konto hat dem TradingView-Add-on nicht das Recht erteilt, in seinem Namen zu handeln.&rdquo;</em> Tradovate behandelt Drittanbieter-Oberflächen wie TradingView als optionale Integration, die jedes Konto über seine <strong class='text-white'>Add-on tools</strong> ausdrücklich autorisieren muss. Solange diese Autorisierung fehlt, verweigert Tradovate die Verbindung, und TradingView zeigt Ihnen das Banner &ldquo;not been entitled&rdquo;." },
    { type: "paragraph",html: "Es gibt zwei Wege, wie diese Autorisierung erteilt wird. Bei einem <strong class='text-white'>persönlichen Tradovate-Konto</strong> aktivieren Sie das TradingView-Add-on selbst in den Application Settings. Bei einem <strong class='text-white'>Prop-Firm- oder Evaluierungskonto</strong> stellt die Firma die Add-on-Berechtigung bereit (Apex, Elite Trader Funding, Evaluierungen im Topstep-Stil und ähnliche), sodass selbst ein einwandfreier Login scheitert, bis die Firma sie für Ihr Konto einschaltet." },
    { type: "paragraph",html: "Die Lösung besteht also nicht darin, Ihr Passwort zurückzusetzen oder etwas neu zu installieren. Sie müssen sicherstellen, dass das TradingView-Add-on auf dem Konto aktiviert ist, mit dem Sie sich verbinden, abwarten, bis die Berechtigung übernommen wurde, und sich dann erneut verbinden. Alles Weitere führt durch beide Wege." },
    { type: "heading",text: "Die häufigsten Ursachen für den Entitlement-Fehler" },
    { type: "heading",text: "1. Das TradingView-Add-on ist in Tradovate ausgeschaltet" },
    { type: "paragraph",html: "Das ist die Ursache Nummer eins. Tradovate liefert die TradingView-Integration als Add-on, das <strong class='text-white'>standardmäßig ausgeschaltet</strong> ist. Wenn Sie den Bildschirm Add-on tools nie geöffnet und das Add-on aktiviert haben, hat TradingView nichts, womit es sich verbinden könnte, und der Entitlement-Handshake scheitert sofort." },
    { type: "heading",text: "2. Es ist ein Prop-Firm- oder Evaluierungskonto, das Sie nicht selbst aktivieren können" },
    { type: "paragraph",html: "Prop- und Evaluierungskonten gehören der finanzierenden Firma, nicht Ihnen. Hier wird das TradingView-Add-on-Abonnement auf Firmenebene aktiviert. Hat Ihre Firma es nicht eingeschaltet oder Ihr Konto nach dem Kauf noch nicht fertig bereitgestellt, sehen Sie den Entitlement-Fehler weiter, egal wie oft Sie Ihre Zugangsdaten erneut eingeben. Nur die Firma kann das Add-on für dieses Konto aktivieren." },
    { type: "heading",text: "3. Das Add-on wurde aktiviert, aber noch nicht übernommen" },
    { type: "paragraph",html: "Das Aktivieren des Add-ons ist nicht immer sofort wirksam. Nachdem Sie es eingeschaltet haben (oder Ihre Firma es aktiviert hat), kann es von einigen Minuten bis zu einigen Stunden dauern, bis die Berechtigung in den Systemen von Tradovate vollständig aktiv ist. Verbinden Sie sich in derselben Sekunde, in der Sie es aktivieren, kann der Fehler kurzzeitig weiterhin auftreten." },
    { type: "heading",text: "4. Sie haben sich nach dem Aktivieren nicht ab- und wieder angemeldet" },
    { type: "paragraph",html: "Die Berechtigung wird gelesen, wenn Ihre Tradovate-Sitzung startet. Aktivieren Sie das Add-on, während Sie bereits eingeloggt sind, übernimmt die laufende Sitzung die neue Berechtigung nicht. Erst ein frisches Ab- und Anmelden lädt die Berechtigung tatsächlich." },
    { type: "heading",text: "5. Eine veraltete TradingView-Broker-Sitzung oder die falsche Umgebung" },
    { type: "paragraph",html: "Manchmal ist das Add-on korrekt aktiviert, aber TradingView hält noch eine veraltete Broker-Sitzung, oder Sie versuchen, sich mit dem falschen Demo-/Live-Tab für das aktivierte Konto zu verbinden. Trennen und erneutes Verbinden mit der richtigen Umgebung behebt das." },
    { type: "heading",text: "So beheben Sie den Entitlement-Fehler: Schritt für Schritt" },
    { type: "heading",text: "Ursache 1 & 3 beheben: Tradovate-Add-on-Tools aktivieren" },
    { type: "paragraph",html: "Führen Sie dies auf dem Konto aus, das Sie handeln möchten (persönliche Tradovate-Konten)." },
    {
      type: "steps",
      items: [
        { title: "Bei der Web-Plattform anmelden", html: "Öffnen Sie die Tradovate-Web-Plattform unter <strong class='text-white'>trader.tradovate.com</strong> und melden Sie sich an." },
        { title: "Application Settings öffnen", html: "Öffnen Sie <strong class='text-white'>Application Settings</strong>, das Menü in der oberen rechten Ecke der Plattform. In manchen Versionen heißt es einfach <strong class='text-white'>Settings</strong> oder liegt hinter einem Hamburger-Symbol (drei Striche)." },
        { title: "Add-on auswählen", html: "Wählen Sie im Einstellungsmenü <strong class='text-white'>Add-on</strong> (auch als <strong class='text-white'>Add-Ons</strong> oder <strong class='text-white'>Add-on Tools</strong> angezeigt)." },
        { title: "TradingView-Add-on aktivieren", html: "Suchen Sie das Add-on <strong class='text-white'>TradingView</strong> und klicken Sie auf <strong class='text-white'>Activate</strong> (oder schalten Sie die Add-on tools ein). Bestätigen Sie, falls Sie dazu aufgefordert werden." },
        { title: "Auf die Bestätigung warten", html: "Warten Sie auf die Bestätigung, dass das Add-on aktiv ist. Geben Sie ihm ein paar Minuten zur Übernahme. Ist TradingView in Ihrem Tarif kostenlos, kann die vollständige Aktivierung gelegentlich einige Stunden dauern." },
      ],
    },
    { type: "heading",text: "Ursache 4 beheben: Ab- und wieder anmelden" },
    { type: "paragraph",html: "Die Berechtigung wird nur in einer frischen Sitzung geladen:" },
    {
      type: "steps",
      items: [
        { title: "Vollständig abmelden", html: "<strong class='text-white'>Melden Sie sich</strong> von der Tradovate-Web-Plattform vollständig ab." },
        { title: "Wieder anmelden", html: "Melden Sie sich wieder bei <strong class='text-white'>trader.tradovate.com</strong> an." },
        { title: "Bestätigen, dass das Konto aktiv ist", html: "Bestätigen Sie, dass das gewünschte Konto aktiv und handelbar ist, bevor Sie zu TradingView zurückkehren." },
      ],
    },
    { type: "heading",text: "Ursache 5 beheben: Von TradingView aus neu verbinden" },
    { type: "paragraph",html: "Sobald das Add-on aktiv ist und Sie sich bei Tradovate neu angemeldet haben:" },
    {
      type: "steps",
      items: [
        { title: "Trading Panel öffnen", html: "Öffnen Sie in TradingView das <strong class='text-white'>Trading Panel</strong> am unteren Bildschirmrand." },
        { title: "Tradovate auswählen", html: "Wählen Sie <strong class='text-white'>Tradovate</strong> als Broker (trennen Sie zuvor eine eventuell angezeigte veraltete Tradovate-Sitzung)." },
        { title: "Richtige Umgebung wählen", html: "Wählen Sie den richtigen Umgebungs-Tab, <strong class='text-white'>Demo</strong> für Evaluierung/Simulation, <strong class='text-white'>Live</strong> für ein finanziertes/Live-Konto, passend zu dem Konto, das Sie aktiviert haben." },
        { title: "Zugangsdaten eingeben und verbinden", html: "Geben Sie Ihre Tradovate-Zugangsdaten ein und klicken Sie auf <strong class='text-white'>Connect</strong>." },
      ],
    },
    { type: "heading",text: "Ursache 2 beheben: Ihre Prop Firm bitten, das Add-on zu aktivieren" },
    { type: "paragraph",html: "Wenn Sie ein Prop-Firm- oder Evaluierungskonto nutzen und das Add-on nicht selbst finden oder umschalten können, liegt die Berechtigung bei der Firma. Wenden Sie sich an den Support Ihrer finanzierenden Firma und bitten Sie sie, <strong class='text-white'>zu prüfen, ob das TradingView-Add-on-Abonnement für Ihr Konto korrekt aktiviert ist</strong>. Firmen wie Apex Trader Funding und Elite Trader Funding regeln das auf ihrer Seite. Sobald sie bestätigen, dass es aktiviert ist, melden Sie sich ab und wieder an und verbinden sich erneut von TradingView aus. Auch die Bereitstellung nach dem Kauf einer neuen Evaluierung kann Zeit brauchen. Haben Sie das Konto gerade erst gekauft, geben Sie ihm etwas Zeit, bevor Sie annehmen, es stimme etwas nicht." },
    { type: "heading",text: "Tabelle zur Fehlerbehebung" },
    { type: "table", headers: ["Fehler / Symptom","Bedeutung","Lösung"], rows: [
      ["&ldquo;Tradingview has not been entitled to access your account&rdquo;","Das TradingView-Add-on ist auf dem Konto nicht aktiviert","Add-on tools in den Tradovate Application Settings aktivieren, dann neu anmelden"],
      ["Fehler besteht direkt nach dem Aktivieren des Add-ons weiter","Berechtigung wurde noch nicht übernommen","Einige Minuten bis einige Stunden warten, dann ab- und wieder anmelden"],
      ["Fehler bei einem Prop-/Evaluierungskonto","Add-on-Abonnement auf Firmenebene nicht aktiviert","Ihre Prop Firm bitten, das TradingView-Add-on für Ihr Konto zu aktivieren"],
      ["Add-on aktiviert, schlägt aber weiterhin fehl","Sitzung wurde gestartet, bevor die Berechtigung geladen war","Bei Tradovate vollständig abmelden und wieder anmelden"],
      ["Verbindung steht, aber falsches Konto / keine Orders werden geroutet","Mit der falschen Demo- bzw. Live-Umgebung verbunden","In TradingView trennen und auf dem richtigen Tab neu verbinden"],
      ["Add-on-Schalter fehlt komplett","Konto gehört der Firma oder ist noch nicht bereitgestellt","Firma kontaktieren; bestätigen, dass das Konto aktiv und handelbar ist"],
    ] },
    { type: "heading",text: "Vermeiden Sie das mit PickMyTrade" },
    { type: "paragraph",html: "Beim Entitlement-Fehler geht es im Kern um Berechtigungen und Sitzungsstatus, genau die Art von Reibung, die Automatisierung für Sie auffangen sollte. PickMyTrade verbindet Ihre TradingView-Alerts direkt mit Tradovate, sodass Ihre Strategie weiter routet, auch wenn die manuelle TradingView-Broker-Verbindung zickt." },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Bewusstsein für Entitlement & Verbindung</strong>, respektiert die Datenvereinbarung und den Add-on-Status Ihres Kontos, damit Orders über einen gesunden, autorisierten Pfad laufen.",
        "<strong class='text-white'>Abgleich von Demo-/Live-Umgebung</strong>, routet automatisch in die richtige Kontoumgebung, sodass Sie nicht unbemerkt mit dem falschen Tab verbunden sind.",
        "<strong class='text-white'>Ratenlimit-sicheres Routing</strong>, taktet den Orderfluss, sodass ein Schwall von Alerts nie an Tradovates Limits abprallt.",
        "<strong class='text-white'>Multi-Account-Synchronisierung</strong>, spiegelt denselben Alert in einem Zug auf alle verbundenen Konten, einschließlich Prop-Evaluierungen.",
      ],
    },
  ], es: [
    { type: "paragraph",html: "Prepara una configuración limpia en ES o NQ, pulsa Connect en TradingView y, en lugar de una cuenta de Tradovate en vivo, aparece un banner rojo: <strong class='text-white'>&ldquo;Tradingview has not been entitled to access your account.&rdquo;</strong> No se enruta ninguna orden. Los botones de trading del gráfico siguen en gris. Y el mercado sigue moviéndose sin usted. Es uno de los errores de conexión de Tradovate más comunes, y la buena noticia: casi nunca significa que algo esté roto. Significa que un único interruptor del add-on aún no se ha activado. A continuación detallo exactamente qué significa el error de autorización, todas las razones por las que aparece y cómo eliminarlo en unos minutos para que sus alertas de TradingView lleguen a Tradovate en lugar de quedarse en la puerta." },
    {
      type: "checklist",
      heading: "Lista rápida para el error de autorización",
      items: [
        "<strong class='text-white'>Add-on no habilitado</strong>, active las herramientas del add-on de TradingView de Tradovate en Application Settings y luego cierre sesión y vuelva a iniciarla.",
        "<strong class='text-white'>Cuenta prop / de evaluación</strong>, la suscripción al add-on la controla su firma. Pídale que habilite el add-on de TradingView para su cuenta.",
        "<strong class='text-white'>Activación aún no propagada</strong>, habilitar el add-on no siempre es instantáneo. Concédale unos minutos (a veces unas horas) y vuelva a iniciar sesión.",
        "<strong class='text-white'>Entorno equivocado</strong>, asegúrese de conectarse a la pestaña Demo o Live correcta que corresponda a su cuenta.",
        "<strong class='text-white'>Sesión de TradingView obsoleta</strong>, desconecte el bróker Tradovate en TradingView, actualice y vuelva a conectarse con credenciales nuevas.",
        "<strong class='text-white'>Cuenta no operable</strong>, una cuenta vencida, deshabilitada o sin fondos también puede rechazar el handshake de autorización. Confirme primero que la cuenta está activa.",
      ],
    },
    { type: "heading",text: "Qué significa &ldquo;TradingView has not been entitled to access your account&rdquo;" },
    { type: "paragraph",html: "La redacción suena alarmante, pero es un <strong class='text-white'>mensaje de autorización (permisos), no un fallo de inicio de sesión</strong>. Su usuario y contraseña de Tradovate casi siempre están bien. Lo que Tradovate le dice a TradingView es sencillo: <em>&ldquo;Esta cuenta no ha concedido al add-on de TradingView el derecho a operar en su nombre.&rdquo;</em> Tradovate trata las interfaces de terceros como TradingView como una integración opcional que cada cuenta debe autorizar explícitamente mediante sus <strong class='text-white'>Add-on tools</strong>. Hasta que exista esa autorización, Tradovate rechaza la conexión y TradingView le muestra el banner &ldquo;not been entitled&rdquo;." },
    { type: "paragraph",html: "Hay dos formas de conceder esa autorización. En una <strong class='text-white'>cuenta personal de Tradovate</strong>, usted mismo habilita el add-on de TradingView en Application Settings. En una <strong class='text-white'>cuenta de prop firm o de evaluación</strong>, la firma aprovisiona la autorización del add-on (Apex, Elite Trader Funding, evaluaciones al estilo Topstep y similares), por lo que incluso un inicio de sesión perfecto falla hasta que la firma lo activa para su cuenta." },
    { type: "paragraph",html: "Así que la solución no es restablecer su contraseña ni reinstalar nada. Es asegurarse de que el add-on de TradingView esté habilitado en la cuenta a la que se conecta, esperar a que esa autorización se propague y volver a conectarse. Todo lo que sigue recorre ambos caminos." },
    { type: "heading",text: "Principales causas del error de autorización" },
    { type: "heading",text: "1. El add-on de TradingView está desactivado en Tradovate" },
    { type: "paragraph",html: "Esta es la causa número uno. Tradovate ofrece la integración con TradingView como un add-on que está <strong class='text-white'>desactivado por defecto</strong>. Si nunca ha abierto la pantalla de Add-on tools y lo ha habilitado, TradingView no tiene nada a lo que conectarse y el handshake de autorización falla de inmediato." },
    { type: "heading",text: "2. Es una cuenta de prop firm o de evaluación que no puede habilitar usted mismo" },
    { type: "paragraph",html: "Las cuentas prop y de evaluación pertenecen a la firma de financiación, no a usted. En ellas, la suscripción al add-on de TradingView se habilita a nivel de firma. Si su firma no lo ha activado, o no ha terminado de aprovisionar su cuenta tras la compra, seguirá viendo el error de autorización por muchas veces que vuelva a introducir sus credenciales. Solo la firma puede habilitar el add-on en esa cuenta." },
    { type: "heading",text: "3. El add-on se habilitó pero aún no se ha propagado" },
    { type: "paragraph",html: "Habilitar el add-on no siempre es instantáneo. Tras activarlo (o tras activarlo su firma), la autorización puede tardar desde un par de minutos hasta unas horas en activarse por completo en los sistemas de Tradovate. Si intenta reconectar en el mismo segundo en que lo habilita, aún puede topar brevemente con el error." },
    { type: "heading",text: "4. No cerró sesión y volvió a entrar tras habilitarlo" },
    { type: "paragraph",html: "La autorización se lee cuando se inicia su sesión de Tradovate. Si habilita el add-on estando ya conectado, la sesión en curso no recogerá el nuevo permiso. Un cierre y reinicio de sesión nuevo es lo que realmente carga la autorización." },
    { type: "heading",text: "5. Una sesión de bróker de TradingView obsoleta o un entorno equivocado" },
    { type: "paragraph",html: "A veces el add-on está correctamente habilitado, pero TradingView sigue reteniendo una sesión de bróker obsoleta, o intenta conectarse a la pestaña Demo/Live equivocada para la cuenta que habilitó. Desconectar y volver a conectar al entorno correcto lo resuelve." },
    { type: "heading",text: "Cómo corregir el error de autorización: paso a paso" },
    { type: "heading",text: "Solución de las causas 1 y 3: habilite las Add-on tools de Tradovate" },
    { type: "paragraph",html: "Hágalo en la cuenta en la que intenta operar (cuentas personales de Tradovate)." },
    {
      type: "steps",
      items: [
        { title: "Inicie sesión en la plataforma web", html: "Abra la plataforma web de Tradovate en <strong class='text-white'>trader.tradovate.com</strong> e inicie sesión." },
        { title: "Abra Application Settings", html: "Abra <strong class='text-white'>Application Settings</strong>, el menú de la esquina superior derecha de la plataforma. En algunas versiones se llama simplemente <strong class='text-white'>Settings</strong> o está tras un icono de hamburguesa (tres líneas)." },
        { title: "Seleccione Add-on", html: "Seleccione <strong class='text-white'>Add-on</strong> (también mostrado como <strong class='text-white'>Add-Ons</strong> o <strong class='text-white'>Add-on Tools</strong>) en el menú de ajustes." },
        { title: "Active el add-on de TradingView", html: "Busque el add-on <strong class='text-white'>TradingView</strong> y haga clic en <strong class='text-white'>Activate</strong> (o active las Add-on tools). Confirme si se le solicita." },
        { title: "Espere la confirmación", html: "Espere a la confirmación de que el add-on está activo. Concédale unos minutos para propagarse. Si TradingView es gratuito en su plan, la activación completa a veces puede tardar unas horas." },
      ],
    },
    { type: "heading",text: "Solución de la causa 4: cierre sesión y vuelva a iniciarla" },
    { type: "paragraph",html: "La autorización solo se carga en una sesión nueva:" },
    {
      type: "steps",
      items: [
        { title: "Cierre sesión por completo", html: "<strong class='text-white'>Cierre sesión</strong> por completo en la plataforma web de Tradovate." },
        { title: "Vuelva a iniciar sesión", html: "Vuelva a iniciar sesión en <strong class='text-white'>trader.tradovate.com</strong>." },
        { title: "Confirme que la cuenta está activa", html: "Confirme que la cuenta que desea está activa y es operable antes de volver a TradingView." },
      ],
    },
    { type: "heading",text: "Solución de la causa 5: reconecte desde TradingView" },
    { type: "paragraph",html: "Una vez que el add-on esté activo y haya vuelto a iniciar sesión en Tradovate:" },
    {
      type: "steps",
      items: [
        { title: "Abra el Trading Panel", html: "En TradingView, abra el <strong class='text-white'>Trading Panel</strong> en la parte inferior de la pantalla." },
        { title: "Seleccione Tradovate", html: "Seleccione <strong class='text-white'>Tradovate</strong> como bróker (desconecte antes cualquier sesión obsoleta de Tradovate si se muestra alguna)." },
        { title: "Elija el entorno correcto", html: "Elija la pestaña del entorno correcto, <strong class='text-white'>Demo</strong> para evaluación/simulada, <strong class='text-white'>Live</strong> para una cuenta financiada/real, que coincida con la cuenta que habilitó." },
        { title: "Introduzca las credenciales y conecte", html: "Introduzca sus credenciales de Tradovate y haga clic en <strong class='text-white'>Connect</strong>." },
      ],
    },
    { type: "heading",text: "Solución de la causa 2: pida a su prop firm que habilite el add-on" },
    { type: "paragraph",html: "Si está en una cuenta de prop firm o de evaluación y no puede encontrar ni activar el add-on usted mismo, la autorización depende de la firma. Contacte con el soporte de su firma de financiación y pídales que <strong class='text-white'>verifiquen que la suscripción al add-on de TradingView está correctamente habilitada para su cuenta</strong>. Firmas como Apex Trader Funding y Elite Trader Funding lo gestionan por su parte. Cuando confirmen que está habilitado, cierre sesión, vuelva a iniciarla y reconecte desde TradingView. El aprovisionamiento tras la compra de una nueva evaluación también puede tardar, así que si acaba de comprar la cuenta, déle un poco de tiempo antes de asumir que algo va mal." },
    { type: "heading",text: "Tabla de solución de problemas" },
    { type: "table", headers: ["Error / síntoma","Qué significa","Solución"], rows: [
      ["&ldquo;Tradingview has not been entitled to access your account&rdquo;","El add-on de TradingView no está habilitado en la cuenta","Habilite las Add-on tools en Application Settings de Tradovate y vuelva a iniciar sesión"],
      ["El error persiste justo después de habilitar el add-on","La autorización aún no se ha propagado","Espere de unos minutos a unas horas, luego cierre sesión y vuelva a entrar"],
      ["Error en una cuenta prop / de evaluación","Suscripción al add-on a nivel de firma no habilitada","Pida a su prop firm que habilite el add-on de TradingView para su cuenta"],
      ["Add-on habilitado pero sigue fallando","La sesión se inició antes de que se cargara la autorización","Cierre sesión por completo en Tradovate y vuelva a iniciarla"],
      ["Conecta pero cuenta equivocada / no se enrutan órdenes","Conectado al entorno Demo o Live equivocado","Desconecte en TradingView y reconecte en la pestaña correcta"],
      ["Falta por completo el interruptor del add-on","La cuenta pertenece a la firma o aún no está aprovisionada","Contacte con la firma; confirme que la cuenta está activa y es operable"],
    ] },
    { type: "heading",text: "Evítelo con PickMyTrade" },
    { type: "paragraph",html: "El error de autorización trata en realidad de permisos y del estado de la sesión, justo el tipo de fricción que la automatización debería absorber por usted. PickMyTrade vincula sus alertas de TradingView directamente con Tradovate para que su estrategia siga enrutando incluso cuando la conexión manual de bróker de TradingView da problemas." },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Conciencia de autorización y conexión</strong>, respeta el acuerdo de datos y el estado del add-on de su cuenta para que las órdenes pasen por una vía sana y autorizada.",
        "<strong class='text-white'>Ajuste de entorno Demo / Live</strong>, enruta automáticamente al entorno de cuenta correcto, para que no esté conectado en silencio a la pestaña equivocada.",
        "<strong class='text-white'>Enrutamiento seguro frente a límites de frecuencia</strong>, espacia el flujo de órdenes para que una ráfaga de alertas nunca rebote contra los límites de Tradovate.",
        "<strong class='text-white'>Sincronización multicuenta</strong>, replica la misma alerta en todas las cuentas conectadas, incluidas las evaluaciones prop, de una sola vez.",
      ],
    },
  ], fr: [
    { type: "paragraph",html: "Vous préparez une configuration propre sur ES ou NQ, cliquez sur Connect dans TradingView et, au lieu d'un compte Tradovate en direct, une bannière rouge apparaît : <strong class='text-white'>&ldquo;Tradingview has not been entitled to access your account.&rdquo;</strong> Aucun ordre n'est routé. Vos boutons de trading sur le graphique restent grisés. Et le marché continue de bouger sans vous. C'est l'une des erreurs de connexion Tradovate les plus courantes, et voici la bonne nouvelle : elle ne signifie presque jamais que quelque chose est cassé. Elle signifie qu'un seul interrupteur d'add-on n'a pas encore été activé. Ci-dessous, je détaille exactement ce que signifie l'erreur d'autorisation, toutes les raisons de son apparition et comment l'éliminer en quelques minutes pour que vos alertes TradingView atteignent Tradovate au lieu de rester à la porte." },
    {
      type: "checklist",
      heading: "Liste de contrôle rapide pour l'erreur d'autorisation",
      items: [
        "<strong class='text-white'>Add-on non activé</strong>, activez les outils de l'add-on Tradovate TradingView dans Application Settings, puis déconnectez-vous et reconnectez-vous.",
        "<strong class='text-white'>Compte prop / d'évaluation</strong>, l'abonnement à l'add-on est géré par votre firme. Demandez-lui d'activer l'add-on TradingView pour votre compte.",
        "<strong class='text-white'>Activation pas encore propagée</strong>, l'activation de l'add-on n'est pas toujours instantanée. Laissez-lui quelques minutes (parfois quelques heures) et reconnectez-vous.",
        "<strong class='text-white'>Mauvais environnement</strong>, assurez-vous de vous connecter à l'onglet Demo ou Live qui correspond à votre compte.",
        "<strong class='text-white'>Session TradingView périmée</strong>, déconnectez le courtier Tradovate dans TradingView, actualisez la page et reconnectez-vous avec des identifiants à jour.",
        "<strong class='text-white'>Compte non négociable</strong>, un compte expiré, désactivé ou non financé peut aussi refuser le handshake d'autorisation. Vérifiez d'abord que le compte est actif.",
      ],
    },
    { type: "heading",text: "Ce que signifie &ldquo;TradingView has not been entitled to access your account&rdquo;" },
    { type: "paragraph",html: "La formulation semble alarmante, mais c'est un <strong class='text-white'>message d'autorisation (permission), pas un échec de connexion</strong>. Votre nom d'utilisateur et votre mot de passe Tradovate sont presque toujours corrects. Ce que Tradovate dit à TradingView est simple : <em>&ldquo;Ce compte n'a pas accordé à l'add-on TradingView le droit de trader en son nom.&rdquo;</em> Tradovate traite les interfaces tierces comme TradingView comme une intégration optionnelle que chaque compte doit autoriser explicitement via ses <strong class='text-white'>Add-on tools</strong>. Tant que cette autorisation n'existe pas, Tradovate refuse la connexion et TradingView vous affiche la bannière &ldquo;not been entitled&rdquo;." },
    { type: "paragraph",html: "Cette autorisation peut être accordée de deux façons. Sur un <strong class='text-white'>compte Tradovate personnel</strong>, vous activez vous-même l'add-on TradingView dans Application Settings. Sur un <strong class='text-white'>compte de prop firm ou d'évaluation</strong>, la firme provisionne l'autorisation de l'add-on (Apex, Elite Trader Funding, évaluations de type Topstep, etc.), de sorte que même une connexion parfaite échoue tant que la firme ne l'a pas activée pour votre compte." },
    { type: "paragraph",html: "La solution n'est donc pas de réinitialiser votre mot de passe ni de réinstaller quoi que ce soit. Il s'agit de vous assurer que l'add-on TradingView est activé sur le compte auquel vous vous connectez, d'attendre la propagation de cette autorisation, puis de vous reconnecter. Tout ce qui suit détaille les deux parcours." },
    { type: "heading",text: "Principales causes de l'erreur d'autorisation" },
    { type: "heading",text: "1. L'add-on TradingView est désactivé dans Tradovate" },
    { type: "paragraph",html: "C'est la cause numéro un. Tradovate propose l'intégration TradingView sous forme d'add-on <strong class='text-white'>désactivé par défaut</strong>. Si vous n'avez jamais ouvert l'écran Add-on tools pour l'activer, TradingView n'a rien auquel se connecter et le handshake d'autorisation échoue immédiatement." },
    { type: "heading",text: "2. C'est un compte de prop firm ou d'évaluation que vous ne pouvez pas activer vous-même" },
    { type: "paragraph",html: "Les comptes prop et d'évaluation appartiennent à la firme de financement, pas à vous. Sur ceux-ci, l'abonnement à l'add-on TradingView est activé au niveau de la firme. Si votre firme ne l'a pas activé, ou n'a pas fini de provisionner votre compte après l'achat, vous continuerez à voir l'erreur d'autorisation, quel que soit le nombre de fois où vous ressaisissez vos identifiants. Seule la firme peut activer l'add-on sur ce compte." },
    { type: "heading",text: "3. L'add-on a été activé mais ne s'est pas encore propagé" },
    { type: "paragraph",html: "L'activation de l'add-on n'est pas toujours instantanée. Après son activation (par vous ou par votre firme), l'autorisation peut prendre de quelques minutes à quelques heures pour s'activer complètement dans les systèmes de Tradovate. Si vous tentez de vous reconnecter à la seconde même où vous l'activez, vous pouvez encore rencontrer brièvement l'erreur." },
    { type: "heading",text: "4. Vous ne vous êtes pas déconnecté puis reconnecté après l'activation" },
    { type: "paragraph",html: "L'autorisation est lue au démarrage de votre session Tradovate. Si vous activez l'add-on alors que vous êtes déjà connecté, la session en cours ne prendra pas en compte la nouvelle permission. C'est une déconnexion puis une nouvelle connexion qui charge réellement l'autorisation." },
    { type: "heading",text: "5. Une session courtier TradingView périmée ou un mauvais environnement" },
    { type: "paragraph",html: "Parfois l'add-on est correctement activé, mais TradingView conserve une session de courtier périmée, ou vous essayez de vous connecter au mauvais onglet Demo/Live pour le compte que vous avez activé. Déconnecter puis reconnecter au bon environnement règle le problème." },
    { type: "heading",text: "Comment corriger l'erreur d'autorisation : étape par étape" },
    { type: "heading",text: "Corriger les causes 1 et 3 : activer les Add-on tools de Tradovate" },
    { type: "paragraph",html: "Faites-le sur le compte sur lequel vous essayez de trader (comptes Tradovate personnels)." },
    {
      type: "steps",
      items: [
        { title: "Connectez-vous à la plateforme web", html: "Ouvrez la plateforme web Tradovate sur <strong class='text-white'>trader.tradovate.com</strong> et connectez-vous." },
        { title: "Ouvrez Application Settings", html: "Ouvrez <strong class='text-white'>Application Settings</strong>, le menu situé dans le coin supérieur droit de la plateforme. Sur certaines versions, il s'intitule simplement <strong class='text-white'>Settings</strong> ou se cache derrière une icône hamburger (trois traits)." },
        { title: "Sélectionnez Add-on", html: "Sélectionnez <strong class='text-white'>Add-on</strong> (également affiché sous <strong class='text-white'>Add-Ons</strong> ou <strong class='text-white'>Add-on Tools</strong>) dans le menu des paramètres." },
        { title: "Activez l'add-on TradingView", html: "Trouvez l'add-on <strong class='text-white'>TradingView</strong> et cliquez sur <strong class='text-white'>Activate</strong> (ou activez les Add-on tools). Confirmez si on vous le demande." },
        { title: "Attendez la confirmation", html: "Attendez la confirmation que l'add-on est actif. Laissez-lui quelques minutes pour se propager. Si TradingView est gratuit dans votre offre, l'activation complète peut parfois prendre quelques heures." },
      ],
    },
    { type: "heading",text: "Corriger la cause 4 : se déconnecter puis se reconnecter" },
    { type: "paragraph",html: "L'autorisation ne se charge que dans une nouvelle session :" },
    {
      type: "steps",
      items: [
        { title: "Déconnectez-vous complètement", html: "<strong class='text-white'>Déconnectez-vous</strong> complètement de la plateforme web Tradovate." },
        { title: "Reconnectez-vous", html: "Reconnectez-vous à <strong class='text-white'>trader.tradovate.com</strong>." },
        { title: "Confirmez que le compte est actif", html: "Confirmez que le compte souhaité est actif et négociable avant de retourner dans TradingView." },
      ],
    },
    { type: "heading",text: "Corriger la cause 5 : se reconnecter depuis TradingView" },
    { type: "paragraph",html: "Une fois l'add-on actif et votre reconnexion à Tradovate effectuée :" },
    {
      type: "steps",
      items: [
        { title: "Ouvrez le Trading Panel", html: "Dans TradingView, ouvrez le <strong class='text-white'>Trading Panel</strong> en bas de l'écran." },
        { title: "Sélectionnez Tradovate", html: "Sélectionnez <strong class='text-white'>Tradovate</strong> comme courtier (déconnectez d'abord toute session Tradovate périmée si elle est affichée)." },
        { title: "Choisissez le bon environnement", html: "Choisissez le bon onglet d'environnement, <strong class='text-white'>Demo</strong> pour une évaluation/simulation, <strong class='text-white'>Live</strong> pour un compte financé/réel, correspondant au compte que vous avez activé." },
        { title: "Saisissez vos identifiants et connectez-vous", html: "Saisissez vos identifiants Tradovate et cliquez sur <strong class='text-white'>Connect</strong>." },
      ],
    },
    { type: "heading",text: "Corriger la cause 2 : demander à votre prop firm d'activer l'add-on" },
    { type: "paragraph",html: "Si vous êtes sur un compte de prop firm ou d'évaluation et que vous ne trouvez pas ou ne pouvez pas basculer l'add-on vous-même, l'autorisation relève de la firme. Contactez le support de votre firme de financement et demandez-lui de <strong class='text-white'>vérifier que l'abonnement à l'add-on TradingView est correctement activé pour votre compte</strong>. Des firmes comme Apex Trader Funding et Elite Trader Funding gèrent cela de leur côté. Une fois qu'elles confirment l'activation, déconnectez-vous puis reconnectez-vous et reconnectez-vous depuis TradingView. Le provisionnement après l'achat d'une nouvelle évaluation peut aussi prendre du temps ; si vous venez d'acheter le compte, laissez un peu de temps avant de conclure à un problème." },
    { type: "heading",text: "Tableau de dépannage" },
    { type: "table", headers: ["Erreur / symptôme","Signification","Solution"], rows: [
      ["&ldquo;Tradingview has not been entitled to access your account&rdquo;","L'add-on TradingView n'est pas activé sur le compte","Activez les Add-on tools dans Application Settings de Tradovate, puis reconnectez-vous"],
      ["L'erreur persiste juste après l'activation de l'add-on","L'autorisation ne s'est pas encore propagée","Attendez de quelques minutes à quelques heures, puis déconnectez-vous et reconnectez-vous"],
      ["Erreur sur un compte prop / d'évaluation","Abonnement à l'add-on non activé au niveau de la firme","Demandez à votre prop firm d'activer l'add-on TradingView pour votre compte"],
      ["Add-on activé mais échec persistant","La session a démarré avant le chargement de l'autorisation","Déconnectez-vous complètement de Tradovate puis reconnectez-vous"],
      ["Connexion établie mais mauvais compte / aucun ordre routé","Connecté au mauvais environnement Demo ou Live","Déconnectez dans TradingView et reconnectez sur le bon onglet"],
      ["Interrupteur de l'add-on totalement absent","Le compte appartient à la firme ou n'est pas encore provisionné","Contactez la firme ; confirmez que le compte est actif et négociable"],
    ] },
    { type: "heading",text: "Évitez ce problème avec PickMyTrade" },
    { type: "paragraph",html: "L'erreur d'autorisation relève en réalité des permissions et de l'état de session, exactement le type de friction que l'automatisation devrait absorber à votre place. PickMyTrade relie vos alertes TradingView directement à Tradovate afin que votre stratégie continue de router même lorsque la connexion manuelle au courtier de TradingView fait des siennes." },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Prise en compte de l'autorisation et de la connexion</strong>, respecte l'accord de données et l'état de l'add-on de votre compte pour que les ordres passent par un chemin sain et autorisé.",
        "<strong class='text-white'>Correspondance des environnements Demo / Live</strong>, route automatiquement vers le bon environnement de compte, afin que vous ne soyez pas connecté en silence au mauvais onglet.",
        "<strong class='text-white'>Routage compatible avec les limites de débit</strong>, espace le flux d'ordres pour qu'une rafale d'alertes ne se heurte jamais aux limites de Tradovate.",
        "<strong class='text-white'>Synchronisation multi-comptes</strong>, réplique la même alerte sur tous les comptes connectés, y compris les évaluations prop, en une seule fois.",
      ],
    },
  ], it: [
    { type: "paragraph",html: "Prepara un setup pulito su ES o NQ, clicca su Connect in TradingView e invece di un conto Tradovate live compare un banner rosso: <strong class='text-white'>&ldquo;Tradingview has not been entitled to access your account.&rdquo;</strong> Nessun ordine viene instradato. I pulsanti di trading del grafico restano grigi. E il mercato continua a muoversi senza di lei. È uno degli errori di connessione Tradovate più comuni, e la buona notizia è questa: quasi mai significa che qualcosa sia rotto. Significa che un solo interruttore dell'add-on non è ancora stato attivato. Qui sotto spiego esattamente che cosa significa l'errore di autorizzazione, tutte le ragioni per cui compare e come eliminarlo in pochi minuti, così che i suoi alert TradingView raggiungano Tradovate invece di restare alla porta." },
    {
      type: "checklist",
      heading: "Checklist rapida per l'errore di autorizzazione",
      items: [
        "<strong class='text-white'>Add-on non abilitato</strong>, attivi gli strumenti dell'add-on Tradovate TradingView in Application Settings, poi esca e riaccede.",
        "<strong class='text-white'>Conto prop / di valutazione</strong>, l'abbonamento all'add-on è controllato dalla sua società. Le chieda di abilitare l'add-on TradingView per il suo conto.",
        "<strong class='text-white'>Attivazione non ancora propagata</strong>, l'abilitazione dell'add-on non è sempre istantanea. Le dia qualche minuto (a volte qualche ora) e riaccede.",
        "<strong class='text-white'>Ambiente sbagliato</strong>, si assicuri di collegarsi alla scheda Demo o Live corretta, corrispondente al suo conto.",
        "<strong class='text-white'>Sessione TradingView obsoleta</strong>, scolleghi il broker Tradovate in TradingView, aggiorni la pagina e si ricolleghi con credenziali nuove.",
        "<strong class='text-white'>Conto non operativo</strong>, anche un conto scaduto, disabilitato o non finanziato può rifiutare l'handshake di autorizzazione. Confermi prima che il conto sia attivo.",
      ],
    },
    { type: "heading",text: "Che cosa significa &ldquo;TradingView has not been entitled to access your account&rdquo;" },
    { type: "paragraph",html: "La formulazione suona allarmante, ma è un <strong class='text-white'>messaggio di autorizzazione (permessi), non un errore di login</strong>. Il suo nome utente e la sua password Tradovate sono quasi sempre a posto. Ciò che Tradovate dice a TradingView è semplice: <em>&ldquo;Questo conto non ha concesso all'add-on TradingView il diritto di operare per suo conto.&rdquo;</em> Tradovate tratta le interfacce di terze parti come TradingView come un'integrazione facoltativa che ogni conto deve autorizzare esplicitamente tramite i suoi <strong class='text-white'>Add-on tools</strong>. Finché quell'autorizzazione non esiste, Tradovate rifiuta la connessione e TradingView le mostra il banner &ldquo;not been entitled&rdquo;." },
    { type: "paragraph",html: "Ci sono due modi in cui questa autorizzazione viene concessa. Su un <strong class='text-white'>conto Tradovate personale</strong>, abilita lei stessa l'add-on TradingView in Application Settings. Su un <strong class='text-white'>conto di prop firm o di valutazione</strong>, la società fornisce l'autorizzazione dell'add-on (Apex, Elite Trader Funding, valutazioni in stile Topstep e simili), quindi anche un login perfetto fallisce finché la società non la attiva per il suo conto." },
    { type: "paragraph",html: "La soluzione quindi non è reimpostare la password né reinstallare nulla. È assicurarsi che l'add-on TradingView sia abilitato sul conto a cui si collega, attendere che l'autorizzazione si propaghi e poi ricollegarsi. Tutto ciò che segue percorre entrambe le strade." },
    { type: "heading",text: "Cause principali dell'errore di autorizzazione" },
    { type: "heading",text: "1. L'add-on TradingView è disattivato in Tradovate" },
    { type: "paragraph",html: "Questa è la causa numero uno. Tradovate fornisce l'integrazione con TradingView come add-on <strong class='text-white'>disattivato per impostazione predefinita</strong>. Se non ha mai aperto la schermata Add-on tools per abilitarlo, TradingView non ha nulla a cui collegarsi e l'handshake di autorizzazione fallisce subito." },
    { type: "heading",text: "2. È un conto di prop firm o di valutazione che non può abilitare da sola" },
    { type: "paragraph",html: "I conti prop e di valutazione appartengono alla società di finanziamento, non a lei. Su questi, l'abbonamento all'add-on TradingView viene abilitato a livello di società. Se la sua società non lo ha attivato, o non ha finito di predisporre il suo conto dopo l'acquisto, continuerà a vedere l'errore di autorizzazione per quante volte reinserisca le credenziali. Solo la società può abilitare l'add-on su quel conto." },
    { type: "heading",text: "3. L'add-on è stato abilitato ma non si è ancora propagato" },
    { type: "paragraph",html: "L'abilitazione dell'add-on non è sempre istantanea. Dopo averlo attivato (o dopo che lo ha attivato la sua società), l'autorizzazione può impiegare da un paio di minuti ad alcune ore per attivarsi completamente nei sistemi di Tradovate. Se prova a ricollegarsi nello stesso secondo in cui lo abilita, può incontrare ancora brevemente l'errore." },
    { type: "heading",text: "4. Non è uscita e rientrata dopo averlo abilitato" },
    { type: "paragraph",html: "L'autorizzazione viene letta all'avvio della sua sessione Tradovate. Se abilita l'add-on mentre è già connessa, la sessione in corso non recepirà il nuovo permesso. È un'uscita e un nuovo accesso a caricare davvero l'autorizzazione." },
    { type: "heading",text: "5. Una sessione broker TradingView obsoleta o un ambiente sbagliato" },
    { type: "paragraph",html: "A volte l'add-on è abilitato correttamente, ma TradingView mantiene ancora una sessione broker obsoleta, oppure sta cercando di collegarsi alla scheda Demo/Live sbagliata per il conto abilitato. Scollegare e ricollegarsi all'ambiente corretto risolve il problema." },
    { type: "heading",text: "Come risolvere l'errore di autorizzazione: passo dopo passo" },
    { type: "heading",text: "Risolvere le cause 1 e 3: abilitare gli Add-on tools di Tradovate" },
    { type: "paragraph",html: "Lo faccia sul conto su cui sta cercando di operare (conti Tradovate personali)." },
    {
      type: "steps",
      items: [
        { title: "Acceda alla piattaforma web", html: "Apra la piattaforma web di Tradovate su <strong class='text-white'>trader.tradovate.com</strong> e acceda." },
        { title: "Apra Application Settings", html: "Apra <strong class='text-white'>Application Settings</strong>, il menu nell'angolo in alto a destra della piattaforma. In alcune versioni è indicato semplicemente come <strong class='text-white'>Settings</strong> o si trova dietro un'icona a hamburger (tre linee)." },
        { title: "Selezioni Add-on", html: "Selezioni <strong class='text-white'>Add-on</strong> (indicato anche come <strong class='text-white'>Add-Ons</strong> o <strong class='text-white'>Add-on Tools</strong>) dal menu delle impostazioni." },
        { title: "Attivi l'add-on TradingView", html: "Trovi l'add-on <strong class='text-white'>TradingView</strong> e clicchi su <strong class='text-white'>Activate</strong> (o attivi gli Add-on tools). Confermi se richiesto." },
        { title: "Attenda la conferma", html: "Attenda la conferma che l'add-on sia attivo. Gli dia qualche minuto per propagarsi. Se TradingView è gratuito nel suo piano, l'attivazione completa può occasionalmente richiedere alcune ore." },
      ],
    },
    { type: "heading",text: "Risolvere la causa 4: uscire e rientrare" },
    { type: "paragraph",html: "L'autorizzazione si carica solo in una sessione nuova:" },
    {
      type: "steps",
      items: [
        { title: "Esca completamente", html: "<strong class='text-white'>Esca</strong> completamente dalla piattaforma web di Tradovate." },
        { title: "Rientri", html: "Riaccede a <strong class='text-white'>trader.tradovate.com</strong>." },
        { title: "Confermi che il conto è attivo", html: "Confermi che il conto desiderato sia attivo e operativo prima di tornare a TradingView." },
      ],
    },
    { type: "heading",text: "Risolvere la causa 5: ricollegarsi da TradingView" },
    { type: "paragraph",html: "Una volta che l'add-on è attivo e ha effettuato di nuovo l'accesso a Tradovate:" },
    {
      type: "steps",
      items: [
        { title: "Apra il Trading Panel", html: "In TradingView, apra il <strong class='text-white'>Trading Panel</strong> nella parte inferiore dello schermo." },
        { title: "Selezioni Tradovate", html: "Selezioni <strong class='text-white'>Tradovate</strong> come broker (scolleghi prima un'eventuale sessione Tradovate obsoleta, se ne viene mostrata una)." },
        { title: "Scelga l'ambiente corretto", html: "Scelga la scheda dell'ambiente corretto, <strong class='text-white'>Demo</strong> per valutazione/simulato, <strong class='text-white'>Live</strong> per un conto finanziato/reale, corrispondente al conto che ha abilitato." },
        { title: "Inserisca le credenziali e si colleghi", html: "Inserisca le sue credenziali Tradovate e clicchi su <strong class='text-white'>Connect</strong>." },
      ],
    },
    { type: "heading",text: "Risolvere la causa 2: chiedere alla prop firm di abilitare l'add-on" },
    { type: "paragraph",html: "Se ha un conto di prop firm o di valutazione e non riesce a trovare o attivare l'add-on da sola, l'autorizzazione dipende dalla società. Contatti il supporto della sua società di finanziamento e chieda di <strong class='text-white'>verificare che l'abbonamento all'add-on TradingView sia correttamente abilitato per il suo conto</strong>. Società come Apex Trader Funding ed Elite Trader Funding se ne occupano dalla loro parte. Una volta che confermano l'abilitazione, esca e riaccede e si ricolleghi da TradingView. Anche la predisposizione dopo l'acquisto di una nuova valutazione può richiedere tempo, quindi se ha appena acquistato il conto, gli dia un po' di tempo prima di pensare che qualcosa non vada." },
    { type: "heading",text: "Tabella di risoluzione dei problemi" },
    { type: "table", headers: ["Errore / sintomo","Cosa significa","Soluzione"], rows: [
      ["&ldquo;Tradingview has not been entitled to access your account&rdquo;","L'add-on TradingView non è abilitato sul conto","Abiliti gli Add-on tools in Application Settings di Tradovate, poi riaccede"],
      ["L'errore persiste subito dopo aver abilitato l'add-on","L'autorizzazione non si è ancora propagata","Attenda da pochi minuti ad alcune ore, poi esca e riaccede"],
      ["Errore su un conto prop / di valutazione","Abbonamento all'add-on a livello di società non abilitato","Chieda alla sua prop firm di abilitare l'add-on TradingView per il suo conto"],
      ["Add-on abilitato ma continua a fallire","La sessione è stata avviata prima che l'autorizzazione fosse caricata","Esca completamente da Tradovate e riaccede"],
      ["Si collega ma conto sbagliato / nessun ordine viene instradato","Collegato all'ambiente Demo o Live sbagliato","Scolleghi in TradingView e si ricolleghi sulla scheda corretta"],
      ["L'interruttore dell'add-on manca del tutto","Il conto appartiene alla società o non è ancora predisposto","Contatti la società; confermi che il conto sia attivo e operativo"],
    ] },
    { type: "heading",text: "Lo eviti con PickMyTrade" },
    { type: "paragraph",html: "L'errore di autorizzazione riguarda in realtà permessi e stato della sessione, esattamente il tipo di attrito che l'automazione dovrebbe assorbire per lei. PickMyTrade collega i suoi alert TradingView direttamente a Tradovate così la sua strategia continua a instradare anche quando il collegamento broker manuale di TradingView fa i capricci." },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Consapevolezza di autorizzazione e connessione</strong>, rispetta l'accordo sui dati e lo stato dell'add-on del suo conto così che gli ordini passino attraverso un percorso sano e autorizzato.",
        "<strong class='text-white'>Corrispondenza degli ambienti Demo / Live</strong>, instrada automaticamente verso l'ambiente di conto corretto, così non è collegato in silenzio alla scheda sbagliata.",
        "<strong class='text-white'>Instradamento sicuro rispetto ai limiti di frequenza</strong>, distanzia il flusso degli ordini così che una raffica di alert non rimbalzi mai contro i limiti di Tradovate.",
        "<strong class='text-white'>Sincronizzazione multi-conto</strong>, replica lo stesso alert su tutti i conti collegati, comprese le valutazioni prop, in un colpo solo.",
      ],
    },
  ] },
  ctaHeading: { en: "Trade Rejection-Free", de: "Handeln Sie ohne Ablehnungen", es: "Opere sin rechazos", fr: "Tradez sans rejet", it: "Faccia trading senza rifiuti" },
  ctaText: { en: "Start your free 7-day trial, link alerts today and trade rejection-free.", de: "Starten Sie Ihre kostenlose 7-Tage-Testphase, verknüpfen Sie noch heute Ihre Alerts und handeln Sie ohne Ablehnungen.", es: "Comience su prueba gratuita de 7 días, vincule sus alertas hoy mismo y opere sin rechazos.", fr: "Commencez votre essai gratuit de 7 jours, reliez vos alertes dès aujourd'hui et tradez sans rejet.", it: "Inizi la prova gratuita di 7 giorni, colleghi i suoi alert oggi stesso e faccia trading senza rifiuti." },
  ctaButtonText: { en: "Start Your Free 7-Day Trial", de: "Starten Sie Ihre kostenlose 7-Tage-Testphase", es: "Comience su prueba gratuita de 7 días", fr: "Commencez votre essai gratuit de 7 jours", it: "Inizi la prova gratuita di 7 giorni" },
  ctaUrl: "https://app.pickmytrade.trade/?register=true&utm_source=content&utm_medium=debugging",
  faqHeading: { en: "Frequently Asked Questions", de: "Häufig gestellte Fragen", es: "Preguntas frecuentes", fr: "Questions fréquentes", it: "Domande frequenti" },
  faqs: { en: [
    { q: "What does &ldquo;TradingView has not been entitled to access your account&rdquo; actually mean?", a: "It means the TradingView add-on isn't enabled on the Tradovate account you're connecting. It's a permission (entitlement) message, not a wrong-password error, so your login is almost always correct." },
    { q: "How do I enable the TradingView add-on in Tradovate?", a: "Log in at trader.tradovate.com, open Application Settings in the top-right corner, choose the Add-on (Add-on Tools) section, and activate the TradingView add-on. Then log out and back in." },
    { q: "I enabled the add-on but still get the error. Why?", a: "Two common reasons: you didn't start a fresh session (log out and back in), or the entitlement hasn't propagated yet. Give it a few minutes, sometimes a few hours, then reconnect." },
    { q: "I'm on a prop firm account and can't find the add-on setting. What do I do?", a: "On prop and evaluation accounts the add-on subscription is controlled by the firm. Contact your firm's support and ask them to confirm the TradingView add-on is enabled for your account." },
    { q: "Do I need to pay for the TradingView add-on?", a: "Add-on availability and cost vary by account type and plan, and firms handle it differently. Check your current Tradovate plan and your firm's rules for the latest terms rather than assuming a fixed price." },
    { q: "Does enabling the add-on affect my Live account and my Demo account the same way?", a: "You enable and connect per account and environment. Make sure the add-on is active on the account you want, and connect on the matching Demo or Live tab in TradingView." },
    { q: "How long does the add-on take to activate?", a: "Often just a few minutes, but it can take longer to fully propagate, up to a few hours in some cases, especially right after a new evaluation purchase. Re-log before assuming it failed." },
    { q: "Will I lose my TradingView chart layout when I reconnect?", a: "No. Disconnecting and reconnecting the Tradovate broker in TradingView only refreshes the trading connection. Your charts, drawings, and layouts are untouched." },
  ], de: [
    { q: "Was bedeutet &ldquo;TradingView has not been entitled to access your account&rdquo; eigentlich?", a: "Es bedeutet, dass das TradingView-Add-on für das Tradovate-Konto, mit dem Sie sich verbinden, nicht aktiviert ist. Es ist eine Berechtigungsmeldung (Entitlement), kein Fehler wegen falschen Passworts, Ihr Login ist also fast immer korrekt." },
    { q: "Wie aktiviere ich das TradingView-Add-on in Tradovate?", a: "Melden Sie sich bei trader.tradovate.com an, öffnen Sie oben rechts die Application Settings, wählen Sie den Bereich Add-on (Add-on Tools) und aktivieren Sie das TradingView-Add-on. Melden Sie sich anschließend ab und wieder an." },
    { q: "Ich habe das Add-on aktiviert und bekomme den Fehler trotzdem. Warum?", a: "Zwei häufige Gründe: Sie haben keine neue Sitzung gestartet (ab- und wieder anmelden), oder die Berechtigung ist noch nicht übernommen worden. Geben Sie ihr ein paar Minuten, manchmal ein paar Stunden, und verbinden Sie sich dann erneut." },
    { q: "Ich nutze ein Prop-Firm-Konto und finde die Add-on-Einstellung nicht. Was tun?", a: "Bei Prop- und Evaluierungskonten wird das Add-on-Abonnement von der Firma gesteuert. Wenden Sie sich an den Support Ihrer Firma und bitten Sie darum, zu bestätigen, dass das TradingView-Add-on für Ihr Konto aktiviert ist." },
    { q: "Muss ich für das TradingView-Add-on bezahlen?", a: "Verfügbarkeit und Kosten des Add-ons variieren je nach Kontotyp und Tarif, und die Firmen handhaben es unterschiedlich. Prüfen Sie Ihren aktuellen Tradovate-Tarif und die Regeln Ihrer Firma für die jeweils aktuellen Konditionen, statt einen festen Preis anzunehmen." },
    { q: "Wirkt sich das Aktivieren des Add-ons auf mein Live- und mein Demo-Konto gleich aus?", a: "Sie aktivieren und verbinden pro Konto und Umgebung. Stellen Sie sicher, dass das Add-on auf dem gewünschten Konto aktiv ist, und verbinden Sie sich in TradingView auf dem passenden Demo- oder Live-Tab." },
    { q: "Wie lange dauert es, bis das Add-on aktiv ist?", a: "Oft nur ein paar Minuten, es kann aber länger dauern, bis es vollständig übernommen ist, in manchen Fällen bis zu einigen Stunden, besonders direkt nach dem Kauf einer neuen Evaluierung. Melden Sie sich neu an, bevor Sie annehmen, es sei fehlgeschlagen." },
    { q: "Verliere ich mein TradingView-Chart-Layout, wenn ich mich neu verbinde?", a: "Nein. Das Trennen und erneute Verbinden des Tradovate-Brokers in TradingView aktualisiert nur die Handelsverbindung. Ihre Charts, Zeichnungen und Layouts bleiben unberührt." },
  ], es: [
    { q: "¿Qué significa realmente &ldquo;TradingView has not been entitled to access your account&rdquo;?", a: "Significa que el add-on de TradingView no está habilitado en la cuenta de Tradovate a la que se conecta. Es un mensaje de permisos (autorización), no un error de contraseña incorrecta, por lo que su inicio de sesión casi siempre es correcto." },
    { q: "¿Cómo habilito el add-on de TradingView en Tradovate?", a: "Inicie sesión en trader.tradovate.com, abra Application Settings en la esquina superior derecha, elija la sección Add-on (Add-on Tools) y active el add-on de TradingView. Después cierre sesión y vuelva a iniciarla." },
    { q: "Habilité el add-on pero sigo recibiendo el error. ¿Por qué?", a: "Dos motivos habituales: no inició una sesión nueva (cierre sesión y vuelva a entrar) o la autorización aún no se ha propagado. Concédale unos minutos, a veces unas horas, y vuelva a conectarse." },
    { q: "Estoy en una cuenta de una prop firm y no encuentro el ajuste del add-on. ¿Qué hago?", a: "En las cuentas prop y de evaluación, la suscripción al add-on la controla la firma. Contacte con el soporte de su firma y pídales que confirmen que el add-on de TradingView está habilitado para su cuenta." },
    { q: "¿Tengo que pagar por el add-on de TradingView?", a: "La disponibilidad y el coste del add-on varían según el tipo de cuenta y el plan, y las firmas lo gestionan de forma distinta. Revise su plan actual de Tradovate y las reglas de su firma para conocer las condiciones vigentes en lugar de suponer un precio fijo." },
    { q: "¿Habilitar el add-on afecta igual a mi cuenta Live y a mi cuenta Demo?", a: "Se habilita y se conecta por cuenta y por entorno. Asegúrese de que el add-on esté activo en la cuenta que desea y conéctese en la pestaña Demo o Live de TradingView que corresponda." },
    { q: "¿Cuánto tarda en activarse el add-on?", a: "A menudo solo unos minutos, pero puede tardar más en propagarse por completo, hasta unas horas en algunos casos, sobre todo justo después de comprar una nueva evaluación. Vuelva a iniciar sesión antes de asumir que falló." },
    { q: "¿Perderé el diseño de mi gráfico de TradingView al reconectar?", a: "No. Desconectar y volver a conectar el bróker Tradovate en TradingView solo actualiza la conexión de trading. Sus gráficos, dibujos y diseños no se tocan." },
  ], fr: [
    { q: "Que signifie réellement &ldquo;TradingView has not been entitled to access your account&rdquo; ?", a: "Cela signifie que l'add-on TradingView n'est pas activé sur le compte Tradovate auquel vous vous connectez. C'est un message de permission (autorisation), pas une erreur de mot de passe ; votre identifiant est donc presque toujours correct." },
    { q: "Comment activer l'add-on TradingView dans Tradovate ?", a: "Connectez-vous à trader.tradovate.com, ouvrez Application Settings en haut à droite, choisissez la section Add-on (Add-on Tools) et activez l'add-on TradingView. Déconnectez-vous ensuite puis reconnectez-vous." },
    { q: "J'ai activé l'add-on mais l'erreur persiste. Pourquoi ?", a: "Deux raisons fréquentes : vous n'avez pas démarré une nouvelle session (déconnectez-vous puis reconnectez-vous), ou l'autorisation ne s'est pas encore propagée. Laissez-lui quelques minutes, parfois quelques heures, puis reconnectez-vous." },
    { q: "Je suis sur un compte de prop firm et je ne trouve pas le réglage de l'add-on. Que faire ?", a: "Sur les comptes prop et d'évaluation, l'abonnement à l'add-on est géré par la firme. Contactez le support de votre firme et demandez-lui de confirmer que l'add-on TradingView est activé pour votre compte." },
    { q: "Dois-je payer pour l'add-on TradingView ?", a: "La disponibilité et le coût de l'add-on varient selon le type de compte et l'offre, et les firmes le gèrent différemment. Vérifiez votre offre Tradovate actuelle et les règles de votre firme pour connaître les conditions en vigueur plutôt que de supposer un prix fixe." },
    { q: "L'activation de l'add-on affecte-t-elle de la même façon mon compte Live et mon compte Demo ?", a: "Vous activez et connectez par compte et par environnement. Assurez-vous que l'add-on est actif sur le compte souhaité et connectez-vous sur l'onglet Demo ou Live correspondant dans TradingView." },
