---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "2fa-approval-link-page-not-created";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/debugging/${SLUG}`;

const META_TITLE = "Tradovate 2FA Link 'This Page Has Not Been Created'";
const META_DESCRIPTION =
  "Tradovate device-approval link showing 'This page has not been created'? The link is broken. Here's how to get your new machine approved and log back in.";

// Short SEO title (<=60 chars) for locales where the shared h1 is too long for a SERP title.
const TITLE_OVERRIDE: Partial<Record<Locale, string>> = { de: "Tradovate 2FA-Link: „This Page Has Not Been Created“", es: "Tradovate 2FA: “This Page Has Not Been Created”", fr: "Tradovate : lien 2FA « This Page Has Not Been Created »", it: "Link 2FA Tradovate: “This Page Has Not Been Created”" };

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Tradovate 2FA-Link: &ldquo;This Page Has Not Been Created&rdquo;", es: "Enlace 2FA de Tradovate: &ldquo;This Page Has Not Been Created&rdquo;", fr: "Lien 2FA Tradovate : &ldquo;This Page Has Not Been Created&rdquo;", it: "Link 2FA Tradovate: &ldquo;This Page Has Not Been Created&rdquo;" },
  dek: { en: "Your device-approval link opens to &ldquo;This page has not been created,&rdquo; and the login stays paused waiting for an approval you can't give. Here's why the link is broken on Tradovate's side and how to get your device approved anyway.", de: "Ihr Link zur Geräte-Genehmigung öffnet sich mit der Meldung &ldquo;This page has not been created,&rdquo; und die Anmeldung bleibt pausiert und wartet auf eine Genehmigung, die Sie nicht erteilen können. Hier erfahren Sie, warum der Link auf Seiten von Tradovate defekt ist und wie Sie Ihr Gerät trotzdem genehmigen lassen können.", es: "El enlace de aprobación de dispositivo se abre con el mensaje &ldquo;This page has not been created,&rdquo; y el inicio de sesión permanece en pausa esperando una aprobación que usted no puede otorgar. A continuación explicamos por qué el enlace está roto del lado de Tradovate y cómo aprobar su dispositivo de todos modos.", fr: "Votre lien d'approbation d'appareil s'ouvre sur &ldquo;This page has not been created,&rdquo; et la connexion reste en pause, en attente d'une approbation que vous ne pouvez pas donner. Voici pourquoi ce lien est cassé du côté de Tradovate et comment faire approuver votre appareil malgré tout.", it: "Il link di approvazione del dispositivo si apre con il messaggio &ldquo;This page has not been created,&rdquo; e l'accesso resta in pausa in attesa di un'approvazione che Lei non può concedere. Ecco perché il link è danneggiato lato Tradovate e come far approvare comunque il Suo dispositivo." },
  readTime: { en: "6 min read", de: "6 Minuten Lesezeit", es: "Lectura de 6 minutos", fr: "Lecture de 6 minutes", it: "Lettura di 6 minuti" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "You enabled two-factor authentication, logged in from a new laptop, and Tradovate emailed you to approve the device. So far, normal. Then you click the <strong class='text-white'>Approve</strong> link in that email and instead of a tidy &ldquo;device approved&rdquo; confirmation, you land on a page that reads <strong class='text-white'>&ldquo;This page has not been created yet.&rdquo;</strong> Now you're stuck: the login is paused waiting for an approval you literally can't give, because the link that's supposed to give it is dead. Here's the short version, the link is broken on Tradovate's side, you can't repair it from your end, and the reliable fix is to have Tradovate support approve your device (or reset 2FA) manually. Below is how to confirm that's what's happening, the couple of things worth trying first, exactly how to reach support, and how a stable automated connection like PickMyTrade keeps you from tripping this new-machine approval so often in the first place." },
    {
      type: "checklist",
      heading: "Quick Checklist for the Broken Approval Link",
      items: [
        "<strong class='text-white'>Open the newest email.</strong> An old or already-clicked approval link can dead-end; make sure you're clicking the most recent device notice from Tradovate.",
        "<strong class='text-white'>Don't keep hammering it.</strong> Retrying a dead link or re-attempting login over and over can trip a temporary captcha or lockout on top of everything else.",
        "<strong class='text-white'>Regenerate the email.</strong> From a device that already works, open <strong class='text-white'>Application Settings &gt; My Devices</strong>, find the <strong class='text-white'>Pending</strong> machine, and click <strong class='text-white'>Forget</strong> to fire a fresh approve/deny email.",
        "<strong class='text-white'>Try an approved device.</strong> If you can still log in from your old computer, do that to keep trading while you sort out the new one.",
        "<strong class='text-white'>Skip the self-fixes that won't help.</strong> Clearing cache or switching browsers can't load a page that was never published.",
        "<strong class='text-white'>Go straight to support.</strong> If the link stays broken, contact Tradovate to approve the device or reset 2FA on their side.",
      ],
    },
    { type: "heading", text: "What “This Page Has Not Been Created” Actually Means" },
    { type: "paragraph", html: "This isn't an error coming from your account, your credentials, or your browser. The device-approval email carries a link that's supposed to open a page on Tradovate's hosted web platform, the same system that runs its help center and portal. When that platform is asked for a page that isn't published or no longer exists, it returns a generic message along the lines of <strong class='text-white'>&ldquo;This page has not been created yet&rdquo;</strong> or &ldquo;this page isn't available.&rdquo; In other words, the link points at a destination that isn't there. The approve/deny screen never loads because, as far as the server is concerned, there's nothing to load." },
    { type: "paragraph", html: "That's why this one feels so frustrating: the usual troubleshooting reflexes don't apply. You can clear cookies, open a private window, switch from Chrome to a different browser, even try your phone, and you'll get the same dead page every time, because the problem is the target URL, not how you're opening it. It's a broker-side defect, and the practical takeaway is that you shouldn't burn twenty minutes trying to &ldquo;fix your browser.&rdquo; You can't fix a link that leads nowhere." },
    { type: "paragraph", html: "Meanwhile, the login you started is still holding. On a 2FA-protected account, Tradovate won't complete a session from an unrecognized device until that device is approved. Live accounts enforce this hard, and if you're routing through TradingView you'll see the paired message <strong class='text-white'>&ldquo;You have 2FA enabled and log in from a new machine.&rdquo;</strong> Until the device gets approved, nothing routes, which is exactly why a broken approval link is worth handling quickly rather than shrugging off." },
    { type: "heading", text: "Why the Link Breaks in the First Place" },
    { type: "heading", text: "1. The approval page the link points to isn't live" },
    { type: "paragraph", html: "The email is real and the device challenge is real, but the URL inside it resolves to a page that the hosting platform doesn't serve. That's the core of the &ldquo;not created&rdquo; message, a missing destination, not a wrong click on your end." },
    { type: "heading", text: "2. You clicked an old or already-used link" },
    { type: "paragraph", html: "If you attempted login a few times, you may have several approval emails. Clicking an older one, or one whose link was already consumed, can dead-end. The freshest email is always the one worth opening." },
    { type: "heading", text: "3. The email is filtered, forwarded, or going to the wrong address" },
    { type: "paragraph", html: "Approval emails land in Spam, Promotions, or an address you no longer check. A forwarded copy can also mangle the link. Approve from the exact inbox tied to your Tradovate account, not a forward or alias." },
    { type: "heading", text: "4. You're on a live or prop-firm account, which is strict about approval" },
    { type: "paragraph", html: "Live accounts won't let an unapproved device through at all, so a broken link on live is a full stop rather than a minor annoyance. If you're on a prop-firm evaluation, the firm may also sit between you and Tradovate's account controls, which adds a second party who might need to help." },
    { type: "heading", text: "How to Fix It: Step-by-Step" },
    {
      type: "steps",
      items: [
        { title: "Open the newest email and try once more", html: "Go back to the inbox on your Tradovate account, sort by newest, and open the most recent device-approval message. Click its <strong class='text-white'>Approve</strong> link a single time. If it still shows &ldquo;This page has not been created,&rdquo; stop clicking, repeating a dead link accomplishes nothing and repeated login attempts can trigger a temporary captcha or lockout you'll then have to wait out." },
        { title: "Regenerate the email from My Devices", html: "If you can log in from a machine that's already approved, use it to force a fresh link: log in to Tradovate web on that device, open <strong class='text-white'>Application Settings</strong> and select <strong class='text-white'>My Devices</strong> (each device lists its name, IP address, last location, and last login time), find the new machine showing a <strong class='text-white'>Pending</strong> status and click <strong class='text-white'>Forget</strong>. Forgetting a pending device triggers a brand-new approve/deny email the next time that machine attempts a login. Go back to the new device, start the login again, then open the fresh email and click <strong class='text-white'>Approve</strong>. A newly generated link sometimes works where a stale one dead-ends; if the fresh one also lands on &ldquo;not created,&rdquo; you've confirmed it's a persistent broker-side break and it's time for support." },
      ],
    },
    { type: "heading", text: "Contact Tradovate Support to Approve the Device Manually" },
    { type: "paragraph", html: "This is the fix that actually clears a broken link, because support can approve your device from their side without you needing the email to work at all. Reach them through any of these:" },
    {
      type: "table",
      headers: ["Channel", "Details", "Best for"],
      rows: [
        ["Email", "support@tradovate.com", "A written record; attach a screenshot of the broken page"],
        ["Phone (general)", "1-844-283-3100", "Talking it through during support hours"],
        ["Phone (trade emergency)", "(312) 283-3100", "Being locked out with an open position"],
        ["Live chat", "In-app chat / chat on tradovate.com", "Quick back-and-forth"],
        ["Contact form", "support.tradovate.com contact page", "Logging a ticket with details"],
      ],
    },
    { type: "paragraph", html: "When you reach out, hand them everything up front so they can act on the first reply: the email address on your account, that two-factor authentication is enabled, that you logged in from a new machine, and that the approval link returns &ldquo;This page has not been created.&rdquo; Ask them plainly to <strong class='text-white'>approve the new device</strong> for your account, or to <strong class='text-white'>reset 2FA</strong> temporarily so you can log in and re-approve it yourself. Confirm the current phone hours and channels on the official Tradovate contact page, since support details can change." },
    { type: "heading", text: "Loop in Your Prop Firm If It's an Evaluation Account" },
    { type: "paragraph", html: "On a prop-firm funded or evaluation account, the firm often manages the account relationship with Tradovate. If Tradovate support tells you the change has to come through the firm, or you're not sure who owns the account controls, open a ticket with your prop firm at the same time and mention the broken approval link so both sides can coordinate." },
    { type: "heading", text: "What Not to Waste Time On" },
    { type: "paragraph", html: "A broken destination link doesn't care how you open it, so skip these until support has approved the device:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Clearing cache or cookies</strong>, won't summon a page that was never published.",
        "<strong class='text-white'>Switching browsers or devices to click the same link</strong>, same dead URL, same result.",
        "<strong class='text-white'>Resetting your password</strong>, this isn't a credential problem; it's a device-approval problem.",
        "<strong class='text-white'>Hammering the login button</strong>, repeated attempts can add a captcha or temporary lockout on top of the block you already have.",
      ],
    },
    { type: "heading", text: "Stop Tripping New-Machine Approvals with PickMyTrade" },
    { type: "paragraph", html: "To be straight with you: no third-party tool can repair a broken link inside Tradovate's own email, that fix has to come from Tradovate. What you <em>can</em> do is stop landing in this situation so often. Every genuinely new origin, a fresh browser, a new VPS, a different network, can read as a &ldquo;new machine&rdquo; and kick off another device-approval email. When you're automating from TradingView, PickMyTrade routes your alerts to Tradovate over one steady connection, so you're not re-triggering the new-machine challenge every time you switch laptops or your IP changes." },
    {
      type: "list",
      items: [
        "<strong class='text-white'>One consistent connection</strong>, alerts flow through a single PickMyTrade route instead of a rotating cast of devices, so there's far less to approve in the first place.",
        "<strong class='text-white'>Set-once account link</strong>, connect your Tradovate account a single time; there's no browser session to babysit on every device you own.",
        "<strong class='text-white'>Live and demo aware</strong>, route to the exact account you mean, which matters because live is where device approval bites hardest.",
        "<strong class='text-white'>Multi-account sync</strong>, mirror one alert across several Tradovate accounts from one place, without logging each in from a new machine.",
      ],
    },
  ], de: [
    { type: "paragraph", html: "Sie haben die Zwei-Faktor-Authentifizierung aktiviert, sich von einem neuen Laptop aus angemeldet, und Tradovate hat Ihnen eine E-Mail zur Genehmigung des Geräts geschickt. Bis hierhin ist alles normal. Dann klicken Sie in dieser E-Mail auf den Link <strong class='text-white'>Approve</strong>, und statt einer sauberen Bestätigung &ldquo;device approved&rdquo; landen Sie auf einer Seite mit der Meldung <strong class='text-white'>&ldquo;This page has not been created yet.&rdquo;</strong> Jetzt stecken Sie fest: Die Anmeldung bleibt pausiert und wartet auf eine Genehmigung, die Sie buchstäblich nicht erteilen können, weil der Link, der genau das ermöglichen soll, tot ist. Hier die Kurzfassung: Der Link ist auf Seiten von Tradovate defekt, Sie können ihn von Ihrer Seite aus nicht reparieren, und die zuverlässige Lösung ist, dass der Tradovate-Support Ihr Gerät manuell genehmigt (oder die 2FA zurücksetzt). Im Folgenden erfahren Sie, wie Sie das bestätigen, was zuerst einen Versuch wert ist, wie Sie den Support genau erreichen, und wie eine stabile automatisierte Verbindung wie PickMyTrade dafür sorgt, dass Sie diese Geräte-Genehmigung für neue Maschinen nicht mehr so häufig auslösen." },
    {
      type: "checklist",
      heading: "Kurz-Checkliste für den defekten Genehmigungslink",
      items: [
        "<strong class='text-white'>Öffnen Sie die neueste E-Mail.</strong> Ein alter oder bereits angeklickter Genehmigungslink kann ins Leere führen; stellen Sie sicher, dass Sie auf die aktuellste Gerätemeldung von Tradovate klicken.",
        "<strong class='text-white'>Klicken Sie nicht wiederholt darauf.</strong> Wiederholtes Klicken auf einen toten Link oder wiederholte Anmeldeversuche können zusätzlich ein temporäres Captcha oder eine Sperre auslösen.",
        "<strong class='text-white'>Fordern Sie die E-Mail erneut an.</strong> Öffnen Sie von einem Gerät aus, das bereits funktioniert, <strong class='text-white'>Application Settings &gt; My Devices</strong>, suchen Sie das Gerät mit dem Status <strong class='text-white'>Pending</strong> und klicken Sie auf <strong class='text-white'>Forget</strong>, um eine neue Genehmigungs-E-Mail auszulösen.",
        "<strong class='text-white'>Versuchen Sie ein bereits genehmigtes Gerät.</strong> Wenn Sie sich noch von Ihrem alten Computer aus anmelden können, tun Sie das, um weiterzuhandeln, während Sie das neue Gerät klären.",
        "<strong class='text-white'>Verzichten Sie auf nutzlose Selbsthilfe-Maßnahmen.</strong> Cache leeren oder den Browser wechseln kann keine Seite laden, die nie veröffentlicht wurde.",
        "<strong class='text-white'>Wenden Sie sich direkt an den Support.</strong> Bleibt der Link defekt, kontaktieren Sie Tradovate, damit das Gerät genehmigt oder die 2FA zurückgesetzt wird.",
      ],
    },
    { type: "heading", text: "Was &ldquo;This Page Has Not Been Created&rdquo; wirklich bedeutet" },
    { type: "paragraph", html: "Dies ist kein Fehler, der von Ihrem Konto, Ihren Zugangsdaten oder Ihrem Browser ausgeht. Die Genehmigungs-E-Mail für das Gerät enthält einen Link, der eigentlich eine Seite auf der gehosteten Web-Plattform von Tradovate öffnen soll, demselben System, das auch das Help Center und das Portal betreibt. Wenn diese Plattform nach einer Seite gefragt wird, die nicht veröffentlicht ist oder nicht mehr existiert, gibt sie eine generische Meldung zurück, etwa <strong class='text-white'>&ldquo;This page has not been created yet&rdquo;</strong> oder &ldquo;this page isn't available.&rdquo; Mit anderen Worten: Der Link zeigt auf ein Ziel, das es nicht gibt. Der Genehmigen/Ablehnen-Bildschirm lädt nie, weil es aus Sicht des Servers schlicht nichts zu laden gibt." },
    { type: "paragraph", html: "Deshalb ist dieser Fall so frustrierend: Die üblichen Fehlerbehebungs-Reflexe greifen nicht. Sie können Cookies löschen, ein privates Fenster öffnen, von Chrome auf einen anderen Browser wechseln, sogar Ihr Handy ausprobieren, und Sie erhalten jedes Mal dieselbe tote Seite, weil das Problem in der Ziel-URL liegt, nicht darin, wie Sie sie öffnen. Es handelt sich um einen Fehler auf Seiten des Brokers, und die praktische Konsequenz ist, dass Sie keine zwanzig Minuten damit verbringen sollten, &ldquo;Ihren Browser zu reparieren.&rdquo; Sie können einen Link, der ins Leere führt, nicht reparieren." },
    { type: "paragraph", html: "In der Zwischenzeit bleibt die begonnene Anmeldung weiter in der Warteschleife. Bei einem 2FA-geschützten Konto lässt Tradovate keine Sitzung von einem nicht erkannten Gerät abschließen, bevor dieses Gerät genehmigt ist. Live-Konten setzen das strikt durch, und wenn Sie über TradingView routen, sehen Sie die dazugehörige Meldung <strong class='text-white'>&ldquo;You have 2FA enabled and log in from a new machine.&rdquo;</strong> Solange das Gerät nicht genehmigt ist, wird nichts geroutet, weshalb es sich lohnt, einen defekten Genehmigungslink zügig zu klären, statt ihn zu ignorieren." },
    { type: "heading", text: "Warum der Link überhaupt defekt ist" },
    { type: "heading", text: "1. Die Genehmigungsseite, auf die der Link verweist, ist nicht live" },
    { type: "paragraph", html: "Die E-Mail ist echt und die Geräteabfrage ist echt, aber die URL darin führt zu einer Seite, die die Hosting-Plattform nicht ausliefert. Das ist der Kern der Meldung &ldquo;not created&rdquo;, ein fehlendes Ziel, kein Fehlklick auf Ihrer Seite." },
    { type: "heading", text: "2. Sie haben einen alten oder bereits verwendeten Link angeklickt" },
    { type: "paragraph", html: "Wenn Sie sich mehrfach angemeldet haben, besitzen Sie eventuell mehrere Genehmigungs-E-Mails. Ein Klick auf eine ältere, oder eine, deren Link bereits verbraucht wurde, kann ins Leere führen. Die neueste E-Mail lohnt sich immer am meisten zu öffnen." },
    { type: "heading", text: "3. Die E-Mail wird gefiltert, weitergeleitet oder geht an die falsche Adresse" },
    { type: "paragraph", html: "Genehmigungs-E-Mails landen im Spam, unter Werbung oder bei einer Adresse, die Sie nicht mehr prüfen. Eine weitergeleitete Kopie kann den Link zudem beschädigen. Genehmigen Sie ausschließlich aus dem exakten Postfach, das mit Ihrem Tradovate-Konto verknüpft ist, nicht aus einer Weiterleitung oder einem Alias." },
    { type: "heading", text: "4. Sie nutzen ein Live- oder Prop-Firm-Konto, das die Genehmigung streng handhabt" },
    { type: "paragraph", html: "Live-Konten lassen ein nicht genehmigtes Gerät gar nicht erst durch, ein defekter Link ist auf Live also ein vollständiger Stopp und nicht nur eine kleine Unannehmlichkeit. Falls Sie ein Prop-Firm-Evaluierungskonto nutzen, sitzt die Firma unter Umständen auch zwischen Ihnen und den Kontosteuerungen von Tradovate, was eine zweite Partei hinzufügt, die eventuell helfen muss." },
    { type: "heading", text: "So beheben Sie das Problem: Schritt für Schritt" },
    {
      type: "steps",
      items: [
        { title: "Öffnen Sie die neueste E-Mail und versuchen Sie es noch einmal", html: "Gehen Sie zurück in den Posteingang Ihres Tradovate-Kontos, sortieren Sie nach Neuheit und öffnen Sie die aktuellste Geräte-Genehmigungsmeldung. Klicken Sie einmal auf den Link <strong class='text-white'>Approve</strong>. Erscheint weiterhin &ldquo;This page has not been created,&rdquo; hören Sie mit dem Klicken auf, ein toter Link bringt nichts, und wiederholte Anmeldeversuche können ein temporäres Captcha oder eine Sperre auslösen, die Sie dann erst abwarten müssen." },
        { title: "Fordern Sie die E-Mail über My Devices erneut an", html: "Wenn Sie sich von einem bereits genehmigten Gerät aus anmelden können, nutzen Sie es, um einen neuen Link zu erzwingen: Melden Sie sich auf diesem Gerät bei Tradovate Web an, öffnen Sie <strong class='text-white'>Application Settings</strong> und wählen Sie <strong class='text-white'>My Devices</strong> (jedes Gerät zeigt Name, IP-Adresse, letzten Standort und letzte Anmeldezeit). Finden Sie das neue Gerät mit dem Status <strong class='text-white'>Pending</strong> und klicken Sie auf <strong class='text-white'>Forget</strong>. Das Vergessen eines ausstehenden Geräts löst beim nächsten Anmeldeversuch dieses Geräts eine brandneue Genehmigen/Ablehnen-E-Mail aus. Gehen Sie zurück zum neuen Gerät, starten Sie die Anmeldung erneut, öffnen Sie dann die neue E-Mail und klicken Sie auf <strong class='text-white'>Approve</strong>. Ein neu erzeugter Link funktioniert manchmal dort, wo ein veralteter ins Leere führt; landet auch der neue Link bei &ldquo;not created,&rdquo; haben Sie bestätigt, dass es sich um einen dauerhaften Fehler auf Broker-Seite handelt, und es ist Zeit für den Support." },
      ],
    },
    { type: "heading", text: "Kontaktieren Sie den Tradovate-Support, um das Gerät manuell genehmigen zu lassen" },
    { type: "paragraph", html: "Das ist die Lösung, die einen defekten Link tatsächlich behebt, denn der Support kann Ihr Gerät von seiner Seite aus genehmigen, ohne dass die E-Mail überhaupt funktionieren muss. Erreichen Sie ihn über einen dieser Wege:" },
    {
      type: "table",
      headers: ["Kanal", "Details", "Am besten geeignet für"],
      rows: [
        ["E-Mail", "support@tradovate.com", "Ein schriftlicher Nachweis; fügen Sie einen Screenshot der defekten Seite bei"],
        ["Telefon (allgemein)", "1-844-283-3100", "Das Anliegen während der Support-Zeiten besprechen"],
        ["Telefon (Handelsnotfall)", "(312) 283-3100", "Ausgesperrt sein mit einer offenen Position"],
        ["Live-Chat", "In-App-Chat / Chat auf tradovate.com", "Schneller Austausch"],
        ["Kontaktformular", "Kontaktseite auf support.tradovate.com", "Ein Ticket mit Details protokollieren"],
      ],
    },
    { type: "paragraph", html: "Wenn Sie sich melden, geben Sie von Anfang an alle Informationen mit, damit direkt gehandelt werden kann: die E-Mail-Adresse Ihres Kontos, dass die Zwei-Faktor-Authentifizierung aktiviert ist, dass Sie sich von einem neuen Gerät aus angemeldet haben, und dass der Genehmigungslink &ldquo;This page has not been created&rdquo; zurückgibt. Bitten Sie ausdrücklich darum, <strong class='text-white'>das neue Gerät zu genehmigen</strong>, oder die <strong class='text-white'>2FA vorübergehend zurückzusetzen</strong>, damit Sie sich anmelden und es selbst erneut genehmigen können. Bestätigen Sie die aktuellen Telefonzeiten und Kanäle auf der offiziellen Tradovate-Kontaktseite, da sich Support-Angaben ändern können." },
    { type: "heading", text: "Binden Sie Ihre Prop-Firm ein, falls es sich um ein Evaluierungskonto handelt" },
    { type: "paragraph", html: "Bei einem finanzierten Prop-Firm- oder Evaluierungskonto verwaltet die Firma oft die Kontobeziehung zu Tradovate. Wenn der Tradovate-Support Ihnen mitteilt, dass die Änderung über die Firma laufen muss, oder Sie nicht sicher sind, wer die Kontosteuerungen innehat, eröffnen Sie gleichzeitig ein Ticket bei Ihrer Prop-Firm und erwähnen Sie den defekten Genehmigungslink, damit sich beide Seiten abstimmen können." },
    { type: "heading", text: "Womit Sie keine Zeit verschwenden sollten" },
    { type: "paragraph", html: "Ein defekter Ziellink kümmert sich nicht darum, wie Sie ihn öffnen, überspringen Sie daher Folgendes, bis der Support das Gerät genehmigt hat:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Cache oder Cookies löschen</strong>, ruft keine Seite herbei, die nie veröffentlicht wurde.",
        "<strong class='text-white'>Browser oder Geräte wechseln, um denselben Link anzuklicken</strong>, gleiche tote URL, gleiches Ergebnis.",
        "<strong class='text-white'>Passwort zurücksetzen</strong>, das ist kein Problem mit den Zugangsdaten; es ist ein Problem der Geräte-Genehmigung.",
        "<strong class='text-white'>Wiederholt auf die Anmeldeschaltfläche klicken</strong>, wiederholte Versuche können zusätzlich zu der bereits bestehenden Sperre ein Captcha oder eine temporäre Sperre auslösen.",
      ],
    },
    { type: "heading", text: "Vermeiden Sie Genehmigungen für neue Geräte mit PickMyTrade" },
    { type: "paragraph", html: "Um ehrlich zu sein: Kein Tool eines Drittanbieters kann einen defekten Link innerhalb der eigenen E-Mail von Tradovate reparieren, diese Lösung muss von Tradovate selbst kommen. Was Sie <em>können</em>, ist, seltener in diese Situation zu geraten. Jeder wirklich neue Ursprung, ein neuer Browser, ein neuer VPS, ein anderes Netzwerk, kann als &ldquo;neues Gerät&rdquo; gelten und eine weitere Geräte-Genehmigungs-E-Mail auslösen. Wenn Sie von TradingView aus automatisieren, leitet PickMyTrade Ihre Alerts über eine einzige, stabile Verbindung an Tradovate weiter, sodass Sie die Prüfung für neue Geräte nicht jedes Mal erneut auslösen, wenn Sie den Laptop wechseln oder sich Ihre IP-Adresse ändert." },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Eine durchgängige Verbindung</strong>, Alerts laufen über eine einzige PickMyTrade-Route statt über eine wechselnde Reihe von Geräten, wodurch es von vornherein deutlich weniger zu genehmigen gibt.",
        "<strong class='text-white'>Einmalige Kontoverknüpfung</strong>, verbinden Sie Ihr Tradovate-Konto ein einziges Mal; es gibt keine Browsersitzung, die Sie auf jedem Ihrer Geräte im Blick behalten müssen.",
        "<strong class='text-white'>Live- und Demo-bewusst</strong>, routen Sie genau zum beabsichtigten Konto, was wichtig ist, weil die Geräte-Genehmigung bei Live am strengsten greift.",
        "<strong class='text-white'>Synchronisation mehrerer Konten</strong>, spiegeln Sie einen Alert über mehrere Tradovate-Konten von einer Stelle aus, ohne sich bei jedem einzeln von einem neuen Gerät aus anzumelden.",
      ],
    },
  ], es: [
    { type: "paragraph", html: "Usted activó la autenticación en dos pasos, inició sesión desde un portátil nuevo, y Tradovate le envió un correo para aprobar el dispositivo. Hasta aquí, todo normal. Luego hace clic en el enlace <strong class='text-white'>Approve</strong> de ese correo y, en lugar de una confirmación clara de &ldquo;device approved&rdquo;, llega a una página que dice <strong class='text-white'>&ldquo;This page has not been created yet.&rdquo;</strong> Ahora está atascado: el inicio de sesión permanece en pausa esperando una aprobación que literalmente no puede otorgar, porque el enlace que debería permitírselo está muerto. En resumen: el enlace está roto del lado de Tradovate, usted no puede repararlo desde su extremo, y la solución fiable es que el soporte de Tradovate apruebe su dispositivo manualmente (o restablezca la 2FA). A continuación explicamos cómo confirmar que esto es lo que está ocurriendo, qué vale la pena probar primero, cómo contactar exactamente al soporte, y cómo una conexión automatizada estable como PickMyTrade evita que usted tropiece tan a menudo con esta aprobación de dispositivo nuevo." },
    {
      type: "checklist",
      heading: "Lista rápida para el enlace de aprobación roto",
      items: [
        "<strong class='text-white'>Abra el correo más reciente.</strong> Un enlace de aprobación antiguo o ya utilizado puede no funcionar; asegúrese de hacer clic en el aviso de dispositivo más reciente de Tradovate.",
        "<strong class='text-white'>No siga insistiendo.</strong> Reintentar un enlace muerto o repetir intentos de inicio de sesión una y otra vez puede activar un captcha temporal o un bloqueo adicional.",
        "<strong class='text-white'>Vuelva a generar el correo.</strong> Desde un dispositivo que ya funcione, abra <strong class='text-white'>Application Settings &gt; My Devices</strong>, busque el dispositivo marcado como <strong class='text-white'>Pending</strong> y haga clic en <strong class='text-white'>Forget</strong> para generar un nuevo correo de aprobación.",
        "<strong class='text-white'>Pruebe con un dispositivo ya aprobado.</strong> Si aún puede iniciar sesión desde su computadora anterior, hágalo para seguir operando mientras resuelve el dispositivo nuevo.",
        "<strong class='text-white'>Evite las soluciones que no ayudarán.</strong> Borrar la caché o cambiar de navegador no puede cargar una página que nunca se publicó.",
        "<strong class='text-white'>Contacte directamente al soporte.</strong> Si el enlace sigue roto, contacte a Tradovate para que aprueben el dispositivo o restablezcan la 2FA.",
      ],
    },
    { type: "heading", text: "Qué significa realmente &ldquo;This Page Has Not Been Created&rdquo;" },
    { type: "paragraph", html: "Esto no es un error que provenga de su cuenta, sus credenciales o su navegador. El correo de aprobación de dispositivo contiene un enlace que debería abrir una página en la plataforma web alojada de Tradovate, el mismo sistema que ejecuta su centro de ayuda y su portal. Cuando se le solicita a esa plataforma una página que no está publicada o que ya no existe, devuelve un mensaje genérico similar a <strong class='text-white'>&ldquo;This page has not been created yet&rdquo;</strong> o &ldquo;this page isn't available.&rdquo; En otras palabras, el enlace apunta a un destino que no existe. La pantalla de aprobar/rechazar nunca carga porque, desde el punto de vista del servidor, no hay nada que cargar." },
    { type: "paragraph", html: "Por eso resulta tan frustrante: los reflejos habituales de solución de problemas no sirven. Puede borrar las cookies, abrir una ventana privada, cambiar de Chrome a otro navegador, incluso probar desde su teléfono, y obtendrá la misma página muerta cada vez, porque el problema está en la URL de destino, no en cómo la abre. Es un fallo del lado del bróker, y la conclusión práctica es que no debería perder veinte minutos intentando &ldquo;arreglar su navegador.&rdquo; No se puede reparar un enlace que no lleva a ninguna parte." },
    { type: "paragraph", html: "Mientras tanto, el inicio de sesión que usted comenzó sigue en espera. En una cuenta protegida con 2FA, Tradovate no completa una sesión desde un dispositivo no reconocido hasta que ese dispositivo esté aprobado. Las cuentas reales aplican esto estrictamente, y si usted se conecta a través de TradingView verá el mensaje asociado <strong class='text-white'>&ldquo;You have 2FA enabled and log in from a new machine.&rdquo;</strong> Hasta que el dispositivo esté aprobado, nada se enruta, por lo que vale la pena resolver rápidamente un enlace de aprobación roto en lugar de ignorarlo." },
    { type: "heading", text: "Por qué el enlace se rompe en primer lugar" },
    { type: "heading", text: "1. La página de aprobación a la que apunta el enlace no está activa" },
    { type: "paragraph", html: "El correo es real y el desafío de dispositivo es real, pero la URL que contiene resuelve a una página que la plataforma de alojamiento no sirve. Ese es el núcleo del mensaje &ldquo;not created&rdquo;: un destino faltante, no un clic equivocado de su parte." },
    { type: "heading", text: "2. Hizo clic en un enlace antiguo o ya utilizado" },
    { type: "paragraph", html: "Si intentó iniciar sesión varias veces, es posible que tenga varios correos de aprobación. Hacer clic en uno más antiguo, o en uno cuyo enlace ya se consumió, puede no funcionar. El correo más reciente siempre es el que vale la pena abrir." },
    { type: "heading", text: "3. El correo se filtra, se reenvía o llega a la dirección equivocada" },
    { type: "paragraph", html: "Los correos de aprobación caen en Spam, en Promociones, o en una dirección que usted ya no revisa. Una copia reenviada también puede dañar el enlace. Apruebe desde la bandeja de entrada exacta vinculada a su cuenta de Tradovate, no desde un reenvío o un alias." },
    { type: "heading", text: "4. Está en una cuenta real o de prop firm, que es estricta con la aprobación" },
    { type: "paragraph", html: "Las cuentas reales no permiten en absoluto el paso de un dispositivo no aprobado, por lo que un enlace roto en real es una detención total y no una simple molestia. Si está en una evaluación de prop firm, la firma también puede situarse entre usted y los controles de cuenta de Tradovate, lo que añade una segunda parte que quizás deba ayudar." },
    { type: "heading", text: "Cómo solucionarlo: paso a paso" },
    {
      type: "steps",
      items: [
        { title: "Abra el correo más reciente e inténtelo una vez más", html: "Vuelva a la bandeja de entrada de su cuenta de Tradovate, ordene por fecha más reciente y abra el mensaje de aprobación de dispositivo más nuevo. Haga clic una sola vez en el enlace <strong class='text-white'>Approve</strong>. Si sigue mostrando &ldquo;This page has not been created,&rdquo; deje de hacer clic: repetir un enlace muerto no logra nada, y los intentos repetidos de inicio de sesión pueden activar un captcha temporal o un bloqueo que luego tendrá que esperar." },
        { title: "Vuelva a generar el correo desde My Devices", html: "Si puede iniciar sesión desde un dispositivo ya aprobado, úselo para forzar un enlace nuevo: inicie sesión en Tradovate web en ese dispositivo, abra <strong class='text-white'>Application Settings</strong> y seleccione <strong class='text-white'>My Devices</strong> (cada dispositivo muestra su nombre, dirección IP, última ubicación y hora del último inicio de sesión). Busque el dispositivo nuevo con estado <strong class='text-white'>Pending</strong> y haga clic en <strong class='text-white'>Forget</strong>. Olvidar un dispositivo pendiente activa un correo de aprobar/rechazar completamente nuevo la próxima vez que ese dispositivo intente iniciar sesión. Vuelva al dispositivo nuevo, inicie sesión de nuevo, luego abra el correo reciente y haga clic en <strong class='text-white'>Approve</strong>. Un enlace recién generado a veces funciona donde uno antiguo falla; si el nuevo también termina en &ldquo;not created,&rdquo; usted ha confirmado que se trata de un fallo persistente del lado del bróker y es momento de contactar al soporte." },
      ],
    },
    { type: "heading", text: "Contacte al soporte de Tradovate para aprobar el dispositivo manualmente" },
    { type: "paragraph", html: "Esta es la solución que realmente resuelve un enlace roto, porque el soporte puede aprobar su dispositivo desde su lado sin que usted necesite que el correo funcione. Contáctelos por cualquiera de estos medios:" },
    {
      type: "table",
      headers: ["Canal", "Detalles", "Mejor para"],
      rows: [
        ["Correo electrónico", "support@tradovate.com", "Un registro por escrito; adjunte una captura de la página rota"],
        ["Teléfono (general)", "1-844-283-3100", "Conversar el tema durante el horario de soporte"],
        ["Teléfono (emergencia de trading)", "(312) 283-3100", "Quedar bloqueado con una posición abierta"],
        ["Chat en vivo", "Chat dentro de la app / chat en tradovate.com", "Intercambio rápido"],
        ["Formulario de contacto", "Página de contacto de support.tradovate.com", "Registrar un ticket con detalles"],
      ],
    },
    { type: "paragraph", html: "Al contactarlos, entregue toda la información desde el principio para que puedan actuar en la primera respuesta: la dirección de correo de su cuenta, que la autenticación en dos pasos está activada, que inició sesión desde un dispositivo nuevo, y que el enlace de aprobación devuelve &ldquo;This page has not been created.&rdquo; Pídales claramente que <strong class='text-white'>aprueben el nuevo dispositivo</strong> de su cuenta, o que <strong class='text-white'>restablezcan la 2FA</strong> temporalmente para que usted pueda iniciar sesión y volver a aprobarlo usted mismo. Confirme el horario telefónico y los canales actuales en la página oficial de contacto de Tradovate, ya que los datos de soporte pueden cambiar." },
    { type: "heading", text: "Involucre a su prop firm si se trata de una cuenta de evaluación" },
    { type: "paragraph", html: "En una cuenta financiada o de evaluación de prop firm, la firma suele gestionar la relación de la cuenta con Tradovate. Si el soporte de Tradovate le indica que el cambio debe pasar por la firma, o no está seguro de quién controla la cuenta, abra un ticket con su prop firm al mismo tiempo y mencione el enlace de aprobación roto para que ambas partes puedan coordinarse." },
    { type: "heading", text: "En qué no vale la pena perder tiempo" },
    { type: "paragraph", html: "Un enlace de destino roto no cambia según cómo lo abra, así que evite lo siguiente hasta que el soporte haya aprobado el dispositivo:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Borrar caché o cookies</strong>, no hará aparecer una página que nunca se publicó.",
        "<strong class='text-white'>Cambiar de navegador o dispositivo para hacer clic en el mismo enlace</strong>, misma URL muerta, mismo resultado.",
        "<strong class='text-white'>Restablecer su contraseña</strong>, esto no es un problema de credenciales; es un problema de aprobación de dispositivo.",
        "<strong class='text-white'>Insistir con el botón de inicio de sesión</strong>, los intentos repetidos pueden sumar un captcha o un bloqueo temporal al bloqueo que ya tiene.",
      ],
    },
    { type: "heading", text: "Evite las aprobaciones de dispositivo nuevo con PickMyTrade" },
    { type: "paragraph", html: "Para ser claros: ninguna herramienta de terceros puede reparar un enlace roto dentro del propio correo de Tradovate; esa solución debe venir de Tradovate. Lo que usted <em>sí puede</em> hacer es dejar de caer en esta situación tan a menudo. Cualquier origen genuinamente nuevo, un navegador nuevo, un VPS nuevo, una red diferente, puede leerse como un &ldquo;dispositivo nuevo&rdquo; y desencadenar otro correo de aprobación de dispositivo. Cuando automatiza desde TradingView, PickMyTrade enruta sus alertas hacia Tradovate a través de una única conexión estable, para que usted no vuelva a activar el desafío de dispositivo nuevo cada vez que cambie de portátil o su IP cambie." },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Una conexión constante</strong>, las alertas fluyen a través de una única ruta de PickMyTrade en lugar de un conjunto rotativo de dispositivos, por lo que hay mucho menos que aprobar desde el principio.",
        "<strong class='text-white'>Vinculación de cuenta única</strong>, conecte su cuenta de Tradovate una sola vez; no hay una sesión de navegador que vigilar en cada dispositivo que posea.",
        "<strong class='text-white'>Consciente de real y demo</strong>, enrute exactamente a la cuenta que desea, lo cual importa porque en real es donde la aprobación de dispositivo se aplica con más fuerza.",
        "<strong class='text-white'>Sincronización multicuenta</strong>, replique una alerta en varias cuentas de Tradovate desde un solo lugar, sin iniciar sesión en cada una desde un dispositivo nuevo.",
      ],
    },
  ], fr: [
    { type: "paragraph", html: "Vous vous installez sur un nouvel ordinateur portable, ouvrez un navigateur inédit, ou vous connectez via TradingView, et au lieu de vos graphiques, Tradovate vous envoie un e-mail pour approuver l'appareil. Jusque-là, rien d'anormal. Puis vous cliquez sur le lien <strong class='text-white'>Approve</strong> de cet e-mail et, au lieu d'une confirmation nette &ldquo;device approved&rdquo;, vous atterrissez sur une page qui affiche <strong class='text-white'>&ldquo;This page has not been created yet.&rdquo;</strong> Vous voilà bloqué : la connexion reste en pause, en attente d'une approbation que vous ne pouvez littéralement pas donner, parce que le lien censé vous le permettre est mort. Voici l'essentiel : le lien est cassé du côté de Tradovate, vous ne pouvez pas le réparer de votre côté, et la solution fiable consiste à faire approuver votre appareil manuellement par le support Tradovate (ou à faire réinitialiser la 2FA). Voici comment confirmer que c'est bien ce qui se passe, ce qui vaut la peine d'être essayé en premier, comment contacter précisément le support, et comment une connexion automatisée stable comme PickMyTrade vous évite de déclencher aussi souvent cette approbation de nouvel appareil." },
    {
      type: "checklist",
      heading: "Check-list rapide pour un lien d'approbation cassé",
      items: [
        "<strong class='text-white'>Ouvrez l'e-mail le plus récent.</strong> Un lien d'approbation ancien ou déjà cliqué peut ne mener nulle part ; assurez-vous de cliquer sur l'avis d'appareil le plus récent envoyé par Tradovate.",
        "<strong class='text-white'>Ne cliquez pas dessus en boucle.</strong> Réessayer un lien mort ou multiplier les tentatives de connexion peut déclencher un captcha temporaire ou un blocage supplémentaire.",
        "<strong class='text-white'>Regénérez l'e-mail.</strong> Depuis un appareil qui fonctionne déjà, ouvrez <strong class='text-white'>Application Settings &gt; My Devices</strong>, trouvez l'appareil marqué <strong class='text-white'>Pending</strong> et cliquez sur <strong class='text-white'>Forget</strong> pour déclencher un nouvel e-mail d'approbation.",
        "<strong class='text-white'>Essayez un appareil déjà approuvé.</strong> Si vous pouvez encore vous connecter depuis votre ancien ordinateur, faites-le pour continuer à trader pendant que vous réglez le nouveau.",
        "<strong class='text-white'>Évitez les solutions inutiles.</strong> Vider le cache ou changer de navigateur ne peut pas charger une page qui n'a jamais été publiée.",
        "<strong class='text-white'>Contactez directement le support.</strong> Si le lien reste cassé, contactez Tradovate pour faire approuver l'appareil ou réinitialiser la 2FA de leur côté.",
      ],
    },
    { type: "heading", text: "Ce que signifie réellement &ldquo;This Page Has Not Been Created&rdquo;" },
    { type: "paragraph", html: "Il ne s'agit pas d'une erreur liée à votre compte, à vos identifiants ou à votre navigateur. L'e-mail d'approbation d'appareil contient un lien censé ouvrir une page sur la plateforme web hébergée de Tradovate, le même système qui fait tourner son centre d'aide et son portail. Lorsque cette plateforme reçoit une demande pour une page qui n'est pas publiée ou qui n'existe plus, elle renvoie un message générique du type <strong class='text-white'>&ldquo;This page has not been created yet&rdquo;</strong> ou &ldquo;this page isn't available.&rdquo; Autrement dit, le lien pointe vers une destination qui n'existe pas. L'écran d'approbation/refus ne se charge jamais car, du point de vue du serveur, il n'y a rien à charger." },
    { type: "paragraph", html: "C'est ce qui rend ce cas si frustrant : les réflexes habituels de dépannage ne s'appliquent pas. Vous pouvez vider les cookies, ouvrir une fenêtre privée, passer de Chrome à un autre navigateur, même essayer depuis votre téléphone, vous obtiendrez à chaque fois la même page morte, car le problème vient de l'URL de destination, pas de la façon dont vous l'ouvrez. C'est un dysfonctionnement du côté du courtier, et la conclusion pratique est que vous ne devriez pas perdre vingt minutes à essayer de &ldquo;réparer votre navigateur.&rdquo; On ne peut pas réparer un lien qui ne mène nulle part." },
    { type: "paragraph", html: "Pendant ce temps, la connexion que vous avez lancée reste en attente. Sur un compte protégé par 2FA, Tradovate ne termine pas une session depuis un appareil non reconnu tant que cet appareil n'est pas approuvé. Les comptes réels appliquent cette règle strictement, et si vous passez par TradingView, vous verrez le message associé <strong class='text-white'>&ldquo;You have 2FA enabled and log in from a new machine.&rdquo;</strong> Tant que l'appareil n'est pas approuvé, rien ne s'achemine, c'est pourquoi il vaut la peine de régler rapidement un lien d'approbation cassé plutôt que de l'ignorer." },
    { type: "heading", text: "Pourquoi le lien se casse en premier lieu" },
    { type: "heading", text: "1. La page d'approbation vers laquelle pointe le lien n'est pas en ligne" },
    { type: "paragraph", html: "L'e-mail est réel et la vérification d'appareil est réelle, mais l'URL qu'il contient renvoie vers une page que la plateforme d'hébergement ne sert pas. C'est le cœur du message &ldquo;not created&rdquo;, une destination manquante, et non un mauvais clic de votre part." },
    { type: "heading", text: "2. Vous avez cliqué sur un lien ancien ou déjà utilisé" },
    { type: "paragraph", html: "Si vous avez tenté de vous connecter plusieurs fois, vous avez peut-être reçu plusieurs e-mails d'approbation. Cliquer sur un ancien, ou sur un lien déjà consommé, peut ne mener nulle part. L'e-mail le plus récent est toujours celui qu'il vaut la peine d'ouvrir." },
    { type: "heading", text: "3. L'e-mail est filtré, transféré, ou envoyé à la mauvaise adresse" },
    { type: "paragraph", html: "Les e-mails d'approbation atterrissent dans les Spams, dans Promotions, ou sur une adresse que vous ne consultez plus. Une copie transférée peut aussi corrompre le lien. Approuvez depuis la boîte de réception exacte associée à votre compte Tradovate, pas depuis un transfert ou un alias." },
    { type: "heading", text: "4. Vous êtes sur un compte réel ou de prop firm, strict sur l'approbation" },
    { type: "paragraph", html: "Les comptes réels ne laissent absolument pas passer un appareil non approuvé, un lien cassé sur un compte réel est donc un blocage total et non un simple désagrément. Si vous êtes sur une évaluation de prop firm, la société peut aussi s'interposer entre vous et les contrôles de compte de Tradovate, ce qui ajoute une seconde partie susceptible de devoir intervenir." },
    { type: "heading", text: "Comment résoudre le problème : étape par étape" },
    {
      type: "steps",
      items: [
        { title: "Ouvrez l'e-mail le plus récent et réessayez une fois", html: "Retournez dans la boîte de réception de votre compte Tradovate, triez par date la plus récente, et ouvrez le message d'approbation d'appareil le plus récent. Cliquez une seule fois sur le lien <strong class='text-white'>Approve</strong>. S'il affiche toujours &ldquo;This page has not been created,&rdquo; arrêtez de cliquer : répéter un lien mort ne sert à rien, et des tentatives de connexion répétées peuvent déclencher un captcha temporaire ou un blocage qu'il faudra ensuite attendre." },
        { title: "Regénérez l'e-mail depuis My Devices", html: "Si vous pouvez vous connecter depuis un appareil déjà approuvé, utilisez-le pour forcer un nouveau lien : connectez-vous à Tradovate web sur cet appareil, ouvrez <strong class='text-white'>Application Settings</strong> et sélectionnez <strong class='text-white'>My Devices</strong> (chaque appareil affiche son nom, son adresse IP, sa dernière localisation et sa dernière heure de connexion). Trouvez le nouvel appareil affichant le statut <strong class='text-white'>Pending</strong> et cliquez sur <strong class='text-white'>Forget</strong>. Oublier un appareil en attente déclenche un tout nouvel e-mail d'approbation/refus lors de la prochaine tentative de connexion de cet appareil. Retournez sur le nouvel appareil, relancez la connexion, puis ouvrez le nouvel e-mail et cliquez sur <strong class='text-white'>Approve</strong>. Un lien nouvellement généré fonctionne parfois là où un lien périmé échoue ; si le nouveau atterrit aussi sur &ldquo;not created,&rdquo; vous avez confirmé qu'il s'agit d'un dysfonctionnement persistant côté courtier, et il est temps de contacter le support." },
      ],
    },
    { type: "heading", text: "Contactez le support Tradovate pour faire approuver l'appareil manuellement" },
    { type: "paragraph", html: "C'est la solution qui résout réellement un lien cassé, car le support peut approuver votre appareil de son côté sans que l'e-mail ait besoin de fonctionner. Contactez-les via l'un de ces moyens :" },
    {
      type: "table",
      headers: ["Canal", "Détails", "Idéal pour"],
      rows: [
        ["E-mail", "support@tradovate.com", "Une trace écrite ; joignez une capture d'écran de la page cassée"],
        ["Téléphone (général)", "1-844-283-3100", "Discuter du problème pendant les heures de support"],
        ["Téléphone (urgence trading)", "(312) 283-3100", "Être bloqué avec une position ouverte"],
        ["Chat en direct", "Chat intégré à l'app / chat sur tradovate.com", "Échange rapide"],
        ["Formulaire de contact", "Page de contact sur support.tradovate.com", "Enregistrer un ticket détaillé"],
      ],
    },
    { type: "paragraph", html: "Lorsque vous les contactez, donnez-leur d'emblée toutes les informations afin qu'ils puissent agir dès la première réponse : l'adresse e-mail de votre compte, le fait que la double authentification est activée, que vous vous êtes connecté depuis un nouvel appareil, et que le lien d'approbation renvoie &ldquo;This page has not been created.&rdquo; Demandez-leur clairement d'<strong class='text-white'>approuver le nouvel appareil</strong> pour votre compte, ou de <strong class='text-white'>réinitialiser la 2FA</strong> temporairement pour que vous puissiez vous connecter et l'approuver vous-même. Confirmez les horaires téléphoniques et les canaux actuels sur la page de contact officielle de Tradovate, car les informations de support peuvent changer." },
    { type: "heading", text: "Impliquez votre prop firm s'il s'agit d'un compte d'évaluation" },
    { type: "paragraph", html: "Sur un compte financé ou en évaluation chez une prop firm, c'est souvent la société qui gère la relation de compte avec Tradovate. Si le support Tradovate vous indique que la modification doit passer par la société, ou si vous ne savez pas qui détient les contrôles du compte, ouvrez un ticket auprès de votre prop firm en parallèle et mentionnez le lien d'approbation cassé afin que les deux parties puissent se coordonner." },
    { type: "heading", text: "Ce sur quoi il ne faut pas perdre de temps" },
    { type: "paragraph", html: "Un lien de destination cassé reste cassé quelle que soit la manière dont vous l'ouvrez, évitez donc ceci tant que le support n'a pas approuvé l'appareil :" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Vider le cache ou les cookies</strong>, ne fera pas apparaître une page qui n'a jamais été publiée.",
        "<strong class='text-white'>Changer de navigateur ou d'appareil pour cliquer sur le même lien</strong>, même URL morte, même résultat.",
        "<strong class='text-white'>Réinitialiser votre mot de passe</strong>, ce n'est pas un problème d'identifiants ; c'est un problème d'approbation d'appareil.",
        "<strong class='text-white'>Marteler le bouton de connexion</strong>, des tentatives répétées peuvent ajouter un captcha ou un blocage temporaire au blocage déjà en place.",
      ],
    },
    { type: "heading", text: "Évitez de déclencher les approbations de nouvel appareil avec PickMyTrade" },
    { type: "paragraph", html: "Pour être franc : aucun outil tiers ne peut réparer un lien cassé dans l'e-mail même de Tradovate, cette solution doit venir de Tradovate. Ce que vous <em>pouvez</em> faire, c'est éviter de vous retrouver aussi souvent dans cette situation. Toute origine vraiment nouvelle, un navigateur inédit, un nouveau VPS, un réseau différent, peut être perçue comme un &ldquo;nouvel appareil&rdquo; et déclencher un nouvel e-mail d'approbation d'appareil. Lorsque vous automatisez depuis TradingView, PickMyTrade achemine vos alertes vers Tradovate via une seule connexion stable, afin que vous ne redéclenchiez pas le défi du nouvel appareil à chaque changement d'ordinateur portable ou d'adresse IP." },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Une connexion cohérente et unique</strong>, les alertes circulent via une seule route PickMyTrade au lieu d'un ensemble tournant d'appareils, ce qui laisse bien moins de choses à approuver dès le départ.",
        "<strong class='text-white'>Liaison de compte à configurer une seule fois</strong>, connectez votre compte Tradovate une seule fois ; aucune session de navigateur à surveiller sur chaque appareil que vous possédez.",
        "<strong class='text-white'>Conscient du réel et de la démo</strong>, l'acheminement se fait exactement vers le compte visé, ce qui compte car c'est sur le réel que l'approbation d'appareil est appliquée le plus strictement.",
        "<strong class='text-white'>Synchronisation multi-comptes</strong>, dupliquez une même alerte sur plusieurs comptes Tradovate depuis un seul endroit, sans avoir à connecter chacun depuis un nouvel appareil.",
      ],
    },
  ], it: [
    { type: "paragraph", html: "Lei si siede a un nuovo laptop, apre un browser mai usato prima, o si collega tramite TradingView, e invece dei Suoi grafici si trova davanti a un muro: Tradovate Le invia un'e-mail per approvare il dispositivo. Fin qui, tutto normale. Poi clicca sul link <strong class='text-white'>Approve</strong> in quell'e-mail e, invece di una chiara conferma &ldquo;device approved&rdquo;, atterra su una pagina che recita <strong class='text-white'>&ldquo;This page has not been created yet.&rdquo;</strong> A questo punto è bloccato: l'accesso resta in pausa in attesa di un'approvazione che letteralmente non può concedere, perché il link che dovrebbe permetterglielo è morto. In breve: il link è danneggiato lato Tradovate, non può ripararlo dal Suo lato, e la soluzione affidabile è far approvare manualmente il dispositivo dal supporto Tradovate (o far reimpostare la 2FA). Di seguito spieghiamo come confermare che sia proprio questo il problema, cosa vale la pena provare per prima cosa, come contattare esattamente il supporto, e come una connessione automatizzata stabile come PickMyTrade Le eviti di incappare così spesso in questa approvazione per nuovo dispositivo." },
    {
      type: "checklist",
      heading: "Checklist rapida per il link di approvazione danneggiato",
      items: [
        "<strong class='text-white'>Apra l'e-mail più recente.</strong> Un link di approvazione vecchio o già cliccato può non funzionare; si assicuri di cliccare sull'avviso dispositivo più recente inviato da Tradovate.",
        "<strong class='text-white'>Non continui a cliccarci sopra.</strong> Ritentare un link non funzionante o ripetere i tentativi di accesso più volte può attivare un captcha temporaneo o un blocco aggiuntivo.",
        "<strong class='text-white'>Rigeneri l'e-mail.</strong> Da un dispositivo che già funziona, apra <strong class='text-white'>Application Settings &gt; My Devices</strong>, trovi il dispositivo con stato <strong class='text-white'>Pending</strong> e clicchi su <strong class='text-white'>Forget</strong> per inviare una nuova e-mail di approvazione.",
        "<strong class='text-white'>Provi con un dispositivo già approvato.</strong> Se può ancora accedere dal vecchio computer, lo faccia per continuare a operare mentre risolve il problema con il nuovo dispositivo.",
        "<strong class='text-white'>Eviti le soluzioni inutili.</strong> Svuotare la cache o cambiare browser non può caricare una pagina che non è mai stata pubblicata.",
        "<strong class='text-white'>Si rivolga direttamente al supporto.</strong> Se il link resta danneggiato, contatti Tradovate perché approvi il dispositivo o reimposti la 2FA dal loro lato.",
      ],
    },
    { type: "heading", text: "Cosa significa realmente &ldquo;This Page Has Not Been Created&rdquo;" },
    { type: "paragraph", html: "Non si tratta di un errore legato al Suo account, alle Sue credenziali o al Suo browser. L'e-mail di approvazione del dispositivo contiene un link che dovrebbe aprire una pagina sulla piattaforma web ospitata di Tradovate, lo stesso sistema che gestisce il centro assistenza e il portale. Quando a questa piattaforma viene richiesta una pagina non pubblicata o non più esistente, restituisce un messaggio generico simile a <strong class='text-white'>&ldquo;This page has not been created yet&rdquo;</strong> oppure &ldquo;this page isn't available.&rdquo; In altre parole, il link punta a una destinazione inesistente. La schermata di approvazione/rifiuto non si carica mai perché, dal punto di vista del server, non c'è nulla da caricare." },
    { type: "paragraph", html: "Ecco perché questo caso è così frustrante: i soliti riflessi di risoluzione dei problemi non funzionano. Può svuotare i cookie, aprire una finestra privata, passare da Chrome a un altro browser, persino provare dal telefono, e otterrà sempre la stessa pagina inesistente, perché il problema riguarda l'URL di destinazione, non il modo in cui la apre. È un malfunzionamento lato broker, e la conclusione pratica è che non dovrebbe perdere venti minuti cercando di &ldquo;riparare il browser.&rdquo; Non si può riparare un link che non porta da nessuna parte." },
    { type: "paragraph", html: "Nel frattempo, l'accesso che ha avviato resta in attesa. Su un account protetto da 2FA, Tradovate non completa una sessione da un dispositivo non riconosciuto finché quel dispositivo non viene approvato. Gli account reali applicano questa regola con rigore, e se si collega tramite TradingView vedrà il messaggio associato <strong class='text-white'>&ldquo;You have 2FA enabled and log in from a new machine.&rdquo;</strong> Finché il dispositivo non è approvato, nulla viene instradato, motivo per cui vale la pena risolvere rapidamente un link di approvazione danneggiato invece di ignorarlo." },
    { type: "heading", text: "Perché il link si danneggia in primo luogo" },
    { type: "heading", text: "1. La pagina di approvazione a cui punta il link non è attiva" },
    { type: "paragraph", html: "L'e-mail è reale e la verifica del dispositivo è reale, ma l'URL al suo interno rimanda a una pagina che la piattaforma di hosting non serve. Questo è il nocciolo del messaggio &ldquo;not created&rdquo;, una destinazione mancante, non un clic sbagliato da parte Sua." },
    { type: "heading", text: "2. Ha cliccato su un link vecchio o già utilizzato" },
    { type: "paragraph", html: "Se ha tentato l'accesso più volte, potrebbe avere diverse e-mail di approvazione. Cliccare su una più vecchia, o su una il cui link è già stato consumato, può non funzionare. L'e-mail più recente è sempre quella che vale la pena aprire." },
    { type: "heading", text: "3. L'e-mail viene filtrata, inoltrata o inviata all'indirizzo sbagliato" },
    { type: "paragraph", html: "Le e-mail di approvazione finiscono nello Spam, nelle Promozioni, o su un indirizzo che non controlla più. Anche una copia inoltrata può danneggiare il link. Approvi dalla casella di posta esatta collegata al Suo account Tradovate, non da un inoltro o da un alias." },
    { type: "heading", text: "4. Si trova su un account reale o di prop firm, che è rigoroso sull'approvazione" },
    { type: "paragraph", html: "Gli account reali non lasciano passare in alcun modo un dispositivo non approvato, quindi un link danneggiato su un account reale è un blocco totale e non un semplice fastidio. Se si trova su una valutazione di prop firm, l'azienda potrebbe anche frapporsi tra Lei e i controlli dell'account Tradovate, aggiungendo una seconda parte che potrebbe dover intervenire." },
    { type: "heading", text: "Come risolvere il problema: passo dopo passo" },
    {
      type: "steps",
      items: [
        { title: "Apra l'e-mail più recente e riprovi una volta", html: "Torni alla casella di posta del Suo account Tradovate, ordini per data più recente e apra il messaggio di approvazione dispositivo più recente. Clicchi una sola volta sul link <strong class='text-white'>Approve</strong>. Se continua a mostrare &ldquo;This page has not been created,&rdquo; smetta di cliccare: ripetere un link non funzionante non serve a nulla, e i tentativi di accesso ripetuti possono attivare un captcha temporaneo o un blocco che poi dovrà attendere." },
        { title: "Rigeneri l'e-mail da My Devices", html: "Se può accedere da un dispositivo già approvato, lo usi per forzare un nuovo link: acceda a Tradovate web su quel dispositivo, apra <strong class='text-white'>Application Settings</strong> e selezioni <strong class='text-white'>My Devices</strong> (ogni dispositivo mostra nome, indirizzo IP, ultima posizione e ultimo orario di accesso). Trovi il nuovo dispositivo con stato <strong class='text-white'>Pending</strong> e clicchi su <strong class='text-white'>Forget</strong>. Dimenticare un dispositivo in sospeso genera una nuova e-mail di approvazione/rifiuto al prossimo tentativo di accesso di quel dispositivo. Torni al nuovo dispositivo, avvii di nuovo l'accesso, poi apra la nuova e-mail e clicchi su <strong class='text-white'>Approve</strong>. Un link appena generato a volte funziona dove uno vecchio non funziona; se anche il nuovo finisce su &ldquo;not created,&rdquo; ha confermato che si tratta di un malfunzionamento persistente lato broker ed è il momento di contattare il supporto." },
      ],
    },
    { type: "heading", text: "Contatti il supporto Tradovate per approvare manualmente il dispositivo" },
    { type: "paragraph", html: "Questa è la soluzione che risolve davvero un link danneggiato, perché il supporto può approvare il Suo dispositivo dal proprio lato senza che l'e-mail debba funzionare. Li contatti tramite uno di questi canali:" },
    {
      type: "table",
      headers: ["Canale", "Dettagli", "Ideale per"],
      rows: [
        ["E-mail", "support@tradovate.com", "Una traccia scritta; allegare uno screenshot della pagina danneggiata"],
        ["Telefono (generale)", "1-844-283-3100", "Discutere la questione durante l'orario di supporto"],
        ["Telefono (emergenza di trading)", "(312) 283-3100", "Essere bloccati con una posizione aperta"],
        ["Chat dal vivo", "Chat nell'app / chat su tradovate.com", "Scambio rapido"],
        ["Modulo di contatto", "Pagina di contatto su support.tradovate.com", "Registrare un ticket con i dettagli"],
      ],
    },
    { type: "paragraph", html: "Quando li contatta, fornisca subito tutte le informazioni così che possano agire già dalla prima risposta: l'indirizzo e-mail del Suo account, il fatto che l'autenticazione a due fattori è attiva, che ha effettuato l'accesso da un nuovo dispositivo, e che il link di approvazione restituisce &ldquo;This page has not been created.&rdquo; Chieda esplicitamente di <strong class='text-white'>approvare il nuovo dispositivo</strong> per il Suo account, oppure di <strong class='text-white'>reimpostare la 2FA</strong> temporaneamente così da poter accedere e riapprovarlo Lei stesso. Confermi gli orari telefonici e i canali attuali sulla pagina di contatto ufficiale di Tradovate, poiché i dettagli del supporto possono cambiare." },
    { type: "heading", text: "Coinvolga la Sua prop firm se si tratta di un account di valutazione" },
    { type: "paragraph", html: "Su un account finanziato o di valutazione di una prop firm, spesso è l'azienda a gestire il rapporto dell'account con Tradovate. Se il supporto Tradovate Le comunica che la modifica deve passare attraverso l'azienda, o non è sicuro di chi detenga i controlli dell'account, apra contemporaneamente un ticket con la Sua prop firm e menzioni il link di approvazione danneggiato, così che le due parti possano coordinarsi." },
    { type: "heading", text: "Su cosa non vale la pena perdere tempo" },
    { type: "paragraph", html: "Un link di destinazione danneggiato resta tale indipendentemente da come lo apre, quindi eviti quanto segue finché il supporto non ha approvato il dispositivo:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Svuotare cache o cookie</strong>, non farà comparire una pagina che non è mai stata pubblicata.",
        "<strong class='text-white'>Cambiare browser o dispositivo per cliccare lo stesso link</strong>, stesso URL inesistente, stesso risultato.",
        "<strong class='text-white'>Reimpostare la password</strong>, non è un problema di credenziali; è un problema di approvazione del dispositivo.",
        "<strong class='text-white'>Insistere sul pulsante di accesso</strong>, i tentativi ripetuti possono aggiungere un captcha o un blocco temporaneo al blocco già presente.",
      ],
    },
    { type: "heading", text: "Eviti le approvazioni per nuovo dispositivo con PickMyTrade" },
    { type: "paragraph", html: "Per essere chiari: nessuno strumento di terze parti può riparare un link danneggiato all'interno della stessa e-mail di Tradovate, quella soluzione deve arrivare da Tradovate. Ciò che <em>può</em> fare è smettere di trovarsi così spesso in questa situazione. Qualsiasi origine autenticamente nuova, un browser mai usato, un nuovo VPS, una rete diversa, può essere letta come un &ldquo;nuovo dispositivo&rdquo; e far scattare un'altra e-mail di approvazione dispositivo. Quando automatizza da TradingView, PickMyTrade instrada i Suoi avvisi verso Tradovate tramite un'unica connessione stabile, così da non far scattare di nuovo la verifica per nuovo dispositivo ogni volta che cambia laptop o il Suo IP cambia." },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Una connessione unica e costante</strong>, gli avvisi passano attraverso un'unica rotta PickMyTrade invece di un gruppo rotante di dispositivi, così c'è molto meno da approvare fin dall'inizio.",
        "<strong class='text-white'>Collegamento account da configurare una sola volta</strong>, colleghi il Suo account Tradovate una sola volta; nessuna sessione del browser da tenere sotto controllo su ogni dispositivo posseduto.",
        "<strong class='text-white'>Attento a reale e demo</strong>, instrada esattamente verso l'account desiderato, il che conta perché è sul reale che l'approvazione del dispositivo viene applicata con più rigore.",
        "<strong class='text-white'>Sincronizzazione multi-account</strong>, replichi un avviso su più account Tradovate da un unico punto, senza dover accedere a ciascuno da un nuovo dispositivo.",
      ],
    },
  ] },
  ctaHeading: { en: "Link Your Alerts Once, Stop Re-Approving Machines", de: "Verknüpfen Sie Ihre Alerts einmalig, hören Sie auf, Geräte erneut zu genehmigen", es: "Vincule sus alertas una vez, deje de volver a aprobar dispositivos", fr: "Liez vos alertes une fois, arrêtez de réapprouver des appareils", it: "Colleghi i Suoi avvisi una volta, smetta di riapprovare dispositivi" },
  ctaText: { en: "PickMyTrade routes your TradingView alerts to Tradovate over one steady connection, so switching devices or networks doesn't keep re-triggering the new-machine approval email.", de: "PickMyTrade leitet Ihre TradingView-Alerts über eine stabile Verbindung an Tradovate weiter, sodass ein Wechsel von Gerät oder Netzwerk nicht ständig die Genehmigungs-E-Mail für neue Geräte auslöst.", es: "PickMyTrade enruta sus alertas de TradingView hacia Tradovate a través de una conexión estable, para que cambiar de dispositivo o de red no siga activando el correo de aprobación de dispositivo nuevo.", fr: "PickMyTrade achemine vos alertes TradingView vers Tradovate via une connexion stable et unique, afin que changer d'appareil ou de réseau ne redéclenche pas sans cesse l'e-mail d'approbation de nouvel appareil.", it: "PickMyTrade instrada i Suoi avvisi TradingView verso Tradovate tramite un'unica connessione stabile, così che cambiare dispositivo o rete non faccia scattare di continuo l'e-mail di approvazione per nuovo dispositivo." },
  ctaButtonText: { en: "Start Your Free 7-Day Trial", de: "Starten Sie Ihre kostenlose 5-Tage-Testversion", es: "Comience su prueba gratuita de 5 días", fr: "Démarrez votre essai gratuit de 5 jours", it: "Inizi la Sua prova gratuita di 5 giorni" },
  ctaUrl: "https://app.pickmytrade.trade/?register=true&utm_source=content&utm_medium=debugging",
  faqHeading: { en: "Frequently Asked Questions", de: "Häufig gestellte Fragen", es: "Preguntas frecuentes", fr: "Questions fréquentes", it: "Domande frequenti" },
  faqs: { en: [
    { q: "Why does the Tradovate device-approval link show “This page has not been created”?", a: "The approval link points to a page on Tradovate's hosted web platform that isn't live, so the platform returns its generic missing-page message instead of an approve/deny screen. It's a broken link on Tradovate's side, not a problem with your password, browser, or account balance." },
    { q: "Is the 2FA email a scam if the link is dead?", a: "Not necessarily. A device-approval email is expected when 2FA is on and you sign in from a new machine. Confirm it went to the exact address on your Tradovate account and that the sender is a genuine Tradovate address. If anything looks off, don't click further and reach Tradovate through the official channels on tradovate.com instead." },
    { q: "Can I fix the broken approval link myself?", a: "No. If the destination page doesn't exist, clearing cache, switching browsers, or retrying the same link won't help, because there's nothing to load. Generate a fresh email by forgetting the pending device, and if the new link also fails, contact Tradovate support to approve the device manually." },
    { q: "How do I get Tradovate to approve my device manually?", a: "Email support@tradovate.com, call 1-844-283-3100, use in-app live chat, or file a ticket through the contact form at support.tradovate.com. Give them your account email, tell them 2FA is enabled and you logged in from a new machine, and state that the approval link returns “This page has not been created.” Ask them to approve the device or reset 2FA on their side." },
    { q: "Will trying a different browser or clearing cache fix the error?", a: "Usually not. Those steps help when a page loads badly, but here the page the link points to isn't published at all. The one thing worth trying is opening the newest approval email, since an old or already-used link can dead-end where a fresh one might work." },
    { q: "Can I just turn off 2FA to get past the broken link?", a: "You can ask support to disable or reset 2FA so you can log in, but leaving it off weakens security on a funded live account. The better outcome is to have support approve your device with 2FA still on, or re-enable it once you're back in." },
    { q: "My orders won't route until the device is approved. What about open positions?", a: "Until the device is approved, the blocked session can't place or manage orders. If you have exposure, try logging in from a device that's already approved, and use the phone support line, the trade emergency number exists for exactly this, to flatten or manage the position while you're locked out." },
  ], de: [
    { q: "Why does the Tradovate device-approval link show “This page has not been created”?", a: "Der Genehmigungslink verweist auf eine Seite der gehosteten Web-Plattform von Tradovate, die nicht live ist, weshalb die Plattform ihre generische Meldung für fehlende Seiten statt eines Genehmigen/Ablehnen-Bildschirms zurückgibt. Es handelt sich um einen defekten Link auf Seiten von Tradovate, kein Problem mit Ihrem Passwort, Browser oder Kontostand." },
    { q: "Is the 2FA email a scam if the link is dead?", a: "Nicht unbedingt. Eine Geräte-Genehmigungs-E-Mail ist zu erwarten, wenn 2FA aktiviert ist und Sie sich von einem neuen Gerät aus anmelden. Bestätigen Sie, dass sie an die exakte Adresse Ihres Tradovate-Kontos ging und dass der Absender eine echte Tradovate-Adresse ist. Wirkt etwas verdächtig, klicken Sie nicht weiter und wenden Sie sich stattdessen über die offiziellen Kanäle auf tradovate.com an Tradovate." },
    { q: "Can I fix the broken approval link myself?", a: "Nein. Existiert die Zielseite nicht, helfen Cache leeren, Browser wechseln oder erneutes Anklicken desselben Links nicht, weil es nichts zu laden gibt. Erzeugen Sie eine neue E-Mail, indem Sie das ausstehende Gerät vergessen, und schlägt auch der neue Link fehl, kontaktieren Sie den Tradovate-Support, um das Gerät manuell genehmigen zu lassen." },
    { q: "How do I get Tradovate to approve my device manually?", a: "Schreiben Sie eine E-Mail an support@tradovate.com, rufen Sie 1-844-283-3100 an, nutzen Sie den In-App-Live-Chat oder reichen Sie ein Ticket über das Kontaktformular auf support.tradovate.com ein. Geben Sie Ihre Konto-E-Mail an, teilen Sie mit, dass 2FA aktiviert ist und Sie sich von einem neuen Gerät aus angemeldet haben, und erklären Sie, dass der Genehmigungslink &ldquo;This page has not been created&rdquo; zurückgibt. Bitten Sie darum, das Gerät zu genehmigen oder die 2FA auf ihrer Seite zurückzusetzen." },
    { q: "Will trying a different browser or clearing cache fix the error?", a: "In der Regel nicht. Diese Schritte helfen, wenn eine Seite fehlerhaft lädt, hier jedoch ist die Seite, auf die der Link zeigt, überhaupt nicht veröffentlicht. Das Einzige, was sich zu versuchen lohnt, ist das Öffnen der neuesten Genehmigungs-E-Mail, da ein alter oder bereits verwendeter Link ins Leere führen kann, während ein neuer funktionieren könnte." },
    { q: "Can I just turn off 2FA to get past the broken link?", a: "Sie können den Support bitten, die 2FA zu deaktivieren oder zurückzusetzen, damit Sie sich anmelden können, aber das schwächt die Sicherheit eines finanzierten Live-Kontos. Besser ist es, den Support Ihr Gerät bei weiterhin aktiver 2FA genehmigen zu lassen oder sie wieder zu aktivieren, sobald Sie zurück sind." },
    { q: "My orders won't route until the device is approved. What about open positions?", a: "Solange das Gerät nicht genehmigt ist, kann die blockierte Sitzung keine Orders platzieren oder verwalten. Bei bestehendem Exposure versuchen Sie, sich von einem bereits genehmigten Gerät aus anzumelden, und nutzen Sie die telefonische Support-Nummer, die Notfallnummer existiert genau für solche Fälle, um die Position während der Sperre zu glattzustellen oder zu verwalten." },
  ], es: [
    { q: "Why does the Tradovate device-approval link show “This page has not been created”?", a: "El enlace de aprobación apunta a una página de la plataforma web alojada de Tradovate que no está activa, por lo que la plataforma devuelve su mensaje genérico de página faltante en lugar de una pantalla de aprobar/rechazar. Es un enlace roto del lado de Tradovate, no un problema con su contraseña, su navegador o el saldo de su cuenta." },
    { q: "Is the 2FA email a scam if the link is dead?", a: "No necesariamente. Un correo de aprobación de dispositivo es esperable cuando la 2FA está activa y usted inicia sesión desde un dispositivo nuevo. Confirme que llegó a la dirección exacta de su cuenta de Tradovate y que el remitente es una dirección genuina de Tradovate. Si algo parece sospechoso, no siga haciendo clic y contacte a Tradovate por los canales oficiales en tradovate.com." },
    { q: "Can I fix the broken approval link myself?", a: "No. Si la página de destino no existe, borrar la caché, cambiar de navegador o reintentar el mismo enlace no ayudará, porque no hay nada que cargar. Genere un correo nuevo olvidando el dispositivo pendiente, y si el nuevo enlace también falla, contacte al soporte de Tradovate para que aprueben el dispositivo manualmente." },
    { q: "How do I get Tradovate to approve my device manually?", a: "Escriba a support@tradovate.com, llame al 1-844-283-3100, use el chat en vivo dentro de la app, o presente un ticket a través del formulario de contacto en support.tradovate.com. Indíqueles el correo de su cuenta, cuénteles que la 2FA está activa y que inició sesión desde un dispositivo nuevo, y explique que el enlace de aprobación devuelve &ldquo;This page has not been created.&rdquo; Pídales que aprueben el dispositivo o que restablezcan la 2FA de su lado." },
    { q: "Will trying a different browser or clearing cache fix the error?", a: "Por lo general no. Esos pasos ayudan cuando una página carga mal, pero aquí la página a la que apunta el enlace no está publicada en absoluto. Lo único que vale la pena probar es abrir el correo de aprobación más reciente, ya que un enlace antiguo o ya utilizado puede fallar donde uno nuevo podría funcionar." },
    { q: "Can I just turn off 2FA to get past the broken link?", a: "Puede pedirle al soporte que desactive o restablezca la 2FA para poder iniciar sesión, pero dejarla desactivada debilita la seguridad de una cuenta real financiada. Lo mejor es que el soporte apruebe su dispositivo con la 2FA aún activa, o volver a activarla una vez que haya recuperado el acceso." },
    { q: "My orders won't route until the device is approved. What about open positions?", a: "Hasta que el dispositivo esté aprobado, la sesión bloqueada no puede colocar ni gestionar órdenes. Si tiene exposición, intente iniciar sesión desde un dispositivo ya aprobado, y use la línea telefónica de soporte, el número de emergencia de trading existe precisamente para esto, para cerrar o gestionar la posición mientras está bloqueado." },
