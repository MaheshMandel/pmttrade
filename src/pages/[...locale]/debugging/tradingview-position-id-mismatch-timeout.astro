import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "tradingview-position-id-mismatch-timeout";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/debugging/${SLUG}`;

const META_TITLE = "TradingView-Tradovate 'Position Closing Timeout'";
const META_DESCRIPTION =
  "Position closing timeout on TradingView with Tradovate? Force a full order and position refetch to clear ID mismatches and exit trades fast.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate API", de: "Tradovate API", es: "Tradovate API", fr: "Tradovate API", it: "Tradovate API" },
  h1: { en: META_TITLE, de: "TradingView–Tradovate: Fehler „Position Closing Timeout“", es: "TradingView–Tradovate: error «Position Closing Timeout»", fr: "TradingView–Tradovate : erreur « Position Closing Timeout »", it: "TradingView–Tradovate: errore «Position Closing Timeout»" },
  dek: { en: "You click close and get a red 'Position closing timeout' instead of a flat position. Here's what the error actually means, why order and position IDs drift out of sync, and how to force a clean refetch.", de: "Sie klicken auf Schließen und erhalten ein rotes 'Position closing timeout' statt einer glatten Position. Hier erfahren Sie, was der Fehler tatsächlich bedeutet, warum Order- und Positions-IDs auseinanderlaufen und wie Sie einen sauberen Neuabruf erzwingen.", es: "Hace clic en cerrar y obtiene un 'Position closing timeout' en rojo en lugar de una posición plana. Esto es lo que significa realmente el error, por qué los ID de órdenes y posiciones se desincronizan y cómo forzar una recarga limpia.", fr: "Vous cliquez sur fermer et obtenez un 'Position closing timeout' en rouge au lieu d'une position à plat. Voici ce que signifie réellement cette erreur, pourquoi les identifiants d'ordre et de position se désynchronisent, et comment forcer une récupération propre.", it: "Clicca su chiudi e ottiene un 'Position closing timeout' rosso invece di una posizione flat. Ecco cosa significa davvero l'errore, perché gli ID di ordini e posizioni si sfasano e come forzare un recupero pulito." },
  readTime: { en: "7 min read", de: "7 Min. Lesezeit", es: "Lectura de 7 min", fr: "Lecture : 7 min", it: "Lettura di 7 min" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "When you're managing a live futures position straight off a TradingView chart wired to Tradovate, the exit button is supposed to be instant. One click and you're flat. So it rattles you when you click it and, instead of flattening, a red error slides in: <strong class='text-white'>\"Position closing timeout.\"</strong> Maybe the trade already closed on Tradovate's side. Maybe it didn't. And for the next several seconds on a fast contract like ES or NQ, you genuinely don't know whether you're still holding size. The same failure shows up in other disguises too: an order fires but the chart still shows the position open, a position ID that no longer matches, a close button that does nothing. Almost all of it traces back to one root cause. TradingView's chart and Tradovate's backend have drifted out of sync on order and position state. Here's what the timeout actually means, what causes the ID mismatch behind it, and how to force a clean refetch so you can get out with confidence." },
    {
      type: "checklist",
      heading: "Quick Checklist for a Position Closing Timeout",
      items: [
        "<strong class='text-white'>Check Tradovate directly before you react.</strong> Open the Positions/Orders panel in the Tradovate web trader. The timeout is a confirmation failure, so your real position there is the source of truth, not the chart.",
        "<strong class='text-white'>Don't spam the exit button.</strong> Repeated close clicks can stack duplicate orders once the connection catches up. Click once, then verify.",
        "<strong class='text-white'>Reconnect the broker session in TradingView.</strong> Disconnecting and reconnecting the Tradovate account forces the chart to reload the full order and position list from scratch.",
        "<strong class='text-white'>Suspect an ID mismatch.</strong> If the chart shows a position or order that Tradovate no longer has (or the reverse), the two sides are referencing different IDs and need a full refetch, not a nudge.",
        "<strong class='text-white'>For integrators and bridges:</strong> call <code>ordersFullUpdate</code> and <code>positionsFullUpdate</code> to clear cached state and refetch, but only as an edge-case recovery, never on every update.",
        "<strong class='text-white'>Keep a manual flatten path ready.</strong> Know how to place an opposite market order or use Tradovate's own flatten control if the chart won't close the trade.",
      ],
    },
    { type: "heading", text: "What “Position Closing Timeout” Means" },
    { type: "paragraph", html: "Trading directly from a TradingView chart runs on TradingView's <strong class='text-white'>Broker API</strong>, a two-way contract between the chart and whatever backend is connected (here, Tradovate through the official integration). When you close a position, the library calls the integration's <code>closePosition</code> method and then waits for a confirmation that the position's <code>id</code> now has a quantity of <code>0</code>. Per TradingView's Broker API documentation, the library waits <strong class='text-white'>up to about 10 seconds</strong> for that confirmation to come back through the Trading Host. If no matching <code>positionUpdate</code> shows up in that window, the library gives up and throws the error you're staring at: <strong class='text-white'>\"Failed to close position: Position closing timeout.\"</strong>" },
    { type: "paragraph", html: "Here's the nuance that matters. The timeout describes the <em>confirmation</em>, not necessarily the <em>order</em>. Tradovate may have already flattened the position; TradingView simply never heard back in time. A lagging feed, a dropped session, or a heavy modify/cancel burst can all swallow that confirmation. That's exactly why your first move is always to check the true state on Tradovate rather than click close again. The order side of chart trading uses the same roughly 10-second window, so placing or modifying an order can throw an equivalent timeout." },
    { type: "paragraph", html: "A related and nastier variant is an outright <strong class='text-white'>ID mismatch</strong>. TradingView tracks every order and position by an <code>id</code> the integration hands it. If that backend <code>id</code> changes between when the request is submitted and when it's processed, the library ends up pointing at an <code>id</code> that no longer exists. So close and modify requests reference stale data and quietly fail, and the UI shows orders or positions that don't line up with the account. TradingView's documentation calls this out directly and gives a specific recovery path for it." },
    { type: "heading", text: "Top Causes of a TradingView-Tradovate Position Closing Timeout" },
    { type: "heading", text: "1. The confirmation never arrived inside the ~10-second window" },
    { type: "paragraph", html: "This is the plain-vanilla case. The close request went out, but the <code>positionUpdate</code> (with the matching <code>id</code> and <code>qty</code> of <code>0</code>) didn't make it back to the chart within the library's timeout. A congested market-data feed, a brief network hiccup, or a Tradovate-side slowdown is enough to miss the window even when the position closes just fine." },
    { type: "heading", text: "2. An order or position ID changed after submission (the mismatch)" },
    { type: "paragraph", html: "If the backend re-issues an <code>id</code> between submission and processing, the chart is now referencing something that no longer exists. Close and modify actions target the old <code>id</code>, so they fail, and the position or order looks \"stuck\" on the chart while Tradovate shows a different reality. This is the exact \"dynamic ID change\" edge case the Broker API docs describe." },
    { type: "heading", text: "3. A stale or dropped broker session" },
    { type: "paragraph", html: "TradingView caches order and position state for the connected account. If the Tradovate session drifts, drops, or gets bumped (say, by hitting the concurrent-session limit across web, desktop, mobile, and TradingView), the chart can keep showing a snapshot that no longer matches the live account, and a close against that snapshot times out." },
    { type: "heading", text: "4. A Tradovate-side outage, freeze, or rate-limit" },
    { type: "paragraph", html: "During a Tradovate incident, or when heavy modify/trailing activity exhausts request limits, orders can freeze and confirmations stop flowing. You'll see it as exit buttons that don't respond, \"order can't be modified\" loops, and positions that won't close until the connection is reset. When Tradovate itself isn't confirming, no amount of clicking on the chart will clear the timeout." },
    { type: "heading", text: "How to Fix a Position Closing Timeout: Step-by-Step" },
    {
      type: "steps",
      items: [
        { title: "Confirm the true position state in Tradovate first", html: "Before you touch the chart again, find out what's actually open. Log into the Tradovate web trader and open the <strong class='text-white'>Positions</strong> and <strong class='text-white'>Orders</strong> panels. If the position is already flat there, the timeout was a false alarm, the confirmation just didn't reach TradingView, and there's nothing to close. If it's still open, note the exact quantity and any working orders (stops/targets) so you know precisely what needs to be flattened. Treat Tradovate as the source of truth and the chart as a possibly stale mirror." },
        { title: "Force a fresh state load by reconnecting the broker in TradingView", html: "If the chart and Tradovate disagree, make TradingView throw away its cached snapshot and reload from scratch. In the chart's trading panel (the Account Manager area), open the connected Tradovate account's controls and <strong class='text-white'>disconnect, then reconnect</strong> the broker session. Reconnecting triggers a first-time-load style fetch, so the full, current list of orders and positions gets pulled fresh, which clears mismatched IDs and stale entries. A page refresh followed by a reconnect does the same thing if you can't find a direct reconnect control." },
        { title: "For integrators: trigger ordersFullUpdate / positionsFullUpdate", html: "If you build on TradingView's Broker API, or run a bridge that speaks it, the docs give you an explicit recovery for ID mismatches. Calling <strong class='text-white'>ordersFullUpdate</strong> and <strong class='text-white'>positionsFullUpdate</strong> forces the library to clear its existing data and refetch the full list of orders or positions, exactly as it does on first load. That wipes out any stale <code>id</code> the chart was holding. These full-update methods are edge-case tools only, meant for rare situations like dynamic ID changes, not for your regular update flow. Your default for keeping the chart in sync should stay <code>orderUpdate</code> and <code>positionUpdate</code>, which patch the UI without a full reload." },
        { title: "Flatten manually if the position is genuinely still open", html: "If Tradovate confirms the position is real and reconnecting didn't let you close it from the chart, exit directly in Tradovate. Use the account's <strong class='text-white'>flatten</strong> control, or place an <strong class='text-white'>opposite market order</strong> for the exact open quantity (sell to close a long, buy to close a short), then cancel any orphaned stop/target left working. Doing this in the Tradovate web trader instead of fighting the timed-out chart button gives you a clean fill and avoids stacking duplicate closes." },
      ],
    },
    { type: "heading", text: "Troubleshooting Table" },
    {
      type: "table",
      headers: ["Error", "Meaning", "Fix"],
      rows: [
        ["Failed to close position: Position closing timeout", "The close confirmation didn't reach the chart within ~10 seconds", "Check Tradovate for the true state; if still open, reconnect the broker or flatten directly in Tradovate"],
        ["Position/order shown on chart but missing in Tradovate", "Chart is holding a stale id (dynamic ID mismatch)", "Reconnect the broker to force a full refetch; integrators call positionsFullUpdate / ordersFullUpdate"],
        ["Order placing / modifying timeout", "Order confirmation missed the same ~10-second Trading Host window", "Verify the order status in Tradovate before resubmitting; reconnect if the chart is out of sync"],
        ["Order can't be modified / exit button does nothing", "Frozen session or exhausted request limits during heavy activity", "Stop clicking, flatten via an opposite market order in Tradovate, then reconnect"],
        ["Position won't close during an outage", "Tradovate isn't confirming state; feed or platform incident", "Manage risk from Tradovate directly or a backup connection; wait for the incident to clear"],
      ],
    },
    { type: "heading", text: "Prevent This with PickMyTrade" },
    { type: "paragraph", html: "PickMyTrade routes your TradingView alerts to Tradovate through a dedicated bridge instead of leaning on the chart's live Broker-API session, which removes most of the state-sync failure points behind a closing timeout:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Reliable close and flatten signals</strong>, a single close or flatten alert sends a clean exit to Tradovate, so you're not depending on a chart button whose confirmation timed out.",
        "<strong class='text-white'>Consistent order state</strong>, the bridge tracks the order it sent and its status, so your exits don't hinge on the chart's cached IDs staying perfectly in sync.",
        "<strong class='text-white'>Rate-limit-safe routing</strong>, spaces out order and modify traffic so you don't exhaust Tradovate's request limits and trigger the freezes that cause timeouts.",
        "<strong class='text-white'>Multi-account sync</strong>, mirrors the same validated exit across every connected account at once, instead of leaving one account stuck open.",
      ],
    },
    { type: "paragraph", html: "The payoff is fewer \"did that actually close?\" moments, and cleaner logs when you do need to debug." },
  ], de: [
    { type: "paragraph",html: "Wenn Sie eine Live-Futures-Position direkt von einem mit Tradovate verbundenen TradingView-Chart aus managen, soll der Exit-Button sofort wirken. Ein Klick und Sie sind flat. Umso beunruhigender ist es, wenn Sie klicken und statt der Glattstellung ein roter Fehler erscheint: <strong class='text-white'>\"Position closing timeout.\"</strong> Vielleicht wurde der Trade auf Tradovate-Seite schon geschlossen. Vielleicht nicht. Und bei einem schnellen Kontrakt wie ES oder NQ wissen Sie für die nächsten Sekunden wirklich nicht, ob Sie noch Größe halten. Derselbe Fehler zeigt sich auch in anderer Verkleidung: Eine Order wird ausgelöst, aber der Chart zeigt die Position weiter offen, eine Positions-ID passt nicht mehr, ein Close-Button reagiert nicht. Fast alles geht auf eine Ursache zurück: Der TradingView-Chart und das Tradovate-Backend sind bei Order- und Positionsstatus auseinandergelaufen. Hier erfahren Sie, was der Timeout tatsächlich bedeutet, was die ID-Abweichung dahinter verursacht und wie Sie einen sauberen Neuabruf erzwingen, um sicher auszusteigen." },
    {
      type: "checklist",
      heading: "Kurze Checkliste bei einem Position Closing Timeout",
      items: [
        "<strong class='text-white'>Prüfen Sie direkt in Tradovate, bevor Sie reagieren.</strong> Öffnen Sie das Positions-/Orders-Panel im Tradovate Web Trader. Der Timeout ist ein Bestätigungsfehler, daher ist Ihre echte Position dort die maßgebliche Quelle, nicht der Chart.",
        "<strong class='text-white'>Klicken Sie nicht wiederholt auf den Exit-Button.</strong> Wiederholte Close-Klicks können doppelte Orders stapeln, sobald die Verbindung aufholt. Einmal klicken, dann prüfen.",
        "<strong class='text-white'>Verbinden Sie die Broker-Sitzung in TradingView neu.</strong> Das Trennen und erneute Verbinden des Tradovate-Kontos zwingt den Chart, die vollständige Order- und Positionsliste von Grund auf neu zu laden.",
        "<strong class='text-white'>Vermuten Sie eine ID-Abweichung.</strong> Zeigt der Chart eine Position oder Order, die Tradovate nicht mehr hat (oder umgekehrt), verweisen beide Seiten auf unterschiedliche IDs und brauchen einen vollständigen Neuabruf, keinen Stups.",
        "<strong class='text-white'>Für Integratoren und Bridges:</strong> Rufen Sie <code>ordersFullUpdate</code> und <code>positionsFullUpdate</code> auf, um den Cache zu leeren und neu abzurufen – aber nur als Sonderfall-Wiederherstellung, nie bei jedem Update.",
        "<strong class='text-white'>Halten Sie einen manuellen Flatten-Weg bereit.</strong> Wissen Sie, wie Sie eine gegenläufige Market-Order platzieren oder die eigene Flatten-Funktion von Tradovate nutzen, falls der Chart den Trade nicht schließt.",
      ],
    },
    { type: "heading",text: "Was “Position Closing Timeout” bedeutet" },
    { type: "paragraph",html: "Das Trading direkt aus einem TradingView-Chart läuft über die <strong class='text-white'>Broker API</strong> von TradingView, einen bidirektionalen Vertrag zwischen Chart und dem angeschlossenen Backend (hier Tradovate über die offizielle Integration). Wenn Sie eine Position schließen, ruft die Bibliothek die Methode <code>closePosition</code> der Integration auf und wartet dann auf eine Bestätigung, dass die <code>id</code> der Position nun die Menge <code>0</code> hat. Laut der Broker-API-Dokumentation von TradingView wartet die Bibliothek <strong class='text-white'>bis zu etwa 10 Sekunden</strong> darauf, dass diese Bestätigung über den Trading Host zurückkommt. Erscheint in diesem Zeitfenster kein passendes <code>positionUpdate</code>, gibt die Bibliothek auf und wirft den Fehler, den Sie vor sich sehen: <strong class='text-white'>\"Failed to close position: Position closing timeout.\"</strong>" },
    { type: "paragraph",html: "Hier die entscheidende Nuance: Der Timeout beschreibt die <em>Bestätigung</em>, nicht unbedingt die <em>Order</em>. Tradovate hat die Position vielleicht schon glattgestellt; TradingView hat nur nicht rechtzeitig davon gehört. Ein hinterherhinkender Feed, eine abgebrochene Sitzung oder eine Welle aus Modify/Cancel können diese Bestätigung verschlucken. Deshalb ist Ihr erster Schritt immer, den tatsächlichen Zustand bei Tradovate zu prüfen, statt erneut auf Schließen zu klicken. Die Orderseite des Chart-Tradings nutzt dasselbe Zeitfenster von etwa 10 Sekunden, sodass das Platzieren oder Ändern einer Order einen entsprechenden Timeout auslösen kann." },
    { type: "paragraph",html: "Eine verwandte und unangenehmere Variante ist eine regelrechte <strong class='text-white'>ID-Abweichung</strong>. TradingView verfolgt jede Order und Position über eine <code>id</code>, die die Integration liefert. Ändert sich diese Backend-<code>id</code> zwischen dem Absenden der Anfrage und ihrer Verarbeitung, zeigt die Bibliothek auf eine <code>id</code>, die nicht mehr existiert. Close- und Modify-Anfragen verweisen dann auf veraltete Daten und scheitern stillschweigend, und die Oberfläche zeigt Orders oder Positionen, die nicht zum Konto passen. Die Dokumentation von TradingView benennt dies direkt und gibt einen konkreten Wiederherstellungsweg vor." },
    { type: "heading",text: "Die häufigsten Ursachen für einen TradingView-Tradovate Position Closing Timeout" },
    { type: "heading",text: "1. Die Bestätigung kam nicht innerhalb des ~10-Sekunden-Fensters an" },
    { type: "paragraph",html: "Das ist der Normalfall. Die Close-Anfrage ging raus, aber das <code>positionUpdate</code> (mit passender <code>id</code> und <code>qty</code> von <code>0</code>) schaffte es nicht innerhalb des Timeouts der Bibliothek zurück zum Chart. Ein überlasteter Marktdaten-Feed, ein kurzer Netzwerkaussetzer oder eine Verlangsamung auf Tradovate-Seite genügen, um das Fenster zu verpassen, selbst wenn die Position problemlos schließt." },
    { type: "heading",text: "2. Eine Order- oder Positions-ID hat sich nach dem Absenden geändert (die Abweichung)" },
    { type: "paragraph",html: "Vergibt das Backend zwischen Absenden und Verarbeitung eine neue <code>id</code>, verweist der Chart auf etwas, das nicht mehr existiert. Close- und Modify-Aktionen zielen auf die alte <code>id</code> und scheitern, und die Position oder Order wirkt im Chart \"festgefahren\", während Tradovate eine andere Realität zeigt. Das ist genau der Sonderfall der \"dynamischen ID-Änderung\", den die Broker-API-Dokumentation beschreibt." },
    { type: "heading",text: "3. Eine veraltete oder abgebrochene Broker-Sitzung" },
    { type: "paragraph",html: "TradingView speichert Order- und Positionsstatus des verbundenen Kontos im Cache. Driftet die Tradovate-Sitzung, bricht ab oder wird verdrängt (etwa durch das Limit gleichzeitiger Sitzungen über Web, Desktop, Mobil und TradingView), kann der Chart einen Schnappschuss weiter anzeigen, der nicht mehr zum Live-Konto passt, und ein Close gegen diesen Schnappschuss läuft in einen Timeout." },
    { type: "heading",text: "4. Eine Störung, ein Einfrieren oder ein Rate-Limit auf Tradovate-Seite" },
    { type: "paragraph",html: "Bei einer Tradovate-Störung oder wenn intensive Modify-/Trailing-Aktivität Anfragelimits ausschöpft, können Orders einfrieren und Bestätigungen ausbleiben. Sie erkennen es an Exit-Buttons, die nicht reagieren, \"order can't be modified\"-Schleifen und Positionen, die sich erst nach einem Verbindungs-Reset schließen. Wenn Tradovate selbst nicht bestätigt, hilft kein Klicken im Chart gegen den Timeout." },
    { type: "heading",text: "So beheben Sie einen Position Closing Timeout: Schritt für Schritt" },
    {
      type: "steps",
      items: [
        { title: "Prüfen Sie zuerst den tatsächlichen Positionsstatus in Tradovate", html: "Bevor Sie den Chart erneut anfassen, finden Sie heraus, was wirklich offen ist. Melden Sie sich im Tradovate Web Trader an und öffnen Sie die Panels <strong class='text-white'>Positions</strong> und <strong class='text-white'>Orders</strong>. Ist die Position dort bereits flat, war der Timeout ein Fehlalarm: Die Bestätigung hat TradingView nur nicht erreicht, und es gibt nichts zu schließen. Ist sie noch offen, notieren Sie die exakte Menge und alle Working-Orders (Stops/Targets), damit Sie genau wissen, was glattgestellt werden muss. Behandeln Sie Tradovate als maßgebliche Quelle und den Chart als möglicherweise veralteten Spiegel." },
        { title: "Erzwingen Sie einen frischen Zustand, indem Sie den Broker in TradingView neu verbinden", html: "Weichen Chart und Tradovate voneinander ab, zwingen Sie TradingView, seinen zwischengespeicherten Schnappschuss zu verwerfen und von Grund auf neu zu laden. Öffnen Sie im Trading-Panel des Charts (dem Bereich Account Manager) die Steuerelemente des verbundenen Tradovate-Kontos und <strong class='text-white'>trennen und verbinden Sie die Broker-Sitzung erneut</strong>. Das erneute Verbinden löst einen Abruf wie beim ersten Laden aus, sodass die vollständige, aktuelle Liste von Orders und Positionen frisch geholt wird, was abweichende IDs und veraltete Einträge beseitigt. Eine Seitenaktualisierung mit anschließendem Neuverbinden bewirkt dasselbe, falls Sie keine direkte Reconnect-Schaltfläche finden." },
        { title: "Für Integratoren: ordersFullUpdate / positionsFullUpdate auslösen", html: "Bauen Sie auf der Broker API von TradingView auf oder betreiben Sie eine Bridge, die sie spricht, gibt die Dokumentation Ihnen eine explizite Wiederherstellung bei ID-Abweichungen. Der Aufruf von <strong class='text-white'>ordersFullUpdate</strong> und <strong class='text-white'>positionsFullUpdate</strong> zwingt die Bibliothek, ihre vorhandenen Daten zu löschen und die vollständige Liste der Orders bzw. Positionen neu abzurufen, genau wie beim ersten Laden. Dadurch verschwindet jede veraltete <code>id</code>, die der Chart gehalten hat. Diese Full-Update-Methoden sind reine Sonderfall-Werkzeuge für seltene Situationen wie dynamische ID-Änderungen, nicht für Ihren regulären Update-Fluss. Ihr Standard zur Synchronhaltung des Charts sollten weiterhin <code>orderUpdate</code> und <code>positionUpdate</code> sein, die die Oberfläche ohne vollständiges Neuladen aktualisieren." },
        { title: "Manuell flatten, wenn die Position tatsächlich noch offen ist", html: "Bestätigt Tradovate, dass die Position real ist, und das Neuverbinden erlaubte kein Schließen aus dem Chart, steigen Sie direkt in Tradovate aus. Nutzen Sie die <strong class='text-white'>Flatten</strong>-Funktion des Kontos oder platzieren Sie eine <strong class='text-white'>gegenläufige Market-Order</strong> über die exakte offene Menge (Verkauf zum Schließen einer Long-Position, Kauf zum Schließen einer Short-Position) und stornieren Sie anschließend verwaiste Stops/Targets. Im Tradovate Web Trader statt am hängenden Chart-Button zu arbeiten, ergibt einen sauberen Fill und vermeidet gestapelte doppelte Closes." },
      ],
    },
    { type: "heading",text: "Fehlerbehebungstabelle" },
    { type: "table", headers: ["Fehler","Bedeutung","Lösung"], rows: [
      ["Failed to close position: Position closing timeout","Die Close-Bestätigung erreichte den Chart nicht innerhalb von ~10 Sekunden","Prüfen Sie den tatsächlichen Zustand in Tradovate; ist die Position noch offen, verbinden Sie den Broker neu oder flatten Sie direkt in Tradovate"],
      ["Position/Order im Chart sichtbar, in Tradovate aber nicht vorhanden","Der Chart hält eine veraltete id (dynamische ID-Abweichung)","Broker neu verbinden, um einen vollständigen Neuabruf zu erzwingen; Integratoren rufen positionsFullUpdate / ordersFullUpdate auf"],
      ["Order placing / modifying timeout","Die Order-Bestätigung verpasste dasselbe ~10-Sekunden-Fenster des Trading Hosts","Prüfen Sie den Orderstatus in Tradovate, bevor Sie erneut senden; verbinden Sie neu, wenn der Chart nicht synchron ist"],
      ["Order can't be modified / Exit-Button reagiert nicht","Eingefrorene Sitzung oder ausgeschöpfte Anfragelimits bei hoher Aktivität","Hören Sie auf zu klicken, flatten Sie per gegenläufiger Market-Order in Tradovate und verbinden Sie dann neu"],
      ["Position lässt sich bei einer Störung nicht schließen","Tradovate bestätigt den Zustand nicht; Störung bei Feed oder Plattform","Managen Sie das Risiko direkt in Tradovate oder über eine Ersatzverbindung; warten Sie, bis die Störung behoben ist"],
    ] },
    { type: "heading",text: "Verhindern Sie das mit PickMyTrade" },
    { type: "paragraph",html: "PickMyTrade routet Ihre TradingView-Alerts über eine dedizierte Bridge zu Tradovate, statt sich auf die Live-Broker-API-Sitzung des Charts zu stützen, wodurch die meisten Synchronisationsfehlerquellen hinter einem Closing Timeout entfallen:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Zuverlässige Close- und Flatten-Signale</strong>, ein einzelner Close- oder Flatten-Alert sendet einen sauberen Exit an Tradovate, sodass Sie nicht von einem Chart-Button abhängen, dessen Bestätigung in den Timeout lief.",
        "<strong class='text-white'>Konsistenter Orderstatus</strong>, die Bridge verfolgt die gesendete Order und ihren Status, sodass Ihre Exits nicht davon abhängen, dass die zwischengespeicherten IDs des Charts perfekt synchron bleiben.",
        "<strong class='text-white'>Rate-Limit-sicheres Routing</strong>, verteilt Order- und Modify-Verkehr zeitlich, damit Sie die Anfragelimits von Tradovate nicht ausschöpfen und die Einfrierer auslösen, die Timeouts verursachen.",
        "<strong class='text-white'>Multi-Account-Sync</strong>, spiegelt denselben validierten Exit gleichzeitig auf alle verbundenen Konten, statt ein Konto offen hängen zu lassen.",
      ],
    },
    { type: "paragraph",html: "Der Gewinn: weniger \"Wurde das wirklich geschlossen?\"-Momente und sauberere Logs, wenn Sie doch debuggen müssen." },
  ], es: [
    { type: "paragraph",html: "Cuando gestiona una posición de futuros en vivo directamente desde un gráfico de TradingView conectado a Tradovate, el botón de salida debería ser instantáneo. Un clic y queda plano. Por eso desconcierta que, al pulsarlo, en lugar de aplanar la posición aparezca un error en rojo: <strong class='text-white'>\"Position closing timeout.\"</strong> Quizá la operación ya se cerró en Tradovate. Quizá no. Y durante los siguientes segundos, en un contrato rápido como ES o NQ, realmente no sabe si sigue con tamaño abierto. El mismo fallo aparece con otras formas: una orden se dispara pero el gráfico sigue mostrando la posición abierta, un ID de posición que ya no coincide, un botón de cierre que no hace nada. Casi todo se debe a una misma causa raíz: el gráfico de TradingView y el backend de Tradovate se han desincronizado en el estado de órdenes y posiciones. Aquí verá qué significa realmente el timeout, qué causa la discrepancia de ID que hay detrás y cómo forzar una recarga limpia para salir con confianza." },
    {
      type: "checklist",
      heading: "Lista rápida para un Position Closing Timeout",
      items: [
        "<strong class='text-white'>Compruebe Tradovate directamente antes de reaccionar.</strong> Abra el panel de Positions/Orders en el Tradovate Web Trader. El timeout es un fallo de confirmación, así que su posición real allí es la fuente de verdad, no el gráfico.",
        "<strong class='text-white'>No machaque el botón de salida.</strong> Los clics repetidos de cierre pueden apilar órdenes duplicadas cuando la conexión se recupera. Haga clic una vez y verifique.",
        "<strong class='text-white'>Reconecte la sesión del bróker en TradingView.</strong> Desconectar y volver a conectar la cuenta de Tradovate obliga al gráfico a recargar desde cero la lista completa de órdenes y posiciones.",
        "<strong class='text-white'>Sospeche de una discrepancia de ID.</strong> Si el gráfico muestra una posición u orden que Tradovate ya no tiene (o al revés), ambos lados hacen referencia a ID distintos y necesitan una recarga completa, no un empujón.",
        "<strong class='text-white'>Para integradores y bridges:</strong> llame a <code>ordersFullUpdate</code> y <code>positionsFullUpdate</code> para limpiar el estado en caché y recargar, pero solo como recuperación para casos límite, nunca en cada actualización.",
        "<strong class='text-white'>Tenga a mano una vía manual de flatten.</strong> Sepa cómo colocar una orden de mercado contraria o usar el control de flatten de Tradovate si el gráfico no cierra la operación.",
      ],
    },
    { type: "heading",text: "Qué significa “Position Closing Timeout”" },
    { type: "paragraph",html: "Operar directamente desde un gráfico de TradingView funciona sobre la <strong class='text-white'>Broker API</strong> de TradingView, un contrato bidireccional entre el gráfico y el backend conectado (aquí, Tradovate mediante la integración oficial). Cuando cierra una posición, la biblioteca llama al método <code>closePosition</code> de la integración y luego espera una confirmación de que el <code>id</code> de la posición tiene ahora una cantidad de <code>0</code>. Según la documentación de la Broker API de TradingView, la biblioteca espera <strong class='text-white'>hasta unos 10 segundos</strong> a que esa confirmación regrese a través del Trading Host. Si en esa ventana no aparece un <code>positionUpdate</code> coincidente, la biblioteca se rinde y lanza el error que está viendo: <strong class='text-white'>\"Failed to close position: Position closing timeout.\"</strong>" },
    { type: "paragraph",html: "Este es el matiz importante. El timeout describe la <em>confirmación</em>, no necesariamente la <em>orden</em>. Puede que Tradovate ya haya aplanado la posición; simplemente TradingView no recibió respuesta a tiempo. Un feed con retraso, una sesión caída o una ráfaga de modificaciones/cancelaciones pueden tragarse esa confirmación. Por eso su primer paso es siempre comprobar el estado real en Tradovate en lugar de volver a pulsar cerrar. El lado de órdenes del trading desde el gráfico usa la misma ventana de unos 10 segundos, así que colocar o modificar una orden puede provocar un timeout equivalente." },
    { type: "paragraph",html: "Una variante relacionada y más desagradable es una auténtica <strong class='text-white'>discrepancia de ID</strong>. TradingView rastrea cada orden y posición mediante un <code>id</code> que le proporciona la integración. Si ese <code>id</code> del backend cambia entre el envío de la solicitud y su procesamiento, la biblioteca acaba apuntando a un <code>id</code> que ya no existe. Así, las solicitudes de cierre y modificación hacen referencia a datos obsoletos y fallan en silencio, y la interfaz muestra órdenes o posiciones que no coinciden con la cuenta. La documentación de TradingView lo señala directamente y ofrece una vía de recuperación específica." },
    { type: "heading",text: "Principales causas de un Position Closing Timeout en TradingView-Tradovate" },
    { type: "heading",text: "1. La confirmación no llegó dentro de la ventana de ~10 segundos" },
    { type: "paragraph",html: "Es el caso más simple. La solicitud de cierre salió, pero el <code>positionUpdate</code> (con el <code>id</code> coincidente y <code>qty</code> de <code>0</code>) no volvió al gráfico dentro del timeout de la biblioteca. Un feed de datos de mercado congestionado, un fallo breve de red o una ralentización del lado de Tradovate bastan para perder la ventana aunque la posición se cierre sin problemas." },
    { type: "heading",text: "2. Un ID de orden o posición cambió tras el envío (la discrepancia)" },
    { type: "paragraph",html: "Si el backend reasigna un <code>id</code> entre el envío y el procesamiento, el gráfico hace referencia a algo que ya no existe. Las acciones de cierre y modificación apuntan al <code>id</code> antiguo, por lo que fallan, y la posición u orden parece \"atascada\" en el gráfico mientras Tradovate muestra otra realidad. Es exactamente el caso límite de \"cambio dinámico de ID\" que describe la documentación de la Broker API." },
    { type: "heading",text: "3. Una sesión de bróker obsoleta o caída" },
    { type: "paragraph",html: "TradingView guarda en caché el estado de órdenes y posiciones de la cuenta conectada. Si la sesión de Tradovate se desvía, se cae o es expulsada (por ejemplo, al alcanzar el límite de sesiones simultáneas entre web, escritorio, móvil y TradingView), el gráfico puede seguir mostrando una instantánea que ya no coincide con la cuenta real, y un cierre contra esa instantánea acaba en timeout." },
    { type: "heading",text: "4. Una caída, congelación o límite de frecuencia del lado de Tradovate" },
    { type: "paragraph",html: "Durante una incidencia de Tradovate, o cuando una actividad intensa de modificación/trailing agota los límites de solicitudes, las órdenes pueden congelarse y dejan de fluir las confirmaciones. Lo verá como botones de salida que no responden, bucles de \"order can't be modified\" y posiciones que no se cierran hasta reiniciar la conexión. Cuando Tradovate mismo no confirma, ningún clic en el gráfico eliminará el timeout." },
    { type: "heading",text: "Cómo solucionar un Position Closing Timeout: paso a paso" },
    {
      type: "steps",
      items: [
        { title: "Confirme primero el estado real de la posición en Tradovate", html: "Antes de tocar de nuevo el gráfico, averigüe qué hay realmente abierto. Inicie sesión en el Tradovate Web Trader y abra los paneles <strong class='text-white'>Positions</strong> y <strong class='text-white'>Orders</strong>. Si la posición ya está plana allí, el timeout fue una falsa alarma: la confirmación simplemente no llegó a TradingView y no hay nada que cerrar. Si sigue abierta, anote la cantidad exacta y las órdenes activas (stops/objetivos) para saber con precisión qué hay que aplanar. Trate Tradovate como la fuente de verdad y el gráfico como un espejo posiblemente obsoleto." },
        { title: "Fuerce una carga de estado nueva reconectando el bróker en TradingView", html: "Si el gráfico y Tradovate no coinciden, haga que TradingView descarte su instantánea en caché y recargue desde cero. En el panel de trading del gráfico (el área del Account Manager), abra los controles de la cuenta de Tradovate conectada y <strong class='text-white'>desconecte y vuelva a conectar</strong> la sesión del bróker. Reconectar desencadena una carga al estilo de la primera vez, de modo que se obtiene de nuevo la lista completa y actual de órdenes y posiciones, lo que elimina ID discrepantes y entradas obsoletas. Actualizar la página y luego reconectar hace lo mismo si no encuentra un control directo de reconexión." },
        { title: "Para integradores: active ordersFullUpdate / positionsFullUpdate", html: "Si construye sobre la Broker API de TradingView, o ejecuta un bridge que la usa, la documentación ofrece una recuperación explícita para discrepancias de ID. Llamar a <strong class='text-white'>ordersFullUpdate</strong> y <strong class='text-white'>positionsFullUpdate</strong> obliga a la biblioteca a borrar sus datos existentes y volver a cargar la lista completa de órdenes o posiciones, exactamente como en la primera carga. Eso elimina cualquier <code>id</code> obsoleto que el gráfico conservara. Estos métodos de actualización completa son herramientas solo para casos límite, pensadas para situaciones raras como cambios dinámicos de ID, no para su flujo de actualización habitual. Su opción por defecto para mantener el gráfico sincronizado debe seguir siendo <code>orderUpdate</code> y <code>positionUpdate</code>, que actualizan la interfaz sin una recarga completa." },
        { title: "Haga flatten manualmente si la posición sigue realmente abierta", html: "Si Tradovate confirma que la posición es real y reconectar no le permitió cerrarla desde el gráfico, salga directamente en Tradovate. Use el control de <strong class='text-white'>flatten</strong> de la cuenta, o coloque una <strong class='text-white'>orden de mercado contraria</strong> por la cantidad abierta exacta (vender para cerrar una larga, comprar para cerrar una corta) y luego cancele cualquier stop/objetivo huérfano que siga activo. Hacerlo en el Tradovate Web Trader en lugar de pelear con el botón de cierre con timeout le da una ejecución limpia y evita apilar cierres duplicados." },
      ],
    },
    { type: "heading",text: "Tabla de solución de problemas" },
    { type: "table", headers: ["Error","Significado","Solución"], rows: [
      ["Failed to close position: Position closing timeout","La confirmación de cierre no llegó al gráfico en ~10 segundos","Compruebe el estado real en Tradovate; si sigue abierta, reconecte el bróker o haga flatten directamente en Tradovate"],
      ["Posición/orden visible en el gráfico pero ausente en Tradovate","El gráfico conserva un id obsoleto (discrepancia dinámica de ID)","Reconecte el bróker para forzar una recarga completa; los integradores llaman a positionsFullUpdate / ordersFullUpdate"],
      ["Order placing / modifying timeout","La confirmación de la orden perdió la misma ventana de ~10 segundos del Trading Host","Verifique el estado de la orden en Tradovate antes de reenviar; reconecte si el gráfico está desincronizado"],
      ["Order can't be modified / el botón de salida no hace nada","Sesión congelada o límites de solicitudes agotados durante actividad intensa","Deje de hacer clic, haga flatten con una orden de mercado contraria en Tradovate y luego reconecte"],
      ["La posición no se cierra durante una caída","Tradovate no confirma el estado; incidencia del feed o de la plataforma","Gestione el riesgo directamente desde Tradovate o una conexión de respaldo; espere a que se resuelva la incidencia"],
    ] },
    { type: "heading",text: "Evítelo con PickMyTrade" },
    { type: "paragraph",html: "PickMyTrade enruta sus alertas de TradingView a Tradovate mediante un bridge dedicado en lugar de depender de la sesión de Broker API en vivo del gráfico, lo que elimina la mayoría de los puntos de fallo de sincronización detrás de un closing timeout:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Señales de cierre y flatten fiables</strong>, una única alerta de cierre o flatten envía una salida limpia a Tradovate, así que no depende de un botón del gráfico cuya confirmación caducó.",
        "<strong class='text-white'>Estado de órdenes consistente</strong>, el bridge rastrea la orden que envió y su estado, de modo que sus salidas no dependen de que los ID en caché del gráfico se mantengan perfectamente sincronizados.",
        "<strong class='text-white'>Enrutamiento seguro frente a límites de frecuencia</strong>, espacia el tráfico de órdenes y modificaciones para no agotar los límites de solicitudes de Tradovate ni provocar las congelaciones que causan timeouts.",
        "<strong class='text-white'>Sincronización multicuenta</strong>, replica la misma salida validada en todas las cuentas conectadas a la vez, en lugar de dejar una cuenta atascada abierta.",
      ],
    },
    { type: "paragraph",html: "El resultado: menos momentos de \"¿se cerró de verdad?\" y registros más limpios cuando sí necesite depurar." },
  ], fr: [
    { type: "paragraph",html: "Lorsque vous gérez une position sur contrats à terme en direct depuis un graphique TradingView relié à Tradovate, le bouton de sortie est censé être instantané. Un clic et vous êtes à plat. Il est donc déstabilisant de cliquer et de voir apparaître, au lieu d'une position aplatie, une erreur rouge : <strong class='text-white'>\"Position closing timeout.\"</strong> Peut-être que la position est déjà fermée côté Tradovate. Peut-être pas. Et pendant les secondes suivantes, sur un contrat rapide comme ES ou NQ, vous ne savez réellement pas si vous détenez encore de la taille. Le même défaut se présente sous d'autres formes : un ordre part mais le graphique affiche toujours la position ouverte, un identifiant de position qui ne correspond plus, un bouton de clôture sans effet. Presque tout provient d'une même cause : le graphique TradingView et le backend de Tradovate se sont désynchronisés sur l'état des ordres et des positions. Voici ce que signifie réellement le timeout, ce qui cause la discordance d'identifiant qui le sous-tend, et comment forcer une récupération propre pour sortir en toute confiance." },
    {
      type: "checklist",
      heading: "Liste de contrôle rapide pour un Position Closing Timeout",
      items: [
        "<strong class='text-white'>Vérifiez directement dans Tradovate avant de réagir.</strong> Ouvrez le panneau Positions/Orders du Tradovate Web Trader. Le timeout est un échec de confirmation : votre position réelle y fait donc foi, pas le graphique.",
        "<strong class='text-white'>Ne martelez pas le bouton de sortie.</strong> Des clics répétés sur fermer peuvent empiler des ordres en double une fois que la connexion rattrape son retard. Cliquez une fois, puis vérifiez.",
        "<strong class='text-white'>Reconnectez la session du courtier dans TradingView.</strong> Déconnecter puis reconnecter le compte Tradovate force le graphique à recharger depuis zéro la liste complète des ordres et des positions.",
        "<strong class='text-white'>Soupçonnez une discordance d'identifiant.</strong> Si le graphique affiche une position ou un ordre que Tradovate n'a plus (ou l'inverse), les deux côtés font référence à des identifiants différents et ont besoin d'une récupération complète, pas d'un simple coup de pouce.",
        "<strong class='text-white'>Pour les intégrateurs et les bridges :</strong> appelez <code>ordersFullUpdate</code> et <code>positionsFullUpdate</code> pour vider l'état en cache et récupérer de nouveau, mais uniquement comme reprise pour cas limite, jamais à chaque mise à jour.",
        "<strong class='text-white'>Gardez une voie de flatten manuelle prête.</strong> Sachez comment passer un ordre au marché inverse ou utiliser la commande de flatten propre à Tradovate si le graphique ne ferme pas la position.",
      ],
    },
    { type: "heading",text: "Ce que signifie “Position Closing Timeout”" },
    { type: "paragraph",html: "Le trading directement depuis un graphique TradingView repose sur la <strong class='text-white'>Broker API</strong> de TradingView, un contrat bidirectionnel entre le graphique et le backend connecté (ici, Tradovate via l'intégration officielle). Lorsque vous fermez une position, la bibliothèque appelle la méthode <code>closePosition</code> de l'intégration, puis attend une confirmation indiquant que l'<code>id</code> de la position a maintenant une quantité de <code>0</code>. Selon la documentation de la Broker API de TradingView, la bibliothèque attend <strong class='text-white'>jusqu'à environ 10 secondes</strong> le retour de cette confirmation via le Trading Host. Si aucun <code>positionUpdate</code> correspondant n'apparaît dans cette fenêtre, la bibliothèque abandonne et lève l'erreur que vous avez sous les yeux : <strong class='text-white'>\"Failed to close position: Position closing timeout.\"</strong>" },
    { type: "paragraph",html: "Voici la nuance qui compte. Le timeout décrit la <em>confirmation</em>, pas forcément l'<em>ordre</em>. Tradovate a peut-être déjà aplati la position ; TradingView n'a simplement pas reçu de réponse à temps. Un flux en retard, une session coupée ou une rafale de modifications/annulations peuvent avaler cette confirmation. C'est précisément pourquoi votre premier réflexe doit toujours être de vérifier l'état réel sur Tradovate plutôt que de recliquer sur fermer. Le côté ordre du trading depuis le graphique utilise la même fenêtre d'environ 10 secondes ; passer ou modifier un ordre peut donc déclencher un timeout équivalent." },
    { type: "paragraph",html: "Une variante apparentée et plus pénible est une véritable <strong class='text-white'>discordance d'identifiant</strong>. TradingView suit chaque ordre et chaque position par un <code>id</code> fourni par l'intégration. Si cet <code>id</code> du backend change entre l'envoi de la requête et son traitement, la bibliothèque finit par pointer vers un <code>id</code> qui n'existe plus. Les requêtes de clôture et de modification font alors référence à des données obsolètes et échouent silencieusement, et l'interface affiche des ordres ou des positions qui ne correspondent pas au compte. La documentation de TradingView le signale directement et fournit une voie de reprise précise." },
    { type: "heading",text: "Principales causes d'un Position Closing Timeout TradingView-Tradovate" },
    { type: "heading",text: "1. La confirmation n'est pas arrivée dans la fenêtre d'environ 10 secondes" },
    { type: "paragraph",html: "C'est le cas le plus simple. La requête de clôture est partie, mais le <code>positionUpdate</code> (avec l'<code>id</code> correspondant et une <code>qty</code> de <code>0</code>) n'est pas revenu au graphique dans le délai de la bibliothèque. Un flux de données de marché encombré, un bref incident réseau ou un ralentissement côté Tradovate suffisent à manquer la fenêtre même si la position se ferme parfaitement." },
    { type: "heading",text: "2. Un identifiant d'ordre ou de position a changé après l'envoi (la discordance)" },
    { type: "paragraph",html: "Si le backend réattribue un <code>id</code> entre l'envoi et le traitement, le graphique fait référence à quelque chose qui n'existe plus. Les actions de clôture et de modification ciblent l'ancien <code>id</code> et échouent, et la position ou l'ordre semble \"bloqué\" sur le graphique alors que Tradovate affiche une autre réalité. C'est exactement le cas limite du \"changement dynamique d'identifiant\" décrit dans la documentation de la Broker API." },
    { type: "heading",text: "3. Une session de courtier obsolète ou interrompue" },
    { type: "paragraph",html: "TradingView met en cache l'état des ordres et des positions du compte connecté. Si la session Tradovate dérive, tombe ou est éjectée (par exemple en atteignant la limite de sessions simultanées entre web, bureau, mobile et TradingView), le graphique peut continuer d'afficher un instantané qui ne correspond plus au compte réel, et une clôture contre cet instantané aboutit à un timeout." },
    { type: "heading",text: "4. Une panne, un gel ou une limite de débit côté Tradovate" },
    { type: "paragraph",html: "Lors d'un incident Tradovate, ou lorsqu'une forte activité de modification/trailing épuise les limites de requêtes, les ordres peuvent se figer et les confirmations cessent de circuler. Vous le constatez par des boutons de sortie qui ne répondent pas, des boucles \"order can't be modified\" et des positions qui ne se ferment qu'après une réinitialisation de la connexion. Quand Tradovate lui-même ne confirme pas, aucun clic sur le graphique ne fera disparaître le timeout." },
    { type: "heading",text: "Comment corriger un Position Closing Timeout : pas à pas" },
    {
      type: "steps",
      items: [
        { title: "Confirmez d'abord l'état réel de la position dans Tradovate", html: "Avant de retoucher le graphique, déterminez ce qui est réellement ouvert. Connectez-vous au Tradovate Web Trader et ouvrez les panneaux <strong class='text-white'>Positions</strong> et <strong class='text-white'>Orders</strong>. Si la position est déjà à plat, le timeout était une fausse alerte : la confirmation n'a simplement pas atteint TradingView et il n'y a rien à fermer. Si elle est toujours ouverte, notez la quantité exacte et les ordres actifs (stops/objectifs) pour savoir précisément ce qu'il faut aplatir. Considérez Tradovate comme la source de vérité et le graphique comme un miroir potentiellement obsolète." },
        { title: "Forcez un rechargement de l'état en reconnectant le courtier dans TradingView", html: "Si le graphique et Tradovate ne concordent pas, faites en sorte que TradingView jette son instantané en cache et recharge depuis zéro. Dans le panneau de trading du graphique (la zone Account Manager), ouvrez les commandes du compte Tradovate connecté et <strong class='text-white'>déconnectez puis reconnectez</strong> la session du courtier. La reconnexion déclenche une récupération de type premier chargement : la liste complète et actuelle des ordres et des positions est récupérée à neuf, ce qui élimine les identifiants discordants et les entrées obsolètes. Un rafraîchissement de page suivi d'une reconnexion produit le même effet si vous ne trouvez pas de commande de reconnexion directe." },
        { title: "Pour les intégrateurs : déclenchez ordersFullUpdate / positionsFullUpdate", html: "Si vous développez sur la Broker API de TradingView, ou exploitez un bridge qui la parle, la documentation vous donne une reprise explicite pour les discordances d'identifiant. Appeler <strong class='text-white'>ordersFullUpdate</strong> et <strong class='text-white'>positionsFullUpdate</strong> force la bibliothèque à effacer ses données existantes et à récupérer de nouveau la liste complète des ordres ou des positions, exactement comme au premier chargement. Cela supprime tout <code>id</code> obsolète que le graphique conservait. Ces méthodes de mise à jour complète sont des outils réservés aux cas limites, destinés à des situations rares comme les changements dynamiques d'identifiant, et non à votre flux de mise à jour habituel. Votre option par défaut pour garder le graphique synchronisé doit rester <code>orderUpdate</code> et <code>positionUpdate</code>, qui mettent à jour l'interface sans rechargement complet." },
        { title: "Aplatissez manuellement si la position est réellement toujours ouverte", html: "Si Tradovate confirme que la position est réelle et que la reconnexion ne vous a pas permis de la fermer depuis le graphique, sortez directement dans Tradovate. Utilisez la commande <strong class='text-white'>flatten</strong> du compte, ou passez un <strong class='text-white'>ordre au marché inverse</strong> pour la quantité ouverte exacte (vendre pour fermer une position longue, acheter pour fermer une position courte), puis annulez tout stop/objectif orphelin resté actif. Le faire dans le Tradovate Web Trader plutôt que de vous battre avec le bouton du graphique en timeout vous donne une exécution propre et évite d'empiler des clôtures en double." },
      ],
    },
    { type: "heading",text: "Tableau de dépannage" },
    { type: "table", headers: ["Erreur","Signification","Correctif"], rows: [
      ["Failed to close position: Position closing timeout","La confirmation de clôture n'a pas atteint le graphique en ~10 secondes","Vérifiez l'état réel dans Tradovate ; si la position est toujours ouverte, reconnectez le courtier ou aplatissez directement dans Tradovate"],
      ["Position/ordre affiché sur le graphique mais absent de Tradovate","Le graphique conserve un id obsolète (discordance dynamique d'identifiant)","Reconnectez le courtier pour forcer une récupération complète ; les intégrateurs appellent positionsFullUpdate / ordersFullUpdate"],
      ["Order placing / modifying timeout","La confirmation de l'ordre a manqué la même fenêtre d'environ 10 secondes du Trading Host","Vérifiez le statut de l'ordre dans Tradovate avant de le renvoyer ; reconnectez si le graphique est désynchronisé"],
      ["Order can't be modified / le bouton de sortie ne fait rien","Session figée ou limites de requêtes épuisées lors d'une forte activité","Cessez de cliquer, aplatissez via un ordre au marché inverse dans Tradovate, puis reconnectez"],
      ["La position ne se ferme pas pendant une panne","Tradovate ne confirme pas l'état ; incident du flux ou de la plateforme","Gérez le risque directement depuis Tradovate ou une connexion de secours ; attendez la résolution de l'incident"],
    ] },
