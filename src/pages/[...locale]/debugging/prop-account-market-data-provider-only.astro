---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "prop-account-market-data-provider-only";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/debugging/${SLUG}`;

const META_TITLE = "Tradovate Prop Account Data Only Firm Can Enable";
const META_DESCRIPTION =
  "Tradovate prop account market data must be enabled by your prop firm, not self-subscribed. See why data shows delayed and how to get live quotes.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Tradovate-Prop-Account: Marktdaten kann nur Ihre Firma aktivieren", es: "Datos de la cuenta prop de Tradovate: solo su firma puede activarlos", fr: "Données d'un compte prop Tradovate : seule votre firme peut les activer", it: "Dati del conto prop Tradovate: solo la sua società può attivarli" },
  dek: { en: "Your ES or NQ quotes are frozen ten minutes behind the market or every symbol glows orange. Before you go hunting for a Buy Market Data button, stop, on a prop or evaluation account only your provider can turn that data on.", de: "Ihre ES- oder NQ-Kurse hängen zehn Minuten hinter dem Markt zurück oder jedes Symbol leuchtet orange. Bevor Sie nach einem Button „Buy Market Data“ suchen: Halt, bei einem Prop- oder Evaluierungskonto kann nur Ihr Anbieter diese Daten freischalten.", es: "Sus cotizaciones de ES o NQ van diez minutos por detrás del mercado o todos los símbolos aparecen en naranja. Antes de buscar un botón Buy Market Data, deténgase: en una cuenta prop o de evaluación, solo su proveedor puede activar esos datos.", fr: "Vos cotations ES ou NQ sont figées dix minutes en retard sur le marché ou tous les symboles s'affichent en orange. Avant de chercher un bouton Buy Market Data, arrêtez-vous : sur un compte prop ou d'évaluation, seul votre fournisseur peut activer ces données.", it: "Le sue quotazioni ES o NQ sono ferme con dieci minuti di ritardo sul mercato oppure ogni simbolo è arancione. Prima di cercare un pulsante Buy Market Data, si fermi: su un conto prop o di valutazione, solo il suo fornitore può attivare quei dati." },
  readTime: { en: "7 min read", de: "7 Min. Lesezeit", es: "Lectura de 7 min", fr: "Lecture : 7 min", it: "Lettura di 7 min" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "You funded an evaluation, logged into Tradovate, and your ES or NQ quotes are frozen ten minutes behind the market. Or maybe every symbol name glows orange instead of showing a live price. Before you go hunting for a “Buy Market Data” button, stop. On a prop firm or evaluation account, <strong class='text-white'>Tradovate prop account market data can only be enabled by your account provider</strong>, not by you." },
    { type: "paragraph", html: "Self-subscribing through Tradovate for a prop account is the single most common wrong turn traders make, and it burns hours. Sometimes it costs real money on data you already paid for. Here's why your feed shows as delayed, what your firm actually has to do, and the exact order of steps to get live quotes flowing, so an automation like PickMyTrade never fires an alert on a stale price." },
    {
      type: "checklist",
      heading: "Quick Checklist for Delayed Prop-Account Data",
      items: [
        "<strong class='text-white'>Confirm it's a prop or eval account.</strong> If you logged in with your firm's evaluation credentials, the firm manages your market data, not you.",
        "<strong class='text-white'>Look for orange symbol names or a “delayed” tag.</strong> That's Tradovate telling you the feed is 10-minute delayed, not live.",
        "<strong class='text-white'>Sign the Non-Professional data agreement.</strong> Live CME data almost always waits on your signature to this document.",
        "<strong class='text-white'>Do not buy Top-of-Book (Level I) CME data yourself.</strong> It's already included in what you pay the prop firm.",
        "<strong class='text-white'>Wait out provisioning, then log out and back in.</strong> New subscriptions and agreements only take effect on a fresh session.",
        "<strong class='text-white'>Still delayed? Contact the prop firm's support, not Tradovate.</strong> Only the account provider can enable or fix Level I data on your account.",
      ],
    },
    { type: "heading", text: "What “Only Your Account Provider Can Enable This Data” Means" },
    { type: "paragraph", html: "Tradovate is the platform, but on an evaluation or funded prop account it doesn't own your market-data entitlement. Your prop firm does. The rule for prop and evaluation accounts is plain: if your account sits with a prop firm or evaluation service, <strong class='text-white'>market data can only be enabled by your account provider.</strong> You're not meant to self-subscribe to the core CME feed the way a standalone retail Tradovate customer would." },
    { type: "paragraph", html: "In practice, prop and evaluation accounts include Level I (Top-of-Book) CME Group market data automatically. The cost is bundled into what you already pay your firm for the evaluation. That's exactly why prop traders shouldn't purchase Top-of-Book CME data themselves. Do it, and you're paying twice for the same feed. Those self-subscribe screens you found buried in Tradovate's settings? They're built for standalone retail accounts, not firm-managed evaluations." },
    { type: "paragraph", html: "So when your prop-account quotes look delayed, it's almost never a “click here to subscribe” problem. It's one of two things: a data agreement you still need to sign, or an entitlement your firm hasn't finished switching on. Both are fixable. Neither is fixed by hunting for a subscription button." },
    { type: "heading", text: "Top Causes of Delayed Data on a Prop Account" },
    { type: "heading", text: "1. You're seeing the default 10-minute delayed feed" },
    { type: "paragraph", html: "When a Tradovate login has no live data subscription active, the platform serves quotes delayed by roughly ten minutes and flags the symbols visually, usually with <strong class='text-white'>orange symbol names</strong>, to warn you the prices aren't live. This is the normal starting state of a brand-new evaluation before your data is provisioned. It's not a bug." },
    { type: "heading", text: "2. The Non-Professional data agreement isn't signed yet" },
    { type: "paragraph", html: "Live CME data requires you to accept a <strong class='text-white'>Non-Professional</strong> market-data agreement. Until that document is signed and processed, your feed stays delayed no matter how long you wait. Skipping it, or accidentally choosing the <strong class='text-white'>Professional</strong> classification, is the most common reason a funded trader stays stuck on delayed data." },
    { type: "heading", text: "3. You tried to self-subscribe instead of letting the firm enable it" },
    { type: "paragraph", html: "Because the retail subscription screens are right there in the platform, plenty of prop traders try to buy the CME feed themselves. On a firm-managed account this either fails, double-charges you, or simply doesn't change your entitlement, because the Level I feed is controlled by the provider, not your login." },
    { type: "heading", text: "4. Provisioning hasn't finished after purchase" },
    { type: "paragraph", html: "Right after you buy an evaluation, the account and its data entitlement need time to provision on the firm's side. During that window quotes can be delayed or the account may not appear correctly. That's timing, not a misconfiguration." },
    { type: "heading", text: "5. You picked the Professional classification (or a large exchange fee applies)" },
    { type: "paragraph", html: "Select <strong class='text-white'>Professional</strong> trader status and exchanges apply a substantial monthly professional data fee, and activation can stall. The exact amount is set by the exchange and changes over time, so check your firm's and the exchange's current rates. But for individual retail-style traders on a personal evaluation, Non-Professional is almost always the right choice." },
    { type: "heading", text: "How to Fix Delayed Prop-Account Data: Step-by-Step" },
    { type: "heading", text: "Step 1: Confirm the account type and current data status" },
    {
      type: "steps",
      items: [
        { title: "Note your login credentials", html: "Note which credentials you used to log in. If they came from your prop firm's evaluation dashboard, this is a firm-managed account and the rules above apply." },
        { title: "Check symbol color", html: "Open a chart or watchlist and check whether symbol names are orange or tagged as delayed. Orange or “delayed” confirms you're on the 10-minute feed and live data hasn't activated yet." },
        { title: "Rule out a separate connection issue", html: "If the symbols already show live (uncolored) prices, your data is fine and any lag is a separate connection issue." },
      ],
    },
    { type: "paragraph", html: "Menu labels shift between Tradovate releases, so open your account or market-data settings area and go by the wording that's actually on your screen." },
    { type: "heading", text: "Step 2: Sign the Non-Professional data agreement" },
    {
      type: "steps",
      items: [
        { title: "Open the data-agreement area", html: "Open the market-data or data-agreement area in your Tradovate settings." },
        { title: "Select Non-Professional", html: "Find the CME (and any other exchange) market-data agreement and select the <strong class='text-white'>Non-Professional</strong> classification, not Professional, unless your firm has told you otherwise." },
        { title: "Accept and submit", html: "Accept and submit the agreement. This is the step that unlocks live Level I data on most evaluation accounts." },
      ],
    },
    { type: "heading", text: "Step 3: Let provisioning finish, then refresh your session" },
    {
      type: "steps",
      items: [
        { title: "Give it time to provision", html: "After signing, give the entitlement time to provision. Activation is usually quick, often within an hour or two, but during heavy onboarding periods it can take longer. Check your firm's current stated timeframe rather than assuming an exact number." },
        { title: "Log out and back in everywhere", html: "Fully <strong class='text-white'>log out</strong> of Tradovate (web, desktop, mobile, and any linked platform like TradingView or NinjaTrader) and <strong class='text-white'>log back in</strong>. Data-entitlement changes only take effect on a new session." },
        { title: "Recheck your symbols", html: "Recheck your symbols. When live data is active, the orange coloring clears and quotes update in real time." },
      ],
    },
    { type: "heading", text: "Step 4: Escalate to the prop firm, not Tradovate" },
    {
      type: "list",
      items: [
        "If your data is still delayed after signing the agreement and waiting the full provisioning window, the fix is on the provider's side.",
        "Contact your <strong class='text-white'>prop firm's</strong> support (Apex, Topstep, and others each run their own help desk), not Tradovate directly. Only the firm can enable, renew, or repair Level I CME data on an account it owns.",
        "Give them your account ID and tell them you've already signed the Non-Professional agreement and waited the stated window. That routes you straight to an entitlement fix instead of generic troubleshooting.",
      ],
    },
    { type: "quote", html: "You <em>can</em> still self-add optional Level II (depth) or EUREX add-on data to a prop account if you want it. Those are extras layered on top. It's specifically the core Level I CME feed that your firm controls and that you should never buy separately." },
    { type: "heading", text: "Troubleshooting Table" },
    {
      type: "table",
      headers: ["Symptom / message", "What it means", "Fix"],
      rows: [
        ["Orange symbol names on a prop account", "No live data subscription is active; feed is delayed ~10 minutes", "Sign the Non-Professional agreement, wait for provisioning, then log out and back in"],
        ["Quotes lag ~10 minutes", "Default delayed feed, live data not yet enabled", "Same as above; confirm the agreement processed"],
        ["“Market data can only be enabled by your account provider”", "You're on a firm-managed evaluation account", "Don't self-subscribe; contact the prop firm to enable Level I data"],
        ["You were charged for Top-of-Book CME data", "You self-subscribed to a feed already bundled by your firm", "Ask the firm or Tradovate to reverse it; the Level I feed is included with your evaluation"],
        ["Professional data fee appeared", "You selected Professional classification", "Switch to Non-Professional if you qualify; a professional exchange fee otherwise applies"],
        ["Data still delayed after signing + waiting", "Provisioning stalled or entitlement not switched on", "Escalate to the prop firm's help desk with your account ID"],
        ["Account or data missing right after purchase", "Provisioning hasn't completed yet", "Wait the firm's stated window, then log out and back in"],
      ],
    },
    { type: "heading", text: "Prevent This with PickMyTrade" },
    { type: "paragraph", html: "Delayed data is dangerous when you're automating, because a bot doesn't know a quote is ten minutes stale. It just fires. PickMyTrade is built to keep automated Tradovate order flow honest:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Entitlement and data-agreement awareness</strong> respects the account's real market-data and entitlement state instead of blindly trading on whatever price is on screen.",
        "<strong class='text-white'>Prop-firm risk filters</strong> honor the caps and rules of firm-managed evaluation accounts so automation stays inside the program.",
        "<strong class='text-white'>Rate-limit-safe routing</strong> spaces out order flow so nothing bounces off Tradovate's limits during data hiccups.",
        "<strong class='text-white'>Multi-account sync</strong> mirrors a corrected, live-data-backed order across every connected account at once.",
      ],
    },
  ], de: [
    { type: "paragraph",html: "Sie haben eine Evaluierung finanziert, sich bei Tradovate angemeldet, und Ihre ES- oder NQ-Kurse hängen zehn Minuten hinter dem Markt zurück. Oder vielleicht leuchtet jeder Symbolname orange, statt einen Live-Preis zu zeigen. Bevor Sie nach einem Button „Buy Market Data“ suchen: Halt. Bei einem Prop-Firmen- oder Evaluierungskonto <strong class='text-white'>können Tradovate-Marktdaten für Prop-Konten nur von Ihrem Kontoanbieter aktiviert werden</strong>, nicht von Ihnen." },
    { type: "paragraph",html: "Sich bei einem Prop-Konto selbst über Tradovate zu abonnieren, ist der häufigste Irrweg von Tradern und kostet Stunden. Manchmal kostet es echtes Geld für Daten, die Sie bereits bezahlt haben. Hier erfahren Sie, warum Ihr Feed verzögert angezeigt wird, was Ihre Firma tatsächlich tun muss und in welcher Reihenfolge Sie vorgehen, damit Live-Kurse fließen und eine Automatisierung wie PickMyTrade nie einen Alert auf einen veralteten Preis auslöst." },
    {
      type: "checklist",
      heading: "Kurze Checkliste für verzögerte Daten bei Prop-Konten",
      items: [
        "<strong class='text-white'>Bestätigen Sie, dass es ein Prop- oder Evaluierungskonto ist.</strong> Wenn Sie sich mit den Evaluierungszugangsdaten Ihrer Firma angemeldet haben, verwaltet die Firma Ihre Marktdaten, nicht Sie.",
        "<strong class='text-white'>Achten Sie auf orange Symbolnamen oder die Kennzeichnung „delayed“.</strong> Damit zeigt Tradovate an, dass der Feed 10 Minuten verzögert und nicht live ist.",
        "<strong class='text-white'>Unterzeichnen Sie die Non-Professional-Datenvereinbarung.</strong> Live-CME-Daten warten fast immer auf Ihre Unterschrift unter diesem Dokument.",
        "<strong class='text-white'>Kaufen Sie keine Top-of-Book-(Level-I-)CME-Daten selbst.</strong> Sie sind bereits in dem enthalten, was Sie der Prop-Firma zahlen.",
        "<strong class='text-white'>Warten Sie die Bereitstellung ab und melden Sie sich dann ab und wieder an.</strong> Neue Abonnements und Vereinbarungen werden erst in einer frischen Sitzung wirksam.",
        "<strong class='text-white'>Immer noch verzögert? Wenden Sie sich an den Support der Prop-Firma, nicht an Tradovate.</strong> Nur der Kontoanbieter kann Level-I-Daten für Ihr Konto aktivieren oder beheben.",
      ],
    },
    { type: "heading",text: "Was „Nur Ihr Kontoanbieter kann diese Daten aktivieren“ bedeutet" },
    { type: "paragraph",html: "Tradovate ist die Plattform, aber bei einem Evaluierungs- oder finanzierten Prop-Konto gehört Ihnen die Marktdatenberechtigung nicht. Sie gehört Ihrer Prop-Firma. Die Regel für Prop- und Evaluierungskonten ist eindeutig: Wenn Ihr Konto bei einer Prop-Firma oder einem Evaluierungsdienst liegt, <strong class='text-white'>können Marktdaten nur von Ihrem Kontoanbieter aktiviert werden.</strong> Sie sollen den CME-Kernfeed nicht selbst abonnieren, wie es ein eigenständiger Tradovate-Privatkunde könnte." },
    { type: "paragraph",html: "In der Praxis enthalten Prop- und Evaluierungskonten automatisch Level-I-(Top-of-Book-)Marktdaten der CME Group. Die Kosten sind in dem enthalten, was Sie Ihrer Firma ohnehin für die Evaluierung zahlen. Genau deshalb sollten Prop-Trader Top-of-Book-CME-Daten nicht selbst kaufen. Wer es tut, zahlt zweimal für denselben Feed. Die Abo-Bildschirme, die Sie in den Tradovate-Einstellungen gefunden haben? Sie sind für eigenständige Privatkonten gebaut, nicht für von Firmen verwaltete Evaluierungen." },
    { type: "paragraph",html: "Wenn die Kurse Ihres Prop-Kontos verzögert wirken, handelt es sich also fast nie um ein „Hier klicken zum Abonnieren“-Problem. Es liegt an einer von zwei Ursachen: einer Datenvereinbarung, die Sie noch unterzeichnen müssen, oder einer Berechtigung, die Ihre Firma noch nicht fertig aktiviert hat. Beides ist behebbar. Keines von beiden löst sich durch die Suche nach einem Abo-Button." },
    { type: "heading",text: "Die häufigsten Ursachen für verzögerte Daten bei einem Prop-Konto" },
    { type: "heading",text: "1. Sie sehen den standardmäßigen, 10 Minuten verzögerten Feed" },
    { type: "paragraph",html: "Wenn bei einem Tradovate-Login kein Live-Datenabonnement aktiv ist, liefert die Plattform um etwa zehn Minuten verzögerte Kurse und kennzeichnet die Symbole visuell, meist durch <strong class='text-white'>orange Symbolnamen</strong>, um Sie zu warnen, dass die Preise nicht live sind. Das ist der normale Ausgangszustand einer brandneuen Evaluierung, bevor Ihre Daten bereitgestellt sind. Es ist kein Fehler." },
    { type: "heading",text: "2. Die Non-Professional-Datenvereinbarung ist noch nicht unterzeichnet" },
    { type: "paragraph",html: "Live-CME-Daten setzen voraus, dass Sie eine <strong class='text-white'>Non-Professional</strong>-Marktdatenvereinbarung akzeptieren. Solange dieses Dokument nicht unterzeichnet und verarbeitet ist, bleibt Ihr Feed verzögert, egal wie lange Sie warten. Sie zu überspringen oder versehentlich die Einstufung <strong class='text-white'>Professional</strong> zu wählen, ist der häufigste Grund, warum ein finanzierter Trader bei verzögerten Daten hängen bleibt." },
    { type: "heading",text: "3. Sie haben versucht, selbst zu abonnieren, statt die Firma freischalten zu lassen" },
    { type: "paragraph",html: "Weil die Abo-Bildschirme für Privatkunden direkt in der Plattform sichtbar sind, versuchen viele Prop-Trader, den CME-Feed selbst zu kaufen. Bei einem von einer Firma verwalteten Konto schlägt das entweder fehl, führt zu einer Doppelabrechnung oder ändert Ihre Berechtigung schlicht nicht, weil der Level-I-Feed vom Anbieter kontrolliert wird, nicht von Ihrem Login." },
    { type: "heading",text: "4. Die Bereitstellung ist nach dem Kauf noch nicht abgeschlossen" },
    { type: "paragraph",html: "Direkt nach dem Kauf einer Evaluierung brauchen das Konto und seine Datenberechtigung Zeit, um auf Seiten der Firma bereitgestellt zu werden. In diesem Zeitfenster können Kurse verzögert sein oder das Konto wird möglicherweise nicht korrekt angezeigt. Das ist eine Frage des Timings, keine Fehlkonfiguration." },
    { type: "heading",text: "5. Sie haben die Einstufung Professional gewählt (oder es fällt eine hohe Börsengebühr an)" },
    { type: "paragraph",html: "Wählen Sie den Status <strong class='text-white'>Professional</strong>, erheben die Börsen eine erhebliche monatliche Gebühr für professionelle Daten, und die Aktivierung kann ins Stocken geraten. Der genaue Betrag wird von der Börse festgelegt und ändert sich mit der Zeit; prüfen Sie daher die aktuellen Sätze Ihrer Firma und der Börse. Für einzelne Privathändler mit einer persönlichen Evaluierung ist Non-Professional jedoch fast immer die richtige Wahl." },
    { type: "heading",text: "Verzögerte Daten beim Prop-Konto beheben: Schritt für Schritt" },
    { type: "heading",text: "Schritt 1: Kontotyp und aktuellen Datenstatus bestätigen" },
    {
      type: "steps",
      items: [
        { title: "Notieren Sie Ihre Zugangsdaten", html: "Notieren Sie, mit welchen Zugangsdaten Sie sich angemeldet haben. Stammen sie aus dem Evaluierungs-Dashboard Ihrer Prop-Firma, handelt es sich um ein von der Firma verwaltetes Konto, und die obigen Regeln gelten." },
        { title: "Symbolfarbe prüfen", html: "Öffnen Sie einen Chart oder eine Watchlist und prüfen Sie, ob Symbolnamen orange oder als „delayed“ gekennzeichnet sind. Orange oder „delayed“ bestätigt, dass Sie den 10-Minuten-Feed nutzen und Live-Daten noch nicht aktiv sind." },
        { title: "Ein separates Verbindungsproblem ausschließen", html: "Zeigen die Symbole bereits Live-Preise (ohne Farbe), sind Ihre Daten in Ordnung, und jede Verzögerung ist ein separates Verbindungsproblem." },
      ],
    },
    { type: "paragraph",html: "Die Menübezeichnungen ändern sich zwischen Tradovate-Versionen. Öffnen Sie daher den Bereich Ihres Kontos oder der Marktdaten-Einstellungen und orientieren Sie sich an der Formulierung, die tatsächlich auf Ihrem Bildschirm steht." },
    { type: "heading",text: "Schritt 2: Non-Professional-Datenvereinbarung unterzeichnen" },
    {
      type: "steps",
      items: [
        { title: "Datenvereinbarung öffnen", html: "Öffnen Sie in Ihren Tradovate-Einstellungen den Bereich für Marktdaten oder Datenvereinbarungen." },
        { title: "Non-Professional auswählen", html: "Suchen Sie die Marktdatenvereinbarung für CME (und gegebenenfalls weitere Börsen) und wählen Sie die Einstufung <strong class='text-white'>Non-Professional</strong>, nicht Professional, es sei denn, Ihre Firma hat Ihnen etwas anderes mitgeteilt." },
        { title: "Akzeptieren und absenden", html: "Akzeptieren und senden Sie die Vereinbarung ab. Dieser Schritt schaltet bei den meisten Evaluierungskonten die Live-Level-I-Daten frei." },
      ],
    },
    { type: "heading",text: "Schritt 3: Bereitstellung abwarten, dann Sitzung aktualisieren" },
    {
      type: "steps",
      items: [
        { title: "Der Bereitstellung Zeit geben", html: "Geben Sie der Berechtigung nach der Unterzeichnung Zeit zur Bereitstellung. Die Aktivierung geht meist schnell, oft innerhalb von ein bis zwei Stunden, kann aber in stark frequentierten Onboarding-Phasen länger dauern. Prüfen Sie den aktuell genannten Zeitrahmen Ihrer Firma, statt von einer genauen Zahl auszugehen." },
        { title: "Überall ab- und wieder anmelden", html: "<strong class='text-white'>Melden Sie sich</strong> vollständig von Tradovate ab (Web, Desktop, Mobil und jede verknüpfte Plattform wie TradingView oder NinjaTrader) und <strong class='text-white'>melden Sie sich wieder an</strong>. Änderungen an Datenberechtigungen werden erst in einer neuen Sitzung wirksam." },
        { title: "Symbole erneut prüfen", html: "Prüfen Sie Ihre Symbole erneut. Sobald Live-Daten aktiv sind, verschwindet die orange Färbung und die Kurse aktualisieren sich in Echtzeit." },
      ],
    },
    { type: "heading",text: "Schritt 4: Eskalation an die Prop-Firma, nicht an Tradovate" },
    {
      type: "list",
      items: [
        "Sind Ihre Daten nach der Unterzeichnung der Vereinbarung und dem Abwarten des gesamten Bereitstellungszeitfensters immer noch verzögert, liegt die Lösung auf Seiten des Anbieters.",
        "Wenden Sie sich an den Support Ihrer <strong class='text-white'>Prop-Firma</strong> (Apex, Topstep und andere betreiben jeweils einen eigenen Helpdesk), nicht direkt an Tradovate. Nur die Firma kann Level-I-CME-Daten für ein von ihr geführtes Konto aktivieren, erneuern oder reparieren.",
        "Nennen Sie Ihre Konto-ID und teilen Sie mit, dass Sie die Non-Professional-Vereinbarung bereits unterzeichnet und das genannte Zeitfenster abgewartet haben. So gelangen Sie direkt zu einer Berechtigungskorrektur statt zu allgemeiner Fehlersuche.",
      ],
    },
    { type: "quote",html: "Sie <em>können</em> einem Prop-Konto weiterhin optionale Level-II-(Depth-)Daten oder EUREX-Zusatzdaten selbst hinzufügen, wenn Sie das möchten. Das sind Extras obendrauf. Es ist speziell der Level-I-CME-Kernfeed, den Ihre Firma kontrolliert und den Sie niemals separat kaufen sollten." },
    { type: "heading",text: "Tabelle zur Fehlerbehebung" },
    { type: "table", headers: ["Symptom / Meldung","Bedeutung","Lösung"], rows: [
      ["Orange Symbolnamen bei einem Prop-Konto","Kein Live-Datenabonnement aktiv; der Feed ist um etwa 10 Minuten verzögert","Non-Professional-Vereinbarung unterzeichnen, Bereitstellung abwarten, dann ab- und wieder anmelden"],
      ["Kurse hängen etwa 10 Minuten hinterher","Standardmäßiger verzögerter Feed, Live-Daten noch nicht aktiviert","Wie oben; prüfen Sie, ob die Vereinbarung verarbeitet wurde"],
      ["„Market data can only be enabled by your account provider“","Sie befinden sich auf einem von einer Firma verwalteten Evaluierungskonto","Nicht selbst abonnieren; kontaktieren Sie die Prop-Firma, damit sie Level-I-Daten aktiviert"],
      ["Ihnen wurden Top-of-Book-CME-Daten berechnet","Sie haben einen Feed abonniert, der bereits von Ihrer Firma gebündelt wird","Bitten Sie die Firma oder Tradovate um Rückbuchung; der Level-I-Feed ist in Ihrer Evaluierung enthalten"],
      ["Gebühr für professionelle Daten ist aufgetaucht","Sie haben die Einstufung Professional gewählt","Wechseln Sie zu Non-Professional, wenn Sie sich qualifizieren; andernfalls fällt eine professionelle Börsengebühr an"],
      ["Daten nach Unterzeichnung und Wartezeit weiterhin verzögert","Bereitstellung ins Stocken geraten oder Berechtigung nicht aktiviert","Eskalieren Sie mit Ihrer Konto-ID an den Helpdesk der Prop-Firma"],
      ["Konto oder Daten fehlen direkt nach dem Kauf","Die Bereitstellung ist noch nicht abgeschlossen","Warten Sie das genannte Zeitfenster der Firma ab, dann ab- und wieder anmelden"],
    ] },
    { type: "heading",text: "Vorbeugen mit PickMyTrade" },
    { type: "paragraph",html: "Verzögerte Daten sind bei der Automatisierung gefährlich, denn ein Bot weiß nicht, dass ein Kurs zehn Minuten alt ist. Er feuert einfach. PickMyTrade wurde entwickelt, um den automatisierten Tradovate-Orderfluss sauber zu halten:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Bewusstsein für Berechtigungen und Datenvereinbarungen</strong> berücksichtigt den tatsächlichen Marktdaten- und Berechtigungsstatus des Kontos, statt blind auf den Preis zu handeln, der gerade auf dem Bildschirm steht.",
        "<strong class='text-white'>Risikofilter für Prop-Firmen</strong> beachten die Limits und Regeln von firmenverwalteten Evaluierungskonten, damit die Automatisierung innerhalb des Programms bleibt.",
        "<strong class='text-white'>Ratenlimit-sicheres Routing</strong> verteilt den Orderfluss so, dass bei Datenproblemen nichts an den Limits von Tradovate abprallt.",
        "<strong class='text-white'>Multi-Account-Sync</strong> spiegelt eine korrigierte, mit Live-Daten abgesicherte Order gleichzeitig auf alle verbundenen Konten.",
      ],
    },
  ], es: [
    { type: "paragraph",html: "Financió una evaluación, inició sesión en Tradovate y sus cotizaciones de ES o NQ van diez minutos por detrás del mercado. O quizá todos los nombres de símbolo aparecen en naranja en lugar de mostrar un precio en vivo. Antes de buscar un botón “Buy Market Data”, deténgase. En una cuenta de firma prop o de evaluación, <strong class='text-white'>los datos de mercado de una cuenta prop de Tradovate solo puede activarlos su proveedor de cuenta</strong>, no usted." },
    { type: "paragraph",html: "Suscribirse por su cuenta a través de Tradovate en una cuenta prop es el error más común de los traders y les hace perder horas. A veces cuesta dinero real por datos que ya había pagado. Aquí le explicamos por qué su feed aparece retrasado, qué tiene que hacer realmente su firma y el orden exacto de pasos para que las cotizaciones en vivo fluyan, de modo que una automatización como PickMyTrade nunca dispare una alerta con un precio desactualizado." },
    {
      type: "checklist",
      heading: "Lista rápida para datos retrasados en cuentas prop",
      items: [
        "<strong class='text-white'>Confirme que es una cuenta prop o de evaluación.</strong> Si inició sesión con las credenciales de evaluación de su firma, es la firma quien gestiona sus datos de mercado, no usted.",
        "<strong class='text-white'>Busque nombres de símbolo en naranja o una etiqueta “delayed”.</strong> Así indica Tradovate que el feed va con 10 minutos de retraso y no en vivo.",
        "<strong class='text-white'>Firme el acuerdo de datos Non-Professional.</strong> Los datos de CME en vivo casi siempre esperan su firma en este documento.",
        "<strong class='text-white'>No compre usted mismo los datos Top-of-Book (Level I) de CME.</strong> Ya están incluidos en lo que le paga a la firma prop.",
        "<strong class='text-white'>Espere el aprovisionamiento y luego cierre sesión y vuelva a entrar.</strong> Las nuevas suscripciones y acuerdos solo surten efecto en una sesión nueva.",
        "<strong class='text-white'>¿Sigue retrasado? Contacte con el soporte de la firma prop, no con Tradovate.</strong> Solo el proveedor de la cuenta puede activar o corregir los datos Level I en su cuenta.",
      ],
    },
    { type: "heading",text: "Qué significa “Solo su proveedor de cuenta puede activar estos datos”" },
    { type: "paragraph",html: "Tradovate es la plataforma, pero en una cuenta de evaluación o prop financiada no es dueña de su autorización de datos de mercado. Lo es su firma prop. La regla para cuentas prop y de evaluación es clara: si su cuenta pertenece a una firma prop o a un servicio de evaluación, <strong class='text-white'>los datos de mercado solo puede activarlos su proveedor de cuenta.</strong> No está previsto que se suscriba por su cuenta al feed principal de CME como lo haría un cliente minorista independiente de Tradovate." },
    { type: "paragraph",html: "En la práctica, las cuentas prop y de evaluación incluyen automáticamente datos de mercado Level I (Top-of-Book) de CME Group. El coste está incluido en lo que ya paga a su firma por la evaluación. Por eso mismo los traders prop no deberían comprar por su cuenta los datos Top-of-Book de CME. Si lo hace, paga dos veces por el mismo feed. ¿Esas pantallas de suscripción que encontró en los ajustes de Tradovate? Están pensadas para cuentas minoristas independientes, no para evaluaciones gestionadas por una firma." },
    { type: "paragraph",html: "Así que cuando las cotizaciones de su cuenta prop parecen retrasadas, casi nunca es un problema de “haga clic aquí para suscribirse”. Es una de dos cosas: un acuerdo de datos que aún debe firmar o una autorización que su firma no ha terminado de activar. Ambas tienen solución. Ninguna se arregla buscando un botón de suscripción." },
    { type: "heading",text: "Principales causas de datos retrasados en una cuenta prop" },
    { type: "heading",text: "1. Está viendo el feed retrasado de 10 minutos por defecto" },
    { type: "paragraph",html: "Cuando un inicio de sesión de Tradovate no tiene ninguna suscripción de datos en vivo activa, la plataforma ofrece cotizaciones con unos diez minutos de retraso y marca los símbolos visualmente, normalmente con <strong class='text-white'>nombres de símbolo en naranja</strong>, para avisarle de que los precios no son en vivo. Es el estado inicial normal de una evaluación nueva antes de que se aprovisionen sus datos. No es un error." },
    { type: "heading",text: "2. El acuerdo de datos Non-Professional aún no está firmado" },
    { type: "paragraph",html: "Los datos de CME en vivo requieren que acepte un acuerdo de datos de mercado <strong class='text-white'>Non-Professional</strong>. Hasta que ese documento esté firmado y procesado, su feed seguirá retrasado por mucho que espere. Omitirlo, o elegir por accidente la clasificación <strong class='text-white'>Professional</strong>, es la razón más habitual por la que un trader financiado se queda con datos retrasados." },
    { type: "heading",text: "3. Intentó suscribirse por su cuenta en lugar de dejar que la firma lo active" },
    { type: "paragraph",html: "Como las pantallas de suscripción minorista están ahí mismo en la plataforma, muchos traders prop intentan comprar el feed de CME ellos mismos. En una cuenta gestionada por una firma, esto falla, le cobra dos veces o simplemente no cambia su autorización, porque el feed Level I lo controla el proveedor, no su inicio de sesión." },
    { type: "heading",text: "4. El aprovisionamiento no ha terminado tras la compra" },
    { type: "paragraph",html: "Justo después de comprar una evaluación, la cuenta y su autorización de datos necesitan tiempo para aprovisionarse en el lado de la firma. Durante esa ventana las cotizaciones pueden ir retrasadas o la cuenta puede no aparecer correctamente. Es cuestión de tiempo, no de una mala configuración." },
    { type: "heading",text: "5. Eligió la clasificación Professional (o se aplica una tarifa de bolsa elevada)" },
    { type: "paragraph",html: "Si selecciona el estado <strong class='text-white'>Professional</strong>, las bolsas aplican una tarifa mensual considerable por datos profesionales y la activación puede atascarse. El importe exacto lo fija la bolsa y cambia con el tiempo, así que consulte las tarifas vigentes de su firma y de la bolsa. Pero para operadores individuales de tipo minorista con una evaluación personal, Non-Professional es casi siempre la elección correcta." },
    { type: "heading",text: "Cómo corregir los datos retrasados de una cuenta prop: paso a paso" },
    { type: "heading",text: "Paso 1: Confirme el tipo de cuenta y el estado actual de los datos" },
    {
      type: "steps",
      items: [
        { title: "Anote sus credenciales de acceso", html: "Anote con qué credenciales inició sesión. Si provienen del panel de evaluación de su firma prop, es una cuenta gestionada por la firma y se aplican las reglas anteriores." },
        { title: "Compruebe el color del símbolo", html: "Abra un gráfico o una lista de seguimiento y compruebe si los nombres de símbolo están en naranja o etiquetados como “delayed”. Naranja o “delayed” confirma que está en el feed de 10 minutos y que los datos en vivo aún no se han activado." },
        { title: "Descarte un problema de conexión aparte", html: "Si los símbolos ya muestran precios en vivo (sin color), sus datos están bien y cualquier retraso es un problema de conexión distinto." },
      ],
    },
    { type: "paragraph",html: "Las etiquetas de menú cambian entre versiones de Tradovate, así que abra la zona de su cuenta o de ajustes de datos de mercado y guíese por el texto que realmente aparece en su pantalla." },
    { type: "heading",text: "Paso 2: Firme el acuerdo de datos Non-Professional" },
    {
      type: "steps",
      items: [
        { title: "Abra el área del acuerdo de datos", html: "Abra el área de datos de mercado o de acuerdos de datos en los ajustes de Tradovate." },
        { title: "Seleccione Non-Professional", html: "Busque el acuerdo de datos de mercado de CME (y de cualquier otra bolsa) y seleccione la clasificación <strong class='text-white'>Non-Professional</strong>, no Professional, salvo que su firma le haya indicado lo contrario." },
        { title: "Acepte y envíe", html: "Acepte y envíe el acuerdo. Este es el paso que desbloquea los datos Level I en vivo en la mayoría de las cuentas de evaluación." },
      ],
    },
    { type: "heading",text: "Paso 3: Deje que termine el aprovisionamiento y actualice su sesión" },
    {
      type: "steps",
      items: [
        { title: "Dé tiempo al aprovisionamiento", html: "Tras firmar, dé tiempo a que se aprovisione la autorización. La activación suele ser rápida, a menudo en una o dos horas, pero en periodos de mucha carga de incorporación puede tardar más. Consulte el plazo indicado actualmente por su firma en lugar de asumir una cifra exacta." },
        { title: "Cierre sesión y vuelva a entrar en todas partes", html: "<strong class='text-white'>Cierre sesión</strong> por completo en Tradovate (web, escritorio, móvil y cualquier plataforma vinculada como TradingView o NinjaTrader) y <strong class='text-white'>vuelva a iniciar sesión</strong>. Los cambios de autorización de datos solo surten efecto en una sesión nueva." },
        { title: "Vuelva a comprobar sus símbolos", html: "Vuelva a comprobar sus símbolos. Cuando los datos en vivo están activos, desaparece el color naranja y las cotizaciones se actualizan en tiempo real." },
      ],
    },
    { type: "heading",text: "Paso 4: Escale a la firma prop, no a Tradovate" },
    {
      type: "list",
      items: [
        "Si sus datos siguen retrasados después de firmar el acuerdo y esperar toda la ventana de aprovisionamiento, la solución está en el lado del proveedor.",
        "Contacte con el soporte de su <strong class='text-white'>firma prop</strong> (Apex, Topstep y otras tienen cada una su propio centro de ayuda), no directamente con Tradovate. Solo la firma puede activar, renovar o reparar los datos Level I de CME en una cuenta que le pertenece.",
        "Facilíteles su ID de cuenta e indíqueles que ya firmó el acuerdo Non-Professional y esperó la ventana indicada. Eso le lleva directamente a una corrección de autorización en lugar de a una resolución de problemas genérica.",
      ],
    },
    { type: "quote",html: "Usted <em>sí puede</em> añadir por su cuenta datos opcionales Level II (profundidad) o complementos EUREX a una cuenta prop si lo desea. Son extras añadidos encima. Es específicamente el feed principal Level I de CME el que controla su firma y el que nunca debería comprar por separado." },
    { type: "heading",text: "Tabla de resolución de problemas" },
    { type: "table", headers: ["Síntoma / mensaje","Qué significa","Solución"], rows: [
      ["Nombres de símbolo en naranja en una cuenta prop","No hay ninguna suscripción de datos en vivo activa; el feed va con unos 10 minutos de retraso","Firme el acuerdo Non-Professional, espere el aprovisionamiento y luego cierre sesión y vuelva a entrar"],
      ["Las cotizaciones van con unos 10 minutos de retraso","Feed retrasado por defecto, datos en vivo aún no activados","Igual que arriba; confirme que el acuerdo se procesó"],
      ["“Market data can only be enabled by your account provider”","Está en una cuenta de evaluación gestionada por una firma","No se suscriba por su cuenta; contacte con la firma prop para que active los datos Level I"],
      ["Le cobraron los datos Top-of-Book de CME","Se suscribió a un feed que su firma ya incluye","Pida a la firma o a Tradovate que lo revierta; el feed Level I está incluido en su evaluación"],
      ["Apareció una tarifa de datos profesionales","Seleccionó la clasificación Professional","Cambie a Non-Professional si cumple los requisitos; de lo contrario se aplica una tarifa profesional de bolsa"],
      ["Datos aún retrasados tras firmar y esperar","Aprovisionamiento detenido o autorización no activada","Escale al centro de ayuda de la firma prop con su ID de cuenta"],
      ["Cuenta o datos ausentes justo después de la compra","El aprovisionamiento aún no ha terminado","Espere la ventana indicada por la firma y luego cierre sesión y vuelva a entrar"],
    ] },
    { type: "heading",text: "Prevéngalo con PickMyTrade" },
    { type: "paragraph",html: "Los datos retrasados son peligrosos cuando automatiza, porque un bot no sabe que una cotización tiene diez minutos de antigüedad. Simplemente dispara. PickMyTrade está diseñado para mantener honesto el flujo de órdenes automatizado de Tradovate:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Conocimiento de autorizaciones y acuerdos de datos</strong> respeta el estado real de datos de mercado y autorización de la cuenta en lugar de operar a ciegas con el precio que haya en pantalla.",
        "<strong class='text-white'>Filtros de riesgo para firmas prop</strong> respetan los límites y las reglas de las cuentas de evaluación gestionadas por firmas para que la automatización se mantenga dentro del programa.",
        "<strong class='text-white'>Enrutamiento seguro frente a límites de tasa</strong> espacia el flujo de órdenes para que nada rebote en los límites de Tradovate durante fallos de datos.",
        "<strong class='text-white'>Sincronización multicuenta</strong> replica una orden corregida y respaldada por datos en vivo en todas las cuentas conectadas a la vez.",
      ],
    },
  ], fr: [
    { type: "paragraph",html: "Vous avez financé une évaluation, vous vous êtes connecté à Tradovate, et vos cotations ES ou NQ sont figées dix minutes derrière le marché. Ou peut-être que chaque nom de symbole s'affiche en orange au lieu d'un prix en direct. Avant de chercher un bouton « Buy Market Data », arrêtez-vous. Sur un compte de firme prop ou d'évaluation, <strong class='text-white'>les données de marché d'un compte prop Tradovate ne peuvent être activées que par votre fournisseur de compte</strong>, pas par vous." },
    { type: "paragraph",html: "Souscrire par vous-même via Tradovate pour un compte prop est l'erreur la plus courante des traders, et elle fait perdre des heures. Parfois, elle coûte de l'argent réel pour des données que vous aviez déjà payées. Voici pourquoi votre flux apparaît retardé, ce que votre firme doit réellement faire, et l'ordre exact des étapes pour que les cotations en direct arrivent, afin qu'une automatisation comme PickMyTrade ne déclenche jamais une alerte sur un prix périmé." },
    {
      type: "checklist",
      heading: "Liste de contrôle rapide pour des données retardées sur un compte prop",
      items: [
        "<strong class='text-white'>Confirmez qu'il s'agit d'un compte prop ou d'évaluation.</strong> Si vous vous êtes connecté avec les identifiants d'évaluation de votre firme, c'est elle qui gère vos données de marché, pas vous.",
        "<strong class='text-white'>Repérez les noms de symboles en orange ou une mention « delayed ».</strong> C'est Tradovate qui vous indique que le flux est retardé de 10 minutes et non en direct.",
        "<strong class='text-white'>Signez l'accord de données Non-Professional.</strong> Les données CME en direct attendent presque toujours votre signature sur ce document.",
        "<strong class='text-white'>N'achetez pas vous-même les données CME Top-of-Book (Level I).</strong> Elles sont déjà incluses dans ce que vous payez à la firme prop.",
        "<strong class='text-white'>Attendez le provisionnement, puis déconnectez-vous et reconnectez-vous.</strong> Les nouveaux abonnements et accords ne prennent effet que lors d'une nouvelle session.",
        "<strong class='text-white'>Toujours retardé ? Contactez le support de la firme prop, pas Tradovate.</strong> Seul le fournisseur du compte peut activer ou corriger les données Level I sur votre compte.",
      ],
    },
    { type: "heading",text: "Ce que signifie « Seul votre fournisseur de compte peut activer ces données »" },
    { type: "paragraph",html: "Tradovate est la plateforme, mais sur un compte d'évaluation ou prop financé, elle ne possède pas votre droit d'accès aux données de marché. C'est votre firme prop qui le possède. La règle pour les comptes prop et d'évaluation est simple : si votre compte relève d'une firme prop ou d'un service d'évaluation, <strong class='text-white'>les données de marché ne peuvent être activées que par votre fournisseur de compte.</strong> Vous n'êtes pas censé souscrire vous-même au flux principal CME comme le ferait un client particulier autonome de Tradovate." },
    { type: "paragraph",html: "En pratique, les comptes prop et d'évaluation incluent automatiquement les données de marché CME Group Level I (Top-of-Book). Le coût est intégré à ce que vous payez déjà à votre firme pour l'évaluation. C'est précisément pourquoi les traders prop ne devraient pas acheter eux-mêmes les données CME Top-of-Book. Si vous le faites, vous payez deux fois le même flux. Ces écrans de souscription enfouis dans les paramètres de Tradovate ? Ils sont conçus pour des comptes particuliers autonomes, pas pour des évaluations gérées par une firme." },
    { type: "paragraph",html: "Donc, lorsque les cotations de votre compte prop semblent retardées, ce n'est presque jamais un problème de type « cliquez ici pour souscrire ». C'est l'une de deux choses : un accord de données que vous devez encore signer, ou un droit d'accès que votre firme n'a pas fini d'activer. Les deux se corrigent. Aucune ne se règle en cherchant un bouton d'abonnement." },
    { type: "heading",text: "Principales causes de données retardées sur un compte prop" },
    { type: "heading",text: "1. Vous voyez le flux retardé de 10 minutes par défaut" },
    { type: "paragraph",html: "Lorsqu'une connexion Tradovate n'a aucun abonnement de données en direct actif, la plateforme sert des cotations retardées d'environ dix minutes et signale visuellement les symboles, généralement par des <strong class='text-white'>noms de symboles en orange</strong>, pour vous avertir que les prix ne sont pas en direct. C'est l'état de départ normal d'une évaluation toute neuve, avant que vos données soient provisionnées. Ce n'est pas un bug." },
    { type: "heading",text: "2. L'accord de données Non-Professional n'est pas encore signé" },
    { type: "paragraph",html: "Les données CME en direct exigent que vous acceptiez un accord de données de marché <strong class='text-white'>Non-Professional</strong>. Tant que ce document n'est pas signé et traité, votre flux reste retardé, quel que soit le temps d'attente. L'ignorer, ou choisir par erreur la classification <strong class='text-white'>Professional</strong>, est la raison la plus fréquente pour laquelle un trader financé reste bloqué sur des données retardées." },
    { type: "heading",text: "3. Vous avez essayé de souscrire vous-même au lieu de laisser la firme l'activer" },
    { type: "paragraph",html: "Comme les écrans de souscription pour particuliers sont juste là dans la plateforme, beaucoup de traders prop tentent d'acheter eux-mêmes le flux CME. Sur un compte géré par une firme, cela échoue, vous facture deux fois ou ne modifie tout simplement pas votre droit d'accès, car le flux Level I est contrôlé par le fournisseur, pas par votre identifiant." },
    { type: "heading",text: "4. Le provisionnement n'est pas terminé après l'achat" },
    { type: "paragraph",html: "Juste après l'achat d'une évaluation, le compte et son droit d'accès aux données ont besoin de temps pour être provisionnés côté firme. Pendant cette fenêtre, les cotations peuvent être retardées ou le compte peut ne pas s'afficher correctement. C'est une question de délai, pas une erreur de configuration." },
    { type: "heading",text: "5. Vous avez choisi la classification Professional (ou des frais de bourse élevés s'appliquent)" },
    { type: "paragraph",html: "Si vous sélectionnez le statut <strong class='text-white'>Professional</strong>, les bourses appliquent des frais mensuels substantiels pour les données professionnelles, et l'activation peut se bloquer. Le montant exact est fixé par la bourse et évolue avec le temps, vérifiez donc les tarifs actuels de votre firme et de la bourse. Mais pour les traders particuliers disposant d'une évaluation personnelle, Non-Professional est presque toujours le bon choix." },
    { type: "heading",text: "Comment corriger des données retardées sur un compte prop : pas à pas" },
    { type: "heading",text: "Étape 1 : Confirmez le type de compte et l'état actuel des données" },
    {
      type: "steps",
      items: [
        { title: "Notez vos identifiants de connexion", html: "Notez les identifiants que vous avez utilisés pour vous connecter. S'ils proviennent du tableau de bord d'évaluation de votre firme prop, il s'agit d'un compte géré par la firme et les règles ci-dessus s'appliquent." },
        { title: "Vérifiez la couleur des symboles", html: "Ouvrez un graphique ou une liste de suivi et vérifiez si les noms de symboles sont en orange ou marqués « delayed ». Orange ou « delayed » confirme que vous êtes sur le flux de 10 minutes et que les données en direct ne sont pas encore activées." },
        { title: "Écartez un problème de connexion distinct", html: "Si les symboles affichent déjà des prix en direct (sans couleur), vos données sont correctes et tout décalage est un problème de connexion distinct." },
      ],
    },
    { type: "paragraph",html: "Les libellés de menu changent d'une version de Tradovate à l'autre : ouvrez donc la zone de votre compte ou des paramètres de données de marché et fiez-vous aux termes réellement affichés à l'écran." },
    { type: "heading",text: "Étape 2 : Signez l'accord de données Non-Professional" },
    {
      type: "steps",
      items: [
        { title: "Ouvrez la zone de l'accord de données", html: "Ouvrez la zone des données de marché ou des accords de données dans vos paramètres Tradovate." },
        { title: "Sélectionnez Non-Professional", html: "Trouvez l'accord de données de marché CME (et de toute autre bourse) et sélectionnez la classification <strong class='text-white'>Non-Professional</strong>, pas Professional, sauf si votre firme vous a indiqué le contraire." },
        { title: "Acceptez et soumettez", html: "Acceptez et soumettez l'accord. C'est l'étape qui débloque les données Level I en direct sur la plupart des comptes d'évaluation." },
      ],
    },
    { type: "heading",text: "Étape 3 : Laissez le provisionnement se terminer, puis actualisez votre session" },
    {
      type: "steps",
      items: [
        { title: "Laissez le temps au provisionnement", html: "Après la signature, laissez au droit d'accès le temps d'être provisionné. L'activation est généralement rapide, souvent dans l'heure ou les deux heures, mais lors des périodes d'intégration chargées elle peut être plus longue. Vérifiez le délai actuellement indiqué par votre firme plutôt que de supposer un chiffre exact." },
        { title: "Déconnectez-vous et reconnectez-vous partout", html: "<strong class='text-white'>Déconnectez-vous</strong> complètement de Tradovate (web, bureau, mobile et toute plateforme liée comme TradingView ou NinjaTrader), puis <strong class='text-white'>reconnectez-vous</strong>. Les changements de droits d'accès aux données ne prennent effet que lors d'une nouvelle session." },
        { title: "Revérifiez vos symboles", html: "Revérifiez vos symboles. Lorsque les données en direct sont actives, la couleur orange disparaît et les cotations se mettent à jour en temps réel." },
      ],
    },
    { type: "heading",text: "Étape 4 : Escaladez auprès de la firme prop, pas de Tradovate" },
    {
      type: "list",
      items: [
        "Si vos données sont toujours retardées après avoir signé l'accord et attendu toute la fenêtre de provisionnement, la solution se trouve côté fournisseur.",
        "Contactez le support de votre <strong class='text-white'>firme prop</strong> (Apex, Topstep et d'autres disposent chacune de leur propre service d'assistance), pas directement Tradovate. Seule la firme peut activer, renouveler ou réparer les données CME Level I sur un compte qui lui appartient.",
        "Donnez-leur votre identifiant de compte et indiquez que vous avez déjà signé l'accord Non-Professional et attendu la fenêtre annoncée. Cela vous mène directement à une correction du droit d'accès plutôt qu'à un dépannage générique.",
      ],
    },
    { type: "quote",html: "Vous <em>pouvez</em> toujours ajouter vous-même des données optionnelles Level II (profondeur) ou des modules complémentaires EUREX à un compte prop si vous le souhaitez. Ce sont des options en supplément. C'est spécifiquement le flux principal CME Level I que votre firme contrôle et que vous ne devriez jamais acheter séparément." },
    { type: "heading",text: "Tableau de dépannage" },
    { type: "table", headers: ["Symptôme / message","Signification","Solution"], rows: [
