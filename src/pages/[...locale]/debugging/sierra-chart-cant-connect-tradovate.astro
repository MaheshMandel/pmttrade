---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "sierra-chart-cant-connect-tradovate";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/debugging/${SLUG}`;

const META_TITLE = "Sierra Chart Can't Connect to Tradovate Accounts";
const META_DESCRIPTION =
  "New Sierra Chart to Tradovate connections are blocked. Learn how to route orders through Teton with a supported broker and get live CME futures data.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Sierra Chart kann keine Verbindung zu Tradovate-Konten herstellen", es: "Sierra Chart no puede conectarse a cuentas de Tradovate", fr: "Sierra Chart ne parvient pas à se connecter aux comptes Tradovate", it: "Sierra Chart non riesce a connettersi agli account Tradovate" },
  dek: { en: "Sierra Chart doesn't list Tradovate as a connection, and re-entering credentials or reinstalling won't change that. Here's what actually changed, and how to get a working Sierra Chart setup instead.", de: "Sierra Chart führt Tradovate nicht als Verbindung auf, und weder erneute Eingabe der Zugangsdaten noch eine Neuinstallation ändern daran etwas. Hier erfahren Sie, was sich tatsächlich geändert hat und wie Sie stattdessen ein funktionierendes Sierra-Chart-Setup erhalten.", es: "Sierra Chart no incluye Tradovate como conexión, y volver a introducir las credenciales o reinstalar no lo cambiará. Aquí le explicamos qué cambió realmente y cómo conseguir una configuración de Sierra Chart que funcione.", fr: "Sierra Chart ne propose pas Tradovate comme connexion, et ressaisir vos identifiants ou réinstaller ne changera rien. Voici ce qui a réellement changé et comment obtenir une configuration Sierra Chart fonctionnelle.", it: "Sierra Chart non elenca Tradovate tra le connessioni, e reinserire le credenziali o reinstallare non cambierà nulla. Ecco cosa è cambiato davvero e come ottenere una configurazione Sierra Chart funzionante." },
  readTime: { en: "8 min read", de: "8 Min. Lesezeit", es: "Lectura de 8 min", fr: "Lecture : 8 min", it: "Lettura di 8 min" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "You set up Sierra Chart, go looking for Tradovate in the list of trading services, and it just isn't there as an option you can select. Or you try to link an Apex, Topstep or other Tradovate-cleared prop account and the connection never completes. Here's the blunt truth: this isn't a bug you can fix in your settings. <strong class='text-white'>New Tradovate-to-Sierra Chart connections are blocked.</strong> Tradovate made a business decision not to provision connectivity for customer accounts with Sierra Chart, so no amount of re-entering credentials or reinstalling will force it. The working path in 2026 is to route your orders through Sierra Chart's own <strong class='text-white'>Teton</strong> service using a broker that supports it, and to pull market data from the <strong class='text-white'>Denali</strong> feed. Below is exactly what changed, why, and how to get a fully working Sierra Chart setup without Tradovate in the middle." },
    {
      type: "checklist",
      heading: "The Short Version",
      items: [
        "<strong class='text-white'>You can't create a new Tradovate connection in Sierra Chart.</strong> Tradovate declined to set up this connectivity, so it's not a settings problem on your end.",
        "<strong class='text-white'>Existing connections may be grandfathered.</strong> If you were already linked before the change, you'll often keep working. New accounts are the ones that get turned away.",
        "<strong class='text-white'>Prop accounts on Tradovate hit the same wall.</strong> Apex, Topstep and similar evaluation or funded accounts that clear through Tradovate can't be linked to Sierra Chart as a new connection.",
        "<strong class='text-white'>The fix is Teton routing with a supported broker.</strong> Open or use an account at a futures broker that offers Sierra Chart's Teton order routing, then trade that account instead.",
        "<strong class='text-white'>You'll use the Denali feed for market data.</strong> Sierra Chart no longer sources CME and EUREX data from CQG, so live quotes come through Denali.",
      ],
    },
    { type: "heading", text: "Why Sierra Chart Won't Connect to Your Tradovate Account" },
    { type: "paragraph", html: "This one confuses a lot of people because Sierra Chart is a top-tier charting and DOM platform, and Tradovate is a popular futures broker, so it seems like they should just talk to each other. They don't, and the reason sits on Tradovate's side, not Sierra Chart's. Tradovate has stated plainly that it made a business decision not to set up connectivity for customer accounts with Sierra Chart. Sierra Chart's own engineering team echoes this: linking a Tradovate account, including a prop firm account that runs on Tradovate, is simply not possible for new users." },
    { type: "paragraph", html: "So when Tradovate doesn't appear as a selectable trading service, or the connection stalls, nothing on your machine is broken. The gate is a business policy between the two companies. That also means the usual troubleshooting reflexes (clear the cache, reinstall, re-type the password, sync the clock) won't do anything here. The connection was never going to be offered in the first place." },
    { type: "heading", text: "What This Means for Prop Firm Accounts" },
    { type: "paragraph", html: "A big share of the people running into this are prop traders. Firms like Apex Trader Funding and others issue evaluation and funded accounts that clear through Tradovate, and those accounts inherit Tradovate's rules. When you ask Sierra Chart to connect one, you get the same answer as a retail Tradovate user: it can't be done as a new connection. The limitation isn't the prop firm being difficult, and it isn't Sierra Chart lacking a feature. It's the Tradovate layer underneath the account." },
    { type: "paragraph", html: "If you're on a prop account, you have two honest choices. Either keep Tradovate as your execution venue and drive it from a platform that <em>is</em> allowed to connect (TradingView being the common one), or run your evaluation with a firm whose accounts clear through a broker that supports Sierra Chart's Teton routing. Rules, account naming and what each firm allows vary quite a bit, so check your firm's current terms before you buy or switch." },
    { type: "heading", text: "The Fix: Route Through Teton With a Supported Broker" },
    { type: "paragraph", html: "Sierra Chart's recommended replacement for a broker-specific connection is its <strong class='text-white'>Teton Futures Order Routing Service</strong>. Teton sends your orders straight to the exchange with very low latency and, importantly, no per-contract routing fee on top of your Sierra Chart subscription and your broker's normal commissions. It covers the CME Group markets (CME, CBOT, NYMEX, COMEX). The catch is that Teton runs through a brokerage account at a firm that has enabled it, so the move is to trade a Teton-supported broker account rather than a Tradovate one." },
    { type: "heading", text: "Step 1: Pick a Broker That Supports Teton" },
    { type: "paragraph", html: "Teton is offered through a range of futures brokers and clearing firms. Names that support it include AMP, Ironbeam, Optimus Futures, Edge Clear and Stage 5, among others. Open (or use an existing) account at one of them and ask specifically for Sierra Chart Teton order routing. Inside Sierra Chart, you then select the Teton entry for that broker as your trading service instead of hunting for Tradovate. Because the participating-broker list shifts over time, confirm the current lineup with Sierra Chart or the broker before you fund anything." },
    { type: "heading", text: "Step 2: Turn On the Denali Data Feed for CME Quotes" },
    { type: "paragraph", html: "Order routing gets your trades to the exchange, but you still need prices on your charts and DOM. Sierra Chart no longer serves CME Group and EUREX data through CQG, so live market data comes from the <strong class='text-white'>Denali Exchange Data Feed</strong>. In Sierra Chart's data and trade service settings you enable Denali and choose the exchange packages you want (CME, CBOT, NYMEX, COMEX for most futures traders). This is the piece that replaces any expectation of pulling a data stream out of Tradovate, which was never available through Sierra Chart anyway." },
    { type: "heading", text: "Step 3: Clear the Non-Professional Data Check" },
    { type: "paragraph", html: "The CME requires a live, funded futures trading account to grant non-professional data rates, and Sierra Chart has to verify that. You connect Sierra Chart to that live account at least once a month so the non-professional status stays valid. If you're constantly connected to your live account, that check happens on its own. Worth knowing: a Tradovate account is generally not accepted for this verification, so you either use a live funded account with a supported broker, or take Sierra Chart's low-balance account option (a small funded account, on the order of a hundred dollars) purely to satisfy the CME requirement. Check the exact current numbers and steps in Sierra Chart's documentation, since fees and thresholds change." },
    { type: "heading", text: "What About the Old CQG Workaround?" },
    { type: "paragraph", html: "You'll still find older advice suggesting you connect to a Tradovate-cleared account through a CQG login. Be careful with it. Sierra Chart no longer supports data from CQG for the CME Group and EUREX exchanges, and Tradovate has not enabled CQG connectivity for Sierra Chart customer accounts, so this isn't a clean route for a new setup. Even where a CQG order connection is possible, your charts would still need the Denali feed for CME data. Treat CQG as a legacy path, not the answer, and verify anything you read about it directly with Sierra Chart and your broker before you count on it." },
    { type: "heading", text: "Your Options at a Glance" },
    {
      type: "table",
      headers: ["What you want", "Does it work?", "What to do"],
      rows: [
        ["New Tradovate account into Sierra Chart", "No", "Blocked by Tradovate policy; use Teton with a supported broker instead"],
        ["Prop (Apex, Topstep, etc.) Tradovate account into Sierra Chart", "No", "Same block; automate the Tradovate account from TradingView, or use a Teton-supported firm"],
        ["Existing, already-linked Tradovate connection", "Often yes (grandfathered)", "Keep using it; confirm with Sierra Chart if it's mission-critical"],
        ["Live CME data in Sierra Chart", "Yes", "Enable the Denali feed and clear the non-professional check with a live funded account"],
        ["Zero-routing-fee execution in Sierra Chart", "Yes", "Use Teton order routing through a participating broker"],
        ["Keep Tradovate as your broker, automate the strategy", "Yes", "Route TradingView alerts to Tradovate instead of charting from Sierra Chart"],
      ],
    },
    { type: "heading", text: "If You'd Rather Keep Tradovate as Your Account" },
    { type: "paragraph", html: "Plenty of traders don't actually care which charting app they use. They care that a strategy runs on their Tradovate or prop account. If that's you, switching brokers just to satisfy Sierra Chart is a big move for a small reason. The cleaner answer is to keep Tradovate as your execution venue and feed it from a platform Tradovate <em>does</em> allow, then let automation carry the orders across." },
    { type: "paragraph", html: "That's the gap PickMyTrade fills. It takes your TradingView alerts and routes them straight to your Tradovate account, so your Tradovate or prop firm account stays exactly where it is while your signals still fire automatically:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Alerts straight to Tradovate</strong> means your strategy reaches the account Sierra Chart can't connect to, without changing brokers.",
        "<strong class='text-white'>Prop-account friendly routing</strong> keeps your Apex, Topstep or similar Tradovate-based account as the execution venue.",
        "<strong class='text-white'>Multi-account sync</strong> mirrors the same order across several Tradovate accounts at once, which is handy when you run more than one evaluation.",
        "<strong class='text-white'>Hands-off execution</strong> means you're not stuck manually copying trades because your preferred charting platform won't link.",
      ],
    },
  ], de: [
    { type: "paragraph",html: "Sie richten Sierra Chart ein, suchen in der Liste der Handelsdienste nach Tradovate, und es steht dort schlicht nicht zur Auswahl. Oder Sie versuchen, ein Apex-, Topstep- oder anderes über Tradovate abgewickeltes Prop-Konto zu verknüpfen, und die Verbindung kommt nie zustande. Die ehrliche Wahrheit lautet: Das ist kein Fehler, den Sie in Ihren Einstellungen beheben können. <strong class='text-white'>Neue Verbindungen zwischen Tradovate und Sierra Chart sind gesperrt.</strong> Tradovate hat aus geschäftlichen Gründen entschieden, keine Konnektivität für Kundenkonten mit Sierra Chart bereitzustellen, und kein erneutes Eingeben von Zugangsdaten oder Neuinstallieren kann das erzwingen. Der funktionierende Weg im Jahr 2026 besteht darin, Ihre Orders über den eigenen <strong class='text-white'>Teton</strong>-Dienst von Sierra Chart mit einem unterstützenden Broker zu routen und Marktdaten über den <strong class='text-white'>Denali</strong>-Feed zu beziehen. Nachfolgend sehen Sie genau, was sich geändert hat, warum, und wie Sie ein voll funktionsfähiges Sierra-Chart-Setup ohne Tradovate dazwischen aufbauen." },
    {
      type: "checklist",
      heading: "Die Kurzfassung",
      items: [
        "<strong class='text-white'>Sie können in Sierra Chart keine neue Tradovate-Verbindung erstellen.</strong> Tradovate hat sich gegen die Einrichtung dieser Konnektivität entschieden, es handelt sich also nicht um ein Einstellungsproblem auf Ihrer Seite.",
        "<strong class='text-white'>Bestehende Verbindungen genießen möglicherweise Bestandsschutz.</strong> Wenn Sie vor der Änderung bereits verknüpft waren, funktioniert es oft weiter. Abgewiesen werden neue Konten.",
        "<strong class='text-white'>Prop-Konten bei Tradovate stoßen auf dieselbe Wand.</strong> Apex-, Topstep- und ähnliche Evaluierungs- oder Funded-Konten, die über Tradovate abgewickelt werden, lassen sich nicht als neue Verbindung mit Sierra Chart verknüpfen.",
        "<strong class='text-white'>Die Lösung ist Teton-Routing mit einem unterstützten Broker.</strong> Eröffnen oder nutzen Sie ein Konto bei einem Futures-Broker, der das Teton-Order-Routing von Sierra Chart anbietet, und handeln Sie stattdessen über dieses Konto.",
        "<strong class='text-white'>Für Marktdaten nutzen Sie den Denali-Feed.</strong> Sierra Chart bezieht CME- und EUREX-Daten nicht mehr von CQG, daher laufen Live-Kurse über Denali.",
      ],
    },
    { type: "heading",text: "Warum sich Sierra Chart nicht mit Ihrem Tradovate-Konto verbindet" },
    { type: "paragraph",html: "Das verwirrt viele, denn Sierra Chart ist eine erstklassige Charting- und DOM-Plattform und Tradovate ein beliebter Futures-Broker, sodass man annimmt, die beiden müssten einfach miteinander sprechen. Tun sie aber nicht, und der Grund liegt auf Seiten von Tradovate, nicht von Sierra Chart. Tradovate hat klar erklärt, aus geschäftlichen Gründen keine Konnektivität für Kundenkonten mit Sierra Chart einzurichten. Das Entwicklerteam von Sierra Chart bestätigt dies: Die Verknüpfung eines Tradovate-Kontos, auch eines Prop-Firm-Kontos auf Tradovate-Basis, ist für neue Nutzer schlicht nicht möglich." },
    { type: "paragraph",html: "Wenn Tradovate also nicht als auswählbarer Handelsdienst erscheint oder die Verbindung hängen bleibt, ist auf Ihrem Rechner nichts defekt. Die Hürde ist eine geschäftliche Vorgabe zwischen den beiden Unternehmen. Das heißt auch, dass die üblichen Reflexe bei der Fehlersuche (Cache leeren, neu installieren, Passwort neu eingeben, Uhr synchronisieren) hier nichts bewirken. Die Verbindung wurde von vornherein nie angeboten." },
    { type: "heading",text: "Was das für Prop-Firm-Konten bedeutet" },
    { type: "paragraph",html: "Ein großer Teil der Betroffenen sind Prop-Trader. Firmen wie Apex Trader Funding und andere vergeben Evaluierungs- und Funded-Konten, die über Tradovate abgewickelt werden, und diese Konten übernehmen die Regeln von Tradovate. Wenn Sie Sierra Chart bitten, eines davon zu verbinden, erhalten Sie dieselbe Antwort wie ein privater Tradovate-Nutzer: Als neue Verbindung ist das nicht möglich. Die Einschränkung liegt nicht an einer schwierigen Prop Firm und nicht an einer fehlenden Funktion von Sierra Chart. Es ist die Tradovate-Ebene unter dem Konto." },
    { type: "paragraph",html: "Wenn Sie ein Prop-Konto nutzen, haben Sie zwei ehrliche Optionen. Entweder behalten Sie Tradovate als Ausführungsplattform und steuern es über eine Plattform an, die sich verbinden <em>darf</em> (häufig TradingView), oder Sie absolvieren Ihre Evaluierung bei einer Firma, deren Konten über einen Broker abgewickelt werden, der das Teton-Routing von Sierra Chart unterstützt. Regeln, Kontobezeichnungen und das, was jede Firma erlaubt, unterscheiden sich deutlich. Prüfen Sie daher die aktuellen Bedingungen Ihrer Firma, bevor Sie kaufen oder wechseln." },
    { type: "heading",text: "Die Lösung: Über Teton mit einem unterstützten Broker routen" },
    { type: "paragraph",html: "Der von Sierra Chart empfohlene Ersatz für eine brokerspezifische Verbindung ist der <strong class='text-white'>Teton Futures Order Routing Service</strong>. Teton sendet Ihre Orders mit sehr geringer Latenz direkt an die Börse und erhebt, was wichtig ist, keine Routing-Gebühr pro Kontrakt zusätzlich zu Ihrem Sierra-Chart-Abonnement und den üblichen Provisionen Ihres Brokers. Es deckt die CME-Group-Märkte ab (CME, CBOT, NYMEX, COMEX). Der Haken: Teton läuft über ein Brokerkonto bei einer Firma, die es aktiviert hat. Sie handeln also über ein von Teton unterstütztes Broker-Konto statt über ein Tradovate-Konto." },
    { type: "heading",text: "Schritt 1: Einen Broker wählen, der Teton unterstützt" },
    { type: "paragraph",html: "Teton wird über eine Reihe von Futures-Brokern und Clearing-Firmen angeboten. Zu den unterstützenden Namen zählen unter anderem AMP, Ironbeam, Optimus Futures, Edge Clear und Stage 5. Eröffnen Sie ein Konto bei einem von ihnen (oder nutzen Sie ein bestehendes) und fragen Sie gezielt nach dem Sierra-Chart-Teton-Order-Routing. In Sierra Chart wählen Sie dann den Teton-Eintrag dieses Brokers als Handelsdienst aus, anstatt nach Tradovate zu suchen. Da sich die Liste der teilnehmenden Broker im Lauf der Zeit ändert, bestätigen Sie die aktuelle Aufstellung bei Sierra Chart oder dem Broker, bevor Sie etwas einzahlen." },
    { type: "heading",text: "Schritt 2: Den Denali-Datenfeed für CME-Kurse aktivieren" },
    { type: "paragraph",html: "Das Order-Routing bringt Ihre Trades an die Börse, aber Sie benötigen weiterhin Kurse in Ihren Charts und im DOM. Sierra Chart liefert CME-Group- und EUREX-Daten nicht mehr über CQG, daher kommen Live-Marktdaten vom <strong class='text-white'>Denali Exchange Data Feed</strong>. In den Daten- und Handelsdiensteinstellungen von Sierra Chart aktivieren Sie Denali und wählen die gewünschten Börsenpakete (für die meisten Futures-Trader CME, CBOT, NYMEX, COMEX). Dies ersetzt die Erwartung, einen Datenstrom aus Tradovate zu beziehen, der über Sierra Chart ohnehin nie verfügbar war." },
    { type: "heading",text: "Schritt 3: Die Prüfung für Nicht-Profi-Daten bestehen" },
    { type: "paragraph",html: "Die CME verlangt ein aktives, finanziertes Futures-Handelskonto, um Nicht-Profi-Datentarife zu gewähren, und Sierra Chart muss dies verifizieren. Sie verbinden Sierra Chart mindestens einmal im Monat mit diesem aktiven Konto, damit der Nicht-Profi-Status gültig bleibt. Sind Sie ständig mit Ihrem Live-Konto verbunden, erfolgt diese Prüfung von selbst. Wichtig zu wissen: Ein Tradovate-Konto wird für diese Verifizierung in der Regel nicht akzeptiert. Sie nutzen also entweder ein aktives, finanziertes Konto bei einem unterstützten Broker oder die Low-Balance-Konto-Option von Sierra Chart (ein kleines finanziertes Konto in der Größenordnung von hundert Dollar), allein um die CME-Anforderung zu erfüllen. Prüfen Sie die genauen aktuellen Beträge und Schritte in der Dokumentation von Sierra Chart, da sich Gebühren und Schwellenwerte ändern." },
    { type: "heading",text: "Was ist mit dem alten CQG-Workaround?" },
    { type: "paragraph",html: "Sie finden weiterhin ältere Ratschläge, sich über einen CQG-Login mit einem über Tradovate abgewickelten Konto zu verbinden. Seien Sie damit vorsichtig. Sierra Chart unterstützt keine Daten von CQG mehr für die CME Group und EUREX, und Tradovate hat die CQG-Konnektivität für Sierra-Chart-Kundenkonten nicht aktiviert, sodass dies für ein neues Setup kein sauberer Weg ist. Selbst wo eine CQG-Order-Verbindung möglich ist, benötigen Ihre Charts für CME-Daten weiterhin den Denali-Feed. Betrachten Sie CQG als Altlösung, nicht als Antwort, und klären Sie alles, was Sie dazu lesen, direkt mit Sierra Chart und Ihrem Broker, bevor Sie darauf bauen." },
    { type: "heading",text: "Ihre Optionen im Überblick" },
    { type: "table", headers: ["Was Sie möchten","Funktioniert es?","Was zu tun ist"], rows: [
      ["Neues Tradovate-Konto in Sierra Chart","Nein","Durch Tradovate-Richtlinie gesperrt; stattdessen Teton mit einem unterstützten Broker nutzen"],
      ["Prop-Konto (Apex, Topstep usw.) bei Tradovate in Sierra Chart","Nein","Gleiche Sperre; das Tradovate-Konto von TradingView aus automatisieren oder eine von Teton unterstützte Firma nutzen"],
      ["Bestehende, bereits verknüpfte Tradovate-Verbindung","Oft ja (Bestandsschutz)","Weiter nutzen; bei geschäftskritischem Einsatz bei Sierra Chart bestätigen lassen"],
      ["Live-CME-Daten in Sierra Chart","Ja","Denali-Feed aktivieren und die Nicht-Profi-Prüfung mit einem aktiven, finanzierten Konto bestehen"],
      ["Ausführung ohne Routing-Gebühr in Sierra Chart","Ja","Teton-Order-Routing über einen teilnehmenden Broker nutzen"],
      ["Tradovate als Broker behalten und die Strategie automatisieren","Ja","TradingView-Alerts an Tradovate routen, statt von Sierra Chart aus zu chartten"],
    ] },
    { type: "heading",text: "Wenn Sie Tradovate lieber als Konto behalten möchten" },
    { type: "paragraph",html: "Vielen Tradern ist es eigentlich egal, welche Charting-App sie nutzen. Wichtig ist ihnen, dass eine Strategie auf ihrem Tradovate- oder Prop-Konto läuft. Wenn das auf Sie zutrifft, ist ein Brokerwechsel nur zur Zufriedenstellung von Sierra Chart ein großer Schritt aus einem kleinen Grund. Die sauberere Antwort: Behalten Sie Tradovate als Ausführungsplattform und speisen Sie es von einer Plattform aus, die Tradovate <em>zulässt</em>, und lassen Sie die Automatisierung die Orders übertragen." },
    { type: "paragraph",html: "Genau diese Lücke schließt PickMyTrade. Es nimmt Ihre TradingView-Alerts und routet sie direkt an Ihr Tradovate-Konto, sodass Ihr Tradovate- oder Prop-Firm-Konto genau dort bleibt, wo es ist, während Ihre Signale weiterhin automatisch ausgelöst werden:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Alerts direkt an Tradovate</strong> bedeutet, dass Ihre Strategie das Konto erreicht, mit dem sich Sierra Chart nicht verbinden kann, ohne dass Sie den Broker wechseln.",
        "<strong class='text-white'>Prop-Konto-freundliches Routing</strong> behält Ihr Apex-, Topstep- oder ähnliches Tradovate-basiertes Konto als Ausführungsplattform.",
        "<strong class='text-white'>Multi-Account-Synchronisierung</strong> spiegelt dieselbe Order gleichzeitig auf mehrere Tradovate-Konten, was praktisch ist, wenn Sie mehr als eine Evaluierung betreiben.",
        "<strong class='text-white'>Freihändige Ausführung</strong> bedeutet, dass Sie Trades nicht manuell kopieren müssen, nur weil Ihre bevorzugte Charting-Plattform sich nicht verknüpfen lässt.",
      ],
    },
  ], es: [
    { type: "paragraph",html: "Configura Sierra Chart, busca Tradovate en la lista de servicios de trading y simplemente no aparece como opción seleccionable. O intenta vincular una cuenta de Apex, Topstep u otra prop firm compensada por Tradovate y la conexión nunca se completa. La verdad sin rodeos: no es un error que pueda corregir en sus ajustes. <strong class='text-white'>Las nuevas conexiones de Tradovate a Sierra Chart están bloqueadas.</strong> Tradovate tomó una decisión comercial de no habilitar la conectividad de las cuentas de sus clientes con Sierra Chart, así que ninguna cantidad de credenciales reintroducidas o reinstalaciones lo forzará. La vía que funciona en 2026 es enrutar sus órdenes a través del propio servicio <strong class='text-white'>Teton</strong> de Sierra Chart con un bróker compatible y obtener los datos de mercado del feed <strong class='text-white'>Denali</strong>. A continuación verá exactamente qué cambió, por qué y cómo lograr una configuración de Sierra Chart plenamente operativa sin Tradovate de por medio." },
    {
      type: "checklist",
      heading: "La versión corta",
      items: [
        "<strong class='text-white'>No puede crear una nueva conexión de Tradovate en Sierra Chart.</strong> Tradovate decidió no habilitar esta conectividad, así que no es un problema de ajustes por su parte.",
        "<strong class='text-white'>Las conexiones existentes pueden estar protegidas por derechos adquiridos.</strong> Si ya estaba vinculado antes del cambio, a menudo seguirá funcionando. Las cuentas nuevas son las que se rechazan.",
        "<strong class='text-white'>Las cuentas prop en Tradovate se topan con el mismo muro.</strong> Las cuentas de evaluación o fondeadas de Apex, Topstep y similares que se compensan a través de Tradovate no pueden vincularse a Sierra Chart como nueva conexión.",
        "<strong class='text-white'>La solución es el enrutamiento Teton con un bróker compatible.</strong> Abra o use una cuenta en un bróker de futuros que ofrezca el enrutamiento de órdenes Teton de Sierra Chart y opere con esa cuenta en su lugar.",
        "<strong class='text-white'>Usará el feed Denali para los datos de mercado.</strong> Sierra Chart ya no obtiene datos de CME y EUREX de CQG, por lo que las cotizaciones en vivo llegan a través de Denali.",
      ],
    },
    { type: "heading",text: "Por qué Sierra Chart no se conecta a su cuenta de Tradovate" },
    { type: "paragraph",html: "Esto confunde a mucha gente porque Sierra Chart es una plataforma de gráficos y DOM de primer nivel y Tradovate es un bróker de futuros popular, así que parece que deberían entenderse sin más. No es así, y el motivo está del lado de Tradovate, no de Sierra Chart. Tradovate ha afirmado claramente que tomó una decisión comercial de no establecer conectividad para las cuentas de sus clientes con Sierra Chart. El propio equipo de ingeniería de Sierra Chart lo confirma: vincular una cuenta de Tradovate, incluida una cuenta de prop firm que opera en Tradovate, simplemente no es posible para los nuevos usuarios." },
    { type: "paragraph",html: "Así que cuando Tradovate no aparece como servicio de trading seleccionable, o la conexión se queda a medias, nada en su equipo está roto. La barrera es una política comercial entre las dos empresas. Eso también significa que los reflejos habituales de resolución de problemas (borrar la caché, reinstalar, volver a escribir la contraseña, sincronizar el reloj) no servirán de nada aquí. La conexión nunca iba a ofrecerse." },
    { type: "heading",text: "Qué significa esto para las cuentas de prop firm" },
    { type: "paragraph",html: "Gran parte de las personas que se topan con esto son traders de prop firms. Empresas como Apex Trader Funding y otras emiten cuentas de evaluación y fondeadas que se compensan a través de Tradovate, y esas cuentas heredan las reglas de Tradovate. Cuando le pide a Sierra Chart que conecte una, recibe la misma respuesta que un usuario minorista de Tradovate: no se puede hacer como nueva conexión. La limitación no es que la prop firm sea difícil ni que Sierra Chart carezca de una función. Es la capa de Tradovate que hay debajo de la cuenta." },
    { type: "paragraph",html: "Si opera con una cuenta prop, tiene dos opciones honestas. O mantiene Tradovate como plataforma de ejecución y la maneja desde una plataforma que <em>sí</em> puede conectarse (TradingView es la más habitual), o realiza su evaluación con una empresa cuyas cuentas se compensen a través de un bróker compatible con el enrutamiento Teton de Sierra Chart. Las reglas, los nombres de las cuentas y lo que permite cada empresa varían bastante, así que revise las condiciones actuales de su empresa antes de comprar o cambiar." },
    { type: "heading",text: "La solución: enrutar a través de Teton con un bróker compatible" },
    { type: "paragraph",html: "El sustituto que recomienda Sierra Chart para una conexión específica de bróker es su <strong class='text-white'>Teton Futures Order Routing Service</strong>. Teton envía sus órdenes directamente a la bolsa con muy baja latencia y, lo que es importante, sin comisión de enrutamiento por contrato además de su suscripción a Sierra Chart y las comisiones normales de su bróker. Cubre los mercados de CME Group (CME, CBOT, NYMEX, COMEX). El inconveniente es que Teton funciona a través de una cuenta de corretaje en una empresa que lo haya habilitado, así que lo que debe hacer es operar con una cuenta de un bróker compatible con Teton en lugar de una de Tradovate." },
    { type: "heading",text: "Paso 1: elija un bróker que admita Teton" },
    { type: "paragraph",html: "Teton se ofrece a través de una variedad de brókers de futuros y casas de compensación. Entre los que lo admiten figuran AMP, Ironbeam, Optimus Futures, Edge Clear y Stage 5, entre otros. Abra una cuenta (o use una existente) en uno de ellos y solicite específicamente el enrutamiento de órdenes Teton de Sierra Chart. Dentro de Sierra Chart, seleccione entonces la entrada Teton de ese bróker como servicio de trading en lugar de buscar Tradovate. Como la lista de brókers participantes cambia con el tiempo, confirme la lista actual con Sierra Chart o con el bróker antes de depositar nada." },
    { type: "heading",text: "Paso 2: active el feed de datos Denali para las cotizaciones de CME" },
    { type: "paragraph",html: "El enrutamiento de órdenes lleva sus operaciones a la bolsa, pero aún necesita precios en sus gráficos y en el DOM. Sierra Chart ya no ofrece datos de CME Group y EUREX a través de CQG, así que los datos de mercado en vivo proceden del <strong class='text-white'>Denali Exchange Data Feed</strong>. En los ajustes de servicios de datos y trading de Sierra Chart active Denali y elija los paquetes de bolsa que desee (CME, CBOT, NYMEX, COMEX para la mayoría de los traders de futuros). Esto sustituye cualquier expectativa de obtener un flujo de datos de Tradovate, algo que nunca estuvo disponible a través de Sierra Chart." },
    { type: "heading",text: "Paso 3: supere la comprobación de datos no profesionales" },
    { type: "paragraph",html: "CME exige una cuenta de trading de futuros real y con fondos para conceder las tarifas de datos no profesionales, y Sierra Chart debe verificarlo. Usted conecta Sierra Chart a esa cuenta real al menos una vez al mes para que el estado no profesional siga siendo válido. Si está conectado constantemente a su cuenta real, esa comprobación se realiza sola. Conviene saber que una cuenta de Tradovate generalmente no se acepta para esta verificación, así que debe usar una cuenta real con fondos en un bróker compatible o acogerse a la opción de cuenta de saldo bajo de Sierra Chart (una pequeña cuenta con fondos, del orden de cien dólares) únicamente para cumplir el requisito de CME. Consulte las cifras y los pasos exactos vigentes en la documentación de Sierra Chart, ya que las tarifas y los umbrales cambian." },
    { type: "heading",text: "¿Y el antiguo método alternativo con CQG?" },
    { type: "paragraph",html: "Todavía encontrará consejos antiguos que sugieren conectarse a una cuenta compensada por Tradovate mediante un inicio de sesión de CQG. Tenga cuidado con ello. Sierra Chart ya no admite datos de CQG para CME Group y EUREX, y Tradovate no ha habilitado la conectividad de CQG para las cuentas de clientes de Sierra Chart, por lo que no es una ruta limpia para una configuración nueva. Incluso donde sea posible una conexión de órdenes de CQG, sus gráficos seguirían necesitando el feed Denali para los datos de CME. Trate CQG como una vía heredada, no como la respuesta, y verifique directamente con Sierra Chart y su bróker cualquier cosa que lea al respecto antes de contar con ello." },
    { type: "heading",text: "Sus opciones de un vistazo" },
    { type: "table", headers: ["Lo que desea","¿Funciona?","Qué hacer"], rows: [
      ["Cuenta nueva de Tradovate en Sierra Chart","No","Bloqueado por la política de Tradovate; use Teton con un bróker compatible"],
