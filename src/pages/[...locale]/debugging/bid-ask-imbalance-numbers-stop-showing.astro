---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "bid-ask-imbalance-numbers-stop-showing";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/debugging/${SLUG}`;

const META_TITLE = "Tradovate Bid-Ask Imbalance Numbers Stop Showing";
const META_DESCRIPTION =
  "Bid-Ask Imbalance numbers stopped showing on your Tradovate chart? Switch tabs to restore them, then move off the Legacy chart to fix it for good.";

// Short SEO title (<=60 chars) for locales where the shared h1 is too long for a SERP title.
const TITLE_OVERRIDE: Partial<Record<Locale, string>> = { es: "Tradovate: desaparecen los números de Bid-Ask Imbalance", fr: "Tradovate : les chiffres Bid-Ask Imbalance disparaissent", it: "Tradovate: spariscono i numeri Bid-Ask Imbalance" };

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Tradovate Bid-Ask Imbalance Zahlen verschwinden beheben", es: "Cómo solucionar que los números de Bid-Ask Imbalance dejen de mostrarse en Tradovate", fr: "Corriger la disparition des chiffres Bid-Ask Imbalance sur Tradovate", it: "Come risolvere la scomparsa dei numeri Bid-Ask Imbalance su Tradovate" },
  dek: { en: "The candles keep printing but the bid/ask figures inside them go blank, usually right as the tape speeds up. Here's the zoom trap versus the real Legacy-chart bug, and how to fix each one.", de: "Die Candles bilden sich weiter, aber die Bid/Ask-Zahlen darin werden leer, meist genau dann, wenn das Tape schneller wird. Hier ist die Zoom-Falle im Vergleich zum echten Legacy-Chart-Bug, und wie Sie jeden beheben.", es: "Las velas siguen formándose, pero las cifras de bid/ask dentro de ellas quedan en blanco, normalmente justo cuando la cinta se acelera. Aquí tiene la trampa del zoom frente al verdadero bug del gráfico Legacy, y cómo solucionar cada uno.", fr: "Les bougies continuent de se former, mais les chiffres bid/ask à l'intérieur deviennent vides, généralement juste au moment où le tape s'accélère. Voici le piège du zoom face au véritable bug du graphique Legacy, et comment corriger chacun.", it: "Le candele continuano a formarsi, ma le cifre bid/ask al loro interno diventano vuote, di solito proprio quando il tape accelera. Ecco la trappola dello zoom contro il vero bug del grafico Legacy, e come risolvere ciascuno." },
  readTime: { en: "7 min read", de: "7 Minuten Lesezeit", es: "Lectura de 7 minutos", fr: "Lecture de 7 minutes", it: "Lettura di 7 minuti" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "You're reading order flow on the Bid-Ask Imbalance chart, watching the bid and ask volume printed inside each candle, and then the numbers just stop. The candles keep forming. The bars still stack. But the figures that make the view worth using have gone blank, usually right as the tape speeds up and you need them most. Flip to another tab and back and they might reappear for a while. Ten minutes later they're gone again. If that's the loop you're stuck in, you're not fighting a setting you forgot to flip, you've hit a real rendering defect in Tradovate's older chart, and there's both a quick patch to get through the session and a permanent fix worth doing once." },
    { type: "quote", html: "<strong class='text-white'>Fastest fix:</strong> click to another tab (or another chart) and back to force the Bid-Ask numbers to redraw. Scrolling the mouse wheel on the chart does the same. It works often, not always. The lasting fix is to stop using the <strong class='text-white'>Legacy chart</strong> for this view, the number-rendering bug is resolved on the newer <strong class='text-white'>Chart</strong> module." },
    {
      type: "checklist",
      heading: "Quick Checklist for Missing Bid-Ask Imbalance Numbers",
      items: [
        "<strong class='text-white'>You're on the Legacy chart</strong>, the blank-numbers defect lives here. Rebuild the Bid-Ask view on the newer Chart module to end it for good.",
        "<strong class='text-white'>Switch tabs or scroll the wheel</strong>, a temporary redraw that buys you time mid-session when you can't stop to reconfigure.",
        "<strong class='text-white'>You're zoomed too far out</strong>, the digits can't fit the candle width, so they hide. Zoom in until they reappear.",
        "<strong class='text-white'>Numbers won't fit at your scale</strong>, turn on <strong class='text-white'>Bar Histograms</strong> to keep a visual read even when the figures are too small to print.",
        "<strong class='text-white'>It's worse in fast markets</strong>, high volume and volatility make the Legacy defect surface more. It's not your imagination and it's not your data feed.",
        "<strong class='text-white'>Same on Chrome, Edge and the desktop app</strong>, reinstalling or switching browser won't touch a bug that lives inside the Legacy chart.",
      ],
    },
    { type: "heading", text: "What “Bid-Ask Imbalance Numbers Stopped Showing” Actually Means" },
    { type: "paragraph", html: "Tradovate's Bid-Ask chart is its built-in footprint view. Instead of a single candle body, each bar breaks trading down by price level and shows how much volume traded on the bid versus the ask. You switch it on by setting the chart type to <strong class='text-white'>Bid-Ask Volume</strong>, and from there you can flip between a few readings of the same data: raw <strong class='text-white'>Bid-Ask Volume</strong>, <strong class='text-white'>Delta</strong>, and <strong class='text-white'>Imbalance</strong>. The Imbalance view is the one that highlights lopsided bid/ask prints based on your own thresholds, and it leans heavily on those numeric labels being legible. When the numbers blank out, the view loses its whole point." },
    { type: "paragraph", html: "There's no error dialog for this. Tradovate doesn't pop a warning; the figures simply stop drawing while the candles carry on. That silence is why it gets misdiagnosed. It helps to know there are two completely different reasons the numbers can go missing, and the fix depends entirely on which one you're looking at." },
    { type: "heading", text: "The Two Reasons the Numbers Vanish" },
    { type: "heading", text: "1. Your zoom level is hiding them (expected behavior)" },
    { type: "paragraph", html: "This one isn't a bug. The bid/ask figures need a minimum amount of pixel space to render, and if you're zoomed out far enough, there's simply no room to fit them inside a candle at a readable font size, so Tradovate hides them rather than printing a smear you couldn't read anyway. Zoom in with the scroll wheel until the price levels spread apart, and the numbers come back. The trade-off is obvious: to keep the figures visible you can end up so zoomed in that you only see a short slice of the session on screen at once. If that's your situation, the numbers were never really “broken”, they just didn't fit." },
    { type: "heading", text: "2. The Legacy chart's rendering defect (the actual bug)" },
    { type: "paragraph", html: "This is the one people mean when they say the numbers “stop showing.” On the older Legacy chart, the numeric data blanks out at random during a session even when you're zoomed in plenty to read it. It sticks around too, not a one-second flicker but minutes of unusable chart, and for some traders it runs for days at a stretch. It tends to bite hardest during high-volume, high-volatility stretches when candles are printing fast. Crucially, it's been reproduced the same way across Google Chrome, Microsoft Edge, and the Tradovate desktop app for Windows, all on the Legacy chart. That cross-platform consistency is the tell: if a bug follows you across two browsers and a native app, it isn't your machine, your cache, or your connection. It's the chart." },
    { type: "heading", text: "How to Fix Disappearing Bid-Ask Numbers: Step-by-Step" },
    { type: "heading", text: "Get the numbers back right now (temporary)" },
    {
      type: "steps",
      items: [
        { title: "Switch tabs and back", html: "Click to another workspace tab or another chart tab, then click straight back to the Bid-Ask chart. The redraw usually forces the figures to repaint." },
        { title: "Scroll the wheel", html: "If tab-switching doesn't do it, hover the chart and scroll the mouse wheel a notch. That refit also nudges the numbers to load." },
        { title: "Expect to repeat this", html: "On the Legacy chart the fix rarely holds, you may have to scroll almost constantly to keep the labels on screen, which is exactly why it's a stopgap and not a solution." },
      ],
    },
    { type: "heading", text: "Make the numbers fit at your zoom (Bar Histograms)" },
    {
      type: "steps",
      items: [
        { title: "Open the Bid-Ask view settings", html: "If your problem is really the zoom trap, open the chart's settings for the Bid-Ask view." },
        { title: "Enable Bar Histograms", html: "Enable the <strong class='text-white'>Bar Histograms</strong> option (sometimes shown as “Show Bar Histograms”) and pick your colors. This draws a small volume histogram inside each candle so you can still read the imbalance visually when the numeric figures won't fit." },
        { title: "Choose a sizing mode", html: "<strong class='text-white'>PerBar</strong> scales each candle's histogram against the largest volume within that same candle; <strong class='text-white'>PerSeries</strong> scales every bar against the largest volume across the whole loaded chart. PerSeries is better for comparing candles to each other; PerBar is better for reading the shape inside one candle." },
        { title: "Confirm current labels", html: "The exact wording of these options can shift between platform versions, so confirm the current labels in your own settings panel. The behavior is what matters: a visual fallback that survives being zoomed out." },
      ],
    },
    { type: "paragraph", html: "Histograms won't cure the Legacy defect, if the bug blanks a candle, it can blank the histogram too, but they make the zoom-related case far less painful." },
    { type: "heading", text: "Fix it permanently (move off the Legacy chart)" },
    {
      type: "steps",
      items: [
        { title: "Open a new Chart module", html: "Open a new <strong class='text-white'>Chart</strong> module, the newer, non-Legacy chart, and load the same symbol and account." },
        { title: "Set Bid-Ask Volume and Imbalance", html: "Set its chart type to <strong class='text-white'>Bid-Ask Volume</strong> and select the Imbalance reading, matching the thresholds you used on the Legacy view." },
        { title: "Watch it through a busy stretch", html: "The numeric-display problem is resolved on the newer Chart module, so the figures should stay put where the Legacy chart would have dropped them." },
        { title: "Retire the Legacy chart", html: "Make the newer chart your default and retire the Legacy Bid-Ask chart from your workspace so you're not tempted back into the bug." },
      ],
    },
    { type: "paragraph", html: "One honest caveat: the newer Chart module doesn't carry over every Legacy display option one-for-one. If you specifically relied on a fully transparent bar color on the Legacy chart, you may not find an exact match on the newer one, that's the main reason some traders cling to Legacy despite the flicker. Check your color and style options after switching; for most people, reliable numbers beat a niche color setting." },
    { type: "heading", text: "Troubleshooting Table" },
    {
      type: "table",
      headers: ["What you see", "What's going on", "What to do"],
      rows: [
        ["Numbers gone when zoomed out, back when zoomed in", "Digits can't fit the candle width (expected)", "Zoom in, or enable Bar Histograms for a visual fallback"],
        ["Numbers blank at a readable zoom, mid-session", "Legacy chart rendering defect", "Switch tabs / scroll to patch; rebuild the view on the newer Chart module"],
        ["Only a constant scroll keeps them visible", "Classic Legacy-chart symptom", "Move off Legacy, the newer chart holds the numbers"],
        ["Worse during fast, high-volume markets", "Defect surfaces under load", "Don't rely on Legacy for live order-flow reads"],
        ["Same on Chrome, Edge and desktop app", "Bug is in the Legacy chart, not your setup", "Reinstalling won't help; change the chart module"],
        ["Numbers fine, but colors look different after switching", "Newer chart lacks a Legacy-only style option", "Reconfigure colors on the new chart; accept reliable numbers"],
      ],
    },
    { type: "heading", text: "Don't Let a Flickering Chart Cost You the Trade" },
    { type: "paragraph", html: "The reason a blank Bid-Ask chart stings is that you're using it to time entries by hand, read the imbalance, click the order. When the numbers drop out for a minute in a fast tape, that's the exact minute you miss. If your edge is a repeatable order-flow condition, the sturdier move is to turn that read into a rule and let it execute on its own, so a rendering bug on one chart module never sits between you and the fill. That's where PickMyTrade comes in, it links your TradingView alerts straight to Tradovate and manages the orders for you:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>TradingView-native execution</strong>, your alert fires from the TradingView chart you already trust, independent of whether Tradovate's Legacy chart is drawing numbers or not.",
        "<strong class='text-white'>Server-side bracket management</strong>, your stop and target live on PickMyTrade's engine, so your risk is defined even when a chart panel is misbehaving.",
        "<strong class='text-white'>Automatic trade logging</strong>, every entry and exit is recorded off-platform, giving you a clean record no chart glitch can erase.",
        "<strong class='text-white'>Multi-account sync</strong>, the same managed orders mirror across every connected account, so you're never reconciling by eye across flickering charts.",
      ],
    },
  ], de: [
    { type: "paragraph", html: "Sie lesen den Orderflow im Bid-Ask-Imbalance-Chart, beobachten das Bid- und Ask-Volumen, das in jeder Candle abgedruckt wird, und dann hören die Zahlen einfach auf. Die Candles bilden sich weiter. Die Bars stapeln sich weiter. Aber die Werte, die die Ansicht überhaupt erst nützlich machen, sind leer geworden, meist genau dann, wenn das Tape schneller wird und Sie sie am dringendsten brauchen. Wechseln Sie zu einem anderen Tab und zurück, könnten sie eine Weile wieder erscheinen. Zehn Minuten später sind sie erneut verschwunden. Wenn das die Schleife ist, in der Sie feststecken, kämpfen Sie nicht gegen eine vergessene Einstellung an, Sie sind auf einen echten Rendering-Defekt in Tradovates älterem Chart gestoßen, und es gibt sowohl einen schnellen Patch, um durch die Sitzung zu kommen, als auch eine dauerhafte Lösung, die es wert ist, einmal umgesetzt zu werden." },
    { type: "quote", html: "<strong class='text-white'>Schnellste Lösung:</strong> Klicken Sie zu einem anderen Tab (oder einem anderen Chart) und zurück, um das Neuzeichnen der Bid-Ask-Zahlen zu erzwingen. Scrollen mit dem Mausrad im Chart tut dasselbe. Das funktioniert oft, nicht immer. Die dauerhafte Lösung besteht darin, den <strong class='text-white'>Legacy-Chart</strong> für diese Ansicht nicht mehr zu verwenden, der Zahlen-Rendering-Bug ist im neueren <strong class='text-white'>Chart</strong>-Modul behoben." },
    {
      type: "checklist",
      heading: "Kurz-Checkliste für fehlende Bid-Ask-Imbalance-Zahlen",
      items: [
        "<strong class='text-white'>Sie sind auf dem Legacy-Chart</strong>, der Leerzahlen-Defekt lebt hier. Bauen Sie die Bid-Ask-Ansicht im neueren Chart-Modul neu auf, um ihn endgültig zu beenden.",
        "<strong class='text-white'>Tab wechseln oder mit dem Rad scrollen</strong>, ein vorübergehendes Neuzeichnen, das Ihnen mitten in der Sitzung Zeit verschafft, wenn Sie nicht anhalten können, um neu zu konfigurieren.",
        "<strong class='text-white'>Sie sind zu weit herausgezoomt</strong>, die Ziffern passen nicht in die Candle-Breite, also verstecken sie sich. Zoomen Sie hinein, bis sie wieder erscheinen.",
        "<strong class='text-white'>Zahlen passen bei Ihrer Skalierung nicht</strong>, aktivieren Sie <strong class='text-white'>Bar Histograms</strong>, um eine visuelle Ablesung zu behalten, selbst wenn die Werte zu klein zum Drucken sind.",
        "<strong class='text-white'>Es ist schlimmer in schnellen Märkten</strong>, hohes Volumen und Volatilität lassen den Legacy-Defekt häufiger auftreten. Das ist nicht Ihre Einbildung und nicht Ihr Datenfeed.",
        "<strong class='text-white'>Dasselbe bei Chrome, Edge und der Desktop-App</strong>, eine Neuinstallation oder ein Browserwechsel tastet einen Bug, der im Legacy-Chart selbst lebt, nicht an.",
      ],
    },
    { type: "heading", text: "Was „Bid-Ask-Imbalance-Zahlen verschwinden“ tatsächlich bedeutet" },
    { type: "paragraph", html: "Tradovates Bid-Ask-Chart ist seine eingebaute Footprint-Ansicht. Statt eines einzelnen Candle-Körpers schlüsselt jede Bar den Handel nach Preisniveau auf und zeigt, wie viel Volumen auf dem Bid gegenüber dem Ask gehandelt wurde. Sie schalten es ein, indem Sie den Chart-Typ auf <strong class='text-white'>Bid-Ask Volume</strong> setzen, und von dort können Sie zwischen ein paar Ablesungen derselben Daten wechseln: rohes <strong class='text-white'>Bid-Ask Volume</strong>, <strong class='text-white'>Delta</strong> und <strong class='text-white'>Imbalance</strong>. Die Imbalance-Ansicht ist die, die unausgewogene Bid/Ask-Prints anhand Ihrer eigenen Schwellenwerte hervorhebt, und sie stützt sich stark darauf, dass diese numerischen Beschriftungen lesbar sind. Werden die Zahlen leer, verliert die Ansicht ihren gesamten Sinn." },
    { type: "paragraph", html: "Dafür gibt es keinen Fehlerdialog. Tradovate zeigt keine Warnung an; die Werte hören einfach auf zu zeichnen, während die Candles weiterlaufen. Diese Stille ist der Grund, warum es falsch diagnostiziert wird. Es hilft zu wissen, dass es zwei völlig unterschiedliche Gründe gibt, warum die Zahlen verschwinden können, und die Lösung hängt vollständig davon ab, welchen Sie vor sich haben." },
    { type: "heading", text: "Die zwei Gründe, warum die Zahlen verschwinden" },
    { type: "heading", text: "1. Ihre Zoomstufe versteckt sie (erwartetes Verhalten)" },
    { type: "paragraph", html: "Das ist kein Bug. Die Bid/Ask-Werte benötigen ein Mindestmaß an Pixelplatz zum Rendern, und sind Sie weit genug herausgezoomt, gibt es schlicht keinen Platz, um sie in einer lesbaren Schriftgröße in eine Candle zu quetschen, sodass Tradovate sie versteckt, statt ein Gekritzel zu drucken, das Sie ohnehin nicht lesen könnten. Zoomen Sie mit dem Scrollrad hinein, bis sich die Preisniveaus auseinanderziehen, und die Zahlen kommen zurück. Der Kompromiss ist offensichtlich: Um die Werte sichtbar zu halten, können Sie so weit hineinzoomen, dass Sie nur einen kurzen Ausschnitt der Sitzung gleichzeitig auf dem Bildschirm sehen. Ist das Ihre Situation, waren die Zahlen nie wirklich „kaputt“, sie passten nur nicht hinein." },
    { type: "heading", text: "2. Der Rendering-Defekt des Legacy-Charts (der eigentliche Bug)" },
    { type: "paragraph", html: "Das ist es, was Leute meinen, wenn sie sagen, die Zahlen „hören auf, angezeigt zu werden“. Auf dem älteren Legacy-Chart werden die numerischen Daten während einer Sitzung zufällig leer, selbst wenn Sie weit genug hineingezoomt sind, um sie zu lesen. Es hält sich auch, kein Ein-Sekunden-Flackern, sondern Minuten unbrauchbaren Charts, und für manche Trader läuft es tagelang am Stück. Es beißt am härtesten während Phasen mit hohem Volumen und hoher Volatilität, wenn Candles schnell gedruckt werden. Entscheidend ist, dass es auf dieselbe Weise über Google Chrome, Microsoft Edge und die Tradovate-Desktop-App für Windows reproduziert wurde, alles auf dem Legacy-Chart. Diese plattformübergreifende Konsistenz ist der Hinweis: Wenn ein Bug Sie über zwei Browser und eine native App hinweg verfolgt, liegt es nicht an Ihrem Rechner, Ihrem Cache oder Ihrer Verbindung. Es liegt am Chart." },
    { type: "heading", text: "So beheben Sie verschwindende Bid-Ask-Zahlen: Schritt für Schritt" },
    { type: "heading", text: "Die Zahlen sofort zurückholen (vorübergehend)" },
    {
      type: "steps",
      items: [
        { title: "Tab wechseln und zurück", html: "Klicken Sie zu einem anderen Workspace-Tab oder einem anderen Chart-Tab, dann direkt zurück zum Bid-Ask-Chart. Das Neuzeichnen zwingt die Werte meist zum Neu-Rendern." },
        { title: "Mit dem Rad scrollen", html: "Wenn Tab-Wechsel nicht hilft, bewegen Sie den Mauszeiger über den Chart und scrollen Sie das Mausrad eine Kerbe. Diese Neuanpassung stößt die Zahlen ebenfalls zum Laden an." },
        { title: "Erwarten Sie, dies zu wiederholen", html: "Auf dem Legacy-Chart hält die Lösung selten, Sie müssen unter Umständen nahezu ständig scrollen, um die Beschriftungen auf dem Bildschirm zu halten, genau deshalb ist es eine Notlösung und keine echte Lösung." },
      ],
    },
    { type: "heading", text: "Die Zahlen bei Ihrem Zoom einpassen (Bar Histograms)" },
    {
      type: "steps",
      items: [
        { title: "Bid-Ask-Ansichtseinstellungen öffnen", html: "Wenn Ihr Problem wirklich die Zoom-Falle ist, öffnen Sie die Einstellungen des Charts für die Bid-Ask-Ansicht." },
        { title: "Bar Histograms aktivieren", html: "Aktivieren Sie die Option <strong class='text-white'>Bar Histograms</strong> (manchmal als „Show Bar Histograms“ angezeigt) und wählen Sie Ihre Farben. Das zeichnet ein kleines Volumen-Histogramm in jede Candle, sodass Sie die Imbalance weiterhin visuell ablesen können, wenn die numerischen Werte nicht hineinpassen." },
        { title: "Einen Skalierungsmodus wählen", html: "<strong class='text-white'>PerBar</strong> skaliert das Histogramm jeder Candle gegen das größte Volumen innerhalb derselben Candle; <strong class='text-white'>PerSeries</strong> skaliert jede Bar gegen das größte Volumen über den gesamten geladenen Chart hinweg. PerSeries eignet sich besser, um Candles miteinander zu vergleichen; PerBar eignet sich besser, um die Form innerhalb einer Candle abzulesen." },
        { title: "Aktuelle Beschriftungen bestätigen", html: "Der genaue Wortlaut dieser Optionen kann sich zwischen Plattformversionen verschieben, bestätigen Sie also die aktuellen Beschriftungen in Ihrem eigenen Einstellungspanel. Das Verhalten ist es, was zählt: eine visuelle Rückfalllösung, die das Herauszoomen übersteht." },
      ],
    },
    { type: "paragraph", html: "Histogramme heilen den Legacy-Defekt nicht, wenn der Bug eine Candle leert, kann er auch das Histogramm leeren, aber sie machen den zoombezogenen Fall deutlich weniger schmerzhaft." },
    { type: "heading", text: "Dauerhaft beheben (weg vom Legacy-Chart)" },
    {
      type: "steps",
      items: [
        { title: "Ein neues Chart-Modul öffnen", html: "Öffnen Sie ein neues <strong class='text-white'>Chart</strong>-Modul, den neueren, nicht-Legacy-Chart, und laden Sie dasselbe Symbol und Konto." },
        { title: "Bid-Ask Volume und Imbalance einstellen", html: "Stellen Sie dessen Chart-Typ auf <strong class='text-white'>Bid-Ask Volume</strong> und wählen Sie die Imbalance-Ablesung, passend zu den Schwellenwerten, die Sie in der Legacy-Ansicht verwendet haben." },
        { title: "Beobachten Sie es durch eine geschäftige Phase", html: "Das Problem mit der numerischen Anzeige ist im neueren Chart-Modul behoben, sodass die Werte dort stehen bleiben sollten, wo der Legacy-Chart sie fallen gelassen hätte." },
        { title: "Den Legacy-Chart ausmustern", html: "Machen Sie den neueren Chart zu Ihrem Standard und mustern Sie den Legacy-Bid-Ask-Chart aus Ihrem Workspace aus, damit Sie nicht wieder in den Bug verfallen." },
      ],
    },
    { type: "paragraph", html: "Ein ehrlicher Vorbehalt: Das neuere Chart-Modul übernimmt nicht jede Legacy-Anzeigeoption eins zu eins. Verließen Sie sich speziell auf eine vollständig transparente Bar-Farbe im Legacy-Chart, finden Sie im neueren möglicherweise keine exakte Entsprechung, das ist der Hauptgrund, warum manche Trader trotz des Flackerns am Legacy-Chart festhalten. Prüfen Sie Ihre Farb- und Stiloptionen nach dem Wechsel; für die meisten Menschen schlagen zuverlässige Zahlen eine Nischen-Farbeinstellung." },
    { type: "heading", text: "Fehlerbehebungstabelle" },
    {
      type: "table",
      headers: ["Was Sie sehen", "Was los ist", "Was zu tun ist"],
      rows: [
        ["Zahlen weg beim Herauszoomen, wieder da beim Hineinzoomen", "Ziffern passen nicht in die Candle-Breite (erwartet)", "Hineinzoomen oder Bar Histograms für eine visuelle Rückfalllösung aktivieren"],
        ["Zahlen leer bei lesbarem Zoom, mitten in der Sitzung", "Legacy-Chart-Rendering-Defekt", "Tabs wechseln / scrollen als Notlösung; die Ansicht im neueren Chart-Modul neu aufbauen"],
        ["Nur ständiges Scrollen hält sie sichtbar", "Klassisches Legacy-Chart-Symptom", "Weg vom Legacy, der neuere Chart hält die Zahlen"],
        ["Schlimmer bei schnellen, hochvolumigen Märkten", "Defekt tritt unter Last auf", "Verlassen Sie sich nicht auf Legacy für Live-Orderflow-Ablesungen"],
        ["Dasselbe bei Chrome, Edge und Desktop-App", "Bug liegt im Legacy-Chart, nicht in Ihrem Setup", "Neuinstallation hilft nicht; Chart-Modul wechseln"],
        ["Zahlen in Ordnung, aber Farben sehen nach dem Wechsel anders aus", "Neuerer Chart fehlt eine Legacy-exklusive Stiloption", "Farben im neuen Chart neu konfigurieren; zuverlässige Zahlen akzeptieren"],
      ],
    },
    { type: "heading", text: "Lassen Sie einen flackernden Chart Sie nicht den Trade kosten" },
    { type: "paragraph", html: "Der Grund, warum ein leerer Bid-Ask-Chart wehtut, ist, dass Sie ihn nutzen, um Einstiege von Hand zu timen, die Imbalance abzulesen, die Order zu klicken. Wenn die Zahlen für eine Minute in einem schnellen Tape ausfallen, ist genau das die Minute, die Sie verpassen. Ist Ihr Edge eine wiederholbare Orderflow-Bedingung, ist der solidere Schritt, diese Ablesung in eine Regel zu verwandeln und sie von selbst ausführen zu lassen, sodass ein Rendering-Bug in einem Chart-Modul nie zwischen Ihnen und dem Fill steht. Hier kommt PickMyTrade ins Spiel, es verbindet Ihre TradingView-Alerts direkt mit Tradovate und verwaltet die Orders für Sie:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>TradingView-native Ausführung</strong>, Ihr Alert feuert vom TradingView-Chart, dem Sie bereits vertrauen, unabhängig davon, ob Tradovates Legacy-Chart Zahlen zeichnet oder nicht.",
        "<strong class='text-white'>Serverseitige Bracket-Verwaltung</strong>, Ihr Stop und Target leben auf PickMyTrades Engine, sodass Ihr Risiko definiert bleibt, selbst wenn ein Chart-Panel sich daneben benimmt.",
        "<strong class='text-white'>Automatische Trade-Protokollierung</strong>, jeder Ein- und Ausstieg wird außerhalb der Plattform erfasst und gibt Ihnen eine saubere Aufzeichnung, die kein Chart-Glitch löschen kann.",
        "<strong class='text-white'>Multi-Account-Sync</strong>, dieselben verwalteten Orders spiegeln sich über jedes verbundene Konto hinweg, sodass Sie nie per Auge über flackernde Charts hinweg abgleichen müssen.",
      ],
    },
  ], es: [
    { type: "paragraph", html: "Está leyendo el order flow en el gráfico Bid-Ask Imbalance, observando el volumen de compra y venta impreso dentro de cada vela, y de repente los números simplemente se detienen. Las velas siguen formándose. Las barras siguen apilándose. Pero las cifras que hacen que la vista merezca la pena se han quedado en blanco, normalmente justo cuando la cinta se acelera y más las necesita. Cambie a otra pestaña y vuelva y podrían reaparecer durante un rato. Diez minutos después han desaparecido de nuevo. Si ese es el bucle en el que está atrapado, no está luchando contra un ajuste que olvidó activar, ha topado con un defecto de renderizado real en el gráfico más antiguo de Tradovate, y existen tanto un parche rápido para superar la sesión como una solución permanente que vale la pena aplicar una vez." },
    { type: "quote", html: "<strong class='text-white'>Solución más rápida:</strong> haga clic en otra pestaña (u otro gráfico) y vuelva para forzar que los números de Bid-Ask se redibujen. Desplazar la rueda del ratón sobre el gráfico hace lo mismo. Funciona a menudo, no siempre. La solución duradera es dejar de usar el <strong class='text-white'>gráfico Legacy</strong> para esta vista, el bug de renderizado de números está resuelto en el módulo <strong class='text-white'>Chart</strong> más nuevo." },
    {
      type: "checklist",
      heading: "Lista de verificación rápida para números de Bid-Ask Imbalance ausentes",
      items: [
        "<strong class='text-white'>Está en el gráfico Legacy</strong>, el defecto de números en blanco vive aquí. Reconstruya la vista Bid-Ask en el módulo Chart más nuevo para acabar con él definitivamente.",
        "<strong class='text-white'>Cambie de pestaña o desplace la rueda</strong>, un redibujado temporal que le compra tiempo a mitad de sesión cuando no puede detenerse a reconfigurar.",
        "<strong class='text-white'>Está demasiado alejado con el zoom</strong>, los dígitos no caben en el ancho de la vela, así que se ocultan. Amplíe hasta que reaparezcan.",
        "<strong class='text-white'>Los números no caben a su escala</strong>, active <strong class='text-white'>Bar Histograms</strong> para mantener una lectura visual incluso cuando las cifras son demasiado pequeñas para imprimirse.",
        "<strong class='text-white'>Es peor en mercados rápidos</strong>, el alto volumen y la volatilidad hacen que el defecto de Legacy aflore más. No es su imaginación ni su feed de datos.",
        "<strong class='text-white'>Igual en Chrome, Edge y la app de escritorio</strong>, reinstalar o cambiar de navegador no tocará un bug que vive dentro del gráfico Legacy.",
      ],
    },
    { type: "heading", text: "Qué significa realmente que «los números de Bid-Ask Imbalance dejaron de mostrarse»" },
    { type: "paragraph", html: "El gráfico Bid-Ask de Tradovate es su vista de footprint integrada. En lugar de un único cuerpo de vela, cada barra desglosa la negociación por nivel de precio y muestra cuánto volumen se negoció en el bid frente al ask. Se activa configurando el tipo de gráfico en <strong class='text-white'>Bid-Ask Volume</strong>, y desde ahí puede alternar entre unas pocas lecturas de los mismos datos: <strong class='text-white'>Bid-Ask Volume</strong> en bruto, <strong class='text-white'>Delta</strong>, e <strong class='text-white'>Imbalance</strong>. La vista Imbalance es la que resalta impresiones de bid/ask desequilibradas según sus propios umbrales, y depende en gran medida de que esas etiquetas numéricas sean legibles. Cuando los números se quedan en blanco, la vista pierde todo su sentido." },
    { type: "paragraph", html: "No hay ningún cuadro de error para esto. Tradovate no muestra ninguna advertencia; las cifras simplemente dejan de dibujarse mientras las velas continúan. Ese silencio es la razón por la que se diagnostica mal. Ayuda saber que hay dos razones completamente distintas por las que los números pueden desaparecer, y la solución depende por completo de cuál de ellas esté viendo." },
    { type: "heading", text: "Las dos razones por las que los números desaparecen" },
    { type: "heading", text: "1. Su nivel de zoom los está ocultando (comportamiento esperado)" },
    { type: "paragraph", html: "Este no es un bug. Las cifras de bid/ask necesitan una cantidad mínima de espacio en píxeles para renderizarse, y si está lo bastante alejado con el zoom, simplemente no hay sitio para encajarlas dentro de una vela con un tamaño de fuente legible, así que Tradovate las oculta en lugar de imprimir un borrón que de todos modos no podría leer. Amplíe con la rueda de desplazamiento hasta que los niveles de precio se separen, y los números vuelven. La contrapartida es obvia: para mantener las cifras visibles puede acabar tan ampliado que solo vea una porción corta de la sesión en pantalla a la vez. Si esa es su situación, los números nunca estuvieron realmente «rotos», simplemente no cabían." },
    { type: "heading", text: "2. El defecto de renderizado del gráfico Legacy (el bug real)" },
    { type: "paragraph", html: "Esto es a lo que la gente se refiere cuando dice que los números «dejan de mostrarse». En el gráfico Legacy más antiguo, los datos numéricos se quedan en blanco al azar durante una sesión incluso cuando está lo bastante ampliado como para leerlos. Además persiste, no es un parpadeo de un segundo sino minutos de gráfico inutilizable, y para algunos traders se prolonga durante días seguidos. Tiende a morder con más fuerza durante tramos de alto volumen y alta volatilidad, cuando las velas se imprimen rápido. Fundamentalmente, se ha reproducido de la misma manera en Google Chrome, Microsoft Edge, y la app de escritorio de Tradovate para Windows, todo en el gráfico Legacy. Esa consistencia entre plataformas es la pista: si un bug lo persigue a través de dos navegadores y una app nativa, no es su máquina, su caché, ni su conexión. Es el gráfico." },
    { type: "heading", text: "Cómo solucionar los números de Bid-Ask que desaparecen: paso a paso" },
    { type: "heading", text: "Recupere los números ahora mismo (temporal)" },
    {
      type: "steps",
      items: [
        { title: "Cambie de pestaña y vuelva", html: "Haga clic en otra pestaña del espacio de trabajo u otra pestaña de gráfico, luego haga clic directamente de vuelta al gráfico Bid-Ask. El redibujado suele forzar que las cifras se repinten." },
        { title: "Desplace la rueda", html: "Si cambiar de pestaña no funciona, sitúe el cursor sobre el gráfico y desplace la rueda del ratón un punto. Ese reajuste también empuja a los números a cargarse." },
        { title: "Espere tener que repetir esto", html: "En el gráfico Legacy la solución rara vez se mantiene, puede que tenga que desplazar la rueda casi constantemente para mantener las etiquetas en pantalla, que es exactamente por qué es un parche temporal y no una solución." },
      ],
    },
    { type: "heading", text: "Haga que los números encajen a su nivel de zoom (Bar Histograms)" },
    {
      type: "steps",
      items: [
        { title: "Abra la configuración de la vista Bid-Ask", html: "Si su problema es realmente la trampa del zoom, abra la configuración del gráfico para la vista Bid-Ask." },
        { title: "Active Bar Histograms", html: "Active la opción <strong class='text-white'>Bar Histograms</strong> (a veces mostrada como «Show Bar Histograms») y elija sus colores. Esto dibuja un pequeño histograma de volumen dentro de cada vela para que pueda seguir leyendo el desequilibrio visualmente cuando las cifras numéricas no quepan." },
        { title: "Elija un modo de escalado", html: "<strong class='text-white'>PerBar</strong> escala el histograma de cada vela contra el mayor volumen dentro de esa misma vela; <strong class='text-white'>PerSeries</strong> escala cada barra contra el mayor volumen de todo el gráfico cargado. PerSeries es mejor para comparar velas entre sí; PerBar es mejor para leer la forma dentro de una vela." },
        { title: "Confirme las etiquetas actuales", html: "La redacción exacta de estas opciones puede cambiar entre versiones de la plataforma, así que confirme las etiquetas actuales en su propio panel de configuración. Lo que importa es el comportamiento: un respaldo visual que sobrevive al alejar el zoom." },
      ],
    },
    { type: "paragraph", html: "Los histogramas no curan el defecto de Legacy, si el bug deja en blanco una vela, también puede dejar en blanco el histograma, pero hacen que el caso relacionado con el zoom sea mucho menos doloroso." },
    { type: "heading", text: "Solucionarlo de forma permanente (abandonar el gráfico Legacy)" },
    {
      type: "steps",
      items: [
        { title: "Abra un nuevo módulo Chart", html: "Abra un nuevo módulo <strong class='text-white'>Chart</strong>, el gráfico más nuevo, no Legacy, y cargue el mismo símbolo y cuenta." },
        { title: "Configure Bid-Ask Volume e Imbalance", html: "Configure su tipo de gráfico en <strong class='text-white'>Bid-Ask Volume</strong> y seleccione la lectura Imbalance, haciendo coincidir los umbrales que usaba en la vista Legacy." },
        { title: "Obsérvelo durante un tramo intenso", html: "El problema de la visualización numérica está resuelto en el módulo Chart más nuevo, así que las cifras deberían mantenerse donde el gráfico Legacy las habría perdido." },
        { title: "Retire el gráfico Legacy", html: "Convierta el gráfico más nuevo en su predeterminado y retire el gráfico Legacy Bid-Ask de su espacio de trabajo para no verse tentado a volver al bug." },
      ],
    },
    { type: "paragraph", html: "Una advertencia honesta: el módulo Chart más nuevo no traslada todas las opciones de visualización de Legacy una a una. Si dependía específicamente de un color de barra totalmente transparente en el gráfico Legacy, puede que no encuentre una coincidencia exacta en el más nuevo, esa es la razón principal por la que algunos traders se aferran a Legacy a pesar del parpadeo. Revise sus opciones de color y estilo tras el cambio; para la mayoría de las personas, unos números fiables superan un ajuste de color de nicho." },
    { type: "heading", text: "Tabla de solución de problemas" },
    {
      type: "table",
      headers: ["Lo que ve", "Qué está pasando", "Qué hacer"],
      rows: [
        ["Números ausentes al alejar el zoom, de vuelta al ampliar", "Los dígitos no caben en el ancho de la vela (esperado)", "Amplíe, o active Bar Histograms como respaldo visual"],
        ["Números en blanco con un zoom legible, a mitad de sesión", "Defecto de renderizado del gráfico Legacy", "Cambie de pestaña / desplace la rueda como parche; reconstruya la vista en el módulo Chart más nuevo"],
        ["Solo un desplazamiento constante los mantiene visibles", "Síntoma clásico del gráfico Legacy", "Abandone Legacy, el gráfico más nuevo mantiene los números"],
        ["Peor durante mercados rápidos y de alto volumen", "El defecto aflora bajo carga", "No confíe en Legacy para lecturas de order flow en vivo"],
        ["Igual en Chrome, Edge y la app de escritorio", "El bug está en el gráfico Legacy, no en su configuración", "Reinstalar no ayudará; cambie el módulo de gráfico"],
        ["Números bien, pero los colores se ven distintos tras cambiar", "El gráfico más nuevo carece de una opción de estilo exclusiva de Legacy", "Reconfigure los colores en el nuevo gráfico; acepte números fiables"],
      ],
    },
    { type: "heading", text: "No deje que un gráfico parpadeante le cueste la operación" },
    { type: "paragraph", html: "La razón por la que un gráfico Bid-Ask en blanco duele es que lo usa para cronometrar entradas a mano, leer el desequilibrio, hacer clic en la orden. Cuando los números desaparecen durante un minuto en una cinta rápida, ese es exactamente el minuto que se pierde. Si su ventaja es una condición de order flow repetible, el movimiento más sólido es convertir esa lectura en una regla y dejar que se ejecute por sí sola, para que un bug de renderizado en un módulo de gráfico nunca se interponga entre usted y la ejecución. Ahí es donde entra PickMyTrade, conecta sus alertas de TradingView directamente a Tradovate y gestiona las órdenes por usted:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Ejecución nativa de TradingView</strong>, su alerta se dispara desde el gráfico de TradingView en el que ya confía, independientemente de si el gráfico Legacy de Tradovate está dibujando números o no.",
        "<strong class='text-white'>Gestión de brackets del lado del servidor</strong>, su stop y objetivo viven en el motor de PickMyTrade, así que su riesgo queda definido incluso cuando un panel de gráfico se comporta mal.",
        "<strong class='text-white'>Registro automático de operaciones</strong>, cada entrada y salida se registra fuera de la plataforma, dándole un registro limpio que ningún fallo de gráfico puede borrar.",
        "<strong class='text-white'>Sincronización multicuenta</strong>, las mismas órdenes gestionadas se reflejan en todas las cuentas conectadas, así que nunca tiene que conciliar a ojo entre gráficos parpadeantes.",
      ],
    },
  ], fr: [
    { type: "paragraph", html: "Vous lisez le carnet d'ordres sur le graphique Bid-Ask Imbalance, en observant le volume acheteur et vendeur imprimé à l'intérieur de chaque bougie, puis les chiffres s'arrêtent tout simplement. Les bougies continuent de se former. Les barres continuent de s'empiler. Mais les chiffres qui font tout l'intérêt de cette vue sont devenus vides, généralement juste au moment où le tape s'accélère et où vous en avez le plus besoin. Basculez vers un autre onglet et revenez, et ils pourraient réapparaître pendant un moment. Dix minutes plus tard, ils ont de nouveau disparu. Si c'est la boucle dans laquelle vous êtes coincé, vous ne luttez pas contre un réglage que vous avez oublié de basculer, vous avez rencontré un véritable défaut de rendu dans l'ancien graphique de Tradovate, et il existe à la fois un correctif rapide pour tenir la session et une solution permanente qui vaut la peine d'être appliquée une fois pour toutes." },
    { type: "quote", html: "<strong class='text-white'>Correctif le plus rapide :</strong> cliquez sur un autre onglet (ou un autre graphique) et revenez pour forcer le redessin des chiffres Bid-Ask. Faire défiler la molette de la souris sur le graphique fait la même chose. Cela fonctionne souvent, pas toujours. La solution durable consiste à ne plus utiliser le <strong class='text-white'>graphique Legacy</strong> pour cette vue, le bug de rendu des chiffres est corrigé sur le module <strong class='text-white'>Chart</strong> plus récent." },
    {
      type: "checklist",
      heading: "Liste de contrôle rapide pour les chiffres Bid-Ask Imbalance manquants",
      items: [
        "<strong class='text-white'>Vous êtes sur le graphique Legacy</strong>, le défaut des chiffres vides vit ici. Reconstruisez la vue Bid-Ask sur le module Chart plus récent pour en finir définitivement.",
        "<strong class='text-white'>Changez d'onglet ou faites défiler la molette</strong>, un redessin temporaire qui vous fait gagner du temps en pleine session lorsque vous ne pouvez pas vous arrêter pour reconfigurer.",
        "<strong class='text-white'>Vous êtes trop dézoomé</strong>, les chiffres ne rentrent pas dans la largeur de la bougie, ils se cachent donc. Zoomez jusqu'à ce qu'ils réapparaissent.",
        "<strong class='text-white'>Les chiffres ne rentrent pas à votre échelle</strong>, activez <strong class='text-white'>Bar Histograms</strong> pour conserver une lecture visuelle même lorsque les chiffres sont trop petits pour s'imprimer.",
        "<strong class='text-white'>C'est pire sur des marchés rapides</strong>, un volume et une volatilité élevés font davantage apparaître le défaut Legacy. Ce n'est pas votre imagination ni votre flux de données.",
        "<strong class='text-white'>Pareil sur Chrome, Edge et l'application de bureau</strong>, réinstaller ou changer de navigateur ne touchera pas un bug qui vit à l'intérieur du graphique Legacy.",
      ],
    },
    { type: "heading", text: "Ce que signifie réellement « les chiffres Bid-Ask Imbalance ont cessé de s'afficher »" },
    { type: "paragraph", html: "Le graphique Bid-Ask de Tradovate est sa vue footprint intégrée. Au lieu d'un seul corps de bougie, chaque barre décompose le trading par niveau de prix et montre quel volume s'est échangé au bid contre l'ask. Vous l'activez en réglant le type de graphique sur <strong class='text-white'>Bid-Ask Volume</strong>, et de là vous pouvez basculer entre plusieurs lectures des mêmes données : <strong class='text-white'>Bid-Ask Volume</strong> brut, <strong class='text-white'>Delta</strong>, et <strong class='text-white'>Imbalance</strong>. La vue Imbalance est celle qui met en évidence des impressions bid/ask déséquilibrées selon vos propres seuils, et elle repose fortement sur la lisibilité de ces étiquettes numériques. Lorsque les chiffres deviennent vides, la vue perd tout son intérêt." },
    { type: "paragraph", html: "Il n'y a aucune boîte de dialogue d'erreur pour cela. Tradovate n'affiche aucun avertissement ; les chiffres cessent simplement de se dessiner pendant que les bougies continuent. Ce silence explique pourquoi le problème est mal diagnostiqué. Il est utile de savoir qu'il existe deux raisons complètement différentes pour lesquelles les chiffres peuvent disparaître, et la solution dépend entièrement de celle à laquelle vous avez affaire." },
    { type: "heading", text: "Les deux raisons de la disparition des chiffres" },
    { type: "heading", text: "1. Votre niveau de zoom les cache (comportement attendu)" },
    { type: "paragraph", html: "Ce n'est pas un bug. Les chiffres bid/ask ont besoin d'un espace pixel minimum pour se rendre, et si vous êtes suffisamment dézoomé, il n'y a tout simplement pas de place pour les faire tenir dans une bougie avec une taille de police lisible, si bien que Tradovate les cache plutôt que d'imprimer un gribouillis que vous ne pourriez pas lire de toute façon. Zoomez avec la molette jusqu'à ce que les niveaux de prix s'écartent, et les chiffres reviennent. Le compromis est évident : pour garder les chiffres visibles, vous pouvez finir tellement zoomé que vous ne voyez qu'une courte tranche de la session à l'écran à la fois. Si c'est votre situation, les chiffres n'ont jamais vraiment été « cassés », ils ne tenaient tout simplement pas dans l'espace." },
    { type: "heading", text: "2. Le défaut de rendu du graphique Legacy (le véritable bug)" },
    { type: "paragraph", html: "C'est ce que les gens veulent dire quand ils disent que les chiffres « cessent de s'afficher ». Sur l'ancien graphique Legacy, les données numériques deviennent vides de manière aléatoire en cours de session, même lorsque vous êtes suffisamment zoomé pour les lire. Cela persiste aussi, pas un scintillement d'une seconde mais des minutes de graphique inutilisable, et pour certains traders cela dure des jours d'affilée. Cela mord le plus fort pendant les périodes de fort volume et de forte volatilité, lorsque les bougies s'impriment rapidement. Point crucial, cela a été reproduit de la même manière sur Google Chrome, Microsoft Edge, et l'application de bureau Tradovate pour Windows, le tout sur le graphique Legacy. Cette cohérence multiplateforme est l'indice révélateur : si un bug vous suit sur deux navigateurs et une application native, ce n'est ni votre machine, ni votre cache, ni votre connexion. C'est le graphique." },
    { type: "heading", text: "Comment corriger la disparition des chiffres Bid-Ask : étape par étape" },
    { type: "heading", text: "Récupérez les chiffres tout de suite (temporaire)" },
    {
      type: "steps",
      items: [
        { title: "Changez d'onglet et revenez", html: "Cliquez sur un autre onglet d'espace de travail ou un autre onglet de graphique, puis cliquez directement de nouveau sur le graphique Bid-Ask. Le redessin force généralement les chiffres à se repeindre." },
        { title: "Faites défiler la molette", html: "Si le changement d'onglet ne fonctionne pas, survolez le graphique et faites défiler la molette de la souris d'un cran. Ce réajustement pousse également les chiffres à se charger." },
        { title: "Attendez-vous à répéter cela", html: "Sur le graphique Legacy, le correctif tient rarement, vous devrez peut-être faire défiler presque en permanence pour garder les étiquettes à l'écran, c'est exactement pourquoi c'est un palliatif et non une solution." },
      ],
    },
    { type: "heading", text: "Faites tenir les chiffres à votre niveau de zoom (Bar Histograms)" },
    {
      type: "steps",
      items: [
        { title: "Ouvrez les paramètres de la vue Bid-Ask", html: "Si votre problème est réellement le piège du zoom, ouvrez les paramètres du graphique pour la vue Bid-Ask." },
        { title: "Activez Bar Histograms", html: "Activez l'option <strong class='text-white'>Bar Histograms</strong> (parfois affichée comme « Show Bar Histograms ») et choisissez vos couleurs. Cela dessine un petit histogramme de volume à l'intérieur de chaque bougie afin que vous puissiez toujours lire le déséquilibre visuellement lorsque les chiffres numériques ne tiennent pas." },
        { title: "Choisissez un mode de dimensionnement", html: "<strong class='text-white'>PerBar</strong> met à l'échelle l'histogramme de chaque bougie par rapport au plus grand volume à l'intérieur de cette même bougie ; <strong class='text-white'>PerSeries</strong> met à l'échelle chaque barre par rapport au plus grand volume de tout le graphique chargé. PerSeries est meilleur pour comparer les bougies entre elles ; PerBar est meilleur pour lire la forme à l'intérieur d'une bougie." },
        { title: "Confirmez les libellés actuels", html: "Le libellé exact de ces options peut changer entre les versions de la plateforme, confirmez donc les libellés actuels dans votre propre panneau de paramètres. C'est le comportement qui compte : un repli visuel qui survit au dézoom." },
      ],
    },
    { type: "paragraph", html: "Les histogrammes ne guérissent pas le défaut Legacy, si le bug vide une bougie, il peut également vider l'histogramme, mais ils rendent le cas lié au zoom beaucoup moins pénible." },
    { type: "heading", text: "Corrigez-le définitivement (abandonnez le graphique Legacy)" },
    {
      type: "steps",
      items: [
        { title: "Ouvrez un nouveau module Chart", html: "Ouvrez un nouveau module <strong class='text-white'>Chart</strong>, le graphique plus récent, non-Legacy, et chargez le même symbole et le même compte." },
        { title: "Réglez Bid-Ask Volume et Imbalance", html: "Réglez son type de graphique sur <strong class='text-white'>Bid-Ask Volume</strong> et sélectionnez la lecture Imbalance, en faisant correspondre les seuils que vous utilisiez sur la vue Legacy." },
        { title: "Observez-le pendant une période chargée", html: "Le problème d'affichage numérique est résolu sur le module Chart plus récent, si bien que les chiffres devraient rester en place là où le graphique Legacy les aurait perdus." },
        { title: "Retirez le graphique Legacy", html: "Faites du graphique plus récent votre valeur par défaut et retirez le graphique Legacy Bid-Ask de votre espace de travail pour ne pas être tenté de retomber dans le bug." },
      ],
    },
    { type: "paragraph", html: "Une mise en garde honnête : le module Chart plus récent ne reporte pas toutes les options d'affichage Legacy une à une. Si vous comptiez spécifiquement sur une couleur de barre entièrement transparente sur le graphique Legacy, vous pourriez ne pas trouver d'équivalent exact sur le plus récent, c'est la raison principale pour laquelle certains traders s'accrochent à Legacy malgré le scintillement. Vérifiez vos options de couleur et de style après le changement ; pour la plupart des gens, des chiffres fiables valent mieux qu'un réglage de couleur de niche." },
    { type: "heading", text: "Tableau de dépannage" },
    {
      type: "table",
      headers: ["Ce que vous voyez", "Ce qui se passe", "Que faire"],
      rows: [
        ["Chiffres disparus en dézoomant, de retour en zoomant", "Les chiffres ne rentrent pas dans la largeur de la bougie (attendu)", "Zoomez, ou activez Bar Histograms pour un repli visuel"],
        ["Chiffres vides à un zoom lisible, en cours de session", "Défaut de rendu du graphique Legacy", "Changez d'onglet / faites défiler pour patcher ; reconstruisez la vue sur le module Chart plus récent"],
        ["Seul un défilement constant les maintient visibles", "Symptôme classique du graphique Legacy", "Abandonnez Legacy, le graphique plus récent conserve les chiffres"],
        ["Pire sur des marchés rapides à fort volume", "Le défaut apparaît sous charge", "Ne comptez pas sur Legacy pour les lectures de carnet d'ordres en direct"],
        ["Pareil sur Chrome, Edge et l'application de bureau", "Le bug est dans le graphique Legacy, pas dans votre configuration", "Réinstaller n'aidera pas ; changez de module de graphique"],
        ["Chiffres corrects, mais les couleurs semblent différentes après le changement", "Le graphique plus récent manque d'une option de style exclusive à Legacy", "Reconfigurez les couleurs sur le nouveau graphique ; acceptez des chiffres fiables"],
      ],
    },
    { type: "heading", text: "Ne laissez pas un graphique scintillant vous coûter le trade" },
    { type: "paragraph", html: "La raison pour laquelle un graphique Bid-Ask vide fait mal est que vous l'utilisez pour cadencer les entrées à la main, lire le déséquilibre, cliquer sur l'ordre. Lorsque les chiffres disparaissent pendant une minute sur un tape rapide, c'est exactement la minute que vous manquez. Si votre avantage est une condition de carnet d'ordres reproductible, le mouvement le plus solide consiste à transformer cette lecture en règle et à la laisser s'exécuter d'elle-même, afin qu'un bug de rendu sur un module de graphique ne se dresse jamais entre vous et l'exécution. C'est là que PickMyTrade intervient, il relie vos alertes TradingView directement à Tradovate et gère les ordres pour vous :" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Exécution native TradingView</strong>, votre alerte se déclenche depuis le graphique TradingView auquel vous faites déjà confiance, indépendamment du fait que le graphique Legacy de Tradovate dessine des chiffres ou non.",
        "<strong class='text-white'>Gestion des brackets côté serveur</strong>, votre stop et votre objectif vivent sur le moteur de PickMyTrade, si bien que votre risque reste défini même lorsqu'un panneau de graphique se comporte mal.",
        "<strong class='text-white'>Journalisation automatique des trades</strong>, chaque entrée et sortie est enregistrée hors plateforme, vous offrant un registre propre qu'aucun bug de graphique ne peut effacer.",
        "<strong class='text-white'>Synchronisation multi-comptes</strong>, les mêmes ordres gérés se répliquent sur chaque compte connecté, si bien que vous n'avez jamais à réconcilier à l'œil sur des graphiques scintillants.",
      ],
    },
  ], it: [
    { type: "paragraph", html: "State leggendo l'order flow sul grafico Bid-Ask Imbalance, osservando il volume bid e ask stampato dentro ogni candela, e poi i numeri semplicemente si fermano. Le candele continuano a formarsi. Le barre continuano ad accumularsi. Ma le cifre che rendono utile questa vista sono diventate vuote, di solito proprio quando il tape accelera e ne avete più bisogno. Passate a un'altra scheda e tornate indietro e potrebbero riapparire per un po'. Dieci minuti dopo sono di nuovo sparite. Se questo è il ciclo in cui siete bloccati, non state combattendo contro un'impostazione che avete dimenticato di attivare, avete incontrato un vero difetto di rendering nel vecchio grafico di Tradovate, ed esiste sia una patch rapida per superare la sessione sia una soluzione permanente che vale la pena applicare una volta per tutte." },
    { type: "quote", html: "<strong class='text-white'>Soluzione più veloce:</strong> cliccate su un'altra scheda (o un altro grafico) e tornate indietro per forzare il ridisegno dei numeri Bid-Ask. Scorrere la rotellina del mouse sul grafico fa lo stesso. Funziona spesso, non sempre. La soluzione duratura è smettere di usare il <strong class='text-white'>grafico Legacy</strong> per questa vista, il bug di rendering dei numeri è risolto nel più recente modulo <strong class='text-white'>Chart</strong>." },
    {
      type: "checklist",
      heading: "Checklist rapida per i numeri Bid-Ask Imbalance mancanti",
      items: [
        "<strong class='text-white'>Siete sul grafico Legacy</strong>, il difetto dei numeri vuoti vive qui. Ricostruite la vista Bid-Ask sul modulo Chart più recente per porvi fine definitivamente.",
        "<strong class='text-white'>Cambiate scheda o scorrete la rotellina</strong>, un ridisegno temporaneo che vi guadagna tempo a metà sessione quando non potete fermarvi a riconfigurare.",
        "<strong class='text-white'>Siete troppo lontani con lo zoom</strong>, le cifre non entrano nella larghezza della candela, quindi si nascondono. Ingrandite finché non riappaiono.",
        "<strong class='text-white'>I numeri non entrano alla vostra scala</strong>, attivate <strong class='text-white'>Bar Histograms</strong> per mantenere una lettura visiva anche quando le cifre sono troppo piccole per essere stampate.",
        "<strong class='text-white'>È peggio nei mercati veloci</strong>, alto volume e volatilità fanno emergere di più il difetto Legacy. Non è la vostra immaginazione né il vostro feed dati.",
        "<strong class='text-white'>Uguale su Chrome, Edge e l'app desktop</strong>, reinstallare o cambiare browser non toccherà un bug che vive dentro il grafico Legacy.",
      ],
    },
    { type: "heading", text: "Cosa significa davvero «i numeri Bid-Ask Imbalance hanno smesso di mostrarsi»" },
    { type: "paragraph", html: "Il grafico Bid-Ask di Tradovate è la sua vista footprint integrata. Invece di un singolo corpo candela, ogni barra scompone gli scambi per livello di prezzo e mostra quanto volume è stato scambiato al bid rispetto all'ask. Lo attivate impostando il tipo di grafico su <strong class='text-white'>Bid-Ask Volume</strong>, e da lì potete alternare tra alcune letture degli stessi dati: <strong class='text-white'>Bid-Ask Volume</strong> grezzo, <strong class='text-white'>Delta</strong>, e <strong class='text-white'>Imbalance</strong>. La vista Imbalance è quella che evidenzia stampe bid/ask squilibrate in base alle vostre soglie, e si basa pesantemente sul fatto che quelle etichette numeriche siano leggibili. Quando i numeri diventano vuoti, la vista perde tutto il suo scopo." },
    { type: "paragraph", html: "Non c'è alcuna finestra di errore per questo. Tradovate non mostra alcun avviso; le cifre semplicemente smettono di disegnarsi mentre le candele continuano. Quel silenzio è il motivo per cui viene diagnosticato male. Aiuta sapere che ci sono due ragioni completamente diverse per cui i numeri possono scomparire, e la soluzione dipende interamente da quale delle due state affrontando." },
    { type: "heading", text: "Le due ragioni per cui i numeri svaniscono" },
    { type: "heading", text: "1. Il vostro livello di zoom li sta nascondendo (comportamento previsto)" },
    { type: "paragraph", html: "Questo non è un bug. Le cifre bid/ask hanno bisogno di una quantità minima di spazio in pixel per essere renderizzate, e se siete abbastanza lontani con lo zoom, semplicemente non c'è spazio per farle entrare in una candela con una dimensione del font leggibile, quindi Tradovate le nasconde invece di stampare uno sbavatura che comunque non potreste leggere. Ingrandite con la rotellina finché i livelli di prezzo non si allargano, e i numeri tornano. Il compromesso è ovvio: per mantenere le cifre visibili potreste finire per ingrandire così tanto da vedere solo una breve porzione della sessione sullo schermo alla volta. Se questa è la vostra situazione, i numeri non erano mai veramente «rotti», semplicemente non entravano." },
    { type: "heading", text: "2. Il difetto di rendering del grafico Legacy (il bug vero e proprio)" },
    { type: "paragraph", html: "Questo è ciò che la gente intende quando dice che i numeri «smettono di mostrarsi». Sul vecchio grafico Legacy, i dati numerici diventano vuoti in modo casuale durante una sessione anche quando siete abbastanza ingranditi da leggerli. E persiste anche, non uno sfarfallio di un secondo ma minuti di grafico inutilizzabile, e per alcuni trader dura giorni di fila. Tende a mordere più forte durante periodi ad alto volume e alta volatilità, quando le candele si stampano velocemente. Fondamentalmente, è stato riprodotto allo stesso modo su Google Chrome, Microsoft Edge, e l'app desktop di Tradovate per Windows, tutto sul grafico Legacy. Questa coerenza cross-platform è l'indizio: se un bug vi segue su due browser e un'app nativa, non è la vostra macchina, la vostra cache, o la vostra connessione. È il grafico." },
    { type: "heading", text: "Come risolvere i numeri Bid-Ask che scompaiono: passo dopo passo" },
    { type: "heading", text: "Recuperate i numeri subito (temporaneo)" },
    {
      type: "steps",
      items: [
        { title: "Cambiate scheda e tornate indietro", html: "Cliccate su un'altra scheda dello spazio di lavoro o un'altra scheda del grafico, poi cliccate direttamente di nuovo sul grafico Bid-Ask. Il ridisegno di solito forza le cifre a ridipingersi." },
        { title: "Scorrete la rotellina", html: "Se cambiare scheda non funziona, passate il cursore sul grafico e scorrete la rotellina del mouse di uno scatto. Anche questo riadattamento spinge i numeri a caricarsi." },
        { title: "Aspettatevi di dover ripetere questo", html: "Sul grafico Legacy la soluzione raramente regge, potreste dover scorrere quasi costantemente per mantenere le etichette sullo schermo, motivo esattamente per cui è un ripiego e non una soluzione." },
      ],
    },
    { type: "heading", text: "Fate entrare i numeri al vostro zoom (Bar Histograms)" },
    {
      type: "steps",
      items: [
        { title: "Aprite le impostazioni della vista Bid-Ask", html: "Se il vostro problema è davvero la trappola dello zoom, aprite le impostazioni del grafico per la vista Bid-Ask." },
        { title: "Abilitate Bar Histograms", html: "Abilitate l'opzione <strong class='text-white'>Bar Histograms</strong> (a volte mostrata come «Show Bar Histograms») e scegliete i vostri colori. Questo disegna un piccolo istogramma di volume dentro ogni candela così potete continuare a leggere lo squilibrio visivamente quando le cifre numeriche non entrano." },
        { title: "Scegliete una modalità di dimensionamento", html: "<strong class='text-white'>PerBar</strong> scala l'istogramma di ogni candela rispetto al volume più grande all'interno di quella stessa candela; <strong class='text-white'>PerSeries</strong> scala ogni barra rispetto al volume più grande in tutto il grafico caricato. PerSeries è migliore per confrontare le candele tra loro; PerBar è migliore per leggere la forma dentro una candela." },
        { title: "Confermate le etichette attuali", html: "La formulazione esatta di queste opzioni può cambiare tra le versioni della piattaforma, quindi confermate le etichette attuali nel vostro pannello impostazioni. Ciò che conta è il comportamento: un ripiego visivo che sopravvive quando si rimpicciolisce lo zoom." },
      ],
    },
    { type: "paragraph", html: "Gli istogrammi non curano il difetto Legacy, se il bug svuota una candela, può svuotare anche l'istogramma, ma rendono il caso legato allo zoom molto meno doloroso." },
    { type: "heading", text: "Risolvetelo in modo permanente (abbandonate il grafico Legacy)" },
    {
      type: "steps",
      items: [
        { title: "Aprite un nuovo modulo Chart", html: "Aprite un nuovo modulo <strong class='text-white'>Chart</strong>, il grafico più recente, non Legacy, e caricate lo stesso simbolo e conto." },
        { title: "Impostate Bid-Ask Volume e Imbalance", html: "Impostate il suo tipo di grafico su <strong class='text-white'>Bid-Ask Volume</strong> e selezionate la lettura Imbalance, facendo corrispondere le soglie che usavate sulla vista Legacy." },
        { title: "Osservatelo durante un periodo intenso", html: "Il problema della visualizzazione numerica è risolto nel modulo Chart più recente, quindi le cifre dovrebbero restare al loro posto dove il grafico Legacy le avrebbe perse." },
        { title: "Ritirate il grafico Legacy", html: "Rendete il grafico più recente il vostro predefinito e ritirate il grafico Legacy Bid-Ask dal vostro spazio di lavoro così non sarete tentati di ricadere nel bug." },
      ],
    },
    { type: "paragraph", html: "Un avvertimento onesto: il modulo Chart più recente non riporta ogni opzione di visualizzazione Legacy uno a uno. Se facevate specificamente affidamento su un colore barra completamente trasparente sul grafico Legacy, potreste non trovare una corrispondenza esatta su quello più recente, questo è il motivo principale per cui alcuni trader si aggrappano a Legacy nonostante lo sfarfallio. Controllate le vostre opzioni di colore e stile dopo il cambio; per la maggior parte delle persone, numeri affidabili battono un'impostazione di colore di nicchia." },
    { type: "heading", text: "Tabella di risoluzione dei problemi" },
    {
      type: "table",
      headers: ["Cosa vedete", "Cosa sta succedendo", "Cosa fare"],
      rows: [
        ["Numeri spariti quando si rimpicciolisce, tornano quando si ingrandisce", "Le cifre non entrano nella larghezza della candela (previsto)", "Ingrandite, o abilitate Bar Histograms come ripiego visivo"],
        ["Numeri vuoti a uno zoom leggibile, a metà sessione", "Difetto di rendering del grafico Legacy", "Cambiate scheda / scorrete come patch; ricostruite la vista sul modulo Chart più recente"],
        ["Solo uno scorrimento costante li mantiene visibili", "Sintomo classico del grafico Legacy", "Abbandonate Legacy, il grafico più recente mantiene i numeri"],
        ["Peggio durante mercati veloci ad alto volume", "Il difetto emerge sotto carico", "Non affidatevi a Legacy per letture di order flow dal vivo"],
        ["Uguale su Chrome, Edge e app desktop", "Il bug è nel grafico Legacy, non nella vostra configurazione", "Reinstallare non aiuterà; cambiate il modulo del grafico"],
        ["Numeri a posto, ma i colori sembrano diversi dopo il cambio", "Al grafico più recente manca un'opzione di stile esclusiva di Legacy", "Riconfigurate i colori sul nuovo grafico; accettate numeri affidabili"],
      ],
    },
    { type: "heading", text: "Non lasciate che un grafico traballante vi costi l'operazione" },
    { type: "paragraph", html: "Il motivo per cui un grafico Bid-Ask vuoto fa male è che lo usate per cronometrare le entrate a mano, leggere lo squilibrio, cliccare sull'ordine. Quando i numeri spariscono per un minuto in un tape veloce, è esattamente quel minuto che vi perdete. Se il vostro vantaggio è una condizione di order flow ripetibile, la mossa più solida è trasformare quella lettura in una regola e lasciarla eseguire da sola, così un bug di rendering in un modulo del grafico non si frappone mai tra voi e il fill. È qui che entra in gioco PickMyTrade, collega i vostri alert di TradingView direttamente a Tradovate e gestisce gli ordini per voi:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Esecuzione nativa TradingView</strong>, il vostro alert scatta dal grafico TradingView di cui già vi fidate, indipendentemente dal fatto che il grafico Legacy di Tradovate stia disegnando numeri o meno.",
        "<strong class='text-white'>Gestione bracket lato server</strong>, il vostro stop e target vivono sul motore di PickMyTrade, così il vostro rischio resta definito anche quando un pannello del grafico si comporta male.",
        "<strong class='text-white'>Registrazione automatica delle operazioni</strong>, ogni entrata e uscita viene registrata fuori piattaforma, dandovi un registro pulito che nessun glitch del grafico può cancellare.",
        "<strong class='text-white'>Sincronizzazione multi-conto</strong>, gli stessi ordini gestiti si replicano su ogni conto collegato, così non dovete mai riconciliare a occhio tra grafici traballanti.",
      ],
    },
  ] },
  ctaHeading: { en: "Automate Your Order-Flow Read", de: "Automatisieren Sie Ihre Orderflow-Ablesung", es: "Automatice su lectura de order flow", fr: "Automatisez votre lecture de carnet d'ordres", it: "Automatizzate la vostra lettura dell'order flow" },
  ctaText: { en: "Turn a repeatable Bid-Ask imbalance condition into automated Tradovate execution, no chart module has to stay glitch-free for your entries to fire.", de: "Verwandeln Sie eine wiederholbare Bid-Ask-Imbalance-Bedingung in automatisierte Tradovate-Ausführung, kein Chart-Modul muss glitchfrei bleiben, damit Ihre Einstiege feuern.", es: "Convierta una condición repetible de desequilibrio Bid-Ask en ejecución automatizada en Tradovate, ningún módulo de gráfico tiene que permanecer libre de fallos para que se disparen sus entradas.", fr: "Transformez une condition de déséquilibre Bid-Ask reproductible en exécution automatisée sur Tradovate, aucun module de graphique n'a besoin de rester exempt de bugs pour que vos entrées se déclenchent.", it: "Trasformate una condizione ripetibile di squilibrio Bid-Ask in esecuzione automatizzata su Tradovate, nessun modulo del grafico deve restare privo di glitch perché le vostre entrate scattino." },
  ctaButtonText: { en: "Start Your Free 7-Day Trial", de: "Starten Sie Ihre kostenlose 5-Tage-Testphase", es: "Comience su prueba gratuita de 5 días", fr: "Démarrez votre essai gratuit de 5 jours", it: "Iniziate la vostra prova gratuita di 5 giorni" },
  ctaUrl: "https://app.pickmytrade.trade/?register=true&utm_source=content&utm_medium=debugging",
  faqHeading: { en: "Frequently Asked Questions", de: "Häufig gestellte Fragen", es: "Preguntas frecuentes", fr: "Questions fréquentes", it: "Domande frequenti" },
  faqs: { en: [
    { q: "Why did the numbers disappear from my Tradovate Bid-Ask Imbalance chart?", a: "Two things cause it. Either you're zoomed too far out and the bid/ask figures can't fit inside the candle width, or you're on the older Legacy chart, which has a rendering defect that blanks the numbers mid-session. Zoom in to rule out the first; if the numbers still drop at a readable scale, it's the Legacy-chart bug." },
    { q: "How do I get the Bid-Ask numbers to show again fast?", a: "Click to another tab and back, or scroll the mouse wheel on the chart to force a redraw. Both usually pop the numbers back, though not every time, and on the Legacy chart you often have to repeat the scroll almost constantly to keep them visible." },
    { q: "Is this a bug or did I set something up wrong?", a: "If the numbers vanish while you're zoomed in enough to read them, it's a genuine defect in Tradovate's Legacy chart, not a setting you missed. It's been reproduced across Chrome, Edge, and the Windows desktop app, so switching browsers won't help." },
    { q: "Why do the numbers only vanish when the market gets busy?", a: "The Legacy-chart defect shows up most during high volume and volatility, exactly when new candles print fastest. It's frustrating because that's when order-flow reads matter most, but it points straight at the rendering bug rather than your data feed." },
    { q: "What is “Show Bar Histograms” and should I turn it on?", a: "It's a chart setting that draws a small volume histogram inside each candle so you keep a visual read even when the numeric figures are too small to fit. It has PerBar and PerSeries sizing modes. Turn it on if you frequently trade zoomed out, it won't cure the Legacy defect, but it keeps the imbalance readable." },
    { q: "Will moving to the newer Chart module cost me any features?", a: "The newer Chart module fixes the number-rendering problem, but a few Legacy display options may not carry over one-for-one, such as a fully transparent bar color. Labels and available options change between versions, so check your current settings, but for most traders, the reliable numbers are worth the switch." },
    { q: "Does this happen on the desktop app too, or only in a browser?", a: "Both. The blank-numbers issue on the Legacy chart has been seen in Chrome, in Edge, and in the Tradovate desktop app for Windows. Reinstalling the app or clearing your browser won't fix a defect that lives in the Legacy chart itself." },
  ], de: [
    { q: "Warum sind die Zahlen aus meinem Tradovate Bid-Ask-Imbalance-Chart verschwunden?", a: "Zwei Dinge verursachen das. Entweder sind Sie zu weit herausgezoomt und die Bid/Ask-Werte passen nicht in die Candle-Breite, oder Sie sind auf dem älteren Legacy-Chart, der einen Rendering-Defekt hat, der die Zahlen mitten in der Sitzung leert. Zoomen Sie hinein, um Ersteres auszuschließen; fallen die Zahlen bei lesbarem Maßstab immer noch aus, ist es der Legacy-Chart-Bug." },
    { q: "Wie bekomme ich die Bid-Ask-Zahlen schnell wieder angezeigt?", a: "Klicken Sie zu einem anderen Tab und zurück, oder scrollen Sie das Mausrad im Chart, um ein Neuzeichnen zu erzwingen. Beides lässt die Zahlen meist wieder erscheinen, wenn auch nicht jedes Mal, und auf dem Legacy-Chart müssen Sie das Scrollen oft nahezu ständig wiederholen, um sie sichtbar zu halten." },
    { q: "Ist das ein Bug, oder habe ich etwas falsch eingerichtet?", a: "Verschwinden die Zahlen, während Sie weit genug hineingezoomt sind, um sie zu lesen, ist das ein echter Defekt in Tradovates Legacy-Chart, keine verpasste Einstellung. Er wurde über Chrome, Edge und die Windows-Desktop-App hinweg reproduziert, ein Browserwechsel hilft also nicht." },
    { q: "Warum verschwinden die Zahlen nur, wenn der Markt geschäftig wird?", a: "Der Legacy-Chart-Defekt zeigt sich am meisten bei hohem Volumen und hoher Volatilität, genau dann, wenn neue Candles am schnellsten gedruckt werden. Frustrierend, weil genau dann Orderflow-Ablesungen am wichtigsten sind, aber es deutet direkt auf den Rendering-Bug hin, nicht auf Ihren Datenfeed." },
    { q: "Was ist „Show Bar Histograms“ und sollte ich es aktivieren?", a: "Es ist eine Chart-Einstellung, die ein kleines Volumen-Histogramm in jede Candle zeichnet, damit Sie eine visuelle Ablesung behalten, selbst wenn die numerischen Werte zu klein zum Einpassen sind. Es hat PerBar- und PerSeries-Skalierungsmodi. Aktivieren Sie es, wenn Sie häufig herausgezoomt handeln, es heilt den Legacy-Defekt nicht, hält die Imbalance aber lesbar." },
    { q: "Kostet mich der Wechsel zum neueren Chart-Modul irgendwelche Funktionen?", a: "Das neuere Chart-Modul behebt das Zahlen-Rendering-Problem, aber ein paar Legacy-Anzeigeoptionen übertragen sich möglicherweise nicht eins zu eins, etwa eine vollständig transparente Bar-Farbe. Beschriftungen und verfügbare Optionen ändern sich zwischen Versionen, prüfen Sie also Ihre aktuellen Einstellungen, aber für die meisten Trader sind die zuverlässigen Zahlen den Wechsel wert." },
    { q: "Passiert das auch in der Desktop-App, oder nur im Browser?", a: "Beides. Das Leerzahlen-Problem im Legacy-Chart wurde in Chrome, in Edge und in der Tradovate-Desktop-App für Windows beobachtet. Eine Neuinstallation der App oder das Leeren Ihres Browsers behebt keinen Defekt, der im Legacy-Chart selbst liegt." },
  ], es: [
    { q: "¿Por qué desaparecieron los números de mi gráfico Bid-Ask Imbalance de Tradovate?", a: "Dos cosas lo causan. O bien está demasiado alejado con el zoom y las cifras de bid/ask no caben dentro del ancho de la vela, o está en el gráfico Legacy más antiguo, que tiene un defecto de renderizado que deja los números en blanco a mitad de sesión. Amplíe para descartar lo primero; si los números siguen desapareciendo a una escala legible, es el bug del gráfico Legacy." },
    { q: "¿Cómo hago que los números de Bid-Ask vuelvan a mostrarse rápido?", a: "Haga clic en otra pestaña y vuelva, o desplace la rueda del ratón sobre el gráfico para forzar un redibujado. Ambos suelen hacer que los números reaparezcan, aunque no siempre, y en el gráfico Legacy a menudo tiene que repetir el desplazamiento casi constantemente para mantenerlos visibles." },
    { q: "¿Es esto un bug o configuré algo mal?", a: "Si los números desaparecen mientras está lo bastante ampliado como para leerlos, es un defecto genuino en el gráfico Legacy de Tradovate, no un ajuste que se le haya pasado. Se ha reproducido en Chrome, Edge, y la app de escritorio de Windows, así que cambiar de navegador no ayudará." },
    { q: "¿Por qué los números solo desaparecen cuando el mercado se agita?", a: "El defecto del gráfico Legacy aparece más durante el alto volumen y la volatilidad, justo cuando las velas nuevas se imprimen más rápido. Es frustrante porque es cuando más importan las lecturas de order flow, pero apunta directamente al bug de renderizado y no a su feed de datos." },
    { q: "¿Qué es «Show Bar Histograms» y debería activarlo?", a: "Es un ajuste del gráfico que dibuja un pequeño histograma de volumen dentro de cada vela para que mantenga una lectura visual incluso cuando las cifras numéricas son demasiado pequeñas para caber. Tiene modos de dimensionamiento PerBar y PerSeries. Actívelo si opera con frecuencia con el zoom alejado, no cura el defecto de Legacy, pero mantiene el desequilibrio legible." },
    { q: "¿Pasar al módulo Chart más nuevo me costará alguna función?", a: "El módulo Chart más nuevo soluciona el problema de renderizado de números, pero algunas opciones de visualización de Legacy pueden no trasladarse una a una, como un color de barra totalmente transparente. Las etiquetas y opciones disponibles cambian entre versiones, así que revise su configuración actual, pero para la mayoría de los traders, los números fiables valen el cambio." },
