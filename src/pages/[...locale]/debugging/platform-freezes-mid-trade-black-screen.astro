---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "platform-freezes-mid-trade-black-screen";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/debugging/${SLUG}`;

const META_TITLE = "Tradovate Platform Freezes Mid-Trade, Goes Black";
const META_DESCRIPTION =
  "Tradovate freezes mid-trade or goes black? Restart and sign back in to recover, then fix cache, clock and connection to stop it happening again.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Tradovate-Plattform friert mitten im Trade ein und wird schwarz", es: "La plataforma Tradovate se congela y se pone en negro en mitad de una operación", fr: "La plateforme Tradovate se fige et devient noire en plein trade", it: "La piattaforma Tradovate si blocca e diventa nera a metà trade" },
  dek: { en: "Candles quit printing and the screen goes black mid-trade, no chart, no DOM, no way to touch your position. Here's what's actually going on, how to recover fast, and how to stop a frozen app from ever costing you a fill again.", de: "Die Kerzen hören auf zu erscheinen und der Bildschirm wird mitten im Trade schwarz, kein Chart, kein DOM, keine Möglichkeit, Ihre Position anzufassen. Hier erfahren Sie, was wirklich passiert, wie Sie schnell wieder handlungsfähig werden und wie Sie verhindern, dass eine eingefrorene App Sie je wieder einen Fill kostet.", es: "Las velas dejan de formarse y la pantalla se pone en negro en plena operación: sin gráfico, sin DOM, sin forma de tocar su posición. Aquí le explicamos qué ocurre realmente, cómo recuperarse rápido y cómo evitar que una aplicación congelada vuelva a costarle una ejecución.", fr: "Les bougies cessent de s'afficher et l'écran devient noir en plein trade : pas de graphique, pas de DOM, aucun moyen de toucher votre position. Voici ce qui se passe réellement, comment récupérer vite et comment éviter qu'une application figée ne vous coûte à nouveau une exécution.", it: "Le candele smettono di formarsi e lo schermo diventa nero a metà trade, niente grafico, niente DOM, nessun modo di toccare la sua posizione. Ecco che cosa succede davvero, come riprendersi in fretta e come evitare che un'app bloccata le costi ancora un'esecuzione." },
  readTime: { en: "7 min read", de: "7 Min. Lesezeit", es: "Lectura de 7 min", fr: "Lecture : 7 min", it: "Lettura di 7 min" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "You're long two NQ contracts, the candles quit printing, and then the Tradovate screen goes black, no chart, no DOM, no way to touch your position. If that sounds familiar, you're not imagining it. The Tradovate desktop app has frozen and blacked out mid-trade for plenty of traders across the 2024 to 2025 stretch, and on a prop-firm account it can turn a green evaluation into a blown one while you sit there locked out. The same failure hides under a few names: candles stop moving and the screen goes dark, a desktop “white screen” crash, or charts that freeze for minutes in the browser. Here's what's actually going on, how to recover fast, and how to keep a frozen app from ever costing you a fill again." },
    {
      type: "checklist",
      heading: "Quick Checklist for a Frozen Tradovate Platform",
      items: [
        "<strong class='text-white'>Screen black or frozen?</strong> Restart the app (or reload the browser tab) and sign back in, this recovers most freezes.",
        "<strong class='text-white'>Still frozen after restart?</strong> Clear the cache or try an incognito window, then log in fresh.",
        "<strong class='text-white'>Charts freeze but the app stays up?</strong> Sync your system clock and switch to a wired Ethernet connection.",
        "<strong class='text-white'>Getting disconnected in a loop?</strong> Log out of every other device, Tradovate allows only two active sessions.",
        "<strong class='text-white'>Whole platform down, not just you?</strong> Check Tradovate's service-status page; if you can't flatten, phone Tradovate's Emergency Trade Desk.",
        "<strong class='text-white'>Prop-firm account?</strong> Assume the firm will call this a “Tradovate-side” issue, protect yourself with a server-side stop and a backup connection.",
      ],
    },
    { type: "heading", text: "What “Screen Goes Black Mid-Trade” Means" },
    { type: "paragraph", html: "A mid-trade freeze on Tradovate is almost always a client-side failure. The app on <em>your</em> machine stops rendering and stops talking to Tradovate's servers, even though the account itself is still live. That's why the fix is so often “restart and sign back in”, you're not repairing the account, you're relaunching a stalled local session. The pattern is consistent: candles stop moving, the screen turns black (or white, on the desktop build), and the only way out is to close, reopen, and re-authenticate." },
    { type: "paragraph", html: "Here's the reassuring part. A frozen or blacked-out app does <strong class='text-white'>not</strong> automatically cancel your working orders. Tradovate holds resting orders, including bracket stop-loss and take-profit legs, on its servers, not on your local device, so they keep working through an internet drop or an app crash. Tradovate's own guidance is to attach a stop via a Bracket or ATM strategy precisely so your risk is managed even if you lose connection. The freeze is dangerous not because your stop vanishes, but because you're blind: you can't add, move, or cancel anything until you get the app back." },
    { type: "paragraph", html: "It's worth separating two situations. Most freezes are local and self-heal on restart. A smaller share are genuine Tradovate-side outages or degraded market data, where restarting does nothing because the problem is upstream. Knowing which one you're in decides whether you reboot the app or reach for the phone." },
    { type: "heading", text: "Top Causes of Tradovate Freezing" },
    { type: "heading", text: "1. A hung or crashed local app" },
    { type: "paragraph", html: "The most common cause is the app itself locking up, the render loop stalls, the chart stops updating, and the window goes black or white. This is a client-side hang, and it's why a clean relaunch resolves the majority of cases." },
    { type: "heading", text: "2. Network instability" },
    { type: "paragraph", html: "Wi-Fi drops, high latency, or a congested connection can stall the data feed until the chart looks frozen. A brief network hiccup during a fast market is enough to lock the interface for several minutes before it either recovers or blacks out." },
    { type: "heading", text: "3. An unsynced system clock" },
    { type: "paragraph", html: "Tradovate's security checks expect your computer's clock to match its servers closely. If your system time drifts by even a few seconds, sessions can get rejected or dropped, and that shows up as an unresponsive or frozen platform rather than a clear error message." },
    { type: "heading", text: "4. Too many active sessions" },
    { type: "paragraph", html: "Tradovate limits an account to two active sessions at a time across desktop, web, mobile, and TradingView. Log in on several surfaces at once and the sessions start fighting each other, which produces repeated disconnects and frozen charts until you sign out of the extras." },
    { type: "heading", text: "5. A genuine Tradovate-side outage" },
    { type: "paragraph", html: "Sometimes the freeze isn't yours to fix. When Tradovate's servers or market-data feed degrade, everyone freezes at once, and restarting the app changes nothing. On prop-firm accounts this is a familiar sting: a platform-side freeze gets labeled “a Tradovate issue, and we're not responsible”, even after a funded or evaluation account takes the hit." },
    { type: "heading", text: "How to Fix a Frozen Tradovate Platform: Step-by-Step" },
    { type: "heading", text: "Fixing a hung app: restart and sign back in" },
    {
      type: "steps",
      items: [
        { title: "Fully close the app", html: "Fully close the Tradovate desktop app (or close the frozen browser tab)." },
        { title: "Reopen and sign back in", html: "Reopen it and sign back in with your credentials." },
        { title: "Confirm your position and orders", html: "Confirm your position and working orders reappear correctly before you do anything else." },
      ],
    },
    { type: "paragraph", html: "This is the single highest-value step, and it clears most black-screen and frozen-chart events." },
    { type: "heading", text: "Fixing a stubborn freeze: clear cache and switch data server" },
    { type: "paragraph", html: "If a restart alone doesn't stick, corrupted cache or a flaky data route is usually the culprit:" },
    {
      type: "list",
      items: [
        "Clear your browser's cache and cookies, or open a fresh incognito/private window, then log in again.",
        "In Tradovate's settings, find the connection or market-data server option and switch to an alternate server if one is offered, then reconnect.",
      ],
    },
    { type: "paragraph", html: "Menu labels change between platform builds, so confirm the current wording in your version of Tradovate before you flip anything." },
    { type: "heading", text: "Fixing connection and clock problems" },
    {
      type: "list",
      items: [
        "Sync your system clock. On Windows, right-click the taskbar clock, open the date/time settings, and click <strong class='text-white'>Sync now</strong> so your time matches Tradovate's servers.",
        "Switch from Wi-Fi to a wired Ethernet connection to cut latency and dropouts.",
        "If your feed is still unstable, point your DNS at a public resolver such as Google (8.8.8.8) or Cloudflare (1.1.1.1).",
      ],
    },
    { type: "heading", text: "Fixing repeated disconnects: clear extra sessions" },
    { type: "paragraph", html: "Log out of Tradovate everywhere, desktop, web, mobile, and TradingView, then sign in on a single device. Staying under the two-session limit stops the disconnect-and-freeze loop that competing logins cause." },
    { type: "heading", text: "When it is Tradovate's side: check status and get help flattening" },
    { type: "paragraph", html: "If restarting, clearing cache, and reconnecting all fail, the outage is likely upstream. Check Tradovate's service-status page to confirm. If you have an open position you can't manage, Tradovate operates a 24/7 Emergency Trade Desk (Sunday afternoon through Friday afternoon, Central Time) that can flatten positions and cancel orders by phone for live brokerage accounts, call the number published on Tradovate's official contact page, and confirm it's current before you need it. On a prop-firm evaluation account, contact your firm as well, since some emergency actions run through the firm rather than Tradovate directly." },
    { type: "heading", text: "Troubleshooting Table" },
    {
      type: "table",
      headers: ["Symptom", "What it means", "Fix"],
      rows: [
        ["Candles stop, screen goes black", "Local app hang", "Restart the app and sign back in"],
        ["Desktop crashes to a white screen", "Client render crash", "Close and reopen; clear cache if it repeats"],
        ["Charts freeze for several minutes, then recover", "Network / data-feed instability", "Wired Ethernet, sync clock, switch data server"],
        ["Frozen right after login, or repeated disconnects", "Too many active sessions or clock drift", "Log out of all devices; sync system clock"],
        ["Everyone frozen, restart does nothing", "Tradovate-side outage", "Check status page; call the Emergency Trade Desk to flatten"],
        ["Frozen on a prop account, firm blames Tradovate", "Platform-side freeze on a firm-owned account", "Rely on your server-side stop; contact the firm and Tradovate"],
      ],
    },
    { type: "heading", text: "Prevent This with PickMyTrade" },
    { type: "paragraph", html: "You can't stop Tradovate's app from freezing, but you can stop a frozen app from deciding your trade. PickMyTrade links your TradingView alerts straight to Tradovate through its own servers, so your automation doesn't depend on a chart window that just went black:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Server-Side Execution</strong>, your entries and exits route server-to-server, so a frozen or crashed desktop app on your machine doesn't halt an order that's already in flight.",
        "<strong class='text-white'>Always-On Stop &amp; Target Attachment</strong>, every automated entry can carry its stop-loss and take-profit, so a protective bracket sits on Tradovate's servers the moment you're filled, not after you unfreeze the app.",
        "<strong class='text-white'>Multi-Account Sync</strong>, mirror the same order across accounts, giving you a redundant path when one connection stalls.",
        "<strong class='text-white'>Backup Connection Ready</strong>, because your strategy lives in the alert, not the local UI, you can fail over to another device or the web platform without rebuilding anything.",
      ],
    },
    { type: "paragraph", html: "For prop-firm traders who keep hearing that a freeze is “Tradovate's problem,” that server-side layer is the difference between an outage that costs you an account and one you simply wait out." },
  ], de: [
    { type: "paragraph",html: "Sie sind mit zwei NQ-Kontrakten long, die Kerzen hören auf zu erscheinen, und dann wird der Tradovate-Bildschirm schwarz, kein Chart, kein DOM, keine Möglichkeit, Ihre Position anzufassen. Wenn Ihnen das bekannt vorkommt, bilden Sie sich nichts ein. Die Tradovate-Desktop-App ist für viele Trader im Zeitraum 2024 bis 2025 mitten im Trade eingefroren und schwarz geworden, und bei einem Prop-Firm-Konto kann das eine grüne Evaluierung in eine verlorene verwandeln, während Sie ausgesperrt dasitzen. Derselbe Fehler versteckt sich unter einigen Namen: Kerzen bewegen sich nicht mehr und der Bildschirm wird dunkel, ein „weißer Bildschirm“-Absturz auf dem Desktop oder Charts, die im Browser minutenlang einfrieren. Hier erfahren Sie, was wirklich vor sich geht, wie Sie schnell wieder handlungsfähig werden und wie Sie verhindern, dass eine eingefrorene App Sie je wieder einen Fill kostet." },
    {
      type: "checklist",
      heading: "Kurz-Checkliste für eine eingefrorene Tradovate-Plattform",
      items: [
        "<strong class='text-white'>Bildschirm schwarz oder eingefroren?</strong> Starten Sie die App neu (oder laden Sie den Browser-Tab neu) und melden Sie sich erneut an, das behebt die meisten Freezes.",
        "<strong class='text-white'>Nach dem Neustart immer noch eingefroren?</strong> Leeren Sie den Cache oder probieren Sie ein Inkognito-Fenster und melden Sie sich dann frisch an.",
        "<strong class='text-white'>Charts frieren ein, aber die App bleibt oben?</strong> Synchronisieren Sie Ihre Systemuhr und wechseln Sie auf eine kabelgebundene Ethernet-Verbindung.",
        "<strong class='text-white'>Werden Sie in einer Schleife getrennt?</strong> Melden Sie sich auf allen anderen Geräten ab, Tradovate erlaubt nur zwei aktive Sitzungen.",
        "<strong class='text-white'>Ist die ganze Plattform down, nicht nur Sie?</strong> Prüfen Sie die Statusseite von Tradovate; wenn Sie nicht glattstellen können, rufen Sie den Emergency Trade Desk von Tradovate an.",
        "<strong class='text-white'>Prop-Firm-Konto?</strong> Gehen Sie davon aus, dass die Firma das als Problem „auf Tradovate-Seite“ bezeichnet, schützen Sie sich mit einem serverseitigen Stop und einer Backup-Verbindung.",
      ],
    },
    { type: "heading",text: "Was „Bildschirm wird mitten im Trade schwarz“ bedeutet" },
    { type: "paragraph",html: "Ein Einfrieren mitten im Trade bei Tradovate ist fast immer ein clientseitiger Fehler. Die App auf <em>Ihrem</em> Rechner hört auf zu rendern und mit den Servern von Tradovate zu kommunizieren, obwohl das Konto selbst weiterhin live ist. Deshalb lautet die Lösung so oft „neu starten und wieder anmelden“, Sie reparieren nicht das Konto, Sie starten eine hängende lokale Sitzung neu. Das Muster ist konsistent: Kerzen bewegen sich nicht mehr, der Bildschirm wird schwarz (oder weiß beim Desktop-Build), und der einzige Ausweg ist, zu schließen, neu zu öffnen und sich erneut zu authentifizieren." },
    { type: "paragraph",html: "Hier der beruhigende Teil. Eine eingefrorene oder schwarze App storniert Ihre aktiven Orders <strong class='text-white'>nicht</strong> automatisch. Tradovate hält ruhende Orders, einschließlich der Bracket-Stop-Loss- und Take-Profit-Legs, auf seinen Servern und nicht auf Ihrem lokalen Gerät, sodass sie bei einem Internetabbruch oder App-Absturz weiterlaufen. Tradovates eigene Empfehlung lautet, einen Stop über eine Bracket- oder ATM-Strategie anzuhängen, genau damit Ihr Risiko auch bei Verbindungsverlust gesteuert ist. Das Einfrieren ist nicht gefährlich, weil Ihr Stop verschwindet, sondern weil Sie blind sind: Sie können nichts hinzufügen, verschieben oder stornieren, bis Sie die App zurückhaben." },
    { type: "paragraph",html: "Es lohnt sich, zwei Situationen zu unterscheiden. Die meisten Freezes sind lokal und heilen durch einen Neustart von selbst. Ein kleinerer Teil sind echte Ausfälle auf Tradovate-Seite oder beeinträchtigte Marktdaten, bei denen ein Neustart nichts bringt, weil das Problem vorgelagert ist. Zu wissen, in welcher Situation Sie sich befinden, entscheidet darüber, ob Sie die App neu starten oder zum Telefon greifen." },
    { type: "heading",text: "Häufigste Ursachen für das Einfrieren von Tradovate" },
    { type: "heading",text: "1. Eine hängende oder abgestürzte lokale App" },
    { type: "paragraph",html: "Die häufigste Ursache ist, dass die App selbst sich aufhängt: Die Render-Schleife bleibt stehen, der Chart wird nicht mehr aktualisiert, und das Fenster wird schwarz oder weiß. Das ist ein clientseitiges Hängen, und deshalb löst ein sauberer Neustart die Mehrzahl der Fälle." },
    { type: "heading",text: "2. Netzwerkinstabilität" },
    { type: "paragraph",html: "WLAN-Abbrüche, hohe Latenz oder eine überlastete Verbindung können den Datenfeed zum Stocken bringen, bis der Chart eingefroren aussieht. Ein kurzer Netzwerkaussetzer in einem schnellen Markt genügt, um die Oberfläche für mehrere Minuten zu blockieren, bevor sie sich entweder erholt oder schwarz wird." },
    { type: "heading",text: "3. Eine nicht synchronisierte Systemuhr" },
    { type: "paragraph",html: "Die Sicherheitsprüfungen von Tradovate erwarten, dass die Uhr Ihres Computers eng mit seinen Servern übereinstimmt. Weicht Ihre Systemzeit schon um wenige Sekunden ab, können Sitzungen abgelehnt oder getrennt werden, was sich als nicht reagierende oder eingefrorene Plattform statt als klare Fehlermeldung zeigt." },
    { type: "heading",text: "4. Zu viele aktive Sitzungen" },
    { type: "paragraph",html: "Tradovate begrenzt ein Konto auf zwei gleichzeitig aktive Sitzungen über Desktop, Web, Mobil und TradingView hinweg. Melden Sie sich auf mehreren Oberflächen gleichzeitig an, beginnen die Sitzungen, einander zu stören, was wiederholte Verbindungsabbrüche und eingefrorene Charts erzeugt, bis Sie sich von den zusätzlichen abmelden." },
    { type: "heading",text: "5. Ein echter Ausfall auf Tradovate-Seite" },
    { type: "paragraph",html: "Manchmal ist das Einfrieren nicht Ihre Sache. Wenn die Server oder der Marktdatenfeed von Tradovate sich verschlechtern, frieren alle gleichzeitig ein, und ein Neustart der App ändert nichts. Bei Prop-Firm-Konten ist das ein bekannter Stich: Ein plattformseitiges Einfrieren wird als „ein Tradovate-Problem, für das wir nicht verantwortlich sind“ abgetan, selbst nachdem ein finanziertes oder Evaluierungskonto den Schaden getragen hat." },
    { type: "heading",text: "So beheben Sie eine eingefrorene Tradovate-Plattform: Schritt für Schritt" },
    { type: "heading",text: "Eine hängende App beheben: neu starten und wieder anmelden" },
    {
      type: "steps",
      items: [
        { title: "Schließen Sie die App vollständig", html: "Schließen Sie die Tradovate-Desktop-App vollständig (oder schließen Sie den eingefrorenen Browser-Tab)." },
        { title: "Öffnen Sie sie erneut und melden Sie sich wieder an", html: "Öffnen Sie sie erneut und melden Sie sich mit Ihren Zugangsdaten wieder an." },
        { title: "Bestätigen Sie Ihre Position und Orders", html: "Vergewissern Sie sich, dass Ihre Position und Ihre aktiven Orders korrekt wieder erscheinen, bevor Sie irgendetwas anderes tun." },
      ],
    },
    { type: "paragraph",html: "Das ist der wertvollste Einzelschritt, und er behebt die meisten Fälle von schwarzem Bildschirm und eingefrorenem Chart." },
    { type: "heading",text: "Ein hartnäckiges Einfrieren beheben: Cache leeren und Datenserver wechseln" },
    { type: "paragraph",html: "Hilft ein Neustart allein nicht, ist meist ein beschädigter Cache oder eine instabile Datenroute der Übeltäter:" },
    {
      type: "list",
      items: [
        "Leeren Sie Cache und Cookies Ihres Browsers oder öffnen Sie ein frisches Inkognito-/privates Fenster und melden Sie sich erneut an.",
        "Suchen Sie in den Einstellungen von Tradovate die Option für Verbindungs- oder Marktdatenserver und wechseln Sie zu einem alternativen Server, falls einer angeboten wird, und verbinden Sie sich dann neu.",
      ],
    },
    { type: "paragraph",html: "Menübezeichnungen ändern sich zwischen Plattform-Builds; bestätigen Sie daher die aktuelle Formulierung in Ihrer Tradovate-Version, bevor Sie etwas umschalten." },
    { type: "heading",text: "Verbindungs- und Uhrprobleme beheben" },
    {
      type: "list",
      items: [
        "Synchronisieren Sie Ihre Systemuhr. Klicken Sie unter Windows mit der rechten Maustaste auf die Uhr in der Taskleiste, öffnen Sie die Datums-/Uhrzeiteinstellungen und klicken Sie auf <strong class='text-white'>Sync now</strong>, damit Ihre Zeit mit den Servern von Tradovate übereinstimmt.",
        "Wechseln Sie von WLAN auf eine kabelgebundene Ethernet-Verbindung, um Latenz und Aussetzer zu verringern.",
        "Ist Ihr Feed weiterhin instabil, richten Sie Ihr DNS auf einen öffentlichen Resolver wie Google (8.8.8.8) oder Cloudflare (1.1.1.1).",
      ],
    },
    { type: "heading",text: "Wiederholte Verbindungsabbrüche beheben: zusätzliche Sitzungen beenden" },
    { type: "paragraph",html: "Melden Sie sich überall bei Tradovate ab, Desktop, Web, Mobil und TradingView, und melden Sie sich dann auf einem einzigen Gerät an. Unterhalb des Limits von zwei Sitzungen zu bleiben, beendet die Schleife aus Trennung und Einfrieren, die konkurrierende Logins verursachen." },
    { type: "heading",text: "Wenn es an Tradovate liegt: Status prüfen und Hilfe beim Glattstellen holen" },
    { type: "paragraph",html: "Scheitern Neustart, Cache-Leeren und Neuverbinden, liegt der Ausfall wahrscheinlich vorgelagert. Prüfen Sie zur Bestätigung die Statusseite von Tradovate. Haben Sie eine offene Position, die Sie nicht verwalten können, betreibt Tradovate einen 24/7 erreichbaren Emergency Trade Desk (Sonntagnachmittag bis Freitagnachmittag, Central Time), der für Live-Brokerage-Konten Positionen glattstellen und Orders telefonisch stornieren kann; rufen Sie die auf der offiziellen Kontaktseite von Tradovate veröffentlichte Nummer an und bestätigen Sie, dass sie aktuell ist, bevor Sie sie brauchen. Bei einem Prop-Firm-Evaluierungskonto kontaktieren Sie zusätzlich Ihre Firma, da einige Notfallmaßnahmen über die Firma statt direkt über Tradovate laufen." },
    { type: "heading",text: "Fehlerbehebungstabelle" },
    { type: "table", headers: ["Symptom","Bedeutung","Lösung"], rows: [
      ["Kerzen stoppen, Bildschirm wird schwarz","Lokales Hängen der App","App neu starten und wieder anmelden"],
      ["Desktop stürzt auf einen weißen Bildschirm ab","Render-Absturz des Clients","Schließen und neu öffnen; bei Wiederholung Cache leeren"],
      ["Charts frieren mehrere Minuten ein und erholen sich dann","Netzwerk-/Datenfeed-Instabilität","Kabelgebundenes Ethernet, Uhr synchronisieren, Datenserver wechseln"],
      ["Direkt nach dem Login eingefroren oder wiederholte Verbindungsabbrüche","Zu viele aktive Sitzungen oder Uhrabweichung","Auf allen Geräten abmelden; Systemuhr synchronisieren"],
      ["Alle eingefroren, Neustart bringt nichts","Ausfall auf Tradovate-Seite","Statusseite prüfen; Emergency Trade Desk zum Glattstellen anrufen"],
      ["Eingefroren auf einem Prop-Konto, Firma gibt Tradovate die Schuld","Plattformseitiges Einfrieren bei einem Firmenkonto","Auf Ihren serverseitigen Stop verlassen; Firma und Tradovate kontaktieren"],
    ] },
    { type: "heading",text: "Mit PickMyTrade vorbeugen" },
    { type: "paragraph",html: "Sie können nicht verhindern, dass die App von Tradovate einfriert, aber Sie können verhindern, dass eine eingefrorene App über Ihren Trade entscheidet. PickMyTrade verbindet Ihre TradingView-Alerts über eigene Server direkt mit Tradovate, sodass Ihre Automatisierung nicht von einem Chart-Fenster abhängt, das gerade schwarz geworden ist:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Serverseitige Ausführung</strong>, Ihre Einstiege und Ausstiege laufen von Server zu Server, sodass eine eingefrorene oder abgestürzte Desktop-App auf Ihrem Rechner eine bereits laufende Order nicht stoppt.",
        "<strong class='text-white'>Stets angehängter Stop &amp; Target</strong>, jeder automatisierte Einstieg kann seinen Stop-Loss und Take-Profit mitführen, sodass ein schützendes Bracket auf den Servern von Tradovate liegt, sobald Sie ausgeführt sind, nicht erst, nachdem Sie die App wieder zum Laufen gebracht haben.",
        "<strong class='text-white'>Multi-Account-Synchronisierung</strong>, spiegeln Sie dieselbe Order über Konten hinweg und erhalten Sie einen redundanten Pfad, wenn eine Verbindung stockt.",
        "<strong class='text-white'>Backup-Verbindung bereit</strong>, da Ihre Strategie im Alert lebt und nicht in der lokalen Oberfläche, können Sie auf ein anderes Gerät oder die Webplattform umschalten, ohne etwas neu aufzubauen.",
      ],
    },
    { type: "paragraph",html: "Für Prop-Firm-Trader, denen ständig gesagt wird, ein Freeze sei „Tradovates Problem“, ist diese serverseitige Schicht der Unterschied zwischen einem Ausfall, der Sie ein Konto kostet, und einem, den Sie einfach aussitzen." },
  ], es: [
    { type: "paragraph",html: "Está en largo con dos contratos de NQ, las velas dejan de formarse y entonces la pantalla de Tradovate se pone en negro: sin gráfico, sin DOM, sin forma de tocar su posición. Si le suena familiar, no lo está imaginando. La aplicación de escritorio de Tradovate se ha congelado y puesto en negro en mitad de una operación para muchos traders a lo largo de 2024 y 2025, y en una cuenta de prop firm puede convertir una evaluación en verde en una perdida mientras usted se queda bloqueado. El mismo fallo se esconde bajo varios nombres: velas que dejan de moverse y la pantalla que se oscurece, un cierre inesperado con «pantalla blanca» en el escritorio o gráficos que se congelan durante minutos en el navegador. Aquí le explicamos qué ocurre realmente, cómo recuperarse rápido y cómo evitar que una aplicación congelada vuelva a costarle una ejecución." },
    {
      type: "checklist",
      heading: "Lista rápida para una plataforma Tradovate congelada",
      items: [
        "<strong class='text-white'>¿Pantalla en negro o congelada?</strong> Reinicie la aplicación (o recargue la pestaña del navegador) e inicie sesión de nuevo; esto resuelve la mayoría de los congelamientos.",
        "<strong class='text-white'>¿Sigue congelada tras reiniciar?</strong> Borre la caché o pruebe una ventana de incógnito y luego inicie sesión desde cero.",
        "<strong class='text-white'>¿Los gráficos se congelan pero la aplicación sigue activa?</strong> Sincronice el reloj del sistema y cambie a una conexión Ethernet por cable.",
        "<strong class='text-white'>¿Le desconectan en bucle?</strong> Cierre sesión en todos los demás dispositivos, Tradovate solo permite dos sesiones activas.",
        "<strong class='text-white'>¿Toda la plataforma está caída, no solo usted?</strong> Revise la página de estado de Tradovate; si no puede cerrar, llame al Emergency Trade Desk de Tradovate.",
        "<strong class='text-white'>¿Cuenta de prop firm?</strong> Dé por hecho que la firma lo calificará de problema «del lado de Tradovate»; protéjase con un stop del lado del servidor y una conexión de respaldo.",
      ],
    },
    { type: "heading",text: "Qué significa «la pantalla se pone en negro en mitad de una operación»" },
    { type: "paragraph",html: "Un congelamiento en plena operación en Tradovate es casi siempre un fallo del lado del cliente. La aplicación en <em>su</em> equipo deja de renderizar y de comunicarse con los servidores de Tradovate, aunque la cuenta en sí siga activa. Por eso la solución es tan a menudo «reiniciar e iniciar sesión de nuevo»: no está reparando la cuenta, está relanzando una sesión local atascada. El patrón es constante: las velas dejan de moverse, la pantalla se pone en negro (o en blanco, en la versión de escritorio) y la única salida es cerrar, volver a abrir y reautenticarse." },
    { type: "paragraph",html: "Esta es la parte tranquilizadora. Una aplicación congelada o en negro <strong class='text-white'>no</strong> cancela automáticamente sus órdenes activas. Tradovate mantiene las órdenes en reposo, incluidos los tramos de stop-loss y take-profit de un bracket, en sus servidores y no en su dispositivo local, de modo que siguen funcionando durante una caída de internet o un cierre inesperado de la aplicación. La propia indicación de Tradovate es adjuntar un stop mediante una estrategia Bracket o ATM precisamente para que su riesgo esté gestionado aunque pierda la conexión. El congelamiento no es peligroso porque su stop desaparezca, sino porque queda a ciegas: no puede añadir, mover ni cancelar nada hasta recuperar la aplicación." },
    { type: "paragraph",html: "Conviene separar dos situaciones. La mayoría de los congelamientos son locales y se corrigen solos al reiniciar. Una parte menor son verdaderas caídas del lado de Tradovate o datos de mercado degradados, donde reiniciar no hace nada porque el problema está en origen. Saber en cuál se encuentra decide si reinicia la aplicación o echa mano del teléfono." },
    { type: "heading",text: "Principales causas de que Tradovate se congele" },
    { type: "heading",text: "1. Una aplicación local colgada o bloqueada" },
    { type: "paragraph",html: "La causa más común es que la propia aplicación se bloquee: el bucle de renderizado se detiene, el gráfico deja de actualizarse y la ventana se pone en negro o en blanco. Es un bloqueo del lado del cliente, y por eso un relanzamiento limpio resuelve la mayoría de los casos." },
    { type: "heading",text: "2. Inestabilidad de la red" },
    { type: "paragraph",html: "Las caídas de Wi-Fi, la latencia alta o una conexión congestionada pueden detener el feed de datos hasta que el gráfico parezca congelado. Un breve tropiezo de red en un mercado rápido basta para bloquear la interfaz durante varios minutos antes de que se recupere o se ponga en negro." },
    { type: "heading",text: "3. Un reloj del sistema sin sincronizar" },
    { type: "paragraph",html: "Las comprobaciones de seguridad de Tradovate esperan que el reloj de su ordenador coincida estrechamente con sus servidores. Si la hora de su sistema se desvía incluso unos segundos, las sesiones pueden ser rechazadas o cortadas, y eso se manifiesta como una plataforma que no responde o está congelada en lugar de un mensaje de error claro." },
    { type: "heading",text: "4. Demasiadas sesiones activas" },
    { type: "paragraph",html: "Tradovate limita una cuenta a dos sesiones activas a la vez entre escritorio, web, móvil y TradingView. Si inicia sesión en varias superficies a la vez, las sesiones empiezan a pelearse entre sí, lo que produce desconexiones repetidas y gráficos congelados hasta que cierra sesión en las sobrantes." },
    { type: "heading",text: "5. Una verdadera caída del lado de Tradovate" },
    { type: "paragraph",html: "A veces el congelamiento no es algo que usted pueda arreglar. Cuando los servidores o el feed de datos de mercado de Tradovate se degradan, todos se congelan a la vez, y reiniciar la aplicación no cambia nada. En las cuentas de prop firm esto es un aguijón conocido: un congelamiento del lado de la plataforma se etiqueta como «un problema de Tradovate, y no somos responsables», incluso después de que una cuenta fondeada o de evaluación sufra el golpe." },
    { type: "heading",text: "Cómo solucionar una plataforma Tradovate congelada: paso a paso" },
    { type: "heading",text: "Solucionar una aplicación colgada: reiniciar e iniciar sesión de nuevo" },
    {
      type: "steps",
      items: [
        { title: "Cierre la aplicación por completo", html: "Cierre por completo la aplicación de escritorio de Tradovate (o cierre la pestaña congelada del navegador)." },
        { title: "Vuelva a abrirla e inicie sesión de nuevo", html: "Ábrala de nuevo e inicie sesión otra vez con sus credenciales." },
        { title: "Confirme su posición y órdenes", html: "Confirme que su posición y sus órdenes activas reaparecen correctamente antes de hacer cualquier otra cosa." },
      ],
    },
    { type: "paragraph",html: "Este es el paso de mayor valor, y resuelve la mayoría de los eventos de pantalla negra y gráfico congelado." },
    { type: "heading",text: "Solucionar un congelamiento persistente: borrar la caché y cambiar de servidor de datos" },
    { type: "paragraph",html: "Si un reinicio por sí solo no basta, el culpable suele ser una caché corrupta o una ruta de datos inestable:" },
    {
      type: "list",
      items: [
        "Borre la caché y las cookies de su navegador, o abra una ventana nueva de incógnito/privada, y luego inicie sesión de nuevo.",
        "En la configuración de Tradovate, busque la opción de servidor de conexión o de datos de mercado y cambie a un servidor alternativo si se ofrece uno; después vuelva a conectarse.",
      ],
    },
    { type: "paragraph",html: "Las etiquetas de los menús cambian entre versiones de la plataforma, así que confirme el texto vigente en su versión de Tradovate antes de cambiar nada." },
    { type: "heading",text: "Solucionar problemas de conexión y de reloj" },
    {
      type: "list",
      items: [
        "Sincronice el reloj del sistema. En Windows, haga clic derecho en el reloj de la barra de tareas, abra la configuración de fecha y hora y pulse <strong class='text-white'>Sync now</strong> para que su hora coincida con los servidores de Tradovate.",
        "Cambie de Wi-Fi a una conexión Ethernet por cable para reducir la latencia y las caídas.",
        "Si su feed sigue inestable, apunte su DNS a un resolvedor público como Google (8.8.8.8) o Cloudflare (1.1.1.1).",
      ],
    },
    { type: "heading",text: "Solucionar desconexiones repetidas: cerrar las sesiones sobrantes" },
    { type: "paragraph",html: "Cierre sesión en Tradovate en todas partes, escritorio, web, móvil y TradingView, y luego inicie sesión en un único dispositivo. Mantenerse por debajo del límite de dos sesiones detiene el bucle de desconexión y congelamiento que provocan los inicios de sesión en competencia." },
    { type: "heading",text: "Cuando el problema es de Tradovate: revise el estado y busque ayuda para cerrar" },
    { type: "paragraph",html: "Si reiniciar, borrar la caché y reconectar fallan, la caída probablemente está en origen. Revise la página de estado del servicio de Tradovate para confirmarlo. Si tiene una posición abierta que no puede gestionar, Tradovate opera un Emergency Trade Desk 24/7 (de la tarde del domingo a la tarde del viernes, hora central) que puede cerrar posiciones y cancelar órdenes por teléfono en cuentas de corretaje reales; llame al número publicado en la página oficial de contacto de Tradovate y confirme que está vigente antes de necesitarlo. En una cuenta de evaluación de prop firm, contacte también con su firma, ya que algunas acciones de emergencia pasan por la firma y no directamente por Tradovate." },
    { type: "heading",text: "Tabla de solución de problemas" },
    { type: "table", headers: ["Síntoma","Qué significa","Solución"], rows: [
      ["Las velas se detienen, la pantalla se pone en negro","Bloqueo de la aplicación local","Reinicie la aplicación e inicie sesión de nuevo"],
      ["El escritorio se cierra con una pantalla blanca","Fallo de renderizado del cliente","Cierre y vuelva a abrir; borre la caché si se repite"],
      ["Los gráficos se congelan varios minutos y luego se recuperan","Inestabilidad de red / del feed de datos","Ethernet por cable, sincronice el reloj, cambie de servidor de datos"],
      ["Congelado justo después de iniciar sesión, o desconexiones repetidas","Demasiadas sesiones activas o desfase del reloj","Cierre sesión en todos los dispositivos; sincronice el reloj del sistema"],
      ["Todos congelados, reiniciar no hace nada","Caída del lado de Tradovate","Revise la página de estado; llame al Emergency Trade Desk para cerrar"],
      ["Congelado en una cuenta de prop firm, la firma culpa a Tradovate","Congelamiento del lado de la plataforma en una cuenta propiedad de la firma","Confíe en su stop del lado del servidor; contacte con la firma y con Tradovate"],
    ] },
    { type: "heading",text: "Evítelo con PickMyTrade" },
    { type: "paragraph",html: "No puede evitar que la aplicación de Tradovate se congele, pero sí puede evitar que una aplicación congelada decida su operación. PickMyTrade vincula sus alertas de TradingView directamente con Tradovate a través de sus propios servidores, de modo que su automatización no depende de una ventana de gráficos que acaba de ponerse en negro:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Ejecución del lado del servidor</strong>, sus entradas y salidas se enrutan de servidor a servidor, así que una aplicación de escritorio congelada o bloqueada en su equipo no detiene una orden que ya está en curso.",
        "<strong class='text-white'>Adjunción permanente de stop y objetivo</strong>, cada entrada automatizada puede llevar su stop-loss y su take-profit, de modo que un bracket protector queda en los servidores de Tradovate en cuanto se ejecuta, no cuando usted descongela la aplicación.",
        "<strong class='text-white'>Sincronización multicuenta</strong>, replique la misma orden entre cuentas y obtenga una vía redundante cuando una conexión se detiene.",
        "<strong class='text-white'>Conexión de respaldo lista</strong>, como su estrategia vive en la alerta y no en la interfaz local, puede pasar a otro dispositivo o a la plataforma web sin reconstruir nada.",
      ],
    },
    { type: "paragraph",html: "Para los traders de prop firm que oyen una y otra vez que un congelamiento es «el problema de Tradovate», esa capa del lado del servidor marca la diferencia entre una caída que le cuesta una cuenta y una que simplemente espera a que pase." },
  ], fr: [
    { type: "paragraph",html: "Vous êtes long de deux contrats NQ, les bougies cessent de s'imprimer, puis l'écran de Tradovate devient noir : pas de graphique, pas de DOM, aucun moyen de toucher votre position. Si cela vous dit quelque chose, vous ne l'imaginez pas. L'application de bureau Tradovate s'est figée et est devenue noire en plein trade pour de nombreux traders sur la période 2024 à 2025, et sur un compte de prop firm, cela peut transformer une évaluation en vert en évaluation perdue pendant que vous restez bloqué dehors. La même défaillance se cache sous plusieurs noms : des bougies qui cessent de bouger et un écran qui s'assombrit, un plantage « écran blanc » sur le bureau, ou des graphiques qui se figent pendant des minutes dans le navigateur. Voici ce qui se passe réellement, comment récupérer vite et comment éviter qu'une application figée ne vous coûte à nouveau une exécution." },
    {
      type: "checklist",
      heading: "Liste de contrôle rapide pour une plateforme Tradovate figée",
      items: [
        "<strong class='text-white'>Écran noir ou figé ?</strong> Redémarrez l'application (ou rechargez l'onglet du navigateur) et reconnectez-vous, cela règle la plupart des gels.",
        "<strong class='text-white'>Toujours figé après le redémarrage ?</strong> Videz le cache ou essayez une fenêtre de navigation privée, puis connectez-vous à nouveau.",
        "<strong class='text-white'>Les graphiques se figent mais l'application reste ouverte ?</strong> Synchronisez l'horloge de votre système et passez à une connexion Ethernet filaire.",
        "<strong class='text-white'>Déconnexions en boucle ?</strong> Déconnectez-vous de tous les autres appareils, Tradovate n'autorise que deux sessions actives.",
        "<strong class='text-white'>Toute la plateforme est en panne, pas seulement vous ?</strong> Consultez la page d'état de Tradovate ; si vous ne pouvez pas clôturer, appelez l'Emergency Trade Desk de Tradovate.",
        "<strong class='text-white'>Compte de prop firm ?</strong> Partez du principe que la firme parlera d'un problème « côté Tradovate » ; protégez-vous avec un stop côté serveur et une connexion de secours.",
      ],
    },
    { type: "heading",text: "Ce que signifie « l'écran devient noir en plein trade »" },
    { type: "paragraph",html: "Un gel en plein trade sur Tradovate est presque toujours une défaillance côté client. L'application sur <em>votre</em> machine cesse de s'afficher et de dialoguer avec les serveurs de Tradovate, alors même que le compte reste actif. C'est pourquoi la solution est si souvent « redémarrer et se reconnecter » : vous ne réparez pas le compte, vous relancez une session locale bloquée. Le schéma est constant : les bougies cessent de bouger, l'écran devient noir (ou blanc, sur la version de bureau), et la seule issue est de fermer, rouvrir et vous réauthentifier." },
    { type: "paragraph",html: "Voici la partie rassurante. Une application figée ou noire n'annule <strong class='text-white'>pas</strong> automatiquement vos ordres actifs. Tradovate conserve les ordres en attente, y compris les jambes stop-loss et take-profit d'un bracket, sur ses serveurs et non sur votre appareil local, de sorte qu'ils continuent de fonctionner pendant une coupure internet ou un plantage de l'application. La consigne de Tradovate lui-même est de joindre un stop via une stratégie Bracket ou ATM précisément pour que votre risque soit géré même si vous perdez la connexion. Le gel n'est pas dangereux parce que votre stop disparaît, mais parce que vous êtes aveugle : vous ne pouvez rien ajouter, déplacer ou annuler tant que vous n'avez pas récupéré l'application." },
    { type: "paragraph",html: "Il vaut la peine de distinguer deux situations. La plupart des gels sont locaux et se résorbent au redémarrage. Une part plus faible correspond à de véritables pannes côté Tradovate ou à des données de marché dégradées, où redémarrer ne fait rien car le problème est en amont. Savoir dans quelle situation vous êtes décide si vous redémarrez l'application ou si vous prenez le téléphone." },
    { type: "heading",text: "Principales causes de gel de Tradovate" },
    { type: "heading",text: "1. Une application locale bloquée ou plantée" },
    { type: "paragraph",html: "La cause la plus courante est le blocage de l'application elle-même : la boucle de rendu se fige, le graphique cesse de se mettre à jour et la fenêtre devient noire ou blanche. C'est un blocage côté client, et c'est pourquoi un relancement propre règle la majorité des cas." },
    { type: "heading",text: "2. Instabilité du réseau" },
    { type: "paragraph",html: "Des coupures Wi-Fi, une latence élevée ou une connexion saturée peuvent bloquer le flux de données jusqu'à ce que le graphique semble figé. Un bref accroc réseau dans un marché rapide suffit à verrouiller l'interface pendant plusieurs minutes avant qu'elle ne se rétablisse ou ne devienne noire." },
    { type: "heading",text: "3. Une horloge système non synchronisée" },
    { type: "paragraph",html: "Les contrôles de sécurité de Tradovate s'attendent à ce que l'horloge de votre ordinateur corresponde étroitement à celle de ses serveurs. Si l'heure de votre système dérive ne serait-ce que de quelques secondes, les sessions peuvent être rejetées ou coupées, ce qui se manifeste par une plateforme qui ne répond pas ou qui est figée plutôt que par un message d'erreur clair." },
    { type: "heading",text: "4. Trop de sessions actives" },
    { type: "paragraph",html: "Tradovate limite un compte à deux sessions actives à la fois sur bureau, web, mobile et TradingView. Connectez-vous sur plusieurs surfaces en même temps et les sessions commencent à se disputer, ce qui produit des déconnexions répétées et des graphiques figés jusqu'à ce que vous vous déconnectiez des sessions en trop." },
    { type: "heading",text: "5. Une véritable panne côté Tradovate" },
    { type: "paragraph",html: "Parfois, le gel n'est pas de votre ressort. Lorsque les serveurs ou le flux de données de marché de Tradovate se dégradent, tout le monde se fige en même temps, et redémarrer l'application ne change rien. Sur les comptes de prop firm, c'est une piqûre familière : un gel côté plateforme est étiqueté « un problème de Tradovate, nous ne sommes pas responsables », même après qu'un compte financé ou d'évaluation a encaissé le coup." },
    { type: "heading",text: "Comment réparer une plateforme Tradovate figée : pas à pas" },
    { type: "heading",text: "Réparer une application bloquée : redémarrer et se reconnecter" },
    {
      type: "steps",
      items: [
        { title: "Fermez complètement l'application", html: "Fermez complètement l'application de bureau Tradovate (ou fermez l'onglet figé du navigateur)." },
        { title: "Rouvrez-la et reconnectez-vous", html: "Rouvrez-la et reconnectez-vous avec vos identifiants." },
        { title: "Confirmez votre position et vos ordres", html: "Confirmez que votre position et vos ordres actifs réapparaissent correctement avant de faire quoi que ce soit d'autre." },
      ],
    },
    { type: "paragraph",html: "C'est l'étape à plus forte valeur, et elle règle la plupart des événements d'écran noir et de graphique figé." },
    { type: "heading",text: "Réparer un gel tenace : vider le cache et changer de serveur de données" },
    { type: "paragraph",html: "Si un simple redémarrage ne tient pas, un cache corrompu ou une route de données instable est généralement en cause :" },
    {
      type: "list",
      items: [
        "Videz le cache et les cookies de votre navigateur, ou ouvrez une nouvelle fenêtre de navigation privée, puis reconnectez-vous.",
        "Dans les paramètres de Tradovate, trouvez l'option de serveur de connexion ou de données de marché et passez à un serveur alternatif si l'un est proposé, puis reconnectez-vous.",
      ],
    },
    { type: "paragraph",html: "Les libellés des menus changent d'une version de la plateforme à l'autre ; confirmez donc la formulation actuelle dans votre version de Tradovate avant de changer quoi que ce soit." },
    { type: "heading",text: "Réparer les problèmes de connexion et d'horloge" },
    {
      type: "list",
      items: [
        "Synchronisez l'horloge de votre système. Sous Windows, faites un clic droit sur l'horloge de la barre des tâches, ouvrez les paramètres de date et d'heure, puis cliquez sur <strong class='text-white'>Sync now</strong> afin que votre heure corresponde à celle des serveurs de Tradovate.",
        "Passez du Wi-Fi à une connexion Ethernet filaire pour réduire la latence et les coupures.",
        "Si votre flux reste instable, pointez votre DNS vers un résolveur public tel que Google (8.8.8.8) ou Cloudflare (1.1.1.1).",
      ],
    },
    { type: "heading",text: "Réparer les déconnexions répétées : éliminer les sessions en trop" },
    { type: "paragraph",html: "Déconnectez-vous de Tradovate partout, bureau, web, mobile et TradingView, puis connectez-vous sur un seul appareil. Rester sous la limite de deux sessions met fin à la boucle de déconnexion et de gel provoquée par des connexions concurrentes." },
    { type: "heading",text: "Quand le problème vient de Tradovate : vérifier l'état et obtenir de l'aide pour clôturer" },
    { type: "paragraph",html: "Si le redémarrage, le vidage du cache et la reconnexion échouent tous, la panne est probablement en amont. Consultez la page d'état du service de Tradovate pour le confirmer. Si vous avez une position ouverte que vous ne pouvez pas gérer, Tradovate exploite un Emergency Trade Desk 24/7 (du dimanche après-midi au vendredi après-midi, heure centrale) qui peut clôturer des positions et annuler des ordres par téléphone pour les comptes de courtage réels ; appelez le numéro publié sur la page de contact officielle de Tradovate et confirmez qu'il est à jour avant d'en avoir besoin. Sur un compte d'évaluation de prop firm, contactez également votre firme, car certaines actions d'urgence passent par la firme plutôt que directement par Tradovate." },
    { type: "heading",text: "Tableau de dépannage" },
    { type: "table", headers: ["Symptôme","Ce que cela signifie","Solution"], rows: [
      ["Les bougies s'arrêtent, l'écran devient noir","Blocage de l'application locale","Redémarrez l'application et reconnectez-vous"],
      ["Le bureau plante sur un écran blanc","Plantage du rendu du client","Fermez et rouvrez ; videz le cache si cela se répète"],
      ["Les graphiques se figent plusieurs minutes puis se rétablissent","Instabilité du réseau / du flux de données","Ethernet filaire, synchronisez l'horloge, changez de serveur de données"],
      ["Figé juste après la connexion, ou déconnexions répétées","Trop de sessions actives ou dérive de l'horloge","Déconnectez-vous de tous les appareils ; synchronisez l'horloge système"],
      ["Tout le monde est figé, redémarrer ne change rien","Panne côté Tradovate","Consultez la page d'état ; appelez l'Emergency Trade Desk pour clôturer"],
      ["Figé sur un compte de prop firm, la firme accuse Tradovate","Gel côté plateforme sur un compte appartenant à la firme","Fiez-vous à votre stop côté serveur ; contactez la firme et Tradovate"],
    ] },
    { type: "heading",text: "Prévenir cela avec PickMyTrade" },
    { type: "paragraph",html: "Vous ne pouvez pas empêcher l'application de Tradovate de se figer, mais vous pouvez empêcher une application figée de décider de votre trade. PickMyTrade relie vos alertes TradingView directement à Tradovate via ses propres serveurs, de sorte que votre automatisation ne dépend pas d'une fenêtre de graphique qui vient de devenir noire :" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Exécution côté serveur</strong>, vos entrées et sorties sont acheminées de serveur à serveur, de sorte qu'une application de bureau figée ou plantée sur votre machine n'interrompt pas un ordre déjà en cours.",
        "<strong class='text-white'>Stop et objectif toujours joints</strong>, chaque entrée automatisée peut porter son stop-loss et son take-profit, de sorte qu'un bracket de protection se trouve sur les serveurs de Tradovate dès que vous êtes exécuté, et non après que vous avez débloqué l'application.",
        "<strong class='text-white'>Synchronisation multi-comptes</strong>, répliquez le même ordre sur plusieurs comptes et obtenez une voie redondante lorsqu'une connexion se bloque.",
        "<strong class='text-white'>Connexion de secours prête</strong>, comme votre stratégie vit dans l'alerte et non dans l'interface locale, vous pouvez basculer vers un autre appareil ou la plateforme web sans rien reconstruire.",
      ],
    },
    { type: "paragraph",html: "Pour les traders de prop firm à qui l'on répète qu'un gel est « le problème de Tradovate », cette couche côté serveur fait la différence entre une panne qui vous coûte un compte et une panne que vous attendez simplement." },
  ], it: [
    { type: "paragraph",html: "È long due contratti NQ, le candele smettono di formarsi e poi lo schermo di Tradovate diventa nero: niente grafico, niente DOM, nessun modo di toccare la sua posizione. Se le suona familiare, non se lo sta immaginando. L'app desktop di Tradovate si è bloccata ed è diventata nera a metà trade per molti trader nel periodo 2024-2025, e su un conto di prop firm può trasformare una valutazione in verde in una persa mentre lei resta chiuso fuori. Lo stesso guasto si nasconde sotto diversi nomi: candele che smettono di muoversi e schermo che si fa scuro, un crash «schermata bianca» sul desktop o grafici che si bloccano per minuti nel browser. Ecco che cosa succede davvero, come riprendersi in fretta e come evitare che un'app bloccata le costi ancora un'esecuzione." },
    {
      type: "checklist",
      heading: "Checklist rapida per una piattaforma Tradovate bloccata",
      items: [
        "<strong class='text-white'>Schermo nero o bloccato?</strong> Riavvii l'app (o ricarichi la scheda del browser) e acceda di nuovo, questo risolve la maggior parte dei blocchi.",
        "<strong class='text-white'>Ancora bloccato dopo il riavvio?</strong> Svuoti la cache o provi una finestra in incognito, poi acceda da capo.",
        "<strong class='text-white'>I grafici si bloccano ma l'app resta aperta?</strong> Sincronizzi l'orologio di sistema e passi a una connessione Ethernet cablata.",
        "<strong class='text-white'>Viene disconnesso in loop?</strong> Esca da tutti gli altri dispositivi, Tradovate consente solo due sessioni attive.",
        "<strong class='text-white'>È fuori servizio l'intera piattaforma, non solo lei?</strong> Controlli la pagina di stato di Tradovate; se non riesce a chiudere, chiami l'Emergency Trade Desk di Tradovate.",
        "<strong class='text-white'>Conto di prop firm?</strong> Dia per scontato che la firm lo definirà un problema «lato Tradovate»; si protegga con uno stop lato server e una connessione di riserva.",
      ],
    },
    { type: "heading",text: "Che cosa significa «lo schermo diventa nero a metà trade»" },
    { type: "paragraph",html: "Un blocco a metà trade su Tradovate è quasi sempre un guasto lato client. L'app sul <em>suo</em> computer smette di renderizzare e di comunicare con i server di Tradovate, anche se il conto in sé resta attivo. Per questo la soluzione è così spesso «riavviare e accedere di nuovo»: non sta riparando il conto, sta rilanciando una sessione locale bloccata. Lo schema è costante: le candele smettono di muoversi, lo schermo diventa nero (o bianco, nella versione desktop) e l'unica via d'uscita è chiudere, riaprire e autenticarsi di nuovo." },
    { type: "paragraph",html: "Ecco la parte rassicurante. Un'app bloccata o nera <strong class='text-white'>non</strong> annulla automaticamente i suoi ordini attivi. Tradovate mantiene gli ordini in attesa, comprese le gambe stop-loss e take-profit di un bracket, sui suoi server e non sul suo dispositivo locale, quindi continuano a funzionare durante una caduta di internet o un crash dell'app. L'indicazione stessa di Tradovate è allegare uno stop tramite una strategia Bracket o ATM proprio perché il suo rischio sia gestito anche se perde la connessione. Il blocco non è pericoloso perché lo stop sparisce, ma perché lei è cieco: non può aggiungere, spostare o annullare nulla finché non riavrà l'app." },
    { type: "paragraph",html: "Vale la pena distinguere due situazioni. La maggior parte dei blocchi è locale e si risolve da sola al riavvio. Una quota minore è costituita da vere interruzioni lato Tradovate o da dati di mercato degradati, dove riavviare non serve a nulla perché il problema è a monte. Sapere in quale situazione si trova decide se riavviare l'app o prendere il telefono." },
    { type: "heading",text: "Principali cause del blocco di Tradovate" },
    { type: "heading",text: "1. Un'app locale bloccata o andata in crash" },
    { type: "paragraph",html: "La causa più comune è l'app stessa che si blocca: il ciclo di rendering si ferma, il grafico smette di aggiornarsi e la finestra diventa nera o bianca. È un blocco lato client, ed è per questo che un rilancio pulito risolve la maggior parte dei casi." },
    { type: "heading",text: "2. Instabilità della rete" },
    { type: "paragraph",html: "Cadute del Wi-Fi, latenza elevata o una connessione congestionata possono bloccare il feed dati finché il grafico non sembra fermo. Un breve intoppo di rete in un mercato veloce basta a bloccare l'interfaccia per diversi minuti prima che si riprenda o diventi nera." },
    { type: "heading",text: "3. Un orologio di sistema non sincronizzato" },
    { type: "paragraph",html: "I controlli di sicurezza di Tradovate si aspettano che l'orologio del suo computer corrisponda strettamente ai suoi server. Se l'ora di sistema si sposta anche solo di pochi secondi, le sessioni possono essere rifiutate o interrotte, e ciò si manifesta come una piattaforma che non risponde o è bloccata anziché come un chiaro messaggio di errore." },
    { type: "heading",text: "4. Troppe sessioni attive" },
    { type: "paragraph",html: "Tradovate limita un conto a due sessioni attive per volta tra desktop, web, mobile e TradingView. Se accede su più superfici contemporaneamente, le sessioni iniziano a combattersi tra loro, producendo disconnessioni ripetute e grafici bloccati finché non esce da quelle in più." },
    { type: "heading",text: "5. Una vera interruzione lato Tradovate" },
    { type: "paragraph",html: "A volte il blocco non è qualcosa che lei possa risolvere. Quando i server o il feed dei dati di mercato di Tradovate si degradano, si bloccano tutti insieme, e riavviare l'app non cambia nulla. Sui conti di prop firm è una puntura familiare: un blocco lato piattaforma viene etichettato come «un problema di Tradovate, e non ne siamo responsabili», anche dopo che un conto finanziato o di valutazione ha subito il colpo." },
    { type: "heading",text: "Come risolvere una piattaforma Tradovate bloccata: passo dopo passo" },
    { type: "heading",text: "Risolvere un'app bloccata: riavviare e accedere di nuovo" },
    {
      type: "steps",
      items: [
        { title: "Chiuda completamente l'app", html: "Chiuda completamente l'app desktop di Tradovate (o chiuda la scheda del browser bloccata)." },
        { title: "La riapra e acceda di nuovo", html: "La riapra e acceda di nuovo con le sue credenziali." },
        { title: "Confermi la sua posizione e i suoi ordini", html: "Confermi che la sua posizione e i suoi ordini attivi riappaiano correttamente prima di fare qualsiasi altra cosa." },
      ],
    },
    { type: "paragraph",html: "Questo è il passaggio di maggior valore, e risolve la maggior parte degli eventi di schermo nero e grafico bloccato." },
    { type: "heading",text: "Risolvere un blocco ostinato: svuotare la cache e cambiare server dati" },
    { type: "paragraph",html: "Se il solo riavvio non basta, di solito il colpevole è una cache corrotta o una rotta dati instabile:" },
    {
      type: "list",
      items: [
        "Svuoti la cache e i cookie del browser, oppure apra una nuova finestra in incognito/privata, quindi acceda di nuovo.",
        "Nelle impostazioni di Tradovate, trovi l'opzione del server di connessione o dei dati di mercato e passi a un server alternativo se ne viene offerto uno, poi si riconnetta.",
      ],
    },
    { type: "paragraph",html: "Le etichette dei menu cambiano tra le versioni della piattaforma, quindi confermi la dicitura attuale nella sua versione di Tradovate prima di modificare qualsiasi cosa." },
    { type: "heading",text: "Risolvere problemi di connessione e di orologio" },
    {
      type: "list",
      items: [
        "Sincronizzi l'orologio di sistema. In Windows, faccia clic destro sull'orologio della barra delle applicazioni, apra le impostazioni di data e ora e faccia clic su <strong class='text-white'>Sync now</strong> così che la sua ora corrisponda ai server di Tradovate.",
        "Passi dal Wi-Fi a una connessione Ethernet cablata per ridurre latenza e cadute.",
        "Se il suo feed resta instabile, punti il suo DNS a un resolver pubblico come Google (8.8.8.8) o Cloudflare (1.1.1.1).",
      ],
    },
    { type: "heading",text: "Risolvere disconnessioni ripetute: eliminare le sessioni in più" },
    { type: "paragraph",html: "Esca da Tradovate ovunque, desktop, web, mobile e TradingView, poi acceda su un solo dispositivo. Restare al di sotto del limite di due sessioni interrompe il ciclo di disconnessione e blocco causato da login in competizione." },
    { type: "heading",text: "Quando il problema è lato Tradovate: controllare lo stato e ottenere aiuto per chiudere" },
    { type: "paragraph",html: "Se riavviare, svuotare la cache e riconnettersi falliscono tutti, l'interruzione è probabilmente a monte. Controlli la pagina di stato del servizio di Tradovate per confermarlo. Se ha una posizione aperta che non riesce a gestire, Tradovate gestisce un Emergency Trade Desk 24/7 (dal pomeriggio di domenica al pomeriggio di venerdì, ora centrale) che può chiudere posizioni e annullare ordini per telefono per i conti di brokerage reali; chiami il numero pubblicato sulla pagina dei contatti ufficiale di Tradovate e confermi che sia attuale prima di averne bisogno. Su un conto di valutazione di prop firm, contatti anche la sua firm, poiché alcune azioni di emergenza passano attraverso la firm anziché direttamente da Tradovate." },
    { type: "heading",text: "Tabella di risoluzione dei problemi" },
    { type: "table", headers: ["Sintomo","Che cosa significa","Soluzione"], rows: [
      ["Le candele si fermano, lo schermo diventa nero","Blocco dell'app locale","Riavvii l'app e acceda di nuovo"],
      ["Il desktop va in crash su una schermata bianca","Crash del rendering del client","Chiuda e riapra; svuoti la cache se si ripete"],
      ["I grafici si bloccano per diversi minuti, poi si riprendono","Instabilità di rete / del feed dati","Ethernet cablata, sincronizzi l'orologio, cambi server dati"],
      ["Bloccato subito dopo il login, o disconnessioni ripetute","Troppe sessioni attive o deriva dell'orologio","Esca da tutti i dispositivi; sincronizzi l'orologio di sistema"],
      ["Tutti bloccati, il riavvio non serve a nulla","Interruzione lato Tradovate","Controlli la pagina di stato; chiami l'Emergency Trade Desk per chiudere"],
      ["Bloccato su un conto prop, la firm dà la colpa a Tradovate","Blocco lato piattaforma su un conto di proprietà della firm","Si affidi al suo stop lato server; contatti la firm e Tradovate"],
    ] },
    { type: "heading",text: "Prevenga tutto questo con PickMyTrade" },
    { type: "paragraph",html: "Non può impedire che l'app di Tradovate si blocchi, ma può impedire che un'app bloccata decida il suo trade. PickMyTrade collega i suoi alert di TradingView direttamente a Tradovate tramite i propri server, così la sua automazione non dipende da una finestra del grafico che è appena diventata nera:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Esecuzione lato server</strong>, i suoi ingressi e le sue uscite sono instradati da server a server, quindi un'app desktop bloccata o andata in crash sul suo computer non ferma un ordine già in corso.",
        "<strong class='text-white'>Allegato sempre attivo di stop e target</strong>, ogni ingresso automatizzato può portare con sé il suo stop-loss e il suo take-profit, così un bracket protettivo si trova sui server di Tradovate nel momento in cui viene eseguito, non dopo che ha sbloccato l'app.",
        "<strong class='text-white'>Sincronizzazione multi-conto</strong>, replichi lo stesso ordine su più conti e ottenga un percorso ridondante quando una connessione si blocca.",
        "<strong class='text-white'>Connessione di riserva pronta</strong>, poiché la sua strategia vive nell'alert e non nell'interfaccia locale, può passare a un altro dispositivo o alla piattaforma web senza ricostruire nulla.",
      ],
    },
    { type: "paragraph",html: "Per i trader di prop firm che si sentono ripetere che un blocco è «il problema di Tradovate», quel livello lato server è la differenza tra un'interruzione che le costa un conto e una che semplicemente aspetta che passi." },
  ] },
  ctaHeading: { en: "Never Let a Frozen App Cost You a Fill", de: "Lassen Sie eine eingefrorene App nie wieder einen Fill kosten", es: "No deje que una aplicación congelada le cueste una ejecución", fr: "Ne laissez plus une application figée vous coûter une exécution", it: "Non lasci che un'app bloccata le costi un'esecuzione" },
  ctaText: { en: "Route alerts server-side to Tradovate so a frozen or blacked-out app on your machine never halts an order in flight.", de: "Leiten Sie Alerts serverseitig an Tradovate, damit eine eingefrorene oder schwarze App auf Ihrem Rechner nie eine laufende Order stoppt.", es: "Enrute las alertas desde el servidor a Tradovate para que una aplicación congelada o en negro en su equipo nunca detenga una orden en curso.", fr: "Acheminez les alertes côté serveur vers Tradovate pour qu'une application figée ou noire sur votre machine n'interrompe jamais un ordre en cours.", it: "Instradi gli alert lato server verso Tradovate così che un'app bloccata o nera sul suo computer non fermi mai un ordine in corso." },
  ctaButtonText: { en: "Start Your Free 7-Day Trial", de: "Starten Sie Ihre kostenlose 7-Tage-Testphase", es: "Comience su prueba gratuita de 7 días", fr: "Commencez votre essai gratuit de 7 jours", it: "Inizi la prova gratuita di 7 giorni" },
  ctaUrl: "https://app.pickmytrade.trade/?register=true&utm_source=content&utm_medium=debugging",
  faqHeading: { en: "Frequently Asked Questions", de: "Häufig gestellte Fragen", es: "Preguntas frecuentes", fr: "Questions fréquentes", it: "Domande frequenti" },
  faqs: { en: [
    { q: "Why does Tradovate freeze and go black in the middle of a trade?", a: "It's almost always a client-side hang, the app on your machine stops rendering and stops syncing while your account stays live. Restarting the app and signing back in recovers most cases." },
    { q: "If the app freezes, do my stop-loss and take-profit orders get cancelled?", a: "No. Tradovate holds resting orders, including bracket stop and target legs, on its servers, so they keep working through a freeze or internet drop. That's why attaching a stop is best practice." },
    { q: "I restarted and it is still frozen. What now?", a: "Clear your cache or use an incognito window, switch to an alternate data server in settings if one is offered, sync your system clock, and move to a wired connection. If it persists for everyone, it's a Tradovate-side outage." },
    { q: "How do I know if it is my computer or Tradovate that is down?", a: "If a clean restart fixes it, it was local. If restarting changes nothing and it's a known issue when the platform hangs, check Tradovate's service-status page, it's an upstream outage." },
    { q: "I trade a prop-firm account and my firm says the freeze is Tradovate's fault. What can I do?", a: "Prop firms commonly disclaim platform-side freezes. Protect yourself in advance: always trade with a server-side stop attached, keep a backup connection ready, and know how to reach both your firm and Tradovate's Emergency Trade Desk before you're stuck." },
    { q: "Can too many logins cause the freezing?", a: "Yes. Tradovate allows only two active sessions across desktop, web, mobile, and TradingView. Extra sessions can trigger repeated disconnects and frozen charts, log out everywhere and sign in on one device." },
    { q: "How do I flatten a position when the platform will not respond at all?", a: "Tradovate runs a 24/7 Emergency Trade Desk that can flatten positions and cancel orders by phone for live brokerage accounts. Use the number on Tradovate's official contact page, and confirm it's current before an emergency." },
    { q: "Does automation help if Tradovate's own servers are down?", a: "No tool can trade against a broker that's fully offline. But automating through a server-side bridge means a frozen local app no longer stops your orders, only a true Tradovate outage does, and those are far rarer than everyday app freezes." },
  ], de: [
    { q: "Warum friert Tradovate mitten im Trade ein und wird schwarz?", a: "Es ist fast immer ein clientseitiges Hängen: Die App auf Ihrem Rechner hört auf zu rendern und zu synchronisieren, während Ihr Konto live bleibt. Ein Neustart der App und die erneute Anmeldung beheben die meisten Fälle." },
    { q: "Wenn die App einfriert, werden dann meine Stop-Loss- und Take-Profit-Orders storniert?", a: "Nein. Tradovate hält ruhende Orders, einschließlich der Bracket-Stop- und Target-Legs, auf seinen Servern, sodass sie bei einem Einfrieren oder Internetabbruch weiterlaufen. Deshalb ist das Anhängen eines Stops Best Practice." },
    { q: "Ich habe neu gestartet und es ist immer noch eingefroren. Was nun?", a: "Leeren Sie den Cache oder nutzen Sie ein Inkognito-Fenster, wechseln Sie in den Einstellungen zu einem alternativen Datenserver, falls einer angeboten wird, synchronisieren Sie Ihre Systemuhr und wechseln Sie auf eine kabelgebundene Verbindung. Besteht das Problem für alle fort, handelt es sich um einen Ausfall auf Tradovate-Seite." },
    { q: "Woran erkenne ich, ob mein Computer oder Tradovate ausgefallen ist?", a: "Wenn ein sauberer Neustart es behebt, lag es lokal. Wenn ein Neustart nichts ändert und es ein bekanntes Problem ist, wenn die Plattform hängt, prüfen Sie die Statusseite von Tradovate, dann ist es ein vorgelagerter Ausfall." },
    { q: "Ich handle ein Prop-Firm-Konto und meine Firma sagt, das Einfrieren sei Tradovates Schuld. Was kann ich tun?", a: "Prop-Firmen weisen Plattform-seitige Störungen häufig von sich. Schützen Sie sich im Voraus: Handeln Sie immer mit einem serverseitigen Stop, halten Sie eine Backup-Verbindung bereit und wissen Sie, wie Sie sowohl Ihre Firma als auch den Emergency Trade Desk von Tradovate erreichen, bevor Sie festsitzen." },
    { q: "Können zu viele Logins das Einfrieren verursachen?", a: "Ja. Tradovate erlaubt nur zwei aktive Sitzungen über Desktop, Web, Mobil und TradingView hinweg. Zusätzliche Sitzungen können wiederholte Verbindungsabbrüche und eingefrorene Charts auslösen; melden Sie sich überall ab und auf einem Gerät an." },
    { q: "Wie stelle ich eine Position glatt, wenn die Plattform gar nicht reagiert?", a: "Tradovate betreibt einen 24/7 erreichbaren Emergency Trade Desk, der für Live-Brokerage-Konten Positionen glattstellen und Orders telefonisch stornieren kann. Nutzen Sie die Nummer auf der offiziellen Kontaktseite von Tradovate und bestätigen Sie, dass sie aktuell ist, bevor ein Notfall eintritt." },
    { q: "Hilft Automatisierung, wenn die Server von Tradovate selbst ausgefallen sind?", a: "Nein. Kein Werkzeug kann gegen einen Broker handeln, der vollständig offline ist. Aber die Automatisierung über eine serverseitige Brücke bedeutet, dass eine eingefrorene lokale App Ihre Orders nicht mehr stoppt, nur ein echter Tradovate-Ausfall tut das, und die sind weitaus seltener als alltägliche App-Freezes." },
  ], es: [
    { q: "¿Por qué Tradovate se congela y se pone en negro en mitad de una operación?", a: "Casi siempre es un bloqueo del lado del cliente: la aplicación de su equipo deja de renderizar y de sincronizar mientras su cuenta sigue activa. Reiniciar la aplicación y volver a iniciar sesión resuelve la mayoría de los casos." },
    { q: "Si la aplicación se congela, ¿se cancelan mis órdenes de stop-loss y take-profit?", a: "No. Tradovate mantiene las órdenes en reposo, incluidos los tramos de stop y objetivo de un bracket, en sus servidores, de modo que siguen funcionando durante un congelamiento o una caída de internet. Por eso adjuntar un stop es la mejor práctica." },
    { q: "Reinicié y sigue congelado. ¿Y ahora qué?", a: "Borre la caché o use una ventana de incógnito, cambie a un servidor de datos alternativo en la configuración si se ofrece uno, sincronice el reloj del sistema y pase a una conexión por cable. Si persiste para todos, es una caída del lado de Tradovate." },
    { q: "¿Cómo sé si el problema es mi ordenador o Tradovate?", a: "Si un reinicio limpio lo soluciona, era local. Si reiniciar no cambia nada y es un problema conocido cuando la plataforma se cuelga, revise la página de estado del servicio de Tradovate: es una caída en origen." },
    { q: "Opero una cuenta de prop firm y mi firma dice que el congelamiento es culpa de Tradovate. ¿Qué puedo hacer?", a: "Las prop firms suelen eximirse de los congelamientos del lado de la plataforma. Protéjase de antemano: opere siempre con un stop del lado del servidor adjunto, tenga lista una conexión de respaldo y sepa cómo contactar tanto con su firma como con el Emergency Trade Desk de Tradovate antes de quedarse atascado." },
    { q: "¿Pueden demasiados inicios de sesión causar el congelamiento?", a: "Sí. Tradovate solo permite dos sesiones activas entre escritorio, web, móvil y TradingView. Las sesiones adicionales pueden provocar desconexiones repetidas y gráficos congelados; cierre sesión en todas partes e inicie sesión en un solo dispositivo." },
    { q: "¿Cómo cierro una posición cuando la plataforma no responde en absoluto?", a: "Tradovate dispone de un Emergency Trade Desk 24/7 que puede cerrar posiciones y cancelar órdenes por teléfono en cuentas de corretaje reales. Use el número de la página oficial de contacto de Tradovate y confirme que está vigente antes de una emergencia." },
    { q: "¿Ayuda la automatización si los propios servidores de Tradovate están caídos?", a: "No. Ninguna herramienta puede operar contra un broker que está completamente desconectado. Pero automatizar mediante un puente del lado del servidor significa que una aplicación local congelada ya no detiene sus órdenes, solo lo hace una verdadera caída de Tradovate, y esas son mucho más raras que los congelamientos cotidianos de la aplicación." },
  ], fr: [
    { q: "Pourquoi Tradovate se fige-t-il et devient-il noir en plein trade ?", a: "C'est presque toujours un blocage côté client : l'application sur votre machine cesse de s'afficher et de se synchroniser alors que votre compte reste actif. Redémarrer l'application et se reconnecter règle la plupart des cas." },
    { q: "Si l'application se fige, mes ordres de stop-loss et de take-profit sont-ils annulés ?", a: "Non. Tradovate conserve les ordres en attente, y compris les jambes stop et objectif d'un bracket, sur ses serveurs, de sorte qu'ils continuent de fonctionner pendant un gel ou une coupure internet. C'est pourquoi joindre un stop est la bonne pratique." },
    { q: "J'ai redémarré et c'est toujours figé. Que faire ?", a: "Videz le cache ou utilisez une fenêtre de navigation privée, passez à un autre serveur de données dans les paramètres si l'un est proposé, synchronisez l'horloge de votre système et passez à une connexion filaire. Si cela persiste pour tout le monde, il s'agit d'une panne côté Tradovate." },
    { q: "Comment savoir si c'est mon ordinateur ou Tradovate qui est en panne ?", a: "Si un redémarrage propre règle le problème, il était local. Si redémarrer ne change rien et qu'il s'agit d'un problème connu quand la plateforme se fige, consultez la page d'état du service de Tradovate : c'est une panne en amont." },
