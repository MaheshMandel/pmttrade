---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "consistency-rule-locks-payout";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/debugging/${SLUG}`;

const META_TITLE = "Tradovate Prop Payout Locked by Consistency Rule";
const META_DESCRIPTION =
  "Payout held because one big day was too large a share of total profit? Here's how the consistency rule works and how to clear the block.";

// Short SEO title (<=60 chars) for locales where the shared h1 is too long for a SERP title.
const TITLE_OVERRIDE: Partial<Record<Locale, string>> = { es: "Tradovate: pago prop bloqueado por la regla de consistencia", fr: "Tradovate : paiement prop bloqué par la règle de cohérence" };

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Tradovate-Prop-Auszahlung durch Consistency-Regel gesperrt", es: "Pago de cuenta prop de Tradovate bloqueado por la regla de consistencia", fr: "Paiement de compte prop Tradovate bloqué par la règle de cohérence", it: "Payout prop di Tradovate bloccato dalla regola di coerenza" },
  dek: { en: "Your drawdown is fine and your profit target is met, but the payout button does nothing. Here's exactly what the consistency rule checks, and the mechanical fix for clearing it.", de: "Ihr Drawdown ist in Ordnung und Ihr Gewinnziel ist erreicht, aber der Auszahlungs-Button tut nichts. Hier erfahren Sie genau, was die Consistency-Regel prüft, und wie Sie sie mechanisch lösen.", es: "Su drawdown está bien y ha alcanzado su objetivo de beneficio, pero el botón de pago no hace nada. Esto es exactamente lo que comprueba la regla de consistencia y la solución mecánica para superarla.", fr: "Votre drawdown est correct et votre objectif de profit est atteint, mais le bouton de paiement ne fait rien. Voici exactement ce que vérifie la règle de cohérence, et la solution mécanique pour la lever.", it: "Il tuo drawdown va bene e il tuo obiettivo di profitto è raggiunto, ma il pulsante di payout non fa nulla. Ecco esattamente cosa controlla la regola di coerenza e la soluzione meccanica per sbloccarla." },
  readTime: { en: "8 min read", de: "8 Minuten Lesezeit", es: "Lectura de 8 minutos", fr: "Lecture de 8 minutes", it: "Lettura di 8 minuti" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "You passed the evaluation, the account is green, and you finally hit the payout button, and nothing happens. Instead of a pending withdrawal you get a message that your request doesn't meet the &ldquo;consistency requirement,&rdquo; or the amount you're allowed to pull is a fraction of what's sitting in the account. Your drawdown is fine. Your profit target is met. Yet the money won't come out." },
    { type: "paragraph", html: "This is almost always the consistency rule doing its job. It's one of the most misread rules in prop trading because it doesn't behave like the others. It won't blow your account. It just quietly parks your payout until your trading history looks the way the firm wants it to. Here's exactly what's happening and how to clear it." },
    { type: "heading", text: "What the Consistency Rule Actually Measures" },
    { type: "paragraph", html: "The consistency rule looks at one thing: how much of your total profit came from your single best day. Firms want to see money earned steadily, not one lottery-ticket session that carried the whole account. So they take your biggest winning day, divide it by your total net profit for the payout cycle, and check that percentage against a cap." },
    { type: "paragraph", html: "The math is simple:" },
    { type: "quote", html: "(Best day's profit &divide; Total net profit) &times; 100 = your consistency percentage" },
    { type: "paragraph", html: "If that number lands above the firm's cap, your payout is gated. Where the cap sits depends entirely on the firm and often on the account size. Many futures firms set it somewhere in the 20% to 40% range, and some measure your best day against the profit target rather than realized profit. The threshold varies by firm and account size, check your firm's current rules before you plan around a specific number." },
    { type: "paragraph", html: "One thing worth burning into memory: this rule usually applies at the funded and payout stage, and some firms don't apply it at all during the evaluation. That's why plenty of traders sail through the eval trading however they like, get funded, and then run straight into a wall the first time they try to withdraw." },
    { type: "heading", text: "Why Your Payout Is Locked, But Your Account Isn't" },
    { type: "paragraph", html: "This is the part that trips people up. A drawdown breach is a hard failure: cross the trailing floor and the account is done. The consistency rule is nothing like that. It's a gate on the withdrawal, not a strike against the account. Your balance stays exactly where it is, you keep your platform access, and you keep trading. The firm is simply saying, &ldquo;not yet, earn a bit more, spread out, and then we'll release it.&rdquo;" },
    { type: "paragraph", html: "It helps to see the three rules side by side, because they're enforced separately and each fails in its own way." },
    {
      type: "table",
      headers: ["Rule", "What it measures", "What happens if you break it"],
      rows: [
        ["Profit target", "Whether total profit reached a set goal", "You qualify to get funded or request a payout"],
        ["Trailing drawdown", "Whether equity dropped below a moving floor", "Hard breach, the account fails or locks"],
        ["Consistency rule", "Your best day's share of total profit", "Payout is held until you dilute the big day, account stays alive"],
      ],
    },
    { type: "paragraph", html: "Notice that the consistency rule sits in its own lane. Meeting your profit target does not satisfy it. Staying clear of your drawdown does not satisfy it. It's checked on its own, at the moment you request money. The rule that does kill accounts, the trailing drawdown breach, is a completely separate mechanic worth understanding on its own terms if you haven't already." },
    { type: "heading", text: "The Math Behind the Block, With Real Numbers" },
    { type: "paragraph", html: "Say your firm caps any single day at 30% of total profit, a common example threshold, though yours may differ. Watch how the same $3,000 best day moves in and out of compliance as your total profit changes." },
    {
      type: "table",
      headers: ["Situation", "Best day", "Total profit", "Best day as % of total", "Against a 30% cap"],
      rows: [
        ["One big day, little else", "$3,000", "$5,000", "60%", "Blocked"],
        ["After several small green days", "$3,000", "$10,000", "30%", "Right at the line"],
        ["Profit spread out", "$1,200", "$6,000", "20%", "Clears easily"],
      ],
    },
    { type: "paragraph", html: "The big day never gets smaller, you can't undo it. What changes is the denominator. Every extra profitable day you stack on lifts your total, and as the total climbs, that one giant day shrinks as a share of it. A handy shortcut some firms spell out: divide your best day by the cap (as a decimal) to find the minimum total profit you need. A $3,000 best day against a 30% cap needs $3,000 &divide; 0.30 = $10,000 in total profit before the payout will release." },
    { type: "heading", text: "Find Your Numbers Inside Tradovate First" },
    { type: "paragraph", html: "Before you argue with anyone or panic, pull your own figures. Tradovate keeps a per-day record of your results, so you can calculate the exact ratio the firm is checking. Open the account reports or performance area and set the date range to your current payout cycle." },
    { type: "paragraph", html: "Scan the daily column for your single largest profit day. Then note the total net profit for the same window. Divide the first by the second, multiply by 100, and you have your consistency percentage. Tradovate's own account reports and trade performance section shows the exact click path if you're not sure where these reports live." },
    { type: "paragraph", html: "One caution: the number the firm uses is its definition of profit, which may be net of fees and may be tied to a specific cycle window. Your Tradovate report gets you extremely close and tells you whether you're in the ballpark, but the firm's payout dashboard is the source of truth for the final figure." },
    { type: "heading", text: "Where the Block Is Really Enforced" },
    { type: "paragraph", html: "Your payout request doesn't go through Tradovate. It goes through your prop firm's own dashboard, and that's where the consistency check runs. When the firm holds a payout, you'll typically see it flagged there, a note that the request is ineligible, or a smaller allowed amount, with wording that points to consistency or &ldquo;best day&rdquo; limits." },
    { type: "paragraph", html: "This is the single most important thing to understand about the error: Tradovate is the platform, but the rule belongs to the firm. Tradovate will never block a withdrawal for consistency, and support at Tradovate can't lift it. Only the firm can define the cap, and only more trading can satisfy it." },
    { type: "heading", text: "How to Unlock the Payout" },
    { type: "paragraph", html: "There's no trick and no appeal that reliably works, the fix is mechanical. You add controlled, profitable days until your best day falls under the cap." },
    {
      type: "steps",
      items: [
        { title: "Confirm the exact rule", html: "Find your firm's current consistency percentage and, just as important, what it's measured against, total realized profit, or the profit target. A rule &ldquo;against target&rdquo; behaves differently from one &ldquo;against total profit.&rdquo; Don't assume; read the firm's live rules page." },
        { title: "Calculate the gap", html: "Use the shortcut above. Divide your best day by the cap to find the total profit you need, then subtract what you already have. That difference is your homework, the additional profit you need to spread across future sessions." },
        { title: "Trade smaller, steadier days", html: "Now trade to raise the denominator without creating a new outsized day. Modest, repeatable green days are exactly what the rule rewards. Keep your size consistent so you don't accidentally post another day that becomes the new &ldquo;best day&rdquo; and resets the problem." },
        { title: "Re-check, then request", html: "After each session, recompute the ratio. Once your biggest day is comfortably under the cap, leave yourself a small buffer rather than sitting exactly on the line, submit the payout again in the firm's dashboard." },
      ],
    },
    { type: "heading", text: "Keep It From Happening Again" },
    { type: "paragraph", html: "The traders who never trip this rule aren't lucky. They just don't let any single day run away from the rest. The cleanest defense is consistent position sizing. If you cap the number of contracts you'll hold, no single session can balloon into a 60%-of-total monster in the first place." },
    { type: "paragraph", html: "Tradovate gives you a hard tool for that. In your account risk settings you can set a maximum position size, so the platform itself stops you from over-leveraging on a day the setup looks too good to pass up. Locking your size down is the difference between a $1,200 best day and a $3,000 one, and it's the $3,000 day that jams your payout for two weeks." },
    { type: "paragraph", html: "You can set a max position limit directly in Tradovate's risk settings screen. Pair that with a fixed daily profit goal and you naturally build the kind of even distribution the consistency rule is designed to find." },
    { type: "heading", text: "When It's Worth Contacting the Firm" },
    { type: "paragraph", html: "Most of the time the fix is on you, but a few situations justify a message to your firm's support. If the payout dashboard shows a number that flatly contradicts your own Tradovate math, ask them to show their calculation, window, fees, and which &ldquo;best day&rdquo; they used. If the rule appears to have changed mid-cycle, or you're a firm whose eval had no consistency rule and you weren't told the funded stage does, that's a fair conversation. And if you've clearly diluted below the cap and the gate still won't lift, it may be a dashboard sync delay rather than a rule problem. Keep your own daily records so you can point to specifics instead of arguing from memory." },
    { type: "heading", text: "Trade the Same Plan Every Session with PickMyTrade" },
    { type: "paragraph", html: "Trading the same repeatable plan every day is what keeps your results consistent, and consistency is exactly what unlocks payouts. PickMyTrade automates your Tradovate strategy so every session follows the same rules, the same size, and the same discipline, without you second-guessing a big setup or letting one outsized day jam your payout for weeks." },
  ], de: [
    { type: "paragraph", html: "Sie haben die Evaluierung bestanden, das Konto ist im Plus, und Sie klicken endlich auf den Auszahlungs-Button, doch nichts passiert. Statt einer ausstehenden Auszahlung erhalten Sie eine Meldung, dass Ihre Anfrage die &ldquo;Consistency-Anforderung&rdquo; nicht erfüllt, oder der Betrag, den Sie abheben dürfen, ist nur ein Bruchteil dessen, was auf dem Konto liegt. Ihr Drawdown ist in Ordnung. Ihr Gewinnziel ist erreicht. Trotzdem kommt das Geld nicht heraus." },
    { type: "paragraph", html: "Das ist fast immer die Consistency-Regel, die ihre Aufgabe erfüllt. Sie ist eine der am häufigsten missverstandenen Regeln im Prop-Trading, weil sie sich anders verhält als die übrigen. Sie sprengt nicht Ihr Konto. Sie parkt Ihre Auszahlung einfach still, bis Ihre Handelshistorie so aussieht, wie die Firma es sich wünscht. Hier erfahren Sie genau, was passiert und wie Sie es beheben." },
    { type: "heading", text: "Was die Consistency-Regel tatsächlich misst" },
    { type: "paragraph", html: "Die Consistency-Regel betrachtet nur eines: wie viel Ihres Gesamtgewinns von Ihrem besten einzelnen Tag stammt. Firmen wollen sehen, dass Geld stetig verdient wird, nicht eine einzige Lottoschein-Session, die das ganze Konto getragen hat. Also nehmen sie Ihren besten Gewinntag, teilen ihn durch Ihren gesamten Nettogewinn im Auszahlungszyklus und prüfen diesen Prozentsatz gegen eine Obergrenze." },
    { type: "paragraph", html: "Die Mathematik ist einfach:" },
    { type: "quote", html: "(Gewinn des besten Tages &divide; Gesamter Nettogewinn) &times; 100 = Ihr Consistency-Prozentsatz" },
    { type: "paragraph", html: "Liegt diese Zahl über der Obergrenze der Firma, wird Ihre Auszahlung blockiert. Wo diese Obergrenze liegt, hängt vollständig von der Firma ab und oft auch von der Kontogröße. Viele Futures-Firmen legen sie irgendwo zwischen 20 % und 40 % fest, und manche messen Ihren besten Tag gegen das Gewinnziel statt gegen den realisierten Gewinn. Der Schwellenwert variiert je nach Firma und Kontogröße, prüfen Sie die aktuellen Regeln Ihrer Firma, bevor Sie mit einer bestimmten Zahl planen." },
    { type: "paragraph", html: "Eines sollten Sie sich unbedingt merken: Diese Regel gilt in der Regel erst in der Funded- und Auszahlungsphase, und manche Firmen wenden sie während der Evaluierung überhaupt nicht an. Deshalb kommen viele Trader problemlos durch die Evaluierung, handeln wie sie wollen, werden funded und laufen dann beim ersten Auszahlungsversuch direkt gegen eine Wand." },
    { type: "heading", text: "Warum Ihre Auszahlung gesperrt ist, Ihr Konto aber nicht" },
    { type: "paragraph", html: "Das ist der Teil, an dem viele stolpern. Eine Drawdown-Verletzung ist ein harter Fehlschlag: Überschreiten Sie die nachlaufende Untergrenze, ist das Konto erledigt. Die Consistency-Regel ist damit überhaupt nicht vergleichbar. Sie ist eine Schranke für die Auszahlung, kein Verstoß gegen das Konto. Ihr Kontostand bleibt genau dort, wo er ist, Sie behalten Ihren Plattformzugang, und Sie handeln weiter. Die Firma sagt lediglich: &ldquo;noch nicht, verdienen Sie etwas mehr, verteilen Sie es breiter, und dann geben wir es frei.&rdquo;" },
    { type: "paragraph", html: "Es hilft, die drei Regeln nebeneinander zu betrachten, denn sie werden getrennt durchgesetzt und jede scheitert auf ihre eigene Weise." },
    {
      type: "table",
      headers: ["Regel", "Was sie misst", "Was passiert, wenn Sie sie verletzen"],
      rows: [
        ["Gewinnziel", "Ob der Gesamtgewinn ein festgelegtes Ziel erreicht hat", "Sie qualifizieren sich für Funded-Status oder eine Auszahlungsanfrage"],
        ["Trailing Drawdown", "Ob das Eigenkapital unter eine nachlaufende Untergrenze gefallen ist", "Harter Verstoß, das Konto scheitert oder wird gesperrt"],
        ["Consistency-Regel", "Der Anteil Ihres besten Tages am Gesamtgewinn", "Auszahlung wird zurückgehalten, bis Sie den großen Tag verdünnen, das Konto bleibt aktiv"],
      ],
    },
    { type: "paragraph", html: "Beachten Sie, dass die Consistency-Regel eine eigene Spur hat. Das Erreichen Ihres Gewinnziels erfüllt sie nicht. Der Abstand zu Ihrem Drawdown erfüllt sie nicht. Sie wird eigenständig geprüft, in dem Moment, in dem Sie Geld anfordern. Die Regel, die tatsächlich Konten killt, die Trailing-Drawdown-Verletzung, ist ein völlig separater Mechanismus, den Sie sich ebenfalls für sich genommen ansehen sollten, falls Sie das noch nicht getan haben." },
    { type: "heading", text: "Die Mathematik hinter der Sperre, mit echten Zahlen" },
    { type: "paragraph", html: "Angenommen, Ihre Firma begrenzt jeden einzelnen Tag auf 30 % des Gesamtgewinns, ein gängiger Beispielschwellenwert, Ihrer kann jedoch abweichen. Sehen Sie, wie derselbe beste Tag mit $3.000 je nach Veränderung Ihres Gesamtgewinns die Konformität erfüllt oder verfehlt." },
    {
      type: "table",
      headers: ["Situation", "Bester Tag", "Gesamtgewinn", "Bester Tag als % des Gesamtwerts", "Bei einer 30%-Obergrenze"],
      rows: [
        ["Ein großer Tag, sonst wenig", "$3,000", "$5,000", "60%", "Blockiert"],
        ["Nach mehreren kleinen grünen Tagen", "$3,000", "$10,000", "30%", "Genau an der Grenze"],
        ["Gewinn breit verteilt", "$1,200", "$6,000", "20%", "Erfüllt problemlos"],
      ],
    },
    { type: "paragraph", html: "Der große Tag wird nie kleiner, Sie können ihn nicht rückgängig machen. Was sich ändert, ist der Nenner. Jeder zusätzliche profitable Tag, den Sie hinzufügen, erhöht Ihren Gesamtwert, und je höher der Gesamtwert steigt, desto kleiner wird der Anteil dieses einen riesigen Tages. Eine praktische Abkürzung, die manche Firmen angeben: Teilen Sie Ihren besten Tag durch die Obergrenze (als Dezimalzahl), um den minimalen Gesamtgewinn zu finden, den Sie benötigen. Ein bester Tag mit $3.000 gegen eine 30%-Obergrenze benötigt $3.000 &divide; 0,30 = $10.000 Gesamtgewinn, bevor die Auszahlung freigegeben wird." },
    { type: "heading", text: "Finden Sie zuerst Ihre Zahlen in Tradovate" },
    { type: "paragraph", html: "Bevor Sie mit jemandem diskutieren oder in Panik geraten, ziehen Sie Ihre eigenen Zahlen. Tradovate führt eine tagesgenaue Aufzeichnung Ihrer Ergebnisse, sodass Sie das exakte Verhältnis berechnen können, das die Firma prüft. Öffnen Sie die Kontoberichte oder den Performance-Bereich und stellen Sie den Zeitraum auf Ihren aktuellen Auszahlungszyklus ein." },
    { type: "paragraph", html: "Durchsuchen Sie die Tagesspalte nach Ihrem einzelnen größten Gewinntag. Notieren Sie sich dann den gesamten Nettogewinn für denselben Zeitraum. Teilen Sie den ersten Wert durch den zweiten, multiplizieren Sie mit 100, und Sie haben Ihren Consistency-Prozentsatz. Der eigene Bereich für Kontoberichte und Trade-Performance von Tradovate zeigt den genauen Klickpfad, falls Sie nicht sicher sind, wo sich diese Berichte befinden." },
    { type: "paragraph", html: "Eine Warnung: Die Zahl, die die Firma verwendet, entspricht ihrer eigenen Definition von Gewinn, die möglicherweise um Gebühren bereinigt ist und an ein bestimmtes Zyklusfenster gebunden sein kann. Ihr Tradovate-Bericht bringt Sie extrem nah heran und sagt Ihnen, ob Sie im richtigen Bereich liegen, aber das Auszahlungs-Dashboard der Firma ist die maßgebliche Quelle für die endgültige Zahl." },
    { type: "heading", text: "Wo die Sperre tatsächlich durchgesetzt wird" },
    { type: "paragraph", html: "Ihre Auszahlungsanfrage läuft nicht über Tradovate. Sie läuft über das eigene Dashboard Ihrer Prop-Firma, und dort wird auch die Consistency-Prüfung durchgeführt. Hält die Firma eine Auszahlung zurück, sehen Sie das in der Regel dort markiert, ein Hinweis, dass die Anfrage nicht zulässig ist, oder einen kleineren erlaubten Betrag, mit einer Formulierung, die auf Consistency- oder &ldquo;Best-Day&rdquo;-Grenzen hinweist." },
    { type: "paragraph", html: "Das ist der mit Abstand wichtigste Punkt, den Sie zu diesem Fehler verstehen sollten: Tradovate ist die Plattform, aber die Regel gehört der Firma. Tradovate wird niemals eine Auszahlung wegen Consistency blockieren, und der Tradovate-Support kann diese Sperre nicht aufheben. Nur die Firma kann die Obergrenze festlegen, und nur weiteres Trading kann sie erfüllen." },
    { type: "heading", text: "So schalten Sie die Auszahlung frei" },
    { type: "paragraph", html: "Es gibt keinen Trick und keinen Einspruch, der zuverlässig funktioniert, die Lösung ist mechanisch. Sie fügen kontrollierte, profitable Tage hinzu, bis Ihr bester Tag unter die Obergrenze fällt." },
    {
      type: "steps",
      items: [
        { title: "Bestätigen Sie die genaue Regel", html: "Finden Sie den aktuellen Consistency-Prozentsatz Ihrer Firma heraus und, ebenso wichtig, woran er gemessen wird, am gesamten realisierten Gewinn oder am Gewinnziel. Eine Regel &ldquo;gegen das Ziel&rdquo; verhält sich anders als eine &ldquo;gegen den Gesamtgewinn&rdquo;. Gehen Sie nicht von Annahmen aus; lesen Sie die aktuelle Regelseite der Firma." },
        { title: "Berechnen Sie die Lücke", html: "Nutzen Sie die obige Abkürzung. Teilen Sie Ihren besten Tag durch die Obergrenze, um den benötigten Gesamtgewinn zu ermitteln, und ziehen Sie dann ab, was Sie bereits haben. Diese Differenz ist Ihre Hausaufgabe, der zusätzliche Gewinn, den Sie über künftige Sessions verteilen müssen." },
        { title: "Handeln Sie kleinere, stetigere Tage", html: "Handeln Sie jetzt so, dass Sie den Nenner erhöhen, ohne einen neuen überdimensionierten Tag zu erzeugen. Bescheidene, wiederholbare grüne Tage sind genau das, was die Regel belohnt. Halten Sie Ihre Größe konsistent, damit Sie nicht versehentlich einen weiteren Tag erzielen, der zum neuen &ldquo;besten Tag&rdquo; wird und das Problem zurücksetzt." },
        { title: "Erneut prüfen, dann anfordern", html: "Berechnen Sie nach jeder Session das Verhältnis neu. Sobald Ihr größter Tag komfortabel unter der Obergrenze liegt, lassen Sie sich lieber einen kleinen Puffer, statt genau auf der Grenze zu liegen, und reichen Sie die Auszahlung erneut im Dashboard der Firma ein." },
      ],
    },
    { type: "heading", text: "So verhindern Sie, dass es erneut passiert" },
    { type: "paragraph", html: "Trader, die diese Regel nie auslösen, haben kein Glück. Sie lassen einfach keinen einzelnen Tag von den übrigen davonlaufen. Die sauberste Verteidigung ist eine konsistente Positionsgröße. Wenn Sie die Anzahl der Kontrakte begrenzen, die Sie halten, kann sich von vornherein keine einzelne Session zu einem 60%-Monster des Gesamtwerts aufblähen." },
    { type: "paragraph", html: "Tradovate stellt Ihnen dafür ein hartes Werkzeug zur Verfügung. In Ihren Konto-Risikoeinstellungen können Sie eine maximale Positionsgröße festlegen, sodass die Plattform selbst Sie davon abhält, sich an einem Tag zu übernehmen, an dem das Setup zu gut aussieht, um es sich entgehen zu lassen. Eine feste Größenbegrenzung macht den Unterschied zwischen einem besten Tag mit $1.200 und einem mit $3.000, und es ist der Tag mit $3.000, der Ihre Auszahlung zwei Wochen lang blockiert." },
    { type: "paragraph", html: "Sie können ein maximales Positionslimit direkt im Risikoeinstellungsbildschirm von Tradovate festlegen. Kombinieren Sie das mit einem festen täglichen Gewinnziel, und Sie bauen ganz natürlich genau die gleichmäßige Verteilung auf, nach der die Consistency-Regel sucht." },
    { type: "heading", text: "Wann es sich lohnt, die Firma zu kontaktieren" },
    { type: "paragraph", html: "Meistens liegt die Lösung bei Ihnen selbst, aber ein paar Situationen rechtfertigen eine Nachricht an den Support Ihrer Firma. Zeigt das Auszahlungs-Dashboard eine Zahl, die Ihrer eigenen Tradovate-Rechnung eindeutig widerspricht, bitten Sie um Offenlegung von Berechnung, Zeitfenster, Gebühren und welchen &ldquo;besten Tag&rdquo; sie verwendet haben. Scheint sich die Regel mitten im Zyklus geändert zu haben, oder hatte Ihre Evaluierung keine Consistency-Regel und Ihnen wurde nicht mitgeteilt, dass die Funded-Phase eine hat, ist das ein berechtigtes Gespräch. Und wenn Sie eindeutig unter die Obergrenze verdünnt haben und die Sperre trotzdem nicht aufgeht, könnte es eine Synchronisationsverzögerung im Dashboard sein statt ein Regelproblem. Führen Sie eigene Tagesaufzeichnungen, damit Sie auf konkrete Fakten verweisen können, statt aus dem Gedächtnis zu argumentieren." },
    { type: "heading", text: "Handeln Sie mit PickMyTrade jede Session nach demselben Plan" },
    { type: "paragraph", html: "Jeden Tag denselben wiederholbaren Plan zu handeln, hält Ihre Ergebnisse konstant, und genau Konsistenz ist es, was Auszahlungen freischaltet. PickMyTrade automatisiert Ihre Tradovate-Strategie, sodass jede Session denselben Regeln, derselben Größe und derselben Disziplin folgt, ohne dass Sie ein großes Setup infrage stellen oder ein überdimensionierter Tag Ihre Auszahlung wochenlang blockiert." },
  ], es: [
    { type: "paragraph", html: "Ha superado la evaluación, la cuenta está en verde, y por fin pulsa el botón de pago, y no pasa nada. En lugar de un retiro pendiente, recibe un mensaje de que su solicitud no cumple el &ldquo;requisito de consistencia&rdquo;, o el importe que se le permite retirar es solo una fracción de lo que hay en la cuenta. Su drawdown está bien. Su objetivo de beneficio se ha cumplido. Y aun así el dinero no sale." },
    { type: "paragraph", html: "Esto casi siempre es la regla de consistencia haciendo su trabajo. Es una de las reglas más malinterpretadas en el trading con cuentas prop porque no se comporta como las demás. No hace saltar su cuenta. Simplemente detiene en silencio su pago hasta que su historial de trading tenga el aspecto que la firma quiere. Esto es exactamente lo que está pasando y cómo solucionarlo." },
    { type: "heading", text: "Qué mide realmente la regla de consistencia" },
    { type: "paragraph", html: "La regla de consistencia analiza una sola cosa: qué parte de su beneficio total proviene de su único mejor día. Las firmas quieren ver dinero ganado de forma constante, no una única sesión de billete de lotería que sostuvo toda la cuenta. Así que toman su día ganador más grande, lo dividen entre su beneficio neto total del ciclo de pago y comprueban ese porcentaje frente a un límite." },
    { type: "paragraph", html: "El cálculo es sencillo:" },
    { type: "quote", html: "(Beneficio del mejor día &divide; Beneficio neto total) &times; 100 = su porcentaje de consistencia" },
    { type: "paragraph", html: "Si ese número supera el límite de la firma, su pago queda bloqueado. Dónde se sitúa ese límite depende por completo de la firma y a menudo del tamaño de la cuenta. Muchas firmas de futuros lo fijan en algún punto entre el 20% y el 40%, y algunas miden su mejor día frente al objetivo de beneficio en lugar del beneficio realizado. El umbral varía según la firma y el tamaño de la cuenta, compruebe las reglas actuales de su firma antes de planificar en torno a una cifra concreta." },
    { type: "paragraph", html: "Algo que vale la pena grabarse en la memoria: esta regla suele aplicarse en la etapa financiada y de pago, y algunas firmas no la aplican en absoluto durante la evaluación. Por eso muchos traders pasan la evaluación operando como quieren, obtienen la cuenta financiada, y luego chocan de frente con un muro la primera vez que intentan retirar." },
    { type: "heading", text: "Por qué su pago está bloqueado, pero su cuenta no" },
    { type: "paragraph", html: "Esta es la parte que confunde a la gente. Una violación del drawdown es un fallo definitivo: cruce el suelo móvil y la cuenta se acaba. La regla de consistencia no se parece en nada a eso. Es una barrera para el retiro, no una sanción contra la cuenta. Su saldo permanece exactamente donde está, conserva su acceso a la plataforma y sigue operando. La firma simplemente dice: &ldquo;todavía no, gane un poco más, repártalo, y entonces lo liberaremos.&rdquo;" },
    { type: "paragraph", html: "Ayuda ver las tres reglas una junto a otra, porque se aplican por separado y cada una falla a su manera." },
    {
      type: "table",
      headers: ["Regla", "Qué mide", "Qué sucede si la incumple"],
      rows: [
        ["Objetivo de beneficio", "Si el beneficio total alcanzó una meta fijada", "Se cualifica para obtener financiación o solicitar un pago"],
        ["Drawdown móvil", "Si el capital cayó por debajo de un suelo móvil", "Incumplimiento definitivo, la cuenta falla o se bloquea"],
        ["Regla de consistencia", "La proporción de su mejor día respecto al beneficio total", "El pago se retiene hasta que diluya el día grande, la cuenta permanece activa"],
      ],
    },
    { type: "paragraph", html: "Observe que la regla de consistencia va por su propio carril. Cumplir su objetivo de beneficio no la satisface. Mantenerse alejado de su drawdown no la satisface. Se comprueba de forma independiente, en el momento en que solicita dinero. La regla que sí acaba con las cuentas, la violación del drawdown móvil, es un mecanismo completamente distinto que merece la pena entender por sí mismo si aún no lo ha hecho." },
    { type: "heading", text: "El cálculo detrás del bloqueo, con números reales" },
    { type: "paragraph", html: "Suponga que su firma limita cualquier día individual al 30% del beneficio total, un umbral de ejemplo habitual, aunque el suyo puede ser diferente. Observe cómo el mismo mejor día de $3.000 entra y sale del cumplimiento a medida que cambia su beneficio total." },
    {
      type: "table",
      headers: ["Situación", "Mejor día", "Beneficio total", "Mejor día como % del total", "Frente a un límite del 30%"],
      rows: [
        ["Un día grande, poco más", "$3,000", "$5,000", "60%", "Bloqueado"],
        ["Después de varios días verdes pequeños", "$3,000", "$10,000", "30%", "Justo en el límite"],
        ["Beneficio repartido", "$1,200", "$6,000", "20%", "Cumple fácilmente"],
      ],
    },
    { type: "paragraph", html: "El día grande nunca se hace más pequeño, no se puede deshacer. Lo que cambia es el denominador. Cada día adicional rentable que acumula eleva su total, y a medida que el total sube, ese único día enorme se reduce como proporción de él. Un atajo útil que algunas firmas indican: divida su mejor día entre el límite (como decimal) para encontrar el beneficio total mínimo que necesita. Un mejor día de $3.000 frente a un límite del 30% necesita $3.000 &divide; 0,30 = $10.000 de beneficio total antes de que se libere el pago." },
    { type: "heading", text: "Primero encuentre sus números dentro de Tradovate" },
    { type: "paragraph", html: "Antes de discutir con nadie o entrar en pánico, obtenga sus propias cifras. Tradovate mantiene un registro diario de sus resultados, para que pueda calcular la proporción exacta que la firma está comprobando. Abra los informes de la cuenta o la sección de rendimiento y ajuste el rango de fechas a su ciclo de pago actual." },
    { type: "paragraph", html: "Revise la columna diaria en busca de su único mayor día de beneficio. Después anote el beneficio neto total para la misma ventana. Divida el primero entre el segundo, multiplique por 100, y tendrá su porcentaje de consistencia. La propia sección de informes de cuenta y rendimiento de operaciones de Tradovate muestra la ruta exacta de clics si no está seguro de dónde se encuentran estos informes." },
    { type: "paragraph", html: "Una advertencia: el número que usa la firma corresponde a su propia definición de beneficio, que puede estar neta de comisiones y puede estar vinculada a una ventana de ciclo específica. Su informe de Tradovate le acerca muchísimo y le indica si está en el rango correcto, pero el panel de pagos de la firma es la fuente definitiva para la cifra final." },
    { type: "heading", text: "Dónde se aplica realmente el bloqueo" },
    { type: "paragraph", html: "Su solicitud de pago no pasa por Tradovate. Pasa por el propio panel de su firma prop, y ahí es donde se ejecuta la comprobación de consistencia. Cuando la firma retiene un pago, normalmente lo verá marcado ahí, una nota indicando que la solicitud no es elegible, o un importe permitido más pequeño, con un texto que apunta a límites de consistencia o de &ldquo;mejor día&rdquo;." },
    { type: "paragraph", html: "Esto es lo más importante que hay que entender sobre el error: Tradovate es la plataforma, pero la regla pertenece a la firma. Tradovate nunca bloqueará un retiro por consistencia, y el soporte de Tradovate no puede levantarlo. Solo la firma puede definir el límite, y solo más operativa puede satisfacerlo." },
    { type: "heading", text: "Cómo desbloquear el pago" },
    { type: "paragraph", html: "No hay truco ni apelación que funcione de forma fiable, la solución es mecánica. Añade días controlados y rentables hasta que su mejor día quede por debajo del límite." },
    {
      type: "steps",
      items: [
        { title: "Confirme la regla exacta", html: "Averigüe el porcentaje de consistencia actual de su firma y, igual de importante, contra qué se mide, el beneficio total realizado o el objetivo de beneficio. Una regla &ldquo;contra el objetivo&rdquo; se comporta de forma distinta a una &ldquo;contra el beneficio total&rdquo;. No lo dé por hecho; lea la página de reglas vigente de la firma." },
        { title: "Calcule la brecha", html: "Use el atajo anterior. Divida su mejor día entre el límite para encontrar el beneficio total que necesita, y luego reste lo que ya tiene. Esa diferencia es su tarea, el beneficio adicional que necesita repartir en futuras sesiones." },
        { title: "Opere días más pequeños y estables", html: "Ahora opere para elevar el denominador sin crear un nuevo día desproporcionado. Días verdes modestos y repetibles son exactamente lo que premia la regla. Mantenga su tamaño constante para no registrar accidentalmente otro día que se convierta en el nuevo &ldquo;mejor día&rdquo; y reinicie el problema." },
        { title: "Vuelva a comprobar y luego solicite", html: "Después de cada sesión, vuelva a calcular la proporción. Una vez que su día más grande esté cómodamente por debajo del límite, deje un pequeño margen en lugar de quedarse justo en la línea, y vuelva a enviar la solicitud de pago en el panel de la firma." },
      ],
    },
    { type: "heading", text: "Evite que vuelva a suceder" },
    { type: "paragraph", html: "Los traders que nunca activan esta regla no tienen suerte. Simplemente no dejan que un solo día se dispare respecto al resto. La defensa más limpia es un tamaño de posición constante. Si limita el número de contratos que mantiene, ninguna sesión individual puede convertirse desde el principio en un monstruo que suponga el 60% del total." },
    { type: "paragraph", html: "Tradovate le ofrece una herramienta contundente para eso. En la configuración de riesgo de su cuenta puede establecer un tamaño máximo de posición, de modo que la propia plataforma le impida sobreapalancarse un día en que el setup parezca demasiado bueno para dejarlo pasar. Fijar su tamaño es la diferencia entre un mejor día de $1.200 y uno de $3.000, y es el día de $3.000 el que bloquea su pago durante dos semanas." },
    { type: "paragraph", html: "Puede establecer un límite máximo de posición directamente en la pantalla de configuración de riesgo de Tradovate. Combine eso con un objetivo de beneficio diario fijo y construirá de forma natural el tipo de distribución equilibrada que la regla de consistencia está diseñada para encontrar." },
    { type: "heading", text: "Cuándo vale la pena contactar con la firma" },
    { type: "paragraph", html: "La mayoría de las veces la solución depende de usted, pero algunas situaciones justifican un mensaje al soporte de su firma. Si el panel de pagos muestra un número que contradice claramente sus propios cálculos de Tradovate, pídales que muestren su cálculo, la ventana, las comisiones y qué &ldquo;mejor día&rdquo; usaron. Si la regla parece haber cambiado a mitad de ciclo, o su evaluación no tenía regla de consistencia y no le informaron de que la etapa financiada sí la tiene, esa es una conversación justa. Y si claramente ha diluido por debajo del límite y la barrera aún no se levanta, puede tratarse de un retraso de sincronización del panel más que de un problema de regla. Lleve sus propios registros diarios para poder señalar detalles concretos en lugar de argumentar de memoria." },
    { type: "heading", text: "Opere con el mismo plan en cada sesión con PickMyTrade" },
    { type: "paragraph", html: "Operar con el mismo plan repetible cada día es lo que mantiene sus resultados constantes, y la consistencia es exactamente lo que desbloquea los pagos. PickMyTrade automatiza su estrategia de Tradovate para que cada sesión siga las mismas reglas, el mismo tamaño y la misma disciplina, sin que usted dude ante un gran setup ni deje que un día desproporcionado bloquee su pago durante semanas." },
  ], fr: [
    { type: "paragraph", html: "Vous avez réussi l'évaluation, le compte est en positif, et vous cliquez enfin sur le bouton de paiement, et rien ne se passe. Au lieu d'un retrait en attente, vous recevez un message indiquant que votre demande ne respecte pas &ldquo;l'exigence de cohérence&rdquo;, ou le montant que vous êtes autorisé à retirer n'est qu'une fraction de ce qui se trouve sur le compte. Votre drawdown est correct. Votre objectif de profit est atteint. Pourtant, l'argent ne sort pas." },
    { type: "paragraph", html: "C'est presque toujours la règle de cohérence qui fait son travail. C'est l'une des règles les plus mal comprises dans le trading prop, car elle ne se comporte pas comme les autres. Elle ne fait pas sauter votre compte. Elle met simplement votre paiement en attente jusqu'à ce que votre historique de trading corresponde à ce que la firme attend. Voici exactement ce qui se passe et comment y remédier." },
    { type: "heading", text: "Ce que la règle de cohérence mesure réellement" },
    { type: "paragraph", html: "La règle de cohérence n'examine qu'une seule chose : quelle part de votre profit total provient de votre meilleure journée. Les firmes veulent voir de l'argent gagné de façon régulière, pas une seule séance chanceuse qui a porté tout le compte. Elles prennent donc votre meilleure journée gagnante, la divisent par votre profit net total sur le cycle de paiement, et comparent ce pourcentage à un plafond." },
    { type: "paragraph", html: "Le calcul est simple :" },
    { type: "quote", html: "(Profit de la meilleure journée &divide; Profit net total) &times; 100 = votre pourcentage de cohérence" },
    { type: "paragraph", html: "Si ce chiffre dépasse le plafond de la firme, votre paiement est bloqué. L'emplacement de ce plafond dépend entièrement de la firme et souvent de la taille du compte. De nombreuses firmes de futures le fixent quelque part entre 20 % et 40 %, et certaines mesurent votre meilleure journée par rapport à l'objectif de profit plutôt qu'au profit réalisé. Le seuil varie selon la firme et la taille du compte, vérifiez les règles actuelles de votre firme avant de baser votre plan sur un chiffre précis." },
    { type: "paragraph", html: "Un point à bien retenir : cette règle s'applique généralement au stade financé et au paiement, et certaines firmes ne l'appliquent pas du tout pendant l'évaluation. C'est pourquoi de nombreux traders traversent l'évaluation en tradant comme bon leur semble, obtiennent un compte financé, puis se heurtent directement à un mur la première fois qu'ils tentent de retirer des fonds." },
    { type: "heading", text: "Pourquoi votre paiement est bloqué, mais pas votre compte" },
    { type: "paragraph", html: "C'est le point qui fait trébucher les gens. Une violation du drawdown est un échec définitif : franchissez le seuil mobile et le compte est terminé. La règle de cohérence n'a rien à voir avec cela. C'est une barrière sur le retrait, pas une sanction contre le compte. Votre solde reste exactement où il est, vous conservez votre accès à la plateforme, et vous continuez à trader. La firme dit simplement : &ldquo;pas encore, gagnez un peu plus, étalez-le, et nous le débloquerons ensuite.&rdquo;" },
    { type: "paragraph", html: "Il est utile de voir les trois règles côte à côte, car elles sont appliquées séparément et chacune échoue à sa propre manière." },
    {
      type: "table",
      headers: ["Règle", "Ce qu'elle mesure", "Ce qui se passe si vous l'enfreignez"],
      rows: [
        ["Objectif de profit", "Si le profit total a atteint un objectif fixé", "Vous êtes qualifié pour être financé ou demander un paiement"],
        ["Drawdown mobile", "Si les capitaux propres sont tombés sous un seuil mobile", "Violation définitive, le compte échoue ou est bloqué"],
        ["Règle de cohérence", "La part de votre meilleure journée dans le profit total", "Le paiement est retenu jusqu'à ce que vous diluiez la grosse journée, le compte reste actif"],
      ],
    },
    { type: "paragraph", html: "Notez que la règle de cohérence suit sa propre voie. Atteindre votre objectif de profit ne la satisfait pas. Rester à l'écart de votre drawdown ne la satisfait pas. Elle est vérifiée indépendamment, au moment où vous demandez de l'argent. La règle qui, elle, tue les comptes, la violation du drawdown mobile, est un mécanisme totalement distinct qu'il vaut la peine de comprendre en tant que tel si ce n'est pas déjà fait." },
    { type: "heading", text: "Le calcul derrière le blocage, avec de vrais chiffres" },
    { type: "paragraph", html: "Supposons que votre firme plafonne toute journée individuelle à 30 % du profit total, un seuil d'exemple courant, bien que le vôtre puisse différer. Observez comment la même meilleure journée de 3 000 $ passe de la conformité à la non-conformité selon l'évolution de votre profit total." },
    {
      type: "table",
      headers: ["Situation", "Meilleure journée", "Profit total", "Meilleure journée en % du total", "Par rapport à un plafond de 30 %"],
      rows: [
        ["Une grosse journée, peu d'autres", "$3,000", "$5,000", "60%", "Bloqué"],
        ["Après plusieurs petites journées gagnantes", "$3,000", "$10,000", "30%", "Tout juste à la limite"],
        ["Profit réparti", "$1,200", "$6,000", "20%", "Conforme sans problème"],
      ],
    },
    { type: "paragraph", html: "La grosse journée ne diminue jamais, vous ne pouvez pas l'annuler. Ce qui change, c'est le dénominateur. Chaque journée rentable supplémentaire que vous ajoutez augmente votre total, et à mesure que le total augmente, cette journée géante représente une part de plus en plus petite. Un raccourci pratique que certaines firmes précisent : divisez votre meilleure journée par le plafond (en décimal) pour trouver le profit total minimum dont vous avez besoin. Une meilleure journée de 3 000 $ face à un plafond de 30 % nécessite 3 000 $ &divide; 0,30 = 10 000 $ de profit total avant que le paiement ne soit débloqué." },
    { type: "heading", text: "Trouvez d'abord vos chiffres dans Tradovate" },
    { type: "paragraph", html: "Avant de discuter avec qui que ce soit ou de paniquer, récupérez vos propres chiffres. Tradovate conserve un enregistrement quotidien de vos résultats, ce qui vous permet de calculer le ratio exact que la firme vérifie. Ouvrez les rapports de compte ou la section de performance et réglez la plage de dates sur votre cycle de paiement actuel." },
    { type: "paragraph", html: "Parcourez la colonne quotidienne à la recherche de votre plus grosse journée de profit. Notez ensuite le profit net total pour la même période. Divisez le premier par le second, multipliez par 100, et vous obtenez votre pourcentage de cohérence. La section des rapports de compte et de performance de trading de Tradovate indique le chemin exact à suivre si vous ne savez pas où se trouvent ces rapports." },
    { type: "paragraph", html: "Une mise en garde : le chiffre utilisé par la firme correspond à sa propre définition du profit, qui peut être net de frais et liée à une fenêtre de cycle spécifique. Votre rapport Tradovate vous en rapproche énormément et vous indique si vous êtes dans la bonne fourchette, mais le tableau de bord de paiement de la firme fait foi pour le chiffre final." },
    { type: "heading", text: "Où le blocage est réellement appliqué" },
    { type: "paragraph", html: "Votre demande de paiement ne passe pas par Tradovate. Elle passe par le tableau de bord propre à votre firme prop, et c'est là que la vérification de cohérence s'exécute. Lorsque la firme retient un paiement, vous le verrez généralement signalé là, une note indiquant que la demande n'est pas éligible, ou un montant autorisé inférieur, avec un libellé faisant référence aux limites de cohérence ou de &ldquo;meilleure journée&rdquo;." },
    { type: "paragraph", html: "C'est le point le plus important à comprendre concernant cette erreur : Tradovate est la plateforme, mais la règle appartient à la firme. Tradovate ne bloquera jamais un retrait pour des raisons de cohérence, et le support de Tradovate ne peut pas le lever. Seule la firme peut définir le plafond, et seul davantage de trading peut le satisfaire." },
    { type: "heading", text: "Comment débloquer le paiement" },
    { type: "paragraph", html: "Il n'existe ni astuce ni recours qui fonctionne de manière fiable, la solution est mécanique. Vous ajoutez des journées contrôlées et rentables jusqu'à ce que votre meilleure journée passe sous le plafond." },
    {
      type: "steps",
      items: [
        { title: "Confirmez la règle exacte", html: "Trouvez le pourcentage de cohérence actuel de votre firme et, tout aussi important, ce sur quoi il est mesuré, le profit total réalisé ou l'objectif de profit. Une règle &ldquo;par rapport à l'objectif&rdquo; se comporte différemment d'une règle &ldquo;par rapport au profit total&rdquo;. Ne présumez de rien ; lisez la page de règles en vigueur de la firme." },
        { title: "Calculez l'écart", html: "Utilisez le raccourci ci-dessus. Divisez votre meilleure journée par le plafond pour trouver le profit total dont vous avez besoin, puis soustrayez ce que vous avez déjà. Cette différence est votre travail à faire, le profit supplémentaire que vous devez répartir sur les prochaines séances." },
        { title: "Tradez des journées plus petites et plus régulières", html: "Tradez maintenant de façon à augmenter le dénominateur sans créer une nouvelle journée démesurée. Des journées gagnantes modestes et répétables sont exactement ce que récompense la règle. Gardez une taille constante pour ne pas enregistrer accidentellement une autre journée qui deviendrait la nouvelle &ldquo;meilleure journée&rdquo; et relancerait le problème." },
        { title: "Revérifiez, puis demandez", html: "Après chaque séance, recalculez le ratio. Une fois que votre plus grosse journée est confortablement sous le plafond, laissez-vous une petite marge plutôt que de rester exactement sur la ligne, puis soumettez à nouveau la demande de paiement dans le tableau de bord de la firme." },
      ],
    },
    { type: "heading", text: "Évitez que cela ne se reproduise" },
    { type: "paragraph", html: "Les traders qui ne déclenchent jamais cette règle n'ont pas de chance particulière. Ils empêchent simplement une seule journée de s'envoler par rapport aux autres. La défense la plus efficace est une taille de position constante. Si vous plafonnez le nombre de contrats que vous détenez, aucune séance ne peut, dès le départ, gonfler jusqu'à représenter un monstre de 60 % du total." },
    { type: "paragraph", html: "Tradovate vous offre un outil radical pour cela. Dans les paramètres de risque de votre compte, vous pouvez définir une taille de position maximale, de sorte que la plateforme elle-même vous empêche de surexploiter votre effet de levier un jour où le setup semble trop bon pour être ignoré. Verrouiller votre taille fait toute la différence entre une meilleure journée à 1 200 $ et une à 3 000 $, et c'est la journée à 3 000 $ qui bloque votre paiement pendant deux semaines." },
    { type: "paragraph", html: "Vous pouvez définir une limite de position maximale directement dans l'écran des paramètres de risque de Tradovate. Associez cela à un objectif de profit quotidien fixe, et vous construirez naturellement le type de répartition régulière que la règle de cohérence est conçue pour détecter." },
    { type: "heading", text: "Quand cela vaut la peine de contacter la firme" },
    { type: "paragraph", html: "La plupart du temps, la solution est de votre ressort, mais certaines situations justifient un message au support de votre firme. Si le tableau de bord de paiement affiche un chiffre qui contredit clairement vos propres calculs Tradovate, demandez-leur de montrer leur calcul, la fenêtre, les frais, et quelle &ldquo;meilleure journée&rdquo; ils ont utilisée. Si la règle semble avoir changé en cours de cycle, ou si votre évaluation n'avait pas de règle de cohérence et qu'on ne vous a pas dit que le stade financé en avait une, c'est une conversation légitime. Et si vous avez clairement dilué sous le plafond et que le blocage ne se lève toujours pas, il peut s'agir d'un délai de synchronisation du tableau de bord plutôt que d'un problème de règle. Conservez vos propres relevés quotidiens afin de pouvoir pointer des faits précis plutôt que d'argumenter de mémoire." },
    { type: "heading", text: "Tradez selon le même plan à chaque séance avec PickMyTrade" },
    { type: "paragraph", html: "Trader selon le même plan répétable chaque jour est ce qui maintient vos résultats constants, et la cohérence est exactement ce qui débloque les paiements. PickMyTrade automatise votre stratégie Tradovate afin que chaque séance suive les mêmes règles, la même taille et la même discipline, sans que vous remettiez en question un gros setup ou que vous laissiez une journée démesurée bloquer votre paiement pendant des semaines." },
  ], it: [
    { type: "paragraph", html: "Hai superato la valutazione, l'account è in positivo, e finalmente clicchi sul pulsante di payout, e non succede nulla. Invece di un prelievo in sospeso ricevi un messaggio secondo cui la tua richiesta non soddisfa il &ldquo;requisito di coerenza&rdquo;, oppure l'importo che ti è consentito prelevare è solo una frazione di ciò che è presente nell'account. Il tuo drawdown va bene. Il tuo obiettivo di profitto è raggiunto. Eppure il denaro non esce." },
    { type: "paragraph", html: "Nella maggior parte dei casi è la regola di coerenza che sta facendo il suo lavoro. È una delle regole più fraintese nel prop trading perché non si comporta come le altre. Non fa saltare il tuo account. Blocca semplicemente in silenzio il tuo payout finché la tua cronologia di trading non ha l'aspetto che la società desidera. Ecco esattamente cosa sta succedendo e come risolverlo." },
    { type: "heading", text: "Cosa misura realmente la regola di coerenza" },
    { type: "paragraph", html: "La regola di coerenza osserva una sola cosa: quanta parte del tuo profitto totale proviene dalla tua singola giornata migliore. Le società vogliono vedere denaro guadagnato in modo costante, non un'unica sessione da biglietto della lotteria che ha portato tutto l'account. Quindi prendono la tua giornata vincente più grande, la dividono per il tuo profitto netto totale del ciclo di payout e confrontano quella percentuale con un tetto massimo." },
    { type: "paragraph", html: "Il calcolo è semplice:" },
    { type: "quote", html: "(Profitto del giorno migliore &divide; Profitto netto totale) &times; 100 = la tua percentuale di coerenza" },
    { type: "paragraph", html: "Se quel numero supera il tetto della società, il tuo payout viene bloccato. Dove si colloca il tetto dipende interamente dalla società e spesso dalla dimensione dell'account. Molte società di futures lo fissano tra il 20% e il 40%, e alcune misurano la tua giornata migliore rispetto all'obiettivo di profitto anziché al profitto realizzato. La soglia varia in base alla società e alla dimensione dell'account, controlla le regole attuali della tua società prima di pianificare su un numero specifico." },
    { type: "paragraph", html: "Una cosa da tenere bene a mente: questa regola si applica di solito nella fase funded e di payout, e alcune società non la applicano affatto durante la valutazione. Ecco perché molti trader superano la valutazione facendo trading come preferiscono, ottengono l'account funded, e poi sbattono contro un muro la prima volta che provano a prelevare." },
    { type: "heading", text: "Perché il tuo payout è bloccato, ma il tuo account no" },
    { type: "paragraph", html: "Questo è il punto che confonde le persone. Una violazione del drawdown è un fallimento definitivo: superi il floor mobile e l'account è finito. La regola di coerenza non ha niente a che vedere con questo. È un blocco sul prelievo, non una sanzione contro l'account. Il tuo saldo resta esattamente dov'è, mantieni l'accesso alla piattaforma e continui a fare trading. La società sta semplicemente dicendo: &ldquo;non ancora, guadagna un po' di più, distribuiscilo meglio, e poi lo sbloccheremo.&rdquo;" },
    { type: "paragraph", html: "È utile vedere le tre regole affiancate, perché vengono applicate separatamente e ciascuna fallisce a modo suo." },
    {
      type: "table",
      headers: ["Regola", "Cosa misura", "Cosa succede se la infrangi"],
      rows: [
        ["Obiettivo di profitto", "Se il profitto totale ha raggiunto un traguardo prefissato", "Ti qualifichi per essere finanziato o richiedere un payout"],
        ["Drawdown mobile", "Se l'equity è scesa sotto un floor mobile", "Violazione definitiva, l'account fallisce o si blocca"],
        ["Regola di coerenza", "La quota della tua giornata migliore sul profitto totale", "Il payout viene trattenuto finché non diluisci la giornata forte, l'account resta attivo"],
      ],
    },
    { type: "paragraph", html: "Nota che la regola di coerenza segue una propria corsia. Raggiungere il tuo obiettivo di profitto non la soddisfa. Restare lontano dal tuo drawdown non la soddisfa. Viene verificata autonomamente, nel momento in cui richiedi denaro. La regola che invece uccide gli account, la violazione del drawdown mobile, è un meccanismo completamente separato che vale la pena capire a fondo se non l'hai già fatto." },
    { type: "heading", text: "La matematica dietro il blocco, con numeri reali" },
    { type: "paragraph", html: "Supponiamo che la tua società limiti ogni singola giornata al 30% del profitto totale, una soglia di esempio comune, anche se la tua potrebbe essere diversa. Osserva come la stessa giornata migliore da $3.000 entra ed esce dalla conformità man mano che il tuo profitto totale cambia." },
    {
      type: "table",
      headers: ["Situazione", "Giorno migliore", "Profitto totale", "Giorno migliore come % del totale", "Rispetto a un tetto del 30%"],
      rows: [
        ["Una giornata forte, poco altro", "$3,000", "$5,000", "60%", "Bloccato"],
        ["Dopo diverse piccole giornate positive", "$3,000", "$10,000", "30%", "Esattamente al limite"],
        ["Profitto distribuito", "$1,200", "$6,000", "20%", "Conforme senza problemi"],
      ],
    },
    { type: "paragraph", html: "La giornata forte non si riduce mai, non puoi annullarla. Ciò che cambia è il denominatore. Ogni giornata redditizia aggiuntiva che accumuli alza il tuo totale, e man mano che il totale sale, quell'unica giornata enorme si riduce come quota di esso. Una scorciatoia utile che alcune società specificano: dividi la tua giornata migliore per il tetto (come decimale) per trovare il profitto totale minimo di cui hai bisogno. Una giornata migliore da $3.000 rispetto a un tetto del 30% richiede $3.000 &divide; 0,30 = $10.000 di profitto totale prima che il payout venga rilasciato." },
    { type: "heading", text: "Prima trova i tuoi numeri dentro Tradovate" },
    { type: "paragraph", html: "Prima di discutere con qualcuno o farti prendere dal panico, recupera i tuoi numeri. Tradovate mantiene un registro giornaliero dei tuoi risultati, così puoi calcolare il rapporto esatto che la società sta controllando. Apri i report dell'account o l'area delle prestazioni e imposta l'intervallo di date sul tuo ciclo di payout attuale." },
    { type: "paragraph", html: "Scorri la colonna giornaliera per individuare la tua singola giornata di profitto più alta. Poi annota il profitto netto totale per la stessa finestra temporale. Dividi il primo per il secondo, moltiplica per 100, e hai la tua percentuale di coerenza. La sezione dei report dell'account e delle prestazioni di trading di Tradovate mostra il percorso esatto dei clic se non sei sicuro di dove si trovino questi report." },
    { type: "paragraph", html: "Un'avvertenza: il numero usato dalla società corrisponde alla sua definizione di profitto, che potrebbe essere al netto delle commissioni e legata a una specifica finestra di ciclo. Il tuo report di Tradovate ti avvicina moltissimo e ti dice se sei nell'ordine di grandezza giusto, ma la dashboard di payout della società è la fonte di verità per la cifra finale." },
    { type: "heading", text: "Dove viene realmente applicato il blocco" },
    { type: "paragraph", html: "La tua richiesta di payout non passa attraverso Tradovate. Passa attraverso la dashboard della tua società prop, ed è lì che viene eseguito il controllo di coerenza. Quando la società trattiene un payout, in genere lo vedrai segnalato lì, una nota che indica che la richiesta non è idonea, oppure un importo consentito più piccolo, con una formulazione che rimanda ai limiti di coerenza o della &ldquo;giornata migliore&rdquo;." },
    { type: "paragraph", html: "Questa è la cosa più importante da capire riguardo all'errore: Tradovate è la piattaforma, ma la regola appartiene alla società. Tradovate non bloccherà mai un prelievo per motivi di coerenza, e il supporto di Tradovate non può rimuoverlo. Solo la società può definire il tetto, e solo altro trading può soddisfarlo." },
    { type: "heading", text: "Come sbloccare il payout" },
    { type: "paragraph", html: "Non esiste nessun trucco né alcun ricorso che funzioni in modo affidabile, la soluzione è meccanica. Aggiungi giornate controllate e redditizie finché la tua giornata migliore non scende sotto il tetto." },
    {
      type: "steps",
      items: [
        { title: "Conferma la regola esatta", html: "Scopri la percentuale di coerenza attuale della tua società e, altrettanto importante, rispetto a cosa viene misurata, il profitto totale realizzato o l'obiettivo di profitto. Una regola &ldquo;rispetto all'obiettivo&rdquo; si comporta diversamente da una &ldquo;rispetto al profitto totale&rdquo;. Non dare nulla per scontato; leggi la pagina delle regole in vigore della società." },
        { title: "Calcola il divario", html: "Usa la scorciatoia sopra. Dividi la tua giornata migliore per il tetto per trovare il profitto totale di cui hai bisogno, poi sottrai quello che hai già. Quella differenza è il tuo compito a casa, il profitto aggiuntivo che devi distribuire sulle prossime sessioni." },
        { title: "Fai trading su giornate più piccole e stabili", html: "Ora fai trading per aumentare il denominatore senza creare una nuova giornata sproporzionata. Giornate positive modeste e ripetibili sono esattamente ciò che la regola premia. Mantieni la size costante così da non registrare per sbaglio un'altra giornata che diventi la nuova &ldquo;giornata migliore&rdquo; e resetti il problema." },
        { title: "Ricontrolla, poi richiedi", html: "Dopo ogni sessione, ricalcola il rapporto. Una volta che la tua giornata più grande è comodamente sotto il tetto, lasciati un piccolo margine invece di restare esattamente sul limite, e invia nuovamente la richiesta di payout nella dashboard della società." },
      ],
    },
    { type: "heading", text: "Evita che accada di nuovo" },
    { type: "paragraph", html: "I trader che non fanno mai scattare questa regola non sono fortunati. Semplicemente non lasciano che una singola giornata prenda il sopravvento sulle altre. La difesa più pulita è una size di posizione costante. Se limiti il numero di contratti che puoi detenere, nessuna singola sessione può gonfiarsi fin da subito in un mostro pari al 60% del totale." },
    { type: "paragraph", html: "Tradovate ti offre uno strumento efficace per questo. Nelle impostazioni di rischio del tuo account puoi impostare una size massima della posizione, così è la piattaforma stessa a impedirti di sovraesporti in una giornata in cui il setup sembra troppo buono per lasciarselo sfuggire. Bloccare la tua size fa la differenza tra una giornata migliore da $1.200 e una da $3.000, ed è la giornata da $3.000 a bloccare il tuo payout per due settimane." },
    { type: "paragraph", html: "Puoi impostare un limite massimo di posizione direttamente nella schermata delle impostazioni di rischio di Tradovate. Abbina questo a un obiettivo di profitto giornaliero fisso e costruirai naturalmente il tipo di distribuzione uniforme che la regola di coerenza è pensata per individuare." },
    { type: "heading", text: "Quando vale la pena contattare la società" },
    { type: "paragraph", html: "Il più delle volte la soluzione dipende da te, ma alcune situazioni giustificano un messaggio al supporto della tua società. Se la dashboard di payout mostra un numero che contraddice apertamente i tuoi calcoli su Tradovate, chiedi loro di mostrare il calcolo, la finestra temporale, le commissioni e quale &ldquo;giornata migliore&rdquo; hanno usato. Se la regola sembra essere cambiata a metà ciclo, oppure la tua valutazione non aveva regola di coerenza e non ti è stato detto che la fase funded ce l'ha, è una conversazione legittima. E se hai chiaramente diluito sotto il tetto e il blocco continua a non sbloccarsi, potrebbe trattarsi di un ritardo di sincronizzazione della dashboard piuttosto che di un problema di regola. Tieni i tuoi registri giornalieri così puoi fare riferimento a dati concreti invece di argomentare a memoria." },
    { type: "heading", text: "Fai trading con lo stesso piano ogni sessione con PickMyTrade" },
    { type: "paragraph", html: "Fare trading ogni giorno con lo stesso piano ripetibile è ciò che mantiene i tuoi risultati costanti, e la coerenza è esattamente ciò che sblocca i payout. PickMyTrade automatizza la tua strategia Tradovate così ogni sessione segue le stesse regole, la stessa size e la stessa disciplina, senza che tu metta in dubbio un grande setup o lasci che una giornata sproporzionata blocchi il tuo payout per settimane." },
  ] },
  ctaHeading: { en: "Automate Your Strategy for Consistent Days", de: "Automatisieren Sie Ihre Strategie für konsistente Tage", es: "Automatice su estrategia para lograr días consistentes", fr: "Automatisez votre stratégie pour des journées cohérentes", it: "Automatizza la tua strategia per giornate coerenti" },
  ctaText: { en: "Let PickMyTrade fire the same sized entries every session so your best day never runs away from the rest of your payout cycle.", de: "Lassen Sie PickMyTrade in jeder Session Einstiege gleicher Größe auslösen, damit Ihr bester Tag dem Rest Ihres Auszahlungszyklus nie davonläuft.", es: "Deje que PickMyTrade dispare entradas del mismo tamaño en cada sesión para que su mejor día nunca se dispare respecto al resto de su ciclo de pago.", fr: "Laissez PickMyTrade déclencher des entrées de même taille à chaque séance afin que votre meilleure journée ne s'envole jamais par rapport au reste de votre cycle de paiement.", it: "Lascia che PickMyTrade attivi ingressi della stessa size a ogni sessione così la tua giornata migliore non si stacca mai dal resto del tuo ciclo di payout." },
  ctaButtonText: { en: "Start Your Free 7-Day Trial", de: "Starten Sie Ihre kostenlose 5-Tage-Testversion", es: "Inicie su prueba gratuita de 5 días", fr: "Démarrez votre essai gratuit de 5 jours", it: "Avvia la tua prova gratuita di 5 giorni" },
  ctaUrl: "https://app.pickmytrade.trade/?register=true&utm_source=content&utm_medium=debugging",
  faqHeading: { en: "Frequently Asked Questions", de: "Häufig gestellte Fragen", es: "Preguntas frecuentes", fr: "Questions fréquentes", it: "Domande frequenti" },
  faqs: { en: [
    { q: "Does the consistency rule fail my prop account?", a: "No. Unlike a drawdown breach, the consistency rule doesn't fail or reset your account. It only holds your payout request until your profit is spread out enough that your best day sits under the firm's cap. Your balance stays intact and you keep trading." },
    { q: "Is the consistency rule a Tradovate rule?", a: "No. Tradovate is the platform your prop firm runs its evaluations and funded accounts on. The consistency rule is written and enforced by the firm inside its own payout dashboard, not by Tradovate. Tradovate never blocks a withdrawal for consistency." },
    { q: "How do I unlock a payout blocked by the consistency rule?", a: "Keep trading controlled, profitable days so your total profit grows. As the total rises, your best day becomes a smaller share of it. Once your biggest day falls under the firm's percentage cap, the payout request clears, and you don't have to give back any profit." },
    { q: "What percentage is the consistency limit?", a: "It varies by firm and account size. Many futures firms cap a single day somewhere in the 20% to 40% range of total profit, and some measure the best day against the profit target instead. Always confirm the current number in your firm's own rules." },
    { q: "How do I see my best day versus total profit in Tradovate?", a: "Open the account reports or performance section in Tradovate and view results broken down by day for your current payout cycle. Note your single largest profit day, then divide it by the cycle's total net profit to get the percentage the firm checks." },
  ], de: [
    { q: "Lässt die Consistency-Regel mein Prop-Konto scheitern?", a: "Nein. Anders als eine Drawdown-Verletzung lässt die Consistency-Regel Ihr Konto nicht scheitern oder zurücksetzen. Sie hält lediglich Ihre Auszahlungsanfrage zurück, bis Ihr Gewinn ausreichend verteilt ist, sodass Ihr bester Tag unter der Obergrenze der Firma liegt. Ihr Kontostand bleibt intakt, und Sie handeln weiter." },
    { q: "Ist die Consistency-Regel eine Tradovate-Regel?", a: "Nein. Tradovate ist die Plattform, auf der Ihre Prop-Firma ihre Evaluierungen und Funded-Konten betreibt. Die Consistency-Regel wird von der Firma in ihrem eigenen Auszahlungs-Dashboard festgelegt und durchgesetzt, nicht von Tradovate. Tradovate blockiert niemals eine Auszahlung wegen Consistency." },
    { q: "Wie schalte ich eine durch die Consistency-Regel blockierte Auszahlung frei?", a: "Handeln Sie weiterhin kontrollierte, profitable Tage, damit Ihr Gesamtgewinn wächst. Mit steigendem Gesamtwert wird der Anteil Ihres besten Tages kleiner. Sobald Ihr größter Tag unter die prozentuale Obergrenze der Firma fällt, wird die Auszahlungsanfrage freigegeben, und Sie müssen keinen Gewinn zurückgeben." },
    { q: "Wie hoch ist die prozentuale Consistency-Grenze?", a: "Das variiert je nach Firma und Kontogröße. Viele Futures-Firmen begrenzen einen einzelnen Tag auf irgendwo zwischen 20 % und 40 % des Gesamtgewinns, und manche messen den besten Tag stattdessen gegen das Gewinnziel. Bestätigen Sie den aktuellen Wert immer in den eigenen Regeln Ihrer Firma." },
    { q: "Wie sehe ich meinen besten Tag im Verhältnis zum Gesamtgewinn in Tradovate?", a: "Öffnen Sie die Kontoberichte oder den Performance-Bereich in Tradovate und sehen Sie sich die nach Tagen aufgeschlüsselten Ergebnisse für Ihren aktuellen Auszahlungszyklus an. Notieren Sie Ihren einzelnen größten Gewinntag und teilen Sie ihn dann durch den gesamten Nettogewinn des Zyklus, um den Prozentsatz zu erhalten, den die Firma prüft." },
  ], es: [
    { q: "¿La regla de consistencia hace fallar mi cuenta prop?", a: "No. A diferencia de una violación del drawdown, la regla de consistencia no hace fallar ni reinicia su cuenta. Solo retiene su solicitud de pago hasta que su beneficio esté lo bastante repartido para que su mejor día quede por debajo del límite de la firma. Su saldo permanece intacto y usted sigue operando." },
    { q: "¿Es la regla de consistencia una regla de Tradovate?", a: "No. Tradovate es la plataforma sobre la que su firma prop ejecuta sus evaluaciones y cuentas financiadas. La regla de consistencia es redactada y aplicada por la firma dentro de su propio panel de pagos, no por Tradovate. Tradovate nunca bloquea un retiro por consistencia." },
    { q: "¿Cómo desbloqueo un pago bloqueado por la regla de consistencia?", a: "Siga operando días controlados y rentables para que su beneficio total crezca. A medida que el total aumenta, su mejor día representa una proporción menor de él. Una vez que su día más grande cae por debajo del límite porcentual de la firma, la solicitud de pago se libera, y no tiene que devolver ningún beneficio." },
    { q: "¿Qué porcentaje es el límite de consistencia?", a: "Varía según la firma y el tamaño de la cuenta. Muchas firmas de futuros limitan un solo día en algún punto entre el 20% y el 40% del beneficio total, y algunas miden el mejor día frente al objetivo de beneficio en su lugar. Confirme siempre la cifra actual en las propias reglas de su firma." },
    { q: "¿Cómo veo mi mejor día frente al beneficio total en Tradovate?", a: "Abra los informes de cuenta o la sección de rendimiento en Tradovate y vea los resultados desglosados por día para su ciclo de pago actual. Anote su único mayor día de beneficio, y luego divídalo entre el beneficio neto total del ciclo para obtener el porcentaje que comprueba la firma." },
  ], fr: [
    { q: "La règle de cohérence fait-elle échouer mon compte prop ?", a: "Non. Contrairement à une violation du drawdown, la règle de cohérence ne fait pas échouer ni ne réinitialise votre compte. Elle retient simplement votre demande de paiement jusqu'à ce que votre profit soit suffisamment réparti pour que votre meilleure journée passe sous le plafond de la firme. Votre solde reste intact et vous continuez à trader." },
    { q: "La règle de cohérence est-elle une règle Tradovate ?", a: "Non. Tradovate est la plateforme sur laquelle votre firme prop gère ses évaluations et ses comptes financés. La règle de cohérence est rédigée et appliquée par la firme dans son propre tableau de bord de paiement, pas par Tradovate. Tradovate ne bloque jamais un retrait pour des raisons de cohérence." },
    { q: "Comment débloquer un paiement bloqué par la règle de cohérence ?", a: "Continuez à trader des journées contrôlées et rentables pour que votre profit total augmente. À mesure que le total augmente, votre meilleure journée en représente une part plus petite. Une fois que votre plus grosse journée passe sous le plafond en pourcentage de la firme, la demande de paiement est débloquée, et vous n'avez à rendre aucun profit." },
    { q: "Quel est le pourcentage de la limite de cohérence ?", a: "Cela varie selon la firme et la taille du compte. De nombreuses firmes de futures plafonnent une journée entre 20 % et 40 % du profit total, et certaines mesurent plutôt la meilleure journée par rapport à l'objectif de profit. Confirmez toujours le chiffre actuel dans les règles propres à votre firme." },
    { q: "Comment voir ma meilleure journée par rapport au profit total dans Tradovate ?", a: "Ouvrez les rapports de compte ou la section de performance dans Tradovate et consultez les résultats ventilés par jour pour votre cycle de paiement actuel. Notez votre plus grosse journée de profit, puis divisez-la par le profit net total du cycle pour obtenir le pourcentage que la firme vérifie." },
  ], it: [
    { q: "La regola di coerenza fa fallire il mio account prop?", a: "No. A differenza di una violazione del drawdown, la regola di coerenza non fa fallire né resetta il tuo account. Trattiene solo la tua richiesta di payout finché il tuo profitto non è distribuito abbastanza da far scendere la tua giornata migliore sotto il tetto della società. Il tuo saldo resta intatto e continui a fare trading." },
    { q: "La regola di coerenza è una regola di Tradovate?", a: "No. Tradovate è la piattaforma su cui la tua società prop gestisce le sue valutazioni e gli account funded. La regola di coerenza viene scritta e applicata dalla società all'interno della propria dashboard di payout, non da Tradovate. Tradovate non blocca mai un prelievo per motivi di coerenza." },
    { q: "Come sblocco un payout bloccato dalla regola di coerenza?", a: "Continua a fare trading su giornate controllate e redditizie così il tuo profitto totale cresce. Man mano che il totale sale, la tua giornata migliore ne rappresenta una quota minore. Una volta che la tua giornata più grande scende sotto il tetto percentuale della società, la richiesta di payout viene sbloccata, e non devi restituire alcun profitto." },
    { q: "Qual è la percentuale del limite di coerenza?", a: "Varia in base alla società e alla dimensione dell'account. Molte società di futures limitano una singola giornata tra il 20% e il 40% del profitto totale, e alcune misurano invece la giornata migliore rispetto all'obiettivo di profitto. Verifica sempre il numero attuale nelle regole della tua società." },
    { q: "Come vedo la mia giornata migliore rispetto al profitto totale in Tradovate?", a: "Apri i report dell'account o la sezione delle prestazioni in Tradovate e visualizza i risultati suddivisi per giorno per il tuo ciclo di payout attuale. Annota la tua singola giornata di profitto più alta, poi dividila per il profitto netto totale del ciclo per ottenere la percentuale che la società controlla." },
  ] },
  relatedHeading: { en: "Related Guides", de: "Verwandte Anleitungen", es: "Guías relacionadas", fr: "Guides connexes", it: "Guide correlate" },
