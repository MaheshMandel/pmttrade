---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "order-rejected-insufficient-margin";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/debugging/${SLUG}`;

const META_TITLE = "Tradovate 'Insufficient Margin / Not Enough Money' Fix";
const META_DESCRIPTION =
  "Tradovate insufficient margin or 'not enough money' rejection? Lower your contract size, free up margin, or add funds to get filled fast.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Tradovate: „Insufficient Margin / Not Enough Money“ beheben", es: "Tradovate: solución a «Insufficient Margin / Not Enough Money»", fr: "Tradovate : correction de « Insufficient Margin / Not Enough Money »", it: "Tradovate: come risolvere «Insufficient Margin / Not Enough Money»" },
  dek: { en: "Your order bounces straight back rejected with “Not enough money” or “Insufficient margin.” It's almost always a sizing or funding problem, and you can usually clear it in seconds.", de: "Ihre Order wird sofort mit „Not enough money“ oder „Insufficient margin“ abgelehnt. Fast immer ist es ein Problem der Positionsgröße oder der Kontofinanzierung, und meist lässt es sich in Sekunden beheben.", es: "Su orden rebota de inmediato rechazada con «Not enough money» o «Insufficient margin». Casi siempre es un problema de tamaño o de fondos, y normalmente se resuelve en segundos.", fr: "Votre ordre est aussitôt rejeté avec « Not enough money » ou « Insufficient margin ». C'est presque toujours un problème de taille ou de financement, et vous pouvez généralement le régler en quelques secondes.", it: "Il Suo ordine viene subito respinto con «Not enough money» o «Insufficient margin». È quasi sempre un problema di dimensione o di fondi, e di solito si risolve in pochi secondi." },
  readTime: { en: "7 min read", de: "7 Min. Lesezeit", es: "Lectura de 7 min", fr: "Lecture : 7 min", it: "Lettura di 7 min" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "Few things kill a good futures setup faster than an order that bounces straight back as rejected the moment you hit send. If you trade fast movers like ES, NQ, or CL on Tradovate, you've almost certainly met this one. Tradovate runs a pre-trade risk check on every single order, and if your free (excess) margin doesn't cover the requirement, the order never reaches the exchange. It surfaces as one of a few near-identical messages, <strong class='text-white'>&ldquo;Not enough money,&rdquo;</strong> <strong class='text-white'>&ldquo;Insufficient margin,&rdquo;</strong> or <strong class='text-white'>&ldquo;Not enough excess margin,&rdquo;</strong> and in 2026 it's still one of the most common rejections on both personal and prop-firm accounts. The good news: it's almost always a sizing or funding problem, and you can usually clear it in seconds. Automation tools like PickMyTrade can even validate order size before an alert ever goes out, so the rejection never fires in the first place." },
    {
      type: "checklist",
      heading: "Quick Checklist for Insufficient-Margin Rejections",
      items: [
        "<strong class='text-white'>Order too large for your balance</strong>, cut the contract quantity until it fits your available margin.",
        "<strong class='text-white'>Open positions or working orders eating margin</strong>, flatten positions or cancel resting orders to free up buying power.",
        "<strong class='text-white'>Holding into the session close</strong>, the higher overnight (initial) margin kicks in near the daily cutoff, so size down before then.",
        "<strong class='text-white'>Account under-funded or funds still pending</strong>, deposit and let cleared funds settle on a personal account, or contact your prop firm on an evaluation account.",
        "<strong class='text-white'>Margin spiked on news or volatility</strong>, requirements can jump around economic releases, so recheck the current rate before re-sending.",
        "<strong class='text-white'>Prop-firm risk cap hit</strong>, your firm may set a lower buying-power limit than Tradovate's raw margin, so confirm the plan rules.",
      ],
    },
    { type: "heading", text: "What “Not Enough Money / Insufficient Margin” Means" },
    { type: "paragraph", html: "Every time you submit an order, Tradovate runs a <strong class='text-white'>pre-trade risk review</strong> of your account to decide whether you have enough available margin to hold the proposed position. If you don't, the order gets rejected before it's routed, nothing goes to the exchange, and no fill happens. Think of it as a guardrail: it stops you from opening a trade that would put the account straight into a margin call." },
    { type: "paragraph", html: "The three messages you might see, <strong class='text-white'>&ldquo;Not enough money,&rdquo; &ldquo;Insufficient margin,&rdquo;</strong> and <strong class='text-white'>&ldquo;Not enough excess margin,&rdquo;</strong> all point at the same root problem. Your <em>excess</em> (or <em>available</em>) margin, cash and unrealized P&amp;L minus the margin already tied up by open positions and working orders, is smaller than the <strong class='text-white'>initial margin requirement</strong> for the contract and quantity you tried to trade. The exact wording depends on where you're trading from. The Tradovate web and desktop apps tend to say &ldquo;Not enough money&rdquo; or &ldquo;Insufficient margin,&rdquo; while a connected platform like NinjaTrader usually relays it as &ldquo;Not enough excess margin.&rdquo;" },
    { type: "paragraph", html: "Because Tradovate can raise or lower margin requirements at its own discretion, and those requirements can sit above the underlying exchange's minimums, the number you need isn't fixed. It shifts with the contract, the time of day, and market volatility. That's exactly why the same order size can go through in the morning and get rejected in the afternoon." },
    { type: "heading", text: "Top Causes of Insufficient-Margin Rejections" },
    { type: "heading", text: "1. The order is simply too large for your balance" },
    { type: "paragraph", html: "The most common cause is ordering more contracts than your account can support. Each futures contract carries a per-contract margin requirement, and your quantity multiplies it. If the total runs past your available margin, the whole order is rejected, Tradovate won't partially fill down to what you can afford. Micro contracts like MES or MNQ require far less margin than their full-size cousins, so an order that gets rejected in E-minis may fit comfortably in Micros." },
    { type: "heading", text: "2. Open positions and working orders are already consuming margin" },
    { type: "paragraph", html: "Available margin is what's <em>left over</em> after your existing trades. An open position ties up margin for as long as you hold it, and even unfilled working orders, limits and stops that could fill, can reserve buying power. So an account that &ldquo;should&rdquo; allow ten contracts might reject the next one simply because earlier positions and resting orders have already claimed the room." },
    { type: "heading", text: "3. Day (intraday) margin vs. overnight (initial) margin" },
    { type: "paragraph", html: "Futures brokers apply a reduced <strong class='text-white'>day-trading (intraday) margin</strong> during the active session and the full <strong class='text-white'>overnight (initial) margin</strong> for positions carried through the daily close. The overnight number is materially higher, often several times the intraday rate. As the session cutoff approaches (around the daily settlement, roughly 5:00 p.m. ET / 4:00 p.m. CT for CME index futures, though schedules vary by instrument), your requirement flips to the higher initial margin. An order that fits comfortably under the intraday rate can get rejected in that window, and any position you can't cover may be auto-liquidated." },
    { type: "heading", text: "4. The account is under-funded or funds haven't settled" },
    { type: "paragraph", html: "On a personal account, a recent deposit may not be fully available yet. ACH deposits in particular can be held or still clearing, so the balance you see on screen isn't all usable margin. And on a brand-new or low-balance account, even a single contract can outrun available margin." },
    { type: "heading", text: "5. Margin increases from volatility, news, or prop-firm caps" },
    { type: "paragraph", html: "Tradovate raises margin requirements around major economic announcements and in volatile conditions, sometimes sharply and with little notice. On top of that, prop-firm evaluation accounts often layer their own buying-power and max-position limits over Tradovate's margin, so your firm's cap, not the raw exchange margin, may be what's actually rejecting the order." },
    { type: "heading", text: "How to Fix Insufficient-Margin Rejections: Step-by-Step" },
    { type: "heading", text: "Fixing an oversized order" },
    {
      type: "steps",
      items: [
        { title: "Check the quantity field", html: "Open the order entry ticket (DOM, chart, or order window) and check the quantity field." },
        { title: "Lower the quantity and re-submit", html: "Lower the contract quantity, start by halving it, and re-submit." },
        { title: "Switch to the Micro version", html: "If it still rejects, switch to the Micro version of the contract (say MES instead of ES) to shrink the per-contract requirement." },
      ],
    },
    { type: "heading", text: "Freeing up margin from existing trades" },
    {
      type: "steps",
      items: [
        { title: "Review your open positions", html: "Open your Positions module and review what's currently open." },
        { title: "Flatten or reduce a position", html: "Flatten or reduce a position you no longer need to release the margin it's holding." },
        { title: "Cancel resting orders", html: "Cancel any resting limit or stop orders that are reserving buying power." },
        { title: "Re-send the order", html: "Re-send the new order once your available margin has recovered." },
      ],
    },
    { type: "heading", text: "Meeting the overnight (initial) margin" },
    {
      type: "steps",
      items: [
        { title: "Size for the initial margin", html: "If you plan to hold past the session close, size the position for the <strong class='text-white'>initial</strong> margin, not the intraday rate." },
        { title: "Exit before the cutoff if under-margined", html: "If you only have intraday margin, exit or reduce the position before the cutoff so you're not forced into the higher requirement or liquidated." },
        { title: "Check the day-vs-overnight schedule", html: "Check the day-vs-overnight schedule for your specific instrument, since the exact cutoff times vary by market and can change." },
      ],
    },
    { type: "heading", text: "Adding funds or clearing the balance" },
    {
      type: "steps",
      items: [
        { title: "Deposit and let funds clear", html: "On a personal account, deposit additional funds to raise your buying power, and let any pending or held deposit fully clear before you lean on it." },
        { title: "Reduce size or contact the firm on prop accounts", html: "On a prop-firm evaluation account you usually <strong class='text-white'>can't</strong> deposit, instead, reduce size to fit the firm's buying power, or contact the firm to confirm your limits." },
      ],
    },
    { type: "heading", text: "Confirming the current margin requirement" },
    {
      type: "steps",
      items: [
        { title: "Look up the live margin requirement", html: "Look up the live margin requirement for your contract in Tradovate's margin table before you trade." },
        { title: "Compare against your available margin", html: "Compare it against your available/excess margin, if the requirement is higher, reduce quantity or add funds." },
        { title: "Recheck around news events", html: "Recheck around news events, since requirements can spike temporarily." },
      ],
    },
    { type: "heading", text: "Troubleshooting Table" },
    {
      type: "table",
      headers: ["Error", "Meaning", "Fix"],
      rows: [
        ["Not enough money", "Available margin is below the initial margin needed for the order", "Reduce quantity, close positions, or add funds"],
        ["Insufficient margin", "Free/excess margin doesn't cover the requirement for the contract and size", "Lower contract count or switch to Micros"],
        ["Not enough excess margin", "Relayed from a connected platform (e.g., NinjaTrader); same margin shortfall", "Free up margin or size down, then re-submit"],
        ["Order rejected near session close", "Requirement flipped to the higher overnight/initial margin", "Size for overnight margin or exit before the cutoff"],
        ["Order rejected after a deposit", "Recent deposit not yet cleared/available", "Wait for funds to settle before sizing up"],
        ["Order rejected on a prop account", "Firm's buying-power/risk cap exceeded, not just Tradovate margin", "Reduce size or contact the prop firm"],
      ],
    },
    { type: "heading", text: "Prevent This with PickMyTrade" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Qty / Symbol Validation</strong>, checks the order size against your account before an alert is routed, so oversized orders never get sent out to be rejected.",
        "<strong class='text-white'>Entitlement &amp; Risk Filters</strong>, respects prop-firm buying-power and max-position limits along with your account's current state.",
        "<strong class='text-white'>Rate-Limit-Safe Routing</strong>, spaces out order flow so nothing bounces from rapid re-tries after a rejection.",
        "<strong class='text-white'>Multi-Account Sync</strong>, mirrors the corrected, correctly-sized order across every linked account at once.",
      ],
    },
  ], de: [
    { type: "paragraph",html: "Nur wenige Dinge zerstören ein gutes Futures-Setup schneller als eine Order, die in dem Moment, in dem Sie auf Senden klicken, sofort abgelehnt zurückkommt. Wenn Sie schnelle Werte wie ES, NQ oder CL bei Tradovate handeln, sind Sie dem mit ziemlicher Sicherheit schon begegnet. Tradovate führt für jede einzelne Order eine Pre-Trade-Risikoprüfung durch, und wenn Ihre freie (überschüssige) Margin die Anforderung nicht deckt, erreicht die Order nie die Börse. Es erscheint als eine von mehreren nahezu identischen Meldungen, <strong class='text-white'>&ldquo;Not enough money&rdquo;,</strong> <strong class='text-white'>&ldquo;Insufficient margin&rdquo;</strong> oder <strong class='text-white'>&ldquo;Not enough excess margin&rdquo;</strong>, und auch 2026 ist es eine der häufigsten Ablehnungen bei privaten wie bei Prop-Firm-Konten. Die gute Nachricht: Es ist fast immer ein Problem der Positionsgröße oder der Kontofinanzierung, und meist lässt es sich in Sekunden beheben. Automatisierungs-Tools wie PickMyTrade können die Ordergröße sogar prüfen, bevor ein Alert überhaupt hinausgeht, sodass die Ablehnung gar nicht erst entsteht." },
    {
      type: "checklist",
      heading: "Kurz-Checkliste für Ablehnungen wegen unzureichender Margin",
      items: [
        "<strong class='text-white'>Order zu groß für Ihren Saldo</strong>, reduzieren Sie die Kontraktanzahl, bis sie zu Ihrer verfügbaren Margin passt.",
        "<strong class='text-white'>Offene Positionen oder aktive Orders binden Margin</strong>, schließen Sie Positionen oder stornieren Sie wartende Orders, um Kaufkraft freizugeben.",
        "<strong class='text-white'>Halten bis zum Sitzungsschluss</strong>, die höhere Übernacht-Margin (Initial Margin) greift kurz vor dem täglichen Cutoff, reduzieren Sie die Größe also vorher.",
        "<strong class='text-white'>Konto unterfinanziert oder Gelder noch ausstehend</strong>, zahlen Sie ein und lassen Sie bei einem privaten Konto die Gelder verbucht werden, bzw. wenden Sie sich bei einem Evaluierungskonto an Ihr Prop-Firm.",
        "<strong class='text-white'>Margin durch Nachrichten oder Volatilität gestiegen</strong>, Anforderungen können rund um Wirtschaftsdaten springen, prüfen Sie den aktuellen Satz also erneut, bevor Sie neu senden.",
        "<strong class='text-white'>Prop-Firm-Risikolimit erreicht</strong>, Ihre Firma kann ein niedrigeres Kaufkraftlimit setzen als die reine Margin von Tradovate, bestätigen Sie daher die Planregeln.",
      ],
    },
    { type: "heading",text: "Was „Not Enough Money / Insufficient Margin“ bedeutet" },
    { type: "paragraph",html: "Jedes Mal, wenn Sie eine Order absenden, führt Tradovate eine <strong class='text-white'>Pre-Trade-Risikoprüfung</strong> Ihres Kontos durch, um zu entscheiden, ob Sie über genügend verfügbare Margin verfügen, um die vorgeschlagene Position zu halten. Ist das nicht der Fall, wird die Order abgelehnt, bevor sie geroutet wird, nichts geht an die Börse und es gibt keinen Fill. Betrachten Sie es als Leitplanke: Sie verhindert, dass Sie einen Trade eröffnen, der das Konto direkt in einen Margin Call führen würde." },
    { type: "paragraph",html: "Die drei Meldungen, die Sie sehen können, <strong class='text-white'>&ldquo;Not enough money&rdquo;, &ldquo;Insufficient margin&rdquo;</strong> und <strong class='text-white'>&ldquo;Not enough excess margin&rdquo;</strong>, weisen alle auf dasselbe Grundproblem hin. Ihre <em>überschüssige</em> (oder <em>verfügbare</em>) Margin, Guthaben und nicht realisierter G&amp;V minus der bereits durch offene Positionen und aktive Orders gebundenen Margin, ist kleiner als die <strong class='text-white'>Initial-Margin-Anforderung</strong> für den Kontrakt und die Menge, die Sie handeln wollten. Die genaue Formulierung hängt davon ab, von wo aus Sie handeln. Die Web- und Desktop-Apps von Tradovate zeigen meist &ldquo;Not enough money&rdquo; oder &ldquo;Insufficient margin&rdquo;, während eine angebundene Plattform wie NinjaTrader es üblicherweise als &ldquo;Not enough excess margin&rdquo; weitergibt." },
    { type: "paragraph",html: "Da Tradovate Margin-Anforderungen nach eigenem Ermessen erhöhen oder senken kann und diese über den Mindestwerten der zugrunde liegenden Börse liegen können, ist der benötigte Betrag nicht fix. Er ändert sich mit dem Kontrakt, der Tageszeit und der Marktvolatilität. Genau deshalb kann dieselbe Ordergröße morgens durchgehen und nachmittags abgelehnt werden." },
    { type: "heading",text: "Hauptursachen für Ablehnungen wegen unzureichender Margin" },
    { type: "heading",text: "1. Die Order ist für Ihren Saldo schlicht zu groß" },
    { type: "paragraph",html: "Die häufigste Ursache ist, mehr Kontrakte zu ordern, als Ihr Konto tragen kann. Jeder Futures-Kontrakt hat eine Margin-Anforderung pro Kontrakt, und Ihre Menge vervielfacht sie. Übersteigt die Summe Ihre verfügbare Margin, wird die gesamte Order abgelehnt, Tradovate füllt nicht teilweise auf das herunter, was Sie sich leisten können. Micro-Kontrakte wie MES oder MNQ benötigen weit weniger Margin als ihre vollwertigen Verwandten, daher kann eine in E-Minis abgelehnte Order in Micros bequem passen." },
    { type: "heading",text: "2. Offene Positionen und aktive Orders verbrauchen bereits Margin" },
    { type: "paragraph",html: "Verfügbare Margin ist das, was nach Ihren bestehenden Trades <em>übrig bleibt</em>. Eine offene Position bindet Margin, solange Sie sie halten, und selbst nicht ausgeführte aktive Orders, Limit- und Stop-Orders, die ausgeführt werden könnten, können Kaufkraft reservieren. Ein Konto, das &ldquo;eigentlich&rdquo; zehn Kontrakte erlauben sollte, kann den nächsten also ablehnen, einfach weil frühere Positionen und wartende Orders den Platz bereits belegt haben." },
    { type: "heading",text: "3. Day-Margin (Intraday) vs. Übernacht-Margin (Initial)" },
    { type: "paragraph",html: "Futures-Broker wenden während der aktiven Sitzung eine reduzierte <strong class='text-white'>Day-Trading-Margin (Intraday)</strong> an und die volle <strong class='text-white'>Übernacht-Margin (Initial)</strong> für Positionen, die über den täglichen Schluss gehalten werden. Die Übernacht-Zahl ist deutlich höher, oft ein Mehrfaches des Intraday-Satzes. Wenn sich der Sitzungs-Cutoff nähert (um die tägliche Abrechnung, grob 17:00 Uhr ET / 16:00 Uhr CT bei CME-Indexfutures, wobei die Zeiten je nach Instrument variieren), springt Ihre Anforderung auf die höhere Initial Margin. Eine Order, die unter dem Intraday-Satz bequem passt, kann in diesem Fenster abgelehnt werden, und jede Position, die Sie nicht decken können, kann automatisch liquidiert werden." },
    { type: "heading",text: "4. Das Konto ist unterfinanziert oder Gelder sind noch nicht verbucht" },
    { type: "paragraph",html: "Bei einem privaten Konto steht eine kürzlich getätigte Einzahlung möglicherweise noch nicht vollständig zur Verfügung. Insbesondere ACH-Einzahlungen können zurückgehalten werden oder noch in Bearbeitung sein, sodass der auf dem Bildschirm angezeigte Saldo nicht vollständig nutzbare Margin ist. Und bei einem brandneuen oder niedrig dotierten Konto kann schon ein einzelner Kontrakt die verfügbare Margin übersteigen." },
    { type: "heading",text: "5. Margin-Erhöhungen durch Volatilität, Nachrichten oder Prop-Firm-Limits" },
    { type: "paragraph",html: "Tradovate erhöht die Margin-Anforderungen rund um wichtige Wirtschaftsmeldungen und in volatilen Phasen, manchmal deutlich und mit wenig Vorankündigung. Hinzu kommt, dass Evaluierungskonten von Prop-Firms oft ihre eigenen Kaufkraft- und Max-Position-Limits über die Margin von Tradovate legen, sodass womöglich das Limit Ihrer Firma, nicht die reine Börsenmargin, die Order tatsächlich ablehnt." },
    { type: "heading",text: "So beheben Sie Ablehnungen wegen unzureichender Margin: Schritt für Schritt" },
    { type: "heading",text: "Eine zu große Order beheben" },
    {
      type: "steps",
      items: [
        { title: "Mengenfeld prüfen", html: "Öffnen Sie das Order-Ticket (DOM, Chart oder Orderfenster) und prüfen Sie das Mengenfeld." },
        { title: "Menge senken und erneut senden", html: "Senken Sie die Kontraktmenge, halbieren Sie sie zunächst, und senden Sie erneut." },
        { title: "Zur Micro-Version wechseln", html: "Wird sie weiterhin abgelehnt, wechseln Sie zur Micro-Version des Kontrakts (etwa MES statt ES), um die Anforderung pro Kontrakt zu verkleinern." },
      ],
    },
    { type: "heading",text: "Margin aus bestehenden Trades freigeben" },
    {
      type: "steps",
      items: [
        { title: "Offene Positionen prüfen", html: "Öffnen Sie Ihr Modul Positions und prüfen Sie, was aktuell offen ist." },
        { title: "Eine Position glattstellen oder reduzieren", html: "Stellen Sie eine nicht mehr benötigte Position glatt oder reduzieren Sie sie, um die dort gebundene Margin freizugeben." },
        { title: "Wartende Orders stornieren", html: "Stornieren Sie alle wartenden Limit- oder Stop-Orders, die Kaufkraft reservieren." },
        { title: "Order erneut senden", html: "Senden Sie die neue Order erneut, sobald sich Ihre verfügbare Margin erholt hat." },
      ],
    },
    { type: "heading",text: "Die Übernacht-Margin (Initial Margin) erfüllen" },
    {
      type: "steps",
      items: [
        { title: "Für die Initial Margin dimensionieren", html: "Wenn Sie über den Sitzungsschluss hinaus halten wollen, dimensionieren Sie die Position für die <strong class='text-white'>Initial</strong> Margin, nicht für den Intraday-Satz." },
        { title: "Vor dem Cutoff aussteigen, wenn die Margin nicht reicht", html: "Wenn Sie nur Intraday-Margin haben, steigen Sie vor dem Cutoff aus oder reduzieren Sie die Position, damit Sie nicht in die höhere Anforderung gezwungen oder liquidiert werden." },
        { title: "Den Zeitplan Day vs. Übernacht prüfen", html: "Prüfen Sie den Zeitplan Day vs. Übernacht für Ihr konkretes Instrument, da die genauen Cutoff-Zeiten je nach Markt variieren und sich ändern können." },
      ],
    },
    { type: "heading",text: "Guthaben aufstocken oder den Saldo verbuchen lassen" },
    {
      type: "steps",
      items: [
        { title: "Einzahlen und Gelder verbuchen lassen", html: "Zahlen Sie bei einem privaten Konto zusätzliche Gelder ein, um Ihre Kaufkraft zu erhöhen, und lassen Sie ausstehende oder gehaltene Einzahlungen vollständig verbuchen, bevor Sie sich darauf stützen." },
        { title: "Größe reduzieren oder bei Prop-Konten die Firma kontaktieren", html: "Bei einem Evaluierungskonto eines Prop-Firms können Sie in der Regel <strong class='text-white'>nicht</strong> einzahlen, reduzieren Sie stattdessen die Größe, damit sie in die Kaufkraft der Firma passt, oder wenden Sie sich an die Firma, um Ihre Limits zu bestätigen." },
      ],
    },
    { type: "heading",text: "Die aktuelle Margin-Anforderung bestätigen" },
    {
      type: "steps",
      items: [
        { title: "Die aktuelle Margin-Anforderung nachschlagen", html: "Schlagen Sie die aktuelle Margin-Anforderung für Ihren Kontrakt in der Margin-Tabelle von Tradovate nach, bevor Sie handeln." },
        { title: "Mit der verfügbaren Margin vergleichen", html: "Vergleichen Sie sie mit Ihrer verfügbaren/überschüssigen Margin, ist die Anforderung höher, reduzieren Sie die Menge oder zahlen Sie Guthaben ein." },
        { title: "Rund um Nachrichtenereignisse erneut prüfen", html: "Prüfen Sie rund um Nachrichtenereignisse erneut, da Anforderungen vorübergehend springen können." },
      ],
    },
    { type: "heading",text: "Fehlerbehebungstabelle" },
    { type: "table", headers: ["Fehler","Bedeutung","Lösung"], rows: [
      ["Not enough money","Die verfügbare Margin liegt unter der für die Order nötigen Initial Margin","Menge reduzieren, Positionen schließen oder Guthaben einzahlen"],
      ["Insufficient margin","Die freie/überschüssige Margin deckt die Anforderung für Kontrakt und Größe nicht","Kontraktanzahl senken oder zu Micros wechseln"],
      ["Not enough excess margin","Von einer angebundenen Plattform (z. B. NinjaTrader) weitergegeben; dieselbe Margin-Unterdeckung","Margin freigeben oder Größe reduzieren, dann erneut senden"],
      ["Order bei Sitzungsschluss abgelehnt","Die Anforderung ist auf die höhere Übernacht-/Initial-Margin gesprungen","Für die Übernacht-Margin dimensionieren oder vor dem Cutoff aussteigen"],
      ["Order nach einer Einzahlung abgelehnt","Die kürzliche Einzahlung ist noch nicht verbucht/verfügbar","Warten, bis die Gelder verbucht sind, bevor Sie die Größe erhöhen"],
      ["Order bei einem Prop-Konto abgelehnt","Kaufkraft-/Risikolimit der Firma überschritten, nicht nur die Margin von Tradovate","Größe reduzieren oder das Prop-Firm kontaktieren"],
    ] },
    { type: "heading",text: "Mit PickMyTrade verhindern" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Mengen-/Symbolvalidierung</strong>, prüft die Ordergröße gegen Ihr Konto, bevor ein Alert geroutet wird, sodass zu große Orders gar nicht erst gesendet werden, um dann abgelehnt zu werden.",
        "<strong class='text-white'>Berechtigungs- &amp; Risikofilter</strong>, berücksichtigt die Kaufkraft- und Max-Position-Limits des Prop-Firms sowie den aktuellen Kontostand.",
        "<strong class='text-white'>Ratenlimit-sicheres Routing</strong>, verteilt den Order-Fluss zeitlich, sodass nichts durch schnelle Wiederholversuche nach einer Ablehnung abprallt.",
        "<strong class='text-white'>Multi-Account-Synchronisierung</strong>, spiegelt die korrigierte, richtig dimensionierte Order auf einmal auf alle verbundenen Konten.",
      ],
    },
  ], es: [
    { type: "paragraph",html: "Pocas cosas matan un buen setup de futuros más rápido que una orden que rebota rechazada en el momento en que pulsa enviar. Si opera instrumentos rápidos como ES, NQ o CL en Tradovate, casi seguro que se ha topado con esto. Tradovate ejecuta una comprobación de riesgo previa a la operación en cada orden, y si su margen libre (excedente) no cubre el requisito, la orden nunca llega al mercado. Aparece como uno de varios mensajes casi idénticos, <strong class='text-white'>&ldquo;Not enough money,&rdquo;</strong> <strong class='text-white'>&ldquo;Insufficient margin&rdquo;</strong> o <strong class='text-white'>&ldquo;Not enough excess margin&rdquo;</strong>, y en 2026 sigue siendo uno de los rechazos más comunes tanto en cuentas personales como de prop firms. La buena noticia: casi siempre es un problema de tamaño o de fondos, y normalmente se resuelve en segundos. Herramientas de automatización como PickMyTrade incluso pueden validar el tamaño de la orden antes de que salga una alerta, de modo que el rechazo ni siquiera llega a producirse." },
    {
      type: "checklist",
      heading: "Lista de verificación rápida para rechazos por margen insuficiente",
      items: [
        "<strong class='text-white'>Orden demasiado grande para su saldo</strong>, reduzca la cantidad de contratos hasta que quepa en su margen disponible.",
        "<strong class='text-white'>Posiciones abiertas u órdenes activas consumiendo margen</strong>, cierre posiciones o cancele órdenes pendientes para liberar poder adquisitivo.",
        "<strong class='text-white'>Mantener hasta el cierre de la sesión</strong>, el margen nocturno (inicial) más alto entra en vigor cerca del corte diario, así que reduzca el tamaño antes.",
        "<strong class='text-white'>Cuenta infrafinanciada o fondos aún pendientes</strong>, deposite y deje que los fondos compensados se liquiden en una cuenta personal, o contacte con su prop firm en una cuenta de evaluación.",
        "<strong class='text-white'>El margen subió por noticias o volatilidad</strong>, los requisitos pueden dispararse en torno a publicaciones económicas, así que vuelva a comprobar la tarifa vigente antes de reenviar.",
        "<strong class='text-white'>Límite de riesgo de la prop firm alcanzado</strong>, su firma puede fijar un límite de poder adquisitivo inferior al margen bruto de Tradovate, así que confirme las reglas del plan.",
      ],
    },
    { type: "heading",text: "Qué significa «Not Enough Money / Insufficient Margin»" },
    { type: "paragraph",html: "Cada vez que envía una orden, Tradovate ejecuta una <strong class='text-white'>revisión de riesgo previa a la operación</strong> de su cuenta para decidir si tiene margen disponible suficiente para mantener la posición propuesta. Si no lo tiene, la orden se rechaza antes de enrutarse, nada va a la bolsa y no hay ejecución. Piense en ello como una barandilla: le impide abrir una operación que llevaría la cuenta directamente a una llamada de margen." },
    { type: "paragraph",html: "Los tres mensajes que puede ver, <strong class='text-white'>&ldquo;Not enough money,&rdquo; &ldquo;Insufficient margin,&rdquo;</strong> y <strong class='text-white'>&ldquo;Not enough excess margin,&rdquo;</strong> apuntan al mismo problema de fondo. Su margen <em>excedente</em> (o <em>disponible</em>), efectivo y P&amp;L no realizado menos el margen ya inmovilizado por las posiciones abiertas y las órdenes activas, es menor que el <strong class='text-white'>requisito de margen inicial</strong> del contrato y la cantidad que intentó operar. La redacción exacta depende de dónde esté operando. Las aplicaciones web y de escritorio de Tradovate tienden a decir &ldquo;Not enough money&rdquo; o &ldquo;Insufficient margin&rdquo;, mientras que una plataforma conectada como NinjaTrader suele transmitirlo como &ldquo;Not enough excess margin.&rdquo;" },
    { type: "paragraph",html: "Como Tradovate puede subir o bajar los requisitos de margen a su discreción, y esos requisitos pueden situarse por encima de los mínimos de la bolsa subyacente, la cifra que necesita no es fija. Cambia con el contrato, la hora del día y la volatilidad del mercado. Por eso mismo el mismo tamaño de orden puede pasar por la mañana y ser rechazado por la tarde." },
    { type: "heading",text: "Principales causas de los rechazos por margen insuficiente" },
    { type: "heading",text: "1. La orden es sencillamente demasiado grande para su saldo" },
    { type: "paragraph",html: "La causa más común es pedir más contratos de los que su cuenta puede soportar. Cada contrato de futuros lleva un requisito de margen por contrato, y su cantidad lo multiplica. Si el total supera su margen disponible, se rechaza toda la orden, Tradovate no ejecuta parcialmente hasta lo que usted pueda pagar. Los contratos micro como MES o MNQ requieren mucho menos margen que sus equivalentes de tamaño completo, así que una orden rechazada en E-minis puede caber cómodamente en Micros." },
    { type: "heading",text: "2. Las posiciones abiertas y las órdenes activas ya están consumiendo margen" },
    { type: "paragraph",html: "El margen disponible es lo que <em>queda</em> después de sus operaciones existentes. Una posición abierta inmoviliza margen mientras la mantiene, e incluso las órdenes activas sin ejecutar, límites y stops que podrían ejecutarse, pueden reservar poder adquisitivo. Así, una cuenta que &ldquo;debería&rdquo; permitir diez contratos puede rechazar el siguiente simplemente porque las posiciones anteriores y las órdenes pendientes ya han ocupado el espacio." },
    { type: "heading",text: "3. Margen de day trading (intradía) frente a margen nocturno (inicial)" },
    { type: "paragraph",html: "Los brokers de futuros aplican un <strong class='text-white'>margen de day trading (intradía)</strong> reducido durante la sesión activa y el <strong class='text-white'>margen nocturno (inicial)</strong> completo para las posiciones mantenidas durante el cierre diario. La cifra nocturna es sensiblemente más alta, a menudo varias veces la tarifa intradía. A medida que se acerca el corte de la sesión (en torno a la liquidación diaria, aproximadamente 5:00 p. m. ET / 4:00 p. m. CT para los futuros de índices del CME, aunque los horarios varían según el instrumento), su requisito pasa al margen inicial más alto. Una orden que cabe cómodamente bajo la tarifa intradía puede ser rechazada en esa ventana, y cualquier posición que no pueda cubrir puede ser autoliquidada." },
    { type: "heading",text: "4. La cuenta está infrafinanciada o los fondos no se han liquidado" },
    { type: "paragraph",html: "En una cuenta personal, un depósito reciente puede no estar totalmente disponible todavía. Los depósitos ACH en particular pueden quedar retenidos o seguir compensándose, de modo que el saldo que ve en pantalla no es todo margen utilizable. Y en una cuenta nueva o con poco saldo, incluso un solo contrato puede superar el margen disponible." },
    { type: "heading",text: "5. Aumentos de margen por volatilidad, noticias o límites de la prop firm" },
    { type: "paragraph",html: "Tradovate eleva los requisitos de margen en torno a los grandes anuncios económicos y en condiciones volátiles, a veces de forma acusada y con poco aviso. Además, las cuentas de evaluación de las prop firms suelen superponer sus propios límites de poder adquisitivo y de posición máxima a los márgenes de Tradovate, de modo que el límite de su firma, y no el margen bruto de la bolsa, puede ser lo que realmente rechaza la orden." },
    { type: "heading",text: "Cómo solucionar los rechazos por margen insuficiente: paso a paso" },
    { type: "heading",text: "Corregir una orden demasiado grande" },
    {
      type: "steps",
      items: [
        { title: "Compruebe el campo de cantidad", html: "Abra el ticket de entrada de órdenes (DOM, gráfico o ventana de órdenes) y compruebe el campo de cantidad." },
        { title: "Reduzca la cantidad y reenvíe", html: "Reduzca la cantidad de contratos, empiece por reducirla a la mitad, y reenvíe." },
        { title: "Cambie a la versión Micro", html: "Si aún se rechaza, cambie a la versión Micro del contrato (por ejemplo MES en lugar de ES) para reducir el requisito por contrato." },
      ],
    },
    { type: "heading",text: "Liberar margen de las operaciones existentes" },
    {
      type: "steps",
      items: [
        { title: "Revise sus posiciones abiertas", html: "Abra su módulo Positions y revise lo que está abierto actualmente." },
        { title: "Cierre o reduzca una posición", html: "Cierre o reduzca una posición que ya no necesite para liberar el margen que retiene." },
        { title: "Cancele las órdenes pendientes", html: "Cancele cualquier orden limit o stop pendiente que esté reservando poder adquisitivo." },
        { title: "Reenvíe la orden", html: "Reenvíe la nueva orden una vez que su margen disponible se haya recuperado." },
      ],
    },
    { type: "heading",text: "Cumplir el margen nocturno (inicial)" },
    {
      type: "steps",
      items: [
        { title: "Dimensione para el margen inicial", html: "Si planea mantener la posición más allá del cierre de la sesión, dimensione la posición para el margen <strong class='text-white'>inicial</strong>, no para la tarifa intradía." },
        { title: "Salga antes del corte si le falta margen", html: "Si solo tiene margen intradía, salga o reduzca la posición antes del corte para no verse forzado al requisito más alto ni ser liquidado." },
        { title: "Consulte el calendario intradía frente a nocturno", html: "Consulte el calendario intradía frente a nocturno de su instrumento concreto, ya que los horarios exactos de corte varían según el mercado y pueden cambiar." },
      ],
    },
    { type: "heading",text: "Añadir fondos o liquidar el saldo" },
    {
      type: "steps",
      items: [
        { title: "Deposite y deje que los fondos se liquiden", html: "En una cuenta personal, deposite fondos adicionales para aumentar su poder adquisitivo, y deje que cualquier depósito pendiente o retenido se compense por completo antes de apoyarse en él." },
        { title: "Reduzca el tamaño o contacte con la firma en cuentas prop", html: "En una cuenta de evaluación de una prop firm normalmente <strong class='text-white'>no puede</strong> depositar, en su lugar, reduzca el tamaño para ajustarse al poder adquisitivo de la firma, o contacte con la firma para confirmar sus límites." },
      ],
    },
    { type: "heading",text: "Confirmar el requisito de margen vigente" },
    {
      type: "steps",
      items: [
        { title: "Consulte el requisito de margen en vivo", html: "Consulte el requisito de margen en vivo de su contrato en la tabla de márgenes de Tradovate antes de operar." },
        { title: "Compárelo con su margen disponible", html: "Compárelo con su margen disponible/excedente, si el requisito es mayor, reduzca la cantidad o añada fondos." },
        { title: "Vuelva a comprobar en torno a eventos de noticias", html: "Vuelva a comprobar en torno a eventos de noticias, ya que los requisitos pueden dispararse temporalmente." },
      ],
    },
    { type: "heading",text: "Tabla de resolución de problemas" },
    { type: "table", headers: ["Error","Significado","Solución"], rows: [
      ["Not enough money","El margen disponible está por debajo del margen inicial necesario para la orden","Reduzca la cantidad, cierre posiciones o añada fondos"],
      ["Insufficient margin","El margen libre/excedente no cubre el requisito del contrato y el tamaño","Reduzca el número de contratos o cambie a Micros"],
      ["Not enough excess margin","Transmitido desde una plataforma conectada (p. ej., NinjaTrader); mismo déficit de margen","Libere margen o reduzca el tamaño y reenvíe"],
      ["Orden rechazada cerca del cierre de sesión","El requisito pasó al margen nocturno/inicial más alto","Dimensione para el margen nocturno o salga antes del corte"],
      ["Orden rechazada tras un depósito","El depósito reciente aún no se ha compensado/está disponible","Espere a que los fondos se liquiden antes de aumentar el tamaño"],
      ["Orden rechazada en una cuenta prop","Se superó el límite de poder adquisitivo/riesgo de la firma, no solo el margen de Tradovate","Reduzca el tamaño o contacte con la prop firm"],
    ] },
    { type: "heading",text: "Prevéngalo con PickMyTrade" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Validación de cantidad / símbolo</strong>, comprueba el tamaño de la orden frente a su cuenta antes de enrutar una alerta, de modo que las órdenes demasiado grandes nunca se envían para ser rechazadas.",
        "<strong class='text-white'>Filtros de autorización y riesgo</strong>, respeta los límites de poder adquisitivo y de posición máxima de la prop firm junto con el estado actual de su cuenta.",
        "<strong class='text-white'>Enrutamiento seguro ante límites de frecuencia</strong>, espacia el flujo de órdenes para que nada rebote por reintentos rápidos tras un rechazo.",
        "<strong class='text-white'>Sincronización multicuenta</strong>, replica la orden corregida y con el tamaño correcto en todas las cuentas vinculadas a la vez.",
      ],
    },
  ], fr: [
    { type: "paragraph",html: "Peu de choses ruinent un bon setup en futures plus vite qu'un ordre qui revient rejeté à la seconde où vous cliquez sur envoyer. Si vous tradez des instruments rapides comme ES, NQ ou CL sur Tradovate, vous avez presque certainement déjà croisé ce cas. Tradovate exécute un contrôle de risque pré-trade sur chaque ordre, et si votre marge libre (excédentaire) ne couvre pas l'exigence, l'ordre n'atteint jamais la bourse. Il apparaît sous l'un de plusieurs messages quasi identiques, <strong class='text-white'>&ldquo;Not enough money,&rdquo;</strong> <strong class='text-white'>&ldquo;Insufficient margin,&rdquo;</strong> ou <strong class='text-white'>&ldquo;Not enough excess margin,&rdquo;</strong> et en 2026 c'est toujours l'un des rejets les plus courants, tant sur les comptes personnels que sur ceux de prop firms. La bonne nouvelle : c'est presque toujours un problème de taille ou de financement, et vous pouvez généralement le régler en quelques secondes. Des outils d'automatisation comme PickMyTrade peuvent même valider la taille de l'ordre avant qu'une alerte ne parte, de sorte que le rejet ne se produit jamais." },
    {
      type: "checklist",
      heading: "Liste de contrôle rapide pour les rejets de marge insuffisante",
      items: [
        "<strong class='text-white'>Ordre trop gros pour votre solde</strong>, réduisez la quantité de contrats jusqu'à ce qu'elle tienne dans votre marge disponible.",
        "<strong class='text-white'>Positions ouvertes ou ordres actifs qui consomment de la marge</strong>, clôturez des positions ou annulez les ordres en attente pour libérer du pouvoir d'achat.",
        "<strong class='text-white'>Position conservée jusqu'à la clôture de la session</strong>, la marge overnight (initiale) plus élevée s'applique près de l'heure limite quotidienne ; réduisez donc la taille avant.",
        "<strong class='text-white'>Compte sous-financé ou fonds encore en attente</strong>, déposez et laissez les fonds compensés se régler sur un compte personnel, ou contactez votre prop firm sur un compte d'évaluation.",
        "<strong class='text-white'>Marge en hausse à cause des actualités ou de la volatilité</strong>, les exigences peuvent bondir autour des publications économiques ; revérifiez donc le taux actuel avant de renvoyer.",
        "<strong class='text-white'>Plafond de risque de la prop firm atteint</strong>, votre firme peut fixer une limite de pouvoir d'achat inférieure à la marge brute de Tradovate ; confirmez donc les règles du plan.",
      ],
    },
    { type: "heading",text: "Ce que signifie « Not Enough Money / Insufficient Margin »" },
    { type: "paragraph",html: "Chaque fois que vous soumettez un ordre, Tradovate effectue un <strong class='text-white'>contrôle de risque pré-trade</strong> de votre compte pour décider si vous disposez d'assez de marge disponible pour conserver la position proposée. Sinon, l'ordre est rejeté avant d'être acheminé : rien ne part vers la bourse et il n'y a pas d'exécution. Voyez-y un garde-fou : il vous empêche d'ouvrir un trade qui placerait le compte directement en appel de marge." },
    { type: "paragraph",html: "Les trois messages que vous pouvez voir, <strong class='text-white'>&ldquo;Not enough money,&rdquo; &ldquo;Insufficient margin,&rdquo;</strong> et <strong class='text-white'>&ldquo;Not enough excess margin,&rdquo;</strong> renvoient tous au même problème de fond. Votre marge <em>excédentaire</em> (ou <em>disponible</em>), les liquidités et le P&amp;L latent moins la marge déjà immobilisée par les positions ouvertes et les ordres actifs, est inférieure à l'<strong class='text-white'>exigence de marge initiale</strong> pour le contrat et la quantité que vous avez tenté de trader. La formulation exacte dépend de l'endroit d'où vous tradez. Les applications web et de bureau de Tradovate tendent à afficher &ldquo;Not enough money&rdquo; ou &ldquo;Insufficient margin&rdquo;, tandis qu'une plateforme connectée comme NinjaTrader le relaie généralement sous la forme &ldquo;Not enough excess margin.&rdquo;" },
    { type: "paragraph",html: "Comme Tradovate peut relever ou abaisser les exigences de marge à sa discrétion, et que ces exigences peuvent se situer au-dessus des minimums de la bourse sous-jacente, le montant dont vous avez besoin n'est pas fixe. Il évolue avec le contrat, l'heure de la journée et la volatilité du marché. C'est précisément pourquoi la même taille d'ordre peut passer le matin et être rejetée l'après-midi." },
    { type: "heading",text: "Principales causes des rejets de marge insuffisante" },
    { type: "heading",text: "1. L'ordre est tout simplement trop gros pour votre solde" },
    { type: "paragraph",html: "La cause la plus courante est de passer plus de contrats que votre compte ne peut en supporter. Chaque contrat à terme comporte une exigence de marge par contrat, et votre quantité la multiplie. Si le total dépasse votre marge disponible, tout l'ordre est rejeté, Tradovate n'exécute pas partiellement jusqu'à ce que vous puissiez vous le permettre. Les contrats micro comme MES ou MNQ exigent beaucoup moins de marge que leurs équivalents pleine taille ; un ordre rejeté en E-minis peut donc tenir confortablement en Micros." },
    { type: "heading",text: "2. Les positions ouvertes et les ordres actifs consomment déjà de la marge" },
    { type: "paragraph",html: "La marge disponible est ce qui <em>reste</em> après vos trades existants. Une position ouverte immobilise de la marge tant que vous la conservez, et même des ordres actifs non exécutés, limites et stops susceptibles d'être exécutés, peuvent réserver du pouvoir d'achat. Un compte qui « devrait » autoriser dix contrats peut donc rejeter le suivant simplement parce que les positions précédentes et les ordres en attente ont déjà pris la place." },
    { type: "heading",text: "3. Marge de day trading (intraday) vs marge overnight (initiale)" },
    { type: "paragraph",html: "Les brokers de futures appliquent une <strong class='text-white'>marge de day trading (intraday)</strong> réduite pendant la session active et la <strong class='text-white'>marge overnight (initiale)</strong> complète pour les positions conservées au-delà de la clôture quotidienne. Le chiffre overnight est sensiblement plus élevé, souvent plusieurs fois le taux intraday. À l'approche de l'heure limite de la session (autour du règlement quotidien, environ 17 h ET / 16 h CT pour les futures sur indices du CME, bien que les horaires varient selon l'instrument), votre exigence bascule vers la marge initiale plus élevée. Un ordre qui passe confortablement sous le taux intraday peut être rejeté dans cette fenêtre, et toute position que vous ne pouvez pas couvrir peut être auto-liquidée." },
    { type: "heading",text: "4. Le compte est sous-financé ou les fonds ne sont pas réglés" },
    { type: "paragraph",html: "Sur un compte personnel, un dépôt récent peut ne pas encore être entièrement disponible. Les dépôts ACH en particulier peuvent être retenus ou encore en cours de compensation, de sorte que le solde affiché à l'écran n'est pas entièrement de la marge utilisable. Et sur un compte tout neuf ou peu approvisionné, même un seul contrat peut dépasser la marge disponible." },
    { type: "heading",text: "5. Hausses de marge dues à la volatilité, aux actualités ou aux plafonds des prop firms" },
    { type: "paragraph",html: "Tradovate relève les exigences de marge autour des grandes annonces économiques et en cas de forte volatilité, parfois de façon marquée et avec peu de préavis. En outre, les comptes d'évaluation des prop firms superposent souvent leurs propres limites de pouvoir d'achat et de position maximale à la marge de Tradovate ; le plafond de votre firme, et non la marge brute de la bourse, peut donc être ce qui rejette réellement l'ordre." },
    { type: "heading",text: "Comment corriger les rejets de marge insuffisante : pas à pas" },
    { type: "heading",text: "Corriger un ordre surdimensionné" },
    {
      type: "steps",
      items: [
        { title: "Vérifiez le champ de quantité", html: "Ouvrez le ticket de saisie d'ordre (DOM, graphique ou fenêtre d'ordres) et vérifiez le champ de quantité." },
        { title: "Réduisez la quantité et renvoyez", html: "Réduisez la quantité de contrats, commencez par la diviser par deux, et renvoyez." },
        { title: "Passez à la version Micro", html: "Si l'ordre est encore rejeté, passez à la version Micro du contrat (par exemple MES au lieu d'ES) pour réduire l'exigence par contrat." },
      ],
    },
    { type: "heading",text: "Libérer de la marge des trades existants" },
    {
      type: "steps",
      items: [
        { title: "Passez en revue vos positions ouvertes", html: "Ouvrez votre module Positions et passez en revue ce qui est actuellement ouvert." },
        { title: "Clôturez ou réduisez une position", html: "Clôturez ou réduisez une position dont vous n'avez plus besoin pour libérer la marge qu'elle immobilise." },
        { title: "Annulez les ordres en attente", html: "Annulez tout ordre limite ou stop en attente qui réserve du pouvoir d'achat." },
        { title: "Renvoyez l'ordre", html: "Renvoyez le nouvel ordre une fois que votre marge disponible s'est rétablie." },
      ],
    },
    { type: "heading",text: "Satisfaire la marge overnight (initiale)" },
    {
      type: "steps",
      items: [
        { title: "Dimensionnez pour la marge initiale", html: "Si vous prévoyez de conserver la position au-delà de la clôture de la session, dimensionnez-la pour la marge <strong class='text-white'>initiale</strong>, et non pour le taux intraday." },
        { title: "Sortez avant l'heure limite si la marge est insuffisante", html: "Si vous n'avez que la marge intraday, sortez ou réduisez la position avant l'heure limite pour ne pas être contraint à l'exigence supérieure ni liquidé." },
        { title: "Consultez le calendrier intraday vs overnight", html: "Consultez le calendrier intraday vs overnight de votre instrument précis, car les heures limites exactes varient selon le marché et peuvent changer." },
      ],
    },
    { type: "heading",text: "Ajouter des fonds ou régler le solde" },
    {
      type: "steps",
      items: [
        { title: "Déposez et laissez les fonds se régler", html: "Sur un compte personnel, déposez des fonds supplémentaires pour accroître votre pouvoir d'achat, et laissez tout dépôt en attente ou retenu se compenser entièrement avant de vous y fier." },
        { title: "Réduisez la taille ou contactez la firme sur les comptes prop", html: "Sur un compte d'évaluation de prop firm, vous <strong class='text-white'>ne pouvez</strong> généralement pas déposer ; réduisez plutôt la taille pour l'ajuster au pouvoir d'achat de la firme, ou contactez la firme pour confirmer vos limites." },
