---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "non-tradable-symbol-tradingview-tradovate";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/debugging/${SLUG}`;

const META_TITLE = "'Non-Tradable Symbol' on TradingView + Tradovate";
const META_DESCRIPTION =
  "Non-tradable symbol on Tradovate via TradingView? Add a real-time Tradovate data feed and roll to the active front-month contract to place futures orders.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "„Non-Tradable Symbol“ bei TradingView + Tradovate", es: "“Non-Tradable Symbol” en TradingView + Tradovate", fr: "« Non-Tradable Symbol » sur TradingView + Tradovate", it: "“Non-Tradable Symbol” su TradingView + Tradovate" },
  dek: { en: "You hit Buy on a live NQ chart and TradingView throws back a grey “Non-tradable symbol” message instead of a fill, while Tradovate trades the exact same instrument without a hiccup. Here are the three fixable things behind it.", de: "Sie klicken im Live-NQ-Chart auf Kaufen, und TradingView liefert statt eines Fills eine graue Meldung „Non-tradable symbol“, während Tradovate dasselbe Instrument problemlos handelt. Hier sind die drei behebbaren Ursachen.", es: "Pulsa Comprar en un gráfico de NQ en vivo y TradingView devuelve un mensaje gris “Non-tradable symbol” en lugar de una ejecución, mientras que Tradovate opera exactamente el mismo instrumento sin problema. Estas son las tres causas que puede corregir.", fr: "Vous cliquez sur Acheter sur un graphique NQ en direct et TradingView renvoie un message gris « Non-tradable symbol » au lieu d'une exécution, alors que Tradovate trade exactement le même instrument sans accroc. Voici les trois causes que vous pouvez corriger.", it: "Preme Acquista su un grafico NQ live e TradingView restituisce un messaggio grigio “Non-tradable symbol” invece di un'esecuzione, mentre Tradovate negozia lo stesso identico strumento senza problemi. Ecco le tre cause risolvibili." },
  readTime: { en: "7 min read", de: "7 Min. Lesezeit", es: "Lectura de 7 min", fr: "Lecture : 7 min", it: "Lettura di 7 min" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "You lined up a clean setup on the NQ chart, hit Buy, and TradingView threw back a grey <strong class='text-white'>“Non-tradable symbol”</strong> message instead of a fill. Meanwhile your Tradovate web platform trades the exact same instrument without a hiccup. It's one of the most common friction points when you route orders from a TradingView chart into a connected Tradovate account, and it almost always comes down to three fixable things: a missing real-time data subscription on the Tradovate side, a chart pointed at a continuous or expired contract instead of the live front month, or a symbol Tradovate simply doesn't offer for futures trading. Buying a data package inside TradingView won't clear it on its own, the entitlement has to live on the broker." },
    {
      type: "checklist",
      heading: "Quick Checklist for the “Non-Tradable Symbol” Error",
      items: [
        "<strong class='text-white'>Subscribe to real-time data inside Tradovate</strong>, a data package bought on TradingView alone won't let orders through.",
        "<strong class='text-white'>Roll off continuous symbols</strong>, <code>NQ1!</code>, <code>ES1!</code>, and similar <code>1!</code> tickers are chart-only; trade the specific month/year contract.",
        "<strong class='text-white'>Check the contract hasn't expired</strong>, an old front month stops being tradable once it rolls.",
        "<strong class='text-white'>Trade a Tradovate-supported futures product</strong>, indices, spot/cash symbols, and synthetic tickers aren't tradable through the broker.",
        "<strong class='text-white'>Confirm the TradingView add-on is enabled</strong> on the Tradovate account so the two platforms complete the handshake.",
        "<strong class='text-white'>Prop-firm account?</strong> Data is enabled by the firm, not by you, contact them if quotes never go live.",
      ],
    },
    { type: "heading", text: "What “Non-Tradable Symbol” Means" },
    { type: "paragraph", html: "The <strong class='text-white'>“Non-tradable symbol”</strong> notice is TradingView telling you that the ticker on your chart can't be sent as a live order to the broker you're connected to, in this case Tradovate. The chart may still stream prices and draw candles perfectly, but drawing a chart and routing an order are two different permissions. TradingView will happily plot a synthetic index, a continuous futures series, or an expired contract for analysis, yet none of those are things a futures broker can actually fill." },
    { type: "paragraph", html: "For Tradovate specifically, the message shows up when the account isn't entitled to place a real order for that instrument. The most frequent trigger is data. To trade futures on Tradovate through TradingView, you need a real-time data subscription on the broker platform itself, if you only bought a data package inside TradingView, orders can't be placed. The good news: Tradovate verifies the entitlement against your live account, so you're not forced to pay for the same data twice." },
    { type: "paragraph", html: "The second big trigger is the symbol itself. Tradovate is a futures broker, so it can only accept orders for real, currently listed futures contracts. Point the ticket at anything that isn't one of those, a continuous chart series, an index, or a contract that already expired, and TradingView blocks the order before it ever leaves your browser." },
    { type: "heading", text: "Top Causes of the Non-Tradable Symbol Error" },
    { type: "heading", text: "1. No real-time Tradovate market-data subscription" },
    { type: "paragraph", html: "This is the headline cause. Tradovate needs an active real-time data subscription on the account before it will accept live orders for a symbol. It's easy to assume a paid TradingView plan or a TradingView data add-on covers it, it doesn't. The entitlement that unlocks order routing lives on the broker, and if your Tradovate data subscription is missing or has lapsed, TradingView marks the symbol non-tradable even though the chart looks live." },
    { type: "heading", text: "2. You're on a continuous or expired contract" },
    { type: "paragraph", html: "Continuous futures symbols, the ones ending in <code>1!</code> such as <code>NQ1!</code> or <code>ES1!</code>, are convenience series TradingView stitches together for charting. They don't map to a single, real contract the exchange can trade, so they can't be ordered. Same story with a specific contract that has already rolled past expiration: the exact ticker that worked last quarter (say an old March contract) goes non-tradable once that month expires and the market moves to the next front month." },
    { type: "heading", text: "3. The symbol isn't a Tradovate-supported futures product" },
    { type: "paragraph", html: "Tradovate trades futures. If your chart is on an index (like a cash NASDAQ or S&amp;P index), a spot/cash symbol, a stock, or one of TradingView's purple-labelled synthetic tickers, there's no matching contract for Tradovate to fill, so the order is blocked. TradingView's symbol search includes a “see all tradable symbols” filter precisely so you can avoid picking something the broker doesn't offer." },
    { type: "heading", text: "4. The TradingView add-on or broker link isn't fully enabled" },
    { type: "paragraph", html: "Linking your Tradovate login to TradingView is only step one. The account also needs the TradingView add-on/entitlement switched on so the two platforms complete their handshake. If that toggle is off, or the broker session dropped, TradingView can display the chart but refuse the order." },
    { type: "heading", text: "5. Prop-firm evaluation accounts where the firm controls data" },
    { type: "paragraph", html: "On a prop-firm evaluation or funded account (Apex, Topstep, and similar), you usually can't self-subscribe to market data, the firm provisions it. If the firm hasn't enabled real-time data on your evaluation account, symbols read as delayed or non-tradable no matter what you change on your end." },
    { type: "heading", text: "How to Fix the Non-Tradable Symbol Error: Step-by-Step" },
    { type: "paragraph", html: "Work through these in order, most traders are fixed by the first two." },
    { type: "heading", text: "Fix 1: Add a real-time Tradovate market-data subscription" },
    { type: "paragraph", html: "<ol><li>Log in to the Tradovate web platform (not TradingView) with the same account you connected.</li><li>Open <strong class='text-white'>Account / Settings</strong> and find the <strong class='text-white'>Market Data Subscriptions</strong> area.</li><li>Add the real-time exchange feed that covers the product you want to trade (for CME-group futures like ES, NQ, and their micros, that's the relevant CME real-time package).</li><li>Complete any non-professional market-data agreement Tradovate presents, an unsigned agreement can also block live orders.</li><li>Log out of both Tradovate and TradingView, then log back in so the new entitlement propagates.</li></ol>" },
    { type: "paragraph", html: "Data-package pricing and exchange fees vary by exchange, plan, and account type, check Tradovate's current market-data rates before subscribing. Once the feed is live, Tradovate verifies the entitlement against your account, so you don't pay for the same data on TradingView as well." },
    { type: "heading", text: "Fix 2: Switch to the active front-month contract" },
    { type: "paragraph", html: "<ol><li>In TradingView, open the symbol search and type the root of the product (for example <code>NQ</code>).</li><li>Avoid the continuous <code>1!</code> entry. Instead choose the dated contract in month/year format, for example the current quarterly NASDAQ contract, not <code>NQ1!</code>.</li><li>Match it to the contract Tradovate is currently trading. Tradovate follows the CME “Globex code” rollover schedule, so the tradable front month changes each quarter.</li><li>If you were on a contract that recently expired, pick the new front month and re-arm your order.</li></ol>" },
    { type: "paragraph", html: "Using the live, dated contract is what turns the order ticket from “Non-tradable symbol” back into an active Buy/Sell button." },
    { type: "heading", text: "Fix 3: Confirm the TradingView add-on and broker connection" },
    { type: "paragraph", html: "<ol><li>In Tradovate, open the <strong class='text-white'>Add-ons / Application Settings</strong> area and make sure the <strong class='text-white'>TradingView</strong> add-on is enabled for the account.</li><li>In TradingView, open the <strong class='text-white'>Trading Panel</strong>, confirm the broker shows as <strong class='text-white'>Tradovate, Connected</strong>, and that the correct account is selected.</li><li>If the connection looks stale, disconnect and reconnect the broker from the TradingView trading panel, then reload the chart.</li><li>Re-select the symbol so the ticket re-checks entitlement against the freshly connected account.</li></ol>" },
    { type: "paragraph", html: "If a symbol is still blocked here, filter the symbol search to show only broker-tradable instruments and re-pick from that list." },
    { type: "heading", text: "Fix 4: For prop accounts, ask the firm to enable data" },
    { type: "paragraph", html: "If you're on a prop-firm evaluation or funded Tradovate account, you generally can't subscribe to data yourself. Contact your firm's support and ask them to confirm real-time market data is enabled on your specific evaluation account. Until they do, the symbol will keep reading as delayed or non-tradable regardless of what you change in TradingView or Tradovate." },
    { type: "heading", text: "Troubleshooting Table" },
    {
      type: "table",
      headers: ["Error / State", "Meaning", "Fix"],
      rows: [
        ["Non-tradable symbol", "The ticker can't be routed as a live order to Tradovate", "Add a real-time Tradovate data subscription and select a broker-tradable futures contract"],
        ["Chart is live but order is blocked", "Data subscription bought on TradingView, not on the broker", "Subscribe to the exchange feed inside Tradovate; TradingView data alone doesn't route orders"],
        ["NQ1! / ES1! won't trade", "Continuous chart-only series, not a real contract", "Trade the dated front-month contract (month/year code) instead"],
        ["Old contract suddenly non-tradable", "The contract expired and rolled", "Roll forward to the current front-month contract"],
        ["Index / spot / stock non-tradable", "Not a Tradovate futures product", "Pick the equivalent futures contract Tradovate supports"],
        ["Symbol blocked after connecting", "TradingView add-on not enabled or session dropped", "Enable the TradingView add-on in Tradovate and reconnect the broker"],
        ["Prop account stays delayed", "Firm hasn't provisioned market data", "Contact the prop firm to enable real-time data on the eval account"],
      ],
    },
    { type: "heading", text: "Prevent This with PickMyTrade" },
    { type: "paragraph", html: "When your alerts fire into Tradovate automatically, a blocked or mis-typed symbol shouldn't cost you the trade. PickMyTrade sits between TradingView and Tradovate and hardens the weak points that cause the non-tradable-symbol error:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Symbol &amp; Contract Validation</strong>, maps your alert to the live, tradable front-month contract so orders don't land on a continuous or expired ticker.",
        "<strong class='text-white'>Entitlement &amp; Data-State Awareness</strong>, respects your account's market-data and connection state so orders route only when the account can actually fill them.",
        "<strong class='text-white'>Rate-Limit-Safe Routing</strong>, spaces out order flow so nothing bounces during fast markets.",
        "<strong class='text-white'>Multi-Account Sync</strong>, mirrors the corrected order across every connected Tradovate account at once.",
      ],
    },
  ], de: [
    { type: "paragraph",html: "Sie hatten ein sauberes Setup im NQ-Chart, klicken auf Kaufen, und TradingView liefert statt eines Fills eine graue Meldung <strong class='text-white'>“Non-tradable symbol”</strong>. Währenddessen handelt Ihre Tradovate-Web-Plattform dasselbe Instrument ohne Probleme. Das ist einer der häufigsten Reibungspunkte, wenn Sie Orders aus einem TradingView-Chart in ein verbundenes Tradovate-Konto routen, und es läuft fast immer auf drei behebbare Ursachen hinaus: ein fehlendes Echtzeitdaten-Abonnement auf der Tradovate-Seite, ein Chart, der auf einen kontinuierlichen oder abgelaufenen Kontrakt statt auf den aktiven Front-Month zeigt, oder ein Symbol, das Tradovate für den Futures-Handel schlicht nicht anbietet. Ein in TradingView gekauftes Datenpaket behebt das allein nicht, die Berechtigung muss beim Broker liegen." },
    {
      type: "checklist",
      heading: "Kurze Checkliste für den Fehler „Non-Tradable Symbol“",
      items: [
        "<strong class='text-white'>Abonnieren Sie Echtzeitdaten direkt in Tradovate</strong>, ein allein bei TradingView gekauftes Datenpaket lässt Orders nicht durch.",
        "<strong class='text-white'>Verlassen Sie kontinuierliche Symbole</strong>, <code>NQ1!</code>, <code>ES1!</code> und ähnliche <code>1!</code>-Ticker sind nur für Charts da; handeln Sie den konkreten Monats-/Jahreskontrakt.",
        "<strong class='text-white'>Prüfen Sie, dass der Kontrakt nicht abgelaufen ist</strong>, ein alter Front-Month ist nach dem Rollover nicht mehr handelbar.",
        "<strong class='text-white'>Handeln Sie ein von Tradovate unterstütztes Futures-Produkt</strong>, Indizes, Spot-/Cash-Symbole und synthetische Ticker sind über den Broker nicht handelbar.",
        "<strong class='text-white'>Bestätigen Sie, dass das TradingView-Add-on aktiviert ist</strong>, und zwar auf dem Tradovate-Konto, damit die beiden Plattformen den Handshake abschließen.",
        "<strong class='text-white'>Prop-Firm-Konto?</strong> Die Daten aktiviert die Firma, nicht Sie, kontaktieren Sie sie, wenn die Kurse nie live gehen.",
      ],
    },
    { type: "heading",text: "Was „Non-Tradable Symbol“ bedeutet" },
    { type: "paragraph",html: "Der Hinweis <strong class='text-white'>“Non-tradable symbol”</strong> ist TradingViews Art, Ihnen zu sagen, dass der Ticker in Ihrem Chart nicht als Live-Order an den verbundenen Broker gesendet werden kann, hier Tradovate. Der Chart kann weiterhin Kurse streamen und Kerzen perfekt zeichnen, aber einen Chart zu zeichnen und eine Order zu routen sind zwei verschiedene Berechtigungen. TradingView stellt zu Analysezwecken gern einen synthetischen Index, eine kontinuierliche Futures-Serie oder einen abgelaufenen Kontrakt dar, doch nichts davon kann ein Futures-Broker tatsächlich ausführen." },
    { type: "paragraph",html: "Speziell bei Tradovate erscheint die Meldung, wenn das Konto nicht berechtigt ist, für dieses Instrument eine echte Order zu platzieren. Der häufigste Auslöser sind Daten. Um Futures auf Tradovate über TradingView zu handeln, benötigen Sie ein Echtzeitdaten-Abonnement auf der Broker-Plattform selbst. Haben Sie nur ein Datenpaket in TradingView gekauft, können keine Orders platziert werden. Die gute Nachricht: Tradovate verifiziert die Berechtigung gegen Ihr Live-Konto, sodass Sie nicht gezwungen sind, doppelt für dieselben Daten zu zahlen." },
    { type: "paragraph",html: "Der zweite große Auslöser ist das Symbol selbst. Tradovate ist ein Futures-Broker und kann daher nur Orders für echte, aktuell gelistete Futures-Kontrakte annehmen. Richten Sie das Ticket auf irgendetwas anderes, eine kontinuierliche Chart-Serie, einen Index oder einen bereits abgelaufenen Kontrakt, blockiert TradingView die Order, bevor sie Ihren Browser überhaupt verlässt." },
    { type: "heading",text: "Häufigste Ursachen für den Fehler „Non-Tradable Symbol“" },
    { type: "heading",text: "1. Kein Tradovate-Echtzeit-Marktdaten-Abonnement" },
    { type: "paragraph",html: "Das ist die Hauptursache. Tradovate benötigt ein aktives Echtzeitdaten-Abonnement auf dem Konto, bevor es Live-Orders für ein Symbol annimmt. Man nimmt leicht an, ein kostenpflichtiger TradingView-Plan oder ein TradingView-Daten-Add-on decke das ab, doch das tut es nicht. Die Berechtigung, die das Order-Routing freischaltet, liegt beim Broker, und wenn Ihr Tradovate-Datenabonnement fehlt oder abgelaufen ist, markiert TradingView das Symbol als nicht handelbar, obwohl der Chart live aussieht." },
    { type: "heading",text: "2. Sie befinden sich auf einem kontinuierlichen oder abgelaufenen Kontrakt" },
    { type: "paragraph",html: "Kontinuierliche Futures-Symbole, die auf <code>1!</code> enden, wie <code>NQ1!</code> oder <code>ES1!</code>, sind Komfortserien, die TradingView für Charts zusammenfügt. Sie entsprechen keinem einzelnen, echten Kontrakt, den die Börse handeln kann, und können daher nicht geordert werden. Das Gleiche gilt für einen konkreten Kontrakt, der seinen Verfall bereits überschritten hat: Der Ticker, der letztes Quartal funktionierte (sagen wir ein alter März-Kontrakt), wird nicht handelbar, sobald dieser Monat abläuft und der Markt zum nächsten Front-Month wechselt." },
    { type: "heading",text: "3. Das Symbol ist kein von Tradovate unterstütztes Futures-Produkt" },
    { type: "paragraph",html: "Tradovate handelt Futures. Ist Ihr Chart auf einem Index (etwa einem Cash-NASDAQ- oder S&amp;P-Index), einem Spot-/Cash-Symbol, einer Aktie oder einem der violett gekennzeichneten synthetischen Ticker von TradingView, gibt es keinen passenden Kontrakt, den Tradovate ausführen könnte, und die Order wird blockiert. Die Symbolsuche von TradingView enthält genau deshalb einen Filter „see all tradable symbols“, damit Sie nichts wählen, was der Broker nicht anbietet." },
    { type: "heading",text: "4. Das TradingView-Add-on oder die Broker-Verbindung ist nicht vollständig aktiviert" },
    { type: "paragraph",html: "Ihr Tradovate-Login mit TradingView zu verknüpfen ist nur Schritt eins. Das Konto benötigt außerdem das eingeschaltete TradingView-Add-on bzw. die Berechtigung, damit die beiden Plattformen ihren Handshake abschließen. Ist dieser Schalter aus oder die Broker-Sitzung abgebrochen, kann TradingView den Chart anzeigen, die Order aber verweigern." },
    { type: "heading",text: "5. Prop-Firm-Evaluierungskonten, bei denen die Firma die Daten kontrolliert" },
    { type: "paragraph",html: "Bei einem Prop-Firm-Evaluierungs- oder Funded-Konto (Apex, Topstep und ähnliche) können Sie Marktdaten in der Regel nicht selbst abonnieren, die Firma stellt sie bereit. Hat die Firma Echtzeitdaten auf Ihrem Evaluierungskonto nicht aktiviert, werden Symbole als verzögert oder nicht handelbar angezeigt, egal was Sie auf Ihrer Seite ändern." },
    { type: "heading",text: "So beheben Sie den Fehler „Non-Tradable Symbol“: Schritt für Schritt" },
    { type: "paragraph",html: "Gehen Sie diese der Reihe nach durch, die meisten Trader sind mit den ersten beiden gelöst." },
    { type: "heading",text: "Lösung 1: Ein Tradovate-Echtzeit-Marktdaten-Abonnement hinzufügen" },
    { type: "paragraph",html: "<ol><li>Melden Sie sich bei der Tradovate-Web-Plattform (nicht bei TradingView) mit demselben Konto an, das Sie verbunden haben.</li><li>Öffnen Sie <strong class='text-white'>Account / Settings</strong> und suchen Sie den Bereich <strong class='text-white'>Market Data Subscriptions</strong>.</li><li>Fügen Sie den Echtzeit-Börsenfeed hinzu, der das Produkt abdeckt, das Sie handeln möchten (für Futures der CME Group wie ES, NQ und ihre Micros ist das das entsprechende CME-Echtzeitpaket).</li><li>Schließen Sie jede Non-Professional-Marktdatenvereinbarung ab, die Tradovate Ihnen anzeigt, eine nicht unterzeichnete Vereinbarung kann Live-Orders ebenfalls blockieren.</li><li>Melden Sie sich bei Tradovate und TradingView ab und wieder an, damit sich die neue Berechtigung verbreitet.</li></ol>" },
    { type: "paragraph",html: "Preise für Datenpakete und Börsengebühren variieren je nach Börse, Tarif und Kontotyp, prüfen Sie daher die aktuellen Marktdaten-Preise von Tradovate, bevor Sie abonnieren. Sobald der Feed live ist, verifiziert Tradovate die Berechtigung gegen Ihr Konto, sodass Sie nicht zusätzlich bei TradingView für dieselben Daten zahlen." },
    { type: "heading",text: "Lösung 2: Zum aktiven Front-Month-Kontrakt wechseln" },
    { type: "paragraph",html: "<ol><li>Öffnen Sie in TradingView die Symbolsuche und geben Sie das Kürzel des Produkts ein (zum Beispiel <code>NQ</code>).</li><li>Meiden Sie den kontinuierlichen Eintrag <code>1!</code>. Wählen Sie stattdessen den datierten Kontrakt im Monats-/Jahresformat, zum Beispiel den aktuellen Quartalskontrakt des NASDAQ, nicht <code>NQ1!</code>.</li><li>Stimmen Sie ihn auf den Kontrakt ab, den Tradovate gerade handelt. Tradovate folgt dem CME-„Globex-Code“-Rollover-Zeitplan, daher wechselt der handelbare Front-Month jedes Quartal.</li><li>Waren Sie auf einem Kontrakt, der kürzlich abgelaufen ist, wählen Sie den neuen Front-Month und aktivieren Sie Ihre Order erneut.</li></ol>" },
    { type: "paragraph",html: "Der Einsatz des aktiven, datierten Kontrakts verwandelt das Order-Ticket von „Non-tradable symbol“ zurück in einen aktiven Kaufen-/Verkaufen-Button." },
    { type: "heading",text: "Lösung 3: TradingView-Add-on und Broker-Verbindung bestätigen" },
    { type: "paragraph",html: "<ol><li>Öffnen Sie in Tradovate den Bereich <strong class='text-white'>Add-ons / Application Settings</strong> und stellen Sie sicher, dass das <strong class='text-white'>TradingView</strong>-Add-on für das Konto aktiviert ist.</li><li>Öffnen Sie in TradingView das <strong class='text-white'>Trading Panel</strong>, bestätigen Sie, dass der Broker als <strong class='text-white'>Tradovate, Connected</strong> angezeigt wird und das richtige Konto ausgewählt ist.</li><li>Wirkt die Verbindung veraltet, trennen Sie den Broker im TradingView-Trading-Panel und verbinden Sie ihn neu, und laden Sie dann den Chart neu.</li><li>Wählen Sie das Symbol erneut aus, damit das Ticket die Berechtigung gegen das frisch verbundene Konto neu prüft.</li></ol>" },
    { type: "paragraph",html: "Ist ein Symbol hier weiterhin blockiert, filtern Sie die Symbolsuche so, dass nur vom Broker handelbare Instrumente angezeigt werden, und wählen Sie aus dieser Liste neu." },
    { type: "heading",text: "Lösung 4: Bei Prop-Konten die Firma bitten, die Daten zu aktivieren" },
    { type: "paragraph",html: "Wenn Sie ein Prop-Firm-Evaluierungs- oder Funded-Tradovate-Konto haben, können Sie Daten in der Regel nicht selbst abonnieren. Wenden Sie sich an den Support Ihrer Firma und bitten Sie darum zu bestätigen, dass Echtzeit-Marktdaten auf Ihrem konkreten Evaluierungskonto aktiviert sind. Bis dahin wird das Symbol weiterhin als verzögert oder nicht handelbar angezeigt, unabhängig davon, was Sie in TradingView oder Tradovate ändern." },
    { type: "heading",text: "Fehlerbehebungstabelle" },
    { type: "table", headers: ["Fehler / Zustand","Bedeutung","Lösung"], rows: [
      ["Meldung „Non-tradable symbol“","Der Ticker kann nicht als Live-Order an Tradovate geroutet werden","Ein Tradovate-Echtzeitdaten-Abonnement hinzufügen und einen beim Broker handelbaren Futures-Kontrakt wählen"],
      ["Chart ist live, aber Order ist blockiert","Datenabonnement wurde bei TradingView gekauft, nicht beim Broker","Den Börsenfeed in Tradovate abonnieren; TradingView-Daten allein routen keine Orders"],
      ["NQ1! / ES1! lässt sich nicht handeln","Kontinuierliche, reine Chart-Serie, kein echter Kontrakt","Stattdessen den datierten Front-Month-Kontrakt (Monats-/Jahrescode) handeln"],
      ["Alter Kontrakt plötzlich nicht handelbar","Der Kontrakt ist abgelaufen und gerollt","Auf den aktuellen Front-Month-Kontrakt vorrollen"],
      ["Index / Spot / Aktie nicht handelbar","Kein Tradovate-Futures-Produkt","Den entsprechenden von Tradovate unterstützten Futures-Kontrakt wählen"],
      ["Symbol nach dem Verbinden blockiert","TradingView-Add-on nicht aktiviert oder Sitzung abgebrochen","Das TradingView-Add-on in Tradovate aktivieren und den Broker neu verbinden"],
      ["Prop-Konto bleibt verzögert","Die Firma hat die Marktdaten nicht bereitgestellt","Die Prop-Firma kontaktieren, damit sie Echtzeitdaten auf dem Evaluierungskonto aktiviert"],
    ] },
    { type: "heading",text: "Mit PickMyTrade vorbeugen" },
    { type: "paragraph",html: "Wenn Ihre Alerts automatisch in Tradovate feuern, sollte ein blockiertes oder falsch eingetragenes Symbol Sie nicht den Trade kosten. PickMyTrade sitzt zwischen TradingView und Tradovate und härtet die Schwachstellen ab, die den Non-Tradable-Symbol-Fehler verursachen:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Symbol- &amp; Kontraktvalidierung</strong>, ordnet Ihren Alert dem live handelbaren Front-Month-Kontrakt zu, damit Orders nicht auf einem kontinuierlichen oder abgelaufenen Ticker landen.",
        "<strong class='text-white'>Berechtigungs- &amp; Datenstatus-Bewusstsein</strong>, berücksichtigt den Marktdaten- und Verbindungsstatus Ihres Kontos, sodass Orders nur geroutet werden, wenn das Konto sie tatsächlich ausführen kann.",
        "<strong class='text-white'>Ratenlimit-sicheres Routing</strong>, taktet den Order-Fluss, damit in schnellen Märkten nichts abprallt.",
        "<strong class='text-white'>Multi-Account-Sync</strong>, spiegelt die korrigierte Order gleichzeitig auf jedes verbundene Tradovate-Konto.",
      ],
    },
  ], es: [
    { type: "paragraph",html: "Tenía una configuración limpia en el gráfico de NQ, pulsó Comprar y TradingView devolvió un mensaje gris <strong class='text-white'>“Non-tradable symbol”</strong> en lugar de una ejecución. Mientras tanto, su plataforma web de Tradovate opera exactamente el mismo instrumento sin problema. Es uno de los puntos de fricción más comunes cuando enruta órdenes desde un gráfico de TradingView a una cuenta de Tradovate conectada, y casi siempre se reduce a tres causas corregibles: una suscripción de datos en tiempo real ausente en el lado de Tradovate, un gráfico apuntando a un contrato continuo o vencido en lugar del vencimiento más próximo activo, o un símbolo que Tradovate simplemente no ofrece para el trading de futuros. Comprar un paquete de datos dentro de TradingView no lo resolverá por sí solo; el derecho tiene que residir en el bróker." },
    {
      type: "checklist",
      heading: "Lista rápida para el error “Non-Tradable Symbol”",
      items: [
        "<strong class='text-white'>Suscríbase a datos en tiempo real dentro de Tradovate</strong>, un paquete de datos comprado solo en TradingView no deja pasar las órdenes.",
        "<strong class='text-white'>Abandone los símbolos continuos</strong>, <code>NQ1!</code>, <code>ES1!</code> y tickers <code>1!</code> similares son solo para gráficos; opere el contrato concreto de mes/año.",
        "<strong class='text-white'>Compruebe que el contrato no haya vencido</strong>, un antiguo vencimiento más próximo deja de ser operable una vez que se rola.",
        "<strong class='text-white'>Opere un producto de futuros compatible con Tradovate</strong>, los índices, los símbolos de contado/cash y los tickers sintéticos no son operables a través del bróker.",
        "<strong class='text-white'>Confirme que el complemento de TradingView esté habilitado</strong> en la cuenta de Tradovate para que las dos plataformas completen el handshake.",
        "<strong class='text-white'>¿Cuenta de prop firm?</strong> Los datos los habilita la firma, no usted; contáctela si las cotizaciones nunca se activan.",
      ],
    },
    { type: "heading",text: "Qué significa “Non-Tradable Symbol”" },
    { type: "paragraph",html: "El aviso <strong class='text-white'>“Non-tradable symbol”</strong> es TradingView diciéndole que el ticker de su gráfico no puede enviarse como orden real al bróker al que está conectado, en este caso Tradovate. El gráfico puede seguir transmitiendo precios y dibujando velas perfectamente, pero dibujar un gráfico y enrutar una orden son dos permisos distintos. TradingView dibujará con gusto un índice sintético, una serie continua de futuros o un contrato vencido para el análisis, pero ninguno de ellos es algo que un bróker de futuros pueda ejecutar." },
    { type: "paragraph",html: "En el caso concreto de Tradovate, el mensaje aparece cuando la cuenta no tiene derecho a colocar una orden real para ese instrumento. El desencadenante más frecuente son los datos. Para operar futuros en Tradovate a través de TradingView necesita una suscripción de datos en tiempo real en la propia plataforma del bróker; si solo compró un paquete de datos dentro de TradingView, no se pueden colocar órdenes. La buena noticia: Tradovate verifica el derecho contra su cuenta real, por lo que no está obligado a pagar dos veces por los mismos datos." },
    { type: "paragraph",html: "El segundo gran desencadenante es el propio símbolo. Tradovate es un bróker de futuros, por lo que solo puede aceptar órdenes de contratos de futuros reales y actualmente listados. Apunte el ticket a cualquier otra cosa, una serie continua de gráfico, un índice o un contrato que ya venció, y TradingView bloquea la orden antes de que salga de su navegador." },
    { type: "heading",text: "Principales causas del error Non-Tradable Symbol" },
    { type: "heading",text: "1. Sin suscripción de datos de mercado en tiempo real de Tradovate" },
    { type: "paragraph",html: "Esta es la causa principal. Tradovate necesita una suscripción activa de datos en tiempo real en la cuenta antes de aceptar órdenes reales para un símbolo. Es fácil suponer que un plan de pago de TradingView o un complemento de datos de TradingView lo cubre, pero no es así. El derecho que desbloquea el enrutamiento de órdenes reside en el bróker, y si su suscripción de datos de Tradovate falta o ha caducado, TradingView marca el símbolo como no operable aunque el gráfico parezca en vivo." },
    { type: "heading",text: "2. Está en un contrato continuo o vencido" },
    { type: "paragraph",html: "Los símbolos continuos de futuros, los que terminan en <code>1!</code> como <code>NQ1!</code> o <code>ES1!</code>, son series de conveniencia que TradingView une para los gráficos. No se corresponden con un único contrato real que la bolsa pueda negociar, por lo que no se pueden ordenar. Lo mismo ocurre con un contrato concreto que ya pasó su vencimiento: el ticker exacto que funcionaba el trimestre pasado (digamos un antiguo contrato de marzo) deja de ser operable una vez que ese mes vence y el mercado pasa al siguiente vencimiento más próximo." },
    { type: "heading",text: "3. El símbolo no es un producto de futuros compatible con Tradovate" },
    { type: "paragraph",html: "Tradovate opera futuros. Si su gráfico está en un índice (como un índice cash NASDAQ o S&amp;P), un símbolo de contado/cash, una acción o uno de los tickers sintéticos con etiqueta morada de TradingView, no hay un contrato equivalente que Tradovate pueda ejecutar, por lo que la orden se bloquea. La búsqueda de símbolos de TradingView incluye un filtro “see all tradable symbols” precisamente para que evite elegir algo que el bróker no ofrece." },
    { type: "heading",text: "4. El complemento de TradingView o el enlace con el bróker no está totalmente habilitado" },
    { type: "paragraph",html: "Vincular su inicio de sesión de Tradovate con TradingView es solo el primer paso. La cuenta también necesita el complemento/derecho de TradingView activado para que las dos plataformas completen su handshake. Si ese interruptor está desactivado, o la sesión del bróker se cayó, TradingView puede mostrar el gráfico pero rechazar la orden." },
    { type: "heading",text: "5. Cuentas de evaluación de prop firm donde la firma controla los datos" },
    { type: "paragraph",html: "En una cuenta de evaluación o fondeada de una prop firm (Apex, Topstep y similares), normalmente no puede suscribirse usted mismo a los datos de mercado: los aprovisiona la firma. Si la firma no ha habilitado los datos en tiempo real en su cuenta de evaluación, los símbolos se muestran retrasados o no operables, haga lo que haga por su parte." },
    { type: "heading",text: "Cómo solucionar el error Non-Tradable Symbol: paso a paso" },
    { type: "paragraph",html: "Recorra estos pasos en orden; a la mayoría de los traders los resuelven los dos primeros." },
    { type: "heading",text: "Solución 1: Añadir una suscripción de datos de mercado en tiempo real de Tradovate" },
    { type: "paragraph",html: "<ol><li>Inicie sesión en la plataforma web de Tradovate (no en TradingView) con la misma cuenta que conectó.</li><li>Abra <strong class='text-white'>Account / Settings</strong> y busque el área <strong class='text-white'>Market Data Subscriptions</strong>.</li><li>Añada el feed de bolsa en tiempo real que cubra el producto que quiere operar (para futuros del grupo CME como ES, NQ y sus micros, es el paquete en tiempo real de CME correspondiente).</li><li>Complete cualquier acuerdo de datos de mercado Non-Professional que Tradovate le presente; un acuerdo sin firmar también puede bloquear las órdenes reales.</li><li>Cierre sesión en Tradovate y en TradingView y vuelva a iniciarla para que el nuevo derecho se propague.</li></ol>" },
    { type: "paragraph",html: "Los precios de los paquetes de datos y las tarifas de bolsa varían según la bolsa, el plan y el tipo de cuenta; consulte las tarifas vigentes de datos de mercado de Tradovate antes de suscribirse. Una vez que el feed está activo, Tradovate verifica el derecho contra su cuenta, por lo que no paga los mismos datos también en TradingView." },
    { type: "heading",text: "Solución 2: Cambiar al contrato de vencimiento más próximo activo" },
    { type: "paragraph",html: "<ol><li>En TradingView, abra la búsqueda de símbolos y escriba la raíz del producto (por ejemplo <code>NQ</code>).</li><li>Evite la entrada continua <code>1!</code>. En su lugar elija el contrato fechado en formato mes/año, por ejemplo el contrato trimestral vigente del NASDAQ, no <code>NQ1!</code>.</li><li>Hágalo coincidir con el contrato que Tradovate está operando actualmente. Tradovate sigue el calendario de rollover de “códigos Globex” del CME, por lo que el vencimiento más próximo operable cambia cada trimestre.</li><li>Si estaba en un contrato que venció recientemente, elija el nuevo vencimiento más próximo y vuelva a armar su orden.</li></ol>" },
    { type: "paragraph",html: "Usar el contrato fechado y activo es lo que convierte el ticket de órdenes de “Non-tradable symbol” de nuevo en un botón activo de Comprar/Vender." },
    { type: "heading",text: "Solución 3: Confirmar el complemento de TradingView y la conexión con el bróker" },
    { type: "paragraph",html: "<ol><li>En Tradovate, abra el área <strong class='text-white'>Add-ons / Application Settings</strong> y asegúrese de que el complemento <strong class='text-white'>TradingView</strong> esté habilitado para la cuenta.</li><li>En TradingView, abra el <strong class='text-white'>Trading Panel</strong>, confirme que el bróker aparece como <strong class='text-white'>Tradovate, Connected</strong> y que está seleccionada la cuenta correcta.</li><li>Si la conexión parece obsoleta, desconecte y vuelva a conectar el bróker desde el panel de trading de TradingView y luego recargue el gráfico.</li><li>Vuelva a seleccionar el símbolo para que el ticket vuelva a comprobar el derecho contra la cuenta recién conectada.</li></ol>" },
    { type: "paragraph",html: "Si un símbolo sigue bloqueado aquí, filtre la búsqueda de símbolos para mostrar solo los instrumentos operables por el bróker y vuelva a elegir de esa lista." },
    { type: "heading",text: "Solución 4: En cuentas prop, pida a la firma que habilite los datos" },
    { type: "paragraph",html: "Si está en una cuenta de Tradovate de evaluación o fondeada de una prop firm, en general no puede suscribirse a los datos usted mismo. Contacte con el soporte de su firma y pídales que confirmen que los datos de mercado en tiempo real están habilitados en su cuenta de evaluación concreta. Hasta que lo hagan, el símbolo seguirá apareciendo como retrasado o no operable, independientemente de lo que cambie en TradingView o en Tradovate." },
    { type: "heading",text: "Tabla de solución de problemas" },
    { type: "table", headers: ["Error / Estado","Significado","Solución"], rows: [
      ["Mensaje “Non-tradable symbol”","El ticker no puede enrutarse como orden real a Tradovate","Añada una suscripción de datos en tiempo real de Tradovate y seleccione un contrato de futuros operable por el bróker"],
      ["El gráfico está en vivo pero la orden está bloqueada","La suscripción de datos se compró en TradingView, no en el bróker","Suscríbase al feed de bolsa dentro de Tradovate; los datos de TradingView por sí solos no enrutan órdenes"],
      ["NQ1! / ES1! no se opera","Serie continua solo de gráfico, no un contrato real","Opere en su lugar el contrato fechado de vencimiento más próximo (código de mes/año)"],
      ["Contrato antiguo de repente no operable","El contrato venció y se rolló","Avance al contrato de vencimiento más próximo actual"],
      ["Índice / spot / acción no operable","No es un producto de futuros de Tradovate","Elija el contrato de futuros equivalente compatible con Tradovate"],
      ["Símbolo bloqueado tras conectar","Complemento de TradingView no habilitado o sesión caída","Habilite el complemento de TradingView en Tradovate y vuelva a conectar el bróker"],
      ["La cuenta prop sigue retrasada","La firma no ha aprovisionado los datos de mercado","Contacte con la prop firm para que habilite los datos en tiempo real en la cuenta de evaluación"],
    ] },
    { type: "heading",text: "Evítelo con PickMyTrade" },
    { type: "paragraph",html: "Cuando sus alertas se disparan automáticamente a Tradovate, un símbolo bloqueado o mal escrito no debería costarle la operación. PickMyTrade se sitúa entre TradingView y Tradovate y refuerza los puntos débiles que causan el error de símbolo no operable:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Validación de símbolo &amp; contrato</strong>, asigna su alerta al contrato de vencimiento más próximo activo y operable para que las órdenes no caigan en un ticker continuo o vencido.",
        "<strong class='text-white'>Conciencia de derechos &amp; estado de datos</strong>, respeta el estado de datos de mercado y de conexión de su cuenta para que las órdenes se enruten solo cuando la cuenta pueda ejecutarlas realmente.",
        "<strong class='text-white'>Enrutamiento seguro frente a límites de tasa</strong>, espacia el flujo de órdenes para que nada rebote en mercados rápidos.",
        "<strong class='text-white'>Sincronización multicuenta</strong>, replica la orden corregida en todas las cuentas de Tradovate conectadas a la vez.",
      ],
    },
  ], fr: [
    { type: "paragraph",html: "Vous aviez un setup propre sur le graphique NQ, vous avez cliqué sur Acheter, et TradingView a renvoyé un message gris <strong class='text-white'>“Non-tradable symbol”</strong> au lieu d'une exécution. Pendant ce temps, votre plateforme web Tradovate trade exactement le même instrument sans accroc. C'est l'un des points de friction les plus courants lorsque vous routez des ordres depuis un graphique TradingView vers un compte Tradovate connecté, et cela se résume presque toujours à trois causes corrigibles : un abonnement aux données en temps réel manquant côté Tradovate, un graphique pointant sur un contrat continu ou expiré plutôt que sur le mois le plus proche actif, ou un symbole que Tradovate ne propose tout simplement pas pour le trading de futures. Acheter un forfait de données dans TradingView ne suffira pas à lui seul ; le droit doit se trouver chez le courtier." },
    {
      type: "checklist",
      heading: "Liste de vérification rapide pour l'erreur « Non-Tradable Symbol »",
      items: [
        "<strong class='text-white'>Abonnez-vous aux données temps réel dans Tradovate</strong>, un forfait de données acheté uniquement sur TradingView ne laisse pas passer les ordres.",
        "<strong class='text-white'>Abandonnez les symboles continus</strong>, <code>NQ1!</code>, <code>ES1!</code> et les tickers <code>1!</code> similaires sont réservés aux graphiques ; tradez le contrat précis mois/année.",
        "<strong class='text-white'>Vérifiez que le contrat n'a pas expiré</strong>, un ancien mois le plus proche cesse d'être négociable une fois roulé.",
        "<strong class='text-white'>Tradez un produit à terme pris en charge par Tradovate</strong>, les indices, les symboles spot/cash et les tickers synthétiques ne sont pas négociables via le courtier.",
        "<strong class='text-white'>Confirmez que le module TradingView est activé</strong> sur le compte Tradovate afin que les deux plateformes complètent le handshake.",
        "<strong class='text-white'>Compte de prop firm ?</strong> Les données sont activées par la firme, pas par vous ; contactez-la si les cotations ne passent jamais en direct.",
      ],
    },
    { type: "heading",text: "Ce que signifie « Non-Tradable Symbol »" },
    { type: "paragraph",html: "L'avis <strong class='text-white'>“Non-tradable symbol”</strong> est TradingView qui vous indique que le ticker de votre graphique ne peut pas être envoyé comme ordre réel au courtier auquel vous êtes connecté, ici Tradovate. Le graphique peut continuer à diffuser les prix et à tracer parfaitement les bougies, mais tracer un graphique et router un ordre sont deux permissions différentes. TradingView tracera volontiers un indice synthétique, une série de futures continue ou un contrat expiré pour l'analyse, mais rien de tout cela n'est exécutable par un courtier de futures." },
    { type: "paragraph",html: "Pour Tradovate en particulier, le message apparaît lorsque le compte n'a pas le droit de passer un ordre réel sur cet instrument. Le déclencheur le plus fréquent est la donnée. Pour trader des futures sur Tradovate via TradingView, il vous faut un abonnement aux données en temps réel sur la plateforme du courtier elle-même ; si vous n'avez acheté qu'un forfait de données dans TradingView, les ordres ne peuvent pas être passés. La bonne nouvelle : Tradovate vérifie le droit sur votre compte réel, vous n'êtes donc pas obligé de payer deux fois les mêmes données." },
    { type: "paragraph",html: "Le second grand déclencheur est le symbole lui-même. Tradovate est un courtier de futures : il ne peut accepter que des ordres sur de vrais contrats à terme actuellement cotés. Si vous pointez le ticket sur autre chose, une série continue de graphique, un indice ou un contrat déjà expiré, TradingView bloque l'ordre avant même qu'il ne quitte votre navigateur." },
    { type: "heading",text: "Principales causes de l'erreur Non-Tradable Symbol" },
    { type: "heading",text: "1. Pas d'abonnement Tradovate aux données de marché en temps réel" },
    { type: "paragraph",html: "C'est la cause principale. Tradovate a besoin d'un abonnement actif aux données temps réel sur le compte avant d'accepter des ordres réels sur un symbole. Il est facile de croire qu'un forfait TradingView payant ou un module de données TradingView suffit ; ce n'est pas le cas. Le droit qui débloque le routage des ordres se trouve chez le courtier, et si votre abonnement aux données Tradovate est absent ou a expiré, TradingView marque le symbole comme non négociable même si le graphique semble en direct." },
    { type: "heading",text: "2. Vous êtes sur un contrat continu ou expiré" },
    { type: "paragraph",html: "Les symboles de futures continus, ceux qui se terminent par <code>1!</code> comme <code>NQ1!</code> ou <code>ES1!</code>, sont des séries de commodité que TradingView assemble pour les graphiques. Ils ne correspondent pas à un contrat réel unique que la bourse peut négocier, et ne peuvent donc pas être ordonnés. Même histoire pour un contrat précis qui a déjà dépassé son expiration : le ticker exact qui fonctionnait le trimestre dernier (disons un ancien contrat de mars) devient non négociable une fois que ce mois expire et que le marché passe au mois le plus proche suivant." },
    { type: "heading",text: "3. Le symbole n'est pas un produit à terme pris en charge par Tradovate" },
    { type: "paragraph",html: "Tradovate négocie des futures. Si votre graphique est sur un indice (comme un indice cash NASDAQ ou S&amp;P), un symbole spot/cash, une action ou l'un des tickers synthétiques à étiquette violette de TradingView, il n'existe aucun contrat correspondant que Tradovate puisse exécuter, et l'ordre est bloqué. La recherche de symboles de TradingView comprend un filtre « see all tradable symbols » précisément pour vous éviter de choisir quelque chose que le courtier ne propose pas." },
    { type: "heading",text: "4. Le module TradingView ou la liaison avec le courtier n'est pas entièrement activé" },
    { type: "paragraph",html: "Lier votre identifiant Tradovate à TradingView n'est que la première étape. Le compte a aussi besoin du module/droit TradingView activé pour que les deux plateformes complètent leur handshake. Si cet interrupteur est désactivé, ou si la session du courtier a décroché, TradingView peut afficher le graphique mais refuser l'ordre." },
    { type: "heading",text: "5. Comptes d'évaluation de prop firm où la firme contrôle les données" },
    { type: "paragraph",html: "Sur un compte d'évaluation ou financé d'une prop firm (Apex, Topstep et similaires), vous ne pouvez généralement pas vous abonner vous-même aux données de marché : c'est la firme qui les provisionne. Si la firme n'a pas activé les données temps réel sur votre compte d'évaluation, les symboles s'affichent retardés ou non négociables, quoi que vous changiez de votre côté." },
    { type: "heading",text: "Comment corriger l'erreur Non-Tradable Symbol : étape par étape" },
    { type: "paragraph",html: "Parcourez-les dans l'ordre ; la plupart des traders sont dépannés par les deux premières." },
    { type: "heading",text: "Correction 1 : Ajouter un abonnement Tradovate aux données de marché en temps réel" },
    { type: "paragraph",html: "<ol><li>Connectez-vous à la plateforme web Tradovate (et non à TradingView) avec le même compte que vous avez connecté.</li><li>Ouvrez <strong class='text-white'>Account / Settings</strong> et trouvez la zone <strong class='text-white'>Market Data Subscriptions</strong>.</li><li>Ajoutez le flux de bourse temps réel couvrant le produit que vous voulez trader (pour les futures du groupe CME comme ES, NQ et leurs micros, il s'agit du forfait temps réel CME correspondant).</li><li>Remplissez tout accord de données de marché Non-Professional que Tradovate vous présente ; un accord non signé peut aussi bloquer les ordres réels.</li><li>Déconnectez-vous de Tradovate et de TradingView, puis reconnectez-vous afin que le nouveau droit se propage.</li></ol>" },
    { type: "paragraph",html: "Les tarifs des forfaits de données et les frais de bourse varient selon la bourse, le forfait et le type de compte ; consultez les tarifs actuels des données de marché de Tradovate avant de vous abonner. Une fois le flux en direct, Tradovate vérifie le droit sur votre compte, vous ne payez donc pas les mêmes données en plus sur TradingView." },
    { type: "heading",text: "Correction 2 : Passer au contrat actif du mois le plus proche" },
    { type: "paragraph",html: "<ol><li>Dans TradingView, ouvrez la recherche de symboles et saisissez la racine du produit (par exemple <code>NQ</code>).</li><li>Évitez l'entrée continue <code>1!</code>. Choisissez plutôt le contrat daté au format mois/année, par exemple le contrat trimestriel NASDAQ en cours, et non <code>NQ1!</code>.</li><li>Faites-le correspondre au contrat que Tradovate négocie actuellement. Tradovate suit le calendrier de rollover des « codes Globex » du CME ; le mois le plus proche négociable change donc chaque trimestre.</li><li>Si vous étiez sur un contrat récemment expiré, choisissez le nouveau mois le plus proche et réarmez votre ordre.</li></ol>" },
    { type: "paragraph",html: "Utiliser le contrat daté et actif est ce qui fait repasser le ticket d'ordre de « Non-tradable symbol » à un bouton Acheter/Vendre actif." },
    { type: "heading",text: "Correction 3 : Confirmer le module TradingView et la connexion au courtier" },
    { type: "paragraph",html: "<ol><li>Dans Tradovate, ouvrez la zone <strong class='text-white'>Add-ons / Application Settings</strong> et assurez-vous que le module <strong class='text-white'>TradingView</strong> est activé pour le compte.</li><li>Dans TradingView, ouvrez le <strong class='text-white'>Trading Panel</strong>, confirmez que le courtier apparaît comme <strong class='text-white'>Tradovate, Connected</strong> et que le bon compte est sélectionné.</li><li>Si la connexion semble périmée, déconnectez puis reconnectez le courtier depuis le panneau de trading de TradingView, puis rechargez le graphique.</li><li>Resélectionnez le symbole pour que le ticket revérifie le droit sur le compte fraîchement connecté.</li></ol>" },
    { type: "paragraph",html: "Si un symbole reste bloqué ici, filtrez la recherche de symboles pour n'afficher que les instruments négociables par le courtier et resélectionnez dans cette liste." },
    { type: "heading",text: "Correction 4 : Pour les comptes prop, demander à la firme d'activer les données" },
    { type: "paragraph",html: "Si vous êtes sur un compte Tradovate d'évaluation ou financé d'une prop firm, vous ne pouvez généralement pas vous abonner vous-même aux données. Contactez le support de votre firme et demandez-lui de confirmer que les données de marché en temps réel sont activées sur votre compte d'évaluation précis. Tant qu'elle ne l'aura pas fait, le symbole continuera d'apparaître retardé ou non négociable, quoi que vous changiez dans TradingView ou Tradovate." },
    { type: "heading",text: "Tableau de dépannage" },
    { type: "table", headers: ["Erreur / État","Signification","Solution"], rows: [
