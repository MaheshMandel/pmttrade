---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "risk-settings-crash-locked-out";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/debugging/${SLUG}`;

const META_TITLE = "Tradovate Risk Settings Crash Blocks Live Trading";
const META_DESCRIPTION =
  "Locked out of your live Tradovate account by a Risk Settings glitch or loss limit? Review, reset, and clear the lockout so you can trade again fast.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Absturz der Tradovate-Risikoeinstellungen blockiert den Live-Handel", es: "El fallo de los ajustes de riesgo de Tradovate bloquea el trading en vivo", fr: "Le plantage des paramètres de risque Tradovate bloque le trading en direct", it: "Il crash delle impostazioni di rischio di Tradovate blocca il trading live" },
  dek: { en: "Every order ticket bounces and your position closed on its own. Most of the time it isn't a crash, it's a Risk Setting doing exactly what you told it to. Here's how to tell the two apart and clear it.", de: "Jedes Order-Ticket wird abgelehnt und Ihre Position wurde von selbst geschlossen. Meist ist es kein Absturz, sondern eine Risk Setting, die genau das tut, was Sie ihr aufgetragen haben. So unterscheiden Sie beides und heben die Sperre auf.", es: "Todos los tickets de orden son rechazados y su posición se cerró sola. La mayoría de las veces no es un fallo, es un Risk Setting haciendo exactamente lo que usted le indicó. Aquí le explicamos cómo distinguirlo y resolverlo.", fr: "Chaque ticket d'ordre est rejeté et votre position s'est fermée toute seule. La plupart du temps, ce n'est pas un plantage, c'est un Risk Setting qui fait exactement ce que vous lui avez demandé. Voici comment les distinguer et lever le blocage.", it: "Ogni ticket d'ordine viene rifiutato e la Sua posizione si è chiusa da sola. Nella maggior parte dei casi non è un crash, è un Risk Setting che fa esattamente ciò che Lei gli ha detto di fare. Ecco come distinguere i due casi e sbloccare il conto." },
  readTime: { en: "7 min read", de: "7 Min. Lesezeit", es: "Lectura de 7 min", fr: "Lecture : 7 min", it: "Lettura di 7 min" },
  lastUpdated: "2026-07-10",
  blocks: { en: [
    { type: "paragraph", html: "You switched to Tradovate partly for the built-in risk controls, and now those same controls have your live account frozen. Every order ticket bounces, your position closed on its own, and the daily reset that should unlock you at the session roll never fired. It feels like the platform crashed. Most of the time it isn't a crash at all, it's a Risk Setting doing exactly what you told it to, and you can clear it in a couple of minutes. Once in a while it really is a platform glitch, and the fix is different. Here's how to tell the two apart, reset your Risk Settings the right way, and get support to release the account if it's genuinely stuck." },
    {
      type: "checklist",
      heading: "Quick Checklist",
      items: [
        "<strong class='text-white'>Open your Risk Settings first.</strong> From Application Settings (top-right of the platform), open Risk Settings and check every limit on the locked account.",
        "<strong class='text-white'>Look for a hit loss limit or profit trigger.</strong> A reached Daily/Weekly Loss Limit or profit target liquidates you and locks new entries until the next session.",
        "<strong class='text-white'>Check for a value saved at $0.</strong> Any risk field left at zero reads as &ldquo;already breached&rdquo; and force-liquidates the account.",
        "<strong class='text-white'>Reset on a self-funded account.</strong> Raise, clear, or toggle off the parameter that tripped, then save, to reopen the current session early.",
        "<strong class='text-white'>Prop or evaluation account?</strong> You can't edit the limits. Contact your prop firm, not Tradovate.",
        "<strong class='text-white'>Reset didn't fire or panel won't load?</strong> That's the rare real &ldquo;crash.&rdquo; Sign out and back in, confirm the save, then contact Tradovate support to clear the state.",
      ],
    },
    { type: "heading", text: "What a “Risk Settings Crash” Usually Means" },
    { type: "paragraph", html: "Tradovate's account-level Risk Settings let you set a Daily Loss Limit, a Weekly Loss Limit, a Trailing Max Drawdown, and daily or weekly profit triggers. When any one of those thresholds is reached, the platform sends a market order to flatten your open positions, cancels your working orders, and drops the account into <strong class='text-white'>Liquidation-Only</strong> mode. In that state you can reduce or close exposure but you can't open anything new, so every fresh order ticket gets rejected. To someone who forgot a limit was set, that looks identical to the platform breaking." },
    { type: "paragraph", html: "Two things make it feel like a crash instead of a rule. First, timing: you get liquidated mid-strategy and lose the rest of the session. Second, the reset. A daily lockout should clear at the next session and a weekly one at the start of the next week, so when that reset appears not to happen, the account seems permanently broken. Real glitches where the reset stalls or the panel won't load do happen, but they're rare, so rule out the ordinary causes first." },
    { type: "heading", text: "Top Causes, From Most to Least Likely" },
    { type: "heading", text: "1. A Daily or Weekly Loss Limit Was Reached" },
    { type: "paragraph", html: "This is the number-one reason a &ldquo;risk&rdquo; lockout shows up. Your net loss for the day, fees included, touched the Daily Loss Limit, or your loss across the week hit the Weekly Loss Limit. Tradovate flattens the position and locks new entries. A daily limit reopens at <strong class='text-white'>5:00 PM Central Time the same day</strong>; a weekly one stays locked until <strong class='text-white'>5:00 PM Central Time on Sunday</strong>. If you assume a weekly limit resets overnight, you'll be convinced the platform is stuck when it's actually just waiting for the week to roll." },
    { type: "heading", text: "2. A Profit Trigger Fired" },
    { type: "paragraph", html: "Profit targets work like loss limits in reverse. If you set a Daily or Weekly Profit Trigger and reached it, the account liquidates to lock the gain and goes Liquidation-Only until the next reset. When you were up money and got closed out, this is almost always why, and it reads as a bug even though the setting did its job." },
    { type: "heading", text: "3. A Risk Value Accidentally Saved at $0" },
    { type: "paragraph", html: "This one traps people who are configuring limits for the first time. If you toggle a risk parameter on but leave the value at <strong class='text-white'>$0</strong> and save, the platform reads it as a limit that's already been breached. It liquidates your open positions and cancels your orders on the spot. Nothing crashed, but the effect is instant and total, and it will keep re-liquidating until you disable that field or set it above zero." },
    { type: "heading", text: "4. The Daily Reset Didn't Fire (the Real Glitch)" },
    { type: "paragraph", html: "Here's the genuine platform-side case. The account is locked from a daily limit, the session rolls past 5:00 PM CT, and the reset never happens, so you stay frozen into the next day even though your limits look correct. This isn't documented behavior, it's a defect, and it's the actual &ldquo;risk settings crash&rdquo; scenario rather than a misread setting. When the ordinary causes are ruled out and the account is still locked after a reset should have occurred, this is what you're dealing with, and support has to release it." },
    { type: "heading", text: "5. The Risk Settings Panel Won't Load or Save" },
    { type: "paragraph", html: "Sometimes the panel itself is the problem: it hangs on load, won't expand the account's detail section, or accepts a change that silently fails to save. A stale session or a browser/app hiccup causes most of these. The danger is thinking you cleared a limit when the save never landed, so the account keeps behaving as locked. Always confirm the new value is showing after you save." },
    { type: "heading", text: "6. Prop or Evaluation Account Rules" },
    { type: "paragraph", html: "On a prop-firm evaluation or funded account, the risk parameters are set and locked by the firm, not by you. Tradovate's own Risk Settings don't apply to those accounts, and the specific loss and drawdown numbers vary by firm and account size, so check your firm's current rules. When a firm-defined rule trips, only the provider can adjust or reset it." },
    { type: "heading", text: "How to Fix It, Step by Step" },
    { type: "heading", text: "Step 1: Review the Risk Settings on the Locked Account" },
    { type: "paragraph", html: "Before you change anything, see what actually tripped. Open <strong class='text-white'>Application Settings</strong> from the top-right of the platform and open <strong class='text-white'>Risk Settings</strong> (on some builds you reach the same panel from the <strong class='text-white'>Accounts</strong> tab by clicking the account's Risk Settings button to expand its detail section). Confirm you're looking at the exact account that's locked, then read each field: Daily Loss Limit, Weekly Loss Limit, Trailing Max Drawdown, and any profit triggers. You're looking for the one that your current P&amp;L has crossed, or any field sitting at $0." },
    { type: "heading", text: "Step 2: Reset the Parameter (Self-Funded Live or Demo)" },
    { type: "paragraph", html: "On a self-funded Tradovate account you own these settings and can lift the lock without waiting for the session roll." },
    {
      type: "steps",
      items: [
        { title: "Find the tripped parameter", html: "Find the parameter that was reached or the field left at $0." },
        { title: "Raise, clear, or toggle it off", html: "Raise the value, clear it, or toggle the parameter off so your current session P&amp;L sits comfortably inside the new threshold." },
        { title: "Save the change", html: "Scroll down and <strong class='text-white'>save</strong>. Don't skip this, an unsaved change does nothing." },
        { title: "Confirm the new value shows", html: "Reopen the panel and confirm the new value is actually displayed, proving the save landed." },
        { title: "Go back to your order ticket", html: "Go back to your order ticket. You should be able to open positions again for the current session." },
      ],
    },
    { type: "paragraph", html: "Prefer not to touch your discipline rules? Just wait it out. A daily lock clears at <strong class='text-white'>5:00 PM CT the same day</strong> and a weekly lock at <strong class='text-white'>5:00 PM CT Sunday</strong>, with no action needed." },
    { type: "heading", text: "Step 3: If the Panel Won't Load or the Save Won't Stick" },
    { type: "paragraph", html: "When the panel hangs or a change won't save, refresh the session first. Sign out completely, close the tab or desktop app, sign back in, and reopen Risk Settings. On web, a hard refresh or clearing the site cache can shake loose a stale panel. Make your change again and verify it displays. That clears most &ldquo;the panel is broken&rdquo; reports without support ever getting involved." },
    { type: "heading", text: "Step 4: If the Reset Never Fired, Contact Support" },
    { type: "paragraph", html: "If you've confirmed your limits are correct, nothing is at $0, you edited the right account, and the account is <em>still</em> in Liquidation-Only after the session should have reset, you're in genuine-glitch territory. Don't keep firing rejected orders, they won't go through and they just clutter your logs. Contact Tradovate support directly, tell them the daily reset didn't fire and the account is stuck, and give them the account name and the time the reset should have fired so they can release the state. If you're on a prop or evaluation account, contact your <strong class='text-white'>prop firm's</strong> support instead, since they administer the risk rules and Tradovate can't change firm-locked parameters (with the narrow exception of Trailing Max Drawdown, handled through the orders desk)." },
    { type: "heading", text: "Troubleshooting Table" },
    {
      type: "table",
      headers: ["What you're seeing", "Most likely cause", "Fix"],
      rows: [
        ["Position closed itself, new orders rejected", "A Daily/Weekly Loss Limit was reached", "Wait for the session/week reset, or raise/clear the limit on a self-funded account"],
        ["Account closed while you were in profit", "A profit trigger fired", "Disable the profit trigger if you don't want the auto-flatten"],
        ["Instant liquidation right after configuring limits", "A risk field saved at $0", "Disable that field or set it above zero, then save"],
        ["Still locked after the session should have reset", "Daily reset didn't fire (platform glitch)", "Confirm settings and account, sign out/in, then contact support to release it"],
        ["Panel hangs or a change won't save", "Stale session or app/browser hiccup", "Sign out and back in, hard-refresh, re-save, and confirm the value shows"],
        ["Can't edit the limits at all", "Prop/evaluation account, firm-locked", "Contact your prop firm; Tradovate can't override firm rules"],
      ],
    },
    { type: "heading", text: "Stop the Lockout Before It Happens, With PickMyTrade" },
    { type: "paragraph", html: "A risk lockout is usually a timing problem, not a settings problem. You breach the limit mid-strategy and lose the rest of the day. PickMyTrade links your TradingView alerts straight to Tradovate and adds a risk-aware layer on top of your account, so you control the order flow before the platform ever has to liquidate you:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Daily-loss guardrails in your automation logic</strong> so new entries stop going out before your account trips its hard limit and flips to Liquidation-Only.",
        "<strong class='text-white'>Profit-target awareness</strong> that pauses new alerts once your session goal is met, instead of an auto-flatten at an inconvenient fill.",
        "<strong class='text-white'>Rejection-safe routing</strong> so that when the account is already locked, you're not blindly hammering rejected orders into your logs, you route cleanly on the next valid session.",
        "<strong class='text-white'>Multi-account sync</strong> to apply the same guardrails across every connected Tradovate account at once, so one account's limit doesn't quietly drift out of line with the rest.",
      ],
    },
  ], de: [
    { type: "paragraph",html: "Sie sind teilweise wegen der eingebauten Risikokontrollen zu Tradovate gewechselt, und nun haben genau diese Kontrollen Ihr Live-Konto eingefroren. Jedes Order-Ticket wird abgelehnt, Ihre Position wurde von selbst geschlossen, und der tägliche Reset, der Sie beim Sitzungswechsel freischalten sollte, ist nie erfolgt. Es fühlt sich an, als wäre die Plattform abgestürzt. Meist ist es überhaupt kein Absturz, sondern eine Risk Setting, die genau das tut, was Sie ihr aufgetragen haben, und Sie können sie in ein paar Minuten aufheben. Gelegentlich ist es tatsächlich ein Plattformfehler, und dann sieht die Lösung anders aus. So unterscheiden Sie beides, setzen Ihre Risk Settings richtig zurück und bringen den Support dazu, das Konto freizugeben, falls es wirklich feststeckt." },
    {
      type: "checklist",
      heading: "Kurze Checkliste",
      items: [
        "<strong class='text-white'>Öffnen Sie zuerst Ihre Risk Settings.</strong> Öffnen Sie unter Application Settings (oben rechts in der Plattform) die Risk Settings und prüfen Sie jedes Limit des gesperrten Kontos.",
        "<strong class='text-white'>Suchen Sie nach einem erreichten Verlustlimit oder Gewinn-Trigger.</strong> Ein erreichtes Daily/Weekly Loss Limit oder Gewinnziel liquidiert Sie und sperrt neue Einstiege bis zur nächsten Sitzung.",
        "<strong class='text-white'>Prüfen Sie auf einen mit $0 gespeicherten Wert.</strong> Jedes Risikofeld, das auf null belassen wurde, gilt als &ldquo;bereits verletzt&rdquo; und liquidiert das Konto zwangsweise.",
        "<strong class='text-white'>Setzen Sie bei einem selbstfinanzierten Konto zurück.</strong> Erhöhen, löschen oder deaktivieren Sie den ausgelösten Parameter und speichern Sie, um die aktuelle Sitzung früher wieder zu öffnen.",
        "<strong class='text-white'>Prop- oder Evaluierungskonto?</strong> Sie können die Limits nicht bearbeiten. Wenden Sie sich an Ihre Prop-Firma, nicht an Tradovate.",
        "<strong class='text-white'>Reset nicht erfolgt oder Panel lädt nicht?</strong> Das ist der seltene echte &ldquo;Absturz&rdquo;. Melden Sie sich ab und wieder an, bestätigen Sie das Speichern und wenden Sie sich dann an den Tradovate-Support, um den Status zu bereinigen.",
      ],
    },
    { type: "heading",text: "Was ein „Absturz der Risk Settings“ meist bedeutet" },
    { type: "paragraph",html: "Mit den Risk Settings auf Kontoebene von Tradovate können Sie ein Daily Loss Limit, ein Weekly Loss Limit, einen Trailing Max Drawdown sowie tägliche oder wöchentliche Gewinn-Trigger festlegen. Wird eine dieser Schwellen erreicht, sendet die Plattform eine Market-Order, um Ihre offenen Positionen glattzustellen, storniert Ihre laufenden Orders und versetzt das Konto in den <strong class='text-white'>Liquidation-Only</strong>-Modus. In diesem Zustand können Sie Exposure reduzieren oder schließen, aber nichts Neues eröffnen, sodass jedes neue Order-Ticket abgelehnt wird. Für jemanden, der ein gesetztes Limit vergessen hat, sieht das genauso aus wie eine defekte Plattform." },
    { type: "paragraph",html: "Zwei Dinge lassen es wie einen Absturz statt wie eine Regel wirken. Erstens das Timing: Sie werden mitten in der Strategie liquidiert und verlieren den Rest der Sitzung. Zweitens der Reset. Eine tägliche Sperre sollte sich bei der nächsten Sitzung und eine wöchentliche zu Beginn der nächsten Woche aufheben; wenn dieser Reset scheinbar ausbleibt, wirkt das Konto dauerhaft defekt. Echte Fehler, bei denen der Reset hängt oder das Panel nicht lädt, kommen vor, sind aber selten – schließen Sie daher zuerst die gewöhnlichen Ursachen aus." },
    { type: "heading",text: "Häufigste Ursachen, von der wahrscheinlichsten bis zur unwahrscheinlichsten" },
    { type: "heading",text: "1. Ein Daily oder Weekly Loss Limit wurde erreicht" },
    { type: "paragraph",html: "Dies ist der häufigste Grund für eine &ldquo;Risiko&rdquo;-Sperre. Ihr Nettoverlust für den Tag, einschließlich Gebühren, hat das Daily Loss Limit berührt, oder Ihr Wochenverlust hat das Weekly Loss Limit erreicht. Tradovate stellt die Position glatt und sperrt neue Einstiege. Ein Tageslimit öffnet sich <strong class='text-white'>am selben Tag um 5:00 PM Central Time</strong> wieder; ein Wochenlimit bleibt bis <strong class='text-white'>Sonntag 5:00 PM Central Time</strong> gesperrt. Wenn Sie annehmen, ein Wochenlimit werde über Nacht zurückgesetzt, sind Sie überzeugt, die Plattform hänge, obwohl sie nur auf den Wochenwechsel wartet." },
    { type: "heading",text: "2. Ein Gewinn-Trigger wurde ausgelöst" },
    { type: "paragraph",html: "Gewinnziele funktionieren wie Verlustlimits in umgekehrter Richtung. Wenn Sie einen Daily oder Weekly Profit Trigger gesetzt und erreicht haben, liquidiert das Konto, um den Gewinn zu sichern, und geht bis zum nächsten Reset in Liquidation-Only. Wenn Sie im Plus waren und ausgestoppt wurden, ist dies fast immer der Grund – und es wirkt wie ein Fehler, obwohl die Einstellung ihren Zweck erfüllt hat." },
    { type: "heading",text: "3. Ein Risikowert wurde versehentlich mit $0 gespeichert" },
    { type: "paragraph",html: "Das ist eine Falle für alle, die Limits zum ersten Mal konfigurieren. Wenn Sie einen Risikoparameter aktivieren, den Wert aber auf <strong class='text-white'>$0</strong> belassen und speichern, wertet die Plattform dies als bereits verletztes Limit. Sie liquidiert Ihre offenen Positionen und storniert Ihre Orders auf der Stelle. Nichts ist abgestürzt, aber die Wirkung ist sofort und vollständig, und sie liquidiert immer wieder neu, bis Sie dieses Feld deaktivieren oder über null setzen." },
    { type: "heading",text: "4. Der tägliche Reset ist nicht erfolgt (der echte Fehler)" },
    { type: "paragraph",html: "Hier liegt der echte plattformseitige Fall. Das Konto ist wegen eines Tageslimits gesperrt, die Sitzung läuft über 5:00 PM CT hinaus, und der Reset findet nie statt, sodass Sie bis in den nächsten Tag eingefroren bleiben, obwohl Ihre Limits korrekt aussehen. Das ist kein dokumentiertes Verhalten, sondern ein Defekt – und es ist das eigentliche &ldquo;Risk-Settings-Absturz&rdquo;-Szenario statt einer falsch gelesenen Einstellung. Wenn die gewöhnlichen Ursachen ausgeschlossen sind und das Konto auch nach dem Zeitpunkt, an dem ein Reset hätte erfolgen müssen, noch gesperrt ist, haben Sie es damit zu tun, und der Support muss es freigeben." },
    { type: "heading",text: "5. Das Risk-Settings-Panel lädt oder speichert nicht" },
    { type: "paragraph",html: "Manchmal ist das Panel selbst das Problem: Es hängt beim Laden, klappt den Detailbereich des Kontos nicht auf oder akzeptiert eine Änderung, die stillschweigend nicht gespeichert wird. Eine veraltete Sitzung oder ein Browser-/App-Aussetzer verursacht die meisten davon. Die Gefahr besteht darin zu glauben, Sie hätten ein Limit aufgehoben, obwohl das Speichern nie angekommen ist, sodass sich das Konto weiter wie gesperrt verhält. Bestätigen Sie nach dem Speichern immer, dass der neue Wert angezeigt wird." },
    { type: "heading",text: "6. Regeln für Prop- oder Evaluierungskonten" },
    { type: "paragraph",html: "Bei einem Evaluierungs- oder finanzierten Konto einer Prop-Firma werden die Risikoparameter von der Firma festgelegt und gesperrt, nicht von Ihnen. Die eigenen Risk Settings von Tradovate gelten für diese Konten nicht, und die konkreten Verlust- und Drawdown-Zahlen variieren je nach Firma und Kontogröße, prüfen Sie daher die aktuellen Regeln Ihrer Firma. Wird eine von der Firma definierte Regel ausgelöst, kann nur der Anbieter sie anpassen oder zurücksetzen." },
    { type: "heading",text: "So beheben Sie es, Schritt für Schritt" },
    { type: "heading",text: "Schritt 1: Die Risk Settings des gesperrten Kontos prüfen" },
    { type: "paragraph",html: "Bevor Sie etwas ändern, sehen Sie nach, was tatsächlich ausgelöst wurde. Öffnen Sie <strong class='text-white'>Application Settings</strong> oben rechts in der Plattform und öffnen Sie <strong class='text-white'>Risk Settings</strong> (bei manchen Versionen erreichen Sie dasselbe Panel über den Tab <strong class='text-white'>Accounts</strong>, indem Sie auf die Schaltfläche Risk Settings des Kontos klicken, um dessen Detailbereich aufzuklappen). Vergewissern Sie sich, dass Sie genau das gesperrte Konto betrachten, und lesen Sie dann jedes Feld: Daily Loss Limit, Weekly Loss Limit, Trailing Max Drawdown und alle Gewinn-Trigger. Sie suchen das Feld, das Ihr aktueller G&amp;V überschritten hat, oder jedes Feld, das auf $0 steht." },
    { type: "heading",text: "Schritt 2: Den Parameter zurücksetzen (selbstfinanziertes Live- oder Demokonto)" },
    { type: "paragraph",html: "Bei einem selbstfinanzierten Tradovate-Konto gehören Ihnen diese Einstellungen, und Sie können die Sperre aufheben, ohne den Sitzungswechsel abzuwarten." },
    {
      type: "steps",
      items: [
        { title: "Den ausgelösten Parameter finden", html: "Finden Sie den Parameter, der erreicht wurde, oder das auf $0 belassene Feld." },
        { title: "Erhöhen, löschen oder ausschalten", html: "Erhöhen Sie den Wert, löschen Sie ihn oder schalten Sie den Parameter aus, sodass Ihr aktueller Sitzungs-G&amp;V komfortabel innerhalb der neuen Schwelle liegt." },
        { title: "Die Änderung speichern", html: "Scrollen Sie nach unten und <strong class='text-white'>speichern</strong> Sie. Überspringen Sie das nicht – eine nicht gespeicherte Änderung bewirkt nichts." },
        { title: "Bestätigen, dass der neue Wert angezeigt wird", html: "Öffnen Sie das Panel erneut und bestätigen Sie, dass der neue Wert tatsächlich angezeigt wird – das belegt, dass das Speichern angekommen ist." },
        { title: "Zurück zum Order-Ticket", html: "Gehen Sie zurück zu Ihrem Order-Ticket. Sie sollten in der aktuellen Sitzung wieder Positionen eröffnen können." },
      ],
    },
    { type: "paragraph",html: "Möchten Sie Ihre Disziplinregeln lieber nicht anfassen? Warten Sie es einfach ab. Eine Tagessperre wird <strong class='text-white'>am selben Tag um 5:00 PM CT</strong> und eine Wochensperre <strong class='text-white'>Sonntag um 5:00 PM CT</strong> aufgehoben, ganz ohne Eingriff." },
    { type: "heading",text: "Schritt 3: Wenn das Panel nicht lädt oder das Speichern nicht hält" },
    { type: "paragraph",html: "Wenn das Panel hängt oder eine Änderung nicht gespeichert wird, aktualisieren Sie zuerst die Sitzung. Melden Sie sich vollständig ab, schließen Sie den Tab oder die Desktop-App, melden Sie sich wieder an und öffnen Sie die Risk Settings erneut. Im Web kann eine harte Aktualisierung oder das Leeren des Seiten-Caches ein veraltetes Panel lösen. Nehmen Sie Ihre Änderung erneut vor und prüfen Sie, dass sie angezeigt wird. Damit erledigen sich die meisten Meldungen &ldquo;das Panel ist defekt&rdquo;, ohne dass je der Support eingeschaltet werden muss." },
    { type: "heading",text: "Schritt 4: Wenn der Reset nie erfolgte, den Support kontaktieren" },
    { type: "paragraph",html: "Wenn Sie bestätigt haben, dass Ihre Limits korrekt sind, nichts auf $0 steht, Sie das richtige Konto bearbeitet haben und das Konto nach dem Zeitpunkt, an dem die Sitzung hätte zurückgesetzt werden müssen, <em>immer noch</em> in Liquidation-Only ist, befinden Sie sich im Bereich eines echten Fehlers. Feuern Sie nicht weiter abgelehnte Orders ab, sie werden nicht durchgehen und füllen nur Ihre Logs. Wenden Sie sich direkt an den Tradovate-Support, teilen Sie mit, dass der tägliche Reset nicht erfolgt ist und das Konto feststeckt, und nennen Sie den Kontonamen und den Zeitpunkt, an dem der Reset hätte erfolgen müssen, damit der Status freigegeben werden kann. Wenn Sie ein Prop- oder Evaluierungskonto haben, wenden Sie sich stattdessen an den Support Ihrer <strong class='text-white'>Prop-Firma</strong>, da diese die Risikoregeln verwaltet und Tradovate von der Firma gesperrte Parameter nicht ändern kann (mit der engen Ausnahme des Trailing Max Drawdown, der über den Orders Desk abgewickelt wird)." },
    { type: "heading",text: "Fehlerbehebungstabelle" },
    { type: "table", headers: ["Was Sie sehen","Wahrscheinlichste Ursache","Lösung"], rows: [
      ["Position hat sich selbst geschlossen, neue Orders werden abgelehnt","Ein Daily/Weekly Loss Limit wurde erreicht","Sitzungs-/Wochen-Reset abwarten oder das Limit bei einem selbstfinanzierten Konto erhöhen/löschen"],
      ["Konto wurde im Gewinn geschlossen","Ein Gewinn-Trigger wurde ausgelöst","Den Gewinn-Trigger deaktivieren, wenn Sie das automatische Glattstellen nicht wollen"],
      ["Sofortige Liquidation direkt nach dem Konfigurieren von Limits","Ein Risikofeld wurde mit $0 gespeichert","Dieses Feld deaktivieren oder über null setzen, dann speichern"],
      ["Noch gesperrt, obwohl die Sitzung hätte zurückgesetzt werden müssen","Täglicher Reset nicht erfolgt (Plattformfehler)","Einstellungen und Konto prüfen, ab-/anmelden, dann den Support zur Freigabe kontaktieren"],
      ["Panel hängt oder eine Änderung wird nicht gespeichert","Veraltete Sitzung oder App-/Browser-Aussetzer","Ab- und wieder anmelden, hart aktualisieren, erneut speichern und prüfen, dass der Wert angezeigt wird"],
      ["Limits lassen sich gar nicht bearbeiten","Prop-/Evaluierungskonto, von der Firma gesperrt","Ihre Prop-Firma kontaktieren; Tradovate kann Firmenregeln nicht außer Kraft setzen"],
    ] },
    { type: "heading",text: "Verhindern Sie die Sperre, bevor sie eintritt – mit PickMyTrade" },
    { type: "paragraph",html: "Eine Risikosperre ist meist ein Timing-Problem, kein Einstellungsproblem. Sie verletzen das Limit mitten in der Strategie und verlieren den Rest des Tages. PickMyTrade verknüpft Ihre TradingView-Alerts direkt mit Tradovate und legt eine risikobewusste Schicht über Ihr Konto, sodass Sie den Order-Fluss kontrollieren, bevor die Plattform Sie überhaupt liquidieren muss:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Tagesverlust-Leitplanken in Ihrer Automatisierungslogik</strong>, damit keine neuen Einstiege mehr hinausgehen, bevor Ihr Konto sein hartes Limit auslöst und in Liquidation-Only wechselt.",
        "<strong class='text-white'>Gewinnziel-Bewusstsein</strong>, das neue Alerts pausiert, sobald Ihr Sitzungsziel erreicht ist, statt eines automatischen Glattstellens bei einer ungünstigen Ausführung.",
        "<strong class='text-white'>Ablehnungssicheres Routing</strong>, damit Sie bei einem bereits gesperrten Konto nicht blind abgelehnte Orders in Ihre Logs hämmern, sondern in der nächsten gültigen Sitzung sauber routen.",
        "<strong class='text-white'>Multi-Account-Synchronisierung</strong>, um dieselben Leitplanken auf alle verbundenen Tradovate-Konten gleichzeitig anzuwenden, damit das Limit eines Kontos nicht unbemerkt von den übrigen abweicht.",
      ],
    },
  ], es: [
    { type: "paragraph",html: "Se pasó a Tradovate en parte por los controles de riesgo integrados, y ahora esos mismos controles tienen su cuenta real congelada. Todos los tickets de orden son rechazados, su posición se cerró sola y el reinicio diario que debía desbloquearle al cambio de sesión nunca se activó. Parece que la plataforma se ha caído. La mayoría de las veces no es ningún fallo, es un Risk Setting haciendo exactamente lo que usted le indicó, y puede resolverse en un par de minutos. De vez en cuando sí es un fallo de la plataforma, y entonces la solución es distinta. Aquí le explicamos cómo distinguir ambos casos, restablecer sus Risk Settings correctamente y lograr que soporte libere la cuenta si realmente está atascada." },
    {
      type: "checklist",
      heading: "Lista de comprobación rápida",
      items: [
        "<strong class='text-white'>Abra primero sus Risk Settings.</strong> Desde Application Settings (arriba a la derecha de la plataforma), abra Risk Settings y revise cada límite de la cuenta bloqueada.",
        "<strong class='text-white'>Busque un límite de pérdida o un disparador de beneficio alcanzado.</strong> Un Daily/Weekly Loss Limit o un objetivo de beneficio alcanzado le liquida y bloquea nuevas entradas hasta la siguiente sesión.",
        "<strong class='text-white'>Compruebe si hay un valor guardado en $0.</strong> Cualquier campo de riesgo dejado en cero se interpreta como &ldquo;ya superado&rdquo; y liquida la cuenta a la fuerza.",
        "<strong class='text-white'>Restablezca en una cuenta autofinanciada.</strong> Aumente, borre o desactive el parámetro que se activó y guarde, para reabrir antes la sesión actual.",
        "<strong class='text-white'>¿Cuenta prop o de evaluación?</strong> No puede editar los límites. Contacte con su firma prop, no con Tradovate.",
        "<strong class='text-white'>¿El reinicio no se activó o el panel no carga?</strong> Ese es el raro &ldquo;fallo&rdquo; real. Cierre sesión y vuelva a entrar, confirme el guardado y luego contacte con el soporte de Tradovate para borrar el estado.",
      ],
    },
    { type: "heading",text: "Qué suele significar un «fallo de Risk Settings»" },
    { type: "paragraph",html: "Los Risk Settings a nivel de cuenta de Tradovate le permiten fijar un Daily Loss Limit, un Weekly Loss Limit, un Trailing Max Drawdown y disparadores de beneficio diarios o semanales. Cuando se alcanza cualquiera de esos umbrales, la plataforma envía una orden a mercado para cerrar sus posiciones abiertas, cancela sus órdenes activas y deja la cuenta en modo <strong class='text-white'>Liquidation-Only</strong>. En ese estado puede reducir o cerrar exposición pero no abrir nada nuevo, por lo que cada nuevo ticket de orden es rechazado. Para quien olvidó que había un límite fijado, eso se ve idéntico a que la plataforma se haya roto." },
    { type: "paragraph",html: "Dos cosas hacen que parezca un fallo en lugar de una regla. Primero, el momento: le liquidan en mitad de la estrategia y pierde el resto de la sesión. Segundo, el reinicio. Un bloqueo diario debe levantarse en la siguiente sesión y uno semanal al inicio de la semana siguiente, así que cuando ese reinicio parece no producirse, la cuenta parece rota para siempre. Los fallos reales en los que el reinicio se atasca o el panel no carga existen, pero son raros, así que descarte primero las causas ordinarias." },
    { type: "heading",text: "Principales causas, de la más a la menos probable" },
    { type: "heading",text: "1. Se alcanzó un límite de pérdida diaria o semanal" },
    { type: "paragraph",html: "Esta es la razón número uno por la que aparece un bloqueo de &ldquo;riesgo&rdquo;. Su pérdida neta del día, comisiones incluidas, tocó el Daily Loss Limit, o su pérdida de la semana alcanzó el Weekly Loss Limit. Tradovate cierra la posición y bloquea nuevas entradas. Un límite diario se reabre a las <strong class='text-white'>5:00 PM hora central del mismo día</strong>; uno semanal permanece bloqueado hasta las <strong class='text-white'>5:00 PM hora central del domingo</strong>. Si da por hecho que un límite semanal se restablece de la noche a la mañana, estará convencido de que la plataforma está atascada cuando en realidad solo espera a que cambie la semana." },
    { type: "heading",text: "2. Se activó un disparador de beneficio" },
    { type: "paragraph",html: "Los objetivos de beneficio funcionan como los límites de pérdida a la inversa. Si fijó un Daily o Weekly Profit Trigger y lo alcanzó, la cuenta liquida para asegurar la ganancia y pasa a Liquidation-Only hasta el siguiente reinicio. Cuando estaba ganando dinero y le cerraron, casi siempre es por esto, y parece un error aunque el ajuste cumplió su función." },
    { type: "heading",text: "3. Un valor de riesgo guardado por error en $0" },
    { type: "paragraph",html: "Esta trampa afecta a quienes configuran límites por primera vez. Si activa un parámetro de riesgo pero deja el valor en <strong class='text-white'>$0</strong> y guarda, la plataforma lo interpreta como un límite ya superado. Liquida sus posiciones abiertas y cancela sus órdenes al instante. No se cayó nada, pero el efecto es inmediato y total, y seguirá liquidando una y otra vez hasta que desactive ese campo o lo fije por encima de cero." },
    { type: "heading",text: "4. El reinicio diario no se activó (el fallo real)" },
    { type: "paragraph",html: "Este es el caso genuino del lado de la plataforma. La cuenta está bloqueada por un límite diario, la sesión pasa de las 5:00 PM CT y el reinicio nunca ocurre, por lo que sigue congelada hasta el día siguiente aunque sus límites parezcan correctos. Este no es un comportamiento documentado, es un defecto, y es el verdadero escenario de &ldquo;fallo de risk settings&rdquo; en lugar de un ajuste mal interpretado. Cuando se han descartado las causas ordinarias y la cuenta sigue bloqueada después de que debió producirse un reinicio, es esto lo que tiene entre manos, y soporte debe liberarla." },
    { type: "heading",text: "5. El panel de Risk Settings no carga o no guarda" },
    { type: "paragraph",html: "A veces el problema es el propio panel: se queda colgado al cargar, no expande la sección de detalle de la cuenta o acepta un cambio que silenciosamente no se guarda. Una sesión obsoleta o un fallo del navegador/aplicación causa la mayoría. El peligro es creer que levantó un límite cuando el guardado nunca llegó, de modo que la cuenta sigue comportándose como bloqueada. Confirme siempre que el nuevo valor se muestra después de guardar." },
    { type: "heading",text: "6. Reglas de cuentas prop o de evaluación" },
    { type: "paragraph",html: "En una cuenta de evaluación o financiada de una firma prop, los parámetros de riesgo los fija y bloquea la firma, no usted. Los Risk Settings propios de Tradovate no se aplican a esas cuentas, y las cifras concretas de pérdida y drawdown varían según la firma y el tamaño de la cuenta, así que consulte las reglas vigentes de su firma. Cuando se activa una regla definida por la firma, solo el proveedor puede ajustarla o restablecerla." },
    { type: "heading",text: "Cómo solucionarlo, paso a paso" },
    { type: "heading",text: "Paso 1: Revise los Risk Settings de la cuenta bloqueada" },
    { type: "paragraph",html: "Antes de cambiar nada, vea qué se activó realmente. Abra <strong class='text-white'>Application Settings</strong> en la parte superior derecha de la plataforma y abra <strong class='text-white'>Risk Settings</strong> (en algunas versiones llega al mismo panel desde la pestaña <strong class='text-white'>Accounts</strong> haciendo clic en el botón Risk Settings de la cuenta para expandir su sección de detalle). Confirme que está viendo exactamente la cuenta bloqueada y luego lea cada campo: Daily Loss Limit, Weekly Loss Limit, Trailing Max Drawdown y cualquier disparador de beneficio. Busca el que su P&amp;L actual ha cruzado, o cualquier campo que esté en $0." },
    { type: "heading",text: "Paso 2: Restablezca el parámetro (cuenta real o demo autofinanciada)" },
    { type: "paragraph",html: "En una cuenta autofinanciada de Tradovate, usted es dueño de estos ajustes y puede levantar el bloqueo sin esperar al cambio de sesión." },
    {
      type: "steps",
      items: [
        { title: "Localice el parámetro activado", html: "Localice el parámetro que se alcanzó o el campo que quedó en $0." },
        { title: "Aumente, borre o desactive", html: "Aumente el valor, bórrelo o desactive el parámetro para que el P&amp;L de su sesión actual quede holgadamente dentro del nuevo umbral." },
        { title: "Guarde el cambio", html: "Desplácese hacia abajo y <strong class='text-white'>guarde</strong>. No omita esto: un cambio sin guardar no hace nada." },
        { title: "Confirme que se muestra el nuevo valor", html: "Vuelva a abrir el panel y confirme que el nuevo valor aparece realmente, lo que demuestra que el guardado se completó." },
        { title: "Vuelva a su ticket de orden", html: "Vuelva a su ticket de orden. Debería poder abrir posiciones de nuevo durante la sesión actual." },
      ],
    },
    { type: "paragraph",html: "¿Prefiere no tocar sus reglas de disciplina? Simplemente espere. Un bloqueo diario se levanta a las <strong class='text-white'>5:00 PM CT del mismo día</strong> y uno semanal a las <strong class='text-white'>5:00 PM CT del domingo</strong>, sin necesidad de actuar." },
    { type: "heading",text: "Paso 3: Si el panel no carga o el guardado no se mantiene" },
    { type: "paragraph",html: "Cuando el panel se cuelga o un cambio no se guarda, actualice primero la sesión. Cierre sesión por completo, cierre la pestaña o la aplicación de escritorio, vuelva a iniciar sesión y reabra Risk Settings. En la web, una actualización forzada o borrar la caché del sitio puede soltar un panel obsoleto. Haga su cambio de nuevo y verifique que se muestra. Eso resuelve la mayoría de los informes de &ldquo;el panel está roto&rdquo; sin que soporte llegue a intervenir." },
    { type: "heading",text: "Paso 4: Si el reinicio nunca se activó, contacte con soporte" },
    { type: "paragraph",html: "Si ha confirmado que sus límites son correctos, que nada está en $0, que editó la cuenta correcta y que la cuenta <em>sigue</em> en Liquidation-Only después de que la sesión debió reiniciarse, está en territorio de fallo genuino. No siga lanzando órdenes rechazadas: no se ejecutarán y solo saturan sus registros. Contacte directamente con el soporte de Tradovate, indíqueles que el reinicio diario no se activó y que la cuenta está atascada, y facilíteles el nombre de la cuenta y la hora en que debió producirse el reinicio para que puedan liberar el estado. Si tiene una cuenta prop o de evaluación, contacte en su lugar con el soporte de su <strong class='text-white'>firma prop</strong>, ya que ellos administran las reglas de riesgo y Tradovate no puede cambiar parámetros bloqueados por la firma (con la excepción limitada del Trailing Max Drawdown, gestionado a través del orders desk)." },
    { type: "heading",text: "Tabla de solución de problemas" },
    { type: "table", headers: ["Lo que está viendo","Causa más probable","Solución"], rows: [
      ["La posición se cerró sola, las nuevas órdenes son rechazadas","Se alcanzó un Daily/Weekly Loss Limit","Espere al reinicio de la sesión/semana, o aumente/borre el límite en una cuenta autofinanciada"],
      ["Cuenta cerrada mientras estaba en beneficios","Se activó un disparador de beneficio","Desactive el disparador de beneficio si no quiere el cierre automático"],
      ["Liquidación instantánea justo después de configurar límites","Un campo de riesgo guardado en $0","Desactive ese campo o fíjelo por encima de cero y guarde"],
      ["Sigue bloqueada después de que la sesión debió reiniciarse","El reinicio diario no se activó (fallo de la plataforma)","Confirme ajustes y cuenta, cierre/inicie sesión y luego contacte con soporte para liberarla"],
      ["El panel se cuelga o un cambio no se guarda","Sesión obsoleta o fallo de la aplicación/navegador","Cierre y vuelva a iniciar sesión, actualice con fuerza, guarde de nuevo y confirme que el valor se muestra"],
      ["No puede editar los límites en absoluto","Cuenta prop/de evaluación, bloqueada por la firma","Contacte con su firma prop; Tradovate no puede anular las reglas de la firma"],
    ] },
    { type: "heading",text: "Evite el bloqueo antes de que ocurra, con PickMyTrade" },
    { type: "paragraph",html: "Un bloqueo de riesgo suele ser un problema de momento, no de ajustes. Supera el límite en mitad de la estrategia y pierde el resto del día. PickMyTrade vincula sus alertas de TradingView directamente con Tradovate y añade una capa consciente del riesgo sobre su cuenta, de modo que usted controla el flujo de órdenes antes de que la plataforma tenga que liquidarle:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Protecciones de pérdida diaria en su lógica de automatización</strong> para que dejen de salir nuevas entradas antes de que su cuenta active su límite duro y pase a Liquidation-Only.",
        "<strong class='text-white'>Conciencia del objetivo de beneficio</strong> que pausa las nuevas alertas una vez cumplido el objetivo de su sesión, en lugar de un cierre automático en una ejecución inoportuna.",
        "<strong class='text-white'>Enrutamiento a prueba de rechazos</strong> para que, cuando la cuenta ya esté bloqueada, no siga lanzando a ciegas órdenes rechazadas en sus registros, sino que enrute limpiamente en la siguiente sesión válida.",
        "<strong class='text-white'>Sincronización multicuenta</strong> para aplicar las mismas protecciones en todas las cuentas de Tradovate conectadas a la vez, de modo que el límite de una cuenta no se desvíe silenciosamente del resto.",
      ],
    },
  ], fr: [
    { type: "paragraph",html: "Vous êtes passé à Tradovate en partie pour ses contrôles de risque intégrés, et ce sont ces mêmes contrôles qui ont maintenant gelé votre compte réel. Chaque ticket d'ordre est rejeté, votre position s'est fermée toute seule, et la réinitialisation quotidienne qui devait vous débloquer au changement de session ne s'est jamais produite. On a l'impression que la plateforme a planté. La plupart du temps, ce n'est pas du tout un plantage : c'est un Risk Setting qui fait exactement ce que vous lui avez demandé, et vous pouvez le lever en quelques minutes. De temps en temps, il s'agit réellement d'un dysfonctionnement de la plateforme, et la solution est alors différente. Voici comment distinguer les deux, réinitialiser correctement vos Risk Settings et obtenir que le support libère le compte s'il est réellement bloqué." },
    {
      type: "checklist",
      heading: "Check-list rapide",
      items: [
        "<strong class='text-white'>Ouvrez d'abord vos Risk Settings.</strong> Depuis Application Settings (en haut à droite de la plateforme), ouvrez Risk Settings et vérifiez chaque limite du compte bloqué.",
        "<strong class='text-white'>Cherchez une limite de perte ou un déclencheur de profit atteint.</strong> Un Daily/Weekly Loss Limit ou un objectif de profit atteint vous liquide et verrouille les nouvelles entrées jusqu'à la prochaine session.",
        "<strong class='text-white'>Vérifiez s'il y a une valeur enregistrée à $0.</strong> Tout champ de risque laissé à zéro est lu comme &ldquo;déjà dépassé&rdquo; et liquide le compte de force.",
        "<strong class='text-white'>Réinitialisez sur un compte autofinancé.</strong> Augmentez, effacez ou désactivez le paramètre qui s'est déclenché, puis enregistrez, pour rouvrir la session en cours plus tôt.",
        "<strong class='text-white'>Compte prop ou d'évaluation ?</strong> Vous ne pouvez pas modifier les limites. Contactez votre société de prop trading, pas Tradovate.",
        "<strong class='text-white'>La réinitialisation ne s'est pas déclenchée ou le panneau ne se charge pas ?</strong> C'est le rare vrai &ldquo;plantage&rdquo;. Déconnectez-vous puis reconnectez-vous, confirmez l'enregistrement, puis contactez le support Tradovate pour lever l'état.",
      ],
    },
    { type: "heading",text: "Ce que signifie généralement un « plantage des Risk Settings »" },
    { type: "paragraph",html: "Les Risk Settings au niveau du compte de Tradovate vous permettent de définir un Daily Loss Limit, un Weekly Loss Limit, un Trailing Max Drawdown et des déclencheurs de profit quotidiens ou hebdomadaires. Lorsque l'un de ces seuils est atteint, la plateforme envoie un ordre au marché pour clôturer vos positions ouvertes, annule vos ordres actifs et place le compte en mode <strong class='text-white'>Liquidation-Only</strong>. Dans cet état, vous pouvez réduire ou fermer l'exposition mais pas ouvrir quoi que ce soit de nouveau, de sorte que tout nouveau ticket d'ordre est rejeté. Pour quelqu'un qui avait oublié qu'une limite était définie, cela ressemble exactement à une plateforme en panne." },
    { type: "paragraph",html: "Deux choses donnent l'impression d'un plantage plutôt que d'une règle. D'abord, le timing : vous êtes liquidé en pleine stratégie et perdez le reste de la session. Ensuite, la réinitialisation. Un blocage quotidien devrait être levé à la session suivante et un blocage hebdomadaire au début de la semaine suivante ; quand cette réinitialisation semble ne pas se produire, le compte paraît définitivement en panne. De vrais dysfonctionnements où la réinitialisation reste bloquée ou où le panneau ne se charge pas existent, mais ils sont rares ; écartez donc d'abord les causes ordinaires." },
    { type: "heading",text: "Principales causes, de la plus à la moins probable" },
    { type: "heading",text: "1. Une limite de perte quotidienne ou hebdomadaire a été atteinte" },
    { type: "paragraph",html: "C'est la raison numéro un pour laquelle un blocage &ldquo;risque&rdquo; apparaît. Votre perte nette de la journée, frais compris, a touché le Daily Loss Limit, ou votre perte sur la semaine a atteint le Weekly Loss Limit. Tradovate clôture la position et verrouille les nouvelles entrées. Une limite quotidienne rouvre à <strong class='text-white'>5:00 PM heure centrale le même jour</strong> ; une limite hebdomadaire reste verrouillée jusqu'à <strong class='text-white'>5:00 PM heure centrale le dimanche</strong>. Si vous supposez qu'une limite hebdomadaire se réinitialise pendant la nuit, vous serez convaincu que la plateforme est bloquée alors qu'elle attend simplement le changement de semaine." },
    { type: "heading",text: "2. Un déclencheur de profit s'est activé" },
    { type: "paragraph",html: "Les objectifs de profit fonctionnent comme des limites de perte en sens inverse. Si vous avez défini un Daily ou Weekly Profit Trigger et qu'il a été atteint, le compte liquide pour verrouiller le gain et passe en Liquidation-Only jusqu'à la prochaine réinitialisation. Quand vous étiez en gain et avez été clôturé, c'est presque toujours la raison, et cela ressemble à un bug alors que le paramètre a fait son travail." },
    { type: "heading",text: "3. Une valeur de risque enregistrée par erreur à $0" },
    { type: "paragraph",html: "Ce piège attrape ceux qui configurent des limites pour la première fois. Si vous activez un paramètre de risque mais laissez la valeur à <strong class='text-white'>$0</strong> et enregistrez, la plateforme le lit comme une limite déjà dépassée. Elle liquide vos positions ouvertes et annule vos ordres sur-le-champ. Rien n'a planté, mais l'effet est immédiat et total, et elle continuera de liquider de nouveau jusqu'à ce que vous désactiviez ce champ ou le définissiez au-dessus de zéro." },
    { type: "heading",text: "4. La réinitialisation quotidienne ne s'est pas déclenchée (le vrai dysfonctionnement)" },
    { type: "paragraph",html: "Voici le véritable cas côté plateforme. Le compte est bloqué par une limite quotidienne, la session dépasse 5:00 PM CT et la réinitialisation n'a jamais lieu : vous restez gelé jusqu'au lendemain alors que vos limites semblent correctes. Ce n'est pas un comportement documenté, c'est un défaut, et c'est le véritable scénario de &ldquo;plantage des risk settings&rdquo; plutôt qu'un paramètre mal lu. Lorsque les causes ordinaires sont écartées et que le compte est toujours bloqué alors qu'une réinitialisation aurait dû avoir lieu, c'est à cela que vous avez affaire, et le support doit le libérer." },
    { type: "heading",text: "5. Le panneau Risk Settings ne se charge pas ou n'enregistre pas" },
    { type: "paragraph",html: "Parfois, le panneau lui-même est le problème : il se fige au chargement, n'ouvre pas la section de détail du compte ou accepte une modification qui n'est silencieusement pas enregistrée. Une session obsolète ou un hoquet du navigateur/de l'application en est la cause la plupart du temps. Le danger est de croire que vous avez levé une limite alors que l'enregistrement n'a jamais abouti, si bien que le compte continue de se comporter comme bloqué. Confirmez toujours que la nouvelle valeur s'affiche après l'enregistrement." },
    { type: "heading",text: "6. Règles des comptes prop ou d'évaluation" },
    { type: "paragraph",html: "Sur un compte d'évaluation ou financé d'une société de prop trading, les paramètres de risque sont définis et verrouillés par la société, pas par vous. Les propres Risk Settings de Tradovate ne s'appliquent pas à ces comptes, et les chiffres précis de perte et de drawdown varient selon la société et la taille du compte ; vérifiez donc les règles actuelles de votre société. Lorsqu'une règle définie par la société se déclenche, seul le fournisseur peut l'ajuster ou la réinitialiser." },
    { type: "heading",text: "Comment le corriger, pas à pas" },
    { type: "heading",text: "Étape 1 : Examiner les Risk Settings du compte bloqué" },
    { type: "paragraph",html: "Avant de changer quoi que ce soit, voyez ce qui s'est réellement déclenché. Ouvrez <strong class='text-white'>Application Settings</strong> en haut à droite de la plateforme puis ouvrez <strong class='text-white'>Risk Settings</strong> (sur certaines versions, vous accédez au même panneau depuis l'onglet <strong class='text-white'>Accounts</strong> en cliquant sur le bouton Risk Settings du compte pour développer sa section de détail). Vérifiez que vous regardez exactement le compte bloqué, puis lisez chaque champ : Daily Loss Limit, Weekly Loss Limit, Trailing Max Drawdown et tout déclencheur de profit. Vous cherchez celui que votre P&amp;L actuel a franchi, ou tout champ resté à $0." },
    { type: "heading",text: "Étape 2 : Réinitialiser le paramètre (compte réel ou démo autofinancé)" },
    { type: "paragraph",html: "Sur un compte Tradovate autofinancé, ces paramètres vous appartiennent et vous pouvez lever le blocage sans attendre le changement de session." },
    {
      type: "steps",
      items: [
        { title: "Trouver le paramètre déclenché", html: "Trouvez le paramètre qui a été atteint ou le champ laissé à $0." },
        { title: "Augmenter, effacer ou désactiver", html: "Augmentez la valeur, effacez-la ou désactivez le paramètre afin que le P&amp;L de votre session actuelle se situe confortablement dans le nouveau seuil." },
        { title: "Enregistrer la modification", html: "Faites défiler vers le bas et <strong class='text-white'>enregistrez</strong>. Ne sautez pas cette étape : une modification non enregistrée ne fait rien." },
        { title: "Confirmer que la nouvelle valeur s'affiche", html: "Rouvrez le panneau et confirmez que la nouvelle valeur est bien affichée, ce qui prouve que l'enregistrement a abouti." },
        { title: "Retourner à votre ticket d'ordre", html: "Retournez à votre ticket d'ordre. Vous devriez pouvoir ouvrir de nouveau des positions pour la session en cours." },
      ],
    },
    { type: "paragraph",html: "Vous préférez ne pas toucher à vos règles de discipline ? Attendez simplement. Un blocage quotidien est levé à <strong class='text-white'>5:00 PM CT le même jour</strong> et un blocage hebdomadaire à <strong class='text-white'>5:00 PM CT le dimanche</strong>, sans aucune action requise." },
    { type: "heading",text: "Étape 3 : Si le panneau ne se charge pas ou que l'enregistrement ne tient pas" },
    { type: "paragraph",html: "Lorsque le panneau se fige ou qu'une modification ne s'enregistre pas, actualisez d'abord la session. Déconnectez-vous complètement, fermez l'onglet ou l'application de bureau, reconnectez-vous et rouvrez Risk Settings. Sur le web, une actualisation forcée ou le vidage du cache du site peut débloquer un panneau obsolète. Refaites votre modification et vérifiez qu'elle s'affiche. Cela règle la plupart des signalements &ldquo;le panneau est cassé&rdquo; sans jamais impliquer le support." },
    { type: "heading",text: "Étape 4 : Si la réinitialisation ne s'est jamais déclenchée, contacter le support" },
    { type: "paragraph",html: "Si vous avez confirmé que vos limites sont correctes, que rien n'est à $0, que vous avez modifié le bon compte et que le compte est <em>toujours</em> en Liquidation-Only alors que la session aurait dû se réinitialiser, vous êtes en territoire de véritable dysfonctionnement. N'envoyez pas sans cesse des ordres rejetés : ils ne passeront pas et encombrent seulement vos journaux. Contactez directement le support Tradovate, indiquez que la réinitialisation quotidienne ne s'est pas déclenchée et que le compte est bloqué, et fournissez le nom du compte et l'heure à laquelle la réinitialisation aurait dû avoir lieu afin qu'ils puissent lever l'état. Si vous êtes sur un compte prop ou d'évaluation, contactez plutôt le support de votre <strong class='text-white'>société de prop trading</strong>, car c'est elle qui administre les règles de risque et Tradovate ne peut pas modifier les paramètres verrouillés par la société (à l'exception limitée du Trailing Max Drawdown, géré via l'orders desk)." },
    { type: "heading",text: "Tableau de dépannage" },
    { type: "table", headers: ["Ce que vous voyez","Cause la plus probable","Correctif"], rows: [
      ["La position s'est fermée toute seule, les nouveaux ordres sont rejetés","Un Daily/Weekly Loss Limit a été atteint","Attendre la réinitialisation de la session/semaine, ou augmenter/effacer la limite sur un compte autofinancé"],
      ["Compte clôturé alors que vous étiez en gain","Un déclencheur de profit s'est activé","Désactivez le déclencheur de profit si vous ne voulez pas la clôture automatique"],
      ["Liquidation instantanée juste après la configuration des limites","Un champ de risque enregistré à $0","Désactivez ce champ ou définissez-le au-dessus de zéro, puis enregistrez"],
      ["Toujours bloqué alors que la session aurait dû se réinitialiser","La réinitialisation quotidienne ne s'est pas déclenchée (dysfonctionnement de la plateforme)","Vérifiez les paramètres et le compte, déconnectez-vous/reconnectez-vous, puis contactez le support pour le libérer"],
      ["Le panneau se fige ou une modification ne s'enregistre pas","Session obsolète ou hoquet de l'application/du navigateur","Déconnectez-vous et reconnectez-vous, actualisation forcée, réenregistrez et confirmez que la valeur s'affiche"],
      ["Impossible de modifier les limites","Compte prop/d'évaluation verrouillé par la société","Contactez votre société de prop trading ; Tradovate ne peut pas outrepasser les règles de la société"],
    ] },
    { type: "heading",text: "Évitez le blocage avant qu'il ne survienne, avec PickMyTrade" },
    { type: "paragraph",html: "Un blocage de risque est généralement un problème de timing, pas un problème de paramètres. Vous dépassez la limite en pleine stratégie et perdez le reste de la journée. PickMyTrade relie vos alertes TradingView directement à Tradovate et ajoute une couche attentive au risque au-dessus de votre compte, afin que vous contrôliez le flux d'ordres avant que la plateforme n'ait à vous liquider :" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Garde-fous de perte quotidienne dans votre logique d'automatisation</strong> afin que les nouvelles entrées cessent de partir avant que votre compte n'atteigne sa limite stricte et ne bascule en Liquidation-Only.",
        "<strong class='text-white'>Prise en compte de l'objectif de profit</strong> qui met en pause les nouvelles alertes une fois l'objectif de votre session atteint, au lieu d'une clôture automatique à une exécution inopportune.",
        "<strong class='text-white'>Routage à l'épreuve des rejets</strong> pour que, lorsque le compte est déjà bloqué, vous n'enchaîniez pas aveuglément des ordres rejetés dans vos journaux, mais routiez proprement à la prochaine session valide.",
        "<strong class='text-white'>Synchronisation multi-comptes</strong> pour appliquer les mêmes garde-fous à tous les comptes Tradovate connectés à la fois, afin que la limite d'un compte ne dérive pas discrètement par rapport aux autres.",
      ],
    },
  ], it: [
    { type: "paragraph",html: "È passato a Tradovate in parte per i controlli di rischio integrati, e ora quegli stessi controlli hanno bloccato il Suo conto live. Ogni ticket d'ordine viene rifiutato, la Sua posizione si è chiusa da sola e il reset giornaliero che avrebbe dovuto sbloccarLa al cambio di sessione non è mai scattato. Sembra che la piattaforma sia andata in crash. Nella maggior parte dei casi non è affatto un crash, è un Risk Setting che fa esattamente ciò che Lei gli ha detto di fare, e può risolverlo in un paio di minuti. Ogni tanto è davvero un malfunzionamento della piattaforma, e in quel caso la soluzione è diversa. Ecco come distinguere i due casi, reimpostare correttamente i Suoi Risk Settings e ottenere che il supporto sblocchi il conto se è davvero bloccato." },
    {
      type: "checklist",
      heading: "Checklist rapida",
      items: [
        "<strong class='text-white'>Apra prima i Suoi Risk Settings.</strong> Da Application Settings (in alto a destra nella piattaforma), apra Risk Settings e controlli ogni limite del conto bloccato.",
        "<strong class='text-white'>Cerchi un limite di perdita o un trigger di profitto raggiunto.</strong> Un Daily/Weekly Loss Limit o un obiettivo di profitto raggiunto La liquida e blocca i nuovi ingressi fino alla sessione successiva.",
        "<strong class='text-white'>Verifichi se c'è un valore salvato a $0.</strong> Qualsiasi campo di rischio lasciato a zero viene letto come &ldquo;già violato&rdquo; e liquida forzatamente il conto.",
        "<strong class='text-white'>Reimposti su un conto autofinanziato.</strong> Aumenti, cancelli o disattivi il parametro scattato, poi salvi, per riaprire prima la sessione corrente.",
        "<strong class='text-white'>Conto prop o di valutazione?</strong> Non può modificare i limiti. Contatti la Sua prop firm, non Tradovate.",
        "<strong class='text-white'>Il reset non è scattato o il pannello non si carica?</strong> È il raro vero &ldquo;crash&rdquo;. Esca e rientri, confermi il salvataggio, poi contatti il supporto di Tradovate per ripulire lo stato.",
      ],
    },
    { type: "heading",text: "Cosa significa di solito un «crash dei Risk Settings»" },
    { type: "paragraph",html: "I Risk Settings a livello di conto di Tradovate Le consentono di impostare un Daily Loss Limit, un Weekly Loss Limit, un Trailing Max Drawdown e trigger di profitto giornalieri o settimanali. Quando una qualsiasi di queste soglie viene raggiunta, la piattaforma invia un ordine a mercato per chiudere le Sue posizioni aperte, annulla gli ordini attivi e porta il conto in modalità <strong class='text-white'>Liquidation-Only</strong>. In questo stato può ridurre o chiudere l'esposizione ma non aprire nulla di nuovo, quindi ogni nuovo ticket d'ordine viene rifiutato. Per chi si era dimenticato che un limite fosse impostato, sembra identico a una piattaforma guasta." },
    { type: "paragraph",html: "Due cose lo fanno sembrare un crash invece di una regola. Primo, il momento: viene liquidato a metà strategia e perde il resto della sessione. Secondo, il reset. Un blocco giornaliero dovrebbe sparire alla sessione successiva e uno settimanale all'inizio della settimana successiva, quindi quando quel reset sembra non avvenire, il conto sembra rotto per sempre. Esistono veri malfunzionamenti in cui il reset si blocca o il pannello non si carica, ma sono rari, quindi escluda prima le cause ordinarie." },
    { type: "heading",text: "Principali cause, dalla più alla meno probabile" },
    { type: "heading",text: "1. È stato raggiunto un limite di perdita giornaliera o settimanale" },
    { type: "paragraph",html: "È la ragione numero uno per cui compare un blocco &ldquo;di rischio&rdquo;. La Sua perdita netta della giornata, commissioni incluse, ha toccato il Daily Loss Limit, oppure la perdita della settimana ha raggiunto il Weekly Loss Limit. Tradovate chiude la posizione e blocca i nuovi ingressi. Un limite giornaliero riapre alle <strong class='text-white'>5:00 PM ora centrale dello stesso giorno</strong>; uno settimanale resta bloccato fino alle <strong class='text-white'>5:00 PM ora centrale della domenica</strong>. Se presume che un limite settimanale si azzeri durante la notte, sarà convinto che la piattaforma sia bloccata quando in realtà sta solo aspettando il cambio di settimana." },
    { type: "heading",text: "2. È scattato un trigger di profitto" },
    { type: "paragraph",html: "Gli obiettivi di profitto funzionano come i limiti di perdita al contrario. Se ha impostato un Daily o Weekly Profit Trigger e l'ha raggiunto, il conto liquida per bloccare il guadagno e passa in Liquidation-Only fino al reset successivo. Quando era in guadagno ed è stato chiuso, quasi sempre è per questo, e sembra un bug anche se l'impostazione ha fatto il suo lavoro." },
    { type: "heading",text: "3. Un valore di rischio salvato per errore a $0" },
    { type: "paragraph",html: "Questa trappola coglie chi configura i limiti per la prima volta. Se attiva un parametro di rischio ma lascia il valore a <strong class='text-white'>$0</strong> e salva, la piattaforma lo legge come un limite già violato. Liquida le Sue posizioni aperte e annulla i Suoi ordini all'istante. Non è crashato nulla, ma l'effetto è immediato e totale, e continuerà a liquidare finché non disattiva quel campo o lo imposta sopra zero." },
    { type: "heading",text: "4. Il reset giornaliero non è scattato (il vero malfunzionamento)" },
    { type: "paragraph",html: "Ecco il vero caso lato piattaforma. Il conto è bloccato da un limite giornaliero, la sessione supera le 5:00 PM CT e il reset non avviene mai, quindi resta bloccato fino al giorno successivo anche se i Suoi limiti sembrano corretti. Non è un comportamento documentato, è un difetto, ed è il vero scenario di &ldquo;crash dei risk settings&rdquo; e non un'impostazione letta male. Quando le cause ordinarie sono escluse e il conto è ancora bloccato dopo che un reset avrebbe dovuto verificarsi, è questo che ha davanti, e il supporto deve sbloccarlo." },
    { type: "heading",text: "5. Il pannello Risk Settings non si carica o non salva" },
    { type: "paragraph",html: "A volte il problema è il pannello stesso: si blocca al caricamento, non espande la sezione di dettaglio del conto o accetta una modifica che silenziosamente non viene salvata. Una sessione obsoleta o un intoppo del browser/app causa la maggior parte di questi casi. Il pericolo è credere di aver rimosso un limite quando il salvataggio non è mai andato a buon fine, così il conto continua a comportarsi come bloccato. Dopo il salvataggio confermi sempre che il nuovo valore sia visualizzato." },
    { type: "heading",text: "6. Regole dei conti prop o di valutazione" },
    { type: "paragraph",html: "Su un conto di valutazione o finanziato di una prop firm, i parametri di rischio sono impostati e bloccati dalla società, non da Lei. I Risk Settings propri di Tradovate non si applicano a questi conti, e i numeri specifici di perdita e drawdown variano in base alla società e alla dimensione del conto, quindi verifichi le regole correnti della Sua società. Quando scatta una regola definita dalla società, solo il fornitore può modificarla o reimpostarla." },
    { type: "heading",text: "Come risolvere, passo dopo passo" },
    { type: "heading",text: "Passo 1: Esaminare i Risk Settings del conto bloccato" },
    { type: "paragraph",html: "Prima di cambiare qualsiasi cosa, veda cosa è realmente scattato. Apra <strong class='text-white'>Application Settings</strong> in alto a destra nella piattaforma e apra <strong class='text-white'>Risk Settings</strong> (su alcune versioni si raggiunge lo stesso pannello dalla scheda <strong class='text-white'>Accounts</strong> facendo clic sul pulsante Risk Settings del conto per espandere la sua sezione di dettaglio). Verifichi di guardare esattamente il conto bloccato, poi legga ogni campo: Daily Loss Limit, Weekly Loss Limit, Trailing Max Drawdown ed eventuali trigger di profitto. Cerca quello che il Suo P&amp;L attuale ha superato, oppure qualsiasi campo fermo a $0." },
    { type: "heading",text: "Passo 2: Reimpostare il parametro (conto live o demo autofinanziato)" },
    { type: "paragraph",html: "Su un conto Tradovate autofinanziato queste impostazioni sono Sue e può togliere il blocco senza attendere il cambio di sessione." },
    {
      type: "steps",
      items: [
        { title: "Trovare il parametro scattato", html: "Trovi il parametro che è stato raggiunto o il campo lasciato a $0." },
        { title: "Aumentare, cancellare o disattivare", html: "Aumenti il valore, lo cancelli o disattivi il parametro in modo che il P&amp;L della Sua sessione corrente rientri comodamente nella nuova soglia." },
        { title: "Salvare la modifica", html: "Scorra verso il basso e <strong class='text-white'>salvi</strong>. Non salti questo passaggio: una modifica non salvata non fa nulla." },
        { title: "Confermare che il nuovo valore compare", html: "Riapra il pannello e confermi che il nuovo valore sia effettivamente visualizzato, a prova che il salvataggio è andato a buon fine." },
        { title: "Tornare al ticket d'ordine", html: "Torni al Suo ticket d'ordine. Dovrebbe poter aprire di nuovo posizioni per la sessione corrente." },
      ],
    },
    { type: "paragraph",html: "Preferisce non toccare le Sue regole di disciplina? Attenda semplicemente. Un blocco giornaliero si rimuove alle <strong class='text-white'>5:00 PM CT dello stesso giorno</strong> e uno settimanale alle <strong class='text-white'>5:00 PM CT della domenica</strong>, senza alcuna azione necessaria." },
    { type: "heading",text: "Passo 3: Se il pannello non si carica o il salvataggio non regge" },
    { type: "paragraph",html: "Quando il pannello si blocca o una modifica non viene salvata, aggiorni prima la sessione. Esca completamente, chiuda la scheda o l'app desktop, acceda di nuovo e riapra Risk Settings. Sul web, un aggiornamento forzato o la cancellazione della cache del sito può sbloccare un pannello obsoleto. Rifaccia la modifica e verifichi che venga visualizzata. Questo risolve la maggior parte delle segnalazioni &ldquo;il pannello è rotto&rdquo; senza coinvolgere il supporto." },
    { type: "heading",text: "Passo 4: Se il reset non è mai scattato, contattare il supporto" },
    { type: "paragraph",html: "Se ha confermato che i Suoi limiti sono corretti, che nulla è a $0, che ha modificato il conto giusto e che il conto è <em>ancora</em> in Liquidation-Only dopo che la sessione avrebbe dovuto azzerarsi, si trova in un territorio di vero malfunzionamento. Non continui a inviare ordini rifiutati: non passeranno e ingombrano soltanto i Suoi log. Contatti direttamente il supporto di Tradovate, indichi che il reset giornaliero non è scattato e che il conto è bloccato, e fornisca il nome del conto e l'ora in cui il reset avrebbe dovuto avvenire così che possano sbloccare lo stato. Se ha un conto prop o di valutazione, contatti invece il supporto della Sua <strong class='text-white'>prop firm</strong>, poiché è questa ad amministrare le regole di rischio e Tradovate non può modificare i parametri bloccati dalla società (con l'eccezione limitata del Trailing Max Drawdown, gestito tramite l'orders desk)." },
    { type: "heading",text: "Tabella di risoluzione dei problemi" },
    { type: "table", headers: ["Cosa sta vedendo","Causa più probabile","Soluzione"], rows: [
      ["La posizione si è chiusa da sola, i nuovi ordini vengono rifiutati","È stato raggiunto un Daily/Weekly Loss Limit","Attenda il reset della sessione/settimana, oppure aumenti/cancelli il limite su un conto autofinanziato"],
      ["Conto chiuso mentre era in profitto","È scattato un trigger di profitto","Disattivi il trigger di profitto se non vuole la chiusura automatica"],
      ["Liquidazione istantanea subito dopo la configurazione dei limiti","Un campo di rischio salvato a $0","Disattivi quel campo o lo imposti sopra zero, poi salvi"],
      ["Ancora bloccato dopo che la sessione avrebbe dovuto azzerarsi","Il reset giornaliero non è scattato (malfunzionamento della piattaforma)","Verifichi impostazioni e conto, esca/rientri, poi contatti il supporto per sbloccarlo"],
      ["Il pannello si blocca o una modifica non viene salvata","Sessione obsoleta o intoppo dell'app/del browser","Esca e rientri, aggiornamento forzato, salvi di nuovo e confermi che il valore compaia"],
      ["Non può modificare affatto i limiti","Conto prop/di valutazione, bloccato dalla società","Contatti la Sua prop firm; Tradovate non può scavalcare le regole della società"],
    ] },
    { type: "heading",text: "Eviti il blocco prima che accada, con PickMyTrade" },
    { type: "paragraph",html: "Un blocco di rischio è di solito un problema di tempistica, non di impostazioni. Viola il limite a metà strategia e perde il resto della giornata. PickMyTrade collega i Suoi alert di TradingView direttamente a Tradovate e aggiunge uno strato attento al rischio sopra il Suo conto, così può controllare il flusso degli ordini prima che la piattaforma debba liquidarLa:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Protezioni di perdita giornaliera nella Sua logica di automazione</strong> in modo che i nuovi ingressi smettano di partire prima che il conto raggiunga il suo limite rigido e passi in Liquidation-Only.",
        "<strong class='text-white'>Consapevolezza dell'obiettivo di profitto</strong> che mette in pausa i nuovi alert una volta raggiunto l'obiettivo della sessione, invece di una chiusura automatica a un'esecuzione scomoda.",
        "<strong class='text-white'>Routing a prova di rifiuto</strong> così che, quando il conto è già bloccato, non martelli ciecamente ordini rifiutati nei Suoi log, ma instradi in modo pulito nella prossima sessione valida.",
        "<strong class='text-white'>Sincronizzazione multi-account</strong> per applicare le stesse protezioni a tutti i conti Tradovate collegati contemporaneamente, così il limite di un conto non si discosta silenziosamente dagli altri.",
      ],
    },
  ] },
  ctaHeading: { en: "Trade Your Risk Rules on Your Terms", de: "Handeln Sie Ihre Risikoregeln zu Ihren Bedingungen", es: "Opere con sus reglas de riesgo en sus propios términos", fr: "Tradez vos règles de risque selon vos conditions", it: "Faccia trading con le Sue regole di rischio alle Sue condizioni" },
  ctaText: { en: "Start your free trial and link your TradingView alerts to Tradovate, with risk guardrails that stop a surprise lockout before it happens.", de: "Starten Sie Ihre kostenlose Testphase und verknüpfen Sie Ihre TradingView-Alerts mit Tradovate – mit Risiko-Leitplanken, die eine überraschende Sperre verhindern, bevor sie eintritt.", es: "Comience su prueba gratuita y vincule sus alertas de TradingView con Tradovate, con protecciones de riesgo que evitan un bloqueo sorpresa antes de que ocurra.", fr: "Commencez votre essai gratuit et reliez vos alertes TradingView à Tradovate, avec des garde-fous de risque qui évitent un blocage surprise avant qu'il ne survienne.", it: "Inizi la prova gratuita e colleghi i Suoi alert di TradingView a Tradovate, con protezioni di rischio che evitano un blocco a sorpresa prima che si verifichi." },
  ctaButtonText: { en: "Start Your Free 7-Day Trial", de: "Starten Sie Ihre kostenlose 7-Tage-Testphase", es: "Comience su prueba gratuita de 7 días", fr: "Commencez votre essai gratuit de 7 jours", it: "Inizi la prova gratuita di 7 giorni" },
  ctaUrl: "https://app.pickmytrade.trade/?register=true&utm_source=content&utm_medium=debugging",
  faqHeading: { en: "Frequently Asked Questions", de: "Häufig gestellte Fragen", es: "Preguntas frecuentes", fr: "Questions fréquentes", it: "Domande frequenti" },
  faqs: { en: [
    { q: "Why is my live Tradovate account locked out of trading?", a: "In almost every case a Risk Setting fired. A Daily Loss Limit, Weekly Loss Limit, profit trigger, or a value accidentally saved at $0 will flatten your positions and put the account in Liquidation-Only, where you can close but not open trades. Open your Risk Settings, confirm which limit was hit, and either wait for the session reset or change the value on a self-funded account." },
    { q: "How do I reset my Tradovate Risk Settings to trade again?", a: "Open Application Settings from the top-right of the platform, open Risk Settings, select the account that's locked, and find the parameter that was reached. Raise it, clear it, or toggle it off so your current P&amp;L sits inside the new threshold, then save. On a self-funded live or demo account this lifts the lock for the current session; on a prop or evaluation account the firm controls it." },
    { q: "I accidentally saved a risk value at $0 and got liquidated. How do I fix it?", a: "Saving a Risk Setting at $0 tells the platform your limit is already breached, so it liquidates open positions and cancels working orders immediately. Open Risk Settings, disable that parameter or change it to a value above zero, and save. Your positions are already closed, but this stops the account from re-liquidating and lets you trade the next session." },
    { q: "When does a Tradovate daily loss-limit lockout reset?", a: "A daily limit clears at the start of the next trading session, 5:00 PM Central Time the same day. A weekly limit clears at the start of the next week, 5:00 PM Central Time on Sunday. On a self-funded account you can reopen sooner by changing the limit in Risk Settings." },
    { q: "My Risk Settings look fine but the account is still stuck. What now?", a: "If the daily reset didn't fire, the panel won't load or save, or the account stays in Liquidation-Only even with the limits cleared, treat it as a platform-side glitch rather than a normal reset. Confirm you edited the correct account and that the save went through, sign out and back in, and if it's still stuck contact Tradovate support directly to have the account state cleared." },
    { q: "Can I change the risk settings on my prop firm's Tradovate account?", a: "No. On a prop or evaluation account the risk parameters are set and locked by the firm, so you can't edit them and Tradovate can't override them. Contact your prop provider to confirm which rule tripped and whether the account resets automatically or needs a reset. The one narrow exception is Trailing Max Drawdown, which is handled by the orders desk." },
    { q: "Does Tradovate charge a fee when it auto-liquidates my account?", a: "When the system force-liquidates for a risk or margin breach it can apply a liquidation fee. The exact amount is on Tradovate's current admin-fee schedule and can change, so check the live fee list. The practical takeaway is to keep a buffer and set your own limits deliberately so the platform never has to liquidate you." },
  ], de: [
    { q: "Warum ist mein Tradovate-Live-Konto für den Handel gesperrt?", a: "In fast allen Fällen wurde eine Risk Setting ausgelöst. Ein Daily Loss Limit, ein Weekly Loss Limit, ein Gewinn-Trigger oder ein versehentlich mit $0 gespeicherter Wert schließt Ihre Positionen und versetzt das Konto in Liquidation-Only, wo Sie schließen, aber keine Trades eröffnen können. Öffnen Sie Ihre Risk Settings, prüfen Sie, welches Limit erreicht wurde, und warten Sie entweder den Sitzungs-Reset ab oder ändern Sie den Wert bei einem selbstfinanzierten Konto." },
    { q: "Wie setze ich meine Tradovate-Risk-Settings zurück, um wieder zu handeln?", a: "Öffnen Sie Application Settings oben rechts in der Plattform, öffnen Sie Risk Settings, wählen Sie das gesperrte Konto aus und suchen Sie den Parameter, der erreicht wurde. Erhöhen Sie ihn, löschen Sie ihn oder schalten Sie ihn aus, sodass Ihr aktueller G&amp;V innerhalb der neuen Schwelle liegt, und speichern Sie. Bei einem selbstfinanzierten Live- oder Demokonto hebt dies die Sperre für die aktuelle Sitzung auf; bei einem Prop- oder Evaluierungskonto kontrolliert die Firma dies." },
    { q: "Ich habe versehentlich einen Risikowert mit $0 gespeichert und wurde liquidiert. Wie behebe ich das?", a: "Das Speichern einer Risk Setting mit $0 teilt der Plattform mit, dass Ihr Limit bereits verletzt ist, sodass sie offene Positionen sofort liquidiert und laufende Orders storniert. Öffnen Sie Risk Settings, deaktivieren Sie diesen Parameter oder ändern Sie ihn auf einen Wert über null, und speichern Sie. Ihre Positionen sind bereits geschlossen, aber so verhindern Sie, dass das Konto erneut liquidiert, und können in der nächsten Sitzung handeln." },
    { q: "Wann wird eine Tradovate-Sperre durch das Daily Loss Limit zurückgesetzt?", a: "Ein Tageslimit wird zu Beginn der nächsten Handelssitzung aufgehoben, am selben Tag um 5:00 PM Central Time. Ein Wochenlimit wird zu Beginn der nächsten Woche aufgehoben, am Sonntag um 5:00 PM Central Time. Bei einem selbstfinanzierten Konto können Sie früher wieder öffnen, indem Sie das Limit in den Risk Settings ändern." },
    { q: "Meine Risk Settings sehen in Ordnung aus, aber das Konto hängt weiterhin. Was nun?", a: "Wenn der tägliche Reset nicht erfolgt ist, das Panel nicht lädt oder nicht speichert oder das Konto selbst bei aufgehobenen Limits in Liquidation-Only bleibt, behandeln Sie es als plattformseitigen Fehler und nicht als normalen Reset. Prüfen Sie, ob Sie das richtige Konto bearbeitet haben und das Speichern erfolgreich war, melden Sie sich ab und wieder an, und wenden Sie sich bei weiterhin bestehender Sperre direkt an den Tradovate-Support, damit der Kontostatus bereinigt wird." },
    { q: "Kann ich die Risikoeinstellungen auf dem Tradovate-Konto meiner Prop-Firma ändern?", a: "Nein. Bei einem Prop- oder Evaluierungskonto werden die Risikoparameter von der Firma festgelegt und gesperrt; Sie können sie nicht bearbeiten, und Tradovate kann sie nicht außer Kraft setzen. Wenden Sie sich an Ihren Prop-Anbieter, um zu bestätigen, welche Regel ausgelöst wurde und ob das Konto automatisch zurückgesetzt wird oder einen Reset benötigt. Die einzige enge Ausnahme ist der Trailing Max Drawdown, der vom Orders Desk bearbeitet wird." },
    { q: "Berechnet Tradovate eine Gebühr, wenn mein Konto automatisch liquidiert wird?", a: "Wenn das System wegen eines Risiko- oder Margin-Verstoßes zwangsliquidiert, kann eine Liquidationsgebühr anfallen. Der genaue Betrag steht in Tradovates aktueller Verwaltungsgebührenliste und kann sich ändern, prüfen Sie daher die aktuelle Gebührenliste. Die praktische Erkenntnis: Halten Sie einen Puffer vor und setzen Sie Ihre eigenen Limits bewusst, damit die Plattform Sie nie liquidieren muss." },
  ], es: [
    { q: "¿Por qué mi cuenta real de Tradovate está bloqueada para operar?", a: "En casi todos los casos se activó un Risk Setting. Un Daily Loss Limit, un Weekly Loss Limit, un disparador de beneficio o un valor guardado por error en $0 cerrará sus posiciones y pondrá la cuenta en Liquidation-Only, donde puede cerrar pero no abrir operaciones. Abra sus Risk Settings, confirme qué límite se alcanzó y espere al reinicio de la sesión o cambie el valor en una cuenta autofinanciada." },
    { q: "¿Cómo restablezco mis Risk Settings de Tradovate para volver a operar?", a: "Abra Application Settings en la parte superior derecha de la plataforma, abra Risk Settings, seleccione la cuenta bloqueada y localice el parámetro que se alcanzó. Auméntelo, bórrelo o desactívelo para que su P&amp;L actual quede dentro del nuevo umbral y guarde. En una cuenta real o demo autofinanciada esto levanta el bloqueo durante la sesión actual; en una cuenta prop o de evaluación lo controla la firma." },
    { q: "Guardé por error un valor de riesgo en $0 y me liquidaron. ¿Cómo lo arreglo?", a: "Guardar un Risk Setting en $0 le indica a la plataforma que su límite ya está superado, por lo que liquida de inmediato las posiciones abiertas y cancela las órdenes activas. Abra Risk Settings, desactive ese parámetro o cámbielo a un valor superior a cero y guarde. Sus posiciones ya están cerradas, pero esto evita que la cuenta vuelva a liquidar y le permite operar en la siguiente sesión." },
    { q: "¿Cuándo se restablece un bloqueo por límite de pérdida diaria de Tradovate?", a: "Un límite diario se levanta al inicio de la siguiente sesión de trading, a las 5:00 PM hora central (Central Time) del mismo día. Un límite semanal se levanta al inicio de la semana siguiente, a las 5:00 PM hora central del domingo. En una cuenta autofinanciada puede reabrir antes cambiando el límite en Risk Settings." },
    { q: "Mis Risk Settings parecen estar bien pero la cuenta sigue bloqueada. ¿Y ahora?", a: "Si el reinicio diario no se activó, el panel no carga o no guarda, o la cuenta sigue en Liquidation-Only incluso con los límites borrados, trátelo como un fallo de la plataforma y no como un reinicio normal. Confirme que editó la cuenta correcta y que el guardado se realizó, cierre sesión y vuelva a entrar y, si sigue bloqueada, contacte directamente con el soporte de Tradovate para que borren el estado de la cuenta." },
    { q: "¿Puedo cambiar los ajustes de riesgo en la cuenta de Tradovate de mi firma prop?", a: "No. En una cuenta prop o de evaluación, los parámetros de riesgo los fija y bloquea la firma, por lo que usted no puede editarlos y Tradovate no puede anularlos. Contacte con su proveedor prop para confirmar qué regla se activó y si la cuenta se restablece automáticamente o necesita un reinicio. La única excepción limitada es el Trailing Max Drawdown, que gestiona el orders desk." },
    { q: "¿Cobra Tradovate una comisión cuando liquida automáticamente mi cuenta?", a: "Cuando el sistema liquida a la fuerza por un incumplimiento de riesgo o de margen, puede aplicar una comisión de liquidación. El importe exacto figura en el calendario vigente de tarifas administrativas de Tradovate y puede cambiar, así que consulte la lista de tarifas actual. La conclusión práctica es mantener un margen de seguridad y fijar sus propios límites deliberadamente para que la plataforma nunca tenga que liquidarle." },
  ], fr: [
    { q: "Pourquoi mon compte réel Tradovate est-il bloqué pour le trading ?", a: "Dans presque tous les cas, un Risk Setting s'est déclenché. Un Daily Loss Limit, un Weekly Loss Limit, un déclencheur de profit ou une valeur enregistrée par erreur à $0 clôturera vos positions et placera le compte en Liquidation-Only, où vous pouvez fermer mais pas ouvrir de trades. Ouvrez vos Risk Settings, confirmez quelle limite a été atteinte, puis attendez la réinitialisation de la session ou modifiez la valeur sur un compte autofinancé." },
    { q: "Comment réinitialiser mes Risk Settings Tradovate pour pouvoir trader à nouveau ?", a: "Ouvrez Application Settings en haut à droite de la plateforme, ouvrez Risk Settings, sélectionnez le compte bloqué et trouvez le paramètre qui a été atteint. Augmentez-le, effacez-le ou désactivez-le afin que votre P&amp;L actuel se situe dans le nouveau seuil, puis enregistrez. Sur un compte réel ou démo autofinancé, cela lève le blocage pour la session en cours ; sur un compte prop ou d'évaluation, c'est la société qui le contrôle." },
    { q: "J'ai enregistré par erreur une valeur de risque à $0 et j'ai été liquidé. Comment corriger cela ?", a: "Enregistrer un Risk Setting à $0 indique à la plateforme que votre limite est déjà dépassée ; elle liquide donc immédiatement les positions ouvertes et annule les ordres actifs. Ouvrez Risk Settings, désactivez ce paramètre ou définissez une valeur supérieure à zéro, puis enregistrez. Vos positions sont déjà fermées, mais cela empêche le compte de liquider de nouveau et vous permet de trader à la prochaine session." },
    { q: "Quand le blocage lié à la limite de perte quotidienne de Tradovate est-il levé ?", a: "Une limite quotidienne est levée au début de la prochaine session de trading, à 5:00 PM heure centrale (Central Time) le même jour. Une limite hebdomadaire est levée au début de la semaine suivante, à 5:00 PM heure centrale le dimanche. Sur un compte autofinancé, vous pouvez rouvrir plus tôt en modifiant la limite dans Risk Settings." },
    { q: "Mes Risk Settings semblent corrects mais le compte reste bloqué. Que faire ?", a: "Si la réinitialisation quotidienne ne s'est pas déclenchée, si le panneau ne se charge pas ou n'enregistre pas, ou si le compte reste en Liquidation-Only même avec les limites levées, considérez qu'il s'agit d'un dysfonctionnement côté plateforme et non d'une réinitialisation normale. Vérifiez que vous avez modifié le bon compte et que l'enregistrement a abouti, déconnectez-vous puis reconnectez-vous, et si le compte reste bloqué, contactez directement le support Tradovate pour faire lever l'état du compte." },
    { q: "Puis-je modifier les paramètres de risque du compte Tradovate de ma société de prop trading ?", a: "Non. Sur un compte prop ou d'évaluation, les paramètres de risque sont définis et verrouillés par la société ; vous ne pouvez donc pas les modifier et Tradovate ne peut pas les outrepasser. Contactez votre fournisseur prop pour confirmer quelle règle s'est déclenchée et si le compte se réinitialise automatiquement ou nécessite une réinitialisation. La seule exception limitée est le Trailing Max Drawdown, géré par l'orders desk." },
    { q: "Tradovate facture-t-il des frais lorsqu'il liquide automatiquement mon compte ?", a: "Lorsque le système liquide de force pour un dépassement de risque ou de marge, il peut appliquer des frais de liquidation. Le montant exact figure dans la grille actuelle des frais administratifs de Tradovate et peut changer, consultez donc la liste des frais en vigueur. L'enseignement pratique : gardez une marge de sécurité et fixez vos propres limites de façon délibérée pour que la plateforme n'ait jamais à vous liquider." },
  ], it: [
    { q: "Perché il mio conto live di Tradovate è bloccato per il trading?", a: "Quasi sempre è scattato un Risk Setting. Un Daily Loss Limit, un Weekly Loss Limit, un trigger di profitto o un valore salvato per errore a $0 chiuderà le Sue posizioni e porrà il conto in Liquidation-Only, dove può chiudere ma non aprire operazioni. Apra i Suoi Risk Settings, verifichi quale limite è stato raggiunto e attenda il reset della sessione oppure modifichi il valore su un conto autofinanziato." },
    { q: "Come reimposto i miei Risk Settings di Tradovate per poter operare di nuovo?", a: "Apra Application Settings in alto a destra nella piattaforma, apra Risk Settings, selezioni il conto bloccato e trovi il parametro che è stato raggiunto. Lo aumenti, lo cancelli o lo disattivi in modo che il Suo P&amp;L attuale rientri nella nuova soglia, quindi salvi. Su un conto live o demo autofinanziato questo toglie il blocco per la sessione corrente; su un conto prop o di valutazione lo controlla la società." },
    { q: "Ho salvato per errore un valore di rischio a $0 e sono stato liquidato. Come lo risolvo?", a: "Salvare un Risk Setting a $0 dice alla piattaforma che il Suo limite è già stato violato, quindi liquida subito le posizioni aperte e annulla gli ordini attivi. Apra Risk Settings, disattivi quel parametro o lo imposti a un valore superiore a zero e salvi. Le Sue posizioni sono già chiuse, ma questo impedisce al conto di liquidare di nuovo e Le permette di operare nella sessione successiva." },
    { q: "Quando si azzera un blocco per il limite di perdita giornaliera di Tradovate?", a: "Un limite giornaliero viene rimosso all'inizio della sessione di trading successiva, alle 5:00 PM ora centrale (Central Time) dello stesso giorno. Un limite settimanale viene rimosso all'inizio della settimana successiva, alle 5:00 PM ora centrale della domenica. Su un conto autofinanziato può riaprire prima modificando il limite in Risk Settings." },
    { q: "I miei Risk Settings sembrano a posto ma il conto è ancora bloccato. E ora?", a: "Se il reset giornaliero non è scattato, il pannello non si carica o non salva, o il conto resta in Liquidation-Only anche con i limiti rimossi, lo consideri un malfunzionamento lato piattaforma e non un normale reset. Verifichi di aver modificato il conto giusto e che il salvataggio sia andato a buon fine, esca e rientri e, se è ancora bloccato, contatti direttamente il supporto di Tradovate per far ripulire lo stato del conto." },
    { q: "Posso modificare le impostazioni di rischio sul conto Tradovate della mia prop firm?", a: "No. Su un conto prop o di valutazione i parametri di rischio sono impostati e bloccati dalla società, quindi Lei non può modificarli e Tradovate non può scavalcarli. Contatti il Suo fornitore prop per confermare quale regola è scattata e se il conto si azzera automaticamente o richiede un reset. L'unica eccezione limitata è il Trailing Max Drawdown, gestito dall'orders desk." },
    { q: "Tradovate addebita una commissione quando liquida automaticamente il mio conto?", a: "Quando il sistema liquida forzatamente per una violazione di rischio o di margine, può applicare una commissione di liquidazione. L'importo esatto è riportato nel listino delle commissioni amministrative corrente di Tradovate e può cambiare, quindi consulti l'elenco commissioni in vigore. La conclusione pratica è mantenere un margine di sicurezza e impostare deliberatamente i propri limiti, così la piattaforma non dovrà mai liquidarLa." },
  ] },
  relatedHeading: { en: "Related Guides", de: "Weitere Anleitungen", es: "Guías relacionadas", fr: "Guides associés", it: "Guide correlate" },
  disclosureText: { en: "This guide is for educational and informational purposes only and is not financial, investment, or trading advice. Trading futures and other leveraged products carries a substantial risk of loss and is not suitable for every investor. PickMyTrade is an independent third-party automation platform and is not affiliated with, endorsed by, or sponsored by Tradovate, Inc. All related names, logos, and trademarks are the property of their respective owners. Platform features and steps change over time, so always confirm the current process in the official platform documentation before acting.", de: "Diese Anleitung dient ausschließlich Bildungs- und Informationszwecken und stellt keine Finanz-, Anlage- oder Handelsberatung dar. Der Handel mit Futures und anderen gehebelten Produkten birgt ein erhebliches Verlustrisiko und ist nicht für jeden Anleger geeignet. PickMyTrade ist eine unabhängige Automatisierungsplattform eines Drittanbieters und steht in keiner Verbindung zu Tradovate, Inc., wird von dieser weder unterstützt noch gesponsert. Alle genannten Namen, Logos und Marken sind Eigentum ihrer jeweiligen Inhaber. Funktionen und Schritte der Plattform ändern sich im Laufe der Zeit; prüfen Sie daher stets den aktuellen Ablauf in der offiziellen Plattformdokumentation, bevor Sie handeln.", es: "Esta guía tiene fines exclusivamente educativos e informativos y no constituye asesoramiento financiero, de inversión ni de trading. Operar con futuros y otros productos apalancados conlleva un riesgo sustancial de pérdida y no es adecuado para todos los inversores. PickMyTrade es una plataforma de automatización independiente de terceros y no está afiliada, respaldada ni patrocinada por Tradovate, Inc. Todos los nombres, logotipos y marcas relacionados son propiedad de sus respectivos dueños. Las funciones y los pasos de la plataforma cambian con el tiempo, por lo que debe confirmar siempre el proceso vigente en la documentación oficial de la plataforma antes de actuar.", fr: "Ce guide est fourni à des fins éducatives et informatives uniquement et ne constitue pas un conseil financier, d'investissement ou de trading. Le trading de contrats à terme et d'autres produits à effet de levier comporte un risque substantiel de perte et ne convient pas à tous les investisseurs. PickMyTrade est une plateforme d'automatisation tierce indépendante et n'est ni affiliée à Tradovate, Inc., ni approuvée ou parrainée par celle-ci. Tous les noms, logos et marques associés sont la propriété de leurs détenteurs respectifs. Les fonctionnalités et les étapes de la plateforme évoluent avec le temps ; vérifiez donc toujours la procédure en vigueur dans la documentation officielle de la plateforme avant d'agir.", it: "Questa guida ha scopi esclusivamente educativi e informativi e non costituisce consulenza finanziaria, di investimento o di trading. Il trading di futures e di altri prodotti a leva comporta un rischio sostanziale di perdita e non è adatto a tutti gli investitori. PickMyTrade è una piattaforma di automazione indipendente di terze parti e non è affiliata, approvata né sponsorizzata da Tradovate, Inc. Tutti i nomi, i loghi e i marchi correlati sono di proprietà dei rispettivi titolari. Le funzionalità e i passaggi della piattaforma cambiano nel tempo, quindi confermi sempre la procedura corrente nella documentazione ufficiale della piattaforma prima di agire." },
};
