---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "ios-no-account-after-faceid";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/debugging/${SLUG}`;

const META_TITLE = "Tradovate iOS App Shows 'No Account' After Face ID";
const META_DESCRIPTION =
  "Tradovate iOS app showing 'No Account' after Face ID? Log out and back in manually to restore your account and get straight back to trading.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Tradovate iOS-App zeigt „No Account“ nach Face ID", es: "La app de Tradovate para iOS muestra «No Account» tras Face ID", fr: "L'application Tradovate iOS affiche « No Account » après Face ID", it: "L'app Tradovate per iOS mostra «No Account» dopo Face ID" },
  dek: { en: "Face ID unlocks the Tradovate iOS app in an instant, but the account screen comes back blank. Here's why that happens and the thirty-second fix that brings your account back.", de: "Face ID entsperrt die Tradovate iOS-App im Nu, doch der Konto-Bildschirm bleibt leer. Hier erfahren Sie, warum das passiert und welche Dreißig-Sekunden-Lösung Ihr Konto zurückbringt.", es: "Face ID desbloquea la app de Tradovate para iOS al instante, pero la pantalla de la cuenta aparece en blanco. Le explicamos por qué ocurre y la solución de treinta segundos que recupera su cuenta.", fr: "Face ID déverrouille l'application Tradovate iOS instantanément, mais l'écran du compte reste vide. Voici pourquoi cela se produit et la solution de trente secondes qui fait revenir votre compte.", it: "Face ID sblocca l'app Tradovate per iOS in un istante, ma la schermata dell'account resta vuota. Ecco perché succede e la soluzione di trenta secondi che fa tornare il Suo account." },
  readTime: { en: "6 min read", de: "6 Min. Lesezeit", es: "Lectura de 6 min", fr: "Lecture : 6 min", it: "Lettura di 6 min" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "You open Tradovate on your iPhone, Face ID scans your face, the app unlocks in a fraction of a second, and where your account should be, it just says <strong class='text-white'>No Account</strong>. No balance, no open positions, no order ticket. The one screen you actually need is blank. That's a gut-punch when the market's moving and you were counting on a quick tap-and-go login. Here's the reassuring part: your account is fine, nothing has been closed or wiped, and the fix takes about thirty seconds. Let's walk through what's happening and how to get your account back on screen fast." },
    {
      type: "checklist",
      heading: "Quick Checklist for the 'No Account' Screen",
      items: [
        "<strong class='text-white'>Log out fully, then log back in with your username and password,</strong> not Face ID. This is the fix nine times out of ten.",
        "<strong class='text-white'>Skip Face ID for one login</strong> and type your credentials so the app builds a fresh, complete session that actually loads your accounts.",
        "<strong class='text-white'>Force-close and reopen the app first</strong> to rule out a screen that's simply stuck.",
        "<strong class='text-white'>Check Face ID for the app in iOS Settings</strong> if biometric login keeps landing you on a blank account.",
        "<strong class='text-white'>Update or reinstall the app</strong> if the blank-account screen sticks around even after a manual login.",
        "<strong class='text-white'>Use the web or desktop platform</strong> to manage open positions while you sort the phone out.",
      ],
    },
    { type: "heading", text: "What \"No Account After Face ID\" Actually Means" },
    { type: "paragraph", html: "When you sign in to Tradovate on mobile, two things have to happen: the app has to authenticate you, and then it has to fetch the list of trading accounts tied to your login and drop you into one of them. Face ID handles the first part beautifully, it unlocks the app using a session it saved the last time you were signed in. The problem is the second part. If that saved session is incomplete or stale, the app treats you as logged in but never re-runs the step that pulls your accounts, so the account field comes back empty and you see <strong class='text-white'>No Account</strong>." },
    { type: "paragraph", html: "This is worth separating from the other login errors you might have hit before. It isn't a wrong password, because Face ID let you in. It isn't a two-factor or device-approval prompt, because there's no prompt at all. And it isn't an entitlement or subscription block, those throw a specific message rather than a silent blank. What you're looking at is a session-state hiccup: the biometric shortcut resumed a session that didn't carry your account list with it." },
    { type: "paragraph", html: "That's exactly why the manual re-login works so reliably. A full logout throws the half-loaded session away, and signing back in with your username and password runs the whole sequence from scratch, account fetch included. It shows up more often right after an app update changes how sessions are cached, a hint that the build, not your phone, is usually the trigger." },
    { type: "heading", text: "Top Causes of the Tradovate 'No Account' Screen" },
    { type: "heading", text: "1. Face ID resumed a partial session" },
    { type: "paragraph", html: "This is the headline cause. Face ID is designed to skip you past the full login flow by reusing a stored session. When that stored session is missing the account data, because it expired, was interrupted, or was written incompletely, you get authenticated but land on an empty account screen. The app isn't broken; it just resumed the wrong snapshot." },
    { type: "heading", text: "2. A recent app update changed how sessions are cached" },
    { type: "paragraph", html: "Blank-account-after-biometric problems cluster around app updates. When a new build tweaks the way login sessions are stored and restored, the older cached session on your device can stop lining up with what the new build expects. The app opens, Face ID passes, and the mismatch leaves your account list empty until you sign in fresh." },
    { type: "heading", text: "3. A stale or expired token behind the biometric unlock" },
    { type: "paragraph", html: "Sessions don't last forever. If your saved session has aged out but Face ID still unlocks the app shell, you end up in limbo, logged in enough to open the app, not logged in enough to load an account. A clean credential login mints a new token and clears it." },
    { type: "heading", text: "4. Face ID is misconfigured for the app" },
    { type: "paragraph", html: "Sometimes the biometric layer itself is the weak link. If Face ID is disabled for the app in your iPhone settings, was recently reset, or is failing intermittently, the login can finish in an odd half-state. Worth a look when the blank account keeps coming back on Face ID logins but never on manual ones." },
    { type: "heading", text: "5. An account-level state that also shows up elsewhere" },
    { type: "paragraph", html: "Occasionally the blank screen isn't about Face ID at all, the account genuinely isn't loading yet. A brand-new prop-firm evaluation that hasn't finished provisioning, or an account the firm hasn't enabled, can read as &ldquo;No Account&rdquo; on the app too. Provisioning windows and account rules vary by firm and account size, so if a clean login still shows nothing, check your firm's current process before blaming the app." },
    { type: "heading", text: "How to Fix the 'No Account' Screen: Step-by-Step" },
    {
      type: "steps",
      items: [
        { title: "Fix a partial session (log out and back in manually)", html: "This is the one that clears it almost every time, so start here. Open the app's menu or account/settings area and choose <strong class='text-white'>Log Out</strong> (confirm the exact label in your build; fully signing out is the important part, don't just force-close). On the login screen, <em>skip Face ID</em> for this one login and type your Tradovate username and password by hand. Sign in. The app now runs the full login sequence, re-fetches your account list, and drops you into your account instead of a blank screen." },
        { title: "Fix a stuck screen (force-close first, if you haven't)", html: "From the home screen, swipe up from the bottom (or double-press Home on older devices) to open the App Switcher. Find the Tradovate card and swipe it up and off the screen to fully quit the app. Reopen it. If the blank account was just a frozen screen rather than a bad session, it may load correctly now. If Face ID still lands you on &ldquo;No Account,&rdquo; move on to the manual login above." },
        { title: "Fix biometric configuration (check Face ID in iOS Settings)", html: "Open <strong class='text-white'>Settings &rsaquo; Face ID &amp; Passcode</strong> and confirm Face ID is turned on for the Tradovate app under Other Apps. If it keeps misbehaving, toggle Face ID off for the app, log in manually once, then toggle it back on so it re-registers cleanly. Still flaky? Tap Reset Face ID and set it up again, restart the iPhone, and make sure iOS is up to date." },
        { title: "Fix a stale build (update or reinstall the app)", html: "Open the <strong class='text-white'>App Store</strong>, search Tradovate, and install any pending update. If a blank account survives a manual login, press and hold the app icon, delete the app to wipe its stored session data, then reinstall it from the App Store and log back in with your username and password." },
        { title: "Fix it when the account still won't show (use web/desktop, then check the source)", html: "If a clean reinstall and a manual login still show &ldquo;No Account,&rdquo; stop troubleshooting the phone, the account isn't loading from higher up. Log in to the <strong class='text-white'>Tradovate web platform in a browser</strong> or the desktop app to confirm the account is active and visible there. If it's a prop-firm evaluation that's blank everywhere, contact your firm, the account may still be provisioning or need enabling on their end." },
      ],
    },
    { type: "quote", html: "If iOS autofill won't populate your saved credentials, type them in or copy-paste from your password manager. The goal is simply a fresh username-and-password login that rebuilds the session, however you get the characters into the fields is fine." },
    { type: "heading", text: "Troubleshooting Table" },
    {
      type: "table",
      headers: ["Symptom", "What it means", "Fix"],
      rows: [
        ["Face ID unlocks the app but the account is blank", "Biometric login resumed a partial session", "Log out fully, sign back in with username and password"],
        ["Manual logins work, Face ID logins go blank", "Biometric config or a stale saved session", "Toggle/reset Face ID for the app in iOS Settings"],
        ["Blank account started right after an app update", "New build changed how sessions are cached", "Install the next update, then delete and reinstall"],
        ["Blank even after a clean username-and-password login", "Account isn't loading from the server side", "Confirm on web/desktop; check with your prop firm"],
        ["Screen frozen rather than genuinely empty", "Stuck UI, not a session problem", "Force-close from the App Switcher and reopen"],
        ["Face ID itself is failing across other apps", "Device-level biometric issue", "Reset Face ID, restart, and update iOS"],
      ],
    },
    { type: "heading", text: "Prevent This with PickMyTrade" },
    { type: "paragraph", html: "A blank account screen at the wrong moment shouldn't be the thing standing between your strategy and the market. PickMyTrade connects your TradingView alerts straight to your Tradovate account on the server side, so your orders keep firing whether or not your phone cooperates:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Server-side execution</strong>, your automation runs on PickMyTrade's infrastructure, not your handset, so a biometric login glitch never stalls a trade.",
        "<strong class='text-white'>Multi-account sync</strong>, mirror the same orders across every connected account without touching the mobile app's account picker.",
        "<strong class='text-white'>Reliable alert-to-order routing</strong>, TradingView signals reach Tradovate through a stable bridge instead of a fragile mobile session.",
        "<strong class='text-white'>Hands-off risk management</strong>, attach stops and targets automatically so open positions stay protected while you rebuild the app login.",
      ],
    },
  ], de: [
    { type: "paragraph",html: "Sie öffnen Tradovate auf Ihrem iPhone, Face ID scannt Ihr Gesicht, die App entsperrt sich in Sekundenbruchteilen, und dort, wo Ihr Konto sein sollte, steht nur <strong class='text-white'>No Account</strong>. Kein Kontostand, keine offenen Positionen, kein Order-Ticket. Genau der Bildschirm, den Sie brauchen, ist leer. Das ist ein Schlag in die Magengrube, wenn sich der Markt bewegt und Sie auf eine schnelle Anmeldung per Fingertipp gesetzt haben. Die beruhigende Nachricht: Ihr Konto ist in Ordnung, nichts wurde geschlossen oder gelöscht, und die Lösung dauert etwa dreißig Sekunden. Sehen wir uns an, was passiert und wie Sie Ihr Konto schnell wieder auf den Bildschirm bekommen." },
    {
      type: "checklist",
      heading: "Kurze Checkliste für den „No Account“-Bildschirm",
      items: [
        "<strong class='text-white'>Melden Sie sich vollständig ab und mit Benutzername und Passwort wieder an,</strong> nicht mit Face ID. Das ist in neun von zehn Fällen die Lösung.",
        "<strong class='text-white'>Überspringen Sie Face ID für eine Anmeldung</strong> und geben Sie Ihre Zugangsdaten ein, damit die App eine frische, vollständige Sitzung aufbaut, die Ihre Konten tatsächlich lädt.",
        "<strong class='text-white'>Beenden Sie die App zuerst zwangsweise und öffnen Sie sie neu,</strong> um auszuschließen, dass der Bildschirm nur hängt.",
        "<strong class='text-white'>Prüfen Sie Face ID für die App in den iOS-Einstellungen,</strong> wenn die biometrische Anmeldung Sie immer wieder auf ein leeres Konto führt.",
        "<strong class='text-white'>Aktualisieren Sie die App oder installieren Sie sie neu,</strong> wenn der leere Konto-Bildschirm auch nach einer manuellen Anmeldung bleibt.",
        "<strong class='text-white'>Nutzen Sie die Web- oder Desktop-Plattform,</strong> um offene Positionen zu verwalten, während Sie das Handy in Ordnung bringen.",
      ],
    },
    { type: "heading",text: "Was „No Account nach Face ID“ tatsächlich bedeutet" },
    { type: "paragraph",html: "Wenn Sie sich in Tradovate auf dem Handy anmelden, müssen zwei Dinge geschehen: Die App muss Sie authentifizieren und dann die Liste der mit Ihrem Login verknüpften Handelskonten abrufen und Sie in eines davon führen. Face ID erledigt den ersten Teil hervorragend, es entsperrt die App mit einer Sitzung, die bei Ihrer letzten Anmeldung gespeichert wurde. Das Problem ist der zweite Teil. Ist diese gespeicherte Sitzung unvollständig oder veraltet, behandelt die App Sie als angemeldet, führt den Schritt zum Abrufen Ihrer Konten aber nicht erneut aus, sodass das Kontofeld leer bleibt und Sie <strong class='text-white'>No Account</strong> sehen." },
    { type: "paragraph",html: "Das sollten Sie von anderen Anmeldefehlern unterscheiden, auf die Sie früher gestoßen sein könnten. Es ist kein falsches Passwort, denn Face ID hat Sie hineingelassen. Es ist keine Zwei-Faktor- oder Geräte-Freigabe-Abfrage, denn es gibt gar keine Abfrage. Und es ist keine Berechtigungs- oder Abonnementsperre, denn diese zeigen eine konkrete Meldung statt eines stillen leeren Bildschirms. Was Sie sehen, ist ein Sitzungszustands-Problem: Die biometrische Abkürzung hat eine Sitzung fortgesetzt, die Ihre Kontoliste nicht mitgebracht hat." },
    { type: "paragraph",html: "Genau deshalb funktioniert die manuelle erneute Anmeldung so zuverlässig. Eine vollständige Abmeldung verwirft die halb geladene Sitzung, und die Anmeldung mit Benutzername und Passwort durchläuft die gesamte Abfolge von Grund auf, einschließlich des Kontoabrufs. Es tritt häufiger kurz nach einem App-Update auf, das die Zwischenspeicherung von Sitzungen ändert, ein Hinweis darauf, dass meist der Build und nicht Ihr Handy der Auslöser ist." },
    { type: "heading",text: "Die häufigsten Ursachen für den Tradovate-„No Account“-Bildschirm" },
    { type: "heading",text: "1. Face ID hat eine unvollständige Sitzung fortgesetzt" },
    { type: "paragraph",html: "Dies ist die Hauptursache. Face ID soll Sie am vollständigen Anmeldeablauf vorbeiführen, indem es eine gespeicherte Sitzung wiederverwendet. Fehlen in dieser gespeicherten Sitzung die Kontodaten, weil sie abgelaufen ist, unterbrochen oder unvollständig geschrieben wurde, werden Sie authentifiziert, landen aber auf einem leeren Konto-Bildschirm. Die App ist nicht kaputt; sie hat lediglich den falschen Schnappschuss fortgesetzt." },
    { type: "heading",text: "2. Ein aktuelles App-Update hat die Zwischenspeicherung von Sitzungen geändert" },
    { type: "paragraph",html: "Probleme mit leerem Konto nach biometrischer Anmeldung häufen sich rund um App-Updates. Wenn ein neuer Build die Art ändert, wie Anmeldesitzungen gespeichert und wiederhergestellt werden, kann die ältere zwischengespeicherte Sitzung auf Ihrem Gerät nicht mehr zu dem passen, was der neue Build erwartet. Die App öffnet sich, Face ID besteht, und die Abweichung hinterlässt eine leere Kontoliste, bis Sie sich neu anmelden." },
    { type: "heading",text: "3. Ein veralteter oder abgelaufener Token hinter der biometrischen Entsperrung" },
    { type: "paragraph",html: "Sitzungen halten nicht ewig. Ist Ihre gespeicherte Sitzung abgelaufen, Face ID entsperrt aber dennoch die App-Hülle, befinden Sie sich in der Schwebe: angemeldet genug, um die App zu öffnen, aber nicht angemeldet genug, um ein Konto zu laden. Eine saubere Anmeldung mit Zugangsdaten erzeugt einen neuen Token und behebt das." },
    { type: "heading",text: "4. Face ID ist für die App falsch konfiguriert" },
    { type: "paragraph",html: "Manchmal ist die biometrische Ebene selbst das schwache Glied. Ist Face ID in den iPhone-Einstellungen für die App deaktiviert, wurde es kürzlich zurückgesetzt oder fällt zeitweise aus, kann die Anmeldung in einem merkwürdigen Halbzustand enden. Einen Blick wert, wenn das leere Konto bei Anmeldungen mit Face ID immer wieder auftritt, bei manuellen aber nie." },
    { type: "heading",text: "5. Ein Kontozustand, der auch anderswo auftritt" },
    { type: "paragraph",html: "Gelegentlich hat der leere Bildschirm gar nichts mit Face ID zu tun, das Konto lädt schlicht noch nicht. Eine brandneue Prop-Firm-Evaluierung, die noch nicht fertig bereitgestellt wurde, oder ein Konto, das die Firma nicht freigeschaltet hat, kann in der App ebenfalls als &ldquo;No Account&rdquo; erscheinen. Bereitstellungsfristen und Kontoregeln unterscheiden sich je nach Firma und Kontogröße. Wenn eine saubere Anmeldung also weiterhin nichts anzeigt, prüfen Sie den aktuellen Ablauf Ihrer Firma, bevor Sie der App die Schuld geben." },
    { type: "heading",text: "So beheben Sie den „No Account“-Bildschirm: Schritt für Schritt" },
    {
      type: "steps",
      items: [
        { title: "Unvollständige Sitzung beheben (abmelden und manuell wieder anmelden)", html: "Das ist die Lösung, die das Problem fast immer behebt, beginnen Sie also hier. Öffnen Sie das Menü bzw. den Konto-/Einstellungsbereich der App und wählen Sie <strong class='text-white'>Log Out</strong> (prüfen Sie die genaue Bezeichnung in Ihrem Build; entscheidend ist das vollständige Abmelden, beenden Sie die App nicht nur zwangsweise). Überspringen Sie auf dem Anmeldebildschirm für diese eine Anmeldung <em>Face ID</em> und geben Sie Ihren Tradovate-Benutzernamen und Ihr Passwort von Hand ein. Melden Sie sich an. Die App durchläuft nun die vollständige Anmeldeabfolge, ruft Ihre Kontoliste erneut ab und führt Sie in Ihr Konto statt auf einen leeren Bildschirm." },
        { title: "Hängenden Bildschirm beheben (zuerst die App zwangsweise beenden, falls noch nicht geschehen)", html: "Wischen Sie auf dem Home-Bildschirm vom unteren Rand nach oben (bzw. drücken Sie bei älteren Geräten zweimal die Home-Taste), um den App-Umschalter zu öffnen. Suchen Sie die Tradovate-Karte und wischen Sie sie nach oben vom Bildschirm, um die App vollständig zu beenden. Öffnen Sie sie erneut. Wenn der leere Konto-Bildschirm nur ein eingefrorener Bildschirm und keine fehlerhafte Sitzung war, lädt er jetzt möglicherweise korrekt. Führt Face ID Sie weiterhin auf &ldquo;No Account,&rdquo; fahren Sie mit der manuellen Anmeldung oben fort." },
        { title: "Biometrische Konfiguration beheben (Face ID in den iOS-Einstellungen prüfen)", html: "Öffnen Sie <strong class='text-white'>Settings &rsaquo; Face ID &amp; Passcode</strong> und stellen Sie sicher, dass Face ID unter „Other Apps“ für die Tradovate-App aktiviert ist. Verhält es sich weiterhin auffällig, schalten Sie Face ID für die App aus, melden Sie sich einmal manuell an und schalten Sie es wieder ein, damit es sauber neu registriert wird. Immer noch instabil? Tippen Sie auf „Reset Face ID“ und richten Sie es neu ein, starten Sie das iPhone neu und stellen Sie sicher, dass iOS auf dem neuesten Stand ist." },
        { title: "Veralteten Build beheben (App aktualisieren oder neu installieren)", html: "Öffnen Sie den <strong class='text-white'>App Store</strong>, suchen Sie nach Tradovate und installieren Sie ausstehende Updates. Bleibt ein leeres Konto auch nach einer manuellen Anmeldung bestehen, halten Sie das App-Symbol gedrückt, löschen Sie die App, um ihre gespeicherten Sitzungsdaten zu entfernen, installieren Sie sie dann erneut aus dem App Store und melden Sie sich mit Benutzername und Passwort wieder an." },
        { title: "Beheben, wenn das Konto weiterhin nicht erscheint (Web/Desktop nutzen, dann die Quelle prüfen)", html: "Zeigt auch eine saubere Neuinstallation mit manueller Anmeldung weiterhin &ldquo;No Account,&rdquo; hören Sie auf, das Handy zu untersuchen, das Konto wird weiter oben nicht geladen. Melden Sie sich bei der <strong class='text-white'>Tradovate-Webplattform im Browser</strong> oder in der Desktop-App an, um zu bestätigen, dass das Konto dort aktiv und sichtbar ist. Ist es eine Prop-Firm-Evaluierung, die überall leer ist, wenden Sie sich an Ihre Firma, das Konto wird möglicherweise noch bereitgestellt oder muss auf deren Seite freigeschaltet werden." },
      ],
    },
    { type: "quote",html: "Wenn die iOS-Autofill-Funktion Ihre gespeicherten Zugangsdaten nicht einträgt, geben Sie diese von Hand ein oder kopieren Sie sie aus Ihrem Passwortmanager. Ziel ist lediglich eine frische Anmeldung mit Benutzername und Passwort, die die Sitzung neu aufbaut, wie die Zeichen in die Felder gelangen, ist egal." },
    { type: "heading",text: "Tabelle zur Fehlerbehebung" },
    { type: "table", headers: ["Symptom","Was es bedeutet","Lösung"], rows: [
      ["Face ID entsperrt die App, aber das Konto ist leer","Die biometrische Anmeldung hat eine unvollständige Sitzung fortgesetzt","Vollständig abmelden, mit Benutzername und Passwort neu anmelden"],
      ["Manuelle Anmeldungen funktionieren, Face ID-Anmeldungen bleiben leer","Biometrische Konfiguration oder eine veraltete gespeicherte Sitzung","Face ID für die App in den iOS-Einstellungen aus-/einschalten bzw. zurücksetzen"],
      ["Leeres Konto begann direkt nach einem App-Update","Neuer Build hat die Zwischenspeicherung von Sitzungen geändert","Nächstes Update installieren, dann löschen und neu installieren"],
      ["Leer auch nach sauberer Anmeldung mit Benutzername und Passwort","Konto wird nicht von der Serverseite geladen","Im Web/Desktop bestätigen; bei Ihrer Prop Firm nachfragen"],
      ["Bildschirm eingefroren statt tatsächlich leer","Hängende Oberfläche, kein Sitzungsproblem","Im App-Umschalter zwangsweise beenden und neu öffnen"],
      ["Face ID schlägt auch in anderen Apps fehl","Biometrisches Problem auf Geräteebene","Face ID zurücksetzen, neu starten und iOS aktualisieren"],
    ] },
    { type: "heading",text: "Vorbeugen mit PickMyTrade" },
    { type: "paragraph",html: "Ein leerer Konto-Bildschirm im falschen Moment sollte nicht zwischen Ihrer Strategie und dem Markt stehen. PickMyTrade verbindet Ihre TradingView-Alerts serverseitig direkt mit Ihrem Tradovate-Konto, sodass Ihre Orders ausgeführt werden, ganz gleich, ob Ihr Handy mitspielt:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Serverseitige Ausführung</strong>, Ihre Automatisierung läuft auf der Infrastruktur von PickMyTrade, nicht auf Ihrem Handy, sodass ein Fehler bei der biometrischen Anmeldung nie einen Trade blockiert.",
        "<strong class='text-white'>Multi-Konto-Synchronisierung</strong>, spiegeln Sie dieselben Orders auf alle verbundenen Konten, ohne die Kontoauswahl der mobilen App zu berühren.",
        "<strong class='text-white'>Zuverlässiges Alert-zu-Order-Routing</strong>, TradingView-Signale erreichen Tradovate über eine stabile Brücke statt über eine fragile mobile Sitzung.",
        "<strong class='text-white'>Automatisches Risikomanagement</strong>, hängen Sie Stopps und Ziele automatisch an, damit offene Positionen geschützt bleiben, während Sie die App-Anmeldung wiederherstellen.",
      ],
    },
  ], es: [
    { type: "paragraph",html: "Abre Tradovate en su iPhone, Face ID escanea su rostro, la app se desbloquea en una fracción de segundo y, donde debería estar su cuenta, solo aparece <strong class='text-white'>No Account</strong>. Sin saldo, sin posiciones abiertas, sin ticket de órdenes. La única pantalla que realmente necesita está en blanco. Es un golpe cuando el mercado se mueve y contaba con un inicio de sesión rápido con un toque. Lo tranquilizador es esto: su cuenta está bien, no se ha cerrado ni borrado nada, y la solución lleva unos treinta segundos. Veamos qué está ocurriendo y cómo recuperar rápidamente su cuenta en pantalla." },
    {
      type: "checklist",
      heading: "Lista de comprobación rápida para la pantalla «No Account»",
      items: [
        "<strong class='text-white'>Cierre sesión por completo y vuelva a entrar con su nombre de usuario y contraseña,</strong> no con Face ID. Esta es la solución en nueve de cada diez casos.",
        "<strong class='text-white'>Omita Face ID en un inicio de sesión</strong> y escriba sus credenciales para que la app cree una sesión nueva y completa que realmente cargue sus cuentas.",
        "<strong class='text-white'>Fuerce el cierre de la app y vuelva a abrirla primero</strong> para descartar que la pantalla simplemente esté bloqueada.",
        "<strong class='text-white'>Revise Face ID para la app en los ajustes de iOS</strong> si el inicio de sesión biométrico le sigue llevando a una cuenta en blanco.",
        "<strong class='text-white'>Actualice o reinstale la app</strong> si la pantalla de cuenta en blanco persiste incluso tras un inicio de sesión manual.",
        "<strong class='text-white'>Use la plataforma web o de escritorio</strong> para gestionar las posiciones abiertas mientras arregla el teléfono.",
      ],
    },
    { type: "heading",text: "Qué significa realmente «No Account tras Face ID»" },
    { type: "paragraph",html: "Cuando inicia sesión en Tradovate desde el móvil, tienen que ocurrir dos cosas: la app debe autenticarle y luego obtener la lista de cuentas de trading asociadas a su acceso y llevarle a una de ellas. Face ID resuelve de maravilla la primera parte: desbloquea la app con una sesión que guardó la última vez que inició sesión. El problema es la segunda parte. Si esa sesión guardada está incompleta u obsoleta, la app le considera conectado pero nunca vuelve a ejecutar el paso que obtiene sus cuentas, así que el campo de la cuenta aparece vacío y usted ve <strong class='text-white'>No Account</strong>." },
    { type: "paragraph",html: "Conviene distinguirlo de otros errores de inicio de sesión que quizá haya encontrado antes. No es una contraseña incorrecta, porque Face ID le dejó entrar. No es una solicitud de autenticación en dos pasos ni de aprobación de dispositivo, porque no aparece ninguna solicitud. Y no es un bloqueo por permisos o suscripción, ya que esos muestran un mensaje concreto en lugar de un vacío silencioso. Lo que ve es un fallo del estado de la sesión: el atajo biométrico reanudó una sesión que no traía consigo su lista de cuentas." },
    { type: "paragraph",html: "Por eso el nuevo inicio de sesión manual funciona de forma tan fiable. Un cierre de sesión completo descarta la sesión a medio cargar, y al volver a entrar con su nombre de usuario y contraseña se ejecuta toda la secuencia desde cero, incluida la obtención de la cuenta. Aparece con más frecuencia justo después de una actualización de la app que cambia cómo se almacenan en caché las sesiones, una pista de que el desencadenante suele ser la versión y no su teléfono." },
    { type: "heading",text: "Principales causas de la pantalla «No Account» de Tradovate" },
    { type: "heading",text: "1. Face ID reanudó una sesión parcial" },
    { type: "paragraph",html: "Esta es la causa principal. Face ID está diseñado para saltarse el flujo completo de inicio de sesión reutilizando una sesión almacenada. Cuando a esa sesión le faltan los datos de la cuenta, porque caducó, se interrumpió o se escribió de forma incompleta, queda autenticado pero llega a una pantalla de cuenta vacía. La app no está rota; simplemente reanudó la instantánea equivocada." },
    { type: "heading",text: "2. Una actualización reciente de la app cambió cómo se almacenan en caché las sesiones" },
    { type: "paragraph",html: "Los problemas de cuenta en blanco tras el acceso biométrico se concentran en torno a las actualizaciones de la app. Cuando una versión nueva modifica la forma en que se guardan y restauran las sesiones de inicio, la sesión antigua en caché de su dispositivo puede dejar de coincidir con lo que espera la nueva versión. La app se abre, Face ID pasa y la discrepancia deja vacía su lista de cuentas hasta que inicia sesión de nuevo." },
    { type: "heading",text: "3. Un token obsoleto o caducado detrás del desbloqueo biométrico" },
    { type: "paragraph",html: "Las sesiones no duran para siempre. Si su sesión guardada ha caducado pero Face ID sigue desbloqueando la envoltura de la app, queda en un limbo: conectado lo suficiente para abrir la app, pero no lo suficiente para cargar una cuenta. Un inicio de sesión limpio con credenciales genera un token nuevo y lo soluciona." },
    { type: "heading",text: "4. Face ID está mal configurado para la app" },
    { type: "paragraph",html: "A veces el eslabón débil es la propia capa biométrica. Si Face ID está desactivado para la app en los ajustes de su iPhone, se restableció hace poco o falla de forma intermitente, el inicio de sesión puede terminar en un extraño estado intermedio. Merece la pena revisarlo cuando la cuenta en blanco reaparece con los inicios de sesión con Face ID pero nunca con los manuales." },
    { type: "heading",text: "5. Un estado a nivel de cuenta que también aparece en otros lugares" },
    { type: "paragraph",html: "En ocasiones la pantalla en blanco no tiene nada que ver con Face ID: la cuenta simplemente aún no se carga. Una evaluación nueva de una prop firm que no ha terminado de aprovisionarse, o una cuenta que la firma no ha habilitado, también puede aparecer como &ldquo;No Account&rdquo; en la app. Los plazos de aprovisionamiento y las reglas de la cuenta varían según la firma y el tamaño de la cuenta, así que si un inicio de sesión limpio sigue sin mostrar nada, consulte el proceso vigente de su firma antes de culpar a la app." },
    { type: "heading",text: "Cómo solucionar la pantalla «No Account»: paso a paso" },
    {
      type: "steps",
      items: [
        { title: "Solucionar una sesión parcial (cerrar sesión y volver a entrar manualmente)", html: "Esta es la que lo resuelve casi siempre, así que empiece por aquí. Abra el menú o el área de cuenta/ajustes de la app y elija <strong class='text-white'>Log Out</strong> (confirme la etiqueta exacta en su versión; lo importante es cerrar sesión por completo, no basta con forzar el cierre). En la pantalla de inicio de sesión, <em>omita Face ID</em> en este inicio de sesión y escriba a mano su nombre de usuario y contraseña de Tradovate. Inicie sesión. La app ejecuta ahora la secuencia completa de acceso, vuelve a obtener su lista de cuentas y le lleva a su cuenta en lugar de a una pantalla en blanco." },
        { title: "Solucionar una pantalla bloqueada (fuerce primero el cierre, si aún no lo ha hecho)", html: "Desde la pantalla de inicio, deslice hacia arriba desde el borde inferior (o pulse dos veces el botón de inicio en dispositivos antiguos) para abrir el selector de apps. Busque la tarjeta de Tradovate y deslícela hacia arriba fuera de la pantalla para cerrar la app por completo. Vuelva a abrirla. Si la cuenta en blanco era solo una pantalla congelada y no una sesión defectuosa, puede que ahora cargue correctamente. Si Face ID sigue llevándole a &ldquo;No Account,&rdquo; pase al inicio de sesión manual descrito arriba." },
        { title: "Solucionar la configuración biométrica (revisar Face ID en los ajustes de iOS)", html: "Abra <strong class='text-white'>Settings &rsaquo; Face ID &amp; Passcode</strong> y confirme que Face ID está activado para la app de Tradovate en «Other Apps». Si sigue fallando, desactive Face ID para la app, inicie sesión manualmente una vez y vuelva a activarlo para que se registre de nuevo limpiamente. ¿Sigue inestable? Pulse «Reset Face ID» y configúrelo otra vez, reinicie el iPhone y asegúrese de que iOS esté actualizado." },
        { title: "Solucionar una versión obsoleta (actualizar o reinstalar la app)", html: "Abra la <strong class='text-white'>App Store</strong>, busque Tradovate e instale cualquier actualización pendiente. Si la cuenta en blanco persiste tras un inicio de sesión manual, mantenga pulsado el icono de la app, elimine la app para borrar sus datos de sesión almacenados, vuelva a instalarla desde la App Store e inicie sesión de nuevo con su nombre de usuario y contraseña." },
        { title: "Solucionarlo cuando la cuenta sigue sin aparecer (usar web/escritorio y luego revisar el origen)", html: "Si una reinstalación limpia y un inicio de sesión manual siguen mostrando &ldquo;No Account,&rdquo; deje de depurar el teléfono: la cuenta no se está cargando desde un nivel superior. Inicie sesión en la <strong class='text-white'>plataforma web de Tradovate en un navegador</strong> o en la app de escritorio para confirmar que la cuenta está activa y visible allí. Si es una evaluación de una prop firm que está en blanco en todas partes, contacte con su firma: es posible que la cuenta aún se esté aprovisionando o que deba habilitarse por su parte." },
      ],
    },
    { type: "quote",html: "Si el autocompletado de iOS no rellena sus credenciales guardadas, escríbalas o cópielas desde su gestor de contraseñas. El objetivo es simplemente un inicio de sesión nuevo con nombre de usuario y contraseña que reconstruya la sesión; da igual cómo introduzca los caracteres en los campos." },
