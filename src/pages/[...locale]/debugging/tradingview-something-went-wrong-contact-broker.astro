---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "tradingview-something-went-wrong-contact-broker";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/debugging/${SLUG}`;

const META_TITLE = "TradingView 'Something Went Wrong, Contact Broker'";
const META_DESCRIPTION =
  "'Something went wrong, contact your broker' on TradingView? Fund your Tradovate account, enable the add-on and live data to connect without errors.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "TradingView: Fehler „Something Went Wrong, Contact Broker“", es: "TradingView: error «Something Went Wrong, Contact Broker»", fr: "TradingView : erreur « Something Went Wrong, Contact Broker »", it: "TradingView: errore «Something Went Wrong, Contact Broker»" },
  dek: { en: "You pick Tradovate as your broker in TradingView and get a dead-end red banner instead of a live connection. Here's why it's almost always a funding or entitlement gap, and the exact click-path to clear it.", de: "Sie wählen Tradovate als Broker in TradingView und erhalten statt einer Live-Verbindung ein rotes Sackgassen-Banner. Hier erfahren Sie, warum fast immer eine Lücke bei Finanzierung oder Berechtigung dahintersteckt und welchen genauen Klickpfad Sie zur Lösung gehen.", es: "Elige Tradovate como bróker en TradingView y, en lugar de una conexión en vivo, obtiene un banner rojo sin salida. Esto es por qué casi siempre se trata de una carencia de fondos o de habilitación, y el recorrido exacto de clics para resolverla.", fr: "Vous choisissez Tradovate comme courtier dans TradingView et obtenez une bannière rouge sans issue au lieu d'une connexion en direct. Voici pourquoi il s'agit presque toujours d'un défaut d'approvisionnement ou d'habilitation, et le parcours de clics exact pour le résoudre.", it: "Sceglie Tradovate come broker in TradingView e invece di una connessione live ottiene un banner rosso senza uscita. Ecco perché si tratta quasi sempre di una carenza di fondi o di abilitazione, e il percorso di clic esatto per risolverla." },
  readTime: { en: "7 min read", de: "7 Min. Lesezeit", es: "Lectura de 7 min", fr: "Lecture : 7 min", it: "Lettura di 7 min" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "You line up a clean setup on ES or NQ, open the TradingView Trading panel, pick Tradovate as your broker, type your credentials, and instead of a live connection you get a red banner: <strong class='text-white'>\"Something went wrong, contact your broker.\"</strong> No chart order, no DOM, no automation. In fast-moving futures, that dead-end message is more than annoying, it locks you out of your own account at exactly the wrong moment. Here's the good news: this is almost never a mysterious platform bug. Nine times out of ten it means your Tradovate account is missing one of three things, <strong class='text-white'>funding, the TradingView add-on entitlement, or an active live market-data subscription</strong>, and each has a known fix. This guide walks through every cause and the exact click-path to clear it." },
    {
      type: "checklist",
      heading: "Quick Checklist for the \"Something Went Wrong\" Error",
      items: [
        "<strong class='text-white'>Is the account funded?</strong> An unfunded live Tradovate account can't log in to TradingView. Fund it, or connect your Demo account instead.",
        "<strong class='text-white'>Is the TradingView add-on active?</strong> TradingView needs the add-on entitlement enabled on your Tradovate account before it will grant access.",
        "<strong class='text-white'>Do you have live market data?</strong> Trading live through TradingView requires an active Tradovate market-data subscription and signed data agreements.",
        "<strong class='text-white'>Prop-firm or evaluation account?</strong> You don't buy the add-on yourself, your firm enables it. Contact the firm if the error persists.",
        "<strong class='text-white'>Right mode selected?</strong> Choosing \"Live\" when you only have a funded Demo (or the reverse) triggers the error. Match the mode to what your account actually has.",
        "<strong class='text-white'>Credentials and session?</strong> Confirm the username and password are correct and you're not already logged in on too many devices.",
      ],
    },
    { type: "heading", text: "What “Something Went Wrong, Contact Your Broker” Means" },
    { type: "paragraph", html: "Despite the vague wording, this error is a <strong class='text-white'>broker-side entitlement failure</strong>, not a TradingView glitch. When you connect, TradingView asks Tradovate a simple question: \"Is this account allowed to trade through me, and does it have the data to do so?\" If Tradovate answers no, because the account has no funds, no TradingView add-on, or no live market-data subscription, TradingView can't complete the handshake and falls back to the generic \"Something went wrong, contact your broker\" message (you'll sometimes see it phrased \"Something went wrong. Please contact your broker\")." },
    { type: "paragraph", html: "The most common trigger is the simplest one: <strong class='text-white'>if your Tradovate account isn't funded, you won't be able to log in to TradingView at all</strong>, and this is the message you get. Funding is what activates the free Level I CME Group and EUREX market data plus the TradingView access that every live Tradovate Account Plan includes, and those benefits stay live only while the account stays funded." },
    { type: "paragraph", html: "The second layer is entitlement and data. To trade <strong class='text-white'>live</strong> through TradingView, three conditions have to be true at the same time: an active TradingView add-on (or an Account Plan that already bundles TradingView), an active <strong class='text-white'>live</strong> market-data subscription on your Tradovate account, and a funded live account. Miss any one of them and the connection fails. Don't have a funded live account yet? You can still connect your <strong class='text-white'>Demo (Sim)</strong> account to TradingView after subscribing to the standalone TradingView add-on, a common path for traders who want to test before going live." },
    { type: "heading", text: "Top Causes of the “Contact Broker” Error" },
    { type: "heading", text: "1. The live account has no funds" },
    { type: "paragraph", html: "An unfunded live Tradovate account is the number-one cause. Without a deposit, the account never activates its data and TradingView entitlements, so the login gets refused." },
    { type: "heading", text: "2. The TradingView add-on isn't enabled" },
    { type: "paragraph", html: "TradingView can only reach your Tradovate account (live and Sim) once the TradingView add-on is switched on. A brand-new account, or one where the add-on lapsed, will throw the error until it's re-enabled." },
    { type: "heading", text: "3. No active live market-data subscription" },
    { type: "paragraph", html: "Even a funded account with the add-on can fail if it has no live market-data subscription. Live trading through TradingView needs real-time exchange data and the signed non-professional data agreements that go with it." },
    { type: "heading", text: "4. Prop-firm or evaluation account with the add-on not turned on" },
    { type: "paragraph", html: "On a prop or evaluation account, you never buy the add-on yourself, the firm controls whether TradingView is enabled. If the firm hasn't enabled it, or your evaluation isn't fully provisioned, you'll see the same error." },
    { type: "heading", text: "5. Wrong connection mode or stale credentials" },
    { type: "paragraph", html: "Selecting \"Live\" when your funded balance sits in Demo, using an old password, or hitting a device or session limit can all surface as a failed connection." },
    { type: "heading", text: "How to Fix the “Something Went Wrong” Error: Step-by-Step" },
    { type: "heading", text: "Fixing Cause 1: Fund your live Tradovate account" },
    {
      type: "steps",
      items: [
        { title: "Confirm your account", html: "Log in to the Tradovate Web Trader directly (not through TradingView) and confirm which account you're on." },
        { title: "Add funds", html: "Open the funding/deposit area and add funds using your preferred method (ACH, wire, and so on). Deposit timing and minimums <strong class='text-white'>vary by funding method and account type, check Tradovate's current funding rules</strong>." },
        { title: "Wait and retry", html: "Wait for the deposit to post and the account to show as funded, then try the TradingView connection again." },
        { title: "Or connect Demo instead", html: "Just want to test strategies first? Skip funding and connect your <strong class='text-white'>Demo</strong> account instead." },
      ],
    },
    { type: "heading", text: "Fixing Cause 2: Enable the TradingView add-on" },
    {
      type: "steps",
      items: [
        { title: "Open Application Settings", html: "In the Tradovate Web Trader, click the settings gear in the top-right corner (labelled <strong class='text-white'>Application Settings</strong> or <strong class='text-white'>Settings</strong> depending on your build)." },
        { title: "Open Add-ons", html: "Open the <strong class='text-white'>Add-ons</strong> tab." },
        { title: "Enable TradingView", html: "Scroll to the <strong class='text-white'>TradingView add-on</strong> and click <strong class='text-white'>Buy</strong> or enable it. The add-on carries a small recurring fee (around $9.99/month at last check, <strong class='text-white'>pricing varies, so confirm Tradovate's current rate</strong>) and grants TradingView access to both your Live and Sim accounts." },
        { title: "Check your plan first", html: "Some Account Plans already bundle TradingView, if yours does, you don't need the separate add-on. Confirm your plan's inclusions before buying." },
      ],
    },
    { type: "heading", text: "Fixing Cause 3: Turn on live market data" },
    {
      type: "steps",
      items: [
        { title: "Open Market Data Subscription", html: "Still in the Tradovate settings, open the <strong class='text-white'>Market Data Subscription</strong> area." },
        { title: "Subscribe to your exchange data", html: "Subscribe to the exchange data you trade (for example, CME Group Level I). A funded live Account Plan includes free Level I CME Group and EUREX data, but you have to make sure it's active on the account." },
        { title: "Sign the data agreements", html: "Sign any required <strong class='text-white'>non-professional market-data agreements</strong>, live orders and live data stay blocked until these are accepted." },
        { title: "Log out and back in", html: "Log out of Tradovate and TradingView completely, then log back in so the new data entitlement propagates." },
      ],
    },
    { type: "heading", text: "Fixing Cause 4: Prop-firm accounts — ask the firm to enable it" },
    {
      type: "steps",
      items: [
        { title: "Don't try to buy it yourself", html: "<strong class='text-white'>Don't</strong> try to buy the add-on on an evaluation or funded prop account, you can't, and you shouldn't be charged for it." },
        { title: "Contact your firm", html: "Contact your prop firm's support and ask them to confirm the <strong class='text-white'>TradingView add-on is enabled</strong> on your account and that data is provisioned. Which firm and what they enable <strong class='text-white'>varies by firm and account size, check your firm's current rules</strong>." },
        { title: "Give a fresh eval time", html: "If you just purchased an evaluation, give it time to provision. A fresh eval that isn't fully activated shows the same error until the firm finishes setup." },
      ],
    },
    { type: "heading", text: "Fixing Cause 5: Reconnect with the right mode and credentials" },
    {
      type: "steps",
      items: [
        { title: "Open the Trading panel", html: "In TradingView, open the <strong class='text-white'>Trading panel</strong> at the bottom of the chart and select <strong class='text-white'>Tradovate</strong> from the broker list." },
        { title: "Choose the correct account type", html: "Choose the correct account type, <strong class='text-white'>Live</strong> for a funded brokerage account, <strong class='text-white'>Demo</strong> (Sim) for a simulated one, then click <strong class='text-white'>Connect</strong>." },
        { title: "Enter credentials", html: "Enter your Tradovate username and password (or use the linked Google/Apple sign-in) and click <strong class='text-white'>Connect</strong> or <strong class='text-white'>Login</strong>." },
        { title: "Clear other sessions first", html: "If you were already signed in elsewhere, log out of other Tradovate sessions first to avoid device-limit conflicts, then reconnect." },
      ],
    },
    { type: "heading", text: "Troubleshooting Table" },
    {
      type: "table",
      headers: ["Error / Symptom", "What It Means", "Fix"],
      rows: [
        ["Something went wrong, contact your broker", "Broker-side entitlement failed, account not funded, no add-on, or no live data", "Fund the account, enable the TradingView add-on, and turn on live market data"],
        ["Fails only in \"Live\" mode", "Funds/entitlements sit on the other account, or no live data subscription", "Connect Demo, or fund and subscribe to live data, then retry Live"],
        ["Prop/eval account fails to connect", "Firm hasn't enabled the TradingView add-on or data for your account", "Contact your prop firm to enable the add-on and provision data"],
        ["Connects but data is delayed/orange", "No active real-time market-data subscription", "Subscribe to live CME data and re-log so it applies"],
        ["\"TradingView has not been entitled…\"", "The add-on entitlement is missing on the account", "Enable the add-on under Settings > Add-ons (or have the firm enable it)"],
        ["Login loops / device conflict", "Too many active sessions or stale credentials", "Log out of other sessions, verify credentials, reconnect once"],
      ],
    },
    { type: "heading", text: "Prevent This With PickMyTrade" },
    { type: "paragraph", html: "The manual TradingView-to-Tradovate bridge breaks the moment an entitlement lapses. PickMyTrade routes your TradingView alerts straight to Tradovate over a dedicated connection, so a fragile in-chart login is no longer the single point of failure between your strategy and the market:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Direct alert-to-broker routing</strong>, your TradingView strategy fires a webhook that PickMyTrade delivers to Tradovate, independent of the TradingView Trading panel session that shows the \"contact broker\" error.",
        "<strong class='text-white'>Entitlement and data-state awareness</strong>, orders respect your account's live/data and risk state instead of silently dying at a broker handshake.",
        "<strong class='text-white'>Multi-account sync</strong>, mirror the same corrected order across live, demo, and multiple accounts in one shot.",
        "<strong class='text-white'>Rate-limit-safe order flow</strong>, requests are spaced so automated entries don't trip Tradovate's limits mid-session.",
      ],
    },
  ], de: [
    { type: "paragraph",html: "Sie haben ein sauberes Setup auf ES oder NQ vor sich, öffnen das TradingView-Trading-Panel, wählen Tradovate als Broker, geben Ihre Zugangsdaten ein – und statt einer Live-Verbindung erscheint ein rotes Banner: <strong class='text-white'>\"Something went wrong, contact your broker.\"</strong> Keine Chart-Order, kein DOM, keine Automatisierung. Im schnellen Futures-Handel ist diese Sackgassen-Meldung mehr als ärgerlich: Sie sperrt Sie im ungünstigsten Moment aus Ihrem eigenen Konto aus. Die gute Nachricht: Das ist fast nie ein mysteriöser Plattformfehler. In neun von zehn Fällen fehlt Ihrem Tradovate-Konto eines von drei Dingen, nämlich <strong class='text-white'>Finanzierung, die TradingView-Add-on-Berechtigung oder ein aktives Live-Marktdatenabonnement</strong>, und für jedes gibt es eine bekannte Lösung. Dieser Leitfaden geht jede Ursache und den genauen Klickpfad zur Behebung durch." },
    {
      type: "checklist",
      heading: "Kurze Checkliste für den Fehler \"Something Went Wrong\"",
      items: [
        "<strong class='text-white'>Ist das Konto finanziert?</strong> Ein nicht finanziertes Live-Tradovate-Konto kann sich nicht bei TradingView anmelden. Finanzieren Sie es oder verbinden Sie stattdessen Ihr Demo-Konto.",
        "<strong class='text-white'>Ist das TradingView-Add-on aktiv?</strong> TradingView benötigt die aktivierte Add-on-Berechtigung auf Ihrem Tradovate-Konto, bevor es Zugriff gewährt.",
        "<strong class='text-white'>Haben Sie Live-Marktdaten?</strong> Der Live-Handel über TradingView erfordert ein aktives Tradovate-Marktdatenabonnement und unterzeichnete Datenvereinbarungen.",
        "<strong class='text-white'>Prop-Firm- oder Evaluationskonto?</strong> Sie kaufen das Add-on nicht selbst, Ihre Firma aktiviert es. Kontaktieren Sie die Firma, falls der Fehler bestehen bleibt.",
        "<strong class='text-white'>Richtiger Modus gewählt?</strong> Die Wahl von \"Live\", wenn Sie nur ein finanziertes Demo-Konto haben (oder umgekehrt), löst den Fehler aus. Passen Sie den Modus an das an, was Ihr Konto tatsächlich hat.",
        "<strong class='text-white'>Zugangsdaten und Sitzung?</strong> Prüfen Sie, dass Benutzername und Passwort stimmen und Sie nicht auf zu vielen Geräten gleichzeitig angemeldet sind.",
      ],
    },
    { type: "heading",text: "Was “Something Went Wrong, Contact Your Broker” bedeutet" },
    { type: "paragraph",html: "Trotz der vagen Formulierung ist dieser Fehler ein <strong class='text-white'>brokerseitiger Berechtigungsfehler</strong>, kein TradingView-Problem. Beim Verbinden fragt TradingView Tradovate schlicht: \"Darf dieses Konto über mich handeln, und hat es dafür die Daten?\" Antwortet Tradovate mit Nein, weil das Konto kein Guthaben, kein TradingView-Add-on oder kein Live-Marktdatenabonnement hat, kann TradingView den Handshake nicht abschließen und fällt auf die generische Meldung \"Something went wrong, contact your broker\" zurück (manchmal auch als \"Something went wrong. Please contact your broker\" formuliert)." },
    { type: "paragraph",html: "Der häufigste Auslöser ist der einfachste: <strong class='text-white'>Wenn Ihr Tradovate-Konto nicht finanziert ist, können Sie sich überhaupt nicht bei TradingView anmelden</strong>, und diese Meldung ist das Ergebnis. Die Finanzierung aktiviert die kostenlosen Level-I-Marktdaten von CME Group und EUREX sowie den TradingView-Zugang, den jeder Live-Tradovate-Kontotarif enthält, und diese Vorteile bleiben nur aktiv, solange das Konto finanziert ist." },
    { type: "paragraph",html: "Die zweite Ebene sind Berechtigung und Daten. Um <strong class='text-white'>live</strong> über TradingView zu handeln, müssen drei Bedingungen gleichzeitig erfüllt sein: ein aktives TradingView-Add-on (oder ein Kontotarif, der TradingView bereits enthält), ein aktives <strong class='text-white'>Live</strong>-Marktdatenabonnement auf Ihrem Tradovate-Konto und ein finanziertes Live-Konto. Fehlt eine, scheitert die Verbindung. Haben Sie noch kein finanziertes Live-Konto? Sie können Ihr <strong class='text-white'>Demo-(Sim-)Konto</strong> trotzdem mit TradingView verbinden, nachdem Sie das eigenständige TradingView-Add-on abonniert haben – ein gängiger Weg für Trader, die vor dem Live-Handel testen möchten." },
    { type: "heading",text: "Die häufigsten Ursachen für den \"Contact Broker\"-Fehler" },
    { type: "heading",text: "1. Das Live-Konto hat kein Guthaben" },
    { type: "paragraph",html: "Ein nicht finanziertes Live-Tradovate-Konto ist die Ursache Nummer eins. Ohne Einzahlung aktiviert das Konto seine Daten- und TradingView-Berechtigungen nie, sodass die Anmeldung abgelehnt wird." },
    { type: "heading",text: "2. Das TradingView-Add-on ist nicht aktiviert" },
    { type: "paragraph",html: "TradingView erreicht Ihr Tradovate-Konto (Live und Sim) erst, wenn das TradingView-Add-on eingeschaltet ist. Ein brandneues Konto oder eines, bei dem das Add-on abgelaufen ist, löst den Fehler aus, bis es wieder aktiviert wird." },
    { type: "heading",text: "3. Kein aktives Live-Marktdatenabonnement" },
    { type: "paragraph",html: "Selbst ein finanziertes Konto mit Add-on kann scheitern, wenn es kein Live-Marktdatenabonnement hat. Der Live-Handel über TradingView erfordert Echtzeit-Börsendaten und die dazugehörigen unterzeichneten Datenvereinbarungen für Nicht-Professionelle." },
    { type: "heading",text: "4. Prop-Firm- oder Evaluationskonto mit nicht aktiviertem Add-on" },
    { type: "paragraph",html: "Bei einem Prop- oder Evaluationskonto kaufen Sie das Add-on nie selbst, die Firma kontrolliert, ob TradingView aktiviert ist. Hat die Firma es nicht aktiviert oder ist Ihre Evaluation nicht vollständig bereitgestellt, sehen Sie denselben Fehler." },
    { type: "heading",text: "5. Falscher Verbindungsmodus oder veraltete Zugangsdaten" },
    { type: "paragraph",html: "Die Wahl von \"Live\", obwohl Ihr finanziertes Guthaben im Demo-Konto liegt, ein altes Passwort oder das Erreichen eines Geräte- oder Sitzungslimits können sich alle als fehlgeschlagene Verbindung zeigen." },
    { type: "heading",text: "So beheben Sie den Fehler \"Something Went Wrong\": Schritt für Schritt" },
    { type: "heading",text: "Ursache 1 beheben: Finanzieren Sie Ihr Live-Tradovate-Konto" },
    {
      type: "steps",
      items: [
        { title: "Konto bestätigen", html: "Melden Sie sich direkt (nicht über TradingView) im Tradovate Web Trader an und bestätigen Sie, in welchem Konto Sie sich befinden." },
        { title: "Guthaben einzahlen", html: "Öffnen Sie den Finanzierungs-/Einzahlungsbereich und zahlen Sie per bevorzugter Methode (ACH, Überweisung usw.) ein. Einzahlungsdauer und Mindestbeträge <strong class='text-white'>variieren je nach Einzahlungsmethode und Kontotyp, prüfen Sie die aktuellen Finanzierungsregeln von Tradovate</strong>." },
        { title: "Warten und wiederholen", html: "Warten Sie, bis die Einzahlung verbucht ist und das Konto als finanziert angezeigt wird, und versuchen Sie die TradingView-Verbindung dann erneut." },
        { title: "Oder stattdessen Demo verbinden", html: "Möchten Sie Strategien zunächst nur testen? Überspringen Sie die Finanzierung und verbinden Sie stattdessen Ihr <strong class='text-white'>Demo</strong>-Konto." },
      ],
    },
    { type: "heading",text: "Ursache 2 beheben: Aktivieren Sie das TradingView-Add-on" },
    {
      type: "steps",
      items: [
        { title: "Application Settings öffnen", html: "Klicken Sie im Tradovate Web Trader auf das Zahnrad oben rechts (je nach Version mit <strong class='text-white'>Application Settings</strong> oder <strong class='text-white'>Settings</strong> beschriftet)." },
        { title: "Add-ons öffnen", html: "Öffnen Sie den Tab <strong class='text-white'>Add-ons</strong>." },
        { title: "TradingView aktivieren", html: "Scrollen Sie zum <strong class='text-white'>TradingView add-on</strong> und klicken Sie auf <strong class='text-white'>Buy</strong> oder aktivieren Sie es. Das Add-on kostet eine kleine wiederkehrende Gebühr (zuletzt etwa $9.99/Monat, <strong class='text-white'>Preise variieren, bestätigen Sie daher den aktuellen Tarif von Tradovate</strong>) und gewährt TradingView Zugriff auf Ihre Live- und Sim-Konten." },
        { title: "Zuerst Ihren Tarif prüfen", html: "Manche Kontotarife enthalten TradingView bereits; ist das bei Ihnen der Fall, brauchen Sie das separate Add-on nicht. Prüfen Sie die Leistungen Ihres Tarifs, bevor Sie kaufen." },
      ],
    },
    { type: "heading",text: "Ursache 3 beheben: Live-Marktdaten einschalten" },
    {
      type: "steps",
      items: [
        { title: "Market Data Subscription öffnen", html: "Öffnen Sie in den Tradovate-Einstellungen weiterhin den Bereich <strong class='text-white'>Market Data Subscription</strong>." },
        { title: "Ihre Börsendaten abonnieren", html: "Abonnieren Sie die Börsendaten, die Sie handeln (zum Beispiel CME Group Level I). Ein finanzierter Live-Kontotarif enthält kostenlose Level-I-Daten von CME Group und EUREX, Sie müssen aber sicherstellen, dass sie auf dem Konto aktiv sind." },
        { title: "Datenvereinbarungen unterzeichnen", html: "Unterzeichnen Sie alle erforderlichen <strong class='text-white'>non-professional market-data agreements</strong>, Live-Orders und Live-Daten bleiben blockiert, bis diese akzeptiert sind." },
        { title: "Aus- und wieder einloggen", html: "Melden Sie sich vollständig von Tradovate und TradingView ab und anschließend wieder an, damit die neue Datenberechtigung greift." },
      ],
    },
    { type: "heading",text: "Ursache 4 beheben: Prop-Firm-Konten – bitten Sie die Firma um Aktivierung" },
    {
      type: "steps",
      items: [
        { title: "Versuchen Sie nicht, es selbst zu kaufen", html: "Versuchen Sie <strong class='text-white'>nicht</strong>, das Add-on auf einem Evaluations- oder finanzierten Prop-Konto zu kaufen, Sie können es nicht, und es sollte Ihnen nichts berechnet werden." },
        { title: "Kontaktieren Sie Ihre Firma", html: "Wenden Sie sich an den Support Ihrer Prop Firm und bitten Sie darum zu bestätigen, dass das <strong class='text-white'>TradingView-Add-on aktiviert</strong> ist und die Daten bereitgestellt sind. Welche Firma was aktiviert, <strong class='text-white'>variiert je nach Firma und Kontogröße, prüfen Sie die aktuellen Regeln Ihrer Firma</strong>." },
        { title: "Geben Sie einer frischen Evaluation Zeit", html: "Haben Sie gerade eine Evaluation gekauft, geben Sie ihr Zeit zur Bereitstellung. Eine frische Evaluation, die noch nicht vollständig aktiviert ist, zeigt denselben Fehler, bis die Firma die Einrichtung abgeschlossen hat." },
      ],
    },
    { type: "heading",text: "Ursache 5 beheben: Mit dem richtigen Modus und Zugangsdaten neu verbinden" },
    {
      type: "steps",
      items: [
        { title: "Trading-Panel öffnen", html: "Öffnen Sie in TradingView das <strong class='text-white'>Trading panel</strong> unten am Chart und wählen Sie <strong class='text-white'>Tradovate</strong> aus der Broker-Liste." },
        { title: "Den richtigen Kontotyp wählen", html: "Wählen Sie den richtigen Kontotyp, <strong class='text-white'>Live</strong> für ein finanziertes Brokerage-Konto, <strong class='text-white'>Demo</strong> (Sim) für ein simuliertes, und klicken Sie dann auf <strong class='text-white'>Connect</strong>." },
        { title: "Zugangsdaten eingeben", html: "Geben Sie Ihren Tradovate-Benutzernamen und Ihr Passwort ein (oder nutzen Sie die verknüpfte Google-/Apple-Anmeldung) und klicken Sie auf <strong class='text-white'>Connect</strong> oder <strong class='text-white'>Login</strong>." },
        { title: "Zuerst andere Sitzungen beenden", html: "Waren Sie bereits anderswo angemeldet, melden Sie sich zuerst von anderen Tradovate-Sitzungen ab, um Konflikte mit dem Gerätelimit zu vermeiden, und verbinden Sie dann neu." },
      ],
    },
    { type: "heading",text: "Fehlerbehebungstabelle" },
    { type: "table", headers: ["Fehler / Symptom","Bedeutung","Lösung"], rows: [
      ["Something went wrong, contact your broker","Brokerseitige Berechtigungsprüfung fehlgeschlagen: Konto nicht finanziert, kein Add-on oder keine Live-Daten","Konto finanzieren, TradingView-Add-on aktivieren und Live-Marktdaten einschalten"],
      ["Scheitert nur im Modus \"Live\"","Guthaben/Berechtigungen liegen auf dem anderen Konto, oder es gibt kein Live-Datenabonnement","Demo verbinden oder finanzieren und Live-Daten abonnieren, dann Live erneut versuchen"],
      ["Prop-/Eval-Konto verbindet sich nicht","Die Firma hat das TradingView-Add-on oder die Daten für Ihr Konto nicht aktiviert","Prop Firm kontaktieren, damit sie Add-on aktiviert und Daten bereitstellt"],
      ["Verbindet sich, aber Daten sind verzögert/orange","Kein aktives Echtzeit-Marktdatenabonnement","Live-CME-Daten abonnieren und neu anmelden, damit sie greifen"],
      ["\"TradingView has not been entitled…\"","Die Add-on-Berechtigung fehlt auf dem Konto","Add-on unter Settings > Add-ons aktivieren (oder von der Firma aktivieren lassen)"],
      ["Login-Schleifen / Gerätekonflikt","Zu viele aktive Sitzungen oder veraltete Zugangsdaten","Von anderen Sitzungen abmelden, Zugangsdaten prüfen, einmal neu verbinden"],
    ] },
    { type: "heading",text: "Verhindern Sie das mit PickMyTrade" },
    { type: "paragraph",html: "Die manuelle TradingView-zu-Tradovate-Brücke bricht, sobald eine Berechtigung ausläuft. PickMyTrade routet Ihre TradingView-Alerts über eine dedizierte Verbindung direkt zu Tradovate, sodass ein fragiler Chart-Login nicht mehr der einzige Schwachpunkt zwischen Ihrer Strategie und dem Markt ist:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Direktes Alert-zu-Broker-Routing</strong>, Ihre TradingView-Strategie löst einen Webhook aus, den PickMyTrade an Tradovate zustellt, unabhängig von der Sitzung des TradingView-Trading-Panels, die den \"contact broker\"-Fehler anzeigt.",
        "<strong class='text-white'>Bewusstsein für Berechtigung und Datenstatus</strong>, Orders berücksichtigen den Live-/Daten- und Risikostatus Ihres Kontos, statt beim Broker-Handshake stillschweigend zu sterben.",
        "<strong class='text-white'>Multi-Account-Sync</strong>, spiegeln Sie dieselbe korrigierte Order in einem Zug auf Live-, Demo- und mehrere Konten.",
        "<strong class='text-white'>Rate-Limit-sicherer Orderfluss</strong>, Anfragen werden zeitlich verteilt, damit automatisierte Einstiege mitten in der Sitzung nicht die Limits von Tradovate auslösen.",
      ],
    },
  ], es: [
    { type: "paragraph",html: "Tiene una configuración limpia en ES o NQ, abre el panel de trading de TradingView, elige Tradovate como bróker, escribe sus credenciales y, en lugar de una conexión en vivo, aparece un banner rojo: <strong class='text-white'>\"Something went wrong, contact your broker.\"</strong> Sin orden desde el gráfico, sin DOM, sin automatización. En futuros de movimiento rápido, ese mensaje sin salida es más que molesto: le deja fuera de su propia cuenta justo en el peor momento. La buena noticia: casi nunca es un misterioso fallo de la plataforma. Nueve de cada diez veces significa que a su cuenta de Tradovate le falta una de tres cosas: <strong class='text-white'>fondos, la habilitación del complemento de TradingView o una suscripción activa de datos de mercado en vivo</strong>, y cada una tiene una solución conocida. Esta guía repasa cada causa y el recorrido exacto de clics para resolverla." },
    {
      type: "checklist",
      heading: "Lista rápida para el error \"Something Went Wrong\"",
      items: [
        "<strong class='text-white'>¿Está la cuenta fondeada?</strong> Una cuenta real de Tradovate sin fondos no puede iniciar sesión en TradingView. Fondéela o conecte en su lugar su cuenta Demo.",
        "<strong class='text-white'>¿Está activo el complemento de TradingView?</strong> TradingView necesita la habilitación del complemento en su cuenta de Tradovate antes de conceder acceso.",
        "<strong class='text-white'>¿Tiene datos de mercado en vivo?</strong> Operar en real a través de TradingView requiere una suscripción activa de datos de mercado de Tradovate y los acuerdos de datos firmados.",
        "<strong class='text-white'>¿Cuenta de prop firm o de evaluación?</strong> No compra el complemento usted mismo, lo habilita su firma. Contacte con la firma si el error persiste.",
        "<strong class='text-white'>¿Modo correcto seleccionado?</strong> Elegir \"Live\" cuando solo tiene una cuenta Demo fondeada (o al revés) provoca el error. Ajuste el modo a lo que su cuenta realmente tiene.",
        "<strong class='text-white'>¿Credenciales y sesión?</strong> Confirme que el usuario y la contraseña son correctos y que no tiene la sesión iniciada en demasiados dispositivos.",
      ],
    },
    { type: "heading",text: "Qué significa “Something Went Wrong, Contact Your Broker”" },
    { type: "paragraph",html: "A pesar de su redacción vaga, este error es un <strong class='text-white'>fallo de habilitación del lado del bróker</strong>, no un problema de TradingView. Al conectar, TradingView le hace a Tradovate una pregunta sencilla: \"¿Esta cuenta puede operar a través de mí y tiene los datos para ello?\" Si Tradovate responde que no, porque la cuenta no tiene fondos, ni complemento de TradingView, ni suscripción de datos de mercado en vivo, TradingView no puede completar el protocolo y recurre al mensaje genérico \"Something went wrong, contact your broker\" (a veces lo verá formulado como \"Something went wrong. Please contact your broker\")." },
    { type: "paragraph",html: "El desencadenante más común es el más simple: <strong class='text-white'>si su cuenta de Tradovate no está fondeada, no podrá iniciar sesión en TradingView en absoluto</strong>, y este es el mensaje que obtiene. El fondeo es lo que activa los datos de mercado Level I gratuitos de CME Group y EUREX y el acceso a TradingView que incluye todo plan de cuenta real de Tradovate, y esos beneficios solo siguen activos mientras la cuenta permanezca fondeada." },
    { type: "paragraph",html: "La segunda capa es la habilitación y los datos. Para operar en <strong class='text-white'>real</strong> a través de TradingView, deben cumplirse tres condiciones a la vez: un complemento de TradingView activo (o un plan de cuenta que ya incluya TradingView), una suscripción activa de datos de mercado en <strong class='text-white'>real</strong> en su cuenta de Tradovate y una cuenta real fondeada. Si falta cualquiera, la conexión falla. ¿Aún no tiene una cuenta real fondeada? Puede conectar su cuenta <strong class='text-white'>Demo (Sim)</strong> a TradingView después de suscribirse al complemento independiente de TradingView, una vía habitual para quienes quieren probar antes de pasar a real." },
    { type: "heading",text: "Principales causas del error \"Contact Broker\"" },
    { type: "heading",text: "1. La cuenta real no tiene fondos" },
    { type: "paragraph",html: "Una cuenta real de Tradovate sin fondos es la causa número uno. Sin un depósito, la cuenta nunca activa sus habilitaciones de datos y de TradingView, por lo que se rechaza el inicio de sesión." },
    { type: "heading",text: "2. El complemento de TradingView no está habilitado" },
    { type: "paragraph",html: "TradingView solo puede acceder a su cuenta de Tradovate (real y Sim) cuando el complemento de TradingView está activado. Una cuenta nueva, o una en la que el complemento caducó, mostrará el error hasta que se vuelva a habilitar." },
    { type: "heading",text: "3. No hay una suscripción activa de datos de mercado en vivo" },
    { type: "paragraph",html: "Incluso una cuenta fondeada con el complemento puede fallar si no tiene una suscripción de datos de mercado en vivo. Operar en real a través de TradingView requiere datos de bolsa en tiempo real y los acuerdos de datos para no profesionales que los acompañan, firmados." },
    { type: "heading",text: "4. Cuenta de prop firm o de evaluación con el complemento sin activar" },
    { type: "paragraph",html: "En una cuenta de prop firm o de evaluación nunca compra el complemento usted mismo: la firma controla si TradingView está habilitado. Si la firma no lo ha habilitado, o su evaluación no está totalmente aprovisionada, verá el mismo error." },
    { type: "heading",text: "5. Modo de conexión incorrecto o credenciales obsoletas" },
    { type: "paragraph",html: "Seleccionar \"Live\" cuando su saldo fondeado está en Demo, usar una contraseña antigua o alcanzar un límite de dispositivos o sesiones puede manifestarse como una conexión fallida." },
    { type: "heading",text: "Cómo solucionar el error \"Something Went Wrong\": paso a paso" },
    { type: "heading",text: "Solucionar la causa 1: fondee su cuenta real de Tradovate" },
    {
      type: "steps",
      items: [
        { title: "Confirme su cuenta", html: "Inicie sesión directamente en el Tradovate Web Trader (no a través de TradingView) y confirme en qué cuenta está." },
        { title: "Añada fondos", html: "Abra el área de financiación/depósito y añada fondos con su método preferido (ACH, transferencia, etc.). Los plazos y mínimos de depósito <strong class='text-white'>varían según el método de financiación y el tipo de cuenta, consulte las reglas de financiación actuales de Tradovate</strong>." },
        { title: "Espere y reintente", html: "Espere a que el depósito se acredite y la cuenta figure como fondeada, y luego intente de nuevo la conexión de TradingView." },
        { title: "O conecte Demo en su lugar", html: "¿Solo quiere probar estrategias primero? Omita la financiación y conecte en su lugar su cuenta <strong class='text-white'>Demo</strong>." },
      ],
    },
    { type: "heading",text: "Solucionar la causa 2: habilite el complemento de TradingView" },
    {
      type: "steps",
      items: [
        { title: "Abra Application Settings", html: "En el Tradovate Web Trader, haga clic en el engranaje de configuración de la esquina superior derecha (con la etiqueta <strong class='text-white'>Application Settings</strong> o <strong class='text-white'>Settings</strong> según su versión)." },
        { title: "Abra Add-ons", html: "Abra la pestaña <strong class='text-white'>Add-ons</strong>." },
        { title: "Habilite TradingView", html: "Desplácese hasta el <strong class='text-white'>TradingView add-on</strong> y haga clic en <strong class='text-white'>Buy</strong> o habilítelo. El complemento tiene una pequeña cuota recurrente (alrededor de $9.99/mes en la última comprobación, <strong class='text-white'>los precios varían, así que confirme la tarifa actual de Tradovate</strong>) y concede a TradingView acceso a sus cuentas Live y Sim." },
        { title: "Revise primero su plan", html: "Algunos planes de cuenta ya incluyen TradingView; si el suyo lo incluye, no necesita el complemento por separado. Confirme lo que incluye su plan antes de comprar." },
      ],
    },
    { type: "heading",text: "Solucionar la causa 3: active los datos de mercado en vivo" },
    {
      type: "steps",
      items: [
        { title: "Abra Market Data Subscription", html: "Dentro de la configuración de Tradovate, abra el área <strong class='text-white'>Market Data Subscription</strong>." },
        { title: "Suscríbase a los datos de su bolsa", html: "Suscríbase a los datos de bolsa que opera (por ejemplo, CME Group Level I). Un plan de cuenta real fondeada incluye datos Level I de CME Group y EUREX gratuitos, pero debe asegurarse de que estén activos en la cuenta." },
        { title: "Firme los acuerdos de datos", html: "Firme todos los <strong class='text-white'>non-professional market-data agreements</strong> necesarios; las órdenes y los datos en vivo siguen bloqueados hasta que se acepten." },
        { title: "Cierre sesión y vuelva a entrar", html: "Cierre sesión por completo en Tradovate y TradingView y vuelva a entrar para que la nueva habilitación de datos se propague." },
      ],
    },
    { type: "heading",text: "Solucionar la causa 4: cuentas de prop firm, pida a la firma que lo habilite" },
    {
      type: "steps",
      items: [
        { title: "No intente comprarlo usted mismo", html: "<strong class='text-white'>No</strong> intente comprar el complemento en una cuenta de evaluación o de prop firm fondeada; no puede y no debería recibir ningún cargo." },
        { title: "Contacte con su firma", html: "Contacte con el soporte de su prop firm y pídales que confirmen que el <strong class='text-white'>complemento de TradingView está habilitado</strong> en su cuenta y que los datos están aprovisionados. Qué firma y qué habilita <strong class='text-white'>varía según la firma y el tamaño de la cuenta, consulte las reglas actuales de su firma</strong>." },
        { title: "Dé tiempo a una evaluación nueva", html: "Si acaba de comprar una evaluación, deje tiempo para que se aprovisione. Una evaluación nueva que aún no está totalmente activada muestra el mismo error hasta que la firma termine la configuración." },
      ],
    },
    { type: "heading",text: "Solucionar la causa 5: reconecte con el modo y las credenciales correctos" },
    {
      type: "steps",
      items: [
        { title: "Abra el panel de trading", html: "En TradingView, abra el <strong class='text-white'>Trading panel</strong> en la parte inferior del gráfico y seleccione <strong class='text-white'>Tradovate</strong> en la lista de brókers." },
        { title: "Elija el tipo de cuenta correcto", html: "Elija el tipo de cuenta correcto, <strong class='text-white'>Live</strong> para una cuenta de bróker fondeada, <strong class='text-white'>Demo</strong> (Sim) para una simulada, y luego haga clic en <strong class='text-white'>Connect</strong>." },
        { title: "Introduzca las credenciales", html: "Introduzca su usuario y contraseña de Tradovate (o use el inicio de sesión vinculado de Google/Apple) y haga clic en <strong class='text-white'>Connect</strong> o <strong class='text-white'>Login</strong>." },
        { title: "Cierre antes otras sesiones", html: "Si ya tenía la sesión iniciada en otro lugar, cierre primero las demás sesiones de Tradovate para evitar conflictos con el límite de dispositivos y luego reconecte." },
      ],
    },
    { type: "heading",text: "Tabla de solución de problemas" },
    { type: "table", headers: ["Error / síntoma","Qué significa","Solución"], rows: [
      ["Something went wrong, contact your broker","Falló la habilitación del lado del bróker: cuenta sin fondos, sin complemento o sin datos en vivo","Fondee la cuenta, habilite el complemento de TradingView y active los datos de mercado en vivo"],
      ["Falla solo en modo \"Live\"","Los fondos/habilitaciones están en la otra cuenta, o no hay suscripción de datos en vivo","Conecte Demo, o fondee y suscríbase a datos en vivo y luego reintente Live"],
      ["La cuenta de prop firm/evaluación no conecta","La firma no ha habilitado el complemento de TradingView ni los datos de su cuenta","Contacte con su prop firm para que habilite el complemento y aprovisione los datos"],
      ["Conecta pero los datos van retrasados/en naranja","No hay una suscripción activa de datos de mercado en tiempo real","Suscríbase a datos en vivo de CME y vuelva a iniciar sesión para que se apliquen"],
      ["\"TradingView has not been entitled…\"","Falta la habilitación del complemento en la cuenta","Habilite el complemento en Settings > Add-ons (o pida a la firma que lo habilite)"],
      ["Bucles de inicio de sesión / conflicto de dispositivos","Demasiadas sesiones activas o credenciales obsoletas","Cierre otras sesiones, verifique las credenciales y reconecte una sola vez"],
    ] },
    { type: "heading",text: "Evítelo con PickMyTrade" },
    { type: "paragraph",html: "El puente manual de TradingView a Tradovate se rompe en cuanto caduca una habilitación. PickMyTrade enruta sus alertas de TradingView directamente a Tradovate mediante una conexión dedicada, de modo que un inicio de sesión frágil desde el gráfico deja de ser el único punto de fallo entre su estrategia y el mercado:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Enrutamiento directo de alerta a bróker</strong>, su estrategia de TradingView dispara un webhook que PickMyTrade entrega a Tradovate, con independencia de la sesión del panel de trading de TradingView que muestra el error \"contact broker\".",
        "<strong class='text-white'>Conciencia de habilitación y estado de datos</strong>, las órdenes respetan el estado en vivo, de datos y de riesgo de su cuenta en lugar de morir en silencio en el protocolo con el bróker.",
        "<strong class='text-white'>Sincronización multicuenta</strong>, replique la misma orden corregida en cuentas reales, demo y múltiples cuentas de una sola vez.",
        "<strong class='text-white'>Flujo de órdenes seguro frente a límites de frecuencia</strong>, las solicitudes se espacian para que las entradas automáticas no activen los límites de Tradovate a mitad de sesión.",
      ],
    },
  ], fr: [
    { type: "paragraph",html: "Vous avez un beau setup sur ES ou NQ, vous ouvrez le panneau de trading TradingView, choisissez Tradovate comme courtier, saisissez vos identifiants, et au lieu d'une connexion en direct, une bannière rouge apparaît : <strong class='text-white'>\"Something went wrong, contact your broker.\"</strong> Pas d'ordre depuis le graphique, pas de DOM, pas d'automatisation. Sur des contrats à terme rapides, ce message sans issue est plus qu'agaçant : il vous ferme l'accès à votre propre compte au pire moment. La bonne nouvelle : il ne s'agit presque jamais d'un mystérieux bug de plateforme. Neuf fois sur dix, il manque à votre compte Tradovate l'une de trois choses : <strong class='text-white'>l'approvisionnement, l'habilitation du module TradingView ou un abonnement actif aux données de marché en direct</strong>, et chacune a un correctif connu. Ce guide passe en revue chaque cause et le parcours de clics exact pour la résoudre." },
    {
      type: "checklist",
      heading: "Liste de contrôle rapide pour l'erreur \"Something Went Wrong\"",
      items: [
        "<strong class='text-white'>Le compte est-il approvisionné ?</strong> Un compte Tradovate réel non approvisionné ne peut pas se connecter à TradingView. Approvisionnez-le, ou connectez plutôt votre compte Demo.",
        "<strong class='text-white'>Le module TradingView est-il actif ?</strong> TradingView exige que l'habilitation du module soit activée sur votre compte Tradovate avant d'accorder l'accès.",
        "<strong class='text-white'>Avez-vous des données de marché en direct ?</strong> Trader en réel via TradingView exige un abonnement actif aux données de marché Tradovate et des accords de données signés.",
        "<strong class='text-white'>Compte de prop firm ou d'évaluation ?</strong> Vous n'achetez pas le module vous-même, c'est votre société qui l'active. Contactez la société si l'erreur persiste.",
        "<strong class='text-white'>Bon mode sélectionné ?</strong> Choisir \"Live\" alors que vous n'avez qu'un compte Demo approvisionné (ou l'inverse) déclenche l'erreur. Faites correspondre le mode à ce que votre compte possède réellement.",
        "<strong class='text-white'>Identifiants et session ?</strong> Vérifiez que le nom d'utilisateur et le mot de passe sont corrects et que vous n'êtes pas déjà connecté sur trop d'appareils.",
      ],
    },
    { type: "heading",text: "Ce que signifie “Something Went Wrong, Contact Your Broker”" },
    { type: "paragraph",html: "Malgré sa formulation vague, cette erreur est un <strong class='text-white'>échec d'habilitation côté courtier</strong>, et non un bug de TradingView. Lors de la connexion, TradingView pose une question simple à Tradovate : \"Ce compte est-il autorisé à trader via moi, et dispose-t-il des données nécessaires ?\" Si Tradovate répond non, parce que le compte n'a pas de fonds, pas de module TradingView ou pas d'abonnement aux données de marché en direct, TradingView ne peut pas terminer la poignée de main et se rabat sur le message générique \"Something went wrong, contact your broker\" (vous le verrez parfois formulé \"Something went wrong. Please contact your broker\")." },
    { type: "paragraph",html: "Le déclencheur le plus courant est le plus simple : <strong class='text-white'>si votre compte Tradovate n'est pas approvisionné, vous ne pourrez pas du tout vous connecter à TradingView</strong>, et c'est ce message que vous obtenez. L'approvisionnement active les données de marché Level I gratuites de CME Group et d'EUREX ainsi que l'accès à TradingView inclus dans chaque formule de compte Tradovate réel, et ces avantages ne restent actifs que tant que le compte reste approvisionné." },
    { type: "paragraph",html: "La seconde couche est l'habilitation et les données. Pour trader en <strong class='text-white'>réel</strong> via TradingView, trois conditions doivent être réunies simultanément : un module TradingView actif (ou une formule de compte qui inclut déjà TradingView), un abonnement actif aux données de marché <strong class='text-white'>en direct</strong> sur votre compte Tradovate, et un compte réel approvisionné. S'il en manque une, la connexion échoue. Pas encore de compte réel approvisionné ? Vous pouvez tout de même connecter votre compte <strong class='text-white'>Demo (Sim)</strong> à TradingView après vous être abonné au module TradingView autonome, une voie courante pour les traders qui veulent tester avant de passer en réel." },
    { type: "heading",text: "Principales causes de l'erreur \"Contact Broker\"" },
    { type: "heading",text: "1. Le compte réel n'a pas de fonds" },
    { type: "paragraph",html: "Un compte Tradovate réel non approvisionné est la cause numéro un. Sans dépôt, le compte n'active jamais ses habilitations de données et de TradingView, et la connexion est donc refusée." },
    { type: "heading",text: "2. Le module TradingView n'est pas activé" },
    { type: "paragraph",html: "TradingView ne peut atteindre votre compte Tradovate (réel et Sim) que lorsque le module TradingView est activé. Un compte tout neuf, ou dont le module a expiré, provoquera l'erreur jusqu'à sa réactivation." },
    { type: "heading",text: "3. Aucun abonnement actif aux données de marché en direct" },
    { type: "paragraph",html: "Même un compte approvisionné avec le module peut échouer s'il n'a pas d'abonnement aux données de marché en direct. Le trading en réel via TradingView exige des données de bourse en temps réel et les accords de données non professionnels signés qui les accompagnent." },
    { type: "heading",text: "4. Compte de prop firm ou d'évaluation dont le module n'est pas activé" },
    { type: "paragraph",html: "Sur un compte de prop firm ou d'évaluation, vous n'achetez jamais le module vous-même : la société contrôle l'activation de TradingView. Si la société ne l'a pas activé, ou si votre évaluation n'est pas entièrement provisionnée, vous verrez la même erreur." },
    { type: "heading",text: "5. Mauvais mode de connexion ou identifiants obsolètes" },
    { type: "paragraph",html: "Sélectionner \"Live\" alors que votre solde approvisionné se trouve en Demo, utiliser un ancien mot de passe ou atteindre une limite d'appareils ou de sessions peuvent tous se manifester par une connexion échouée." },
    { type: "heading",text: "Comment corriger l'erreur \"Something Went Wrong\" : pas à pas" },
    { type: "heading",text: "Corriger la cause 1 : approvisionnez votre compte Tradovate réel" },
    {
      type: "steps",
      items: [
        { title: "Confirmez votre compte", html: "Connectez-vous directement au Tradovate Web Trader (et non via TradingView) et confirmez le compte sur lequel vous êtes." },
        { title: "Ajoutez des fonds", html: "Ouvrez la zone d'approvisionnement/de dépôt et ajoutez des fonds par le moyen de votre choix (ACH, virement, etc.). Les délais et minimums de dépôt <strong class='text-white'>varient selon le mode de financement et le type de compte, consultez les règles de financement actuelles de Tradovate</strong>." },
        { title: "Patientez et réessayez", html: "Attendez que le dépôt soit crédité et que le compte apparaisse comme approvisionné, puis réessayez la connexion TradingView." },
        { title: "Ou connectez plutôt Demo", html: "Vous voulez d'abord tester des stratégies ? Ignorez l'approvisionnement et connectez plutôt votre compte <strong class='text-white'>Demo</strong>." },
      ],
    },
    { type: "heading",text: "Corriger la cause 2 : activez le module TradingView" },
    {
      type: "steps",
      items: [
        { title: "Ouvrez Application Settings", html: "Dans le Tradovate Web Trader, cliquez sur l'engrenage de paramètres en haut à droite (libellé <strong class='text-white'>Application Settings</strong> ou <strong class='text-white'>Settings</strong> selon votre version)." },
        { title: "Ouvrez Add-ons", html: "Ouvrez l'onglet <strong class='text-white'>Add-ons</strong>." },
        { title: "Activez TradingView", html: "Faites défiler jusqu'au <strong class='text-white'>TradingView add-on</strong> et cliquez sur <strong class='text-white'>Buy</strong> ou activez-le. Le module comporte une petite redevance récurrente (environ $9.99/mois lors de la dernière vérification, <strong class='text-white'>les tarifs varient, confirmez donc le tarif actuel de Tradovate</strong>) et donne à TradingView l'accès à vos comptes Live et Sim." },
        { title: "Vérifiez d'abord votre formule", html: "Certaines formules de compte incluent déjà TradingView ; si c'est le cas de la vôtre, vous n'avez pas besoin du module séparé. Confirmez le contenu de votre formule avant d'acheter." },
      ],
    },
    { type: "heading",text: "Corriger la cause 3 : activez les données de marché en direct" },
    {
      type: "steps",
      items: [
        { title: "Ouvrez Market Data Subscription", html: "Toujours dans les paramètres de Tradovate, ouvrez la zone <strong class='text-white'>Market Data Subscription</strong>." },
        { title: "Abonnez-vous aux données de votre bourse", html: "Abonnez-vous aux données de bourse que vous tradez (par exemple CME Group Level I). Une formule de compte réel approvisionné inclut gratuitement les données Level I de CME Group et d'EUREX, mais vous devez vous assurer qu'elles sont actives sur le compte." },
        { title: "Signez les accords de données", html: "Signez tous les <strong class='text-white'>non-professional market-data agreements</strong> requis ; les ordres et les données en direct restent bloqués tant qu'ils ne sont pas acceptés." },
        { title: "Déconnectez-vous et reconnectez-vous", html: "Déconnectez-vous complètement de Tradovate et de TradingView, puis reconnectez-vous afin que la nouvelle habilitation de données se propage." },
      ],
    },
    { type: "heading",text: "Corriger la cause 4 : comptes de prop firm, demandez à la société de l'activer" },
    {
      type: "steps",
      items: [
        { title: "N'essayez pas de l'acheter vous-même", html: "N'essayez <strong class='text-white'>pas</strong> d'acheter le module sur un compte d'évaluation ou de prop firm approvisionné : vous ne le pouvez pas et aucune facturation ne devrait vous être appliquée." },
        { title: "Contactez votre société", html: "Contactez le support de votre prop firm et demandez-lui de confirmer que le <strong class='text-white'>module TradingView est activé</strong> sur votre compte et que les données sont provisionnées. Quelle société et ce qu'elle active <strong class='text-white'>varient selon la société et la taille du compte, consultez les règles actuelles de votre société</strong>." },
        { title: "Laissez du temps à une évaluation récente", html: "Si vous venez d'acheter une évaluation, laissez-lui le temps d'être provisionnée. Une évaluation récente qui n'est pas entièrement activée affiche la même erreur tant que la société n'a pas terminé la configuration." },
      ],
    },
    { type: "heading",text: "Corriger la cause 5 : reconnectez-vous avec le bon mode et les bons identifiants" },
    {
      type: "steps",
      items: [
        { title: "Ouvrez le panneau de trading", html: "Dans TradingView, ouvrez le <strong class='text-white'>Trading panel</strong> en bas du graphique et sélectionnez <strong class='text-white'>Tradovate</strong> dans la liste des courtiers." },
        { title: "Choisissez le bon type de compte", html: "Choisissez le bon type de compte, <strong class='text-white'>Live</strong> pour un compte de courtage approvisionné, <strong class='text-white'>Demo</strong> (Sim) pour un compte simulé, puis cliquez sur <strong class='text-white'>Connect</strong>." },
        { title: "Saisissez vos identifiants", html: "Saisissez votre nom d'utilisateur et votre mot de passe Tradovate (ou utilisez la connexion Google/Apple associée) et cliquez sur <strong class='text-white'>Connect</strong> ou <strong class='text-white'>Login</strong>." },
        { title: "Fermez d'abord les autres sessions", html: "Si vous étiez déjà connecté ailleurs, déconnectez-vous d'abord des autres sessions Tradovate pour éviter les conflits de limite d'appareils, puis reconnectez-vous." },
      ],
    },
    { type: "heading",text: "Tableau de dépannage" },
    { type: "table", headers: ["Erreur / symptôme","Signification","Correctif"], rows: [
      ["Something went wrong, contact your broker","Échec de l'habilitation côté courtier : compte non approvisionné, pas de module ou pas de données en direct","Approvisionnez le compte, activez le module TradingView et activez les données de marché en direct"],
      ["Échoue uniquement en mode \"Live\"","Les fonds/habilitations se trouvent sur l'autre compte, ou aucun abonnement aux données en direct","Connectez Demo, ou approvisionnez et abonnez-vous aux données en direct, puis réessayez Live"],
      ["Le compte de prop firm/d'évaluation ne se connecte pas","La société n'a pas activé le module TradingView ni les données pour votre compte","Contactez votre prop firm pour qu'elle active le module et provisionne les données"],
      ["Se connecte mais les données sont retardées/en orange","Aucun abonnement actif aux données de marché en temps réel","Abonnez-vous aux données CME en direct et reconnectez-vous pour qu'elles s'appliquent"],
      ["\"TradingView has not been entitled…\"","L'habilitation du module est absente du compte","Activez le module sous Settings > Add-ons (ou faites-le activer par la société)"],
      ["Boucles de connexion / conflit d'appareils","Trop de sessions actives ou identifiants obsolètes","Déconnectez-vous des autres sessions, vérifiez les identifiants, reconnectez-vous une seule fois"],
    ] },
    { type: "heading",text: "Évitez cela avec PickMyTrade" },
    { type: "paragraph",html: "Le pont manuel TradingView-vers-Tradovate se brise dès qu'une habilitation expire. PickMyTrade achemine vos alertes TradingView directement vers Tradovate via une connexion dédiée, de sorte qu'une connexion fragile depuis le graphique n'est plus le point de défaillance unique entre votre stratégie et le marché :" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Acheminement direct de l'alerte au courtier</strong>, votre stratégie TradingView déclenche un webhook que PickMyTrade remet à Tradovate, indépendamment de la session du panneau de trading TradingView qui affiche l'erreur \"contact broker\".",
        "<strong class='text-white'>Prise en compte de l'habilitation et de l'état des données</strong>, les ordres respectent l'état en direct, des données et du risque de votre compte au lieu de mourir silencieusement lors de la poignée de main avec le courtier.",
        "<strong class='text-white'>Synchronisation multi-comptes</strong>, répliquez le même ordre corrigé sur les comptes réels, démo et multiples en une seule fois.",
        "<strong class='text-white'>Flux d'ordres respectueux des limites de débit</strong>, les requêtes sont espacées pour que les entrées automatisées ne déclenchent pas les limites de Tradovate en pleine session.",
      ],
    },
  ], it: [
    { type: "paragraph",html: "Ha un setup pulito su ES o NQ, apre il pannello di trading di TradingView, sceglie Tradovate come broker, inserisce le credenziali e, invece di una connessione live, compare un banner rosso: <strong class='text-white'>\"Something went wrong, contact your broker.\"</strong> Nessun ordine dal grafico, nessun DOM, nessuna automazione. Nei future veloci, questo messaggio senza uscita è più che fastidioso: La lascia fuori dal Suo stesso conto nel momento peggiore. La buona notizia: non è quasi mai un misterioso bug della piattaforma. Nove volte su dieci significa che al Suo conto Tradovate manca una di tre cose: <strong class='text-white'>finanziamento, l'abilitazione dell'add-on TradingView o un abbonamento attivo ai dati di mercato live</strong>, e ciascuna ha una soluzione nota. Questa guida passa in rassegna ogni causa e il percorso di clic esatto per risolverla." },
    {
      type: "checklist",
      heading: "Checklist rapida per l'errore \"Something Went Wrong\"",
      items: [
        "<strong class='text-white'>Il conto è finanziato?</strong> Un conto Tradovate reale non finanziato non può accedere a TradingView. Lo finanzi, oppure colleghi invece il Suo conto Demo.",
        "<strong class='text-white'>L'add-on TradingView è attivo?</strong> TradingView richiede che l'abilitazione dell'add-on sia attiva sul Suo conto Tradovate prima di concedere l'accesso.",
        "<strong class='text-white'>Ha dati di mercato live?</strong> Operare live tramite TradingView richiede un abbonamento attivo ai dati di mercato Tradovate e gli accordi sui dati firmati.",
        "<strong class='text-white'>Conto prop firm o di valutazione?</strong> Non acquista l'add-on da solo, lo abilita la Sua società. Contatti la società se l'errore persiste.",
        "<strong class='text-white'>Modalità corretta selezionata?</strong> Scegliere \"Live\" quando ha solo un conto Demo finanziato (o viceversa) genera l'errore. Faccia corrispondere la modalità a ciò che il Suo conto possiede davvero.",
        "<strong class='text-white'>Credenziali e sessione?</strong> Verifichi che nome utente e password siano corretti e che non sia già connesso su troppi dispositivi.",
      ],
    },
    { type: "heading",text: "Che cosa significa “Something Went Wrong, Contact Your Broker”" },
    { type: "paragraph",html: "Nonostante la formulazione vaga, questo errore è un <strong class='text-white'>mancato controllo di abilitazione lato broker</strong>, non un malfunzionamento di TradingView. Quando si collega, TradingView pone a Tradovate una domanda semplice: \"Questo conto può operare tramite me e ha i dati per farlo?\" Se Tradovate risponde di no, perché il conto non ha fondi, non ha l'add-on TradingView o non ha un abbonamento ai dati di mercato live, TradingView non può completare l'handshake e ripiega sul messaggio generico \"Something went wrong, contact your broker\" (a volte lo vedrà formulato \"Something went wrong. Please contact your broker\")." },
    { type: "paragraph",html: "La causa più comune è la più semplice: <strong class='text-white'>se il Suo conto Tradovate non è finanziato, non potrà accedere affatto a TradingView</strong>, e questo è il messaggio che ottiene. È il finanziamento ad attivare i dati di mercato Level I gratuiti di CME Group ed EUREX e l'accesso a TradingView inclusi in ogni piano di conto Tradovate reale, e questi benefici restano attivi solo finché il conto rimane finanziato." },
    { type: "paragraph",html: "Il secondo livello è abilitazione e dati. Per operare <strong class='text-white'>live</strong> tramite TradingView, devono essere vere contemporaneamente tre condizioni: un add-on TradingView attivo (o un piano di conto che includa già TradingView), un abbonamento ai dati di mercato <strong class='text-white'>live</strong> attivo sul Suo conto Tradovate e un conto reale finanziato. Se ne manca una, la connessione fallisce. Non ha ancora un conto reale finanziato? Può comunque collegare il Suo conto <strong class='text-white'>Demo (Sim)</strong> a TradingView dopo aver sottoscritto l'add-on TradingView autonomo, un percorso comune per i trader che vogliono provare prima di passare al live." },
    { type: "heading",text: "Cause principali dell'errore \"Contact Broker\"" },
    { type: "heading",text: "1. Il conto reale non ha fondi" },
    { type: "paragraph",html: "Un conto Tradovate reale non finanziato è la causa numero uno. Senza un deposito, il conto non attiva mai le abilitazioni ai dati e a TradingView, quindi l'accesso viene rifiutato." },
    { type: "heading",text: "2. L'add-on TradingView non è abilitato" },
    { type: "paragraph",html: "TradingView può raggiungere il Suo conto Tradovate (reale e Sim) solo quando l'add-on TradingView è attivo. Un conto nuovo, o uno in cui l'add-on è scaduto, genererà l'errore finché non viene riabilitato." },
    { type: "heading",text: "3. Nessun abbonamento attivo ai dati di mercato live" },
    { type: "paragraph",html: "Anche un conto finanziato con l'add-on può fallire se non ha un abbonamento ai dati di mercato live. Operare live tramite TradingView richiede dati di borsa in tempo reale e i relativi accordi sui dati per non professionisti firmati." },
    { type: "heading",text: "4. Conto prop firm o di valutazione con l'add-on non attivato" },
    { type: "paragraph",html: "Su un conto prop o di valutazione non acquista mai l'add-on da solo: è la società a controllare se TradingView è abilitato. Se la società non lo ha abilitato, o la Sua valutazione non è completamente predisposta, vedrà lo stesso errore." },
    { type: "heading",text: "5. Modalità di connessione errata o credenziali obsolete" },
    { type: "paragraph",html: "Selezionare \"Live\" quando il saldo finanziato si trova in Demo, usare una vecchia password o raggiungere un limite di dispositivi o sessioni possono manifestarsi come una connessione fallita." },
    { type: "heading",text: "Come risolvere l'errore \"Something Went Wrong\": passo dopo passo" },
    { type: "heading",text: "Risolvere la causa 1: finanzi il Suo conto Tradovate reale" },
    {
      type: "steps",
      items: [
        { title: "Confermi il Suo conto", html: "Acceda direttamente al Tradovate Web Trader (non tramite TradingView) e confermi su quale conto si trova." },
        { title: "Aggiunga fondi", html: "Apra l'area di finanziamento/deposito e aggiunga fondi con il metodo preferito (ACH, bonifico e così via). Tempi e minimi di deposito <strong class='text-white'>variano in base al metodo di finanziamento e al tipo di conto, verifichi le regole di finanziamento attuali di Tradovate</strong>." },
        { title: "Attenda e riprovi", html: "Attenda che il deposito venga accreditato e che il conto risulti finanziato, poi riprovi la connessione a TradingView." },
        { title: "Oppure colleghi Demo", html: "Vuole solo testare prima le strategie? Salti il finanziamento e colleghi invece il Suo conto <strong class='text-white'>Demo</strong>." },
      ],
    },
    { type: "heading",text: "Risolvere la causa 2: abiliti l'add-on TradingView" },
    {
      type: "steps",
      items: [
        { title: "Apra Application Settings", html: "Nel Tradovate Web Trader, clicchi sull'ingranaggio delle impostazioni in alto a destra (etichettato <strong class='text-white'>Application Settings</strong> o <strong class='text-white'>Settings</strong> a seconda della versione)." },
        { title: "Apra Add-ons", html: "Apra la scheda <strong class='text-white'>Add-ons</strong>." },
        { title: "Abiliti TradingView", html: "Scorra fino al <strong class='text-white'>TradingView add-on</strong> e clicchi su <strong class='text-white'>Buy</strong> o lo abiliti. L'add-on ha un piccolo canone ricorrente (circa $9.99/mese all'ultima verifica, <strong class='text-white'>i prezzi variano, quindi confermi la tariffa attuale di Tradovate</strong>) e concede a TradingView l'accesso ai Suoi conti Live e Sim." },
        { title: "Controlli prima il Suo piano", html: "Alcuni piani di conto includono già TradingView; se il Suo lo include, non ha bisogno dell'add-on separato. Confermi cosa include il Suo piano prima di acquistare." },
      ],
    },
    { type: "heading",text: "Risolvere la causa 3: attivi i dati di mercato live" },
    {
      type: "steps",
      items: [
        { title: "Apra Market Data Subscription", html: "Sempre nelle impostazioni di Tradovate, apra l'area <strong class='text-white'>Market Data Subscription</strong>." },
        { title: "Si abboni ai dati della Sua borsa", html: "Si abboni ai dati di borsa su cui opera (per esempio CME Group Level I). Un piano di conto reale finanziato include gratuitamente i dati Level I di CME Group ed EUREX, ma deve assicurarsi che siano attivi sul conto." },
        { title: "Firmi gli accordi sui dati", html: "Firmi tutti i <strong class='text-white'>non-professional market-data agreements</strong> richiesti; ordini e dati live restano bloccati finché non vengono accettati." },
        { title: "Esca e riaccede", html: "Esca completamente da Tradovate e TradingView, poi riaccede in modo che la nuova abilitazione ai dati si propaghi." },
      ],
    },
    { type: "heading",text: "Risolvere la causa 4: conti prop firm, chieda alla società di abilitarlo" },
    {
      type: "steps",
      items: [
        { title: "Non provi ad acquistarlo da solo", html: "<strong class='text-white'>Non</strong> provi ad acquistare l'add-on su un conto di valutazione o prop finanziato: non può, e non dovrebbe subire alcun addebito." },
        { title: "Contatti la Sua società", html: "Contatti il supporto della Sua prop firm e chieda di confermare che l'<strong class='text-white'>add-on TradingView sia abilitato</strong> sul Suo conto e che i dati siano predisposti. Quale società e cosa abilita <strong class='text-white'>varia in base alla società e alla dimensione del conto, verifichi le regole attuali della Sua società</strong>." },
        { title: "Dia tempo a una valutazione appena creata", html: "Se ha appena acquistato una valutazione, le dia il tempo di essere predisposta. Una valutazione nuova non ancora completamente attivata mostra lo stesso errore finché la società non termina la configurazione." },
      ],
    },
    { type: "heading",text: "Risolvere la causa 5: si ricolleghi con la modalità e le credenziali corrette" },
    {
      type: "steps",
      items: [
        { title: "Apra il pannello di trading", html: "In TradingView, apra il <strong class='text-white'>Trading panel</strong> nella parte inferiore del grafico e selezioni <strong class='text-white'>Tradovate</strong> dall'elenco dei broker." },
        { title: "Scelga il tipo di conto corretto", html: "Scelga il tipo di conto corretto, <strong class='text-white'>Live</strong> per un conto di brokerage finanziato, <strong class='text-white'>Demo</strong> (Sim) per uno simulato, poi clicchi su <strong class='text-white'>Connect</strong>." },
        { title: "Inserisca le credenziali", html: "Inserisca nome utente e password Tradovate (oppure usi l'accesso Google/Apple collegato) e clicchi su <strong class='text-white'>Connect</strong> o <strong class='text-white'>Login</strong>." },
        { title: "Chiuda prima le altre sessioni", html: "Se era già connesso altrove, esca prima dalle altre sessioni Tradovate per evitare conflitti con il limite di dispositivi, poi si ricolleghi." },
      ],
    },
    { type: "heading",text: "Tabella di risoluzione dei problemi" },
    { type: "table", headers: ["Errore / sintomo","Significato","Soluzione"], rows: [
      ["Something went wrong, contact your broker","Controllo di abilitazione lato broker fallito: conto non finanziato, nessun add-on o nessun dato live","Finanzi il conto, abiliti l'add-on TradingView e attivi i dati di mercato live"],
      ["Fallisce solo in modalità \"Live\"","Fondi/abilitazioni si trovano sull'altro conto, oppure manca l'abbonamento ai dati live","Colleghi Demo, oppure finanzi e si abboni ai dati live, poi riprovi Live"],
      ["Il conto prop/di valutazione non si collega","La società non ha abilitato l'add-on TradingView o i dati per il Suo conto","Contatti la Sua prop firm perché abiliti l'add-on e predisponga i dati"],
      ["Si collega ma i dati sono ritardati/arancioni","Nessun abbonamento attivo ai dati di mercato in tempo reale","Si abboni ai dati CME live e riaccede affinché vengano applicati"],
      ["\"TradingView has not been entitled…\"","L'abilitazione dell'add-on manca sul conto","Abiliti l'add-on in Settings > Add-ons (oppure lo faccia abilitare alla società)"],
      ["Cicli di accesso / conflitto di dispositivi","Troppe sessioni attive o credenziali obsolete","Esca dalle altre sessioni, verifichi le credenziali, si ricolleghi una sola volta"],
    ] },
    { type: "heading",text: "Lo prevenga con PickMyTrade" },
    { type: "paragraph",html: "Il ponte manuale da TradingView a Tradovate si rompe nel momento in cui un'abilitazione scade. PickMyTrade instrada i Suoi alert TradingView direttamente a Tradovate tramite una connessione dedicata, così un fragile accesso dal grafico non è più l'unico punto di rottura tra la Sua strategia e il mercato:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Instradamento diretto dall'alert al broker</strong>, la Sua strategia TradingView attiva un webhook che PickMyTrade consegna a Tradovate, indipendentemente dalla sessione del pannello di trading TradingView che mostra l'errore \"contact broker\".",
        "<strong class='text-white'>Consapevolezza di abilitazione e stato dei dati</strong>, gli ordini rispettano lo stato live, dei dati e del rischio del Suo conto invece di morire in silenzio nell'handshake con il broker.",
        "<strong class='text-white'>Sincronizzazione multi-account</strong>, replichi lo stesso ordine corretto su conti reali, demo e multipli in un colpo solo.",
        "<strong class='text-white'>Flusso di ordini sicuro rispetto ai rate limit</strong>, le richieste sono distanziate in modo che gli ingressi automatici non facciano scattare i limiti di Tradovate a metà sessione.",
      ],
    },
  ] },
  ctaHeading: { en: "Trade Rejection-Free", de: "Handeln ohne Ablehnungen", es: "Opere sin rechazos", fr: "Tradez sans rejet", it: "Faccia trading senza rifiuti" },
  ctaText: { en: "Start your free 7-day trial, link your alerts today and trade rejection-free with PickMyTrade.", de: "Starten Sie Ihre kostenlose 7-Tage-Testphase, verknüpfen Sie Ihre Alerts noch heute und handeln Sie ohne Ablehnungen mit PickMyTrade.", es: "Comience su prueba gratuita de 7 días, vincule sus alertas hoy y opere sin rechazos con PickMyTrade.", fr: "Commencez votre essai gratuit de 7 jours, reliez vos alertes dès aujourd'hui et tradez sans rejet avec PickMyTrade.", it: "Inizi la prova gratuita di 7 giorni, colleghi i Suoi alert oggi stesso e faccia trading senza rifiuti con PickMyTrade." },
  ctaButtonText: { en: "Start Your Free 7-Day Trial", de: "Starten Sie Ihre kostenlose 7-Tage-Testphase", es: "Comience su prueba gratuita de 7 días", fr: "Commencez votre essai gratuit de 7 jours", it: "Inizi la prova gratuita di 7 giorni" },
  ctaUrl: "https://app.pickmytrade.trade/?register=true&utm_source=content&utm_medium=debugging",
  faqHeading: { en: "Frequently Asked Questions", de: "Häufig gestellte Fragen", es: "Preguntas frecuentes", fr: "Questions fréquentes", it: "Domande frequenti" },
  faqs: { en: [
    { q: "What does \"Something went wrong, contact your broker\" mean on TradingView with Tradovate?", a: "Tradovate refused the connection because the account is missing a requirement. Most often it isn't funded, doesn't have the TradingView add-on enabled, or has no active live market-data subscription." },
    { q: "Why can't I log in to TradingView with my Tradovate account?", a: "If your live Tradovate account is not funded, TradingView can't log in and shows this error. Fund the account, or connect your Demo (Sim) account instead after enabling the TradingView add-on." },
    { q: "Do I need to pay for the TradingView add-on?", a: "For a personal Tradovate account, yes. Enable the TradingView add-on under Settings > Add-ons (a small monthly fee that varies, so confirm the current rate), unless your Account Plan already bundles TradingView. On a prop or evaluation account you don't pay for it. The firm enables it." },
    { q: "Can I connect a demo account instead of funding a live one?", a: "Yes. If you don't have a funded live account, you can connect your Tradovate Demo/Sim account to TradingView after subscribing to the standalone TradingView add-on." },
    { q: "I'm on a prop firm evaluation, why do I still get the error?", a: "On prop accounts the firm controls the TradingView add-on and data. Contact your prop firm to confirm the add-on is enabled and your account is fully provisioned. A brand-new evaluation may still be provisioning." },
    { q: "I funded the account and still see the error, what now?", a: "Confirm the TradingView add-on is enabled and a live market-data subscription is active with the data agreements signed. Then log out of both Tradovate and TradingView and reconnect so the new entitlements apply." },
    { q: "Does buying market data on TradingView fix this?", a: "No. TradingView data alone does not grant Tradovate trading entitlement. You need an active Tradovate market-data subscription, and any Tradovate data you enable then flows into your TradingView charts automatically." },
    { q: "Will PickMyTrade still work if the TradingView broker login is broken?", a: "PickMyTrade connects to Tradovate through its own bridge and executes from your TradingView alerts, so it doesn't depend on the in-chart TradingView broker session that produces this error. Your Tradovate account still needs to be funded and in good standing to trade live." },
  ], de: [
    { q: "Was bedeutet \"Something went wrong, contact your broker\" bei TradingView mit Tradovate?", a: "Tradovate hat die Verbindung abgelehnt, weil dem Konto eine Voraussetzung fehlt. Meist ist es nicht finanziert, hat das TradingView-Add-on nicht aktiviert oder besitzt kein aktives Live-Marktdatenabonnement." },
    { q: "Warum kann ich mich mit meinem Tradovate-Konto nicht bei TradingView anmelden?", a: "Ist Ihr Live-Tradovate-Konto nicht finanziert, kann TradingView sich nicht anmelden und zeigt diesen Fehler. Finanzieren Sie das Konto oder verbinden Sie stattdessen Ihr Demo-(Sim-)Konto, nachdem Sie das TradingView-Add-on aktiviert haben." },
    { q: "Muss ich für das TradingView-Add-on bezahlen?", a: "Bei einem persönlichen Tradovate-Konto ja. Aktivieren Sie das TradingView-Add-on unter Settings > Add-ons (eine kleine, variable Monatsgebühr, bestätigen Sie also den aktuellen Preis), es sei denn, Ihr Kontotarif enthält TradingView bereits. Bei einem Prop- oder Evaluationskonto zahlen Sie dafür nichts. Die Firma aktiviert es." },
