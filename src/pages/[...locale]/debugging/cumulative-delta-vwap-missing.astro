---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "cumulative-delta-vwap-missing";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/debugging/${SLUG}`;

const META_TITLE = "Tradovate Cumulative Delta / VWAP Missing From List";
const META_DESCRIPTION =
  "VWAP and Cumulative Delta missing from your Tradovate indicator list? Turn on the Order Flow+ add-on, refresh, or use a custom indicator as a stopgap.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Tradovate: Cumulative Delta / VWAP fehlt in der Liste", es: "Cumulative Delta / VWAP no aparece en la lista de Tradovate", fr: "Cumulative Delta / VWAP absent de la liste Tradovate", it: "Cumulative Delta / VWAP mancante dall'elenco di Tradovate" },
  dek: { en: "You search the Indicators menu for VWAP or Cumulative Delta and get nothing back. Most of the time nothing's broken, both live behind the paid Order Flow+ add-on. Here's how to sort out which case you're in.", de: "Sie suchen im Menü Indicators nach VWAP oder Cumulative Delta und erhalten kein Ergebnis. Meistens ist nichts defekt, beide stecken hinter dem kostenpflichtigen Order Flow+-Add-on. So finden Sie heraus, welcher Fall bei Ihnen vorliegt.", es: "Busca VWAP o Cumulative Delta en el menú Indicators y no obtiene ningún resultado. La mayoría de las veces no hay ningún fallo, ambos están detrás del complemento de pago Order Flow+. Así puede averiguar en qué caso se encuentra.", fr: "Vous recherchez VWAP ou Cumulative Delta dans le menu Indicators et n'obtenez aucun résultat. La plupart du temps, rien n'est cassé, les deux se trouvent derrière le module complémentaire payant Order Flow+. Voici comment déterminer dans quel cas vous vous trouvez.", it: "Lei cerca VWAP o Cumulative Delta nel menu Indicators e non ottiene alcun risultato. Nella maggior parte dei casi non c'è nulla di rotto, entrambi si trovano dietro il componente aggiuntivo a pagamento Order Flow+. Ecco come stabilire in quale caso si trova." },
  readTime: { en: "8 min read", de: "8 Minuten Lesezeit", es: "Lectura de 8 minutos", fr: "Lecture de 8 minutes", it: "Lettura di 8 minuti" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "You open a chart, click the Indicators icon, type &ldquo;VWAP&rdquo; or &ldquo;Cumulative Delta,&rdquo; and get nothing back. It feels like a bug, and if you've watched other traders use both tools on Tradovate, it looks like something on your account is broken. Most of the time it isn't. VWAP and Cumulative Delta aren't part of the free set of built-in indicators, they ship inside a paid package called Order Flow+, and they only show up in the Indicators menu once that add-on is active. There's also a rarer version of this where the add-on is active and the indicators still don't appear, which Tradovate support has acknowledged shouldn't happen. This guide sorts out which case you're in, walks through turning on the add-on, and shows the free custom-indicator stopgap that keeps you reading order flow while you sort out the rest." },
    {
      type: "checklist",
      heading: "Quick Checklist for Missing VWAP / Cumulative Delta",
      items: [
        "<strong class='text-white'>Check whether Order Flow+ is active</strong>, open Application Settings &rsaquo; Add-ons. If Order Flow+ isn't subscribed, that's your answer, and neither indicator will be in the list.",
        "<strong class='text-white'>Subscribe to Order Flow+</strong>, it's a paid monthly add-on that unlocks VWAP, Cumulative Delta, Volume Profile, and the rest of the order-flow suite.",
        "<strong class='text-white'>Refresh the session after subscribing</strong>, log out and back in so the new entitlement actually loads, then reopen the Indicators menu.",
        "<strong class='text-white'>Confirm the right account</strong>, on prop and evaluation accounts, add-ons are controlled by the firm, not by you.",
        "<strong class='text-white'>Still missing with the add-on active?</strong>, that's the acknowledged glitch. Contact support with your account ID, and use a community Cumulative Delta / VWAP indicator as a stopgap.",
      ],
    },
    { type: "heading", text: "Why VWAP and Cumulative Delta Aren't in the Default List" },
    { type: "paragraph", html: "Tradovate ships with more than 40 built-in indicators on the web platform, moving averages, RSI, MACD, Bollinger Bands, ATR, and the usual technical toolkit. Those are free and always present in the Indicators menu. VWAP and Cumulative Delta are a different category. They belong to Order Flow+, a premium add-on aimed at order-flow and volume traders. Until that package is active on your account, its tools simply don't populate the list, so searching for them returns nothing." },
    { type: "paragraph", html: "Order Flow+ bundles a specific set of tools together:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>VWAP</strong>, the native Volume-Weighted Average Price indicator",
        "<strong class='text-white'>Cumulative Delta</strong>, running buy-vs-sell volume difference",
        "<strong class='text-white'>Volume Profile</strong>, plus a volume-profile drawing tool",
        "<strong class='text-white'>Volumetric (footprint) bars</strong>, bid/ask volume inside each bar",
        "<strong class='text-white'>Market Profile with TPO</strong>, Time Price Opportunity charts",
        "<strong class='text-white'>Trade Detector and Market Depth Map</strong>, large-order and liquidity views",
      ],
    },
    { type: "paragraph", html: "Once you understand that these are gated behind one subscription, the &ldquo;missing indicator&rdquo; problem stops being mysterious. In almost every case, the list is empty of VWAP and Cumulative Delta because Order Flow+ hasn't been switched on, not because your platform is broken." },
    { type: "heading", text: "Top Causes of Missing VWAP / Cumulative Delta in 2026" },
    { type: "heading", text: "1. Order Flow+ isn't subscribed on your account" },
    { type: "paragraph", html: "This is the big one and it covers most reports. No Order Flow+, no VWAP or Cumulative Delta in the menu. The tools aren't hidden behind a checkbox you overlooked, the whole package has to be a live subscription first. If you've never bought it, or a previous month's subscription lapsed (billing runs by calendar month), the indicators won't be listed at all." },
    { type: "heading", text: "2. You subscribed but the session hasn't refreshed" },
    { type: "paragraph", html: "Add-on entitlements don't always push into a session that's already open. You buy Order Flow+, jump straight back to the chart, click Indicators, and the names still aren't there, so it looks like the purchase didn't take. Nine times out of ten the account is fine and the running session is just stale. A full log-out and log-in reloads your entitlements and the tools appear." },
    { type: "heading", text: "3. It's a prop or evaluation account the firm controls" },
    { type: "paragraph", html: "On funded and evaluation accounts, market data and add-ons are typically managed by the prop firm rather than the trader. The Add-ons tab may be locked, greyed out, or simply won't complete a subscription. Whether Order Flow+ is bundled, optional at extra cost, or unavailable varies by firm and account size, check your firm's current rules, and if you need it enabled, that request goes to the firm's support, not directly through your own billing." },
    { type: "heading", text: "4. The add-on is active but the indicators still don't show" },
    { type: "paragraph", html: "This is the frustrating edge case. Order Flow+ is clearly subscribed and billed, you've refreshed, and VWAP or Cumulative Delta is still absent from the list. Tradovate support has acknowledged this one directly, the indicator should be visible, and when it isn't, that's a genuine account-side discrepancy on their end rather than something you can toggle away. The fix here isn't a setting; it's a support ticket, with the custom-indicator workaround holding you over." },
    { type: "heading", text: "5. You're looking on the wrong platform" },
    { type: "paragraph", html: "The full indicator list and the Order Flow+ tools live on the web and desktop platforms. If you're searching on the mobile app, or on the older Legacy Chart module, you may not see the same set. Before assuming an entitlement problem, confirm you're on the current chart on web or desktop, where everything is meant to appear." },
    { type: "heading", text: "How to Fix It: Step-by-Step" },
    { type: "heading", text: "Step 1: Check whether Order Flow+ is active" },
    { type: "paragraph", html: "Start by confirming the root cause before you buy anything." },
    {
      type: "steps",
      items: [
        { title: "Open Application Settings", html: "On the Tradovate web platform, click Application Settings in the upper-right corner of the screen." },
        { title: "Open the Add-ons tab", html: "Open the Add-ons tab." },
        { title: "Check the Order Flow+ status", html: "Scroll to Order Flow+ and check its status. If it shows a Buy or Subscribe action, the package isn't active yet, that's why the indicators are missing." },
      ],
    },
    { type: "paragraph", html: "Menu labels move around between platform versions, so if you don't see an &ldquo;Add-ons&rdquo; tab by that exact name, look for the equivalent subscriptions or add-ons section in settings." },
    { type: "heading", text: "Step 2: Subscribe to Order Flow+" },
    { type: "paragraph", html: "If it isn't active and you want the native tools:" },
    {
      type: "steps",
      items: [
        { title: "Subscribe from the Add-ons tab", html: "From the same Add-ons tab, select Order Flow+ and complete the subscription. It's a paid monthly package, billed for the calendar month regardless of the day you buy." },
        { title: "Contact your firm if locked", html: "On a prop or evaluation account, if the option is locked, stop here and contact your firm to have it enabled instead." },
      ],
    },
    { type: "heading", text: "Step 3: Refresh, then reopen the Indicators menu" },
    { type: "paragraph", html: "Don't judge the result from your current session." },
    {
      type: "steps",
      items: [
        { title: "Log out and back in", html: "Log out completely and log back in (or fully restart the desktop app) so the new entitlement loads." },
        { title: "Open the Indicators menu", html: "Open a chart, hover to bring up the toolbar, and click the Indicators icon." },
        { title: "Search and add", html: "Search for &ldquo;VWAP&rdquo; and &ldquo;Cumulative Delta.&rdquo; With Order Flow+ active and the session refreshed, both should now be in the list. Click either name to open its Properties, adjust settings, and save it to the chart." },
      ],
    },
    { type: "heading", text: "Step 4: Use a custom indicator as a stopgap" },
    { type: "paragraph", html: "If you don't want to pay yet, or you're stuck in the acknowledged glitch, custom indicators still work regardless of the Order Flow+ state." },
    {
      type: "steps",
      items: [
        { title: "Open the Indicators menu", html: "Open the Indicators menu on a chart." },
        { title: "Find a community build", html: "Browse or search the community / custom indicators section for a Cumulative Delta or VWAP build." },
        { title: "Add it to the chart", html: "Add it the same way you'd add any indicator. It won't be a pixel-for-pixel match to the native version, but it delivers the same core read, running delta or a volume-weighted average line, at no cost." },
      ],
    },
    { type: "heading", text: "Step 5: Contact support if it's active but still missing" },
    { type: "paragraph", html: "When Order Flow+ is billed and active, you've refreshed, and the indicators are still gone, this is the case support has said should just work. Open a ticket, include your account ID and a screenshot of the empty Indicators list alongside proof the add-on is active, and ask them to correct the entitlement on their side. That's the reliable path, there's no client-side toggle that fixes a genuine account-side discrepancy." },
    { type: "heading", text: "Troubleshooting Table" },
    {
      type: "table",
      headers: ["Symptom", "What it means", "Fix"],
      rows: [
        ["VWAP / Cumulative Delta not in the Indicators list at all", "Order Flow+ add-on isn't subscribed", "Application Settings &rsaquo; Add-ons &rsaquo; subscribe to Order Flow+"],
        ["Just subscribed, still not showing", "Session is stale and hasn't loaded the entitlement", "Log out and back in, then reopen the Indicators menu"],
        ["Add-ons tab is locked or greyed out", "Prop / evaluation account controlled by the firm", "Ask your prop firm to enable Order Flow+ for the account"],
        ["Add-on active and billed, indicators still absent", "Acknowledged account-side display discrepancy", "Open a support ticket with account ID + screenshot"],
        ["Can't find them on the phone app", "Full indicator set lives on web / desktop", "Check on the web or desktop platform first"],
        ["Don't want to pay for the add-on", "Native tools are gated behind Order Flow+", "Add a community custom Cumulative Delta / VWAP indicator"],
      ],
    },
    { type: "heading", text: "Trade Your Order Flow Signals Automatically With PickMyTrade" },
    { type: "paragraph", html: "Whether you settle on the native Order Flow+ tools or a custom build, the point of watching VWAP and Cumulative Delta is to act on them, a reclaim of VWAP, a delta divergence, a shift in who's leaning on the book. If you're clicking the order in manually every time, you're fighting your own reaction speed. PickMyTrade closes that gap:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Build the signal where the indicators are free</strong>, set your VWAP and Cumulative Delta logic in TradingView, where both are native, so a missing add-on never stalls your strategy.",
        "<strong class='text-white'>Alerts become live orders</strong>, a VWAP cross or delta trigger fires an alert that turns into a real Tradovate order with no manual clicks.",
        "<strong class='text-white'>Automated execution to Tradovate</strong>, entries, stops, and targets route straight through at the moment your order-flow condition hits.",
        "<strong class='text-white'>Multi-Account Sync</strong>, mirror the same automated entry across several Tradovate accounts at once, so every account trades the same read.",
      ],
    },
  ], de: [
    { type: "paragraph", html: "Sie öffnen einen Chart, klicken auf das Indicators-Symbol, geben &ldquo;VWAP&rdquo; oder &ldquo;Cumulative Delta&rdquo; ein und erhalten kein Ergebnis. Das fühlt sich wie ein Fehler an, und wenn Sie andere Trader beide Tools auf Tradovate nutzen gesehen haben, wirkt es so, als wäre bei Ihrem Konto etwas kaputt. Meistens ist das nicht der Fall. VWAP und Cumulative Delta gehören nicht zum kostenlosen Satz der integrierten Indikatoren, sondern sind Teil eines kostenpflichtigen Pakets namens Order Flow+ und erscheinen im Menü Indicators erst, wenn dieses Add-on aktiv ist. Es gibt auch eine seltenere Variante, bei der das Add-on aktiv ist und die Indikatoren trotzdem nicht erscheinen, was der Tradovate-Support als Fehler bestätigt hat, der eigentlich nicht auftreten sollte. Dieser Leitfaden klärt, welcher Fall bei Ihnen vorliegt, führt Sie durch die Aktivierung des Add-ons und zeigt die kostenlose Übergangslösung mit einem benutzerdefinierten Indikator, mit der Sie den Orderfluss weiter im Blick behalten, während Sie den Rest klären." },
    {
      type: "checklist",
      heading: "Schnelle Checkliste bei fehlendem VWAP / Cumulative Delta",
      items: [
        "<strong class='text-white'>Prüfen Sie, ob Order Flow+ aktiv ist</strong>, öffnen Sie Application Settings &rsaquo; Add-ons. Ist Order Flow+ nicht abonniert, haben Sie die Antwort, und keiner der beiden Indikatoren wird in der Liste erscheinen.",
        "<strong class='text-white'>Abonnieren Sie Order Flow+</strong>, es handelt sich um ein kostenpflichtiges monatliches Add-on, das VWAP, Cumulative Delta, Volume Profile und den Rest der Order-Flow-Suite freischaltet.",
        "<strong class='text-white'>Aktualisieren Sie die Sitzung nach dem Abonnieren</strong>, melden Sie sich ab und wieder an, damit die neue Berechtigung tatsächlich geladen wird, und öffnen Sie dann das Menü Indicators erneut.",
        "<strong class='text-white'>Bestätigen Sie das richtige Konto</strong>, bei Prop- und Evaluierungskonten werden Add-ons von der Firma kontrolliert, nicht von Ihnen.",
        "<strong class='text-white'>Fehlt trotz aktivem Add-on weiterhin?</strong>, das ist der bestätigte Fehler. Kontaktieren Sie den Support mit Ihrer Konto-ID und nutzen Sie übergangsweise einen Community-Indikator für Cumulative Delta / VWAP.",
      ],
    },
    { type: "heading", text: "Warum VWAP und Cumulative Delta nicht in der Standardliste erscheinen" },
    { type: "paragraph", html: "Tradovate liefert auf der Webplattform mehr als 40 integrierte Indikatoren, gleitende Durchschnitte, RSI, MACD, Bollinger-Bänder, ATR und das übliche technische Werkzeug. Diese sind kostenlos und immer im Menü Indicators vorhanden. VWAP und Cumulative Delta gehören zu einer anderen Kategorie. Sie sind Teil von Order Flow+, einem Premium-Add-on für Order-Flow- und Volumen-Trader. Solange dieses Paket bei Ihrem Konto nicht aktiv ist, werden seine Tools in der Liste einfach nicht angezeigt, sodass die Suche danach kein Ergebnis liefert." },
    { type: "paragraph", html: "Order Flow+ bündelt einen bestimmten Satz an Tools:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>VWAP</strong>, der native Volume-Weighted-Average-Price-Indikator",
        "<strong class='text-white'>Cumulative Delta</strong>, die laufende Differenz zwischen Kauf- und Verkaufsvolumen",
        "<strong class='text-white'>Volume Profile</strong>, plus ein Zeichenwerkzeug für das Volume Profile",
        "<strong class='text-white'>Volumetric (Footprint) Bars</strong>, Bid-/Ask-Volumen innerhalb jeder Kerze",
        "<strong class='text-white'>Market Profile mit TPO</strong>, Time-Price-Opportunity-Charts",
        "<strong class='text-white'>Trade Detector und Market Depth Map</strong>, Ansichten für Großorders und Liquidität",
      ],
    },
    { type: "paragraph", html: "Sobald Sie verstanden haben, dass diese Tools hinter einem einzigen Abonnement liegen, verliert das Problem des &ldquo;fehlenden Indikators&rdquo; seinen Rätselcharakter. In fast allen Fällen fehlen VWAP und Cumulative Delta in der Liste, weil Order Flow+ nicht aktiviert wurde, und nicht, weil Ihre Plattform defekt ist." },
    { type: "heading", text: "Häufigste Ursachen für fehlendes VWAP / Cumulative Delta im Jahr 2026" },
    { type: "heading", text: "1. Order Flow+ ist bei Ihrem Konto nicht abonniert" },
    { type: "paragraph", html: "Das ist die häufigste Ursache und deckt die meisten Meldungen ab. Kein Order Flow+, kein VWAP oder Cumulative Delta im Menü. Die Tools verstecken sich nicht hinter einer übersehenen Checkbox, das gesamte Paket muss zunächst ein aktives Abonnement sein. Wenn Sie es nie gekauft haben oder ein früheres Monatsabonnement ausgelaufen ist (die Abrechnung erfolgt kalendermonatlich), werden die Indikatoren überhaupt nicht aufgeführt." },
    { type: "heading", text: "2. Sie haben abonniert, aber die Sitzung wurde nicht aktualisiert" },
    { type: "paragraph", html: "Add-on-Berechtigungen werden nicht immer sofort in eine bereits geöffnete Sitzung übernommen. Sie kaufen Order Flow+, springen direkt zurück zum Chart, klicken auf Indicators, und die Namen sind immer noch nicht da, sodass es aussieht, als hätte der Kauf nicht funktioniert. In neun von zehn Fällen ist mit dem Konto alles in Ordnung und die laufende Sitzung ist nur veraltet. Ein vollständiges Ab- und wieder Anmelden lädt Ihre Berechtigungen neu, und die Tools erscheinen." },
    { type: "heading", text: "3. Es handelt sich um ein Prop- oder Evaluierungskonto, das von der Firma kontrolliert wird" },
    { type: "paragraph", html: "Bei finanzierten Konten und Evaluierungskonten werden Marktdaten und Add-ons in der Regel von der Prop-Firma verwaltet und nicht vom Trader. Der Reiter Add-ons kann gesperrt oder ausgegraut sein, oder ein Abonnement lässt sich einfach nicht abschließen. Ob Order Flow+ im Paket enthalten, gegen Aufpreis optional oder gar nicht verfügbar ist, hängt von der Firma und der Kontogröße ab. Prüfen Sie die aktuellen Regeln Ihrer Firma, und wenn Sie es aktiviert haben möchten, richten Sie diese Anfrage an den Support der Firma und nicht direkt über Ihre eigene Abrechnung." },
    { type: "heading", text: "4. Das Add-on ist aktiv, aber die Indikatoren werden weiterhin nicht angezeigt" },
    { type: "paragraph", html: "Das ist der frustrierende Grenzfall. Order Flow+ ist eindeutig abonniert und abgerechnet, Sie haben aktualisiert, und VWAP oder Cumulative Delta fehlen trotzdem in der Liste. Der Tradovate-Support hat dies direkt bestätigt: Der Indikator sollte sichtbar sein, und wenn er es nicht ist, handelt es sich um eine echte Abweichung auf Kontoseite bei Tradovate und nicht um etwas, das Sie selbst umschalten können. Die Lösung hier ist keine Einstellung, sondern ein Support-Ticket, wobei die Übergangslösung mit einem benutzerdefinierten Indikator Ihnen in der Zwischenzeit weiterhilft." },
    { type: "heading", text: "5. Sie schauen auf der falschen Plattform nach" },
    { type: "paragraph", html: "Die vollständige Indikatorenliste und die Order Flow+-Tools befinden sich auf der Web- und der Desktop-Plattform. Wenn Sie in der mobilen App oder im älteren Legacy-Chart-Modul suchen, sehen Sie möglicherweise nicht denselben Umfang. Bevor Sie von einem Berechtigungsproblem ausgehen, stellen Sie sicher, dass Sie sich im aktuellen Chart auf Web oder Desktop befinden, wo alles erscheinen soll." },
    { type: "heading", text: "So beheben Sie es: Schritt für Schritt" },
    { type: "heading", text: "Schritt 1: Prüfen Sie, ob Order Flow+ aktiv ist" },
    { type: "paragraph", html: "Bestätigen Sie zunächst die Ursache, bevor Sie etwas kaufen." },
    {
      type: "steps",
      items: [
        { title: "Öffnen Sie Application Settings", html: "Klicken Sie auf der Tradovate-Webplattform oben rechts im Bildschirm auf Application Settings." },
        { title: "Öffnen Sie den Reiter Add-ons", html: "Öffnen Sie den Reiter Add-ons." },
        { title: "Prüfen Sie den Status von Order Flow+", html: "Scrollen Sie zu Order Flow+ und prüfen Sie den Status. Wird eine Buy- oder Subscribe-Aktion angezeigt, ist das Paket noch nicht aktiv, deshalb fehlen die Indikatoren." },
      ],
    },
    { type: "paragraph", html: "Menübezeichnungen ändern sich zwischen den Plattformversionen. Wenn Sie also keinen Reiter mit genau der Bezeichnung &ldquo;Add-ons&rdquo; sehen, suchen Sie in den Einstellungen nach dem entsprechenden Bereich für Abonnements oder Add-ons." },
    { type: "heading", text: "Schritt 2: Order Flow+ abonnieren" },
    { type: "paragraph", html: "Wenn es nicht aktiv ist und Sie die nativen Tools nutzen möchten:" },
    {
      type: "steps",
      items: [
        { title: "Abonnieren Sie im Reiter Add-ons", html: "Wählen Sie im selben Reiter Add-ons Order Flow+ aus und schließen Sie das Abonnement ab. Es handelt sich um ein kostenpflichtiges monatliches Paket, das unabhängig vom Kaufdatum für den Kalendermonat abgerechnet wird." },
        { title: "Kontaktieren Sie Ihre Firma, wenn gesperrt", html: "Ist die Option bei einem Prop- oder Evaluierungskonto gesperrt, brechen Sie hier ab und kontaktieren Sie stattdessen Ihre Firma, damit diese aktiviert wird." },
      ],
    },
    { type: "heading", text: "Schritt 3: Aktualisieren und das Menü Indicators erneut öffnen" },
    { type: "paragraph", html: "Beurteilen Sie das Ergebnis nicht anhand Ihrer aktuellen Sitzung." },
    {
      type: "steps",
      items: [
        { title: "Ab- und wieder anmelden", html: "Melden Sie sich vollständig ab und wieder an (oder starten Sie die Desktop-App vollständig neu), damit die neue Berechtigung geladen wird." },
        { title: "Öffnen Sie das Menü Indicators", html: "Öffnen Sie einen Chart, bewegen Sie den Mauszeiger, um die Symbolleiste einzublenden, und klicken Sie auf das Indicators-Symbol." },
        { title: "Suchen und hinzufügen", html: "Suchen Sie nach &ldquo;VWAP&rdquo; und &ldquo;Cumulative Delta&rdquo;. Bei aktivem Order Flow+ und aktualisierter Sitzung sollten beide jetzt in der Liste erscheinen. Klicken Sie auf einen der Namen, um dessen Properties zu öffnen, Einstellungen anzupassen und ihn im Chart zu speichern." },
      ],
    },
    { type: "heading", text: "Schritt 4: Einen benutzerdefinierten Indikator als Übergangslösung verwenden" },
    { type: "paragraph", html: "Wenn Sie noch nicht zahlen möchten oder von dem bestätigten Fehler betroffen sind, funktionieren benutzerdefinierte Indikatoren unabhängig vom Status von Order Flow+ weiterhin." },
    {
      type: "steps",
      items: [
        { title: "Öffnen Sie das Menü Indicators", html: "Öffnen Sie das Menü Indicators in einem Chart." },
        { title: "Finden Sie eine Community-Version", html: "Durchsuchen Sie den Bereich für Community-/benutzerdefinierte Indikatoren nach einer Cumulative-Delta- oder VWAP-Version." },
        { title: "Fügen Sie ihn dem Chart hinzu", html: "Fügen Sie ihn genauso hinzu wie jeden anderen Indikator. Er wird nicht pixelgenau der nativen Version entsprechen, liefert aber dieselbe grundlegende Aussage, laufendes Delta oder eine volumengewichtete Durchschnittslinie, kostenlos." },
      ],
    },
    { type: "heading", text: "Schritt 5: Support kontaktieren, wenn es aktiv ist, aber weiterhin fehlt" },
    { type: "paragraph", html: "Wenn Order Flow+ abgerechnet und aktiv ist, Sie aktualisiert haben und die Indikatoren trotzdem fehlen, handelt es sich um den Fall, von dem der Support gesagt hat, dass er eigentlich funktionieren sollte. Öffnen Sie ein Ticket, geben Sie Ihre Konto-ID und einen Screenshot der leeren Indicators-Liste zusammen mit dem Nachweis an, dass das Add-on aktiv ist, und bitten Sie darum, die Berechtigung auf ihrer Seite zu korrigieren. Das ist der zuverlässige Weg, es gibt keinen clientseitigen Schalter, der eine echte kontoseitige Abweichung behebt." },
