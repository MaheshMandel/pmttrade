---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "ninjatrader-client-app-prohibited";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/debugging/${SLUG}`;

const META_TITLE = "NinjaTrader 'Client App Prohibited' Tradovate Login";
const META_DESCRIPTION =
  "NinjaTrader shows Client App Prohibited on your Tradovate login? Learn what it means, why to stop retrying, and how to get your account authorized fast.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "NinjaTrader „Client App Prohibited“ beim Tradovate-Login", es: "Inicio de sesión de Tradovate en NinjaTrader: “Client App Prohibited”", fr: "Connexion Tradovate dans NinjaTrader : « Client App Prohibited »", it: "Login Tradovate in NinjaTrader: “Client App Prohibited”" },
  dek: { en: "NinjaTrader answers your Tradovate login with a blunt “Client App is Prohibited,” and retrying only pushes you toward a lockout. Here's what the block actually means and the exact path back to a working connection.", de: "NinjaTrader beantwortet Ihren Tradovate-Login mit einem schroffen „Client App is Prohibited“, und weitere Versuche führen Sie nur in eine Sperre. Hier erfahren Sie, was die Blockade tatsächlich bedeutet und welchen genauen Weg es zurück zu einer funktionierenden Verbindung gibt.", es: "NinjaTrader responde a su inicio de sesión de Tradovate con un seco “Client App is Prohibited”, y reintentarlo solo le acerca a un bloqueo. Le explicamos qué significa realmente el bloqueo y el camino exacto para volver a una conexión que funcione.", fr: "NinjaTrader répond à votre connexion Tradovate par un sec « Client App is Prohibited », et réessayer ne fait que vous rapprocher d'un verrouillage. Voici ce que signifie réellement ce blocage et le chemin exact pour retrouver une connexion fonctionnelle.", it: "NinjaTrader risponde al suo login Tradovate con un secco “Client App is Prohibited”, e riprovare la spinge soltanto verso un blocco. Ecco cosa significa davvero il blocco e il percorso esatto per tornare a una connessione funzionante." },
  readTime: { en: "7 min read", de: "7 Min. Lesezeit", es: "Lectura de 7 min", fr: "Lecture : 7 min", it: "Lettura di 7 min" },
  lastUpdated: "2026-07-10",
  blocks: { en: [
    { type: "paragraph", html: "You type your Tradovate credentials into NinjaTrader, hit connect, and instead of a live account you get a blunt message: <strong class='text-white'>Client App is Prohibited</strong>. Try again and it often turns into “client app prohibited logon failed” followed by “too many login attempts.” Here's the short version before anything else: stop retrying. This is not a wrong-password glitch you can push through. It's a permissions block, and every extra attempt drags you deeper into a login lockout instead of getting you connected. The fix is to confirm whether your account is even allowed to connect through NinjaTrader, then email NinjaTrader support with the exact username you're using so they can check the authorization. This guide covers what the error really means in 2026, why NinjaTrader throws it, and every route back to a working account." },
    { type: "quote", html: "<strong class='text-white'>Quick answer:</strong> “Client App Prohibited” means the login you entered is not authorized to connect through NinjaTrader, usually because it's a Tradovate-based prop or evaluation account that runs on Tradovate's own apps rather than inside NinjaTrader. Stop retrying so you don't trip a lockout, then email <strong class='text-white'>support@ninjatrader.com</strong> with the username you use to log into NinjaTrader and let them verify whether the account is eligible." },
    {
      type: "checklist",
      heading: "Quick Checklist",
      items: [
        "<strong class='text-white'>Stop retrying immediately.</strong> The prohibited-client message escalates into a “too many login attempts” lockout, and each new try can reset the timer.",
        "<strong class='text-white'>Confirm which platform your account is licensed for.</strong> A Tradovate-based prop or evaluation account is not automatically cleared to connect through NinjaTrader.",
        "<strong class='text-white'>Check you're using the right login.</strong> The username for your firm's Tradovate account is not the same as a NinjaTrader Dashboard login.",
        "<strong class='text-white'>Email NinjaTrader support with your username.</strong> Send it to support@ninjatrader.com so they can verify the account's authorization.",
        "<strong class='text-white'>Attach log and trace files</strong> from Control Center, Help, Email Support, choosing Platform Technical Support, so the team can see the exact failure.",
        "<strong class='text-white'>If NinjaTrader isn't required,</strong> automate the same Tradovate account through a bridge that connects to Tradovate directly.",
      ],
    },
    { type: "heading", text: "What “Client App Prohibited” Actually Means" },
    { type: "paragraph", html: "Most login errors are about credentials: wrong password, expired token, unapproved device. This one is different. “Client App Prohibited” is an authorization block. It's NinjaTrader (the client app) being told that the login you supplied isn't permitted to open a session through it. The credentials themselves can be perfectly correct. The problem is that the account behind them isn't cleared to run inside NinjaTrader." },
    { type: "paragraph", html: "That's why the wording matters. On the connection attempt you'll often see the phrase “client app prohibited logon failed,” and once you've tried a few times in a row, a second line joins it: “too many login attempts.” The first line is the permissions block. The second is the security throttle that kicks in when you keep pushing. They look like one problem, but they have two different causes, and treating them as a single “let me just re-enter my password” issue is exactly what turns a five-minute check into an hour-long lockout." },
    { type: "heading", text: "Why NinjaTrader Blocks the Tradovate Login" },
    { type: "paragraph", html: "There are three common reasons the message shows up, and figuring out which one you're in decides your next move." },
    { type: "heading", text: "1. The account isn't authorized to connect through NinjaTrader" },
    { type: "paragraph", html: "This is the big one. A lot of Tradovate-based accounts, especially prop-firm evaluation and funded accounts, are provisioned to run on Tradovate's own web, desktop, and mobile platforms. They aren't automatically licensed to route through NinjaTrader. When you feed one of those logins into NinjaTrader, the connection is rejected as a prohibited client because the account was never cleared for that path. The username is valid; it just isn't valid <em>here</em>." },
    { type: "heading", text: "2. Your firm connects through Rithmic, not Tradovate, inside NinjaTrader" },
    { type: "paragraph", html: "Some firms hand you an account that can connect in NinjaTrader, but only when it's set up on Rithmic rather than Tradovate. In that arrangement the Tradovate version of the account and the NinjaTrader (Rithmic) version are separate connections, and enabling one can block the other. Topstep is a well-known example where, at the time of writing, the account connects in NinjaTrader through Rithmic while the Tradovate-based version does not. This varies by firm and it changes over time, so treat it as a prompt to check your firm's current rules rather than a fixed rule." },
    { type: "heading", text: "3. Your NinjaTrader Dashboard account or build is out of date" },
    { type: "paragraph", html: "If you're trying to connect a personal Tradovate account (not a prop account) and it still bounces, the cause is often on the NinjaTrader side. The login may not be tied to a NinjaTrader Dashboard account with the right license imported, you may be on an old build, or Multi-Provider Mode isn't enabled. In that case the account is eligible, but the local setup hasn't been prepared to accept it yet." },
    { type: "heading", text: "Stop Retrying Before You Get Locked Out" },
    { type: "paragraph", html: "Here's the part people skip, and it's the one that hurts. The prohibited-client message doesn't fix itself when you re-enter the password, because your password was never the problem. What re-entering it does do is rack up failed attempts. After enough of them, NinjaTrader's security layer stops responding to logins for a set cooldown, and the “too many login attempts” line appears. Keep going and you can reset that cooldown clock every time you try, which means you sit locked out longer than if you'd simply stopped." },
    { type: "paragraph", html: "The cooldown is time-based and generally clears after roughly an hour, though the exact figure can shift between releases, so confirm it in your version. Newer builds add a reCaptcha prompt so you can clear the throttle by solving a puzzle instead of waiting the full window. Either way, the move is the same: the moment you see “Client App Prohibited,” stop." },
    { type: "heading", text: "How to Fix It: Step-by-Step" },
    {
      type: "steps",
      items: [
        { title: "Stop and confirm the account type", html: "Close the connection dialog. Before you touch the login again, answer one question: is this a prop-firm or evaluation account, or a personal Tradovate account you opened yourself? Prop and evaluation accounts are the ones most likely to be locked to Tradovate's own apps. If it's a firm account, your firm's support or dashboard is where you confirm which platform and connection type it's licensed for. If it's personal, move to the NinjaTrader-side setup in the fourth step." },
        { title: "Verify you're using the correct login", html: "Make sure the username and password you're entering are the ones for the exact account you mean to trade. A firm-issued Tradovate login is separate from a NinjaTrader Dashboard login, and mixing them up produces the same failure. If your firm connects through Rithmic in NinjaTrader, use the Rithmic credentials and connection type there, and keep the Tradovate login for Tradovate's platforms." },
        { title: "Email NinjaTrader support with your username", html: "This is the step that actually resolves a genuine prohibited-client block. Write to <strong class='text-white'>support@ninjatrader.com</strong> and include the exact username you use to log into the NinjaTrader platform, along with a short note that you're getting a “Client App Prohibited” error trying to connect a Tradovate account. That username lets the team check whether the account is authorized on their side. To give them the full picture, attach your log and trace files: in NinjaTrader, open <strong class='text-white'>Control Center &rsaquo; Help &rsaquo; Email Support</strong> and select <strong class='text-white'>Platform Technical Support</strong> as the recipient. Confirm the exact menu labels in your build, since these move around between versions." },
        { title: "If it's a personal Tradovate account, fix the NinjaTrader side", html: "For an eligible personal account that still won't connect, prepare the local setup. Make sure you have a NinjaTrader Dashboard account with your license key imported, update NinjaTrader to a current build, and enable Multi-Provider Mode so it can hold a Tradovate connection alongside your NinjaTrader login. Once the Dashboard side is in order, add the Tradovate connection again with the correct credentials. If it connects cleanly, you're done. If it still returns the prohibited-client message, the account isn't authorized for NinjaTrader and the previous step is your path." },
        { title: "Don't retry in a loop while you wait", html: "If you tripped the “too many login attempts” throttle along the way, let it clear. Wait out the cooldown or answer the reCaptcha if your build offers one, and resist testing the login every few minutes. One clean attempt after the wait tells you more than ten frustrated ones." },
      ],
    },
    { type: "heading", text: "Troubleshooting Table" },
    {
      type: "table",
      headers: ["What you see", "What it means", "What to do"],
      rows: [
        ["Client App is Prohibited / client app prohibited logon failed", "The login isn't authorized to connect through NinjaTrader", "Stop retrying; confirm the account is eligible, then email support@ninjatrader.com with your username"],
        ["Prohibited message on a prop / evaluation account", "The account is likely licensed for Tradovate's own apps, not NinjaTrader", "Check your firm's current platform rules; use the connection type (e.g. Rithmic) your firm supports in NinjaTrader"],
        ["“Too many login attempts” appears after retries", "A time-based security cooldown from repeated failures", "Stop trying, wait it out (about an hour), or answer the reCaptcha if your build shows one"],
        ["Prohibited message on a personal Tradovate account", "Dashboard account, license, build, or Multi-Provider Mode not set up", "Import your license, update NinjaTrader, enable Multi-Provider Mode, reconnect"],
        ["Connects on Tradovate's app but not in NinjaTrader", "The account path is Tradovate-only, not NinjaTrader-authorized", "Trade it on Tradovate's platform, or automate it through a Tradovate-direct bridge"],
      ],
    },
    { type: "heading", text: "If Your Account Just Won't Connect to NinjaTrader" },
    { type: "paragraph", html: "Sometimes the honest answer is that the account was never meant to run in NinjaTrader. Support confirms it, your firm confirms it, and no setup changes that. That doesn't mean you're stuck trading by hand. Your Tradovate-based account still works fine on Tradovate's own platforms, and it can still be automated." },
    { type: "paragraph", html: "This is where routing your strategy through PickMyTrade solves the whole problem from a different angle. Instead of fighting NinjaTrader to accept a login it won't take, PickMyTrade connects to Tradovate directly and turns your TradingView alerts into live orders on that account:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Tradovate-direct connection</strong> so you don't depend on NinjaTrader authorizing the account at all.",
        "<strong class='text-white'>TradingView alerts to live orders</strong> so a strategy or indicator can fire entries, stops, and targets on your Tradovate account automatically.",
        "<strong class='text-white'>One managed session</strong> that connects once and holds, rather than repeatedly logging in and provoking a lockout.",
        "<strong class='text-white'>Multi-account support</strong> so you can mirror the same orders across several Tradovate accounts from one place.",
      ],
    },
    { type: "paragraph", html: "If your goal was automation and NinjaTrader was just the vehicle, this gets you there without the prohibited-client wall." },
  ], de: [
    { type: "paragraph",html: "Sie tippen Ihre Tradovate-Zugangsdaten in NinjaTrader ein, klicken auf Verbinden und erhalten statt eines Live-Kontos eine schroffe Meldung: <strong class='text-white'>Client App is Prohibited</strong>. Versuchen Sie es erneut, wird daraus oft „client app prohibited logon failed“, gefolgt von „too many login attempts“. Vorab die Kurzfassung: Hören Sie auf, es erneut zu versuchen. Das ist kein Falsches-Passwort-Problem, das Sie durchdrücken können. Es ist eine Berechtigungsblockade, und jeder zusätzliche Versuch zieht Sie tiefer in eine Login-Sperre, statt Sie zu verbinden. Die Lösung besteht darin, zu klären, ob Ihr Konto sich überhaupt über NinjaTrader verbinden darf, und dann den NinjaTrader-Support mit dem genauen verwendeten Benutzernamen anzuschreiben, damit er die Berechtigung prüfen kann. Dieser Leitfaden erklärt, was der Fehler 2026 wirklich bedeutet, warum NinjaTrader ihn auslöst und alle Wege zurück zu einem funktionierenden Konto." },
    { type: "quote",html: "<strong class='text-white'>Kurze Antwort:</strong> „Client App Prohibited“ bedeutet, dass der eingegebene Login nicht berechtigt ist, sich über NinjaTrader zu verbinden, meist weil es ein Tradovate-basiertes Prop- oder Evaluierungskonto ist, das auf den eigenen Apps von Tradovate läuft und nicht in NinjaTrader. Hören Sie auf, es erneut zu versuchen, um keine Sperre auszulösen, und schreiben Sie dann an <strong class='text-white'>support@ninjatrader.com</strong> mit dem Benutzernamen, mit dem Sie sich bei NinjaTrader anmelden, und lassen Sie prüfen, ob das Konto berechtigt ist." },
    {
      type: "checklist",
      heading: "Schnell-Checkliste",
      items: [
        "<strong class='text-white'>Hören Sie sofort auf, es erneut zu versuchen.</strong> Die Meldung zum gesperrten Client eskaliert zu einer „too many login attempts“-Sperre, und jeder neue Versuch kann den Timer zurücksetzen.",
        "<strong class='text-white'>Bestätigen Sie, für welche Plattform Ihr Konto lizenziert ist.</strong> Ein Tradovate-basiertes Prop- oder Evaluierungskonto ist nicht automatisch für die Verbindung über NinjaTrader freigegeben.",
        "<strong class='text-white'>Prüfen Sie, ob Sie den richtigen Login verwenden.</strong> Der Benutzername für das Tradovate-Konto Ihrer Firma ist nicht dasselbe wie ein Login für das NinjaTrader Dashboard.",
        "<strong class='text-white'>Schreiben Sie dem NinjaTrader-Support mit Ihrem Benutzernamen.</strong> Senden Sie ihn an support@ninjatrader.com, damit die Berechtigung des Kontos geprüft werden kann.",
        "<strong class='text-white'>Hängen Sie Log- und Trace-Dateien an</strong> über Control Center, Help, Email Support und die Auswahl Platform Technical Support, damit das Team den genauen Fehler sieht.",
        "<strong class='text-white'>Wenn NinjaTrader nicht erforderlich ist,</strong> automatisieren Sie dasselbe Tradovate-Konto über eine Brücke, die sich direkt mit Tradovate verbindet.",
      ],
    },
    { type: "heading",text: "Was „Client App Prohibited“ tatsächlich bedeutet" },
    { type: "paragraph",html: "Die meisten Login-Fehler betreffen Zugangsdaten: falsches Passwort, abgelaufenes Token, nicht freigegebenes Gerät. Dieser hier ist anders. „Client App Prohibited“ ist eine Autorisierungsblockade. NinjaTrader (die Client-App) wird mitgeteilt, dass der von Ihnen angegebene Login keine Sitzung darüber öffnen darf. Die Zugangsdaten selbst können völlig korrekt sein. Das Problem ist, dass das dahinterstehende Konto nicht für den Betrieb in NinjaTrader freigegeben ist." },
    { type: "paragraph",html: "Deshalb ist der Wortlaut wichtig. Beim Verbindungsversuch sehen Sie oft die Formulierung „client app prohibited logon failed“, und nach einigen Versuchen hintereinander kommt eine zweite Zeile hinzu: „too many login attempts“. Die erste Zeile ist die Berechtigungsblockade. Die zweite ist die Sicherheitsdrosselung, die greift, wenn Sie weiter drücken. Sie sehen aus wie ein Problem, haben aber zwei verschiedene Ursachen, und sie als einheitliches „ich gebe einfach mein Passwort noch mal ein“-Problem zu behandeln, macht aus einer Fünf-Minuten-Prüfung eine einstündige Sperre." },
    { type: "heading",text: "Warum NinjaTrader den Tradovate-Login blockiert" },
    { type: "paragraph",html: "Es gibt drei häufige Gründe, warum die Meldung erscheint, und die Klärung, in welcher Situation Sie sind, entscheidet über Ihren nächsten Schritt." },
    { type: "heading",text: "1. Das Konto ist nicht berechtigt, sich über NinjaTrader zu verbinden" },
    { type: "paragraph",html: "Das ist der große Punkt. Viele Tradovate-basierte Konten, insbesondere Prop-Firm-Evaluierungs- und Funded-Konten, sind für die eigenen Web-, Desktop- und Mobil-Plattformen von Tradovate bereitgestellt. Sie sind nicht automatisch für das Routing über NinjaTrader lizenziert. Wenn Sie einen solchen Login in NinjaTrader eingeben, wird die Verbindung als gesperrter Client abgelehnt, weil das Konto für diesen Weg nie freigegeben wurde. Der Benutzername ist gültig; er ist nur <em>hier</em> nicht gültig." },
    { type: "heading",text: "2. Ihre Firma verbindet in NinjaTrader über Rithmic, nicht über Tradovate" },
    { type: "paragraph",html: "Manche Firmen stellen Ihnen ein Konto aus, das sich in NinjaTrader verbinden kann, aber nur, wenn es über Rithmic statt Tradovate eingerichtet ist. In dieser Konstellation sind die Tradovate-Version des Kontos und die NinjaTrader-(Rithmic-)Version getrennte Verbindungen, und die Aktivierung der einen kann die andere blockieren. Topstep ist ein bekanntes Beispiel, bei dem sich das Konto zum Zeitpunkt der Erstellung in NinjaTrader über Rithmic verbindet, die Tradovate-basierte Version jedoch nicht. Das variiert je nach Firma und ändert sich im Lauf der Zeit; verstehen Sie es daher als Anlass, die aktuellen Regeln Ihrer Firma zu prüfen, und nicht als feste Regel." },
    { type: "heading",text: "3. Ihr NinjaTrader-Dashboard-Konto oder Build ist veraltet" },
    { type: "paragraph",html: "Wenn Sie versuchen, ein privates Tradovate-Konto (kein Prop-Konto) zu verbinden und es dennoch abgewiesen wird, liegt die Ursache oft auf der NinjaTrader-Seite. Der Login ist möglicherweise nicht mit einem NinjaTrader-Dashboard-Konto mit importierter passender Lizenz verknüpft, Sie nutzen einen alten Build, oder der Multi-Provider-Modus ist nicht aktiviert. In diesem Fall ist das Konto berechtigt, aber das lokale Setup wurde noch nicht darauf vorbereitet, es zu akzeptieren." },
    { type: "heading",text: "Hören Sie auf, es erneut zu versuchen, bevor Sie gesperrt werden" },
    { type: "paragraph",html: "Hier ist der Teil, den viele überspringen und der am meisten schmerzt. Die Meldung zum gesperrten Client verschwindet nicht, wenn Sie das Passwort erneut eingeben, denn Ihr Passwort war nie das Problem. Was die erneute Eingabe tatsächlich bewirkt, ist, dass Fehlversuche anwachsen. Nach genügend davon reagiert die Sicherheitsschicht von NinjaTrader für eine festgelegte Abkühlzeit nicht mehr auf Logins, und die Zeile „too many login attempts“ erscheint. Machen Sie weiter, können Sie bei jedem Versuch die Abkühluhr zurücksetzen, sodass Sie länger gesperrt bleiben, als wenn Sie einfach aufgehört hätten." },
    { type: "paragraph",html: "Die Abkühlzeit ist zeitbasiert und endet in der Regel nach etwa einer Stunde, wobei sich der genaue Wert zwischen Releases ändern kann; bestätigen Sie ihn daher in Ihrer Version. Neuere Builds bieten eine reCaptcha-Abfrage, mit der Sie die Drosselung durch Lösen einer Aufgabe statt durch Abwarten des vollen Zeitfensters aufheben können. So oder so ist der Schritt derselbe: Sobald Sie „Client App Prohibited“ sehen, hören Sie auf." },
    { type: "heading",text: "So beheben Sie es: Schritt für Schritt" },
    {
      type: "steps",
      items: [
        { title: "Anhalten und den Kontotyp bestätigen", html: "Schließen Sie den Verbindungsdialog. Bevor Sie den Login erneut anfassen, beantworten Sie eine Frage: Ist das ein Prop-Firm- oder Evaluierungskonto oder ein privates Tradovate-Konto, das Sie selbst eröffnet haben? Prop- und Evaluierungskonten sind diejenigen, die am ehesten auf die eigenen Apps von Tradovate beschränkt sind. Handelt es sich um ein Firmenkonto, bestätigen Sie beim Support oder Dashboard Ihrer Firma, für welche Plattform und welchen Verbindungstyp es lizenziert ist. Ist es privat, gehen Sie im vierten Schritt zur NinjaTrader-seitigen Einrichtung über." },
        { title: "Prüfen, ob Sie den richtigen Login verwenden", html: "Stellen Sie sicher, dass Benutzername und Passwort zu genau dem Konto gehören, mit dem Sie handeln möchten. Ein von der Firma ausgestellter Tradovate-Login ist von einem NinjaTrader-Dashboard-Login getrennt, und eine Verwechslung führt zum selben Fehler. Verbindet Ihre Firma in NinjaTrader über Rithmic, verwenden Sie dort die Rithmic-Zugangsdaten und den passenden Verbindungstyp und behalten Sie den Tradovate-Login für die Plattformen von Tradovate." },
        { title: "Dem NinjaTrader-Support mit Ihrem Benutzernamen schreiben", html: "Das ist der Schritt, der eine echte Sperre des Clients tatsächlich löst. Schreiben Sie an <strong class='text-white'>support@ninjatrader.com</strong> und geben Sie den genauen Benutzernamen an, mit dem Sie sich bei der NinjaTrader-Plattform anmelden, zusammen mit einem kurzen Hinweis, dass Sie beim Verbinden eines Tradovate-Kontos den Fehler „Client App Prohibited“ erhalten. Mit diesem Benutzernamen kann das Team auf seiner Seite prüfen, ob das Konto berechtigt ist. Damit es das vollständige Bild hat, hängen Sie Ihre Log- und Trace-Dateien an: Öffnen Sie in NinjaTrader <strong class='text-white'>Control Center &rsaquo; Help &rsaquo; Email Support</strong> und wählen Sie <strong class='text-white'>Platform Technical Support</strong> als Empfänger. Bestätigen Sie die genauen Menübezeichnungen in Ihrem Build, da sie sich zwischen Versionen verschieben." },
        { title: "Bei einem privaten Tradovate-Konto die NinjaTrader-Seite korrigieren", html: "Bereiten Sie bei einem berechtigten privaten Konto, das sich weiterhin nicht verbindet, das lokale Setup vor. Stellen Sie sicher, dass Sie ein NinjaTrader-Dashboard-Konto mit importiertem Lizenzschlüssel haben, aktualisieren Sie NinjaTrader auf einen aktuellen Build und aktivieren Sie den Multi-Provider-Modus, damit neben Ihrem NinjaTrader-Login eine Tradovate-Verbindung bestehen kann. Sobald die Dashboard-Seite in Ordnung ist, fügen Sie die Tradovate-Verbindung mit den richtigen Zugangsdaten erneut hinzu. Verbindet sie sich sauber, sind Sie fertig. Gibt sie weiterhin die Meldung zum gesperrten Client zurück, ist das Konto nicht für NinjaTrader berechtigt, und der vorherige Schritt ist Ihr Weg." },
        { title: "Nicht in einer Schleife erneut versuchen, während Sie warten", html: "Haben Sie unterwegs die „too many login attempts“-Drosselung ausgelöst, lassen Sie sie ablaufen. Warten Sie die Abkühlzeit ab oder beantworten Sie das reCaptcha, falls Ihr Build eines anbietet, und widerstehen Sie dem Drang, den Login alle paar Minuten zu testen. Ein sauberer Versuch nach der Wartezeit sagt Ihnen mehr als zehn frustrierte." },
      ],
    },
    { type: "heading",text: "Tabelle zur Fehlerbehebung" },
    { type: "table", headers: ["Was Sie sehen","Was es bedeutet","Was zu tun ist"], rows: [
      ["Client App is Prohibited / client app prohibited logon failed","Der Login ist nicht berechtigt, sich über NinjaTrader zu verbinden","Nicht erneut versuchen; Berechtigung des Kontos prüfen, dann support@ninjatrader.com mit Ihrem Benutzernamen anschreiben"],
      ["Meldung zum gesperrten Client bei einem Prop-/Evaluierungskonto","Das Konto ist wahrscheinlich für die eigenen Apps von Tradovate lizenziert, nicht für NinjaTrader","Aktuelle Plattformregeln Ihrer Firma prüfen; den Verbindungstyp (z. B. Rithmic) verwenden, den Ihre Firma in NinjaTrader unterstützt"],
      ["„Too many login attempts“ erscheint nach Wiederholungen","Eine zeitbasierte Sicherheitsabkühlung nach wiederholten Fehlschlägen","Aufhören, abwarten (etwa eine Stunde) oder das reCaptcha beantworten, falls Ihr Build eines anzeigt"],
      ["Meldung zum gesperrten Client bei einem privaten Tradovate-Konto","Dashboard-Konto, Lizenz, Build oder Multi-Provider-Modus nicht eingerichtet","Lizenz importieren, NinjaTrader aktualisieren, Multi-Provider-Modus aktivieren, neu verbinden"],
      ["Verbindet sich in der Tradovate-App, aber nicht in NinjaTrader","Der Kontopfad ist nur für Tradovate, nicht für NinjaTrader freigegeben","Auf der Plattform von Tradovate handeln oder über eine direkte Tradovate-Brücke automatisieren"],
    ] },
    { type: "heading",text: "Wenn sich Ihr Konto einfach nicht mit NinjaTrader verbinden lässt" },
    { type: "paragraph",html: "Manchmal lautet die ehrliche Antwort, dass das Konto nie für den Betrieb in NinjaTrader gedacht war. Der Support bestätigt es, Ihre Firma bestätigt es, und kein Setup ändert das. Das heißt nicht, dass Sie manuell handeln müssen. Ihr Tradovate-basiertes Konto funktioniert auf den eigenen Plattformen von Tradovate einwandfrei und kann weiterhin automatisiert werden." },
    { type: "paragraph",html: "Hier löst das Routing Ihrer Strategie über PickMyTrade das gesamte Problem aus einem anderen Blickwinkel. Statt mit NinjaTrader um die Annahme eines Logins zu kämpfen, den es nicht akzeptiert, verbindet sich PickMyTrade direkt mit Tradovate und verwandelt Ihre TradingView-Alerts in Live-Orders auf diesem Konto:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Direkte Tradovate-Verbindung</strong>, sodass Sie nicht davon abhängen, dass NinjaTrader das Konto autorisiert.",
        "<strong class='text-white'>TradingView-Alerts zu Live-Orders</strong>, sodass eine Strategie oder ein Indikator Einstiege, Stopps und Ziele auf Ihrem Tradovate-Konto automatisch auslösen kann.",
        "<strong class='text-white'>Eine verwaltete Sitzung</strong>, die sich einmal verbindet und gehalten wird, statt sich wiederholt anzumelden und eine Sperre zu provozieren.",
        "<strong class='text-white'>Multi-Account-Unterstützung</strong>, sodass Sie dieselben Orders von einem Ort aus auf mehrere Tradovate-Konten spiegeln können.",
      ],
    },
    { type: "paragraph",html: "Wenn Ihr Ziel die Automatisierung war und NinjaTrader nur das Mittel, bringt Sie dies ohne die Mauer des gesperrten Clients dorthin." },
  ], es: [
    { type: "paragraph",html: "Escribe sus credenciales de Tradovate en NinjaTrader, pulsa conectar y, en lugar de una cuenta en vivo, obtiene un mensaje seco: <strong class='text-white'>Client App is Prohibited</strong>. Si lo intenta de nuevo, a menudo se convierte en “client app prohibited logon failed” seguido de “too many login attempts”. Primero, la versión corta: deje de reintentar. Esto no es un fallo de contraseña incorrecta que se pueda forzar. Es un bloqueo de permisos, y cada intento adicional le hunde más en un bloqueo de inicio de sesión en lugar de conectarle. La solución es confirmar si su cuenta tiene siquiera permiso para conectarse a través de NinjaTrader y luego escribir al soporte de NinjaTrader con el nombre de usuario exacto que usa para que verifiquen la autorización. Esta guía explica qué significa realmente el error en 2026, por qué NinjaTrader lo muestra y todas las vías para volver a una cuenta que funcione." },
    { type: "quote",html: "<strong class='text-white'>Respuesta rápida:</strong> “Client App Prohibited” significa que el inicio de sesión que introdujo no está autorizado para conectarse a través de NinjaTrader, normalmente porque es una cuenta prop o de evaluación basada en Tradovate que funciona en las propias apps de Tradovate y no dentro de NinjaTrader. Deje de reintentar para no provocar un bloqueo y luego escriba a <strong class='text-white'>support@ninjatrader.com</strong> con el nombre de usuario con el que inicia sesión en NinjaTrader para que verifiquen si la cuenta es elegible." },
    {
      type: "checklist",
      heading: "Lista de verificación rápida",
      items: [
        "<strong class='text-white'>Deje de reintentar de inmediato.</strong> El mensaje de cliente prohibido escala a un bloqueo “too many login attempts”, y cada nuevo intento puede reiniciar el temporizador.",
        "<strong class='text-white'>Confirme para qué plataforma tiene licencia su cuenta.</strong> Una cuenta prop o de evaluación basada en Tradovate no está autorizada automáticamente para conectarse a través de NinjaTrader.",
        "<strong class='text-white'>Compruebe que usa el inicio de sesión correcto.</strong> El usuario de la cuenta de Tradovate de su firma no es lo mismo que un inicio de sesión del Dashboard de NinjaTrader.",
        "<strong class='text-white'>Escriba al soporte de NinjaTrader con su usuario.</strong> Envíelo a support@ninjatrader.com para que verifiquen la autorización de la cuenta.",
        "<strong class='text-white'>Adjunte archivos de registro y traza</strong> desde Control Center, Help, Email Support, eligiendo Platform Technical Support, para que el equipo vea el fallo exacto.",
        "<strong class='text-white'>Si no necesita NinjaTrader,</strong> automatice la misma cuenta de Tradovate mediante un puente que se conecte directamente a Tradovate.",
      ],
    },
    { type: "heading",text: "Qué significa realmente “Client App Prohibited”" },
    { type: "paragraph",html: "La mayoría de los errores de inicio de sesión tienen que ver con las credenciales: contraseña incorrecta, token caducado, dispositivo no aprobado. Este es distinto. “Client App Prohibited” es un bloqueo de autorización. Es NinjaTrader (la app cliente) al que se le indica que el inicio de sesión que usted proporcionó no tiene permiso para abrir una sesión a través de él. Las credenciales pueden ser perfectamente correctas. El problema es que la cuenta que hay detrás no está autorizada para funcionar dentro de NinjaTrader." },
    { type: "paragraph",html: "Por eso importa la redacción. En el intento de conexión verá a menudo la frase “client app prohibited logon failed” y, tras varios intentos seguidos, se suma una segunda línea: “too many login attempts”. La primera línea es el bloqueo de permisos. La segunda es la limitación de seguridad que se activa cuando sigue insistiendo. Parecen un solo problema, pero tienen dos causas distintas, y tratarlas como un único “voy a volver a escribir mi contraseña” es justo lo que convierte una comprobación de cinco minutos en un bloqueo de una hora." },
    { type: "heading",text: "Por qué NinjaTrader bloquea el inicio de sesión de Tradovate" },
    { type: "paragraph",html: "Hay tres motivos comunes por los que aparece el mensaje, y averiguar en cuál está usted decide su siguiente paso." },
    { type: "heading",text: "1. La cuenta no está autorizada para conectarse a través de NinjaTrader" },
    { type: "paragraph",html: "Este es el principal. Muchas cuentas basadas en Tradovate, especialmente las de evaluación y financiadas de firmas prop, están aprovisionadas para funcionar en las plataformas web, de escritorio y móviles propias de Tradovate. No tienen licencia automática para enrutar a través de NinjaTrader. Cuando introduce uno de esos inicios de sesión en NinjaTrader, la conexión se rechaza como cliente prohibido porque la cuenta nunca fue autorizada para ese camino. El usuario es válido; simplemente no es válido <em>aquí</em>." },
    { type: "heading",text: "2. Su firma se conecta mediante Rithmic, no Tradovate, dentro de NinjaTrader" },
    { type: "paragraph",html: "Algunas firmas le entregan una cuenta que puede conectarse en NinjaTrader, pero solo cuando está configurada en Rithmic en lugar de Tradovate. En ese caso, la versión de Tradovate de la cuenta y la versión de NinjaTrader (Rithmic) son conexiones separadas, y activar una puede bloquear la otra. Topstep es un ejemplo conocido en el que, en el momento de redactar esto, la cuenta se conecta en NinjaTrader mediante Rithmic mientras que la versión basada en Tradovate no. Esto varía según la firma y cambia con el tiempo, así que tómelo como un aviso para comprobar las reglas actuales de su firma y no como una regla fija." },
    { type: "heading",text: "3. Su cuenta del Dashboard de NinjaTrader o su versión está desactualizada" },
    { type: "paragraph",html: "Si intenta conectar una cuenta personal de Tradovate (no una cuenta prop) y sigue rebotando, la causa suele estar del lado de NinjaTrader. Es posible que el inicio de sesión no esté vinculado a una cuenta del Dashboard de NinjaTrader con la licencia correcta importada, que use una versión antigua o que el modo Multi-Provider no esté activado. En ese caso, la cuenta es elegible, pero la configuración local aún no está preparada para aceptarla." },
    { type: "heading",text: "Deje de reintentar antes de que le bloqueen" },
    { type: "paragraph",html: "Aquí está la parte que la gente se salta y la que más duele. El mensaje de cliente prohibido no se arregla solo al volver a introducir la contraseña, porque su contraseña nunca fue el problema. Lo que sí hace volver a introducirla es acumular intentos fallidos. Tras suficientes, la capa de seguridad de NinjaTrader deja de responder a los inicios de sesión durante un enfriamiento determinado y aparece la línea “too many login attempts”. Si sigue, puede reiniciar ese reloj de enfriamiento en cada intento, lo que significa que permanece bloqueado más tiempo que si simplemente hubiera parado." },
    { type: "paragraph",html: "El enfriamiento se basa en el tiempo y suele desaparecer tras aproximadamente una hora, aunque la cifra exacta puede variar entre versiones, así que confírmela en la suya. Las versiones más recientes añaden una solicitud de reCaptcha para que pueda eliminar la limitación resolviendo un puzzle en lugar de esperar toda la ventana. En cualquier caso, la acción es la misma: en cuanto vea “Client App Prohibited”, pare." },
    { type: "heading",text: "Cómo solucionarlo: paso a paso" },
    {
      type: "steps",
      items: [
        { title: "Deténgase y confirme el tipo de cuenta", html: "Cierre el cuadro de diálogo de conexión. Antes de tocar de nuevo el inicio de sesión, responda a una pregunta: ¿es una cuenta de firma prop o de evaluación, o una cuenta personal de Tradovate que abrió usted mismo? Las cuentas prop y de evaluación son las que con más probabilidad están limitadas a las propias apps de Tradovate. Si es una cuenta de firma, el soporte o el panel de su firma es donde confirma para qué plataforma y tipo de conexión tiene licencia. Si es personal, pase a la configuración del lado de NinjaTrader en el cuarto paso." },
        { title: "Verifique que usa el inicio de sesión correcto", html: "Asegúrese de que el usuario y la contraseña que introduce son los de la cuenta exacta con la que quiere operar. Un inicio de sesión de Tradovate emitido por una firma es independiente de un inicio de sesión del Dashboard de NinjaTrader, y confundirlos produce el mismo fallo. Si su firma se conecta mediante Rithmic en NinjaTrader, use allí las credenciales y el tipo de conexión de Rithmic, y reserve el inicio de sesión de Tradovate para las plataformas de Tradovate." },
        { title: "Escriba al soporte de NinjaTrader con su usuario", html: "Este es el paso que realmente resuelve un bloqueo genuino de cliente prohibido. Escriba a <strong class='text-white'>support@ninjatrader.com</strong> e incluya el nombre de usuario exacto con el que inicia sesión en la plataforma NinjaTrader, junto con una breve nota indicando que recibe un error “Client App Prohibited” al intentar conectar una cuenta de Tradovate. Ese usuario permite al equipo comprobar si la cuenta está autorizada por su parte. Para darles la imagen completa, adjunte sus archivos de registro y traza: en NinjaTrader, abra <strong class='text-white'>Control Center &rsaquo; Help &rsaquo; Email Support</strong> y seleccione <strong class='text-white'>Platform Technical Support</strong> como destinatario. Confirme las etiquetas exactas del menú en su versión, ya que cambian entre versiones." },
        { title: "Si es una cuenta personal de Tradovate, corrija el lado de NinjaTrader", html: "Para una cuenta personal elegible que sigue sin conectarse, prepare la configuración local. Asegúrese de tener una cuenta del Dashboard de NinjaTrader con su clave de licencia importada, actualice NinjaTrader a una versión actual y active el modo Multi-Provider para que pueda mantener una conexión de Tradovate junto con su inicio de sesión de NinjaTrader. Una vez en orden el lado del Dashboard, añada de nuevo la conexión de Tradovate con las credenciales correctas. Si se conecta sin problemas, ha terminado. Si sigue devolviendo el mensaje de cliente prohibido, la cuenta no está autorizada para NinjaTrader y el paso anterior es su camino." },
        { title: "No reintente en bucle mientras espera", html: "Si activó la limitación “too many login attempts” por el camino, déjela despejarse. Espere el enfriamiento o responda al reCaptcha si su versión lo ofrece, y resista la tentación de probar el inicio de sesión cada pocos minutos. Un intento limpio tras la espera le dice más que diez frustrados." },
      ],
    },
    { type: "heading",text: "Tabla de resolución de problemas" },
    { type: "table", headers: ["Lo que ve","Qué significa","Qué hacer"], rows: [
      ["Client App is Prohibited / client app prohibited logon failed","El inicio de sesión no está autorizado para conectarse a través de NinjaTrader","Deje de reintentar; confirme que la cuenta es elegible y escriba a support@ninjatrader.com con su usuario"],
      ["Mensaje de cliente prohibido en una cuenta prop / de evaluación","Es probable que la cuenta tenga licencia para las propias apps de Tradovate, no para NinjaTrader","Compruebe las reglas de plataforma actuales de su firma; use el tipo de conexión (p. ej., Rithmic) que su firma admite en NinjaTrader"],
      ["“Too many login attempts” aparece tras los reintentos","Un enfriamiento de seguridad basado en el tiempo por fallos repetidos","Deje de intentarlo, espere (aproximadamente una hora) o responda al reCaptcha si su versión lo muestra"],
      ["Mensaje de cliente prohibido en una cuenta personal de Tradovate","Cuenta del Dashboard, licencia, versión o modo Multi-Provider sin configurar","Importe su licencia, actualice NinjaTrader, active el modo Multi-Provider y vuelva a conectar"],
      ["Se conecta en la app de Tradovate pero no en NinjaTrader","La cuenta solo funciona con Tradovate, no está autorizada para NinjaTrader","Opérela en la plataforma de Tradovate o automatícela mediante un puente directo a Tradovate"],
    ] },
    { type: "heading",text: "Si su cuenta simplemente no se conecta a NinjaTrader" },
    { type: "paragraph",html: "A veces la respuesta honesta es que la cuenta nunca estuvo pensada para funcionar en NinjaTrader. El soporte lo confirma, su firma lo confirma y ninguna configuración lo cambia. Eso no significa que esté atascado operando a mano. Su cuenta basada en Tradovate sigue funcionando bien en las propias plataformas de Tradovate y aún puede automatizarse." },
    { type: "paragraph",html: "Aquí es donde enrutar su estrategia a través de PickMyTrade resuelve todo el problema desde otro ángulo. En lugar de pelear con NinjaTrader para que acepte un inicio de sesión que no admite, PickMyTrade se conecta directamente a Tradovate y convierte sus alertas de TradingView en órdenes reales en esa cuenta:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Conexión directa con Tradovate</strong>, para que no dependa de que NinjaTrader autorice la cuenta.",
        "<strong class='text-white'>Alertas de TradingView a órdenes reales</strong>, para que una estrategia o un indicador pueda lanzar entradas, stops y objetivos en su cuenta de Tradovate automáticamente.",
        "<strong class='text-white'>Una sesión gestionada</strong> que se conecta una vez y se mantiene, en lugar de iniciar sesión repetidamente y provocar un bloqueo.",
        "<strong class='text-white'>Compatibilidad multicuenta</strong>, para que pueda replicar las mismas órdenes en varias cuentas de Tradovate desde un solo lugar.",
      ],
    },
    { type: "paragraph",html: "Si su objetivo era la automatización y NinjaTrader era solo el vehículo, esto le lleva allí sin el muro del cliente prohibido." },
  ], fr: [
    { type: "paragraph",html: "Vous saisissez vos identifiants Tradovate dans NinjaTrader, cliquez sur connecter et, au lieu d'un compte en direct, vous obtenez un message sec : <strong class='text-white'>Client App is Prohibited</strong>. Si vous réessayez, cela devient souvent « client app prohibited logon failed » suivi de « too many login attempts ». Voici d'abord la version courte : cessez de réessayer. Ce n'est pas un problème de mauvais mot de passe que l'on peut forcer. C'est un blocage de permissions, et chaque tentative supplémentaire vous enfonce dans un verrouillage de connexion au lieu de vous connecter. La solution consiste à vérifier si votre compte a seulement le droit de se connecter via NinjaTrader, puis à écrire au support NinjaTrader avec l'identifiant exact que vous utilisez afin qu'il vérifie l'autorisation. Ce guide explique ce que l'erreur signifie vraiment en 2026, pourquoi NinjaTrader la renvoie et toutes les voies pour retrouver un compte fonctionnel." },
    { type: "quote",html: "<strong class='text-white'>Réponse rapide :</strong> « Client App Prohibited » signifie que la connexion saisie n'est pas autorisée à se connecter via NinjaTrader, généralement parce qu'il s'agit d'un compte prop ou d'évaluation basé sur Tradovate qui fonctionne sur les applications propres à Tradovate plutôt que dans NinjaTrader. Cessez de réessayer pour ne pas déclencher un verrouillage, puis écrivez à <strong class='text-white'>support@ninjatrader.com</strong> avec l'identifiant que vous utilisez pour vous connecter à NinjaTrader et laissez-les vérifier si le compte est éligible." },
    {
      type: "checklist",
      heading: "Liste de vérification rapide",
      items: [
        "<strong class='text-white'>Cessez immédiatement de réessayer.</strong> Le message de client interdit dégénère en verrouillage « too many login attempts », et chaque nouvelle tentative peut réinitialiser le minuteur.",
        "<strong class='text-white'>Confirmez pour quelle plateforme votre compte est licencié.</strong> Un compte prop ou d'évaluation basé sur Tradovate n'est pas automatiquement autorisé à se connecter via NinjaTrader.",
        "<strong class='text-white'>Vérifiez que vous utilisez la bonne connexion.</strong> L'identifiant du compte Tradovate de votre société n'est pas le même qu'une connexion NinjaTrader Dashboard.",
        "<strong class='text-white'>Écrivez au support NinjaTrader avec votre identifiant.</strong> Envoyez-le à support@ninjatrader.com afin qu'ils vérifient l'autorisation du compte.",
        "<strong class='text-white'>Joignez les fichiers de journal et de trace</strong> depuis Control Center, Help, Email Support, en choisissant Platform Technical Support, pour que l'équipe voie l'échec exact.",
        "<strong class='text-white'>Si NinjaTrader n'est pas indispensable,</strong> automatisez le même compte Tradovate via un pont qui se connecte directement à Tradovate.",
      ],
    },
    { type: "heading",text: "Ce que « Client App Prohibited » signifie réellement" },
    { type: "paragraph",html: "La plupart des erreurs de connexion concernent les identifiants : mauvais mot de passe, jeton expiré, appareil non approuvé. Celle-ci est différente. « Client App Prohibited » est un blocage d'autorisation. C'est NinjaTrader (l'application cliente) à qui l'on indique que la connexion fournie n'est pas autorisée à ouvrir une session par son intermédiaire. Les identifiants eux-mêmes peuvent être parfaitement corrects. Le problème est que le compte qui se trouve derrière n'est pas autorisé à fonctionner dans NinjaTrader." },
    { type: "paragraph",html: "C'est pourquoi la formulation compte. Lors de la tentative de connexion, vous verrez souvent la phrase « client app prohibited logon failed », et après quelques essais d'affilée, une seconde ligne s'y ajoute : « too many login attempts ». La première ligne est le blocage de permissions. La seconde est la limitation de sécurité qui s'enclenche lorsque vous insistez. Elles ressemblent à un seul problème, mais elles ont deux causes différentes, et les traiter comme un simple « je vais juste ressaisir mon mot de passe » est précisément ce qui transforme une vérification de cinq minutes en verrouillage d'une heure." },
    { type: "heading",text: "Pourquoi NinjaTrader bloque la connexion Tradovate" },
    { type: "paragraph",html: "Il existe trois raisons courantes pour lesquelles ce message apparaît, et déterminer laquelle vous concerne décide de votre prochaine action." },
    { type: "heading",text: "1. Le compte n'est pas autorisé à se connecter via NinjaTrader" },
    { type: "paragraph",html: "C'est la principale. De nombreux comptes basés sur Tradovate, en particulier les comptes d'évaluation et financés de sociétés de prop trading, sont provisionnés pour fonctionner sur les plateformes web, de bureau et mobiles propres à Tradovate. Ils ne sont pas automatiquement licenciés pour passer par NinjaTrader. Lorsque vous saisissez l'une de ces connexions dans NinjaTrader, la connexion est rejetée comme client interdit parce que le compte n'a jamais été autorisé pour ce chemin. L'identifiant est valide ; il n'est simplement pas valide <em>ici</em>." },
    { type: "heading",text: "2. Votre société se connecte via Rithmic, et non Tradovate, dans NinjaTrader" },
    { type: "paragraph",html: "Certaines sociétés vous remettent un compte qui peut se connecter dans NinjaTrader, mais uniquement lorsqu'il est configuré sur Rithmic plutôt que sur Tradovate. Dans ce cas, la version Tradovate du compte et la version NinjaTrader (Rithmic) sont des connexions distinctes, et l'activation de l'une peut bloquer l'autre. Topstep est un exemple bien connu où, au moment de la rédaction, le compte se connecte dans NinjaTrader via Rithmic alors que la version basée sur Tradovate ne le fait pas. Cela varie selon la société et évolue avec le temps ; considérez-le donc comme une invitation à vérifier les règles actuelles de votre société plutôt que comme une règle figée." },
    { type: "heading",text: "3. Votre compte NinjaTrader Dashboard ou votre version est obsolète" },
    { type: "paragraph",html: "Si vous essayez de connecter un compte Tradovate personnel (et non un compte prop) et qu'il est toujours rejeté, la cause se situe souvent côté NinjaTrader. La connexion n'est peut-être pas liée à un compte NinjaTrader Dashboard avec la bonne licence importée, vous utilisez peut-être une ancienne version, ou le mode Multi-Provider n'est pas activé. Dans ce cas, le compte est éligible, mais la configuration locale n'a pas encore été préparée pour l'accepter." },
    { type: "heading",text: "Cessez de réessayer avant d'être verrouillé" },
    { type: "paragraph",html: "Voici la partie que beaucoup sautent et qui fait le plus mal. Le message de client interdit ne se corrige pas en ressaisissant le mot de passe, car votre mot de passe n'a jamais été le problème. Ce que la ressaisie fait, en revanche, c'est accumuler des tentatives échouées. Au bout d'un certain nombre, la couche de sécurité de NinjaTrader cesse de répondre aux connexions pendant un temps de refroidissement donné, et la ligne « too many login attempts » apparaît. Si vous continuez, vous pouvez réinitialiser ce minuteur à chaque essai, ce qui signifie que vous restez verrouillé plus longtemps que si vous vous étiez simplement arrêté." },
    { type: "paragraph",html: "Le refroidissement est temporel et se lève généralement après environ une heure, même si le chiffre exact peut varier d'une version à l'autre ; confirmez-le donc dans votre version. Les versions récentes ajoutent une invite reCaptcha pour que vous puissiez lever la limitation en résolvant un puzzle plutôt qu'en attendant toute la durée. Dans les deux cas, le geste est le même : dès que vous voyez « Client App Prohibited », arrêtez-vous." },
    { type: "heading",text: "Comment le corriger : étape par étape" },
    {
      type: "steps",
      items: [
        { title: "Arrêtez-vous et confirmez le type de compte", html: "Fermez la boîte de dialogue de connexion. Avant de toucher de nouveau à la connexion, répondez à une question : s'agit-il d'un compte de société de prop trading ou d'évaluation, ou d'un compte Tradovate personnel que vous avez ouvert vous-même ? Les comptes prop et d'évaluation sont ceux qui risquent le plus d'être limités aux applications propres à Tradovate. S'il s'agit d'un compte de société, le support ou le tableau de bord de votre société est l'endroit où confirmer pour quelle plateforme et quel type de connexion il est licencié. S'il est personnel, passez à la configuration côté NinjaTrader à la quatrième étape." },
        { title: "Vérifiez que vous utilisez la bonne connexion", html: "Assurez-vous que l'identifiant et le mot de passe que vous saisissez sont ceux du compte exact avec lequel vous souhaitez trader. Une connexion Tradovate fournie par une société est distincte d'une connexion NinjaTrader Dashboard, et les confondre produit le même échec. Si votre société se connecte via Rithmic dans NinjaTrader, utilisez-y les identifiants et le type de connexion Rithmic, et réservez la connexion Tradovate aux plateformes de Tradovate." },
        { title: "Écrivez au support NinjaTrader avec votre identifiant", html: "C'est l'étape qui résout réellement un véritable blocage de client interdit. Écrivez à <strong class='text-white'>support@ninjatrader.com</strong> en indiquant l'identifiant exact avec lequel vous vous connectez à la plateforme NinjaTrader, avec une courte note précisant que vous obtenez une erreur « Client App Prohibited » en essayant de connecter un compte Tradovate. Cet identifiant permet à l'équipe de vérifier si le compte est autorisé de son côté. Pour lui donner la vue d'ensemble, joignez vos fichiers de journal et de trace : dans NinjaTrader, ouvrez <strong class='text-white'>Control Center &rsaquo; Help &rsaquo; Email Support</strong> et sélectionnez <strong class='text-white'>Platform Technical Support</strong> comme destinataire. Vérifiez les libellés exacts des menus dans votre version, car ils changent d'une version à l'autre." },
        { title: "S'il s'agit d'un compte Tradovate personnel, corrigez le côté NinjaTrader", html: "Pour un compte personnel éligible qui ne se connecte toujours pas, préparez la configuration locale. Assurez-vous d'avoir un compte NinjaTrader Dashboard avec votre clé de licence importée, mettez à jour NinjaTrader vers une version actuelle et activez le mode Multi-Provider afin qu'il puisse maintenir une connexion Tradovate à côté de votre connexion NinjaTrader. Une fois le côté Dashboard en ordre, ajoutez de nouveau la connexion Tradovate avec les bons identifiants. Si elle se connecte proprement, c'est terminé. Si elle renvoie toujours le message de client interdit, le compte n'est pas autorisé pour NinjaTrader et l'étape précédente est votre voie." },
        { title: "Ne réessayez pas en boucle pendant l'attente", html: "Si vous avez déclenché la limitation « too many login attempts » en cours de route, laissez-la se dissiper. Attendez le refroidissement ou répondez au reCaptcha si votre version en propose un, et résistez à la tentation de tester la connexion toutes les quelques minutes. Un essai propre après l'attente vous en apprend plus que dix essais frustrés." },
      ],
    },
    { type: "heading",text: "Tableau de dépannage" },
    { type: "table", headers: ["Ce que vous voyez","Ce que cela signifie","Que faire"], rows: [
      ["Client App is Prohibited / client app prohibited logon failed","La connexion n'est pas autorisée à se connecter via NinjaTrader","Cessez de réessayer ; confirmez que le compte est éligible, puis écrivez à support@ninjatrader.com avec votre identifiant"],
      ["Message de client interdit sur un compte prop / d'évaluation","Le compte est probablement licencié pour les applications propres à Tradovate, pas pour NinjaTrader","Vérifiez les règles de plateforme actuelles de votre société ; utilisez le type de connexion (p. ex. Rithmic) pris en charge par votre société dans NinjaTrader"],
      ["« Too many login attempts » apparaît après des réessais","Un refroidissement de sécurité temporel dû à des échecs répétés","Cessez d'essayer, patientez (environ une heure) ou répondez au reCaptcha si votre version en affiche un"],
      ["Message de client interdit sur un compte Tradovate personnel","Compte Dashboard, licence, version ou mode Multi-Provider non configuré","Importez votre licence, mettez à jour NinjaTrader, activez le mode Multi-Provider, reconnectez-vous"],
      ["Se connecte dans l'application Tradovate mais pas dans NinjaTrader","Le compte ne fonctionne que sur Tradovate, sans autorisation NinjaTrader","Tradez-le sur la plateforme Tradovate ou automatisez-le via un pont direct vers Tradovate"],
    ] },
    { type: "heading",text: "Si votre compte refuse simplement de se connecter à NinjaTrader" },
    { type: "paragraph",html: "Parfois, la réponse honnête est que le compte n'a jamais été prévu pour fonctionner dans NinjaTrader. Le support le confirme, votre société le confirme, et aucune configuration n'y change rien. Cela ne signifie pas que vous êtes condamné à trader à la main. Votre compte basé sur Tradovate fonctionne très bien sur les plateformes propres à Tradovate et peut toujours être automatisé." },
    { type: "paragraph",html: "C'est là que faire passer votre stratégie par PickMyTrade résout tout le problème sous un autre angle. Au lieu de vous battre pour que NinjaTrader accepte une connexion qu'il refuse, PickMyTrade se connecte directement à Tradovate et transforme vos alertes TradingView en ordres réels sur ce compte :" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Connexion directe à Tradovate</strong> pour ne pas dépendre de l'autorisation du compte par NinjaTrader.",
        "<strong class='text-white'>Des alertes TradingView aux ordres réels</strong> pour qu'une stratégie ou un indicateur puisse déclencher automatiquement entrées, stops et objectifs sur votre compte Tradovate.",
        "<strong class='text-white'>Une session gérée</strong> qui se connecte une fois et tient, plutôt que de se reconnecter à répétition et de provoquer un verrouillage.",
        "<strong class='text-white'>Prise en charge multi-comptes</strong> pour reproduire les mêmes ordres sur plusieurs comptes Tradovate depuis un seul endroit.",
      ],
    },
    { type: "paragraph",html: "Si votre objectif était l'automatisation et que NinjaTrader n'était que le véhicule, cela vous y mène sans le mur du client interdit." },
  ], it: [
    { type: "paragraph",html: "Digita le sue credenziali Tradovate in NinjaTrader, preme connetti e, invece di un account live, riceve un messaggio secco: <strong class='text-white'>Client App is Prohibited</strong>. Se riprova, spesso diventa “client app prohibited logon failed” seguito da “too many login attempts”. Prima di tutto la versione breve: smetta di riprovare. Non è un problema di password errata che si possa forzare. È un blocco di autorizzazioni, e ogni tentativo aggiuntivo la trascina più a fondo in un blocco del login invece di collegarla. La soluzione è verificare se il suo account ha anche solo il permesso di collegarsi tramite NinjaTrader, poi scrivere al supporto NinjaTrader con il nome utente esatto che sta usando, affinché controllino l'autorizzazione. Questa guida spiega cosa significa davvero l'errore nel 2026, perché NinjaTrader lo mostra e tutte le strade per tornare a un account funzionante." },
    { type: "quote",html: "<strong class='text-white'>Risposta rapida:</strong> “Client App Prohibited” significa che il login inserito non è autorizzato a collegarsi tramite NinjaTrader, di solito perché è un account prop o di valutazione basato su Tradovate che funziona sulle app di Tradovate e non all'interno di NinjaTrader. Smetta di riprovare per non innescare un blocco, poi scriva a <strong class='text-white'>support@ninjatrader.com</strong> con il nome utente che usa per accedere a NinjaTrader e faccia verificare se l'account è idoneo." },
    {
      type: "checklist",
      heading: "Checklist rapida",
      items: [
        "<strong class='text-white'>Smetta subito di riprovare.</strong> Il messaggio di client vietato degenera in un blocco “too many login attempts”, e ogni nuovo tentativo può azzerare il timer.",
        "<strong class='text-white'>Confermi per quale piattaforma è abilitato il suo account.</strong> Un account prop o di valutazione basato su Tradovate non è automaticamente abilitato al collegamento tramite NinjaTrader.",
        "<strong class='text-white'>Verifichi di usare il login giusto.</strong> Il nome utente dell'account Tradovate della sua società non coincide con un login del NinjaTrader Dashboard.",
        "<strong class='text-white'>Scriva al supporto NinjaTrader con il suo nome utente.</strong> Lo invii a support@ninjatrader.com affinché verifichino l'autorizzazione dell'account.",
        "<strong class='text-white'>Alleghi i file di log e trace</strong> da Control Center, Help, Email Support, scegliendo Platform Technical Support, così il team vede l'errore esatto.",
        "<strong class='text-white'>Se NinjaTrader non è necessario,</strong> automatizzi lo stesso account Tradovate tramite un ponte che si collega direttamente a Tradovate.",
      ],
    },
    { type: "heading",text: "Cosa significa davvero “Client App Prohibited”" },
    { type: "paragraph",html: "La maggior parte degli errori di login riguarda le credenziali: password errata, token scaduto, dispositivo non approvato. Questo è diverso. “Client App Prohibited” è un blocco di autorizzazione. È NinjaTrader (l'app client) a cui viene detto che il login fornito non è autorizzato ad aprire una sessione tramite esso. Le credenziali stesse possono essere perfettamente corrette. Il problema è che l'account sottostante non è abilitato a funzionare all'interno di NinjaTrader." },
    { type: "paragraph",html: "Ecco perché la formulazione conta. Al tentativo di connessione vedrà spesso la frase “client app prohibited logon failed” e, dopo alcuni tentativi consecutivi, si aggiunge una seconda riga: “too many login attempts”. La prima riga è il blocco di autorizzazione. La seconda è la limitazione di sicurezza che scatta quando continua a insistere. Sembrano un unico problema, ma hanno due cause diverse, e trattarle come un semplice “reinserisco la password” è esattamente ciò che trasforma un controllo di cinque minuti in un blocco di un'ora." },
    { type: "heading",text: "Perché NinjaTrader blocca il login Tradovate" },
    { type: "paragraph",html: "Ci sono tre motivi comuni per cui compare il messaggio, e capire in quale si trova decide la sua prossima mossa." },
    { type: "heading",text: "1. L'account non è autorizzato a collegarsi tramite NinjaTrader" },
    { type: "paragraph",html: "È il motivo principale. Molti account basati su Tradovate, in particolare gli account di valutazione e finanziati delle prop firm, sono predisposti per funzionare sulle piattaforme web, desktop e mobile di Tradovate. Non sono automaticamente abilitati a instradare tramite NinjaTrader. Quando inserisce uno di questi login in NinjaTrader, la connessione viene rifiutata come client vietato perché l'account non è mai stato abilitato per quel percorso. Il nome utente è valido; semplicemente non è valido <em>qui</em>." },
    { type: "heading",text: "2. La sua società si collega tramite Rithmic, non Tradovate, in NinjaTrader" },
    { type: "paragraph",html: "Alcune società le forniscono un account che può collegarsi in NinjaTrader, ma solo quando è configurato su Rithmic anziché su Tradovate. In questo caso la versione Tradovate dell'account e la versione NinjaTrader (Rithmic) sono connessioni separate, e attivare l'una può bloccare l'altra. Topstep è un esempio noto in cui, al momento della stesura, l'account si collega in NinjaTrader tramite Rithmic mentre la versione basata su Tradovate no. Questo varia a seconda della società e cambia nel tempo, quindi lo consideri uno spunto per verificare le regole attuali della sua società più che una regola fissa." },
    { type: "heading",text: "3. Il suo account NinjaTrader Dashboard o la build sono obsoleti" },
    { type: "paragraph",html: "Se sta cercando di collegare un account Tradovate personale (non un account prop) e viene comunque respinto, la causa è spesso lato NinjaTrader. Il login potrebbe non essere associato a un account NinjaTrader Dashboard con la licenza corretta importata, potrebbe usare una build vecchia, oppure la modalità Multi-Provider non è abilitata. In questo caso l'account è idoneo, ma la configurazione locale non è ancora stata preparata ad accettarlo." },
    { type: "heading",text: "Smetta di riprovare prima di essere bloccato" },
    { type: "paragraph",html: "Ecco la parte che molti saltano ed è quella che fa più male. Il messaggio di client vietato non si risolve da solo reinserendo la password, perché la password non è mai stata il problema. Ciò che il reinserimento fa, invece, è accumulare tentativi falliti. Dopo un certo numero, il livello di sicurezza di NinjaTrader smette di rispondere ai login per un periodo di attesa prestabilito e compare la riga “too many login attempts”. Se continua, può azzerare quel timer a ogni tentativo, il che significa restare bloccato più a lungo che se si fosse semplicemente fermato." },
    { type: "paragraph",html: "L'attesa è temporale e in genere si risolve dopo circa un'ora, anche se il valore esatto può cambiare tra le release, quindi lo confermi nella sua versione. Le build più recenti aggiungono una richiesta reCaptcha per poter eliminare la limitazione risolvendo un puzzle invece di attendere l'intera finestra. In ogni caso la mossa è la stessa: nel momento in cui vede “Client App Prohibited”, si fermi." },
    { type: "heading",text: "Come risolvere: passo dopo passo" },
    {
      type: "steps",
      items: [
        { title: "Si fermi e confermi il tipo di account", html: "Chiuda la finestra di connessione. Prima di toccare di nuovo il login, risponda a una domanda: è un account di prop firm o di valutazione, oppure un account Tradovate personale che ha aperto lei stesso? Gli account prop e di valutazione sono quelli più probabilmente limitati alle app di Tradovate. Se è un account della società, il supporto o la dashboard della sua società è il posto in cui confermare per quale piattaforma e tipo di connessione è abilitato. Se è personale, passi alla configurazione lato NinjaTrader nel quarto passaggio." },
        { title: "Verifichi di usare il login corretto", html: "Si assicuri che il nome utente e la password che inserisce siano quelli dell'account esatto con cui intende operare. Un login Tradovate rilasciato dalla società è distinto da un login NinjaTrader Dashboard, e scambiarli produce lo stesso errore. Se la sua società si collega tramite Rithmic in NinjaTrader, usi lì le credenziali e il tipo di connessione Rithmic, e riservi il login Tradovate alle piattaforme di Tradovate." },
        { title: "Scriva al supporto NinjaTrader con il suo nome utente", html: "È il passaggio che risolve davvero un genuino blocco di client vietato. Scriva a <strong class='text-white'>support@ninjatrader.com</strong> indicando il nome utente esatto con cui accede alla piattaforma NinjaTrader, insieme a una breve nota in cui specifica che riceve un errore “Client App Prohibited” cercando di collegare un account Tradovate. Quel nome utente permette al team di verificare se l'account è autorizzato dal loro lato. Per fornire il quadro completo, alleghi i file di log e trace: in NinjaTrader, apra <strong class='text-white'>Control Center &rsaquo; Help &rsaquo; Email Support</strong> e selezioni <strong class='text-white'>Platform Technical Support</strong> come destinatario. Verifichi le etichette esatte dei menu nella sua build, poiché cambiano tra le versioni." },
        { title: "Se è un account Tradovate personale, corregga il lato NinjaTrader", html: "Per un account personale idoneo che continua a non collegarsi, prepari la configurazione locale. Si assicuri di avere un account NinjaTrader Dashboard con la chiave di licenza importata, aggiorni NinjaTrader a una build attuale e abiliti la modalità Multi-Provider affinché possa mantenere una connessione Tradovate accanto al login NinjaTrader. Una volta sistemato il lato Dashboard, aggiunga di nuovo la connessione Tradovate con le credenziali corrette. Se si collega senza problemi, ha finito. Se restituisce ancora il messaggio di client vietato, l'account non è autorizzato per NinjaTrader e il passaggio precedente è la sua strada." },
        { title: "Non riprovi in loop mentre attende", html: "Se durante il percorso ha innescato la limitazione “too many login attempts”, la lasci svanire. Attenda il periodo di attesa o risponda al reCaptcha se la sua build lo offre, e resista alla tentazione di testare il login ogni pochi minuti. Un solo tentativo pulito dopo l'attesa le dice più di dieci tentativi frustrati." },
      ],
    },
    { type: "heading",text: "Tabella di risoluzione dei problemi" },
    { type: "table", headers: ["Cosa vede","Cosa significa","Cosa fare"], rows: [
      ["Client App is Prohibited / client app prohibited logon failed","Il login non è autorizzato a collegarsi tramite NinjaTrader","Smetta di riprovare; confermi che l'account sia idoneo, poi scriva a support@ninjatrader.com con il suo nome utente"],
      ["Messaggio di client vietato su un account prop / di valutazione","L'account è probabilmente abilitato per le app di Tradovate, non per NinjaTrader","Verifichi le regole di piattaforma attuali della sua società; usi il tipo di connessione (ad es. Rithmic) che la sua società supporta in NinjaTrader"],
      ["“Too many login attempts” compare dopo i tentativi","Un'attesa di sicurezza temporale dovuta a ripetuti errori","Smetta di provare, attenda (circa un'ora) o risponda al reCaptcha se la sua build lo mostra"],
      ["Messaggio di client vietato su un account Tradovate personale","Account Dashboard, licenza, build o modalità Multi-Provider non configurati","Importi la licenza, aggiorni NinjaTrader, abiliti la modalità Multi-Provider, ricolleghi"],
      ["Si collega nell'app Tradovate ma non in NinjaTrader","Il percorso dell'account è solo Tradovate, non autorizzato per NinjaTrader","Lo utilizzi sulla piattaforma Tradovate o lo automatizzi tramite un ponte diretto a Tradovate"],
    ] },
    { type: "heading",text: "Se il suo account proprio non vuole collegarsi a NinjaTrader" },
    { type: "paragraph",html: "A volte la risposta onesta è che l'account non è mai stato pensato per funzionare in NinjaTrader. Il supporto lo conferma, la sua società lo conferma e nessuna configurazione lo cambia. Questo non significa che sia costretto a operare a mano. Il suo account basato su Tradovate funziona benissimo sulle piattaforme di Tradovate e può comunque essere automatizzato." },
    { type: "paragraph",html: "È qui che instradare la sua strategia tramite PickMyTrade risolve l'intero problema da un'altra angolazione. Invece di combattere con NinjaTrader perché accetti un login che non accetta, PickMyTrade si collega direttamente a Tradovate e trasforma i suoi alert di TradingView in ordini reali su quell'account:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Connessione diretta a Tradovate</strong> così non dipende dall'autorizzazione dell'account da parte di NinjaTrader.",
        "<strong class='text-white'>Dagli alert di TradingView agli ordini reali</strong> così una strategia o un indicatore può attivare automaticamente ingressi, stop e target sul suo account Tradovate.",
        "<strong class='text-white'>Una sessione gestita</strong> che si collega una volta e resta attiva, invece di accedere ripetutamente e provocare un blocco.",
        "<strong class='text-white'>Supporto multi-account</strong> così può replicare gli stessi ordini su più account Tradovate da un unico punto.",
      ],
    },
    { type: "paragraph",html: "Se il suo obiettivo era l'automazione e NinjaTrader era solo il veicolo, questo la porta a destinazione senza il muro del client vietato." },
  ] },
  ctaHeading: { en: "Automate Your Tradovate Account Directly", de: "Automatisieren Sie Ihr Tradovate-Konto direkt", es: "Automatice su cuenta de Tradovate directamente", fr: "Automatisez directement votre compte Tradovate", it: "Automatizzi direttamente il suo account Tradovate" },
  ctaText: { en: "Skip fighting NinjaTrader for a login it won't take. PickMyTrade connects to Tradovate directly and turns your TradingView alerts into live orders.", de: "Hören Sie auf, mit NinjaTrader um einen Login zu kämpfen, den es nicht annimmt. PickMyTrade verbindet sich direkt mit Tradovate und verwandelt Ihre TradingView-Alerts in Live-Orders.", es: "Deje de pelear con NinjaTrader por un inicio de sesión que no acepta. PickMyTrade se conecta directamente a Tradovate y convierte sus alertas de TradingView en órdenes reales.", fr: "Cessez de vous battre avec NinjaTrader pour une connexion qu'il refuse. PickMyTrade se connecte directement à Tradovate et transforme vos alertes TradingView en ordres réels.", it: "Smetta di combattere con NinjaTrader per un login che non accetta. PickMyTrade si collega direttamente a Tradovate e trasforma i suoi alert di TradingView in ordini reali." },
  ctaButtonText: { en: "Start Your Free 7-Day Trial", de: "Starten Sie Ihre kostenlose 7-Tage-Testphase", es: "Comience su prueba gratuita de 7 días", fr: "Commencez votre essai gratuit de 7 jours", it: "Inizi la prova gratuita di 7 giorni" },
  ctaUrl: "https://app.pickmytrade.trade/?register=true&utm_source=content&utm_medium=debugging",
  faqHeading: { en: "Frequently Asked Questions", de: "Häufig gestellte Fragen", es: "Preguntas frecuentes", fr: "Questions fréquentes", it: "Domande frequenti" },
  faqs: { en: [
    { q: "What does “Client App Prohibited” mean in NinjaTrader?", a: "It means the login you entered isn't authorized to connect through NinjaTrader. The username you're signing in with belongs to an account, usually a Tradovate-based prop or evaluation account, that the NinjaTrader connection isn't cleared to access. NinjaTrader blocks the client app rather than letting the session through, even when your password is correct." },
    { q: "Why won't my Topstep or prop-firm Tradovate account connect to NinjaTrader?", a: "Some firms issue Tradovate-based accounts that are only meant to run on Tradovate's own web, desktop, and mobile apps, not inside NinjaTrader. At the time of writing, certain firms only connect through NinjaTrader when the account is set up on Rithmic instead. Which platforms your account is licensed for varies by firm and can change, so confirm your firm's current setup before troubleshooting further." },
    { q: "Should I keep retrying the login after Client App Prohibited?", a: "No. Repeated attempts push you from a prohibited-client message into a full login lockout, and the error often appears alongside a “too many login attempts” warning. Each new try can restart the timer. Stop, confirm your account and credentials, then contact support instead of hammering the login button." },
    { q: "What should I email NinjaTrader support?", a: "Write to support@ninjatrader.com and include the exact username you use to log into the NinjaTrader platform, plus a note that you're getting a Client App Prohibited error connecting a Tradovate account. Support can check whether that username is authorized. You can also attach log and trace files from Control Center, Help, Email Support, choosing Platform Technical Support." },
    { q: "How long does the login lockout last?", a: "A rapid-retry lockout is time-based and typically clears after roughly an hour, but each fresh attempt can reset that clock, so patience is the fix. Newer NinjaTrader builds may let you clear it sooner by answering a reCaptcha prompt. The exact timing can change between releases, so confirm the current behavior in your version." },
    { q: "Does updating NinjaTrader fix Client App Prohibited?", a: "Sometimes. If your credentials are valid but your NinjaTrader Dashboard account or build is out of date, updating to a current release, importing your license key, and enabling Multi-Provider Mode can let a supported Tradovate account connect. If the account itself isn't authorized for NinjaTrader, an update alone won't clear the error." },
    { q: "Can I automate my Tradovate account without NinjaTrader?", a: "Yes. If your Tradovate-based account isn't authorized for NinjaTrader, you can still automate it. PickMyTrade routes TradingView alerts straight to Tradovate through its own managed connection, so you can run a strategy on that account without needing NinjaTrader to accept the login at all." },
  ], de: [
    { q: "Was bedeutet „Client App Prohibited“ in NinjaTrader?", a: "Es bedeutet, dass der eingegebene Login nicht berechtigt ist, sich über NinjaTrader zu verbinden. Der Benutzername, mit dem Sie sich anmelden, gehört zu einem Konto, in der Regel einem Tradovate-basierten Prop- oder Evaluierungskonto, auf das die NinjaTrader-Verbindung keinen Zugriff hat. NinjaTrader blockiert die Client-App, statt die Sitzung durchzulassen, selbst wenn Ihr Passwort korrekt ist." },
    { q: "Warum verbindet sich mein Topstep- oder Prop-Firm-Tradovate-Konto nicht mit NinjaTrader?", a: "Manche Firmen stellen Tradovate-basierte Konten aus, die nur für die eigenen Web-, Desktop- und Mobil-Apps von Tradovate gedacht sind, nicht für NinjaTrader. Zum Zeitpunkt der Erstellung verbinden sich bestimmte Firmen nur dann über NinjaTrader, wenn das Konto stattdessen über Rithmic eingerichtet ist. Für welche Plattformen Ihr Konto lizenziert ist, hängt von der Firma ab und kann sich ändern; bestätigen Sie daher die aktuelle Einrichtung Ihrer Firma, bevor Sie weiter Fehler suchen." },
    { q: "Soll ich den Login nach „Client App Prohibited“ weiter versuchen?", a: "Nein. Wiederholte Versuche führen Sie von der Meldung zum gesperrten Client in eine vollständige Login-Sperre, und der Fehler erscheint oft zusammen mit einer Warnung „too many login attempts“. Jeder neue Versuch kann den Timer neu starten. Hören Sie auf, prüfen Sie Ihr Konto und Ihre Zugangsdaten und wenden Sie sich dann an den Support, statt auf die Login-Schaltfläche einzuhämmern." },
    { q: "Was soll ich an den NinjaTrader-Support schreiben?", a: "Schreiben Sie an support@ninjatrader.com und geben Sie den genauen Benutzernamen an, mit dem Sie sich bei der NinjaTrader-Plattform anmelden, sowie einen Hinweis, dass Sie beim Verbinden eines Tradovate-Kontos den Fehler Client App Prohibited erhalten. Der Support kann prüfen, ob dieser Benutzername berechtigt ist. Sie können außerdem Log- und Trace-Dateien über Control Center, Help, Email Support anhängen und Platform Technical Support auswählen." },
    { q: "Wie lange dauert die Login-Sperre?", a: "Eine Sperre nach schnellen Wiederholungen ist zeitbasiert und endet in der Regel nach etwa einer Stunde, doch jeder neue Versuch kann diese Uhr zurücksetzen. Geduld ist also die Lösung. Neuere NinjaTrader-Builds lassen Sie die Sperre möglicherweise früher aufheben, indem Sie eine reCaptcha-Abfrage beantworten. Das genaue Timing kann sich zwischen Releases ändern; bestätigen Sie das aktuelle Verhalten in Ihrer Version." },
    { q: "Behebt ein Update von NinjaTrader „Client App Prohibited“?", a: "Manchmal. Sind Ihre Zugangsdaten gültig, aber Ihr NinjaTrader-Dashboard-Konto oder Ihr Build veraltet, kann ein Update auf eine aktuelle Version, der Import Ihres Lizenzschlüssels und das Aktivieren des Multi-Provider-Modus es einem unterstützten Tradovate-Konto ermöglichen, sich zu verbinden. Ist das Konto selbst nicht für NinjaTrader berechtigt, beseitigt ein Update allein den Fehler nicht." },
    { q: "Kann ich mein Tradovate-Konto ohne NinjaTrader automatisieren?", a: "Ja. Ist Ihr Tradovate-basiertes Konto nicht für NinjaTrader berechtigt, können Sie es trotzdem automatisieren. PickMyTrade leitet TradingView-Alerts über eine eigene verwaltete Verbindung direkt an Tradovate weiter, sodass Sie eine Strategie auf diesem Konto betreiben können, ohne dass NinjaTrader den Login überhaupt akzeptieren muss." },
  ], es: [
    { q: "¿Qué significa “Client App Prohibited” en NinjaTrader?", a: "Significa que el inicio de sesión que introdujo no está autorizado para conectarse a través de NinjaTrader. El usuario con el que inicia sesión pertenece a una cuenta, normalmente una cuenta prop o de evaluación basada en Tradovate, a la que la conexión de NinjaTrader no tiene permiso de acceso. NinjaTrader bloquea la app cliente en lugar de dejar pasar la sesión, incluso cuando su contraseña es correcta." },
    { q: "¿Por qué mi cuenta de Tradovate de Topstep o de otra firma prop no se conecta a NinjaTrader?", a: "Algunas firmas emiten cuentas basadas en Tradovate pensadas solo para las propias apps web, de escritorio y móviles de Tradovate, no para NinjaTrader. En el momento de redactar esto, ciertas firmas solo se conectan a través de NinjaTrader cuando la cuenta está configurada en Rithmic. Las plataformas para las que su cuenta tiene licencia varían según la firma y pueden cambiar, así que confirme la configuración actual de su firma antes de seguir solucionando el problema." },
    { q: "¿Debo seguir reintentando el inicio de sesión tras Client App Prohibited?", a: "No. Los intentos repetidos le llevan del mensaje de cliente prohibido a un bloqueo total del inicio de sesión, y el error suele aparecer junto con la advertencia “too many login attempts”. Cada nuevo intento puede reiniciar el temporizador. Deténgase, confirme su cuenta y credenciales y contacte con soporte en lugar de machacar el botón de inicio de sesión." },
    { q: "¿Qué debo enviar por correo al soporte de NinjaTrader?", a: "Escriba a support@ninjatrader.com e incluya el nombre de usuario exacto con el que inicia sesión en la plataforma NinjaTrader, además de una nota indicando que recibe un error Client App Prohibited al conectar una cuenta de Tradovate. El soporte puede comprobar si ese usuario está autorizado. También puede adjuntar archivos de registro y traza desde Control Center, Help, Email Support, eligiendo Platform Technical Support." },
    { q: "¿Cuánto dura el bloqueo del inicio de sesión?", a: "Un bloqueo por reintentos rápidos se basa en el tiempo y suele desaparecer tras aproximadamente una hora, pero cada nuevo intento puede reiniciar ese reloj, así que la paciencia es la solución. Las versiones más recientes de NinjaTrader pueden permitirle eliminarlo antes respondiendo a una solicitud de reCaptcha. El tiempo exacto puede cambiar entre versiones; confirme el comportamiento actual en la suya." },
    { q: "¿Actualizar NinjaTrader soluciona Client App Prohibited?", a: "A veces. Si sus credenciales son válidas pero su cuenta del Dashboard de NinjaTrader o su versión está desactualizada, actualizar a una versión actual, importar su clave de licencia y activar el modo Multi-Provider puede permitir que se conecte una cuenta de Tradovate compatible. Si la propia cuenta no está autorizada para NinjaTrader, una actualización por sí sola no eliminará el error." },
    { q: "¿Puedo automatizar mi cuenta de Tradovate sin NinjaTrader?", a: "Sí. Si su cuenta basada en Tradovate no está autorizada para NinjaTrader, aun así puede automatizarla. PickMyTrade enruta las alertas de TradingView directamente a Tradovate mediante su propia conexión gestionada, de modo que puede ejecutar una estrategia en esa cuenta sin que NinjaTrader tenga que aceptar el inicio de sesión." },
  ], fr: [
    { q: "Que signifie « Client App Prohibited » dans NinjaTrader ?", a: "Cela signifie que la connexion saisie n'est pas autorisée à se connecter via NinjaTrader. L'identifiant avec lequel vous vous connectez appartient à un compte, généralement un compte prop ou d'évaluation basé sur Tradovate, auquel la connexion NinjaTrader n'est pas autorisée à accéder. NinjaTrader bloque l'application cliente plutôt que de laisser passer la session, même si votre mot de passe est correct." },
    { q: "Pourquoi mon compte Tradovate Topstep ou d'une autre société de prop trading ne se connecte-t-il pas à NinjaTrader ?", a: "Certaines sociétés émettent des comptes basés sur Tradovate uniquement destinés aux applications web, de bureau et mobiles propres à Tradovate, et non à NinjaTrader. Au moment de la rédaction, certaines sociétés ne se connectent via NinjaTrader que lorsque le compte est configuré sur Rithmic. Les plateformes pour lesquelles votre compte est licencié varient selon la société et peuvent changer ; confirmez donc la configuration actuelle de votre société avant de poursuivre le dépannage." },
    { q: "Dois-je continuer à réessayer la connexion après Client App Prohibited ?", a: "Non. Les tentatives répétées vous font passer d'un message de client interdit à un verrouillage complet de la connexion, et l'erreur apparaît souvent accompagnée d'un avertissement « too many login attempts ». Chaque nouvelle tentative peut relancer le minuteur. Arrêtez-vous, vérifiez votre compte et vos identifiants, puis contactez le support au lieu de marteler le bouton de connexion." },
    { q: "Que dois-je envoyer par e-mail au support NinjaTrader ?", a: "Écrivez à support@ninjatrader.com en indiquant l'identifiant exact avec lequel vous vous connectez à la plateforme NinjaTrader, ainsi qu'une note précisant que vous obtenez une erreur Client App Prohibited en connectant un compte Tradovate. Le support peut vérifier si cet identifiant est autorisé. Vous pouvez aussi joindre des fichiers de journal et de trace depuis Control Center, Help, Email Support, en choisissant Platform Technical Support." },
    { q: "Combien de temps dure le verrouillage de la connexion ?", a: "Un verrouillage dû à des tentatives rapides est temporel et se lève généralement après environ une heure, mais chaque nouvelle tentative peut réinitialiser ce compteur ; la patience est donc la solution. Les versions récentes de NinjaTrader peuvent vous permettre de le lever plus tôt en répondant à une invite reCaptcha. Le délai exact peut changer d'une version à l'autre ; confirmez le comportement actuel dans votre version." },
    { q: "Mettre à jour NinjaTrader corrige-t-il Client App Prohibited ?", a: "Parfois. Si vos identifiants sont valides mais que votre compte NinjaTrader Dashboard ou votre version est obsolète, passer à une version actuelle, importer votre clé de licence et activer le mode Multi-Provider peut permettre à un compte Tradovate pris en charge de se connecter. Si le compte lui-même n'est pas autorisé pour NinjaTrader, une mise à jour seule n'éliminera pas l'erreur." },
    { q: "Puis-je automatiser mon compte Tradovate sans NinjaTrader ?", a: "Oui. Si votre compte basé sur Tradovate n'est pas autorisé pour NinjaTrader, vous pouvez quand même l'automatiser. PickMyTrade achemine les alertes TradingView directement vers Tradovate via sa propre connexion gérée ; vous pouvez ainsi exécuter une stratégie sur ce compte sans que NinjaTrader n'ait à accepter la connexion." },
  ], it: [
    { q: "Cosa significa “Client App Prohibited” in NinjaTrader?", a: "Significa che il login inserito non è autorizzato a collegarsi tramite NinjaTrader. Il nome utente con cui effettua l'accesso appartiene a un account, di solito un account prop o di valutazione basato su Tradovate, a cui la connessione di NinjaTrader non è abilitata. NinjaTrader blocca l'app client invece di lasciar passare la sessione, anche quando la password è corretta." },
    { q: "Perché il mio account Tradovate Topstep o di un'altra prop firm non si collega a NinjaTrader?", a: "Alcune società emettono account basati su Tradovate pensati solo per le app web, desktop e mobile di Tradovate, non per NinjaTrader. Al momento della stesura, alcune società si collegano tramite NinjaTrader solo quando l'account è configurato su Rithmic. Le piattaforme per cui il suo account è abilitato variano a seconda della società e possono cambiare, quindi confermi la configurazione attuale della sua società prima di proseguire con la risoluzione dei problemi." },
    { q: "Devo continuare a riprovare il login dopo Client App Prohibited?", a: "No. I tentativi ripetuti la portano dal messaggio di client vietato a un blocco completo del login, e l'errore compare spesso insieme all'avviso “too many login attempts”. Ogni nuovo tentativo può far ripartire il timer. Si fermi, verifichi account e credenziali, poi contatti il supporto invece di martellare il pulsante di login." },
    { q: "Cosa devo inviare via e-mail al supporto NinjaTrader?", a: "Scriva a support@ninjatrader.com indicando il nome utente esatto con cui accede alla piattaforma NinjaTrader, insieme a una nota che specifichi che riceve un errore Client App Prohibited collegando un account Tradovate. Il supporto può verificare se quel nome utente è autorizzato. Può anche allegare i file di log e trace da Control Center, Help, Email Support, scegliendo Platform Technical Support." },
    { q: "Quanto dura il blocco del login?", a: "Un blocco dovuto a tentativi ravvicinati è temporale e in genere si risolve dopo circa un'ora, ma ogni nuovo tentativo può azzerare quel conteggio, quindi la pazienza è la soluzione. Le build più recenti di NinjaTrader possono permetterle di rimuoverlo prima rispondendo a una richiesta reCaptcha. La tempistica esatta può cambiare tra le release; confermi il comportamento attuale nella sua versione." },
    { q: "L'aggiornamento di NinjaTrader risolve Client App Prohibited?", a: "A volte. Se le credenziali sono valide ma il suo account NinjaTrader Dashboard o la build sono obsoleti, passare a una release attuale, importare la chiave di licenza e abilitare la modalità Multi-Provider può permettere il collegamento di un account Tradovate supportato. Se l'account stesso non è autorizzato per NinjaTrader, un aggiornamento da solo non eliminerà l'errore." },
    { q: "Posso automatizzare il mio account Tradovate senza NinjaTrader?", a: "Sì. Se il suo account basato su Tradovate non è autorizzato per NinjaTrader, può comunque automatizzarlo. PickMyTrade instrada gli alert di TradingView direttamente a Tradovate tramite una propria connessione gestita, così può eseguire una strategia su quell'account senza che NinjaTrader debba accettare il login." },
  ] },
