---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "desktop-crash-white-screen-windows-11";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/debugging/${SLUG}`;

const META_TITLE = "Tradovate Desktop Crash to White Screen (Win 11)";
const META_DESCRIPTION =
  "Desktop trading app flashing to a blank white screen on Windows 11? Recover in seconds, rule out your PC, keep trading on web, and know when to report it.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Tradovate-Desktop-Absturz zu weißem Bildschirm (Win 11)", es: "Bloqueo de Tradovate desktop a pantalla blanca (Win 11)", fr: "Plantage de Tradovate desktop en écran blanc (Win 11)", it: "Crash di Tradovate desktop con schermata bianca (Win 11)" },
  dek: { en: "No error box, no spinning cursor, just a blank white pane where your charts and DOM were a second ago. Here's the fastest recovery, how to rule out your own machine, and why this crash usually isn't your PC's fault at all.", de: "Keine Fehlermeldung, kein Ladekreis, nur eine leere weiße Fläche dort, wo Sekunden zuvor noch Ihre Charts und der DOM waren. Hier ist die schnellste Wiederherstellung, wie Sie Ihren eigenen Rechner ausschließen, und warum dieser Absturz meist gar nicht an Ihrem PC liegt.", es: "Sin cuadro de error, sin cursor giratorio, solo un panel blanco en blanco donde hace un segundo estaban sus gráficos y el DOM. Aquí tiene la recuperación más rápida, cómo descartar su propio equipo, y por qué este bloqueo normalmente no es culpa de su PC.", fr: "Pas de message d'erreur, pas de curseur qui tourne, juste un panneau blanc vide là où se trouvaient vos graphiques et le DOM une seconde plus tôt. Voici la récupération la plus rapide, comment écarter votre propre machine, et pourquoi ce plantage n'est généralement pas la faute de votre PC.", it: "Nessun messaggio di errore, nessun cursore che gira, solo un riquadro bianco vuoto dove un secondo prima c'erano i vostri grafici e il DOM. Ecco il ripristino più rapido, come escludere il vostro computer, e perché questo crash di solito non dipende affatto dal vostro PC." },
  readTime: { en: "8 min read", de: "8 Minuten Lesezeit", es: "Lectura de 8 minutos", fr: "Lecture de 8 minutes", it: "Lettura di 8 minuti" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "You're lining up an entry, the desktop app blinks, and the whole window goes flat white. No error box, no spinning cursor, no &ldquo;something went wrong&rdquo; dialog, just a blank pane where your charts and DOM were a second ago. Close it, reopen it, and you're back in business&hellip; until it happens again twenty minutes later, sometimes several times in a single session. If you've missed a setup because the platform whited out at the wrong moment, you already know how much this one stings." },
    { type: "paragraph", html: "Here's the short version before we dig in: <strong class='text-white'>the fastest recovery is to close the desktop app completely and reopen it</strong> (try an F5 refresh first). And the frustrating part, the reason no amount of tinkering with your PC has stuck, is that this crash keeps showing up on <em>different</em> Windows 11 machines and even on freshly reinstalled Windows. That pattern means it's almost certainly the app build, not your computer. So the real endgame is: recover fast, rule out your machine in fifteen minutes so you can report it cleanly, keep a fallback open, and let support chase the actual fix." },
    { type: "quote", html: "<strong class='text-white'>Fast recovery:</strong> Press <strong class='text-white'>F5</strong> (or <strong class='text-white'>Fn + F5</strong> on a laptop) to reload the window. If that doesn't paint it, right-click the app's taskbar icon &rarr; <strong class='text-white'>Close window</strong>, then reopen and sign back in. Your account, orders, and positions are all server-side, so nothing is lost in the restart." },
    { type: "heading", text: "What the White Screen Actually Is" },
    { type: "paragraph", html: "The Tradovate desktop app isn't a separate program from the web platform, it's the same web trader wrapped in a Chromium shell so it can run as a standalone Windows app. That's handy, but it inherits Chromium's failure mode: when the internal render process stalls or dies, the window has nothing to draw, so it paints blank white instead of falling back to a clean login screen. There's no crash dialog because, technically, the app didn't close, it's still running, it just went blind." },
    { type: "paragraph", html: "This particular white-out has been reported on more than one Windows 11 setup, a laptop and a desktop, in one case, both throwing the same white screen. When the identical symptom follows you across separate machines, the common thread isn't the hardware or the OS install. It's the software running on top of them." },
    { type: "paragraph", html: "Worth separating from close cousins: if the app stays alive but your charts go blank while the rest of the window works, that's a lighter data-load hiccup. If the platform locks up solid and goes black mid-trade rather than white, that's a different, related failure. Different symptoms, overlapping fixes, but the white-out on Win 11 is its own animal." },
    { type: "heading", text: "First Move: Get the App Back" },
    { type: "paragraph", html: "When the screen goes white, you want it working again before you think about root cause. Two steps, in order:" },
    { type: "heading", text: "1. Refresh the window (F5)" },
    { type: "paragraph", html: "Tap <strong class='text-white'>F5</strong>, or <strong class='text-white'>Fn + F5</strong> if your laptop maps the function keys to media controls by default. Because the desktop app is a browser under the hood, F5 forces it to reload the same way a web page does, often enough to repaint a white or blank pane without a full restart. It's the least disruptive fix, so try it first." },
    { type: "heading", text: "2. Fully close and reopen" },
    { type: "paragraph", html: "If F5 does nothing, don't just minimize, that leaves the wedged process running. Right-click the Tradovate icon on the taskbar and choose <strong class='text-white'>Close window</strong>, or use Task Manager to end the app if it won't respond, then launch it fresh from your Start menu or desktop shortcut. Sign back in, and it reloads to a working state within a few seconds. This is the reliable recovery, it just doesn't stop the crash from coming back." },
    { type: "heading", text: "Rule Out Your Own Machine (15 Minutes)" },
    { type: "paragraph", html: "Here's the honest part: because this crash survives clean OS installs, the steps below probably won't be the thing that finally fixes it. But you still want to run them, partly on the off chance your case is a local one, and mostly so that when you contact support you can say &ldquo;I've already reinstalled, updated drivers, and synced the clock, and it still white-screens.&rdquo; That turns your ticket from &ldquo;did you try turning it off and on&rdquo; into a real bug report." },
    { type: "heading", text: "Sync the Windows clock" },
    { type: "paragraph", html: "A drifted system clock breaks the secure connection the app relies on and can throw it into odd states. Go to <strong class='text-white'>Settings &rarr; Time &amp; language &rarr; Date &amp; time</strong>, turn on <strong class='text-white'>Set time automatically</strong>, and click <strong class='text-white'>Sync now</strong>. Quick, free, and it clears a whole category of flakiness." },
    { type: "heading", text: "Reinstall the desktop app" },
    { type: "paragraph", html: "On rare occasions the app install itself goes corrupt. Uninstall the current copy, then download a fresh installer from Tradovate's official downloads page (<strong class='text-white'>tradovate.com/devices</strong>) and reinstall the latest build. This guarantees you're testing against the current version, important, since a fix may already be shipping and you don't want to report a bug that's been patched." },
    { type: "heading", text: "Update your graphics driver" },
    { type: "paragraph", html: "Outdated or buggy GPU drivers are the single most common cause of blank screens in Chromium-based apps, because that render process leans on hardware acceleration. Open <strong class='text-white'>Device Manager &rarr; Display adapters</strong>, right-click your graphics card, and choose <strong class='text-white'>Update driver</strong>, or grab the latest package straight from your GPU vendor (NVIDIA, AMD, or Intel) and reboot. If a bad driver was the culprit, this fixes it outright. If the app still whites out afterward, you've just confirmed it isn't your graphics stack." },
    { type: "quote", html: "If the white screen keeps returning after a clock sync, a clean reinstall, and a fresh graphics driver, stop reinstalling things. You've done your diligence, that combination confirms the fault is on the app side, and the next step is a support report, not another rebuild." },
    { type: "heading", text: "Keep Trading While It's Flaky" },
    { type: "paragraph", html: "You don't have to sit and wait for the desktop app to behave. The <strong class='text-white'>web platform at trader.tradovate.com</strong> runs the same account through your browser and doesn't depend on the desktop build that's crashing. Because a desktop-specific render failure doesn't hit the browser the same way, the web trader is your most dependable fallback, pull it up in Chrome or Edge and you've got full order entry, charts, and position management. The <strong class='text-white'>mobile app</strong> is a solid backup for one job in particular: flattening or adjusting a position in a hurry if the desktop window blanks while you're live." },
    { type: "paragraph", html: "Two honest caveats. The web platform's login enforces a session limit, so if you're bouncing between desktop, web, and TradingView, sign out of the sessions you're not using to avoid getting bumped. And the mobile web view is cramped for anything beyond a quick exit, treat the phone as an emergency handle, not your main cockpit." },
    { type: "heading", text: "When It's Not Your Machine: Report It Right" },
    { type: "paragraph", html: "A vague &ldquo;your app keeps crashing&rdquo; ticket goes nowhere. A specific, reproducible one gets escalated. When you contact support, hand them everything they'd need to recreate it:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Windows 11 build number</strong>, run <code>winver</code> from the Start menu and copy the exact version and build.",
        "<strong class='text-white'>Desktop app version</strong>, note the build number shown in the app's About or settings screen.",
        "<strong class='text-white'>Timestamps in Central Time</strong>, roughly when each crash hit, so they can match it against server logs.",
        "<strong class='text-white'>What you were doing</strong>, loading a chart, placing an order, switching tabs. Any pattern helps them narrow it.",
        "<strong class='text-white'>A screenshot</strong> of the white window (yes, even a blank one, it confirms the symptom).",
        "<strong class='text-white'>The clincher</strong>, that it persists after a clean OS install or on a second machine. That single line tells them it's not a local fluke.",
      ],
    },
    { type: "paragraph", html: "Frame it as &ldquo;here's what I've already ruled out.&rdquo; Support can't fix a build-level bug you report as a mystery, but they can prioritize one that's documented and reproducible." },
    { type: "heading", text: "Don't Let a White-Out Cost You a Fill" },
    { type: "paragraph", html: "The scary version of this crash is the one that hits while you're in a trade and need to act. So build your setup around the fact that the window can vanish at any second." },
    { type: "paragraph", html: "The good news: <strong class='text-white'>your resting orders don't live in that window.</strong> Any stop or target Tradovate has accepted sits on its servers and keeps working whether or not your desktop app is painting a screen. A blank window can't manage your risk, but a stop order already placed at the exchange doesn't care that your monitor went white. So the discipline is simple, put a hard stop on every position <em>the moment</em> you enter, before you rely on watching the trade. If the screen dies, your protection is already parked where a client crash can't touch it. And always keep a second way in (web or mobile) so you can see and flatten from another device." },
    { type: "heading", text: "Troubleshooting at a Glance" },
    {
      type: "table",
      headers: ["Situation", "What it means", "What to do"],
      rows: [
        ["Window flashes white mid-session", "Render process stalled", "Press F5 first; if blank, fully close and reopen the app"],
        ["Comes back, then whites out again", "App-build bug, not a one-off", "Rule out your machine, then report it with details"],
        ["Still crashes after a clean Windows install", "Confirms it's the app, not your PC", "Stop reinstalling; send a support report"],
        ["Need to trade right now", "Desktop build is unreliable", "Use trader.tradovate.com in a browser; mobile to flatten"],
        ["Blank screen but blurry/stale before it", "Possible GPU driver issue", "Update the graphics driver and reboot"],
        ["You're live when it goes white", "Client crash only, orders are safe", "Confirm positions on web/mobile; rely on your resting stop"],
      ],
    },
    { type: "heading", text: "Trade Through the Crashes With Server-Side Automation" },
    { type: "paragraph", html: "If a blanked-out platform has ever cost you an entry or a clean exit, the fix is to stop depending on any one window staying open. PickMyTrade routes your TradingView alerts straight to Tradovate and runs the execution on our servers, so your strategy keeps firing whether or not the desktop app is painting a screen:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Server-side execution</strong>, alerts travel from TradingView to Tradovate through our infrastructure, so a white-screened desktop app never blocks an entry or an exit.",
        "<strong class='text-white'>Device independence</strong>, nothing needs the desktop window open. Your setup triggers off the alert, not off whichever client happens to be alive.",
        "<strong class='text-white'>Stops and targets that stick</strong>, SL/TP defined in your alert land on Tradovate no matter what your screen is doing, so protection never hinges on the app rendering.",
        "<strong class='text-white'>Multi-account sync</strong>, mirror the same orders across every connected account at once, so nothing sits unmanaged while you restart a crashed platform.",
      ],
    },
  ], de: [
    { type: "paragraph", html: "Sie bereiten gerade einen Einstieg vor, die Desktop-App blinkt, und das gesamte Fenster wird komplett weiß. Keine Fehlermeldung, kein Ladekreis, kein &ldquo;Etwas ist schiefgelaufen&rdquo;-Dialog, nur eine leere Fläche dort, wo Sekunden zuvor noch Ihre Charts und der DOM waren. Schließen, neu öffnen, und Sie sind wieder im Geschäft&hellip; bis es zwanzig Minuten später erneut passiert, manchmal mehrmals in derselben Sitzung. Wenn Sie ein Setup verpasst haben, weil die Plattform im falschen Moment weiß wurde, wissen Sie bereits, wie sehr das schmerzt." },
    { type: "paragraph", html: "Hier die Kurzversion, bevor wir ins Detail gehen: <strong class='text-white'>Die schnellste Wiederherstellung besteht darin, die Desktop-App vollständig zu schließen und neu zu öffnen</strong> (versuchen Sie zuerst ein F5-Neuladen). Und der frustrierende Teil, der Grund, warum kein noch so großer Aufwand an Ihrem PC dauerhaft geholfen hat: Dieser Absturz taucht immer wieder auf <em>unterschiedlichen</em> Windows-11-Rechnern auf, sogar auf frisch installiertem Windows. Dieses Muster bedeutet, dass es fast sicher am App-Build liegt, nicht an Ihrem Computer. Das eigentliche Ziel lautet also: schnell wiederherstellen, Ihren Rechner in fünfzehn Minuten ausschließen, damit Sie es sauber melden können, eine Ausweichlösung bereithalten und den Support die eigentliche Lösung finden lassen." },
    { type: "quote", html: "<strong class='text-white'>Schnelle Wiederherstellung:</strong> Drücken Sie <strong class='text-white'>F5</strong> (oder <strong class='text-white'>Fn + F5</strong> auf einem Laptop), um das Fenster neu zu laden. Hilft das nicht, klicken Sie mit der rechten Maustaste auf das Taskleistensymbol der App &rarr; <strong class='text-white'>Close window</strong>, öffnen Sie sie dann neu und melden Sie sich wieder an. Ihr Konto, Ihre Orders und Positionen liegen alle serverseitig, sodass beim Neustart nichts verloren geht." },
    { type: "heading", text: "Was der weiße Bildschirm tatsächlich ist" },
    { type: "paragraph", html: "Die Tradovate-Desktop-App ist kein eigenständiges Programm gegenüber der Web-Plattform, sondern derselbe Web-Trader, eingebettet in eine Chromium-Hülle, damit er als eigenständige Windows-App laufen kann. Das ist praktisch, bringt aber auch Chromiums typischen Fehlermodus mit sich: Wenn der interne Render-Prozess ins Stocken gerät oder abstürzt, hat das Fenster nichts zu zeichnen und wird stattdessen weiß, anstatt auf einen sauberen Anmeldebildschirm zurückzufallen. Es gibt keinen Absturzdialog, denn technisch gesehen hat sich die App nicht geschlossen – sie läuft weiter, sie ist nur &ldquo;blind&rdquo; geworden." },
    { type: "paragraph", html: "Dieses spezielle Weiß-Werden wurde auf mehr als einer Windows-11-Konfiguration gemeldet, in einem Fall ein Laptop und ein Desktop-PC, beide mit demselben weißen Bildschirm. Wenn Sie dasselbe Symptom auf verschiedenen Rechnern verfolgt, liegt der gemeinsame Nenner nicht in der Hardware oder der Betriebssysteminstallation. Es ist die Software, die darauf läuft." },
    { type: "paragraph", html: "Es lohnt sich, das von ähnlichen Problemen abzugrenzen: Bleibt die App am Leben, aber Ihre Charts werden leer, während der Rest des Fensters funktioniert, ist das ein leichteres Problem beim Datenladen. Blockiert die Plattform vollständig und wird während eines Trades schwarz statt weiß, ist das ein anderer, verwandter Fehler. Unterschiedliche Symptome, teils überlappende Lösungen, aber das Weiß-Werden unter Win 11 ist eine eigene Kategorie für sich." },
    { type: "heading", text: "Erster Schritt: Die App wiederherstellen" },
    { type: "paragraph", html: "Wird der Bildschirm weiß, wollen Sie erst einmal, dass er wieder funktioniert, bevor Sie über die Ursache nachdenken. Zwei Schritte, in dieser Reihenfolge:" },
    { type: "heading", text: "1. Fenster neu laden (F5)" },
    { type: "paragraph", html: "Drücken Sie <strong class='text-white'>F5</strong>, oder <strong class='text-white'>Fn + F5</strong>, wenn Ihr Laptop die Funktionstasten standardmäßig auf Medien-Steuerung legt. Da die Desktop-App im Kern ein Browser ist, zwingt F5 sie zum Neuladen wie eine Webseite – oft genug, um eine weiße oder leere Fläche neu zu zeichnen, ohne einen kompletten Neustart. Das ist die am wenigsten störende Lösung, versuchen Sie es also zuerst." },
    { type: "heading", text: "2. Vollständig schließen und neu öffnen" },
    { type: "paragraph", html: "Bewirkt F5 nichts, minimieren Sie die App nicht einfach – das lässt den blockierten Prozess weiterlaufen. Klicken Sie mit der rechten Maustaste auf das Tradovate-Symbol in der Taskleiste und wählen Sie <strong class='text-white'>Close window</strong>, oder beenden Sie die App über den Task-Manager, wenn sie nicht reagiert, und starten Sie sie dann neu über das Startmenü oder die Desktop-Verknüpfung. Melden Sie sich wieder an, und sie lädt innerhalb weniger Sekunden in einen funktionierenden Zustand. Das ist die zuverlässige Wiederherstellung, sie verhindert nur nicht, dass der Absturz erneut auftritt." },
    { type: "heading", text: "Ihren eigenen Rechner ausschließen (15 Minuten)" },
    { type: "paragraph", html: "Hier die ehrliche Wahrheit: Da dieser Absturz auch saubere Betriebssysteminstallationen übersteht, werden die folgenden Schritte wahrscheinlich nicht das sein, was ihn endgültig behebt. Trotzdem sollten Sie sie durchführen, teils für den unwahrscheinlichen Fall, dass Ihr Problem doch lokal ist, vor allem aber, damit Sie dem Support sagen können: &ldquo;Ich habe bereits neu installiert, Treiber aktualisiert und die Uhr synchronisiert, und es wird trotzdem weiß.&rdquo; Das verwandelt Ihr Ticket von &ldquo;Haben Sie es mal aus- und wieder eingeschaltet&rdquo; in einen echten Fehlerbericht." },
    { type: "heading", text: "Die Windows-Uhr synchronisieren" },
    { type: "paragraph", html: "Eine abweichende Systemuhr stört die sichere Verbindung, auf die die App angewiesen ist, und kann sie in seltsame Zustände versetzen. Gehen Sie zu <strong class='text-white'>Settings &rarr; Time &amp; language &rarr; Date &amp; time</strong>, aktivieren Sie <strong class='text-white'>Set time automatically</strong> und klicken Sie auf <strong class='text-white'>Sync now</strong>. Schnell, kostenlos, und es beseitigt eine ganze Kategorie an Unzuverlässigkeit." },
    { type: "heading", text: "Die Desktop-App neu installieren" },
    { type: "paragraph", html: "In seltenen Fällen wird die App-Installation selbst beschädigt. Deinstallieren Sie die aktuelle Kopie, laden Sie dann einen neuen Installer von Tradovates offizieller Downloadseite herunter (<strong class='text-white'>tradovate.com/devices</strong>) und installieren Sie den aktuellsten Build neu. Damit stellen Sie sicher, dass Sie gegen die aktuelle Version testen – wichtig, denn eine Korrektur könnte bereits ausgeliefert werden, und Sie wollen keinen Fehler melden, der bereits behoben wurde." },
    { type: "heading", text: "Ihren Grafiktreiber aktualisieren" },
    { type: "paragraph", html: "Veraltete oder fehlerhafte GPU-Treiber sind die mit Abstand häufigste Ursache für leere Bildschirme in Chromium-basierten Apps, da der Render-Prozess auf Hardwarebeschleunigung angewiesen ist. Öffnen Sie <strong class='text-white'>Device Manager &rarr; Display adapters</strong>, klicken Sie mit der rechten Maustaste auf Ihre Grafikkarte und wählen Sie <strong class='text-white'>Update driver</strong>, oder laden Sie das neueste Paket direkt vom GPU-Hersteller (NVIDIA, AMD oder Intel) herunter und starten Sie neu. War ein fehlerhafter Treiber die Ursache, behebt das die Sache sofort. Wird die App danach immer noch weiß, haben Sie damit bestätigt, dass es nicht an Ihrer Grafikkette liegt." },
    { type: "quote", html: "Kehrt der weiße Bildschirm auch nach Uhrsynchronisierung, sauberer Neuinstallation und neuem Grafiktreiber zurück, hören Sie auf, noch mehr neu zu installieren. Sie haben Ihre Sorgfaltspflicht erfüllt, diese Kombination bestätigt, dass der Fehler auf der App-Seite liegt, und der nächste Schritt ist ein Support-Bericht, kein weiterer Wiederaufbau." },
    { type: "heading", text: "Weiterhandeln, solange die App instabil ist" },
    { type: "paragraph", html: "Sie müssen nicht warten, bis sich die Desktop-App wieder benimmt. Die <strong class='text-white'>Web-Plattform unter trader.tradovate.com</strong> läuft mit demselben Konto über Ihren Browser und ist nicht vom abstürzenden Desktop-Build abhängig. Da ein desktopspezifischer Render-Fehler den Browser nicht auf dieselbe Weise trifft, ist der Web-Trader Ihre zuverlässigste Ausweichlösung – öffnen Sie ihn in Chrome oder Edge, und Sie haben vollständige Ordereingabe, Charts und Positionsverwaltung. Die <strong class='text-white'>mobile App</strong> ist eine solide Sicherung für eine bestimmte Aufgabe: eine Position schnell zu glattstellen oder anzupassen, wenn das Desktop-Fenster während des laufenden Handels weiß wird." },
    { type: "paragraph", html: "Zwei ehrliche Einschränkungen. Der Login der Web-Plattform erzwingt ein Sitzungslimit, wenn Sie also zwischen Desktop, Web und TradingView wechseln, melden Sie sich von den nicht genutzten Sitzungen ab, um nicht hinausgeworfen zu werden. Und die mobile Web-Ansicht ist für alles über einen schnellen Ausstieg hinaus beengt – betrachten Sie das Handy als Notgriff, nicht als Ihr Haupt-Cockpit." },
    { type: "heading", text: "Wenn es nicht an Ihrem Rechner liegt: Richtig melden" },
    { type: "paragraph", html: "Ein vages &ldquo;Ihre App stürzt ständig ab&rdquo;-Ticket führt nirgendwohin. Ein konkretes, reproduzierbares Ticket wird eskaliert. Wenn Sie den Support kontaktieren, geben Sie ihm alles, was er zum Nachstellen benötigt:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Windows-11-Build-Nummer</strong> – führen Sie <code>winver</code> über das Startmenü aus und kopieren Sie die genaue Version und den Build.",
        "<strong class='text-white'>Version der Desktop-App</strong> – notieren Sie sich die Build-Nummer, die im Bereich &ldquo;Info&rdquo; oder in den Einstellungen der App angezeigt wird.",
        "<strong class='text-white'>Zeitstempel in Central Time</strong> – ungefähr, wann jeder Absturz auftrat, damit dies mit den Serverprotokollen abgeglichen werden kann.",
        "<strong class='text-white'>Was Sie gerade taten</strong> – ein Chart geladen, eine Order platziert, Tabs gewechselt. Jedes Muster hilft, die Ursache einzugrenzen.",
        "<strong class='text-white'>Ein Screenshot</strong> des weißen Fensters (ja, auch ein leeres bestätigt das Symptom).",
        "<strong class='text-white'>Der entscheidende Punkt</strong> – dass es auch nach einer sauberen Betriebssysteminstallation oder auf einem zweiten Rechner bestehen bleibt. Diese eine Zeile sagt ihnen, dass es kein lokaler Zufall ist.",
      ],
    },
    { type: "paragraph", html: "Formulieren Sie es als &ldquo;Das habe ich bereits ausgeschlossen.&rdquo; Der Support kann einen Build-Fehler nicht beheben, den Sie als Rätsel melden, aber er kann einen dokumentierten und reproduzierbaren priorisieren." },
    { type: "heading", text: "Lassen Sie sich durch einen weißen Bildschirm keine Ausführung entgehen" },
    { type: "paragraph", html: "Die beängstigende Variante dieses Absturzes ist die, die eintritt, während Sie in einem Trade sind und handeln müssen. Bauen Sie Ihr Setup daher um die Tatsache herum auf, dass das Fenster jederzeit verschwinden kann." },
    { type: "paragraph", html: "Die gute Nachricht: <strong class='text-white'>Ihre ruhenden Orders befinden sich nicht in diesem Fenster.</strong> Jeder Stop oder jedes Ziel, das Tradovate akzeptiert hat, liegt auf dessen Servern und arbeitet weiter, egal ob Ihre Desktop-App gerade einen Bildschirm zeichnet oder nicht. Ein leeres Fenster kann Ihr Risiko nicht managen, aber eine bereits an der Börse platzierte Stop-Order kümmert sich nicht darum, dass Ihr Monitor weiß geworden ist. Die Disziplin ist also einfach: Setzen Sie <em>im Moment</em> des Einstiegs bei jeder Position einen harten Stop, bevor Sie sich darauf verlassen, den Trade zu beobachten. Stirbt der Bildschirm, liegt Ihr Schutz bereits dort, wo ihn ein Client-Absturz nicht berühren kann. Und behalten Sie immer einen zweiten Zugangsweg (Web oder Mobil), damit Sie von einem anderen Gerät aus sehen und glattstellen können." },
    { type: "heading", text: "Fehlerbehebung auf einen Blick" },
    {
      type: "table",
      headers: ["Situation", "Was es bedeutet", "Was zu tun ist"],
      rows: [
        ["Fenster wird während der Sitzung plötzlich weiß", "Render-Prozess ist ins Stocken geraten", "Zuerst F5 drücken; bleibt es leer, App vollständig schließen und neu öffnen"],
        ["Kommt zurück, wird dann erneut weiß", "Fehler im App-Build, kein Einzelfall", "Ihren Rechner ausschließen, dann mit Details melden"],
        ["Stürzt auch nach sauberer Windows-Installation weiterhin ab", "Bestätigt, dass es an der App liegt, nicht an Ihrem PC", "Nicht weiter neu installieren; Support-Bericht senden"],
        ["Sie müssen jetzt sofort handeln", "Der Desktop-Build ist unzuverlässig", "trader.tradovate.com im Browser nutzen; mobil zum Glattstellen"],
        ["Leerer Bildschirm, aber vorher unscharf/veraltet", "Möglicherweise ein GPU-Treiberproblem", "Grafiktreiber aktualisieren und neu starten"],
        ["Sie handeln gerade live, als es weiß wird", "Nur ein Client-Absturz, Orders sind sicher", "Positionen auf Web/Mobil bestätigen; auf Ihren ruhenden Stop verlassen"],
      ],
    },
    { type: "heading", text: "Handeln Sie trotz Abstürzen mit serverseitiger Automatisierung weiter" },
    { type: "paragraph", html: "Wenn Sie eine leere Plattform schon einmal einen Einstieg oder einen sauberen Ausstieg gekostet hat, besteht die Lösung darin, nicht länger davon abhängig zu sein, dass ein einzelnes Fenster geöffnet bleibt. PickMyTrade leitet Ihre TradingView-Alerts direkt an Tradovate weiter und führt die Ausführung auf unseren Servern aus, sodass Ihre Strategie weiterhin auslöst, ob die Desktop-App gerade einen Bildschirm zeichnet oder nicht:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Serverseitige Ausführung</strong> – Alerts wandern über unsere Infrastruktur von TradingView zu Tradovate, sodass eine weiße Desktop-App niemals einen Einstieg oder Ausstieg blockiert.",
        "<strong class='text-white'>Geräteunabhängigkeit</strong> – nichts erfordert ein geöffnetes Desktop-Fenster. Ihr Setup löst über den Alert aus, nicht über den gerade laufenden Client.",
        "<strong class='text-white'>Stops und Ziele, die halten</strong> – SL/TP aus Ihrem Alert landen bei Tradovate, egal was Ihr Bildschirm gerade tut, sodass der Schutz nie vom Rendering der App abhängt.",
        "<strong class='text-white'>Multi-Konto-Synchronisierung</strong> – spiegeln Sie dieselben Orders gleichzeitig auf jedem verbundenen Konto, sodass nichts unverwaltet bleibt, während Sie eine abgestürzte Plattform neu starten.",
      ],
    },
  ], es: [
    { type: "paragraph", html: "Está preparando una entrada, la aplicación de escritorio parpadea, y toda la ventana se vuelve completamente blanca. Sin cuadro de error, sin cursor giratorio, sin diálogo de &ldquo;algo salió mal&rdquo;, solo un panel en blanco donde hace un segundo estaban sus gráficos y el DOM. Ciérrela, vuelva a abrirla, y ya está de vuelta&hellip; hasta que vuelve a ocurrir veinte minutos después, a veces varias veces en una sola sesión. Si ha perdido un setup porque la plataforma se puso en blanco en el momento equivocado, ya sabe cuánto duele esto." },
    { type: "paragraph", html: "Aquí va la versión corta antes de profundizar: <strong class='text-white'>la recuperación más rápida es cerrar la aplicación de escritorio por completo y volver a abrirla</strong> (pruebe primero con una actualización F5). Y la parte frustrante, la razón por la que ningún esfuerzo con su PC ha funcionado de forma duradera, es que este bloqueo sigue apareciendo en <em>distintos</em> equipos con Windows 11 e incluso en instalaciones de Windows recién hechas. Ese patrón significa que casi con toda seguridad se trata del build de la aplicación, no de su equipo. Así que el objetivo real es: recuperarse rápido, descartar su equipo en quince minutos para poder reportarlo con claridad, mantener una alternativa abierta y dejar que el soporte persiga la solución real." },
    { type: "quote", html: "<strong class='text-white'>Recuperación rápida:</strong> pulse <strong class='text-white'>F5</strong> (o <strong class='text-white'>Fn + F5</strong> en un portátil) para recargar la ventana. Si eso no la restaura, haga clic derecho en el icono de la app en la barra de tareas &rarr; <strong class='text-white'>Close window</strong>, luego vuelva a abrirla e inicie sesión de nuevo. Su cuenta, órdenes y posiciones residen todas del lado del servidor, así que no se pierde nada al reiniciar." },
    { type: "heading", text: "Qué es realmente la pantalla blanca" },
    { type: "paragraph", html: "La aplicación de escritorio de Tradovate no es un programa aparte de la plataforma web, es el mismo operador web envuelto en una capa de Chromium para poder ejecutarse como una aplicación independiente de Windows. Eso resulta práctico, pero hereda el modo de fallo de Chromium: cuando el proceso interno de renderizado se detiene o muere, la ventana no tiene nada que dibujar, así que se pone en blanco en lugar de volver a una pantalla de inicio de sesión limpia. No hay ningún cuadro de diálogo de bloqueo porque, técnicamente, la aplicación no se cerró, sigue en ejecución, simplemente se quedó &ldquo;ciega&rdquo;." },
    { type: "paragraph", html: "Este fenómeno concreto de pantalla en blanco se ha reportado en más de una configuración de Windows 11, un portátil y un equipo de escritorio en un caso, ambos mostrando la misma pantalla blanca. Cuando el mismo síntoma le sigue a través de equipos distintos, el hilo conductor no es el hardware ni la instalación del sistema operativo. Es el software que corre sobre ellos." },
    { type: "paragraph", html: "Vale la pena distinguirlo de parientes cercanos: si la app sigue viva pero sus gráficos se quedan en blanco mientras el resto de la ventana funciona, eso es un problema más leve de carga de datos. Si la plataforma se bloquea por completo y se pone negra en mitad de una operación en lugar de blanca, eso es un fallo distinto, aunque relacionado. Síntomas distintos, soluciones que se solapan en parte, pero la pantalla en blanco en Win 11 es un caso propio." },
    { type: "heading", text: "Primer paso: recupere la aplicación" },
    { type: "paragraph", html: "Cuando la pantalla se pone en blanco, primero quiere que vuelva a funcionar antes de pensar en la causa raíz. Dos pasos, en orden:" },
    { type: "heading", text: "1. Actualice la ventana (F5)" },
    { type: "paragraph", html: "Pulse <strong class='text-white'>F5</strong>, o <strong class='text-white'>Fn + F5</strong> si su portátil asigna por defecto las teclas de función a controles multimedia. Como la aplicación de escritorio es, en el fondo, un navegador, F5 la obliga a recargar igual que una página web, y con frecuencia basta para repintar un panel blanco o vacío sin necesidad de un reinicio completo. Es la solución menos disruptiva, así que pruébela primero." },
    { type: "heading", text: "2. Cierre por completo y vuelva a abrir" },
    { type: "paragraph", html: "Si F5 no hace nada, no se limite a minimizar, eso deja el proceso atascado en ejecución. Haga clic derecho en el icono de Tradovate en la barra de tareas y elija <strong class='text-white'>Close window</strong>, o use el Administrador de tareas para forzar el cierre si no responde, y luego ábrala de nuevo desde el menú Inicio o el acceso directo del escritorio. Vuelva a iniciar sesión, y se recarga a un estado funcional en cuestión de segundos. Esta es la recuperación fiable, simplemente no impide que el bloqueo vuelva a producirse." },
    { type: "heading", text: "Descarte su propio equipo (15 minutos)" },
    { type: "paragraph", html: "Aquí va la parte honesta: dado que este bloqueo sobrevive a instalaciones limpias del sistema operativo, los pasos siguientes probablemente no sean lo que finalmente lo solucione. Pero de todos modos conviene realizarlos, en parte por la remota posibilidad de que su caso sea local, y sobre todo para que, al contactar con soporte, pueda decir: &ldquo;ya he reinstalado, actualizado los controladores y sincronizado el reloj, y sigue poniéndose en blanco&rdquo;. Eso convierte su ticket de &ldquo;¿probó a apagarlo y encenderlo?&rdquo; en un reporte de error real." },
    { type: "heading", text: "Sincronice el reloj de Windows" },
    { type: "paragraph", html: "Un reloj del sistema desajustado rompe la conexión segura de la que depende la app y puede llevarla a estados extraños. Vaya a <strong class='text-white'>Settings &rarr; Time &amp; language &rarr; Date &amp; time</strong>, active <strong class='text-white'>Set time automatically</strong> y haga clic en <strong class='text-white'>Sync now</strong>. Rápido, gratuito, y elimina toda una categoría de inestabilidad." },
    { type: "heading", text: "Reinstale la aplicación de escritorio" },
    { type: "paragraph", html: "En raras ocasiones, la propia instalación de la app se corrompe. Desinstale la copia actual, luego descargue un instalador nuevo desde la página oficial de descargas de Tradovate (<strong class='text-white'>tradovate.com/devices</strong>) y reinstale la última versión. Esto garantiza que está probando con la versión actual, algo importante, ya que puede que ya se haya publicado una corrección y no quiera reportar un error que ya se ha solucionado." },
    { type: "heading", text: "Actualice su controlador gráfico" },
    { type: "paragraph", html: "Los controladores de GPU desactualizados o defectuosos son, con diferencia, la causa más común de pantallas en blanco en las apps basadas en Chromium, porque ese proceso de renderizado depende de la aceleración por hardware. Abra <strong class='text-white'>Device Manager &rarr; Display adapters</strong>, haga clic derecho en su tarjeta gráfica y elija <strong class='text-white'>Update driver</strong>, o descargue el paquete más reciente directamente del fabricante de su GPU (NVIDIA, AMD o Intel) y reinicie. Si un controlador defectuoso era el culpable, esto lo soluciona de raíz. Si la app sigue poniéndose en blanco después, acaba de confirmar que no es su hardware gráfico." },
    { type: "quote", html: "Si la pantalla blanca sigue volviendo tras sincronizar el reloj, hacer una reinstalación limpia y actualizar el controlador gráfico, deje de reinstalar cosas. Ha hecho su diligencia debida, esa combinación confirma que el fallo está del lado de la app, y el siguiente paso es un reporte de soporte, no otra reconstrucción." },
    { type: "heading", text: "Siga operando mientras esté inestable" },
    { type: "paragraph", html: "No tiene que quedarse esperando a que la aplicación de escritorio se comporte. La <strong class='text-white'>plataforma web en trader.tradovate.com</strong> ejecuta la misma cuenta a través de su navegador y no depende del build de escritorio que se está bloqueando. Como un fallo de renderizado específico del escritorio no afecta al navegador de la misma manera, el operador web es su alternativa más fiable, ábralo en Chrome o Edge y tendrá entrada de órdenes completa, gráficos y gestión de posiciones. La <strong class='text-white'>aplicación móvil</strong> es un buen respaldo para una tarea en particular: cerrar o ajustar una posición con rapidez si la ventana de escritorio se pone en blanco mientras está operando en vivo." },
    { type: "paragraph", html: "Dos advertencias honestas. El inicio de sesión de la plataforma web impone un límite de sesiones, así que si va alternando entre escritorio, web y TradingView, cierre sesión en las que no esté usando para evitar que la expulsen. Y la vista web móvil resulta apretada para cualquier cosa que vaya más allá de una salida rápida; trate el teléfono como una palanca de emergencia, no como su cabina principal." },
    { type: "heading", text: "Cuando no es su equipo: repórtelo correctamente" },
    { type: "paragraph", html: "Un ticket vago que diga &ldquo;su app sigue fallando&rdquo; no lleva a ningún lado. Uno específico y reproducible se escala. Cuando contacte con soporte, entrégueles todo lo que necesitarían para recrearlo:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Número de build de Windows 11</strong>, ejecute <code>winver</code> desde el menú Inicio y copie la versión y el build exactos.",
        "<strong class='text-white'>Versión de la aplicación de escritorio</strong>, anote el número de build mostrado en la pantalla de acerca de o de configuración de la app.",
        "<strong class='text-white'>Marcas de hora en hora central (Central Time)</strong>, aproximadamente cuándo ocurrió cada bloqueo, para que puedan compararlo con los registros del servidor.",
        "<strong class='text-white'>Qué estaba haciendo</strong>, cargando un gráfico, colocando una orden, cambiando de pestaña. Cualquier patrón les ayuda a acotarlo.",
        "<strong class='text-white'>Una captura de pantalla</strong> de la ventana en blanco (sí, aunque esté en blanco, confirma el síntoma).",
        "<strong class='text-white'>El dato decisivo</strong>, que persiste tras una instalación limpia del sistema operativo o en un segundo equipo. Esa sola línea les indica que no es una casualidad local.",
      ],
    },
    { type: "paragraph", html: "Plantéelo como &ldquo;esto es lo que ya he descartado&rdquo;. El soporte no puede solucionar un error a nivel de build que usted reporta como un misterio, pero sí puede priorizar uno documentado y reproducible." },
    { type: "heading", text: "No deje que una pantalla en blanco le cueste una ejecución" },
    { type: "paragraph", html: "La versión que da más miedo de este bloqueo es la que ocurre mientras está en una operación y necesita actuar. Así que construya su configuración partiendo del hecho de que la ventana puede desaparecer en cualquier momento." },
    { type: "paragraph", html: "La buena noticia: <strong class='text-white'>sus órdenes pendientes no viven en esa ventana.</strong> Cualquier stop o objetivo que Tradovate haya aceptado reside en sus servidores y sigue funcionando tanto si su aplicación de escritorio está mostrando la pantalla como si no. Una ventana en blanco no puede gestionar su riesgo, pero una orden de stop ya colocada en la bolsa no le importa que su monitor se haya puesto blanco. Así que la disciplina es sencilla: coloque un stop firme en cada posición <em>en el momento</em> en que entra, antes de confiar en vigilar la operación. Si la pantalla muere, su protección ya está resguardada donde un fallo del cliente no puede tocarla. Y mantenga siempre una segunda vía de acceso (web o móvil) para poder ver y cerrar desde otro dispositivo." },
    { type: "heading", text: "Solución de problemas de un vistazo" },
    {
      type: "table",
      headers: ["Situación", "Qué significa", "Qué hacer"],
      rows: [
        ["La ventana se pone blanca de repente durante la sesión", "El proceso de renderizado se detuvo", "Pulse F5 primero; si sigue en blanco, cierre por completo y vuelva a abrir la app"],
        ["Vuelve, y luego se pone en blanco otra vez", "Error del build de la app, no un caso aislado", "Descarte su equipo y luego repórtelo con detalles"],
        ["Sigue fallando después de una instalación limpia de Windows", "Confirma que es la app, no su PC", "Deje de reinstalar; envíe un reporte de soporte"],
        ["Necesita operar ahora mismo", "El build de escritorio no es fiable", "Use trader.tradovate.com en un navegador; el móvil para cerrar"],
        ["Pantalla en blanco pero borrosa/desactualizada antes de eso", "Posible problema con el controlador de la GPU", "Actualice el controlador gráfico y reinicie"],
        ["Está en vivo cuando se pone blanca", "Solo un fallo del cliente, las órdenes están a salvo", "Confirme las posiciones en web/móvil; confíe en su stop pendiente"],
      ],
    },
    { type: "heading", text: "Siga operando a pesar de los fallos con automatización del lado del servidor" },
    { type: "paragraph", html: "Si una plataforma en blanco alguna vez le ha costado una entrada o una salida limpia, la solución es dejar de depender de que una sola ventana permanezca abierta. PickMyTrade enruta sus alertas de TradingView directamente a Tradovate y ejecuta la operación en nuestros servidores, de modo que su estrategia sigue disparándose tanto si la app de escritorio está mostrando la pantalla como si no:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Ejecución del lado del servidor</strong>, las alertas viajan de TradingView a Tradovate a través de nuestra infraestructura, de modo que una app de escritorio en pantalla blanca nunca bloquea una entrada ni una salida.",
        "<strong class='text-white'>Independencia de dispositivo</strong>, nada requiere que la ventana de escritorio esté abierta. Su setup se dispara desde la alerta, no desde el cliente que resulte estar activo.",
        "<strong class='text-white'>Stops y objetivos que se mantienen</strong>, el SL/TP definido en su alerta llega a Tradovate sin importar lo que haga su pantalla, así que la protección nunca depende de que la app renderice.",
        "<strong class='text-white'>Sincronización multicuenta</strong>, replique las mismas órdenes en todas las cuentas conectadas a la vez, para que nada quede sin gestionar mientras reinicia una plataforma bloqueada.",
      ],
    },
  ], fr: [
    { type: "paragraph", html: "Vous préparez une entrée, l'application de bureau clignote, et toute la fenêtre devient entièrement blanche. Pas de message d'erreur, pas de curseur qui tourne, pas de boîte de dialogue &laquo;&nbsp;une erreur s'est produite&nbsp;&raquo;, juste un panneau vide là où se trouvaient vos graphiques et le DOM une seconde plus tôt. Fermez-la, rouvrez-la, et vous êtes de nouveau opérationnel&hellip; jusqu'à ce que cela se reproduise vingt minutes plus tard, parfois plusieurs fois dans une même session. Si vous avez raté un setup parce que la plateforme est devenue blanche au mauvais moment, vous savez déjà à quel point c'est frustrant." },
    { type: "paragraph", html: "Voici la version courte avant d'approfondir : <strong class='text-white'>la récupération la plus rapide consiste à fermer complètement l'application de bureau et à la rouvrir</strong> (essayez d'abord une actualisation F5). Et la partie frustrante, la raison pour laquelle aucun bricolage de votre PC n'a tenu, c'est que ce plantage continue d'apparaître sur <em>différentes</em> machines Windows 11 et même sur des installations Windows toutes fraîches. Ce schéma signifie que c'est presque certainement la build de l'application, pas votre ordinateur. Le véritable objectif est donc : récupérer rapidement, écarter votre machine en quinze minutes pour pouvoir le signaler proprement, garder une solution de repli ouverte, et laisser le support traquer la vraie correction." },
    { type: "quote", html: "<strong class='text-white'>Récupération rapide :</strong> appuyez sur <strong class='text-white'>F5</strong> (ou <strong class='text-white'>Fn + F5</strong> sur un ordinateur portable) pour recharger la fenêtre. Si cela ne suffit pas, faites un clic droit sur l'icône de l'application dans la barre des tâches &rarr; <strong class='text-white'>Close window</strong>, puis rouvrez et reconnectez-vous. Votre compte, vos ordres et vos positions sont tous côté serveur, donc rien n'est perdu lors du redémarrage." },
    { type: "heading", text: "Ce qu'est réellement l'écran blanc" },
    { type: "paragraph", html: "L'application de bureau Tradovate n'est pas un programme distinct de la plateforme web, c'est le même trader web enveloppé dans une coquille Chromium afin de pouvoir fonctionner comme une application Windows autonome. C'est pratique, mais elle hérite du mode de défaillance de Chromium : lorsque le processus de rendu interne se bloque ou plante, la fenêtre n'a rien à dessiner, elle devient donc entièrement blanche au lieu de revenir à un écran de connexion propre. Il n'y a pas de boîte de dialogue de plantage car, techniquement, l'application ne s'est pas fermée, elle continue de fonctionner, elle est simplement devenue &laquo;&nbsp;aveugle&nbsp;&raquo;." },
    { type: "paragraph", html: "Cette mise au blanc particulière a été signalée sur plusieurs configurations Windows 11, un ordinateur portable et un ordinateur de bureau dans un cas, tous deux affichant le même écran blanc. Lorsque le symptôme identique vous suit sur des machines distinctes, le point commun n'est ni le matériel ni l'installation du système d'exploitation. C'est le logiciel qui tourne dessus." },
    { type: "paragraph", html: "Il vaut la peine de le distinguer de cas voisins : si l'application reste active mais que vos graphiques deviennent vides pendant que le reste de la fenêtre fonctionne, il s'agit d'un léger accroc de chargement de données. Si la plateforme se bloque complètement et devient noire en pleine transaction plutôt que blanche, il s'agit d'une défaillance différente, mais liée. Symptômes différents, corrections qui se chevauchent, mais la mise au blanc sous Win 11 est un cas à part." },
    { type: "heading", text: "Première étape : récupérer l'application" },
    { type: "paragraph", html: "Lorsque l'écran devient blanc, vous voulez d'abord qu'il refonctionne avant de penser à la cause profonde. Deux étapes, dans l'ordre :" },
    { type: "heading", text: "1. Actualisez la fenêtre (F5)" },
    { type: "paragraph", html: "Appuyez sur <strong class='text-white'>F5</strong>, ou <strong class='text-white'>Fn + F5</strong> si votre ordinateur portable attribue par défaut les touches de fonction aux commandes multimédias. Comme l'application de bureau est, sous le capot, un navigateur, F5 la force à se recharger comme une page web, souvent assez pour repeindre un panneau blanc ou vide sans redémarrage complet. C'est la solution la moins perturbatrice, essayez-la donc en premier." },
    { type: "heading", text: "2. Fermez complètement et rouvrez" },
    { type: "paragraph", html: "Si F5 ne fait rien, ne vous contentez pas de réduire la fenêtre, cela laisse le processus bloqué en cours d'exécution. Faites un clic droit sur l'icône Tradovate dans la barre des tâches et choisissez <strong class='text-white'>Close window</strong>, ou utilisez le Gestionnaire des tâches pour arrêter l'application si elle ne répond pas, puis relancez-la depuis le menu Démarrer ou le raccourci du bureau. Reconnectez-vous, et elle revient à un état fonctionnel en quelques secondes. C'est la récupération fiable, elle n'empêche simplement pas le plantage de revenir." },
    { type: "heading", text: "Écartez votre propre machine (15 minutes)" },
    { type: "paragraph", html: "Voici la partie honnête : comme ce plantage survit aux installations propres du système d'exploitation, les étapes ci-dessous ne seront probablement pas ce qui finira par le résoudre. Mais vous voulez quand même les exécuter, en partie pour l'improbable cas où votre situation serait locale, et surtout pour pouvoir dire au support : &laquo;&nbsp;j'ai déjà réinstallé, mis à jour les pilotes et synchronisé l'horloge, et l'écran devient toujours blanc&nbsp;&raquo;. Cela transforme votre ticket d'un &laquo;&nbsp;avez-vous essayé de l'éteindre et de le rallumer&nbsp;&raquo; en un véritable rapport de bug." },
    { type: "heading", text: "Synchronisez l'horloge Windows" },
    { type: "paragraph", html: "Une horloge système désynchronisée rompt la connexion sécurisée dont dépend l'application et peut la mettre dans des états étranges. Allez dans <strong class='text-white'>Settings &rarr; Time &amp; language &rarr; Date &amp; time</strong>, activez <strong class='text-white'>Set time automatically</strong>, et cliquez sur <strong class='text-white'>Sync now</strong>. Rapide, gratuit, et cela élimine toute une catégorie d'instabilités." },
    { type: "heading", text: "Réinstallez l'application de bureau" },
    { type: "paragraph", html: "Dans de rares cas, l'installation de l'application elle-même se corrompt. Désinstallez la copie actuelle, puis téléchargez un nouvel installateur depuis la page officielle de téléchargements de Tradovate (<strong class='text-white'>tradovate.com/devices</strong>) et réinstallez la dernière version. Cela garantit que vous testez avec la version actuelle, ce qui est important, car un correctif est peut-être déjà déployé et vous ne voulez pas signaler un bug déjà corrigé." },
    { type: "heading", text: "Mettez à jour votre pilote graphique" },
    { type: "paragraph", html: "Les pilotes GPU obsolètes ou défectueux sont de loin la cause la plus fréquente d'écrans blancs dans les applications basées sur Chromium, car ce processus de rendu s'appuie sur l'accélération matérielle. Ouvrez <strong class='text-white'>Device Manager &rarr; Display adapters</strong>, faites un clic droit sur votre carte graphique et choisissez <strong class='text-white'>Update driver</strong>, ou récupérez le dernier package directement auprès de votre fabricant de GPU (NVIDIA, AMD ou Intel) et redémarrez. Si un pilote défectueux était en cause, cela le résout complètement. Si l'application devient encore blanche ensuite, vous venez de confirmer que ce n'est pas votre chaîne graphique." },
    { type: "quote", html: "Si l'écran blanc continue de revenir après une synchronisation de l'horloge, une réinstallation propre et un pilote graphique récent, arrêtez de réinstaller des choses. Vous avez fait preuve de diligence, cette combinaison confirme que le défaut vient de l'application, et l'étape suivante est un rapport au support, pas une nouvelle reconstruction." },
    { type: "heading", text: "Continuez à trader pendant qu'elle est instable" },
    { type: "paragraph", html: "Vous n'avez pas à attendre que l'application de bureau se comporte correctement. La <strong class='text-white'>plateforme web sur trader.tradovate.com</strong> fait fonctionner le même compte via votre navigateur et ne dépend pas de la build de bureau qui plante. Comme une défaillance de rendu propre au bureau ne touche pas le navigateur de la même façon, le trader web est votre solution de repli la plus fiable, ouvrez-le dans Chrome ou Edge et vous disposez d'une saisie d'ordres, de graphiques et d'une gestion des positions complets. L'<strong class='text-white'>application mobile</strong> est un bon secours pour une tâche en particulier : clôturer ou ajuster rapidement une position si la fenêtre de bureau devient blanche pendant que vous êtes en direct." },
    { type: "paragraph", html: "Deux mises en garde honnêtes. La connexion de la plateforme web impose une limite de sessions, donc si vous naviguez entre bureau, web et TradingView, déconnectez-vous des sessions que vous n'utilisez pas pour éviter d'être éjecté. Et la vue web mobile est étriquée pour tout ce qui dépasse une sortie rapide ; considérez le téléphone comme une poignée d'urgence, pas comme votre poste de pilotage principal." },
    { type: "heading", text: "Quand ce n'est pas votre machine : signalez-le correctement" },
    { type: "paragraph", html: "Un ticket vague du type &laquo;&nbsp;votre application n'arrête pas de planter&nbsp;&raquo; ne mène nulle part. Un ticket précis et reproductible est escaladé. Lorsque vous contactez le support, donnez-leur tout ce dont ils ont besoin pour le reproduire :" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Numéro de build Windows 11</strong>, exécutez <code>winver</code> depuis le menu Démarrer et copiez la version et le build exacts.",
        "<strong class='text-white'>Version de l'application de bureau</strong>, notez le numéro de build affiché sur l'écran À propos ou paramètres de l'application.",
        "<strong class='text-white'>Horodatages en heure du Centre (Central Time)</strong>, à peu près le moment de chaque plantage, afin qu'ils puissent le rapprocher des journaux serveur.",
        "<strong class='text-white'>Ce que vous faisiez</strong>, chargement d'un graphique, passage d'un ordre, changement d'onglet. Tout schéma les aide à cerner le problème.",
        "<strong class='text-white'>Une capture d'écran</strong> de la fenêtre blanche (oui, même vide, elle confirme le symptôme).",
        "<strong class='text-white'>L'argument décisif</strong>, qu'il persiste après une installation propre du système d'exploitation ou sur une seconde machine. Cette seule ligne leur indique qu'il ne s'agit pas d'un hasard local.",
      ],
    },
    { type: "paragraph", html: "Présentez-le comme &laquo;&nbsp;voici ce que j'ai déjà écarté&nbsp;&raquo;. Le support ne peut pas corriger un bug au niveau de la build que vous signalez comme un mystère, mais il peut prioriser un problème documenté et reproductible." },
    { type: "heading", text: "Ne laissez pas une mise au blanc vous coûter une exécution" },
    { type: "paragraph", html: "La version effrayante de ce plantage est celle qui survient pendant que vous êtes en position et devez agir. Construisez donc votre configuration en tenant compte du fait que la fenêtre peut disparaître à tout instant." },
    { type: "paragraph", html: "La bonne nouvelle : <strong class='text-white'>vos ordres en attente ne se trouvent pas dans cette fenêtre.</strong> Tout stop ou objectif que Tradovate a accepté réside sur ses serveurs et continue de fonctionner que votre application de bureau affiche un écran ou non. Une fenêtre vide ne peut pas gérer votre risque, mais un ordre stop déjà placé sur le marché se moque que votre moniteur soit devenu blanc. La discipline est donc simple : placez un stop ferme sur chaque position <em>au moment même</em> où vous entrez, avant de compter sur la surveillance du trade. Si l'écran meurt, votre protection est déjà en place là où un plantage du client ne peut pas la toucher. Et gardez toujours un second moyen d'accès (web ou mobile) pour pouvoir voir et clôturer depuis un autre appareil." },
    { type: "heading", text: "Dépannage en un coup d'œil" },
    {
      type: "table",
      headers: ["Situation", "Ce que cela signifie", "Que faire"],
      rows: [
        ["La fenêtre devient blanche en pleine session", "Le processus de rendu s'est bloqué", "Appuyez d'abord sur F5 ; si elle reste blanche, fermez complètement et rouvrez l'application"],
        ["Revient, puis redevient blanche", "Bug de la build de l'application, pas un cas isolé", "Écartez votre machine, puis signalez-le avec des détails"],
        ["Continue de planter après une installation propre de Windows", "Confirme que c'est l'application, pas votre PC", "Arrêtez de réinstaller ; envoyez un rapport au support"],
        ["Besoin de trader tout de suite", "La build de bureau n'est pas fiable", "Utilisez trader.tradovate.com dans un navigateur ; mobile pour clôturer"],
        ["Écran vide mais flou/figé avant cela", "Problème possible de pilote GPU", "Mettez à jour le pilote graphique et redémarrez"],
        ["Vous êtes en direct quand elle devient blanche", "Plantage client uniquement, les ordres sont en sécurité", "Confirmez les positions sur web/mobile ; comptez sur votre stop en attente"],
      ],
    },
    { type: "heading", text: "Continuez à trader malgré les plantages grâce à l'automatisation côté serveur" },
    { type: "paragraph", html: "Si une plateforme devenue blanche vous a déjà coûté une entrée ou une sortie propre, la solution consiste à ne plus dépendre d'une seule fenêtre qui reste ouverte. PickMyTrade achemine vos alertes TradingView directement vers Tradovate et exécute les opérations sur nos serveurs, de sorte que votre stratégie continue de se déclencher, que l'application de bureau affiche un écran ou non :" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Exécution côté serveur</strong>, les alertes voyagent de TradingView à Tradovate via notre infrastructure, de sorte qu'une application de bureau à l'écran blanc ne bloque jamais une entrée ou une sortie.",
        "<strong class='text-white'>Indépendance de l'appareil</strong>, rien n'a besoin que la fenêtre de bureau soit ouverte. Votre setup se déclenche à partir de l'alerte, pas à partir du client qui se trouve être actif.",
        "<strong class='text-white'>Des stops et objectifs qui tiennent</strong>, le SL/TP défini dans votre alerte arrive sur Tradovate quoi que fasse votre écran, la protection ne dépend donc jamais du rendu de l'application.",
        "<strong class='text-white'>Synchronisation multi-comptes</strong>, répliquez les mêmes ordres sur tous les comptes connectés à la fois, de sorte que rien ne reste sans gestion pendant que vous redémarrez une plateforme plantée.",
      ],
    },
  ], it: [
    { type: "paragraph", html: "State preparando un ingresso, l'app desktop sfarfalla, e l'intera finestra diventa completamente bianca. Nessun messaggio di errore, nessun cursore che gira, nessuna finestra di dialogo &ldquo;qualcosa è andato storto&rdquo;, solo un riquadro vuoto dove un secondo prima c'erano i vostri grafici e il DOM. Chiudetela, riapritela, e siete di nuovo operativi&hellip; finché non succede di nuovo venti minuti dopo, a volte più volte nella stessa sessione. Se avete perso un setup perché la piattaforma è diventata bianca nel momento sbagliato, sapete già quanto questo faccia male." },
    { type: "paragraph", html: "Ecco la versione breve prima di approfondire: <strong class='text-white'>il ripristino più rapido è chiudere completamente l'app desktop e riaprirla</strong> (provate prima con un aggiornamento F5). E la parte frustrante, il motivo per cui nessun intervento sul vostro PC ha risolto in modo duraturo, è che questo crash continua a comparire su <em>diversi</em> computer Windows 11 e persino su installazioni Windows appena reinstallate. Questo schema significa che quasi certamente si tratta della build dell'app, non del vostro computer. Il vero obiettivo è quindi: ripristinare velocemente, escludere il vostro computer in quindici minuti in modo da poterlo segnalare correttamente, tenere pronta un'alternativa e lasciare che sia il supporto a inseguire la vera soluzione." },
    { type: "quote", html: "<strong class='text-white'>Ripristino rapido:</strong> premete <strong class='text-white'>F5</strong> (o <strong class='text-white'>Fn + F5</strong> su un laptop) per ricaricare la finestra. Se questo non risolve, fate clic destro sull'icona dell'app nella barra delle applicazioni &rarr; <strong class='text-white'>Close window</strong>, quindi riapritela e accedete di nuovo. Il vostro account, gli ordini e le posizioni risiedono tutti lato server, quindi non si perde nulla al riavvio." },
    { type: "heading", text: "Cos'è realmente la schermata bianca" },
    { type: "paragraph", html: "L'app desktop di Tradovate non è un programma separato dalla piattaforma web, è lo stesso trader web racchiuso in un involucro Chromium per poter funzionare come app Windows autonoma. È comodo, ma eredita la modalità di guasto di Chromium: quando il processo di rendering interno si blocca o muore, la finestra non ha nulla da disegnare, quindi diventa completamente bianca invece di tornare a una schermata di accesso pulita. Non c'è alcuna finestra di dialogo di crash perché, tecnicamente, l'app non si è chiusa, è ancora in esecuzione, semplicemente è diventata &ldquo;cieca&rdquo;." },
    { type: "paragraph", html: "Questo particolare sbiancamento è stato segnalato su più di una configurazione Windows 11, un laptop e un desktop in un caso, entrambi con la stessa schermata bianca. Quando lo stesso sintomo vi segue su computer diversi, il filo conduttore non è l'hardware né l'installazione del sistema operativo. È il software che gira sopra di essi." },
    { type: "paragraph", html: "Vale la pena distinguerlo da casi simili: se l'app resta viva ma i vostri grafici diventano vuoti mentre il resto della finestra funziona, si tratta di un problema più lieve di caricamento dati. Se la piattaforma si blocca completamente e diventa nera a metà operazione invece che bianca, si tratta di un guasto diverso, ma correlato. Sintomi diversi, soluzioni parzialmente sovrapposte, ma lo sbiancamento su Win 11 è un caso a sé." },
    { type: "heading", text: "Prima mossa: ripristinare l'app" },
    { type: "paragraph", html: "Quando lo schermo diventa bianco, prima volete che torni a funzionare, poi pensate alla causa. Due passaggi, in ordine:" },
    { type: "heading", text: "1. Aggiornate la finestra (F5)" },
    { type: "paragraph", html: "Premete <strong class='text-white'>F5</strong>, oppure <strong class='text-white'>Fn + F5</strong> se il vostro laptop assegna di default i tasti funzione ai controlli multimediali. Poiché l'app desktop è, sotto il cofano, un browser, F5 la costringe a ricaricarsi come farebbe una pagina web, spesso quanto basta per ridisegnare un riquadro bianco o vuoto senza un riavvio completo. È la soluzione meno invasiva, quindi provatela per prima." },
    { type: "heading", text: "2. Chiudete completamente e riaprite" },
    { type: "paragraph", html: "Se F5 non fa nulla, non limitatevi a minimizzare, questo lascia in esecuzione il processo bloccato. Fate clic destro sull'icona Tradovate nella barra delle applicazioni e scegliete <strong class='text-white'>Close window</strong>, oppure usate Gestione attività per terminare l'app se non risponde, quindi avviatela di nuovo dal menu Start o dal collegamento sul desktop. Accedete di nuovo, e torna a uno stato funzionante in pochi secondi. Questo è il ripristino affidabile, semplicemente non impedisce che il crash si ripresenti." },
    { type: "heading", text: "Escludere il vostro computer (15 minuti)" },
    { type: "paragraph", html: "Ecco la parte onesta: poiché questo crash sopravvive a installazioni pulite del sistema operativo, i passaggi seguenti probabilmente non saranno ciò che alla fine lo risolve. Ma conviene comunque eseguirli, in parte per l'eventualità remota che il vostro caso sia locale, e soprattutto in modo che, quando contattate il supporto, possiate dire: &ldquo;ho già reinstallato, aggiornato i driver e sincronizzato l'orologio, e diventa ancora bianco&rdquo;. Questo trasforma il vostro ticket da &ldquo;avete provato a spegnerlo e riaccenderlo&rdquo; in una vera segnalazione di bug." },
    { type: "heading", text: "Sincronizzare l'orologio di Windows" },
    { type: "paragraph", html: "Un orologio di sistema disallineato interrompe la connessione sicura da cui dipende l'app e può metterla in stati anomali. Andate su <strong class='text-white'>Settings &rarr; Time &amp; language &rarr; Date &amp; time</strong>, attivate <strong class='text-white'>Set time automatically</strong> e fate clic su <strong class='text-white'>Sync now</strong>. Veloce, gratuito, ed elimina un'intera categoria di instabilità." },
    { type: "heading", text: "Reinstallare l'app desktop" },
    { type: "paragraph", html: "In rare occasioni l'installazione stessa dell'app si corrompe. Disinstallate la copia attuale, quindi scaricate un nuovo programma di installazione dalla pagina ufficiale dei download di Tradovate (<strong class='text-white'>tradovate.com/devices</strong>) e reinstallate l'ultima build. Questo garantisce che stiate testando la versione attuale, cosa importante, poiché una correzione potrebbe già essere stata rilasciata e non volete segnalare un bug già risolto." },
    { type: "heading", text: "Aggiornare il driver grafico" },
    { type: "paragraph", html: "I driver GPU obsoleti o difettosi sono di gran lunga la causa più comune di schermate vuote nelle app basate su Chromium, perché quel processo di rendering si affida all'accelerazione hardware. Aprite <strong class='text-white'>Device Manager &rarr; Display adapters</strong>, fate clic destro sulla vostra scheda grafica e scegliete <strong class='text-white'>Update driver</strong>, oppure scaricate l'ultimo pacchetto direttamente dal produttore della GPU (NVIDIA, AMD o Intel) e riavviate. Se il colpevole era un driver difettoso, questo risolve il problema all'istante. Se l'app diventa ancora bianca in seguito, avete appena confermato che non è la vostra catena grafica." },
    { type: "quote", html: "Se la schermata bianca continua a ripresentarsi dopo una sincronizzazione dell'orologio, una reinstallazione pulita e un driver grafico aggiornato, smettete di reinstallare cose. Avete fatto la vostra parte, questa combinazione conferma che il problema è lato app, e il passo successivo è una segnalazione al supporto, non un'altra ricostruzione." },
    { type: "heading", text: "Continuare a fare trading mentre è instabile" },
    { type: "paragraph", html: "Non dovete restare ad aspettare che l'app desktop torni a comportarsi bene. La <strong class='text-white'>piattaforma web su trader.tradovate.com</strong> esegue lo stesso account tramite il vostro browser e non dipende dalla build desktop che si sta bloccando. Poiché un guasto di rendering specifico del desktop non colpisce il browser allo stesso modo, il trader web è la vostra alternativa più affidabile: apritelo in Chrome o Edge e avrete inserimento ordini completo, grafici e gestione delle posizioni. L'<strong class='text-white'>app mobile</strong> è un valido supporto per un compito in particolare: chiudere o modificare rapidamente una posizione se la finestra desktop diventa vuota mentre siete operativi." },
    { type: "paragraph", html: "Due avvertenze oneste. L'accesso alla piattaforma web impone un limite di sessioni, quindi se passate tra desktop, web e TradingView, disconnettetevi dalle sessioni che non state usando per evitare di essere espulsi. E la visualizzazione web mobile è angusta per qualsiasi cosa oltre a un'uscita rapida; trattate il telefono come una leva di emergenza, non come la vostra postazione principale." },
    { type: "heading", text: "Quando non è il vostro computer: segnalatelo nel modo giusto" },
    { type: "paragraph", html: "Un ticket generico del tipo &ldquo;la vostra app continua a bloccarsi&rdquo; non porta a nulla. Uno specifico e riproducibile viene invece escalato. Quando contattate il supporto, fornite loro tutto ciò di cui hanno bisogno per riprodurlo:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Numero di build di Windows 11</strong>, eseguite <code>winver</code> dal menu Start e copiate la versione e la build esatte.",
        "<strong class='text-white'>Versione dell'app desktop</strong>, annotate il numero di build mostrato nella schermata Info o impostazioni dell'app.",
        "<strong class='text-white'>Orari in Central Time</strong>, all'incirca quando si è verificato ogni crash, in modo che possano confrontarlo con i log del server.",
        "<strong class='text-white'>Cosa stavate facendo</strong>, caricare un grafico, inserire un ordine, cambiare scheda. Qualsiasi schema li aiuta a circoscrivere il problema.",
        "<strong class='text-white'>Uno screenshot</strong> della finestra bianca (sì, anche uno vuoto, conferma il sintomo).",
        "<strong class='text-white'>L'elemento decisivo</strong>, che persiste dopo un'installazione pulita del sistema operativo o su un secondo computer. Questa singola riga dice loro che non è un caso isolato locale.",
      ],
    },
    { type: "paragraph", html: "Presentatelo come &ldquo;ecco cosa ho già escluso&rdquo;. Il supporto non può risolvere un bug a livello di build che segnalate come un mistero, ma può dare priorità a uno documentato e riproducibile." },
    { type: "heading", text: "Non lasciate che uno sbiancamento vi costi un'esecuzione" },
    { type: "paragraph", html: "La versione spaventosa di questo crash è quella che colpisce mentre siete in un'operazione e dovete agire. Costruite quindi la vostra configurazione tenendo conto del fatto che la finestra può sparire in qualsiasi momento." },
    { type: "paragraph", html: "La buona notizia: <strong class='text-white'>i vostri ordini in attesa non risiedono in quella finestra.</strong> Qualsiasi stop o target che Tradovate ha accettato si trova sui suoi server e continua a funzionare indipendentemente dal fatto che la vostra app desktop stia disegnando uno schermo o meno. Una finestra vuota non può gestire il vostro rischio, ma un ordine stop già piazzato sulla borsa non si cura del fatto che il vostro monitor sia diventato bianco. Quindi la disciplina è semplice: piazzate uno stop rigido su ogni posizione <em>nel momento</em> in cui entrate, prima di affidarvi all'osservazione dell'operazione. Se lo schermo muore, la vostra protezione è già al sicuro dove un crash del client non può toccarla. E tenete sempre pronta una seconda via d'accesso (web o mobile) in modo da poter vedere e chiudere da un altro dispositivo." },
    { type: "heading", text: "Risoluzione dei problemi a colpo d'occhio" },
    {
      type: "table",
      headers: ["Situazione", "Cosa significa", "Cosa fare"],
      rows: [
        ["La finestra sfarfalla in bianco a metà sessione", "Il processo di rendering si è bloccato", "Premete prima F5; se resta vuota, chiudete completamente e riaprite l'app"],
        ["Torna, poi diventa nuovamente bianca", "Bug della build dell'app, non un caso isolato", "Escludete il vostro computer, poi segnalatelo con i dettagli"],
        ["Continua a bloccarsi dopo un'installazione pulita di Windows", "Conferma che è l'app, non il vostro PC", "Smettete di reinstallare; inviate una segnalazione al supporto"],
        ["Dovete fare trading adesso", "La build desktop non è affidabile", "Usate trader.tradovate.com in un browser; il mobile per chiudere"],
        ["Schermo vuoto ma sfocato/non aggiornato prima", "Possibile problema del driver GPU", "Aggiornate il driver grafico e riavviate"],
        ["Siete operativi quando diventa bianca", "Solo crash del client, gli ordini sono al sicuro", "Confermate le posizioni su web/mobile; affidatevi al vostro stop in attesa"],
      ],
    },
    { type: "heading", text: "Continuate a fare trading nonostante i crash con l'automazione lato server" },
    { type: "paragraph", html: "Se una piattaforma diventata bianca vi è mai costata un ingresso o un'uscita pulita, la soluzione è smettere di dipendere dal fatto che una singola finestra resti aperta. PickMyTrade instrada i vostri alert di TradingView direttamente a Tradovate ed esegue l'operazione sui nostri server, così la vostra strategia continua ad attivarsi indipendentemente dal fatto che l'app desktop stia disegnando uno schermo:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Esecuzione lato server</strong>, gli alert viaggiano da TradingView a Tradovate attraverso la nostra infrastruttura, così un'app desktop con schermo bianco non blocca mai un ingresso o un'uscita.",
        "<strong class='text-white'>Indipendenza dal dispositivo</strong>, nulla richiede che la finestra desktop sia aperta. Il vostro setup si attiva dall'alert, non dal client che al momento è attivo.",
        "<strong class='text-white'>Stop e target che restano validi</strong>, lo SL/TP definito nel vostro alert arriva a Tradovate indipendentemente da cosa stia facendo il vostro schermo, così la protezione non dipende mai dal rendering dell'app.",
        "<strong class='text-white'>Sincronizzazione multi-account</strong>, replicate gli stessi ordini su ogni account collegato contemporaneamente, così nulla resta senza gestione mentre riavviate una piattaforma bloccata.",
      ],
    },
  ] },
  ctaHeading: { en: "Trade Without Depending on One Window", de: "Handeln, ohne von einem einzelnen Fenster abhängig zu sein", es: "Opere sin depender de una sola ventana", fr: "Tradez sans dépendre d'une seule fenêtre", it: "Fai trading senza dipendere da una sola finestra" },
  ctaText: { en: "Link your alerts to Tradovate and keep trading even when the desktop app whites out.", de: "Verknüpfen Sie Ihre Alerts mit Tradovate und handeln Sie weiter, selbst wenn die Desktop-App weiß wird.", es: "Conecte sus alertas con Tradovate y siga operando incluso cuando la aplicación de escritorio se ponga en blanco.", fr: "Reliez vos alertes à Tradovate et continuez à trader même quand l'application de bureau devient blanche.", it: "Collega i tuoi alert a Tradovate e continua a fare trading anche quando l'app desktop diventa bianca." },
  ctaButtonText: { en: "Start Your Free 7-Day Trial", de: "Starten Sie Ihre kostenlose 5-Tage-Testversion", es: "Inicie su prueba gratuita de 5 días", fr: "Démarrez votre essai gratuit de 5 jours", it: "Avvia la tua prova gratuita di 5 giorni" },
  ctaUrl: "https://app.pickmytrade.trade/?register=true&utm_source=content&utm_medium=debugging",
  faqHeading: { en: "Frequently Asked Questions", de: "Häufig gestellte Fragen", es: "Preguntas frecuentes", fr: "Questions fréquentes", it: "Domande frequenti" },
  faqs: { en: [
    { q: "How do I recover the Tradovate desktop app when it goes white?", a: "Press F5 (or Fn+F5 on laptops) to force the window to reload. If the white pane doesn't come back, close the desktop app completely, right-click its taskbar icon and choose Close window, not just minimize, then reopen it and sign back in. The app comes back to a working state within seconds, though the crash tends to return later in the same session." },
    { q: "Why does Tradovate desktop crash to a white screen on Windows 11?", a: "The desktop app is a Chromium-based wrapper around the web platform. A white screen means the render process stalled or died, so the window paints nothing instead of your charts and DOM. Because the same crash shows up on multiple Windows 11 machines and even on brand-new clean OS installs, it points to a problem in the app build itself rather than any single computer." },
    { q: "Will a clean Windows install or a new PC fix the white screen?", a: "Not reliably. The crash has persisted after fresh Windows 11 installs and on a brand-new dedicated trading machine, which is strong evidence it isn't a corrupted local setup. Rebuilding your PC is a lot of work for a fix that may not hold. Rule out your machine with a quick checklist, then report it to support instead of reinstalling the whole OS." },
    { q: "Can I keep trading while the desktop app keeps crashing?", a: "Yes. Log in to the web platform at trader.tradovate.com in a browser, or use the mobile app, to reach the exact same account and orders. A desktop-specific render crash doesn't take down the browser build the same way, so the web platform is the most dependable fallback while the desktop app is unstable." },
    { q: "Could my graphics card be causing the white screen?", a: "It's worth ruling out, because outdated or buggy GPU drivers are a classic cause of blank screens in Chromium-based apps. Update your graphics driver through Windows Update or the vendor's tool and reboot. But if the app still goes white afterward, and especially if it already did so on a clean install, the driver isn't the root cause, and the fault is on the app side." },
    { q: "What should I include when I report the crash to support?", a: "Give them enough to reproduce it: your Windows 11 build number, the desktop app version, timestamps in Central Time of when it crashed, what you were doing at the moment (loading a chart, placing an order), a screenshot of the white window, and the key detail that it persists across a clean OS install or a second machine. The more specific the report, the faster it gets escalated." },
    { q: "Does the white screen cancel my open orders or stops?", a: "No. Working stop and target orders that Tradovate accepted rest on its servers, not inside the desktop window. A client crash doesn't cancel them. Still, confirm your positions from the web or mobile app right away, because you can't manage what you can't see while the desktop window is blank." },
  ], de: [
    { q: "Wie stelle ich die Tradovate-Desktop-App wieder her, wenn sie weiß wird?", a: "Drücken Sie F5 (oder Fn+F5 auf Laptops), um das Fenster zum Neuladen zu zwingen. Kehrt die weiße Fläche nicht zurück, schließen Sie die Desktop-App vollständig, klicken Sie mit der rechten Maustaste auf ihr Taskleistensymbol und wählen Sie Close window statt nur zu minimieren, öffnen Sie sie dann neu und melden Sie sich wieder an. Die App kehrt innerhalb weniger Sekunden in einen funktionierenden Zustand zurück, wobei der Absturz später in derselben Sitzung tendenziell erneut auftritt." },
    { q: "Warum stürzt Tradovate Desktop unter Windows 11 zu einem weißen Bildschirm ab?", a: "Die Desktop-App ist eine auf Chromium basierende Hülle um die Web-Plattform. Ein weißer Bildschirm bedeutet, dass der Render-Prozess ins Stocken geraten oder abgestürzt ist, sodass das Fenster nichts zeichnet statt Ihrer Charts und des DOM. Da derselbe Absturz auf mehreren Windows-11-Rechnern und sogar auf brandneuen, sauberen Betriebssysteminstallationen auftritt, deutet das auf ein Problem im App-Build selbst hin, nicht auf einen einzelnen Computer." },
    { q: "Behebt eine saubere Windows-Installation oder ein neuer PC den weißen Bildschirm?", a: "Nicht zuverlässig. Der Absturz ist auch nach frischen Windows-11-Installationen und auf einem brandneuen, dedizierten Handelsrechner aufgetreten, was ein starkes Indiz dafür ist, dass es kein beschädigtes lokales Setup ist. Ihren PC neu aufzusetzen, ist viel Aufwand für eine Lösung, die vielleicht nicht hält. Schließen Sie Ihren Rechner mit einer kurzen Checkliste aus, und melden Sie es dann dem Support, statt das gesamte Betriebssystem neu zu installieren." },
    { q: "Kann ich weiterhandeln, während die Desktop-App weiterhin abstürzt?", a: "Ja. Melden Sie sich in einem Browser auf der Web-Plattform unter trader.tradovate.com an, oder nutzen Sie die mobile App, um genau dasselbe Konto und dieselben Orders zu erreichen. Ein desktopspezifischer Render-Absturz beeinträchtigt den Browser-Build nicht auf dieselbe Weise, sodass die Web-Plattform die zuverlässigste Ausweichlösung ist, solange die Desktop-App instabil ist." },
    { q: "Könnte meine Grafikkarte den weißen Bildschirm verursachen?", a: "Es lohnt sich, das auszuschließen, denn veraltete oder fehlerhafte GPU-Treiber sind eine klassische Ursache für leere Bildschirme in Chromium-basierten Apps. Aktualisieren Sie Ihren Grafiktreiber über Windows Update oder das Tool des Herstellers und starten Sie neu. Wird die App danach aber immer noch weiß, und besonders wenn das bereits bei einer sauberen Installation der Fall war, ist der Treiber nicht die Grundursache, und der Fehler liegt auf der App-Seite." },
    { q: "Was sollte ich angeben, wenn ich den Absturz dem Support melde?", a: "Geben Sie ihm genug, um ihn nachzustellen: Ihre Windows-11-Build-Nummer, die Version der Desktop-App, Zeitstempel in Central Time, wann er auftrat, was Sie gerade taten (Chart laden, Order platzieren), einen Screenshot des weißen Fensters und den entscheidenden Punkt, dass er auch bei sauberer Betriebssysteminstallation oder auf einem zweiten Rechner bestehen bleibt. Je konkreter der Bericht, desto schneller wird er eskaliert." },
    { q: "Storniert der weiße Bildschirm meine offenen Orders oder Stops?", a: "Nein. Aktive Stop- und Zielorders, die Tradovate akzeptiert hat, liegen auf dessen Servern, nicht im Desktop-Fenster. Ein Client-Absturz storniert sie nicht. Bestätigen Sie Ihre Positionen dennoch sofort über die Web- oder mobile App, denn Sie können nicht managen, was Sie nicht sehen können, während das Desktop-Fenster leer ist." },
  ], es: [
    { q: "¿Cómo recupero la aplicación de escritorio de Tradovate cuando se pone en blanco?", a: "Pulse F5 (o Fn+F5 en portátiles) para forzar la recarga de la ventana. Si el panel blanco no vuelve, cierre la aplicación de escritorio por completo, haga clic derecho en su icono de la barra de tareas y elija Close window, no solo minimizar, luego vuelva a abrirla e inicie sesión de nuevo. La app vuelve a un estado funcional en cuestión de segundos, aunque el bloqueo tiende a repetirse más tarde en la misma sesión." },
    { q: "¿Por qué la aplicación de escritorio de Tradovate se bloquea con una pantalla blanca en Windows 11?", a: "La aplicación de escritorio es un envoltorio basado en Chromium alrededor de la plataforma web. Una pantalla blanca significa que el proceso de renderizado se detuvo o murió, así que la ventana no dibuja nada en lugar de sus gráficos y el DOM. Como el mismo bloqueo aparece en varios equipos con Windows 11 e incluso en instalaciones limpias del sistema operativo recién hechas, apunta a un problema en el propio build de la aplicación y no en un equipo concreto." },
    { q: "¿Solucionará una instalación limpia de Windows o un PC nuevo la pantalla blanca?", a: "No de forma fiable. El bloqueo ha persistido tras instalaciones nuevas de Windows 11 y en un equipo de trading dedicado y completamente nuevo, lo que es una fuerte evidencia de que no se trata de una configuración local corrupta. Reconstruir su PC supone mucho trabajo para una solución que puede no mantenerse. Descarte su equipo con una lista de verificación rápida, y luego repórtelo a soporte en lugar de reinstalar todo el sistema operativo." },
    { q: "¿Puedo seguir operando mientras la aplicación de escritorio sigue bloqueándose?", a: "Sí. Inicie sesión en la plataforma web en trader.tradovate.com en un navegador, o use la app móvil, para acceder exactamente a la misma cuenta y órdenes. Un fallo de renderizado específico del escritorio no afecta al build del navegador de la misma manera, así que la plataforma web es la alternativa más fiable mientras la aplicación de escritorio esté inestable." },
    { q: "¿Podría mi tarjeta gráfica estar causando la pantalla blanca?", a: "Vale la pena descartarlo, porque los controladores de GPU desactualizados o defectuosos son una causa clásica de pantallas en blanco en las apps basadas en Chromium. Actualice su controlador gráfico mediante Windows Update o la herramienta del fabricante y reinicie. Pero si la app sigue poniéndose en blanco después, y especialmente si ya lo hacía en una instalación limpia, el controlador no es la causa raíz, y el fallo está del lado de la app." },
    { q: "¿Qué debo incluir al reportar el bloqueo a soporte?", a: "Deles lo suficiente para reproducirlo: su número de build de Windows 11, la versión de la aplicación de escritorio, marcas de hora en hora central de cuándo ocurrió, qué estaba haciendo en ese momento (cargando un gráfico, colocando una orden), una captura de pantalla de la ventana blanca, y el detalle clave de que persiste tanto en una instalación limpia del sistema operativo como en un segundo equipo. Cuanto más específico sea el reporte, más rápido se escala." },
    { q: "¿La pantalla blanca cancela mis órdenes abiertas o stops?", a: "No. Las órdenes de stop y objetivo activas que Tradovate haya aceptado residen en sus servidores, no dentro de la ventana de escritorio. Un fallo del cliente no las cancela. Aun así, confirme sus posiciones desde la app web o móvil de inmediato, porque no puede gestionar lo que no puede ver mientras la ventana de escritorio está en blanco." },
  ], fr: [
    { q: "Comment récupérer l'application de bureau Tradovate quand elle devient blanche ?", a: "Appuyez sur F5 (ou Fn+F5 sur les ordinateurs portables) pour forcer le rechargement de la fenêtre. Si le panneau blanc ne revient pas, fermez complètement l'application de bureau, faites un clic droit sur son icône dans la barre des tâches et choisissez Close window, pas seulement réduire, puis rouvrez-la et reconnectez-vous. L'application revient à un état fonctionnel en quelques secondes, bien que le plantage ait tendance à revenir plus tard dans la même session." },
    { q: "Pourquoi Tradovate desktop plante-t-il en écran blanc sous Windows 11 ?", a: "L'application de bureau est une enveloppe basée sur Chromium autour de la plateforme web. Un écran blanc signifie que le processus de rendu s'est bloqué ou a planté, donc la fenêtre ne dessine rien au lieu de vos graphiques et du DOM. Comme le même plantage apparaît sur plusieurs machines Windows 11 et même sur des installations toutes neuves du système d'exploitation, cela pointe vers un problème dans la build de l'application elle-même plutôt que dans un ordinateur en particulier." },
    { q: "Une installation propre de Windows ou un nouveau PC résoudra-t-il l'écran blanc ?", a: "Pas de manière fiable. Le plantage a persisté après des installations neuves de Windows 11 et sur une machine de trading dédiée toute neuve, ce qui constitue une forte preuve qu'il ne s'agit pas d'une configuration locale corrompue. Reconstruire votre PC représente beaucoup de travail pour une solution qui pourrait ne pas tenir. Écartez votre machine avec une liste de contrôle rapide, puis signalez-le au support plutôt que de réinstaller tout le système d'exploitation." },
    { q: "Puis-je continuer à trader pendant que l'application de bureau continue de planter ?", a: "Oui. Connectez-vous à la plateforme web sur trader.tradovate.com dans un navigateur, ou utilisez l'application mobile, pour accéder exactement au même compte et aux mêmes ordres. Un plantage de rendu spécifique au bureau n'affecte pas la build du navigateur de la même façon, donc la plateforme web est la solution de repli la plus fiable tant que l'application de bureau est instable." },
    { q: "Ma carte graphique pourrait-elle causer l'écran blanc ?", a: "Cela vaut la peine de l'écarter, car des pilotes GPU obsolètes ou défectueux sont une cause classique d'écrans blancs dans les applications basées sur Chromium. Mettez à jour votre pilote graphique via Windows Update ou l'outil du fabricant et redémarrez. Mais si l'application devient encore blanche ensuite, et surtout si c'était déjà le cas sur une installation propre, le pilote n'est pas la cause profonde, et le défaut vient de l'application." },
    { q: "Que dois-je inclure quand je signale le plantage au support ?", a: "Donnez-leur de quoi le reproduire : votre numéro de build Windows 11, la version de l'application de bureau, les horodatages en heure du Centre du moment où il s'est produit, ce que vous faisiez à ce moment-là (chargement d'un graphique, passage d'un ordre), une capture d'écran de la fenêtre blanche, et le détail clé qu'il persiste sur une installation propre du système d'exploitation ou sur une seconde machine. Plus le rapport est précis, plus vite il est escaladé." },
    { q: "L'écran blanc annule-t-il mes ordres ouverts ou mes stops ?", a: "Non. Les ordres stop et objectif actifs que Tradovate a acceptés résident sur ses serveurs, pas dans la fenêtre de bureau. Un plantage du client ne les annule pas. Néanmoins, confirmez vos positions immédiatement depuis l'application web ou mobile, car vous ne pouvez pas gérer ce que vous ne pouvez pas voir tant que la fenêtre de bureau est vide." },
  ], it: [
    { q: "Come ripristino l'app desktop di Tradovate quando diventa bianca?", a: "Premete F5 (o Fn+F5 sui laptop) per forzare il ricaricamento della finestra. Se il riquadro bianco non torna, chiudete completamente l'app desktop, fate clic destro sulla sua icona nella barra delle applicazioni e scegliete Close window, non semplicemente minimizzare, quindi riapritela e accedete di nuovo. L'app torna a uno stato funzionante in pochi secondi, anche se il crash tende a ripresentarsi più tardi nella stessa sessione." },
    { q: "Perché Tradovate desktop si blocca con una schermata bianca su Windows 11?", a: "L'app desktop è un involucro basato su Chromium attorno alla piattaforma web. Una schermata bianca significa che il processo di rendering si è bloccato o è morto, quindi la finestra non disegna nulla al posto dei vostri grafici e del DOM. Poiché lo stesso crash compare su più computer Windows 11 e persino su installazioni del sistema operativo appena reinstallate, indica un problema nella build dell'app stessa piuttosto che in un singolo computer." },
    { q: "Un'installazione pulita di Windows o un nuovo PC risolveranno la schermata bianca?", a: "Non in modo affidabile. Il crash è persistito dopo installazioni nuove di Windows 11 e su un computer da trading dedicato e completamente nuovo, il che è una forte prova che non si tratta di una configurazione locale corrotta. Ricostruire il vostro PC è molto lavoro per una soluzione che potrebbe non reggere. Escludete il vostro computer con una checklist rapida, quindi segnalatelo al supporto invece di reinstallare l'intero sistema operativo." },
    { q: "Posso continuare a fare trading mentre l'app desktop continua a bloccarsi?", a: "Sì. Accedete alla piattaforma web su trader.tradovate.com in un browser, oppure usate l'app mobile, per raggiungere esattamente lo stesso account e gli stessi ordini. Un crash di rendering specifico del desktop non colpisce la build del browser allo stesso modo, quindi la piattaforma web è l'alternativa più affidabile finché l'app desktop è instabile." },
    { q: "La mia scheda grafica potrebbe causare la schermata bianca?", a: "Vale la pena escluderlo, perché i driver GPU obsoleti o difettosi sono una causa classica di schermate vuote nelle app basate su Chromium. Aggiornate il driver grafico tramite Windows Update o lo strumento del produttore e riavviate. Ma se l'app diventa ancora bianca in seguito, e soprattutto se lo faceva già su un'installazione pulita, il driver non è la causa principale, e il problema è lato app." },
    { q: "Cosa dovrei includere quando segnalo il crash al supporto?", a: "Fornite loro abbastanza per riprodurlo: il vostro numero di build di Windows 11, la versione dell'app desktop, gli orari in Central Time di quando si è verificato, cosa stavate facendo in quel momento (caricare un grafico, inserire un ordine), uno screenshot della finestra bianca, e il dettaglio chiave che persiste sia su un'installazione pulita del sistema operativo sia su un secondo computer. Più specifica è la segnalazione, più velocemente viene escalata." },
    { q: "La schermata bianca annulla i miei ordini aperti o gli stop?", a: "No. Gli ordini stop e target attivi che Tradovate ha accettato risiedono sui suoi server, non dentro la finestra desktop. Un crash del client non li annulla. Tuttavia, confermate subito le vostre posizioni dall'app web o mobile, perché non potete gestire ciò che non potete vedere finché la finestra desktop è vuota." },
  ] },
