---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "api-rate-limit-429";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/debugging/${SLUG}`;

const META_TITLE = "Tradovate API 429 Too Many Requests Rate Limit";
const META_DESCRIPTION =
  "Fix the Tradovate API 429 Too Many Requests error: throttle under the rate caps, honor p-ticket wait times, and request a reset to trade again fast.";

// Short SEO title (<=60 chars) for locales where the shared h1 is too long for a SERP title.
const TITLE_OVERRIDE: Partial<Record<Locale, string>> = { es: "Tradovate API 429 Too Many Requests: cómo solucionarlo", fr: "API Tradovate : corriger l'erreur 429 Too Many Requests", it: "API Tradovate: risolvere l'errore 429 Too Many Requests" };

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate API", de: "Tradovate API", es: "Tradovate API", fr: "Tradovate API", it: "Tradovate API" },
  h1: { en: META_TITLE, de: "Tradovate API 429 Too Many Requests Rate Limit beheben", es: "Cómo solucionar el error 429 Too Many Requests (límite de velocidad) de la API de Tradovate", fr: "Corriger l'erreur 429 Too Many Requests (limite de débit) de l'API Tradovate", it: "Come risolvere l'errore 429 Too Many Requests (limite di frequenza) dell'API Tradovate" },
  dek: { en: "A wall of 429s stops every new order, modification, and cancellation at once. Here's what triggers Tradovate's rate limit, how to read the p-ticket recovery fields, and how to throttle traffic so it never fires.", de: "Eine Wand aus 429-Fehlern stoppt gleichzeitig jede neue Order, Änderung und Stornierung. Hier erfahren Sie, was Tradovates Rate Limit auslöst, wie Sie die p-ticket-Wiederherstellungsfelder lesen und wie Sie den Traffic drosseln, damit es gar nicht erst so weit kommt.", es: "Un muro de errores 429 detiene al instante cada nueva orden, modificación y cancelación. Esto es lo que activa el límite de velocidad de Tradovate, cómo leer los campos de recuperación p-ticket y cómo limitar el tráfico para que nunca se dispare.", fr: "Un mur d'erreurs 429 bloque instantanément chaque nouvel ordre, modification et annulation. Voici ce qui déclenche la limite de débit de Tradovate, comment lire les champs de récupération p-ticket, et comment limiter le trafic pour qu'elle ne se déclenche jamais.", it: "Un muro di errori 429 blocca all'istante ogni nuovo ordine, modifica e cancellazione. Ecco cosa attiva il limite di frequenza di Tradovate, come leggere i campi di recupero p-ticket e come limitare il traffico affinché non scatti mai." },
  readTime: { en: "7 min read", de: "7 Minuten Lesezeit", es: "Lectura de 7 minutos", fr: "Lecture de 7 minutes", it: "Lettura di 7 minuti" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "When you're automating fast movers like ES or NQ through the Tradovate API, nothing kills a strategy quicker than a wall of <strong class='text-white'>429: Too Many Requests</strong> responses. The moment your bot, copier, or TradingView-to-Tradovate bridge crosses Tradovate's request ceiling, everything stops at once, new orders, modifications, cancellations. Worse, a follow-on <strong class='text-white'>p-ticket</strong> time penalty or a <strong class='text-white'>p-captcha</strong> lockout can keep you sidelined far longer than the trade window you were chasing. It bites hardest on a volatile open, when one alert fans out across several accounts and each leg counts as its own request. Here's what the 429 actually means in 2026, why it fires, and how to throttle, queue, and recover, plus how PickMyTrade paces API traffic so your orders don't bounce in the first place." },
    {
      type: "checklist",
      heading: "Quick Checklist for the Tradovate 429 Rate Limit",
      items: [
        "<strong class='text-white'>Stop retrying immediately.</strong> Hammering the API during a lockout can extend the block instead of clearing it.",
        "<strong class='text-white'>Read the <code>p-time</code> value.</strong> It tells you the exact number of seconds to wait before your next call.",
        "<strong class='text-white'>Resend with the <code>p-ticket</code>.</strong> Include the returned token in your retry body so the request is accepted.",
        "<strong class='text-white'>Throttle under the caps.</strong> Design against roughly 80 requests per minute and 5,000 per hour on a rolling window, and confirm the current numbers in Tradovate's API docs.",
        "<strong class='text-white'>Queue order flow server-side.</strong> Space out modifications and multi-account fan-out instead of bursting.",
        "<strong class='text-white'>Request a manual reset.</strong> If you're locked out, contact Tradovate Support with your username rather than retrying.",
      ],
    },
    { type: "heading", text: "What “429: Too Many Requests” Means" },
    { type: "paragraph", html: "The HTTP <strong class='text-white'>429 Too Many Requests</strong> status is Tradovate telling you your application has sent more requests than its API will accept inside a given window. Tradovate throttles on a per-second, per-minute, and per-hour basis. The instant any one of those ceilings is reached, the server stops handling new commands and answers with a 429 until the window rolls forward." },
    { type: "paragraph", html: "There's an important wrinkle here: Tradovate's own developer FAQ states there is <strong class='text-white'>no fixed &ldquo;hard cap.&rdquo;</strong> The thresholds are deliberately variable and can tighten under load or for security reasons. A safe working ceiling to design against is roughly <strong class='text-white'>80 requests per minute and 5,000 requests per hour on a rolling 60-minute window</strong>, but treat that as a moving target, not a promise. Because the exact limits change over time, always confirm against the current Tradovate API documentation." },
    { type: "paragraph", html: "The key thing to internalize: the limit is about <strong class='text-white'>request volume, not order volume</strong>. Logins, order placement, modifications, cancellations, and position-sync polling all count. Copy one TradingView alert to five accounts and that's five requests, so a strategy that looks modest on paper can burn through the ceiling fast when it's mirrored across accounts or leaning heavily on trailing stops." },
    { type: "heading", text: "Top Causes of the Tradovate 429 Rate Limit in 2026" },
    { type: "heading", text: "1. Bursting past the per-minute or hourly ceiling" },
    { type: "paragraph", html: "Firing a rapid cluster of calls, a batch of entries, targets, and stops back-to-back, is the classic trigger. And because the hourly cap runs on a rolling 60-minute window, one heavy burst can keep you throttled long after the activity itself has stopped." },
    { type: "heading", text: "2. Fan-out across multiple accounts (copy trading)" },
    { type: "paragraph", html: "Copy trading multiplies every action. One alert copied to five accounts equals five requests, and a stop-and-target bracket on each account multiplies that again. High account counts are the single most common reason automated traders trip the limit." },
    { type: "heading", text: "3. Excessive order modifications and trailing stops" },
    { type: "paragraph", html: "Trailing stops and frequent price tweaks generate a steady stream of modify requests per account. Run several of those in parallel and the per-minute ceiling shows up quickly." },
    { type: "heading", text: "4. Aggressive reconnection or polling loops" },
    { type: "paragraph", html: "Bots that reconnect over and over, or poll for fills and positions on a tight timer, quietly eat your quota even when no orders are going out. Reconnecting in a loop after a failure is especially expensive." },
    { type: "heading", text: "5. Repeated failed logins triggering p-captcha" },
    { type: "paragraph", html: "Too many failed authentication attempts can return a <strong class='text-white'><code>p-captcha</code></strong> flag, which means a third-party (non-browser) application can't complete the request. In practice that usually means waiting about an hour before trying again." },
    { type: "heading", text: "How to Fix the Tradovate 429 Rate Limit: Step-by-Step" },
    { type: "heading", text: "Reading the p-ticket, p-time, and p-captcha response" },
    { type: "paragraph", html: "When Tradovate throttles you, the response body carries the recovery instructions. Handle it in this order:" },
    {
      type: "steps",
      items: [
        { title: "Check for p-time", html: "Check for <strong class='text-white'><code>p-time</code></strong>, the time in seconds before you can make a request again. Wait that many seconds; don't retry sooner." },
        { title: "Resend with p-ticket", html: "Resend the original request with <strong class='text-white'><code>p-ticket</code></strong> added as an extra field in the request body. The ticket is what tells Tradovate this retry is the sanctioned one." },
        { title: "Stop on p-captcha", html: "If you instead see <strong class='text-white'><code>p-captcha</code></strong>, stop, a headless or third-party app can't solve it. Wait about an hour, then confirm your credentials are correct before authenticating again." },
      ],
    },
    { type: "heading", text: "Throttling and queueing your requests" },
    { type: "paragraph", html: "The durable fix is to stop bursting and pace the traffic:" },
    {
      type: "steps",
      items: [
        { title: "Cap your outbound rate", html: "Cap your outbound rate below the observed ceiling and add a small delay between calls so a spike never lands them all in the same second." },
        { title: "Queue and stagger multi-account fan-out", html: "Queue order flow server-side and stagger multi-account fan-out so accounts are served in sequence rather than all at once." },
        { title: "Cut avoidable calls", html: "Cut avoidable calls: reduce order modifications, trim trailing-stop churn, and consider an execution mode that converts working orders to market orders where it makes sense, fewer modify calls means fewer requests." },
        { title: "Replace polling with WebSocket updates", html: "Replace tight polling loops with event-driven WebSocket updates so you're not spending quota just to watch for fills." },
      ],
    },
    { type: "heading", text: "Requesting a manual reset from Tradovate" },
    { type: "paragraph", html: "If the block hangs on or a p-ticket penalty just won't clear, don't keep retrying, that can drag it out. Wait out the cooldown (often up to about 60 minutes for the rolling window to clear), then, if you're still locked out, contact Tradovate Support at <strong class='text-white'>312-283-3100</strong> or <strong class='text-white'>support@tradovate.com</strong> with your username and ask for a manual API-limit reset. Support can lift the penalty when a cooldown alone won't." },
    { type: "heading", text: "Troubleshooting Table" },
    {
      type: "table",
      headers: ["Error / signal", "What it means", "Fix"],
      rows: [
        ["429 Too Many Requests", "You exceeded the per-second, per-minute, or hourly request ceiling", "Stop sending, wait for the rolling window, then throttle future traffic"],
        ["p-ticket in response", "A penalty token you must echo back on retry", "Resend the original request with p-ticket in the body"],
        ["p-time in response", "Seconds to wait before the next request is allowed", "Sleep for p-time seconds, then retry with the ticket"],
        ["p-captcha in response", "A third-party app can't complete the request (often after bad logins)", "Wait about an hour, verify credentials, then re-authenticate"],
        ["Locked out for many minutes", "Repeated violations escalated into an extended penalty", "Wait out the cooldown; if still blocked, ask Tradovate Support for a manual reset"],
        ["Limit tripped with few orders", "Copy fan-out or modifications multiplied your request count", "Stagger accounts, cut modifications, and queue order flow"],
      ],
    },
    { type: "heading", text: "Prevent This with PickMyTrade" },
    { type: "paragraph", html: "PickMyTrade sits between your TradingView alerts and Tradovate, and it's built to respect the API's limits instead of fighting them:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Rate-Limit-Safe Routing</strong>, spaces out order flow so calls stay under the per-minute and hourly ceilings and never arrive in a single burst.",
        "<strong class='text-white'>Server-Side Queueing</strong>, batches and staggers multi-account fan-out rather than firing every leg at once.",
        "<strong class='text-white'>Smart Retry &amp; Backoff</strong>, honors the <code>p-time</code> window and resends with the <code>p-ticket</code> automatically, so a throttle recovers without you touching anything.",
        "<strong class='text-white'>Multi-Account Sync</strong>, mirrors the corrected order across accounts while keeping the total request count inside the limit.",
      ],
    },
  ], de: [
    { type: "paragraph", html: "Wenn Sie schnelle Märkte wie ES oder NQ über die Tradovate API automatisieren, killt nichts eine Strategie schneller als eine Wand aus <strong class='text-white'>429: Too Many Requests</strong>-Antworten. Sobald Ihr Bot, Copier oder Ihre TradingView-zu-Tradovate-Bridge Tradovates Anfragen-Obergrenze überschreitet, stoppt alles auf einmal, neue Orders, Änderungen, Stornierungen. Schlimmer noch: Eine nachfolgende <strong class='text-white'>p-ticket</strong>-Zeitstrafe oder eine <strong class='text-white'>p-captcha</strong>-Sperre kann Sie deutlich länger aus dem Markt halten als das Handelsfenster, das Sie eigentlich nutzen wollten. Am härtesten trifft es bei einer volatilen Eröffnung, wenn ein Alert auf mehrere Konten verteilt wird und jedes einzelne Bein als eigene Anfrage zählt. Hier erfahren Sie, was der 429-Fehler 2026 tatsächlich bedeutet, warum er ausgelöst wird und wie Sie drosseln, in eine Warteschlange stellen und sich erholen, plus wie PickMyTrade den API-Traffic so taktet, dass Ihre Orders gar nicht erst abgewiesen werden." },
    {
      type: "checklist",
      heading: "Kurz-Checkliste für das Tradovate 429 Rate Limit",
      items: [
        "<strong class='text-white'>Nicht sofort erneut versuchen.</strong> Wiederholtes Bombardieren der API während einer Sperre kann die Blockade verlängern, statt sie aufzuheben.",
        "<strong class='text-white'>Lesen Sie den Wert <code>p-time</code>.</strong> Er gibt die genaue Anzahl an Sekunden an, die Sie vor Ihrem nächsten Aufruf warten müssen.",
        "<strong class='text-white'>Erneut senden mit dem <code>p-ticket</code>.</strong> Fügen Sie das zurückgegebene Token in den Body Ihres erneuten Versuchs ein, damit die Anfrage akzeptiert wird.",
        "<strong class='text-white'>Unter den Obergrenzen drosseln.</strong> Planen Sie mit rund 80 Anfragen pro Minute und 5.000 pro Stunde in einem gleitenden Fenster und bestätigen Sie die aktuellen Werte in Tradovates API-Dokumentation.",
        "<strong class='text-white'>Order-Flow serverseitig in eine Warteschlange stellen.</strong> Verteilen Sie Änderungen und die Verteilung auf mehrere Konten zeitlich, statt sie gebündelt zu senden.",
        "<strong class='text-white'>Einen manuellen Reset anfordern.</strong> Wenn Sie ausgesperrt sind, wenden Sie sich mit Ihrem Benutzernamen an den Tradovate-Support, statt es weiter zu versuchen.",
      ],
    },
    { type: "heading", text: "Was „429: Too Many Requests“ bedeutet" },
    { type: "paragraph", html: "Der HTTP-Status <strong class='text-white'>429 Too Many Requests</strong> teilt Ihnen mit, dass Ihre Anwendung mehr Anfragen gesendet hat, als Tradovates API innerhalb eines bestimmten Zeitfensters akzeptiert. Tradovate drosselt pro Sekunde, pro Minute und pro Stunde. Sobald eine dieser Obergrenzen erreicht ist, verarbeitet der Server keine neuen Befehle mehr und antwortet mit einem 429, bis das Zeitfenster weiterrückt." },
    { type: "paragraph", html: "Hier gibt es eine wichtige Besonderheit: Tradovates eigenes Entwickler-FAQ besagt, dass es <strong class='text-white'>keine feste &ldquo;harte Obergrenze&rdquo;</strong> gibt. Die Schwellenwerte sind bewusst variabel und können sich unter Last oder aus Sicherheitsgründen verschärfen. Eine sichere Arbeitsobergrenze, an der Sie sich orientieren können, liegt bei etwa <strong class='text-white'>80 Anfragen pro Minute und 5.000 Anfragen pro Stunde in einem gleitenden 60-Minuten-Fenster</strong>, aber betrachten Sie das als bewegliches Ziel, nicht als feste Zusage. Da sich die genauen Grenzwerte im Laufe der Zeit ändern, bestätigen Sie sie immer anhand der aktuellen Tradovate-API-Dokumentation." },
    { type: "paragraph", html: "Der entscheidende Punkt, den Sie sich merken sollten: Das Limit bezieht sich auf das <strong class='text-white'>Anfragevolumen, nicht auf das Ordervolumen</strong>. Logins, Orderplatzierungen, Änderungen, Stornierungen und Position-Sync-Abfragen zählen alle mit. Kopieren Sie einen TradingView-Alert auf fünf Konten, sind das fünf Anfragen, sodass eine auf dem Papier bescheiden wirkende Strategie das Limit schnell sprengen kann, wenn sie über mehrere Konten gespiegelt wird oder stark auf Trailing-Stops setzt." },
    { type: "heading", text: "Häufigste Ursachen für das Tradovate 429 Rate Limit im Jahr 2026" },
    { type: "heading", text: "1. Die Minuten- oder Stundenobergrenze in Bursts überschreiten" },
    { type: "paragraph", html: "Das Abfeuern eines schnellen Bündels von Aufrufen, eine Reihe von Einstiegen, Zielen und Stopps direkt hintereinander, ist der klassische Auslöser. Und da die Stunden-Obergrenze auf einem gleitenden 60-Minuten-Fenster basiert, kann ein einziger starker Burst Sie lange nach dem eigentlichen Ereignis noch gedrosselt halten." },
    { type: "heading", text: "2. Verteilung auf mehrere Konten (Copy-Trading)" },
    { type: "paragraph", html: "Copy-Trading vervielfacht jede Aktion. Ein Alert, der auf fünf Konten kopiert wird, entspricht fünf Anfragen, und ein Stop-und-Target-Bracket auf jedem Konto vervielfacht das noch einmal. Eine hohe Kontoanzahl ist der mit Abstand häufigste Grund, warum automatisierte Trader das Limit auslösen." },
    { type: "heading", text: "3. Übermäßige Orderänderungen und Trailing-Stops" },
    { type: "paragraph", html: "Trailing-Stops und häufige Preisanpassungen erzeugen einen stetigen Strom von Änderungsanfragen pro Konto. Lassen Sie mehrere davon parallel laufen, wird die Minutenobergrenze schnell erreicht." },
    { type: "heading", text: "4. Aggressive Reconnect- oder Polling-Schleifen" },
    { type: "paragraph", html: "Bots, die sich immer wieder neu verbinden oder in kurzen Zeitabständen nach Fills und Positionen abfragen, verbrauchen still und leise Ihr Kontingent, selbst wenn gar keine Orders rausgehen. Besonders teuer ist ein Reconnect in einer Schleife nach einem Fehler." },
    { type: "heading", text: "5. Wiederholte fehlgeschlagene Logins lösen p-captcha aus" },
    { type: "paragraph", html: "Zu viele fehlgeschlagene Authentifizierungsversuche können ein <strong class='text-white'><code>p-captcha</code></strong>-Flag zurückgeben, was bedeutet, dass eine Drittanbieteranwendung (kein Browser) die Anfrage nicht abschließen kann. In der Praxis bedeutet das meist, etwa eine Stunde zu warten, bevor Sie es erneut versuchen." },
    { type: "heading", text: "So beheben Sie das Tradovate 429 Rate Limit: Schritt für Schritt" },
    { type: "heading", text: "Die p-ticket-, p-time- und p-captcha-Antwort lesen" },
    { type: "paragraph", html: "Wenn Tradovate Sie drosselt, enthält der Antwort-Body die Anweisungen zur Wiederherstellung. Gehen Sie in dieser Reihenfolge vor:" },
    {
      type: "steps",
      items: [
        { title: "Nach p-time suchen", html: "Prüfen Sie auf <strong class='text-white'><code>p-time</code></strong>, die Zeit in Sekunden, bevor Sie erneut eine Anfrage stellen können. Warten Sie diese Anzahl an Sekunden; versuchen Sie es nicht früher erneut." },
        { title: "Erneut senden mit p-ticket", html: "Senden Sie die ursprüngliche Anfrage erneut, wobei Sie <strong class='text-white'><code>p-ticket</code></strong> als zusätzliches Feld im Anfrage-Body hinzufügen. Das Ticket teilt Tradovate mit, dass dieser Wiederholungsversuch der genehmigte ist." },
        { title: "Bei p-captcha stoppen", html: "Wenn Sie stattdessen <strong class='text-white'><code>p-captcha</code></strong> sehen, stoppen Sie, eine Headless- oder Drittanbieteranwendung kann es nicht lösen. Warten Sie etwa eine Stunde und bestätigen Sie dann, dass Ihre Zugangsdaten korrekt sind, bevor Sie sich erneut authentifizieren." },
      ],
    },
    { type: "heading", text: "Ihre Anfragen drosseln und in eine Warteschlange stellen" },
    { type: "paragraph", html: "Die dauerhafte Lösung besteht darin, keine Bursts mehr zu senden und den Traffic zu takten:" },
    {
      type: "steps",
      items: [
        { title: "Ausgehende Rate begrenzen", html: "Begrenzen Sie Ihre ausgehende Rate unter der beobachteten Obergrenze und fügen Sie eine kleine Verzögerung zwischen den Aufrufen ein, damit ein Spike sie nie alle in derselben Sekunde landen lässt." },
        { title: "Verteilung auf mehrere Konten in eine Warteschlange stellen und staffeln", html: "Stellen Sie den Order-Flow serverseitig in eine Warteschlange und staffeln Sie die Verteilung auf mehrere Konten, sodass Konten nacheinander statt alle gleichzeitig bedient werden." },
        { title: "Vermeidbare Aufrufe reduzieren", html: "Reduzieren Sie vermeidbare Aufrufe: verringern Sie Orderänderungen, dämmen Sie das Trailing-Stop-Rauschen ein und erwägen Sie einen Ausführungsmodus, der werkende Orders dort, wo es sinnvoll ist, in Market-Orders umwandelt, weniger Änderungsaufrufe bedeuten weniger Anfragen." },
        { title: "Polling durch WebSocket-Updates ersetzen", html: "Ersetzen Sie enge Polling-Schleifen durch ereignisgesteuerte WebSocket-Updates, damit Sie Ihr Kontingent nicht nur verbrauchen, um auf Fills zu warten." },
      ],
    },
    { type: "heading", text: "Einen manuellen Reset bei Tradovate anfordern" },
    { type: "paragraph", html: "Wenn die Sperre bestehen bleibt oder eine p-ticket-Strafe einfach nicht verschwinden will, versuchen Sie es nicht immer weiter, das kann sie verlängern. Warten Sie die Abkühlphase ab (oft bis zu etwa 60 Minuten, bis das gleitende Fenster sich löscht), und wenn Sie dann immer noch ausgesperrt sind, wenden Sie sich mit Ihrem Benutzernamen an den Tradovate-Support unter <strong class='text-white'>312-283-3100</strong> oder <strong class='text-white'>support@tradovate.com</strong> und bitten Sie um einen manuellen Reset des API-Limits. Der Support kann die Strafe aufheben, wenn eine Abkühlphase allein nicht ausreicht." },
    { type: "heading", text: "Fehlerbehebungstabelle" },
    {
      type: "table",
      headers: ["Fehler / Signal", "Was es bedeutet", "Lösung"],
      rows: [
        ["429 Too Many Requests", "Sie haben die Sekunden-, Minuten- oder Stunden-Obergrenze für Anfragen überschritten", "Senden einstellen, das gleitende Fenster abwarten, dann künftigen Traffic drosseln"],
        ["p-ticket in der Antwort", "Ein Strafe-Token, das Sie beim Wiederholungsversuch zurücksenden müssen", "Ursprüngliche Anfrage mit p-ticket im Body erneut senden"],
        ["p-time in der Antwort", "Sekunden, die Sie warten müssen, bevor die nächste Anfrage erlaubt ist", "p-time Sekunden warten, dann mit dem Ticket erneut versuchen"],
        ["p-captcha in der Antwort", "Eine Drittanbieteranwendung kann die Anfrage nicht abschließen (oft nach fehlgeschlagenen Logins)", "Etwa eine Stunde warten, Zugangsdaten prüfen, dann erneut authentifizieren"],
        ["Für viele Minuten ausgesperrt", "Wiederholte Verstöße haben sich zu einer verlängerten Strafe ausgeweitet", "Abkühlphase abwarten; bei fortbestehender Sperre den Tradovate-Support um einen manuellen Reset bitten"],
        ["Limit trotz weniger Orders ausgelöst", "Copy-Verteilung oder Änderungen haben Ihre Anfragenanzahl vervielfacht", "Konten staffeln, Änderungen reduzieren und Order-Flow in eine Warteschlange stellen"],
      ],
    },
    { type: "heading", text: "So verhindern Sie das mit PickMyTrade" },
    { type: "paragraph", html: "PickMyTrade sitzt zwischen Ihren TradingView-Alerts und Tradovate und ist so gebaut, dass es die Grenzen der API respektiert, statt gegen sie anzukämpfen:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Rate-Limit-sicheres Routing</strong>, verteilt den Order-Flow zeitlich, sodass Aufrufe unter den Minuten- und Stundenobergrenzen bleiben und nie als einzelner Burst ankommen.",
        "<strong class='text-white'>Serverseitiges Queueing</strong>, bündelt und staffelt die Verteilung auf mehrere Konten, statt jedes Bein gleichzeitig abzufeuern.",
        "<strong class='text-white'>Smart Retry &amp; Backoff</strong>, respektiert das <code>p-time</code>-Fenster und sendet automatisch mit dem <code>p-ticket</code> erneut, sodass sich eine Drosselung erholt, ohne dass Sie etwas tun müssen.",
        "<strong class='text-white'>Multi-Account-Sync</strong>, spiegelt die korrigierte Order über Konten hinweg, während die Gesamtanzahl der Anfragen innerhalb des Limits bleibt.",
      ],
    },
  ], es: [
    { type: "paragraph", html: "Cuando automatiza instrumentos rápidos como ES o NQ a través de la API de Tradovate, nada acaba con una estrategia más rápido que un muro de respuestas <strong class='text-white'>429: Too Many Requests</strong>. En el momento en que su bot, copiador o puente de TradingView a Tradovate supera el límite de solicitudes de Tradovate, todo se detiene a la vez: nuevas órdenes, modificaciones, cancelaciones. Peor aún, una penalización de tiempo <strong class='text-white'>p-ticket</strong> posterior o un bloqueo por <strong class='text-white'>p-captcha</strong> pueden dejarlo fuera de juego mucho más tiempo que la ventana de operación que perseguía. El problema es más grave en una apertura volátil, cuando una alerta se distribuye entre varias cuentas y cada pata cuenta como su propia solicitud. Esto es lo que realmente significa el error 429 en 2026, por qué se dispara y cómo limitar, poner en cola y recuperarse, además de cómo PickMyTrade regula el tráfico de la API para que sus órdenes no reboten desde el principio." },
    {
      type: "checklist",
      heading: "Lista de verificación rápida para el límite de velocidad 429 de Tradovate",
      items: [
        "<strong class='text-white'>Deje de reintentar de inmediato.</strong> Bombardear la API durante un bloqueo puede prolongarlo en lugar de levantarlo.",
        "<strong class='text-white'>Lea el valor de <code>p-time</code>.</strong> Indica el número exacto de segundos que debe esperar antes de la siguiente llamada.",
        "<strong class='text-white'>Reenvíe con el <code>p-ticket</code>.</strong> Incluya el token devuelto en el cuerpo de su reintento para que la solicitud sea aceptada.",
        "<strong class='text-white'>Limite el tráfico por debajo de los topes.</strong> Diseñe su sistema para unas 80 solicitudes por minuto y 5000 por hora en una ventana móvil, y confirme las cifras actuales en la documentación de la API de Tradovate.",
        "<strong class='text-white'>Ponga el flujo de órdenes en cola en el servidor.</strong> Espacie las modificaciones y la distribución a varias cuentas en lugar de enviarlas todas a la vez.",
        "<strong class='text-white'>Solicite un restablecimiento manual.</strong> Si está bloqueado, contacte al soporte de Tradovate con su nombre de usuario en lugar de seguir reintentando.",
      ],
    },
    { type: "heading", text: "Qué significa «429: Too Many Requests»" },
    { type: "paragraph", html: "El estado HTTP <strong class='text-white'>429 Too Many Requests</strong> es la forma en que Tradovate le indica que su aplicación ha enviado más solicitudes de las que su API acepta dentro de una ventana determinada. Tradovate limita el tráfico por segundo, por minuto y por hora. En el instante en que se alcanza cualquiera de esos topes, el servidor deja de procesar comandos nuevos y responde con un 429 hasta que la ventana avanza." },
    { type: "paragraph", html: "Aquí hay un matiz importante: las propias preguntas frecuentes para desarrolladores de Tradovate afirman que <strong class='text-white'>no existe un &ldquo;tope fijo&rdquo;</strong>. Los umbrales son deliberadamente variables y pueden endurecerse bajo carga o por motivos de seguridad. Un límite de trabajo seguro para diseñar su sistema es de aproximadamente <strong class='text-white'>80 solicitudes por minuto y 5000 solicitudes por hora en una ventana móvil de 60 minutos</strong>, pero trátelo como un objetivo cambiante, no como una promesa. Como los límites exactos cambian con el tiempo, confirme siempre con la documentación actual de la API de Tradovate." },
    { type: "paragraph", html: "Lo importante que hay que interiorizar: el límite se basa en el <strong class='text-white'>volumen de solicitudes, no en el volumen de órdenes</strong>. Los inicios de sesión, la colocación de órdenes, las modificaciones, las cancelaciones y el sondeo de sincronización de posiciones cuentan todos. Copiar una alerta de TradingView a cinco cuentas son cinco solicitudes, así que una estrategia que sobre el papel parece modesta puede agotar el tope rápidamente cuando se replica en varias cuentas o depende mucho de los stops dinámicos." },
    { type: "heading", text: "Principales causas del límite de velocidad 429 de Tradovate en 2026" },
    { type: "heading", text: "1. Superar el tope por minuto o por hora en ráfagas" },
    { type: "paragraph", html: "Disparar un grupo rápido de llamadas, un lote de entradas, objetivos y stops uno detrás de otro, es el desencadenante clásico. Y como el tope horario funciona sobre una ventana móvil de 60 minutos, una sola ráfaga intensa puede dejarlo limitado mucho después de que la actividad en sí haya terminado." },
    { type: "heading", text: "2. Distribución en varias cuentas (copy trading)" },
    { type: "paragraph", html: "El copy trading multiplica cada acción. Una alerta copiada en cinco cuentas equivale a cinco solicitudes, y un bracket de stop y objetivo en cada cuenta lo multiplica de nuevo. Un número elevado de cuentas es, con diferencia, la razón más común por la que los traders automatizados alcanzan el límite." },
    { type: "heading", text: "3. Modificaciones de órdenes excesivas y stops dinámicos" },
    { type: "paragraph", html: "Los stops dinámicos y los ajustes de precio frecuentes generan un flujo constante de solicitudes de modificación por cuenta. Ejecute varias de estas en paralelo y el tope por minuto aparecerá rápidamente." },
    { type: "heading", text: "4. Bucles agresivos de reconexión o sondeo" },
    { type: "paragraph", html: "Los bots que se reconectan una y otra vez, o que sondean fills y posiciones con un temporizador ajustado, consumen silenciosamente su cuota incluso cuando no se envía ninguna orden. Reconectarse en bucle tras un fallo es especialmente costoso." },
    { type: "heading", text: "5. Inicios de sesión fallidos repetidos que activan p-captcha" },
    { type: "paragraph", html: "Demasiados intentos de autenticación fallidos pueden devolver una marca <strong class='text-white'><code>p-captcha</code></strong>, lo que significa que una aplicación de terceros (que no es un navegador) no puede completar la solicitud. En la práctica, eso suele significar esperar aproximadamente una hora antes de volver a intentarlo." },
    { type: "heading", text: "Cómo solucionar el límite de velocidad 429 de Tradovate: paso a paso" },
    { type: "heading", text: "Cómo leer la respuesta p-ticket, p-time y p-captcha" },
    { type: "paragraph", html: "Cuando Tradovate le limita el tráfico, el cuerpo de la respuesta contiene las instrucciones de recuperación. Gestiónelo en este orden:" },
    {
      type: "steps",
      items: [
        { title: "Compruebe p-time", html: "Compruebe <strong class='text-white'><code>p-time</code></strong>, el tiempo en segundos antes de poder hacer otra solicitud. Espere esa cantidad de segundos; no reintente antes." },
        { title: "Reenvíe con p-ticket", html: "Reenvíe la solicitud original añadiendo <strong class='text-white'><code>p-ticket</code></strong> como campo adicional en el cuerpo de la solicitud. El ticket es lo que le indica a Tradovate que este reintento es el autorizado." },
        { title: "Deténgase ante p-captcha", html: "Si en su lugar ve <strong class='text-white'><code>p-captcha</code></strong>, deténgase, una aplicación headless o de terceros no puede resolverlo. Espere aproximadamente una hora y luego confirme que sus credenciales son correctas antes de volver a autenticarse." },
      ],
    },
    { type: "heading", text: "Limitar y poner en cola sus solicitudes" },
    { type: "paragraph", html: "La solución duradera es dejar de enviar ráfagas y regular el tráfico:" },
    {
      type: "steps",
      items: [
        { title: "Limite su tasa de salida", html: "Limite su tasa de salida por debajo del tope observado y añada un pequeño retraso entre llamadas para que un pico nunca las haga aterrizar todas en el mismo segundo." },
        { title: "Ponga en cola y escalone la distribución a varias cuentas", html: "Ponga el flujo de órdenes en cola en el servidor y escalone la distribución a varias cuentas para que las cuentas se atiendan en secuencia en lugar de todas a la vez." },
        { title: "Reduzca las llamadas evitables", html: "Reduzca las llamadas evitables: disminuya las modificaciones de órdenes, recorte el ruido de los stops dinámicos y considere un modo de ejecución que convierta las órdenes activas en órdenes de mercado cuando tenga sentido, menos llamadas de modificación significan menos solicitudes." },
        { title: "Sustituya el sondeo por actualizaciones por WebSocket", html: "Sustituya los bucles de sondeo ajustados por actualizaciones por WebSocket basadas en eventos, para no gastar su cuota solo por vigilar los fills." },
      ],
    },
    { type: "heading", text: "Solicitar un restablecimiento manual a Tradovate" },
    { type: "paragraph", html: "Si el bloqueo persiste o una penalización p-ticket simplemente no se elimina, no siga reintentando, eso puede prolongarlo. Espere a que pase el periodo de enfriamiento (a menudo hasta unos 60 minutos para que la ventana móvil se despeje) y, si sigue bloqueado, contacte al soporte de Tradovate en <strong class='text-white'>312-283-3100</strong> o <strong class='text-white'>support@tradovate.com</strong> con su nombre de usuario y solicite un restablecimiento manual del límite de la API. El soporte puede levantar la penalización cuando el enfriamiento por sí solo no baste." },
    { type: "heading", text: "Tabla de solución de problemas" },
    {
      type: "table",
      headers: ["Error / señal", "Qué significa", "Solución"],
      rows: [
        ["429 Too Many Requests", "Superó el tope de solicitudes por segundo, por minuto o por hora", "Deje de enviar, espere a la ventana móvil y luego limite el tráfico futuro"],
        ["p-ticket en la respuesta", "Un token de penalización que debe devolver en el reintento", "Reenvíe la solicitud original con p-ticket en el cuerpo"],
