      ],
    },
  ] },
  ctaHeading: { en: "Fan One Signal Across Every Account", de: "Verteilen Sie ein Signal auf jedes Konto", es: "Distribuya una señal a todas sus cuentas", fr: "Diffusez un signal sur chaque compte", it: "Distribuisca un segnale su ogni conto" },
  ctaText: { en: "Start your free 7-day trial, fan one TradingView signal across every prop account, slippage-managed.", de: "Starten Sie Ihre kostenlose 7-Tage-Testphase und verteilen Sie ein TradingView-Signal auf alle Ihre Prop-Konten, mit gesteuertem Slippage.", es: "Comience su prueba gratuita de 7 días y distribuya una señal de TradingView a todas sus cuentas prop, con el slippage bajo control.", fr: "Commencez votre essai gratuit de 7 jours et diffusez un signal TradingView sur tous vos comptes prop, avec un slippage maîtrisé.", it: "Inizi la prova gratuita di 7 giorni e distribuisca un segnale TradingView su tutti i suoi conti prop, con slippage sotto controllo." },
  ctaButtonText: { en: "Start Your Free 7-Day Trial", de: "Starten Sie Ihre kostenlose 7-Tage-Testphase", es: "Comience su prueba gratuita de 7 días", fr: "Commencez votre essai gratuit de 7 jours", it: "Inizi la prova gratuita di 7 giorni" },
  ctaUrl: "https://app.pickmytrade.trade/?register=true&utm_source=content&utm_medium=debugging",
  faqHeading: { en: "Frequently Asked Questions", de: "Häufig gestellte Fragen", es: "Preguntas frecuentes", fr: "Questions fréquentes", it: "Domande frequenti" },
  faqs: { en: [
    { q: "Can TradingView send one alert to multiple Tradovate accounts at once?", a: "Not through its native broker link, that connects to a single Tradovate login at a time. To hit multiple accounts you either use Tradovate's Group Trade (same login) or an external copier/webhook service (across firms)." },
    { q: "Why does TradingView only show one of my prop accounts?", a: "Each prop firm issues its own Tradovate username, and TradingView can only be connected to one username per broker session. The other firms' accounts live under different logins it can't see." },
    { q: "Does Tradovate have a built-in way to copy trades?", a: "Yes, the Group Trade add-on copies orders across accounts under the same login. It does not work across different brokerages or prop firms, and it doesn't drive automated bracket/ATM strategies." },
    { q: "How do I copy across accounts at different prop firms?", a: "Use a trade copier or webhook automation that logs into each account independently. You pick a lead account, map follower quantities, and point your TradingView alert at the service's webhook so one signal becomes many orders." },
    { q: "Will the fills be identical on every account?", a: "No. Copying sends orders to accounts a moment apart, so expect small price and fill differences (slippage). Size positions and place stops assuming those differences exist rather than expecting tick-perfect mirroring." },
    { q: "Is copy trading allowed on prop firm accounts?", a: "Many firms permit copying and webhook automation, but policies differ and change over time, some restrict automation or specific tools. Rules vary by firm and account size, so check your firm's current rules before you scale." },
    { q: "Why do my connections keep dropping when I run several accounts?", a: "Tradovate limits concurrent sessions per login. Logging the same firm in on multiple devices triggers device-quota errors. Keep one session per login and let a copier hold the other account connections." },
    { q: "Can I trade different contract sizes on each account?", a: "Yes. Both Group Trade and external copiers let you assign a per-account quantity, so a small evaluation and a larger funded account can each trade the size that fits its limits." },
  ], de: [
    { q: "Kann TradingView einen Alert gleichzeitig an mehrere Tradovate-Konten senden?", a: "Nicht über die native Broker-Verbindung, diese verbindet sich jeweils nur mit einem Tradovate-Login. Um mehrere Konten anzusteuern, nutzen Sie entweder Tradovates Group Trade (gleicher Login) oder einen externen Copier-/Webhook-Dienst (firmenübergreifend)." },
    { q: "Warum zeigt TradingView nur eines meiner Prop-Konten?", a: "Jede Prop Firm vergibt einen eigenen Tradovate-Benutzernamen, und TradingView kann pro Broker-Sitzung nur mit einem Benutzernamen verbunden sein. Die Konten der anderen Firmen liegen unter anderen Logins, die es nicht sehen kann." },
    { q: "Hat Tradovate eine integrierte Möglichkeit, Trades zu kopieren?", a: "Ja, das Add-on Group Trade kopiert Orders über Konten desselben Logins. Es funktioniert nicht über verschiedene Broker oder Prop Firms hinweg und steuert keine automatisierten Bracket-/ATM-Strategien." },
    { q: "Wie kopiere ich über Konten bei verschiedenen Prop Firms?", a: "Nutzen Sie einen Trade-Copier oder eine Webhook-Automatisierung, die sich in jedes Konto unabhängig einloggt. Sie wählen ein Leitkonto, ordnen die Mengen der Follower-Konten zu und richten Ihren TradingView-Alert auf den Webhook des Dienstes, sodass aus einem Signal viele Orders werden." },
    { q: "Sind die Fills auf jedem Konto identisch?", a: "Nein. Beim Kopieren werden Orders mit kurzem zeitlichem Abstand an die Konten gesendet, daher sind kleine Preis- und Fill-Unterschiede (Slippage) zu erwarten. Dimensionieren Sie Positionen und setzen Sie Stopps unter der Annahme, dass diese Unterschiede existieren, statt tickgenaue Spiegelung zu erwarten." },
    { q: "Ist Copy-Trading auf Prop-Firm-Konten erlaubt?", a: "Viele Firmen erlauben Kopieren und Webhook-Automatisierung, doch die Richtlinien unterscheiden sich und ändern sich im Lauf der Zeit, manche schränken Automatisierung oder bestimmte Tools ein. Die Regeln variieren je nach Firma und Kontogröße, prüfen Sie daher die aktuellen Regeln Ihrer Firma, bevor Sie skalieren." },
    { q: "Warum brechen meine Verbindungen ab, wenn ich mehrere Konten betreibe?", a: "Tradovate begrenzt gleichzeitige Sitzungen pro Login. Wer sich bei derselben Firma auf mehreren Geräten anmeldet, löst Fehler wegen Gerätekontingent aus. Halten Sie eine Sitzung pro Login und überlassen Sie die übrigen Kontoverbindungen einem Copier." },
    { q: "Kann ich auf jedem Konto unterschiedliche Kontraktgrößen handeln?", a: "Ja. Sowohl Group Trade als auch externe Copier erlauben eine Menge pro Konto, sodass ein kleines Evaluierungskonto und ein größeres finanziertes Konto jeweils die Größe handeln können, die zu ihren Limits passt." },
  ], es: [
    { q: "¿Puede TradingView enviar una alerta a varias cuentas de Tradovate a la vez?", a: "No mediante su vínculo nativo con el bróker, que se conecta a un único inicio de sesión de Tradovate a la vez. Para operar en varias cuentas puede usar Group Trade de Tradovate (mismo inicio de sesión) o un servicio externo de copiado/webhook (entre firmas)." },
    { q: "¿Por qué TradingView solo muestra una de mis cuentas prop?", a: "Cada prop firm emite su propio nombre de usuario de Tradovate, y TradingView solo puede conectarse a un usuario por sesión de bróker. Las cuentas de las otras firmas están bajo inicios de sesión distintos que no puede ver." },
    { q: "¿Tiene Tradovate una forma integrada de copiar operaciones?", a: "Sí, el add-on Group Trade copia órdenes entre cuentas bajo el mismo inicio de sesión. No funciona entre distintos brókeres ni prop firms, y no gestiona estrategias automatizadas de bracket/ATM." },
    { q: "¿Cómo copio entre cuentas de distintas prop firms?", a: "Use un copiador de operaciones o una automatización por webhook que inicie sesión en cada cuenta de forma independiente. Usted elige una cuenta principal, asigna las cantidades de las cuentas seguidoras y dirige su alerta de TradingView al webhook del servicio para que una señal se convierta en varias órdenes." },
    { q: "¿Las ejecuciones serán idénticas en todas las cuentas?", a: "No. Al copiar, las órdenes llegan a las cuentas con un breve desfase, así que cabe esperar pequeñas diferencias de precio y de ejecución (slippage). Dimensione las posiciones y coloque los stops asumiendo que esas diferencias existen, en lugar de esperar un espejo exacto al tick." },
    { q: "¿Se permite el copy trading en cuentas de prop firms?", a: "Muchas firmas permiten el copiado y la automatización por webhook, pero las políticas difieren y cambian con el tiempo; algunas restringen la automatización o herramientas concretas. Las reglas varían según la firma y el tamaño de la cuenta, así que revise las reglas vigentes de su firma antes de escalar." },
    { q: "¿Por qué se me caen las conexiones cuando uso varias cuentas?", a: "Tradovate limita las sesiones simultáneas por inicio de sesión. Iniciar sesión en la misma firma en varios dispositivos provoca errores de cuota de dispositivos. Mantenga una sesión por inicio de sesión y deje que un copiador gestione las demás conexiones de cuenta." },
    { q: "¿Puedo operar tamaños de contrato distintos en cada cuenta?", a: "Sí. Tanto Group Trade como los copiadores externos permiten asignar una cantidad por cuenta, de modo que una cuenta de evaluación pequeña y una cuenta financiada mayor puedan operar cada una el tamaño que se ajuste a sus límites." },
  ], fr: [
    { q: "TradingView peut-il envoyer une alerte à plusieurs comptes Tradovate à la fois ?", a: "Pas via sa connexion native au courtier, qui ne se relie qu'à un seul identifiant Tradovate à la fois. Pour atteindre plusieurs comptes, vous utilisez soit Group Trade de Tradovate (même identifiant), soit un service externe de copie/webhook (entre firmes)." },
    { q: "Pourquoi TradingView n'affiche-t-il qu'un seul de mes comptes prop ?", a: "Chaque prop firm délivre son propre nom d'utilisateur Tradovate, et TradingView ne peut être connecté qu'à un seul nom d'utilisateur par session de courtier. Les comptes des autres firmes se trouvent sous d'autres identifiants qu'il ne voit pas." },
    { q: "Tradovate propose-t-il un moyen intégré de copier les trades ?", a: "Oui, l'add-on Group Trade copie les ordres entre comptes sous le même identifiant. Il ne fonctionne pas entre différents courtiers ou prop firms, et ne pilote pas les stratégies bracket/ATM automatisées." },
    { q: "Comment copier entre des comptes de différentes prop firms ?", a: "Utilisez un copieur de trades ou une automatisation par webhook qui se connecte à chaque compte indépendamment. Vous choisissez un compte principal, associez les quantités des comptes suiveurs et pointez votre alerte TradingView vers le webhook du service afin qu'un signal devienne plusieurs ordres." },
