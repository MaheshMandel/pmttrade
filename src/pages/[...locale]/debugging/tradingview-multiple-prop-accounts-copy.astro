---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "tradingview-multiple-prop-accounts-copy";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/debugging/${SLUG}`;

const META_TITLE = "TradingView Can't Copy Across Multiple Prop Accounts";
const META_DESCRIPTION =
  "TradingView links just one account at a time, fan a single signal across multiple Tradovate prop accounts using a copier, with minimal slippage.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "TradingView kann nicht über mehrere Prop-Konten kopieren", es: "TradingView no puede copiar entre varias cuentas prop", fr: "TradingView ne peut pas copier sur plusieurs comptes prop", it: "TradingView non può copiare su più conti prop" },
  dek: { en: "TradingView shows exactly one connected account, even though you're running five funded evaluations across different prop firms. Here's why the broker link is one-to-one and how to fan a single signal across every account you run.", de: "TradingView zeigt genau ein verbundenes Konto, obwohl Sie fünf finanzierte Evaluierungen bei verschiedenen Prop Firms betreiben. Hier erfahren Sie, warum die Broker-Verbindung eins zu eins ist und wie Sie ein einzelnes Signal auf jedes Ihrer Konten verteilen.", es: "TradingView muestra exactamente una cuenta conectada, aunque usted tenga cinco evaluaciones financiadas en distintas prop firms. Aquí le explicamos por qué la conexión con el bróker es uno a uno y cómo distribuir una sola señal a todas sus cuentas.", fr: "TradingView n'affiche qu'un seul compte connecté, alors que vous gérez cinq évaluations financées chez différentes prop firms. Voici pourquoi la connexion au courtier est un-à-un et comment diffuser un seul signal sur tous vos comptes.", it: "TradingView mostra esattamente un conto collegato, anche se lei gestisce cinque valutazioni finanziate presso diverse prop firm. Ecco perché il collegamento al broker è uno a uno e come distribuire un singolo segnale su ogni conto." },
  readTime: { en: "7 min read", de: "7 Min. Lesezeit", es: "Lectura de 7 min", fr: "Lecture : 7 min", it: "Lettura di 7 min" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "Picture five funded evaluations running on Tradovate, one at Apex, one at Topstep, a couple at MyFundedFutures, and one clean TradingView strategy you want firing on every one of them. Then you hit connect, and TradingView shows you exactly <strong class='text-white'>one</strong> account. This is the wall traders slam into the second they try to scale prop firm accounts, and the reason is simple: TradingView's broker link binds to a single Tradovate login at a time. It shows up as &ldquo;only one account filled,&rdquo; &ldquo;my other firms didn't take the trade,&rdquo; or &ldquo;TradingView won't let me pick a second account.&rdquo; None of that is a bug. It's exactly how a one-to-one broker connection is supposed to behave, and the fix depends entirely on whether your accounts sit under the same login or spread across different prop firms." },
    { type: "paragraph", html: "That's the gap automation tools like PickMyTrade close. Instead of TradingView whispering to one account, a webhook alert fans the same signal out to every account you map, no matter which firm issued it." },
    {
      type: "checklist",
      heading: "Quick Checklist for Copying One Signal to Multiple Prop Accounts",
      items: [
        "<strong class='text-white'>Confirm how many logins you have.</strong> Accounts at different prop firms use different Tradovate usernames, and TradingView connects to only one username at a time.",
        "<strong class='text-white'>Same firm, several accounts?</strong> Use Tradovate's native Group Trade add-on, it copies within one login only.",
        "<strong class='text-white'>Different firms or different logins?</strong> A native TradingView link can't span them. You'll need an external trade copier or a webhook bridge.",
        "<strong class='text-white'>Pick a master (lead) account.</strong> Most copiers execute once on a lead account, then mirror to the rest.",
        "<strong class='text-white'>Expect some slippage.</strong> Fills across accounts won't be tick-perfect, so size and stops should assume small differences.",
        "<strong class='text-white'>Check each firm's automation rules.</strong> Plenty of firms allow copying and webhook automation, but not all do, limits vary by firm and account size, so check your firm's current rules.",
      ],
    },
    { type: "heading", text: "What &ldquo;One Signal, One Account&rdquo; Actually Means" },
    { type: "paragraph", html: "When you connect Tradovate to TradingView, you log in with a <strong class='text-white'>single Tradovate username</strong>. TradingView's Trading Panel then shows the accounts tied to that one login. If an alert routes an order to your broker, it lands in the account you're currently connected to and nowhere else. There's no built-in &ldquo;send to all my accounts&rdquo; switch inside the broker panel." },
    { type: "paragraph", html: "Here's why that stings for prop traders: <strong class='text-white'>each prop firm hands you its own Tradovate login</strong>. Your Apex account, your Topstep account, and your MyFundedFutures account are three separate usernames. TradingView holds one broker session at a time, so you physically can't be connected to all three firms through a single TradingView broker link. The signal is fine. The connection is the bottleneck." },
    { type: "paragraph", html: "So there are really two different problems hiding under the same complaint. If all your accounts sit under one login, common when a single firm gives you several accounts, Tradovate's own Group Trade feature can fan the order out. If your accounts are scattered across different firms, you need something that sits outside TradingView and pushes the same signal to many logins at once." },
    { type: "heading", text: "Top Causes of TradingView Only Hitting One Account" },
    { type: "heading", text: "1. The broker link is one-account-at-a-time" },
    { type: "paragraph", html: "TradingView's native broker integration is a one-to-one session. It authenticates a single Tradovate username and exposes the accounts under it. That's the design, not a glitch, the Trading Panel was never built to broadcast a single alert to unrelated accounts." },
    { type: "heading", text: "2. Each prop firm is a separate Tradovate login" },
    { type: "paragraph", html: "This is the real trap. Because Apex, Topstep, TakeProfitTrader, MyFundedFutures, EliteTraderFunding and the rest each issue their own credentials, &ldquo;multiple prop accounts&rdquo; almost always means &ldquo;multiple logins.&rdquo; One TradingView connection can't be logged into two firms at the same time, so the alert only ever reaches the firm you're currently connected to." },
    { type: "heading", text: "3. Native Group Trade doesn't cross firms" },
    { type: "paragraph", html: "Tradovate's Group Trade add-on is genuinely handy, but it only groups accounts that share the <strong class='text-white'>same login/brokerage</strong>. Every account in a group has to be with the same brokerage, you can't mix a personal account with a prop account, and you can't mix two different firms. Group Trade also won't drive ATM strategies or automated brackets; stops and targets get handled with manual OCO orders." },
    { type: "heading", text: "4. Alerts fire to the selected account only" },
    { type: "paragraph", html: "Even inside a single login with multiple accounts, a plain &ldquo;send order to broker&rdquo; alert targets the one account that's active in the panel. Without Group Trade enabled and a group selected, the other accounts under that same login just sit idle." },
    { type: "heading", text: "5. Session and device limits knock connections offline" },
    { type: "paragraph", html: "Tradovate caps concurrent sessions per login. Try to brute-force multi-account trading by logging the same firm in across several browsers or devices, and you'll hit device-quota errors and watch connections drop. It looks like &ldquo;copy trading broke,&rdquo; but it's really a session-limit problem." },
    { type: "heading", text: "How to Fix It: Step-by-Step" },
    { type: "heading", text: "Fixing multiple accounts under ONE login (native Group Trade)" },
    { type: "paragraph", html: "If your accounts share a single Tradovate username, you don't need any third-party tool at all." },
    {
      type: "steps",
      items: [
        { title: "Open Application Settings", html: "Open <strong class='text-white'>Application Settings</strong> in the Tradovate web or desktop app and head to the <strong class='text-white'>Add-Ons</strong> section." },
        { title: "Enable Group Trade", html: "Enable the <strong class='text-white'>Group Trade</strong> add-on, then log out and log back in so the feature loads." },
        { title: "Open Manage Groups", html: "Click the <strong class='text-white'>account dropdown</strong> at the top of the platform and choose <strong class='text-white'>Manage Groups</strong>, this only appears when more than one account is linked to your username." },
        { title: "Build the group", html: "In the group editor, click <strong class='text-white'>+</strong> to create a group, name it, then drag accounts from the <strong class='text-white'>Available</strong> list into the <strong class='text-white'>Added Accounts</strong> list." },
        { title: "Set per-account quantity", html: "Set a per-account <strong class='text-white'>order quantity</strong> for each account so every one trades the size you want." },
        { title: "Select the group before trading", html: "Select the group in the account dropdown before you trade. Orders, whether placed manually or fired from a connected TradingView alert, now hit every account in the group at once." },
      ],
    },
    { type: "paragraph", html: "Keep Group Trade's boundaries in mind: same brokerage only, no automated ATM/bracket handling, and you'll manage stops and targets as OCO orders." },
    { type: "heading", text: "Fixing accounts across DIFFERENT firms (external copier or webhook)" },
    { type: "paragraph", html: "When your accounts live at different prop firms, no native switch will unite them. You route the signal outside TradingView instead." },
    {
      type: "steps",
      items: [
        { title: "Choose a master account", html: "Choose a <strong class='text-white'>master (lead) account</strong>, the account you (or your strategy) act on first." },
        { title: "Connect each account to a copier", html: "Connect each of your prop firm accounts to a trade copier or webhook automation service. Because these tools log into each Tradovate account independently, they aren't chained to a single login the way TradingView is." },
        { title: "Map the fan-out", html: "Define how many contracts each follower account trades relative to the lead. Sizing can differ per account, so you respect each firm's own limits." },
        { title: "Point your alert at the webhook", html: "Point your TradingView strategy or manual alert at the service's <strong class='text-white'>webhook URL</strong> instead of a single broker connection. One alert now becomes many orders." },
        { title: "Verify with a small test trade", html: "Verify with a small test trade before you scale. Watch the fills across accounts and confirm each firm actually received the order." },
      ],
    },
    { type: "paragraph", html: "This is the model behind every multi-firm copier: a single trigger, replicated to unlimited logins. The trade-off is slippage, orders reach each account a moment apart and fill at slightly different prices, so plan sizing and stops with that in mind." },
    { type: "heading", text: "Troubleshooting Table" },
    {
      type: "table",
      headers: ["Symptom", "What it means", "Fix"],
      rows: [
        ["Only one account filled", "TradingView is linked to a single login/account", "Enable Group Trade (same login) or use an external copier (across firms)"],
        ["TradingView won't let me add a second account", "The broker panel holds one Tradovate session at a time", "Route via a webhook copier that logs into each account separately"],
        ["Group Trade doesn't show my other firm", "Group Trade only spans accounts under the same brokerage/login", "Use an external copier for cross-firm fan-out"],
        ["Manage Groups option is missing", "Only one account is linked to that username", "Group Trade needs 2+ accounts under one login; otherwise copy externally"],
        ["Accounts fill at different prices", "Normal slippage from routing orders to accounts sequentially", "Size and set stops assuming small per-account differences"],
        ["Device quota / session limit error", "Too many concurrent sessions on one login", "Trade one session per login; let a copier hold the other connections"],
        ["Brackets/ATM don't copy in a group", "Group Trade doesn't drive ATM strategies", "Manage stops and targets as manual OCO orders, or use a copier that supports brackets"],
      ],
    },
    { type: "heading", text: "Prevent This with PickMyTrade" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>One Alert, Every Account.</strong> A single TradingView webhook fans out to all your Tradovate accounts, across as many prop firms as you run, with no per-login bottleneck.",
        "<strong class='text-white'>Per-Account Sizing.</strong> Set independent quantities so each account respects its own firm's limits, which vary by firm and account size.",
        "<strong class='text-white'>Bracket & SL/TP Support.</strong> Stops and targets travel with the copied order instead of being left behind.",
        "<strong class='text-white'>Multi-Account Sync.</strong> The same corrected order mirrors across every mapped account, keeping your book consistent.",
        "<strong class='text-white'>Rate-Limit-Safe Routing.</strong> Order flow is spaced so juggling several logins doesn't trip Tradovate's session and request caps.",
      ],
    },
  ], de: [
    { type: "paragraph",html: "Stellen Sie sich fünf finanzierte Evaluierungen auf Tradovate vor, eine bei Apex, eine bei Topstep, ein paar bei MyFundedFutures, und eine saubere TradingView-Strategie, die auf jeder davon feuern soll. Dann klicken Sie auf Verbinden, und TradingView zeigt Ihnen genau <strong class='text-white'>ein</strong> Konto. Auf diese Wand stoßen Trader in dem Moment, in dem sie Prop-Firm-Konten skalieren wollen, und der Grund ist simpel: Die Broker-Verbindung von TradingView ist jeweils an einen einzigen Tradovate-Login gebunden. Das äußert sich als &ldquo;nur ein Konto wurde ausgeführt&rdquo;, &ldquo;meine anderen Firmen haben den Trade nicht übernommen&rdquo; oder &ldquo;TradingView lässt mich kein zweites Konto auswählen&rdquo;. Nichts davon ist ein Fehler. Genau so soll sich eine Eins-zu-eins-Broker-Verbindung verhalten, und die Lösung hängt vollständig davon ab, ob Ihre Konten unter demselben Login liegen oder über verschiedene Prop Firms verteilt sind." },
    { type: "paragraph",html: "Diese Lücke schließen Automatisierungstools wie PickMyTrade. Statt dass TradingView nur einem Konto etwas zuflüstert, verteilt ein Webhook-Alert dasselbe Signal an jedes zugeordnete Konto, unabhängig davon, welche Firma es ausgegeben hat." },
    {
      type: "checklist",
      heading: "Kurze Checkliste: ein Signal auf mehrere Prop-Konten kopieren",
      items: [
        "<strong class='text-white'>Prüfen Sie, wie viele Logins Sie haben.</strong> Konten bei verschiedenen Prop Firms nutzen unterschiedliche Tradovate-Benutzernamen, und TradingView verbindet sich jeweils nur mit einem Benutzernamen.",
        "<strong class='text-white'>Dieselbe Firma, mehrere Konten?</strong> Nutzen Sie Tradovates natives Add-on Group Trade, es kopiert nur innerhalb eines Logins.",
        "<strong class='text-white'>Verschiedene Firmen oder verschiedene Logins?</strong> Eine native TradingView-Verbindung kann diese nicht überspannen. Sie benötigen einen externen Trade-Copier oder eine Webhook-Brücke.",
        "<strong class='text-white'>Wählen Sie ein Master-(Leit-)Konto.</strong> Die meisten Copier führen einmal auf einem Leitkonto aus und spiegeln dann auf die übrigen.",
        "<strong class='text-white'>Rechnen Sie mit etwas Slippage.</strong> Fills über Konten hinweg sind nicht tickgenau, daher sollten Größe und Stopps kleine Abweichungen einkalkulieren.",
        "<strong class='text-white'>Prüfen Sie die Automatisierungsregeln jeder Firma.</strong> Viele Firmen erlauben Kopieren und Webhook-Automatisierung, aber nicht alle, die Limits variieren je nach Firma und Kontogröße, prüfen Sie daher die aktuellen Regeln Ihrer Firma.",
      ],
    },
    { type: "heading",text: "Was &ldquo;Ein Signal, ein Konto&rdquo; tatsächlich bedeutet" },
    { type: "paragraph",html: "Wenn Sie Tradovate mit TradingView verbinden, melden Sie sich mit einem <strong class='text-white'>einzelnen Tradovate-Benutzernamen</strong> an. Das Trading Panel von TradingView zeigt dann die Konten, die zu diesem einen Login gehören. Wenn ein Alert eine Order an Ihren Broker leitet, landet sie in dem Konto, mit dem Sie gerade verbunden sind, und nirgendwo sonst. Im Broker-Panel gibt es keinen eingebauten Schalter &ldquo;an alle meine Konten senden&rdquo;." },
    { type: "paragraph",html: "Für Prop-Trader ist das deshalb ärgerlich: <strong class='text-white'>Jede Prop Firm gibt Ihnen einen eigenen Tradovate-Login</strong>. Ihr Apex-Konto, Ihr Topstep-Konto und Ihr MyFundedFutures-Konto sind drei getrennte Benutzernamen. TradingView hält jeweils nur eine Broker-Sitzung, Sie können also physisch nicht über eine einzige TradingView-Broker-Verbindung mit allen drei Firmen verbunden sein. Das Signal ist in Ordnung. Die Verbindung ist der Engpass." },
    { type: "paragraph",html: "Unter derselben Beschwerde verbergen sich also zwei verschiedene Probleme. Wenn alle Ihre Konten unter einem Login liegen, was häufig der Fall ist, wenn eine einzelne Firma Ihnen mehrere Konten gibt, kann Tradovates eigene Funktion Group Trade die Order verteilen. Wenn Ihre Konten über verschiedene Firmen verstreut sind, benötigen Sie etwas außerhalb von TradingView, das dasselbe Signal gleichzeitig an viele Logins sendet." },
    { type: "heading",text: "Die häufigsten Ursachen, warum TradingView nur ein Konto erreicht" },
    { type: "heading",text: "1. Die Broker-Verbindung kann nur ein Konto gleichzeitig" },
    { type: "paragraph",html: "Die native Broker-Integration von TradingView ist eine Eins-zu-eins-Sitzung. Sie authentifiziert einen einzelnen Tradovate-Benutzernamen und stellt die darunter liegenden Konten bereit. Das ist so vorgesehen und kein Fehler, das Trading Panel wurde nie dafür gebaut, einen einzelnen Alert an nicht zusammenhängende Konten zu verteilen." },
    { type: "heading",text: "2. Jede Prop Firm ist ein eigener Tradovate-Login" },
    { type: "paragraph",html: "Das ist die eigentliche Falle. Da Apex, Topstep, TakeProfitTrader, MyFundedFutures, EliteTraderFunding und die übrigen jeweils eigene Zugangsdaten ausgeben, bedeutet &ldquo;mehrere Prop-Konten&rdquo; fast immer &ldquo;mehrere Logins&rdquo;. Eine TradingView-Verbindung kann nicht gleichzeitig bei zwei Firmen eingeloggt sein, sodass der Alert immer nur die Firma erreicht, mit der Sie gerade verbunden sind." },
    { type: "heading",text: "3. Natives Group Trade überschreitet keine Firmengrenzen" },
    { type: "paragraph",html: "Tradovates Add-on Group Trade ist wirklich praktisch, gruppiert aber nur Konten, die <strong class='text-white'>denselben Login bzw. denselben Broker</strong> teilen. Jedes Konto einer Gruppe muss beim selben Broker liegen, Sie können kein persönliches Konto mit einem Prop-Konto mischen und auch nicht zwei verschiedene Firmen. Group Trade steuert außerdem keine ATM-Strategien oder automatisierten Brackets; Stopps und Ziele werden mit manuellen OCO-Orders gehandhabt." },
    { type: "heading",text: "4. Alerts feuern nur auf das ausgewählte Konto" },
    { type: "paragraph",html: "Selbst innerhalb eines einzelnen Logins mit mehreren Konten zielt ein einfacher Alert &ldquo;Order an Broker senden&rdquo; auf das eine Konto, das im Panel aktiv ist. Ohne aktiviertes Group Trade und ausgewählte Gruppe bleiben die anderen Konten unter demselben Login einfach untätig." },
    { type: "heading",text: "5. Sitzungs- und Gerätelimits werfen Verbindungen offline" },
    { type: "paragraph",html: "Tradovate begrenzt gleichzeitige Sitzungen pro Login. Wer Multi-Account-Trading mit Gewalt erzwingen will, indem er sich bei derselben Firma über mehrere Browser oder Geräte anmeldet, stößt auf Fehler zum Gerätekontingent und sieht Verbindungen abbrechen. Es sieht aus wie &ldquo;Copy-Trading ist kaputt&rdquo;, ist aber in Wahrheit ein Sitzungslimit-Problem." },
    { type: "heading",text: "So beheben Sie es: Schritt für Schritt" },
    { type: "heading",text: "Mehrere Konten unter EINEM Login beheben (natives Group Trade)" },
    { type: "paragraph",html: "Wenn Ihre Konten einen gemeinsamen Tradovate-Benutzernamen teilen, benötigen Sie überhaupt kein Drittanbieter-Tool." },
    {
      type: "steps",
      items: [
        { title: "Application Settings öffnen", html: "Öffnen Sie in der Tradovate-Web- oder Desktop-App die <strong class='text-white'>Application Settings</strong> und gehen Sie zum Bereich <strong class='text-white'>Add-Ons</strong>." },
        { title: "Group Trade aktivieren", html: "Aktivieren Sie das Add-on <strong class='text-white'>Group Trade</strong> und melden Sie sich dann ab und wieder an, damit die Funktion geladen wird." },
        { title: "Manage Groups öffnen", html: "Klicken Sie oben in der Plattform auf das <strong class='text-white'>Konto-Dropdown</strong> und wählen Sie <strong class='text-white'>Manage Groups</strong>, das erscheint nur, wenn mehr als ein Konto mit Ihrem Benutzernamen verknüpft ist." },
        { title: "Gruppe erstellen", html: "Klicken Sie im Gruppeneditor auf <strong class='text-white'>+</strong>, um eine Gruppe zu erstellen, benennen Sie sie und ziehen Sie dann Konten aus der Liste <strong class='text-white'>Available</strong> in die Liste <strong class='text-white'>Added Accounts</strong>." },
        { title: "Menge pro Konto festlegen", html: "Legen Sie für jedes Konto eine <strong class='text-white'>Ordermenge</strong> fest, damit jedes die gewünschte Größe handelt." },
        { title: "Gruppe vor dem Handel auswählen", html: "Wählen Sie die Gruppe im Konto-Dropdown aus, bevor Sie handeln. Orders, ob manuell platziert oder durch einen verbundenen TradingView-Alert ausgelöst, treffen nun alle Konten der Gruppe gleichzeitig." },
      ],
    },
    { type: "paragraph",html: "Behalten Sie die Grenzen von Group Trade im Blick: nur derselbe Broker, keine automatisierte ATM-/Bracket-Verwaltung, und Stopps und Ziele verwalten Sie als OCO-Orders." },
    { type: "heading",text: "Konten bei VERSCHIEDENEN Firmen beheben (externer Copier oder Webhook)" },
    { type: "paragraph",html: "Wenn Ihre Konten bei verschiedenen Prop Firms liegen, vereint kein nativer Schalter sie. Stattdessen leiten Sie das Signal außerhalb von TradingView." },
    {
      type: "steps",
      items: [
        { title: "Master-Konto wählen", html: "Wählen Sie ein <strong class='text-white'>Master-(Leit-)Konto</strong>, das Konto, auf dem Sie (oder Ihre Strategie) zuerst handeln." },
        { title: "Jedes Konto mit einem Copier verbinden", html: "Verbinden Sie jedes Ihrer Prop-Firm-Konten mit einem Trade-Copier oder einem Webhook-Automatisierungsdienst. Da diese Tools sich unabhängig in jedes Tradovate-Konto einloggen, sind sie nicht wie TradingView an einen einzigen Login gebunden." },
        { title: "Verteilung zuordnen", html: "Legen Sie fest, wie viele Kontrakte jedes Follower-Konto relativ zum Leitkonto handelt. Die Größe kann je Konto abweichen, sodass Sie die Limits jeder Firma einhalten." },
        { title: "Alert auf den Webhook richten", html: "Richten Sie Ihre TradingView-Strategie oder Ihren manuellen Alert statt auf eine einzelne Broker-Verbindung auf die <strong class='text-white'>Webhook-URL</strong> des Dienstes. Aus einem Alert werden nun viele Orders." },
        { title: "Mit einem kleinen Test-Trade prüfen", html: "Prüfen Sie mit einem kleinen Test-Trade, bevor Sie skalieren. Beobachten Sie die Fills über die Konten hinweg und bestätigen Sie, dass jede Firma die Order tatsächlich erhalten hat." },
      ],
    },
    { type: "paragraph",html: "Das ist das Modell hinter jedem Multi-Firmen-Copier: ein einzelner Auslöser, repliziert auf unbegrenzt viele Logins. Der Kompromiss ist Slippage, Orders erreichen jedes Konto mit kurzem Abstand und werden zu leicht unterschiedlichen Preisen ausgeführt, planen Sie Größe und Stopps daher entsprechend." },
    { type: "heading",text: "Tabelle zur Fehlerbehebung" },
    { type: "table", headers: ["Symptom","Bedeutung","Lösung"], rows: [
      ["Nur ein Konto ausgeführt","TradingView ist mit einem einzigen Login/Konto verbunden","Group Trade aktivieren (gleicher Login) oder externen Copier nutzen (firmenübergreifend)"],
      ["TradingView lässt mich kein zweites Konto hinzufügen","Das Broker-Panel hält jeweils nur eine Tradovate-Sitzung","Über einen Webhook-Copier routen, der sich in jedes Konto separat einloggt"],
      ["Group Trade zeigt meine andere Firma nicht","Group Trade umfasst nur Konten unter demselben Broker/Login","Externen Copier für die firmenübergreifende Verteilung nutzen"],
      ["Die Option Manage Groups fehlt","Mit diesem Benutzernamen ist nur ein Konto verknüpft","Group Trade braucht 2+ Konten unter einem Login; andernfalls extern kopieren"],
      ["Konten werden zu unterschiedlichen Preisen ausgeführt","Normaler Slippage, weil Orders nacheinander an die Konten gesendet werden","Größe dimensionieren und Stopps unter Annahme kleiner Abweichungen je Konto setzen"],
      ["Fehler wegen Gerätekontingent / Sitzungslimit","Zu viele gleichzeitige Sitzungen auf einem Login","Eine Sitzung pro Login handeln; die übrigen Verbindungen einem Copier überlassen"],
      ["Brackets/ATM werden in einer Gruppe nicht kopiert","Group Trade steuert keine ATM-Strategien","Stopps und Ziele als manuelle OCO-Orders verwalten oder einen Copier mit Bracket-Unterstützung nutzen"],
    ] },
    { type: "heading",text: "Vermeiden Sie das mit PickMyTrade" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Ein Alert, jedes Konto.</strong> Ein einzelner TradingView-Webhook verteilt sich auf alle Ihre Tradovate-Konten, über so viele Prop Firms, wie Sie betreiben, ohne Engpass pro Login.",
        "<strong class='text-white'>Größe pro Konto.</strong> Legen Sie unabhängige Mengen fest, damit jedes Konto die Limits seiner eigenen Firma einhält, die je nach Firma und Kontogröße variieren.",
        "<strong class='text-white'>Bracket & SL/TP-Unterstützung.</strong> Stopps und Ziele werden mit der kopierten Order mitgeführt, statt zurückzubleiben.",
        "<strong class='text-white'>Multi-Account-Synchronisierung.</strong> Dieselbe korrigierte Order wird auf jedes zugeordnete Konto gespiegelt und hält Ihr Buch konsistent.",
        "<strong class='text-white'>Ratenlimit-sicheres Routing.</strong> Der Orderfluss wird getaktet, sodass das Jonglieren mehrerer Logins Tradovates Sitzungs- und Anfragelimits nicht auslöst.",
      ],
    },
  ], es: [
    { type: "paragraph",html: "Imagine cinco evaluaciones financiadas en Tradovate, una en Apex, una en Topstep, un par en MyFundedFutures, y una estrategia limpia de TradingView que quiere disparar en todas ellas. Entonces pulsa conectar y TradingView le muestra exactamente <strong class='text-white'>una</strong> cuenta. Es el muro contra el que chocan los traders en cuanto intentan escalar cuentas de prop firms, y el motivo es simple: el vínculo de TradingView con el bróker se asocia a un único inicio de sesión de Tradovate a la vez. Se manifiesta como &ldquo;solo se ejecutó una cuenta&rdquo;, &ldquo;mis otras firmas no tomaron la operación&rdquo; o &ldquo;TradingView no me deja elegir una segunda cuenta&rdquo;. Nada de eso es un fallo. Es exactamente como debe comportarse una conexión uno a uno con el bróker, y la solución depende por completo de si sus cuentas están bajo el mismo inicio de sesión o repartidas entre distintas prop firms." },
    { type: "paragraph",html: "Ese es el hueco que cierran herramientas de automatización como PickMyTrade. En lugar de que TradingView le susurre a una sola cuenta, una alerta por webhook distribuye la misma señal a cada cuenta que usted asigne, sin importar qué firma la emitió." },
    {
      type: "checklist",
      heading: "Lista rápida para copiar una señal a varias cuentas prop",
      items: [
        "<strong class='text-white'>Confirme cuántos inicios de sesión tiene.</strong> Las cuentas de distintas prop firms usan distintos nombres de usuario de Tradovate, y TradingView se conecta a un solo usuario a la vez.",
        "<strong class='text-white'>¿Misma firma, varias cuentas?</strong> Use el add-on nativo Group Trade de Tradovate, que copia solo dentro de un inicio de sesión.",
        "<strong class='text-white'>¿Distintas firmas o distintos inicios de sesión?</strong> Un vínculo nativo de TradingView no puede abarcarlos. Necesitará un copiador de operaciones externo o un puente por webhook.",
        "<strong class='text-white'>Elija una cuenta maestra (principal).</strong> La mayoría de los copiadores ejecutan una vez en la cuenta principal y luego replican en las demás.",
        "<strong class='text-white'>Espere algo de slippage.</strong> Las ejecuciones entre cuentas no serán exactas al tick, así que el tamaño y los stops deben asumir pequeñas diferencias.",
        "<strong class='text-white'>Revise las reglas de automatización de cada firma.</strong> Muchas firmas permiten el copiado y la automatización por webhook, pero no todas; los límites varían según la firma y el tamaño de la cuenta, así que revise las reglas vigentes de su firma.",
      ],
    },
    { type: "heading",text: "Qué significa realmente &ldquo;Una señal, una cuenta&rdquo;" },
    { type: "paragraph",html: "Cuando conecta Tradovate con TradingView, inicia sesión con un <strong class='text-white'>único nombre de usuario de Tradovate</strong>. El Trading Panel de TradingView muestra entonces las cuentas vinculadas a ese inicio de sesión. Si una alerta enruta una orden a su bróker, llega a la cuenta a la que está conectado en ese momento y a ninguna otra. No existe un interruptor integrado de &ldquo;enviar a todas mis cuentas&rdquo; en el panel del bróker." },
    { type: "paragraph",html: "Por qué esto fastidia a los traders de prop firms: <strong class='text-white'>cada prop firm le entrega su propio inicio de sesión de Tradovate</strong>. Su cuenta de Apex, su cuenta de Topstep y su cuenta de MyFundedFutures son tres nombres de usuario distintos. TradingView mantiene una sola sesión de bróker a la vez, así que físicamente no puede estar conectado a las tres firmas mediante un único vínculo de bróker de TradingView. La señal está bien. El cuello de botella es la conexión." },
    { type: "paragraph",html: "Así que en realidad hay dos problemas distintos escondidos bajo la misma queja. Si todas sus cuentas están bajo un inicio de sesión, algo habitual cuando una sola firma le da varias cuentas, la propia función Group Trade de Tradovate puede distribuir la orden. Si sus cuentas están repartidas entre distintas firmas, necesita algo externo a TradingView que envíe la misma señal a varios inicios de sesión a la vez." },
    { type: "heading",text: "Principales causas de que TradingView solo llegue a una cuenta" },
    { type: "heading",text: "1. El vínculo con el bróker admite una cuenta a la vez" },
    { type: "paragraph",html: "La integración nativa de TradingView con el bróker es una sesión uno a uno. Autentica un único nombre de usuario de Tradovate y expone las cuentas que cuelgan de él. Es así por diseño, no un fallo: el Trading Panel nunca se diseñó para difundir una sola alerta a cuentas no relacionadas." },
    { type: "heading",text: "2. Cada prop firm es un inicio de sesión de Tradovate distinto" },
    { type: "paragraph",html: "Esta es la verdadera trampa. Como Apex, Topstep, TakeProfitTrader, MyFundedFutures, EliteTraderFunding y el resto emiten cada una sus propias credenciales, &ldquo;varias cuentas prop&rdquo; casi siempre significa &ldquo;varios inicios de sesión&rdquo;. Una conexión de TradingView no puede iniciar sesión en dos firmas a la vez, por lo que la alerta solo llega a la firma a la que está conectado en ese momento." },
    { type: "heading",text: "3. Group Trade nativo no cruza firmas" },
    { type: "paragraph",html: "El add-on Group Trade de Tradovate es realmente útil, pero solo agrupa cuentas que comparten el <strong class='text-white'>mismo inicio de sesión/bróker</strong>. Todas las cuentas de un grupo deben estar con el mismo bróker, no puede mezclar una cuenta personal con una cuenta prop ni dos firmas distintas. Group Trade tampoco gestiona estrategias ATM ni brackets automatizados; los stops y objetivos se manejan con órdenes OCO manuales." },
    { type: "heading",text: "4. Las alertas solo disparan en la cuenta seleccionada" },
    { type: "paragraph",html: "Incluso dentro de un único inicio de sesión con varias cuentas, una alerta simple de &ldquo;enviar orden al bróker&rdquo; apunta a la única cuenta activa en el panel. Sin Group Trade habilitado y un grupo seleccionado, las demás cuentas bajo ese mismo inicio de sesión se quedan inactivas." },
    { type: "heading",text: "5. Los límites de sesión y de dispositivos desconectan las conexiones" },
    { type: "paragraph",html: "Tradovate limita las sesiones simultáneas por inicio de sesión. Si intenta forzar el trading multicuenta iniciando sesión en la misma firma desde varios navegadores o dispositivos, se topará con errores de cuota de dispositivos y verá caerse las conexiones. Parece que &ldquo;el copy trading se rompió&rdquo;, pero en realidad es un problema de límite de sesiones." },
    { type: "heading",text: "Cómo solucionarlo: paso a paso" },
    { type: "heading",text: "Solución para varias cuentas bajo UN inicio de sesión (Group Trade nativo)" },
    { type: "paragraph",html: "Si sus cuentas comparten un único nombre de usuario de Tradovate, no necesita ninguna herramienta de terceros." },
    {
      type: "steps",
      items: [
        { title: "Abra Application Settings", html: "Abra <strong class='text-white'>Application Settings</strong> en la aplicación web o de escritorio de Tradovate y vaya a la sección <strong class='text-white'>Add-Ons</strong>." },
        { title: "Active Group Trade", html: "Active el add-on <strong class='text-white'>Group Trade</strong> y luego cierre sesión y vuelva a iniciarla para que se cargue la función." },
        { title: "Abra Manage Groups", html: "Haga clic en el <strong class='text-white'>menú desplegable de cuentas</strong> de la parte superior de la plataforma y elija <strong class='text-white'>Manage Groups</strong>; solo aparece cuando hay más de una cuenta vinculada a su nombre de usuario." },
        { title: "Cree el grupo", html: "En el editor de grupos, haga clic en <strong class='text-white'>+</strong> para crear un grupo, póngale nombre y arrastre las cuentas desde la lista <strong class='text-white'>Available</strong> a la lista <strong class='text-white'>Added Accounts</strong>." },
        { title: "Defina la cantidad por cuenta", html: "Defina una <strong class='text-white'>cantidad de orden</strong> por cuenta para que cada una opere el tamaño que usted desea." },
        { title: "Seleccione el grupo antes de operar", html: "Seleccione el grupo en el menú desplegable de cuentas antes de operar. Las órdenes, ya sean colocadas manualmente o disparadas desde una alerta conectada de TradingView, llegan ahora a todas las cuentas del grupo a la vez." },
      ],
    },
    { type: "paragraph",html: "Tenga presentes los límites de Group Trade: solo el mismo bróker, sin gestión automatizada de ATM/bracket, y gestionará los stops y objetivos como órdenes OCO." },
    { type: "heading",text: "Solución para cuentas en firmas DISTINTAS (copiador externo o webhook)" },
    { type: "paragraph",html: "Cuando sus cuentas están en distintas prop firms, ningún interruptor nativo las une. En su lugar, enrute la señal fuera de TradingView." },
    {
      type: "steps",
      items: [
        { title: "Elija una cuenta maestra", html: "Elija una <strong class='text-white'>cuenta maestra (principal)</strong>, la cuenta en la que usted (o su estrategia) actúa primero." },
        { title: "Conecte cada cuenta a un copiador", html: "Conecte cada una de sus cuentas de prop firms a un copiador de operaciones o a un servicio de automatización por webhook. Como estas herramientas inician sesión en cada cuenta de Tradovate de forma independiente, no están atadas a un único inicio de sesión como TradingView." },
        { title: "Defina la distribución", html: "Defina cuántos contratos opera cada cuenta seguidora en relación con la principal. El tamaño puede diferir por cuenta, de modo que respete los límites propios de cada firma." },
        { title: "Dirija su alerta al webhook", html: "Dirija su estrategia de TradingView o su alerta manual a la <strong class='text-white'>URL del webhook</strong> del servicio en lugar de a una única conexión de bróker. Una alerta se convierte ahora en varias órdenes." },
        { title: "Verifique con una pequeña operación de prueba", html: "Verifique con una pequeña operación de prueba antes de escalar. Observe las ejecuciones entre cuentas y confirme que cada firma recibió realmente la orden." },
      ],
    },
    { type: "paragraph",html: "Este es el modelo detrás de todo copiador multifirma: un único disparador replicado a un número ilimitado de inicios de sesión. La contrapartida es el slippage: las órdenes llegan a cada cuenta con un breve desfase y se ejecutan a precios ligeramente distintos, así que planifique el tamaño y los stops teniéndolo en cuenta." },
    { type: "heading",text: "Tabla de solución de problemas" },
    { type: "table", headers: ["Síntoma","Qué significa","Solución"], rows: [
      ["Solo se ejecutó una cuenta","TradingView está vinculado a un único inicio de sesión/cuenta","Active Group Trade (mismo inicio de sesión) o use un copiador externo (entre firmas)"],
      ["TradingView no me deja añadir una segunda cuenta","El panel del bróker mantiene una sola sesión de Tradovate a la vez","Enrute mediante un copiador por webhook que inicie sesión en cada cuenta por separado"],
      ["Group Trade no muestra mi otra firma","Group Trade solo abarca cuentas del mismo bróker/inicio de sesión","Use un copiador externo para la distribución entre firmas"],
      ["Falta la opción Manage Groups","Solo hay una cuenta vinculada a ese nombre de usuario","Group Trade necesita 2+ cuentas bajo un inicio de sesión; si no, copie externamente"],
      ["Las cuentas se ejecutan a precios distintos","Slippage normal por enrutar las órdenes a las cuentas de forma secuencial","Dimensione y coloque los stops asumiendo pequeñas diferencias por cuenta"],
      ["Error de cuota de dispositivos / límite de sesión","Demasiadas sesiones simultáneas en un inicio de sesión","Opere una sesión por inicio de sesión; deje que un copiador mantenga las demás conexiones"],
      ["Los brackets/ATM no se copian en un grupo","Group Trade no gestiona estrategias ATM","Gestione stops y objetivos como órdenes OCO manuales, o use un copiador que admita brackets"],
    ] },
    { type: "heading",text: "Evítelo con PickMyTrade" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Una alerta, todas las cuentas.</strong> Un único webhook de TradingView se distribuye a todas sus cuentas de Tradovate, en tantas prop firms como use, sin cuello de botella por inicio de sesión.",
        "<strong class='text-white'>Tamaño por cuenta.</strong> Defina cantidades independientes para que cada cuenta respete los límites de su propia firma, que varían según la firma y el tamaño de la cuenta.",
        "<strong class='text-white'>Compatibilidad con bracket y SL/TP.</strong> Los stops y objetivos viajan con la orden copiada en lugar de quedarse atrás.",
        "<strong class='text-white'>Sincronización multicuenta.</strong> La misma orden corregida se replica en cada cuenta asignada, manteniendo su libro coherente.",
        "<strong class='text-white'>Enrutamiento seguro frente a límites de frecuencia.</strong> El flujo de órdenes se espacia para que manejar varios inicios de sesión no active los límites de sesión y de solicitudes de Tradovate.",
      ],
    },
  ], fr: [
    { type: "paragraph",html: "Imaginez cinq évaluations financées sur Tradovate, une chez Apex, une chez Topstep, deux chez MyFundedFutures, et une stratégie TradingView propre que vous voulez déclencher sur chacune d'elles. Vous cliquez sur connexion et TradingView ne vous montre qu'<strong class='text-white'>un</strong> seul compte. C'est le mur contre lequel butent les traders dès qu'ils tentent de monter en charge sur des comptes de prop firms, et la raison est simple : la connexion de TradingView au courtier ne se lie qu'à un seul identifiant Tradovate à la fois. Cela se manifeste par &ldquo;un seul compte a été exécuté&rdquo;, &ldquo;mes autres firmes n'ont pas pris le trade&rdquo; ou &ldquo;TradingView ne me laisse pas choisir un deuxième compte&rdquo;. Rien de tout cela n'est un bug. C'est exactement le comportement attendu d'une connexion courtier un-à-un, et la solution dépend entièrement de la question de savoir si vos comptes sont sous le même identifiant ou répartis entre différentes prop firms." },
    { type: "paragraph",html: "C'est le fossé que comblent des outils d'automatisation comme PickMyTrade. Au lieu que TradingView ne murmure à un seul compte, une alerte par webhook diffuse le même signal à chaque compte que vous associez, quelle que soit la firme qui l'a émis." },
    {
      type: "checklist",
      heading: "Liste de contrôle rapide pour copier un signal sur plusieurs comptes prop",
      items: [
        "<strong class='text-white'>Vérifiez combien d'identifiants vous avez.</strong> Les comptes de différentes prop firms utilisent des noms d'utilisateur Tradovate différents, et TradingView ne se connecte qu'à un nom d'utilisateur à la fois.",
        "<strong class='text-white'>Même firme, plusieurs comptes ?</strong> Utilisez l'add-on natif Group Trade de Tradovate, qui ne copie qu'au sein d'un seul identifiant.",
        "<strong class='text-white'>Firmes ou identifiants différents ?</strong> Une connexion TradingView native ne peut pas les couvrir. Il vous faut un copieur de trades externe ou un pont par webhook.",
        "<strong class='text-white'>Choisissez un compte maître (principal).</strong> La plupart des copieurs exécutent une fois sur un compte principal, puis répliquent sur les autres.",
        "<strong class='text-white'>Attendez-vous à un peu de slippage.</strong> Les exécutions entre comptes ne seront pas parfaites au tick ; la taille et les stops doivent donc tenir compte de petits écarts.",
        "<strong class='text-white'>Vérifiez les règles d'automatisation de chaque firme.</strong> De nombreuses firmes autorisent la copie et l'automatisation par webhook, mais pas toutes ; les limites varient selon la firme et la taille du compte, vérifiez donc les règles en vigueur de votre firme.",
      ],
    },
    { type: "heading",text: "Ce que signifie réellement &ldquo;un signal, un compte&rdquo;" },
    { type: "paragraph",html: "Lorsque vous connectez Tradovate à TradingView, vous vous connectez avec un <strong class='text-white'>seul nom d'utilisateur Tradovate</strong>. Le Trading Panel de TradingView affiche alors les comptes liés à cet unique identifiant. Si une alerte route un ordre vers votre courtier, il arrive sur le compte auquel vous êtes connecté et nulle part ailleurs. Il n'existe aucun interrupteur intégré &ldquo;envoyer à tous mes comptes&rdquo; dans le panneau du courtier." },
    { type: "paragraph",html: "Voici pourquoi cela fait mal aux traders de prop firms : <strong class='text-white'>chaque prop firm vous remet son propre identifiant Tradovate</strong>. Votre compte Apex, votre compte Topstep et votre compte MyFundedFutures sont trois noms d'utilisateur distincts. TradingView ne tient qu'une session de courtier à la fois ; vous ne pouvez donc physiquement pas être connecté aux trois firmes via une seule connexion courtier TradingView. Le signal est bon. La connexion est le goulot d'étranglement." },
    { type: "paragraph",html: "Il y a donc en réalité deux problèmes différents cachés sous la même plainte. Si tous vos comptes sont sous un seul identifiant, ce qui est courant quand une seule firme vous donne plusieurs comptes, la fonction Group Trade de Tradovate peut diffuser l'ordre. Si vos comptes sont dispersés entre différentes firmes, il vous faut quelque chose en dehors de TradingView qui pousse le même signal vers plusieurs identifiants à la fois." },
    { type: "heading",text: "Principales causes pour lesquelles TradingView n'atteint qu'un seul compte" },
    { type: "heading",text: "1. La connexion au courtier ne gère qu'un compte à la fois" },
    { type: "paragraph",html: "L'intégration native de TradingView avec le courtier est une session un-à-un. Elle authentifie un seul nom d'utilisateur Tradovate et expose les comptes rattachés. C'est la conception voulue, pas un bug : le Trading Panel n'a jamais été conçu pour diffuser une alerte unique vers des comptes sans lien." },
    { type: "heading",text: "2. Chaque prop firm est un identifiant Tradovate distinct" },
    { type: "paragraph",html: "C'est le vrai piège. Comme Apex, Topstep, TakeProfitTrader, MyFundedFutures, EliteTraderFunding et les autres délivrent chacune leurs propres identifiants, &ldquo;plusieurs comptes prop&rdquo; signifie presque toujours &ldquo;plusieurs identifiants&rdquo;. Une connexion TradingView ne peut pas être connectée à deux firmes en même temps, de sorte que l'alerte n'atteint que la firme à laquelle vous êtes connecté." },
    { type: "heading",text: "3. Le Group Trade natif ne traverse pas les firmes" },
    { type: "paragraph",html: "L'add-on Group Trade de Tradovate est très pratique, mais il ne regroupe que les comptes partageant le <strong class='text-white'>même identifiant/courtier</strong>. Chaque compte d'un groupe doit être chez le même courtier : vous ne pouvez pas mélanger un compte personnel et un compte prop, ni deux firmes différentes. Group Trade ne pilote pas non plus les stratégies ATM ni les brackets automatisés ; les stops et objectifs se gèrent avec des ordres OCO manuels." },
    { type: "heading",text: "4. Les alertes ne se déclenchent que sur le compte sélectionné" },
    { type: "paragraph",html: "Même au sein d'un seul identifiant comportant plusieurs comptes, une simple alerte &ldquo;envoyer l'ordre au courtier&rdquo; vise le seul compte actif dans le panneau. Sans Group Trade activé et un groupe sélectionné, les autres comptes du même identifiant restent inactifs." },
    { type: "heading",text: "5. Les limites de session et d'appareils coupent les connexions" },
    { type: "paragraph",html: "Tradovate plafonne les sessions simultanées par identifiant. Si vous essayez de forcer le trading multi-comptes en connectant la même firme sur plusieurs navigateurs ou appareils, vous rencontrerez des erreurs de quota d'appareils et verrez les connexions tomber. Cela ressemble à &ldquo;le copy trading est cassé&rdquo;, mais c'est en réalité un problème de limite de sessions." },
    { type: "heading",text: "Comment le corriger : étape par étape" },
    { type: "heading",text: "Corriger plusieurs comptes sous UN seul identifiant (Group Trade natif)" },
    { type: "paragraph",html: "Si vos comptes partagent un seul nom d'utilisateur Tradovate, vous n'avez besoin d'aucun outil tiers." },
    {
      type: "steps",
      items: [
        { title: "Ouvrir Application Settings", html: "Ouvrez <strong class='text-white'>Application Settings</strong> dans l'application web ou de bureau Tradovate et rendez-vous dans la section <strong class='text-white'>Add-Ons</strong>." },
        { title: "Activer Group Trade", html: "Activez l'add-on <strong class='text-white'>Group Trade</strong>, puis déconnectez-vous et reconnectez-vous pour que la fonctionnalité se charge." },
        { title: "Ouvrir Manage Groups", html: "Cliquez sur le <strong class='text-white'>menu déroulant du compte</strong> en haut de la plateforme et choisissez <strong class='text-white'>Manage Groups</strong> ; il n'apparaît que lorsque plus d'un compte est lié à votre nom d'utilisateur." },
        { title: "Créer le groupe", html: "Dans l'éditeur de groupe, cliquez sur <strong class='text-white'>+</strong> pour créer un groupe, nommez-le, puis faites glisser les comptes de la liste <strong class='text-white'>Available</strong> vers la liste <strong class='text-white'>Added Accounts</strong>." },
        { title: "Définir la quantité par compte", html: "Définissez une <strong class='text-white'>quantité d'ordre</strong> par compte afin que chacun trade la taille souhaitée." },
        { title: "Sélectionner le groupe avant de trader", html: "Sélectionnez le groupe dans le menu déroulant du compte avant de trader. Les ordres, qu'ils soient passés manuellement ou déclenchés par une alerte TradingView connectée, touchent désormais tous les comptes du groupe en même temps." },
      ],
    },
    { type: "paragraph",html: "Gardez à l'esprit les limites de Group Trade : même courtier uniquement, pas de gestion automatisée ATM/bracket, et vous gérerez stops et objectifs sous forme d'ordres OCO." },
    { type: "heading",text: "Corriger des comptes entre firmes DIFFÉRENTES (copieur externe ou webhook)" },
    { type: "paragraph",html: "Lorsque vos comptes sont chez différentes prop firms, aucun interrupteur natif ne les réunit. Vous routez plutôt le signal en dehors de TradingView." },
    {
      type: "steps",
      items: [
        { title: "Choisir un compte maître", html: "Choisissez un <strong class='text-white'>compte maître (principal)</strong>, celui sur lequel vous (ou votre stratégie) agissez en premier." },
        { title: "Connecter chaque compte à un copieur", html: "Connectez chacun de vos comptes de prop firms à un copieur de trades ou à un service d'automatisation par webhook. Comme ces outils se connectent à chaque compte Tradovate indépendamment, ils ne sont pas enchaînés à un seul identifiant comme l'est TradingView." },
        { title: "Définir la diffusion", html: "Définissez combien de contrats chaque compte suiveur trade par rapport au compte principal. La taille peut différer par compte, afin de respecter les limites propres à chaque firme." },
        { title: "Pointer votre alerte vers le webhook", html: "Pointez votre stratégie TradingView ou votre alerte manuelle vers l'<strong class='text-white'>URL du webhook</strong> du service au lieu d'une connexion courtier unique. Une alerte devient désormais plusieurs ordres." },
        { title: "Vérifier avec un petit trade de test", html: "Vérifiez avec un petit trade de test avant de monter en charge. Observez les exécutions sur les comptes et confirmez que chaque firme a bien reçu l'ordre." },
      ],
    },
    { type: "paragraph",html: "C'est le modèle derrière tout copieur multi-firmes : un seul déclencheur, répliqué vers un nombre illimité d'identifiants. La contrepartie est le slippage : les ordres atteignent chaque compte avec un léger décalage et s'exécutent à des prix légèrement différents ; prévoyez donc la taille et les stops en conséquence." },
    { type: "heading",text: "Tableau de dépannage" },
    { type: "table", headers: ["Symptôme","Signification","Solution"], rows: [
