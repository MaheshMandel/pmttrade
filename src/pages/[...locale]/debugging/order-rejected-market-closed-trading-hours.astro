---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "order-rejected-market-closed-trading-hours";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/debugging/${SLUG}`;

const META_TITLE = "Tradovate 'MarketClosed' Order Rejection Explained";
const META_DESCRIPTION =
  "Tradovate 'MarketClosed' rejection means you ordered outside session hours. Learn futures trading times, maintenance breaks and holidays to trade clean.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Tradovate-Ablehnung „MarketClosed“ erklärt", es: "Rechazo «MarketClosed» de Tradovate explicado", fr: "Le rejet « MarketClosed » de Tradovate expliqué", it: "Il rifiuto «MarketClosed» di Tradovate spiegato" },
  dek: { en: "A clean entry on ES or NQ bounces back as MarketClosed. Nine times out of ten it's about timing, not your account. Here's every window that triggers it and how to fix your automation.", de: "Ein sauberer Einstieg bei ES oder NQ kommt als MarketClosed zurück. In neun von zehn Fällen liegt es am Timing, nicht an Ihrem Konto. Hier sind alle Zeitfenster, die den Fehler auslösen, und so korrigieren Sie Ihre Automatisierung.", es: "Una entrada limpia en ES o NQ rebota como MarketClosed. En nueve de cada diez casos se trata del horario, no de su cuenta. Estas son todas las franjas que lo provocan y cómo corregir su automatización.", fr: "Une entrée propre sur ES ou NQ est renvoyée avec le motif MarketClosed. Neuf fois sur dix, c'est une question d'horaire, pas de compte. Voici toutes les plages qui le déclenchent et comment corriger votre automatisation.", it: "Un ingresso pulito su ES o NQ torna indietro come MarketClosed. Nove volte su dieci dipende dall'orario, non dal Suo conto. Ecco tutte le fasce che lo causano e come correggere la Sua automazione." },
  readTime: { en: "7 min read", de: "7 Min. Lesezeit", es: "Lectura de 7 min", fr: "Lecture : 7 min", it: "Lettura di 7 min" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "You line up a clean entry on ES or NQ, hit buy, and Tradovate bounces it right back with a blunt reason code: <strong class='text-white'>MarketClosed</strong>. It's one of the most common rejections you'll ever see on the platform, and nine times out of ten it comes down to one thing, timing. The contract you're trying to trade simply isn't in an open session at the instant your order reaches the exchange. Maybe it's the nightly maintenance break. Maybe it's the weekend gap, a market holiday, or an instrument whose hours don't line up with the equity-index futures you usually trade." },
    { type: "paragraph", html: "Here's the reassuring part: unlike a risk block or a margin rejection, MarketClosed is almost never about your account. It's about the clock. This guide walks through exactly what the error means, the causes that trigger it, how to clear each one, and how to stop it from quietly killing your automated orders overnight." },
    {
      type: "checklist",
      heading: "Quick Checklist for MarketClosed Rejections",
      items: [
        "<strong class='text-white'>Confirm the session is actually open</strong>, CME Globex runs Sunday 5:00 PM CT through Friday 4:00 PM CT. Anything outside that window rejects.",
        "<strong class='text-white'>Mind the daily maintenance break</strong>, no trading from 4:00 PM to 5:00 PM CT, Monday through Thursday.",
        "<strong class='text-white'>Check the specific instrument, not just \"futures\"</strong>, energy, metals, agricultural and crypto contracts keep their own hours that differ from S&amp;P and Nasdaq futures.",
        "<strong class='text-white'>Watch for holidays and early closes</strong>, exchange closures and shortened sessions change every year, so pull the current calendar.",
        "<strong class='text-white'>Read the real reject reason</strong>, open the rejected order in the Orders module and confirm it says MarketClosed, not a look-alike like a risk, margin, or expired-contract block.",
        "<strong class='text-white'>On prop or evaluation accounts, confirm the firm's trading window</strong>, some firms restrict hours further, and those rules vary by firm and account.",
      ],
    },
    { type: "heading", text: "What \"MarketClosed\" Means" },
    { type: "paragraph", html: "MarketClosed is the reason Tradovate hands back when the exchange's matching engine for that product isn't accepting orders at the instant your order lands. Futures don't trade continuously around the clock. Every contract has a defined session, plus scheduled breaks and holiday closures. Submit an order into one of those gaps and the exchange refuses it, Tradovate just relays that refusal back to you as MarketClosed." },
    { type: "paragraph", html: "The nuance worth understanding: this schedule is set by the exchange, not by Tradovate. For most Tradovate products that's CME Group's Globex platform. Tradovate is only the messenger. That's why you can't &ldquo;fix&rdquo; a MarketClosed rejection by flipping an account setting, the market genuinely isn't open. It's also why the same order that bounces at 4:30 PM CT sails straight through at 5:05 PM CT once the session reopens." },
    { type: "paragraph", html: "MarketClosed is easy to confuse with other rejections that also stop an order dead, an expired or wrong-month contract, a risk-parameter block, or a &ldquo;no quote available&rdquo; message. Those need different fixes. So before you troubleshoot, open the order and read the exact reason string. Solve the right problem." },
    { type: "heading", text: "Top Causes of MarketClosed Rejections" },
    { type: "heading", text: "1. You Placed the Order Outside the Instrument's Regular Session" },
    { type: "paragraph", html: "The most frequent cause, by a wide margin. CME Globex equity-index futures, ES, MES, NQ, MNQ, trade Sunday 5:00 PM CT to Friday 4:00 PM CT. If your order lands after Friday's close, before Sunday's reopen, or during any daily break, it rejects as MarketClosed." },
    { type: "heading", text: "2. The Daily Maintenance Break (4:00–5:00 PM CT)" },
    { type: "paragraph", html: "Globex takes a one-hour maintenance break from 4:00 PM to 5:00 PM CT, Monday through Thursday. It's a hard stop, no orders accepted, no exceptions. If you're scalping the late-afternoon move you'll get caught by this constantly, especially with an automated strategy that keeps firing after 4:00 PM." },
    { type: "heading", text: "3. The Weekend Gap (Friday 4:00 PM to Sunday 5:00 PM CT)" },
    { type: "paragraph", html: "Once Friday's 4:00 PM CT close hits, the market stays shut all weekend and doesn't reopen until Sunday 5:00 PM CT. Anything you submit in that roughly 49-hour window, including alerts that fire on stale weekend data, gets rejected." },
    { type: "heading", text: "4. Market Holidays and Early Closes" },
    { type: "paragraph", html: "Exchanges close fully on certain U.S. holidays and shorten the session, an early close, around others. The exact dates and early-close times shift every year and vary by product, so a session that's normally open can be closed or truncated on a given day. Check the current exchange holiday calendar rather than assuming last year's schedule still holds." },
    { type: "heading", text: "5. A Product with Different Hours or a Scheduled Halt" },
    { type: "paragraph", html: "Not every futures contract shares equity-index hours. Energy (NYMEX), metals (COMEX), agricultural (CBOT) and crypto products each run their own sessions and pauses. Equity-index futures also observe a brief settlement halt from 3:15 PM to 3:30 PM CT on the last business day of each month. If one symbol rejects while another trades fine, odds are you're sitting inside that specific product's closed window." },
    { type: "heading", text: "How to Fix MarketClosed Rejections: Step-by-Step" },
    {
      type: "steps",
      items: [
        { title: "Confirm it is really MarketClosed", html: "Don't guess. Open the <strong class='text-white'>Orders</strong> module, click the rejected order, and read the reason in the order details. Make sure it's MarketClosed and not a look-alike like a risk block or an expired contract, each of those has a different fix. If you prefer, pull the order up in the Reports module by its order number to see the full detail." },
        { title: "Check the instrument against its trading hours", html: "Compare the current Central Time to the contract's published session. Open the instrument's contract specifications, or its info panel, to confirm the exact trading hours for that specific product, energy, metals, ag and crypto contracts don't follow equity-index hours. If you're outside the window, that's your answer. Wait for the session to open." },
        { title: "Rule out the maintenance break, weekend, or holiday", html: "If the clock reads between 4:00 PM and 5:00 PM CT (Mon&ndash;Thu), wait until 5:00 PM CT and resend. If it's the weekend, the market reopens Sunday at 5:00 PM CT. If it's a holiday or early-close day, check the current exchange holiday calendar, and on a prop account, your firm's announcements, to see when the session resumes. A fast sanity check is the quotes tab: a live, moving bid/ask means the market is open; a frozen or empty quote usually means it's closed." },
        { title: "Fix your automation's timing", html: "If a bot, TradingView strategy, or bridge keeps firing into a closed market, the rejection repeats every single time. Add a time filter to your strategy so it only sends orders during the instrument's live session, pause automation across the maintenance break and weekend, and account for holidays. This is the single biggest source of overnight MarketClosed spam you'll find in your logs." },
      ],
    },
    { type: "heading", text: "Troubleshooting Table" },
    {
      type: "table",
      headers: ["Error / Scenario", "Meaning", "Fix"],
      rows: [
        ["<strong class='text-white'>MarketClosed</strong>", "The instrument's exchange session isn't open right now", "Wait for the session to open; only submit orders within trading hours"],
        ["Rejected between 4:00&ndash;5:00 PM CT (Mon&ndash;Thu)", "Daily Globex maintenance break", "Resend after the 5:00 PM CT reopen"],
        ["Rejected Friday evening, Saturday, or Sunday before 5:00 PM CT", "Weekend gap", "Wait for the Sunday 5:00 PM CT reopen"],
        ["MarketClosed on a normal trading day", "Market holiday or early close", "Check the current exchange holiday calendar; timing varies by year and product"],
        ["MarketClosed on one symbol but not another", "That product has different hours or a scheduled halt", "Verify that specific contract's session and any daily pause"],
        ["&ldquo;Liquidation Only&rdquo; / &ldquo;Contract about to expire&rdquo; (look-alike)", "Not an hours issue, rollover or expiry", "Roll to the active front-month contract"],
      ],
    },
    { type: "heading", text: "Prevent This with PickMyTrade" },
    { type: "paragraph", html: "If TradingView is the brain behind your Tradovate orders, PickMyTrade is the wiring that carries each signal to your account, and a cleaner pipeline means fewer avoidable rejections:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Fires only when your strategy triggers</strong>, orders go out only when your TradingView alert actually fires, so a session-based strategy is far less likely to shoot into a closed market.",
        "<strong class='text-white'>Symbol &amp; quantity validation</strong>, catches wrong-contract or malformed symbols before they're routed, so a bad symbol never masquerades as a market issue.",
        "<strong class='text-white'>Multi-account sync</strong>, mirrors each valid order across every linked Tradovate account in one step instead of firing them one at a time.",
        "<strong class='text-white'>Rate-limit-safe routing</strong>, spaces out order flow on reconnects so a burst of alerts doesn't bounce.",
      ],
    },
  ], de: [
    { type: "paragraph",html: "Sie haben einen sauberen Einstieg bei ES oder NQ vorbereitet, klicken auf Kaufen, und Tradovate schickt die Order sofort mit einem knappen Fehlercode zurück: <strong class='text-white'>MarketClosed</strong>. Es ist eine der häufigsten Ablehnungen auf der Plattform, und in neun von zehn Fällen liegt es an einer Sache, dem Timing. Der Kontrakt, den Sie handeln möchten, befindet sich im Moment, in dem Ihre Order die Börse erreicht, schlicht nicht in einer offenen Sitzung. Vielleicht ist es die nächtliche Wartungspause. Vielleicht die Wochenendlücke, ein Börsenfeiertag oder ein Instrument, dessen Handelszeiten nicht zu den Aktienindex-Futures passen, die Sie sonst handeln." },
    { type: "paragraph",html: "Das Beruhigende daran: Anders als eine Risikosperre oder eine Margin-Ablehnung hat MarketClosed fast nie etwas mit Ihrem Konto zu tun. Es geht um die Uhrzeit. Diese Anleitung erklärt genau, was der Fehler bedeutet, welche Ursachen ihn auslösen, wie Sie jede davon beheben und wie Sie verhindern, dass er Ihre automatisierten Orders über Nacht stillschweigend ausbremst." },
    {
      type: "checklist",
      heading: "Kurze Checkliste bei MarketClosed-Ablehnungen",
      items: [
        "<strong class='text-white'>Prüfen Sie, ob die Sitzung tatsächlich geöffnet ist</strong>, CME Globex läuft von Sonntag 17:00 Uhr CT bis Freitag 16:00 Uhr CT. Alles außerhalb dieses Fensters wird abgelehnt.",
        "<strong class='text-white'>Beachten Sie die tägliche Wartungspause</strong>, kein Handel von 16:00 bis 17:00 Uhr CT, Montag bis Donnerstag.",
        "<strong class='text-white'>Prüfen Sie das konkrete Instrument, nicht nur „Futures“</strong>, Energie-, Metall-, Agrar- und Krypto-Kontrakte haben eigene Handelszeiten, die sich von S&amp;P- und Nasdaq-Futures unterscheiden.",
        "<strong class='text-white'>Achten Sie auf Feiertage und vorzeitige Schließungen</strong>, Börsenschließungen und verkürzte Sitzungen ändern sich jedes Jahr, rufen Sie daher den aktuellen Kalender ab.",
        "<strong class='text-white'>Lesen Sie den tatsächlichen Ablehnungsgrund</strong>, öffnen Sie die abgelehnte Order im Modul „Orders“ und bestätigen Sie, dass dort MarketClosed steht und nicht eine ähnliche Sperre wegen Risiko, Margin oder abgelaufenem Kontrakt.",
        "<strong class='text-white'>Prüfen Sie bei Prop- oder Evaluierungskonten das Handelsfenster der Firma</strong>, manche Firmen schränken die Handelszeiten weiter ein, und diese Regeln unterscheiden sich je nach Firma und Konto.",
      ],
    },
    { type: "heading",text: "Was „MarketClosed“ bedeutet" },
    { type: "paragraph",html: "MarketClosed ist der Grund, den Tradovate zurückgibt, wenn die Matching-Engine der Börse für dieses Produkt im Moment des Orderzugangs keine Orders annimmt. Futures werden nicht rund um die Uhr durchgehend gehandelt. Jeder Kontrakt hat eine definierte Sitzung sowie geplante Pausen und Feiertagsschließungen. Wenn Sie eine Order in eine dieser Lücken senden, lehnt die Börse sie ab, und Tradovate gibt diese Ablehnung lediglich als MarketClosed an Sie weiter." },
    { type: "paragraph",html: "Die Nuance, die man verstehen sollte: Dieser Zeitplan wird von der Börse festgelegt, nicht von Tradovate. Für die meisten Tradovate-Produkte ist das die Globex-Plattform der CME Group. Tradovate ist nur der Bote. Deshalb lässt sich eine MarketClosed-Ablehnung nicht durch eine Kontoeinstellung &ldquo;beheben&rdquo;, der Markt ist tatsächlich nicht geöffnet. Es ist auch der Grund, warum dieselbe Order, die um 16:30 Uhr CT abprallt, um 17:05 Uhr CT nach der Wiedereröffnung der Sitzung problemlos durchgeht." },
    { type: "paragraph",html: "MarketClosed lässt sich leicht mit anderen Ablehnungen verwechseln, die eine Order ebenfalls stoppen, etwa ein abgelaufener oder falscher Kontraktmonat, eine Risikoparameter-Sperre oder die Meldung &ldquo;no quote available&rdquo;. Diese erfordern andere Lösungen. Öffnen Sie daher vor der Fehlersuche die Order und lesen Sie den genauen Grund. Lösen Sie das richtige Problem." },
    { type: "heading",text: "Häufigste Ursachen für MarketClosed-Ablehnungen" },
    { type: "heading",text: "1. Sie haben die Order außerhalb der regulären Sitzung des Instruments platziert" },
    { type: "paragraph",html: "Die mit Abstand häufigste Ursache. CME-Globex-Aktienindex-Futures, ES, MES, NQ, MNQ, werden von Sonntag 17:00 Uhr CT bis Freitag 16:00 Uhr CT gehandelt. Trifft Ihre Order nach dem Freitagsschluss, vor der Sonntagseröffnung oder während einer täglichen Pause ein, wird sie als MarketClosed abgelehnt." },
    { type: "heading",text: "2. Die tägliche Wartungspause (16:00–17:00 Uhr CT)" },
    { type: "paragraph",html: "Globex legt von Montag bis Donnerstag eine einstündige Wartungspause von 16:00 bis 17:00 Uhr CT ein. Das ist ein harter Stopp, keine Orders werden angenommen, keine Ausnahmen. Wenn Sie die Bewegung am späten Nachmittag scalpen, werden Sie dadurch ständig erwischt, besonders mit einer automatisierten Strategie, die nach 16:00 Uhr weiter feuert." },
    { type: "heading",text: "3. Die Wochenendlücke (Freitag 16:00 Uhr bis Sonntag 17:00 Uhr CT)" },
    { type: "paragraph",html: "Sobald der Freitagsschluss um 16:00 Uhr CT erreicht ist, bleibt der Markt das ganze Wochenende geschlossen und öffnet erst am Sonntag um 17:00 Uhr CT wieder. Alles, was Sie in diesem rund 49-stündigen Fenster senden, einschließlich Alerts, die auf veralteten Wochenenddaten auslösen, wird abgelehnt." },
    { type: "heading",text: "4. Börsenfeiertage und vorzeitige Schließungen" },
    { type: "paragraph",html: "Börsen schließen an bestimmten US-Feiertagen vollständig und verkürzen die Sitzung, eine vorzeitige Schließung, an anderen. Die genauen Termine und Zeiten der vorzeitigen Schließung ändern sich jedes Jahr und variieren je nach Produkt, sodass eine normalerweise geöffnete Sitzung an einem bestimmten Tag geschlossen oder verkürzt sein kann. Prüfen Sie den aktuellen Börsen-Feiertagskalender, statt davon auszugehen, dass der Plan des Vorjahres noch gilt." },
    { type: "heading",text: "5. Ein Produkt mit anderen Handelszeiten oder einer geplanten Unterbrechung" },
    { type: "paragraph",html: "Nicht jeder Futures-Kontrakt teilt die Zeiten der Aktienindizes. Energie (NYMEX), Metalle (COMEX), Agrar (CBOT) und Krypto-Produkte haben jeweils eigene Sitzungen und Pausen. Aktienindex-Futures haben außerdem am letzten Geschäftstag jedes Monats eine kurze Abrechnungspause von 15:15 bis 15:30 Uhr CT. Wird ein Symbol abgelehnt, während ein anderes problemlos handelbar ist, befinden Sie sich sehr wahrscheinlich im Schließfenster genau dieses Produkts." },
    { type: "heading",text: "MarketClosed-Ablehnungen beheben: Schritt für Schritt" },
    {
      type: "steps",
      items: [
        { title: "Bestätigen Sie, dass es wirklich MarketClosed ist", html: "Raten Sie nicht. Öffnen Sie das Modul <strong class='text-white'>Orders</strong>, klicken Sie auf die abgelehnte Order und lesen Sie den Grund in den Orderdetails. Stellen Sie sicher, dass es MarketClosed ist und nicht eine ähnliche Sperre wie eine Risikosperre oder ein abgelaufener Kontrakt, jede davon hat eine andere Lösung. Wenn Sie möchten, rufen Sie die Order im Modul „Reports“ anhand ihrer Ordernummer auf, um alle Details zu sehen." },
        { title: "Prüfen Sie das Instrument anhand seiner Handelszeiten", html: "Vergleichen Sie die aktuelle Central Time mit der veröffentlichten Sitzung des Kontrakts. Öffnen Sie die Kontraktspezifikationen oder das Infofenster des Instruments, um die genauen Handelszeiten für dieses Produkt zu bestätigen, Energie-, Metall-, Agrar- und Krypto-Kontrakte folgen nicht den Zeiten der Aktienindizes. Liegen Sie außerhalb des Fensters, ist das Ihre Antwort. Warten Sie, bis die Sitzung öffnet." },
        { title: "Schließen Sie Wartungspause, Wochenende oder Feiertag aus", html: "Wenn die Uhr zwischen 16:00 und 17:00 Uhr CT (Mo&ndash;Do) anzeigt, warten Sie bis 17:00 Uhr CT und senden Sie die Order erneut. Am Wochenende öffnet der Markt am Sonntag um 17:00 Uhr CT wieder. An einem Feiertag oder Tag mit vorzeitigem Schluss prüfen Sie den aktuellen Börsen-Feiertagskalender und bei einem Prop-Konto die Mitteilungen Ihrer Firma, um zu sehen, wann die Sitzung wieder beginnt. Ein schneller Plausibilitätscheck ist der Quotes-Tab: Ein lebendiges, sich bewegendes Bid/Ask bedeutet, dass der Markt offen ist; eine eingefrorene oder leere Quote bedeutet meist, dass er geschlossen ist." },
        { title: "Korrigieren Sie das Timing Ihrer Automatisierung", html: "Wenn ein Bot, eine TradingView-Strategie oder eine Bridge weiter in einen geschlossenen Markt feuert, wiederholt sich die Ablehnung jedes Mal. Fügen Sie Ihrer Strategie einen Zeitfilter hinzu, damit sie nur während der Live-Sitzung des Instruments Orders sendet, pausieren Sie die Automatisierung während der Wartungspause und am Wochenende und berücksichtigen Sie Feiertage. Das ist die größte Quelle für nächtlichen MarketClosed-Spam, den Sie in Ihren Logs finden werden." },
      ],
    },
    { type: "heading",text: "Fehlerbehebungstabelle" },
    { type: "table", headers: ["Fehler / Szenario","Bedeutung","Lösung"], rows: [
      ["<strong class='text-white'>MarketClosed</strong>","Die Börsensitzung des Instruments ist gerade nicht geöffnet","Warten Sie, bis die Sitzung öffnet; senden Sie Orders nur innerhalb der Handelszeiten"],
      ["Abgelehnt zwischen 16:00&ndash;17:00 Uhr CT (Mo&ndash;Do)","Tägliche Globex-Wartungspause","Senden Sie die Order nach der Wiedereröffnung um 17:00 Uhr CT erneut"],
      ["Abgelehnt am Freitagabend, Samstag oder Sonntag vor 17:00 Uhr CT","Wochenendlücke","Warten Sie auf die Wiedereröffnung am Sonntag um 17:00 Uhr CT"],
      ["MarketClosed an einem normalen Handelstag","Börsenfeiertag oder vorzeitige Schließung","Prüfen Sie den aktuellen Börsen-Feiertagskalender; die Zeiten variieren je nach Jahr und Produkt"],
      ["MarketClosed bei einem Symbol, bei einem anderen nicht","Dieses Produkt hat andere Handelszeiten oder eine geplante Unterbrechung","Prüfen Sie die Sitzung dieses konkreten Kontrakts und jede tägliche Pause"],
      ["&ldquo;Liquidation Only&rdquo; / &ldquo;Contract about to expire&rdquo; (ähnlicher Fehler)","Kein Problem der Handelszeiten, sondern Rollover oder Verfall","Wechseln Sie auf den aktiven Front-Month-Kontrakt"],
    ] },
    { type: "heading",text: "Vermeiden Sie das mit PickMyTrade" },
    { type: "paragraph",html: "Wenn TradingView das Gehirn hinter Ihren Tradovate-Orders ist, dann ist PickMyTrade die Verkabelung, die jedes Signal zu Ihrem Konto trägt, und eine sauberere Pipeline bedeutet weniger vermeidbare Ablehnungen:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Feuert nur, wenn Ihre Strategie auslöst</strong>, Orders werden nur gesendet, wenn Ihr TradingView-Alert tatsächlich auslöst, sodass eine sitzungsbasierte Strategie viel seltener in einen geschlossenen Markt feuert.",
        "<strong class='text-white'>Validierung von Symbol &amp; Menge</strong>, erkennt falsche Kontrakte oder fehlerhafte Symbole, bevor sie geroutet werden, sodass ein falsches Symbol nie als Marktproblem erscheint.",
        "<strong class='text-white'>Multi-Account-Sync</strong>, spiegelt jede gültige Order in einem Schritt auf alle verknüpften Tradovate-Konten, statt sie einzeln abzufeuern.",
        "<strong class='text-white'>Ratenlimit-sicheres Routing</strong>, verteilt den Orderfluss bei Wiederverbindungen, damit ein Schwall von Alerts nicht abprallt.",
      ],
    },
  ], es: [
    { type: "paragraph",html: "Prepara una entrada limpia en ES o NQ, pulsa comprar, y Tradovate se la devuelve al instante con un código de motivo seco: <strong class='text-white'>MarketClosed</strong>. Es uno de los rechazos más comunes que verá en la plataforma, y en nueve de cada diez casos se debe a una sola cosa, el horario. El contrato que intenta operar simplemente no está en una sesión abierta en el instante en que su orden llega al mercado. Quizá sea la pausa nocturna de mantenimiento. Quizá el hueco del fin de semana, un festivo bursátil o un instrumento cuyo horario no coincide con el de los futuros de índices que suele operar." },
    { type: "paragraph",html: "Lo tranquilizador: a diferencia de un bloqueo de riesgo o de un rechazo por margen, MarketClosed casi nunca tiene que ver con su cuenta. Tiene que ver con el reloj. Esta guía explica exactamente qué significa el error, las causas que lo provocan, cómo resolver cada una y cómo evitar que arruine en silencio sus órdenes automatizadas durante la noche." },
    {
      type: "checklist",
      heading: "Lista de comprobación rápida para rechazos MarketClosed",
      items: [
        "<strong class='text-white'>Confirme que la sesión está realmente abierta</strong>, CME Globex funciona de domingo a las 5:00 PM CT hasta viernes a las 4:00 PM CT. Todo lo que quede fuera de esa ventana se rechaza.",
        "<strong class='text-white'>Tenga en cuenta la pausa diaria de mantenimiento</strong>, no hay negociación de 4:00 PM a 5:00 PM CT, de lunes a jueves.",
        "<strong class='text-white'>Compruebe el instrumento concreto, no solo «futuros»</strong>, los contratos de energía, metales, agrícolas y cripto tienen horarios propios que difieren de los futuros del S&amp;P y del Nasdaq.",
        "<strong class='text-white'>Vigile festivos y cierres anticipados</strong>, los cierres del mercado y las sesiones reducidas cambian cada año, así que consulte el calendario vigente.",
        "<strong class='text-white'>Lea el motivo real del rechazo</strong>, abra la orden rechazada en el módulo Orders y confirme que dice MarketClosed, no un bloqueo parecido por riesgo, margen o contrato vencido.",
        "<strong class='text-white'>En cuentas prop o de evaluación, confirme la ventana de trading de la firma</strong>, algunas firmas restringen aún más el horario, y esas reglas varían según la firma y la cuenta.",
      ],
    },
    { type: "heading",text: "Qué significa «MarketClosed»" },
    { type: "paragraph",html: "MarketClosed es el motivo que Tradovate devuelve cuando el motor de casamiento del mercado para ese producto no acepta órdenes en el instante en que llega la suya. Los futuros no cotizan de forma continua las 24 horas. Cada contrato tiene una sesión definida, además de pausas programadas y cierres por festivos. Si envía una orden a uno de esos huecos, el mercado la rechaza y Tradovate simplemente le transmite ese rechazo como MarketClosed." },
    { type: "paragraph",html: "El matiz que conviene entender: este horario lo fija el mercado, no Tradovate. Para la mayoría de los productos de Tradovate se trata de la plataforma Globex de CME Group. Tradovate es solo el mensajero. Por eso no puede &ldquo;arreglar&rdquo; un rechazo MarketClosed cambiando un ajuste de la cuenta, el mercado realmente no está abierto. También explica por qué la misma orden que rebota a las 4:30 PM CT pasa sin problema a las 5:05 PM CT, cuando la sesión reabre." },
    { type: "paragraph",html: "MarketClosed se confunde fácilmente con otros rechazos que también detienen una orden, un contrato vencido o del mes equivocado, un bloqueo por parámetros de riesgo o un mensaje de &ldquo;no quote available&rdquo;. Esos requieren soluciones distintas. Por eso, antes de diagnosticar, abra la orden y lea la cadena exacta del motivo. Resuelva el problema correcto." },
    { type: "heading",text: "Principales causas de los rechazos MarketClosed" },
    { type: "heading",text: "1. Envió la orden fuera de la sesión regular del instrumento" },
    { type: "paragraph",html: "La causa más frecuente, con diferencia. Los futuros de índices bursátiles de CME Globex, ES, MES, NQ, MNQ, cotizan de domingo a las 5:00 PM CT hasta viernes a las 4:00 PM CT. Si su orden llega después del cierre del viernes, antes de la reapertura del domingo o durante cualquier pausa diaria, se rechaza como MarketClosed." },
    { type: "heading",text: "2. La pausa diaria de mantenimiento (4:00–5:00 PM CT)" },
    { type: "paragraph",html: "Globex hace una pausa de mantenimiento de una hora, de 4:00 PM a 5:00 PM CT, de lunes a jueves. Es una parada total, no se aceptan órdenes, sin excepciones. Si hace scalping en el movimiento de última hora de la tarde, le sorprenderá constantemente, sobre todo con una estrategia automatizada que sigue disparando después de las 4:00 PM." },
    { type: "heading",text: "3. El hueco del fin de semana (viernes 4:00 PM a domingo 5:00 PM CT)" },
    { type: "paragraph",html: "Cuando llega el cierre del viernes a las 4:00 PM CT, el mercado permanece cerrado todo el fin de semana y no reabre hasta el domingo a las 5:00 PM CT. Todo lo que envíe en esa ventana de unas 49 horas, incluidas las alertas que se disparan con datos obsoletos del fin de semana, se rechaza." },
    { type: "heading",text: "4. Festivos bursátiles y cierres anticipados" },
    { type: "paragraph",html: "Los mercados cierran por completo en ciertos festivos de EE. UU. y acortan la sesión, un cierre anticipado, en otros. Las fechas exactas y los horarios de cierre anticipado cambian cada año y varían según el producto, por lo que una sesión normalmente abierta puede estar cerrada o recortada un día concreto. Consulte el calendario de festivos del mercado vigente en lugar de dar por sentado que sigue valiendo el del año pasado." },
    { type: "heading",text: "5. Un producto con horario distinto o una pausa programada" },
    { type: "paragraph",html: "No todos los contratos de futuros comparten el horario de los índices bursátiles. Los productos de energía (NYMEX), metales (COMEX), agrícolas (CBOT) y cripto tienen sus propias sesiones y pausas. Los futuros de índices también observan una breve pausa de liquidación de 3:15 PM a 3:30 PM CT el último día hábil de cada mes. Si un símbolo se rechaza mientras otro cotiza sin problema, lo más probable es que esté dentro de la ventana de cierre de ese producto concreto." },
    { type: "heading",text: "Cómo corregir los rechazos MarketClosed: paso a paso" },
    {
      type: "steps",
      items: [
        { title: "Confirme que realmente es MarketClosed", html: "No adivine. Abra el módulo <strong class='text-white'>Orders</strong>, haga clic en la orden rechazada y lea el motivo en los detalles de la orden. Asegúrese de que es MarketClosed y no un bloqueo parecido, como un bloqueo de riesgo o un contrato vencido, cada uno tiene una solución distinta. Si lo prefiere, abra la orden en el módulo Reports por su número de orden para ver todo el detalle." },
        { title: "Compruebe el instrumento frente a su horario de negociación", html: "Compare la hora central actual con la sesión publicada del contrato. Abra las especificaciones del contrato o su panel de información para confirmar el horario exacto de ese producto, los contratos de energía, metales, agrícolas y cripto no siguen el horario de los índices bursátiles. Si está fuera de la ventana, ahí tiene la respuesta. Espere a que abra la sesión." },
        { title: "Descarte la pausa de mantenimiento, el fin de semana o un festivo", html: "Si el reloj marca entre las 4:00 PM y las 5:00 PM CT (lun&ndash;jue), espere hasta las 5:00 PM CT y vuelva a enviarla. Si es fin de semana, el mercado reabre el domingo a las 5:00 PM CT. Si es un festivo o un día de cierre anticipado, consulte el calendario de festivos del mercado vigente y, en una cuenta prop, los comunicados de su firma, para saber cuándo se reanuda la sesión. Una comprobación rápida es la pestaña de cotizaciones: un bid/ask en movimiento indica que el mercado está abierto; una cotización congelada o vacía suele indicar que está cerrado." },
        { title: "Corrija el horario de su automatización", html: "Si un bot, una estrategia de TradingView o un puente sigue disparando contra un mercado cerrado, el rechazo se repite cada vez. Añada un filtro horario a su estrategia para que solo envíe órdenes durante la sesión activa del instrumento, pause la automatización durante la pausa de mantenimiento y el fin de semana, y tenga en cuenta los festivos. Es la mayor fuente del spam nocturno de MarketClosed que encontrará en sus registros." },
      ],
    },
    { type: "heading",text: "Tabla de resolución de problemas" },
    { type: "table", headers: ["Error / escenario","Significado","Solución"], rows: [
      ["<strong class='text-white'>MarketClosed</strong>","La sesión del instrumento en el mercado no está abierta ahora mismo","Espere a que abra la sesión; envíe órdenes solo dentro del horario de negociación"],
