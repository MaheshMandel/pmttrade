---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "support-not-responding";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/debugging/${SLUG}`;

const META_TITLE = "Tradovate Support Not Responding to Emails";
const META_DESCRIPTION =
  "Tradovate support not responding to emails? Escalate across live chat, phone and tickets, document every request, and route prop issues to your firm.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Tradovate-Support antwortet nicht auf E-Mails", es: "El soporte de Tradovate no responde a los correos", fr: "Le support Tradovate ne répond pas aux e-mails", it: "Il supporto di Tradovate non risponde alle e-mail" },
  dek: { en: "A billing charge, a routing request, an outage ticket, and then nothing. Here's how to escalate across every channel, document everything, and send each request to the party that can actually act on it.", de: "Eine Abbuchung, eine Routing-Anfrage, ein Störungsticket und dann nichts. So eskalieren Sie über alle Kanäle, dokumentieren alles und richten jede Anfrage an die Stelle, die tatsächlich handeln kann.", es: "Un cargo de facturación, una solicitud de enrutamiento, un ticket por caída y luego nada. Así puede escalar por todos los canales, documentarlo todo y dirigir cada solicitud a quien realmente puede actuar.", fr: "Un prélèvement, une demande de routage, un ticket de panne, puis plus rien. Voici comment escalader sur tous les canaux, tout documenter et adresser chaque demande à l'interlocuteur qui peut réellement agir.", it: "Un addebito, una richiesta di routing, un ticket per un'interruzione e poi niente. Ecco come scalare su ogni canale, documentare tutto e indirizzare ogni richiesta alla parte che può davvero intervenire." },
  readTime: { en: "8 min read", de: "8 Min. Lesezeit", es: "Lectura de 8 min", fr: "Lecture : 8 min", it: "Lettura di 8 min" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "A billing charge you didn't expect, a data-routing request you need approved, an outage ticket you fired off mid-session, and then nothing. The email just sits there. When Tradovate support goes quiet, the silence costs you real money and a lot of peace of mind, because you're stuck waiting on a queue you can't see into. The pattern is almost always one of three things: an unanswered billing or refund email, a routing or entitlement request stuck in limbo, or an outage ticket that never gets a human reply. This guide walks you through how to escalate across every channel, document everything, and send each request to the party that can actually act on it, plus how automation helps keep your trades flowing so a slow support queue never turns into a stuck position." },
    {
      type: "checklist",
      heading: "Quick Checklist for Reaching Tradovate Support",
      items: [
        "<strong class='text-white'>Use live chat first, not email.</strong> The in-app chat queue moves far faster than the email or ticket backlog.",
        "<strong class='text-white'>Confirm who owns your account.</strong> Prop and evaluation accounts (Apex, Topstep, and similar) are handled by the firm, not by Tradovate.",
        "<strong class='text-white'>Call the right phone line.</strong> The Trade Desk is for live-position emergencies; the Support line is for account and billing questions during business hours.",
        "<strong class='text-white'>Open a formal ticket, not just an email.</strong> Get a case number so the request is tracked instead of sitting in a shared inbox.",
        "<strong class='text-white'>Document every contact.</strong> Save dates, times, screenshots, and case numbers, you'll need them for disputes and chargebacks.",
        "<strong class='text-white'>Escalate on a schedule.</strong> Follow up politely but persistently instead of sending one message and waiting indefinitely.",
      ],
    },
    { type: "heading", text: "What “Support Not Responding” Actually Means" },
    { type: "paragraph", html: "Tradovate runs a 24/5 futures desk, but not every request lands with the fast-moving trade desk. Account, billing, and data-agreement questions get routed to specialized teams, the billing and &ldquo;Financial Profile&rdquo; queues among them, and several of those teams work primarily by email with no direct inbound phone line. So when your support request seems to vanish, it's almost always one of these specialized email queues that's gone dark, not live chat or the trade desk." },
    { type: "paragraph", html: "The practical result is a backlog. A question a live chat agent could clear in minutes can sit for days once it's handed off to an email-only team. It gets worse: some first replies are automated or scripted, so a thread can look &ldquo;answered&rdquo; while your actual problem is untouched. And if you emailed the wrong party entirely, say, emailing Tradovate about a prop-firm evaluation account, you may be waiting on a team that has no authority to fix your issue in the first place." },
    { type: "paragraph", html: "The fix is rarely to send more emails into the same queue. It's to switch channels, verify who owns the request, and build a paper trail that supports an escalation or a payment dispute if the silence continues." },
    { type: "heading", text: "Top Causes of Tradovate Support Silence" },
    { type: "heading", text: "1. You emailed a specialized, email-only team" },
    { type: "paragraph", html: "Billing, refunds, data-routing, and financial-profile requests are handled by back-office teams that work by email and reply slowly. There's no dedicated phone line into these queues, so a single unanswered email can leave you with no obvious next step, which is exactly how a request ends up feeling like it disappeared." },
    { type: "heading", text: "2. Your issue actually belongs to your prop firm" },
    { type: "paragraph", html: "If you trade a funded or evaluation account through a firm like Apex or Topstep, Tradovate can help set up the initial connection but can't resolve account-specific issues, it has no visibility into that firm's rules, profit targets, drawdown limits, or resets. Tradovate's own guidance is to contact your evaluation provider directly for those questions. Emails to Tradovate about a prop account often go unanswered for a simple reason: the account isn't theirs to service." },
    { type: "heading", text: "3. Your ticket never actually opened" },
    { type: "paragraph", html: "An email sent to the wrong address, or a support form that failed to submit, may never generate a tracked case number. Without a case number, there's no record for an agent to pick up, so the request effectively vanishes, and your follow-ups reference a ticket that doesn't exist in the system." },
    { type: "heading", text: "4. You reached out during an outage or off-hours surge" },
    { type: "paragraph", html: "Support volume spikes hardest at exactly the moments you most need help, a platform outage at the open, or a data drop mid-session. During those surges the queue swamps, chat wait times balloon, and email replies slow to a crawl. Send an off-hours request to a business-hours team and you stack another delay on top." },
    { type: "heading", text: "5. The first reply was automated and the thread stalled" },
    { type: "paragraph", html: "Scripted or AI-style first responses tend to answer a generic version of your question and then go quiet. If you accept that reply as &ldquo;handled&rdquo; and stop pushing, the ticket can auto-close without your real issue ever reaching a human." },
    { type: "heading", text: "How to Fix Tradovate Support Silence: Step-by-Step" },
    { type: "heading", text: "Fixing an unanswered specialized-team email" },
    {
      type: "steps",
      items: [
        { title: "Switch to live chat", html: "Stop resending to the same inbox. Open the platform and click the <strong class='text-white'>Help (?)</strong> icon to reach live chat, which is answered far faster than email." },
        { title: "Ask for resolution or escalation", html: "Ask the chat agent to either resolve the request or escalate it internally and give you a <strong class='text-white'>case number</strong>." },
        { title: "Confirm the case number", html: "If chat routes you back to email, ask them to open the ticket on your behalf and confirm the case number in the chat transcript before you leave." },
      ],
    },
    { type: "heading", text: "Fixing a prop or evaluation account request" },
    {
      type: "steps",
      items: [
        { title: "Confirm the account type", html: "Confirm the account type. If it's a funded or evaluation account, your first contact should be the <strong class='text-white'>prop firm's</strong> support desk, not Tradovate." },
        { title: "Route account-rule questions to the firm", html: "Route rules, resets, drawdown, market-data enablement, and payout questions to the firm, Tradovate can't see or change those." },
        { title: "Escalate to Tradovate only if asked", html: "Only escalate to Tradovate if the firm confirms the problem is on the platform side and asks you to. Forward the firm's message so Tradovate has the context." },
      ],
    },
    { type: "heading", text: "Fixing a ticket that never opened" },
    {
      type: "steps",
      items: [
        { title: "Use the official ticket form", html: "Use the official contact form at Tradovate's <strong class='text-white'>Contact Support</strong> page (support.tradovate.com) rather than a plain email, so the request enters the ticket system." },
        { title: "Wait for a case number", html: "Wait for the automated confirmation containing a case number. No confirmation usually means no ticket, resubmit." },
        { title: "Reference the case number", html: "Reference that case number in every follow-up so agents can find the existing thread instead of starting over." },
      ],
    },
    { type: "heading", text: "Fixing an outage or emergency you can't wait on" },
    {
      type: "steps",
      items: [
        { title: "Call the Trade Desk for live positions", html: "For anything involving a <strong class='text-white'>live position</strong>, an order you can't cancel, a fill you can't exit, call the <strong class='text-white'>Trade Desk</strong> line, which covers market hours, instead of emailing." },
        { title: "Call Support for account/billing", html: "For account and billing matters, call the <strong class='text-white'>Support</strong> line during its posted business hours (Central Time). Hours change over time, so check the current hours on Tradovate's contact page before you call." },
        { title: "Manage risk on a backup connection", html: "If you can't get through and a position is exposed, manage risk through a backup connection or a second platform while you wait for the outage to clear." },
      ],
    },
    { type: "heading", text: "Building a paper trail that forces a response" },
    {
      type: "steps",
      items: [
        { title: "Keep a running log", html: "Keep a running log: every email, chat transcript, call time, agent name, and case number, all timestamped." },
        { title: "Screenshot as it happens", html: "Screenshot the charge, the error, or the outage as it happens, dated evidence is what wins a billing dispute later." },
        { title: "Use the record for a dispute if needed", html: "If a genuine billing charge stays unresolved after documented, persistent follow-up, you'll have the record you need to dispute the charge with your card issuer or bank." },
      ],
    },
    { type: "heading", text: "Troubleshooting Table" },
    {
      type: "table",
      headers: ["Symptom", "What it means", "Fix"],
      rows: [
        ["&ldquo;I requested a change by email with no reply&rdquo;", "Landed in a slow, email-only specialized queue", "Switch to live chat via the Help (?) icon and get a case number"],
        ["&ldquo;No response from support&rdquo; for days or weeks", "Backlogged billing/financial-profile team, no phone line", "Escalate through chat and a formal ticket; follow up on a schedule"],
        ["Prop/evaluation account issue ignored by Tradovate", "The account is owned by your firm, not Tradovate", "Contact your prop firm's support desk first"],
        ["No case-number confirmation after emailing", "Ticket never opened / wrong address", "Resubmit via the official Contact Support form and confirm the case number"],
        ["First reply was scripted, then silence", "Automated response; thread may auto-close", "Reply referencing the case number and ask for human escalation"],
        ["Can't reach anyone during an outage", "Support volume surge at the open or a data drop", "Call the Trade Desk for live positions; manage risk on a backup connection"],
        ["Charge unresolved after persistent follow-up", "Documented billing dispute with no resolution", "Use your log and screenshots to dispute the charge with your bank/card issuer"],
      ],
    },
    { type: "heading", text: "Prevent This with PickMyTrade" },
    { type: "paragraph", html: "You can't control Tradovate's email queue, but you can stop a slow support ticket from ever becoming a trading emergency. PickMyTrade bridges your TradingView alerts straight to Tradovate, so execution keeps running even when a support thread is stuck in limbo:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Multi-Account Sync</strong>, mirror the same corrected order across every connected account, so one platform hiccup doesn't leave positions out of step.",
        "<strong class='text-white'>Entitlement &amp; Risk Filters</strong>, respect prop-firm limits and data-agreement state up front, cutting the entitlement and routing tickets that clog the queue.",
        "<strong class='text-white'>Rate-Limit-Safe Routing</strong>, space out order flow so nothing bounces, avoiding the failed-order tickets that trigger support requests in the first place.",
        "<strong class='text-white'>Backup-Friendly Automation</strong>, keep alerts flowing to your account so a single unreachable channel never strands an open trade.",
      ],
    },
  ], de: [
    { type: "paragraph",html: "Eine unerwartete Abbuchung, eine Datenrouting-Anfrage, die genehmigt werden muss, ein Störungsticket, das Sie mitten in der Sitzung abgeschickt haben, und dann nichts. Die E-Mail liegt einfach da. Wenn der Tradovate-Support verstummt, kostet Sie das Schweigen echtes Geld und viel Gelassenheit, denn Sie warten auf eine Warteschlange, in die Sie nicht hineinsehen können. Meist steckt eine von drei Ursachen dahinter: eine unbeantwortete Abrechnungs- oder Rückerstattungs-E-Mail, eine Routing- oder Berechtigungsanfrage in der Schwebe oder ein Störungsticket, das nie eine menschliche Antwort bekommt. Diese Anleitung zeigt Ihnen, wie Sie über alle Kanäle eskalieren, alles dokumentieren und jede Anfrage an die Stelle richten, die tatsächlich handeln kann, und wie Automatisierung Ihre Trades am Laufen hält, damit eine langsame Support-Warteschlange nie zu einer festgefahrenen Position wird." },
    {
      type: "checklist",
      heading: "Kurz-Checkliste für die Kontaktaufnahme mit dem Tradovate-Support",
      items: [
        "<strong class='text-white'>Nutzen Sie zuerst den Live-Chat, nicht E-Mail.</strong> Die In-App-Chat-Warteschlange läuft deutlich schneller als der Rückstau bei E-Mails oder Tickets.",
        "<strong class='text-white'>Klären Sie, wem Ihr Konto gehört.</strong> Prop- und Evaluierungskonten (Apex, Topstep und ähnliche) werden von der Firma betreut, nicht von Tradovate.",
        "<strong class='text-white'>Rufen Sie die richtige Telefonleitung an.</strong> Der Trade Desk ist für Notfälle bei Live-Positionen da; die Support-Leitung für Konto- und Abrechnungsfragen während der Geschäftszeiten.",
        "<strong class='text-white'>Eröffnen Sie ein formelles Ticket, nicht nur eine E-Mail.</strong> Lassen Sie sich eine Fallnummer geben, damit die Anfrage nachverfolgt wird, statt in einem gemeinsamen Postfach zu liegen.",
        "<strong class='text-white'>Dokumentieren Sie jeden Kontakt.</strong> Speichern Sie Daten, Uhrzeiten, Screenshots und Fallnummern; Sie brauchen sie für Beschwerden und Rückbuchungen.",
        "<strong class='text-white'>Eskalieren Sie planmäßig.</strong> Haken Sie höflich, aber beharrlich nach, statt eine Nachricht zu senden und unbegrenzt zu warten.",
      ],
    },
    { type: "heading",text: "Was „Support antwortet nicht“ tatsächlich bedeutet" },
    { type: "paragraph",html: "Tradovate betreibt einen 24/5-Futures-Desk, aber nicht jede Anfrage landet beim schnellen Trade Desk. Fragen zu Konto, Abrechnung und Datenvereinbarungen werden an Spezialteams weitergeleitet, darunter die Warteschlangen für Abrechnung und &ldquo;Financial Profile&rdquo;, und mehrere dieser Teams arbeiten hauptsächlich per E-Mail ohne direkte eingehende Telefonleitung. Wenn Ihre Support-Anfrage also zu verschwinden scheint, ist es fast immer eine dieser spezialisierten E-Mail-Warteschlangen, die dunkel geworden ist, nicht der Live-Chat oder der Trade Desk." },
    { type: "paragraph",html: "Die praktische Folge ist ein Rückstau. Eine Frage, die ein Live-Chat-Mitarbeiter in Minuten klären könnte, kann Tage liegen, sobald sie an ein reines E-Mail-Team übergeben wurde. Es kommt noch schlimmer: Manche Erstantworten sind automatisiert oder vorgefertigt, sodass ein Vorgang &ldquo;beantwortet&rdquo; wirkt, während Ihr eigentliches Problem unberührt bleibt. Und wenn Sie die falsche Stelle angeschrieben haben, etwa Tradovate wegen eines Evaluierungskontos einer Prop-Firma, warten Sie womöglich auf ein Team, das gar keine Befugnis hat, Ihr Problem zu lösen." },
    { type: "paragraph",html: "Die Lösung besteht selten darin, weitere E-Mails in dieselbe Warteschlange zu schicken. Wechseln Sie den Kanal, klären Sie, wem die Anfrage gehört, und bauen Sie eine Dokumentation auf, die eine Eskalation oder einen Zahlungsstreit stützt, falls das Schweigen anhält." },
    { type: "heading",text: "Die häufigsten Ursachen für das Schweigen des Tradovate-Supports" },
    { type: "heading",text: "1. Sie haben ein spezialisiertes Team angeschrieben, das nur per E-Mail arbeitet" },
    { type: "paragraph",html: "Anfragen zu Abrechnung, Rückerstattungen, Datenrouting und Finanzprofil werden von Back-Office-Teams bearbeitet, die per E-Mail arbeiten und langsam antworten. Es gibt keine dedizierte Telefonleitung in diese Warteschlangen, sodass eine einzige unbeantwortete E-Mail Sie ohne erkennbaren nächsten Schritt zurücklassen kann, und genau so fühlt sich eine Anfrage an, die verschwunden ist." },
    { type: "heading",text: "2. Ihr Anliegen gehört eigentlich zu Ihrer Prop-Firma" },
    { type: "paragraph",html: "Wenn Sie ein finanziertes oder Evaluierungskonto über eine Firma wie Apex oder Topstep handeln, kann Tradovate bei der Ersteinrichtung der Verbindung helfen, aber keine kontospezifischen Probleme lösen; es hat keinen Einblick in die Regeln, Gewinnziele, Drawdown-Limits oder Resets der Firma. Tradovate selbst rät, sich bei solchen Fragen direkt an den Evaluierungsanbieter zu wenden. E-Mails an Tradovate zu einem Prop-Konto bleiben oft aus einem einfachen Grund unbeantwortet: Das Konto gehört nicht in deren Zuständigkeit." },
    { type: "heading",text: "3. Ihr Ticket wurde nie wirklich eröffnet" },
    { type: "paragraph",html: "Eine E-Mail an die falsche Adresse oder ein Support-Formular, das nicht abgeschickt wurde, erzeugt möglicherweise nie eine nachverfolgte Fallnummer. Ohne Fallnummer gibt es keinen Vorgang, den ein Mitarbeiter aufgreifen könnte, sodass die Anfrage faktisch verschwindet, und Ihre Nachfragen beziehen sich auf ein Ticket, das im System gar nicht existiert." },
    { type: "heading",text: "4. Sie haben sich während eines Ausfalls oder einer Welle außerhalb der Geschäftszeiten gemeldet" },
    { type: "paragraph",html: "Das Support-Aufkommen steigt genau dann am stärksten, wenn Sie Hilfe am dringendsten brauchen, bei einem Plattformausfall zur Eröffnung oder einem Datenausfall mitten in der Sitzung. In solchen Wellen läuft die Warteschlange über, die Chat-Wartezeiten schnellen in die Höhe und E-Mail-Antworten kommen nur noch im Schneckentempo. Eine Anfrage außerhalb der Geschäftszeiten an ein Team mit Geschäftszeiten bringt eine weitere Verzögerung obendrauf." },
    { type: "heading",text: "5. Die Erstantwort war automatisiert und der Vorgang stockte" },
    { type: "paragraph",html: "Vorgefertigte oder KI-artige Erstantworten beantworten tendenziell eine allgemeine Version Ihrer Frage und verstummen dann. Wenn Sie diese Antwort als &ldquo;erledigt&rdquo; hinnehmen und nicht weiter nachhaken, kann das Ticket automatisch geschlossen werden, ohne dass Ihr eigentliches Anliegen je einen Menschen erreicht." },
    { type: "heading",text: "So beheben Sie das Schweigen des Tradovate-Supports: Schritt für Schritt" },
    { type: "heading",text: "Unbeantwortete E-Mail an ein Spezialteam beheben" },
    {
      type: "steps",
      items: [
        { title: "Zum Live-Chat wechseln", html: "Hören Sie auf, erneut an dasselbe Postfach zu schreiben. Öffnen Sie die Plattform und klicken Sie auf das Symbol <strong class='text-white'>Help (?)</strong>, um den Live-Chat zu erreichen, der deutlich schneller beantwortet wird als E-Mail." },
        { title: "Um Lösung oder Eskalation bitten", html: "Bitten Sie den Chat-Mitarbeiter, die Anfrage entweder zu lösen oder intern zu eskalieren und Ihnen eine <strong class='text-white'>Fallnummer</strong> zu nennen." },
        { title: "Fallnummer bestätigen lassen", html: "Verweist der Chat Sie zurück auf E-Mail, bitten Sie darum, das Ticket in Ihrem Namen zu eröffnen und die Fallnummer im Chat-Transkript zu bestätigen, bevor Sie gehen." },
      ],
    },
    { type: "heading",text: "Anfrage zu einem Prop- oder Evaluierungskonto beheben" },
    {
      type: "steps",
      items: [
        { title: "Kontotyp klären", html: "Klären Sie den Kontotyp. Handelt es sich um ein finanziertes oder Evaluierungskonto, sollte Ihr erster Kontakt der Support der <strong class='text-white'>Prop-Firma</strong> sein, nicht Tradovate." },
        { title: "Kontoregel-Fragen an die Firma richten", html: "Richten Sie Fragen zu Regeln, Resets, Drawdown, Marktdaten-Freischaltung und Auszahlungen an die Firma; Tradovate kann diese weder einsehen noch ändern." },
        { title: "Nur auf Aufforderung an Tradovate eskalieren", html: "Eskalieren Sie nur dann an Tradovate, wenn die Firma bestätigt, dass das Problem auf Plattformseite liegt, und Sie darum bittet. Leiten Sie die Nachricht der Firma weiter, damit Tradovate den Kontext hat." },
      ],
    },
    { type: "heading",text: "Ein nie eröffnetes Ticket beheben" },
    {
      type: "steps",
      items: [
        { title: "Das offizielle Ticket-Formular nutzen", html: "Nutzen Sie das offizielle Kontaktformular auf der Seite <strong class='text-white'>Contact Support</strong> von Tradovate (support.tradovate.com) statt einer einfachen E-Mail, damit die Anfrage im Ticketsystem landet." },
        { title: "Auf eine Fallnummer warten", html: "Warten Sie auf die automatische Bestätigung mit einer Fallnummer. Keine Bestätigung bedeutet in der Regel: kein Ticket, also erneut einreichen." },
        { title: "Auf die Fallnummer verweisen", html: "Nennen Sie diese Fallnummer in jeder Nachfrage, damit Mitarbeiter den bestehenden Vorgang finden, statt von vorn zu beginnen." },
      ],
    },
    { type: "heading",text: "Einen Ausfall oder Notfall beheben, bei dem Sie nicht warten können" },
    {
      type: "steps",
      items: [
        { title: "Bei Live-Positionen den Trade Desk anrufen", html: "Bei allem, was eine <strong class='text-white'>Live-Position</strong> betrifft, eine Order, die Sie nicht stornieren können, eine Ausführung, aus der Sie nicht aussteigen können, rufen Sie die Leitung des <strong class='text-white'>Trade Desk</strong> an, die die Marktzeiten abdeckt, statt zu mailen." },
        { title: "Bei Konto/Abrechnung den Support anrufen", html: "Rufen Sie bei Konto- und Abrechnungsfragen die <strong class='text-white'>Support</strong>-Leitung während ihrer veröffentlichten Geschäftszeiten (Central Time) an. Die Zeiten ändern sich; prüfen Sie daher die aktuellen Zeiten auf der Kontaktseite von Tradovate, bevor Sie anrufen." },
        { title: "Risiko über eine Ersatzverbindung steuern", html: "Wenn Sie nicht durchkommen und eine Position ungeschützt ist, steuern Sie das Risiko über eine Ersatzverbindung oder eine zweite Plattform, während Sie auf das Ende des Ausfalls warten." },
      ],
    },
    { type: "heading",text: "Eine Dokumentation aufbauen, die eine Antwort erzwingt" },
    {
      type: "steps",
      items: [
        { title: "Ein fortlaufendes Protokoll führen", html: "Führen Sie ein fortlaufendes Protokoll: jede E-Mail, jedes Chat-Transkript, jede Anrufzeit, jeden Mitarbeiternamen und jede Fallnummer, alles mit Zeitstempel." },
        { title: "Screenshots sofort anfertigen", html: "Machen Sie Screenshots der Abbuchung, des Fehlers oder des Ausfalls, während sie auftreten; datierte Belege gewinnen später einen Abrechnungsstreit." },
        { title: "Die Dokumentation bei Bedarf für einen Streitfall nutzen", html: "Bleibt eine berechtigte Abbuchung trotz dokumentierter, beharrlicher Nachfragen ungeklärt, haben Sie die Unterlagen, die Sie brauchen, um die Abbuchung bei Ihrem Kartenaussteller oder Ihrer Bank anzufechten." },
      ],
    },
    { type: "heading",text: "Tabelle zur Fehlerbehebung" },
    { type: "table", headers: ["Symptom","Bedeutung","Lösung"], rows: [
      ["&ldquo;Ich habe per E-Mail eine Änderung beantragt, keine Antwort&rdquo;","Gelandet in einer langsamen, reinen E-Mail-Warteschlange eines Spezialteams","Per Help-(?)-Symbol zum Live-Chat wechseln und eine Fallnummer erhalten"],
      ["&ldquo;Keine Antwort vom Support&rdquo; seit Tagen oder Wochen","Rückstau im Abrechnungs-/Finanzprofil-Team, keine Telefonleitung","Über Chat und ein formelles Ticket eskalieren; planmäßig nachhaken"],
      ["Problem mit Prop-/Evaluierungskonto wird von Tradovate ignoriert","Das Konto gehört Ihrer Firma, nicht Tradovate","Zuerst den Support Ihrer Prop-Firma kontaktieren"],
      ["Keine Bestätigung mit Fallnummer nach der E-Mail","Ticket nie eröffnet / falsche Adresse","Über das offizielle Formular Contact Support erneut einreichen und die Fallnummer bestätigen lassen"],
      ["Erste Antwort war vorgefertigt, dann Stille","Automatische Antwort; der Vorgang kann automatisch geschlossen werden","Unter Nennung der Fallnummer antworten und um Eskalation an einen Menschen bitten"],
      ["Während eines Ausfalls erreicht man niemanden","Anfragewelle bei der Eröffnung oder ein Datenausfall","Bei Live-Positionen den Trade Desk anrufen; Risiko über eine Ersatzverbindung steuern"],
      ["Abbuchung nach beharrlichem Nachhaken ungeklärt","Dokumentierter Abrechnungsstreit ohne Lösung","Mit Protokoll und Screenshots die Abbuchung bei Bank/Kartenaussteller anfechten"],
    ] },
    { type: "heading",text: "Vorbeugen mit PickMyTrade" },
    { type: "paragraph",html: "Sie können die E-Mail-Warteschlange von Tradovate nicht kontrollieren, aber Sie können verhindern, dass ein langsames Support-Ticket je zum Trading-Notfall wird. PickMyTrade verbindet Ihre TradingView-Alerts direkt mit Tradovate, sodass die Ausführung weiterläuft, selbst wenn ein Support-Vorgang in der Schwebe hängt:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Multi-Konto-Synchronisierung</strong>, spiegelt dieselbe korrigierte Order auf alle verbundenen Konten, sodass ein Plattform-Aussetzer keine Positionen aus dem Takt bringt.",
        "<strong class='text-white'>Berechtigungs- &amp; Risikofilter</strong>, berücksichtigen Limits der Prop-Firma und den Stand der Datenvereinbarung von vornherein und verringern so die Berechtigungs- und Routing-Tickets, die die Warteschlange verstopfen.",
        "<strong class='text-white'>Ratenlimit-sicheres Routing</strong>, verteilt den Order-Fluss zeitlich, damit nichts zurückprallt, und vermeidet die Tickets zu fehlgeschlagenen Orders, die Support-Anfragen überhaupt erst auslösen.",
        "<strong class='text-white'>Ausfallfreundliche Automatisierung</strong>, hält Alerts weiter zu Ihrem Konto fließen, damit ein einzelner nicht erreichbarer Kanal nie einen offenen Trade strandet.",
      ],
    },
  ], es: [
    { type: "paragraph",html: "Un cargo de facturación que no esperaba, una solicitud de enrutamiento de datos que necesita que aprueben, un ticket por una caída que envió en plena sesión y luego nada. El correo simplemente se queda ahí. Cuando el soporte de Tradovate guarda silencio, ese silencio le cuesta dinero real y mucha tranquilidad, porque se queda esperando en una cola en la que no puede ver. El patrón casi siempre es uno de tres: un correo de facturación o reembolso sin responder, una solicitud de enrutamiento o de permisos atascada en el limbo, o un ticket por una caída que nunca recibe respuesta humana. Esta guía le explica cómo escalar por todos los canales, documentarlo todo y dirigir cada solicitud a quien realmente puede actuar, además de cómo la automatización mantiene sus operaciones en marcha para que una cola de soporte lenta nunca se convierta en una posición atascada." },
    {
      type: "checklist",
      heading: "Lista rápida para contactar con el soporte de Tradovate",
      items: [
        "<strong class='text-white'>Use primero el chat en vivo, no el correo.</strong> La cola del chat en la aplicación avanza mucho más rápido que la acumulación de correos o tickets.",
        "<strong class='text-white'>Confirme quién es el titular de su cuenta.</strong> Las cuentas de prop firm y de evaluación (Apex, Topstep y similares) las gestiona la firma, no Tradovate.",
        "<strong class='text-white'>Llame a la línea telefónica correcta.</strong> El Trade Desk es para emergencias con posiciones en vivo; la línea de Support es para consultas de cuenta y facturación en horario laboral.",
        "<strong class='text-white'>Abra un ticket formal, no solo un correo.</strong> Obtenga un número de caso para que la solicitud tenga seguimiento y no quede en un buzón compartido.",
        "<strong class='text-white'>Documente cada contacto.</strong> Guarde fechas, horas, capturas de pantalla y números de caso; los necesitará para disputas y contracargos.",
        "<strong class='text-white'>Escale con un calendario.</strong> Haga seguimiento con cortesía pero con persistencia, en lugar de enviar un mensaje y esperar indefinidamente.",
      ],
    },
    { type: "heading",text: "Qué significa realmente “El soporte no responde”" },
    { type: "paragraph",html: "Tradovate opera una mesa de futuros 24/5, pero no todas las solicitudes llegan al ágil trade desk. Las consultas de cuenta, facturación y acuerdos de datos se enrutan a equipos especializados, entre ellos las colas de facturación y de &ldquo;Financial Profile&rdquo;, y varios de esos equipos trabajan principalmente por correo, sin línea telefónica de entrada directa. Así que cuando su solicitud de soporte parece desvanecerse, casi siempre es una de esas colas de correo especializadas la que se ha quedado a oscuras, no el chat en vivo ni el trade desk." },
    { type: "paragraph",html: "El resultado práctico es una acumulación de trabajo. Una consulta que un agente de chat en vivo resolvería en minutos puede quedarse días una vez derivada a un equipo que solo trabaja por correo. Y hay más: algunas primeras respuestas son automáticas o guionizadas, así que un hilo puede parecer &ldquo;respondido&rdquo; mientras su problema real sigue intacto. Y si escribió a la parte equivocada, por ejemplo a Tradovate por una cuenta de evaluación de una prop firm, quizá esté esperando a un equipo sin autoridad alguna para resolver su problema." },
    { type: "paragraph",html: "La solución rara vez es enviar más correos a la misma cola. Consiste en cambiar de canal, verificar quién es responsable de la solicitud y construir un rastro documental que respalde una escalada o una disputa de pago si el silencio continúa." },
    { type: "heading",text: "Principales causas del silencio del soporte de Tradovate" },
    { type: "heading",text: "1. Escribió a un equipo especializado que solo trabaja por correo" },
    { type: "paragraph",html: "Las solicitudes de facturación, reembolsos, enrutamiento de datos y perfil financiero las gestionan equipos de back office que trabajan por correo y responden con lentitud. No hay línea telefónica dedicada a estas colas, por lo que un solo correo sin respuesta puede dejarle sin un siguiente paso evidente, que es exactamente como una solicitud acaba pareciendo desaparecida." },
    { type: "heading",text: "2. Su problema pertenece en realidad a su prop firm" },
    { type: "paragraph",html: "Si opera una cuenta fondeada o de evaluación a través de una firma como Apex o Topstep, Tradovate puede ayudar a configurar la conexión inicial pero no puede resolver problemas específicos de la cuenta; no tiene visibilidad de las reglas, los objetivos de beneficio, los límites de drawdown ni los reinicios de esa firma. La propia guía de Tradovate es contactar directamente con su proveedor de evaluación para esas cuestiones. Los correos a Tradovate sobre una cuenta de prop firm quedan a menudo sin respuesta por una razón simple: la cuenta no es suya para atenderla." },
    { type: "heading",text: "3. Su ticket nunca llegó a abrirse" },
    { type: "paragraph",html: "Un correo enviado a la dirección equivocada o un formulario de soporte que no se envió puede no generar nunca un número de caso con seguimiento. Sin número de caso, no hay un registro que un agente pueda retomar, así que la solicitud se desvanece en la práctica, y sus seguimientos hacen referencia a un ticket que no existe en el sistema." },
    { type: "heading",text: "4. Contactó durante una caída o un pico fuera de horario" },
    { type: "paragraph",html: "El volumen de soporte se dispara justo en los momentos en que más ayuda necesita: una caída de la plataforma en la apertura o una pérdida de datos a media sesión. En esos picos la cola se satura, las esperas del chat se disparan y las respuestas por correo se arrastran. Enviar una solicitud fuera de horario a un equipo de horario laboral añade otro retraso más." },
    { type: "heading",text: "5. La primera respuesta fue automática y el hilo se estancó" },
    { type: "paragraph",html: "Las primeras respuestas guionizadas o de tipo IA tienden a contestar una versión genérica de su pregunta y luego callan. Si da esa respuesta por &ldquo;resuelta&rdquo; y deja de insistir, el ticket puede cerrarse solo sin que su problema real llegue nunca a una persona." },
    { type: "heading",text: "Cómo solucionar el silencio del soporte de Tradovate: paso a paso" },
    { type: "heading",text: "Solucionar un correo sin respuesta a un equipo especializado" },
    {
      type: "steps",
      items: [
        { title: "Cambie al chat en vivo", html: "Deje de reenviar al mismo buzón. Abra la plataforma y haga clic en el icono <strong class='text-white'>Help (?)</strong> para llegar al chat en vivo, que se atiende mucho más rápido que el correo." },
        { title: "Pida resolución o escalada", html: "Pida al agente del chat que resuelva la solicitud o la escale internamente y le facilite un <strong class='text-white'>número de caso</strong>." },
        { title: "Confirme el número de caso", html: "Si el chat le devuelve al correo, pida que abran el ticket en su nombre y que confirmen el número de caso en la transcripción del chat antes de irse." },
      ],
    },
    { type: "heading",text: "Solucionar una solicitud de una cuenta de prop firm o de evaluación" },
    {
      type: "steps",
      items: [
        { title: "Confirme el tipo de cuenta", html: "Confirme el tipo de cuenta. Si es una cuenta fondeada o de evaluación, su primer contacto debe ser el soporte de la <strong class='text-white'>prop firm</strong>, no Tradovate." },
        { title: "Dirija a la firma las dudas sobre reglas de la cuenta", html: "Dirija a la firma las consultas sobre reglas, reinicios, drawdown, activación de datos de mercado y pagos; Tradovate no puede verlos ni cambiarlos." },
        { title: "Escale a Tradovate solo si se lo piden", html: "Escale a Tradovate solo si la firma confirma que el problema está del lado de la plataforma y se lo pide. Reenvíe el mensaje de la firma para que Tradovate tenga el contexto." },
      ],
    },
    { type: "heading",text: "Solucionar un ticket que nunca se abrió" },
    {
      type: "steps",
      items: [
        { title: "Use el formulario oficial de tickets", html: "Use el formulario oficial de contacto en la página <strong class='text-white'>Contact Support</strong> de Tradovate (support.tradovate.com) en lugar de un correo simple, para que la solicitud entre en el sistema de tickets." },
        { title: "Espere un número de caso", html: "Espere la confirmación automática con un número de caso. Sin confirmación normalmente no hay ticket: vuelva a enviarlo." },
        { title: "Haga referencia al número de caso", html: "Cite ese número de caso en cada seguimiento para que los agentes encuentren el hilo existente en lugar de empezar de cero." },
      ],
    },
    { type: "heading",text: "Solucionar una caída o emergencia que no admite espera" },
    {
      type: "steps",
      items: [
        { title: "Llame al Trade Desk si hay posiciones en vivo", html: "Para cualquier asunto con una <strong class='text-white'>posición en vivo</strong>, una orden que no puede cancelar, una ejecución de la que no puede salir, llame a la línea del <strong class='text-white'>Trade Desk</strong>, que cubre el horario de mercado, en lugar de enviar un correo." },
        { title: "Llame a Support para cuenta/facturación", html: "Para asuntos de cuenta y facturación, llame a la línea de <strong class='text-white'>Support</strong> en su horario laboral publicado (hora central). Los horarios cambian con el tiempo, así que consulte los vigentes en la página de contacto de Tradovate antes de llamar." },
        { title: "Gestione el riesgo en una conexión de respaldo", html: "Si no consigue comunicar y hay una posición expuesta, gestione el riesgo mediante una conexión de respaldo o una segunda plataforma mientras espera a que se resuelva la caída." },
      ],
    },
    { type: "heading",text: "Construir un rastro documental que obligue a responder" },
    {
      type: "steps",
      items: [
        { title: "Lleve un registro continuo", html: "Lleve un registro continuo: cada correo, transcripción de chat, hora de llamada, nombre del agente y número de caso, todo con marca de tiempo." },
        { title: "Haga capturas en el momento", html: "Capture la pantalla del cargo, del error o de la caída en el momento en que ocurre; las pruebas fechadas son lo que gana una disputa de facturación más adelante." },
        { title: "Use el registro para una disputa si hace falta", html: "Si un cargo de facturación legítimo sigue sin resolverse tras un seguimiento documentado y persistente, tendrá el registro que necesita para disputar el cargo ante su emisor de tarjeta o su banco." },
      ],
    },
    { type: "heading",text: "Tabla de solución de problemas" },
    { type: "table", headers: ["Síntoma","Qué significa","Solución"], rows: [
      ["&ldquo;Solicité un cambio por correo y no hay respuesta&rdquo;","Cayó en una cola lenta de un equipo especializado que solo trabaja por correo","Cambie al chat en vivo con el icono Help (?) y obtenga un número de caso"],
      ["&ldquo;Sin respuesta del soporte&rdquo; durante días o semanas","Equipo de facturación/perfil financiero saturado, sin línea telefónica","Escale por el chat y con un ticket formal; haga seguimiento con un calendario"],
      ["Tradovate ignora un problema de cuenta de prop firm/evaluación","La cuenta pertenece a su firma, no a Tradovate","Contacte primero con el soporte de su prop firm"],
      ["Sin confirmación de número de caso tras enviar el correo","El ticket nunca se abrió / dirección equivocada","Vuelva a enviarlo con el formulario oficial Contact Support y confirme el número de caso"],
      ["La primera respuesta fue guionizada y luego silencio","Respuesta automática; el hilo puede cerrarse solo","Responda citando el número de caso y pida la escalada a una persona"],
      ["No consigue contactar con nadie durante una caída","Pico de volumen de soporte en la apertura o pérdida de datos","Llame al Trade Desk si hay posiciones en vivo; gestione el riesgo en una conexión de respaldo"],
      ["Cargo sin resolver tras un seguimiento persistente","Disputa de facturación documentada sin resolución","Use su registro y capturas para disputar el cargo ante su banco/emisor de tarjeta"],
    ] },
    { type: "heading",text: "Prevéngalo con PickMyTrade" },
    { type: "paragraph",html: "No puede controlar la cola de correo de Tradovate, pero sí puede evitar que un ticket de soporte lento llegue a convertirse en una emergencia de trading. PickMyTrade conecta sus alertas de TradingView directamente con Tradovate, de modo que la ejecución sigue en marcha incluso cuando un hilo de soporte está atascado en el limbo:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Sincronización multicuenta</strong>, replica la misma orden corregida en todas las cuentas conectadas, para que un fallo de la plataforma no deje posiciones descompasadas.",
        "<strong class='text-white'>Filtros de permisos y riesgo</strong>, respetan desde el principio los límites de la prop firm y el estado del acuerdo de datos, reduciendo los tickets de permisos y enrutamiento que atascan la cola.",
        "<strong class='text-white'>Enrutamiento seguro frente a límites de frecuencia</strong>, espacia el flujo de órdenes para que nada rebote, evitando los tickets por órdenes fallidas que originan las solicitudes de soporte.",
        "<strong class='text-white'>Automatización con respaldo</strong>, mantiene las alertas fluyendo hacia su cuenta para que un único canal inaccesible nunca deje varada una operación abierta.",
      ],
    },
  ], fr: [
    { type: "paragraph",html: "Un prélèvement que vous n'attendiez pas, une demande de routage de données à faire approuver, un ticket de panne envoyé en pleine séance, puis plus rien. L'e-mail reste là, sans suite. Quand le support Tradovate se tait, ce silence vous coûte de l'argent réel et beaucoup de sérénité, car vous attendez dans une file dont vous ne voyez rien. Le schéma est presque toujours l'un de ces trois cas : un e-mail de facturation ou de remboursement resté sans réponse, une demande de routage ou d'autorisation bloquée en suspens, ou un ticket de panne qui ne reçoit jamais de réponse humaine. Ce guide vous explique comment escalader sur tous les canaux, tout documenter et adresser chaque demande à l'interlocuteur qui peut réellement agir, ainsi que la façon dont l'automatisation garde vos trades en mouvement pour qu'une file de support lente ne se transforme jamais en position bloquée." },
    {
      type: "checklist",
      heading: "Liste de contrôle rapide pour joindre le support Tradovate",
      items: [
        "<strong class='text-white'>Utilisez d'abord le chat en direct, pas l'e-mail.</strong> La file du chat intégré avance bien plus vite que l'arriéré d'e-mails ou de tickets.",
        "<strong class='text-white'>Confirmez à qui appartient votre compte.</strong> Les comptes de prop firm et d'évaluation (Apex, Topstep et similaires) sont gérés par la société, pas par Tradovate.",
        "<strong class='text-white'>Appelez la bonne ligne téléphonique.</strong> Le Trade Desk est réservé aux urgences sur positions en direct ; la ligne Support concerne les questions de compte et de facturation pendant les heures ouvrables.",
        "<strong class='text-white'>Ouvrez un ticket formel, pas seulement un e-mail.</strong> Obtenez un numéro de dossier pour que la demande soit suivie au lieu de dormir dans une boîte partagée.",
        "<strong class='text-white'>Documentez chaque contact.</strong> Conservez dates, heures, captures d'écran et numéros de dossier ; vous en aurez besoin pour les litiges et les rétrofacturations.",
        "<strong class='text-white'>Escaladez selon un calendrier.</strong> Relancez poliment mais avec persévérance, plutôt que d'envoyer un message et d'attendre indéfiniment.",
      ],
    },
    { type: "heading",text: "Ce que signifie réellement « Le support ne répond pas »" },
    { type: "paragraph",html: "Tradovate exploite une table de contrats à terme 24/5, mais toutes les demandes n'arrivent pas au trade desk, très réactif. Les questions de compte, de facturation et d'accords de données sont acheminées vers des équipes spécialisées, notamment les files de facturation et de &ldquo;Financial Profile&rdquo;, et plusieurs de ces équipes travaillent principalement par e-mail, sans ligne téléphonique entrante directe. Lorsque votre demande de support semble disparaître, c'est donc presque toujours l'une de ces files e-mail spécialisées qui est tombée dans le silence, pas le chat en direct ni le trade desk." },
    { type: "paragraph",html: "Le résultat pratique est un arriéré. Une question qu'un agent du chat en direct réglerait en quelques minutes peut dormir plusieurs jours une fois transmise à une équipe qui ne travaille que par e-mail. Et c'est pire : certaines premières réponses sont automatiques ou scriptées, de sorte qu'un échange peut paraître &ldquo;répondu&rdquo; alors que votre vrai problème reste intact. Et si vous avez écrit au mauvais interlocuteur, par exemple à Tradovate au sujet d'un compte d'évaluation de prop firm, vous attendez peut-être une équipe qui n'a aucune autorité pour régler votre problème." },
    { type: "paragraph",html: "La solution consiste rarement à envoyer davantage d'e-mails dans la même file. Il s'agit de changer de canal, de vérifier à qui appartient la demande et de constituer une trace écrite qui appuie une escalade ou un litige de paiement si le silence persiste." },
    { type: "heading",text: "Principales causes du silence du support Tradovate" },
    { type: "heading",text: "1. Vous avez écrit à une équipe spécialisée qui ne travaille que par e-mail" },
    { type: "paragraph",html: "Les demandes de facturation, de remboursement, de routage de données et de profil financier sont traitées par des équipes de back-office qui travaillent par e-mail et répondent lentement. Il n'existe pas de ligne téléphonique dédiée vers ces files ; un seul e-mail resté sans réponse peut donc vous laisser sans étape suivante évidente, et c'est exactement ainsi qu'une demande finit par sembler avoir disparu." },
    { type: "heading",text: "2. Votre problème relève en réalité de votre prop firm" },
    { type: "paragraph",html: "Si vous tradez un compte financé ou d'évaluation via une société comme Apex ou Topstep, Tradovate peut aider à établir la connexion initiale mais ne peut pas résoudre les problèmes propres au compte ; il n'a aucune visibilité sur les règles, les objectifs de profit, les limites de drawdown ou les réinitialisations de cette société. La consigne de Tradovate lui-même est de contacter directement votre fournisseur d'évaluation pour ces questions. Les e-mails à Tradovate au sujet d'un compte de prop firm restent souvent sans réponse pour une raison simple : le compte n'est pas de son ressort." },
    { type: "heading",text: "3. Votre ticket ne s'est jamais réellement ouvert" },
    { type: "paragraph",html: "Un e-mail envoyé à la mauvaise adresse, ou un formulaire de support qui n'a pas abouti, peut ne jamais générer de numéro de dossier suivi. Sans numéro de dossier, aucun enregistrement ne peut être repris par un agent ; la demande disparaît donc de fait, et vos relances renvoient à un ticket qui n'existe pas dans le système." },
    { type: "heading",text: "4. Vous avez écrit pendant une panne ou un pic hors horaires" },
    { type: "paragraph",html: "Le volume du support explose précisément aux moments où vous avez le plus besoin d'aide : une panne de la plateforme à l'ouverture, ou une coupure de données en pleine séance. Pendant ces pics, la file est submergée, les temps d'attente du chat s'envolent et les réponses par e-mail ralentissent. Envoyer une demande hors horaires à une équipe en heures ouvrables ajoute un nouveau retard." },
    { type: "heading",text: "5. La première réponse était automatique et l'échange a calé" },
    { type: "paragraph",html: "Les premières réponses scriptées ou de type IA répondent plutôt à une version générique de votre question, puis se taisent. Si vous acceptez cette réponse comme &ldquo;traitée&rdquo; et cessez d'insister, le ticket peut se clore automatiquement sans que votre vrai problème n'atteigne jamais une personne." },
    { type: "heading",text: "Comment remédier au silence du support Tradovate : pas à pas" },
    { type: "heading",text: "Résoudre un e-mail resté sans réponse auprès d'une équipe spécialisée" },
    {
      type: "steps",
      items: [
        { title: "Passez au chat en direct", html: "Cessez de renvoyer vers la même boîte. Ouvrez la plateforme et cliquez sur l'icône <strong class='text-white'>Help (?)</strong> pour accéder au chat en direct, qui reçoit une réponse bien plus rapide que l'e-mail." },
        { title: "Demandez une résolution ou une escalade", html: "Demandez à l'agent du chat soit de résoudre la demande, soit de l'escalader en interne et de vous fournir un <strong class='text-white'>numéro de dossier</strong>." },
        { title: "Faites confirmer le numéro de dossier", html: "Si le chat vous renvoie vers l'e-mail, demandez qu'on ouvre le ticket en votre nom et qu'on confirme le numéro de dossier dans la transcription du chat avant de partir." },
      ],
    },
    { type: "heading",text: "Résoudre une demande concernant un compte de prop firm ou d'évaluation" },
    {
      type: "steps",
      items: [
        { title: "Confirmez le type de compte", html: "Confirmez le type de compte. S'il s'agit d'un compte financé ou d'évaluation, votre premier contact doit être le support de la <strong class='text-white'>prop firm</strong>, pas Tradovate." },
        { title: "Adressez les questions de règles à la société", html: "Adressez à la société les questions de règles, de réinitialisations, de drawdown, d'activation des données de marché et de paiements ; Tradovate ne peut ni les voir ni les modifier." },
        { title: "N'escaladez vers Tradovate que si on vous le demande", html: "N'escaladez vers Tradovate que si la société confirme que le problème est côté plateforme et vous le demande. Transférez le message de la société pour que Tradovate dispose du contexte." },
      ],
    },
    { type: "heading",text: "Résoudre un ticket qui ne s'est jamais ouvert" },
    {
      type: "steps",
      items: [
        { title: "Utilisez le formulaire de ticket officiel", html: "Utilisez le formulaire de contact officiel de la page <strong class='text-white'>Contact Support</strong> de Tradovate (support.tradovate.com) plutôt qu'un simple e-mail, afin que la demande entre dans le système de tickets." },
        { title: "Attendez un numéro de dossier", html: "Attendez la confirmation automatique contenant un numéro de dossier. Pas de confirmation signifie généralement pas de ticket : soumettez à nouveau." },
        { title: "Citez le numéro de dossier", html: "Citez ce numéro de dossier dans chaque relance afin que les agents retrouvent l'échange existant au lieu de repartir de zéro." },
      ],
    },
    { type: "heading",text: "Résoudre une panne ou une urgence qui ne peut pas attendre" },
    {
      type: "steps",
      items: [
        { title: "Appelez le Trade Desk pour les positions en direct", html: "Pour tout ce qui touche à une <strong class='text-white'>position en direct</strong>, un ordre que vous ne pouvez pas annuler, une exécution dont vous ne pouvez pas sortir, appelez la ligne du <strong class='text-white'>Trade Desk</strong>, qui couvre les heures de marché, plutôt que d'envoyer un e-mail." },
        { title: "Appelez le Support pour le compte/la facturation", html: "Pour les questions de compte et de facturation, appelez la ligne <strong class='text-white'>Support</strong> pendant ses heures ouvrables affichées (heure centrale). Les horaires évoluent ; consultez donc les horaires actuels sur la page de contact de Tradovate avant d'appeler." },
        { title: "Gérez le risque sur une connexion de secours", html: "Si vous n'arrivez pas à joindre qui que ce soit et qu'une position est exposée, gérez le risque via une connexion de secours ou une seconde plateforme en attendant la fin de la panne." },
      ],
    },
    { type: "heading",text: "Constituer une trace écrite qui impose une réponse" },
    {
      type: "steps",
      items: [
        { title: "Tenez un journal continu", html: "Tenez un journal continu : chaque e-mail, transcription de chat, heure d'appel, nom d'agent et numéro de dossier, le tout horodaté." },
        { title: "Faites des captures d'écran sur le moment", html: "Faites une capture d'écran du prélèvement, de l'erreur ou de la panne au moment où elle survient ; les preuves datées sont ce qui fait gagner un litige de facturation par la suite." },
        { title: "Utilisez le journal pour un litige si nécessaire", html: "Si un prélèvement de facturation légitime reste non résolu après des relances documentées et persistantes, vous aurez le dossier nécessaire pour contester le prélèvement auprès de l'émetteur de votre carte ou de votre banque." },
      ],
    },
    { type: "heading",text: "Tableau de dépannage" },
    { type: "table", headers: ["Symptôme","Signification","Solution"], rows: [
      ["&ldquo;J'ai demandé un changement par e-mail sans réponse&rdquo;","Tombé dans une file lente, spécialisée et uniquement par e-mail","Passez au chat en direct via l'icône Help (?) et obtenez un numéro de dossier"],
      ["&ldquo;Pas de réponse du support&rdquo; pendant des jours ou des semaines","Équipe de facturation/profil financier débordée, sans ligne téléphonique","Escaladez par le chat et un ticket formel ; relancez selon un calendrier"],
      ["Problème de compte de prop firm/d'évaluation ignoré par Tradovate","Le compte appartient à votre société, pas à Tradovate","Contactez d'abord le support de votre prop firm"],
      ["Pas de confirmation de numéro de dossier après l'e-mail","Ticket jamais ouvert / mauvaise adresse","Soumettez à nouveau via le formulaire officiel Contact Support et faites confirmer le numéro de dossier"],
      ["La première réponse était scriptée, puis le silence","Réponse automatique ; l'échange peut se clore automatiquement","Répondez en citant le numéro de dossier et demandez une escalade vers une personne"],
      ["Impossible de joindre qui que ce soit pendant une panne","Pic de volume du support à l'ouverture ou coupure de données","Appelez le Trade Desk pour les positions en direct ; gérez le risque sur une connexion de secours"],
      ["Prélèvement non résolu après des relances persistantes","Litige de facturation documenté sans résolution","Utilisez votre journal et vos captures d'écran pour contester le prélèvement auprès de votre banque/émetteur de carte"],
    ] },
    { type: "heading",text: "Prévenez cela avec PickMyTrade" },
    { type: "paragraph",html: "Vous ne pouvez pas contrôler la file d'e-mails de Tradovate, mais vous pouvez éviter qu'un ticket de support lent ne devienne une urgence de trading. PickMyTrade relie vos alertes TradingView directement à Tradovate, de sorte que l'exécution continue même lorsqu'un échange avec le support reste en suspens :" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Synchronisation multi-comptes</strong>, reproduit le même ordre corrigé sur tous les comptes connectés, pour qu'un accroc de plateforme ne laisse pas des positions désynchronisées.",
        "<strong class='text-white'>Filtres d'autorisations et de risque</strong>, respectent d'emblée les limites de la prop firm et l'état de l'accord de données, réduisant les tickets d'autorisation et de routage qui engorgent la file.",
        "<strong class='text-white'>Routage respectueux des limites de débit</strong>, espace le flux d'ordres pour que rien ne rebondisse, évitant les tickets d'ordres échoués qui déclenchent les demandes de support.",
        "<strong class='text-white'>Automatisation compatible avec un plan de secours</strong>, maintient les alertes vers votre compte pour qu'un canal injoignable ne laisse jamais un trade ouvert à l'abandon.",
      ],
    },
  ], it: [
    { type: "paragraph",html: "Un addebito che non si aspettava, una richiesta di routing dei dati da far approvare, un ticket per un'interruzione inviato a metà sessione e poi niente. L'e-mail resta lì. Quando il supporto di Tradovate tace, quel silenzio le costa denaro reale e molta serenità, perché resta in attesa in una coda che non può vedere. Lo schema è quasi sempre uno di tre: un'e-mail di fatturazione o rimborso senza risposta, una richiesta di routing o di abilitazione rimasta in sospeso, oppure un ticket per un'interruzione che non riceve mai una risposta umana. Questa guida le mostra come scalare su ogni canale, documentare tutto e indirizzare ogni richiesta alla parte che può davvero intervenire, oltre a come l'automazione mantiene attivi i suoi trade affinché una coda di supporto lenta non diventi mai una posizione bloccata." },
    {
      type: "checklist",
      heading: "Checklist rapida per raggiungere il supporto di Tradovate",
      items: [
        "<strong class='text-white'>Usi prima la live chat, non l'e-mail.</strong> La coda della chat nell'app scorre molto più in fretta dell'arretrato di e-mail o ticket.",
        "<strong class='text-white'>Confermi a chi appartiene il suo conto.</strong> I conti prop e di valutazione (Apex, Topstep e simili) sono gestiti dalla società, non da Tradovate.",
        "<strong class='text-white'>Chiami la linea telefonica giusta.</strong> Il Trade Desk è per le emergenze su posizioni aperte; la linea Support è per domande su conto e fatturazione durante l'orario d'ufficio.",
        "<strong class='text-white'>Apra un ticket formale, non solo un'e-mail.</strong> Ottenga un numero di pratica in modo che la richiesta venga tracciata invece di restare in una casella condivisa.",
        "<strong class='text-white'>Documenti ogni contatto.</strong> Salvi date, orari, screenshot e numeri di pratica: le serviranno per contestazioni e chargeback.",
        "<strong class='text-white'>Scali con scadenze.</strong> Faccia follow-up in modo cortese ma persistente, invece di inviare un solo messaggio e attendere all'infinito.",
      ],
    },
    { type: "heading",text: "Cosa significa davvero “Il supporto non risponde”" },
    { type: "paragraph",html: "Tradovate gestisce un desk futures 24/5, ma non ogni richiesta arriva al rapido trade desk. Le domande su conto, fatturazione e accordi sui dati vengono instradate a team specializzati, tra cui le code di fatturazione e di &ldquo;Financial Profile&rdquo;, e diversi di questi team lavorano principalmente via e-mail senza una linea telefonica in entrata diretta. Quindi, quando la sua richiesta di supporto sembra svanire, è quasi sempre una di queste code e-mail specializzate a essere andata in silenzio, non la live chat né il trade desk." },
    { type: "paragraph",html: "Il risultato pratico è un arretrato. Una domanda che un agente della live chat risolverebbe in pochi minuti può restare ferma per giorni una volta passata a un team solo e-mail. Peggio ancora: alcune prime risposte sono automatiche o preconfezionate, quindi una conversazione può sembrare &ldquo;risposta&rdquo; mentre il suo vero problema resta intatto. E se ha scritto alla parte sbagliata, per esempio a Tradovate per un conto di valutazione di una prop firm, potrebbe essere in attesa di un team che non ha alcuna autorità per risolvere il suo problema." },
    { type: "paragraph",html: "La soluzione raramente è inviare più e-mail nella stessa coda. È cambiare canale, verificare a chi appartiene la richiesta e costruire una documentazione che sostenga una escalation o una contestazione di pagamento se il silenzio continua." },
    { type: "heading",text: "Principali cause del silenzio del supporto di Tradovate" },
    { type: "heading",text: "1. Ha scritto a un team specializzato che lavora solo via e-mail" },
    { type: "paragraph",html: "Le richieste di fatturazione, rimborso, routing dei dati e profilo finanziario sono gestite da team di back office che lavorano via e-mail e rispondono lentamente. Non esiste una linea telefonica dedicata a queste code, quindi una sola e-mail senza risposta può lasciarla senza un passo successivo evidente, ed è esattamente così che una richiesta finisce per sembrare scomparsa." },
    { type: "heading",text: "2. Il suo problema appartiene in realtà alla sua prop firm" },
    { type: "paragraph",html: "Se opera su un conto finanziato o di valutazione tramite una società come Apex o Topstep, Tradovate può aiutare a configurare la connessione iniziale ma non può risolvere problemi specifici del conto; non ha visibilità su regole, obiettivi di profitto, limiti di drawdown o reset di quella società. L'indicazione di Tradovate stessa è di contattare direttamente il fornitore della valutazione per quelle domande. Le e-mail a Tradovate su un conto prop spesso restano senza risposta per un motivo semplice: il conto non è di sua competenza." },
    { type: "heading",text: "3. Il suo ticket non è mai stato davvero aperto" },
    { type: "paragraph",html: "Un'e-mail inviata all'indirizzo sbagliato, o un modulo di supporto non inviato correttamente, potrebbe non generare mai un numero di pratica tracciato. Senza numero di pratica non c'è alcun record che un agente possa prendere in carico, quindi la richiesta di fatto svanisce, e i suoi solleciti fanno riferimento a un ticket che nel sistema non esiste." },
    { type: "heading",text: "4. Ha scritto durante un'interruzione o un picco fuori orario" },
    { type: "paragraph",html: "Il volume del supporto schizza proprio nei momenti in cui ha più bisogno di aiuto: un'interruzione della piattaforma all'apertura o un calo dei dati a metà sessione. Durante questi picchi la coda si intasa, i tempi di attesa della chat si dilatano e le risposte via e-mail rallentano. Inviare una richiesta fuori orario a un team con orario d'ufficio aggiunge un ulteriore ritardo." },
    { type: "heading",text: "5. La prima risposta era automatica e la conversazione si è arenata" },
    { type: "paragraph",html: "Le prime risposte preconfezionate o di tipo IA tendono a rispondere a una versione generica della sua domanda e poi a tacere. Se accetta quella risposta come &ldquo;gestita&rdquo; e smette di insistere, il ticket può chiudersi automaticamente senza che il suo vero problema raggiunga mai una persona." },
    { type: "heading",text: "Come risolvere il silenzio del supporto di Tradovate: passo dopo passo" },
    { type: "heading",text: "Risolvere un'e-mail senza risposta a un team specializzato" },
    {
      type: "steps",
      items: [
        { title: "Passi alla live chat", html: "Smetta di rispedire alla stessa casella. Apra la piattaforma e faccia clic sull'icona <strong class='text-white'>Help (?)</strong> per raggiungere la live chat, che riceve risposta molto più in fretta dell'e-mail." },
        { title: "Chieda risoluzione o escalation", html: "Chieda all'agente della chat di risolvere la richiesta oppure di scalarla internamente e di darle un <strong class='text-white'>numero di pratica</strong>." },
        { title: "Faccia confermare il numero di pratica", html: "Se la chat la rimanda all'e-mail, chieda di aprire il ticket per suo conto e di confermare il numero di pratica nella trascrizione della chat prima di andare via." },
      ],
    },
    { type: "heading",text: "Risolvere una richiesta relativa a un conto prop o di valutazione" },
    {
      type: "steps",
      items: [
        { title: "Confermi il tipo di conto", html: "Confermi il tipo di conto. Se è un conto finanziato o di valutazione, il suo primo contatto deve essere il supporto della <strong class='text-white'>prop firm</strong>, non Tradovate." },
        { title: "Indirizzi alla società le domande sulle regole del conto", html: "Indirizzi alla società le domande su regole, reset, drawdown, abilitazione dei dati di mercato e payout; Tradovate non può vederli né modificarli." },
        { title: "Scali a Tradovate solo se richiesto", html: "Scali a Tradovate solo se la società conferma che il problema è lato piattaforma e glielo chiede. Inoltri il messaggio della società in modo che Tradovate abbia il contesto." },
      ],
    },
    { type: "heading",text: "Risolvere un ticket che non è mai stato aperto" },
    {
      type: "steps",
      items: [
        { title: "Usi il modulo ufficiale per i ticket", html: "Usi il modulo di contatto ufficiale nella pagina <strong class='text-white'>Contact Support</strong> di Tradovate (support.tradovate.com) invece di una semplice e-mail, in modo che la richiesta entri nel sistema di ticket." },
        { title: "Attenda un numero di pratica", html: "Attenda la conferma automatica contenente un numero di pratica. Nessuna conferma di solito significa nessun ticket: lo invii di nuovo." },
        { title: "Citi il numero di pratica", html: "Citi quel numero di pratica in ogni sollecito, così gli agenti possono trovare la conversazione esistente invece di ricominciare da capo." },
      ],
    },
    { type: "heading",text: "Risolvere un'interruzione o un'emergenza che non può attendere" },
    {
      type: "steps",
      items: [
        { title: "Chiami il Trade Desk per le posizioni aperte", html: "Per qualsiasi cosa riguardi una <strong class='text-white'>posizione aperta</strong>, un ordine che non riesce ad annullare, un'esecuzione da cui non riesce a uscire, chiami la linea del <strong class='text-white'>Trade Desk</strong>, che copre l'orario di mercato, invece di scrivere un'e-mail." },
        { title: "Chiami il Support per conto/fatturazione", html: "Per questioni di conto e fatturazione, chiami la linea <strong class='text-white'>Support</strong> durante gli orari d'ufficio pubblicati (ora centrale). Gli orari cambiano nel tempo, quindi controlli gli orari attuali sulla pagina dei contatti di Tradovate prima di chiamare." },
        { title: "Gestisca il rischio su una connessione di backup", html: "Se non riesce a mettersi in contatto e una posizione è esposta, gestisca il rischio tramite una connessione di backup o una seconda piattaforma mentre attende che l'interruzione rientri." },
      ],
    },
    { type: "heading",text: "Costruire una documentazione che imponga una risposta" },
    {
      type: "steps",
      items: [
        { title: "Tenga un registro continuo", html: "Tenga un registro continuo: ogni e-mail, trascrizione di chat, orario di chiamata, nome dell'agente e numero di pratica, tutto con data e ora." },
        { title: "Faccia screenshot sul momento", html: "Faccia uno screenshot dell'addebito, dell'errore o dell'interruzione mentre accade; le prove datate sono ciò che fa vincere una contestazione di fatturazione in seguito." },
        { title: "Usi il registro per una contestazione se necessario", html: "Se un addebito di fatturazione legittimo resta irrisolto dopo solleciti documentati e persistenti, avrà la documentazione necessaria per contestare l'addebito presso l'emittente della carta o la banca." },
      ],
    },
    { type: "heading",text: "Tabella di risoluzione dei problemi" },
    { type: "table", headers: ["Sintomo","Cosa significa","Soluzione"], rows: [
      ["&ldquo;Ho richiesto una modifica via e-mail senza risposta&rdquo;","Finita in una coda lenta, specializzata e solo e-mail","Passi alla live chat tramite l'icona Help (?) e ottenga un numero di pratica"],
      ["&ldquo;Nessuna risposta dal supporto&rdquo; per giorni o settimane","Team di fatturazione/profilo finanziario con arretrato, nessuna linea telefonica","Scali tramite chat e un ticket formale; faccia follow-up con scadenze"],
      ["Problema del conto prop/di valutazione ignorato da Tradovate","Il conto appartiene alla sua società, non a Tradovate","Contatti prima il supporto della sua prop firm"],
      ["Nessuna conferma del numero di pratica dopo l'e-mail","Ticket mai aperto / indirizzo sbagliato","Lo invii di nuovo tramite il modulo ufficiale Contact Support e confermi il numero di pratica"],
      ["La prima risposta era preconfezionata, poi silenzio","Risposta automatica; la conversazione può chiudersi da sola","Risponda citando il numero di pratica e chieda l'escalation a una persona"],
      ["Impossibile raggiungere qualcuno durante un'interruzione","Picco di volume del supporto all'apertura o calo dei dati","Chiami il Trade Desk per le posizioni aperte; gestisca il rischio su una connessione di backup"],
      ["Addebito irrisolto dopo solleciti persistenti","Contestazione di fatturazione documentata senza risoluzione","Usi registro e screenshot per contestare l'addebito presso la banca/emittente della carta"],
    ] },
    { type: "heading",text: "Prevenga tutto questo con PickMyTrade" },
    { type: "paragraph",html: "Non può controllare la coda e-mail di Tradovate, ma può evitare che un ticket di supporto lento diventi un'emergenza di trading. PickMyTrade collega i suoi alert di TradingView direttamente a Tradovate, così l'esecuzione continua anche quando una conversazione con il supporto è rimasta in sospeso:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Sincronizzazione multi-conto</strong>, replica lo stesso ordine corretto su tutti i conti collegati, così un intoppo della piattaforma non lascia posizioni disallineate.",
        "<strong class='text-white'>Filtri di abilitazione e rischio</strong>, rispettano fin dall'inizio i limiti della prop firm e lo stato dell'accordo sui dati, riducendo i ticket di abilitazione e routing che intasano la coda.",
        "<strong class='text-white'>Instradamento a prova di limiti di frequenza</strong>, distanzia il flusso di ordini in modo che nulla rimbalzi, evitando i ticket per ordini falliti che originano le richieste di supporto.",
        "<strong class='text-white'>Automazione compatibile con il backup</strong>, mantiene gli alert in arrivo sul suo conto così un singolo canale irraggiungibile non lascia mai in sospeso un trade aperto.",
      ],
    },
  ] },
  ctaHeading: { en: "Trade Rejection-Free", de: "Handeln Sie ohne Order-Ablehnungen", es: "Opere sin rechazos de órdenes", fr: "Tradez sans rejet d'ordres", it: "Operi senza rifiuti di ordini" },
  ctaText: { en: "Start your free 7-day trial, link alerts today, and keep execution running even when a support thread is stuck in limbo.", de: "Starten Sie Ihre kostenlose 7-Tage-Testphase, verbinden Sie noch heute Ihre Alerts und halten Sie die Ausführung am Laufen, selbst wenn ein Support-Vorgang in der Schwebe hängt.", es: "Comience su prueba gratuita de 7 días, vincule sus alertas hoy y mantenga la ejecución en marcha incluso cuando un hilo de soporte esté atascado en el limbo.", fr: "Commencez votre essai gratuit de 7 jours, reliez vos alertes dès aujourd'hui et gardez l'exécution en marche même lorsqu'un échange avec le support reste en suspens.", it: "Inizi la prova gratuita di 7 giorni, colleghi gli alert oggi stesso e mantenga l'esecuzione attiva anche quando una conversazione con il supporto è rimasta in sospeso." },
  ctaButtonText: { en: "Start Your Free 7-Day Trial", de: "Starten Sie Ihre kostenlose 7-Tage-Testphase", es: "Comience su prueba gratuita de 7 días", fr: "Commencez votre essai gratuit de 7 jours", it: "Inizi la prova gratuita di 7 giorni" },
  ctaUrl: "https://app.pickmytrade.trade/?register=true&utm_source=content&utm_medium=debugging",
  faqHeading: { en: "Frequently Asked Questions", de: "Häufig gestellte Fragen", es: "Preguntas frecuentes", fr: "Questions fréquentes", it: "Domande frequenti" },
  faqs: { en: [
    { q: "How long does Tradovate support take to respond?", a: "Live chat usually gets you a human within minutes during support hours. Email and specialized-team requests are a different story, billing and financial-profile matters can drag on for days or longer. Lead with chat for anything urgent." },
    { q: "What is the fastest way to reach Tradovate support?", a: "In-app live chat, opened from the Help (?) icon inside the platform. It reaches a human far faster than email, and it lets you capture the whole conversation and any case number in the transcript." },
    { q: "Why won't Tradovate answer my billing or refund email?", a: "Billing and financial-profile requests go to an email-focused back-office team with no direct inbound phone line, so those queues run slow. Escalate through chat, open a formal ticket with a case number, and follow up on a schedule instead of resending to the same inbox." },
    { q: "My prop account has a problem, do I contact Tradovate?", a: "Usually no. Tradovate can't resolve account-specific issues on funded or evaluation accounts and has no visibility into your firm's rules, drawdown, or resets. Contact your prop firm's support desk first, and only escalate to Tradovate if the firm confirms it's a platform-side issue." },
    { q: "Is there a Tradovate support phone number?", a: "Yes. Tradovate lists a Support line at 1 (844) 283-3100 for account and platform questions during business hours, and a Trade Desk line at (312) 283-3100 for live trade-related emergencies while markets are open. Confirm the current numbers and hours on Tradovate's official contact page before calling." },
    { q: "What should I do during an outage if support won't answer?", a: "For any live position you can't manage, call the Trade Desk rather than emailing, and control risk through a backup connection or a second platform. Outage-driven surges make email and chat slowest exactly when you need them most." },
    { q: "Can I dispute a Tradovate charge if support ignores me?", a: "If a genuine billing charge stays unresolved after documented, persistent follow-up, your dated log, screenshots, and case numbers give you the evidence to dispute the charge with your card issuer or bank. Keep that paper trail from your first contact." },
    { q: "Does Tradovate offer live chat and support tickets?", a: "Yes. From the platform's Help (?) menu you can start a live chat, submit a support ticket, request a screen-share session, and reach the trade desk. Fees, exact hours, and menu labels change over time, so check the current options in your platform." },
  ], de: [
    { q: "Wie lange braucht der Tradovate-Support für eine Antwort?", a: "Im Live-Chat erreichen Sie während der Supportzeiten in der Regel innerhalb weniger Minuten einen Menschen. Bei E-Mails und Anfragen an Spezialteams sieht es anders aus: Abrechnungs- und Finanzprofil-Themen können Tage oder länger dauern. Beginnen Sie bei dringenden Anliegen mit dem Chat." },
    { q: "Wie erreiche ich den Tradovate-Support am schnellsten?", a: "Über den In-App-Live-Chat, den Sie über das Help-(?)-Symbol in der Plattform öffnen. Er erreicht einen Menschen deutlich schneller als eine E-Mail, und Sie können das gesamte Gespräch samt Fallnummer im Transkript festhalten." },
    { q: "Warum beantwortet Tradovate meine E-Mail zu Abrechnung oder Rückerstattung nicht?", a: "Anfragen zu Abrechnung und Finanzprofil gehen an ein E-Mail-basiertes Back-Office-Team ohne direkte eingehende Telefonleitung, daher sind diese Warteschlangen langsam. Eskalieren Sie über den Chat, eröffnen Sie ein formelles Ticket mit Fallnummer und haken Sie planmäßig nach, statt erneut an dasselbe Postfach zu schreiben." },
    { q: "Mein Prop-Konto hat ein Problem, kontaktiere ich Tradovate?", a: "In der Regel nein. Tradovate kann kontospezifische Probleme bei finanzierten oder Evaluierungskonten nicht lösen und hat keinen Einblick in die Regeln, das Drawdown oder die Resets Ihrer Firma. Wenden Sie sich zuerst an den Support Ihrer Prop-Firma und eskalieren Sie nur dann an Tradovate, wenn die Firma bestätigt, dass es ein plattformseitiges Problem ist." },
    { q: "Gibt es eine Support-Telefonnummer von Tradovate?", a: "Ja. Tradovate nennt eine Support-Leitung unter 1 (844) 283-3100 für Konto- und Plattformfragen während der Geschäftszeiten sowie eine Trade-Desk-Leitung unter (312) 283-3100 für akute handelsbezogene Notfälle, solange die Märkte geöffnet sind. Prüfen Sie die aktuellen Nummern und Zeiten auf der offiziellen Kontaktseite von Tradovate, bevor Sie anrufen." },
    { q: "Was tue ich bei einem Ausfall, wenn der Support nicht antwortet?", a: "Rufen Sie bei jeder Live-Position, die Sie nicht verwalten können, den Trade Desk an, statt eine E-Mail zu schreiben, und steuern Sie das Risiko über eine Ersatzverbindung oder eine zweite Plattform. Ausfallbedingte Anfragewellen machen E-Mail und Chat genau dann am langsamsten, wenn Sie sie am dringendsten brauchen." },
    { q: "Kann ich eine Tradovate-Abbuchung anfechten, wenn der Support mich ignoriert?", a: "Wenn eine berechtigte Abbuchung trotz dokumentierter, beharrlicher Nachfragen ungeklärt bleibt, liefern Ihr datiertes Protokoll, Screenshots und Fallnummern die Beweise, um die Abbuchung bei Ihrem Kartenaussteller oder Ihrer Bank anzufechten. Führen Sie diese Dokumentation ab dem ersten Kontakt." },
    { q: "Bietet Tradovate Live-Chat und Support-Tickets an?", a: "Ja. Über das Help-(?)-Menü der Plattform können Sie einen Live-Chat starten, ein Support-Ticket einreichen, eine Screen-Sharing-Sitzung anfordern und den Trade Desk erreichen. Gebühren, genaue Zeiten und Menübezeichnungen ändern sich im Laufe der Zeit; prüfen Sie daher die aktuellen Optionen in Ihrer Plattform." },
  ], es: [
    { q: "¿Cuánto tarda en responder el soporte de Tradovate?", a: "El chat en vivo suele ponerle con una persona en pocos minutos durante el horario de soporte. El correo electrónico y las solicitudes a equipos especializados son otra historia: los asuntos de facturación y de perfil financiero pueden alargarse días o más. Empiece por el chat para cualquier cosa urgente." },
    { q: "¿Cuál es la forma más rápida de contactar con el soporte de Tradovate?", a: "El chat en vivo dentro de la aplicación, que se abre desde el icono Help (?) de la plataforma. Llega a una persona mucho más rápido que el correo y le permite conservar toda la conversación y cualquier número de caso en la transcripción." },
    { q: "¿Por qué Tradovate no responde a mi correo de facturación o reembolso?", a: "Las solicitudes de facturación y de perfil financiero van a un equipo de back office que trabaja por correo y no tiene línea telefónica de entrada directa, por lo que esas colas son lentas. Escale por el chat, abra un ticket formal con número de caso y haga seguimiento con un calendario en lugar de reenviar al mismo buzón." },
    { q: "Mi cuenta de prop firm tiene un problema, ¿contacto con Tradovate?", a: "Normalmente no. Tradovate no puede resolver problemas específicos de cuentas fondeadas o de evaluación y no tiene visibilidad de las reglas, el drawdown ni los reinicios de su firma. Contacte primero con el soporte de su prop firm y escale a Tradovate solo si la firma confirma que se trata de un problema de la plataforma." },
    { q: "¿Hay un número de teléfono de soporte de Tradovate?", a: "Sí. Tradovate indica una línea de Support en el 1 (844) 283-3100 para consultas de cuenta y plataforma en horario laboral, y una línea de Trade Desk en el (312) 283-3100 para emergencias operativas en directo mientras los mercados están abiertos. Confirme los números y horarios vigentes en la página oficial de contacto de Tradovate antes de llamar." },
    { q: "¿Qué debo hacer durante una caída si el soporte no responde?", a: "Para cualquier posición en vivo que no pueda gestionar, llame al Trade Desk en lugar de enviar un correo y controle el riesgo mediante una conexión de respaldo o una segunda plataforma. Los picos de demanda por caídas hacen que el correo y el chat sean más lentos justo cuando más los necesita." },
    { q: "¿Puedo disputar un cargo de Tradovate si el soporte me ignora?", a: "Si un cargo de facturación legítimo sigue sin resolverse tras un seguimiento documentado y persistente, su registro fechado, las capturas de pantalla y los números de caso le dan las pruebas para disputar el cargo ante su emisor de tarjeta o su banco. Conserve ese rastro documental desde el primer contacto." },
    { q: "¿Ofrece Tradovate chat en vivo y tickets de soporte?", a: "Sí. Desde el menú Help (?) de la plataforma puede iniciar un chat en vivo, enviar un ticket de soporte, solicitar una sesión de pantalla compartida y contactar con el trade desk. Las tarifas, los horarios exactos y los nombres de los menús cambian con el tiempo, así que revise las opciones vigentes en su plataforma." },
  ], fr: [
    { q: "Combien de temps le support Tradovate met-il à répondre ?", a: "Le chat en direct vous met généralement en relation avec une personne en quelques minutes pendant les heures de support. Les e-mails et les demandes adressées aux équipes spécialisées, c'est une autre histoire : les questions de facturation et de profil financier peuvent s'éterniser plusieurs jours, voire davantage. Commencez par le chat pour tout ce qui est urgent." },
    { q: "Quel est le moyen le plus rapide de joindre le support Tradovate ?", a: "Le chat en direct intégré à l'application, ouvert depuis l'icône Help (?) de la plateforme. Il met en relation avec une personne bien plus vite que l'e-mail et vous permet de conserver toute la conversation et tout numéro de dossier dans la transcription." },
    { q: "Pourquoi Tradovate ne répond-il pas à mon e-mail de facturation ou de remboursement ?", a: "Les demandes de facturation et de profil financier vont à une équipe de back-office qui travaille par e-mail et ne dispose pas de ligne téléphonique entrante directe ; ces files sont donc lentes. Escaladez par le chat, ouvrez un ticket formel avec un numéro de dossier et relancez selon un calendrier plutôt que de renvoyer vers la même boîte." },
    { q: "Mon compte de prop firm a un problème, dois-je contacter Tradovate ?", a: "En général non. Tradovate ne peut pas résoudre les problèmes propres aux comptes financés ou d'évaluation et n'a aucune visibilité sur les règles, le drawdown ou les réinitialisations de votre société. Contactez d'abord le support de votre prop firm, et n'escaladez vers Tradovate que si la société confirme qu'il s'agit d'un problème côté plateforme." },
    { q: "Existe-t-il un numéro de téléphone du support Tradovate ?", a: "Oui. Tradovate indique une ligne Support au 1 (844) 283-3100 pour les questions de compte et de plateforme pendant les heures ouvrables, et une ligne Trade Desk au (312) 283-3100 pour les urgences de trading en direct pendant l'ouverture des marchés. Confirmez les numéros et horaires actuels sur la page de contact officielle de Tradovate avant d'appeler." },
    { q: "Que faire pendant une panne si le support ne répond pas ?", a: "Pour toute position en direct que vous ne pouvez pas gérer, appelez le Trade Desk plutôt que d'envoyer un e-mail, et maîtrisez le risque via une connexion de secours ou une seconde plateforme. Les pics de demandes liés aux pannes rendent l'e-mail et le chat plus lents précisément quand vous en avez le plus besoin." },
    { q: "Puis-je contester un prélèvement Tradovate si le support m'ignore ?", a: "Si un prélèvement de facturation légitime reste non résolu après des relances documentées et persistantes, votre journal daté, vos captures d'écran et vos numéros de dossier vous donnent les preuves pour contester le prélèvement auprès de l'émetteur de votre carte ou de votre banque. Conservez cette trace écrite dès le premier contact." },
    { q: "Tradovate propose-t-il le chat en direct et des tickets de support ?", a: "Oui. Depuis le menu Help (?) de la plateforme, vous pouvez lancer un chat en direct, soumettre un ticket de support, demander une session de partage d'écran et joindre le trade desk. Les frais, les horaires exacts et les intitulés de menu évoluent avec le temps ; vérifiez donc les options actuelles dans votre plateforme." },
  ], it: [
    { q: "Quanto impiega il supporto di Tradovate a rispondere?", a: "La live chat di solito la mette in contatto con una persona nel giro di pochi minuti durante gli orari di supporto. E-mail e richieste ai team specializzati sono un'altra storia: le questioni di fatturazione e di profilo finanziario possono trascinarsi per giorni o più. Per qualsiasi cosa urgente cominci dalla chat." },
    { q: "Qual è il modo più rapido per raggiungere il supporto di Tradovate?", a: "La live chat nell'app, aperta dall'icona Help (?) all'interno della piattaforma. Raggiunge una persona molto più in fretta dell'e-mail e le consente di conservare l'intera conversazione ed eventuali numeri di pratica nella trascrizione." },
    { q: "Perché Tradovate non risponde alla mia e-mail di fatturazione o rimborso?", a: "Le richieste di fatturazione e di profilo finanziario vanno a un team di back office che lavora via e-mail e non ha una linea telefonica in entrata diretta, quindi quelle code sono lente. Scali tramite chat, apra un ticket formale con un numero di pratica e faccia follow-up con scadenze, invece di rispedire alla stessa casella." },
    { q: "Il mio conto prop ha un problema, devo contattare Tradovate?", a: "Di solito no. Tradovate non può risolvere problemi specifici dei conti finanziati o di valutazione e non ha visibilità sulle regole, sul drawdown o sui reset della sua società. Contatti prima il supporto della sua prop firm e scali a Tradovate solo se la società conferma che si tratta di un problema lato piattaforma." },
    { q: "Esiste un numero di telefono del supporto di Tradovate?", a: "Sì. Tradovate indica una linea Support al 1 (844) 283-3100 per domande su conto e piattaforma durante l'orario d'ufficio e una linea Trade Desk al (312) 283-3100 per emergenze di trading in tempo reale mentre i mercati sono aperti. Confermi i numeri e gli orari attuali sulla pagina dei contatti ufficiale di Tradovate prima di chiamare." },
    { q: "Cosa devo fare durante un'interruzione se il supporto non risponde?", a: "Per qualsiasi posizione aperta che non riesce a gestire, chiami il Trade Desk invece di scrivere un'e-mail e controlli il rischio tramite una connessione di backup o una seconda piattaforma. Le ondate di richieste dovute alle interruzioni rendono e-mail e chat più lente proprio quando ne ha più bisogno." },
    { q: "Posso contestare un addebito di Tradovate se il supporto mi ignora?", a: "Se un addebito di fatturazione legittimo resta irrisolto dopo solleciti documentati e persistenti, il suo registro datato, gli screenshot e i numeri di pratica le forniscono le prove per contestare l'addebito presso l'emittente della carta o la banca. Conservi questa documentazione fin dal primo contatto." },
