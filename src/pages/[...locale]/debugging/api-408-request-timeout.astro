---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "api-408-request-timeout";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/debugging/${SLUG}`;

const META_TITLE = "Tradovate API 408 Request Timeout (1 Connection)";
const META_DESCRIPTION =
  "Tradovate API 408 Request Timeout means you exceeded your one concurrent connection, close Trader, kill duplicate sessions, and keep the socket alive.";

// Short SEO title (<=60 chars) for locales where the shared h1 is too long for a SERP title.
const TITLE_OVERRIDE: Partial<Record<Locale, string>> = { es: "Tradovate API 408 Request Timeout (1 conexión)", it: "API Tradovate: errore 408 Request Timeout (1 connessione)" };

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate API", de: "Tradovate API", es: "Tradovate API", fr: "Tradovate API", it: "Tradovate API" },
  h1: { en: META_TITLE, de: "Tradovate API 408 Request Timeout (1 Verbindung)", es: "Error 408 Request Timeout de la API de Tradovate (1 conexión)", fr: "Erreur 408 Request Timeout de l'API Tradovate (1 connexion)", it: "Errore 408 Request Timeout dell'API Tradovate (1 connessione)" },
  dek: { en: "A 408 on Tradovate isn't a slow-network timeout. It means you've blown past the number of connections your account is allowed to hold at once, and a standard account only gets one.", de: "Ein 408-Fehler bei Tradovate ist kein Timeout durch ein langsames Netzwerk. Er bedeutet, dass Sie die Anzahl der Verbindungen überschritten haben, die Ihr Konto gleichzeitig halten darf, und ein Standardkonto erhält nur eine.", es: "Un 408 en Tradovate no es un tiempo de espera agotado por una red lenta. Significa que ha superado el número de conexiones que su cuenta puede mantener a la vez, y una cuenta estándar solo dispone de una.", fr: "Une erreur 408 sur Tradovate n'est pas un délai d'attente dû à un réseau lent. Elle signifie que vous avez dépassé le nombre de connexions que votre compte est autorisé à maintenir en même temps, et un compte standard n'en dispose que d'une seule.", it: "Un errore 408 su Tradovate non è un timeout dovuto a una rete lenta. Significa che ha superato il numero di connessioni che il Suo account può mantenere contemporaneamente, e un account standard ne ha diritto a una sola." },
  readTime: { en: "7 min read", de: "7 Minuten Lesezeit", es: "Lectura de 7 minutos", fr: "Lecture de 7 minutes", it: "Lettura di 7 minuti" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "You've got a bot talking to the Tradovate API, orders are flowing, and then out of nowhere the calls start coming back <strong class='text-white'>408 Request Timeout</strong>. On most servers a 408 means &ldquo;you were too slow, I gave up waiting.&rdquo; On Tradovate it means something completely different, and once you know what it's really telling you, the fix takes about thirty seconds. A 408 here is Tradovate's way of saying you've blown past the number of connections your account is allowed to hold at once. A standard account gets exactly <strong class='text-white'>one</strong> concurrent connection. If the Trader web app, a REST session, and your automation are all fighting for that single slot, the extras get bounced with a 408. Close whatever else is logged in as you, make sure only one thing connects at a time, and the error clears. A managed bridge like PickMyTrade sidesteps the whole problem by holding one clean connection for you." },
    {
      type: "checklist",
      heading: "Quick Checklist for the 408 Request Timeout Error",
      items: [
        "<strong class='text-white'>Close the Trader UI.</strong> If you've got Tradovate Trader open in a browser tab, the desktop app, or on your phone, it's holding your one connection, shut it down before your bot runs.",
        "<strong class='text-white'>Kill duplicate instances.</strong> A crashed or restarted script that never logged out leaves a ghost session. Confirm only one copy of your app is authenticating.",
        "<strong class='text-white'>One login at a time.</strong> Don't fire two logins for the same account in parallel, stagger startup so the old session drops before the new one connects.",
        "<strong class='text-white'>Renew, don't re-auth.</strong> Use <code>/auth/renewAccessToken</code> to extend your session instead of logging in fresh every cycle, which piles on connection churn.",
        "<strong class='text-white'>Need both? Get the second slot.</strong> To watch Trader <em>and</em> run a bot at once, you need the two-connection add-on, one slot can't do both.",
        "<strong class='text-white'>Keep the socket alive.</strong> Send a heartbeat every 2.5 seconds so an idle WebSocket doesn't get cut and force a messy reconnect.",
      ],
    },
    { type: "heading", text: "What \"408 Request Timeout\" Means on Tradovate" },
    { type: "paragraph", html: "In plain HTTP, <code>408 Request Timeout</code> is the server telling a client it waited too long for the request to arrive and closed the door. Tradovate reuses that status code for its own purpose. On this API, a 408 is what you get when you exceed the maximum number of concurrent connections tied to your user. It's not about network latency or a slow request body, it's a capacity signal. The platform is saying, &ldquo;too many of you are logged in as you right now.&rdquo;" },
    { type: "paragraph", html: "That reframing matters, because if you chase a 408 like a normal timeout, bumping request timeouts, retrying harder, blaming your VPS, you'll get nowhere. The number to look at isn't your latency. It's how many things are authenticated against your account at the exact moment the error fires." },
    { type: "heading", text: "You Get One Connection. That's the Whole Story." },
    { type: "paragraph", html: "Here's the rule that explains almost every 408: a standard Tradovate user gets a single established connection to the API per account. That one slot is shared by <em>everything</em> that authenticates as you, the Trader web app, the Trader desktop app, the mobile app, a REST session, and the market-data WebSocket your bot opens. They don't each get their own line. They all reach for the same one." },
    { type: "paragraph", html: "Tradovate spells out the consequence directly: logging on to Tradovate Trader ends your REST API and WebSocket session, and the reverse is true too. So if your bot is happily streaming quotes and you pop open Trader in a browser tab to eyeball a fill, one of them has to lose. The one that gets bumped starts throwing 408s. Flip it around, your bot reconnects while Trader is open, and now Trader is the one that drops. It feels random until you realize there was only ever room for one." },
    { type: "heading", text: "Top Causes of the Tradovate 408" },
    { type: "heading", text: "1. The Trader App Is Open While Your Bot Runs" },
    { type: "paragraph", html: "This is the everyday culprit. You leave Tradovate Trader open on a second monitor, a phone, or a forgotten browser tab, then start your automation. The bot connects, takes the slot, and Trader, or the bot, depending on timing, starts getting 408s. Anything that shows a live Tradovate session counts, including the mobile app running quietly in the background." },
    { type: "heading", text: "2. A Restart or Crash Left a Ghost Session" },
    { type: "paragraph", html: "Your script dies, restarts, and logs in again, but the previous session never cleanly logged out on the server side. For a short window you're holding two sessions against a one-slot account, and the new connection collects 408s until the old one times out. Auto-restart loops make this worse, because they can stack login after login before any of them expire." },
    { type: "heading", text: "3. The Same API Key Running From Two Places" },
    { type: "paragraph", html: "Cloud deployments are notorious for this. An auto-scaling group spins up a second container, or you leave a copy running on your laptop and another on a VPS, and both authenticate with the same credentials. Each new login fights the others for the single connection, and the 408s never settle down because nothing ever backs off." },
    { type: "heading", text: "4. A Tight Reconnect Loop" },
    { type: "paragraph", html: "When a socket drops, a naive client reconnects immediately, and if it's dropping for another reason (a missed heartbeat, say), you end up hammering login. That flood of connect attempts both trips the connection ceiling and racks up request traffic, so the 408s can get tangled up with rate-limit penalties on top." },
    { type: "heading", text: "How to Fix the 408 Request Timeout: Step-by-Step" },
    {
      type: "steps",
      items: [
        { title: "Free up your one connection", html: "Close everything else that logs in as you. Sign out of Tradovate Trader in every browser tab, quit the desktop app, and close the mobile app fully (not just background it). Give it a few seconds so the session actually releases on the server. This single step clears the majority of 408s, because most of the time the &ldquo;extra&rdquo; connection is just Trader sitting open." },
        { title: "Hunt down duplicate sessions", html: "Check for a stale copy of your own app. If your bot crashed and relaunched, an old process may still be authenticated. On a server, list running processes and confirm exactly one instance is live. In a scaled cloud setup, make sure only a single node ever authenticates for a given account, pin the connection to one worker instead of letting every replica log in." },
        { title: "Stagger your logins and renew, don't re-auth", html: "Design your startup so a new session waits for the old one to drop before connecting. And instead of calling the login endpoint every cycle, which spins up fresh connection churn, extend the session you already have. Send a <code>POST</code> to <code>/auth/renewAccessToken</code> with your still-valid token to get a new expiry without opening a brand-new session. Fewer logins means fewer chances to trip the connection ceiling." },
        { title: "If you truly need two things at once, add the second slot", html: "Some workflows genuinely need Trader open <em>and</em> a bot running, you want eyes on the ladder while automation manages exits. One connection can't do that. Tradovate offers a paid add-on that raises your ceiling to two concurrent connections; watching Trader plus one API app then fits comfortably. You enable it from your Tradovate account's subscription or add-on settings, the exact menu label has shifted over the years, so open your account management area and look for the connection or subscription add-on that mentions concurrent or dual connections, and confirm it's active before you rely on it." },
      ],
    },
    { type: "quote", html: "One caveat worth burning into memory: even with two slots, a sloppy restart that briefly holds three sessions still throws 408. Two is the ceiling on that plan, not an invitation to open connections freely. The discipline of &ldquo;one clean login at a time&rdquo; still applies, you just have a little more headroom." },
    { type: "heading", text: "Keep the Connection Alive So It Doesn't Drop" },
    { type: "paragraph", html: "Half the 408 pain comes from connections dropping and reconnecting badly. Keep the socket healthy and you stop generating the churn that trips the limit in the first place." },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Heartbeat every 2.5 seconds.</strong> The Tradovate WebSocket expects a heartbeat frame, an empty <code>[]</code> payload, at least every 2.5 seconds, or the server closes it for inactivity. A server that's actively streaming market data won't send its own heartbeats, so it's on you to keep the pulse going.",
        "<strong class='text-white'>Don't lean on <code>setInterval</code> in a browser.</strong> Background tabs throttle timers, which silently starves your heartbeat and drops the connection. Timestamp each message you receive and send a heartbeat once 2,500 ms have passed since the last one.",
        "<strong class='text-white'>Use unique request IDs.</strong> Reusing the same integer ID on concurrent requests can confuse the socket and drop it.",
        "<strong class='text-white'>Reconnect before ~24 hours.</strong> Long-lived sockets get cut around the 24-hour mark, so plan a graceful reconnect rather than waiting for the server to sever it mid-session.",
      ],
    },
    { type: "heading", text: "Troubleshooting Table" },
    {
      type: "table",
      headers: ["Symptom", "Likely Cause", "Fix"],
      rows: [
        ["408 the moment the bot connects", "Trader UI (web, desktop, or mobile) is already holding the slot", "Sign out of Trader everywhere, then connect the bot"],
        ["408 right after a crash or restart", "Ghost session from the previous run hasn't timed out", "Wait for the stale session to expire; ensure one instance logs in"],
        ["408 that never settles", "Same API key authenticating from two machines or replicas", "Pin the connection to a single node/process"],
        ["408 even with the add-on", "Three+ sessions briefly held (e.g., overlapping restart)", "Stagger logins; still keep it to one login at a time"],
        ["Socket drops, then 408 on reconnect", "Missed heartbeats causing a reconnect flood", "Send an empty [] heartbeat every 2.5 s; back off retries"],
        ["429, not 408", "Too many requests too fast (rate limit)", "Throttle request rate, different problem, different fix"],
      ],
    },
    { type: "heading", text: "Where PickMyTrade Fits" },
    { type: "paragraph", html: "Juggling a single connection slot by hand is fragile, one stray Trader tab or one messy restart and your automation starts bouncing 408s at the worst possible moment. PickMyTrade sits between TradingView and Tradovate and holds one clean, managed connection so you're never fighting yourself for the slot:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>One managed connection</strong>, the bridge keeps a single, stable session to Tradovate, so duplicate logins and ghost sessions don't stack up against your limit.",
        "<strong class='text-white'>Automatic session upkeep</strong>, tokens are renewed on schedule and heartbeats keep the socket alive, so it doesn't drop and trigger a reconnect storm.",
        "<strong class='text-white'>No raw connection plumbing</strong>, you route TradingView alerts and let the platform handle the connect/authenticate/reconnect cycle you'd otherwise babysit in code.",
        "<strong class='text-white'>Rate-limit-aware routing</strong>, requests are paced so you don't trade a 408 for a 429 penalty.",
      ],
    },
  ], de: [
    { type: "paragraph", html: "Ihr Bot kommuniziert mit der Tradovate-API, Orders laufen durch, und dann kommen die Aufrufe plötzlich mit <strong class='text-white'>408 Request Timeout</strong> zurück. Auf den meisten Servern bedeutet ein 408: &ldquo;Sie waren zu langsam, ich habe das Warten aufgegeben.&rdquo; Bei Tradovate bedeutet er etwas völlig anderes, und sobald Sie wissen, was er wirklich sagt, dauert die Behebung etwa dreißig Sekunden. Ein 408 bedeutet hier, dass Sie die Anzahl der Verbindungen überschritten haben, die Ihr Konto gleichzeitig halten darf. Ein Standardkonto erhält genau <strong class='text-white'>eine</strong> gleichzeitige Verbindung. Wenn die Trader-Web-App, eine REST-Sitzung und Ihre Automatisierung alle um diesen einen Platz konkurrieren, werden die zusätzlichen mit einem 408 abgewiesen. Schließen Sie alles andere, was als Sie angemeldet ist, stellen Sie sicher, dass immer nur eine Verbindung besteht, und der Fehler verschwindet. Eine verwaltete Brücke wie PickMyTrade umgeht das gesamte Problem, indem sie eine saubere Verbindung für Sie hält." },
    {
      type: "checklist",
      heading: "Kurz-Checkliste für den Fehler 408 Request Timeout",
      items: [
        "<strong class='text-white'>Schließen Sie die Trader-Oberfläche.</strong> Wenn Tradovate Trader in einem Browser-Tab, in der Desktop-App oder auf Ihrem Smartphone geöffnet ist, belegt es Ihre eine Verbindung, beenden Sie es, bevor Ihr Bot läuft.",
        "<strong class='text-white'>Beenden Sie doppelte Instanzen.</strong> Ein abgestürztes oder neu gestartetes Skript, das sich nie abgemeldet hat, hinterlässt eine Geistersitzung. Stellen Sie sicher, dass sich nur eine Kopie Ihrer App authentifiziert.",
        "<strong class='text-white'>Nur ein Login gleichzeitig.</strong> Starten Sie nicht zwei Logins für dasselbe Konto parallel, staffeln Sie den Start so, dass die alte Sitzung endet, bevor die neue sich verbindet.",
        "<strong class='text-white'>Erneuern statt neu anmelden.</strong> Nutzen Sie <code>/auth/renewAccessToken</code>, um Ihre Sitzung zu verlängern, statt sich jeden Zyklus neu anzumelden, was zusätzliche Verbindungswechsel verursacht.",
        "<strong class='text-white'>Beides nötig? Holen Sie sich den zweiten Platz.</strong> Um Trader <em>und</em> gleichzeitig einen Bot laufen zu lassen, benötigen Sie das Zwei-Verbindungen-Add-on, ein Platz reicht dafür nicht.",
        "<strong class='text-white'>Halten Sie den Socket am Leben.</strong> Senden Sie alle 2,5 Sekunden einen Heartbeat, damit ein inaktiver WebSocket nicht getrennt wird und einen unsauberen Reconnect erzwingt.",
      ],
    },
    { type: "heading", text: "Was \"408 Request Timeout\" bei Tradovate bedeutet" },
    { type: "paragraph", html: "In reinem HTTP teilt <code>408 Request Timeout</code> einem Client mit, dass der Server zu lange auf den Eingang der Anfrage gewartet und die Verbindung geschlossen hat. Tradovate verwendet diesen Statuscode für einen eigenen Zweck. Bei dieser API erhalten Sie einen 408, wenn Sie die maximale Anzahl gleichzeitiger Verbindungen für Ihren Benutzer überschreiten. Es geht nicht um Netzwerklatenz oder einen langsamen Request-Body, sondern um ein Kapazitätssignal. Die Plattform sagt damit: &ldquo;Zu viele von Ihnen sind gerade als Sie angemeldet.&rdquo;" },
    { type: "paragraph", html: "Diese Umdeutung ist wichtig, denn wenn Sie einen 408 wie ein normales Timeout behandeln, Request-Timeouts erhöhen, härter erneut versuchen, Ihren VPS beschuldigen, kommen Sie nicht weiter. Die entscheidende Zahl ist nicht Ihre Latenz. Es ist die Anzahl der Dinge, die genau in dem Moment, in dem der Fehler auftritt, gegen Ihr Konto authentifiziert sind." },
    { type: "heading", text: "Sie erhalten eine Verbindung. Das ist die ganze Geschichte." },
    { type: "paragraph", html: "Hier ist die Regel, die fast jeden 408 erklärt: Ein Standard-Tradovate-Nutzer erhält pro Konto eine einzige aktive Verbindung zur API. Dieser eine Platz wird von <em>allem</em> geteilt, was sich als Sie authentifiziert, der Trader-Web-App, der Trader-Desktop-App, der mobilen App, einer REST-Sitzung und dem Marktdaten-WebSocket, den Ihr Bot öffnet. Sie bekommen nicht jeweils eine eigene Leitung. Alle greifen nach derselben." },
    { type: "paragraph", html: "Tradovate erklärt die Konsequenz direkt: Die Anmeldung bei Tradovate Trader beendet Ihre REST-API- und WebSocket-Sitzung, und umgekehrt gilt dasselbe. Wenn Ihr Bot also gerade fröhlich Kurse streamt und Sie Trader in einem Browser-Tab öffnen, um einen Fill zu prüfen, muss eines von beiden verlieren. Dasjenige, das verdrängt wird, beginnt, 408-Fehler zu werfen. Umgekehrt genauso: Ihr Bot verbindet sich neu, während Trader geöffnet ist, und nun ist Trader dasjenige, das die Verbindung verliert. Es fühlt sich zufällig an, bis Sie erkennen, dass immer nur Platz für eine Verbindung war." },
    { type: "heading", text: "Häufigste Ursachen für den Tradovate-408" },
    { type: "heading", text: "1. Die Trader-App ist geöffnet, während Ihr Bot läuft" },
    { type: "paragraph", html: "Das ist der alltägliche Übeltäter. Sie lassen Tradovate Trader auf einem zweiten Monitor, einem Smartphone oder in einem vergessenen Browser-Tab geöffnet und starten dann Ihre Automatisierung. Der Bot verbindet sich, belegt den Platz, und Trader, oder der Bot, je nach Timing, erhält 408-Fehler. Alles, was eine aktive Tradovate-Sitzung zeigt, zählt, einschließlich der mobilen App, die still im Hintergrund läuft." },
    { type: "heading", text: "2. Ein Neustart oder Absturz hat eine Geistersitzung hinterlassen" },
    { type: "paragraph", html: "Ihr Skript stürzt ab, startet neu und meldet sich erneut an, aber die vorherige Sitzung hat sich serverseitig nie sauber abgemeldet. Für ein kurzes Zeitfenster halten Sie zwei Sitzungen gegen ein Konto mit nur einem Platz, und die neue Verbindung sammelt 408-Fehler, bis die alte abläuft. Automatische Neustart-Schleifen verschlimmern das, weil sie Login um Login stapeln können, bevor einer davon abläuft." },
    { type: "heading", text: "3. Derselbe API-Schlüssel läuft an zwei Orten" },
    { type: "paragraph", html: "Cloud-Deployments sind dafür berüchtigt. Eine Auto-Scaling-Gruppe startet einen zweiten Container, oder Sie lassen eine Kopie auf Ihrem Laptop und eine weitere auf einem VPS laufen, und beide authentifizieren sich mit denselben Zugangsdaten. Jeder neue Login konkurriert mit den anderen um die einzige Verbindung, und die 408-Fehler beruhigen sich nie, weil nichts jemals zurücksteckt." },
    { type: "heading", text: "4. Eine zu enge Reconnect-Schleife" },
    { type: "paragraph", html: "Wenn eine Verbindung abbricht, verbindet sich ein naiver Client sofort neu, und wenn sie aus einem anderen Grund abbricht (etwa einem verpassten Heartbeat), hämmern Sie ständig gegen den Login. Diese Flut von Verbindungsversuchen sprengt sowohl die Verbindungsgrenze als auch die Anfragenlast, sodass sich die 408-Fehler zusätzlich mit Rate-Limit-Strafen vermischen können." },
    { type: "heading", text: "So beheben Sie 408 Request Timeout: Schritt für Schritt" },
    {
      type: "steps",
      items: [
        { title: "Machen Sie Ihre eine Verbindung frei", html: "Schließen Sie alles andere, was sich als Sie anmeldet. Melden Sie sich in jedem Browser-Tab von Tradovate Trader ab, beenden Sie die Desktop-App und schließen Sie die mobile App vollständig (nicht nur in den Hintergrund legen). Geben Sie ihr ein paar Sekunden, damit die Sitzung serverseitig tatsächlich freigegeben wird. Dieser eine Schritt behebt die meisten 408-Fehler, denn meistens ist die &ldquo;zusätzliche&rdquo; Verbindung einfach nur ein geöffnetes Trader." },
        { title: "Spüren Sie doppelte Sitzungen auf", html: "Prüfen Sie auf eine veraltete Kopie Ihrer eigenen App. Wenn Ihr Bot abgestürzt ist und neu gestartet wurde, könnte ein alter Prozess noch authentifiziert sein. Listen Sie auf einem Server die laufenden Prozesse auf und bestätigen Sie, dass genau eine Instanz aktiv ist. In einem skalierten Cloud-Setup stellen Sie sicher, dass sich immer nur ein einzelner Knoten für ein bestimmtes Konto authentifiziert, binden Sie die Verbindung an einen Worker, statt jede Replik sich anmelden zu lassen." },
        { title: "Staffeln Sie Ihre Logins und erneuern Sie, statt sich neu zu authentifizieren", html: "Gestalten Sie Ihren Start so, dass eine neue Sitzung wartet, bis die alte beendet ist, bevor sie sich verbindet. Und statt bei jedem Zyklus den Login-Endpunkt aufzurufen, was zusätzlichen Verbindungswechsel erzeugt, verlängern Sie die Sitzung, die Sie bereits haben. Senden Sie ein <code>POST</code> an <code>/auth/renewAccessToken</code> mit Ihrem noch gültigen Token, um eine neue Ablaufzeit zu erhalten, ohne eine völlig neue Sitzung zu eröffnen. Weniger Logins bedeuten weniger Gelegenheiten, die Verbindungsgrenze zu reißen." },
        { title: "Wenn Sie wirklich beides gleichzeitig brauchen, holen Sie sich den zweiten Platz", html: "Manche Workflows brauchen wirklich Trader geöffnet <em>und</em> einen laufenden Bot, Sie wollen die Ladder im Blick behalten, während die Automatisierung Exits verwaltet. Eine Verbindung schafft das nicht. Tradovate bietet ein kostenpflichtiges Add-on, das Ihre Grenze auf zwei gleichzeitige Verbindungen anhebt; Trader plus eine API-App zu beobachten, passt dann problemlos. Sie aktivieren es in den Abonnement- oder Add-on-Einstellungen Ihres Tradovate-Kontos, die genaue Menübezeichnung hat sich im Lauf der Jahre verschoben, öffnen Sie also Ihren Kontobereich und suchen Sie nach dem Verbindungs- oder Abonnement-Add-on, das gleichzeitige oder doppelte Verbindungen erwähnt, und bestätigen Sie, dass es aktiv ist, bevor Sie sich darauf verlassen." },
      ],
    },
    { type: "quote", html: "Ein Vorbehalt, den Sie sich einprägen sollten: Selbst mit zwei Plätzen wirft ein unsauberer Neustart, der kurzzeitig drei Sitzungen hält, immer noch einen 408. Zwei ist die Obergrenze dieses Plans, keine Einladung, Verbindungen beliebig zu öffnen. Die Disziplin von &ldquo;immer nur ein sauberer Login gleichzeitig&rdquo; gilt weiterhin, Sie haben nur etwas mehr Spielraum." },
    { type: "heading", text: "Halten Sie die Verbindung aktiv, damit sie nicht abbricht" },
    { type: "paragraph", html: "Ein Großteil des 408-Ärgers entsteht durch Verbindungen, die schlecht abbrechen und sich neu verbinden. Halten Sie den Socket gesund, dann erzeugen Sie erst gar nicht den Wechsel, der das Limit auslöst." },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Heartbeat alle 2,5 Sekunden.</strong> Der Tradovate-WebSocket erwartet mindestens alle 2,5 Sekunden einen Heartbeat-Frame, ein leeres <code>[]</code>-Payload, sonst schließt der Server ihn wegen Inaktivität. Ein Server, der aktiv Marktdaten streamt, sendet keine eigenen Heartbeats, also liegt es an Ihnen, den Puls am Laufen zu halten.",
        "<strong class='text-white'>Verlassen Sie sich im Browser nicht auf <code>setInterval</code>.</strong> Hintergrund-Tabs drosseln Timer, was Ihren Heartbeat unbemerkt aushungert und die Verbindung trennt. Versehen Sie jede empfangene Nachricht mit einem Zeitstempel und senden Sie einen Heartbeat, sobald 2.500 ms seit dem letzten vergangen sind.",
        "<strong class='text-white'>Verwenden Sie eindeutige Request-IDs.</strong> Die Wiederverwendung derselben Integer-ID bei gleichzeitigen Anfragen kann den Socket verwirren und ihn trennen.",
        "<strong class='text-white'>Verbinden Sie sich vor ~24 Stunden neu.</strong> Langlebige Sockets werden um die 24-Stunden-Marke herum getrennt, planen Sie also einen kontrollierten Reconnect, statt darauf zu warten, dass der Server ihn mitten in der Sitzung kappt.",
      ],
    },
    { type: "heading", text: "Fehlerbehebungstabelle" },
    {
      type: "table",
      headers: ["Symptom", "Wahrscheinliche Ursache", "Lösung"],
      rows: [
        ["408 im Moment der Bot-Verbindung", "Trader-Oberfläche (Web, Desktop oder mobil) belegt bereits den Platz", "Überall bei Trader abmelden, dann den Bot verbinden"],
        ["408 direkt nach einem Absturz oder Neustart", "Geistersitzung aus dem vorherigen Lauf ist noch nicht abgelaufen", "Auf das Ablaufen der veralteten Sitzung warten; sicherstellen, dass sich nur eine Instanz anmeldet"],
        ["408, das sich nie beruhigt", "Derselbe API-Schlüssel authentifiziert sich von zwei Maschinen oder Repliken", "Die Verbindung an einen einzigen Knoten/Prozess binden"],
        ["408 sogar mit Add-on", "Kurzzeitig drei oder mehr Sitzungen gehalten (z. B. überlappender Neustart)", "Logins staffeln; weiterhin nur ein Login gleichzeitig"],
        ["Verbindung bricht ab, dann 408 beim Reconnect", "Verpasste Heartbeats verursachen eine Reconnect-Flut", "Alle 2,5 s einen leeren []-Heartbeat senden; Wiederholungen drosseln"],
