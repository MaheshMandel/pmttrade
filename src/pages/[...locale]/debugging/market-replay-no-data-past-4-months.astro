---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "market-replay-no-data-past-4-months";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/debugging/${SLUG}`;

const META_TITLE = "Tradovate Market Replay No Data Past 4 Months";
const META_DESCRIPTION =
  "Market Replay showing no data past 4 months? Learn why the start date jumps or goes blank and how to pull older futures sessions the right way.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Tradovate Market Replay: Keine Daten älter als 4 Monate", es: "Tradovate Market Replay sin datos más allá de 4 meses", fr: "Tradovate Market Replay sans données au-delà de 4 mois", it: "Tradovate Market Replay senza dati oltre i 4 mesi" },
  dek: { en: "Set Market Replay to a date a few months back and the chart comes up blank, or the session jumps to a different day entirely. Here's what's really going on and how to pull older futures sessions correctly.", de: "Sie stellen Market Replay auf ein Datum einige Monate zurück, und das Chart bleibt leer oder die Sitzung springt auf einen ganz anderen Tag. Hier erfahren Sie, was wirklich dahintersteckt und wie Sie ältere Futures-Sitzungen korrekt laden.", es: "Configura Market Replay en una fecha de hace unos meses y el gráfico aparece en blanco, o la sesión salta a un día completamente distinto. Aquí le explicamos qué ocurre realmente y cómo cargar correctamente sesiones antiguas de futuros.", fr: "Vous réglez Market Replay sur une date de quelques mois en arrière et le graphique reste vide, ou la session saute sur un tout autre jour. Voici ce qui se passe vraiment et comment charger correctement d'anciennes séances de contrats à terme.", it: "Imposta Market Replay su una data di qualche mese fa e il grafico appare vuoto, oppure la sessione salta a un giorno completamente diverso. Ecco cosa succede davvero e come caricare correttamente le sessioni più vecchie dei futures." },
  readTime: { en: "7 min read", de: "7 Min. Lesezeit", es: "Lectura de 7 min", fr: "Lecture : 7 min", it: "Lettura di 7 min" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "You set Market Replay to a date a few months back, hit start, and the chart is basically empty. Blank candles, big gaps, or the session drops you on a completely different day than the one you picked. Annoying, especially when you're trying to rehearse a setup you missed last quarter." },
    { type: "paragraph", html: "Here's the reassuring part: this almost never means your account is broken. Two ordinary things are usually behind it, and both take about a minute to sort out. Let's walk through what's actually happening and how to get that older session to load cleanly." },
    { type: "quote", html: "<strong class='text-white'>The fast fix</strong><br>Keep your replay window to roughly the last four months on the contract you're viewing.<br>If the start date snaps to another day, just re-select it, Tradovate bumps you to the nearest valid session.<br>Going further back than a quarter? Turn off <em>Autoroll Contracts</em> and load the exact contract that was front month back then." },
    { type: "heading", text: "What You're Actually Seeing" },
    { type: "paragraph", html: "The symptom shows up in two flavors, and it helps to know which one you're staring at." },
    { type: "paragraph", html: "The first is thin or missing data past a certain point. Everything replays fine for recent sessions, then somewhere around the four-month mark the candles turn patchy and eventually stop. Scroll back further and there's nothing at all." },
    { type: "paragraph", html: "The second is the date that won't stick. You pick, say, March 3rd, click start, and Tradovate quietly loads a different day with a note that reads something like &ldquo;Start time was adjusted to fit restrictions.&rdquo; It didn't ignore you on purpose. It moved your start to the closest session it's allowed to play." },
    { type: "heading", text: "Why Market Replay Runs Dry Past 4 Months" },
    { type: "heading", text: "You're Replaying a Front-Month Symbol" },
    { type: "paragraph", html: "This is the big one, and it catches almost everybody. Most people run replay on a continuous or current front-month symbol, whatever's active right now. The catch is that a quarterly futures contract only spends about three months as the active front month. Roll periods land in March, June, September, and December, so any single contract has a fairly short liquid life." },
    { type: "paragraph", html: "Push replay back past that window and you've walked off the back edge of the contract you're looking at. There's simply not much traded data there, because that contract wasn't the busy one yet. That's the &ldquo;four months&rdquo; wall people run into. It isn't a hard limit Tradovate set. It's just how long your current contract has actually been the front month." },
    { type: "heading", text: "Autoroll Contracts Is Stitching the Wrong Month" },
    { type: "paragraph", html: "Tradovate has a setting that automatically rolls your chart to the next contract as expirations pass. Great for live charting. Not so great inside replay, because it keeps trying to anchor everything to the current front month even when you've traveled months into the past. The result is gaps and half-loaded sessions where the data for that period lives on a different contract entirely." },
    { type: "paragraph", html: "Switch this off before you replay older dates and you stop fighting the platform over which contract it should be showing." },
    { type: "heading", text: "Your Data Window Depends on Your Access Level" },
    { type: "paragraph", html: "The last piece is how much history your account is actually entitled to. On a trial, replay covers only a small handful of recent sessions, think a week or two, not months. That alone explains a lot of &ldquo;it won't go back&rdquo; complaints." },
    { type: "paragraph", html: "The paid Market Replay add-on is what unlocks deep history, reaching all the way back to January 1, 2017 for products that existed in Tradovate then. Without that add-on active, the platform clamps your start date to whatever it can serve, which is exactly why your chosen day keeps sliding forward." },
    { type: "heading", text: "Fix It Step by Step" },
    { type: "heading", text: "Step 1: Confirm Your Market Replay Access" },
    { type: "paragraph", html: "Open Application Settings and go to the Add-Ons tab, then find the Market Replay panel. This is where you confirm whether deep-history replay is switched on for your account. If it's only the trial version, you'll be capped to a few recent sessions no matter what date you type in." },
    { type: "paragraph", html: "Pricing for the add-on changes from time to time, so check the current option shown in your own settings rather than trusting an old number. If you're on a prop-firm or evaluation account, this may be controlled by the firm instead of you." },
    { type: "heading", text: "Step 2: Keep the Window to About Four Months (or Switch Contracts)" },
    { type: "paragraph", html: "If you just want to rehearse recent price action, stay inside roughly the last four months on the contract you're already viewing. That's the range where your current front month has clean, continuous data, and replay will behave." },
    { type: "paragraph", html: "Need to go further back than a quarter? Don't fight the current contract. Instead, load the specific contract that was actually front month during the period you care about. That's the real trick to unlocking older data, and it's covered in the next two steps." },
    { type: "heading", text: "Step 3: Turn Off Autoroll Contracts" },
    { type: "paragraph", html: "Before you start an older replay session, disable Autoroll Contracts. With it off, Tradovate stops forcing your view back onto today's front month and lets the historical contract you pick actually load its own data. This one change clears up most of the gap-and-blank behavior on dates older than a few months." },
    { type: "heading", text: "Step 4: Pick the Right Historical Contract" },
    { type: "paragraph", html: "Futures contracts carry a month code that tells you which delivery month they're for. Match the contract to the period you want to replay and the data shows up where the current front month couldn't. Here are the quarterly codes you'll use most for the index and equity futures:" },
    {
      type: "table",
      headers: ["Month code", "Delivery month", "Example (Nasdaq / NQ)"],
      rows: [
        ["H", "March", "NQH4 = March 2024"],
        ["M", "June", "NQM4 = June 2024"],
        ["U", "September", "NQU3 = September 2023"],
        ["Z", "December", "NQZ3 = December 2023"],
      ],
    },
    { type: "paragraph", html: "So if you want to replay a September 2023 session, you'd load NQU3 rather than the plain continuous symbol. When you're not sure which contract was leading during a given stretch, the CME Group site lists active contract dates. Load that specific contract, set your date inside its trading life, and start the session." },
    { type: "heading", text: "Step 5: Re-select the Date If It Jumps" },
    { type: "paragraph", html: "If the start date still snaps to a different day, that's Tradovate telling you the day you asked for isn't available, a weekend, a holiday, a date before your contract started trading, or a date beyond your data window. Re-enter the date and start again. Remember that changing the date or time mid-session doesn't take hold on its own; you have to stop the replay and start it fresh for a new date to apply." },
    { type: "paragraph", html: "If it holds this time, you're done. If it keeps bouncing to the same adjusted day no matter what you enter, you've hit the edge of your available data, and Step 1 is where to look." },
    { type: "heading", text: "If the Date Still Won't Hold" },
    { type: "paragraph", html: "A couple of situations sit outside the normal fix. If you're on a prop-firm evaluation or funded account, replay history and market data are often provisioned by the firm rather than something you can toggle yourself. Limits and available windows vary by firm and account size, so check your firm's current rules and reach out to their support if the add-on isn't even selectable in your settings." },
    { type: "paragraph", html: "And if you've confirmed the add-on is active, turned off Autoroll, loaded the correct historical contract, and a specific recent date genuinely has no data when it clearly should, that's worth a note to Tradovate support. Give them the exact symbol, the date, and the message you saw. That's a real data question, not a settings mix-up, and they can check it against their feed." },
  ], de: [
    { type: "paragraph",html: "Sie haben Market Replay auf ein Datum einige Monate zurück gestellt, auf Start geklickt, und das Chart ist praktisch leer. Leere Kerzen, große Lücken oder die Sitzung setzt Sie auf einen komplett anderen Tag als den gewählten. Ärgerlich, besonders wenn Sie ein Setup vom letzten Quartal nachspielen wollten." },
    { type: "paragraph",html: "Die beruhigende Nachricht: Das bedeutet fast nie, dass Ihr Konto defekt ist. Meist stecken zwei gewöhnliche Dinge dahinter, und beide sind in etwa einer Minute erledigt. Gehen wir durch, was tatsächlich passiert und wie Sie diese ältere Sitzung sauber geladen bekommen." },
    { type: "quote",html: "<strong class='text-white'>Die schnelle Lösung</strong><br>Halten Sie Ihr Replay-Fenster auf etwa die letzten vier Monate beim angezeigten Kontrakt.<br>Springt das Startdatum auf einen anderen Tag, wählen Sie es einfach erneut aus, Tradovate setzt Sie auf die nächstgelegene gültige Sitzung.<br>Weiter als ein Quartal zurück? Deaktivieren Sie <em>Autoroll Contracts</em> und laden Sie den genauen Kontrakt, der damals Front Month war." },
    { type: "heading",text: "Was Sie tatsächlich sehen" },
    { type: "paragraph",html: "Das Symptom zeigt sich in zwei Varianten, und es hilft zu wissen, welche Sie vor sich haben." },
    { type: "paragraph",html: "Die erste sind dünne oder fehlende Daten ab einem bestimmten Punkt. Aktuelle Sitzungen werden einwandfrei abgespielt, dann werden die Kerzen etwa bei der Vier-Monats-Marke lückenhaft und hören schließlich ganz auf. Gehen Sie weiter zurück, ist da gar nichts mehr." },
    { type: "paragraph",html: "Die zweite ist das Datum, das nicht hält. Sie wählen etwa den 3. März, klicken auf Start, und Tradovate lädt stillschweigend einen anderen Tag mit einem Hinweis wie &ldquo;Start time was adjusted to fit restrictions.&rdquo; Es hat Sie nicht absichtlich ignoriert. Es hat Ihren Start auf die nächstgelegene Sitzung verschoben, die es abspielen darf." },
    { type: "heading",text: "Warum Market Replay nach 4 Monaten leerläuft" },
    { type: "heading",text: "Sie spielen ein Front-Month-Symbol ab" },
    { type: "paragraph",html: "Das ist der Hauptgrund, und er erwischt fast jeden. Die meisten nutzen Replay mit einem kontinuierlichen oder aktuellen Front-Month-Symbol, was gerade aktiv ist. Der Haken: Ein quartalsweiser Futures-Kontrakt ist nur etwa drei Monate der aktive Front Month. Die Roll-Perioden fallen auf März, Juni, September und Dezember, daher hat jeder einzelne Kontrakt eine recht kurze liquide Lebensdauer." },
    { type: "paragraph",html: "Gehen Sie im Replay über dieses Fenster hinaus zurück, haben Sie die hintere Kante des Kontrakts verlassen, den Sie ansehen. Dort gibt es schlicht kaum gehandelte Daten, weil dieser Kontrakt noch nicht der aktive war. Das ist die „Vier-Monats“-Wand, gegen die Leute laufen. Es ist keine harte Grenze, die Tradovate gesetzt hat. Es ist nur die Zeitspanne, in der Ihr aktueller Kontrakt tatsächlich Front Month war." },
    { type: "heading",text: "Autoroll Contracts verknüpft den falschen Monat" },
    { type: "paragraph",html: "Tradovate hat eine Einstellung, die Ihr Chart automatisch auf den nächsten Kontrakt umstellt, wenn Verfallstermine vergehen. Großartig für Live-Charts. Weniger großartig im Replay, denn sie versucht ständig, alles am aktuellen Front Month zu verankern, selbst wenn Sie Monate in die Vergangenheit gereist sind. Das Ergebnis sind Lücken und halb geladene Sitzungen, in denen die Daten dieses Zeitraums auf einem ganz anderen Kontrakt liegen." },
    { type: "paragraph",html: "Schalten Sie das aus, bevor Sie ältere Daten abspielen, und Sie streiten nicht länger mit der Plattform darüber, welchen Kontrakt sie anzeigen soll." },
    { type: "heading",text: "Ihr Datenfenster hängt von Ihrer Zugriffsstufe ab" },
    { type: "paragraph",html: "Der letzte Baustein ist, wie viel Historie Ihrem Konto tatsächlich zusteht. In einer Testphase deckt Replay nur eine kleine Handvoll aktueller Sitzungen ab, denken Sie an ein oder zwei Wochen, nicht Monate. Das allein erklärt viele „es geht nicht weiter zurück“-Beschwerden." },
    { type: "paragraph",html: "Das kostenpflichtige Market-Replay-Add-on schaltet die tiefe Historie frei, die bis zum 1. Januar 2017 zurückreicht, für Produkte, die damals bei Tradovate existierten. Ohne aktives Add-on begrenzt die Plattform Ihr Startdatum auf das, was sie liefern kann, und genau deshalb rutscht Ihr gewählter Tag immer wieder nach vorn." },
    { type: "heading",text: "Die Lösung Schritt für Schritt" },
    { type: "heading",text: "Schritt 1: Ihren Market-Replay-Zugang bestätigen" },
    { type: "paragraph",html: "Öffnen Sie Application Settings und gehen Sie zum Tab Add-Ons, und suchen Sie dann das Panel Market Replay. Hier bestätigen Sie, ob das Replay mit tiefer Historie für Ihr Konto aktiviert ist. Handelt es sich nur um die Testversion, sind Sie unabhängig vom eingegebenen Datum auf wenige aktuelle Sitzungen begrenzt." },
    { type: "paragraph",html: "Der Preis für das Add-on ändert sich von Zeit zu Zeit. Prüfen Sie daher die aktuelle Option in Ihren eigenen Einstellungen, statt sich auf eine alte Zahl zu verlassen. Wenn Sie ein Prop-Firm- oder Evaluierungskonto haben, kann dies von der Firma statt von Ihnen gesteuert werden." },
    { type: "heading",text: "Schritt 2: Das Fenster auf etwa vier Monate begrenzen (oder Kontrakte wechseln)" },
    { type: "paragraph",html: "Wenn Sie nur jüngste Kursbewegungen proben möchten, bleiben Sie innerhalb der letzten etwa vier Monate beim Kontrakt, den Sie ohnehin ansehen. In diesem Bereich hat Ihr aktueller Front Month saubere, durchgehende Daten, und das Replay verhält sich ordentlich." },
    { type: "paragraph",html: "Müssen Sie weiter als ein Quartal zurück? Kämpfen Sie nicht gegen den aktuellen Kontrakt. Laden Sie stattdessen den konkreten Kontrakt, der im gewünschten Zeitraum tatsächlich Front Month war. Das ist der eigentliche Trick, um ältere Daten freizuschalten, und er wird in den nächsten zwei Schritten behandelt." },
    { type: "heading",text: "Schritt 3: Autoroll Contracts ausschalten" },
    { type: "paragraph",html: "Deaktivieren Sie Autoroll Contracts, bevor Sie eine ältere Replay-Sitzung starten. Ist die Option aus, zwingt Tradovate Ihre Ansicht nicht mehr auf den heutigen Front Month zurück und lässt den von Ihnen gewählten historischen Kontrakt seine eigenen Daten laden. Diese eine Änderung beseitigt den Großteil des Lücken-und-Leere-Verhaltens bei Daten, die älter als ein paar Monate sind." },
    { type: "heading",text: "Schritt 4: Den richtigen historischen Kontrakt wählen" },
    { type: "paragraph",html: "Futures-Kontrakte tragen einen Monatscode, der angibt, für welchen Liefermonat sie gelten. Ordnen Sie den Kontrakt dem Zeitraum zu, den Sie abspielen möchten, und die Daten erscheinen dort, wo der aktuelle Front Month sie nicht liefern konnte. Hier sind die Quartalscodes, die Sie für Index- und Aktien-Futures am häufigsten benötigen:" },
    { type: "table", headers: ["Monatscode","Liefermonat","Beispiel (Nasdaq / NQ)"], rows: [
      ["H","März","NQH4 = März 2024"],
      ["M","Juni","NQM4 = Juni 2024"],
      ["U","September","NQU3 = September 2023"],
      ["Z","Dezember","NQZ3 = Dezember 2023"],
    ] },
    { type: "paragraph",html: "Wenn Sie also eine Sitzung vom September 2023 abspielen möchten, laden Sie NQU3 statt des einfachen kontinuierlichen Symbols. Wenn Sie nicht sicher sind, welcher Kontrakt in einem bestimmten Zeitraum führend war, listet die Website der CME Group die aktiven Kontraktdaten auf. Laden Sie genau diesen Kontrakt, setzen Sie Ihr Datum innerhalb seiner Handelsdauer und starten Sie die Sitzung." },
    { type: "heading",text: "Schritt 5: Das Datum erneut auswählen, wenn es springt" },
    { type: "paragraph",html: "Springt das Startdatum weiterhin auf einen anderen Tag, teilt Tradovate Ihnen damit mit, dass der angeforderte Tag nicht verfügbar ist: ein Wochenende, ein Feiertag, ein Datum vor Handelsbeginn Ihres Kontrakts oder ein Datum jenseits Ihres Datenfensters. Geben Sie das Datum erneut ein und starten Sie neu. Beachten Sie, dass eine Änderung von Datum oder Uhrzeit mitten in der Sitzung nicht von selbst greift. Sie müssen das Replay stoppen und neu starten, damit ein neues Datum gilt." },
    { type: "paragraph",html: "Hält es diesmal, sind Sie fertig. Springt es unabhängig von Ihrer Eingabe immer wieder auf denselben angepassten Tag, haben Sie die Grenze Ihrer verfügbaren Daten erreicht, und Schritt 1 ist die Stelle, an der Sie suchen müssen." },
    { type: "heading",text: "Wenn das Datum immer noch nicht hält" },
    { type: "paragraph",html: "Einige Situationen liegen außerhalb der üblichen Lösung. Wenn Sie ein Evaluierungs- oder Funded-Konto einer Prop-Firma nutzen, werden Replay-Historie und Marktdaten oft von der Firma bereitgestellt und sind nichts, was Sie selbst umschalten können. Grenzen und verfügbare Zeitfenster unterscheiden sich je nach Firma und Kontogröße. Prüfen Sie daher die aktuellen Regeln Ihrer Firma und wenden Sie sich an deren Support, wenn das Add-on in Ihren Einstellungen nicht einmal auswählbar ist." },
    { type: "paragraph",html: "Und wenn Sie bestätigt haben, dass das Add-on aktiv ist, Autoroll ausgeschaltet und den richtigen historischen Kontrakt geladen haben und ein bestimmtes aktuelles Datum tatsächlich keine Daten hat, obwohl es welche haben sollte, ist das eine Nachricht an den Tradovate-Support wert. Nennen Sie das genaue Symbol, das Datum und die angezeigte Meldung. Das ist eine echte Datenfrage, kein Einstellungsirrtum, und der Support kann sie mit seinem Feed abgleichen." },
  ], es: [
    { type: "paragraph",html: "Configuró Market Replay en una fecha de hace unos meses, pulsó iniciar y el gráfico está básicamente vacío. Velas en blanco, grandes huecos o la sesión le lleva a un día completamente distinto del que eligió. Molesto, sobre todo cuando intenta ensayar un setup que se perdió el trimestre pasado." },
    { type: "paragraph",html: "Lo tranquilizador: esto casi nunca significa que su cuenta esté rota. Normalmente hay dos cosas corrientes detrás, y ambas se resuelven en un minuto. Veamos qué ocurre realmente y cómo conseguir que esa sesión antigua cargue limpiamente." },
    { type: "quote",html: "<strong class='text-white'>La solución rápida</strong><br>Mantenga su ventana de replay en aproximadamente los últimos cuatro meses del contrato que está viendo.<br>Si la fecha de inicio salta a otro día, simplemente vuelva a seleccionarla, Tradovate le lleva a la sesión válida más cercana.<br>¿Retrocede más de un trimestre? Desactive <em>Autoroll Contracts</em> y cargue el contrato exacto que era el mes frontal en aquel momento." },
    { type: "heading",text: "Lo que realmente está viendo" },
    { type: "paragraph",html: "El síntoma aparece en dos versiones y ayuda saber cuál tiene delante." },
    { type: "paragraph",html: "La primera son datos escasos o ausentes a partir de cierto punto. Todo se reproduce bien en las sesiones recientes y luego, alrededor de la marca de los cuatro meses, las velas se vuelven irregulares y acaban por desaparecer. Retroceda más y no hay nada en absoluto." },
    { type: "paragraph",html: "La segunda es la fecha que no se mantiene. Elige, por ejemplo, el 3 de marzo, pulsa iniciar y Tradovate carga en silencio un día distinto con una nota que dice algo como &ldquo;Start time was adjusted to fit restrictions.&rdquo; No le ignoró a propósito. Movió su inicio a la sesión más cercana que se le permite reproducir." },
    { type: "heading",text: "Por qué Market Replay se queda sin datos pasados 4 meses" },
    { type: "heading",text: "Está reproduciendo un símbolo del mes frontal" },
    { type: "paragraph",html: "Este es el motivo principal y atrapa a casi todo el mundo. La mayoría ejecuta el replay con un símbolo continuo o del mes frontal actual, lo que esté activo ahora. El problema es que un contrato de futuros trimestral pasa solo unos tres meses como mes frontal activo. Los periodos de rolleo caen en marzo, junio, septiembre y diciembre, así que cada contrato tiene una vida líquida bastante corta." },
    { type: "paragraph",html: "Si retrocede el replay más allá de esa ventana, se sale por el borde posterior del contrato que está viendo. Simplemente no hay muchos datos negociados allí, porque ese contrato aún no era el activo. Esa es la pared de los «cuatro meses» contra la que choca la gente. No es un límite estricto fijado por Tradovate. Es solo el tiempo que su contrato actual lleva siendo el mes frontal." },
    { type: "heading",text: "Autoroll Contracts está uniendo el mes equivocado" },
    { type: "paragraph",html: "Tradovate tiene un ajuste que pasa automáticamente su gráfico al siguiente contrato a medida que pasan los vencimientos. Genial para gráficos en vivo. No tan genial dentro del replay, porque intenta anclar todo al mes frontal actual aunque haya viajado meses al pasado. El resultado son huecos y sesiones medio cargadas donde los datos de ese periodo viven en un contrato completamente distinto." },
    { type: "paragraph",html: "Desactívelo antes de reproducir fechas antiguas y dejará de pelearse con la plataforma sobre qué contrato debe mostrar." },
    { type: "heading",text: "Su ventana de datos depende de su nivel de acceso" },
    { type: "paragraph",html: "La última pieza es cuánto historial le corresponde realmente a su cuenta. En una prueba, el replay cubre solo un pequeño puñado de sesiones recientes, piense en una o dos semanas, no meses. Eso solo explica muchas quejas de «no retrocede más»." },
    { type: "paragraph",html: "El complemento de pago de Market Replay es lo que desbloquea el historial profundo, que llega hasta el 1 de enero de 2017 para los productos que existían entonces en Tradovate. Sin ese complemento activo, la plataforma limita su fecha de inicio a lo que puede servir, y por eso el día que elige se desplaza una y otra vez hacia adelante." },
    { type: "heading",text: "Solución paso a paso" },
    { type: "heading",text: "Paso 1: Confirme su acceso a Market Replay" },
    { type: "paragraph",html: "Abra Application Settings y vaya a la pestaña Add-Ons, luego busque el panel Market Replay. Aquí confirma si el replay con historial profundo está activado en su cuenta. Si es solo la versión de prueba, estará limitado a unas pocas sesiones recientes sin importar qué fecha escriba." },
    { type: "paragraph",html: "El precio del complemento cambia de vez en cuando, así que consulte la opción actual que aparece en su propia configuración en lugar de fiarse de una cifra antigua. Si está en una cuenta de prop firm o de evaluación, esto puede estar controlado por la firma y no por usted." },
    { type: "heading",text: "Paso 2: Mantenga la ventana en unos cuatro meses (o cambie de contrato)" },
    { type: "paragraph",html: "Si solo quiere ensayar la acción de precio reciente, permanezca dentro de aproximadamente los últimos cuatro meses del contrato que ya está viendo. Ese es el rango en el que su mes frontal actual tiene datos limpios y continuos, y el replay se comportará." },
    { type: "paragraph",html: "¿Necesita retroceder más de un trimestre? No pelee con el contrato actual. En su lugar, cargue el contrato específico que realmente fue el mes frontal durante el periodo que le interesa. Ese es el verdadero truco para desbloquear datos más antiguos, y se explica en los dos pasos siguientes." },
    { type: "heading",text: "Paso 3: Desactive Autoroll Contracts" },
    { type: "paragraph",html: "Antes de iniciar una sesión de replay antigua, desactive Autoroll Contracts. Con la opción desactivada, Tradovate deja de forzar su vista de nuevo al mes frontal de hoy y permite que el contrato histórico que elija cargue sus propios datos. Este solo cambio resuelve la mayor parte del comportamiento de huecos y vacíos en fechas anteriores a unos pocos meses." },
    { type: "heading",text: "Paso 4: Elija el contrato histórico correcto" },
    { type: "paragraph",html: "Los contratos de futuros llevan un código de mes que indica a qué mes de entrega corresponden. Haga coincidir el contrato con el periodo que quiere reproducir y los datos aparecerán donde el mes frontal actual no pudo ofrecerlos. Estos son los códigos trimestrales que más usará para los futuros de índices y renta variable:" },
    { type: "table", headers: ["Código de mes","Mes de entrega","Ejemplo (Nasdaq / NQ)"], rows: [
      ["H","Marzo","NQH4 = marzo de 2024"],
      ["M","Junio","NQM4 = junio de 2024"],
      ["U","Septiembre","NQU3 = septiembre de 2023"],
      ["Z","Diciembre","NQZ3 = diciembre de 2023"],
    ] },
    { type: "paragraph",html: "Así que, si quiere reproducir una sesión de septiembre de 2023, cargaría NQU3 en lugar del símbolo continuo genérico. Cuando no esté seguro de qué contrato lideraba durante un tramo determinado, el sitio de CME Group lista las fechas de los contratos activos. Cargue ese contrato específico, fije su fecha dentro de su vida operativa e inicie la sesión." },
    { type: "heading",text: "Paso 5: Vuelva a seleccionar la fecha si salta" },
    { type: "paragraph",html: "Si la fecha de inicio sigue saltando a un día distinto, Tradovate le está diciendo que el día que pidió no está disponible: un fin de semana, un festivo, una fecha anterior al inicio de cotización de su contrato o una fecha más allá de su ventana de datos. Vuelva a introducir la fecha e inicie de nuevo. Recuerde que cambiar la fecha o la hora a mitad de sesión no surte efecto por sí solo; debe detener el replay e iniciarlo de nuevo para que se aplique una fecha nueva." },
    { type: "paragraph",html: "Si esta vez se mantiene, ha terminado. Si sigue rebotando al mismo día ajustado sin importar lo que introduzca, ha llegado al límite de sus datos disponibles, y el Paso 1 es donde debe mirar." },
    { type: "heading",text: "Si la fecha sigue sin mantenerse" },
    { type: "paragraph",html: "Un par de situaciones quedan fuera de la solución habitual. Si está en una cuenta de evaluación o financiada de una prop firm, el historial de replay y los datos de mercado suelen ser aprovisionados por la firma y no algo que pueda activar usted mismo. Los límites y las ventanas disponibles varían según la firma y el tamaño de la cuenta, así que consulte las reglas actuales de su firma y contacte con su soporte si el complemento ni siquiera se puede seleccionar en su configuración." },
    { type: "paragraph",html: "Y si ha confirmado que el complemento está activo, ha desactivado Autoroll, ha cargado el contrato histórico correcto y una fecha reciente concreta realmente no tiene datos cuando claramente debería, merece una nota al soporte de Tradovate. Dígales el símbolo exacto, la fecha y el mensaje que vio. Es una cuestión real de datos, no una confusión de configuración, y pueden verificarla con su feed." },
  ], fr: [
    { type: "paragraph",html: "Vous avez réglé Market Replay sur une date de quelques mois en arrière, lancé la lecture, et le graphique est pratiquement vide. Des bougies vides, de gros trous, ou la séance vous dépose sur un jour complètement différent de celui choisi. Agaçant, surtout quand vous voulez répéter une configuration manquée le trimestre dernier." },
    { type: "paragraph",html: "Voici la partie rassurante : cela ne signifie presque jamais que votre compte est défectueux. Deux choses ordinaires en sont généralement la cause, et toutes deux se règlent en environ une minute. Voyons ce qui se passe réellement et comment charger proprement cette séance plus ancienne." },
    { type: "quote",html: "<strong class='text-white'>La solution rapide</strong><br>Limitez votre fenêtre de replay à environ les quatre derniers mois sur le contrat que vous consultez.<br>Si la date de début saute sur un autre jour, resélectionnez-la simplement, Tradovate vous place sur la séance valide la plus proche.<br>Vous remontez de plus d'un trimestre ? Désactivez <em>Autoroll Contracts</em> et chargez le contrat exact qui était le mois de référence à l'époque." },
    { type: "heading",text: "Ce que vous voyez réellement" },
    { type: "paragraph",html: "Le symptôme se présente sous deux formes, et il est utile de savoir laquelle vous avez sous les yeux." },
    { type: "paragraph",html: "La première, ce sont des données clairsemées ou absentes au-delà d'un certain point. Tout se rejoue bien pour les séances récentes, puis, vers la barre des quatre mois, les bougies deviennent irrégulières et finissent par disparaître. Remontez plus loin et il n'y a plus rien du tout." },
    { type: "paragraph",html: "La seconde est la date qui ne tient pas. Vous choisissez, disons, le 3 mars, vous lancez la lecture, et Tradovate charge discrètement un autre jour avec une note du type &ldquo;Start time was adjusted to fit restrictions.&rdquo; Il ne vous a pas ignoré exprès. Il a déplacé votre début vers la séance la plus proche qu'il est autorisé à lire." },
    { type: "heading",text: "Pourquoi Market Replay s'épuise au-delà de 4 mois" },
    { type: "heading",text: "Vous rejouez un symbole du mois de référence" },
    { type: "paragraph",html: "C'est la cause principale, et elle piège presque tout le monde. La plupart des gens utilisent le replay sur un symbole continu ou du mois de référence actuel, celui qui est actif maintenant. Le piège, c'est qu'un contrat à terme trimestriel ne reste le mois de référence actif qu'environ trois mois. Les périodes de roll tombent en mars, juin, septembre et décembre, de sorte que chaque contrat a une vie liquide assez courte." },
    { type: "paragraph",html: "Remontez le replay au-delà de cette fenêtre et vous sortez par l'arrière du contrat que vous regardez. Il n'y a tout simplement pas beaucoup de données négociées là, car ce contrat n'était pas encore le contrat actif. C'est le mur des « quatre mois » sur lequel les gens butent. Ce n'est pas une limite stricte fixée par Tradovate. C'est simplement la durée pendant laquelle votre contrat actuel a réellement été le mois de référence." },
    { type: "heading",text: "Autoroll Contracts raccorde le mauvais mois" },
    { type: "paragraph",html: "Tradovate propose un réglage qui fait automatiquement passer votre graphique au contrat suivant à mesure que les échéances passent. Très bien pour les graphiques en direct. Moins bien dans le replay, car il cherche sans cesse à tout ancrer au mois de référence actuel même quand vous avez remonté de plusieurs mois. Résultat : des trous et des séances à moitié chargées où les données de cette période se trouvent sur un tout autre contrat." },
    { type: "paragraph",html: "Désactivez-le avant de rejouer des dates plus anciennes et vous cessez de lutter avec la plateforme sur le contrat qu'elle doit afficher." },
    { type: "heading",text: "Votre fenêtre de données dépend de votre niveau d'accès" },
    { type: "paragraph",html: "Le dernier élément est la quantité d'historique à laquelle votre compte a réellement droit. En essai, le replay ne couvre qu'une petite poignée de séances récentes, pensez à une semaine ou deux, pas à des mois. Cela explique à lui seul beaucoup de plaintes du type « il ne remonte pas plus loin »." },
    { type: "paragraph",html: "Le module complémentaire payant Market Replay est ce qui débloque l'historique profond, qui remonte jusqu'au 1er janvier 2017 pour les produits qui existaient alors dans Tradovate. Sans ce module actif, la plateforme limite votre date de début à ce qu'elle peut servir, et c'est exactement pourquoi le jour choisi glisse sans cesse vers l'avant." },
    { type: "heading",text: "La solution pas à pas" },
    { type: "heading",text: "Étape 1 : Vérifiez votre accès à Market Replay" },
    { type: "paragraph",html: "Ouvrez Application Settings et allez dans l'onglet Add-Ons, puis trouvez le panneau Market Replay. C'est ici que vous confirmez si le replay à historique profond est activé pour votre compte. S'il s'agit seulement de la version d'essai, vous serez limité à quelques séances récentes quelle que soit la date saisie." },
    { type: "paragraph",html: "Le prix du module change de temps à autre ; consultez donc l'option actuelle affichée dans vos propres paramètres plutôt que de vous fier à un ancien chiffre. Si vous êtes sur un compte de prop firm ou d'évaluation, cela peut être contrôlé par la firme plutôt que par vous." },
    { type: "heading",text: "Étape 2 : Limitez la fenêtre à environ quatre mois (ou changez de contrat)" },
    { type: "paragraph",html: "Si vous voulez simplement répéter l'évolution récente des prix, restez dans environ les quatre derniers mois sur le contrat que vous consultez déjà. C'est la plage où votre mois de référence actuel dispose de données propres et continues, et le replay se comportera bien." },
    { type: "paragraph",html: "Besoin de remonter de plus d'un trimestre ? Ne luttez pas avec le contrat actuel. Chargez plutôt le contrat précis qui était réellement le mois de référence pendant la période qui vous intéresse. C'est la vraie astuce pour débloquer les données plus anciennes, et elle est détaillée dans les deux étapes suivantes." },
    { type: "heading",text: "Étape 3 : Désactivez Autoroll Contracts" },
    { type: "paragraph",html: "Avant de lancer une séance de replay plus ancienne, désactivez Autoroll Contracts. Une fois l'option désactivée, Tradovate cesse de ramener votre vue de force sur le mois de référence du jour et laisse le contrat historique que vous choisissez charger ses propres données. Ce seul changement règle l'essentiel du comportement de trous et de vide sur les dates de plus de quelques mois." },
    { type: "heading",text: "Étape 4 : Choisissez le bon contrat historique" },
    { type: "paragraph",html: "Les contrats à terme portent un code de mois qui indique le mois de livraison concerné. Faites correspondre le contrat à la période que vous voulez rejouer et les données apparaissent là où le mois de référence actuel n'en avait pas. Voici les codes trimestriels que vous utiliserez le plus pour les contrats à terme sur indices et actions :" },
    { type: "table", headers: ["Code du mois","Mois de livraison","Exemple (Nasdaq / NQ)"], rows: [
      ["H","Mars","NQH4 = mars 2024"],
      ["M","Juin","NQM4 = juin 2024"],
      ["U","Septembre","NQU3 = septembre 2023"],
      ["Z","Décembre","NQZ3 = décembre 2023"],
    ] },
    { type: "paragraph",html: "Ainsi, si vous voulez rejouer une séance de septembre 2023, vous chargeriez NQU3 plutôt que le symbole continu simple. Lorsque vous ne savez pas quel contrat dominait sur une période donnée, le site du CME Group répertorie les dates des contrats actifs. Chargez ce contrat précis, réglez votre date dans sa durée de négociation et lancez la séance." },
    { type: "heading",text: "Étape 5 : Resélectionnez la date si elle saute" },
    { type: "paragraph",html: "Si la date de début saute encore sur un autre jour, c'est Tradovate qui vous indique que le jour demandé n'est pas disponible : un week-end, un jour férié, une date antérieure au début de négociation de votre contrat ou une date au-delà de votre fenêtre de données. Saisissez de nouveau la date et relancez. N'oubliez pas que modifier la date ou l'heure en cours de séance ne prend pas effet de lui-même ; vous devez arrêter le replay et le relancer pour qu'une nouvelle date s'applique." },
    { type: "paragraph",html: "Si elle tient cette fois, c'est terminé. Si elle rebondit toujours sur le même jour ajusté quoi que vous saisissiez, vous avez atteint la limite de vos données disponibles, et c'est l'étape 1 qu'il faut examiner." },
    { type: "heading",text: "Si la date ne tient toujours pas" },
    { type: "paragraph",html: "Quelques situations sortent de la solution habituelle. Si vous êtes sur un compte d'évaluation ou financé d'une prop firm, l'historique de replay et les données de marché sont souvent provisionnés par la firme plutôt que quelque chose que vous pouvez activer vous-même. Les limites et les fenêtres disponibles varient selon la firme et la taille du compte ; vérifiez donc les règles actuelles de votre firme et contactez leur support si le module n'est même pas sélectionnable dans vos paramètres." },
    { type: "paragraph",html: "Et si vous avez confirmé que le module est actif, désactivé Autoroll, chargé le bon contrat historique, et qu'une date récente précise n'a réellement aucune donnée alors qu'elle le devrait clairement, cela mérite un message au support Tradovate. Donnez-leur le symbole exact, la date et le message que vous avez vu. C'est une vraie question de données, pas une confusion de paramètres, et ils peuvent la vérifier avec leur flux." },
  ], it: [
    { type: "paragraph",html: "Ha impostato Market Replay su una data di qualche mese fa, ha premuto avvio e il grafico è praticamente vuoto. Candele vuote, grandi buchi o la sessione la porta su un giorno completamente diverso da quello scelto. Fastidioso, soprattutto quando sta cercando di provare un setup che si è perso il trimestre scorso." },
    { type: "paragraph",html: "Ecco la parte rassicurante: questo non significa quasi mai che il suo account sia compromesso. Di solito dietro ci sono due cose ordinarie, e si risolvono entrambe in circa un minuto. Vediamo cosa succede davvero e come far caricare pulita quella sessione più vecchia." },
    { type: "quote",html: "<strong class='text-white'>La soluzione rapida</strong><br>Mantenga la sua finestra di replay a circa gli ultimi quattro mesi sul contratto che sta visualizzando.<br>Se la data di inizio salta a un altro giorno, la riselezioni semplicemente, Tradovate la sposta alla sessione valida più vicina.<br>Deve andare indietro oltre un trimestre? Disattivi <em>Autoroll Contracts</em> e carichi l'esatto contratto che era il mese front all'epoca." },
    { type: "heading",text: "Cosa sta davvero vedendo" },
    { type: "paragraph",html: "Il sintomo si presenta in due varianti ed è utile sapere quale ha davanti." },
    { type: "paragraph",html: "La prima sono dati scarsi o mancanti oltre un certo punto. Tutto viene riprodotto bene per le sessioni recenti, poi, intorno alla soglia dei quattro mesi, le candele diventano a macchie e alla fine si interrompono. Vada ancora più indietro e non c'è più nulla." },
    { type: "paragraph",html: "La seconda è la data che non regge. Sceglie, per esempio, il 3 marzo, preme avvio, e Tradovate carica silenziosamente un giorno diverso con una nota del tipo &ldquo;Start time was adjusted to fit restrictions.&rdquo; Non l'ha ignorata di proposito. Ha spostato il suo inizio alla sessione più vicina che gli è consentito riprodurre." },
    { type: "heading",text: "Perché Market Replay si esaurisce oltre i 4 mesi" },
    { type: "heading",text: "Sta rigiocando un simbolo del mese front" },
    { type: "paragraph",html: "Questo è il motivo principale e coglie quasi tutti. La maggior parte delle persone usa il replay su un simbolo continuo o del mese front attuale, quello attivo in questo momento. Il problema è che un contratto future trimestrale trascorre solo circa tre mesi come mese front attivo. I periodi di roll cadono a marzo, giugno, settembre e dicembre, quindi ogni singolo contratto ha una vita liquida piuttosto breve." },
    { type: "paragraph",html: "Se spinge il replay oltre quella finestra, esce dal bordo posteriore del contratto che sta guardando. Lì semplicemente non ci sono molti dati negoziati, perché quel contratto non era ancora quello attivo. È il muro dei «quattro mesi» contro cui le persone sbattono. Non è un limite rigido impostato da Tradovate. È solo da quanto tempo il suo contratto attuale è realmente il mese front." },
    { type: "heading",text: "Autoroll Contracts sta unendo il mese sbagliato" },
    { type: "paragraph",html: "Tradovate ha un'impostazione che sposta automaticamente il suo grafico al contratto successivo man mano che passano le scadenze. Ottima per i grafici dal vivo. Meno ottima nel replay, perché continua a cercare di ancorare tutto al mese front attuale anche quando ha viaggiato mesi nel passato. Il risultato sono buchi e sessioni caricate a metà dove i dati di quel periodo si trovano su un contratto completamente diverso." },
    { type: "paragraph",html: "La disattivi prima di rigiocare date più vecchie e smetterà di litigare con la piattaforma su quale contratto debba mostrare." },
    { type: "heading",text: "La sua finestra di dati dipende dal suo livello di accesso" },
    { type: "paragraph",html: "L'ultimo tassello è quanto storico spetta realmente al suo account. In prova, il replay copre solo una piccola manciata di sessioni recenti, pensi a una o due settimane, non mesi. Questo da solo spiega molte lamentele del tipo «non va più indietro»." },
    { type: "paragraph",html: "Il componente aggiuntivo a pagamento Market Replay è ciò che sblocca lo storico profondo, che risale fino al 1° gennaio 2017 per i prodotti che esistevano allora in Tradovate. Senza quel componente aggiuntivo attivo, la piattaforma limita la sua data di inizio a ciò che può servire, ed è esattamente per questo che il giorno scelto continua a scivolare in avanti." },
    { type: "heading",text: "La soluzione passo dopo passo" },
    { type: "heading",text: "Passaggio 1: Verifichi il suo accesso a Market Replay" },
    { type: "paragraph",html: "Apra Application Settings e vada alla scheda Add-Ons, poi trovi il pannello Market Replay. È qui che conferma se il replay con storico profondo è attivo per il suo account. Se è solo la versione di prova, sarà limitato a poche sessioni recenti qualunque data inserisca." },
    { type: "paragraph",html: "Il prezzo del componente aggiuntivo cambia di tanto in tanto, quindi controlli l'opzione attuale mostrata nelle sue impostazioni anziché fidarsi di un vecchio numero. Se ha un account prop firm o di valutazione, questo potrebbe essere controllato dalla firm anziché da lei." },
    { type: "heading",text: "Passaggio 2: Mantenga la finestra a circa quattro mesi (o cambi contratto)" },
    { type: "paragraph",html: "Se vuole solo provare l'azione dei prezzi recente, resti entro circa gli ultimi quattro mesi sul contratto che sta già visualizzando. È l'intervallo in cui il suo mese front attuale ha dati puliti e continui, e il replay si comporterà bene." },
    { type: "paragraph",html: "Deve andare indietro oltre un trimestre? Non combatta con il contratto attuale. Carichi invece lo specifico contratto che era realmente il mese front durante il periodo che le interessa. È il vero trucco per sbloccare i dati più vecchi, ed è descritto nei prossimi due passaggi." },
    { type: "heading",text: "Passaggio 3: Disattivi Autoroll Contracts" },
    { type: "paragraph",html: "Prima di avviare una sessione di replay più vecchia, disattivi Autoroll Contracts. Con l'opzione spenta, Tradovate smette di forzare la sua vista sul mese front di oggi e lascia che il contratto storico da lei scelto carichi i propri dati. Questa sola modifica risolve la maggior parte del comportamento con buchi e vuoti sulle date più vecchie di qualche mese." },
    { type: "heading",text: "Passaggio 4: Scelga il contratto storico giusto" },
    { type: "paragraph",html: "I contratti future hanno un codice del mese che indica per quale mese di consegna sono. Abbini il contratto al periodo che vuole rigiocare e i dati compaiono dove il mese front attuale non poteva fornirli. Ecco i codici trimestrali che userà più spesso per i future su indici e azionari:" },
    { type: "table", headers: ["Codice del mese","Mese di consegna","Esempio (Nasdaq / NQ)"], rows: [
      ["H","Marzo","NQH4 = marzo 2024"],
      ["M","Giugno","NQM4 = giugno 2024"],
      ["U","Settembre","NQU3 = settembre 2023"],
      ["Z","Dicembre","NQZ3 = dicembre 2023"],
    ] },
    { type: "paragraph",html: "Quindi, se vuole rigiocare una sessione di settembre 2023, caricherebbe NQU3 anziché il semplice simbolo continuo. Quando non è sicuro di quale contratto fosse in testa in un dato periodo, il sito di CME Group elenca le date dei contratti attivi. Carichi quello specifico contratto, imposti la data entro la sua vita di negoziazione e avvii la sessione." },
    { type: "heading",text: "Passaggio 5: Riselezioni la data se salta" },
    { type: "paragraph",html: "Se la data di inizio continua a saltare a un giorno diverso, è Tradovate che le dice che il giorno richiesto non è disponibile: un fine settimana, un giorno festivo, una data precedente all'inizio delle negoziazioni del suo contratto o una data oltre la sua finestra di dati. Reinserisca la data e riavvii. Ricordi che cambiare data od ora a sessione in corso non ha effetto da sola; deve fermare il replay e riavviarlo perché si applichi una nuova data." },
    { type: "paragraph",html: "Se questa volta regge, ha finito. Se continua a rimbalzare sullo stesso giorno adeguato qualunque cosa inserisca, ha raggiunto il limite dei suoi dati disponibili, e il Passaggio 1 è dove guardare." },
    { type: "heading",text: "Se la data continua a non reggere" },
    { type: "paragraph",html: "Un paio di situazioni escono dalla normale soluzione. Se ha un account di valutazione o finanziato di una prop firm, storico di replay e dati di mercato sono spesso forniti dalla firm e non qualcosa che può attivare da sola. Limiti e finestre disponibili variano in base alla firm e alla dimensione dell'account, quindi controlli le regole attuali della sua firm e contatti il loro supporto se il componente aggiuntivo non è nemmeno selezionabile nelle sue impostazioni." },
    { type: "paragraph",html: "E se ha confermato che il componente aggiuntivo è attivo, ha disattivato Autoroll, ha caricato il contratto storico corretto e una specifica data recente non ha davvero dati quando chiaramente dovrebbe averli, vale la pena segnalarlo al supporto Tradovate. Fornisca loro il simbolo esatto, la data e il messaggio che ha visto. È una vera questione di dati, non un equivoco di impostazioni, e possono verificarla con il loro feed." },
  ] },
  ctaHeading: { en: "Stop Rehearsing, Start Catching Signals Live", de: "Hören Sie auf zu proben, fangen Sie Signale live ein", es: "Deje de ensayar, empiece a captar señales en vivo", fr: "Arrêtez de répéter, captez les signaux en direct", it: "Smetta di fare prove, inizi a cogliere i segnali dal vivo" },
  ctaText: { en: "PickMyTrade fires your TradingView signals into Tradovate automatically, so you're not just replaying setups you missed, you're catching the next one live.", de: "PickMyTrade feuert Ihre TradingView-Signale automatisch in Tradovate, sodass Sie nicht nur verpasste Setups nachspielen, sondern das nächste live erwischen.", es: "PickMyTrade lanza sus señales de TradingView a Tradovate automáticamente, así que no solo repite setups que se perdió, sino que capta el siguiente en vivo.", fr: "PickMyTrade envoie automatiquement vos signaux TradingView vers Tradovate ; vous ne rejouez donc pas seulement des configurations manquées, vous captez la prochaine en direct.", it: "PickMyTrade invia automaticamente i suoi segnali di TradingView a Tradovate, quindi non si limita a rigiocare setup che si è perso, ma coglie il prossimo dal vivo." },
  ctaButtonText: { en: "Start Your Free 7-Day Trial", de: "Starten Sie Ihre kostenlose 7-Tage-Testphase", es: "Comience su prueba gratuita de 7 días", fr: "Commencez votre essai gratuit de 7 jours", it: "Inizi la prova gratuita di 7 giorni" },
  ctaUrl: "https://app.pickmytrade.trade/?register=true&utm_source=content&utm_medium=debugging",
  faqHeading: { en: "Frequently Asked Questions", de: "Häufig gestellte Fragen", es: "Preguntas frecuentes", fr: "Questions fréquentes", it: "Domande frequenti" },
  faqs: { en: [
    { q: "Why does Tradovate Market Replay stop showing data after about 4 months?", a: "Because you are almost always replaying a continuous or current front-month symbol. A quarterly futures contract is only the active front month for roughly a quarter, so once you scroll replay back past that window the current contract has no liquid data and the chart goes spotty. Turn off Autoroll Contracts and load the contract that was actually front month for that date, and the older data appears." },
    { q: "How far back does Tradovate Market Replay data actually go?", a: "With the paid Market Replay add-on, history reaches back to January 1, 2017 for products that existed in Tradovate at that time. On a trial or without the add-on you get only a handful of recent sessions, which is why your start date keeps getting clamped to the last week or two." },
    { q: "Why does my selected replay date jump to a different day?", a: "When the date you pick falls outside your available data window, lands on a non-trading day or holiday, or predates the contract you selected, Tradovate snaps the start to the nearest valid session and shows a message that the start time was adjusted to fit restrictions. Re-select the date after that. If it keeps jumping, the date is beyond your subscription's data or the contract was not trading yet." },
    { q: "Do I need to pay extra for older Market Replay history?", a: "Yes. Deep history is gated behind the paid Market Replay add-on. The trial only includes a few recent sessions. Pricing changes over time, so check Tradovate's current add-on options in Application Settings. Prop-firm and evaluation accounts may have replay controlled by the firm rather than by you, so confirm with your firm if the add-on is not selectable." },
    { q: "What does \"Start time was adjusted to fit restrictions\" mean?", a: "It means the start date and time you entered are outside the data Tradovate can serve you, so it moved the start to the closest session it can play. This usually points to a data-access limit, a weekend or holiday, or a contract that had not started trading on that date." },
  ], de: [
    { q: "Warum zeigt Tradovate Market Replay nach etwa 4 Monaten keine Daten mehr?", a: "Weil Sie fast immer ein kontinuierliches oder aktuelles Front-Month-Symbol abspielen. Ein quartalsweiser Futures-Kontrakt ist nur etwa ein Quartal lang der aktive Front Month. Sobald Sie im Replay über dieses Fenster hinaus zurückgehen, hat der aktuelle Kontrakt keine liquiden Daten mehr, und das Chart wird lückenhaft. Deaktivieren Sie Autoroll Contracts und laden Sie den Kontrakt, der für dieses Datum tatsächlich Front Month war, dann erscheinen die älteren Daten." },
    { q: "Wie weit zurück reichen die Tradovate-Market-Replay-Daten tatsächlich?", a: "Mit dem kostenpflichtigen Market-Replay-Add-on reicht die Historie bis zum 1. Januar 2017 zurück, für Produkte, die zu diesem Zeitpunkt bei Tradovate existierten. In einer Testphase oder ohne das Add-on erhalten Sie nur eine Handvoll aktueller Sitzungen, weshalb Ihr Startdatum immer wieder auf die letzte Woche oder die letzten zwei Wochen begrenzt wird." },
    { q: "Warum springt mein gewähltes Replay-Datum auf einen anderen Tag?", a: "Wenn das gewählte Datum außerhalb Ihres verfügbaren Datenfensters liegt, auf einen Nicht-Handelstag oder Feiertag fällt oder vor dem gewählten Kontrakt liegt, setzt Tradovate den Start auf die nächstgelegene gültige Sitzung und zeigt eine Meldung, dass die Startzeit an Beschränkungen angepasst wurde. Wählen Sie das Datum danach erneut aus. Springt es weiter, liegt das Datum außerhalb der Daten Ihres Abonnements oder der Kontrakt wurde noch nicht gehandelt." },
    { q: "Muss ich für ältere Market-Replay-Historie extra bezahlen?", a: "Ja. Die tiefe Historie ist hinter dem kostenpflichtigen Market-Replay-Add-on gesperrt. Die Testphase enthält nur wenige aktuelle Sitzungen. Preise ändern sich im Laufe der Zeit, prüfen Sie daher die aktuellen Add-on-Optionen von Tradovate in Application Settings. Bei Prop-Firm- und Evaluierungskonten kann das Replay von der Firma statt von Ihnen gesteuert werden. Klären Sie das mit Ihrer Firma, wenn das Add-on nicht auswählbar ist." },
    { q: "Was bedeutet „Start time was adjusted to fit restrictions“?", a: "Es bedeutet, dass das eingegebene Start-Datum samt Uhrzeit außerhalb der Daten liegt, die Tradovate Ihnen liefern kann, und der Start deshalb auf die nächstgelegene abspielbare Sitzung verschoben wurde. Das deutet meist auf eine Datenzugriffsgrenze, ein Wochenende oder einen Feiertag oder einen Kontrakt hin, der an diesem Datum noch nicht gehandelt wurde." },
  ], es: [
    { q: "¿Por qué Tradovate Market Replay deja de mostrar datos después de unos 4 meses?", a: "Porque casi siempre está reproduciendo un símbolo continuo o del mes frontal actual. Un contrato de futuros trimestral solo es el mes frontal activo durante aproximadamente un trimestre, así que cuando retrocede en el replay más allá de esa ventana, el contrato actual no tiene datos líquidos y el gráfico se vuelve irregular. Desactive Autoroll Contracts y cargue el contrato que realmente fue el mes frontal en esa fecha, y aparecerán los datos más antiguos." },
    { q: "¿Hasta cuándo llegan realmente los datos de Tradovate Market Replay?", a: "Con el complemento de pago de Market Replay, el historial llega hasta el 1 de enero de 2017 para los productos que existían en Tradovate en ese momento. En una prueba o sin el complemento solo obtiene un puñado de sesiones recientes, por eso su fecha de inicio se limita una y otra vez a la última semana o dos." },
    { q: "¿Por qué la fecha de replay que selecciono salta a otro día?", a: "Cuando la fecha elegida queda fuera de su ventana de datos disponible, cae en un día no operativo o festivo, o es anterior al contrato seleccionado, Tradovate ajusta el inicio a la sesión válida más cercana y muestra un mensaje indicando que la hora de inicio se ajustó a las restricciones. Vuelva a seleccionar la fecha después de eso. Si sigue saltando, la fecha está más allá de los datos de su suscripción o el contrato aún no cotizaba." },
    { q: "¿Tengo que pagar un extra por el historial más antiguo de Market Replay?", a: "Sí. El historial profundo está tras el complemento de pago de Market Replay. La prueba solo incluye unas pocas sesiones recientes. Los precios cambian con el tiempo, así que consulte las opciones de complemento actuales de Tradovate en Application Settings. En las cuentas de prop firm y de evaluación, el replay puede estar controlado por la firma y no por usted, así que confírmelo con su firma si el complemento no se puede seleccionar." },
    { q: "¿Qué significa «Start time was adjusted to fit restrictions»?", a: "Significa que la fecha y hora de inicio que introdujo están fuera de los datos que Tradovate puede servirle, por lo que movió el inicio a la sesión más cercana que puede reproducir. Normalmente apunta a un límite de acceso a datos, un fin de semana o festivo, o un contrato que aún no había empezado a cotizar en esa fecha." },
  ], fr: [
    { q: "Pourquoi Tradovate Market Replay n'affiche-t-il plus de données après environ 4 mois ?", a: "Parce que vous rejouez presque toujours un symbole continu ou du mois de référence actuel. Un contrat à terme trimestriel n'est le mois de référence actif que pendant environ un trimestre ; dès que vous remontez dans le replay au-delà de cette fenêtre, le contrat actuel n'a plus de données liquides et le graphique devient irrégulier. Désactivez Autoroll Contracts et chargez le contrat qui était réellement le mois de référence à cette date, et les données plus anciennes apparaissent." },
    { q: "Jusqu'où remontent réellement les données de Tradovate Market Replay ?", a: "Avec le module complémentaire payant Market Replay, l'historique remonte jusqu'au 1er janvier 2017 pour les produits qui existaient alors dans Tradovate. En essai ou sans le module, vous n'obtenez qu'une poignée de séances récentes, ce qui explique pourquoi votre date de début est sans cesse ramenée à la dernière semaine ou aux deux dernières semaines." },
    { q: "Pourquoi la date de replay que je sélectionne saute-t-elle sur un autre jour ?", a: "Lorsque la date choisie tombe en dehors de votre fenêtre de données disponible, sur un jour non négocié ou férié, ou avant le contrat sélectionné, Tradovate ramène le début à la séance valide la plus proche et affiche un message indiquant que l'heure de début a été ajustée aux restrictions. Resélectionnez la date ensuite. Si elle continue de sauter, la date dépasse les données de votre abonnement ou le contrat n'était pas encore négocié." },
    { q: "Dois-je payer un supplément pour l'historique Market Replay plus ancien ?", a: "Oui. L'historique profond est réservé au module complémentaire payant Market Replay. L'essai n'inclut que quelques séances récentes. Les tarifs évoluent avec le temps ; consultez donc les options de module actuelles de Tradovate dans Application Settings. Sur les comptes de prop firm et d'évaluation, le replay peut être contrôlé par la firme plutôt que par vous ; confirmez auprès de votre firme si le module n'est pas sélectionnable." },
    { q: "Que signifie « Start time was adjusted to fit restrictions » ?", a: "Cela signifie que la date et l'heure de début saisies sont en dehors des données que Tradovate peut vous servir, et qu'il a donc déplacé le début vers la séance la plus proche qu'il peut lire. Cela indique généralement une limite d'accès aux données, un week-end ou un jour férié, ou un contrat qui n'était pas encore négocié à cette date." },
  ], it: [
    { q: "Perché Tradovate Market Replay smette di mostrare dati dopo circa 4 mesi?", a: "Perché quasi sempre sta rigiocando un simbolo continuo o del mese front attuale. Un contratto future trimestrale è il mese front attivo solo per circa un trimestre, quindi quando nel replay va indietro oltre quella finestra, il contratto attuale non ha dati liquidi e il grafico diventa a macchia di leopardo. Disattivi Autoroll Contracts e carichi il contratto che era realmente il mese front a quella data, e i dati più vecchi compaiono." },
    { q: "Fin dove risalgono davvero i dati di Tradovate Market Replay?", a: "Con il componente aggiuntivo a pagamento Market Replay, lo storico risale fino al 1° gennaio 2017 per i prodotti che esistevano in Tradovate in quel momento. In prova o senza il componente aggiuntivo ottiene solo una manciata di sessioni recenti, ed è per questo che la sua data di inizio viene continuamente limitata all'ultima settimana o due." },
    { q: "Perché la data di replay che seleziono salta a un altro giorno?", a: "Quando la data scelta cade fuori dalla sua finestra di dati disponibile, in un giorno non di negoziazione o festivo, o è precedente al contratto selezionato, Tradovate sposta l'inizio alla sessione valida più vicina e mostra un messaggio che indica che l'orario di inizio è stato adeguato alle restrizioni. Riselezioni la data dopo. Se continua a saltare, la data è oltre i dati del suo abbonamento o il contratto non era ancora negoziato." },
    { q: "Devo pagare di più per lo storico più vecchio di Market Replay?", a: "Sì. Lo storico profondo è riservato al componente aggiuntivo a pagamento Market Replay. La prova include solo alcune sessioni recenti. I prezzi cambiano nel tempo, quindi controlli le opzioni attuali dei componenti aggiuntivi di Tradovate in Application Settings. Negli account prop firm e di valutazione il replay può essere controllato dalla firm anziché da lei, quindi confermi con la sua firm se il componente aggiuntivo non è selezionabile." },
    { q: "Cosa significa «Start time was adjusted to fit restrictions»?", a: "Significa che la data e l'ora di inizio inserite sono fuori dai dati che Tradovate può servirle, quindi ha spostato l'inizio alla sessione più vicina che può riprodurre. Di solito indica un limite di accesso ai dati, un fine settimana o un giorno festivo, o un contratto che non era ancora negoziato a quella data." },
  ] },
