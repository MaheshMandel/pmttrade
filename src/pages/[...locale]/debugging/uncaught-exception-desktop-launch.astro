---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "uncaught-exception-desktop-launch";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/debugging/${SLUG}`;

const META_TITLE = "Tradovate 'Uncaught Exception' on Desktop Launch";
const META_DESCRIPTION =
  "Desktop trading app crashing with an 'Uncaught Exception' at launch? Force-close it, sign back in fast, and keep the crash from costing you a fill.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Tradovate „Uncaught Exception“ beim Start der Desktop-App", es: "Error «Uncaught Exception» de Tradovate al iniciar la app de escritorio", fr: "Erreur « Uncaught Exception » de Tradovate au lancement de l'application de bureau", it: "Errore «Uncaught Exception» di Tradovate all'avvio dell'app desktop" },
  dek: { en: "The Tradovate desktop app throws a bare Uncaught Exception dialog instead of loading your charts and DOM. Here's the fastest way back in, and how to keep a crash from ever costing you a fill.", de: "Die Tradovate-Desktop-App zeigt nur ein nacktes Uncaught-Exception-Fenster, statt Ihre Charts und das DOM zu laden. Hier erfahren Sie den schnellsten Weg zurück und wie Sie verhindern, dass ein Absturz Sie einen Fill kostet.", es: "La app de escritorio de Tradovate muestra un simple cuadro de Uncaught Exception en lugar de cargar sus gráficos y el DOM. Esta es la forma más rápida de volver a entrar y cómo evitar que un fallo le cueste una ejecución.", fr: "L'application de bureau Tradovate affiche une simple boîte Uncaught Exception au lieu de charger vos graphiques et votre DOM. Voici le moyen le plus rapide d'y revenir et comment éviter qu'un plantage ne vous coûte une exécution.", it: "L'app desktop di Tradovate mostra una semplice finestra Uncaught Exception invece di caricare i suoi grafici e il DOM. Ecco il modo più rapido per rientrare e come evitare che un arresto anomalo le costi un'esecuzione." },
  readTime: { en: "8 min read", de: "8 Min. Lesezeit", es: "Lectura de 8 min", fr: "Lecture : 8 min", it: "Lettura di 8 min" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "You double-click the desktop app, expect your charts and DOM, and instead you get a bare little error box that just says <strong class='text-white'>Uncaught Exception</strong>. No charts, no login screen, no explanation. Sometimes it hits the moment you launch. Sometimes the app opens fine and throws it later, right when you delete a template or scroll back through old bars. Either way you're locked out at the exact moment you wanted to trade, and clicking the dialog over and over does nothing." },
    { type: "paragraph", html: "Here's the short version: <strong class='text-white'>the fastest way back in is to force the app fully closed and sign back in</strong>, Task Manager on Windows, Force Quit on a Mac. A straight reinstall, especially on macOS, often doesn't make the crash go away, because it lives in the app build and not in your copy. So the playbook is: recover fast, do one clean reinstall, try the Beta build if the stable one keeps dying, and keep a browser or phone open so a crash never costs you a fill." },
    { type: "quote", html: "<strong class='text-white'>Fast recovery:</strong> On Windows, open <strong class='text-white'>Task Manager</strong> (Ctrl + Shift + Esc), select the Tradovate process, and click <strong class='text-white'>End task</strong>. On a Mac, press <strong class='text-white'>Command + Option + Esc</strong>, pick Tradovate, and <strong class='text-white'>Force Quit</strong>. Then relaunch and log back in, your account, orders, and positions all live on Tradovate's servers, so the restart loses nothing." },
    { type: "heading", text: "What 'Uncaught Exception' Actually Means" },
    { type: "paragraph", html: "The Tradovate desktop app isn't a separate program from the web platform, it's the same web trader packaged inside a Chromium shell so it runs standalone on Windows and macOS, and that wrapper is where the message comes from. Some piece of the app's code hit an error and nothing was written to catch it, so instead of loading your workspace the app stops and shows a generic &ldquo;Uncaught Exception.&rdquo;" },
    { type: "paragraph", html: "Because it's a code-level failure rather than a bad chart or a dropped connection, it doesn't care what you were doing when it fired. It shows up on a cold launch and mid-session on specific actions. Two triggers stand out: <strong class='text-white'>deleting a saved template</strong>, which can crash the app and take some of your template data with it, and <strong class='text-white'>scrolling far back into historical chart bars</strong>, which can tip the app over when it reaches older data it struggles to render." },
    { type: "paragraph", html: "The telling detail is where the crash <em>doesn't</em> stop: it turns up on both Windows and macOS and survives a clean reinstall in plenty of cases. When the same failure follows you across operating systems and fresh installs, the culprit is the app build, not your hardware, which is why Tradovate has flagged it as a known issue, and why the durable answer here is &ldquo;recover cleanly and keep a fallback,&rdquo; not &ldquo;rebuild your machine.&rdquo;" },
    { type: "heading", text: "First Move: Force It Closed and Sign Back In" },
    { type: "paragraph", html: "When the exception box appears, you want the platform working again before you think about root cause. Clicking the dialog won't clear the crashed process, kill the app at the system level and start it fresh." },
    { type: "heading", text: "On Windows: End Task in Task Manager" },
    { type: "paragraph", html: "Press <strong class='text-white'>Ctrl + Shift + Esc</strong> to open Task Manager, find <strong class='text-white'>Tradovate</strong> in the Processes list (expand the group if there's more than one entry), select it, and click <strong class='text-white'>End task</strong>. That clears the wedged process the error box left behind. Relaunch the app from your Start menu and sign back in, it reloads to a working state within seconds. This is the reliable recovery; it just doesn't stop the crash from coming back later." },
    { type: "heading", text: "On a Mac: Force Quit" },
    { type: "paragraph", html: "Press <strong class='text-white'>Command + Option + Esc</strong> to open the Force Quit window, select <strong class='text-white'>Tradovate</strong>, and click <strong class='text-white'>Force Quit</strong>. If the app is fully unresponsive, hold-click its icon in the Dock and choose Force Quit there. Reopen it and log back in. Same idea as Windows, it gets you trading again, but on macOS especially, expect it to come back." },
    { type: "heading", text: "Rule Out Your Own Setup (One Clean Pass)" },
    { type: "paragraph", html: "Because this crash rides along on the app build, the steps below may not be the thing that finally fixes it. Run them anyway, on the chance your case really is a local corrupt-install one, and so you can tell support &ldquo;I've already done a clean reinstall and synced my clock, and it still throws the exception.&rdquo; That turns a vague complaint into a real bug report." },
    { type: "heading", text: "Sync Your System Clock" },
    { type: "paragraph", html: "A drifted clock breaks the secure connection the app depends on and can throw it into odd states, so this is the cheapest thing to clear first. On Windows, right-click the clock in the taskbar, choose <strong class='text-white'>Adjust date/time</strong>, turn on <strong class='text-white'>Set time automatically</strong>, and click <strong class='text-white'>Sync now</strong>. On a Mac, open <strong class='text-white'>System Settings &rarr; General &rarr; Date &amp; Time</strong> and switch on <strong class='text-white'>Set time and date automatically</strong>. Tradovate's own guidance is explicit about keeping the machine's clock synced to network time, so don't skip it." },
    { type: "heading", text: "Do One Full Clean Reinstall" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Windows:</strong> in File Explorer, type <code>%localappdata%</code> in the address bar and delete the Tradovate folder there, then do the same for <code>%appdata%</code>.",
        "<strong class='text-white'>Mac:</strong> remove the app's leftover support and cache folders under <code>~/Library</code> (Application Support and Caches) after dragging the app to the Trash.",
      ],
    },
    { type: "paragraph", html: "On rare occasions the install itself is corrupt, and a plain reinstall over the top won't clear it because the app's cached files stay behind. Do it properly once, uninstall the desktop app, remove the leftover folders above, then download a fresh installer from Tradovate's official downloads page (<strong class='text-white'>tradovate.com/devices</strong>) and install the latest build, so you're testing the current version, a fix may already be shipping, and you don't want to keep fighting a bug that's been patched." },
    { type: "heading", text: "Back Up Your Templates First" },
    { type: "paragraph", html: "Since deleting a template is one of the triggers, and a crash can wipe template data on the way down, protect your layouts first. Use the save/export icon to keep a copy of each template before you reinstall or delete anything, so a bad exit can't take your workspace with it." },
    { type: "quote", html: "If the exception keeps returning after a clock sync and one clean reinstall, stop reinstalling. You've done your diligence, that combination points the finger at the app build, and the next moves are the Beta version and a support report, not another rebuild." },
    { type: "heading", text: "Try the Beta Desktop Build" },
    { type: "paragraph", html: "On Windows a clean reinstall has a decent shot at sticking. On macOS a delete-and-reinstall frequently changes nothing, which is why Mac users get pushed toward a different lever: the <strong class='text-white'>Beta desktop build</strong>. When the stable app keeps throwing &ldquo;Uncaught Exception,&rdquo; switching to Tradovate's Beta version tends to cut the crashes down, for some setups it goes from constant to rare. It's not a magic fix and the exception can still surface now and then, but if the stable build dies every few minutes, the Beta is the better place to trade from while a permanent fix is in progress. Find the current Beta through Tradovate's official channels, and confirm the download link on their site, since where the Beta lives can change." },
    { type: "heading", text: "Keep Trading While It's Crashing" },
    { type: "paragraph", html: "You don't have to babysit the desktop app to stay in the market. The <strong class='text-white'>web platform at trader.tradovate.com</strong> runs the same account through your browser and doesn't depend on the desktop build that's failing. A desktop-specific crash doesn't hit the browser the same way, so the web trader is your most dependable fallback, pull it up in Chrome or Edge for full order entry, charts, and position management. The <strong class='text-white'>mobile app</strong> is a solid backup for one job in particular: flattening or adjusting a position in a hurry if the desktop window dies while you're live." },
    { type: "paragraph", html: "One caveat: Tradovate's login enforces a session limit, so if you're jumping between desktop, web, and TradingView, sign out of the sessions you're not using so you don't get bumped. Treat the phone as an emergency handle, not your main cockpit." },
    { type: "heading", text: "Report It So It Actually Gets Fixed" },
    { type: "paragraph", html: "A vague &ldquo;your app keeps crashing&rdquo; ticket goes nowhere; a specific, reproducible one gets escalated. When you contact support, hand them enough to recreate it:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Your OS and version</strong>, Windows 11 build (run <code>winver</code>) or the macOS version.",
        "<strong class='text-white'>Desktop app version</strong>, the build number from the app's About or settings screen.",
        "<strong class='text-white'>The exact error</strong>, a screenshot of the &ldquo;Uncaught Exception&rdquo; dialog, plus any console or log file the app offers to export.",
        "<strong class='text-white'>What you were doing</strong>, cold launch, deleting a template, or scrolling back through old bars. Those are known triggers, and naming yours helps them narrow it.",
        "<strong class='text-white'>Timestamps in Central Time</strong>, roughly when each crash hit, so they can line it up against server logs.",
        "<strong class='text-white'>What you've already ruled out</strong>, clock synced, clean reinstall done, still crashing. That single line moves your ticket from &ldquo;did you restart it&rdquo; to a real bug.",
      ],
    },
    { type: "heading", text: "Don't Let a Crash Cost You a Fill" },
    { type: "paragraph", html: "The version that hurts is the one that fires while you're in a trade, so build your setup around the fact that the window can drop out at any second. The good news: <strong class='text-white'>your resting orders don't live in that window.</strong> Any stop or target Tradovate has accepted sits on its servers and keeps working whether or not the desktop app is running, a stop placed at the exchange doesn't care that your screen threw an exception. If you trade a prop or evaluation account, the same principle cuts the other way: your firm's risk rules (trailing drawdown, daily loss limits) run server-side and keep counting even while your platform is down, and those thresholds vary by firm and account size, so check your firm's current rules. Either way the discipline is the same, put a hard stop on every position the moment you enter, and keep a second way in (web or mobile) so you can flatten from another device if the desktop app dies." },
    { type: "heading", text: "Troubleshooting at a Glance" },
    {
      type: "table",
      headers: ["Situation", "What it means", "What to do"],
      rows: [
        ["Exception box on launch", "App-build crash, not your data", "End task (Windows) / Force Quit (Mac), then reopen and sign in"],
        ["Crashes when you delete a template", "Known trigger, can wipe templates", "Export/back up templates first, then delete"],
        ["Crashes when scrolling old bars", "Known trigger on far-back history", "Restart the app; avoid deep scroll-backs mid-session"],
        ["Reinstall on Mac didn't help", "Fault is in the build, not your copy", "Try the Beta desktop build instead"],
        ["Still crashing after clean reinstall", "Confirms it's the app, not your PC", "Stop reinstalling; report it with details"],
        ["Need to trade right now", "Desktop build is unreliable", "Use trader.tradovate.com in a browser; mobile to flatten"],
        ["You're live when it crashes", "Client crash only, orders are safe", "Confirm positions on web/mobile; rely on your resting stop"],
      ],
    },
    { type: "heading", text: "Trade Through the Crashes with Server-Side Automation" },
    { type: "paragraph", html: "If an exception box has ever cost you an entry or a clean exit, the fix is to stop depending on any one window staying open. PickMyTrade routes your TradingView alerts straight to Tradovate and runs the execution on our servers, so your strategy keeps firing whether or not the desktop app is alive:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Server-side execution</strong>, alerts travel from TradingView to Tradovate through our infrastructure, so a crashed desktop app never blocks an entry or an exit.",
        "<strong class='text-white'>Device independence</strong>, nothing needs the desktop window open; your setup triggers off the alert, not whichever client happens to be running.",
        "<strong class='text-white'>Stops and targets that stick</strong>, SL/TP defined in your alert land on Tradovate no matter what your screen is doing.",
        "<strong class='text-white'>Multi-account sync</strong>, mirror the same orders across every connected account at once, so nothing sits unmanaged while you restart.",
      ],
    },
  ], de: [
    { type: "paragraph",html: "Sie doppelklicken auf die Desktop-App, erwarten Ihre Charts und das DOM und bekommen stattdessen ein nacktes kleines Fehlerfenster mit der Meldung <strong class='text-white'>Uncaught Exception</strong>. Keine Charts, kein Anmeldebildschirm, keine Erklärung. Manchmal tritt es direkt beim Start auf. Manchmal öffnet sich die App normal und löst den Fehler erst später aus, genau dann, wenn Sie eine Vorlage löschen oder durch alte Bars zurückscrollen. So oder so sind Sie genau in dem Moment ausgesperrt, in dem Sie handeln wollten, und wiederholtes Klicken auf das Fenster bewirkt nichts." },
    { type: "paragraph",html: "Die Kurzfassung: <strong class='text-white'>Der schnellste Weg zurück ist, die App vollständig zu beenden und sich neu anzumelden</strong>, mit dem Task-Manager unter Windows, „Sofort beenden“ auf dem Mac. Eine bloße Neuinstallation, besonders unter macOS, beseitigt den Absturz oft nicht, weil er im App-Build steckt und nicht in Ihrer Kopie. Der Ablauf lautet also: schnell wiederherstellen, einmal sauber neu installieren, den Beta-Build testen, wenn die stabile Version immer wieder abstürzt, und einen Browser oder das Smartphone offen halten, damit ein Absturz Sie nie einen Fill kostet." },
    { type: "quote",html: "<strong class='text-white'>Schnelle Wiederherstellung:</strong> Öffnen Sie unter Windows den <strong class='text-white'>Task Manager</strong> (Ctrl + Shift + Esc), wählen Sie den Tradovate-Prozess und klicken Sie auf <strong class='text-white'>End task</strong>. Drücken Sie auf dem Mac <strong class='text-white'>Command + Option + Esc</strong>, wählen Sie Tradovate und klicken Sie auf <strong class='text-white'>Force Quit</strong>. Starten Sie dann neu und melden Sie sich wieder an, Ihr Konto, Ihre Orders und Positionen liegen alle auf den Servern von Tradovate, sodass beim Neustart nichts verloren geht." },
    { type: "heading",text: "Was „Uncaught Exception“ tatsächlich bedeutet" },
    { type: "paragraph",html: "Die Tradovate-Desktop-App ist kein eigenständiges Programm neben der Webplattform, sondern derselbe Web-Trader, verpackt in einer Chromium-Hülle, damit er unter Windows und macOS eigenständig läuft. Von dieser Hülle stammt die Meldung. Ein Teil des App-Codes ist auf einen Fehler gestoßen, und nichts war da, um ihn abzufangen, sodass die App, statt Ihren Arbeitsbereich zu laden, anhält und eine generische &ldquo;Uncaught Exception&rdquo; anzeigt." },
    { type: "paragraph",html: "Da es ein Fehler auf Code-Ebene ist und kein fehlerhafter Chart oder eine unterbrochene Verbindung, ist es egal, was Sie gerade taten, als er auftrat. Er zeigt sich beim Kaltstart und mitten in der Sitzung bei bestimmten Aktionen. Zwei Auslöser stechen heraus: das <strong class='text-white'>Löschen einer gespeicherten Vorlage</strong>, wodurch die App abstürzen und einen Teil Ihrer Vorlagendaten mitnehmen kann, und das <strong class='text-white'>weite Zurückscrollen in historische Chart-Bars</strong>, wodurch die App umkippen kann, wenn sie ältere Daten erreicht, die sie nur schwer darstellen kann." },
    { type: "paragraph",html: "Aufschlussreich ist, wo der Absturz <em>nicht</em> aufhört: Er tritt unter Windows und macOS auf und übersteht in vielen Fällen eine saubere Neuinstallation. Wenn derselbe Fehler Sie über Betriebssysteme und frische Installationen hinweg begleitet, liegt die Ursache im App-Build und nicht in Ihrer Hardware. Deshalb hat Tradovate es als bekanntes Problem markiert, und deshalb lautet die dauerhafte Antwort hier &ldquo;sauber wiederherstellen und eine Ausweichmöglichkeit bereithalten&rdquo; und nicht &ldquo;Ihren Rechner neu aufsetzen&rdquo;." },
    { type: "heading",text: "Erster Schritt: Beenden erzwingen und neu anmelden" },
    { type: "paragraph",html: "Wenn das Exception-Fenster erscheint, sollten Sie die Plattform wieder zum Laufen bringen, bevor Sie über die Ursache nachdenken. Ein Klick auf das Fenster beendet den abgestürzten Prozess nicht. Beenden Sie die App auf Systemebene und starten Sie sie neu." },
    { type: "heading",text: "Unter Windows: Task beenden im Task-Manager" },
    { type: "paragraph",html: "Drücken Sie <strong class='text-white'>Ctrl + Shift + Esc</strong>, um den Task-Manager zu öffnen, suchen Sie <strong class='text-white'>Tradovate</strong> in der Prozessliste (erweitern Sie die Gruppe, falls es mehr als einen Eintrag gibt), wählen Sie ihn aus und klicken Sie auf <strong class='text-white'>End task</strong>. Das beendet den hängenden Prozess, den das Fehlerfenster hinterlassen hat. Starten Sie die App über das Startmenü neu und melden Sie sich wieder an, innerhalb von Sekunden ist sie wieder funktionsfähig. Das ist die zuverlässige Wiederherstellung, sie verhindert nur nicht, dass der Absturz später wiederkehrt." },
    { type: "heading",text: "Auf dem Mac: Sofort beenden" },
    { type: "paragraph",html: "Drücken Sie <strong class='text-white'>Command + Option + Esc</strong>, um das Fenster „Sofort beenden“ zu öffnen, wählen Sie <strong class='text-white'>Tradovate</strong> aus und klicken Sie auf <strong class='text-white'>Force Quit</strong>. Reagiert die App gar nicht mehr, klicken Sie im Dock lange auf ihr Symbol und wählen Sie dort „Sofort beenden“. Öffnen Sie sie erneut und melden Sie sich an. Es ist dasselbe Prinzip wie unter Windows, Sie können damit wieder handeln, aber gerade unter macOS ist mit einer Wiederkehr zu rechnen." },
    { type: "heading",text: "Eigenes Setup ausschließen (ein sauberer Durchgang)" },
    { type: "paragraph",html: "Da dieser Absturz im App-Build steckt, ist es möglich, dass die folgenden Schritte ihn nicht endgültig beheben. Führen Sie sie trotzdem durch, falls Ihr Fall doch eine lokal beschädigte Installation ist, und damit Sie dem Support sagen können: &ldquo;Ich habe bereits eine saubere Neuinstallation durchgeführt und meine Uhr synchronisiert, und es tritt trotzdem die Exception auf.&rdquo; Das macht aus einer vagen Beschwerde einen echten Fehlerbericht." },
    { type: "heading",text: "Systemuhr synchronisieren" },
    { type: "paragraph",html: "Eine abweichende Uhr stört die sichere Verbindung, auf die die App angewiesen ist, und kann sie in merkwürdige Zustände versetzen. Das ist daher das Günstigste, was Sie zuerst ausschließen sollten. Klicken Sie unter Windows mit der rechten Maustaste auf die Uhr in der Taskleiste, wählen Sie <strong class='text-white'>Adjust date/time</strong>, aktivieren Sie <strong class='text-white'>Set time automatically</strong> und klicken Sie auf <strong class='text-white'>Sync now</strong>. Öffnen Sie auf dem Mac <strong class='text-white'>System Settings &rarr; General &rarr; Date &amp; Time</strong> und aktivieren Sie <strong class='text-white'>Set time and date automatically</strong>. Die offizielle Empfehlung von Tradovate ist eindeutig: Halten Sie die Uhr des Rechners mit der Netzwerkzeit synchron, überspringen Sie das also nicht." },
    { type: "heading",text: "Einmal vollständig sauber neu installieren" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Windows:</strong> Geben Sie im Datei-Explorer <code>%localappdata%</code> in die Adressleiste ein und löschen Sie dort den Tradovate-Ordner, danach dasselbe für <code>%appdata%</code>.",
        "<strong class='text-white'>Mac:</strong> Entfernen Sie die übrig gebliebenen Support- und Cache-Ordner der App unter <code>~/Library</code> (Application Support und Caches), nachdem Sie die App in den Papierkorb gezogen haben.",
      ],
    },
    { type: "paragraph",html: "In seltenen Fällen ist die Installation selbst beschädigt, und eine einfache Neuinstallation darüber behebt das nicht, weil die zwischengespeicherten Dateien der App erhalten bleiben. Machen Sie es einmal richtig: Deinstallieren Sie die Desktop-App, entfernen Sie die oben genannten Restordner, laden Sie dann einen frischen Installer von der offiziellen Download-Seite von Tradovate (<strong class='text-white'>tradovate.com/devices</strong>) herunter und installieren Sie den neuesten Build. So testen Sie die aktuelle Version, ein Fix wird möglicherweise bereits ausgeliefert, und Sie wollen nicht weiter gegen einen Fehler kämpfen, der schon behoben ist." },
    { type: "heading",text: "Zuerst Vorlagen sichern" },
    { type: "paragraph",html: "Da das Löschen einer Vorlage einer der Auslöser ist und ein Absturz dabei Vorlagendaten löschen kann, schützen Sie zuerst Ihre Layouts. Verwenden Sie das Speichern-/Export-Symbol, um vor einer Neuinstallation oder dem Löschen von etwas eine Kopie jeder Vorlage zu sichern, damit ein misslungener Ausstieg Ihren Arbeitsbereich nicht mitnimmt." },
    { type: "quote",html: "Tritt die Exception nach einer Uhrensynchronisierung und einer sauberen Neuinstallation weiterhin auf, hören Sie auf, neu zu installieren. Sie haben Ihre Sorgfaltspflicht erfüllt, diese Kombination deutet auf den App-Build, und die nächsten Schritte sind die Beta-Version und ein Support-Bericht, nicht ein weiterer Neuaufbau." },
    { type: "heading",text: "Den Beta-Desktop-Build ausprobieren" },
    { type: "paragraph",html: "Unter Windows hat eine saubere Neuinstallation gute Chancen zu halten. Unter macOS ändert ein Löschen und Neuinstallieren häufig nichts, weshalb Mac-Nutzer auf einen anderen Hebel verwiesen werden: den <strong class='text-white'>Beta-Desktop-Build</strong>. Wenn die stabile App immer wieder &ldquo;Uncaught Exception&rdquo; auslöst, senkt der Wechsel zur Beta-Version von Tradovate die Abstürze tendenziell, bei manchen Setups von ständig auf selten. Es ist kein Wundermittel, und die Exception kann gelegentlich weiterhin auftreten, aber wenn die stabile Version alle paar Minuten abstürzt, ist die Beta der bessere Ort zum Handeln, bis eine dauerhafte Lösung in Arbeit ist. Die aktuelle Beta finden Sie über die offiziellen Kanäle von Tradovate. Bestätigen Sie den Download-Link auf deren Website, da sich der Ort der Beta ändern kann." },
    { type: "heading",text: "Weiter handeln, während die App abstürzt" },
    { type: "paragraph",html: "Sie müssen die Desktop-App nicht ständig beaufsichtigen, um im Markt zu bleiben. Die <strong class='text-white'>Webplattform unter trader.tradovate.com</strong> betreibt dasselbe Konto über Ihren Browser und hängt nicht vom fehlerhaften Desktop-Build ab. Ein desktopspezifischer Absturz trifft den Browser nicht auf dieselbe Weise, daher ist der Web-Trader Ihre verlässlichste Ausweichmöglichkeit. Rufen Sie ihn in Chrome oder Edge auf, um Orders einzugeben, Charts zu nutzen und Positionen zu verwalten. Die <strong class='text-white'>mobile App</strong> ist eine solide Reserve besonders für eine Aufgabe: eine Position schnell glattzustellen oder anzupassen, falls das Desktop-Fenster abstürzt, während Sie live sind." },
    { type: "paragraph",html: "Ein Hinweis: Die Anmeldung bei Tradovate erzwingt ein Sitzungslimit. Wenn Sie also zwischen Desktop, Web und TradingView wechseln, melden Sie sich in den Sitzungen ab, die Sie nicht nutzen, damit Sie nicht herausgeworfen werden. Betrachten Sie das Smartphone als Notgriff, nicht als Ihr Hauptcockpit." },
    { type: "heading",text: "Melden, damit es tatsächlich behoben wird" },
    { type: "paragraph",html: "Ein vages Ticket &ldquo;Ihre App stürzt ständig ab&rdquo; führt zu nichts, ein konkretes, reproduzierbares wird eskaliert. Wenn Sie den Support kontaktieren, geben Sie ihm genug, um das Problem nachzustellen:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Ihr Betriebssystem und dessen Version</strong>, Windows-11-Build (führen Sie <code>winver</code> aus) oder die macOS-Version.",
        "<strong class='text-white'>Version der Desktop-App</strong>, die Build-Nummer aus dem Info- oder Einstellungsbildschirm der App.",
        "<strong class='text-white'>Der genaue Fehler</strong>, ein Screenshot des Fensters &ldquo;Uncaught Exception&rdquo; sowie jede Konsolen- oder Protokolldatei, die die App zum Export anbietet.",
        "<strong class='text-white'>Was Sie gerade getan haben</strong>, Kaltstart, Löschen einer Vorlage oder Zurückscrollen durch alte Bars. Das sind bekannte Auslöser, und wenn Sie Ihren nennen, kann der Support das Problem eingrenzen.",
        "<strong class='text-white'>Zeitstempel in Central Time</strong>, ungefähr wann jeder Absturz auftrat, damit er mit den Server-Logs abgeglichen werden kann.",
        "<strong class='text-white'>Was Sie bereits ausgeschlossen haben</strong>, Uhr synchronisiert, saubere Neuinstallation durchgeführt, stürzt weiterhin ab. Diese eine Zeile macht aus &ldquo;Haben Sie neu gestartet&rdquo; einen echten Fehlerbericht.",
      ],
    },
    { type: "heading",text: "Lassen Sie sich keinen Fill durch einen Absturz kosten" },
    { type: "paragraph",html: "Am schmerzhaftesten ist der Absturz, der mitten im Trade eintritt, richten Sie Ihr Setup also darauf aus, dass das Fenster jederzeit wegbrechen kann. Die gute Nachricht: <strong class='text-white'>Ihre aktiven Orders liegen nicht in diesem Fenster.</strong> Jeder Stop oder jedes Target, das Tradovate akzeptiert hat, liegt auf den Servern und arbeitet weiter, ob die Desktop-App läuft oder nicht. Einem an der Börse platzierten Stop ist es egal, dass Ihr Bildschirm eine Exception ausgelöst hat. Wenn Sie ein Prop- oder Evaluationskonto handeln, gilt dasselbe Prinzip in die andere Richtung: Die Risikoregeln Ihrer Firma (Trailing Drawdown, tägliche Verlustlimits) laufen serverseitig und zählen weiter, auch wenn Ihre Plattform ausgefallen ist. Diese Schwellen variieren je nach Firma und Kontogröße, prüfen Sie also die aktuellen Regeln Ihrer Firma. In beiden Fällen gilt dieselbe Disziplin: Setzen Sie bei jeder Position sofort beim Einstieg einen harten Stop und halten Sie einen zweiten Zugang (Web oder Mobil) bereit, damit Sie von einem anderen Gerät aus glattstellen können, falls die Desktop-App ausfällt." },
    { type: "heading",text: "Fehlerbehebung auf einen Blick" },
    { type: "table", headers: ["Situation","Bedeutung","Was zu tun ist"], rows: [
      ["Exception-Fenster beim Start","Absturz im App-Build, nicht Ihre Daten","End task (Windows) / Force Quit (Mac), dann neu öffnen und anmelden"],
      ["Absturz beim Löschen einer Vorlage","Bekannter Auslöser, kann Vorlagen löschen","Vorlagen zuerst exportieren/sichern, dann löschen"],
      ["Absturz beim Scrollen durch alte Bars","Bekannter Auslöser bei weit zurückliegender Historie","App neu starten; tiefes Zurückscrollen mitten in der Sitzung vermeiden"],
      ["Neuinstallation am Mac hat nicht geholfen","Der Fehler liegt im Build, nicht in Ihrer Kopie","Stattdessen den Beta-Desktop-Build ausprobieren"],
      ["Stürzt nach sauberer Neuinstallation weiter ab","Bestätigt, dass es die App ist, nicht Ihr PC","Nicht mehr neu installieren; mit Details melden"],
      ["Sie müssen sofort handeln","Der Desktop-Build ist unzuverlässig","trader.tradovate.com im Browser nutzen; mobil zum Glattstellen"],
      ["Sie sind live, wenn es abstürzt","Nur Client-Absturz, Orders sind sicher","Positionen im Web/Mobil bestätigen; sich auf den aktiven Stop verlassen"],
    ] },
    { type: "heading",text: "Auch bei Abstürzen handeln mit serverseitiger Automatisierung" },
    { type: "paragraph",html: "Wenn Ihnen ein Exception-Fenster schon einmal einen Einstieg oder einen sauberen Ausstieg gekostet hat, besteht die Lösung darin, sich nicht mehr darauf zu verlassen, dass ein einzelnes Fenster geöffnet bleibt. PickMyTrade leitet Ihre TradingView-Alerts direkt an Tradovate weiter und führt die Ausführung auf unseren Servern aus, sodass Ihre Strategie weiter feuert, ob die Desktop-App läuft oder nicht:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Serverseitige Ausführung</strong>, Alerts laufen über unsere Infrastruktur von TradingView zu Tradovate, sodass eine abgestürzte Desktop-App nie einen Einstieg oder Ausstieg blockiert.",
        "<strong class='text-white'>Geräteunabhängigkeit</strong>, nichts erfordert ein geöffnetes Desktop-Fenster; Ihr Setup wird vom Alert ausgelöst, nicht von dem Client, der gerade läuft.",
        "<strong class='text-white'>Stops und Targets, die halten</strong>, SL/TP aus Ihrem Alert landen bei Tradovate, egal was Ihr Bildschirm gerade tut.",
        "<strong class='text-white'>Multi-Konto-Synchronisierung</strong>, spiegeln Sie dieselben Orders gleichzeitig auf alle verbundenen Konten, damit nichts unverwaltet bleibt, während Sie neu starten.",
      ],
    },
  ], es: [
    { type: "paragraph",html: "Hace doble clic en la app de escritorio, espera ver sus gráficos y el DOM y, en su lugar, aparece un simple cuadro de error que solo dice <strong class='text-white'>Uncaught Exception</strong>. Sin gráficos, sin pantalla de inicio de sesión, sin explicación. A veces ocurre nada más iniciar. Otras veces la app abre bien y lo lanza más tarde, justo cuando elimina una plantilla o retrocede por barras antiguas. En cualquier caso, queda bloqueado en el momento exacto en que quería operar, y hacer clic una y otra vez en el cuadro no sirve de nada." },
    { type: "paragraph",html: "La versión corta: <strong class='text-white'>la forma más rápida de volver a entrar es forzar el cierre completo de la app e iniciar sesión de nuevo</strong>, con el Administrador de tareas en Windows y Forzar salida en Mac. Una reinstalación directa, especialmente en macOS, a menudo no elimina el fallo, porque está en la compilación de la app y no en su copia. Así que el plan es: recuperarse rápido, hacer una reinstalación limpia, probar la compilación Beta si la estable sigue cayéndose y mantener un navegador o el teléfono abierto para que un fallo nunca le cueste una ejecución." },
    { type: "quote",html: "<strong class='text-white'>Recuperación rápida:</strong> En Windows, abra el <strong class='text-white'>Task Manager</strong> (Ctrl + Shift + Esc), seleccione el proceso de Tradovate y haga clic en <strong class='text-white'>End task</strong>. En Mac, pulse <strong class='text-white'>Command + Option + Esc</strong>, elija Tradovate y pulse <strong class='text-white'>Force Quit</strong>. Luego vuelva a abrir e inicie sesión; su cuenta, órdenes y posiciones residen en los servidores de Tradovate, así que el reinicio no pierde nada." },
    { type: "heading",text: "Qué significa realmente «Uncaught Exception»" },
    { type: "paragraph",html: "La app de escritorio de Tradovate no es un programa distinto de la plataforma web: es el mismo web trader empaquetado en una carcasa de Chromium para que se ejecute de forma independiente en Windows y macOS, y de esa carcasa proviene el mensaje. Alguna parte del código de la app encontró un error y no había nada escrito para capturarlo, así que, en lugar de cargar su espacio de trabajo, la app se detiene y muestra una &ldquo;Uncaught Exception&rdquo; genérica." },
    { type: "paragraph",html: "Como es un fallo a nivel de código y no un gráfico defectuoso ni una conexión caída, no le importa lo que estuviera haciendo cuando se disparó. Aparece en un arranque en frío y a mitad de sesión con acciones concretas. Destacan dos desencadenantes: <strong class='text-white'>eliminar una plantilla guardada</strong>, que puede hacer fallar la app y llevarse parte de los datos de sus plantillas, y <strong class='text-white'>retroceder mucho por las barras históricas del gráfico</strong>, que puede hacerla caer al llegar a datos antiguos que le cuesta renderizar." },
    { type: "paragraph",html: "El detalle revelador es dónde <em>no</em> se detiene el fallo: aparece tanto en Windows como en macOS y en muchos casos sobrevive a una reinstalación limpia. Cuando el mismo fallo le sigue a través de sistemas operativos e instalaciones nuevas, el culpable es la compilación de la app y no su hardware, razón por la que Tradovate lo ha señalado como problema conocido y por la que la respuesta duradera aquí es &ldquo;recupérese de forma limpia y mantenga una alternativa&rdquo;, no &ldquo;reconstruya su equipo&rdquo;." },
    { type: "heading",text: "Primer paso: fuerce el cierre e inicie sesión de nuevo" },
    { type: "paragraph",html: "Cuando aparezca el cuadro de excepción, quiere que la plataforma vuelva a funcionar antes de pensar en la causa raíz. Hacer clic en el cuadro no elimina el proceso bloqueado: mate la app a nivel de sistema y empiece de nuevo." },
    { type: "heading",text: "En Windows: Finalizar tarea en el Administrador de tareas" },
    { type: "paragraph",html: "Pulse <strong class='text-white'>Ctrl + Shift + Esc</strong> para abrir el Administrador de tareas, busque <strong class='text-white'>Tradovate</strong> en la lista de procesos (expanda el grupo si hay más de una entrada), selecciónelo y haga clic en <strong class='text-white'>End task</strong>. Eso elimina el proceso atascado que dejó el cuadro de error. Vuelva a abrir la app desde el menú Inicio e inicie sesión; vuelve a un estado funcional en segundos. Esta es la recuperación fiable; solo que no impide que el fallo regrese más tarde." },
    { type: "heading",text: "En Mac: Forzar salida" },
    { type: "paragraph",html: "Pulse <strong class='text-white'>Command + Option + Esc</strong> para abrir la ventana Forzar salida, seleccione <strong class='text-white'>Tradovate</strong> y haga clic en <strong class='text-white'>Force Quit</strong>. Si la app no responde en absoluto, mantenga pulsado su icono en el Dock y elija allí Forzar salida. Vuelva a abrirla e inicie sesión. La misma idea que en Windows: le permite volver a operar, pero en macOS especialmente, espere que reaparezca." },
    { type: "heading",text: "Descarte su propia configuración (una pasada limpia)" },
    { type: "paragraph",html: "Como este fallo viaja con la compilación de la app, los pasos siguientes quizá no sean lo que por fin lo solucione. Hágalos de todos modos, por si su caso es realmente una instalación local corrupta, y para poder decirle al soporte &ldquo;Ya hice una reinstalación limpia y sincronicé mi reloj, y sigue lanzando la excepción&rdquo;. Eso convierte una queja vaga en un informe de error real." },
    { type: "heading",text: "Sincronice el reloj del sistema" },
    { type: "paragraph",html: "Un reloj desfasado rompe la conexión segura de la que depende la app y puede llevarla a estados extraños, así que es lo más barato que debe descartar primero. En Windows, haga clic con el botón derecho en el reloj de la barra de tareas, elija <strong class='text-white'>Adjust date/time</strong>, active <strong class='text-white'>Set time automatically</strong> y haga clic en <strong class='text-white'>Sync now</strong>. En Mac, abra <strong class='text-white'>System Settings &rarr; General &rarr; Date &amp; Time</strong> y active <strong class='text-white'>Set time and date automatically</strong>. La propia guía de Tradovate es explícita sobre mantener el reloj del equipo sincronizado con la hora de red, así que no lo omita." },
    { type: "heading",text: "Haga una reinstalación limpia completa" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Windows:</strong> en el Explorador de archivos, escriba <code>%localappdata%</code> en la barra de direcciones y elimine allí la carpeta de Tradovate; luego haga lo mismo con <code>%appdata%</code>.",
        "<strong class='text-white'>Mac:</strong> elimine las carpetas residuales de soporte y caché de la app en <code>~/Library</code> (Application Support y Caches) después de arrastrar la app a la Papelera.",
      ],
    },
    { type: "paragraph",html: "En raras ocasiones la propia instalación está corrupta y una reinstalación simple encima no lo soluciona, porque los archivos en caché de la app permanecen. Hágalo bien una vez: desinstale la app de escritorio, elimine las carpetas residuales indicadas arriba, descargue un instalador nuevo de la página oficial de descargas de Tradovate (<strong class='text-white'>tradovate.com/devices</strong>) e instale la última compilación, para probar la versión actual; puede que ya se esté distribuyendo una corrección y no le conviene seguir peleando con un error que ya está parcheado." },
    { type: "heading",text: "Haga primero una copia de seguridad de sus plantillas" },
    { type: "paragraph",html: "Como eliminar una plantilla es uno de los desencadenantes y un fallo puede borrar datos de plantillas al caer, proteja primero sus diseños. Use el icono de guardar/exportar para conservar una copia de cada plantilla antes de reinstalar o eliminar nada, de modo que una salida abrupta no se lleve su espacio de trabajo." },
    { type: "quote",html: "Si la excepción sigue volviendo tras sincronizar el reloj y una reinstalación limpia, deje de reinstalar. Ya ha hecho su parte; esa combinación apunta a la compilación de la app, y los siguientes pasos son la versión Beta y un informe al soporte, no otra reconstrucción." },
    { type: "heading",text: "Pruebe la compilación Beta de escritorio" },
    { type: "paragraph",html: "En Windows, una reinstalación limpia tiene buenas posibilidades de resolverlo. En macOS, eliminar y reinstalar con frecuencia no cambia nada, por lo que a los usuarios de Mac se les orienta hacia otra palanca: la <strong class='text-white'>compilación Beta de escritorio</strong>. Cuando la app estable sigue lanzando &ldquo;Uncaught Exception&rdquo;, cambiar a la versión Beta de Tradovate tiende a reducir los fallos; en algunas configuraciones pasan de constantes a raros. No es una solución mágica y la excepción aún puede aparecer de vez en cuando, pero si la versión estable se cae cada pocos minutos, la Beta es el mejor lugar desde el que operar mientras se trabaja en una solución permanente. Encuentre la Beta actual a través de los canales oficiales de Tradovate y confirme el enlace de descarga en su sitio, ya que su ubicación puede cambiar." },
    { type: "heading",text: "Siga operando mientras falla" },
    { type: "paragraph",html: "No tiene que vigilar la app de escritorio para seguir en el mercado. La <strong class='text-white'>plataforma web en trader.tradovate.com</strong> ejecuta la misma cuenta a través de su navegador y no depende de la compilación de escritorio que está fallando. Un fallo específico del escritorio no afecta al navegador de la misma manera, así que el web trader es su alternativa más fiable: ábralo en Chrome o Edge para tener introducción completa de órdenes, gráficos y gestión de posiciones. La <strong class='text-white'>app móvil</strong> es un respaldo sólido para una tarea en particular: cerrar o ajustar una posición con rapidez si la ventana de escritorio se cae mientras está en vivo." },
    { type: "paragraph",html: "Una salvedad: el inicio de sesión de Tradovate impone un límite de sesiones, así que si salta entre escritorio, web y TradingView, cierre sesión en las que no use para que no le expulsen. Trate el teléfono como un recurso de emergencia, no como su cabina principal." },
    { type: "heading",text: "Repórtelo para que realmente se solucione" },
    { type: "paragraph",html: "Un ticket vago de &ldquo;su app falla constantemente&rdquo; no llega a ninguna parte; uno concreto y reproducible se escala. Cuando contacte con el soporte, deles lo suficiente para recrearlo:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Su sistema operativo y versión</strong>, compilación de Windows 11 (ejecute <code>winver</code>) o la versión de macOS.",
        "<strong class='text-white'>Versión de la app de escritorio</strong>, el número de compilación de la pantalla Acerca de o de ajustes de la app.",
        "<strong class='text-white'>El error exacto</strong>, una captura de pantalla del cuadro &ldquo;Uncaught Exception&rdquo;, además de cualquier archivo de consola o registro que la app ofrezca exportar.",
        "<strong class='text-white'>Qué estaba haciendo</strong>, arranque en frío, eliminar una plantilla o retroceder por barras antiguas. Son desencadenantes conocidos, y indicar el suyo les ayuda a acotarlo.",
        "<strong class='text-white'>Marcas de tiempo en hora Central</strong>, aproximadamente cuándo ocurrió cada fallo, para que puedan cotejarlo con los registros del servidor.",
        "<strong class='text-white'>Qué ya ha descartado</strong>, reloj sincronizado, reinstalación limpia hecha, sigue fallando. Esa sola línea convierte su ticket de &ldquo;¿lo reinició?&rdquo; en un error real.",
      ],
    },
    { type: "heading",text: "No deje que un fallo le cueste una ejecución" },
    { type: "paragraph",html: "La versión que duele es la que se dispara mientras está dentro de una operación, así que construya su configuración sabiendo que la ventana puede caerse en cualquier segundo. La buena noticia: <strong class='text-white'>sus órdenes pendientes no viven en esa ventana.</strong> Cualquier stop u objetivo que Tradovate haya aceptado está en sus servidores y sigue funcionando se esté ejecutando o no la app de escritorio; a un stop colocado en el mercado no le importa que su pantalla haya lanzado una excepción. Si opera una cuenta de prop firm o de evaluación, el mismo principio funciona en sentido contrario: las reglas de riesgo de su firma (drawdown móvil, límites de pérdida diaria) se ejecutan en el servidor y siguen contando aunque su plataforma esté caída, y esos umbrales varían según la firma y el tamaño de la cuenta, así que consulte las reglas actuales de su firma. En cualquier caso la disciplina es la misma: ponga un stop firme en cada posición en el momento de entrar y mantenga una segunda vía de acceso (web o móvil) para poder cerrar desde otro dispositivo si la app de escritorio se cae." },
    { type: "heading",text: "Solución de problemas de un vistazo" },
    { type: "table", headers: ["Situación","Qué significa","Qué hacer"], rows: [
      ["Cuadro de excepción al iniciar","Fallo de la compilación de la app, no de sus datos","End task (Windows) / Force Quit (Mac), luego vuelva a abrir e inicie sesión"],
      ["Falla al eliminar una plantilla","Desencadenante conocido, puede borrar plantillas","Exporte/haga copia de seguridad de las plantillas primero y luego elimine"],
      ["Falla al retroceder por barras antiguas","Desencadenante conocido con historial muy antiguo","Reinicie la app; evite retroceder mucho a mitad de sesión"],
      ["La reinstalación en Mac no ayudó","El defecto está en la compilación, no en su copia","Pruebe en su lugar la compilación Beta de escritorio"],
      ["Sigue fallando tras una reinstalación limpia","Confirma que es la app, no su PC","Deje de reinstalar; repórtelo con detalles"],
      ["Necesita operar ahora mismo","La compilación de escritorio no es fiable","Use trader.tradovate.com en un navegador; el móvil para cerrar posiciones"],
      ["Está en vivo cuando falla","Solo falla el cliente, las órdenes están a salvo","Confirme posiciones en web/móvil; confíe en su stop pendiente"],
    ] },
    { type: "heading",text: "Opere a pesar de los fallos con automatización en el servidor" },
    { type: "paragraph",html: "Si un cuadro de excepción alguna vez le ha costado una entrada o una salida limpia, la solución es dejar de depender de que una sola ventana permanezca abierta. PickMyTrade enruta sus alertas de TradingView directamente a Tradovate y ejecuta la operativa en nuestros servidores, de modo que su estrategia sigue disparándose esté o no activa la app de escritorio:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Ejecución en el servidor</strong>, las alertas viajan de TradingView a Tradovate a través de nuestra infraestructura, así que una app de escritorio caída nunca bloquea una entrada o una salida.",
        "<strong class='text-white'>Independencia del dispositivo</strong>, nada necesita la ventana de escritorio abierta; su configuración se activa con la alerta, no con el cliente que esté en ejecución.",
        "<strong class='text-white'>Stops y objetivos que se mantienen</strong>, el SL/TP definido en su alerta llega a Tradovate pase lo que pase en su pantalla.",
        "<strong class='text-white'>Sincronización multicuenta</strong>, replique las mismas órdenes en todas las cuentas conectadas a la vez, para que nada quede sin gestionar mientras reinicia.",
      ],
    },
  ], fr: [
    { type: "paragraph",html: "Vous double-cliquez sur l'application de bureau, vous attendez vos graphiques et votre DOM, et vous obtenez à la place une petite boîte d'erreur toute nue qui indique simplement <strong class='text-white'>Uncaught Exception</strong>. Pas de graphiques, pas d'écran de connexion, aucune explication. Parfois cela survient dès le lancement. Parfois l'application s'ouvre normalement et lève l'erreur plus tard, juste au moment où vous supprimez un modèle ou remontez dans d'anciennes barres. Dans tous les cas, vous êtes bloqué au moment précis où vous vouliez trader, et cliquer encore et encore sur la boîte ne sert à rien." },
    { type: "paragraph",html: "En bref : <strong class='text-white'>le moyen le plus rapide d'y revenir est de forcer la fermeture complète de l'application et de vous reconnecter</strong>, avec le Gestionnaire des tâches sous Windows, Forcer à quitter sur Mac. Une réinstallation directe, surtout sous macOS, ne fait souvent pas disparaître le plantage, car il réside dans la version de l'application et non dans votre copie. Le plan est donc : récupérer vite, faire une réinstallation propre, essayer la version Beta si la stable continue de mourir, et garder un navigateur ou un téléphone ouvert pour qu'un plantage ne vous coûte jamais une exécution." },
    { type: "quote",html: "<strong class='text-white'>Récupération rapide :</strong> Sous Windows, ouvrez le <strong class='text-white'>Task Manager</strong> (Ctrl + Shift + Esc), sélectionnez le processus Tradovate et cliquez sur <strong class='text-white'>End task</strong>. Sur Mac, appuyez sur <strong class='text-white'>Command + Option + Esc</strong>, choisissez Tradovate et cliquez sur <strong class='text-white'>Force Quit</strong>. Relancez ensuite et reconnectez-vous : votre compte, vos ordres et vos positions résident tous sur les serveurs de Tradovate, donc le redémarrage ne fait rien perdre." },
    { type: "heading",text: "Ce que signifie réellement « Uncaught Exception »" },
    { type: "paragraph",html: "L'application de bureau Tradovate n'est pas un programme distinct de la plateforme web : c'est le même web trader empaqueté dans une coque Chromium pour s'exécuter de façon autonome sous Windows et macOS, et c'est de cette enveloppe que vient le message. Une partie du code de l'application a rencontré une erreur et rien n'était prévu pour l'intercepter, si bien qu'au lieu de charger votre espace de travail l'application s'arrête et affiche une &ldquo;Uncaught Exception&rdquo; générique." },
    { type: "paragraph",html: "Comme il s'agit d'une défaillance au niveau du code et non d'un mauvais graphique ou d'une connexion coupée, elle se moque de ce que vous faisiez au moment où elle survient. Elle apparaît lors d'un démarrage à froid et en pleine session sur certaines actions précises. Deux déclencheurs ressortent : la <strong class='text-white'>suppression d'un modèle enregistré</strong>, qui peut faire planter l'application et emporter une partie de vos données de modèles, et le <strong class='text-white'>défilement très loin dans les barres historiques du graphique</strong>, qui peut la faire basculer lorsqu'elle atteint des données plus anciennes qu'elle peine à afficher." },
    { type: "paragraph",html: "Le détail révélateur, c'est l'endroit où le plantage <em>ne s'arrête pas</em> : il apparaît sous Windows comme sous macOS et survit, dans bien des cas, à une réinstallation propre. Lorsque la même défaillance vous suit d'un système d'exploitation à l'autre et d'une installation neuve à l'autre, le coupable est la version de l'application et non votre matériel, ce qui explique pourquoi Tradovate l'a signalé comme problème connu, et pourquoi la réponse durable est ici &ldquo;récupérez proprement et gardez une solution de repli&rdquo;, et non &ldquo;reconstruisez votre machine&rdquo;." },
    { type: "heading",text: "Premier réflexe : forcer la fermeture et vous reconnecter" },
    { type: "paragraph",html: "Lorsque la boîte d'exception apparaît, vous voulez que la plateforme refonctionne avant de réfléchir à la cause. Cliquer sur la boîte n'élimine pas le processus planté : tuez l'application au niveau du système et repartez de zéro." },
    { type: "heading",text: "Sous Windows : Fin de tâche dans le Gestionnaire des tâches" },
    { type: "paragraph",html: "Appuyez sur <strong class='text-white'>Ctrl + Shift + Esc</strong> pour ouvrir le Gestionnaire des tâches, trouvez <strong class='text-white'>Tradovate</strong> dans la liste des processus (développez le groupe s'il y a plusieurs entrées), sélectionnez-le et cliquez sur <strong class='text-white'>End task</strong>. Cela supprime le processus bloqué laissé par la boîte d'erreur. Relancez l'application depuis le menu Démarrer et reconnectez-vous : elle revient à un état fonctionnel en quelques secondes. C'est la récupération fiable ; elle n'empêche simplement pas le plantage de revenir plus tard." },
    { type: "heading",text: "Sur Mac : Forcer à quitter" },
    { type: "paragraph",html: "Appuyez sur <strong class='text-white'>Command + Option + Esc</strong> pour ouvrir la fenêtre Forcer à quitter, sélectionnez <strong class='text-white'>Tradovate</strong> et cliquez sur <strong class='text-white'>Force Quit</strong>. Si l'application ne répond plus du tout, faites un clic prolongé sur son icône dans le Dock et choisissez Forcer à quitter à cet endroit. Rouvrez-la et reconnectez-vous. Même principe que sous Windows : cela vous permet de retrader, mais sous macOS en particulier, attendez-vous à ce que cela revienne." },
    { type: "heading",text: "Écartez votre propre configuration (un passage propre)" },
    { type: "paragraph",html: "Comme ce plantage voyage avec la version de l'application, les étapes ci-dessous ne seront peut-être pas ce qui le corrige enfin. Faites-les quand même, au cas où votre situation serait réellement une installation locale corrompue, et pour pouvoir dire au support &ldquo;J'ai déjà fait une réinstallation propre et synchronisé mon horloge, et l'exception se produit toujours&rdquo;. Cela transforme une plainte vague en un véritable rapport de bug." },
    { type: "heading",text: "Synchronisez l'horloge système" },
    { type: "paragraph",html: "Une horloge qui dérive casse la connexion sécurisée dont l'application dépend et peut la faire basculer dans des états étranges ; c'est donc la chose la moins coûteuse à écarter en premier. Sous Windows, faites un clic droit sur l'horloge de la barre des tâches, choisissez <strong class='text-white'>Adjust date/time</strong>, activez <strong class='text-white'>Set time automatically</strong> et cliquez sur <strong class='text-white'>Sync now</strong>. Sur Mac, ouvrez <strong class='text-white'>System Settings &rarr; General &rarr; Date &amp; Time</strong> et activez <strong class='text-white'>Set time and date automatically</strong>. Les consignes de Tradovate sont explicites quant à la synchronisation de l'horloge de la machine sur l'heure réseau, ne l'ignorez donc pas." },
    { type: "heading",text: "Faites une réinstallation complète et propre" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Windows :</strong> dans l'Explorateur de fichiers, saisissez <code>%localappdata%</code> dans la barre d'adresse et supprimez-y le dossier Tradovate, puis faites de même pour <code>%appdata%</code>.",
        "<strong class='text-white'>Mac :</strong> supprimez les dossiers de support et de cache résiduels de l'application sous <code>~/Library</code> (Application Support et Caches) après avoir glissé l'application dans la Corbeille.",
      ],
    },
    { type: "paragraph",html: "Dans de rares cas, l'installation elle-même est corrompue, et une simple réinstallation par-dessus ne la corrige pas car les fichiers en cache de l'application subsistent. Faites-le correctement une fois : désinstallez l'application de bureau, supprimez les dossiers résiduels ci-dessus, puis téléchargez un installateur neuf depuis la page de téléchargements officielle de Tradovate (<strong class='text-white'>tradovate.com/devices</strong>) et installez la dernière version, afin de tester la version actuelle ; un correctif est peut-être déjà en cours de déploiement et vous ne voulez pas continuer à lutter contre un bug déjà corrigé." },
    { type: "heading",text: "Sauvegardez d'abord vos modèles" },
    { type: "paragraph",html: "Comme la suppression d'un modèle est l'un des déclencheurs et qu'un plantage peut effacer les données de modèles en tombant, protégez d'abord vos dispositions. Utilisez l'icône d'enregistrement/export pour conserver une copie de chaque modèle avant de réinstaller ou de supprimer quoi que ce soit, afin qu'une mauvaise sortie n'emporte pas votre espace de travail." },
    { type: "quote",html: "Si l'exception revient après une synchronisation d'horloge et une réinstallation propre, cessez de réinstaller. Vous avez fait preuve de diligence ; cette combinaison désigne la version de l'application, et les prochaines étapes sont la version Beta et un signalement au support, pas une nouvelle reconstruction." },
    { type: "heading",text: "Essayez la version Beta de bureau" },
    { type: "paragraph",html: "Sous Windows, une réinstallation propre a de bonnes chances de tenir. Sous macOS, supprimer puis réinstaller ne change souvent rien, c'est pourquoi les utilisateurs Mac sont orientés vers un autre levier : la <strong class='text-white'>version Beta de bureau</strong>. Lorsque l'application stable continue de lever &ldquo;Uncaught Exception&rdquo;, passer à la version Beta de Tradovate tend à réduire les plantages ; pour certaines configurations, ils passent de constants à rares. Ce n'est pas un correctif magique et l'exception peut encore surgir de temps en temps, mais si la version stable meurt toutes les quelques minutes, la Beta est le meilleur endroit pour trader en attendant une correction permanente. Trouvez la Beta actuelle via les canaux officiels de Tradovate et confirmez le lien de téléchargement sur leur site, car son emplacement peut changer." },
    { type: "heading",text: "Continuez à trader pendant que ça plante" },
    { type: "paragraph",html: "Vous n'avez pas besoin de surveiller l'application de bureau pour rester sur le marché. La <strong class='text-white'>plateforme web sur trader.tradovate.com</strong> exécute le même compte via votre navigateur et ne dépend pas de la version de bureau défaillante. Un plantage propre au bureau n'affecte pas le navigateur de la même manière : le web trader est donc votre solution de repli la plus fiable. Ouvrez-le dans Chrome ou Edge pour la saisie complète d'ordres, les graphiques et la gestion des positions. L'<strong class='text-white'>application mobile</strong> est un solide plan B pour une tâche en particulier : solder ou ajuster rapidement une position si la fenêtre de bureau meurt alors que vous êtes en direct." },
    { type: "paragraph",html: "Une réserve : la connexion Tradovate impose une limite de sessions ; si vous alternez entre bureau, web et TradingView, déconnectez-vous des sessions que vous n'utilisez pas pour ne pas être éjecté. Considérez le téléphone comme une poignée de secours, pas comme votre poste de pilotage principal." },
    { type: "heading",text: "Signalez-le pour qu'il soit vraiment corrigé" },
    { type: "paragraph",html: "Un ticket vague du type &ldquo;votre application plante sans cesse&rdquo; ne mène nulle part ; un ticket précis et reproductible est escaladé. Lorsque vous contactez le support, donnez-lui de quoi le reproduire :" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Votre système d'exploitation et sa version</strong>, la version de Windows 11 (exécutez <code>winver</code>) ou la version de macOS.",
        "<strong class='text-white'>Version de l'application de bureau</strong>, le numéro de version affiché dans l'écran À propos ou les paramètres de l'application.",
        "<strong class='text-white'>L'erreur exacte</strong>, une capture d'écran de la boîte &ldquo;Uncaught Exception&rdquo;, ainsi que tout fichier console ou journal que l'application propose d'exporter.",
        "<strong class='text-white'>Ce que vous faisiez</strong>, démarrage à froid, suppression d'un modèle ou défilement dans d'anciennes barres. Ce sont des déclencheurs connus, et nommer le vôtre aide à cerner le problème.",
        "<strong class='text-white'>Horodatages en heure centrale</strong>, à peu près quand chaque plantage a eu lieu, afin de pouvoir les rapprocher des journaux du serveur.",
        "<strong class='text-white'>Ce que vous avez déjà écarté</strong>, horloge synchronisée, réinstallation propre faite, plante toujours. Cette seule ligne fait passer votre ticket de &ldquo;avez-vous redémarré&rdquo; à un vrai bug.",
      ],
    },
    { type: "heading",text: "Ne laissez pas un plantage vous coûter une exécution" },
    { type: "paragraph",html: "La version qui fait mal est celle qui survient pendant que vous êtes en position ; construisez donc votre configuration en partant du principe que la fenêtre peut tomber à tout instant. La bonne nouvelle : <strong class='text-white'>vos ordres en attente ne vivent pas dans cette fenêtre.</strong> Tout stop ou objectif que Tradovate a accepté se trouve sur ses serveurs et continue de fonctionner que l'application de bureau tourne ou non ; un stop placé sur le marché se moque que votre écran ait levé une exception. Si vous tradez un compte prop ou d'évaluation, le même principe joue dans l'autre sens : les règles de risque de votre société (drawdown suiveur, limites de perte quotidienne) s'exécutent côté serveur et continuent de compter même quand votre plateforme est hors service, et ces seuils varient selon la société et la taille du compte, vérifiez donc les règles actuelles de votre société. Dans tous les cas, la discipline est la même : placez un stop ferme sur chaque position dès l'entrée et gardez un second accès (web ou mobile) pour pouvoir solder depuis un autre appareil si l'application de bureau tombe." },
    { type: "heading",text: "Le dépannage en un coup d'œil" },
    { type: "table", headers: ["Situation","Signification","Que faire"], rows: [
      ["Boîte d'exception au lancement","Plantage de la version de l'application, pas de vos données","End task (Windows) / Force Quit (Mac), puis rouvrir et se connecter"],
      ["Plante à la suppression d'un modèle","Déclencheur connu, peut effacer des modèles","Exporter/sauvegarder les modèles d'abord, puis supprimer"],
      ["Plante en remontant dans d'anciennes barres","Déclencheur connu sur un historique très ancien","Redémarrer l'application ; éviter les remontées profondes en pleine session"],
      ["La réinstallation sur Mac n'a pas aidé","Le défaut est dans la version, pas dans votre copie","Essayer plutôt la version Beta de bureau"],
      ["Plante toujours après une réinstallation propre","Confirme que c'est l'application, pas votre PC","Cesser de réinstaller ; le signaler avec des détails"],
      ["Vous devez trader tout de suite","La version de bureau n'est pas fiable","Utiliser trader.tradovate.com dans un navigateur ; le mobile pour solder"],
      ["Vous êtes en position quand ça plante","Plantage du client seulement, les ordres sont en sécurité","Confirmer les positions sur le web/mobile ; compter sur votre stop en attente"],
    ] },
    { type: "heading",text: "Tradez malgré les plantages grâce à l'automatisation côté serveur" },
    { type: "paragraph",html: "Si une boîte d'exception vous a déjà coûté une entrée ou une sortie propre, la solution est de cesser de dépendre d'une fenêtre qui doit rester ouverte. PickMyTrade achemine vos alertes TradingView directement vers Tradovate et exécute l'exécution sur nos serveurs, si bien que votre stratégie continue de se déclencher que l'application de bureau soit active ou non :" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Exécution côté serveur</strong>, les alertes vont de TradingView à Tradovate via notre infrastructure, de sorte qu'une application de bureau plantée ne bloque jamais une entrée ou une sortie.",
        "<strong class='text-white'>Indépendance vis-à-vis de l'appareil</strong>, rien n'exige que la fenêtre de bureau soit ouverte ; votre configuration se déclenche à partir de l'alerte, pas du client qui tourne.",
        "<strong class='text-white'>Stops et objectifs qui tiennent</strong>, le SL/TP défini dans votre alerte arrive sur Tradovate quoi que fasse votre écran.",
        "<strong class='text-white'>Synchronisation multi-comptes</strong>, répliquez les mêmes ordres sur tous les comptes connectés à la fois, afin que rien ne reste sans gestion pendant que vous redémarrez.",
      ],
    },
  ], it: [
    { type: "paragraph",html: "Fa doppio clic sull'app desktop, si aspetta i suoi grafici e il DOM e invece compare una semplice finestrella di errore che dice soltanto <strong class='text-white'>Uncaught Exception</strong>. Niente grafici, niente schermata di accesso, nessuna spiegazione. A volte succede appena avvia. A volte l'app si apre normalmente e genera l'errore più tardi, proprio quando elimina un modello o scorre indietro tra vecchie barre. In ogni caso resta bloccato nel momento esatto in cui voleva operare, e fare clic ripetutamente sulla finestra non serve a nulla." },
    { type: "paragraph",html: "La versione breve: <strong class='text-white'>il modo più rapido per rientrare è forzare la chiusura completa dell'app e accedere di nuovo</strong>, con Gestione attività su Windows e Uscita forzata su Mac. Una reinstallazione diretta, soprattutto su macOS, spesso non fa sparire l'arresto, perché risiede nella build dell'app e non nella sua copia. Il piano è quindi: ripristinare in fretta, fare una reinstallazione pulita, provare la build Beta se la stabile continua a morire e tenere aperto un browser o il telefono, così che un arresto non le costi mai un'esecuzione." },
    { type: "quote",html: "<strong class='text-white'>Ripristino rapido:</strong> In Windows, apra <strong class='text-white'>Task Manager</strong> (Ctrl + Shift + Esc), selezioni il processo Tradovate e faccia clic su <strong class='text-white'>End task</strong>. Su Mac, prema <strong class='text-white'>Command + Option + Esc</strong>, scelga Tradovate e faccia clic su <strong class='text-white'>Force Quit</strong>. Poi riavvii e acceda di nuovo: il suo account, gli ordini e le posizioni risiedono tutti sui server di Tradovate, quindi il riavvio non fa perdere nulla." },
    { type: "heading",text: "Che cosa significa davvero «Uncaught Exception»" },
    { type: "paragraph",html: "L'app desktop di Tradovate non è un programma separato dalla piattaforma web: è lo stesso web trader racchiuso in un guscio Chromium per funzionare in modo autonomo su Windows e macOS, ed è da quel contenitore che proviene il messaggio. Una parte del codice dell'app ha incontrato un errore e nulla era previsto per intercettarlo, quindi invece di caricare il suo spazio di lavoro l'app si ferma e mostra una generica &ldquo;Uncaught Exception&rdquo;." },
    { type: "paragraph",html: "Poiché si tratta di un guasto a livello di codice e non di un grafico difettoso o di una connessione caduta, non importa cosa stesse facendo quando è scattato. Compare a un avvio a freddo e a metà sessione con azioni specifiche. Due inneschi spiccano: <strong class='text-white'>l'eliminazione di un modello salvato</strong>, che può far arrestare l'app e portare via parte dei suoi dati dei modelli, e <strong class='text-white'>lo scorrimento molto indietro tra le barre storiche del grafico</strong>, che può farla crollare quando raggiunge dati più vecchi che fatica a visualizzare." },
    { type: "paragraph",html: "Il dettaglio rivelatore è dove l'arresto <em>non si ferma</em>: compare sia su Windows sia su macOS e in molti casi sopravvive a una reinstallazione pulita. Quando lo stesso guasto la segue attraverso sistemi operativi e installazioni nuove, il colpevole è la build dell'app e non il suo hardware, ed è per questo che Tradovate lo ha segnalato come problema noto e perché la risposta duratura qui è &ldquo;ripristini in modo pulito e tenga una alternativa&rdquo;, non &ldquo;ricostruisca la sua macchina&rdquo;." },
    { type: "heading",text: "Prima mossa: forzare la chiusura e accedere di nuovo" },
    { type: "paragraph",html: "Quando compare la finestra dell'eccezione, vuole che la piattaforma funzioni di nuovo prima di pensare alla causa principale. Fare clic sulla finestra non elimina il processo bloccato: termini l'app a livello di sistema e la riavvii da zero." },
    { type: "heading",text: "Su Windows: Termina attività in Gestione attività" },
    { type: "paragraph",html: "Prema <strong class='text-white'>Ctrl + Shift + Esc</strong> per aprire Gestione attività, trovi <strong class='text-white'>Tradovate</strong> nell'elenco dei processi (espanda il gruppo se c'è più di una voce), lo selezioni e faccia clic su <strong class='text-white'>End task</strong>. Questo elimina il processo bloccato lasciato dalla finestra di errore. Riavvii l'app dal menu Start e acceda di nuovo: torna a uno stato funzionante in pochi secondi. È il ripristino affidabile; semplicemente non impedisce che l'arresto ritorni più tardi." },
    { type: "heading",text: "Su Mac: Uscita forzata" },
    { type: "paragraph",html: "Prema <strong class='text-white'>Command + Option + Esc</strong> per aprire la finestra Uscita forzata, selezioni <strong class='text-white'>Tradovate</strong> e faccia clic su <strong class='text-white'>Force Quit</strong>. Se l'app non risponde affatto, tenga premuto il clic sulla sua icona nel Dock e scelga lì Uscita forzata. La riapra e acceda di nuovo. Stessa idea di Windows: la fa tornare a operare, ma su macOS in particolare si aspetti che ritorni." },
    { type: "heading",text: "Escluda la sua configurazione (un passaggio pulito)" },
    { type: "paragraph",html: "Poiché questo arresto viaggia con la build dell'app, i passaggi seguenti potrebbero non essere ciò che lo risolve finalmente. Li esegua comunque, nel caso in cui il suo sia davvero un caso di installazione locale corrotta, e per poter dire al supporto &ldquo;Ho già fatto una reinstallazione pulita e sincronizzato l'orologio, e continua a generare l'eccezione&rdquo;. Questo trasforma una lamentela vaga in una vera segnalazione di bug." },
    { type: "heading",text: "Sincronizzi l'orologio di sistema" },
    { type: "paragraph",html: "Un orologio che deriva rompe la connessione sicura da cui l'app dipende e può portarla in stati strani, quindi è la cosa più economica da escludere per prima. In Windows, faccia clic con il pulsante destro sull'orologio nella barra delle applicazioni, scelga <strong class='text-white'>Adjust date/time</strong>, attivi <strong class='text-white'>Set time automatically</strong> e faccia clic su <strong class='text-white'>Sync now</strong>. Su Mac, apra <strong class='text-white'>System Settings &rarr; General &rarr; Date &amp; Time</strong> e attivi <strong class='text-white'>Set time and date automatically</strong>. Le indicazioni di Tradovate sono esplicite sul mantenere l'orologio della macchina sincronizzato con l'ora di rete, quindi non le salti." },
    { type: "heading",text: "Faccia una reinstallazione completa e pulita" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Windows:</strong> in Esplora file, digiti <code>%localappdata%</code> nella barra degli indirizzi ed elimini lì la cartella Tradovate, poi faccia lo stesso per <code>%appdata%</code>.",
        "<strong class='text-white'>Mac:</strong> rimuova le cartelle residue di supporto e cache dell'app in <code>~/Library</code> (Application Support e Caches) dopo aver trascinato l'app nel Cestino.",
      ],
    },
    { type: "paragraph",html: "In rari casi l'installazione stessa è corrotta e una semplice reinstallazione sopra non la risolve perché i file in cache dell'app restano. La faccia una volta bene: disinstalli l'app desktop, rimuova le cartelle residue indicate sopra, poi scarichi un installer nuovo dalla pagina di download ufficiale di Tradovate (<strong class='text-white'>tradovate.com/devices</strong>) e installi la build più recente, così testa la versione attuale; una correzione potrebbe già essere in distribuzione e non vuole continuare a lottare contro un bug già corretto." },
    { type: "heading",text: "Prima esegua il backup dei modelli" },
    { type: "paragraph",html: "Poiché l'eliminazione di un modello è uno degli inneschi e un arresto può cancellare i dati dei modelli mentre cade, protegga prima i suoi layout. Usi l'icona di salvataggio/esportazione per conservare una copia di ogni modello prima di reinstallare o eliminare qualsiasi cosa, così un'uscita sbagliata non porterà via il suo spazio di lavoro." },
    { type: "quote",html: "Se l'eccezione continua a ripresentarsi dopo una sincronizzazione dell'orologio e una reinstallazione pulita, smetta di reinstallare. Ha fatto la sua parte: quella combinazione indica la build dell'app e le prossime mosse sono la versione Beta e una segnalazione al supporto, non un'altra ricostruzione." },
    { type: "heading",text: "Provi la build desktop Beta" },
    { type: "paragraph",html: "Su Windows una reinstallazione pulita ha buone probabilità di tenere. Su macOS un'eliminazione e reinstallazione spesso non cambia nulla, ed è per questo che gli utenti Mac vengono spinti verso un'altra leva: la <strong class='text-white'>build desktop Beta</strong>. Quando l'app stabile continua a generare &ldquo;Uncaught Exception&rdquo;, passare alla versione Beta di Tradovate tende a ridurre gli arresti; per alcune configurazioni si passa da costanti a rari. Non è una correzione magica e l'eccezione può ancora affiorare di tanto in tanto, ma se la build stabile muore ogni pochi minuti, la Beta è il posto migliore da cui operare mentre si lavora a una soluzione permanente. Trovi la Beta attuale tramite i canali ufficiali di Tradovate e confermi il link di download sul loro sito, perché la sua posizione può cambiare." },
    { type: "heading",text: "Continui a operare mentre si blocca" },
    { type: "paragraph",html: "Non deve fare da babysitter all'app desktop per restare sul mercato. La <strong class='text-white'>piattaforma web su trader.tradovate.com</strong> esegue lo stesso account tramite il suo browser e non dipende dalla build desktop che sta fallendo. Un arresto specifico del desktop non colpisce il browser allo stesso modo, quindi il web trader è la sua alternativa più affidabile: lo apra in Chrome o Edge per l'inserimento completo degli ordini, i grafici e la gestione delle posizioni. L'<strong class='text-white'>app mobile</strong> è un solido supporto per un compito in particolare: chiudere o modificare in fretta una posizione se la finestra desktop muore mentre è operativo." },
    { type: "paragraph",html: "Un'avvertenza: l'accesso a Tradovate impone un limite di sessioni, quindi se passa da desktop, web e TradingView, esca dalle sessioni che non usa per non essere espulso. Consideri il telefono una maniglia d'emergenza, non la sua cabina di pilotaggio principale." },
    { type: "heading",text: "Lo segnali perché venga davvero risolto" },
    { type: "paragraph",html: "Un ticket vago del tipo &ldquo;la sua app si blocca continuamente&rdquo; non porta da nessuna parte; uno specifico e riproducibile viene escalato. Quando contatta il supporto, gli fornisca abbastanza dettagli per riprodurlo:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Il suo sistema operativo e la versione</strong>, la build di Windows 11 (esegua <code>winver</code>) o la versione di macOS.",
        "<strong class='text-white'>Versione dell'app desktop</strong>, il numero di build dalla schermata Informazioni o dalle impostazioni dell'app.",
        "<strong class='text-white'>L'errore esatto</strong>, uno screenshot della finestra &ldquo;Uncaught Exception&rdquo;, più qualsiasi file di console o di log che l'app offra di esportare.",
        "<strong class='text-white'>Che cosa stava facendo</strong>, avvio a freddo, eliminazione di un modello o scorrimento tra vecchie barre. Sono inneschi noti e indicare il suo li aiuta a circoscrivere il problema.",
        "<strong class='text-white'>Orari in Central Time</strong>, approssimativamente quando è avvenuto ogni arresto, così da poterli confrontare con i log del server.",
        "<strong class='text-white'>Che cosa ha già escluso</strong>, orologio sincronizzato, reinstallazione pulita fatta, si blocca ancora. Quell'unica riga sposta il suo ticket da &ldquo;ha riavviato?&rdquo; a un vero bug.",
      ],
    },
    { type: "heading",text: "Non lasci che un arresto le costi un'esecuzione" },
    { type: "paragraph",html: "La versione che fa male è quella che scatta mentre è in un trade, quindi costruisca la sua configurazione sul fatto che la finestra può cadere in qualsiasi secondo. La buona notizia: <strong class='text-white'>i suoi ordini in attesa non vivono in quella finestra.</strong> Qualsiasi stop o target che Tradovate ha accettato si trova sui suoi server e continua a funzionare che l'app desktop sia in esecuzione o meno; a uno stop piazzato sul mercato non importa che il suo schermo abbia generato un'eccezione. Se opera su un conto prop o di valutazione, lo stesso principio vale nell'altro senso: le regole di rischio della sua società (drawdown trailing, limiti di perdita giornaliera) girano lato server e continuano a contare anche quando la sua piattaforma è fuori uso, e queste soglie variano a seconda della società e della dimensione del conto, quindi verifichi le regole attuali della sua società. In ogni caso la disciplina è la stessa: metta uno stop rigido su ogni posizione nel momento in cui entra e tenga un secondo accesso (web o mobile) per poter chiudere da un altro dispositivo se l'app desktop cade." },
    { type: "heading",text: "Risoluzione dei problemi in sintesi" },
    { type: "table", headers: ["Situazione","Che cosa significa","Che cosa fare"], rows: [
