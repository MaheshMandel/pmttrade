---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "service-outages-down-at-open";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/debugging/${SLUG}`;

const META_TITLE = "Tradovate Outages: Platform Down at Market Open";
const META_DESCRIPTION =
  "Tradovate outage at market open? Learn why the platform goes down, how to check status, keep a backup broker, and reconcile fills fast after downtime.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Tradovate-Ausfälle: Plattform bei Marktöffnung down", es: "Caídas de Tradovate: plataforma fuera de servicio en la apertura del mercado", fr: "Pannes Tradovate : plateforme hors service à l'ouverture du marché", it: "Interruzioni di Tradovate: piattaforma non disponibile all'apertura del mercato" },
  dek: { en: "When ES and NQ are ripping at the 9:30 ET cash open, a Tradovate outage is the worst possible time to lose your platform. Here's the playbook: confirm it's server-side, protect open risk, and reconcile every fill.", de: "Wenn ES und NQ bei der Kassaeröffnung um 9:30 ET durch die Decke gehen, ist ein Tradovate-Ausfall der schlechteste denkbare Zeitpunkt, die Plattform zu verlieren. Hier ist das Vorgehen: bestätigen, dass es serverseitig liegt, offenes Risiko absichern und jede Ausführung abgleichen.", es: "Cuando ES y NQ se disparan en la apertura de contado de las 9:30 ET, una caída de Tradovate es el peor momento posible para perder su plataforma. Este es el plan: confirmar que es del lado del servidor, proteger el riesgo abierto y conciliar cada ejecución.", fr: "Quand l'ES et le NQ s'envolent à l'ouverture au comptant de 9:30 ET, une panne Tradovate est le pire moment possible pour perdre votre plateforme. Voici la marche à suivre : confirmer que c'est côté serveur, protéger le risque ouvert et rapprocher chaque exécution.", it: "Quando ES e NQ volano all'apertura cash delle 9:30 ET, un'interruzione di Tradovate è il peggior momento possibile per perdere la piattaforma. Ecco il piano: confermare che il problema è lato server, proteggere il rischio aperto e riconciliare ogni esecuzione." },
  readTime: { en: "8 min read", de: "8 Min. Lesezeit", es: "Lectura de 8 min", fr: "Lecture : 8 min", it: "Lettura di 8 min" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "When ES and NQ are ripping at the 9:30 ET cash open, a Tradovate outage is the worst possible time to lose your platform. You can't enter, you can't flatten, and the support line is already jammed with every other trader stuck in the same spot. This isn't some rare edge case either. Tradovate-connectivity incidents pile up over the course of a year, and the downtime tends to run anywhere from a few minutes to roughly an hour, usually clustered around the busiest sessions." },
    { type: "paragraph", html: "Whether the platform is fully down, stuck on &ldquo;Disconnected,&rdquo; refusing to fill stops, or quietly executing orders you thought you'd cancelled, the playbook doesn't change: confirm it's Tradovate's side, protect your open risk with a backup connection, and reconcile every fill once service comes back. Automation like PickMyTrade won't keep Tradovate's servers online, but it makes running a hedge and squaring up afterward far less painful." },
    {
      type: "checklist",
      heading: "Quick Checklist for a Tradovate Outage at Market Open",
      items: [
        "<strong class='text-white'>Check the status page first.</strong> Open the official service status at status.tradovate.com (or the in-platform Service Status view) before you touch a single order. If components are down, it's not your setup.",
        "<strong class='text-white'>Don't spam login or retries.</strong> Hammering the app or API during an outage can trigger a 429 &ldquo;Too Many Requests&rdquo; or a captcha lockout on top of the outage you already have.",
        "<strong class='text-white'>Reduce open risk on a backup broker.</strong> If you're holding positions, hedge or flatten through a second broker or DOM instead of waiting on the frozen app.",
        "<strong class='text-white'>Assume orders are in an unknown state.</strong> A stop that looks &ldquo;working&rdquo; may not be live, and a &ldquo;cancelled&rdquo; order may still fill. Treat everything as unconfirmed.",
        "<strong class='text-white'>Reconcile fills after recovery.</strong> Compare the Orders and Positions modules against your intended state the moment the platform is back.",
        "<strong class='text-white'>Screenshot everything.</strong> Timestamps, error text, and positions give you the evidence you need if you have to dispute a fill or file a support ticket.",
      ],
    },
    { type: "heading", text: "What a Tradovate Outage at Market Open Actually Looks Like" },
    { type: "paragraph", html: "Outages don't always announce themselves with a clean &ldquo;platform is down&rdquo; banner. More often you get partial failure: the chart still updates but the DOM won't accept clicks, or orders sit as &ldquo;Pending&rdquo; and never confirm, or you get bounced to a login screen that spins forever. The usual on-screen symptoms are a persistent &ldquo;Disconnected&rdquo; indicator, an &ldquo;Internal Server Error&rdquo; message after a freeze, a &ldquo;Trading has temporarily halted&rdquo; notice, and quotes that stop ticking while the clock keeps moving." },
    { type: "paragraph", html: "The dangerous part is the gap between what your screen shows and what the exchange actually has. During an outage you can watch a take-profit and a stop-loss fail to trigger, then discover that orders you believed were cancelled had filled anyway. That's how you end up holding a dozen-plus unwanted contracts from orders you thought were dead. When the front end and the matching engine disagree, you land in a position you never intended to hold." },
    { type: "heading", text: "Top Causes of Tradovate Going Down at the Open in 2026" },
    { type: "heading", text: "1. Peak-load spikes at the cash open" },
    { type: "paragraph", html: "The 9:30 ET equity open (and the 8:30 ET data releases just before it) cram enormous order flow into a few seconds. Front-end, execution, and market-data services all spike together, and if any one tier saturates, the platform degrades. That's why outages cluster around the open and around scheduled news instead of hitting at random." },
    { type: "heading", text: "2. Market-data feed drops" },
    { type: "paragraph", html: "When the CME data feed hiccups or Tradovate's market-data component degrades, symbols stop ticking and you'll see &ldquo;No Quote Available.&rdquo; Because the platform's risk checks depend on a live quote, a data drop can cascade into order rejections even when execution itself is technically up." },
    { type: "heading", text: "3. Order-routing and execution service degradation" },
    { type: "paragraph", html: "The Execution and Risk &amp; Routing components can degrade independently of the charts. That's the classic &ldquo;charts look fine but I can't get filled&rdquo; scenario. Orders queue, sit pending, or reject while the rest of the screen looks perfectly normal." },
    { type: "heading", text: "4. Ghost orders and stuck positions" },
    { type: "paragraph", html: "During an outage the front end can lose sync with the back end. Orders you cancel may not actually cancel server-side, and fills may never display. When connectivity restores, those &ldquo;ghost&rdquo; orders can execute and drop you into a surprise position. This is the single most expensive failure mode of an open-time outage." },
    { type: "heading", text: "5. Support queue saturation" },
    { type: "paragraph", html: "Because outages hit everyone at once, the Trade Desk and support channels flood instantly. You can wait on hold only to get dumped into a voicemail box that's already full, which means the human backstop you'd count on to get flattened is often unreachable exactly when you need it." },
    { type: "heading", text: "How to Fix (and Survive) a Tradovate Outage: Step-by-Step" },
    { type: "heading", text: "Confirm it's Tradovate, not your setup" },
    { type: "paragraph", html: "Before you reinstall anything or panic-click, verify the outage is server-side." },
    {
      type: "steps",
      items: [
        { title: "Open the status page", html: "Open <strong class='text-white'>status.tradovate.com</strong> in a browser. A separate device or your phone is ideal if your desktop is frozen." },
        { title: "Check the component list", html: "Check the component list. Frontend, Execution, Risk &amp; Routing, and Market Data are the ones that matter for order flow." },
        { title: "Cross-check other sources", html: "Cross-check the in-platform <strong class='text-white'>Service Status</strong> view and a third-party tracker so you're not leaning on a single source." },
        { title: "Stop troubleshooting locally", html: "If components show degraded or down, stop troubleshooting your own machine. Nothing local will fix a server-side outage." },
      ],
    },
    { type: "heading", text: "Reduce open risk immediately with a backup connection" },
    { type: "paragraph", html: "This is exactly why experienced futures traders keep a second route to the market. If Tradovate is unusable and you're holding size:" },
    {
      type: "steps",
      items: [
        { title: "Open your backup route", html: "Open your backup broker or a second DOM that isn't routed through the same failing service." },
        { title: "Hedge or flatten", html: "Hedge the exposure with a matching opposite position on a correlated or identical contract, or flatten outright." },
        { title: "Don't re-send into the frozen app", html: "Do <strong class='text-white'>not</strong> keep re-sending orders into the frozen Tradovate app. Duplicate orders are exactly how ghost fills happen when it recovers." },
      ],
    },
    { type: "heading", text: "Reconcile fills the moment the platform is back" },
    { type: "paragraph", html: "Recovery is the highest-risk window, not the safe one." },
    {
      type: "steps",
      items: [
        { title: "Open Orders and Positions together", html: "Open the <strong class='text-white'>Orders</strong> module and the <strong class='text-white'>Positions</strong> module side by side." },
        { title: "Compare against your intent", html: "Compare actual open positions and working orders against what you <em>intended</em>. Look specifically for orders you thought were cancelled and fills you never saw happen." },
        { title: "Cancel orphaned orders", html: "Cancel any orphaned or duplicate working orders, like a stray target left behind after a stop-out." },
        { title: "Resume only once flat and matched", html: "Only once the account matches your intended state should you resume trading." },
      ],
    },
    { type: "heading", text: "Flatten cleanly on reconnect if anything looks wrong" },
    { type: "paragraph", html: "If reconciliation turns up a position you don't want, square up deliberately rather than layering on more orders." },
    {
      type: "steps",
      items: [
        { title: "Use flatten / close all", html: "Use the account-level <strong class='text-white'>flatten / close all</strong> control to exit open positions and cancel working orders in one action." },
        { title: "Confirm flat", html: "Confirm the Positions module reads flat before you step away." },
        { title: "Capture evidence", html: "Capture a screenshot of the flat state and the timestamp in case you need to raise a fill dispute later." },
      ],
    },
    { type: "heading", text: "Troubleshooting Table" },
    {
      type: "table",
      headers: ["Error / symptom", "What it means", "Fast fix"],
      rows: [
        ["&ldquo;Disconnected&rdquo; / spinning login", "Your session lost the server; the platform may be degraded", "Check status.tradovate.com; wait and retry once, don't spam logins"],
        ["&ldquo;Internal Server Error&rdquo; after a freeze", "Server-side fault, usually during an outage window", "Wait for the incident to clear, then reconcile positions on reconnect"],
        ["&ldquo;Trading has temporarily halted&rdquo;", "Order entry is paused platform- or instrument-side", "Don't force retries; confirm on the status page and manage risk elsewhere"],
        ["&ldquo;No Quote Available&rdquo;", "Market-data feed dropped, so risk checks can't clear the order", "Wait for data to restore; a stale quote will keep rejecting orders"],
        ["Stops/targets not triggering", "Execution or routing degraded; order may not be live", "Hedge or flatten via a backup connection; verify each order after recovery"],
        ["Orders you cancelled still fill (ghost orders)", "Front end lost sync with the matching engine", "Stop new entries; reconcile Orders vs. Positions and cancel orphans immediately"],
        ["&ldquo;429 Too Many Requests&rdquo; during retries", "You (or your tools) hit the rate limit while hammering the app", "Back off; wait out the cooldown before trying again"],
      ],
    },
    { type: "heading", text: "Prevent This with PickMyTrade" },
    { type: "paragraph", html: "No bridge can keep Tradovate's servers online. But most of the damage from an open-time outage is <em>self-inflicted</em>: duplicate retries, an unhedged position, and a frozen desktop app. That's the part automation can take off your plate." },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Multi-Broker Routing.</strong> Send the same TradingView alert to a backup broker connection so a Tradovate outage doesn't leave you unhedged at the open.",
        "<strong class='text-white'>Server-Side Execution.</strong> Alerts fire from PickMyTrade's servers, not your frozen desktop, so a local app crash doesn't silently drop your automation.",
        "<strong class='text-white'>Rate-Limit-Safe Routing.</strong> Server-side queueing spaces out order flow and avoids the self-inflicted 429 lockouts that pile up when you're frantically retrying during downtime.",
        "<strong class='text-white'>Multi-Account Sync.</strong> Mirror a corrective flatten across every connected account at once instead of squaring up one login at a time.",
      ],
    },
    { type: "paragraph", html: "Pair that with a backup broker and disciplined post-outage reconciliation, and an open-time outage becomes an annoyance instead of a blown account." },
  ], de: [
    { type: "paragraph",html: "Wenn ES und NQ bei der Kassaeröffnung um 9:30 ET durch die Decke gehen, ist ein Tradovate-Ausfall der schlechteste denkbare Zeitpunkt, die Plattform zu verlieren. Sie können nicht einsteigen, nicht glattstellen, und die Support-Hotline ist bereits von allen anderen Tradern blockiert, die in derselben Lage stecken. Das ist auch kein seltener Ausnahmefall. Tradovate-Konnektivitätsvorfälle häufen sich im Lauf eines Jahres, und die Ausfallzeit reicht meist von wenigen Minuten bis zu etwa einer Stunde, in der Regel gebündelt in den geschäftigsten Sitzungen." },
    { type: "paragraph",html: "Ob die Plattform komplett ausfällt, bei &ldquo;Disconnected&rdquo; hängt, Stops nicht ausführt oder stillschweigend Orders ausführt, die Sie für storniert hielten – das Vorgehen bleibt gleich: bestätigen, dass es an Tradovates Seite liegt, offenes Risiko über eine Backup-Verbindung absichern und jede Ausführung abgleichen, sobald der Dienst zurück ist. Automatisierung wie PickMyTrade hält die Server von Tradovate nicht online, macht es aber deutlich weniger mühsam, eine Absicherung zu fahren und danach glattzustellen." },
    {
      type: "checklist",
      heading: "Kurze Checkliste bei einem Tradovate-Ausfall zur Marktöffnung",
      items: [
        "<strong class='text-white'>Prüfen Sie zuerst die Statusseite.</strong> Öffnen Sie den offiziellen Servicestatus unter status.tradovate.com (oder die In-Platform-Ansicht Service Status), bevor Sie eine einzige Order anfassen. Sind Komponenten down, liegt es nicht an Ihrem Setup.",
        "<strong class='text-white'>Spammen Sie keine Logins oder Wiederholungen.</strong> Das Bombardieren von App oder API während eines Ausfalls kann zusätzlich zum bestehenden Ausfall ein 429 &ldquo;Too Many Requests&rdquo; oder eine Captcha-Sperre auslösen.",
        "<strong class='text-white'>Reduzieren Sie offenes Risiko über einen Backup-Broker.</strong> Wenn Sie Positionen halten, sichern Sie sie über einen zweiten Broker oder ein DOM ab oder stellen Sie glatt, statt auf die eingefrorene App zu warten.",
        "<strong class='text-white'>Gehen Sie davon aus, dass Orders in einem unbekannten Zustand sind.</strong> Ein Stop, der &ldquo;working&rdquo; aussieht, ist möglicherweise nicht live, und eine &ldquo;stornierte&rdquo; Order kann trotzdem ausgeführt werden. Behandeln Sie alles als unbestätigt.",
        "<strong class='text-white'>Gleichen Sie Ausführungen nach der Wiederherstellung ab.</strong> Vergleichen Sie die Module Orders und Positions mit Ihrem beabsichtigten Zustand, sobald die Plattform wieder da ist.",
        "<strong class='text-white'>Machen Sie von allem Screenshots.</strong> Zeitstempel, Fehlertexte und Positionen liefern die Belege, die Sie brauchen, wenn Sie eine Ausführung anfechten oder ein Support-Ticket eröffnen müssen.",
      ],
    },
    { type: "heading",text: "Wie ein Tradovate-Ausfall bei der Marktöffnung tatsächlich aussieht" },
    { type: "paragraph",html: "Ausfälle kündigen sich nicht immer mit einem sauberen &ldquo;Plattform ist down&rdquo;-Banner an. Häufiger gibt es einen Teilausfall: Der Chart aktualisiert sich noch, aber das DOM nimmt keine Klicks an, oder Orders bleiben &ldquo;Pending&rdquo; und werden nie bestätigt, oder Sie landen auf einem Login-Bildschirm, der endlos dreht. Die üblichen Symptome auf dem Bildschirm sind eine dauerhafte &ldquo;Disconnected&rdquo;-Anzeige, die Meldung &ldquo;Internal Server Error&rdquo; nach einem Einfrieren, ein Hinweis &ldquo;Trading has temporarily halted&rdquo; und Kurse, die nicht mehr ticken, während die Uhr weiterläuft." },
    { type: "paragraph",html: "Gefährlich ist die Lücke zwischen dem, was Ihr Bildschirm zeigt, und dem, was die Börse tatsächlich hat. Bei einem Ausfall können Sie zusehen, wie ein Take-Profit und ein Stop-Loss nicht auslösen, und dann feststellen, dass Orders, die Sie für storniert hielten, trotzdem ausgeführt wurden. So landen Sie bei einem Dutzend und mehr ungewollter Kontrakte aus Orders, die Sie für tot hielten. Wenn Front-End und Matching-Engine sich widersprechen, landen Sie in einer Position, die Sie nie halten wollten." },
    { type: "heading",text: "Häufigste Ursachen für Tradovate-Ausfälle bei der Eröffnung 2026" },
    { type: "heading",text: "1. Lastspitzen bei der Kassaeröffnung" },
    { type: "paragraph",html: "Die Aktieneröffnung um 9:30 ET (und die Datenveröffentlichungen um 8:30 ET kurz davor) pressen enormen Order-Fluss in wenige Sekunden. Front-End-, Ausführungs- und Marktdatendienste springen gleichzeitig an, und wenn eine Ebene gesättigt ist, verschlechtert sich die Plattform. Deshalb häufen sich Ausfälle rund um die Eröffnung und um planmäßige Nachrichten, statt zufällig aufzutreten." },
    { type: "heading",text: "2. Ausfälle des Marktdatenfeeds" },
    { type: "paragraph",html: "Wenn der CME-Datenfeed aussetzt oder die Marktdatenkomponente von Tradovate beeinträchtigt ist, hören Symbole auf zu ticken, und Sie sehen &ldquo;No Quote Available&rdquo;. Da die Risikoprüfungen der Plattform einen Live-Kurs voraussetzen, kann ein Datenausfall zu Order-Ablehnungen führen, selbst wenn die Ausführung technisch läuft." },
    { type: "heading",text: "3. Beeinträchtigung von Order-Routing und Ausführungsdienst" },
    { type: "paragraph",html: "Die Komponenten Execution und Risk &amp; Routing können unabhängig von den Charts beeinträchtigt sein. Das ist das klassische Szenario &ldquo;Charts sehen gut aus, aber ich werde nicht ausgeführt&rdquo;. Orders reihen sich ein, bleiben ausstehend oder werden abgelehnt, während der Rest des Bildschirms völlig normal aussieht." },
    { type: "heading",text: "4. Geister-Orders und feststeckende Positionen" },
    { type: "paragraph",html: "Bei einem Ausfall kann das Front-End die Synchronisation mit dem Back-End verlieren. Von Ihnen stornierte Orders werden serverseitig möglicherweise nicht wirklich storniert, und Ausführungen werden womöglich nie angezeigt. Wird die Konnektivität wiederhergestellt, können diese &ldquo;Geister&rdquo;-Orders ausgeführt werden und Sie in eine überraschende Position bringen. Das ist die teuerste Fehlerart eines Ausfalls zur Eröffnung." },
    { type: "heading",text: "5. Überlastete Support-Warteschlange" },
    { type: "paragraph",html: "Da Ausfälle alle gleichzeitig treffen, werden Trade Desk und Support-Kanäle sofort überflutet. Sie können in der Warteschleife hängen und dann in einer bereits vollen Mailbox landen – das heißt, die menschliche Absicherung, auf die Sie zum Glattstellen zählen würden, ist oft genau dann nicht erreichbar, wenn Sie sie brauchen." },
    { type: "heading",text: "So beheben (und überstehen) Sie einen Tradovate-Ausfall: Schritt für Schritt" },
    { type: "heading",text: "Bestätigen, dass es Tradovate ist, nicht Ihr Setup" },
    { type: "paragraph",html: "Bevor Sie etwas neu installieren oder panisch klicken, prüfen Sie, ob der Ausfall serverseitig ist." },
    {
      type: "steps",
      items: [
        { title: "Die Statusseite öffnen", html: "Öffnen Sie <strong class='text-white'>status.tradovate.com</strong> in einem Browser. Ein separates Gerät oder Ihr Smartphone ist ideal, wenn Ihr Desktop eingefroren ist." },
        { title: "Die Komponentenliste prüfen", html: "Prüfen Sie die Komponentenliste. Frontend, Execution, Risk &amp; Routing und Market Data sind die für den Order-Fluss relevanten." },
        { title: "Andere Quellen gegenprüfen", html: "Gleichen Sie die In-Platform-Ansicht <strong class='text-white'>Service Status</strong> und einen Drittanbieter-Tracker ab, damit Sie sich nicht auf eine einzige Quelle verlassen." },
        { title: "Lokale Fehlersuche beenden", html: "Wenn Komponenten als beeinträchtigt oder down angezeigt werden, hören Sie auf, Ihren eigenen Rechner zu prüfen. Nichts Lokales behebt einen serverseitigen Ausfall." },
      ],
    },
    { type: "heading",text: "Offenes Risiko sofort mit einer Backup-Verbindung reduzieren" },
    { type: "paragraph",html: "Genau deshalb halten erfahrene Futures-Trader einen zweiten Weg zum Markt vor. Wenn Tradovate unbrauchbar ist und Sie Größe halten:" },
    {
      type: "steps",
      items: [
        { title: "Ihre Backup-Route öffnen", html: "Öffnen Sie Ihren Backup-Broker oder ein zweites DOM, das nicht über denselben ausfallenden Dienst läuft." },
        { title: "Absichern oder glattstellen", html: "Sichern Sie das Exposure mit einer passenden Gegenposition in einem korrelierten oder identischen Kontrakt ab oder stellen Sie komplett glatt." },
        { title: "Nicht erneut in die eingefrorene App senden", html: "Senden Sie Orders <strong class='text-white'>nicht</strong> immer wieder in die eingefrorene Tradovate-App. Doppelte Orders sind genau der Weg, wie Geister-Ausführungen bei der Wiederherstellung entstehen." },
      ],
    },
    { type: "heading",text: "Ausführungen abgleichen, sobald die Plattform zurück ist" },
    { type: "paragraph",html: "Die Wiederherstellung ist das Fenster mit dem höchsten Risiko, nicht das sichere." },
    {
      type: "steps",
      items: [
        { title: "Orders und Positions gemeinsam öffnen", html: "Öffnen Sie das Modul <strong class='text-white'>Orders</strong> und das Modul <strong class='text-white'>Positions</strong> nebeneinander." },
        { title: "Mit Ihrer Absicht vergleichen", html: "Vergleichen Sie tatsächlich offene Positionen und laufende Orders mit dem, was Sie <em>beabsichtigt</em> hatten. Achten Sie gezielt auf Orders, die Sie für storniert hielten, und auf Ausführungen, die Sie nie haben passieren sehen." },
        { title: "Verwaiste Orders stornieren", html: "Stornieren Sie verwaiste oder doppelte laufende Orders, etwa ein übrig gebliebenes Ziel nach einem Stop-out." },
        { title: "Erst fortfahren, wenn flat und abgeglichen", html: "Erst wenn das Konto Ihrem beabsichtigten Zustand entspricht, sollten Sie den Handel wieder aufnehmen." },
      ],
    },
    { type: "heading",text: "Bei Auffälligkeiten nach der Wiederverbindung sauber glattstellen" },
    { type: "paragraph",html: "Wenn der Abgleich eine ungewollte Position zutage fördert, stellen Sie gezielt glatt, statt weitere Orders darüberzuschichten." },
    {
      type: "steps",
      items: [
        { title: "Flatten / Close All verwenden", html: "Nutzen Sie die Funktion <strong class='text-white'>flatten / close all</strong> auf Kontoebene, um offene Positionen zu schließen und laufende Orders in einem Schritt zu stornieren." },
        { title: "Flat bestätigen", html: "Bestätigen Sie, dass das Modul Positions flat anzeigt, bevor Sie sich entfernen." },
        { title: "Belege sichern", html: "Erstellen Sie einen Screenshot des flachen Zustands und des Zeitstempels, falls Sie später eine Ausführungsbeschwerde einreichen müssen." },
      ],
    },
    { type: "heading",text: "Fehlerbehebungstabelle" },
    { type: "table", headers: ["Fehler / Symptom","Was es bedeutet","Schnelle Lösung"], rows: [
      ["&ldquo;Disconnected&rdquo; / endlos drehender Login","Ihre Sitzung hat den Server verloren; die Plattform ist möglicherweise beeinträchtigt","status.tradovate.com prüfen; abwarten und einmal erneut versuchen, keine Logins spammen"],
      ["&ldquo;Internal Server Error&rdquo; nach einem Einfrieren","Serverseitiger Fehler, meist während eines Ausfallfensters","Das Ende des Vorfalls abwarten, dann bei der Wiederverbindung Positionen abgleichen"],
      ["&ldquo;Trading has temporarily halted&rdquo;","Order-Eingabe ist plattform- oder instrumentenseitig pausiert","Keine Wiederholungen erzwingen; auf der Statusseite bestätigen und Risiko anderweitig steuern"],
      ["&ldquo;No Quote Available&rdquo;","Marktdatenfeed ausgefallen, daher können Risikoprüfungen die Order nicht freigeben","Auf die Wiederherstellung der Daten warten; ein veralteter Kurs lehnt weiter Orders ab"],
      ["Stops/Ziele lösen nicht aus","Ausführung oder Routing beeinträchtigt; Order ist möglicherweise nicht live","Über eine Backup-Verbindung absichern oder glattstellen; jede Order nach der Wiederherstellung prüfen"],
      ["Stornierte Orders werden trotzdem ausgeführt (Geister-Orders)","Front-End hat die Synchronisation mit der Matching-Engine verloren","Neue Einstiege stoppen; Orders gegen Positions abgleichen und verwaiste Orders sofort stornieren"],
      ["&ldquo;429 Too Many Requests&rdquo; bei Wiederholungen","Sie (oder Ihre Tools) haben beim Hämmern auf die App das Ratenlimit erreicht","Zurückfahren; die Abkühlphase abwarten, bevor Sie es erneut versuchen"],
    ] },
    { type: "heading",text: "Beugen Sie vor mit PickMyTrade" },
    { type: "paragraph",html: "Keine Bridge kann die Server von Tradovate online halten. Aber ein Großteil des Schadens eines Ausfalls zur Eröffnung ist <em>selbstverursacht</em>: doppelte Wiederholungen, eine ungesicherte Position und eine eingefrorene Desktop-App. Diesen Teil kann Ihnen die Automatisierung abnehmen." },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Multi-Broker-Routing.</strong> Senden Sie denselben TradingView-Alert an eine Backup-Broker-Verbindung, damit Sie bei einem Tradovate-Ausfall zur Eröffnung nicht ungesichert dastehen.",
        "<strong class='text-white'>Serverseitige Ausführung.</strong> Alerts werden von den Servern von PickMyTrade ausgelöst, nicht von Ihrem eingefrorenen Desktop, sodass ein lokaler App-Absturz Ihre Automatisierung nicht stillschweigend verliert.",
        "<strong class='text-white'>Ratenlimitsicheres Routing.</strong> Serverseitiges Queueing verteilt den Order-Fluss und vermeidet die selbstverursachten 429-Sperren, die sich häufen, wenn Sie bei Ausfallzeiten hektisch wiederholen.",
        "<strong class='text-white'>Multi-Account-Synchronisierung.</strong> Spiegeln Sie ein korrigierendes Glattstellen gleichzeitig auf alle verbundenen Konten, statt ein Login nach dem anderen glattzustellen.",
      ],
    },
    { type: "paragraph",html: "Kombinieren Sie das mit einem Backup-Broker und disziplinierter Abstimmung nach dem Ausfall, und ein Ausfall zur Eröffnung wird zum Ärgernis statt zu einem ruinierten Konto." },
  ], es: [
    { type: "paragraph",html: "Cuando ES y NQ se disparan en la apertura de contado de las 9:30 ET, una caída de Tradovate es el peor momento posible para perder su plataforma. No puede entrar, no puede cerrar y la línea de soporte ya está saturada por todos los demás traders atrapados en la misma situación. Tampoco es un caso límite poco frecuente. Los incidentes de conectividad de Tradovate se acumulan a lo largo de un año, y el tiempo de inactividad suele ir desde unos pocos minutos hasta aproximadamente una hora, normalmente concentrado en las sesiones más activas." },
    { type: "paragraph",html: "Ya sea que la plataforma esté completamente caída, atascada en &ldquo;Disconnected&rdquo;, se niegue a ejecutar stops o ejecute silenciosamente órdenes que creía canceladas, el plan no cambia: confirmar que es del lado de Tradovate, proteger su riesgo abierto con una conexión de respaldo y conciliar cada ejecución cuando vuelva el servicio. Una automatización como PickMyTrade no mantendrá en línea los servidores de Tradovate, pero hace mucho menos penoso montar una cobertura y cuadrar después." },
    {
      type: "checklist",
      heading: "Lista de comprobación rápida para una caída de Tradovate en la apertura del mercado",
      items: [
        "<strong class='text-white'>Consulte primero la página de estado.</strong> Abra el estado oficial del servicio en status.tradovate.com (o la vista Service Status de la plataforma) antes de tocar una sola orden. Si hay componentes caídos, no es su configuración.",
        "<strong class='text-white'>No sature con inicios de sesión o reintentos.</strong> Bombardear la aplicación o la API durante una caída puede provocar un 429 &ldquo;Too Many Requests&rdquo; o un bloqueo por captcha además de la caída que ya tiene.",
        "<strong class='text-white'>Reduzca el riesgo abierto con un broker de respaldo.</strong> Si mantiene posiciones, cúbralas o ciérrelas mediante un segundo broker o DOM en lugar de esperar a la aplicación congelada.",
        "<strong class='text-white'>Asuma que las órdenes están en un estado desconocido.</strong> Un stop que parece &ldquo;working&rdquo; puede no estar activo, y una orden &ldquo;cancelled&rdquo; aún puede ejecutarse. Trate todo como no confirmado.",
        "<strong class='text-white'>Concilie las ejecuciones tras la recuperación.</strong> Compare los módulos Orders y Positions con su estado previsto en cuanto la plataforma vuelva.",
        "<strong class='text-white'>Haga capturas de todo.</strong> Las marcas de tiempo, los textos de error y las posiciones le dan la evidencia que necesita si tiene que disputar una ejecución o abrir un ticket de soporte.",
      ],
    },
    { type: "heading",text: "Cómo es realmente una caída de Tradovate en la apertura del mercado" },
    { type: "paragraph",html: "Las caídas no siempre se anuncian con un banner limpio de &ldquo;la plataforma está caída&rdquo;. Con más frecuencia se produce un fallo parcial: el gráfico aún se actualiza pero el DOM no acepta clics, o las órdenes quedan como &ldquo;Pending&rdquo; y nunca se confirman, o le devuelven a una pantalla de inicio de sesión que gira sin fin. Los síntomas habituales en pantalla son un indicador &ldquo;Disconnected&rdquo; persistente, un mensaje &ldquo;Internal Server Error&rdquo; tras un congelamiento, un aviso &ldquo;Trading has temporarily halted&rdquo; y cotizaciones que dejan de moverse mientras el reloj sigue avanzando." },
    { type: "paragraph",html: "Lo peligroso es la brecha entre lo que muestra su pantalla y lo que realmente tiene el mercado. Durante una caída puede ver cómo un take-profit y un stop-loss no se activan, y luego descubrir que órdenes que creía canceladas se habían ejecutado igualmente. Así es como termina con una docena o más de contratos no deseados procedentes de órdenes que creía muertas. Cuando el front-end y el motor de casamiento discrepan, acaba en una posición que nunca pretendió mantener." },
    { type: "heading",text: "Principales causas de las caídas de Tradovate en la apertura en 2026" },
    { type: "heading",text: "1. Picos de carga en la apertura de contado" },
    { type: "paragraph",html: "La apertura de renta variable de las 9:30 ET (y las publicaciones de datos de las 8:30 ET justo antes) comprimen un enorme flujo de órdenes en unos pocos segundos. Los servicios de front-end, ejecución y datos de mercado se disparan a la vez, y si cualquier capa se satura, la plataforma se degrada. Por eso las caídas se agrupan en torno a la apertura y a las noticias programadas en lugar de producirse al azar." },
    { type: "heading",text: "2. Caídas del feed de datos de mercado" },
    { type: "paragraph",html: "Cuando el feed de datos del CME tiene un fallo o el componente de datos de mercado de Tradovate se degrada, los símbolos dejan de moverse y verá &ldquo;No Quote Available&rdquo;. Como las comprobaciones de riesgo de la plataforma dependen de una cotización en vivo, una caída de datos puede desencadenar rechazos de órdenes aunque la ejecución en sí esté técnicamente operativa." },
    { type: "heading",text: "3. Degradación del enrutamiento de órdenes y del servicio de ejecución" },
    { type: "paragraph",html: "Los componentes Execution y Risk &amp; Routing pueden degradarse con independencia de los gráficos. Es el clásico escenario de &ldquo;los gráficos se ven bien pero no me ejecutan&rdquo;. Las órdenes se encolan, quedan pendientes o se rechazan mientras el resto de la pantalla parece perfectamente normal." },
    { type: "heading",text: "4. Órdenes fantasma y posiciones atascadas" },
    { type: "paragraph",html: "Durante una caída, el front-end puede perder la sincronización con el back-end. Las órdenes que cancela pueden no cancelarse realmente en el servidor, y es posible que las ejecuciones nunca se muestren. Cuando se restablece la conectividad, esas órdenes &ldquo;fantasma&rdquo; pueden ejecutarse y dejarle en una posición sorpresa. Es el modo de fallo más caro de una caída en la apertura." },
    { type: "heading",text: "5. Saturación de la cola de soporte" },
    { type: "paragraph",html: "Como las caídas afectan a todos a la vez, el Trade Desk y los canales de soporte se saturan al instante. Puede esperar en línea solo para acabar en un buzón de voz que ya está lleno, lo que significa que el respaldo humano con el que contaría para cerrar posiciones suele ser inalcanzable justo cuando más lo necesita." },
    { type: "heading",text: "Cómo solucionar (y sobrevivir a) una caída de Tradovate: paso a paso" },
    { type: "heading",text: "Confirme que es Tradovate, no su configuración" },
    { type: "paragraph",html: "Antes de reinstalar nada o hacer clic presa del pánico, verifique que la caída es del lado del servidor." },
    {
      type: "steps",
      items: [
        { title: "Abra la página de estado", html: "Abra <strong class='text-white'>status.tradovate.com</strong> en un navegador. Un dispositivo aparte o su teléfono es lo ideal si su escritorio está congelado." },
        { title: "Revise la lista de componentes", html: "Revise la lista de componentes. Frontend, Execution, Risk &amp; Routing y Market Data son los que importan para el flujo de órdenes." },
        { title: "Contraste con otras fuentes", html: "Contraste la vista <strong class='text-white'>Service Status</strong> de la plataforma y un rastreador de terceros para no depender de una sola fuente." },
        { title: "Deje de solucionar problemas en local", html: "Si los componentes aparecen degradados o caídos, deje de revisar su propio equipo. Nada local arreglará una caída del lado del servidor." },
      ],
    },
    { type: "heading",text: "Reduzca el riesgo abierto de inmediato con una conexión de respaldo" },
    { type: "paragraph",html: "Esta es exactamente la razón por la que los traders de futuros experimentados mantienen una segunda vía al mercado. Si Tradovate es inutilizable y usted mantiene tamaño:" },
    {
      type: "steps",
      items: [
        { title: "Abra su vía de respaldo", html: "Abra su broker de respaldo o un segundo DOM que no se enrute por el mismo servicio que falla." },
        { title: "Cubra o cierre", html: "Cubra la exposición con una posición opuesta equivalente en un contrato correlacionado o idéntico, o cierre por completo." },
        { title: "No reenvíe a la aplicación congelada", html: "<strong class='text-white'>No</strong> siga reenviando órdenes a la aplicación congelada de Tradovate. Las órdenes duplicadas son exactamente cómo se producen las ejecuciones fantasma cuando se recupera." },
      ],
    },
    { type: "heading",text: "Concilie las ejecuciones en cuanto la plataforma vuelva" },
    { type: "paragraph",html: "La recuperación es la ventana de mayor riesgo, no la segura." },
    {
      type: "steps",
      items: [
        { title: "Abra Orders y Positions juntos", html: "Abra el módulo <strong class='text-white'>Orders</strong> y el módulo <strong class='text-white'>Positions</strong> uno junto al otro." },
        { title: "Compare con su intención", html: "Compare las posiciones abiertas y las órdenes activas reales con lo que usted <em>pretendía</em>. Busque específicamente órdenes que creía canceladas y ejecuciones que nunca vio producirse." },
        { title: "Cancele las órdenes huérfanas", html: "Cancele cualquier orden activa huérfana o duplicada, como un objetivo suelto que quedó tras un stop." },
        { title: "Reanude solo cuando esté plano y conciliado", html: "Solo cuando la cuenta coincida con su estado previsto debe reanudar la operativa." },
      ],
    },
    { type: "heading",text: "Cierre limpiamente al reconectar si algo parece incorrecto" },
    { type: "paragraph",html: "Si la conciliación revela una posición que no desea, cuádrela deliberadamente en lugar de apilar más órdenes." },
    {
      type: "steps",
      items: [
        { title: "Use flatten / close all", html: "Use el control <strong class='text-white'>flatten / close all</strong> a nivel de cuenta para salir de las posiciones abiertas y cancelar las órdenes activas en una sola acción." },
        { title: "Confirme que está plano", html: "Confirme que el módulo Positions muestra plano antes de apartarse." },
        { title: "Guarde la evidencia", html: "Haga una captura del estado plano y de la marca de tiempo por si necesita presentar una disputa de ejecución más adelante." },
      ],
    },
    { type: "heading",text: "Tabla de solución de problemas" },
    { type: "table", headers: ["Error / síntoma","Qué significa","Solución rápida"], rows: [
      ["&ldquo;Disconnected&rdquo; / inicio de sesión que gira sin fin","Su sesión perdió el servidor; la plataforma puede estar degradada","Consulte status.tradovate.com; espere y reintente una vez, no sature con inicios de sesión"],
      ["&ldquo;Internal Server Error&rdquo; tras un congelamiento","Fallo del lado del servidor, normalmente durante una ventana de caída","Espere a que se resuelva el incidente y luego concilie las posiciones al reconectar"],
      ["&ldquo;Trading has temporarily halted&rdquo;","La entrada de órdenes está en pausa del lado de la plataforma o del instrumento","No fuerce reintentos; confirme en la página de estado y gestione el riesgo en otro lugar"],
      ["&ldquo;No Quote Available&rdquo;","El feed de datos de mercado cayó, por lo que las comprobaciones de riesgo no pueden liberar la orden","Espere a que se restablezcan los datos; una cotización obsoleta seguirá rechazando órdenes"],
      ["Stops/objetivos que no se activan","Ejecución o enrutamiento degradados; puede que la orden no esté activa","Cubra o cierre mediante una conexión de respaldo; verifique cada orden tras la recuperación"],
      ["Las órdenes que canceló se ejecutan igualmente (órdenes fantasma)","El front-end perdió la sincronización con el motor de casamiento","Detenga nuevas entradas; concilie Orders con Positions y cancele las huérfanas de inmediato"],
      ["&ldquo;429 Too Many Requests&rdquo; durante los reintentos","Usted (o sus herramientas) alcanzó el límite de frecuencia al martillear la aplicación","Retroceda; espere a que termine el enfriamiento antes de volver a intentarlo"],
    ] },
    { type: "heading",text: "Evite esto con PickMyTrade" },
    { type: "paragraph",html: "Ningún puente puede mantener en línea los servidores de Tradovate. Pero la mayor parte del daño de una caída en la apertura es <em>autoinfligido</em>: reintentos duplicados, una posición sin cobertura y una aplicación de escritorio congelada. Esa es la parte que la automatización puede quitarle de encima." },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Enrutamiento multibroker.</strong> Envíe la misma alerta de TradingView a una conexión de broker de respaldo para que una caída de Tradovate no le deje sin cobertura en la apertura.",
        "<strong class='text-white'>Ejecución en el servidor.</strong> Las alertas se disparan desde los servidores de PickMyTrade, no desde su escritorio congelado, de modo que un fallo de la aplicación local no descarta silenciosamente su automatización.",
        "<strong class='text-white'>Enrutamiento seguro ante límites de frecuencia.</strong> Las colas en el servidor espacian el flujo de órdenes y evitan los bloqueos 429 autoinfligidos que se acumulan cuando reintenta frenéticamente durante la caída.",
        "<strong class='text-white'>Sincronización multicuenta.</strong> Replique un cierre correctivo en todas las cuentas conectadas a la vez en lugar de cuadrar un inicio de sesión tras otro.",
      ],
    },
    { type: "paragraph",html: "Combine eso con un broker de respaldo y una conciliación disciplinada tras la caída, y una caída en la apertura se convierte en una molestia en lugar de en una cuenta quemada." },
  ], fr: [
    { type: "paragraph",html: "Quand l'ES et le NQ s'envolent à l'ouverture au comptant de 9:30 ET, une panne Tradovate est le pire moment possible pour perdre votre plateforme. Vous ne pouvez ni entrer ni clôturer, et la ligne du support est déjà saturée par tous les autres traders coincés dans la même situation. Ce n'est pas non plus un cas limite rare. Les incidents de connectivité Tradovate s'accumulent au fil de l'année, et l'indisponibilité va généralement de quelques minutes à environ une heure, le plus souvent regroupée autour des séances les plus actives." },
    { type: "paragraph",html: "Que la plateforme soit totalement hors service, bloquée sur &ldquo;Disconnected&rdquo;, refuse d'exécuter les stops ou exécute discrètement des ordres que vous pensiez annulés, la marche à suivre ne change pas : confirmer que cela vient du côté de Tradovate, protéger votre risque ouvert avec une connexion de secours et rapprocher chaque exécution une fois le service rétabli. Une automatisation comme PickMyTrade ne maintiendra pas les serveurs de Tradovate en ligne, mais elle rend beaucoup moins pénible la mise en place d'une couverture et le rééquilibrage ensuite." },
    {
      type: "checklist",
      heading: "Check-list rapide pour une panne Tradovate à l'ouverture du marché",
      items: [
        "<strong class='text-white'>Consultez d'abord la page de statut.</strong> Ouvrez le statut officiel du service sur status.tradovate.com (ou la vue Service Status de la plateforme) avant de toucher le moindre ordre. Si des composants sont hors service, ce n'est pas votre installation.",
        "<strong class='text-white'>Ne spammez pas les connexions ni les nouvelles tentatives.</strong> Marteler l'application ou l'API pendant une panne peut déclencher un 429 &ldquo;Too Many Requests&rdquo; ou un blocage par captcha en plus de la panne que vous subissez déjà.",
        "<strong class='text-white'>Réduisez le risque ouvert sur un courtier de secours.</strong> Si vous détenez des positions, couvrez-les ou clôturez-les via un second courtier ou DOM plutôt que d'attendre l'application figée.",
        "<strong class='text-white'>Supposez que les ordres sont dans un état inconnu.</strong> Un stop qui semble &ldquo;working&rdquo; peut ne pas être actif, et un ordre &ldquo;cancelled&rdquo; peut quand même s'exécuter. Considérez tout comme non confirmé.",
        "<strong class='text-white'>Rapprochez les exécutions après la reprise.</strong> Comparez les modules Orders et Positions à l'état que vous aviez prévu dès que la plateforme est de retour.",
        "<strong class='text-white'>Faites des captures d'écran de tout.</strong> Les horodatages, les textes d'erreur et les positions vous donnent les preuves nécessaires si vous devez contester une exécution ou ouvrir un ticket de support.",
      ],
    },
    { type: "heading",text: "À quoi ressemble réellement une panne Tradovate à l'ouverture du marché" },
    { type: "paragraph",html: "Les pannes ne s'annoncent pas toujours par une bannière claire &ldquo;la plateforme est hors service&rdquo;. Le plus souvent, il s'agit d'une défaillance partielle : le graphique se met encore à jour mais le DOM n'accepte pas les clics, ou les ordres restent &ldquo;Pending&rdquo; sans jamais être confirmés, ou vous êtes renvoyé vers un écran de connexion qui tourne indéfiniment. Les symptômes habituels à l'écran sont un indicateur &ldquo;Disconnected&rdquo; persistant, un message &ldquo;Internal Server Error&rdquo; après un gel, un avis &ldquo;Trading has temporarily halted&rdquo; et des cotations qui cessent de bouger alors que l'horloge continue d'avancer." },
    { type: "paragraph",html: "Le danger vient de l'écart entre ce que montre votre écran et ce que la bourse a réellement. Pendant une panne, vous pouvez voir un take-profit et un stop-loss ne pas se déclencher, puis découvrir que des ordres que vous pensiez annulés avaient bien été exécutés. C'est ainsi que vous vous retrouvez avec une douzaine de contrats indésirables, voire plus, issus d'ordres que vous croyiez morts. Quand le front-end et le moteur d'appariement ne sont pas d'accord, vous vous retrouvez dans une position que vous n'avez jamais voulu détenir." },
    { type: "heading",text: "Principales causes des pannes de Tradovate à l'ouverture en 2026" },
    { type: "heading",text: "1. Pics de charge à l'ouverture au comptant" },
    { type: "paragraph",html: "L'ouverture des actions à 9:30 ET (et les publications de données de 8:30 ET juste avant) concentrent un énorme flux d'ordres en quelques secondes. Les services front-end, d'exécution et de données de marché montent en pic simultanément, et si une couche sature, la plateforme se dégrade. C'est pourquoi les pannes se regroupent autour de l'ouverture et des annonces programmées plutôt que de survenir au hasard." },
    { type: "heading",text: "2. Coupures du flux de données de marché" },
    { type: "paragraph",html: "Lorsque le flux de données du CME a un hoquet ou que le composant de données de marché de Tradovate se dégrade, les symboles cessent de bouger et vous voyez &ldquo;No Quote Available&rdquo;. Comme les contrôles de risque de la plateforme dépendent d'une cotation en direct, une coupure de données peut provoquer en cascade des rejets d'ordres même si l'exécution elle-même est techniquement opérationnelle." },
    { type: "heading",text: "3. Dégradation du routage des ordres et du service d'exécution" },
    { type: "paragraph",html: "Les composants Execution et Risk &amp; Routing peuvent se dégrader indépendamment des graphiques. C'est le scénario classique &ldquo;les graphiques ont l'air bien mais je ne suis pas exécuté&rdquo;. Les ordres s'empilent, restent en attente ou sont rejetés alors que le reste de l'écran paraît parfaitement normal." },
    { type: "heading",text: "4. Ordres fantômes et positions bloquées" },
    { type: "paragraph",html: "Pendant une panne, le front-end peut perdre la synchronisation avec le back-end. Les ordres que vous annulez peuvent ne pas être réellement annulés côté serveur, et les exécutions peuvent ne jamais s'afficher. Lorsque la connectivité est rétablie, ces ordres &ldquo;fantômes&rdquo; peuvent s'exécuter et vous placer dans une position surprise. C'est le mode de défaillance le plus coûteux d'une panne à l'ouverture." },
    { type: "heading",text: "5. Saturation de la file d'attente du support" },
    { type: "paragraph",html: "Comme les pannes touchent tout le monde en même temps, le Trade Desk et les canaux de support sont submergés instantanément. Vous pouvez attendre en ligne pour finir dans une messagerie vocale déjà pleine, ce qui signifie que le filet de sécurité humain sur lequel vous comptiez pour être clôturé est souvent injoignable précisément quand vous en avez besoin." },
    { type: "heading",text: "Comment corriger (et survivre à) une panne Tradovate : pas à pas" },
    { type: "heading",text: "Confirmer que c'est Tradovate, pas votre installation" },
    { type: "paragraph",html: "Avant de réinstaller quoi que ce soit ou de cliquer par panique, vérifiez que la panne est côté serveur." },
    {
      type: "steps",
      items: [
        { title: "Ouvrir la page de statut", html: "Ouvrez <strong class='text-white'>status.tradovate.com</strong> dans un navigateur. Un appareil distinct ou votre téléphone est idéal si votre poste est figé." },
        { title: "Consulter la liste des composants", html: "Consultez la liste des composants. Frontend, Execution, Risk &amp; Routing et Market Data sont ceux qui comptent pour le flux d'ordres." },
        { title: "Recouper avec d'autres sources", html: "Recoupez avec la vue <strong class='text-white'>Service Status</strong> de la plateforme et un outil de suivi tiers afin de ne pas dépendre d'une seule source." },
        { title: "Cesser le dépannage local", html: "Si des composants apparaissent dégradés ou hors service, cessez de dépanner votre propre machine. Rien de local ne corrigera une panne côté serveur." },
      ],
    },
    { type: "heading",text: "Réduire immédiatement le risque ouvert avec une connexion de secours" },
    { type: "paragraph",html: "C'est exactement la raison pour laquelle les traders de contrats à terme expérimentés gardent une seconde voie vers le marché. Si Tradovate est inutilisable et que vous détenez de la taille :" },
    {
      type: "steps",
      items: [
        { title: "Ouvrir votre voie de secours", html: "Ouvrez votre courtier de secours ou un second DOM qui n'est pas acheminé par le même service défaillant." },
        { title: "Couvrir ou clôturer", html: "Couvrez l'exposition avec une position opposée équivalente sur un contrat corrélé ou identique, ou clôturez purement et simplement." },
        { title: "Ne pas renvoyer vers l'application figée", html: "Ne continuez <strong class='text-white'>pas</strong> à renvoyer des ordres vers l'application Tradovate figée. Les ordres en double sont exactement la façon dont naissent les exécutions fantômes lors de la reprise." },
      ],
    },
    { type: "heading",text: "Rapprocher les exécutions dès que la plateforme est de retour" },
    { type: "paragraph",html: "La reprise est la fenêtre la plus risquée, pas la plus sûre." },
    {
      type: "steps",
      items: [
        { title: "Ouvrir Orders et Positions ensemble", html: "Ouvrez le module <strong class='text-white'>Orders</strong> et le module <strong class='text-white'>Positions</strong> côte à côte." },
        { title: "Comparer à votre intention", html: "Comparez les positions ouvertes et les ordres actifs réels à ce que vous <em>aviez prévu</em>. Cherchez en particulier les ordres que vous pensiez annulés et les exécutions que vous n'avez jamais vues se produire." },
        { title: "Annuler les ordres orphelins", html: "Annulez tout ordre actif orphelin ou en double, comme un objectif laissé derrière après un stop." },
        { title: "Reprendre seulement une fois à plat et conforme", html: "Ne reprenez le trading que lorsque le compte correspond à l'état que vous aviez prévu." },
      ],
    },
    { type: "heading",text: "Clôturer proprement à la reconnexion si quelque chose semble anormal" },
    { type: "paragraph",html: "Si le rapprochement révèle une position que vous ne voulez pas, soldez-la délibérément plutôt que d'empiler d'autres ordres." },
    {
      type: "steps",
      items: [
        { title: "Utiliser flatten / close all", html: "Utilisez la commande <strong class='text-white'>flatten / close all</strong> au niveau du compte pour sortir des positions ouvertes et annuler les ordres actifs en une seule action." },
        { title: "Confirmer que vous êtes à plat", html: "Confirmez que le module Positions indique à plat avant de vous éloigner." },
        { title: "Conserver les preuves", html: "Capturez une copie d'écran de l'état à plat et de l'horodatage au cas où vous auriez besoin d'ouvrir un litige sur une exécution plus tard." },
      ],
    },
    { type: "heading",text: "Tableau de dépannage" },
    { type: "table", headers: ["Erreur / symptôme","Ce que cela signifie","Correctif rapide"], rows: [
      ["&ldquo;Disconnected&rdquo; / connexion qui tourne indéfiniment","Votre session a perdu le serveur ; la plateforme est peut-être dégradée","Consultez status.tradovate.com ; attendez et réessayez une fois, ne spammez pas les connexions"],
      ["&ldquo;Internal Server Error&rdquo; après un gel","Défaut côté serveur, généralement pendant une fenêtre de panne","Attendez la fin de l'incident, puis rapprochez les positions à la reconnexion"],
      ["&ldquo;Trading has temporarily halted&rdquo;","La saisie d'ordres est suspendue côté plateforme ou instrument","Ne forcez pas les nouvelles tentatives ; confirmez sur la page de statut et gérez le risque ailleurs"],
      ["&ldquo;No Quote Available&rdquo;","Le flux de données de marché est tombé, les contrôles de risque ne peuvent donc pas valider l'ordre","Attendez le rétablissement des données ; une cotation périmée continuera de rejeter les ordres"],
      ["Stops/objectifs qui ne se déclenchent pas","Exécution ou routage dégradé ; l'ordre n'est peut-être pas actif","Couvrez ou clôturez via une connexion de secours ; vérifiez chaque ordre après la reprise"],
      ["Des ordres que vous avez annulés s'exécutent quand même (ordres fantômes)","Le front-end a perdu la synchronisation avec le moteur d'appariement","Arrêtez les nouvelles entrées ; rapprochez Orders et Positions et annulez immédiatement les orphelins"],
      ["&ldquo;429 Too Many Requests&rdquo; pendant les nouvelles tentatives","Vous (ou vos outils) avez atteint la limite de débit en martelant l'application","Levez le pied ; attendez la fin du délai de refroidissement avant de réessayer"],
    ] },
    { type: "heading",text: "Évitez cela avec PickMyTrade" },
    { type: "paragraph",html: "Aucune passerelle ne peut maintenir les serveurs de Tradovate en ligne. Mais l'essentiel des dégâts d'une panne à l'ouverture est <em>auto-infligé</em> : nouvelles tentatives en double, position non couverte et application de bureau figée. C'est la part que l'automatisation peut vous retirer." },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Routage multi-courtiers.</strong> Envoyez la même alerte TradingView vers une connexion de courtier de secours afin qu'une panne Tradovate ne vous laisse pas sans couverture à l'ouverture.",
        "<strong class='text-white'>Exécution côté serveur.</strong> Les alertes partent des serveurs de PickMyTrade, pas de votre poste figé, de sorte qu'un plantage de l'application locale n'abandonne pas silencieusement votre automatisation.",
        "<strong class='text-white'>Routage respectueux des limites de débit.</strong> La mise en file d'attente côté serveur espace le flux d'ordres et évite les blocages 429 auto-infligés qui s'accumulent lorsque vous réessayez frénétiquement pendant la panne.",
        "<strong class='text-white'>Synchronisation multi-comptes.</strong> Répliquez une clôture corrective sur tous les comptes connectés à la fois, au lieu de solder une connexion à la fois.",
      ],
    },
    { type: "paragraph",html: "Associez cela à un courtier de secours et à un rapprochement discipliné après la panne, et une panne à l'ouverture devient un désagrément plutôt qu'un compte anéanti." },
  ], it: [
    { type: "paragraph",html: "Quando ES e NQ volano all'apertura cash delle 9:30 ET, un'interruzione di Tradovate è il peggior momento possibile per perdere la piattaforma. Non può entrare, non può chiudere, e la linea del supporto è già intasata da tutti gli altri trader bloccati nella stessa situazione. Non è nemmeno un caso limite raro. Gli incidenti di connettività di Tradovate si accumulano nel corso di un anno, e l'indisponibilità tende ad andare da pochi minuti a circa un'ora, di solito concentrata nelle sessioni più trafficate." },
    { type: "paragraph",html: "Che la piattaforma sia completamente giù, bloccata su &ldquo;Disconnected&rdquo;, rifiuti di eseguire gli stop o esegua silenziosamente ordini che credeva annullati, il piano non cambia: confermare che il problema è lato Tradovate, proteggere il rischio aperto con una connessione di riserva e riconciliare ogni esecuzione quando il servizio torna. Un'automazione come PickMyTrade non terrà online i server di Tradovate, ma rende molto meno penoso impostare una copertura e riallinearsi dopo." },
    {
      type: "checklist",
      heading: "Checklist rapida per un'interruzione di Tradovate all'apertura del mercato",
      items: [
        "<strong class='text-white'>Controlli prima la pagina di stato.</strong> Apra lo stato ufficiale del servizio su status.tradovate.com (o la vista Service Status della piattaforma) prima di toccare un solo ordine. Se alcuni componenti sono giù, non è la Sua configurazione.",
        "<strong class='text-white'>Non invii a raffica login o nuovi tentativi.</strong> Martellare l'app o l'API durante un'interruzione può scatenare un 429 &ldquo;Too Many Requests&rdquo; o un blocco captcha oltre all'interruzione già in corso.",
        "<strong class='text-white'>Riduca il rischio aperto su un broker di riserva.</strong> Se detiene posizioni, le copra o le chiuda tramite un secondo broker o DOM anziché attendere l'app bloccata.",
        "<strong class='text-white'>Presuma che gli ordini siano in uno stato sconosciuto.</strong> Uno stop che sembra &ldquo;working&rdquo; potrebbe non essere attivo, e un ordine &ldquo;cancelled&rdquo; potrebbe comunque essere eseguito. Consideri tutto come non confermato.",
        "<strong class='text-white'>Riconcili le esecuzioni dopo il ripristino.</strong> Confronti i moduli Orders e Positions con lo stato che intendeva non appena la piattaforma torna.",
        "<strong class='text-white'>Faccia screenshot di tutto.</strong> Timestamp, testi di errore e posizioni Le forniscono le prove necessarie se deve contestare un'esecuzione o aprire un ticket di supporto.",
      ],
    },
    { type: "heading",text: "Come si presenta davvero un'interruzione di Tradovate all'apertura del mercato" },
    { type: "paragraph",html: "Le interruzioni non si annunciano sempre con un banner pulito &ldquo;la piattaforma è giù&rdquo;. Più spesso si verifica un guasto parziale: il grafico si aggiorna ancora ma il DOM non accetta clic, oppure gli ordini restano &ldquo;Pending&rdquo; e non vengono mai confermati, oppure viene riportato a una schermata di login che gira all'infinito. I sintomi abituali sullo schermo sono un indicatore &ldquo;Disconnected&rdquo; persistente, un messaggio &ldquo;Internal Server Error&rdquo; dopo un blocco, un avviso &ldquo;Trading has temporarily halted&rdquo; e quotazioni che smettono di muoversi mentre l'orologio continua ad avanzare." },
    { type: "paragraph",html: "La parte pericolosa è il divario tra ciò che mostra il Suo schermo e ciò che la borsa ha realmente. Durante un'interruzione può vedere un take-profit e uno stop-loss non attivarsi, per poi scoprire che ordini che credeva annullati erano stati eseguiti comunque. È così che si ritrova con una dozzina e più di contratti indesiderati da ordini che pensava morti. Quando il front-end e il matching engine non concordano, finisce in una posizione che non intendeva mai detenere." },
    { type: "heading",text: "Principali cause delle interruzioni di Tradovate all'apertura nel 2026" },
    { type: "heading",text: "1. Picchi di carico all'apertura cash" },
    { type: "paragraph",html: "L'apertura azionaria delle 9:30 ET (e le pubblicazioni di dati delle 8:30 ET appena prima) comprimono un enorme flusso di ordini in pochi secondi. I servizi di front-end, esecuzione e dati di mercato schizzano insieme, e se un livello si satura la piattaforma si degrada. Ecco perché le interruzioni si concentrano attorno all'apertura e alle notizie programmate anziché verificarsi a caso." },
    { type: "heading",text: "2. Cadute del feed dei dati di mercato" },
    { type: "paragraph",html: "Quando il feed dati del CME ha un intoppo o il componente dati di mercato di Tradovate si degrada, i simboli smettono di muoversi e vedrà &ldquo;No Quote Available&rdquo;. Poiché i controlli di rischio della piattaforma dipendono da una quotazione in tempo reale, una caduta dei dati può innescare rifiuti di ordini anche quando l'esecuzione stessa è tecnicamente attiva." },
    { type: "heading",text: "3. Degrado del routing degli ordini e del servizio di esecuzione" },
    { type: "paragraph",html: "I componenti Execution e Risk &amp; Routing possono degradarsi indipendentemente dai grafici. È il classico scenario &ldquo;i grafici sembrano a posto ma non vengo eseguito&rdquo;. Gli ordini si accodano, restano in sospeso o vengono rifiutati mentre il resto dello schermo appare perfettamente normale." },
    { type: "heading",text: "4. Ordini fantasma e posizioni bloccate" },
    { type: "paragraph",html: "Durante un'interruzione il front-end può perdere la sincronizzazione con il back-end. Gli ordini che annulla potrebbero non essere realmente annullati lato server, e le esecuzioni potrebbero non essere mai visualizzate. Quando la connettività viene ripristinata, quegli ordini &ldquo;fantasma&rdquo; possono essere eseguiti e farLa finire in una posizione a sorpresa. È la modalità di guasto più costosa di un'interruzione all'apertura." },
    { type: "heading",text: "5. Saturazione della coda del supporto" },
    { type: "paragraph",html: "Poiché le interruzioni colpiscono tutti contemporaneamente, il Trade Desk e i canali di supporto vengono sommersi all'istante. Può restare in attesa solo per finire in una casella vocale già piena, il che significa che la rete di sicurezza umana su cui contava per chiudere è spesso irraggiungibile proprio quando ne ha bisogno." },
    { type: "heading",text: "Come risolvere (e sopravvivere a) un'interruzione di Tradovate: passo dopo passo" },
    { type: "heading",text: "Confermare che è Tradovate, non la Sua configurazione" },
    { type: "paragraph",html: "Prima di reinstallare qualsiasi cosa o di cliccare in preda al panico, verifichi che l'interruzione sia lato server." },
    {
      type: "steps",
      items: [
        { title: "Aprire la pagina di stato", html: "Apra <strong class='text-white'>status.tradovate.com</strong> in un browser. Un dispositivo separato o il Suo smartphone è ideale se il desktop è bloccato." },
        { title: "Controllare l'elenco dei componenti", html: "Controlli l'elenco dei componenti. Frontend, Execution, Risk &amp; Routing e Market Data sono quelli che contano per il flusso degli ordini." },
        { title: "Incrociare altre fonti", html: "Incroci la vista <strong class='text-white'>Service Status</strong> della piattaforma e un tracker di terze parti, così da non affidarsi a una sola fonte." },
        { title: "Smettere di fare troubleshooting in locale", html: "Se i componenti risultano degradati o giù, smetta di fare troubleshooting sulla Sua macchina. Nulla di locale risolverà un'interruzione lato server." },
      ],
    },
    { type: "heading",text: "Ridurre subito il rischio aperto con una connessione di riserva" },
    { type: "paragraph",html: "È esattamente per questo che i trader di futures esperti mantengono una seconda via verso il mercato. Se Tradovate è inutilizzabile e detiene size:" },
    {
      type: "steps",
      items: [
        { title: "Aprire la via di riserva", html: "Apra il Suo broker di riserva o un secondo DOM che non passi attraverso lo stesso servizio in difficoltà." },
        { title: "Coprire o chiudere", html: "Copra l'esposizione con una posizione opposta corrispondente su un contratto correlato o identico, oppure chiuda del tutto." },
        { title: "Non reinviare all'app bloccata", html: "<strong class='text-white'>Non</strong> continui a reinviare ordini all'app Tradovate bloccata. Gli ordini duplicati sono esattamente il modo in cui nascono le esecuzioni fantasma al ripristino." },
      ],
    },
    { type: "heading",text: "Riconciliare le esecuzioni non appena la piattaforma torna" },
    { type: "paragraph",html: "Il ripristino è la finestra a più alto rischio, non quella sicura." },
    {
      type: "steps",
      items: [
        { title: "Aprire Orders e Positions insieme", html: "Apra il modulo <strong class='text-white'>Orders</strong> e il modulo <strong class='text-white'>Positions</strong> affiancati." },
        { title: "Confrontare con la propria intenzione", html: "Confronti le posizioni aperte e gli ordini attivi effettivi con ciò che <em>intendeva</em>. Cerchi in particolare ordini che credeva annullati ed esecuzioni che non ha mai visto avvenire." },
        { title: "Annullare gli ordini orfani", html: "Annulli qualsiasi ordine attivo orfano o duplicato, come un target rimasto dopo uno stop." },
        { title: "Riprendere solo quando flat e allineato", html: "Solo quando il conto corrisponde allo stato che intendeva dovrebbe riprendere a operare." },
      ],
    },
    { type: "heading",text: "Chiudere in modo pulito alla riconnessione se qualcosa non torna" },
    { type: "paragraph",html: "Se la riconciliazione rivela una posizione che non vuole, la chiuda deliberatamente anziché sovrapporre altri ordini." },
    {
      type: "steps",
      items: [
        { title: "Usare flatten / close all", html: "Usi il controllo a livello di conto <strong class='text-white'>flatten / close all</strong> per uscire dalle posizioni aperte e annullare gli ordini attivi in un'unica azione." },
        { title: "Confermare il flat", html: "Confermi che il modulo Positions risulti flat prima di allontanarsi." },
        { title: "Conservare le prove", html: "Catturi uno screenshot dello stato flat e del timestamp nel caso in cui debba aprire in seguito una contestazione su un'esecuzione." },
      ],
    },
    { type: "heading",text: "Tabella di risoluzione dei problemi" },
    { type: "table", headers: ["Errore / sintomo","Cosa significa","Soluzione rapida"], rows: [
      ["&ldquo;Disconnected&rdquo; / login che gira all'infinito","La Sua sessione ha perso il server; la piattaforma potrebbe essere degradata","Controlli status.tradovate.com; attenda e riprovi una volta, non invii login a raffica"],
      ["&ldquo;Internal Server Error&rdquo; dopo un blocco","Guasto lato server, di solito durante una finestra di interruzione","Attenda la risoluzione dell'incidente, poi riconcili le posizioni alla riconnessione"],
      ["&ldquo;Trading has temporarily halted&rdquo;","L'inserimento degli ordini è in pausa lato piattaforma o strumento","Non forzi nuovi tentativi; confermi sulla pagina di stato e gestisca il rischio altrove"],
      ["&ldquo;No Quote Available&rdquo;","Il feed dati di mercato è caduto, quindi i controlli di rischio non possono liberare l'ordine","Attenda il ripristino dei dati; una quotazione obsoleta continuerà a rifiutare gli ordini"],
      ["Stop/target che non si attivano","Esecuzione o routing degradati; l'ordine potrebbe non essere attivo","Copra o chiuda tramite una connessione di riserva; verifichi ogni ordine dopo il ripristino"],
      ["Gli ordini che ha annullato vengono comunque eseguiti (ordini fantasma)","Il front-end ha perso la sincronizzazione con il matching engine","Fermi i nuovi ingressi; riconcili Orders con Positions e annulli subito gli orfani"],
      ["&ldquo;429 Too Many Requests&rdquo; durante i nuovi tentativi","Lei (o i Suoi strumenti) ha raggiunto il limite di frequenza martellando l'app","Rallenti; attenda la fine del periodo di raffreddamento prima di riprovare"],
    ] },
    { type: "heading",text: "Eviti tutto questo con PickMyTrade" },
    { type: "paragraph",html: "Nessun bridge può tenere online i server di Tradovate. Ma la maggior parte del danno di un'interruzione all'apertura è <em>autoinflitto</em>: nuovi tentativi duplicati, una posizione non coperta e un'app desktop bloccata. È la parte che l'automazione può toglierLe di mano." },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Routing multi-broker.</strong> Invii lo stesso alert di TradingView a una connessione broker di riserva, così che un'interruzione di Tradovate non La lasci scoperto all'apertura.",
        "<strong class='text-white'>Esecuzione lato server.</strong> Gli alert partono dai server di PickMyTrade, non dal Suo desktop bloccato, quindi il crash di un'app locale non fa perdere silenziosamente la Sua automazione.",
        "<strong class='text-white'>Routing sicuro rispetto ai limiti di frequenza.</strong> L'accodamento lato server distanzia il flusso degli ordini ed evita i blocchi 429 autoinflitti che si accumulano quando riprova freneticamente durante l'interruzione.",
        "<strong class='text-white'>Sincronizzazione multi-account.</strong> Replichi un flatten correttivo su tutti i conti collegati contemporaneamente invece di riallinearli un login alla volta.",
      ],
    },
    { type: "paragraph",html: "Lo abbini a un broker di riserva e a una riconciliazione disciplinata dopo l'interruzione, e un'interruzione all'apertura diventa un fastidio anziché un conto distrutto." },
  ] },
  ctaHeading: { en: "Trade Through the Next Outage", de: "Handeln Sie durch den nächsten Ausfall hindurch", es: "Opere a través de la próxima caída", fr: "Tradez malgré la prochaine panne", it: "Operi anche durante la prossima interruzione" },
  ctaText: { en: "Start your free 7-day trial, route alerts to a backup broker, and keep your automation running when Tradovate goes down at the open.", de: "Starten Sie Ihre kostenlose 7-Tage-Testphase, leiten Sie Alerts an einen Backup-Broker weiter und halten Sie Ihre Automatisierung am Laufen, wenn Tradovate bei der Eröffnung ausfällt.", es: "Comience su prueba gratuita de 7 días, enrute las alertas a un broker de respaldo y mantenga su automatización en marcha cuando Tradovate caiga en la apertura.", fr: "Commencez votre essai gratuit de 7 jours, acheminez vos alertes vers un courtier de secours et gardez votre automatisation en marche lorsque Tradovate tombe à l'ouverture.", it: "Inizi la prova gratuita di 7 giorni, instradi gli alert verso un broker di riserva e mantenga attiva la Sua automazione quando Tradovate va giù all'apertura." },
  ctaButtonText: { en: "Start Your Free 7-Day Trial", de: "Starten Sie Ihre kostenlose 7-Tage-Testphase", es: "Comience su prueba gratuita de 7 días", fr: "Commencez votre essai gratuit de 7 jours", it: "Inizi la prova gratuita di 7 giorni" },
  ctaUrl: "https://app.pickmytrade.trade/?register=true&utm_source=content&utm_medium=debugging",
  faqHeading: { en: "Frequently Asked Questions", de: "Häufig gestellte Fragen", es: "Preguntas frecuentes", fr: "Questions fréquentes", it: "Domande frequenti" },
  faqs: { en: [
    { q: "Why does Tradovate go down right at the market open?", a: "The 9:30 ET equity open and pre-open data releases concentrate huge order flow and market-data traffic into a few seconds. When the front-end, execution, or data tiers saturate under that load, the platform degrades, which is why outages cluster at the open rather than at random times." },
    { q: "How long do Tradovate outages usually last?", a: "It varies by incident. Downtime runs anywhere from a few minutes to roughly an hour, and some days bring a short outage followed by a second one. Check the official status page for the live picture rather than assuming a fixed duration." },
    { q: "Where do I check if Tradovate is actually down?", a: "Use the official status page at status.tradovate.com and the in-platform Service Status view, and cross-reference a third-party tracker. If core components (Frontend, Execution, Risk &amp; Routing, Market Data) show degraded, the problem is server-side, not your setup." },
    { q: "My stop didn't fill during an outage and I'm stuck in a position. What do I do?", a: "Reduce the risk through a backup broker or second DOM rather than waiting on the frozen app, and avoid re-sending orders into Tradovate. Once service restores, reconcile immediately and flatten deliberately if you're holding something you didn't want." },
    { q: "What are “ghost orders” and why are they dangerous?", a: "During an outage the front end can lose sync with the matching engine, so an order you cancel may not actually cancel server-side. When connectivity returns, that order can still fill, leaving you in a position you thought was closed. Always reconcile Orders against Positions after recovery." },
    { q: "Can I reach support during a market-open outage?", a: "Often not quickly. Because outages hit all users simultaneously, the Trade Desk and support channels flood, and you can face long holds and full voicemail boxes. Treat support as a slow backstop, not your primary risk control; that is what a backup connection is for." },
    { q: "Will keeping a backup broker really help?", a: "Yes. A second, independent route to the market lets you hedge or flatten open risk while Tradovate is unusable. It's the single most reliable protection against an open-time outage, because it doesn't depend on the failing platform recovering in time." },
    { q: "Does automation make outages worse or better?", a: "A well-built bridge helps. Server-side execution and rate-limit-safe queueing stop the duplicate-retry storms that cause ghost fills and 429 lockouts, and multi-broker routing lets your alerts reach a backup account. It can't keep Tradovate online, but it removes most of the self-inflicted failure modes." },
  ], de: [
    { q: "Warum fällt Tradovate genau bei der Marktöffnung aus?", a: "Die Aktieneröffnung um 9:30 ET und die Datenveröffentlichungen vor der Eröffnung bündeln enormen Order-Fluss und Marktdatenverkehr in wenigen Sekunden. Wenn Front-End-, Ausführungs- oder Datenebene unter dieser Last gesättigt sind, verschlechtert sich die Plattform – deshalb häufen sich Ausfälle bei der Eröffnung statt zu zufälligen Zeiten." },
    { q: "Wie lange dauern Tradovate-Ausfälle üblicherweise?", a: "Das hängt vom jeweiligen Vorfall ab. Die Ausfallzeit reicht von wenigen Minuten bis zu etwa einer Stunde, und an manchen Tagen folgt auf einen kurzen Ausfall ein zweiter. Prüfen Sie die offizielle Statusseite für das aktuelle Bild, statt eine feste Dauer anzunehmen." },
    { q: "Wo prüfe ich, ob Tradovate tatsächlich down ist?", a: "Nutzen Sie die offizielle Statusseite unter status.tradovate.com und die In-Platform-Ansicht Service Status und gleichen Sie sie mit einem Drittanbieter-Tracker ab. Wenn Kernkomponenten (Frontend, Execution, Risk &amp; Routing, Market Data) als beeinträchtigt angezeigt werden, liegt das Problem serverseitig und nicht an Ihrem Setup." },
    { q: "Mein Stop wurde während eines Ausfalls nicht ausgeführt, und ich stecke in einer Position fest. Was tun?", a: "Reduzieren Sie das Risiko über einen Backup-Broker oder ein zweites DOM, statt auf die eingefrorene App zu warten, und senden Sie keine Orders erneut an Tradovate. Sobald der Dienst wieder verfügbar ist, gleichen Sie sofort ab und stellen Sie gezielt glatt, wenn Sie etwas halten, das Sie nicht wollten." },
    { q: "Was sind „Geister-Orders“ und warum sind sie gefährlich?", a: "Bei einem Ausfall kann das Front-End die Synchronisation mit der Matching-Engine verlieren, sodass eine von Ihnen stornierte Order serverseitig möglicherweise gar nicht storniert wird. Kehrt die Konnektivität zurück, kann diese Order trotzdem ausgeführt werden und Sie in einer Position zurücklassen, die Sie für geschlossen hielten. Gleichen Sie nach der Wiederherstellung stets Orders gegen Positionen ab." },
    { q: "Kann ich den Support bei einem Ausfall zur Marktöffnung erreichen?", a: "Oft nicht schnell. Da Ausfälle alle Nutzer gleichzeitig treffen, werden Trade Desk und Support-Kanäle überflutet, und es kann zu langen Warteschleifen und vollen Mailboxen kommen. Betrachten Sie den Support als langsamen Notanker, nicht als Ihre primäre Risikokontrolle; dafür ist eine Backup-Verbindung da." },
    { q: "Hilft ein Backup-Broker wirklich?", a: "Ja. Ein zweiter, unabhängiger Weg zum Markt ermöglicht es Ihnen, offenes Risiko abzusichern oder glattzustellen, während Tradovate unbrauchbar ist. Es ist der zuverlässigste Schutz gegen einen Ausfall zur Eröffnung, weil er nicht davon abhängt, dass sich die ausfallende Plattform rechtzeitig erholt." },
    { q: "Macht Automatisierung Ausfälle schlimmer oder besser?", a: "Eine gut gebaute Bridge hilft. Serverseitige Ausführung und ratenlimitsichere Warteschlangen verhindern die Wiederholungsstürme, die Geister-Ausführungen und 429-Sperren verursachen, und Multi-Broker-Routing lässt Ihre Alerts ein Backup-Konto erreichen. Sie kann Tradovate nicht online halten, beseitigt aber die meisten selbstverursachten Fehlerquellen." },
  ], es: [
    { q: "¿Por qué Tradovate se cae justo en la apertura del mercado?", a: "La apertura de renta variable de las 9:30 ET y las publicaciones de datos previas concentran un enorme flujo de órdenes y de tráfico de datos de mercado en unos pocos segundos. Cuando las capas de front-end, ejecución o datos se saturan bajo esa carga, la plataforma se degrada, por lo que las caídas se agrupan en la apertura en lugar de ocurrir en momentos aleatorios." },
    { q: "¿Cuánto suelen durar las caídas de Tradovate?", a: "Varía según el incidente. El tiempo de inactividad va desde unos pocos minutos hasta aproximadamente una hora, y algunos días traen una caída corta seguida de una segunda. Consulte la página de estado oficial para ver la situación en vivo en lugar de asumir una duración fija." },
    { q: "¿Dónde compruebo si Tradovate está realmente caído?", a: "Use la página de estado oficial en status.tradovate.com y la vista Service Status dentro de la plataforma, y contraste con un rastreador de terceros. Si los componentes principales (Frontend, Execution, Risk &amp; Routing, Market Data) aparecen degradados, el problema es del servidor, no de su configuración." },
    { q: "Mi stop no se ejecutó durante una caída y estoy atrapado en una posición. ¿Qué hago?", a: "Reduzca el riesgo a través de un broker de respaldo o un segundo DOM en lugar de esperar a la aplicación congelada, y evite reenviar órdenes a Tradovate. Cuando se restablezca el servicio, concilie de inmediato y cierre deliberadamente si mantiene algo que no quería." },
    { q: "¿Qué son las «órdenes fantasma» y por qué son peligrosas?", a: "Durante una caída, el front-end puede perder la sincronización con el motor de casamiento, de modo que una orden que usted cancela puede no cancelarse realmente en el servidor. Cuando vuelve la conectividad, esa orden aún puede ejecutarse y dejarle en una posición que creía cerrada. Concilie siempre Orders con Positions después de la recuperación." },
    { q: "¿Puedo contactar con soporte durante una caída en la apertura del mercado?", a: "A menudo no con rapidez. Como las caídas afectan a todos los usuarios a la vez, el Trade Desk y los canales de soporte se saturan, y puede encontrarse con largas esperas y buzones de voz llenos. Trate el soporte como un respaldo lento, no como su control de riesgo principal; para eso sirve una conexión de respaldo." },
    { q: "¿Realmente ayuda tener un broker de respaldo?", a: "Sí. Una segunda vía independiente al mercado le permite cubrir o cerrar el riesgo abierto mientras Tradovate es inutilizable. Es la protección más fiable contra una caída en la apertura, porque no depende de que la plataforma que falla se recupere a tiempo." },
    { q: "¿La automatización empeora o mejora las caídas?", a: "Un puente bien construido ayuda. La ejecución en el servidor y las colas seguras ante límites de frecuencia evitan las tormentas de reintentos que causan ejecuciones fantasma y bloqueos 429, y el enrutamiento multibroker permite que sus alertas lleguen a una cuenta de respaldo. No puede mantener Tradovate en línea, pero elimina la mayoría de los fallos autoinfligidos." },
  ], fr: [
    { q: "Pourquoi Tradovate tombe-t-il juste à l'ouverture du marché ?", a: "L'ouverture des actions à 9:30 ET et les publications de données avant l'ouverture concentrent un énorme flux d'ordres et de trafic de données de marché en quelques secondes. Lorsque les couches front-end, d'exécution ou de données saturent sous cette charge, la plateforme se dégrade, ce qui explique que les pannes se regroupent à l'ouverture plutôt qu'à des moments aléatoires." },
    { q: "Combien de temps durent généralement les pannes de Tradovate ?", a: "Cela varie selon l'incident. L'indisponibilité va de quelques minutes à environ une heure, et certains jours apportent une courte panne suivie d'une seconde. Consultez la page de statut officielle pour la situation en direct plutôt que de supposer une durée fixe." },
    { q: "Où vérifier si Tradovate est réellement en panne ?", a: "Utilisez la page de statut officielle sur status.tradovate.com et la vue Service Status de la plateforme, et recoupez avec un outil de suivi tiers. Si les composants principaux (Frontend, Execution, Risk &amp; Routing, Market Data) apparaissent dégradés, le problème est côté serveur, pas dans votre installation." },
    { q: "Mon stop ne s'est pas exécuté pendant une panne et je suis coincé dans une position. Que faire ?", a: "Réduisez le risque via un courtier de secours ou un second DOM plutôt que d'attendre l'application figée, et évitez de renvoyer des ordres vers Tradovate. Une fois le service rétabli, rapprochez immédiatement et clôturez délibérément si vous détenez quelque chose que vous ne vouliez pas." },
    { q: "Que sont les « ordres fantômes » et pourquoi sont-ils dangereux ?", a: "Pendant une panne, le front-end peut perdre la synchronisation avec le moteur d'appariement, si bien qu'un ordre que vous annulez peut ne pas être réellement annulé côté serveur. Lorsque la connectivité revient, cet ordre peut quand même s'exécuter et vous laisser dans une position que vous pensiez fermée. Rapprochez toujours Orders et Positions après la reprise." },
    { q: "Puis-je joindre le support pendant une panne à l'ouverture du marché ?", a: "Souvent pas rapidement. Comme les pannes touchent tous les utilisateurs simultanément, le Trade Desk et les canaux de support sont saturés, et vous pouvez faire face à de longues attentes et à des messageries pleines. Considérez le support comme un filet de sécurité lent, pas comme votre contrôle de risque principal ; c'est le rôle d'une connexion de secours." },
    { q: "Un courtier de secours aide-t-il vraiment ?", a: "Oui. Une seconde voie indépendante vers le marché vous permet de couvrir ou de clôturer le risque ouvert pendant que Tradovate est inutilisable. C'est la protection la plus fiable contre une panne à l'ouverture, car elle ne dépend pas du rétablissement à temps de la plateforme défaillante." },
    { q: "L'automatisation aggrave-t-elle ou améliore-t-elle les pannes ?", a: "Une passerelle bien conçue aide. L'exécution côté serveur et la mise en file d'attente respectueuse des limites de débit évitent les tempêtes de nouvelles tentatives qui causent des exécutions fantômes et des blocages 429, et le routage multi-courtiers permet à vos alertes d'atteindre un compte de secours. Elle ne peut pas maintenir Tradovate en ligne, mais elle supprime la plupart des défaillances auto-infligées." },
  ], it: [
    { q: "Perché Tradovate va giù proprio all'apertura del mercato?", a: "L'apertura azionaria delle 9:30 ET e le pubblicazioni di dati pre-apertura concentrano un enorme flusso di ordini e di traffico di dati di mercato in pochi secondi. Quando i livelli di front-end, esecuzione o dati si saturano sotto quel carico, la piattaforma si degrada, motivo per cui le interruzioni si concentrano all'apertura anziché in momenti casuali." },
    { q: "Quanto durano di solito le interruzioni di Tradovate?", a: "Varia a seconda dell'incidente. L'indisponibilità va da pochi minuti a circa un'ora, e alcuni giorni portano un'interruzione breve seguita da una seconda. Controlli la pagina di stato ufficiale per il quadro in tempo reale anziché presumere una durata fissa." },
    { q: "Dove controllo se Tradovate è davvero fuori servizio?", a: "Usi la pagina di stato ufficiale su status.tradovate.com e la vista Service Status all'interno della piattaforma, e confronti con un tracker di terze parti. Se i componenti principali (Frontend, Execution, Risk &amp; Routing, Market Data) risultano degradati, il problema è lato server, non della Sua configurazione." },
    { q: "Il mio stop non è stato eseguito durante un'interruzione e sono bloccato in una posizione. Cosa faccio?", a: "Riduca il rischio tramite un broker di riserva o un secondo DOM anziché attendere l'app bloccata, ed eviti di reinviare ordini a Tradovate. Quando il servizio è ripristinato, riconcili subito e chiuda deliberatamente se detiene qualcosa che non voleva." },
    { q: "Cosa sono gli «ordini fantasma» e perché sono pericolosi?", a: "Durante un'interruzione il front-end può perdere la sincronizzazione con il matching engine, quindi un ordine che annulla potrebbe non essere realmente annullato lato server. Quando la connettività torna, quell'ordine può ancora essere eseguito, lasciandoLa in una posizione che credeva chiusa. Dopo il ripristino riconcili sempre Orders con Positions." },
    { q: "Posso raggiungere il supporto durante un'interruzione all'apertura del mercato?", a: "Spesso non rapidamente. Poiché le interruzioni colpiscono tutti gli utenti contemporaneamente, il Trade Desk e i canali di supporto vengono sommersi, e può trovarsi di fronte a lunghe attese e caselle vocali piene. Consideri il supporto una rete di sicurezza lenta, non il Suo controllo di rischio principale; a questo serve una connessione di riserva." },
    { q: "Un broker di riserva aiuta davvero?", a: "Sì. Una seconda via indipendente verso il mercato Le permette di coprire o chiudere il rischio aperto mentre Tradovate è inutilizzabile. È la protezione più affidabile contro un'interruzione all'apertura, perché non dipende dal fatto che la piattaforma in difficoltà si riprenda in tempo." },
    { q: "L'automazione peggiora o migliora le interruzioni?", a: "Un bridge ben costruito aiuta. L'esecuzione lato server e l'accodamento sicuro rispetto ai limiti di frequenza evitano le tempeste di nuovi tentativi che causano esecuzioni fantasma e blocchi 429, e il routing multi-broker permette ai Suoi alert di raggiungere un conto di riserva. Non può tenere online Tradovate, ma elimina la maggior parte dei guasti autoinflitti." },
  ] },
