---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "429-too-many-requests-login";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/debugging/${SLUG}`;

const META_TITLE = "Tradovate 429 'Too Many Requests' Login Lockout";
const META_DESCRIPTION =
  "Tradovate 429 'Too Many Requests' login lockout? Wait the 60-minute cooldown, stop retrying, and cut rapid logins or polling to get back in fast.";

// Short SEO title (<=60 chars) for locales where the shared h1 is too long for a SERP title.
const TITLE_OVERRIDE: Partial<Record<Locale, string>> = { es: "Bloqueo de login en Tradovate por 429 “Too Many Requests”", fr: "Tradovate : blocage de connexion 429 « Too Many Requests »", it: "Tradovate: blocco di accesso 429 “Too Many Requests”" };

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate API", de: "Tradovate API", es: "Tradovate API", fr: "Tradovate API", it: "Tradovate API" },
  h1: { en: META_TITLE, de: "Tradovate 429 &ldquo;Too Many Requests&rdquo;-Anmeldesperre", es: "Bloqueo de inicio de sesión de Tradovate por 429 &ldquo;Too Many Requests&rdquo;", fr: "Blocage de connexion Tradovate 429 &ldquo;Too Many Requests&rdquo;", it: "Blocco di accesso Tradovate 429 &ldquo;Too Many Requests&rdquo;" },
  dek: { en: "A blunt 429 &ldquo;Too Many Requests&rdquo; locks you out of Tradovate right when you need in. Here's what triggers the login lockout, how long the cooldown really lasts, and how to avoid re-tripping it.", de: "Ein schroffer 429-Fehler &ldquo;Too Many Requests&rdquo; sperrt Sie genau dann aus Tradovate aus, wenn Sie hineinmüssen. Hier erfahren Sie, was die Anmeldesperre auslöst, wie lange die Abkühlphase wirklich dauert, und wie Sie vermeiden, sie erneut auszulösen.", es: "Un tajante 429 &ldquo;Too Many Requests&rdquo; le bloquea el acceso a Tradovate justo cuando más lo necesita. Le explicamos qué desencadena el bloqueo de inicio de sesión, cuánto dura realmente el periodo de enfriamiento, y cómo evitar volver a activarlo.", fr: "Un abrupt 429 &ldquo;Too Many Requests&rdquo; vous bloque l'accès à Tradovate juste au moment où vous en avez besoin. Voici ce qui déclenche ce blocage de connexion, combien de temps dure réellement le délai de récupération, et comment éviter de le redéclencher.", it: "Un secco 429 &ldquo;Too Many Requests&rdquo; Le blocca l'accesso a Tradovate proprio quando ne ha bisogno. Ecco cosa scatena il blocco di accesso, quanto dura realmente il periodo di raffreddamento, e come evitare di farlo scattare di nuovo." },
  readTime: { en: "7 min read", de: "7 Minuten Lesezeit", es: "Lectura de 7 minutos", fr: "Lecture de 7 minutes", it: "Lettura di 7 minuti" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "You go to log in before the 2026 cash open, type your credentials, and Tradovate throws back a blunt <strong class='text-white'>429 &ldquo;Too Many Requests&rdquo;</strong>, and now you can't get in at all. It tends to strike at the worst possible moment: right after a couple of fat-fingered password attempts, or when an automation is quietly hammering the login in the background. The frustrating part? The fix is almost always the same boring one, wait out the cooldown, stop retrying, and cut whatever was flooding the connection. Here's what the Tradovate 429 too many requests error actually means, why it locks you out, and exactly how to get back in without making things worse." },
    {
      type: "checklist",
      heading: "Quick Checklist for the 429 Lockout",
      items: [
        "<strong class='text-white'>Stop logging in immediately.</strong> Every retry can extend the block, not clear it.",
        "<strong class='text-white'>Wait roughly 60 minutes.</strong> Tradovate uses a rolling ~60-minute cooldown before the counter resets.",
        "<strong class='text-white'>Double-check your username and password.</strong> Repeated wrong credentials are the number-one trigger.",
        "<strong class='text-white'>Log out everywhere else.</strong> Extra web, desktop, mobile, and TradingView sessions add reconnect &ldquo;noise.&rdquo;",
        "<strong class='text-white'>Throttle any API polling.</strong> A script calling REST endpoints every second will trip the limit fast.",
        "<strong class='text-white'>Call Tradovate support (312-283-3100)</strong> if you're locked out and need an urgent manual reset.",
      ],
    },
    { type: "heading", text: "What “Too Many Requests” (429) Means" },
    { type: "paragraph", html: "<code>429 Too Many Requests</code> is a standard HTTP status code. It's not a password error, an account ban, or a sign your account got hacked, it simply means Tradovate received more requests from your user, in a short window, than its rate limits allow, so it temporarily stops accepting new ones." },
    { type: "paragraph", html: "Two different situations produce the same message, and telling them apart saves a lot of panic:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>The TradingView login version.</strong> When you sign into TradingView using your Tradovate credentials and get &ldquo;Too many requests,&rdquo; it almost always means the TradingView-to-Tradovate login was attempted too many times, most commonly because an incorrect username or password was entered over and over. This specific error appears <strong class='text-white'>only</strong> at the TradingView login and does <strong class='text-white'>not</strong> block the native Tradovate Desktop, Web, or Mobile apps.",
        "<strong class='text-white'>The user-level / API version.</strong> Tradovate applies rate limits at the <strong class='text-white'>user</strong> level, not the app level. So if a script, bridge, or reconnect loop floods the connection with requests, the lockout can spill over and make it impossible to log into the desktop apps too. Here the culprit is request volume, not a typo.",
      ],
    },
    { type: "paragraph", html: "Either way, the cure is patience plus removing the source of the flood. Retrying during the cooldown is the single most common way traders accidentally keep themselves locked out." },
    { type: "heading", text: "Top Causes of the Tradovate 429 Lockout in 2026" },
    { type: "heading", text: "1. Repeated wrong username or password" },
    { type: "paragraph", html: "The most frequent trigger by far. A few failed login attempts in quick succession, a stale saved password, caps lock left on, or the wrong account email, is enough to hit the &ldquo;Too many requests&rdquo; wall at the TradingView login. Incorrect credentials are the likeliest cause." },
    { type: "heading", text: "2. Rapid, repeated login attempts" },
    { type: "paragraph", html: "Even with the <em>correct</em> password, spamming the login button (or an app that auto-retries the connection every few seconds) generates a burst of &ldquo;usersync&rdquo; requests. Frequent reconnections and repeated logins hit the ceiling quickly, because each one gets counted." },
    { type: "heading", text: "3. Too many concurrent sessions and devices" },
    { type: "paragraph", html: "Web, desktop, mobile, TradingView, and a bridge service all authenticating against the same Tradovate user multiply the request count. When several of them reconnect at once, say, after a Wi-Fi blip, the combined churn can trip the limit." },
    { type: "heading", text: "4. REST API polling instead of streaming" },
    { type: "paragraph", html: "For API and algo users, the classic mistake is polling a REST endpoint on a tight loop, asking for a balance or position snapshot once per second, for example. The REST API isn't built for real-time use, and that kind of polling is exactly what generates a user-level 429 that then blocks logins everywhere." },
    { type: "heading", text: "5. Hitting the hourly request ceiling" },
    { type: "paragraph", html: "Every action counts as a request: logging in, opening charts, placing, modifying, or cancelling orders, and each automated alert. Tradovate enforces an hourly request ceiling on a rolling 60-minute window, the exact figures live in Tradovate's current API documentation and vary by endpoint, so check the docs for live numbers. High-frequency activity, rapid alerts, trade-copying to several accounts, or fast module switching, burns through the allowance quickly. Copying one alert to five accounts, for instance, counts as five requests." },
    { type: "heading", text: "How to Fix the Tradovate 429 Lockout: Step-by-Step" },
    { type: "heading", text: "Fixing a Credential-Triggered Lockout" },
    {
      type: "steps",
      items: [
        { title: "Stop trying to log in", html: "Close the login tab or app. Each additional attempt during the cooldown can prolong the block." },
        { title: "Wait about 60 minutes", html: "The cooldown is a rolling ~60-minute window. If you tripped it at 2:15 PM, plan to be back in around 3:15 PM, measured from your <em>last</em> attempt, so genuinely stop hitting it." },
        { title: "Verify your credentials before the next try", html: "Confirm the exact username/email and password. If you're unsure, reset the password from the Tradovate login page so your next attempt is guaranteed correct, no more failed logins padding the counter." },
        { title: "Retry once, calmly", html: "After the cooldown, log in a single time with confirmed-correct details." },
      ],
    },
    { type: "heading", text: "Fixing a Session / Reconnect Flood" },
    {
      type: "steps",
      items: [
        { title: "Sign out of every other Tradovate session", html: "Sign out of web, desktop, mobile, and the TradingView connection, so only one client is authenticating." },
        { title: "Fix the underlying instability", html: "A dropping connection that auto-reconnects in a loop is a request generator; move to a stable wired connection and make sure your system clock is synced (clock drift alone causes repeated login rejections)." },
        { title: "Reconnect on one device only", html: "Then bring the others back one at a time rather than all at once." },
      ],
    },
    { type: "heading", text: "Fixing an API / Polling-Triggered Lockout" },
    {
      type: "steps",
      items: [
        { title: "Kill the polling loop", html: "Stop any script calling REST endpoints on a fixed interval." },
        { title: "Switch real-time data to a WebSocket", html: "Open a long-running connection to Tradovate's WebSocket server and use its <code>syncRequest</code> feature to receive real-time balance, position, and order updates, instead of repeatedly asking over REST. This is the pattern Tradovate recommends." },
        { title: "Space out and queue your calls", html: "Stay under the hourly ceiling, and back off automatically when you get a 429 rather than retrying immediately." },
      ],
    },
    { type: "heading", text: "When You Can't Wait" },
    { type: "paragraph", html: "If you're locked out mid-session and need access urgently, <strong class='text-white'>call Tradovate support at 312-283-3100</strong> (or email support with your username). They can manually reset your request limits in urgent situations, but they can't undo a limit you keep re-tripping, so make sure the flood has stopped first." },
    { type: "heading", text: "Troubleshooting Table" },
    {
      type: "table",
      headers: ["Error / symptom", "What it means", "Fix"],
      rows: [
        ["Too many requests at TradingView login", "Login attempted too many times, usually wrong credentials", "Wait ~60 min without retrying; verify/reset password"],
        ["429 Too Many Requests (HTTP)", "User-level rate limit exceeded", "Stop all requests; wait the rolling 60-minute window"],
        ["Can't log into desktop app after API errors", "A user-level 429 spilled over from API/reconnect flooding", "Stop the script/reconnect loop; wait, then log in once"],
        ["Lockout keeps coming back", "You're retrying during the cooldown", "Stop retrying entirely; the window resets from your last attempt"],
        ["Frequent reconnect + &ldquo;usersync&rdquo; spikes", "Unstable connection or multiple sessions", "Log out extra sessions; use wired network; sync system clock"],
        ["429 from a polling script", "REST endpoint polled too often", "Move real-time data to WebSocket syncRequest; queue calls"],
      ],
    },
    { type: "heading", text: "Prevent This with PickMyTrade" },
    { type: "paragraph", html: "If your lockouts come from automation, TradingView alerts firing fast, or copying to several accounts, a bridge that respects Tradovate's limits removes the whole problem. PickMyTrade sits between TradingView and Tradovate and sends order flow the way the platform wants it:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Rate-Limit-Safe Routing</strong>, spaces out and queues order flow so bursts of alerts don't slam the API into a 429.",
        "<strong class='text-white'>Single Managed Connection</strong>, one stable, persistent link to your account instead of a reconnect loop hammering the login.",
        "<strong class='text-white'>Multi-Account Sync</strong>, mirrors a trade across accounts through controlled request pacing, not five simultaneous logins.",
        "<strong class='text-white'>Qty / Symbol Validation</strong>, blocks malformed or oversized orders before they're sent, cutting wasted retry requests.",
      ],
    },
    { type: "paragraph", html: "The result: your strategy keeps firing while the connection stays quietly under the limit." },
  ], de: [
    { type: "paragraph", html: "Sie wollen sich vor dem Cash-Open 2026 anmelden, geben Ihre Zugangsdaten ein, und Tradovate wirft Ihnen einen schroffen <strong class='text-white'>429 &ldquo;Too Many Requests&rdquo;</strong> entgegen, und jetzt kommen Sie überhaupt nicht mehr hinein. Das passiert meist im ungünstigsten Moment: gleich nach ein paar vertippten Passwortversuchen, oder wenn eine Automatisierung im Hintergrund leise die Anmeldung bombardiert. Das Frustrierende daran? Die Lösung ist fast immer dieselbe langweilige, die Abkühlphase abwarten, mit dem erneuten Versuchen aufhören, und die Quelle der Flut kappen. Hier erfahren Sie, was der Tradovate-429-Fehler „Too Many Requests“ tatsächlich bedeutet, warum er Sie aussperrt, und wie Sie genau wieder hineinkommen, ohne die Lage zu verschlimmern." },
    {
      type: "checklist",
      heading: "Kurz-Checkliste für die 429-Sperre",
      items: [
        "<strong class='text-white'>Hören Sie sofort auf, sich anzumelden.</strong> Jeder weitere Versuch kann die Sperre verlängern statt sie aufzuheben.",
        "<strong class='text-white'>Warten Sie rund 60 Minuten.</strong> Tradovate nutzt eine rollierende Abkühlphase von etwa 60 Minuten, bevor der Zähler zurückgesetzt wird.",
        "<strong class='text-white'>Prüfen Sie Benutzername und Passwort genau.</strong> Wiederholt falsche Zugangsdaten sind der häufigste Auslöser.",
        "<strong class='text-white'>Melden Sie sich überall sonst ab.</strong> Zusätzliche Web-, Desktop-, Mobil- und TradingView-Sitzungen erzeugen Reconnect-„Rauschen“.",
        "<strong class='text-white'>Drosseln Sie jedes API-Polling.</strong> Ein Skript, das REST-Endpunkte jede Sekunde aufruft, löst das Limit schnell aus.",
        "<strong class='text-white'>Rufen Sie den Tradovate-Support (312-283-3100) an</strong>, falls Sie ausgesperrt sind und dringend ein manuelles Zurücksetzen benötigen.",
      ],
    },
    { type: "heading", text: "Was &ldquo;Too Many Requests&rdquo; (429) bedeutet" },
    { type: "paragraph", html: "<code>429 Too Many Requests</code> ist ein Standard-HTTP-Statuscode. Es ist kein Passwortfehler, keine Kontosperre und kein Zeichen dafür, dass Ihr Konto gehackt wurde, es bedeutet lediglich, dass Tradovate in einem kurzen Zeitfenster mehr Anfragen von Ihrem Nutzer erhalten hat, als die Ratenbegrenzung erlaubt, und deshalb vorübergehend keine neuen mehr annimmt." },
    { type: "paragraph", html: "Zwei unterschiedliche Situationen erzeugen dieselbe Meldung, und sie auseinanderzuhalten erspart viel Panik:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Die TradingView-Anmeldevariante.</strong> Wenn Sie sich mit Ihren Tradovate-Zugangsdaten bei TradingView anmelden und &ldquo;Too many requests&rdquo; erhalten, bedeutet das fast immer, dass die Anmeldung von TradingView zu Tradovate zu oft versucht wurde, meistens weil ein falscher Benutzername oder ein falsches Passwort wiederholt eingegeben wurde. Dieser spezielle Fehler tritt <strong class='text-white'>nur</strong> bei der TradingView-Anmeldung auf und blockiert die nativen Tradovate-Apps für Desktop, Web oder Mobile <strong class='text-white'>nicht</strong>.",
        "<strong class='text-white'>Die Nutzerebene / API-Variante.</strong> Tradovate wendet Ratenbegrenzungen auf <strong class='text-white'>Nutzerebene</strong> an, nicht auf App-Ebene. Wenn also ein Skript, eine Bridge oder eine Reconnect-Schleife die Verbindung mit Anfragen flutet, kann die Sperre übergreifen und auch die Anmeldung bei den Desktop-Apps unmöglich machen. Hier liegt die Ursache im Anfragevolumen, nicht in einem Tippfehler.",
      ],
    },
    { type: "paragraph", html: "So oder so besteht die Lösung aus Geduld plus dem Entfernen der Ursache der Flut. Während der Abkühlphase erneut zu versuchen ist der häufigste Weg, wie Trader sich selbst versehentlich ausgesperrt halten." },
    { type: "heading", text: "Die häufigsten Ursachen der Tradovate-429-Sperre im Jahr 2026" },
    { type: "heading", text: "1. Wiederholt falscher Benutzername oder falsches Passwort" },
    { type: "paragraph", html: "Der mit Abstand häufigste Auslöser. Ein paar fehlgeschlagene Anmeldeversuche kurz hintereinander, ein veraltetes gespeichertes Passwort, eine aktivierte Feststelltaste oder die falsche Konto-E-Mail reichen aus, um bei der TradingView-Anmeldung an die Wand &ldquo;Too many requests&rdquo; zu stoßen. Falsche Zugangsdaten sind die wahrscheinlichste Ursache." },
    { type: "heading", text: "2. Schnelle, wiederholte Anmeldeversuche" },
    { type: "paragraph", html: "Selbst mit dem <em>richtigen</em> Passwort erzeugt das wiederholte Klicken auf die Anmeldeschaltfläche (oder eine App, die die Verbindung alle paar Sekunden automatisch neu versucht) einen Schub von &ldquo;usersync&rdquo;-Anfragen. Häufige Reconnects und wiederholte Anmeldungen erreichen die Obergrenze schnell, weil jede einzelne gezählt wird." },
    { type: "heading", text: "3. Zu viele gleichzeitige Sitzungen und Geräte" },
    { type: "paragraph", html: "Web, Desktop, Mobile, TradingView und ein Bridge-Dienst, die sich alle gegen denselben Tradovate-Nutzer authentifizieren, vervielfachen die Anfragenzahl. Wenn mehrere davon gleichzeitig neu verbinden, etwa nach einem kurzen WLAN-Aussetzer, kann die kombinierte Last das Limit auslösen." },
    { type: "heading", text: "4. REST-API-Polling statt Streaming" },
    { type: "paragraph", html: "Für API- und Algo-Nutzer ist der klassische Fehler, einen REST-Endpunkt in einer engen Schleife abzufragen, zum Beispiel einmal pro Sekunde nach einem Konto- oder Positions-Snapshot zu fragen. Die REST-API ist nicht für Echtzeitnutzung ausgelegt, und genau diese Art von Polling erzeugt einen 429-Fehler auf Nutzerebene, der dann überall Anmeldungen blockiert." },
    { type: "heading", text: "5. Die stündliche Anfragen-Obergrenze erreichen" },
    { type: "paragraph", html: "Jede Aktion zählt als Anfrage: Anmelden, Charts öffnen, Orders platzieren, ändern oder stornieren, und jeder automatisierte Alert. Tradovate setzt eine stündliche Anfragen-Obergrenze über ein rollierendes 60-Minuten-Fenster durch, die genauen Werte finden Sie in der aktuellen Tradovate-API-Dokumentation und variieren je nach Endpunkt, prüfen Sie also die Dokumentation für die aktuellen Zahlen. Hochfrequente Aktivität, schnelle Alerts, das Kopieren von Trades auf mehrere Konten oder schnelles Modul-Wechseln zehren das Kontingent rasch auf. Einen Alert auf fünf Konten zu kopieren zählt beispielsweise als fünf Anfragen." },
    { type: "heading", text: "So beheben Sie die Tradovate-429-Sperre: Schritt für Schritt" },
    { type: "heading", text: "Eine durch Zugangsdaten ausgelöste Sperre beheben" },
    {
      type: "steps",
      items: [
        { title: "Hören Sie auf, sich anzumelden", html: "Schließen Sie den Anmelde-Tab oder die App. Jeder weitere Versuch während der Abkühlphase kann die Sperre verlängern." },
        { title: "Warten Sie etwa 60 Minuten", html: "Die Abkühlphase ist ein rollierendes ~60-Minuten-Fenster. Haben Sie sie um 14:15 Uhr ausgelöst, planen Sie mit einer Rückkehr gegen 15:15 Uhr, gerechnet ab Ihrem <em>letzten</em> Versuch, hören Sie also wirklich auf, es zu versuchen." },
        { title: "Prüfen Sie Ihre Zugangsdaten vor dem nächsten Versuch", html: "Bestätigen Sie den exakten Benutzernamen/die E-Mail und das Passwort. Sind Sie sich unsicher, setzen Sie das Passwort über die Tradovate-Anmeldeseite zurück, damit Ihr nächster Versuch garantiert korrekt ist, keine weiteren fehlgeschlagenen Anmeldungen, die den Zähler füllen." },
        { title: "Versuchen Sie es einmal, ruhig", html: "Melden Sie sich nach der Abkühlphase ein einziges Mal mit bestätigt korrekten Angaben an." },
      ],
    },
    { type: "heading", text: "Eine Sitzungs-/Reconnect-Flut beheben" },
    {
      type: "steps",
      items: [
        { title: "Melden Sie sich von jeder anderen Tradovate-Sitzung ab", html: "Melden Sie sich von Web, Desktop, Mobile und der TradingView-Verbindung ab, sodass sich nur noch ein Client authentifiziert." },
        { title: "Beheben Sie die zugrunde liegende Instabilität", html: "Eine abbrechende Verbindung, die sich in einer Schleife automatisch neu verbindet, ist ein Anfragen-Generator; wechseln Sie zu einer stabilen kabelgebundenen Verbindung und stellen Sie sicher, dass Ihre Systemuhr synchronisiert ist (allein eine Uhrenabweichung verursacht wiederholte Anmeldeablehnungen)." },
        { title: "Verbinden Sie nur ein Gerät neu", html: "Bringen Sie die anderen dann nacheinander zurück, nicht alle gleichzeitig." },
      ],
    },
    { type: "heading", text: "Eine durch API/Polling ausgelöste Sperre beheben" },
    {
      type: "steps",
      items: [
        { title: "Beenden Sie die Polling-Schleife", html: "Stoppen Sie jedes Skript, das REST-Endpunkte in festen Intervallen aufruft." },
        { title: "Stellen Sie Echtzeitdaten auf WebSocket um", html: "Öffnen Sie eine langlebige Verbindung zum WebSocket-Server von Tradovate und nutzen Sie dessen <code>syncRequest</code>-Funktion, um Echtzeit-Updates für Konto, Positionen und Orders zu erhalten, statt wiederholt über REST anzufragen. Das ist das von Tradovate empfohlene Muster." },
        { title: "Verteilen und staffeln Sie Ihre Aufrufe", html: "Bleiben Sie unter der stündlichen Obergrenze und drosseln Sie automatisch, wenn Sie einen 429 erhalten, statt sofort erneut zu versuchen." },
      ],
    },
    { type: "heading", text: "Wenn Sie nicht warten können" },
    { type: "paragraph", html: "Sind Sie mitten in einer Sitzung ausgesperrt und benötigen dringend Zugriff, <strong class='text-white'>rufen Sie den Tradovate-Support unter 312-283-3100 an</strong> (oder schreiben Sie eine E-Mail an den Support mit Ihrem Benutzernamen). In dringenden Fällen können sie Ihre Anfragelimits manuell zurücksetzen, aber sie können kein Limit aufheben, das Sie immer wieder auslösen, stellen Sie also zuerst sicher, dass die Flut gestoppt ist." },
    { type: "heading", text: "Fehlerbehebungstabelle" },
    {
      type: "table",
      headers: ["Fehler / Symptom", "Was es bedeutet", "Lösung"],
      rows: [
        ["Too many requests bei der TradingView-Anmeldung", "Anmeldung zu oft versucht, meist falsche Zugangsdaten", "~60 Min. warten, ohne es erneut zu versuchen; Passwort prüfen/zurücksetzen"],
        ["429 Too Many Requests (HTTP)", "Ratenbegrenzung auf Nutzerebene überschritten", "Alle Anfragen stoppen; das rollierende 60-Minuten-Fenster abwarten"],
        ["Kann sich nach API-Fehlern nicht bei der Desktop-App anmelden", "Ein 429 auf Nutzerebene ist von API-/Reconnect-Flut übergeschwappt", "Skript/Reconnect-Schleife stoppen; warten, dann einmal anmelden"],
        ["Die Sperre kommt immer wieder", "Sie versuchen es während der Abkühlphase erneut", "Ganz aufhören, es erneut zu versuchen; das Fenster setzt sich ab Ihrem letzten Versuch zurück"],
        ["Häufige Reconnects + &ldquo;usersync&rdquo;-Spitzen", "Instabile Verbindung oder mehrere Sitzungen", "Zusätzliche Sitzungen abmelden; kabelgebundenes Netzwerk nutzen; Systemuhr synchronisieren"],
        ["429 durch ein Polling-Skript", "REST-Endpunkt zu oft abgefragt", "Echtzeitdaten auf WebSocket-syncRequest umstellen; Aufrufe staffeln"],
      ],
    },
    { type: "heading", text: "Vermeiden Sie das mit PickMyTrade" },
    { type: "paragraph", html: "Wenn Ihre Sperren von Automatisierung, schnell feuernden TradingView-Alerts oder dem Kopieren auf mehrere Konten stammen, beseitigt eine Bridge, die die Limits von Tradovate respektiert, das gesamte Problem. PickMyTrade sitzt zwischen TradingView und Tradovate und sendet den Orderfluss so, wie die Plattform es erwartet:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Ratenlimit-sichere Weiterleitung</strong>, staffelt und reiht den Orderfluss ein, sodass Alert-Schübe die API nicht in einen 429 treiben.",
        "<strong class='text-white'>Eine einzige verwaltete Verbindung</strong>, eine stabile, dauerhafte Verbindung zu Ihrem Konto statt einer Reconnect-Schleife, die die Anmeldung bombardiert.",
        "<strong class='text-white'>Synchronisation mehrerer Konten</strong>, spiegelt einen Trade über Konten hinweg mit kontrolliertem Anfragetempo, nicht mit fünf gleichzeitigen Anmeldungen.",
        "<strong class='text-white'>Mengen-/Symbolvalidierung</strong>, blockiert fehlerhafte oder überdimensionierte Orders, bevor sie gesendet werden, und reduziert so unnötige Wiederholungsanfragen.",
      ],
    },
    { type: "paragraph", html: "Das Ergebnis: Ihre Strategie feuert weiter, während die Verbindung ruhig unter dem Limit bleibt." },
  ], es: [
    { type: "paragraph", html: "Va a iniciar sesión antes de la apertura del mercado de 2026, escribe sus credenciales, y Tradovate le devuelve un tajante <strong class='text-white'>429 &ldquo;Too Many Requests&rdquo;</strong>, y ahora no puede entrar en absoluto. Suele golpear en el peor momento posible: justo después de un par de intentos de contraseña con errores tipográficos, o cuando una automatización está bombardeando silenciosamente el inicio de sesión en segundo plano. ¿Lo frustrante? La solución es casi siempre la misma y aburrida, esperar a que pase el periodo de enfriamiento, dejar de reintentar, y cortar lo que estuviera inundando la conexión. A continuación explicamos qué significa realmente el error 429 de Tradovate por demasiadas solicitudes, por qué le bloquea el acceso, y exactamente cómo volver a entrar sin empeorar la situación." },
    {
      type: "checklist",
      heading: "Lista rápida para el bloqueo por 429",
      items: [
        "<strong class='text-white'>Deje de iniciar sesión de inmediato.</strong> Cada reintento puede extender el bloqueo en lugar de eliminarlo.",
        "<strong class='text-white'>Espere aproximadamente 60 minutos.</strong> Tradovate usa un periodo de enfriamiento móvil de unos 60 minutos antes de que el contador se reinicie.",
        "<strong class='text-white'>Verifique dos veces su usuario y contraseña.</strong> Las credenciales incorrectas repetidas son el principal desencadenante.",
        "<strong class='text-white'>Cierre sesión en todos los demás sitios.</strong> Las sesiones adicionales de web, escritorio, móvil y TradingView añaden &ldquo;ruido&rdquo; de reconexión.",
        "<strong class='text-white'>Limite cualquier sondeo de la API.</strong> Un script que llame a los endpoints REST cada segundo activará el límite rápidamente.",
        "<strong class='text-white'>Llame al soporte de Tradovate (312-283-3100)</strong> si está bloqueado y necesita un restablecimiento manual urgente.",
      ],
    },
    { type: "heading", text: "Qué significa &ldquo;Too Many Requests&rdquo; (429)" },
    { type: "paragraph", html: "<code>429 Too Many Requests</code> es un código de estado HTTP estándar. No es un error de contraseña, una suspensión de cuenta, ni una señal de que le hackearon la cuenta, simplemente significa que Tradovate recibió más solicitudes de su usuario, en una ventana corta, de las que permite su límite de tasa, por lo que deja de aceptar nuevas temporalmente." },
    { type: "paragraph", html: "Dos situaciones distintas producen el mismo mensaje, y distinguirlas evita mucho pánico:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>La versión del inicio de sesión de TradingView.</strong> Cuando inicia sesión en TradingView usando sus credenciales de Tradovate y obtiene &ldquo;Too many requests,&rdquo; casi siempre significa que el inicio de sesión de TradingView a Tradovate se intentó demasiadas veces, lo más común porque se introdujo un usuario o contraseña incorrectos una y otra vez. Este error específico aparece <strong class='text-white'>únicamente</strong> en el inicio de sesión de TradingView y <strong class='text-white'>no</strong> bloquea las apps nativas de Tradovate para Desktop, Web o Mobile.",
        "<strong class='text-white'>La versión a nivel de usuario / API.</strong> Tradovate aplica los límites de tasa a nivel de <strong class='text-white'>usuario</strong>, no a nivel de aplicación. Así que si un script, un bridge o un bucle de reconexión inunda la conexión con solicitudes, el bloqueo puede extenderse e impedir también el inicio de sesión en las apps de escritorio. Aquí el culpable es el volumen de solicitudes, no un error tipográfico.",
      ],
    },
    { type: "paragraph", html: "En cualquier caso, la cura es paciencia más eliminar la fuente de la inundación. Reintentar durante el periodo de enfriamiento es la forma más común en que los traders acaban bloqueándose a sí mismos por accidente." },
    { type: "heading", text: "Principales causas del bloqueo por 429 de Tradovate en 2026" },
    { type: "heading", text: "1. Usuario o contraseña incorrectos repetidos" },
    { type: "paragraph", html: "El desencadenante más frecuente con diferencia. Unos pocos intentos de inicio de sesión fallidos en rápida sucesión, una contraseña guardada desactualizada, el bloqueo de mayúsculas activado, o el correo de cuenta equivocado, bastan para chocar contra el muro de &ldquo;Too many requests&rdquo; en el inicio de sesión de TradingView. Las credenciales incorrectas son la causa más probable." },
    { type: "heading", text: "2. Intentos de inicio de sesión rápidos y repetidos" },
    { type: "paragraph", html: "Incluso con la contraseña <em>correcta</em>, hacer clic repetidamente en el botón de inicio de sesión (o una app que reintenta la conexión automáticamente cada pocos segundos) genera una ráfaga de solicitudes &ldquo;usersync&rdquo;. Las reconexiones frecuentes y los inicios de sesión repetidos alcanzan el límite rápidamente, porque cada uno cuenta." },
    { type: "heading", text: "3. Demasiadas sesiones y dispositivos simultáneos" },
    { type: "paragraph", html: "Web, escritorio, móvil, TradingView y un servicio bridge autenticándose todos contra el mismo usuario de Tradovate multiplican el recuento de solicitudes. Cuando varios de ellos se reconectan a la vez, por ejemplo, tras un corte breve de Wi-Fi, la carga combinada puede activar el límite." },
    { type: "heading", text: "4. Sondeo de la API REST en lugar de streaming" },
    { type: "paragraph", html: "Para usuarios de API y algos, el error clásico es sondear un endpoint REST en un bucle ajustado, por ejemplo, pidiendo un snapshot de saldo o posición una vez por segundo. La API REST no está diseñada para uso en tiempo real, y ese tipo de sondeo es exactamente lo que genera un 429 a nivel de usuario que después bloquea los inicios de sesión en todas partes." },
    { type: "heading", text: "5. Alcanzar el límite de solicitudes por hora" },
    { type: "paragraph", html: "Cada acción cuenta como una solicitud: iniciar sesión, abrir gráficos, colocar, modificar o cancelar órdenes, y cada alerta automatizada. Tradovate aplica un límite de solicitudes por hora en una ventana móvil de 60 minutos, las cifras exactas están en la documentación actual de la API de Tradovate y varían según el endpoint, así que consulte la documentación para los números vigentes. La actividad de alta frecuencia, las alertas rápidas, la copia de operaciones a varias cuentas, o el cambio rápido de módulos, consume rápidamente el límite. Copiar una alerta a cinco cuentas, por ejemplo, cuenta como cinco solicitudes." },
    { type: "heading", text: "Cómo solucionar el bloqueo por 429 de Tradovate: paso a paso" },
    { type: "heading", text: "Solucionar un bloqueo desencadenado por credenciales" },
    {
      type: "steps",
      items: [
        { title: "Deje de intentar iniciar sesión", html: "Cierre la pestaña o la app de inicio de sesión. Cada intento adicional durante el periodo de enfriamiento puede prolongar el bloqueo." },
        { title: "Espere unos 60 minutos", html: "El periodo de enfriamiento es una ventana móvil de ~60 minutos. Si lo activó a las 14:15, planee volver a intentarlo hacia las 15:15, medido desde su <em>último</em> intento, así que deje de intentarlo de verdad." },
        { title: "Verifique sus credenciales antes del siguiente intento", html: "Confirme el usuario/correo y la contraseña exactos. Si no está seguro, restablezca la contraseña desde la página de inicio de sesión de Tradovate para que su próximo intento sea garantizadamente correcto, sin más inicios de sesión fallidos que sumen al contador." },
        { title: "Reintente una vez, con calma", html: "Después del periodo de enfriamiento, inicie sesión una sola vez con datos confirmados como correctos." },
      ],
    },
    { type: "heading", text: "Solucionar una avalancha de sesiones/reconexiones" },
    {
      type: "steps",
      items: [
        { title: "Cierre sesión en todas las demás sesiones de Tradovate", html: "Cierre sesión en web, escritorio, móvil y la conexión de TradingView, de modo que solo un cliente esté autenticándose." },
        { title: "Solucione la inestabilidad subyacente", html: "Una conexión que se cae y se reconecta automáticamente en bucle es un generador de solicitudes; cambie a una conexión estable por cable y asegúrese de que el reloj de su sistema esté sincronizado (la desviación del reloj por sí sola causa rechazos de inicio de sesión repetidos)." },
        { title: "Reconecte un solo dispositivo", html: "Luego vuelva a conectar los demás uno a la vez en lugar de todos a la vez." },
      ],
    },
    { type: "heading", text: "Solucionar un bloqueo desencadenado por API/sondeo" },
    {
      type: "steps",
      items: [
        { title: "Elimine el bucle de sondeo", html: "Detenga cualquier script que llame a endpoints REST en un intervalo fijo." },
        { title: "Cambie los datos en tiempo real a un WebSocket", html: "Abra una conexión de larga duración al servidor WebSocket de Tradovate y use su función <code>syncRequest</code> para recibir actualizaciones en tiempo real de saldo, posición y órdenes, en lugar de preguntar repetidamente por REST. Este es el patrón que recomienda Tradovate." },
        { title: "Espacie y encole sus llamadas", html: "Manténgase por debajo del límite por hora, y frénese automáticamente cuando reciba un 429 en lugar de reintentar de inmediato." },
      ],
    },
    { type: "heading", text: "Cuando no puede esperar" },
    { type: "paragraph", html: "Si está bloqueado en medio de una sesión y necesita acceso urgentemente, <strong class='text-white'>llame al soporte de Tradovate al 312-283-3100</strong> (o envíe un correo al soporte con su nombre de usuario). Pueden restablecer manualmente sus límites de solicitud en situaciones urgentes, pero no pueden deshacer un límite que usted sigue volviendo a activar, así que asegúrese primero de que la inundación se haya detenido." },
    { type: "heading", text: "Tabla de solución de problemas" },
    {
      type: "table",
      headers: ["Error / síntoma", "Qué significa", "Solución"],
      rows: [
        ["Too many requests en el inicio de sesión de TradingView", "Inicio de sesión intentado demasiadas veces, normalmente credenciales incorrectas", "Espere ~60 min sin reintentar; verifique/restablezca la contraseña"],
        ["429 Too Many Requests (HTTP)", "Límite de tasa a nivel de usuario superado", "Detenga todas las solicitudes; espere la ventana móvil de 60 minutos"],
        ["No puede iniciar sesión en la app de escritorio tras errores de API", "Un 429 a nivel de usuario se propagó desde una inundación de API/reconexión", "Detenga el script/bucle de reconexión; espere y luego inicie sesión una vez"],
        ["El bloqueo sigue volviendo", "Está reintentando durante el periodo de enfriamiento", "Deje de reintentar por completo; la ventana se reinicia desde su último intento"],
        ["Reconexiones frecuentes + picos de &ldquo;usersync&rdquo;", "Conexión inestable o varias sesiones", "Cierre sesión en sesiones adicionales; use una red cableada; sincronice el reloj del sistema"],
        ["429 procedente de un script de sondeo", "Endpoint REST sondeado con demasiada frecuencia", "Mueva los datos en tiempo real a syncRequest por WebSocket; encole las llamadas"],
      ],
    },
    { type: "heading", text: "Evítelo con PickMyTrade" },
    { type: "paragraph", html: "Si sus bloqueos provienen de la automatización, de alertas de TradingView que se disparan rápido, o de copiar a varias cuentas, un bridge que respete los límites de Tradovate elimina todo el problema. PickMyTrade se sitúa entre TradingView y Tradovate y envía el flujo de órdenes de la forma en que la plataforma lo espera:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Enrutamiento seguro frente a límites de tasa</strong>, espacia y encola el flujo de órdenes para que las ráfagas de alertas no lancen la API a un 429.",
        "<strong class='text-white'>Conexión única gestionada</strong>, un enlace estable y persistente a su cuenta en lugar de un bucle de reconexión bombardeando el inicio de sesión.",
        "<strong class='text-white'>Sincronización multicuenta</strong>, replica una operación entre cuentas mediante un ritmo de solicitudes controlado, no cinco inicios de sesión simultáneos.",
        "<strong class='text-white'>Validación de cantidad/símbolo</strong>, bloquea órdenes malformadas o de tamaño excesivo antes de enviarlas, reduciendo las solicitudes de reintento desperdiciadas.",
      ],
    },
    { type: "paragraph", html: "El resultado: su estrategia sigue disparándose mientras la conexión se mantiene silenciosamente por debajo del límite." },
  ], fr: [
    { type: "paragraph", html: "Vous essayez de vous connecter avant l'ouverture des marchés de 2026, saisissez vos identifiants, et Tradovate vous renvoie un abrupt <strong class='text-white'>429 &ldquo;Too Many Requests&rdquo;</strong>, et vous ne pouvez plus du tout entrer. Cela survient généralement au pire moment possible : juste après quelques tentatives de mot de passe mal tapées, ou lorsqu'une automatisation bombarde silencieusement la connexion en arrière-plan. Ce qui est frustrant ? La solution est presque toujours la même, ennuyeuse, attendre la fin du délai de récupération, arrêter de réessayer, et couper ce qui inondait la connexion. Voici ce que signifie réellement l'erreur Tradovate 429 too many requests, pourquoi elle vous bloque l'accès, et comment revenir exactement sans aggraver la situation." },
    {
      type: "checklist",
      heading: "Check-list rapide pour le blocage 429",
      items: [
        "<strong class='text-white'>Arrêtez immédiatement de vous connecter.</strong> Chaque nouvelle tentative peut prolonger le blocage au lieu de le lever.",
        "<strong class='text-white'>Attendez environ 60 minutes.</strong> Tradovate utilise un délai de récupération glissant d'environ 60 minutes avant que le compteur ne se réinitialise.",
        "<strong class='text-white'>Vérifiez à deux fois votre identifiant et votre mot de passe.</strong> Des identifiants erronés répétés sont la cause numéro un.",
        "<strong class='text-white'>Déconnectez-vous partout ailleurs.</strong> Les sessions web, bureau, mobile et TradingView supplémentaires ajoutent du &ldquo;bruit&rdquo; de reconnexion.",
        "<strong class='text-white'>Limitez tout sondage de l'API.</strong> Un script qui appelle des endpoints REST chaque seconde déclenchera rapidement la limite.",
        "<strong class='text-white'>Appelez le support Tradovate (312-283-3100)</strong> si vous êtes bloqué et avez besoin d'une réinitialisation manuelle urgente.",
      ],
    },
    { type: "heading", text: "Ce que signifie &ldquo;Too Many Requests&rdquo; (429)" },
    { type: "paragraph", html: "<code>429 Too Many Requests</code> est un code de statut HTTP standard. Ce n'est pas une erreur de mot de passe, un bannissement de compte, ni un signe que votre compte a été piraté, cela signifie simplement que Tradovate a reçu plus de requêtes de votre utilisateur, dans une courte fenêtre, que ce que ses limites de débit autorisent, il cesse donc temporairement d'en accepter de nouvelles." },
    { type: "paragraph", html: "Deux situations différentes produisent le même message, et les distinguer évite beaucoup de panique :" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>La version connexion TradingView.</strong> Lorsque vous vous connectez à TradingView avec vos identifiants Tradovate et obtenez &ldquo;Too many requests,&rdquo; cela signifie presque toujours que la connexion de TradingView vers Tradovate a été tentée trop de fois, le plus souvent parce qu'un identifiant ou un mot de passe incorrect a été saisi à répétition. Cette erreur spécifique n'apparaît <strong class='text-white'>que</strong> lors de la connexion TradingView et ne bloque <strong class='text-white'>pas</strong> les applications natives Tradovate Desktop, Web ou Mobile.",
        "<strong class='text-white'>La version au niveau utilisateur / API.</strong> Tradovate applique les limites de débit au niveau <strong class='text-white'>utilisateur</strong>, pas au niveau application. Ainsi, si un script, un bridge, ou une boucle de reconnexion inonde la connexion de requêtes, le blocage peut déborder et rendre impossible aussi la connexion aux applications de bureau. Ici, le coupable est le volume de requêtes, pas une faute de frappe.",
      ],
    },
    { type: "paragraph", html: "Dans les deux cas, le remède consiste en patience plus la suppression de la source de l'inondation. Réessayer pendant le délai de récupération est la manière la plus courante dont les traders se bloquent accidentellement eux-mêmes." },
    { type: "heading", text: "Principales causes du blocage Tradovate 429 en 2026" },
    { type: "heading", text: "1. Identifiant ou mot de passe erronés répétés" },
    { type: "paragraph", html: "De loin le déclencheur le plus fréquent. Quelques tentatives de connexion échouées en succession rapide, un mot de passe enregistré obsolète, le verrouillage des majuscules activé, ou la mauvaise adresse e-mail de compte, suffisent pour heurter le mur &ldquo;Too many requests&rdquo; lors de la connexion TradingView. Des identifiants incorrects en sont la cause la plus probable." },
    { type: "heading", text: "2. Tentatives de connexion rapides et répétées" },
    { type: "paragraph", html: "Même avec le <em>bon</em> mot de passe, cliquer frénétiquement sur le bouton de connexion (ou une application qui retente automatiquement la connexion toutes les quelques secondes) génère une rafale de requêtes &ldquo;usersync&rdquo;. Les reconnexions fréquentes et les connexions répétées atteignent rapidement le plafond, car chacune est comptabilisée." },
    { type: "heading", text: "3. Trop de sessions et d'appareils simultanés" },
    { type: "paragraph", html: "Le web, le bureau, le mobile, TradingView et un service bridge s'authentifiant tous auprès du même utilisateur Tradovate multiplient le nombre de requêtes. Lorsque plusieurs se reconnectent en même temps, par exemple après une coupure Wi-Fi, le cumul peut déclencher la limite." },
    { type: "heading", text: "4. Sondage de l'API REST au lieu du streaming" },
    { type: "paragraph", html: "Pour les utilisateurs d'API et d'algos, l'erreur classique consiste à sonder un endpoint REST en boucle serrée, par exemple en demandant un instantané de solde ou de position chaque seconde. L'API REST n'est pas conçue pour un usage temps réel, et ce type de sondage est précisément ce qui génère un 429 au niveau utilisateur qui bloque ensuite les connexions partout." },
    { type: "heading", text: "5. Atteindre le plafond horaire de requêtes" },
    { type: "paragraph", html: "Chaque action compte comme une requête : se connecter, ouvrir des graphiques, passer, modifier ou annuler des ordres, et chaque alerte automatisée. Tradovate applique un plafond horaire de requêtes sur une fenêtre glissante de 60 minutes, les chiffres exacts figurent dans la documentation actuelle de l'API Tradovate et varient selon l'endpoint, consultez donc la documentation pour les chiffres à jour. Une activité à haute fréquence, des alertes rapides, la copie d'ordres vers plusieurs comptes, ou un changement rapide de module, épuisent rapidement le quota. Copier une alerte sur cinq comptes, par exemple, compte comme cinq requêtes." },
    { type: "heading", text: "Comment résoudre le blocage Tradovate 429 : étape par étape" },
    { type: "heading", text: "Résoudre un blocage déclenché par des identifiants" },
    {
      type: "steps",
      items: [
        { title: "Arrêtez d'essayer de vous connecter", html: "Fermez l'onglet ou l'application de connexion. Chaque tentative supplémentaire pendant le délai de récupération peut prolonger le blocage." },
        { title: "Attendez environ 60 minutes", html: "Le délai de récupération est une fenêtre glissante d'environ 60 minutes. Si vous l'avez déclenché à 14h15, prévoyez de revenir vers 15h15, calculé depuis votre <em>dernière</em> tentative, alors arrêtez réellement d'essayer." },
        { title: "Vérifiez vos identifiants avant la prochaine tentative", html: "Confirmez l'identifiant/e-mail exact et le mot de passe. En cas de doute, réinitialisez le mot de passe depuis la page de connexion Tradovate afin que votre prochaine tentative soit garantie correcte, plus aucune connexion échouée à ajouter au compteur." },
        { title: "Réessayez une fois, calmement", html: "Après le délai de récupération, connectez-vous une seule fois avec des informations confirmées comme correctes." },
      ],
    },
    { type: "heading", text: "Résoudre une avalanche de sessions/reconnexions" },
    {
      type: "steps",
      items: [
        { title: "Déconnectez-vous de toute autre session Tradovate", html: "Déconnectez-vous du web, du bureau, du mobile et de la connexion TradingView, de sorte qu'un seul client s'authentifie." },
        { title: "Corrigez l'instabilité sous-jacente", html: "Une connexion qui se coupe et se reconnecte automatiquement en boucle est un générateur de requêtes ; passez à une connexion filaire stable et assurez-vous que l'horloge de votre système est synchronisée (une simple dérive d'horloge cause à elle seule des rejets de connexion répétés)." },
        { title: "Reconnectez un seul appareil", html: "Puis rebranchez les autres un par un plutôt que tous en même temps." },
      ],
    },
    { type: "heading", text: "Résoudre un blocage déclenché par l'API/le sondage" },
    {
      type: "steps",
      items: [
        { title: "Tuez la boucle de sondage", html: "Arrêtez tout script appelant des endpoints REST à intervalle fixe." },
        { title: "Basculez les données temps réel vers un WebSocket", html: "Ouvrez une connexion de longue durée au serveur WebSocket de Tradovate et utilisez sa fonctionnalité <code>syncRequest</code> pour recevoir les mises à jour en temps réel du solde, des positions et des ordres, plutôt que d'interroger REST à répétition. C'est le schéma que Tradovate recommande." },
        { title: "Espacez et mettez en file d'attente vos appels", html: "Restez sous le plafond horaire, et réduisez automatiquement le rythme lorsque vous recevez un 429 plutôt que de réessayer immédiatement." },
      ],
    },
    { type: "heading", text: "Quand vous ne pouvez pas attendre" },
    { type: "paragraph", html: "Si vous êtes bloqué en pleine session et avez besoin d'un accès urgent, <strong class='text-white'>appelez le support Tradovate au 312-283-3100</strong> (ou envoyez un e-mail au support avec votre identifiant). Ils peuvent réinitialiser manuellement vos limites de requêtes dans des situations urgentes, mais ils ne peuvent pas annuler une limite que vous continuez à redéclencher, alors assurez-vous d'abord que l'inondation s'est arrêtée." },
    { type: "heading", text: "Tableau de dépannage" },
    {
      type: "table",
      headers: ["Erreur / symptôme", "Ce que cela signifie", "Solution"],
      rows: [
        ["Too many requests lors de la connexion TradingView", "Connexion tentée trop de fois, généralement des identifiants erronés", "Attendez ~60 min sans réessayer ; vérifiez/réinitialisez le mot de passe"],
        ["429 Too Many Requests (HTTP)", "Limite de débit au niveau utilisateur dépassée", "Arrêtez toutes les requêtes ; attendez la fenêtre glissante de 60 minutes"],
        ["Impossible de se connecter à l'app de bureau après des erreurs API", "Un 429 au niveau utilisateur a débordé d'une inondation API/reconnexion", "Arrêtez le script/la boucle de reconnexion ; attendez, puis connectez-vous une fois"],
        ["Le blocage revient sans cesse", "Vous réessayez pendant le délai de récupération", "Arrêtez complètement de réessayer ; la fenêtre se réinitialise depuis votre dernière tentative"],
        ["Reconnexions fréquentes + pics de &ldquo;usersync&rdquo;", "Connexion instable ou sessions multiples", "Déconnectez les sessions supplémentaires ; utilisez un réseau filaire ; synchronisez l'horloge système"],
        ["429 provenant d'un script de sondage", "Endpoint REST sondé trop souvent", "Passez les données temps réel au syncRequest WebSocket ; mettez les appels en file d'attente"],
      ],
