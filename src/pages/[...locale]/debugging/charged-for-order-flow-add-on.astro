---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "charged-for-order-flow-add-on";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/debugging/${SLUG}`;

const META_TITLE = "Tradovate Charged for Order Flow Add-On Unwanted";
const META_DESCRIPTION =
  "Charged for an Order Flow add-on you never wanted? See why the fee appears, how to switch the tools off, and how to dispute it for a refund.";

// Short SEO title (<=60 chars) for locales where the shared h1 is too long for a SERP title.
const TITLE_OVERRIDE: Partial<Record<Locale, string>> = { it: "Tradovate: componente Order Flow addebitato senza richiesta" };

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Tradovate berechnet ungewollt die Order-Flow-Erweiterung", es: "Tradovate cobra un complemento de Order Flow no deseado", fr: "Tradovate facture un module Order Flow non désiré", it: "Tradovate addebita un componente aggiuntivo Order Flow non desiderato" },
  dek: { en: "An Order Flow+ line item showed up on your Tradovate statement and you don't remember signing up for it. Here's why the charge appears, how to turn the add-on off, and how to get a refund.", de: "Auf Ihrer Tradovate-Abrechnung taucht ein Order Flow+-Posten auf, und Sie erinnern sich nicht, sich dafür angemeldet zu haben. Hier erfahren Sie, warum die Belastung erscheint, wie Sie das Add-on abschalten und wie Sie eine Rückerstattung erhalten.", es: "Ha aparecido una partida de Order Flow+ en tu extracto de Tradovate y no recuerdas haberte suscrito a ella. Aquí te explicamos por qué aparece el cargo, cómo desactivar el complemento y cómo conseguir un reembolso.", fr: "Une ligne Order Flow+ est apparue sur votre relevé Tradovate et vous ne vous souvenez pas de vous y être abonné. Voici pourquoi ce prélèvement apparaît, comment désactiver le module et comment obtenir un remboursement.", it: "Nel tuo estratto conto Tradovate compare una voce Order Flow+ e non ricordi di esserti iscritto. Ecco perché appare l'addebito, come disattivare il componente aggiuntivo e come ottenere un rimborso." },
  readTime: { en: "6 min read", de: "6 Minuten Lesezeit", es: "Lectura de 6 minutos", fr: "Lecture de 6 minutes", it: "Lettura di 6 minuti" },
  lastUpdated: "2026-07-10",
  heroImage: { src: `${IMG}/charged-for-order-flow-add-on-1.png`, alt: { en: "Tradovate account statement showing an Order Flow + subscription line item and its monthly amount", de: "Tradovate-Kontoauszug mit einem Order-Flow+-Abonnementposten und dem monatlichen Betrag", es: "Extracto de cuenta de Tradovate que muestra una partida de suscripción de Order Flow + y su importe mensual", fr: "Relevé de compte Tradovate affichant une ligne d'abonnement Order Flow + et son montant mensuel", it: "Estratto conto Tradovate che mostra una voce di abbonamento Order Flow + e il relativo importo mensile" } },
  blocks: { en: [
    { type: "paragraph", html: "You open your Tradovate statement, and there it is: an <strong class='text-white'>Order Flow</strong> or <strong class='text-white'>Order Flow +</strong> line item you don't remember agreeing to. You're not imagining it, and it isn't a random glitch. Order Flow+ is a paid tools package, and if it's switched on for your account it renews on its own until you stop it. The short version of the fix: open your <strong class='text-white'>Add-Ons</strong> settings and turn Order Flow+ off so it stops renewing, then contact Tradovate billing with your statement to dispute the charge you didn't intend to make and ask for a credit. And here's the part that catches a lot of people off guard, on newer account plans these same tools are bundled in for free, so in plenty of cases you shouldn't be paying for them separately at all." },
    { type: "quote", html: "Add-on pricing, billing cycles and menu labels change over time. The steps below reflect how Tradovate's Add-Ons and billing worked at the time of writing, but Tradovate can revise fees and rename screens at any point. Always confirm the current wording and amounts in your own account before acting." },
    {
      type: "checklist",
      heading: "Quick Checklist for the Order Flow Charge",
      items: [
        "<strong class='text-white'>Is Order Flow+ actually active?</strong> Open Application Settings &rsaquo; Add-Ons and look for Order Flow+. If it shows as subscribed, that's your line item.",
        "<strong class='text-white'>Does your plan already include it?</strong> Newer plans with a live brokerage account bundle the order-flow tools in, paying the standalone add-on on top of that is money wasted.",
        "<strong class='text-white'>Turn it off first.</strong> Switch the add-on off before anything else so it can't renew for another cycle.",
        "<strong class='text-white'>Then dispute the charge.</strong> Contact Tradovate billing with your statement and the dates, explain you didn't intend to subscribe, and ask for a refund or credit.",
        "<strong class='text-white'>Using NinjaTrader too?</strong> One entitlement under your Tradovate username covers both, don't subscribe a second time and pay twice.",
        "<strong class='text-white'>On a prop / evaluation account?</strong> Add-ons there are handled by your firm, not by you. Contact the firm, not Tradovate retail billing.",
      ],
    },
    { type: "heading", text: "What the Order Flow Charge Actually Is" },
    { type: "paragraph", html: "Order Flow+ is Tradovate's premium package of order-flow analysis tools. It bundles the visual, tape-reading features that active futures traders lean on: <strong class='text-white'>volumetric (footprint) bars</strong>, a <strong class='text-white'>volume profile</strong> indicator and drawing tool, <strong class='text-white'>cumulative delta</strong>, <strong class='text-white'>VWAP</strong>, a trade detector, and a market depth map. These aren't part of the basic charting everyone gets, they're a distinct, chargeable set of tools, which is why they show up as their own line on a statement." },
    { type: "paragraph", html: "The reason this surprises so many people comes down to history. Tradovate was acquired by NinjaTrader, and in the platform changes that followed, the order-flow tooling was consolidated into the paid Order Flow+ add-on. Accounts that once had those tools available, or that opted in during a promotion or trial, ended up carrying a recurring subscription. Nobody sat down and deliberately signed up for a monthly fee, the tools simply got repackaged behind one." },
    { type: "paragraph", html: "There's a twist that works in your favor, though. More recent account plans that come with a live Tradovate brokerage account now include the Order Flow+ tools at no additional charge, alongside things like market replay and TradingView access. So the same features that used to be a paid extra are, for many current plans, already baked in. That's what makes an ongoing standalone Order Flow+ charge worth a second look: you may be paying for something your plan now hands you for free." },
    { type: "heading", text: "Why You're Seeing the Charge" },
    { type: "heading", text: "1. The add-on is switched on for your account" },
    { type: "paragraph", html: "The most direct cause: Order Flow+ is enabled in your Add-Ons, so it bills every cycle. It may have been turned on during onboarding, in a free-trial window that quietly converted to paid, or at a time when the tools were sold as an extra. Whatever the origin, an active add-on keeps charging until someone switches it off." },
    { type: "heading", text: "2. The tools got repackaged after the ownership change" },
    { type: "paragraph", html: "Following the NinjaTrader acquisition, the order-flow features were reorganized into the paid Order Flow+ product. If your account predates that change, tools you used to treat as &ldquo;just part of the platform&rdquo; may now sit behind a subscription. The charge feels new because the packaging is new, not because you did anything wrong." },
    { type: "image", src: `${IMG}/charged-for-order-flow-add-on-2.png`, alt: "Tradovate Application Settings Add-Ons tab showing the Order Flow Plus add-on with a subscribe or active toggle" },
    { type: "heading", text: "3. You're paying separately for something your plan now includes" },
    { type: "paragraph", html: "This is the one that genuinely costs people money. If you're on a current plan that bundles Order Flow+ <em>and</em> you still have the standalone add-on active, you can be billed twice for the same tools. Confirming what your plan already covers is often the single biggest saving here." },
    { type: "heading", text: "4. You subscribed once and forgot, and it renews on a full cycle" },
    { type: "paragraph", html: "Add-ons don't quietly expire. Once active, Order Flow+ renews on its billing cycle, typically a full calendar month rather than a per-day proration, so a one-time &ldquo;let me try this&rdquo; click keeps charging month after month until you cancel it." },
    { type: "heading", text: "5. It's a prop or evaluation account, and the firm controls add-ons" },
    { type: "paragraph", html: "On prop-firm evaluation and funded accounts, market-data tools and add-ons are provisioned and billed by the firm, not self-subscribed through Tradovate's retail settings. If order-flow charges show up on that kind of account, the firm, not Tradovate retail billing, is who you talk to. What's included and what costs extra varies by firm and account size, so check your firm's current rules." },
    { type: "heading", text: "How to Stop and Dispute the Charge: Step-by-Step" },
    {
      type: "steps",
      items: [
        { title: "Confirm exactly what you're being billed for", html: "Before disputing anything, pin down the charge. Open your billing or subscription history and identify the Order Flow+ line, the amount, and the date it posts each cycle. Knowing precisely what renews, and when, makes both the cancellation and any refund request cleaner.<br><br>Log in to the Tradovate web platform. Open your account's billing, membership, or subscription history. Locate the Order Flow+ entry and note its amount and renewal date. Screenshot or save it, you'll want this if you ask for a refund." },
        { title: "Turn the add-on off so it stops renewing", html: "Cancelling stops the bleeding. Do this before you contact anyone, so the charge can't roll into another cycle while you wait on a reply.<br><br>In the web platform, open <strong class='text-white'>Application Settings</strong> from the upper-right corner of the screen. Open the <strong class='text-white'>Add-Ons</strong> tab. Find <strong class='text-white'>Order Flow+</strong> in the list. Switch it off / unsubscribe so it won't renew next cycle. Confirm the change is saved and the add-on now reads as inactive.<br><br>One thing to know: because add-ons usually bill for the whole calendar month, you may keep access to the tools through the end of the current cycle and simply not be charged again afterward. That's normal, it doesn't mean the cancellation failed." },
        { title: "Check whether your plan already includes the tools", html: "While you're in settings, look at your plan. If you're on a current plan that bundles Order Flow+ with a live brokerage account, you don't need the paid add-on at all, keeping it active just duplicates a benefit you already have. If you're on an older or free tier, weigh whether the tools are worth a plan change versus a standalone fee." },
        { title: "Contact billing to dispute the charge and ask for a refund", html: "Turning the add-on off stops future charges, but it doesn't automatically reverse ones you've already paid. For those, you have to ask, and refunds are decided case by case, so how you ask matters.<br><br>Reach Tradovate billing through in-app live chat or the official Contact Support page. State clearly that you were billed for Order Flow+ that you didn't intend to subscribe to. Attach the statement or screenshot from Step 1 with the amounts and dates. If your plan already includes the tools, say so, a duplicate charge is a strong basis for a credit. Ask directly for a refund or account credit, and note that you've already cancelled the add-on." },
      ],
    },
    { type: "image", src: `${IMG}/charged-for-order-flow-add-on-4.png`, alt: "Tradovate Contact Support billing form used to dispute an unwanted Order Flow add-on charge" },
    { type: "paragraph", html: "Keep it factual and specific. A message that names the exact charge, shows the dates, and explains why it wasn't intended is far more persuasive than a vague complaint. If it's a prop or evaluation account, send the same information to your firm's support instead." },
    { type: "heading", text: "Troubleshooting Table" },
    {
      type: "table",
      headers: ["Symptom", "What it means", "Fix"],
      rows: [
        ["“Order Flow +” line item on your statement", "The paid Order Flow+ add-on is active and renewing", "Turn it off in Application Settings › Add-Ons, then dispute past charges with billing"],
        ["Charged even though you don't recall subscribing", "Tools were repackaged into a paid add-on after the ownership change", "Check the Add-Ons tab; unsubscribe and request a credit for charges you didn't intend"],
        ["Paying the add-on but your plan lists Order Flow+ as included", "Duplicate charge for a bundled benefit", "Cancel the standalone add-on; use the plan-included tools instead"],
        ["Cancelled, but still have access this month", "Add-ons bill for the full cycle, not prorated", "Normal, you keep access until cycle end and aren't billed again"],
        ["Charged in both Tradovate and NinjaTrader", "Subscribed twice under different logins", "Use one entitlement under your Tradovate username; cancel the duplicate"],
        ["Order-flow charge on a prop / evaluation account", "Add-ons there are handled by the prop firm", "Contact your firm's support; rules vary by firm and account size"],
      ],
    },
    { type: "heading", text: "Where PickMyTrade Fits" },
    { type: "paragraph", html: "Order-flow indicators are for reading the market by eye. If your edge is a defined, rule-based strategy, you may not need to stare at footprint bars at all, you need your signals to fire orders reliably. That's where automation replaces a lot of manual screen-watching:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Hands-off execution</strong>, PickMyTrade routes your TradingView alerts straight to your Tradovate account, so entries and exits fire on your rules without you glued to the tape.",
        "<strong class='text-white'>Fewer paid extras to babysit</strong>, when a systematic strategy does the reading for you, you can be deliberate about which paid tools you actually keep.",
        "<strong class='text-white'>Multi-account sync</strong>, mirror the same strategy across several Tradovate accounts from one alert.",
        "<strong class='text-white'>Clean trade records</strong>, every automated fill is logged, which also makes reviewing statements and charges far easier.",
      ],
    },
  ], de: [
    { type: "paragraph", html: "Sie öffnen Ihre Tradovate-Abrechnung, und da ist er: ein Posten <strong class='text-white'>Order Flow</strong> oder <strong class='text-white'>Order Flow +</strong>, dem Sie sich nicht erinnern zugestimmt zu haben. Sie bilden sich das nicht ein, und es ist auch kein zufälliger Fehler. Order Flow+ ist ein kostenpflichtiges Tools-Paket, und wenn es für Ihr Konto aktiviert ist, verlängert es sich von selbst, bis Sie es stoppen. Kurz gesagt: Öffnen Sie Ihre <strong class='text-white'>Add-Ons</strong>-Einstellungen und schalten Sie Order Flow+ aus, damit es sich nicht mehr verlängert, kontaktieren Sie dann die Tradovate-Buchhaltung mit Ihrer Abrechnung, um die ungewollte Belastung anzufechten und eine Gutschrift zu verlangen. Und hier ist der Teil, der viele überrascht: Bei neueren Kontoplänen sind genau diese Tools bereits kostenlos enthalten, sodass Sie sie in vielen Fällen gar nicht separat bezahlen sollten." },
    { type: "quote", html: "Preise für Add-ons, Abrechnungszyklen und Menübezeichnungen ändern sich mit der Zeit. Die folgenden Schritte spiegeln wider, wie Tradovates Add-Ons und Abrechnung zum Zeitpunkt der Erstellung funktionierten, aber Tradovate kann Gebühren jederzeit anpassen und Bildschirme umbenennen. Bestätigen Sie stets den aktuellen Wortlaut und die Beträge in Ihrem eigenen Konto, bevor Sie handeln." },
    {
      type: "checklist",
      heading: "Kurzcheckliste zur Order-Flow-Belastung",
      items: [
        "<strong class='text-white'>Ist Order Flow+ tatsächlich aktiv?</strong> Öffnen Sie Application Settings &rsaquo; Add-Ons und suchen Sie nach Order Flow+. Wird es als abonniert angezeigt, ist das Ihr Posten.",
        "<strong class='text-white'>Enthält Ihr Plan es bereits?</strong> Neuere Pläne mit einem Live-Brokerage-Konto bündeln die Order-Flow-Tools bereits, das eigenständige Add-on zusätzlich zu bezahlen ist verschwendetes Geld.",
        "<strong class='text-white'>Zuerst ausschalten.</strong> Schalten Sie das Add-on vor allem anderen aus, damit es sich nicht für einen weiteren Zyklus verlängern kann.",
        "<strong class='text-white'>Dann die Belastung anfechten.</strong> Kontaktieren Sie die Tradovate-Buchhaltung mit Ihrer Abrechnung und den Daten, erklären Sie, dass Sie nicht beabsichtigt haben zu abonnieren, und bitten Sie um Rückerstattung oder Gutschrift.",
        "<strong class='text-white'>Nutzen Sie auch NinjaTrader?</strong> Eine Berechtigung unter Ihrem Tradovate-Benutzernamen deckt beides ab, abonnieren Sie nicht ein zweites Mal und zahlen Sie doppelt.",
        "<strong class='text-white'>Auf einem Prop-/Evaluierungskonto?</strong> Add-ons werden dort von Ihrer Firma verwaltet, nicht von Ihnen. Kontaktieren Sie die Firma, nicht die Tradovate-Privatkundenbuchhaltung.",
      ],
    },
    { type: "heading", text: "Was die Order-Flow-Belastung tatsächlich ist" },
    { type: "paragraph", html: "Order Flow+ ist Tradovates Premium-Paket an Order-Flow-Analysewerkzeugen. Es bündelt die visuellen Tape-Reading-Funktionen, auf die sich aktive Futures-Trader stützen: <strong class='text-white'>volumetrische Balken (Footprint)</strong>, einen <strong class='text-white'>Volume-Profile</strong>-Indikator samt Zeichenwerkzeug, <strong class='text-white'>Cumulative Delta</strong>, <strong class='text-white'>VWAP</strong>, einen Trade-Detektor und eine Markttiefenkarte. Diese sind nicht Teil des Basis-Chartings, das jeder erhält, sondern ein eigenständiges, kostenpflichtiges Set an Werkzeugen, weshalb sie als eigener Posten auf einer Abrechnung erscheinen." },
    { type: "paragraph", html: "Der Grund, warum das so viele überrascht, liegt in der Geschichte. Tradovate wurde von NinjaTrader übernommen, und im Zuge der folgenden Plattformänderungen wurden die Order-Flow-Werkzeuge im kostenpflichtigen Add-on Order Flow+ zusammengefasst. Konten, die diese Werkzeuge einst zur Verfügung hatten oder die während einer Aktion oder Testphase zugestimmt hatten, endeten mit einem wiederkehrenden Abonnement. Niemand hat sich bewusst hingesetzt und einer monatlichen Gebühr zugestimmt, die Werkzeuge wurden einfach hinter einer solchen neu verpackt." },
    { type: "paragraph", html: "Es gibt jedoch eine Wendung, die zu Ihren Gunsten wirkt. Neuere Kontopläne, die mit einem Live-Tradovate-Brokerage-Konto einhergehen, enthalten die Order-Flow+-Werkzeuge nun ohne Aufpreis, zusammen mit Dingen wie Market Replay und TradingView-Zugang. Dieselben Funktionen, die früher ein kostenpflichtiges Extra waren, sind also bei vielen aktuellen Plänen bereits enthalten. Deshalb lohnt sich ein zweiter Blick auf eine fortlaufende eigenständige Order-Flow+-Belastung: Sie zahlen womöglich für etwas, das Ihnen Ihr Plan jetzt kostenlos bietet." },
    { type: "heading", text: "Warum Sie die Belastung sehen" },
    { type: "heading", text: "1. Das Add-on ist für Ihr Konto aktiviert" },
    { type: "paragraph", html: "Die direkteste Ursache: Order Flow+ ist in Ihren Add-Ons aktiviert, sodass es jeden Zyklus abgerechnet wird. Es kann während des Onboardings aktiviert worden sein, in einem kostenlosen Testzeitraum, der still in ein kostenpflichtiges Abo überging, oder zu einer Zeit, als die Werkzeuge als Extra verkauft wurden. Woher es auch stammt, ein aktives Add-on belastet weiter, bis es jemand ausschaltet." },
    { type: "heading", text: "2. Die Werkzeuge wurden nach dem Eigentümerwechsel neu verpackt" },
    { type: "paragraph", html: "Nach der Übernahme durch NinjaTrader wurden die Order-Flow-Funktionen im kostenpflichtigen Produkt Order Flow+ neu organisiert. Wenn Ihr Konto von vor dieser Änderung stammt, können Werkzeuge, die Sie einst als &ldquo;einfach Teil der Plattform&rdquo; betrachtet haben, jetzt hinter einem Abonnement liegen. Die Belastung fühlt sich neu an, weil die Verpackung neu ist, nicht weil Sie etwas falsch gemacht haben." },
    { type: "image", src: `${IMG}/charged-for-order-flow-add-on-2.png`, alt: "Tradovate-Reiter Application Settings Add-Ons mit dem Order-Flow-Plus-Add-on und einem Abonnieren-/Aktiv-Schalter" },
    { type: "heading", text: "3. Sie zahlen separat für etwas, das Ihr Plan jetzt enthält" },
    { type: "paragraph", html: "Das ist der Punkt, der Menschen tatsächlich Geld kostet. Wenn Sie einen aktuellen Plan haben, der Order Flow+ bündelt, <em>und</em> das eigenständige Add-on weiterhin aktiv ist, können Sie doppelt für dieselben Werkzeuge belastet werden. Zu bestätigen, was Ihr Plan bereits abdeckt, ist hier oft die größte Ersparnis." },
    { type: "heading", text: "4. Sie haben sich einmal angemeldet und es vergessen, und es verlängert sich im vollen Zyklus" },
    { type: "paragraph", html: "Add-ons laufen nicht still und heimlich ab. Einmal aktiv, verlängert sich Order Flow+ nach seinem Abrechnungszyklus, in der Regel ein voller Kalendermonat und keine tageweise Anteilsberechnung, sodass ein einmaliges &ldquo;lass mich das mal probieren&rdquo;-Klick Monat für Monat weiter belastet, bis Sie kündigen." },
    { type: "heading", text: "5. Es handelt sich um ein Prop- oder Evaluierungskonto, und die Firma kontrolliert die Add-ons" },
    { type: "paragraph", html: "Bei Prop-Firm-Evaluierungs- und finanzierten Konten werden Marktdatenwerkzeuge und Add-ons von der Firma bereitgestellt und abgerechnet, nicht selbst über Tradovates Privatkunden-Einstellungen abonniert. Tauchen Order-Flow-Belastungen bei einem solchen Konto auf, ist die Firma Ihr Ansprechpartner, nicht die Tradovate-Privatkundenbuchhaltung. Was enthalten ist und was extra kostet, variiert je nach Firma und Kontogröße, prüfen Sie also die aktuellen Regeln Ihrer Firma." },
    { type: "heading", text: "So stoppen und bestreiten Sie die Belastung: Schritt für Schritt" },
    {
      type: "steps",
      items: [
        { title: "Bestätigen Sie genau, wofür Sie belastet werden", html: "Bevor Sie etwas anfechten, klären Sie die Belastung genau. Öffnen Sie Ihren Rechnungs- oder Abonnementverlauf und identifizieren Sie den Order-Flow+-Posten, den Betrag und das Datum, an dem er jeden Zyklus gebucht wird. Genau zu wissen, was sich wann verlängert, macht sowohl die Kündigung als auch jede Rückerstattungsanfrage sauberer.<br><br>Melden Sie sich bei der Tradovate-Webplattform an. Öffnen Sie den Rechnungs-, Mitgliedschafts- oder Abonnementverlauf Ihres Kontos. Suchen Sie den Order-Flow+-Eintrag und notieren Sie Betrag und Verlängerungsdatum. Machen Sie einen Screenshot oder speichern Sie ihn, Sie werden das brauchen, wenn Sie eine Rückerstattung verlangen." },
        { title: "Schalten Sie das Add-on aus, damit es sich nicht mehr verlängert", html: "Das Kündigen stoppt die Blutung. Tun Sie dies, bevor Sie irgendjemanden kontaktieren, damit die Belastung nicht in einen weiteren Zyklus rutscht, während Sie auf eine Antwort warten.<br><br>Öffnen Sie in der Webplattform <strong class='text-white'>Application Settings</strong> oben rechts auf dem Bildschirm. Öffnen Sie den Reiter <strong class='text-white'>Add-Ons</strong>. Suchen Sie <strong class='text-white'>Order Flow+</strong> in der Liste. Schalten Sie es aus / kündigen Sie, damit es sich im nächsten Zyklus nicht verlängert. Bestätigen Sie, dass die Änderung gespeichert wurde und das Add-on nun als inaktiv angezeigt wird.<br><br>Eine Sache, die Sie wissen sollten: Da Add-ons in der Regel für den gesamten Kalendermonat berechnet werden, behalten Sie möglicherweise Zugang zu den Werkzeugen bis zum Ende des aktuellen Zyklus und werden danach einfach nicht mehr belastet. Das ist normal, es bedeutet nicht, dass die Kündigung fehlgeschlagen ist." },
        { title: "Prüfen Sie, ob Ihr Plan die Werkzeuge bereits enthält", html: "Solange Sie sich in den Einstellungen befinden, sehen Sie sich Ihren Plan an. Wenn Sie einen aktuellen Plan haben, der Order Flow+ mit einem Live-Brokerage-Konto bündelt, benötigen Sie das kostenpflichtige Add-on überhaupt nicht, es aktiv zu lassen dupliziert nur einen Vorteil, den Sie bereits haben. Wenn Sie eine ältere oder kostenlose Stufe nutzen, wägen Sie ab, ob die Werkzeuge einen Planwechsel gegenüber einer eigenständigen Gebühr wert sind." },
        { title: "Kontaktieren Sie die Buchhaltung, um die Belastung anzufechten und eine Rückerstattung zu verlangen", html: "Das Ausschalten des Add-ons stoppt zukünftige Belastungen, kehrt aber nicht automatisch bereits bezahlte um. Dafür müssen Sie fragen, und Rückerstattungen werden von Fall zu Fall entschieden, also spielt es eine Rolle, wie Sie fragen.<br><br>Erreichen Sie die Tradovate-Buchhaltung über den In-App-Live-Chat oder die offizielle Kontakt-Support-Seite. Erklären Sie klar, dass Sie für Order Flow+ belastet wurden, das Sie nicht abonnieren wollten. Fügen Sie die Abrechnung oder den Screenshot aus Schritt 1 mit Beträgen und Daten bei. Wenn Ihr Plan die Werkzeuge bereits enthält, sagen Sie das, eine Doppelbelastung ist eine starke Grundlage für eine Gutschrift. Bitten Sie direkt um eine Rückerstattung oder Kontogutschrift und weisen Sie darauf hin, dass Sie das Add-on bereits gekündigt haben." },
      ],
    },
    { type: "image", src: `${IMG}/charged-for-order-flow-add-on-4.png`, alt: "Tradovate-Kontakt-Support-Formular zur Anfechtung einer ungewollten Order-Flow-Add-on-Belastung" },
    { type: "paragraph", html: "Bleiben Sie sachlich und konkret. Eine Nachricht, die die genaue Belastung benennt, die Daten zeigt und erklärt, warum sie nicht beabsichtigt war, ist weitaus überzeugender als eine vage Beschwerde. Handelt es sich um ein Prop- oder Evaluierungskonto, senden Sie dieselben Informationen stattdessen an den Support Ihrer Firma." },
    { type: "heading", text: "Fehlerbehebungstabelle" },
    {
      type: "table",
      headers: ["Symptom", "Was es bedeutet", "Lösung"],
      rows: [
        ["Posten „Order Flow +“ auf Ihrer Abrechnung", "Das kostenpflichtige Order-Flow+-Add-on ist aktiv und verlängert sich", "Schalten Sie es unter Application Settings › Add-Ons aus, fechten Sie dann vergangene Belastungen bei der Buchhaltung an"],
        ["Belastung, obwohl Sie sich nicht an eine Anmeldung erinnern", "Werkzeuge wurden nach dem Eigentümerwechsel in ein kostenpflichtiges Add-on umgepackt", "Prüfen Sie den Add-Ons-Reiter; kündigen Sie und fordern Sie eine Gutschrift für ungewollte Belastungen an"],
        ["Zahlen für das Add-on, obwohl Ihr Plan Order Flow+ als enthalten aufführt", "Doppelte Belastung für einen gebündelten Vorteil", "Kündigen Sie das eigenständige Add-on; nutzen Sie stattdessen die im Plan enthaltenen Werkzeuge"],
        ["Gekündigt, aber diesen Monat noch Zugriff", "Add-ons werden für den vollen Zyklus abgerechnet, nicht anteilig", "Normal, Sie behalten den Zugriff bis zum Zyklusende und werden nicht erneut belastet"],
        ["Belastung sowohl bei Tradovate als auch bei NinjaTrader", "Zweimal unter unterschiedlichen Logins abonniert", "Nutzen Sie eine Berechtigung unter Ihrem Tradovate-Benutzernamen; kündigen Sie das Duplikat"],
        ["Order-Flow-Belastung auf einem Prop-/Evaluierungskonto", "Add-ons werden dort von der Prop-Firma verwaltet", "Kontaktieren Sie den Support Ihrer Firma; Regeln variieren je nach Firma und Kontogröße"],
      ],
    },
    { type: "heading", text: "Wo PickMyTrade ins Spiel kommt" },
    { type: "paragraph", html: "Order-Flow-Indikatoren dienen dazu, den Markt mit dem Auge zu lesen. Wenn Ihr Vorteil eine definierte, regelbasierte Strategie ist, müssen Sie vielleicht gar nicht auf Footprint-Balken starren, Sie brauchen, dass Ihre Signale zuverlässig Orders auslösen. Genau dort ersetzt Automatisierung viel manuelles Bildschirmbeobachten:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Unbeaufsichtigte Ausführung</strong>, PickMyTrade leitet Ihre TradingView-Alerts direkt an Ihr Tradovate-Konto weiter, sodass Ein- und Ausstiege nach Ihren Regeln ausgelöst werden, ohne dass Sie am Tape kleben.",
        "<strong class='text-white'>Weniger kostenpflichtige Extras zum Überwachen</strong>, wenn eine systematische Strategie das Lesen für Sie übernimmt, können Sie bewusst entscheiden, welche kostenpflichtigen Werkzeuge Sie wirklich behalten.",
        "<strong class='text-white'>Multi-Konto-Synchronisierung</strong>, spiegeln Sie dieselbe Strategie über mehrere Tradovate-Konten hinweg von einem einzigen Alert aus.",
        "<strong class='text-white'>Saubere Handelsaufzeichnungen</strong>, jede automatisierte Ausführung wird protokolliert, was auch das Überprüfen von Abrechnungen und Belastungen weit einfacher macht.",
      ],
    },
  ], es: [
    { type: "paragraph", html: "Abres tu extracto de Tradovate y ahí está: una partida de <strong class='text-white'>Order Flow</strong> u <strong class='text-white'>Order Flow +</strong> que no recuerdas haber aceptado. No son imaginaciones tuyas, y tampoco es un fallo aleatorio. Order Flow+ es un paquete de herramientas de pago, y si está activado en tu cuenta, se renueva por sí solo hasta que lo detienes. La versión corta de la solución: abre tu configuración de <strong class='text-white'>Add-Ons</strong> y desactiva Order Flow+ para que deje de renovarse, luego contacta con la facturación de Tradovate con tu extracto para impugnar el cargo que no pretendías hacer y pedir un crédito. Y aquí está la parte que sorprende a muchos: en los planes de cuenta más recientes, estas mismas herramientas vienen incluidas gratis, así que en muchos casos no deberías pagarlas por separado en absoluto." },
    { type: "quote", html: "Los precios de los complementos, los ciclos de facturación y las etiquetas de los menús cambian con el tiempo. Los pasos siguientes reflejan cómo funcionaban los Add-Ons y la facturación de Tradovate en el momento de escribir esto, pero Tradovate puede modificar las tarifas y renombrar las pantallas en cualquier momento. Confirma siempre el texto y los importes vigentes en tu propia cuenta antes de actuar." },
    {
      type: "checklist",
      heading: "Lista de verificación rápida para el cargo de Order Flow",
      items: [
        "<strong class='text-white'>¿Está Order Flow+ realmente activo?</strong> Abre Application Settings &rsaquo; Add-Ons y busca Order Flow+. Si aparece como suscrito, esa es tu partida.",
        "<strong class='text-white'>¿Tu plan ya lo incluye?</strong> Los planes más recientes con una cuenta de correduría en vivo incluyen las herramientas de order flow, pagar el complemento independiente además de eso es dinero desperdiciado.",
        "<strong class='text-white'>Desactívalo primero.</strong> Apaga el complemento antes que nada para que no pueda renovarse otro ciclo más.",
        "<strong class='text-white'>Después, impugna el cargo.</strong> Contacta con la facturación de Tradovate con tu extracto y las fechas, explica que no pretendías suscribirte y pide un reembolso o crédito.",
        "<strong class='text-white'>¿Usas también NinjaTrader?</strong> Un único derecho bajo tu nombre de usuario de Tradovate cubre ambos, no te suscribas una segunda vez y pagues dos veces.",
        "<strong class='text-white'>¿En una cuenta prop / de evaluación?</strong> Ahí los complementos los gestiona tu firma, no tú. Contacta con la firma, no con la facturación minorista de Tradovate.",
      ],
    },
    { type: "heading", text: "Qué es realmente el cargo de Order Flow" },
    { type: "paragraph", html: "Order Flow+ es el paquete premium de herramientas de análisis de order flow de Tradovate. Agrupa las funciones visuales de lectura de cinta en las que se apoyan los traders activos de futuros: <strong class='text-white'>barras volumétricas (footprint)</strong>, un indicador y herramienta de dibujo de <strong class='text-white'>volume profile</strong>, <strong class='text-white'>delta acumulado</strong>, <strong class='text-white'>VWAP</strong>, un detector de operaciones y un mapa de profundidad de mercado. No forman parte del gráfico básico que recibe todo el mundo, son un conjunto de herramientas distinto y de pago, por eso aparecen como una partida propia en el extracto." },
    { type: "paragraph", html: "El motivo por el que esto sorprende a tantas personas se remonta a la historia. Tradovate fue adquirida por NinjaTrader, y en los cambios de plataforma que siguieron, las herramientas de order flow se consolidaron en el complemento de pago Order Flow+. Las cuentas que antes tenían esas herramientas disponibles, o que se habían inscrito durante una promoción o prueba, acabaron con una suscripción recurrente. Nadie se sentó a suscribirse deliberadamente a una tarifa mensual, las herramientas simplemente se reempaquetaron detrás de una." },
    { type: "paragraph", html: "Sin embargo, hay un giro que juega a tu favor. Los planes de cuenta más recientes que vienen con una cuenta de correduría de Tradovate en vivo ahora incluyen las herramientas de Order Flow+ sin coste adicional, junto con cosas como el replay del mercado y el acceso a TradingView. Así que las mismas funciones que antes eran un extra de pago ya están incorporadas, para muchos planes actuales. Por eso vale la pena echar un segundo vistazo a un cargo continuo independiente de Order Flow+: puede que estés pagando por algo que tu plan ahora te ofrece gratis." },
    { type: "heading", text: "Por qué ves el cargo" },
    { type: "heading", text: "1. El complemento está activado en tu cuenta" },
    { type: "paragraph", html: "La causa más directa: Order Flow+ está habilitado en tus Add-Ons, por lo que se factura cada ciclo. Puede haberse activado durante la incorporación, en una prueba gratuita que se convirtió silenciosamente en de pago, o en una época en que las herramientas se vendían como un extra. Sea cual sea el origen, un complemento activo sigue cobrando hasta que alguien lo desactiva." },
    { type: "heading", text: "2. Las herramientas se reempaquetaron tras el cambio de propiedad" },
    { type: "paragraph", html: "Tras la adquisición por NinjaTrader, las funciones de order flow se reorganizaron en el producto de pago Order Flow+. Si tu cuenta es anterior a ese cambio, herramientas que antes considerabas &ldquo;simplemente parte de la plataforma&rdquo; pueden estar ahora tras una suscripción. El cargo parece nuevo porque el empaquetado es nuevo, no porque hayas hecho algo mal." },
    { type: "image", src: `${IMG}/charged-for-order-flow-add-on-2.png`, alt: "Pestaña Add-Ons de Application Settings de Tradovate mostrando el complemento Order Flow Plus con un interruptor de suscripción o activo" },
    { type: "heading", text: "3. Estás pagando por separado por algo que tu plan ya incluye" },
    { type: "paragraph", html: "Este es el que realmente le cuesta dinero a la gente. Si tienes un plan actual que ya incluye Order Flow+ <em>y</em> sigues teniendo activo el complemento independiente, puedes acabar pagando dos veces por las mismas herramientas. Confirmar lo que tu plan ya cubre suele ser aquí el mayor ahorro posible." },
    { type: "heading", text: "4. Te suscribiste una vez y lo olvidaste, y se renueva en un ciclo completo" },
    { type: "paragraph", html: "Los complementos no caducan silenciosamente. Una vez activo, Order Flow+ se renueva según su ciclo de facturación, normalmente un mes natural completo en lugar de un prorrateo diario, así que un clic puntual de &ldquo;voy a probar esto&rdquo; sigue cobrando mes tras mes hasta que lo cancelas." },
    { type: "heading", text: "5. Es una cuenta prop o de evaluación, y la firma controla los complementos" },
    { type: "paragraph", html: "En las cuentas de evaluación y financiadas de una firma prop, las herramientas de datos de mercado y los complementos los provisiona y factura la firma, no se autosuscriben a través de la configuración minorista de Tradovate. Si aparecen cargos de order flow en ese tipo de cuenta, es la firma, no la facturación minorista de Tradovate, con quien debes hablar. Lo que está incluido y lo que cuesta extra varía según la firma y el tamaño de la cuenta, así que consulta las reglas vigentes de tu firma." },
    { type: "heading", text: "Cómo detener e impugnar el cargo: paso a paso" },
    {
      type: "steps",
      items: [
        { title: "Confirma exactamente por qué se te está facturando", html: "Antes de impugnar nada, precisa el cargo. Abre tu historial de facturación o de suscripciones e identifica la línea de Order Flow+, el importe y la fecha en que se contabiliza cada ciclo. Saber exactamente qué se renueva y cuándo hace que tanto la cancelación como cualquier solicitud de reembolso sean más claras.<br><br>Inicia sesión en la plataforma web de Tradovate. Abre el historial de facturación, membresía o suscripciones de tu cuenta. Localiza la entrada de Order Flow+ y anota su importe y fecha de renovación. Haz una captura de pantalla o guárdala, la necesitarás si solicitas un reembolso." },
        { title: "Desactiva el complemento para que deje de renovarse", html: "Cancelar detiene la sangría. Hazlo antes de contactar con nadie, para que el cargo no pueda arrastrarse a otro ciclo mientras esperas una respuesta.<br><br>En la plataforma web, abre <strong class='text-white'>Application Settings</strong> en la esquina superior derecha de la pantalla. Abre la pestaña <strong class='text-white'>Add-Ons</strong>. Busca <strong class='text-white'>Order Flow+</strong> en la lista. Desactívalo / cancela la suscripción para que no se renueve el próximo ciclo. Confirma que el cambio se ha guardado y que el complemento ahora figura como inactivo.<br><br>Algo que debes saber: como los complementos suelen facturarse por el mes natural completo, es posible que conserves acceso a las herramientas hasta el final del ciclo actual y simplemente no vuelvas a ser facturado después. Eso es normal, no significa que la cancelación haya fallado." },
        { title: "Comprueba si tu plan ya incluye las herramientas", html: "Mientras estás en la configuración, revisa tu plan. Si tienes un plan actual que incluye Order Flow+ con una cuenta de correduría en vivo, no necesitas el complemento de pago en absoluto, mantenerlo activo solo duplica un beneficio que ya tienes. Si estás en un nivel antiguo o gratuito, valora si las herramientas merecen un cambio de plan frente a una tarifa independiente." },
        { title: "Contacta con facturación para impugnar el cargo y pedir un reembolso", html: "Desactivar el complemento detiene los cargos futuros, pero no revierte automáticamente los que ya has pagado. Para esos tienes que pedirlo, y los reembolsos se deciden caso por caso, así que cómo lo pides importa.<br><br>Contacta con la facturación de Tradovate mediante el chat en vivo de la aplicación o la página oficial de Contact Support. Indica claramente que se te facturó Order Flow+ sin que pretendieras suscribirte. Adjunta el extracto o la captura de pantalla del Paso 1 con los importes y las fechas. Si tu plan ya incluye las herramientas, dilo, un cargo duplicado es una base sólida para un crédito. Pide directamente un reembolso o crédito en la cuenta, y menciona que ya has cancelado el complemento." },
      ],
    },
    { type: "image", src: `${IMG}/charged-for-order-flow-add-on-4.png`, alt: "Formulario de facturación de Contact Support de Tradovate utilizado para impugnar un cargo no deseado del complemento Order Flow" },
    { type: "paragraph", html: "Sé objetivo y específico. Un mensaje que nombra el cargo exacto, muestra las fechas y explica por qué no era intencionado resulta mucho más convincente que una queja vaga. Si se trata de una cuenta prop o de evaluación, envía la misma información al soporte de tu firma en su lugar." },
    { type: "heading", text: "Tabla de solución de problemas" },
    {
      type: "table",
      headers: ["Síntoma", "Qué significa", "Solución"],
      rows: [
        ["Partida “Order Flow +” en tu extracto", "El complemento de pago Order Flow+ está activo y renovándose", "Desactívalo en Application Settings › Add-Ons y luego impugna los cargos pasados con facturación"],
        ["Cargo aunque no recuerdas haberte suscrito", "Las herramientas se reempaquetaron en un complemento de pago tras el cambio de propiedad", "Revisa la pestaña Add-Ons; cancela la suscripción y solicita un crédito por los cargos no pretendidos"],
        ["Pagas el complemento, pero tu plan indica Order Flow+ como incluido", "Cargo duplicado por un beneficio incluido", "Cancela el complemento independiente; usa en su lugar las herramientas incluidas en el plan"],
        ["Cancelado, pero sigues teniendo acceso este mes", "Los complementos se facturan por el ciclo completo, no prorrateado", "Normal, mantienes el acceso hasta el final del ciclo y no se te vuelve a cobrar"],
        ["Cargo tanto en Tradovate como en NinjaTrader", "Suscrito dos veces con inicios de sesión distintos", "Usa un único derecho bajo tu nombre de usuario de Tradovate; cancela el duplicado"],
        ["Cargo de order flow en una cuenta prop / de evaluación", "Ahí los complementos los gestiona la firma prop", "Contacta con el soporte de tu firma; las reglas varían según la firma y el tamaño de la cuenta"],
      ],
    },
    { type: "heading", text: "Dónde encaja PickMyTrade" },
    { type: "paragraph", html: "Los indicadores de order flow sirven para leer el mercado a simple vista. Si tu ventaja es una estrategia definida y basada en reglas, puede que no necesites mirar fijamente las barras footprint en absoluto, necesitas que tus señales disparen órdenes de forma fiable. Ahí es donde la automatización sustituye gran parte de la vigilancia manual de la pantalla:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Ejecución sin intervención manual</strong>, PickMyTrade enruta tus alertas de TradingView directamente a tu cuenta de Tradovate, de modo que las entradas y salidas se disparan según tus reglas sin que estés pegado a la cinta.",
        "<strong class='text-white'>Menos extras de pago que vigilar</strong>, cuando una estrategia sistemática hace la lectura por ti, puedes ser deliberado sobre qué herramientas de pago conservas realmente.",
        "<strong class='text-white'>Sincronización multi-cuenta</strong>, replica la misma estrategia en varias cuentas de Tradovate a partir de una sola alerta.",
        "<strong class='text-white'>Registros de operaciones limpios</strong>, cada ejecución automatizada queda registrada, lo que también facilita mucho revisar extractos y cargos.",
      ],
    },
  ], fr: [
    { type: "paragraph", html: "Vous ouvrez votre relevé Tradovate, et voilà : une ligne <strong class='text-white'>Order Flow</strong> ou <strong class='text-white'>Order Flow +</strong> dont vous ne vous souvenez pas avoir accepté les conditions. Vous ne rêvez pas, et ce n'est pas non plus un bug aléatoire. Order Flow+ est un ensemble d'outils payant, et s'il est activé sur votre compte, il se renouvelle tout seul jusqu'à ce que vous l'arrêtiez. La version courte de la solution : ouvrez vos réglages <strong class='text-white'>Add-Ons</strong> et désactivez Order Flow+ pour qu'il cesse de se renouveler, puis contactez la facturation Tradovate avec votre relevé pour contester le prélèvement que vous n'aviez pas voulu effectuer et demander un avoir. Et voici la partie qui surprend beaucoup de gens : sur les formules de compte plus récentes, ces mêmes outils sont désormais inclus gratuitement, donc dans bien des cas vous ne devriez pas du tout les payer séparément." },
    { type: "quote", html: "Les tarifs des modules, les cycles de facturation et les libellés des menus évoluent avec le temps. Les étapes ci-dessous reflètent le fonctionnement des Add-Ons et de la facturation de Tradovate au moment de la rédaction, mais Tradovate peut réviser les tarifs et renommer les écrans à tout moment. Vérifiez toujours le libellé et les montants actuels dans votre propre compte avant d'agir." },
    {
      type: "checklist",
      heading: "Liste de contrôle rapide pour le prélèvement Order Flow",
      items: [
        "<strong class='text-white'>Order Flow+ est-il vraiment actif ?</strong> Ouvrez Application Settings &rsaquo; Add-Ons et recherchez Order Flow+. S'il apparaît comme abonné, c'est votre ligne.",
        "<strong class='text-white'>Votre formule l'inclut-elle déjà ?</strong> Les formules récentes avec un compte de courtage réel intègrent les outils order flow, payer le module autonome en plus revient à gaspiller de l'argent.",
        "<strong class='text-white'>Désactivez-le d'abord.</strong> Coupez le module avant toute autre chose pour qu'il ne puisse pas se renouveler pour un cycle supplémentaire.",
        "<strong class='text-white'>Ensuite, contestez le prélèvement.</strong> Contactez la facturation Tradovate avec votre relevé et les dates, expliquez que vous n'aviez pas l'intention de vous abonner, et demandez un remboursement ou un avoir.",
        "<strong class='text-white'>Vous utilisez aussi NinjaTrader ?</strong> Un seul droit d'accès sous votre nom d'utilisateur Tradovate couvre les deux, ne vous abonnez pas une seconde fois pour payer deux fois.",
        "<strong class='text-white'>Sur un compte prop / d'évaluation ?</strong> Les modules y sont gérés par votre société, pas par vous. Contactez la société, pas la facturation grand public de Tradovate.",
      ],
    },
    { type: "heading", text: "Ce qu'est réellement le prélèvement Order Flow" },
    { type: "paragraph", html: "Order Flow+ est le pack premium d'outils d'analyse de flux d'ordres de Tradovate. Il regroupe les fonctionnalités visuelles de lecture de la bande utilisées par les traders de futures actifs : <strong class='text-white'>barres volumétriques (footprint)</strong>, un indicateur et outil de dessin <strong class='text-white'>volume profile</strong>, <strong class='text-white'>delta cumulé</strong>, <strong class='text-white'>VWAP</strong>, un détecteur de trades et une carte de profondeur de marché. Ces outils ne font pas partie du graphique de base fourni à tous, ce sont un ensemble d'outils distinct et payant, c'est pourquoi ils apparaissent comme leur propre ligne sur un relevé." },
    { type: "paragraph", html: "La raison pour laquelle cela surprend tant de gens tient à l'historique. Tradovate a été racheté par NinjaTrader, et dans les changements de plateforme qui ont suivi, les outils de flux d'ordres ont été regroupés dans le module payant Order Flow+. Les comptes qui disposaient autrefois de ces outils, ou qui y avaient adhéré lors d'une promotion ou d'un essai, se sont retrouvés avec un abonnement récurrent. Personne ne s'est délibérément inscrit à des frais mensuels, les outils ont simplement été reconditionnés derrière un abonnement." },
    { type: "paragraph", html: "Il y a cependant un rebondissement qui joue en votre faveur. Les formules de compte plus récentes accompagnées d'un compte de courtage Tradovate réel incluent désormais les outils Order Flow+ sans frais supplémentaires, aux côtés d'éléments comme le replay de marché et l'accès à TradingView. Ainsi, les mêmes fonctionnalités qui étaient autrefois payantes en supplément sont déjà intégrées pour de nombreuses formules actuelles. C'est ce qui rend un prélèvement Order Flow+ autonome et continu digne d'un second regard : vous payez peut-être pour quelque chose que votre formule vous offre désormais gratuitement." },
    { type: "heading", text: "Pourquoi vous voyez ce prélèvement" },
    { type: "heading", text: "1. Le module est activé sur votre compte" },
    { type: "paragraph", html: "La cause la plus directe : Order Flow+ est activé dans vos Add-Ons, ce qui entraîne une facturation à chaque cycle. Il a pu être activé lors de l'intégration, pendant une période d'essai gratuite qui s'est discrètement transformée en abonnement payant, ou à une époque où les outils étaient vendus en supplément. Quelle qu'en soit l'origine, un module actif continue de facturer jusqu'à ce que quelqu'un le désactive." },
    { type: "heading", text: "2. Les outils ont été reconditionnés après le changement de propriétaire" },
    { type: "paragraph", html: "Suite au rachat par NinjaTrader, les fonctionnalités de flux d'ordres ont été réorganisées dans le produit payant Order Flow+. Si votre compte est antérieur à ce changement, des outils que vous considériez auparavant comme &ldquo;faisant simplement partie de la plateforme&rdquo; peuvent désormais se trouver derrière un abonnement. Le prélèvement paraît nouveau parce que le conditionnement est nouveau, pas parce que vous avez fait quelque chose de mal." },
    { type: "image", src: `${IMG}/charged-for-order-flow-add-on-2.png`, alt: "Onglet Add-Ons des Application Settings de Tradovate affichant le module Order Flow Plus avec un bouton d'abonnement ou d'activation" },
    { type: "heading", text: "3. Vous payez séparément pour quelque chose que votre formule inclut désormais" },
    { type: "paragraph", html: "C'est celui qui coûte réellement de l'argent aux gens. Si vous êtes sur une formule actuelle qui intègre Order Flow+ <em>et</em> que le module autonome est toujours actif, vous pouvez être facturé deux fois pour les mêmes outils. Vérifier ce que votre formule couvre déjà est souvent la plus grande économie possible ici." },
    { type: "heading", text: "4. Vous vous êtes abonné une fois et vous avez oublié, et il se renouvelle sur un cycle complet" },
    { type: "paragraph", html: "Les modules n'expirent pas discrètement. Une fois actif, Order Flow+ se renouvelle selon son cycle de facturation, généralement un mois calendaire complet plutôt qu'un prorata journalier, si bien qu'un simple clic ponctuel &ldquo;laissez-moi essayer&rdquo; continue de facturer mois après mois jusqu'à ce que vous l'annuliez." },
    { type: "heading", text: "5. Il s'agit d'un compte prop ou d'évaluation, et c'est la société qui contrôle les modules" },
    { type: "paragraph", html: "Sur les comptes d'évaluation et financés d'une société de trading pour compte propre, les outils de données de marché et les modules sont fournis et facturés par la société, et non auto-souscrits via les réglages grand public de Tradovate. Si des prélèvements Order Flow apparaissent sur ce type de compte, c'est la société, et non la facturation grand public de Tradovate, qu'il faut contacter. Ce qui est inclus et ce qui coûte en supplément varie selon la société et la taille du compte, vérifiez donc les règles actuelles de votre société." },
    { type: "heading", text: "Comment arrêter et contester le prélèvement : étape par étape" },
    {
      type: "steps",
      items: [
        { title: "Vérifiez exactement ce qui vous est facturé", html: "Avant de contester quoi que ce soit, cernez précisément le prélèvement. Ouvrez votre historique de facturation ou d'abonnement et identifiez la ligne Order Flow+, le montant et la date à laquelle il est prélevé à chaque cycle. Savoir précisément ce qui se renouvelle, et quand, rend la résiliation et toute demande de remboursement plus nettes.<br><br>Connectez-vous à la plateforme web Tradovate. Ouvrez l'historique de facturation, d'adhésion ou d'abonnement de votre compte. Repérez l'entrée Order Flow+ et notez son montant et sa date de renouvellement. Faites une capture d'écran ou enregistrez-la, vous en aurez besoin si vous demandez un remboursement." },
        { title: "Désactivez le module pour qu'il cesse de se renouveler", html: "Résilier stoppe l'hémorragie. Faites-le avant de contacter qui que ce soit, afin que le prélèvement ne puisse pas basculer sur un autre cycle pendant que vous attendez une réponse.<br><br>Sur la plateforme web, ouvrez <strong class='text-white'>Application Settings</strong> dans le coin supérieur droit de l'écran. Ouvrez l'onglet <strong class='text-white'>Add-Ons</strong>. Repérez <strong class='text-white'>Order Flow+</strong> dans la liste. Désactivez-le / résiliez-le pour qu'il ne se renouvelle pas au cycle suivant. Vérifiez que la modification est enregistrée et que le module s'affiche désormais comme inactif.<br><br>Un point à savoir : comme les modules facturent généralement le mois calendaire entier, vous pouvez conserver l'accès aux outils jusqu'à la fin du cycle en cours et simplement ne plus être facturé ensuite. C'est normal, cela ne signifie pas que la résiliation a échoué." },
        { title: "Vérifiez si votre formule inclut déjà les outils", html: "Pendant que vous êtes dans les réglages, examinez votre formule. Si vous êtes sur une formule actuelle qui intègre Order Flow+ avec un compte de courtage réel, vous n'avez pas du tout besoin du module payant, le garder actif ne fait que dupliquer un avantage que vous avez déjà. Si vous êtes sur un niveau plus ancien ou gratuit, évaluez si les outils valent un changement de formule plutôt qu'un tarif autonome." },
        { title: "Contactez la facturation pour contester le prélèvement et demander un remboursement", html: "Désactiver le module arrête les prélèvements futurs, mais n'annule pas automatiquement ceux déjà payés. Pour ceux-là, il faut le demander, et les remboursements sont décidés au cas par cas, la façon dont vous le demandez compte donc.<br><br>Contactez la facturation Tradovate via le chat en direct de l'application ou la page officielle Contact Support. Indiquez clairement que vous avez été facturé pour Order Flow+ sans avoir eu l'intention de vous y abonner. Joignez le relevé ou la capture d'écran de l'étape 1 avec les montants et les dates. Si votre formule inclut déjà les outils, dites-le, un prélèvement en double est un argument solide pour un avoir. Demandez directement un remboursement ou un avoir sur le compte, et précisez que vous avez déjà résilié le module." },
      ],
    },
    { type: "image", src: `${IMG}/charged-for-order-flow-add-on-4.png`, alt: "Formulaire de facturation Contact Support de Tradovate utilisé pour contester un prélèvement non désiré du module Order Flow" },
    { type: "paragraph", html: "Restez factuel et précis. Un message qui nomme le prélèvement exact, indique les dates et explique pourquoi il n'était pas voulu est bien plus convaincant qu'une plainte vague. S'il s'agit d'un compte prop ou d'évaluation, envoyez plutôt les mêmes informations au support de votre société." },
    { type: "heading", text: "Tableau de dépannage" },
    {
      type: "table",
      headers: ["Symptôme", "Ce que cela signifie", "Solution"],
      rows: [
        ["Ligne « Order Flow + » sur votre relevé", "Le module payant Order Flow+ est actif et se renouvelle", "Désactivez-le dans Application Settings › Add-Ons, puis contestez les prélèvements passés auprès de la facturation"],
        ["Prélèvement alors que vous ne vous souvenez pas de vous être abonné", "Les outils ont été reconditionnés dans un module payant après le changement de propriétaire", "Vérifiez l'onglet Add-Ons ; résiliez et demandez un avoir pour les prélèvements non voulus"],
        ["Vous payez le module alors que votre formule liste Order Flow+ comme inclus", "Prélèvement en double pour un avantage inclus", "Résiliez le module autonome ; utilisez plutôt les outils inclus dans la formule"],
        ["Résilié, mais toujours l'accès ce mois-ci", "Les modules sont facturés pour le cycle complet, sans prorata", "Normal, vous gardez l'accès jusqu'à la fin du cycle et n'êtes plus facturé"],
        ["Facturé à la fois sur Tradovate et NinjaTrader", "Abonné deux fois sous des connexions différentes", "Utilisez un seul droit d'accès sous votre nom d'utilisateur Tradovate ; résiliez le doublon"],
        ["Prélèvement Order Flow sur un compte prop / d'évaluation", "Les modules y sont gérés par la société de trading pour compte propre", "Contactez le support de votre société ; les règles varient selon la société et la taille du compte"],
      ],
    },
    { type: "heading", text: "Où PickMyTrade entre en jeu" },
    { type: "paragraph", html: "Les indicateurs de flux d'ordres servent à lire le marché à l'œil nu. Si votre avantage est une stratégie définie et basée sur des règles, vous n'avez peut-être pas besoin de fixer des barres footprint du tout, vous avez besoin que vos signaux déclenchent des ordres de façon fiable. C'est là que l'automatisation remplace une grande partie de la surveillance manuelle de l'écran :" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Exécution sans intervention</strong>, PickMyTrade envoie vos alertes TradingView directement vers votre compte Tradovate, afin que les entrées et sorties se déclenchent selon vos règles sans que vous soyez collé à la bande.",
        "<strong class='text-white'>Moins d'extras payants à surveiller</strong>, lorsqu'une stratégie systématique fait la lecture à votre place, vous pouvez décider délibérément quels outils payants vous conservez réellement.",
        "<strong class='text-white'>Synchronisation multi-comptes</strong>, répliquez la même stratégie sur plusieurs comptes Tradovate à partir d'une seule alerte.",
        "<strong class='text-white'>Historique de trades propre</strong>, chaque exécution automatisée est enregistrée, ce qui facilite grandement la vérification des relevés et des prélèvements.",
      ],
    },
  ], it: [
    { type: "paragraph", html: "Apri il tuo estratto conto Tradovate ed eccola lì: una voce <strong class='text-white'>Order Flow</strong> o <strong class='text-white'>Order Flow +</strong> di cui non ricordi di aver accettato l'iscrizione. Non te lo stai immaginando, e non è nemmeno un errore casuale. Order Flow+ è un pacchetto di strumenti a pagamento, e se è attivo sul tuo conto si rinnova da solo finché non lo interrompi. La versione breve della soluzione: apri le impostazioni <strong class='text-white'>Add-Ons</strong> e disattiva Order Flow+ così che smetta di rinnovarsi, poi contatta la fatturazione di Tradovate con il tuo estratto conto per contestare l'addebito non voluto e chiedere un credito. Ed ecco la parte che coglie molti di sorpresa: nei piani di conto più recenti questi stessi strumenti sono inclusi gratuitamente, quindi in molti casi non dovresti pagarli separatamente affatto." },
    { type: "quote", html: "I prezzi dei componenti aggiuntivi, i cicli di fatturazione e le etichette dei menu cambiano nel tempo. I passaggi seguenti riflettono il funzionamento degli Add-Ons e della fatturazione di Tradovate al momento della stesura, ma Tradovate può rivedere le tariffe e rinominare le schermate in qualsiasi momento. Verifica sempre la dicitura e gli importi attuali nel tuo account prima di agire." },
    {
      type: "checklist",
      heading: "Elenco di controllo rapido per l'addebito Order Flow",
      items: [
        "<strong class='text-white'>Order Flow+ è davvero attivo?</strong> Apri Application Settings &rsaquo; Add-Ons e cerca Order Flow+. Se risulta come abbonato, è quella la tua voce.",
        "<strong class='text-white'>Il tuo piano lo include già?</strong> I piani più recenti con un conto di brokeraggio live includono già gli strumenti order flow, pagare in aggiunta il componente aggiuntivo autonomo è denaro sprecato.",
        "<strong class='text-white'>Disattivalo per primo.</strong> Spegni il componente aggiuntivo prima di ogni altra cosa così non potrà rinnovarsi per un altro ciclo.",
        "<strong class='text-white'>Poi contesta l'addebito.</strong> Contatta la fatturazione di Tradovate con il tuo estratto conto e le date, spiega che non intendevi iscriverti e chiedi un rimborso o un credito.",
        "<strong class='text-white'>Usi anche NinjaTrader?</strong> Un unico diritto sotto il tuo nome utente Tradovate copre entrambi, non iscriverti una seconda volta pagando due volte.",
        "<strong class='text-white'>Su un conto prop / di valutazione?</strong> Lì i componenti aggiuntivi sono gestiti dalla tua società, non da te. Contatta la società, non la fatturazione retail di Tradovate.",
      ],
    },
    { type: "heading", text: "Cos'è realmente l'addebito Order Flow" },
    { type: "paragraph", html: "Order Flow+ è il pacchetto premium di Tradovate di strumenti per l'analisi dell'order flow. Racchiude le funzioni visive di lettura del tape su cui fanno affidamento i trader di futures attivi: <strong class='text-white'>barre volumetriche (footprint)</strong>, un indicatore e strumento di disegno <strong class='text-white'>volume profile</strong>, <strong class='text-white'>delta cumulativo</strong>, <strong class='text-white'>VWAP</strong>, un rilevatore di operazioni e una mappa di profondità di mercato. Questi non fanno parte del charting di base che ricevono tutti, sono un insieme di strumenti distinto e a pagamento, motivo per cui compaiono come una voce a sé nell'estratto conto." },
    { type: "paragraph", html: "Il motivo per cui questo sorprende così tante persone risale alla storia. Tradovate è stata acquisita da NinjaTrader, e nei cambiamenti di piattaforma che ne sono seguiti, gli strumenti di order flow sono stati consolidati nel componente aggiuntivo a pagamento Order Flow+. I conti che un tempo avevano quegli strumenti disponibili, o che avevano aderito durante una promozione o una prova, si sono ritrovati con un abbonamento ricorrente. Nessuno si è seduto e ha deliberatamente sottoscritto una tariffa mensile, gli strumenti sono stati semplicemente riconfezionati dietro un abbonamento." },
    { type: "paragraph", html: "C'è però un colpo di scena a tuo favore. I piani di conto più recenti che includono un conto di brokeraggio Tradovate live ora comprendono gli strumenti Order Flow+ senza costi aggiuntivi, insieme a cose come il replay di mercato e l'accesso a TradingView. Quindi le stesse funzionalità che un tempo erano un extra a pagamento sono, per molti piani attuali, già incluse. Questo è ciò che rende utile dare una seconda occhiata a un addebito Order Flow+ autonomo e continuo: potresti star pagando per qualcosa che il tuo piano ora ti offre gratuitamente." },
    { type: "heading", text: "Perché vedi l'addebito" },
    { type: "heading", text: "1. Il componente aggiuntivo è attivo sul tuo conto" },
    { type: "paragraph", html: "La causa più diretta: Order Flow+ è abilitato nei tuoi Add-Ons, quindi viene fatturato a ogni ciclo. Potrebbe essere stato attivato durante l'onboarding, in una finestra di prova gratuita che si è silenziosamente convertita in pagamento, oppure in un periodo in cui gli strumenti venivano venduti come extra. Qualunque sia l'origine, un componente aggiuntivo attivo continua ad addebitare finché qualcuno non lo disattiva." },
    { type: "heading", text: "2. Gli strumenti sono stati riconfezionati dopo il cambio di proprietà" },
    { type: "paragraph", html: "In seguito all'acquisizione da parte di NinjaTrader, le funzionalità di order flow sono state riorganizzate nel prodotto a pagamento Order Flow+. Se il tuo conto è precedente a quel cambiamento, strumenti che consideravi &ldquo;semplicemente parte della piattaforma&rdquo; potrebbero ora trovarsi dietro un abbonamento. L'addebito sembra nuovo perché il confezionamento è nuovo, non perché tu abbia fatto qualcosa di sbagliato." },
    { type: "image", src: `${IMG}/charged-for-order-flow-add-on-2.png`, alt: "Scheda Add-Ons di Application Settings di Tradovate che mostra il componente aggiuntivo Order Flow Plus con un interruttore di iscrizione o attivo" },
    { type: "heading", text: "3. Stai pagando separatamente per qualcosa che il tuo piano ora include" },
    { type: "paragraph", html: "Questo è quello che costa davvero denaro alle persone. Se hai un piano attuale che include Order Flow+ <em>e</em> hai ancora attivo il componente aggiuntivo autonomo, puoi essere addebitato due volte per gli stessi strumenti. Verificare cosa copre già il tuo piano è spesso il risparmio più grande possibile qui." },
    { type: "heading", text: "4. Ti sei iscritto una volta e te ne sei dimenticato, e si rinnova su un ciclo completo" },
    { type: "paragraph", html: "I componenti aggiuntivi non scadono silenziosamente. Una volta attivo, Order Flow+ si rinnova secondo il proprio ciclo di fatturazione, tipicamente un mese di calendario completo anziché un rateo giornaliero, quindi un clic occasionale del tipo &ldquo;fammi provare&rdquo; continua ad addebitare mese dopo mese finché non lo annulli." },
    { type: "heading", text: "5. Si tratta di un conto prop o di valutazione, e la società controlla i componenti aggiuntivi" },
    { type: "paragraph", html: "Sui conti di valutazione e finanziati di una prop firm, gli strumenti sui dati di mercato e i componenti aggiuntivi vengono forniti e fatturati dalla società, non auto-sottoscritti tramite le impostazioni retail di Tradovate. Se compaiono addebiti Order Flow su questo tipo di conto, è la società, non la fatturazione retail di Tradovate, con cui parlare. Ciò che è incluso e ciò che costa extra varia in base alla società e alla dimensione del conto, quindi verifica le regole attuali della tua società." },
    { type: "heading", text: "Come interrompere e contestare l'addebito: passo dopo passo" },
    {
      type: "steps",
      items: [
        { title: "Verifica esattamente per cosa vieni fatturato", html: "Prima di contestare qualsiasi cosa, individua con precisione l'addebito. Apri la cronologia di fatturazione o degli abbonamenti e identifica la voce Order Flow+, l'importo e la data in cui viene registrato ogni ciclo. Sapere esattamente cosa si rinnova, e quando, rende sia la cancellazione sia qualsiasi richiesta di rimborso più chiare.<br><br>Accedi alla piattaforma web di Tradovate. Apri la cronologia di fatturazione, abbonamento o iscrizione del tuo conto. Individua la voce Order Flow+ e annota l'importo e la data di rinnovo. Fai uno screenshot o salvala, ti servirà se richiedi un rimborso." },
        { title: "Disattiva il componente aggiuntivo così smette di rinnovarsi", html: "Annullare l'abbonamento ferma l'emorragia. Fallo prima di contattare chiunque, così l'addebito non può scivolare in un altro ciclo mentre aspetti una risposta.<br><br>Nella piattaforma web, apri <strong class='text-white'>Application Settings</strong> nell'angolo in alto a destra dello schermo. Apri la scheda <strong class='text-white'>Add-Ons</strong>. Trova <strong class='text-white'>Order Flow+</strong> nell'elenco. Disattivalo / annulla l'iscrizione così non si rinnoverà al ciclo successivo. Verifica che la modifica sia salvata e che il componente aggiuntivo risulti ora inattivo.<br><br>Una cosa da sapere: poiché i componenti aggiuntivi di solito fatturano l'intero mese di calendario, potresti mantenere l'accesso agli strumenti fino alla fine del ciclo corrente e semplicemente non essere più addebitato in seguito. È normale, non significa che la cancellazione sia fallita." },
        { title: "Verifica se il tuo piano include già gli strumenti", html: "Mentre sei nelle impostazioni, dai un'occhiata al tuo piano. Se hai un piano attuale che include Order Flow+ con un conto di brokeraggio live, non ti serve affatto il componente aggiuntivo a pagamento, mantenerlo attivo duplica solo un vantaggio che hai già. Se sei su un livello più vecchio o gratuito, valuta se gli strumenti valgono un cambio di piano rispetto a una tariffa autonoma." },
        { title: "Contatta la fatturazione per contestare l'addebito e chiedere un rimborso", html: "Disattivare il componente aggiuntivo ferma gli addebiti futuri, ma non annulla automaticamente quelli già pagati. Per quelli devi fare richiesta, e i rimborsi vengono decisi caso per caso, quindi il modo in cui chiedi conta.<br><br>Contatta la fatturazione di Tradovate tramite la chat live in-app o la pagina ufficiale Contact Support. Dichiara chiaramente di essere stato addebitato per Order Flow+ senza aver inteso iscriverti. Allega l'estratto conto o lo screenshot del Passo 1 con importi e date. Se il tuo piano include già gli strumenti, dillo, un addebito duplicato è una base solida per un credito. Chiedi direttamente un rimborso o un credito sul conto, e specifica che hai già annullato il componente aggiuntivo." },
      ],
    },
    { type: "image", src: `${IMG}/charged-for-order-flow-add-on-4.png`, alt: "Modulo di fatturazione Contact Support di Tradovate usato per contestare un addebito non voluto del componente aggiuntivo Order Flow" },
    { type: "paragraph", html: "Resta fattuale e specifico. Un messaggio che indica l'addebito esatto, mostra le date e spiega perché non era voluto è molto più persuasivo di un reclamo vago. Se si tratta di un conto prop o di valutazione, invia le stesse informazioni al supporto della tua società." },
    { type: "heading", text: "Tabella di risoluzione dei problemi" },
    {
      type: "table",
      headers: ["Sintomo", "Cosa significa", "Soluzione"],
      rows: [
        ["Voce “Order Flow +” nel tuo estratto conto", "Il componente aggiuntivo a pagamento Order Flow+ è attivo e si rinnova", "Disattivalo in Application Settings › Add-Ons, poi contesta gli addebiti passati con la fatturazione"],
        ["Addebito anche se non ricordi di esserti iscritto", "Gli strumenti sono stati riconfezionati in un componente aggiuntivo a pagamento dopo il cambio di proprietà", "Controlla la scheda Add-Ons; annulla l'iscrizione e richiedi un credito per gli addebiti non voluti"],
        ["Paghi il componente aggiuntivo ma il tuo piano elenca Order Flow+ come incluso", "Addebito duplicato per un vantaggio già incluso", "Annulla il componente aggiuntivo autonomo; usa invece gli strumenti inclusi nel piano"],
        ["Annullato, ma hai ancora accesso questo mese", "I componenti aggiuntivi fatturano l'intero ciclo, senza rateo", "Normale, mantieni l'accesso fino alla fine del ciclo e non verrai riaddebitato"],
        ["Addebitato sia su Tradovate che su NinjaTrader", "Iscritto due volte con login diversi", "Usa un unico diritto sotto il tuo nome utente Tradovate; annulla il duplicato"],
        ["Addebito Order Flow su un conto prop / di valutazione", "Lì i componenti aggiuntivi sono gestiti dalla prop firm", "Contatta il supporto della tua società; le regole variano in base alla società e alla dimensione del conto"],
      ],
    },
    { type: "heading", text: "Dove si inserisce PickMyTrade" },
    { type: "paragraph", html: "Gli indicatori di order flow servono per leggere il mercato a occhio. Se il tuo vantaggio è una strategia definita e basata su regole, potresti non aver affatto bisogno di fissare le barre footprint, ti serve che i tuoi segnali facciano scattare ordini in modo affidabile. È lì che l'automazione sostituisce gran parte del monitoraggio manuale dello schermo:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Esecuzione senza intervento manuale</strong>, PickMyTrade instrada i tuoi alert di TradingView direttamente al tuo conto Tradovate, così le entrate e le uscite scattano secondo le tue regole senza che tu resti incollato al tape.",
        "<strong class='text-white'>Meno extra a pagamento da tenere sotto controllo</strong>, quando una strategia sistematica fa la lettura al posto tuo, puoi decidere consapevolmente quali strumenti a pagamento tenere davvero.",
        "<strong class='text-white'>Sincronizzazione multi-conto</strong>, specchia la stessa strategia su più conti Tradovate a partire da un unico alert.",
        "<strong class='text-white'>Registri di operazioni puliti</strong>, ogni esecuzione automatizzata viene registrata, il che rende anche molto più facile controllare estratti conto e addebiti.",
      ],
    },
  ] },
  ctaHeading: { en: "Automate Your Tradovate Orders", de: "Automatisieren Sie Ihre Tradovate-Orders", es: "Automatiza tus órdenes de Tradovate", fr: "Automatisez vos ordres Tradovate", it: "Automatizza i tuoi ordini Tradovate" },
  ctaText: { en: "Stop paying for tools you're not using to watch the tape. Let PickMyTrade route your TradingView signals straight to Tradovate.", de: "Hören Sie auf, für Werkzeuge zu zahlen, mit denen Sie ohnehin nicht das Tape beobachten. Lassen Sie PickMyTrade Ihre TradingView-Signale direkt an Tradovate weiterleiten.", es: "Deja de pagar por herramientas que no usas para vigilar la cinta. Deja que PickMyTrade enrute tus señales de TradingView directamente a Tradovate.", fr: "Arrêtez de payer pour des outils que vous n'utilisez pas pour surveiller la bande. Laissez PickMyTrade envoyer vos signaux TradingView directement vers Tradovate.", it: "Smetti di pagare per strumenti che non usi per osservare il tape. Lascia che PickMyTrade instradi i tuoi segnali di TradingView direttamente a Tradovate." },
  ctaButtonText: { en: "Start Your Free 7-Day Trial", de: "Starten Sie Ihre kostenlose 5-Tage-Testphase", es: "Inicia tu prueba gratuita de 5 días", fr: "Démarrez votre essai gratuit de 5 jours", it: "Inizia la tua prova gratuita di 5 giorni" },
  ctaUrl: "https://app.pickmytrade.trade/?register=true&utm_source=content&utm_medium=debugging",
  faqHeading: { en: "Frequently Asked Questions", de: "Häufig gestellte Fragen", es: "Preguntas frecuentes", fr: "Questions fréquentes", it: "Domande frequenti" },
  faqs: { en: [
    { q: "What is the Order Flow charge on my Tradovate account?", a: "It's the subscription fee for Order Flow+, a paid tools package that adds footprint (volumetric) bars, volume profile, cumulative delta, VWAP and related order-flow indicators. If it's active on your account, it renews on its own billing cycle until you turn it off." },
    { q: "Why am I being charged if I never signed up for Order Flow+?", a: "The order-flow tools were reorganized into a paid Order Flow+ package during the platform changes that followed the NinjaTrader acquisition. Accounts that had those tools switched on, or that opted in at some point, can carry the recurring charge even if you don't remember choosing it. Check your Add-Ons settings to see whether it's active." },
    { q: "How do I remove the Order Flow+ add-on?", a: "Log in to the Tradovate web platform, open Application Settings from the upper-right corner, open the Add-Ons tab, find Order Flow+ and switch it off so it stops renewing. Confirm the exact wording in the current platform, since Tradovate updates these menus over time." },
    { q: "Can I get a refund for an Order Flow charge I didn't authorize?", a: "Refunds are handled case by case. Turn the add-on off first, then contact Tradovate billing through in-app chat or the Contact Support page with your statement and dates, explain that you didn't intend to subscribe, and ask for a credit or refund. There's no guarantee, but a clear, documented request is far more likely to succeed." },
    { q: "Isn't Order Flow+ free now?", a: "On newer account plans with a live brokerage account, the Order Flow+ tools are bundled in at no extra cost. If you're still being billed separately for the add-on, you may be paying twice, moving to or confirming the right plan can remove the standalone charge." },
    { q: "When does the charge stop after I unsubscribe?", a: "Add-on subscriptions generally bill for the full calendar month rather than prorating to the day you cancel, so you may keep access through the end of the current cycle and simply not be billed again after that. Confirm the current terms on your billing screen." },
    { q: "I'm on a prop-firm evaluation account and see order-flow charges. What do I do?", a: "On evaluation and funded prop accounts, add-ons and market-data tools are handled by the prop firm rather than self-subscribed through Tradovate retail billing. Contact your firm's support to review or remove the charge. Rules and pricing vary by firm and account size, so check your firm's current terms." },
    { q: "Will I be charged twice if I use the tools in both Tradovate and NinjaTrader?", a: "You shouldn't need to pay twice. An Order Flow+ entitlement tied to your Tradovate username carries over when you sign in to NinjaTrader with that same username. Subscribing a second time under a different login is the usual way people end up double-paying." },
  ], de: [
    { q: "Was ist die Order-Flow-Belastung auf meinem Tradovate-Konto?", a: "Das ist die Abonnementgebühr für Order Flow+, ein kostenpflichtiges Tools-Paket, das Footprint-Balken (volumetrisch), Volume Profile, Cumulative Delta, VWAP und verwandte Order-Flow-Indikatoren hinzufügt. Ist es auf Ihrem Konto aktiv, verlängert es sich nach seinem eigenen Abrechnungszyklus, bis Sie es ausschalten." },
    { q: "Warum werde ich belastet, wenn ich mich nie für Order Flow+ angemeldet habe?", a: "Die Order-Flow-Werkzeuge wurden während der Plattformänderungen nach der NinjaTrader-Übernahme in ein kostenpflichtiges Order-Flow+-Paket umorganisiert. Konten, bei denen diese Werkzeuge aktiviert waren oder die irgendwann zugestimmt haben, können die wiederkehrende Belastung tragen, selbst wenn Sie sich nicht erinnern, sie gewählt zu haben. Prüfen Sie Ihre Add-Ons-Einstellungen, um zu sehen, ob es aktiv ist." },
    { q: "Wie entferne ich das Order-Flow+-Add-on?", a: "Melden Sie sich bei der Tradovate-Webplattform an, öffnen Sie Application Settings oben rechts, öffnen Sie den Reiter Add-Ons, suchen Sie Order Flow+ und schalten Sie es aus, damit es sich nicht mehr verlängert. Bestätigen Sie den genauen Wortlaut in der aktuellen Plattform, da Tradovate diese Menüs im Laufe der Zeit aktualisiert." },
    { q: "Kann ich eine Rückerstattung für eine nicht autorisierte Order-Flow-Belastung erhalten?", a: "Rückerstattungen werden von Fall zu Fall behandelt. Schalten Sie zuerst das Add-on aus, kontaktieren Sie dann die Tradovate-Buchhaltung über den In-App-Chat oder die Contact-Support-Seite mit Ihrer Abrechnung und den Daten, erklären Sie, dass Sie nicht beabsichtigt haben zu abonnieren, und bitten Sie um eine Gutschrift oder Rückerstattung. Es gibt keine Garantie, aber eine klare, dokumentierte Anfrage hat weit größere Erfolgsaussichten." },
    { q: "Ist Order Flow+ nicht inzwischen kostenlos?", a: "Bei neueren Kontoplänen mit einem Live-Brokerage-Konto sind die Order-Flow+-Werkzeuge ohne Aufpreis enthalten. Werden Sie weiterhin separat für das Add-on belastet, zahlen Sie womöglich doppelt, ein Wechsel zum oder die Bestätigung des richtigen Plans kann die eigenständige Belastung beseitigen." },
    { q: "Wann endet die Belastung, nachdem ich gekündigt habe?", a: "Add-on-Abonnements werden in der Regel für den gesamten Kalendermonat berechnet, statt auf den Kündigungstag anteilig herunterzurechnen, sodass Sie bis zum Ende des aktuellen Zyklus Zugriff behalten und danach einfach nicht mehr belastet werden. Bestätigen Sie die aktuellen Bedingungen auf Ihrem Abrechnungsbildschirm." },
    { q: "Ich habe ein Prop-Firm-Evaluierungskonto und sehe Order-Flow-Belastungen. Was tue ich?", a: "Bei Evaluierungs- und finanzierten Prop-Konten werden Add-ons und Marktdatenwerkzeuge von der Prop-Firma verwaltet und nicht selbst über die Tradovate-Privatkundenbuchhaltung abonniert. Kontaktieren Sie den Support Ihrer Firma, um die Belastung zu überprüfen oder zu entfernen. Regeln und Preise variieren je nach Firma und Kontogröße, prüfen Sie also die aktuellen Bedingungen Ihrer Firma." },
    { q: "Werde ich doppelt belastet, wenn ich die Werkzeuge sowohl in Tradovate als auch in NinjaTrader nutze?", a: "Sie sollten nicht doppelt zahlen müssen. Eine an Ihren Tradovate-Benutzernamen gebundene Order-Flow+-Berechtigung überträgt sich, wenn Sie sich mit demselben Benutzernamen bei NinjaTrader anmelden. Ein zweites Abonnement unter einem anderen Login ist der übliche Weg, wie Menschen am Ende doppelt zahlen." },
  ], es: [
    { q: "¿Qué es el cargo de Order Flow en mi cuenta de Tradovate?", a: "Es la tarifa de suscripción de Order Flow+, un paquete de herramientas de pago que añade barras footprint (volumétricas), volume profile, delta acumulado, VWAP e indicadores de order flow relacionados. Si está activo en tu cuenta, se renueva según su propio ciclo de facturación hasta que lo desactivas." },
    { q: "¿Por qué se me cobra si nunca me suscribí a Order Flow+?", a: "Las herramientas de order flow se reorganizaron en un paquete de pago Order Flow+ durante los cambios de plataforma que siguieron a la adquisición por NinjaTrader. Las cuentas que tenían esas herramientas activadas, o que se inscribieron en algún momento, pueden arrastrar el cargo recurrente aunque no recuerdes haberlo elegido. Comprueba tu configuración de Add-Ons para ver si está activo." },
    { q: "¿Cómo elimino el complemento Order Flow+?", a: "Inicia sesión en la plataforma web de Tradovate, abre Application Settings en la esquina superior derecha, abre la pestaña Add-Ons, busca Order Flow+ y desactívalo para que deje de renovarse. Confirma el texto exacto en la plataforma actual, ya que Tradovate actualiza estos menús con el tiempo." },
    { q: "¿Puedo obtener un reembolso por un cargo de Order Flow que no autoricé?", a: "Los reembolsos se gestionan caso por caso. Desactiva primero el complemento, luego contacta con la facturación de Tradovate mediante el chat en la app o la página de Contact Support con tu extracto y las fechas, explica que no pretendías suscribirte y pide un crédito o reembolso. No hay garantía, pero una solicitud clara y documentada tiene muchas más probabilidades de éxito." },
    { q: "¿No es ya gratis Order Flow+?", a: "En los planes de cuenta más recientes con una cuenta de correduría en vivo, las herramientas de Order Flow+ vienen incluidas sin coste adicional. Si sigues siendo facturado por separado por el complemento, puede que estés pagando dos veces, pasarte al plan adecuado o confirmarlo puede eliminar el cargo independiente." },
    { q: "¿Cuándo cesa el cargo tras cancelar la suscripción?", a: "Las suscripciones de complementos generalmente se facturan por el mes natural completo en lugar de prorratearse hasta el día en que cancelas, así que puedes conservar el acceso hasta el final del ciclo actual y simplemente no volver a ser facturado después. Confirma las condiciones vigentes en tu pantalla de facturación." },
    { q: "Tengo una cuenta de evaluación de una firma prop y veo cargos de order flow. ¿Qué hago?", a: "En las cuentas de evaluación y financiadas de firmas prop, los complementos y las herramientas de datos de mercado los gestiona la firma prop en lugar de autosuscribirse a través de la facturación minorista de Tradovate. Contacta con el soporte de tu firma para revisar o eliminar el cargo. Las reglas y los precios varían según la firma y el tamaño de la cuenta, así que consulta las condiciones vigentes de tu firma." },
    { q: "¿Se me cobrará dos veces si uso las herramientas tanto en Tradovate como en NinjaTrader?", a: "No deberías necesitar pagar dos veces. Un derecho de Order Flow+ vinculado a tu nombre de usuario de Tradovate se traslada cuando inicias sesión en NinjaTrader con ese mismo nombre de usuario. Suscribirte una segunda vez con un inicio de sesión distinto es la forma habitual en que la gente acaba pagando doble." },
  ], fr: [
    { q: "Qu'est-ce que le prélèvement Order Flow sur mon compte Tradovate ?", a: "Il s'agit des frais d'abonnement d'Order Flow+, un ensemble d'outils payant qui ajoute des barres footprint (volumétriques), le volume profile, le delta cumulé, le VWAP et des indicateurs de flux d'ordres associés. S'il est actif sur votre compte, il se renouvelle selon son propre cycle de facturation jusqu'à ce que vous le désactiviez." },
    { q: "Pourquoi suis-je facturé alors que je ne me suis jamais inscrit à Order Flow+ ?", a: "Les outils de flux d'ordres ont été réorganisés en un pack payant Order Flow+ lors des changements de plateforme qui ont suivi le rachat par NinjaTrader. Les comptes qui avaient ces outils activés, ou qui y avaient adhéré à un moment donné, peuvent porter le prélèvement récurrent même si vous ne vous souvenez pas de l'avoir choisi. Vérifiez vos réglages Add-Ons pour voir s'il est actif." },
    { q: "Comment supprimer le module Order Flow+ ?", a: "Connectez-vous à la plateforme web Tradovate, ouvrez Application Settings dans le coin supérieur droit, ouvrez l'onglet Add-Ons, trouvez Order Flow+ et désactivez-le pour qu'il cesse de se renouveler. Vérifiez le libellé exact dans la plateforme actuelle, car Tradovate met à jour ces menus au fil du temps." },
    { q: "Puis-je obtenir un remboursement pour un prélèvement Order Flow que je n'ai pas autorisé ?", a: "Les remboursements sont traités au cas par cas. Désactivez d'abord le module, puis contactez la facturation Tradovate via le chat de l'application ou la page Contact Support avec votre relevé et les dates, expliquez que vous n'aviez pas l'intention de vous abonner, et demandez un avoir ou un remboursement. Il n'y a aucune garantie, mais une demande claire et documentée a bien plus de chances d'aboutir." },
    { q: "Order Flow+ n'est-il pas gratuit maintenant ?", a: "Sur les formules de compte plus récentes avec un compte de courtage réel, les outils Order Flow+ sont inclus sans frais supplémentaires. Si vous êtes toujours facturé séparément pour le module, vous payez peut-être deux fois, passer à la bonne formule ou la confirmer peut supprimer le prélèvement autonome." },
    { q: "Quand le prélèvement s'arrête-t-il après ma résiliation ?", a: "Les abonnements aux modules sont généralement facturés pour le mois calendaire complet plutôt qu'au prorata du jour de résiliation, vous pouvez donc conserver l'accès jusqu'à la fin du cycle en cours et simplement ne plus être facturé ensuite. Vérifiez les conditions actuelles sur votre écran de facturation." },
    { q: "J'ai un compte d'évaluation d'une société de trading pour compte propre et je vois des prélèvements Order Flow. Que dois-je faire ?", a: "Sur les comptes d'évaluation et financés d'une société de trading pour compte propre, les modules et les outils de données de marché sont gérés par la société plutôt qu'auto-souscrits via la facturation grand public de Tradovate. Contactez le support de votre société pour examiner ou supprimer le prélèvement. Les règles et les tarifs varient selon la société et la taille du compte, vérifiez donc les conditions actuelles de votre société." },
    { q: "Serai-je facturé deux fois si j'utilise les outils à la fois sur Tradovate et NinjaTrader ?", a: "Vous ne devriez pas avoir à payer deux fois. Un droit Order Flow+ lié à votre nom d'utilisateur Tradovate se reporte lorsque vous vous connectez à NinjaTrader avec ce même nom d'utilisateur. S'abonner une seconde fois sous une connexion différente est la façon habituelle dont les gens finissent par payer en double." },
  ], it: [
    { q: "Cos'è l'addebito Order Flow sul mio conto Tradovate?", a: "È la quota di abbonamento per Order Flow+, un pacchetto di strumenti a pagamento che aggiunge barre footprint (volumetriche), volume profile, delta cumulativo, VWAP e indicatori di order flow correlati. Se è attivo sul tuo conto, si rinnova secondo il proprio ciclo di fatturazione finché non lo disattivi." },
    { q: "Perché mi viene addebitato se non mi sono mai iscritto a Order Flow+?", a: "Gli strumenti di order flow sono stati riorganizzati in un pacchetto a pagamento Order Flow+ durante i cambiamenti di piattaforma seguiti all'acquisizione di NinjaTrader. I conti che avevano quegli strumenti attivati, o che avevano aderito a un certo punto, possono portare l'addebito ricorrente anche se non ricordi di averlo scelto. Controlla le impostazioni Add-Ons per vedere se è attivo." },
    { q: "Come rimuovo il componente aggiuntivo Order Flow+?", a: "Accedi alla piattaforma web di Tradovate, apri Application Settings nell'angolo in alto a destra, apri la scheda Add-Ons, trova Order Flow+ e disattivalo così smette di rinnovarsi. Verifica la dicitura esatta nella piattaforma attuale, poiché Tradovate aggiorna questi menu nel tempo." },
    { q: "Posso ottenere un rimborso per un addebito Order Flow che non ho autorizzato?", a: "I rimborsi vengono gestiti caso per caso. Disattiva prima il componente aggiuntivo, poi contatta la fatturazione di Tradovate tramite la chat in-app o la pagina Contact Support con il tuo estratto conto e le date, spiega che non intendevi iscriverti e chiedi un credito o un rimborso. Non c'è alcuna garanzia, ma una richiesta chiara e documentata ha molte più probabilità di successo." },
    { q: "Order Flow+ non è già gratuito ora?", a: "Nei piani di conto più recenti con un conto di brokeraggio live, gli strumenti Order Flow+ sono inclusi senza costi aggiuntivi. Se continui a essere fatturato separatamente per il componente aggiuntivo, potresti pagare due volte, passare al piano giusto o confermarlo può eliminare l'addebito autonomo." },
    { q: "Quando si interrompe l'addebito dopo l'annullamento dell'iscrizione?", a: "Gli abbonamenti ai componenti aggiuntivi in genere vengono fatturati per l'intero mese di calendario anziché essere ricalcolati proporzionalmente al giorno di cancellazione, quindi potresti mantenere l'accesso fino alla fine del ciclo corrente e semplicemente non essere più addebitato in seguito. Verifica le condizioni attuali nella schermata di fatturazione." },
    { q: "Ho un conto di valutazione di una prop firm e vedo addebiti Order Flow. Cosa devo fare?", a: "Sui conti di valutazione e finanziati di una prop firm, i componenti aggiuntivi e gli strumenti sui dati di mercato sono gestiti dalla prop firm invece che auto-sottoscritti tramite la fatturazione retail di Tradovate. Contatta il supporto della tua società per rivedere o rimuovere l'addebito. Le regole e i prezzi variano in base alla società e alla dimensione del conto, quindi verifica le condizioni attuali della tua società." },
    { q: "Verrò addebitato due volte se uso gli strumenti sia su Tradovate che su NinjaTrader?", a: "Non dovresti dover pagare due volte. Un diritto Order Flow+ legato al tuo nome utente Tradovate si trasferisce quando accedi a NinjaTrader con lo stesso nome utente. Iscriversi una seconda volta con un login diverso è il modo abituale in cui le persone finiscono per pagare due volte." },
  ] },
