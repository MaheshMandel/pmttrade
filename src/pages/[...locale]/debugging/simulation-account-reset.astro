---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "simulation-account-reset";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/debugging/${SLUG}`;

const META_TITLE = "Tradovate Simulation Account Reset Unexpectedly";
const META_DESCRIPTION =
  "Sim account reset wiped your balance and ATM settings? See why Tradovate demo accounts reset, how to restore your setup, and how to back it up.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Tradovate-Simulationskonto unerwartet zurückgesetzt", es: "Reinicio inesperado de la cuenta de simulación de Tradovate", fr: "Réinitialisation inattendue du compte de simulation Tradovate", it: "Reset imprevisto dell'account di simulazione Tradovate" },
  dek: { en: "Your sim balance is back to a round default number and your ATM brackets are gone. A simulated Tradovate account is a practice sandbox, not a permanent record, here's why it resets and how to make the next one a non-event.", de: "Ihr Sim-Kontostand ist wieder auf einer runden Standardzahl und Ihre ATM-Brackets sind weg. Ein simuliertes Tradovate-Konto ist ein Übungs-Sandkasten und kein dauerhafter Nachweis. Hier erfahren Sie, warum es zurückgesetzt wird und wie Sie den nächsten Reset zum Nicht-Ereignis machen.", es: "El saldo de su simulador ha vuelto a una cifra redonda por defecto y sus brackets ATM han desaparecido. Una cuenta simulada de Tradovate es un entorno de práctica, no un registro permanente. Le explicamos por qué se reinicia y cómo hacer que el próximo reinicio no sea un problema.", fr: "Le solde de votre simulateur est revenu à un chiffre rond par défaut et vos brackets ATM ont disparu. Un compte simulé Tradovate est un bac à sable d'entraînement, pas un historique permanent. Voici pourquoi il est réinitialisé et comment faire de la prochaine réinitialisation un non-événement.", it: "Il saldo del suo simulatore è tornato a una cifra tonda predefinita e i suoi bracket ATM sono spariti. Un account simulato Tradovate è un ambiente di prova, non un archivio permanente. Ecco perché viene reimpostato e come rendere il prossimo reset un non evento." },
  readTime: { en: "7 min read", de: "7 Min. Lesezeit", es: "Lectura de 7 min", fr: "Lecture : 7 min", it: "Lettura di 7 min" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "You open the platform on a Monday and something's off. The sim account is back to a round default number. The trades you logged last week are gone. The ATM brackets you spent an evening dialing in have vanished, and your custom indicators didn't load on the charts. If you were tracking a practice run, that stings." },
    { type: "paragraph", html: "Here's the honest version most people don't tell you up front: a simulated Tradovate account is a practice sandbox, not a permanent record. It can be reset, and when it is, your balance and configuration can go with it. This guide walks through why it happens, how to get your setup back in about a minute, and how to make the next reset a non-event instead of a lost evening." },
    { type: "quote", html: "<strong>Short version:</strong> Treat sim balances and ATM settings as disposable. Keep a copy of your ATM strategy parameters somewhere outside the platform, use Modify Balance to restore your practice balance whenever you need to, and don't lean on sim P&amp;L as a lasting record. Preparation beats prevention here, because you can't stop the shared sim environment from being refreshed." },
    { type: "heading", text: "What You'll Actually See" },
    { type: "paragraph", html: "A sim reset doesn't announce itself. You usually notice it through one or more of these symptoms:" },
    {
      type: "list",
      items: [
        "Your balance snapped back to a default amount (often $50,000), and whatever custom size you were using is gone.",
        "Open sim positions and working orders have been cleared.",
        "ATM strategies and bracket profiles are empty or reverted to their default set.",
        "Custom indicators aren't loaded on your charts anymore.",
        "In some cases you can't log in to the demo at all, which is a different problem covered further down.",
      ],
    },
    { type: "paragraph", html: "None of that means your machine broke or you clicked the wrong thing. It's the sim environment doing what a sim environment does." },
    { type: "heading", text: "Why a Sim Account Resets" },
    { type: "paragraph", html: "There are a few different triggers, and lumping them together is what makes this confusing. They're not the same problem." },
    { type: "heading", text: "Periodic maintenance and sim refreshes" },
    { type: "paragraph", html: "The simulation environment is a shared practice system that Tradovate maintains. Those maintenance windows tend to land on weekends, and sometimes they wipe sim state back to defaults. Because it's a platform-wide event rather than something tied to your account, there's usually no individual notice. You just log in afterward and find the slate wiped." },
    { type: "heading", text: "Crashes and instability" },
    { type: "paragraph", html: "If the platform hits a hard crash, sim configuration that lives server-side can revert. A rough weekend for the servers can look exactly like a deliberate reset from where you're sitting." },
    { type: "heading", text: "Trial expiry (not a reset)" },
    { type: "paragraph", html: "The free demo runs 14 days from registration. When that window lapses, you can't log in to place simulated trades anymore, and the trial can't be extended or reset. That's expiry, not a mid-run wipe. Your two options are to open and fund a live Tradovate account, which includes unlimited simulated trading, or start a fresh trial with a different email address." },
    { type: "heading", text: "Prop and evaluation accounts" },
    { type: "paragraph", html: "If you're trading a funded evaluation, the account and its balance are controlled by your prop firm, not by you. Resets, end-of-day balance behavior, and the rules around them vary by firm and account size, so check your firm's current rules rather than assuming the platform misbehaved." },
    { type: "paragraph", html: "The takeaway across all four: for the shared sim environment, you can't prevent a reset from your side. So the real win is in how you prepare for one." },
    { type: "heading", text: "Restore Your Practice Balance in Under a Minute" },
    { type: "paragraph", html: "Getting your practice balance back is quick. On the web platform:" },
    {
      type: "steps",
      items: [
        { title: "Open Application Settings", html: "Click <strong class='text-white'>Application Settings</strong> in the top-right corner." },
        { title: "Open the Accounts tab", html: "Open the <strong class='text-white'>Accounts</strong> tab." },
        { title: "Find your demo/SIM account", html: "Find your demo or SIM account in the list." },
        { title: "Choose Modify Balance", html: "Choose <strong class='text-white'>Modify Balance</strong> (the exact wording can shift between builds, but it's the option that lets you set the sim balance)." },
        { title: "Enter the amount and confirm", html: "Enter the amount you want and confirm." },
      ],
    },
    { type: "paragraph", html: "The change reflects across every version of the platform you use, so once you set it on the web, desktop and mobile follow. Two things worth remembering: this settings dialog is a web-platform feature, and adjusting the balance is not the same as extending an expired trial. If the demo simply won't let you log in, that's the expiry situation from above, and no amount of balance-setting will bring it back." },
    { type: "heading", text: "Back Up Your ATM Strategies Before the Next Reset" },
    { type: "paragraph", html: "This is the part that saves you real time. Because ATM strategies can disappear in a reset, keep a copy of their parameters somewhere the platform can't touch. Tradovate doesn't hand you a one-click export of ATM profiles, so the dependable backup is a plain written record or a screenshot. For each strategy you rely on, capture:" },
    {
      type: "list",
      items: [
        "The strategy name.",
        "Quantity per target.",
        "Stop-loss distance (in ticks, price, or dollars, whichever unit you set it in).",
        "Each take-profit target and its distance.",
        "Whether it auto-places as an OCO bracket.",
        "Any breakeven or trailing behavior you've configured.",
      ],
    },
    { type: "paragraph", html: "Drop that into a note or a spreadsheet and keep it current whenever you tweak a bracket. Rebuilding a strategy from a clear list takes a couple of minutes. Rebuilding it from memory after a Monday wipe takes an evening and you'll second-guess every number." },
    { type: "heading", text: "Stop Relying on Sim Balance Persistence" },
    { type: "paragraph", html: "The bigger shift is in how you think about the sim account. Once you stop treating it like a savings account, resets stop hurting." },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Treat the balance as a dial, not a score.</strong> Set it to your target size at the start of a session instead of watching it accumulate over weeks. That way a reset just means clicking Modify Balance again.",
        "<strong class='text-white'>Export or screenshot anything you're measuring.</strong> If you're tracking P&amp;L or a win rate, pull your reports regularly and store them yourself. Don't trust the platform to carry that history through a reset.",
        "<strong class='text-white'>Keep your ATM backup fresh.</strong> Update the record every time you change a bracket, not just when you remember.",
        "<strong class='text-white'>Journal outside the platform.</strong> A trade journal or a third-party analytics tool survives a reset. The sim account doesn't, and it was never designed to.",
      ],
    },
    { type: "heading", text: "Prop Firm and Funded Accounts" },
    { type: "paragraph", html: "Funded and evaluation accounts play by different rules. There, the balance, the trailing drawdown, the end-of-day flattening, and any reset are set by the firm. If your eval balance changes out of nowhere or the account disappears entirely, that's a question for the firm, not a platform bug you can fix from settings. The specific numbers vary by firm and account size, so read your firm's current terms before you conclude something is broken." },
    { type: "paragraph", html: "One common overlap: if a demo or eval account gets switched off after a quiet stretch, that's usually an inactivity policy rather than a reset. The fix and the reasoning are different from the reset scenarios covered above." },
    { type: "heading", text: "When to Contact Support" },
    { type: "paragraph", html: "Most sim resets don't need a support ticket. Reach out when:" },
    {
      type: "list",
      items: [
        "Your <strong class='text-white'>live, real-money</strong> account balance or positions look wrong. Never sit on this one.",
        "A sim reset hit mid-session and cost you an active practice setup you genuinely needed.",
        "The demo won't log in and you're still inside your 14-day trial window.",
      ],
    },
    { type: "paragraph", html: "For prop evaluation issues, contact the firm first, since they own the account. For any live-money discrepancy, contact Tradovate right away and hold off on placing new orders until everything is reconciled." },
    { type: "paragraph", html: "Testing an automated strategy on the sim account? Keep the automation itself off the platform so a reset can't touch it. PickMyTrade routes your TradingView alerts to Tradovate from its own configuration, so when the sim environment refreshes, your trading logic and connection settings stay exactly where you left them." },
  ], de: [
    { type: "paragraph",html: "Sie öffnen die Plattform an einem Montag und etwas stimmt nicht. Das Sim-Konto steht wieder auf einer runden Standardzahl. Die Trades, die Sie letzte Woche protokolliert haben, sind weg. Die ATM-Brackets, die Sie sich an einem Abend mühsam eingestellt haben, sind verschwunden, und Ihre benutzerdefinierten Indikatoren wurden nicht in die Charts geladen. Wenn Sie einen Übungslauf verfolgt haben, schmerzt das." },
    { type: "paragraph",html: "Hier die ehrliche Version, die einem die wenigsten vorab sagen: Ein simuliertes Tradovate-Konto ist ein Übungs-Sandkasten und kein dauerhafter Nachweis. Es kann zurückgesetzt werden, und dabei können Ihr Kontostand und Ihre Konfiguration verloren gehen. Diese Anleitung zeigt, warum das passiert, wie Sie Ihr Setup in etwa einer Minute zurückholen und wie Sie den nächsten Reset zum Nicht-Ereignis statt zum verlorenen Abend machen." },
    { type: "quote",html: "<strong>Kurzfassung:</strong> Behandeln Sie Sim-Kontostände und ATM-Einstellungen als Wegwerfware. Bewahren Sie eine Kopie Ihrer ATM-Strategieparameter außerhalb der Plattform auf, stellen Sie Ihren Übungskontostand bei Bedarf mit Modify Balance wieder her und verlassen Sie sich nicht auf Sim-P&amp;L als dauerhaften Nachweis. Vorbereitung schlägt hier Vorbeugung, denn Sie können nicht verhindern, dass die gemeinsame Sim-Umgebung aufgefrischt wird." },
    { type: "heading",text: "Was Sie tatsächlich sehen werden" },
    { type: "paragraph",html: "Ein Sim-Reset kündigt sich nicht an. Meist bemerken Sie ihn an einem oder mehreren dieser Symptome:" },
    {
      type: "list",
      items: [
        "Ihr Kontostand ist auf einen Standardbetrag (häufig $50,000) zurückgesprungen, und die von Ihnen genutzte individuelle Größe ist weg.",
        "Offene Sim-Positionen und aktive Orders wurden gelöscht.",
        "ATM-Strategien und Bracket-Profile sind leer oder auf ihren Standardsatz zurückgesetzt.",
        "Benutzerdefinierte Indikatoren sind in Ihren Charts nicht mehr geladen.",
        "In manchen Fällen können Sie sich überhaupt nicht mehr im Demokonto anmelden, was ein anderes Problem ist und weiter unten behandelt wird.",
      ],
    },
    { type: "paragraph",html: "Nichts davon bedeutet, dass Ihr Rechner kaputt ist oder Sie etwas Falsches angeklickt haben. Die Sim-Umgebung tut einfach, was eine Sim-Umgebung tut." },
    { type: "heading",text: "Warum ein Sim-Konto zurückgesetzt wird" },
    { type: "paragraph",html: "Es gibt mehrere unterschiedliche Auslöser, und sie in einen Topf zu werfen macht das Ganze verwirrend. Es sind nicht dieselben Probleme." },
    { type: "heading",text: "Regelmäßige Wartung und Sim-Aktualisierungen" },
    { type: "paragraph",html: "Die Simulationsumgebung ist ein gemeinsam genutztes Übungssystem, das Tradovate wartet. Diese Wartungsfenster liegen tendenziell an Wochenenden und setzen den Sim-Zustand manchmal auf die Standardwerte zurück. Da es ein plattformweites Ereignis ist und nicht an Ihr Konto gebunden, gibt es in der Regel keine individuelle Mitteilung. Sie melden sich danach einfach an und finden eine leere Fläche vor." },
    { type: "heading",text: "Abstürze und Instabilität" },
    { type: "paragraph",html: "Wenn die Plattform hart abstürzt, kann serverseitig gespeicherte Sim-Konfiguration zurückgesetzt werden. Ein holpriges Wochenende der Server kann von Ihrem Platz aus genau wie ein gezielter Reset aussehen." },
    { type: "heading",text: "Ablauf der Testphase (kein Reset)" },
    { type: "paragraph",html: "Die kostenlose Demo läuft 14 Tage ab Registrierung. Wenn dieses Fenster endet, können Sie sich nicht mehr anmelden, um simulierte Trades zu platzieren, und die Testphase lässt sich weder verlängern noch zurücksetzen. Das ist ein Ablauf und keine Löschung mitten im Lauf. Ihre beiden Optionen: ein Live-Tradovate-Konto eröffnen und finanzieren, das unbegrenztes simuliertes Trading enthält, oder mit einer anderen E-Mail-Adresse eine neue Testphase starten." },
    { type: "heading",text: "Prop- und Evaluierungskonten" },
    { type: "paragraph",html: "Wenn Sie eine Funded-Evaluierung handeln, werden das Konto und sein Kontostand von Ihrer Prop Firm gesteuert, nicht von Ihnen. Resets, das Kontostand-Verhalten zum Handelsende und die zugehörigen Regeln unterscheiden sich je nach Firma und Kontogröße. Prüfen Sie daher die aktuellen Regeln Ihrer Firma, statt anzunehmen, dass sich die Plattform danebenbenommen hat." },
    { type: "paragraph",html: "Die Erkenntnis aus allen vier Fällen: Bei der gemeinsamen Sim-Umgebung können Sie einen Reset von Ihrer Seite aus nicht verhindern. Der eigentliche Gewinn liegt also darin, wie Sie sich darauf vorbereiten." },
    { type: "heading",text: "Ihren Übungskontostand in unter einer Minute wiederherstellen" },
    { type: "paragraph",html: "Ihren Übungskontostand zurückzubekommen geht schnell. In der Web-Plattform:" },
    {
      type: "steps",
      items: [
        { title: "Application Settings öffnen", html: "Klicken Sie oben rechts auf <strong class='text-white'>Application Settings</strong>." },
        { title: "Den Tab Accounts öffnen", html: "Öffnen Sie den Tab <strong class='text-white'>Accounts</strong>." },
        { title: "Ihr Demo-/SIM-Konto finden", html: "Suchen Sie Ihr Demo- oder SIM-Konto in der Liste." },
        { title: "Modify Balance wählen", html: "Wählen Sie <strong class='text-white'>Modify Balance</strong> (die genaue Bezeichnung kann sich zwischen Builds ändern, aber es ist die Option, mit der Sie den Sim-Kontostand festlegen)." },
        { title: "Betrag eingeben und bestätigen", html: "Geben Sie den gewünschten Betrag ein und bestätigen Sie." },
      ],
    },
    { type: "paragraph",html: "Die Änderung wird in jeder von Ihnen genutzten Version der Plattform übernommen. Wenn Sie sie im Web festlegen, ziehen Desktop und Mobilgerät also nach. Zwei Dinge sollten Sie sich merken: Dieser Einstellungsdialog ist eine Funktion der Web-Plattform, und das Anpassen des Kontostands ist nicht dasselbe wie die Verlängerung einer abgelaufenen Testphase. Wenn Sie sich einfach nicht mehr im Demokonto anmelden können, ist das die oben beschriebene Ablaufsituation, und kein noch so häufiges Festlegen des Kontostands bringt es zurück." },
    { type: "heading",text: "Sichern Sie Ihre ATM-Strategien vor dem nächsten Reset" },
    { type: "paragraph",html: "Dieser Teil spart Ihnen echte Zeit. Da ATM-Strategien bei einem Reset verschwinden können, bewahren Sie eine Kopie ihrer Parameter an einem Ort auf, den die Plattform nicht erreicht. Tradovate bietet keinen Ein-Klick-Export von ATM-Profilen, daher ist die verlässliche Sicherung eine einfache schriftliche Aufzeichnung oder ein Screenshot. Halten Sie für jede Strategie, auf die Sie sich verlassen, Folgendes fest:" },
    {
      type: "list",
      items: [
        "Den Namen der Strategie.",
        "Menge pro Ziel.",
        "Stop-Loss-Abstand (in Ticks, Preis oder Dollar, in welcher Einheit Sie ihn festgelegt haben).",
        "Jedes Take-Profit-Ziel und seinen Abstand.",
        "Ob es automatisch als OCO-Bracket platziert wird.",
        "Jedes von Ihnen konfigurierte Breakeven- oder Trailing-Verhalten.",
      ],
    },
    { type: "paragraph",html: "Legen Sie das in einer Notiz oder Tabelle ab und halten Sie es aktuell, sobald Sie ein Bracket anpassen. Eine Strategie aus einer klaren Liste neu aufzubauen dauert ein paar Minuten. Sie nach einem Montags-Reset aus dem Gedächtnis zu rekonstruieren dauert einen Abend, und Sie zweifeln an jeder Zahl." },
    { type: "heading",text: "Verlassen Sie sich nicht mehr auf die Beständigkeit des Sim-Kontostands" },
    { type: "paragraph",html: "Der größere Wandel liegt darin, wie Sie über das Sim-Konto denken. Sobald Sie es nicht mehr wie ein Sparkonto behandeln, tun Resets nicht mehr weh." },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Behandeln Sie den Kontostand als Regler, nicht als Punktestand.</strong> Stellen Sie ihn zu Beginn einer Sitzung auf Ihre Zielgröße ein, statt zuzusehen, wie er sich über Wochen aufbaut. So bedeutet ein Reset nur, erneut auf Modify Balance zu klicken.",
        "<strong class='text-white'>Exportieren Sie alles, was Sie messen, oder machen Sie Screenshots davon.</strong> Wenn Sie P&amp;L oder eine Trefferquote verfolgen, ziehen Sie regelmäßig Ihre Berichte und speichern Sie sie selbst. Verlassen Sie sich nicht darauf, dass die Plattform diese Historie durch einen Reset trägt.",
        "<strong class='text-white'>Halten Sie Ihre ATM-Sicherung aktuell.</strong> Aktualisieren Sie die Aufzeichnung jedes Mal, wenn Sie ein Bracket ändern, nicht nur, wenn Sie daran denken.",
        "<strong class='text-white'>Führen Sie Ihr Journal außerhalb der Plattform.</strong> Ein Trading-Journal oder ein Analysetool eines Drittanbieters übersteht einen Reset. Das Sim-Konto nicht, und dafür wurde es nie gebaut.",
      ],
    },
    { type: "heading",text: "Prop-Firm- und Funded-Konten" },
    { type: "paragraph",html: "Funded- und Evaluierungskonten folgen anderen Regeln. Dort werden Kontostand, Trailing Drawdown, Glattstellung zum Handelsende und jeder Reset von der Firma festgelegt. Wenn sich Ihr Evaluierungs-Kontostand aus heiterem Himmel ändert oder das Konto ganz verschwindet, ist das eine Frage an die Firma und kein Plattformfehler, den Sie über die Einstellungen beheben können. Die konkreten Zahlen unterscheiden sich je nach Firma und Kontogröße. Lesen Sie daher die aktuellen Bedingungen Ihrer Firma, bevor Sie schlussfolgern, dass etwas defekt ist." },
    { type: "paragraph",html: "Eine häufige Überschneidung: Wenn ein Demo- oder Evaluierungskonto nach einer ruhigen Phase abgeschaltet wird, handelt es sich meist um eine Inaktivitätsrichtlinie und nicht um einen Reset. Lösung und Begründung unterscheiden sich von den oben behandelten Reset-Szenarien." },
    { type: "heading",text: "Wann Sie den Support kontaktieren sollten" },
    { type: "paragraph",html: "Die meisten Sim-Resets erfordern kein Support-Ticket. Melden Sie sich, wenn:" },
    {
      type: "list",
      items: [
        "Kontostand oder Positionen Ihres <strong class='text-white'>Live-Echtgeldkontos</strong> falsch aussehen. Warten Sie damit niemals.",
        "Ein Sim-Reset mitten in einer Sitzung ein aktives Übungs-Setup zerstört hat, das Sie tatsächlich benötigten.",
        "Sich das Demokonto nicht anmelden lässt und Sie sich noch innerhalb Ihrer 14-tägigen Testphase befinden.",
      ],
    },
    { type: "paragraph",html: "Bei Problemen mit Prop-Evaluierungen wenden Sie sich zuerst an die Firma, da ihr das Konto gehört. Bei jeder Abweichung im Echtgeldkonto kontaktieren Sie sofort Tradovate und platzieren Sie keine neuen Orders, bis alles abgeglichen ist." },
    { type: "paragraph",html: "Sie testen eine automatisierte Strategie auf dem Sim-Konto? Halten Sie die Automatisierung selbst außerhalb der Plattform, damit ein Reset sie nicht berühren kann. PickMyTrade leitet Ihre TradingView-Alerts aus einer eigenen Konfiguration an Tradovate weiter. Wenn die Sim-Umgebung aufgefrischt wird, bleiben Ihre Handelslogik und Verbindungseinstellungen also genau dort, wo Sie sie gelassen haben." },
  ], es: [
    { type: "paragraph",html: "Abre la plataforma un lunes y algo no encaja. La cuenta de simulación ha vuelto a una cifra redonda por defecto. Las operaciones que registró la semana pasada han desaparecido. Los brackets ATM que tardó una tarde en ajustar se han esfumado y sus indicadores personalizados no se cargaron en los gráficos. Si estaba siguiendo una práctica, duele." },
    { type: "paragraph",html: "Esta es la versión sincera que casi nadie cuenta de entrada: una cuenta simulada de Tradovate es un entorno de práctica, no un registro permanente. Puede reiniciarse y, cuando ocurre, su saldo y su configuración pueden desaparecer. Esta guía explica por qué sucede, cómo recuperar su configuración en aproximadamente un minuto y cómo hacer que el próximo reinicio sea un no evento en lugar de una tarde perdida." },
    { type: "quote",html: "<strong>Versión corta:</strong> trate los saldos del simulador y los ajustes ATM como desechables. Guarde una copia de los parámetros de su estrategia ATM fuera de la plataforma, use Modify Balance para restaurar su saldo de práctica cuando lo necesite y no se apoye en el P&amp;L del simulador como registro duradero. Aquí la preparación vence a la prevención, porque no puede impedir que se actualice el entorno de simulación compartido." },
    { type: "heading",text: "Lo que realmente verá" },
    { type: "paragraph",html: "Un reinicio del simulador no se anuncia. Normalmente lo nota por uno o varios de estos síntomas:" },
    {
      type: "list",
      items: [
        "Su saldo volvió a un importe por defecto (a menudo $50,000) y el tamaño personalizado que usaba ha desaparecido.",
        "Las posiciones abiertas y las órdenes activas del simulador se han borrado.",
        "Las estrategias ATM y los perfiles de bracket están vacíos o han vuelto a su conjunto por defecto.",
        "Los indicadores personalizados ya no están cargados en sus gráficos.",
        "En algunos casos no puede iniciar sesión en la demo en absoluto, lo cual es un problema distinto que se trata más abajo.",
      ],
    },
    { type: "paragraph",html: "Nada de eso significa que su equipo se haya averiado ni que haya pulsado algo equivocado. Es el entorno de simulación haciendo lo que hace un entorno de simulación." },
    { type: "heading",text: "Por qué se reinicia una cuenta de simulación" },
    { type: "paragraph",html: "Hay varios desencadenantes distintos y mezclarlos es lo que hace que esto resulte confuso. No son el mismo problema." },
    { type: "heading",text: "Mantenimiento periódico y actualizaciones del simulador" },
    { type: "paragraph",html: "El entorno de simulación es un sistema de práctica compartido que mantiene Tradovate. Esas ventanas de mantenimiento suelen caer en fin de semana y a veces devuelven el estado del simulador a los valores por defecto. Como es un evento de toda la plataforma y no algo ligado a su cuenta, normalmente no hay aviso individual. Simplemente inicia sesión después y se encuentra con todo borrado." },
    { type: "heading",text: "Caídas e inestabilidad" },
    { type: "paragraph",html: "Si la plataforma sufre una caída grave, la configuración del simulador que reside en el servidor puede revertirse. Un fin de semana complicado para los servidores puede parecer, desde donde usted está, un reinicio deliberado." },
    { type: "heading",text: "Caducidad de la prueba (no es un reinicio)" },
    { type: "paragraph",html: "La demo gratuita dura 14 días desde el registro. Cuando ese plazo vence, ya no puede iniciar sesión para colocar operaciones simuladas, y la prueba no puede ampliarse ni reiniciarse. Eso es caducidad, no un borrado a mitad de camino. Sus dos opciones son abrir y fondear una cuenta real de Tradovate, que incluye trading simulado ilimitado, o iniciar una prueba nueva con otra dirección de correo electrónico." },
    { type: "heading",text: "Cuentas prop y de evaluación" },
    { type: "paragraph",html: "Si opera una evaluación fondeada, la cuenta y su saldo los controla su prop firm, no usted. Los reinicios, el comportamiento del saldo al final del día y las reglas que los rodean varían según la empresa y el tamaño de la cuenta, así que consulte las reglas vigentes de su empresa en lugar de suponer que la plataforma se comportó mal." },
    { type: "paragraph",html: "La conclusión de los cuatro casos: en el entorno de simulación compartido no puede evitar un reinicio desde su lado. Así que la verdadera ventaja está en cómo se prepara para uno." },
    { type: "heading",text: "Restaure su saldo de práctica en menos de un minuto" },
    { type: "paragraph",html: "Recuperar su saldo de práctica es rápido. En la plataforma web:" },
    {
      type: "steps",
      items: [
        { title: "Abra Application Settings", html: "Haga clic en <strong class='text-white'>Application Settings</strong> en la esquina superior derecha." },
        { title: "Abra la pestaña Accounts", html: "Abra la pestaña <strong class='text-white'>Accounts</strong>." },
        { title: "Encuentre su cuenta demo/SIM", html: "Busque su cuenta demo o SIM en la lista." },
        { title: "Elija Modify Balance", html: "Elija <strong class='text-white'>Modify Balance</strong> (la redacción exacta puede variar entre versiones, pero es la opción que le permite establecer el saldo del simulador)." },
        { title: "Introduzca el importe y confirme", html: "Introduzca el importe que desee y confirme." },
      ],
    },
    { type: "paragraph",html: "El cambio se refleja en todas las versiones de la plataforma que use, así que, una vez que lo establezca en la web, el escritorio y el móvil lo siguen. Conviene recordar dos cosas: este cuadro de ajustes es una función de la plataforma web y ajustar el saldo no es lo mismo que ampliar una prueba caducada. Si la demo simplemente no le deja iniciar sesión, es la situación de caducidad descrita antes y ninguna cantidad de ajustes de saldo la recuperará." },
    { type: "heading",text: "Respalde sus estrategias ATM antes del próximo reinicio" },
    { type: "paragraph",html: "Esta es la parte que le ahorra tiempo de verdad. Como las estrategias ATM pueden desaparecer en un reinicio, guarde una copia de sus parámetros en un lugar al que la plataforma no llegue. Tradovate no ofrece una exportación de perfiles ATM con un clic, así que la copia de seguridad fiable es un simple registro escrito o una captura de pantalla. Para cada estrategia en la que confíe, anote:" },
    {
      type: "list",
      items: [
        "El nombre de la estrategia.",
        "La cantidad por objetivo.",
        "La distancia del stop-loss (en ticks, precio o dólares, en la unidad en la que la haya definido).",
        "Cada objetivo de take-profit y su distancia.",
        "Si se coloca automáticamente como bracket OCO.",
        "Cualquier comportamiento de breakeven o de trailing que haya configurado.",
      ],
    },
    { type: "paragraph",html: "Guárdelo en una nota o en una hoja de cálculo y manténgalo al día cada vez que ajuste un bracket. Reconstruir una estrategia a partir de una lista clara lleva un par de minutos. Reconstruirla de memoria tras un borrado del lunes lleva una tarde entera y dudará de cada cifra." },
    { type: "heading",text: "Deje de depender de la persistencia del saldo del simulador" },
    { type: "paragraph",html: "El cambio más importante está en cómo piensa en la cuenta de simulación. Cuando deje de tratarla como una cuenta de ahorros, los reinicios dejan de doler." },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Trate el saldo como un mando, no como una puntuación.</strong> Fíjelo en su tamaño objetivo al comienzo de la sesión en lugar de verlo acumularse durante semanas. Así, un reinicio solo significa volver a hacer clic en Modify Balance.",
        "<strong class='text-white'>Exporte o capture todo lo que esté midiendo.</strong> Si hace seguimiento del P&amp;L o de la tasa de aciertos, extraiga sus informes con regularidad y guárdelos usted mismo. No confíe en que la plataforma conserve ese historial tras un reinicio.",
        "<strong class='text-white'>Mantenga su copia de seguridad ATM al día.</strong> Actualice el registro cada vez que cambie un bracket, no solo cuando se acuerde.",
        "<strong class='text-white'>Lleve el diario fuera de la plataforma.</strong> Un diario de trading o una herramienta de análisis de terceros sobrevive a un reinicio. La cuenta de simulación no, y nunca se diseñó para ello.",
      ],
    },
    { type: "heading",text: "Cuentas de prop firm y fondeadas" },
    { type: "paragraph",html: "Las cuentas fondeadas y de evaluación juegan con reglas distintas. En ellas, el saldo, el trailing drawdown, el cierre de posiciones al final del día y cualquier reinicio los fija la empresa. Si el saldo de su evaluación cambia de la nada o la cuenta desaparece por completo, esa es una pregunta para la empresa, no un error de la plataforma que pueda corregir desde los ajustes. Las cifras concretas varían según la empresa y el tamaño de la cuenta, así que lea las condiciones vigentes de su empresa antes de concluir que algo está roto." },
    { type: "paragraph",html: "Una coincidencia habitual: si una cuenta demo o de evaluación se desactiva tras un período de inactividad, normalmente se trata de una política de inactividad y no de un reinicio. La solución y el razonamiento son distintos de los escenarios de reinicio descritos antes." },
    { type: "heading",text: "Cuándo contactar con soporte" },
    { type: "paragraph",html: "La mayoría de los reinicios del simulador no necesitan un ticket de soporte. Contacte cuando:" },
    {
      type: "list",
      items: [
        "El saldo o las posiciones de su cuenta <strong class='text-white'>real, con dinero real</strong> parezcan incorrectos. Nunca deje pasar esto.",
        "Un reinicio del simulador le haya afectado a mitad de sesión y le haya costado una configuración de práctica activa que realmente necesitaba.",
        "La demo no le deje iniciar sesión y aún esté dentro de su plazo de prueba de 14 días.",
      ],
    },
    { type: "paragraph",html: "Para problemas con evaluaciones de prop firms, contacte primero con la empresa, ya que es la propietaria de la cuenta. Ante cualquier discrepancia con dinero real, contacte con Tradovate de inmediato y no coloque nuevas órdenes hasta que todo esté conciliado." },
    { type: "paragraph",html: "¿Está probando una estrategia automatizada en la cuenta de simulación? Mantenga la automatización fuera de la plataforma para que un reinicio no pueda tocarla. PickMyTrade enruta sus alertas de TradingView a Tradovate desde su propia configuración, de modo que cuando el entorno de simulación se actualice, su lógica de trading y los ajustes de conexión seguirán exactamente donde los dejó." },
  ], fr: [
    { type: "paragraph",html: "Vous ouvrez la plateforme un lundi et quelque chose cloche. Le compte de simulation est revenu à un chiffre rond par défaut. Les trades que vous aviez enregistrés la semaine dernière ont disparu. Les brackets ATM que vous aviez passé une soirée à régler se sont évaporés, et vos indicateurs personnalisés ne se sont pas chargés sur les graphiques. Si vous suiviez une session d'entraînement, c'est frustrant." },
    { type: "paragraph",html: "Voici la version honnête que la plupart des gens ne vous donnent pas d'emblée : un compte simulé Tradovate est un bac à sable d'entraînement, pas un historique permanent. Il peut être réinitialisé et, lorsque c'est le cas, votre solde et votre configuration peuvent disparaître avec lui. Ce guide explique pourquoi cela se produit, comment retrouver votre configuration en environ une minute et comment faire de la prochaine réinitialisation un non-événement plutôt qu'une soirée perdue." },
    { type: "quote",html: "<strong>En bref :</strong> considérez les soldes du simulateur et les paramètres ATM comme jetables. Conservez une copie des paramètres de votre stratégie ATM en dehors de la plateforme, utilisez Modify Balance pour rétablir votre solde d'entraînement quand vous en avez besoin et ne comptez pas sur le P&amp;L du simulateur comme historique durable. Ici, la préparation l'emporte sur la prévention, car vous ne pouvez pas empêcher l'actualisation de l'environnement de simulation partagé." },
    { type: "heading",text: "Ce que vous verrez réellement" },
    { type: "paragraph",html: "Une réinitialisation du simulateur ne s'annonce pas. Vous la remarquez généralement par un ou plusieurs de ces symptômes :" },
    {
      type: "list",
      items: [
        "Votre solde est revenu à un montant par défaut (souvent $50,000) et la taille personnalisée que vous utilisiez a disparu.",
        "Les positions ouvertes et les ordres actifs du simulateur ont été effacés.",
        "Les stratégies ATM et les profils de bracket sont vides ou revenus à leur jeu par défaut.",
        "Les indicateurs personnalisés ne sont plus chargés sur vos graphiques.",
        "Dans certains cas, vous ne pouvez plus du tout vous connecter à la démo, ce qui est un autre problème traité plus bas.",
      ],
    },
    { type: "paragraph",html: "Rien de tout cela ne signifie que votre machine est en panne ou que vous avez cliqué au mauvais endroit. C'est l'environnement de simulation qui fait ce que fait un environnement de simulation." },
    { type: "heading",text: "Pourquoi un compte de simulation est réinitialisé" },
    { type: "paragraph",html: "Plusieurs déclencheurs différents existent, et les mélanger est ce qui rend la chose confuse. Ce ne sont pas le même problème." },
    { type: "heading",text: "Maintenance périodique et actualisations du simulateur" },
    { type: "paragraph",html: "L'environnement de simulation est un système d'entraînement partagé entretenu par Tradovate. Ces fenêtres de maintenance tombent plutôt le week-end et ramènent parfois l'état du simulateur aux valeurs par défaut. Comme il s'agit d'un événement à l'échelle de la plateforme et non lié à votre compte, il n'y a généralement pas d'avis individuel. Vous vous connectez simplement ensuite et trouvez une page blanche." },
    { type: "heading",text: "Plantages et instabilité" },
    { type: "paragraph",html: "Si la plateforme subit un plantage sérieux, la configuration du simulateur stockée côté serveur peut être rétablie. Un week-end difficile pour les serveurs peut ressembler, de là où vous êtes, exactement à une réinitialisation délibérée." },
    { type: "heading",text: "Expiration de l'essai (pas une réinitialisation)" },
    { type: "paragraph",html: "La démo gratuite dure 14 jours à compter de l'inscription. Lorsque cette période prend fin, vous ne pouvez plus vous connecter pour passer des trades simulés, et l'essai ne peut être ni prolongé ni réinitialisé. C'est une expiration, pas un effacement en cours de route. Vos deux options : ouvrir et approvisionner un compte Tradovate réel, qui inclut le trading simulé illimité, ou démarrer un nouvel essai avec une autre adresse e-mail." },
    { type: "heading",text: "Comptes de prop firm et d'évaluation" },
    { type: "paragraph",html: "Si vous tradez une évaluation financée, le compte et son solde sont contrôlés par votre prop firm, et non par vous. Les réinitialisations, le comportement du solde en fin de journée et les règles qui les entourent varient selon la société et la taille du compte ; vérifiez donc les règles en vigueur de votre société plutôt que de supposer que la plateforme s'est mal comportée." },
    { type: "paragraph",html: "Ce qu'il faut retenir des quatre cas : pour l'environnement de simulation partagé, vous ne pouvez pas empêcher une réinitialisation de votre côté. Le véritable avantage réside donc dans la façon dont vous vous y préparez." },
    { type: "heading",text: "Rétablir votre solde d'entraînement en moins d'une minute" },
    { type: "paragraph",html: "Retrouver votre solde d'entraînement est rapide. Sur la plateforme web :" },
    {
      type: "steps",
      items: [
        { title: "Ouvrir Application Settings", html: "Cliquez sur <strong class='text-white'>Application Settings</strong> dans le coin supérieur droit." },
        { title: "Ouvrir l'onglet Accounts", html: "Ouvrez l'onglet <strong class='text-white'>Accounts</strong>." },
        { title: "Trouver votre compte démo/SIM", html: "Repérez votre compte démo ou SIM dans la liste." },
        { title: "Choisir Modify Balance", html: "Choisissez <strong class='text-white'>Modify Balance</strong> (le libellé exact peut varier d'une version à l'autre, mais c'est l'option qui vous permet de définir le solde du simulateur)." },
        { title: "Saisir le montant et confirmer", html: "Saisissez le montant souhaité et confirmez." },
      ],
    },
    { type: "paragraph",html: "La modification est répercutée sur toutes les versions de la plateforme que vous utilisez ; une fois définie sur le web, le bureau et le mobile suivent. Deux points à retenir : cette boîte de dialogue de paramètres est une fonctionnalité de la plateforme web, et ajuster le solde n'est pas la même chose que prolonger un essai expiré. Si la démo refuse simplement de vous laisser vous connecter, il s'agit de la situation d'expiration décrite plus haut, et aucun réglage de solde ne la ramènera." },
    { type: "heading",text: "Sauvegardez vos stratégies ATM avant la prochaine réinitialisation" },
    { type: "paragraph",html: "C'est la partie qui vous fait vraiment gagner du temps. Comme les stratégies ATM peuvent disparaître lors d'une réinitialisation, conservez une copie de leurs paramètres à un endroit que la plateforme ne peut pas atteindre. Tradovate ne propose pas d'exportation des profils ATM en un clic ; la sauvegarde fiable est donc une simple trace écrite ou une capture d'écran. Pour chaque stratégie sur laquelle vous comptez, notez :" },
    {
      type: "list",
      items: [
        "Le nom de la stratégie.",
        "La quantité par objectif.",
        "La distance du stop-loss (en ticks, en prix ou en dollars, selon l'unité dans laquelle vous l'avez définie).",
        "Chaque objectif de take-profit et sa distance.",
        "S'il est placé automatiquement sous forme de bracket OCO.",
        "Tout comportement de breakeven ou de trailing que vous avez configuré.",
      ],
    },
    { type: "paragraph",html: "Mettez cela dans une note ou un tableur et tenez-le à jour à chaque fois que vous modifiez un bracket. Reconstruire une stratégie à partir d'une liste claire prend quelques minutes. La reconstruire de mémoire après un effacement du lundi prend une soirée et vous douterez de chaque chiffre." },
    { type: "heading",text: "Cessez de compter sur la persistance du solde du simulateur" },
    { type: "paragraph",html: "Le plus grand changement tient à la façon dont vous pensez le compte de simulation. Dès que vous cessez de le traiter comme un compte d'épargne, les réinitialisations ne vous font plus mal." },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Considérez le solde comme un réglage, pas comme un score.</strong> Fixez-le à votre taille cible au début d'une session au lieu de le regarder s'accumuler pendant des semaines. Ainsi, une réinitialisation signifie simplement cliquer à nouveau sur Modify Balance.",
        "<strong class='text-white'>Exportez ou capturez tout ce que vous mesurez.</strong> Si vous suivez le P&amp;L ou un taux de réussite, extrayez régulièrement vos rapports et conservez-les vous-même. Ne comptez pas sur la plateforme pour porter cet historique à travers une réinitialisation.",
        "<strong class='text-white'>Gardez votre sauvegarde ATM à jour.</strong> Mettez la trace à jour à chaque modification d'un bracket, pas seulement quand vous y pensez.",
        "<strong class='text-white'>Tenez votre journal en dehors de la plateforme.</strong> Un journal de trading ou un outil d'analyse tiers survit à une réinitialisation. Le compte de simulation, non, et il n'a jamais été conçu pour cela.",
      ],
    },
    { type: "heading",text: "Comptes de prop firm et financés" },
    { type: "paragraph",html: "Les comptes financés et d'évaluation obéissent à d'autres règles. Là, le solde, le trailing drawdown, la clôture des positions en fin de journée et toute réinitialisation sont fixés par la société. Si le solde de votre évaluation change sans raison ou si le compte disparaît entièrement, c'est une question pour la société, pas un bogue de plateforme que vous pouvez corriger depuis les paramètres. Les chiffres précis varient selon la société et la taille du compte ; lisez donc les conditions en vigueur de votre société avant de conclure que quelque chose est cassé." },
    { type: "paragraph",html: "Un recoupement courant : si un compte démo ou d'évaluation est désactivé après une période d'inactivité, il s'agit généralement d'une politique d'inactivité plutôt que d'une réinitialisation. La solution et le raisonnement diffèrent des scénarios de réinitialisation décrits plus haut." },
    { type: "heading",text: "Quand contacter le support" },
    { type: "paragraph",html: "La plupart des réinitialisations du simulateur ne nécessitent pas de ticket de support. Contactez-le lorsque :" },
    {
      type: "list",
      items: [
        "Le solde ou les positions de votre compte <strong class='text-white'>réel, en argent réel</strong>, semblent incorrects. Ne laissez jamais traîner cela.",
        "Une réinitialisation du simulateur est survenue en pleine session et vous a fait perdre une configuration d'entraînement active dont vous aviez réellement besoin.",
        "La démo refuse de vous connecter alors que vous êtes encore dans votre période d'essai de 14 jours.",
      ],
    },
    { type: "paragraph",html: "Pour les problèmes d'évaluation de prop firm, contactez d'abord la société, puisque le compte lui appartient. Pour tout écart sur de l'argent réel, contactez Tradovate immédiatement et abstenez-vous de passer de nouveaux ordres tant que tout n'est pas rapproché." },
    { type: "paragraph",html: "Vous testez une stratégie automatisée sur le compte de simulation ? Gardez l'automatisation elle-même en dehors de la plateforme pour qu'une réinitialisation ne puisse pas la toucher. PickMyTrade achemine vos alertes TradingView vers Tradovate à partir de sa propre configuration ; ainsi, lorsque l'environnement de simulation est actualisé, votre logique de trading et vos paramètres de connexion restent exactement là où vous les avez laissés." },
  ], it: [
    { type: "paragraph",html: "Apre la piattaforma un lunedì e qualcosa non va. L'account di simulazione è tornato a una cifra tonda predefinita. I trade registrati la settimana scorsa sono spariti. I bracket ATM che ha impiegato una serata a mettere a punto sono svaniti e i suoi indicatori personalizzati non si sono caricati sui grafici. Se stava monitorando una sessione di pratica, brucia." },
    { type: "paragraph",html: "Ecco la versione onesta che la maggior parte delle persone non dice in anticipo: un account simulato Tradovate è un ambiente di prova, non un archivio permanente. Può essere reimpostato e, quando succede, il saldo e la configurazione possono andarsene con esso. Questa guida spiega perché accade, come ripristinare la sua configurazione in circa un minuto e come rendere il prossimo reset un non evento anziché una serata persa." },
    { type: "quote",html: "<strong>In breve:</strong> consideri i saldi del simulatore e le impostazioni ATM come usa e getta. Conservi una copia dei parametri della sua strategia ATM al di fuori della piattaforma, usi Modify Balance per ripristinare il saldo di pratica ogni volta che serve e non faccia affidamento sul P&amp;L del simulatore come archivio duraturo. Qui la preparazione batte la prevenzione, perché non può impedire che l'ambiente di simulazione condiviso venga aggiornato." },
    { type: "heading",text: "Cosa vedrà davvero" },
    { type: "paragraph",html: "Un reset del simulatore non si annuncia. Di solito lo nota da uno o più di questi sintomi:" },
    {
      type: "list",
      items: [
        "Il suo saldo è tornato a un importo predefinito (spesso $50,000) e la dimensione personalizzata che usava è sparita.",
        "Le posizioni aperte e gli ordini attivi del simulatore sono stati cancellati.",
        "Le strategie ATM e i profili di bracket sono vuoti o tornati al loro insieme predefinito.",
        "Gli indicatori personalizzati non sono più caricati sui suoi grafici.",
        "In alcuni casi non riesce proprio ad accedere alla demo, che è un problema diverso trattato più avanti.",
      ],
    },
    { type: "paragraph",html: "Niente di tutto ciò significa che il suo computer si sia rotto o che abbia cliccato qualcosa di sbagliato. È l'ambiente di simulazione che fa ciò che fa un ambiente di simulazione." },
    { type: "heading",text: "Perché un account di simulazione si reimposta" },
    { type: "paragraph",html: "Ci sono diversi fattori scatenanti, e metterli tutti insieme è ciò che rende la cosa confusa. Non sono lo stesso problema." },
    { type: "heading",text: "Manutenzione periodica e aggiornamenti del simulatore" },
    { type: "paragraph",html: "L'ambiente di simulazione è un sistema di pratica condiviso mantenuto da Tradovate. Quelle finestre di manutenzione tendono a cadere nei weekend e a volte riportano lo stato del simulatore ai valori predefiniti. Trattandosi di un evento a livello di piattaforma e non legato al suo account, di solito non c'è un avviso individuale. Semplicemente accede dopo e trova tutto azzerato." },
    { type: "heading",text: "Crash e instabilità" },
    { type: "paragraph",html: "Se la piattaforma subisce un crash grave, la configurazione del simulatore che risiede lato server può essere ripristinata. Un weekend difficile per i server può sembrare, da dove si trova, esattamente un reset deliberato." },
    { type: "heading",text: "Scadenza della prova (non è un reset)" },
    { type: "paragraph",html: "La demo gratuita dura 14 giorni dalla registrazione. Quando quel periodo scade, non può più accedere per piazzare trade simulati e la prova non può essere prolungata né reimpostata. Questa è una scadenza, non una cancellazione a metà corsa. Le sue due opzioni sono aprire e finanziare un account Tradovate reale, che include il trading simulato illimitato, oppure avviare una nuova prova con un indirizzo e-mail diverso." },
    { type: "heading",text: "Account prop e di valutazione" },
    { type: "paragraph",html: "Se sta operando in una valutazione finanziata, l'account e il suo saldo sono controllati dalla sua prop firm, non da lei. I reset, il comportamento del saldo a fine giornata e le regole che li riguardano variano in base alla società e alle dimensioni del conto, quindi verifichi le regole attuali della sua società anziché presumere che la piattaforma abbia funzionato male." },
    { type: "paragraph",html: "Il punto fermo in tutti e quattro i casi: per l'ambiente di simulazione condiviso, non può impedire un reset da parte sua. Quindi il vero vantaggio sta nel modo in cui si prepara." },
    { type: "heading",text: "Ripristini il suo saldo di pratica in meno di un minuto" },
    { type: "paragraph",html: "Recuperare il suo saldo di pratica è rapido. Nella piattaforma web:" },
    {
      type: "steps",
      items: [
        { title: "Aprire Application Settings", html: "Faccia clic su <strong class='text-white'>Application Settings</strong> nell'angolo in alto a destra." },
        { title: "Aprire la scheda Accounts", html: "Apra la scheda <strong class='text-white'>Accounts</strong>." },
        { title: "Trovare il suo account demo/SIM", html: "Trovi il suo account demo o SIM nell'elenco." },
        { title: "Scegliere Modify Balance", html: "Scelga <strong class='text-white'>Modify Balance</strong> (la dicitura esatta può cambiare da una build all'altra, ma è l'opzione che le permette di impostare il saldo del simulatore)." },
        { title: "Inserire l'importo e confermare", html: "Inserisca l'importo desiderato e confermi." },
      ],
    },
    { type: "paragraph",html: "La modifica si riflette su ogni versione della piattaforma che usa, quindi una volta impostata sul web, desktop e mobile seguono. Due cose da ricordare: questa finestra di impostazioni è una funzione della piattaforma web e regolare il saldo non equivale a prolungare una prova scaduta. Se la demo semplicemente non le permette di accedere, è la situazione di scadenza descritta sopra e nessuna impostazione del saldo la riporterà indietro." },
    { type: "heading",text: "Faccia il backup delle sue strategie ATM prima del prossimo reset" },
    { type: "paragraph",html: "Questa è la parte che le fa risparmiare tempo reale. Poiché le strategie ATM possono sparire in un reset, conservi una copia dei loro parametri in un posto che la piattaforma non può toccare. Tradovate non offre un'esportazione dei profili ATM con un clic, quindi il backup affidabile è un semplice appunto scritto o uno screenshot. Per ogni strategia su cui fa affidamento, annoti:" },
    {
      type: "list",
      items: [
        "Il nome della strategia.",
        "La quantità per target.",
        "La distanza dello stop-loss (in tick, prezzo o dollari, nell'unità in cui l'ha impostata).",
        "Ogni target di take-profit e la sua distanza.",
        "Se viene piazzato automaticamente come bracket OCO.",
        "Qualsiasi comportamento di breakeven o di trailing che ha configurato.",
      ],
    },
    { type: "paragraph",html: "Lo metta in una nota o in un foglio di calcolo e lo tenga aggiornato ogni volta che modifica un bracket. Ricostruire una strategia da un elenco chiaro richiede un paio di minuti. Ricostruirla a memoria dopo un azzeramento del lunedì richiede una serata e metterà in dubbio ogni numero." },
    { type: "heading",text: "Smetta di contare sulla persistenza del saldo del simulatore" },
    { type: "paragraph",html: "Il cambiamento più grande sta nel modo in cui pensa all'account di simulazione. Una volta che smette di trattarlo come un conto di risparmio, i reset smettono di fare male." },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Tratti il saldo come una manopola, non come un punteggio.</strong> Lo imposti alla dimensione obiettivo all'inizio di una sessione invece di guardarlo accumularsi per settimane. In questo modo un reset significa solo fare di nuovo clic su Modify Balance.",
        "<strong class='text-white'>Esporti o catturi tutto ciò che sta misurando.</strong> Se monitora il P&amp;L o un win rate, estragga regolarmente i suoi report e li conservi da sé. Non si fidi della piattaforma per portare quella cronologia attraverso un reset.",
        "<strong class='text-white'>Mantenga aggiornato il backup ATM.</strong> Aggiorni l'appunto ogni volta che cambia un bracket, non solo quando se ne ricorda.",
        "<strong class='text-white'>Tenga il diario fuori dalla piattaforma.</strong> Un diario di trading o uno strumento di analisi di terze parti sopravvive a un reset. L'account di simulazione no, e non è mai stato progettato per farlo.",
      ],
    },
    { type: "heading",text: "Account di prop firm e finanziati" },
    { type: "paragraph",html: "Gli account finanziati e di valutazione seguono regole diverse. Lì il saldo, il trailing drawdown, la chiusura delle posizioni a fine giornata e qualsiasi reset sono stabiliti dalla società. Se il saldo della sua valutazione cambia all'improvviso o l'account scompare del tutto, è una domanda per la società, non un bug della piattaforma che può correggere dalle impostazioni. I numeri specifici variano in base alla società e alle dimensioni del conto, quindi legga le condizioni attuali della sua società prima di concludere che qualcosa è rotto." },
    { type: "paragraph",html: "Una sovrapposizione comune: se un account demo o di valutazione viene disattivato dopo un periodo di inattività, di solito si tratta di una politica di inattività e non di un reset. La soluzione e la logica sono diverse dagli scenari di reset trattati sopra." },
    { type: "heading",text: "Quando contattare il supporto" },
    { type: "paragraph",html: "La maggior parte dei reset del simulatore non richiede un ticket di supporto. Lo contatti quando:" },
    {
      type: "list",
      items: [
        "Il saldo o le posizioni del suo account <strong class='text-white'>reale, con denaro reale</strong> sembrano sbagliati. Non lasci mai passare questo caso.",
        "Un reset del simulatore è avvenuto a sessione in corso e le è costato una configurazione di pratica attiva di cui aveva davvero bisogno.",
        "La demo non permette l'accesso e lei è ancora entro la sua prova di 14 giorni.",
      ],
    },
    { type: "paragraph",html: "Per problemi con le valutazioni delle prop firm, contatti prima la società, poiché è proprietaria dell'account. Per qualsiasi discrepanza sul denaro reale, contatti subito Tradovate e si astenga dal piazzare nuovi ordini finché tutto non è riconciliato." },
    { type: "paragraph",html: "Sta testando una strategia automatizzata sull'account di simulazione? Tenga l'automazione stessa fuori dalla piattaforma in modo che un reset non possa toccarla. PickMyTrade instrada i suoi alert di TradingView a Tradovate dalla propria configurazione, quindi quando l'ambiente di simulazione si aggiorna, la sua logica di trading e le impostazioni di connessione restano esattamente dove le ha lasciate." },
  ] },
  ctaHeading: { en: "Keep Your Automation Off the Sim Reset Path", de: "Halten Sie Ihre Automatisierung vom Sim-Reset-Pfad fern", es: "Mantenga su automatización fuera del camino del reinicio del simulador", fr: "Gardez votre automatisation à l'écart des réinitialisations du simulateur", it: "Tenga la sua automazione fuori dal percorso del reset del simulatore" },
  ctaText: { en: "PickMyTrade routes your TradingView alerts to Tradovate from its own configuration, so a sim refresh never touches your trading logic.", de: "PickMyTrade leitet Ihre TradingView-Alerts aus einer eigenen Konfiguration an Tradovate weiter, sodass eine Sim-Aktualisierung Ihre Handelslogik nie berührt.", es: "PickMyTrade enruta sus alertas de TradingView a Tradovate desde su propia configuración, de modo que una actualización del simulador nunca toca su lógica de trading.", fr: "PickMyTrade achemine vos alertes TradingView vers Tradovate à partir de sa propre configuration, de sorte qu'une actualisation du simulateur ne touche jamais votre logique de trading.", it: "PickMyTrade instrada i suoi alert di TradingView a Tradovate dalla propria configurazione, quindi un aggiornamento del simulatore non tocca mai la sua logica di trading." },
  ctaButtonText: { en: "Start Your Free 7-Day Trial", de: "Starten Sie Ihre kostenlose 7-Tage-Testphase", es: "Comience su prueba gratuita de 7 días", fr: "Commencez votre essai gratuit de 7 jours", it: "Inizi la prova gratuita di 7 giorni" },
  ctaUrl: "https://app.pickmytrade.trade/?register=true&utm_source=content&utm_medium=debugging",
  faqHeading: { en: "Frequently Asked Questions", de: "Häufig gestellte Fragen", es: "Preguntas frecuentes", fr: "Questions fréquentes", it: "Domande frequenti" },
  faqs: { en: [
    { q: "Why did my Tradovate simulation account reset on its own?", a: "The simulation environment is a shared practice system that Tradovate maintains and occasionally refreshes, often over weekends or after a hard crash. When that happens your sim balance can snap back to a default and your saved configuration can revert. It usually arrives with no individual warning because it's a maintenance event, not something tied to your specific account." },
    { q: "Does a sim reset delete my ATM strategies and custom indicators?", a: "It can. After a reset, ATM strategies and bracket profiles may be empty or reverted to defaults, and custom indicators may not load on your charts. That's why the safest move is to keep a written record or screenshot of every ATM strategy you rely on, so you can rebuild it in a couple of minutes instead of an evening." },
    { q: "How do I restore my demo account balance after a reset?", a: "On the web platform, open Application Settings, go to the Accounts tab, select your demo or SIM account, and use the Modify Balance option to set the amount you want. The change reflects across desktop, web, and mobile. Adjusting the balance is not the same as extending an expired trial." },
    { q: "Can I stop the simulation account from resetting?", a: "Not from your side, because the shared sim environment is maintained by Tradovate. The practical fix is preparation rather than prevention: back up your ATM parameters outside the platform, export or screenshot any practice results you care about, and treat the sim balance as a dial you set at the start of each session instead of a score that accumulates." },
    { q: "Do prop firm evaluation accounts reset the same way?", a: "No. On a funded or evaluation account the balance, drawdown, end-of-day flattening, and any reset are controlled by your prop firm, not by you. The specific numbers and reset behavior vary by firm and account size, so check your firm's current rules before assuming something broke on the platform." },
  ], de: [
    { q: "Warum wurde mein Tradovate-Simulationskonto von selbst zurückgesetzt?", a: "Die Simulationsumgebung ist ein gemeinsam genutztes Übungssystem, das Tradovate wartet und gelegentlich auffrischt, oft an Wochenenden oder nach einem schweren Absturz. Dabei kann Ihr Sim-Kontostand auf einen Standardwert zurückspringen und Ihre gespeicherte Konfiguration kann zurückgesetzt werden. Es kommt meist ohne individuelle Vorwarnung, da es ein Wartungsereignis ist und nichts mit Ihrem konkreten Konto zu tun hat." },
    { q: "Löscht ein Sim-Reset meine ATM-Strategien und benutzerdefinierten Indikatoren?", a: "Das kann passieren. Nach einem Reset können ATM-Strategien und Bracket-Profile leer oder auf Standardwerte zurückgesetzt sein, und benutzerdefinierte Indikatoren werden möglicherweise nicht in Ihren Charts geladen. Deshalb ist es am sichersten, jede ATM-Strategie, auf die Sie sich verlassen, schriftlich oder per Screenshot festzuhalten, damit Sie sie in ein paar Minuten statt an einem ganzen Abend neu aufbauen können." },
    { q: "Wie stelle ich den Kontostand meines Demokontos nach einem Reset wieder her?", a: "Öffnen Sie in der Web-Plattform die Application Settings, wechseln Sie zum Tab Accounts, wählen Sie Ihr Demo- oder SIM-Konto aus und nutzen Sie die Option Modify Balance, um den gewünschten Betrag festzulegen. Die Änderung wird auf Desktop, Web und Mobilgerät übernommen. Das Anpassen des Kontostands ist nicht dasselbe wie die Verlängerung einer abgelaufenen Testphase." },
    { q: "Kann ich verhindern, dass das Simulationskonto zurückgesetzt wird?", a: "Nicht von Ihrer Seite aus, denn die gemeinsame Sim-Umgebung wird von Tradovate gepflegt. Die praktische Lösung ist Vorbereitung statt Vorbeugung: Sichern Sie Ihre ATM-Parameter außerhalb der Plattform, exportieren Sie wichtige Übungsergebnisse oder machen Sie Screenshots davon und behandeln Sie den Sim-Kontostand als Regler, den Sie zu Beginn jeder Sitzung einstellen, statt als Punktestand, der sich anhäuft." },
    { q: "Werden Prop-Firm-Evaluierungskonten auf dieselbe Weise zurückgesetzt?", a: "Nein. Bei einem Funded- oder Evaluierungskonto werden Kontostand, Drawdown, Glattstellung zum Handelsende und jeder Reset von Ihrer Prop Firm gesteuert, nicht von Ihnen. Die konkreten Zahlen und das Reset-Verhalten unterscheiden sich je nach Firma und Kontogröße. Prüfen Sie daher die aktuellen Regeln Ihrer Firma, bevor Sie annehmen, dass auf der Plattform etwas kaputtgegangen ist." },
  ], es: [
    { q: "¿Por qué se reinició mi cuenta de simulación de Tradovate por sí sola?", a: "El entorno de simulación es un sistema de práctica compartido que Tradovate mantiene y actualiza ocasionalmente, a menudo durante los fines de semana o tras una caída grave. Cuando eso ocurre, el saldo de su simulador puede volver a un valor por defecto y su configuración guardada puede revertirse. Normalmente llega sin aviso individual, porque es un evento de mantenimiento y no algo ligado a su cuenta concreta." },
    { q: "¿Un reinicio del simulador borra mis estrategias ATM e indicadores personalizados?", a: "Puede hacerlo. Tras un reinicio, las estrategias ATM y los perfiles de bracket pueden aparecer vacíos o revertidos a los valores por defecto, y es posible que los indicadores personalizados no se carguen en sus gráficos. Por eso lo más seguro es guardar un registro escrito o una captura de cada estrategia ATM en la que confíe, para poder reconstruirla en un par de minutos en lugar de en toda una tarde." },
    { q: "¿Cómo restauro el saldo de mi cuenta demo tras un reinicio?", a: "En la plataforma web, abra Application Settings, vaya a la pestaña Accounts, seleccione su cuenta demo o SIM y use la opción Modify Balance para establecer el importe que desee. El cambio se refleja en escritorio, web y móvil. Ajustar el saldo no es lo mismo que ampliar una prueba caducada." },
    { q: "¿Puedo evitar que la cuenta de simulación se reinicie?", a: "No desde su lado, porque el entorno de simulación compartido lo mantiene Tradovate. La solución práctica es la preparación y no la prevención: guarde sus parámetros ATM fuera de la plataforma, exporte o capture los resultados de práctica que le importen y trate el saldo del simulador como un mando que ajusta al comienzo de cada sesión en lugar de una puntuación que se acumula." },
    { q: "¿Las cuentas de evaluación de las prop firms se reinician de la misma manera?", a: "No. En una cuenta fondeada o de evaluación, el saldo, el drawdown, el cierre de posiciones al final del día y cualquier reinicio los controla su prop firm, no usted. Las cifras concretas y el comportamiento del reinicio varían según la empresa y el tamaño de la cuenta, así que consulte las reglas vigentes de su empresa antes de suponer que algo falló en la plataforma." },
  ], fr: [
    { q: "Pourquoi mon compte de simulation Tradovate s'est-il réinitialisé tout seul ?", a: "L'environnement de simulation est un système d'entraînement partagé que Tradovate entretient et actualise de temps à autre, souvent pendant les week-ends ou après un plantage sérieux. Lorsque cela se produit, le solde de votre simulateur peut revenir à une valeur par défaut et votre configuration enregistrée peut être rétablie. Cela arrive généralement sans avertissement individuel, car il s'agit d'un événement de maintenance et non d'un élément lié à votre compte en particulier." },
    { q: "Une réinitialisation du simulateur supprime-t-elle mes stratégies ATM et mes indicateurs personnalisés ?", a: "C'est possible. Après une réinitialisation, les stratégies ATM et les profils de bracket peuvent être vides ou revenus aux valeurs par défaut, et les indicateurs personnalisés peuvent ne pas se charger sur vos graphiques. C'est pourquoi le plus sûr est de conserver une trace écrite ou une capture d'écran de chaque stratégie ATM sur laquelle vous comptez, afin de la reconstruire en quelques minutes plutôt qu'en une soirée." },
    { q: "Comment rétablir le solde de mon compte démo après une réinitialisation ?", a: "Sur la plateforme web, ouvrez Application Settings, allez dans l'onglet Accounts, sélectionnez votre compte démo ou SIM et utilisez l'option Modify Balance pour définir le montant souhaité. La modification est répercutée sur le bureau, le web et le mobile. Ajuster le solde n'est pas la même chose que prolonger un essai expiré." },
    { q: "Puis-je empêcher le compte de simulation de se réinitialiser ?", a: "Pas de votre côté, car l'environnement de simulation partagé est maintenu par Tradovate. La solution pratique est la préparation plutôt que la prévention : sauvegardez vos paramètres ATM en dehors de la plateforme, exportez ou capturez les résultats d'entraînement qui vous importent et traitez le solde du simulateur comme un réglage que vous fixez au début de chaque session plutôt que comme un score qui s'accumule." },
    { q: "Les comptes d'évaluation des prop firms se réinitialisent-ils de la même manière ?", a: "Non. Sur un compte financé ou d'évaluation, le solde, le drawdown, la clôture des positions en fin de journée et toute réinitialisation sont contrôlés par votre prop firm, et non par vous. Les chiffres précis et le comportement de la réinitialisation varient selon la société et la taille du compte ; vérifiez donc les règles en vigueur de votre société avant de supposer que quelque chose a cassé sur la plateforme." },
  ], it: [
    { q: "Perché il mio account di simulazione Tradovate si è reimpostato da solo?", a: "L'ambiente di simulazione è un sistema di pratica condiviso che Tradovate mantiene e aggiorna di tanto in tanto, spesso nei weekend o dopo un crash grave. Quando succede, il saldo del suo simulatore può tornare a un valore predefinito e la configurazione salvata può essere ripristinata. Di solito arriva senza un avviso individuale perché è un evento di manutenzione, non qualcosa legato al suo account specifico." },
    { q: "Un reset del simulatore elimina le mie strategie ATM e gli indicatori personalizzati?", a: "Può farlo. Dopo un reset, le strategie ATM e i profili di bracket possono risultare vuoti o ripristinati ai valori predefiniti, e gli indicatori personalizzati potrebbero non caricarsi sui suoi grafici. Per questo la mossa più sicura è conservare un appunto scritto o uno screenshot di ogni strategia ATM su cui fa affidamento, così da ricostruirla in un paio di minuti anziché in una serata." },
    { q: "Come ripristino il saldo del mio account demo dopo un reset?", a: "Nella piattaforma web, apra Application Settings, vada alla scheda Accounts, selezioni il suo account demo o SIM e usi l'opzione Modify Balance per impostare l'importo desiderato. La modifica si riflette su desktop, web e mobile. Regolare il saldo non equivale a prolungare una prova scaduta." },
    { q: "Posso impedire che l'account di simulazione si reimposti?", a: "Non da parte sua, perché l'ambiente di simulazione condiviso è gestito da Tradovate. La soluzione pratica è la preparazione e non la prevenzione: salvi i suoi parametri ATM al di fuori della piattaforma, esporti o catturi i risultati di pratica che le interessano e tratti il saldo del simulatore come una manopola che imposta all'inizio di ogni sessione anziché come un punteggio che si accumula." },
    { q: "Gli account di valutazione delle prop firm si reimpostano allo stesso modo?", a: "No. Su un account finanziato o di valutazione, il saldo, il drawdown, la chiusura delle posizioni a fine giornata e qualsiasi reset sono controllati dalla sua prop firm, non da lei. I numeri specifici e il comportamento del reset variano in base alla società e alle dimensioni del conto, quindi verifichi le regole attuali della sua società prima di presumere che qualcosa si sia rotto sulla piattaforma." },
  ] },
  relatedHeading: { en: "Related Guides", de: "Ähnliche Anleitungen", es: "Guías relacionadas", fr: "Guides associés", it: "Guide correlate" },
  disclosureText: { en: "This guide is for educational and informational purposes only and is not financial, investment, or trading advice. Trading futures and other leveraged products carries a substantial risk of loss and is not suitable for every investor. PickMyTrade is an independent third-party automation platform and is not affiliated with, endorsed by, or sponsored by Tradovate, Inc. All related names, logos, and trademarks are the property of their respective owners. Platform features and steps change over time, so always confirm the current process in the official platform documentation before acting.", de: "Diese Anleitung dient ausschließlich Bildungs- und Informationszwecken und stellt keine Finanz-, Anlage- oder Handelsberatung dar. Der Handel mit Futures und anderen gehebelten Produkten birgt ein erhebliches Verlustrisiko und ist nicht für jeden Anleger geeignet. PickMyTrade ist eine unabhängige Automatisierungsplattform eines Drittanbieters und steht in keiner Verbindung zu Tradovate, Inc., wird von diesem Unternehmen weder unterstützt noch gesponsert. „Tradovate“ sowie alle zugehörigen Namen, Logos und Marken sind Eigentum ihrer jeweiligen Inhaber. Funktionen und Schritte der Plattform ändern sich im Laufe der Zeit. Bestätigen Sie daher stets den aktuellen Ablauf in der offiziellen Tradovate-Plattform und -Dokumentation, bevor Sie handeln.", es: "Esta guía tiene fines exclusivamente educativos e informativos y no constituye asesoramiento financiero, de inversión ni de trading. Operar con futuros y otros productos apalancados conlleva un riesgo sustancial de pérdida y no es adecuado para todos los inversores. PickMyTrade es una plataforma de automatización independiente de terceros y no está afiliada, respaldada ni patrocinada por Tradovate, Inc. «Tradovate» y todos los nombres, logotipos y marcas relacionados son propiedad de sus respectivos titulares. Las funciones y los pasos de la plataforma cambian con el tiempo, por lo que debe confirmar siempre el proceso vigente en la plataforma y la documentación oficiales de Tradovate antes de actuar.", fr: "Ce guide est fourni à titre purement éducatif et informatif et ne constitue pas un conseil financier, d'investissement ou de trading. Le trading de contrats à terme et d'autres produits à effet de levier comporte un risque de perte important et ne convient pas à tous les investisseurs. PickMyTrade est une plateforme d'automatisation tierce indépendante et n'est ni affiliée à Tradovate, Inc., ni approuvée ou parrainée par cette société. « Tradovate » et tous les noms, logos et marques associés sont la propriété de leurs détenteurs respectifs. Les fonctionnalités et les étapes de la plateforme évoluent avec le temps ; vérifiez donc toujours la procédure en vigueur dans la plateforme et la documentation officielles de Tradovate avant d'agir.", it: "Questa guida ha finalità esclusivamente educative e informative e non costituisce consulenza finanziaria, di investimento o di trading. Il trading di futures e di altri prodotti a leva comporta un rischio di perdita sostanziale e non è adatto a tutti gli investitori. PickMyTrade è una piattaforma di automazione indipendente di terze parti e non è affiliata a Tradovate, Inc., né da essa approvata o sponsorizzata. «Tradovate» e tutti i nomi, loghi e marchi correlati sono di proprietà dei rispettivi titolari. Le funzionalità e i passaggi della piattaforma cambiano nel tempo, quindi confermi sempre la procedura attuale nella piattaforma e nella documentazione ufficiali di Tradovate prima di agire." },
};
const data: GuideArticleData = resolveGuideContent(content, locale, related);

