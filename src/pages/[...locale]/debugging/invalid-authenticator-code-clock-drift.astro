---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "invalid-authenticator-code-clock-drift";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/debugging/${SLUG}`;

const META_TITLE = "Tradovate Authenticator Code Invalid (Clock Drift)";
const META_DESCRIPTION =
  "Tradovate authenticator code invalid? It's clock drift. Turn on automatic date and time, sync your device, and make 2FA codes valid again in seconds.";

// Short SEO title (<=60 chars) for locales where the shared h1 is too long for a SERP title.
const TITLE_OVERRIDE: Partial<Record<Locale, string>> = { es: "Tradovate: código de autenticación inválido (reloj)", fr: "Tradovate : code d'authentification invalide (horloge)", it: "Tradovate: codice di autenticazione non valido (orologio)" };

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Tradovate: Authenticator-Code ungültig (Uhrenabweichung)", es: "Tradovate: código de autenticación inválido (desincronización del reloj)", fr: "Tradovate : code d'authentification invalide (dérive de l'horloge)", it: "Tradovate: codice di autenticazione non valido (desincronizzazione dell'orologio)" },
  dek: { en: "Every authenticator code you type into Tradovate comes back invalid. Nine times out of ten it's clock drift on your device, not a broken app or a locked account, here's the fix.", de: "Jeder Authenticator-Code, den Sie in Tradovate eingeben, kommt als ungültig zurück. In neun von zehn Fällen liegt es an einer Uhrenabweichung auf Ihrem Gerät, nicht an einer defekten App oder einem gesperrten Konto, hier die Lösung.", es: "Todos los códigos de autenticación que escribe en Tradovate vuelven como inválidos. Nueve de cada diez veces es la desincronización del reloj de su dispositivo, no una app rota ni una cuenta bloqueada, aquí está la solución.", fr: "Chaque code d'authentification que vous saisissez dans Tradovate revient invalide. Neuf fois sur dix, c'est une dérive de l'horloge de votre appareil, pas une application défaillante ou un compte bloqué, voici la solution.", it: "Ogni codice di autenticazione che digitate in Tradovate torna non valido. Nove volte su dieci è la desincronizzazione dell'orologio del vostro dispositivo, non un'app rotta o un account bloccato, ecco la soluzione." },
  readTime: { en: "7 min read", de: "7 Minuten Lesezeit", es: "Lectura de 7 minutos", fr: "Lecture de 7 minutes", it: "Lettura di 7 minuti" },
  lastUpdated: "2026-07-10",
  blocks: { en: [
    { type: "paragraph", html: "You open your authenticator app, read off the six digits, type them into Tradovate before they roll over, and it still says the code is invalid. Try again, same result. It feels like your 2FA is broken or your account is locked, especially when the market's moving and you just want in. Here's the calm truth: an invalid authenticator code almost never means anything is wrong with your account or your app. Nine times out of ten, the clock on the device running your authenticator has drifted a little out of sync with real network time, and that tiny gap is enough to make every code wrong. Fix the clock and the codes go valid again, usually in well under a minute. This guide explains exactly why it happens and walks you through the fix on iPhone, Android, and Windows." },
    {
      type: "checklist",
      heading: "Quick Fix for an Invalid Authenticator Code",
      items: [
        "<strong class='text-white'>Turn on automatic date and time</strong> on the device with your authenticator app. This is the single fix that clears most invalid-code problems.",
        "<strong class='text-white'>Force a fresh sync,</strong> toggle automatic time off, wait five seconds, turn it back on (or click Sync now on Windows).",
        "<strong class='text-white'>Read a brand-new code</strong> after the clock corrects, and enter it while it's fresh, not one that's a second from rolling over.",
        "<strong class='text-white'>Run the app's time-correction option</strong> if your authenticator has one buried in its settings.",
        "<strong class='text-white'>Don't rush to re-scan the QR code,</strong> a new code drifts for the same reason. Re-enrol only as a last resort.",
      ],
    },
    { type: "heading", text: "What \"Invalid Authenticator Code\" Actually Means" },
    { type: "paragraph", html: "When you enable an authenticator app for Tradovate, you scan a QR code that plants a secret key inside the app. From then on, the app produces a fresh six-digit code every 30 seconds. Tradovate holds the same secret on its servers and runs the same calculation. As long as both sides agree on what time it is, both produce the identical number, and your login sails through." },
    { type: "paragraph", html: "That's the catch hiding in plain sight: the code isn't just built from the secret, it's built from the secret <em>and the current time</em>. This is why it's called a TOTP, a <strong class='text-white'>time-based</strong> one-time password. Every 30-second block gets its own number. If your device thinks it's 10:42:05 while Tradovate's servers know it's 10:44:20, the two of you are calculating codes for different time windows, and the number you type will never match the number the server expects. Tradovate can only report what it sees: the code is invalid." },
    { type: "paragraph", html: "So an &ldquo;invalid authenticator code&rdquo; is rarely a wrong-code problem. It's a wrong-<em>time</em> problem. Your app is doing its job perfectly, it's just answering the question &ldquo;what's the code right now?&rdquo; with a clock that's telling it the wrong &ldquo;now.&rdquo;" },
    { type: "heading", text: "Why Clock Drift Breaks Your Codes" },
    { type: "paragraph", html: "Authentication servers do build in a little slack. Most accept the code for the current 30-second window plus one window on either side, roughly a 90-second tolerance in total. That's forgiving enough to cover small delays and the moment when a code is about to roll over. But once your device's clock drifts past that window, every code you generate lands outside the range the server will accept, and it's a clean, repeatable failure: not just this code, but the next one and the one after that." },
    { type: "paragraph", html: "Clock drift creeps in for boring, everyday reasons:" },
    { type: "heading", text: "1. Automatic time is turned off" },
    { type: "paragraph", html: "The most common cause by far. If someone set the clock by hand, or automatic time got switched off during setup, the device isn't correcting itself against a time server, so it slowly wanders. This is especially common after a factory reset or a fresh phone." },
    { type: "heading", text: "2. You travelled or crossed a time zone" },
    { type: "paragraph", html: "Land in a new city, and if your phone hasn't grabbed the new network time yet, the clock can be an hour (or more) out. People often &ldquo;fix&rdquo; it by setting the time manually, which stops automatic correction and leaves the seconds slightly off, exactly enough to break TOTP." },
    { type: "heading", text: "3. A phone or computer that rarely reboots" },
    { type: "paragraph", html: "Cheap internal clocks drift a few seconds a week. On a device that sleeps, wakes, and rarely restarts, that drift accumulates quietly until one day the codes stop working with no obvious trigger." },
    { type: "heading", text: "4. A new phone or a transferred authenticator" },
    { type: "paragraph", html: "Move your authenticator to a new handset, and if that device's automatic time isn't on yet, the freshly imported codes fail from the very first attempt, which makes it look like the transfer went wrong when the real culprit is the clock." },
    { type: "heading", text: "How to Fix an Invalid Authenticator Code: Step-by-Step" },
    { type: "paragraph", html: "Do this on the device that runs your authenticator app, that's the clock that matters, not the computer you're logging in on. Work top to bottom; most people are back in after the first step." },
    {
      type: "steps",
      items: [
        { title: "On iPhone (do this first)", html: "Open <strong class='text-white'>Settings &rarr; General &rarr; Date &amp; Time</strong>. Turn <strong class='text-white'>Set Automatically</strong> to <strong class='text-white'>On</strong>. If it was already on, toggle it off, wait about five seconds, then turn it back on to force a fresh sync. Confirm the <strong class='text-white'>Time Zone</strong> looks right for where you are. Open your authenticator, wait for a new code to appear, and enter that fresh code in Tradovate." },
        { title: "On Android", html: "Open <strong class='text-white'>Settings</strong> and go to <strong class='text-white'>System &rarr; Date &amp; time</strong> (some phones list it directly under Settings &gt; Date &amp; time or General management). Turn on <strong class='text-white'>Automatic date &amp; time</strong> (also shown as Use network-provided time), and turn on <strong class='text-white'>Automatic time zone</strong> too. If automatic time was already on, toggle it off and back on to force a re-sync. Read a fresh code from your authenticator and enter it in Tradovate." },
        { title: "On Windows (desktop authenticator or PC clock)", html: "Open <strong class='text-white'>Settings &rarr; Time &amp; language &rarr; Date &amp; time</strong> (or right-click the taskbar clock and choose Adjust date/time). Turn <strong class='text-white'>Set time automatically</strong> to <strong class='text-white'>On</strong>. Confirm <strong class='text-white'>Time zone</strong> is correct, turn on Set time zone automatically if you move around. Scroll to <strong class='text-white'>Additional settings</strong> and click <strong class='text-white'>Sync now</strong>. Wait for the &ldquo;last synced&rdquo; confirmation, then generate a fresh code and sign in." },
        { title: "The authenticator app's own time correction", html: "Some authenticator apps include a manual time-correction or &ldquo;sync now&rdquo; control in their own settings, separate from the device clock. If yours has one, running it re-checks the app's internal time offset and can clear a stubborn invalid code without changing anything system-wide. Not every app offers this, and if you can't find it, don't worry, fixing automatic system time achieves the same result, because most apps take their time straight from the device anyway." },
      ],
    },
    { type: "heading", text: "Troubleshooting Table" },
    {
      type: "table",
      headers: ["Symptom", "Likely Meaning", "Fix"],
      rows: [
        ["Every fresh code is rejected as invalid", "Device clock drifted past the tolerance window", "Turn on automatic date and time, force a re-sync, then enter a new code"],
        ["Started right after travel or a time-zone change", "Clock set manually / wrong zone", "Enable automatic time and automatic time zone"],
        ["Codes fail from the first try on a new phone", "Automatic time not yet enabled on the new device", "Switch on automatic time before using the transferred authenticator"],
        ["Time &ldquo;looks&rdquo; right but codes still fail", "Clock is off by seconds, not minutes", "Toggle auto-time off and on, or run the app's time-correction option"],
        ["Code works but only if typed instantly", "You're entering it as it rolls over", "Wait for a brand-new code, then type it right away"],
        ["Nothing works and you can't get in at all", "Lost or reset authenticator, or a firm-managed account", "Use backup codes, check your prop firm's rules, or contact support to reset 2FA"],
      ],
    },
    { type: "heading", text: "When It Isn't the Clock" },
    { type: "paragraph", html: "Clock drift covers the overwhelming majority of invalid-code cases, but a few others are worth ruling out. If you switched phones and didn't migrate the authenticator, the entry may simply be gone, you'll need your backup codes or a 2FA reset. If you have several accounts in the app, make sure you're reading the code for the <em>Tradovate</em> entry and not a look-alike. And if you trade a prop-firm or evaluation account, the firm may manage security settings on its side; some accounts don't let you self-manage 2FA at all. Rules vary by firm and account type, so check your firm's current policy rather than assuming. When you're truly locked out, backup recovery codes or a support-side reset are the safe way back in, don't keep hammering invalid codes, which can trip a temporary login lockout on top of everything else." },
    { type: "heading", text: "Keep Your Automation Flowing With PickMyTrade" },
    { type: "paragraph", html: "A 2FA prompt is a manual sign-in gate. Fixing your clock is on you, but your <em>automation</em> shouldn't grind to a halt every time a manual login gets fussy. That's the gap PickMyTrade closes:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Authorise Once, Route Continuously</strong>, connect your Tradovate account a single time and let your TradingView alerts flow through PickMyTrade's maintained link, instead of re-authenticating a browser session every time you want an order placed.",
        "<strong class='text-white'>Hands-Off Order Delivery</strong>, your strategy's entries and exits keep reaching Tradovate on schedule, so a fiddly login moment doesn't cost you a fill while price runs.",
        "<strong class='text-white'>Multi-Account Sync</strong>, mirror the same automated flow across every connected account, so one device's clock hiccup doesn't sideline your whole book.",
        "<strong class='text-white'>Steady, Rate-Limit-Safe Routing</strong>, orders are spaced so a burst of activity doesn't trip Tradovate's anti-abuse limits the way frantic manual retries can.",
      ],
    },
    { type: "paragraph", html: "Keep your device time synced either way, that's non-negotiable for logging in. PickMyTrade just makes sure a login stumble never quietly kills your trade routing." },
  ], de: [
    { type: "paragraph", html: "Sie öffnen Ihre Authenticator-App, lesen die sechs Ziffern ab, geben sie in Tradovate ein, bevor sie sich ändern, und trotzdem heißt es, der Code sei ungültig. Erneuter Versuch, gleiches Ergebnis. Es fühlt sich an, als wäre Ihre 2FA kaputt oder Ihr Konto gesperrt, besonders wenn sich der Markt bewegt und Sie einfach nur rein wollen. Hier die beruhigende Wahrheit: Ein ungültiger Authenticator-Code bedeutet fast nie, dass etwas mit Ihrem Konto oder Ihrer App nicht stimmt. In neun von zehn Fällen ist die Uhr auf dem Gerät, auf dem Ihr Authenticator läuft, ein wenig aus dem Takt mit der echten Netzwerkzeit geraten, und diese winzige Lücke reicht aus, um jeden Code falsch zu machen. Korrigieren Sie die Uhr, und die Codes sind wieder gültig, meist in deutlich unter einer Minute. Dieser Leitfaden erklärt genau, warum das passiert, und führt Sie durch die Lösung auf iPhone, Android und Windows." },
    {
      type: "checklist",
      heading: "Schnelllösung für einen ungültigen Authenticator-Code",
      items: [
        "<strong class='text-white'>Aktivieren Sie automatisches Datum und Uhrzeit</strong> auf dem Gerät mit Ihrer Authenticator-App. Das ist die eine Lösung, die die meisten Probleme mit ungültigen Codes behebt.",
        "<strong class='text-white'>Erzwingen Sie einen frischen Sync,</strong> schalten Sie die automatische Uhrzeit aus, warten Sie fünf Sekunden, schalten Sie sie wieder ein (oder klicken Sie unter Windows auf Jetzt synchronisieren).",
        "<strong class='text-white'>Lesen Sie einen brandneuen Code</strong> ab, nachdem die Uhr korrigiert wurde, und geben Sie ihn ein, solange er frisch ist, nicht einen, der gleich wechselt.",
        "<strong class='text-white'>Führen Sie die Zeitkorrekturoption der App aus,</strong> falls Ihr Authenticator eine in den Einstellungen versteckt hat.",
        "<strong class='text-white'>Scannen Sie den QR-Code nicht vorschnell neu,</strong> ein neuer Code driftet aus demselben Grund. Melden Sie sich nur als letztes Mittel neu an.",
      ],
    },
    { type: "heading", text: "Was \"ungültiger Authenticator-Code\" tatsächlich bedeutet" },
    { type: "paragraph", html: "Wenn Sie eine Authenticator-App für Tradovate aktivieren, scannen Sie einen QR-Code, der einen geheimen Schlüssel in der App hinterlegt. Von da an erzeugt die App alle 30 Sekunden einen neuen sechsstelligen Code. Tradovate hält denselben geheimen Schlüssel auf seinen Servern und führt dieselbe Berechnung durch. Solange sich beide Seiten einig sind, wie spät es ist, erzeugen beide dieselbe Zahl, und Ihre Anmeldung läuft durch." },
    { type: "paragraph", html: "Das ist der Haken, der offen zutage liegt: Der Code wird nicht nur aus dem geheimen Schlüssel gebildet, sondern aus dem geheimen Schlüssel <em>und der aktuellen Zeit</em>. Deshalb heißt es TOTP, ein <strong class='text-white'>zeitbasiertes</strong> Einmalpasswort. Jeder 30-Sekunden-Block erhält seine eigene Zahl. Wenn Ihr Gerät denkt, es sei 10:42:05 Uhr, während Tradovates Server wissen, dass es 10:44:20 Uhr ist, berechnen Sie beide Codes für unterschiedliche Zeitfenster, und die Zahl, die Sie eingeben, wird nie mit der Zahl übereinstimmen, die der Server erwartet. Tradovate kann nur melden, was es sieht: Der Code ist ungültig." },
    { type: "paragraph", html: "Ein \"ungültiger Authenticator-Code\" ist also selten ein Problem mit dem falschen Code. Es ist ein Problem mit der falschen <em>Zeit</em>. Ihre App macht ihre Arbeit einwandfrei, sie beantwortet nur die Frage \"Wie lautet der Code gerade jetzt?\" mit einer Uhr, die ihr das falsche \"jetzt\" sagt." },
    { type: "heading", text: "Warum Uhrenabweichung Ihre Codes zerstört" },
    { type: "paragraph", html: "Authentifizierungsserver bauen etwas Spielraum ein. Die meisten akzeptieren den Code für das aktuelle 30-Sekunden-Fenster plus ein Fenster auf jeder Seite, insgesamt also eine Toleranz von etwa 90 Sekunden. Das reicht, um kleine Verzögerungen und den Moment abzudecken, in dem ein Code gerade wechselt. Aber sobald die Uhr Ihres Geräts über dieses Fenster hinausdriftet, landet jeder von Ihnen erzeugte Code außerhalb des vom Server akzeptierten Bereichs, und es ist ein sauberer, wiederholbarer Fehler: nicht nur dieser Code, sondern auch der nächste und der übernächste." },
    { type: "paragraph", html: "Uhrenabweichung schleicht sich aus banalen, alltäglichen Gründen ein:" },
    { type: "heading", text: "1. Automatische Zeit ist ausgeschaltet" },
    { type: "paragraph", html: "Mit Abstand die häufigste Ursache. Wenn jemand die Uhr manuell eingestellt hat oder die automatische Zeit bei der Einrichtung ausgeschaltet wurde, korrigiert sich das Gerät nicht mehr anhand eines Zeitservers und driftet langsam ab. Das ist besonders häufig nach einem Zurücksetzen auf Werkseinstellungen oder bei einem neuen Telefon." },
    { type: "heading", text: "2. Sie sind gereist oder haben eine Zeitzone gewechselt" },
    { type: "paragraph", html: "Sie landen in einer neuen Stadt, und wenn Ihr Telefon die neue Netzwerkzeit noch nicht übernommen hat, kann die Uhr eine Stunde (oder mehr) danebenliegen. Menschen \"korrigieren\" das oft, indem sie die Zeit manuell einstellen, was die automatische Korrektur stoppt und die Sekunden leicht daneben liegen lässt, genau genug, um TOTP zu zerstören." },
    { type: "heading", text: "3. Ein Telefon oder Computer, der selten neu startet" },
    { type: "paragraph", html: "Günstige interne Uhren driften ein paar Sekunden pro Woche. Bei einem Gerät, das schläft, aufwacht und selten neu startet, sammelt sich diese Abweichung still an, bis die Codes eines Tages ohne offensichtlichen Auslöser nicht mehr funktionieren." },
    { type: "heading", text: "4. Ein neues Telefon oder ein übertragener Authenticator" },
    { type: "paragraph", html: "Übertragen Sie Ihren Authenticator auf ein neues Gerät, und wenn dessen automatische Zeit noch nicht aktiviert ist, schlagen die frisch importierten Codes schon beim ersten Versuch fehl, was so aussieht, als sei bei der Übertragung etwas schiefgelaufen, obwohl der wahre Übeltäter die Uhr ist." },
    { type: "heading", text: "So beheben Sie einen ungültigen Authenticator-Code: Schritt für Schritt" },
    { type: "paragraph", html: "Tun Sie dies auf dem Gerät, auf dem Ihre Authenticator-App läuft, das ist die Uhr, auf die es ankommt, nicht der Computer, auf dem Sie sich anmelden. Arbeiten Sie von oben nach unten; die meisten Menschen sind nach dem ersten Schritt wieder drin." },
    {
      type: "steps",
      items: [
        { title: "Auf dem iPhone (zuerst hiermit beginnen)", html: "Öffnen Sie <strong class='text-white'>Einstellungen &rarr; Allgemein &rarr; Datum &amp; Uhrzeit</strong>. Stellen Sie <strong class='text-white'>Automatisch einstellen</strong> auf <strong class='text-white'>An</strong>. War es bereits an, schalten Sie es aus, warten Sie etwa fünf Sekunden, dann wieder ein, um einen frischen Sync zu erzwingen. Bestätigen Sie, dass die <strong class='text-white'>Zeitzone</strong> für Ihren Standort stimmt. Öffnen Sie Ihren Authenticator, warten Sie, bis ein neuer Code erscheint, und geben Sie diesen frischen Code in Tradovate ein." },
        { title: "Auf Android", html: "Öffnen Sie <strong class='text-white'>Einstellungen</strong> und gehen Sie zu <strong class='text-white'>System &rarr; Datum &amp; Uhrzeit</strong> (bei manchen Telefonen direkt unter Einstellungen &gt; Datum &amp; Uhrzeit oder Allgemeine Verwaltung). Schalten Sie <strong class='text-white'>Automatisches Datum &amp; Uhrzeit</strong> ein (auch als Netzwerkbereitgestellte Zeit verwenden angezeigt), und schalten Sie auch <strong class='text-white'>Automatische Zeitzone</strong> ein. War die automatische Zeit bereits aktiviert, schalten Sie sie aus und wieder ein, um einen erneuten Sync zu erzwingen. Lesen Sie einen frischen Code aus Ihrem Authenticator und geben Sie ihn in Tradovate ein." },
        { title: "Unter Windows (Desktop-Authenticator oder PC-Uhr)", html: "Öffnen Sie <strong class='text-white'>Einstellungen &rarr; Zeit &amp; Sprache &rarr; Datum &amp; Uhrzeit</strong> (oder klicken Sie mit der rechten Maustaste auf die Taskleistenuhr und wählen Sie Datum/Uhrzeit anpassen). Stellen Sie <strong class='text-white'>Uhrzeit automatisch festlegen</strong> auf <strong class='text-white'>Ein</strong>. Bestätigen Sie, dass die <strong class='text-white'>Zeitzone</strong> korrekt ist, aktivieren Sie Zeitzone automatisch festlegen, wenn Sie viel unterwegs sind. Scrollen Sie zu <strong class='text-white'>Weitere Einstellungen</strong> und klicken Sie auf <strong class='text-white'>Jetzt synchronisieren</strong>. Warten Sie auf die Bestätigung \"zuletzt synchronisiert\", erzeugen Sie dann einen frischen Code und melden Sie sich an." },
        { title: "Die eigene Zeitkorrektur der Authenticator-App", html: "Manche Authenticator-Apps enthalten eine manuelle Zeitkorrektur oder eine \"Jetzt synchronisieren\"-Funktion in ihren eigenen Einstellungen, unabhängig von der Geräteuhr. Falls Ihre eine hat, überprüft ihr Ausführen den internen Zeitversatz der App erneut und kann einen hartnäckigen ungültigen Code beheben, ohne etwas systemweit zu ändern. Nicht jede App bietet das, und wenn Sie es nicht finden, keine Sorge, die Korrektur der automatischen Systemzeit erzielt dasselbe Ergebnis, da die meisten Apps ihre Zeit ohnehin direkt vom Gerät übernehmen." },
      ],
    },
    { type: "heading", text: "Fehlerbehebungstabelle" },
    {
      type: "table",
      headers: ["Symptom", "Wahrscheinliche Bedeutung", "Lösung"],
      rows: [
        ["Jeder frische Code wird als ungültig abgelehnt", "Geräteuhr ist über das Toleranzfenster hinaus gedriftet", "Automatisches Datum und Uhrzeit aktivieren, einen erneuten Sync erzwingen, dann einen neuen Code eingeben"],
        ["Begann direkt nach einer Reise oder einem Zeitzonenwechsel", "Uhr manuell eingestellt / falsche Zeitzone", "Automatische Zeit und automatische Zeitzone aktivieren"],
        ["Codes schlagen beim ersten Versuch auf einem neuen Telefon fehl", "Automatische Zeit auf dem neuen Gerät noch nicht aktiviert", "Automatische Zeit aktivieren, bevor Sie den übertragenen Authenticator verwenden"],
        ["Zeit \"sieht\" richtig aus, Codes schlagen trotzdem fehl", "Uhr weicht um Sekunden ab, nicht Minuten", "Automatische Zeit aus- und wieder einschalten, oder die Zeitkorrekturoption der App ausführen"],
        ["Code funktioniert, aber nur bei sofortiger Eingabe", "Sie geben ihn genau beim Wechsel ein", "Auf einen brandneuen Code warten und ihn sofort eingeben"],
        ["Nichts funktioniert und Sie kommen gar nicht rein", "Authenticator verloren oder zurückgesetzt, oder ein firmenverwaltetes Konto", "Backup-Codes verwenden, die Regeln Ihrer Prop-Firm prüfen oder den Support kontaktieren, um 2FA zurückzusetzen"],
      ],
    },
    { type: "heading", text: "Wenn es nicht an der Uhr liegt" },
    { type: "paragraph", html: "Uhrenabweichung deckt die überwältigende Mehrheit der Fälle mit ungültigen Codes ab, aber ein paar andere Ursachen sind es wert, ausgeschlossen zu werden. Wenn Sie das Telefon gewechselt und den Authenticator nicht übertragen haben, ist der Eintrag möglicherweise einfach weg, Sie benötigen Ihre Backup-Codes oder ein 2FA-Reset. Wenn Sie mehrere Konten in der App haben, stellen Sie sicher, dass Sie den Code für den <em>Tradovate</em>-Eintrag lesen und nicht für einen ähnlich aussehenden. Und wenn Sie ein Prop-Firm- oder Evaluierungskonto handeln, verwaltet die Firma die Sicherheitseinstellungen möglicherweise selbst; manche Konten erlauben gar keine eigenständige 2FA-Verwaltung. Die Regeln variieren je nach Firma und Kontotyp, prüfen Sie daher die aktuelle Richtlinie Ihrer Firma, statt es anzunehmen. Wenn Sie wirklich ausgesperrt sind, sind Backup-Wiederherstellungscodes oder ein Reset durch den Support der sichere Weg zurück, hämmern Sie nicht immer weiter ungültige Codes ein, das kann obendrein eine vorübergehende Anmeldesperre auslösen." },
    { type: "heading", text: "Halten Sie Ihre Automatisierung am Laufen mit PickMyTrade" },
    { type: "paragraph", html: "Eine 2FA-Abfrage ist eine manuelle Anmeldeschranke. Ihre Uhr zu korrigieren liegt bei Ihnen, aber Ihre <em>Automatisierung</em> sollte nicht jedes Mal ins Stocken geraten, wenn eine manuelle Anmeldung zickt. Genau diese Lücke schließt PickMyTrade:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Einmal autorisieren, durchgehend routen</strong>, verbinden Sie Ihr Tradovate-Konto ein einziges Mal und lassen Sie Ihre TradingView-Alerts über die dauerhafte Verbindung von PickMyTrade laufen, statt jedes Mal eine Browsersitzung neu zu authentifizieren, wenn Sie eine Order platzieren möchten.",
        "<strong class='text-white'>Hands-off-Orderzustellung</strong>, die Einstiege und Ausstiege Ihrer Strategie erreichen Tradovate weiterhin planmäßig, sodass ein umständlicher Anmeldemoment Sie keinen Fill kostet, während der Kurs läuft.",
        "<strong class='text-white'>Multi-Account Sync</strong>, spiegeln Sie denselben automatisierten Ablauf über alle verbundenen Konten hinweg, sodass der Uhr-Hänger eines Geräts nicht Ihr ganzes Buch lahmlegt.",
        "<strong class='text-white'>Stabiles, Rate-Limit-sicheres Routing</strong>, Orders werden gestaffelt, sodass ein Aktivitätsschub nie Tradovates Missbrauchsschutz-Limits auslöst, wie es hektische manuelle Wiederholungsversuche können.",
      ],
    },
    { type: "paragraph", html: "Halten Sie die Zeit Ihres Geräts trotzdem synchron, das ist für die Anmeldung nicht verhandelbar. PickMyTrade sorgt lediglich dafür, dass ein Anmeldestolperer nie still Ihr Order-Routing lahmlegt." },
  ], es: [
    { type: "paragraph", html: "Usted abre su app de autenticación, lee los seis dígitos, los escribe en Tradovate antes de que cambien, y aun así dice que el código no es válido. Lo intenta de nuevo, mismo resultado. Se siente como si su 2FA estuviera roto o su cuenta bloqueada, especialmente cuando el mercado se mueve y solo quiere entrar. Aquí está la verdad tranquilizadora: un código de autenticación inválido casi nunca significa que algo esté mal con su cuenta o su app. Nueve de cada diez veces, el reloj del dispositivo que ejecuta su autenticador se ha desincronizado ligeramente de la hora real de red, y esa pequeña brecha basta para que todos los códigos sean incorrectos. Corrija el reloj y los códigos vuelven a ser válidos, normalmente en bastante menos de un minuto. Esta guía explica exactamente por qué ocurre y le muestra la solución en iPhone, Android y Windows." },
    {
      type: "checklist",
      heading: "Solución rápida para un código de autenticación inválido",
      items: [
        "<strong class='text-white'>Active la fecha y hora automáticas</strong> en el dispositivo con su app de autenticación. Esta es la única solución que resuelve la mayoría de los problemas de código inválido.",
        "<strong class='text-white'>Fuerce una sincronización nueva,</strong> desactive la hora automática, espere cinco segundos, actívela de nuevo (o haga clic en Sincronizar ahora en Windows).",
        "<strong class='text-white'>Lea un código completamente nuevo</strong> después de que el reloj se corrija, e introdúzcalo mientras esté fresco, no uno que esté a punto de cambiar.",
        "<strong class='text-white'>Ejecute la opción de corrección horaria de la app</strong> si su autenticador tiene una escondida en su configuración.",
        "<strong class='text-white'>No se apresure a volver a escanear el código QR,</strong> un código nuevo se desincronizará por el mismo motivo. Vuelva a inscribirse solo como último recurso.",
      ],
    },
    { type: "heading", text: "Qué significa realmente \"código de autenticación inválido\"" },
    { type: "paragraph", html: "Cuando activa una app de autenticación para Tradovate, escanea un código QR que planta una clave secreta dentro de la app. A partir de ahí, la app genera un nuevo código de seis dígitos cada 30 segundos. Tradovate guarda la misma clave secreta en sus servidores y ejecuta el mismo cálculo. Mientras ambos lados coincidan en qué hora es, ambos generan el mismo número, y su inicio de sesión pasa sin problemas." },
    { type: "paragraph", html: "Ahí está la trampa a simple vista: el código no se construye solo a partir de la clave secreta, se construye a partir de la clave secreta <em>y la hora actual</em>. Por eso se llama TOTP, una contraseña de un solo uso <strong class='text-white'>basada en el tiempo</strong>. Cada bloque de 30 segundos tiene su propio número. Si su dispositivo cree que son las 10:42:05 mientras los servidores de Tradovate saben que son las 10:44:20, ambos están calculando códigos para ventanas de tiempo distintas, y el número que escriba nunca coincidirá con el que espera el servidor. Tradovate solo puede informar lo que ve: el código no es válido." },
    { type: "paragraph", html: "Así que un \"código de autenticación inválido\" rara vez es un problema de código equivocado. Es un problema de <em>hora</em> equivocada. Su app está haciendo su trabajo perfectamente, solo está respondiendo a la pregunta \"¿cuál es el código ahora mismo?\" con un reloj que le dice el \"ahora\" incorrecto." },
    { type: "heading", text: "Por qué la desincronización del reloj rompe sus códigos" },
    { type: "paragraph", html: "Los servidores de autenticación incorporan cierto margen. La mayoría acepta el código de la ventana actual de 30 segundos más una ventana a cada lado, aproximadamente 90 segundos de tolerancia en total. Eso es suficiente para cubrir pequeños retrasos y el momento en que un código está a punto de cambiar. Pero una vez que el reloj de su dispositivo se desvía más allá de esa ventana, cada código que genera cae fuera del rango que el servidor aceptará, y es un fallo limpio y repetible: no solo este código, sino el siguiente y el que viene después." },
    { type: "paragraph", html: "La desincronización del reloj se cuela por motivos aburridos y cotidianos:" },
    { type: "heading", text: "1. La hora automática está desactivada" },
    { type: "paragraph", html: "Con diferencia, la causa más común. Si alguien ajustó el reloj a mano, o la hora automática se desactivó durante la configuración, el dispositivo no se corrige contra un servidor de hora, así que va desviándose lentamente. Esto es especialmente común después de un restablecimiento de fábrica o en un teléfono nuevo." },
    { type: "heading", text: "2. Ha viajado o cruzado una zona horaria" },
    { type: "paragraph", html: "Aterriza en una ciudad nueva, y si su teléfono aún no ha tomado la nueva hora de red, el reloj puede estar una hora (o más) desfasado. La gente a menudo lo \"corrige\" ajustando la hora manualmente, lo que detiene la corrección automática y deja los segundos ligeramente desviados, justo lo suficiente para romper el TOTP." },
    { type: "heading", text: "3. Un teléfono o computadora que rara vez se reinicia" },
    { type: "paragraph", html: "Los relojes internos económicos se desvían unos segundos por semana. En un dispositivo que se duerme, despierta y rara vez se reinicia, esa desviación se acumula en silencio hasta que un día los códigos dejan de funcionar sin un desencadenante evidente." },
    { type: "heading", text: "4. Un teléfono nuevo o un autenticador transferido" },
    { type: "paragraph", html: "Mueva su autenticador a un dispositivo nuevo, y si la hora automática de ese dispositivo aún no está activada, los códigos recién importados fallan desde el primer intento, lo que hace que parezca que la transferencia salió mal cuando el verdadero culpable es el reloj." },
    { type: "heading", text: "Cómo corregir un código de autenticación inválido: paso a paso" },
    { type: "paragraph", html: "Haga esto en el dispositivo que ejecuta su app de autenticación, ese es el reloj que importa, no la computadora en la que está iniciando sesión. Trabaje de arriba abajo; la mayoría de las personas vuelven a entrar tras el primer paso." },
    {
      type: "steps",
      items: [
        { title: "En iPhone (haga esto primero)", html: "Abra <strong class='text-white'>Ajustes &rarr; General &rarr; Fecha y hora</strong>. Ponga <strong class='text-white'>Ajustar automáticamente</strong> en <strong class='text-white'>Activado</strong>. Si ya estaba activado, desactívelo, espere unos cinco segundos, y vuelva a activarlo para forzar una sincronización nueva. Confirme que la <strong class='text-white'>Zona horaria</strong> es correcta para su ubicación. Abra su autenticador, espere a que aparezca un código nuevo, e introduzca ese código fresco en Tradovate." },
        { title: "En Android", html: "Abra <strong class='text-white'>Ajustes</strong> y vaya a <strong class='text-white'>Sistema &rarr; Fecha y hora</strong> (en algunos teléfonos aparece directamente bajo Ajustes &gt; Fecha y hora o Gestión general). Active <strong class='text-white'>Fecha y hora automáticas</strong> (también mostrado como Usar hora proporcionada por la red), y active también <strong class='text-white'>Zona horaria automática</strong>. Si la hora automática ya estaba activada, desactívela y vuelva a activarla para forzar una resincronización. Lea un código fresco de su autenticador e introdúzcalo en Tradovate." },
        { title: "En Windows (autenticador de escritorio o reloj del PC)", html: "Abra <strong class='text-white'>Configuración &rarr; Hora e idioma &rarr; Fecha y hora</strong> (o haga clic derecho en el reloj de la barra de tareas y elija Ajustar fecha/hora). Ponga <strong class='text-white'>Establecer la hora automáticamente</strong> en <strong class='text-white'>Activado</strong>. Confirme que la <strong class='text-white'>Zona horaria</strong> es correcta, active Establecer la zona horaria automáticamente si se desplaza con frecuencia. Desplácese hasta <strong class='text-white'>Configuración adicional</strong> y haga clic en <strong class='text-white'>Sincronizar ahora</strong>. Espere la confirmación de \"última sincronización\", luego genere un código fresco e inicie sesión." },
        { title: "La corrección horaria propia de la app de autenticación", html: "Algunas apps de autenticación incluyen un control manual de corrección horaria o \"sincronizar ahora\" en su propia configuración, independiente del reloj del dispositivo. Si la suya tiene uno, ejecutarlo vuelve a comprobar el desfase horario interno de la app y puede resolver un código inválido persistente sin cambiar nada a nivel de sistema. No todas las apps lo ofrecen, y si no lo encuentra, no se preocupe, corregir la hora automática del sistema logra el mismo resultado, porque la mayoría de las apps toman la hora directamente del dispositivo de todos modos." },
      ],
    },
    { type: "heading", text: "Tabla de solución de problemas" },
    {
      type: "table",
      headers: ["Síntoma", "Significado probable", "Solución"],
      rows: [
        ["Cada código nuevo se rechaza como inválido", "El reloj del dispositivo se desvió más allá de la ventana de tolerancia", "Active la fecha y hora automáticas, fuerce una resincronización, luego introduzca un código nuevo"],
        ["Empezó justo después de un viaje o un cambio de zona horaria", "Reloj ajustado manualmente / zona incorrecta", "Active la hora automática y la zona horaria automática"],
        ["Los códigos fallan desde el primer intento en un teléfono nuevo", "Hora automática aún no activada en el nuevo dispositivo", "Active la hora automática antes de usar el autenticador transferido"],
        ["La hora \"parece\" correcta pero los códigos siguen fallando", "El reloj está desviado por segundos, no minutos", "Desactive y reactive la hora automática, o ejecute la opción de corrección horaria de la app"],
        ["El código funciona pero solo si se escribe al instante", "Lo está introduciendo justo cuando cambia", "Espere un código completamente nuevo y escríbalo de inmediato"],
        ["Nada funciona y no puede entrar en absoluto", "Autenticador perdido o restablecido, o cuenta gestionada por una firma", "Use códigos de respaldo, revise las reglas de su prop firm, o contacte con soporte para restablecer el 2FA"],
      ],
    },
    { type: "heading", text: "Cuando no es el reloj" },
    { type: "paragraph", html: "La desincronización del reloj cubre la gran mayoría de los casos de código inválido, pero vale la pena descartar algunas otras causas. Si cambió de teléfono y no migró el autenticador, la entrada puede simplemente haber desaparecido, necesitará sus códigos de respaldo o un restablecimiento del 2FA. Si tiene varias cuentas en la app, asegúrese de leer el código de la entrada de <em>Tradovate</em> y no uno parecido. Y si opera una cuenta de prop firm o de evaluación, la firma puede gestionar la configuración de seguridad por su cuenta; algunas cuentas no permiten gestionar el 2FA usted mismo en absoluto. Las reglas varían según la firma y el tipo de cuenta, así que revise la política actual de su firma en lugar de asumirlo. Cuando esté realmente bloqueado, los códigos de recuperación de respaldo o un restablecimiento por parte del soporte son la forma segura de volver a entrar, no siga introduciendo códigos inválidos, ya que eso puede provocar además un bloqueo temporal de inicio de sesión." },
    { type: "heading", text: "Mantenga su automatización funcionando con PickMyTrade" },
    { type: "paragraph", html: "Una solicitud de 2FA es una puerta de acceso manual. Corregir su reloj depende de usted, pero su <em>automatización</em> no debería detenerse cada vez que un inicio de sesión manual se complica. Esa es la brecha que PickMyTrade cierra:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Autorice una vez, enrute continuamente</strong>, conecte su cuenta de Tradovate una sola vez y deje que sus alertas de TradingView fluyan a través del enlace mantenido de PickMyTrade, en lugar de reautenticar una sesión de navegador cada vez que quiera colocar una orden.",
        "<strong class='text-white'>Entrega de órdenes sin intervención manual</strong>, las entradas y salidas de su estrategia siguen llegando a Tradovate a tiempo, así que un momento de inicio de sesión complicado no le cuesta un fill mientras el precio avanza.",
        "<strong class='text-white'>Multi-Account Sync</strong>, refleje el mismo flujo automatizado en todas las cuentas conectadas, así que el fallo de reloj de un dispositivo no deja fuera de juego a toda su cartera.",
        "<strong class='text-white'>Enrutamiento estable y seguro frente a límites de frecuencia</strong>, las órdenes se espacían para que una ráfaga de actividad nunca active los límites antiabuso de Tradovate, como sí pueden hacerlo los reintentos manuales frenéticos.",
      ],
    },
    { type: "paragraph", html: "Mantenga sincronizada la hora de su dispositivo de todos modos, eso no es negociable para iniciar sesión. PickMyTrade simplemente se asegura de que un tropiezo en el inicio de sesión nunca mate silenciosamente el enrutamiento de sus operaciones." },
  ], fr: [
    { type: "paragraph", html: "Vous ouvrez votre application d'authentification, relevez les six chiffres, les saisissez dans Tradovate avant qu'ils ne changent, et il indique quand même que le code n'est pas valide. Vous réessayez, même résultat. On a l'impression que votre 2FA est cassée ou que votre compte est bloqué, surtout quand le marché bouge et que vous voulez juste entrer. Voici la vérité rassurante : un code d'authentification invalide ne signifie presque jamais qu'il y a un problème avec votre compte ou votre application. Neuf fois sur dix, l'horloge de l'appareil qui exécute votre authentificateur s'est légèrement désynchronisée de l'heure réseau réelle, et ce petit écart suffit à rendre chaque code faux. Corrigez l'horloge et les codes redeviennent valides, généralement en bien moins d'une minute. Ce guide explique exactement pourquoi cela se produit et vous accompagne dans la correction sur iPhone, Android et Windows." },
    {
      type: "checklist",
      heading: "Solution rapide pour un code d'authentification invalide",
      items: [
        "<strong class='text-white'>Activez la date et l'heure automatiques</strong> sur l'appareil qui exécute votre application d'authentification. C'est la seule correction qui résout la plupart des problèmes de code invalide.",
        "<strong class='text-white'>Forcez une nouvelle synchronisation,</strong> désactivez l'heure automatique, attendez cinq secondes, réactivez-la (ou cliquez sur Synchroniser maintenant sous Windows).",
        "<strong class='text-white'>Relevez un tout nouveau code</strong> une fois l'horloge corrigée, et saisissez-le pendant qu'il est frais, pas un code sur le point de changer.",
        "<strong class='text-white'>Exécutez l'option de correction horaire de l'application</strong> si votre authentificateur en a une cachée dans ses réglages.",
        "<strong class='text-white'>Ne vous précipitez pas pour rescanner le code QR,</strong> un nouveau code dérivera pour la même raison. Ne réinscrivez qu'en dernier recours.",
      ],
    },
    { type: "heading", text: "Ce que signifie réellement \"code d'authentification invalide\"" },
    { type: "paragraph", html: "Lorsque vous activez une application d'authentification pour Tradovate, vous scannez un code QR qui plante une clé secrète dans l'application. Dès lors, l'application produit un nouveau code à six chiffres toutes les 30 secondes. Tradovate détient la même clé secrète sur ses serveurs et effectue le même calcul. Tant que les deux côtés s'accordent sur l'heure qu'il est, ils produisent tous deux le même nombre, et votre connexion passe sans encombre." },
    { type: "paragraph", html: "Voici le piège caché à la vue de tous : le code n'est pas construit uniquement à partir de la clé secrète, il est construit à partir de la clé secrète <em>et de l'heure actuelle</em>. C'est pourquoi on l'appelle TOTP, un mot de passe à usage unique <strong class='text-white'>basé sur le temps</strong>. Chaque bloc de 30 secondes a son propre nombre. Si votre appareil pense qu'il est 10:42:05 alors que les serveurs de Tradovate savent qu'il est 10:44:20, vous calculez tous deux des codes pour des fenêtres temporelles différentes, et le nombre que vous saisissez ne correspondra jamais au nombre attendu par le serveur. Tradovate ne peut que signaler ce qu'il voit : le code n'est pas valide." },
    { type: "paragraph", html: "Donc un \"code d'authentification invalide\" est rarement un problème de mauvais code. C'est un problème de mauvaise <em>heure</em>. Votre application fait parfaitement son travail, elle répond simplement à la question \"quel est le code en ce moment ?\" avec une horloge qui lui indique le mauvais \"maintenant\"." },
    { type: "heading", text: "Pourquoi la dérive de l'horloge casse vos codes" },
    { type: "paragraph", html: "Les serveurs d'authentification intègrent une certaine marge. La plupart acceptent le code de la fenêtre de 30 secondes en cours plus une fenêtre de chaque côté, soit environ 90 secondes de tolérance au total. C'est suffisamment souple pour couvrir de petits délais et le moment où un code est sur le point de changer. Mais une fois que l'horloge de votre appareil dérive au-delà de cette fenêtre, chaque code que vous générez tombe hors de la plage acceptée par le serveur, et c'est un échec net et reproductible : pas seulement ce code, mais le suivant et celui d'après." },
    { type: "paragraph", html: "La dérive de l'horloge s'installe pour des raisons banales et quotidiennes :" },
    { type: "heading", text: "1. L'heure automatique est désactivée" },
    { type: "paragraph", html: "De loin la cause la plus fréquente. Si quelqu'un a réglé l'horloge manuellement, ou si l'heure automatique a été désactivée lors de la configuration, l'appareil ne se corrige plus par rapport à un serveur de temps, et dérive donc lentement. C'est particulièrement courant après une réinitialisation d'usine ou sur un téléphone neuf." },
    { type: "heading", text: "2. Vous avez voyagé ou changé de fuseau horaire" },
    { type: "paragraph", html: "Vous atterrissez dans une nouvelle ville, et si votre téléphone n'a pas encore récupéré la nouvelle heure réseau, l'horloge peut être décalée d'une heure (ou plus). Les gens la \"corrigent\" souvent en réglant l'heure manuellement, ce qui arrête la correction automatique et laisse les secondes légèrement décalées, exactement assez pour casser le TOTP." },
    { type: "heading", text: "3. Un téléphone ou un ordinateur qui redémarre rarement" },
    { type: "paragraph", html: "Les horloges internes bon marché dérivent de quelques secondes par semaine. Sur un appareil qui se met en veille, se réveille, et redémarre rarement, cette dérive s'accumule silencieusement jusqu'à ce qu'un jour les codes cessent de fonctionner sans déclencheur évident." },
    { type: "heading", text: "4. Un nouveau téléphone ou un authentificateur transféré" },
    { type: "paragraph", html: "Déplacez votre authentificateur vers un nouvel appareil, et si l'heure automatique de cet appareil n'est pas encore activée, les codes fraîchement importés échouent dès la première tentative, ce qui donne l'impression que le transfert s'est mal passé alors que le vrai coupable est l'horloge." },
    { type: "heading", text: "Comment corriger un code d'authentification invalide : étape par étape" },
    { type: "paragraph", html: "Faites cela sur l'appareil qui exécute votre application d'authentification, c'est l'horloge qui compte, pas l'ordinateur sur lequel vous vous connectez. Procédez de haut en bas ; la plupart des gens sont reconnectés dès la première étape." },
    {
      type: "steps",
      items: [
        { title: "Sur iPhone (faites ceci en premier)", html: "Ouvrez <strong class='text-white'>Réglages &rarr; Général &rarr; Date et heure</strong>. Activez <strong class='text-white'>Réglage automatique</strong>. S'il était déjà activé, désactivez-le, attendez environ cinq secondes, puis réactivez-le pour forcer une nouvelle synchronisation. Confirmez que le <strong class='text-white'>Fuseau horaire</strong> correspond bien à votre position. Ouvrez votre authentificateur, attendez qu'un nouveau code apparaisse, et saisissez ce code frais dans Tradovate." },
        { title: "Sur Android", html: "Ouvrez <strong class='text-white'>Paramètres</strong> et allez dans <strong class='text-white'>Système &rarr; Date et heure</strong> (sur certains téléphones, c'est directement sous Paramètres &gt; Date et heure ou Gestion générale). Activez <strong class='text-white'>Date et heure automatiques</strong> (aussi affiché comme Utiliser l'heure fournie par le réseau), et activez également <strong class='text-white'>Fuseau horaire automatique</strong>. Si l'heure automatique était déjà activée, désactivez-la puis réactivez-la pour forcer une resynchronisation. Relevez un code frais sur votre authentificateur et saisissez-le dans Tradovate." },
        { title: "Sur Windows (authentificateur de bureau ou horloge du PC)", html: "Ouvrez <strong class='text-white'>Paramètres &rarr; Heure et langue &rarr; Date et heure</strong> (ou faites un clic droit sur l'horloge de la barre des tâches et choisissez Ajuster la date/l'heure). Activez <strong class='text-white'>Régler l'heure automatiquement</strong>. Confirmez que le <strong class='text-white'>Fuseau horaire</strong> est correct, activez Régler le fuseau horaire automatiquement si vous vous déplacez. Faites défiler jusqu'à <strong class='text-white'>Paramètres supplémentaires</strong> et cliquez sur <strong class='text-white'>Synchroniser maintenant</strong>. Attendez la confirmation de \"dernière synchronisation\", puis générez un code frais et connectez-vous." },
        { title: "La correction horaire propre à l'application d'authentification", html: "Certaines applications d'authentification incluent un contrôle manuel de correction horaire ou \"synchroniser maintenant\" dans leurs propres réglages, distinct de l'horloge de l'appareil. Si la vôtre en a un, l'exécuter revérifie le décalage horaire interne de l'application et peut résoudre un code invalide persistant sans rien changer au niveau du système. Toutes les applications ne l'offrent pas, et si vous ne le trouvez pas, ne vous inquiétez pas, corriger l'heure système automatique produit le même résultat, car la plupart des applications récupèrent l'heure directement de l'appareil de toute façon." },
      ],
    },
