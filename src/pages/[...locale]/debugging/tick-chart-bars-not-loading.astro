---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "tick-chart-bars-not-loading";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/debugging/${SLUG}`;

const META_TITLE = "Tradovate Tick Chart Bars Not Loading";
const META_DESCRIPTION =
  "Tradovate tick chart bars not loading? Switch to a time-based interval, reload the chart, or pick a higher-volume contract so the bars fill back in.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Tradovate Tick-Chart: Balken werden nicht geladen", es: "Gráfico de ticks de Tradovate: las barras no cargan", fr: "Graphique en ticks Tradovate : les barres ne se chargent pas", it: "Grafico a tick di Tradovate: le barre non si caricano" },
  dek: { en: "You flip a chart to a 1000-tick interval and it barely draws, three or four bars where you expected a full session of price action. Most of the time the platform is working exactly as designed, here's why and how to fix it.", de: "Sie schalten einen Chart auf ein 1000-Tick-Intervall und er zeichnet kaum etwas, drei oder vier Balken, wo Sie eine ganze Handelssitzung an Kursbewegung erwartet haben. Meistens arbeitet die Plattform genau so, wie sie konzipiert ist. Hier erfahren Sie, warum das so ist und wie Sie es beheben.", es: "Cambia un gráfico a un intervalo de 1000 ticks y apenas se dibuja: tres o cuatro barras donde esperaba una sesión completa de movimiento de precio. La mayoría de las veces la plataforma funciona exactamente como fue diseñada. Aquí le explicamos por qué y cómo solucionarlo.", fr: "Vous passez un graphique sur un intervalle de 1000 ticks et il se dessine à peine, trois ou quatre barres là où vous attendiez toute une séance de mouvement de prix. La plupart du temps, la plateforme fonctionne exactement comme prévu. Voici pourquoi, et comment y remédier.", it: "Imposta un grafico su un intervallo di 1000 tick e si disegna appena, tre o quattro barre dove si aspettava un'intera sessione di movimento di prezzo. Nella maggior parte dei casi la piattaforma funziona esattamente come progettato. Ecco perché succede e come risolvere." },
  readTime: { en: "8 min read", de: "8 Min. Lesezeit", es: "Lectura de 8 min", fr: "Lecture : 8 min", it: "Lettura di 8 min" },
  lastUpdated: "2026-07-10",
  blocks: { en: [
    { type: "paragraph", html: "You flip a chart to a 1000-tick interval and it barely draws, three or four bars where you expected a full session of price action. The 5-minute chart on the exact same symbol loads fine. It's one of the more confusing chart complaints on Tradovate, because nothing looks broken and yet the tick chart won't paint. Most of the time the platform is working exactly as designed; tick bars just behave differently from time bars, and once you know why they go sparse, the fix is usually one setting or one contract away." },
    { type: "paragraph", html: "The symptom wears a few hats: a tick chart that loads only a handful of bars, one that stalls and won't add new candles, tick history that dead-ends when you scroll back a couple of weeks, or a chart that sits blank until you nudge it. They mostly trace to two things, how tick bars are built and how much tick history your account can pull, plus the occasional stalled feed that a simple reload clears." },
    { type: "paragraph", html: "If you read tick charts by hand, one that won't paint can genuinely cost you a setup. If you automate, it matters far less: orders can fire from your TradingView alerts, not from whatever Tradovate's chart happens to be rendering, so a sparse tick chart never holds up a fill. Either way, here's how to get the bars back." },
    {
      type: "checklist",
      heading: "Quick Checklist for Tick Bars That Won't Load",
      items: [
        "<strong class='text-white'>Reload the chart</strong>, refresh the browser tab on Tradovate Web, or restart the desktop or mobile app, to re-pull the tick feed.",
        "<strong class='text-white'>Switch to a time-based interval</strong>, a 1-minute or 5-minute chart loads history the normal way and gets you trading again right away.",
        "<strong class='text-white'>Pick the active (front-month) contract</strong>, a thinly traded back month prints almost no ticks, so the chart looks empty.",
        "<strong class='text-white'>Mind the two-week tick window</strong>, default tick history is about two weeks; scroll past it and the bars stop.",
        "<strong class='text-white'>Add Extended Tick Data History</strong>, the add-on stretches tick history toward a year if your strategy needs it.",
        "<strong class='text-white'>Confirm live market data</strong>, a delayed or missing subscription (orange symbol name) can't paint current ticks.",
      ],
    },
    { type: "heading", text: "What “Tick Bars Not Loading” Actually Means" },
    { type: "paragraph", html: "A tick chart doesn't measure time, it counts trades. A 1000-tick bar closes after 1,000 trades print, then a new bar opens. That single detail explains most of what looks like a loading failure. When a market is quiet, or the contract you've selected barely trades, there simply aren't enough ticks to build bars, so the chart shows a thin scatter of candles instead of a filled screen. Nothing is stuck; the bars you're waiting for haven't been traded yet." },
    { type: "paragraph", html: "Compare that with a 5-minute chart, which prints one bar every five minutes whether ten contracts traded or ten thousand. Time charts can't look sparse, so the same slow market that leaves your tick chart nearly blank fills a time chart normally. That contrast is exactly why &ldquo;switch to a time-based interval&rdquo; is the fastest workaround, it sidesteps the tick-count dependency entirely." },
    { type: "paragraph", html: "The other half of the story is history depth. Tradovate loads roughly two weeks of tick data by default across all tick-based charts. Scroll back beyond that and the chart stops adding bars, which can read as a load failure when it's really a history limit. And on top of both, an ordinary stalled feed, the kind that hits right after the login rush at the open, can leave any chart, tick or time, temporarily blank until a reload re-establishes the data connection." },
    { type: "heading", text: "Top Causes of Tick Bars Not Loading" },
    { type: "heading", text: "1. Tick bars only form when trades print" },
    { type: "paragraph", html: "This is the big one. A tick chart adds a bar every time its trade count is met, so bar creation is tied directly to activity. Overnight, during lunch, or on a low-volume product, fewer trades means fewer bars, sometimes just a handful across a whole session. The chart isn't failing to load; the market hasn't generated the ticks yet." },
    { type: "heading", text: "2. You're on a thinly traded contract month" },
    { type: "paragraph", html: "Futures volume concentrates in one contract at a time, usually the front month. Pick a back month or a barely traded expiration and it may print only a trickle of ticks, which paints an almost-empty tick chart even in the middle of a busy session. Rolling to the actively traded contract is often the whole fix." },
    { type: "heading", text: "3. You scrolled past the two-week tick window" },
    { type: "paragraph", html: "Default tick history runs about two weeks. Drag the chart back far enough and it hits that wall and stops loading older bars. For a tick chart, that's expected behavior, not a bug, deeper tick history needs the extended-data add-on, or you use a time-based interval for the longer look-back." },
    { type: "heading", text: "4. A stalled or congested data feed" },
    { type: "paragraph", html: "At the cash open, every platform is hammering the data servers at once. Charts that load fine mid-session can crawl or sit blank for the first minute or two after login. A tick chart caught in that window looks especially empty because it's waiting on both the feed and enough trades to build bars." },
    { type: "heading", text: "5. Delayed or missing market-data subscription" },
    { type: "paragraph", html: "If the symbol name shows in orange, you're on delayed or no live data. A feed that isn't streaming in real time can't deliver the current trade prints a tick chart needs, so bars stall at the right edge. Data entitlements vary by account type and prop firm, so check your firm's current rules." },
    { type: "heading", text: "How to Fix Tick Bars That Won't Load: Step-by-Step" },
    { type: "heading", text: "Fix 1: Reload the chart to re-pull the tick feed" },
    { type: "paragraph", html: "Start here whenever the chart looks stalled rather than just quiet:" },
    {
      type: "steps",
      items: [
        { title: "Refresh on Tradovate Web", html: "On <strong class='text-white'>Tradovate Web</strong>, refresh the browser tab (F5 / Ctrl+R) to reconnect and re-request the tick data." },
        { title: "Restart the desktop app", html: "On the <strong class='text-white'>desktop app</strong>, close and reopen it, then sign back in." },
        { title: "Force-close on mobile", html: "On <strong class='text-white'>mobile</strong>, force-close and relaunch the app." },
      ],
    },
    { type: "paragraph", html: "There's no dedicated one-click &ldquo;refresh this chart&rdquo; button, so a browser refresh or an app restart is the reliable way to rebuild the data connection from scratch." },
    { type: "heading", text: "Fix 2: Switch to a time-based interval" },
    { type: "paragraph", html: "When you need a working chart immediately, say you're in a trade and the tick chart went blank, drop to a time-based interval and skip the tick-count dependency altogether:" },
    {
      type: "steps",
      items: [
        { title: "Open the interval selector", html: "Open the chart's interval or timeframe selector." },
        { title: "Choose a time-based option", html: "Choose a time-based option such as <strong class='text-white'>1 min</strong> or <strong class='text-white'>5 min</strong> instead of the tick type." },
        { title: "Let it fill in", html: "The chart loads history the standard way and fills in right away." },
      ],
    },
    { type: "paragraph", html: "When you pick a tick, volume, range, or second interval, Tradovate prompts you for the specific amount for each bar, so if you go back to ticks later, you'll re-enter your tick count there." },
    { type: "heading", text: "Fix 3: Move to the active front-month contract" },
    { type: "paragraph", html: "If the tick chart is sparse but the market is clearly active, you're probably on the wrong contract month:" },
    {
      type: "steps",
      items: [
        { title: "Open the contract selector", html: "Open the symbol or contract selector for the instrument." },
        { title: "Choose the front month", html: "Choose the <strong class='text-white'>front-month</strong> (actively traded) contract rather than a back month or a near-expiry one." },
        { title: "Watch bars populate", html: "The higher trade volume starts printing ticks, and the chart populates normally." },
      ],
    },
    { type: "paragraph", html: "This is a common trap around rollover, when the old contract's volume dries up and the new one takes over. If your platform flags that volume has shifted to a different expiration, follow it to the liquid contract." },
    { type: "heading", text: "Fix 4: Extend your tick history if you need more than two weeks" },
    { type: "paragraph", html: "If your tick chart loads fine but simply won't scroll back far enough, you've reached the default window. The Extended Tick Data History add-on opens up roughly a year of tick history:" },
    {
      type: "steps",
      items: [
        { title: "Open Application Settings", html: "Log in to <strong class='text-white'>Tradovate Web</strong> and open <strong class='text-white'>Application Settings</strong>." },
        { title: "Go to Add-ons", html: "Go to the <strong class='text-white'>Add-ons</strong> section." },
        { title: "Subscribe to Extended Tick Data History", html: "Find <strong class='text-white'>Extended Tick Data History</strong> and confirm the subscription (it covers simulation, live, and market replay)." },
      ],
    },
    { type: "paragraph", html: "Menu labels and add-on names shift between builds, so confirm the exact wording in your current settings. If you only need occasional deep history, a time-based interval is the free alternative." },
    { type: "heading", text: "Fix 5: Confirm your market-data subscription is live" },
    { type: "paragraph", html: "If the symbol name is orange or the right edge won't advance, your feed is delayed or off. Enable or subscribe to real-time market data (entitlements vary by account type and prop firm, so check your firm's current rules), then sign out and back in so the live feed attaches." },
    { type: "heading", text: "Troubleshooting Table" },
    {
      type: "table",
      headers: ["Symptom", "Meaning", "Fix"],
      rows: [
        ["Tick chart shows only a few bars, market is quiet", "Not enough trades have printed to build bars", "Wait for activity, or switch to a time-based interval"],
        ["Sparse tick chart while the market is clearly busy", "You're on a thinly traded contract month", "Roll to the active front-month contract"],
        ["Tick chart stalls, won't add new bars", "Data feed hung after login congestion", "Refresh the browser tab or restart the app"],
        ["Bars stop when you scroll back ~2 weeks", "Hit the default tick-history window", "Use a time interval, or add Extended Tick Data History"],
        ["Orange symbol name, right edge frozen", "Delayed or missing real-time market data", "Enable / subscribe to live data, then re-login"],
        ["Need a working chart right now, mid-trade", "Tick loading depends on trade flow", "Switch to 1-min or 5-min to keep trading"],
      ],
    },
    { type: "heading", text: "Prevent This With PickMyTrade" },
    { type: "paragraph", html: "A tick chart that won't paint is a display problem, but it turns into a <em>trading</em> problem the moment a blank chart hides your entry or you hesitate on a fill you can't see plotted. PickMyTrade keeps the chart out of the critical path for execution:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Alert-driven execution</strong>, orders fire from your TradingView alerts, not from Tradovate's chart render, so a sparse or stalled tick chart never delays a fill.",
        "<strong class='text-white'>Qty / symbol validation</strong>, every order is checked against the active contract and your size caps before it's sent, so a misread chart doesn't become a bad order.",
        "<strong class='text-white'>Rate-limit-safe routing</strong>, order flow is spaced out so nothing bounces during the same login-rush congestion that stalls your charts.",
        "<strong class='text-white'>Multi-account sync</strong>, the correct order mirrors across every linked account at once, with no manual re-entry while you wait for bars to build.",
      ],
    },
  ], de: [
    { type: "paragraph",html: "Sie schalten einen Chart auf ein 1000-Tick-Intervall und er zeichnet kaum etwas, drei oder vier Balken, wo Sie eine ganze Handelssitzung an Kursbewegung erwartet haben. Der 5-Minuten-Chart auf demselben Symbol lädt problemlos. Das ist eine der verwirrenderen Chart-Beschwerden bei Tradovate, denn nichts wirkt defekt und dennoch baut sich der Tick-Chart nicht auf. Meistens arbeitet die Plattform genau so, wie sie konzipiert ist; Tick-Balken verhalten sich einfach anders als Zeitbalken, und sobald Sie wissen, warum sie dünn besetzt sind, liegt die Lösung meist in einer Einstellung oder einem Kontrakt." },
    { type: "paragraph",html: "Das Symptom tritt in mehreren Varianten auf: ein Tick-Chart, der nur eine Handvoll Balken lädt, einer, der hängt und keine neuen Kerzen mehr hinzufügt, eine Tick-Historie, die beim Zurückscrollen nach ein paar Wochen endet, oder ein Chart, der leer bleibt, bis Sie ihn anstoßen. Meist gehen sie auf zwei Dinge zurück: wie Tick-Balken aufgebaut sind und wie viel Tick-Historie Ihr Konto abrufen kann, dazu gelegentlich ein hängender Feed, den ein einfacher Reload behebt." },
    { type: "paragraph",html: "Wenn Sie Tick-Charts von Hand lesen, kann ein Chart, der sich nicht aufbaut, Sie tatsächlich ein Setup kosten. Wenn Sie automatisieren, spielt das deutlich weniger eine Rolle: Orders können aus Ihren TradingView-Alerts ausgelöst werden, nicht aus dem, was der Tradovate-Chart gerade darstellt, sodass ein dünn besetzter Tick-Chart nie eine Ausführung aufhält. So oder so, hier erfahren Sie, wie Sie die Balken zurückbekommen." },
    {
      type: "checklist",
      heading: "Kurze Checkliste für Tick-Balken, die nicht laden",
      items: [
        "<strong class='text-white'>Chart neu laden</strong>, aktualisieren Sie den Browser-Tab in Tradovate Web oder starten Sie die Desktop- bzw. Mobile-App neu, um den Tick-Feed erneut abzurufen.",
        "<strong class='text-white'>Auf ein zeitbasiertes Intervall wechseln</strong>, ein 1-Minuten- oder 5-Minuten-Chart lädt die Historie auf normale Weise und macht Sie sofort wieder handlungsfähig.",
        "<strong class='text-white'>Den aktiven (Front-Month-)Kontrakt wählen</strong>, ein dünn gehandelter hinterer Monat erzeugt kaum Ticks, sodass der Chart leer wirkt.",
        "<strong class='text-white'>Das Zwei-Wochen-Tick-Fenster beachten</strong>, die Standard-Tick-Historie umfasst etwa zwei Wochen; scrollen Sie darüber hinaus, enden die Balken.",
        "<strong class='text-white'>Extended Tick Data History hinzufügen</strong>, das Add-on erweitert die Tick-Historie auf bis zu etwa ein Jahr, falls Ihre Strategie das benötigt.",
        "<strong class='text-white'>Live-Marktdaten bestätigen</strong>, ein verzögertes oder fehlendes Abonnement (orangefarbener Symbolname) kann keine aktuellen Ticks darstellen.",
      ],
    },
    { type: "heading",text: "Was „Tick-Balken laden nicht“ tatsächlich bedeutet" },
    { type: "paragraph",html: "Ein Tick-Chart misst keine Zeit, er zählt Trades. Ein 1000-Tick-Balken schließt, nachdem 1.000 Trades ausgeführt wurden, dann beginnt ein neuer Balken. Dieses eine Detail erklärt das meiste von dem, was wie ein Ladefehler aussieht. Ist der Markt ruhig oder wird der gewählte Kontrakt kaum gehandelt, gibt es schlicht zu wenige Ticks, um Balken zu bilden, und der Chart zeigt ein dünnes Streuen von Kerzen statt eines gefüllten Bildschirms. Nichts hängt; die Balken, auf die Sie warten, sind einfach noch nicht gehandelt worden." },
    { type: "paragraph",html: "Vergleichen Sie das mit einem 5-Minuten-Chart, der alle fünf Minuten einen Balken erzeugt, egal ob zehn oder zehntausend Kontrakte gehandelt wurden. Zeitcharts können nicht dünn besetzt aussehen, daher füllt derselbe ruhige Markt, der Ihren Tick-Chart fast leer lässt, einen Zeitchart ganz normal. Genau deshalb ist &ldquo;auf ein zeitbasiertes Intervall wechseln&rdquo; die schnellste Übergangslösung, denn sie umgeht die Abhängigkeit von der Tick-Anzahl vollständig." },
    { type: "paragraph",html: "Die andere Hälfte der Geschichte ist die Tiefe der Historie. Tradovate lädt standardmäßig etwa zwei Wochen Tickdaten für alle tickbasierten Charts. Scrollen Sie weiter zurück, fügt der Chart keine Balken mehr hinzu, was wie ein Ladefehler wirken kann, obwohl es sich um ein Historienlimit handelt. Hinzu kommt ein gewöhnlicher hängender Feed, wie er nach dem Login-Ansturm zur Eröffnung auftritt und jeden Chart, ob Tick oder Zeit, vorübergehend leer lassen kann, bis ein Reload die Datenverbindung neu aufbaut." },
    { type: "heading",text: "Die häufigsten Ursachen für nicht ladende Tick-Balken" },
    { type: "heading",text: "1. Tick-Balken entstehen nur, wenn Trades ausgeführt werden" },
    { type: "paragraph",html: "Das ist der große Punkt. Ein Tick-Chart fügt jedes Mal einen Balken hinzu, wenn seine Trade-Anzahl erreicht ist; die Balkenbildung hängt also direkt von der Aktivität ab. Über Nacht, in der Mittagspause oder bei einem umsatzschwachen Produkt bedeuten weniger Trades weniger Balken, manchmal nur eine Handvoll über eine ganze Sitzung. Der Chart lädt nicht fehlerhaft; der Markt hat die Ticks schlicht noch nicht erzeugt." },
    { type: "heading",text: "2. Sie sind auf einem dünn gehandelten Kontraktmonat" },
    { type: "paragraph",html: "Das Futures-Volumen konzentriert sich jeweils auf einen Kontrakt, meist den Front-Month. Wählen Sie einen hinteren Monat oder einen kaum gehandelten Verfall, erzeugt er womöglich nur ein Rinnsal an Ticks, was selbst mitten in einer lebhaften Sitzung einen fast leeren Tick-Chart ergibt. Der Wechsel auf den aktiv gehandelten Kontrakt ist oft die ganze Lösung." },
    { type: "heading",text: "3. Sie sind über das Zwei-Wochen-Tick-Fenster hinaus gescrollt" },
    { type: "paragraph",html: "Die Standard-Tick-Historie reicht etwa zwei Wochen zurück. Ziehen Sie den Chart weit genug zurück, stößt er an diese Grenze und lädt keine älteren Balken mehr. Bei einem Tick-Chart ist das erwartetes Verhalten, kein Fehler; eine tiefere Tick-Historie erfordert das Erweiterungs-Add-on, oder Sie nutzen für einen längeren Rückblick ein zeitbasiertes Intervall." },
    { type: "heading",text: "4. Ein hängender oder überlasteter Datenfeed" },
    { type: "paragraph",html: "Zur Eröffnung des Kassamarkts belasten alle Plattformen gleichzeitig die Datenserver. Charts, die mitten in der Sitzung problemlos laden, können in der ersten oder zweiten Minute nach dem Login nur langsam laden oder leer bleiben. Ein Tick-Chart, der in dieses Fenster gerät, wirkt besonders leer, weil er sowohl auf den Feed als auch auf genügend Trades zum Bilden der Balken wartet." },
    { type: "heading",text: "5. Verzögertes oder fehlendes Marktdaten-Abonnement" },
    { type: "paragraph",html: "Wenn der Symbolname orange angezeigt wird, haben Sie verzögerte oder keine Live-Daten. Ein Feed, der nicht in Echtzeit streamt, kann die aktuellen Trade-Prints, die ein Tick-Chart benötigt, nicht liefern, sodass die Balken am rechten Rand stehen bleiben. Datenberechtigungen variieren je nach Kontotyp und Prop-Firma; prüfen Sie daher die aktuellen Regeln Ihrer Firma." },
    { type: "heading",text: "So beheben Sie nicht ladende Tick-Balken: Schritt für Schritt" },
    { type: "heading",text: "Lösung 1: Chart neu laden, um den Tick-Feed erneut abzurufen" },
    { type: "paragraph",html: "Beginnen Sie hier, wann immer der Chart hängt statt nur ruhig zu sein:" },
    {
      type: "steps",
      items: [
        { title: "Auf Tradovate Web aktualisieren", html: "Aktualisieren Sie in <strong class='text-white'>Tradovate Web</strong> den Browser-Tab (F5 / Strg+R), um die Verbindung neu aufzubauen und die Tickdaten erneut anzufordern." },
        { title: "Desktop-App neu starten", html: "Schließen Sie die <strong class='text-white'>Desktop-App</strong> und öffnen Sie sie erneut, melden Sie sich dann wieder an." },
        { title: "Auf dem Handy erzwungen beenden", html: "Beenden Sie die App auf dem <strong class='text-white'>Mobilgerät</strong> erzwungen und starten Sie sie neu." },
      ],
    },
    { type: "paragraph",html: "Es gibt keine eigene Ein-Klick-Schaltfläche &ldquo;diesen Chart aktualisieren&rdquo;, daher ist ein Browser-Refresh oder ein App-Neustart der zuverlässige Weg, die Datenverbindung von Grund auf neu aufzubauen." },
    { type: "heading",text: "Lösung 2: Auf ein zeitbasiertes Intervall wechseln" },
    { type: "paragraph",html: "Wenn Sie sofort einen funktionierenden Chart brauchen, etwa weil Sie in einem Trade sind und der Tick-Chart leer wurde, wechseln Sie auf ein zeitbasiertes Intervall und umgehen die Abhängigkeit von der Tick-Anzahl ganz:" },
    {
      type: "steps",
      items: [
        { title: "Intervallauswahl öffnen", html: "Öffnen Sie die Intervall- bzw. Zeitrahmenauswahl des Charts." },
        { title: "Zeitbasierte Option wählen", html: "Wählen Sie statt des Tick-Typs eine zeitbasierte Option wie <strong class='text-white'>1 min</strong> oder <strong class='text-white'>5 min</strong>." },
        { title: "Füllen lassen", html: "Der Chart lädt die Historie auf Standardweise und füllt sich sofort." },
      ],
    },
    { type: "paragraph",html: "Wenn Sie ein Tick-, Volumen-, Range- oder Sekunden-Intervall wählen, fragt Tradovate Sie nach dem konkreten Wert für jeden Balken. Wechseln Sie später wieder zu Ticks, geben Sie dort Ihre Tick-Anzahl erneut ein." },
    { type: "heading",text: "Lösung 3: Zum aktiven Front-Month-Kontrakt wechseln" },
    { type: "paragraph",html: "Ist der Tick-Chart dünn besetzt, der Markt aber klar aktiv, sind Sie wahrscheinlich im falschen Kontraktmonat:" },
    {
      type: "steps",
      items: [
        { title: "Kontraktauswahl öffnen", html: "Öffnen Sie die Symbol- bzw. Kontraktauswahl für das Instrument." },
        { title: "Front-Month wählen", html: "Wählen Sie den <strong class='text-white'>Front-Month</strong>-Kontrakt (aktiv gehandelt) statt eines hinteren Monats oder eines kurz vor Verfall stehenden." },
        { title: "Balken füllen sich beobachten", html: "Das höhere Handelsvolumen erzeugt Ticks und der Chart füllt sich wie gewohnt." },
      ],
    },
    { type: "paragraph",html: "Rund um den Rollover ist das eine häufige Falle, wenn das Volumen des alten Kontrakts versiegt und der neue übernimmt. Weist Ihre Plattform darauf hin, dass sich das Volumen auf einen anderen Verfall verlagert hat, folgen Sie ihr zum liquiden Kontrakt." },
    { type: "heading",text: "Lösung 4: Tick-Historie erweitern, wenn Sie mehr als zwei Wochen brauchen" },
    { type: "paragraph",html: "Lädt Ihr Tick-Chart problemlos, lässt sich aber nicht weit genug zurückscrollen, haben Sie das Standardfenster erreicht. Das Add-on „Extended Tick Data History“ öffnet rund ein Jahr Tick-Historie:" },
    {
      type: "steps",
      items: [
        { title: "Application Settings öffnen", html: "Melden Sie sich bei <strong class='text-white'>Tradovate Web</strong> an und öffnen Sie die <strong class='text-white'>Application Settings</strong>." },
        { title: "Zu Add-ons wechseln", html: "Gehen Sie zum Bereich <strong class='text-white'>Add-ons</strong>." },
        { title: "Extended Tick Data History abonnieren", html: "Suchen Sie <strong class='text-white'>Extended Tick Data History</strong> und bestätigen Sie das Abonnement (es gilt für Simulation, Live-Handel und Market Replay)." },
      ],
    },
    { type: "paragraph",html: "Menübezeichnungen und Add-on-Namen ändern sich zwischen Versionen, bestätigen Sie daher den genauen Wortlaut in Ihren aktuellen Einstellungen. Wenn Sie nur gelegentlich eine tiefe Historie brauchen, ist ein zeitbasiertes Intervall die kostenlose Alternative." },
    { type: "heading",text: "Lösung 5: Bestätigen, dass Ihr Marktdaten-Abonnement aktiv ist" },
    { type: "paragraph",html: "Ist der Symbolname orange oder rückt der rechte Rand nicht vor, ist Ihr Feed verzögert oder aus. Aktivieren oder abonnieren Sie Echtzeit-Marktdaten (die Berechtigungen variieren je nach Kontotyp und Prop-Firma, prüfen Sie daher die aktuellen Regeln Ihrer Firma) und melden Sie sich dann ab und wieder an, damit der Live-Feed greift." },
    { type: "heading",text: "Tabelle zur Fehlerbehebung" },
    { type: "table", headers: ["Symptom","Bedeutung","Lösung"], rows: [
      ["Tick-Chart zeigt nur wenige Balken, Markt ist ruhig","Es wurden nicht genug Trades ausgeführt, um Balken zu bilden","Auf Aktivität warten oder auf ein zeitbasiertes Intervall wechseln"],
      ["Dünn besetzter Tick-Chart, obwohl der Markt klar lebhaft ist","Sie sind auf einem dünn gehandelten Kontraktmonat","Auf den aktiven Front-Month-Kontrakt rollen"],
      ["Tick-Chart hängt, fügt keine neuen Balken hinzu","Datenfeed nach Login-Überlastung hängen geblieben","Browser-Tab aktualisieren oder App neu starten"],
      ["Balken enden beim Zurückscrollen nach ca. 2 Wochen","Standard-Fenster der Tick-Historie erreicht","Zeitintervall nutzen oder Extended Tick Data History hinzufügen"],
      ["Orangefarbener Symbolname, rechter Rand eingefroren","Verzögerte oder fehlende Echtzeit-Marktdaten","Live-Daten aktivieren / abonnieren, dann neu anmelden"],
      ["Sie brauchen sofort einen funktionierenden Chart, mitten im Trade","Das Laden von Ticks hängt vom Handelsfluss ab","Auf 1 min oder 5 min wechseln, um weiterzuhandeln"],
    ] },
    { type: "heading",text: "Verhindern Sie das mit PickMyTrade" },
    { type: "paragraph",html: "Ein Tick-Chart, der sich nicht aufbaut, ist ein Darstellungsproblem, wird aber zu einem <em>Handelsproblem</em>, sobald ein leerer Chart Ihren Einstieg verbirgt oder Sie bei einer Ausführung zögern, die Sie nicht eingezeichnet sehen. PickMyTrade hält den Chart aus dem kritischen Pfad der Ausführung heraus:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Alert-gesteuerte Ausführung</strong>, Orders werden aus Ihren TradingView-Alerts ausgelöst, nicht aus der Chart-Darstellung von Tradovate, sodass ein dünn besetzter oder hängender Tick-Chart eine Ausführung nie verzögert.",
        "<strong class='text-white'>Menge-/Symbol-Validierung</strong>, jede Order wird vor dem Senden gegen den aktiven Kontrakt und Ihre Größenlimits geprüft, sodass ein falsch gelesener Chart nicht zu einer fehlerhaften Order wird.",
        "<strong class='text-white'>Ratenlimit-sicheres Routing</strong>, der Orderfluss wird getaktet, sodass nichts zurückgewiesen wird, wenn dieselbe Login-Überlastung auch Ihre Charts ausbremst.",
        "<strong class='text-white'>Multi-Account-Sync</strong>, die korrekte Order wird gleichzeitig auf alle verknüpften Konten gespiegelt, ohne manuelle Neueingabe, während Sie auf Balken warten.",
      ],
    },
  ], es: [
    { type: "paragraph",html: "Cambia un gráfico a un intervalo de 1000 ticks y apenas se dibuja: tres o cuatro barras donde esperaba una sesión completa de movimiento de precio. El gráfico de 5 minutos del mismo símbolo carga sin problema. Es una de las quejas de gráficos más desconcertantes en Tradovate, porque nada parece roto y, sin embargo, el gráfico de ticks no se pinta. La mayoría de las veces la plataforma funciona exactamente como fue diseñada; las barras de ticks simplemente se comportan de otra manera que las barras de tiempo y, una vez que sabe por qué quedan escasas, la solución suele ser un ajuste o un contrato." },
    { type: "paragraph",html: "El síntoma adopta varias formas: un gráfico de ticks que carga solo un puñado de barras, uno que se detiene y no añade velas nuevas, un historial de ticks que termina al desplazarse un par de semanas atrás, o un gráfico que permanece en blanco hasta que lo mueve. En su mayoría se deben a dos cosas: cómo se construyen las barras de ticks y cuánto historial de ticks puede obtener su cuenta, además de algún flujo de datos atascado ocasional que se resuelve con una simple recarga." },
    { type: "paragraph",html: "Si lee los gráficos de ticks a mano, uno que no se pinta puede costarle realmente una operación. Si automatiza, importa mucho menos: las órdenes pueden dispararse desde sus alertas de TradingView, no desde lo que el gráfico de Tradovate esté renderizando, de modo que un gráfico de ticks escaso nunca retrasa una ejecución. En cualquier caso, así es como recupera las barras." },
    {
      type: "checklist",
      heading: "Lista rápida para barras de ticks que no cargan",
      items: [
        "<strong class='text-white'>Recargue el gráfico</strong>, actualice la pestaña del navegador en Tradovate Web, o reinicie la aplicación de escritorio o móvil, para volver a obtener el flujo de ticks.",
        "<strong class='text-white'>Cambie a un intervalo basado en tiempo</strong>, un gráfico de 1 minuto o 5 minutos carga el historial de forma normal y le permite volver a operar de inmediato.",
        "<strong class='text-white'>Elija el contrato activo (mes frontal)</strong>, un mes posterior con poca negociación genera casi ningún tick, por lo que el gráfico parece vacío.",
        "<strong class='text-white'>Tenga en cuenta la ventana de dos semanas de ticks</strong>, el historial de ticks predeterminado es de unas dos semanas; si se desplaza más allá, las barras se detienen.",
        "<strong class='text-white'>Añada Extended Tick Data History</strong>, el complemento amplía el historial de ticks hasta cerca de un año si su estrategia lo necesita.",
        "<strong class='text-white'>Confirme los datos de mercado en vivo</strong>, una suscripción retrasada o ausente (nombre del símbolo en naranja) no puede pintar los ticks actuales.",
      ],
    },
    { type: "heading",text: "Qué significa realmente «las barras de ticks no cargan»" },
    { type: "paragraph",html: "Un gráfico de ticks no mide el tiempo, cuenta operaciones. Una barra de 1000 ticks se cierra cuando se han ejecutado 1.000 operaciones y entonces se abre una nueva. Ese único detalle explica la mayor parte de lo que parece un fallo de carga. Cuando el mercado está tranquilo, o el contrato que ha seleccionado apenas se negocia, simplemente no hay suficientes ticks para formar barras, así que el gráfico muestra una dispersión tenue de velas en lugar de una pantalla llena. Nada está atascado; las barras que espera todavía no se han negociado." },
    { type: "paragraph",html: "Compárelo con un gráfico de 5 minutos, que imprime una barra cada cinco minutos se hayan negociado diez contratos o diez mil. Los gráficos de tiempo no pueden verse escasos, así que el mismo mercado lento que deja su gráfico de ticks casi en blanco llena un gráfico de tiempo con normalidad. Por eso &ldquo;cambie a un intervalo basado en tiempo&rdquo; es la solución más rápida: elude por completo la dependencia del número de ticks." },
    { type: "paragraph",html: "La otra mitad de la historia es la profundidad del historial. Tradovate carga aproximadamente dos semanas de datos de ticks de forma predeterminada en todos los gráficos basados en ticks. Si se desplaza más atrás, el gráfico deja de añadir barras, lo que puede parecer un fallo de carga cuando en realidad es un límite de historial. Y además de ambos, un flujo de datos atascado común, como el que aparece tras la avalancha de inicios de sesión en la apertura, puede dejar cualquier gráfico, de ticks o de tiempo, temporalmente en blanco hasta que una recarga restablezca la conexión de datos." },
    { type: "heading",text: "Principales causas de que las barras de ticks no carguen" },
    { type: "heading",text: "1. Las barras de ticks solo se forman cuando se ejecutan operaciones" },
    { type: "paragraph",html: "Este es el punto principal. Un gráfico de ticks añade una barra cada vez que se cumple su número de operaciones, así que la creación de barras está ligada directamente a la actividad. Por la noche, a la hora del almuerzo o en un producto de bajo volumen, menos operaciones significan menos barras, a veces solo un puñado en toda una sesión. El gráfico no falla al cargar; el mercado todavía no ha generado los ticks." },
    { type: "heading",text: "2. Está en un mes de contrato con poca negociación" },
    { type: "paragraph",html: "El volumen de futuros se concentra en un contrato a la vez, normalmente el mes frontal. Si elige un mes posterior o un vencimiento apenas negociado, puede generar solo un goteo de ticks, lo que pinta un gráfico de ticks casi vacío incluso en plena sesión activa. Pasar al contrato más negociado suele ser toda la solución." },
    { type: "heading",text: "3. Se desplazó más allá de la ventana de dos semanas de ticks" },
    { type: "paragraph",html: "El historial de ticks predeterminado abarca unas dos semanas. Si arrastra el gráfico hacia atrás lo suficiente, choca con ese muro y deja de cargar barras más antiguas. En un gráfico de ticks, eso es un comportamiento esperado, no un error; un historial de ticks más profundo requiere el complemento de datos ampliados, o bien usar un intervalo basado en tiempo para una retrospectiva más larga." },
    { type: "heading",text: "4. Un flujo de datos atascado o congestionado" },
    { type: "paragraph",html: "En la apertura del mercado de contado, todas las plataformas saturan los servidores de datos a la vez. Los gráficos que cargan bien a mitad de sesión pueden ir lentos o quedarse en blanco durante el primer minuto o dos tras iniciar sesión. Un gráfico de ticks atrapado en esa ventana parece especialmente vacío porque espera tanto al flujo de datos como a suficientes operaciones para formar barras." },
    { type: "heading",text: "5. Suscripción de datos de mercado retrasada o ausente" },
    { type: "paragraph",html: "Si el nombre del símbolo aparece en naranja, tiene datos retrasados o ninguno en vivo. Un flujo que no transmite en tiempo real no puede entregar las operaciones actuales que necesita un gráfico de ticks, por lo que las barras se detienen en el borde derecho. Los permisos de datos varían según el tipo de cuenta y la firma de fondeo, así que consulte las reglas vigentes de su firma." },
    { type: "heading",text: "Cómo solucionar las barras de ticks que no cargan: paso a paso" },
    { type: "heading",text: "Solución 1: recargue el gráfico para volver a obtener el flujo de ticks" },
    { type: "paragraph",html: "Empiece aquí siempre que el gráfico parezca atascado y no simplemente tranquilo:" },
    {
      type: "steps",
      items: [
        { title: "Actualice en Tradovate Web", html: "En <strong class='text-white'>Tradovate Web</strong>, actualice la pestaña del navegador (F5 / Ctrl+R) para reconectar y volver a solicitar los datos de ticks." },
        { title: "Reinicie la aplicación de escritorio", html: "En la <strong class='text-white'>aplicación de escritorio</strong>, ciérrela y vuelva a abrirla, y luego inicie sesión de nuevo." },
        { title: "Fuerce el cierre en el móvil", html: "En el <strong class='text-white'>móvil</strong>, fuerce el cierre de la aplicación y vuelva a abrirla." },
      ],
    },
    { type: "paragraph",html: "No existe un botón específico de un clic para &ldquo;actualizar este gráfico&rdquo;, por lo que actualizar el navegador o reiniciar la aplicación es la forma fiable de reconstruir la conexión de datos desde cero." },
    { type: "heading",text: "Solución 2: cambie a un intervalo basado en tiempo" },
    { type: "paragraph",html: "Cuando necesita un gráfico funcional de inmediato, por ejemplo porque está en una operación y el gráfico de ticks se quedó en blanco, pase a un intervalo basado en tiempo y evite por completo la dependencia del número de ticks:" },
    {
      type: "steps",
      items: [
        { title: "Abra el selector de intervalo", html: "Abra el selector de intervalo o marco temporal del gráfico." },
        { title: "Elija una opción basada en tiempo", html: "Elija una opción basada en tiempo como <strong class='text-white'>1 min</strong> o <strong class='text-white'>5 min</strong> en lugar del tipo tick." },
        { title: "Deje que se llene", html: "El gráfico carga el historial de la manera estándar y se llena de inmediato." },
      ],
    },
    { type: "paragraph",html: "Cuando elige un intervalo de ticks, volumen, rango o segundos, Tradovate le pide la cantidad concreta para cada barra, por lo que, si más tarde vuelve a ticks, deberá introducir de nuevo su número de ticks allí." },
    { type: "heading",text: "Solución 3: pase al contrato activo del mes frontal" },
    { type: "paragraph",html: "Si el gráfico de ticks es escaso pero el mercado está claramente activo, probablemente está en el mes de contrato equivocado:" },
    {
      type: "steps",
      items: [
        { title: "Abra el selector de contrato", html: "Abra el selector de símbolo o contrato del instrumento." },
        { title: "Elija el mes frontal", html: "Elija el contrato del <strong class='text-white'>mes frontal</strong> (el más negociado) en lugar de un mes posterior o uno próximo al vencimiento." },
        { title: "Observe cómo se llenan las barras", html: "El mayor volumen de operaciones empieza a generar ticks y el gráfico se llena con normalidad." },
      ],
    },
    { type: "paragraph",html: "Esta es una trampa habitual en torno al vencimiento, cuando el volumen del contrato antiguo se agota y toma el relevo el nuevo. Si su plataforma indica que el volumen se ha desplazado a otro vencimiento, siga ese aviso hacia el contrato líquido." },
    { type: "heading",text: "Solución 4: amplíe su historial de ticks si necesita más de dos semanas" },
    { type: "paragraph",html: "Si su gráfico de ticks carga bien pero simplemente no permite retroceder lo suficiente, ha alcanzado la ventana predeterminada. El complemento Extended Tick Data History abre aproximadamente un año de historial de ticks:" },
    {
      type: "steps",
      items: [
        { title: "Abra Application Settings", html: "Inicie sesión en <strong class='text-white'>Tradovate Web</strong> y abra <strong class='text-white'>Application Settings</strong>." },
        { title: "Vaya a Add-ons", html: "Vaya a la sección <strong class='text-white'>Add-ons</strong>." },
        { title: "Suscríbase a Extended Tick Data History", html: "Busque <strong class='text-white'>Extended Tick Data History</strong> y confirme la suscripción (abarca simulación, real y reproducción de mercado)." },
      ],
    },
    { type: "paragraph",html: "Las etiquetas de los menús y los nombres de los complementos cambian entre versiones, así que confirme la redacción exacta en su configuración actual. Si solo necesita historial profundo de forma ocasional, un intervalo basado en tiempo es la alternativa gratuita." },
    { type: "heading",text: "Solución 5: confirme que su suscripción de datos de mercado está activa" },
    { type: "paragraph",html: "Si el nombre del símbolo está en naranja o el borde derecho no avanza, su flujo de datos está retrasado o apagado. Active o contrate los datos de mercado en tiempo real (los permisos varían según el tipo de cuenta y la firma de fondeo, así que consulte las reglas vigentes de su firma) y luego cierre sesión y vuelva a iniciarla para que se conecte el flujo en vivo." },
    { type: "heading",text: "Tabla de solución de problemas" },
    { type: "table", headers: ["Síntoma","Significado","Solución"], rows: [
      ["El gráfico de ticks muestra pocas barras, el mercado está tranquilo","No se han ejecutado suficientes operaciones para formar barras","Espere a que haya actividad o cambie a un intervalo basado en tiempo"],
      ["Gráfico de ticks escaso aunque el mercado está claramente activo","Está en un mes de contrato con poca negociación","Pase al contrato activo del mes frontal"],
      ["El gráfico de ticks se detiene y no añade barras nuevas","Flujo de datos atascado tras la congestión de inicios de sesión","Actualice la pestaña del navegador o reinicie la aplicación"],
      ["Las barras se detienen al retroceder unas 2 semanas","Alcanzó la ventana predeterminada del historial de ticks","Use un intervalo de tiempo o añada Extended Tick Data History"],
      ["Nombre del símbolo en naranja, borde derecho congelado","Datos de mercado en tiempo real retrasados o ausentes","Active o contrate datos en vivo y luego vuelva a iniciar sesión"],
      ["Necesita un gráfico funcional ahora mismo, en plena operación","La carga de ticks depende del flujo de operaciones","Cambie a 1 min o 5 min para seguir operando"],
    ] },
    { type: "heading",text: "Evite este problema con PickMyTrade" },
    { type: "paragraph",html: "Un gráfico de ticks que no se pinta es un problema de visualización, pero se convierte en un problema de <em>trading</em> en cuanto un gráfico en blanco oculta su entrada o duda ante un relleno que no ve trazado. PickMyTrade mantiene el gráfico fuera de la ruta crítica de ejecución:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Ejecución basada en alertas</strong>, las órdenes se disparan desde sus alertas de TradingView, no desde el renderizado del gráfico de Tradovate, por lo que un gráfico de ticks escaso o detenido nunca retrasa un relleno.",
        "<strong class='text-white'>Validación de cantidad y símbolo</strong>, cada orden se comprueba contra el contrato activo y sus límites de tamaño antes de enviarse, de modo que un gráfico mal interpretado no se convierte en una orden errónea.",
        "<strong class='text-white'>Enrutamiento seguro frente a límites de frecuencia</strong>, el flujo de órdenes se espacia para que nada rebote durante la misma congestión de inicios de sesión que detiene sus gráficos.",
        "<strong class='text-white'>Sincronización multicuenta</strong>, la orden correcta se replica en todas las cuentas vinculadas a la vez, sin reintroducirla manualmente mientras espera a que se formen las barras.",
      ],
    },
  ], fr: [
    { type: "paragraph",html: "Vous passez un graphique sur un intervalle de 1000 ticks et il se dessine à peine, trois ou quatre barres là où vous attendiez toute une séance de mouvement de prix. Le graphique en 5 minutes du même symbole se charge sans problème. C'est l'une des plaintes de graphique les plus déroutantes sur Tradovate, car rien ne semble cassé et pourtant le graphique en ticks ne s'affiche pas. La plupart du temps, la plateforme fonctionne exactement comme prévu ; les barres en ticks se comportent simplement différemment des barres temporelles, et une fois que vous savez pourquoi elles deviennent clairsemées, la solution tient généralement à un réglage ou à un contrat." },
    { type: "paragraph",html: "Le symptôme prend plusieurs formes : un graphique en ticks qui ne charge qu'une poignée de barres, un autre qui se fige et n'ajoute plus de bougies, un historique de ticks qui s'arrête quand vous remontez de quelques semaines, ou un graphique qui reste vide jusqu'à ce que vous le relanciez. Ils proviennent surtout de deux choses : la façon dont les barres en ticks sont construites et la quantité d'historique de ticks que votre compte peut récupérer, auxquelles s'ajoute parfois un flux bloqué qu'un simple rechargement règle." },
    { type: "paragraph",html: "Si vous lisez les graphiques en ticks à la main, un graphique qui ne s'affiche pas peut réellement vous coûter une configuration. Si vous automatisez, cela compte bien moins : les ordres peuvent partir de vos alertes TradingView, et non de ce que le graphique de Tradovate affiche, de sorte qu'un graphique en ticks clairsemé ne retarde jamais une exécution. Dans les deux cas, voici comment retrouver vos barres." },
    {
      type: "checklist",
      heading: "Liste de vérification rapide pour des barres en ticks qui ne se chargent pas",
      items: [
        "<strong class='text-white'>Rechargez le graphique</strong>, actualisez l'onglet du navigateur sur Tradovate Web, ou redémarrez l'application de bureau ou mobile, pour récupérer de nouveau le flux de ticks.",
        "<strong class='text-white'>Passez à un intervalle basé sur le temps</strong>, un graphique en 1 minute ou 5 minutes charge l'historique normalement et vous remet immédiatement en situation de trader.",
        "<strong class='text-white'>Choisissez le contrat actif (mois de front)</strong>, un mois éloigné peu échangé génère presque aucun tick, le graphique paraît donc vide.",
        "<strong class='text-white'>Tenez compte de la fenêtre de ticks de deux semaines</strong>, l'historique de ticks par défaut est d'environ deux semaines ; au-delà, les barres s'arrêtent.",
        "<strong class='text-white'>Ajoutez Extended Tick Data History</strong>, le module complémentaire étend l'historique de ticks jusqu'à environ un an si votre stratégie l'exige.",
        "<strong class='text-white'>Vérifiez les données de marché en direct</strong>, un abonnement différé ou absent (nom du symbole en orange) ne peut pas afficher les ticks actuels.",
      ],
    },
    { type: "heading",text: "Ce que signifie réellement « les barres en ticks ne se chargent pas »" },
    { type: "paragraph",html: "Un graphique en ticks ne mesure pas le temps, il compte les transactions. Une barre de 1000 ticks se clôture après 1 000 transactions exécutées, puis une nouvelle barre s'ouvre. Ce seul détail explique l'essentiel de ce qui ressemble à un échec de chargement. Quand le marché est calme, ou que le contrat sélectionné s'échange à peine, il n'y a tout simplement pas assez de ticks pour construire des barres, et le graphique affiche un maigre semis de bougies au lieu d'un écran rempli. Rien n'est bloqué ; les barres que vous attendez n'ont pas encore été échangées." },
    { type: "paragraph",html: "Comparez avec un graphique en 5 minutes, qui imprime une barre toutes les cinq minutes, que dix ou dix mille contrats aient été échangés. Les graphiques temporels ne peuvent pas paraître clairsemés ; le même marché lent qui laisse votre graphique en ticks presque vide remplit donc normalement un graphique temporel. C'est précisément pourquoi &ldquo;passez à un intervalle basé sur le temps&rdquo; est la solution de contournement la plus rapide : elle élimine complètement la dépendance au nombre de ticks." },
    { type: "paragraph",html: "L'autre moitié de l'histoire est la profondeur de l'historique. Tradovate charge environ deux semaines de données de ticks par défaut sur tous les graphiques basés sur les ticks. Remontez plus loin et le graphique cesse d'ajouter des barres, ce qui peut passer pour un échec de chargement alors qu'il s'agit d'une limite d'historique. Et par-dessus tout, un flux bloqué ordinaire, du genre qui survient après la ruée de connexions à l'ouverture, peut laisser n'importe quel graphique, en ticks ou temporel, momentanément vide jusqu'à ce qu'un rechargement rétablisse la connexion de données." },
    { type: "heading",text: "Principales causes de barres en ticks qui ne se chargent pas" },
    { type: "heading",text: "1. Les barres en ticks ne se forment que lorsque des transactions sont exécutées" },
    { type: "paragraph",html: "C'est le point majeur. Un graphique en ticks ajoute une barre chaque fois que son nombre de transactions est atteint ; la création de barres est donc directement liée à l'activité. La nuit, pendant la pause déjeuner ou sur un produit à faible volume, moins de transactions signifient moins de barres, parfois une poignée seulement sur toute une séance. Le graphique n'échoue pas à charger ; le marché n'a simplement pas encore généré les ticks." },
    { type: "heading",text: "2. Vous êtes sur un mois de contrat peu échangé" },
    { type: "paragraph",html: "Le volume des contrats à terme se concentre sur un contrat à la fois, généralement le mois de front. Choisissez un mois éloigné ou une échéance à peine échangée et il peut n'imprimer qu'un filet de ticks, ce qui donne un graphique en ticks presque vide même en pleine séance active. Passer au contrat activement échangé suffit souvent à tout régler." },
    { type: "heading",text: "3. Vous avez dépassé la fenêtre de ticks de deux semaines" },
    { type: "paragraph",html: "L'historique de ticks par défaut couvre environ deux semaines. Faites reculer le graphique assez loin et il se heurte à ce mur et cesse de charger des barres plus anciennes. Pour un graphique en ticks, c'est un comportement attendu, pas un bogue ; un historique de ticks plus profond exige le module complémentaire de données étendues, ou l'usage d'un intervalle basé sur le temps pour un recul plus long." },
    { type: "heading",text: "4. Un flux de données bloqué ou congestionné" },
    { type: "paragraph",html: "À l'ouverture du marché au comptant, toutes les plateformes sollicitent les serveurs de données en même temps. Des graphiques qui se chargent bien en milieu de séance peuvent ramer ou rester vides pendant la première minute ou les deux premières après la connexion. Un graphique en ticks pris dans cette fenêtre paraît particulièrement vide, car il attend à la fois le flux et suffisamment de transactions pour construire des barres." },
    { type: "heading",text: "5. Abonnement aux données de marché différé ou absent" },
    { type: "paragraph",html: "Si le nom du symbole s'affiche en orange, vous êtes en données différées ou sans données en direct. Un flux qui ne diffuse pas en temps réel ne peut pas fournir les transactions actuelles dont un graphique en ticks a besoin, de sorte que les barres se figent au bord droit. Les droits de données varient selon le type de compte et la société de prop trading ; vérifiez donc les règles actuelles de votre société." },
    { type: "heading",text: "Comment corriger des barres en ticks qui ne se chargent pas : pas à pas" },
    { type: "heading",text: "Solution 1 : rechargez le graphique pour récupérer de nouveau le flux de ticks" },
    { type: "paragraph",html: "Commencez ici dès que le graphique semble bloqué plutôt que simplement calme :" },
    {
      type: "steps",
      items: [
        { title: "Actualiser sur Tradovate Web", html: "Sur <strong class='text-white'>Tradovate Web</strong>, actualisez l'onglet du navigateur (F5 / Ctrl+R) pour vous reconnecter et redemander les données de ticks." },
        { title: "Redémarrer l'application de bureau", html: "Sur l'<strong class='text-white'>application de bureau</strong>, fermez-la puis rouvrez-la, et reconnectez-vous." },
        { title: "Forcer la fermeture sur mobile", html: "Sur <strong class='text-white'>mobile</strong>, forcez la fermeture de l'application puis relancez-la." },
      ],
    },
    { type: "paragraph",html: "Il n'existe pas de bouton dédié en un clic &ldquo;actualiser ce graphique&rdquo;, donc une actualisation du navigateur ou un redémarrage de l'application est le moyen fiable de reconstruire la connexion de données à partir de zéro." },
    { type: "heading",text: "Solution 2 : passez à un intervalle basé sur le temps" },
    { type: "paragraph",html: "Quand il vous faut un graphique fonctionnel tout de suite, par exemple parce que vous êtes en position et que le graphique en ticks est devenu vide, passez à un intervalle basé sur le temps et supprimez complètement la dépendance au nombre de ticks :" },
    {
      type: "steps",
      items: [
        { title: "Ouvrir le sélecteur d'intervalle", html: "Ouvrez le sélecteur d'intervalle ou d'unité de temps du graphique." },
        { title: "Choisir une option basée sur le temps", html: "Choisissez une option basée sur le temps comme <strong class='text-white'>1 min</strong> ou <strong class='text-white'>5 min</strong> au lieu du type tick." },
        { title: "Laisser le graphique se remplir", html: "Le graphique charge l'historique de manière standard et se remplit immédiatement." },
      ],
    },
    { type: "paragraph",html: "Lorsque vous choisissez un intervalle en ticks, en volume, en range ou en secondes, Tradovate vous demande la valeur précise de chaque barre ; si vous revenez plus tard aux ticks, vous devrez donc y saisir de nouveau votre nombre de ticks." },
    { type: "heading",text: "Solution 3 : passez au contrat actif du mois de front" },
    { type: "paragraph",html: "Si le graphique en ticks est clairsemé alors que le marché est clairement actif, vous êtes probablement sur le mauvais mois de contrat :" },
    {
      type: "steps",
      items: [
        { title: "Ouvrir le sélecteur de contrat", html: "Ouvrez le sélecteur de symbole ou de contrat de l'instrument." },
        { title: "Choisir le mois de front", html: "Choisissez le contrat du <strong class='text-white'>mois de front</strong> (activement échangé) plutôt qu'un mois éloigné ou proche de l'expiration." },
        { title: "Regarder les barres se remplir", html: "Le volume de transactions plus élevé commence à générer des ticks et le graphique se remplit normalement." },
      ],
    },
    { type: "paragraph",html: "C'est un piège courant au moment du roulement, lorsque le volume de l'ancien contrat s'assèche et que le nouveau prend le relais. Si votre plateforme signale que le volume s'est déplacé vers une autre échéance, suivez-la vers le contrat liquide." },
    { type: "heading",text: "Solution 4 : étendez votre historique de ticks si vous avez besoin de plus de deux semaines" },
    { type: "paragraph",html: "Si votre graphique en ticks se charge bien mais ne permet tout simplement pas de remonter assez loin, vous avez atteint la fenêtre par défaut. Le module complémentaire Extended Tick Data History ouvre environ un an d'historique de ticks :" },
    {
      type: "steps",
      items: [
        { title: "Ouvrir Application Settings", html: "Connectez-vous à <strong class='text-white'>Tradovate Web</strong> et ouvrez <strong class='text-white'>Application Settings</strong>." },
        { title: "Aller à Add-ons", html: "Allez à la section <strong class='text-white'>Add-ons</strong>." },
        { title: "Souscrire à Extended Tick Data History", html: "Trouvez <strong class='text-white'>Extended Tick Data History</strong> et confirmez l'abonnement (il couvre la simulation, le réel et le market replay)." },
      ],
    },
    { type: "paragraph",html: "Les libellés de menu et les noms des modules complémentaires changent d'une version à l'autre ; confirmez donc la formulation exacte dans vos paramètres actuels. Si vous n'avez besoin d'un historique profond qu'occasionnellement, un intervalle basé sur le temps est l'alternative gratuite." },
    { type: "heading",text: "Solution 5 : vérifiez que votre abonnement aux données de marché est actif" },
    { type: "paragraph",html: "Si le nom du symbole est orange ou si le bord droit n'avance pas, votre flux est différé ou coupé. Activez ou souscrivez les données de marché en temps réel (les droits varient selon le type de compte et la société de prop trading, vérifiez donc les règles actuelles de votre société), puis déconnectez-vous et reconnectez-vous pour que le flux en direct se rattache." },
    { type: "heading",text: "Tableau de dépannage" },
    { type: "table", headers: ["Symptôme","Signification","Solution"], rows: [
      ["Le graphique en ticks n'affiche que quelques barres, le marché est calme","Pas assez de transactions ont été exécutées pour construire des barres","Attendez de l'activité ou passez à un intervalle basé sur le temps"],
      ["Graphique en ticks clairsemé alors que le marché est clairement actif","Vous êtes sur un mois de contrat peu échangé","Passez au contrat actif du mois de front"],
      ["Le graphique en ticks se fige et n'ajoute pas de nouvelles barres","Flux de données bloqué après la congestion des connexions","Actualisez l'onglet du navigateur ou redémarrez l'application"],
      ["Les barres s'arrêtent en remontant d'environ 2 semaines","Fenêtre d'historique de ticks par défaut atteinte","Utilisez un intervalle temporel ou ajoutez Extended Tick Data History"],
      ["Nom du symbole en orange, bord droit figé","Données de marché en temps réel différées ou absentes","Activez / souscrivez les données en direct, puis reconnectez-vous"],
      ["Il vous faut un graphique fonctionnel tout de suite, en pleine position","Le chargement des ticks dépend du flux de transactions","Passez à 1 min ou 5 min pour continuer à trader"],
    ] },
    { type: "heading",text: "Évitez ce problème avec PickMyTrade" },
    { type: "paragraph",html: "Un graphique en ticks qui ne s'affiche pas est un problème d'affichage, mais il devient un problème de <em>trading</em> dès qu'un graphique vide masque votre entrée ou que vous hésitez devant une exécution que vous ne voyez pas tracée. PickMyTrade garde le graphique hors du chemin critique de l'exécution :" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Exécution pilotée par les alertes</strong>, les ordres partent de vos alertes TradingView, pas du rendu du graphique de Tradovate, de sorte qu'un graphique en ticks clairsemé ou bloqué ne retarde jamais une exécution.",
        "<strong class='text-white'>Validation de la quantité et du symbole</strong>, chaque ordre est vérifié par rapport au contrat actif et à vos plafonds de taille avant l'envoi, de sorte qu'un graphique mal lu ne devienne pas un mauvais ordre.",
        "<strong class='text-white'>Routage respectueux des limites de débit</strong>, le flux d'ordres est espacé pour que rien ne soit rejeté pendant la même congestion de connexions qui bloque vos graphiques.",
        "<strong class='text-white'>Synchronisation multi-comptes</strong>, l'ordre correct est répliqué sur tous les comptes liés à la fois, sans ressaisie manuelle pendant que vous attendez que les barres se construisent.",
      ],
    },
  ], it: [
    { type: "paragraph",html: "Imposta un grafico su un intervallo di 1000 tick e si disegna appena, tre o quattro barre dove si aspettava un'intera sessione di movimento di prezzo. Il grafico a 5 minuti sullo stesso simbolo si carica senza problemi. È una delle lamentele sui grafici più sconcertanti su Tradovate, perché nulla sembra rotto eppure il grafico a tick non si disegna. Nella maggior parte dei casi la piattaforma funziona esattamente come progettato; le barre a tick si comportano semplicemente in modo diverso dalle barre temporali e, una volta capito perché diventano scarne, la soluzione di solito è un'impostazione o un contratto." },
    { type: "paragraph",html: "Il sintomo si presenta in diverse forme: un grafico a tick che carica solo una manciata di barre, uno che si blocca e non aggiunge nuove candele, uno storico tick che si interrompe tornando indietro di un paio di settimane, oppure un grafico che resta vuoto finché non lo sollecita. Per lo più dipendono da due cose: come sono costruite le barre a tick e quanto storico tick può recuperare il suo conto, più un occasionale feed bloccato che un semplice ricaricamento risolve." },
    { type: "paragraph",html: "Se legge i grafici a tick a mano, uno che non si disegna può costarle davvero un setup. Se automatizza, conta molto meno: gli ordini possono partire dai suoi alert di TradingView, non da ciò che il grafico di Tradovate sta renderizzando, quindi un grafico a tick scarno non ritarda mai un'esecuzione. In ogni caso, ecco come recuperare le barre." },
    {
      type: "checklist",
      heading: "Checklist rapida per barre a tick che non si caricano",
      items: [
        "<strong class='text-white'>Ricarichi il grafico</strong>, aggiorni la scheda del browser su Tradovate Web, oppure riavvii l'app desktop o mobile, per recuperare di nuovo il feed dei tick.",
        "<strong class='text-white'>Passi a un intervallo basato sul tempo</strong>, un grafico a 1 minuto o 5 minuti carica lo storico normalmente e la rimette subito in condizione di operare.",
        "<strong class='text-white'>Scelga il contratto attivo (mese frontale)</strong>, un mese più lontano poco scambiato stampa quasi nessun tick, quindi il grafico appare vuoto.",
        "<strong class='text-white'>Tenga conto della finestra tick di due settimane</strong>, lo storico tick predefinito è di circa due settimane; oltre, le barre si fermano.",
        "<strong class='text-white'>Aggiunga Extended Tick Data History</strong>, il componente aggiuntivo estende lo storico tick fino a circa un anno se la sua strategia lo richiede.",
        "<strong class='text-white'>Confermi i dati di mercato live</strong>, un abbonamento ritardato o assente (nome del simbolo in arancione) non può disegnare i tick correnti.",
      ],
    },
    { type: "heading",text: "Cosa significa davvero «le barre a tick non si caricano»" },
    { type: "paragraph",html: "Un grafico a tick non misura il tempo, conta le operazioni. Una barra da 1000 tick si chiude dopo l'esecuzione di 1.000 operazioni, poi se ne apre una nuova. Questo solo dettaglio spiega la maggior parte di ciò che sembra un errore di caricamento. Quando il mercato è tranquillo, o il contratto selezionato viene scambiato a malapena, semplicemente non ci sono abbastanza tick per costruire le barre, quindi il grafico mostra una rada dispersione di candele invece di uno schermo pieno. Nulla è bloccato; le barre che attende non sono ancora state scambiate." },
    { type: "paragraph",html: "Lo confronti con un grafico a 5 minuti, che stampa una barra ogni cinque minuti sia che siano stati scambiati dieci contratti o diecimila. I grafici temporali non possono apparire scarni, quindi lo stesso mercato lento che lascia quasi vuoto il suo grafico a tick riempie normalmente un grafico temporale. Ecco perché &ldquo;passi a un intervallo basato sul tempo&rdquo; è la soluzione più rapida: aggira del tutto la dipendenza dal numero di tick." },
    { type: "paragraph",html: "L'altra metà della storia è la profondità dello storico. Tradovate carica per impostazione predefinita circa due settimane di dati tick su tutti i grafici basati sui tick. Se torna indietro oltre, il grafico smette di aggiungere barre, il che può sembrare un errore di caricamento quando in realtà è un limite di storico. E oltre a entrambi, un comune feed bloccato, del tipo che si verifica dopo la ressa di accessi all'apertura, può lasciare qualsiasi grafico, a tick o temporale, temporaneamente vuoto finché un ricaricamento non ristabilisce la connessione dati." },
    { type: "heading",text: "Principali cause delle barre a tick che non si caricano" },
    { type: "heading",text: "1. Le barre a tick si formano solo quando vengono eseguite operazioni" },
    { type: "paragraph",html: "Questo è il punto principale. Un grafico a tick aggiunge una barra ogni volta che raggiunge il proprio numero di operazioni, quindi la creazione delle barre è legata direttamente all'attività. Di notte, durante la pausa pranzo o su un prodotto a basso volume, meno operazioni significano meno barre, a volte solo una manciata in un'intera sessione. Il grafico non fallisce nel caricarsi; il mercato non ha ancora generato i tick." },
    { type: "heading",text: "2. Si trova su un mese di contratto poco scambiato" },
    { type: "paragraph",html: "Il volume dei futures si concentra su un contratto alla volta, di solito il mese frontale. Se sceglie un mese più lontano o una scadenza a malapena scambiata, può stampare solo un filo di tick, il che produce un grafico a tick quasi vuoto anche nel pieno di una sessione attiva. Passare al contratto attivamente scambiato è spesso l'intera soluzione." },
    { type: "heading",text: "3. Ha superato la finestra tick di due settimane" },
    { type: "paragraph",html: "Lo storico tick predefinito copre circa due settimane. Trascini il grafico abbastanza indietro e arriva a quel limite e smette di caricare barre più vecchie. Per un grafico a tick è un comportamento previsto, non un bug; uno storico tick più profondo richiede il componente aggiuntivo di dati estesi, oppure si usa un intervallo basato sul tempo per un'analisi retrospettiva più lunga." },
    { type: "heading",text: "4. Un feed di dati bloccato o congestionato" },
    { type: "paragraph",html: "All'apertura del mercato cash, ogni piattaforma sollecita contemporaneamente i server dei dati. I grafici che si caricano bene a metà sessione possono rallentare o restare vuoti nel primo minuto o due dopo l'accesso. Un grafico a tick colto in quella finestra appare particolarmente vuoto perché attende sia il feed sia un numero sufficiente di operazioni per costruire le barre." },
    { type: "heading",text: "5. Abbonamento ai dati di mercato ritardato o assente" },
    { type: "paragraph",html: "Se il nome del simbolo appare in arancione, ha dati ritardati o nessun dato live. Un feed che non trasmette in tempo reale non può fornire le stampe di operazioni correnti di cui un grafico a tick ha bisogno, quindi le barre si fermano al bordo destro. Le autorizzazioni sui dati variano in base al tipo di conto e alla prop firm, quindi verifichi le regole attuali della sua società." },
    { type: "heading",text: "Come risolvere le barre a tick che non si caricano: passo dopo passo" },
    { type: "heading",text: "Soluzione 1: ricarichi il grafico per recuperare di nuovo il feed dei tick" },
    { type: "paragraph",html: "Parta da qui ogni volta che il grafico sembra bloccato anziché solo tranquillo:" },
    {
      type: "steps",
      items: [
        { title: "Aggiornare su Tradovate Web", html: "Su <strong class='text-white'>Tradovate Web</strong>, aggiorni la scheda del browser (F5 / Ctrl+R) per riconnettersi e richiedere di nuovo i dati tick." },
        { title: "Riavviare l'app desktop", html: "Sull'<strong class='text-white'>app desktop</strong>, la chiuda e la riapra, poi acceda di nuovo." },
        { title: "Forzare la chiusura su mobile", html: "Su <strong class='text-white'>mobile</strong>, forzi la chiusura dell'app e la riavvii." },
      ],
    },
    { type: "paragraph",html: "Non esiste un pulsante dedicato a un clic &ldquo;aggiorna questo grafico&rdquo;, quindi un aggiornamento del browser o il riavvio dell'app è il modo affidabile per ricostruire da zero la connessione dati." },
    { type: "heading",text: "Soluzione 2: passi a un intervallo basato sul tempo" },
    { type: "paragraph",html: "Quando ha bisogno subito di un grafico funzionante, per esempio perché è in un trade e il grafico a tick è diventato vuoto, passi a un intervallo basato sul tempo ed elimini del tutto la dipendenza dal numero di tick:" },
    {
      type: "steps",
      items: [
        { title: "Aprire il selettore dell'intervallo", html: "Apra il selettore dell'intervallo o del timeframe del grafico." },
        { title: "Scegliere un'opzione basata sul tempo", html: "Scelga un'opzione basata sul tempo come <strong class='text-white'>1 min</strong> o <strong class='text-white'>5 min</strong> invece del tipo tick." },
        { title: "Lasciare che si riempia", html: "Il grafico carica lo storico nel modo standard e si riempie subito." },
      ],
    },
    { type: "paragraph",html: "Quando sceglie un intervallo a tick, volume, range o secondi, Tradovate le chiede la quantità specifica per ogni barra, quindi se in seguito tornerà ai tick dovrà reinserire lì il numero di tick." },
    { type: "heading",text: "Soluzione 3: passi al contratto attivo del mese frontale" },
    { type: "paragraph",html: "Se il grafico a tick è scarno ma il mercato è chiaramente attivo, probabilmente si trova sul mese di contratto sbagliato:" },
    {
      type: "steps",
      items: [
        { title: "Aprire il selettore del contratto", html: "Apra il selettore del simbolo o del contratto per lo strumento." },
        { title: "Scegliere il mese frontale", html: "Scelga il contratto del <strong class='text-white'>mese frontale</strong> (attivamente scambiato) anziché un mese più lontano o prossimo alla scadenza." },
        { title: "Osservare le barre popolarsi", html: "Il maggiore volume di operazioni inizia a generare tick e il grafico si popola normalmente." },
      ],
    },
    { type: "paragraph",html: "È una trappola comune attorno al rollover, quando il volume del vecchio contratto si esaurisce e subentra quello nuovo. Se la sua piattaforma segnala che il volume si è spostato su un'altra scadenza, la segua verso il contratto liquido." },
    { type: "heading",text: "Soluzione 4: estenda lo storico tick se le servono più di due settimane" },
    { type: "paragraph",html: "Se il suo grafico a tick si carica bene ma non permette di tornare indietro abbastanza, ha raggiunto la finestra predefinita. Il componente aggiuntivo Extended Tick Data History apre circa un anno di storico tick:" },
    {
      type: "steps",
      items: [
        { title: "Aprire Application Settings", html: "Acceda a <strong class='text-white'>Tradovate Web</strong> e apra <strong class='text-white'>Application Settings</strong>." },
        { title: "Andare su Add-ons", html: "Vada alla sezione <strong class='text-white'>Add-ons</strong>." },
        { title: "Sottoscrivere Extended Tick Data History", html: "Trovi <strong class='text-white'>Extended Tick Data History</strong> e confermi la sottoscrizione (copre simulazione, live e market replay)." },
      ],
    },
    { type: "paragraph",html: "Le etichette dei menu e i nomi dei componenti aggiuntivi cambiano tra le versioni, quindi confermi la dicitura esatta nelle sue impostazioni attuali. Se le serve solo occasionalmente uno storico profondo, un intervallo basato sul tempo è l'alternativa gratuita." },
    { type: "heading",text: "Soluzione 5: confermi che l'abbonamento ai dati di mercato sia attivo" },
    { type: "paragraph",html: "Se il nome del simbolo è arancione o il bordo destro non avanza, il suo feed è ritardato o spento. Attivi o sottoscriva i dati di mercato in tempo reale (le autorizzazioni variano in base al tipo di conto e alla prop firm, quindi verifichi le regole attuali della sua società), poi esca e riaccede affinché il feed live si colleghi." },
    { type: "heading",text: "Tabella di risoluzione dei problemi" },
    { type: "table", headers: ["Sintomo","Significato","Soluzione"], rows: [
      ["Il grafico a tick mostra solo poche barre, il mercato è tranquillo","Non sono state eseguite abbastanza operazioni per costruire le barre","Attenda l'attività o passi a un intervallo basato sul tempo"],
      ["Grafico a tick scarno mentre il mercato è chiaramente attivo","Si trova su un mese di contratto poco scambiato","Passi al contratto attivo del mese frontale"],
      ["Il grafico a tick si blocca e non aggiunge nuove barre","Feed di dati bloccato dopo la congestione degli accessi","Aggiorni la scheda del browser o riavvii l'app"],
      ["Le barre si fermano tornando indietro di circa 2 settimane","Raggiunta la finestra predefinita dello storico tick","Usi un intervallo temporale o aggiunga Extended Tick Data History"],
      ["Nome del simbolo in arancione, bordo destro congelato","Dati di mercato in tempo reale ritardati o assenti","Attivi / sottoscriva i dati live, poi riaccede"],
      ["Le serve subito un grafico funzionante, in pieno trade","Il caricamento dei tick dipende dal flusso di operazioni","Passi a 1 min o 5 min per continuare a operare"],
    ] },
    { type: "heading",text: "Eviti questo problema con PickMyTrade" },
    { type: "paragraph",html: "Un grafico a tick che non si disegna è un problema di visualizzazione, ma diventa un problema di <em>trading</em> nel momento in cui un grafico vuoto nasconde il suo ingresso o esita su un'esecuzione che non vede tracciata. PickMyTrade tiene il grafico fuori dal percorso critico dell'esecuzione:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Esecuzione guidata dagli alert</strong>, gli ordini partono dai suoi alert di TradingView, non dal rendering del grafico di Tradovate, quindi un grafico a tick scarno o bloccato non ritarda mai un'esecuzione.",
        "<strong class='text-white'>Validazione di quantità e simbolo</strong>, ogni ordine viene verificato rispetto al contratto attivo e ai suoi limiti di dimensione prima dell'invio, così un grafico letto male non diventa un ordine errato.",
        "<strong class='text-white'>Instradamento sicuro rispetto ai limiti di frequenza</strong>, il flusso di ordini viene distanziato in modo che nulla venga respinto durante la stessa congestione di accessi che blocca i suoi grafici.",
        "<strong class='text-white'>Sincronizzazione multi-account</strong>, l'ordine corretto viene replicato su tutti i conti collegati contemporaneamente, senza reinserimento manuale mentre attende che le barre si formino.",
      ],
    },
  ] },
  ctaHeading: { en: "Trade Straight From Your Strategy", de: "Handeln Sie direkt aus Ihrer Strategie", es: "Opere directamente desde su estrategia", fr: "Tradez directement depuis votre stratégie", it: "Operi direttamente dalla sua strategia" },
  ctaText: { en: "Start your free 7-day trial, link your alerts today and trade straight from your strategy, no matter what the chart is doing.", de: "Starten Sie Ihre kostenlose 7-Tage-Testphase, verknüpfen Sie noch heute Ihre Alerts und handeln Sie direkt aus Ihrer Strategie, ganz gleich, was der Chart gerade tut.", es: "Comience su prueba gratuita de 7 días, vincule sus alertas hoy mismo y opere directamente desde su estrategia, sin importar lo que haga el gráfico.", fr: "Commencez votre essai gratuit de 7 jours, reliez vos alertes dès aujourd'hui et tradez directement depuis votre stratégie, quoi que fasse le graphique.", it: "Inizi la prova gratuita di 7 giorni, colleghi i suoi alert oggi stesso e operi direttamente dalla sua strategia, qualunque cosa faccia il grafico." },
  ctaButtonText: { en: "Start Your Free 7-Day Trial", de: "Starten Sie Ihre kostenlose 7-Tage-Testphase", es: "Comience su prueba gratuita de 7 días", fr: "Commencez votre essai gratuit de 7 jours", it: "Inizi la prova gratuita di 7 giorni" },
  ctaUrl: "https://app.pickmytrade.trade/?register=true&utm_source=content&utm_medium=debugging",
  faqHeading: { en: "Frequently Asked Questions", de: "Häufig gestellte Fragen", es: "Preguntas frecuentes", fr: "Questions fréquentes", it: "Domande frequenti" },
  faqs: { en: [
    { q: "Why won't my Tradovate tick chart load bars?", a: "Tick bars form only when actual trades print, not on a fixed clock. On a thinly traded contract or during a quiet session, few trades means few bars, so the chart looks nearly empty. Switch to the active front-month contract, or drop to a time-based interval, and the bars fill in normally." },
    { q: "How do I fix a tick chart that's stuck or shows only a few bars?", a: "Reload the data feed first: refresh the browser tab on Tradovate Web, or close and reopen the desktop or mobile app. If the contract is thinly traded, switch to the front month. As a quick workaround that always gets you a working chart, switch to a time-based interval like 1-minute or 5-minute." },
    { q: "How far back does Tradovate tick data go?", a: "By default, tick and tick-based charts load about two weeks of history. An optional Extended Tick Data History add-on stretches that to roughly a year across simulation, live, and market replay. Pricing and availability change over time, so confirm the current terms in your Application Settings before you buy." },
    { q: "Why does my tick chart look sparse next to a 5-minute chart?", a: "A time-based chart prints a bar every interval no matter what. A tick chart only closes a bar once its trade count is reached, so during slow periods you naturally get fewer, sparser bars. That's how tick charts are built, it isn't a platform fault." },
    { q: "Does switching to a time-based timeframe fix tick bars not loading?", a: "It's the fastest way to get a working chart while you sort out the tick feed. A time-based interval loads history the standard way, so bars appear immediately. It doesn't repair the underlying tick issue, but it keeps you reading price and placing orders without waiting." },
    { q: "Why did my tick chart stop loading when I scrolled back?", a: "You likely hit the two-week tick-history window. Scroll past it and the chart simply stops adding older bars. For deeper history, use a time-based interval or enable the Extended Tick Data History add-on." },
    { q: "Do tick bars need a live market-data subscription?", a: "Yes. If your symbol name shows in orange or you're on delayed or no data, current ticks won't stream and the chart stalls at the right edge. Enable or subscribe to real-time market data, then sign out and back in so the live feed attaches." },
    { q: "If my tick chart fails, will my automated orders still fire?", a: "Yes. If you automate through PickMyTrade, orders route from your TradingView alerts, not from Tradovate's chart render. A sparse or stalled tick chart never blocks or delays an automated fill." },
  ], de: [
    { q: "Warum lädt mein Tradovate-Tick-Chart keine Balken?", a: "Tick-Balken entstehen nur, wenn tatsächlich Trades ausgeführt werden, nicht nach einem festen Zeittakt. Bei einem dünn gehandelten Kontrakt oder in einer ruhigen Sitzung bedeuten wenige Trades wenige Balken, sodass der Chart fast leer aussieht. Wechseln Sie zum aktiven Front-Month-Kontrakt oder auf ein zeitbasiertes Intervall, dann füllen sich die Balken wie gewohnt." },
    { q: "Wie behebe ich einen hängenden Tick-Chart oder einen Chart mit nur wenigen Balken?", a: "Laden Sie zuerst den Datenfeed neu: Aktualisieren Sie den Browser-Tab in Tradovate Web oder schließen und öffnen Sie die Desktop- bzw. Mobile-App erneut. Ist der Kontrakt dünn gehandelt, wechseln Sie zum Front-Month. Als schnelle Übergangslösung, die immer einen funktionierenden Chart liefert, wechseln Sie auf ein zeitbasiertes Intervall wie 1 Minute oder 5 Minuten." },
    { q: "Wie weit reichen die Tradovate-Tickdaten zurück?", a: "Standardmäßig laden Tick- und tickbasierte Charts etwa zwei Wochen Historie. Ein optionales Add-on „Extended Tick Data History“ erweitert diese auf rund ein Jahr für Simulation, Live-Handel und Market Replay. Preise und Verfügbarkeit ändern sich im Lauf der Zeit; prüfen Sie daher vor dem Kauf die aktuellen Konditionen in Ihren Application Settings." },
    { q: "Warum wirkt mein Tick-Chart im Vergleich zu einem 5-Minuten-Chart so dünn besetzt?", a: "Ein zeitbasierter Chart erzeugt in jedem Intervall einen Balken, egal was passiert. Ein Tick-Chart schließt einen Balken erst, wenn die festgelegte Anzahl an Trades erreicht ist; in ruhigen Phasen entstehen daher naturgemäß weniger und weiter auseinanderliegende Balken. So sind Tick-Charts aufgebaut, es ist kein Fehler der Plattform." },
    { q: "Behebt der Wechsel auf einen zeitbasierten Zeitrahmen das Problem mit nicht ladenden Tick-Balken?", a: "Es ist der schnellste Weg zu einem funktionierenden Chart, während Sie den Tick-Feed klären. Ein zeitbasiertes Intervall lädt die Historie auf Standardweise, sodass sofort Balken erscheinen. Das Tick-Problem selbst wird dadurch nicht behoben, aber Sie können weiter den Kurs lesen und Orders platzieren, ohne warten zu müssen." },
    { q: "Warum hat mein Tick-Chart beim Zurückscrollen aufgehört zu laden?", a: "Wahrscheinlich haben Sie das Zwei-Wochen-Fenster der Tick-Historie erreicht. Scrollen Sie darüber hinaus, fügt der Chart einfach keine älteren Balken mehr hinzu. Für eine tiefere Historie nutzen Sie ein zeitbasiertes Intervall oder aktivieren das Add-on „Extended Tick Data History“." },
    { q: "Benötigen Tick-Balken ein Live-Marktdaten-Abonnement?", a: "Ja. Wenn Ihr Symbolname orange angezeigt wird oder Sie verzögerte bzw. keine Daten erhalten, werden aktuelle Ticks nicht gestreamt und der Chart bleibt am rechten Rand stehen. Aktivieren oder abonnieren Sie Echtzeit-Marktdaten und melden Sie sich anschließend ab und wieder an, damit der Live-Feed greift." },
    { q: "Werden meine automatisierten Orders trotzdem ausgeführt, wenn mein Tick-Chart ausfällt?", a: "Ja. Wenn Sie über PickMyTrade automatisieren, werden Orders aus Ihren TradingView-Alerts geroutet, nicht aus der Chart-Darstellung von Tradovate. Ein spärlicher oder hängender Tick-Chart blockiert oder verzögert eine automatisierte Ausführung niemals." },
  ], es: [
    { q: "¿Por qué mi gráfico de ticks de Tradovate no carga barras?", a: "Las barras de ticks solo se forman cuando se ejecutan operaciones reales, no según un reloj fijo. En un contrato con poca negociación o durante una sesión tranquila, pocas operaciones significan pocas barras, por lo que el gráfico parece casi vacío. Cambie al contrato activo del mes frontal o pase a un intervalo basado en tiempo y las barras se llenarán con normalidad." },
    { q: "¿Cómo soluciono un gráfico de ticks que se queda atascado o muestra pocas barras?", a: "Primero recargue el flujo de datos: actualice la pestaña del navegador en Tradovate Web, o cierre y vuelva a abrir la aplicación de escritorio o móvil. Si el contrato tiene poca negociación, cambie al mes frontal. Como solución rápida que siempre le da un gráfico funcional, cambie a un intervalo basado en tiempo, como 1 minuto o 5 minutos." },
    { q: "¿Hasta cuándo atrás llegan los datos de ticks de Tradovate?", a: "De forma predeterminada, los gráficos de ticks y los basados en ticks cargan aproximadamente dos semanas de historial. Un complemento opcional, Extended Tick Data History, lo amplía a cerca de un año en simulación, real y reproducción de mercado. Los precios y la disponibilidad cambian con el tiempo, así que confirme las condiciones actuales en sus Application Settings antes de comprar." },
    { q: "¿Por qué mi gráfico de ticks se ve escaso al compararlo con uno de 5 minutos?", a: "Un gráfico basado en tiempo imprime una barra en cada intervalo pase lo que pase. Un gráfico de ticks solo cierra una barra cuando se alcanza su número de operaciones, por lo que en periodos lentos obtiene naturalmente menos barras y más espaciadas. Así están construidos los gráficos de ticks; no es un fallo de la plataforma." },
    { q: "¿Cambiar a un marco temporal basado en tiempo soluciona que las barras de ticks no carguen?", a: "Es la forma más rápida de obtener un gráfico funcional mientras resuelve el flujo de ticks. Un intervalo basado en tiempo carga el historial de la manera estándar, por lo que las barras aparecen de inmediato. No repara el problema de fondo de los ticks, pero le permite seguir leyendo el precio y colocando órdenes sin esperar." },
    { q: "¿Por qué mi gráfico de ticks dejó de cargar al desplazarme hacia atrás?", a: "Probablemente alcanzó la ventana de dos semanas del historial de ticks. Al pasarla, el gráfico simplemente deja de añadir barras más antiguas. Para un historial más profundo, use un intervalo basado en tiempo o active el complemento Extended Tick Data History." },
    { q: "¿Las barras de ticks necesitan una suscripción de datos de mercado en vivo?", a: "Sí. Si el nombre de su símbolo aparece en naranja o tiene datos retrasados o sin datos, los ticks actuales no se transmiten y el gráfico se detiene en el borde derecho. Active o contrate los datos de mercado en tiempo real y luego cierre sesión y vuelva a iniciarla para que se conecte el flujo en vivo." },
    { q: "Si mi gráfico de ticks falla, ¿se seguirán ejecutando mis órdenes automatizadas?", a: "Sí. Si automatiza con PickMyTrade, las órdenes se enrutan desde sus alertas de TradingView, no desde el renderizado del gráfico de Tradovate. Un gráfico de ticks escaso o detenido nunca bloquea ni retrasa una ejecución automatizada." },
  ], fr: [
    { q: "Pourquoi mon graphique en ticks Tradovate ne charge-t-il pas les barres ?", a: "Les barres en ticks ne se forment que lorsque de véritables transactions sont exécutées, pas selon une horloge fixe. Sur un contrat peu échangé ou pendant une séance calme, peu de transactions signifient peu de barres, et le graphique paraît presque vide. Passez au contrat actif du mois de front ou à un intervalle basé sur le temps, et les barres se remplissent normalement." },
    { q: "Comment réparer un graphique en ticks bloqué ou qui n'affiche que quelques barres ?", a: "Rechargez d'abord le flux de données : actualisez l'onglet du navigateur sur Tradovate Web, ou fermez puis rouvrez l'application de bureau ou mobile. Si le contrat est peu échangé, passez au mois de front. Pour une solution rapide qui vous donne toujours un graphique fonctionnel, passez à un intervalle basé sur le temps comme 1 minute ou 5 minutes." },
    { q: "Jusqu'où remontent les données de ticks de Tradovate ?", a: "Par défaut, les graphiques en ticks et basés sur les ticks chargent environ deux semaines d'historique. Un module complémentaire optionnel, Extended Tick Data History, l'étend à environ un an en simulation, en réel et en market replay. Les tarifs et la disponibilité évoluent ; confirmez donc les conditions actuelles dans vos Application Settings avant d'acheter." },
    { q: "Pourquoi mon graphique en ticks semble-t-il clairsemé à côté d'un graphique en 5 minutes ?", a: "Un graphique basé sur le temps imprime une barre à chaque intervalle quoi qu'il arrive. Un graphique en ticks ne clôture une barre que lorsque son nombre de transactions est atteint ; pendant les périodes lentes, vous obtenez donc naturellement moins de barres, plus espacées. C'est ainsi que les graphiques en ticks sont conçus, ce n'est pas une panne de la plateforme." },
    { q: "Passer à une unité de temps basée sur le temps corrige-t-il les barres en ticks qui ne se chargent pas ?", a: "C'est le moyen le plus rapide d'obtenir un graphique fonctionnel pendant que vous réglez le flux de ticks. Un intervalle basé sur le temps charge l'historique de manière standard, les barres apparaissent donc immédiatement. Cela ne répare pas le problème de ticks sous-jacent, mais vous continuez à lire le prix et à passer des ordres sans attendre." },
    { q: "Pourquoi mon graphique en ticks a-t-il cessé de charger quand j'ai fait défiler vers l'arrière ?", a: "Vous avez probablement atteint la fenêtre d'historique de ticks de deux semaines. Au-delà, le graphique cesse simplement d'ajouter des barres plus anciennes. Pour un historique plus profond, utilisez un intervalle basé sur le temps ou activez le module complémentaire Extended Tick Data History." },
    { q: "Les barres en ticks nécessitent-elles un abonnement aux données de marché en temps réel ?", a: "Oui. Si le nom de votre symbole s'affiche en orange ou si vous êtes en données différées ou sans données, les ticks actuels ne sont pas diffusés et le graphique reste figé au bord droit. Activez ou souscrivez les données de marché en temps réel, puis déconnectez-vous et reconnectez-vous pour que le flux en direct se rattache." },
    { q: "Si mon graphique en ticks échoue, mes ordres automatisés seront-ils quand même exécutés ?", a: "Oui. Si vous automatisez avec PickMyTrade, les ordres sont acheminés depuis vos alertes TradingView, pas depuis le rendu du graphique de Tradovate. Un graphique en ticks clairsemé ou bloqué ne bloque ni ne retarde jamais une exécution automatisée." },
  ], it: [
    { q: "Perché il mio grafico a tick di Tradovate non carica le barre?", a: "Le barre a tick si formano solo quando vengono eseguite operazioni reali, non secondo un orologio fisso. Su un contratto poco scambiato o durante una sessione tranquilla, poche operazioni significano poche barre, quindi il grafico appare quasi vuoto. Passi al contratto attivo del mese frontale o a un intervallo basato sul tempo e le barre si riempiranno normalmente." },
    { q: "Come risolvo un grafico a tick bloccato o che mostra solo poche barre?", a: "Ricarichi prima il feed di dati: aggiorni la scheda del browser su Tradovate Web, oppure chiuda e riapra l'app desktop o mobile. Se il contratto è poco scambiato, passi al mese frontale. Come soluzione rapida che le garantisce sempre un grafico funzionante, passi a un intervallo basato sul tempo come 1 minuto o 5 minuti." },
    { q: "Quanto indietro arrivano i dati tick di Tradovate?", a: "Per impostazione predefinita, i grafici a tick e quelli basati sui tick caricano circa due settimane di storico. Un componente aggiuntivo opzionale, Extended Tick Data History, lo estende a circa un anno in simulazione, live e market replay. Prezzi e disponibilità cambiano nel tempo, quindi confermi le condizioni attuali nelle sue Application Settings prima di acquistare." },
    { q: "Perché il mio grafico a tick appare scarno rispetto a un grafico a 5 minuti?", a: "Un grafico basato sul tempo stampa una barra a ogni intervallo, a prescindere da tutto. Un grafico a tick chiude una barra solo quando raggiunge il numero di operazioni previsto, quindi nei periodi lenti si ottengono naturalmente meno barre e più distanziate. È così che sono costruiti i grafici a tick, non è un guasto della piattaforma." },
    { q: "Passare a un intervallo basato sul tempo risolve il problema delle barre a tick che non si caricano?", a: "È il modo più veloce per ottenere un grafico funzionante mentre risolve il feed dei tick. Un intervallo basato sul tempo carica lo storico nel modo standard, quindi le barre compaiono subito. Non ripara il problema di fondo dei tick, ma le permette di continuare a leggere il prezzo e a inserire ordini senza attendere." },
    { q: "Perché il mio grafico a tick ha smesso di caricarsi quando sono tornato indietro?", a: "Probabilmente ha raggiunto la finestra di storico tick di due settimane. Oltre quel limite il grafico smette semplicemente di aggiungere barre più vecchie. Per uno storico più profondo, usi un intervallo basato sul tempo o attivi il componente aggiuntivo Extended Tick Data History." },
    { q: "Le barre a tick richiedono un abbonamento ai dati di mercato in tempo reale?", a: "Sì. Se il nome del simbolo appare in arancione o ha dati ritardati o assenti, i tick correnti non vengono trasmessi e il grafico si ferma al bordo destro. Attivi o sottoscriva i dati di mercato in tempo reale, poi esca e riaccede affinché il feed live si colleghi." },
    { q: "Se il mio grafico a tick non funziona, i miei ordini automatizzati verranno comunque eseguiti?", a: "Sì. Se automatizza con PickMyTrade, gli ordini vengono instradati dai suoi alert di TradingView, non dal rendering del grafico di Tradovate. Un grafico a tick scarno o bloccato non blocca né ritarda mai un'esecuzione automatizzata." },
  ] },
  relatedHeading: { en: "Related Guides", de: "Verwandte Leitfäden", es: "Guías relacionadas", fr: "Guides associés", it: "Guide correlate" },
  disclosureText: { en: "This guide is for educational and informational purposes only and is not financial, investment, or trading advice. Trading futures and other leveraged products carries a substantial risk of loss and is not suitable for every investor. PickMyTrade is an independent third-party automation platform and is not affiliated with, endorsed by, or sponsored by Tradovate, Inc. All related names, logos, and trademarks are the property of their respective owners. Platform features and steps change over time, so always confirm the current process in the official platform documentation before acting.", de: "Dieser Leitfaden dient ausschließlich Bildungs- und Informationszwecken und stellt keine Finanz-, Anlage- oder Handelsberatung dar. Der Handel mit Futures und anderen gehebelten Produkten birgt ein erhebliches Verlustrisiko und ist nicht für jeden Anleger geeignet. PickMyTrade ist eine unabhängige Automatisierungsplattform eines Drittanbieters und steht in keiner Verbindung zu Tradovate, Inc., wird von dieser weder unterstützt noch gesponsert. Alle genannten Namen, Logos und Marken sind Eigentum ihrer jeweiligen Inhaber. Funktionen und Schritte der Plattform ändern sich im Laufe der Zeit. Prüfen Sie daher vor jeder Handlung stets den aktuellen Ablauf in der offiziellen Plattformdokumentation.", es: "Esta guía tiene fines exclusivamente educativos e informativos y no constituye asesoramiento financiero, de inversión ni de trading. Operar con futuros y otros productos apalancados conlleva un riesgo sustancial de pérdida y no es adecuado para todos los inversores. PickMyTrade es una plataforma de automatización independiente de terceros y no está afiliada, respaldada ni patrocinada por Tradovate, Inc. Todos los nombres, logotipos y marcas relacionados son propiedad de sus respectivos titulares. Las funciones y los pasos de la plataforma cambian con el tiempo, por lo que siempre debe confirmar el proceso vigente en la documentación oficial de la plataforma antes de actuar.", fr: "Ce guide est fourni à des fins éducatives et informatives uniquement et ne constitue pas un conseil financier, d'investissement ou de trading. Le trading de contrats à terme et d'autres produits à effet de levier comporte un risque de perte important et ne convient pas à tous les investisseurs. PickMyTrade est une plateforme d'automatisation tierce indépendante et n'est ni affiliée à Tradovate, Inc., ni approuvée ou parrainée par cette dernière. Tous les noms, logos et marques associés sont la propriété de leurs détenteurs respectifs. Les fonctionnalités et les étapes de la plateforme évoluent avec le temps ; vérifiez donc toujours la procédure en vigueur dans la documentation officielle de la plateforme avant d'agir.", it: "Questa guida ha esclusivamente scopo educativo e informativo e non costituisce consulenza finanziaria, di investimento o di trading. Il trading di futures e di altri prodotti a leva comporta un rischio di perdita sostanziale e non è adatto a tutti gli investitori. PickMyTrade è una piattaforma di automazione indipendente di terze parti e non è affiliata a Tradovate, Inc., né da essa approvata o sponsorizzata. Tutti i nomi, i loghi e i marchi correlati sono di proprietà dei rispettivi titolari. Le funzionalità e i passaggi della piattaforma cambiano nel tempo, perciò confermi sempre la procedura attuale nella documentazione ufficiale della piattaforma prima di agire." },
};
const data: GuideArticleData = resolveGuideContent(content, locale, related);

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: data.faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: `${SITE_URL}${withSlash(localizedPath(locale))}` },
    { "@type": "ListItem", position: 2, name: "Debugging", item: `${SITE_URL}${withSlash(localizedPath(locale, "debugging"))}` },
    { "@type": "ListItem", position: 3, name: content.h1[locale], item: `${SITE_URL}${withSlash(localizedPath(locale, `debugging/${SLUG}`))}` },
  ],
};

