---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "liquidation-only-mode-risk-loss-limit";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/debugging/${SLUG}`;

const META_TITLE = "Tradovate Liquidation-Only Mode After Loss Limit";
const META_DESCRIPTION =
  "Tradovate Liquidation-Only mode locks new trades after a loss limit or profit target. Learn what triggers it, when it clears, and how to reopen fast.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Tradovate Liquidation-Only-Modus nach Verlustlimit", es: "Tradovate: modo Liquidation-Only tras un límite de pérdida", fr: "Tradovate : mode Liquidation-Only après une limite de perte", it: "Tradovate: modalità Liquidation-Only dopo un limite di perdita" },
  dek: { en: "Every new order bounces back with \"Your account is set to liquidation only,\" right after a Risk Setting fired. Here's exactly what triggers the lock, when it clears, and how to reopen early on a self-funded account.", de: "Jede neue Order wird mit „Your account is set to liquidation only“ abgelehnt, direkt nachdem eine Risikoeinstellung ausgelöst hat. Hier erfahren Sie genau, was die Sperre auslöst, wann sie endet und wie Sie bei einem selbst finanzierten Konto vorzeitig wieder öffnen.", es: "Cada orden nueva rebota con «Your account is set to liquidation only», justo después de que se activara una configuración de riesgo. Le explicamos exactamente qué provoca el bloqueo, cuándo se levanta y cómo reabrir antes de tiempo en una cuenta autofinanciada.", fr: "Chaque nouvel ordre est rejeté avec « Your account is set to liquidation only », juste après le déclenchement d'un paramètre de risque. Voici exactement ce qui déclenche le verrouillage, quand il se lève et comment rouvrir plus tôt sur un compte autofinancé.", it: "Ogni nuovo ordine viene respinto con «Your account is set to liquidation only», subito dopo che è scattata un'impostazione di rischio. Ecco esattamente che cosa innesca il blocco, quando si risolve e come riaprire in anticipo su un conto autofinanziato." },
  readTime: { en: "7 min read", de: "7 Min. Lesezeit", es: "Lectura de 7 min", fr: "Lecture : 7 min", it: "Lettura di 7 min" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "You close a green scalp on NQ, go to fire the next entry, and Tradovate bounces it with <em>&ldquo;Your account is set to liquidation only.&rdquo;</em> Your open position closed on its own, and now every new order gets rejected. Nothing's actually broken, your account has flipped into <strong class='text-white'>Liquidation-Only mode</strong> because a Risk Setting you configured (a daily loss limit, a weekly loss limit, or a profit target) got hit. It's one of the most common &ldquo;why can't I trade?&rdquo; moments on Tradovate, and the fix depends on whether you're on a self-funded brokerage account or a prop-firm evaluation. Here's what triggers Liquidation-Only, exactly when it clears, and how PickMyTrade's risk-aware automation keeps you from slamming into the limit by surprise." },
    {
      type: "checklist",
      heading: "Quick Checklist for Tradovate Liquidation-Only Mode",
      items: [
        "<strong class='text-white'>You hit a Daily Loss Limit</strong>, wait for the next trading session (5:00 PM CT the same day), or lower/raise the limit in Risk Settings on a self-funded account.",
        "<strong class='text-white'>You hit a Weekly Loss Limit</strong>, trading reopens at the start of the next week (5:00 PM CT Sunday).",
        "<strong class='text-white'>You hit a Daily/Weekly Profit Target</strong>, same rule. The target is a liquidation trigger, so positions auto-close and no new ones open until the next session or week.",
        "<strong class='text-white'>You're on a prop or evaluation account</strong>, you can't edit the limits yourself. Contact your prop firm, not Tradovate.",
        "<strong class='text-white'>You're on a self-funded live or demo account</strong>, open <strong class='text-white'>Risk Settings</strong> and change the parameter to re-enter early.",
        "<strong class='text-white'>Still stuck after changing the limit?</strong>, confirm you edited the right account and that the change actually saved. A rare edge case can leave live accounts stuck (covered below).",
      ],
    },
    { type: "heading", text: "What \"Your Account Is Set to Liquidation Only\" Means" },
    { type: "paragraph", html: "Liquidation-Only (you'll also see it as &ldquo;Liquidate-Only&rdquo;) is a protective account state, not an error in the usual sense. When one of your Risk Settings thresholds is reached, Tradovate immediately sends a <strong class='text-white'>market order to close all open positions</strong>, then restricts the account so you can only <em>reduce or close</em> exposure, you can't open anything new. Order tickets that would add to or reverse a position get rejected, usually with the message <em>&ldquo;Your account is set to liquidation only.&rdquo;</em>" },
    { type: "paragraph", html: "Here's the nuance most traders miss: <strong class='text-white'>loss limits are liquidation triggers, not guaranteed loss caps.</strong> Because the flatten goes out as a market order, slippage in a fast market can push your realized loss a little past the number you set. The limit is the point where Tradovate <em>starts</em> liquidating, it's not a stop that freezes your P&amp;L at exactly that figure." },
    { type: "paragraph", html: "A Liquidation-Only lock from Risk Settings is <em>session-based</em>. That's different from a permanent breach (like touching a prop-firm trailing max drawdown) or a compliance lock from a missed document deadline. Those are separate situations with separate fixes." },
    { type: "heading", text: "Top Causes of Tradovate Liquidation-Only" },
    { type: "heading", text: "1. Daily Loss Limit Reached" },
    { type: "paragraph", html: "The <strong class='text-white'>Daily Loss Limit</strong> is the maximum net loss allowed in a single trading day. Tradovate calculates daily P&amp;L in real time, fees and commissions included, from <strong class='text-white'>5:00 PM Central Time to 3:45 PM Central Time, Sunday through Friday</strong>. The moment your net loss touches the limit, a market order flattens your positions and the account goes Liquidation-Only for the rest of that session." },
    { type: "heading", text: "2. Weekly Loss Limit Reached" },
    { type: "paragraph", html: "The <strong class='text-white'>Weekly Loss Limit</strong> is the maximum net loss allowed across a whole trading week. The weekly session runs from <strong class='text-white'>5:00 PM CT Sunday to 3:45 PM CT Friday</strong>. Hit this one and the account stays locked to Liquidation-Only until the start of the <em>next</em> trading week, a much longer lockout than the daily limit, and a nasty surprise if you assume it resets overnight." },
    { type: "heading", text: "3. Daily or Weekly Profit Target Reached" },
    { type: "paragraph", html: "Profit targets work exactly like loss limits, just in reverse. Set a <strong class='text-white'>Daily Profit Target</strong> or <strong class='text-white'>Weekly Profit Target</strong>, and reaching it fires the same liquidation trigger: your positions close to lock in the gain, and the account flips to Liquidation-Only until the next session or week. If you forget you turned a profit target on, this feels like a bug, &ldquo;I was up, why did it close me?&rdquo;, but it's the setting doing exactly what you told it to." },
    { type: "heading", text: "4. Prop / Evaluation Account Rule Breach" },
    { type: "paragraph", html: "On a prop-firm evaluation or funded account, the risk parameters are set and <strong class='text-white'>locked by the firm</strong>, not by you. Tradovate's own Risk Settings aren't applicable to evaluation accounts, those are administered through the prop provider. When a firm-defined daily loss or drawdown rule trips, the account goes into Liquidation-Only by the firm's configuration, and only the provider can adjust or reset it." },
    { type: "heading", text: "5. A Stuck Live Account (Rare Edge Case)" },
    { type: "paragraph", html: "Once in a while a <strong class='text-white'>live</strong> account stays locked in Liquidation-Only with no way to continue trading even after you raise the limits, while the same strategy behaves correctly on demo. It's rare and isn't part of Tradovate's documented behavior, so treat it as an edge case: if you've changed the limit and trading still won't reopen, contact Tradovate support rather than assuming a normal reset will clear it." },
    { type: "heading", text: "How to Fix Tradovate Liquidation-Only: Step-by-Step" },
    { type: "heading", text: "Fixing It on a Self-Funded Live or Demo Account" },
    { type: "paragraph", html: "On a self-funded Tradovate Brokerage (live) or demo account, you own the Risk Settings and can lift the lock without waiting." },
    {
      type: "steps",
      items: [
        { title: "Open the Accounts module", html: "Open the <strong class='text-white'>Accounts</strong> module and confirm which account shows the Liquidation-Only / Liquidate-Only status." },
        { title: "Open Risk Settings", html: "Open that account's <strong class='text-white'>Risk Settings</strong> panel." },
        { title: "Find the parameter that was reached", html: "Find the parameter that was reached, Daily Loss Limit, Weekly Loss Limit, or the relevant Profit Target." },
        { title: "Change the value and save", html: "Change the value (raise it, or clear it) so your current session P&amp;L sits inside the new threshold, and save." },
        { title: "Confirm you can open positions again", html: "Go back to your order ticket, you should be able to open positions again for the current session." },
      ],
    },
    { type: "paragraph", html: "Don't want to touch your discipline settings? Just <strong class='text-white'>wait for the next trading session</strong>: the account clears on its own at <strong class='text-white'>5:00 PM CT</strong> for daily limits, or <strong class='text-white'>5:00 PM CT Sunday</strong> for weekly limits." },
    { type: "heading", text: "Fixing It on a Prop or Evaluation Account" },
    { type: "paragraph", html: "You <strong class='text-white'>can't</strong> self-serve this one. Here's what to do instead:" },
    {
      type: "steps",
      items: [
        { title: "Stop firing rejected orders", html: "Stop firing rejected orders, they won't go through, and they just clutter your logs." },
        { title: "Check your firm's rulebook", html: "Check your prop firm's rulebook to confirm which limit you hit (daily loss, max drawdown, and so on)." },
        { title: "Contact your prop provider's support", html: "Contact your <strong class='text-white'>prop provider's</strong> support. Tradovate can't change firm-locked risk parameters, with one narrow exception, Trailing Max Drawdown, which NinjaTrader/Tradovate can adjust through their orders desk." },
        { title: "Ask about the reset process", html: "Ask whether the account resets automatically at the next session, or whether a reset or new evaluation is required." },
      ],
    },
    { type: "heading", text: "If You Just Want to Wait It Out" },
    { type: "paragraph", html: "For any account type, a lock that comes from daily or weekly limits is session-scoped:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Daily</strong> loss limit or profit target &rarr; clears at the start of the next session, <strong class='text-white'>5:00 PM CT the same day</strong>.",
        "<strong class='text-white'>Weekly</strong> loss limit or profit target &rarr; clears at the start of the next week, <strong class='text-white'>5:00 PM CT on Sunday</strong>.",
      ],
    },
    { type: "paragraph", html: "You don't need to do anything to let the timer run out, but short of changing the setting on a self-funded account, nothing will unlock it earlier." },
    { type: "heading", text: "Troubleshooting Table" },
    {
      type: "table",
      headers: ["Message / State", "Meaning", "Fix"],
      rows: [
        ["&ldquo;Your account is set to liquidation only.&rdquo;", "A Risk Setting trigger fired; the account can close but not open positions", "Wait for the next session/week, or edit Risk Settings on a self-funded account"],
        ["Liquidation-Only after a losing streak", "Daily or Weekly Loss Limit reached", "Raise/clear the loss limit (self-funded) or wait for the session/week reset"],
        ["Positions auto-closed while in profit", "Daily or Weekly Profit Target reached", "It's a liquidation trigger, disable the target if you don't want the auto-flatten"],
        ["Locked until Sunday evening", "Weekly limit reached, not daily", "Reopens at 5:00 PM CT Sunday; only the firm/you can shorten it"],
        ["Realized loss exceeded the limit", "The limit is a trigger, not a hard cap; market-order slippage", "Set a tighter limit or a buffer; expect some slippage on the flatten"],
        ["Can't edit the limit at all", "Prop/evaluation account, firm-locked", "Contact your prop provider; Tradovate can't unlock it"],
        ["Still locked after raising the limit (live)", "Rare stuck-state edge case", "Confirm the save, then contact Tradovate support"],
      ],
    },
    { type: "heading", text: "Prevent This with PickMyTrade" },
    { type: "paragraph", html: "Liquidation-Only usually isn't a settings problem, it's a <em>timing</em> problem. You breach the limit mid-strategy and lose the rest of the session. PickMyTrade links your TradingView alerts straight to Tradovate and adds a risk-aware layer on top of your account, so you control the flow of orders before Tradovate ever has to step in:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Daily-loss guardrails in automation logic</strong>, cap the number of trades, or the loss you'll take per day, at the automation layer. New entries stop going out <em>before</em> your account trips its hard Liquidation-Only limit.",
        "<strong class='text-white'>Profit-target awareness</strong>, pause new alerts once your session goal is met, instead of getting auto-flattened at an inconvenient fill.",
        "<strong class='text-white'>Rejection-safe routing</strong>, when the account is already in Liquidation-Only, PickMyTrade isn't blindly hammering rejected orders into your log; you route cleanly on the next valid session.",
        "<strong class='text-white'>Multi-account sync</strong>, apply the same guardrails across every connected Tradovate account at once, so one account's limit doesn't quietly drift out of line with the others.",
      ],
    },
    { type: "paragraph", html: "The goal is simple: hit your risk rules on <em>your</em> terms, not by discovering the hard limit after your position is already gone." },
  ], de: [
    { type: "paragraph",html: "Sie schließen einen grünen Scalp auf NQ, wollen den nächsten Einstieg auslösen, und Tradovate lehnt ihn mit <em>&ldquo;Your account is set to liquidation only.&rdquo;</em> ab. Ihre offene Position wurde von selbst geschlossen, und nun wird jede neue Order abgelehnt. Es ist nichts kaputt, Ihr Konto ist in den <strong class='text-white'>Liquidation-Only-Modus</strong> gewechselt, weil eine von Ihnen konfigurierte Risikoeinstellung (ein Tagesverlustlimit, ein Wochenverlustlimit oder ein Gewinnziel) erreicht wurde. Es ist eines der häufigsten Probleme nach dem Motto &ldquo;Warum kann ich nicht handeln?&rdquo; bei Tradovate, und die Lösung hängt davon ab, ob Sie ein selbst finanziertes Brokerage-Konto oder eine Prop-Firm-Evaluierung haben. Hier erfahren Sie, was Liquidation-Only auslöst, wann es genau endet und wie die risikobewusste Automatisierung von PickMyTrade verhindert, dass Sie überraschend gegen das Limit laufen." },
    {
      type: "checklist",
      heading: "Kurze Checkliste für den Tradovate-Liquidation-Only-Modus",
      items: [
        "<strong class='text-white'>Sie haben ein Daily Loss Limit erreicht</strong>, warten Sie auf die nächste Handelssitzung (5:00 PM CT am selben Tag) oder senken/erhöhen Sie das Limit in Risk Settings bei einem selbst finanzierten Konto.",
        "<strong class='text-white'>Sie haben ein Weekly Loss Limit erreicht</strong>, der Handel öffnet zu Beginn der nächsten Woche wieder (5:00 PM CT am Sonntag).",
        "<strong class='text-white'>Sie haben ein Daily/Weekly Profit Target erreicht</strong>, dieselbe Regel. Das Ziel ist ein Liquidationsauslöser, daher werden Positionen automatisch geschlossen und bis zur nächsten Sitzung oder Woche werden keine neuen eröffnet.",
        "<strong class='text-white'>Sie haben ein Prop- oder Evaluierungskonto</strong>, Sie können die Limits nicht selbst ändern. Wenden Sie sich an Ihre Prop-Firma, nicht an Tradovate.",
        "<strong class='text-white'>Sie haben ein selbst finanziertes Live- oder Demo-Konto</strong>, öffnen Sie <strong class='text-white'>Risk Settings</strong> und ändern Sie den Parameter, um vorzeitig wieder einzusteigen.",
        "<strong class='text-white'>Nach der Änderung des Limits immer noch gesperrt?</strong>, prüfen Sie, ob Sie das richtige Konto bearbeitet haben und die Änderung tatsächlich gespeichert wurde. Ein seltener Sonderfall kann Live-Konten festhalten (siehe unten).",
      ],
    },
    { type: "heading",text: "Was „Your Account Is Set to Liquidation Only“ bedeutet" },
    { type: "paragraph",html: "Liquidation-Only (auch als &ldquo;Liquidate-Only&rdquo; zu sehen) ist ein schützender Kontozustand, kein Fehler im üblichen Sinn. Wird einer der Schwellenwerte Ihrer Risk Settings erreicht, sendet Tradovate sofort eine <strong class='text-white'>Market-Order zum Schließen aller offenen Positionen</strong> und beschränkt dann das Konto so, dass Sie das Exposure nur <em>reduzieren oder schließen</em> können, nichts Neues eröffnen. Orderformulare, die eine Position vergrößern oder umkehren würden, werden abgelehnt, meist mit der Meldung <em>&ldquo;Your account is set to liquidation only.&rdquo;</em>" },
    { type: "paragraph",html: "Hier die Nuance, die die meisten Trader übersehen: <strong class='text-white'>Verlustlimits sind Liquidationsauslöser, keine garantierten Verlustobergrenzen.</strong> Weil das Glattstellen als Market-Order erfolgt, kann Slippage in einem schnellen Markt Ihren realisierten Verlust ein Stück über die von Ihnen festgelegte Zahl hinaus treiben. Das Limit ist der Punkt, an dem Tradovate mit der Liquidation <em>beginnt</em>, es ist kein Stopp, der Ihre P&amp;L exakt bei diesem Wert einfriert." },
    { type: "paragraph",html: "Eine Liquidation-Only-Sperre durch Risk Settings ist <em>sitzungsbasiert</em>. Das unterscheidet sich von einem dauerhaften Verstoß (etwa dem Erreichen eines Trailing Max Drawdown bei einer Prop-Firma) oder einer Compliance-Sperre wegen einer versäumten Dokumentenfrist. Das sind getrennte Situationen mit getrennten Lösungen." },
    { type: "heading",text: "Häufigste Ursachen für Tradovate Liquidation-Only" },
    { type: "heading",text: "1. Daily Loss Limit erreicht" },
    { type: "paragraph",html: "Das <strong class='text-white'>Daily Loss Limit</strong> ist der maximale Nettoverlust, der an einem einzelnen Handelstag erlaubt ist. Tradovate berechnet die tägliche P&amp;L in Echtzeit, inklusive Gebühren und Provisionen, von <strong class='text-white'>5:00 PM Central Time bis 3:45 PM Central Time, Sonntag bis Freitag</strong>. In dem Moment, in dem Ihr Nettoverlust das Limit berührt, stellt eine Market-Order Ihre Positionen glatt, und das Konto geht für den Rest dieser Sitzung in Liquidation-Only." },
    { type: "heading",text: "2. Weekly Loss Limit erreicht" },
    { type: "paragraph",html: "Das <strong class='text-white'>Weekly Loss Limit</strong> ist der maximale Nettoverlust, der über eine ganze Handelswoche erlaubt ist. Die Wochensitzung läuft von <strong class='text-white'>5:00 PM CT am Sonntag bis 3:45 PM CT am Freitag</strong>. Erreichen Sie dieses Limit, bleibt das Konto bis zum Beginn der <em>nächsten</em> Handelswoche auf Liquidation-Only gesperrt, eine deutlich längere Sperre als beim Tageslimit und eine unangenehme Überraschung, wenn Sie annehmen, es werde über Nacht zurückgesetzt." },
    { type: "heading",text: "3. Daily oder Weekly Profit Target erreicht" },
    { type: "paragraph",html: "Gewinnziele funktionieren genau wie Verlustlimits, nur umgekehrt. Setzen Sie ein <strong class='text-white'>Daily Profit Target</strong> oder <strong class='text-white'>Weekly Profit Target</strong>, löst dessen Erreichen denselben Liquidationsauslöser aus: Ihre Positionen werden geschlossen, um den Gewinn zu sichern, und das Konto wechselt bis zur nächsten Sitzung oder Woche in Liquidation-Only. Haben Sie vergessen, dass Sie ein Gewinnziel aktiviert haben, fühlt sich das wie ein Fehler an, &ldquo;Ich war im Plus, warum wurde ich geschlossen?&rdquo;, aber die Einstellung tut genau das, was Sie ihr aufgetragen haben." },
    { type: "heading",text: "4. Regelverstoß bei Prop-/Evaluierungskonto" },
    { type: "paragraph",html: "Bei einem Evaluierungs- oder Funded-Konto einer Prop-Firma werden die Risikoparameter <strong class='text-white'>von der Firma festgelegt und gesperrt</strong>, nicht von Ihnen. Die eigenen Risk Settings von Tradovate gelten für Evaluierungskonten nicht, diese werden über den Prop-Anbieter verwaltet. Wenn eine von der Firma definierte Tagesverlust- oder Drawdown-Regel auslöst, geht das Konto per Konfiguration der Firma in Liquidation-Only, und nur der Anbieter kann es anpassen oder zurücksetzen." },
    { type: "heading",text: "5. Ein festhängendes Live-Konto (seltener Sonderfall)" },
    { type: "paragraph",html: "Hin und wieder bleibt ein <strong class='text-white'>Live</strong>-Konto in Liquidation-Only gesperrt und lässt keinen weiteren Handel zu, selbst nachdem Sie die Limits erhöht haben, während dieselbe Strategie im Demo korrekt läuft. Das ist selten und gehört nicht zum dokumentierten Verhalten von Tradovate, behandeln Sie es daher als Sonderfall: Wenn Sie das Limit geändert haben und der Handel trotzdem nicht wieder öffnet, wenden Sie sich an den Tradovate-Support, statt anzunehmen, dass ein normales Zurücksetzen es löst." },
    { type: "heading",text: "So beheben Sie Tradovate Liquidation-Only: Schritt für Schritt" },
    { type: "heading",text: "Behebung bei einem selbst finanzierten Live- oder Demo-Konto" },
    { type: "paragraph",html: "Bei einem selbst finanzierten Tradovate-Brokerage-Konto (Live) oder Demo-Konto gehören die Risk Settings Ihnen, und Sie können die Sperre aufheben, ohne zu warten." },
    {
      type: "steps",
      items: [
        { title: "Das Modul Accounts öffnen", html: "Öffnen Sie das Modul <strong class='text-white'>Accounts</strong> und prüfen Sie, welches Konto den Status Liquidation-Only / Liquidate-Only anzeigt." },
        { title: "Risk Settings öffnen", html: "Öffnen Sie das Panel <strong class='text-white'>Risk Settings</strong> dieses Kontos." },
        { title: "Den erreichten Parameter finden", html: "Finden Sie den erreichten Parameter, Daily Loss Limit, Weekly Loss Limit oder das entsprechende Profit Target." },
        { title: "Wert ändern und speichern", html: "Ändern Sie den Wert (erhöhen oder löschen), sodass die P&amp;L Ihrer aktuellen Sitzung innerhalb der neuen Schwelle liegt, und speichern Sie." },
        { title: "Bestätigen, dass Sie wieder Positionen eröffnen können", html: "Gehen Sie zurück zu Ihrem Orderformular, Sie sollten für die aktuelle Sitzung wieder Positionen eröffnen können." },
      ],
    },
    { type: "paragraph",html: "Möchten Sie Ihre Disziplin-Einstellungen nicht anfassen? <strong class='text-white'>Warten Sie einfach auf die nächste Handelssitzung</strong>: Das Konto wird bei Tageslimits von selbst um <strong class='text-white'>5:00 PM CT</strong> freigegeben, bei Wochenlimits am <strong class='text-white'>Sonntag um 5:00 PM CT</strong>." },
    { type: "heading",text: "Behebung bei einem Prop- oder Evaluierungskonto" },
    { type: "paragraph",html: "Hier können Sie sich <strong class='text-white'>nicht</strong> selbst helfen. Das sollten Sie stattdessen tun:" },
    {
      type: "steps",
      items: [
        { title: "Keine abgelehnten Orders mehr senden", html: "Senden Sie keine abgelehnten Orders mehr, sie gehen nicht durch und füllen nur Ihre Protokolle." },
        { title: "Das Regelwerk Ihrer Firma prüfen", html: "Prüfen Sie das Regelwerk Ihrer Prop-Firma, um herauszufinden, welches Limit Sie erreicht haben (Tagesverlust, Max Drawdown usw.)." },
        { title: "Den Support Ihres Prop-Anbieters kontaktieren", html: "Kontaktieren Sie den Support Ihres <strong class='text-white'>Prop-Anbieters</strong>. Tradovate kann von der Firma gesperrte Risikoparameter nicht ändern, mit einer engen Ausnahme, dem Trailing Max Drawdown, den NinjaTrader/Tradovate über ihren Orders Desk anpassen können." },
        { title: "Nach dem Zurücksetzungsprozess fragen", html: "Fragen Sie, ob das Konto zur nächsten Sitzung automatisch zurückgesetzt wird oder ob ein Reset bzw. eine neue Evaluierung erforderlich ist." },
      ],
    },
    { type: "heading",text: "Wenn Sie es einfach aussitzen möchten" },
    { type: "paragraph",html: "Bei jedem Kontotyp ist eine Sperre durch Tages- oder Wochenlimits sitzungsbezogen:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Tägliches</strong> Verlustlimit oder Gewinnziel &rarr; endet zu Beginn der nächsten Sitzung, <strong class='text-white'>am selben Tag um 5:00 PM CT</strong>.",
        "<strong class='text-white'>Wöchentliches</strong> Verlustlimit oder Gewinnziel &rarr; endet zu Beginn der nächsten Woche, <strong class='text-white'>am Sonntag um 5:00 PM CT</strong>.",
      ],
    },
    { type: "paragraph",html: "Sie müssen nichts tun, damit der Timer abläuft, aber außer der Änderung der Einstellung bei einem selbst finanzierten Konto schaltet nichts die Sperre früher frei." },
    { type: "heading",text: "Tabelle zur Fehlersuche" },
    { type: "table", headers: ["Meldung / Zustand","Bedeutung","Lösung"], rows: [
      ["&ldquo;Your account is set to liquidation only.&rdquo;","Ein Auslöser der Risk Settings hat ausgelöst; das Konto kann schließen, aber keine Positionen eröffnen","Auf die nächste Sitzung/Woche warten oder bei einem selbst finanzierten Konto die Risk Settings bearbeiten"],
      ["Liquidation-Only nach einer Verlustserie","Daily oder Weekly Loss Limit erreicht","Das Verlustlimit erhöhen/löschen (selbst finanziert) oder auf das Zurücksetzen der Sitzung/Woche warten"],
      ["Positionen im Gewinn automatisch geschlossen","Daily oder Weekly Profit Target erreicht","Es ist ein Liquidationsauslöser, deaktivieren Sie das Ziel, wenn Sie das automatische Glattstellen nicht wollen"],
      ["Gesperrt bis Sonntagabend","Wochenlimit erreicht, nicht Tageslimit","Öffnet am Sonntag um 5:00 PM CT wieder; nur die Firma/Sie selbst können es verkürzen"],
      ["Realisierter Verlust überschritt das Limit","Das Limit ist ein Auslöser, keine harte Obergrenze; Slippage der Market-Order","Ein engeres Limit oder einen Puffer setzen; beim Glattstellen mit etwas Slippage rechnen"],
      ["Limit lässt sich gar nicht bearbeiten","Prop-/Evaluierungskonto, von der Firma gesperrt","Prop-Anbieter kontaktieren; Tradovate kann es nicht freischalten"],
      ["Nach Erhöhung des Limits weiterhin gesperrt (Live)","Seltener Sonderfall eines festhängenden Zustands","Das Speichern bestätigen, dann den Tradovate-Support kontaktieren"],
    ] },
    { type: "heading",text: "Vorbeugen mit PickMyTrade" },
    { type: "paragraph",html: "Liquidation-Only ist meist kein Problem der Einstellungen, sondern ein <em>Timing</em>-Problem. Sie überschreiten das Limit mitten in der Strategie und verlieren den Rest der Sitzung. PickMyTrade verbindet Ihre TradingView-Alarme direkt mit Tradovate und fügt Ihrem Konto eine risikobewusste Ebene hinzu, sodass Sie den Orderfluss steuern, bevor Tradovate überhaupt eingreifen muss:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Tagesverlust-Leitplanken in der Automatisierungslogik</strong>, begrenzen Sie die Zahl der Trades oder den Verlust, den Sie pro Tag hinnehmen, auf der Automatisierungsebene. Neue Einstiege werden nicht mehr gesendet, <em>bevor</em> Ihr Konto sein hartes Liquidation-Only-Limit auslöst.",
        "<strong class='text-white'>Bewusstsein für Gewinnziele</strong>, pausieren Sie neue Alarme, sobald Ihr Sitzungsziel erreicht ist, statt zu einem ungünstigen Fill automatisch glattgestellt zu werden.",
        "<strong class='text-white'>Ablehnungssicheres Routing</strong>, wenn das Konto bereits in Liquidation-Only ist, hämmert PickMyTrade nicht blind abgelehnte Orders in Ihr Protokoll, Sie routen sauber in der nächsten gültigen Sitzung.",
        "<strong class='text-white'>Multi-Konto-Synchronisierung</strong>, wenden Sie dieselben Leitplanken gleichzeitig auf alle verbundenen Tradovate-Konten an, damit das Limit eines Kontos nicht unbemerkt von den anderen abweicht.",
      ],
    },
    { type: "paragraph",html: "Das Ziel ist einfach: Erreichen Sie Ihre Risikoregeln zu <em>Ihren</em> Bedingungen, statt das harte Limit erst zu entdecken, wenn Ihre Position schon weg ist." },
  ], es: [
    { type: "paragraph",html: "Cierra un scalp en verde en NQ, va a lanzar la siguiente entrada y Tradovate la rechaza con <em>&ldquo;Your account is set to liquidation only.&rdquo;</em> Su posición abierta se cerró sola y ahora se rechaza cada orden nueva. No hay nada roto, su cuenta ha pasado al <strong class='text-white'>modo Liquidation-Only</strong> porque se alcanzó una configuración de riesgo que usted definió (un límite de pérdida diaria, un límite de pérdida semanal o un objetivo de beneficio). Es uno de los momentos de &ldquo;¿por qué no puedo operar?&rdquo; más comunes en Tradovate, y la solución depende de si tiene una cuenta de brokerage autofinanciada o una evaluación de una firma prop. Aquí verá qué activa Liquidation-Only, exactamente cuándo se levanta y cómo la automatización consciente del riesgo de PickMyTrade evita que choque con el límite por sorpresa." },
    {
      type: "checklist",
      heading: "Lista rápida para el modo Liquidation-Only de Tradovate",
      items: [
        "<strong class='text-white'>Alcanzó un Daily Loss Limit</strong>, espere a la siguiente sesión de trading (5:00 PM CT del mismo día) o baje/suba el límite en Risk Settings en una cuenta autofinanciada.",
        "<strong class='text-white'>Alcanzó un Weekly Loss Limit</strong>, el trading se reabre al comienzo de la semana siguiente (5:00 PM CT del domingo).",
        "<strong class='text-white'>Alcanzó un Daily/Weekly Profit Target</strong>, misma regla. El objetivo es un disparador de liquidación, así que las posiciones se cierran automáticamente y no se abren nuevas hasta la siguiente sesión o semana.",
        "<strong class='text-white'>Tiene una cuenta prop o de evaluación</strong>, no puede editar los límites usted mismo. Contacte con su firma prop, no con Tradovate.",
        "<strong class='text-white'>Tiene una cuenta autofinanciada, real o de demostración</strong>, abra <strong class='text-white'>Risk Settings</strong> y cambie el parámetro para volver a entrar antes de tiempo.",
        "<strong class='text-white'>¿Sigue bloqueado tras cambiar el límite?</strong>, confirme que editó la cuenta correcta y que el cambio realmente se guardó. Un caso límite poco frecuente puede dejar bloqueadas las cuentas reales (se explica más abajo).",
      ],
    },
    { type: "heading",text: "Qué significa «Your Account Is Set to Liquidation Only»" },
    { type: "paragraph",html: "Liquidation-Only (también lo verá como &ldquo;Liquidate-Only&rdquo;) es un estado protector de la cuenta, no un error en el sentido habitual. Cuando se alcanza uno de los umbrales de sus Risk Settings, Tradovate envía de inmediato una <strong class='text-white'>orden de mercado para cerrar todas las posiciones abiertas</strong> y luego restringe la cuenta para que solo pueda <em>reducir o cerrar</em> exposición; no puede abrir nada nuevo. Las órdenes que aumentarían o invertirían una posición se rechazan, normalmente con el mensaje <em>&ldquo;Your account is set to liquidation only.&rdquo;</em>" },
    { type: "paragraph",html: "Este es el matiz que la mayoría de los traders pasa por alto: <strong class='text-white'>los límites de pérdida son disparadores de liquidación, no topes de pérdida garantizados.</strong> Como el cierre sale como orden de mercado, el deslizamiento en un mercado rápido puede llevar su pérdida realizada un poco más allá de la cifra que fijó. El límite es el punto en el que Tradovate <em>empieza</em> a liquidar; no es un stop que congele su P&amp;L exactamente en esa cifra." },
    { type: "paragraph",html: "Un bloqueo Liquidation-Only por Risk Settings es <em>por sesión</em>. Es distinto de una infracción permanente (como tocar el trailing max drawdown de una firma prop) o de un bloqueo de cumplimiento por un plazo de documentos incumplido. Son situaciones separadas con soluciones separadas." },
    { type: "heading",text: "Principales causas de Liquidation-Only en Tradovate" },
    { type: "heading",text: "1. Se alcanzó el Daily Loss Limit" },
    { type: "paragraph",html: "El <strong class='text-white'>Daily Loss Limit</strong> es la pérdida neta máxima permitida en un único día de trading. Tradovate calcula el P&amp;L diario en tiempo real, incluidas comisiones y tarifas, desde las <strong class='text-white'>5:00 PM hora central hasta las 3:45 PM hora central, de domingo a viernes</strong>. En el momento en que su pérdida neta toca el límite, una orden de mercado cierra sus posiciones y la cuenta pasa a Liquidation-Only durante el resto de esa sesión." },
    { type: "heading",text: "2. Se alcanzó el Weekly Loss Limit" },
    { type: "paragraph",html: "El <strong class='text-white'>Weekly Loss Limit</strong> es la pérdida neta máxima permitida a lo largo de toda una semana de trading. La sesión semanal va desde las <strong class='text-white'>5:00 PM CT del domingo hasta las 3:45 PM CT del viernes</strong>. Si lo alcanza, la cuenta permanece bloqueada en Liquidation-Only hasta el comienzo de la <em>siguiente</em> semana de trading, un bloqueo mucho más largo que el del límite diario y una desagradable sorpresa si supone que se restablece de un día para otro." },
    { type: "heading",text: "3. Se alcanzó el Profit Target diario o semanal" },
    { type: "paragraph",html: "Los objetivos de beneficio funcionan exactamente igual que los límites de pérdida, pero a la inversa. Configure un <strong class='text-white'>Daily Profit Target</strong> o un <strong class='text-white'>Weekly Profit Target</strong>, y al alcanzarlo se activa el mismo disparador de liquidación: sus posiciones se cierran para asegurar la ganancia y la cuenta pasa a Liquidation-Only hasta la siguiente sesión o semana. Si olvidó que activó un objetivo de beneficio, esto parece un error, &ldquo;estaba en positivo, ¿por qué me cerró?&rdquo;, pero es el ajuste haciendo exactamente lo que usted le indicó." },
    { type: "heading",text: "4. Infracción de reglas en una cuenta prop / de evaluación" },
    { type: "paragraph",html: "En una cuenta de evaluación o financiada de una firma prop, los parámetros de riesgo los <strong class='text-white'>establece y bloquea la firma</strong>, no usted. Los Risk Settings propios de Tradovate no se aplican a las cuentas de evaluación; estas se administran a través del proveedor prop. Cuando se activa una regla de pérdida diaria o de drawdown definida por la firma, la cuenta pasa a Liquidation-Only según la configuración de la firma, y solo el proveedor puede ajustarla o restablecerla." },
    { type: "heading",text: "5. Una cuenta real atascada (caso límite poco frecuente)" },
    { type: "paragraph",html: "De vez en cuando una cuenta <strong class='text-white'>real</strong> permanece bloqueada en Liquidation-Only sin posibilidad de seguir operando incluso después de subir los límites, mientras la misma estrategia se comporta correctamente en demo. Es poco frecuente y no forma parte del comportamiento documentado de Tradovate, así que trátelo como un caso límite: si cambió el límite y el trading sigue sin reabrirse, contacte con el soporte de Tradovate en lugar de suponer que un restablecimiento normal lo resolverá." },
    { type: "heading",text: "Cómo solucionar Liquidation-Only en Tradovate: paso a paso" },
    { type: "heading",text: "Solución en una cuenta autofinanciada, real o de demostración" },
    { type: "paragraph",html: "En una cuenta autofinanciada de Tradovate Brokerage (real) o de demostración, usted controla los Risk Settings y puede levantar el bloqueo sin esperar." },
    {
      type: "steps",
      items: [
        { title: "Abra el módulo Accounts", html: "Abra el módulo <strong class='text-white'>Accounts</strong> y confirme qué cuenta muestra el estado Liquidation-Only / Liquidate-Only." },
        { title: "Abra Risk Settings", html: "Abra el panel <strong class='text-white'>Risk Settings</strong> de esa cuenta." },
        { title: "Encuentre el parámetro que se alcanzó", html: "Encuentre el parámetro que se alcanzó, Daily Loss Limit, Weekly Loss Limit o el Profit Target correspondiente." },
        { title: "Cambie el valor y guarde", html: "Cambie el valor (súbalo o bórrelo) de modo que el P&amp;L de su sesión actual quede dentro del nuevo umbral, y guarde." },
        { title: "Confirme que puede abrir posiciones de nuevo", html: "Vuelva a su ticket de orden; debería poder abrir posiciones de nuevo durante la sesión actual." },
      ],
    },
    { type: "paragraph",html: "¿No quiere tocar sus ajustes de disciplina? Simplemente <strong class='text-white'>espere a la siguiente sesión de trading</strong>: la cuenta se libera sola a las <strong class='text-white'>5:00 PM CT</strong> en el caso de los límites diarios, o a las <strong class='text-white'>5:00 PM CT del domingo</strong> en el de los límites semanales." },
    { type: "heading",text: "Solución en una cuenta prop o de evaluación" },
    { type: "paragraph",html: "<strong class='text-white'>No puede</strong> resolverlo por su cuenta. Esto es lo que debe hacer en su lugar:" },
    {
      type: "steps",
      items: [
        { title: "Deje de enviar órdenes rechazadas", html: "Deje de enviar órdenes rechazadas, no se ejecutarán y solo saturan sus registros." },
        { title: "Revise el reglamento de su firma", html: "Revise el reglamento de su firma prop para confirmar qué límite alcanzó (pérdida diaria, drawdown máximo, etc.)." },
        { title: "Contacte con el soporte de su proveedor prop", html: "Contacte con el soporte de su <strong class='text-white'>proveedor prop</strong>. Tradovate no puede cambiar los parámetros de riesgo bloqueados por la firma, con una estrecha excepción, el Trailing Max Drawdown, que NinjaTrader/Tradovate pueden ajustar a través de su mesa de órdenes." },
        { title: "Pregunte por el proceso de restablecimiento", html: "Pregunte si la cuenta se restablece automáticamente en la siguiente sesión o si hace falta un reinicio o una nueva evaluación." },
      ],
    },
    { type: "heading",text: "Si prefiere simplemente esperar" },
    { type: "paragraph",html: "En cualquier tipo de cuenta, un bloqueo causado por límites diarios o semanales es por sesión:" },
    {
      type: "list",
      items: [
        "Límite de pérdida u objetivo de beneficio <strong class='text-white'>diario</strong> &rarr; se levanta al comienzo de la siguiente sesión, <strong class='text-white'>a las 5:00 PM CT del mismo día</strong>.",
        "Límite de pérdida u objetivo de beneficio <strong class='text-white'>semanal</strong> &rarr; se levanta al comienzo de la siguiente semana, <strong class='text-white'>a las 5:00 PM CT del domingo</strong>.",
      ],
    },
    { type: "paragraph",html: "No necesita hacer nada para que el temporizador se agote, pero, salvo cambiar el ajuste en una cuenta autofinanciada, nada lo desbloqueará antes." },
    { type: "heading",text: "Tabla de solución de problemas" },
    { type: "table", headers: ["Mensaje / estado","Significado","Solución"], rows: [
      ["&ldquo;Your account is set to liquidation only.&rdquo;","Se activó un disparador de Risk Settings; la cuenta puede cerrar pero no abrir posiciones","Esperar a la siguiente sesión/semana, o editar Risk Settings en una cuenta autofinanciada"],
      ["Liquidation-Only tras una racha perdedora","Se alcanzó el Daily o Weekly Loss Limit","Subir/borrar el límite de pérdida (autofinanciada) o esperar al restablecimiento de la sesión/semana"],
      ["Posiciones cerradas automáticamente estando en beneficios","Se alcanzó el Daily o Weekly Profit Target","Es un disparador de liquidación, desactive el objetivo si no quiere el cierre automático"],
      ["Bloqueado hasta el domingo por la tarde","Se alcanzó el límite semanal, no el diario","Se reabre a las 5:00 PM CT del domingo; solo la firma o usted pueden acortarlo"],
      ["La pérdida realizada superó el límite","El límite es un disparador, no un tope estricto; deslizamiento de la orden de mercado","Fije un límite más ajustado o un margen; espere algo de deslizamiento en el cierre"],
      ["No puede editar el límite en absoluto","Cuenta prop/de evaluación, bloqueada por la firma","Contacte con su proveedor prop; Tradovate no puede desbloquearla"],
      ["Sigue bloqueada tras subir el límite (real)","Caso límite poco frecuente de estado atascado","Confirme que se guardó y luego contacte con el soporte de Tradovate"],
    ] },
    { type: "heading",text: "Evítelo con PickMyTrade" },
    { type: "paragraph",html: "Liquidation-Only normalmente no es un problema de configuración, es un problema de <em>momento</em>. Supera el límite en mitad de la estrategia y pierde el resto de la sesión. PickMyTrade vincula sus alertas de TradingView directamente con Tradovate y añade una capa consciente del riesgo sobre su cuenta, de modo que usted controla el flujo de órdenes antes de que Tradovate tenga que intervenir:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Límites de pérdida diaria en la lógica de automatización</strong>, limite el número de operaciones, o la pérdida que asumirá por día, en la capa de automatización. Las nuevas entradas dejan de enviarse <em>antes</em> de que su cuenta active su límite estricto de Liquidation-Only.",
        "<strong class='text-white'>Conciencia del objetivo de beneficio</strong>, pause las nuevas alertas una vez cumplido su objetivo de sesión, en lugar de que lo cierren automáticamente en una ejecución inoportuna.",
        "<strong class='text-white'>Enrutamiento a prueba de rechazos</strong>, cuando la cuenta ya está en Liquidation-Only, PickMyTrade no inunda su registro a ciegas con órdenes rechazadas; enruta de forma limpia en la siguiente sesión válida.",
        "<strong class='text-white'>Sincronización multicuenta</strong>, aplique los mismos límites en todas las cuentas de Tradovate conectadas a la vez, de modo que el límite de una cuenta no se desvíe discretamente del de las demás.",
      ],
    },
    { type: "paragraph",html: "El objetivo es sencillo: alcance sus reglas de riesgo en <em>sus</em> condiciones, no descubriendo el límite estricto cuando su posición ya se ha ido." },
  ], fr: [
    { type: "paragraph",html: "Vous clôturez un scalp gagnant sur NQ, vous voulez lancer l'entrée suivante, et Tradovate la rejette avec <em>&ldquo;Your account is set to liquidation only.&rdquo;</em> Votre position ouverte s'est clôturée toute seule, et désormais chaque nouvel ordre est rejeté. Rien n'est cassé : votre compte est passé en <strong class='text-white'>mode Liquidation-Only</strong> parce qu'un paramètre de risque que vous aviez configuré (une limite de perte quotidienne, une limite de perte hebdomadaire ou un objectif de profit) a été atteint. C'est l'un des moments &ldquo;pourquoi ne puis-je pas trader ?&rdquo; les plus courants sur Tradovate, et la solution dépend de la nature de votre compte : brokerage autofinancé ou évaluation chez une société prop. Voici ce qui déclenche Liquidation-Only, exactement quand il se lève, et comment l'automatisation sensible au risque de PickMyTrade vous évite de heurter la limite par surprise." },
    {
      type: "checklist",
      heading: "Liste de contrôle rapide pour le mode Liquidation-Only de Tradovate",
      items: [
        "<strong class='text-white'>Vous avez atteint un Daily Loss Limit</strong>, attendez la prochaine session de trading (5:00 PM CT le même jour), ou baissez/relevez la limite dans Risk Settings sur un compte autofinancé.",
        "<strong class='text-white'>Vous avez atteint un Weekly Loss Limit</strong>, le trading rouvre au début de la semaine suivante (dimanche, 5:00 PM CT).",
        "<strong class='text-white'>Vous avez atteint un Daily/Weekly Profit Target</strong>, même règle. L'objectif est un déclencheur de liquidation : les positions sont clôturées automatiquement et aucune nouvelle ne s'ouvre jusqu'à la session ou la semaine suivante.",
        "<strong class='text-white'>Vous êtes sur un compte prop ou d'évaluation</strong>, vous ne pouvez pas modifier les limites vous-même. Contactez votre société prop, pas Tradovate.",
        "<strong class='text-white'>Vous êtes sur un compte autofinancé, réel ou démo</strong>, ouvrez <strong class='text-white'>Risk Settings</strong> et modifiez le paramètre pour reprendre plus tôt.",
        "<strong class='text-white'>Toujours bloqué après avoir modifié la limite ?</strong>, vérifiez que vous avez modifié le bon compte et que le changement a bien été enregistré. Un cas limite rare peut laisser des comptes réels bloqués (voir plus bas).",
      ],
    },
    { type: "heading",text: "Ce que signifie « Your Account Is Set to Liquidation Only »" },
    { type: "paragraph",html: "Liquidation-Only (vous le verrez aussi sous la forme &ldquo;Liquidate-Only&rdquo;) est un état de protection du compte, et non une erreur au sens habituel. Lorsqu'un des seuils de vos Risk Settings est atteint, Tradovate envoie immédiatement un <strong class='text-white'>ordre au marché pour clôturer toutes les positions ouvertes</strong>, puis restreint le compte afin que vous ne puissiez que <em>réduire ou clôturer</em> l'exposition, sans rien ouvrir de nouveau. Les tickets d'ordre qui augmenteraient ou inverseraient une position sont rejetés, généralement avec le message <em>&ldquo;Your account is set to liquidation only.&rdquo;</em>" },
    { type: "paragraph",html: "Voici la nuance que la plupart des traders manquent : <strong class='text-white'>les limites de perte sont des déclencheurs de liquidation, pas des plafonds de perte garantis.</strong> Comme l'aplatissement part sous forme d'ordre au marché, le glissement dans un marché rapide peut porter votre perte réalisée un peu au-delà du chiffre que vous avez fixé. La limite est le point où Tradovate <em>commence</em> à liquider ; ce n'est pas un stop qui fige votre P&amp;L exactement à ce chiffre." },
    { type: "paragraph",html: "Un verrouillage Liquidation-Only dû aux Risk Settings est <em>lié à la session</em>. C'est différent d'une violation permanente (comme toucher le trailing max drawdown d'une société prop) ou d'un blocage de conformité dû à un délai de documents dépassé. Ce sont des situations distinctes avec des solutions distinctes." },
    { type: "heading",text: "Principales causes de Liquidation-Only sur Tradovate" },
    { type: "heading",text: "1. Daily Loss Limit atteint" },
    { type: "paragraph",html: "Le <strong class='text-white'>Daily Loss Limit</strong> est la perte nette maximale autorisée sur une seule journée de trading. Tradovate calcule le P&amp;L quotidien en temps réel, frais et commissions inclus, de <strong class='text-white'>5:00 PM heure centrale à 3:45 PM heure centrale, du dimanche au vendredi</strong>. Dès que votre perte nette touche la limite, un ordre au marché aplatit vos positions et le compte passe en Liquidation-Only pour le reste de cette session." },
    { type: "heading",text: "2. Weekly Loss Limit atteint" },
    { type: "paragraph",html: "Le <strong class='text-white'>Weekly Loss Limit</strong> est la perte nette maximale autorisée sur une semaine de trading entière. La session hebdomadaire va du <strong class='text-white'>dimanche 5:00 PM CT au vendredi 3:45 PM CT</strong>. Si vous l'atteignez, le compte reste verrouillé en Liquidation-Only jusqu'au début de la semaine de trading <em>suivante</em>, un verrouillage bien plus long que celui de la limite quotidienne, et une mauvaise surprise si vous pensez qu'il se réinitialise du jour au lendemain." },
    { type: "heading",text: "3. Profit Target quotidien ou hebdomadaire atteint" },
    { type: "paragraph",html: "Les objectifs de profit fonctionnent exactement comme les limites de perte, mais en sens inverse. Définissez un <strong class='text-white'>Daily Profit Target</strong> ou un <strong class='text-white'>Weekly Profit Target</strong> : l'atteindre déclenche le même mécanisme de liquidation, vos positions sont clôturées pour sécuriser le gain et le compte passe en Liquidation-Only jusqu'à la session ou la semaine suivante. Si vous avez oublié avoir activé un objectif de profit, cela ressemble à un bogue, &ldquo;j'étais en gain, pourquoi m'a-t-on clôturé ?&rdquo;, mais c'est le paramètre qui fait exactement ce que vous lui avez demandé." },
    { type: "heading",text: "4. Violation des règles d'un compte prop / d'évaluation" },
    { type: "paragraph",html: "Sur un compte d'évaluation ou financé d'une société prop, les paramètres de risque sont <strong class='text-white'>définis et verrouillés par la société</strong>, et non par vous. Les Risk Settings propres à Tradovate ne s'appliquent pas aux comptes d'évaluation ; ceux-ci sont administrés par le fournisseur prop. Lorsqu'une règle de perte quotidienne ou de drawdown définie par la société se déclenche, le compte passe en Liquidation-Only selon la configuration de la société, et seul le fournisseur peut l'ajuster ou le réinitialiser." },
    { type: "heading",text: "5. Un compte réel bloqué (cas limite rare)" },
    { type: "paragraph",html: "De temps en temps, un compte <strong class='text-white'>réel</strong> reste verrouillé en Liquidation-Only sans possibilité de continuer à trader, même après avoir relevé les limites, alors que la même stratégie se comporte correctement en démo. C'est rare et cela ne fait pas partie du comportement documenté de Tradovate ; considérez-le donc comme un cas limite : si vous avez modifié la limite et que le trading ne rouvre toujours pas, contactez le support Tradovate plutôt que de supposer qu'une réinitialisation normale le réglera." },
    { type: "heading",text: "Comment corriger Liquidation-Only sur Tradovate : pas à pas" },
    { type: "heading",text: "Corriger sur un compte autofinancé, réel ou démo" },
    { type: "paragraph",html: "Sur un compte Tradovate Brokerage autofinancé (réel) ou un compte démo, les Risk Settings vous appartiennent et vous pouvez lever le verrouillage sans attendre." },
    {
      type: "steps",
      items: [
