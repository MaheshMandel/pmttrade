---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "price-alerts-not-triggering-exact-value";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/debugging/${SLUG}`;

const META_TITLE = "Tradovate >= / <= Price Alerts Fire One Tick Late";
const META_DESCRIPTION =
  "Tradovate price alerts firing a tick after your exact level? Set the trigger one tick early to compensate and see why greater/less-than alerts lag.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Tradovate->=/<=-Preisalarme lösen einen Tick zu spät aus", es: "Las alertas de precio >= / <= de Tradovate saltan un tick tarde", fr: "Les alertes de prix >= / <= de Tradovate se déclenchent un tick trop tard", it: "Gli alert di prezzo >= / <= di Tradovate scattano un tick in ritardo" },
  dek: { en: "Price prints exactly at your alert value and your bell stays silent, then one tick past it, the sound finally plays. The alert didn't miss and you didn't build it wrong, here's the one-tick trick that lands it exactly where you want it.", de: "Der Kurs druckt exakt Ihren Alarmwert und Ihre Glocke bleibt stumm, erst einen Tick weiter ertönt der Ton. Der Alarm hat nichts verpasst und Sie haben ihn nicht falsch eingerichtet – hier ist der Ein-Tick-Trick, mit dem er genau dort auslöst, wo Sie ihn wollen.", es: "El precio imprime justo su valor de alerta y su campana permanece en silencio; un tick más allá, por fin suena. La alerta no falló y usted no la configuró mal: aquí está el truco del tick que la hace saltar exactamente donde usted quiere.", fr: "Le prix s'imprime exactement à votre valeur d'alerte et votre cloche reste muette ; un tick plus loin, le son retentit enfin. L'alerte n'a rien manqué et vous ne l'avez pas mal configurée : voici l'astuce du tick qui la fait se déclencher exactement où vous le souhaitez.", it: "Il prezzo stampa esattamente il valore del Suo alert e la campanella resta muta; un tick più in là, finalmente il suono parte. L'alert non ha mancato nulla e Lei non l'ha configurato male: ecco il trucco del tick che lo fa scattare esattamente dove vuole." },
  readTime: { en: "7 min read", de: "7 Min. Lesezeit", es: "Lectura de 7 min", fr: "Lecture : 7 min", it: "Lettura di 7 min" },
  lastUpdated: "2026-07-10",
  blocks: { en: [
    { type: "paragraph", html: "You set an alert for exactly 5000.00 on the way up. Price prints 5000.00, sits there for a second, and your bell stays silent. Then a single tick at 5000.25 goes through and only <em>now</em> does the sound play. The alert didn't miss, and you didn't build it wrong. A greater-than-or-equal or less-than-or-equal alert on Tradovate can behave like a crossing rather than an exact touch, so it fires one tick past the value you typed instead of right at it. For a slow swing alert that's a rounding error. For a scalp entry or a tight breakout level, that one tick is the difference between being early and chasing. Here's what's happening under the hood and the one-tick trick that lands the alert exactly where you want it." },
    {
      type: "checklist",
      heading: "The Quick Fix",
      items: [
        "<strong class='text-white'>Nudge the alert one tick toward the price.</strong> For an upside (&gt;=) alert, set it one tick <em>below</em> your target. For a downside (&lt;=) alert, set it one tick <em>above</em> your target. The extra tick the platform adds then lands you back on your real level.",
        "<strong class='text-white'>Use your instrument's tick size, not a round number.</strong> One tick on ES/MES is 0.25. Crude (CL) is 0.01. NQ/MNQ is 0.25. Match the nudge to the contract.",
        "<strong class='text-white'>Test it once on a slow market.</strong> Fire a throwaway alert near the current price and watch exactly where it pings before you trust it on a live setup.",
        "<strong class='text-white'>Report it to support.</strong> The nudge is a workaround, not a fix. Email support with the instrument, condition, value, and platform so the behavior can be investigated.",
        "<strong class='text-white'>If you need an action, not a chime,</strong> evaluate the level in a charting platform and route it as an order so the trigger fires on the price you defined.",
      ],
    },
    { type: "heading", text: "What's Actually Happening" },
    { type: "paragraph", html: "Every Tradovate alert has three parts: a price level, a condition, and a notification type. When you drop an alert above the current price, the condition is “greater than or equal to” your value. Drop it below, and it's “less than or equal to.” The “or equal to” part is the whole point. You expect the alert to fire the moment price <em>touches</em> the number, not a tick later." },
    { type: "paragraph", html: "In practice, &gt;= and &lt;= alerts don't always honor the equal case. Price can print exactly at your value and the alert stays quiet. It only wakes up once a print lands one tick beyond the level, in the direction price was already moving. An upside alert at 5000.00 fires at 5000.25. A downside alert at 4980.00 fires at 4979.75. The condition ends up acting like a strict “greater than” or “less than,” even though the operator says “or equal to.” It's been seen on the desktop Trader app and on mobile web, and it's intermittent rather than constant, which is exactly what makes it easy to miss until it costs you an entry." },
    { type: "heading", text: "Why an “Or Equal To” Alert Skips the Equal" },
    { type: "paragraph", html: "You don't need the internals to fix this, but knowing why it happens tells you when to expect it. A few things line up:" },
    { type: "heading", text: "The alert watches the last traded price" },
    { type: "paragraph", html: "A price alert generally evaluates against the last print that crossed the tape, not the resting bid or ask. If your level sits between trades, no print ever lands exactly on it. Say the last trade was 4999.75 and the next is 5000.25. The market clearly passed 5000.00, but nothing ever <em>printed</em> at 5000.00, so an equality check against the last price never sees a match until 5000.25 goes through. That alone produces a one-tick-late fire." },
    { type: "heading", text: "Quotes are sampled, not streamed tick-for-tick" },
    { type: "paragraph", html: "The platform doesn't hand every micro-update to the alert engine instantly. Quote and DOM data refresh on a throttle, roughly on the order of once a second under load. If price kisses your exact level and moves on between two samples, the alert engine simply never sees the touch. It sees the “before” tick and the “after” tick, and the after tick is the one that fires the alert." },
    { type: "heading", text: "The comparison rounds toward a crossing" },
    { type: "paragraph", html: "Put those together and the effective behavior is a crossing, not a touch. The alert reliably fires once price is unambiguously past the level, which is one tick beyond. That's dependable in its own way, it's just not what “or equal to” implies, and it's why compensating by exactly one tick works so cleanly." },
    { type: "heading", text: "The One-Tick Fix, Step by Step" },
    { type: "heading", text: "Step 1: Know which side price is coming from" },
    { type: "paragraph", html: "The direction of the nudge depends entirely on which way price is traveling into your level. An alert placed above current price is an upside (&gt;=) alert; price rises into it and the late tick lands <em>above</em> your value. An alert placed below current price is a downside (&lt;=) alert; price falls into it and the late tick lands <em>below</em> your value. Get this straight first, because nudging the wrong way makes the alert fire two ticks off instead of zero." },
    { type: "heading", text: "Step 2: Move the value one tick toward the price" },
    { type: "paragraph", html: "Shift the alert value one tick onto the near side of your true level, so the platform's extra tick brings it back to the level you actually care about. The math is simple once you fix the direction:" },
    {
      type: "table",
      headers: ["Alert type", "Condition", "Your true level", "Set the alert at"],
      rows: [
        ["Upside (price rising in)", ">= (greater than or equal)", "5000.00", "4999.75 (one tick below)"],
        ["Downside (price falling in)", "<= (less than or equal)", "4980.00", "4980.25 (one tick above)"],
      ],
    },
    { type: "paragraph", html: "Those examples use ES, where one tick is 0.25. On CL a tick is 0.01, on gold (GC) it's 0.10, on the Treasury contracts it's a fraction of a point. Always nudge by one tick of the specific contract, never by a flat 0.25 or a round handle. If you're unsure of an instrument's tick size, hover the DOM or check the contract spec before you set the number." },
    { type: "heading", text: "Step 3: Set the alert on the chart or DOM" },
    { type: "paragraph", html: "Place the alert the way you normally would. On a chart, right-click the price level and choose the add-alert option, then set the condition and the nudged value. On the DOM, right-click the exact price cell and add the alert there. Either path lets you type the precise value, so enter the compensated number from Step 2 rather than the round level. Pick at least one notification you'll actually notice, sound and popup at minimum." },
    { type: "heading", text: "Step 4: Prove it with a throwaway alert" },
    { type: "paragraph", html: "Don't trust the fix on the setup that matters. On a quiet, slow-moving contract, set a compensated alert a few ticks from the current price and watch precisely where it fires. If it now pings at your intended level instead of a tick past it, the compensation is working for that instrument and platform. If it still lands a tick off, double-check the direction of your nudge and the tick size. This one-minute test is worth far more than assuming." },
    { type: "heading", text: "Step 5: Manage and clean up alerts from the bell" },
    { type: "paragraph", html: "Open the Alerts icon, the bell in the top-left of the workspace next to the New menu, to see every active, triggered, and expired alert in one place. This is where you edit a value if you nudged the wrong way, delete stale alerts that clutter the view, and confirm an alert is still armed rather than already spent. When an alert does fire, the browser plays a sound and the bell shows a red dot, so keep the panel handy while you verify the fix." },
    { type: "heading", text: "Step 6: Report the behavior to support" },
    { type: "paragraph", html: "The nudge patches the symptom, not the cause. Email support@tradovate.com with the details that make it reproducible: the exact instrument, the full condition and value, the platform you saw it on, and the plain fact that a &gt;= or &lt;= alert only fired one tick past the value. A specific report is the only thing that turns “some traders see this” into a tracked issue, and it's the fastest route to a definitive answer on whether it's expected or a defect." },
    { type: "heading", text: "Troubleshooting Table" },
    {
      type: "table",
      headers: ["Symptom", "Likely cause", "Fix"],
      rows: [
        [">= alert fires one tick above your value", "Equal case skipped; behaves like a strict crossing", "Set the alert one tick below your target level"],
        ["<= alert fires one tick below your value", "Same crossing behavior on the downside", "Set the alert one tick above your target level"],
        ["Compensated alert now fires two ticks off", "Nudged the wrong direction for the price's travel", "Flip the nudge to the side price is coming from"],
        ["Alert lands far from the level, not just a tick", "Delayed or missing data feed, not the tick quirk", "Confirm the symbol shows live real-time quotes"],
        ["Alert never fires at all", "Notifications off, alert spent, or level never reached", "Re-enable sound/popup and check the alert in the bell panel"],
        ["You need an entry at the price, not a notification", "Native alert is a chime, not an action", "Evaluate the level in a chart script and route it as an order"],
      ],
    },
    { type: "heading", text: "When a One-Tick Alert Isn't Good Enough" },
    { type: "paragraph", html: "Compensating by a tick is fine when the alert is just a nudge to look at the screen. But plenty of traders use a price alert as the trigger to <em>act</em>: hit the level, take the entry, arm the stop. The moment your reaction is the trade, a one-tick-late ping isn't cosmetic anymore. You either react a tick behind, or you pre-empt and hope. That's the gap worth closing with automation." },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Define the level where the logic is strong.</strong> A charting platform like TradingView lets you express the exact price condition, or a full strategy, and fire a webhook the instant it's met, with no dependence on a native alert that lands a tick late.",
        "<strong class='text-white'>Route it straight to Tradovate.</strong> PickMyTrade takes that webhook and acts on your account automatically, so the “alert” becomes an order at the level you set instead of a chime you still have to answer.",
        "<strong class='text-white'>Mirror across accounts.</strong> One trigger can drive several evaluation or funded accounts at once, so you're not manually re-arming a tick-sensitive alert on each screen.",
        "<strong class='text-white'>Rate-limit-safe routing.</strong> Order flow is spaced to stay inside Tradovate's request limits, avoiding the retry storms that cause their own lockouts.",
      ],
    },
    { type: "paragraph", html: "Keep native alerts for eyes-on levels where a tick doesn't matter, and hand the price-precise triggers to a pipeline that fires on the number you actually chose." },
  ], de: [
    { type: "paragraph",html: "Sie setzen einen Alarm für genau 5000.00 auf dem Weg nach oben. Der Kurs druckt 5000.00, bleibt dort eine Sekunde, und Ihre Glocke bleibt stumm. Dann geht ein einzelner Tick bei 5000.25 durch, und erst <em>jetzt</em> ertönt der Ton. Der Alarm hat nichts verpasst, und Sie haben ihn nicht falsch gebaut. Ein „größer oder gleich“- oder „kleiner oder gleich“-Alarm bei Tradovate kann sich wie ein Überschreiten statt wie eine exakte Berührung verhalten und daher einen Tick jenseits des eingetippten Wertes auslösen statt genau dort. Bei einem langsamen Swing-Alarm ist das ein Rundungsfehler. Bei einem Scalp-Einstieg oder einem engen Ausbruchsniveau ist dieser eine Tick der Unterschied zwischen zu früh und Hinterherlaufen. Hier erfahren Sie, was unter der Haube passiert, und den Ein-Tick-Trick, mit dem der Alarm genau dort auslöst, wo Sie ihn wollen." },
    {
      type: "checklist",
      heading: "Die schnelle Lösung",
      items: [
        "<strong class='text-white'>Schieben Sie den Alarm einen Tick in Richtung des Kurses.</strong> Bei einem Aufwärtsalarm (&gt;=) setzen Sie ihn einen Tick <em>unter</em> Ihr Ziel. Bei einem Abwärtsalarm (&lt;=) setzen Sie ihn einen Tick <em>über</em> Ihr Ziel. Der zusätzliche Tick, den die Plattform hinzufügt, bringt Sie dann wieder auf Ihr echtes Niveau.",
        "<strong class='text-white'>Verwenden Sie die Tickgröße Ihres Instruments, keine runde Zahl.</strong> Ein Tick bei ES/MES ist 0.25. Rohöl (CL) ist 0.01. NQ/MNQ ist 0.25. Passen Sie die Verschiebung dem Kontrakt an.",
        "<strong class='text-white'>Testen Sie es einmal in einem ruhigen Markt.</strong> Lösen Sie einen Wegwerf-Alarm nahe dem aktuellen Kurs aus und beobachten Sie genau, wo er meldet, bevor Sie ihm bei einem Live-Setup vertrauen.",
        "<strong class='text-white'>Melden Sie es dem Support.</strong> Die Verschiebung ist ein Workaround, keine Lösung. Schreiben Sie dem Support mit Instrument, Bedingung, Wert und Plattform, damit das Verhalten untersucht werden kann.",
        "<strong class='text-white'>Wenn Sie eine Aktion brauchen und keinen Signalton,</strong> werten Sie das Niveau in einer Charting-Plattform aus und leiten es als Order weiter, damit der Auslöser auf dem von Ihnen definierten Kurs feuert.",
      ],
    },
    { type: "heading",text: "Was tatsächlich passiert" },
    { type: "paragraph",html: "Jeder Tradovate-Alarm besteht aus drei Teilen: einem Preisniveau, einer Bedingung und einer Benachrichtigungsart. Setzen Sie einen Alarm über den aktuellen Kurs, lautet die Bedingung „größer oder gleich“ Ihrem Wert. Setzen Sie ihn darunter, lautet sie „kleiner oder gleich“. Der Teil „oder gleich“ ist der springende Punkt. Sie erwarten, dass der Alarm in dem Moment auslöst, in dem der Kurs die Zahl <em>berührt</em>, nicht einen Tick später." },
    { type: "paragraph",html: "In der Praxis berücksichtigen &gt;=- und &lt;=-Alarme den Gleichheitsfall nicht immer. Der Kurs kann genau Ihren Wert drucken, und der Alarm bleibt still. Er wacht erst auf, sobald ein Kurs einen Tick jenseits des Niveaus landet, in der Richtung, in der sich der Kurs ohnehin bewegte. Ein Aufwärtsalarm bei 5000.00 löst bei 5000.25 aus. Ein Abwärtsalarm bei 4980.00 löst bei 4979.75 aus. Die Bedingung verhält sich am Ende wie ein striktes „größer als“ oder „kleiner als“, obwohl der Operator „oder gleich“ sagt. Das wurde in der Desktop-App Trader und im mobilen Web beobachtet und tritt sporadisch statt konstant auf, weshalb man es leicht übersieht, bis es einen Einstieg kostet." },
    { type: "heading",text: "Warum ein „Oder-gleich“-Alarm die Gleichheit überspringt" },
    { type: "paragraph",html: "Sie brauchen die Interna nicht, um das zu beheben, aber zu wissen, warum es passiert, sagt Ihnen, wann Sie damit rechnen müssen. Mehrere Dinge greifen ineinander:" },
    { type: "heading",text: "Der Alarm beobachtet den letzten gehandelten Kurs" },
    { type: "paragraph",html: "Ein Preisalarm wertet in der Regel den letzten Kurs aus, der über das Tape lief, nicht den stehenden Bid oder Ask. Liegt Ihr Niveau zwischen zwei Trades, wird nie ein Kurs genau darauf gedruckt. Angenommen, der letzte Trade war 4999.75 und der nächste 5000.25. Der Markt hat 5000.00 klar passiert, aber nichts wurde je bei 5000.00 <em>gedruckt</em>, sodass eine Gleichheitsprüfung gegen den letzten Kurs erst dann einen Treffer sieht, wenn 5000.25 durchgeht. Das allein erzeugt ein Auslösen einen Tick zu spät." },
    { type: "heading",text: "Kurse werden abgetastet, nicht Tick für Tick gestreamt" },
    { type: "paragraph",html: "Die Plattform reicht nicht jede Mikro-Aktualisierung sofort an die Alarm-Engine weiter. Quote- und DOM-Daten werden gedrosselt aktualisiert, unter Last grob in der Größenordnung von einmal pro Sekunde. Berührt der Kurs Ihr exaktes Niveau und zieht zwischen zwei Abtastungen weiter, sieht die Alarm-Engine die Berührung schlicht nie. Sie sieht den „vorher“-Tick und den „nachher“-Tick, und der Nachher-Tick löst den Alarm aus." },
    { type: "heading",text: "Der Vergleich rundet in Richtung eines Überschreitens" },
    { type: "paragraph",html: "Zusammengenommen ergibt sich als effektives Verhalten ein Überschreiten, keine Berührung. Der Alarm löst zuverlässig aus, sobald der Kurs eindeutig über dem Niveau liegt, also einen Tick jenseits. Das ist auf seine Weise verlässlich, nur nicht das, was „oder gleich“ nahelegt, und deshalb funktioniert die Kompensation um genau einen Tick so sauber." },
    { type: "heading",text: "Die Ein-Tick-Lösung, Schritt für Schritt" },
    { type: "heading",text: "Schritt 1: Wissen Sie, von welcher Seite der Kurs kommt" },
    { type: "paragraph",html: "Die Richtung der Verschiebung hängt ganz davon ab, in welche Richtung sich der Kurs auf Ihr Niveau zubewegt. Ein Alarm über dem aktuellen Kurs ist ein Aufwärtsalarm (&gt;=); der Kurs steigt darauf zu, und der verspätete Tick liegt <em>über</em> Ihrem Wert. Ein Alarm unter dem aktuellen Kurs ist ein Abwärtsalarm (&lt;=); der Kurs fällt darauf zu, und der verspätete Tick liegt <em>unter</em> Ihrem Wert. Machen Sie sich das zuerst klar, denn eine Verschiebung in die falsche Richtung lässt den Alarm zwei Ticks daneben statt exakt auslösen." },
    { type: "heading",text: "Schritt 2: Verschieben Sie den Wert einen Tick in Richtung des Kurses" },
    { type: "paragraph",html: "Verschieben Sie den Alarmwert einen Tick auf die nahe Seite Ihres wahren Niveaus, sodass der zusätzliche Tick der Plattform ihn wieder auf das Niveau bringt, das Sie eigentlich meinen. Die Rechnung ist einfach, sobald die Richtung feststeht:" },
    { type: "table", headers: ["Alarmtyp","Bedingung","Ihr wahres Niveau","Alarm setzen auf"], rows: [
      ["Aufwärts (Kurs steigt heran)",">= (größer oder gleich)","5000.00","4999.75 (einen Tick darunter)"],
      ["Abwärts (Kurs fällt heran)","<= (kleiner oder gleich)","4980.00","4980.25 (einen Tick darüber)"],
    ] },
    { type: "paragraph",html: "Diese Beispiele verwenden ES, wo ein Tick 0.25 beträgt. Bei CL ist ein Tick 0.01, bei Gold (GC) 0.10, bei den Treasury-Kontrakten ein Bruchteil eines Punktes. Verschieben Sie immer um einen Tick des jeweiligen Kontrakts, nie um pauschal 0.25 oder eine runde Zahl. Wenn Sie die Tickgröße eines Instruments nicht kennen, fahren Sie über das DOM oder sehen Sie in der Kontraktspezifikation nach, bevor Sie die Zahl setzen." },
    { type: "heading",text: "Schritt 3: Setzen Sie den Alarm im Chart oder im DOM" },
    { type: "paragraph",html: "Platzieren Sie den Alarm so, wie Sie es gewohnt sind. Im Chart klicken Sie mit der rechten Maustaste auf das Preisniveau und wählen die Option zum Hinzufügen eines Alarms, dann legen Sie die Bedingung und den verschobenen Wert fest. Im DOM klicken Sie mit der rechten Maustaste auf die exakte Preiszelle und fügen den Alarm dort hinzu. Beide Wege erlauben die Eingabe des genauen Wertes, geben Sie also die kompensierte Zahl aus Schritt 2 ein statt des runden Niveaus. Wählen Sie mindestens eine Benachrichtigung, die Sie wirklich bemerken, mindestens Ton und Popup." },
    { type: "heading",text: "Schritt 4: Beweisen Sie es mit einem Wegwerf-Alarm" },
    { type: "paragraph",html: "Vertrauen Sie der Lösung nicht bei dem Setup, auf das es ankommt. Setzen Sie bei einem ruhigen, langsamen Kontrakt einen kompensierten Alarm ein paar Ticks vom aktuellen Kurs entfernt und beobachten Sie genau, wo er auslöst. Meldet er jetzt auf Ihrem beabsichtigten Niveau statt einen Tick darüber, funktioniert die Kompensation für dieses Instrument und diese Plattform. Liegt er immer noch einen Tick daneben, prüfen Sie die Richtung Ihrer Verschiebung und die Tickgröße noch einmal. Dieser einminütige Test ist weit mehr wert als jede Annahme." },
    { type: "heading",text: "Schritt 5: Verwalten und räumen Sie Alarme über die Glocke auf" },
    { type: "paragraph",html: "Öffnen Sie das Alerts-Symbol, die Glocke oben links im Arbeitsbereich neben dem New-Menü, um alle aktiven, ausgelösten und abgelaufenen Alarme an einem Ort zu sehen. Hier bearbeiten Sie einen Wert, wenn Sie in die falsche Richtung verschoben haben, löschen veraltete Alarme, die die Ansicht überladen, und prüfen, ob ein Alarm noch scharf ist und nicht schon verbraucht. Wenn ein Alarm auslöst, spielt der Browser einen Ton ab und die Glocke zeigt einen roten Punkt; halten Sie das Panel also griffbereit, während Sie die Lösung überprüfen." },
    { type: "heading",text: "Schritt 6: Melden Sie das Verhalten dem Support" },
    { type: "paragraph",html: "Die Verschiebung behandelt das Symptom, nicht die Ursache. Schreiben Sie an support@tradovate.com mit den Angaben, die es reproduzierbar machen: das genaue Instrument, die vollständige Bedingung und der Wert, die Plattform, auf der Sie es gesehen haben, und die schlichte Tatsache, dass ein &gt;=- oder &lt;=-Alarm erst einen Tick jenseits des Wertes ausgelöst hat. Nur eine konkrete Meldung macht aus „manche Trader sehen das“ ein verfolgtes Problem und ist der schnellste Weg zu einer eindeutigen Antwort, ob es erwartetes Verhalten oder ein Defekt ist." },
    { type: "heading",text: "Tabelle zur Fehlerbehebung" },
    { type: "table", headers: ["Symptom","Wahrscheinliche Ursache","Lösung"], rows: [
      [">=-Alarm löst einen Tick über Ihrem Wert aus","Gleichheitsfall übersprungen; verhält sich wie striktes Überschreiten","Alarm einen Tick unter Ihr Ziel setzen"],
      ["<=-Alarm löst einen Tick unter Ihrem Wert aus","Gleiches Überschreitungsverhalten in der Gegenrichtung","Alarm einen Tick über Ihr Ziel setzen"],
      ["Der kompensierte Alarm löst jetzt zwei Ticks daneben aus","In die falsche Richtung zur Kursbewegung verschoben","Verschiebung auf die Seite drehen, von der der Kurs kommt"],
      ["Der Alarm landet weit vom Niveau entfernt, nicht nur einen Tick","Verzögerter oder fehlender Datenfeed, nicht die Tick-Eigenheit","Bestätigen Sie, dass das Symbol Echtzeitkurse zeigt"],
      ["Der Alarm löst überhaupt nicht aus","Benachrichtigungen aus, Alarm verbraucht oder Niveau nie erreicht","Ton/Popup wieder aktivieren und den Alarm im Glockenpanel prüfen"],
      ["Sie brauchen einen Einstieg zum Kurs, keine Benachrichtigung","Der native Alarm ist ein Signalton, keine Aktion","Das Niveau in einem Chart-Skript auswerten und als Order weiterleiten"],
    ] },
    { type: "heading",text: "Wenn ein Ein-Tick-Alarm nicht gut genug ist" },
    { type: "paragraph",html: "Die Kompensation um einen Tick ist in Ordnung, wenn der Alarm nur ein Anstoß ist, auf den Bildschirm zu schauen. Doch viele Trader nutzen einen Preisalarm als Auslöser, um zu <em>handeln</em>: Niveau erreicht, Einstieg nehmen, Stop setzen. Sobald Ihre Reaktion der Trade ist, ist ein um einen Tick verspätetes Signal nicht mehr kosmetisch. Entweder Sie reagieren einen Tick zu spät, oder Sie greifen vor und hoffen. Genau diese Lücke lohnt es sich per Automatisierung zu schließen." },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Definieren Sie das Niveau dort, wo die Logik stark ist.</strong> Eine Charting-Plattform wie TradingView erlaubt Ihnen, die exakte Preisbedingung oder eine ganze Strategie auszudrücken und im selben Moment einen Webhook auszulösen, ohne Abhängigkeit von einem nativen Alarm, der einen Tick zu spät kommt.",
        "<strong class='text-white'>Leiten Sie es direkt an Tradovate.</strong> PickMyTrade nimmt diesen Webhook entgegen und handelt automatisch auf Ihrem Konto, sodass der „Alarm“ zu einer Order auf dem von Ihnen gesetzten Niveau wird statt zu einem Signalton, den Sie noch beantworten müssen.",
        "<strong class='text-white'>Spiegeln Sie über mehrere Konten.</strong> Ein Auslöser kann mehrere Evaluierungs- oder Funded-Konten gleichzeitig steuern, sodass Sie nicht auf jedem Bildschirm einen tick-empfindlichen Alarm manuell neu scharf stellen.",
        "<strong class='text-white'>Ratenlimit-sicheres Routing.</strong> Der Orderfluss wird so getaktet, dass er innerhalb der Anfragelimits von Tradovate bleibt, und vermeidet Wiederholungsstürme, die eigene Sperren verursachen.",
      ],
    },
    { type: "paragraph",html: "Behalten Sie native Alarme für Niveaus, bei denen Ihr Blick auf dem Bildschirm ist und ein Tick keine Rolle spielt, und übergeben Sie die kursgenauen Auslöser an eine Pipeline, die auf der Zahl feuert, die Sie tatsächlich gewählt haben." },
  ], es: [
    { type: "paragraph",html: "Fija una alerta para exactamente 5000.00 al alza. El precio imprime 5000.00, se queda ahí un segundo y su campana permanece en silencio. Luego pasa un solo tick en 5000.25 y solo <em>ahora</em> suena el aviso. La alerta no falló y usted no la construyó mal. Una alerta de mayor o igual, o de menor o igual, en Tradovate puede comportarse como un cruce en lugar de un toque exacto, de modo que salta un tick más allá del valor que escribió en vez de justo en él. Para una alerta swing lenta es un error de redondeo. Para una entrada de scalping o un nivel de ruptura ajustado, ese tick es la diferencia entre llegar pronto y perseguir. Aquí le explicamos qué ocurre bajo el capó y el truco del tick que hace que la alerta salte exactamente donde usted quiere." },
    {
      type: "checklist",
      heading: "La solución rápida",
      items: [
        "<strong class='text-white'>Desplace la alerta un tick hacia el precio.</strong> Para una alerta al alza (&gt;=), fíjela un tick <em>por debajo</em> de su objetivo. Para una alerta a la baja (&lt;=), fíjela un tick <em>por encima</em> de su objetivo. El tick extra que añade la plataforma le devuelve entonces a su nivel real.",
        "<strong class='text-white'>Use el tamaño de tick de su instrumento, no un número redondo.</strong> Un tick en ES/MES es 0.25. El crudo (CL) es 0.01. NQ/MNQ es 0.25. Ajuste el desplazamiento al contrato.",
        "<strong class='text-white'>Pruébelo una vez en un mercado lento.</strong> Dispare una alerta de prueba cerca del precio actual y observe exactamente dónde suena antes de fiarse de ella en una configuración real.",
        "<strong class='text-white'>Infórmelo al soporte.</strong> El desplazamiento es una solución provisional, no un arreglo. Escriba al soporte con el instrumento, la condición, el valor y la plataforma para que se pueda investigar el comportamiento.",
        "<strong class='text-white'>Si necesita una acción y no un timbre,</strong> evalúe el nivel en una plataforma de gráficos y envíelo como orden para que el disparador salte en el precio que usted definió.",
      ],
    },
    { type: "heading",text: "Qué está ocurriendo realmente" },
    { type: "paragraph",html: "Toda alerta de Tradovate tiene tres partes: un nivel de precio, una condición y un tipo de notificación. Cuando coloca una alerta por encima del precio actual, la condición es «mayor o igual que» su valor. Si la coloca por debajo, es «menor o igual que». La parte «o igual» es todo el sentido. Espera que la alerta salte en el momento en que el precio <em>toca</em> el número, no un tick después." },
    { type: "paragraph",html: "En la práctica, las alertas &gt;= y &lt;= no siempre respetan el caso de igualdad. El precio puede imprimir exactamente su valor y la alerta permanece en silencio. Solo despierta cuando una impresión cae un tick más allá del nivel, en la dirección en que ya se movía el precio. Una alerta al alza en 5000.00 salta en 5000.25. Una alerta a la baja en 4980.00 salta en 4979.75. La condición acaba actuando como un estricto «mayor que» o «menor que», aunque el operador diga «o igual». Se ha observado en la app de escritorio Trader y en la web móvil, y es intermitente en lugar de constante, lo que precisamente hace que sea fácil pasarlo por alto hasta que le cuesta una entrada." },
    { type: "heading",text: "Por qué una alerta «o igual» se salta la igualdad" },
    { type: "paragraph",html: "No necesita conocer los entresijos para solucionarlo, pero saber por qué ocurre le indica cuándo esperarlo. Se alinean varios factores:" },
    { type: "heading",text: "La alerta vigila el último precio negociado" },
    { type: "paragraph",html: "Una alerta de precio suele evaluarse contra la última impresión que cruzó la cinta, no contra el bid o el ask en reposo. Si su nivel queda entre dos operaciones, nunca se imprime ningún precio exactamente en él. Digamos que la última operación fue 4999.75 y la siguiente 5000.25. El mercado claramente pasó 5000.00, pero nada se <em>imprimió</em> nunca en 5000.00, así que una comprobación de igualdad contra el último precio no ve ninguna coincidencia hasta que pasa 5000.25. Eso por sí solo produce un disparo un tick tarde." },
    { type: "heading",text: "Las cotizaciones se muestrean, no se transmiten tick a tick" },
    { type: "paragraph",html: "La plataforma no entrega al motor de alertas cada microactualización al instante. Los datos de cotización y DOM se refrescan con una limitación, aproximadamente del orden de una vez por segundo bajo carga. Si el precio roza su nivel exacto y se va entre dos muestras, el motor de alertas sencillamente nunca ve el toque. Ve el tick «antes» y el tick «después», y es el tick posterior el que dispara la alerta." },
    { type: "heading",text: "La comparación se redondea hacia un cruce" },
    { type: "paragraph",html: "Si junta todo esto, el comportamiento efectivo es un cruce, no un toque. La alerta salta de forma fiable cuando el precio está inequívocamente más allá del nivel, es decir, un tick más allá. Es fiable a su manera, solo que no es lo que implica «o igual», y por eso compensar exactamente un tick funciona tan limpiamente." },
    { type: "heading",text: "La solución del tick, paso a paso" },
    { type: "heading",text: "Paso 1: Sepa de qué lado viene el precio" },
    { type: "paragraph",html: "La dirección del desplazamiento depende por completo de hacia dónde viaja el precio al llegar a su nivel. Una alerta colocada por encima del precio actual es una alerta al alza (&gt;=); el precio sube hacia ella y el tick tardío cae <em>por encima</em> de su valor. Una alerta colocada por debajo del precio actual es una alerta a la baja (&lt;=); el precio baja hacia ella y el tick tardío cae <em>por debajo</em> de su valor. Tenga esto claro primero, porque desplazar en el sentido equivocado hace que la alerta salte dos ticks desviada en lugar de cero." },
    { type: "heading",text: "Paso 2: Mueva el valor un tick hacia el precio" },
    { type: "paragraph",html: "Desplace el valor de la alerta un tick al lado cercano de su nivel real, de modo que el tick extra de la plataforma lo devuelva al nivel que realmente le importa. La cuenta es sencilla una vez fijada la dirección:" },
    { type: "table", headers: ["Tipo de alerta","Condición","Su nivel real","Fije la alerta en"], rows: [
      ["Al alza (el precio sube hacia ella)",">= (mayor o igual)","5000.00","4999.75 (un tick por debajo)"],
      ["A la baja (el precio baja hacia ella)","<= (menor o igual)","4980.00","4980.25 (un tick por encima)"],
    ] },
    { type: "paragraph",html: "Estos ejemplos usan ES, donde un tick es 0.25. En CL un tick es 0.01, en el oro (GC) es 0.10, y en los contratos del Tesoro es una fracción de punto. Desplace siempre un tick del contrato concreto, nunca un 0.25 fijo ni una cifra redonda. Si no está seguro del tamaño de tick de un instrumento, pase el cursor por el DOM o consulte las especificaciones del contrato antes de fijar el número." },
    { type: "heading",text: "Paso 3: Fije la alerta en el gráfico o en el DOM" },
    { type: "paragraph",html: "Coloque la alerta como lo hace normalmente. En un gráfico, haga clic derecho en el nivel de precio y elija la opción de añadir alerta, luego fije la condición y el valor desplazado. En el DOM, haga clic derecho en la celda de precio exacta y añada la alerta allí. Ambos caminos le permiten escribir el valor preciso, así que introduzca el número compensado del paso 2 en lugar del nivel redondo. Elija al menos una notificación que de verdad note, como mínimo sonido y ventana emergente." },
    { type: "heading",text: "Paso 4: Compruébelo con una alerta de prueba" },
    { type: "paragraph",html: "No se fíe de la solución en la configuración que importa. En un contrato tranquilo y de movimiento lento, fije una alerta compensada a unos pocos ticks del precio actual y observe con precisión dónde salta. Si ahora avisa en su nivel previsto en lugar de un tick más allá, la compensación funciona para ese instrumento y esa plataforma. Si aún cae un tick desviada, revise la dirección de su desplazamiento y el tamaño de tick. Esta prueba de un minuto vale mucho más que suponerlo." },
    { type: "heading",text: "Paso 5: Gestione y limpie las alertas desde la campana" },
    { type: "paragraph",html: "Abra el icono de Alerts, la campana en la parte superior izquierda del espacio de trabajo junto al menú New, para ver todas las alertas activas, disparadas y caducadas en un solo lugar. Aquí edita un valor si desplazó en el sentido equivocado, elimina alertas obsoletas que saturan la vista y confirma que una alerta sigue armada y no ya consumida. Cuando una alerta salta, el navegador reproduce un sonido y la campana muestra un punto rojo, así que tenga el panel a mano mientras verifica la solución." },
    { type: "heading",text: "Paso 6: Informe del comportamiento al soporte" },
    { type: "paragraph",html: "El desplazamiento parchea el síntoma, no la causa. Escriba a support@tradovate.com con los detalles que lo hacen reproducible: el instrumento exacto, la condición y el valor completos, la plataforma en la que lo vio y el hecho simple de que una alerta &gt;= o &lt;= solo saltó un tick más allá del valor. Un informe concreto es lo único que convierte «algunos traders ven esto» en una incidencia con seguimiento, y es la vía más rápida hacia una respuesta definitiva sobre si es un comportamiento esperado o un defecto." },
    { type: "heading",text: "Tabla de solución de problemas" },
    { type: "table", headers: ["Síntoma","Causa probable","Solución"], rows: [
      ["La alerta >= salta un tick por encima de su valor","Se omite el caso de igualdad; se comporta como un cruce estricto","Fije la alerta un tick por debajo de su nivel objetivo"],
      ["La alerta <= salta un tick por debajo de su valor","El mismo comportamiento de cruce a la baja","Fije la alerta un tick por encima de su nivel objetivo"],
      ["La alerta compensada ahora salta dos ticks desviada","Se desplazó en el sentido equivocado según el recorrido del precio","Invierta el desplazamiento hacia el lado del que viene el precio"],
      ["La alerta cae lejos del nivel, no solo un tick","Feed de datos retrasado o ausente, no la rareza del tick","Confirme que el símbolo muestra cotizaciones en tiempo real"],
      ["La alerta no salta nunca","Notificaciones desactivadas, alerta consumida o nivel nunca alcanzado","Reactive sonido/ventana emergente y revise la alerta en el panel de la campana"],
      ["Necesita una entrada al precio, no una notificación","La alerta nativa es un timbre, no una acción","Evalúe el nivel en un script del gráfico y envíelo como orden"],
    ] },
    { type: "heading",text: "Cuando una alerta con un tick de desfase no es suficiente" },
    { type: "paragraph",html: "Compensar con un tick está bien cuando la alerta es solo un aviso para mirar la pantalla. Pero muchos traders usan una alerta de precio como disparador para <em>actuar</em>: alcanzar el nivel, tomar la entrada, armar el stop. En cuanto su reacción es la operación, un aviso con un tick de retraso deja de ser cosmético. O reacciona un tick tarde, o se adelanta y espera. Ese es el hueco que vale la pena cerrar con automatización." },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Defina el nivel donde la lógica es sólida.</strong> Una plataforma de gráficos como TradingView le permite expresar la condición de precio exacta, o una estrategia completa, y lanzar un webhook en cuanto se cumple, sin depender de una alerta nativa que llega un tick tarde.",
        "<strong class='text-white'>Envíelo directamente a Tradovate.</strong> PickMyTrade recoge ese webhook y actúa en su cuenta automáticamente, de modo que la «alerta» se convierte en una orden en el nivel que usted fijó en lugar de un timbre al que todavía tiene que responder.",
        "<strong class='text-white'>Replique entre cuentas.</strong> Un solo disparador puede mover varias cuentas de evaluación o fondeadas a la vez, así que no tiene que rearmar manualmente una alerta sensible al tick en cada pantalla.",
        "<strong class='text-white'>Enrutamiento seguro frente a límites de frecuencia.</strong> El flujo de órdenes se espacia para mantenerse dentro de los límites de peticiones de Tradovate, evitando las tormentas de reintentos que causan sus propios bloqueos.",
      ],
    },
    { type: "paragraph",html: "Reserve las alertas nativas para niveles en los que está pendiente de la pantalla y un tick no importa, y entregue los disparadores precisos a un flujo que se ejecute en el número que usted eligió realmente." },
  ], fr: [
    { type: "paragraph",html: "Vous fixez une alerte à exactement 5000.00 à la hausse. Le prix s'imprime à 5000.00, y reste une seconde, et votre cloche reste muette. Puis un seul tick à 5000.25 passe et ce n'est qu'<em>à ce moment</em> que le son retentit. L'alerte n'a rien manqué, et vous ne l'avez pas mal construite. Une alerte « supérieur ou égal » ou « inférieur ou égal » sur Tradovate peut se comporter comme un franchissement plutôt que comme un contact exact, de sorte qu'elle se déclenche un tick au-delà de la valeur saisie au lieu d'exactement à celle-ci. Pour une alerte swing lente, c'est une erreur d'arrondi. Pour une entrée de scalp ou un niveau de cassure serré, ce tick fait toute la différence entre être en avance et courir après le marché. Voici ce qui se passe sous le capot et l'astuce du tick qui fait atterrir l'alerte exactement où vous le souhaitez." },
    {
      type: "checklist",
      heading: "La solution rapide",
      items: [
        "<strong class='text-white'>Décalez l'alerte d'un tick vers le prix.</strong> Pour une alerte à la hausse (&gt;=), fixez-la un tick <em>sous</em> votre cible. Pour une alerte à la baisse (&lt;=), fixez-la un tick <em>au-dessus</em> de votre cible. Le tick supplémentaire ajouté par la plateforme vous ramène alors à votre vrai niveau.",
        "<strong class='text-white'>Utilisez la taille de tick de votre instrument, pas un nombre rond.</strong> Un tick sur ES/MES vaut 0.25. Le pétrole brut (CL) vaut 0.01. NQ/MNQ vaut 0.25. Adaptez le décalage au contrat.",
        "<strong class='text-white'>Testez-le une fois sur un marché calme.</strong> Déclenchez une alerte jetable près du prix actuel et observez exactement où elle sonne avant de vous y fier sur une configuration réelle.",
        "<strong class='text-white'>Signalez-le au support.</strong> Le décalage est un contournement, pas une correction. Écrivez au support avec l'instrument, la condition, la valeur et la plateforme afin que le comportement puisse être examiné.",
        "<strong class='text-white'>Si vous avez besoin d'une action et non d'un carillon,</strong> évaluez le niveau dans une plateforme de graphiques et acheminez-le sous forme d'ordre afin que le déclencheur se produise au prix que vous avez défini.",
      ],
    },
    { type: "heading",text: "Ce qui se passe réellement" },
    { type: "paragraph",html: "Chaque alerte Tradovate comprend trois parties : un niveau de prix, une condition et un type de notification. Lorsque vous placez une alerte au-dessus du prix actuel, la condition est « supérieur ou égal à » votre valeur. En dessous, c'est « inférieur ou égal à ». Le « ou égal » est tout l'intérêt. Vous vous attendez à ce que l'alerte se déclenche au moment où le prix <em>touche</em> le nombre, pas un tick plus tard." },
    { type: "paragraph",html: "En pratique, les alertes &gt;= et &lt;= ne respectent pas toujours le cas d'égalité. Le prix peut s'imprimer exactement à votre valeur et l'alerte reste silencieuse. Elle ne se réveille que lorsqu'une impression tombe un tick au-delà du niveau, dans la direction que le prix suivait déjà. Une alerte à la hausse à 5000.00 se déclenche à 5000.25. Une alerte à la baisse à 4980.00 se déclenche à 4979.75. La condition finit par agir comme un « strictement supérieur » ou « strictement inférieur », même si l'opérateur dit « ou égal à ». Cela a été observé sur l'application de bureau Trader et sur le web mobile, et c'est intermittent plutôt que constant, ce qui le rend facile à manquer jusqu'à ce qu'il vous coûte une entrée." },
    { type: "heading",text: "Pourquoi une alerte « ou égal à » saute l'égalité" },
    { type: "paragraph",html: "Vous n'avez pas besoin des détails internes pour corriger cela, mais savoir pourquoi cela se produit vous indique quand vous y attendre. Plusieurs éléments s'alignent :" },
    { type: "heading",text: "L'alerte surveille le dernier prix négocié" },
    { type: "paragraph",html: "Une alerte de prix s'évalue généralement par rapport à la dernière impression qui a traversé le tape, et non par rapport au bid ou à l'ask en attente. Si votre niveau se situe entre deux transactions, aucune impression ne tombe jamais exactement dessus. Disons que la dernière transaction était à 4999.75 et la suivante à 5000.25. Le marché a clairement dépassé 5000.00, mais rien ne s'est jamais <em>imprimé</em> à 5000.00 ; un test d'égalité sur le dernier prix ne voit donc aucune correspondance tant que 5000.25 ne passe pas. Cela suffit à produire un déclenchement un tick trop tard." },
    { type: "heading",text: "Les cotations sont échantillonnées, pas diffusées tick par tick" },
    { type: "paragraph",html: "La plateforme ne transmet pas instantanément chaque micro-mise à jour au moteur d'alertes. Les données de cotation et de DOM se rafraîchissent avec une limitation, de l'ordre d'une fois par seconde environ en charge. Si le prix effleure votre niveau exact et repart entre deux échantillons, le moteur d'alertes ne voit tout simplement jamais le contact. Il voit le tick « avant » et le tick « après », et c'est le tick « après » qui déclenche l'alerte." },
    { type: "heading",text: "La comparaison s'arrondit vers un franchissement" },
    { type: "paragraph",html: "Mettez tout cela ensemble et le comportement effectif est un franchissement, pas un contact. L'alerte se déclenche de façon fiable une fois que le prix a clairement dépassé le niveau, c'est-à-dire un tick au-delà. C'est fiable à sa manière, simplement ce n'est pas ce que « ou égal à » laisse entendre, et c'est pourquoi la compensation d'exactement un tick fonctionne si bien." },
    { type: "heading",text: "La correction d'un tick, pas à pas" },
    { type: "heading",text: "Étape 1 : Sachez d'où vient le prix" },
    { type: "paragraph",html: "La direction du décalage dépend entièrement du sens dans lequel le prix voyage vers votre niveau. Une alerte placée au-dessus du prix actuel est une alerte à la hausse (&gt;=) ; le prix monte vers elle et le tick tardif tombe <em>au-dessus</em> de votre valeur. Une alerte placée sous le prix actuel est une alerte à la baisse (&lt;=) ; le prix descend vers elle et le tick tardif tombe <em>en dessous</em> de votre valeur. Clarifiez cela d'abord, car décaler dans le mauvais sens fait déclencher l'alerte avec deux ticks d'écart au lieu de zéro." },
    { type: "heading",text: "Étape 2 : Déplacez la valeur d'un tick vers le prix" },
    { type: "paragraph",html: "Décalez la valeur de l'alerte d'un tick sur le côté proche de votre vrai niveau, de sorte que le tick supplémentaire de la plateforme vous ramène au niveau qui vous importe réellement. Le calcul est simple une fois la direction fixée :" },
    { type: "table", headers: ["Type d'alerte","Condition","Votre vrai niveau","Fixez l'alerte à"], rows: [
      ["À la hausse (le prix monte vers elle)",">= (supérieur ou égal)","5000.00","4999.75 (un tick en dessous)"],
      ["À la baisse (le prix descend vers elle)","<= (inférieur ou égal)","4980.00","4980.25 (un tick au-dessus)"],
    ] },
    { type: "paragraph",html: "Ces exemples utilisent ES, où un tick vaut 0.25. Sur CL un tick vaut 0.01, sur l'or (GC) 0.10, et sur les contrats du Trésor c'est une fraction de point. Décalez toujours d'un tick du contrat concerné, jamais d'un 0.25 fixe ni d'un chiffre rond. Si vous n'êtes pas sûr de la taille de tick d'un instrument, survolez le DOM ou consultez les spécifications du contrat avant de fixer le nombre." },
    { type: "heading",text: "Étape 3 : Définissez l'alerte sur le graphique ou le DOM" },
    { type: "paragraph",html: "Placez l'alerte comme vous le faites habituellement. Sur un graphique, faites un clic droit sur le niveau de prix et choisissez l'option d'ajout d'alerte, puis définissez la condition et la valeur décalée. Sur le DOM, faites un clic droit sur la cellule de prix exacte et ajoutez l'alerte à cet endroit. Les deux chemins vous permettent de saisir la valeur précise ; saisissez donc le nombre compensé de l'étape 2 plutôt que le niveau rond. Choisissez au moins une notification que vous remarquerez vraiment, son et fenêtre contextuelle au minimum." },
    { type: "heading",text: "Étape 4 : Prouvez-le avec une alerte jetable" },
    { type: "paragraph",html: "Ne faites pas confiance à la correction sur la configuration qui compte. Sur un contrat calme et lent, fixez une alerte compensée à quelques ticks du prix actuel et observez précisément où elle se déclenche. Si elle sonne désormais à votre niveau prévu au lieu d'un tick au-delà, la compensation fonctionne pour cet instrument et cette plateforme. Si elle tombe encore un tick à côté, vérifiez à nouveau la direction de votre décalage et la taille du tick. Ce test d'une minute vaut bien plus que de supposer." },
    { type: "heading",text: "Étape 5 : Gérez et nettoyez les alertes depuis la cloche" },
    { type: "paragraph",html: "Ouvrez l'icône Alerts, la cloche en haut à gauche de l'espace de travail à côté du menu New, pour voir en un seul endroit toutes les alertes actives, déclenchées et expirées. C'est ici que vous modifiez une valeur si vous avez décalé dans le mauvais sens, supprimez les alertes périmées qui encombrent la vue et vérifiez qu'une alerte est toujours armée plutôt que déjà consommée. Lorsqu'une alerte se déclenche, le navigateur émet un son et la cloche affiche un point rouge ; gardez donc le panneau à portée de main pendant que vous vérifiez la correction." },
    { type: "heading",text: "Étape 6 : Signalez le comportement au support" },
    { type: "paragraph",html: "Le décalage corrige le symptôme, pas la cause. Écrivez à support@tradovate.com avec les détails qui le rendent reproductible : l'instrument exact, la condition et la valeur complètes, la plateforme sur laquelle vous l'avez constaté, et le simple fait qu'une alerte &gt;= ou &lt;= ne s'est déclenchée qu'un tick au-delà de la valeur. Un signalement précis est la seule chose qui transforme « certains traders constatent cela » en problème suivi, et c'est le moyen le plus rapide d'obtenir une réponse définitive sur le caractère attendu ou défectueux du comportement." },
    { type: "heading",text: "Tableau de dépannage" },
    { type: "table", headers: ["Symptôme","Cause probable","Solution"], rows: [
      ["L'alerte >= se déclenche un tick au-dessus de votre valeur","Cas d'égalité ignoré ; se comporte comme un franchissement strict","Fixez l'alerte un tick sous votre niveau cible"],
      ["L'alerte <= se déclenche un tick en dessous de votre valeur","Même comportement de franchissement à la baisse","Fixez l'alerte un tick au-dessus de votre niveau cible"],
      ["L'alerte compensée se déclenche maintenant avec deux ticks d'écart","Décalage dans le mauvais sens par rapport au trajet du prix","Inversez le décalage du côté d'où vient le prix"],
      ["L'alerte tombe loin du niveau, pas seulement d'un tick","Flux de données retardé ou absent, pas la particularité du tick","Vérifiez que le symbole affiche des cotations en temps réel"],
      ["L'alerte ne se déclenche jamais","Notifications désactivées, alerte consommée ou niveau jamais atteint","Réactivez le son/la fenêtre contextuelle et vérifiez l'alerte dans le panneau de la cloche"],
      ["Vous avez besoin d'une entrée au prix, pas d'une notification","L'alerte native est un carillon, pas une action","Évaluez le niveau dans un script de graphique et acheminez-le sous forme d'ordre"],
    ] },
    { type: "heading",text: "Quand une alerte à un tick près ne suffit pas" },
    { type: "paragraph",html: "Compenser d'un tick convient quand l'alerte n'est qu'un coup de coude pour regarder l'écran. Mais beaucoup de traders utilisent une alerte de prix comme déclencheur pour <em>agir</em> : atteindre le niveau, prendre l'entrée, armer le stop. Dès que votre réaction est le trade, un signal en retard d'un tick n'est plus cosmétique. Soit vous réagissez un tick en retard, soit vous anticipez en espérant. C'est cet écart qu'il vaut la peine de combler par l'automatisation." },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Définissez le niveau là où la logique est solide.</strong> Une plateforme de graphiques comme TradingView vous permet d'exprimer la condition de prix exacte, ou une stratégie complète, et de déclencher un webhook à l'instant où elle est remplie, sans dépendre d'une alerte native qui arrive un tick trop tard.",
        "<strong class='text-white'>Acheminez-le directement vers Tradovate.</strong> PickMyTrade reçoit ce webhook et agit automatiquement sur votre compte, de sorte que l'« alerte » devient un ordre au niveau que vous avez fixé plutôt qu'un carillon auquel vous devez encore répondre.",
        "<strong class='text-white'>Répliquez sur plusieurs comptes.</strong> Un seul déclencheur peut piloter plusieurs comptes d'évaluation ou financés à la fois, de sorte que vous n'avez pas à réarmer manuellement une alerte sensible au tick sur chaque écran.",
        "<strong class='text-white'>Acheminement respectueux des limites de débit.</strong> Le flux d'ordres est espacé pour rester dans les limites de requêtes de Tradovate, évitant les tempêtes de relances qui provoquent leurs propres verrouillages.",
      ],
    },
    { type: "paragraph",html: "Gardez les alertes natives pour les niveaux où vous avez les yeux sur l'écran et où un tick n'a pas d'importance, et confiez les déclencheurs précis au tick à un pipeline qui se déclenche sur le nombre que vous avez réellement choisi." },
  ], it: [
    { type: "paragraph",html: "Imposta un alert per esattamente 5000.00 in salita. Il prezzo stampa 5000.00, ci resta un secondo e la Sua campanella rimane muta. Poi passa un solo tick a 5000.25 e solo <em>adesso</em> il suono parte. L'alert non ha mancato nulla e Lei non l'ha costruito male. Un alert «maggiore o uguale» o «minore o uguale» su Tradovate può comportarsi come un attraversamento anziché come un tocco esatto, quindi scatta un tick oltre il valore digitato invece che esattamente su di esso. Per un lento alert swing è un errore di arrotondamento. Per un ingresso scalp o un livello di breakout stretto, quel tick è la differenza tra essere in anticipo e inseguire. Ecco che cosa accade sotto il cofano e il trucco del tick che fa scattare l'alert esattamente dove vuole." },
    {
      type: "checklist",
      heading: "La soluzione rapida",
      items: [
        "<strong class='text-white'>Sposti l'alert di un tick verso il prezzo.</strong> Per un alert al rialzo (&gt;=), lo imposti un tick <em>sotto</em> il Suo obiettivo. Per un alert al ribasso (&lt;=), lo imposti un tick <em>sopra</em> il Suo obiettivo. Il tick extra aggiunto dalla piattaforma La riporta allora sul Suo vero livello.",
        "<strong class='text-white'>Usi la dimensione del tick del Suo strumento, non un numero tondo.</strong> Un tick su ES/MES è 0.25. Il greggio (CL) è 0.01. NQ/MNQ è 0.25. Adatti lo spostamento al contratto.",
        "<strong class='text-white'>Lo provi una volta su un mercato lento.</strong> Faccia scattare un alert di prova vicino al prezzo corrente e osservi esattamente dove suona prima di fidarsene su un setup reale.",
        "<strong class='text-white'>Lo segnali al supporto.</strong> Lo spostamento è un rimedio, non una correzione. Scriva al supporto con strumento, condizione, valore e piattaforma, così il comportamento può essere esaminato.",
        "<strong class='text-white'>Se Le serve un'azione e non un suono,</strong> valuti il livello in una piattaforma di grafici e lo inoltri come ordine, così l'innesco scatta sul prezzo che ha definito.",
      ],
    },
    { type: "heading",text: "Che cosa succede davvero" },
    { type: "paragraph",html: "Ogni alert di Tradovate ha tre parti: un livello di prezzo, una condizione e un tipo di notifica. Quando colloca un alert sopra il prezzo corrente, la condizione è «maggiore o uguale a» il Suo valore. Se lo colloca sotto, è «minore o uguale a». La parte «o uguale» è tutto il punto. Si aspetta che l'alert scatti nel momento in cui il prezzo <em>tocca</em> il numero, non un tick dopo." },
    { type: "paragraph",html: "In pratica, gli alert &gt;= e &lt;= non sempre rispettano il caso di uguaglianza. Il prezzo può stampare esattamente il Suo valore e l'alert resta silenzioso. Si risveglia solo quando una stampa cade un tick oltre il livello, nella direzione in cui il prezzo si stava già muovendo. Un alert al rialzo a 5000.00 scatta a 5000.25. Un alert al ribasso a 4980.00 scatta a 4979.75. La condizione finisce per agire come un rigoroso «maggiore di» o «minore di», anche se l'operatore dice «o uguale a». È stato osservato sull'app desktop Trader e sul web mobile, ed è intermittente anziché costante, il che lo rende facile da non notare finché non Le costa un ingresso." },
    { type: "heading",text: "Perché un alert «o uguale a» salta l'uguaglianza" },
    { type: "paragraph",html: "Non servono i dettagli interni per risolvere, ma sapere perché accade Le dice quando aspettarselo. Diversi elementi si allineano:" },
    { type: "heading",text: "L'alert osserva l'ultimo prezzo negoziato" },
    { type: "paragraph",html: "Un alert di prezzo viene in genere valutato rispetto all'ultima stampa che ha attraversato il tape, non rispetto a bid o ask in attesa. Se il Suo livello cade tra due operazioni, nessuna stampa avviene mai esattamente su di esso. Mettiamo che l'ultima operazione fosse 4999.75 e la successiva 5000.25. Il mercato ha chiaramente superato 5000.00, ma nulla è mai stato <em>stampato</em> a 5000.00, quindi un controllo di uguaglianza sull'ultimo prezzo non vede alcuna corrispondenza finché non passa 5000.25. Già questo produce uno scatto in ritardo di un tick." },
    { type: "heading",text: "Le quotazioni sono campionate, non trasmesse tick per tick" },
    { type: "paragraph",html: "La piattaforma non consegna istantaneamente ogni micro-aggiornamento al motore degli alert. I dati di quotazione e del DOM si aggiornano con una limitazione, all'incirca nell'ordine di una volta al secondo sotto carico. Se il prezzo sfiora il Suo livello esatto e riparte tra due campioni, il motore degli alert semplicemente non vede mai il tocco. Vede il tick «prima» e il tick «dopo», ed è il tick dopo a far scattare l'alert." },
    { type: "heading",text: "Il confronto si arrotonda verso un attraversamento" },
    { type: "paragraph",html: "Metta insieme tutto questo e il comportamento effettivo è un attraversamento, non un tocco. L'alert scatta in modo affidabile una volta che il prezzo è inequivocabilmente oltre il livello, cioè un tick più in là. È affidabile a modo suo, solo che non è ciò che «o uguale a» fa intendere, ed è per questo che compensare esattamente un tick funziona così bene." },
    { type: "heading",text: "La correzione di un tick, passo dopo passo" },
    { type: "heading",text: "Passo 1: Sappia da quale lato arriva il prezzo" },
    { type: "paragraph",html: "La direzione dello spostamento dipende interamente dal verso in cui il prezzo viaggia verso il Suo livello. Un alert collocato sopra il prezzo corrente è un alert al rialzo (&gt;=); il prezzo sale verso di esso e il tick in ritardo cade <em>sopra</em> il Suo valore. Un alert collocato sotto il prezzo corrente è un alert al ribasso (&lt;=); il prezzo scende verso di esso e il tick in ritardo cade <em>sotto</em> il Suo valore. Chiarisca questo punto per primo, perché spostare nel verso sbagliato fa scattare l'alert con due tick di scarto invece di zero." },
    { type: "heading",text: "Passo 2: Sposti il valore di un tick verso il prezzo" },
    { type: "paragraph",html: "Sposti il valore dell'alert di un tick sul lato vicino del Suo vero livello, in modo che il tick extra della piattaforma lo riporti sul livello che Le interessa davvero. Il calcolo è semplice una volta fissata la direzione:" },
    { type: "table", headers: ["Tipo di alert","Condizione","Il Suo vero livello","Imposti l'alert a"], rows: [
      ["Al rialzo (prezzo che sale verso di esso)",">= (maggiore o uguale)","5000.00","4999.75 (un tick sotto)"],
      ["Al ribasso (prezzo che scende verso di esso)","<= (minore o uguale)","4980.00","4980.25 (un tick sopra)"],
    ] },
    { type: "paragraph",html: "Questi esempi usano ES, dove un tick è 0.25. Su CL un tick è 0.01, sull'oro (GC) è 0.10, sui contratti del Tesoro è una frazione di punto. Sposti sempre di un tick del contratto specifico, mai di un 0.25 fisso o di una cifra tonda. Se non è sicuro della dimensione del tick di uno strumento, passi il cursore sul DOM o controlli le specifiche del contratto prima di impostare il numero." },
    { type: "heading",text: "Passo 3: Imposti l'alert sul grafico o sul DOM" },
    { type: "paragraph",html: "Collochi l'alert nel modo in cui lo fa di solito. Su un grafico, faccia clic con il tasto destro sul livello di prezzo e scelga l'opzione per aggiungere un alert, poi imposti la condizione e il valore spostato. Sul DOM, faccia clic con il tasto destro sulla cella di prezzo esatta e aggiunga lì l'alert. Entrambi i percorsi permettono di digitare il valore preciso, quindi inserisca il numero compensato del passo 2 anziché il livello tondo. Scelga almeno una notifica che noterà davvero, almeno suono e popup." },
    { type: "heading",text: "Passo 4: Lo verifichi con un alert di prova" },
    { type: "paragraph",html: "Non si fidi della correzione sul setup che conta. Su un contratto tranquillo e lento, imposti un alert compensato a pochi tick dal prezzo corrente e osservi con precisione dove scatta. Se ora suona sul livello previsto anziché un tick oltre, la compensazione funziona per quello strumento e quella piattaforma. Se cade ancora un tick fuori, ricontrolli la direzione dello spostamento e la dimensione del tick. Questo test di un minuto vale molto più di una supposizione." },
    { type: "heading",text: "Passo 5: Gestisca e ripulisca gli alert dalla campanella" },
    { type: "paragraph",html: "Apra l'icona Alerts, la campanella in alto a sinistra nell'area di lavoro accanto al menu New, per vedere in un unico posto tutti gli alert attivi, scattati e scaduti. È qui che modifica un valore se ha spostato nel verso sbagliato, elimina gli alert obsoleti che ingombrano la vista e conferma che un alert sia ancora armato e non già consumato. Quando un alert scatta, il browser riproduce un suono e la campanella mostra un puntino rosso; tenga quindi il pannello a portata di mano mentre verifica la correzione." },
    { type: "heading",text: "Passo 6: Segnali il comportamento al supporto" },
    { type: "paragraph",html: "Lo spostamento tampona il sintomo, non la causa. Scriva a support@tradovate.com con i dettagli che lo rendono riproducibile: lo strumento esatto, la condizione e il valore completi, la piattaforma su cui l'ha visto e il semplice fatto che un alert &gt;= o &lt;= è scattato solo un tick oltre il valore. Solo una segnalazione specifica trasforma «alcuni trader lo vedono» in un problema tracciato, ed è la via più rapida per una risposta definitiva su se sia un comportamento previsto o un difetto." },
    { type: "heading",text: "Tabella di risoluzione dei problemi" },
    { type: "table", headers: ["Sintomo","Causa probabile","Soluzione"], rows: [
      ["L'alert >= scatta un tick sopra il Suo valore","Caso di uguaglianza saltato; si comporta come un attraversamento rigoroso","Imposti l'alert un tick sotto il livello obiettivo"],
      ["L'alert <= scatta un tick sotto il Suo valore","Stesso comportamento di attraversamento al ribasso","Imposti l'alert un tick sopra il livello obiettivo"],
      ["L'alert compensato ora scatta con due tick di scarto","Spostato nel verso sbagliato rispetto al percorso del prezzo","Inverta lo spostamento verso il lato da cui arriva il prezzo"],
      ["L'alert cade lontano dal livello, non solo di un tick","Feed dati ritardato o mancante, non la stranezza del tick","Confermi che il simbolo mostri quotazioni in tempo reale"],
      ["L'alert non scatta mai","Notifiche disattivate, alert consumato o livello mai raggiunto","Riattivi suono/popup e controlli l'alert nel pannello della campanella"],
      ["Le serve un ingresso al prezzo, non una notifica","L'alert nativo è un suono, non un'azione","Valuti il livello in uno script del grafico e lo inoltri come ordine"],
    ] },
    { type: "heading",text: "Quando un alert al tick non basta" },
    { type: "paragraph",html: "Compensare di un tick va bene quando l'alert è solo uno stimolo a guardare lo schermo. Ma molti trader usano un alert di prezzo come innesco per <em>agire</em>: raggiungere il livello, prendere l'ingresso, armare lo stop. Nel momento in cui la Sua reazione è il trade, un avviso in ritardo di un tick non è più cosmetico. O reagisce un tick indietro, o anticipa e spera. È questo il divario che vale la pena colmare con l'automazione." },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Definisca il livello dove la logica è solida.</strong> Una piattaforma di grafici come TradingView Le permette di esprimere l'esatta condizione di prezzo, o un'intera strategia, e di far partire un webhook nell'istante in cui è soddisfatta, senza dipendere da un alert nativo che arriva un tick in ritardo.",
        "<strong class='text-white'>Lo inoltri direttamente a Tradovate.</strong> PickMyTrade riceve quel webhook e agisce automaticamente sul Suo conto, così l'«alert» diventa un ordine sul livello che ha impostato anziché un suono a cui deve ancora rispondere.",
        "<strong class='text-white'>Replichi su più account.</strong> Un solo innesco può guidare più account di valutazione o finanziati contemporaneamente, così non deve riarmare manualmente su ogni schermo un alert sensibile al tick.",
        "<strong class='text-white'>Instradamento sicuro rispetto ai limiti di frequenza.</strong> Il flusso di ordini viene distanziato per restare entro i limiti di richieste di Tradovate, evitando le tempeste di ritentativi che causano blocchi.",
      ],
    },
    { type: "paragraph",html: "Tenga gli alert nativi per i livelli in cui ha gli occhi sullo schermo e un tick non conta, e affidi gli inneschi precisi al tick a una pipeline che scatta sul numero che ha davvero scelto." },
  ] },
  ctaHeading: { en: "Turn Alerts Into Orders on the Exact Level", de: "Verwandeln Sie Alarme in Orders auf dem exakten Niveau", es: "Convierta las alertas en órdenes en el nivel exacto", fr: "Transformez les alertes en ordres au niveau exact", it: "Trasformi gli alert in ordini sul livello esatto" },
  ctaText: { en: "Route TradingView price alerts into automatic Tradovate orders that fire on the exact level you set, no one-tick lag.", de: "Leiten Sie TradingView-Preisalarme in automatische Tradovate-Orders um, die auf dem exakt von Ihnen gesetzten Niveau auslösen, ohne Ein-Tick-Verzögerung.", es: "Envíe las alertas de precio de TradingView a órdenes automáticas de Tradovate que se ejecutan en el nivel exacto que usted fijó, sin retraso de un tick.", fr: "Acheminez vos alertes de prix TradingView vers des ordres Tradovate automatiques qui se déclenchent au niveau exact que vous avez fixé, sans décalage d'un tick.", it: "Inoltri gli alert di prezzo di TradingView a ordini Tradovate automatici che scattano sul livello esatto che ha impostato, senza ritardo di un tick." },
  ctaButtonText: { en: "Start Your Free 7-Day Trial", de: "Starten Sie Ihre kostenlose 7-Tage-Testphase", es: "Comience su prueba gratuita de 7 días", fr: "Commencez votre essai gratuit de 7 jours", it: "Inizi la prova gratuita di 7 giorni" },
  ctaUrl: "https://app.pickmytrade.trade/?register=true&utm_source=content&utm_medium=debugging",
  faqHeading: { en: "Frequently Asked Questions", de: "Häufig gestellte Fragen", es: "Preguntas frecuentes", fr: "Questions fréquentes", it: "Domande frequenti" },
  faqs: { en: [
    { q: "Why does my Tradovate price alert fire one tick after the value I set?", a: "A greater-than-or-equal or less-than-or-equal alert appears to behave like a strict crossing rather than an exact touch. When price prints exactly at your value the alert can stay quiet, and it only fires once a print lands one tick beyond the level. Contributing factors are that the alert usually evaluates the last traded price, and that quotes are sampled rather than streamed tick-for-tick, so a brief touch of the exact level between updates can be missed. The result is a ping that lands one tick late in the direction price was moving." },
    { q: "How do I make a >= or <= alert fire at my exact level?", a: "Nudge the alert one tick toward the current price, so the extra tick the platform adds lands you back on your true level. For an upside (greater-than-or-equal) alert, set the value one tick below your target. For a downside (less-than-or-equal) alert, set it one tick above your target. Example on ES, where one tick is 0.25: to be alerted at 5000.00 on the way up, set the alert at 4999.75. Test it once on a slow market before you rely on it, because the exact behavior can vary by build and instrument." },
    { q: "Which direction do I move the alert, up or down?", a: "Always toward the price, meaning the side price is coming from. If price is rising into your level and you use greater-than-or-equal, the late tick is above your value, so lower the alert by one tick. If price is falling into your level and you use less-than-or-equal, the late tick is below your value, so raise the alert by one tick. Match the nudge to your instrument's tick size, not a round number, because one tick on ES is 0.25 while other contracts differ." },
    { q: "Is the one-tick-late alert a bug I should report to Tradovate?", a: "Yes. The one-tick compensation is a practical workaround, not a fix for the underlying evaluation. If you see it, email support with specifics: the instrument, the exact condition and value, the platform you saw it on (desktop app, web, or mobile), and a note that the alert only fired one tick past the value. The more concrete the report, the faster it can be investigated and confirmed as expected behavior or a defect." },
    { q: "Does this affect automated trading or just manual price alerts?", a: "It matters most when you use a native chart or DOM alert as a manual trigger to act on. A one-tick-late ping can turn a limit fill into a chase, or leave you reacting after the level is gone. If your goal is an action at a price rather than a chime, evaluating the condition in a charting platform and routing it as an order removes the ambiguity entirely, because the order fires on the level you defined instead of a native alert that lands a tick late." },
  ], de: [
    { q: "Warum löst mein Tradovate-Preisalarm einen Tick nach dem eingestellten Wert aus?", a: "Ein Alarm mit „größer oder gleich“ oder „kleiner oder gleich“ verhält sich offenbar wie ein striktes Überschreiten statt wie eine exakte Berührung. Wenn der Kurs genau Ihren Wert druckt, kann der Alarm stumm bleiben und löst erst aus, sobald ein Kurs einen Tick jenseits des Niveaus landet. Mitverantwortlich ist, dass der Alarm in der Regel den letzten gehandelten Kurs auswertet und dass Kurse abgetastet statt Tick für Tick gestreamt werden; eine kurze Berührung des exakten Niveaus zwischen zwei Aktualisierungen kann daher verpasst werden. Das Ergebnis ist ein Signal, das in Kursrichtung einen Tick zu spät kommt." },
    { q: "Wie bringe ich einen >=- oder <=-Alarm dazu, auf meinem exakten Niveau auszulösen?", a: "Schieben Sie den Alarm einen Tick in Richtung des aktuellen Kurses, sodass der zusätzliche Tick, den die Plattform hinzufügt, Sie wieder auf Ihr tatsächliches Niveau bringt. Setzen Sie bei einem Aufwärtsalarm (größer oder gleich) den Wert einen Tick unter Ihr Ziel. Setzen Sie bei einem Abwärtsalarm (kleiner oder gleich) ihn einen Tick über Ihr Ziel. Beispiel bei ES, wo ein Tick 0.25 beträgt: Um bei 5000.00 auf dem Weg nach oben benachrichtigt zu werden, setzen Sie den Alarm auf 4999.75. Testen Sie das einmal in einem ruhigen Markt, bevor Sie sich darauf verlassen, denn das genaue Verhalten kann je nach Build und Instrument variieren." },
    { q: "In welche Richtung verschiebe ich den Alarm, nach oben oder nach unten?", a: "Immer in Richtung des Kurses, also auf die Seite, von der der Kurs kommt. Steigt der Kurs auf Ihr Niveau zu und Sie verwenden „größer oder gleich“, liegt der verspätete Tick über Ihrem Wert, also senken Sie den Alarm um einen Tick. Fällt der Kurs auf Ihr Niveau zu und Sie verwenden „kleiner oder gleich“, liegt der verspätete Tick unter Ihrem Wert, also erhöhen Sie den Alarm um einen Tick. Richten Sie die Verschiebung nach der Tickgröße Ihres Instruments aus, nicht nach einer runden Zahl, denn ein Tick bei ES ist 0.25, während andere Kontrakte abweichen." },
    { q: "Ist der um einen Tick verspätete Alarm ein Fehler, den ich Tradovate melden sollte?", a: "Ja. Die Ein-Tick-Kompensation ist ein praktischer Workaround, keine Behebung der zugrunde liegenden Auswertung. Wenn Sie das beobachten, schreiben Sie dem Support mit konkreten Angaben: Instrument, genaue Bedingung und Wert, die Plattform, auf der Sie es gesehen haben (Desktop-App, Web oder Mobil), und den Hinweis, dass der Alarm erst einen Tick jenseits des Wertes ausgelöst hat. Je konkreter die Meldung, desto schneller kann sie untersucht und als erwartetes Verhalten oder als Defekt bestätigt werden." },
    { q: "Betrifft das den automatisierten Handel oder nur manuelle Preisalarme?", a: "Es fällt am stärksten ins Gewicht, wenn Sie einen nativen Chart- oder DOM-Alarm als manuellen Auslöser nutzen, um zu handeln. Ein um einen Tick verspätetes Signal kann aus einer Limit-Ausführung ein Hinterherlaufen machen oder Sie erst reagieren lassen, wenn das Niveau schon vorbei ist. Wenn Ihr Ziel eine Aktion zu einem Preis ist und nicht ein Signalton, beseitigt die Auswertung der Bedingung in einer Charting-Plattform und die Weiterleitung als Order die Unklarheit vollständig, weil die Order auf dem von Ihnen definierten Niveau auslöst statt über einen nativen Alarm, der einen Tick zu spät kommt." },
  ], es: [
    { q: "¿Por qué mi alerta de precio de Tradovate salta un tick después del valor que fijé?", a: "Una alerta de mayor o igual, o de menor o igual, parece comportarse como un cruce estricto en lugar de un toque exacto. Cuando el precio imprime justo su valor, la alerta puede permanecer en silencio, y solo salta cuando una impresión cae un tick más allá del nivel. Contribuyen dos factores: que la alerta suele evaluar el último precio negociado, y que las cotizaciones se muestrean en lugar de transmitirse tick a tick, de modo que un toque breve del nivel exacto entre actualizaciones puede pasar inadvertido. El resultado es un aviso que llega un tick tarde en la dirección en que se movía el precio." },
    { q: "¿Cómo hago que una alerta >= o <= salte en mi nivel exacto?", a: "Desplace la alerta un tick hacia el precio actual, de modo que el tick extra que añade la plataforma le devuelva a su nivel real. Para una alerta al alza (mayor o igual), fije el valor un tick por debajo de su objetivo. Para una alerta a la baja (menor o igual), fíjelo un tick por encima de su objetivo. Ejemplo en ES, donde un tick es 0.25: para recibir el aviso en 5000.00 al subir, fije la alerta en 4999.75. Pruébelo una vez en un mercado lento antes de fiarse, porque el comportamiento exacto puede variar según la versión y el instrumento." },
    { q: "¿En qué dirección muevo la alerta, hacia arriba o hacia abajo?", a: "Siempre hacia el precio, es decir, hacia el lado del que viene el precio. Si el precio sube hacia su nivel y usa mayor o igual, el tick tardío queda por encima de su valor, así que baje la alerta un tick. Si el precio baja hacia su nivel y usa menor o igual, el tick tardío queda por debajo de su valor, así que suba la alerta un tick. Ajuste el desplazamiento al tamaño de tick de su instrumento, no a un número redondo, porque un tick en ES es 0.25 mientras que otros contratos difieren." },
    { q: "¿Es un error que debería informar a Tradovate que la alerta salte un tick tarde?", a: "Sí. La compensación de un tick es una solución práctica, no un arreglo de la evaluación subyacente. Si lo observa, escriba al soporte con detalles concretos: el instrumento, la condición y el valor exactos, la plataforma en la que lo vio (app de escritorio, web o móvil) y una nota de que la alerta solo saltó un tick más allá del valor. Cuanto más concreto sea el informe, más rápido se podrá investigar y confirmar como comportamiento esperado o como defecto." },
    { q: "¿Afecta esto al trading automatizado o solo a las alertas de precio manuales?", a: "Importa sobre todo cuando usa una alerta nativa de gráfico o de DOM como disparador manual para actuar. Un aviso un tick tarde puede convertir una ejecución limitada en una persecución, o dejarle reaccionando cuando el nivel ya pasó. Si su objetivo es una acción a un precio y no un timbre, evaluar la condición en una plataforma de gráficos y enviarla como orden elimina por completo la ambigüedad, porque la orden se ejecuta en el nivel que usted definió en lugar de depender de una alerta nativa que llega un tick tarde." },
  ], fr: [
    { q: "Pourquoi mon alerte de prix Tradovate se déclenche-t-elle un tick après la valeur que j'ai fixée ?", a: "Une alerte « supérieur ou égal » ou « inférieur ou égal » semble se comporter comme un franchissement strict plutôt que comme un contact exact. Lorsque le prix s'imprime exactement à votre valeur, l'alerte peut rester silencieuse et ne se déclenche que lorsqu'une impression tombe un tick au-delà du niveau. Deux facteurs y contribuent : l'alerte évalue généralement le dernier prix négocié, et les cotations sont échantillonnées plutôt que diffusées tick par tick, si bien qu'un bref contact avec le niveau exact entre deux mises à jour peut passer inaperçu. Le résultat est un signal qui arrive un tick trop tard dans le sens où le prix évoluait." },
    { q: "Comment faire déclencher une alerte >= ou <= à mon niveau exact ?", a: "Décalez l'alerte d'un tick vers le prix actuel, de sorte que le tick supplémentaire ajouté par la plateforme vous ramène à votre vrai niveau. Pour une alerte à la hausse (supérieur ou égal), fixez la valeur un tick sous votre cible. Pour une alerte à la baisse (inférieur ou égal), fixez-la un tick au-dessus de votre cible. Exemple sur ES, où un tick vaut 0.25 : pour être alerté à 5000.00 à la hausse, fixez l'alerte à 4999.75. Testez-le une fois sur un marché calme avant de vous y fier, car le comportement exact peut varier selon la version et l'instrument." },
    { q: "Dans quelle direction déplacer l'alerte, vers le haut ou vers le bas ?", a: "Toujours vers le prix, c'est-à-dire du côté d'où vient le prix. Si le prix monte vers votre niveau et que vous utilisez « supérieur ou égal », le tick tardif se situe au-dessus de votre valeur : abaissez donc l'alerte d'un tick. Si le prix descend vers votre niveau et que vous utilisez « inférieur ou égal », le tick tardif se situe en dessous de votre valeur : relevez donc l'alerte d'un tick. Adaptez le décalage à la taille de tick de votre instrument, pas à un nombre rond, car un tick sur ES vaut 0.25 alors que d'autres contrats diffèrent." },
    { q: "Le déclenchement un tick trop tard est-il un bogue que je devrais signaler à Tradovate ?", a: "Oui. La compensation d'un tick est un contournement pratique, pas une correction de l'évaluation sous-jacente. Si vous l'observez, écrivez au support avec des précisions : l'instrument, la condition et la valeur exactes, la plateforme sur laquelle vous l'avez constaté (application de bureau, web ou mobile), et une note indiquant que l'alerte ne s'est déclenchée qu'un tick au-delà de la valeur. Plus le signalement est concret, plus vite il pourra être examiné et confirmé comme un comportement attendu ou un défaut." },
    { q: "Cela affecte-t-il le trading automatisé ou seulement les alertes de prix manuelles ?", a: "Cela pèse surtout lorsque vous utilisez une alerte native de graphique ou de DOM comme déclencheur manuel pour agir. Un signal un tick trop tard peut transformer une exécution à cours limité en course-poursuite, ou vous faire réagir alors que le niveau est déjà passé. Si votre but est une action à un prix plutôt qu'un carillon, évaluer la condition dans une plateforme de graphiques et l'acheminer sous forme d'ordre supprime toute ambiguïté, car l'ordre se déclenche au niveau que vous avez défini au lieu de dépendre d'une alerte native qui arrive un tick trop tard." },
  ], it: [
    { q: "Perché il mio alert di prezzo Tradovate scatta un tick dopo il valore che ho impostato?", a: "Un alert «maggiore o uguale» o «minore o uguale» sembra comportarsi come un attraversamento rigoroso anziché come un tocco esatto. Quando il prezzo stampa esattamente il Suo valore, l'alert può restare silenzioso e scatta solo quando una stampa cade un tick oltre il livello. Contribuiscono due fattori: l'alert di solito valuta l'ultimo prezzo negoziato, e le quotazioni vengono campionate anziché trasmesse tick per tick, quindi un breve tocco del livello esatto tra un aggiornamento e l'altro può sfuggire. Il risultato è un avviso che arriva un tick in ritardo nella direzione in cui si muoveva il prezzo." },
    { q: "Come faccio scattare un alert >= o <= sul mio livello esatto?", a: "Sposti l'alert di un tick verso il prezzo corrente, in modo che il tick extra aggiunto dalla piattaforma La riporti sul Suo vero livello. Per un alert al rialzo (maggiore o uguale), imposti il valore un tick sotto il Suo obiettivo. Per un alert al ribasso (minore o uguale), lo imposti un tick sopra il Suo obiettivo. Esempio su ES, dove un tick è 0.25: per essere avvisato a 5000.00 in salita, imposti l'alert a 4999.75. Lo provi una volta su un mercato lento prima di farci affidamento, perché il comportamento esatto può variare a seconda della build e dello strumento." },
    { q: "In quale direzione sposto l'alert, verso l'alto o verso il basso?", a: "Sempre verso il prezzo, cioè dal lato da cui il prezzo arriva. Se il prezzo sale verso il Suo livello e usa maggiore o uguale, il tick in ritardo cade sopra il Suo valore, quindi abbassi l'alert di un tick. Se il prezzo scende verso il Suo livello e usa minore o uguale, il tick in ritardo cade sotto il Suo valore, quindi alzi l'alert di un tick. Adatti lo spostamento alla dimensione del tick del Suo strumento, non a un numero tondo, perché un tick su ES è 0.25 mentre altri contratti differiscono." },
    { q: "L'alert in ritardo di un tick è un bug che dovrei segnalare a Tradovate?", a: "Sì. La compensazione di un tick è un rimedio pratico, non una correzione della valutazione sottostante. Se lo osserva, scriva al supporto con dettagli precisi: lo strumento, la condizione e il valore esatti, la piattaforma su cui l'ha visto (app desktop, web o mobile) e una nota che l'alert è scattato solo un tick oltre il valore. Più la segnalazione è concreta, più in fretta può essere esaminata e confermata come comportamento previsto o come difetto." },
    { q: "Questo riguarda il trading automatizzato o solo gli alert di prezzo manuali?", a: "Pesa soprattutto quando usa un alert nativo del grafico o del DOM come innesco manuale per agire. Un avviso in ritardo di un tick può trasformare un'esecuzione limite in un inseguimento, o lasciarLa a reagire quando il livello è ormai passato. Se il Suo obiettivo è un'azione a un prezzo e non un suono, valutare la condizione in una piattaforma di grafici e inoltrarla come ordine elimina del tutto l'ambiguità, perché l'ordine scatta sul livello che ha definito anziché su un alert nativo che arriva un tick in ritardo." },
  ] },
