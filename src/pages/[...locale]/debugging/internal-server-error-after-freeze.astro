  ctaHeading: { en: "Don't Get Stranded by an Outage", de: "Lassen Sie sich nicht von einer Störung ausbremsen", es: "No se quede varado por una interrupción", fr: "Ne restez pas bloqué par une panne", it: "Non rimanete bloccati da un'interruzione" },
  ctaText: { en: "Automate Tradovate with PickMyTrade so your trade logic doesn't depend on your desktop staying connected.", de: "Automatisieren Sie Tradovate mit PickMyTrade, damit Ihre Handelslogik nicht davon abhängt, dass Ihr Desktop verbunden bleibt.", es: "Automatice Tradovate con PickMyTrade para que su lógica de trading no dependa de que su escritorio permanezca conectado.", fr: "Automatisez Tradovate avec PickMyTrade afin que votre logique de trading ne dépende pas du maintien de la connexion de votre bureau.", it: "Automatizzate Tradovate con PickMyTrade così la vostra logica di trading non dipende dal fatto che il vostro desktop resti connesso." },
