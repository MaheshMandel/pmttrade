---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "no-notification-margin-increases";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/debugging/${SLUG}`;

const META_TITLE = "Tradovate No Alert for Margin Requirement Increases";
const META_DESCRIPTION =
  "No pop-up warns you when futures margin requirements spike around news. Here's how to check current margins manually and hold a safe buffer.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Tradovate warnt nicht bei steigenden Margin-Anforderungen", es: "Tradovate no avisa cuando suben los requisitos de margen", fr: "Tradovate n'alerte pas lors des hausses de marge requise", it: "Tradovate non avvisa degli aumenti dei requisiti di margine" },
  dek: { en: "Tradovate does not warn you when a margin requirement goes up. The requirement can jump to several times its normal level minutes before a news release, and the first sign most people get is a rejected order. Here's the habit that replaces the missing alert.", de: "Tradovate warnt Sie nicht, wenn eine Margin-Anforderung steigt. Die Anforderung kann Minuten vor einer Nachrichtenveröffentlichung auf ein Vielfaches ihres normalen Niveaus springen, und das erste Anzeichen ist für die meisten eine abgelehnte Order. Hier ist die Gewohnheit, die den fehlenden Alert ersetzt.", es: "Tradovate no le advierte cuando un requisito de margen sube. El requisito puede saltar a varias veces su nivel normal minutos antes de una publicación de noticias, y la primera señal que reciben la mayoría es una orden rechazada. Este es el hábito que sustituye a la alerta que falta.", fr: "Tradovate ne vous prévient pas lorsqu'une exigence de marge augmente. L'exigence peut atteindre plusieurs fois son niveau normal quelques minutes avant une publication de nouvelles, et le premier signe que la plupart des traders reçoivent est un ordre rejeté. Voici l'habitude qui remplace l'alerte manquante.", it: "Tradovate non la avvisa quando un requisito di margine sale. Il requisito può salire a molte volte il suo livello normale pochi minuti prima di un rilascio di notizie, e il primo segnale che la maggior parte riceve è un ordine rifiutato. Ecco l'abitudine che sostituisce l'avviso mancante." },
  readTime: { en: "6 min read", de: "6 Min. Lesezeit", es: "Lectura de 6 min", fr: "Lecture : 6 min", it: "Lettura di 6 min" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "Short version: Tradovate does not warn you when a margin requirement goes up. There is no pop-up, no banner, no email. The requirement can double, triple, or jump to several times its normal level minutes before a news release, and the first sign most people get is an order rejection or a position that shrinks on its own. So the fix isn't a setting you flip on. It's a habit: check the current margin figures yourself before you size up, and keep enough free cash that a temporary jump can't hurt you." },
    { type: "paragraph", html: "This trips up a lot of futures traders because so much else on the platform does notify you. Fills, order rejections, alerts you set on price, connection drops. Margin changes are the quiet exception. Let's walk through why the requirement moves, exactly where to read the live numbers, and how to trade so the missing notification stops being a problem." },
    { type: "heading", text: "What's Actually Happening" },
    { type: "paragraph", html: "A margin requirement is the amount of account value you need to hold a contract. It isn't a fixed number. Exchanges set a baseline, brokers can add to it, and the figure changes with market conditions. Tradovate publishes these numbers and updates them, but it doesn't push a message to your screen when they change. There's been a standing request to add a desktop notification for margin changes, and as of now that feature doesn't exist in the platform. The workaround that's actually offered is to check the margin page manually." },
    { type: "paragraph", html: "So nothing is broken on your end. You're not missing a toggle buried in settings. The alert simply isn't built yet, which means the responsibility to know the current requirement sits with you." },
    { type: "heading", text: "Why the Requirement Jumps (and When)" },
    { type: "paragraph", html: "There are two windows where margins move that catch people out most, plus a slower background reason." },
    { type: "heading", text: "1. Right before scheduled economic news" },
    { type: "paragraph", html: "Ahead of the big releases, Tradovate raises intraday margins to roughly <strong class='text-white'>4x its standard rate</strong>. This kicks in shortly before the release and stays elevated after it until volatility is judged manageable again. Think FOMC rate decisions, CPI, Non-Farm Payrolls, and the other high-impact prints. The elevated rate applies when you enter a new position during that window, so a trade you could easily afford an hour earlier can get rejected in the minutes around the number." },
    { type: "paragraph", html: "This is by far the most common reason a trader hits a wall with “no warning.” The market looks normal, the release is still a few minutes out, and the order bounces because the requirement quietly quadrupled." },
    { type: "heading", text: "2. The daily close and overnight hold" },
    { type: "paragraph", html: "Tradovate uses a lower <em>intraday</em> (“day”) margin during the session and a higher <em>initial</em> margin overnight. The reduced day rate is generally available from the evening open until about 15 minutes before the daily close, at which point the higher initial margin applies. In current published terms that's roughly the day rate from around 6:00 PM ET through 4:45 PM ET, with initial margin required from about 4:45 to 5:00 PM ET and any time you're holding a position at the close." },
    { type: "paragraph", html: "If you carry a position through that cutoff without enough cash for the overnight requirement, the platform can reduce or close it. That's a separate headache tied to why a position can auto-close at 5PM CT for overnight margin, but the root cause is the same missing notification: the margin went up at the close and nothing told you." },
    { type: "heading", text: "3. Exchange and firm changes" },
    { type: "paragraph", html: "The CME and other exchanges adjust margins on their own timeline, often before known volatility like major holidays, contract rollovers, or unusual events. Brokers and prop firms can layer their own requirements on top. These changes are usually published in advance, but again, you won't get a ping. You have to go look." },
    { type: "heading", text: "How to Check Margin Requirements Manually" },
    { type: "paragraph", html: "Since there's no alert, this is the core skill. There are two places to read the numbers, and it's worth using both." },
    { type: "heading", text: "Option A: the Tradovate margins page" },
    { type: "paragraph", html: "Tradovate maintains a margins resource page on its website that lists initial and intraday margin per contract. This is the fastest way to scan a whole product group and see where a symbol you trade sits today. Bookmark it and glance at it as part of your pre-session routine, especially on days with a scheduled release." },
    { type: "heading", text: "Option B: read it inside the platform" },
    { type: "paragraph", html: "You don't have to leave the app. In your Quote Board, right-click the contract you want and open its quote detail view. That panel shows the contract's margin along with details like expiration. This is handy mid-session because it reflects the figure for the exact contract you're about to trade, not a generic table row." },
    { type: "paragraph", html: "When the detail panel opens, look for the initial and maintenance margin values for that specific contract. If the number looks higher than you remember, that's your signal a change is in effect, likely because of a news window or the overnight cutoff." },
    { type: "quote", html: "Make the check a routine, not a reaction. Reading the margin after your order gets rejected is too late. A ten-second look before a known release or before you carry overnight saves the whole problem." },
    { type: "heading", text: "Trade So the Missing Alert Doesn't Matter" },
    { type: "paragraph", html: "Checking the number is half of it. The other half is sizing so a jump can't force a rejection or a liquidation. A few habits do most of the work." },
    { type: "paragraph", html: "<strong class='text-white'>Keep a real buffer.</strong> Don't run right at the edge of your available margin. If your free margin only covers the position at the normal rate, a 4x news spike will blow straight past it. Hold enough that even an elevated requirement leaves room. You can watch your used-versus-available margin in the account info panel as you trade." },
    { type: "paragraph", html: "<strong class='text-white'>Flatten or downsize before high-impact news.</strong> If you don't want to trade the release, the cleanest move is to be flat or smaller going into it. Then the elevated requirement is irrelevant to you. If you do trade it, plan on needing several times the usual margin per contract." },
    { type: "paragraph", html: "<strong class='text-white'>Respect the overnight cutoff.</strong> If you're not intending to hold overnight, close before the daily reset so the higher initial margin never applies. If you are holding, confirm you have the initial-margin amount, not just the day rate." },
    { type: "paragraph", html: "<strong class='text-white'>Watch an economic calendar.</strong> Since the platform won't tell you a release is coming, keep a calendar of high-impact events open. Knowing that CPI drops at 8:30 AM ET tells you exactly when the margin window opens, even without a notification." },
    { type: "paragraph", html: "Two related rejections are worth understanding while you're here: the “insufficient margin / not enough money” rejection, which is the direct result of a requirement outrunning your free cash, and Tradovate's auto-liquidation and the fee it charges, which is what can happen if an underfunded position gets forced closed. Both are downstream of the same thing: a margin number moved and nothing announced it." },
    { type: "heading", text: "If It's a Prop Firm or Evaluation Account" },
    { type: "paragraph", html: "On a funded or evaluation account, the margin picture has an extra layer. The prop firm sets its own contract limits and buffers on top of whatever the exchange and Tradovate require, and those numbers <strong class='text-white'>vary by firm and by account size</strong>. A jump you see may be the firm's rule, not a Tradovate-wide change. Check your firm's current rules for the specific max contracts and margin per account tier, since they update those independently and, like Tradovate, generally won't push you a notification when they do." },
  ], de: [
    { type: "paragraph",html: "Kurz gesagt: Tradovate warnt Sie nicht, wenn eine Margin-Anforderung steigt. Es gibt kein Pop-up, kein Banner, keine E-Mail. Die Anforderung kann sich Minuten vor einer Nachrichtenveröffentlichung verdoppeln, verdreifachen oder auf ein Vielfaches ihres normalen Niveaus springen, und das erste Anzeichen ist für die meisten eine abgelehnte Order oder eine Position, die von selbst schrumpft. Die Lösung ist also keine Einstellung, die Sie einschalten. Es ist eine Gewohnheit: Prüfen Sie die aktuellen Margin-Werte selbst, bevor Sie die Positionsgröße erhöhen, und halten Sie genug freies Cash vor, damit ein vorübergehender Sprung Ihnen nicht schaden kann." },
    { type: "paragraph",html: "Das bringt viele Futures-Trader aus dem Tritt, weil einen die Plattform sonst über so vieles informiert. Fills, Order-Ablehnungen, von Ihnen gesetzte Preisalarme, Verbindungsabbrüche. Margin-Änderungen sind die stille Ausnahme. Gehen wir durch, warum sich die Anforderung bewegt, wo genau Sie die aktuellen Zahlen ablesen und wie Sie so handeln, dass die fehlende Benachrichtigung kein Problem mehr ist." },
    { type: "heading",text: "Was tatsächlich passiert" },
    { type: "paragraph",html: "Eine Margin-Anforderung ist der Kontowert, den Sie halten müssen, um einen Kontrakt zu führen. Sie ist keine feste Zahl. Börsen legen eine Basis fest, Broker können darauf aufschlagen, und der Wert ändert sich mit den Marktbedingungen. Tradovate veröffentlicht diese Zahlen und aktualisiert sie, schiebt aber keine Nachricht auf Ihren Bildschirm, wenn sie sich ändern. Es gibt seit Langem den Wunsch nach einer Desktop-Benachrichtigung bei Margin-Änderungen, und diese Funktion existiert in der Plattform bislang nicht. Als Workaround wird angeboten, die Margin-Seite manuell zu prüfen." },
    { type: "paragraph",html: "Bei Ihnen ist also nichts kaputt. Sie übersehen keinen in den Einstellungen versteckten Schalter. Der Alert ist schlicht noch nicht gebaut, was bedeutet, dass die Verantwortung, die aktuelle Anforderung zu kennen, bei Ihnen liegt." },
    { type: "heading",text: "Warum die Anforderung springt (und wann)" },
    { type: "paragraph",html: "Es gibt zwei Zeitfenster, in denen sich Margins bewegen und die die meisten überraschen, dazu einen langsameren Hintergrundgrund." },
    { type: "heading",text: "1. Kurz vor terminierten Wirtschaftsnachrichten" },
    { type: "paragraph",html: "Vor den großen Veröffentlichungen hebt Tradovate die Intraday-Margins auf etwa das <strong class='text-white'>4-Fache des Standardsatzes</strong> an. Das beginnt kurz vor der Veröffentlichung und bleibt danach erhöht, bis die Volatilität wieder als beherrschbar eingestuft wird. Denken Sie an FOMC-Zinsentscheidungen, CPI, Non-Farm Payrolls und die anderen hochrelevanten Daten. Der erhöhte Satz gilt, wenn Sie in diesem Zeitfenster eine neue Position eröffnen, sodass ein Trade, den Sie eine Stunde zuvor problemlos bezahlen konnten, in den Minuten rund um die Zahl abgelehnt werden kann." },
    { type: "paragraph",html: "Dies ist mit Abstand der häufigste Grund, warum ein Trader „ohne Vorwarnung“ an eine Wand läuft. Der Markt wirkt normal, die Veröffentlichung ist noch ein paar Minuten entfernt, und die Order prallt ab, weil sich die Anforderung unbemerkt vervierfacht hat." },
    { type: "heading",text: "2. Der tägliche Handelsschluss und das Halten über Nacht" },
    { type: "paragraph",html: "Tradovate nutzt während der Handelssitzung eine niedrigere <em>Intraday</em>-Margin („Day“) und über Nacht eine höhere <em>Initial</em>-Margin. Der reduzierte Day-Satz steht grundsätzlich vom abendlichen Handelsstart bis etwa 15 Minuten vor dem täglichen Handelsschluss zur Verfügung, danach gilt die höhere Initial-Margin. Nach den aktuell veröffentlichten Bedingungen gilt der Day-Satz etwa von 6:00 PM ET bis 4:45 PM ET, mit erforderlicher Initial-Margin von etwa 4:45 bis 5:00 PM ET und jederzeit, wenn Sie bei Handelsschluss eine Position halten." },
    { type: "paragraph",html: "Wenn Sie eine Position über diese Grenze hinaus halten, ohne genug Cash für die Over-Night-Anforderung, kann die Plattform sie reduzieren oder schließen. Das ist ein eigenes Problem und hängt damit zusammen, warum eine Position um 5PM CT wegen der Over-Night-Margin automatisch geschlossen werden kann, aber die Ursache ist dieselbe fehlende Benachrichtigung: Die Margin stieg zum Handelsschluss, und nichts hat es Ihnen gesagt." },
    { type: "heading",text: "3. Änderungen durch Börsen und Firmen" },
    { type: "paragraph",html: "Die CME und andere Börsen passen Margins nach eigenem Zeitplan an, oft vor bekannter Volatilität wie größeren Feiertagen, Kontrakt-Rollovers oder ungewöhnlichen Ereignissen. Broker und Prop-Firmen können ihre eigenen Anforderungen daraufsetzen. Diese Änderungen werden in der Regel vorab veröffentlicht, aber auch hier gibt es keinen Hinweis an Sie. Sie müssen selbst nachsehen." },
    { type: "heading",text: "So prüfen Sie Margin-Anforderungen manuell" },
    { type: "paragraph",html: "Da es keinen Alert gibt, ist dies die Kernkompetenz. Es gibt zwei Stellen, an denen Sie die Zahlen ablesen können, und es lohnt sich, beide zu nutzen." },
    { type: "heading",text: "Option A: die Tradovate-Margin-Seite" },
    { type: "paragraph",html: "Tradovate pflegt auf seiner Website eine Margin-Ressourcenseite, die Initial- und Intraday-Margin pro Kontrakt auflistet. So scannen Sie am schnellsten eine ganze Produktgruppe und sehen, wo ein von Ihnen gehandeltes Symbol heute liegt. Legen Sie ein Lesezeichen an und werfen Sie als Teil Ihrer Routine vor der Sitzung einen Blick darauf, besonders an Tagen mit terminierten Veröffentlichungen." },
    { type: "heading",text: "Option B: innerhalb der Plattform ablesen" },
    { type: "paragraph",html: "Sie müssen die App nicht verlassen. Klicken Sie in Ihrem Quote Board mit der rechten Maustaste auf den gewünschten Kontrakt und öffnen Sie dessen Kursdetailansicht. Dieses Panel zeigt die Margin des Kontrakts zusammen mit Details wie dem Verfall. Das ist mitten in der Sitzung praktisch, weil es den Wert für genau den Kontrakt widerspiegelt, den Sie gleich handeln wollen, und keine allgemeine Tabellenzeile." },
    { type: "paragraph",html: "Wenn sich das Detail-Panel öffnet, suchen Sie die Werte für Initial- und Maintenance-Margin dieses konkreten Kontrakts. Wirkt die Zahl höher, als Sie sie in Erinnerung haben, ist das Ihr Signal, dass eine Änderung gilt, wahrscheinlich wegen eines Nachrichtenfensters oder der nächtlichen Grenze." },
    { type: "quote",html: "Machen Sie die Prüfung zur Routine, nicht zur Reaktion. Die Margin erst nach einer abgelehnten Order zu lesen, ist zu spät. Ein zehnsekündiger Blick vor einer bekannten Veröffentlichung oder bevor Sie über Nacht halten, erspart Ihnen das ganze Problem." },
    { type: "heading",text: "So handeln, dass der fehlende Alert keine Rolle spielt" },
    { type: "paragraph",html: "Die Zahl zu prüfen ist die halbe Miete. Die andere Hälfte ist eine Positionsgröße, bei der ein Sprung keine Ablehnung oder Liquidation erzwingen kann. Ein paar Gewohnheiten leisten die meiste Arbeit." },
    { type: "paragraph",html: "<strong class='text-white'>Halten Sie einen echten Puffer.</strong> Fahren Sie nicht am Rand Ihrer verfügbaren Margin. Wenn Ihre freie Margin die Position nur zum normalen Satz abdeckt, schießt ein 4x-Nachrichtensprung glatt darüber hinaus. Halten Sie genug vor, dass selbst eine erhöhte Anforderung Spielraum lässt. Ihre genutzte gegenüber der verfügbaren Margin sehen Sie beim Handeln im Kontoinfo-Panel." },
    { type: "paragraph",html: "<strong class='text-white'>Gehen Sie vor wichtigen Nachrichten flat oder verkleinern Sie.</strong> Wenn Sie die Veröffentlichung nicht handeln wollen, ist es am saubersten, flat oder kleiner in sie hineinzugehen. Dann ist die erhöhte Anforderung für Sie irrelevant. Wenn Sie sie handeln, planen Sie pro Kontrakt mit dem Mehrfachen der üblichen Margin." },
    { type: "paragraph",html: "<strong class='text-white'>Beachten Sie die nächtliche Grenze.</strong> Wenn Sie nicht über Nacht halten wollen, schließen Sie vor dem täglichen Reset, damit die höhere Initial-Margin nie greift. Wenn Sie halten, bestätigen Sie, dass Sie den Initial-Margin-Betrag haben, nicht nur den Day-Satz." },
    { type: "paragraph",html: "<strong class='text-white'>Beobachten Sie einen Wirtschaftskalender.</strong> Da die Plattform Ihnen nicht sagt, dass eine Veröffentlichung ansteht, halten Sie einen Kalender mit hochrelevanten Ereignissen offen. Zu wissen, dass CPI um 8:30 AM ET erscheint, sagt Ihnen genau, wann das Margin-Fenster sich öffnet, auch ohne Benachrichtigung." },
    { type: "paragraph",html: "Zwei verwandte Ablehnungen sind es wert, hier verstanden zu werden: die Ablehnung wegen „insufficient margin / not enough money“, die direkte Folge einer Anforderung, die Ihr freies Cash überholt, und Tradovates Auto-Liquidation samt der dafür erhobenen Gebühr, die passieren kann, wenn eine unterfinanzierte Position zwangsgeschlossen wird. Beides ist Folge derselben Ursache: Eine Margin-Zahl hat sich bewegt, und nichts hat es angekündigt." },
    { type: "heading",text: "Wenn es ein Prop-Firm- oder Evaluierungskonto ist" },
    { type: "paragraph",html: "Bei einem Funded- oder Evaluierungskonto kommt eine weitere Ebene hinzu. Die Prop-Firma legt eigene Kontraktlimits und Puffer zusätzlich zu dem fest, was Börse und Tradovate verlangen, und diese Zahlen <strong class='text-white'>variieren je nach Firma und Kontogröße</strong>. Ein Sprung, den Sie sehen, kann die Regel der Firma sein und keine Tradovate-weite Änderung. Prüfen Sie die aktuellen Regeln Ihrer Firma für die konkrete maximale Kontraktzahl und Margin pro Kontostufe, denn sie aktualisieren diese unabhängig und schicken Ihnen, wie Tradovate, in der Regel keine Benachrichtigung." },
  ], es: [
    { type: "paragraph",html: "En resumen: Tradovate no le advierte cuando un requisito de margen sube. No hay ventana emergente, ni banner, ni correo. El requisito puede duplicarse, triplicarse o saltar a varias veces su nivel normal minutos antes de una publicación de noticias, y la primera señal que reciben la mayoría es el rechazo de una orden o una posición que se reduce por sí sola. Así que la solución no es un ajuste que se activa. Es un hábito: compruebe usted mismo las cifras de margen vigentes antes de aumentar el tamaño y mantenga suficiente efectivo libre para que un salto temporal no pueda perjudicarle." },
    { type: "paragraph",html: "Esto sorprende a muchos operadores de futuros porque tanto en la plataforma sí avisa. Ejecuciones, rechazos de órdenes, alertas que usted define sobre el precio, caídas de conexión. Los cambios de margen son la excepción silenciosa. Veamos por qué se mueve el requisito, dónde leer exactamente las cifras en vivo y cómo operar para que la notificación ausente deje de ser un problema." },
    { type: "heading",text: "Qué está pasando realmente" },
    { type: "paragraph",html: "Un requisito de margen es el valor de cuenta que necesita para mantener un contrato. No es un número fijo. Las bolsas fijan una base, los brókeres pueden añadir sobre ella y la cifra cambia con las condiciones del mercado. Tradovate publica estas cifras y las actualiza, pero no envía un mensaje a su pantalla cuando cambian. Existe una petición vigente de añadir una notificación de escritorio para los cambios de margen y, a día de hoy, esa función no existe en la plataforma. La solución alternativa que realmente se ofrece es comprobar la página de márgenes manualmente." },
    { type: "paragraph",html: "Así que nada está roto por su lado. No se le escapa un interruptor enterrado en los ajustes. La alerta simplemente aún no está construida, lo que significa que la responsabilidad de conocer el requisito vigente recae en usted." },
    { type: "heading",text: "Por qué salta el requisito (y cuándo)" },
    { type: "paragraph",html: "Hay dos ventanas en las que los márgenes se mueven y que más sorprenden, además de un motivo de fondo más lento." },
    { type: "heading",text: "1. Justo antes de noticias económicas programadas" },
    { type: "paragraph",html: "Antes de las grandes publicaciones, Tradovate eleva los márgenes intradía a aproximadamente <strong class='text-white'>4x su tarifa estándar</strong>. Esto empieza poco antes de la publicación y permanece elevado después hasta que se juzga que la volatilidad vuelve a ser manejable. Piense en las decisiones de tipos de la FOMC, el CPI, las Non-Farm Payrolls y el resto de datos de alto impacto. La tarifa elevada se aplica cuando abre una nueva posición durante esa ventana, de modo que una operación que podía permitirse sin problema una hora antes puede ser rechazada en los minutos alrededor del dato." },
    { type: "paragraph",html: "Esta es, con diferencia, la razón más común por la que un operador choca con un muro “sin aviso”. El mercado parece normal, la publicación aún está a unos minutos y la orden rebota porque el requisito se cuadruplicó en silencio." },
    { type: "heading",text: "2. El cierre diario y mantener posiciones durante la noche" },
    { type: "paragraph",html: "Tradovate usa un margen <em>intradía</em> (“day”) más bajo durante la sesión y un margen <em>inicial</em> más alto durante la noche. La tarifa day reducida suele estar disponible desde la apertura de la tarde hasta unos 15 minutos antes del cierre diario, momento en que se aplica el margen inicial más alto. Según las condiciones publicadas actualmente, eso es aproximadamente la tarifa day desde las 6:00 PM ET hasta las 4:45 PM ET, con margen inicial exigido desde cerca de las 4:45 hasta las 5:00 PM ET y siempre que mantenga una posición al cierre." },
    { type: "paragraph",html: "Si mantiene una posición más allá de ese corte sin suficiente efectivo para el requisito nocturno, la plataforma puede reducirla o cerrarla. Es otro dolor de cabeza, relacionado con por qué una posición puede cerrarse automáticamente a las 5PM CT por el margen nocturno, pero la causa de fondo es la misma notificación ausente: el margen subió al cierre y nada se lo dijo." },
    { type: "heading",text: "3. Cambios de bolsas y firmas" },
    { type: "paragraph",html: "El CME y otras bolsas ajustan los márgenes según su propio calendario, a menudo ante volatilidad conocida como grandes festivos, rolleos de contratos o eventos inusuales. Los brókeres y las prop firms pueden superponer sus propios requisitos. Estos cambios suelen publicarse con antelación, pero de nuevo no recibirá ningún aviso. Tiene que ir a mirar." },
    { type: "heading",text: "Cómo comprobar manualmente los requisitos de margen" },
    { type: "paragraph",html: "Como no hay alerta, esta es la habilidad central. Hay dos lugares donde leer las cifras y conviene usar ambos." },
    { type: "heading",text: "Opción A: la página de márgenes de Tradovate" },
    { type: "paragraph",html: "Tradovate mantiene en su sitio web una página de recursos de márgenes que lista el margen inicial e intradía por contrato. Es la forma más rápida de recorrer todo un grupo de productos y ver dónde se sitúa hoy un símbolo que usted opera. Añádala a marcadores y échele un vistazo como parte de su rutina previa a la sesión, sobre todo en días con publicaciones programadas." },
    { type: "heading",text: "Opción B: leerlo dentro de la plataforma" },
    { type: "paragraph",html: "No tiene que salir de la aplicación. En su Quote Board, haga clic derecho en el contrato que desee y abra su vista de detalle de cotización. Ese panel muestra el margen del contrato junto con datos como el vencimiento. Es útil en plena sesión porque refleja la cifra del contrato exacto que está a punto de operar, no una fila genérica de una tabla." },
    { type: "paragraph",html: "Cuando se abra el panel de detalle, busque los valores de margen inicial y de mantenimiento de ese contrato concreto. Si la cifra le parece más alta de lo que recordaba, es su señal de que hay un cambio en vigor, probablemente por una ventana de noticias o por el corte nocturno." },
    { type: "quote",html: "Haga de la comprobación una rutina, no una reacción. Leer el margen después de que su orden sea rechazada es demasiado tarde. Un vistazo de diez segundos antes de una publicación conocida o antes de mantener posición durante la noche le ahorra todo el problema." },
    { type: "heading",text: "Opere de modo que la alerta ausente no importe" },
    { type: "paragraph",html: "Comprobar la cifra es la mitad. La otra mitad es dimensionar para que un salto no pueda forzar un rechazo o una liquidación. Unos pocos hábitos hacen casi todo el trabajo." },
    { type: "paragraph",html: "<strong class='text-white'>Mantenga un colchón real.</strong> No opere al borde de su margen disponible. Si su margen libre solo cubre la posición a la tarifa normal, un salto de 4x por noticias lo superará de largo. Conserve lo suficiente para que incluso un requisito elevado deje margen de maniobra. Puede ver su margen usado frente al disponible en el panel de información de la cuenta mientras opera." },
    { type: "paragraph",html: "<strong class='text-white'>Quede plano o reduzca antes de noticias de alto impacto.</strong> Si no quiere operar la publicación, lo más limpio es estar plano o con menos tamaño al entrar en ella. Entonces el requisito elevado le es irrelevante. Si sí la opera, cuente con necesitar varias veces el margen habitual por contrato." },
    { type: "paragraph",html: "<strong class='text-white'>Respete el corte nocturno.</strong> Si no pretende mantener posición durante la noche, cierre antes del reinicio diario para que nunca se aplique el margen inicial más alto. Si la mantiene, confirme que dispone del importe del margen inicial, no solo de la tarifa day." },
    { type: "paragraph",html: "<strong class='text-white'>Vigile un calendario económico.</strong> Como la plataforma no le dirá que se acerca una publicación, mantenga abierto un calendario de eventos de alto impacto. Saber que el CPI sale a las 8:30 AM ET le dice exactamente cuándo se abre la ventana de margen, incluso sin notificación." },
    { type: "paragraph",html: "Conviene entender dos rechazos relacionados mientras está aquí: el rechazo por “insufficient margin / not enough money”, que es el resultado directo de un requisito que supera su efectivo libre, y la autoliquidación de Tradovate y la comisión que cobra, que es lo que puede ocurrir si una posición sin fondos suficientes se cierra a la fuerza. Ambos derivan de lo mismo: una cifra de margen se movió y nada lo anunció." },
    { type: "heading",text: "Si es una cuenta de prop firm o de evaluación" },
    { type: "paragraph",html: "En una cuenta fondeada o de evaluación, el panorama de márgenes tiene una capa adicional. La prop firm fija sus propios límites de contratos y colchones además de lo que exijan la bolsa y Tradovate, y esas cifras <strong class='text-white'>varían según la firma y el tamaño de la cuenta</strong>. Un salto que vea puede ser una regla de la firma y no un cambio de todo Tradovate. Consulte las reglas vigentes de su firma para el máximo de contratos y el margen concretos por nivel de cuenta, ya que los actualizan de forma independiente y, como Tradovate, generalmente no le enviarán una notificación cuando lo hagan." },
  ], fr: [
    { type: "paragraph",html: "En bref : Tradovate ne vous prévient pas lorsqu'une exigence de marge augmente. Il n'y a ni fenêtre contextuelle, ni bannière, ni e-mail. L'exigence peut doubler, tripler ou atteindre plusieurs fois son niveau normal quelques minutes avant une publication de nouvelles, et le premier signe que la plupart des traders reçoivent est un rejet d'ordre ou une position qui se réduit toute seule. La solution n'est donc pas un réglage à activer. C'est une habitude : vérifiez vous-même les chiffres de marge en vigueur avant d'augmenter votre taille, et gardez assez de liquidités libres pour qu'un saut temporaire ne puisse pas vous nuire." },
    { type: "paragraph",html: "Cela piège de nombreux traders de futures car tant d'autres choses sur la plateforme vous notifient : exécutions, rejets d'ordres, alertes que vous définissez sur le prix, coupures de connexion. Les changements de marge sont la discrète exception. Voyons pourquoi l'exigence bouge, où lire précisément les chiffres en direct et comment trader pour que la notification manquante cesse d'être un problème." },
    { type: "heading",text: "Ce qui se passe réellement" },
    { type: "paragraph",html: "Une exigence de marge est le montant de valeur de compte nécessaire pour détenir un contrat. Ce n'est pas un nombre fixe. Les bourses fixent une base, les courtiers peuvent y ajouter, et le chiffre évolue avec les conditions de marché. Tradovate publie ces chiffres et les met à jour, mais n'envoie pas de message à votre écran lorsqu'ils changent. Une demande de notification de bureau pour les changements de marge est en attente de longue date et, à ce jour, cette fonction n'existe pas dans la plateforme. Le contournement réellement proposé consiste à consulter la page des marges manuellement." },
    { type: "paragraph",html: "Rien n'est donc cassé de votre côté. Vous ne manquez pas un interrupteur caché dans les paramètres. L'alerte n'est simplement pas encore construite, ce qui signifie que la responsabilité de connaître l'exigence en vigueur vous incombe." },
    { type: "heading",text: "Pourquoi l'exigence saute (et quand)" },
    { type: "paragraph",html: "Deux fenêtres où les marges bougent piègent le plus de monde, auxquelles s'ajoute une raison de fond plus lente." },
    { type: "heading",text: "1. Juste avant les nouvelles économiques programmées" },
    { type: "paragraph",html: "Avant les grandes publications, Tradovate relève les marges intraday à environ <strong class='text-white'>4x son taux standard</strong>. Cela démarre peu avant la publication et reste élevé ensuite jusqu'à ce que la volatilité soit de nouveau jugée gérable. Pensez aux décisions de taux de la FOMC, au CPI, aux Non-Farm Payrolls et aux autres chiffres à fort impact. Le taux élevé s'applique lorsque vous ouvrez une nouvelle position pendant cette fenêtre, de sorte qu'un trade que vous pouviez facilement vous permettre une heure plus tôt peut être rejeté dans les minutes autour du chiffre." },
    { type: "paragraph",html: "C'est de loin la raison la plus courante pour laquelle un trader se heurte à un mur « sans avertissement ». Le marché semble normal, la publication est encore à quelques minutes, et l'ordre rebondit parce que l'exigence a discrètement quadruplé." },
    { type: "heading",text: "2. La clôture quotidienne et la détention overnight" },
    { type: "paragraph",html: "Tradovate applique une marge <em>intraday</em> (« day ») plus basse pendant la séance et une marge <em>initiale</em> plus élevée pour la nuit. Le taux day réduit est généralement disponible de l'ouverture du soir jusqu'à environ 15 minutes avant la clôture quotidienne, moment où la marge initiale plus élevée s'applique. Selon les conditions actuellement publiées, cela correspond à peu près au taux day de 6:00 PM ET à 4:45 PM ET, avec la marge initiale requise d'environ 4:45 à 5:00 PM ET et à tout moment où vous détenez une position à la clôture." },
    { type: "paragraph",html: "Si vous portez une position au-delà de ce seuil sans assez de liquidités pour l'exigence overnight, la plateforme peut la réduire ou la fermer. C'est un autre casse-tête, lié à la raison pour laquelle une position peut se fermer automatiquement à 5PM CT pour la marge overnight, mais la cause racine est la même notification manquante : la marge a augmenté à la clôture et rien ne vous l'a dit." },
    { type: "heading",text: "3. Changements des bourses et des firmes" },
    { type: "paragraph",html: "Le CME et d'autres bourses ajustent les marges selon leur propre calendrier, souvent avant une volatilité connue comme les grands jours fériés, les rollovers de contrats ou des événements inhabituels. Les courtiers et les prop firms peuvent superposer leurs propres exigences. Ces changements sont généralement publiés à l'avance, mais là encore vous ne recevrez aucun signal. Vous devez aller regarder." },
    { type: "heading",text: "Comment vérifier manuellement les exigences de marge" },
    { type: "paragraph",html: "Comme il n'y a pas d'alerte, c'est la compétence centrale. Il existe deux endroits où lire les chiffres, et il vaut la peine d'utiliser les deux." },
    { type: "heading",text: "Option A : la page des marges de Tradovate" },
    { type: "paragraph",html: "Tradovate tient sur son site une page de ressources sur les marges qui liste la marge initiale et intraday par contrat. C'est le moyen le plus rapide de parcourir tout un groupe de produits et de voir où se situe aujourd'hui un symbole que vous tradez. Mettez-la en favori et jetez-y un œil dans votre routine d'avant-séance, surtout les jours de publication programmée." },
    { type: "heading",text: "Option B : le lire dans la plateforme" },
    { type: "paragraph",html: "Vous n'avez pas besoin de quitter l'application. Dans votre Quote Board, faites un clic droit sur le contrat voulu et ouvrez sa vue détaillée de cotation. Ce panneau affiche la marge du contrat ainsi que des détails comme l'échéance. C'est pratique en pleine séance car il reflète le chiffre du contrat exact que vous allez trader, et non une ligne générique d'un tableau." },
    { type: "paragraph",html: "Quand le panneau de détail s'ouvre, repérez les valeurs de marge initiale et de maintien pour ce contrat précis. Si le chiffre vous semble plus élevé que dans votre souvenir, c'est le signe qu'un changement est en vigueur, probablement à cause d'une fenêtre de nouvelles ou du seuil overnight." },
    { type: "quote",html: "Faites de la vérification une routine, pas une réaction. Lire la marge après le rejet de votre ordre, c'est trop tard. Un coup d'œil de dix secondes avant une publication connue ou avant de porter une position overnight vous épargne tout le problème." },
    { type: "heading",text: "Tradez de sorte que l'alerte manquante n'ait pas d'importance" },
    { type: "paragraph",html: "Vérifier le chiffre n'est que la moitié du travail. L'autre moitié consiste à dimensionner pour qu'un saut ne puisse pas forcer un rejet ou une liquidation. Quelques habitudes font l'essentiel." },
    { type: "paragraph",html: "<strong class='text-white'>Gardez un vrai coussin.</strong> Ne tournez pas au bord de votre marge disponible. Si votre marge libre ne couvre la position qu'au taux normal, un saut de 4x lié aux nouvelles la dépassera largement. Conservez assez pour que même une exigence élevée laisse de la place. Vous pouvez suivre votre marge utilisée par rapport à la marge disponible dans le panneau d'informations du compte pendant que vous tradez." },
    { type: "paragraph",html: "<strong class='text-white'>Soyez à plat ou réduisez avant les nouvelles à fort impact.</strong> Si vous ne voulez pas trader la publication, le plus propre est d'être à plat ou plus petit en y entrant. L'exigence élevée vous est alors indifférente. Si vous la tradez, prévoyez d'avoir besoin de plusieurs fois la marge habituelle par contrat." },
    { type: "paragraph",html: "<strong class='text-white'>Respectez le seuil overnight.</strong> Si vous ne comptez pas porter de position overnight, fermez avant la réinitialisation quotidienne pour que la marge initiale plus élevée ne s'applique jamais. Si vous la portez, confirmez que vous disposez du montant de la marge initiale, et pas seulement du taux day." },
    { type: "paragraph",html: "<strong class='text-white'>Surveillez un calendrier économique.</strong> Comme la plateforme ne vous dira pas qu'une publication arrive, gardez ouvert un calendrier des événements à fort impact. Savoir que le CPI sort à 8:30 AM ET vous indique exactement quand la fenêtre de marge s'ouvre, même sans notification." },
    { type: "paragraph",html: "Deux rejets connexes méritent d'être compris tant que vous y êtes : le rejet « insufficient margin / not enough money », conséquence directe d'une exigence qui dépasse vos liquidités libres, et l'auto-liquidation de Tradovate avec les frais qu'elle entraîne, ce qui peut arriver si une position sous-financée est fermée de force. Les deux découlent de la même chose : un chiffre de marge a bougé et rien ne l'a annoncé." },
    { type: "heading",text: "S'il s'agit d'un compte de prop firm ou d'évaluation" },
    { type: "paragraph",html: "Sur un compte financé ou d'évaluation, le tableau des marges a une couche supplémentaire. La prop firm fixe ses propres limites de contrats et ses coussins en plus de ce qu'exigent la bourse et Tradovate, et ces chiffres <strong class='text-white'>varient selon la firme et la taille du compte</strong>. Un saut que vous constatez peut être la règle de la firme et non un changement général de Tradovate. Vérifiez les règles actuelles de votre firme pour le nombre maximal de contrats et la marge par niveau de compte, car elle les met à jour indépendamment et, comme Tradovate, ne vous enverra généralement pas de notification quand elle le fait." },
  ], it: [
    { type: "paragraph",html: "In breve: Tradovate non la avvisa quando un requisito di margine sale. Non c'è pop-up, né banner, né e-mail. Il requisito può raddoppiare, triplicare o salire a molte volte il suo livello normale pochi minuti prima di un rilascio di notizie, e il primo segnale che la maggior parte riceve è un rifiuto d'ordine o una posizione che si riduce da sola. Quindi la soluzione non è un'impostazione da attivare. È un'abitudine: controlli lei stessa le cifre di margine attuali prima di aumentare la dimensione e mantenga abbastanza liquidità libera da evitare che un balzo temporaneo possa danneggiarla." },
    { type: "paragraph",html: "Questo mette in difficoltà molti trader di futures perché tante altre cose sulla piattaforma la notificano: esecuzioni, rifiuti d'ordine, alert che imposta sul prezzo, cadute di connessione. Le variazioni di margine sono la silenziosa eccezione. Vediamo perché il requisito si muove, dove leggere esattamente i numeri in tempo reale e come operare perché la notifica mancante smetta di essere un problema." },
    { type: "heading",text: "Cosa sta succedendo davvero" },
    { type: "paragraph",html: "Un requisito di margine è il valore del conto necessario per mantenere un contratto. Non è un numero fisso. Le borse stabiliscono una base, i broker possono aggiungervi e la cifra cambia con le condizioni di mercato. Tradovate pubblica questi numeri e li aggiorna, ma non invia un messaggio al suo schermo quando cambiano. C'è una richiesta in sospeso di aggiungere una notifica desktop per le variazioni di margine e, al momento, quella funzione non esiste nella piattaforma. Il workaround effettivamente offerto è controllare manualmente la pagina dei margini." },
    { type: "paragraph",html: "Quindi, da parte sua, nulla è rotto. Non le sfugge un interruttore nascosto nelle impostazioni. L'alert semplicemente non è ancora stato realizzato, il che significa che la responsabilità di conoscere il requisito attuale ricade su di lei." },
    { type: "heading",text: "Perché il requisito sale (e quando)" },
    { type: "paragraph",html: "Ci sono due finestre in cui i margini si muovono che colgono più spesso di sorpresa, più una ragione di fondo più lenta." },
    { type: "heading",text: "1. Subito prima di notizie economiche programmate" },
    { type: "paragraph",html: "Prima dei grandi rilasci, Tradovate porta i margini intraday a circa <strong class='text-white'>4x la sua tariffa standard</strong>. Ciò scatta poco prima del rilascio e rimane elevato dopo di esso finché la volatilità non viene di nuovo giudicata gestibile. Pensi alle decisioni sui tassi della FOMC, al CPI, ai Non-Farm Payrolls e agli altri dati ad alto impatto. La tariffa elevata si applica quando apre una nuova posizione in quella finestra, quindi un trade che un'ora prima poteva permettersi senza problemi può essere rifiutato nei minuti attorno al dato." },
    { type: "paragraph",html: "Questa è di gran lunga la ragione più comune per cui un trader si scontra con un muro “senza preavviso”. Il mercato sembra normale, il rilascio è ancora a qualche minuto e l'ordine rimbalza perché il requisito è silenziosamente quadruplicato." },
    { type: "heading",text: "2. La chiusura giornaliera e il mantenimento overnight" },
    { type: "paragraph",html: "Tradovate usa un margine <em>intraday</em> (“day”) più basso durante la sessione e un margine <em>iniziale</em> più alto per la notte. La tariffa day ridotta è in genere disponibile dall'apertura serale fino a circa 15 minuti prima della chiusura giornaliera, momento in cui si applica il margine iniziale più alto. Nelle condizioni attualmente pubblicate, è all'incirca la tariffa day da circa le 6:00 PM ET alle 4:45 PM ET, con il margine iniziale richiesto da circa le 4:45 alle 5:00 PM ET e ogni volta che detiene una posizione alla chiusura." },
    { type: "paragraph",html: "Se porta una posizione oltre quel limite senza abbastanza liquidità per il requisito overnight, la piattaforma può ridurla o chiuderla. È un altro mal di testa, legato al motivo per cui una posizione può chiudersi automaticamente alle 5PM CT per il margine overnight, ma la causa di fondo è la stessa notifica mancante: il margine è salito alla chiusura e nulla gliel'ha detto." },
    { type: "heading",text: "3. Modifiche di borse e firm" },
    { type: "paragraph",html: "Il CME e altre borse modificano i margini secondo i propri tempi, spesso prima di volatilità nota come grandi festività, rollover di contratti o eventi insoliti. I broker e le prop firm possono sovrapporre i propri requisiti. Queste modifiche sono di solito pubblicate in anticipo, ma anche qui non riceverà alcun avviso. Deve andare a controllare." },
    { type: "heading",text: "Come controllare manualmente i requisiti di margine" },
    { type: "paragraph",html: "Poiché non c'è alcun alert, questa è la competenza centrale. Ci sono due posti in cui leggere i numeri ed è utile usarli entrambi." },
    { type: "heading",text: "Opzione A: la pagina dei margini di Tradovate" },
    { type: "paragraph",html: "Tradovate mantiene sul proprio sito una pagina di risorse sui margini che elenca il margine iniziale e intraday per contratto. È il modo più rapido per scorrere un intero gruppo di prodotti e vedere dove si colloca oggi un simbolo che negozia. La metta tra i segnalibri e le dia un'occhiata nella sua routine pre-sessione, soprattutto nei giorni con un rilascio programmato." },
    { type: "heading",text: "Opzione B: leggerlo all'interno della piattaforma" },
    { type: "paragraph",html: "Non deve uscire dall'app. Nel suo Quote Board, faccia clic destro sul contratto desiderato e apra la sua vista di dettaglio della quotazione. Quel pannello mostra il margine del contratto insieme a dettagli come la scadenza. È comodo a sessione in corso perché riflette la cifra del contratto esatto che sta per negoziare, non una riga generica di una tabella." },
    { type: "paragraph",html: "Quando si apre il pannello di dettaglio, cerchi i valori di margine iniziale e di mantenimento per quello specifico contratto. Se il numero le sembra più alto di quanto ricordasse, è il segnale che una variazione è in vigore, probabilmente per una finestra di notizie o per il limite notturno." },
    { type: "quote",html: "Faccia del controllo una routine, non una reazione. Leggere il margine dopo che l'ordine è stato rifiutato è troppo tardi. Uno sguardo di dieci secondi prima di un rilascio noto o prima di mantenere la posizione overnight risolve tutto il problema." },
    { type: "heading",text: "Operi in modo che l'alert mancante non conti" },
    { type: "paragraph",html: "Controllare il numero è metà dell'opera. L'altra metà è dimensionare in modo che un balzo non possa forzare un rifiuto o una liquidazione. Poche abitudini fanno la maggior parte del lavoro." },
    { type: "paragraph",html: "<strong class='text-white'>Mantenga un vero cuscinetto.</strong> Non operi al limite del margine disponibile. Se il suo margine libero copre la posizione solo alla tariffa normale, un balzo di 4x da notizie lo supererà di netto. Tenga abbastanza da lasciare spazio anche con un requisito elevato. Può osservare il margine usato rispetto a quello disponibile nel pannello informativo del conto mentre opera." },
    { type: "paragraph",html: "<strong class='text-white'>Chiuda o riduca prima di notizie ad alto impatto.</strong> Se non vuole negoziare il rilascio, la mossa più pulita è essere flat o più piccolo all'ingresso. Allora il requisito elevato per lei è irrilevante. Se lo negozia, preventivi di aver bisogno di molte volte il margine abituale per contratto." },
    { type: "paragraph",html: "<strong class='text-white'>Rispetti il limite notturno.</strong> Se non intende mantenere la posizione overnight, chiuda prima del reset giornaliero in modo che il margine iniziale più alto non si applichi mai. Se la mantiene, confermi di avere l'importo del margine iniziale, non solo la tariffa day." },
    { type: "paragraph",html: "<strong class='text-white'>Segua un calendario economico.</strong> Poiché la piattaforma non le dirà che sta per arrivare un rilascio, tenga aperto un calendario degli eventi ad alto impatto. Sapere che il CPI esce alle 8:30 AM ET le dice esattamente quando si apre la finestra di margine, anche senza notifica." },
    { type: "paragraph",html: "Due rifiuti correlati meritano di essere compresi, già che c'è: il rifiuto per “insufficient margin / not enough money”, risultato diretto di un requisito che supera la sua liquidità libera, e l'auto-liquidazione di Tradovate con la commissione che applica, che è ciò che può succedere se una posizione sottofinanziata viene chiusa forzatamente. Entrambi derivano dalla stessa cosa: un numero di margine si è mosso e nulla l'ha annunciato." },
    { type: "heading",text: "Se è un conto di prop firm o di valutazione" },
    { type: "paragraph",html: "Su un conto finanziato o di valutazione, il quadro dei margini ha un livello in più. La prop firm stabilisce propri limiti di contratti e cuscinetti oltre a ciò che richiedono la borsa e Tradovate, e quei numeri <strong class='text-white'>variano per firm e dimensione del conto</strong>. Un balzo che vede può essere una regola della firm e non una modifica valida per tutto Tradovate. Controlli le regole attuali della sua firm per il massimo di contratti e il margine specifici per livello di conto, dato che le aggiornano in modo indipendente e, come Tradovate, in genere non le invieranno una notifica quando lo fanno." },
  ] },
  ctaHeading: { en: "Stop Babysitting the Margin Table", de: "Schluss mit der manuellen Margin-Tabelle", es: "Deje de vigilar la tabla de márgenes", fr: "Arrêtez de surveiller le tableau des marges", it: "Smetta di sorvegliare la tabella dei margini" },
  ctaText: { en: "PickMyTrade automates your TradingView strategy into Tradovate with position-size and risk controls you set in advance, so your entries follow your rules instead of you watching a margin table by hand.", de: "PickMyTrade automatisiert Ihre TradingView-Strategie in Tradovate mit Positionsgrößen- und Risikokontrollen, die Sie vorab festlegen. So folgen Ihre Einstiege Ihren Regeln, statt dass Sie eine Margin-Tabelle von Hand beobachten.", es: "PickMyTrade automatiza su estrategia de TradingView en Tradovate con controles de tamaño de posición y de riesgo que usted define de antemano, de modo que sus entradas sigan sus reglas en lugar de que usted vigile una tabla de márgenes a mano.", fr: "PickMyTrade automatise votre stratégie TradingView vers Tradovate avec des contrôles de taille de position et de risque que vous définissez à l'avance, afin que vos entrées suivent vos règles au lieu que vous surveilliez un tableau de marges à la main.", it: "PickMyTrade automatizza la sua strategia TradingView su Tradovate con controlli di dimensione della posizione e di rischio che lei imposta in anticipo, così le sue entrate seguono le sue regole invece di dover controllare a mano una tabella dei margini." },
  ctaButtonText: { en: "Start Your Free 7-Day Trial", de: "Starten Sie Ihre kostenlose 7-Tage-Testphase", es: "Comience su prueba gratuita de 7 días", fr: "Commencez votre essai gratuit de 7 jours", it: "Inizi la prova gratuita di 7 giorni" },
  ctaUrl: "https://app.pickmytrade.trade/?register=true&utm_source=content&utm_medium=debugging",
  faqHeading: { en: "Frequently Asked Questions", de: "Häufig gestellte Fragen", es: "Preguntas frecuentes", fr: "Questions fréquentes", it: "Domande frequenti" },
  faqs: { en: [
    { q: "Does Tradovate send an alert when margin requirements go up?", a: "No. There's no in-app pop-up, push, or email for a margin change. The only reliable way to know is to check the figure yourself before you size up around news and near the close." },
    { q: "When do Tradovate margins usually increase?", a: "Two common windows. Ahead of major scheduled economic news, intraday margins are raised to about 4x the standard rate and stay elevated until volatility settles. And near the daily close, the reduced intraday rate is replaced by the higher initial (overnight) margin. Exchanges and prop firms can also change requirements on their own schedule." },
    { q: "Where can I see the current margin for a contract?", a: "On the Tradovate margins resources page for a per-contract breakdown, and inside the platform by right-clicking the symbol in your Quote Board and opening the quote detail view to read initial and maintenance margin for that contract." },
    { q: "Can I set a price alert to warn me about a margin change?", a: "No. Price alerts track price, not margin, so they won't fire on a requirement change. The practical substitute is watching an economic calendar for high-impact releases and keeping a cash buffer so a temporary jump can't put you into a margin call." },
    { q: "Why did my order get rejected or my position get liquidated right before a news release?", a: "Almost always the elevated intraday margin. When the requirement jumps to several times normal, your free margin may no longer cover the position, so a new order is rejected or an underfunded position gets reduced. Sizing for the higher requirement avoids it." },
  ], de: [
    { q: "Sendet Tradovate einen Alert, wenn Margin-Anforderungen steigen?", a: "Nein. Es gibt kein In-App-Pop-up, keine Push-Nachricht und keine E-Mail bei einer Margin-Änderung. Verlässlich wissen Sie es nur, wenn Sie den Wert selbst prüfen, bevor Sie rund um Nachrichten und kurz vor Handelsschluss die Positionsgröße erhöhen." },
    { q: "Wann steigen die Tradovate-Margins üblicherweise?", a: "In zwei typischen Zeitfenstern. Vor wichtigen, terminierten Wirtschaftsnachrichten werden die Intraday-Margins auf etwa das 4-Fache des Standardsatzes angehoben und bleiben erhöht, bis sich die Volatilität beruhigt. Und kurz vor dem täglichen Handelsschluss wird der reduzierte Intraday-Satz durch die höhere Initial-Margin (über Nacht) ersetzt. Börsen und Prop-Firmen können Anforderungen außerdem nach eigenem Zeitplan ändern." },
    { q: "Wo sehe ich die aktuelle Margin für einen Kontrakt?", a: "Auf der Tradovate-Seite mit den Margin-Ressourcen für eine Aufschlüsselung pro Kontrakt und innerhalb der Plattform, indem Sie in Ihrem Quote Board mit der rechten Maustaste auf das Symbol klicken und die Kursdetailansicht öffnen, um Initial- und Maintenance-Margin für diesen Kontrakt zu lesen." },
    { q: "Kann ich einen Preisalarm setzen, der mich vor einer Margin-Änderung warnt?", a: "Nein. Preisalarme verfolgen den Preis, nicht die Margin, und lösen daher bei einer Änderung der Anforderung nicht aus. Der praktische Ersatz ist, einen Wirtschaftskalender auf wichtige Veröffentlichungen im Blick zu behalten und einen Cash-Puffer vorzuhalten, damit ein vorübergehender Sprung Sie nicht in einen Margin Call treibt." },
    { q: "Warum wurde meine Order abgelehnt oder meine Position liquidiert, kurz bevor eine Nachricht erschien?", a: "Fast immer wegen der erhöhten Intraday-Margin. Springt die Anforderung auf ein Vielfaches des Normalwerts, deckt Ihre freie Margin die Position möglicherweise nicht mehr, sodass eine neue Order abgelehnt oder eine unterfinanzierte Position verkleinert wird. Wer die Positionsgröße auf die höhere Anforderung auslegt, vermeidet das." },
