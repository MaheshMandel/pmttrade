---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "android-black-screen-launch";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/debugging/${SLUG}`;

const META_TITLE = "Tradovate Android App Black Screen on Launch";
const META_DESCRIPTION =
  "Android app opening to a black screen on launch? Clear the app's cache and storage, then relaunch to fix it fast, full step-by-step guide inside.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Tradovate Android App: Schwarzer Bildschirm beim Start", es: "Pantalla negra al abrir la app de Tradovate en Android", fr: "Écran noir au lancement de l'appli Tradovate sous Android", it: "Schermata nera all'avvio dell'app Tradovate su Android" },
  dek: { en: "The Tradovate Android app opens to a solid black screen instead of your dashboard. Here's the exact order to clear the cache, clear storage, and relaunch to get it painting again.", de: "Die Tradovate Android-App öffnet sich mit einem komplett schwarzen Bildschirm statt Ihrem Dashboard. Hier ist die genaue Reihenfolge, um den Cache zu leeren, den Speicher zu löschen und die App neu zu starten, damit sie wieder normal lädt.", es: "La app de Tradovate para Android se abre con una pantalla completamente negra en lugar de mostrar su panel. Aquí tiene el orden exacto para borrar la caché, borrar el almacenamiento y reiniciar la app para que vuelva a funcionar.", fr: "L'application Tradovate pour Android s'ouvre sur un écran entièrement noir au lieu de votre tableau de bord. Voici l'ordre exact pour vider le cache, effacer le stockage et relancer l'application afin qu'elle s'affiche à nouveau normalement.", it: "L'app Tradovate per Android si apre con una schermata completamente nera invece della dashboard. Ecco l'ordine esatto per svuotare la cache, cancellare l'archiviazione e riavviare l'app per farla tornare a funzionare correttamente." },
  readTime: { en: "6 min read", de: "6 Minuten Lesezeit", es: "Lectura de 6 minutos", fr: "Lecture de 6 minutes", it: "Lettura di 6 minuti" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "You tap the Tradovate icon, the splash flashes for a second, and then&hellip; nothing. Just a solid black rectangle where the login screen or your dashboard should be. The status bar and navigation buttons are still there, so the phone's fine, but the app itself never paints. It happens across Android phones, and it's been reported on newer hardware like the Galaxy S21, so it isn't a &ldquo;your device is too old&rdquo; problem on its own." },
    { type: "paragraph", html: "Here's the good news up front: this is almost never an account or a money problem. It's a corrupted local cache or a bad chunk of stored data sitting on your phone, usually left behind after an app update, a forced close, or a stretch where the device was low on storage. The fix that clears it is quick and reliable, <strong class='text-white'>clear the app's cache, then clear its storage, then relaunch</strong>. Below is the exact order to do it in, the fallbacks if the first pass doesn't take, and how to keep managing your open risk while the phone app is dark." },
    {
      type: "checklist",
      heading: "Quick Checklist to Fix the Black Screen",
      items: [
        "<strong class='text-white'>Clear the cache first.</strong> It's non-destructive and keeps you logged in. Relaunch and check.",
        "<strong class='text-white'>Still black? Clear storage / data.</strong> This wipes local data and logs you out, have your Tradovate or prop-firm credentials ready.",
        "<strong class='text-white'>Force stop, then reopen the app.</strong> A clean restart after clearing data gives it a fresh start.",
        "<strong class='text-white'>Update the app</strong> from the Play Store, a stale build against a newer OS can fail to render.",
        "<strong class='text-white'>Restart the phone</strong> to clear memory and kill any stuck background process.",
        "<strong class='text-white'>Free up storage space</strong> if the device is nearly full.",
        "<strong class='text-white'>Reinstall</strong> as a last resort, uninstall, restart, reinstall fresh.",
        "<strong class='text-white'>Manage open trades from web or desktop</strong> while you fix the phone. Your orders are still live on Tradovate's servers.",
      ],
    },
    { type: "heading", text: "What's Actually Happening on Launch" },
    { type: "paragraph", html: "The Tradovate mobile app is a native build (made with Flutter) that loads a chunk of local state the moment it opens, session tokens, layout, cached market and account data. When any of that stored data is corrupted or half-written, the app's first frame can't finish drawing. Instead of falling back to a clean login screen, it hangs on the black canvas it started with. That's the black screen you're staring at." },
    { type: "paragraph", html: "Corruption like this tends to show up right after an app update swaps out files, after Android force-kills the app in the background to reclaim memory, or when the phone ran out of free storage mid-write. None of those touch your account. Your balance, your working orders, and any open positions are held server-side at Tradovate, not on the phone, which is exactly why wiping the local data is safe and why signing back in restores everything." },
    { type: "quote", html: "Before you start clearing anything, know the trade-off: clearing <strong class='text-white'>cache</strong> is harmless and keeps you signed in, while clearing <strong class='text-white'>storage</strong> (also labeled &ldquo;Clear data&rdquo;) logs you out. Try cache first, and only move to storage if the black screen survives." },
    { type: "heading", text: "Fix It: Clear Cache, Clear Storage, Relaunch" },
    {
      type: "steps",
      items: [
        { title: "Clear the cache (try this first)", html: "Open your phone's <strong class='text-white'>Settings &rarr; Apps</strong> (some phones call it &ldquo;Apps &amp; notifications &rarr; See all apps&rdquo;), scroll to <strong class='text-white'>Tradovate: Futures Trading</strong>, and tap it to open the app info screen. Tap <strong class='text-white'>Storage</strong> (on many phones it reads &ldquo;Storage &amp; cache&rdquo;), then tap <strong class='text-white'>Clear cache</strong>. This dumps temporary files without touching your login. Back out, reopen Tradovate, and see if it loads. The exact wording and menu path shift a little between Android versions and phone makers, Samsung, Pixel, and others each phrase it slightly differently, but the destination is the same: the Tradovate app's Storage screen, where the cache and data controls live." },
        { title: "Clear storage / data (if cache alone didn't do it)", html: "Still black after clearing cache and relaunching? Go back to that same Storage screen and tap <strong class='text-white'>Clear storage</strong> (labeled <strong class='text-white'>Clear data</strong> on some devices). This is the step that actually clears the corrupted local state, and it logs you out, so make sure you know your Tradovate or prop-firm username and password before you tap it. Confirm the prompt, and the app's local data resets to a clean slate." },
        { title: "Force stop, then relaunch and sign in", html: "From the same app info screen, tap <strong class='text-white'>Force stop</strong> to make sure no stale process is lingering, then open Tradovate fresh from your home screen. It should load straight to the login screen. Sign in with your credentials, and your accounts, positions, and orders sync right back down from the server." },
      ],
    },
    { type: "paragraph", html: "For the large majority of black-screen cases, that three-step pass is the whole fix. If yours is stubborn, work through the fallbacks below in order." },
    { type: "heading", text: "If It's Still Black After Clearing Data" },
    { type: "heading", text: "Update the app" },
    { type: "paragraph", html: "Open the Play Store, search for Tradovate, and install any pending update. A build that's a few versions behind the current Android release can miss a rendering fix and hang on launch. Running the latest version rules that out." },
    { type: "heading", text: "Restart the phone" },
    { type: "paragraph", html: "Power the device fully off, wait a few seconds, and turn it back on. A reboot clears memory and kills any wedged background service that a simple app relaunch won't touch. Reopen Tradovate afterward." },
    { type: "heading", text: "Free up storage space" },
    { type: "paragraph", html: "If your phone is nearly full, apps can fail to write the files they need at startup, which is one of the ways the cache gets corrupted in the first place. Delete unused apps, photos, or downloads to open up a few gigabytes, then relaunch." },
    { type: "heading", text: "Check your Android version" },
    { type: "paragraph", html: "The Tradovate app requires <strong class='text-white'>Android 7.0 or higher</strong>. On an older OS it may refuse to launch or render properly. Check <strong class='text-white'>Settings &rarr; About phone &rarr; Software information</strong> for your version, and take any OS update your device offers." },
    { type: "heading", text: "Reinstall as a last resort" },
    { type: "paragraph", html: "If none of the above works, uninstall Tradovate completely, restart the phone, then reinstall a fresh copy from the Play Store and log back in. A reinstall guarantees a clean install of the current build, it's the same idea as clearing storage, just more thorough and slower, which is why it's the last stop rather than the first." },
    { type: "heading", text: "Manage Your Risk While the App Is Dark" },
    { type: "paragraph", html: "A black screen on one phone doesn't cancel your orders. Every stop and target you placed is resting on Tradovate's servers and continues to work no matter what your mobile app is showing. If you're in a live position when the app goes black, don't panic-trade, open the <strong class='text-white'>Tradovate web platform</strong> in a browser or the <strong class='text-white'>desktop app</strong> on a computer, and you'll see the exact same account with full control to modify or flatten. Treat the phone as one window into your account, never the only one." },
    { type: "heading", text: "Troubleshooting Table" },
    {
      type: "table",
      headers: ["Symptom", "Likely cause", "Fix"],
      rows: [
        ["Black screen right after the splash", "Corrupted app cache", "Settings &rarr; Apps &rarr; Tradovate &rarr; Storage &rarr; Clear cache, then relaunch"],
        ["Cache clear didn't help", "Corrupted stored data / session", "Clear storage (Clear data), logs you out, then sign back in"],
        ["Black screen returns after an update", "Stale build or leftover files", "Update from the Play Store; reinstall if needed"],
        ["App hangs and phone feels sluggish", "Low free storage / stuck process", "Free up space and restart the phone"],
        ["App won't launch at all on an old phone", "Android version below the minimum", "Confirm Android 7.0+ and update the OS"],
        ["You're in a trade and the app is dark", "Client-side render failure only", "Manage the position from web or desktop; orders are still live"],
      ],
    },
    { type: "heading", text: "Keep Trading Even When the Mobile App Won't Load" },
    { type: "paragraph", html: "If a phone that won't render has ever cost you a fill, the fix is to stop depending on any single client being open. PickMyTrade links your TradingView alerts straight to Tradovate and runs the execution on our servers, so your automation keeps firing whether or not your phone app is painting a screen:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Server-side execution</strong>, alerts route from TradingView to Tradovate through our infrastructure, so a black-screened phone never stops an entry or an exit from going through.",
        "<strong class='text-white'>Device independence</strong>, nothing needs the mobile app open. Your strategy fires from the alert, not from whichever client happens to be running.",
        "<strong class='text-white'>Stops and targets that stick</strong>, SL/TP defined in the alert are placed on Tradovate regardless of the device you're holding, so protection doesn't hinge on the app rendering.",
        "<strong class='text-white'>Multi-account sync</strong>, mirror the same orders across every connected account at once, so no account is left unmanaged while you troubleshoot a phone.",
      ],
    },
  ], de: [
    { type: "paragraph", html: "Sie tippen auf das Tradovate-Symbol, der Splash-Screen blitzt kurz auf, und dann&hellip; nichts. Nur ein durchgehend schwarzes Rechteck, wo der Anmeldebildschirm oder Ihr Dashboard sein sollte. Die Statusleiste und die Navigationsschaltflächen sind noch da, das Telefon funktioniert also einwandfrei, aber die App selbst baut sich nie auf. Das passiert bei verschiedenen Android-Telefonen und wurde auch auf neuerer Hardware wie dem Galaxy S21 gemeldet, es ist also nicht nur ein Problem &ldquo;Ihr Gerät ist zu alt&rdquo;." },
    { type: "paragraph", html: "Die gute Nachricht vorweg: Das ist so gut wie nie ein Konto- oder Geldproblem. Es handelt sich um einen beschädigten lokalen Cache oder einen fehlerhaften Teil gespeicherter Daten auf Ihrem Telefon, meist zurückgeblieben nach einem App-Update, einem erzwungenen Beenden oder einer Phase, in der das Gerät wenig Speicherplatz hatte. Die Lösung dafür ist schnell und zuverlässig: <strong class='text-white'>zuerst den Cache der App leeren, dann den Speicher löschen und anschließend neu starten</strong>. Im Folgenden finden Sie die genaue Reihenfolge dafür, die Alternativen, falls der erste Versuch nicht greift, sowie Hinweise, wie Sie Ihr offenes Risiko weiter im Griff behalten, solange die Telefon-App schwarz bleibt." },
    {
      type: "checklist",
      heading: "Kurz-Checkliste zur Behebung des schwarzen Bildschirms",
      items: [
        "<strong class='text-white'>Zuerst den Cache leeren.</strong> Das ist nicht destruktiv und Sie bleiben angemeldet. Neu starten und prüfen.",
        "<strong class='text-white'>Immer noch schwarz? Speicher / Daten löschen.</strong> Dadurch werden lokale Daten gelöscht und Sie werden abgemeldet, halten Sie Ihre Tradovate- oder Prop-Firm-Zugangsdaten bereit.",
        "<strong class='text-white'>Erzwungenes Beenden, dann die App neu öffnen.</strong> Ein sauberer Neustart nach dem Löschen der Daten gibt der App einen frischen Start.",
        "<strong class='text-white'>Die App aktualisieren</strong> über den Play Store, ein veralteter Build gegen ein neueres Betriebssystem kann Darstellungsfehler verursachen.",
        "<strong class='text-white'>Das Telefon neu starten</strong>, um den Speicher zu leeren und jeden hängengebliebenen Hintergrundprozess zu beenden.",
        "<strong class='text-white'>Speicherplatz freigeben</strong>, wenn das Gerät fast voll ist.",
        "<strong class='text-white'>Neu installieren</strong> als letzten Ausweg, deinstallieren, neu starten, frisch installieren.",
        "<strong class='text-white'>Offene Trades über Web oder Desktop verwalten</strong>, während Sie das Telefon reparieren. Ihre Orders sind weiterhin live auf den Servern von Tradovate.",
      ],
    },
    { type: "heading", text: "Was beim Start eigentlich passiert" },
    { type: "paragraph", html: "Die mobile Tradovate-App ist eine native Anwendung (entwickelt mit Flutter), die beim Öffnen sofort einen Teil des lokalen Zustands lädt, Sitzungs-Tokens, Layout, zwischengespeicherte Markt- und Kontodaten. Wenn einer dieser gespeicherten Daten beschädigt oder nur halb geschrieben ist, kann die App den ersten Frame nicht fertig zeichnen. Statt auf einen sauberen Anmeldebildschirm zurückzufallen, bleibt sie auf der schwarzen Fläche hängen, mit der sie gestartet ist. Das ist der schwarze Bildschirm, den Sie sehen." },
    { type: "paragraph", html: "Solche Beschädigungen treten meist direkt nach einem App-Update auf, das Dateien austauscht, nachdem Android die App im Hintergrund zwangsweise beendet hat, um Speicher freizugeben, oder wenn dem Telefon während eines Schreibvorgangs der freie Speicher ausging. Nichts davon betrifft Ihr Konto. Ihr Guthaben, Ihre offenen Orders und alle offenen Positionen werden serverseitig bei Tradovate gespeichert, nicht auf dem Telefon, weshalb das Löschen der lokalen Daten sicher ist und weshalb beim erneuten Anmelden wieder alles hergestellt wird." },
    { type: "quote", html: "Bevor Sie mit dem Löschen beginnen, sollten Sie den Unterschied kennen: Das Leeren des <strong class='text-white'>Cache</strong> ist unbedenklich und Sie bleiben angemeldet, während das Löschen des <strong class='text-white'>Speichers</strong> (auch als &ldquo;Daten löschen&rdquo; bezeichnet) Sie abmeldet. Probieren Sie zuerst den Cache und wechseln Sie nur dann zum Speicher, wenn der schwarze Bildschirm bestehen bleibt." },
    { type: "heading", text: "So beheben Sie es: Cache leeren, Speicher löschen, neu starten" },
    {
      type: "steps",
      items: [
        { title: "Cache leeren (zuerst versuchen)", html: "Öffnen Sie auf Ihrem Telefon <strong class='text-white'>Einstellungen &rarr; Apps</strong> (auf manchen Telefonen heißt es &ldquo;Apps &amp; Benachrichtigungen &rarr; Alle Apps anzeigen&rdquo;), scrollen Sie zu <strong class='text-white'>Tradovate: Futures Trading</strong> und tippen Sie darauf, um den Info-Bildschirm der App zu öffnen. Tippen Sie auf <strong class='text-white'>Speicher</strong> (auf vielen Telefonen steht dort &ldquo;Speicher &amp; Cache&rdquo;), dann auf <strong class='text-white'>Cache leeren</strong>. Dadurch werden temporäre Dateien gelöscht, ohne Ihre Anmeldung zu beeinträchtigen. Gehen Sie zurück, öffnen Sie Tradovate erneut, und prüfen Sie, ob es lädt. Der genaue Wortlaut und Menüpfad unterscheidet sich etwas zwischen Android-Versionen und Telefonherstellern, Samsung, Pixel und andere formulieren es jeweils etwas anders, aber das Ziel ist immer dasselbe: der Speicher-Bildschirm der Tradovate-App, auf dem sich die Cache- und Datensteuerung befindet." },
        { title: "Speicher / Daten löschen (wenn der Cache allein nicht geholfen hat)", html: "Immer noch schwarz, nachdem Sie den Cache geleert und neu gestartet haben? Gehen Sie zurück zum selben Speicher-Bildschirm und tippen Sie auf <strong class='text-white'>Speicher löschen</strong> (auf manchen Geräten als <strong class='text-white'>Daten löschen</strong> bezeichnet). Dieser Schritt löscht tatsächlich den beschädigten lokalen Zustand und meldet Sie dabei ab, stellen Sie also sicher, dass Sie Ihren Tradovate- oder Prop-Firm-Benutzernamen und Ihr Passwort kennen, bevor Sie darauf tippen. Bestätigen Sie die Abfrage, und die lokalen Daten der App werden auf einen sauberen Zustand zurückgesetzt." },
        { title: "Erzwungenes Beenden, dann neu starten und anmelden", html: "Tippen Sie auf demselben Info-Bildschirm der App auf <strong class='text-white'>Beenden erzwingen</strong>, um sicherzustellen, dass kein veralteter Prozess mehr läuft, und öffnen Sie Tradovate anschließend frisch über Ihren Startbildschirm. Es sollte direkt zum Anmeldebildschirm laden. Melden Sie sich mit Ihren Zugangsdaten an, und Ihre Konten, Positionen und Orders werden sofort wieder vom Server synchronisiert." },
      ],
    },
    { type: "paragraph", html: "In den meisten Fällen von schwarzem Bildschirm ist dieser Drei-Schritte-Ablauf bereits die vollständige Lösung. Wenn Ihr Fall hartnäckig ist, arbeiten Sie die folgenden Alternativen der Reihe nach durch." },
    { type: "heading", text: "Wenn der Bildschirm nach dem Löschen der Daten immer noch schwarz ist" },
    { type: "heading", text: "Die App aktualisieren" },
    { type: "paragraph", html: "Öffnen Sie den Play Store, suchen Sie nach Tradovate und installieren Sie alle ausstehenden Updates. Ein Build, der der aktuellen Android-Version um ein paar Versionen hinterherhinkt, kann eine Darstellungskorrektur verpassen und beim Start hängen bleiben. Mit der neuesten Version schließen Sie das aus." },
    { type: "heading", text: "Das Telefon neu starten" },
    { type: "paragraph", html: "Schalten Sie das Gerät vollständig aus, warten Sie ein paar Sekunden und schalten Sie es wieder ein. Ein Neustart leert den Speicher und beendet jeden feststeckenden Hintergrunddienst, den ein einfaches Neustarten der App nicht erreicht. Öffnen Sie Tradovate danach erneut." },
    { type: "heading", text: "Speicherplatz freigeben" },
    { type: "paragraph", html: "Wenn Ihr Telefon fast voll ist, können Apps die beim Start benötigten Dateien nicht schreiben, was einer der Gründe ist, warum der Cache überhaupt erst beschädigt wird. Löschen Sie nicht benötigte Apps, Fotos oder Downloads, um ein paar Gigabyte freizugeben, und starten Sie dann neu." },
    { type: "heading", text: "Ihre Android-Version prüfen" },
    { type: "paragraph", html: "Die Tradovate-App benötigt <strong class='text-white'>Android 7.0 oder höher</strong>. Auf einem älteren Betriebssystem kann sie sich weigern zu starten oder korrekt darzustellen. Prüfen Sie unter <strong class='text-white'>Einstellungen &rarr; Über das Telefon &rarr; Software-Informationen</strong> Ihre Version, und installieren Sie jedes verfügbare Betriebssystem-Update." },
    { type: "heading", text: "Neuinstallation als letzter Ausweg" },
    { type: "paragraph", html: "Wenn nichts davon funktioniert, deinstallieren Sie Tradovate vollständig, starten Sie das Telefon neu, installieren Sie dann eine frische Kopie aus dem Play Store und melden Sie sich erneut an. Eine Neuinstallation garantiert eine saubere Installation des aktuellen Builds, es ist im Grunde dasselbe wie das Löschen des Speichers, nur gründlicher und langsamer, weshalb es der letzte statt der erste Schritt ist." },
    { type: "heading", text: "Ihr Risiko verwalten, während die App schwarz bleibt" },
    { type: "paragraph", html: "Ein schwarzer Bildschirm auf einem Telefon storniert Ihre Orders nicht. Jeder Stop und jedes Ziel, das Sie gesetzt haben, liegt weiterhin auf den Servern von Tradovate und funktioniert unabhängig davon, was Ihre mobile App anzeigt. Wenn Sie sich in einer laufenden Position befinden, während die App schwarz wird, geraten Sie nicht in Panik, öffnen Sie die <strong class='text-white'>Tradovate-Webplattform</strong> in einem Browser oder die <strong class='text-white'>Desktop-App</strong> auf einem Computer, und Sie sehen dasselbe Konto mit voller Kontrolle, um Positionen anzupassen oder zu schließen. Betrachten Sie das Telefon als eines von mehreren Fenstern zu Ihrem Konto, niemals als das einzige." },
    { type: "heading", text: "Fehlerbehebungstabelle" },
    {
      type: "table",
      headers: ["Symptom", "Wahrscheinliche Ursache", "Lösung"],
      rows: [
        ["Schwarzer Bildschirm direkt nach dem Splash-Screen", "Beschädigter App-Cache", "Einstellungen &rarr; Apps &rarr; Tradovate &rarr; Speicher &rarr; Cache leeren, dann neu starten"],
        ["Cache-Löschung hat nicht geholfen", "Beschädigte gespeicherte Daten / Sitzung", "Speicher löschen (Daten löschen), Sie werden abgemeldet, dann erneut anmelden"],
        ["Schwarzer Bildschirm kehrt nach einem Update zurück", "Veralteter Build oder zurückgebliebene Dateien", "Über den Play Store aktualisieren; bei Bedarf neu installieren"],
        ["App hängt und Telefon wirkt träge", "Wenig freier Speicher / feststeckender Prozess", "Speicherplatz freigeben und Telefon neu starten"],
        ["App startet auf einem alten Telefon gar nicht", "Android-Version unter dem Minimum", "Android 7.0+ sicherstellen und Betriebssystem aktualisieren"],
        ["Sie sind in einem Trade und die App bleibt schwarz", "Nur clientseitiger Darstellungsfehler", "Position über Web oder Desktop verwalten; Orders sind weiterhin aktiv"],
      ],
    },
    { type: "heading", text: "Weiterhandeln, auch wenn die mobile App nicht lädt" },
    { type: "paragraph", html: "Wenn ein Telefon, das nicht rendert, Sie schon einmal eine Order gekostet hat, ist die Lösung, sich nicht mehr auf einen einzelnen offenen Client zu verlassen. PickMyTrade verbindet Ihre TradingView-Alerts direkt mit Tradovate und führt die Ausführung auf unseren Servern aus, sodass Ihre Automatisierung weiterhin auslöst, egal ob Ihre Telefon-App gerade einen Bildschirm anzeigt oder nicht:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Serverseitige Ausführung</strong>, Alerts werden von TradingView über unsere Infrastruktur an Tradovate weitergeleitet, sodass ein schwarzes Telefon niemals einen Einstieg oder Ausstieg verhindert.",
        "<strong class='text-white'>Geräteunabhängigkeit</strong>, nichts erfordert, dass die mobile App geöffnet ist. Ihre Strategie löst über den Alert aus, nicht über den gerade laufenden Client.",
        "<strong class='text-white'>Stops und Ziele, die halten</strong>, im Alert definierte SL/TP werden unabhängig vom verwendeten Gerät auf Tradovate platziert, sodass der Schutz nicht davon abhängt, ob die App etwas anzeigt.",
        "<strong class='text-white'>Multi-Konto-Synchronisierung</strong>, spiegeln Sie dieselben Orders gleichzeitig auf jedem verbundenen Konto, sodass kein Konto unbetreut bleibt, während Sie ein Telefon reparieren.",
      ],
    },
  ], es: [
    { type: "paragraph", html: "Toca el icono de Tradovate, la pantalla de bienvenida parpadea durante un segundo y luego&hellip; nada. Solo un rectángulo negro sólido donde debería estar la pantalla de inicio de sesión o su panel. La barra de estado y los botones de navegación siguen ahí, así que el teléfono funciona bien, pero la aplicación en sí nunca llega a cargar. Ocurre en distintos teléfonos Android, y se ha reportado incluso en hardware más reciente como el Galaxy S21, así que no es solo un problema de &ldquo;su dispositivo es demasiado antiguo&rdquo;." },
    { type: "paragraph", html: "La buena noticia por delante: esto casi nunca es un problema de cuenta o de dinero. Se trata de una caché local dañada o de un fragmento de datos almacenados defectuoso en su teléfono, que suele quedar tras una actualización de la aplicación, un cierre forzado o un periodo en el que el dispositivo se quedó sin espacio de almacenamiento. La solución que lo corrige es rápida y fiable: <strong class='text-white'>borrar la caché de la aplicación, luego borrar su almacenamiento y después reiniciarla</strong>. A continuación encontrará el orden exacto para hacerlo, las alternativas si el primer intento no funciona y cómo seguir gestionando su riesgo abierto mientras la aplicación del teléfono está en negro." },
    {
      type: "checklist",
      heading: "Lista rápida para solucionar la pantalla negra",
      items: [
        "<strong class='text-white'>Borre primero la caché.</strong> No es destructivo y mantiene su sesión iniciada. Vuelva a abrir la app y compruebe.",
        "<strong class='text-white'>¿Sigue en negro? Borre el almacenamiento / los datos.</strong> Esto elimina los datos locales y cierra su sesión, tenga a mano sus credenciales de Tradovate o de la prop firm.",
        "<strong class='text-white'>Fuerce la detención y vuelva a abrir la aplicación.</strong> Un reinicio limpio después de borrar los datos le da a la app un comienzo nuevo.",
        "<strong class='text-white'>Actualice la aplicación</strong> desde la Play Store, una versión desactualizada frente a un sistema operativo más reciente puede fallar al renderizar.",
        "<strong class='text-white'>Reinicie el teléfono</strong> para liberar memoria y eliminar cualquier proceso en segundo plano bloqueado.",
        "<strong class='text-white'>Libere espacio de almacenamiento</strong> si el dispositivo está casi lleno.",
        "<strong class='text-white'>Reinstale</strong> como último recurso, desinstale, reinicie y vuelva a instalar desde cero.",
        "<strong class='text-white'>Gestione las operaciones abiertas desde la web o el escritorio</strong> mientras soluciona el problema del teléfono. Sus órdenes siguen activas en los servidores de Tradovate.",
      ],
    },
    { type: "heading", text: "Qué está pasando realmente al abrir la app" },
    { type: "paragraph", html: "La aplicación móvil de Tradovate es una compilación nativa (desarrollada con Flutter) que carga una parte del estado local en el momento en que se abre: tokens de sesión, diseño, datos de mercado y de cuenta en caché. Cuando alguno de esos datos almacenados está dañado o se escribió a medias, la app no puede terminar de dibujar su primer fotograma. En lugar de volver a una pantalla de inicio de sesión limpia, se queda bloqueada en el lienzo negro con el que empezó. Esa es la pantalla negra que está viendo." },
    { type: "paragraph", html: "Este tipo de corrupción suele aparecer justo después de que una actualización de la aplicación reemplace archivos, después de que Android cierre la app a la fuerza en segundo plano para liberar memoria, o cuando el teléfono se quedó sin espacio libre en mitad de una escritura. Nada de eso afecta a su cuenta. Su saldo, sus órdenes activas y cualquier posición abierta se guardan en el servidor de Tradovate, no en el teléfono, razón por la cual borrar los datos locales es seguro y por la que, al volver a iniciar sesión, todo se restaura." },
    { type: "quote", html: "Antes de empezar a borrar nada, conozca la diferencia: borrar la <strong class='text-white'>caché</strong> es inofensivo y mantiene su sesión iniciada, mientras que borrar el <strong class='text-white'>almacenamiento</strong> (también llamado &ldquo;Borrar datos&rdquo;) cierra su sesión. Pruebe primero con la caché, y pase al almacenamiento solo si la pantalla negra persiste." },
    { type: "heading", text: "Cómo solucionarlo: borrar caché, borrar almacenamiento, reiniciar" },
    {
      type: "steps",
      items: [
        { title: "Borrar la caché (pruebe esto primero)", html: "Abra en su teléfono <strong class='text-white'>Ajustes &rarr; Aplicaciones</strong> (en algunos teléfonos aparece como &ldquo;Aplicaciones y notificaciones &rarr; Ver todas las aplicaciones&rdquo;), desplácese hasta <strong class='text-white'>Tradovate: Futures Trading</strong> y tóquela para abrir la pantalla de información de la app. Toque <strong class='text-white'>Almacenamiento</strong> (en muchos teléfonos aparece como &ldquo;Almacenamiento y caché&rdquo;) y luego toque <strong class='text-white'>Borrar caché</strong>. Esto elimina archivos temporales sin afectar su inicio de sesión. Salga, vuelva a abrir Tradovate y compruebe si carga. La redacción exacta y la ruta del menú cambian ligeramente entre versiones de Android y fabricantes de teléfonos, Samsung, Pixel y otros lo expresan de forma algo distinta, pero el destino es siempre el mismo: la pantalla de Almacenamiento de la app de Tradovate, donde se encuentran los controles de caché y datos." },
        { title: "Borrar almacenamiento / datos (si solo la caché no fue suficiente)", html: "¿Sigue en negro después de borrar la caché y reiniciar la app? Vuelva a esa misma pantalla de Almacenamiento y toque <strong class='text-white'>Borrar almacenamiento</strong> (en algunos dispositivos aparece como <strong class='text-white'>Borrar datos</strong>). Este es el paso que realmente elimina el estado local dañado, y cierra su sesión, así que asegúrese de tener a mano su nombre de usuario y contraseña de Tradovate o de la prop firm antes de tocarlo. Confirme el aviso y los datos locales de la app se restablecerán por completo." },
        { title: "Forzar la detención, luego volver a abrir e iniciar sesión", html: "Desde la misma pantalla de información de la app, toque <strong class='text-white'>Forzar detención</strong> para asegurarse de que no queda ningún proceso obsoleto en ejecución, y luego abra Tradovate de nuevo desde la pantalla de inicio. Debería cargar directamente la pantalla de inicio de sesión. Inicie sesión con sus credenciales, y sus cuentas, posiciones y órdenes se sincronizarán de inmediato desde el servidor." },
      ],
    },
    { type: "paragraph", html: "En la gran mayoría de los casos de pantalla negra, ese proceso de tres pasos es toda la solución. Si el suyo es persistente, siga las alternativas a continuación en orden." },
    { type: "heading", text: "Si sigue en negro después de borrar los datos" },
    { type: "heading", text: "Actualizar la aplicación" },
    { type: "paragraph", html: "Abra la Play Store, busque Tradovate e instale cualquier actualización pendiente. Una versión que se quede varias versiones por detrás de la versión actual de Android puede no incluir una corrección de renderizado y quedarse bloqueada al abrir. Ejecutar la versión más reciente descarta esa causa." },
    { type: "heading", text: "Reiniciar el teléfono" },
    { type: "paragraph", html: "Apague el dispositivo por completo, espere unos segundos y vuelva a encenderlo. Un reinicio libera memoria y elimina cualquier servicio en segundo plano bloqueado que un simple reinicio de la app no alcanza a resolver. Vuelva a abrir Tradovate después." },
    { type: "heading", text: "Liberar espacio de almacenamiento" },
    { type: "paragraph", html: "Si su teléfono está casi lleno, las aplicaciones pueden no lograr escribir los archivos que necesitan al iniciarse, lo que es una de las formas en que la caché se corrompe en primer lugar. Elimine aplicaciones, fotos o descargas que no use para liberar varios gigabytes y luego reinicie la app." },
    { type: "heading", text: "Verificar su versión de Android" },
    { type: "paragraph", html: "La aplicación de Tradovate requiere <strong class='text-white'>Android 7.0 o superior</strong>. En un sistema operativo más antiguo puede negarse a abrir o a renderizar correctamente. Compruebe su versión en <strong class='text-white'>Ajustes &rarr; Información del teléfono &rarr; Información de software</strong>, e instale cualquier actualización del sistema que su dispositivo ofrezca." },
    { type: "heading", text: "Reinstalar como último recurso" },
    { type: "paragraph", html: "Si nada de lo anterior funciona, desinstale Tradovate por completo, reinicie el teléfono, luego instale una copia nueva desde la Play Store y vuelva a iniciar sesión. Una reinstalación garantiza una instalación limpia de la versión actual, es la misma idea que borrar el almacenamiento, solo que más exhaustiva y lenta, por eso es el último paso y no el primero." },
    { type: "heading", text: "Gestione su riesgo mientras la app está en negro" },
    { type: "paragraph", html: "Una pantalla negra en un teléfono no cancela sus órdenes. Cada stop y cada objetivo que colocó sigue activo en los servidores de Tradovate y continúa funcionando sin importar lo que muestre su aplicación móvil. Si tiene una posición abierta cuando la app se pone en negro, no opere por pánico, abra la <strong class='text-white'>plataforma web de Tradovate</strong> en un navegador o la <strong class='text-white'>aplicación de escritorio</strong> en un ordenador, y verá exactamente la misma cuenta con control total para modificar o cerrar posiciones. Trate el teléfono como una ventana más hacia su cuenta, nunca como la única." },
    { type: "heading", text: "Tabla de solución de problemas" },
    {
      type: "table",
      headers: ["Síntoma", "Causa probable", "Solución"],
      rows: [
        ["Pantalla negra justo después de la pantalla de bienvenida", "Caché de la app dañada", "Ajustes &rarr; Aplicaciones &rarr; Tradovate &rarr; Almacenamiento &rarr; Borrar caché, luego reiniciar"],
        ["Borrar la caché no ayudó", "Datos almacenados / sesión dañados", "Borrar almacenamiento (Borrar datos), cierra la sesión, luego vuelva a iniciar sesión"],
        ["La pantalla negra vuelve tras una actualización", "Versión desactualizada o archivos residuales", "Actualizar desde la Play Store; reinstalar si es necesario"],
        ["La app se congela y el teléfono va lento", "Poco almacenamiento libre / proceso bloqueado", "Liberar espacio y reiniciar el teléfono"],
        ["La app no abre en absoluto en un teléfono antiguo", "Versión de Android por debajo del mínimo", "Confirmar Android 7.0+ y actualizar el sistema operativo"],
        ["Tiene una operación abierta y la app está en negro", "Solo fallo de renderizado del lado del cliente", "Gestionar la posición desde la web o el escritorio; las órdenes siguen activas"],
      ],
    },
    { type: "heading", text: "Siga operando aunque la app móvil no cargue" },
    { type: "paragraph", html: "Si un teléfono que no renderiza alguna vez le costó una ejecución, la solución es dejar de depender de que un único cliente esté abierto. PickMyTrade conecta sus alertas de TradingView directamente con Tradovate y ejecuta las operaciones en nuestros servidores, de modo que su automatización sigue funcionando sin importar si la app de su teléfono está mostrando una pantalla o no:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Ejecución del lado del servidor</strong>, las alertas se envían de TradingView a Tradovate a través de nuestra infraestructura, así que un teléfono con la pantalla en negro nunca impide que se ejecute una entrada o una salida.",
        "<strong class='text-white'>Independencia del dispositivo</strong>, no se necesita tener abierta la aplicación móvil. Su estrategia se activa desde la alerta, no desde el cliente que esté en ejecución en ese momento.",
        "<strong class='text-white'>Stops y objetivos que se mantienen</strong>, el SL/TP definido en la alerta se coloca en Tradovate sin importar el dispositivo que esté usando, así que la protección no depende de que la app se renderice.",
        "<strong class='text-white'>Sincronización multicuenta</strong>, replique las mismas órdenes en todas las cuentas conectadas a la vez, de modo que ninguna cuenta quede sin gestionar mientras soluciona un problema en el teléfono.",
      ],
    },
  ], fr: [
    { type: "paragraph", html: "Vous appuyez sur l'icône Tradovate, l'écran de démarrage clignote une seconde, puis&hellip; plus rien. Juste un rectangle noir uni à la place de l'écran de connexion ou de votre tableau de bord. La barre d'état et les boutons de navigation sont toujours là, donc le téléphone fonctionne bien, mais l'application elle-même ne s'affiche jamais. Cela arrive sur différents téléphones Android, et cela a même été signalé sur du matériel plus récent comme le Galaxy S21, donc ce n'est pas seulement un problème d'&ldquo;appareil trop ancien&rdquo;." },
    { type: "paragraph", html: "Voici la bonne nouvelle d'entrée de jeu: ce n'est presque jamais un problème de compte ou d'argent. Il s'agit d'un cache local corrompu ou d'un fragment de données stockées défectueux sur votre téléphone, généralement laissé après une mise à jour de l'application, une fermeture forcée, ou une période où l'appareil manquait d'espace de stockage. La solution qui règle cela est rapide et fiable: <strong class='text-white'>videz le cache de l'application, puis effacez son stockage, puis relancez-la</strong>. Vous trouverez ci-dessous l'ordre exact à suivre, les solutions de repli si la première tentative ne fonctionne pas, et comment continuer à gérer votre risque ouvert pendant que l'application mobile reste noire." },
    {
      type: "checklist",
      heading: "Liste de vérification rapide pour résoudre l'écran noir",
      items: [
        "<strong class='text-white'>Videz d'abord le cache.</strong> Ce n'est pas destructeur et vous restez connecté. Relancez l'application et vérifiez.",
        "<strong class='text-white'>Toujours noir? Effacez le stockage / les données.</strong> Cela supprime les données locales et vous déconnecte, ayez vos identifiants Tradovate ou de votre prop firm à portée de main.",
        "<strong class='text-white'>Forcez l'arrêt, puis rouvrez l'application.</strong> Un redémarrage propre après l'effacement des données lui donne un nouveau départ.",
        "<strong class='text-white'>Mettez à jour l'application</strong> depuis le Play Store, une version obsolète face à un système d'exploitation plus récent peut échouer à s'afficher correctement.",
        "<strong class='text-white'>Redémarrez le téléphone</strong> pour libérer la mémoire et arrêter tout processus en arrière-plan bloqué.",
        "<strong class='text-white'>Libérez de l'espace de stockage</strong> si l'appareil est presque plein.",
        "<strong class='text-white'>Réinstallez</strong> en dernier recours, désinstallez, redémarrez, réinstallez à neuf.",
        "<strong class='text-white'>Gérez vos positions ouvertes depuis le web ou le bureau</strong> pendant que vous réparez le téléphone. Vos ordres restent actifs sur les serveurs de Tradovate.",
      ],
    },
    { type: "heading", text: "Ce qui se passe réellement au lancement" },
    { type: "paragraph", html: "L'application mobile Tradovate est une application native (développée avec Flutter) qui charge une partie de son état local dès son ouverture: jetons de session, mise en page, données de marché et de compte mises en cache. Lorsque l'une de ces données stockées est corrompue ou n'a été écrite qu'à moitié, l'application ne peut pas terminer d'afficher sa première image. Au lieu de revenir à un écran de connexion propre, elle reste bloquée sur l'écran noir avec lequel elle a démarré. C'est l'écran noir que vous voyez." },
    { type: "paragraph", html: "Ce type de corruption a tendance à apparaître juste après qu'une mise à jour de l'application remplace des fichiers, après qu'Android force la fermeture de l'application en arrière-plan pour récupérer de la mémoire, ou lorsque le téléphone n'a plus d'espace de stockage libre en pleine écriture. Rien de tout cela ne touche votre compte. Votre solde, vos ordres en cours et toute position ouverte sont conservés côté serveur chez Tradovate, pas sur le téléphone, ce qui explique pourquoi effacer les données locales est sans risque et pourquoi tout est restauré lorsque vous vous reconnectez." },
    { type: "quote", html: "Avant de commencer à tout effacer, sachez ceci: vider le <strong class='text-white'>cache</strong> est sans danger et vous maintient connecté, tandis qu'effacer le <strong class='text-white'>stockage</strong> (aussi appelé &laquo;Effacer les données&raquo;) vous déconnecte. Essayez d'abord le cache, et ne passez au stockage que si l'écran noir persiste." },
    { type: "heading", text: "Comment résoudre le problème: vider le cache, effacer le stockage, relancer" },
    {
      type: "steps",
      items: [
        { title: "Vider le cache (à essayer en premier)", html: "Ouvrez sur votre téléphone <strong class='text-white'>Paramètres &rarr; Applications</strong> (sur certains téléphones, c'est &ldquo;Applications et notifications &rarr; Voir toutes les applications&rdquo;), faites défiler jusqu'à <strong class='text-white'>Tradovate: Futures Trading</strong>, et appuyez dessus pour ouvrir l'écran d'informations de l'application. Appuyez sur <strong class='text-white'>Stockage</strong> (sur de nombreux téléphones, cela s'affiche &ldquo;Stockage et cache&rdquo;), puis appuyez sur <strong class='text-white'>Vider le cache</strong>. Cela supprime les fichiers temporaires sans toucher à votre connexion. Revenez en arrière, rouvrez Tradovate, et vérifiez si elle se charge. Le libellé exact et le chemin dans les menus varient légèrement selon les versions d'Android et les fabricants de téléphones, Samsung, Pixel et d'autres le formulent chacun un peu différemment, mais la destination reste la même: l'écran Stockage de l'application Tradovate, où se trouvent les commandes de cache et de données." },
        { title: "Effacer le stockage / les données (si le cache seul n'a pas suffi)", html: "Toujours noir après avoir vidé le cache et relancé l'application? Retournez sur ce même écran Stockage et appuyez sur <strong class='text-white'>Effacer le stockage</strong> (appelé <strong class='text-white'>Effacer les données</strong> sur certains appareils). C'est l'étape qui efface réellement l'état local corrompu, et elle vous déconnecte, alors assurez-vous de connaître votre nom d'utilisateur et votre mot de passe Tradovate ou de votre prop firm avant d'appuyer dessus. Confirmez le message, et les données locales de l'application repartent sur une base saine." },
        { title: "Forcez l'arrêt, puis relancez et connectez-vous", html: "Depuis le même écran d'informations de l'application, appuyez sur <strong class='text-white'>Forcer l'arrêt</strong> pour vous assurer qu'aucun processus obsolète ne subsiste, puis ouvrez Tradovate à nouveau depuis votre écran d'accueil. Elle devrait charger directement l'écran de connexion. Connectez-vous avec vos identifiants, et vos comptes, positions et ordres se resynchronisent immédiatement depuis le serveur." },
      ],
    },
    { type: "paragraph", html: "Dans la grande majorité des cas d'écran noir, cette séquence en trois étapes suffit à résoudre le problème. Si le vôtre persiste, parcourez les solutions de repli ci-dessous dans l'ordre." },
    { type: "heading", text: "Si l'écran reste noir après avoir effacé les données" },
    { type: "heading", text: "Mettre à jour l'application" },
    { type: "paragraph", html: "Ouvrez le Play Store, recherchez Tradovate, et installez toute mise à jour en attente. Une version qui accuse quelques versions de retard sur la version Android actuelle peut manquer un correctif d'affichage et rester bloquée au lancement. Utiliser la dernière version élimine cette cause." },
    { type: "heading", text: "Redémarrer le téléphone" },
    { type: "paragraph", html: "Éteignez complètement l'appareil, attendez quelques secondes, puis rallumez-le. Un redémarrage libère la mémoire et arrête tout service en arrière-plan bloqué qu'un simple relancement de l'application ne résout pas. Rouvrez Tradovate ensuite." },
    { type: "heading", text: "Libérer de l'espace de stockage" },
    { type: "paragraph", html: "Si votre téléphone est presque plein, les applications peuvent échouer à écrire les fichiers dont elles ont besoin au démarrage, ce qui est justement l'une des façons dont le cache se corrompt au départ. Supprimez les applications, photos ou téléchargements inutilisés pour libérer quelques gigaoctets, puis relancez l'application." },
    { type: "heading", text: "Vérifiez votre version d'Android" },
    { type: "paragraph", html: "L'application Tradovate nécessite <strong class='text-white'>Android 7.0 ou supérieur</strong>. Sur un système d'exploitation plus ancien, elle peut refuser de se lancer ou de s'afficher correctement. Vérifiez votre version dans <strong class='text-white'>Paramètres &rarr; À propos du téléphone &rarr; Informations logicielles</strong>, et installez toute mise à jour du système que votre appareil propose." },
    { type: "heading", text: "Réinstaller en dernier recours" },
    { type: "paragraph", html: "Si rien de tout cela ne fonctionne, désinstallez complètement Tradovate, redémarrez le téléphone, puis réinstallez une copie neuve depuis le Play Store et reconnectez-vous. Une réinstallation garantit une installation propre de la version actuelle, c'est le même principe qu'effacer le stockage, en plus complet et plus lent, ce qui explique pourquoi c'est la dernière étape plutôt que la première." },
    { type: "heading", text: "Gérez votre risque pendant que l'application est noire" },
    { type: "paragraph", html: "Un écran noir sur un téléphone n'annule pas vos ordres. Chaque stop et chaque objectif que vous avez placés restent en place sur les serveurs de Tradovate et continuent de fonctionner, quoi qu'affiche votre application mobile. Si vous êtes en position ouverte au moment où l'application devient noire, ne paniquez pas et ne tradez pas dans la précipitation, ouvrez la <strong class='text-white'>plateforme web Tradovate</strong> dans un navigateur ou l'<strong class='text-white'>application de bureau</strong> sur un ordinateur, et vous retrouverez exactement le même compte avec un contrôle total pour modifier ou clôturer vos positions. Considérez le téléphone comme une fenêtre parmi d'autres vers votre compte, jamais la seule." },
    { type: "heading", text: "Tableau de dépannage" },
    {
      type: "table",
      headers: ["Symptôme", "Cause probable", "Solution"],
      rows: [
        ["Écran noir juste après l'écran de démarrage", "Cache de l'application corrompu", "Paramètres &rarr; Applications &rarr; Tradovate &rarr; Stockage &rarr; Vider le cache, puis relancer"],
        ["Vider le cache n'a pas aidé", "Données stockées / session corrompues", "Effacer le stockage (Effacer les données), déconnecte, puis se reconnecter"],
        ["L'écran noir revient après une mise à jour", "Version obsolète ou fichiers résiduels", "Mettre à jour depuis le Play Store; réinstaller si nécessaire"],
        ["L'application se bloque et le téléphone semble lent", "Stockage libre faible / processus bloqué", "Libérer de l'espace et redémarrer le téléphone"],
        ["L'application ne se lance pas du tout sur un vieux téléphone", "Version d'Android inférieure au minimum requis", "Confirmer Android 7.0+ et mettre à jour le système"],
        ["Vous êtes en position et l'application est noire", "Simple échec d'affichage côté client", "Gérer la position depuis le web ou le bureau; les ordres restent actifs"],
      ],
    },
    { type: "heading", text: "Continuez à trader même quand l'application mobile ne se charge pas" },
    { type: "paragraph", html: "Si un téléphone qui ne s'affiche pas vous a déjà coûté une exécution, la solution consiste à ne plus dépendre d'un client unique resté ouvert. PickMyTrade relie vos alertes TradingView directement à Tradovate et exécute les ordres sur nos serveurs, de sorte que votre automatisation continue de fonctionner, que votre application mobile affiche un écran ou non:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Exécution côté serveur</strong>, les alertes passent de TradingView à Tradovate via notre infrastructure, de sorte qu'un téléphone à l'écran noir n'empêche jamais une entrée ou une sortie de passer.",
        "<strong class='text-white'>Indépendance de l'appareil</strong>, rien ne nécessite que l'application mobile soit ouverte. Votre stratégie s'active à partir de l'alerte, pas du client qui se trouve être en cours d'exécution.",
        "<strong class='text-white'>Stops et objectifs qui tiennent</strong>, les SL/TP définis dans l'alerte sont placés sur Tradovate quel que soit l'appareil que vous utilisez, donc la protection ne dépend pas de l'affichage de l'application.",
        "<strong class='text-white'>Synchronisation multi-comptes</strong>, dupliquez les mêmes ordres sur tous les comptes connectés à la fois, de sorte qu'aucun compte ne reste sans gestion pendant que vous dépannez un téléphone.",
      ],
    },
  ], it: [
    { type: "paragraph", html: "Tocca l'icona di Tradovate, la schermata di avvio lampeggia per un secondo e poi&hellip; nulla. Solo un rettangolo nero uniforme dove dovrebbe esserci la schermata di accesso o la dashboard. La barra di stato e i pulsanti di navigazione sono ancora presenti, quindi il telefono funziona correttamente, ma l'app in sé non riesce a caricarsi. Succede su diversi telefoni Android ed è stato segnalato anche su hardware più recente come il Galaxy S21, quindi non è semplicemente un problema di &ldquo;dispositivo troppo vecchio&rdquo;." },
    { type: "paragraph", html: "Ecco subito la buona notizia: quasi mai si tratta di un problema legato all'account o al denaro. È una cache locale danneggiata o una parte di dati memorizzati difettosa sul telefono, solitamente rimasta dopo un aggiornamento dell'app, una chiusura forzata o un periodo in cui il dispositivo era a corto di spazio di archiviazione. La soluzione che risolve il problema è rapida e affidabile: <strong class='text-white'>svuotare prima la cache dell'app, poi cancellarne l'archiviazione e infine riavviarla</strong>. Di seguito trova l'ordine esatto da seguire, le alternative se il primo tentativo non funziona e come continuare a gestire il rischio aperto mentre l'app sul telefono resta nera." },
    {
      type: "checklist",
      heading: "Checklist rapida per risolvere la schermata nera",
      items: [
        "<strong class='text-white'>Svuoti prima la cache.</strong> Non è distruttivo e mantiene l'accesso attivo. Riavvii l'app e verifichi.",
        "<strong class='text-white'>Ancora nera? Cancelli l'archiviazione / i dati.</strong> Questo elimina i dati locali e disconnette l'account, tenga pronte le credenziali Tradovate o della prop firm.",
        "<strong class='text-white'>Forzi l'arresto, poi riapra l'app.</strong> Un riavvio pulito dopo aver cancellato i dati le offre un nuovo inizio.",
        "<strong class='text-white'>Aggiorni l'app</strong> dal Play Store, una build non aggiornata rispetto a un sistema operativo più recente può non riuscire a visualizzarsi correttamente.",
        "<strong class='text-white'>Riavvii il telefono</strong> per liberare memoria ed eliminare qualsiasi processo in background bloccato.",
        "<strong class='text-white'>Liberi spazio di archiviazione</strong> se il dispositivo è quasi pieno.",
        "<strong class='text-white'>Reinstalli</strong> come ultima risorsa, disinstalli, riavvii, reinstalli da zero.",
        "<strong class='text-white'>Gestisca le operazioni aperte da web o desktop</strong> mentre risolve il problema sul telefono. Gli ordini restano attivi sui server di Tradovate.",
      ],
    },
    { type: "heading", text: "Cosa succede realmente all'avvio" },
    { type: "paragraph", html: "L'app mobile di Tradovate è una build nativa (sviluppata con Flutter) che carica una parte dello stato locale nel momento in cui si apre: token di sessione, layout, dati di mercato e dell'account in cache. Quando uno di questi dati memorizzati è danneggiato o scritto solo a metà, l'app non riesce a completare il disegno del primo frame. Invece di tornare a una schermata di accesso pulita, resta bloccata sulla schermata nera con cui è partita. Questa è la schermata nera che sta vedendo." },
    { type: "paragraph", html: "Questo tipo di corruzione tende a comparire subito dopo che un aggiornamento dell'app sostituisce dei file, dopo che Android termina forzatamente l'app in background per liberare memoria, o quando il telefono esaurisce lo spazio libero durante una scrittura. Nulla di tutto ciò riguarda l'account. Il saldo, gli ordini in sospeso e qualsiasi posizione aperta sono conservati lato server presso Tradovate, non sul telefono, ed è proprio per questo che cancellare i dati locali è sicuro e che, effettuando nuovamente l'accesso, tutto viene ripristinato." },
    { type: "quote", html: "Prima di iniziare a cancellare qualsiasi cosa, conosca il compromesso: svuotare la <strong class='text-white'>cache</strong> è innocuo e mantiene l'accesso attivo, mentre cancellare l'<strong class='text-white'>archiviazione</strong> (chiamata anche &ldquo;Cancella dati&rdquo;) disconnette l'account. Provi prima con la cache e passi all'archiviazione solo se la schermata nera persiste." },
    { type: "heading", text: "Come risolvere: svuotare la cache, cancellare l'archiviazione, riavviare" },
    {
      type: "steps",
      items: [
        { title: "Svuotare la cache (da provare per prima)", html: "Apra sul telefono <strong class='text-white'>Impostazioni &rarr; App</strong> (su alcuni telefoni si chiama &ldquo;App e notifiche &rarr; Vedi tutte le app&rdquo;), scorra fino a <strong class='text-white'>Tradovate: Futures Trading</strong> e la tocchi per aprire la schermata delle informazioni sull'app. Tocchi <strong class='text-white'>Archiviazione</strong> (su molti telefoni compare come &ldquo;Archiviazione e cache&rdquo;), quindi tocchi <strong class='text-white'>Svuota cache</strong>. Questo elimina i file temporanei senza toccare l'accesso. Esca, riapra Tradovate e verifichi se si carica. La dicitura esatta e il percorso nei menu variano leggermente tra le versioni di Android e i produttori di telefoni, Samsung, Pixel e altri lo esprimono in modo leggermente diverso, ma la destinazione è sempre la stessa: la schermata Archiviazione dell'app Tradovate, dove si trovano i controlli di cache e dati." },
        { title: "Cancellare l'archiviazione / i dati (se la sola cache non è bastata)", html: "Ancora nera dopo aver svuotato la cache e riavviato l'app? Torni sulla stessa schermata Archiviazione e tocchi <strong class='text-white'>Cancella archiviazione</strong> (chiamata <strong class='text-white'>Cancella dati</strong> su alcuni dispositivi). Questo è il passaggio che elimina davvero lo stato locale danneggiato e disconnette l'account, quindi si assicuri di conoscere il proprio nome utente e la password di Tradovate o della prop firm prima di toccarlo. Confermi il messaggio e i dati locali dell'app torneranno a uno stato pulito." },
        { title: "Forzare l'arresto, poi riavviare ed effettuare l'accesso", html: "Dalla stessa schermata delle informazioni sull'app, tocchi <strong class='text-white'>Forza arresto</strong> per assicurarsi che non resti alcun processo obsoleto attivo, quindi apra nuovamente Tradovate dalla schermata iniziale. Dovrebbe caricarsi direttamente sulla schermata di accesso. Effettui l'accesso con le proprie credenziali e gli account, le posizioni e gli ordini si sincronizzeranno subito di nuovo dal server." },
      ],
    },
    { type: "paragraph", html: "Nella maggior parte dei casi di schermata nera, questo processo in tre passaggi è l'intera soluzione. Se il problema persiste, segua in ordine le alternative riportate di seguito." },
    { type: "heading", text: "Se la schermata resta nera dopo aver cancellato i dati" },
    { type: "heading", text: "Aggiornare l'app" },
    { type: "paragraph", html: "Apra il Play Store, cerchi Tradovate e installi qualsiasi aggiornamento in sospeso. Una build rimasta indietro di alcune versioni rispetto alla release Android attuale può non includere una correzione di rendering e bloccarsi all'avvio. Utilizzare la versione più recente esclude questa causa." },
    { type: "heading", text: "Riavviare il telefono" },
    { type: "paragraph", html: "Spenga completamente il dispositivo, attenda qualche secondo e lo riaccenda. Un riavvio libera la memoria ed elimina qualsiasi servizio in background bloccato che un semplice riavvio dell'app non risolverebbe. Riapra Tradovate in seguito." },
    { type: "heading", text: "Liberare spazio di archiviazione" },
    { type: "paragraph", html: "Se il telefono è quasi pieno, le app possono non riuscire a scrivere i file necessari all'avvio, ed è proprio uno dei modi in cui la cache si danneggia. Elimini app, foto o download non utilizzati per liberare qualche gigabyte, quindi riavvii l'app." },
    { type: "heading", text: "Verificare la versione di Android" },
    { type: "paragraph", html: "L'app Tradovate richiede <strong class='text-white'>Android 7.0 o superiore</strong>. Su un sistema operativo più vecchio potrebbe rifiutarsi di avviarsi o di visualizzarsi correttamente. Controlli la versione in <strong class='text-white'>Impostazioni &rarr; Informazioni sul telefono &rarr; Informazioni sul software</strong> e installi qualsiasi aggiornamento del sistema operativo offerto dal dispositivo." },
    { type: "heading", text: "Reinstallare come ultima risorsa" },
    { type: "paragraph", html: "Se nulla di quanto sopra funziona, disinstalli completamente Tradovate, riavvii il telefono, quindi reinstalli una copia nuova dal Play Store ed effettui nuovamente l'accesso. Una reinstallazione garantisce un'installazione pulita della build attuale, è lo stesso principio della cancellazione dell'archiviazione, solo più approfondito e più lento, motivo per cui è l'ultima opzione e non la prima." },
    { type: "heading", text: "Gestisca il rischio mentre l'app è nera" },
    { type: "paragraph", html: "Una schermata nera su un telefono non annulla gli ordini. Ogni stop e ogni obiettivo impostati restano attivi sui server di Tradovate e continuano a funzionare indipendentemente da cosa mostri l'app mobile. Se ha una posizione aperta nel momento in cui l'app diventa nera, non operi nel panico, apra la <strong class='text-white'>piattaforma web di Tradovate</strong> in un browser o l'<strong class='text-white'>app desktop</strong> su un computer, e vedrà esattamente lo stesso account con pieno controllo per modificare o chiudere le posizioni. Consideri il telefono come una delle finestre di accesso all'account, mai l'unica." },
    { type: "heading", text: "Tabella di risoluzione dei problemi" },
    {
      type: "table",
      headers: ["Sintomo", "Causa probabile", "Soluzione"],
      rows: [
        ["Schermata nera subito dopo lo splash", "Cache dell'app danneggiata", "Impostazioni &rarr; App &rarr; Tradovate &rarr; Archiviazione &rarr; Svuota cache, quindi riavviare"],
        ["Svuotare la cache non ha aiutato", "Dati memorizzati / sessione danneggiati", "Cancellare l'archiviazione (Cancella dati), disconnette l'account, quindi effettuare nuovamente l'accesso"],
        ["La schermata nera ritorna dopo un aggiornamento", "Build non aggiornata o file residui", "Aggiornare dal Play Store; reinstallare se necessario"],
        ["L'app si blocca e il telefono sembra lento", "Poco spazio libero / processo bloccato", "Liberare spazio e riavviare il telefono"],
        ["L'app non si avvia affatto su un telefono vecchio", "Versione di Android sotto il minimo richiesto", "Verificare Android 7.0+ e aggiornare il sistema operativo"],
        ["È in un'operazione e l'app è nera", "Solo un errore di rendering lato client", "Gestire la posizione da web o desktop; gli ordini restano attivi"],
      ],
    },
    { type: "heading", text: "Continui a fare trading anche quando l'app mobile non si carica" },
    { type: "paragraph", html: "Se un telefono che non si visualizza le è mai costato un'esecuzione, la soluzione è smettere di dipendere da un unico client aperto. PickMyTrade collega i suoi alert di TradingView direttamente a Tradovate ed esegue le operazioni sui nostri server, così l'automazione continua a funzionare indipendentemente dal fatto che l'app sul telefono mostri o meno una schermata:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Esecuzione lato server</strong>, gli alert vengono instradati da TradingView a Tradovate attraverso la nostra infrastruttura, quindi un telefono con schermata nera non blocca mai un ingresso o un'uscita.",
        "<strong class='text-white'>Indipendenza dal dispositivo</strong>, non è necessario avere l'app mobile aperta. La strategia si attiva dall'alert, non dal client che si trova ad essere in esecuzione.",
        "<strong class='text-white'>Stop e obiettivi che tengono</strong>, lo SL/TP definito nell'alert viene inserito su Tradovate indipendentemente dal dispositivo in uso, quindi la protezione non dipende dal rendering dell'app.",
        "<strong class='text-white'>Sincronizzazione multi-account</strong>, replica gli stessi ordini su ogni account collegato contemporaneamente, così nessun account resta senza gestione mentre risolve un problema sul telefono.",
      ],
    },
  ] },
  ctaHeading: { en: "Keep Trading When the App Won't Load", de: "Weiterhandeln, auch wenn die App nicht lädt", es: "Siga operando aunque la app no cargue", fr: "Continuez à trader même quand l'application ne se charge pas", it: "Continui a fare trading anche quando l'app non si carica" },
  ctaText: { en: "PickMyTrade links your TradingView alerts to Tradovate through server-side execution, so a black-screened phone never stops an entry or an exit.", de: "PickMyTrade verbindet Ihre TradingView-Alerts über serverseitige Ausführung mit Tradovate, sodass ein schwarzes Telefon niemals einen Einstieg oder Ausstieg verhindert.", es: "PickMyTrade conecta sus alertas de TradingView con Tradovate mediante ejecución del lado del servidor, de modo que un teléfono con la pantalla en negro nunca impide una entrada o una salida.", fr: "PickMyTrade relie vos alertes TradingView à Tradovate grâce à une exécution côté serveur, de sorte qu'un téléphone à l'écran noir n'empêche jamais une entrée ou une sortie.", it: "PickMyTrade collega i suoi alert di TradingView a Tradovate tramite esecuzione lato server, così un telefono con schermata nera non blocca mai un ingresso o un'uscita." },
  ctaButtonText: { en: "Start Your Free 7-Day Trial", de: "Starten Sie Ihre kostenlose 5-Tage-Testversion", es: "Comience su prueba gratuita de 5 días", fr: "Démarrez votre essai gratuit de 5 jours", it: "Inizi la sua prova gratuita di 5 giorni" },
  ctaUrl: "https://app.pickmytrade.trade/?register=true&utm_source=content&utm_medium=debugging",
  faqHeading: { en: "Frequently Asked Questions", de: "Häufig gestellte Fragen", es: "Preguntas frecuentes", fr: "Questions fréquentes", it: "Domande frequenti" },
  faqs: { en: [
    { q: "Why does the Tradovate Android app open to a black screen?", a: "Almost always a corrupted local cache or stored data, usually left behind after an app update, a hard kill, or when the phone was low on free space. The app can't finish rendering its first screen, so you get a black rectangle instead of the login or dashboard. Clearing the app's cache and storage removes the bad data and lets it paint normally again." },
    { q: "Will clearing storage delete my account or my open positions?", a: "No. Clearing storage only wipes the local copy of data on your phone. Your account, balance, orders, and open positions live on Tradovate's servers and are untouched. When you sign back in, everything reappears exactly as it was." },
    { q: "Do I have to log in again after clearing storage?", a: "Yes. Clearing storage or data logs you out because it removes your saved session. Have your Tradovate or prop-firm username and password ready before you clear it. Clearing only the cache, by contrast, usually keeps you logged in." },
    { q: "Clearing cache and storage didn't work, what next?", a: "Update the app from the Play Store, restart the phone, free up storage space if the device is nearly full, and confirm your Android version meets the app's minimum (Android 7.0 or higher). If it's still black after all of that, uninstall the app completely, restart, and reinstall a fresh copy." },
    { q: "Is the black screen a problem with my trades or just the app?", a: "It's a display problem on that one device, not an account or order problem. Any stops and targets you placed are resting on Tradovate's servers and keep working while the phone app is dark. To be safe, open the web or desktop platform to confirm your positions while you fix the phone." },
    { q: "Which Android version does the Tradovate app need?", a: "The Tradovate: Futures Trading app requires Android 7.0 or higher. On an older OS the app may fail to launch or render. Check Settings &rarr; About phone &rarr; Software information for your Android version, and update the OS if your device offers it." },
    { q: "Can I still manage open positions while the app won't load?", a: "Yes. Log in to the Tradovate web platform in a browser or use the desktop app to see and manage the same account. Because a black screen is a client-side rendering issue, your positions and working orders are fully accessible from any other Tradovate client." },
    { q: "Does reinstalling the app fix the black screen?", a: "Often, yes, but try clearing cache and storage first, because a reinstall does the same thing the hard way and takes longer. Reinstalling is the right last resort if clearing data, updating, and restarting all fail, since it guarantees a clean install of the latest build." },
  ], de: [
    { q: "Warum öffnet sich die Tradovate Android-App mit einem schwarzen Bildschirm?", a: "Fast immer ein beschädigter lokaler Cache oder gespeicherte Daten, die meist nach einem App-Update, einem erzwungenen Beenden oder bei wenig freiem Speicherplatz auf dem Telefon zurückbleiben. Die App kann ihren ersten Bildschirm nicht fertig darstellen, sodass Sie ein schwarzes Rechteck statt der Anmeldung oder des Dashboards sehen. Das Löschen von Cache und Speicher der App entfernt die fehlerhaften Daten und lässt sie wieder normal laden." },
    { q: "Werden beim Löschen des Speichers mein Konto oder meine offenen Positionen gelöscht?", a: "Nein. Das Löschen des Speichers entfernt nur die lokale Kopie der Daten auf Ihrem Telefon. Ihr Konto, Guthaben, Ihre Orders und offenen Positionen liegen auf den Servern von Tradovate und bleiben unberührt. Wenn Sie sich erneut anmelden, erscheint wieder alles genau wie zuvor." },
    { q: "Muss ich mich nach dem Löschen des Speichers erneut anmelden?", a: "Ja. Das Löschen von Speicher oder Daten meldet Sie ab, da dabei Ihre gespeicherte Sitzung entfernt wird. Halten Sie Ihren Tradovate- oder Prop-Firm-Benutzernamen und Ihr Passwort bereit, bevor Sie es löschen. Das Löschen nur des Caches hingegen hält Sie in der Regel angemeldet." },
    { q: "Cache und Speicher löschen hat nicht funktioniert, was nun?", a: "Aktualisieren Sie die App über den Play Store, starten Sie das Telefon neu, geben Sie Speicherplatz frei, falls das Gerät fast voll ist, und prüfen Sie, ob Ihre Android-Version die Mindestanforderung der App erfüllt (Android 7.0 oder höher). Wenn der Bildschirm danach immer noch schwarz ist, deinstallieren Sie die App vollständig, starten Sie neu und installieren Sie eine frische Kopie." },
    { q: "Ist der schwarze Bildschirm ein Problem mit meinen Trades oder nur mit der App?", a: "Es ist ein Anzeigeproblem auf diesem einen Gerät, kein Konto- oder Orderproblem. Alle von Ihnen gesetzten Stops und Ziele liegen auf den Servern von Tradovate und funktionieren weiter, während die Telefon-App schwarz bleibt. Öffnen Sie zur Sicherheit die Web- oder Desktop-Plattform, um Ihre Positionen zu prüfen, während Sie das Telefon reparieren." },
    { q: "Welche Android-Version benötigt die Tradovate-App?", a: "Die App Tradovate: Futures Trading benötigt Android 7.0 oder höher. Auf einem älteren Betriebssystem kann die App möglicherweise nicht starten oder korrekt darstellen. Prüfen Sie unter Einstellungen &rarr; Über das Telefon &rarr; Software-Informationen Ihre Android-Version, und aktualisieren Sie das Betriebssystem, falls Ihr Gerät dies anbietet." },
    { q: "Kann ich offene Positionen weiterhin verwalten, während die App nicht lädt?", a: "Ja. Melden Sie sich in der Tradovate-Webplattform in einem Browser an oder verwenden Sie die Desktop-App, um dasselbe Konto zu sehen und zu verwalten. Da ein schwarzer Bildschirm ein clientseitiges Darstellungsproblem ist, sind Ihre Positionen und offenen Orders über jeden anderen Tradovate-Client vollständig zugänglich." },
    { q: "Behebt eine Neuinstallation der App den schwarzen Bildschirm?", a: "Oft ja, versuchen Sie aber zuerst, Cache und Speicher zu löschen, da eine Neuinstallation im Grunde dasselbe auf umständlichere Weise erledigt und länger dauert. Eine Neuinstallation ist der richtige letzte Ausweg, wenn Datenlöschung, Aktualisierung und Neustart alle fehlschlagen, da sie eine saubere Installation der neuesten Version garantiert." },
  ], es: [
    { q: "¿Por qué la aplicación de Tradovate para Android se abre con una pantalla negra?", a: "Casi siempre es una caché local dañada o datos almacenados corruptos, que suelen quedar tras una actualización de la aplicación, un cierre forzado o cuando el teléfono se quedó sin espacio libre. La app no puede terminar de renderizar su primera pantalla, por lo que aparece un rectángulo negro en lugar del inicio de sesión o el panel. Borrar la caché y el almacenamiento de la app elimina los datos defectuosos y permite que vuelva a cargar con normalidad." },
    { q: "¿Borrar el almacenamiento elimina mi cuenta o mis posiciones abiertas?", a: "No. Borrar el almacenamiento solo elimina la copia local de los datos en su teléfono. Su cuenta, saldo, órdenes y posiciones abiertas residen en los servidores de Tradovate y no se ven afectados. Cuando vuelva a iniciar sesión, todo reaparecerá exactamente como estaba." },
    { q: "¿Tengo que volver a iniciar sesión después de borrar el almacenamiento?", a: "Sí. Borrar el almacenamiento o los datos cierra su sesión porque elimina la sesión guardada. Tenga a mano su nombre de usuario y contraseña de Tradovate o de la prop firm antes de borrarlo. En cambio, borrar solo la caché normalmente mantiene su sesión iniciada." },
    { q: "Borrar la caché y el almacenamiento no funcionó, ¿qué sigue?", a: "Actualice la app desde la Play Store, reinicie el teléfono, libere espacio de almacenamiento si el dispositivo está casi lleno y confirme que su versión de Android cumple el mínimo de la app (Android 7.0 o superior). Si sigue en negro después de todo eso, desinstale la app por completo, reinicie y vuelva a instalar una copia nueva." },
    { q: "¿La pantalla negra es un problema con mis operaciones o solo con la app?", a: "Es un problema de visualización en ese dispositivo en concreto, no un problema de cuenta ni de órdenes. Cualquier stop y objetivo que haya colocado sigue activo en los servidores de Tradovate y continúa funcionando mientras la app del teléfono está en negro. Por seguridad, abra la plataforma web o de escritorio para confirmar sus posiciones mientras soluciona el problema del teléfono." },
    { q: "¿Qué versión de Android necesita la aplicación de Tradovate?", a: "La aplicación Tradovate: Futures Trading requiere Android 7.0 o superior. En un sistema operativo más antiguo, la app puede no abrir o no renderizar correctamente. Compruebe su versión de Android en Ajustes &rarr; Información del teléfono &rarr; Información de software, y actualice el sistema operativo si su dispositivo lo ofrece." },
    { q: "¿Puedo seguir gestionando posiciones abiertas mientras la app no carga?", a: "Sí. Inicie sesión en la plataforma web de Tradovate desde un navegador o use la aplicación de escritorio para ver y gestionar la misma cuenta. Dado que la pantalla negra es un problema de renderizado del lado del cliente, sus posiciones y órdenes activas están totalmente accesibles desde cualquier otro cliente de Tradovate." },
    { q: "¿Reinstalar la aplicación soluciona la pantalla negra?", a: "A menudo sí, pero pruebe primero a borrar la caché y el almacenamiento, ya que una reinstalación hace lo mismo por el camino largo y tarda más. Reinstalar es el último recurso adecuado si borrar los datos, actualizar y reiniciar fallan todos, ya que garantiza una instalación limpia de la última versión." },
  ], fr: [
    { q: "Pourquoi l'application Tradovate pour Android s'ouvre-t-elle sur un écran noir?", a: "C'est presque toujours un cache local corrompu ou des données stockées corrompues, généralement laissés après une mise à jour de l'application, une fermeture forcée, ou lorsque le téléphone manquait d'espace libre. L'application ne parvient pas à terminer l'affichage de son premier écran, d'où le rectangle noir à la place de la connexion ou du tableau de bord. Effacer le cache et le stockage de l'application supprime les données défectueuses et lui permet de s'afficher normalement à nouveau." },
    { q: "Effacer le stockage supprime-t-il mon compte ou mes positions ouvertes?", a: "Non. Effacer le stockage ne supprime que la copie locale des données sur votre téléphone. Votre compte, votre solde, vos ordres et vos positions ouvertes se trouvent sur les serveurs de Tradovate et restent intacts. Lorsque vous vous reconnectez, tout réapparaît exactement comme avant." },
    { q: "Dois-je me reconnecter après avoir effacé le stockage?", a: "Oui. Effacer le stockage ou les données vous déconnecte car cela supprime votre session enregistrée. Ayez votre nom d'utilisateur et votre mot de passe Tradovate ou de votre prop firm à portée de main avant de l'effacer. En revanche, effacer uniquement le cache vous laisse généralement connecté." },
    { q: "Effacer le cache et le stockage n'a pas fonctionné, que faire ensuite?", a: "Mettez à jour l'application depuis le Play Store, redémarrez le téléphone, libérez de l'espace de stockage si l'appareil est presque plein, et vérifiez que votre version d'Android respecte le minimum requis par l'application (Android 7.0 ou supérieur). Si l'écran reste noir après tout cela, désinstallez complètement l'application, redémarrez, et réinstallez une copie neuve." },
    { q: "L'écran noir est-il un problème avec mes positions ou seulement avec l'application?", a: "C'est un problème d'affichage propre à cet appareil, pas un problème de compte ni d'ordres. Tous les stops et objectifs que vous avez placés restent en place sur les serveurs de Tradovate et continuent de fonctionner pendant que l'application mobile est noire. Par sécurité, ouvrez la plateforme web ou de bureau pour confirmer vos positions pendant que vous réparez le téléphone." },
    { q: "Quelle version d'Android l'application Tradovate nécessite-t-elle?", a: "L'application Tradovate: Futures Trading nécessite Android 7.0 ou supérieur. Sur un système d'exploitation plus ancien, l'application peut échouer à se lancer ou à s'afficher correctement. Vérifiez votre version dans Paramètres &rarr; À propos du téléphone &rarr; Informations logicielles, et mettez à jour le système si votre appareil le propose." },
    { q: "Puis-je continuer à gérer mes positions ouvertes pendant que l'application ne se charge pas?", a: "Oui. Connectez-vous à la plateforme web Tradovate dans un navigateur ou utilisez l'application de bureau pour consulter et gérer le même compte. Comme l'écran noir est un problème d'affichage côté client, vos positions et ordres en cours restent entièrement accessibles depuis n'importe quel autre client Tradovate." },
    { q: "Réinstaller l'application résout-elle l'écran noir?", a: "Souvent oui, mais essayez d'abord d'effacer le cache et le stockage, car une réinstallation fait la même chose de manière plus longue et plus laborieuse. Réinstaller est le bon dernier recours si l'effacement des données, la mise à jour et le redémarrage échouent tous, car cela garantit une installation propre de la dernière version." },
  ], it: [
    { q: "Perché l'app Tradovate per Android si apre con una schermata nera?", a: "Quasi sempre a causa di una cache locale danneggiata o di dati memorizzati corrotti, solitamente rimasti dopo un aggiornamento dell'app, una chiusura forzata o quando il telefono era a corto di spazio libero. L'app non riesce a completare il rendering della prima schermata, quindi compare un rettangolo nero al posto dell'accesso o della dashboard. Cancellare la cache e l'archiviazione dell'app rimuove i dati difettosi e le permette di tornare a caricarsi normalmente." },
    { q: "Cancellare l'archiviazione elimina l'account o le posizioni aperte?", a: "No. Cancellare l'archiviazione elimina solo la copia locale dei dati sul telefono. Account, saldo, ordini e posizioni aperte risiedono sui server di Tradovate e non vengono toccati. Effettuando nuovamente l'accesso, tutto riappare esattamente come prima." },
    { q: "Devo effettuare nuovamente l'accesso dopo aver cancellato l'archiviazione?", a: "Sì. Cancellare l'archiviazione o i dati disconnette l'account perché elimina la sessione salvata. Tenga pronti il nome utente e la password Tradovate o della prop firm prima di cancellarla. Cancellare solo la cache, invece, di solito mantiene l'accesso attivo." },
    { q: "Cancellare cache e archiviazione non ha funzionato, cosa fare ora?", a: "Aggiorni l'app dal Play Store, riavvii il telefono, liberi spazio di archiviazione se il dispositivo è quasi pieno e verifichi che la versione di Android soddisfi il requisito minimo dell'app (Android 7.0 o superiore). Se dopo tutto ciò la schermata è ancora nera, disinstalli completamente l'app, riavvii e reinstalli una copia nuova." },
    { q: "La schermata nera è un problema con le operazioni o solo con l'app?", a: "È un problema di visualizzazione su quel singolo dispositivo, non un problema di account o di ordini. Tutti gli stop e gli obiettivi impostati restano attivi sui server di Tradovate e continuano a funzionare mentre l'app sul telefono è nera. Per sicurezza, apra la piattaforma web o desktop per verificare le posizioni mentre risolve il problema sul telefono." },
    { q: "Quale versione di Android richiede l'app Tradovate?", a: "L'app Tradovate: Futures Trading richiede Android 7.0 o superiore. Su un sistema operativo più vecchio, l'app potrebbe non avviarsi o non visualizzarsi correttamente. Controlli la versione di Android in Impostazioni &rarr; Informazioni sul telefono &rarr; Informazioni sul software e aggiorni il sistema operativo se il dispositivo lo offre." },
    { q: "Posso continuare a gestire le posizioni aperte mentre l'app non si carica?", a: "Sì. Effettui l'accesso alla piattaforma web di Tradovate da un browser o utilizzi l'app desktop per vedere e gestire lo stesso account. Poiché la schermata nera è un problema di rendering lato client, le posizioni e gli ordini in sospeso restano completamente accessibili da qualsiasi altro client Tradovate." },
    { q: "Reinstallare l'app risolve la schermata nera?", a: "Spesso sì, ma provi prima a cancellare cache e archiviazione, perché una reinstallazione fa la stessa cosa nel modo più lungo e richiede più tempo. Reinstallare è l'ultima risorsa corretta se la cancellazione dei dati, l'aggiornamento e il riavvio falliscono tutti, poiché garantisce un'installazione pulita dell'ultima versione." },
  ] },
