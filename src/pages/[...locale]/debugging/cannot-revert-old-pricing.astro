---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "cannot-revert-old-pricing";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/debugging/${SLUG}`;

const META_TITLE = "Tradovate Can't Revert to Old Plan Pricing";
const META_DESCRIPTION =
  "Legacy plan pricing can't be restored once you switch futures broker plans. Check the new commission rates before you opt in, here's what to know.";

// Short SEO title (<=60 chars) for locales where the shared h1 is too long for a SERP title.
const TITLE_OVERRIDE: Partial<Record<Locale, string>> = { it: "Tradovate: impossibile tornare al vecchio piano tariffario" };

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Tradovate: Keine Rückkehr zur alten Preisstruktur", es: "Tradovate no permite volver al precio del plan anterior", fr: "Impossible de revenir à l'ancien tarif du plan sur Tradovate", it: "Tradovate non consente di tornare al vecchio piano tariffario" },
  dek: { en: "Opting in to a new Tradovate Account Plan is a one-way door, there's no toggle, no undo, and cancelling doesn't bring your legacy rate back. Here's how to check the numbers before you switch.", de: "Der Wechsel zu einem neuen Tradovate Account Plan ist eine Einbahnstraße, es gibt keinen Schalter, kein Rückgängig, und Kündigen bringt Ihren alten Satz nicht zurück. So prüfen Sie die Zahlen, bevor Sie wechseln.", es: "Unirse a un nuevo Tradovate Account Plan es una puerta sin retorno, no hay interruptor, no hay deshacer, y cancelar no le devuelve su tarifa antigua. Así puede revisar las cifras antes de cambiar.", fr: "Adhérer à un nouvel Account Plan Tradovate est une porte sans retour, il n'y a ni interrupteur, ni annulation possible, et résilier ne restaure pas votre ancien tarif. Voici comment vérifier les chiffres avant de changer.", it: "Aderire a un nuovo Account Plan Tradovate è una porta a senso unico, non c'è interruttore, non c'è annullamento, e disdire non ripristina la sua vecchia tariffa. Ecco come controllare i numeri prima di cambiare." },
  readTime: { en: "8 min read", de: "8 Minuten Lesezeit", es: "Lectura de 8 minutos", fr: "Lecture de 8 minutes", it: "Lettura di 8 minuti" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "Here's the part that catches people off guard: switching your Tradovate Account Plan is a one-way door. Tradovate's own plan documentation spells it out, <strong class='text-white'>once you opt in to a new Account Plan, you can't revert to the old pricing structure.</strong> There's no undo button, no toggle in settings, and no “put me back the way I was” link. If you clicked <em>Upgrade</em> to grab the free market data or TradingView access and then realized your legacy commissions were better for how you actually trade, that decision has already been made. This guide explains exactly what happened, why the door only swings one way, and, most importantly, how to check the numbers <em>before</em> you switch so you never end up stuck on the wrong side of it." },
    { type: "quote", html: "Plan prices and commission rates change. The figures in this guide were verified against Tradovate's published plan and pricing documentation at the time of writing, but Tradovate can revise its structure at any time. Always confirm the current commissions and plan terms on the Settings &gt; Plans page of your own account before you opt in." },
    {
      type: "checklist",
      heading: "Quick Checklist Before You Touch Your Plan",
      items: [
        "<strong class='text-white'>Assume it's permanent.</strong> Opting in to a new Account Plan replaces your legacy pricing for good. Decide as if there's no going back, because there isn't.",
        "<strong class='text-white'>Know your real commissions.</strong> Pull up the per-side rate for the exact contracts you trade, standards vs. micros, on both your current pricing and the new plan.",
        "<strong class='text-white'>Value the bundled perks honestly.</strong> New plans add free Level I CME Group and EUREX data plus TradingView, Market Replay, and Order Flow+. If you were paying for data separately, that offsets a higher commission.",
        "<strong class='text-white'>Cancelling isn't a rewind.</strong> Dropping a Monthly plan lands you on the current Free plan, not your old legacy rates.",
        "<strong class='text-white'>Prop accounts are different.</strong> Evaluation and funded accounts run on firm-set pricing, this retail plan mechanic doesn't apply. Check your firm's rules.",
        "<strong class='text-white'>Screenshot before you click.</strong> Capture your current plan and commission screen so you have a record of what you had.",
      ],
    },
    { type: "heading", text: "What “Can't Revert to Old Pricing” Actually Means" },
    { type: "paragraph", html: "Tradovate overhauled its Account Plan pricing in 2025. The mechanic that matters: accounts opened before the changeover kept their <strong class='text-white'>older, legacy pricing structure</strong> and stayed on it until the account holder chose to opt in to one of the new plans. Nobody was force-migrated. Your legacy rates sat there quietly, working the same as always, right up until the moment you pressed <em>Upgrade</em>." },
    { type: "paragraph", html: "That opt-in is the point of no return. When you select a new Account Plan, Tradovate swaps your account onto the new pricing structure and the legacy rates are retired for that account. The documentation states plainly that you cannot go back to the old structure afterward. So this isn't a bug, a glitch, or a support oversight, it's the intended design. The “problem” traders run into is almost always the same: they opted in for one benefit without realizing they were permanently giving up a legacy rate they valued more." },
    { type: "paragraph", html: "What do you gain by opting in? The new plans bundle perks the legacy structure didn't hand out for free: <strong class='text-white'>Level I CME Group and EUREX market data at no extra charge</strong>, plus access to TradingView, Market Replay, and the Order Flow+ toolset. The catch is on the commission side, the new Free and Monthly plans carry a <em>slightly higher micro-contract commission</em> than some legacy rates. For a micro-heavy scalper, that small per-side bump can outweigh the free data. For someone trading standards or leaning on TradingView, the new plan is often the better deal. The whole decision hinges on which side of that math you fall on." },
    { type: "heading", text: "Why Traders Get Burned by the Switch" },
    { type: "heading", text: "1. Chasing the free data without reading the commissions" },
    { type: "paragraph", html: "Free Level I market data is a genuinely nice perk, and it's the single most common reason people click <em>Upgrade</em>. The mistake is treating it as a pure freebie. If your legacy plan had a lower micro commission and you trade a lot of micros, “free data” can quietly cost you more in commissions than the data was ever worth, and now you can't undo it." },
    { type: "heading", text: "2. Assuming you can cancel your way back" },
    { type: "paragraph", html: "A lot of traders believe that if the new Monthly plan doesn't work out, they'll just cancel and land back where they started. They won't. Cancelling a Monthly Account Plan puts you on the <strong class='text-white'>current Free plan with full-priced commissions</strong>, the new structure's Free tier, not your old legacy pricing. Cancellation is a step sideways within the new world, never a trip back to the old one." },
    { type: "heading", text: "3. Not knowing they were on legacy pricing at all" },
    { type: "paragraph", html: "If your account predates the pricing change, you may never have thought of yourself as “on legacy pricing.” It was just your pricing. That makes it easy to click through the upgrade flow without registering that you're trading a known, grandfathered rate for a new one. The value you're giving up is invisible until it's gone." },
    { type: "heading", text: "4. Confusing the plan change with a plan cost change" },
    { type: "paragraph", html: "Opting in to the new Lifetime plan carries no commission change and no extra ongoing cost beyond the one-time payment, so it feels low-risk. But “no added cost” is not the same as “reversible.” Even a plan that looks like a clean upgrade still burns your legacy rates on the way in." },
    { type: "heading", text: "5. Reading a review or comparison instead of your own account" },
    { type: "paragraph", html: "Published rate tables and broker reviews describe the <em>new</em> plans. They rarely describe the specific legacy rate sitting on your account, which may be different. Basing the decision on a generic pricing article rather than your own Settings &gt; Plans screen is how people talk themselves into a switch that doesn't fit their trading." },
    { type: "heading", text: "How to Handle It: Step-by-Step" },
    { type: "heading", text: "If you haven't switched yet, compare before you commit" },
    { type: "paragraph", html: "This is the whole ballgame. The reversal problem is only a problem if you opt in blind, so slow down and do the math first." },
    {
      type: "steps",
      items: [
        { title: "Open Settings > Plans", html: "Open your Account Dashboard and go to <strong class='text-white'>Settings &gt; Plans</strong> (confirm the exact menu label in your current build)." },
        { title: "Write down your current commissions", html: "Write down your current per-side commission for the contracts you actually trade, separate the number for standards from the number for micros." },
        { title: "Note the new plan's commissions", html: "Open the new plan you're considering and note its per-side commission for those same contracts, plus its flat cost (monthly or one-time)." },
        { title: "Add up the bundled benefits", html: "Add up the bundled benefits you'd start getting for free, Level I CME/EUREX data, TradingView, Market Replay, Order Flow+, and subtract anything you currently pay for that the plan would replace." },
        { title: "Run the numbers on your own volume", html: "Estimate a realistic month of your volume and run both numbers. If the new plan wins on <em>your</em> contracts, opt in. If your legacy rate wins, stay put." },
      ],
    },
    { type: "paragraph", html: "When you do click <em>Upgrade</em>, read the confirmation screen instead of clicking past it. Tradovate typically surfaces a confirmation step before the switch takes effect, that dialog is your last chance to back out, so treat it as a stop sign, not a formality." },
    { type: "heading", text: "If you already switched, work the account you're on now" },
    { type: "paragraph", html: "The legacy rate is gone, so the productive move is to optimize the plan you landed on rather than chase a reversal that isn't coming." },
    {
      type: "steps",
      items: [
        { title: "Confirm which plan you're actually on", html: "Go back to Settings &gt; Plans and verify your current tier and commissions so you're working from facts, not memory." },
        { title: "Pick the best-fit new plan", html: "If you trade enough volume, the Monthly or Lifetime plan's lower per-side commission may beat the Free tier you'd get by cancelling. Do that math the same way as above." },
        { title: "Use the perks you're now paying for", html: "You have free Level I data and the platform tools, fold them into your workflow so you're actually getting value from the switch." },
        { title: "Contact support if you want it on record", html: "Contact support if you want it on record, but go in expecting a no. The policy is that you can't revert; asking costs nothing, but don't build your plan around a reversal." },
      ],
    },
    { type: "heading", text: "If it's a prop-firm or evaluation account" },
    { type: "paragraph", html: "None of the retail plan mechanics above apply. Evaluation and funded accounts run on pricing, commissions, and data entitlements set by the prop firm, and the amounts vary by firm and account size. If a pricing or commission line on a funded account looks wrong, that's a conversation with your prop firm, check their current rules rather than looking for a plan toggle inside Tradovate." },
    { type: "heading", text: "Troubleshooting Table" },
    {
      type: "table",
      headers: ["Situation", "What's happening", "What to do"],
      rows: [
        ["Opted in, now want the old rate back", "Legacy pricing is retired the moment you opt in, by design", "Optimize the new plan you're on; a reversal isn't available"],
        ["Cancelled Monthly, expected legacy pricing", "Cancelling lands you on the current Free plan, not legacy", "Choose the best-fit new plan for your volume instead"],
        ["Higher commissions after switching", "New Free/Monthly plans carry a slightly higher micro rate", "Weigh it against the free data and tools you now get"],
        ["Not sure if you're on legacy pricing", "Older accounts stayed on legacy rates until they opted in", "Check Settings &gt; Plans before touching anything"],
        ["Pricing looks wrong on a funded account", "Prop/eval accounts use firm-set pricing, not retail plans", "Contact your prop firm; rules vary by firm and account size"],
        ["Deciding whether to switch at all", "The value depends on your own contract mix", "Compare per-side rates for the contracts you actually trade"],
      ],
    },
    { type: "heading", text: "Trade the Same Setup Whatever Plan You Land On" },
    { type: "paragraph", html: "Your Account Plan changes your commissions and perks, it doesn't have to change how your strategy gets executed. PickMyTrade links your TradingView alerts straight to your Tradovate account, so the plan you pick is a pricing decision, not a workflow disruption:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Automation that outlives the switch</strong>, your alerts keep firing real orders whether you're on legacy pricing, a new Free plan, or Monthly, so a plan change never breaks your routing.",
        "<strong class='text-white'>Consistent execution</strong>, the same setup runs the same way, which makes it easy to compare real commission costs across plans on identical trade flow.",
        "<strong class='text-white'>Multi-account sync</strong>, mirror one strategy across several Tradovate accounts even when they sit on different plans.",
        "<strong class='text-white'>Clean trade records</strong>, every automated fill is logged, so you can actually measure whether the plan you chose is paying off.",
      ],
    },
    { type: "paragraph", html: "Picking the right plan is still on you, but automation means that whichever side of the one-way door you land on, your execution keeps running exactly the same." },
  ], de: [
    { type: "paragraph", html: "Hier ist der Teil, der viele überrascht: Der Wechsel Ihres Tradovate Account Plans ist eine Einbahnstraße. Tradovates eigene Plan-Dokumentation stellt es klar: <strong class='text-white'>Sobald Sie sich für einen neuen Account Plan entscheiden, können Sie nicht zur alten Preisstruktur zurückkehren.</strong> Es gibt keinen Rückgängig-Button, keinen Schalter in den Einstellungen und keinen &ldquo;Bring mich zurück, wie es war&rdquo;-Link. Wenn Sie auf <em>Upgrade</em> geklickt haben, um die kostenlosen Marktdaten oder den TradingView-Zugang zu bekommen, und danach festgestellt haben, dass Ihre alten Kommissionen besser zu Ihrer Handelsweise passten, ist diese Entscheidung bereits gefallen. Dieser Leitfaden erklärt genau, was passiert ist, warum sich die Tür nur in eine Richtung öffnet und, vor allem, wie Sie die Zahlen <em>vor</em> dem Wechsel prüfen, damit Sie nie auf der falschen Seite dieser Tür landen." },
    { type: "quote", html: "Plan-Preise und Kommissionssätze ändern sich. Die Zahlen in diesem Leitfaden wurden zum Zeitpunkt der Erstellung anhand von Tradovates veröffentlichter Plan- und Preisdokumentation überprüft, aber Tradovate kann seine Struktur jederzeit ändern. Bestätigen Sie die aktuellen Kommissionen und Plankonditionen immer auf der Seite Settings &gt; Plans Ihres eigenen Kontos, bevor Sie sich entscheiden." },
    {
      type: "checklist",
      heading: "Kurze Checkliste, bevor Sie Ihren Plan ändern",
      items: [
        "<strong class='text-white'>Gehen Sie von Endgültigkeit aus.</strong> Der Wechsel zu einem neuen Account Plan ersetzt Ihre alte Preisstruktur dauerhaft. Entscheiden Sie so, als gäbe es kein Zurück, denn das gibt es nicht.",
        "<strong class='text-white'>Kennen Sie Ihre tatsächlichen Kommissionen.</strong> Rufen Sie den Satz pro Seite für genau die Kontrakte ab, die Sie handeln, Standard- vs. Micro-Kontrakte, sowohl für Ihre aktuelle Preisstruktur als auch für den neuen Plan.",
        "<strong class='text-white'>Bewerten Sie die enthaltenen Vorteile ehrlich.</strong> Neue Pläne bringen kostenlose Level-I-Daten von CME Group und EUREX sowie TradingView, Market Replay und Order Flow+ mit. Wenn Sie Daten bisher separat bezahlt haben, gleicht das eine höhere Kommission aus.",
        "<strong class='text-white'>Kündigen ist kein Zurückspulen.</strong> Wenn Sie einen Monthly-Plan kündigen, landen Sie auf dem aktuellen Free-Plan, nicht bei Ihren alten Preisen.",
        "<strong class='text-white'>Prop-Konten sind anders.</strong> Evaluation- und Funded-Konten laufen mit von der Firma festgelegten Preisen, diese Retail-Plan-Mechanik gilt dort nicht. Prüfen Sie die Regeln Ihrer Firma.",
        "<strong class='text-white'>Machen Sie einen Screenshot, bevor Sie klicken.</strong> Halten Sie Ihren aktuellen Plan- und Kommissionsbildschirm fest, damit Sie einen Nachweis dessen haben, was Sie hatten.",
      ],
    },
    { type: "heading", text: "Was &ldquo;Keine Rückkehr zur alten Preisstruktur&rdquo; tatsächlich bedeutet" },
    { type: "paragraph", html: "Tradovate hat die Preisstruktur seiner Account Plans 2025 grundlegend überarbeitet. Entscheidend ist folgender Mechanismus: Konten, die vor der Umstellung eröffnet wurden, behielten ihre <strong class='text-white'>ältere, alte Preisstruktur</strong> und blieben darauf, bis der Kontoinhaber sich für einen der neuen Pläne entschied. Niemand wurde zwangsweise umgestellt. Ihre alten Preise liefen still weiter, genau wie immer, bis zu dem Moment, in dem Sie auf <em>Upgrade</em> klickten." },
    { type: "paragraph", html: "Dieser Wechsel ist der Punkt ohne Wiederkehr. Wenn Sie einen neuen Account Plan auswählen, stellt Tradovate Ihr Konto auf die neue Preisstruktur um, und die alten Preise werden für dieses Konto stillgelegt. Die Dokumentation stellt eindeutig fest, dass Sie danach nicht mehr zur alten Struktur zurückkehren können. Das ist also kein Bug, kein Fehler und kein Support-Versehen, sondern beabsichtigt so gestaltet. Das &ldquo;Problem&rdquo;, in das Trader fast immer geraten, ist dasselbe: Sie haben sich für einen Vorteil entschieden, ohne zu merken, dass sie dauerhaft auf einen alten Preis verzichten, der ihnen eigentlich mehr wert war." },
    { type: "paragraph", html: "Was gewinnen Sie durch den Wechsel? Die neuen Pläne bündeln Vorteile, die die alte Struktur nicht kostenlos bot: <strong class='text-white'>Level-I-Marktdaten von CME Group und EUREX ohne Aufpreis</strong>, dazu Zugang zu TradingView, Market Replay und dem Order-Flow+-Toolset. Der Haken liegt bei den Kommissionen, die neuen Free- und Monthly-Pläne verlangen eine <em>etwas höhere Kommission für Micro-Kontrakte</em> als manche alten Tarife. Für einen Scalper mit viel Micro-Volumen kann dieser kleine Aufschlag pro Seite die kostenlosen Daten mehr als aufwiegen. Für jemanden, der Standard-Kontrakte handelt oder stark auf TradingView setzt, ist der neue Plan oft die bessere Wahl. Die ganze Entscheidung hängt davon ab, auf welcher Seite dieser Rechnung Sie landen." },
    { type: "heading", text: "Warum sich Trader beim Wechsel die Finger verbrennen" },
    { type: "heading", text: "1. Den kostenlosen Daten hinterherjagen, ohne die Kommissionen zu lesen" },
    { type: "paragraph", html: "Kostenlose Level-I-Marktdaten sind ein wirklich attraktiver Vorteil, und sie sind der mit Abstand häufigste Grund, warum Trader auf <em>Upgrade</em> klicken. Der Fehler liegt darin, sie als reines Geschenk zu betrachten. Wenn Ihr alter Plan eine niedrigere Micro-Kommission hatte und Sie viele Micro-Kontrakte handeln, können &ldquo;kostenlose Daten&rdquo; Sie unbemerkt mehr an Kommissionen kosten, als die Daten je wert waren, und jetzt können Sie es nicht mehr rückgängig machen." },
    { type: "heading", text: "2. Anzunehmen, man könne sich durch Kündigen zurückholen" },
    { type: "paragraph", html: "Viele Trader glauben, dass sie einfach kündigen und wieder da landen, wo sie angefangen haben, falls der neue Monthly-Plan nicht funktioniert. Das stimmt nicht. Wenn Sie einen Monthly Account Plan kündigen, landen Sie auf dem <strong class='text-white'>aktuellen Free-Plan mit vollen Kommissionen</strong>, also der Free-Stufe der neuen Struktur, nicht auf Ihrer alten Preisstruktur. Kündigung ist ein Seitwärtsschritt innerhalb der neuen Welt, niemals eine Rückkehr in die alte." },
    { type: "heading", text: "3. Gar nicht zu wissen, dass man auf der alten Preisstruktur war" },
    { type: "paragraph", html: "Wenn Ihr Konto älter ist als die Preisänderung, haben Sie sich vielleicht nie als &ldquo;auf alter Preisstruktur&rdquo; betrachtet. Es war einfach Ihr Preis. Das macht es leicht, sich durch den Upgrade-Vorgang zu klicken, ohne zu bemerken, dass Sie einen bekannten, bestandsgeschützten Satz gegen einen neuen eintauschen. Der Wert, den Sie aufgeben, ist unsichtbar, bis er weg ist." },
    { type: "heading", text: "4. Den Planwechsel mit einer Kostenänderung zu verwechseln" },
    { type: "paragraph", html: "Der Wechsel zum neuen Lifetime-Plan bringt keine Änderung der Kommissionen und keine zusätzlichen laufenden Kosten über die einmalige Zahlung hinaus mit sich, weshalb er risikoarm wirkt. Aber &ldquo;keine zusätzlichen Kosten&rdquo; ist nicht dasselbe wie &ldquo;umkehrbar&rdquo;. Selbst ein Plan, der wie ein sauberes Upgrade wirkt, löscht dabei trotzdem Ihre alten Preise." },
    { type: "heading", text: "5. Einen Testbericht oder Vergleich statt des eigenen Kontos zu lesen" },
    { type: "paragraph", html: "Veröffentlichte Preistabellen und Broker-Testberichte beschreiben die <em>neuen</em> Pläne. Sie beschreiben nur selten den konkreten alten Satz auf Ihrem Konto, der abweichen kann. Eine Entscheidung auf Basis eines allgemeinen Preisartikels statt Ihres eigenen Settings &gt; Plans-Bildschirms zu treffen, ist der Weg, wie sich Trader in einen Wechsel hineinreden, der nicht zu ihrem Handel passt." },
    { type: "heading", text: "So gehen Sie vor: Schritt für Schritt" },
    { type: "heading", text: "Wenn Sie noch nicht gewechselt haben: vergleichen, bevor Sie sich festlegen" },
    { type: "paragraph", html: "Darauf kommt es an. Das Problem der fehlenden Rückkehr ist nur ein Problem, wenn Sie blind zustimmen, also nehmen Sie sich Zeit und rechnen Sie zuerst nach." },
    {
      type: "steps",
      items: [
        { title: "Settings > Plans öffnen", html: "Öffnen Sie Ihr Account Dashboard und gehen Sie zu <strong class='text-white'>Settings &gt; Plans</strong> (bestätigen Sie die genaue Menübezeichnung in Ihrer aktuellen Version)." },
        { title: "Ihre aktuellen Kommissionen notieren", html: "Notieren Sie sich Ihre aktuelle Kommission pro Seite für die Kontrakte, die Sie tatsächlich handeln, getrennt nach Standard- und Micro-Kontrakten." },
        { title: "Kommissionen des neuen Plans notieren", html: "Öffnen Sie den neuen Plan, den Sie in Betracht ziehen, und notieren Sie seine Kommission pro Seite für dieselben Kontrakte sowie seine feste Gebühr (monatlich oder einmalig)." },
        { title: "Enthaltene Vorteile summieren", html: "Zählen Sie die enthaltenen Vorteile zusammen, die Sie kostenlos erhalten würden, Level-I-Daten von CME/EUREX, TradingView, Market Replay, Order Flow+, und ziehen Sie alles ab, was Sie aktuell dafür bezahlen und das der Plan ersetzen würde." },
        { title: "Die Zahlen für Ihr eigenes Volumen durchrechnen", html: "Schätzen Sie einen realistischen Monat Ihres Handelsvolumens und rechnen Sie beide Zahlen durch. Wenn der neue Plan bei <em>Ihren</em> Kontrakten gewinnt, wechseln Sie. Wenn Ihr alter Satz gewinnt, bleiben Sie, wo Sie sind." },
      ],
    },
    { type: "paragraph", html: "Wenn Sie dann auf <em>Upgrade</em> klicken, lesen Sie den Bestätigungsbildschirm, statt ihn einfach wegzuklicken. Tradovate zeigt in der Regel einen Bestätigungsschritt an, bevor der Wechsel wirksam wird, dieser Dialog ist Ihre letzte Chance zum Aussteigen, behandeln Sie ihn also als Stoppschild und nicht als Formalität." },
    { type: "heading", text: "Wenn Sie bereits gewechselt haben: Arbeiten Sie mit dem Konto, das Sie jetzt haben" },
    { type: "paragraph", html: "Der alte Preis ist weg, deshalb ist es sinnvoller, den Plan zu optimieren, auf dem Sie gelandet sind, statt einer Rückkehr hinterherzujagen, die nicht kommen wird." },
    {
      type: "steps",
      items: [
        { title: "Bestätigen, auf welchem Plan Sie tatsächlich sind", html: "Gehen Sie zurück zu Settings &gt; Plans und überprüfen Sie Ihre aktuelle Stufe und Kommissionen, damit Sie mit Fakten arbeiten und nicht aus dem Gedächtnis." },
        { title: "Den am besten passenden neuen Plan wählen", html: "Wenn Sie genug Volumen handeln, kann die niedrigere Kommission pro Seite des Monthly- oder Lifetime-Plans die Free-Stufe schlagen, die Sie durch Kündigen erhalten würden. Rechnen Sie das genauso durch wie oben." },
        { title: "Die Vorteile nutzen, für die Sie jetzt bezahlen", html: "Sie haben kostenlose Level-I-Daten und die Plattform-Tools, binden Sie sie in Ihren Workflow ein, damit der Wechsel tatsächlich einen Mehrwert bringt." },
        { title: "Support kontaktieren, wenn Sie es dokumentiert haben möchten", html: "Kontaktieren Sie den Support, wenn Sie es dokumentiert haben möchten, aber rechnen Sie von vornherein mit einem Nein. Die Richtlinie besagt, dass Sie nicht zurückwechseln können; nachzufragen kostet nichts, aber bauen Sie Ihre Planung nicht auf eine Rückkehr auf." },
      ],
    },
    { type: "heading", text: "Wenn es sich um ein Prop-Firm- oder Evaluation-Konto handelt" },
    { type: "paragraph", html: "Keine der oben genannten Retail-Plan-Mechanismen gelten hier. Evaluation- und Funded-Konten laufen mit Preisen, Kommissionen und Datenrechten, die von der Prop Firm festgelegt werden, und die Beträge variieren je nach Firma und Kontogröße. Wenn eine Preis- oder Kommissionszeile bei einem Funded-Konto falsch erscheint, ist das ein Gespräch mit Ihrer Prop Firm, prüfen Sie deren aktuelle Regeln, statt in Tradovate nach einem Plan-Schalter zu suchen." },
    { type: "heading", text: "Fehlerbehebungstabelle" },
    {
      type: "table",
      headers: ["Situation", "Was passiert", "Was zu tun ist"],
      rows: [
        ["Gewechselt, will nun den alten Satz zurück", "Die alte Preisstruktur wird beim Wechsel absichtlich stillgelegt", "Den neuen Plan optimieren; eine Rückkehr ist nicht möglich"],
        ["Monthly gekündigt, alte Preise erwartet", "Kündigung führt zum aktuellen Free-Plan, nicht zur alten Struktur", "Stattdessen den passendsten neuen Plan für Ihr Volumen wählen"],
        ["Höhere Kommissionen nach dem Wechsel", "Neue Free-/Monthly-Pläne haben eine etwas höhere Micro-Kommission", "Gegen die kostenlosen Daten und Tools abwägen, die Sie jetzt erhalten"],
        ["Unsicher, ob Sie auf der alten Preisstruktur sind", "Ältere Konten blieben auf den alten Sätzen, bis sie wechselten", "Vor jeder Änderung Settings &gt; Plans prüfen"],
        ["Preise auf einem Funded-Konto wirken falsch", "Prop-/Eval-Konten nutzen von der Firma festgelegte Preise, keine Retail-Pläne", "Ihre Prop Firm kontaktieren; Regeln variieren je nach Firma und Kontogröße"],
        ["Entscheidung, ob überhaupt gewechselt werden soll", "Der Wert hängt von Ihrem eigenen Kontrakt-Mix ab", "Kommissionen pro Seite für die tatsächlich gehandelten Kontrakte vergleichen"],
      ],
    },
    { type: "heading", text: "Handeln Sie mit demselben Setup, egal auf welchem Plan Sie landen" },
    { type: "paragraph", html: "Ihr Account Plan ändert Ihre Kommissionen und Vorteile, er muss aber nicht ändern, wie Ihre Strategie ausgeführt wird. PickMyTrade verbindet Ihre TradingView-Alerts direkt mit Ihrem Tradovate-Konto, sodass der gewählte Plan eine Preisentscheidung ist, keine Unterbrechung Ihres Workflows:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Automatisierung, die den Wechsel übersteht</strong>, Ihre Alerts lösen weiterhin echte Orders aus, egal ob Sie auf der alten Preisstruktur, einem neuen Free-Plan oder Monthly sind, sodass ein Planwechsel Ihr Routing nie stört.",
        "<strong class='text-white'>Konsistente Ausführung</strong>, dasselbe Setup läuft auf dieselbe Weise, wodurch es einfach wird, die tatsächlichen Kommissionskosten zwischen Plänen bei identischem Handelsfluss zu vergleichen.",
        "<strong class='text-white'>Synchronisierung mehrerer Konten</strong>, spiegeln Sie eine Strategie auf mehrere Tradovate-Konten, auch wenn diese auf unterschiedlichen Plänen laufen.",
        "<strong class='text-white'>Saubere Handelsaufzeichnungen</strong>, jede automatisierte Ausführung wird protokolliert, sodass Sie tatsächlich messen können, ob sich der gewählte Plan auszahlt.",
      ],
    },
    { type: "paragraph", html: "Die Wahl des richtigen Plans liegt weiterhin bei Ihnen, aber Automatisierung bedeutet, dass Ihre Ausführung genau gleich weiterläuft, egal auf welcher Seite dieser Einbahnstraße Sie landen." },
  ], es: [
    { type: "paragraph", html: "Esto es lo que sorprende a muchos: cambiar de Account Plan en Tradovate es una puerta sin retorno. La propia documentación de planes de Tradovate lo deja claro: <strong class='text-white'>una vez que se une a un nuevo Account Plan, no puede volver a la estructura de precios anterior.</strong> No hay botón de deshacer, ni interruptor en la configuración, ni enlace para &ldquo;volver a como estaba&rdquo;. Si hizo clic en <em>Upgrade</em> para obtener datos de mercado gratuitos o acceso a TradingView, y luego se dio cuenta de que sus comisiones antiguas eran mejores para su forma de operar, esa decisión ya está tomada. Esta guía explica exactamente qué ocurrió, por qué la puerta solo se abre en un sentido y, lo más importante, cómo revisar las cifras <em>antes</em> de cambiar de plan, para que nunca termine en el lado equivocado de esa puerta." },
    { type: "quote", html: "Los precios de los planes y las comisiones cambian. Las cifras de esta guía se verificaron con la documentación oficial de planes y precios de Tradovate en el momento de su redacción, pero Tradovate puede modificar su estructura en cualquier momento. Confirme siempre las comisiones y condiciones actuales del plan en la página Settings &gt; Plans de su propia cuenta antes de aceptar el cambio." },
    {
      type: "checklist",
      heading: "Lista de verificación rápida antes de tocar su plan",
      items: [
        "<strong class='text-white'>Asuma que es permanente.</strong> Unirse a un nuevo Account Plan sustituye su tarifa antigua para siempre. Decida como si no hubiera vuelta atrás, porque no la hay.",
        "<strong class='text-white'>Conozca sus comisiones reales.</strong> Consulte la tarifa por lado para los contratos exactos que opera, estándar frente a micro, tanto en su precio actual como en el nuevo plan.",
        "<strong class='text-white'>Valore con honestidad las ventajas incluidas.</strong> Los nuevos planes añaden datos de nivel I de CME Group y EUREX gratuitos, además de TradingView, Market Replay y Order Flow+. Si antes pagaba los datos por separado, eso compensa una comisión más alta.",
        "<strong class='text-white'>Cancelar no es retroceder.</strong> Dar de baja un plan Monthly lo lleva al plan Free actual, no a sus tarifas antiguas.",
        "<strong class='text-white'>Las cuentas prop son distintas.</strong> Las cuentas de evaluación y financiadas usan precios fijados por la firma, esta mecánica de planes minoristas no se aplica. Consulte las reglas de su firma.",
        "<strong class='text-white'>Haga una captura de pantalla antes de hacer clic.</strong> Capture la pantalla de su plan y comisiones actuales para tener constancia de lo que tenía.",
      ],
    },
    { type: "heading", text: "Qué significa realmente &ldquo;no se puede volver al precio antiguo&rdquo;" },
    { type: "paragraph", html: "Tradovate reformó por completo el precio de sus Account Plans en 2025. El mecanismo clave es este: las cuentas abiertas antes del cambio conservaron su <strong class='text-white'>estructura de precios anterior</strong> y permanecieron en ella hasta que el titular decidió unirse a uno de los nuevos planes. Nadie fue migrado a la fuerza. Sus tarifas antiguas siguieron funcionando en silencio, igual que siempre, hasta el momento en que pulsó <em>Upgrade</em>." },
    { type: "paragraph", html: "Ese cambio es el punto sin retorno. Cuando selecciona un nuevo Account Plan, Tradovate traslada su cuenta a la nueva estructura de precios y las tarifas antiguas quedan retiradas para esa cuenta. La documentación indica claramente que después no se puede volver a la estructura anterior. No se trata de un error, un fallo ni un descuido del soporte, es el diseño previsto. El &ldquo;problema&rdquo; con el que se topan los traders es casi siempre el mismo: se unieron a un plan por un beneficio sin darse cuenta de que renunciaban de forma permanente a una tarifa antigua que valoraban más." },
    { type: "paragraph", html: "¿Qué gana al unirse a un nuevo plan? Los nuevos planes agrupan ventajas que la estructura antigua no ofrecía gratis: <strong class='text-white'>datos de mercado de nivel I de CME Group y EUREX sin coste adicional</strong>, además de acceso a TradingView, Market Replay y el conjunto de herramientas Order Flow+. La trampa está en las comisiones, los nuevos planes Free y Monthly tienen una <em>comisión ligeramente más alta para contratos micro</em> que algunas tarifas antiguas. Para un scalper que opera muchos micros, ese pequeño incremento por lado puede superar el valor de los datos gratuitos. Para quien opera contratos estándar o depende de TradingView, el nuevo plan suele ser la mejor opción. Toda la decisión depende de en qué lado de esa cuenta se sitúe usted." },
    { type: "heading", text: "Por qué a los traders les sale caro el cambio" },
    { type: "heading", text: "1. Ir tras los datos gratuitos sin leer las comisiones" },
    { type: "paragraph", html: "Los datos de mercado gratuitos de nivel I son una ventaja realmente atractiva y, con diferencia, la razón más común por la que la gente hace clic en <em>Upgrade</em>. El error está en tratarlos como un simple regalo. Si su plan anterior tenía una comisión de micro más baja y usted opera muchos micros, los &ldquo;datos gratuitos&rdquo; pueden acabar costándole más en comisiones de lo que esos datos valían, y ahora ya no puede deshacerlo." },
    { type: "heading", text: "2. Suponer que cancelar le devuelve al plan anterior" },
    { type: "paragraph", html: "Muchos traders creen que, si el nuevo plan Monthly no funciona, simplemente cancelarán y volverán al punto de partida. No es así. Cancelar un Account Plan Monthly lo lleva al <strong class='text-white'>plan Free actual con comisiones a precio completo</strong>, es decir, al nivel Free de la nueva estructura, no a su precio antiguo. Cancelar es un movimiento lateral dentro del nuevo sistema, nunca un viaje de vuelta al antiguo." },
    { type: "heading", text: "3. No saber siquiera que estaba en el precio antiguo" },
    { type: "paragraph", html: "Si su cuenta es anterior al cambio de precios, puede que nunca haya pensado en sí mismo como alguien &ldquo;con precio antiguo&rdquo;. Simplemente era su precio. Eso hace fácil hacer clic a lo largo del flujo de actualización sin darse cuenta de que está cambiando una tarifa conocida y protegida por otra nueva. El valor que está cediendo es invisible hasta que desaparece." },
    { type: "heading", text: "4. Confundir el cambio de plan con un cambio de coste" },
    { type: "paragraph", html: "Unirse al nuevo plan Lifetime no supone ningún cambio en las comisiones ni un coste adicional recurrente más allá del pago único, por lo que parece de bajo riesgo. Pero &ldquo;sin coste adicional&rdquo; no es lo mismo que &ldquo;reversible&rdquo;. Incluso un plan que parece una actualización sencilla elimina igualmente sus tarifas antiguas al hacerlo." },
    { type: "heading", text: "5. Guiarse por una reseña o comparativa en lugar de su propia cuenta" },
    { type: "paragraph", html: "Las tablas de tarifas publicadas y las reseñas de brókers describen los planes <em>nuevos</em>. Rara vez describen la tarifa antigua concreta que tiene su cuenta, que puede ser diferente. Basar la decisión en un artículo genérico de precios en lugar de en su propia pantalla de Settings &gt; Plans es cómo la gente termina convenciéndose de un cambio que no encaja con su forma de operar." },
    { type: "heading", text: "Cómo gestionarlo: paso a paso" },
    { type: "heading", text: "Si aún no ha cambiado, compare antes de decidirse" },
    { type: "paragraph", html: "Aquí está todo el juego. El problema de la reversión solo es un problema si acepta a ciegas, así que tómese su tiempo y haga los números primero." },
    {
      type: "steps",
      items: [
        { title: "Abrir Settings > Plans", html: "Abra su Account Dashboard y vaya a <strong class='text-white'>Settings &gt; Plans</strong> (confirme la etiqueta exacta del menú en su versión actual)." },
        { title: "Anotar sus comisiones actuales", html: "Anote su comisión actual por lado para los contratos que realmente opera, separando la cifra de los estándar de la de los micro." },
        { title: "Anotar las comisiones del nuevo plan", html: "Abra el nuevo plan que está considerando y anote su comisión por lado para esos mismos contratos, además de su coste fijo (mensual o único)." },
        { title: "Sumar las ventajas incluidas", html: "Sume las ventajas incluidas que empezaría a recibir gratis, datos de nivel I de CME/EUREX, TradingView, Market Replay, Order Flow+, y reste todo lo que paga actualmente y que el plan sustituiría." },
        { title: "Calcular las cifras con su propio volumen", html: "Estime un mes realista de su volumen y calcule ambas cifras. Si el nuevo plan gana en <em>sus</em> contratos, únase a él. Si gana su tarifa antigua, quédese donde está." },
      ],
    },
    { type: "paragraph", html: "Cuando finalmente haga clic en <em>Upgrade</em>, lea la pantalla de confirmación en lugar de cerrarla sin más. Tradovate suele mostrar un paso de confirmación antes de que el cambio surta efecto, ese cuadro de diálogo es su última oportunidad de echarse atrás, así que trátelo como una señal de stop, no como un mero trámite." },
    { type: "heading", text: "Si ya ha cambiado, trabaje con la cuenta que tiene ahora" },
    { type: "paragraph", html: "La tarifa antigua ha desaparecido, así que lo más productivo es optimizar el plan en el que ha acabado en lugar de perseguir una reversión que no va a llegar." },
    {
      type: "steps",
      items: [
        { title: "Confirmar en qué plan está realmente", html: "Vuelva a Settings &gt; Plans y compruebe su nivel y comisiones actuales para trabajar con datos reales y no de memoria." },
        { title: "Elegir el nuevo plan que mejor encaje", html: "Si opera suficiente volumen, la comisión por lado más baja del plan Monthly o Lifetime puede superar al nivel Free que obtendría cancelando. Haga ese cálculo igual que antes." },
        { title: "Aprovechar las ventajas que ya está pagando", html: "Tiene datos de nivel I gratuitos y las herramientas de la plataforma, incorpórelos a su flujo de trabajo para sacar realmente valor del cambio." },
        { title: "Contactar con soporte si quiere dejarlo por escrito", html: "Contacte con soporte si quiere dejar constancia de ello, pero vaya con la expectativa de un no. La política es que no se puede revertir; preguntar no cuesta nada, pero no construya su plan basándose en una reversión." },
      ],
    },
    { type: "heading", text: "Si se trata de una cuenta de prop firm o de evaluación" },
    { type: "paragraph", html: "Ninguna de las mecánicas de planes minoristas anteriores se aplica aquí. Las cuentas de evaluación y financiadas funcionan con precios, comisiones y derechos de datos establecidos por la prop firm, y los importes varían según la firma y el tamaño de la cuenta. Si una línea de precio o comisión en una cuenta financiada parece incorrecta, eso es una conversación con su prop firm, consulte sus normas actuales en lugar de buscar un interruptor de plan dentro de Tradovate." },
    { type: "heading", text: "Tabla de solución de problemas" },
    {
      type: "table",
      headers: ["Situación", "Qué está pasando", "Qué hacer"],
      rows: [
        ["Se unió y ahora quiere la tarifa antigua de vuelta", "El precio antiguo se retira en el momento del cambio, por diseño", "Optimizar el nuevo plan en el que está; no hay reversión disponible"],
        ["Canceló Monthly, esperaba el precio antiguo", "Cancelar lleva al plan Free actual, no al precio antiguo", "Elegir en su lugar el nuevo plan que mejor encaje con su volumen"],
        ["Comisiones más altas tras el cambio", "Los nuevos planes Free/Monthly tienen una tarifa micro algo más alta", "Compararlo con los datos y herramientas gratuitos que ahora recibe"],
        ["No está seguro de si tiene el precio antiguo", "Las cuentas antiguas mantuvieron el precio antiguo hasta unirse", "Comprobar Settings &gt; Plans antes de tocar nada"],
        ["El precio parece incorrecto en una cuenta financiada", "Las cuentas prop/eval usan precios fijados por la firma, no planes minoristas", "Contactar con su prop firm; las reglas varían según firma y tamaño de cuenta"],
        ["Decidir si conviene cambiar de plan", "El valor depende de su propia combinación de contratos", "Comparar las tarifas por lado de los contratos que realmente opera"],
      ],
    },
    { type: "heading", text: "Opere con la misma configuración sin importar el plan en el que acabe" },
    { type: "paragraph", html: "Su Account Plan cambia sus comisiones y ventajas, pero no tiene por qué cambiar cómo se ejecuta su estrategia. PickMyTrade conecta sus alertas de TradingView directamente con su cuenta de Tradovate, de modo que el plan que elija sea una decisión de precio, no una interrupción de su flujo de trabajo:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Automatización que sobrevive al cambio</strong>, sus alertas siguen enviando órdenes reales, ya esté con el precio antiguo, un nuevo plan Free o Monthly, así que un cambio de plan nunca rompe su enrutamiento.",
        "<strong class='text-white'>Ejecución consistente</strong>, la misma configuración funciona de la misma manera, lo que facilita comparar los costes reales de comisiones entre planes con un flujo de operaciones idéntico.",
        "<strong class='text-white'>Sincronización multicuenta</strong>, replique una estrategia en varias cuentas de Tradovate incluso cuando están en planes distintos.",
        "<strong class='text-white'>Registros de operaciones limpios</strong>, cada ejecución automatizada queda registrada, para que pueda medir realmente si el plan elegido está dando resultado.",
      ],
    },
    { type: "paragraph", html: "Elegir el plan correcto sigue siendo cosa suya, pero la automatización significa que, sea cual sea el lado de esa puerta sin retorno en el que acabe, su ejecución sigue funcionando exactamente igual." },
  ], fr: [
    { type: "paragraph", html: "Voici ce qui prend beaucoup de monde au dépourvu : changer de Account Plan Tradovate est une porte sans retour. La documentation officielle des plans Tradovate est claire : <strong class='text-white'>une fois que vous adhérez à un nouvel Account Plan, vous ne pouvez plus revenir à l'ancienne structure tarifaire.</strong> Il n'y a ni bouton annuler, ni interrupteur dans les paramètres, ni lien pour «revenir comme avant». Si vous avez cliqué sur <em>Upgrade</em> pour obtenir les données de marché gratuites ou l'accès à TradingView, puis réalisé que vos anciennes commissions convenaient mieux à votre façon de trader, cette décision est déjà prise. Ce guide explique exactement ce qui s'est passé, pourquoi cette porte ne s'ouvre que dans un sens et, surtout, comment vérifier les chiffres <em>avant</em> de changer de plan, afin de ne jamais vous retrouver du mauvais côté de cette porte." },
    { type: "quote", html: "Les prix des plans et les taux de commission évoluent. Les chiffres de ce guide ont été vérifiés à partir de la documentation officielle des plans et tarifs de Tradovate au moment de la rédaction, mais Tradovate peut modifier sa structure à tout moment. Vérifiez toujours les commissions et conditions actuelles sur la page Settings &gt; Plans de votre propre compte avant d'adhérer à un nouveau plan." },
    {
      type: "checklist",
      heading: "Liste de vérification rapide avant de modifier votre plan",
      items: [
        "<strong class='text-white'>Considérez que c'est permanent.</strong> Adhérer à un nouvel Account Plan remplace définitivement votre ancienne tarification. Décidez comme s'il n'y avait pas de retour possible, car il n'y en a pas.",
        "<strong class='text-white'>Connaissez vos commissions réelles.</strong> Consultez le tarif par côté pour les contrats exacts que vous tradez, standards contre micros, à la fois sur votre tarification actuelle et sur le nouveau plan.",
        "<strong class='text-white'>Évaluez honnêtement les avantages inclus.</strong> Les nouveaux plans ajoutent des données Level I CME Group et EUREX gratuites, ainsi que TradingView, Market Replay et Order Flow+. Si vous payiez les données séparément, cela compense une commission plus élevée.",
        "<strong class='text-white'>Annuler n'est pas un retour en arrière.</strong> Résilier un plan Monthly vous fait basculer vers le plan Free actuel, pas vers vos anciens tarifs.",
        "<strong class='text-white'>Les comptes prop sont différents.</strong> Les comptes d'évaluation et financés fonctionnent avec une tarification fixée par la firme, cette mécanique de plan grand public ne s'applique pas. Vérifiez les règles de votre firme.",
        "<strong class='text-white'>Faites une capture d'écran avant de cliquer.</strong> Enregistrez votre écran de plan et de commissions actuel pour garder une trace de ce que vous aviez.",
      ],
    },
    { type: "heading", text: "Ce que signifie vraiment «impossible de revenir à l'ancien tarif»" },
    { type: "paragraph", html: "Tradovate a entièrement revu la tarification de ses Account Plans en 2025. Le mécanisme essentiel est le suivant : les comptes ouverts avant ce changement ont conservé leur <strong class='text-white'>ancienne structure tarifaire</strong> et y sont restés jusqu'à ce que le titulaire choisisse d'adhérer à l'un des nouveaux plans. Personne n'a été migré de force. Vos anciens tarifs continuaient de s'appliquer discrètement, comme toujours, jusqu'au moment précis où vous avez cliqué sur <em>Upgrade</em>." },
    { type: "paragraph", html: "Cette adhésion est le point de non-retour. Lorsque vous sélectionnez un nouvel Account Plan, Tradovate fait basculer votre compte vers la nouvelle structure tarifaire et les anciens tarifs sont définitivement retirés pour ce compte. La documentation indique clairement qu'il est ensuite impossible de revenir à l'ancienne structure. Ce n'est donc ni un bug, ni un dysfonctionnement, ni un oubli du support, c'est le fonctionnement prévu. Le &laquo;problème&raquo; que rencontrent presque tous les traders est le même : ils ont adhéré pour un avantage sans réaliser qu'ils abandonnaient définitivement un ancien tarif qu'ils appréciaient davantage." },
    { type: "paragraph", html: "Que gagnez-vous en adhérant ? Les nouveaux plans regroupent des avantages que l'ancienne structure ne fournissait pas gratuitement : <strong class='text-white'>des données de marché Level I CME Group et EUREX sans coût supplémentaire</strong>, ainsi que l'accès à TradingView, Market Replay et à la suite d'outils Order Flow+. Le piège se situe du côté des commissions, les nouveaux plans Free et Monthly appliquent une <em>commission légèrement plus élevée sur les contrats micro</em> que certains anciens tarifs. Pour un scalpeur qui trade beaucoup de micros, cette petite hausse par côté peut dépasser la valeur des données gratuites. Pour quelqu'un qui trade des contrats standards ou s'appuie sur TradingView, le nouveau plan est souvent le meilleur choix. Toute la décision repose sur le côté de ce calcul où vous vous situez." },
    { type: "heading", text: "Pourquoi les traders se font piéger par le changement" },
    { type: "heading", text: "1. Se précipiter sur les données gratuites sans lire les commissions" },
    { type: "paragraph", html: "Les données de marché Level I gratuites sont un avantage réellement intéressant, et c'est de loin la raison la plus fréquente pour laquelle les traders cliquent sur <em>Upgrade</em>. L'erreur consiste à les considérer comme un pur cadeau. Si votre ancien plan avait une commission micro plus basse et que vous tradez beaucoup de micros, ces &laquo;données gratuites&raquo; peuvent discrètement vous coûter plus cher en commissions qu'elles ne valent, et vous ne pouvez plus revenir en arrière." },
    { type: "heading", text: "2. Penser qu'annuler permet de revenir en arrière" },
    { type: "paragraph", html: "Beaucoup de traders pensent que si le nouveau plan Monthly ne convient pas, il leur suffira d'annuler pour revenir à leur point de départ. Ce n'est pas le cas. Annuler un Account Plan Monthly vous place sur le <strong class='text-white'>plan Free actuel avec des commissions au tarif plein</strong>, c'est-à-dire le palier Free de la nouvelle structure, et non votre ancienne tarification. L'annulation est un déplacement latéral au sein du nouveau système, jamais un retour vers l'ancien." },
    { type: "heading", text: "3. Ne même pas savoir qu'on était sur l'ancienne tarification" },
    { type: "paragraph", html: "Si votre compte est antérieur au changement de tarification, vous ne vous êtes peut-être jamais considéré comme étant &laquo;sur l'ancienne tarification&raquo;. C'était simplement votre tarif. Cela rend facile de cliquer tout au long du parcours de mise à niveau sans réaliser que vous échangez un tarif connu et protégé contre un nouveau. La valeur que vous abandonnez est invisible jusqu'à ce qu'elle disparaisse." },
    { type: "heading", text: "4. Confondre le changement de plan avec un changement de coût" },
    { type: "paragraph", html: "Adhérer au nouveau plan Lifetime n'entraîne aucun changement de commission ni coût supplémentaire récurrent au-delà du paiement unique, ce qui le fait paraître peu risqué. Mais &laquo;aucun coût supplémentaire&raquo; n'équivaut pas à &laquo;réversible&raquo;. Même un plan qui ressemble à une mise à niveau anodine efface tout de même vos anciens tarifs au passage." },
    { type: "heading", text: "5. Se fier à un avis ou à un comparatif plutôt qu'à son propre compte" },
    { type: "paragraph", html: "Les grilles tarifaires publiées et les avis sur les brokers décrivent les <em>nouveaux</em> plans. Ils décrivent rarement le tarif ancien précis appliqué à votre compte, qui peut être différent. Fonder sa décision sur un article générique sur les tarifs plutôt que sur son propre écran Settings &gt; Plans, c'est ainsi que les traders se convainquent d'un changement qui ne correspond pas à leur façon de trader." },
    { type: "heading", text: "Comment procéder : étape par étape" },
    { type: "heading", text: "Si vous n'avez pas encore changé, comparez avant de vous engager" },
    { type: "paragraph", html: "C'est là tout l'enjeu. Le problème de l'irréversibilité n'en est un que si vous adhérez à l'aveugle, alors prenez le temps de faire vos calculs d'abord." },
    {
      type: "steps",
      items: [
        { title: "Ouvrir Settings > Plans", html: "Ouvrez votre Account Dashboard et allez dans <strong class='text-white'>Settings &gt; Plans</strong> (vérifiez le libellé exact du menu dans votre version actuelle)." },
        { title: "Noter vos commissions actuelles", html: "Notez votre commission actuelle par côté pour les contrats que vous tradez réellement, en séparant le chiffre des standards de celui des micros." },
        { title: "Noter les commissions du nouveau plan", html: "Ouvrez le nouveau plan que vous envisagez et notez sa commission par côté pour ces mêmes contrats, ainsi que son coût fixe (mensuel ou unique)." },
        { title: "Additionner les avantages inclus", html: "Additionnez les avantages inclus que vous obtiendriez gratuitement, données Level I CME/EUREX, TradingView, Market Replay, Order Flow+, et soustrayez tout ce que vous payez actuellement et que le plan remplacerait." },
        { title: "Faire le calcul sur votre propre volume", html: "Estimez un mois réaliste de votre volume et comparez les deux chiffres. Si le nouveau plan l'emporte sur <em>vos</em> contrats, adhérez. Si votre ancien tarif l'emporte, restez où vous êtes." },
      ],
    },
    { type: "paragraph", html: "Lorsque vous cliquez finalement sur <em>Upgrade</em>, lisez l'écran de confirmation au lieu de cliquer dessus sans y prêter attention. Tradovate affiche généralement une étape de confirmation avant que le changement ne prenne effet, cette boîte de dialogue est votre dernière chance de faire marche arrière, traitez-la donc comme un panneau stop, pas comme une simple formalité." },
    { type: "heading", text: "Si vous avez déjà changé, faites au mieux avec le compte que vous avez maintenant" },
    { type: "paragraph", html: "L'ancien tarif a disparu, la démarche la plus productive consiste donc à optimiser le plan sur lequel vous avez atterri plutôt que de courir après un retour en arrière qui ne viendra pas." },
    {
      type: "steps",
      items: [
        { title: "Confirmer sur quel plan vous êtes réellement", html: "Retournez dans Settings &gt; Plans et vérifiez votre palier et vos commissions actuels afin de travailler sur des faits, pas sur des souvenirs." },
        { title: "Choisir le nouveau plan le mieux adapté", html: "Si votre volume est suffisant, la commission par côté plus basse du plan Monthly ou Lifetime peut être plus avantageuse que le palier Free obtenu en annulant. Refaites ce calcul de la même manière que précédemment." },
        { title: "Utiliser les avantages que vous payez désormais", html: "Vous disposez de données Level I gratuites et des outils de la plateforme, intégrez-les à votre flux de travail pour tirer réellement profit du changement." },
        { title: "Contacter le support si vous voulez une trace écrite", html: "Contactez le support si vous voulez que cela figure noir sur blanc, mais attendez-vous à un refus. La politique en vigueur est qu'on ne peut pas revenir en arrière ; demander ne coûte rien, mais ne bâtissez pas votre stratégie sur un éventuel retour." },
      ],
    },
    { type: "heading", text: "S'il s'agit d'un compte de prop firm ou d'évaluation" },
    { type: "paragraph", html: "Aucune des mécaniques de plans grand public décrites plus haut ne s'applique ici. Les comptes d'évaluation et financés fonctionnent avec des prix, des commissions et des droits de données fixés par la prop firm, et les montants varient selon la firme et la taille du compte. Si une ligne de prix ou de commission sur un compte financé vous semble incorrecte, c'est une conversation à avoir avec votre prop firm, vérifiez ses règles actuelles plutôt que de chercher un interrupteur de plan dans Tradovate." },
    { type: "heading", text: "Tableau de dépannage" },
    {
      type: "table",
      headers: ["Situation", "Ce qui se passe", "Que faire"],
      rows: [
        ["A adhéré, souhaite maintenant retrouver l'ancien tarif", "L'ancienne tarification est retirée dès l'adhésion, par conception", "Optimiser le nouveau plan actuel ; aucun retour en arrière possible"],
        ["A résilié Monthly, s'attendait à l'ancien tarif", "Annuler mène au plan Free actuel, pas à l'ancien tarif", "Choisir plutôt le nouveau plan le mieux adapté à son volume"],
        ["Commissions plus élevées après le changement", "Les nouveaux plans Free/Monthly ont un tarif micro légèrement plus élevé", "Le comparer aux données et outils gratuits désormais obtenus"],
        ["Ne sait pas s'il est sur l'ancienne tarification", "Les comptes anciens sont restés sur l'ancien tarif jusqu'à leur adhésion", "Vérifier Settings &gt; Plans avant de toucher à quoi que ce soit"],
        ["La tarification semble incorrecte sur un compte financé", "Les comptes prop/eval utilisent une tarification fixée par la firme, pas des plans grand public", "Contacter sa prop firm ; les règles varient selon la firme et la taille du compte"],
        ["Décider s'il faut changer de plan", "La valeur dépend de votre propre combinaison de contrats", "Comparer les tarifs par côté des contrats que vous tradez réellement"],
      ],
    },
    { type: "heading", text: "Tradez avec la même configuration, quel que soit le plan sur lequel vous atterrissez" },
    { type: "paragraph", html: "Votre Account Plan modifie vos commissions et avantages, mais il n'a pas à changer la façon dont votre stratégie est exécutée. PickMyTrade relie vos alertes TradingView directement à votre compte Tradovate, de sorte que le plan choisi soit une décision tarifaire, pas une rupture dans votre flux de travail :" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Une automatisation qui survit au changement</strong>, vos alertes continuent de déclencher de vrais ordres, que vous soyez sur l'ancienne tarification, un nouveau plan Free ou Monthly, un changement de plan ne perturbe donc jamais votre routage.",
        "<strong class='text-white'>Une exécution cohérente</strong>, la même configuration fonctionne de la même manière, ce qui permet de comparer facilement les coûts réels de commissions entre plans sur un flux de trading identique.",
        "<strong class='text-white'>Synchronisation multi-comptes</strong>, dupliquez une même stratégie sur plusieurs comptes Tradovate, même s'ils sont sur des plans différents.",
        "<strong class='text-white'>Des relevés de trading nets</strong>, chaque exécution automatisée est enregistrée, ce qui vous permet de mesurer réellement si le plan choisi est rentable.",
      ],
    },
    { type: "paragraph", html: "Choisir le bon plan reste votre responsabilité, mais l'automatisation signifie que, quel que soit le côté de cette porte sans retour où vous atterrissez, votre exécution continue de fonctionner exactement de la même manière." },
  ], it: [
    { type: "paragraph", html: "Ecco la parte che coglie di sorpresa molti trader: cambiare il proprio Account Plan su Tradovate è una porta a senso unico. La documentazione ufficiale di Tradovate lo dichiara chiaramente: <strong class='text-white'>una volta aderito a un nuovo Account Plan, non è possibile tornare alla vecchia struttura tariffaria.</strong> Non esiste un pulsante per annullare, nessun interruttore nelle impostazioni e nessun link per &ldquo;tornare a come era prima&rdquo;. Se ha cliccato su <em>Upgrade</em> per ottenere i dati di mercato gratuiti o l'accesso a TradingView, e poi ha scoperto che le sue commissioni legacy erano più convenienti per il suo modo di fare trading, quella decisione è già stata presa. Questa guida spiega esattamente cosa è successo, perché la porta si apre solo in un senso e, soprattutto, come controllare i numeri <em>prima</em> di cambiare piano, così da non ritrovarsi mai dalla parte sbagliata di quella porta." },
    { type: "quote", html: "I prezzi dei piani e le commissioni cambiano nel tempo. I dati riportati in questa guida sono stati verificati sulla documentazione ufficiale di Tradovate su piani e prezzi al momento della stesura, ma Tradovate può modificare la propria struttura in qualsiasi momento. Verifichi sempre le commissioni e le condizioni attuali del piano nella pagina Settings &gt; Plans del suo account prima di aderire." },
    {
      type: "checklist",
      heading: "Checklist rapida prima di modificare il piano",
      items: [
        "<strong class='text-white'>Consideri il passaggio definitivo.</strong> Aderire a un nuovo Account Plan sostituisce in modo permanente la sua vecchia tariffa. Decida come se non ci fosse modo di tornare indietro, perché non c'è.",
        "<strong class='text-white'>Conosca le sue commissioni reali.</strong> Verifichi la tariffa per lato per i contratti esatti che negozia, standard contro micro, sia sul prezzo attuale sia sul nuovo piano.",
        "<strong class='text-white'>Valuti onestamente i vantaggi inclusi.</strong> I nuovi piani aggiungono dati Level I di CME Group ed EUREX gratuiti, oltre a TradingView, Market Replay e Order Flow+. Se prima pagava i dati separatamente, questo compensa una commissione più alta.",
        "<strong class='text-white'>Annullare non significa tornare indietro.</strong> Disdire un piano Monthly la porta sul piano Free attuale, non sulle sue vecchie tariffe.",
        "<strong class='text-white'>I conti prop sono diversi.</strong> I conti di valutazione e finanziati funzionano con prezzi stabiliti dalla prop firm, questa logica dei piani retail non si applica. Verifichi le regole della sua firm.",
        "<strong class='text-white'>Faccia uno screenshot prima di cliccare.</strong> Catturi la schermata del suo piano e delle commissioni attuali per avere una prova di ciò che aveva.",
      ],
    },
    { type: "heading", text: "Cosa significa davvero &ldquo;non è possibile tornare al vecchio prezzo&rdquo;" },
    { type: "paragraph", html: "Tradovate ha rivisto profondamente il sistema tariffario dei propri Account Plan nel 2025. Il meccanismo fondamentale è questo: gli account aperti prima del cambiamento hanno mantenuto la loro <strong class='text-white'>vecchia struttura tariffaria</strong> e vi sono rimasti finché il titolare non ha scelto di aderire a uno dei nuovi piani. Nessuno è stato migrato forzatamente. Le sue vecchie tariffe hanno continuato a funzionare silenziosamente, come sempre, fino al momento in cui ha premuto <em>Upgrade</em>." },
    { type: "paragraph", html: "Quell'adesione è il punto di non ritorno. Quando seleziona un nuovo Account Plan, Tradovate sposta il suo account sulla nuova struttura tariffaria e le vecchie tariffe vengono ritirate per quell'account. La documentazione afferma chiaramente che dopo non è possibile tornare alla vecchia struttura. Non si tratta quindi di un bug, di un errore o di una svista del supporto, ma di una scelta di progettazione intenzionale. Il &ldquo;problema&rdquo; in cui incappano quasi sempre i trader è lo stesso: hanno aderito per un vantaggio senza rendersi conto di rinunciare in modo permanente a una vecchia tariffa a cui tenevano di più." },
    { type: "paragraph", html: "Cosa guadagna aderendo? I nuovi piani includono vantaggi che la vecchia struttura non offriva gratuitamente: <strong class='text-white'>dati di mercato Level I di CME Group ed EUREX senza costi aggiuntivi</strong>, oltre all'accesso a TradingView, Market Replay e al set di strumenti Order Flow+. Il rovescio della medaglia riguarda le commissioni: i nuovi piani Free e Monthly applicano una <em>commissione leggermente più alta sui contratti micro</em> rispetto ad alcune tariffe legacy. Per uno scalper che negozia molti micro, questo piccolo incremento per lato può superare il valore dei dati gratuiti. Per chi negozia contratti standard o si affida molto a TradingView, il nuovo piano è spesso la scelta migliore. Tutta la decisione dipende da quale lato di questo calcolo si trova." },
    { type: "heading", text: "Perché i trader si scottano con il cambio di piano" },
    { type: "heading", text: "1. Inseguire i dati gratuiti senza leggere le commissioni" },
    { type: "paragraph", html: "I dati di mercato Level I gratuiti sono un vantaggio davvero interessante, e sono di gran lunga il motivo più comune per cui i trader cliccano su <em>Upgrade</em>. L'errore sta nel considerarli un semplice regalo. Se il suo vecchio piano aveva una commissione sui micro più bassa e negozia molti micro, i &ldquo;dati gratuiti&rdquo; possono silenziosamente costarle più in commissioni di quanto quei dati valessero, e ormai non può più tornare indietro." },
    { type: "heading", text: "2. Pensare di poter tornare indietro annullando" },
    { type: "paragraph", html: "Molti trader pensano che, se il nuovo piano Monthly non dovesse andare bene, basterà annullarlo per tornare al punto di partenza. Non è così. Annullare un Account Plan Monthly la porta sul <strong class='text-white'>piano Free attuale con commissioni a tariffa piena</strong>, ossia il livello Free della nuova struttura, non sulla sua vecchia tariffa. L'annullamento è uno spostamento laterale all'interno del nuovo sistema, mai un ritorno a quello vecchio." },
    { type: "heading", text: "3. Non sapere nemmeno di essere sulla vecchia tariffa" },
    { type: "paragraph", html: "Se il suo account è precedente al cambio tariffario, potrebbe non aver mai pensato a sé stesso come qualcuno &ldquo;con la vecchia tariffa&rdquo;. Era semplicemente il suo prezzo. Questo rende facile procedere nel flusso di upgrade senza rendersi conto che sta scambiando una tariffa nota e tutelata con una nuova. Il valore a cui rinuncia è invisibile finché non è sparito." },
    { type: "heading", text: "4. Confondere il cambio di piano con un cambio di costo" },
    { type: "paragraph", html: "Aderire al nuovo piano Lifetime non comporta variazioni delle commissioni né costi ricorrenti aggiuntivi oltre al pagamento una tantum, quindi sembra a basso rischio. Ma &ldquo;nessun costo aggiuntivo&rdquo; non equivale a &ldquo;reversibile&rdquo;. Anche un piano che sembra un semplice upgrade cancella comunque le sue vecchie tariffe nel momento in cui vi aderisce." },
    { type: "heading", text: "5. Basarsi su una recensione o un confronto invece che sul proprio account" },
    { type: "paragraph", html: "Le tabelle tariffarie pubblicate e le recensioni sui broker descrivono i piani <em>nuovi</em>. Raramente descrivono la specifica tariffa legacy presente sul suo account, che potrebbe essere diversa. Basare la decisione su un articolo generico sui prezzi anziché sulla propria schermata Settings &gt; Plans è il modo in cui i trader finiscono per convincersi di un cambio che non si adatta al loro modo di operare." },
    { type: "heading", text: "Come gestirlo: passo dopo passo" },
    { type: "heading", text: "Se non ha ancora cambiato piano, confronti prima di impegnarsi" },
    { type: "paragraph", html: "È tutto qui il punto. Il problema dell'irreversibilità è un problema solo se aderisce alla cieca, quindi rallenti e faccia prima i conti." },
    {
      type: "steps",
      items: [
        { title: "Aprire Settings > Plans", html: "Apra il suo Account Dashboard e vada su <strong class='text-white'>Settings &gt; Plans</strong> (verifichi l'etichetta esatta del menu nella sua versione attuale)." },
        { title: "Annotare le commissioni attuali", html: "Annoti la sua commissione attuale per lato per i contratti che negozia davvero, separando il numero degli standard da quello dei micro." },
        { title: "Annotare le commissioni del nuovo piano", html: "Apra il nuovo piano che sta valutando e annoti la sua commissione per lato per gli stessi contratti, oltre al costo fisso (mensile o una tantum)." },
        { title: "Sommare i vantaggi inclusi", html: "Sommi i vantaggi inclusi che otterrebbe gratuitamente, dati Level I di CME/EUREX, TradingView, Market Replay, Order Flow+, e sottragga tutto ciò che paga attualmente e che il piano andrebbe a sostituire." },
        { title: "Fare i conti sul proprio volume", html: "Stimi un mese realistico del suo volume ed elabori entrambe le cifre. Se il nuovo piano vince sui suoi contratti, aderisca. Se vince la sua vecchia tariffa, resti dov'è." },
      ],
    },
    { type: "paragraph", html: "Quando finalmente clicca su <em>Upgrade</em>, legga la schermata di conferma invece di chiuderla senza pensarci. Tradovate in genere mostra un passaggio di conferma prima che il cambio diventi effettivo, quella finestra è la sua ultima occasione per tirarsi indietro, quindi la tratti come un segnale di stop, non come una formalità." },
    { type: "heading", text: "Se ha già cambiato piano, lavori con l'account che ha ora" },
    { type: "paragraph", html: "La vecchia tariffa non c'è più, quindi la mossa più produttiva è ottimizzare il piano su cui è finito invece di rincorrere un ripristino che non arriverà." },
    {
      type: "steps",
      items: [
        { title: "Confermare su quale piano si trova davvero", html: "Torni su Settings &gt; Plans e verifichi il suo livello e le sue commissioni attuali, così da lavorare sui fatti e non sui ricordi." },
        { title: "Scegliere il nuovo piano più adatto", html: "Se il suo volume è sufficiente, la commissione per lato più bassa del piano Monthly o Lifetime potrebbe battere il livello Free che otterrebbe annullando. Faccia lo stesso calcolo di prima." },
        { title: "Sfruttare i vantaggi che ora sta pagando", html: "Ha dati Level I gratuiti e gli strumenti della piattaforma, li integri nel suo flusso di lavoro per ottenere davvero valore dal cambio." },
        { title: "Contattare il supporto se vuole una traccia scritta", html: "Contatti il supporto se vuole metterlo per iscritto, ma si aspetti un no. La politica prevede che non si possa tornare indietro; chiedere non costa nulla, ma non basi la sua pianificazione su un possibile ripristino." },
      ],
    },
    { type: "heading", text: "Se si tratta di un account di una prop firm o di valutazione" },
    { type: "paragraph", html: "Nessuna delle logiche dei piani retail descritte sopra si applica qui. I conti di valutazione e finanziati funzionano con prezzi, commissioni e diritti sui dati stabiliti dalla prop firm, e gli importi variano in base alla firm e alla dimensione dell'account. Se una voce di prezzo o commissione su un account finanziato le sembra errata, è una conversazione da avere con la sua prop firm, verifichi le loro regole attuali invece di cercare un interruttore di piano all'interno di Tradovate." },
    { type: "heading", text: "Tabella di risoluzione dei problemi" },
    {
      type: "table",
      headers: ["Situazione", "Cosa sta succedendo", "Cosa fare"],
      rows: [
        ["Ha aderito, ora vuole tornare alla vecchia tariffa", "La vecchia tariffa viene ritirata nel momento dell'adesione, per progettazione", "Ottimizzare il nuovo piano attuale; non è disponibile alcun ripristino"],
        ["Ha annullato Monthly, si aspettava la vecchia tariffa", "Annullare porta al piano Free attuale, non alla vecchia tariffa", "Scegliere invece il nuovo piano più adatto al proprio volume"],
        ["Commissioni più alte dopo il cambio", "I nuovi piani Free/Monthly hanno una tariffa sui micro leggermente più alta", "Confrontarla con i dati e gli strumenti gratuiti ora ottenuti"],
        ["Non è sicuro di avere la vecchia tariffa", "Gli account più vecchi sono rimasti sulla vecchia tariffa fino all'adesione", "Controllare Settings &gt; Plans prima di modificare qualsiasi cosa"],
        ["Il prezzo sembra errato su un account finanziato", "I conti prop/eval usano prezzi stabiliti dalla firm, non piani retail", "Contattare la propria prop firm; le regole variano per firm e dimensione dell'account"],
        ["Decidere se cambiare piano o meno", "Il valore dipende dal proprio mix di contratti", "Confrontare le tariffe per lato dei contratti effettivamente negoziati"],
      ],
    },
    { type: "heading", text: "Operi con la stessa configurazione qualunque sia il piano su cui finisce" },
    { type: "paragraph", html: "Il suo Account Plan modifica le commissioni e i vantaggi, ma non deve necessariamente cambiare il modo in cui la sua strategia viene eseguita. PickMyTrade collega i suoi alert di TradingView direttamente al suo account Tradovate, così il piano che sceglie è una decisione di prezzo, non un'interruzione del flusso di lavoro:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Automazione che sopravvive al cambio</strong>, i suoi alert continuano a inviare ordini reali, sia che si trovi sulla vecchia tariffa, su un nuovo piano Free o su Monthly, quindi un cambio di piano non interrompe mai il suo routing.",
        "<strong class='text-white'>Esecuzione coerente</strong>, la stessa configurazione funziona allo stesso modo, il che rende facile confrontare i costi di commissione reali tra i piani su un flusso di trading identico.",
        "<strong class='text-white'>Sincronizzazione multi-account</strong>, replichi un'unica strategia su più account Tradovate anche quando si trovano su piani diversi.",
        "<strong class='text-white'>Registri di trading puliti</strong>, ogni esecuzione automatizzata viene registrata, così può misurare realmente se il piano scelto sta ripagando.",
      ],
    },
    { type: "paragraph", html: "Scegliere il piano giusto resta comunque una sua responsabilità, ma l'automazione significa che, indipendentemente dal lato di questa porta a senso unico su cui finisce, la sua esecuzione continua a funzionare esattamente allo stesso modo." },
  ] },
  ctaHeading: { en: "Keep Your Execution Consistent Across Plans", de: "Halten Sie Ihre Ausführung über alle Pläne hinweg konsistent", es: "Mantenga su ejecución consistente en todos los planes", fr: "Gardez une exécution cohérente quel que soit le plan", it: "Mantenga la sua esecuzione coerente su tutti i piani" },
  ctaText: { en: "Automate your Tradovate orders and keep your strategy running the same way on legacy pricing, Free, Monthly, or Lifetime.", de: "Automatisieren Sie Ihre Tradovate-Orders und lassen Sie Ihre Strategie auf die gleiche Weise laufen, egal ob auf der alten Preisstruktur, Free, Monthly oder Lifetime.", es: "Automatice sus órdenes de Tradovate y mantenga su estrategia funcionando de la misma manera con el precio antiguo, Free, Monthly o Lifetime.", fr: "Automatisez vos ordres Tradovate et faites fonctionner votre stratégie de la même manière, que vous soyez sur l'ancienne tarification, Free, Monthly ou Lifetime.", it: "Automatizzi i suoi ordini Tradovate e mantenga la sua strategia in funzione allo stesso modo con la vecchia tariffa, Free, Monthly o Lifetime." },
  ctaButtonText: { en: "Start Your Free 7-Day Trial", de: "Starten Sie Ihre kostenlose 5-Tage-Testversion", es: "Comience su prueba gratuita de 5 días", fr: "Démarrez votre essai gratuit de 5 jours", it: "Inizi la sua prova gratuita di 5 giorni" },
  ctaUrl: "https://app.pickmytrade.trade/?register=true&utm_source=content&utm_medium=debugging",
  faqHeading: { en: "Frequently Asked Questions", de: "Häufig gestellte Fragen", es: "Preguntas frecuentes", fr: "Questions fréquentes", it: "Domande frequenti" },
  faqs: { en: [
    { q: "Can I switch back to my old Tradovate pricing after upgrading?", a: "No. Tradovate's documentation is clear that once you opt in to one of the new Account Plans, you cannot revert to the old pricing structure. There's no button, toggle, or setting that puts a legacy account back on its former rates. Treat the upgrade as a one-way door." },
    { q: "What changed with Tradovate's plan pricing in 2025?", a: "Tradovate rolled out a new Account Plan pricing structure around mid-2025. Accounts opened before that cutoff stayed on their older, legacy pricing until the account holder manually opted in to a new plan. Opting in unlocks new benefits but replaces the legacy rates permanently." },
    { q: "What do the new Account Plans include?", a: "The new plans bundle perks the old structure didn't, including free Level I CME Group and EUREX market data, plus access to TradingView, Market Replay, and the Order Flow+ tools. The tradeoff is a slightly higher micro commission on the Free and Monthly plans versus some legacy rates." },
    { q: "If I cancel my Monthly plan, do I go back to my legacy pricing?", a: "No. Cancelling a Monthly plan drops you onto the current Free plan with full-priced commissions, not your old legacy pricing. Cancelling is not a route back to the legacy structure, once you've opted in to the new plans, the old rates are gone." },
    { q: "Are the new plans more expensive than legacy pricing?", a: "It depends on what you trade. The new Free and Monthly plans carry a slightly higher micro commission than some legacy rates, but they add free Level I data and platform tools that legacy accounts paid for or lacked. Compare the exact per-side commission for the contracts you actually trade before deciding." },
    { q: "Does this affect prop-firm or evaluation accounts?", a: "No. Prop-firm and evaluation accounts run on pricing and commissions set by the firm, not by Tradovate's retail Account Plans. If you trade a funded or evaluation account, plan and fee questions go to your prop firm, whose rules vary by firm and account size." },
    { q: "Can Tradovate support restore my legacy pricing as a one-off?", a: "Generally no. The published policy is that you can't revert to the old pricing structure after opting in. You can always ask support, but go in expecting the answer to be no and plan around the new plan you're now on rather than counting on a reversal." },
  ], de: [
    { q: "Kann ich nach dem Upgrade zu meiner alten Tradovate-Preisstruktur zurückkehren?", a: "Nein. Tradovates Dokumentation stellt klar, dass Sie nach dem Wechsel zu einem der neuen Account Plans nicht zur alten Preisstruktur zurückkehren können. Es gibt keinen Button, Schalter oder Einstellung, die ein Konto auf seine früheren Sätze zurücksetzt. Behandeln Sie das Upgrade als Einbahnstraße." },
    { q: "Was hat sich 2025 bei Tradovates Plan-Preisen geändert?", a: "Tradovate hat Mitte 2025 eine neue Preisstruktur für Account Plans eingeführt. Konten, die vor diesem Stichtag eröffnet wurden, blieben auf ihrer älteren, alten Preisstruktur, bis der Kontoinhaber manuell zu einem neuen Plan wechselte. Der Wechsel schaltet neue Vorteile frei, ersetzt aber die alten Preise dauerhaft." },
    { q: "Was beinhalten die neuen Account Plans?", a: "Die neuen Pläne bündeln Vorteile, die die alte Struktur nicht bot, darunter kostenlose Level-I-Marktdaten von CME Group und EUREX sowie Zugang zu TradingView, Market Replay und den Order-Flow+-Tools. Der Kompromiss ist eine etwas höhere Micro-Kommission bei den Free- und Monthly-Plänen im Vergleich zu manchen alten Sätzen." },
    { q: "Wenn ich meinen Monthly-Plan kündige, komme ich dann zu meiner alten Preisstruktur zurück?", a: "Nein. Wenn Sie einen Monthly-Plan kündigen, landen Sie auf dem aktuellen Free-Plan mit vollen Kommissionen, nicht auf Ihrer alten Preisstruktur. Kündigen ist kein Weg zurück zur alten Struktur, sobald Sie zu den neuen Plänen gewechselt sind, sind die alten Sätze weg." },
    { q: "Sind die neuen Pläne teurer als die alte Preisstruktur?", a: "Das hängt davon ab, was Sie handeln. Die neuen Free- und Monthly-Pläne haben eine etwas höhere Micro-Kommission als manche alten Sätze, bringen aber kostenlose Level-I-Daten und Plattform-Tools mit, für die alte Konten bezahlt haben oder die ihnen fehlten. Vergleichen Sie die genaue Kommission pro Seite für die Kontrakte, die Sie tatsächlich handeln, bevor Sie sich entscheiden." },
    { q: "Betrifft das Prop-Firm- oder Evaluation-Konten?", a: "Nein. Prop-Firm- und Evaluation-Konten laufen mit Preisen und Kommissionen, die von der Firma festgelegt werden, nicht von Tradovates Retail Account Plans. Wenn Sie ein Funded- oder Evaluation-Konto handeln, gehen Fragen zu Plänen und Gebühren an Ihre Prop Firm, deren Regeln je nach Firma und Kontogröße variieren." },
    { q: "Kann der Tradovate-Support meine alte Preisstruktur ausnahmsweise wiederherstellen?", a: "In der Regel nicht. Die veröffentlichte Richtlinie besagt, dass Sie nach dem Wechsel nicht zur alten Preisstruktur zurückkehren können. Sie können den Support natürlich immer fragen, aber rechnen Sie mit einem Nein und planen Sie mit dem neuen Plan, auf dem Sie jetzt sind, statt auf eine Rückkehr zu hoffen." },
  ], es: [
    { q: "¿Puedo volver a mi precio antiguo de Tradovate después de actualizar?", a: "No. La documentación de Tradovate deja claro que, una vez que se une a uno de los nuevos Account Plans, no puede volver a la estructura de precios anterior. No existe ningún botón, interruptor o ajuste que devuelva a una cuenta antigua a sus tarifas anteriores. Trate la actualización como una puerta sin retorno." },
    { q: "¿Qué cambió en el precio de los planes de Tradovate en 2025?", a: "Tradovate lanzó una nueva estructura de precios de Account Plan a mediados de 2025. Las cuentas abiertas antes de esa fecha límite mantuvieron su precio anterior hasta que el titular se unió manualmente a un nuevo plan. Unirse desbloquea nuevas ventajas, pero sustituye las tarifas antiguas de forma permanente." },
    { q: "¿Qué incluyen los nuevos Account Plans?", a: "Los nuevos planes agrupan ventajas que la estructura antigua no ofrecía, incluidos datos de mercado de nivel I de CME Group y EUREX gratuitos, además de acceso a TradingView, Market Replay y las herramientas Order Flow+. La contrapartida es una comisión micro ligeramente más alta en los planes Free y Monthly frente a algunas tarifas antiguas." },
    { q: "Si cancelo mi plan Monthly, ¿vuelvo a mi precio antiguo?", a: "No. Cancelar un plan Monthly lo lleva al plan Free actual con comisiones a precio completo, no a su precio antiguo. Cancelar no es un camino de vuelta a la estructura antigua, una vez que se ha unido a los nuevos planes, las tarifas antiguas desaparecen." },
    { q: "¿Son los nuevos planes más caros que el precio antiguo?", a: "Depende de lo que opere. Los nuevos planes Free y Monthly tienen una comisión micro algo más alta que algunas tarifas antiguas, pero añaden datos de nivel I gratuitos y herramientas de la plataforma que las cuentas antiguas pagaban o no tenían. Compare la comisión exacta por lado de los contratos que realmente opera antes de decidir." },
    { q: "¿Afecta esto a las cuentas de prop firm o de evaluación?", a: "No. Las cuentas de prop firm y de evaluación funcionan con precios y comisiones fijados por la firma, no por los Account Plans minoristas de Tradovate. Si opera una cuenta financiada o de evaluación, las preguntas sobre planes y tarifas se dirigen a su prop firm, cuyas reglas varían según la firma y el tamaño de la cuenta." },
    { q: "¿Puede el soporte de Tradovate restaurar mi precio antiguo como excepción puntual?", a: "Por lo general, no. La política publicada establece que no se puede volver a la estructura de precios anterior tras unirse a un nuevo plan. Siempre puede preguntar al soporte, pero vaya con la expectativa de que la respuesta será no y planifique en torno al nuevo plan en el que se encuentra en lugar de contar con una reversión." },
  ], fr: [
    { q: "Puis-je revenir à mon ancienne tarification Tradovate après une mise à niveau ?", a: "Non. La documentation de Tradovate indique clairement qu'une fois que vous avez adhéré à l'un des nouveaux Account Plans, vous ne pouvez pas revenir à l'ancienne structure tarifaire. Il n'existe aucun bouton, interrupteur ou paramètre permettant de remettre un compte ancien sur ses anciens tarifs. Considérez la mise à niveau comme une porte sans retour." },
    { q: "Qu'est-ce qui a changé dans la tarification des plans Tradovate en 2025 ?", a: "Tradovate a déployé une nouvelle structure tarifaire pour les Account Plans vers le milieu de 2025. Les comptes ouverts avant cette date limite sont restés sur leur ancienne tarification jusqu'à ce que le titulaire adhère manuellement à un nouveau plan. Adhérer débloque de nouveaux avantages mais remplace définitivement les anciens tarifs." },
    { q: "Que comprennent les nouveaux Account Plans ?", a: "Les nouveaux plans regroupent des avantages que l'ancienne structure n'offrait pas, notamment des données de marché Level I CME Group et EUREX gratuites, ainsi que l'accès à TradingView, Market Replay et aux outils Order Flow+. La contrepartie est une commission micro légèrement plus élevée sur les plans Free et Monthly par rapport à certains anciens tarifs." },
    { q: "Si j'annule mon plan Monthly, est-ce que je retrouve mon ancienne tarification ?", a: "Non. Annuler un plan Monthly vous place sur le plan Free actuel avec des commissions au tarif plein, pas sur votre ancienne tarification. Annuler n'est pas un moyen de revenir à l'ancienne structure, une fois que vous avez adhéré aux nouveaux plans, les anciens tarifs disparaissent." },
    { q: "Les nouveaux plans sont-ils plus chers que l'ancienne tarification ?", a: "Cela dépend de ce que vous tradez. Les nouveaux plans Free et Monthly ont une commission micro légèrement plus élevée que certains anciens tarifs, mais ils ajoutent des données Level I gratuites et des outils de plateforme que les comptes anciens payaient ou n'avaient pas. Comparez la commission exacte par côté des contrats que vous tradez réellement avant de vous décider." },
    { q: "Cela affecte-t-il les comptes de prop firm ou d'évaluation ?", a: "Non. Les comptes de prop firm et d'évaluation fonctionnent avec des prix et des commissions fixés par la firme, et non par les Account Plans grand public de Tradovate. Si vous tradez un compte financé ou d'évaluation, les questions de plan et de frais relèvent de votre prop firm, dont les règles varient selon la firme et la taille du compte." },
    { q: "Le support Tradovate peut-il restaurer mon ancienne tarification à titre exceptionnel ?", a: "En général, non. La politique publiée indique qu'il est impossible de revenir à l'ancienne structure tarifaire après avoir adhéré à un nouveau plan. Vous pouvez toujours demander au support, mais attendez-vous à un refus et organisez-vous autour du nouveau plan sur lequel vous êtes désormais plutôt que de compter sur un retour en arrière." },
  ], it: [
    { q: "Posso tornare al mio vecchio prezzo Tradovate dopo l'upgrade?", a: "No. La documentazione di Tradovate chiarisce che, una volta aderito a uno dei nuovi Account Plan, non è possibile tornare alla vecchia struttura tariffaria. Non esiste alcun pulsante, interruttore o impostazione che riporti un account legacy alle sue tariffe precedenti. Consideri l'upgrade come una porta a senso unico." },
    { q: "Cosa è cambiato nei prezzi dei piani Tradovate nel 2025?", a: "Tradovate ha introdotto una nuova struttura tariffaria per gli Account Plan verso la metà del 2025. Gli account aperti prima di quella data hanno mantenuto la loro vecchia tariffa finché il titolare non ha aderito manualmente a un nuovo piano. Aderire sblocca nuovi vantaggi ma sostituisce in modo permanente le vecchie tariffe." },
    { q: "Cosa includono i nuovi Account Plan?", a: "I nuovi piani includono vantaggi che la vecchia struttura non offriva, tra cui dati di mercato Level I di CME Group ed EUREX gratuiti, oltre all'accesso a TradingView, Market Replay e agli strumenti Order Flow+. Il compromesso è una commissione sui micro leggermente più alta nei piani Free e Monthly rispetto ad alcune tariffe legacy." },
    { q: "Se annullo il mio piano Monthly, torno alla mia vecchia tariffa?", a: "No. Annullare un piano Monthly la porta sul piano Free attuale con commissioni a tariffa piena, non sulla sua vecchia tariffa. Annullare non è un modo per tornare alla vecchia struttura, una volta aderito ai nuovi piani, le vecchie tariffe scompaiono." },
    { q: "I nuovi piani sono più costosi rispetto alla vecchia tariffa?", a: "Dipende da cosa negozia. I nuovi piani Free e Monthly hanno una commissione sui micro leggermente più alta rispetto ad alcune tariffe legacy, ma aggiungono dati Level I gratuiti e strumenti della piattaforma che gli account legacy pagavano o non avevano. Confronti la commissione esatta per lato dei contratti che negozia davvero prima di decidere." },
    { q: "Questo riguarda anche i conti di prop firm o di valutazione?", a: "No. I conti di prop firm e di valutazione funzionano con prezzi e commissioni stabiliti dalla firm, non dagli Account Plan retail di Tradovate. Se negozia un conto finanziato o di valutazione, le domande su piani e commissioni vanno rivolte alla sua prop firm, le cui regole variano in base alla firm e alla dimensione del conto." },
    { q: "Il supporto Tradovate può ripristinare la mia vecchia tariffa come eccezione una tantum?", a: "In genere no. La politica pubblicata stabilisce che non è possibile tornare alla vecchia struttura tariffaria dopo l'adesione. Può sempre chiedere al supporto, ma si aspetti una risposta negativa e pianifichi in base al nuovo piano su cui si trova ora, invece di contare su un ripristino." },
  ] },
