---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "two-session-limit-devicequotareached";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/debugging/${SLUG}`;

const META_TITLE = "Tradovate 2-Session Limit & DeviceQuotaReached";
const META_DESCRIPTION =
  "Tradovate DeviceQuotaReached and the 2-session limit, fixed: log out everywhere, sign in on one device, and stop disconnects and frozen charts fast.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Tradovate: 2-Sitzungs-Limit & DeviceQuotaReached", es: "Límite de 2 sesiones de Tradovate y DeviceQuotaReached", fr: "Limite de 2 sessions Tradovate et erreur DeviceQuotaReached", it: "Limite di 2 sessioni di Tradovate e DeviceQuotaReached" },
  dek: { en: "Desktop app, phone, and a TradingView tab all connected at once trips Tradovate's DeviceQuotaReached error. Here's the two-session limit, why it fires, and how to get back to one clean connection.", de: "Desktop-App, Smartphone und ein TradingView-Tab gleichzeitig verbunden lösen bei Tradovate den Fehler DeviceQuotaReached aus. Hier erfahren Sie, was das Zwei-Sitzungs-Limit ist, warum der Fehler auftritt und wie Sie zu einer sauberen Verbindung zurückkehren.", es: "La app de escritorio, el teléfono y una pestaña de TradingView conectados a la vez activan el error DeviceQuotaReached de Tradovate. Aquí le explicamos el límite de dos sesiones, por qué aparece y cómo volver a una única conexión limpia.", fr: "L'application de bureau, le téléphone et un onglet TradingView connectés en même temps déclenchent l'erreur DeviceQuotaReached de Tradovate. Voici la limite de deux sessions, pourquoi elle se déclenche et comment revenir à une seule connexion propre.", it: "App desktop, telefono e una scheda di TradingView connessi contemporaneamente attivano l'errore DeviceQuotaReached di Tradovate. Ecco il limite delle due sessioni, perché scatta e come tornare a una sola connessione pulita." },
  readTime: { en: "7 min read", de: "7 Min. Lesezeit", es: "Lectura de 7 min", fr: "Lecture : 7 min", it: "Lettura di 7 min" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "Nothing rattles you faster than Tradovate dropping the connection and freezing the chart while you're working a live position on ES or NQ. Run the desktop app, glance at the mobile app, and keep a TradingView tab open all at once, and sooner or later you'll trip the platform's <strong class='text-white'>DeviceQuotaReached</strong> error. That message is Tradovate telling you the account's session (device) quota has been exceeded, so it starts kicking connections offline." },
    { type: "paragraph", html: "The same root problem wears different masks: repeated 24-hour logouts, a &ldquo;connection closed&rdquo; banner, a chart that quietly stops updating, or getting booted out of a trade &ldquo;for no reason.&rdquo; The cause is almost always the same one, too many simultaneous logins on a single account. Here's exactly what Tradovate's two-session limit is, why DeviceQuotaReached fires, and how to get back to one clean, stable connection, the same discipline an automation bridge like PickMyTrade uses so your strategy never double-logs your account." },
    {
      type: "checklist",
      heading: "Quick Checklist for DeviceQuotaReached & Session Limits",
      items: [
        "<strong class='text-white'>Signed in on more than one device?</strong> Log out of Tradovate everywhere except the one device you're actively trading from.",
        "<strong class='text-white'>Multiple TradingView tabs open?</strong> Close all but one. In TradingView, each browser tab counts as its own session.",
        "<strong class='text-white'>Desktop, web, and mobile all connected?</strong> Pick a single surface and sign out of the rest.",
        "<strong class='text-white'>Just saw DeviceQuotaReached?</strong> Fully log out of every session, wait a moment, then sign back in on one device only.",
        "<strong class='text-white'>Chart frozen or prices static?</strong> Sync your computer's clock and check your connection before you blame the platform.",
        "<strong class='text-white'>Reconnecting over and over?</strong> Stop. Rapid re-logins burn your API quota and can trigger a separate &ldquo;Too Many Requests&rdquo; lockout.",
      ],
    },
    { type: "heading", text: "What \"DeviceQuotaReached\" Means" },
    { type: "paragraph", html: "Tradovate limits each account to a small number of concurrent sessions, commonly described as two active sessions across all of its surfaces: the desktop app, the web trader, the mobile app, and any TradingView or third-party connection. Under the hood the limit is even tighter for live data. Tradovate permits only a single established market-data connection per user account, so opening a new session terminates the previous one. Log into Tradovate Trader and it ends your API or WebSocket session, and vice versa." },
    { type: "paragraph", html: "When your simultaneous logins push past what the account allows, Tradovate refuses the surplus connection and returns <strong class='text-white'>DeviceQuotaReached</strong>, literally, the device quota for this account has been reached. The server drops the extra connection with an abnormal close, which is why your chart freezes, your DOM stops printing, or you get bounced out of a position with no obvious explanation. It isn't a flaw in your strategy, and it isn't always a Tradovate outage. Most of the time it's the account defending its session cap against you being logged in three or four places at once." },
    { type: "paragraph", html: "TradingView makes this easy to trigger without realizing it. Every open TradingView tab connected to your broker holds its own session, so two tabs plus the desktop app is already more than the account wants to allow. Add the mobile app checking in and you're comfortably over the line." },
    { type: "heading", text: "Top Causes of DeviceQuotaReached in 2026" },
    { type: "heading", text: "1. Logged in on multiple devices at once" },
    { type: "paragraph", html: "The classic trigger: the desktop app on your trading PC, the web trader on a laptop, and the mobile app on your phone, all connected to the same account. Each one is a live session, and together they blow past the cap." },
    { type: "heading", text: "2. Several TradingView tabs open at the same time" },
    { type: "paragraph", html: "In TradingView, each browser tab linked to Tradovate counts as a separate session. Two or three chart tabs open &ldquo;just to watch&rdquo; quietly consume your entire session budget before you place a single order." },
    { type: "heading", text: "3. Desktop, web, and TradingView all connected simultaneously" },
    { type: "paragraph", html: "Mixing surfaces is the most common real-world version of this problem. You route orders from the Tradovate desktop app while a TradingView tab is still connected for charting. Both hold sessions, and the market-data connection can only belong to one of them at a time." },
    { type: "heading", text: "4. Rapid reconnect loops after a drop" },
    { type: "paragraph", html: "When a session gets bounced, hammering the login button to get back in makes it worse. Frequent reconnections and repeated login attempts eat into Tradovate's hourly API request allowance and can escalate into a separate &ldquo;Too Many Requests&rdquo; (HTTP 429) cooldown on top of the session conflict." },
    { type: "heading", text: "5. A stale session that never closed" },
    { type: "paragraph", html: "A browser crash, a laptop going to sleep and waking, or the platform's routine ~24-hour logout can leave a &ldquo;ghost&rdquo; session registered against your account. You think you're logged in once, but the server still counts an old connection, so a fresh login tips you over the quota." },
    { type: "heading", text: "How to Fix DeviceQuotaReached: Step by Step" },
    { type: "heading", text: "Fixing Causes 1 & 2: Log Out of Every Session First" },
    {
      type: "steps",
      items: [
        { title: "Leave your primary device connected", html: "On your primary trading device, leave Tradovate open. This is the one session you'll keep." },
        { title: "Log out fully on every other device", html: "On every other device (laptop, second desktop, phone), open Tradovate and log out fully rather than just closing the window. Closing a tab doesn't always end the session cleanly." },
        { title: "Close extra TradingView tabs", html: "In your browser, close all but one TradingView tab connected to Tradovate. Extra tabs each hold a session even when you're not looking at them." },
        { title: "Confirm you're down to one session", html: "Give it a few seconds so the server registers the dropped connections, then confirm you're down to a single active session." },
      ],
    },
    { type: "heading", text: "Fixing Cause 3: Reconnect TradingView on a Single Tab" },
    {
      type: "steps",
      items: [
        { title: "Check the broker connection", html: "In your one remaining TradingView tab, open the broker Trading Panel and check whether it still shows a live Tradovate connection." },
        { title: "Disconnect and reconnect once", html: "If it's stuck or showing an error, disconnect the Tradovate broker connection, then reconnect it once from that single tab." },
        { title: "Pick one order surface", html: "Don't route the same account from both the Tradovate desktop app and a TradingView tab at once. Decide which one is your order surface for the session and keep the other for charting only." },
      ],
    },
    { type: "heading", text: "Fixing Causes 4 & 5: Sync Your Clock, Wait Out Reconnects, Sign In Once" },
    {
      type: "steps",
      items: [
        { title: "Stop the reconnect spam", html: "If you just tripped DeviceQuotaReached or a 429, wait instead of retrying in a loop. Rapid attempts extend the lockout instead of clearing it." },
        { title: "Sync your system clock", html: "On Windows, open date and time settings, turn on <strong class='text-white'>Set time automatically</strong>, and click <strong class='text-white'>Sync now</strong>. A clock even slightly out of sync causes frozen charts and failed connections that look exactly like session errors." },
        { title: "Clear stale sessions", html: "If you suspect a ghost session after a crash or sleep/wake, fully close the browser or restart the desktop app so no orphaned connection stays registered." },
        { title: "Sign back in on one device only", html: "With everything else logged out, log in fresh on your single chosen surface. You should reconnect cleanly and stay connected." },
        { title: "Contact support if it persists", html: "If DeviceQuotaReached persists even though you're genuinely on one device, contact Tradovate support and ask them to clear any lingering sessions on the account." },
      ],
    },
    { type: "heading", text: "Troubleshooting Table" },
    {
      type: "table",
      headers: ["Error / Symptom", "What it means", "Fix"],
      rows: [
        ["DeviceQuotaReached", "The account's concurrent-session (device) quota was exceeded", "Log out of every device and extra TradingView tab, then sign in on one device only"],
        ["Logged out roughly every 24 hours", "Tradovate's routine session refresh, worsened by having extra sessions open", "Keep to a single session; simply log back in on that one device"],
        ["\"Too Many Requests\" / HTTP 429 after reconnecting", "Rapid re-logins consumed your hourly API request allowance", "Stop retrying, wait out the cooldown, then log in once"],
        ["Chart frozen or prices static", "Session conflict, clock out of sync, weak connection, or an expired contract month", "Sync the clock, use a stable connection, confirm the front-month contract, and drop to one session"],
        ["Bounced out of a trade \"for no reason\" from TradingView", "A second session took the single market-data connection away from the first", "Consolidate to one connected surface for that account"],
        ["Still disconnecting on a single device", "A stale \"ghost\" session may still be registered on the account", "Restart the app/browser; if it persists, ask Tradovate support to clear old sessions"],
      ],
    },
    { type: "heading", text: "Prevent This with PickMyTrade" },
    { type: "paragraph", html: "DeviceQuotaReached happens because a human ends up logged in from several places at once. Automating your execution removes most of that surface area. Your strategy fires from one disciplined connection instead of you juggling the desktop app, a phone, and three TradingView tabs:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Single, disciplined connection</strong>, PickMyTrade routes your TradingView alerts to Tradovate through one managed link, so you're not stacking manual sessions that trip the device quota.",
        "<strong class='text-white'>Rate-limit-safe routing</strong>, order flow is spaced out to stay within Tradovate's request limits, avoiding the retry storms that escalate into 429 &ldquo;Too Many Requests&rdquo; lockouts.",
        "<strong class='text-white'>Entitlement &amp; risk awareness</strong>, routing respects your account's limits and data-agreement state, so orders leave clean instead of bouncing.",
        "<strong class='text-white'>Multi-account sync</strong>, mirror one strategy across several accounts from a single bridge rather than opening a separate live login for each.",
      ],
    },
    { type: "paragraph", html: "Automation doesn't raise Tradovate's session cap, but it means you rarely need more than one connection open, which is exactly what keeps DeviceQuotaReached from firing in the first place." },
  ], de: [
    { type: "paragraph",html: "Nichts bringt Sie schneller aus der Ruhe, als wenn Tradovate die Verbindung trennt und der Chart einfriert, während Sie eine Live-Position in ES oder NQ managen. Wenn Sie die Desktop-App laufen lassen, kurz auf die mobile App schauen und gleichzeitig einen TradingView-Tab offen halten, lösen Sie früher oder später den Fehler <strong class='text-white'>DeviceQuotaReached</strong> der Plattform aus. Diese Meldung sagt Ihnen, dass das Sitzungs- (Geräte-)Kontingent des Kontos überschritten wurde und Tradovate deshalb Verbindungen trennt." },
    { type: "paragraph",html: "Dasselbe Grundproblem tritt in verschiedenen Formen auf: wiederholte Abmeldungen nach 24 Stunden, ein Banner &ldquo;Verbindung geschlossen&rdquo;, ein Chart, der stillschweigend nicht mehr aktualisiert, oder ein Rauswurf aus einem Trade &ldquo;ohne Grund&rdquo;. Die Ursache ist fast immer dieselbe: zu viele gleichzeitige Anmeldungen bei einem einzigen Konto. Hier erfahren Sie genau, was Tradovates Zwei-Sitzungs-Limit ist, warum DeviceQuotaReached auftritt und wie Sie zu einer sauberen, stabilen Verbindung zurückfinden, nach derselben Disziplin, mit der eine Automatisierungsbrücke wie PickMyTrade dafür sorgt, dass Ihre Strategie Ihr Konto nie doppelt anmeldet." },
    {
      type: "checklist",
      heading: "Kurz-Checkliste für DeviceQuotaReached & Sitzungslimits",
      items: [
        "<strong class='text-white'>Auf mehr als einem Gerät angemeldet?</strong> Melden Sie sich bei Tradovate überall ab, außer auf dem einen Gerät, mit dem Sie aktiv handeln.",
        "<strong class='text-white'>Mehrere TradingView-Tabs geöffnet?</strong> Schließen Sie alle bis auf einen. In TradingView zählt jeder Browser-Tab als eigene Sitzung.",
        "<strong class='text-white'>Desktop, Web und Mobil gleichzeitig verbunden?</strong> Wählen Sie eine einzige Oberfläche und melden Sie sich bei den übrigen ab.",
        "<strong class='text-white'>DeviceQuotaReached gerade gesehen?</strong> Melden Sie sich in allen Sitzungen vollständig ab, warten Sie einen Moment und melden Sie sich dann nur auf einem Gerät wieder an.",
        "<strong class='text-white'>Chart eingefroren oder Kurse statisch?</strong> Synchronisieren Sie die Uhr Ihres Computers und prüfen Sie Ihre Verbindung, bevor Sie der Plattform die Schuld geben.",
        "<strong class='text-white'>Verbinden Sie sich immer wieder neu?</strong> Hören Sie auf. Schnelle Neuanmeldungen verbrauchen Ihr API-Kontingent und können eine separate Sperre wegen &ldquo;Too Many Requests&rdquo; auslösen.",
      ],
    },
    { type: "heading",text: "Was „DeviceQuotaReached“ bedeutet" },
    { type: "paragraph",html: "Tradovate begrenzt jedes Konto auf eine geringe Anzahl gleichzeitiger Sitzungen, üblicherweise werden zwei aktive Sitzungen über alle Oberflächen hinweg genannt: die Desktop-App, den Web-Trader, die mobile App und jede TradingView- oder Drittanbieter-Verbindung. Für Live-Daten ist das Limit sogar noch strenger. Tradovate erlaubt pro Benutzerkonto nur eine einzige etablierte Marktdatenverbindung, sodass das Öffnen einer neuen Sitzung die vorherige beendet. Wenn Sie sich bei Tradovate Trader anmelden, beendet das Ihre API- oder WebSocket-Sitzung und umgekehrt." },
    { type: "paragraph",html: "Wenn Ihre gleichzeitigen Anmeldungen das überschreiten, was das Konto zulässt, lehnt Tradovate die überzählige Verbindung ab und gibt <strong class='text-white'>DeviceQuotaReached</strong> zurück, wörtlich: Das Gerätekontingent für dieses Konto ist erreicht. Der Server trennt die zusätzliche Verbindung mit einem abnormalen Schließen. Deshalb friert Ihr Chart ein, Ihr DOM aktualisiert nicht mehr oder Sie werden ohne erkennbaren Grund aus einer Position geworfen. Das ist weder ein Fehler Ihrer Strategie noch immer ein Tradovate-Ausfall. Meistens verteidigt das Konto lediglich sein Sitzungslimit, weil Sie an drei oder vier Orten gleichzeitig angemeldet sind." },
    { type: "paragraph",html: "Mit TradingView lässt sich das leicht unbemerkt auslösen. Jeder offene TradingView-Tab, der mit Ihrem Broker verbunden ist, belegt eine eigene Sitzung. Zwei Tabs plus die Desktop-App sind daher schon mehr, als das Konto zulassen will. Kommt noch die mobile App hinzu, liegen Sie deutlich über der Grenze." },
    { type: "heading",text: "Die häufigsten Ursachen für DeviceQuotaReached 2026" },
    { type: "heading",text: "1. Gleichzeitige Anmeldung auf mehreren Geräten" },
    { type: "paragraph",html: "Der Klassiker: die Desktop-App auf Ihrem Trading-PC, der Web-Trader auf einem Laptop und die mobile App auf Ihrem Smartphone, alle mit demselben Konto verbunden. Jede davon ist eine Live-Sitzung, und zusammen überschreiten sie das Limit." },
    { type: "heading",text: "2. Mehrere TradingView-Tabs gleichzeitig geöffnet" },
    { type: "paragraph",html: "In TradingView zählt jeder mit Tradovate verbundene Browser-Tab als eigene Sitzung. Zwei oder drei Chart-Tabs, die &ldquo;nur zum Beobachten&rdquo; offen sind, verbrauchen unbemerkt Ihr gesamtes Sitzungskontingent, bevor Sie eine einzige Order aufgeben." },
    { type: "heading",text: "3. Desktop, Web und TradingView gleichzeitig verbunden" },
    { type: "paragraph",html: "Das Mischen von Oberflächen ist die häufigste Variante dieses Problems in der Praxis. Sie senden Orders aus der Tradovate-Desktop-App, während ein TradingView-Tab noch zum Charting verbunden ist. Beide belegen Sitzungen, und die Marktdatenverbindung kann immer nur einer von ihnen gehören." },
    { type: "heading",text: "4. Schnelle Wiederverbindungsschleifen nach einem Abbruch" },
    { type: "paragraph",html: "Wenn eine Sitzung getrennt wird, macht es das Problem nur schlimmer, wenn Sie wiederholt auf die Anmeldeschaltfläche klicken. Häufige Neuverbindungen und wiederholte Anmeldeversuche zehren am stündlichen API-Anfragekontingent von Tradovate und können zusätzlich zum Sitzungskonflikt in eine separate Abkühlphase &ldquo;Too Many Requests&rdquo; (HTTP 429) eskalieren." },
    { type: "heading",text: "5. Eine veraltete Sitzung, die nie geschlossen wurde" },
    { type: "paragraph",html: "Ein Browserabsturz, ein Laptop, der in den Ruhezustand geht und wieder aufwacht, oder die routinemäßige Abmeldung der Plattform nach etwa 24 Stunden kann eine &ldquo;Geister&rdquo;-Sitzung in Ihrem Konto registriert lassen. Sie glauben, nur einmal angemeldet zu sein, aber der Server zählt noch eine alte Verbindung, sodass eine neue Anmeldung das Kontingent überschreitet." },
    { type: "heading",text: "DeviceQuotaReached beheben: Schritt für Schritt" },
    { type: "heading",text: "Ursachen 1 & 2 beheben: Zuerst in jeder Sitzung abmelden" },
    {
      type: "steps",
      items: [
        { title: "Primäres Gerät verbunden lassen", html: "Lassen Sie Tradovate auf Ihrem primären Handelsgerät geöffnet. Dies ist die eine Sitzung, die Sie behalten." },
        { title: "Auf allen anderen Geräten vollständig abmelden", html: "Öffnen Sie Tradovate auf jedem anderen Gerät (Laptop, zweiter Desktop, Smartphone) und melden Sie sich vollständig ab, statt nur das Fenster zu schließen. Das Schließen eines Tabs beendet die Sitzung nicht immer sauber." },
        { title: "Zusätzliche TradingView-Tabs schließen", html: "Schließen Sie in Ihrem Browser alle bis auf einen mit Tradovate verbundenen TradingView-Tab. Zusätzliche Tabs belegen jeweils eine Sitzung, auch wenn Sie sie gerade nicht ansehen." },
        { title: "Prüfen, ob nur noch eine Sitzung aktiv ist", html: "Warten Sie einige Sekunden, damit der Server die getrennten Verbindungen registriert, und prüfen Sie dann, ob nur noch eine aktive Sitzung besteht." },
      ],
    },
    { type: "heading",text: "Ursache 3 beheben: TradingView in einem einzigen Tab neu verbinden" },
    {
      type: "steps",
      items: [
        { title: "Broker-Verbindung prüfen", html: "Öffnen Sie in Ihrem einen verbliebenen TradingView-Tab das Broker-Handelspanel und prüfen Sie, ob dort noch eine aktive Tradovate-Verbindung angezeigt wird." },
        { title: "Einmal trennen und neu verbinden", html: "Wenn die Verbindung hängt oder einen Fehler anzeigt, trennen Sie die Tradovate-Broker-Verbindung und verbinden Sie sie anschließend einmalig aus diesem einen Tab neu." },
        { title: "Eine Order-Oberfläche wählen", html: "Steuern Sie dasselbe Konto nicht gleichzeitig über die Tradovate-Desktop-App und einen TradingView-Tab. Entscheiden Sie, welche Oberfläche Ihre Order-Oberfläche für die Sitzung ist, und nutzen Sie die andere nur für Charting." },
      ],
    },
    { type: "heading",text: "Ursachen 4 & 5 beheben: Uhr synchronisieren, Wiederverbindungen abwarten, nur einmal anmelden" },
    {
      type: "steps",
      items: [
        { title: "Wiederverbindungs-Spam stoppen", html: "Wenn Sie gerade DeviceQuotaReached oder einen 429-Fehler ausgelöst haben, warten Sie ab, statt es in einer Schleife erneut zu versuchen. Schnelle Versuche verlängern die Sperre, statt sie zu beenden." },
        { title: "Systemuhr synchronisieren", html: "Öffnen Sie unter Windows die Datums- und Uhrzeiteinstellungen, aktivieren Sie <strong class='text-white'>Set time automatically</strong> und klicken Sie auf <strong class='text-white'>Sync now</strong>. Eine auch nur leicht abweichende Uhr verursacht eingefrorene Charts und fehlgeschlagene Verbindungen, die genau wie Sitzungsfehler aussehen." },
        { title: "Veraltete Sitzungen bereinigen", html: "Wenn Sie nach einem Absturz oder Ruhezustand/Aufwachen eine Geister-Sitzung vermuten, schließen Sie den Browser vollständig oder starten Sie die Desktop-App neu, damit keine verwaiste Verbindung registriert bleibt." },
        { title: "Nur auf einem Gerät wieder anmelden", html: "Melden Sie sich, nachdem alles andere abgemeldet ist, neu auf Ihrer einen gewählten Oberfläche an. Sie sollten sich sauber verbinden und verbunden bleiben." },
        { title: "Support kontaktieren, falls es weiter besteht", html: "Wenn DeviceQuotaReached weiter auftritt, obwohl Sie tatsächlich nur ein Gerät nutzen, wenden Sie sich an den Tradovate-Support und bitten Sie darum, verbleibende Sitzungen im Konto zu löschen." },
      ],
    },
    { type: "heading",text: "Fehlerbehebungstabelle" },
    { type: "table", headers: ["Fehler / Symptom","Bedeutung","Lösung"], rows: [
      ["DeviceQuotaReached","Das Kontingent gleichzeitiger Sitzungen (Geräte) des Kontos wurde überschritten","Melden Sie sich auf jedem Gerät und in jedem zusätzlichen TradingView-Tab ab und dann nur auf einem Gerät wieder an"],
      ["Etwa alle 24 Stunden abgemeldet","Routinemäßige Sitzungserneuerung von Tradovate, verschärft durch zusätzlich geöffnete Sitzungen","Bleiben Sie bei einer einzigen Sitzung und melden Sie sich einfach auf diesem einen Gerät wieder an"],
      ["\"Too Many Requests\" / HTTP 429 nach dem erneuten Verbinden","Schnelle Neuanmeldungen haben Ihr stündliches API-Anfragekontingent aufgebraucht","Hören Sie auf, es erneut zu versuchen, warten Sie die Abkühlphase ab und melden Sie sich dann einmal an"],
      ["Chart eingefroren oder Kurse statisch","Sitzungskonflikt, nicht synchronisierte Uhr, schwache Verbindung oder ein abgelaufener Kontraktmonat","Uhr synchronisieren, stabile Verbindung nutzen, Front-Month-Kontrakt prüfen und auf eine Sitzung reduzieren"],
      ["Aus einem Trade über TradingView \"ohne Grund\" herausgeworfen","Eine zweite Sitzung hat der ersten die einzelne Marktdatenverbindung entzogen","Auf eine einzige verbundene Oberfläche für dieses Konto reduzieren"],
      ["Weiterhin Verbindungsabbrüche auf einem einzigen Gerät","Möglicherweise ist noch eine veraltete \"Geister\"-Sitzung im Konto registriert","App/Browser neu starten; besteht das Problem weiter, den Tradovate-Support bitten, alte Sitzungen zu löschen"],
    ] },
    { type: "heading",text: "Mit PickMyTrade vorbeugen" },
    { type: "paragraph",html: "DeviceQuotaReached tritt auf, weil ein Mensch an mehreren Orten gleichzeitig angemeldet ist. Wenn Sie die Ausführung automatisieren, entfällt der Großteil dieser Angriffsfläche. Ihre Strategie feuert über eine disziplinierte Verbindung, statt dass Sie die Desktop-App, ein Smartphone und drei TradingView-Tabs jonglieren:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Einzelne, disziplinierte Verbindung</strong>, PickMyTrade leitet Ihre TradingView-Alerts über eine verwaltete Verbindung an Tradovate weiter, sodass Sie keine manuellen Sitzungen stapeln, die das Gerätekontingent auslösen.",
        "<strong class='text-white'>Ratenlimit-sicheres Routing</strong>, der Orderfluss wird zeitlich gestaffelt, damit er innerhalb der Anfragelimits von Tradovate bleibt und Wiederholungsstürme vermeidet, die zu 429-&ldquo;Too Many Requests&rdquo;-Sperren eskalieren.",
        "<strong class='text-white'>Berechtigungs- &amp; Risikobewusstsein</strong>, das Routing berücksichtigt die Limits Ihres Kontos und den Status der Datenvereinbarung, sodass Orders sauber abgehen, statt abzuprallen.",
        "<strong class='text-white'>Multi-Konto-Synchronisierung</strong>, spiegeln Sie eine Strategie über mehrere Konten von einer einzigen Brücke aus, statt für jedes Konto eine eigene Live-Anmeldung zu öffnen.",
      ],
    },
    { type: "paragraph",html: "Automatisierung erhöht das Sitzungslimit von Tradovate nicht, aber sie sorgt dafür, dass Sie selten mehr als eine Verbindung offen brauchen, und genau das verhindert, dass DeviceQuotaReached überhaupt ausgelöst wird." },
  ], es: [
    { type: "paragraph",html: "Nada le saca más de quicio que Tradovate corte la conexión y congele el gráfico mientras gestiona una posición en vivo en ES o NQ. Si mantiene la app de escritorio, echa un vistazo a la app móvil y deja abierta una pestaña de TradingView a la vez, tarde o temprano activará el error <strong class='text-white'>DeviceQuotaReached</strong> de la plataforma. Ese mensaje es Tradovate indicando que se superó la cuota de sesiones (dispositivos) de la cuenta, por lo que empieza a desconectar conexiones." },
    { type: "paragraph",html: "El mismo problema de fondo adopta distintas formas: cierres de sesión repetidos cada 24 horas, un aviso de &ldquo;conexión cerrada&rdquo;, un gráfico que deja de actualizarse sin avisar o que le expulsen de una operación &ldquo;sin motivo&rdquo;. La causa casi siempre es la misma: demasiados inicios de sesión simultáneos en una sola cuenta. Aquí tiene exactamente qué es el límite de dos sesiones de Tradovate, por qué aparece DeviceQuotaReached y cómo volver a una conexión limpia y estable, con la misma disciplina que usa un puente de automatización como PickMyTrade para que su estrategia nunca inicie sesión dos veces en su cuenta." },
    {
      type: "checklist",
      heading: "Lista de verificación rápida para DeviceQuotaReached y límites de sesión",
      items: [
        "<strong class='text-white'>¿Ha iniciado sesión en más de un dispositivo?</strong> Cierre la sesión de Tradovate en todas partes excepto en el dispositivo desde el que opera activamente.",
        "<strong class='text-white'>¿Varias pestañas de TradingView abiertas?</strong> Cierre todas menos una. En TradingView, cada pestaña del navegador cuenta como una sesión propia.",
        "<strong class='text-white'>¿Escritorio, web y móvil conectados a la vez?</strong> Elija una única superficie y cierre la sesión en las demás.",
        "<strong class='text-white'>¿Acaba de ver DeviceQuotaReached?</strong> Cierre por completo todas las sesiones, espere un momento y vuelva a iniciar sesión en un solo dispositivo.",
        "<strong class='text-white'>¿Gráfico congelado o precios estáticos?</strong> Sincronice el reloj de su ordenador y revise su conexión antes de culpar a la plataforma.",
        "<strong class='text-white'>¿Se reconecta una y otra vez?</strong> Pare. Los reinicios de sesión rápidos consumen su cuota de API y pueden provocar un bloqueo independiente de &ldquo;Too Many Requests&rdquo;.",
      ],
    },
    { type: "heading",text: "Qué significa «DeviceQuotaReached»" },
    { type: "paragraph",html: "Tradovate limita cada cuenta a un número reducido de sesiones simultáneas, que suele describirse como dos sesiones activas entre todas sus superficies: la app de escritorio, el web trader, la app móvil y cualquier conexión de TradingView o de terceros. En el fondo, el límite es aún más estricto para los datos en vivo. Tradovate permite una única conexión de datos de mercado establecida por cuenta de usuario, de modo que abrir una nueva sesión termina la anterior. Si inicia sesión en Tradovate Trader, se cierra su sesión de API o WebSocket, y viceversa." },
    { type: "paragraph",html: "Cuando sus inicios de sesión simultáneos superan lo que la cuenta permite, Tradovate rechaza la conexión sobrante y devuelve <strong class='text-white'>DeviceQuotaReached</strong>, literalmente, se alcanzó la cuota de dispositivos de esta cuenta. El servidor corta la conexión adicional con un cierre anómalo, y por eso su gráfico se congela, su DOM deja de actualizarse o le expulsan de una posición sin una explicación clara. No es un fallo de su estrategia ni siempre una caída de Tradovate. La mayoría de las veces es la cuenta defendiendo su tope de sesiones porque usted está conectado en tres o cuatro sitios a la vez." },
    { type: "paragraph",html: "TradingView hace muy fácil provocarlo sin darse cuenta. Cada pestaña de TradingView abierta y conectada a su bróker mantiene su propia sesión, así que dos pestañas más la app de escritorio ya superan lo que la cuenta quiere permitir. Si además la app móvil se conecta, se pasa claramente del límite." },
    { type: "heading",text: "Principales causas de DeviceQuotaReached en 2026" },
    { type: "heading",text: "1. Sesión iniciada en varios dispositivos a la vez" },
    { type: "paragraph",html: "El desencadenante clásico: la app de escritorio en su PC de trading, el web trader en un portátil y la app móvil en su teléfono, todos conectados a la misma cuenta. Cada uno es una sesión activa y juntos superan el tope." },
    { type: "heading",text: "2. Varias pestañas de TradingView abiertas al mismo tiempo" },
    { type: "paragraph",html: "En TradingView, cada pestaña del navegador vinculada a Tradovate cuenta como una sesión distinta. Dos o tres pestañas de gráficos abiertas &ldquo;solo para mirar&rdquo; consumen en silencio todo su presupuesto de sesiones antes de que envíe una sola orden." },
    { type: "heading",text: "3. Escritorio, web y TradingView conectados simultáneamente" },
    { type: "paragraph",html: "Mezclar superficies es la versión más habitual de este problema en la práctica. Envía órdenes desde la app de escritorio de Tradovate mientras una pestaña de TradingView sigue conectada para los gráficos. Ambas mantienen sesiones y la conexión de datos de mercado solo puede pertenecer a una de ellas a la vez." },
    { type: "heading",text: "4. Bucles de reconexión rápidos tras una caída" },
    { type: "paragraph",html: "Cuando se corta una sesión, pulsar sin parar el botón de inicio de sesión para volver a entrar empeora las cosas. Las reconexiones frecuentes y los intentos repetidos de inicio de sesión consumen la cuota horaria de solicitudes de API de Tradovate y pueden derivar en un enfriamiento independiente de &ldquo;Too Many Requests&rdquo; (HTTP 429) además del conflicto de sesiones." },
    { type: "heading",text: "5. Una sesión obsoleta que nunca se cerró" },
    { type: "paragraph",html: "Un fallo del navegador, un portátil que se suspende y se reactiva o el cierre de sesión rutinario de unas 24 horas de la plataforma pueden dejar una sesión &ldquo;fantasma&rdquo; registrada en su cuenta. Usted cree haber iniciado sesión una sola vez, pero el servidor aún cuenta una conexión antigua, así que un nuevo inicio de sesión supera la cuota." },
    { type: "heading",text: "Cómo solucionar DeviceQuotaReached: paso a paso" },
    { type: "heading",text: "Solución de las causas 1 y 2: cierre primero todas las sesiones" },
    {
      type: "steps",
      items: [
        { title: "Deje conectado su dispositivo principal", html: "En su dispositivo principal de trading, deje Tradovate abierto. Esta es la única sesión que conservará." },
        { title: "Cierre sesión por completo en todos los demás dispositivos", html: "En cada uno de los demás dispositivos (portátil, segundo ordenador, teléfono), abra Tradovate y cierre sesión por completo en lugar de limitarse a cerrar la ventana. Cerrar una pestaña no siempre termina la sesión de forma limpia." },
        { title: "Cierre las pestañas extra de TradingView", html: "En su navegador, cierre todas las pestañas de TradingView conectadas a Tradovate salvo una. Las pestañas adicionales mantienen cada una una sesión aunque no las esté mirando." },
        { title: "Confirme que solo queda una sesión", html: "Espere unos segundos para que el servidor registre las conexiones cerradas y luego confirme que solo queda una sesión activa." },
      ],
    },
    { type: "heading",text: "Solución de la causa 3: reconecte TradingView en una sola pestaña" },
    {
      type: "steps",
      items: [
        { title: "Revise la conexión con el bróker", html: "En su única pestaña de TradingView restante, abra el panel de trading del bróker y compruebe si sigue mostrando una conexión activa con Tradovate." },
        { title: "Desconecte y reconecte una sola vez", html: "Si está bloqueada o muestra un error, desconecte la conexión del bróker Tradovate y vuelva a conectarla una sola vez desde esa pestaña." },
        { title: "Elija una única superficie de órdenes", html: "No envíe órdenes de la misma cuenta desde la app de escritorio de Tradovate y desde una pestaña de TradingView a la vez. Decida cuál es su superficie de órdenes para la sesión y reserve la otra solo para los gráficos." },
      ],
    },
    { type: "heading",text: "Solución de las causas 4 y 5: sincronice el reloj, espere las reconexiones e inicie sesión una sola vez" },
    {
      type: "steps",
      items: [
        { title: "Detenga el spam de reconexiones", html: "Si acaba de activar DeviceQuotaReached o un 429, espere en lugar de reintentar en bucle. Los intentos rápidos prolongan el bloqueo en vez de eliminarlo." },
        { title: "Sincronice el reloj del sistema", html: "En Windows, abra la configuración de fecha y hora, active <strong class='text-white'>Set time automatically</strong> y haga clic en <strong class='text-white'>Sync now</strong>. Un reloj desfasado incluso ligeramente provoca gráficos congelados y conexiones fallidas que parecen exactamente errores de sesión." },
        { title: "Elimine las sesiones obsoletas", html: "Si sospecha de una sesión fantasma tras un fallo o una suspensión/reactivación, cierre por completo el navegador o reinicie la app de escritorio para que no quede registrada ninguna conexión huérfana." },
        { title: "Vuelva a iniciar sesión en un solo dispositivo", html: "Con todo lo demás cerrado, inicie sesión de nuevo en la única superficie elegida. Debería reconectarse sin problemas y mantenerse conectado." },
        { title: "Contacte con soporte si persiste", html: "Si DeviceQuotaReached persiste aunque realmente esté en un solo dispositivo, contacte con el soporte de Tradovate y pida que eliminen las sesiones residuales de la cuenta." },
      ],
    },
    { type: "heading",text: "Tabla de solución de problemas" },
    { type: "table", headers: ["Error / síntoma","Qué significa","Solución"], rows: [
      ["DeviceQuotaReached","Se superó la cuota de sesiones simultáneas (dispositivos) de la cuenta","Cierre sesión en todos los dispositivos y en las pestañas extra de TradingView y luego inicie sesión en un solo dispositivo"],
      ["Sesión cerrada aproximadamente cada 24 horas","Renovación rutinaria de sesión de Tradovate, agravada por tener sesiones adicionales abiertas","Mantenga una sola sesión; simplemente vuelva a iniciar sesión en ese dispositivo"],
      ["\"Too Many Requests\" / HTTP 429 tras reconectar","Los reinicios de sesión rápidos consumieron su cuota horaria de solicitudes de API","Deje de reintentar, espere a que termine el enfriamiento y luego inicie sesión una sola vez"],
      ["Gráfico congelado o precios estáticos","Conflicto de sesiones, reloj desincronizado, conexión débil o mes de contrato vencido","Sincronice el reloj, use una conexión estable, confirme el contrato del mes más cercano y reduzca a una sola sesión"],
      ["Expulsado de una operación \"sin motivo\" desde TradingView","Una segunda sesión le quitó a la primera la única conexión de datos de mercado","Consolide en una sola superficie conectada para esa cuenta"],
      ["Sigue desconectándose en un solo dispositivo","Puede que aún haya una sesión \"fantasma\" obsoleta registrada en la cuenta","Reinicie la app/el navegador; si persiste, pida al soporte de Tradovate que elimine las sesiones antiguas"],
    ] },
    { type: "heading",text: "Prevéngalo con PickMyTrade" },
    { type: "paragraph",html: "DeviceQuotaReached aparece porque una persona acaba con la sesión iniciada en varios sitios a la vez. Automatizar su ejecución elimina gran parte de esa superficie. Su estrategia se dispara desde una conexión disciplinada en lugar de que usted malabarée la app de escritorio, un teléfono y tres pestañas de TradingView:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Conexión única y disciplinada</strong>, PickMyTrade enruta sus alertas de TradingView a Tradovate mediante un enlace gestionado, de modo que no acumula sesiones manuales que activen la cuota de dispositivos.",
        "<strong class='text-white'>Enrutamiento seguro frente a límites de frecuencia</strong>, el flujo de órdenes se espacia para mantenerse dentro de los límites de solicitudes de Tradovate, evitando las tormentas de reintentos que derivan en bloqueos 429 de &ldquo;Too Many Requests&rdquo;.",
        "<strong class='text-white'>Conciencia de permisos &amp; riesgo</strong>, el enrutamiento respeta los límites de su cuenta y el estado del acuerdo de datos, de modo que las órdenes salen limpias en lugar de ser rechazadas.",
        "<strong class='text-white'>Sincronización multicuenta</strong>, replique una estrategia en varias cuentas desde un único puente en lugar de abrir un inicio de sesión en vivo independiente para cada una.",
      ],
    },
    { type: "paragraph",html: "La automatización no aumenta el límite de sesiones de Tradovate, pero hace que rara vez necesite más de una conexión abierta, que es justo lo que evita que DeviceQuotaReached se active." },
  ], fr: [
    { type: "paragraph",html: "Rien ne vous déstabilise plus vite que Tradovate qui coupe la connexion et fige le graphique alors que vous gérez une position en direct sur l'ES ou le NQ. Si vous faites tourner l'application de bureau, jetez un œil à l'application mobile et gardez un onglet TradingView ouvert en même temps, vous finirez tôt ou tard par déclencher l'erreur <strong class='text-white'>DeviceQuotaReached</strong> de la plateforme. Ce message signifie que le quota de sessions (appareils) du compte a été dépassé, et Tradovate commence donc à couper des connexions." },
    { type: "paragraph",html: "Le même problème de fond prend différents visages : des déconnexions répétées toutes les 24 heures, une bannière &ldquo;connexion fermée&rdquo;, un graphique qui cesse discrètement de se mettre à jour, ou une éjection d'un trade &ldquo;sans raison&rdquo;. La cause est presque toujours la même : trop de connexions simultanées sur un seul compte. Voici précisément ce qu'est la limite de deux sessions de Tradovate, pourquoi DeviceQuotaReached se déclenche et comment revenir à une connexion unique, propre et stable, avec la même discipline que celle d'un pont d'automatisation comme PickMyTrade, pour que votre stratégie ne connecte jamais votre compte en double." },
    {
      type: "checklist",
      heading: "Liste de contrôle rapide pour DeviceQuotaReached et les limites de session",
      items: [
        "<strong class='text-white'>Connecté sur plus d'un appareil ?</strong> Déconnectez-vous de Tradovate partout, sauf sur l'appareil depuis lequel vous tradez activement.",
        "<strong class='text-white'>Plusieurs onglets TradingView ouverts ?</strong> Fermez-les tous sauf un. Dans TradingView, chaque onglet du navigateur compte comme sa propre session.",
        "<strong class='text-white'>Bureau, web et mobile tous connectés ?</strong> Choisissez une seule interface et déconnectez-vous des autres.",
        "<strong class='text-white'>Vous venez de voir DeviceQuotaReached ?</strong> Déconnectez-vous complètement de toutes les sessions, patientez un instant, puis reconnectez-vous sur un seul appareil.",
        "<strong class='text-white'>Graphique figé ou prix statiques ?</strong> Synchronisez l'horloge de votre ordinateur et vérifiez votre connexion avant d'accuser la plateforme.",
        "<strong class='text-white'>Vous vous reconnectez sans cesse ?</strong> Arrêtez. Les reconnexions rapides consomment votre quota d'API et peuvent déclencher un blocage distinct &ldquo;Too Many Requests&rdquo;.",
      ],
    },
    { type: "heading",text: "Ce que signifie « DeviceQuotaReached »" },
    { type: "paragraph",html: "Tradovate limite chaque compte à un petit nombre de sessions simultanées, généralement décrit comme deux sessions actives sur l'ensemble de ses interfaces : l'application de bureau, le web trader, l'application mobile et toute connexion TradingView ou tierce. Côté données en direct, la limite est encore plus stricte. Tradovate n'autorise qu'une seule connexion de données de marché établie par compte utilisateur, de sorte que l'ouverture d'une nouvelle session met fin à la précédente. Se connecter à Tradovate Trader met fin à votre session API ou WebSocket, et inversement." },
    { type: "paragraph",html: "Lorsque vos connexions simultanées dépassent ce que le compte autorise, Tradovate refuse la connexion excédentaire et renvoie <strong class='text-white'>DeviceQuotaReached</strong>, littéralement, le quota d'appareils de ce compte est atteint. Le serveur coupe la connexion supplémentaire par une fermeture anormale, ce qui explique pourquoi votre graphique se fige, votre DOM cesse de s'afficher ou vous êtes éjecté d'une position sans explication évidente. Ce n'est pas un défaut de votre stratégie, ni toujours une panne de Tradovate. La plupart du temps, c'est simplement le compte qui protège sa limite de sessions parce que vous êtes connecté à trois ou quatre endroits à la fois." },
    { type: "paragraph",html: "TradingView permet de déclencher cela très facilement sans s'en apercevoir. Chaque onglet TradingView ouvert et connecté à votre courtier détient sa propre session, donc deux onglets plus l'application de bureau dépassent déjà ce que le compte souhaite autoriser. Ajoutez l'application mobile qui se connecte, et vous êtes largement au-dessus de la limite." },
    { type: "heading",text: "Principales causes de DeviceQuotaReached en 2026" },
    { type: "heading",text: "1. Connecté sur plusieurs appareils à la fois" },
    { type: "paragraph",html: "Le déclencheur classique : l'application de bureau sur votre PC de trading, le web trader sur un ordinateur portable et l'application mobile sur votre téléphone, tous connectés au même compte. Chacun est une session active, et ensemble ils dépassent le plafond." },
    { type: "heading",text: "2. Plusieurs onglets TradingView ouverts en même temps" },
    { type: "paragraph",html: "Dans TradingView, chaque onglet du navigateur lié à Tradovate compte comme une session distincte. Deux ou trois onglets de graphiques ouverts &ldquo;juste pour surveiller&rdquo; consomment discrètement tout votre quota de sessions avant que vous ayez passé le moindre ordre." },
    { type: "heading",text: "3. Bureau, web et TradingView connectés simultanément" },
    { type: "paragraph",html: "Mélanger les interfaces est la version la plus courante de ce problème dans la pratique. Vous envoyez vos ordres depuis l'application de bureau Tradovate tandis qu'un onglet TradingView reste connecté pour les graphiques. Les deux détiennent des sessions, et la connexion de données de marché ne peut appartenir qu'à l'une d'elles à la fois." },
    { type: "heading",text: "4. Boucles de reconnexion rapides après une coupure" },
    { type: "paragraph",html: "Lorsqu'une session est éjectée, marteler le bouton de connexion pour revenir aggrave la situation. Les reconnexions fréquentes et les tentatives de connexion répétées entament le quota horaire de requêtes API de Tradovate et peuvent dégénérer en une période d'attente distincte &ldquo;Too Many Requests&rdquo; (HTTP 429) en plus du conflit de sessions." },
    { type: "heading",text: "5. Une session obsolète qui ne s'est jamais fermée" },
    { type: "paragraph",html: "Un plantage du navigateur, un ordinateur portable qui se met en veille puis se réveille, ou la déconnexion habituelle d'environ 24 heures de la plateforme peuvent laisser une session &ldquo;fantôme&rdquo; enregistrée sur votre compte. Vous pensez être connecté une seule fois, mais le serveur compte encore une ancienne connexion, et une nouvelle connexion fait donc dépasser le quota." },
    { type: "heading",text: "Comment corriger DeviceQuotaReached : étape par étape" },
    { type: "heading",text: "Corriger les causes 1 et 2 : se déconnecter d'abord de toutes les sessions" },
    {
      type: "steps",
      items: [
        { title: "Laissez votre appareil principal connecté", html: "Sur votre appareil de trading principal, laissez Tradovate ouvert. C'est la seule session que vous conserverez." },
        { title: "Déconnectez-vous complètement sur tous les autres appareils", html: "Sur chacun des autres appareils (ordinateur portable, second ordinateur, téléphone), ouvrez Tradovate et déconnectez-vous complètement plutôt que de simplement fermer la fenêtre. Fermer un onglet ne met pas toujours fin proprement à la session." },
        { title: "Fermez les onglets TradingView supplémentaires", html: "Dans votre navigateur, fermez tous les onglets TradingView connectés à Tradovate sauf un. Chaque onglet supplémentaire détient une session même lorsque vous ne le regardez pas." },
        { title: "Vérifiez qu'il ne reste qu'une session", html: "Patientez quelques secondes pour que le serveur enregistre les connexions fermées, puis vérifiez qu'il ne reste qu'une seule session active." },
      ],
    },
    { type: "heading",text: "Corriger la cause 3 : reconnecter TradingView sur un seul onglet" },
    {
      type: "steps",
      items: [
        { title: "Vérifiez la connexion au courtier", html: "Dans votre unique onglet TradingView restant, ouvrez le panneau de trading du courtier et vérifiez s'il affiche toujours une connexion Tradovate active." },
        { title: "Déconnectez puis reconnectez une seule fois", html: "Si elle est bloquée ou affiche une erreur, déconnectez la connexion au courtier Tradovate, puis reconnectez-la une seule fois depuis cet onglet." },
        { title: "Choisissez une seule interface d'ordres", html: "Ne pilotez pas le même compte à la fois depuis l'application de bureau Tradovate et un onglet TradingView. Décidez laquelle est votre interface d'ordres pour la session et gardez l'autre uniquement pour les graphiques." },
      ],
    },
    { type: "heading",text: "Corriger les causes 4 et 5 : synchroniser l'horloge, attendre les reconnexions, ne se connecter qu'une fois" },
    {
      type: "steps",
      items: [
        { title: "Arrêtez le spam de reconnexions", html: "Si vous venez de déclencher DeviceQuotaReached ou un 429, patientez au lieu de réessayer en boucle. Les tentatives rapides prolongent le blocage au lieu de le lever." },
        { title: "Synchronisez l'horloge système", html: "Sous Windows, ouvrez les paramètres de date et d'heure, activez <strong class='text-white'>Set time automatically</strong> et cliquez sur <strong class='text-white'>Sync now</strong>. Une horloge même légèrement désynchronisée provoque des graphiques figés et des connexions échouées qui ressemblent exactement à des erreurs de session." },
        { title: "Supprimez les sessions obsolètes", html: "Si vous soupçonnez une session fantôme après un plantage ou une mise en veille/réveil, fermez complètement le navigateur ou redémarrez l'application de bureau afin qu'aucune connexion orpheline ne reste enregistrée." },
        { title: "Reconnectez-vous sur un seul appareil", html: "Une fois tout le reste déconnecté, connectez-vous à nouveau sur votre unique interface choisie. Vous devriez vous reconnecter proprement et rester connecté." },
        { title: "Contactez le support si le problème persiste", html: "Si DeviceQuotaReached persiste alors que vous n'êtes réellement que sur un appareil, contactez le support Tradovate et demandez-lui de supprimer les sessions résiduelles du compte." },
      ],
    },
    { type: "heading",text: "Tableau de dépannage" },
    { type: "table", headers: ["Erreur / symptôme","Signification","Solution"], rows: [
      ["DeviceQuotaReached","Le quota de sessions simultanées (appareils) du compte a été dépassé","Déconnectez-vous de chaque appareil et onglet TradingView supplémentaire, puis connectez-vous sur un seul appareil"],
      ["Déconnecté environ toutes les 24 heures","Renouvellement de session habituel de Tradovate, aggravé par des sessions supplémentaires ouvertes","Restez sur une seule session ; reconnectez-vous simplement sur cet appareil"],
      ["\"Too Many Requests\" / HTTP 429 après reconnexion","Des reconnexions rapides ont épuisé votre quota horaire de requêtes API","Cessez de réessayer, attendez la fin de la période d'attente, puis connectez-vous une seule fois"],
      ["Graphique figé ou prix statiques","Conflit de sessions, horloge désynchronisée, connexion faible ou mois de contrat expiré","Synchronisez l'horloge, utilisez une connexion stable, vérifiez le contrat du mois en cours et passez à une seule session"],
      ["Éjecté d'un trade \"sans raison\" depuis TradingView","Une deuxième session a retiré à la première l'unique connexion de données de marché","Regroupez sur une seule interface connectée pour ce compte"],
      ["Toujours déconnecté sur un seul appareil","Une session \"fantôme\" obsolète est peut-être encore enregistrée sur le compte","Redémarrez l'application/le navigateur ; si le problème persiste, demandez au support Tradovate de supprimer les anciennes sessions"],
    ] },
    { type: "heading",text: "Évitez cela avec PickMyTrade" },
    { type: "paragraph",html: "DeviceQuotaReached survient parce qu'un humain se retrouve connecté à plusieurs endroits à la fois. Automatiser votre exécution supprime l'essentiel de cette surface. Votre stratégie se déclenche depuis une connexion disciplinée au lieu que vous jongliez entre l'application de bureau, un téléphone et trois onglets TradingView :" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Connexion unique et disciplinée</strong>, PickMyTrade achemine vos alertes TradingView vers Tradovate via un lien géré, de sorte que vous n'empilez pas de sessions manuelles qui déclenchent le quota d'appareils.",
        "<strong class='text-white'>Routage respectueux des limites de débit</strong>, le flux d'ordres est espacé pour rester dans les limites de requêtes de Tradovate, en évitant les tempêtes de nouvelles tentatives qui dégénèrent en blocages 429 &ldquo;Too Many Requests&rdquo;.",
        "<strong class='text-white'>Prise en compte des droits &amp; du risque</strong>, le routage respecte les limites de votre compte et l'état de votre accord de données, de sorte que les ordres partent proprement au lieu d'être rejetés.",
        "<strong class='text-white'>Synchronisation multi-comptes</strong>, répliquez une stratégie sur plusieurs comptes depuis un seul pont plutôt que d'ouvrir une connexion en direct distincte pour chacun.",
      ],
    },
    { type: "paragraph",html: "L'automatisation n'augmente pas le plafond de sessions de Tradovate, mais elle fait que vous avez rarement besoin de plus d'une connexion ouverte, ce qui est précisément ce qui empêche DeviceQuotaReached de se déclencher." },
  ], it: [
    { type: "paragraph",html: "Niente la agita più in fretta di Tradovate che interrompe la connessione e blocca il grafico mentre sta gestendo una posizione aperta su ES o NQ. Se tiene in esecuzione l'app desktop, dà un'occhiata all'app mobile e lascia aperta una scheda di TradingView tutto insieme, prima o poi farà scattare l'errore <strong class='text-white'>DeviceQuotaReached</strong> della piattaforma. Quel messaggio è Tradovate che le dice che la quota di sessioni (dispositivi) dell'account è stata superata, e inizia quindi a scollegare le connessioni." },
    { type: "paragraph",html: "Lo stesso problema di fondo si presenta in forme diverse: disconnessioni ripetute ogni 24 ore, un banner &ldquo;connessione chiusa&rdquo;, un grafico che smette silenziosamente di aggiornarsi, o l'espulsione da un trade &ldquo;senza motivo&rdquo;. La causa è quasi sempre la stessa: troppi accessi simultanei su un solo account. Ecco esattamente che cos'è il limite delle due sessioni di Tradovate, perché scatta DeviceQuotaReached e come tornare a una connessione unica, pulita e stabile, con la stessa disciplina che un bridge di automazione come PickMyTrade usa perché la sua strategia non acceda mai due volte al suo account." },
    {
      type: "checklist",
      heading: "Checklist rapida per DeviceQuotaReached e limiti di sessione",
      items: [
        "<strong class='text-white'>Ha effettuato l'accesso su più di un dispositivo?</strong> Esca da Tradovate ovunque tranne che sull'unico dispositivo da cui sta operando attivamente.",
        "<strong class='text-white'>Più schede di TradingView aperte?</strong> Le chiuda tutte tranne una. In TradingView ogni scheda del browser conta come una sessione a sé.",
        "<strong class='text-white'>Desktop, web e mobile tutti connessi?</strong> Scelga una sola superficie ed esca dalle altre.",
        "<strong class='text-white'>Ha appena visto DeviceQuotaReached?</strong> Esca completamente da ogni sessione, attenda un momento e poi acceda di nuovo su un solo dispositivo.",
        "<strong class='text-white'>Grafico bloccato o prezzi statici?</strong> Sincronizzi l'orologio del computer e verifichi la connessione prima di dare la colpa alla piattaforma.",
        "<strong class='text-white'>Si riconnette continuamente?</strong> Si fermi. Gli accessi ripetuti rapidamente consumano la sua quota API e possono innescare un blocco separato &ldquo;Too Many Requests&rdquo;.",
      ],
    },
    { type: "heading",text: "Che cosa significa «DeviceQuotaReached»" },
    { type: "paragraph",html: "Tradovate limita ogni account a un numero ridotto di sessioni simultanee, di solito descritto come due sessioni attive su tutte le sue superfici: l'app desktop, il web trader, l'app mobile e qualsiasi connessione di TradingView o di terze parti. Per i dati in tempo reale il limite è ancora più stretto. Tradovate consente una sola connessione ai dati di mercato stabilita per account utente, quindi aprire una nuova sessione termina la precedente. Accedere a Tradovate Trader termina la sua sessione API o WebSocket, e viceversa." },
    { type: "paragraph",html: "Quando i suoi accessi simultanei superano ciò che l'account consente, Tradovate rifiuta la connessione in eccesso e restituisce <strong class='text-white'>DeviceQuotaReached</strong>, letteralmente, la quota di dispositivi per questo account è stata raggiunta. Il server interrompe la connessione aggiuntiva con una chiusura anomala, ed è per questo che il grafico si blocca, il DOM smette di aggiornarsi o lei viene espulso da una posizione senza una spiegazione evidente. Non è un difetto della sua strategia e non sempre è un'interruzione di Tradovate. Il più delle volte è l'account che difende il proprio limite di sessioni perché lei è connesso in tre o quattro posti contemporaneamente." },
    { type: "paragraph",html: "Con TradingView è facile farlo scattare senza accorgersene. Ogni scheda di TradingView aperta e connessa al suo broker mantiene una propria sessione, quindi due schede più l'app desktop sono già più di quanto l'account voglia consentire. Aggiunga l'app mobile che si collega e supera di parecchio il limite." },
    { type: "heading",text: "Principali cause di DeviceQuotaReached nel 2026" },
    { type: "heading",text: "1. Accesso su più dispositivi contemporaneamente" },
    { type: "paragraph",html: "Il classico innesco: l'app desktop sul PC di trading, il web trader su un laptop e l'app mobile sul telefono, tutti connessi allo stesso account. Ognuno è una sessione attiva e insieme superano il tetto." },
    { type: "heading",text: "2. Più schede di TradingView aperte nello stesso momento" },
    { type: "paragraph",html: "In TradingView ogni scheda del browser collegata a Tradovate conta come una sessione separata. Due o tre schede di grafici aperte &ldquo;solo per guardare&rdquo; consumano silenziosamente l'intero budget di sessioni prima che lei invii un solo ordine." },
    { type: "heading",text: "3. Desktop, web e TradingView connessi contemporaneamente" },
    { type: "paragraph",html: "Mescolare le superfici è la versione più comune di questo problema nella pratica. Invia ordini dall'app desktop di Tradovate mentre una scheda di TradingView è ancora connessa per i grafici. Entrambe mantengono sessioni e la connessione ai dati di mercato può appartenere solo a una delle due alla volta." },
    { type: "heading",text: "4. Cicli di riconnessione rapidi dopo una caduta" },
    { type: "paragraph",html: "Quando una sessione viene espulsa, martellare il pulsante di accesso per rientrare peggiora le cose. Le riconnessioni frequenti e i ripetuti tentativi di accesso erodono la quota oraria di richieste API di Tradovate e possono degenerare in un periodo di attesa separato &ldquo;Too Many Requests&rdquo; (HTTP 429) oltre al conflitto di sessioni." },
    { type: "heading",text: "5. Una sessione obsoleta che non si è mai chiusa" },
    { type: "paragraph",html: "Un arresto anomalo del browser, un laptop che va in sospensione e si riattiva, o la normale disconnessione di circa 24 ore della piattaforma possono lasciare una sessione &ldquo;fantasma&rdquo; registrata sul suo account. Pensa di aver effettuato l'accesso una sola volta, ma il server conta ancora una vecchia connessione, quindi un nuovo accesso supera la quota." },
    { type: "heading",text: "Come risolvere DeviceQuotaReached: passo dopo passo" },
    { type: "heading",text: "Risolvere le cause 1 e 2: uscire prima da ogni sessione" },
    {
      type: "steps",
      items: [
        { title: "Lasci connesso il dispositivo principale", html: "Sul suo dispositivo di trading principale, lasci Tradovate aperto. È l'unica sessione che manterrà." },
        { title: "Esca completamente su tutti gli altri dispositivi", html: "Su ogni altro dispositivo (laptop, secondo desktop, telefono), apra Tradovate ed esca completamente invece di chiudere soltanto la finestra. Chiudere una scheda non sempre termina la sessione in modo pulito." },
        { title: "Chiuda le schede TradingView in più", html: "Nel browser, chiuda tutte le schede di TradingView connesse a Tradovate tranne una. Ogni scheda extra mantiene una sessione anche quando non la sta guardando." },
        { title: "Confermi di essere a una sola sessione", html: "Attenda qualche secondo perché il server registri le connessioni chiuse, poi confermi di avere una sola sessione attiva." },
      ],
    },
    { type: "heading",text: "Risolvere la causa 3: riconnettere TradingView su una sola scheda" },
    {
      type: "steps",
      items: [
        { title: "Verifichi la connessione al broker", html: "Nell'unica scheda TradingView rimasta, apra il pannello di trading del broker e controlli se mostra ancora una connessione Tradovate attiva." },
        { title: "Disconnetta e riconnetta una sola volta", html: "Se è bloccata o mostra un errore, disconnetta la connessione al broker Tradovate e poi la riconnetta una sola volta da quella scheda." },
        { title: "Scelga una sola superficie per gli ordini", html: "Non instradi ordini dello stesso account sia dall'app desktop di Tradovate sia da una scheda TradingView contemporaneamente. Decida quale sia la sua superficie per gli ordini nella sessione e tenga l'altra solo per i grafici." },
      ],
    },
    { type: "heading",text: "Risolvere le cause 4 e 5: sincronizzare l'orologio, attendere le riconnessioni, accedere una sola volta" },
    {
      type: "steps",
      items: [
        { title: "Smetta di inondare di riconnessioni", html: "Se ha appena fatto scattare DeviceQuotaReached o un 429, attenda invece di riprovare in loop. I tentativi rapidi prolungano il blocco invece di eliminarlo." },
        { title: "Sincronizzi l'orologio di sistema", html: "In Windows, apra le impostazioni di data e ora, attivi <strong class='text-white'>Set time automatically</strong> e faccia clic su <strong class='text-white'>Sync now</strong>. Un orologio anche solo leggermente fuori sincronia causa grafici bloccati e connessioni non riuscite che sembrano esattamente errori di sessione." },
        { title: "Elimini le sessioni obsolete", html: "Se sospetta una sessione fantasma dopo un arresto anomalo o una sospensione/riattivazione, chiuda completamente il browser o riavvii l'app desktop in modo che non resti registrata alcuna connessione orfana." },
        { title: "Acceda di nuovo su un solo dispositivo", html: "Con tutto il resto disconnesso, acceda di nuovo sulla singola superficie scelta. Dovrebbe riconnettersi in modo pulito e restare connesso." },
        { title: "Contatti il supporto se persiste", html: "Se DeviceQuotaReached persiste anche se è davvero su un solo dispositivo, contatti il supporto di Tradovate e chieda di cancellare le sessioni residue dell'account." },
      ],
    },
    { type: "heading",text: "Tabella di risoluzione dei problemi" },
    { type: "table", headers: ["Errore / sintomo","Che cosa significa","Soluzione"], rows: [
      ["DeviceQuotaReached","La quota di sessioni simultanee (dispositivi) dell'account è stata superata","Esca da ogni dispositivo e scheda TradingView in più, poi acceda su un solo dispositivo"],
      ["Disconnesso circa ogni 24 ore","Normale rinnovo di sessione di Tradovate, peggiorato dalla presenza di sessioni extra aperte","Mantenga una sola sessione; riaccede semplicemente su quel dispositivo"],
      ["\"Too Many Requests\" / HTTP 429 dopo la riconnessione","Accessi ripetuti rapidamente hanno consumato la quota oraria di richieste API","Smetta di riprovare, attenda la fine del periodo di attesa, poi acceda una sola volta"],
      ["Grafico bloccato o prezzi statici","Conflitto di sessioni, orologio non sincronizzato, connessione debole o mese di contratto scaduto","Sincronizzi l'orologio, usi una connessione stabile, verifichi il contratto del mese corrente e riduca a una sola sessione"],
      ["Espulso da un trade \"senza motivo\" da TradingView","Una seconda sessione ha sottratto alla prima l'unica connessione ai dati di mercato","Consolidi su una sola superficie connessa per quell'account"],
      ["Ancora disconnessioni su un solo dispositivo","Potrebbe esserci ancora una sessione \"fantasma\" obsoleta registrata sull'account","Riavvii l'app/il browser; se persiste, chieda al supporto di Tradovate di cancellare le vecchie sessioni"],
    ] },
    { type: "heading",text: "Lo prevenga con PickMyTrade" },
    { type: "paragraph",html: "DeviceQuotaReached si verifica perché una persona finisce per essere connessa da più posti contemporaneamente. Automatizzare l'esecuzione elimina gran parte di questa superficie. La sua strategia parte da un'unica connessione disciplinata invece di farle destreggiare l'app desktop, un telefono e tre schede di TradingView:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Connessione unica e disciplinata</strong>, PickMyTrade instrada i suoi alert di TradingView verso Tradovate attraverso un unico collegamento gestito, così non accumula sessioni manuali che fanno scattare la quota di dispositivi.",
        "<strong class='text-white'>Instradamento sicuro rispetto ai limiti di frequenza</strong>, il flusso degli ordini è distanziato per restare entro i limiti di richieste di Tradovate, evitando le tempeste di tentativi che degenerano in blocchi 429 &ldquo;Too Many Requests&rdquo;.",
        "<strong class='text-white'>Attenzione a autorizzazioni &amp; rischio</strong>, l'instradamento rispetta i limiti del suo account e lo stato dell'accordo sui dati, così gli ordini partono puliti invece di essere respinti.",
        "<strong class='text-white'>Sincronizzazione multi-account</strong>, replichi una strategia su più account da un unico bridge invece di aprire un accesso live separato per ciascuno.",
      ],
    },
    { type: "paragraph",html: "L'automazione non aumenta il limite di sessioni di Tradovate, ma fa sì che raramente serva più di una connessione aperta, ed è esattamente ciò che impedisce a DeviceQuotaReached di scattare." },
  ] },
  ctaHeading: { en: "Trade From One Clean Connection", de: "Handeln Sie über eine saubere Verbindung", es: "Opere desde una única conexión limpia", fr: "Tradez depuis une seule connexion propre", it: "Operi da una sola connessione pulita" },
  ctaText: { en: "Start your free 7-day trial, route your TradingView alerts through one clean connection and trade disconnect-free.", de: "Starten Sie Ihre kostenlose 7-Tage-Testphase, leiten Sie Ihre TradingView-Alerts über eine saubere Verbindung und handeln Sie ohne Verbindungsabbrüche.", es: "Comience su prueba gratuita de 7 días, dirija sus alertas de TradingView a través de una conexión limpia y opere sin desconexiones.", fr: "Commencez votre essai gratuit de 7 jours, acheminez vos alertes TradingView via une seule connexion propre et tradez sans déconnexion.", it: "Inizi la prova gratuita di 7 giorni, instradi i suoi alert di TradingView attraverso una sola connessione pulita e operi senza disconnessioni." },
  ctaButtonText: { en: "Start Your Free 7-Day Trial", de: "Starten Sie Ihre kostenlose 7-Tage-Testphase", es: "Comience su prueba gratuita de 7 días", fr: "Commencez votre essai gratuit de 7 jours", it: "Inizi la prova gratuita di 7 giorni" },
  ctaUrl: "https://app.pickmytrade.trade/?register=true&utm_source=content&utm_medium=debugging",
  faqHeading: { en: "Frequently Asked Questions", de: "Häufig gestellte Fragen", es: "Preguntas frecuentes", fr: "Questions fréquentes", it: "Domande frequenti" },
  faqs: { en: [
    { q: "What does DeviceQuotaReached mean on Tradovate?", a: "It means your account has more simultaneous sessions open than it's allowed, so Tradovate refused the extra connection. The device quota is the number of concurrent logins permitted across the desktop app, web trader, mobile, and TradingView." },
    { q: "How many sessions can I have open on Tradovate at once?", a: "Only a small number, commonly described as two active sessions across all of Tradovate's surfaces, with just one live market-data connection per account. In practice, treat it as one device at a time to stay clear of trouble." },
    { q: "Why does opening TradingView disconnect my Tradovate desktop app?", a: "Because both hold a session and the single market-data connection can only belong to one at a time. Opening a connected TradingView tab can pull that connection away from the desktop app, which then freezes or drops." },
    { q: "Does each TradingView tab really count as a separate session?", a: "Yes. Every TradingView browser tab connected to Tradovate is its own session, so a couple of extra watch tabs can eat your entire session budget before you place an order." },
    { q: "I keep getting logged out every 24 hours. Is that the same problem?", a: "The roughly 24-hour logout is Tradovate's routine session refresh, not a bug. It becomes disruptive when you also have extra sessions open, so consolidating to one login and simply signing back in usually settles it." },
    { q: "Why did I get Too Many Requests right after DeviceQuotaReached?", a: "Hammering the login button to reconnect burns through Tradovate's hourly API request allowance, which triggers a separate HTTP 429 cooldown on top of the session conflict. Stop retrying and wait it out." },
    { q: "My charts froze but I'm only on one device. What now?", a: "Frozen charts on a single session usually point to a clock that's out of sync, an unstable connection, or an expired contract month. Sync your system clock, move to a stable connection, and confirm you're on the current front-month contract." },
    { q: "DeviceQuotaReached won't clear even though I logged out everywhere. What should I do?", a: "A stale session can stay registered after a crash or sleep/wake. Restart the browser or desktop app to drop any orphaned connection, and if it still persists, contact Tradovate support to clear lingering sessions on the account." },
  ], de: [
    { q: "Was bedeutet DeviceQuotaReached bei Tradovate?", a: "Es bedeutet, dass in Ihrem Konto mehr gleichzeitige Sitzungen geöffnet sind als erlaubt, sodass Tradovate die zusätzliche Verbindung abgelehnt hat. Das Gerätekontingent ist die Anzahl der gleichzeitigen Anmeldungen, die über die Desktop-App, den Web-Trader, die mobile App und TradingView hinweg zulässig sind." },
    { q: "Wie viele Sitzungen kann ich bei Tradovate gleichzeitig geöffnet haben?", a: "Nur sehr wenige, üblicherweise werden zwei aktive Sitzungen über alle Tradovate-Oberflächen hinweg genannt, mit nur einer einzigen Live-Marktdatenverbindung pro Konto. In der Praxis sollten Sie immer nur ein Gerät gleichzeitig nutzen, um Probleme zu vermeiden." },
    { q: "Warum trennt das Öffnen von TradingView meine Tradovate-Desktop-App?", a: "Weil beide eine Sitzung belegen und die einzelne Marktdatenverbindung immer nur einem von beiden gehören kann. Ein verbundener TradingView-Tab kann diese Verbindung der Desktop-App entziehen, die dann einfriert oder die Verbindung verliert." },
    { q: "Zählt wirklich jeder TradingView-Tab als eigene Sitzung?", a: "Ja. Jeder mit Tradovate verbundene TradingView-Browser-Tab ist eine eigene Sitzung, sodass ein paar zusätzliche Beobachtungs-Tabs Ihr gesamtes Sitzungskontingent aufbrauchen können, bevor Sie überhaupt eine Order aufgeben." },
    { q: "Ich werde ständig alle 24 Stunden abgemeldet. Ist das dasselbe Problem?", a: "Die Abmeldung nach etwa 24 Stunden ist die routinemäßige Sitzungserneuerung von Tradovate und kein Fehler. Sie wird störend, wenn zusätzlich weitere Sitzungen geöffnet sind. Wenn Sie sich auf eine Anmeldung beschränken und sich einfach neu anmelden, ist das Problem meist erledigt." },
    { q: "Warum erhielt ich direkt nach DeviceQuotaReached die Meldung Too Many Requests?", a: "Wenn Sie wiederholt auf die Anmeldeschaltfläche klicken, um sich neu zu verbinden, verbrauchen Sie das stündliche API-Anfragekontingent von Tradovate. Das löst zusätzlich zum Sitzungskonflikt eine separate HTTP-429-Abkühlphase aus. Hören Sie auf, es erneut zu versuchen, und warten Sie ab." },
    { q: "Meine Charts sind eingefroren, aber ich nutze nur ein Gerät. Was nun?", a: "Eingefrorene Charts bei nur einer Sitzung deuten meist auf eine nicht synchronisierte Systemuhr, eine instabile Verbindung oder einen abgelaufenen Kontraktmonat hin. Synchronisieren Sie Ihre Systemuhr, wechseln Sie zu einer stabilen Verbindung und prüfen Sie, ob Sie auf dem aktuellen Front-Month-Kontrakt sind." },
    { q: "DeviceQuotaReached verschwindet nicht, obwohl ich mich überall abgemeldet habe. Was soll ich tun?", a: "Nach einem Absturz oder Ruhezustand/Aufwachen kann eine veraltete Sitzung registriert bleiben. Starten Sie den Browser oder die Desktop-App neu, um verwaiste Verbindungen zu beenden. Besteht das Problem weiter, wenden Sie sich an den Tradovate-Support, damit verbleibende Sitzungen im Konto gelöscht werden." },
  ], es: [
    { q: "¿Qué significa DeviceQuotaReached en Tradovate?", a: "Significa que su cuenta tiene abiertas más sesiones simultáneas de las permitidas, por lo que Tradovate rechazó la conexión adicional. La cuota de dispositivos es el número de inicios de sesión simultáneos permitidos entre la app de escritorio, el web trader, el móvil y TradingView." },
    { q: "¿Cuántas sesiones puedo tener abiertas en Tradovate a la vez?", a: "Solo unas pocas; suele describirse como dos sesiones activas en todas las superficies de Tradovate, con una única conexión de datos de mercado en vivo por cuenta. En la práctica, considere que solo debe usar un dispositivo a la vez para evitar problemas." },
    { q: "¿Por qué abrir TradingView desconecta mi app de escritorio de Tradovate?", a: "Porque ambos mantienen una sesión y la única conexión de datos de mercado solo puede pertenecer a uno a la vez. Abrir una pestaña de TradingView conectada puede quitarle esa conexión a la app de escritorio, que entonces se congela o se cae." },
    { q: "¿Cada pestaña de TradingView cuenta realmente como una sesión distinta?", a: "Sí. Cada pestaña del navegador de TradingView conectada a Tradovate es su propia sesión, así que un par de pestañas extra de seguimiento pueden agotar todo su presupuesto de sesiones antes de que envíe una sola orden." },
    { q: "Me cierran la sesión cada 24 horas. ¿Es el mismo problema?", a: "El cierre de sesión de unas 24 horas es la renovación rutinaria de sesión de Tradovate, no un error. Resulta molesto cuando además tiene sesiones adicionales abiertas, así que consolidar en un solo inicio de sesión y volver a entrar suele resolverlo." },
    { q: "¿Por qué recibí Too Many Requests justo después de DeviceQuotaReached?", a: "Pulsar repetidamente el botón de inicio de sesión para reconectar consume la cuota horaria de solicitudes de API de Tradovate, lo que activa un enfriamiento HTTP 429 independiente además del conflicto de sesiones. Deje de reintentar y espere." },
    { q: "Mis gráficos se congelaron pero solo uso un dispositivo. ¿Qué hago?", a: "Los gráficos congelados con una sola sesión suelen indicar un reloj desincronizado, una conexión inestable o un mes de contrato vencido. Sincronice el reloj del sistema, use una conexión estable y confirme que está en el contrato del mes más cercano vigente." },
    { q: "DeviceQuotaReached no desaparece aunque cerré sesión en todas partes. ¿Qué debo hacer?", a: "Una sesión obsoleta puede seguir registrada tras un fallo o una suspensión/reactivación. Reinicie el navegador o la app de escritorio para descartar cualquier conexión huérfana y, si persiste, contacte con el soporte de Tradovate para que eliminen las sesiones residuales de la cuenta." },
  ], fr: [
    { q: "Que signifie DeviceQuotaReached sur Tradovate ?", a: "Cela signifie que votre compte a plus de sessions simultanées ouvertes que ce qui est autorisé, et Tradovate a donc refusé la connexion supplémentaire. Le quota d'appareils correspond au nombre de connexions simultanées autorisées entre l'application de bureau, le web trader, le mobile et TradingView." },
