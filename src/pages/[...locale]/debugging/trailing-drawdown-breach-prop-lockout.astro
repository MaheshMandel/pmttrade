---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "trailing-drawdown-breach-prop-lockout";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/debugging/${SLUG}`;

const META_TITLE = "Tradovate Trailing Drawdown Breach = Prop Lockout";
const META_DESCRIPTION =
  "Tradovate trailing drawdown breach locking your prop account? Monitor your drawdown column, keep a buffer, and stop auto-liquidation before it hits.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Tradovate Trailing Drawdown überschritten = Prop-Sperre", es: "Superar el trailing drawdown en Tradovate = bloqueo de la cuenta prop", fr: "Dépassement du trailing drawdown sur Tradovate = blocage du compte prop", it: "Superamento del trailing drawdown su Tradovate = blocco dell'account prop" },
  dek: { en: "The trailing drawdown floor climbs with every new high and never resets down. One ordinary pullback later, your account is Liquidation Only and the evaluation reads failed. Here's how to see the floor before you hit it.", de: "Die Trailing-Drawdown-Grenze steigt mit jedem neuen Hoch und fällt nie wieder zurück. Ein ganz normaler Rücksetzer später steht Ihr Konto auf Liquidation Only und die Evaluierung gilt als gescheitert. So sehen Sie die Grenze, bevor Sie sie erreichen.", es: "El suelo del trailing drawdown sube con cada nuevo máximo y nunca baja. Tras un retroceso normal, su cuenta pasa a Liquidation Only y la evaluación figura como fallida. Cómo ver el suelo antes de alcanzarlo.", fr: "Le plancher du trailing drawdown monte à chaque nouveau sommet et ne redescend jamais. Après un repli ordinaire, votre compte passe en Liquidation Only et l'évaluation est marquée comme échouée. Comment voir le plancher avant de l'atteindre.", it: "Il pavimento del trailing drawdown sale a ogni nuovo massimo e non torna mai indietro. Dopo un normale ritracciamento, il Suo account passa a Liquidation Only e la valutazione risulta fallita. Come vedere il pavimento prima di raggiungerlo." },
  readTime: { en: "8 min read", de: "8 Min. Lesezeit", es: "Lectura de 8 min", fr: "Lecture : 8 min", it: "Lettura di 8 min" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "One good session pushes your prop balance to a fresh high, and quietly, the Tradovate trailing drawdown floor climbs up right behind it. One ordinary pullback later, the account flips to <strong class='text-white'>Liquidation Only</strong>, your positions get flattened, and the evaluation reads <em>failed</em>. No appeal, no trading your way back into it. A trailing drawdown breach is one of the most common, and most expensive, ways funded and evaluation traders lose an account, precisely because the limit moves in real time and only ever travels one direction. Here's what the breach actually means, why it catches so many people, how to watch it live inside Tradovate, and how automation like PickMyTrade helps you trade inside the limit instead of face-planting into it." },
    {
      type: "checklist",
      heading: "Quick Checklist for a Trailing Drawdown Breach",
      items: [
        "<strong class='text-white'>Add the drawdown column to your Accounts module.</strong> Surface the <em>Dis Drawdown Net Liq</em> column so you can see exactly how much room you have before the floor.",
        "<strong class='text-white'>Check it before every entry.</strong> The trailing floor moves up with your peak, so yesterday's buffer is not today's buffer.",
        "<strong class='text-white'>Keep a deliberate cushion.</strong> Never trade right up against the auto-liquidation threshold. A normal wick can trip it.",
        "<strong class='text-white'>Know your drawdown type.</strong> End-of-Day trailing and Real-Time trailing behave very differently. Confirm which one your firm uses.",
        "<strong class='text-white'>Remember it counts unrealized P&amp;L.</strong> On real-time accounts, open-trade drawdown can breach you before you ever close.",
        "<strong class='text-white'>Assume no recovery.</strong> Once the trailing limit is hit, a prop evaluation typically fails for good. There's no &ldquo;trade it back.&rdquo;",
      ],
    },
    { type: "heading", text: "What a Trailing Drawdown Breach Means (the “Liquidation Only” Lockout)" },
    { type: "paragraph", html: "A <strong class='text-white'>trailing maximum drawdown</strong> is a dynamic loss limit that follows your account's highest balance, the high-water mark, upward, but never resets back down. When your balance makes a new peak, the drawdown floor rises with it. When your balance falls, the floor stays put. The moment your account value touches that floor, you've breached the trailing drawdown, and Tradovate drops the account into <strong class='text-white'>Liquidation Only</strong> status: open positions are closed, working orders are canceled, and you can't open anything new." },
    { type: "paragraph", html: "That &ldquo;Liquidation Only&rdquo; state is the same lockout Tradovate uses whenever any hard risk limit is reached, but the consequence in a prop context is heavier. For a normal daily or weekly loss limit, liquidation-only clears at the start of the next session or week. A trailing <strong class='text-white'>max drawdown</strong> breach on a prop evaluation is a different animal: it's the firm's pass/fail line. Hitting it is treated as blowing the account, and there's no waiting it out. You'd need to reset or repurchase the evaluation." },
    { type: "paragraph", html: "The reason so many traders get caught is that the floor is invisible unless you deliberately surface it. Your balance can look perfectly healthy while you're sitting only a few ticks above the auto-liquidation threshold, because that threshold quietly ratcheted up during your last winning run. Knowing <em>where</em> the floor is right now, not where it was this morning, is the whole game." },
    { type: "heading", text: "Top Causes of a Tradovate Trailing Drawdown Breach" },
    { type: "heading", text: "1. The Floor Trailed Up After a Winning Run" },
    { type: "paragraph", html: "This is the classic trap. On a real-time trailing account, the drawdown floor follows your intraday peak. Say your limit is a fixed dollar amount below your high (actual amounts vary by firm and account size, so check your firm's current rules). Your balance climbs, then gives some back. The floor is now measured from that new high, so a &ldquo;small&rdquo; retrace can breach you even though you're still up on the day." },
    { type: "heading", text: "2. Unrealized (Open-Trade) Drawdown Counted Against You" },
    { type: "paragraph", html: "On real-time trailing accounts, the drawdown is calculated on your net liquidation value, which <strong class='text-white'>includes open-position P&amp;L</strong>. So you don't have to close a losing trade to breach. A deep enough adverse excursion while the trade is still open can trip the auto-liquidation threshold on its own. Traders who only watch <em>closed</em> P&amp;L never see it coming." },
    { type: "heading", text: "3. You Weren't Watching the Drawdown Column" },
    { type: "paragraph", html: "Tradovate doesn't pop a warning as you approach the floor. If you haven't added the <em>Dis Drawdown Net Liq</em> column (or your firm's equivalent) to the Accounts module, you're trading blind to the one number that can fail your account." },
    { type: "heading", text: "4. Confusing End-of-Day Trailing with Real-Time Trailing" },
    { type: "paragraph", html: "Some firms set an <strong class='text-white'>End-of-Day Trailing Max Drawdown</strong>, where the floor only advances based on your closing balance and stops climbing once it reaches your starting balance. Others use <strong class='text-white'>Real-Time Trailing Max Drawdown</strong>, which follows your live intraday peak. Assume EOD behavior on a real-time account and you'll misjudge your buffer by a wide margin." },
    { type: "heading", text: "5. Trading Size That Leaves No Cushion" },
    { type: "paragraph", html: "Oversized positions relative to your remaining drawdown mean a routine adverse tick can cover the entire distance to the floor. Position size and the trailing limit are joined at the hip: the closer you are to the floor, the smaller your size has to be to survive normal noise." },
    { type: "heading", text: "How to Fix and Prevent a Trailing Drawdown Breach: Step-by-Step" },
    { type: "paragraph", html: "You can't &ldquo;undo&rdquo; a breach after it happens, so the fix is really prevention: make the invisible floor visible, then trade with a buffer. Here's the workflow." },
    { type: "heading", text: "Surface Your Live Drawdown in the Accounts Module" },
    {
      type: "list",
      items: [
        "Click the <strong class='text-white'>plus (+)</strong> button at the top-left of Tradovate to open the modules menu, and add the <strong class='text-white'>Accounts</strong> module (widget) to your workspace.",
        "Click the <strong class='text-white'>View Settings (cog/gear)</strong> icon at the top-right of the Accounts module, then choose <strong class='text-white'>Select Columns</strong>.",
        "In the column picker, drag the trailing-drawdown column, commonly labeled <strong class='text-white'>Dis Drawdown Net Liq</strong> (how much you can lose before hitting the trailing drawdown), from <em>Available</em> over to <em>Visible</em>.",
        "Click <strong class='text-white'>Save</strong>. The column now shows, in real time, your remaining distance to the auto-liquidation threshold.",
      ],
    },
    { type: "heading", text: "Confirm Your Drawdown Type and Threshold" },
    {
      type: "list",
      items: [
        "Open <strong class='text-white'>Application Settings</strong> (top-right) and go to <strong class='text-white'>Risk Settings</strong>.",
        "Check whether your account uses <strong class='text-white'>End-of-Day Trailing Max Drawdown</strong> or <strong class='text-white'>Real-Time Trailing Max Drawdown</strong>. This decides whether unrealized P&amp;L can breach you intraday.",
        "Note the auto-liquidation threshold. Quick way to sanity-check it: <strong class='text-white'>Account Value &minus; Trailing Max Drawdown = Auto-Liquidation Threshold</strong>. If your net liq drops to that number, the account locks.",
      ],
    },
    { type: "heading", text: "Trade With a Hard Buffer" },
    {
      type: "list",
      items: [
        "Decide a personal &ldquo;stop trading&rdquo; cushion above the floor (for example, keep a fixed distance showing in the <em>Dis Drawdown Net Liq</em> column) and treat it like a wall.",
        "Size positions so a normal adverse excursion can't cover the distance from your current price to the auto-liquidation threshold.",
        "If your firm allows it, set a <strong class='text-white'>Daily Loss Limit</strong> in Risk Settings that trips <em>before</em> the trailing floor, so you get flattened on your terms instead of blowing the evaluation.",
      ],
    },
    { type: "heading", text: "Watch the Peak, Not the Balance" },
    { type: "paragraph", html: "Because the floor is anchored to your highest balance, your usable room shrinks every time you set a new high and then give some back. Re-check the drawdown column after every strong push, not just at the open." },
    { type: "heading", text: "Troubleshooting Table" },
    {
      type: "table",
      headers: ["What you see", "What it means", "What to do"],
      rows: [
        ["Account flips to Liquidation Only", "A hard risk limit (loss limit or trailing drawdown) was reached; positions are flattened and new orders are blocked", "For a daily/weekly limit, wait for the next session/week; for a trailing max drawdown breach on a prop eval, the account has failed"],
        ["Dis Drawdown Net Liq near zero", "You're almost at the auto-liquidation threshold", "Stop adding size, reduce exposure, and give the floor room"],
        ["Balance is up but you still breached", "Real-time floor trailed your intraday peak; you gave back enough from the high", "Trade smaller after new highs; the floor moves with your peak"],
        ["Breached while the trade was still open", "Unrealized P&amp;L counted against your net liq", "On real-time accounts, manage open-trade drawdown, not just closed P&amp;L"],
        ["Floor never seems to rise", "You're on End-of-Day trailing, and/or balance is above starting balance so it stopped climbing", "Confirm your drawdown type in Risk Settings"],
        ["Evaluation shows failed after a small loss", "Trailing floor had ratcheted up on prior wins", "Rebuild the habit of checking the drawdown column before every entry"],
      ],
    },
    { type: "heading", text: "Prevent This with PickMyTrade" },
    { type: "paragraph", html: "PickMyTrade links your TradingView alerts straight to Tradovate, which means the discipline that keeps you off the trailing floor can be enforced by your automation instead of your nerves:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Qty / Symbol Validation</strong> caps the contract quantity on every routed order, so a fat-fingered or oversized entry never eats your remaining drawdown.",
        "<strong class='text-white'>Risk-Aware Routing</strong> respects the position and risk limits you set, so alerts that would push you past your buffer get held back.",
        "<strong class='text-white'>Rate-Limit-Safe Order Flow</strong> spaces out orders so nothing bounces or double-fires during fast markets, keeping your fills predictable.",
        "<strong class='text-white'>Multi-Account Sync</strong> mirrors the same disciplined, size-controlled order across accounts, so one workspace doesn't quietly breach while another looks fine.",
      ],
    },
    { type: "paragraph", html: "The point isn't that automation watches the trailing floor for you; you still monitor the <em>Dis Drawdown Net Liq</em> column yourself. It's that consistent, rule-bound execution is what keeps you comfortably above it." },
  ], de: [
    { type: "paragraph",html: "Eine gute Sitzung schiebt Ihren Prop-Kontostand auf ein frisches Hoch, und still und leise steigt die Tradovate-Trailing-Drawdown-Grenze direkt dahinter mit. Ein gewöhnlicher Rücksetzer später kippt das Konto auf <strong class='text-white'>Liquidation Only</strong>, Ihre Positionen werden glattgestellt und die Evaluierung gilt als <em>gescheitert</em>. Kein Einspruch, kein Zurückhandeln. Eine Verletzung des Trailing Drawdown ist eine der häufigsten und teuersten Arten, wie Funded- und Evaluierungs-Trader ein Konto verlieren, gerade weil sich das Limit in Echtzeit bewegt und nur in eine Richtung wandert. Hier erfahren Sie, was die Verletzung tatsächlich bedeutet, warum sie so viele überrascht, wie Sie sie live in Tradovate beobachten und wie Automatisierung wie PickMyTrade Ihnen hilft, innerhalb des Limits zu handeln, statt kopfüber hineinzulaufen." },
    {
      type: "checklist",
      heading: "Kurze Checkliste zum Trailing Drawdown",
      items: [
        "<strong class='text-white'>Fügen Sie die Drawdown-Spalte Ihrem Modul Accounts hinzu.</strong> Blenden Sie die Spalte <em>Dis Drawdown Net Liq</em> ein, damit Sie genau sehen, wie viel Spielraum Sie bis zur Grenze haben.",
        "<strong class='text-white'>Prüfen Sie sie vor jedem Einstieg.</strong> Die Trailing-Grenze steigt mit Ihrem Hoch, der gestrige Puffer ist also nicht der heutige Puffer.",
        "<strong class='text-white'>Halten Sie bewusst ein Polster.</strong> Handeln Sie nie direkt an der Schwelle zur automatischen Liquidation. Ein normaler Docht kann sie auslösen.",
        "<strong class='text-white'>Kennen Sie Ihren Drawdown-Typ.</strong> End-of-Day-Trailing und Echtzeit-Trailing verhalten sich sehr unterschiedlich. Bestätigen Sie, welches Ihre Firma verwendet.",
        "<strong class='text-white'>Denken Sie daran, dass auch nicht realisierte P&amp;L zählt.</strong> Bei Echtzeit-Konten kann der Drawdown offener Trades Sie verletzen, bevor Sie überhaupt schließen.",
        "<strong class='text-white'>Gehen Sie von keiner Erholung aus.</strong> Sobald das Trailing-Limit erreicht ist, scheitert eine Prop-Evaluierung in der Regel endgültig. Es gibt kein &ldquo;Zurückhandeln&rdquo;.",
      ],
    },
    { type: "heading",text: "Was eine Verletzung des Trailing Drawdown bedeutet (die „Liquidation Only“-Sperre)" },
    { type: "paragraph",html: "Ein <strong class='text-white'>Trailing Maximum Drawdown</strong> ist ein dynamisches Verlustlimit, das dem höchsten Kontostand Ihres Kontos, dem High-Water-Mark, nach oben folgt, aber nie wieder nach unten zurückgesetzt wird. Erreicht Ihr Kontostand ein neues Hoch, steigt die Drawdown-Grenze mit. Fällt Ihr Kontostand, bleibt die Grenze, wo sie ist. In dem Moment, in dem Ihr Kontowert diese Grenze berührt, haben Sie den Trailing Drawdown verletzt, und Tradovate versetzt das Konto in den Status <strong class='text-white'>Liquidation Only</strong>: Offene Positionen werden geschlossen, aktive Orders storniert, und Sie können nichts Neues eröffnen." },
    { type: "paragraph",html: "Dieser Zustand &ldquo;Liquidation Only&rdquo; ist dieselbe Sperre, die Tradovate verwendet, wann immer ein hartes Risikolimit erreicht wird, doch im Prop-Kontext sind die Folgen schwerwiegender. Bei einem normalen Tages- oder Wochenverlustlimit wird Liquidation Only zu Beginn der nächsten Sitzung oder Woche aufgehoben. Eine Verletzung des Trailing <strong class='text-white'>Max Drawdown</strong> bei einer Prop-Evaluierung ist etwas ganz anderes: Es ist die Bestanden/Nicht-bestanden-Linie der Firma. Sie zu erreichen gilt als Verlust des Kontos, und es gibt kein Abwarten. Sie müssten die Evaluierung zurücksetzen oder erneut kaufen." },
    { type: "paragraph",html: "Der Grund, warum so viele Trader hineintappen, ist, dass die Grenze unsichtbar bleibt, solange Sie sie nicht bewusst einblenden. Ihr Kontostand kann völlig gesund aussehen, während Sie nur wenige Ticks über der Schwelle zur automatischen Liquidation stehen, weil diese Schwelle während Ihrer letzten Gewinnserie unbemerkt nach oben gerastet ist. Zu wissen, <em>wo</em> die Grenze gerade jetzt liegt und nicht, wo sie heute Morgen lag, ist das ganze Spiel." },
    { type: "heading",text: "Hauptursachen für eine Verletzung des Tradovate Trailing Drawdown" },
    { type: "heading",text: "1. Die Grenze ist nach einer Gewinnserie mitgestiegen" },
    { type: "paragraph",html: "Das ist die klassische Falle. Bei einem Echtzeit-Trailing-Konto folgt die Drawdown-Grenze Ihrem Tageshoch. Angenommen, Ihr Limit ist ein fester Dollarbetrag unter Ihrem Hoch (die tatsächlichen Beträge variieren je nach Firma und Kontogröße, prüfen Sie daher die aktuellen Regeln Ihrer Firma). Ihr Kontostand steigt und gibt dann etwas wieder ab. Die Grenze wird nun von diesem neuen Hoch aus gemessen, sodass ein &ldquo;kleiner&rdquo; Rücksetzer Sie verletzen kann, obwohl Sie am Tag noch im Plus sind." },
    { type: "heading",text: "2. Nicht realisierter Drawdown (offener Trade) wird gegen Sie gezählt" },
    { type: "paragraph",html: "Bei Echtzeit-Trailing-Konten wird der Drawdown auf Basis Ihres Nettoliquidationswerts berechnet, der <strong class='text-white'>die P&amp;L offener Positionen einschließt</strong>. Sie müssen also keinen Verlusttrade schließen, um die Grenze zu verletzen. Eine ausreichend tiefe ungünstige Auslenkung bei noch offenem Trade kann die Schwelle zur automatischen Liquidation allein auslösen. Trader, die nur auf die <em>geschlossene</em> P&amp;L schauen, sehen es nie kommen." },
    { type: "heading",text: "3. Sie haben die Drawdown-Spalte nicht beobachtet" },
    { type: "paragraph",html: "Tradovate blendet keine Warnung ein, wenn Sie sich der Grenze nähern. Wenn Sie die Spalte <em>Dis Drawdown Net Liq</em> (oder das Äquivalent Ihrer Firma) nicht zum Modul Accounts hinzugefügt haben, handeln Sie blind gegenüber der einen Zahl, die Ihr Konto scheitern lassen kann." },
    { type: "heading",text: "4. End-of-Day-Trailing mit Echtzeit-Trailing verwechselt" },
    { type: "paragraph",html: "Manche Firmen setzen einen <strong class='text-white'>End-of-Day Trailing Max Drawdown</strong>, bei dem die Grenze nur anhand Ihres Schlusskontostands nachrückt und nicht weiter steigt, sobald sie Ihren Startkontostand erreicht. Andere verwenden einen <strong class='text-white'>Real-Time Trailing Max Drawdown</strong>, der Ihrem aktuellen Tageshoch folgt. Wenn Sie bei einem Echtzeit-Konto von EOD-Verhalten ausgehen, schätzen Sie Ihren Puffer um ein Vielfaches falsch ein." },
    { type: "heading",text: "5. Positionsgrößen, die kein Polster lassen" },
    { type: "paragraph",html: "Übergroße Positionen im Verhältnis zu Ihrem verbleibenden Drawdown bedeuten, dass ein gewöhnlicher ungünstiger Tick den gesamten Abstand zur Grenze überbrücken kann. Positionsgröße und Trailing-Limit sind untrennbar verbunden: Je näher Sie an der Grenze sind, desto kleiner muss Ihre Größe sein, um das normale Rauschen zu überstehen." },
    { type: "heading",text: "So beheben und verhindern Sie eine Verletzung des Trailing Drawdown: Schritt für Schritt" },
    { type: "paragraph",html: "Sie können eine Verletzung nach dem Eintreten nicht &ldquo;rückgängig&rdquo; machen, die Lösung ist also im Grunde Prävention: die unsichtbare Grenze sichtbar machen und dann mit Puffer handeln. Hier ist der Ablauf." },
    { type: "heading",text: "Blenden Sie Ihren Live-Drawdown im Modul Accounts ein" },
    {
      type: "list",
      items: [
        "Klicken Sie oben links in Tradovate auf die Schaltfläche <strong class='text-white'>Plus (+)</strong>, um das Modulmenü zu öffnen, und fügen Sie das Modul (Widget) <strong class='text-white'>Accounts</strong> Ihrem Workspace hinzu.",
        "Klicken Sie oben rechts im Modul Accounts auf das Symbol <strong class='text-white'>View Settings (Zahnrad)</strong> und wählen Sie dann <strong class='text-white'>Select Columns</strong>.",
        "Ziehen Sie im Spaltenwähler die Trailing-Drawdown-Spalte, üblicherweise als <strong class='text-white'>Dis Drawdown Net Liq</strong> bezeichnet (wie viel Sie verlieren können, bevor Sie den Trailing Drawdown erreichen), von <em>Available</em> nach <em>Visible</em>.",
        "Klicken Sie auf <strong class='text-white'>Save</strong>. Die Spalte zeigt nun in Echtzeit Ihren verbleibenden Abstand zur Schwelle der automatischen Liquidation.",
      ],
    },
    { type: "heading",text: "Bestätigen Sie Ihren Drawdown-Typ und Ihre Schwelle" },
    {
      type: "list",
      items: [
        "Öffnen Sie <strong class='text-white'>Application Settings</strong> (oben rechts) und gehen Sie zu <strong class='text-white'>Risk Settings</strong>.",
        "Prüfen Sie, ob Ihr Konto <strong class='text-white'>End-of-Day Trailing Max Drawdown</strong> oder <strong class='text-white'>Real-Time Trailing Max Drawdown</strong> verwendet. Das entscheidet, ob nicht realisierte P&amp;L Sie intraday verletzen kann.",
        "Notieren Sie die Schwelle der automatischen Liquidation. Schnelle Plausibilitätsprüfung: <strong class='text-white'>Account Value &minus; Trailing Max Drawdown = Auto-Liquidation Threshold</strong>. Fällt Ihr Net Liq auf diesen Wert, wird das Konto gesperrt.",
      ],
    },
    { type: "heading",text: "Handeln Sie mit einem festen Puffer" },
    {
      type: "list",
      items: [
        "Legen Sie ein persönliches &ldquo;Stop-Trading&rdquo;-Polster oberhalb der Grenze fest (zum Beispiel einen festen Abstand, der in der Spalte <em>Dis Drawdown Net Liq</em> angezeigt wird) und behandeln Sie es wie eine Mauer.",
        "Dimensionieren Sie Positionen so, dass eine normale ungünstige Auslenkung nicht den Abstand von Ihrem aktuellen Kurs bis zur Schwelle der automatischen Liquidation überbrücken kann.",
        "Wenn Ihre Firma es erlaubt, setzen Sie in den Risk Settings ein <strong class='text-white'>Daily Loss Limit</strong>, das <em>vor</em> der Trailing-Grenze greift, damit Sie zu Ihren Bedingungen glattgestellt werden, statt die Evaluierung zu verlieren.",
      ],
    },
    { type: "heading",text: "Beobachten Sie das Hoch, nicht den Kontostand" },
    { type: "paragraph",html: "Da die Grenze an Ihrem höchsten Kontostand verankert ist, schrumpft Ihr nutzbarer Spielraum jedes Mal, wenn Sie ein neues Hoch setzen und dann etwas abgeben. Prüfen Sie die Drawdown-Spalte nach jedem starken Schub erneut, nicht nur zur Eröffnung." },
    { type: "heading",text: "Tabelle zur Fehlerbehebung" },
    { type: "table", headers: ["Was Sie sehen","Was es bedeutet","Was zu tun ist"], rows: [
      ["Konto wechselt zu Liquidation Only","Ein hartes Risikolimit (Verlustlimit oder Trailing Drawdown) wurde erreicht; Positionen werden glattgestellt und neue Orders blockiert","Bei einem Tages-/Wochenlimit auf die nächste Sitzung/Woche warten; bei einer Verletzung des Trailing Max Drawdown in einer Prop-Evaluierung ist das Konto gescheitert"],
      ["Dis Drawdown Net Liq nahe null","Sie sind fast an der Schwelle zur automatischen Liquidation","Keine Größe mehr hinzufügen, Exposure reduzieren und der Grenze Raum geben"],
      ["Kontostand im Plus, aber trotzdem verletzt","Die Echtzeit-Grenze folgte Ihrem Tageshoch; Sie haben vom Hoch genug abgegeben","Nach neuen Hochs kleiner handeln; die Grenze bewegt sich mit Ihrem Hoch"],
      ["Verletzt, während der Trade noch offen war","Nicht realisierte P&amp;L wurde auf Ihr Net Liq angerechnet","Bei Echtzeit-Konten den Drawdown offener Trades steuern, nicht nur die geschlossene P&amp;L"],
      ["Die Grenze scheint nie zu steigen","Sie nutzen End-of-Day-Trailing und/oder der Kontostand liegt über dem Startkontostand, sodass sie nicht weiter stieg","Ihren Drawdown-Typ in den Risk Settings bestätigen"],
      ["Evaluierung nach einem kleinen Verlust als gescheitert angezeigt","Die Trailing-Grenze war durch frühere Gewinne nach oben gerastet","Die Gewohnheit wieder aufbauen, vor jedem Einstieg die Drawdown-Spalte zu prüfen"],
    ] },
    { type: "heading",text: "Verhindern Sie das mit PickMyTrade" },
    { type: "paragraph",html: "PickMyTrade verknüpft Ihre TradingView-Alerts direkt mit Tradovate, sodass die Disziplin, die Sie von der Trailing-Grenze fernhält, von Ihrer Automatisierung statt von Ihren Nerven durchgesetzt werden kann:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Qty / Symbol Validation</strong> begrenzt die Kontraktmenge jeder weitergeleiteten Order, sodass ein vertippter oder überdimensionierter Einstieg nie Ihren verbleibenden Drawdown auffrisst.",
        "<strong class='text-white'>Risk-Aware Routing</strong> respektiert die von Ihnen gesetzten Positions- und Risikolimits, sodass Alerts, die Sie über Ihren Puffer hinausdrängen würden, zurückgehalten werden.",
        "<strong class='text-white'>Rate-Limit-Safe Order Flow</strong> staffelt Orders zeitlich, damit in schnellen Märkten nichts abprallt oder doppelt ausgelöst wird und Ihre Ausführungen vorhersehbar bleiben.",
        "<strong class='text-white'>Multi-Account Sync</strong> spiegelt dieselbe disziplinierte, größenkontrollierte Order über Konten hinweg, sodass nicht ein Workspace unbemerkt die Grenze verletzt, während ein anderer in Ordnung aussieht.",
      ],
    },
    { type: "paragraph",html: "Es geht nicht darum, dass die Automatisierung die Trailing-Grenze für Sie überwacht; die Spalte <em>Dis Drawdown Net Liq</em> beobachten Sie weiterhin selbst. Es geht darum, dass eine konsistente, regelgebundene Ausführung Sie sicher oberhalb davon hält." },
  ], es: [
    { type: "paragraph",html: "Una buena sesión lleva el saldo de su cuenta prop a un nuevo máximo y, discretamente, el suelo del trailing drawdown de Tradovate sube justo detrás. Un retroceso normal después, la cuenta pasa a <strong class='text-white'>Liquidation Only</strong>, sus posiciones se cierran y la evaluación figura como <em>fallida</em>. Sin apelación, sin posibilidad de recuperarla operando. Superar el trailing drawdown es una de las formas más comunes, y más caras, en que los traders financiados y en evaluación pierden una cuenta, precisamente porque el límite se mueve en tiempo real y solo viaja en una dirección. Aquí le explicamos qué significa realmente la infracción, por qué sorprende a tanta gente, cómo vigilarla en directo dentro de Tradovate y cómo una automatización como PickMyTrade le ayuda a operar dentro del límite en lugar de estrellarse contra él." },
    {
      type: "checklist",
      heading: "Lista de comprobación rápida sobre el trailing drawdown",
      items: [
        "<strong class='text-white'>Añada la columna de drawdown a su módulo Accounts.</strong> Muestre la columna <em>Dis Drawdown Net Liq</em> para ver exactamente cuánto margen tiene hasta el suelo.",
        "<strong class='text-white'>Revíselo antes de cada entrada.</strong> El suelo del trailing sube con su máximo, así que el colchón de ayer no es el de hoy.",
        "<strong class='text-white'>Mantenga un margen deliberado.</strong> No opere nunca pegado al umbral de autoliquidación. Una mecha normal puede activarlo.",
        "<strong class='text-white'>Conozca su tipo de drawdown.</strong> El trailing de fin de día y el de tiempo real se comportan de forma muy distinta. Confirme cuál utiliza su firma.",
        "<strong class='text-white'>Recuerde que cuenta el P&amp;L no realizado.</strong> En cuentas en tiempo real, el drawdown de las operaciones abiertas puede superarlo antes de que cierre nada.",
        "<strong class='text-white'>Dé por hecho que no hay recuperación.</strong> Una vez alcanzado el límite del trailing, una evaluación prop suele fallar definitivamente. No existe &ldquo;recuperarlo operando&rdquo;.",
      ],
    },
    { type: "heading",text: "Qué significa superar el trailing drawdown (el bloqueo “Liquidation Only”)" },
    { type: "paragraph",html: "Un <strong class='text-white'>trailing maximum drawdown</strong> es un límite de pérdida dinámico que sigue hacia arriba el saldo más alto de su cuenta, el high-water mark, pero nunca vuelve a bajar. Cuando su saldo marca un nuevo máximo, el suelo del drawdown sube con él. Cuando su saldo cae, el suelo se queda donde está. En el momento en que el valor de su cuenta toca ese suelo, ha superado el trailing drawdown y Tradovate pone la cuenta en estado <strong class='text-white'>Liquidation Only</strong>: las posiciones abiertas se cierran, las órdenes pendientes se cancelan y no puede abrir nada nuevo." },
    { type: "paragraph",html: "Ese estado &ldquo;Liquidation Only&rdquo; es el mismo bloqueo que utiliza Tradovate siempre que se alcanza cualquier límite de riesgo estricto, pero en el contexto prop la consecuencia es más grave. Con un límite de pérdida diario o semanal normal, Liquidation Only se levanta al comienzo de la siguiente sesión o semana. Superar el <strong class='text-white'>max drawdown</strong> con trailing en una evaluación prop es otra cosa: es la línea de aprobado o suspenso de la firma. Alcanzarla se considera haber perdido la cuenta y no hay que esperar a que pase. Tendría que restablecer o volver a comprar la evaluación." },
    { type: "paragraph",html: "La razón por la que tantos traders caen es que el suelo es invisible a menos que lo muestre deliberadamente. Su saldo puede parecer perfectamente sano mientras está solo a unos pocos ticks por encima del umbral de autoliquidación, porque ese umbral subió silenciosamente durante su última racha ganadora. Saber <em>dónde</em> está el suelo ahora mismo, y no dónde estaba esta mañana, es todo el juego." },
    { type: "heading",text: "Principales causas de superar el trailing drawdown en Tradovate" },
    { type: "heading",text: "1. El suelo subió tras una racha ganadora" },
    { type: "paragraph",html: "Es la trampa clásica. En una cuenta con trailing en tiempo real, el suelo del drawdown sigue su máximo intradía. Supongamos que su límite es un importe fijo en dólares por debajo de su máximo (los importes reales varían según la firma y el tamaño de la cuenta, así que consulte las reglas vigentes de su firma). Su saldo sube y luego devuelve algo. El suelo se mide ahora desde ese nuevo máximo, por lo que un retroceso &ldquo;pequeño&rdquo; puede hacerle superarlo aunque siga en positivo en el día." },
    { type: "heading",text: "2. El drawdown no realizado (de la operación abierta) cuenta en su contra" },
    { type: "paragraph",html: "En las cuentas con trailing en tiempo real, el drawdown se calcula sobre el valor de liquidación neto, que <strong class='text-white'>incluye el P&amp;L de las posiciones abiertas</strong>. Por tanto, no tiene que cerrar una operación perdedora para superarlo. Una excursión adversa lo bastante profunda con la operación aún abierta puede activar por sí sola el umbral de autoliquidación. Los traders que solo miran el P&amp;L <em>cerrado</em> nunca lo ven venir." },
    { type: "heading",text: "3. No estaba vigilando la columna de drawdown" },
    { type: "paragraph",html: "Tradovate no muestra ninguna advertencia a medida que se acerca al suelo. Si no ha añadido la columna <em>Dis Drawdown Net Liq</em> (o el equivalente de su firma) al módulo Accounts, está operando a ciegas respecto al único número que puede hacer fallar su cuenta." },
    { type: "heading",text: "4. Confundir el trailing de fin de día con el de tiempo real" },
    { type: "paragraph",html: "Algunas firmas establecen un <strong class='text-white'>End-of-Day Trailing Max Drawdown</strong>, en el que el suelo solo avanza según su saldo de cierre y deja de subir cuando alcanza su saldo inicial. Otras utilizan un <strong class='text-white'>Real-Time Trailing Max Drawdown</strong>, que sigue su máximo intradía en directo. Si da por supuesto el comportamiento de fin de día en una cuenta en tiempo real, calculará su margen con un error enorme." },
    { type: "heading",text: "5. Un tamaño de operación que no deja colchón" },
    { type: "paragraph",html: "Posiciones demasiado grandes en relación con el drawdown que le queda significan que un tick adverso rutinario puede cubrir toda la distancia hasta el suelo. El tamaño de la posición y el límite del trailing van de la mano: cuanto más cerca esté del suelo, menor debe ser su tamaño para sobrevivir al ruido normal." },
    { type: "heading",text: "Cómo corregir y prevenir el trailing drawdown: paso a paso" },
    { type: "paragraph",html: "No puede &ldquo;deshacer&rdquo; una infracción una vez ocurrida, así que la solución es en realidad la prevención: hacer visible el suelo invisible y luego operar con margen. Este es el flujo de trabajo." },
    { type: "heading",text: "Muestre su drawdown en directo en el módulo Accounts" },
    {
      type: "list",
      items: [
        "Haga clic en el botón <strong class='text-white'>más (+)</strong> de la parte superior izquierda de Tradovate para abrir el menú de módulos y añada el módulo (widget) <strong class='text-white'>Accounts</strong> a su espacio de trabajo.",
        "Haga clic en el icono <strong class='text-white'>View Settings (engranaje)</strong> de la parte superior derecha del módulo Accounts y elija <strong class='text-white'>Select Columns</strong>.",
        "En el selector de columnas, arrastre la columna del trailing drawdown, normalmente llamada <strong class='text-white'>Dis Drawdown Net Liq</strong> (cuánto puede perder antes de alcanzar el trailing drawdown), de <em>Available</em> a <em>Visible</em>.",
        "Haga clic en <strong class='text-white'>Save</strong>. La columna muestra ahora, en tiempo real, su distancia restante hasta el umbral de autoliquidación.",
      ],
    },
    { type: "heading",text: "Confirme su tipo de drawdown y su umbral" },
    {
      type: "list",
      items: [
        "Abra <strong class='text-white'>Application Settings</strong> (arriba a la derecha) y vaya a <strong class='text-white'>Risk Settings</strong>.",
        "Compruebe si su cuenta utiliza <strong class='text-white'>End-of-Day Trailing Max Drawdown</strong> o <strong class='text-white'>Real-Time Trailing Max Drawdown</strong>. Eso decide si el P&amp;L no realizado puede hacerle superarlo durante el día.",
        "Anote el umbral de autoliquidación. Forma rápida de comprobarlo: <strong class='text-white'>Account Value &minus; Trailing Max Drawdown = Auto-Liquidation Threshold</strong>. Si su net liq cae hasta esa cifra, la cuenta se bloquea.",
      ],
    },
    { type: "heading",text: "Opere con un margen firme" },
    {
      type: "list",
      items: [
        "Decida un colchón personal de &ldquo;dejar de operar&rdquo; por encima del suelo (por ejemplo, mantenga una distancia fija visible en la columna <em>Dis Drawdown Net Liq</em>) y trátelo como un muro.",
        "Dimensione las posiciones de modo que una excursión adversa normal no pueda cubrir la distancia desde su precio actual hasta el umbral de autoliquidación.",
        "Si su firma lo permite, establezca en Risk Settings un <strong class='text-white'>Daily Loss Limit</strong> que se active <em>antes</em> que el suelo del trailing, para que le cierren las posiciones en sus términos en lugar de perder la evaluación.",
      ],
    },
    { type: "heading",text: "Vigile el máximo, no el saldo" },
    { type: "paragraph",html: "Como el suelo está anclado a su saldo más alto, su margen utilizable se reduce cada vez que marca un nuevo máximo y luego devuelve algo. Vuelva a revisar la columna de drawdown tras cada impulso fuerte, no solo a la apertura." },
    { type: "heading",text: "Tabla de resolución de problemas" },
    { type: "table", headers: ["Lo que ve","Qué significa","Qué hacer"], rows: [
      ["La cuenta pasa a Liquidation Only","Se alcanzó un límite de riesgo estricto (límite de pérdida o trailing drawdown); las posiciones se cierran y las nuevas órdenes se bloquean","Con un límite diario/semanal, espere a la siguiente sesión/semana; si es el trailing max drawdown en una evaluación prop, la cuenta ha fallado"],
      ["Dis Drawdown Net Liq cerca de cero","Está casi en el umbral de autoliquidación","Deje de añadir tamaño, reduzca la exposición y dé margen al suelo"],
      ["El saldo está en positivo pero lo superó igualmente","El suelo en tiempo real siguió su máximo intradía; devolvió lo suficiente desde el máximo","Opere con menos tamaño tras nuevos máximos; el suelo se mueve con su máximo"],
      ["Lo superó con la operación aún abierta","El P&amp;L no realizado se contó contra su net liq","En cuentas en tiempo real, gestione el drawdown de las operaciones abiertas, no solo el P&amp;L cerrado"],
      ["El suelo parece no subir nunca","Está en trailing de fin de día, y/o el saldo supera el saldo inicial y dejó de subir","Confirme su tipo de drawdown en Risk Settings"],
      ["La evaluación figura como fallida tras una pequeña pérdida","El suelo del trailing había subido con las ganancias anteriores","Recupere el hábito de revisar la columna de drawdown antes de cada entrada"],
    ] },
    { type: "heading",text: "Prevéngalo con PickMyTrade" },
    { type: "paragraph",html: "PickMyTrade conecta sus alertas de TradingView directamente con Tradovate, lo que significa que la disciplina que le mantiene alejado del suelo del trailing puede aplicarla su automatización en lugar de sus nervios:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Qty / Symbol Validation</strong> limita la cantidad de contratos de cada orden enviada, de modo que una entrada con un error de dedo o sobredimensionada nunca consuma su drawdown restante.",
        "<strong class='text-white'>Risk-Aware Routing</strong> respeta los límites de posición y de riesgo que establezca, de modo que las alertas que le llevarían más allá de su margen se retienen.",
        "<strong class='text-white'>Rate-Limit-Safe Order Flow</strong> espacia las órdenes para que nada rebote ni se dispare dos veces en mercados rápidos, manteniendo sus ejecuciones predecibles.",
        "<strong class='text-white'>Multi-Account Sync</strong> replica la misma orden disciplinada y de tamaño controlado en todas las cuentas, de modo que un espacio de trabajo no supere el límite en silencio mientras otro parece estar bien.",
      ],
    },
    { type: "paragraph",html: "El objetivo no es que la automatización vigile el suelo del trailing por usted; usted sigue supervisando la columna <em>Dis Drawdown Net Liq</em>. Lo que importa es que una ejecución consistente y sujeta a reglas es lo que le mantiene cómodamente por encima de él." },
  ], fr: [
    { type: "paragraph",html: "Une bonne séance pousse le solde de votre compte prop vers un nouveau sommet, et discrètement, le plancher du trailing drawdown de Tradovate grimpe juste derrière. Un repli ordinaire plus tard, le compte bascule en <strong class='text-white'>Liquidation Only</strong>, vos positions sont clôturées et l'évaluation est marquée <em>échouée</em>. Pas d'appel, pas de moyen de se refaire. Le dépassement du trailing drawdown est l'une des manières les plus courantes, et les plus coûteuses, pour les traders financés et en évaluation de perdre un compte, précisément parce que la limite évolue en temps réel et ne va que dans un seul sens. Voici ce que signifie réellement ce dépassement, pourquoi il piège autant de monde, comment le surveiller en direct dans Tradovate et comment une automatisation comme PickMyTrade vous aide à trader à l'intérieur de la limite plutôt que de vous écraser contre elle." },
    {
      type: "checklist",
      heading: "Check-list rapide sur le trailing drawdown",
      items: [
        "<strong class='text-white'>Ajoutez la colonne de drawdown à votre module Accounts.</strong> Affichez la colonne <em>Dis Drawdown Net Liq</em> afin de voir exactement la marge dont vous disposez avant le plancher.",
        "<strong class='text-white'>Vérifiez-la avant chaque entrée.</strong> Le plancher du trailing monte avec votre pic ; le coussin d'hier n'est donc pas celui d'aujourd'hui.",
        "<strong class='text-white'>Gardez un coussin délibéré.</strong> Ne tradez jamais collé au seuil de liquidation automatique. Une mèche normale peut le déclencher.",
        "<strong class='text-white'>Connaissez votre type de drawdown.</strong> Le trailing de fin de journée et le trailing en temps réel se comportent très différemment. Confirmez lequel votre société utilise.",
        "<strong class='text-white'>N'oubliez pas que le P&amp;L latent compte.</strong> Sur les comptes en temps réel, le drawdown des trades ouverts peut vous faire dépasser la limite avant que vous ne clôturiez quoi que ce soit.",
        "<strong class='text-white'>Partez du principe qu'il n'y a pas de récupération.</strong> Une fois la limite du trailing atteinte, une évaluation prop échoue généralement pour de bon. On ne peut pas &ldquo;se refaire&rdquo;.",
      ],
    },
    { type: "heading",text: "Ce que signifie un dépassement du trailing drawdown (le blocage « Liquidation Only »)" },
    { type: "paragraph",html: "Un <strong class='text-white'>trailing maximum drawdown</strong> est une limite de perte dynamique qui suit vers le haut le solde le plus élevé de votre compte, le high-water mark, mais ne redescend jamais. Lorsque votre solde établit un nouveau pic, le plancher du drawdown monte avec lui. Lorsque votre solde baisse, le plancher reste en place. Au moment où la valeur de votre compte touche ce plancher, vous avez dépassé le trailing drawdown, et Tradovate place le compte en statut <strong class='text-white'>Liquidation Only</strong> : les positions ouvertes sont clôturées, les ordres en attente sont annulés et vous ne pouvez rien ouvrir de nouveau." },
    { type: "paragraph",html: "Cet état &ldquo;Liquidation Only&rdquo; est le même blocage que celui utilisé par Tradovate chaque fois qu'une limite de risque ferme est atteinte, mais la conséquence en contexte prop est plus lourde. Pour une limite de perte quotidienne ou hebdomadaire normale, le Liquidation Only se lève au début de la séance ou de la semaine suivante. Le dépassement d'un <strong class='text-white'>max drawdown</strong> à trailing sur une évaluation prop est une tout autre affaire : c'est la ligne de réussite ou d'échec de la société. L'atteindre revient à perdre le compte, et il n'y a pas d'attente qui tienne. Il faudrait réinitialiser ou racheter l'évaluation." },
    { type: "paragraph",html: "Si tant de traders se font piéger, c'est que le plancher est invisible à moins de l'afficher délibérément. Votre solde peut sembler parfaitement sain alors que vous n'êtes qu'à quelques ticks au-dessus du seuil de liquidation automatique, car ce seuil a discrètement grimpé pendant votre dernière série gagnante. Savoir <em>où</em> se trouve le plancher en ce moment, et non où il était ce matin, c'est tout le jeu." },
    { type: "heading",text: "Principales causes d'un dépassement du trailing drawdown sur Tradovate" },
    { type: "heading",text: "1. Le plancher a grimpé après une série gagnante" },
    { type: "paragraph",html: "C'est le piège classique. Sur un compte à trailing en temps réel, le plancher du drawdown suit votre pic intrajournalier. Supposons que votre limite soit un montant fixe en dollars sous votre sommet (les montants réels varient selon la société et la taille du compte ; vérifiez donc les règles en vigueur de votre société). Votre solde monte, puis en rend une partie. Le plancher est désormais mesuré à partir de ce nouveau sommet, de sorte qu'un &ldquo;petit&rdquo; repli peut vous faire dépasser la limite alors que vous êtes encore gagnant sur la journée." },
    { type: "heading",text: "2. Le drawdown latent (trade ouvert) est compté contre vous" },
    { type: "paragraph",html: "Sur les comptes à trailing en temps réel, le drawdown est calculé sur votre valeur de liquidation nette, qui <strong class='text-white'>inclut le P&amp;L des positions ouvertes</strong>. Vous n'avez donc pas besoin de clôturer un trade perdant pour dépasser la limite. Une excursion défavorable assez profonde alors que le trade est encore ouvert peut à elle seule déclencher le seuil de liquidation automatique. Les traders qui ne regardent que le P&amp;L <em>clôturé</em> ne le voient jamais venir." },
    { type: "heading",text: "3. Vous ne surveilliez pas la colonne de drawdown" },
    { type: "paragraph",html: "Tradovate n'affiche aucun avertissement lorsque vous approchez du plancher. Si vous n'avez pas ajouté la colonne <em>Dis Drawdown Net Liq</em> (ou l'équivalent de votre société) au module Accounts, vous tradez à l'aveugle par rapport au seul chiffre qui peut faire échouer votre compte." },
    { type: "heading",text: "4. Confondre trailing de fin de journée et trailing en temps réel" },
    { type: "paragraph",html: "Certaines sociétés fixent un <strong class='text-white'>End-of-Day Trailing Max Drawdown</strong>, où le plancher n'avance qu'en fonction de votre solde de clôture et cesse de monter une fois qu'il atteint votre solde de départ. D'autres utilisent un <strong class='text-white'>Real-Time Trailing Max Drawdown</strong>, qui suit votre pic intrajournalier en direct. Si vous supposez le comportement de fin de journée sur un compte en temps réel, vous vous tromperez largement sur votre marge." },
    { type: "heading",text: "5. Une taille de trading qui ne laisse aucun coussin" },
    { type: "paragraph",html: "Des positions surdimensionnées par rapport au drawdown qu'il vous reste signifient qu'un tick défavorable ordinaire peut couvrir toute la distance jusqu'au plancher. La taille de position et la limite du trailing sont indissociables : plus vous êtes proche du plancher, plus votre taille doit être réduite pour survivre au bruit normal." },
    { type: "heading",text: "Comment corriger et prévenir un dépassement du trailing drawdown : pas à pas" },
    { type: "paragraph",html: "Vous ne pouvez pas &ldquo;annuler&rdquo; un dépassement après coup ; la solution, c'est donc la prévention : rendre visible le plancher invisible, puis trader avec une marge. Voici la marche à suivre." },
    { type: "heading",text: "Affichez votre drawdown en direct dans le module Accounts" },
    {
      type: "list",
      items: [
        "Cliquez sur le bouton <strong class='text-white'>plus (+)</strong> en haut à gauche de Tradovate pour ouvrir le menu des modules, puis ajoutez le module (widget) <strong class='text-white'>Accounts</strong> à votre espace de travail.",
        "Cliquez sur l'icône <strong class='text-white'>View Settings (engrenage)</strong> en haut à droite du module Accounts, puis choisissez <strong class='text-white'>Select Columns</strong>.",
        "Dans le sélecteur de colonnes, faites glisser la colonne du trailing drawdown, généralement intitulée <strong class='text-white'>Dis Drawdown Net Liq</strong> (ce que vous pouvez perdre avant d'atteindre le trailing drawdown), de <em>Available</em> vers <em>Visible</em>.",
        "Cliquez sur <strong class='text-white'>Save</strong>. La colonne affiche désormais, en temps réel, votre distance restante jusqu'au seuil de liquidation automatique.",
      ],
    },
    { type: "heading",text: "Confirmez votre type de drawdown et votre seuil" },
    {
      type: "list",
      items: [
        "Ouvrez <strong class='text-white'>Application Settings</strong> (en haut à droite) et allez dans <strong class='text-white'>Risk Settings</strong>.",
        "Vérifiez si votre compte utilise <strong class='text-white'>End-of-Day Trailing Max Drawdown</strong> ou <strong class='text-white'>Real-Time Trailing Max Drawdown</strong>. Cela détermine si le P&amp;L latent peut vous faire dépasser la limite en cours de journée.",
        "Notez le seuil de liquidation automatique. Moyen rapide de le vérifier : <strong class='text-white'>Account Value &minus; Trailing Max Drawdown = Auto-Liquidation Threshold</strong>. Si votre net liq descend jusqu'à ce chiffre, le compte se bloque.",
      ],
    },
    { type: "heading",text: "Tradez avec une marge ferme" },
    {
      type: "list",
      items: [
        "Fixez-vous un coussin personnel d'&ldquo;arrêt du trading&rdquo; au-dessus du plancher (par exemple, gardez une distance fixe affichée dans la colonne <em>Dis Drawdown Net Liq</em>) et traitez-le comme un mur.",
        "Dimensionnez vos positions de sorte qu'une excursion défavorable normale ne puisse pas couvrir la distance entre votre prix actuel et le seuil de liquidation automatique.",
        "Si votre société le permet, définissez dans Risk Settings un <strong class='text-white'>Daily Loss Limit</strong> qui se déclenche <em>avant</em> le plancher du trailing, afin d'être clôturé selon vos conditions plutôt que de faire exploser l'évaluation.",
      ],
    },
    { type: "heading",text: "Surveillez le pic, pas le solde" },
    { type: "paragraph",html: "Comme le plancher est ancré à votre solde le plus élevé, votre marge utilisable se réduit chaque fois que vous établissez un nouveau sommet puis en rendez une partie. Revérifiez la colonne de drawdown après chaque forte poussée, pas seulement à l'ouverture." },
    { type: "heading",text: "Tableau de dépannage" },
    { type: "table", headers: ["Ce que vous voyez","Ce que cela signifie","Que faire"], rows: [
      ["Le compte bascule en Liquidation Only","Une limite de risque ferme (limite de perte ou trailing drawdown) a été atteinte ; les positions sont clôturées et les nouveaux ordres bloqués","Pour une limite quotidienne/hebdomadaire, attendez la séance/semaine suivante ; pour un dépassement du trailing max drawdown sur une évaluation prop, le compte a échoué"],
      ["Dis Drawdown Net Liq proche de zéro","Vous êtes presque au seuil de liquidation automatique","Cessez d'ajouter de la taille, réduisez l'exposition et laissez de la marge au plancher"],
      ["Le solde est en hausse mais vous avez quand même dépassé la limite","Le plancher en temps réel a suivi votre pic intrajournalier ; vous avez rendu assez depuis le sommet","Tradez plus petit après de nouveaux sommets ; le plancher bouge avec votre pic"],
      ["Limite dépassée alors que le trade était encore ouvert","Le P&amp;L latent a été compté contre votre net liq","Sur les comptes en temps réel, gérez le drawdown des trades ouverts, pas seulement le P&amp;L clôturé"],
      ["Le plancher ne semble jamais monter","Vous êtes en trailing de fin de journée, et/ou le solde dépasse le solde de départ et a cessé de monter","Confirmez votre type de drawdown dans Risk Settings"],
      ["L'évaluation est marquée échouée après une petite perte","Le plancher du trailing avait grimpé grâce aux gains précédents","Reprenez l'habitude de vérifier la colonne de drawdown avant chaque entrée"],
    ] },
    { type: "heading",text: "Prévenez cela avec PickMyTrade" },
    { type: "paragraph",html: "PickMyTrade relie vos alertes TradingView directement à Tradovate, ce qui signifie que la discipline qui vous maintient loin du plancher du trailing peut être imposée par votre automatisation plutôt que par vos nerfs :" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Qty / Symbol Validation</strong> plafonne la quantité de contrats de chaque ordre acheminé, de sorte qu'une entrée mal saisie ou surdimensionnée ne ronge jamais votre drawdown restant.",
        "<strong class='text-white'>Risk-Aware Routing</strong> respecte les limites de position et de risque que vous définissez, de sorte que les alertes qui vous feraient dépasser votre marge sont retenues.",
        "<strong class='text-white'>Rate-Limit-Safe Order Flow</strong> espace les ordres afin que rien ne rebondisse ni ne se déclenche deux fois sur des marchés rapides, ce qui garde vos exécutions prévisibles.",
        "<strong class='text-white'>Multi-Account Sync</strong> reproduit le même ordre discipliné et à taille maîtrisée sur tous les comptes, afin qu'un espace de travail ne dépasse pas discrètement la limite pendant qu'un autre semble en règle.",
      ],
    },
    { type: "paragraph",html: "L'idée n'est pas que l'automatisation surveille le plancher du trailing à votre place ; vous surveillez toujours vous-même la colonne <em>Dis Drawdown Net Liq</em>. L'idée est qu'une exécution cohérente et encadrée par des règles est ce qui vous maintient confortablement au-dessus." },
  ], it: [
    { type: "paragraph",html: "Una buona sessione porta il saldo del Suo account prop a un nuovo massimo e, silenziosamente, il pavimento del trailing drawdown di Tradovate sale subito dietro. Un normale ritracciamento dopo, l'account passa a <strong class='text-white'>Liquidation Only</strong>, le Sue posizioni vengono chiuse e la valutazione risulta <em>fallita</em>. Nessun appello, nessun modo di recuperare operando. Il superamento del trailing drawdown è uno dei modi più comuni, e più costosi, in cui i trader finanziati e in valutazione perdono un account, proprio perché il limite si muove in tempo reale e viaggia in una sola direzione. Ecco cosa significa realmente il superamento, perché coglie così tante persone di sorpresa, come monitorarlo in tempo reale dentro Tradovate e come un'automazione come PickMyTrade La aiuta a operare entro il limite invece di sbatterci contro." },
    {
      type: "checklist",
      heading: "Checklist rapida sul trailing drawdown",
      items: [
        "<strong class='text-white'>Aggiunga la colonna del drawdown al Suo modulo Accounts.</strong> Faccia comparire la colonna <em>Dis Drawdown Net Liq</em> per vedere esattamente quanto margine ha prima del pavimento.",
        "<strong class='text-white'>La controlli prima di ogni ingresso.</strong> Il pavimento del trailing sale con il Suo picco, quindi il cuscinetto di ieri non è quello di oggi.",
        "<strong class='text-white'>Mantenga un cuscinetto deliberato.</strong> Non operi mai a ridosso della soglia di liquidazione automatica. Un normale spike può farla scattare.",
        "<strong class='text-white'>Conosca il Suo tipo di drawdown.</strong> Il trailing di fine giornata e il trailing in tempo reale si comportano in modo molto diverso. Confermi quale utilizza la Sua società.",
        "<strong class='text-white'>Ricordi che conta il P&amp;L non realizzato.</strong> Sugli account in tempo reale, il drawdown dei trade aperti può farLa superare il limite prima ancora di chiudere.",
        "<strong class='text-white'>Non conti su alcun recupero.</strong> Una volta raggiunto il limite del trailing, una valutazione prop di norma fallisce definitivamente. Non esiste &ldquo;recuperare operando&rdquo;.",
      ],
    },
    { type: "heading",text: "Cosa significa superare il trailing drawdown (il blocco “Liquidation Only”)" },
    { type: "paragraph",html: "Un <strong class='text-white'>trailing maximum drawdown</strong> è un limite di perdita dinamico che segue verso l'alto il saldo più alto del Suo account, l'high-water mark, ma non torna mai indietro. Quando il Suo saldo fa un nuovo picco, il pavimento del drawdown sale con esso. Quando il saldo scende, il pavimento resta dov'è. Nel momento in cui il valore del Suo account tocca quel pavimento, ha superato il trailing drawdown e Tradovate porta l'account nello stato <strong class='text-white'>Liquidation Only</strong>: le posizioni aperte vengono chiuse, gli ordini in lavorazione cancellati e non può aprire nulla di nuovo." },
    { type: "paragraph",html: "Quello stato &ldquo;Liquidation Only&rdquo; è lo stesso blocco che Tradovate usa ogni volta che viene raggiunto un limite di rischio rigido, ma in un contesto prop la conseguenza è più pesante. Per un normale limite di perdita giornaliero o settimanale, il Liquidation Only si azzera all'inizio della sessione o della settimana successiva. Il superamento del <strong class='text-white'>max drawdown</strong> con trailing in una valutazione prop è tutt'altra cosa: è la linea tra superato e fallito della società. Raggiungerla equivale a perdere l'account e non c'è attesa che tenga. Dovrebbe reimpostare o riacquistare la valutazione." },
    { type: "paragraph",html: "Il motivo per cui così tanti trader ci cascano è che il pavimento è invisibile a meno di non farlo comparire deliberatamente. Il Suo saldo può sembrare perfettamente sano mentre si trova a pochi tick sopra la soglia di liquidazione automatica, perché quella soglia è salita silenziosamente durante la Sua ultima serie vincente. Sapere <em>dove</em> si trova il pavimento adesso, e non dov'era questa mattina, è tutto il gioco." },
    { type: "heading",text: "Principali cause del superamento del trailing drawdown in Tradovate" },
    { type: "heading",text: "1. Il pavimento è salito dopo una serie vincente" },
    { type: "paragraph",html: "È la classica trappola. Su un account con trailing in tempo reale, il pavimento del drawdown segue il Suo picco intragiornaliero. Supponiamo che il Suo limite sia un importo fisso in dollari sotto il Suo massimo (gli importi effettivi variano in base alla società e alla dimensione dell'account, quindi verifichi le regole attuali della Sua società). Il Suo saldo sale, poi ne restituisce una parte. Il pavimento è ora misurato da quel nuovo massimo, quindi un ritracciamento &ldquo;piccolo&rdquo; può farLa superare il limite anche se è ancora in positivo nella giornata." },
    { type: "heading",text: "2. Il drawdown non realizzato (trade aperto) viene conteggiato contro di Lei" },
    { type: "paragraph",html: "Sugli account con trailing in tempo reale, il drawdown è calcolato sul valore di liquidazione netto, che <strong class='text-white'>include il P&amp;L delle posizioni aperte</strong>. Quindi non deve chiudere un trade in perdita per superare il limite. Un'escursione avversa abbastanza profonda mentre il trade è ancora aperto può far scattare da sola la soglia di liquidazione automatica. I trader che guardano solo il P&amp;L <em>chiuso</em> non lo vedono mai arrivare." },
    { type: "heading",text: "3. Non stava osservando la colonna del drawdown" },
    { type: "paragraph",html: "Tradovate non mostra alcun avviso mentre si avvicina al pavimento. Se non ha aggiunto la colonna <em>Dis Drawdown Net Liq</em> (o l'equivalente della Sua società) al modulo Accounts, opera alla cieca rispetto all'unico numero che può far fallire il Suo account." },
    { type: "heading",text: "4. Confondere il trailing di fine giornata con quello in tempo reale" },
    { type: "paragraph",html: "Alcune società impostano un <strong class='text-white'>End-of-Day Trailing Max Drawdown</strong>, in cui il pavimento avanza solo in base al Suo saldo di chiusura e smette di salire una volta raggiunto il saldo iniziale. Altre usano un <strong class='text-white'>Real-Time Trailing Max Drawdown</strong>, che segue il Suo picco intragiornaliero. Se presume il comportamento di fine giornata su un account in tempo reale, sbaglierà di molto la valutazione del Suo margine." },
    { type: "heading",text: "5. Una dimensione di trading che non lascia cuscinetto" },
    { type: "paragraph",html: "Posizioni sovradimensionate rispetto al drawdown residuo significano che un normale tick avverso può coprire l'intera distanza fino al pavimento. Dimensione della posizione e limite del trailing sono legati a doppio filo: più è vicino al pavimento, più piccola deve essere la dimensione per sopravvivere al rumore normale." },
    { type: "heading",text: "Come correggere e prevenire il superamento del trailing drawdown: passo dopo passo" },
    { type: "paragraph",html: "Non può &ldquo;annullare&rdquo; un superamento una volta avvenuto, quindi la soluzione è in realtà la prevenzione: rendere visibile il pavimento invisibile e poi operare con un margine. Ecco il flusso di lavoro." },
    { type: "heading",text: "Faccia comparire il Suo drawdown in tempo reale nel modulo Accounts" },
