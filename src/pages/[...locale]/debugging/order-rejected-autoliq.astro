---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "order-rejected-autoliq";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/debugging/${SLUG}`;

const META_TITLE = "Tradovate 'AutoLiq 50000.0%' Order Rejection Fix";
const META_DESCRIPTION =
  "AutoLiq 50000.0% in Tradovate means auto-liquidation triggered, sign data agreements, keep a margin buffer, and avoid news and session-close spikes.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Tradovate: Behebung der Order-Ablehnung „AutoLiq 50000.0%“", es: "Tradovate: solución al rechazo de orden «AutoLiq 50000.0%»", fr: "Tradovate : correction du rejet d'ordre « AutoLiq 50000.0% »", it: "Tradovate: come risolvere il rifiuto d'ordine «AutoLiq 50000.0%»" },
  dek: { en: "An entry bounces back with a cryptic \"AutoLiq 50000.0%\" rejection. It's the risk engine refusing new risk while your account is in, or near, auto-liquidation.", de: "Ein Einstieg wird mit der kryptischen Meldung „AutoLiq 50000.0%“ abgelehnt. Die Risiko-Engine verweigert neues Risiko, solange Ihr Konto in der Auto-Liquidation steckt oder kurz davor steht.", es: "Una entrada rebota con el críptico rechazo «AutoLiq 50000.0%». Es el motor de riesgo negándose a admitir nuevo riesgo mientras su cuenta está en autoliquidación o cerca de ella.", fr: "Une entrée est renvoyée avec le rejet énigmatique « AutoLiq 50000.0% ». C'est le moteur de risque qui refuse tout nouveau risque tant que votre compte est en auto-liquidation ou proche de l'être.", it: "Un ingresso viene respinto con l'enigmatico rifiuto «AutoLiq 50000.0%». È il motore di rischio che rifiuta nuovo rischio mentre il Suo conto è in auto-liquidazione o vicino ad essa." },
  readTime: { en: "7 min read", de: "7 Min. Lesezeit", es: "Lectura de 7 min", fr: "Lecture : 7 min", it: "Lettura di 7 min" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "You're trading fast futures, ES, NQ, CL, your entry goes in, and it bounces straight back with a cryptic <strong class='text-white'>&ldquo;AutoLiq 50000.0%&rdquo;</strong> rejection. It feels like the platform just deleted your edge. Here's the reassuring part: that message isn't a random glitch. It's the risk engine telling you the account is in, or dangerously close to, auto-liquidation, so it's refusing to let you pile on more risk. And the timing matters more than anything else. These rejections cluster around the daily session close and news-driven margin spikes, and once you know that, the fix gets obvious. Below, we'll walk through what the error actually means, what causes it, and how to clear it fast, plus how routing your alerts through PickMyTrade keeps these rejections from quietly eating your fills." },
    {
      type: "checklist",
      heading: "Quick Checklist for AutoLiq Order Rejections",
      items: [
        "<strong class='text-white'>Check whether you're flat or liquidation-only.</strong> If the account is being auto-liquidated, new opening orders are blocked by design.",
        "<strong class='text-white'>Sign every required market-data and exchange agreement.</strong> Unsigned data agreements cascade into risk-parameter and quote errors that surface as rejections.",
        "<strong class='text-white'>Confirm your risk settings.</strong> A Max Position, daily loss limit, or auto-liquidate threshold may have tripped.",
        "<strong class='text-white'>Watch the clock around session close.</strong> Intraday margin ends about 15 minutes before the close, when the higher initial margin kicks in.",
        "<strong class='text-white'>Avoid holding into major news.</strong> Tradovate raises intraday margins sharply ahead of key economic releases, which can push an account into liquidation.",
        "<strong class='text-white'>Keep a margin buffer.</strong> Margin requirements can change without notice, and the firm may liquidate with or without warning.",
      ],
    },
    { type: "heading", text: "What \"AutoLiq 50000.0%\" Means" },
    { type: "paragraph", html: "&ldquo;AutoLiq&rdquo; is short for <strong class='text-white'>auto-liquidation</strong>. When Tradovate attaches this reason to a rejected order, it's telling you the order was refused because the account is under an automatic liquidation condition, not because of a normal order-routing error. In plain English: the platform believes your account no longer meets its margin requirement, so instead of accepting a new position it's trying to <em>reduce</em> risk. It won't let you add to the problem." },
    { type: "paragraph", html: "That eye-catching <strong class='text-white'>&ldquo;50000.0%&rdquo;</strong> is a system-generated risk figure shown in the rejection reason. It reflects an internal margin/risk ratio the engine flags when an account is deep into a liquidation state. Think of it as the platform's way of saying &ldquo;risk is off the scale here,&rdquo; not a number you set or can tune directly. Tradovate doesn't publish the exact formula behind that specific value, so treat the percentage as a <em>symptom label</em>, not a setting." },
    { type: "paragraph", html: "Here's the pattern worth burning into memory: this rejection almost always clusters around two events, the <strong class='text-white'>daily session close/reset</strong> and <strong class='text-white'>major economic news</strong>. It tends to fire right as the session rolls, or when volatility spikes and Tradovate bumps margins for a big release. That lines up exactly with Tradovate's published margin policy, which is why the fix is about <em>timing and margin</em>, not resubmitting the order." },
    { type: "heading", text: "Top Causes of AutoLiq Rejections in 2026" },
    { type: "heading", text: "1. Margin Spikes Around Economic News" },
    { type: "paragraph", html: "Tradovate temporarily raises intraday margins ahead of key economic releases, it has cited increases of as much as 4&times; its standard rates, and keeps them elevated until volatility settles. The exact multiple varies by product and event, so always check Tradovate's current margin schedule. If you're holding a position when that jump hits and your account can't cover the new requirement, the risk engine can move the account into auto-liquidation and reject any new orders." },
    { type: "heading", text: "2. Hitting the Session-Close Initial-Margin Transition" },
    { type: "paragraph", html: "Intraday margin rates generally run from the product open until <strong class='text-white'>15 minutes prior to the session close</strong>, when the higher <strong class='text-white'>initial margin</strong> is required for positions carried overnight. An account that's perfectly comfortable on intraday margin can suddenly be short at that transition, the same late-afternoon window where these AutoLiq rejections tend to bunch up." },
    { type: "heading", text: "3. Unsigned Data Agreements and Tripped Risk Parameters" },
    { type: "paragraph", html: "Order rejections frequently trace back to <strong class='text-white'>unsigned market-data or exchange agreements</strong>. When those agreements are missing, real-time data and entitlements break, and the platform surfaces the failure as risk-parameter and &ldquo;no quote&rdquo; style rejections that can accompany or masquerade as an AutoLiq state. Signing the outstanding agreements clears the entitlement half of the problem." },
    { type: "heading", text: "4. Risk Settings or Prop-Firm Limits Already Breached" },
    { type: "paragraph", html: "A configured <strong class='text-white'>Max Position size, daily loss limit, or auto-liquidate threshold</strong>, either your own or one set by your prop firm, can flip the account into liquidation-only. On evaluation and funded accounts, these limits are controlled by the firm, and once breached the account rejects new opening orders until the next session or a reset." },
    { type: "heading", text: "5. A Platform-Side Risk or Maintenance Event" },
    { type: "paragraph", html: "Sometimes the AutoLiq wave isn't about your account at all. When the identical rejection lands on many accounts at the exact same second, at least part of that episode is a <strong class='text-white'>platform-wide event</strong> tied to a news-driven margin change and the session roll, not an individual account fault. In those cases, waiting out the event and filing a ticket is usually the only real fix." },
    { type: "heading", text: "How to Fix AutoLiq 50000.0% Rejections: Step-by-Step" },
    { type: "heading", text: "Fixing Data Agreements and Risk Parameters" },
    {
      type: "steps",
      items: [
        { title: "Open the agreements area", html: "Open your Tradovate account settings and go to the market-data / exchange <strong class='text-white'>agreements</strong> area." },
        { title: "Sign every outstanding agreement", html: "Sign at least the non-professional data agreements so real-time entitlements are active." },
        { title: "Confirm your risk settings", html: "Open <strong class='text-white'>Risk Settings</strong> and confirm your Max Position, daily/weekly loss limits, and any auto-liquidate threshold are set where you expect, not accidentally at zero or some tiny value." },
        { title: "Check with your firm if applicable", html: "On a prop-firm evaluation or funded account, remember you usually can't change these yourself, contact the firm to confirm the account isn't in liquidation-only." },
      ],
    },
    { type: "heading", text: "Keeping a Margin Buffer Through Spikes" },
    {
      type: "steps",
      items: [
        { title: "Check available margin before you trade", html: "Check your account's <strong class='text-white'>available/excess margin</strong> against the position you want to open." },
        { title: "Keep a cushion", html: "Keep a cushion well above the initial margin requirement, since requirements can change without notice and the firm may liquidate with or without warning." },
        { title: "Size down for news windows", html: "If you must hold through a news window, size down so the elevated (news) margin still fits, or just stay flat until margins normalize." },
      ],
    },
    { type: "heading", text: "Trading Around Session Close and News" },
    {
      type: "steps",
      items: [
        { title: "Identify the session-close window", html: "Identify the product's <strong class='text-white'>session close</strong> and the ~15-minute pre-close window where initial margin takes over (for many CME futures the daily reset lands around 5 PM Central)." },
        { title: "Flatten or hold enough margin", html: "Either flatten before that transition or make sure you're holding enough margin for the overnight/initial requirement." },
        { title: "Avoid opening into elevated-margin windows", html: "Around scheduled economic releases, don't open fresh positions into the elevated-margin window; wait for the platform to restore normal intraday margin." },
        { title: "File a ticket if it persists while flat", html: "If the rejection persists while you're flat and within normal hours, capture the exact reject text and <strong class='text-white'>file a support ticket</strong>, a same-second, multi-account AutoLiq is a platform event, not your setup." },
      ],
    },
    { type: "heading", text: "Troubleshooting Table" },
    {
      type: "table",
      headers: ["Error", "Meaning", "Fix"],
      rows: [
        ["AutoLiq 50000.0%", "Account is in (or at the edge of) auto-liquidation; new opening orders blocked", "Confirm you're flat/liquidation-only, restore a margin buffer, wait out the event, then re-enter"],
        ["Order Rejected: Risk Parameters", "A risk limit or entitlement check failed", "Sign data agreements and confirm Max Position / loss-limit settings"],
        ["No Quote Available", "Missing data subscription or entitlement", "Subscribe to the exchange data and sign the non-professional agreement"],
        ["Liquidation Only", "Account restricted to closing orders after a limit breach", "Wait for the next session/week or have the firm reset the account"],
        ["Insufficient Margin", "Free margin below the requirement (often after a news/session-close spike)", "Reduce quantity or add funds so excess margin covers the requirement"],
      ],
    },
    { type: "heading", text: "Prevent This with PickMyTrade" },
    { type: "paragraph", html: "PickMyTrade sits between your TradingView alerts and Tradovate, so a bad or ill-timed order never blindly hits the risk engine:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Entitlement &amp; Risk Filters</strong>, respects your account's data-agreement state and risk limits, so orders that would trip a risk-parameter or AutoLiq rejection get caught early.",
        "<strong class='text-white'>Qty / Symbol Validation</strong>, blocks orders that would breach position caps before they're ever sent.",
        "<strong class='text-white'>Session-Aware Routing</strong>, you control when alerts fire, so you can keep automation out of the news and session-close margin windows.",
        "<strong class='text-white'>Multi-Account Sync</strong>, mirrors the corrected order across every connected account, so one rejection doesn't leave your accounts out of sync.",
      ],
    },
    { type: "paragraph", html: "Instead of discovering an AutoLiq rejection after your setup has already moved, you keep your automation disciplined around the exact conditions that cause it." },
  ], de: [
    { type: "paragraph",html: "Sie handeln schnelle Futures, ES, NQ, CL, Ihr Einstieg geht raus und prallt sofort mit der kryptischen Meldung <strong class='text-white'>&ldquo;AutoLiq 50000.0%&rdquo;</strong> zurück. Es fühlt sich an, als hätte die Plattform gerade Ihren Vorteil gelöscht. Die beruhigende Nachricht: Diese Meldung ist kein zufälliger Fehler. Die Risiko-Engine sagt Ihnen damit, dass sich das Konto in der Auto-Liquidation befindet oder gefährlich nah davor steht, und verweigert deshalb zusätzliches Risiko. Und das Timing ist wichtiger als alles andere. Diese Ablehnungen häufen sich um den täglichen Sitzungsschluss und um nachrichtengetriebene Margin-Spitzen, und sobald Sie das wissen, wird die Lösung offensichtlich. Im Folgenden zeigen wir, was der Fehler tatsächlich bedeutet, was ihn verursacht und wie Sie ihn schnell beheben, und wie das Routing Ihrer Alerts über PickMyTrade verhindert, dass diese Ablehnungen unbemerkt Ihre Fills auffressen." },
    {
      type: "checklist",
      heading: "Kurz-Checkliste für AutoLiq-Order-Ablehnungen",
      items: [
        "<strong class='text-white'>Prüfen Sie, ob Sie flat sind oder Liquidation Only gilt.</strong> Wird das Konto automatisch liquidiert, sind neue eröffnende Orders absichtlich blockiert.",
        "<strong class='text-white'>Unterzeichnen Sie alle erforderlichen Marktdaten- und Börsenvereinbarungen.</strong> Nicht unterzeichnete Datenvereinbarungen ziehen Risikoparameter- und Kursfehler nach sich, die sich als Ablehnungen zeigen.",
        "<strong class='text-white'>Bestätigen Sie Ihre Risikoeinstellungen.</strong> Eine Max Position, ein tägliches Verlustlimit oder eine Auto-Liquidate-Schwelle kann ausgelöst worden sein.",
        "<strong class='text-white'>Beachten Sie die Uhr rund um den Sitzungsschluss.</strong> Die Intraday-Margin endet etwa 15 Minuten vor Handelsschluss, wenn die höhere Initial Margin greift.",
        "<strong class='text-white'>Halten Sie nicht durch große Nachrichten hindurch.</strong> Tradovate erhöht die Intraday-Margins vor wichtigen Wirtschaftsdaten deutlich, was ein Konto in die Liquidation treiben kann.",
        "<strong class='text-white'>Halten Sie einen Margin-Puffer vor.</strong> Margin-Anforderungen können sich ohne Vorankündigung ändern, und die Firma kann mit oder ohne Warnung liquidieren.",
      ],
    },
    { type: "heading",text: "Was „AutoLiq 50000.0%“ bedeutet" },
    { type: "paragraph",html: "&ldquo;AutoLiq&rdquo; steht für <strong class='text-white'>Auto-Liquidation</strong>. Wenn Tradovate diesen Grund an eine abgelehnte Order hängt, bedeutet das, dass die Order verweigert wurde, weil für das Konto eine automatische Liquidationsbedingung gilt, und nicht wegen eines normalen Routing-Fehlers. Auf Deutsch gesagt: Die Plattform glaubt, dass Ihr Konto die Margin-Anforderung nicht mehr erfüllt, und versucht daher, statt eine neue Position anzunehmen, das Risiko zu <em>reduzieren</em>. Sie lässt Sie das Problem nicht noch vergrößern." },
    { type: "paragraph",html: "Die auffällige Zahl <strong class='text-white'>&ldquo;50000.0%&rdquo;</strong> ist eine vom System erzeugte Risikokennzahl im Ablehnungsgrund. Sie spiegelt ein internes Margin-/Risikoverhältnis wider, das die Engine markiert, wenn ein Konto tief in einem Liquidationszustand steckt. Betrachten Sie sie als die Art der Plattform zu sagen: &ldquo;Das Risiko ist hier jenseits der Skala&rdquo;, nicht als Wert, den Sie festlegen oder direkt anpassen können. Tradovate veröffentlicht die genaue Formel hinter diesem konkreten Wert nicht, behandeln Sie den Prozentwert also als <em>Symptombezeichnung</em>, nicht als Einstellung." },
    { type: "paragraph",html: "Dieses Muster sollten Sie sich einprägen: Diese Ablehnung häuft sich fast immer um zwei Ereignisse, den <strong class='text-white'>täglichen Sitzungsschluss/Reset</strong> und <strong class='text-white'>wichtige Wirtschaftsnachrichten</strong>. Sie tritt tendenziell genau beim Sitzungswechsel auf oder wenn die Volatilität steigt und Tradovate die Margins für eine große Veröffentlichung anhebt. Das deckt sich exakt mit der veröffentlichten Margin-Richtlinie von Tradovate, weshalb es bei der Lösung um <em>Timing und Margin</em> geht und nicht darum, die Order erneut zu senden." },
    { type: "heading",text: "Hauptursachen für AutoLiq-Ablehnungen 2026" },
    { type: "heading",text: "1. Margin-Spitzen rund um Wirtschaftsnachrichten" },
    { type: "paragraph",html: "Tradovate erhöht die Intraday-Margins vor wichtigen Wirtschaftsdaten vorübergehend, es hat Erhöhungen von bis zu 4&times; der Standardsätze genannt, und hält sie erhöht, bis sich die Volatilität beruhigt. Das genaue Vielfache variiert je nach Produkt und Ereignis, prüfen Sie daher stets die aktuelle Margin-Tabelle von Tradovate. Wenn Sie eine Position halten, während dieser Sprung eintritt, und Ihr Konto die neue Anforderung nicht decken kann, kann die Risiko-Engine das Konto in die Auto-Liquidation versetzen und alle neuen Orders ablehnen." },
    { type: "heading",text: "2. Der Übergang zur Initial Margin beim Sitzungsschluss" },
    { type: "paragraph",html: "Die Intraday-Margin-Sätze gelten in der Regel von der Produkteröffnung bis <strong class='text-white'>15 Minuten vor dem Sitzungsschluss</strong>, wenn für über Nacht gehaltene Positionen die höhere <strong class='text-white'>Initial Margin</strong> erforderlich ist. Ein Konto, das mit Intraday-Margin völlig komfortabel dasteht, kann an diesem Übergang plötzlich zu knapp sein, im selben späten Nachmittagsfenster, in dem sich diese AutoLiq-Ablehnungen häufen." },
    { type: "heading",text: "3. Nicht unterzeichnete Datenvereinbarungen und ausgelöste Risikoparameter" },
    { type: "paragraph",html: "Order-Ablehnungen lassen sich häufig auf <strong class='text-white'>nicht unterzeichnete Marktdaten- oder Börsenvereinbarungen</strong> zurückführen. Fehlen diese Vereinbarungen, brechen Echtzeitdaten und Berechtigungen weg, und die Plattform zeigt den Fehler als Risikoparameter- und &ldquo;No Quote&rdquo;-artige Ablehnungen an, die einen AutoLiq-Zustand begleiten oder vortäuschen können. Das Unterzeichnen der ausstehenden Vereinbarungen behebt die Berechtigungshälfte des Problems." },
    { type: "heading",text: "4. Risikoeinstellungen oder Prop-Firm-Limits bereits überschritten" },
    { type: "paragraph",html: "Eine konfigurierte <strong class='text-white'>Max-Position-Größe, ein tägliches Verlustlimit oder eine Auto-Liquidate-Schwelle</strong>, ob von Ihnen selbst oder von Ihrem Prop-Firm gesetzt, kann das Konto in Liquidation Only versetzen. Bei Evaluierungs- und finanzierten Konten werden diese Limits von der Firma kontrolliert, und sobald sie überschritten sind, lehnt das Konto neue eröffnende Orders bis zur nächsten Sitzung oder einem Reset ab." },
    { type: "heading",text: "5. Ein plattformseitiges Risiko- oder Wartungsereignis" },
    { type: "paragraph",html: "Manchmal hat die AutoLiq-Welle gar nichts mit Ihrem Konto zu tun. Wenn dieselbe Ablehnung in derselben Sekunde bei vielen Konten eintrifft, ist zumindest ein Teil dieser Episode ein <strong class='text-white'>plattformweites Ereignis</strong>, das mit einer nachrichtengetriebenen Margin-Änderung und dem Sitzungswechsel zusammenhängt, kein Fehler eines einzelnen Kontos. In diesen Fällen ist Abwarten und das Eröffnen eines Tickets meist die einzige echte Lösung." },
    { type: "heading",text: "So beheben Sie AutoLiq-50000.0%-Ablehnungen: Schritt für Schritt" },
    { type: "heading",text: "Datenvereinbarungen und Risikoparameter korrigieren" },
    {
      type: "steps",
      items: [
        { title: "Bereich für Vereinbarungen öffnen", html: "Öffnen Sie Ihre Tradovate-Kontoeinstellungen und gehen Sie zum Bereich für Marktdaten-/Börsen-<strong class='text-white'>Vereinbarungen</strong>." },
        { title: "Alle ausstehenden Vereinbarungen unterzeichnen", html: "Unterzeichnen Sie mindestens die Datenvereinbarungen für Nichtprofessionelle, damit die Echtzeit-Berechtigungen aktiv sind." },
        { title: "Risikoeinstellungen bestätigen", html: "Öffnen Sie <strong class='text-white'>Risk Settings</strong> und bestätigen Sie, dass Max Position, tägliche/wöchentliche Verlustlimits und eine eventuelle Auto-Liquidate-Schwelle dort stehen, wo Sie es erwarten, nicht versehentlich bei null oder einem winzigen Wert." },
        { title: "Gegebenenfalls bei Ihrer Firma nachfragen", html: "Bei einem Evaluierungs- oder finanzierten Konto eines Prop-Firms können Sie diese Werte in der Regel nicht selbst ändern, wenden Sie sich an die Firma, um zu bestätigen, dass das Konto nicht im Modus Liquidation Only ist." },
      ],
    },
    { type: "heading",text: "Einen Margin-Puffer durch Spitzen hindurch halten" },
    {
      type: "steps",
      items: [
        { title: "Verfügbare Margin vor dem Handel prüfen", html: "Prüfen Sie die <strong class='text-white'>verfügbare/überschüssige Margin</strong> Ihres Kontos im Verhältnis zur Position, die Sie eröffnen möchten." },
        { title: "Einen Puffer vorhalten", html: "Halten Sie einen Puffer deutlich über der Initial-Margin-Anforderung, da sich Anforderungen ohne Vorankündigung ändern können und die Firma mit oder ohne Warnung liquidieren kann." },
        { title: "Für Nachrichtenfenster die Größe reduzieren", html: "Wenn Sie durch ein Nachrichtenfenster hindurch halten müssen, reduzieren Sie die Größe, damit die erhöhte (Nachrichten-)Margin noch passt, oder bleiben Sie flat, bis sich die Margins normalisiert haben." },
      ],
    },
    { type: "heading",text: "Rund um Sitzungsschluss und Nachrichten handeln" },
    {
      type: "steps",
      items: [
        { title: "Das Sitzungsschluss-Fenster ermitteln", html: "Ermitteln Sie den <strong class='text-white'>Sitzungsschluss</strong> des Produkts und das Fenster von etwa 15 Minuten davor, in dem die Initial Margin übernimmt (bei vielen CME-Futures liegt der tägliche Reset gegen 17 Uhr Central)." },
        { title: "Flat gehen oder ausreichend Margin halten", html: "Gehen Sie entweder vor diesem Übergang flat oder stellen Sie sicher, dass Sie genügend Margin für die Übernacht-/Initial-Anforderung halten." },
        { title: "Nicht in Fenster mit erhöhter Margin eröffnen", html: "Eröffnen Sie rund um geplante Wirtschaftsveröffentlichungen keine neuen Positionen in das Fenster mit erhöhter Margin; warten Sie, bis die Plattform die normale Intraday-Margin wiederherstellt." },
        { title: "Ticket eröffnen, wenn es im flachen Zustand weiterbesteht", html: "Besteht die Ablehnung weiter, während Sie flat sind und sich innerhalb der normalen Handelszeiten bewegen, halten Sie den genauen Ablehnungstext fest und <strong class='text-white'>eröffnen Sie ein Support-Ticket</strong>, ein AutoLiq in derselben Sekunde bei mehreren Konten ist ein Plattformereignis, nicht Ihr Setup." },
      ],
    },
    { type: "heading",text: "Fehlerbehebungstabelle" },
    { type: "table", headers: ["Fehler","Bedeutung","Lösung"], rows: [
      ["AutoLiq 50000.0%","Das Konto befindet sich in der Auto-Liquidation (oder an deren Rand); neue eröffnende Orders sind blockiert","Prüfen, ob Sie flat/Liquidation Only sind, einen Margin-Puffer wiederherstellen, das Ereignis abwarten, dann neu einsteigen"],
      ["Order Rejected: Risk Parameters","Ein Risikolimit oder eine Berechtigungsprüfung ist fehlgeschlagen","Datenvereinbarungen unterzeichnen und die Einstellungen für Max Position / Verlustlimit bestätigen"],
      ["No Quote Available","Fehlendes Datenabonnement oder fehlende Berechtigung","Die Börsendaten abonnieren und die Vereinbarung für Nichtprofessionelle unterzeichnen"],
      ["Liquidation Only","Das Konto ist nach einer Limitüberschreitung auf schließende Orders beschränkt","Auf die nächste Sitzung/Woche warten oder das Konto von der Firma zurücksetzen lassen"],
      ["Insufficient Margin","Freie Margin liegt unter der Anforderung (oft nach einer Nachrichten-/Sitzungsschluss-Spitze)","Menge reduzieren oder Guthaben einzahlen, damit die überschüssige Margin die Anforderung deckt"],
    ] },
    { type: "heading",text: "Mit PickMyTrade verhindern" },
    { type: "paragraph",html: "PickMyTrade sitzt zwischen Ihren TradingView-Alerts und Tradovate, sodass eine fehlerhafte oder zeitlich ungünstige Order nie blind auf die Risiko-Engine trifft:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Berechtigungs- &amp; Risikofilter</strong>, berücksichtigt den Stand der Datenvereinbarungen und die Risikolimits Ihres Kontos, sodass Orders, die eine Risikoparameter- oder AutoLiq-Ablehnung auslösen würden, frühzeitig abgefangen werden.",
        "<strong class='text-white'>Mengen-/Symbolvalidierung</strong>, blockiert Orders, die Positionsgrenzen verletzen würden, bevor sie überhaupt gesendet werden.",
        "<strong class='text-white'>Sitzungsbewusstes Routing</strong>, Sie steuern, wann Alerts ausgelöst werden, und können die Automatisierung so aus den Nachrichten- und Sitzungsschluss-Margin-Fenstern heraushalten.",
        "<strong class='text-white'>Multi-Account-Synchronisierung</strong>, spiegelt die korrigierte Order auf alle verbundenen Konten, sodass eine Ablehnung Ihre Konten nicht aus dem Gleichschritt bringt.",
      ],
    },
    { type: "paragraph",html: "Statt eine AutoLiq-Ablehnung erst zu entdecken, nachdem sich Ihr Setup bereits weiterbewegt hat, halten Sie Ihre Automatisierung diszipliniert rund um genau die Bedingungen, die sie auslösen." },
  ], es: [
    { type: "paragraph",html: "Está operando futuros rápidos, ES, NQ, CL, su entrada sale y rebota de inmediato con el críptico rechazo <strong class='text-white'>&ldquo;AutoLiq 50000.0%&rdquo;</strong>. Parece que la plataforma acaba de borrar su ventaja. Lo tranquilizador es que ese mensaje no es un fallo aleatorio. Es el motor de riesgo diciéndole que la cuenta está en autoliquidación, o peligrosamente cerca de ella, y por eso no le deja acumular más riesgo. Y el momento importa más que cualquier otra cosa. Estos rechazos se concentran en torno al cierre diario de la sesión y a los picos de margen provocados por noticias, y una vez que lo sabe, la solución resulta obvia. A continuación veremos qué significa realmente el error, qué lo causa y cómo resolverlo rápido, además de cómo enrutar sus alertas a través de PickMyTrade evita que estos rechazos se coman en silencio sus ejecuciones." },
    {
      type: "checklist",
      heading: "Lista de verificación rápida para rechazos de órdenes AutoLiq",
      items: [
        "<strong class='text-white'>Compruebe si está en plano o en modo solo liquidación.</strong> Si la cuenta se está autoliquidando, las nuevas órdenes de apertura se bloquean por diseño.",
        "<strong class='text-white'>Firme todos los acuerdos de datos de mercado y de bolsa necesarios.</strong> Los acuerdos de datos sin firmar provocan en cascada errores de parámetros de riesgo y de cotización que aparecen como rechazos.",
        "<strong class='text-white'>Confirme sus ajustes de riesgo.</strong> Puede haberse activado un Max Position, un límite de pérdida diaria o un umbral de autoliquidación.",
        "<strong class='text-white'>Vigile el reloj en torno al cierre de la sesión.</strong> El margen intradía termina unos 15 minutos antes del cierre, cuando entra en vigor el margen inicial más alto.",
        "<strong class='text-white'>Evite mantener posiciones durante noticias importantes.</strong> Tradovate eleva los márgenes intradía de forma acusada antes de publicaciones económicas clave, lo que puede llevar una cuenta a la liquidación.",
        "<strong class='text-white'>Mantenga un colchón de margen.</strong> Los requisitos de margen pueden cambiar sin previo aviso, y la firma puede liquidar con o sin advertencia.",
      ],
    },
    { type: "heading",text: "Qué significa «AutoLiq 50000.0%»" },
    { type: "paragraph",html: "&ldquo;AutoLiq&rdquo; es la abreviatura de <strong class='text-white'>autoliquidación</strong>. Cuando Tradovate asocia este motivo a una orden rechazada, le está diciendo que la orden fue rechazada porque la cuenta se encuentra bajo una condición de liquidación automática, no por un error normal de enrutamiento. En lenguaje llano: la plataforma cree que su cuenta ya no cumple el requisito de margen, así que en lugar de aceptar una nueva posición intenta <em>reducir</em> el riesgo. No le permitirá agravar el problema." },
    { type: "paragraph",html: "Ese llamativo <strong class='text-white'>&ldquo;50000.0%&rdquo;</strong> es una cifra de riesgo generada por el sistema que aparece en el motivo del rechazo. Refleja una relación interna de margen/riesgo que el motor señala cuando una cuenta está muy metida en un estado de liquidación. Piense en ello como la forma que tiene la plataforma de decir &ldquo;el riesgo se sale de la escala&rdquo;, no como un número que usted fije o pueda ajustar directamente. Tradovate no publica la fórmula exacta de ese valor concreto, así que trate el porcentaje como una <em>etiqueta de síntoma</em>, no como un ajuste." },
    { type: "paragraph",html: "Este es el patrón que merece la pena grabarse: este rechazo casi siempre se concentra en torno a dos eventos, el <strong class='text-white'>cierre/reinicio diario de la sesión</strong> y las <strong class='text-white'>noticias económicas importantes</strong>. Tiende a dispararse justo cuando la sesión cambia, o cuando la volatilidad se dispara y Tradovate sube los márgenes para una gran publicación. Eso coincide exactamente con la política de márgenes publicada de Tradovate, por lo que la solución tiene que ver con el <em>momento y el margen</em>, no con reenviar la orden." },
    { type: "heading",text: "Principales causas de los rechazos AutoLiq en 2026" },
    { type: "heading",text: "1. Picos de margen en torno a noticias económicas" },
    { type: "paragraph",html: "Tradovate eleva temporalmente los márgenes intradía antes de publicaciones económicas clave, ha citado aumentos de hasta 4&times; sus tarifas estándar, y los mantiene elevados hasta que la volatilidad se calma. El múltiplo exacto varía según el producto y el evento, así que consulte siempre la tabla de márgenes vigente de Tradovate. Si mantiene una posición cuando llega ese salto y su cuenta no puede cubrir el nuevo requisito, el motor de riesgo puede llevar la cuenta a la autoliquidación y rechazar cualquier orden nueva." },
    { type: "heading",text: "2. Coincidir con la transición al margen inicial en el cierre de la sesión" },
    { type: "paragraph",html: "Las tarifas de margen intradía generalmente rigen desde la apertura del producto hasta <strong class='text-white'>15 minutos antes del cierre de la sesión</strong>, cuando se exige el <strong class='text-white'>margen inicial</strong> más alto para las posiciones mantenidas durante la noche. Una cuenta que está perfectamente cómoda con margen intradía puede quedarse de repente corta en esa transición, la misma ventana de última hora de la tarde en la que se agrupan estos rechazos AutoLiq." },
    { type: "heading",text: "3. Acuerdos de datos sin firmar y parámetros de riesgo activados" },
    { type: "paragraph",html: "Los rechazos de órdenes se remontan con frecuencia a <strong class='text-white'>acuerdos de datos de mercado o de bolsa sin firmar</strong>. Cuando faltan esos acuerdos, los datos en tiempo real y las autorizaciones fallan, y la plataforma muestra el fallo como rechazos de parámetros de riesgo y de tipo &ldquo;no quote&rdquo; que pueden acompañar o hacerse pasar por un estado AutoLiq. Firmar los acuerdos pendientes resuelve la mitad del problema relativa a las autorizaciones." },
    { type: "heading",text: "4. Ajustes de riesgo o límites de la prop firm ya superados" },
    { type: "paragraph",html: "Un <strong class='text-white'>tamaño Max Position, un límite de pérdida diaria o un umbral de autoliquidación</strong> configurados, ya sean suyos o fijados por su prop firm, pueden poner la cuenta en modo solo liquidación. En las cuentas de evaluación y financiadas, estos límites los controla la firma, y una vez superados la cuenta rechaza nuevas órdenes de apertura hasta la siguiente sesión o un reinicio." },
    { type: "heading",text: "5. Un evento de riesgo o de mantenimiento del lado de la plataforma" },
    { type: "paragraph",html: "A veces la oleada de AutoLiq no tiene nada que ver con su cuenta. Cuando el mismo rechazo llega a muchas cuentas en el mismo segundo exacto, al menos parte de ese episodio es un <strong class='text-white'>evento de toda la plataforma</strong> vinculado a un cambio de margen provocado por noticias y al cambio de sesión, no un fallo de una cuenta individual. En esos casos, esperar a que pase el evento y abrir un ticket suele ser la única solución real." },
    { type: "heading",text: "Cómo solucionar los rechazos AutoLiq 50000.0%: paso a paso" },
    { type: "heading",text: "Corregir los acuerdos de datos y los parámetros de riesgo" },
    {
      type: "steps",
      items: [
        { title: "Abra el área de acuerdos", html: "Abra los ajustes de su cuenta de Tradovate y vaya al área de <strong class='text-white'>acuerdos</strong> de datos de mercado / bolsa." },
        { title: "Firme todos los acuerdos pendientes", html: "Firme al menos los acuerdos de datos para no profesionales para que las autorizaciones en tiempo real estén activas." },
        { title: "Confirme sus ajustes de riesgo", html: "Abra <strong class='text-white'>Risk Settings</strong> y confirme que su Max Position, los límites de pérdida diaria/semanal y cualquier umbral de autoliquidación están donde espera, no a cero por accidente ni en algún valor diminuto." },
        { title: "Consulte con su firma si procede", html: "En una cuenta de evaluación o financiada de una prop firm, recuerde que normalmente no puede cambiar esto usted mismo, contacte con la firma para confirmar que la cuenta no está en modo solo liquidación." },
      ],
    },
    { type: "heading",text: "Mantener un colchón de margen durante los picos" },
    {
      type: "steps",
      items: [
        { title: "Compruebe el margen disponible antes de operar", html: "Compruebe el <strong class='text-white'>margen disponible/excedente</strong> de su cuenta frente a la posición que quiere abrir." },
        { title: "Mantenga un colchón", html: "Mantenga un colchón muy por encima del requisito de margen inicial, ya que los requisitos pueden cambiar sin previo aviso y la firma puede liquidar con o sin advertencia." },
        { title: "Reduzca el tamaño en las ventanas de noticias", html: "Si debe mantener una posición durante una ventana de noticias, reduzca el tamaño para que el margen elevado (de noticias) siga cabiendo, o permanezca en plano hasta que los márgenes se normalicen." },
      ],
    },
    { type: "heading",text: "Operar en torno al cierre de sesión y a las noticias" },
    {
      type: "steps",
      items: [
        { title: "Identifique la ventana de cierre de sesión", html: "Identifique el <strong class='text-white'>cierre de sesión</strong> del producto y la ventana de unos 15 minutos previa en la que el margen inicial toma el relevo (en muchos futuros de CME el reinicio diario cae en torno a las 5 PM Central)." },
        { title: "Cierre posiciones o mantenga margen suficiente", html: "Cierre las posiciones antes de esa transición o asegúrese de mantener margen suficiente para el requisito nocturno/inicial." },
        { title: "Evite abrir en ventanas de margen elevado", html: "En torno a las publicaciones económicas programadas, no abra posiciones nuevas dentro de la ventana de margen elevado; espere a que la plataforma restablezca el margen intradía normal." },
        { title: "Abra un ticket si persiste estando en plano", html: "Si el rechazo persiste mientras está en plano y dentro del horario normal, capture el texto exacto del rechazo y <strong class='text-white'>abra un ticket de soporte</strong>, un AutoLiq simultáneo en varias cuentas es un evento de la plataforma, no su configuración." },
      ],
    },
    { type: "heading",text: "Tabla de resolución de problemas" },
    { type: "table", headers: ["Error","Significado","Solución"], rows: [
      ["AutoLiq 50000.0%","La cuenta está en autoliquidación (o al borde de ella); las nuevas órdenes de apertura están bloqueadas","Confirme que está en plano/solo liquidación, restablezca un colchón de margen, espere a que pase el evento y vuelva a entrar"],
      ["Order Rejected: Risk Parameters","Falló una comprobación de límite de riesgo o de autorización","Firme los acuerdos de datos y confirme los ajustes de Max Position / límite de pérdida"],
      ["No Quote Available","Falta la suscripción de datos o la autorización","Suscríbase a los datos de la bolsa y firme el acuerdo para no profesionales"],
      ["Liquidation Only","Cuenta restringida a órdenes de cierre tras superar un límite","Espere a la siguiente sesión/semana o pida a la firma que reinicie la cuenta"],
      ["Insufficient Margin","El margen libre está por debajo del requisito (a menudo tras un pico por noticias/cierre de sesión)","Reduzca la cantidad o añada fondos para que el margen excedente cubra el requisito"],
    ] },
    { type: "heading",text: "Prevéngalo con PickMyTrade" },
    { type: "paragraph",html: "PickMyTrade se sitúa entre sus alertas de TradingView y Tradovate, de modo que una orden errónea o a destiempo nunca golpea a ciegas el motor de riesgo:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Filtros de autorización y riesgo</strong>, respeta el estado de los acuerdos de datos de su cuenta y sus límites de riesgo, de modo que las órdenes que provocarían un rechazo de parámetros de riesgo o AutoLiq se detectan pronto.",
        "<strong class='text-white'>Validación de cantidad / símbolo</strong>, bloquea las órdenes que superarían los límites de posición antes de que se envíen.",
        "<strong class='text-white'>Enrutamiento consciente de la sesión</strong>, usted controla cuándo se disparan las alertas, por lo que puede mantener la automatización fuera de las ventanas de margen de noticias y de cierre de sesión.",
        "<strong class='text-white'>Sincronización multicuenta</strong>, replica la orden corregida en todas las cuentas conectadas, de modo que un rechazo no deja sus cuentas desincronizadas.",
      ],
    },
    { type: "paragraph",html: "En lugar de descubrir un rechazo AutoLiq cuando su configuración ya se ha movido, mantiene su automatización disciplinada en torno a las condiciones exactas que lo provocan." },
  ], fr: [
    { type: "paragraph",html: "Vous tradez des futures rapides, ES, NQ, CL, votre entrée part et revient aussitôt avec le rejet énigmatique <strong class='text-white'>&ldquo;AutoLiq 50000.0%&rdquo;</strong>. On dirait que la plateforme vient d'effacer votre avantage. Voici la bonne nouvelle : ce message n'est pas un bug aléatoire. C'est le moteur de risque qui vous indique que le compte est en auto-liquidation, ou dangereusement proche de l'être, et qui refuse donc de vous laisser empiler davantage de risque. Et le timing compte plus que tout. Ces rejets se concentrent autour de la clôture quotidienne de la session et des pics de marge liés aux actualités, et une fois que vous le savez, la solution devient évidente. Ci-dessous, nous verrons ce que l'erreur signifie réellement, ce qui la cause et comment la résoudre rapidement, ainsi que la façon dont l'acheminement de vos alertes via PickMyTrade évite que ces rejets ne grignotent discrètement vos exécutions." },
    {
      type: "checklist",
      heading: "Liste de contrôle rapide pour les rejets d'ordres AutoLiq",
      items: [
        "<strong class='text-white'>Vérifiez si vous êtes à plat ou en liquidation seule.</strong> Si le compte est auto-liquidé, les nouveaux ordres d'ouverture sont bloqués par conception.",
        "<strong class='text-white'>Signez tous les accords de données de marché et de bourse requis.</strong> Les accords de données non signés entraînent en cascade des erreurs de paramètres de risque et de cotation qui apparaissent comme des rejets.",
        "<strong class='text-white'>Confirmez vos paramètres de risque.</strong> Un Max Position, une limite de perte quotidienne ou un seuil d'auto-liquidation a pu être déclenché.",
        "<strong class='text-white'>Surveillez l'heure autour de la clôture de la session.</strong> La marge intraday prend fin environ 15 minutes avant la clôture, lorsque la marge initiale plus élevée s'applique.",
        "<strong class='text-white'>Évitez de conserver vos positions pendant les annonces majeures.</strong> Tradovate relève fortement les marges intraday avant les publications économiques importantes, ce qui peut précipiter un compte en liquidation.",
        "<strong class='text-white'>Gardez un coussin de marge.</strong> Les exigences de marge peuvent changer sans préavis, et la firme peut liquider avec ou sans avertissement.",
      ],
    },
    { type: "heading",text: "Ce que signifie « AutoLiq 50000.0% »" },
    { type: "paragraph",html: "&ldquo;AutoLiq&rdquo; est l'abréviation d'<strong class='text-white'>auto-liquidation</strong>. Lorsque Tradovate associe ce motif à un ordre rejeté, cela signifie que l'ordre a été refusé parce que le compte est soumis à une condition de liquidation automatique, et non à cause d'une erreur d'acheminement ordinaire. En clair : la plateforme estime que votre compte ne satisfait plus son exigence de marge ; au lieu d'accepter une nouvelle position, elle cherche donc à <em>réduire</em> le risque. Elle ne vous laissera pas aggraver le problème." },
    { type: "paragraph",html: "Ce <strong class='text-white'>&ldquo;50000.0%&rdquo;</strong> accrocheur est une valeur de risque générée par le système et affichée dans le motif du rejet. Il reflète un ratio interne marge/risque que le moteur signale lorsqu'un compte est profondément engagé dans un état de liquidation. Voyez-y la façon qu'a la plateforme de dire &ldquo;le risque est hors échelle&rdquo;, et non un nombre que vous définissez ou pouvez régler directement. Tradovate ne publie pas la formule exacte derrière cette valeur précise ; considérez donc le pourcentage comme une <em>étiquette de symptôme</em>, pas comme un paramètre." },
    { type: "paragraph",html: "Voici le schéma à retenir : ce rejet se concentre presque toujours autour de deux événements, la <strong class='text-white'>clôture/réinitialisation quotidienne de la session</strong> et les <strong class='text-white'>annonces économiques majeures</strong>. Il tend à se déclencher juste au moment du changement de session, ou lorsque la volatilité grimpe et que Tradovate relève les marges pour une grande publication. Cela correspond exactement à la politique de marge publiée par Tradovate, c'est pourquoi la solution relève du <em>timing et de la marge</em>, et non du renvoi de l'ordre." },
    { type: "heading",text: "Principales causes des rejets AutoLiq en 2026" },
    { type: "heading",text: "1. Pics de marge autour des annonces économiques" },
    { type: "paragraph",html: "Tradovate relève temporairement les marges intraday avant les publications économiques importantes, elle a évoqué des hausses allant jusqu'à 4&times; ses taux standard, et les maintient élevées jusqu'à ce que la volatilité retombe. Le multiple exact varie selon le produit et l'événement ; consultez donc toujours le barème de marges actuel de Tradovate. Si vous détenez une position lorsque ce saut survient et que votre compte ne peut pas couvrir la nouvelle exigence, le moteur de risque peut placer le compte en auto-liquidation et rejeter tout nouvel ordre." },
    { type: "heading",text: "2. Tomber sur la transition vers la marge initiale à la clôture de la session" },
    { type: "paragraph",html: "Les taux de marge intraday s'appliquent généralement de l'ouverture du produit jusqu'à <strong class='text-white'>15 minutes avant la clôture de la session</strong>, moment où la <strong class='text-white'>marge initiale</strong> plus élevée est exigée pour les positions conservées pendant la nuit. Un compte parfaitement à l'aise en marge intraday peut soudain se retrouver à court lors de cette transition, la même fenêtre de fin d'après-midi où ces rejets AutoLiq se regroupent." },
    { type: "heading",text: "3. Accords de données non signés et paramètres de risque déclenchés" },
    { type: "paragraph",html: "Les rejets d'ordres remontent fréquemment à des <strong class='text-white'>accords de données de marché ou de bourse non signés</strong>. Lorsque ces accords manquent, les données en temps réel et les droits d'accès tombent, et la plateforme affiche l'échec sous forme de rejets de paramètres de risque et de type &ldquo;no quote&rdquo; qui peuvent accompagner ou imiter un état AutoLiq. Signer les accords en attente règle la moitié du problème liée aux droits d'accès." },
    { type: "heading",text: "4. Paramètres de risque ou limites de la prop firm déjà dépassés" },
    { type: "paragraph",html: "Une <strong class='text-white'>taille Max Position, une limite de perte quotidienne ou un seuil d'auto-liquidation</strong> configurés, qu'ils soient les vôtres ou fixés par votre prop firm, peut faire basculer le compte en liquidation seule. Sur les comptes d'évaluation et financés, ces limites sont contrôlées par la firme, et une fois dépassées, le compte rejette les nouveaux ordres d'ouverture jusqu'à la session suivante ou une réinitialisation." },
    { type: "heading",text: "5. Un événement de risque ou de maintenance côté plateforme" },
    { type: "paragraph",html: "Parfois, la vague d'AutoLiq n'a rien à voir avec votre compte. Lorsque le même rejet frappe de nombreux comptes à la seconde près, au moins une partie de l'épisode est un <strong class='text-white'>événement à l'échelle de la plateforme</strong> lié à un changement de marge dû aux actualités et au changement de session, et non à un défaut d'un compte individuel. Dans ces cas, attendre la fin de l'événement et ouvrir un ticket est généralement la seule vraie solution." },
    { type: "heading",text: "Comment corriger les rejets AutoLiq 50000.0% : pas à pas" },
    { type: "heading",text: "Corriger les accords de données et les paramètres de risque" },
    {
      type: "steps",
      items: [
        { title: "Ouvrez la zone des accords", html: "Ouvrez les paramètres de votre compte Tradovate et rendez-vous dans la zone des <strong class='text-white'>accords</strong> de données de marché / de bourse." },
        { title: "Signez tous les accords en attente", html: "Signez au minimum les accords de données pour non-professionnels afin que les droits d'accès en temps réel soient actifs." },
        { title: "Confirmez vos paramètres de risque", html: "Ouvrez <strong class='text-white'>Risk Settings</strong> et vérifiez que votre Max Position, vos limites de perte quotidienne/hebdomadaire et tout seuil d'auto-liquidation sont réglés là où vous l'attendez, et non accidentellement à zéro ou à une valeur minuscule." },
        { title: "Vérifiez auprès de votre firme le cas échéant", html: "Sur un compte d'évaluation ou financé d'une prop firm, rappelez-vous que vous ne pouvez généralement pas modifier cela vous-même, contactez la firme pour confirmer que le compte n'est pas en liquidation seule." },
      ],
    },
    { type: "heading",text: "Conserver un coussin de marge pendant les pics" },
    {
      type: "steps",
      items: [
        { title: "Vérifiez la marge disponible avant de trader", html: "Vérifiez la <strong class='text-white'>marge disponible/excédentaire</strong> de votre compte par rapport à la position que vous souhaitez ouvrir." },
        { title: "Gardez un coussin", html: "Gardez un coussin bien au-dessus de l'exigence de marge initiale, car les exigences peuvent changer sans préavis et la firme peut liquider avec ou sans avertissement." },
        { title: "Réduisez la taille pour les fenêtres d'actualités", html: "Si vous devez conserver une position pendant une fenêtre d'actualités, réduisez la taille pour que la marge relevée (actualités) reste couverte, ou restez simplement à plat jusqu'à ce que les marges se normalisent." },
      ],
    },
    { type: "heading",text: "Trader autour de la clôture de session et des actualités" },
    {
      type: "steps",
      items: [
        { title: "Identifiez la fenêtre de clôture de session", html: "Identifiez la <strong class='text-white'>clôture de session</strong> du produit et la fenêtre d'environ 15 minutes qui la précède, pendant laquelle la marge initiale prend le relais (pour de nombreux futures CME, la réinitialisation quotidienne tombe vers 17 h Central)." },
        { title: "Clôturez ou conservez assez de marge", html: "Soit vous clôturez avant cette transition, soit vous vous assurez de détenir assez de marge pour l'exigence overnight/initiale." },
        { title: "Évitez d'ouvrir dans les fenêtres de marge relevée", html: "Autour des publications économiques programmées, n'ouvrez pas de nouvelles positions dans la fenêtre de marge relevée ; attendez que la plateforme rétablisse la marge intraday normale." },
        { title: "Ouvrez un ticket si cela persiste à plat", html: "Si le rejet persiste alors que vous êtes à plat et dans les horaires normaux, capturez le texte exact du rejet et <strong class='text-white'>ouvrez un ticket de support</strong>, un AutoLiq simultané sur plusieurs comptes est un événement de la plateforme, pas votre configuration." },
      ],
    },
    { type: "heading",text: "Tableau de dépannage" },
    { type: "table", headers: ["Erreur","Signification","Solution"], rows: [
