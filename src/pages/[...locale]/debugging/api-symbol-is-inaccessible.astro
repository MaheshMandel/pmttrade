---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "api-symbol-is-inaccessible";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/debugging/${SLUG}`;

const META_TITLE = "Tradovate API 'Symbol Is Inaccessible' Fix";
const META_DESCRIPTION =
  "Fix Tradovate 'Symbol is inaccessible': add the CME market-data agreement and use a valid front-month contract to restore API quotes fast.";

// Short SEO title (<=60 chars) for locales where the shared h1 is too long for a SERP title.
const TITLE_OVERRIDE: Partial<Record<Locale, string>> = { es: "Tradovate API: solución a “Symbol is inaccessible”", it: "API Tradovate: risolvere “Symbol is inaccessible”" };

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate API", de: "Tradovate API", es: "Tradovate API", fr: "Tradovate API", it: "Tradovate API" },
  h1: { en: META_TITLE, de: "Tradovate API „Symbol Is Inaccessible“ beheben", es: "Cómo solucionar «Symbol is inaccessible» en la API de Tradovate", fr: "Corriger « Symbol is inaccessible » sur l'API Tradovate", it: "Come risolvere «Symbol is inaccessible» nell'API di Tradovate" },
  dek: { en: "One Symbol is inaccessible response quietly cuts off your quotes, no entries, no exits. Here's the entitlement block vs. the symbol block, and how to fix each.", de: "Eine einzige Symbol-is-inaccessible-Antwort kappt still Ihre Kursdaten, keine Einstiege, keine Ausstiege. Hier lernen Sie den Unterschied zwischen dem Berechtigungs-Block und dem Symbol-Block kennen und wie Sie jeden beheben.", es: "Una sola respuesta Symbol is inaccessible corta silenciosamente sus cotizaciones, sin entradas, sin salidas. Aquí tiene el bloqueo por derechos de acceso frente al bloqueo por símbolo, y cómo solucionar cada uno.", fr: "Une seule réponse Symbol is inaccessible coupe discrètement vos cotations, plus d'entrées, plus de sorties. Voici le blocage lié aux droits d'accès face au blocage lié au symbole, et comment corriger chacun d'eux.", it: "Una sola risposta Symbol is inaccessible interrompe silenziosamente le vostre quotazioni, niente entrate, niente uscite. Ecco il blocco da diritti dati contro il blocco da simbolo, e come risolvere ciascuno." },
  readTime: { en: "8 min read", de: "8 Minuten Lesezeit", es: "Lectura de 8 minutos", fr: "Lecture de 8 minutes", it: "Lettura di 8 minuti" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "You've got an ES or NQ bot humming along, and then one <code>Symbol is inaccessible</code> response quietly cuts off your quotes. No quotes means no entries and no exits, the bot just sits there blind while the market moves without you. Tradovate's market-data API hands this back as <code>{\"errorText\":\"Symbol is inaccessible\",\"errorCode\":\"UnknownSymbol\",\"mode\":\"None\"}</code>, and in 2026 it still shows up in two very different flavors: a hard <strong class='text-white'>entitlement block</strong> (no CME market-data agreement on file) and a soft <strong class='text-white'>symbol block</strong> (an expired or mistyped contract). It hits <code>md/subscribeQuote</code>, <code>md/getChart</code>, and historical tick requests alike, and it loves to strike right after code that ran fine for months. Here's every cause, every fix, and how PickMyTrade keeps the automation side of your stack running when a feed or symbol goes dark." },
    {
      type: "checklist",
      heading: "Quick Checklist for \"Symbol Is Inaccessible\"",
      items: [
        "<strong class='text-white'>No CME market-data agreement on file</strong>, accept and subscribe to the CME data agreement in Tradovate before any real-time API quote request will resolve.",
        "<strong class='text-white'>Prop or evaluation account</strong>, only your account provider can enable data. Contact your firm, not Tradovate.",
        "<strong class='text-white'>Expired or wrong-format symbol</strong>, request the <em>current</em> front-month contract in <code>ROOT + month-code + year</code> form (for example <code>ESZ4</code>), never a rolled-off month.",
        "<strong class='text-white'>API Access add-on not active</strong>, confirm the API Access subscription is on and your live account meets Tradovate's current funding requirement.",
        "<strong class='text-white'>Stale session or entitlement</strong>, re-authenticate, then update the market-data subscription and place a fresh order if the platform prompts you to.",
        "<strong class='text-white'>Redistributing data</strong>, sending quotes downstream to other users needs a separate CME data-distributor registration.",
      ],
    },
    { type: "heading", text: "What \"Symbol Is Inaccessible\" Means" },
    { type: "paragraph", html: "Despite the <code>UnknownSymbol</code> error code, this message rarely means the contract literally doesn't exist. In most cases your WebSocket request was well-formed and reached the server just fine, the server simply refuses to stream that instrument to <em>your</em> login. It's an authorization and entitlement response dressed up as a lookup failure. The tell is consistency: when the same call fails regardless of which symbol or ID you throw at it, you're looking at a missing market-data agreement, not a typo." },
    { type: "paragraph", html: "There are two root buckets. The first is licensing. Real-time CME (and other exchange) data over the API is gated behind an exchange market-data agreement and fee, and without it every subscription bounces back as inaccessible. The second is the symbol itself. Futures contracts expire, so a symbol that was the front month last quarter, say an expired ES month, is no longer a tradable listing, and Tradovate treats it as inaccessible. Sorting out which bucket you're in is the whole job, so start by testing whether <em>any</em> live symbol resolves." },
    { type: "heading", text: "Top Causes of \"Symbol Is Inaccessible\" in 2026" },
    { type: "heading", text: "1. Missing CME Market-Data Agreement" },
    { type: "paragraph", html: "This is the number-one cause, and it's blunt: the error shows up because you don't have the CME market-data agreement on file with Tradovate. Real-time exchange data over the API now carries a monthly exchange fee on top of Tradovate's own charges. Exact pricing depends on the exchange and on your license type (non-professional vs. professional / non-display), and it moves over time, so treat any specific dollar figure you find in an old post as stale and check the current CME and Tradovate rates." },
    { type: "heading", text: "2. A Prop or Evaluation Account You Don't Control" },
    { type: "paragraph", html: "If your account is with a prop firm or evaluation service, you can't enable market data yourself. Data entitlements sit with the account provider, so an API login tied to an evaluation will keep returning &ldquo;Symbol is inaccessible&rdquo; until the firm turns data on for that account. The fix is to contact your firm's support, not Tradovate's." },
    { type: "heading", text: "3. Expired or Wrong-Format Contract Symbol" },
    { type: "paragraph", html: "Even fully entitled accounts hit this error when they request a contract that has rolled off, or a symbol in the wrong shape. Tradovate expects the standard CME front-month convention: a root symbol, a month code, and a year digit, for example <code>ESZ4</code>, <code>NQZ4</code>, <code>MESH5</code>. A continuous root alone, a delisted month, or a mistyped code can all resolve as inaccessible." },
    { type: "heading", text: "4. API Access Add-On Not Active" },
    { type: "paragraph", html: "The Tradovate Market Data API is a paid add-on layered on a qualifying live account. If the API Access subscription lapses, or the account no longer meets Tradovate's current minimum-balance requirement, market-data calls stop authorizing. Confirm the add-on is active in Application Settings before you go chasing deeper causes." },
    { type: "heading", text: "5. Stale Session, or a Data-Distributor Requirement" },
    { type: "paragraph", html: "A couple of edge cases round out the list. Code that worked can suddenly fail after a stretch of inactivity, and re-authenticating the session usually clears it, when prompted, update the market-data subscription and place a fresh order too. Separately, if you intend to <em>redistribute</em> Tradovate/CME quotes to other users, you have to register as a data distributor through the CME's contact process. Ordinary self-use doesn't need this, but distribution does." },
    { type: "heading", text: "How to Fix \"Symbol Is Inaccessible\": Step-by-Step" },
    { type: "heading", text: "Fixing a Missing CME Data Agreement" },
    {
      type: "list",
      items: [
        "Log in to the Tradovate web or desktop platform with the same live account your API key authenticates against.",
        "Open <strong class='text-white'>Application Settings</strong> and go to the market-data / add-ons area where subscriptions are managed.",
        "Find the market-data subscription and <strong class='text-white'>accept the CME (and any other exchange) market-data agreement</strong>, then subscribe to the exchange feed you need.",
        "Confirm the subscription shows as active, then re-run your <code>md/subscribeQuote</code> call. A previously failing symbol should now stream.",
      ],
    },
    { type: "heading", text: "Enabling Data on a Prop or Evaluation Account" },
    {
      type: "list",
      items: [
        "Identify who owns the account, a prop firm or evaluation provider, not you.",
        "Don't try to accept a data agreement inside Tradovate. The option is controlled upstream and won't stick.",
        "Contact the firm's support and ask them to enable market data (and API access if applicable) for your specific account.",
        "Once they confirm, re-authenticate and retry your subscription.",
      ],
    },
    { type: "heading", text: "Using a Valid Front-Month Contract Symbol" },
    {
      type: "list",
      items: [
        "Query Tradovate for the currently tradable contract instead of hard-coding a month. Use the contract/product lookup endpoints (for example <code>/contract/find</code> or <code>/product/find</code>) to get the live front-month name.",
        "Build the symbol as <code>ROOT + month-code + year</code>, for instance <code>ESZ4</code> for the December E-mini S&amp;P 500.",
        "Replace any expired month in your code with the value the lookup returned.",
        "Re-subscribe. If entitlements are correct, a valid front-month symbol resolves immediately.",
      ],
    },
    { type: "heading", text: "Refreshing a Stale Session or Entitlement" },
    {
      type: "list",
      items: [
        "Discard your cached access token and re-run the authentication flow to get a fresh token.",
        "If the platform shows a prompt to update the market-data subscription, complete it, then place a small order or re-open the position screen so the entitlement re-checks.",
        "Reconnect the market-data WebSocket and re-issue the subscription.",
        "If it still fails across <em>every</em> symbol, loop back to Cause 1, the agreement, not the session, is the blocker.",
      ],
    },
    { type: "heading", text: "Troubleshooting Table" },
    {
      type: "table",
      headers: ["Error", "Meaning", "Fix"],
      rows: [
        ["{\"errorText\":\"Symbol is inaccessible\",\"errorCode\":\"UnknownSymbol\"} on every symbol", "No exchange market-data agreement on file", "Accept the CME data agreement and subscribe to the feed"],
        ["Inaccessible only on one prop/eval account", "Data controlled by your account provider", "Ask your prop firm to enable market data"],
        ["Inaccessible on a specific contract", "Expired or wrong-format symbol", "Look up and use the current front-month (e.g. ESZ4)"],
        ["Was working, now fails after idle time", "Stale session / entitlement", "Re-authenticate; update subscription and place a fresh order"],
        ["Fails right after adding API integration", "API Access add-on inactive or account underfunded", "Re-enable API Access on a funded live account"],
        ["Fails when serving quotes to other users", "No data-distributor registration", "Register as a distributor via CME's contact process"],
      ],
    },
    { type: "heading", text: "Prevent This with PickMyTrade" },
    { type: "paragraph", html: "PickMyTrade sits between TradingView and Tradovate, so the automation half of your stack stays healthy even when a feed or symbol misbehaves:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Symbol Validation &amp; Front-Month Resolution</strong>, maps your alert to the live, tradable contract so a rolled-off month never reaches Tradovate as an order.",
        "<strong class='text-white'>Entitlement-Aware Routing</strong>, respects your account and data-agreement state, so trades aren't fired blind against a feed you can't read.",
        "<strong class='text-white'>Managed Authentication</strong>, keeps tokens and sessions fresh, so a stale login doesn't silently block your workflow.",
        "<strong class='text-white'>Multi-Account Sync</strong>, mirrors the corrected order across every connected account in one pass.",
      ],
    },
  ], de: [
    { type: "paragraph", html: "Ihr ES- oder NQ-Bot läuft rund, und dann kappt eine einzige <code>Symbol is inaccessible</code>-Antwort still Ihre Kursdaten. Keine Kurse bedeuten keine Einstiege und keine Ausstiege, der Bot sitzt blind da, während sich der Markt ohne Sie bewegt. Tradovates Market-Data-API gibt dies als <code>{\"errorText\":\"Symbol is inaccessible\",\"errorCode\":\"UnknownSymbol\",\"mode\":\"None\"}</code> zurück, und im Jahr 2026 taucht es immer noch in zwei sehr unterschiedlichen Varianten auf: ein harter <strong class='text-white'>Berechtigungs-Block</strong> (keine CME-Marktdatenvereinbarung hinterlegt) und ein weicher <strong class='text-white'>Symbol-Block</strong> (ein abgelaufener oder falsch geschriebener Kontrakt). Er betrifft <code>md/subscribeQuote</code>, <code>md/getChart</code> und historische Tick-Anfragen gleichermaßen, und er schlägt gerne direkt nach Code zu, der monatelang einwandfrei lief. Hier finden Sie jede Ursache, jede Lösung und wie PickMyTrade die Automatisierungsseite Ihres Stacks am Laufen hält, wenn ein Feed oder Symbol ausfällt." },
    {
      type: "checklist",
      heading: "Kurz-Checkliste für „Symbol Is Inaccessible“",
      items: [
        "<strong class='text-white'>Keine CME-Marktdatenvereinbarung hinterlegt</strong>, akzeptieren Sie die CME-Datenvereinbarung in Tradovate und abonnieren Sie sie, bevor eine Echtzeit-API-Kursanfrage aufgelöst werden kann.",
        "<strong class='text-white'>Prop- oder Evaluierungskonto</strong>, nur Ihr Kontoanbieter kann Daten aktivieren. Wenden Sie sich an Ihre Firma, nicht an Tradovate.",
        "<strong class='text-white'>Abgelaufenes oder falsch formatiertes Symbol</strong>, fordern Sie den <em>aktuellen</em> Frontmonat-Kontrakt im Format <code>ROOT + Monatscode + Jahr</code> an (zum Beispiel <code>ESZ4</code>), niemals einen abgelaufenen Monat.",
        "<strong class='text-white'>API-Access-Add-on nicht aktiv</strong>, bestätigen Sie, dass das API-Access-Abo aktiv ist und Ihr Live-Konto Tradovates aktuelle Mindestkapitalanforderung erfüllt.",
        "<strong class='text-white'>Veraltete Sitzung oder Berechtigung</strong>, authentifizieren Sie sich erneut und aktualisieren Sie dann das Marktdaten-Abo und platzieren Sie eine neue Order, falls die Plattform Sie dazu auffordert.",
        "<strong class='text-white'>Datenweiterverteilung</strong>, das Weitergeben von Kursen an andere Nutzer erfordert eine separate CME-Datenvertriebs-Registrierung.",
      ],
    },
    { type: "heading", text: "Was „Symbol Is Inaccessible“ bedeutet" },
    { type: "paragraph", html: "Trotz des <code>UnknownSymbol</code>-Fehlercodes bedeutet diese Meldung selten, dass der Kontrakt buchstäblich nicht existiert. In den meisten Fällen war Ihre WebSocket-Anfrage korrekt formuliert und erreichte den Server problemlos, der Server weigert sich schlicht, dieses Instrument an <em>Ihren</em> Login zu streamen. Es ist eine Autorisierungs- und Berechtigungsantwort, die als Lookup-Fehler getarnt ist. Der Hinweis ist die Konsistenz: Wenn derselbe Aufruf unabhängig davon fehlschlägt, welches Symbol oder welche ID Sie ihm vorwerfen, geht es um eine fehlende Marktdatenvereinbarung, nicht um einen Tippfehler." },
    { type: "paragraph", html: "Es gibt zwei Grundkategorien. Die erste ist die Lizenzierung. Echtzeit-CME-Daten (und Daten anderer Börsen) über die API sind hinter einer Marktdatenvereinbarung und Gebühr der Börse verriegelt, und ohne diese kommt jedes Abo als unzugänglich zurück. Die zweite ist das Symbol selbst. Futures-Kontrakte laufen ab, sodass ein Symbol, das letztes Quartal der Frontmonat war, sagen wir ein abgelaufener ES-Monat, kein handelbares Listing mehr ist, und Tradovate behandelt es als unzugänglich. Herauszufinden, in welcher Kategorie Sie sich befinden, ist die eigentliche Aufgabe, testen Sie also zunächst, ob <em>irgendein</em> aktuelles Symbol sich auflösen lässt." },
    { type: "heading", text: "Häufigste Ursachen für „Symbol Is Inaccessible“ im Jahr 2026" },
    { type: "heading", text: "1. Fehlende CME-Marktdatenvereinbarung" },
    { type: "paragraph", html: "Dies ist die häufigste Ursache, und sie ist unverblümt: Der Fehler taucht auf, weil Sie keine CME-Marktdatenvereinbarung bei Tradovate hinterlegt haben. Echtzeit-Börsendaten über die API tragen inzwischen eine monatliche Börsengebühr zusätzlich zu Tradovates eigenen Gebühren. Der genaue Preis hängt von der Börse und Ihrem Lizenztyp ab (nicht-professionell vs. professionell / Non-Display) und ändert sich mit der Zeit, betrachten Sie also jeden konkreten Dollarbetrag, den Sie in einem alten Beitrag finden, als veraltet und prüfen Sie die aktuellen CME- und Tradovate-Tarife." },
    { type: "heading", text: "2. Ein Prop- oder Evaluierungskonto, das Sie nicht kontrollieren" },
    { type: "paragraph", html: "Wenn Ihr Konto bei einer Prop-Firma oder einem Evaluierungsanbieter liegt, können Sie Marktdaten nicht selbst aktivieren. Datenberechtigungen liegen beim Kontoanbieter, sodass ein API-Login, der an eine Evaluierung gebunden ist, weiterhin „Symbol is inaccessible“ zurückgibt, bis die Firma die Daten für dieses Konto aktiviert. Die Lösung besteht darin, den Support Ihrer Firma zu kontaktieren, nicht den von Tradovate." },
    { type: "heading", text: "3. Abgelaufenes oder falsch formatiertes Kontraktsymbol" },
    { type: "paragraph", html: "Selbst vollständig berechtigte Konten stoßen auf diesen Fehler, wenn sie einen abgelaufenen Kontrakt oder ein falsch geformtes Symbol anfordern. Tradovate erwartet die übliche CME-Frontmonat-Konvention: ein Root-Symbol, einen Monatscode und eine Jahresziffer, zum Beispiel <code>ESZ4</code>, <code>NQZ4</code>, <code>MESH5</code>. Ein alleiniger Continuous-Root, ein delisteter Monat oder ein falsch eingegebener Code können allesamt als unzugänglich aufgelöst werden." },
    { type: "heading", text: "4. API-Access-Add-on nicht aktiv" },
    { type: "paragraph", html: "Die Tradovate Market Data API ist ein kostenpflichtiges Add-on, das auf ein qualifizierendes Live-Konto aufsetzt. Läuft das API-Access-Abo aus oder erfüllt das Konto die aktuelle Mindestguthaben-Anforderung von Tradovate nicht mehr, hören Marktdatenaufrufe auf, autorisiert zu werden. Bestätigen Sie in den Application Settings, dass das Add-on aktiv ist, bevor Sie tiefer nach Ursachen suchen." },
    { type: "heading", text: "5. Veraltete Sitzung oder eine Datenvertriebs-Anforderung" },
    { type: "paragraph", html: "Ein paar Randfälle runden die Liste ab. Code, der funktionierte, kann nach einer Phase der Inaktivität plötzlich fehlschlagen, und eine erneute Authentifizierung der Sitzung behebt das meist, wenn Sie dazu aufgefordert werden, aktualisieren Sie auch das Marktdaten-Abo und platzieren eine neue Order. Getrennt davon: Wenn Sie beabsichtigen, Tradovate-/CME-Kurse an andere Nutzer <em>weiterzuverteilen</em>, müssen Sie sich über den Kontaktprozess der CME als Datenvertrieb registrieren. Für die gewöhnliche Eigennutzung ist das nicht erforderlich, für die Verteilung schon." },
    { type: "heading", text: "So beheben Sie „Symbol Is Inaccessible“: Schritt für Schritt" },
    { type: "heading", text: "Eine fehlende CME-Datenvereinbarung beheben" },
    {
      type: "list",
      items: [
        "Melden Sie sich in der Tradovate-Web- oder Desktop-Plattform mit demselben Live-Konto an, gegen das sich Ihr API-Schlüssel authentifiziert.",
        "Öffnen Sie <strong class='text-white'>Application Settings</strong> und gehen Sie zum Bereich Marktdaten / Add-ons, in dem Abos verwaltet werden.",
        "Finden Sie das Marktdaten-Abo und <strong class='text-white'>akzeptieren Sie die CME- (und jede andere Börsen-) Marktdatenvereinbarung</strong>, abonnieren Sie dann den benötigten Börsen-Feed.",
        "Bestätigen Sie, dass das Abo als aktiv angezeigt wird, und führen Sie dann Ihren <code>md/subscribeQuote</code>-Aufruf erneut aus. Ein zuvor fehlgeschlagenes Symbol sollte nun streamen.",
      ],
    },
    { type: "heading", text: "Daten auf einem Prop- oder Evaluierungskonto aktivieren" },
    {
      type: "list",
      items: [
        "Ermitteln Sie, wem das Konto gehört, einer Prop-Firma oder einem Evaluierungsanbieter, nicht Ihnen.",
        "Versuchen Sie nicht, eine Datenvereinbarung innerhalb von Tradovate zu akzeptieren. Die Option wird vorgelagert gesteuert und bleibt nicht bestehen.",
        "Kontaktieren Sie den Support der Firma und bitten Sie ihn, Marktdaten (und API-Zugriff, falls zutreffend) für Ihr spezifisches Konto zu aktivieren.",
        "Sobald dies bestätigt ist, authentifizieren Sie sich erneut und versuchen Sie Ihr Abo erneut.",
      ],
    },
    { type: "heading", text: "Ein gültiges Frontmonat-Kontraktsymbol verwenden" },
    {
      type: "list",
      items: [
        "Fragen Sie Tradovate nach dem aktuell handelbaren Kontrakt, anstatt einen Monat fest einzuprogrammieren. Verwenden Sie die Contract-/Product-Lookup-Endpunkte (zum Beispiel <code>/contract/find</code> oder <code>/product/find</code>), um den aktuellen Frontmonat-Namen zu erhalten.",
        "Bauen Sie das Symbol als <code>ROOT + Monatscode + Jahr</code> auf, zum Beispiel <code>ESZ4</code> für den Dezember-E-mini-S&amp;P-500.",
        "Ersetzen Sie jeden abgelaufenen Monat in Ihrem Code durch den vom Lookup zurückgegebenen Wert.",
        "Abonnieren Sie erneut. Sind die Berechtigungen korrekt, löst sich ein gültiges Frontmonat-Symbol sofort auf.",
      ],
    },
    { type: "heading", text: "Eine veraltete Sitzung oder Berechtigung auffrischen" },
    {
      type: "list",
      items: [
        "Verwerfen Sie Ihr gecachtes Zugriffstoken und führen Sie den Authentifizierungsablauf erneut aus, um ein frisches Token zu erhalten.",
        "Wenn die Plattform eine Aufforderung zur Aktualisierung des Marktdaten-Abos anzeigt, schließen Sie diese ab, platzieren Sie dann eine kleine Order oder öffnen Sie den Positionsbildschirm erneut, damit die Berechtigung neu geprüft wird.",
        "Verbinden Sie den Marktdaten-WebSocket neu und stellen Sie das Abo erneut aus.",
        "Wenn es weiterhin bei <em>jedem</em> Symbol fehlschlägt, kehren Sie zu Ursache 1 zurück, die Vereinbarung, nicht die Sitzung, ist die Blockade.",
      ],
    },
    { type: "heading", text: "Fehlerbehebungstabelle" },
    {
      type: "table",
      headers: ["Fehler", "Bedeutung", "Lösung"],
      rows: [
        ["{\"errorText\":\"Symbol is inaccessible\",\"errorCode\":\"UnknownSymbol\"} bei jedem Symbol", "Keine Börsen-Marktdatenvereinbarung hinterlegt", "CME-Datenvereinbarung akzeptieren und den Feed abonnieren"],
        ["Unzugänglich nur bei einem Prop-/Evaluierungskonto", "Daten werden von Ihrem Kontoanbieter kontrolliert", "Ihre Prop-Firma bitten, Marktdaten zu aktivieren"],
        ["Unzugänglich bei einem bestimmten Kontrakt", "Abgelaufenes oder falsch formatiertes Symbol", "Aktuellen Frontmonat nachschlagen und verwenden (z. B. ESZ4)"],
        ["Funktionierte, schlägt nach Inaktivität fehl", "Veraltete Sitzung / Berechtigung", "Erneut authentifizieren; Abo aktualisieren und neue Order platzieren"],
        ["Schlägt direkt nach Hinzufügen der API-Integration fehl", "API-Access-Add-on inaktiv oder Konto unterfinanziert", "API Access auf einem finanzierten Live-Konto reaktivieren"],
        ["Schlägt beim Bereitstellen von Kursen für andere Nutzer fehl", "Keine Datenvertriebs-Registrierung", "Über den Kontaktprozess der CME als Vertrieb registrieren"],
      ],
    },
    { type: "heading", text: "So verhindern Sie das mit PickMyTrade" },
    { type: "paragraph", html: "PickMyTrade sitzt zwischen TradingView und Tradovate, sodass die Automatisierungsseite Ihres Stacks gesund bleibt, selbst wenn ein Feed oder Symbol Probleme macht:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Symbolvalidierung &amp; Frontmonat-Auflösung</strong>, ordnet Ihren Alert dem aktuellen, handelbaren Kontrakt zu, sodass ein abgelaufener Monat nie als Order bei Tradovate ankommt.",
        "<strong class='text-white'>Berechtigungsbewusstes Routing</strong>, respektiert den Status Ihres Kontos und Ihrer Datenvereinbarung, sodass Trades nicht blind gegen einen Feed abgefeuert werden, den Sie nicht lesen können.",
        "<strong class='text-white'>Verwaltete Authentifizierung</strong>, hält Token und Sitzungen frisch, sodass ein veralteter Login Ihren Workflow nicht still blockiert.",
        "<strong class='text-white'>Multi-Account-Sync</strong>, spiegelt die korrigierte Order über jedes verbundene Konto in einem Durchgang.",
      ],
    },
  ], es: [
    { type: "paragraph", html: "Su bot de ES o NQ está funcionando sin problemas, y de repente una respuesta <code>Symbol is inaccessible</code> corta silenciosamente sus cotizaciones. Sin cotizaciones no hay entradas ni salidas, el bot simplemente se queda ahí, ciego, mientras el mercado se mueve sin usted. La API de datos de mercado de Tradovate devuelve esto como <code>{\"errorText\":\"Symbol is inaccessible\",\"errorCode\":\"UnknownSymbol\",\"mode\":\"None\"}</code>, y en 2026 todavía aparece en dos variantes muy distintas: un <strong class='text-white'>bloqueo de derechos de acceso</strong> duro (sin acuerdo de datos de mercado de la CME registrado) y un <strong class='text-white'>bloqueo de símbolo</strong> blando (un contrato caducado o mal escrito). Afecta por igual a <code>md/subscribeQuote</code>, <code>md/getChart</code> y a las solicitudes de datos históricos por ticks, y le encanta atacar justo después de un código que funcionó bien durante meses. Aquí tiene todas las causas, todas las soluciones, y cómo PickMyTrade mantiene sana la mitad de automatización de su stack cuando un feed o símbolo falla." },
    {
