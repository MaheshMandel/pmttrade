---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "eval-hidden-hide-failed-accounts";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/debugging/${SLUG}`;

const META_TITLE = "Tradovate Eval Missing: 'Hide Failed Accounts' On";
const META_DESCRIPTION =
  "Eval account card missing after login? Switch off the Hide Failed Accounts toggle to reveal it, plus why platform access needs an active account.";

// Short SEO title (<=60 chars) for locales where the shared h1 is too long for a SERP title.
const TITLE_OVERRIDE: Partial<Record<Locale, string>> = { de: "Tradovate-Eval-Konto fehlt: „Hide Failed Accounts“ aktiv", es: "Tradovate: falta la cuenta eval con “Hide Failed Accounts”", fr: "Tradovate : compte eval introuvable (Hide Failed Accounts)" };

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Tradovate-Eval-Konto fehlt: 'Hide Failed Accounts' ist aktiviert", es: "Falta la cuenta eval de Tradovate: 'Hide Failed Accounts' activado", fr: "Compte eval Tradovate introuvable : 'Hide Failed Accounts' activé", it: "Conto eval Tradovate mancante: 'Hide Failed Accounts' attivo" },
  dek: { en: "The account panel looks empty, or shows fewer accounts than you paid for. Before you assume the worst, check one small setting: a &ldquo;Hide Failed Accounts&rdquo; filter that quietly strips flagged accounts out of view.", de: "Das Kontopanel wirkt leer oder zeigt weniger Konten an, als Sie bezahlt haben. Bevor Sie vom Schlimmsten ausgehen, prüfen Sie eine kleine Einstellung: einen &ldquo;Hide Failed Accounts&rdquo;-Filter, der markierte Konten unauffällig aus der Ansicht entfernt.", es: "El panel de cuentas parece vacío o muestra menos cuentas de las que ha pagado. Antes de pensar lo peor, revise un pequeño ajuste: un filtro &ldquo;Hide Failed Accounts&rdquo; que retira discretamente las cuentas marcadas de la vista.", fr: "Le panneau de comptes semble vide ou affiche moins de comptes que ceux que vous avez payés. Avant de craindre le pire, vérifiez un petit réglage : un filtre &laquo; Hide Failed Accounts &raquo; qui retire discrètement les comptes signalés de l'affichage.", it: "Il pannello degli account sembra vuoto o mostra meno account di quelli acquistati. Prima di pensare al peggio, controlli un'impostazione minore: un filtro &ldquo;Hide Failed Accounts&rdquo; che rimuove silenziosamente dalla vista gli account contrassegnati." },
  readTime: { en: "8 min read", de: "8 Minuten Lesezeit", es: "Lectura de 8 minutos", fr: "Lecture de 8 minutes", it: "Lettura di 8 minuti" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "You sign in expecting to see your evaluation account, and the card just isn't there. The panel looks empty, or it's showing fewer accounts than you paid for. Before you assume the worst, a blown eval, a billing glitch, a support ticket that takes days, check one small setting first. Most of the time an account card goes missing because a <strong class='text-white'>&ldquo;Hide Failed Accounts&rdquo; filter is switched on</strong>, quietly stripping any flagged account out of your view. Flip it off and the card comes right back. The harder truth sits directly behind that switch: if the card is hidden because the account actually failed, un-hiding it won't hand you back the ability to trade. Platform access needs at least one <em>active</em> account. This guide walks through both halves in 2026, how to unhide a card that's only filtered out, and what's really going on when the card is missing because the account is no longer alive." },
    {
      type: "checklist",
      heading: "Quick Checklist When Your Account Card Is Missing",
      items: [
        "<strong class='text-white'>Turn off &ldquo;Hide Failed Accounts&rdquo; first.</strong> It's the single most common reason a card vanishes, and it's a one-click fix.",
        "<strong class='text-white'>Confirm you're on the right login.</strong> A personal account and a prop-firm evaluation are two different sign-ins, the eval only shows under the credentials that own it.",
        "<strong class='text-white'>Check whether the account actually failed.</strong> A breached drawdown or loss limit flags the account, and flagged accounts get hidden or removed.",
        "<strong class='text-white'>Give a fresh purchase time to provision.</strong> A brand-new eval can take a little while to appear after checkout.",
        "<strong class='text-white'>Remember the hard rule:</strong> if every account is failed, the platform can lock you out entirely, you need one active account to get in.",
        "<strong class='text-white'>Loop in your prop firm</strong> for anything they own: resets, reactivations, or an account that never provisioned.",
      ],
    },
    { type: "heading", text: "What &ldquo;Account Card Missing&rdquo; Actually Means" },
    { type: "paragraph", html: "When you open the platform, your accounts show up as cards in an account panel, each one with its balance, status, and controls. If you trade with a prop firm, you might have several of these stacked up: a couple of evaluations, maybe a funded account, sometimes a demo. That panel isn't just a static list. It has a filter that decides which accounts you actually see, and one of those filters hides accounts that have been marked as failed. It's meant to keep your view clean once an eval is done. The side effect is obvious the moment it bites you: an account you're looking for silently drops off the screen, and it looks like it disappeared." },
    { type: "paragraph", html: "So &ldquo;my account card is missing&rdquo; usually isn't a bug at all. It's a view setting doing exactly what it was told. The trick is separating the two situations that look identical on screen. In the first, the account is fine and it's simply being filtered out of sight, flip the switch and you're done. In the second, the account is hidden <em>because</em> it failed, and the missing card is the symptom of a bigger problem: that account can't trade anymore. Both show up as an empty spot in the panel, which is why so many traders burn time chasing the wrong fix." },
    { type: "heading", text: "Why Your Eval Account Card Is Missing" },
    { type: "heading", text: "1. The &ldquo;Hide Failed Accounts&rdquo; filter is switched on" },
    { type: "paragraph", html: "This is the headline cause and the easiest to fix. When the filter is on, any account carrying a failed status is pulled out of the panel, even if you were mid-way through it moments ago, or you just want to review it. The card isn't gone; it's filtered. Turn the switch off and every account, failed ones included, comes back into view. If the account you were missing reappears looking perfectly normal, great, a stray filter was the whole story." },
    { type: "heading", text: "2. The account genuinely failed a rule" },
    { type: "paragraph", html: "Sometimes the card is hidden for a reason. Blow through a trailing drawdown, trip a daily or weekly loss limit, or break another firm rule, and the evaluation gets flagged as failed. On a flagged account the platform revokes the ability to place orders, the account exists, but it's read-only. Un-hiding it will show you the card with a failed label, and that's an important signal, not a fix. You're seeing a dead account, not a recoverable one." },
    { type: "heading", text: "3. You're signed into the wrong account" },
    { type: "paragraph", html: "A prop-firm evaluation and a personal account are separate logins with separate credentials. Sign in with your own personal account and the eval simply isn't there, you'll often land on a &ldquo;Fund Your Account&rdquo; prompt instead, because the platform sees an empty personal account with nothing to trade. That's a classic mix-up, and it has nothing to do with any filter. If that's your situation, the fix is a clean sign-out and re-login with the firm-issued credentials." },
    { type: "heading", text: "4. A new purchase hasn't provisioned yet" },
    { type: "paragraph", html: "If you just bought the evaluation, the account might not exist yet from the platform's point of view. Provisioning can lag behind checkout, and until it completes there's no card to show, no filter to blame, nothing failed, just a gap between payment and setup. Give it some time, then sign out and back in." },
    { type: "heading", text: "5. Failed accounts get swept out on reconciliation" },
    { type: "paragraph", html: "Firms periodically reconcile their books, and part of that housekeeping is clearing failed accounts out of the platform entirely. That's why a card can show as failed one day and be gone without a trace the next, it wasn't just hidden, it was removed during the cleanup pass. The exact timing of that window varies by firm, so check your firm's current rules rather than assuming a fixed hour. The takeaway: a vanished card and a hidden card aren't always the same thing, and reconciliation is the reason a truly failed account eventually stops appearing at all." },
    { type: "heading", text: "How to Get Your Account Card Back: Step by Step" },
    { type: "heading", text: "Turn off &ldquo;Hide Failed Accounts&rdquo;" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Open the account panel.</strong> This is the overview you land on after signing in, or the accounts view you open from the platform menu, wherever your account cards are listed.",
        "<strong class='text-white'>Find the account filter.</strong> Look for a filter or switch labeled something close to &ldquo;Hide Failed Accounts.&rdquo; Placement and exact wording shift between platform versions, so if you don't see those precise words, look for any control that governs whether failed or inactive accounts appear.",
        "<strong class='text-white'>Switch it off.</strong> Toggling it off tells the panel to stop hiding flagged accounts, and every account you own should now be listed.",
        "<strong class='text-white'>Check the panel again.</strong> If your missing card is back and shows a normal, active status, you're done, it was only filtered.",
      ],
    },
    { type: "heading", text: "Confirm the account is actually active" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Read the status on the card.</strong> Once it's visible, check whether it says active or failed. A failed label means the evaluation is over and the account is read-only, no matter that you can now see it.",
        "<strong class='text-white'>Don't expect trading to work on a failed card.</strong> Un-hiding restores visibility, never permissions. If the account failed, orders will keep getting blocked.",
        "<strong class='text-white'>Watch for the all-failed lockout.</strong> If every account under your login is failed, the platform can refuse trading access altogether, because it needs at least one active account to let you in. An empty or locked platform right after login is often this exact case.",
        "<strong class='text-white'>Go to your firm for a reset or repurchase.</strong> Reactivating or replacing a failed evaluation is a prop-firm action. The broker platform can't revive an account the firm controls.",
      ],
    },
    { type: "heading", text: "Make sure you're on the right login" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Sign out completely.</strong> Don't just switch tabs, end the session so you're not carrying a personal login into a prop context.",
        "<strong class='text-white'>Log back in with the firm-issued credentials.</strong> Use the username and password from your prop dashboard, not a personal account you may have created separately.",
        "<strong class='text-white'>Confirm you're in the right place.</strong> If you're unsure how the sign-in flow works across web and mobile, review the login process and where to pick the right account.",
        "<strong class='text-white'>Re-check the panel.</strong> With the correct login, your evaluation account should be present, and if it's still not, you're back to the failed-or-not-yet-provisioned questions above.",
      ],
    },
    { type: "heading", text: "When to contact your prop firm" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Reach out once you've ruled out the filter and the login.</strong> If the card is genuinely gone or shows failed, that's firm territory, not a setting you can flip.",
        "<strong class='text-white'>Ask them, not the broker, for resets and reactivations.</strong> The evaluation belongs to the firm, so they're the only party who can reset it, issue a new one, or explain a failure.",
        "<strong class='text-white'>Have your account details ready.</strong> Your evaluation ID and the rough time things went sideways help them find the right account fast.",
        "<strong class='text-white'>Confirm the current process in their portal.</strong> Firm dashboards and rules change, so verify today's steps rather than relying on an older walkthrough.",
      ],
    },
    { type: "heading", text: "Troubleshooting Table" },
    {
      type: "table",
      headers: ["Symptom / State", "What it means", "Fix"],
      rows: [
        ["Card missing, but everything else looks normal", "&ldquo;Hide Failed Accounts&rdquo; filter is switched on", "Turn the filter off; the card returns to the panel"],
        ["Card reappears with a failed label", "The evaluation breached a rule and is read-only", "Reset or repurchase through your prop firm; visibility alone won't re-enable trading"],
        ["Platform blocks trading right after login", "Every account under this login is failed, no active account", "Get one active account reinstated by your firm to regain platform access"],
        ["&ldquo;Fund Your Account&rdquo; prompt instead of your eval", "You're signed into a personal account, not the prop login", "Sign out and log back in with firm-issued credentials"],
        ["Brand-new eval isn't showing at all", "The account hasn't finished provisioning after purchase", "Wait, then re-login; contact the firm if it never appears"],
        ["Failed card was here yesterday, gone today", "Reconciliation swept the failed account out of the platform", "Expected cleanup, timing varies by firm; nothing to un-hide"],
      ],
    },
    { type: "heading", text: "Trade Across Your Accounts with PickMyTrade" },
    { type: "paragraph", html: "Once your real, active account is back in the panel, the day-to-day headache is usually juggling several prop accounts at once, different logins, different rules, orders that have to land on all of them at the same time. PickMyTrade routes your TradingView alerts to Tradovate through one managed connection so you're not hopping between sign-ins to keep each account in sync:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Multi-Account Sync</strong>, mirror the same strategy across several accounts from a single connection, instead of logging into each one by hand.",
        "<strong class='text-white'>One Persistent Session</strong>, connects once and holds an authenticated session, so you're not re-authenticating over and over just to check which account is active.",
        "<strong class='text-white'>Rule-Aware Routing</strong>, send orders only to the accounts you choose, so a failed or paused eval doesn't derail the rest of your book.",
        "<strong class='text-white'>Hands-Off Execution</strong>, your alerts fire straight to the broker, keeping your focus on the trade rather than the account panel.",
      ],
    },
    { type: "paragraph", html: "Automation can't un-fail an evaluation or override your firm's rules, but once you have an active account, it keeps the mechanical side, routing, syncing, logins, out of your way." },
  ], de: [
    { type: "paragraph", html: "Sie melden sich an und erwarten, Ihr Eval-Konto zu sehen, doch die Karte ist einfach nicht da. Das Panel wirkt leer oder zeigt weniger Konten an, als Sie bezahlt haben. Bevor Sie vom Schlimmsten ausgehen, ein geplatztes Eval, ein Abrechnungsfehler, ein Support-Ticket, das Tage dauert, prüfen Sie zuerst eine kleine Einstellung. Meistens verschwindet eine Kontokarte, weil ein <strong class='text-white'>&ldquo;Hide Failed Accounts&rdquo;-Filter aktiviert ist</strong>, der markierte Konten unauffällig aus Ihrer Ansicht entfernt. Schalten Sie ihn aus, und die Karte ist sofort wieder da. Die schwierigere Wahrheit steckt direkt hinter diesem Schalter: Wenn die Karte ausgeblendet ist, weil das Konto tatsächlich fehlgeschlagen ist, gibt Ihnen das Wiedereinblenden nicht die Handelsfähigkeit zurück. Der Plattformzugriff erfordert mindestens ein <em>aktives</em> Konto. Dieser Leitfaden behandelt 2026 beide Fälle: wie Sie eine nur gefilterte Karte wieder einblenden und was wirklich dahintersteckt, wenn die Karte fehlt, weil das Konto nicht mehr aktiv ist." },
    {
      type: "checklist",
      heading: "Kurz-Checkliste, wenn Ihre Kontokarte fehlt",
      items: [
        "<strong class='text-white'>Schalten Sie zuerst &ldquo;Hide Failed Accounts&rdquo; aus.</strong> Das ist der mit Abstand häufigste Grund, warum eine Karte verschwindet, und ein Fix mit einem Klick.",
        "<strong class='text-white'>Bestätigen Sie, dass Sie mit dem richtigen Login angemeldet sind.</strong> Ein persönliches Konto und eine Prop-Firm-Evaluierung sind zwei verschiedene Logins, das Eval erscheint nur unter den Zugangsdaten, denen es gehört.",
        "<strong class='text-white'>Prüfen Sie, ob das Konto tatsächlich fehlgeschlagen ist.</strong> Ein durchbrochener Drawdown oder ein Verlustlimit markiert das Konto, und markierte Konten werden ausgeblendet oder entfernt.",
        "<strong class='text-white'>Geben Sie einem frischen Kauf Zeit zur Bereitstellung.</strong> Ein brandneues Eval kann nach dem Checkout eine Weile brauchen, bis es erscheint.",
        "<strong class='text-white'>Denken Sie an die harte Regel:</strong> Sind alle Konten fehlgeschlagen, kann die Plattform Sie komplett aussperren, Sie brauchen ein aktives Konto, um hineinzukommen.",
        "<strong class='text-white'>Beziehen Sie Ihre Prop-Firm ein</strong> bei allem, was ihr gehört: Resets, Reaktivierungen oder ein Konto, das nie bereitgestellt wurde.",
      ],
    },
    { type: "heading", text: "Was &ldquo;Kontokarte fehlt&rdquo; tatsächlich bedeutet" },
    { type: "paragraph", html: "Wenn Sie die Plattform öffnen, erscheinen Ihre Konten als Karten in einem Kontopanel, jede mit Saldo, Status und Steuerelementen. Wenn Sie mit einer Prop-Firm handeln, haben Sie vielleicht mehrere davon gestapelt: ein paar Evaluierungen, vielleicht ein finanziertes Konto, manchmal ein Demo. Dieses Panel ist keine statische Liste. Es hat einen Filter, der entscheidet, welche Konten Sie tatsächlich sehen, und einer dieser Filter blendet Konten aus, die als fehlgeschlagen markiert wurden. Er soll Ihre Ansicht aufräumen, sobald ein Eval abgeschlossen ist. Der Nebeneffekt ist offensichtlich, sobald er zuschlägt: Ein Konto, das Sie suchen, verschwindet unauffällig vom Bildschirm und wirkt, als wäre es weg." },
    { type: "paragraph", html: "Also ist &ldquo;meine Kontokarte fehlt&rdquo; meist überhaupt kein Bug. Es ist eine Ansichtseinstellung, die genau das tut, wozu sie angewiesen wurde. Der Trick besteht darin, die zwei Situationen zu trennen, die auf dem Bildschirm identisch aussehen. Im ersten Fall ist das Konto in Ordnung und wird lediglich aus der Ansicht gefiltert, schalten Sie den Filter um, und Sie sind fertig. Im zweiten Fall ist das Konto ausgeblendet, <em>weil</em> es fehlgeschlagen ist, und die fehlende Karte ist Symptom eines größeren Problems: Dieses Konto kann nicht mehr handeln. Beide erscheinen als leere Stelle im Panel, weshalb so viele Trader Zeit mit der falschen Lösung verschwenden." },
    { type: "heading", text: "Warum Ihre Eval-Kontokarte fehlt" },
    { type: "heading", text: "1. Der &ldquo;Hide Failed Accounts&rdquo;-Filter ist aktiviert" },
    { type: "paragraph", html: "Das ist die Hauptursache und am leichtesten zu beheben. Wenn der Filter aktiv ist, wird jedes Konto mit fehlgeschlagenem Status aus dem Panel entfernt, selbst wenn Sie gerade eben noch mittendrin waren oder es nur überprüfen möchten. Die Karte ist nicht weg; sie ist gefiltert. Schalten Sie den Schalter aus, und jedes Konto, fehlgeschlagene eingeschlossen, kommt wieder in die Ansicht zurück. Erscheint das vermisste Konto wieder völlig normal, war ein verirrter Filter die ganze Geschichte." },
    { type: "heading", text: "2. Das Konto ist tatsächlich an einer Regel gescheitert" },
    { type: "paragraph", html: "Manchmal ist die Karte aus einem Grund ausgeblendet. Sprengen Sie einen Trailing-Drawdown, lösen Sie ein tägliches oder wöchentliches Verlustlimit aus oder verstoßen Sie gegen eine andere Firmenregel, wird die Evaluierung als fehlgeschlagen markiert. Bei einem markierten Konto entzieht die Plattform die Möglichkeit, Orders zu platzieren, das Konto existiert weiterhin, ist aber schreibgeschützt. Das Wiedereinblenden zeigt Ihnen die Karte mit einem Fehlgeschlagen-Label, und das ist ein wichtiges Signal, keine Lösung. Sie sehen ein totes Konto, kein wiederherstellbares." },
    { type: "heading", text: "3. Sie sind mit dem falschen Konto angemeldet" },
    { type: "paragraph", html: "Eine Prop-Firm-Evaluierung und ein persönliches Konto sind getrennte Logins mit getrennten Zugangsdaten. Melden Sie sich mit Ihrem eigenen persönlichen Konto an, ist das Eval einfach nicht da, oft landen Sie stattdessen bei einer &ldquo;Fund Your Account&rdquo;-Aufforderung, weil die Plattform ein leeres persönliches Konto ohne Handelsmöglichkeit sieht. Das ist eine klassische Verwechslung und hat nichts mit einem Filter zu tun. Ist das Ihre Situation, besteht die Lösung in einem sauberen Abmelden und erneuten Anmelden mit den von der Firma ausgestellten Zugangsdaten." },
    { type: "heading", text: "4. Ein neuer Kauf wurde noch nicht bereitgestellt" },
    { type: "paragraph", html: "Wenn Sie die Evaluierung gerade erst gekauft haben, existiert das Konto aus Sicht der Plattform möglicherweise noch nicht. Die Bereitstellung kann dem Checkout hinterherhinken, und bis sie abgeschlossen ist, gibt es keine Karte zu zeigen, keinen Filter, dem man die Schuld geben könnte, nichts ist fehlgeschlagen, es ist nur eine Lücke zwischen Zahlung und Einrichtung. Geben Sie es etwas Zeit, melden Sie sich dann ab und wieder an." },
    { type: "heading", text: "5. Fehlgeschlagene Konten werden bei der Abstimmung entfernt" },
    { type: "paragraph", html: "Firmen stimmen ihre Bücher regelmäßig ab, und Teil dieser Aufräumarbeiten ist es, fehlgeschlagene Konten vollständig von der Plattform zu entfernen. Deshalb kann eine Karte an einem Tag als fehlgeschlagen erscheinen und am nächsten spurlos verschwunden sein, sie wurde nicht nur ausgeblendet, sondern beim Aufräumdurchgang entfernt. Der genaue Zeitpunkt dieses Fensters variiert je nach Firma, prüfen Sie also die aktuellen Regeln Ihrer Firma, statt eine feste Uhrzeit anzunehmen. Die Kernaussage: Eine verschwundene und eine ausgeblendete Karte sind nicht immer dasselbe, und die Abstimmung ist der Grund, warum ein wirklich fehlgeschlagenes Konto irgendwann ganz aufhört zu erscheinen." },
    { type: "heading", text: "So bekommen Sie Ihre Kontokarte zurück: Schritt für Schritt" },
    { type: "heading", text: "&ldquo;Hide Failed Accounts&rdquo; ausschalten" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Öffnen Sie das Kontopanel.</strong> Das ist die Übersicht, auf der Sie nach der Anmeldung landen, oder die Konten-Ansicht, die Sie über das Plattformmenü öffnen, wo auch immer Ihre Kontokarten aufgelistet sind.",
        "<strong class='text-white'>Suchen Sie den Kontofilter.</strong> Halten Sie Ausschau nach einem Filter oder Schalter mit einer Bezeichnung nahe an &ldquo;Hide Failed Accounts.&rdquo; Position und genauer Wortlaut ändern sich zwischen Plattformversionen. Sehen Sie diese exakten Worte nicht, suchen Sie nach jeder Steuerung, die bestimmt, ob fehlgeschlagene oder inaktive Konten erscheinen.",
        "<strong class='text-white'>Schalten Sie ihn aus.</strong> Das Deaktivieren weist das Panel an, markierte Konten nicht mehr auszublenden, und jedes Konto, das Ihnen gehört, sollte nun aufgelistet sein.",
        "<strong class='text-white'>Prüfen Sie das Panel erneut.</strong> Ist Ihre fehlende Karte zurück und zeigt einen normalen, aktiven Status, sind Sie fertig, sie war nur gefiltert.",
      ],
    },
    { type: "heading", text: "Bestätigen, dass das Konto tatsächlich aktiv ist" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Lesen Sie den Status auf der Karte.</strong> Sobald sie sichtbar ist, prüfen Sie, ob dort aktiv oder fehlgeschlagen steht. Ein Fehlgeschlagen-Label bedeutet, dass die Evaluierung vorbei und das Konto schreibgeschützt ist, egal ob Sie es jetzt sehen können.",
        "<strong class='text-white'>Erwarten Sie kein funktionierendes Trading bei einer fehlgeschlagenen Karte.</strong> Das Wiedereinblenden stellt die Sichtbarkeit wieder her, niemals Berechtigungen. Ist das Konto fehlgeschlagen, werden Orders weiterhin blockiert.",
        "<strong class='text-white'>Achten Sie auf die Alle-fehlgeschlagen-Sperre.</strong> Sind alle Konten unter Ihrem Login fehlgeschlagen, kann die Plattform den Handelszugriff komplett verweigern, weil sie mindestens ein aktives Konto braucht, um Sie hereinzulassen. Eine leere oder gesperrte Plattform direkt nach der Anmeldung ist oft genau dieser Fall.",
        "<strong class='text-white'>Wenden Sie sich für einen Reset oder Neukauf an Ihre Firma.</strong> Eine fehlgeschlagene Evaluierung zu reaktivieren oder zu ersetzen, ist eine Aktion der Prop-Firma. Die Broker-Plattform kann kein Konto wiederbeleben, das die Firma kontrolliert.",
      ],
    },
    { type: "heading", text: "Sicherstellen, dass Sie mit dem richtigen Login angemeldet sind" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Melden Sie sich vollständig ab.</strong> Wechseln Sie nicht nur die Tabs, beenden Sie die Sitzung, damit Sie kein persönliches Login in einen Prop-Kontext mitnehmen.",
        "<strong class='text-white'>Melden Sie sich mit den von der Firma ausgestellten Zugangsdaten erneut an.</strong> Verwenden Sie Benutzername und Passwort aus Ihrem Prop-Dashboard, nicht ein persönliches Konto, das Sie separat angelegt haben könnten.",
        "<strong class='text-white'>Bestätigen Sie, dass Sie am richtigen Ort sind.</strong> Sind Sie unsicher, wie der Anmeldeprozess über Web und Mobil funktioniert, prüfen Sie den Login-Ablauf und wo Sie das richtige Konto auswählen.",
        "<strong class='text-white'>Prüfen Sie das Panel erneut.</strong> Mit dem richtigen Login sollte Ihr Eval-Konto vorhanden sein, ist es das immer noch nicht, sind Sie zurück bei den obigen Fragen zu fehlgeschlagen oder noch nicht bereitgestellt.",
      ],
    },
    { type: "heading", text: "Wann Sie Ihre Prop-Firm kontaktieren sollten" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Wenden Sie sich an sie, sobald Sie Filter und Login ausgeschlossen haben.</strong> Ist die Karte wirklich weg oder zeigt fehlgeschlagen, ist das Sache der Firma, keine Einstellung, die Sie umschalten können.",
        "<strong class='text-white'>Fragen Sie sie, nicht den Broker, nach Resets und Reaktivierungen.</strong> Die Evaluierung gehört der Firma, nur sie kann sie zurücksetzen, eine neue ausstellen oder einen Fehlschlag erklären.",
        "<strong class='text-white'>Halten Sie Ihre Kontodaten bereit.</strong> Ihre Eval-ID und der ungefähre Zeitpunkt, an dem es schiefging, helfen ihnen, das richtige Konto schnell zu finden.",
        "<strong class='text-white'>Bestätigen Sie den aktuellen Ablauf in ihrem Portal.</strong> Firmen-Dashboards und -Regeln ändern sich, verifizieren Sie also die heutigen Schritte, statt sich auf eine ältere Anleitung zu verlassen.",
      ],
    },
    { type: "heading", text: "Fehlerbehebungstabelle" },
    {
      type: "table",
      headers: ["Symptom / Zustand", "Was es bedeutet", "Lösung"],
      rows: [
        ["Karte fehlt, aber alles andere wirkt normal", "&ldquo;Hide Failed Accounts&rdquo;-Filter ist aktiviert", "Filter ausschalten; die Karte kehrt ins Panel zurück"],
        ["Karte erscheint wieder mit Fehlgeschlagen-Label", "Die Evaluierung hat eine Regel verletzt und ist schreibgeschützt", "Über Ihre Prop-Firma zurücksetzen oder neu kaufen; Sichtbarkeit allein aktiviert das Trading nicht"],
        ["Plattform blockiert Trading direkt nach dem Login", "Alle Konten unter diesem Login sind fehlgeschlagen, kein aktives Konto", "Lassen Sie sich von Ihrer Firma ein aktives Konto wiederherstellen, um den Plattformzugriff zurückzuerhalten"],
        ["&ldquo;Fund Your Account&rdquo;-Aufforderung statt Ihres Evals", "Sie sind mit einem persönlichen Konto angemeldet, nicht dem Prop-Login", "Abmelden und mit den von der Firma ausgestellten Zugangsdaten erneut anmelden"],
        ["Brandneues Eval erscheint überhaupt nicht", "Das Konto hat die Bereitstellung nach dem Kauf noch nicht abgeschlossen", "Warten, dann erneut anmelden; kontaktieren Sie die Firma, falls es nie erscheint"],
        ["Fehlgeschlagene Karte war gestern hier, heute weg", "Die Abstimmung hat das fehlgeschlagene Konto von der Plattform entfernt", "Erwartetes Aufräumen, Zeitpunkt variiert je nach Firma; nichts einzublenden"],
      ],
    },
    { type: "heading", text: "Handeln Sie über Ihre Konten hinweg mit PickMyTrade" },
    { type: "paragraph", html: "Sobald Ihr echtes, aktives Konto wieder im Panel ist, besteht die tägliche Herausforderung meist darin, mehrere Prop-Konten gleichzeitig zu jonglieren, unterschiedliche Logins, unterschiedliche Regeln, Orders, die gleichzeitig auf allen landen müssen. PickMyTrade leitet Ihre TradingView-Alerts über eine verwaltete Verbindung an Tradovate weiter, damit Sie nicht zwischen Logins hin- und herspringen müssen, um jedes Konto synchron zu halten:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Multi-Account-Sync</strong>, spiegelt dieselbe Strategie über mehrere Konten von einer einzigen Verbindung aus, statt sich einzeln in jedes von Hand anzumelden.",
        "<strong class='text-white'>Eine dauerhafte Sitzung</strong>, verbindet sich einmal und hält eine authentifizierte Sitzung, damit Sie sich nicht ständig neu authentifizieren müssen, nur um zu prüfen, welches Konto aktiv ist.",
        "<strong class='text-white'>Regelbewusstes Routing</strong>, sendet Orders nur an die Konten, die Sie auswählen, sodass ein fehlgeschlagenes oder pausiertes Eval nicht den Rest Ihres Portfolios stört.",
        "<strong class='text-white'>Automatisierte Ausführung</strong>, Ihre Alerts gehen direkt an den Broker, sodass Sie sich auf den Trade statt auf das Kontopanel konzentrieren können.",
      ],
    },
    { type: "paragraph", html: "Automatisierung kann eine Evaluierung nicht rückgängig scheitern lassen oder die Regeln Ihrer Firma außer Kraft setzen, aber sobald Sie ein aktives Konto haben, hält sie Ihnen die mechanische Seite, Routing, Synchronisierung, Logins, aus dem Weg." },
  ], es: [
    { type: "paragraph", html: "Usted inicia sesión esperando ver su cuenta de evaluación, y la tarjeta simplemente no está ahí. El panel parece vacío, o muestra menos cuentas de las que ha pagado. Antes de pensar lo peor, un eval fallido, un fallo de facturación, un ticket de soporte que tarda días, revise primero un pequeño ajuste. La mayoría de las veces una tarjeta de cuenta desaparece porque un <strong class='text-white'>filtro &ldquo;Hide Failed Accounts&rdquo; está activado</strong>, que retira discretamente cualquier cuenta marcada de su vista. Desactívelo y la tarjeta vuelve de inmediato. La verdad más difícil está justo detrás de ese interruptor: si la tarjeta está oculta porque la cuenta realmente falló, volver a mostrarla no le devolverá la capacidad de operar. El acceso a la plataforma requiere al menos una cuenta <em>activa</em>. Esta guía repasa ambas mitades en 2026: cómo volver a mostrar una tarjeta que solo está filtrada, y qué está pasando realmente cuando la tarjeta falta porque la cuenta ya no está activa." },
    {
      type: "checklist",
      heading: "Lista de verificación rápida cuando falta su tarjeta de cuenta",
      items: [
        "<strong class='text-white'>Desactive primero &ldquo;Hide Failed Accounts&rdquo;.</strong> Es el motivo más común por el que desaparece una tarjeta, y es una solución de un solo clic.",
        "<strong class='text-white'>Confirme que está en el inicio de sesión correcto.</strong> Una cuenta personal y una evaluación de prop firm son dos inicios de sesión distintos, el eval solo aparece bajo las credenciales que lo poseen.",
        "<strong class='text-white'>Compruebe si la cuenta realmente falló.</strong> Un drawdown superado o un límite de pérdida marca la cuenta, y las cuentas marcadas se ocultan o eliminan.",
        "<strong class='text-white'>Dele tiempo a una compra reciente para aprovisionarse.</strong> Un eval recién comprado puede tardar un poco en aparecer tras el pago.",
        "<strong class='text-white'>Recuerde la regla estricta:</strong> si todas las cuentas fallaron, la plataforma puede bloquearle por completo, necesita una cuenta activa para entrar.",
        "<strong class='text-white'>Involucre a su prop firm</strong> para todo lo que les pertenece: reinicios, reactivaciones o una cuenta que nunca se aprovisionó.",
      ],
    },
    { type: "heading", text: "Qué significa realmente &ldquo;falta la tarjeta de cuenta&rdquo;" },
    { type: "paragraph", html: "Cuando abre la plataforma, sus cuentas aparecen como tarjetas en un panel de cuentas, cada una con su saldo, estado y controles. Si opera con una prop firm, puede tener varias apiladas: un par de evaluaciones, quizás una cuenta financiada, a veces una demo. Ese panel no es solo una lista estática. Tiene un filtro que decide qué cuentas ve realmente, y uno de esos filtros oculta las cuentas marcadas como fallidas. Está pensado para mantener su vista limpia una vez que un eval termina. El efecto secundario es evidente en cuanto le afecta: una cuenta que está buscando desaparece silenciosamente de la pantalla, y parece haberse esfumado." },
    { type: "paragraph", html: "Así que &ldquo;falta mi tarjeta de cuenta&rdquo; normalmente no es un error en absoluto. Es un ajuste de vista haciendo exactamente lo que se le indicó. El truco está en separar las dos situaciones que se ven idénticas en pantalla. En la primera, la cuenta está bien y simplemente se filtra de la vista, cambie el interruptor y listo. En la segunda, la cuenta está oculta <em>porque</em> falló, y la tarjeta ausente es el síntoma de un problema mayor: esa cuenta ya no puede operar. Ambas aparecen como un hueco vacío en el panel, por eso tantos traders pierden tiempo persiguiendo la solución equivocada." },
    { type: "heading", text: "Por qué falta la tarjeta de su cuenta eval" },
    { type: "heading", text: "1. El filtro &ldquo;Hide Failed Accounts&rdquo; está activado" },
    { type: "paragraph", html: "Esta es la causa principal y la más fácil de solucionar. Cuando el filtro está activo, cualquier cuenta con estado fallido se retira del panel, incluso si hace un momento estaba en medio de ella o solo quiere revisarla. La tarjeta no ha desaparecido; está filtrada. Desactive el interruptor y todas las cuentas, incluidas las fallidas, vuelven a la vista. Si la cuenta que faltaba reaparece con aspecto perfectamente normal, un filtro perdido era toda la historia." },
    { type: "heading", text: "2. La cuenta realmente incumplió una regla" },
    { type: "paragraph", html: "A veces la tarjeta está oculta por una razón. Supere un drawdown trailing, active un límite de pérdida diario o semanal, o incumpla otra regla de la firma, y la evaluación se marca como fallida. En una cuenta marcada, la plataforma revoca la capacidad de colocar órdenes, la cuenta existe, pero es de solo lectura. Volver a mostrarla le mostrará la tarjeta con una etiqueta de fallida, y eso es una señal importante, no una solución. Está viendo una cuenta muerta, no una recuperable." },
    { type: "heading", text: "3. Ha iniciado sesión en la cuenta equivocada" },
    { type: "paragraph", html: "Una evaluación de prop firm y una cuenta personal son inicios de sesión separados con credenciales separadas. Inicie sesión con su propia cuenta personal y el eval simplemente no está ahí, a menudo aterrizará en un mensaje &ldquo;Fund Your Account&rdquo;, porque la plataforma ve una cuenta personal vacía sin nada que operar. Es una confusión clásica, y no tiene nada que ver con ningún filtro. Si esa es su situación, la solución es cerrar sesión por completo y volver a iniciarla con las credenciales emitidas por la firma." },
    { type: "heading", text: "4. Una compra nueva aún no se ha aprovisionado" },
    { type: "paragraph", html: "Si acaba de comprar la evaluación, es posible que la cuenta todavía no exista desde el punto de vista de la plataforma. El aprovisionamiento puede retrasarse respecto al pago, y hasta que se complete no hay tarjeta que mostrar, ningún filtro al que culpar, nada falló, solo hay un vacío entre el pago y la configuración. Dele algo de tiempo, luego cierre sesión y vuelva a entrar." },
    { type: "heading", text: "5. Las cuentas fallidas se eliminan en la conciliación" },
    { type: "paragraph", html: "Las firmas concilian sus registros periódicamente, y parte de esa limpieza consiste en eliminar por completo las cuentas fallidas de la plataforma. Por eso una tarjeta puede mostrarse como fallida un día y desaparecer sin dejar rastro al siguiente, no solo estaba oculta, se eliminó durante el pase de limpieza. El momento exacto de esa ventana varía según la firma, así que consulte las reglas actuales de su firma en lugar de asumir una hora fija. La conclusión: una tarjeta desaparecida y una tarjeta oculta no siempre son lo mismo, y la conciliación es la razón por la que una cuenta verdaderamente fallida deja de aparecer por completo con el tiempo." },
    { type: "heading", text: "Cómo recuperar su tarjeta de cuenta: paso a paso" },
    { type: "heading", text: "Desactivar &ldquo;Hide Failed Accounts&rdquo;" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Abra el panel de cuentas.</strong> Esta es la vista general en la que aterriza tras iniciar sesión, o la vista de cuentas que abre desde el menú de la plataforma, donde sea que se listen sus tarjetas de cuenta.",
        "<strong class='text-white'>Encuentre el filtro de cuentas.</strong> Busque un filtro o interruptor con una etiqueta cercana a &ldquo;Hide Failed Accounts.&rdquo; La ubicación y el texto exacto cambian entre versiones de la plataforma, así que si no ve esas palabras precisas, busque cualquier control que determine si aparecen las cuentas fallidas o inactivas.",
        "<strong class='text-white'>Desactívelo.</strong> Al desactivarlo le indica al panel que deje de ocultar las cuentas marcadas, y todas las cuentas que posee deberían aparecer listadas.",
        "<strong class='text-white'>Revise el panel de nuevo.</strong> Si su tarjeta que faltaba está de vuelta y muestra un estado normal y activo, ha terminado, solo estaba filtrada.",
      ],
    },
    { type: "heading", text: "Confirmar que la cuenta está realmente activa" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Lea el estado en la tarjeta.</strong> Una vez visible, compruebe si indica activa o fallida. Una etiqueta de fallida significa que la evaluación terminó y la cuenta es de solo lectura, sin importar que ahora pueda verla.",
        "<strong class='text-white'>No espere que operar funcione en una tarjeta fallida.</strong> Volver a mostrarla restaura la visibilidad, nunca los permisos. Si la cuenta falló, las órdenes seguirán bloqueándose.",
        "<strong class='text-white'>Esté atento al bloqueo de todas fallidas.</strong> Si todas las cuentas bajo su inicio de sesión han fallado, la plataforma puede negar el acceso al trading por completo, porque necesita al menos una cuenta activa para dejarle entrar. Una plataforma vacía o bloqueada justo después de iniciar sesión suele ser exactamente este caso.",
        "<strong class='text-white'>Acuda a su firma para un reinicio o una recompra.</strong> Reactivar o reemplazar una evaluación fallida es una acción de la prop firm. La plataforma del bróker no puede revivir una cuenta que controla la firma.",
      ],
    },
    { type: "heading", text: "Asegúrese de estar en el inicio de sesión correcto" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Cierre sesión por completo.</strong> No se limite a cambiar de pestaña, termine la sesión para no arrastrar un inicio de sesión personal a un contexto de prop firm.",
        "<strong class='text-white'>Vuelva a iniciar sesión con las credenciales emitidas por la firma.</strong> Use el nombre de usuario y la contraseña de su panel de prop firm, no una cuenta personal que pueda haber creado por separado.",
        "<strong class='text-white'>Confirme que está en el lugar correcto.</strong> Si no está seguro de cómo funciona el flujo de inicio de sesión en web y móvil, revise el proceso de inicio de sesión y dónde elegir la cuenta correcta.",
        "<strong class='text-white'>Vuelva a revisar el panel.</strong> Con el inicio de sesión correcto, su cuenta de evaluación debería estar presente, y si sigue sin estarlo, vuelve a las preguntas anteriores sobre si falló o aún no se aprovisionó.",
      ],
    },
    { type: "heading", text: "Cuándo contactar a su prop firm" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Póngase en contacto una vez que haya descartado el filtro y el inicio de sesión.</strong> Si la tarjeta realmente desapareció o muestra fallida, eso es territorio de la firma, no un ajuste que usted pueda cambiar.",
        "<strong class='text-white'>Pregúnteles a ellos, no al bróker, sobre reinicios y reactivaciones.</strong> La evaluación pertenece a la firma, así que son la única parte que puede reiniciarla, emitir una nueva o explicar un fallo.",
        "<strong class='text-white'>Tenga listos los datos de su cuenta.</strong> Su ID de evaluación y el momento aproximado en que las cosas salieron mal les ayudan a encontrar la cuenta correcta rápidamente.",
        "<strong class='text-white'>Confirme el proceso actual en su portal.</strong> Los paneles y las reglas de las firmas cambian, así que verifique los pasos de hoy en lugar de confiar en una guía antigua.",
      ],
    },
    { type: "heading", text: "Tabla de solución de problemas" },
    {
      type: "table",
      headers: ["Síntoma / estado", "Qué significa", "Solución"],
      rows: [
        ["Falta la tarjeta, pero todo lo demás parece normal", "El filtro &ldquo;Hide Failed Accounts&rdquo; está activado", "Desactive el filtro; la tarjeta vuelve al panel"],
        ["La tarjeta reaparece con una etiqueta de fallida", "La evaluación incumplió una regla y es de solo lectura", "Reinicie o recompre a través de su prop firm; la visibilidad por sí sola no reactiva el trading"],
        ["La plataforma bloquea el trading justo después de iniciar sesión", "Todas las cuentas bajo este inicio de sesión han fallado, sin cuenta activa", "Consiga que su firma reinstale una cuenta activa para recuperar el acceso a la plataforma"],
        ["Mensaje &ldquo;Fund Your Account&rdquo; en lugar de su eval", "Ha iniciado sesión en una cuenta personal, no en el inicio de sesión de prop", "Cierre sesión y vuelva a iniciarla con las credenciales emitidas por la firma"],
        ["Un eval recién comprado no aparece en absoluto", "La cuenta no ha terminado de aprovisionarse tras la compra", "Espere y luego vuelva a iniciar sesión; contacte a la firma si nunca aparece"],
        ["La tarjeta fallida estaba ayer, hoy desapareció", "La conciliación eliminó la cuenta fallida de la plataforma", "Limpieza esperada, el momento varía según la firma; no hay nada que volver a mostrar"],
      ],
    },
    { type: "heading", text: "Opere en todas sus cuentas con PickMyTrade" },
    { type: "paragraph", html: "Una vez que su cuenta real y activa está de vuelta en el panel, el dolor de cabeza cotidiano suele ser hacer malabares con varias cuentas de prop firm a la vez, distintos inicios de sesión, distintas reglas, órdenes que deben llegar a todas al mismo tiempo. PickMyTrade dirige sus alertas de TradingView a Tradovate a través de una conexión gestionada, para que no tenga que saltar entre inicios de sesión para mantener cada cuenta sincronizada:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Sincronización multicuenta</strong>, replica la misma estrategia en varias cuentas desde una sola conexión, en lugar de iniciar sesión en cada una manualmente.",
        "<strong class='text-white'>Una sesión persistente</strong>, se conecta una vez y mantiene una sesión autenticada, para que no tenga que volver a autenticarse constantemente solo para comprobar qué cuenta está activa.",
        "<strong class='text-white'>Enrutamiento consciente de las reglas</strong>, envía órdenes solo a las cuentas que usted elige, para que un eval fallido o pausado no descarrile el resto de su cartera.",
        "<strong class='text-white'>Ejecución sin intervención</strong>, sus alertas se disparan directamente al bróker, manteniendo su atención en la operación y no en el panel de cuentas.",
      ],
    },
    { type: "paragraph", html: "La automatización no puede revertir el fallo de una evaluación ni anular las reglas de su firma, pero una vez que tiene una cuenta activa, mantiene el lado mecánico, enrutamiento, sincronización, inicios de sesión, fuera de su camino." },
  ], fr: [
    { type: "paragraph", html: "Vous vous connectez en vous attendant à voir votre compte d'évaluation, et la carte n'est tout simplement pas là. Le panneau semble vide, ou affiche moins de comptes que vous n'en avez payés. Avant de craindre le pire, un eval raté, un problème de facturation, un ticket de support qui prend des jours, vérifiez d'abord un petit réglage. La plupart du temps, une carte de compte disparaît parce qu'un <strong class='text-white'>filtre &laquo; Hide Failed Accounts &raquo; est activé</strong>, qui retire discrètement tout compte signalé de votre vue. Désactivez-le et la carte revient immédiatement. La vérité la plus difficile se cache juste derrière cet interrupteur : si la carte est masquée parce que le compte a réellement échoué, la réafficher ne vous rendra pas la possibilité de trader. L'accès à la plateforme nécessite au moins un compte <em>actif</em>. Ce guide couvre les deux cas en 2026 : comment réafficher une carte simplement filtrée, et ce qui se passe réellement quand la carte manque parce que le compte n'est plus actif." },
    {
      type: "checklist",
      heading: "Liste de vérification rapide quand votre carte de compte est manquante",
      items: [
        "<strong class='text-white'>Désactivez d'abord &laquo; Hide Failed Accounts &raquo;.</strong> C'est la raison la plus courante pour laquelle une carte disparaît, et c'est une correction en un clic.",
        "<strong class='text-white'>Confirmez que vous êtes sur le bon identifiant de connexion.</strong> Un compte personnel et une évaluation de prop firm sont deux connexions distinctes, l'eval n'apparaît que sous les identifiants qui le possèdent.",
        "<strong class='text-white'>Vérifiez si le compte a réellement échoué.</strong> Un drawdown dépassé ou une limite de perte signale le compte, et les comptes signalés sont masqués ou supprimés.",
        "<strong class='text-white'>Laissez du temps à un achat récent pour se provisionner.</strong> Un eval tout nouveau peut prendre un peu de temps à apparaître après le paiement.",
        "<strong class='text-white'>Retenez la règle stricte :</strong> si tous les comptes ont échoué, la plateforme peut vous bloquer entièrement, il vous faut un compte actif pour entrer.",
        "<strong class='text-white'>Impliquez votre prop firm</strong> pour tout ce qui lui appartient : réinitialisations, réactivations, ou un compte qui n'a jamais été provisionné.",
      ],
    },
    { type: "heading", text: "Ce que &laquo; carte de compte manquante &raquo; signifie vraiment" },
    { type: "paragraph", html: "Lorsque vous ouvrez la plateforme, vos comptes apparaissent sous forme de cartes dans un panneau de comptes, chacune avec son solde, son statut et ses commandes. Si vous tradez avec une prop firm, vous pouvez en avoir plusieurs empilées : quelques évaluations, peut-être un compte financé, parfois une démo. Ce panneau n'est pas qu'une simple liste statique. Il possède un filtre qui décide quels comptes vous voyez réellement, et l'un de ces filtres masque les comptes marqués comme échoués. Il est censé garder votre vue propre une fois qu'un eval est terminé. L'effet secondaire est évident dès qu'il vous touche : un compte que vous recherchez disparaît silencieusement de l'écran, et semble s'être volatilisé." },
    { type: "paragraph", html: "Donc &laquo; ma carte de compte est manquante &raquo; n'est généralement pas un bug du tout. C'est un réglage d'affichage qui fait exactement ce qu'on lui a demandé. L'astuce consiste à séparer les deux situations qui paraissent identiques à l'écran. Dans le premier cas, le compte va bien et est simplement filtré hors de vue, basculez l'interrupteur et c'est réglé. Dans le second, le compte est masqué <em>parce qu'</em>il a échoué, et la carte manquante est le symptôme d'un problème plus important : ce compte ne peut plus trader. Les deux se manifestent comme un emplacement vide dans le panneau, ce qui explique pourquoi tant de traders perdent du temps à poursuivre la mauvaise solution." },
    { type: "heading", text: "Pourquoi la carte de votre compte eval est manquante" },
    { type: "heading", text: "1. Le filtre &laquo; Hide Failed Accounts &raquo; est activé" },
    { type: "paragraph", html: "C'est la cause principale et la plus facile à corriger. Lorsque le filtre est activé, tout compte portant un statut échoué est retiré du panneau, même si vous étiez en plein dedans quelques instants plus tôt, ou que vous souhaitez simplement le consulter. La carte n'a pas disparu ; elle est filtrée. Désactivez l'interrupteur et chaque compte, y compris les échoués, revient dans la vue. Si le compte manquant réapparaît d'aspect parfaitement normal, un filtre égaré était toute l'histoire." },
    { type: "heading", text: "2. Le compte a réellement échoué à une règle" },
    { type: "paragraph", html: "Parfois, la carte est masquée pour une raison précise. Dépassez un drawdown trailing, déclenchez une limite de perte quotidienne ou hebdomadaire, ou enfreignez une autre règle de la firme, et l'évaluation est marquée comme échouée. Sur un compte signalé, la plateforme révoque la possibilité de passer des ordres, le compte existe, mais il est en lecture seule. Le réafficher vous montrera la carte avec une étiquette échouée, et c'est un signal important, pas une solution. Vous voyez un compte mort, pas un compte récupérable." },
    { type: "heading", text: "3. Vous êtes connecté au mauvais compte" },
    { type: "paragraph", html: "Une évaluation de prop firm et un compte personnel sont des connexions distinctes avec des identifiants distincts. Connectez-vous avec votre propre compte personnel et l'eval n'y est tout simplement pas, vous atterrirez souvent sur une invite &laquo; Fund Your Account &raquo; à la place, car la plateforme voit un compte personnel vide sans rien à trader. C'est une confusion classique, qui n'a rien à voir avec un filtre quelconque. Si c'est votre situation, la solution consiste en une déconnexion propre suivie d'une reconnexion avec les identifiants fournis par la firme." },
    { type: "heading", text: "4. Un nouvel achat n'a pas encore été provisionné" },
    { type: "paragraph", html: "Si vous venez d'acheter l'évaluation, le compte n'existe peut-être pas encore du point de vue de la plateforme. Le provisionnement peut prendre du retard sur le paiement, et tant qu'il n'est pas terminé, il n'y a aucune carte à afficher, aucun filtre à blâmer, rien n'a échoué, il y a simplement un écart entre le paiement et la mise en place. Laissez passer un peu de temps, puis déconnectez-vous et reconnectez-vous." },
    { type: "heading", text: "5. Les comptes échoués sont supprimés lors de la réconciliation" },
    { type: "paragraph", html: "Les firmes réconcilient périodiquement leurs registres, et une partie de ce ménage consiste à retirer entièrement les comptes échoués de la plateforme. C'est pourquoi une carte peut apparaître comme échouée un jour et disparaître sans laisser de trace le lendemain, elle n'était pas simplement masquée, elle a été supprimée lors du passage de nettoyage. Le moment exact de cette fenêtre varie selon la firme, vérifiez donc les règles actuelles de votre firme plutôt que de supposer une heure fixe. À retenir : une carte disparue et une carte masquée ne sont pas toujours la même chose, et la réconciliation est la raison pour laquelle un compte réellement échoué finit par ne plus apparaître du tout." },
    { type: "heading", text: "Comment récupérer votre carte de compte : étape par étape" },
    { type: "heading", text: "Désactiver &laquo; Hide Failed Accounts &raquo;" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Ouvrez le panneau de comptes.</strong> C'est la vue d'ensemble sur laquelle vous atterrissez après vous être connecté, ou la vue des comptes que vous ouvrez depuis le menu de la plateforme, partout où vos cartes de compte sont listées.",
        "<strong class='text-white'>Trouvez le filtre de comptes.</strong> Cherchez un filtre ou un interrupteur portant une étiquette proche de &laquo; Hide Failed Accounts. &raquo; L'emplacement et le libellé exact varient selon les versions de la plateforme, donc si vous ne voyez pas ces mots précis, cherchez tout contrôle qui détermine si les comptes échoués ou inactifs apparaissent.",
        "<strong class='text-white'>Désactivez-le.</strong> Le basculer indique au panneau d'arrêter de masquer les comptes signalés, et tous les comptes que vous possédez devraient maintenant être listés.",
        "<strong class='text-white'>Revérifiez le panneau.</strong> Si votre carte manquante est de retour et affiche un statut normal et actif, c'est terminé, elle était simplement filtrée.",
      ],
    },
    { type: "heading", text: "Confirmer que le compte est réellement actif" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Lisez le statut sur la carte.</strong> Une fois visible, vérifiez s'il indique actif ou échoué. Une étiquette échoué signifie que l'évaluation est terminée et que le compte est en lecture seule, peu importe que vous puissiez désormais le voir.",
        "<strong class='text-white'>Ne vous attendez pas à pouvoir trader sur une carte échouée.</strong> Le réaffichage restaure la visibilité, jamais les autorisations. Si le compte a échoué, les ordres continueront d'être bloqués.",
        "<strong class='text-white'>Attention au blocage tout-échoué.</strong> Si tous les comptes de votre identifiant de connexion ont échoué, la plateforme peut refuser complètement l'accès au trading, car elle a besoin d'au moins un compte actif pour vous laisser entrer. Une plateforme vide ou bloquée juste après la connexion correspond souvent exactement à ce cas.",
        "<strong class='text-white'>Adressez-vous à votre firme pour une réinitialisation ou un nouvel achat.</strong> Réactiver ou remplacer une évaluation échouée est une action de la prop firm. La plateforme du courtier ne peut pas ranimer un compte que la firme contrôle.",
      ],
