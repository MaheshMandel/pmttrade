---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "motivewave-tradovate-login-error";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/debugging/${SLUG}`;

const META_TITLE = "MotiveWave Tradovate Login Pop-Up Error";
const META_DESCRIPTION =
  "MotiveWave keeps showing a Tradovate login pop-up? Match the Live or Demo server, confirm your data subscription, approve the device, then reconnect.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "MotiveWave Tradovate Login-Popup-Fehler", es: "Error de la ventana emergente de inicio de sesión de Tradovate en MotiveWave", fr: "Erreur de fenêtre de connexion Tradovate dans MotiveWave", it: "Errore del popup di login Tradovate in MotiveWave" },
  dek: { en: "The workspace opened, your account is clearly linked, and a Tradovate login dialog still parks itself over the screen. Here's what that pop-up is actually checking, and the order to fix each cause in.", de: "Der Arbeitsbereich hat sich geöffnet, Ihr Konto ist eindeutig verknüpft, und trotzdem legt sich ein Tradovate-Login-Dialog über den Bildschirm. Hier erfahren Sie, was dieses Popup tatsächlich prüft und in welcher Reihenfolge Sie jede Ursache beheben.", es: "El espacio de trabajo se abrió, su cuenta está claramente vinculada y, aun así, un cuadro de inicio de sesión de Tradovate se queda sobre la pantalla. Aquí le explicamos qué comprueba realmente esa ventana emergente y en qué orden corregir cada causa.", fr: "L'espace de travail s'est ouvert, votre compte est clairement relié, et pourtant une boîte de connexion Tradovate s'installe par-dessus l'écran. Voici ce que cette fenêtre vérifie réellement, et dans quel ordre corriger chaque cause.", it: "L'area di lavoro si è aperta, il suo conto è chiaramente collegato, eppure una finestra di login Tradovate resta sopra lo schermo. Ecco che cosa controlla davvero quel popup e in che ordine correggere ogni causa." },
  readTime: { en: "8 min read", de: "8 Min. Lesezeit", es: "Lectura de 8 min", fr: "Lecture : 8 min", it: "Lettura di 8 min" },
  lastUpdated: "2026-07-10",
  blocks: { en: [
    { type: "paragraph", html: "You linked your Tradovate account to MotiveWave, the workspace opened, and then a login pop-up parks itself in the middle of the screen and won't go away. Sometimes it reads <strong class='text-white'>&ldquo;Username or password is not correct,&rdquo;</strong> sometimes it's a blank credential box that reappears every launch, and sometimes it's a hard <strong class='text-white'>&ldquo;Connection Failed&rdquo;</strong> with a java error attached. The frustrating part is that the account clearly connected, you can see it, yet the platform won't finish the handshake. That dialog isn't MotiveWave logging <em>you</em> in; it's MotiveWave asking Tradovate to authenticate your broker and data feed, and it stalls whenever the environment, the data subscription, the device, or the credentials don't line up. Below is how to work through each of those in the order that clears the pop-up fastest, plus how a routing tool like PickMyTrade sidesteps the desktop login dialog when your goal is to automate from TradingView." },
    {
      type: "checklist",
      heading: "Quick Checklist for the MotiveWave Tradovate Login Pop-Up",
      items: [
        "<strong class='text-white'>Match the server</strong>, point Live credentials at the <strong class='text-white'>Live</strong> connection and Demo credentials at <strong class='text-white'>Demo</strong>. Tradovate keeps them as separate realms, and a mismatch reads as a bad password.",
        "<strong class='text-white'>Confirm your data subscription</strong>, log in on Tradovate's website and check that your market-data subscription is active and the exchange data agreement is signed.",
        "<strong class='text-white'>Approve the device</strong>, if 2FA is on, open the device-approval email Tradovate sends and approve MotiveWave, then retry.",
        "<strong class='text-white'>Re-enter credentials cleanly</strong>, type your Tradovate username and password by hand (no trailing spaces), especially if you recently changed the password.",
        "<strong class='text-white'>Check it isn't a prop account</strong>, evaluation accounts often connect through Rithmic, not Tradovate; confirm your firm's supported gateway.",
        "<strong class='text-white'>Rule out the network</strong>, restart MotiveWave, disable a blocking firewall/antivirus/VPN, and update to the latest build for a &ldquo;Connection Failed&rdquo; error.",
        "<strong class='text-white'>Still stuck?</strong>, contact MotiveWave and Tradovate support to confirm the account link and data entitlement from their side.",
      ],
    },
    { type: "heading", text: "What the MotiveWave Tradovate Login Pop-Up Actually Means" },
    { type: "paragraph", html: "MotiveWave doesn't have its own login for market access. When you open a workspace tied to a broker or data service that needs credentials, it shows a login dialog and passes whatever you type straight through to that provider. For a Tradovate workspace, the pop-up is really Tradovate's authentication gate. If Tradovate accepts the credentials, environment, device, and data entitlement, the dialog closes and your charts populate. If any one of those checks fails, the dialog bounces back with an error or reopens the next time MotiveWave tries to establish the feed." },
    { type: "paragraph", html: "That's why the symptom looks so contradictory. Your account &ldquo;connected&rdquo; in the sense that MotiveWave knows which provider to talk to, but the session can't be authorized. Tradovate is silently checking four things: the right credentials for this environment, an allowed device, a live data entitlement, and whether it can even authenticate this account directly. Get all four green and the pop-up disappears for good." },
    { type: "heading", text: "Top Causes of the Login Pop-Up" },
    { type: "heading", text: "1. Live and Demo credentials are crossed" },
    { type: "paragraph", html: "When you build the workspace, MotiveWave asks you to choose a Live or a Demo connection and then enter credentials. Tradovate treats its live and simulation environments as completely separate accounts with separate passwords. Send your live username to the demo server, or your demo login to the live server, and Tradovate rejects it as &ldquo;username or password is not correct&rdquo;, even though the same details work perfectly on the other side." },
    { type: "heading", text: "2. No active Tradovate market-data subscription" },
    { type: "paragraph", html: "MotiveWave charts and quotes ride on your Tradovate data entitlement. If your real-time market-data subscription lapsed, or you never signed the exchange market-data agreement, the data-service side of the login can't complete. That shows up as a login that won't finish, a feed that stays delayed, or a pop-up that keeps returning. Live data on Tradovate is gated behind the CME/exchange agreement you accept on their website, and the account only unlocks once that's signed." },
    { type: "heading", text: "3. 2FA is on and the device isn't approved" },
    { type: "paragraph", html: "Two-factor authentication treats MotiveWave as a brand-new device the first time it connects. Tradovate pauses the login and emails you an approve/deny link, and until you click <strong class='text-white'>Approve</strong>, the session stays blocked and the pop-up keeps failing. This one is easy to miss because the dialog says nothing about 2FA, it just looks like the login won't take." },
    { type: "heading", text: "4. It's a prop firm evaluation account" },
    { type: "paragraph", html: "Here's the one that traps a lot of funded traders. Many prop firms don't let MotiveWave talk to their Tradovate evaluation accounts directly, the workspace has to connect through a different gateway, commonly Rithmic. And because several firms lock the platform choice when you buy the evaluation, a Tradovate-platform account may have no valid path into MotiveWave at all. The pop-up then rejects credentials that are perfectly correct, because it's the wrong door." },
    { type: "heading", text: "5. Stale or mistyped credentials" },
    { type: "paragraph", html: "If you changed your Tradovate password on the website but left the old one saved in the MotiveWave workspace, every launch will fire the pop-up. Copy-paste errors, trailing spaces, and an expired or inactive Tradovate subscription land in the same bucket." },
    { type: "heading", text: "6. A network or connector problem" },
    { type: "paragraph", html: "A &ldquo;Connection Failed&rdquo; message with a java.net exception, particularly on a setup that ran fine for months and then broke, usually isn't about your password at all. A firewall, antivirus, or VPN can block the connection, and third-party connectors occasionally change in ways that require the latest MotiveWave build to stay compatible." },
    { type: "heading", text: "How to Fix the MotiveWave Tradovate Login Error: Step-by-Step" },
    { type: "heading", text: "Step 1: Match the Environment, Then Re-Enter Credentials" },
    { type: "paragraph", html: "Rebuild the connection cleanly so there's no stale password in play:" },
    {
      type: "steps",
      items: [
        { title: "Open the connection setup", html: "In MotiveWave, open your workspace settings (or create a fresh workspace) and start the connection setup for Tradovate." },
        { title: "Choose the matching environment", html: "Choose the environment that matches your account, <strong class='text-white'>Live</strong> for a funded/live Tradovate login, <strong class='text-white'>Demo</strong> for a simulation login. Confirm the exact label on the current MotiveWave screen, since the wording can vary by build." },
        { title: "Type credentials by hand", html: "Type your Tradovate username and password by hand. Watch for trailing spaces and confirm caps, and if you recently reset the password on Tradovate's site, use the new one." },
        { title: "Finish setup and reconnect", html: "Finish the setup and let the workspace reconnect." },
      ],
    },
    { type: "paragraph", html: "If the credentials work on Tradovate's own website but fail here, an environment mismatch is almost always the reason, flip Live/Demo and try again." },
    { type: "heading", text: "Step 2: Confirm Your Tradovate Data Subscription and Agreement" },
    { type: "paragraph", html: "Do this directly on Tradovate, not inside MotiveWave:" },
    {
      type: "steps",
      items: [
        { title: "Log in on Tradovate's website", html: "Log in to your account on the Tradovate website." },
        { title: "Confirm the market-data subscription", html: "Open your account/subscription area and confirm your <strong class='text-white'>real-time market-data subscription</strong> is active. Confirm the exact menu label on the current Tradovate interface." },
        { title: "Sign the exchange data agreement", html: "Check that the exchange (CME) market-data agreement is signed. If it isn't, sign it, the account updates automatically once you accept, and live data becomes available." },
        { title: "Reconnect in MotiveWave", html: "Return to MotiveWave and reconnect. With the entitlement in place, the data-service login can finish and the pop-up should clear." },
      ],
    },
    { type: "heading", text: "Step 3: Approve the Device If 2FA Is On" },
    {
      type: "steps",
      items: [
        { title: "Attempt the login once", html: "Attempt the MotiveWave login once so Tradovate registers the new device and sends the approval email." },
        { title: "Find the device-approval email", html: "Open the inbox tied to your Tradovate account, check Spam/Junk and any Promotions tab too, and find the device-login notification." },
        { title: "Click Approve", html: "Click <strong class='text-white'>Approve</strong> (not Deny), then return to MotiveWave and log in again." },
        { title: "If no email arrives", html: "Verify the email address on your Tradovate profile is correct and one you can open, allow-list Tradovate as a sender, and if needed ask Tradovate support to approve the device from their side." },
      ],
    },
    { type: "heading", text: "Step 4: Confirm the Account Type (Prop vs Personal)" },
    {
      type: "steps",
      items: [
        { title: "Check your firm's connection guide", html: "If this is a prop firm evaluation or funded account, check your firm's current platform connection guide before anything else." },
        { title: "Use Rithmic if that's the firm's gateway", html: "If the firm routes MotiveWave through Rithmic rather than Tradovate, set up a <strong class='text-white'>Rithmic</strong> connection in MotiveWave using the firm's Rithmic credentials instead of trying to log in with Tradovate details." },
        { title: "Understand a platform-locked evaluation", html: "If the firm locked your evaluation to the Tradovate platform, understand that it may not connect to MotiveWave at all, that's a platform limitation, not a password problem. Contact the firm to confirm your options." },
      ],
    },
    { type: "heading", text: "Step 5: Clear Network and Version Blocks" },
    {
      type: "steps",
      items: [
        { title: "Restart MotiveWave", html: "Restart MotiveWave completely to rebuild the connection to the server, then try the login again." },
        { title: "Rule out firewall/antivirus/VPN", html: "Temporarily disable or create an exception for any firewall, antivirus, or VPN that could be intercepting the connection, then retest." },
        { title: "Update to the latest build", html: "Update MotiveWave to the latest build. Connectors to third-party services change, and an outdated version can throw a &ldquo;Connection Failed&rdquo; error on a setup that used to work." },
        { title: "Open tickets with both support teams", html: "If it still fails, open a ticket with MotiveWave support and, in parallel, ask Tradovate to confirm your account link and data entitlement are healthy on their end." },
      ],
    },
    { type: "heading", text: "Troubleshooting Table" },
    {
      type: "table",
      headers: ["Symptom", "Likely cause", "Fix"],
      rows: [
        ["&ldquo;Username or password is not correct&rdquo; (but they work on Tradovate.com)", "Live credentials sent to Demo server or vice versa", "Match the connection environment to your account, then re-enter credentials"],
        ["Login pop-up reopens every launch", "Inactive data subscription or unsigned market-data agreement", "Sign the exchange data agreement and confirm the subscription on Tradovate's site"],
        ["Login won't complete, no clear error", "2FA holding an unapproved device", "Open the emailed device notice and click Approve, then retry"],
        ["Correct credentials still rejected", "Prop firm evaluation account not routable via Tradovate", "Connect through the firm's supported gateway (often Rithmic)"],
        ["&ldquo;Connection Failed&rdquo; / java.net exception", "Firewall/antivirus/VPN block or outdated connector", "Restart, unblock the network path, and update MotiveWave to the latest build"],
        ["Feed connects but data is delayed", "No live market-data entitlement", "Enable the real-time subscription and sign the CME agreement on Tradovate"],
      ],
    },
    { type: "heading", text: "Skip the Desktop Login Pop-Up with PickMyTrade" },
    { type: "paragraph", html: "If your reason for wiring Tradovate into MotiveWave is to automate a strategy from TradingView, there's a cleaner path that never touches a desktop workspace login. PickMyTrade links your Tradovate account once and routes your TradingView alerts to it over one steady connection, so you're not re-authenticating a &ldquo;new machine&rdquo; every time you open a laptop or hop networks." },
    {
      type: "list",
      items: [
        "<strong class='text-white'>One-time account link</strong>, connect your Tradovate account a single time; there's no per-launch credential pop-up to babysit.",
        "<strong class='text-white'>Stable, consistent connection</strong>, alerts flow through one connection instead of a rotating set of devices, so 2FA doesn't keep re-challenging you.",
        "<strong class='text-white'>Live and demo aware</strong>, route to the exact environment you intend, which is where crossed Live/Demo credentials trip people up.",
        "<strong class='text-white'>Multi-account sync</strong>, mirror one alert across several Tradovate accounts from a single place, without logging each into a desktop platform.",
      ],
    },
  ], de: [
    { type: "paragraph",html: "Sie haben Ihr Tradovate-Konto mit MotiveWave verknüpft, der Arbeitsbereich hat sich geöffnet, und dann setzt sich ein Login-Popup mitten auf den Bildschirm und verschwindet nicht mehr. Manchmal lautet es <strong class='text-white'>&ldquo;Username or password is not correct,&rdquo;</strong> manchmal ist es ein leeres Zugangsdaten-Feld, das bei jedem Start wieder erscheint, und manchmal ein harter <strong class='text-white'>&ldquo;Connection Failed&rdquo;</strong> mit angehängtem Java-Fehler. Das Frustrierende daran: Das Konto war eindeutig verbunden, Sie sehen es, und doch schließt die Plattform den Handshake nicht ab. Dieser Dialog ist nicht MotiveWave, das <em>Sie</em> anmeldet, sondern MotiveWave, das Tradovate bittet, Ihren Broker und Datenfeed zu authentifizieren, und er bleibt hängen, wenn Umgebung, Datenabonnement, Gerät oder Zugangsdaten nicht zusammenpassen. Unten sehen Sie, wie Sie diese Punkte in der Reihenfolge abarbeiten, die das Popup am schnellsten beseitigt, und wie ein Routing-Tool wie PickMyTrade den Desktop-Login-Dialog umgeht, wenn Ihr Ziel die Automatisierung aus TradingView ist." },
    {
      type: "checklist",
      heading: "Kurze Checkliste für das MotiveWave-Tradovate-Login-Popup",
      items: [
        "<strong class='text-white'>Server abgleichen</strong>, richten Sie Live-Zugangsdaten auf die <strong class='text-white'>Live</strong>-Verbindung und Demo-Zugangsdaten auf <strong class='text-white'>Demo</strong>. Tradovate führt sie als getrennte Bereiche, und eine Abweichung wird als falsches Passwort gemeldet.",
        "<strong class='text-white'>Datenabonnement bestätigen</strong>, melden Sie sich auf der Tradovate-Website an und prüfen Sie, ob Ihr Marktdatenabonnement aktiv und die Börsen-Datenvereinbarung unterzeichnet ist.",
        "<strong class='text-white'>Gerät genehmigen</strong>, öffnen Sie bei aktivierter 2FA die Geräte-Genehmigungs-E-Mail von Tradovate, genehmigen Sie MotiveWave und versuchen Sie es erneut.",
        "<strong class='text-white'>Zugangsdaten sauber neu eingeben</strong>, tippen Sie Ihren Tradovate-Benutzernamen und Ihr Passwort von Hand ein (ohne Leerzeichen am Ende), besonders wenn Sie das Passwort kürzlich geändert haben.",
        "<strong class='text-white'>Prüfen, ob es kein Prop-Konto ist</strong>, Evaluierungskonten verbinden sich oft über Rithmic, nicht über Tradovate; bestätigen Sie das unterstützte Gateway Ihrer Firma.",
        "<strong class='text-white'>Netzwerk ausschließen</strong>, starten Sie MotiveWave neu, deaktivieren Sie eine blockierende Firewall/einen Virenscanner/ein VPN und aktualisieren Sie bei einem &ldquo;Connection Failed&rdquo;-Fehler auf die neueste Version.",
        "<strong class='text-white'>Immer noch festgefahren?</strong>, wenden Sie sich an den Support von MotiveWave und Tradovate, damit diese die Kontoverknüpfung und die Datenberechtigung von ihrer Seite bestätigen.",
      ],
    },
    { type: "heading",text: "Was das MotiveWave-Tradovate-Login-Popup tatsächlich bedeutet" },
    { type: "paragraph",html: "MotiveWave hat keinen eigenen Login für den Marktzugang. Wenn Sie einen Arbeitsbereich öffnen, der an einen Broker oder Datendienst gebunden ist und Zugangsdaten braucht, zeigt es einen Login-Dialog und reicht alles, was Sie eingeben, direkt an diesen Anbieter weiter. Bei einem Tradovate-Arbeitsbereich ist das Popup in Wahrheit das Authentifizierungs-Gate von Tradovate. Akzeptiert Tradovate Zugangsdaten, Umgebung, Gerät und Datenberechtigung, schließt sich der Dialog und Ihre Charts füllen sich. Schlägt eine dieser Prüfungen fehl, springt der Dialog mit einem Fehler zurück oder erscheint erneut, wenn MotiveWave das nächste Mal versucht, den Feed aufzubauen." },
    { type: "paragraph",html: "Deshalb wirkt das Symptom so widersprüchlich. Ihr Konto war &ldquo;verbunden&rdquo; in dem Sinn, dass MotiveWave weiß, mit welchem Anbieter es sprechen soll, aber die Sitzung kann nicht autorisiert werden. Tradovate prüft stillschweigend vier Dinge: die richtigen Zugangsdaten für diese Umgebung, ein zulässiges Gerät, eine aktive Datenberechtigung und ob es dieses Konto überhaupt direkt authentifizieren kann. Sind alle vier grün, verschwindet das Popup dauerhaft." },
    { type: "heading",text: "Häufigste Ursachen für das Login-Popup" },
    { type: "heading",text: "1. Live- und Demo-Zugangsdaten sind vertauscht" },
    { type: "paragraph",html: "Beim Erstellen des Arbeitsbereichs fragt MotiveWave Sie, ob Sie eine Live- oder Demo-Verbindung wählen möchten, und verlangt dann Zugangsdaten. Tradovate behandelt seine Live- und Simulationsumgebungen als völlig getrennte Konten mit getrennten Passwörtern. Senden Sie Ihren Live-Benutzernamen an den Demo-Server oder Ihr Demo-Login an den Live-Server, lehnt Tradovate ihn als &ldquo;username or password is not correct&rdquo; ab, obwohl dieselben Daten auf der anderen Seite einwandfrei funktionieren." },
    { type: "heading",text: "2. Kein aktives Tradovate-Marktdatenabonnement" },
    { type: "paragraph",html: "MotiveWave-Charts und -Kurse laufen über Ihre Tradovate-Datenberechtigung. Wenn Ihr Echtzeit-Marktdatenabonnement abgelaufen ist oder Sie die Börsen-Marktdatenvereinbarung nie unterzeichnet haben, kann die Datendienst-Seite des Logins nicht abgeschlossen werden. Das zeigt sich als Login, der nicht fertig wird, als Feed, der verzögert bleibt, oder als Popup, das immer wieder zurückkehrt. Live-Daten bei Tradovate sind an die CME-/Börsenvereinbarung gebunden, die Sie auf deren Website akzeptieren, und das Konto wird erst freigeschaltet, wenn sie unterzeichnet ist." },
    { type: "heading",text: "3. 2FA ist aktiv und das Gerät ist nicht genehmigt" },
    { type: "paragraph",html: "Die Zwei-Faktor-Authentifizierung behandelt MotiveWave bei der ersten Verbindung als brandneues Gerät. Tradovate hält den Login an und sendet Ihnen einen Genehmigen/Ablehnen-Link per E-Mail, und solange Sie nicht auf <strong class='text-white'>Approve</strong> klicken, bleibt die Sitzung blockiert und das Popup schlägt weiter fehl. Das ist leicht zu übersehen, denn der Dialog sagt nichts über 2FA, es sieht nur so aus, als würde der Login nicht angenommen." },
    { type: "heading",text: "4. Es ist ein Evaluierungskonto einer Prop Firm" },
    { type: "paragraph",html: "Hier tappen viele finanzierte Trader in die Falle. Viele Prop Firms erlauben MotiveWave nicht, direkt mit ihren Tradovate-Evaluierungskonten zu sprechen, der Arbeitsbereich muss sich über ein anderes Gateway verbinden, meist Rithmic. Und da mehrere Firmen die Plattformwahl beim Kauf der Evaluierung festlegen, hat ein Konto auf der Tradovate-Plattform womöglich überhaupt keinen gültigen Weg in MotiveWave. Das Popup lehnt dann völlig korrekte Zugangsdaten ab, weil es die falsche Tür ist." },
    { type: "heading",text: "5. Veraltete oder falsch eingegebene Zugangsdaten" },
    { type: "paragraph",html: "Haben Sie Ihr Tradovate-Passwort auf der Website geändert, aber das alte im MotiveWave-Arbeitsbereich gespeichert gelassen, löst jeder Start das Popup aus. Copy-and-paste-Fehler, Leerzeichen am Ende und ein abgelaufenes oder inaktives Tradovate-Abonnement fallen in dieselbe Kategorie." },
    { type: "heading",text: "6. Ein Netzwerk- oder Konnektor-Problem" },
    { type: "paragraph",html: "Eine &ldquo;Connection Failed&rdquo;-Meldung mit einer java.net-Exception, besonders bei einem Setup, das monatelang einwandfrei lief und dann kaputtging, hat in der Regel nichts mit Ihrem Passwort zu tun. Eine Firewall, ein Virenscanner oder ein VPN kann die Verbindung blockieren, und Drittanbieter-Konnektoren ändern sich gelegentlich so, dass die neueste MotiveWave-Version nötig ist, um kompatibel zu bleiben." },
    { type: "heading",text: "So beheben Sie den MotiveWave-Tradovate-Login-Fehler: Schritt für Schritt" },
    { type: "heading",text: "Schritt 1: Umgebung abgleichen, dann Zugangsdaten neu eingeben" },
    { type: "paragraph",html: "Bauen Sie die Verbindung sauber neu auf, damit kein veraltetes Passwort im Spiel ist:" },
    {
      type: "steps",
      items: [
        { title: "Verbindungseinrichtung öffnen", html: "Öffnen Sie in MotiveWave Ihre Arbeitsbereichs-Einstellungen (oder erstellen Sie einen neuen Arbeitsbereich) und starten Sie die Verbindungseinrichtung für Tradovate." },
        { title: "Die passende Umgebung wählen", html: "Wählen Sie die Umgebung, die zu Ihrem Konto passt, <strong class='text-white'>Live</strong> für einen finanzierten/Live-Tradovate-Login, <strong class='text-white'>Demo</strong> für einen Simulations-Login. Bestätigen Sie die genaue Bezeichnung auf dem aktuellen MotiveWave-Bildschirm, da der Wortlaut je nach Version variieren kann." },
        { title: "Zugangsdaten von Hand eingeben", html: "Geben Sie Ihren Tradovate-Benutzernamen und Ihr Passwort von Hand ein. Achten Sie auf Leerzeichen am Ende und prüfen Sie die Groß-/Kleinschreibung, und wenn Sie das Passwort kürzlich auf der Tradovate-Website zurückgesetzt haben, verwenden Sie das neue." },
        { title: "Einrichtung abschließen und neu verbinden", html: "Schließen Sie die Einrichtung ab und lassen Sie den Arbeitsbereich neu verbinden." },
      ],
    },
    { type: "paragraph",html: "Funktionieren die Zugangsdaten auf der Tradovate-Website selbst, schlagen hier aber fehl, ist fast immer eine Umgebungsabweichung der Grund, wechseln Sie zwischen Live/Demo und versuchen Sie es erneut." },
    { type: "heading",text: "Schritt 2: Tradovate-Datenabonnement und -Vereinbarung bestätigen" },
    { type: "paragraph",html: "Tun Sie das direkt bei Tradovate, nicht in MotiveWave:" },
    {
      type: "steps",
      items: [
        { title: "Auf der Tradovate-Website anmelden", html: "Melden Sie sich auf der Tradovate-Website in Ihrem Konto an." },
        { title: "Das Marktdatenabonnement bestätigen", html: "Öffnen Sie den Konto-/Abonnementbereich und bestätigen Sie, dass Ihr <strong class='text-white'>Echtzeit-Marktdatenabonnement</strong> aktiv ist. Prüfen Sie die genaue Menübezeichnung in der aktuellen Tradovate-Oberfläche." },
        { title: "Die Börsen-Datenvereinbarung unterzeichnen", html: "Prüfen Sie, ob die Marktdatenvereinbarung der Börse (CME) unterzeichnet ist. Falls nicht, unterzeichnen Sie sie, das Konto aktualisiert sich automatisch, sobald Sie zustimmen, und Live-Daten stehen zur Verfügung." },
        { title: "In MotiveWave neu verbinden", html: "Kehren Sie zu MotiveWave zurück und verbinden Sie neu. Mit vorhandener Berechtigung kann der Daten-Login abgeschlossen werden, und das Popup sollte verschwinden." },
      ],
    },
    { type: "heading",text: "Schritt 3: Gerät genehmigen, wenn 2FA aktiv ist" },
    {
      type: "steps",
      items: [
        { title: "Login einmal versuchen", html: "Versuchen Sie den MotiveWave-Login einmal, damit Tradovate das neue Gerät registriert und die Genehmigungs-E-Mail sendet." },
        { title: "Die Geräte-Genehmigungs-E-Mail finden", html: "Öffnen Sie das mit Ihrem Tradovate-Konto verknüpfte Postfach, prüfen Sie auch Spam/Junk und einen eventuellen Tab Werbung, und suchen Sie die Benachrichtigung zum Geräte-Login." },
        { title: "Auf Approve klicken", html: "Klicken Sie auf <strong class='text-white'>Approve</strong> (nicht Deny), kehren Sie dann zu MotiveWave zurück und melden Sie sich erneut an." },
        { title: "Wenn keine E-Mail eintrifft", html: "Prüfen Sie, ob die E-Mail-Adresse in Ihrem Tradovate-Profil korrekt ist und Sie darauf zugreifen können, setzen Sie Tradovate als Absender auf die Zulassungsliste und bitten Sie bei Bedarf den Tradovate-Support, das Gerät von dessen Seite zu genehmigen." },
      ],
    },
    { type: "heading",text: "Schritt 4: Kontotyp bestätigen (Prop vs. privat)" },
    {
      type: "steps",
      items: [
        { title: "Verbindungsanleitung Ihrer Firma prüfen", html: "Handelt es sich um ein Evaluierungs- oder finanziertes Konto einer Prop Firm, prüfen Sie vor allem anderen die aktuelle Plattform-Verbindungsanleitung Ihrer Firma." },
        { title: "Rithmic verwenden, wenn das das Gateway der Firma ist", html: "Leitet die Firma MotiveWave über Rithmic statt über Tradovate, richten Sie in MotiveWave eine <strong class='text-white'>Rithmic</strong>-Verbindung mit den Rithmic-Zugangsdaten der Firma ein, statt zu versuchen, sich mit Tradovate-Daten anzumelden." },
        { title: "Eine plattformgebundene Evaluierung verstehen", html: "Hat die Firma Ihre Evaluierung auf die Tradovate-Plattform festgelegt, beachten Sie, dass sie sich womöglich gar nicht mit MotiveWave verbinden lässt, das ist eine Plattform-Einschränkung und kein Passwortproblem. Kontaktieren Sie die Firma, um Ihre Optionen zu klären." },
      ],
    },
    { type: "heading",text: "Schritt 5: Netzwerk- und Versionsblockaden beseitigen" },
    {
      type: "steps",
      items: [
        { title: "MotiveWave neu starten", html: "Starten Sie MotiveWave vollständig neu, um die Verbindung zum Server neu aufzubauen, und versuchen Sie dann erneut den Login." },
        { title: "Firewall/Virenscanner/VPN ausschließen", html: "Deaktivieren Sie vorübergehend oder legen Sie eine Ausnahme für jede Firewall, jeden Virenscanner oder jedes VPN an, die die Verbindung abfangen könnten, und testen Sie dann erneut." },
        { title: "Auf die neueste Version aktualisieren", html: "Aktualisieren Sie MotiveWave auf die neueste Version. Konnektoren zu Drittanbieter-Diensten ändern sich, und eine veraltete Version kann bei einem früher funktionierenden Setup einen &ldquo;Connection Failed&rdquo;-Fehler auslösen." },
        { title: "Tickets bei beiden Support-Teams eröffnen", html: "Schlägt es weiterhin fehl, eröffnen Sie ein Ticket beim MotiveWave-Support und bitten Sie parallel Tradovate, zu bestätigen, dass Ihre Kontoverknüpfung und Datenberechtigung auf deren Seite in Ordnung sind." },
      ],
    },
    { type: "heading",text: "Fehlerbehebungstabelle" },
    { type: "table", headers: ["Symptom","Wahrscheinliche Ursache","Lösung"], rows: [
      ["&ldquo;Username or password is not correct&rdquo; (funktionieren aber auf Tradovate.com)","Live-Zugangsdaten an Demo-Server gesendet oder umgekehrt","Verbindungsumgebung an Ihr Konto anpassen, dann Zugangsdaten neu eingeben"],
      ["Login-Popup erscheint bei jedem Start erneut","Inaktives Datenabonnement oder nicht unterzeichnete Marktdatenvereinbarung","Börsen-Datenvereinbarung unterzeichnen und Abonnement auf der Tradovate-Website bestätigen"],
      ["Login wird nicht abgeschlossen, kein klarer Fehler","2FA hält ein nicht genehmigtes Gerät an","Die E-Mail zur Geräte-Benachrichtigung öffnen, auf Approve klicken, dann erneut versuchen"],
      ["Korrekte Zugangsdaten werden trotzdem abgelehnt","Evaluierungskonto der Prop Firm nicht über Tradovate routbar","Über das von der Firma unterstützte Gateway verbinden (oft Rithmic)"],
