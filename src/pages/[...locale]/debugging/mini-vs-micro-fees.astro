---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "mini-vs-micro-fees";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/debugging/${SLUG}`;

const META_TITLE = "Tradovate Mini vs Micro Fees: Not a 10x Rule";
const META_DESCRIPTION =
  "Minis don't cost 10x micros. See how futures all-in round-turn fees really break down (commission, exchange, NFA, clearing) and pick the cheaper contract.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Tradovate Mini vs. Micro Gebühren: keine 10x-Regel", es: "Comisiones de Tradovate Mini vs Micro: no es una regla de 10x", fr: "Frais Tradovate Mini vs Micro : pas une règle de 10x", it: "Commissioni Tradovate Mini vs Micro: non è una regola da 10x" },
  dek: { en: "A mini controls 10 times the point value of its micro, so it's easy to assume it costs 10 times as much to trade. It doesn't. Here's how the all-in round-turn fee really breaks down, and when a micro quietly costs you more.", de: "Ein Mini kontrolliert den 10-fachen Punktwert seines Micros, daher nimmt man leicht an, dass er auch 10-mal so viel kostet. Das stimmt nicht. Hier sehen Sie, wie sich die tatsächliche Round-Turn-Gesamtgebühr zusammensetzt und wann ein Micro Sie unbemerkt mehr kostet.", es: "Un mini controla 10 veces el valor por punto de su micro, así que es fácil suponer que operar cuesta 10 veces más. No es así. Aquí le explicamos cómo se desglosa realmente la comisión total por operación completa y cuándo un micro le cuesta más sin que se dé cuenta.", fr: "Un mini contrôle 10 fois la valeur du point de son micro, il est donc facile de supposer qu'il coûte 10 fois plus cher à trader. Ce n'est pas le cas. Voici comment se décompose réellement le frais tout compris par aller-retour, et quand un micro vous coûte discrètement plus.", it: "Un mini controlla 10 volte il valore del punto del suo micro, quindi è facile supporre che costi 10 volte di più da negoziare. Non è così. Ecco come si scompone davvero la commissione complessiva per round turn e quando un micro le costa silenziosamente di più." },
  readTime: { en: "8 min read", de: "8 Min. Lesezeit", es: "Lectura de 8 min", fr: "Lecture : 8 min", it: "Lettura di 8 min" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "Here's a mistake that quietly costs traders money: assuming a mini contract costs ten times what its micro version costs to trade. It's an easy leap. An MNQ is one-tenth of an NQ, an MES is one-tenth of an ES, so the fees must scale the same way, right? They don't. A mini controls 10x the point value of its micro, but the all-in fee you actually pay is only about <strong class='text-white'>3 to 4 times higher</strong>, not 10x. That gap changes how you should think about contract size, and it's the difference between a micro-scalping plan that bleeds fees and one that doesn't. Let's break down where every cent goes and how to check yours." },
    { type: "quote", html: "Exact fee amounts change and vary by contract, membership plan, and account type. The figures below were verified against Tradovate's published commission and plan pricing and against CME and NFA fee schedules, but all of them can be revised. Prop-firm accounts often use their own bundled rates. Always confirm the current numbers in your own fee schedule before sizing trades." },
    {
      type: "checklist",
      heading: "Quick Reference: Mini vs Micro Fees",
      items: [
        "<strong class='text-white'>The 10x assumption is wrong.</strong> A micro is one-tenth the size of its mini, but its fee is roughly one-third to one-quarter, not one-tenth.",
        "<strong class='text-white'>Compare the all-in round-turn, not the commission.</strong> The number that matters is commission plus exchange plus NFA plus clearing, counted for both entry and exit.",
        "<strong class='text-white'>The NFA fee is flat.</strong> It's the same handful of cents whether you trade an ES or an MES, which is a big reason micros cost proportionally more.",
        "<strong class='text-white'>Ten micros cost more than one mini.</strong> Same exposure, but you pay the per-contract fee ten times, which lands near 3x the fee of the single mini.",
        "<strong class='text-white'>Micros still earn their premium for small accounts.</strong> Finer position sizing and tighter risk control are often worth a little more per unit.",
        "<strong class='text-white'>Your plan only moves commission.</strong> Exchange and NFA fees are set outside the broker and don't shift when you change tiers.",
      ],
    },
    { type: "heading", text: "How Tradovate's All-In Rate Actually Breaks Down" },
    { type: "paragraph", html: "The headline number brokers advertise is the commission. That's only one slice of what leaves your account on every trade. The real cost, the <strong class='text-white'>all-in rate</strong>, is made of four parts:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Commission</strong> &ndash; what Tradovate charges, and the only piece your membership plan changes.",
        "<strong class='text-white'>Exchange fee</strong> &ndash; set by CME for the specific contract. It's the same at every broker but differs by product and by whether you hold exchange membership.",
        "<strong class='text-white'>NFA regulatory fee</strong> &ndash; a small, flat per-side charge from the National Futures Association, identical for a giant contract or a tiny one.",
        "<strong class='text-white'>Clearing fee</strong> &ndash; charged by the clearing firm. It can vary by broker but generally doesn't vary by contract.",
      ],
    },
    { type: "paragraph", html: "A <strong class='text-white'>round-turn</strong> counts both sides of the trade, because you pay each of these fees going in and again coming out. When you hear &ldquo;the all-in round-turn on MNQ is about a dollar and a half,&rdquo; that's the full in-and-out cost of one micro contract, commission and fees included." },
    { type: "paragraph", html: "Here's how the four parts behave when you drop from a standard contract down to its micro. Notice that not one of them falls by a factor of 10:" },
    {
      type: "table",
      headers: ["Fee component", "Who sets it", "Standard (NQ / ES) per side", "Micro (MNQ / MES) per side", "Drops 10x?"],
      rows: [
        ["Commission", "Tradovate (plan)", "~$0.59 to $1.29", "~$0.09 to $0.39", "No (about 3x)"],
        ["Exchange fee", "CME", "~$1.15 to $1.40", "~$0.25 to $0.35", "No (about 4x)"],
        ["NFA regulatory", "NFA", "~$0.01 to $0.02", "~$0.01 to $0.02", "No (identical)"],
        ["Clearing", "Clearing firm", "Varies", "Varies", "No"],
      ],
    },
    { type: "paragraph", html: "The commission spread reflects Tradovate's plan tiers. On the Free (pay-as-you-go) plan you pay roughly $1.29 per side on a standard contract and $0.39 on a micro. On Monthly that's about $0.99 versus $0.29, and on Lifetime around $0.59 versus $0.09. Even the commission alone, before fees, is only about a 3x gap between mini and micro, not 10x." },
    { type: "heading", text: "Why a Mini Doesn't Cost 10x a Micro" },
    { type: "paragraph", html: "The math only looks surprising until you see the flat pieces. The exchange fee shrinks on a micro, but nowhere near tenfold. The clearing fee is broadly the same figure regardless of contract. The NFA fee is identical on both. Add a commission that's only about a third as low, and the total can't collapse to one-tenth." },
    { type: "paragraph", html: "Put it in concrete numbers with the Nasdaq pair. An NQ is worth $20 a point; an MNQ is worth $2 a point, exactly one-tenth. Yet a typical all-in round-turn works out around <strong class='text-white'>$4.36 on the NQ and about $1.32 on the MNQ</strong>. The exposure ratio is 10 to 1. The fee ratio is closer to 3.3 to 1." },
    {
      type: "table",
      headers: ["", "NQ (mini)", "MNQ (micro)", "Mini vs micro"],
      rows: [
        ["Point value", "$20 / point", "$2 / point", "10x"],
        ["Example all-in round-turn fee", "~$4.36", "~$1.32", "~3.3x"],
        ["Fee as a share of one point", "~22%", "~66%", "Micro costs 3x more"],
      ],
    },
    { type: "paragraph", html: "Read that bottom row slowly, because it's the whole point. On the mini, the round-turn fee eats roughly a fifth of a single point. On the micro, it eats about two-thirds of a point. A scalp that grabs one point keeps far more of it on a mini. Micros aren't &ldquo;bad,&rdquo; but per unit of exposure they carry a heavier fee load, and a strategy built on small point targets feels that every trade." },
    { type: "heading", text: "The Trap: Stacking Ten Micros to Fake a Mini" },
    { type: "paragraph", html: "This is where the misconception costs real money. Say you want NQ-sized exposure but reach for ten MNQ contracts instead of one NQ. Same market, same bet, but now you pay the micro's per-contract fee ten times over. Ten MNQ round-turns at about $1.32 each is roughly <strong class='text-white'>$13.20</strong>, against roughly <strong class='text-white'>$4.36</strong> for the single NQ. Identical exposure, about three times the fees. The same holds on the S&amp;P side, where ten MES round-turns run well above one ES." },
    { type: "paragraph", html: "The rule of thumb that falls out of this: once you're consistently trading a micro in blocks of ten, the matching mini is the cheaper instrument for that size. Micros are for when you genuinely want fractional exposure, not for simulating a mini one-tenth at a time." },
    { type: "heading", text: "When Paying the Micro Premium Is Still Smart" },
    { type: "paragraph", html: "None of this means micros are a rip-off. For a small or newly funded account, sizing at $2 a point instead of $20 is worth real money in avoided drawdown. Scaling in and out in fine increments, holding a runner without betting the account, testing a live strategy at minimal risk: that's what micros are for. The premium buys you control. Just don't reach for ten micros when one mini does the same job for less." },
    { type: "heading", text: "How to Check Your Own Per-Contract Fees" },
    { type: "paragraph", html: "Advertised rates are a starting point, not the receipt. The only fee that matters is the one that actually posts to your account, and Tradovate itemizes it for you." },
    { type: "heading", text: "Step 1: Pull a Filled-Orders or Fees Report" },
    {
      type: "steps",
      items: [
        { title: "Log in to Tradovate", html: "Log in to Tradovate on web or desktop." },
        { title: "Open the reports area", html: "Open the account reports or statements area (look under an Account, Reports, or Statements menu)." },
        { title: "Pull a filled-orders or fees report", html: "Choose a filled-orders, fills, or fees report and set the date range to a period where you actually traded." },
        { title: "Find the commission and fee columns", html: "Find the commission and fee columns tied to each fill. That per-contract figure is your true cost." },
      ],
    },
    { type: "heading", text: "Step 2: Read Commission and Fees Separately" },
    { type: "paragraph", html: "Statements usually split the broker commission from the exchange, NFA, and clearing fees. Add them together for the honest all-in number, and remember to double it for a round-turn if the report shows a single side. If your export only lists a gross figure without the fee breakdown, that's a known limitation of some Tradovate exports, so reconcile against the statement that does itemize fees." },
    { type: "heading", text: "Step 3: Confirm Your Plan's Commission Tier" },
    {
      type: "steps",
      items: [
        { title: "Open your plan settings", html: "Open your membership or plan settings in Tradovate." },
        { title: "Check which tier is active", html: "Check which tier is active (Free, Monthly, or Lifetime) and the per-side commission it applies to micros and standards." },
        { title: "Match it against your trade volume", html: "Match that against your real trade volume. If you trade enough size, a paid tier's lower commission can more than cover its flat cost, and it lowers the mini-versus-micro decision threshold too." },
      ],
    },
    { type: "heading", text: "Mini vs Micro Decision Table" },
    {
      type: "table",
      headers: ["Situation", "What's really happening", "Cheaper choice"],
      rows: [
        ["You assumed minis cost 10x micros", "Fee scales ~3 to 4x, not 10x, because flat fees don't shrink", "Budget with the real all-in round-turn, not a 10x guess"],
        ["You trade micros in blocks of ten", "You pay the micro fee ten times for one mini's exposure", "Trade the single matching mini"],
        ["Small account, tight risk", "Fine sizing is worth the higher per-unit fee", "Stay on micros, size deliberately"],
        ["Scalping tiny point targets on micros", "Fees eat a large share of each point", "Widen targets or move to the mini once size allows"],
        ["Comparing brokers on price", "Exchange and NFA fees are fixed; only commission differs", "Compare commission and clearing, ignore the fixed parts"],
        ["Prop-firm evaluation account", "Rates are bundled by the firm, not standard retail", "Check the firm's current per-contract schedule"],
      ],
    },
    { type: "heading", text: "Keep Your Sizing Rules Consistent With PickMyTrade" },
    { type: "paragraph", html: "Once you know the real fee math, the next job is applying it the same way on every trade instead of second-guessing size mid-move. PickMyTrade connects your TradingView alerts straight to your Tradovate account, so contract and quantity decisions run on rules you set in advance:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Fixed contract logic</strong> &ndash; define whether an alert fires a mini or a set number of micros, so you never fat-finger ten micros when you meant one mini.",
        "<strong class='text-white'>Hands-off execution</strong> &ndash; entries and exits fire automatically from your strategy, sized the way your plan intended.",
        "<strong class='text-white'>Multi-account sync</strong> &ndash; mirror the same sizing across several Tradovate accounts at once.",
        "<strong class='text-white'>Clean trade records</strong> &ndash; every automated fill is logged, so reconciling commissions and fees against your statements is simple.",
      ],
    },
    { type: "paragraph", html: "Automation won't change what CME charges, but it keeps your fee-aware sizing rules from slipping when the market moves fast." },
  ], de: [
    { type: "paragraph",html: "Hier ist ein Fehler, der Trader unbemerkt Geld kostet: anzunehmen, dass ein Mini-Kontrakt im Handel das Zehnfache seiner Micro-Version kostet. Der Gedanke liegt nahe. Ein MNQ ist ein Zehntel eines NQ, ein MES ein Zehntel eines ES, also müssten die Gebühren genauso skalieren, oder? Tun sie nicht. Ein Mini kontrolliert den 10x-Punktwert seines Micros, doch die tatsächlich gezahlte All-in-Gebühr ist nur etwa <strong class='text-white'>3- bis 4-mal höher</strong>, nicht 10x. Diese Lücke verändert, wie Sie über die Kontraktgröße denken sollten, und sie ist der Unterschied zwischen einem Micro-Scalping-Plan, der Gebühren verschlingt, und einem, der das nicht tut. Schauen wir uns an, wohin jeder Cent geht und wie Sie Ihre eigenen Werte prüfen." },
    { type: "quote",html: "Genaue Gebührenbeträge ändern sich und variieren je nach Kontrakt, Mitgliedschaftstarif und Kontotyp. Die folgenden Zahlen wurden anhand der veröffentlichten Provisions- und Tarifpreise von Tradovate sowie der Gebührenverzeichnisse von CME und NFA geprüft, können aber alle angepasst werden. Prop-Firm-Konten nutzen oft eigene Pauschalsätze. Prüfen Sie die aktuellen Zahlen immer in Ihrem eigenen Gebührenverzeichnis, bevor Sie Ihre Positionsgrößen festlegen." },
    {
      type: "checklist",
      heading: "Kurzübersicht: Mini- vs. Micro-Gebühren",
      items: [
        "<strong class='text-white'>Die 10x-Annahme ist falsch.</strong> Ein Micro ist ein Zehntel so groß wie sein Mini, aber seine Gebühr beträgt etwa ein Drittel bis ein Viertel, nicht ein Zehntel.",
        "<strong class='text-white'>Vergleichen Sie den All-in-Round-Turn, nicht die Provision.</strong> Entscheidend ist Provision plus Börse plus NFA plus Clearing, gezählt für Einstieg und Ausstieg.",
        "<strong class='text-white'>Die NFA-Gebühr ist pauschal.</strong> Es sind dieselben wenigen Cent, ob Sie einen ES oder einen MES handeln, was ein wichtiger Grund dafür ist, dass Micros anteilig mehr kosten.",
        "<strong class='text-white'>Zehn Micros kosten mehr als ein Mini.</strong> Gleiches Exposure, aber Sie zahlen die Gebühr pro Kontrakt zehnmal, was bei etwa 3x der Gebühr des einzelnen Minis landet.",
        "<strong class='text-white'>Micros verdienen sich ihren Aufpreis bei kleinen Konten trotzdem.</strong> Feinere Positionsgrößen und engere Risikokontrolle sind oft etwas mehr pro Einheit wert.",
        "<strong class='text-white'>Ihr Tarif ändert nur die Provision.</strong> Börsen- und NFA-Gebühren werden außerhalb des Brokers festgelegt und ändern sich beim Stufenwechsel nicht.",
      ],
    },
    { type: "heading",text: "So setzt sich der All-in-Satz bei Tradovate tatsächlich zusammen" },
    { type: "paragraph",html: "Die Zahl, mit der Broker werben, ist die Provision. Das ist nur ein Teil dessen, was bei jedem Trade Ihr Konto verlässt. Die tatsächlichen Kosten, der <strong class='text-white'>All-in-Satz</strong>, bestehen aus vier Teilen:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Provision</strong> &ndash; was Tradovate berechnet, und der einzige Teil, den Ihr Mitgliedschaftstarif ändert.",
        "<strong class='text-white'>Börsengebühr</strong> &ndash; von der CME für den jeweiligen Kontrakt festgelegt. Sie ist bei jedem Broker gleich, unterscheidet sich aber je nach Produkt und danach, ob Sie Börsenmitglied sind.",
        "<strong class='text-white'>Regulatorische NFA-Gebühr</strong> &ndash; eine kleine, pauschale Gebühr pro Seite der National Futures Association, identisch für einen großen oder einen winzigen Kontrakt.",
        "<strong class='text-white'>Clearing-Gebühr</strong> &ndash; vom Clearing-Haus erhoben. Sie kann je nach Broker variieren, variiert aber in der Regel nicht je nach Kontrakt.",
      ],
    },
    { type: "paragraph",html: "Ein <strong class='text-white'>Round-Turn</strong> zählt beide Seiten des Trades, denn Sie zahlen jede dieser Gebühren beim Einstieg und erneut beim Ausstieg. Wenn Sie hören &ldquo;der All-in-Round-Turn bei MNQ liegt bei etwa eineinhalb Dollar&rdquo;, sind das die vollständigen Kosten für Ein- und Ausstieg eines Micro-Kontrakts, Provision und Gebühren inbegriffen." },
    { type: "paragraph",html: "So verhalten sich die vier Teile, wenn Sie von einem Standardkontrakt auf sein Micro wechseln. Beachten Sie, dass keiner davon um den Faktor 10 sinkt:" },
    { type: "table", headers: ["Gebührenbestandteil","Wer legt sie fest","Standard (NQ / ES) pro Seite","Micro (MNQ / MES) pro Seite","Sinkt um das 10-Fache?"], rows: [
      ["Provision","Tradovate (Tarif)","ca. $0.59 bis $1.29","ca. $0.09 bis $0.39","Nein (etwa 3x)"],
      ["Börsengebühr","CME","ca. $1.15 bis $1.40","ca. $0.25 bis $0.35","Nein (etwa 4x)"],
      ["NFA-Regulierung","NFA","ca. $0.01 bis $0.02","ca. $0.01 bis $0.02","Nein (identisch)"],
      ["Clearing","Clearing-Haus","Variiert","Variiert","Nein"],
    ] },
    { type: "paragraph",html: "Die Provisionsspanne spiegelt die Tarifstufen von Tradovate wider. Im Free-Tarif (Pay-as-you-go) zahlen Sie etwa $1.29 pro Seite bei einem Standardkontrakt und $0.39 bei einem Micro. Bei Monthly sind es rund $0.99 gegenüber $0.29, bei Lifetime etwa $0.59 gegenüber $0.09. Selbst die Provision allein ist vor den Gebühren nur etwa ein Faktor 3 zwischen Mini und Micro, nicht 10." },
    { type: "heading",text: "Warum ein Mini nicht das 10-Fache eines Micros kostet" },
    { type: "paragraph",html: "Die Rechnung überrascht nur, bis man die pauschalen Anteile sieht. Die Börsengebühr sinkt bei einem Micro, aber bei Weitem nicht um das Zehnfache. Die Clearing-Gebühr ist unabhängig vom Kontrakt im Großen und Ganzen derselbe Betrag. Die NFA-Gebühr ist bei beiden identisch. Kommt eine Provision hinzu, die nur etwa um ein Drittel niedriger ist, kann die Summe nicht auf ein Zehntel fallen." },
    { type: "paragraph",html: "Konkret am Nasdaq-Paar: Ein NQ ist $20 pro Punkt wert, ein MNQ $2 pro Punkt, also genau ein Zehntel. Dennoch beträgt ein typischer All-in-Round-Turn etwa <strong class='text-white'>$4.36 beim NQ und rund $1.32 beim MNQ</strong>. Das Exposure-Verhältnis ist 10 zu 1. Das Gebührenverhältnis liegt eher bei 3.3 zu 1." },
    { type: "table", headers: ["","NQ (Mini)","MNQ (Micro)","Mini vs. Micro"], rows: [
      ["Punktwert","$20 / Punkt","$2 / Punkt","10x"],
      ["Beispiel All-in-Round-Turn-Gebühr","ca. $4.36","ca. $1.32","ca. 3.3x"],
      ["Gebühr als Anteil eines Punktes","ca. 22%","ca. 66%","Micro kostet 3x mehr"],
    ] },
    { type: "paragraph",html: "Lesen Sie die untere Zeile langsam, denn sie ist der ganze Punkt. Beim Mini frisst die Round-Turn-Gebühr etwa ein Fünftel eines einzelnen Punktes. Beim Micro frisst sie etwa zwei Drittel eines Punktes. Ein Scalp, der einen Punkt mitnimmt, behält davon beim Mini weit mehr. Micros sind nicht &ldquo;schlecht&rdquo;, aber pro Einheit Exposure tragen sie eine höhere Gebührenlast, und eine Strategie mit kleinen Punktzielen spürt das bei jedem Trade." },
    { type: "heading",text: "Die Falle: Zehn Micros stapeln, um einen Mini nachzubilden" },
    { type: "paragraph",html: "Hier kostet das Missverständnis echtes Geld. Angenommen, Sie wollen NQ-große Exposure, greifen aber zu zehn MNQ-Kontrakten statt zu einem NQ. Gleicher Markt, gleiche Wette, aber nun zahlen Sie die Gebühr pro Micro-Kontrakt zehnmal. Zehn MNQ-Round-Turns zu etwa $1.32 ergeben rund <strong class='text-white'>$13.20</strong>, gegenüber rund <strong class='text-white'>$4.36</strong> für den einzelnen NQ. Identisches Exposure, etwa dreifache Gebühren. Dasselbe gilt auf der S&amp;P-Seite, wo zehn MES-Round-Turns deutlich über einem ES liegen." },
    { type: "paragraph",html: "Daraus folgt die Faustregel: Sobald Sie regelmäßig einen Micro in Zehnerblöcken handeln, ist der passende Mini für diese Größe das günstigere Instrument. Micros sind für den Fall gedacht, dass Sie wirklich anteiliges Exposure wollen, nicht um einen Mini in Zehntelschritten nachzubauen." },
    { type: "heading",text: "Wann der Micro-Aufpreis trotzdem sinnvoll ist" },
    { type: "paragraph",html: "Nichts davon bedeutet, dass Micros Wucher wären. Für ein kleines oder frisch finanziertes Konto ist eine Größe von $2 pro Punkt statt $20 durch vermiedenen Drawdown bares Geld wert. In feinen Schritten ein- und aussteigen, einen Runner halten, ohne das Konto zu riskieren, eine Live-Strategie mit minimalem Risiko testen: dafür sind Micros da. Der Aufpreis kauft Kontrolle. Greifen Sie nur nicht zu zehn Micros, wenn ein Mini dieselbe Aufgabe günstiger erledigt." },
    { type: "heading",text: "So prüfen Sie Ihre eigenen Gebühren pro Kontrakt" },
    { type: "paragraph",html: "Beworbene Sätze sind ein Ausgangspunkt, nicht die Quittung. Maßgeblich ist allein die Gebühr, die tatsächlich auf Ihrem Konto verbucht wird, und Tradovate schlüsselt sie Ihnen auf." },
    { type: "heading",text: "Schritt 1: Bericht über ausgeführte Orders oder Gebühren abrufen" },
    {
      type: "steps",
      items: [
        { title: "Bei Tradovate anmelden", html: "Melden Sie sich bei Tradovate im Web oder auf dem Desktop an." },
        { title: "Den Berichtsbereich öffnen", html: "Öffnen Sie den Bereich für Konto-Berichte oder Kontoauszüge (suchen Sie unter einem Menü wie Account, Reports oder Statements)." },
        { title: "Einen Bericht über ausgeführte Orders oder Gebühren abrufen", html: "Wählen Sie einen Bericht über ausgeführte Orders, Fills oder Gebühren und stellen Sie den Zeitraum auf eine Periode ein, in der Sie tatsächlich gehandelt haben." },
        { title: "Die Spalten für Provision und Gebühren finden", html: "Suchen Sie die Spalten für Provision und Gebühren, die zu jeder Ausführung gehören. Dieser Wert pro Kontrakt sind Ihre wahren Kosten." },
      ],
    },
    { type: "heading",text: "Schritt 2: Provision und Gebühren getrennt lesen" },
    { type: "paragraph",html: "Kontoauszüge trennen in der Regel die Broker-Provision von Börsen-, NFA- und Clearing-Gebühren. Addieren Sie sie für die ehrliche All-in-Zahl, und denken Sie daran, für einen Round-Turn zu verdoppeln, wenn der Bericht nur eine Seite zeigt. Listet Ihr Export nur einen Bruttobetrag ohne Gebührenaufschlüsselung auf, ist das eine bekannte Einschränkung mancher Tradovate-Exporte; gleichen Sie dann mit dem Auszug ab, der die Gebühren aufschlüsselt." },
    { type: "heading",text: "Schritt 3: Provisionsstufe Ihres Tarifs bestätigen" },
    {
      type: "steps",
      items: [
        { title: "Tarifeinstellungen öffnen", html: "Öffnen Sie Ihre Mitgliedschafts- oder Tarifeinstellungen in Tradovate." },
        { title: "Prüfen, welche Stufe aktiv ist", html: "Prüfen Sie, welche Stufe aktiv ist (Free, Monthly oder Lifetime) und welche Provision pro Seite sie auf Micros und Standardkontrakte anwendet." },
        { title: "Mit Ihrem Handelsvolumen abgleichen", html: "Gleichen Sie das mit Ihrem tatsächlichen Handelsvolumen ab. Wenn Sie genug Größe handeln, kann die niedrigere Provision einer kostenpflichtigen Stufe deren Pauschalkosten mehr als ausgleichen, und sie senkt auch die Entscheidungsschwelle zwischen Mini und Micro." },
      ],
    },
    { type: "heading",text: "Entscheidungstabelle Mini vs. Micro" },
    { type: "table", headers: ["Situation","Was wirklich passiert","Günstigere Wahl"], rows: [
      ["Sie dachten, Minis kosten 10x so viel wie Micros","Die Gebühr skaliert um das ca. 3- bis 4-Fache, nicht 10x, weil pauschale Gebühren nicht schrumpfen","Kalkulieren Sie mit dem realen All-in-Round-Turn, nicht mit einer 10x-Schätzung"],
      ["Sie handeln Micros in Zehnerblöcken","Sie zahlen die Micro-Gebühr zehnmal für das Exposure eines Minis","Den einzelnen passenden Mini handeln"],
      ["Kleines Konto, enges Risiko","Feine Positionsgrößen sind die höhere Gebühr pro Einheit wert","Bei Micros bleiben, Größe bewusst wählen"],
      ["Scalping winziger Punktziele mit Micros","Gebühren fressen einen großen Anteil jedes Punktes","Ziele erweitern oder zum Mini wechseln, sobald die Größe es erlaubt"],
      ["Broker nach Preis vergleichen","Börsen- und NFA-Gebühren sind fix; nur die Provision unterscheidet sich","Provision und Clearing vergleichen, feste Anteile ignorieren"],
      ["Prop-Firm-Evaluierungskonto","Sätze werden von der Firma pauschal festgelegt, nicht Standard-Retail","Aktuelles Gebührenverzeichnis pro Kontrakt der Firma prüfen"],
    ] },
    { type: "heading",text: "Halten Sie Ihre Positionsgrößen-Regeln mit PickMyTrade konsistent" },
    { type: "paragraph",html: "Sobald Sie die reale Gebührenrechnung kennen, besteht die nächste Aufgabe darin, sie bei jedem Trade gleich anzuwenden, statt die Größe mitten in der Bewegung zu überdenken. PickMyTrade verbindet Ihre TradingView-Alerts direkt mit Ihrem Tradovate-Konto, sodass Entscheidungen zu Kontrakt und Menge nach Regeln laufen, die Sie vorab festlegen:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Feste Kontraktlogik</strong> &ndash; legen Sie fest, ob ein Alert einen Mini oder eine feste Anzahl Micros auslöst, damit Sie nie versehentlich zehn Micros eintippen, wenn Sie einen Mini meinten.",
        "<strong class='text-white'>Freihändige Ausführung</strong> &ndash; Einstiege und Ausstiege werden automatisch von Ihrer Strategie ausgelöst, in der Größe, die Ihr Plan vorsieht.",
        "<strong class='text-white'>Multi-Account-Synchronisierung</strong> &ndash; spiegeln Sie dieselbe Positionsgröße gleichzeitig auf mehrere Tradovate-Konten.",
        "<strong class='text-white'>Saubere Trade-Aufzeichnungen</strong> &ndash; jede automatisierte Ausführung wird protokolliert, sodass der Abgleich von Provisionen und Gebühren mit Ihren Auszügen einfach ist.",
      ],
    },
    { type: "paragraph",html: "Automatisierung ändert nichts an dem, was die CME berechnet, aber sie verhindert, dass Ihre gebührenbewussten Positionsgrößen-Regeln ins Rutschen geraten, wenn der Markt schnell läuft." },
  ], es: [
    { type: "paragraph",html: "Este es un error que cuesta dinero a los traders sin que se den cuenta: suponer que un contrato mini cuesta diez veces más que su versión micro al operar. Es una deducción fácil. Un MNQ es una décima parte de un NQ, un MES es una décima parte de un ES, así que las comisiones deben escalar igual, ¿verdad? No es así. Un mini controla 10x el valor por punto de su micro, pero la comisión total que realmente paga es solo unas <strong class='text-white'>3 a 4 veces mayor</strong>, no 10x. Esa diferencia cambia cómo debería pensar en el tamaño del contrato, y es la diferencia entre un plan de scalping con micros que se desangra en comisiones y uno que no. Veamos adónde va cada centavo y cómo comprobar el suyo." },
    { type: "quote",html: "Los importes exactos de las comisiones cambian y varían según el contrato, el plan de membresía y el tipo de cuenta. Las cifras siguientes se verificaron con las comisiones y precios de planes publicados por Tradovate y con las tablas de tarifas de CME y NFA, pero todas pueden revisarse. Las cuentas de prop firms suelen usar sus propias tarifas agrupadas. Confirme siempre las cifras vigentes en su propia tabla de comisiones antes de dimensionar sus operaciones." },
    {
      type: "checklist",
      heading: "Referencia rápida: comisiones de mini vs micro",
      items: [
        "<strong class='text-white'>La suposición de 10x es errónea.</strong> Un micro es una décima parte de su mini, pero su comisión es aproximadamente un tercio o un cuarto, no una décima parte.",
        "<strong class='text-white'>Compare la operación completa all-in, no la comisión.</strong> La cifra que importa es comisión más bolsa más NFA más compensación, contada para entrada y salida.",
        "<strong class='text-white'>La tarifa de la NFA es fija.</strong> Son los mismos centavos tanto si opera un ES como un MES, lo que explica en gran parte que los micros cuesten proporcionalmente más.",
        "<strong class='text-white'>Diez micros cuestan más que un mini.</strong> La misma exposición, pero paga la comisión por contrato diez veces, lo que se acerca a 3x la comisión del mini individual.",
        "<strong class='text-white'>Los micros siguen justificando su prima en cuentas pequeñas.</strong> Un dimensionamiento más fino y un control de riesgo más ajustado suelen valer un poco más por unidad.",
        "<strong class='text-white'>Su plan solo mueve la comisión.</strong> Las tarifas de bolsa y NFA se fijan fuera del bróker y no cambian al cambiar de nivel.",
      ],
    },
    { type: "heading",text: "Cómo se desglosa realmente la tarifa all-in de Tradovate" },
    { type: "paragraph",html: "La cifra principal que anuncian los brókeres es la comisión. Es solo una parte de lo que sale de su cuenta en cada operación. El coste real, la <strong class='text-white'>tarifa all-in</strong>, se compone de cuatro partes:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Comisión</strong> &ndash; lo que cobra Tradovate, y la única parte que cambia su plan de membresía.",
        "<strong class='text-white'>Tarifa de bolsa</strong> &ndash; fijada por CME para el contrato concreto. Es la misma en cualquier bróker, pero difiere según el producto y según si posee membresía de bolsa.",
        "<strong class='text-white'>Tarifa regulatoria de la NFA</strong> &ndash; un cargo pequeño y fijo por lado de la National Futures Association, idéntico para un contrato grande o uno diminuto.",
        "<strong class='text-white'>Tarifa de compensación</strong> &ndash; cobrada por la cámara de compensación. Puede variar según el bróker, pero en general no varía según el contrato.",
      ],
    },
    { type: "paragraph",html: "Una <strong class='text-white'>operación completa</strong> (round turn) cuenta ambos lados del trade, porque paga cada una de estas tarifas al entrar y de nuevo al salir. Cuando oiga &ldquo;la operación completa all-in en MNQ ronda un dólar y medio&rdquo;, ese es el coste total de entrada y salida de un contrato micro, comisión y tarifas incluidas." },
    { type: "paragraph",html: "Así se comportan las cuatro partes al pasar de un contrato estándar a su micro. Observe que ninguna de ellas cae en un factor de 10:" },
    { type: "table", headers: ["Componente de la tarifa","Quién la fija","Estándar (NQ / ES) por lado","Micro (MNQ / MES) por lado","¿Baja 10 veces?"], rows: [
      ["Comisión","Tradovate (plan)","~$0.59 a $1.29","~$0.09 a $0.39","No (unas 3x)"],
      ["Tarifa de bolsa","CME","~$1.15 a $1.40","~$0.25 a $0.35","No (unas 4x)"],
      ["Regulatoria NFA","NFA","~$0.01 a $0.02","~$0.01 a $0.02","No (idéntica)"],
      ["Compensación","Cámara de compensación","Varía","Varía","No"],
    ] },
    { type: "paragraph",html: "El rango de comisiones refleja los niveles de plan de Tradovate. En el plan Free (pago por uso) paga aproximadamente $1.29 por lado en un contrato estándar y $0.39 en un micro. En Monthly son unos $0.99 frente a $0.29, y en Lifetime alrededor de $0.59 frente a $0.09. Incluso solo la comisión, antes de las tarifas, es apenas una diferencia de 3x entre mini y micro, no de 10x." },
    { type: "heading",text: "Por qué un mini no cuesta 10 veces un micro" },
    { type: "paragraph",html: "La cuenta solo sorprende hasta que se ven las partes fijas. La tarifa de bolsa baja en un micro, pero ni de lejos diez veces. La tarifa de compensación es, en términos generales, la misma cifra sin importar el contrato. La tarifa de la NFA es idéntica en ambos. Sume una comisión que es solo un tercio más baja, y el total no puede caer a una décima parte." },
    { type: "paragraph",html: "Con cifras concretas del par Nasdaq: un NQ vale $20 por punto; un MNQ vale $2 por punto, exactamente una décima parte. Sin embargo, una operación completa all-in típica ronda <strong class='text-white'>$4.36 en el NQ y unos $1.32 en el MNQ</strong>. La proporción de exposición es de 10 a 1. La proporción de comisiones está más cerca de 3.3 a 1." },
    { type: "table", headers: ["","NQ (mini)","MNQ (micro)","Mini vs micro"], rows: [
      ["Valor por punto","$20 / punto","$2 / punto","10x"],
      ["Ejemplo de comisión all-in por operación completa","~$4.36","~$1.32","~3.3x"],
      ["Comisión como parte de un punto","~22%","~66%","El micro cuesta 3x más"],
    ] },
    { type: "paragraph",html: "Lea esa última fila despacio, porque es todo el punto. En el mini, la comisión de la operación completa se come aproximadamente una quinta parte de un solo punto. En el micro, se come unas dos terceras partes de un punto. Un scalp que captura un punto conserva mucho más en un mini. Los micros no son &ldquo;malos&rdquo;, pero por unidad de exposición cargan con una mayor carga de comisiones, y una estrategia basada en objetivos de pocos puntos lo nota en cada operación." },
    { type: "heading",text: "La trampa: apilar diez micros para simular un mini" },
    { type: "paragraph",html: "Aquí es donde el malentendido cuesta dinero real. Supongamos que quiere una exposición del tamaño de un NQ pero recurre a diez contratos MNQ en lugar de un NQ. El mismo mercado, la misma apuesta, pero ahora paga la comisión por contrato del micro diez veces. Diez operaciones completas de MNQ a unos $1.32 cada una suman aproximadamente <strong class='text-white'>$13.20</strong>, frente a unos <strong class='text-white'>$4.36</strong> del NQ individual. Exposición idéntica, unas tres veces las comisiones. Lo mismo ocurre en el lado del S&amp;P, donde diez operaciones completas de MES superan con creces a un ES." },
    { type: "paragraph",html: "La regla práctica que se deduce: una vez que opera de forma constante un micro en bloques de diez, el mini equivalente es el instrumento más barato para ese tamaño. Los micros sirven para cuando realmente quiere una exposición fraccionaria, no para simular un mini una décima parte cada vez." },
    { type: "heading",text: "Cuándo sigue siendo inteligente pagar la prima del micro" },
    { type: "paragraph",html: "Nada de esto significa que los micros sean un timo. Para una cuenta pequeña o recién financiada, dimensionar a $2 por punto en lugar de $20 vale dinero real en drawdown evitado. Entrar y salir en incrementos finos, mantener un runner sin apostar la cuenta, probar una estrategia en vivo con riesgo mínimo: para eso están los micros. La prima compra control. Simplemente no recurra a diez micros cuando un mini hace el mismo trabajo por menos." },
    { type: "heading",text: "Cómo comprobar sus propias comisiones por contrato" },
    { type: "paragraph",html: "Las tarifas anunciadas son un punto de partida, no el recibo. La única comisión que importa es la que realmente se carga en su cuenta, y Tradovate se la detalla." },
    { type: "heading",text: "Paso 1: Obtenga un informe de órdenes ejecutadas o de comisiones" },
    {
      type: "steps",
      items: [
        { title: "Inicie sesión en Tradovate", html: "Inicie sesión en Tradovate en la web o en el escritorio." },
        { title: "Abra el área de informes", html: "Abra el área de informes o extractos de la cuenta (busque en un menú como Account, Reports o Statements)." },
        { title: "Obtenga un informe de órdenes ejecutadas o de comisiones", html: "Elija un informe de órdenes ejecutadas, fills o comisiones y fije el rango de fechas en un periodo en el que haya operado realmente." },
        { title: "Localice las columnas de comisión y tarifas", html: "Localice las columnas de comisión y tarifas asociadas a cada ejecución. Esa cifra por contrato es su coste real." },
      ],
    },
    { type: "heading",text: "Paso 2: Lea por separado la comisión y las tarifas" },
    { type: "paragraph",html: "Los extractos suelen separar la comisión del bróker de las tarifas de bolsa, NFA y compensación. Súmelas para obtener la cifra all-in honesta, y recuerde duplicarla para una operación completa si el informe muestra un solo lado. Si su exportación solo muestra una cifra bruta sin el desglose de tarifas, es una limitación conocida de algunas exportaciones de Tradovate, así que concilie con el extracto que sí detalla las tarifas." },
    { type: "heading",text: "Paso 3: Confirme el nivel de comisión de su plan" },
    {
      type: "steps",
      items: [
        { title: "Abra los ajustes de su plan", html: "Abra los ajustes de su membresía o plan en Tradovate." },
        { title: "Compruebe qué nivel está activo", html: "Compruebe qué nivel está activo (Free, Monthly o Lifetime) y la comisión por lado que aplica a micros y a contratos estándar." },
        { title: "Contrástelo con su volumen de operaciones", html: "Contraste eso con su volumen real de operaciones. Si opera suficiente tamaño, la comisión más baja de un nivel de pago puede compensar con creces su coste fijo, y además reduce el umbral de decisión entre mini y micro." },
      ],
    },
    { type: "heading",text: "Tabla de decisión Mini vs Micro" },
    { type: "table", headers: ["Situación","Qué ocurre realmente","Opción más barata"], rows: [
      ["Suponía que los minis cuestan 10x más que los micros","La comisión escala ~3 a 4x, no 10x, porque las tarifas fijas no se reducen","Presupueste con la operación completa all-in real, no con una estimación de 10x"],
      ["Opera micros en bloques de diez","Paga la comisión del micro diez veces por la exposición de un mini","Operar el mini equivalente individual"],
      ["Cuenta pequeña, riesgo ajustado","El dimensionamiento fino compensa la mayor comisión por unidad","Seguir con micros, dimensionando con criterio"],
      ["Scalping de objetivos de pocos puntos con micros","Las comisiones se comen una gran parte de cada punto","Ampliar objetivos o pasar al mini cuando el tamaño lo permita"],
      ["Comparar brókeres por precio","Las tarifas de bolsa y NFA son fijas; solo difiere la comisión","Comparar comisión y compensación, ignorar las partes fijas"],
      ["Cuenta de evaluación de una prop firm","Las tarifas las agrupa la firma, no son las estándar minoristas","Consultar la tabla vigente por contrato de la firma"],
    ] },
    { type: "heading",text: "Mantenga sus reglas de dimensionamiento coherentes con PickMyTrade" },
    { type: "paragraph",html: "Una vez que conoce la cuenta real de las comisiones, la siguiente tarea es aplicarla igual en cada operación en lugar de replantear el tamaño en pleno movimiento. PickMyTrade conecta sus alertas de TradingView directamente con su cuenta de Tradovate, de modo que las decisiones de contrato y cantidad se ejecutan con reglas que usted fija de antemano:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Lógica fija de contratos</strong> &ndash; defina si una alerta ejecuta un mini o un número fijo de micros, para no teclear por error diez micros cuando quería un mini.",
        "<strong class='text-white'>Ejecución sin intervención</strong> &ndash; las entradas y salidas se disparan automáticamente desde su estrategia, con el tamaño que su plan preveía.",
        "<strong class='text-white'>Sincronización multicuenta</strong> &ndash; replique el mismo dimensionamiento en varias cuentas de Tradovate a la vez.",
        "<strong class='text-white'>Registros de operaciones limpios</strong> &ndash; cada ejecución automatizada queda registrada, por lo que conciliar comisiones y tarifas con sus extractos es sencillo.",
      ],
    },
    { type: "paragraph",html: "La automatización no cambiará lo que cobra CME, pero evita que sus reglas de dimensionamiento conscientes de las comisiones se desvíen cuando el mercado se mueve rápido." },
  ], fr: [
    { type: "paragraph",html: "Voici une erreur qui coûte discrètement de l'argent aux traders : supposer qu'un contrat mini coûte dix fois plus à trader que sa version micro. Le raccourci est facile. Un MNQ vaut un dixième d'un NQ, un MES un dixième d'un ES, donc les frais doivent évoluer de la même façon, n'est-ce pas ? Non. Un mini contrôle 10x la valeur du point de son micro, mais le frais tout compris que vous payez n'est qu'environ <strong class='text-white'>3 à 4 fois plus élevé</strong>, pas 10x. Cet écart change la façon dont vous devez envisager la taille des contrats, et c'est la différence entre un plan de scalping sur micros qui engloutit les frais et un autre qui ne le fait pas. Voyons où va chaque centime et comment vérifier les vôtres." },
    { type: "quote",html: "Les montants exacts des frais changent et varient selon le contrat, la formule d'abonnement et le type de compte. Les chiffres ci-dessous ont été vérifiés d'après les commissions et les tarifs de plans publiés par Tradovate ainsi que les grilles de frais du CME et de la NFA, mais tous peuvent être révisés. Les comptes de prop firms utilisent souvent leurs propres tarifs forfaitaires. Confirmez toujours les chiffres en vigueur dans votre propre grille tarifaire avant de dimensionner vos trades." },
    {
      type: "checklist",
      heading: "Référence rapide : frais mini vs micro",
      items: [
        "<strong class='text-white'>L'hypothèse du 10x est fausse.</strong> Un micro est dix fois plus petit que son mini, mais son frais représente environ un tiers à un quart, et non un dixième.",
        "<strong class='text-white'>Comparez l'aller-retour tout compris, pas la commission.</strong> Le chiffre qui compte est commission plus bourse plus NFA plus compensation, compté pour l'entrée et la sortie.",
        "<strong class='text-white'>Le frais NFA est fixe.</strong> Ce sont les mêmes quelques centimes que vous tradiez un ES ou un MES, ce qui explique en grande partie pourquoi les micros coûtent proportionnellement plus.",
        "<strong class='text-white'>Dix micros coûtent plus qu'un mini.</strong> Même exposition, mais vous payez le frais par contrat dix fois, ce qui aboutit à près de 3x le frais du mini unique.",
        "<strong class='text-white'>Les micros méritent encore leur prime pour les petits comptes.</strong> Un dimensionnement plus fin et un contrôle du risque plus serré valent souvent un peu plus par unité.",
        "<strong class='text-white'>Votre formule ne modifie que la commission.</strong> Les frais de bourse et de la NFA sont fixés en dehors du courtier et ne bougent pas lorsque vous changez de niveau.",
      ],
    },
    { type: "heading",text: "Comment se décompose réellement le tarif tout compris de Tradovate" },
    { type: "paragraph",html: "Le chiffre mis en avant par les courtiers est la commission. Ce n'est qu'une part de ce qui quitte votre compte à chaque trade. Le coût réel, le <strong class='text-white'>tarif all-in</strong>, se compose de quatre éléments :" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Commission</strong> &ndash; ce que facture Tradovate, et la seule part que modifie votre formule d'abonnement.",
        "<strong class='text-white'>Frais de bourse</strong> &ndash; fixés par le CME pour le contrat concerné. Ils sont identiques chez tous les courtiers mais diffèrent selon le produit et selon que vous détenez ou non une adhésion à la bourse.",
        "<strong class='text-white'>Frais réglementaire NFA</strong> &ndash; un petit montant fixe par côté de la National Futures Association, identique pour un gros contrat comme pour un minuscule.",
        "<strong class='text-white'>Frais de compensation</strong> &ndash; facturés par la chambre de compensation. Ils peuvent varier selon le courtier mais, en général, pas selon le contrat.",
      ],
    },
    { type: "paragraph",html: "Un <strong class='text-white'>aller-retour</strong> (round-turn) compte les deux côtés du trade, car vous payez chacun de ces frais à l'entrée puis à nouveau à la sortie. Lorsque vous entendez &ldquo;le tarif all-in aller-retour sur le MNQ est d'environ un dollar et demi&rdquo;, c'est le coût complet d'entrée et de sortie d'un contrat micro, commission et frais compris." },
    { type: "paragraph",html: "Voici comment se comportent les quatre éléments lorsque vous passez d'un contrat standard à son micro. Remarquez qu'aucun ne baisse d'un facteur 10 :" },
    { type: "table", headers: ["Composante du frais","Qui la fixe","Standard (NQ / ES) par côté","Micro (MNQ / MES) par côté","Baisse de 10x ?"], rows: [
      ["Commission","Tradovate (plan)","~$0.59 à $1.29","~$0.09 à $0.39","Non (environ 3x)"],
      ["Frais de bourse","CME","~$1.15 à $1.40","~$0.25 à $0.35","Non (environ 4x)"],
      ["Réglementaire NFA","NFA","~$0.01 à $0.02","~$0.01 à $0.02","Non (identique)"],
      ["Compensation","Chambre de compensation","Variable","Variable","Non"],
    ] },
    { type: "paragraph",html: "L'écart de commission reflète les niveaux de plan de Tradovate. Sur le plan Free (paiement à l'usage), vous payez environ $1.29 par côté sur un contrat standard et $0.39 sur un micro. Sur Monthly, c'est environ $0.99 contre $0.29, et sur Lifetime environ $0.59 contre $0.09. Même la commission seule, avant frais, ne représente qu'un écart d'environ 3x entre mini et micro, et non de 10x." },
    { type: "heading",text: "Pourquoi un mini ne coûte pas 10x un micro" },
    { type: "paragraph",html: "Le calcul n'est surprenant que tant que l'on ne voit pas les éléments fixes. Le frais de bourse diminue sur un micro, mais loin de dix fois. Le frais de compensation est globalement le même montant quel que soit le contrat. Le frais NFA est identique sur les deux. Ajoutez une commission inférieure d'environ un tiers seulement, et le total ne peut pas s'effondrer au dixième." },
    { type: "paragraph",html: "Prenons des chiffres concrets avec la paire Nasdaq. Un NQ vaut $20 le point ; un MNQ vaut $2 le point, exactement un dixième. Pourtant, un aller-retour tout compris typique se situe autour de <strong class='text-white'>$4.36 sur le NQ et environ $1.32 sur le MNQ</strong>. Le rapport d'exposition est de 10 pour 1. Le rapport des frais est plus proche de 3.3 pour 1." },
    { type: "table", headers: ["","NQ (mini)","MNQ (micro)","Mini vs micro"], rows: [
      ["Valeur du point","$20 / point","$2 / point","10x"],
      ["Exemple de frais all-in aller-retour","~$4.36","~$1.32","~3.3x"],
      ["Frais en part d'un point","~22%","~66%","Le micro coûte 3x plus"],
    ] },
    { type: "paragraph",html: "Lisez lentement cette dernière ligne, car c'est tout l'enjeu. Sur le mini, le frais aller-retour absorbe environ un cinquième d'un seul point. Sur le micro, il en absorbe environ deux tiers. Un scalp qui capte un point en conserve bien plus sur un mini. Les micros ne sont pas &ldquo;mauvais&rdquo;, mais par unité d'exposition ils supportent une charge de frais plus lourde, et une stratégie fondée sur de petits objectifs en points la ressent à chaque trade." },
    { type: "heading",text: "Le piège : empiler dix micros pour imiter un mini" },
    { type: "paragraph",html: "C'est là que l'idée reçue coûte de l'argent réel. Supposons que vous vouliez une exposition de la taille d'un NQ mais que vous preniez dix contrats MNQ au lieu d'un NQ. Même marché, même pari, mais vous payez désormais le frais par contrat du micro dix fois. Dix aller-retour MNQ à environ $1.32 chacun représentent environ <strong class='text-white'>$13.20</strong>, contre environ <strong class='text-white'>$4.36</strong> pour le NQ unique. Exposition identique, environ trois fois plus de frais. Il en va de même côté S&amp;P, où dix aller-retour MES dépassent largement un ES." },
    { type: "paragraph",html: "La règle empirique qui en découle : dès que vous tradez systématiquement un micro par blocs de dix, le mini correspondant est l'instrument le moins cher pour cette taille. Les micros servent lorsque vous voulez réellement une exposition fractionnelle, pas à simuler un mini un dixième à la fois." },
    { type: "heading",text: "Quand payer la prime du micro reste judicieux" },
    { type: "paragraph",html: "Rien de tout cela ne signifie que les micros sont une arnaque. Pour un compte petit ou récemment financé, dimensionner à $2 le point plutôt que $20 vaut de l'argent réel en drawdown évité. Entrer et sortir par petites touches, conserver un runner sans miser le compte, tester une stratégie en réel à risque minimal : c'est à cela que servent les micros. La prime achète du contrôle. Simplement, ne prenez pas dix micros quand un mini fait le même travail pour moins cher." },
    { type: "heading",text: "Comment vérifier vos propres frais par contrat" },
    { type: "paragraph",html: "Les tarifs affichés sont un point de départ, pas le reçu. Le seul frais qui compte est celui qui est réellement débité sur votre compte, et Tradovate vous le détaille." },
    { type: "heading",text: "Étape 1 : Générer un rapport des ordres exécutés ou des frais" },
    {
      type: "steps",
      items: [
        { title: "Connectez-vous à Tradovate", html: "Connectez-vous à Tradovate sur le web ou sur le bureau." },
        { title: "Ouvrez la section des rapports", html: "Ouvrez la section des rapports ou relevés de compte (cherchez dans un menu Account, Reports ou Statements)." },
        { title: "Générez un rapport des ordres exécutés ou des frais", html: "Choisissez un rapport des ordres exécutés, des fills ou des frais et définissez la période sur un intervalle où vous avez réellement tradé." },
        { title: "Repérez les colonnes de commission et de frais", html: "Repérez les colonnes de commission et de frais associées à chaque exécution. Ce chiffre par contrat est votre coût réel." },
      ],
    },
    { type: "heading",text: "Étape 2 : Lire séparément commission et frais" },
    { type: "paragraph",html: "Les relevés séparent généralement la commission du courtier des frais de bourse, NFA et de compensation. Additionnez-les pour obtenir le chiffre all-in honnête, et pensez à le doubler pour un aller-retour si le rapport n'affiche qu'un côté. Si votre export ne liste qu'un chiffre brut sans le détail des frais, c'est une limitation connue de certains exports Tradovate ; rapprochez-le donc du relevé qui détaille les frais." },
    { type: "heading",text: "Étape 3 : Confirmer le niveau de commission de votre plan" },
    {
      type: "steps",
      items: [
        { title: "Ouvrez les paramètres de votre plan", html: "Ouvrez les paramètres de votre abonnement ou de votre plan dans Tradovate." },
        { title: "Vérifiez quel niveau est actif", html: "Vérifiez quel niveau est actif (Free, Monthly ou Lifetime) et la commission par côté qu'il applique aux micros et aux contrats standards." },
        { title: "Comparez-le à votre volume de trading", html: "Comparez cela à votre volume de trading réel. Si vous tradez assez de volume, la commission plus basse d'un niveau payant peut largement couvrir son coût fixe, et elle abaisse aussi le seuil de décision entre mini et micro." },
      ],
    },
    { type: "heading",text: "Tableau de décision Mini vs Micro" },
    { type: "table", headers: ["Situation","Ce qui se passe réellement","Choix le moins cher"], rows: [
      ["Vous pensiez que les minis coûtent 10x plus que les micros","Le frais évolue d'environ 3 à 4x, pas 10x, car les frais fixes ne diminuent pas","Budgétez avec le véritable aller-retour tout compris, pas avec une estimation de 10x"],
      ["Vous tradez des micros par blocs de dix","Vous payez dix fois le frais du micro pour l'exposition d'un seul mini","Trader le mini unique correspondant"],
      ["Petit compte, risque serré","Un dimensionnement fin vaut le frais plus élevé par unité","Rester sur les micros, dimensionner délibérément"],
      ["Scalping de petits objectifs en points sur micros","Les frais absorbent une grande part de chaque point","Élargir les objectifs ou passer au mini dès que la taille le permet"],
      ["Comparer des courtiers sur le prix","Les frais de bourse et NFA sont fixes ; seule la commission diffère","Comparer commission et compensation, ignorer les parts fixes"],
      ["Compte d'évaluation d'une prop firm","Les tarifs sont forfaitaires, fixés par la firme, et non les tarifs retail standard","Consulter la grille actuelle par contrat de la firme"],
    ] },
    { type: "heading",text: "Gardez vos règles de dimensionnement cohérentes avec PickMyTrade" },
    { type: "paragraph",html: "Une fois que vous connaissez le vrai calcul des frais, la tâche suivante consiste à l'appliquer de la même manière à chaque trade plutôt que de remettre en question la taille en plein mouvement. PickMyTrade relie vos alertes TradingView directement à votre compte Tradovate, de sorte que les décisions de contrat et de quantité reposent sur des règles que vous fixez à l'avance :" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Logique de contrat fixe</strong> &ndash; définissez si une alerte déclenche un mini ou un nombre fixe de micros, pour ne jamais saisir par erreur dix micros alors que vous vouliez un mini.",
        "<strong class='text-white'>Exécution automatique</strong> &ndash; les entrées et sorties se déclenchent automatiquement depuis votre stratégie, dimensionnées comme votre plan le prévoyait.",
        "<strong class='text-white'>Synchronisation multi-comptes</strong> &ndash; reproduisez le même dimensionnement sur plusieurs comptes Tradovate à la fois.",
        "<strong class='text-white'>Historique de trades propre</strong> &ndash; chaque exécution automatisée est consignée, ce qui simplifie le rapprochement des commissions et frais avec vos relevés.",
      ],
    },
    { type: "paragraph",html: "L'automatisation ne changera pas ce que facture le CME, mais elle empêche vos règles de dimensionnement attentives aux frais de dériver lorsque le marché s'emballe." },
  ], it: [
    { type: "paragraph",html: "Ecco un errore che costa silenziosamente denaro ai trader: ritenere che un contratto mini costi dieci volte più della sua versione micro da negoziare. È un salto facile. Un MNQ è un decimo di un NQ, un MES è un decimo di un ES, quindi le commissioni devono scalare allo stesso modo, giusto? Non è così. Un mini controlla 10x il valore del punto del suo micro, ma la commissione complessiva che paga effettivamente è solo circa <strong class='text-white'>3-4 volte più alta</strong>, non 10x. Questa differenza cambia il modo in cui dovrebbe ragionare sulla dimensione del contratto, ed è la differenza tra un piano di scalping con micro che brucia commissioni e uno che non lo fa. Vediamo dove va ogni centesimo e come verificare il suo." },
    { type: "quote",html: "Gli importi esatti delle commissioni cambiano e variano in base al contratto, al piano di abbonamento e al tipo di conto. Le cifre seguenti sono state verificate rispetto alle commissioni e ai prezzi dei piani pubblicati da Tradovate e ai tariffari CME e NFA, ma tutte possono essere riviste. I conti delle prop firm usano spesso tariffe forfettarie proprie. Confermi sempre i numeri attuali nel suo tariffario prima di dimensionare i trade." },
    {
      type: "checklist",
      heading: "Riferimento rapido: commissioni mini vs micro",
      items: [
        "<strong class='text-white'>L'assunzione del 10x è sbagliata.</strong> Un micro è un decimo del suo mini, ma la sua commissione è circa un terzo o un quarto, non un decimo.",
        "<strong class='text-white'>Confronti il round turn all-in, non la commissione.</strong> Il numero che conta è commissione più borsa più NFA più clearing, contato per ingresso e uscita.",
        "<strong class='text-white'>La tariffa NFA è fissa.</strong> Sono gli stessi pochi centesimi che negozi un ES o un MES, ed è un motivo importante per cui i micro costano proporzionalmente di più.",
        "<strong class='text-white'>Dieci micro costano più di un mini.</strong> Stessa esposizione, ma paga la commissione per contratto dieci volte, il che porta a circa 3x la commissione del singolo mini.",
        "<strong class='text-white'>I micro si meritano comunque il loro premio sui conti piccoli.</strong> Un dimensionamento più fine e un controllo del rischio più stretto spesso valgono un po' di più per unità.",
        "<strong class='text-white'>Il suo piano sposta solo la commissione.</strong> Le tariffe di borsa e NFA sono stabilite al di fuori del broker e non cambiano quando cambia livello.",
      ],
    },
    { type: "heading",text: "Come si scompone davvero la tariffa all-in di Tradovate" },
    { type: "paragraph",html: "Il numero in evidenza che i broker pubblicizzano è la commissione. È solo una parte di ciò che esce dal suo conto a ogni trade. Il costo reale, la <strong class='text-white'>tariffa all-in</strong>, è composto da quattro parti:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Commissione</strong> &ndash; ciò che addebita Tradovate, e l'unica parte che il suo piano di abbonamento modifica.",
        "<strong class='text-white'>Tariffa di borsa</strong> &ndash; stabilita dal CME per lo specifico contratto. È la stessa presso ogni broker ma differisce in base al prodotto e al fatto che lei detenga o meno l'adesione alla borsa.",
        "<strong class='text-white'>Tariffa regolamentare NFA</strong> &ndash; un piccolo addebito fisso per lato della National Futures Association, identico per un contratto enorme o minuscolo.",
        "<strong class='text-white'>Tariffa di clearing</strong> &ndash; addebitata dalla società di clearing. Può variare in base al broker ma in genere non varia in base al contratto.",
      ],
    },
    { type: "paragraph",html: "Un <strong class='text-white'>round turn</strong> conta entrambi i lati del trade, perché paga ciascuna di queste tariffe in ingresso e di nuovo in uscita. Quando sente dire &ldquo;il round turn all-in su MNQ è circa un dollaro e mezzo&rdquo;, è il costo completo di entrata e uscita di un contratto micro, commissione e tariffe incluse." },
    { type: "paragraph",html: "Ecco come si comportano le quattro parti quando si passa da un contratto standard al suo micro. Noti che nessuna di esse scende di un fattore 10:" },
    { type: "table", headers: ["Componente della tariffa","Chi la stabilisce","Standard (NQ / ES) per lato","Micro (MNQ / MES) per lato","Scende di 10x?"], rows: [
      ["Commissione","Tradovate (piano)","~$0.59 a $1.29","~$0.09 a $0.39","No (circa 3x)"],
      ["Tariffa di borsa","CME","~$1.15 a $1.40","~$0.25 a $0.35","No (circa 4x)"],
      ["Regolamentare NFA","NFA","~$0.01 a $0.02","~$0.01 a $0.02","No (identica)"],
      ["Clearing","Società di clearing","Varia","Varia","No"],
    ] },
    { type: "paragraph",html: "La forbice delle commissioni riflette i livelli dei piani di Tradovate. Sul piano Free (pay-as-you-go) paga circa $1.29 per lato su un contratto standard e $0.39 su un micro. Su Monthly sono circa $0.99 contro $0.29, e su Lifetime circa $0.59 contro $0.09. Anche la sola commissione, prima delle tariffe, è solo circa 3x di differenza tra mini e micro, non 10x." },
    { type: "heading",text: "Perché un mini non costa 10x un micro" },
    { type: "paragraph",html: "Il calcolo sorprende solo finché non si vedono le componenti fisse. La tariffa di borsa diminuisce su un micro, ma non certo di dieci volte. La tariffa di clearing è sostanzialmente la stessa cifra indipendentemente dal contratto. La tariffa NFA è identica su entrambi. Aggiunga una commissione inferiore solo di circa un terzo, e il totale non può crollare a un decimo." },
    { type: "paragraph",html: "Con numeri concreti sulla coppia Nasdaq: un NQ vale $20 a punto; un MNQ vale $2 a punto, esattamente un decimo. Eppure un tipico round turn all-in si aggira intorno a <strong class='text-white'>$4.36 sull'NQ e circa $1.32 sull'MNQ</strong>. Il rapporto di esposizione è 10 a 1. Il rapporto delle commissioni è più vicino a 3.3 a 1." },
    { type: "table", headers: ["","NQ (mini)","MNQ (micro)","Mini vs micro"], rows: [
      ["Valore del punto","$20 / punto","$2 / punto","10x"],
      ["Esempio di commissione all-in per round turn","~$4.36","~$1.32","~3.3x"],
      ["Commissione come quota di un punto","~22%","~66%","Il micro costa 3x di più"],
    ] },
    { type: "paragraph",html: "Legga lentamente quell'ultima riga, perché è tutto il punto. Sul mini, la commissione del round turn si mangia circa un quinto di un singolo punto. Sul micro, si mangia circa due terzi di un punto. Uno scalp che prende un punto ne conserva molto di più su un mini. I micro non sono &ldquo;cattivi&rdquo;, ma per unità di esposizione portano un carico di commissioni più pesante, e una strategia basata su piccoli obiettivi in punti lo sente a ogni trade." },
    { type: "heading",text: "La trappola: impilare dieci micro per simulare un mini" },
    { type: "paragraph",html: "È qui che il malinteso costa denaro reale. Supponiamo che voglia un'esposizione pari a un NQ ma scelga dieci contratti MNQ invece di un NQ. Stesso mercato, stessa scommessa, ma ora paga la commissione per contratto del micro dieci volte. Dieci round turn MNQ a circa $1.32 ciascuno fanno circa <strong class='text-white'>$13.20</strong>, contro circa <strong class='text-white'>$4.36</strong> per il singolo NQ. Esposizione identica, circa tre volte le commissioni. Lo stesso vale sul fronte S&amp;P, dove dieci round turn MES superano di molto un ES." },
    { type: "paragraph",html: "La regola pratica che ne deriva: una volta che negozia costantemente un micro a blocchi di dieci, il mini corrispondente è lo strumento più economico per quella dimensione. I micro servono quando vuole davvero un'esposizione frazionaria, non per simulare un mini un decimo alla volta." },
    { type: "heading",text: "Quando pagare il premio del micro è comunque intelligente" },
    { type: "paragraph",html: "Nulla di tutto ciò significa che i micro siano una truffa. Per un conto piccolo o appena finanziato, dimensionare a $2 a punto invece di $20 vale denaro reale in drawdown evitato. Entrare e uscire a piccoli incrementi, mantenere un runner senza scommettere il conto, testare una strategia live a rischio minimo: è a questo che servono i micro. Il premio compra controllo. Semplicemente non ricorra a dieci micro quando un mini fa lo stesso lavoro a un costo inferiore." },
    { type: "heading",text: "Come verificare le sue commissioni per contratto" },
    { type: "paragraph",html: "Le tariffe pubblicizzate sono un punto di partenza, non la ricevuta. L'unica commissione che conta è quella che viene effettivamente addebitata sul suo conto, e Tradovate gliela dettaglia." },
    { type: "heading",text: "Passo 1: Estragga un report degli ordini eseguiti o delle commissioni" },
    {
      type: "steps",
      items: [
        { title: "Acceda a Tradovate", html: "Acceda a Tradovate dal web o dal desktop." },
        { title: "Apra l'area dei report", html: "Apra l'area dei report o degli estratti conto (cerchi in un menu Account, Reports o Statements)." },
        { title: "Estragga un report degli ordini eseguiti o delle commissioni", html: "Scelga un report di ordini eseguiti, fill o commissioni e imposti l'intervallo di date su un periodo in cui ha effettivamente negoziato." },
        { title: "Trovi le colonne di commissione e tariffe", html: "Trovi le colonne di commissione e tariffe legate a ciascuna esecuzione. Quella cifra per contratto è il suo vero costo." },
      ],
    },
    { type: "heading",text: "Passo 2: Legga separatamente commissione e tariffe" },
    { type: "paragraph",html: "Gli estratti conto di solito separano la commissione del broker dalle tariffe di borsa, NFA e clearing. Le sommi per ottenere il numero all-in onesto, e ricordi di raddoppiare per un round turn se il report mostra un solo lato. Se la sua esportazione elenca solo una cifra lorda senza il dettaglio delle tariffe, è una limitazione nota di alcune esportazioni Tradovate, quindi riconcili con l'estratto conto che dettaglia le tariffe." },
    { type: "heading",text: "Passo 3: Confermi il livello di commissione del suo piano" },
    {
      type: "steps",
      items: [
        { title: "Apra le impostazioni del suo piano", html: "Apra le impostazioni dell'abbonamento o del piano in Tradovate." },
        { title: "Verifichi quale livello è attivo", html: "Verifichi quale livello è attivo (Free, Monthly o Lifetime) e la commissione per lato che applica a micro e contratti standard." },
        { title: "Lo confronti con il suo volume di trading", html: "Lo confronti con il suo reale volume di trading. Se negozia abbastanza size, la commissione più bassa di un livello a pagamento può più che coprirne il costo fisso, e abbassa anche la soglia decisionale tra mini e micro." },
      ],
    },
    { type: "heading",text: "Tabella decisionale Mini vs Micro" },
    { type: "table", headers: ["Situazione","Che cosa succede davvero","Scelta più economica"], rows: [
      ["Pensava che i mini costassero 10x più dei micro","La commissione scala di ~3-4x, non 10x, perché le tariffe fisse non si riducono","Faccia il budget con il vero round turn all-in, non con una stima di 10x"],
      ["Negozia micro a blocchi di dieci","Paga dieci volte la commissione del micro per l'esposizione di un mini","Negozi il singolo mini corrispondente"],
      ["Conto piccolo, rischio stretto","Il dimensionamento fine vale la commissione più alta per unità","Resti sui micro, dimensioni con criterio"],
      ["Scalping di piccoli obiettivi in punti sui micro","Le commissioni si mangiano una larga quota di ogni punto","Allarghi gli obiettivi o passi al mini quando la dimensione lo consente"],
      ["Confronto dei broker sul prezzo","Le tariffe di borsa e NFA sono fisse; differisce solo la commissione","Confronti commissione e clearing, ignori le parti fisse"],
      ["Conto di valutazione di una prop firm","Le tariffe sono forfettarie, stabilite dalla società, non retail standard","Verifichi il tariffario attuale per contratto della società"],
    ] },
    { type: "heading",text: "Mantenga coerenti le sue regole di dimensionamento con PickMyTrade" },
    { type: "paragraph",html: "Una volta compresa la vera matematica delle commissioni, il compito successivo è applicarla allo stesso modo a ogni trade invece di rimettere in discussione la dimensione nel pieno del movimento. PickMyTrade collega i suoi alert di TradingView direttamente al suo conto Tradovate, così le decisioni su contratto e quantità girano su regole che imposta in anticipo:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Logica di contratto fissa</strong> &ndash; definisca se un alert esegue un mini o un numero fisso di micro, così non digiterà mai per errore dieci micro quando intendeva un mini.",
        "<strong class='text-white'>Esecuzione senza intervento</strong> &ndash; ingressi e uscite partono automaticamente dalla sua strategia, dimensionati come previsto dal suo piano.",
        "<strong class='text-white'>Sincronizzazione multi-conto</strong> &ndash; replichi lo stesso dimensionamento su più conti Tradovate contemporaneamente.",
        "<strong class='text-white'>Registri dei trade puliti</strong> &ndash; ogni esecuzione automatizzata viene registrata, quindi riconciliare commissioni e tariffe con i suoi estratti conto è semplice.",
      ],
    },
    { type: "paragraph",html: "L'automazione non cambierà ciò che addebita il CME, ma impedisce che le sue regole di dimensionamento attente alle commissioni cedano quando il mercato si muove velocemente." },
  ] },
  ctaHeading: { en: "Size Every Contract by Your Own Rules", de: "Dimensionieren Sie jeden Kontrakt nach Ihren eigenen Regeln", es: "Dimensione cada contrato con sus propias reglas", fr: "Dimensionnez chaque contrat selon vos propres règles", it: "Dimensioni ogni contratto con le sue regole" },
  ctaText: { en: "PickMyTrade lets you define whether an alert fires a mini or a set number of micros, so your fee-aware sizing never slips when the market moves fast.", de: "Mit PickMyTrade legen Sie fest, ob ein Alert einen Mini oder eine feste Anzahl Micros auslöst, damit Ihre gebührenbewusste Positionsgröße auch bei schnellem Markt nicht ins Rutschen gerät.", es: "PickMyTrade le permite definir si una alerta ejecuta un mini o un número fijo de micros, de modo que su dimensionamiento consciente de comisiones no se desvíe cuando el mercado se mueve rápido.", fr: "PickMyTrade vous permet de définir si une alerte déclenche un mini ou un nombre fixe de micros, afin que votre dimensionnement attentif aux frais ne dérape jamais lorsque le marché s'accélère.", it: "PickMyTrade le permette di definire se un alert esegue un mini o un numero fisso di micro, così il suo dimensionamento attento alle commissioni non cede quando il mercato si muove velocemente." },
  ctaButtonText: { en: "Start Your Free 7-Day Trial", de: "Starten Sie Ihre kostenlose 7-Tage-Testphase", es: "Comience su prueba gratuita de 7 días", fr: "Commencez votre essai gratuit de 7 jours", it: "Inizi la prova gratuita di 7 giorni" },
  ctaUrl: "https://app.pickmytrade.trade/?register=true&utm_source=content&utm_medium=debugging",
  faqHeading: { en: "Frequently Asked Questions", de: "Häufig gestellte Fragen", es: "Preguntas frecuentes", fr: "Questions fréquentes", it: "Domande frequenti" },
  faqs: { en: [
    { q: "Do minis really cost 10 times more than micros in fees?", a: "No. A mini controls 10 times the point value of its matching micro, but its all-in round-turn fee is usually only about 3 to 4 times higher. Commission, exchange, and clearing fees don't scale down by a factor of 10, and the NFA regulatory fee is flat regardless of contract size." },
    { q: "Why are micro contracts more expensive per unit of exposure?", a: "Because the fee shrinks slower than the contract does. A micro is one-tenth the size of its mini, but the commission is only about a third as low and the exchange fee only about a quarter as low. The flat NFA fee is identical on both. So per dollar of price movement, a micro costs you more in fees than a mini." },
    { q: "What is an all-in rate on Tradovate?", a: "The all-in rate is the total you actually pay to trade one contract, combining the broker commission, the CME exchange fee, the NFA regulatory fee, and the clearing fee. A round-turn all-in rate counts both sides, entry and exit, since you pay each fee going in and coming out." },
    { q: "Is it cheaper to trade one NQ or ten MNQ?", a: "One NQ. Ten MNQ contracts give you the same market exposure as one NQ, but you pay the per-contract fee ten times over on the micros. In practice that stacks up to roughly three times the fees of the single mini for identical size, so if you consistently trade micros in tens, the matching mini is the cheaper instrument." },
    { q: "Do exchange and NFA fees differ between brokers?", a: "The CME exchange fee and the NFA regulatory fee are set by the exchange and the regulator, so they don't change from one broker to the next, though they do vary by contract and by membership status. The commission and the clearing fee are set by the broker or clearing firm and can differ. When comparing platforms, compare the commission, since the exchange and NFA portions are largely fixed." },
    { q: "How do I see the exact fee on each of my trades?", a: "Open the account reports or statements area in Tradovate and pull a filled-orders or fees report for the period. It itemizes commission and fees per contract, which is the real number to budget with, rather than a headline commission rate that leaves out exchange, NFA, and clearing charges." },
    { q: "Does my membership plan change these fees?", a: "Your plan changes the commission portion only. Moving from the Free plan to Monthly or Lifetime lowers the per-side commission on both minis and micros, but it doesn't touch the exchange or NFA fees, which are set outside the broker. Confirm the current commission for your tier in your own fee schedule." },
  ], de: [
    { q: "Kosten Minis in den Gebühren wirklich 10-mal mehr als Micros?", a: "Nein. Ein Mini kontrolliert den 10-fachen Punktwert seines entsprechenden Micros, doch seine All-in-Round-Turn-Gebühr ist in der Regel nur etwa 3- bis 4-mal höher. Provision, Börsen- und Clearing-Gebühren skalieren nicht um den Faktor 10 nach unten, und die regulatorische NFA-Gebühr ist unabhängig von der Kontraktgröße pauschal." },
    { q: "Warum sind Micro-Kontrakte pro Einheit Exposure teurer?", a: "Weil die Gebühr langsamer schrumpft als der Kontrakt. Ein Micro ist ein Zehntel so groß wie sein Mini, aber die Provision ist nur etwa um ein Drittel niedriger und die Börsengebühr nur etwa um ein Viertel. Die pauschale NFA-Gebühr ist bei beiden identisch. Pro Dollar Kursbewegung kosten Sie ein Micro also mehr Gebühren als ein Mini." },
    { q: "Was ist ein All-in-Satz bei Tradovate?", a: "Der All-in-Satz ist der Gesamtbetrag, den Sie tatsächlich für den Handel eines Kontrakts zahlen, bestehend aus der Broker-Provision, der CME-Börsengebühr, der regulatorischen NFA-Gebühr und der Clearing-Gebühr. Ein All-in-Round-Turn-Satz zählt beide Seiten, Einstieg und Ausstieg, da Sie jede Gebühr beim Einstieg und beim Ausstieg zahlen." },
    { q: "Ist es günstiger, einen NQ oder zehn MNQ zu handeln?", a: "Einen NQ. Zehn MNQ-Kontrakte geben Ihnen dasselbe Marktexposure wie ein NQ, aber Sie zahlen die Gebühr pro Kontrakt zehnmal auf die Micros. In der Praxis summiert sich das auf etwa das Dreifache der Gebühren des einzelnen Minis bei identischer Größe. Wenn Sie also regelmäßig Micros in Zehnerpaketen handeln, ist der passende Mini das günstigere Instrument." },
    { q: "Unterscheiden sich Börsen- und NFA-Gebühren zwischen Brokern?", a: "Die CME-Börsengebühr und die regulatorische NFA-Gebühr werden von der Börse und der Aufsichtsbehörde festgelegt und ändern sich daher nicht von Broker zu Broker, variieren aber je nach Kontrakt und Mitgliedsstatus. Provision und Clearing-Gebühr werden vom Broker oder Clearing-Haus festgelegt und können abweichen. Vergleichen Sie beim Plattformvergleich die Provision, da die Börsen- und NFA-Anteile weitgehend feststehen." },
    { q: "Wie sehe ich die genaue Gebühr bei jedem meiner Trades?", a: "Öffnen Sie in Tradovate den Bereich für Konto-Berichte oder Kontoauszüge und rufen Sie einen Bericht über ausgeführte Orders oder Gebühren für den Zeitraum ab. Er schlüsselt Provision und Gebühren pro Kontrakt auf. Das ist die reale Zahl, mit der Sie kalkulieren sollten, und nicht ein Provisionssatz aus der Werbung, der Börsen-, NFA- und Clearing-Gebühren auslässt." },
    { q: "Ändert mein Mitgliedschaftstarif diese Gebühren?", a: "Ihr Tarif ändert nur den Provisionsanteil. Der Wechsel vom Free-Tarif zu Monthly oder Lifetime senkt die Provision pro Seite sowohl bei Minis als auch bei Micros, berührt aber nicht die Börsen- oder NFA-Gebühren, die außerhalb des Brokers festgelegt werden. Prüfen Sie die aktuelle Provision für Ihre Stufe in Ihrem eigenen Gebührenverzeichnis." },
  ], es: [
    { q: "¿Los minis cuestan realmente 10 veces más que los micros en comisiones?", a: "No. Un mini controla 10 veces el valor por punto de su micro equivalente, pero su comisión total por operación completa suele ser solo unas 3 o 4 veces mayor. La comisión del bróker, las tarifas de bolsa y de compensación no se reducen en un factor de 10, y la tarifa regulatoria de la NFA es fija independientemente del tamaño del contrato." },
    { q: "¿Por qué los contratos micro son más caros por unidad de exposición?", a: "Porque la comisión se reduce más despacio que el contrato. Un micro es una décima parte de su mini, pero la comisión es solo un tercio más baja y la tarifa de bolsa solo un cuarto más baja. La tarifa fija de la NFA es idéntica en ambos. Así que, por cada dólar de movimiento del precio, un micro le cuesta más en comisiones que un mini." },
    { q: "¿Qué es una tarifa all-in en Tradovate?", a: "La tarifa all-in es el total que realmente paga por operar un contrato, que combina la comisión del bróker, la tarifa de bolsa de CME, la tarifa regulatoria de la NFA y la tarifa de compensación. Una tarifa all-in por operación completa cuenta ambos lados, entrada y salida, ya que paga cada comisión al entrar y al salir." },
    { q: "¿Es más barato operar un NQ o diez MNQ?", a: "Un NQ. Diez contratos MNQ le dan la misma exposición al mercado que un NQ, pero paga la comisión por contrato diez veces en los micros. En la práctica eso suma aproximadamente tres veces las comisiones del mini individual para un tamaño idéntico, así que si opera micros de forma constante en bloques de diez, el mini equivalente es el instrumento más barato." },
    { q: "¿Difieren las tarifas de bolsa y de la NFA entre brókeres?", a: "La tarifa de bolsa de CME y la tarifa regulatoria de la NFA las fijan la bolsa y el regulador, por lo que no cambian de un bróker a otro, aunque sí varían según el contrato y la condición de miembro. La comisión y la tarifa de compensación las fija el bróker o la cámara de compensación y pueden diferir. Al comparar plataformas, compare la comisión, ya que las partes de bolsa y NFA son en gran medida fijas." },
    { q: "¿Cómo veo la comisión exacta de cada una de mis operaciones?", a: "Abra el área de informes o extractos de la cuenta en Tradovate y obtenga un informe de órdenes ejecutadas o de comisiones para el periodo. Desglosa la comisión y las tarifas por contrato, que es la cifra real con la que debe presupuestar, en lugar de una comisión publicitaria que omite las tarifas de bolsa, NFA y compensación." },
    { q: "¿Mi plan de membresía cambia estas comisiones?", a: "Su plan cambia solo la parte de la comisión. Pasar del plan Free a Monthly o Lifetime reduce la comisión por lado tanto en minis como en micros, pero no afecta a las tarifas de bolsa ni de la NFA, que se fijan fuera del bróker. Confirme la comisión vigente de su nivel en su propia tabla de comisiones." },
  ], fr: [
    { q: "Les minis coûtent-ils vraiment 10 fois plus que les micros en frais ?", a: "Non. Un mini contrôle 10 fois la valeur du point de son micro équivalent, mais son frais tout compris par aller-retour n'est généralement qu'environ 3 à 4 fois plus élevé. Les frais de commission, de bourse et de compensation ne sont pas divisés par 10, et le frais réglementaire NFA est fixe quelle que soit la taille du contrat." },
    { q: "Pourquoi les contrats micro sont-ils plus chers par unité d'exposition ?", a: "Parce que le frais diminue plus lentement que le contrat. Un micro est dix fois plus petit que son mini, mais la commission n'est inférieure que d'environ un tiers et le frais de bourse d'environ un quart. Le frais NFA fixe est identique sur les deux. Ainsi, par dollar de mouvement de prix, un micro vous coûte davantage en frais qu'un mini." },
    { q: "Qu'est-ce qu'un tarif tout compris (all-in) chez Tradovate ?", a: "Le tarif all-in est le total que vous payez réellement pour trader un contrat, combinant la commission du courtier, le frais de bourse CME, le frais réglementaire NFA et le frais de compensation. Un tarif all-in aller-retour compte les deux côtés, entrée et sortie, puisque vous payez chaque frais à l'aller comme au retour." },
    { q: "Est-il moins cher de trader un NQ ou dix MNQ ?", a: "Un NQ. Dix contrats MNQ vous donnent la même exposition de marché qu'un NQ, mais vous payez le frais par contrat dix fois sur les micros. En pratique, cela représente environ trois fois les frais du mini unique pour une taille identique ; si vous tradez systématiquement des micros par dix, le mini correspondant est donc l'instrument le moins cher." },
    { q: "Les frais de bourse et de la NFA diffèrent-ils d'un courtier à l'autre ?", a: "Le frais de bourse CME et le frais réglementaire NFA sont fixés par la bourse et le régulateur ; ils ne changent donc pas d'un courtier à l'autre, bien qu'ils varient selon le contrat et le statut de membre. La commission et le frais de compensation sont fixés par le courtier ou la chambre de compensation et peuvent différer. Lorsque vous comparez des plateformes, comparez la commission, car les parts bourse et NFA sont largement fixes." },
    { q: "Comment voir les frais exacts de chacun de mes trades ?", a: "Ouvrez la section des rapports ou relevés de compte dans Tradovate et générez un rapport des ordres exécutés ou des frais pour la période. Il détaille la commission et les frais par contrat, ce qui est le chiffre réel avec lequel budgéter, plutôt qu'un taux de commission affiché qui omet les frais de bourse, NFA et de compensation." },
    { q: "Mon formule d'abonnement modifie-t-elle ces frais ?", a: "Votre formule ne modifie que la part de commission. Passer du plan Free à Monthly ou Lifetime réduit la commission par côté sur les minis comme sur les micros, mais n'affecte pas les frais de bourse ou de la NFA, fixés en dehors du courtier. Confirmez la commission en vigueur pour votre niveau dans votre propre grille tarifaire." },
  ], it: [
    { q: "I mini costano davvero 10 volte più dei micro in commissioni?", a: "No. Un mini controlla 10 volte il valore del punto del micro corrispondente, ma la sua commissione complessiva per round turn è di solito solo circa 3 o 4 volte più alta. Commissione, costi di borsa e di clearing non scendono di un fattore 10, e la tariffa regolamentare NFA è fissa indipendentemente dalle dimensioni del contratto." },
    { q: "Perché i contratti micro sono più costosi per unità di esposizione?", a: "Perché la commissione si riduce più lentamente del contratto. Un micro è un decimo del suo mini, ma la commissione è inferiore solo di circa un terzo e la tariffa di borsa solo di circa un quarto. La tariffa NFA fissa è identica su entrambi. Quindi, per ogni dollaro di movimento del prezzo, un micro le costa più in commissioni di un mini." },
    { q: "Che cos'è una tariffa all-in su Tradovate?", a: "La tariffa all-in è il totale che paga effettivamente per negoziare un contratto, e combina la commissione del broker, la tariffa di borsa CME, la tariffa regolamentare NFA e la tariffa di clearing. Una tariffa all-in round turn conta entrambi i lati, ingresso e uscita, poiché paga ciascuna tariffa sia in entrata sia in uscita." },
    { q: "È più economico negoziare un NQ o dieci MNQ?", a: "Un NQ. Dieci contratti MNQ le danno la stessa esposizione di mercato di un NQ, ma paga la commissione per contratto dieci volte sui micro. In pratica ciò si traduce in circa tre volte le commissioni del singolo mini a parità di dimensione, quindi se negozia costantemente micro a blocchi di dieci, il mini corrispondente è lo strumento più economico." },
    { q: "Le tariffe di borsa e NFA differiscono tra i broker?", a: "La tariffa di borsa CME e la tariffa regolamentare NFA sono stabilite dalla borsa e dal regolatore, quindi non cambiano da un broker all'altro, anche se variano in base al contratto e allo status di membro. La commissione e la tariffa di clearing sono stabilite dal broker o dalla società di clearing e possono differire. Quando confronta le piattaforme, confronti la commissione, poiché le componenti di borsa e NFA sono in gran parte fisse." },
    { q: "Come vedo la commissione esatta di ciascuno dei miei trade?", a: "Apra l'area dei report o degli estratti conto di Tradovate ed estragga un report degli ordini eseguiti o delle commissioni per il periodo. Dettaglia commissione e tariffe per contratto, che è il numero reale con cui fare il budget, anziché un tasso di commissione pubblicizzato che omette i costi di borsa, NFA e clearing." },
    { q: "Il mio piano di abbonamento modifica queste commissioni?", a: "Il suo piano modifica solo la componente di commissione. Passare dal piano Free a Monthly o Lifetime riduce la commissione per lato sia sui mini sia sui micro, ma non tocca le tariffe di borsa o NFA, stabilite al di fuori del broker. Confermi la commissione attuale del suo livello nel suo tariffario." },
  ] },
