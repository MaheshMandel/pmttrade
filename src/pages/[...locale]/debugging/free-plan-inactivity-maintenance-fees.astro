---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "free-plan-inactivity-maintenance-fees";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/debugging/${SLUG}`;

const META_TITLE = "Tradovate Free Plan $35 / $25 Inactivity Fees";
const META_DESCRIPTION =
  "Tradovate Free plan inactivity fees explained: why the $35 (30-day) and $25 (90-day) charges hit, and how to stop them by trading or switching plans.";

// Short SEO title (<=60 chars) for locales where the shared h1 is too long for a SERP title.
const TITLE_OVERRIDE: Partial<Record<Locale, string>> = { es: "Tradovate plan gratuito: comisiones de inactividad $35/$25", it: "Piano gratuito Tradovate: commissioni di inattività $35/$25" };

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Tradovate Free Plan: $35 / $25 Inaktivitätsgebühren", es: "Plan gratuito de Tradovate: comisiones de inactividad de $35 y $25", fr: "Forfait gratuit Tradovate : frais d'inactivité de $35 et $25", it: "Piano gratuito Tradovate: commissioni di inattività di $35 e $25" },
  dek: { en: "A charge on the plan that's supposed to be free stings the most. Here's exactly what triggers the $35 and $25 Free-plan fees, and how to make sure they never post again.", de: "Eine Belastung auf dem Plan, der eigentlich kostenlos sein soll, schmerzt am meisten. Hier erfahren Sie genau, was die $35- und $25-Gebühren des Free-Plans auslöst und wie Sie dafür sorgen, dass sie nie wieder anfallen.", es: "Un cargo en el plan que se supone gratuito es el que más duele. Esto es exactamente lo que activa las comisiones de $35 y $25 del plan gratuito, y cómo asegurarse de que no vuelvan a aparecer.", fr: "Rien n'agace plus qu'un prélèvement sur le forfait censé être gratuit. Voici exactement ce qui déclenche les frais de $35 et $25 du forfait gratuit, et comment faire en sorte qu'ils ne soient plus jamais facturés.", it: "Un addebito sul piano che dovrebbe essere gratuito è quello che brucia di più. Ecco esattamente cosa scatena le commissioni da $35 e $25 del piano gratuito e come evitare che vengano applicate di nuovo." },
  readTime: { en: "7 min read", de: "7 Minuten Lesezeit", es: "Lectura de 7 minutos", fr: "Lecture de 7 minutes", it: "Lettura di 7 minuti" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "Nothing stings quite like opening your Tradovate statement and finding a charge you never signed off on, especially on the plan that's supposed to be free. Tradovate's Free (pay-as-you-go) plan carries two easy-to-miss activity fees in 2026: a <strong class='text-white'>$35 inactivity fee</strong> when a Free-plan account goes roughly 30 days without a live trade, and a <strong class='text-white'>$25 maintenance fee</strong> when a <em>funded</em> Free-membership account sits about 90 days without one. Neither is a bug or a billing glitch. Both are written into the Free plan's terms, and both are avoidable once you know exactly what sets them off. Here's why the fees post, how to stop them, and when it's simply cheaper to move to a Monthly or Lifetime plan." },
    { type: "quote", html: "Fee amounts and terms can change. The $35 and $25 figures below were verified against Tradovate's published fee and plan documentation, but Tradovate can revise its schedule at any time. Always confirm the current numbers in your own account's fee schedule before acting." },
    {
      type: "checklist",
      heading: "Quick Checklist for Tradovate Free-Plan Fees",
      items: [
        "<strong class='text-white'>On the Free plan?</strong> The inactivity fee only touches Free/pay-as-you-go accounts. Monthly and Lifetime plans are exempt.",
        "<strong class='text-white'>Placed a live trade this cycle?</strong> Logging in isn't enough. Get at least one <em>live</em> trade filled inside the roughly 30-day window to dodge the $35 charge.",
        "<strong class='text-white'>Funded but idle 90 days?</strong> A funded Free-membership account with no trade in the preceding ~90 days can pick up the separate $25 maintenance fee.",
        "<strong class='text-white'>Only paper trading?</strong> Simulated and demo fills typically don't count as the live activity that resets the clock. Confirm it in your fee schedule.",
        "<strong class='text-white'>Trading rarely?</strong> If you place fewer than a handful of live trades a month, weigh the recurring $35 risk against a flat Monthly or Lifetime plan.",
        "<strong class='text-white'>On a prop-firm evaluation?</strong> Evaluation and funded prop accounts are billed by the firm, not by this Tradovate retail fee. Check your firm's current rules.",
      ],
    },
    { type: "heading", text: "What the “$35 Inactivity Fee” and “$25 Maintenance Fee” Mean" },
    { type: "paragraph", html: "Tradovate's Free plan has <strong class='text-white'>no monthly subscription cost</strong>, you pay per contract instead of a flat membership fee. To keep that model sustainable, Tradovate attaches two activity-based charges to Free accounts that go dormant." },
    { type: "paragraph", html: "The <strong class='text-white'>$35 inactivity fee</strong> is the one most traders run into. Tradovate's plan documentation ties it to a Free-plan account that's active (logged in) during the period but places <em>no live trades</em> within roughly a 30-day window, some Tradovate wording frames this as a calendar month. It is explicitly <em>not</em> charged to Monthly or Lifetime members. Put plainly: an empty, no-trade month on the Free plan can cost you $35." },
    { type: "paragraph", html: "The <strong class='text-white'>$25 maintenance fee</strong> is a separate, less common charge. It hits <em>funded</em> Free-membership accounts that place no trade in the <strong class='text-white'>preceding 90 days</strong>. This is a longer-horizon dormancy charge aimed at funded accounts left sitting idle, and it can stack on top of, or follow, the shorter inactivity charge if the account stays untouched." },
    { type: "paragraph", html: "The mental model that matters: these are <strong class='text-white'>activity fees, not penalties for wrongdoing</strong>. Tradovate isn't flagging your account, it's applying the terms of the free tier. Which also means the fix is entirely in your hands." },
    { type: "heading", text: "Top Causes of Unexpected Free-Plan Fees" },
    { type: "heading", text: "1. You're on the Free Plan and Traded Nothing Live This Cycle" },
    { type: "paragraph", html: "This is far and away the most common source of the $35 charge. Plenty of traders open a Free Tradovate account to kick the tires, connect charts, watch the DOM, run a few simulated trades, then log out without ever placing a live order. The account looks &ldquo;used,&rdquo; but from a billing standpoint it produced zero live activity, so the inactivity fee lands." },
    { type: "heading", text: "2. You Assumed Logging In Was Enough" },
    { type: "paragraph", html: "A frequent misconception is that simply signing in keeps the account active. It doesn't. The condition is about <strong class='text-white'>placing a live trade</strong>, not session activity. You can log in every day for a month and still be charged if you never sent a live order." },
    { type: "heading", text: "3. Simulated/Paper Trades Didn't Count" },
    { type: "paragraph", html: "Practicing in the simulated environment is great for building a strategy, but demo fills generally don't satisfy the live-trade requirement that resets the inactivity window. If your entire month was paper trading, the Free plan can still bill the fee." },
    { type: "heading", text: "4. A Funded Account Sat Idle for a Full Quarter" },
    { type: "paragraph", html: "The $25 maintenance fee is triggered by a longer stretch of nothing, roughly 90 days with no trade on a funded Free-membership account. Traders who fund an account, step away for a season, and forget about it are the usual candidates." },
    { type: "heading", text: "5. Your Trading Volume Doesn't Justify the Free Plan" },
    { type: "paragraph", html: "The Free plan wins for high-frequency traders who happily pay per contract and never risk inactivity. For occasional or seasonal traders, though, the recurring $35 exposure can quietly outrun what a flat Monthly plan would have cost, which means the &ldquo;free&rdquo; plan is the wrong plan for your habits." },
    { type: "heading", text: "How to Fix and Avoid Free-Plan Fees: Step-by-Step" },
    { type: "heading", text: "Fixing Causes 1–3: Place a Live Trade Inside the Window" },
    { type: "paragraph", html: "The cleanest way to zero out the $35 inactivity fee is to make sure at least one <strong class='text-white'>live</strong> trade lands inside each cycle." },
    {
      type: "list",
      items: [
        "Fund your Tradovate account, a live trade requires a live, funded account.",
        "Open the SuperDOM, chart, or order ticket for a liquid instrument.",
        "Place a small live order, say, a single micro contract, and let it fill.",
        "Optionally close it right back out. The point is a real live fill, which resets the activity window.",
        "Note the date, and set a recurring reminder before the next ~30-day mark.",
      ],
    },
    { type: "paragraph", html: "A single micro-contract round trip costs only its commission and any exchange fees, far less than a $35 inactivity charge, so it's cheap insurance for months you know you'll be away from the desk." },
    { type: "heading", text: "Fixing Cause 4: Trade or Close an Idle Funded Account" },
    { type: "paragraph", html: "Got a funded Free-membership account you're not using? You have two moves: place an occasional live trade to stay inside the ~90-day maintenance window, or, if you're truly done with it, withdraw your balance and close the account so it can't accrue maintenance charges. Leaving a funded account fully dormant is exactly what invites the $25 fee." },
    { type: "heading", text: "Fixing Cause 5: Switch to Monthly or Lifetime to Remove the Fee Entirely" },
    { type: "paragraph", html: "The permanent fix for inactivity fees is to leave the Free plan. <strong class='text-white'>Monthly and Lifetime plans aren't subject to the inactivity fee</strong>, and they carry lower per-contract commissions, so active traders often come out ahead anyway." },
    {
      type: "list",
      items: [
        "Open your Tradovate membership/plan settings.",
        "Review the Free, Monthly, and Lifetime tiers side by side, commissions plus any flat fee.",
        "Estimate your realistic monthly live-trade volume.",
        "If you trade regularly, pick Monthly or Lifetime. The flat fee removes inactivity risk and lowers commissions.",
        "If you trade rarely, keep Free but calendar a monthly live trade.",
      ],
    },
    { type: "heading", text: "Troubleshooting Table" },
    {
      type: "table",
      headers: ["Charge / symptom", "What it means", "Fix"],
      rows: [
        ["$35 inactivity fee", "Free plan, no live trade in ~30-day window", "Place one live trade each cycle, or switch to Monthly/Lifetime"],
        ["$25 maintenance fee", "Funded Free-membership account idle ~90 days", "Trade occasionally, or withdraw and close the idle account"],
        ["Fee posted after a month of only logging in", "Session activity doesn't count; a live trade is required", "Send at least one live order before the next cycle"],
        ["Fee posted after only paper trading", "Simulated fills don't reset the live-activity window", "Place a live (funded) trade, not just a demo trade"],
        ["Recurring $35 charges every quiet month", "Free plan mismatched to low trade volume", "Move to a flat Monthly or Lifetime plan"],
        ["Fee on a prop-firm evaluation account", "Billed by the prop firm, not this retail fee", "Check your firm's current billing rules"],
      ],
    },
    { type: "heading", text: "Prevent This With PickMyTrade" },
    { type: "paragraph", html: "If your account goes idle because you can't always be at the screen to place trades, automation keeps activity flowing without you babysitting the platform. PickMyTrade links your TradingView alerts straight to your Tradovate account, so:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Hands-off live execution</strong>, your strategy's alerts fire real orders automatically, so quiet weeks at your desk don't have to mean a zero-trade billing cycle.",
        "<strong class='text-white'>Consistent activity</strong>, a systematic, always-on strategy naturally keeps the account trading inside the window instead of drifting into dormancy.",
        "<strong class='text-white'>Multi-account sync</strong>, mirror the same activity across multiple Tradovate accounts so none of them slip into an idle state unnoticed.",
        "<strong class='text-white'>Clear trade records</strong>, every automated fill is logged, making it easy to prove the account traded within each cycle.",
      ],
    },
    { type: "paragraph", html: "Automation isn't a substitute for choosing the right plan, but for traders who go quiet for stretches, it removes the &ldquo;I forgot to trade&rdquo; cause of inactivity fees entirely." },
  ], de: [
    { type: "paragraph", html: "Nichts ärgert mehr, als den Tradovate-Kontoauszug zu öffnen und eine Belastung zu finden, der man nie zugestimmt hat, besonders auf dem Plan, der eigentlich kostenlos sein soll. Tradovates Free-Plan (Pay-as-you-go) enthält 2026 zwei leicht zu übersehende Aktivitätsgebühren: eine <strong class='text-white'>$35-Inaktivitätsgebühr</strong>, wenn ein Free-Plan-Konto rund 30 Tage lang keinen Live-Trade verzeichnet, und eine <strong class='text-white'>$25-Wartungsgebühr</strong>, wenn ein <em>finanziertes</em> Free-Membership-Konto etwa 90 Tage lang untätig bleibt. Keine der beiden ist ein Fehler oder ein Abrechnungsproblem. Beide sind in den Bedingungen des Free-Plans festgelegt, und beide lassen sich vermeiden, sobald man genau weiß, was sie auslöst. Hier erfahren Sie, warum die Gebühren anfallen, wie Sie sie verhindern und wann ein Wechsel zu einem Monthly- oder Lifetime-Plan einfach günstiger ist." },
    { type: "quote", html: "Gebührenbeträge und Bedingungen können sich ändern. Die unten genannten Beträge von $35 und $25 wurden anhand der veröffentlichten Gebühren- und Plandokumentation von Tradovate überprüft, doch Tradovate kann seine Gebührenordnung jederzeit anpassen. Bestätigen Sie die aktuellen Zahlen immer im Gebührenverzeichnis Ihres eigenen Kontos, bevor Sie handeln." },
    {
      type: "checklist",
      heading: "Schnelle Checkliste für Tradovate Free-Plan-Gebühren",
      items: [
        "<strong class='text-white'>Sind Sie im Free-Plan?</strong> Die Inaktivitätsgebühr betrifft nur Free-/Pay-as-you-go-Konten. Monthly- und Lifetime-Pläne sind davon ausgenommen.",
        "<strong class='text-white'>Haben Sie in diesem Zyklus einen Live-Trade platziert?</strong> Anmelden allein reicht nicht. Lassen Sie mindestens einen <em>Live</em>-Trade innerhalb des rund 30-Tage-Fensters ausführen, um die $35-Gebühr zu vermeiden.",
        "<strong class='text-white'>Finanziert, aber 90 Tage inaktiv?</strong> Ein finanziertes Free-Membership-Konto ohne Trade in den vorangegangenen ~90 Tagen kann die separate $25-Wartungsgebühr erhalten.",
        "<strong class='text-white'>Nur Papierhandel?</strong> Simulierte Ausführungen und Demo-Fills zählen in der Regel nicht als die Live-Aktivität, die die Uhr zurücksetzt. Prüfen Sie dies in Ihrem Gebührenverzeichnis.",
        "<strong class='text-white'>Handeln Sie selten?</strong> Wenn Sie weniger als eine Handvoll Live-Trades pro Monat platzieren, wägen Sie das wiederkehrende $35-Risiko gegen einen pauschalen Monthly- oder Lifetime-Plan ab.",
        "<strong class='text-white'>In einer Prop-Firm-Evaluation?</strong> Evaluation- und finanzierte Prop-Konten werden von der Firma abgerechnet, nicht durch diese Tradovate-Retailgebühr. Prüfen Sie die aktuellen Regeln Ihrer Firma.",
      ],
    },
    { type: "heading", text: "Was die „$35-Inaktivitätsgebühr“ und die „$25-Wartungsgebühr“ bedeuten" },
    { type: "paragraph", html: "Tradovates Free-Plan hat <strong class='text-white'>keine monatlichen Abonnementkosten</strong>, Sie zahlen pro Kontrakt statt einer pauschalen Mitgliedsgebühr. Damit dieses Modell tragfähig bleibt, koppelt Tradovate zwei aktivitätsbasierte Gebühren an Free-Konten, die inaktiv werden." },
    { type: "paragraph", html: "Die <strong class='text-white'>$35-Inaktivitätsgebühr</strong> ist diejenige, auf die die meisten Trader stoßen. Tradovates Plandokumentation knüpft sie an ein Free-Plan-Konto, das während des Zeitraums aktiv ist (angemeldet), aber innerhalb von rund 30 Tagen <em>keine Live-Trades</em> platziert, manche Tradovate-Formulierungen fassen dies als Kalendermonat. Sie wird ausdrücklich <em>nicht</em> von Monthly- oder Lifetime-Mitgliedern erhoben. Einfach gesagt: Ein leerer Monat ohne Trade im Free-Plan kann Sie $35 kosten." },
    { type: "paragraph", html: "Die <strong class='text-white'>$25-Wartungsgebühr</strong> ist eine separate, weniger häufige Belastung. Sie betrifft <em>finanzierte</em> Free-Membership-Konten, die in den <strong class='text-white'>vorangegangenen 90 Tagen</strong> keinen Trade platzieren. Dies ist eine Gebühr für längerfristige Inaktivität, die auf finanzierte, ungenutzt liegen gelassene Konten abzielt, und sie kann zusätzlich zur kürzeren Inaktivitätsgebühr anfallen oder auf diese folgen, wenn das Konto weiterhin unangetastet bleibt." },
    { type: "paragraph", html: "Wichtig ist folgendes Denkmodell: Dies sind <strong class='text-white'>Aktivitätsgebühren, keine Strafen für Fehlverhalten</strong>. Tradovate markiert Ihr Konto nicht, sondern wendet lediglich die Bedingungen der kostenlosen Stufe an. Das bedeutet auch, dass die Lösung vollständig in Ihrer Hand liegt." },
    { type: "heading", text: "Häufigste Ursachen für unerwartete Free-Plan-Gebühren" },
    { type: "heading", text: "1. Sie sind im Free-Plan und haben in diesem Zyklus nicht live gehandelt" },
    { type: "paragraph", html: "Dies ist mit Abstand die häufigste Ursache für die $35-Gebühr. Viele Trader eröffnen ein Free-Tradovate-Konto, um es auszuprobieren, Charts zu verbinden, das DOM zu beobachten und ein paar simulierte Trades zu tätigen, melden sich dann aber ab, ohne je einen Live-Auftrag zu platzieren. Das Konto wirkt &ldquo;genutzt,&rdquo; aber aus Abrechnungssicht wurde keine Live-Aktivität erzeugt, weshalb die Inaktivitätsgebühr anfällt." },
    { type: "heading", text: "2. Sie dachten, Anmelden allein genüge" },
    { type: "paragraph", html: "Ein häufiger Irrtum ist, dass allein das Anmelden das Konto aktiv hält. Das stimmt nicht. Die Bedingung bezieht sich auf <strong class='text-white'>das Platzieren eines Live-Trades</strong>, nicht auf Sitzungsaktivität. Sie können sich einen ganzen Monat lang täglich anmelden und trotzdem belastet werden, wenn Sie nie einen Live-Auftrag gesendet haben." },
    { type: "heading", text: "3. Simulierte Trades/Papierhandel zählten nicht" },
    { type: "paragraph", html: "Das Üben in der simulierten Umgebung ist hervorragend, um eine Strategie zu entwickeln, aber Demo-Ausführungen erfüllen in der Regel nicht die Live-Trade-Anforderung, die das Inaktivitätsfenster zurücksetzt. Wenn Ihr gesamter Monat aus Papierhandel bestand, kann der Free-Plan die Gebühr trotzdem berechnen." },
    { type: "heading", text: "4. Ein finanziertes Konto blieb ein ganzes Quartal untätig" },
    { type: "paragraph", html: "Die $25-Wartungsgebühr wird durch eine längere Phase völliger Inaktivität ausgelöst, rund 90 Tage ohne Trade auf einem finanzierten Free-Membership-Konto. Trader, die ein Konto finanzieren, sich für eine Saison zurückziehen und es dann vergessen, sind die üblichen Kandidaten." },
    { type: "heading", text: "5. Ihr Handelsvolumen rechtfertigt den Free-Plan nicht" },
    { type: "paragraph", html: "Der Free-Plan lohnt sich für Vieltrader, die gerne pro Kontrakt zahlen und nie Gefahr laufen, inaktiv zu werden. Für Gelegenheits- oder Saisonhändler kann das wiederkehrende $35-Risiko jedoch unbemerkt teurer werden als ein pauschaler Monthly-Plan, was bedeutet, dass der &ldquo;kostenlose&rdquo; Plan nicht zu Ihren Gewohnheiten passt." },
    { type: "heading", text: "So beheben und vermeiden Sie Free-Plan-Gebühren: Schritt für Schritt" },
    { type: "heading", text: "Ursachen 1–3 beheben: Platzieren Sie einen Live-Trade innerhalb des Fensters" },
    { type: "paragraph", html: "Der sauberste Weg, die $35-Inaktivitätsgebühr auf null zu setzen, besteht darin sicherzustellen, dass mindestens ein <strong class='text-white'>Live</strong>-Trade innerhalb jedes Zyklus ausgeführt wird." },
    {
      type: "list",
      items: [
        "Finanzieren Sie Ihr Tradovate-Konto, ein Live-Trade erfordert ein live finanziertes Konto.",
        "Öffnen Sie das SuperDOM, den Chart oder das Order-Ticket für ein liquides Instrument.",
        "Platzieren Sie einen kleinen Live-Auftrag, etwa einen einzelnen Mikrokontrakt, und lassen Sie ihn ausführen.",
        "Schließen Sie ihn optional gleich wieder. Entscheidend ist eine echte Live-Ausführung, die das Aktivitätsfenster zurücksetzt.",
        "Notieren Sie sich das Datum und richten Sie eine wiederkehrende Erinnerung vor der nächsten ~30-Tage-Marke ein.",
      ],
    },
    { type: "paragraph", html: "Ein einzelner Micro-Kontrakt-Round-Trip kostet nur die Kommission und eventuelle Börsengebühren, weit weniger als eine $35-Inaktivitätsgebühr, also ist es eine günstige Absicherung für Monate, in denen Sie wissentlich nicht am Schreibtisch sein werden." },
    { type: "heading", text: "Ursache 4 beheben: Handeln Sie oder schließen Sie ein untätiges finanziertes Konto" },
    { type: "paragraph", html: "Haben Sie ein finanziertes Free-Membership-Konto, das Sie nicht nutzen? Sie haben zwei Möglichkeiten: Platzieren Sie gelegentlich einen Live-Trade, um innerhalb des ~90-Tage-Wartungsfensters zu bleiben, oder, wenn Sie wirklich damit fertig sind, heben Sie Ihr Guthaben ab und schließen Sie das Konto, damit keine Wartungsgebühren anfallen können. Ein finanziertes Konto völlig ungenutzt zu lassen, ist genau das, was die $25-Gebühr provoziert." },
    { type: "heading", text: "Ursache 5 beheben: Wechseln Sie zu Monthly oder Lifetime, um die Gebühr vollständig zu entfernen" },
    { type: "paragraph", html: "Die dauerhafte Lösung für Inaktivitätsgebühren besteht darin, den Free-Plan zu verlassen. <strong class='text-white'>Monthly- und Lifetime-Pläne unterliegen nicht der Inaktivitätsgebühr</strong>, und sie haben niedrigere Kommissionen pro Kontrakt, sodass aktive Trader ohnehin oft besser fahren." },
    {
      type: "list",
      items: [
        "Öffnen Sie Ihre Tradovate-Mitgliedschafts-/Planeinstellungen.",
        "Vergleichen Sie die Stufen Free, Monthly und Lifetime nebeneinander, Kommissionen plus etwaige Pauschalgebühr.",
        "Schätzen Sie Ihr realistisches monatliches Live-Trade-Volumen.",
        "Wenn Sie regelmäßig handeln, wählen Sie Monthly oder Lifetime. Die Pauschalgebühr beseitigt das Inaktivitätsrisiko und senkt die Kommissionen.",
        "Wenn Sie selten handeln, behalten Sie Free bei, planen Sie aber einen monatlichen Live-Trade fest ein.",
      ],
    },
    { type: "heading", text: "Fehlerbehebungstabelle" },
    {
      type: "table",
      headers: ["Gebühr/Symptom", "Was es bedeutet", "Lösung"],
      rows: [
        ["$35-Inaktivitätsgebühr", "Free-Plan, kein Live-Trade im ~30-Tage-Fenster", "Platzieren Sie pro Zyklus einen Live-Trade oder wechseln Sie zu Monthly/Lifetime"],
        ["$25-Wartungsgebühr", "Finanziertes Free-Membership-Konto ~90 Tage inaktiv", "Handeln Sie gelegentlich oder heben Sie ab und schließen Sie das inaktive Konto"],
        ["Gebühr nach einem Monat mit nur Anmeldungen", "Sitzungsaktivität zählt nicht; ein Live-Trade ist erforderlich", "Senden Sie vor dem nächsten Zyklus mindestens einen Live-Auftrag"],
        ["Gebühr nach reinem Papierhandel", "Simulierte Ausführungen setzen das Live-Aktivitätsfenster nicht zurück", "Platzieren Sie einen Live-Trade (finanziert), nicht nur einen Demo-Trade"],
        ["Wiederkehrende $35-Gebühren in jedem ruhigen Monat", "Free-Plan passt nicht zum geringen Handelsvolumen", "Wechseln Sie zu einem pauschalen Monthly- oder Lifetime-Plan"],
        ["Gebühr auf einem Prop-Firm-Evaluationskonto", "Wird von der Prop-Firma abgerechnet, nicht durch diese Retailgebühr", "Prüfen Sie die aktuellen Abrechnungsregeln Ihrer Firma"],
      ],
    },
    { type: "heading", text: "So verhindern Sie dies mit PickMyTrade" },
    { type: "paragraph", html: "Wenn Ihr Konto inaktiv wird, weil Sie nicht immer am Bildschirm sein können, um Trades zu platzieren, sorgt Automatisierung dafür, dass die Aktivität weiterläuft, ohne dass Sie die Plattform ständig überwachen müssen. PickMyTrade verbindet Ihre TradingView-Alerts direkt mit Ihrem Tradovate-Konto, sodass:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Automatisierte Live-Ausführung</strong>, die Alerts Ihrer Strategie lösen automatisch echte Aufträge aus, sodass ruhige Wochen am Schreibtisch nicht zwangsläufig einen Abrechnungszyklus ohne Trade bedeuten.",
        "<strong class='text-white'>Konstante Aktivität</strong>, eine systematische, immer aktive Strategie hält das Konto von Natur aus innerhalb des Fensters handelnd, statt in Inaktivität abzudriften.",
        "<strong class='text-white'>Multi-Konto-Synchronisierung</strong>, spiegeln Sie dieselbe Aktivität über mehrere Tradovate-Konten hinweg, damit keines unbemerkt inaktiv wird.",
        "<strong class='text-white'>Klare Handelsaufzeichnungen</strong>, jede automatisierte Ausführung wird protokolliert, sodass sich leicht nachweisen lässt, dass das Konto innerhalb jedes Zyklus gehandelt hat.",
      ],
    },
    { type: "paragraph", html: "Automatisierung ersetzt nicht die Wahl des richtigen Plans, aber für Trader, die zeitweise pausieren, beseitigt sie die Ursache &ldquo;Ich habe vergessen zu handeln&rdquo; für Inaktivitätsgebühren vollständig." },
  ], es: [
    { type: "paragraph", html: "Nada duele tanto como abrir el extracto de Tradovate y encontrar un cargo que nunca autorizó, sobre todo en el plan que se supone gratuito. El plan gratuito (pago por uso) de Tradovate incluye en 2026 dos comisiones de actividad fáciles de pasar por alto: una <strong class='text-white'>comisión de inactividad de $35</strong> cuando una cuenta del plan gratuito pasa aproximadamente 30 días sin una operación en vivo, y una <strong class='text-white'>comisión de mantenimiento de $25</strong> cuando una cuenta de membresía gratuita <em>financiada</em> permanece unos 90 días sin operar. Ninguna de las dos es un error ni un fallo de facturación. Ambas están escritas en los términos del plan gratuito, y ambas se pueden evitar en cuanto se sabe exactamente qué las desencadena. A continuación, por qué se aplican estas comisiones, cómo evitarlas y cuándo simplemente resulta más barato pasarse a un plan mensual o de por vida." },
    { type: "quote", html: "Los importes y condiciones de las comisiones pueden cambiar. Las cifras de $35 y $25 que se indican a continuación se verificaron con la documentación de comisiones y planes publicada por Tradovate, pero Tradovate puede modificar su tarifario en cualquier momento. Confirme siempre las cifras actuales en el tarifario de su propia cuenta antes de actuar." },
    {
      type: "checklist",
      heading: "Lista rápida de verificación de comisiones del plan gratuito de Tradovate",
      items: [
        "<strong class='text-white'>¿Está en el plan gratuito?</strong> La comisión de inactividad solo afecta a las cuentas gratuitas/de pago por uso. Los planes mensual y de por vida están exentos.",
        "<strong class='text-white'>¿Realizó una operación en vivo en este ciclo?</strong> Con iniciar sesión no basta. Ejecute al menos una operación <em>en vivo</em> dentro de la ventana de aproximadamente 30 días para evitar el cargo de $35.",
        "<strong class='text-white'>¿Cuenta financiada pero inactiva 90 días?</strong> Una cuenta de membresía gratuita financiada sin operaciones en los ~90 días anteriores puede generar la comisión de mantenimiento de $25 aparte.",
        "<strong class='text-white'>¿Solo opera en modo simulado?</strong> Las ejecuciones simuladas y de demostración normalmente no cuentan como la actividad en vivo que reinicia el plazo. Confírmelo en su tarifario.",
        "<strong class='text-white'>¿Opera con poca frecuencia?</strong> Si realiza menos de un puñado de operaciones en vivo al mes, sopese el riesgo recurrente de $35 frente a un plan mensual o de por vida con tarifa fija.",
        "<strong class='text-white'>¿Está en una evaluación de una prop firm?</strong> Las cuentas de evaluación y las cuentas prop financiadas las factura la firma, no esta comisión minorista de Tradovate. Consulte las normas vigentes de su firma.",
      ],
    },
    { type: "heading", text: "Qué significan la «comisión de inactividad de $35» y la «comisión de mantenimiento de $25»" },
    { type: "paragraph", html: "El plan gratuito de Tradovate <strong class='text-white'>no tiene coste de suscripción mensual</strong>, se paga por contrato en lugar de una cuota de membresía fija. Para mantener ese modelo sostenible, Tradovate aplica dos cargos basados en la actividad a las cuentas gratuitas que quedan inactivas." },
    { type: "paragraph", html: "La <strong class='text-white'>comisión de inactividad de $35</strong> es la que afecta a la mayoría de los operadores. La documentación de planes de Tradovate la vincula a una cuenta del plan gratuito que está activa (con sesión iniciada) durante el periodo, pero que <em>no realiza operaciones en vivo</em> en una ventana de aproximadamente 30 días; algunos textos de Tradovate lo describen como un mes natural. Explícitamente <em>no</em> se cobra a los miembros mensuales o de por vida. Dicho claramente: un mes sin operar en el plan gratuito puede costarle $35." },
    { type: "paragraph", html: "La <strong class='text-white'>comisión de mantenimiento de $25</strong> es un cargo aparte y menos habitual. Afecta a las cuentas de membresía gratuita <em>financiadas</em> que no realizan ninguna operación en los <strong class='text-white'>90 días anteriores</strong>. Es un cargo por inactividad de horizonte más largo, dirigido a cuentas financiadas dejadas sin uso, y puede sumarse a la comisión de inactividad más corta, o sucederla, si la cuenta permanece intocada." },
    { type: "paragraph", html: "El modelo mental que importa: se trata de <strong class='text-white'>comisiones por actividad, no penalizaciones por mala conducta</strong>. Tradovate no está marcando su cuenta, simplemente aplica los términos del nivel gratuito. Lo que también significa que la solución está enteramente en sus manos." },
    { type: "heading", text: "Principales causas de comisiones inesperadas en el plan gratuito" },
    { type: "heading", text: "1. Está en el plan gratuito y no operó en vivo en este ciclo" },
    { type: "paragraph", html: "Esta es, con diferencia, la causa más común del cargo de $35. Muchos operadores abren una cuenta gratuita de Tradovate para probarla, conectar gráficos, observar el DOM y realizar algunas operaciones simuladas, y luego cierran sesión sin llegar a colocar una orden en vivo. La cuenta parece &ldquo;utilizada,&rdquo; pero desde el punto de vista de facturación no generó ninguna actividad en vivo, por lo que se aplica la comisión de inactividad." },
    { type: "heading", text: "2. Supuso que con iniciar sesión bastaba" },
    { type: "paragraph", html: "Un error frecuente es pensar que con solo iniciar sesión la cuenta se mantiene activa. No es así. La condición depende de <strong class='text-white'>colocar una operación en vivo</strong>, no de la actividad de sesión. Puede iniciar sesión todos los días durante un mes y aun así recibir el cargo si nunca envió una orden en vivo." },
    { type: "heading", text: "3. Las operaciones simuladas/de demostración no contaron" },
    { type: "paragraph", html: "Practicar en el entorno simulado es excelente para construir una estrategia, pero las ejecuciones de demostración por lo general no cumplen el requisito de operación en vivo que reinicia la ventana de inactividad. Si todo su mes fue de operativa simulada, el plan gratuito puede seguir aplicando la comisión." },
    { type: "heading", text: "4. Una cuenta financiada permaneció inactiva un trimestre completo" },
    { type: "paragraph", html: "La comisión de mantenimiento de $25 se activa por un periodo más largo de inactividad total, unos 90 días sin operar en una cuenta de membresía gratuita financiada. Los operadores que financian una cuenta, se ausentan por una temporada y se olvidan de ella son los candidatos habituales." },
    { type: "heading", text: "5. Su volumen de operaciones no justifica el plan gratuito" },
    { type: "paragraph", html: "El plan gratuito favorece a los operadores de alta frecuencia que pagan con gusto por contrato y nunca corren el riesgo de inactividad. Sin embargo, para operadores ocasionales o estacionales, la exposición recurrente de $35 puede terminar costando más, sin que se note, de lo que habría costado un plan mensual con tarifa fija, lo que significa que el plan &ldquo;gratuito&rdquo; no se ajusta a sus hábitos." },
    { type: "heading", text: "Cómo solucionar y evitar las comisiones del plan gratuito: paso a paso" },
    { type: "heading", text: "Solución a las causas 1-3: realice una operación en vivo dentro de la ventana" },
    { type: "paragraph", html: "La forma más limpia de anular la comisión de inactividad de $35 es asegurarse de que al menos una operación <strong class='text-white'>en vivo</strong> se ejecute dentro de cada ciclo." },
    {
      type: "list",
      items: [
        "Financie su cuenta de Tradovate, una operación en vivo requiere una cuenta en vivo y financiada.",
        "Abra el SuperDOM, el gráfico o el ticket de orden de un instrumento líquido.",
        "Coloque una orden en vivo pequeña, por ejemplo un único contrato micro, y deje que se ejecute.",
        "Opcionalmente, ciérrela de inmediato. Lo importante es una ejecución real en vivo, que reinicia la ventana de actividad.",
        "Anote la fecha y configure un recordatorio recurrente antes de la siguiente marca de ~30 días.",
      ],
    },
    { type: "paragraph", html: "Una operación de ida y vuelta con un único contrato micro solo cuesta su comisión y las posibles tasas del mercado, mucho menos que un cargo de inactividad de $35, por lo que es un seguro barato para los meses en los que sabe que estará alejado del escritorio." },
    { type: "heading", text: "Solución a la causa 4: opere o cierre una cuenta financiada inactiva" },
    { type: "paragraph", html: "¿Tiene una cuenta de membresía gratuita financiada que no está usando? Tiene dos opciones: realizar una operación en vivo de vez en cuando para mantenerse dentro de la ventana de mantenimiento de ~90 días, o, si realmente ha terminado con ella, retirar su saldo y cerrar la cuenta para que no pueda acumular comisiones de mantenimiento. Dejar una cuenta financiada completamente inactiva es exactamente lo que provoca la comisión de $25." },
    { type: "heading", text: "Solución a la causa 5: cambie a mensual o de por vida para eliminar la comisión por completo" },
    { type: "paragraph", html: "La solución permanente para las comisiones de inactividad es abandonar el plan gratuito. <strong class='text-white'>Los planes mensual y de por vida no están sujetos a la comisión de inactividad</strong>, y tienen comisiones por contrato más bajas, por lo que los operadores activos suelen salir ganando de todos modos." },
    {
      type: "list",
      items: [
        "Abra la configuración de membresía/plan de Tradovate.",
        "Compare los niveles Gratuito, Mensual y De por vida uno al lado del otro, comisiones más cualquier tarifa fija.",
        "Estime su volumen mensual realista de operaciones en vivo.",
        "Si opera con regularidad, elija Mensual o De por vida. La tarifa fija elimina el riesgo de inactividad y reduce las comisiones.",
        "Si opera con poca frecuencia, mantenga el plan gratuito, pero programe una operación en vivo mensual.",
      ],
    },
    { type: "heading", text: "Tabla de solución de problemas" },
    {
      type: "table",
      headers: ["Cargo / síntoma", "Qué significa", "Solución"],
      rows: [
        ["Comisión de inactividad de $35", "Plan gratuito, sin operación en vivo en la ventana de ~30 días", "Realice una operación en vivo por ciclo o cambie a Mensual/De por vida"],
        ["Comisión de mantenimiento de $25", "Cuenta de membresía gratuita financiada inactiva ~90 días", "Opere ocasionalmente o retire fondos y cierre la cuenta inactiva"],
        ["Comisión aplicada tras un mes de solo iniciar sesión", "La actividad de sesión no cuenta; se requiere una operación en vivo", "Envíe al menos una orden en vivo antes del siguiente ciclo"],
        ["Comisión aplicada tras operar solo en modo simulado", "Las ejecuciones simuladas no reinician la ventana de actividad en vivo", "Realice una operación en vivo (financiada), no solo una operación de demostración"],
        ["Cargos recurrentes de $35 cada mes tranquilo", "El plan gratuito no se ajusta a un volumen de operaciones bajo", "Cambie a un plan mensual o de por vida con tarifa fija"],
        ["Comisión en una cuenta de evaluación de una prop firm", "La factura la prop firm, no esta comisión minorista", "Consulte las normas de facturación vigentes de su firma"],
      ],
    },
    { type: "heading", text: "Evite esto con PickMyTrade" },
    { type: "paragraph", html: "Si su cuenta queda inactiva porque no siempre puede estar frente a la pantalla para operar, la automatización mantiene la actividad en marcha sin que tenga que vigilar la plataforma. PickMyTrade conecta sus alertas de TradingView directamente con su cuenta de Tradovate, de modo que:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Ejecución en vivo sin intervención manual</strong>, las alertas de su estrategia disparan órdenes reales automáticamente, de modo que las semanas tranquilas en su escritorio no tienen por qué significar un ciclo de facturación sin operaciones.",
        "<strong class='text-white'>Actividad constante</strong>, una estrategia sistemática y siempre activa mantiene la cuenta operando de forma natural dentro de la ventana, en lugar de derivar hacia la inactividad.",
        "<strong class='text-white'>Sincronización multicuenta</strong>, replique la misma actividad en varias cuentas de Tradovate para que ninguna caiga en un estado inactivo sin que se note.",
        "<strong class='text-white'>Registros de operaciones claros</strong>, cada ejecución automatizada queda registrada, lo que facilita demostrar que la cuenta operó dentro de cada ciclo.",
      ],
    },
    { type: "paragraph", html: "La automatización no sustituye la elección del plan adecuado, pero para los operadores que pasan por periodos de inactividad, elimina por completo la causa de &ldquo;se me olvidó operar&rdquo; en las comisiones de inactividad." },
  ], fr: [
    { type: "paragraph", html: "Rien n'agace plus que d'ouvrir son relevé Tradovate et d'y découvrir un prélèvement jamais approuvé, surtout sur le forfait censé être gratuit. Le forfait gratuit (paiement à l'usage) de Tradovate comporte en 2026 deux frais d'activité faciles à manquer : des <strong class='text-white'>frais d'inactivité de $35</strong> lorsqu'un compte au forfait gratuit reste environ 30 jours sans opération en direct, et des <strong class='text-white'>frais de maintenance de $25</strong> lorsqu'un compte d'adhésion gratuite <em>financé</em> reste inactif pendant environ 90 jours. Aucun des deux n'est un bug ni une erreur de facturation. Les deux figurent dans les conditions du forfait gratuit, et les deux sont évitables dès lors que l'on sait exactement ce qui les déclenche. Voici pourquoi ces frais sont prélevés, comment les éviter, et quand il devient simplement plus économique de passer à un forfait mensuel ou à vie." },
    { type: "quote", html: "Les montants et conditions des frais peuvent changer. Les chiffres de $35 et $25 ci-dessous ont été vérifiés par rapport à la documentation publiée par Tradovate sur les frais et les forfaits, mais Tradovate peut réviser son barème à tout moment. Vérifiez toujours les montants actuels dans le barème de frais de votre propre compte avant d'agir." },
    {
      type: "checklist",
      heading: "Liste de vérification rapide des frais du forfait gratuit Tradovate",
      items: [
        "<strong class='text-white'>Êtes-vous sur le forfait gratuit ?</strong> Les frais d'inactivité ne concernent que les comptes gratuits/au paiement à l'usage. Les forfaits mensuel et à vie en sont exonérés.",
        "<strong class='text-white'>Avez-vous passé une opération en direct ce cycle ?</strong> Se connecter ne suffit pas. Faites exécuter au moins une opération <em>en direct</em> dans la fenêtre d'environ 30 jours pour éviter les frais de $35.",
        "<strong class='text-white'>Compte financé mais inactif depuis 90 jours ?</strong> Un compte d'adhésion gratuite financé sans opération au cours des ~90 jours précédents peut se voir appliquer les frais de maintenance distincts de $25.",
        "<strong class='text-white'>Vous ne faites que du paper trading ?</strong> Les exécutions simulées et de démonstration ne comptent généralement pas comme l'activité en direct qui réinitialise le compteur. Vérifiez-le dans votre barème de frais.",
        "<strong class='text-white'>Vous tradez rarement ?</strong> Si vous passez moins d'une poignée d'opérations en direct par mois, comparez le risque récurrent de $35 à un forfait mensuel ou à vie à tarif fixe.",
        "<strong class='text-white'>En évaluation chez une prop firm ?</strong> Les comptes d'évaluation et les comptes prop financés sont facturés par la firme, et non par ces frais Tradovate destinés aux particuliers. Vérifiez les règles en vigueur de votre firme.",
      ],
    },
    { type: "heading", text: "Ce que signifient les « frais d'inactivité de $35 » et les « frais de maintenance de $25 »" },
    { type: "paragraph", html: "Le forfait gratuit de Tradovate <strong class='text-white'>n'a aucun coût d'abonnement mensuel</strong> : vous payez par contrat plutôt qu'une cotisation forfaitaire. Pour que ce modèle reste viable, Tradovate applique deux frais liés à l'activité aux comptes gratuits qui deviennent inactifs." },
    { type: "paragraph", html: "Les <strong class='text-white'>frais d'inactivité de $35</strong> sont ceux que rencontrent le plus de traders. La documentation de Tradovate les associe à un compte au forfait gratuit actif (connecté) pendant la période, mais qui ne passe <em>aucune opération en direct</em> dans une fenêtre d'environ 30 jours ; certains textes de Tradovate décrivent cela comme un mois calendaire. Ils ne sont explicitement <em>pas</em> facturés aux membres mensuels ou à vie. En clair : un mois sans opération sur le forfait gratuit peut vous coûter $35." },
    { type: "paragraph", html: "Les <strong class='text-white'>frais de maintenance de $25</strong> constituent des frais distincts, moins courants. Ils touchent les comptes d'adhésion gratuite <em>financés</em> qui ne passent aucune opération au cours des <strong class='text-white'>90 jours précédents</strong>. Il s'agit de frais d'inactivité sur un horizon plus long, visant les comptes financés laissés à l'abandon, et ils peuvent s'ajouter aux frais d'inactivité plus courts, ou leur succéder, si le compte reste intouché." },
    { type: "paragraph", html: "Le point important à retenir : il s'agit de <strong class='text-white'>frais d'activité, pas de pénalités pour faute</strong>. Tradovate ne signale pas votre compte, l'entreprise applique simplement les conditions du niveau gratuit. Ce qui signifie aussi que la solution est entièrement entre vos mains." },
    { type: "heading", text: "Principales causes de frais inattendus sur le forfait gratuit" },
    { type: "heading", text: "1. Vous êtes sur le forfait gratuit et n'avez rien tradé en direct ce cycle" },
    { type: "paragraph", html: "C'est de loin la cause la plus fréquente des frais de $35. De nombreux traders ouvrent un compte Tradovate gratuit pour essayer la plateforme, connecter des graphiques, observer le DOM, effectuer quelques opérations simulées, puis se déconnectent sans jamais passer d'ordre en direct. Le compte paraît &ldquo;utilisé,&rdquo; mais du point de vue de la facturation, il n'a généré aucune activité en direct, d'où l'application des frais d'inactivité." },
    { type: "heading", text: "2. Vous pensiez que vous connecter suffisait" },
    { type: "paragraph", html: "Une idée reçue fréquente est que le simple fait de se connecter maintient le compte actif. Ce n'est pas le cas. La condition porte sur <strong class='text-white'>le fait de passer une opération en direct</strong>, pas sur l'activité de session. Vous pouvez vous connecter tous les jours pendant un mois et être quand même facturé si vous n'avez jamais envoyé d'ordre en direct." },
    { type: "heading", text: "3. Les opérations simulées/de paper trading ne comptaient pas" },
    { type: "paragraph", html: "S'entraîner dans l'environnement simulé est excellent pour construire une stratégie, mais les exécutions en démo ne satisfont généralement pas à l'exigence d'opération en direct qui réinitialise la fenêtre d'inactivité. Si tout votre mois s'est déroulé en paper trading, le forfait gratuit peut quand même facturer les frais." },
    { type: "heading", text: "4. Un compte financé est resté inactif pendant tout un trimestre" },
    { type: "paragraph", html: "Les frais de maintenance de $25 sont déclenchés par une plus longue période d'inactivité totale, environ 90 jours sans opération sur un compte d'adhésion gratuite financé. Les traders qui financent un compte, s'absentent une saison, puis l'oublient en sont les candidats habituels." },
    { type: "heading", text: "5. Votre volume de trading ne justifie pas le forfait gratuit" },
    { type: "paragraph", html: "Le forfait gratuit avantage les traders à haute fréquence qui paient volontiers par contrat et ne risquent jamais l'inactivité. Pour les traders occasionnels ou saisonniers, en revanche, l'exposition récurrente de $35 peut discrètement dépasser le coût qu'aurait représenté un forfait mensuel à tarif fixe, ce qui signifie que le forfait &ldquo;gratuit&rdquo; ne correspond pas à vos habitudes." },
    { type: "heading", text: "Comment corriger et éviter les frais du forfait gratuit : étape par étape" },
    { type: "heading", text: "Corriger les causes 1 à 3 : passez une opération en direct dans la fenêtre" },
    { type: "paragraph", html: "Le moyen le plus simple d'annuler les frais d'inactivité de $35 est de vous assurer qu'au moins une opération <strong class='text-white'>en direct</strong> soit exécutée à chaque cycle." },
    {
      type: "list",
      items: [
        "Financez votre compte Tradovate : une opération en direct nécessite un compte en direct et financé.",
        "Ouvrez le SuperDOM, le graphique ou le ticket d'ordre d'un instrument liquide.",
        "Passez un petit ordre en direct, par exemple un seul micro-contrat, et laissez-le s'exécuter.",
        "Vous pouvez éventuellement le refermer aussitôt. L'essentiel est une véritable exécution en direct, qui réinitialise la fenêtre d'activité.",
        "Notez la date et programmez un rappel récurrent avant la prochaine échéance d'environ 30 jours.",
      ],
    },
    { type: "paragraph", html: "Un aller-retour sur un seul micro-contrat ne coûte que sa commission et d'éventuels frais de bourse, bien moins que des frais d'inactivité de $35, ce qui en fait une assurance peu coûteuse pour les mois où vous savez que vous serez loin de votre bureau." },
    { type: "heading", text: "Corriger la cause 4 : tradez ou fermez un compte financé inactif" },
    { type: "paragraph", html: "Vous avez un compte d'adhésion gratuite financé que vous n'utilisez pas ? Deux options s'offrent à vous : passer une opération en direct occasionnelle pour rester dans la fenêtre de maintenance d'environ 90 jours, ou, si vous en avez vraiment terminé, retirer votre solde et fermer le compte afin qu'il ne puisse plus accumuler de frais de maintenance. Laisser un compte financé totalement inactif est précisément ce qui déclenche les frais de $25." },
    { type: "heading", text: "Corriger la cause 5 : passez au forfait mensuel ou à vie pour supprimer totalement les frais" },
    { type: "paragraph", html: "La solution permanente contre les frais d'inactivité consiste à quitter le forfait gratuit. <strong class='text-white'>Les forfaits mensuel et à vie ne sont pas soumis aux frais d'inactivité</strong>, et ils offrent des commissions par contrat plus basses, si bien que les traders actifs en sortent souvent gagnants de toute façon." },
    {
      type: "list",
      items: [
        "Ouvrez les paramètres d'adhésion/de forfait de votre compte Tradovate.",
        "Comparez côte à côte les niveaux Gratuit, Mensuel et À vie, commissions et éventuels frais fixes compris.",
        "Estimez votre volume mensuel réaliste d'opérations en direct.",
        "Si vous tradez régulièrement, choisissez Mensuel ou À vie. Le tarif fixe supprime le risque d'inactivité et réduit les commissions.",
        "Si vous tradez rarement, conservez le forfait gratuit, mais planifiez une opération en direct mensuelle.",
      ],
    },
    { type: "heading", text: "Tableau de dépannage" },
    {
      type: "table",
      headers: ["Frais / symptôme", "Ce que cela signifie", "Solution"],
      rows: [
        ["Frais d'inactivité de $35", "Forfait gratuit, aucune opération en direct dans la fenêtre d'~30 jours", "Passez une opération en direct par cycle, ou passez au forfait Mensuel/À vie"],
        ["Frais de maintenance de $25", "Compte d'adhésion gratuite financé inactif depuis ~90 jours", "Tradez occasionnellement, ou retirez les fonds et fermez le compte inactif"],
        ["Frais prélevés après un mois de simples connexions", "L'activité de session ne compte pas ; une opération en direct est requise", "Envoyez au moins un ordre en direct avant le prochain cycle"],
        ["Frais prélevés après du paper trading uniquement", "Les exécutions simulées ne réinitialisent pas la fenêtre d'activité en direct", "Passez une opération en direct (financée), pas seulement une opération de démonstration"],
        ["Frais récurrents de $35 chaque mois calme", "Le forfait gratuit ne correspond pas à un faible volume de trading", "Passez à un forfait Mensuel ou À vie à tarif fixe"],
        ["Frais sur un compte d'évaluation de prop firm", "Facturés par la prop firm, pas par ces frais destinés aux particuliers", "Vérifiez les règles de facturation en vigueur de votre firme"],
      ],
    },
    { type: "heading", text: "Évitez cela avec PickMyTrade" },
    { type: "paragraph", html: "Si votre compte devient inactif parce que vous ne pouvez pas toujours être devant l'écran pour trader, l'automatisation maintient l'activité sans que vous ayez à surveiller la plateforme en permanence. PickMyTrade relie directement vos alertes TradingView à votre compte Tradovate, ce qui vous permet de bénéficier de :" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Exécution en direct sans intervention</strong>, les alertes de votre stratégie déclenchent automatiquement de vrais ordres, si bien qu'une semaine calme loin de votre bureau ne se traduit pas forcément par un cycle de facturation sans opération.",
        "<strong class='text-white'>Activité constante</strong>, une stratégie systématique et toujours active maintient naturellement le compte en activité dans la fenêtre, au lieu de dériver vers l'inactivité.",
        "<strong class='text-white'>Synchronisation multi-comptes</strong>, reproduisez la même activité sur plusieurs comptes Tradovate afin qu'aucun ne bascule dans un état inactif sans que vous vous en aperceviez.",
        "<strong class='text-white'>Historique de trading clair</strong>, chaque exécution automatisée est enregistrée, ce qui facilite la preuve que le compte a tradé au cours de chaque cycle.",
      ],
    },
    { type: "paragraph", html: "L'automatisation ne remplace pas le choix du bon forfait, mais pour les traders qui connaissent des périodes d'inactivité, elle élimine entièrement la cause &ldquo;j'ai oublié de trader&rdquo; des frais d'inactivité." },
  ], it: [
    { type: "paragraph", html: "Niente dà più fastidio che aprire l'estratto conto Tradovate e trovare un addebito mai autorizzato, soprattutto sul piano che dovrebbe essere gratuito. Il piano gratuito (a consumo) di Tradovate include nel 2026 due commissioni di attività facili da non notare: una <strong class='text-white'>commissione di inattività di $35</strong> quando un conto del piano gratuito resta circa 30 giorni senza un'operazione live, e una <strong class='text-white'>commissione di manutenzione di $25</strong> quando un conto di membership gratuita <em>finanziato</em> resta inattivo per circa 90 giorni. Nessuna delle due è un bug né un errore di fatturazione. Entrambe sono previste nei termini del piano gratuito, ed entrambe si possono evitare una volta compreso esattamente cosa le attiva. Ecco perché queste commissioni vengono addebitate, come evitarle e quando conviene semplicemente passare a un piano mensile o a vita." },
    { type: "quote", html: "Gli importi e le condizioni delle commissioni possono cambiare. Le cifre di $35 e $25 riportate di seguito sono state verificate rispetto alla documentazione ufficiale di Tradovate su commissioni e piani, ma Tradovate può rivedere il proprio listino in qualsiasi momento. Verificate sempre gli importi attuali nel listino commissioni del vostro conto prima di agire." },
    {
      type: "checklist",
      heading: "Checklist rapida per le commissioni del piano gratuito Tradovate",
      items: [
        "<strong class='text-white'>Siete sul piano gratuito?</strong> La commissione di inattività riguarda solo i conti gratuiti/a consumo. I piani mensile e a vita ne sono esenti.",
        "<strong class='text-white'>Avete effettuato un'operazione live in questo ciclo?</strong> Accedere non basta. Fate eseguire almeno un'operazione <em>live</em> entro la finestra di circa 30 giorni per evitare l'addebito di $35.",
        "<strong class='text-white'>Conto finanziato ma inattivo da 90 giorni?</strong> Un conto di membership gratuita finanziato senza operazioni negli ~90 giorni precedenti può ricevere la commissione di manutenzione separata di $25.",
        "<strong class='text-white'>Fate solo paper trading?</strong> Le esecuzioni simulate e demo generalmente non contano come l'attività live che azzera il conteggio. Verificatelo nel vostro listino commissioni.",
        "<strong class='text-white'>Fate trading raramente?</strong> Se effettuate meno di una manciata di operazioni live al mese, valutate il rischio ricorrente di $35 rispetto a un piano mensile o a vita a tariffa fissa.",
        "<strong class='text-white'>Siete in una valutazione con una prop firm?</strong> I conti di valutazione e i conti prop finanziati vengono fatturati dalla firm, non da questa commissione retail di Tradovate. Verificate le regole attuali della vostra firm.",
      ],
    },
    { type: "heading", text: "Cosa significano la «commissione di inattività da $35» e la «commissione di manutenzione da $25»" },
    { type: "paragraph", html: "Il piano gratuito di Tradovate <strong class='text-white'>non prevede costi di abbonamento mensile</strong>, si paga per contratto anziché una quota di membership fissa. Per mantenere sostenibile questo modello, Tradovate applica due addebiti basati sull'attività ai conti gratuiti che diventano inattivi." },
    { type: "paragraph", html: "La <strong class='text-white'>commissione di inattività di $35</strong> è quella in cui incorrono più spesso i trader. La documentazione dei piani Tradovate la collega a un conto del piano gratuito attivo (con accesso effettuato) durante il periodo, ma che non effettua <em>alcuna operazione live</em> entro una finestra di circa 30 giorni; alcuni testi di Tradovate la descrivono come un mese di calendario. Non viene esplicitamente addebitata ai membri mensili o a vita. In parole semplici: un mese senza operazioni sul piano gratuito può costarvi $35." },
    { type: "paragraph", html: "La <strong class='text-white'>commissione di manutenzione di $25</strong> è un addebito separato e meno frequente. Colpisce i conti di membership gratuita <em>finanziati</em> che non effettuano operazioni nei <strong class='text-white'>90 giorni precedenti</strong>. Si tratta di un addebito per inattività su un orizzonte più lungo, rivolto ai conti finanziati lasciati inattivi, e può sommarsi alla commissione di inattività più breve, o seguirla, se il conto resta inutilizzato." },
    { type: "paragraph", html: "Il modello mentale importante è questo: si tratta di <strong class='text-white'>commissioni per attività, non penalità per comportamenti scorretti</strong>. Tradovate non sta segnalando il vostro conto, sta semplicemente applicando i termini del livello gratuito. Il che significa anche che la soluzione è interamente nelle vostre mani." },
    { type: "heading", text: "Le principali cause delle commissioni impreviste sul piano gratuito" },
    { type: "heading", text: "1. Siete sul piano gratuito e non avete fatto trading live in questo ciclo" },
    { type: "paragraph", html: "Questa è di gran lunga la causa più comune della commissione di $35. Molti trader aprono un conto Tradovate gratuito per provarlo, collegare i grafici, osservare il DOM, effettuare alcune operazioni simulate, per poi disconnettersi senza mai inviare un ordine live. Il conto sembra &ldquo;utilizzato,&rdquo; ma dal punto di vista della fatturazione non ha generato alcuna attività live, quindi la commissione di inattività viene applicata." },
    { type: "heading", text: "2. Avete dato per scontato che accedere fosse sufficiente" },
    { type: "paragraph", html: "Un equivoco frequente è pensare che il solo accesso mantenga il conto attivo. Non è così. La condizione riguarda <strong class='text-white'>l'esecuzione di un'operazione live</strong>, non l'attività della sessione. Potete accedere ogni giorno per un mese intero ed essere comunque addebitati se non avete mai inviato un ordine live." },
    { type: "heading", text: "3. Le operazioni simulate/di paper trading non sono state conteggiate" },
    { type: "paragraph", html: "Fare pratica nell'ambiente simulato è ottimo per costruire una strategia, ma le esecuzioni demo generalmente non soddisfano il requisito dell'operazione live che azzera la finestra di inattività. Se l'intero mese è stato di paper trading, il piano gratuito può comunque addebitare la commissione." },
    { type: "heading", text: "4. Un conto finanziato è rimasto inattivo per un intero trimestre" },
    { type: "paragraph", html: "La commissione di manutenzione di $25 viene attivata da un periodo più lungo di totale inattività, circa 90 giorni senza operazioni su un conto di membership gratuita finanziato. I trader che finanziano un conto, si allontanano per una stagione e se ne dimenticano sono i candidati tipici." },
    { type: "heading", text: "5. Il vostro volume di trading non giustifica il piano gratuito" },
    { type: "paragraph", html: "Il piano gratuito conviene ai trader ad alta frequenza che pagano volentieri per contratto e non rischiano mai l'inattività. Per i trader occasionali o stagionali, invece, l'esposizione ricorrente di $35 può superare silenziosamente quanto sarebbe costato un piano mensile a tariffa fissa, il che significa che il piano &ldquo;gratuito&rdquo; è quello sbagliato per le vostre abitudini." },
    { type: "heading", text: "Come correggere ed evitare le commissioni del piano gratuito: passo dopo passo" },
    { type: "heading", text: "Correggere le cause 1-3: effettuate un'operazione live entro la finestra" },
    { type: "paragraph", html: "Il modo più pulito per azzerare la commissione di inattività di $35 è assicurarsi che almeno un'operazione <strong class='text-white'>live</strong> venga eseguita in ogni ciclo." },
    {
      type: "list",
      items: [
        "Finanziate il vostro conto Tradovate: un'operazione live richiede un conto live e finanziato.",
        "Aprite il SuperDOM, il grafico o il ticket d'ordine per uno strumento liquido.",
        "Inviate un piccolo ordine live, ad esempio un singolo micro contratto, e lasciatelo eseguire.",
        "Facoltativamente chiudetelo subito dopo. Ciò che conta è un'esecuzione live reale, che azzera la finestra di attività.",
        "Annotate la data e impostate un promemoria ricorrente prima della successiva scadenza di ~30 giorni.",
      ],
    },
    { type: "paragraph", html: "Un'operazione di andata e ritorno su un singolo micro contratto costa solo la relativa commissione ed eventuali costi di borsa, molto meno di una commissione di inattività di $35, quindi è un'assicurazione economica per i mesi in cui sapete che sarete lontani dalla scrivania." },
    { type: "heading", text: "Correggere la causa 4: fate trading o chiudete un conto finanziato inattivo" },
    { type: "paragraph", html: "Avete un conto di membership gratuita finanziato che non state usando? Avete due opzioni: effettuare un'operazione live occasionale per restare entro la finestra di manutenzione di ~90 giorni, oppure, se avete davvero finito con esso, prelevare il saldo e chiudere il conto in modo che non possa più accumulare commissioni di manutenzione. Lasciare un conto finanziato completamente inattivo è esattamente ciò che provoca la commissione di $25." },
    { type: "heading", text: "Correggere la causa 5: passate al piano mensile o a vita per eliminare del tutto la commissione" },
    { type: "paragraph", html: "La soluzione permanente contro le commissioni di inattività è abbandonare il piano gratuito. <strong class='text-white'>I piani mensile e a vita non sono soggetti alla commissione di inattività</strong>, e prevedono commissioni per contratto più basse, quindi i trader attivi ne escono spesso avvantaggiati comunque." },
    {
      type: "list",
      items: [
        "Aprite le impostazioni di membership/piano del vostro conto Tradovate.",
        "Confrontate fianco a fianco i livelli Gratuito, Mensile e A vita, commissioni più eventuale tariffa fissa.",
        "Stimate il vostro volume mensile realistico di operazioni live.",
        "Se fate trading regolarmente, scegliete Mensile o A vita. La tariffa fissa elimina il rischio di inattività e riduce le commissioni.",
        "Se fate trading raramente, mantenete il piano gratuito, ma programmate un'operazione live mensile.",
      ],
    },
    { type: "heading", text: "Tabella di risoluzione dei problemi" },
    {
