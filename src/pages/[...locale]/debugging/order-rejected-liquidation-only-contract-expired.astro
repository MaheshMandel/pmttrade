---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "order-rejected-liquidation-only-contract-expired";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/debugging/${SLUG}`;

const META_TITLE = "Tradovate 'Liquidation Only, Contract About to Expire'";
const META_DESCRIPTION =
  "Tradovate 'liquidation only, contract about to expire'? Roll forward to the active front-month contract to place new orders again, quick fix inside.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Tradovate: „Liquidation Only, Contract About to Expire“", es: "Tradovate: error «Liquidation Only, Contract About to Expire»", fr: "Tradovate : « Liquidation Only, Contract About to Expire »", it: "Tradovate: errore «Liquidation Only, Contract About to Expire»" },
  dek: { en: "New orders bounce with \"Liquidation Only. Contract is about to be expired.\" You don't need the Trade Desk, you need to roll to the current front-month contract.", de: "Neue Orders werden mit „Liquidation Only. Contract is about to be expired.“ abgelehnt. Sie brauchen nicht den Trade Desk, sondern müssen auf den aktuellen Front-Month-Kontrakt rollen.", es: "Las nuevas órdenes rebotan con «Liquidation Only. Contract is about to be expired.» No necesita el Trade Desk, necesita pasar al contrato vigente del mes cercano.", fr: "Les nouveaux ordres sont rejetés avec « Liquidation Only. Contract is about to be expired. » Vous n'avez pas besoin du Trade Desk, vous devez passer au contrat du mois en cours.", it: "I nuovi ordini vengono respinti con «Liquidation Only. Contract is about to be expired.» Non Le serve il Trade Desk, Le serve passare al contratto front-month attuale." },
  readTime: { en: "7 min read", de: "7 Min. Lesezeit", es: "Lectura de 7 min", fr: "Lecture : 7 min", it: "Lettura di 7 min" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "You line up an entry on NQ or ES, hit send, and Tradovate throws it back at you: <em>&ldquo;Liquidation Only. Contract is about to be expired. Please contact the Trade Desk.&rdquo;</em> You can still close whatever you're holding, but every new order dies the moment it hits submit. Here's the good news the wording hides, you almost never need to call anybody. The contract you're pointing at has slipped into its expiration window, so Tradovate has flipped it to liquidation-only, meaning close-only. Automated traders get burned by this the most, because a TradingView alert built on a continuous symbol like <strong class='text-white'>NQ1!</strong> or <strong class='text-white'>ES1!</strong> will happily keep firing into an expiring contract long after the volume has rolled to the next month. Below we'll walk through what the message actually means, why it shows up, and how to roll forward to the live front-month contract so your orders fill again, plus how PickMyTrade stops an expiring contract from quietly killing your automation." },
    {
      type: "checklist",
      heading: "Quick Checklist for the Liquidation-Only Expiring-Contract Rejection",
      items: [
        "<strong class='text-white'>Roll to the active front-month contract</strong>, swap out the expiring month (say an <code>H</code> March contract during roll week) for the current one before you re-enter.",
        "<strong class='text-white'>Stop trading continuous symbols</strong>, <code>NQ1!</code>, <code>ES1!</code>, and <code>GC1!</code> auto-roll on TradingView charts, but the order that lands at the broker can still hit an expiring contract.",
        "<strong class='text-white'>Recreate any TradingView alert on the new contract</strong>, editing the ticker alone often isn't enough. Delete the old alert and re-add it on the current contract chart.",
        "<strong class='text-white'>Confirm you're only being allowed to close</strong>, liquidation-only lets you flatten an open position but blocks every new entry.",
        "<strong class='text-white'>Check the roll calendar</strong>, equity index futures expire the third Friday of March, June, September and December; energy and metals roll on their own schedules.",
        "<strong class='text-white'>You usually don't need the Trade Desk</strong>, despite the message, switching to the current contract clears the rejection by itself.",
      ],
    },
    { type: "heading", text: "What \"Liquidation Only. Contract Is About to Be Expired\" Means" },
    { type: "paragraph", html: "Every futures contract has a hard expiration date, and it stops trading like a normal instrument as that date closes in. To keep traders from getting caught holding a contract into settlement or delivery, Tradovate restricts any contract inside its expiration window to <strong class='text-white'>liquidation only</strong>, you can reduce or close an existing position, but you can't open a new one. Submit a fresh entry on that contract and it bounces with <em>&ldquo;Liquidation Only. Contract is about to be expired. Please contact the Trade Desk.&rdquo;</em>" },
    { type: "paragraph", html: "The part to lock in your head: this is a <strong class='text-white'>per-contract</strong> state, not an account-wide lock. Your account is fine. The one contract month you're aimed at, a June contract living out its last days, for instance, is the thing that's closed to new business. Point your order at the next live month and it fills like normal. That's what makes this rejection completely different from a Risk-Settings liquidation-only lock, which flattens your whole account after a loss limit, or a prop-firm drawdown breach." },
    { type: "paragraph", html: "The &ldquo;contact the Trade Desk&rdquo; line scares people into thinking their account is broken. In reality the trade desk would just tell you the contract has rolled and you need to trade the current front month, something you can do yourself in about ten seconds. The one exception: if you're already holding a position in the expiring contract and can't get flat, reaching out to Tradovate (or your prop firm) to be flattened is a fair move." },
    { type: "heading", text: "Top Causes of the Expiring-Contract Rejection in 2026" },
    { type: "heading", text: "1. You're Trading a Contract That Has Entered Its Expiration Window" },
    { type: "paragraph", html: "The most literal cause: the contract month you picked is at or near its last trading day. Equity index futures (ES, NQ, YM, RTY) expire on the <strong class='text-white'>third Friday of March, June, September and December</strong>, and liquidity jumps to the next month roughly a week before that, the informal &ldquo;rollover Thursday&rdquo; you'll hear traders talk about. Trade the old month inside that window and you'll hit liquidation-only even though the symbol technically still exists." },
    { type: "heading", text: "2. A Continuous Symbol (NQ1! / ES1!) Routed to an Expiring Contract" },
    { type: "paragraph", html: "TradingView shows you a <strong class='text-white'>continuous</strong> or &ldquo;front-month&rdquo; symbol, <code>NQ1!</code>, <code>ES1!</code>, <code>GC1!</code>, that stitches contracts together so the chart never gaps. Great for analysis, but that continuous symbol isn't itself a tradable contract at the broker. When an order or alert built on <code>NQ1!</code> routes to Tradovate, it has to resolve to a real dated contract. If the platform's roll logic and your chart's roll logic disagree by even a day or two, the resolved contract can be the <em>expiring</em> one, and Tradovate rejects it as liquidation-only." },
    { type: "heading", text: "3. A TradingView Alert Still Points at the Old Contract Month" },
    { type: "paragraph", html: "Automated setups are the worst repeat offenders. You built an alert weeks ago on a dated contract (or a continuous symbol), the market rolled, and the alert kept firing into the now-expiring month. Alerts run server-side on TradingView and have no idea the contract rolled, so they keep pumping entries into a dead contract until you update them. That's exactly why this rejection so often blindsides a strategy that ran flawlessly the week before." },
    { type: "heading", text: "4. You Rolled the Chart but Not the Open Order or Position" },
    { type: "paragraph", html: "Rolling a chart module forward changes what you're <em>looking at</em>, it does <strong class='text-white'>not</strong> move an open position or a resting order to the new contract. Roll the chart, assume everything followed, and you get caught when a fresh entry works but an older working order still sits on the expiring month and gets rejected against it." },
    { type: "heading", text: "5. Prop-Firm or Session Rules Tighten Things Near Expiry" },
    { type: "paragraph", html: "On evaluation and funded accounts, the prop firm, not you, controls a lot of the account's behavior around roll and session close. Some firms force positions flat before the daily close and around expiration, which stacks right on top of Tradovate's own liquidation-only state. The exact rules vary by firm and account size, so check your firm's current rulebook rather than assuming Tradovate's defaults apply." },
    { type: "heading", text: "How to Fix the Liquidation-Only Expiring-Contract Rejection: Step-by-Step" },
    { type: "heading", text: "Fixing the Contract: Roll Forward to the Front Month in Tradovate" },
    { type: "paragraph", html: "The core fix is to stop trading the expiring month and switch to the current front-month contract." },
    {
      type: "steps",
      items: [
        { title: "Identify the current front month", html: "Tradovate's symbol format is the instrument code + month code + year digit(s), for example, <code>ESZ4</code> is the December 2024 E-mini S&amp;P. The quarterly month codes for equity indexes are <strong class='text-white'>H (March), M (June), U (September), Z (December)</strong>." },
        { title: "Change the symbol to the current contract", html: "In the Chart, SuperDOM, or watchlist module, change the symbol to the current contract. You can right-click the quote or symbol to roll it forward or backward to a different month, or use the module's view settings to <strong class='text-white'>Roll Forward</strong> to the next contract." },
        { title: "Close the old position first", html: "If you're holding a position in the expiring contract, <strong class='text-white'>close it first</strong> (liquidation-only still allows closing), then re-enter on the new contract, rolling the chart won't move your position for you." },
        { title: "Adjust stops and targets", html: "There's usually a small price gap (&ldquo;basis&rdquo;) between the old and new contract, so levels that were valid on the expiring month need to be re-set on the new one." },
        { title: "Submit a fresh order", html: "Submit on the current contract. It should now go through instead of getting rejected as liquidation-only." },
      ],
    },
    { type: "heading", text: "Fixing the TradingView Alert (Automation Users)" },
    { type: "paragraph", html: "If the rejection is coming from a TradingView alert or webhook, updating the chart alone won't stop it, the alert keeps its own symbol." },
    {
      type: "steps",
      items: [
        { title: "Read the alert's current ticker", html: "Open the chart the alert is attached to and read its current ticker. If it's a continuous symbol like <code>NQ1!</code> or a stale dated contract, that's your culprit." },
        { title: "Switch to the current dated contract", html: "Switch the chart to the <strong class='text-white'>current dated contract</strong> (the live front month) instead of the continuous symbol, so what fires matches what Tradovate can actually trade." },
        { title: "Delete and recreate the alert", html: "<strong class='text-white'>Delete the old alert</strong> and create a new one on the updated contract chart. Editing the ticker in place is unreliable, so a clean delete-and-recreate is the safe route." },
        { title: "Confirm the new alert is active", html: "Confirm the new alert is active and that its message or webhook payload references the current contract, not the expired one." },
        { title: "Test the alert", html: "Fire a test alert (or wait for the next signal) and check Tradovate's Orders module to confirm the order is now accepted." },
      ],
    },
    { type: "heading", text: "If You're Still Holding the Expiring Contract" },
    { type: "paragraph", html: "Liquidation-only never blocks you from closing. If you can't get flat, a frozen order, a data drop, close with a manual opposite market order, and only if that fails contact Tradovate (self-funded) or your prop firm (evaluation/funded) to be flattened. Don't sit there hammering rejected new entries; they won't go through, and all they do is clutter your order log." },
    { type: "heading", text: "Troubleshooting Table" },
    {
      type: "table",
      headers: ["Message / State", "Meaning", "Fix"],
      rows: [
        ["&ldquo;Liquidation Only. Contract is about to be expired. Please contact the Trade Desk.&rdquo;", "The contract you're trading has entered its expiration window and only allows closing", "Roll to the current front-month contract and re-enter there"],
        ["New orders rejected but you can still close", "Per-contract liquidation-only, not an account lock", "Switch the order to the live front month; the account itself is fine"],
        ["Alert kept firing after a working week", "TradingView alert still points at the rolled/continuous symbol", "Delete and recreate the alert on the current dated contract"],
        ["<code>NQ1!</code> / <code>ES1!</code> order rejected on Tradovate", "Continuous symbol resolved to an expiring contract at the broker", "Trade the dated front-month contract (e.g. the current <code>M</code>/<code>U</code>/<code>Z</code> month) instead"],
        ["New chart works, old order still rejects", "You rolled the chart but not the resting order/position", "Cancel/close on the old contract, re-place on the new one"],
        ["Can't flatten the expiring position", "Frozen order or data drop during roll", "Send a manual opposite market order; contact support/prop firm if it won't close"],
        ["Prop account flat-forced near expiry", "Firm rules override around roll and session close", "Check your firm's current rollover/flat rules, they vary by firm"],
      ],
    },
    { type: "heading", text: "Prevent This with PickMyTrade" },
    { type: "paragraph", html: "Expiring-contract rejections are almost always a <em>symbol-hygiene</em> problem: your automation is aimed at a continuous or stale contract while the live front month has already moved on. PickMyTrade links your TradingView alerts straight to Tradovate and adds a validation layer so a rolled contract doesn't quietly break your strategy:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Symbol &amp; Contract Validation</strong>, checks the routed symbol before the order goes out, so alerts on a continuous or expiring contract get caught instead of bounced by the broker.",
        "<strong class='text-white'>Rejection-Safe Routing</strong>, when a contract is in liquidation-only, PickMyTrade isn't blindly retrying dead entries into your order log; you route cleanly once you're on the valid month.",
        "<strong class='text-white'>Entitlement &amp; Risk Filters</strong>, respects prop-firm limits and data-agreement state, so orders that would fail for account reasons don't pile up alongside the roll problem.",
        "<strong class='text-white'>Multi-Account Sync</strong>, when you roll to the new front month, the corrected order mirrors across every connected Tradovate account at once, so no single account is left trading the expired month.",
      ],
    },
    { type: "paragraph", html: "The goal is simple: never lose a session to a contract that rolled while you weren't looking." },
  ], de: [
    { type: "paragraph",html: "Sie legen einen Einstieg auf NQ oder ES an, klicken auf Senden, und Tradovate wirft ihn zurück: <em>&ldquo;Liquidation Only. Contract is about to be expired. Please contact the Trade Desk.&rdquo;</em> Sie können alles, was Sie halten, weiterhin schließen, aber jede neue Order stirbt in dem Moment, in dem Sie sie absenden. Hier die gute Nachricht, die der Wortlaut verbirgt: Sie müssen fast nie jemanden anrufen. Der Kontrakt, auf den Sie zielen, ist in sein Verfallsfenster gerutscht, daher hat Tradovate ihn auf Liquidation Only gestellt, also nur Schließen. Automatisierte Trader trifft es am häufigsten, denn ein TradingView-Alert auf Basis eines fortlaufenden Symbols wie <strong class='text-white'>NQ1!</strong> oder <strong class='text-white'>ES1!</strong> feuert fröhlich weiter in einen auslaufenden Kontrakt, lange nachdem das Volumen auf den nächsten Monat gerollt ist. Im Folgenden zeigen wir, was die Meldung tatsächlich bedeutet, warum sie auftaucht und wie Sie auf den aktiven Front-Month-Kontrakt vorrollen, damit Ihre Orders wieder ausgeführt werden, und wie PickMyTrade verhindert, dass ein auslaufender Kontrakt Ihre Automatisierung unbemerkt lahmlegt." },
    {
      type: "checklist",
      heading: "Kurz-Checkliste für die Liquidation-Only-Ablehnung bei auslaufendem Kontrakt",
      items: [
        "<strong class='text-white'>Auf den aktiven Front-Month-Kontrakt rollen</strong>, tauschen Sie den auslaufenden Monat (etwa einen <code>H</code>-Kontrakt für März in der Roll-Woche) gegen den aktuellen aus, bevor Sie neu einsteigen.",
        "<strong class='text-white'>Handeln Sie keine fortlaufenden Symbole</strong>, <code>NQ1!</code>, <code>ES1!</code> und <code>GC1!</code> rollen in TradingView-Charts automatisch, doch die Order, die beim Broker ankommt, kann dennoch einen auslaufenden Kontrakt treffen.",
        "<strong class='text-white'>Erstellen Sie jeden TradingView-Alert auf dem neuen Kontrakt neu</strong>, das bloße Ändern des Tickers reicht oft nicht. Löschen Sie den alten Alert und legen Sie ihn im Chart des aktuellen Kontrakts neu an.",
        "<strong class='text-white'>Bestätigen Sie, dass nur das Schließen erlaubt ist</strong>, Liquidation Only erlaubt das Glattstellen einer offenen Position, blockiert aber jeden neuen Einstieg.",
        "<strong class='text-white'>Prüfen Sie den Roll-Kalender</strong>, Aktienindex-Futures verfallen am dritten Freitag im März, Juni, September und Dezember; Energie und Metalle rollen nach eigenen Zeitplänen.",
        "<strong class='text-white'>Den Trade Desk brauchen Sie in der Regel nicht</strong>, trotz der Meldung behebt der Wechsel auf den aktuellen Kontrakt die Ablehnung von selbst.",
      ],
    },
    { type: "heading",text: "Was „Liquidation Only. Contract Is About to Be Expired“ bedeutet" },
    { type: "paragraph",html: "Jeder Futures-Kontrakt hat ein festes Verfallsdatum und wird mit dessen Näherrücken nicht mehr wie ein normales Instrument gehandelt. Damit Trader nicht mit einem Kontrakt in die Abrechnung oder Lieferung geraten, beschränkt Tradovate jeden Kontrakt innerhalb seines Verfallsfensters auf <strong class='text-white'>Liquidation Only</strong>, Sie können eine bestehende Position reduzieren oder schließen, aber keine neue eröffnen. Senden Sie einen frischen Einstieg in diesen Kontrakt, wird er mit <em>&ldquo;Liquidation Only. Contract is about to be expired. Please contact the Trade Desk.&rdquo;</em> zurückgewiesen." },
    { type: "paragraph",html: "Das sollten Sie sich merken: Dies ist ein Zustand <strong class='text-white'>pro Kontrakt</strong>, keine Sperre des ganzen Kontos. Ihr Konto ist in Ordnung. Der eine Kontraktmonat, auf den Sie zielen, etwa ein Juni-Kontrakt in seinen letzten Tagen, ist für neue Geschäfte geschlossen. Richten Sie die Order auf den nächsten aktiven Monat, wird sie normal ausgeführt. Genau das unterscheidet diese Ablehnung von einer Liquidation-Only-Sperre über die Risk Settings, die Ihr ganzes Konto nach einem Verlustlimit glattstellt, oder von einer Drawdown-Verletzung beim Prop-Firm." },
    { type: "paragraph",html: "Die Zeile &ldquo;contact the Trade Desk&rdquo; schreckt Leute auf und lässt sie glauben, ihr Konto sei kaputt. In Wirklichkeit würde Ihnen der Trade Desk nur sagen, dass der Kontrakt gerollt ist und Sie den aktuellen Front Month handeln müssen, was Sie in etwa zehn Sekunden selbst tun können. Die eine Ausnahme: Wenn Sie bereits eine Position im auslaufenden Kontrakt halten und nicht flat werden können, ist es berechtigt, sich an Tradovate (oder Ihr Prop-Firm) zu wenden, um glattgestellt zu werden." },
    { type: "heading",text: "Hauptursachen der Ablehnung wegen auslaufenden Kontrakts 2026" },
    { type: "heading",text: "1. Sie handeln einen Kontrakt, der in sein Verfallsfenster eingetreten ist" },
    { type: "paragraph",html: "Die wörtlichste Ursache: Der gewählte Kontraktmonat steht an oder kurz vor seinem letzten Handelstag. Aktienindex-Futures (ES, NQ, YM, RTY) verfallen am <strong class='text-white'>dritten Freitag im März, Juni, September und Dezember</strong>, und die Liquidität springt etwa eine Woche zuvor auf den nächsten Monat, der informelle &ldquo;Rollover Thursday&rdquo;, von dem Trader sprechen. Handeln Sie den alten Monat innerhalb dieses Fensters, landen Sie in Liquidation Only, obwohl das Symbol technisch noch existiert." },
    { type: "heading",text: "2. Ein fortlaufendes Symbol (NQ1! / ES1!) wurde auf einen auslaufenden Kontrakt geroutet" },
    { type: "paragraph",html: "TradingView zeigt Ihnen ein <strong class='text-white'>fortlaufendes</strong> bzw. &ldquo;Front-Month&rdquo;-Symbol, <code>NQ1!</code>, <code>ES1!</code>, <code>GC1!</code>, das Kontrakte aneinanderfügt, damit der Chart keine Lücken hat. Gut für die Analyse, aber dieses fortlaufende Symbol ist beim Broker selbst kein handelbarer Kontrakt. Wenn eine auf <code>NQ1!</code> basierende Order oder ein Alert an Tradovate geroutet wird, muss sie auf einen realen Kontrakt mit Fälligkeitsdatum aufgelöst werden. Weichen die Roll-Logik der Plattform und die Ihres Charts auch nur um ein oder zwei Tage voneinander ab, kann der aufgelöste Kontrakt der <em>auslaufende</em> sein, und Tradovate lehnt ihn als Liquidation Only ab." },
    { type: "heading",text: "3. Ein TradingView-Alert zeigt noch auf den alten Kontraktmonat" },
    { type: "paragraph",html: "Automatisierte Setups sind die schlimmsten Wiederholungstäter. Sie haben den Alert vor Wochen auf einem Kontrakt mit Fälligkeitsdatum (oder einem fortlaufenden Symbol) angelegt, der Markt hat gerollt, und der Alert feuerte weiter in den nun auslaufenden Monat. Alerts laufen serverseitig bei TradingView und wissen nicht, dass der Kontrakt gerollt ist, sie pumpen also weiter Einstiege in einen toten Kontrakt, bis Sie sie aktualisieren. Genau deshalb trifft diese Ablehnung eine Strategie, die in der Vorwoche einwandfrei lief, so oft unvorbereitet." },
    { type: "heading",text: "4. Sie haben den Chart gerollt, aber nicht die offene Order oder Position" },
    { type: "paragraph",html: "Das Vorrollen eines Chart-Moduls ändert, was Sie <em>ansehen</em>, es verschiebt eine offene Position oder eine wartende Order <strong class='text-white'>nicht</strong> in den neuen Kontrakt. Rollen Sie den Chart und nehmen an, alles sei mitgezogen, werden Sie erwischt, wenn ein frischer Einstieg funktioniert, aber eine ältere aktive Order noch im auslaufenden Monat liegt und dagegen abgelehnt wird." },
    { type: "heading",text: "5. Prop-Firm- oder Sitzungsregeln verschärfen die Lage kurz vor dem Verfall" },
    { type: "paragraph",html: "Bei Evaluierungs- und finanzierten Konten kontrolliert das Prop-Firm, nicht Sie, einen großen Teil des Kontoverhaltens rund um Roll und Sitzungsschluss. Manche Firmen erzwingen Flat-Positionen vor dem täglichen Schluss und um den Verfall, was sich direkt auf den Liquidation-Only-Zustand von Tradovate legt. Die genauen Regeln unterscheiden sich je nach Firma und Kontogröße, prüfen Sie daher das aktuelle Regelwerk Ihrer Firma, statt von den Tradovate-Standards auszugehen." },
    { type: "heading",text: "So beheben Sie die Liquidation-Only-Ablehnung bei auslaufendem Kontrakt: Schritt für Schritt" },
    { type: "heading",text: "Den Kontrakt beheben: In Tradovate auf den Front Month vorrollen" },
    { type: "paragraph",html: "Die Kernlösung besteht darin, den auslaufenden Monat nicht mehr zu handeln und auf den aktuellen Front-Month-Kontrakt zu wechseln." },
    {
      type: "steps",
      items: [
        { title: "Den aktuellen Front Month ermitteln", html: "Das Symbolformat von Tradovate lautet Instrumentenkürzel + Monatscode + Jahresziffer(n), zum Beispiel ist <code>ESZ4</code> der E-mini S&amp;P für Dezember 2024. Die Quartalsmonatscodes für Aktienindizes sind <strong class='text-white'>H (März), M (Juni), U (September), Z (Dezember)</strong>." },
        { title: "Das Symbol auf den aktuellen Kontrakt ändern", html: "Ändern Sie im Modul Chart, SuperDOM oder in der Watchlist das Symbol auf den aktuellen Kontrakt. Sie können mit der rechten Maustaste auf den Kurs oder das Symbol klicken, um vor- oder zurückzurollen, oder in den Ansichtseinstellungen des Moduls <strong class='text-white'>Roll Forward</strong> auf den nächsten Kontrakt wählen." },
        { title: "Die alte Position zuerst schließen", html: "Halten Sie eine Position im auslaufenden Kontrakt, <strong class='text-white'>schließen Sie sie zuerst</strong> (Liquidation Only erlaubt das Schließen weiterhin) und steigen Sie dann im neuen Kontrakt neu ein, das Rollen des Charts verschiebt Ihre Position nicht für Sie." },
        { title: "Stops und Ziele anpassen", html: "Zwischen altem und neuem Kontrakt gibt es meist eine kleine Preislücke (&ldquo;Basis&rdquo;), sodass Niveaus, die im auslaufenden Monat gültig waren, im neuen neu gesetzt werden müssen." },
        { title: "Eine frische Order senden", html: "Senden Sie im aktuellen Kontrakt. Sie sollte nun durchgehen, statt als Liquidation Only abgelehnt zu werden." },
      ],
    },
    { type: "heading",text: "Den TradingView-Alert beheben (Nutzer der Automatisierung)" },
    { type: "paragraph",html: "Kommt die Ablehnung von einem TradingView-Alert oder Webhook, genügt es nicht, nur den Chart zu aktualisieren, der Alert behält sein eigenes Symbol." },
    {
      type: "steps",
      items: [
        { title: "Den aktuellen Ticker des Alerts ablesen", html: "Öffnen Sie den Chart, an den der Alert gebunden ist, und lesen Sie seinen aktuellen Ticker ab. Ist es ein fortlaufendes Symbol wie <code>NQ1!</code> oder ein veralteter Kontrakt mit Fälligkeitsdatum, ist das der Übeltäter." },
        { title: "Auf den aktuellen Kontrakt mit Fälligkeitsdatum wechseln", html: "Wechseln Sie den Chart auf den <strong class='text-white'>aktuellen Kontrakt mit Fälligkeitsdatum</strong> (den aktiven Front Month) statt auf das fortlaufende Symbol, damit das, was feuert, dem entspricht, was Tradovate tatsächlich handeln kann." },
        { title: "Alert löschen und neu erstellen", html: "<strong class='text-white'>Löschen Sie den alten Alert</strong> und erstellen Sie einen neuen im Chart des aktualisierten Kontrakts. Den Ticker an Ort und Stelle zu ändern ist unzuverlässig, daher ist ein sauberes Löschen und Neuanlegen der sichere Weg." },
        { title: "Bestätigen, dass der neue Alert aktiv ist", html: "Bestätigen Sie, dass der neue Alert aktiv ist und dass seine Nachricht bzw. sein Webhook-Payload den aktuellen Kontrakt referenziert, nicht den abgelaufenen." },
        { title: "Den Alert testen", html: "Lösen Sie einen Test-Alert aus (oder warten Sie auf das nächste Signal) und prüfen Sie im Modul Orders von Tradovate, ob die Order nun angenommen wird." },
      ],
    },
    { type: "heading",text: "Wenn Sie den auslaufenden Kontrakt noch halten" },
    { type: "paragraph",html: "Liquidation Only hindert Sie nie am Schließen. Wenn Sie nicht flat werden können, etwa wegen einer hängenden Order oder eines Datenausfalls, schließen Sie mit einer manuellen entgegengesetzten Market-Order, und nur wenn das scheitert, wenden Sie sich an Tradovate (selbstfinanziert) oder Ihr Prop-Firm (Evaluierung/finanziert), um glattgestellt zu werden. Hämmern Sie nicht auf abgelehnte neue Einstiege ein; sie gehen nicht durch und verstopfen nur Ihr Order-Log." },
    { type: "heading",text: "Fehlerbehebungstabelle" },
    { type: "table", headers: ["Meldung / Zustand","Bedeutung","Lösung"], rows: [
      ["&ldquo;Liquidation Only. Contract is about to be expired. Please contact the Trade Desk.&rdquo;","Der gehandelte Kontrakt ist in sein Verfallsfenster eingetreten und erlaubt nur das Schließen","Auf den aktuellen Front-Month-Kontrakt rollen und dort neu einsteigen"],
      ["Neue Orders abgelehnt, aber Schließen weiterhin möglich","Liquidation Only pro Kontrakt, keine Kontosperre","Die Order auf den aktiven Front Month umstellen; das Konto selbst ist in Ordnung"],
      ["Alert feuerte nach einer funktionierenden Woche weiter","Der TradingView-Alert zeigt noch auf das gerollte/fortlaufende Symbol","Den Alert löschen und auf dem aktuellen Kontrakt mit Fälligkeitsdatum neu erstellen"],
      ["<code>NQ1!</code> / <code>ES1!</code>-Order bei Tradovate abgelehnt","Das fortlaufende Symbol wurde beim Broker auf einen auslaufenden Kontrakt aufgelöst","Stattdessen den Front-Month-Kontrakt mit Fälligkeitsdatum handeln (z. B. den aktuellen <code>M</code>/<code>U</code>/<code>Z</code>-Monat)"],
      ["Neuer Chart funktioniert, alte Order wird weiter abgelehnt","Sie haben den Chart gerollt, aber nicht die wartende Order/Position","Im alten Kontrakt stornieren/schließen, im neuen neu platzieren"],
      ["Auslaufende Position lässt sich nicht glattstellen","Hängende Order oder Datenausfall während des Rolls","Eine manuelle entgegengesetzte Market-Order senden; Support/Prop-Firm kontaktieren, wenn sie sich nicht schließen lässt"],
      ["Prop-Konto wird kurz vor Verfall zwangsweise flat gestellt","Firmenregeln haben rund um Roll und Sitzungsschluss Vorrang","Aktuelle Roll-/Flat-Regeln Ihrer Firma prüfen, sie unterscheiden sich je nach Firma"],
    ] },
    { type: "heading",text: "Mit PickMyTrade verhindern" },
    { type: "paragraph",html: "Ablehnungen wegen auslaufender Kontrakte sind fast immer ein Problem der <em>Symbol-Hygiene</em>: Ihre Automatisierung zielt auf einen fortlaufenden oder veralteten Kontrakt, während der aktive Front Month längst weitergezogen ist. PickMyTrade verbindet Ihre TradingView-Alerts direkt mit Tradovate und ergänzt eine Validierungsebene, damit ein gerollter Kontrakt Ihre Strategie nicht unbemerkt lahmlegt:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Symbol- &amp; Kontraktvalidierung</strong>, prüft das geroutete Symbol, bevor die Order hinausgeht, sodass Alerts auf einen fortlaufenden oder auslaufenden Kontrakt abgefangen statt vom Broker abgewiesen werden.",
        "<strong class='text-white'>Ablehnungssicheres Routing</strong>, befindet sich ein Kontrakt in Liquidation Only, wiederholt PickMyTrade nicht blind tote Einstiege in Ihr Order-Log; Sie routen sauber, sobald Sie sich im gültigen Monat befinden.",
        "<strong class='text-white'>Berechtigungs- &amp; Risikofilter</strong>, berücksichtigt Prop-Firm-Limits und den Stand der Datenvereinbarungen, sodass Orders, die aus Kontogründen scheitern würden, sich nicht neben dem Roll-Problem anhäufen.",
        "<strong class='text-white'>Multi-Account-Synchronisierung</strong>, wenn Sie auf den neuen Front Month rollen, wird die korrigierte Order auf alle verbundenen Tradovate-Konten gleichzeitig gespiegelt, sodass kein einzelnes Konto im abgelaufenen Monat weiterhandelt.",
      ],
    },
    { type: "paragraph",html: "Das Ziel ist einfach: nie wieder eine Sitzung an einen Kontrakt verlieren, der gerollt ist, während Sie nicht hingesehen haben." },
  ], es: [
    { type: "paragraph",html: "Prepara una entrada en NQ o ES, pulsa enviar, y Tradovate se la devuelve: <em>&ldquo;Liquidation Only. Contract is about to be expired. Please contact the Trade Desk.&rdquo;</em> Todavía puede cerrar lo que tenga abierto, pero toda orden nueva muere en cuanto la envía. Aquí está la buena noticia que oculta la redacción: casi nunca necesita llamar a nadie. El contrato al que apunta ha entrado en su ventana de vencimiento, por lo que Tradovate lo ha pasado a solo liquidación, es decir, solo cierre. A los traders automatizados es a quienes más afecta, porque una alerta de TradingView construida sobre un símbolo continuo como <strong class='text-white'>NQ1!</strong> o <strong class='text-white'>ES1!</strong> seguirá disparándose alegremente contra un contrato por vencer mucho después de que el volumen haya pasado al mes siguiente. A continuación veremos qué significa realmente el mensaje, por qué aparece y cómo avanzar al contrato activo del mes cercano para que sus órdenes vuelvan a ejecutarse, además de cómo PickMyTrade evita que un contrato por vencer destruya en silencio su automatización." },
    {
      type: "checklist",
      heading: "Lista de verificación rápida para el rechazo de solo liquidación por contrato por vencer",
      items: [
        "<strong class='text-white'>Pase al contrato activo del mes cercano</strong>, cambie el mes por vencer (por ejemplo un contrato <code>H</code> de marzo durante la semana de rollover) por el vigente antes de volver a entrar.",
        "<strong class='text-white'>Deje de operar símbolos continuos</strong>, <code>NQ1!</code>, <code>ES1!</code> y <code>GC1!</code> avanzan automáticamente en los gráficos de TradingView, pero la orden que llega al broker aún puede tocar un contrato por vencer.",
        "<strong class='text-white'>Vuelva a crear cualquier alerta de TradingView sobre el nuevo contrato</strong>, editar solo el ticker a menudo no basta. Elimine la alerta antigua y vuelva a añadirla en el gráfico del contrato vigente.",
        "<strong class='text-white'>Confirme que solo se le permite cerrar</strong>, la solo liquidación le deja cerrar una posición abierta pero bloquea toda nueva entrada.",
        "<strong class='text-white'>Consulte el calendario de rollover</strong>, los futuros de índices bursátiles vencen el tercer viernes de marzo, junio, septiembre y diciembre; la energía y los metales avanzan según sus propios calendarios.",
        "<strong class='text-white'>Normalmente no necesita el Trade Desk</strong>, a pesar del mensaje, cambiar al contrato vigente elimina el rechazo por sí solo.",
      ],
    },
    { type: "heading",text: "Qué significa «Liquidation Only. Contract Is About to Be Expired»" },
    { type: "paragraph",html: "Todo contrato de futuros tiene una fecha de vencimiento fija, y deja de negociarse como un instrumento normal a medida que esa fecha se acerca. Para evitar que los traders se queden con un contrato hasta la liquidación o la entrega, Tradovate restringe cualquier contrato dentro de su ventana de vencimiento a <strong class='text-white'>solo liquidación</strong>, puede reducir o cerrar una posición existente, pero no abrir una nueva. Si envía una entrada nueva en ese contrato, rebota con <em>&ldquo;Liquidation Only. Contract is about to be expired. Please contact the Trade Desk.&rdquo;</em>" },
    { type: "paragraph",html: "Lo que conviene grabarse: este es un estado <strong class='text-white'>por contrato</strong>, no un bloqueo de toda la cuenta. Su cuenta está bien. El único mes de contrato al que apunta, un contrato de junio en sus últimos días, por ejemplo, es lo que está cerrado a nuevas operaciones. Dirija su orden al siguiente mes activo y se ejecuta con normalidad. Eso es lo que hace que este rechazo sea completamente distinto de un bloqueo de solo liquidación por Risk Settings, que deja plana toda su cuenta tras un límite de pérdida, o de una infracción de drawdown de la prop firm." },
    { type: "paragraph",html: "La frase &ldquo;contact the Trade Desk&rdquo; asusta y hace pensar que la cuenta está rota. En realidad, el trade desk simplemente le diría que el contrato ha avanzado y que debe operar el mes cercano vigente, algo que puede hacer usted mismo en unos diez segundos. La única excepción: si ya mantiene una posición en el contrato por vencer y no puede quedar en plano, es razonable ponerse en contacto con Tradovate (o con su prop firm) para que le cierren la posición." },
    { type: "heading",text: "Principales causas del rechazo por contrato por vencer en 2026" },
    { type: "heading",text: "1. Está operando un contrato que ha entrado en su ventana de vencimiento" },
    { type: "paragraph",html: "La causa más literal: el mes de contrato que eligió está en su último día de negociación o cerca de él. Los futuros de índices bursátiles (ES, NQ, YM, RTY) vencen el <strong class='text-white'>tercer viernes de marzo, junio, septiembre y diciembre</strong>, y la liquidez pasa al mes siguiente aproximadamente una semana antes, el informal &ldquo;rollover Thursday&rdquo; del que hablan los traders. Si opera el mes antiguo dentro de esa ventana, se topará con la solo liquidación aunque el símbolo técnicamente siga existiendo." },
    { type: "heading",text: "2. Un símbolo continuo (NQ1! / ES1!) enrutado a un contrato por vencer" },
    { type: "paragraph",html: "TradingView le muestra un símbolo <strong class='text-white'>continuo</strong> o de &ldquo;mes cercano&rdquo;, <code>NQ1!</code>, <code>ES1!</code>, <code>GC1!</code>, que une contratos para que el gráfico nunca tenga huecos. Excelente para el análisis, pero ese símbolo continuo no es en sí un contrato negociable en el broker. Cuando una orden o alerta basada en <code>NQ1!</code> se enruta a Tradovate, tiene que resolverse en un contrato real con fecha. Si la lógica de rollover de la plataforma y la de su gráfico difieren aunque sea en uno o dos días, el contrato resuelto puede ser el <em>que vence</em>, y Tradovate lo rechaza como solo liquidación." },
    { type: "heading",text: "3. Una alerta de TradingView sigue apuntando al mes de contrato antiguo" },
    { type: "paragraph",html: "Las configuraciones automatizadas son las peores reincidentes. Creó una alerta hace semanas sobre un contrato con fecha (o un símbolo continuo), el mercado avanzó, y la alerta siguió disparándose contra el mes ahora por vencer. Las alertas se ejecutan en los servidores de TradingView y no saben que el contrato ha avanzado, así que siguen enviando entradas a un contrato muerto hasta que las actualiza. Por eso este rechazo toma por sorpresa con tanta frecuencia a una estrategia que funcionó sin problemas la semana anterior." },
    { type: "heading",text: "4. Avanzó el gráfico, pero no la orden ni la posición abiertas" },
    { type: "paragraph",html: "Avanzar un módulo de gráfico cambia lo que está <em>viendo</em>, <strong class='text-white'>no</strong> mueve una posición abierta ni una orden pendiente al nuevo contrato. Si avanza el gráfico y supone que todo le siguió, se llevará la sorpresa cuando una entrada nueva funcione pero una orden activa más antigua siga en el mes por vencer y sea rechazada." },
    { type: "heading",text: "5. Las reglas de la prop firm o de la sesión se endurecen cerca del vencimiento" },
    { type: "paragraph",html: "En las cuentas de evaluación y financiadas, la prop firm, no usted, controla gran parte del comportamiento de la cuenta en torno al rollover y al cierre de la sesión. Algunas firmas obligan a quedar en plano antes del cierre diario y en torno al vencimiento, lo que se suma al estado de solo liquidación propio de Tradovate. Las reglas exactas varían según la firma y el tamaño de la cuenta, así que consulte el reglamento vigente de su firma en lugar de dar por sentado que se aplican los valores predeterminados de Tradovate." },
    { type: "heading",text: "Cómo solucionar el rechazo de solo liquidación por contrato por vencer: paso a paso" },
    { type: "heading",text: "Corregir el contrato: avanzar al mes cercano en Tradovate" },
    { type: "paragraph",html: "La solución principal es dejar de operar el mes por vencer y cambiar al contrato vigente del mes cercano." },
    {
      type: "steps",
      items: [
        { title: "Identifique el mes cercano vigente", html: "El formato de símbolo de Tradovate es el código del instrumento + el código del mes + el dígito o dígitos del año; por ejemplo, <code>ESZ4</code> es el E-mini S&amp;P de diciembre de 2024. Los códigos de los meses trimestrales de los índices bursátiles son <strong class='text-white'>H (marzo), M (junio), U (septiembre), Z (diciembre)</strong>." },
        { title: "Cambie el símbolo al contrato vigente", html: "En el módulo Chart, SuperDOM o en la lista de seguimiento, cambie el símbolo al contrato vigente. Puede hacer clic derecho en la cotización o en el símbolo para avanzar o retroceder a otro mes, o usar los ajustes de vista del módulo para elegir <strong class='text-white'>Roll Forward</strong> al siguiente contrato." },
        { title: "Cierre primero la posición antigua", html: "Si mantiene una posición en el contrato por vencer, <strong class='text-white'>ciérrela primero</strong> (la solo liquidación sigue permitiendo cerrar), y luego vuelva a entrar en el nuevo contrato; avanzar el gráfico no mueve su posición por usted." },
        { title: "Ajuste stops y objetivos", html: "Normalmente hay una pequeña diferencia de precio (&ldquo;base&rdquo;) entre el contrato antiguo y el nuevo, así que los niveles que eran válidos en el mes por vencer deben volver a fijarse en el nuevo." },
        { title: "Envíe una orden nueva", html: "Envíe en el contrato vigente. Ahora debería pasar en lugar de ser rechazada como solo liquidación." },
      ],
    },
    { type: "heading",text: "Corregir la alerta de TradingView (usuarios de automatización)" },
    { type: "paragraph",html: "Si el rechazo proviene de una alerta o un webhook de TradingView, actualizar solo el gráfico no lo detendrá, la alerta conserva su propio símbolo." },
    {
      type: "steps",
      items: [
        { title: "Lea el ticker actual de la alerta", html: "Abra el gráfico al que está asociada la alerta y lea su ticker actual. Si es un símbolo continuo como <code>NQ1!</code> o un contrato con fecha obsoleto, ese es el culpable." },
        { title: "Cambie al contrato con fecha vigente", html: "Cambie el gráfico al <strong class='text-white'>contrato con fecha vigente</strong> (el mes cercano activo) en lugar del símbolo continuo, de modo que lo que se dispare coincida con lo que Tradovate realmente puede operar." },
        { title: "Elimine y vuelva a crear la alerta", html: "<strong class='text-white'>Elimine la alerta antigua</strong> y cree una nueva en el gráfico del contrato actualizado. Editar el ticker sobre la marcha no es fiable, así que eliminar y volver a crear es la vía segura." },
        { title: "Confirme que la nueva alerta está activa", html: "Confirme que la nueva alerta está activa y que su mensaje o payload de webhook hace referencia al contrato vigente, no al vencido." },
        { title: "Pruebe la alerta", html: "Dispare una alerta de prueba (o espere la siguiente señal) y compruebe en el módulo Orders de Tradovate que la orden ahora se acepta." },
      ],
    },
    { type: "heading",text: "Si aún mantiene el contrato por vencer" },
    { type: "paragraph",html: "La solo liquidación nunca le impide cerrar. Si no puede quedar en plano, por una orden congelada o una caída de datos, cierre con una orden de mercado opuesta manual y, solo si eso falla, contacte con Tradovate (cuenta propia) o con su prop firm (evaluación/financiada) para que le cierren la posición. No se quede insistiendo con nuevas entradas rechazadas; no pasarán y solo saturan su registro de órdenes." },
    { type: "heading",text: "Tabla de resolución de problemas" },
    { type: "table", headers: ["Mensaje / estado","Significado","Solución"], rows: [
      ["&ldquo;Liquidation Only. Contract is about to be expired. Please contact the Trade Desk.&rdquo;","El contrato que opera ha entrado en su ventana de vencimiento y solo permite cerrar","Avance al contrato vigente del mes cercano y vuelva a entrar allí"],
      ["Nuevas órdenes rechazadas pero aún puede cerrar","Solo liquidación por contrato, no un bloqueo de cuenta","Cambie la orden al mes cercano activo; la cuenta en sí está bien"],
      ["La alerta siguió disparándose tras una semana de trabajo","La alerta de TradingView sigue apuntando al símbolo avanzado/continuo","Elimine y vuelva a crear la alerta sobre el contrato con fecha vigente"],
      ["Orden <code>NQ1!</code> / <code>ES1!</code> rechazada en Tradovate","El símbolo continuo se resolvió en un contrato por vencer en el broker","Opere en su lugar el contrato con fecha del mes cercano (p. ej., el mes <code>M</code>/<code>U</code>/<code>Z</code> vigente)"],
      ["El gráfico nuevo funciona, la orden antigua sigue rechazándose","Avanzó el gráfico pero no la orden/posición pendiente","Cancele/cierre en el contrato antiguo y vuelva a colocarla en el nuevo"],
      ["No puede cerrar la posición por vencer","Orden congelada o caída de datos durante el rollover","Envíe una orden de mercado opuesta manual; contacte con soporte/la prop firm si no se cierra"],
      ["Cuenta prop forzada a plano cerca del vencimiento","Las reglas de la firma prevalecen en torno al rollover y al cierre de la sesión","Consulte las reglas vigentes de rollover/plano de su firma, varían según la firma"],
    ] },
    { type: "heading",text: "Prevéngalo con PickMyTrade" },
    { type: "paragraph",html: "Los rechazos por contrato por vencer son casi siempre un problema de <em>higiene de símbolos</em>: su automatización apunta a un contrato continuo u obsoleto mientras el mes cercano activo ya ha avanzado. PickMyTrade conecta sus alertas de TradingView directamente con Tradovate y añade una capa de validación para que un contrato que ha avanzado no rompa en silencio su estrategia:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Validación de símbolo y contrato</strong>, comprueba el símbolo enrutado antes de que salga la orden, de modo que las alertas sobre un contrato continuo o por vencer se detectan en lugar de ser rechazadas por el broker.",
        "<strong class='text-white'>Enrutamiento a prueba de rechazos</strong>, cuando un contrato está en solo liquidación, PickMyTrade no reintenta a ciegas entradas muertas en su registro de órdenes; usted enruta con limpieza una vez que está en el mes válido.",
        "<strong class='text-white'>Filtros de autorización y riesgo</strong>, respeta los límites de la prop firm y el estado de los acuerdos de datos, de modo que las órdenes que fallarían por motivos de cuenta no se acumulen junto al problema de rollover.",
        "<strong class='text-white'>Sincronización multicuenta</strong>, cuando avanza al nuevo mes cercano, la orden corregida se replica en todas las cuentas de Tradovate conectadas a la vez, de modo que ninguna cuenta se queda operando el mes vencido.",
      ],
    },
    { type: "paragraph",html: "El objetivo es simple: no perder nunca una sesión por un contrato que avanzó mientras usted no miraba." },
  ], fr: [
    { type: "paragraph",html: "Vous préparez une entrée sur NQ ou ES, vous cliquez sur envoyer, et Tradovate vous la renvoie : <em>&ldquo;Liquidation Only. Contract is about to be expired. Please contact the Trade Desk.&rdquo;</em> Vous pouvez toujours clôturer ce que vous détenez, mais chaque nouvel ordre meurt à l'instant où vous le soumettez. Voici la bonne nouvelle que le libellé dissimule : vous n'avez presque jamais besoin d'appeler qui que ce soit. Le contrat visé a glissé dans sa fenêtre d'expiration, Tradovate l'a donc basculé en liquidation seule, c'est-à-dire clôture uniquement. Les traders automatisés sont les plus touchés, car une alerte TradingView construite sur un symbole continu comme <strong class='text-white'>NQ1!</strong> ou <strong class='text-white'>ES1!</strong> continuera joyeusement à se déclencher vers un contrat en expiration bien après que le volume a basculé vers le mois suivant. Ci-dessous, nous verrons ce que le message signifie réellement, pourquoi il apparaît et comment avancer vers le contrat actif du mois en cours pour que vos ordres soient de nouveau exécutés, ainsi que la façon dont PickMyTrade évite qu'un contrat arrivant à expiration ne tue discrètement votre automatisation." },
    {
      type: "checklist",
      heading: "Liste de contrôle rapide pour le rejet de liquidation seule sur contrat en expiration",
      items: [
        "<strong class='text-white'>Passez au contrat actif du mois en cours</strong>, remplacez le mois qui expire (par exemple un contrat <code>H</code> de mars pendant la semaine de roll) par le contrat actuel avant de ré-entrer.",
        "<strong class='text-white'>Cessez de trader des symboles continus</strong>, <code>NQ1!</code>, <code>ES1!</code> et <code>GC1!</code> basculent automatiquement sur les graphiques TradingView, mais l'ordre qui arrive chez le broker peut tout de même viser un contrat en expiration.",
        "<strong class='text-white'>Recréez toute alerte TradingView sur le nouveau contrat</strong>, modifier uniquement le ticker ne suffit souvent pas. Supprimez l'ancienne alerte et ajoutez-la de nouveau sur le graphique du contrat actuel.",
        "<strong class='text-white'>Confirmez que seule la clôture vous est autorisée</strong>, la liquidation seule vous permet de solder une position ouverte mais bloque toute nouvelle entrée.",
        "<strong class='text-white'>Consultez le calendrier de roll</strong>, les futures sur indices actions expirent le troisième vendredi de mars, juin, septembre et décembre ; l'énergie et les métaux basculent selon leurs propres calendriers.",
        "<strong class='text-white'>Vous n'avez généralement pas besoin du Trade Desk</strong>, malgré le message, passer au contrat actuel supprime le rejet de lui-même.",
      ],
    },
    { type: "heading",text: "Ce que signifie « Liquidation Only. Contract Is About to Be Expired »" },
    { type: "paragraph",html: "Chaque contrat à terme a une date d'expiration ferme, et il cesse d'être négocié comme un instrument normal à mesure que cette date approche. Pour éviter que les traders ne se retrouvent avec un contrat jusqu'au règlement ou à la livraison, Tradovate restreint tout contrat situé dans sa fenêtre d'expiration à la <strong class='text-white'>liquidation seule</strong> : vous pouvez réduire ou clôturer une position existante, mais pas en ouvrir une nouvelle. Soumettez une nouvelle entrée sur ce contrat et elle est renvoyée avec <em>&ldquo;Liquidation Only. Contract is about to be expired. Please contact the Trade Desk.&rdquo;</em>" },
    { type: "paragraph",html: "Ce qu'il faut retenir : il s'agit d'un état <strong class='text-white'>par contrat</strong>, pas d'un verrouillage de tout le compte. Votre compte va bien. Le seul mois de contrat visé, un contrat de juin vivant ses derniers jours par exemple, est fermé aux nouvelles opérations. Dirigez votre ordre vers le mois actif suivant et il est exécuté normalement. C'est ce qui distingue totalement ce rejet d'un verrouillage en liquidation seule via les Risk Settings, qui met à plat l'ensemble de votre compte après une limite de perte, ou d'une violation du drawdown de la prop firm." },
    { type: "paragraph",html: "La mention &ldquo;contact the Trade Desk&rdquo; effraie les gens et leur fait croire que leur compte est cassé. En réalité, le trade desk vous dirait simplement que le contrat a basculé et que vous devez trader le mois en cours, ce que vous pouvez faire vous-même en une dizaine de secondes. La seule exception : si vous détenez déjà une position sur le contrat en expiration et ne pouvez pas vous mettre à plat, contacter Tradovate (ou votre prop firm) pour être soldé est une démarche légitime." },
    { type: "heading",text: "Principales causes du rejet pour contrat en expiration en 2026" },
    { type: "heading",text: "1. Vous tradez un contrat entré dans sa fenêtre d'expiration" },
    { type: "paragraph",html: "La cause la plus littérale : le mois de contrat que vous avez choisi est à son dernier jour de négociation ou tout près. Les futures sur indices actions (ES, NQ, YM, RTY) expirent le <strong class='text-white'>troisième vendredi de mars, juin, septembre et décembre</strong>, et la liquidité passe au mois suivant environ une semaine avant, le &ldquo;rollover Thursday&rdquo; informel dont parlent les traders. Tradez l'ancien mois dans cette fenêtre et vous tomberez en liquidation seule même si le symbole existe techniquement toujours." },
    { type: "heading",text: "2. Un symbole continu (NQ1! / ES1!) acheminé vers un contrat en expiration" },
    { type: "paragraph",html: "TradingView vous montre un symbole <strong class='text-white'>continu</strong> ou de &ldquo;mois en cours&rdquo;, <code>NQ1!</code>, <code>ES1!</code>, <code>GC1!</code>, qui assemble les contrats pour que le graphique n'ait jamais de trou. Excellent pour l'analyse, mais ce symbole continu n'est pas lui-même un contrat négociable chez le broker. Lorsqu'un ordre ou une alerte construit sur <code>NQ1!</code> est acheminé vers Tradovate, il doit se résoudre en un vrai contrat daté. Si la logique de roll de la plateforme et celle de votre graphique divergent ne serait-ce que d'un jour ou deux, le contrat résolu peut être celui <em>qui expire</em>, et Tradovate le rejette comme liquidation seule." },
    { type: "heading",text: "3. Une alerte TradingView pointe encore vers l'ancien mois de contrat" },
    { type: "paragraph",html: "Les configurations automatisées sont les pires récidivistes. Vous avez créé une alerte il y a des semaines sur un contrat daté (ou un symbole continu), le marché a basculé, et l'alerte a continué à se déclencher vers le mois désormais en expiration. Les alertes s'exécutent côté serveur chez TradingView et ignorent que le contrat a basculé ; elles continuent donc d'envoyer des entrées vers un contrat mort jusqu'à ce que vous les mettiez à jour. C'est exactement pourquoi ce rejet prend si souvent de court une stratégie qui fonctionnait parfaitement la semaine précédente." },
    { type: "heading",text: "4. Vous avez fait avancer le graphique, mais pas l'ordre ni la position ouverts" },
    { type: "paragraph",html: "Faire avancer un module de graphique change ce que vous <em>regardez</em>, cela ne déplace <strong class='text-white'>pas</strong> une position ouverte ni un ordre en attente vers le nouveau contrat. Faites avancer le graphique en supposant que tout a suivi, et vous serez pris lorsqu'une nouvelle entrée fonctionne mais qu'un ordre actif plus ancien reste sur le mois en expiration et y est rejeté." },
    { type: "heading",text: "5. Les règles de la prop firm ou de la session se durcissent près de l'expiration" },
    { type: "paragraph",html: "Sur les comptes d'évaluation et financés, c'est la prop firm, et non vous, qui contrôle une grande part du comportement du compte autour du roll et de la clôture de session. Certaines firmes imposent de se mettre à plat avant la clôture quotidienne et autour de l'expiration, ce qui s'ajoute à l'état de liquidation seule propre à Tradovate. Les règles exactes varient selon la firme et la taille du compte ; consultez donc le règlement actuel de votre firme plutôt que de supposer que les valeurs par défaut de Tradovate s'appliquent." },
    { type: "heading",text: "Comment corriger le rejet de liquidation seule sur contrat en expiration : pas à pas" },
    { type: "heading",text: "Corriger le contrat : avancer vers le mois en cours dans Tradovate" },
    { type: "paragraph",html: "La correction essentielle consiste à cesser de trader le mois qui expire et à passer au contrat du mois en cours." },
    {
      type: "steps",
      items: [
        { title: "Identifiez le mois en cours", html: "Le format de symbole de Tradovate est le code de l'instrument + le code du mois + le ou les chiffres de l'année ; par exemple, <code>ESZ4</code> est l'E-mini S&amp;P de décembre 2024. Les codes des mois trimestriels pour les indices actions sont <strong class='text-white'>H (mars), M (juin), U (septembre), Z (décembre)</strong>." },
        { title: "Changez le symbole pour le contrat actuel", html: "Dans le module Chart, SuperDOM ou la liste de surveillance, changez le symbole pour le contrat actuel. Vous pouvez faire un clic droit sur la cotation ou le symbole pour avancer ou reculer vers un autre mois, ou utiliser les paramètres d'affichage du module pour choisir <strong class='text-white'>Roll Forward</strong> vers le contrat suivant." },
        { title: "Clôturez d'abord l'ancienne position", html: "Si vous détenez une position sur le contrat en expiration, <strong class='text-white'>clôturez-la d'abord</strong> (la liquidation seule autorise toujours la clôture), puis ré-entrez sur le nouveau contrat ; faire avancer le graphique ne déplace pas votre position à votre place." },
        { title: "Ajustez les stops et les objectifs", html: "Il existe généralement un petit écart de prix (&ldquo;base&rdquo;) entre l'ancien et le nouveau contrat, de sorte que les niveaux valables sur le mois en expiration doivent être redéfinis sur le nouveau." },
        { title: "Soumettez un nouvel ordre", html: "Soumettez sur le contrat actuel. Il devrait maintenant passer au lieu d'être rejeté comme liquidation seule." },
      ],
    },
    { type: "heading",text: "Corriger l'alerte TradingView (utilisateurs de l'automatisation)" },
    { type: "paragraph",html: "Si le rejet provient d'une alerte ou d'un webhook TradingView, mettre à jour le seul graphique ne l'arrêtera pas, l'alerte conserve son propre symbole." },
    {
      type: "steps",
      items: [
        { title: "Lisez le ticker actuel de l'alerte", html: "Ouvrez le graphique auquel l'alerte est rattachée et lisez son ticker actuel. S'il s'agit d'un symbole continu comme <code>NQ1!</code> ou d'un contrat daté périmé, c'est le coupable." },
        { title: "Passez au contrat daté actuel", html: "Passez le graphique au <strong class='text-white'>contrat daté actuel</strong> (le mois en cours actif) plutôt qu'au symbole continu, afin que ce qui se déclenche corresponde à ce que Tradovate peut réellement négocier." },
        { title: "Supprimez et recréez l'alerte", html: "<strong class='text-white'>Supprimez l'ancienne alerte</strong> et créez-en une nouvelle sur le graphique du contrat mis à jour. Modifier le ticker sur place n'est pas fiable ; supprimer puis recréer est donc la voie sûre." },
        { title: "Confirmez que la nouvelle alerte est active", html: "Confirmez que la nouvelle alerte est active et que son message ou sa charge utile de webhook référence le contrat actuel, et non celui qui a expiré." },
        { title: "Testez l'alerte", html: "Déclenchez une alerte de test (ou attendez le prochain signal) et vérifiez dans le module Orders de Tradovate que l'ordre est désormais accepté." },
      ],
    },
    { type: "heading",text: "Si vous détenez encore le contrat en expiration" },
    { type: "paragraph",html: "La liquidation seule ne vous empêche jamais de clôturer. Si vous ne pouvez pas vous mettre à plat, ordre figé, perte de données, clôturez avec un ordre au marché opposé manuel et, seulement si cela échoue, contactez Tradovate (compte en fonds propres) ou votre prop firm (évaluation/financé) pour être soldé. Ne vous acharnez pas sur de nouvelles entrées rejetées ; elles ne passeront pas et ne font qu'encombrer votre journal d'ordres." },
    { type: "heading",text: "Tableau de dépannage" },
    { type: "table", headers: ["Message / état","Signification","Solution"], rows: [
      ["&ldquo;Liquidation Only. Contract is about to be expired. Please contact the Trade Desk.&rdquo;","Le contrat que vous tradez est entré dans sa fenêtre d'expiration et n'autorise que la clôture","Passez au contrat du mois en cours et ré-entrez-y"],
      ["Nouveaux ordres rejetés mais vous pouvez encore clôturer","Liquidation seule par contrat, pas un verrouillage de compte","Basculez l'ordre sur le mois en cours actif ; le compte lui-même va bien"],
      ["L'alerte a continué à se déclencher après une semaine de bon fonctionnement","L'alerte TradingView pointe encore vers le symbole basculé/continu","Supprimez et recréez l'alerte sur le contrat daté actuel"],
      ["Ordre <code>NQ1!</code> / <code>ES1!</code> rejeté sur Tradovate","Le symbole continu s'est résolu en un contrat en expiration chez le broker","Tradez plutôt le contrat daté du mois en cours (p. ex. le mois <code>M</code>/<code>U</code>/<code>Z</code> actuel)"],
      ["Le nouveau graphique fonctionne, l'ancien ordre est toujours rejeté","Vous avez fait avancer le graphique mais pas l'ordre en attente/la position","Annulez/clôturez sur l'ancien contrat, replacez sur le nouveau"],
      ["Impossible de solder la position en expiration","Ordre figé ou perte de données pendant le roll","Envoyez un ordre au marché opposé manuel ; contactez le support/la prop firm s'il ne se clôture pas"],
      ["Compte prop mis à plat de force près de l'expiration","Les règles de la firme prévalent autour du roll et de la clôture de session","Consultez les règles actuelles de roll/mise à plat de votre firme, elles varient selon la firme"],
    ] },
    { type: "heading",text: "Prévenir cela avec PickMyTrade" },
    { type: "paragraph",html: "Les rejets pour contrat en expiration sont presque toujours un problème d'<em>hygiène de symbole</em> : votre automatisation vise un contrat continu ou périmé alors que le mois en cours actif a déjà changé. PickMyTrade relie vos alertes TradingView directement à Tradovate et ajoute une couche de validation pour qu'un contrat ayant basculé ne casse pas discrètement votre stratégie :" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Validation de symbole et de contrat</strong>, vérifie le symbole acheminé avant l'envoi de l'ordre, de sorte que les alertes sur un contrat continu ou en expiration sont interceptées au lieu d'être renvoyées par le broker.",
        "<strong class='text-white'>Acheminement à l'épreuve des rejets</strong>, lorsqu'un contrat est en liquidation seule, PickMyTrade ne rejoue pas aveuglément des entrées mortes dans votre journal d'ordres ; vous acheminez proprement une fois sur le mois valide.",
        "<strong class='text-white'>Filtres de droits d'accès et de risque</strong>, respecte les limites de la prop firm et l'état des accords de données, de sorte que les ordres qui échoueraient pour des raisons de compte ne s'accumulent pas à côté du problème de roll.",
        "<strong class='text-white'>Synchronisation multi-comptes</strong>, lorsque vous passez au nouveau mois en cours, l'ordre corrigé est reproduit sur tous les comptes Tradovate connectés en une fois, de sorte qu'aucun compte ne reste à trader le mois expiré.",
      ],
    },
    { type: "paragraph",html: "L'objectif est simple : ne jamais perdre une session à cause d'un contrat qui a basculé pendant que vous ne regardiez pas." },
  ], it: [
    { type: "paragraph",html: "Prepara un ingresso su NQ o ES, preme invio, e Tradovate glielo rimanda indietro: <em>&ldquo;Liquidation Only. Contract is about to be expired. Please contact the Trade Desk.&rdquo;</em> Può ancora chiudere ciò che detiene, ma ogni nuovo ordine muore nel momento in cui lo invia. Ecco la buona notizia che la dicitura nasconde: non ha quasi mai bisogno di chiamare nessuno. Il contratto a cui punta è scivolato nella sua finestra di scadenza, quindi Tradovate lo ha portato in sola liquidazione, cioè solo chiusura. I trader automatizzati sono i più colpiti, perché un alert di TradingView costruito su un simbolo continuo come <strong class='text-white'>NQ1!</strong> o <strong class='text-white'>ES1!</strong> continuerà allegramente a scattare verso un contratto in scadenza molto dopo che il volume è passato al mese successivo. Di seguito vedremo che cosa significa davvero il messaggio, perché compare e come avanzare al contratto front-month attivo in modo che i Suoi ordini vengano di nuovo eseguiti, oltre a come PickMyTrade evita che un contratto in scadenza uccida silenziosamente la Sua automazione." },
    {
      type: "checklist",
      heading: "Checklist rapida per il rifiuto di sola liquidazione su contratto in scadenza",
      items: [
        "<strong class='text-white'>Passi al contratto front-month attivo</strong>, sostituisca il mese in scadenza (ad esempio un contratto <code>H</code> di marzo durante la settimana del roll) con quello attuale prima di rientrare.",
        "<strong class='text-white'>Smetta di negoziare simboli continui</strong>, <code>NQ1!</code>, <code>ES1!</code> e <code>GC1!</code> avanzano automaticamente sui grafici di TradingView, ma l'ordine che arriva al broker può comunque colpire un contratto in scadenza.",
        "<strong class='text-white'>Ricrei ogni alert di TradingView sul nuovo contratto</strong>, modificare solo il ticker spesso non basta. Elimini il vecchio alert e lo aggiunga di nuovo sul grafico del contratto attuale.",
        "<strong class='text-white'>Confermi di poter solo chiudere</strong>, la sola liquidazione Le consente di chiudere una posizione aperta ma blocca ogni nuova entrata.",
        "<strong class='text-white'>Controlli il calendario dei roll</strong>, i futures sugli indici azionari scadono il terzo venerdì di marzo, giugno, settembre e dicembre; energia e metalli fanno il roll secondo calendari propri.",
        "<strong class='text-white'>Di solito non Le serve il Trade Desk</strong>, nonostante il messaggio, passare al contratto attuale elimina il rifiuto da solo.",
      ],
    },
    { type: "heading",text: "Che cosa significa «Liquidation Only. Contract Is About to Be Expired»" },
    { type: "paragraph",html: "Ogni contratto future ha una data di scadenza rigida e smette di essere negoziato come uno strumento normale man mano che tale data si avvicina. Per evitare che i trader restino con un contratto fino al regolamento o alla consegna, Tradovate limita qualsiasi contratto all'interno della sua finestra di scadenza alla <strong class='text-white'>sola liquidazione</strong>, può ridurre o chiudere una posizione esistente, ma non aprirne una nuova. Se invia una nuova entrata su quel contratto, viene respinta con <em>&ldquo;Liquidation Only. Contract is about to be expired. Please contact the Trade Desk.&rdquo;</em>" },
    { type: "paragraph",html: "Ciò che deve fissarsi in mente: questo è uno stato <strong class='text-white'>per singolo contratto</strong>, non un blocco dell'intero conto. Il Suo conto è a posto. Il singolo mese di contratto a cui sta puntando, un contratto di giugno negli ultimi giorni di vita, ad esempio, è ciò che è chiuso a nuove operazioni. Indirizzi l'ordine al mese attivo successivo e viene eseguito normalmente. Ecco che cosa rende questo rifiuto completamente diverso da un blocco di sola liquidazione dalle Risk Settings, che chiude l'intero conto dopo un limite di perdita, o da una violazione del drawdown della prop firm." },
    { type: "paragraph",html: "La frase &ldquo;contact the Trade Desk&rdquo; spaventa e fa pensare che il conto sia rotto. In realtà il trade desk Le direbbe semplicemente che il contratto ha fatto il roll e che deve negoziare l'attuale front month, cosa che può fare da solo in circa dieci secondi. L'unica eccezione: se detiene già una posizione nel contratto in scadenza e non riesce a chiuderla, è legittimo rivolgersi a Tradovate (o alla Sua prop firm) per farla chiudere." },
    { type: "heading",text: "Cause principali del rifiuto per contratto in scadenza nel 2026" },
    { type: "heading",text: "1. Sta negoziando un contratto entrato nella sua finestra di scadenza" },
    { type: "paragraph",html: "La causa più letterale: il mese di contratto scelto è all'ultimo giorno di negoziazione o vicino. I futures sugli indici azionari (ES, NQ, YM, RTY) scadono il <strong class='text-white'>terzo venerdì di marzo, giugno, settembre e dicembre</strong>, e la liquidità passa al mese successivo circa una settimana prima, l'informale &ldquo;rollover Thursday&rdquo; di cui parlano i trader. Se negozia il vecchio mese in quella finestra, incapperà nella sola liquidazione anche se il simbolo tecnicamente esiste ancora." },
    { type: "heading",text: "2. Un simbolo continuo (NQ1! / ES1!) instradato a un contratto in scadenza" },
    { type: "paragraph",html: "TradingView Le mostra un simbolo <strong class='text-white'>continuo</strong> o &ldquo;front-month&rdquo;, <code>NQ1!</code>, <code>ES1!</code>, <code>GC1!</code>, che cuce insieme i contratti in modo che il grafico non abbia mai buchi. Ottimo per l'analisi, ma quel simbolo continuo non è di per sé un contratto negoziabile presso il broker. Quando un ordine o un alert basato su <code>NQ1!</code> viene instradato a Tradovate, deve risolversi in un vero contratto con data. Se la logica di roll della piattaforma e quella del Suo grafico divergono anche solo di un giorno o due, il contratto risolto può essere quello <em>in scadenza</em>, e Tradovate lo respinge come sola liquidazione." },
    { type: "heading",text: "3. Un alert di TradingView punta ancora al vecchio mese di contratto" },
    { type: "paragraph",html: "Le configurazioni automatizzate sono le peggiori recidive. Ha creato un alert settimane fa su un contratto con data (o su un simbolo continuo), il mercato ha fatto il roll, e l'alert ha continuato a scattare verso il mese ora in scadenza. Gli alert vengono eseguiti lato server su TradingView e non sanno che il contratto ha fatto il roll, quindi continuano a pompare entrate in un contratto morto finché non li aggiorna. Ecco perché questo rifiuto coglie così spesso di sorpresa una strategia che funzionava perfettamente la settimana prima." },
    { type: "heading",text: "4. Ha fatto avanzare il grafico ma non l'ordine o la posizione aperti" },
    { type: "paragraph",html: "Far avanzare un modulo grafico cambia ciò che sta <em>guardando</em>, <strong class='text-white'>non</strong> sposta una posizione aperta o un ordine in attesa sul nuovo contratto. Faccia avanzare il grafico dando per scontato che tutto sia seguito, e verrà colto di sorpresa quando una nuova entrata funziona ma un ordine attivo più vecchio resta sul mese in scadenza e viene respinto contro di esso." },
    { type: "heading",text: "5. Le regole della prop firm o della sessione si irrigidiscono vicino alla scadenza" },
    { type: "paragraph",html: "Sui conti di valutazione e finanziati, è la prop firm, non Lei, a controllare gran parte del comportamento del conto attorno al roll e alla chiusura della sessione. Alcune società impongono di andare flat prima della chiusura giornaliera e attorno alla scadenza, il che si somma allo stato di sola liquidazione proprio di Tradovate. Le regole esatte variano in base alla società e alla dimensione del conto, quindi consulti il regolamento attuale della Sua società invece di dare per scontato che valgano le impostazioni predefinite di Tradovate." },
    { type: "heading",text: "Come risolvere il rifiuto di sola liquidazione su contratto in scadenza: passo dopo passo" },
    { type: "heading",text: "Correggere il contratto: avanzare al front month in Tradovate" },
    { type: "paragraph",html: "La correzione principale è smettere di negoziare il mese in scadenza e passare al contratto front-month attuale." },
    {
      type: "steps",
      items: [
        { title: "Individui l'attuale front month", html: "Il formato dei simboli di Tradovate è il codice dello strumento + il codice del mese + la/le cifra/e dell'anno, ad esempio <code>ESZ4</code> è l'E-mini S&amp;P di dicembre 2024. I codici dei mesi trimestrali per gli indici azionari sono <strong class='text-white'>H (marzo), M (giugno), U (settembre), Z (dicembre)</strong>." },
        { title: "Cambi il simbolo con il contratto attuale", html: "Nel modulo Chart, SuperDOM o nella watchlist, cambi il simbolo con il contratto attuale. Può fare clic con il tasto destro sulla quotazione o sul simbolo per avanzare o tornare a un mese diverso, oppure usare le impostazioni di visualizzazione del modulo per scegliere <strong class='text-white'>Roll Forward</strong> sul contratto successivo." },
        { title: "Chiuda prima la vecchia posizione", html: "Se detiene una posizione nel contratto in scadenza, <strong class='text-white'>la chiuda per prima</strong> (la sola liquidazione consente ancora la chiusura), poi rientri sul nuovo contratto, far avanzare il grafico non sposta la posizione per Lei." },
        { title: "Adegui stop e target", html: "Di solito c'è una piccola differenza di prezzo (&ldquo;basis&rdquo;) tra il vecchio e il nuovo contratto, quindi i livelli validi sul mese in scadenza devono essere reimpostati sul nuovo." },
        { title: "Invii un nuovo ordine", html: "Invii sul contratto attuale. Ora dovrebbe passare invece di essere respinto come sola liquidazione." },
      ],
    },
    { type: "heading",text: "Correggere l'alert di TradingView (utenti dell'automazione)" },
    { type: "paragraph",html: "Se il rifiuto proviene da un alert o da un webhook di TradingView, aggiornare solo il grafico non lo fermerà, l'alert mantiene il proprio simbolo." },
    {
      type: "steps",
      items: [
        { title: "Legga il ticker attuale dell'alert", html: "Apra il grafico a cui è collegato l'alert e legga il suo ticker attuale. Se è un simbolo continuo come <code>NQ1!</code> o un contratto con data obsoleto, è lui il colpevole." },
        { title: "Passi al contratto con data attuale", html: "Porti il grafico sul <strong class='text-white'>contratto con data attuale</strong> (il front month attivo) invece che sul simbolo continuo, così ciò che scatta corrisponde a ciò che Tradovate può effettivamente negoziare." },
        { title: "Elimini e ricrei l'alert", html: "<strong class='text-white'>Elimini il vecchio alert</strong> e ne crei uno nuovo sul grafico del contratto aggiornato. Modificare il ticker sul posto è inaffidabile, quindi eliminare e ricreare è la via sicura." },
        { title: "Confermi che il nuovo alert sia attivo", html: "Confermi che il nuovo alert sia attivo e che il suo messaggio o payload del webhook faccia riferimento al contratto attuale, non a quello scaduto." },
        { title: "Provi l'alert", html: "Faccia scattare un alert di prova (o attenda il prossimo segnale) e verifichi nel modulo Orders di Tradovate che l'ordine venga ora accettato." },
      ],
    },
    { type: "heading",text: "Se detiene ancora il contratto in scadenza" },
    { type: "paragraph",html: "La sola liquidazione non Le impedisce mai di chiudere. Se non riesce a chiudere la posizione, un ordine bloccato, un'interruzione dei dati, chiuda con un ordine a mercato opposto manuale e, solo se fallisce, contatti Tradovate (conto proprio) o la Sua prop firm (valutazione/finanziato) per farsi chiudere la posizione. Non si accanisca su nuove entrate respinte; non passeranno e non fanno altro che ingombrare il registro degli ordini." },
    { type: "heading",text: "Tabella di risoluzione dei problemi" },
    { type: "table", headers: ["Messaggio / stato","Significato","Soluzione"], rows: [
