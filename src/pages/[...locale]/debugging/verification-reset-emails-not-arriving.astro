---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "verification-reset-emails-not-arriving";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/debugging/${SLUG}`;

const META_TITLE = "Tradovate Verification / Reset Email Not Arriving";
const META_DESCRIPTION =
  "Tradovate verification or reset email not arriving? Resend it from Forgot Password and check spam and junk folders where it's commonly filtered.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Tradovate: Verifizierungs-/Zurücksetzungs-E-Mail kommt nicht an", es: "El correo de verificación o restablecimiento de Tradovate no llega", fr: "E-mail de vérification / réinitialisation Tradovate non reçu", it: "E-mail di verifica / reimpostazione di Tradovate non in arrivo" },
  dek: { en: "A missing verification or password-reset email almost always means the message already sent, it's just sitting in spam, junk, or the Promotions tab. Here's where to look and how to resend it.", de: "Wenn eine Verifizierungs- oder Passwort-Zurücksetzungs-E-Mail fehlt, wurde die Nachricht fast immer bereits gesendet, sie liegt nur im Spam-, Junk- oder Promotions-Ordner. Hier erfahren Sie, wo Sie suchen und wie Sie sie erneut senden.", es: "Un correo de verificación o de restablecimiento de contraseña que no aparece casi siempre significa que el mensaje ya se envió y está en spam, correo no deseado o en la pestaña Promociones. Aquí le explicamos dónde buscarlo y cómo reenviarlo.", fr: "Un e-mail de vérification ou de réinitialisation de mot de passe manquant signifie presque toujours que le message a déjà été envoyé : il se trouve simplement dans les spams, les indésirables ou l'onglet Promotions. Voici où chercher et comment le renvoyer.", it: "Un'e-mail di verifica o di reimpostazione della password che non arriva significa quasi sempre che il messaggio è già stato inviato: si trova semplicemente in spam, posta indesiderata o nella scheda Promozioni. Ecco dove cercare e come reinviarla." },
  readTime: { en: "6 min read", de: "6 Min. Lesezeit", es: "Lectura de 6 min", fr: "Lecture : 6 min", it: "Lettura di 6 min" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "You signed up, you clicked &ldquo;reset password,&rdquo; and now you're staring at an empty inbox while the market keeps moving without you. A missing Tradovate verification email, or a password-reset link that never lands, is one of the most common reasons traders get stuck at the login screen. Here's the frustrating twist: the message has almost always already been sent. Nine times out of ten it was delivered, then quietly filtered into a spam, junk, or Gmail Promotions folder. Sometimes it just needs to be requested again from the login screen's help flow. This guide walks through every reason the email fails to show up, how to resend it, where to hunt when it seems to have vanished, and why prop-firm and evaluation accounts follow a completely different recovery path." },
    {
      type: "checklist",
      heading: "Quick Checklist for a Missing Verification or Reset Email",
      items: [
        "<strong class='text-white'>Check spam, junk, and the Gmail Promotions tab first.</strong> This is where Tradovate's messages most often get filtered, and it clears the problem for most traders.",
        "<strong class='text-white'>Resend it from the login screen.</strong> Use the &ldquo;Need help?&rdquo; / &ldquo;Forgot Password&rdquo; flow to trigger a fresh email instead of waiting on the old one.",
        "<strong class='text-white'>Give it 10&ndash;15 minutes.</strong> Mail-provider delays and greylisting can hold the message briefly before it appears.",
        "<strong class='text-white'>Confirm the email address on file is correct.</strong> A typo at sign-up sends every message to an address you can't open.",
        "<strong class='text-white'>Search your whole mailbox for &ldquo;Tradovate.&rdquo;</strong> A filter or rule may have moved it out of the inbox into an archive or a label.",
        "<strong class='text-white'>On a prop-firm or evaluation account, contact the firm, not Tradovate.</strong> Evaluation logins can't be reset through Tradovate's standard flow.",
      ],
    },
    { type: "heading", text: "What \"Verification / Reset Email Not Arriving\" Means" },
    { type: "paragraph", html: "There's no single error dialog for this, it's a symptom, not a coded message. Either you finished sign-up and never got the confirmation link that activates the account, or you asked for a username reminder or password reset and the follow-up email never showed up. Because the platform records the email as &ldquo;sent,&rdquo; the breakdown is almost always on the delivery side: a spam filter, a mistyped address, or a mail-server delay between Tradovate's system and your provider." },
    { type: "paragraph", html: "Treat the fix as routine. If you didn't receive the verification email, or deleted it before confirming, you can resend it right from the login screen. And if you've fired off several username or password resets and still see nothing, your spam and junk folders are the first place to look, because that's where the &ldquo;missing&rdquo; message usually turns out to be sitting. That's the single most important takeaway on this page: the email is usually there, just not in your inbox." },
    { type: "paragraph", html: "The one real exception is an evaluation or prop-firm account. Those logins are issued and controlled by the funding company, so Tradovate can't send you a reset for them at all. If you bought an evaluation from a firm like Apex, Topstep, or another provider, the recovery email has to come from that firm's system, chasing it through Tradovate's login screen will never produce a message." },
    { type: "heading", text: "Top Causes of a Missing Tradovate Email" },
    { type: "heading", text: "1. It landed in spam, junk, or the Promotions tab" },
    { type: "paragraph", html: "This is the number-one cause by a wide margin. Automated transactional email from a broker is a frequent target for aggressive spam filters, and Gmail in particular loves to route it to the <strong class='text-white'>Promotions</strong> tab instead of the primary inbox. Check spam and junk first, that's where the &ldquo;missing&rdquo; message usually turns up." },
    { type: "heading", text: "2. The email address on file has a typo" },
    { type: "paragraph", html: "If one character was wrong when you registered, a <code>.co</code> instead of <code>.com</code>, a swapped letter, the wrong domain, every verification and reset message is going to an address you don't control. Nothing will ever reach your real inbox no matter how many times you resend. If the account is brand new and unconfirmed, this is worth double-checking early." },
    { type: "heading", text: "3. A mail-provider delay or greylisting" },
    { type: "paragraph", html: "Transactional email isn't always instant. Some mail servers use greylisting, which deliberately defers the first delivery attempt from an unknown sender and only accepts it on a retry a few minutes later. A short wait of 10&ndash;15 minutes is often all it takes for a delayed email to land." },
    { type: "heading", text: "4. You're on a prop-firm or evaluation account" },
    { type: "paragraph", html: "Evaluation and funded-account logins are owned by the prop firm, not Tradovate. The standard username-recovery and password-reset flow doesn't apply to them, and requesting a reset through the Tradovate login screen simply won't generate an email. The reset has to start inside the firm's own portal or support channel." },
    { type: "heading", text: "5. A mailbox filter or rule moved it" },
    { type: "paragraph", html: "If you've ever set up inbox rules, a filter can quietly archive, label, or delete incoming mail that matches certain senders or keywords. The message was delivered fine, it just never landed in your inbox. That's why a full-mailbox search for &ldquo;Tradovate&rdquo; (including Archive, All Mail, and Trash) is worth doing before you assume it was never sent." },
    { type: "heading", text: "How to Fix a Missing Verification or Reset Email: Step-by-Step" },
    { type: "heading", text: "Resending the Email from the Login Screen" },
    {
      type: "steps",
      items: [
        { title: "Go to the Tradovate login screen", html: "Go to the Tradovate login screen on web or desktop." },
        { title: "Select the help option", html: "Look for a &ldquo;Need help?&rdquo; prompt (or the &ldquo;Forgot Password&rdquo; link) beneath the sign-in fields. The wording of this link changes between platform updates, so use whichever option leads to account recovery." },
        { title: "Choose the recovery action you need", html: "Resetting the password, or recovering the username, also re-triggers a fresh email, which is exactly what you want when a verification message went missing." },
        { title: "Enter your username or email and submit", html: "Enter your username or the email tied to the account and submit. The new message goes to the email address on file." },
      ],
    },
    { type: "heading", text: "Recovering Your Username or Resetting Your Password" },
    {
      type: "steps",
      items: [
        { title: "Pick the right recovery option", html: "On the recovery page, pick the right option. To get your username back, choose <strong class='text-white'>Retrieve Username</strong> and enter the email address on the account, your username is then sent to the email on file. To reset a forgotten password, choose <strong class='text-white'>Reset Password</strong>, enter your username or email, and reset instructions get emailed to you." },
        { title: "Use the address you actually registered with", html: "Recovery mail only goes to the email on file, so a different address returns nothing." },
        { title: "Submit once and wait", html: "Submit once and wait instead of firing off repeated requests. Multiple rapid resets are exactly the scenario where messages get filtered, and those are the ones you'll usually find waiting in the spam folder." },
      ],
    },
    { type: "heading", text: "Finding the Email When It Seems to Have Vanished" },
    {
      type: "steps",
      items: [
        { title: "Open spam and junk folders", html: "Open your spam and junk folders and look for a recent Tradovate message. This is the first place to check, and it resolves the problem for most people." },
        { title: "Check the Promotions tab", html: "Check the Promotions tab if you use Gmail, transactional broker mail is frequently sorted there instead of the primary inbox." },
        { title: "Search your entire mailbox", html: "Search your entire mailbox for &ldquo;Tradovate,&rdquo; including All Mail, Archive, and Trash, in case a filter relocated it." },
        { title: "Wait and refresh", html: "Wait 10&ndash;15 minutes and refresh if nothing appears yet, to allow for provider delays or greylisting." },
        { title: "Mark it as not spam", html: "Mark it &ldquo;Not spam&rdquo; and add the sender to your contacts once you find it, so future verification and reset emails land in the inbox." },
      ],
    },
    { type: "heading", text: "Fixing It on a Prop-Firm or Evaluation Account" },
    {
      type: "steps",
      items: [
        { title: "Confirm what kind of account you have", html: "If you bought an evaluation or funded account from a prop firm, the login belongs to that firm." },
        { title: "Contact the firm directly", html: "Apex, Topstep, and other providers each run their own credential recovery. Tradovate can't reset an evaluation login for you." },
        { title: "Follow the firm's current recovery steps", html: "Portals and labels vary by firm and change over time, so check your firm's current instructions rather than assuming they match Tradovate's." },
      ],
    },
    { type: "heading", text: "Troubleshooting Table" },
    {
      type: "table",
      headers: ["Symptom / State", "What it means", "Fix"],
      rows: [
        ["No verification email after sign-up", "Message was sent but filtered, delayed, or sent to a mistyped address", "Check spam/junk/Promotions, verify the address on file, then resend from the login screen"],
        ["Reset email never arrives", "Delivered to spam, a wrong address, or requested for an evaluation login", "Resend via Forgot Password, search the whole mailbox, and confirm it isn't a prop-firm account"],
        ["Email arrives but the link says expired", "The verification or reset link has a limited lifetime", "Request a fresh link and open it promptly"],
        ["Multiple resets, still nothing in the inbox", "Repeated requests were flagged and filtered", "Stop resending, then check spam and junk folders"],
        ["Nothing at all on a prop-firm account", "Evaluation logins aren't resettable through Tradovate", "Contact your prop firm's support to recover the credentials"],
        ["Email in Gmail Promotions, not primary", "Transactional mail was auto-categorized", "Move it to Primary and mark the sender as a known contact"],
      ],
    },
    { type: "heading", text: "Prevent This with PickMyTrade" },
    { type: "paragraph", html: "Verification and reset headaches usually hit at the worst possible moment, mid-session, with a signal firing. Routing your TradingView alerts to Tradovate through PickMyTrade keeps your trading running through one managed, authenticated connection, so a single missing email doesn't stop your strategy from executing:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Single Persistent Session</strong>, connects once and holds an authenticated session, so a day-to-day login hiccup doesn't interrupt order flow.",
        "<strong class='text-white'>Automatic Token Renewal</strong>, refreshes access before it expires instead of forcing you back through the login and verification screens over and over.",
        "<strong class='text-white'>Alert-Driven Execution</strong>, your entries and exits fire straight from TradingView alerts, so a stalled password reset doesn't leave a position unmanaged.",
        "<strong class='text-white'>Multi-Account Sync</strong>, mirrors orders across several accounts from that one connection, instead of juggling separate manual logins that each risk their own recovery snag.",
      ],
    },
    { type: "paragraph", html: "Automation can't reset a password for you, but a stable connection means an occasional missing email becomes an inconvenience to sort out later, not the reason your trades stop firing." },
  ], de: [
    { type: "paragraph",html: "Sie haben sich registriert, auf &ldquo;Passwort zurücksetzen&rdquo; geklickt und starren nun auf einen leeren Posteingang, während der Markt ohne Sie weiterläuft. Eine fehlende Tradovate-Verifizierungs-E-Mail oder ein Link zum Zurücksetzen des Passworts, der nie ankommt, ist einer der häufigsten Gründe, warum Trader am Anmeldebildschirm hängen bleiben. Das Frustrierende daran: Die Nachricht wurde fast immer bereits gesendet. In neun von zehn Fällen wurde sie zugestellt und dann stillschweigend in einen Spam-, Junk- oder Gmail-Promotions-Ordner gefiltert. Manchmal muss sie einfach über den Hilfeablauf des Anmeldebildschirms erneut angefordert werden. Dieser Leitfaden zeigt jeden Grund, warum die E-Mail nicht erscheint, wie Sie sie erneut senden, wo Sie suchen, wenn sie verschwunden scheint, und warum Prop-Firmen- und Evaluationskonten einem völlig anderen Wiederherstellungsweg folgen." },
    {
      type: "checklist",
      heading: "Kurz-Checkliste bei fehlender Verifizierungs- oder Zurücksetzungs-E-Mail",
      items: [
        "<strong class='text-white'>Prüfen Sie zuerst Spam, Junk und den Gmail-Promotions-Tab.</strong> Dort werden Tradovates Nachrichten am häufigsten herausgefiltert, und für die meisten Trader erledigt das das Problem.",
        "<strong class='text-white'>Senden Sie sie über den Anmeldebildschirm erneut.</strong> Nutzen Sie den Ablauf &ldquo;Need help?&rdquo; / &ldquo;Forgot Password&rdquo;, um eine neue E-Mail auszulösen, statt auf die alte zu warten.",
        "<strong class='text-white'>Geben Sie ihr 10&ndash;15 Minuten.</strong> Verzögerungen beim E-Mail-Anbieter und Greylisting können die Nachricht kurz zurückhalten, bevor sie erscheint.",
        "<strong class='text-white'>Prüfen Sie, ob die hinterlegte E-Mail-Adresse korrekt ist.</strong> Ein Tippfehler bei der Registrierung schickt jede Nachricht an eine Adresse, die Sie nicht öffnen können.",
        "<strong class='text-white'>Durchsuchen Sie Ihr gesamtes Postfach nach &ldquo;Tradovate&rdquo;.</strong> Ein Filter oder eine Regel kann sie aus dem Posteingang in ein Archiv oder ein Label verschoben haben.",
        "<strong class='text-white'>Bei einem Prop-Firmen- oder Evaluationskonto wenden Sie sich an die Firma, nicht an Tradovate.</strong> Evaluationszugänge lassen sich nicht über Tradovates Standardablauf zurücksetzen.",
      ],
    },
    { type: "heading",text: "Was „Verifizierungs-/Zurücksetzungs-E-Mail kommt nicht an“ bedeutet" },
    { type: "paragraph",html: "Es gibt keinen einzelnen Fehlerdialog dafür, es ist ein Symptom, keine kodierte Meldung. Entweder haben Sie die Registrierung abgeschlossen und nie den Bestätigungslink erhalten, der das Konto aktiviert, oder Sie haben eine Benutzernamen-Erinnerung oder Passwort-Zurücksetzung angefordert, und die Folge-E-Mail kam nie an. Da die Plattform die E-Mail als &ldquo;gesendet&rdquo; erfasst, liegt die Störung fast immer auf der Zustellungsseite: ein Spam-Filter, eine falsch geschriebene Adresse oder eine Verzögerung des Mailservers zwischen Tradovates System und Ihrem Anbieter." },
    { type: "paragraph",html: "Behandeln Sie die Lösung als Routine. Wenn Sie die Verifizierungs-E-Mail nicht erhalten oder sie vor der Bestätigung gelöscht haben, können Sie sie direkt vom Anmeldebildschirm aus erneut senden. Und wenn Sie mehrere Benutzernamen- oder Passwort-Zurücksetzungen ausgelöst haben und noch immer nichts sehen, sind Ihre Spam- und Junk-Ordner die erste Anlaufstelle, denn dort liegt die &ldquo;fehlende&rdquo; Nachricht meistens. Das ist die wichtigste Erkenntnis dieser Seite: Die E-Mail ist normalerweise da, nur nicht in Ihrem Posteingang." },
    { type: "paragraph",html: "Die einzige echte Ausnahme ist ein Evaluations- oder Prop-Firmen-Konto. Diese Zugänge werden von der Finanzierungsfirma ausgestellt und kontrolliert, daher kann Tradovate Ihnen dafür gar keine Zurücksetzung senden. Wenn Sie eine Evaluation bei einer Firma wie Apex, Topstep oder einem anderen Anbieter gekauft haben, muss die Wiederherstellungs-E-Mail aus dem System dieser Firma kommen. Sie über den Tradovate-Anmeldebildschirm anzufordern, erzeugt nie eine Nachricht." },
    { type: "heading",text: "Die häufigsten Ursachen für eine fehlende Tradovate-E-Mail" },
    { type: "heading",text: "1. Sie ist im Spam, Junk oder Promotions-Tab gelandet" },
    { type: "paragraph",html: "Das ist mit Abstand die häufigste Ursache. Automatisierte Transaktions-E-Mails eines Brokers sind ein häufiges Ziel aggressiver Spam-Filter, und besonders Gmail leitet sie gern in den Tab <strong class='text-white'>Promotions</strong> statt in den Haupt-Posteingang um. Prüfen Sie zuerst Spam und Junk, dort taucht die &ldquo;fehlende&rdquo; Nachricht meistens auf." },
    { type: "heading",text: "2. Die hinterlegte E-Mail-Adresse enthält einen Tippfehler" },
    { type: "paragraph",html: "Wenn bei der Registrierung ein Zeichen falsch war, etwa <code>.co</code> statt <code>.com</code>, ein vertauschter Buchstabe oder die falsche Domain, geht jede Verifizierungs- und Zurücksetzungsnachricht an eine Adresse, die Sie nicht kontrollieren. Nichts erreicht Ihren echten Posteingang, egal wie oft Sie erneut senden. Bei einem brandneuen, unbestätigten Konto lohnt es sich, das früh zu prüfen." },
    { type: "heading",text: "3. Eine Verzögerung beim E-Mail-Anbieter oder Greylisting" },
    { type: "paragraph",html: "Transaktions-E-Mails sind nicht immer sofort da. Manche Mailserver nutzen Greylisting, das den ersten Zustellversuch eines unbekannten Absenders absichtlich zurückstellt und ihn erst bei einem erneuten Versuch einige Minuten später annimmt. Oft genügt eine kurze Wartezeit von 10&ndash;15 Minuten, damit eine verzögerte E-Mail ankommt." },
    { type: "heading",text: "4. Sie nutzen ein Prop-Firmen- oder Evaluationskonto" },
    { type: "paragraph",html: "Evaluations- und Funded-Zugänge gehören der Prop-Firma, nicht Tradovate. Der Standardablauf für Benutzernamen-Wiederherstellung und Passwort-Zurücksetzung gilt für sie nicht, und eine Zurücksetzung über den Tradovate-Anmeldebildschirm erzeugt schlicht keine E-Mail. Die Zurücksetzung muss im Portal oder Support-Kanal der Firma beginnen." },
    { type: "heading",text: "5. Ein Postfachfilter oder eine Regel hat sie verschoben" },
    { type: "paragraph",html: "Wenn Sie jemals Posteingangsregeln eingerichtet haben, kann ein Filter eingehende Nachrichten bestimmter Absender oder Stichwörter stillschweigend archivieren, kennzeichnen oder löschen. Die Nachricht wurde ordnungsgemäß zugestellt, sie ist nur nie in Ihrem Posteingang gelandet. Deshalb lohnt sich eine Suche im gesamten Postfach nach &ldquo;Tradovate&rdquo; (einschließlich Archiv, Alle Nachrichten und Papierkorb), bevor Sie annehmen, sie sei nie gesendet worden." },
    { type: "heading",text: "Fehlende Verifizierungs- oder Zurücksetzungs-E-Mail beheben: Schritt für Schritt" },
    { type: "heading",text: "E-Mail vom Anmeldebildschirm erneut senden" },
    {
      type: "steps",
      items: [
        { title: "Zum Tradovate-Anmeldebildschirm gehen", html: "Gehen Sie im Web oder auf dem Desktop zum Tradovate-Anmeldebildschirm." },
        { title: "Hilfeoption auswählen", html: "Suchen Sie unterhalb der Anmeldefelder nach einer Aufforderung &ldquo;Need help?&rdquo; (oder dem Link &ldquo;Forgot Password&rdquo;). Die Bezeichnung dieses Links ändert sich zwischen Plattform-Updates, verwenden Sie daher die Option, die zur Kontowiederherstellung führt." },
        { title: "Gewünschte Wiederherstellungsaktion wählen", html: "Das Zurücksetzen des Passworts oder die Wiederherstellung des Benutzernamens löst ebenfalls eine neue E-Mail aus, genau das, was Sie wollen, wenn eine Verifizierungsnachricht verloren gegangen ist." },
        { title: "Benutzernamen oder E-Mail eingeben und absenden", html: "Geben Sie Ihren Benutzernamen oder die mit dem Konto verknüpfte E-Mail ein und senden Sie ab. Die neue Nachricht geht an die hinterlegte E-Mail-Adresse." },
      ],
    },
    { type: "heading",text: "Benutzernamen wiederherstellen oder Passwort zurücksetzen" },
    {
      type: "steps",
      items: [
        { title: "Die richtige Wiederherstellungsoption wählen", html: "Wählen Sie auf der Wiederherstellungsseite die passende Option. Um Ihren Benutzernamen zurückzuerhalten, wählen Sie <strong class='text-white'>Retrieve Username</strong> und geben Sie die E-Mail-Adresse des Kontos ein, Ihr Benutzername wird dann an die hinterlegte E-Mail gesendet. Um ein vergessenes Passwort zurückzusetzen, wählen Sie <strong class='text-white'>Reset Password</strong>, geben Sie Ihren Benutzernamen oder Ihre E-Mail ein, und die Anweisungen zum Zurücksetzen werden Ihnen per E-Mail zugeschickt." },
        { title: "Die tatsächlich registrierte Adresse verwenden", html: "Wiederherstellungs-E-Mails gehen nur an die hinterlegte E-Mail-Adresse, eine andere Adresse liefert daher nichts." },
        { title: "Einmal absenden und warten", html: "Senden Sie einmal ab und warten Sie, statt wiederholt Anfragen zu stellen. Mehrere schnelle Zurücksetzungen sind genau das Szenario, in dem Nachrichten gefiltert werden, und genau diese finden Sie meist im Spam-Ordner." },
      ],
    },
    { type: "heading",text: "E-Mail finden, wenn sie verschwunden scheint" },
    {
      type: "steps",
      items: [
        { title: "Spam- und Junk-Ordner öffnen", html: "Öffnen Sie Ihre Spam- und Junk-Ordner und suchen Sie nach einer aktuellen Tradovate-Nachricht. Das ist die erste Stelle, die Sie prüfen sollten, und sie löst das Problem für die meisten." },
        { title: "Promotions-Tab prüfen", html: "Prüfen Sie den Promotions-Tab, wenn Sie Gmail nutzen, Transaktions-E-Mails von Brokern werden dort häufig statt im Haupt-Posteingang einsortiert." },
        { title: "Gesamtes Postfach durchsuchen", html: "Durchsuchen Sie Ihr gesamtes Postfach nach &ldquo;Tradovate&rdquo;, einschließlich Alle Nachrichten, Archiv und Papierkorb, falls ein Filter sie verschoben hat." },
        { title: "Warten und aktualisieren", html: "Warten Sie 10&ndash;15 Minuten und aktualisieren Sie, falls noch nichts erscheint, um Anbieterverzögerungen oder Greylisting zu berücksichtigen." },
        { title: "Als „Kein Spam“ markieren", html: "Markieren Sie sie als &ldquo;Kein Spam&rdquo; und fügen Sie den Absender Ihren Kontakten hinzu, sobald Sie sie gefunden haben, damit künftige Verifizierungs- und Zurücksetzungs-E-Mails im Posteingang landen." },
      ],
    },
    { type: "heading",text: "Beheben bei einem Prop-Firmen- oder Evaluationskonto" },
    {
      type: "steps",
      items: [
        { title: "Kontotyp bestätigen", html: "Wenn Sie ein Evaluations- oder Funded-Konto bei einer Prop-Firma gekauft haben, gehört der Zugang dieser Firma." },
        { title: "Die Firma direkt kontaktieren", html: "Apex, Topstep und andere Anbieter betreiben jeweils ihre eigene Zugangsdaten-Wiederherstellung. Tradovate kann einen Evaluationszugang nicht für Sie zurücksetzen." },
        { title: "Den aktuellen Wiederherstellungsschritten der Firma folgen", html: "Portale und Bezeichnungen unterscheiden sich je nach Firma und ändern sich im Lauf der Zeit. Prüfen Sie daher die aktuellen Anweisungen Ihrer Firma, statt anzunehmen, dass sie denen von Tradovate entsprechen." },
      ],
    },
    { type: "heading",text: "Fehlerbehebungstabelle" },
    { type: "table", headers: ["Symptom / Zustand","Bedeutung","Lösung"], rows: [
      ["Keine Verifizierungs-E-Mail nach der Registrierung","Die Nachricht wurde gesendet, aber gefiltert, verzögert oder an eine falsch geschriebene Adresse zugestellt","Spam/Junk/Promotions prüfen, hinterlegte Adresse verifizieren, dann über den Anmeldebildschirm erneut senden"],
      ["Zurücksetzungs-E-Mail kommt nie an","In Spam zugestellt, an eine falsche Adresse oder für einen Evaluationszugang angefordert","Über Forgot Password erneut senden, das gesamte Postfach durchsuchen und prüfen, ob es kein Prop-Firmen-Konto ist"],
      ["E-Mail kommt an, aber der Link ist abgelaufen","Der Verifizierungs- oder Zurücksetzungslink hat eine begrenzte Lebensdauer","Einen neuen Link anfordern und ihn zügig öffnen"],
      ["Mehrere Zurücksetzungen, trotzdem nichts im Posteingang","Wiederholte Anfragen wurden markiert und gefiltert","Nicht mehr erneut senden, dann Spam- und Junk-Ordner prüfen"],
      ["Gar nichts bei einem Prop-Firmen-Konto","Evaluationszugänge lassen sich nicht über Tradovate zurücksetzen","Den Support Ihrer Prop-Firma kontaktieren, um die Zugangsdaten wiederherzustellen"],
      ["E-Mail liegt in Gmail Promotions, nicht im Haupt-Posteingang","Transaktions-E-Mail wurde automatisch kategorisiert","In den Haupt-Posteingang (Primary) verschieben und den Absender als bekannten Kontakt markieren"],
    ] },
    { type: "heading",text: "Mit PickMyTrade vorbeugen" },
    { type: "paragraph",html: "Verifizierungs- und Zurücksetzungsprobleme treffen Sie meist im ungünstigsten Moment, mitten in der Sitzung, wenn ein Signal feuert. Wenn Sie Ihre TradingView-Alerts über PickMyTrade an Tradovate leiten, läuft Ihr Handel über eine verwaltete, authentifizierte Verbindung weiter, sodass eine einzelne fehlende E-Mail Ihre Strategie nicht an der Ausführung hindert:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Einzelne dauerhafte Sitzung</strong>, verbindet sich einmal und hält eine authentifizierte Sitzung, sodass ein alltäglicher Anmeldeschluckauf den Orderfluss nicht unterbricht.",
        "<strong class='text-white'>Automatische Token-Erneuerung</strong>, erneuert den Zugang, bevor er abläuft, statt Sie immer wieder durch die Anmelde- und Verifizierungsbildschirme zu schicken.",
        "<strong class='text-white'>Alert-gesteuerte Ausführung</strong>, Ihre Einstiege und Ausstiege feuern direkt aus TradingView-Alerts, sodass eine hängende Passwort-Zurücksetzung keine Position unverwaltet lässt.",
        "<strong class='text-white'>Multi-Konto-Synchronisierung</strong>, spiegelt Orders über mehrere Konten von dieser einen Verbindung aus, statt getrennte manuelle Anmeldungen zu jonglieren, die jeweils ihren eigenen Wiederherstellungsärger riskieren.",
      ],
    },
    { type: "paragraph",html: "Automatisierung kann kein Passwort für Sie zurücksetzen, aber eine stabile Verbindung bedeutet, dass eine gelegentlich fehlende E-Mail zu einer Unannehmlichkeit wird, die Sie später klären, und nicht zum Grund, warum Ihre Trades nicht mehr feuern." },
  ], es: [
    { type: "paragraph",html: "Se registró, hizo clic en &ldquo;restablecer contraseña&rdquo; y ahora mira una bandeja de entrada vacía mientras el mercado sigue moviéndose sin usted. Un correo de verificación de Tradovate que no aparece, o un enlace de restablecimiento de contraseña que nunca llega, es una de las razones más comunes por las que los traders se quedan atascados en la pantalla de inicio de sesión. Lo frustrante es que el mensaje casi siempre ya se envió. En nueve de cada diez casos se entregó y luego se filtró discretamente a una carpeta de spam, correo no deseado o a la pestaña Promociones de Gmail. A veces solo hace falta solicitarlo de nuevo desde el flujo de ayuda de la pantalla de inicio de sesión. Esta guía repasa todas las razones por las que el correo no aparece, cómo reenviarlo, dónde buscar cuando parece haberse esfumado y por qué las cuentas de prop firm y de evaluación siguen una vía de recuperación completamente distinta." },
    {
      type: "checklist",
      heading: "Lista de verificación rápida para un correo de verificación o restablecimiento ausente",
      items: [
        "<strong class='text-white'>Revise primero spam, correo no deseado y la pestaña Promociones de Gmail.</strong> Es donde con más frecuencia se filtran los mensajes de Tradovate, y resuelve el problema para la mayoría de los traders.",
        "<strong class='text-white'>Reenvíelo desde la pantalla de inicio de sesión.</strong> Use el flujo &ldquo;Need help?&rdquo; / &ldquo;Forgot Password&rdquo; para generar un correo nuevo en lugar de esperar al anterior.",
        "<strong class='text-white'>Dele 10&ndash;15 minutos.</strong> Los retrasos del proveedor de correo y el greylisting pueden retener brevemente el mensaje antes de que aparezca.",
        "<strong class='text-white'>Confirme que la dirección de correo registrada es correcta.</strong> Un error tipográfico al registrarse envía todos los mensajes a una dirección que no puede abrir.",
        "<strong class='text-white'>Busque &ldquo;Tradovate&rdquo; en todo su buzón.</strong> Un filtro o regla puede haberlo movido de la bandeja de entrada a un archivo o a una etiqueta.",
        "<strong class='text-white'>En una cuenta de prop firm o de evaluación, contacte con la firma, no con Tradovate.</strong> Los accesos de evaluación no se pueden restablecer con el flujo estándar de Tradovate.",
      ],
    },
    { type: "heading",text: "Qué significa «correo de verificación/restablecimiento no llega»" },
    { type: "paragraph",html: "No hay un único cuadro de error para esto: es un síntoma, no un mensaje codificado. O bien terminó el registro y nunca recibió el enlace de confirmación que activa la cuenta, o bien pidió un recordatorio de usuario o un restablecimiento de contraseña y el correo posterior nunca apareció. Como la plataforma registra el correo como &ldquo;enviado&rdquo;, el fallo casi siempre está en la entrega: un filtro de spam, una dirección con errores o un retraso del servidor de correo entre el sistema de Tradovate y su proveedor." },
    { type: "paragraph",html: "Trate la solución como algo rutinario. Si no recibió el correo de verificación, o lo eliminó antes de confirmar, puede reenviarlo desde la propia pantalla de inicio de sesión. Y si ha lanzado varios restablecimientos de usuario o contraseña y sigue sin ver nada, sus carpetas de spam y correo no deseado son el primer lugar donde mirar, porque ahí es donde el mensaje &ldquo;perdido&rdquo; suele estar. Esa es la conclusión más importante de esta página: el correo normalmente está ahí, solo que no en su bandeja de entrada." },
    { type: "paragraph",html: "La única excepción real es una cuenta de evaluación o de prop firm. Esos accesos los emite y controla la empresa de financiación, por lo que Tradovate no puede enviarle un restablecimiento para ellos. Si compró una evaluación a una firma como Apex, Topstep u otro proveedor, el correo de recuperación debe salir del sistema de esa firma; reclamarlo desde la pantalla de inicio de sesión de Tradovate nunca generará un mensaje." },
    { type: "heading",text: "Principales causas de un correo de Tradovate ausente" },
    { type: "heading",text: "1. Terminó en spam, correo no deseado o la pestaña Promociones" },
    { type: "paragraph",html: "Esta es la causa número uno con diferencia. El correo transaccional automatizado de un bróker es un objetivo frecuente de filtros de spam agresivos, y Gmail en particular suele enviarlo a la pestaña <strong class='text-white'>Promociones</strong> en lugar de a la bandeja principal. Revise primero spam y correo no deseado: ahí suele aparecer el mensaje &ldquo;perdido&rdquo;." },
    { type: "heading",text: "2. La dirección de correo registrada tiene un error tipográfico" },
    { type: "paragraph",html: "Si un carácter estaba mal al registrarse, un <code>.co</code> en lugar de <code>.com</code>, una letra cambiada, el dominio equivocado, todos los mensajes de verificación y restablecimiento van a una dirección que no controla. Nada llegará nunca a su bandeja real por muchas veces que reenvíe. Si la cuenta es nueva y no está confirmada, conviene revisarlo pronto." },
    { type: "heading",text: "3. Un retraso del proveedor de correo o greylisting" },
    { type: "paragraph",html: "El correo transaccional no siempre es instantáneo. Algunos servidores de correo usan greylisting, que aplaza deliberadamente el primer intento de entrega de un remitente desconocido y solo lo acepta en un reintento unos minutos después. Una breve espera de 10&ndash;15 minutos suele bastar para que llegue un correo retrasado." },
    { type: "heading",text: "4. Tiene una cuenta de prop firm o de evaluación" },
    { type: "paragraph",html: "Los accesos de evaluación y de cuentas fondeadas son de la prop firm, no de Tradovate. El flujo estándar de recuperación de usuario y restablecimiento de contraseña no se aplica a ellos, y solicitar un restablecimiento desde la pantalla de inicio de sesión de Tradovate simplemente no generará un correo. El restablecimiento debe comenzar en el portal o canal de soporte de la propia firma." },
    { type: "heading",text: "5. Un filtro o regla del buzón lo movió" },
    { type: "paragraph",html: "Si alguna vez configuró reglas de bandeja de entrada, un filtro puede archivar, etiquetar o eliminar discretamente el correo entrante que coincida con ciertos remitentes o palabras clave. El mensaje se entregó bien, solo que nunca llegó a su bandeja de entrada. Por eso conviene hacer una búsqueda en todo el buzón de &ldquo;Tradovate&rdquo; (incluidos Archivo, Todos los mensajes y Papelera) antes de asumir que nunca se envió." },
    { type: "heading",text: "Cómo solucionar un correo de verificación o restablecimiento ausente: paso a paso" },
    { type: "heading",text: "Reenvío del correo desde la pantalla de inicio de sesión" },
    {
      type: "steps",
      items: [
        { title: "Vaya a la pantalla de inicio de sesión de Tradovate", html: "Vaya a la pantalla de inicio de sesión de Tradovate en la web o en el escritorio." },
        { title: "Seleccione la opción de ayuda", html: "Busque un aviso &ldquo;Need help?&rdquo; (o el enlace &ldquo;Forgot Password&rdquo;) debajo de los campos de acceso. La redacción de este enlace cambia entre actualizaciones de la plataforma, así que use la opción que lleve a la recuperación de la cuenta." },
        { title: "Elija la acción de recuperación que necesita", html: "Restablecer la contraseña o recuperar el nombre de usuario también genera un correo nuevo, que es justo lo que quiere cuando un mensaje de verificación se ha perdido." },
        { title: "Introduzca su usuario o correo y envíe", html: "Introduzca su nombre de usuario o el correo asociado a la cuenta y envíe. El nuevo mensaje va a la dirección de correo registrada." },
      ],
    },
    { type: "heading",text: "Recuperación del nombre de usuario o restablecimiento de la contraseña" },
    {
      type: "steps",
      items: [
        { title: "Elija la opción de recuperación correcta", html: "En la página de recuperación, elija la opción correcta. Para recuperar su nombre de usuario, elija <strong class='text-white'>Retrieve Username</strong> e introduzca la dirección de correo de la cuenta, su nombre de usuario se envía entonces al correo registrado. Para restablecer una contraseña olvidada, elija <strong class='text-white'>Reset Password</strong>, introduzca su nombre de usuario o correo y recibirá las instrucciones de restablecimiento por correo." },
        { title: "Use la dirección con la que realmente se registró", html: "El correo de recuperación solo se envía a la dirección registrada, así que una dirección distinta no devuelve nada." },
        { title: "Envíe una vez y espere", html: "Envíe una sola vez y espere en lugar de lanzar solicitudes repetidas. Varios restablecimientos rápidos son justo el escenario en el que se filtran mensajes, y esos son los que normalmente encontrará esperando en la carpeta de spam." },
      ],
    },
    { type: "heading",text: "Cómo encontrar el correo cuando parece haber desaparecido" },
    {
      type: "steps",
      items: [
        { title: "Abra las carpetas de spam y correo no deseado", html: "Abra sus carpetas de spam y correo no deseado y busque un mensaje reciente de Tradovate. Es el primer lugar que debe revisar y resuelve el problema para la mayoría." },
        { title: "Revise la pestaña Promociones", html: "Revise la pestaña Promociones si usa Gmail: el correo transaccional de brókers suele clasificarse allí en lugar de en la bandeja principal." },
        { title: "Busque en todo el buzón", html: "Busque &ldquo;Tradovate&rdquo; en todo su buzón, incluidos Todos los mensajes, Archivo y Papelera, por si un filtro lo reubicó." },
        { title: "Espere y actualice", html: "Espere 10&ndash;15 minutos y actualice si aún no aparece nada, para dar margen a retrasos del proveedor o greylisting." },
        { title: "Márquelo como no spam", html: "Márquelo como &ldquo;No es spam&rdquo; y añada el remitente a sus contactos cuando lo encuentre, para que los futuros correos de verificación y restablecimiento lleguen a la bandeja de entrada." },
      ],
    },
    { type: "heading",text: "Solución en una cuenta de prop firm o de evaluación" },
    {
      type: "steps",
      items: [
        { title: "Confirme qué tipo de cuenta tiene", html: "Si compró una cuenta de evaluación o fondeada de una prop firm, el acceso pertenece a esa firma." },
        { title: "Contacte directamente con la firma", html: "Apex, Topstep y otros proveedores gestionan cada uno su propia recuperación de credenciales. Tradovate no puede restablecer por usted un acceso de evaluación." },
        { title: "Siga los pasos de recuperación actuales de la firma", html: "Los portales y las etiquetas varían según la firma y cambian con el tiempo, así que consulte las instrucciones actuales de su firma en lugar de asumir que coinciden con las de Tradovate." },
      ],
    },
    { type: "heading",text: "Tabla de solución de problemas" },
    { type: "table", headers: ["Síntoma / estado","Qué significa","Solución"], rows: [
      ["No llega correo de verificación tras el registro","El mensaje se envió pero se filtró, se retrasó o se envió a una dirección con errores","Revise spam/no deseado/Promociones, verifique la dirección registrada y luego reenvíelo desde la pantalla de inicio de sesión"],
      ["El correo de restablecimiento nunca llega","Entregado en spam, a una dirección equivocada o solicitado para un acceso de evaluación","Reenvíelo con Forgot Password, busque en todo el buzón y confirme que no es una cuenta de prop firm"],
      ["El correo llega pero el enlace dice que caducó","El enlace de verificación o restablecimiento tiene una vigencia limitada","Solicite un enlace nuevo y ábralo de inmediato"],
      ["Varios restablecimientos y sigue sin llegar nada a la bandeja de entrada","Las solicitudes repetidas se marcaron y se filtraron","Deje de reenviar y revise las carpetas de spam y correo no deseado"],
      ["No llega nada en una cuenta de prop firm","Los accesos de evaluación no se pueden restablecer a través de Tradovate","Contacte con el soporte de su prop firm para recuperar las credenciales"],
      ["El correo está en Promociones de Gmail, no en la principal","El correo transaccional se categorizó automáticamente","Muévalo a Principal (Primary) y marque al remitente como contacto conocido"],
    ] },
    { type: "heading",text: "Prevéngalo con PickMyTrade" },
    { type: "paragraph",html: "Los problemas de verificación y restablecimiento suelen aparecer en el peor momento, a mitad de sesión, con una señal disparándose. Enrutar sus alertas de TradingView a Tradovate a través de PickMyTrade mantiene su operativa funcionando a través de una conexión gestionada y autenticada, de modo que un solo correo ausente no detiene la ejecución de su estrategia:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Sesión única y persistente</strong>, se conecta una vez y mantiene una sesión autenticada, de modo que un contratiempo cotidiano de inicio de sesión no interrumpe el flujo de órdenes.",
        "<strong class='text-white'>Renovación automática de tokens</strong>, renueva el acceso antes de que caduque en lugar de obligarle a pasar una y otra vez por las pantallas de inicio de sesión y verificación.",
        "<strong class='text-white'>Ejecución basada en alertas</strong>, sus entradas y salidas se disparan directamente desde las alertas de TradingView, de modo que un restablecimiento de contraseña estancado no deja una posición sin gestionar.",
        "<strong class='text-white'>Sincronización multicuenta</strong>, replica órdenes en varias cuentas desde esa única conexión, en lugar de manejar inicios de sesión manuales separados que arriesgan cada uno su propio problema de recuperación.",
      ],
    },
    { type: "paragraph",html: "La automatización no puede restablecer una contraseña por usted, pero una conexión estable hace que un correo ausente ocasional sea un inconveniente que resolver más tarde, no la razón por la que sus operaciones dejan de dispararse." },
  ], fr: [
    { type: "paragraph",html: "Vous vous êtes inscrit, vous avez cliqué sur &ldquo;réinitialiser le mot de passe&rdquo; et vous fixez maintenant une boîte de réception vide pendant que le marché continue d'avancer sans vous. Un e-mail de vérification Tradovate manquant, ou un lien de réinitialisation de mot de passe qui n'arrive jamais, est l'une des raisons les plus courantes pour lesquelles les traders restent bloqués sur l'écran de connexion. Le paradoxe frustrant : le message a presque toujours déjà été envoyé. Dans neuf cas sur dix, il a été livré, puis discrètement filtré vers un dossier de spams, d'indésirables ou l'onglet Promotions de Gmail. Parfois, il suffit de le redemander depuis le parcours d'aide de l'écran de connexion. Ce guide passe en revue toutes les raisons pour lesquelles l'e-mail n'apparaît pas, comment le renvoyer, où chercher quand il semble avoir disparu, et pourquoi les comptes de prop firm et d'évaluation suivent une voie de récupération totalement différente." },
    {
      type: "checklist",
      heading: "Liste de contrôle rapide pour un e-mail de vérification ou de réinitialisation manquant",
      items: [
        "<strong class='text-white'>Vérifiez d'abord les spams, les indésirables et l'onglet Promotions de Gmail.</strong> C'est là que les messages de Tradovate sont le plus souvent filtrés, et cela règle le problème pour la plupart des traders.",
        "<strong class='text-white'>Renvoyez-le depuis l'écran de connexion.</strong> Utilisez le parcours &ldquo;Need help?&rdquo; / &ldquo;Forgot Password&rdquo; pour déclencher un nouvel e-mail plutôt que d'attendre l'ancien.",
        "<strong class='text-white'>Laissez-lui 10&ndash;15 minutes.</strong> Les retards du fournisseur de messagerie et le greylisting peuvent retenir brièvement le message avant qu'il n'apparaisse.",
        "<strong class='text-white'>Vérifiez que l'adresse e-mail enregistrée est correcte.</strong> Une faute de frappe à l'inscription envoie tous les messages vers une adresse que vous ne pouvez pas ouvrir.",
        "<strong class='text-white'>Cherchez &ldquo;Tradovate&rdquo; dans toute votre boîte.</strong> Un filtre ou une règle a peut-être déplacé le message de la boîte de réception vers des archives ou un libellé.",
        "<strong class='text-white'>Sur un compte de prop firm ou d'évaluation, contactez la société, pas Tradovate.</strong> Les identifiants d'évaluation ne peuvent pas être réinitialisés via le parcours standard de Tradovate.",
      ],
    },
    { type: "heading",text: "Ce que signifie « e-mail de vérification / réinitialisation non reçu »" },
    { type: "paragraph",html: "Il n'existe pas de boîte d'erreur unique pour cela : c'est un symptôme, pas un message codé. Soit vous avez terminé l'inscription sans jamais recevoir le lien de confirmation qui active le compte, soit vous avez demandé un rappel de nom d'utilisateur ou une réinitialisation de mot de passe et l'e-mail de suivi n'est jamais arrivé. Comme la plateforme enregistre l'e-mail comme &ldquo;envoyé&rdquo;, la défaillance se situe presque toujours côté livraison : un filtre anti-spam, une adresse mal saisie ou un retard de serveur de messagerie entre le système de Tradovate et votre fournisseur." },
    { type: "paragraph",html: "Traitez la solution comme une routine. Si vous n'avez pas reçu l'e-mail de vérification, ou si vous l'avez supprimé avant de confirmer, vous pouvez le renvoyer directement depuis l'écran de connexion. Et si vous avez lancé plusieurs réinitialisations de nom d'utilisateur ou de mot de passe sans rien voir, vos dossiers de spams et d'indésirables sont le premier endroit où regarder, car c'est là que le message &ldquo;manquant&rdquo; se trouve généralement. C'est le point le plus important de cette page : l'e-mail est généralement bien là, simplement pas dans votre boîte de réception." },
    { type: "paragraph",html: "La seule vraie exception est un compte d'évaluation ou de prop firm. Ces identifiants sont délivrés et contrôlés par la société de financement ; Tradovate ne peut donc pas vous envoyer de réinitialisation pour eux. Si vous avez acheté une évaluation auprès d'une société comme Apex, Topstep ou un autre fournisseur, l'e-mail de récupération doit provenir du système de cette société : le réclamer via l'écran de connexion de Tradovate ne produira jamais de message." },
    { type: "heading",text: "Principales causes d'un e-mail Tradovate manquant" },
    { type: "heading",text: "1. Il a atterri dans les spams, les indésirables ou l'onglet Promotions" },
    { type: "paragraph",html: "C'est de loin la cause numéro un. Les e-mails transactionnels automatisés d'un courtier sont une cible fréquente des filtres anti-spam agressifs, et Gmail en particulier aime les router vers l'onglet <strong class='text-white'>Promotions</strong> plutôt que vers la boîte principale. Vérifiez d'abord les spams et les indésirables : c'est là que le message &ldquo;manquant&rdquo; se retrouve généralement." },
    { type: "heading",text: "2. L'adresse e-mail enregistrée contient une faute de frappe" },
    { type: "paragraph",html: "Si un caractère était erroné lors de l'inscription, un <code>.co</code> au lieu de <code>.com</code>, une lettre inversée, un mauvais domaine, chaque message de vérification et de réinitialisation part vers une adresse que vous ne contrôlez pas. Rien n'atteindra jamais votre vraie boîte de réception, quel que soit le nombre de renvois. Si le compte est tout neuf et non confirmé, cela vaut la peine d'être revérifié tôt." },
    { type: "heading",text: "3. Un retard du fournisseur de messagerie ou du greylisting" },
    { type: "paragraph",html: "Les e-mails transactionnels ne sont pas toujours instantanés. Certains serveurs de messagerie utilisent le greylisting, qui diffère volontairement la première tentative de livraison d'un expéditeur inconnu et ne l'accepte qu'à une nouvelle tentative quelques minutes plus tard. Une courte attente de 10&ndash;15 minutes suffit souvent pour qu'un e-mail retardé arrive." },
    { type: "heading",text: "4. Vous êtes sur un compte de prop firm ou d'évaluation" },
    { type: "paragraph",html: "Les identifiants d'évaluation et de compte financé appartiennent à la société de prop trading, pas à Tradovate. Le parcours standard de récupération du nom d'utilisateur et de réinitialisation du mot de passe ne s'y applique pas, et demander une réinitialisation via l'écran de connexion de Tradovate ne générera tout simplement aucun e-mail. La réinitialisation doit partir du portail ou du canal de support de la société elle-même." },
    { type: "heading",text: "5. Un filtre ou une règle de la boîte l'a déplacé" },
    { type: "paragraph",html: "Si vous avez déjà configuré des règles de boîte de réception, un filtre peut archiver, étiqueter ou supprimer discrètement les e-mails entrants correspondant à certains expéditeurs ou mots-clés. Le message a bien été livré, il n'a simplement jamais atteint votre boîte de réception. C'est pourquoi une recherche de &ldquo;Tradovate&rdquo; dans toute la boîte (y compris Archives, Tous les messages et Corbeille) vaut la peine avant de supposer qu'il n'a jamais été envoyé." },
    { type: "heading",text: "Comment corriger un e-mail de vérification ou de réinitialisation manquant : pas à pas" },
    { type: "heading",text: "Renvoyer l'e-mail depuis l'écran de connexion" },
    {
      type: "steps",
      items: [
        { title: "Accédez à l'écran de connexion de Tradovate", html: "Accédez à l'écran de connexion de Tradovate sur le web ou le bureau." },
        { title: "Sélectionnez l'option d'aide", html: "Cherchez une invite &ldquo;Need help?&rdquo; (ou le lien &ldquo;Forgot Password&rdquo;) sous les champs de connexion. Le libellé de ce lien change d'une mise à jour de la plateforme à l'autre ; utilisez donc l'option qui mène à la récupération du compte." },
        { title: "Choisissez l'action de récupération voulue", html: "Réinitialiser le mot de passe ou récupérer le nom d'utilisateur déclenche aussi un nouvel e-mail, ce qui est exactement ce qu'il vous faut lorsqu'un message de vérification a disparu." },
        { title: "Saisissez votre nom d'utilisateur ou e-mail et validez", html: "Saisissez votre nom d'utilisateur ou l'e-mail associé au compte, puis validez. Le nouveau message est envoyé à l'adresse e-mail enregistrée." },
      ],
    },
    { type: "heading",text: "Récupérer votre nom d'utilisateur ou réinitialiser votre mot de passe" },
    {
      type: "steps",
      items: [
        { title: "Choisissez la bonne option de récupération", html: "Sur la page de récupération, choisissez la bonne option. Pour récupérer votre nom d'utilisateur, choisissez <strong class='text-white'>Retrieve Username</strong> et saisissez l'adresse e-mail du compte ; votre nom d'utilisateur est alors envoyé à l'e-mail enregistré. Pour réinitialiser un mot de passe oublié, choisissez <strong class='text-white'>Reset Password</strong>, saisissez votre nom d'utilisateur ou votre e-mail, et les instructions de réinitialisation vous sont envoyées par e-mail." },
        { title: "Utilisez l'adresse avec laquelle vous vous êtes réellement inscrit", html: "Le courrier de récupération n'est envoyé qu'à l'e-mail enregistré ; une adresse différente ne renvoie donc rien." },
        { title: "Validez une fois et patientez", html: "Validez une seule fois et patientez au lieu de multiplier les demandes. Les réinitialisations rapides et multiples sont justement le scénario où les messages sont filtrés, et ce sont ceux que vous trouverez généralement en attente dans le dossier de spams." },
      ],
    },
    { type: "heading",text: "Retrouver l'e-mail quand il semble avoir disparu" },
    {
      type: "steps",
      items: [
        { title: "Ouvrez les dossiers de spams et d'indésirables", html: "Ouvrez vos dossiers de spams et d'indésirables et cherchez un message récent de Tradovate. C'est le premier endroit à vérifier, et cela règle le problème pour la plupart des gens." },
        { title: "Vérifiez l'onglet Promotions", html: "Vérifiez l'onglet Promotions si vous utilisez Gmail : les e-mails transactionnels de courtiers y sont souvent classés plutôt que dans la boîte principale." },
        { title: "Cherchez dans toute votre boîte", html: "Cherchez &ldquo;Tradovate&rdquo; dans toute votre boîte, y compris Tous les messages, Archives et Corbeille, au cas où un filtre l'aurait déplacé." },
        { title: "Patientez et actualisez", html: "Patientez 10&ndash;15 minutes et actualisez si rien n'apparaît encore, pour tenir compte des retards du fournisseur ou du greylisting." },
        { title: "Marquez-le comme non spam", html: "Marquez-le &ldquo;Non spam&rdquo; et ajoutez l'expéditeur à vos contacts une fois que vous l'avez trouvé, afin que les futurs e-mails de vérification et de réinitialisation arrivent dans la boîte de réception." },
      ],
    },
    { type: "heading",text: "Résoudre le problème sur un compte de prop firm ou d'évaluation" },
    {
      type: "steps",
      items: [
        { title: "Confirmez le type de compte dont vous disposez", html: "Si vous avez acheté un compte d'évaluation ou financé auprès d'une prop firm, l'identifiant appartient à cette société." },
        { title: "Contactez directement la société", html: "Apex, Topstep et d'autres fournisseurs gèrent chacun leur propre récupération d'identifiants. Tradovate ne peut pas réinitialiser un identifiant d'évaluation à votre place." },
        { title: "Suivez les étapes de récupération actuelles de la société", html: "Les portails et les libellés varient selon la société et évoluent avec le temps ; consultez donc les instructions actuelles de votre société plutôt que de supposer qu'elles correspondent à celles de Tradovate." },
      ],
    },
    { type: "heading",text: "Tableau de dépannage" },
    { type: "table", headers: ["Symptôme / état","Signification","Solution"], rows: [
      ["Aucun e-mail de vérification après l'inscription","Le message a été envoyé mais filtré, retardé ou expédié vers une adresse mal saisie","Vérifiez spams/indésirables/Promotions, contrôlez l'adresse enregistrée, puis renvoyez-le depuis l'écran de connexion"],
      ["L'e-mail de réinitialisation n'arrive jamais","Livré dans les spams, vers une mauvaise adresse ou demandé pour un identifiant d'évaluation","Renvoyez via Forgot Password, cherchez dans toute la boîte et vérifiez qu'il ne s'agit pas d'un compte de prop firm"],
      ["L'e-mail arrive mais le lien indique qu'il a expiré","Le lien de vérification ou de réinitialisation a une durée de vie limitée","Demandez un nouveau lien et ouvrez-le rapidement"],
      ["Plusieurs réinitialisations, toujours rien dans la boîte de réception","Les demandes répétées ont été signalées et filtrées","Cessez de renvoyer, puis vérifiez les dossiers de spams et d'indésirables"],
      ["Rien du tout sur un compte de prop firm","Les identifiants d'évaluation ne sont pas réinitialisables via Tradovate","Contactez le support de votre prop firm pour récupérer les identifiants"],
      ["E-mail dans Promotions de Gmail, pas dans la boîte principale","L'e-mail transactionnel a été catégorisé automatiquement","Déplacez-le vers Principale (Primary) et marquez l'expéditeur comme contact connu"],
    ] },
    { type: "heading",text: "Évitez cela avec PickMyTrade" },
    { type: "paragraph",html: "Les problèmes de vérification et de réinitialisation surviennent généralement au pire moment, en pleine session, avec un signal qui se déclenche. Acheminer vos alertes TradingView vers Tradovate via PickMyTrade maintient votre trading en marche grâce à une connexion gérée et authentifiée, de sorte qu'un seul e-mail manquant n'empêche pas votre stratégie de s'exécuter :" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Session unique et persistante</strong>, se connecte une fois et maintient une session authentifiée, de sorte qu'un incident de connexion quotidien n'interrompt pas le flux d'ordres.",
        "<strong class='text-white'>Renouvellement automatique du jeton</strong>, actualise l'accès avant son expiration au lieu de vous renvoyer sans cesse vers les écrans de connexion et de vérification.",
        "<strong class='text-white'>Exécution pilotée par les alertes</strong>, vos entrées et sorties se déclenchent directement depuis les alertes TradingView, de sorte qu'une réinitialisation de mot de passe bloquée ne laisse pas une position sans gestion.",
        "<strong class='text-white'>Synchronisation multi-comptes</strong>, réplique les ordres sur plusieurs comptes depuis cette connexion unique, au lieu de jongler avec des connexions manuelles distinctes qui risquent chacune leur propre problème de récupération.",
      ],
    },
    { type: "paragraph",html: "L'automatisation ne peut pas réinitialiser un mot de passe à votre place, mais une connexion stable signifie qu'un e-mail manquant occasionnel devient un désagrément à régler plus tard, et non la raison pour laquelle vos trades cessent de se déclencher." },
  ], it: [
    { type: "paragraph",html: "Si è registrato, ha fatto clic su &ldquo;reimposta password&rdquo; e ora fissa una posta in arrivo vuota mentre il mercato continua a muoversi senza di lei. Un'e-mail di verifica di Tradovate mancante, o un link di reimpostazione della password che non arriva mai, è uno dei motivi più comuni per cui i trader restano bloccati alla schermata di accesso. Il paradosso frustrante: il messaggio è quasi sempre già stato inviato. Nove volte su dieci è stato consegnato e poi filtrato silenziosamente in una cartella spam, posta indesiderata o nella scheda Promozioni di Gmail. A volte basta richiederlo di nuovo dal percorso di assistenza della schermata di accesso. Questa guida passa in rassegna ogni motivo per cui l'e-mail non compare, come reinviarla, dove cercare quando sembra svanita e perché gli account di prop firm e di valutazione seguono un percorso di recupero completamente diverso." },
    {
      type: "checklist",
      heading: "Checklist rapida per un'e-mail di verifica o reimpostazione mancante",
      items: [
        "<strong class='text-white'>Controlli prima spam, posta indesiderata e la scheda Promozioni di Gmail.</strong> È qui che i messaggi di Tradovate vengono filtrati più spesso, e per la maggior parte dei trader questo risolve il problema.",
        "<strong class='text-white'>La reinvii dalla schermata di accesso.</strong> Usi il percorso &ldquo;Need help?&rdquo; / &ldquo;Forgot Password&rdquo; per generare una nuova e-mail invece di aspettare la vecchia.",
        "<strong class='text-white'>Le dia 10&ndash;15 minuti.</strong> I ritardi del provider di posta e il greylisting possono trattenere brevemente il messaggio prima che compaia.",
        "<strong class='text-white'>Confermi che l'indirizzo e-mail registrato sia corretto.</strong> Un errore di battitura in fase di registrazione invia ogni messaggio a un indirizzo che non può aprire.",
        "<strong class='text-white'>Cerchi &ldquo;Tradovate&rdquo; in tutta la casella.</strong> Un filtro o una regola potrebbe averla spostata dalla posta in arrivo in un archivio o in un'etichetta.",
        "<strong class='text-white'>Su un account di prop firm o di valutazione, contatti la società, non Tradovate.</strong> Le credenziali di valutazione non possono essere reimpostate tramite il percorso standard di Tradovate.",
      ],
    },
    { type: "heading",text: "Che cosa significa «e-mail di verifica/reimpostazione non in arrivo»" },
    { type: "paragraph",html: "Non esiste una singola finestra di errore per questo: è un sintomo, non un messaggio codificato. O ha completato la registrazione senza mai ricevere il link di conferma che attiva l'account, oppure ha richiesto un promemoria del nome utente o una reimpostazione della password e l'e-mail successiva non è mai arrivata. Poiché la piattaforma registra l'e-mail come &ldquo;inviata&rdquo;, il guasto è quasi sempre lato consegna: un filtro antispam, un indirizzo digitato in modo errato o un ritardo del server di posta tra il sistema di Tradovate e il suo provider." },
    { type: "paragraph",html: "Consideri la soluzione una routine. Se non ha ricevuto l'e-mail di verifica, o l'ha eliminata prima di confermare, può reinviarla direttamente dalla schermata di accesso. E se ha lanciato più reimpostazioni di nome utente o password e non vede ancora nulla, le sue cartelle spam e posta indesiderata sono il primo posto in cui guardare, perché è lì che di solito si trova il messaggio &ldquo;mancante&rdquo;. È la considerazione più importante di questa pagina: l'e-mail di solito c'è, solo non nella sua posta in arrivo." },
    { type: "paragraph",html: "L'unica vera eccezione è un account di valutazione o di prop firm. Queste credenziali sono rilasciate e controllate dalla società di finanziamento, quindi Tradovate non può inviarle una reimpostazione per esse. Se ha acquistato una valutazione da una società come Apex, Topstep o un altro fornitore, l'e-mail di recupero deve arrivare dal sistema di quella società: richiederla dalla schermata di accesso di Tradovate non produrrà mai alcun messaggio." },
    { type: "heading",text: "Principali cause di un'e-mail di Tradovate mancante" },
    { type: "heading",text: "1. È finita in spam, posta indesiderata o nella scheda Promozioni" },
    { type: "paragraph",html: "È di gran lunga la causa numero uno. Le e-mail transazionali automatiche di un broker sono un bersaglio frequente dei filtri antispam aggressivi, e Gmail in particolare ama instradarle nella scheda <strong class='text-white'>Promozioni</strong> invece che nella posta in arrivo principale. Controlli prima spam e posta indesiderata: è lì che il messaggio &ldquo;mancante&rdquo; di solito si trova." },
    { type: "heading",text: "2. L'indirizzo e-mail registrato contiene un errore di battitura" },
    { type: "paragraph",html: "Se un carattere era sbagliato in fase di registrazione, un <code>.co</code> invece di <code>.com</code>, una lettera scambiata, il dominio sbagliato, ogni messaggio di verifica e reimpostazione va a un indirizzo che non controlla. Nulla arriverà mai alla sua vera posta in arrivo, per quante volte lo reinvii. Se l'account è nuovo e non confermato, vale la pena ricontrollarlo subito." },
    { type: "heading",text: "3. Un ritardo del provider di posta o greylisting" },
    { type: "paragraph",html: "Le e-mail transazionali non sono sempre istantanee. Alcuni server di posta usano il greylisting, che rinvia deliberatamente il primo tentativo di consegna da un mittente sconosciuto e lo accetta solo a un nuovo tentativo pochi minuti dopo. Spesso basta una breve attesa di 10&ndash;15 minuti perché un'e-mail ritardata arrivi." },
    { type: "heading",text: "4. Ha un account di prop firm o di valutazione" },
    { type: "paragraph",html: "Le credenziali di valutazione e dei conti finanziati appartengono alla prop firm, non a Tradovate. Il percorso standard di recupero del nome utente e reimpostazione della password non si applica a esse, e richiedere una reimpostazione dalla schermata di accesso di Tradovate semplicemente non genererà alcuna e-mail. La reimpostazione deve partire dal portale o dal canale di supporto della società stessa." },
    { type: "heading",text: "5. Un filtro o una regola della casella l'ha spostata" },
    { type: "paragraph",html: "Se ha mai impostato regole per la posta in arrivo, un filtro può archiviare, etichettare o eliminare silenziosamente la posta in entrata che corrisponde a determinati mittenti o parole chiave. Il messaggio è stato consegnato correttamente, semplicemente non è mai arrivato nella sua posta in arrivo. Ecco perché vale la pena fare una ricerca di &ldquo;Tradovate&rdquo; in tutta la casella (compresi Archivio, Tutta la posta e Cestino) prima di dare per scontato che non sia mai stata inviata." },
    { type: "heading",text: "Come risolvere un'e-mail di verifica o reimpostazione mancante: passo dopo passo" },
    { type: "heading",text: "Reinviare l'e-mail dalla schermata di accesso" },
    {
      type: "steps",
      items: [
        { title: "Vada alla schermata di accesso di Tradovate", html: "Vada alla schermata di accesso di Tradovate sul web o sul desktop." },
        { title: "Selezioni l'opzione di assistenza", html: "Cerchi un messaggio &ldquo;Need help?&rdquo; (o il link &ldquo;Forgot Password&rdquo;) sotto i campi di accesso. La dicitura di questo link cambia tra un aggiornamento della piattaforma e l'altro, quindi usi l'opzione che porta al recupero dell'account." },
        { title: "Scelga l'azione di recupero necessaria", html: "Reimpostare la password o recuperare il nome utente genera anch'esso una nuova e-mail, che è esattamente ciò che serve quando un messaggio di verifica è andato perso." },
        { title: "Inserisca nome utente o e-mail e invii", html: "Inserisca il suo nome utente o l'e-mail collegata all'account e invii. Il nuovo messaggio va all'indirizzo e-mail registrato." },
      ],
    },
    { type: "heading",text: "Recuperare il nome utente o reimpostare la password" },
    {
      type: "steps",
      items: [
        { title: "Scelga l'opzione di recupero giusta", html: "Nella pagina di recupero, scelga l'opzione giusta. Per recuperare il nome utente, scelga <strong class='text-white'>Retrieve Username</strong> e inserisca l'indirizzo e-mail dell'account: il suo nome utente verrà poi inviato all'e-mail registrata. Per reimpostare una password dimenticata, scelga <strong class='text-white'>Reset Password</strong>, inserisca il nome utente o l'e-mail e le istruzioni di reimpostazione le verranno inviate via e-mail." },
        { title: "Usi l'indirizzo con cui si è effettivamente registrato", html: "La posta di recupero viene inviata solo all'e-mail registrata, quindi un indirizzo diverso non restituisce nulla." },
        { title: "Invii una volta e attenda", html: "Invii una sola volta e attenda invece di lanciare richieste ripetute. Più reimpostazioni rapide sono proprio lo scenario in cui i messaggi vengono filtrati, e sono quelli che di solito troverà in attesa nella cartella spam." },
      ],
    },
    { type: "heading",text: "Trovare l'e-mail quando sembra scomparsa" },
    {
      type: "steps",
      items: [
        { title: "Apra le cartelle spam e posta indesiderata", html: "Apra le cartelle spam e posta indesiderata e cerchi un messaggio recente di Tradovate. È il primo posto da controllare e risolve il problema per la maggior parte delle persone." },
        { title: "Controlli la scheda Promozioni", html: "Controlli la scheda Promozioni se usa Gmail: la posta transazionale dei broker viene spesso smistata lì invece che nella posta in arrivo principale." },
        { title: "Cerchi in tutta la casella", html: "Cerchi &ldquo;Tradovate&rdquo; in tutta la casella, compresi Tutta la posta, Archivio e Cestino, nel caso un filtro l'abbia spostata." },
        { title: "Attenda e aggiorni", html: "Attenda 10&ndash;15 minuti e aggiorni se non compare ancora nulla, per tenere conto di ritardi del provider o greylisting." },
        { title: "La contrassegni come non spam", html: "La contrassegni come &ldquo;Non spam&rdquo; e aggiunga il mittente ai contatti una volta trovata, così le future e-mail di verifica e reimpostazione arriveranno nella posta in arrivo." },
      ],
    },
    { type: "heading",text: "Risolvere su un account di prop firm o di valutazione" },
    {
      type: "steps",
      items: [
        { title: "Confermi che tipo di account ha", html: "Se ha acquistato un account di valutazione o finanziato da una prop firm, le credenziali appartengono a quella società." },
        { title: "Contatti direttamente la società", html: "Apex, Topstep e altri fornitori gestiscono ciascuno il proprio recupero delle credenziali. Tradovate non può reimpostare per lei una credenziale di valutazione." },
        { title: "Segua i passaggi di recupero attuali della società", html: "I portali e le etichette variano da società a società e cambiano nel tempo, quindi controlli le istruzioni attuali della sua società invece di dare per scontato che coincidano con quelle di Tradovate." },
      ],
    },
    { type: "heading",text: "Tabella di risoluzione dei problemi" },
    { type: "table", headers: ["Sintomo / stato","Che cosa significa","Soluzione"], rows: [
      ["Nessuna e-mail di verifica dopo la registrazione","Il messaggio è stato inviato ma filtrato, ritardato o spedito a un indirizzo digitato in modo errato","Controlli spam/indesiderata/Promozioni, verifichi l'indirizzo registrato, poi reinvii dalla schermata di accesso"],
      ["L'e-mail di reimpostazione non arriva mai","Consegnata nello spam, a un indirizzo sbagliato o richiesta per una credenziale di valutazione","Reinvii tramite Forgot Password, cerchi in tutta la casella e confermi che non sia un account di prop firm"],
      ["L'e-mail arriva ma il link risulta scaduto","Il link di verifica o reimpostazione ha una durata limitata","Richieda un nuovo link e lo apra subito"],
      ["Più reimpostazioni, ancora nulla nella posta in arrivo","Le richieste ripetute sono state segnalate e filtrate","Smetta di reinviare, poi controlli le cartelle spam e posta indesiderata"],
      ["Nessuna e-mail su un account di prop firm","Le credenziali di valutazione non sono reimpostabili tramite Tradovate","Contatti il supporto della sua prop firm per recuperare le credenziali"],
      ["E-mail in Promozioni di Gmail, non nella principale","L'e-mail transazionale è stata categorizzata automaticamente","La sposti in Principale (Primary) e contrassegni il mittente come contatto noto"],
    ] },
    { type: "heading",text: "Lo prevenga con PickMyTrade" },
    { type: "paragraph",html: "I problemi di verifica e reimpostazione colpiscono di solito nel momento peggiore, a metà sessione, con un segnale che scatta. Instradare i suoi alert di TradingView a Tradovate tramite PickMyTrade mantiene il suo trading attivo attraverso una connessione gestita e autenticata, così una singola e-mail mancante non impedisce alla sua strategia di eseguire:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Singola sessione persistente</strong>, si connette una volta e mantiene una sessione autenticata, così un intoppo quotidiano di accesso non interrompe il flusso degli ordini.",
        "<strong class='text-white'>Rinnovo automatico del token</strong>, aggiorna l'accesso prima che scada invece di costringerla a ripassare continuamente dalle schermate di accesso e verifica.",
        "<strong class='text-white'>Esecuzione guidata dagli alert</strong>, i suoi ingressi e le sue uscite scattano direttamente dagli alert di TradingView, così una reimpostazione della password bloccata non lascia una posizione non gestita.",
        "<strong class='text-white'>Sincronizzazione multi-account</strong>, replica gli ordini su più account da quell'unica connessione, invece di destreggiarsi tra accessi manuali separati che rischiano ciascuno il proprio intoppo di recupero.",
      ],
    },
    { type: "paragraph",html: "L'automazione non può reimpostare una password per lei, ma una connessione stabile fa sì che un'occasionale e-mail mancante diventi un inconveniente da risolvere più tardi, non il motivo per cui i suoi trade smettono di scattare." },
  ] },
  ctaHeading: { en: "Trade From One Stable Session", de: "Handeln Sie über eine stabile Sitzung", es: "Opere desde una sesión estable", fr: "Tradez depuis une session stable", it: "Operi da una sessione stabile" },
  ctaText: { en: "Start your free 7-day trial, link your TradingView alerts to Tradovate and trade from one stable session.", de: "Starten Sie Ihre kostenlose 7-Tage-Testphase, verknüpfen Sie Ihre TradingView-Alerts mit Tradovate und handeln Sie über eine stabile Sitzung.", es: "Comience su prueba gratuita de 7 días, vincule sus alertas de TradingView a Tradovate y opere desde una sesión estable.", fr: "Commencez votre essai gratuit de 7 jours, reliez vos alertes TradingView à Tradovate et tradez depuis une session stable.", it: "Inizi la prova gratuita di 7 giorni, colleghi i suoi alert di TradingView a Tradovate e operi da una sessione stabile." },
  ctaButtonText: { en: "Start Your Free 7-Day Trial", de: "Starten Sie Ihre kostenlose 7-Tage-Testphase", es: "Comience su prueba gratuita de 7 días", fr: "Commencez votre essai gratuit de 7 jours", it: "Inizi la prova gratuita di 7 giorni" },
  ctaUrl: "https://app.pickmytrade.trade/?register=true&utm_source=content&utm_medium=debugging",
  faqHeading: { en: "Frequently Asked Questions", de: "Häufig gestellte Fragen", es: "Preguntas frecuentes", fr: "Questions fréquentes", it: "Domande frequenti" },
  faqs: { en: [
    { q: "Why is my Tradovate verification email not arriving?", a: "In almost every case it was sent, but it landed in a spam, junk, or Gmail Promotions folder, got delayed by your mail provider, or went to a mistyped address. Check those folders first, confirm the address on file is correct, and resend it from the login screen if you still see nothing." },
    { q: "How do I resend a Tradovate verification email?", a: "Go to the login screen and open the help flow, a \"Need help?\" prompt or the \"Forgot Password\" link, then request a password reset or username recovery. That re-triggers a fresh email to the address on file. The exact wording of the link can change between updates, so use whichever option leads to account recovery." },
    { q: "Where should I look when the reset email is missing?", a: "Check your spam and junk folders first, especially if you have requested several username or password resets in a row. Repeated requests are exactly the ones that get filtered, so that is the single best place to start looking." },
    { q: "How do I recover my Tradovate username?", a: "On the account recovery page, choose the Retrieve Username option and enter the email address associated with your account. Your username is then sent to the email address on file." },
    { q: "My password reset email still isn't coming, what now?", a: "Confirm you are entering the exact email or username on your account, wait 10–15 minutes for delivery, and search your whole mailbox, including Archive and Trash, for \"Tradovate.\" If it still does not arrive and it is a standalone account, contact Tradovate support; if it is an evaluation account, contact your prop firm." },
    { q: "I have a prop-firm evaluation account, why can't I reset it through Tradovate?", a: "Evaluation and funded logins are issued and controlled by the prop firm, not by Tradovate. The standard Tradovate reset flow does not cover them, so no email gets generated. You have to recover the login through the firm's own portal or support team." },
    { q: "How do I stop Tradovate emails from going to spam in the future?", a: "Once you find a Tradovate message, mark it \"Not spam,\" move it to your Primary inbox, and add the sender to your contacts or a safe-sender list. That trains your provider to drop future verification and reset emails straight into the inbox." },
  ], de: [
    { q: "Warum kommt meine Tradovate-Verifizierungs-E-Mail nicht an?", a: "In fast allen Fällen wurde sie gesendet, ist aber in einem Spam-, Junk- oder Gmail-Promotions-Ordner gelandet, wurde von Ihrem E-Mail-Anbieter verzögert oder ging an eine falsch geschriebene Adresse. Prüfen Sie zuerst diese Ordner, bestätigen Sie, dass die hinterlegte Adresse korrekt ist, und senden Sie sie über den Anmeldebildschirm erneut, falls Sie weiterhin nichts sehen." },
    { q: "Wie sende ich eine Tradovate-Verifizierungs-E-Mail erneut?", a: "Gehen Sie zum Anmeldebildschirm und öffnen Sie den Hilfeablauf, eine Aufforderung „Need help?“ oder den Link „Forgot Password“, und fordern Sie dann eine Passwort-Zurücksetzung oder Benutzernamen-Wiederherstellung an. Das löst eine neue E-Mail an die hinterlegte Adresse aus. Die genaue Bezeichnung des Links kann sich zwischen Updates ändern, verwenden Sie daher die Option, die zur Kontowiederherstellung führt." },
    { q: "Wo sollte ich suchen, wenn die Zurücksetzungs-E-Mail fehlt?", a: "Prüfen Sie zuerst Ihre Spam- und Junk-Ordner, besonders wenn Sie mehrere Benutzernamen- oder Passwort-Zurücksetzungen hintereinander angefordert haben. Wiederholte Anfragen werden genau deshalb gefiltert, daher ist das der beste Ausgangspunkt für die Suche." },
    { q: "Wie stelle ich meinen Tradovate-Benutzernamen wieder her?", a: "Wählen Sie auf der Seite zur Kontowiederherstellung die Option Retrieve Username und geben Sie die mit Ihrem Konto verknüpfte E-Mail-Adresse ein. Ihr Benutzername wird dann an die hinterlegte E-Mail-Adresse gesendet." },
    { q: "Meine Passwort-Zurücksetzungs-E-Mail kommt immer noch nicht, was nun?", a: "Vergewissern Sie sich, dass Sie genau die E-Mail-Adresse oder den Benutzernamen Ihres Kontos eingeben, warten Sie 10–15 Minuten auf die Zustellung und durchsuchen Sie Ihr gesamtes Postfach, einschließlich Archiv und Papierkorb, nach „Tradovate“. Kommt sie weiterhin nicht an und handelt es sich um ein eigenständiges Konto, wenden Sie sich an den Tradovate-Support; bei einem Evaluationskonto kontaktieren Sie Ihre Prop-Firma." },
    { q: "Ich habe ein Evaluationskonto bei einer Prop-Firma, warum kann ich es nicht über Tradovate zurücksetzen?", a: "Evaluations- und Funded-Zugänge werden von der Prop-Firma ausgestellt und kontrolliert, nicht von Tradovate. Der Standardablauf zum Zurücksetzen bei Tradovate deckt sie nicht ab, daher wird keine E-Mail erzeugt. Sie müssen den Zugang über das Portal oder das Support-Team der Firma wiederherstellen." },
    { q: "Wie verhindere ich künftig, dass Tradovate-E-Mails im Spam landen?", a: "Sobald Sie eine Tradovate-Nachricht gefunden haben, markieren Sie sie als „Kein Spam“, verschieben Sie sie in Ihren Posteingang (Primary) und fügen Sie den Absender Ihren Kontakten oder einer Liste sicherer Absender hinzu. So lernt Ihr Anbieter, künftige Verifizierungs- und Zurücksetzungs-E-Mails direkt in den Posteingang zu legen." },
  ], es: [
    { q: "¿Por qué no llega mi correo de verificación de Tradovate?", a: "En casi todos los casos se envió, pero terminó en una carpeta de spam, correo no deseado o en la pestaña Promociones de Gmail, su proveedor de correo lo retrasó o se envió a una dirección con errores. Revise primero esas carpetas, confirme que la dirección registrada es correcta y reenvíelo desde la pantalla de inicio de sesión si sigue sin ver nada." },
    { q: "¿Cómo reenvío un correo de verificación de Tradovate?", a: "Vaya a la pantalla de inicio de sesión y abra el flujo de ayuda, un aviso «Need help?» o el enlace «Forgot Password», y solicite un restablecimiento de contraseña o la recuperación del nombre de usuario. Eso genera un correo nuevo a la dirección registrada. La redacción exacta del enlace puede cambiar entre actualizaciones, así que use la opción que lleve a la recuperación de la cuenta." },
    { q: "¿Dónde debo buscar cuando falta el correo de restablecimiento?", a: "Revise primero sus carpetas de spam y correo no deseado, sobre todo si ha solicitado varios restablecimientos de usuario o contraseña seguidos. Las solicitudes repetidas son justo las que se filtran, así que ese es el mejor lugar para empezar a buscar." },
    { q: "¿Cómo recupero mi nombre de usuario de Tradovate?", a: "En la página de recuperación de la cuenta, elija la opción Retrieve Username e introduzca la dirección de correo asociada a su cuenta. Su nombre de usuario se envía entonces a la dirección de correo registrada." },
    { q: "Mi correo de restablecimiento de contraseña sigue sin llegar, ¿qué hago?", a: "Confirme que introduce exactamente el correo o el nombre de usuario de su cuenta, espere de 10 a 15 minutos para la entrega y busque en todo su buzón, incluidos Archivo y Papelera, la palabra «Tradovate». Si sigue sin llegar y es una cuenta independiente, contacte con el soporte de Tradovate; si es una cuenta de evaluación, contacte con su prop firm." },
    { q: "Tengo una cuenta de evaluación de una prop firm, ¿por qué no puedo restablecerla a través de Tradovate?", a: "Los accesos de evaluación y de cuenta fondeada los emite y controla la prop firm, no Tradovate. El flujo de restablecimiento estándar de Tradovate no los cubre, por lo que no se genera ningún correo. Debe recuperar el acceso a través del portal o del equipo de soporte de la firma." },
    { q: "¿Cómo evito que los correos de Tradovate vayan a spam en el futuro?", a: "Cuando encuentre un mensaje de Tradovate, márquelo como «No es spam», muévalo a su bandeja principal (Primary) y añada el remitente a sus contactos o a una lista de remitentes seguros. Eso enseña a su proveedor a enviar directamente a la bandeja de entrada los futuros correos de verificación y restablecimiento." },
  ], fr: [
    { q: "Pourquoi mon e-mail de vérification Tradovate n'arrive-t-il pas ?", a: "Dans presque tous les cas, il a bien été envoyé, mais il a atterri dans un dossier de spams, d'indésirables ou dans l'onglet Promotions de Gmail, a été retardé par votre fournisseur de messagerie ou est parti vers une adresse mal saisie. Vérifiez d'abord ces dossiers, confirmez que l'adresse enregistrée est correcte et renvoyez-le depuis l'écran de connexion si vous ne voyez toujours rien." },
    { q: "Comment renvoyer un e-mail de vérification Tradovate ?", a: "Rendez-vous sur l'écran de connexion et ouvrez le parcours d'aide, une invite « Need help? » ou le lien « Forgot Password », puis demandez une réinitialisation de mot de passe ou la récupération du nom d'utilisateur. Cela déclenche un nouvel e-mail vers l'adresse enregistrée. Le libellé exact du lien peut changer d'une mise à jour à l'autre ; utilisez donc l'option qui mène à la récupération du compte." },
    { q: "Où chercher quand l'e-mail de réinitialisation est introuvable ?", a: "Vérifiez d'abord vos dossiers de spams et d'indésirables, surtout si vous avez demandé plusieurs réinitialisations de nom d'utilisateur ou de mot de passe à la suite. Les demandes répétées sont justement celles qui sont filtrées ; c'est donc le meilleur endroit pour commencer." },
    { q: "Comment récupérer mon nom d'utilisateur Tradovate ?", a: "Sur la page de récupération du compte, choisissez l'option Retrieve Username et saisissez l'adresse e-mail associée à votre compte. Votre nom d'utilisateur est alors envoyé à l'adresse e-mail enregistrée." },
    { q: "Mon e-mail de réinitialisation de mot de passe n'arrive toujours pas, que faire ?", a: "Vérifiez que vous saisissez exactement l'e-mail ou le nom d'utilisateur de votre compte, patientez 10 à 15 minutes pour la livraison et cherchez « Tradovate » dans toute votre boîte, y compris Archives et Corbeille. S'il n'arrive toujours pas et qu'il s'agit d'un compte autonome, contactez le support Tradovate ; s'il s'agit d'un compte d'évaluation, contactez votre société de prop trading." },
    { q: "J'ai un compte d'évaluation de prop firm, pourquoi ne puis-je pas le réinitialiser via Tradovate ?", a: "Les identifiants d'évaluation et de compte financé sont délivrés et contrôlés par la société de prop trading, pas par Tradovate. Le parcours de réinitialisation standard de Tradovate ne les couvre pas ; aucun e-mail n'est donc généré. Vous devez récupérer l'accès via le portail ou l'équipe de support de la société." },
    { q: "Comment éviter que les e-mails de Tradovate n'aillent dans les spams à l'avenir ?", a: "Une fois que vous avez trouvé un message de Tradovate, marquez-le comme « Non spam », déplacez-le vers votre boîte principale (Primary) et ajoutez l'expéditeur à vos contacts ou à une liste d'expéditeurs sûrs. Cela apprend à votre fournisseur à envoyer directement dans la boîte de réception les futurs e-mails de vérification et de réinitialisation." },
  ], it: [
    { q: "Perché la mia e-mail di verifica di Tradovate non arriva?", a: "Quasi sempre è stata inviata, ma è finita in una cartella spam, posta indesiderata o nella scheda Promozioni di Gmail, è stata ritardata dal suo provider di posta o è andata a un indirizzo digitato in modo errato. Controlli prima queste cartelle, confermi che l'indirizzo registrato sia corretto e la reinvii dalla schermata di accesso se continua a non vedere nulla." },
    { q: "Come reinvio un'e-mail di verifica di Tradovate?", a: "Vada alla schermata di accesso e apra il percorso di assistenza, un messaggio «Need help?» o il link «Forgot Password», quindi richieda la reimpostazione della password o il recupero del nome utente. Questo genera una nuova e-mail all'indirizzo registrato. La dicitura esatta del link può cambiare tra un aggiornamento e l'altro, quindi usi l'opzione che porta al recupero dell'account." },
    { q: "Dove devo cercare quando manca l'e-mail di reimpostazione?", a: "Controlli prima le cartelle spam e posta indesiderata, soprattutto se ha richiesto più reimpostazioni di nome utente o password di fila. Le richieste ripetute sono proprio quelle che vengono filtrate, quindi è il punto migliore da cui iniziare." },
    { q: "Come recupero il mio nome utente di Tradovate?", a: "Nella pagina di recupero dell'account, scelga l'opzione Retrieve Username e inserisca l'indirizzo e-mail associato al suo account. Il suo nome utente verrà poi inviato all'indirizzo e-mail registrato." },
    { q: "La mia e-mail di reimpostazione della password ancora non arriva, che cosa faccio?", a: "Verifichi di inserire esattamente l'e-mail o il nome utente del suo account, attenda 10–15 minuti per la consegna e cerchi «Tradovate» in tutta la casella, compresi Archivio e Cestino. Se continua a non arrivare ed è un account autonomo, contatti il supporto di Tradovate; se è un account di valutazione, contatti la sua prop firm." },
    { q: "Ho un account di valutazione di una prop firm, perché non posso reimpostarlo tramite Tradovate?", a: "Le credenziali di valutazione e dei conti finanziati sono rilasciate e controllate dalla prop firm, non da Tradovate. Il percorso di reimpostazione standard di Tradovate non le copre, quindi non viene generata alcuna e-mail. Deve recuperare l'accesso tramite il portale o il team di supporto della società." },
    { q: "Come evito in futuro che le e-mail di Tradovate finiscano nello spam?", a: "Quando trova un messaggio di Tradovate, lo contrassegni come «Non spam», lo sposti nella posta in arrivo principale (Primary) e aggiunga il mittente ai contatti o a un elenco di mittenti attendibili. Così il suo provider impara a recapitare direttamente nella posta in arrivo le future e-mail di verifica e reimpostazione." },
  ] },
