---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "debit-card-wont-verify";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/debugging/${SLUG}`;

const META_TITLE = "Tradovate Debit Card Won't Verify for Deposits";
const META_DESCRIPTION =
  "Debit card won't verify for your futures deposit? Enable site permissions, clear the card check, and fix declined deposits in minutes.";

// Short SEO title (<=60 chars) for locales where the shared h1 is too long for a SERP title.
const TITLE_OVERRIDE: Partial<Record<Locale, string>> = { de: "Tradovate: Debitkarte lässt sich nicht verifizieren", es: "Tradovate: la tarjeta de débito no se verifica (depósitos)", fr: "Tradovate : carte de débit non vérifiable pour les dépôts", it: "Tradovate: carta di debito non verificabile per i depositi" };

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Tradovate: Debitkarte lässt sich für Einzahlungen nicht verifizieren", es: "La tarjeta de débito no se verifica para depósitos en Tradovate", fr: "La carte de débit ne se vérifie pas pour les dépôts Tradovate", it: "La carta di debito non si verifica per i depositi su Tradovate" },
  dek: { en: "A spinner that never resolves, a blank popup, or a flat &ldquo;verification failed&rdquo; message when you try to fund with a debit card. Nine times out of ten it's your browser blocking the verification window, not your bank. Here's the exact fix.", de: "Ein Ladekreis, der sich nie auflöst, ein leeres Popup oder eine schlichte Meldung &ldquo;Verifizierung fehlgeschlagen&rdquo;, wenn Sie mit einer Debitkarte einzahlen möchten. In neun von zehn Fällen blockiert Ihr Browser das Verifizierungsfenster – nicht Ihre Bank. Hier ist die genaue Lösung.", es: "Un indicador de carga que nunca termina, una ventana emergente en blanco o un simple mensaje de &ldquo;verificación fallida&rdquo; al intentar depositar con una tarjeta de débito. Nueve de cada diez veces es su navegador el que bloquea la ventana de verificación, no su banco. Aquí tiene la solución exacta.", fr: "Une roue de chargement qui ne s'arrête jamais, une fenêtre pop-up vide ou un simple message &laquo;&nbsp;échec de la vérification&nbsp;&raquo; lorsque vous essayez d'approvisionner votre compte avec une carte de débit. Neuf fois sur dix, c'est votre navigateur qui bloque la fenêtre de vérification, pas votre banque. Voici la solution exacte.", it: "Una rotellina di caricamento che non si ferma mai, un popup vuoto o un semplice messaggio &ldquo;verifica non riuscita&rdquo; quando si prova a depositare con una carta di debito. Nove volte su dieci non è la banca a bloccare l'operazione, ma il browser che blocca la finestra di verifica. Ecco la soluzione esatta." },
  readTime: { en: "7 min read", de: "7 Minuten Lesezeit", es: "Lectura de 7 minutos", fr: "Lecture de 7 minutes", it: "Lettura di 7 minuti" },
  lastUpdated: "2026-07-08",
  heroImage: { src: `${IMG}/debit-card-wont-verify-1.png`, alt: { en: "Tradovate Fund Account screen with the Debit Cards option selected", de: "Tradovate-Bildschirm &ldquo;Fund Account&rdquo; mit ausgewählter Option &ldquo;Debit Cards&rdquo;", es: "Pantalla &ldquo;Fund Account&rdquo; de Tradovate con la opción &ldquo;Debit Cards&rdquo; seleccionada", fr: "Écran &ldquo;Fund Account&rdquo; de Tradovate avec l'option &ldquo;Debit Cards&rdquo; sélectionnée", it: "Schermata &ldquo;Fund Account&rdquo; di Tradovate con l'opzione &ldquo;Debit Cards&rdquo; selezionata" } },
  blocks: { en: [
    { type: "paragraph", html: "You entered your card, hit submit, and instead of a confirmation you got a spinner that never resolves, a blank popup, or a flat &ldquo;verification failed&rdquo; message. Nine times out of ten this isn't your bank blocking the charge. It's your browser quietly killing the card-verification window that Tradovate's payment processor tries to open, or a card that can't pass the identity check. Both are fixable in a few minutes." },
    { type: "quote", html: "<strong class='text-white'>Quick fix:</strong> Enable all site permissions for <strong class='text-white'>account.ninjatrader.com</strong> in your browser, turn off any ad blocker or privacy extension for that page, then retry the deposit. Make sure the card is a personal debit card with your name printed on the front. If it still won't verify, remember you can only have one card on file at a time, so email <strong class='text-white'>treasurysupport@ninjatrader.com</strong> to change the linked card, or fund with ACH or a wire instead." },
    { type: "heading", text: "What's Actually Happening" },
    { type: "paragraph", html: "Tradovate is owned by NinjaTrader now, and debit card deposits are handled on <strong class='text-white'>account.ninjatrader.com</strong> through a third-party card processor (your statement shows the charge as sent to Stripe). That processor runs a verification step right in your browser: a small window or camera prompt that confirms the card belongs to you. When your browser blocks pop-ups, cookies, cameras, or scripts for that domain, the verification window never loads or silently dies, and the deposit looks like it &ldquo;won't verify&rdquo; even though nothing is wrong with the card." },
    { type: "paragraph", html: "The other common cause is the card itself. The processor has to read the name on the card and match it to your account. If the name isn't printed on the card, or you're using a credit card or a prepaid card, the check fails by design." },
    { type: "heading", text: "Fix 1: Unblock account.ninjatrader.com in Your Browser" },
    { type: "paragraph", html: "This is the single most effective fix, and it takes under a minute. The verification window relies on scripts, cookies, and sometimes your camera loading from the NinjaTrader domain. If your browser or an extension blocks any of those, clear the block for that one site." },
    { type: "heading", text: "Steps" },
    {
      type: "list",
      items: [
        "Open your browser's <strong class='text-white'>Site settings</strong> or <strong class='text-white'>Site permissions</strong> panel. In Chrome and Edge you'll find this under Settings &rsaquo; Privacy and security &rsaquo; Site settings (the exact wording shifts between browsers and versions).",
        "Search for or add <strong class='text-white'>account.ninjatrader.com</strong>.",
        "Set every permission for that site to <strong class='text-white'>Allow</strong>: pop-ups and redirects, cookies, JavaScript, and camera access. The camera one matters because some cards require you to hold the physical card up to your webcam.",
        "Disable any ad blocker, script blocker, or privacy extension (uBlock, AdBlock, Ghostery, Brave Shields, and the like) for the page, or add the domain to that extension's allow list.",
        "Reload the funding page and start the deposit again.",
      ],
    },
    { type: "image", src: `${IMG}/debit-card-wont-verify-2.png`, alt: "Browser site permissions panel showing all permissions allowed for account.ninjatrader.com" },
    { type: "paragraph", html: "Two things trip people up here. First, if you have several extensions, an incognito or private window with extensions turned off is the fastest way to test whether one of them is the culprit. Second, work and school laptops sometimes push a security policy that blocks these windows no matter what you change, so if you're on a managed device, try a personal one." },
    { type: "heading", text: "Fix 2: Get Through the Card Verification Cleanly" },
    { type: "paragraph", html: "Once the browser is out of the way, the deposit flow itself is short. In Tradovate, open <strong class='text-white'>Application Settings</strong> (top-right corner), go to <strong class='text-white'>Accounts</strong>, then <strong class='text-white'>Fund Account</strong>, and choose <strong class='text-white'>Debit Cards</strong>. Agree to the disclosure and terms, then work through the verification prompts carefully:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Sign the risk disclosure correctly.</strong> Check both boxes and type your name exactly as it appears on your Tradovate account. A mismatch here can stall the whole thing.",
        "<strong class='text-white'>Enter the card details</strong> and click <strong class='text-white'>Add debit card</strong> to link it.",
        "<strong class='text-white'>If an extra verification step appears,</strong> a message tells you so and you click <strong class='text-white'>Proceed</strong>. This is where some cards ask you to hold the card up to your device camera, or upload clear photos of the front and back.",
        "<strong class='text-white'>Use a card with your name on the front.</strong> The processor has to capture that name to confirm your identity. Cards printed without a name, and many prepaid cards, won't pass.",
      ],
    },
    { type: "image", src: `${IMG}/debit-card-wont-verify-3.png`, alt: "Debit card verification step prompting the user to hold the card up to the device camera" },
    { type: "paragraph", html: "If the camera capture is the sticking point, good lighting and a steady hand help more than anything. Fill the frame with the card, keep it flat so there's no glare across the numbers and the name, and hold it still until the capture completes." },
    { type: "heading", text: "Fix 3: Change the Card That's Already Linked" },
    { type: "paragraph", html: "Tradovate lets you keep only one debit card on file at a time. So if you added the wrong card, closed that card, or need to switch to a different one, you can't just add a second card and pick between them. You have to remove or replace the existing one first." },
    { type: "paragraph", html: "To do that, email <strong class='text-white'>treasurysupport@ninjatrader.com</strong> and ask them to change or remove the card linked to your account. Once that's done, head back to the funding screen and add the new card. This is also the right contact if the verification keeps failing and you can't tell why, since their treasury team can see what the processor is rejecting." },
    { type: "image", src: `${IMG}/debit-card-wont-verify-4.png`, alt: "Additional verification message with a Proceed button during a Tradovate debit card deposit" },
    { type: "heading", text: "Fix 4: Confirm Your Deposit Fits the Limits" },
    { type: "paragraph", html: "Sometimes the card isn't the problem at all, and the amount is. Debit card deposits carry their own limits, separate from ACH or wire, and a request outside those bounds can bounce back looking like a card failure. Here's the shape of it, though you should always confirm the current numbers on the deposit screen before you submit, because they do change." },
    {
      type: "table",
      headers: ["Detail", "What to expect"],
      rows: [
        ["Accepted cards", "Most personal debit cards, including Visa and Mastercard. Name must be printed on the card."],
        ["Minimum deposit", "A small floor of around $5."],
        ["Maximum deposit", "Roughly $5,000 within a rolling 24-business-hour window."],
        ["Frequency", "About one debit card deposit per 24-business-hour window."],
        ["Clearing time", "Usually available for trading within about three business days; requests early in the day process faster."],
        ["Fees", "Typically no setup or deposit fee for the debit card method."],
      ],
    },
    { type: "paragraph", html: "One more account-level check: the name on the card and the name on your Tradovate account have to match. If you're trying to fund with a spouse's card or a business card, the identity check fails, and there's no workaround for that on the platform side." },
    { type: "heading", text: "Still Won't Verify? Use a Different Funding Method" },
    { type: "paragraph", html: "If you've cleared your browser, tried a second debit card, and the check still fails, that's usually the end of the road for cards on that account, and the verification can't be forced through from your side. Rather than keep retrying, fund the account another way. An ACH bank transfer is free and works well for most deposits, and a wire is fastest for larger amounts. Both skip the card processor and its verification entirely." },
    { type: "paragraph", html: "Keep in mind that money you deposit sits under a short hold before you can pull it back out, and debit card deposits in particular carry their own hold window before withdrawal. If you're planning to move funds around, read up on withdrawing funds from Tradovate first so the timing doesn't surprise you." },
    { type: "heading", text: "A Note for Prop Firm and Evaluation Accounts" },
    { type: "paragraph", html: "This debit card flow is for funding your own live Tradovate account. If you're logging in with a prop firm or evaluation account and you're seeing funding prompts or a card that won't attach, that's a different story. You don't deposit your own money into an evaluation account, and each firm sets its own rules, fees, and reset process. Those vary by firm and account size, so check your firm's current rules and contact the firm's support rather than Tradovate treasury." },
  ], de: [
    { type: "paragraph", html: "Sie haben Ihre Karte eingegeben, auf Absenden geklickt, und statt einer Bestätigung erschien ein Ladekreis, der sich nie auflöst, ein leeres Popup oder eine schlichte Meldung &ldquo;Verifizierung fehlgeschlagen&rdquo;. In neun von zehn Fällen blockiert nicht Ihre Bank die Zahlung. Ihr Browser beendet still das Kartenverifizierungsfenster, das der Zahlungsdienstleister von Tradovate zu öffnen versucht, oder die Karte besteht die Identitätsprüfung nicht. Beides lässt sich in wenigen Minuten beheben." },
    { type: "quote", html: "<strong class='text-white'>Schnelle Lösung:</strong> Aktivieren Sie alle Website-Berechtigungen für <strong class='text-white'>account.ninjatrader.com</strong> in Ihrem Browser, deaktivieren Sie Werbeblocker oder Datenschutz-Erweiterungen für diese Seite und versuchen Sie die Einzahlung erneut. Stellen Sie sicher, dass es sich um eine persönliche Debitkarte mit aufgedrucktem Namen handelt. Wenn die Verifizierung weiterhin fehlschlägt: Sie können nur eine Karte gleichzeitig hinterlegen, schreiben Sie also eine E-Mail an <strong class='text-white'>treasurysupport@ninjatrader.com</strong>, um die hinterlegte Karte zu ändern, oder zahlen Sie stattdessen per ACH oder Überweisung ein." },
    { type: "heading", text: "Was tatsächlich passiert" },
    { type: "paragraph", html: "Tradovate gehört inzwischen zu NinjaTrader, und Debitkarten-Einzahlungen werden über <strong class='text-white'>account.ninjatrader.com</strong> durch einen externen Kartenprozessor abgewickelt (auf Ihrer Abrechnung erscheint die Belastung als an Stripe gesendet). Dieser Dienstleister führt direkt in Ihrem Browser einen Verifizierungsschritt durch: ein kleines Fenster oder eine Kameraaufforderung, die bestätigt, dass die Karte Ihnen gehört. Blockiert Ihr Browser Pop-ups, Cookies, die Kamera oder Skripte für diese Domain, lädt das Verifizierungsfenster nie oder bricht lautlos ab – die Einzahlung wirkt dann so, als würde sie &ldquo;nicht verifizieren&rdquo;, obwohl mit der Karte alles in Ordnung ist." },
    { type: "paragraph", html: "Die andere häufige Ursache ist die Karte selbst. Der Dienstleister muss den Namen auf der Karte lesen und mit Ihrem Konto abgleichen. Ist der Name nicht auf der Karte aufgedruckt oder verwenden Sie eine Kreditkarte oder Prepaid-Karte, schlägt die Prüfung planmäßig fehl." },
    { type: "heading", text: "Lösung 1: account.ninjatrader.com in Ihrem Browser freigeben" },
    { type: "paragraph", html: "Dies ist die wirksamste Lösung und dauert weniger als eine Minute. Das Verifizierungsfenster benötigt Skripte, Cookies und manchmal den Kamerazugriff, die von der NinjaTrader-Domain geladen werden. Blockiert Ihr Browser oder eine Erweiterung eines davon, heben Sie die Blockierung für genau diese eine Website auf." },
    { type: "heading", text: "Schritte" },
    {
      type: "list",
      items: [
        "Öffnen Sie in Ihrem Browser die <strong class='text-white'>Website-Einstellungen</strong> bzw. <strong class='text-white'>Website-Berechtigungen</strong>. In Chrome und Edge finden Sie dies unter Einstellungen &rsaquo; Datenschutz und Sicherheit &rsaquo; Website-Einstellungen (die genaue Bezeichnung variiert je nach Browser und Version).",
        "Suchen Sie <strong class='text-white'>account.ninjatrader.com</strong> oder fügen Sie die Domain hinzu.",
        "Setzen Sie jede Berechtigung für diese Website auf <strong class='text-white'>Zulassen</strong>: Pop-ups und Weiterleitungen, Cookies, JavaScript und Kamerazugriff. Der Kamerazugriff ist wichtig, weil manche Karten verlangen, dass Sie die physische Karte vor Ihre Webcam halten.",
        "Deaktivieren Sie jeden Werbeblocker, Skriptblocker oder jede Datenschutz-Erweiterung (uBlock, AdBlock, Ghostery, Brave Shields und Ähnliches) für diese Seite, oder fügen Sie die Domain zur Positivliste der Erweiterung hinzu.",
        "Laden Sie die Einzahlungsseite neu und starten Sie die Einzahlung erneut.",
      ],
    },
    { type: "image", src: `${IMG}/debit-card-wont-verify-2.png`, alt: "Browser-Berechtigungsfenster mit allen für account.ninjatrader.com zugelassenen Berechtigungen" },
    { type: "paragraph", html: "Zwei Dinge stolpern hier häufig. Erstens: Wenn Sie mehrere Erweiterungen installiert haben, ist ein Inkognito- oder privates Fenster mit deaktivierten Erweiterungen der schnellste Weg, um zu testen, ob eine davon der Übeltäter ist. Zweitens: Arbeits- und Schul-Laptops erzwingen manchmal eine Sicherheitsrichtlinie, die diese Fenster blockiert, egal was Sie ändern – versuchen Sie es in diesem Fall auf einem privaten Gerät." },
    { type: "heading", text: "Lösung 2: Die Kartenverifizierung sauber durchlaufen" },
    { type: "paragraph", html: "Sobald der Browser kein Hindernis mehr ist, ist der Einzahlungsvorgang selbst kurz. Öffnen Sie in Tradovate <strong class='text-white'>Application Settings</strong> (oben rechts), gehen Sie zu <strong class='text-white'>Accounts</strong>, dann <strong class='text-white'>Fund Account</strong>, und wählen Sie <strong class='text-white'>Debit Cards</strong>. Stimmen Sie der Offenlegung und den Bedingungen zu und gehen Sie die Verifizierungsschritte sorgfältig durch:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Unterschreiben Sie die Risikooffenlegung korrekt.</strong> Aktivieren Sie beide Kontrollkästchen und geben Sie Ihren Namen genau so ein, wie er in Ihrem Tradovate-Konto hinterlegt ist. Eine Abweichung hier kann den gesamten Vorgang blockieren.",
        "<strong class='text-white'>Geben Sie die Kartendaten ein</strong> und klicken Sie auf <strong class='text-white'>Add debit card</strong>, um die Karte zu verknüpfen.",
        "<strong class='text-white'>Erscheint ein zusätzlicher Verifizierungsschritt,</strong> weist Sie eine Meldung darauf hin, und Sie klicken auf <strong class='text-white'>Proceed</strong>. Hier verlangen manche Karten, dass Sie die Karte vor die Kamera Ihres Geräts halten oder klare Fotos von Vorder- und Rückseite hochladen.",
        "<strong class='text-white'>Verwenden Sie eine Karte mit aufgedrucktem Namen.</strong> Der Dienstleister muss diesen Namen erfassen, um Ihre Identität zu bestätigen. Karten ohne aufgedruckten Namen und viele Prepaid-Karten bestehen die Prüfung nicht.",
      ],
    },
    { type: "image", src: `${IMG}/debit-card-wont-verify-3.png`, alt: "Debitkarten-Verifizierungsschritt, der den Nutzer auffordert, die Karte vor die Gerätekamera zu halten" },
    { type: "paragraph", html: "Wenn die Kameraaufnahme der Knackpunkt ist, helfen gutes Licht und eine ruhige Hand mehr als alles andere. Füllen Sie den Bildausschnitt mit der Karte, halten Sie sie flach, damit keine Spiegelung über den Ziffern und dem Namen liegt, und halten Sie sie ruhig, bis die Aufnahme abgeschlossen ist." },
    { type: "heading", text: "Lösung 3: Die bereits hinterlegte Karte ändern" },
    { type: "paragraph", html: "Tradovate erlaubt es Ihnen, nur eine Debitkarte gleichzeitig zu hinterlegen. Wenn Sie also die falsche Karte hinzugefügt haben, die Karte gesperrt wurde oder Sie zu einer anderen wechseln müssen, können Sie nicht einfach eine zweite Karte hinzufügen und zwischen ihnen wählen. Sie müssen zuerst die bestehende Karte entfernen oder ersetzen." },
    { type: "paragraph", html: "Schreiben Sie dazu eine E-Mail an <strong class='text-white'>treasurysupport@ninjatrader.com</strong> und bitten Sie darum, die mit Ihrem Konto verknüpfte Karte zu ändern oder zu entfernen. Sobald das erledigt ist, kehren Sie zur Einzahlungsseite zurück und fügen die neue Karte hinzu. Dies ist auch die richtige Anlaufstelle, wenn die Verifizierung immer wieder fehlschlägt und Sie den Grund nicht erkennen können, da das Treasury-Team sehen kann, was der Dienstleister ablehnt." },
    { type: "image", src: `${IMG}/debit-card-wont-verify-4.png`, alt: "Meldung zu einer zusätzlichen Verifizierung mit einer Proceed-Schaltfläche während einer Tradovate-Debitkarteneinzahlung" },
    { type: "heading", text: "Lösung 4: Prüfen Sie, ob Ihre Einzahlung die Limits einhält" },
    { type: "paragraph", html: "Manchmal liegt das Problem gar nicht an der Karte, sondern am Betrag. Debitkarten-Einzahlungen haben eigene Limits, getrennt von ACH oder Überweisung, und eine Anfrage außerhalb dieser Grenzen kann wie ein Kartenfehler zurückkommen. Hier die grobe Struktur – prüfen Sie vor dem Absenden aber immer die aktuellen Werte auf dem Einzahlungsbildschirm, da sie sich ändern können." },
    {
      type: "table",
      headers: ["Detail", "Was Sie erwartet"],
      rows: [
        ["Akzeptierte Karten", "Die meisten persönlichen Debitkarten, einschließlich Visa und Mastercard. Der Name muss auf der Karte aufgedruckt sein."],
        ["Mindesteinzahlung", "Eine kleine Untergrenze von rund $5."],
        ["Höchsteinzahlung", "Etwa $5.000 innerhalb eines gleitenden 24-Geschäftsstunden-Fensters."],
        ["Häufigkeit", "Etwa eine Debitkarten-Einzahlung pro 24-Geschäftsstunden-Fenster."],
        ["Bearbeitungszeit", "In der Regel innerhalb von etwa drei Geschäftstagen für den Handel verfügbar; früh am Tag eingereichte Anfragen werden schneller bearbeitet."],
        ["Gebühren", "Für die Debitkartenmethode fällt in der Regel keine Einrichtungs- oder Einzahlungsgebühr an."],
      ],
    },
    { type: "paragraph", html: "Eine weitere Prüfung auf Kontoebene: Der Name auf der Karte und der Name Ihres Tradovate-Kontos müssen übereinstimmen. Versuchen Sie, mit der Karte eines Ehepartners oder einer Firmenkarte einzuzahlen, schlägt die Identitätsprüfung fehl, und dafür gibt es plattformseitig keine Umgehung." },
    { type: "heading", text: "Immer noch keine Verifizierung? Nutzen Sie eine andere Einzahlungsmethode" },
    { type: "paragraph", html: "Wenn Sie Ihren Browser bereinigt, eine zweite Debitkarte ausprobiert haben und die Prüfung weiterhin fehlschlägt, ist das in der Regel das Ende der Möglichkeiten für Karten auf diesem Konto, und die Verifizierung lässt sich von Ihrer Seite aus nicht erzwingen. Versuchen Sie es statt weiterer Versuche mit einer anderen Einzahlungsmethode. Eine ACH-Banküberweisung ist kostenlos und funktioniert für die meisten Einzahlungen gut, eine Überweisung ist bei größeren Beträgen am schnellsten. Beide umgehen den Kartendienstleister und dessen Verifizierung vollständig." },
    { type: "paragraph", html: "Beachten Sie, dass eingezahltes Geld kurz gesperrt bleibt, bevor Sie es wieder abheben können, und Debitkarten-Einzahlungen haben ein eigenes Sperrfenster vor der Auszahlung. Wenn Sie planen, Geld zu verschieben, informieren Sie sich vorab über das Abheben von Geldern von Tradovate, damit das Timing Sie nicht überrascht." },
    { type: "heading", text: "Ein Hinweis für Prop-Firm- und Evaluierungskonten" },
    { type: "paragraph", html: "Dieser Debitkarten-Ablauf dient der Einzahlung in Ihr eigenes Live-Tradovate-Konto. Wenn Sie sich mit einem Prop-Firm- oder Evaluierungskonto anmelden und Einzahlungsaufforderungen sehen oder eine Karte sich nicht hinzufügen lässt, ist das eine andere Sache. Bei einem Evaluierungskonto zahlen Sie kein eigenes Geld ein, und jede Firma legt eigene Regeln, Gebühren und Reset-Verfahren fest. Diese unterscheiden sich je nach Firma und Kontogröße, prüfen Sie also die aktuellen Regeln Ihrer Firma und wenden Sie sich an deren Support statt an das Treasury-Team von Tradovate." },
  ], es: [
    { type: "paragraph", html: "Introdujo su tarjeta, pulsó enviar y, en lugar de una confirmación, apareció un indicador de carga que nunca termina, una ventana emergente en blanco o un simple mensaje de &ldquo;verificación fallida&rdquo;. Nueve de cada diez veces no es su banco el que bloquea el cargo. Es su navegador el que cierra silenciosamente la ventana de verificación de tarjeta que el procesador de pagos de Tradovate intenta abrir, o una tarjeta que no supera la verificación de identidad. Ambos casos se solucionan en pocos minutos." },
    { type: "quote", html: "<strong class='text-white'>Solución rápida:</strong> active todos los permisos del sitio para <strong class='text-white'>account.ninjatrader.com</strong> en su navegador, desactive cualquier bloqueador de anuncios o extensión de privacidad para esa página y vuelva a intentar el depósito. Asegúrese de que la tarjeta sea una tarjeta de débito personal con su nombre impreso en el frente. Si sigue sin verificarse, recuerde que solo puede tener una tarjeta registrada a la vez, así que envíe un correo a <strong class='text-white'>treasurysupport@ninjatrader.com</strong> para cambiar la tarjeta vinculada, o deposite mediante ACH o transferencia bancaria." },
    { type: "heading", text: "Qué está ocurriendo realmente" },
    { type: "paragraph", html: "Tradovate ahora pertenece a NinjaTrader, y los depósitos con tarjeta de débito se gestionan en <strong class='text-white'>account.ninjatrader.com</strong> a través de un procesador de tarjetas externo (en su extracto el cargo aparece como enviado a Stripe). Ese procesador ejecuta un paso de verificación directamente en su navegador: una pequeña ventana o solicitud de cámara que confirma que la tarjeta le pertenece. Cuando su navegador bloquea ventanas emergentes, cookies, la cámara o scripts para ese dominio, la ventana de verificación nunca carga o falla en silencio, y el depósito parece &ldquo;no verificarse&rdquo; aunque no haya nada malo con la tarjeta." },
    { type: "paragraph", html: "La otra causa común es la tarjeta en sí. El procesador debe leer el nombre en la tarjeta y compararlo con su cuenta. Si el nombre no está impreso en la tarjeta, o si usa una tarjeta de crédito o prepago, la verificación falla por diseño." },
    { type: "heading", text: "Solución 1: desbloquear account.ninjatrader.com en su navegador" },
    { type: "paragraph", html: "Esta es la solución más eficaz y toma menos de un minuto. La ventana de verificación depende de scripts, cookies y, a veces, del acceso a la cámara desde el dominio de NinjaTrader. Si su navegador o una extensión bloquea alguno de ellos, elimine el bloqueo solo para ese sitio." },
    { type: "heading", text: "Pasos" },
    {
      type: "list",
      items: [
        "Abra el panel <strong class='text-white'>Site settings</strong> o <strong class='text-white'>Site permissions</strong> de su navegador. En Chrome y Edge lo encontrará en Configuración &rsaquo; Privacidad y seguridad &rsaquo; Configuración de sitios (el texto exacto varía entre navegadores y versiones).",
        "Busque o agregue <strong class='text-white'>account.ninjatrader.com</strong>.",
        "Configure todos los permisos de ese sitio en <strong class='text-white'>Allow</strong>: ventanas emergentes y redirecciones, cookies, JavaScript y acceso a la cámara. El de la cámara es importante porque algunas tarjetas requieren que sostenga la tarjeta física frente a su webcam.",
        "Desactive cualquier bloqueador de anuncios, bloqueador de scripts o extensión de privacidad (uBlock, AdBlock, Ghostery, Brave Shields y similares) para esa página, o agregue el dominio a la lista de permitidos de esa extensión.",
        "Recargue la página de depósito y comience de nuevo.",
      ],
    },
    { type: "image", src: `${IMG}/debit-card-wont-verify-2.png`, alt: "Panel de permisos del sitio en el navegador mostrando todos los permisos habilitados para account.ninjatrader.com" },
    { type: "paragraph", html: "Aquí hay dos cosas que suelen confundir. Primero, si tiene varias extensiones, una ventana de incógnito o privada con las extensiones desactivadas es la forma más rápida de comprobar si alguna es la culpable. Segundo, los portátiles de trabajo o de estudio a veces imponen una política de seguridad que bloquea estas ventanas sin importar lo que cambie, así que si usa un dispositivo gestionado, pruebe con uno personal." },
    { type: "heading", text: "Solución 2: completar la verificación de la tarjeta correctamente" },
    { type: "paragraph", html: "Una vez resuelto el tema del navegador, el proceso de depósito en sí es breve. En Tradovate, abra <strong class='text-white'>Application Settings</strong> (esquina superior derecha), vaya a <strong class='text-white'>Accounts</strong>, luego a <strong class='text-white'>Fund Account</strong>, y elija <strong class='text-white'>Debit Cards</strong>. Acepte la divulgación y los términos, y siga con cuidado los pasos de verificación:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Firme correctamente la divulgación de riesgos.</strong> Marque ambas casillas y escriba su nombre exactamente como aparece en su cuenta de Tradovate. Una discrepancia aquí puede detener todo el proceso.",
        "<strong class='text-white'>Ingrese los datos de la tarjeta</strong> y haga clic en <strong class='text-white'>Add debit card</strong> para vincularla.",
        "<strong class='text-white'>Si aparece un paso de verificación adicional,</strong> un mensaje se lo indicará y deberá hacer clic en <strong class='text-white'>Proceed</strong>. Aquí es donde algunas tarjetas piden sostener la tarjeta frente a la cámara del dispositivo o subir fotos nítidas del frente y el reverso.",
        "<strong class='text-white'>Use una tarjeta con su nombre impreso en el frente.</strong> El procesador debe capturar ese nombre para confirmar su identidad. Las tarjetas sin nombre impreso, y muchas tarjetas prepago, no pasan la verificación.",
      ],
    },
    { type: "image", src: `${IMG}/debit-card-wont-verify-3.png`, alt: "Paso de verificación de tarjeta de débito que solicita al usuario sostener la tarjeta frente a la cámara del dispositivo" },
    { type: "paragraph", html: "Si la captura con la cámara es el obstáculo, una buena iluminación y el pulso firme ayudan más que cualquier otra cosa. Llene el encuadre con la tarjeta, manténgala plana para evitar reflejos sobre los números y el nombre, y sosténgala quieta hasta que la captura se complete." },
    { type: "heading", text: "Solución 3: cambiar la tarjeta ya vinculada" },
    { type: "paragraph", html: "Tradovate solo permite tener una tarjeta de débito registrada a la vez. Así que si agregó la tarjeta equivocada, esa tarjeta fue cancelada o necesita cambiar a otra, no puede simplemente agregar una segunda tarjeta y elegir entre ellas. Primero debe eliminar o reemplazar la existente." },
    { type: "paragraph", html: "Para ello, envíe un correo a <strong class='text-white'>treasurysupport@ninjatrader.com</strong> y pida que cambien o eliminen la tarjeta vinculada a su cuenta. Una vez hecho esto, vuelva a la pantalla de depósito y agregue la nueva tarjeta. Este también es el contacto correcto si la verificación sigue fallando y no logra identificar el motivo, ya que su equipo de tesorería puede ver qué está rechazando el procesador." },
    { type: "image", src: `${IMG}/debit-card-wont-verify-4.png`, alt: "Mensaje de verificación adicional con un botón Proceed durante un depósito con tarjeta de débito en Tradovate" },
    { type: "heading", text: "Solución 4: confirme que su depósito cumple con los límites" },
    { type: "paragraph", html: "A veces el problema no es la tarjeta, sino el monto. Los depósitos con tarjeta de débito tienen sus propios límites, distintos de ACH o transferencia bancaria, y una solicitud fuera de esos límites puede rebotar y parecer un fallo de la tarjeta. Esta es la referencia general, aunque siempre debe confirmar las cifras actuales en la pantalla de depósito antes de enviar, porque cambian." },
    {
      type: "table",
      headers: ["Detalle", "Qué esperar"],
      rows: [
        ["Tarjetas aceptadas", "La mayoría de las tarjetas de débito personales, incluidas Visa y Mastercard. El nombre debe estar impreso en la tarjeta."],
        ["Depósito mínimo", "Un mínimo aproximado de $5."],
        ["Depósito máximo", "Aproximadamente $5,000 dentro de una ventana móvil de 24 horas hábiles."],
        ["Frecuencia", "Aproximadamente un depósito con tarjeta de débito por ventana de 24 horas hábiles."],
        ["Tiempo de acreditación", "Generalmente disponible para operar en unos tres días hábiles; las solicitudes hechas temprano en el día se procesan más rápido."],
        ["Comisiones", "Normalmente no hay comisión de configuración ni de depósito para el método de tarjeta de débito."],
      ],
    },
    { type: "paragraph", html: "Otra verificación a nivel de cuenta: el nombre en la tarjeta y el nombre de su cuenta de Tradovate deben coincidir. Si intenta depositar con la tarjeta de su cónyuge o una tarjeta empresarial, la verificación de identidad fallará, y no existe forma de evitarlo desde la plataforma." },
    { type: "heading", text: "¿Sigue sin verificarse? Use otro método de depósito" },
    { type: "paragraph", html: "Si ya limpió su navegador, probó con una segunda tarjeta de débito y la verificación sigue fallando, normalmente ese es el límite para las tarjetas en esa cuenta, y la verificación no se puede forzar desde su lado. En lugar de seguir intentando, financie la cuenta de otra forma. Una transferencia ACH es gratuita y funciona bien para la mayoría de los depósitos, y una transferencia bancaria es la más rápida para montos mayores. Ambas evitan por completo el procesador de tarjetas y su verificación." },
    { type: "paragraph", html: "Tenga en cuenta que el dinero que deposita queda bajo una breve retención antes de poder retirarlo, y los depósitos con tarjeta de débito en particular tienen su propia ventana de retención antes del retiro. Si planea mover fondos, infórmese primero sobre cómo retirar fondos de Tradovate para que el tiempo de espera no le sorprenda." },
    { type: "heading", text: "Una nota para cuentas de prop firm y evaluación" },
    { type: "paragraph", html: "Este proceso de tarjeta de débito es para financiar su propia cuenta en vivo de Tradovate. Si inicia sesión con una cuenta de prop firm o de evaluación y ve solicitudes de depósito o una tarjeta que no se vincula, se trata de un caso distinto. En una cuenta de evaluación no deposita su propio dinero, y cada firma establece sus propias reglas, comisiones y proceso de reinicio. Estas varían según la firma y el tamaño de la cuenta, así que consulte las reglas vigentes de su firma y contacte al soporte de la firma en lugar de al departamento de tesorería de Tradovate." },
  ], fr: [
    { type: "paragraph", html: "Vous avez saisi votre carte, cliqué sur envoyer, et au lieu d'une confirmation, vous avez obtenu une roue de chargement qui ne s'arrête jamais, une fenêtre pop-up vide ou un simple message &laquo;&nbsp;échec de la vérification&nbsp;&raquo;. Neuf fois sur dix, ce n'est pas votre banque qui bloque le paiement. C'est votre navigateur qui interrompt discrètement la fenêtre de vérification de carte que le prestataire de paiement de Tradovate tente d'ouvrir, ou une carte qui ne passe pas le contrôle d'identité. Les deux se résolvent en quelques minutes." },
    { type: "quote", html: "<strong class='text-white'>Solution rapide :</strong> activez toutes les autorisations de site pour <strong class='text-white'>account.ninjatrader.com</strong> dans votre navigateur, désactivez tout bloqueur de publicités ou extension de confidentialité sur cette page, puis relancez le dépôt. Assurez-vous que la carte est une carte de débit personnelle avec votre nom imprimé au recto. Si la vérification échoue toujours, rappelez-vous que vous ne pouvez avoir qu'une seule carte enregistrée à la fois : envoyez un e-mail à <strong class='text-white'>treasurysupport@ninjatrader.com</strong> pour changer la carte liée, ou approvisionnez votre compte par ACH ou virement bancaire." },
    { type: "heading", text: "Ce qui se passe réellement" },
    { type: "paragraph", html: "Tradovate appartient désormais à NinjaTrader, et les dépôts par carte de débit sont traités sur <strong class='text-white'>account.ninjatrader.com</strong> via un prestataire de paiement tiers (sur votre relevé, le débit apparaît comme envoyé à Stripe). Ce prestataire exécute une étape de vérification directement dans votre navigateur : une petite fenêtre ou une demande d'accès à la caméra confirmant que la carte vous appartient. Lorsque votre navigateur bloque les pop-ups, les cookies, la caméra ou les scripts pour ce domaine, la fenêtre de vérification ne se charge jamais ou se ferme silencieusement, et le dépôt semble &laquo;&nbsp;ne pas se vérifier&nbsp;&raquo; alors que rien ne cloche avec la carte." },
    { type: "paragraph", html: "L'autre cause fréquente est la carte elle-même. Le prestataire doit lire le nom inscrit sur la carte et le comparer à votre compte. Si le nom n'est pas imprimé sur la carte, ou si vous utilisez une carte de crédit ou une carte prépayée, la vérification échoue par conception." },
    { type: "heading", text: "Solution 1 : débloquer account.ninjatrader.com dans votre navigateur" },
    { type: "paragraph", html: "C'est la solution la plus efficace, et elle prend moins d'une minute. La fenêtre de vérification dépend de scripts, de cookies et parfois de l'accès à la caméra chargés depuis le domaine de NinjaTrader. Si votre navigateur ou une extension bloque l'un de ces éléments, levez le blocage pour ce seul site." },
    { type: "heading", text: "Étapes" },
    {
      type: "list",
      items: [
        "Ouvrez le panneau <strong class='text-white'>Site settings</strong> ou <strong class='text-white'>Site permissions</strong> de votre navigateur. Sur Chrome et Edge, il se trouve sous Paramètres &rsaquo; Confidentialité et sécurité &rsaquo; Paramètres des sites (le libellé exact varie selon le navigateur et la version).",
        "Recherchez ou ajoutez <strong class='text-white'>account.ninjatrader.com</strong>.",
        "Réglez chaque autorisation de ce site sur <strong class='text-white'>Allow</strong> : pop-ups et redirections, cookies, JavaScript et accès à la caméra. L'accès caméra compte, car certaines cartes exigent de présenter la carte physique devant votre webcam.",
        "Désactivez tout bloqueur de publicités, bloqueur de scripts ou extension de confidentialité (uBlock, AdBlock, Ghostery, Brave Shields et autres) pour cette page, ou ajoutez le domaine à la liste blanche de cette extension.",
        "Rechargez la page d'approvisionnement et relancez le dépôt.",
      ],
    },
    { type: "image", src: `${IMG}/debit-card-wont-verify-2.png`, alt: "Panneau des autorisations de site du navigateur montrant toutes les autorisations activées pour account.ninjatrader.com" },
    { type: "paragraph", html: "Deux points prêtent souvent à confusion ici. D'abord, si vous avez plusieurs extensions, une fenêtre de navigation privée avec les extensions désactivées est le moyen le plus rapide de tester laquelle est en cause. Ensuite, les ordinateurs professionnels ou scolaires imposent parfois une politique de sécurité qui bloque ces fenêtres quoi que vous changiez ; dans ce cas, essayez un appareil personnel." },
    { type: "heading", text: "Solution 2 : réussir la vérification de la carte proprement" },
    { type: "paragraph", html: "Une fois le navigateur réglé, le processus de dépôt lui-même est court. Dans Tradovate, ouvrez <strong class='text-white'>Application Settings</strong> (en haut à droite), allez dans <strong class='text-white'>Accounts</strong>, puis <strong class='text-white'>Fund Account</strong>, et choisissez <strong class='text-white'>Debit Cards</strong>. Acceptez la déclaration et les conditions, puis suivez attentivement les invites de vérification :" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Signez correctement la déclaration de risque.</strong> Cochez les deux cases et saisissez votre nom exactement comme il apparaît sur votre compte Tradovate. Une incohérence ici peut bloquer tout le processus.",
        "<strong class='text-white'>Saisissez les détails de la carte</strong> et cliquez sur <strong class='text-white'>Add debit card</strong> pour la lier.",
        "<strong class='text-white'>Si une étape de vérification supplémentaire apparaît,</strong> un message vous en informe et vous cliquez sur <strong class='text-white'>Proceed</strong>. Certaines cartes demandent alors de la présenter devant la caméra de votre appareil ou de téléverser des photos nettes du recto et du verso.",
        "<strong class='text-white'>Utilisez une carte avec votre nom imprimé au recto.</strong> Le prestataire doit capturer ce nom pour confirmer votre identité. Les cartes sans nom imprimé, ainsi que de nombreuses cartes prépayées, ne passent pas la vérification.",
      ],
    },
    { type: "image", src: `${IMG}/debit-card-wont-verify-3.png`, alt: "Étape de vérification de la carte de débit invitant l'utilisateur à présenter la carte devant la caméra de l'appareil" },
    { type: "paragraph", html: "Si la capture par la caméra pose problème, un bon éclairage et une main stable aident plus que tout. Remplissez le cadre avec la carte, gardez-la à plat pour éviter les reflets sur les chiffres et le nom, et maintenez-la immobile jusqu'à la fin de la capture." },
    { type: "heading", text: "Solution 3 : changer la carte déjà liée" },
    { type: "paragraph", html: "Tradovate ne permet d'enregistrer qu'une seule carte de débit à la fois. Donc si vous avez ajouté la mauvaise carte, si cette carte a été fermée, ou si vous devez passer à une autre, vous ne pouvez pas simplement ajouter une deuxième carte et choisir entre les deux. Vous devez d'abord retirer ou remplacer la carte existante." },
    { type: "paragraph", html: "Pour cela, envoyez un e-mail à <strong class='text-white'>treasurysupport@ninjatrader.com</strong> et demandez le changement ou le retrait de la carte liée à votre compte. Une fois cela fait, retournez à l'écran d'approvisionnement et ajoutez la nouvelle carte. C'est aussi le bon contact si la vérification continue d'échouer sans que vous en compreniez la raison, car leur équipe trésorerie peut voir ce que le prestataire rejette." },
    { type: "image", src: `${IMG}/debit-card-wont-verify-4.png`, alt: "Message de vérification supplémentaire avec un bouton Proceed lors d'un dépôt par carte de débit sur Tradovate" },
    { type: "heading", text: "Solution 4 : vérifiez que votre dépôt respecte les limites" },
    { type: "paragraph", html: "Parfois, ce n'est pas la carte qui pose problème, mais le montant. Les dépôts par carte de débit ont leurs propres limites, distinctes de l'ACH ou du virement, et une demande hors de ces limites peut être rejetée et ressembler à un échec de carte. Voici les grandes lignes, mais vérifiez toujours les montants actuels sur l'écran de dépôt avant de valider, car ils évoluent." },
    {
      type: "table",
      headers: ["Détail", "À quoi s'attendre"],
      rows: [
        ["Cartes acceptées", "La plupart des cartes de débit personnelles, dont Visa et Mastercard. Le nom doit être imprimé sur la carte."],
        ["Dépôt minimum", "Un plancher d'environ 5 $."],
        ["Dépôt maximum", "Environ 5 000 $ sur une fenêtre glissante de 24 heures ouvrées."],
        ["Fréquence", "Environ un dépôt par carte de débit par fenêtre de 24 heures ouvrées."],
        ["Délai de traitement", "Généralement disponible pour le trading en environ trois jours ouvrés ; les demandes effectuées tôt dans la journée sont traitées plus vite."],
        ["Frais", "Généralement aucuns frais de configuration ou de dépôt pour la méthode par carte de débit."],
      ],
    },
    { type: "paragraph", html: "Autre vérification au niveau du compte : le nom sur la carte et le nom de votre compte Tradovate doivent correspondre. Si vous essayez d'approvisionner votre compte avec la carte d'un conjoint ou une carte professionnelle, le contrôle d'identité échoue, et il n'existe aucun contournement côté plateforme." },
    { type: "heading", text: "Toujours pas de vérification ? Utilisez une autre méthode de dépôt" },
    { type: "paragraph", html: "Si vous avez nettoyé votre navigateur, essayé une deuxième carte de débit, et que la vérification échoue toujours, c'est généralement la fin des options pour les cartes sur ce compte, et la vérification ne peut pas être forcée de votre côté. Plutôt que de continuer à réessayer, approvisionnez le compte autrement. Un virement ACH est gratuit et fonctionne bien pour la plupart des dépôts, et un virement bancaire est le plus rapide pour les montants plus importants. Les deux contournent entièrement le prestataire de carte et sa vérification." },
    { type: "paragraph", html: "Gardez à l'esprit que l'argent déposé reste bloqué brièvement avant de pouvoir être retiré, et les dépôts par carte de débit ont en particulier leur propre délai de blocage avant retrait. Si vous prévoyez de déplacer des fonds, informez-vous d'abord sur le retrait de fonds depuis Tradovate afin que le délai ne vous surprenne pas." },
    { type: "heading", text: "Une remarque pour les comptes prop firm et d'évaluation" },
    { type: "paragraph", html: "Ce processus de carte de débit sert à approvisionner votre propre compte Tradovate en argent réel. Si vous vous connectez avec un compte prop firm ou d'évaluation et que vous voyez des invites de dépôt ou une carte qui ne se lie pas, c'est un cas différent. Vous ne déposez pas votre propre argent sur un compte d'évaluation, et chaque firme fixe ses propres règles, frais et processus de réinitialisation. Ceux-ci varient selon la firme et la taille du compte : vérifiez donc les règles actuelles de votre firme et contactez son support plutôt que la trésorerie de Tradovate." },
  ], it: [
    { type: "paragraph", html: "Avete inserito la carta, premuto invio e, invece di una conferma, è comparsa una rotellina di caricamento che non si ferma mai, un popup vuoto o un semplice messaggio &ldquo;verifica non riuscita&rdquo;. Nove volte su dieci non è la banca a bloccare l'addebito. È il browser che chiude silenziosamente la finestra di verifica della carta che il processore di pagamenti di Tradovate cerca di aprire, oppure una carta che non supera il controllo di identità. Entrambi i casi si risolvono in pochi minuti." },
    { type: "quote", html: "<strong class='text-white'>Soluzione rapida:</strong> abilitate tutte le autorizzazioni del sito per <strong class='text-white'>account.ninjatrader.com</strong> nel browser, disattivate qualsiasi ad blocker o estensione per la privacy su quella pagina, quindi ritentate il deposito. Assicuratevi che la carta sia una carta di debito personale con il nome stampato sul fronte. Se continua a non verificarsi, ricordate che potete avere una sola carta registrata alla volta: scrivete a <strong class='text-white'>treasurysupport@ninjatrader.com</strong> per cambiare la carta collegata, oppure depositate tramite ACH o bonifico." },
    { type: "heading", text: "Cosa sta realmente succedendo" },
    { type: "paragraph", html: "Tradovate ora appartiene a NinjaTrader, e i depositi con carta di debito vengono gestiti su <strong class='text-white'>account.ninjatrader.com</strong> tramite un processore di carte di terze parti (nell'estratto conto l'addebito risulta inviato a Stripe). Quel processore esegue un passaggio di verifica direttamente nel browser: una piccola finestra o una richiesta della fotocamera che conferma che la carta è vostra. Quando il browser blocca popup, cookie, fotocamera o script per quel dominio, la finestra di verifica non si carica mai o si interrompe silenziosamente, e il deposito sembra &ldquo;non verificarsi&rdquo; anche se con la carta non c'è nulla che non va." },
    { type: "paragraph", html: "L'altra causa comune è la carta stessa. Il processore deve leggere il nome sulla carta e confrontarlo con il vostro account. Se il nome non è stampato sulla carta, oppure state usando una carta di credito o una carta prepagata, il controllo fallisce per definizione." },
    { type: "heading", text: "Soluzione 1: sbloccare account.ninjatrader.com nel browser" },
    { type: "paragraph", html: "Questa è la soluzione più efficace e richiede meno di un minuto. La finestra di verifica dipende da script, cookie e talvolta dall'accesso alla fotocamera caricati dal dominio NinjaTrader. Se il browser o un'estensione ne blocca qualcuno, rimuovete il blocco solo per quel sito." },
    { type: "heading", text: "Passaggi" },
    {
      type: "list",
      items: [
        "Aprite il pannello <strong class='text-white'>Site settings</strong> o <strong class='text-white'>Site permissions</strong> del browser. Su Chrome ed Edge si trova in Impostazioni &rsaquo; Privacy e sicurezza &rsaquo; Impostazioni sito (la dicitura esatta varia tra browser e versioni).",
        "Cercate o aggiungete <strong class='text-white'>account.ninjatrader.com</strong>.",
        "Impostate ogni autorizzazione per quel sito su <strong class='text-white'>Allow</strong>: popup e reindirizzamenti, cookie, JavaScript e accesso alla fotocamera. La fotocamera è importante perché alcune carte richiedono di mostrare la carta fisica davanti alla webcam.",
        "Disattivate qualsiasi ad blocker, blocco script o estensione per la privacy (uBlock, AdBlock, Ghostery, Brave Shields e simili) per quella pagina, oppure aggiungete il dominio alla lista consentiti di quell'estensione.",
        "Ricaricate la pagina di deposito e riavviate l'operazione.",
      ],
    },
    { type: "image", src: `${IMG}/debit-card-wont-verify-2.png`, alt: "Pannello delle autorizzazioni del sito nel browser con tutte le autorizzazioni consentite per account.ninjatrader.com" },
    { type: "paragraph", html: "Due aspetti creano spesso confusione. Primo, se avete diverse estensioni, una finestra in incognito o privata con le estensioni disattivate è il modo più veloce per capire se una di esse è la causa. Secondo, i portatili aziendali o scolastici a volte impongono un criterio di sicurezza che blocca queste finestre a prescindere da cosa modificate: in tal caso, provate con un dispositivo personale." },
    { type: "heading", text: "Soluzione 2: completare correttamente la verifica della carta" },
    { type: "paragraph", html: "Una volta risolto il problema del browser, il processo di deposito vero e proprio è breve. In Tradovate, aprite <strong class='text-white'>Application Settings</strong> (in alto a destra), andate su <strong class='text-white'>Accounts</strong>, poi <strong class='text-white'>Fund Account</strong>, e scegliete <strong class='text-white'>Debit Cards</strong>. Accettate l'informativa e i termini, quindi seguite con attenzione i passaggi di verifica:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Firmate correttamente l'informativa sul rischio.</strong> Selezionate entrambe le caselle e digitate il vostro nome esattamente come appare sul vostro account Tradovate. Una discrepanza qui può bloccare l'intero processo.",
        "<strong class='text-white'>Inserite i dati della carta</strong> e fate clic su <strong class='text-white'>Add debit card</strong> per collegarla.",
        "<strong class='text-white'>Se compare un ulteriore passaggio di verifica,</strong> un messaggio ve lo segnala e dovete fare clic su <strong class='text-white'>Proceed</strong>. In questo caso alcune carte richiedono di mostrarla davanti alla fotocamera del dispositivo o di caricare foto nitide del fronte e del retro.",
        "<strong class='text-white'>Usate una carta con il nome stampato sul fronte.</strong> Il processore deve acquisire quel nome per confermare la vostra identità. Le carte senza nome stampato, e molte carte prepagate, non superano la verifica.",
      ],
    },
    { type: "image", src: `${IMG}/debit-card-wont-verify-3.png`, alt: "Passaggio di verifica della carta di debito che invita l'utente a mostrare la carta davanti alla fotocamera del dispositivo" },
    { type: "paragraph", html: "Se la cattura tramite fotocamera è il punto critico, una buona illuminazione e una mano ferma aiutano più di ogni altra cosa. Riempite l'inquadratura con la carta, tenetela piatta per evitare riflessi su numeri e nome, e mantenetela ferma finché la cattura non è completa." },
    { type: "heading", text: "Soluzione 3: cambiare la carta già collegata" },
    { type: "paragraph", html: "Tradovate consente di avere una sola carta di debito registrata alla volta. Quindi se avete aggiunto la carta sbagliata, quella carta è stata chiusa, o dovete passare a un'altra, non potete semplicemente aggiungere una seconda carta e scegliere tra le due. Dovete prima rimuovere o sostituire quella esistente." },
    { type: "paragraph", html: "Per farlo, scrivete a <strong class='text-white'>treasurysupport@ninjatrader.com</strong> e chiedete di cambiare o rimuovere la carta collegata al vostro account. Una volta fatto, tornate alla schermata di deposito e aggiungete la nuova carta. Questo è anche il contatto giusto se la verifica continua a fallire e non riuscite a capire il motivo, poiché il loro team di tesoreria può vedere cosa sta rifiutando il processore." },
    { type: "image", src: `${IMG}/debit-card-wont-verify-4.png`, alt: "Messaggio di verifica aggiuntiva con un pulsante Proceed durante un deposito con carta di debito su Tradovate" },
    { type: "heading", text: "Soluzione 4: verificate che il vostro deposito rispetti i limiti" },
    { type: "paragraph", html: "A volte il problema non è la carta, ma l'importo. I depositi con carta di debito hanno limiti propri, distinti da ACH o bonifico, e una richiesta al di fuori di questi limiti può essere respinta sembrando un errore della carta. Ecco l'andamento generale, anche se dovreste sempre verificare le cifre attuali sulla schermata di deposito prima di inviare, perché cambiano." },
    {
      type: "table",
      headers: ["Dettaglio", "Cosa aspettarsi"],
      rows: [
        ["Carte accettate", "La maggior parte delle carte di debito personali, incluse Visa e Mastercard. Il nome deve essere stampato sulla carta."],
        ["Deposito minimo", "Una soglia minima di circa $5."],
        ["Deposito massimo", "Circa $5.000 entro una finestra mobile di 24 ore lavorative."],
        ["Frequenza", "Circa un deposito con carta di debito per finestra di 24 ore lavorative."],
        ["Tempo di accredito", "Solitamente disponibile per il trading entro circa tre giorni lavorativi; le richieste effettuate presto nella giornata vengono elaborate più velocemente."],
        ["Commissioni", "Solitamente nessuna commissione di configurazione o deposito per il metodo con carta di debito."],
      ],
    },
    { type: "paragraph", html: "Un ulteriore controllo a livello di account: il nome sulla carta e il nome sul vostro account Tradovate devono corrispondere. Se cercate di depositare con la carta del coniuge o una carta aziendale, il controllo di identità fallisce, e non esiste modo di aggirarlo lato piattaforma." },
    { type: "heading", text: "Ancora nessuna verifica? Usate un altro metodo di deposito" },
    { type: "paragraph", html: "Se avete ripulito il browser, provato una seconda carta di debito, e la verifica continua a fallire, di solito è la fine delle opzioni per le carte su quell'account, e la verifica non può essere forzata dal vostro lato. Invece di continuare a riprovare, finanziate l'account in un altro modo. Un bonifico ACH è gratuito e funziona bene per la maggior parte dei depositi, mentre un bonifico bancario è il più rapido per importi maggiori. Entrambi evitano completamente il processore della carta e la sua verifica." },
    { type: "paragraph", html: "Tenete presente che il denaro depositato resta sotto un breve blocco prima di poterlo prelevare, e i depositi con carta di debito in particolare hanno una propria finestra di blocco prima del prelievo. Se avete intenzione di spostare fondi, informatevi prima su come prelevare fondi da Tradovate, così i tempi non vi coglieranno di sorpresa." },
    { type: "heading", text: "Una nota per gli account prop firm e di valutazione" },
    { type: "paragraph", html: "Questo flusso con carta di debito serve a finanziare il vostro account Tradovate live personale. Se accedete con un account prop firm o di valutazione e vedete richieste di deposito o una carta che non si collega, si tratta di un caso diverso. In un account di valutazione non depositate denaro proprio, e ogni società stabilisce le proprie regole, commissioni e processo di reset. Questi variano in base alla società e alla dimensione dell'account, quindi controllate le regole attuali della vostra società e contattate il supporto della società anziché la tesoreria di Tradovate." },
  ] },
  ctaHeading: { en: "Fund Once, Trade Without the Babysitting", de: "Einmal einzahlen, handeln ohne ständiges Nachschauen", es: "Deposite una vez, opere sin estar pendiente", fr: "Approvisionnez une fois, tradez sans surveillance constante", it: "Deposita una volta, fai trading senza controllare sempre" },
  ctaText: { en: "Running a strategy from TradingView into Tradovate and tired of babysitting deposits, logins, and manual fills? See how PickMyTrade automates your Tradovate order flow so your alerts fire trades without you glued to the screen.", de: "Setzen Sie eine Strategie von TradingView in Tradovate um und haben genug davon, Einzahlungen, Logins und manuelle Fills ständig im Auge zu behalten? Erfahren Sie, wie PickMyTrade Ihren Tradovate-Orderfluss automatisiert, sodass Ihre Alerts Trades auslösen, ohne dass Sie am Bildschirm kleben müssen.", es: "¿Ejecuta una estrategia desde TradingView hacia Tradovate y está cansado de vigilar depósitos, inicios de sesión y ejecuciones manuales? Descubra cómo PickMyTrade automatiza su flujo de órdenes en Tradovate para que sus alertas ejecuten operaciones sin que tenga que estar pegado a la pantalla.", fr: "Vous exécutez une stratégie de TradingView vers Tradovate et en avez assez de surveiller les dépôts, les connexions et les exécutions manuelles ? Découvrez comment PickMyTrade automatise votre flux d'ordres Tradovate afin que vos alertes déclenchent des trades sans que vous soyez rivé à l'écran.", it: "State eseguendo una strategia da TradingView verso Tradovate e siete stanchi di controllare continuamente depositi, accessi ed esecuzioni manuali? Scoprite come PickMyTrade automatizza il vostro flusso di ordini su Tradovate, così i vostri alert avviano le operazioni senza che dobbiate restare incollati allo schermo." },
  ctaButtonText: { en: "Start Your Free 7-Day Trial", de: "Starten Sie Ihre kostenlose 5-Tage-Testversion", es: "Inicie su prueba gratuita de 5 días", fr: "Démarrez votre essai gratuit de 5 jours", it: "Avvia la tua prova gratuita di 5 giorni" },
  ctaUrl: "https://app.pickmytrade.trade/?register=true&utm_source=content&utm_medium=debugging",
  faqHeading: { en: "Frequently Asked Questions", de: "Häufig gestellte Fragen", es: "Preguntas frecuentes", fr: "Questions fréquentes", it: "Domande frequenti" },
  faqs: { en: [
    { q: "Why won't my debit card verify for a Tradovate deposit?", a: "Usually one of three things: your browser is blocking the card-processing window that runs on account.ninjatrader.com, an ad blocker is stopping the verification popup, or the card itself can't pass the check because your name isn't printed on it or it's a prepaid or credit card. Enable all site permissions for account.ninjatrader.com, switch off ad blockers, and use a personal debit card with your name on the front." },
    { q: "How do I change the debit card linked to my account?", a: "You can only keep one debit card on file at a time. To swap it, email treasurysupport@ninjatrader.com and ask them to change or remove the linked card, then add the new one from the funding screen." },
    { q: "Can I fund my Tradovate account with a credit card?", a: "No. The method is built for debit cards, and most standard Visa or Mastercard debit cards work. Credit cards and many prepaid cards without your name on them fail the verification step, so use a personal debit card instead." },
    { q: "What are the debit card deposit limits?", a: "At the time of writing, deposits run from a small minimum of roughly $5 up to about $5,000 within a rolling 24-business-hour window, with one deposit per window, and funds usually clear within about three business days. These change, so check the current amounts on the deposit screen before you submit." },
    { q: "My card still won't verify. What now?", a: "If it keeps failing after you fix your browser and try a different card, the check can't be bypassed on the platform side. Fund the account with an ACH transfer or a wire instead, and email treasurysupport@ninjatrader.com if you want help with the card." },
  ], de: [
    { q: "Warum lässt sich meine Debitkarte für eine Tradovate-Einzahlung nicht verifizieren?", a: "Meist einer von drei Gründen: Ihr Browser blockiert das Kartenverarbeitungsfenster auf account.ninjatrader.com, ein Werbeblocker stoppt das Verifizierungs-Popup, oder die Karte selbst besteht die Prüfung nicht, weil der Name nicht aufgedruckt ist oder es sich um eine Prepaid- oder Kreditkarte handelt. Aktivieren Sie alle Website-Berechtigungen für account.ninjatrader.com, deaktivieren Sie Werbeblocker und verwenden Sie eine persönliche Debitkarte mit aufgedrucktem Namen." },
    { q: "Wie ändere ich die mit meinem Konto verknüpfte Debitkarte?", a: "Sie können jeweils nur eine Debitkarte hinterlegen. Um sie zu ändern, schreiben Sie eine E-Mail an treasurysupport@ninjatrader.com und bitten darum, die verknüpfte Karte zu ändern oder zu entfernen, und fügen dann die neue Karte über den Einzahlungsbildschirm hinzu." },
    { q: "Kann ich mein Tradovate-Konto mit einer Kreditkarte aufladen?", a: "Nein. Diese Methode ist für Debitkarten vorgesehen, und die meisten gängigen Visa- oder Mastercard-Debitkarten funktionieren. Kreditkarten und viele Prepaid-Karten ohne aufgedruckten Namen bestehen die Verifizierung nicht – verwenden Sie stattdessen eine persönliche Debitkarte." },
    { q: "Wie hoch sind die Limits für Debitkarten-Einzahlungen?", a: "Zum Zeitpunkt der Veröffentlichung reichen Einzahlungen von einem kleinen Minimum von etwa $5 bis zu rund $5.000 innerhalb eines gleitenden 24-Geschäftsstunden-Fensters, mit einer Einzahlung pro Fenster, und das Geld ist in der Regel innerhalb von etwa drei Geschäftstagen verfügbar. Diese Werte ändern sich, prüfen Sie also die aktuellen Beträge auf dem Einzahlungsbildschirm vor dem Absenden." },
    { q: "Meine Karte lässt sich weiterhin nicht verifizieren. Was nun?", a: "Wenn es trotz Behebung des Browserproblems und einer anderen Karte weiterhin fehlschlägt, lässt sich die Prüfung plattformseitig nicht umgehen. Zahlen Sie stattdessen per ACH-Überweisung oder Wire ein, und schreiben Sie eine E-Mail an treasurysupport@ninjatrader.com, wenn Sie Hilfe mit der Karte benötigen." },
  ], es: [
    { q: "¿Por qué mi tarjeta de débito no se verifica para un depósito en Tradovate?", a: "Suele deberse a una de tres razones: su navegador bloquea la ventana de procesamiento de tarjetas que se ejecuta en account.ninjatrader.com, un bloqueador de anuncios detiene la ventana emergente de verificación, o la propia tarjeta no supera el control porque el nombre no está impreso o se trata de una tarjeta prepago o de crédito. Active todos los permisos del sitio para account.ninjatrader.com, desactive los bloqueadores de anuncios y use una tarjeta de débito personal con su nombre en el frente." },
    { q: "¿Cómo cambio la tarjeta de débito vinculada a mi cuenta?", a: "Solo puede tener una tarjeta de débito registrada a la vez. Para cambiarla, envíe un correo a treasurysupport@ninjatrader.com y pida que cambien o eliminen la tarjeta vinculada, luego agregue la nueva desde la pantalla de depósito." },
    { q: "¿Puedo financiar mi cuenta de Tradovate con una tarjeta de crédito?", a: "No. El método está diseñado para tarjetas de débito, y funcionan la mayoría de las tarjetas de débito Visa o Mastercard estándar. Las tarjetas de crédito y muchas tarjetas prepago sin nombre impreso fallan en la verificación, así que use una tarjeta de débito personal en su lugar." },
    { q: "¿Cuáles son los límites de depósito con tarjeta de débito?", a: "Al momento de escribir esto, los depósitos van desde un mínimo de aproximadamente $5 hasta unos $5,000 dentro de una ventana móvil de 24 horas hábiles, con un depósito por ventana, y los fondos suelen acreditarse en unos tres días hábiles. Estas cifras cambian, así que verifique los montos actuales en la pantalla de depósito antes de enviar." },
    { q: "Mi tarjeta sigue sin verificarse. ¿Qué hago ahora?", a: "Si sigue fallando después de solucionar el navegador y probar con otra tarjeta, la verificación no se puede omitir desde la plataforma. Financie la cuenta con una transferencia ACH o bancaria en su lugar, y envíe un correo a treasurysupport@ninjatrader.com si necesita ayuda con la tarjeta." },
  ], fr: [
    { q: "Pourquoi ma carte de débit ne se vérifie-t-elle pas pour un dépôt Tradovate ?", a: "Généralement pour l'une de ces trois raisons : votre navigateur bloque la fenêtre de traitement de carte exécutée sur account.ninjatrader.com, un bloqueur de publicités arrête la fenêtre pop-up de vérification, ou la carte elle-même ne passe pas le contrôle parce que votre nom n'y est pas imprimé ou qu'il s'agit d'une carte prépayée ou de crédit. Activez toutes les autorisations de site pour account.ninjatrader.com, désactivez les bloqueurs de publicités, et utilisez une carte de débit personnelle avec votre nom au recto." },
    { q: "Comment changer la carte de débit liée à mon compte ?", a: "Vous ne pouvez enregistrer qu'une seule carte de débit à la fois. Pour la changer, envoyez un e-mail à treasurysupport@ninjatrader.com et demandez le changement ou le retrait de la carte liée, puis ajoutez la nouvelle depuis l'écran d'approvisionnement." },
    { q: "Puis-je approvisionner mon compte Tradovate avec une carte de crédit ?", a: "Non. Cette méthode est conçue pour les cartes de débit, et la plupart des cartes de débit Visa ou Mastercard standard fonctionnent. Les cartes de crédit et de nombreuses cartes prépayées sans nom imprimé échouent à l'étape de vérification ; utilisez plutôt une carte de débit personnelle." },
    { q: "Quelles sont les limites de dépôt par carte de débit ?", a: "Au moment de la rédaction, les dépôts vont d'un minimum d'environ 5 $ à environ 5 000 $ sur une fenêtre glissante de 24 heures ouvrées, avec un dépôt par fenêtre, et les fonds sont généralement disponibles sous environ trois jours ouvrés. Ces montants évoluent, vérifiez donc les chiffres actuels sur l'écran de dépôt avant de valider." },
    { q: "Ma carte ne se vérifie toujours pas. Que faire ?", a: "Si l'échec persiste après avoir corrigé votre navigateur et essayé une autre carte, la vérification ne peut pas être contournée côté plateforme. Approvisionnez plutôt le compte par virement ACH ou virement bancaire, et envoyez un e-mail à treasurysupport@ninjatrader.com si vous avez besoin d'aide avec la carte." },
  ], it: [
    { q: "Perché la mia carta di debito non si verifica per un deposito su Tradovate?", a: "Di solito per uno di questi tre motivi: il browser blocca la finestra di elaborazione della carta eseguita su account.ninjatrader.com, un ad blocker blocca il popup di verifica, oppure la carta stessa non supera il controllo perché il nome non è stampato o si tratta di una carta prepagata o di credito. Abilitate tutte le autorizzazioni del sito per account.ninjatrader.com, disattivate gli ad blocker e usate una carta di debito personale con il nome sul fronte." },
    { q: "Come cambio la carta di debito collegata al mio account?", a: "Potete avere una sola carta di debito registrata alla volta. Per cambiarla, scrivete a treasurysupport@ninjatrader.com e chiedete di cambiare o rimuovere la carta collegata, quindi aggiungete quella nuova dalla schermata di deposito." },
    { q: "Posso finanziare il mio account Tradovate con una carta di credito?", a: "No. Il metodo è pensato per le carte di debito, e funzionano la maggior parte delle carte di debito Visa o Mastercard standard. Le carte di credito e molte carte prepagate senza nome stampato non superano la verifica: usate invece una carta di debito personale." },
    { q: "Quali sono i limiti di deposito con carta di debito?", a: "Al momento della stesura, i depositi vanno da un minimo di circa $5 fino a circa $5.000 entro una finestra mobile di 24 ore lavorative, con un deposito per finestra, e i fondi sono solitamente disponibili entro circa tre giorni lavorativi. Questi valori cambiano, quindi controllate gli importi attuali sulla schermata di deposito prima di inviare." },
    { q: "La mia carta continua a non verificarsi. Cosa faccio adesso?", a: "Se continua a fallire dopo aver risolto il problema del browser e provato un'altra carta, il controllo non può essere aggirato lato piattaforma. Finanziate l'account con un bonifico ACH o bancario, e scrivete a treasurysupport@ninjatrader.com se avete bisogno di aiuto con la carta." },
  ] },
  relatedHeading: { en: "Related Guides", de: "Verwandte Leitfäden", es: "Guías relacionadas", fr: "Guides connexes", it: "Guide correlate" },
