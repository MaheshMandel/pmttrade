  ctaHeading: { en: "Automate Without Wrestling the API", de: "Automatisieren, ohne mit der API zu kämpfen", es: "Automatice sin pelearse con la API", fr: "Automatisez sans vous battre avec l'API", it: "Automatizzi senza lottare con l'API" },
