---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "desktop-freezes-at-100-load";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/debugging/${SLUG}`;

const META_TITLE = "Tradovate Desktop Freezes at 100% Load";
const META_DESCRIPTION =
  "Desktop app loads to 100%, then freezes and ignores your clicks? Reset the workspace, run the web version, and skip the pointless reinstall.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Tradovate Desktop friert bei 100 % Ladefortschritt ein", es: "Tradovate desktop se congela al 100% de carga", fr: "Tradovate desktop se fige à 100 % de chargement", it: "Tradovate desktop si blocca al 100% del caricamento" },
  dek: { en: "The loading bar climbs, hits 100%, and then nothing. Clicks do nothing, the DOM won't open, and reinstalling doesn't help. Here's what's actually hanging the app and the one reset that usually clears it for good.", de: "Der Ladebalken steigt, erreicht 100 %, und dann passiert nichts mehr. Klicks bewirken nichts, der DOM öffnet sich nicht, und eine Neuinstallation hilft nicht. Hier erfahren Sie, was die App tatsächlich blockiert, und den einen Reset, der das Problem meist dauerhaft behebt.", es: "La barra de carga avanza, llega al 100 % y entonces no pasa nada. Los clics no hacen nada, el DOM no se abre, y reinstalar no ayuda. Aquí le explicamos qué está bloqueando realmente la aplicación y el único reinicio que suele solucionarlo de forma definitiva.", fr: "La barre de chargement avance, atteint 100 %, puis plus rien. Les clics ne font rien, le DOM ne s'ouvre pas, et la réinstallation ne sert à rien. Voici ce qui bloque réellement l'application et la seule réinitialisation qui la débloque généralement pour de bon.", it: "La barra di caricamento avanza, arriva al 100% e poi non succede nulla. I clic non fanno nulla, il DOM non si apre, e reinstallare non serve a niente. Ecco cosa sta realmente bloccando l'app e l'unico reset che di solito la risolve in modo definitivo." },
  readTime: { en: "8 min read", de: "8 Minuten Lesezeit", es: "Lectura de 8 minutos", fr: "Lecture de 8 minutes", it: "Lettura di 8 minuti" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "You double-click the Tradovate desktop icon, the loading bar climbs, hits 100%, and then nothing. The window sits there fully drawn but dead. Clicks do nothing, the DOM won't open, and you can't even close it cleanly. So you do the obvious thing: uninstall, reinstall, launch again. Same freeze, same 100%, same locked screen. If that's the loop you're stuck in, the reinstall isn't the fix, and there's a good reason it never was. This walks through what's actually hanging the app at full load, how to get back to trading in about a minute, and the one reset that usually clears it for good." },
    {
      type: "checklist",
      heading: "Quick Checklist for a Desktop App Stuck at 100%",
      items: [
        "<strong class='text-white'>Frozen at full load right now?</strong> Open the web version in a browser and sign in, same account, same orders, no install needed.",
        "<strong class='text-white'>Already reinstalled and still frozen?</strong> Stop reinstalling. The problem syncs with your account, not the program files.",
        "<strong class='text-white'>Real fix:</strong> Reset your default workspace from the web version, then reopen the desktop app.",
        "<strong class='text-white'>Backup first:</strong> If you can reach the menu, save your current layout under a new name before you reset.",
        "<strong class='text-white'>Still hanging?</strong> Update your graphics driver, install the latest desktop build, and sync your system clock.",
        "<strong class='text-white'>Loops of disconnects?</strong> Log out of every device, Tradovate allows only two active sessions.",
      ],
    },
    { type: "heading", text: "What &ldquo;Freezes at 100% Load&rdquo; Actually Means" },
    { type: "paragraph", html: "The loading bar isn't measuring your download. By the time it reaches 100%, the desktop app has already pulled in the interface and is doing the last thing it does before handing you control: rebuilding your saved workspace, the charts, the DOM ladders, the watchlists, the exact panel layout you left last time. That final step is where these freezes live. If the saved layout it's trying to draw is corrupted or references something the app can't render, the render loop stalls at the finish line. The window looks complete but it's locked, because the app never actually finished painting it." },
    { type: "paragraph", html: "That single detail explains the most frustrating part of this bug, why reinstalling does nothing. Your workspace doesn't live inside the installed program on your hard drive. It's saved with your Tradovate account and synced across web, desktop, and mobile so your layout follows you between devices. When you uninstall the app, you delete the program, not the layout. Reinstall, log back in, and the app dutifully downloads the same corrupted workspace from your account and freezes on it again. You can reinstall ten times and hit the identical wall each time, because you keep handing the fresh install the same broken layout to choke on." },
    { type: "paragraph", html: "Once you see it that way, the fix stops being about the app and starts being about the workspace. And the easiest place to fix a workspace when your desktop app is frozen is the version that doesn't depend on that frozen app at all." },
    { type: "heading", text: "Fix It: Reset the Workspace, Not the Install" },
    { type: "heading", text: "Step 1: Get back to trading through the web version" },
    { type: "paragraph", html: "Before you touch settings, get your eyes back on your account. Open the Tradovate web platform in any browser and sign in with the same credentials you use on the desktop app. It reaches the exact same account, positions, and working orders, so if you have something open, you can manage it right now instead of waiting on a frozen window. The web version needs no install and runs on Windows, Mac, or a phone, which makes it the reliable fallback whenever the desktop build acts up. Confirm the current web address from Tradovate's official platforms page rather than an old bookmark." },
    { type: "heading", text: "Step 2: Reset the default workspace from the web" },
    { type: "paragraph", html: "Here's the actual repair. Because your layout is what's jamming the desktop app, and because that layout syncs from your account, you can clear it from the web version and the desktop app will pick up the clean version afterward." },
    {
      type: "list",
      items: [
        "Signed into the web platform, look at the top-left area for the workspace / add-workspace icon that manages your saved layouts.",
        "Open that menu and choose the option that <strong class='text-white'>resets or restores the default workspace</strong>. Selecting it reverts the layout to Tradovate's original settings and discards the saved changes that were breaking it.",
        "If you can still open the menu and want to keep your setup, save your current workspace under a new name first, that way you have a backup to rebuild from instead of losing your charts and indicators outright.",
      ],
    },
    { type: "paragraph", html: "Menu wording shifts between platform versions, so confirm the exact label in your build before you click. The behavior is what matters: you're throwing away the corrupted layout the desktop app kept choking on." },
    { type: "heading", text: "Step 3: Reopen the desktop app" },
    { type: "paragraph", html: "Now launch the desktop app again. This time the workspace it downloads is the clean default, so the render finishes and you get control back. If it still loads the old broken layout, sign out of the desktop app completely and sign back in so it re-syncs fresh from your account, and if it's an old build, grab the current desktop installer from Tradovate's official downloads page while you're at it. Running the newest version rules out a bug that a past update already patched." },
    { type: "heading", text: "If the Workspace Reset Doesn't Do It" },
    { type: "paragraph", html: "A corrupted layout is the usual culprit, but it's not the only thing that can hang a desktop app at the last stretch of loading. Work through these next." },
    { type: "heading", text: "Update your graphics driver" },
    { type: "paragraph", html: "The desktop app draws charts through your machine's graphics hardware. An outdated or flaky GPU driver can stall that final render, the app loads everything, tries to paint the charts, and freezes. Update your graphics driver from your hardware vendor (or through Windows Update), reboot, and try again. This is standard practice for any chart-heavy desktop trading app, not just Tradovate." },
    { type: "heading", text: "Sync your system clock and check your connection" },
    { type: "paragraph", html: "Tradovate's session checks expect your computer's clock to line up closely with its servers. Drift by even a handful of seconds and the session can get rejected mid-handshake, which shows up as a stall rather than a clear error. On Windows, right-click the taskbar clock, open the date and time settings, and click <strong class='text-white'>Sync now</strong>. While you're there, move to a wired Ethernet connection if you can, a shaky Wi-Fi link during load can leave the app waiting on data it never fully receives." },
    { type: "heading", text: "Clear extra sessions" },
    { type: "paragraph", html: "Tradovate caps you at two active sessions across desktop, web, mobile, and TradingView. If you've got the app open on two machines plus a phone plus a TradingView connection, the sessions fight, and one symptom is a load that never completes. Sign out everywhere, then open a single session and let it load undisturbed." },
    { type: "heading", text: "Check antivirus, firewall, and permissions" },
    { type: "paragraph", html: "Security software occasionally holds a desktop trading app at arm's length, quarantining a file or blocking the connection it needs to finish loading. If the freeze started right after a security update, add the Tradovate app to your antivirus and firewall exceptions, and try launching it once as an administrator to rule out a permissions snag." },
    { type: "heading", text: "Troubleshooting Table" },
    {
      type: "table",
      headers: ["Symptom", "What it means", "Fix"],
      rows: [
        ["Loads to 100%, then window is frozen", "Corrupted saved workspace jams the final render", "Reset the default workspace from the web version"],
        ["Reinstalling changes nothing", "Workspace syncs from your account, not the install", "Fix the workspace, not the program files"],
        ["Desktop dead but you need to trade now", "Local app hang; account is still live", "Sign in on the web version, same account"],
        ["Charts never paint after load", "Graphics driver stalling the render", "Update the GPU driver and reboot"],
        ["Stalls or drops during load", "Clock drift or unstable connection", "Sync system clock; use wired Ethernet"],
        ["Repeated disconnects while loading", "Too many active sessions", "Log out of all devices; open one session"],
      ],
    },
    { type: "heading", text: "A Note for Prop-Firm Traders" },
    { type: "paragraph", html: "If you're running an evaluation or funded account through a prop firm, a desktop app that won't load is more than an annoyance, it's time you can't watch your risk. The buffers, loss limits, and drawdown rules vary by firm and account size, so check your firm's current rules, but the survival habit is the same everywhere: never let a single frozen app be the only thing standing between you and your positions. Keep the web version bookmarked as an instant fallback, know how your firm expects you to reach them in an emergency, and make sure any protective stop is resting on Tradovate's servers rather than living only in the local window you just lost." },
    { type: "heading", text: "Stop Letting a Frozen App Decide Your Trade" },
    { type: "paragraph", html: "You can't stop the desktop app from occasionally hanging at load, but you can stop that hang from touching your orders. PickMyTrade routes your TradingView alerts to Tradovate through its own servers, so your execution doesn't ride on whether a chart window on your machine finished painting:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Server-side execution</strong>, entries and exits go server-to-server, so a desktop app frozen at 100% on your PC doesn't halt an order that's already been sent.",
        "<strong class='text-white'>Stops and targets attached on entry</strong>, every automated entry can carry its stop-loss and take-profit, so your protection sits on Tradovate's servers the moment you're filled, not after you unfreeze the app.",
        "<strong class='text-white'>A fallback you don't have to rebuild</strong>, because your strategy lives in the alert, you can fail over to the web platform or another device without re-creating anything.",
        "<strong class='text-white'>Multi-account sync</strong>, mirror the same order across accounts so one stalled connection isn't your only path to the market.",
      ],
    },
  ], de: [
    { type: "paragraph", html: "Sie doppelklicken auf das Tradovate-Desktop-Symbol, der Ladebalken steigt, erreicht 100 %, und dann passiert nichts mehr. Das Fenster steht vollständig gezeichnet da, aber tot. Klicks bewirken nichts, der DOM öffnet sich nicht, und Sie können es nicht einmal sauber schließen. Also tun Sie das Naheliegende: deinstallieren, neu installieren, erneut starten. Derselbe Absturz, dieselben 100 %, derselbe blockierte Bildschirm. Wenn Sie in dieser Schleife feststecken, ist die Neuinstallation nicht die Lösung – und dafür gibt es einen guten Grund. Hier erfahren Sie, was die App tatsächlich bei voller Ladung blockiert, wie Sie in etwa einer Minute wieder handeln können, und den einen Reset, der das Problem meist dauerhaft behebt." },
    {
      type: "checklist",
      heading: "Schnelle Checkliste für eine bei 100 % hängende Desktop-App",
      items: [
        "<strong class='text-white'>Gerade bei voller Ladung eingefroren?</strong> Öffnen Sie die Web-Version in einem Browser und melden Sie sich an – dasselbe Konto, dieselben Orders, keine Installation nötig.",
        "<strong class='text-white'>Bereits neu installiert und trotzdem eingefroren?</strong> Hören Sie auf, neu zu installieren. Das Problem synchronisiert sich mit Ihrem Konto, nicht mit den Programmdateien.",
        "<strong class='text-white'>Echte Lösung:</strong> Setzen Sie Ihren Standard-Workspace über die Web-Version zurück und öffnen Sie dann die Desktop-App erneut.",
        "<strong class='text-white'>Erst sichern:</strong> Wenn Sie das Menü erreichen können, speichern Sie Ihr aktuelles Layout unter einem neuen Namen, bevor Sie zurücksetzen.",
        "<strong class='text-white'>Immer noch hängengeblieben?</strong> Aktualisieren Sie Ihren Grafiktreiber, installieren Sie den neuesten Desktop-Build und synchronisieren Sie Ihre Systemuhr.",
        "<strong class='text-white'>Wiederholte Verbindungsabbrüche?</strong> Melden Sie sich von jedem Gerät ab – Tradovate erlaubt nur zwei aktive Sitzungen.",
      ],
    },
    { type: "heading", text: "Was &ldquo;Freezes at 100% Load&rdquo; tatsächlich bedeutet" },
    { type: "paragraph", html: "Der Ladebalken misst nicht Ihren Download. Bis er 100 % erreicht, hat die Desktop-App die Oberfläche bereits geladen und erledigt als Letztes, bevor sie Ihnen die Kontrolle übergibt: den Wiederaufbau Ihres gespeicherten Workspace, der Charts, der DOM-Leitern, der Watchlists, genau des Panel-Layouts, das Sie zuletzt hinterlassen haben. Genau in diesem letzten Schritt liegen diese Einfrierungen. Ist das gespeicherte Layout, das gezeichnet werden soll, beschädigt oder verweist es auf etwas, das die App nicht darstellen kann, bleibt die Render-Schleife kurz vor dem Ziel stehen. Das Fenster wirkt vollständig, ist aber blockiert, weil die App das Zeichnen nie wirklich abgeschlossen hat." },
    { type: "paragraph", html: "Genau dieses Detail erklärt den frustrierendsten Teil dieses Fehlers: warum eine Neuinstallation nichts bewirkt. Ihr Workspace liegt nicht im installierten Programm auf Ihrer Festplatte. Er wird mit Ihrem Tradovate-Konto gespeichert und über Web, Desktop und Mobil synchronisiert, sodass Ihr Layout Ihnen zwischen Geräten folgt. Deinstallieren Sie die App, löschen Sie das Programm, nicht das Layout. Neu installieren, wieder anmelden, und die App lädt brav denselben beschädigten Workspace aus Ihrem Konto herunter und friert erneut daran ein. Sie können zehnmal neu installieren und stoßen jedes Mal auf dieselbe Wand, weil Sie der frischen Installation immer wieder dasselbe kaputte Layout zum Verschlucken geben." },
    { type: "paragraph", html: "Sobald Sie es so betrachten, geht es bei der Lösung nicht mehr um die App, sondern um den Workspace. Und der einfachste Ort, um einen Workspace zu reparieren, während Ihre Desktop-App eingefroren ist, ist die Version, die überhaupt nicht von dieser eingefrorenen App abhängt." },
    { type: "heading", text: "So beheben Sie es: Workspace zurücksetzen, nicht die Installation" },
    { type: "heading", text: "Schritt 1: Über die Web-Version wieder handeln" },
    { type: "paragraph", html: "Bevor Sie an Einstellungen herumfummeln, verschaffen Sie sich wieder Zugriff auf Ihr Konto. Öffnen Sie die Tradovate-Web-Plattform in einem beliebigen Browser und melden Sie sich mit denselben Zugangsdaten an, die Sie in der Desktop-App verwenden. Sie erreicht genau dasselbe Konto, dieselben Positionen und laufenden Orders, sodass Sie, falls Sie etwas offen haben, es sofort verwalten können, statt auf ein eingefrorenes Fenster zu warten. Die Web-Version benötigt keine Installation und läuft unter Windows, Mac oder auf dem Handy, was sie zur zuverlässigen Ausweichlösung macht, wann immer der Desktop-Build Probleme macht. Bestätigen Sie die aktuelle Web-Adresse auf Tradovates offizieller Plattform-Seite statt eines alten Lesezeichens." },
    { type: "heading", text: "Schritt 2: Den Standard-Workspace über das Web zurücksetzen" },
    { type: "paragraph", html: "Hier ist die eigentliche Reparatur. Da Ihr Layout die Desktop-App blockiert und dieses Layout mit Ihrem Konto synchronisiert wird, können Sie es über die Web-Version löschen, und die Desktop-App übernimmt anschließend die saubere Version." },
    {
      type: "list",
      items: [
        "Suchen Sie nach der Anmeldung bei der Web-Plattform oben links nach dem Workspace-/Add-Workspace-Symbol, das Ihre gespeicherten Layouts verwaltet.",
        "Öffnen Sie dieses Menü und wählen Sie die Option, die <strong class='text-white'>den Standard-Workspace zurücksetzt oder wiederherstellt</strong>. Damit wird das Layout auf Tradovates Originaleinstellungen zurückgesetzt, und die gespeicherten Änderungen, die es beschädigt haben, werden verworfen.",
        "Können Sie das Menü noch öffnen und möchten Ihr Setup behalten, speichern Sie zuerst Ihren aktuellen Workspace unter einem neuen Namen. So haben Sie ein Backup, von dem aus Sie neu aufbauen können, statt Ihre Charts und Indikatoren komplett zu verlieren.",
      ],
    },
    { type: "paragraph", html: "Die Menübezeichnungen variieren zwischen den Plattformversionen, bestätigen Sie also die genaue Bezeichnung in Ihrem Build, bevor Sie klicken. Entscheidend ist das Verhalten: Sie werfen das beschädigte Layout weg, an dem die Desktop-App ständig hängen geblieben ist." },
    { type: "heading", text: "Schritt 3: Die Desktop-App erneut öffnen" },
    { type: "paragraph", html: "Starten Sie nun die Desktop-App erneut. Diesmal ist der heruntergeladene Workspace der saubere Standard, sodass der Renderprozess abgeschlossen wird und Sie die Kontrolle zurückerhalten. Lädt sie weiterhin das alte, beschädigte Layout, melden Sie sich vollständig von der Desktop-App ab und wieder an, damit sie sich frisch mit Ihrem Konto synchronisiert. Handelt es sich um einen alten Build, laden Sie sich gleich den aktuellen Desktop-Installer von Tradovates offizieller Download-Seite herunter. Mit der neuesten Version schließen Sie einen Fehler aus, der durch ein früheres Update bereits behoben wurde." },
    { type: "heading", text: "Wenn der Workspace-Reset nicht hilft" },
    { type: "paragraph", html: "Ein beschädigtes Layout ist meist der Übeltäter, aber nicht das Einzige, was eine Desktop-App auf der letzten Etappe des Ladens hängen lassen kann. Arbeiten Sie als Nächstes Folgendes durch." },
    { type: "heading", text: "Grafiktreiber aktualisieren" },
    { type: "paragraph", html: "Die Desktop-App zeichnet Charts über die Grafikhardware Ihres Rechners. Ein veralteter oder instabiler GPU-Treiber kann diesen letzten Render-Schritt blockieren – die App lädt alles, versucht die Charts zu zeichnen, und friert ein. Aktualisieren Sie Ihren Grafiktreiber beim Hardware-Hersteller (oder über Windows Update), starten Sie neu und versuchen Sie es erneut. Das ist gängige Praxis für jede chartlastige Desktop-Trading-App, nicht nur für Tradovate." },
    { type: "heading", text: "Systemuhr synchronisieren und Verbindung prüfen" },
    { type: "paragraph", html: "Tradovates Sitzungsprüfungen erwarten, dass die Uhr Ihres Computers eng mit dessen Servern übereinstimmt. Weicht sie auch nur um wenige Sekunden ab, kann die Sitzung mitten im Handshake abgelehnt werden, was sich eher als Stillstand denn als klarer Fehler zeigt. Klicken Sie unter Windows mit der rechten Maustaste auf die Taskleisten-Uhr, öffnen Sie die Datums- und Uhrzeiteinstellungen und klicken Sie auf <strong class='text-white'>Sync now</strong>. Wechseln Sie dabei, wenn möglich, zu einer kabelgebundenen Ethernet-Verbindung – eine wackelige WLAN-Verbindung während des Ladens kann dazu führen, dass die App auf Daten wartet, die sie nie vollständig erhält." },
    { type: "heading", text: "Zusätzliche Sitzungen beenden" },
    { type: "paragraph", html: "Tradovate begrenzt Sie auf zwei aktive Sitzungen über Desktop, Web, Mobil und TradingView hinweg. Haben Sie die App auf zwei Rechnern plus einem Handy plus einer TradingView-Verbindung geöffnet, konkurrieren die Sitzungen miteinander, und ein Symptom davon ist ein Ladevorgang, der nie abgeschlossen wird. Melden Sie sich überall ab und öffnen Sie dann eine einzige Sitzung, damit sie ungestört laden kann." },
    { type: "heading", text: "Antivirus, Firewall und Berechtigungen prüfen" },
    { type: "paragraph", html: "Sicherheitssoftware hält eine Desktop-Trading-App gelegentlich auf Abstand, indem sie eine Datei unter Quarantäne stellt oder die Verbindung blockiert, die zum Abschluss des Ladevorgangs benötigt wird. Begann das Einfrieren direkt nach einem Sicherheitsupdate, fügen Sie die Tradovate-App zu den Ausnahmen Ihres Antivirus- und Firewall-Programms hinzu und versuchen Sie, sie einmal als Administrator zu starten, um ein Berechtigungsproblem auszuschließen." },
    { type: "heading", text: "Fehlerbehebungstabelle" },
    {
      type: "table",
      headers: ["Symptom", "Was es bedeutet", "Lösung"],
      rows: [
        ["Lädt bis 100 %, dann ist das Fenster eingefroren", "Beschädigter gespeicherter Workspace blockiert das finale Rendering", "Standard-Workspace über die Web-Version zurücksetzen"],
        ["Neuinstallation ändert nichts", "Der Workspace synchronisiert sich mit Ihrem Konto, nicht mit der Installation", "Den Workspace reparieren, nicht die Programmdateien"],
        ["Desktop tot, aber Sie müssen jetzt handeln", "Lokale App hängt; Konto ist weiterhin aktiv", "Bei der Web-Version anmelden, dasselbe Konto"],
        ["Charts werden nach dem Laden nie gezeichnet", "Grafiktreiber blockiert das Rendering", "GPU-Treiber aktualisieren und neu starten"],
        ["Stockt oder bricht während des Ladens ab", "Uhrabweichung oder instabile Verbindung", "Systemuhr synchronisieren; kabelgebundenes Ethernet verwenden"],
        ["Wiederholte Verbindungsabbrüche während des Ladens", "Zu viele aktive Sitzungen", "Von allen Geräten abmelden; eine einzige Sitzung öffnen"],
      ],
    },
    { type: "heading", text: "Ein Hinweis für Prop-Firm-Trader" },
    { type: "paragraph", html: "Wenn Sie ein Evaluierungs- oder finanziertes Konto über eine Prop-Firma betreiben, ist eine nicht ladende Desktop-App mehr als nur ärgerlich – es ist Zeit, in der Sie Ihr Risiko nicht im Blick haben können. Puffer, Verlustgrenzen und Drawdown-Regeln variieren je nach Firma und Kontogröße, prüfen Sie also die aktuellen Regeln Ihrer Firma, aber die Überlebensgewohnheit ist überall gleich: Lassen Sie niemals eine einzige eingefrorene App das Einzige sein, was zwischen Ihnen und Ihren Positionen steht. Halten Sie die Web-Version als sofortige Ausweichlösung als Lesezeichen bereit, wissen Sie, wie Ihre Firma erwartet, dass Sie sie im Notfall erreichen, und stellen Sie sicher, dass jeder Schutzstop auf Tradovates Servern liegt, statt nur in dem lokalen Fenster zu existieren, das Sie gerade verloren haben." },
    { type: "heading", text: "Lassen Sie nicht länger eine eingefrorene App über Ihren Trade entscheiden" },
    { type: "paragraph", html: "Sie können nicht verhindern, dass die Desktop-App gelegentlich beim Laden hängen bleibt, aber Sie können verhindern, dass dieses Hängen Ihre Orders betrifft. PickMyTrade leitet Ihre TradingView-Alerts über eigene Server an Tradovate weiter, sodass Ihre Ausführung nicht davon abhängt, ob ein Chart-Fenster auf Ihrem Rechner fertig gezeichnet wurde:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Serverseitige Ausführung</strong> – Einstiege und Ausstiege laufen Server-zu-Server, sodass eine bei 100 % eingefrorene Desktop-App auf Ihrem PC eine bereits gesendete Order nicht aufhält.",
        "<strong class='text-white'>Stops und Ziele bereits beim Einstieg gesetzt</strong> – jeder automatisierte Einstieg kann Stop-Loss und Take-Profit mitführen, sodass Ihr Schutz in dem Moment auf Tradovates Servern liegt, in dem Sie ausgeführt werden, nicht erst, nachdem Sie die App wieder aufgetaut haben.",
        "<strong class='text-white'>Eine Ausweichlösung, die Sie nicht neu aufbauen müssen</strong> – da Ihre Strategie im Alert liegt, können Sie ohne Neuerstellung auf die Web-Plattform oder ein anderes Gerät ausweichen.",
        "<strong class='text-white'>Multi-Konto-Synchronisierung</strong> – spiegeln Sie dieselbe Order über mehrere Konten, sodass eine blockierte Verbindung nicht Ihr einziger Zugang zum Markt ist.",
      ],
    },
  ], es: [
    { type: "paragraph", html: "Hace doble clic en el icono de escritorio de Tradovate, la barra de carga avanza, llega al 100 % y entonces no pasa nada. La ventana queda ahí, completamente dibujada pero inerte. Los clics no hacen nada, el DOM no se abre, y ni siquiera puede cerrarla correctamente. Así que hace lo obvio: desinstalar, reinstalar, volver a iniciar. Mismo bloqueo, mismo 100 %, misma pantalla bloqueada. Si está atrapado en ese ciclo, la reinstalación no es la solución, y hay una buena razón por la que nunca lo fue. Esto explica qué es lo que realmente está bloqueando la aplicación con la carga completa, cómo volver a operar en aproximadamente un minuto, y el único reinicio que suele solucionarlo de forma definitiva." },
    {
      type: "checklist",
      heading: "Lista de verificación rápida para una aplicación de escritorio atascada al 100 %",
      items: [
        "<strong class='text-white'>¿Congelada ahora mismo con la carga completa?</strong> Abra la versión web en un navegador e inicie sesión: misma cuenta, mismas órdenes, sin necesidad de instalar nada.",
        "<strong class='text-white'>¿Ya reinstaló y sigue congelada?</strong> Deje de reinstalar. El problema se sincroniza con su cuenta, no con los archivos del programa.",
        "<strong class='text-white'>Solución real:</strong> restablezca su espacio de trabajo predeterminado desde la versión web y luego vuelva a abrir la aplicación de escritorio.",
        "<strong class='text-white'>Haga una copia primero:</strong> si puede acceder al menú, guarde su diseño actual con un nuevo nombre antes de restablecer.",
        "<strong class='text-white'>¿Sigue colgada?</strong> Actualice su controlador gráfico, instale el último build de escritorio y sincronice el reloj de su sistema.",
        "<strong class='text-white'>¿Bucles de desconexiones?</strong> Cierre sesión en todos los dispositivos; Tradovate solo permite dos sesiones activas.",
      ],
    },
    { type: "heading", text: "Qué significa realmente &ldquo;Freezes at 100% Load&rdquo;" },
    { type: "paragraph", html: "La barra de carga no está midiendo su descarga. Para cuando llega al 100 %, la aplicación de escritorio ya cargó la interfaz y está haciendo lo último que hace antes de entregarle el control: reconstruir su espacio de trabajo guardado, los gráficos, las escaleras del DOM, las listas de seguimiento, exactamente el diseño de paneles que dejó la última vez. Ese paso final es donde viven estos bloqueos. Si el diseño guardado que está intentando dibujar está corrupto o hace referencia a algo que la aplicación no puede renderizar, el bucle de renderizado se detiene justo en la meta. La ventana parece completa, pero está bloqueada, porque la aplicación nunca terminó realmente de dibujarla." },
    { type: "paragraph", html: "Ese único detalle explica la parte más frustrante de este error, por qué reinstalar no sirve de nada. Su espacio de trabajo no vive dentro del programa instalado en su disco duro. Se guarda con su cuenta de Tradovate y se sincroniza entre web, escritorio y móvil, para que su diseño le siga entre dispositivos. Al desinstalar la aplicación, elimina el programa, no el diseño. Reinstale, vuelva a iniciar sesión, y la aplicación descarga obedientemente el mismo espacio de trabajo corrupto desde su cuenta y se congela de nuevo con él. Puede reinstalar diez veces y toparse con el mismo muro cada vez, porque sigue entregando a la instalación recién hecha el mismo diseño roto con el que atragantarse." },
    { type: "paragraph", html: "Una vez que lo ve de esa manera, la solución deja de girar en torno a la aplicación y empieza a girar en torno al espacio de trabajo. Y el lugar más sencillo para arreglar un espacio de trabajo mientras su aplicación de escritorio está congelada es la versión que no depende en absoluto de esa aplicación congelada." },
    { type: "heading", text: "Cómo solucionarlo: restablezca el espacio de trabajo, no la instalación" },
    { type: "heading", text: "Paso 1: vuelva a operar a través de la versión web" },
    { type: "paragraph", html: "Antes de tocar los ajustes, vuelva a poner los ojos sobre su cuenta. Abra la plataforma web de Tradovate en cualquier navegador e inicie sesión con las mismas credenciales que usa en la aplicación de escritorio. Accede exactamente a la misma cuenta, posiciones y órdenes activas, así que si tiene algo abierto, puede gestionarlo ahora mismo en lugar de esperar a una ventana congelada. La versión web no necesita instalación y funciona en Windows, Mac o un teléfono, lo que la convierte en la alternativa fiable siempre que el build de escritorio falle. Confirme la dirección web actual en la página oficial de plataformas de Tradovate en lugar de usar un marcador antiguo." },
    { type: "heading", text: "Paso 2: restablezca el espacio de trabajo predeterminado desde la web" },
    { type: "paragraph", html: "Aquí está la reparación real. Como su diseño es lo que está bloqueando la aplicación de escritorio, y como ese diseño se sincroniza desde su cuenta, puede borrarlo desde la versión web y la aplicación de escritorio recogerá la versión limpia después." },
    {
      type: "list",
      items: [
        "Una vez conectado a la plataforma web, mire en la zona superior izquierda el icono de espacio de trabajo / añadir espacio de trabajo que gestiona sus diseños guardados.",
        "Abra ese menú y elija la opción que <strong class='text-white'>restablece o restaura el espacio de trabajo predeterminado</strong>. Al seleccionarla, el diseño vuelve a la configuración original de Tradovate y descarta los cambios guardados que lo estaban rompiendo.",
        "Si todavía puede abrir el menú y quiere conservar su configuración, guarde primero su espacio de trabajo actual con un nuevo nombre; así tendrá una copia de respaldo desde la que reconstruir en lugar de perder sus gráficos e indicadores por completo.",
      ],
    },
    { type: "paragraph", html: "El texto del menú varía entre versiones de la plataforma, así que confirme la etiqueta exacta en su build antes de hacer clic. Lo que importa es el comportamiento: está descartando el diseño corrupto con el que la aplicación de escritorio se seguía atragantando." },
    { type: "heading", text: "Paso 3: vuelva a abrir la aplicación de escritorio" },
    { type: "paragraph", html: "Ahora vuelva a iniciar la aplicación de escritorio. Esta vez, el espacio de trabajo que descarga es el predeterminado limpio, así que el renderizado se completa y recupera el control. Si sigue cargando el diseño antiguo y roto, cierre sesión completamente en la aplicación de escritorio y vuelva a iniciarla para que se resincronice desde cero con su cuenta, y si es un build antiguo, aproveche para descargar el instalador de escritorio actual desde la página oficial de descargas de Tradovate. Ejecutar la versión más reciente descarta un error que ya se haya corregido en una actualización anterior." },
    { type: "heading", text: "Si el restablecimiento del espacio de trabajo no funciona" },
    { type: "paragraph", html: "Un diseño corrupto suele ser el culpable, pero no es lo único que puede colgar una aplicación de escritorio en el último tramo de la carga. A continuación, revise lo siguiente." },
    { type: "heading", text: "Actualice su controlador gráfico" },
    { type: "paragraph", html: "La aplicación de escritorio dibuja los gráficos a través del hardware gráfico de su equipo. Un controlador de GPU desactualizado o inestable puede paralizar ese renderizado final: la aplicación carga todo, intenta pintar los gráficos, y se congela. Actualice su controlador gráfico desde el fabricante del hardware (o mediante Windows Update), reinicie y vuelva a intentarlo. Esta es una práctica estándar para cualquier aplicación de trading de escritorio con muchos gráficos, no solo Tradovate." },
    { type: "heading", text: "Sincronice el reloj de su sistema y verifique su conexión" },
    { type: "paragraph", html: "Las comprobaciones de sesión de Tradovate esperan que el reloj de su equipo coincida estrechamente con sus servidores. Un desfase de tan solo unos segundos puede provocar que la sesión sea rechazada a mitad del handshake, lo cual se manifiesta como un bloqueo en lugar de un error claro. En Windows, haga clic derecho en el reloj de la barra de tareas, abra la configuración de fecha y hora y haga clic en <strong class='text-white'>Sync now</strong>. Ya que está ahí, cambie a una conexión Ethernet por cable si puede; una conexión Wi-Fi inestable durante la carga puede dejar a la aplicación esperando datos que nunca termina de recibir." },
    { type: "heading", text: "Elimine las sesiones adicionales" },
    { type: "paragraph", html: "Tradovate le limita a dos sesiones activas entre escritorio, web, móvil y TradingView. Si tiene la aplicación abierta en dos equipos más un teléfono más una conexión de TradingView, las sesiones compiten entre sí, y un síntoma es una carga que nunca se completa. Cierre sesión en todas partes y luego abra una única sesión y deje que cargue sin interrupciones." },
    { type: "heading", text: "Revise el antivirus, el firewall y los permisos" },
    { type: "paragraph", html: "El software de seguridad a veces mantiene a distancia una aplicación de trading de escritorio, poniendo en cuarentena un archivo o bloqueando la conexión que necesita para terminar de cargar. Si el bloqueo comenzó justo después de una actualización de seguridad, añada la aplicación de Tradovate a las excepciones de su antivirus y cortafuegos, e intente iniciarla una vez como administrador para descartar un problema de permisos." },
    { type: "heading", text: "Tabla de solución de problemas" },
    {
      type: "table",
      headers: ["Síntoma", "Qué significa", "Solución"],
      rows: [
        ["Carga hasta el 100 %, luego la ventana se congela", "El espacio de trabajo guardado corrupto bloquea el renderizado final", "Restablezca el espacio de trabajo predeterminado desde la versión web"],
        ["Reinstalar no cambia nada", "El espacio de trabajo se sincroniza desde su cuenta, no desde la instalación", "Arregle el espacio de trabajo, no los archivos del programa"],
        ["Escritorio muerto pero necesita operar ahora", "Bloqueo de la aplicación local; la cuenta sigue activa", "Inicie sesión en la versión web, misma cuenta"],
        ["Los gráficos nunca se pintan después de cargar", "El controlador gráfico paraliza el renderizado", "Actualice el controlador de la GPU y reinicie"],
        ["Se atasca o se desconecta durante la carga", "Desfase del reloj o conexión inestable", "Sincronice el reloj del sistema; use Ethernet por cable"],
        ["Desconexiones repetidas durante la carga", "Demasiadas sesiones activas", "Cierre sesión en todos los dispositivos; abra una sola sesión"],
      ],
    },
    { type: "heading", text: "Una nota para traders de prop firms" },
    { type: "paragraph", html: "Si opera una cuenta de evaluación o financiada a través de una prop firm, una aplicación de escritorio que no carga es más que una molestia: es tiempo en el que no puede vigilar su riesgo. Los colchones, límites de pérdida y reglas de drawdown varían según la firma y el tamaño de la cuenta, así que consulte las reglas actuales de su firma, pero el hábito de supervivencia es el mismo en todas partes: nunca deje que una sola aplicación congelada sea lo único que se interponga entre usted y sus posiciones. Mantenga la versión web guardada como marcador de alternativa instantánea, sepa cómo su firma espera que la contacte en una emergencia, y asegúrese de que cualquier stop de protección esté descansando en los servidores de Tradovate en lugar de vivir únicamente en la ventana local que acaba de perder." },
    { type: "heading", text: "Deje de permitir que una aplicación congelada decida su operación" },
    { type: "paragraph", html: "No puede evitar que la aplicación de escritorio se cuelgue ocasionalmente al cargar, pero sí puede evitar que ese cuelgue afecte a sus órdenes. PickMyTrade enruta sus alertas de TradingView a Tradovate a través de sus propios servidores, de modo que su ejecución no depende de si una ventana de gráficos en su equipo terminó de dibujarse:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Ejecución del lado del servidor</strong>, las entradas y salidas van de servidor a servidor, así que una aplicación de escritorio congelada al 100 % en su PC no detiene una orden ya enviada.",
        "<strong class='text-white'>Stops y objetivos vinculados al entrar</strong>, cada entrada automatizada puede llevar su stop-loss y take-profit, de modo que su protección se sitúa en los servidores de Tradovate en el momento en que se ejecuta, no después de descongelar la aplicación.",
        "<strong class='text-white'>Una alternativa que no tiene que reconstruir</strong>, como su estrategia vive en la alerta, puede pasar a la plataforma web u otro dispositivo sin volver a crear nada.",
        "<strong class='text-white'>Sincronización multicuenta</strong>, replique la misma orden en varias cuentas para que una conexión bloqueada no sea su único camino al mercado.",
      ],
    },
  ], fr: [
    { type: "paragraph", html: "Vous double-cliquez sur l'icône de bureau Tradovate, la barre de chargement avance, atteint 100 %, puis plus rien. La fenêtre reste là, entièrement dessinée mais figée. Les clics ne font rien, le DOM ne s'ouvre pas, et vous ne pouvez même pas la fermer proprement. Vous faites donc l'évidence : désinstaller, réinstaller, relancer. Même blocage, mêmes 100 %, même écran verrouillé. Si c'est la boucle dans laquelle vous êtes coincé, la réinstallation n'est pas la solution, et il y a une bonne raison à cela. Voici ce qui bloque réellement l'application à pleine charge, comment reprendre le trading en environ une minute, et la seule réinitialisation qui la débloque généralement pour de bon." },
    {
      type: "checklist",
      heading: "Liste de contrôle rapide pour une application de bureau bloquée à 100 %",
      items: [
        "<strong class='text-white'>Figée à pleine charge en ce moment ?</strong> Ouvrez la version web dans un navigateur et connectez-vous, même compte, mêmes ordres, aucune installation requise.",
        "<strong class='text-white'>Déjà réinstallé et toujours figée ?</strong> Arrêtez de réinstaller. Le problème se synchronise avec votre compte, pas avec les fichiers du programme.",
        "<strong class='text-white'>Solution réelle :</strong> réinitialisez votre espace de travail par défaut depuis la version web, puis rouvrez l'application de bureau.",
        "<strong class='text-white'>Sauvegardez d'abord :</strong> si vous pouvez accéder au menu, enregistrez votre disposition actuelle sous un nouveau nom avant de réinitialiser.",
        "<strong class='text-white'>Toujours bloquée ?</strong> Mettez à jour votre pilote graphique, installez la dernière build de bureau, et synchronisez l'horloge de votre système.",
        "<strong class='text-white'>Boucles de déconnexions ?</strong> Déconnectez-vous de tous les appareils, Tradovate n'autorise que deux sessions actives.",
      ],
    },
    { type: "heading", text: "Ce que signifie réellement &ldquo;Freezes at 100% Load&rdquo;" },
    { type: "paragraph", html: "La barre de chargement ne mesure pas votre téléchargement. Au moment où elle atteint 100 %, l'application de bureau a déjà chargé l'interface et effectue la dernière chose qu'elle fait avant de vous rendre le contrôle : reconstruire votre espace de travail enregistré, les graphiques, les échelles DOM, les listes de surveillance, exactement la disposition des panneaux que vous aviez laissée la dernière fois. C'est dans cette dernière étape que se logent ces blocages. Si la disposition enregistrée qu'elle essaie de dessiner est corrompue ou fait référence à quelque chose que l'application ne peut pas afficher, la boucle de rendu se bloque juste avant la ligne d'arrivée. La fenêtre semble complète mais elle est verrouillée, car l'application n'a jamais réellement fini de la dessiner." },
    { type: "paragraph", html: "Ce seul détail explique la partie la plus frustrante de ce bug, pourquoi la réinstallation ne change rien. Votre espace de travail ne réside pas dans le programme installé sur votre disque dur. Il est enregistré avec votre compte Tradovate et synchronisé entre le web, le bureau et le mobile, de sorte que votre disposition vous suit d'un appareil à l'autre. Lorsque vous désinstallez l'application, vous supprimez le programme, pas la disposition. Réinstallez, reconnectez-vous, et l'application télécharge docilement le même espace de travail corrompu depuis votre compte et se bloque de nouveau dessus. Vous pouvez réinstaller dix fois et vous heurter au même mur à chaque fois, car vous continuez de donner à la nouvelle installation la même disposition cassée sur laquelle s'étouffer." },
    { type: "paragraph", html: "Une fois que vous le voyez ainsi, la solution ne concerne plus l'application mais l'espace de travail. Et l'endroit le plus simple pour réparer un espace de travail quand votre application de bureau est figée est la version qui ne dépend pas du tout de cette application figée." },
    { type: "heading", text: "Comment le résoudre : réinitialisez l'espace de travail, pas l'installation" },
    { type: "heading", text: "Étape 1 : reprenez le trading via la version web" },
    { type: "paragraph", html: "Avant de toucher aux paramètres, remettez les yeux sur votre compte. Ouvrez la plateforme web Tradovate dans n'importe quel navigateur et connectez-vous avec les mêmes identifiants que ceux utilisés sur l'application de bureau. Elle accède exactement au même compte, aux mêmes positions et aux mêmes ordres en cours, donc si vous avez quelque chose d'ouvert, vous pouvez le gérer immédiatement au lieu d'attendre une fenêtre figée. La version web ne nécessite aucune installation et fonctionne sous Windows, Mac ou sur un téléphone, ce qui en fait la solution de repli fiable chaque fois que la build de bureau se comporte mal. Confirmez l'adresse web actuelle sur la page officielle des plateformes de Tradovate plutôt que sur un ancien favori." },
    { type: "heading", text: "Étape 2 : réinitialisez l'espace de travail par défaut depuis le web" },
    { type: "paragraph", html: "Voici la véritable réparation. Comme votre disposition est ce qui bloque l'application de bureau, et comme cette disposition se synchronise depuis votre compte, vous pouvez l'effacer depuis la version web et l'application de bureau récupérera ensuite la version propre." },
    {
      type: "list",
      items: [
        "Une fois connecté à la plateforme web, repérez en haut à gauche l'icône espace de travail / ajouter un espace de travail qui gère vos dispositions enregistrées.",
        "Ouvrez ce menu et choisissez l'option qui <strong class='text-white'>réinitialise ou restaure l'espace de travail par défaut</strong>. La sélectionner ramène la disposition aux paramètres d'origine de Tradovate et supprime les modifications enregistrées qui la cassaient.",
        "Si vous pouvez encore ouvrir le menu et souhaitez conserver votre configuration, enregistrez d'abord votre espace de travail actuel sous un nouveau nom, afin d'avoir une sauvegarde à partir de laquelle reconstruire au lieu de perdre complètement vos graphiques et indicateurs.",
      ],
    },
    { type: "paragraph", html: "Le libellé du menu varie selon les versions de la plateforme, confirmez donc l'intitulé exact dans votre build avant de cliquer. C'est le comportement qui compte : vous vous débarrassez de la disposition corrompue sur laquelle l'application de bureau s'étouffait continuellement." },
    { type: "heading", text: "Étape 3 : rouvrez l'application de bureau" },
    { type: "paragraph", html: "Relancez maintenant l'application de bureau. Cette fois, l'espace de travail qu'elle télécharge est le paramètre par défaut propre, donc le rendu se termine et vous récupérez le contrôle. Si elle charge encore l'ancienne disposition cassée, déconnectez-vous complètement de l'application de bureau et reconnectez-vous pour qu'elle se resynchronise entièrement depuis votre compte, et si c'est une ancienne build, récupérez au passage l'installateur de bureau actuel depuis la page officielle de téléchargements de Tradovate. Exécuter la dernière version écarte un bug déjà corrigé par une mise à jour précédente." },
    { type: "heading", text: "Si la réinitialisation de l'espace de travail ne suffit pas" },
    { type: "paragraph", html: "Une disposition corrompue est généralement la coupable, mais ce n'est pas la seule chose qui peut bloquer une application de bureau sur la dernière ligne droite du chargement. Passez en revue les points suivants." },
    { type: "heading", text: "Mettez à jour votre pilote graphique" },
    { type: "paragraph", html: "L'application de bureau dessine les graphiques via le matériel graphique de votre machine. Un pilote GPU obsolète ou instable peut bloquer ce rendu final, l'application charge tout, essaie de dessiner les graphiques, et se fige. Mettez à jour votre pilote graphique auprès de votre fabricant de matériel (ou via Windows Update), redémarrez et réessayez. C'est une pratique courante pour toute application de trading de bureau gourmande en graphiques, pas seulement Tradovate." },
    { type: "heading", text: "Synchronisez l'horloge de votre système et vérifiez votre connexion" },
    { type: "paragraph", html: "Les vérifications de session de Tradovate attendent que l'horloge de votre ordinateur soit étroitement alignée avec ses serveurs. Un décalage même de quelques secondes peut faire rejeter la session en pleine poignée de main, ce qui se traduit par un blocage plutôt qu'une erreur claire. Sous Windows, faites un clic droit sur l'horloge de la barre des tâches, ouvrez les paramètres de date et d'heure, et cliquez sur <strong class='text-white'>Sync now</strong>. Pendant que vous y êtes, passez à une connexion Ethernet filaire si possible, une liaison Wi-Fi instable pendant le chargement peut laisser l'application attendre des données qu'elle ne reçoit jamais complètement." },
    { type: "heading", text: "Supprimez les sessions supplémentaires" },
    { type: "paragraph", html: "Tradovate vous limite à deux sessions actives entre bureau, web, mobile et TradingView. Si vous avez l'application ouverte sur deux machines plus un téléphone plus une connexion TradingView, les sessions se disputent, et un symptôme est un chargement qui ne se termine jamais. Déconnectez-vous partout, puis ouvrez une seule session et laissez-la se charger sans être perturbée." },
    { type: "heading", text: "Vérifiez l'antivirus, le pare-feu et les autorisations" },
    { type: "paragraph", html: "Les logiciels de sécurité tiennent parfois une application de trading de bureau à distance, mettant en quarantaine un fichier ou bloquant la connexion dont elle a besoin pour terminer son chargement. Si le blocage a commencé juste après une mise à jour de sécurité, ajoutez l'application Tradovate à vos exceptions d'antivirus et de pare-feu, et essayez de la lancer une fois en tant qu'administrateur pour écarter un problème de permissions." },
    { type: "heading", text: "Tableau de dépannage" },
    {
      type: "table",
      headers: ["Symptôme", "Ce que cela signifie", "Solution"],
      rows: [
        ["Charge jusqu'à 100 %, puis la fenêtre est figée", "L'espace de travail enregistré corrompu bloque le rendu final", "Réinitialisez l'espace de travail par défaut depuis la version web"],
        ["La réinstallation ne change rien", "L'espace de travail se synchronise depuis votre compte, pas depuis l'installation", "Réparez l'espace de travail, pas les fichiers du programme"],
        ["Bureau mort mais vous devez trader maintenant", "Blocage de l'application locale ; le compte est toujours actif", "Connectez-vous sur la version web, même compte"],
        ["Les graphiques ne s'affichent jamais après le chargement", "Le pilote graphique bloque le rendu", "Mettez à jour le pilote GPU et redémarrez"],
        ["Se bloque ou se déconnecte pendant le chargement", "Décalage d'horloge ou connexion instable", "Synchronisez l'horloge système ; utilisez l'Ethernet filaire"],
        ["Déconnexions répétées pendant le chargement", "Trop de sessions actives", "Déconnectez-vous de tous les appareils ; ouvrez une seule session"],
      ],
    },
    { type: "heading", text: "Une remarque pour les traders prop firm" },
    { type: "paragraph", html: "Si vous gérez un compte d'évaluation ou financé par le biais d'une prop firm, une application de bureau qui ne charge pas est plus qu'un désagrément, c'est du temps pendant lequel vous ne pouvez pas surveiller votre risque. Les marges, limites de perte et règles de drawdown varient selon la firme et la taille du compte, vérifiez donc les règles actuelles de votre firme, mais l'habitude de survie est la même partout : ne laissez jamais une seule application figée être la seule chose qui vous sépare de vos positions. Gardez la version web en favori comme solution de repli instantanée, sachez comment votre firme s'attend à ce que vous la contactiez en cas d'urgence, et assurez-vous que tout stop de protection repose sur les serveurs de Tradovate plutôt que de vivre uniquement dans la fenêtre locale que vous venez de perdre." },
    { type: "heading", text: "Arrêtez de laisser une application figée décider de votre trade" },
    { type: "paragraph", html: "Vous ne pouvez pas empêcher l'application de bureau de se bloquer occasionnellement au chargement, mais vous pouvez empêcher ce blocage d'affecter vos ordres. PickMyTrade achemine vos alertes TradingView vers Tradovate via ses propres serveurs, de sorte que votre exécution ne dépend pas du fait qu'une fenêtre de graphique sur votre machine ait fini de se dessiner :" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Exécution côté serveur</strong>, les entrées et sorties passent de serveur à serveur, donc une application de bureau figée à 100 % sur votre PC n'arrête pas un ordre déjà envoyé.",
        "<strong class='text-white'>Stops et objectifs attachés dès l'entrée</strong>, chaque entrée automatisée peut porter son stop-loss et son take-profit, de sorte que votre protection se trouve sur les serveurs de Tradovate au moment où vous êtes exécuté, et non après avoir débloqué l'application.",
        "<strong class='text-white'>Une solution de repli que vous n'avez pas à reconstruire</strong>, comme votre stratégie vit dans l'alerte, vous pouvez basculer vers la plateforme web ou un autre appareil sans rien recréer.",
        "<strong class='text-white'>Synchronisation multi-comptes</strong>, répliquez le même ordre sur plusieurs comptes afin qu'une connexion bloquée ne soit pas votre seul accès au marché.",
      ],
    },
  ], it: [
    { type: "paragraph", html: "Fate doppio clic sull'icona desktop di Tradovate, la barra di caricamento avanza, arriva al 100% e poi non succede nulla. La finestra resta lì, completamente disegnata ma inerte. I clic non fanno nulla, il DOM non si apre, e non riuscite nemmeno a chiuderla correttamente. Quindi fate la cosa ovvia: disinstallare, reinstallare, riavviare. Stesso blocco, stesso 100%, stessa schermata bloccata. Se siete intrappolati in questo ciclo, la reinstallazione non è la soluzione, e c'è un buon motivo per cui non lo è mai stata. Ecco cosa sta realmente bloccando l'app a caricamento completo, come tornare a fare trading in circa un minuto, e l'unico reset che di solito la risolve in modo definitivo." },
    {
      type: "checklist",
      heading: "Checklist rapida per un'app desktop bloccata al 100%",
      items: [
        "<strong class='text-white'>Bloccata al caricamento completo proprio ora?</strong> Aprite la versione web in un browser e accedete, stesso account, stessi ordini, nessuna installazione necessaria.",
        "<strong class='text-white'>Avete già reinstallato e resta bloccata?</strong> Smettete di reinstallare. Il problema si sincronizza con il vostro account, non con i file del programma.",
        "<strong class='text-white'>Soluzione reale:</strong> resettate il vostro spazio di lavoro predefinito dalla versione web, quindi riaprite l'app desktop.",
        "<strong class='text-white'>Prima il backup:</strong> se riuscite ad accedere al menu, salvate il layout attuale con un nuovo nome prima di resettare.",
        "<strong class='text-white'>Continua a bloccarsi?</strong> Aggiornate il driver grafico, installate l'ultima build desktop e sincronizzate l'orologio di sistema.",
        "<strong class='text-white'>Cicli di disconnessioni?</strong> Disconnettetevi da tutti i dispositivi, Tradovate consente solo due sessioni attive.",
      ],
    },
    { type: "heading", text: "Cosa significa davvero &ldquo;Freezes at 100% Load&rdquo;" },
    { type: "paragraph", html: "La barra di caricamento non misura il vostro download. Quando raggiunge il 100%, l'app desktop ha già caricato l'interfaccia e sta facendo l'ultima cosa che fa prima di restituirvi il controllo: ricostruire il vostro spazio di lavoro salvato, i grafici, le scale DOM, le watchlist, esattamente il layout dei pannelli che avevate lasciato l'ultima volta. È in quest'ultimo passaggio che si nascondono questi blocchi. Se il layout salvato che sta cercando di disegnare è corrotto o fa riferimento a qualcosa che l'app non può renderizzare, il ciclo di rendering si blocca proprio sul traguardo. La finestra sembra completa ma è bloccata, perché l'app non ha mai realmente finito di disegnarla." },
    { type: "paragraph", html: "Questo unico dettaglio spiega la parte più frustrante di questo bug, il motivo per cui reinstallare non serve a nulla. Il vostro spazio di lavoro non risiede all'interno del programma installato sul vostro disco rigido. Viene salvato con il vostro account Tradovate e sincronizzato tra web, desktop e mobile, così il vostro layout vi segue tra i dispositivi. Quando disinstallate l'app, eliminate il programma, non il layout. Reinstallate, accedete di nuovo, e l'app scarica diligentemente lo stesso spazio di lavoro corrotto dal vostro account e si blocca di nuovo su di esso. Potete reinstallare dieci volte e sbattere contro lo stesso muro ogni volta, perché continuate a fornire alla nuova installazione lo stesso layout danneggiato su cui soffocare." },
    { type: "paragraph", html: "Una volta che lo vedete in questo modo, la soluzione smette di riguardare l'app e inizia a riguardare lo spazio di lavoro. E il posto più semplice per correggere uno spazio di lavoro quando la vostra app desktop è bloccata è la versione che non dipende affatto da quell'app bloccata." },
    { type: "heading", text: "Come risolverlo: resettate lo spazio di lavoro, non l'installazione" },
    { type: "heading", text: "Passaggio 1: tornare a fare trading tramite la versione web" },
    { type: "paragraph", html: "Prima di toccare le impostazioni, rimettete gli occhi sul vostro account. Aprite la piattaforma web di Tradovate in qualsiasi browser e accedete con le stesse credenziali che usate sull'app desktop. Raggiunge esattamente lo stesso account, le stesse posizioni e gli stessi ordini attivi, quindi se avete qualcosa di aperto, potete gestirlo subito invece di aspettare una finestra bloccata. La versione web non richiede installazione e funziona su Windows, Mac o telefono, il che la rende l'alternativa affidabile ogni volta che la build desktop dà problemi. Confermate l'indirizzo web attuale dalla pagina ufficiale delle piattaforme di Tradovate anziché da un vecchio segnalibro." },
    { type: "heading", text: "Passaggio 2: resettare lo spazio di lavoro predefinito dal web" },
    { type: "paragraph", html: "Ecco la vera riparazione. Poiché è il vostro layout a bloccare l'app desktop, e poiché quel layout si sincronizza dal vostro account, potete cancellarlo dalla versione web e l'app desktop recupererà in seguito la versione pulita." },
    {
      type: "list",
      items: [
        "Una volta effettuato l'accesso alla piattaforma web, cercate in alto a sinistra l'icona spazio di lavoro / aggiungi spazio di lavoro che gestisce i vostri layout salvati.",
        "Aprite quel menu e scegliete l'opzione che <strong class='text-white'>resetta o ripristina lo spazio di lavoro predefinito</strong>. Selezionandola, il layout torna alle impostazioni originali di Tradovate e vengono scartate le modifiche salvate che lo stavano danneggiando.",
        "Se riuscite ancora ad aprire il menu e volete mantenere la vostra configurazione, salvate prima il vostro spazio di lavoro attuale con un nuovo nome, così avrete un backup da cui ricostruire invece di perdere del tutto i vostri grafici e indicatori.",
      ],
    },
    { type: "paragraph", html: "Il testo del menu varia tra le versioni della piattaforma, quindi confermate l'etichetta esatta nella vostra build prima di fare clic. È il comportamento che conta: state buttando via il layout corrotto su cui l'app desktop continuava a soffocare." },
    { type: "heading", text: "Passaggio 3: riaprire l'app desktop" },
    { type: "paragraph", html: "Ora avviate di nuovo l'app desktop. Questa volta lo spazio di lavoro che scarica è quello predefinito pulito, quindi il rendering si completa e riottenete il controllo. Se carica ancora il vecchio layout danneggiato, disconnettetevi completamente dall'app desktop e riaccedete in modo che si risincronizzi da zero con il vostro account, e se è una vecchia build, scaricate anche il programma di installazione desktop attuale dalla pagina ufficiale dei download di Tradovate. Eseguire la versione più recente esclude un bug già risolto da un aggiornamento precedente." },
    { type: "heading", text: "Se il reset dello spazio di lavoro non risolve" },
    { type: "paragraph", html: "Un layout corrotto è di solito il colpevole, ma non è l'unica cosa che può bloccare un'app desktop nell'ultimo tratto del caricamento. Esaminate quanto segue." },
    { type: "heading", text: "Aggiornare il driver grafico" },
    { type: "paragraph", html: "L'app desktop disegna i grafici tramite l'hardware grafico del vostro computer. Un driver GPU obsoleto o instabile può bloccare quel rendering finale: l'app carica tutto, cerca di disegnare i grafici, e si blocca. Aggiornate il driver grafico dal produttore dell'hardware (o tramite Windows Update), riavviate e riprovate. Questa è una prassi standard per qualsiasi app di trading desktop ricca di grafici, non solo Tradovate." },
    { type: "heading", text: "Sincronizzare l'orologio di sistema e controllare la connessione" },
    { type: "paragraph", html: "I controlli di sessione di Tradovate si aspettano che l'orologio del vostro computer sia allineato strettamente con i suoi server. Uno scarto anche di pochi secondi può far rifiutare la sessione a metà dell'handshake, il che si manifesta come un blocco piuttosto che un errore chiaro. Su Windows, fate clic destro sull'orologio nella barra delle applicazioni, aprite le impostazioni di data e ora, e fate clic su <strong class='text-white'>Sync now</strong>. Già che ci siete, passate a una connessione Ethernet cablata se potete; un collegamento Wi-Fi instabile durante il caricamento può lasciare l'app in attesa di dati che non riceve mai completamente." },
    { type: "heading", text: "Eliminare le sessioni extra" },
    { type: "paragraph", html: "Tradovate vi limita a due sessioni attive tra desktop, web, mobile e TradingView. Se avete l'app aperta su due computer più un telefono più una connessione TradingView, le sessioni entrano in conflitto, e un sintomo è un caricamento che non si completa mai. Disconnettetevi ovunque, quindi aprite un'unica sessione e lasciate che si carichi indisturbata." },
    { type: "heading", text: "Controllare antivirus, firewall e permessi" },
    { type: "paragraph", html: "Il software di sicurezza a volte tiene a distanza un'app di trading desktop, mettendo in quarantena un file o bloccando la connessione di cui ha bisogno per completare il caricamento. Se il blocco è iniziato subito dopo un aggiornamento di sicurezza, aggiungete l'app Tradovate alle eccezioni del vostro antivirus e firewall, e provate ad avviarla una volta come amministratore per escludere un problema di permessi." },
    { type: "heading", text: "Tabella di risoluzione dei problemi" },
    {
      type: "table",
      headers: ["Sintomo", "Cosa significa", "Soluzione"],
      rows: [
        ["Carica fino al 100%, poi la finestra è bloccata", "Lo spazio di lavoro salvato corrotto blocca il rendering finale", "Resettate lo spazio di lavoro predefinito dalla versione web"],
        ["Reinstallare non cambia nulla", "Lo spazio di lavoro si sincronizza dal vostro account, non dall'installazione", "Correggete lo spazio di lavoro, non i file del programma"],
        ["Desktop morto ma dovete fare trading adesso", "Blocco dell'app locale; l'account è ancora attivo", "Accedete sulla versione web, stesso account"],
        ["I grafici non vengono mai disegnati dopo il caricamento", "Il driver grafico blocca il rendering", "Aggiornate il driver GPU e riavviate"],
        ["Si blocca o si interrompe durante il caricamento", "Scarto dell'orologio o connessione instabile", "Sincronizzate l'orologio di sistema; usate Ethernet cablata"],
        ["Disconnessioni ripetute durante il caricamento", "Troppe sessioni attive", "Disconnettetevi da tutti i dispositivi; aprite una sola sessione"],
      ],
    },
    { type: "heading", text: "Una nota per i trader delle prop firm" },
    { type: "paragraph", html: "Se gestite un account di valutazione o finanziato tramite una prop firm, un'app desktop che non si carica è più di un fastidio: è tempo in cui non potete monitorare il vostro rischio. I margini, i limiti di perdita e le regole di drawdown variano in base alla società e alla dimensione dell'account, quindi controllate le regole attuali della vostra società, ma l'abitudine di sopravvivenza è la stessa ovunque: non lasciate mai che una singola app bloccata sia l'unica cosa che vi separa dalle vostre posizioni. Tenete la versione web salvata nei preferiti come alternativa istantanea, sappiate come la vostra società si aspetta che la contattiate in caso di emergenza, e assicuratevi che qualsiasi stop di protezione risieda sui server di Tradovate anziché vivere solo nella finestra locale che avete appena perso." },
    { type: "heading", text: "Smettete di lasciare che un'app bloccata decida la vostra operazione" },
    { type: "paragraph", html: "Non potete impedire che l'app desktop si blocchi occasionalmente al caricamento, ma potete impedire che quel blocco tocchi i vostri ordini. PickMyTrade instrada i vostri alert di TradingView a Tradovate tramite i propri server, così la vostra esecuzione non dipende dal fatto che una finestra grafica sul vostro computer abbia finito di disegnarsi:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Esecuzione lato server</strong>, gli ingressi e le uscite passano da server a server, così un'app desktop bloccata al 100% sul vostro PC non ferma un ordine già inviato.",
        "<strong class='text-white'>Stop e target collegati all'ingresso</strong>, ogni ingresso automatizzato può portare con sé lo stop-loss e il take-profit, così la vostra protezione risiede sui server di Tradovate nel momento in cui venite eseguiti, non dopo aver sbloccato l'app.",
        "<strong class='text-white'>Un'alternativa che non dovete ricostruire</strong>, poiché la vostra strategia risiede nell'alert, potete passare alla piattaforma web o a un altro dispositivo senza dover ricreare nulla.",
        "<strong class='text-white'>Sincronizzazione multi-account</strong>, replicate lo stesso ordine su più account così che una connessione bloccata non sia il vostro unico accesso al mercato.",
      ],
    },
  ] },
  ctaHeading: { en: "Route Alerts Server-Side", de: "Alerts serverseitig routen", es: "Enrute las alertas del lado del servidor", fr: "Acheminez les alertes côté serveur", it: "Instrada gli alert lato server" },
  ctaText: { en: "Route alerts server-side so a frozen desktop app never costs you a fill.", de: "Routen Sie Alerts serverseitig, damit eine eingefrorene Desktop-App Sie nie eine Ausführung kostet.", es: "Enrute las alertas del lado del servidor para que una aplicación de escritorio congelada nunca le cueste una ejecución.", fr: "Acheminez les alertes côté serveur pour qu'une application de bureau figée ne vous coûte jamais une exécution.", it: "Instrada gli alert lato server così un'app desktop bloccata non ti costa mai un'esecuzione." },
  ctaButtonText: { en: "Start Your Free 7-Day Trial", de: "Starten Sie Ihre kostenlose 5-Tage-Testversion", es: "Inicie su prueba gratuita de 5 días", fr: "Démarrez votre essai gratuit de 5 jours", it: "Avvia la tua prova gratuita di 5 giorni" },
  ctaUrl: "https://app.pickmytrade.trade/?register=true&utm_source=content&utm_medium=debugging",
  faqHeading: { en: "Frequently Asked Questions", de: "Häufig gestellte Fragen", es: "Preguntas frecuentes", fr: "Questions fréquentes", it: "Domande frequenti" },
  faqs: { en: [
    { q: "Why does the Tradovate desktop app freeze right at 100% load?", a: "The app finishes loading the interface and then tries to draw your saved workspace. If that saved layout is corrupted, the render locks up at the very end and the window stops responding to clicks. It looks like a crash, but it's usually a bad workspace, not a broken install." },
    { q: "I uninstalled and reinstalled and it's still frozen at load. Why?", a: "Your workspace is tied to your account, not just the local program files, and it syncs across web, desktop, and mobile. Reinstalling wipes the app but then pulls the same synced layout back down, so the app freezes on the same bad workspace all over again. You have to reset the workspace itself, not the installation." },
    { q: "What's the fastest way to get trading again while the desktop app is stuck?", a: "Open the web version in a browser and sign in with the same credentials. It reaches the same account and orders, so you can manage positions immediately while you fix the desktop app. Confirm the current web URL from Tradovate's official platforms page before you rely on it." },
    { q: "How do I reset my workspace if the desktop app won't respond?", a: "Do it from the web version. Sign in through a browser, open the workspace menu near the top-left add-workspace icon, and choose the option that resets or restores the default workspace. Then reopen the desktop app so it loads the cleaned-up default layout. Confirm the exact labels in your build, since Tradovate updates the menus." },
    { q: "Will resetting the workspace delete my charts and indicators?", a: "Resetting the default workspace reverts the layout to Tradovate's original settings and discards saved changes to that workspace. Before you reset, save your current layout under a new name as a backup if you can still reach the menu, so you can rebuild from it later." },
    { q: "Could too many active logins cause the freeze at load?", a: "It can contribute. Tradovate allows only two active sessions across desktop, web, mobile, and TradingView. Extra sessions cause disconnect loops and stalled loads. Sign out everywhere, then open a single session and let it finish loading." },
    { q: "Does updating Windows or my graphics driver help?", a: "It can. The desktop app renders charts through your graphics hardware, so an outdated or buggy GPU driver can stall the final draw. Updating your graphics driver and installing the latest desktop build is worth trying after you've ruled out a corrupted workspace." },
  ], de: [
    { q: "Warum friert die Tradovate-Desktop-App genau bei 100 % Ladefortschritt ein?", a: "Die App beendet das Laden der Oberfläche und versucht dann, Ihren gespeicherten Workspace zu zeichnen. Ist dieses gespeicherte Layout beschädigt, blockiert das Rendering ganz am Ende, und das Fenster reagiert nicht mehr auf Klicks. Es sieht wie ein Absturz aus, ist aber meist ein defekter Workspace, keine kaputte Installation." },
    { q: "Ich habe deinstalliert und neu installiert, und die App friert beim Laden trotzdem noch ein. Warum?", a: "Ihr Workspace ist an Ihr Konto gebunden, nicht nur an die lokalen Programmdateien, und synchronisiert sich über Web, Desktop und Mobil. Eine Neuinstallation löscht die App, holt sich aber anschließend dasselbe synchronisierte Layout zurück, sodass die App wieder am selben defekten Workspace einfriert. Sie müssen den Workspace selbst zurücksetzen, nicht die Installation." },
    { q: "Was ist der schnellste Weg, wieder zu handeln, während die Desktop-App hängt?", a: "Öffnen Sie die Web-Version in einem Browser und melden Sie sich mit denselben Zugangsdaten an. Sie erreicht dasselbe Konto und dieselben Orders, sodass Sie Positionen sofort verwalten können, während Sie die Desktop-App reparieren. Bestätigen Sie die aktuelle Web-URL auf Tradovates offizieller Plattform-Seite, bevor Sie sich darauf verlassen." },
    { q: "Wie setze ich meinen Workspace zurück, wenn die Desktop-App nicht reagiert?", a: "Tun Sie das über die Web-Version. Melden Sie sich über einen Browser an, öffnen Sie das Workspace-Menü in der Nähe des Add-Workspace-Symbols oben links und wählen Sie die Option, die den Standard-Workspace zurücksetzt oder wiederherstellt. Öffnen Sie dann die Desktop-App erneut, damit sie das bereinigte Standardlayout lädt. Bestätigen Sie die genauen Bezeichnungen in Ihrem Build, da Tradovate die Menüs aktualisiert." },
    { q: "Löscht das Zurücksetzen des Workspace meine Charts und Indikatoren?", a: "Das Zurücksetzen des Standard-Workspace setzt das Layout auf Tradovates Originaleinstellungen zurück und verwirft gespeicherte Änderungen an diesem Workspace. Speichern Sie vor dem Zurücksetzen Ihr aktuelles Layout als Backup unter einem neuen Namen, wenn Sie das Menü noch erreichen können, damit Sie später darauf aufbauen können." },
    { q: "Können zu viele aktive Anmeldungen das Einfrieren beim Laden verursachen?", a: "Das kann dazu beitragen. Tradovate erlaubt nur zwei aktive Sitzungen über Desktop, Web, Mobil und TradingView. Zusätzliche Sitzungen verursachen Verbindungsabbruchschleifen und blockierte Ladevorgänge. Melden Sie sich überall ab und öffnen Sie dann eine einzige Sitzung, damit sie den Ladevorgang abschließen kann." },
    { q: "Hilft es, Windows oder meinen Grafiktreiber zu aktualisieren?", a: "Das kann helfen. Die Desktop-App rendert Charts über Ihre Grafikhardware, sodass ein veralteter oder fehlerhafter GPU-Treiber den finalen Zeichenvorgang blockieren kann. Es lohnt sich, den Grafiktreiber zu aktualisieren und den neuesten Desktop-Build zu installieren, nachdem Sie einen beschädigten Workspace ausgeschlossen haben." },
  ], es: [
    { q: "¿Por qué la aplicación de escritorio de Tradovate se congela justo al 100 % de carga?", a: "La aplicación termina de cargar la interfaz y luego intenta dibujar su espacio de trabajo guardado. Si ese diseño guardado está corrupto, el renderizado se bloquea justo al final y la ventana deja de responder a los clics. Parece un bloqueo total, pero suele ser un espacio de trabajo defectuoso, no una instalación rota." },
    { q: "Desinstalé y reinstalé y sigue congelándose al cargar. ¿Por qué?", a: "Su espacio de trabajo está vinculado a su cuenta, no solo a los archivos del programa local, y se sincroniza entre web, escritorio y móvil. Reinstalar borra la aplicación, pero luego vuelve a descargar el mismo diseño sincronizado, así que la aplicación vuelve a congelarse con el mismo espacio de trabajo defectuoso. Tiene que restablecer el propio espacio de trabajo, no la instalación." },
    { q: "¿Cuál es la forma más rápida de volver a operar mientras la aplicación de escritorio está atascada?", a: "Abra la versión web en un navegador e inicie sesión con las mismas credenciales. Accede a la misma cuenta y órdenes, así que puede gestionar posiciones de inmediato mientras arregla la aplicación de escritorio. Confirme la URL web actual en la página oficial de plataformas de Tradovate antes de confiar en ella." },
    { q: "¿Cómo restablezco mi espacio de trabajo si la aplicación de escritorio no responde?", a: "Hágalo desde la versión web. Inicie sesión a través de un navegador, abra el menú de espacio de trabajo cerca del icono de añadir espacio de trabajo en la parte superior izquierda, y elija la opción que restablece o restaura el espacio de trabajo predeterminado. Luego vuelva a abrir la aplicación de escritorio para que cargue el diseño predeterminado limpio. Confirme las etiquetas exactas en su build, ya que Tradovate actualiza los menús." },
    { q: "¿El restablecimiento del espacio de trabajo eliminará mis gráficos e indicadores?", a: "Restablecer el espacio de trabajo predeterminado devuelve el diseño a la configuración original de Tradovate y descarta los cambios guardados en ese espacio de trabajo. Antes de restablecer, guarde su diseño actual con un nuevo nombre como copia de seguridad si todavía puede acceder al menú, para poder reconstruirlo más tarde a partir de él." },
    { q: "¿Pueden demasiados inicios de sesión activos provocar el bloqueo al cargar?", a: "Puede contribuir. Tradovate solo permite dos sesiones activas entre escritorio, web, móvil y TradingView. Las sesiones adicionales provocan bucles de desconexión y cargas atascadas. Cierre sesión en todas partes y luego abra una única sesión y deje que termine de cargar." },
    { q: "¿Ayuda actualizar Windows o mi controlador gráfico?", a: "Puede ayudar. La aplicación de escritorio renderiza los gráficos a través de su hardware gráfico, así que un controlador de GPU desactualizado o defectuoso puede paralizar el dibujado final. Vale la pena intentar actualizar el controlador gráfico e instalar el último build de escritorio después de haber descartado un espacio de trabajo corrupto." },
  ], fr: [
    { q: "Pourquoi l'application de bureau Tradovate se fige-t-elle juste à 100 % de chargement ?", a: "L'application termine de charger l'interface puis tente de dessiner votre espace de travail enregistré. Si cette disposition enregistrée est corrompue, le rendu se bloque tout à la fin et la fenêtre cesse de répondre aux clics. Cela ressemble à un plantage, mais il s'agit généralement d'un espace de travail défectueux, pas d'une installation cassée." },
    { q: "J'ai désinstallé et réinstallé et elle est toujours figée au chargement. Pourquoi ?", a: "Votre espace de travail est lié à votre compte, pas seulement aux fichiers du programme local, et il se synchronise entre le web, le bureau et le mobile. La réinstallation efface l'application mais retélécharge ensuite la même disposition synchronisée, donc l'application se fige à nouveau sur le même espace de travail défectueux. Vous devez réinitialiser l'espace de travail lui-même, pas l'installation." },
    { q: "Quel est le moyen le plus rapide de reprendre le trading pendant que l'application de bureau est bloquée ?", a: "Ouvrez la version web dans un navigateur et connectez-vous avec les mêmes identifiants. Elle accède au même compte et aux mêmes ordres, vous pouvez donc gérer vos positions immédiatement pendant que vous réparez l'application de bureau. Confirmez l'URL web actuelle sur la page officielle des plateformes de Tradovate avant de vous y fier." },
    { q: "Comment réinitialiser mon espace de travail si l'application de bureau ne répond pas ?", a: "Faites-le depuis la version web. Connectez-vous via un navigateur, ouvrez le menu d'espace de travail près de l'icône ajouter un espace de travail en haut à gauche, et choisissez l'option qui réinitialise ou restaure l'espace de travail par défaut. Rouvrez ensuite l'application de bureau pour qu'elle charge la disposition par défaut nettoyée. Confirmez les libellés exacts dans votre build, car Tradovate met à jour les menus." },
    { q: "La réinitialisation de l'espace de travail supprimera-t-elle mes graphiques et indicateurs ?", a: "La réinitialisation de l'espace de travail par défaut ramène la disposition aux paramètres d'origine de Tradovate et supprime les modifications enregistrées sur cet espace de travail. Avant de réinitialiser, enregistrez votre disposition actuelle sous un nouveau nom comme sauvegarde si vous pouvez encore accéder au menu, afin de pouvoir la reconstruire plus tard." },
    { q: "Trop de connexions actives peuvent-elles provoquer le blocage au chargement ?", a: "Cela peut y contribuer. Tradovate n'autorise que deux sessions actives entre bureau, web, mobile et TradingView. Les sessions supplémentaires provoquent des boucles de déconnexion et des chargements bloqués. Déconnectez-vous partout, puis ouvrez une seule session et laissez-la terminer de charger." },
    { q: "La mise à jour de Windows ou de mon pilote graphique aide-t-elle ?", a: "Cela peut aider. L'application de bureau restitue les graphiques via votre matériel graphique, donc un pilote GPU obsolète ou défectueux peut bloquer le dessin final. Il vaut la peine d'essayer de mettre à jour votre pilote graphique et d'installer la dernière build de bureau après avoir écarté un espace de travail corrompu." },
  ], it: [
    { q: "Perché l'app desktop di Tradovate si blocca proprio al 100% del caricamento?", a: "L'app finisce di caricare l'interfaccia e poi cerca di disegnare il vostro spazio di lavoro salvato. Se quel layout salvato è corrotto, il rendering si blocca proprio alla fine e la finestra smette di rispondere ai clic. Sembra un crash, ma di solito è uno spazio di lavoro difettoso, non un'installazione danneggiata." },
    { q: "Ho disinstallato e reinstallato ma continua a bloccarsi al caricamento. Perché?", a: "Il vostro spazio di lavoro è legato al vostro account, non solo ai file del programma locale, e si sincronizza tra web, desktop e mobile. Reinstallare cancella l'app ma poi riscarica lo stesso layout sincronizzato, quindi l'app si blocca di nuovo sullo stesso spazio di lavoro difettoso. Dovete resettare lo spazio di lavoro stesso, non l'installazione." },
    { q: "Qual è il modo più veloce per tornare a fare trading mentre l'app desktop è bloccata?", a: "Aprite la versione web in un browser e accedete con le stesse credenziali. Raggiunge lo stesso account e gli stessi ordini, quindi potete gestire le posizioni immediatamente mentre risolvete l'app desktop. Confermate l'URL web attuale dalla pagina ufficiale delle piattaforme di Tradovate prima di affidarvi ad esso." },
    { q: "Come resetto il mio spazio di lavoro se l'app desktop non risponde?", a: "Fatelo dalla versione web. Accedete tramite un browser, aprite il menu dello spazio di lavoro vicino all'icona aggiungi spazio di lavoro in alto a sinistra, e scegliete l'opzione che resetta o ripristina lo spazio di lavoro predefinito. Poi riaprite l'app desktop in modo che carichi il layout predefinito ripulito. Confermate le etichette esatte nella vostra build, poiché Tradovate aggiorna i menu." },
    { q: "Il reset dello spazio di lavoro eliminerà i miei grafici e indicatori?", a: "Il reset dello spazio di lavoro predefinito riporta il layout alle impostazioni originali di Tradovate e scarta le modifiche salvate su quello spazio di lavoro. Prima di resettare, salvate il vostro layout attuale con un nuovo nome come backup se riuscite ancora ad accedere al menu, così potrete ricostruirlo in seguito." },
    { q: "Troppi accessi attivi potrebbero causare il blocco al caricamento?", a: "Può contribuire. Tradovate consente solo due sessioni attive tra desktop, web, mobile e TradingView. Le sessioni extra causano cicli di disconnessione e caricamenti bloccati. Disconnettetevi ovunque, quindi aprite un'unica sessione e lasciate che completi il caricamento." },
    { q: "Aggiornare Windows o il mio driver grafico aiuta?", a: "Può aiutare. L'app desktop renderizza i grafici tramite il vostro hardware grafico, quindi un driver GPU obsoleto o difettoso può bloccare il disegno finale. Vale la pena provare ad aggiornare il driver grafico e installare l'ultima build desktop dopo aver escluso uno spazio di lavoro corrotto." },
  ] },
