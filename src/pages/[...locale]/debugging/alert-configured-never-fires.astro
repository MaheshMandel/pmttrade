---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "alert-configured-never-fires";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/debugging/${SLUG}`;

const META_TITLE = "Tradovate Alert Never Fires (Last Size Condition)";
const META_DESCRIPTION =
  "Alert set on Tradovate but it never fires? See why non-price conditions like Last Size may not trigger and the exact steps to get alerts working.";

// Short SEO title (<=60 chars) for locales where the shared h1 is too long for a SERP title.
const TITLE_OVERRIDE: Partial<Record<Locale, string>> = { es: "Alerta de Tradovate que no se dispara (condición Last Size)", fr: "Tradovate : l'alerte ne se déclenche jamais (Last Size)" };

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Tradovate-Alert feuert nie (Last-Size-Bedingung)", es: "La alerta de Tradovate nunca se dispara (condición Last Size)", fr: "L'alerte Tradovate ne se déclenche jamais (condition Last Size)", it: "L'avviso Tradovate non scatta mai (condizione Last Size)" },
  dek: { en: "You build an alert, the level trades through, and nothing fires. Here's why non-price conditions like Last Size don't behave like price alerts, and the exact steps to prove the alert pipeline works.", de: "Sie erstellen einen Alert, das Level wird durchgehandelt, und nichts feuert. Hier erfahren Sie, warum Nicht-Preis-Bedingungen wie Last Size sich nicht wie Preis-Alerts verhalten, und die exakten Schritte, um zu beweisen, dass die Alert-Pipeline funktioniert.", es: "Configura una alerta, el nivel se opera, y nada se dispara. Le explicamos por qué las condiciones que no son de precio, como Last Size, no se comportan como las alertas de precio, y los pasos exactos para comprobar que la canalización de alertas funciona.", fr: "Vous créez une alerte, le niveau est traversé par le marché, et rien ne se déclenche. Voici pourquoi les conditions hors prix comme Last Size ne se comportent pas comme les alertes de prix, et les étapes exactes pour prouver que le pipeline d'alertes fonctionne.", it: "Configura un avviso, il livello viene attraversato dal mercato, e non scatta nulla. Ecco perché le condizioni non di prezzo come Last Size non si comportano come gli avvisi di prezzo, e i passaggi esatti per dimostrare che la pipeline degli avvisi funziona." },
  readTime: { en: "7 min read", de: "7 Minuten Lesezeit", es: "Lectura de 7 minutos", fr: "Lecture de 7 minutes", it: "Lettura di 7 minuti" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "You build an alert, double-check the numbers, and then wait. The level trades through, the volume spikes, and nothing happens. No sound, no red dot on the bell, no flag under it. The alert just sits there like it was never armed. Nine times out of ten this isn't a broken platform or a missed setting. It's the <em>type</em> of condition you attached. Tradovate's alert engine is built around price, and a size or volume condition like &ldquo;Last Size &gt;= 50&rdquo; doesn't behave like a price alert at all. Here's how to tell what you're actually dealing with, how to prove the alert mechanism works in about a minute, and what to do when a non-price condition genuinely won't fire." },
    {
      type: "checklist",
      heading: "Quick Checklist for an Alert That Never Fires",
      items: [
        "<strong class='text-white'>Check the condition type first.</strong> Price alerts (touch, crosses above, crosses below) fire reliably. Size and volume conditions like Last Size are a different mechanism and may not trigger as configured.",
        "<strong class='text-white'>Confirm the alert is still active.</strong> Open the Alerts Manager and make sure it isn't paused, disabled, or already triggered and cleared.",
        "<strong class='text-white'>Make sure a notification method is on.</strong> An alert can fire silently if sound and popup are both switched off, which looks identical to &ldquo;it never fired.&rdquo;",
        "<strong class='text-white'>Verify the symbol has live data.</strong> An alert can only evaluate ticks it actually receives. A delayed or dead feed means late fires or no fires.",
        "<strong class='text-white'>Run a proof test with a plain price alert.</strong> Set a simple crosses-above/below on the same instrument near the current price to confirm the pipeline works end to end.",
        "<strong class='text-white'>Escalate with specifics if a non-price condition still won't fire.</strong> Send support the exact instrument, the full condition, and a screenshot, and ask whether that type is supported.",
      ],
    },
    { type: "heading", text: "What “Last Size” Actually Means (and Why It Trips People Up)" },
    { type: "paragraph", html: "Last Size is the number of contracts in the most recent executed trade. Not the price. Not the bid or ask. The <em>quantity</em> of the last print that crossed the tape. So a condition like &ldquo;ES Last Size &gt;= 50&rdquo; is asking the platform to fire the instant a single trade of 50 or more contracts goes through. That's a legitimate thing to want to watch. Big prints often mark where size is stepping in, and catching them in real time is genuinely useful." },
    { type: "paragraph", html: "The problem is that this is a trade-size condition wearing the same clothes as a price condition. In the alert builder it looks like any other rule: pick a property, pick an operator, type a number. But price and size are evaluated very differently under the hood, and Tradovate's alert system is documented and designed around price. Simple alerts watch the price of an instrument, position, or account parameter reaching a value. Advanced alerts stack several of those price conditions together and fire when all or any of them are met. Size-per-print doesn't fit that model. So when you attach a Last Size rule and it never fires, you're not necessarily doing anything wrong. You may have built a condition the engine doesn't actually evaluate the way the form implies." },
    { type: "heading", text: "Top Reasons a Configured Alert Never Triggers" },
    { type: "heading", text: "1. The condition is non-price (Last Size, volume, quantity)" },
    { type: "paragraph", html: "This is the headline cause and the reason this page exists. Price alerts are the well-worn path: they touch or cross a level and they fire. Size and volume conditions live outside that documented behavior. If you built &ldquo;Last Size &gt;= 50,&rdquo; &ldquo;volume &gt; X,&rdquo; or anything watching trade quantity rather than price, assume it may not trigger until proven otherwise. The fastest tell is the proof test further down: if a plain price alert on the same symbol fires and your size alert doesn't, the condition type is the culprit, not the platform." },
    { type: "heading", text: "2. The alert is disabled, paused, or already spent" },
    { type: "paragraph", html: "Alerts don't live forever on their own. A one-shot alert fires once and then goes quiet, so if it triggered while you weren't looking it won't fire again. Others get toggled off by accident. The Alerts Manager is where you confirm an alert's real state instead of assuming it's armed." },
    { type: "heading", text: "3. Every notification method is switched off" },
    { type: "paragraph", html: "An alert can fire and you'd never know. If sound, popup, and any push option are all off, the trigger happens silently and looks exactly like a failure. Reopen the alert and make sure at least one delivery method is enabled so a fire is something you can actually see or hear." },
    { type: "heading", text: "4. The symbol has delayed or missing market data" },
    { type: "paragraph", html: "An alert is only as live as the feed behind it. If the instrument is on a ten-minute delayed feed, or the data agreement isn't in place, quotes and prints arrive late or not at all. The alert can't evaluate a tick it never received, so it lags badly or stays silent. A quick sanity check: is the symbol showing real-time quotes that move? If it's stale, fix the data before you touch the alert." },
    { type: "heading", text: "5. The level or event never actually happened" },
    { type: "paragraph", html: "The unglamorous possibility. A crosses-above set too far from price, or a size threshold no single print ever reached, will sit there forever behaving exactly as designed. Before assuming a bug, confirm the market actually did the thing you told the alert to watch for." },
    { type: "heading", text: "How to Fix a Tradovate Alert That Won't Fire: Step-by-Step" },
    {
      type: "steps",
      items: [
        { title: "Prove the pipeline with a plain price alert", html: "Don't debug the hard case first. Set a dead-simple price alert on the same instrument, a crosses-above or crosses-below just a few ticks from where price is trading right now, with sound and popup enabled. If that fires within seconds, your notification pipeline, data feed, and account are all fine, which isolates the problem to the original condition. If even the plain price alert doesn't fire, the issue is data or notifications, not the condition type." },
        { title: "Read back the exact condition you built", html: "Reopen the failing alert and look hard at the property, the operator, and the value. Is the property a price field, or is it Last Size, volume, or another quantity field? Is the operator pointed the right direction (greater-than versus less-than)? Is the value reachable? Writing the condition out in plain English, &ldquo;fire when a single ES trade prints 50+ contracts,&rdquo; usually makes it obvious you've built a size rule, not a price rule." },
        { title: "Confirm it's active in the Alerts Manager", html: "Open the Alerts Manager from the tools panel and find the alert. Check that it's listed as active rather than paused or already triggered. If it's a one-shot that already fired, recreate it. If it got toggled off, switch it back on. This is also where you delete stale alerts that clutter the list and make it hard to see what's really armed." },
      ],
    },
    {
      type: "steps",
      items: [
        { title: "Turn on a notification you can't miss", html: "In the alert's settings, enable sound and popup at minimum. When a Tradovate alert fires, the browser plays a sound, the bell icon shows a red dot, and any custom message appears in a small flag beneath the bell. If you've never seen that behavior, you either haven't had a real fire yet or the delivery methods were off. Make the next fire loud enough to notice." },
        { title: "Rebuild the intent as a price condition if you can", html: "Often the thing you really care about can be expressed as price. If you were watching Last Size to catch aggressive buying at a level, a crosses-above alert at that level may get you 90% of the way there and it will actually fire. Not every size-based idea reduces to price, but many do, and a price alert that works beats a size alert that doesn't." },
        { title: "Escalate to support with specifics", html: "If the condition genuinely needs to be Last Size or volume and it still won't fire after the proof test passes, stop guessing and open a ticket. Give support the exact instrument, the full condition (for example &ldquo;ES Last Size &gt;= 50&rdquo;), a screenshot of the alert, and the key detail that a plain price alert on the same symbol fires fine. Ask them point-blank whether that condition type is supported and expected to trigger. That single question saves you hours of poking at a setting that was never going to work." },
      ],
    },
    { type: "heading", text: "Troubleshooting Table" },
    {
      type: "table",
      headers: ["Symptom", "Likely cause", "Fix"],
      rows: [
        ["Price alerts fire, but Last Size / volume alert never does", "Non-price condition outside the documented price model", "Rebuild as a price condition, or escalate to support to confirm the type is supported"],
        ["No alert fires at all, even a simple price one", "Notifications off or symbol on delayed/missing data", "Enable sound + popup; confirm the instrument shows live real-time quotes"],
        ["Alert seemed to work once, then went quiet", "One-shot alert already triggered and cleared", "Recreate it (or set it to recur if you want repeated fires)"],
        ["Alert missing from the workspace entirely", "Disabled or deleted in the Alerts Manager", "Reopen the Alerts Manager, re-enable or rebuild the alert"],
        ["Alert fires late, well after the level traded", "Delayed data feed on the symbol", "Subscribe to real-time data and confirm the quote updates in real time"],
        ["Need a dependable trigger on a size/volume event", "Native size condition may not evaluate", "Express the logic in a charting platform and fire a webhook to automate it"],
      ],
    },
    { type: "heading", text: "A More Reliable Trigger with PickMyTrade" },
    { type: "paragraph", html: "Here's the honest read: if what you're really after is an <em>action</em> when size or volume spikes, not just a chime, a native chart alert is the wrong tool for the job even when it works. You want the condition evaluated where that kind of logic is strong, and the resulting order routed straight to your account. That's the gap PickMyTrade fills." },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Build the condition where it belongs.</strong> A charting platform like TradingView can express size, volume, and multi-factor conditions in a script and fire a webhook the instant they hit, no dependence on a native alert type that may not evaluate.",
        "<strong class='text-white'>Route it straight to Tradovate.</strong> PickMyTrade takes that webhook and acts on your Tradovate account automatically, so the &ldquo;alert&rdquo; becomes an actual trade instead of a notification you still have to react to.",
        "<strong class='text-white'>Mirror across accounts.</strong> The same trigger can drive several evaluation or funded accounts at once, so you're not manually repeating an alert that's already unreliable on one screen.",
        "<strong class='text-white'>Rate-limit-safe routing.</strong> Order flow is spaced to stay inside Tradovate's limits, avoiding the retry storms that create separate lockouts.",
      ],
    },
    { type: "paragraph", html: "You keep native price alerts for what they're good at, eyes-on levels, and hand the size-and-volume automation to a pipeline that's built to fire every time." },
  ], de: [
    { type: "paragraph", html: "Sie erstellen einen Alert, prüfen die Zahlen doppelt und warten dann. Das Level wird durchgehandelt, das Volumen schießt hoch, und nichts passiert. Kein Ton, kein roter Punkt an der Glocke, keine Markierung darunter. Der Alert liegt einfach da, als wäre er nie scharf geschaltet gewesen. Neun von zehn Mal liegt das nicht an einer defekten Plattform oder einer übersehenen Einstellung. Es liegt am <em>Typ</em> der von Ihnen angehängten Bedingung. Die Alert-Engine von Tradovate ist um den Preis herum aufgebaut, und eine Größen- oder Volumenbedingung wie &ldquo;Last Size &gt;= 50&rdquo; verhält sich überhaupt nicht wie ein Preis-Alert. Hier erfahren Sie, wie Sie erkennen, womit Sie es tatsächlich zu tun haben, wie Sie in etwa einer Minute beweisen, dass der Alert-Mechanismus funktioniert, und was zu tun ist, wenn eine Nicht-Preis-Bedingung wirklich nicht feuert." },
    {
      type: "checklist",
      heading: "Kurz-Checkliste für einen Alert, der nie feuert",
      items: [
        "<strong class='text-white'>Prüfen Sie zuerst den Bedingungstyp.</strong> Preis-Alerts (touch, crosses above, crosses below) feuern zuverlässig. Größen- und Volumenbedingungen wie Last Size sind ein anderer Mechanismus und lösen möglicherweise nicht wie konfiguriert aus.",
        "<strong class='text-white'>Bestätigen Sie, dass der Alert noch aktiv ist.</strong> Öffnen Sie den Alerts Manager und stellen Sie sicher, dass er nicht pausiert, deaktiviert, oder bereits ausgelöst und gelöscht ist.",
        "<strong class='text-white'>Stellen Sie sicher, dass eine Benachrichtigungsmethode aktiv ist.</strong> Ein Alert kann lautlos feuern, wenn Ton und Popup beide ausgeschaltet sind, was exakt so aussieht wie &ldquo;er hat nie gefeuert.&rdquo;",
        "<strong class='text-white'>Prüfen Sie, ob das Symbol Live-Daten hat.</strong> Ein Alert kann nur Ticks auswerten, die er tatsächlich empfängt. Ein verzögerter oder toter Feed bedeutet späte Auslösungen oder gar keine.",
        "<strong class='text-white'>Führen Sie einen Beweistest mit einem einfachen Preis-Alert durch.</strong> Setzen Sie ein einfaches crosses-above/below auf dasselbe Instrument nahe dem aktuellen Preis, um zu bestätigen, dass die Pipeline durchgehend funktioniert.",
        "<strong class='text-white'>Eskalieren Sie mit Details, falls eine Nicht-Preis-Bedingung weiterhin nicht feuert.</strong> Senden Sie dem Support das exakte Instrument, die vollständige Bedingung und einen Screenshot, und fragen Sie, ob dieser Typ unterstützt wird.",
      ],
    },
    { type: "heading", text: "Was &ldquo;Last Size&rdquo; tatsächlich bedeutet (und warum es stolpern lässt)" },
    { type: "paragraph", html: "Last Size ist die Anzahl der Kontrakte im zuletzt ausgeführten Trade. Nicht der Preis. Nicht Geld- oder Briefkurs. Die <em>Menge</em> des letzten Prints, der über das Tape lief. Eine Bedingung wie &ldquo;ES Last Size &gt;= 50&rdquo; bittet die Plattform also, in dem Moment zu feuern, in dem ein einzelner Trade von 50 oder mehr Kontrakten durchgeht. Das ist ein legitimes Anliegen zum Beobachten. Große Prints markieren oft, wo Größe einsteigt, und sie in Echtzeit zu erfassen ist wirklich nützlich." },
    { type: "paragraph", html: "Das Problem ist, dass es sich hierbei um eine Handelsgrößen-Bedingung handelt, die dieselbe Verkleidung wie eine Preisbedingung trägt. Im Alert-Builder sieht es aus wie jede andere Regel: eine Eigenschaft wählen, einen Operator wählen, eine Zahl eingeben. Aber Preis und Größe werden unter der Haube sehr unterschiedlich ausgewertet, und das Alert-System von Tradovate ist dokumentiert und um den Preis herum konzipiert. Einfache Alerts beobachten den Preis eines Instruments, einer Position, oder eines Kontoparameters, der einen Wert erreicht. Erweiterte Alerts stapeln mehrere dieser Preisbedingungen und feuern, wenn alle oder eine davon erfüllt ist. Größe pro Print passt nicht in dieses Modell. Wenn Sie also eine Last-Size-Regel anhängen und sie nie feuert, machen Sie nicht zwangsläufig etwas falsch. Sie haben möglicherweise eine Bedingung erstellt, die die Engine nicht so auswertet, wie das Formular es suggeriert." },
    { type: "heading", text: "Die häufigsten Gründe, warum ein konfigurierter Alert nie auslöst" },
    { type: "heading", text: "1. Die Bedingung ist keine Preisbedingung (Last Size, Volumen, Menge)" },
    { type: "paragraph", html: "Das ist die Hauptursache und der Grund, warum diese Seite existiert. Preis-Alerts sind der ausgetretene Pfad: Sie berühren oder überqueren ein Level und feuern. Größen- und Volumenbedingungen liegen außerhalb dieses dokumentierten Verhaltens. Haben Sie &ldquo;Last Size &gt;= 50,&rdquo; &ldquo;volume &gt; X,&rdquo; oder irgendetwas erstellt, das Handelsmenge statt Preis beobachtet, gehen Sie davon aus, dass es möglicherweise nicht auslöst, bis das Gegenteil bewiesen ist. Das schnellste Erkennungsmerkmal ist der Beweistest weiter unten: Feuert ein einfacher Preis-Alert auf demselben Symbol, Ihr Größen-Alert aber nicht, ist der Bedingungstyp der Übeltäter, nicht die Plattform." },
    { type: "heading", text: "2. Der Alert ist deaktiviert, pausiert, oder bereits verbraucht" },
    { type: "paragraph", html: "Alerts leben nicht von selbst ewig. Ein Einmal-Alert feuert einmal und verstummt dann, hat er also ausgelöst, während Sie nicht hinsahen, feuert er nicht erneut. Andere werden versehentlich abgeschaltet. Im Alerts Manager bestätigen Sie den tatsächlichen Zustand eines Alerts, statt anzunehmen, dass er scharf geschaltet ist." },
    { type: "heading", text: "3. Jede Benachrichtigungsmethode ist ausgeschaltet" },
    { type: "paragraph", html: "Ein Alert kann feuern, ohne dass Sie es je erfahren. Sind Ton, Popup, und jede Push-Option alle aus, geschieht die Auslösung lautlos und sieht exakt wie ein Fehler aus. Öffnen Sie den Alert erneut und stellen Sie sicher, dass mindestens eine Zustellmethode aktiviert ist, damit eine Auslösung tatsächlich etwas ist, das Sie sehen oder hören können." },
    { type: "heading", text: "4. Das Symbol hat verzögerte oder fehlende Marktdaten" },
    { type: "paragraph", html: "Ein Alert ist nur so live wie der Feed dahinter. Läuft das Instrument auf einem zehn Minuten verzögerten Feed, oder besteht keine Datenvereinbarung, kommen Kurse und Prints spät oder gar nicht an. Der Alert kann keinen Tick auswerten, den er nie empfangen hat, er hinkt also stark hinterher oder bleibt still. Ein schneller Plausibilitätscheck: Zeigt das Symbol sich bewegende Echtzeitkurse? Ist es veraltet, beheben Sie die Daten, bevor Sie den Alert anfassen." },
    { type: "heading", text: "5. Das Level oder Ereignis ist tatsächlich nie eingetreten" },
    { type: "paragraph", html: "Die unspektakuläre Möglichkeit. Ein crosses-above, das zu weit vom Preis entfernt gesetzt wurde, oder eine Größenschwelle, die kein einzelner Print je erreicht hat, liegt für immer da und verhält sich exakt wie konzipiert. Bevor Sie einen Fehler annehmen, bestätigen Sie, dass der Markt das tatsächlich getan hat, worauf Sie den Alert angesetzt haben." },
    { type: "heading", text: "So beheben Sie einen Tradovate-Alert, der nicht feuert: Schritt für Schritt" },
    {
      type: "steps",
      items: [
        { title: "Beweisen Sie die Pipeline mit einem einfachen Preis-Alert", html: "Debuggen Sie nicht zuerst den schwierigen Fall. Setzen Sie einen kinderleichten Preis-Alert auf dasselbe Instrument, ein crosses-above oder crosses-below nur wenige Ticks vom aktuellen Handelspreis entfernt, mit aktiviertem Ton und Popup. Feuert dieser innerhalb von Sekunden, sind Ihre Benachrichtigungs-Pipeline, der Datenfeed, und das Konto alle in Ordnung, was das Problem auf die ursprüngliche Bedingung eingrenzt. Feuert selbst der einfache Preis-Alert nicht, liegt das Problem bei Daten oder Benachrichtigungen, nicht beim Bedingungstyp." },
        { title: "Lesen Sie die exakte Bedingung, die Sie erstellt haben, noch einmal durch", html: "Öffnen Sie den fehlschlagenden Alert erneut und betrachten Sie genau die Eigenschaft, den Operator und den Wert. Ist die Eigenschaft ein Preisfeld, oder ist es Last Size, Volumen, oder ein anderes Mengenfeld? Zeigt der Operator in die richtige Richtung (größer-als versus kleiner-als)? Ist der Wert erreichbar? Die Bedingung in einfachem Deutsch auszuformulieren, &ldquo;feuere, wenn ein einzelner ES-Trade 50+ Kontrakte printet,&rdquo; macht meist offensichtlich, dass Sie eine Größenregel gebaut haben, keine Preisregel." },
        { title: "Bestätigen Sie, dass er im Alerts Manager aktiv ist", html: "Öffnen Sie den Alerts Manager im Werkzeugpanel und finden Sie den Alert. Prüfen Sie, dass er als aktiv gelistet ist, statt pausiert oder bereits ausgelöst. Handelt es sich um einen bereits ausgelösten Einmal-Alert, erstellen Sie ihn neu. Wurde er abgeschaltet, schalten Sie ihn wieder ein. Hier löschen Sie auch veraltete Alerts, die die Liste überfüllen und es erschweren zu sehen, was wirklich scharf geschaltet ist." },
      ],
    },
    {
      type: "steps",
      items: [
        { title: "Schalten Sie eine Benachrichtigung ein, die Sie nicht verpassen können", html: "Aktivieren Sie in den Einstellungen des Alerts mindestens Ton und Popup. Wenn ein Tradovate-Alert feuert, spielt der Browser einen Ton ab, das Glockensymbol zeigt einen roten Punkt, und jede benutzerdefinierte Nachricht erscheint in einer kleinen Markierung unter der Glocke. Haben Sie dieses Verhalten noch nie gesehen, hatten Sie entweder noch keine echte Auslösung, oder die Zustellmethoden waren aus. Machen Sie die nächste Auslösung laut genug, um sie zu bemerken." },
        { title: "Bauen Sie die Absicht nach Möglichkeit als Preisbedingung nach", html: "Oft lässt sich das, worum es Ihnen wirklich geht, als Preis ausdrücken. Beobachteten Sie Last Size, um aggressives Kaufen an einem Level zu erfassen, bringt Sie ein crosses-above-Alert an diesem Level möglicherweise zu 90% ans Ziel, und er wird tatsächlich feuern. Nicht jede größenbasierte Idee reduziert sich auf Preis, aber viele tun es, und ein funktionierender Preis-Alert schlägt einen Größen-Alert, der nicht funktioniert." },
        { title: "Eskalieren Sie mit Details an den Support", html: "Muss die Bedingung wirklich Last Size oder Volumen sein und feuert weiterhin nicht, nachdem der Beweistest bestanden wurde, hören Sie auf zu raten und eröffnen Sie ein Ticket. Geben Sie dem Support das exakte Instrument, die vollständige Bedingung (zum Beispiel &ldquo;ES Last Size &gt;= 50&rdquo;), einen Screenshot des Alerts, und das entscheidende Detail, dass ein einfacher Preis-Alert auf demselben Symbol problemlos feuert. Fragen Sie direkt, ob dieser Bedingungstyp unterstützt wird und erwartungsgemäß auslösen sollte. Diese eine Frage erspart Ihnen Stunden des Herumstocherns an einer Einstellung, die nie funktionieren würde." },
      ],
    },
    { type: "heading", text: "Fehlerbehebungstabelle" },
    {
      type: "table",
      headers: ["Symptom", "Wahrscheinliche Ursache", "Lösung"],
      rows: [
        ["Preis-Alerts feuern, aber der Last-Size-/Volumen-Alert nie", "Nicht-Preis-Bedingung außerhalb des dokumentierten Preismodells", "Als Preisbedingung neu bauen, oder an den Support eskalieren, um zu bestätigen, dass der Typ unterstützt wird"],
        ["Gar kein Alert feuert, selbst ein einfacher Preis-Alert nicht", "Benachrichtigungen aus oder Symbol mit verzögerten/fehlenden Daten", "Ton + Popup aktivieren; bestätigen, dass das Instrument Live-Echtzeitkurse zeigt"],
        ["Alert schien einmal zu funktionieren, wurde dann still", "Einmal-Alert bereits ausgelöst und gelöscht", "Neu erstellen (oder auf wiederkehrend setzen, wenn Sie wiederholte Auslösungen wünschen)"],
        ["Alert fehlt komplett im Workspace", "Im Alerts Manager deaktiviert oder gelöscht", "Alerts Manager erneut öffnen, Alert wieder aktivieren oder neu erstellen"],
        ["Alert feuert spät, deutlich nachdem das Level gehandelt wurde", "Verzögerter Datenfeed beim Symbol", "Echtzeitdaten abonnieren und bestätigen, dass sich der Kurs in Echtzeit aktualisiert"],
        ["Zuverlässige Auslösung bei einem Größen-/Volumenereignis benötigt", "Native Größenbedingung wertet möglicherweise nicht aus", "Die Logik in einer Chart-Plattform ausdrücken und einen Webhook zur Automatisierung feuern"],
      ],
    },
    { type: "heading", text: "Eine zuverlässigere Auslösung mit PickMyTrade" },
    { type: "paragraph", html: "Hier die ehrliche Einschätzung: Geht es Ihnen wirklich um eine <em>Aktion</em>, wenn Größe oder Volumen ausschlägt, nicht nur um einen Klingelton, ist ein nativer Chart-Alert selbst dann das falsche Werkzeug für die Aufgabe, wenn er funktioniert. Sie wollen, dass die Bedingung dort ausgewertet wird, wo diese Art von Logik stark ist, und die resultierende Order direkt an Ihr Konto geroutet wird. Das ist die Lücke, die PickMyTrade schließt." },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Bauen Sie die Bedingung dort, wo sie hingehört.</strong> Eine Chart-Plattform wie TradingView kann Größen-, Volumen-, und Multi-Faktor-Bedingungen in einem Skript ausdrücken und in dem Moment, in dem sie eintreten, einen Webhook feuern, ohne Abhängigkeit von einem nativen Alert-Typ, der möglicherweise nicht auswertet.",
        "<strong class='text-white'>Routen Sie sie direkt an Tradovate.</strong> PickMyTrade nimmt diesen Webhook entgegen und agiert automatisch auf Ihrem Tradovate-Konto, sodass der &ldquo;Alert&rdquo; zu einem tatsächlichen Trade wird statt zu einer Benachrichtigung, auf die Sie noch reagieren müssen.",
        "<strong class='text-white'>Spiegeln Sie über Konten hinweg.</strong> Derselbe Auslöser kann mehrere Evaluierungs- oder finanzierte Konten gleichzeitig antreiben, sodass Sie einen bereits auf einem Bildschirm unzuverlässigen Alert nicht manuell wiederholen müssen.",
        "<strong class='text-white'>Ratenlimit-sichere Weiterleitung.</strong> Der Orderfluss wird gestaffelt, um innerhalb der Limits von Tradovate zu bleiben, und vermeidet so die Wiederholungsstürme, die separate Sperren erzeugen.",
      ],
    },
    { type: "paragraph", html: "Sie behalten native Preis-Alerts für das, worin sie gut sind, das Auge auf Levels, und übergeben die Größen-und-Volumen-Automatisierung an eine Pipeline, die darauf ausgelegt ist, jedes Mal zu feuern." },
  ], es: [
    { type: "paragraph", html: "Configura una alerta, verifica los números dos veces, y luego espera. El nivel se opera, el volumen se dispara, y no pasa nada. Sin sonido, sin punto rojo en la campana, sin marca debajo. La alerta simplemente permanece ahí como si nunca hubiera estado armada. Nueve de cada diez veces esto no se debe a una plataforma rota ni a una configuración pasada por alto. Es el <em>tipo</em> de condición que adjuntó. El motor de alertas de Tradovate está construido en torno al precio, y una condición de tamaño o volumen como &ldquo;Last Size &gt;= 50&rdquo; no se comporta en absoluto como una alerta de precio. A continuación explicamos cómo identificar con qué está tratando realmente, cómo demostrar que el mecanismo de alertas funciona en aproximadamente un minuto, y qué hacer cuando una condición que no es de precio genuinamente no se dispara." },
    {
      type: "checklist",
      heading: "Lista rápida para una alerta que nunca se dispara",
      items: [
        "<strong class='text-white'>Compruebe primero el tipo de condición.</strong> Las alertas de precio (touch, crosses above, crosses below) se disparan de forma fiable. Las condiciones de tamaño y volumen como Last Size son un mecanismo distinto y pueden no dispararse según lo configurado.",
        "<strong class='text-white'>Confirme que la alerta sigue activa.</strong> Abra el Alerts Manager y asegúrese de que no esté pausada, deshabilitada, o ya disparada y eliminada.",
        "<strong class='text-white'>Asegúrese de que un método de notificación esté activado.</strong> Una alerta puede dispararse en silencio si el sonido y el popup están ambos desactivados, lo cual se ve idéntico a &ldquo;nunca se disparó.&rdquo;",
        "<strong class='text-white'>Verifique que el símbolo tenga datos en vivo.</strong> Una alerta solo puede evaluar los ticks que realmente recibe. Un feed retrasado o muerto significa disparos tardíos o ninguno.",
        "<strong class='text-white'>Ejecute una prueba de comprobación con una alerta de precio simple.</strong> Configure un simple crosses-above/below en el mismo instrumento cerca del precio actual para confirmar que la canalización funciona de extremo a extremo.",
        "<strong class='text-white'>Escale con detalles si una condición que no es de precio sigue sin dispararse.</strong> Envíe al soporte el instrumento exacto, la condición completa, y una captura de pantalla, y pregunte si ese tipo está soportado.",
      ],
    },
    { type: "heading", text: "Qué significa realmente &ldquo;Last Size&rdquo; (y por qué confunde)" },
    { type: "paragraph", html: "Last Size es el número de contratos en la operación ejecutada más reciente. No el precio. No el bid ni el ask. La <em>cantidad</em> del último print que cruzó la cinta. Así que una condición como &ldquo;ES Last Size &gt;= 50&rdquo; le pide a la plataforma que se dispare en el instante en que una sola operación de 50 o más contratos se ejecute. Es algo legítimo que se quiera vigilar. Los prints grandes suelen marcar dónde entra el tamaño, y captarlos en tiempo real es genuinamente útil." },
    { type: "paragraph", html: "El problema es que se trata de una condición de tamaño de operación disfrazada de condición de precio. En el creador de alertas parece cualquier otra regla: elegir una propiedad, elegir un operador, escribir un número. Pero el precio y el tamaño se evalúan de forma muy distinta por debajo, y el sistema de alertas de Tradovate está documentado y diseñado en torno al precio. Las alertas simples vigilan el precio de un instrumento, posición, o parámetro de cuenta alcanzando un valor. Las alertas avanzadas apilan varias de esas condiciones de precio y se disparan cuando se cumplen todas o alguna de ellas. El tamaño por print no encaja en ese modelo. Así que cuando adjunta una regla Last Size y nunca se dispara, no necesariamente está haciendo algo mal. Puede haber construido una condición que el motor en realidad no evalúa de la forma que el formulario da a entender." },
    { type: "heading", text: "Principales razones por las que una alerta configurada nunca se dispara" },
    { type: "heading", text: "1. La condición no es de precio (Last Size, volumen, cantidad)" },
    { type: "paragraph", html: "Esta es la causa principal y la razón de ser de esta página. Las alertas de precio son el camino ya trillado: tocan o cruzan un nivel y se disparan. Las condiciones de tamaño y volumen viven fuera de ese comportamiento documentado. Si construyó &ldquo;Last Size &gt;= 50,&rdquo; &ldquo;volume &gt; X,&rdquo; o cualquier cosa que vigile la cantidad de la operación en lugar del precio, asuma que puede no dispararse hasta que se demuestre lo contrario. La forma más rápida de comprobarlo es la prueba de más abajo: si una alerta de precio simple en el mismo símbolo se dispara y su alerta de tamaño no, el tipo de condición es el culpable, no la plataforma." },
    { type: "heading", text: "2. La alerta está deshabilitada, pausada, o ya se consumió" },
    { type: "paragraph", html: "Las alertas no viven para siempre por sí solas. Una alerta de disparo único se dispara una vez y luego queda en silencio, así que si se disparó mientras usted no miraba, no volverá a hacerlo. Otras se desactivan por accidente. El Alerts Manager es donde confirma el estado real de una alerta en lugar de asumir que está armada." },
    { type: "heading", text: "3. Todos los métodos de notificación están desactivados" },
    { type: "paragraph", html: "Una alerta puede dispararse y usted nunca lo sabría. Si el sonido, el popup, y cualquier opción push están todos desactivados, el disparo ocurre en silencio y se ve exactamente como un fallo. Vuelva a abrir la alerta y asegúrese de que al menos un método de entrega esté habilitado, para que un disparo sea algo que realmente pueda ver u oír." },
    { type: "heading", text: "4. El símbolo tiene datos de mercado retrasados o ausentes" },
    { type: "paragraph", html: "Una alerta es tan en vivo como el feed detrás de ella. Si el instrumento está en un feed retrasado diez minutos, o el acuerdo de datos no está en vigor, las cotizaciones y prints llegan tarde o no llegan en absoluto. La alerta no puede evaluar un tick que nunca recibió, así que se retrasa mucho o queda en silencio. Una comprobación rápida: ¿el símbolo muestra cotizaciones en tiempo real que se mueven? Si están obsoletas, arregle los datos antes de tocar la alerta." },
    { type: "heading", text: "5. El nivel o evento en realidad nunca ocurrió" },
    { type: "paragraph", html: "La posibilidad menos glamurosa. Un crosses-above configurado demasiado lejos del precio, o un umbral de tamaño que ningún print alcanzó jamás, se quedará ahí para siempre comportándose exactamente como fue diseñado. Antes de asumir un error, confirme que el mercado realmente hizo lo que le indicó a la alerta que vigilara." },
    { type: "heading", text: "Cómo solucionar una alerta de Tradovate que no se dispara: paso a paso" },
    {
      type: "steps",
      items: [
        { title: "Demuestre la canalización con una alerta de precio simple", html: "No depure primero el caso difícil. Configure una alerta de precio absolutamente simple en el mismo instrumento, un crosses-above o crosses-below a solo unos ticks de donde cotiza el precio ahora mismo, con sonido y popup activados. Si se dispara en segundos, su canalización de notificaciones, feed de datos, y cuenta están todos bien, lo que aísla el problema a la condición original. Si ni siquiera la alerta de precio simple se dispara, el problema son los datos o las notificaciones, no el tipo de condición." },
        { title: "Vuelva a leer la condición exacta que construyó", html: "Vuelva a abrir la alerta que falla y examine con detalle la propiedad, el operador, y el valor. ¿La propiedad es un campo de precio, o es Last Size, volumen, u otro campo de cantidad? ¿El operador apunta en la dirección correcta (mayor-que frente a menor-que)? ¿Es el valor alcanzable? Escribir la condición en lenguaje llano, &ldquo;dispárate cuando una sola operación de ES imprima 50+ contratos,&rdquo; suele dejar claro que ha construido una regla de tamaño, no una regla de precio." },
        { title: "Confirme que está activa en el Alerts Manager", html: "Abra el Alerts Manager desde el panel de herramientas y busque la alerta. Compruebe que aparece como activa en lugar de pausada o ya disparada. Si es de disparo único y ya se disparó, vuelva a crearla. Si se desactivó, actívela de nuevo. Aquí también elimina alertas obsoletas que saturan la lista y dificultan ver qué está realmente armado." },
      ],
    },
    {
      type: "steps",
      items: [
        { title: "Active una notificación que no pueda pasar por alto", html: "En la configuración de la alerta, active como mínimo el sonido y el popup. Cuando una alerta de Tradovate se dispara, el navegador reproduce un sonido, el icono de la campana muestra un punto rojo, y cualquier mensaje personalizado aparece en una pequeña marca bajo la campana. Si nunca ha visto ese comportamiento, o no ha tenido un disparo real todavía, o los métodos de entrega estaban desactivados. Haga que el próximo disparo sea lo bastante notorio como para percibirlo." },
        { title: "Reconstruya la intención como condición de precio si puede", html: "A menudo lo que realmente le importa puede expresarse como precio. Si vigilaba Last Size para captar compras agresivas en un nivel, una alerta crosses-above en ese nivel puede llevarle al 90% del camino y de hecho se disparará. No toda idea basada en tamaño se reduce a precio, pero muchas sí, y una alerta de precio que funciona vence a una alerta de tamaño que no." },
        { title: "Escale al soporte con detalles", html: "Si la condición realmente necesita ser Last Size o volumen y sigue sin dispararse después de que la prueba de comprobación funcione, deje de adivinar y abra un ticket. Dé al soporte el instrumento exacto, la condición completa (por ejemplo &ldquo;ES Last Size &gt;= 50&rdquo;), una captura de pantalla de la alerta, y el detalle clave de que una alerta de precio simple en el mismo símbolo sí se dispara. Pregúnteles directamente si ese tipo de condición está soportado y se espera que se dispare. Esa única pregunta le ahorra horas de trastear con una configuración que nunca iba a funcionar." },
      ],
    },
    { type: "heading", text: "Tabla de solución de problemas" },
    {
      type: "table",
      headers: ["Síntoma", "Causa probable", "Solución"],
      rows: [
        ["Las alertas de precio se disparan, pero la alerta de Last Size / volumen nunca lo hace", "Condición que no es de precio, fuera del modelo de precio documentado", "Reconstruya como condición de precio, o escale al soporte para confirmar que el tipo está soportado"],
        ["No se dispara ninguna alerta, ni siquiera una simple de precio", "Notificaciones desactivadas o símbolo con datos retrasados/ausentes", "Active sonido + popup; confirme que el instrumento muestra cotizaciones en tiempo real"],
        ["La alerta parecía funcionar una vez, luego quedó en silencio", "Alerta de disparo único ya activada y eliminada", "Vuelva a crearla (o configúrela para repetirse si desea disparos repetidos)"],
        ["La alerta falta por completo del espacio de trabajo", "Deshabilitada o eliminada en el Alerts Manager", "Vuelva a abrir el Alerts Manager, reactive o reconstruya la alerta"],
        ["La alerta se dispara tarde, bastante después de que se operara el nivel", "Feed de datos retrasado en el símbolo", "Suscríbase a datos en tiempo real y confirme que la cotización se actualiza en tiempo real"],
        ["Necesita un disparador fiable en un evento de tamaño/volumen", "La condición de tamaño nativa puede no evaluarse", "Exprese la lógica en una plataforma de gráficos y dispare un webhook para automatizarla"],
      ],
    },
    { type: "heading", text: "Un disparador más fiable con PickMyTrade" },
    { type: "paragraph", html: "Aquí la lectura honesta: si lo que realmente busca es una <em>acción</em> cuando el tamaño o el volumen se dispara, no solo un tono, una alerta nativa del gráfico es la herramienta equivocada para el trabajo incluso cuando funciona. Usted quiere que la condición se evalúe donde ese tipo de lógica es fuerte, y que la orden resultante se enrute directamente a su cuenta. Ese es el vacío que llena PickMyTrade." },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Construya la condición donde pertenece.</strong> Una plataforma de gráficos como TradingView puede expresar condiciones de tamaño, volumen, y multifactoriales en un script y disparar un webhook en el instante en que se cumplen, sin depender de un tipo de alerta nativo que puede no evaluarse.",
        "<strong class='text-white'>Enrútela directamente a Tradovate.</strong> PickMyTrade toma ese webhook y actúa en su cuenta de Tradovate automáticamente, para que la &ldquo;alerta&rdquo; se convierta en una operación real en lugar de una notificación a la que todavía tiene que reaccionar.",
        "<strong class='text-white'>Replique en varias cuentas.</strong> El mismo disparador puede impulsar simultáneamente varias cuentas de evaluación o financiadas, para que no tenga que repetir manualmente una alerta que ya es poco fiable en una sola pantalla.",
        "<strong class='text-white'>Enrutamiento seguro frente a límites de tasa.</strong> El flujo de órdenes se espacia para permanecer dentro de los límites de Tradovate, evitando las tormentas de reintentos que generan bloqueos aparte.",
      ],
    },
    { type: "paragraph", html: "Conserva las alertas de precio nativas para lo que se les da bien, la vigilancia de niveles, y entrega la automatización de tamaño y volumen a una canalización construida para dispararse siempre." },
  ], fr: [
    { type: "paragraph", html: "Vous créez une alerte, vérifiez les chiffres à deux reprises, puis attendez. Le niveau est traversé par le marché, le volume explose, et rien ne se passe. Aucun son, aucun point rouge sur la cloche, aucune marque en dessous. L'alerte reste simplement là comme si elle n'avait jamais été armée. Neuf fois sur dix, ce n'est pas une plateforme défaillante ni un réglage manqué. C'est le <em>type</em> de condition que vous avez attaché. Le moteur d'alertes de Tradovate est construit autour du prix, et une condition de taille ou de volume comme &ldquo;Last Size &gt;= 50&rdquo; ne se comporte absolument pas comme une alerte de prix. Voici comment identifier ce à quoi vous avez réellement affaire, comment prouver en environ une minute que le mécanisme d'alerte fonctionne, et que faire lorsqu'une condition hors prix ne se déclenche vraiment pas." },
    {
      type: "checklist",
      heading: "Check-list rapide pour une alerte qui ne se déclenche jamais",
      items: [
        "<strong class='text-white'>Vérifiez d'abord le type de condition.</strong> Les alertes de prix (touch, crosses above, crosses below) se déclenchent de manière fiable. Les conditions de taille et de volume comme Last Size relèvent d'un mécanisme différent et peuvent ne pas se déclencher comme configuré.",
        "<strong class='text-white'>Confirmez que l'alerte est toujours active.</strong> Ouvrez l'Alerts Manager et assurez-vous qu'elle n'est pas en pause, désactivée, ou déjà déclenchée et effacée.",
        "<strong class='text-white'>Assurez-vous qu'une méthode de notification est activée.</strong> Une alerte peut se déclencher silencieusement si le son et le popup sont tous deux désactivés, ce qui ressemble exactement à &ldquo;elle ne s'est jamais déclenchée.&rdquo;",
        "<strong class='text-white'>Vérifiez que le symbole dispose de données en direct.</strong> Une alerte ne peut évaluer que les ticks qu'elle reçoit réellement. Un flux retardé ou mort signifie des déclenchements tardifs ou aucun déclenchement.",
        "<strong class='text-white'>Effectuez un test de preuve avec une alerte de prix simple.</strong> Configurez un simple crosses-above/below sur le même instrument près du prix actuel pour confirmer que le pipeline fonctionne de bout en bout.",
        "<strong class='text-white'>Escaladez avec des détails si une condition hors prix ne se déclenche toujours pas.</strong> Envoyez au support l'instrument exact, la condition complète, et une capture d'écran, et demandez si ce type est pris en charge.",
      ],
    },
    { type: "heading", text: "Ce que signifie réellement &ldquo;Last Size&rdquo; (et pourquoi ça déroute)" },
    { type: "paragraph", html: "Last Size est le nombre de contrats de la transaction exécutée la plus récente. Pas le prix. Ni le bid ni l'ask. La <em>quantité</em> du dernier print qui a traversé la bande. Une condition comme &ldquo;ES Last Size &gt;= 50&rdquo; demande donc à la plateforme de se déclencher à l'instant où une seule transaction de 50 contrats ou plus passe. C'est une chose légitime à vouloir surveiller. Les gros prints marquent souvent l'entrée de la taille, et les capter en temps réel est réellement utile." },
    { type: "paragraph", html: "Le problème, c'est qu'il s'agit d'une condition de taille de transaction déguisée en condition de prix. Dans le créateur d'alertes, elle ressemble à n'importe quelle autre règle : choisir une propriété, choisir un opérateur, saisir un nombre. Mais le prix et la taille sont évalués très différemment en coulisses, et le système d'alertes de Tradovate est documenté et conçu autour du prix. Les alertes simples surveillent le prix d'un instrument, d'une position, ou d'un paramètre de compte atteignant une valeur. Les alertes avancées empilent plusieurs de ces conditions de prix et se déclenchent lorsque toutes ou certaines d'entre elles sont remplies. La taille par print ne correspond pas à ce modèle. Ainsi, lorsque vous attachez une règle Last Size et qu'elle ne se déclenche jamais, vous ne faites pas nécessairement quelque chose de mal. Vous avez peut-être construit une condition que le moteur n'évalue pas réellement comme le formulaire le laisse entendre." },
    { type: "heading", text: "Principales raisons pour lesquelles une alerte configurée ne se déclenche jamais" },
    { type: "heading", text: "1. La condition n'est pas basée sur le prix (Last Size, volume, quantité)" },
    { type: "paragraph", html: "C'est la cause principale et la raison d'être de cette page. Les alertes de prix sont le chemin bien connu : elles touchent ou traversent un niveau et se déclenchent. Les conditions de taille et de volume se situent en dehors de ce comportement documenté. Si vous avez construit &ldquo;Last Size &gt;= 50,&rdquo; &ldquo;volume &gt; X,&rdquo; ou quoi que ce soit surveillant la quantité de la transaction plutôt que le prix, supposez qu'elle peut ne pas se déclencher jusqu'à preuve du contraire. Le moyen le plus rapide de le vérifier est le test de preuve plus bas : si une alerte de prix simple sur le même symbole se déclenche et que votre alerte de taille ne le fait pas, le type de condition est le coupable, pas la plateforme." },
    { type: "heading", text: "2. L'alerte est désactivée, en pause, ou déjà consommée" },
    { type: "paragraph", html: "Les alertes ne vivent pas éternellement d'elles-mêmes. Une alerte à déclenchement unique se déclenche une fois puis se tait, donc si elle s'est déclenchée pendant que vous ne regardiez pas, elle ne se redéclenchera pas. D'autres sont désactivées par accident. L'Alerts Manager est l'endroit où vous confirmez l'état réel d'une alerte au lieu de supposer qu'elle est armée." },
    { type: "heading", text: "3. Toutes les méthodes de notification sont désactivées" },
    { type: "paragraph", html: "Une alerte peut se déclencher sans que vous le sachiez jamais. Si le son, le popup, et toute option push sont tous désactivés, le déclenchement se produit silencieusement et ressemble exactement à un échec. Rouvrez l'alerte et assurez-vous qu'au moins une méthode de diffusion est activée, afin qu'un déclenchement soit quelque chose que vous puissiez réellement voir ou entendre." },
    { type: "heading", text: "4. Le symbole a des données de marché retardées ou manquantes" },
    { type: "paragraph", html: "Une alerte n'est en direct qu'à hauteur du flux qui la sous-tend. Si l'instrument est sur un flux retardé de dix minutes, ou si l'accord de données n'est pas en place, les cotations et prints arrivent tard ou pas du tout. L'alerte ne peut pas évaluer un tick qu'elle n'a jamais reçu, elle est donc très en retard ou reste silencieuse. Une vérification rapide : le symbole affiche-t-il des cotations en temps réel qui bougent ? Si elles sont obsolètes, corrigez les données avant de toucher à l'alerte." },
    { type: "heading", text: "5. Le niveau ou l'événement ne s'est en réalité jamais produit" },
    { type: "paragraph", html: "La possibilité la moins glamour. Un crosses-above réglé trop loin du prix, ou un seuil de taille qu'aucun print n'a jamais atteint, restera là indéfiniment en se comportant exactement comme prévu. Avant de supposer un bug, confirmez que le marché a effectivement fait ce que vous avez demandé à l'alerte de surveiller." },
    { type: "heading", text: "Comment résoudre une alerte Tradovate qui ne se déclenche pas : étape par étape" },
    {
      type: "steps",
      items: [
        { title: "Prouvez le pipeline avec une alerte de prix simple", html: "Ne déboguez pas d'abord le cas difficile. Configurez une alerte de prix on ne peut plus simple sur le même instrument, un crosses-above ou crosses-below à seulement quelques ticks du prix actuel, avec le son et le popup activés. Si elle se déclenche en quelques secondes, votre pipeline de notification, votre flux de données, et votre compte sont tous en ordre, ce qui isole le problème à la condition d'origine. Si même l'alerte de prix simple ne se déclenche pas, le problème vient des données ou des notifications, pas du type de condition." },
        { title: "Relisez la condition exacte que vous avez construite", html: "Rouvrez l'alerte défaillante et examinez attentivement la propriété, l'opérateur, et la valeur. La propriété est-elle un champ de prix, ou est-ce Last Size, le volume, ou un autre champ de quantité ? L'opérateur pointe-t-il dans la bonne direction (supérieur-à versus inférieur-à) ? La valeur est-elle atteignable ? Écrire la condition en langage clair, &ldquo;se déclencher quand une seule transaction ES imprime 50 contrats ou plus,&rdquo; rend généralement évident que vous avez construit une règle de taille, pas une règle de prix." },
        { title: "Confirmez qu'elle est active dans l'Alerts Manager", html: "Ouvrez l'Alerts Manager depuis le panneau d'outils et trouvez l'alerte. Vérifiez qu'elle est listée comme active plutôt qu'en pause ou déjà déclenchée. S'il s'agit d'une alerte à déclenchement unique déjà déclenchée, recréez-la. Si elle a été désactivée, réactivez-la. C'est aussi là que vous supprimez les alertes obsolètes qui encombrent la liste et rendent difficile de voir ce qui est réellement armé." },
      ],
    },
    {
      type: "steps",
      items: [
        { title: "Activez une notification que vous ne pouvez pas manquer", html: "Dans les paramètres de l'alerte, activez au minimum le son et le popup. Lorsqu'une alerte Tradovate se déclenche, le navigateur joue un son, l'icône de cloche affiche un point rouge, et tout message personnalisé apparaît dans une petite marque sous la cloche. Si vous n'avez jamais vu ce comportement, soit vous n'avez pas encore eu de véritable déclenchement, soit les méthodes de diffusion étaient désactivées. Rendez le prochain déclenchement assez visible pour le remarquer." },
        { title: "Reconstruisez l'intention en condition de prix si possible", html: "Souvent, ce qui vous intéresse vraiment peut s'exprimer en termes de prix. Si vous surveilliez Last Size pour capter des achats agressifs à un niveau, une alerte crosses-above à ce niveau peut vous rapprocher à 90 % du but, et elle se déclenchera réellement. Toute idée basée sur la taille ne se réduit pas au prix, mais beaucoup le font, et une alerte de prix qui fonctionne vaut mieux qu'une alerte de taille qui ne fonctionne pas." },
        { title: "Escaladez au support avec des détails", html: "Si la condition doit vraiment être Last Size ou volume et qu'elle ne se déclenche toujours pas après que le test de preuve a réussi, arrêtez de deviner et ouvrez un ticket. Donnez au support l'instrument exact, la condition complète (par exemple &ldquo;ES Last Size &gt;= 50&rdquo;), une capture d'écran de l'alerte, et le détail clé qu'une alerte de prix simple sur le même symbole se déclenche bien. Demandez-leur directement si ce type de condition est pris en charge et censé se déclencher. Cette seule question vous épargne des heures à tâtonner sur un réglage qui n'allait jamais fonctionner." },
      ],
