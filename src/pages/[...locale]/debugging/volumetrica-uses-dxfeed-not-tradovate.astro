---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "volumetrica-uses-dxfeed-not-tradovate";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/debugging/${SLUG}`;

const META_TITLE = "Volumetrica Uses dxFeed, Not Tradovate Login";
const META_DESCRIPTION =
  "Can't find a Tradovate login in Volumetrica? Sign in with your emailed platform credentials and select the dxFeed feed to get online and trade.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Volumetrica nutzt dxFeed, nicht den Tradovate-Login", es: "Volumetrica usa dxFeed, no el inicio de sesión de Tradovate", fr: "Volumetrica utilise dxFeed, pas la connexion Tradovate", it: "Volumetrica usa dxFeed, non il login Tradovate" },
  dek: { en: "There's no Tradovate sign-in box in Volumetrica because it isn't a Tradovate front-end, it's a dxFeed-powered charting platform with its own login. Here's the credentials to use and the feed you have to select to get online.", de: "In Volumetrica gibt es kein Tradovate-Anmeldefeld, weil es kein Tradovate-Frontend ist, sondern eine dxFeed-basierte Charting-Plattform mit eigenem Login. Hier sind die Zugangsdaten, die Sie verwenden müssen, und der Feed, den Sie auswählen müssen, um online zu gehen.", es: "En Volumetrica no hay ningún cuadro de inicio de sesión de Tradovate porque no es un front-end de Tradovate, sino una plataforma de gráficos basada en dxFeed con su propio acceso. Aquí tiene las credenciales que debe usar y el feed que tiene que seleccionar para conectarse.", fr: "Il n'y a aucun champ de connexion Tradovate dans Volumetrica parce que ce n'est pas une interface Tradovate, mais une plateforme de graphiques alimentée par dxFeed avec sa propre connexion. Voici les identifiants à utiliser et le flux à sélectionner pour vous connecter.", it: "In Volumetrica non c'è alcun campo di accesso Tradovate perché non è un front-end di Tradovate, ma una piattaforma di grafici alimentata da dxFeed con un proprio login. Ecco le credenziali da usare e il feed da selezionare per andare online." },
  readTime: { en: "7 min read", de: "7 Min. Lesezeit", es: "Lectura de 7 min", fr: "Lecture : 7 min", it: "Lettura di 7 min" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "You open Volumetrica expecting the familiar Tradovate sign-in, a box to paste your Tradovate username and password, and it's just not there. No &ldquo;Connect to Tradovate,&rdquo; no Live-vs-Demo toggle, nothing that looks like the login you've used before. That's not a bug, and you weren't handed broken credentials. Volumetrica doesn't log into Tradovate at all. It's a separate order-flow charting and DOM platform that pulls its market data from <strong class='text-white'>dxFeed</strong>, and it signs you in with the <strong class='text-white'>platform credentials your prop firm emailed you</strong>, not your Tradovate details. Once you're in, the one step that actually gets you live is selecting the dxFeed feed named after your firm. Skip that and the platform just sits there with no quotes and no way to trade. Here's why there's no native Tradovate link, which login to use, and the exact click-path that flips the connection indicator from grey to green." },
    {
      type: "checklist",
      heading: "Quick Checklist to Get Volumetrica Trading",
      items: [
        "<strong class='text-white'>There's no Tradovate login here</strong>, Volumetrica is a dxFeed-fed platform, not a Tradovate front-end.",
        "<strong class='text-white'>Log in with the platform credentials your firm emailed you</strong>, not your Tradovate username and password.",
        "<strong class='text-white'>Passwords are case-sensitive</strong>, a pasted first letter that got lowercased is a common failure.",
        "<strong class='text-white'>Select the dxFeed feed named after your firm</strong>, on web, from the connection panel; on desktop, in the Startup Wizard.",
        "<strong class='text-white'>Green indicator = online and ready</strong>, grey means no feed is selected yet.",
        "<strong class='text-white'>No feed selected means no data and no orders</strong>, this is the step people skip.",
        "<strong class='text-white'>Data entitlement is your firm's job</strong>, ask them about Level 2 depth instead of hunting for a Tradovate subscription.",
      ],
    },
    { type: "heading", text: "Why There's No Tradovate Login in Volumetrica" },
    { type: "paragraph", html: "The confusion is understandable. A lot of prop firms run their evaluations on Tradovate, so when they offer Volumetrica as a platform choice, traders assume Volumetrica must plug into Tradovate the way TradingView or NinjaTrader does. It doesn't. Volumetrica is its own environment, a professional volume and footprint charting suite (you'll also see it branded as DeepChart or DeepDOM, with desktop apps named VolSys and VolBook). Its quotes and market depth come from dxFeed, a market-data vendor, not from a Tradovate connection." },
    { type: "paragraph", html: "Because the data provider is dxFeed, the login you use is the one your firm generated for that platform, delivered to you by email. dxFeed acts as the vendor of record for the exchange data, which is why the firm handles the licensing and entitlement instead of asking you to subscribe to anything through Tradovate. So the mental model of &ldquo;log Volumetrica into my Tradovate account&rdquo; simply doesn't map to how the platform works. Once you stop looking for a Tradovate box and start treating this as its own login plus a feed selection, it's a two-minute setup." },
    { type: "heading", text: "Top Reasons You're Stuck at the Login or a Blank Feed" },
    { type: "heading", text: "1. You're hunting for a Tradovate login that doesn't exist" },
    { type: "paragraph", html: "This is the root of it. You scan the login screen for a Tradovate option, an environment toggle, or a &ldquo;link account&rdquo; flow, and there isn't one. Volumetrica authenticates you directly with its own platform credentials. There's no step where Tradovate comes into the picture." },
    { type: "heading", text: "2. You typed Tradovate credentials instead of the emailed platform login" },
    { type: "paragraph", html: "Even once you accept there's no Tradovate button, it's easy to reflexively enter your Tradovate email and password. Those won't match. The login you need is the platform username and password your firm sent by email when your Volumetrica access was provisioned, usually reachable from your firm dashboard under a Platforms section." },
    { type: "heading", text: "3. The password's case got mangled on paste" },
    { type: "paragraph", html: "These platform passwords are auto-generated and case-sensitive. Copy and paste can quietly lowercase the first character or append a trailing space, and that reads as a wrong password. It looks identical to &ldquo;my login is broken,&rdquo; so rule it out by re-typing the password by hand." },
    { type: "heading", text: "4. You logged in but never selected the dxFeed feed" },
    { type: "paragraph", html: "This is the big one. Logging in gets you into the platform, but you're not connected to any market data until you pick a feed. Land on the dashboard, see empty charts and a grey indicator, and it feels like the platform is dead, when really you just haven't chosen the dxFeed connection yet. Nothing streams and no orders go through until you do." },
    { type: "heading", text: "5. You skipped the platform or data agreements" },
    { type: "paragraph", html: "The first time in, you're usually asked to sign the platform and market-data agreements before the feed will connect. Blow past that and the connection can refuse to come up. If the feed won't turn green no matter what you click, check whether there's an outstanding agreement waiting on your acceptance." },
    { type: "heading", text: "6. The desktop Startup Wizard has the wrong Feed source or server" },
    { type: "paragraph", html: "On the desktop apps (VolSys and VolBook), a Startup Wizard walks you through the connection. If you pick the wrong Feed source or the wrong server, it won't connect. You want <strong class='text-white'>dxFeed</strong> as the feed and your firm's server option, then your emailed credentials." },
    { type: "heading", text: "How to Get Volumetrica Online: Step-by-Step" },
    { type: "heading", text: "Fix 1: Log In with Your Emailed Platform Credentials" },
    {
      type: "steps",
      items: [
        { title: "Open your prop firm dashboard", html: "Open your prop firm dashboard and find the <strong class='text-white'>Platforms</strong> area, then click the link that opens Volumetrica (it may be labelled Volumetrica, DeepChart, DeepDOM, or the web platform)." },
        { title: "Enter the emailed platform credentials", html: "At the prompt, enter the <strong class='text-white'>platform username and password your firm emailed you</strong>, not your Tradovate login." },
        { title: "Check the password's case", html: "Check the first character of the password wasn't auto-lowercased and there's no trailing space. If in doubt, type it by hand." },
        { title: "Accept the agreements", html: "Accept any platform or market-data agreements you're shown so the feed can connect." },
      ],
    },
    { type: "heading", text: "Fix 2: On the Web Platform, Select the dxFeed Feed" },
    {
      type: "steps",
      items: [
        { title: "Open the connection panel", html: "Once you're in, open the connection panel, look for a &ldquo;Web Platform&rdquo; entry in the left menu or a connect/feed control on the access panel." },
        { title: "Select your firm's dxFeed feed", html: "Click to connect to the data feed, then <strong class='text-white'>select the dxFeed feed named after your firm</strong> (it usually carries your firm's name or an abbreviation of it)." },
        { title: "Confirm the connection", html: "Confirm the connection. The indicator should turn <strong class='text-white'>green</strong>, signalling you're online and ready to trade." },
      ],
    },
    { type: "heading", text: "Fix 3: On the Desktop App, Set dxFeed and Your Firm's Server in the Startup Wizard" },
    {
      type: "steps",
      items: [
        { title: "Install the desktop platform", html: "Download and install the desktop platform (VolSys or VolBook) from the dxFeed dashboard, then launch it." },
        { title: "Select your entitled exchanges", html: "In the <strong class='text-white'>Startup Wizard</strong>, select the exchanges you're entitled to (commonly CME, COMEX, CBOT, and NYMEX, confirm what your firm covers)." },
        { title: "Choose dxFeed and your firm's server", html: "Choose <strong class='text-white'>dxFeed</strong> as the Feed source and your firm's server option (often shown as a &ldquo;Propfirm&rdquo; server), then enter your emailed credentials." },
        { title: "Pick your firm's feed on the dashboard", html: "On the dashboard, use the connection selector to pick your firm's feed. A <strong class='text-white'>green dot</strong> confirms the connection." },
      ],
    },
    { type: "heading", text: "Fix 4: Confirm the Green Indicator and Load a Symbol" },
    {
      type: "steps",
      items: [
        { title: "Verify the indicator is green", html: "Verify the connection indicator is <strong class='text-white'>green</strong> before you do anything else. Grey or red means the feed still isn't connected." },
        { title: "Open the symbol box and enter the instrument", html: "Open the symbol box (near the timeframe controls) and enter the instrument, type the first couple of letters of its root, for example NQ for the E-mini Nasdaq or CL for crude oil, and pick the continuous or front-month contract." },
        { title: "Set your timeframe and apply it", html: "Set your timeframe and apply it. If quotes and candles now stream, you're connected and can trade." },
      ],
    },
    { type: "heading", text: "Fix 5: For Data Entitlement or Level 2 Depth, Go Through Your Firm" },
    {
      type: "steps",
      items: [
        { title: "Check whether your entitlement is enabled", html: "If quotes are missing on a specific product, your entitlement for that exchange may not be enabled. That's controlled by your firm through dxFeed, not by you through Tradovate." },
        { title: "Ask about Level 2 depth", html: "Level 1 data is generally included, while full <strong class='text-white'>Level 2</strong> order-book depth can require a separate request. Rules vary by firm and account size, so check your firm's current terms." },
        { title: "Open a support ticket with your firm", html: "Open a support ticket with your prop firm to enable or fix any missing data, Tradovate can't help here, because your feed isn't a Tradovate feed." },
      ],
    },
    { type: "heading", text: "Troubleshooting Table" },
    {
      type: "table",
      headers: ["What you see", "What it means", "Fix"],
      rows: [
        ["No Tradovate login on the screen", "Volumetrica isn't a Tradovate front-end; it's dxFeed-fed", "Stop looking for a Tradovate box, use your emailed platform credentials"],
        ["\"Invalid\" / login rejected", "You likely entered Tradovate credentials, or the case got mangled", "Use the firm-emailed platform login and re-type the case-sensitive password"],
        ["Logged in, but charts are blank and indicator is grey", "No data feed is selected yet", "Open the connection panel and select the dxFeed feed named after your firm"],
        ["Feed won't turn green", "An agreement is unsigned, or the wrong feed/server is chosen", "Sign the platform/data agreements; on desktop pick dxFeed + your firm's server"],
        ["Some symbols have no quotes", "You're not entitled to that exchange's data", "Ask your firm to enable the exchange or any Level 2 depth"],
        ["Green dot, quotes streaming", "You're connected and ready", "Nothing to fix, load your symbol and timeframe"],
      ],
    },
    { type: "heading", text: "Prevent the Setup Scramble With PickMyTrade" },
    { type: "paragraph", html: "Volumetrica is a charting and execution window; automation is a different job that lives on the account itself. If your evaluation is Tradovate-backed and you want your strategy to fire without you babysitting the platform, that's where an automation layer earns its place. PickMyTrade links your TradingView alerts to the account you authorize and routes the orders there, no matter which window you happen to be watching the market in." },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Alerts to the right account</strong>, connect your Tradovate-backed account once and every TradingView signal routes to it automatically.",
        "<strong class='text-white'>Multi-account sync</strong>, mirror one signal across several evaluations from a single place instead of re-logging into each platform.",
        "<strong class='text-white'>Set-once connection</strong>, a stored connection means you're not re-authenticating a session every time you switch devices or platforms.",
        "<strong class='text-white'>Charting-platform agnostic</strong>, watch the tape in Volumetrica if you like; the automation happens on the account side either way.",
      ],
    },
  ], de: [
    { type: "paragraph",html: "Sie öffnen Volumetrica und erwarten die gewohnte Tradovate-Anmeldung, ein Feld, in das Sie Ihren Tradovate-Benutzernamen und Ihr Passwort einfügen, und es ist einfach nicht da. Kein &ldquo;Mit Tradovate verbinden&rdquo;, kein Live-vs.-Demo-Schalter, nichts, was wie der Login aussieht, den Sie bisher kannten. Das ist kein Fehler, und Sie haben auch keine defekten Zugangsdaten erhalten. Volumetrica meldet sich überhaupt nicht bei Tradovate an. Es ist eine eigenständige Plattform für Orderflow-Charting und DOM, die ihre Marktdaten von <strong class='text-white'>dxFeed</strong> bezieht und Sie mit den <strong class='text-white'>Plattform-Zugangsdaten anmeldet, die Ihre Prop-Firma Ihnen per E-Mail geschickt hat</strong>, nicht mit Ihren Tradovate-Daten. Sobald Sie drin sind, ist der einzige Schritt, der Sie wirklich live bringt, die Auswahl des nach Ihrer Firma benannten dxFeed-Feeds. Lassen Sie ihn aus, und die Plattform steht ohne Kurse und ohne Handelsmöglichkeit still da. Hier erfahren Sie, warum es keine native Tradovate-Verbindung gibt, welchen Login Sie verwenden und welche Klickfolge die Verbindungsanzeige von grau auf grün schaltet." },
    {
      type: "checklist",
      heading: "Kurze Checkliste, um mit Volumetrica handeln zu können",
      items: [
        "<strong class='text-white'>Es gibt hier keinen Tradovate-Login</strong>, Volumetrica ist eine von dxFeed gespeiste Plattform, kein Tradovate-Frontend.",
        "<strong class='text-white'>Melden Sie sich mit den Plattform-Zugangsdaten an, die Ihre Firma Ihnen per E-Mail geschickt hat</strong>, nicht mit Ihrem Tradovate-Benutzernamen und -Passwort.",
        "<strong class='text-white'>Bei Passwörtern wird zwischen Groß- und Kleinschreibung unterschieden</strong>, ein beim Einfügen kleingeschriebener erster Buchstabe ist ein häufiger Fehler.",
        "<strong class='text-white'>Wählen Sie den nach Ihrer Firma benannten dxFeed-Feed</strong>, im Web über das Verbindungspanel, auf dem Desktop im Startup Wizard.",
        "<strong class='text-white'>Grüne Anzeige = online und bereit</strong>, grau bedeutet, dass noch kein Feed ausgewählt ist.",
        "<strong class='text-white'>Kein ausgewählter Feed bedeutet keine Daten und keine Orders</strong>, das ist der Schritt, den die meisten überspringen.",
        "<strong class='text-white'>Die Datenberechtigung ist Sache Ihrer Firma</strong>, fragen Sie dort nach der Level-2-Tiefe, statt nach einem Tradovate-Abonnement zu suchen.",
      ],
    },
    { type: "heading",text: "Warum es in Volumetrica keinen Tradovate-Login gibt" },
    { type: "paragraph",html: "Die Verwirrung ist verständlich. Viele Prop-Firmen führen ihre Evaluierungen auf Tradovate durch, und wenn sie Volumetrica als Plattformoption anbieten, nehmen Trader an, Volumetrica müsse sich wie TradingView oder NinjaTrader an Tradovate anbinden. Das tut es nicht. Volumetrica ist eine eigene Umgebung, eine professionelle Charting-Suite für Volumen und Footprint (Sie sehen sie auch unter den Namen DeepChart oder DeepDOM, mit den Desktop-Apps VolSys und VolBook). Ihre Kurse und die Markttiefe stammen von dxFeed, einem Marktdatenanbieter, nicht aus einer Tradovate-Verbindung." },
    { type: "paragraph",html: "Da der Datenanbieter dxFeed ist, ist der Login, den Sie verwenden, derjenige, den Ihre Firma für diese Plattform erzeugt und Ihnen per E-Mail zugestellt hat. dxFeed fungiert als Anbieter der Börsendaten, weshalb die Firma Lizenzierung und Berechtigung übernimmt, statt Sie ein Abonnement über Tradovate abschließen zu lassen. Die Vorstellung „Volumetrica in mein Tradovate-Konto einloggen“ passt also schlicht nicht zur Funktionsweise der Plattform. Sobald Sie aufhören, nach einem Tradovate-Feld zu suchen, und dies als eigenen Login plus Feed-Auswahl behandeln, ist die Einrichtung in zwei Minuten erledigt." },
    { type: "heading",text: "Die häufigsten Gründe, warum Sie beim Login oder bei einem leeren Feed hängen" },
    { type: "heading",text: "1. Sie suchen einen Tradovate-Login, den es nicht gibt" },
    { type: "paragraph",html: "Das ist die Wurzel des Problems. Sie durchsuchen den Anmeldebildschirm nach einer Tradovate-Option, einem Umgebungsschalter oder einem Ablauf „Konto verknüpfen“, und es gibt keinen. Volumetrica authentifiziert Sie direkt mit eigenen Plattform-Zugangsdaten. Es gibt keinen Schritt, in dem Tradovate ins Spiel kommt." },
    { type: "heading",text: "2. Sie haben Tradovate-Zugangsdaten statt des per E-Mail erhaltenen Plattform-Logins eingegeben" },
    { type: "paragraph",html: "Selbst wenn Sie akzeptieren, dass es keine Tradovate-Schaltfläche gibt, ist es leicht, reflexartig Ihre Tradovate-E-Mail und Ihr Passwort einzugeben. Die passen nicht. Der benötigte Login ist der Plattform-Benutzername samt Passwort, den Ihre Firma Ihnen bei der Bereitstellung Ihres Volumetrica-Zugangs per E-Mail geschickt hat, meist erreichbar über Ihr Firmen-Dashboard unter einem Bereich „Platforms“." },
    { type: "heading",text: "3. Die Groß- und Kleinschreibung des Passworts wurde beim Einfügen verändert" },
    { type: "paragraph",html: "Diese Plattform-Passwörter sind automatisch generiert und unterscheiden zwischen Groß- und Kleinschreibung. Kopieren und Einfügen kann unbemerkt das erste Zeichen kleinschreiben oder ein Leerzeichen anhängen, und das wird als falsches Passwort gewertet. Es sieht genau so aus wie &ldquo;mein Login ist kaputt&rdquo;, schließen Sie es also aus, indem Sie das Passwort von Hand neu eintippen." },
    { type: "heading",text: "4. Sie haben sich angemeldet, aber nie den dxFeed-Feed ausgewählt" },
    { type: "paragraph",html: "Das ist der wichtigste Punkt. Die Anmeldung bringt Sie in die Plattform, aber Sie sind mit keinen Marktdaten verbunden, bis Sie einen Feed wählen. Sie landen im Dashboard, sehen leere Charts und eine graue Anzeige, und es fühlt sich an, als wäre die Plattform tot, dabei haben Sie lediglich die dxFeed-Verbindung noch nicht gewählt. Es werden keine Daten gestreamt und keine Orders ausgeführt, bis Sie das tun." },
    { type: "heading",text: "5. Sie haben die Plattform- oder Datenvereinbarungen übersprungen" },
    { type: "paragraph",html: "Beim ersten Zugang werden Sie in der Regel aufgefordert, die Plattform- und Marktdatenvereinbarungen zu unterzeichnen, bevor der Feed verbunden wird. Wenn Sie das überspringen, kann die Verbindung verweigert werden. Wird der Feed trotz allem nicht grün, prüfen Sie, ob noch eine ausstehende Vereinbarung auf Ihre Zustimmung wartet." },
    { type: "heading",text: "6. Im Startup Wizard des Desktops sind Feed-Quelle oder Server falsch" },
    { type: "paragraph",html: "In den Desktop-Apps (VolSys und VolBook) führt Sie ein Startup Wizard durch die Verbindung. Wählen Sie die falsche Feed-Quelle oder den falschen Server, verbindet sie sich nicht. Sie benötigen <strong class='text-white'>dxFeed</strong> als Feed und die Serveroption Ihrer Firma, anschließend Ihre per E-Mail erhaltenen Zugangsdaten." },
    { type: "heading",text: "So bringen Sie Volumetrica online: Schritt für Schritt" },
    { type: "heading",text: "Lösung 1: Mit den per E-Mail erhaltenen Plattform-Zugangsdaten anmelden" },
    {
      type: "steps",
      items: [
        { title: "Ihr Prop-Firmen-Dashboard öffnen", html: "Öffnen Sie Ihr Prop-Firmen-Dashboard, suchen Sie den Bereich <strong class='text-white'>Platforms</strong> und klicken Sie auf den Link, der Volumetrica öffnet (er kann Volumetrica, DeepChart, DeepDOM oder Web Platform heißen)." },
        { title: "Die per E-Mail erhaltenen Plattform-Zugangsdaten eingeben", html: "Geben Sie bei der Aufforderung den <strong class='text-white'>Plattform-Benutzernamen und das Passwort ein, die Ihre Firma Ihnen per E-Mail geschickt hat</strong>, nicht Ihren Tradovate-Login." },
        { title: "Die Groß- und Kleinschreibung des Passworts prüfen", html: "Prüfen Sie, dass das erste Zeichen des Passworts nicht automatisch kleingeschrieben wurde und kein Leerzeichen angehängt ist. Tippen Sie es im Zweifel von Hand ein." },
        { title: "Die Vereinbarungen akzeptieren", html: "Akzeptieren Sie alle angezeigten Plattform- oder Marktdatenvereinbarungen, damit sich der Feed verbinden kann." },
      ],
    },
    { type: "heading",text: "Lösung 2: In der Webplattform den dxFeed-Feed auswählen" },
    {
      type: "steps",
      items: [
        { title: "Das Verbindungspanel öffnen", html: "Öffnen Sie nach der Anmeldung das Verbindungspanel, suchen Sie im linken Menü einen Eintrag &ldquo;Web Platform&rdquo; oder ein Verbindungs-/Feed-Steuerelement im Zugangspanel." },
        { title: "Den dxFeed-Feed Ihrer Firma auswählen", html: "Klicken Sie, um sich mit dem Datenfeed zu verbinden, und <strong class='text-white'>wählen Sie den nach Ihrer Firma benannten dxFeed-Feed</strong> (er trägt meist den Namen Ihrer Firma oder eine Abkürzung davon)." },
        { title: "Die Verbindung bestätigen", html: "Bestätigen Sie die Verbindung. Die Anzeige sollte <strong class='text-white'>grün</strong> werden und signalisieren, dass Sie online und handelsbereit sind." },
      ],
    },
    { type: "heading",text: "Lösung 3: In der Desktop-App dxFeed und den Server Ihrer Firma im Startup Wizard festlegen" },
    {
      type: "steps",
      items: [
        { title: "Die Desktop-Plattform installieren", html: "Laden Sie die Desktop-Plattform (VolSys oder VolBook) aus dem dxFeed-Dashboard herunter, installieren Sie sie und starten Sie sie." },
        { title: "Ihre berechtigten Börsen auswählen", html: "Wählen Sie im <strong class='text-white'>Startup Wizard</strong> die Börsen aus, für die Sie berechtigt sind (häufig CME, COMEX, CBOT und NYMEX, bestätigen Sie, was Ihre Firma abdeckt)." },
        { title: "dxFeed und den Server Ihrer Firma wählen", html: "Wählen Sie <strong class='text-white'>dxFeed</strong> als Feed-Quelle und die Serveroption Ihrer Firma (oft als „Propfirm“-Server angezeigt) und geben Sie dann Ihre per E-Mail erhaltenen Zugangsdaten ein." },
        { title: "Den Feed Ihrer Firma im Dashboard auswählen", html: "Verwenden Sie im Dashboard die Verbindungsauswahl, um den Feed Ihrer Firma zu wählen. Ein <strong class='text-white'>grüner Punkt</strong> bestätigt die Verbindung." },
      ],
    },
    { type: "heading",text: "Lösung 4: Die grüne Anzeige bestätigen und ein Symbol laden" },
    {
      type: "steps",
      items: [
        { title: "Prüfen, ob die Anzeige grün ist", html: "Prüfen Sie, dass die Verbindungsanzeige <strong class='text-white'>grün</strong> ist, bevor Sie etwas anderes tun. Grau oder rot bedeutet, dass der Feed noch nicht verbunden ist." },
        { title: "Das Symbolfeld öffnen und das Instrument eingeben", html: "Öffnen Sie das Symbolfeld (bei den Zeitrahmen-Steuerelementen) und geben Sie das Instrument ein, tippen Sie die ersten Buchstaben des Root-Symbols, zum Beispiel NQ für den E-mini Nasdaq oder CL für Rohöl, und wählen Sie den Continuous- oder Front-Month-Kontrakt." },
        { title: "Zeitrahmen festlegen und anwenden", html: "Legen Sie Ihren Zeitrahmen fest und wenden Sie ihn an. Werden Kurse und Kerzen nun gestreamt, sind Sie verbunden und können handeln." },
      ],
    },
    { type: "heading",text: "Lösung 5: Für Datenberechtigung oder Level-2-Tiefe wenden Sie sich an Ihre Firma" },
    {
      type: "steps",
      items: [
        { title: "Prüfen, ob Ihre Berechtigung aktiviert ist", html: "Fehlen Kurse für ein bestimmtes Produkt, ist Ihre Berechtigung für diese Börse möglicherweise nicht aktiviert. Das wird von Ihrer Firma über dxFeed gesteuert, nicht von Ihnen über Tradovate." },
        { title: "Nach der Level-2-Tiefe fragen", html: "Level-1-Daten sind in der Regel enthalten, während die volle <strong class='text-white'>Level-2</strong>-Orderbuchtiefe eine separate Anfrage erfordern kann. Die Regeln variieren je nach Firma und Kontogröße, prüfen Sie daher die aktuellen Bedingungen Ihrer Firma." },
        { title: "Ein Support-Ticket bei Ihrer Firma eröffnen", html: "Eröffnen Sie ein Support-Ticket bei Ihrer Prop-Firma, um fehlende Daten freischalten oder beheben zu lassen, Tradovate kann hier nicht helfen, weil Ihr Feed kein Tradovate-Feed ist." },
      ],
    },
    { type: "heading",text: "Tabelle zur Fehlerbehebung" },
    { type: "table", headers: ["Was Sie sehen","Was es bedeutet","Lösung"], rows: [
      ["Kein Tradovate-Login auf dem Bildschirm","Volumetrica ist kein Tradovate-Frontend, es wird von dxFeed gespeist","Suchen Sie nicht nach einem Tradovate-Feld, verwenden Sie Ihre per E-Mail erhaltenen Plattform-Zugangsdaten"],
      ["„Invalid“ / Login abgelehnt","Sie haben wahrscheinlich Tradovate-Zugangsdaten eingegeben, oder die Schreibung wurde verändert","Verwenden Sie den von der Firma per E-Mail geschickten Plattform-Login und tippen Sie das Passwort (Groß-/Kleinschreibung beachten) neu ein"],
      ["Angemeldet, aber Charts sind leer und die Anzeige ist grau","Es wurde noch kein Datenfeed ausgewählt","Öffnen Sie das Verbindungspanel und wählen Sie den nach Ihrer Firma benannten dxFeed-Feed"],
      ["Feed wird nicht grün","Eine Vereinbarung ist nicht unterzeichnet, oder es wurde der falsche Feed/Server gewählt","Plattform-/Datenvereinbarungen unterzeichnen, auf dem Desktop dxFeed + den Server Ihrer Firma wählen"],
      ["Einige Symbole haben keine Kurse","Sie sind für die Daten dieser Börse nicht berechtigt","Bitten Sie Ihre Firma, die Börse oder die Level-2-Tiefe freizuschalten"],
      ["Grüner Punkt, Kurse werden gestreamt","Sie sind verbunden und bereit","Nichts zu beheben, laden Sie Ihr Symbol und Ihren Zeitrahmen"],
    ] },
    { type: "heading",text: "Vermeiden Sie das Setup-Chaos mit PickMyTrade" },
    { type: "paragraph",html: "Volumetrica ist ein Chart- und Ausführungsfenster, die Automatisierung ist eine andere Aufgabe, die auf dem Konto selbst liegt. Ist Ihre Evaluierung Tradovate-gestützt und soll Ihre Strategie ohne Ihre ständige Überwachung der Plattform auslösen, ist das der Punkt, an dem sich eine Automatisierungsschicht lohnt. PickMyTrade verknüpft Ihre TradingView-Alarme mit dem von Ihnen autorisierten Konto und leitet die Orders dorthin weiter, egal in welchem Fenster Sie gerade den Markt beobachten." },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Alarme an das richtige Konto</strong>, verbinden Sie Ihr Tradovate-gestütztes Konto einmal, und jedes TradingView-Signal wird automatisch dorthin geleitet.",
        "<strong class='text-white'>Multi-Account Sync</strong>, spiegeln Sie ein Signal von einem Ort aus auf mehrere Evaluierungen, statt sich bei jeder Plattform erneut anzumelden.",
        "<strong class='text-white'>Einmal einrichten</strong>, eine gespeicherte Verbindung bedeutet, dass Sie sich nicht bei jedem Geräte- oder Plattformwechsel neu authentifizieren müssen.",
        "<strong class='text-white'>Unabhängig von der Charting-Plattform</strong>, beobachten Sie das Tape gern in Volumetrica, die Automatisierung läuft in jedem Fall auf der Kontoseite.",
      ],
    },
  ], es: [
    { type: "paragraph",html: "Abre Volumetrica esperando el conocido inicio de sesión de Tradovate, un cuadro donde pegar su usuario y contraseña de Tradovate, y simplemente no está. No hay &ldquo;Conectar con Tradovate&rdquo;, ni interruptor Live/Demo, nada que se parezca al acceso que ha usado antes. No es un error, ni le dieron credenciales defectuosas. Volumetrica no inicia sesión en Tradovate en absoluto. Es una plataforma independiente de gráficos de order flow y DOM que obtiene sus datos de mercado de <strong class='text-white'>dxFeed</strong> y le hace iniciar sesión con las <strong class='text-white'>credenciales de plataforma que su prop firm le envió por correo</strong>, no con sus datos de Tradovate. Una vez dentro, el único paso que realmente le pone en vivo es seleccionar el feed de dxFeed con el nombre de su firma. Si lo omite, la plataforma se queda ahí sin cotizaciones y sin posibilidad de operar. Aquí verá por qué no existe un enlace nativo con Tradovate, qué acceso usar y la secuencia exacta de clics que cambia el indicador de conexión de gris a verde." },
    {
      type: "checklist",
      heading: "Lista rápida para empezar a operar en Volumetrica",
      items: [
        "<strong class='text-white'>Aquí no hay inicio de sesión de Tradovate</strong>, Volumetrica es una plataforma alimentada por dxFeed, no un front-end de Tradovate.",
        "<strong class='text-white'>Inicie sesión con las credenciales de plataforma que su firma le envió por correo</strong>, no con su usuario y contraseña de Tradovate.",
        "<strong class='text-white'>Las contraseñas distinguen mayúsculas y minúsculas</strong>, una primera letra pegada que quedó en minúscula es un fallo habitual.",
        "<strong class='text-white'>Seleccione el feed de dxFeed con el nombre de su firma</strong>, en la web, desde el panel de conexión; en escritorio, en el Startup Wizard.",
        "<strong class='text-white'>Indicador verde = en línea y listo</strong>, gris significa que aún no se ha seleccionado ningún feed.",
        "<strong class='text-white'>Sin feed seleccionado no hay datos ni órdenes</strong>, este es el paso que la gente omite.",
        "<strong class='text-white'>La autorización de datos es tarea de su firma</strong>, pregúnteles por la profundidad de Nivel 2 en lugar de buscar una suscripción de Tradovate.",
      ],
    },
    { type: "heading",text: "Por qué no hay inicio de sesión de Tradovate en Volumetrica" },
    { type: "paragraph",html: "La confusión es comprensible. Muchas prop firms ejecutan sus evaluaciones en Tradovate, así que cuando ofrecen Volumetrica como opción de plataforma, los traders suponen que Volumetrica debe conectarse a Tradovate como lo hacen TradingView o NinjaTrader. No es así. Volumetrica es su propio entorno, una suite profesional de gráficos de volumen y footprint (también la verá con la marca DeepChart o DeepDOM, con aplicaciones de escritorio llamadas VolSys y VolBook). Sus cotizaciones y la profundidad de mercado proceden de dxFeed, un proveedor de datos de mercado, no de una conexión con Tradovate." },
    { type: "paragraph",html: "Como el proveedor de datos es dxFeed, el acceso que usa es el que su firma generó para esa plataforma y le entregó por correo. dxFeed actúa como proveedor oficial de los datos de la bolsa, por eso la firma gestiona la licencia y la autorización en lugar de pedirle que se suscriba a nada a través de Tradovate. Así que el modelo mental de «iniciar sesión en Volumetrica con mi cuenta de Tradovate» simplemente no encaja con el funcionamiento de la plataforma. En cuanto deja de buscar un cuadro de Tradovate y lo trata como un acceso propio más la selección de un feed, la configuración lleva dos minutos." },
    { type: "heading",text: "Principales motivos por los que se queda atascado en el acceso o con un feed vacío" },
    { type: "heading",text: "1. Busca un inicio de sesión de Tradovate que no existe" },
    { type: "paragraph",html: "Esta es la raíz del problema. Recorre la pantalla de acceso buscando una opción de Tradovate, un conmutador de entorno o un flujo de &ldquo;vincular cuenta&rdquo;, y no hay ninguno. Volumetrica le autentica directamente con sus propias credenciales de plataforma. No hay ningún paso en el que intervenga Tradovate." },
    { type: "heading",text: "2. Escribió credenciales de Tradovate en lugar del acceso de plataforma recibido por correo" },
    { type: "paragraph",html: "Incluso cuando acepta que no hay botón de Tradovate, es fácil introducir por reflejo su correo y contraseña de Tradovate. No coincidirán. El acceso que necesita es el nombre de usuario y la contraseña de plataforma que su firma le envió por correo cuando se aprovisionó su acceso a Volumetrica, normalmente accesibles desde el panel de su firma en una sección Platforms." },
    { type: "heading",text: "3. Se alteraron las mayúsculas y minúsculas de la contraseña al pegarla" },
    { type: "paragraph",html: "Estas contraseñas de plataforma se generan automáticamente y distinguen mayúsculas y minúsculas. Copiar y pegar puede poner en silencio en minúscula el primer carácter o añadir un espacio al final, y eso se interpreta como contraseña incorrecta. Se ve igual que &ldquo;mi acceso está roto&rdquo;, así que descártelo volviendo a escribir la contraseña a mano." },
    { type: "heading",text: "4. Inició sesión pero nunca seleccionó el feed de dxFeed" },
    { type: "paragraph",html: "Este es el más importante. Iniciar sesión le lleva a la plataforma, pero no está conectado a ningún dato de mercado hasta que elija un feed. Llega al panel, ve gráficos vacíos y un indicador gris, y parece que la plataforma está muerta, cuando en realidad simplemente aún no ha elegido la conexión de dxFeed. No se transmite nada y no pasa ninguna orden hasta que lo haga." },
    { type: "heading",text: "5. Omitió los acuerdos de plataforma o de datos" },
    { type: "paragraph",html: "La primera vez que entra, normalmente se le pide que firme los acuerdos de plataforma y de datos de mercado antes de que el feed se conecte. Si los pasa por alto, la conexión puede negarse a establecerse. Si el feed no se pone verde por más que haga clic, compruebe si hay un acuerdo pendiente de su aceptación." },
    { type: "heading",text: "6. El Startup Wizard de escritorio tiene una fuente de feed o un servidor incorrectos" },
    { type: "paragraph",html: "En las aplicaciones de escritorio (VolSys y VolBook), un Startup Wizard le guía en la conexión. Si elige una fuente de feed o un servidor incorrectos, no se conectará. Necesita <strong class='text-white'>dxFeed</strong> como feed y la opción de servidor de su firma, y luego sus credenciales recibidas por correo." },
    { type: "heading",text: "Cómo poner Volumetrica en línea: paso a paso" },
    { type: "heading",text: "Solución 1: inicie sesión con las credenciales de plataforma recibidas por correo" },
    {
      type: "steps",
      items: [
        { title: "Abra el panel de su prop firm", html: "Abra el panel de su prop firm y busque el área <strong class='text-white'>Platforms</strong>; después haga clic en el enlace que abre Volumetrica (puede llamarse Volumetrica, DeepChart, DeepDOM o la plataforma web)." },
        { title: "Introduzca las credenciales de plataforma recibidas por correo", html: "Cuando se le solicite, introduzca el <strong class='text-white'>nombre de usuario y la contraseña de plataforma que su firma le envió por correo</strong>, no su acceso de Tradovate." },
        { title: "Compruebe las mayúsculas y minúsculas de la contraseña", html: "Compruebe que el primer carácter de la contraseña no se haya puesto en minúscula automáticamente y que no haya un espacio al final. Si tiene dudas, escríbala a mano." },
        { title: "Acepte los acuerdos", html: "Acepte los acuerdos de plataforma o de datos de mercado que se le muestren para que el feed pueda conectarse." },
      ],
    },
    { type: "heading",text: "Solución 2: en la plataforma web, seleccione el feed de dxFeed" },
    {
      type: "steps",
      items: [
        { title: "Abra el panel de conexión", html: "Una vez dentro, abra el panel de conexión, busque una entrada &ldquo;Web Platform&rdquo; en el menú izquierdo o un control de conexión/feed en el panel de acceso." },
        { title: "Seleccione el feed de dxFeed de su firma", html: "Haga clic para conectarse al feed de datos y <strong class='text-white'>seleccione el feed de dxFeed con el nombre de su firma</strong> (normalmente lleva el nombre de su firma o una abreviatura)." },
        { title: "Confirme la conexión", html: "Confirme la conexión. El indicador debería ponerse <strong class='text-white'>verde</strong>, señal de que está en línea y listo para operar." },
      ],
    },
    { type: "heading",text: "Solución 3: en la aplicación de escritorio, configure dxFeed y el servidor de su firma en el Startup Wizard" },
    {
      type: "steps",
      items: [
        { title: "Instale la plataforma de escritorio", html: "Descargue e instale la plataforma de escritorio (VolSys o VolBook) desde el panel de dxFeed y ejecútela." },
        { title: "Seleccione las bolsas a las que tiene derecho", html: "En el <strong class='text-white'>Startup Wizard</strong>, seleccione las bolsas a las que tiene acceso (habitualmente CME, COMEX, CBOT y NYMEX; confirme qué cubre su firma)." },
        { title: "Elija dxFeed y el servidor de su firma", html: "Elija <strong class='text-white'>dxFeed</strong> como fuente de feed y la opción de servidor de su firma (a menudo mostrada como servidor «Propfirm»), y después introduzca sus credenciales recibidas por correo." },
        { title: "Elija el feed de su firma en el panel", html: "En el panel, use el selector de conexión para elegir el feed de su firma. Un <strong class='text-white'>punto verde</strong> confirma la conexión." },
      ],
    },
    { type: "heading",text: "Solución 4: confirme el indicador verde y cargue un símbolo" },
    {
      type: "steps",
      items: [
        { title: "Verifique que el indicador esté verde", html: "Verifique que el indicador de conexión esté <strong class='text-white'>verde</strong> antes de hacer cualquier otra cosa. Gris o rojo significa que el feed todavía no está conectado." },
        { title: "Abra el cuadro de símbolo e introduzca el instrumento", html: "Abra el cuadro de símbolo (junto a los controles del marco temporal) e introduzca el instrumento, escriba las primeras letras de su raíz, por ejemplo NQ para el E-mini Nasdaq o CL para el petróleo crudo, y elija el contrato continuo o del mes frontal." },
        { title: "Configure el marco temporal y aplíquelo", html: "Configure su marco temporal y aplíquelo. Si ahora se transmiten cotizaciones y velas, está conectado y puede operar." },
      ],
    },
    { type: "heading",text: "Solución 5: para la autorización de datos o la profundidad de Nivel 2, acuda a su firma" },
    {
      type: "steps",
      items: [
        { title: "Compruebe si su autorización está habilitada", html: "Si faltan cotizaciones en un producto concreto, puede que su autorización para esa bolsa no esté habilitada. Eso lo controla su firma a través de dxFeed, no usted a través de Tradovate." },
        { title: "Pregunte por la profundidad de Nivel 2", html: "Los datos de Nivel 1 suelen estar incluidos, mientras que la profundidad completa del libro de órdenes de <strong class='text-white'>Nivel 2</strong> puede requerir una solicitud aparte. Las reglas varían según la firma y el tamaño de la cuenta, así que consulte los términos vigentes de su firma." },
        { title: "Abra un ticket de soporte con su firma", html: "Abra un ticket de soporte con su prop firm para habilitar o corregir cualquier dato que falte, Tradovate no puede ayudar aquí, porque su feed no es un feed de Tradovate." },
      ],
    },
    { type: "heading",text: "Tabla de solución de problemas" },
    { type: "table", headers: ["Lo que ve","Qué significa","Solución"], rows: [
      ["No hay inicio de sesión de Tradovate en pantalla","Volumetrica no es un front-end de Tradovate; se alimenta de dxFeed","Deje de buscar un cuadro de Tradovate, use sus credenciales de plataforma recibidas por correo"],
      ["«Invalid» / inicio de sesión rechazado","Probablemente introdujo credenciales de Tradovate, o se alteraron las mayúsculas y minúsculas","Use el acceso de plataforma enviado por la firma y vuelva a escribir la contraseña, que distingue mayúsculas y minúsculas"],
      ["Sesión iniciada, pero los gráficos están en blanco y el indicador está gris","Todavía no se ha seleccionado ningún feed de datos","Abra el panel de conexión y seleccione el feed de dxFeed con el nombre de su firma"],
      ["El feed no se pone verde","Hay un acuerdo sin firmar, o se eligió un feed/servidor incorrecto","Firme los acuerdos de plataforma/datos; en escritorio elija dxFeed + el servidor de su firma"],
      ["Algunos símbolos no tienen cotizaciones","No tiene autorización para los datos de esa bolsa","Pida a su firma que habilite la bolsa o la profundidad de Nivel 2"],
      ["Punto verde, cotizaciones en tiempo real","Está conectado y listo","Nada que arreglar, cargue su símbolo y su marco temporal"],
    ] },
    { type: "heading",text: "Evite el lío de configuración con PickMyTrade" },
    { type: "paragraph",html: "Volumetrica es una ventana de gráficos y ejecución; la automatización es otro trabajo que reside en la propia cuenta. Si su evaluación está respaldada por Tradovate y quiere que su estrategia se dispare sin tener que vigilar la plataforma, ahí es donde una capa de automatización se gana su lugar. PickMyTrade vincula sus alertas de TradingView con la cuenta que usted autoriza y enruta las órdenes allí, sin importar en qué ventana esté observando el mercado." },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Alertas a la cuenta correcta</strong>, conecte su cuenta respaldada por Tradovate una vez y cada señal de TradingView se enruta a ella automáticamente.",
        "<strong class='text-white'>Multi-Account Sync</strong>, replique una señal en varias evaluaciones desde un solo lugar en vez de volver a iniciar sesión en cada plataforma.",
        "<strong class='text-white'>Conexión de una sola vez</strong>, una conexión almacenada significa que no tiene que volver a autenticar una sesión cada vez que cambia de dispositivo o de plataforma.",
        "<strong class='text-white'>Independiente de la plataforma de gráficos</strong>, observe el tape en Volumetrica si lo prefiere; la automatización ocurre en el lado de la cuenta de todos modos.",
      ],
    },
  ], fr: [
    { type: "paragraph",html: "Vous ouvrez Volumetrica en vous attendant à la connexion Tradovate habituelle, un champ où coller votre nom d'utilisateur et votre mot de passe Tradovate, et elle n'est tout simplement pas là. Pas de &ldquo;Se connecter à Tradovate&rdquo;, pas de bascule Live/Demo, rien qui ressemble à la connexion que vous avez déjà utilisée. Ce n'est pas un bug, et on ne vous a pas donné d'identifiants défectueux. Volumetrica ne se connecte pas du tout à Tradovate. C'est une plateforme distincte de graphiques d'order flow et de DOM qui tire ses données de marché de <strong class='text-white'>dxFeed</strong> et vous connecte avec les <strong class='text-white'>identifiants de plateforme que votre prop firm vous a envoyés par e-mail</strong>, et non avec vos informations Tradovate. Une fois connecté, la seule étape qui vous met réellement en direct est la sélection du flux dxFeed portant le nom de votre firme. Sautez-la et la plateforme reste là, sans cotations et sans moyen de trader. Voici pourquoi il n'existe aucun lien natif avec Tradovate, quelle connexion utiliser et le parcours de clics exact qui fait passer l'indicateur de connexion du gris au vert." },
    {
      type: "checklist",
      heading: "Liste de contrôle rapide pour trader sur Volumetrica",
      items: [
        "<strong class='text-white'>Il n'y a pas de connexion Tradovate ici</strong>, Volumetrica est une plateforme alimentée par dxFeed, pas une interface Tradovate.",
        "<strong class='text-white'>Connectez-vous avec les identifiants de plateforme que votre firme vous a envoyés par e-mail</strong>, pas avec votre nom d'utilisateur et mot de passe Tradovate.",
        "<strong class='text-white'>Les mots de passe sont sensibles à la casse</strong>, une première lettre collée qui est passée en minuscule est une cause d'échec courante.",
        "<strong class='text-white'>Sélectionnez le flux dxFeed portant le nom de votre firme</strong>, sur le web, depuis le panneau de connexion ; sur le bureau, dans le Startup Wizard.",
        "<strong class='text-white'>Indicateur vert = en ligne et prêt</strong>, gris signifie qu'aucun flux n'est encore sélectionné.",
        "<strong class='text-white'>Aucun flux sélectionné signifie aucune donnée et aucun ordre</strong>, c'est l'étape que tout le monde saute.",
        "<strong class='text-white'>L'autorisation des données est l'affaire de votre firme</strong>, interrogez-la sur la profondeur de niveau 2 au lieu de chercher un abonnement Tradovate.",
      ],
    },
    { type: "heading",text: "Pourquoi il n'y a pas de connexion Tradovate dans Volumetrica" },
    { type: "paragraph",html: "La confusion est compréhensible. De nombreuses prop firms exécutent leurs évaluations sur Tradovate ; quand elles proposent Volumetrica comme choix de plateforme, les traders supposent que Volumetrica doit se brancher sur Tradovate comme le font TradingView ou NinjaTrader. Ce n'est pas le cas. Volumetrica est son propre environnement, une suite professionnelle de graphiques de volume et de footprint (vous la verrez aussi sous la marque DeepChart ou DeepDOM, avec des applications de bureau nommées VolSys et VolBook). Ses cotations et sa profondeur de marché proviennent de dxFeed, un fournisseur de données de marché, et non d'une connexion Tradovate." },
    { type: "paragraph",html: "Comme le fournisseur de données est dxFeed, la connexion que vous utilisez est celle que votre firme a générée pour cette plateforme et vous a envoyée par e-mail. dxFeed agit comme fournisseur officiel des données de bourse, ce qui explique pourquoi la firme gère les licences et les autorisations au lieu de vous demander de vous abonner à quoi que ce soit via Tradovate. Le modèle mental « connecter Volumetrica à mon compte Tradovate » ne correspond donc tout simplement pas au fonctionnement de la plateforme. Dès que vous cessez de chercher un champ Tradovate et que vous la traitez comme une connexion propre plus une sélection de flux, la configuration prend deux minutes." },
    { type: "heading",text: "Principales raisons pour lesquelles vous restez bloqué à la connexion ou devant un flux vide" },
    { type: "heading",text: "1. Vous cherchez une connexion Tradovate qui n'existe pas" },
    { type: "paragraph",html: "C'est la racine du problème. Vous parcourez l'écran de connexion à la recherche d'une option Tradovate, d'un sélecteur d'environnement ou d'un parcours &ldquo;lier le compte&rdquo;, et il n'y en a pas. Volumetrica vous authentifie directement avec ses propres identifiants de plateforme. Il n'y a aucune étape où Tradovate intervient." },
    { type: "heading",text: "2. Vous avez saisi des identifiants Tradovate au lieu de la connexion de plateforme reçue par e-mail" },
    { type: "paragraph",html: "Même une fois que vous avez accepté qu'il n'y a pas de bouton Tradovate, il est facile de saisir par réflexe votre e-mail et votre mot de passe Tradovate. Ils ne correspondront pas. La connexion dont vous avez besoin est le nom d'utilisateur et le mot de passe de plateforme que votre firme vous a envoyés par e-mail lors de l'attribution de votre accès à Volumetrica, généralement accessibles depuis le tableau de bord de votre firme dans une section Platforms." },
    { type: "heading",text: "3. La casse du mot de passe a été altérée au collage" },
    { type: "paragraph",html: "Ces mots de passe de plateforme sont générés automatiquement et sensibles à la casse. Le copier-coller peut mettre discrètement en minuscule le premier caractère ou ajouter un espace final, et cela est lu comme un mauvais mot de passe. Cela ressemble exactement à &ldquo;ma connexion est cassée&rdquo;, éliminez donc cette cause en ressaisissant le mot de passe à la main." },
    { type: "heading",text: "4. Vous êtes connecté mais n'avez jamais sélectionné le flux dxFeed" },
    { type: "paragraph",html: "C'est le point principal. La connexion vous fait entrer dans la plateforme, mais vous n'êtes relié à aucune donnée de marché tant que vous n'avez pas choisi un flux. Vous arrivez sur le tableau de bord, voyez des graphiques vides et un indicateur gris, et la plateforme semble morte, alors que vous n'avez simplement pas encore choisi la connexion dxFeed. Rien n'est diffusé et aucun ordre ne passe tant que vous ne l'avez pas fait." },
    { type: "heading",text: "5. Vous avez sauté les accords de plateforme ou de données" },
    { type: "paragraph",html: "Lors de la première connexion, on vous demande généralement de signer les accords de plateforme et de données de marché avant que le flux ne se connecte. Si vous passez outre, la connexion peut refuser de s'établir. Si le flux ne passe pas au vert quoi que vous cliquiez, vérifiez s'il y a un accord en attente de votre acceptation." },
    { type: "heading",text: "6. Le Startup Wizard du bureau a la mauvaise source de flux ou le mauvais serveur" },
    { type: "paragraph",html: "Sur les applications de bureau (VolSys et VolBook), un Startup Wizard vous guide dans la connexion. Si vous choisissez la mauvaise source de flux ou le mauvais serveur, elle ne se connectera pas. Il vous faut <strong class='text-white'>dxFeed</strong> comme flux et l'option de serveur de votre firme, puis vos identifiants reçus par e-mail." },
    { type: "heading",text: "Comment mettre Volumetrica en ligne : pas à pas" },
    { type: "heading",text: "Solution 1 : se connecter avec les identifiants de plateforme reçus par e-mail" },
    {
      type: "steps",
      items: [
        { title: "Ouvrez le tableau de bord de votre prop firm", html: "Ouvrez le tableau de bord de votre prop firm et repérez la zone <strong class='text-white'>Platforms</strong>, puis cliquez sur le lien qui ouvre Volumetrica (il peut s'appeler Volumetrica, DeepChart, DeepDOM ou la plateforme web)." },
        { title: "Saisissez les identifiants de plateforme reçus par e-mail", html: "À l'invite, saisissez le <strong class='text-white'>nom d'utilisateur et le mot de passe de plateforme que votre firme vous a envoyés par e-mail</strong>, et non votre connexion Tradovate." },
        { title: "Vérifiez la casse du mot de passe", html: "Vérifiez que le premier caractère du mot de passe n'a pas été automatiquement mis en minuscule et qu'il n'y a pas d'espace final. En cas de doute, saisissez-le à la main." },
        { title: "Acceptez les accords", html: "Acceptez les accords de plateforme ou de données de marché qui vous sont présentés afin que le flux puisse se connecter." },
      ],
    },
    { type: "heading",text: "Solution 2 : sur la plateforme web, sélectionner le flux dxFeed" },
    {
      type: "steps",
      items: [
        { title: "Ouvrez le panneau de connexion", html: "Une fois connecté, ouvrez le panneau de connexion, cherchez une entrée &ldquo;Web Platform&rdquo; dans le menu de gauche ou un contrôle de connexion/flux dans le panneau d'accès." },
        { title: "Sélectionnez le flux dxFeed de votre firme", html: "Cliquez pour vous connecter au flux de données, puis <strong class='text-white'>sélectionnez le flux dxFeed portant le nom de votre firme</strong> (il porte généralement le nom de votre firme ou une abréviation)." },
        { title: "Confirmez la connexion", html: "Confirmez la connexion. L'indicateur devrait passer au <strong class='text-white'>vert</strong>, signe que vous êtes en ligne et prêt à trader." },
      ],
    },
    { type: "heading",text: "Solution 3 : sur l'application de bureau, définir dxFeed et le serveur de votre firme dans le Startup Wizard" },
    {
      type: "steps",
      items: [
        { title: "Installez la plateforme de bureau", html: "Téléchargez et installez la plateforme de bureau (VolSys ou VolBook) depuis le tableau de bord dxFeed, puis lancez-la." },
        { title: "Sélectionnez les places boursières auxquelles vous avez droit", html: "Dans le <strong class='text-white'>Startup Wizard</strong>, sélectionnez les places boursières auxquelles vous avez droit (généralement CME, COMEX, CBOT et NYMEX ; confirmez ce que couvre votre firme)." },
        { title: "Choisissez dxFeed et le serveur de votre firme", html: "Choisissez <strong class='text-white'>dxFeed</strong> comme source de flux et l'option de serveur de votre firme (souvent affichée comme serveur « Propfirm »), puis saisissez vos identifiants reçus par e-mail." },
        { title: "Choisissez le flux de votre firme sur le tableau de bord", html: "Sur le tableau de bord, utilisez le sélecteur de connexion pour choisir le flux de votre firme. Un <strong class='text-white'>point vert</strong> confirme la connexion." },
      ],
    },
    { type: "heading",text: "Solution 4 : confirmer l'indicateur vert et charger un symbole" },
    {
      type: "steps",
      items: [
        { title: "Vérifiez que l'indicateur est vert", html: "Vérifiez que l'indicateur de connexion est <strong class='text-white'>vert</strong> avant de faire quoi que ce soit d'autre. Gris ou rouge signifie que le flux n'est toujours pas connecté." },
        { title: "Ouvrez la zone de symbole et saisissez l'instrument", html: "Ouvrez la zone de symbole (près des commandes d'unité de temps) et saisissez l'instrument, tapez les premières lettres de sa racine, par exemple NQ pour l'E-mini Nasdaq ou CL pour le pétrole brut, puis choisissez le contrat continu ou du mois en cours." },
        { title: "Réglez votre unité de temps et appliquez-la", html: "Réglez votre unité de temps et appliquez-la. Si les cotations et les bougies s'affichent maintenant en continu, vous êtes connecté et pouvez trader." },
      ],
    },
    { type: "heading",text: "Solution 5 : pour l'autorisation des données ou la profondeur de niveau 2, passer par votre firme" },
    {
      type: "steps",
      items: [
        { title: "Vérifiez si votre autorisation est activée", html: "Si des cotations manquent sur un produit précis, votre autorisation pour cette bourse n'est peut-être pas activée. Elle est contrôlée par votre firme via dxFeed, pas par vous via Tradovate." },
        { title: "Renseignez-vous sur la profondeur de niveau 2", html: "Les données de niveau 1 sont généralement incluses, alors que la profondeur complète du carnet d'ordres de <strong class='text-white'>niveau 2</strong> peut nécessiter une demande séparée. Les règles varient selon la firme et la taille du compte ; consultez donc les conditions actuelles de votre firme." },
        { title: "Ouvrez un ticket de support auprès de votre firme", html: "Ouvrez un ticket de support auprès de votre prop firm pour activer ou corriger toute donnée manquante, Tradovate ne peut pas vous aider ici, car votre flux n'est pas un flux Tradovate." },
      ],
    },
    { type: "heading",text: "Tableau de dépannage" },
    { type: "table", headers: ["Ce que vous voyez","Ce que cela signifie","Solution"], rows: [
      ["Aucune connexion Tradovate à l'écran","Volumetrica n'est pas une interface Tradovate ; elle est alimentée par dxFeed","Cessez de chercher un champ Tradovate, utilisez vos identifiants de plateforme reçus par e-mail"],
      ["« Invalid » / connexion refusée","Vous avez probablement saisi des identifiants Tradovate, ou la casse a été altérée","Utilisez la connexion de plateforme envoyée par la firme et ressaisissez le mot de passe sensible à la casse"],
      ["Connecté, mais les graphiques sont vides et l'indicateur est gris","Aucun flux de données n'est encore sélectionné","Ouvrez le panneau de connexion et sélectionnez le flux dxFeed portant le nom de votre firme"],
      ["Le flux ne passe pas au vert","Un accord n'est pas signé, ou le mauvais flux/serveur est choisi","Signez les accords de plateforme/données ; sur le bureau, choisissez dxFeed + le serveur de votre firme"],
      ["Certains symboles n'ont pas de cotations","Vous n'êtes pas autorisé aux données de cette bourse","Demandez à votre firme d'activer la bourse ou la profondeur de niveau 2"],
      ["Point vert, cotations en continu","Vous êtes connecté et prêt","Rien à corriger, chargez votre symbole et votre unité de temps"],
    ] },
    { type: "heading",text: "Évitez la course à la configuration avec PickMyTrade" },
    { type: "paragraph",html: "Volumetrica est une fenêtre de graphiques et d'exécution ; l'automatisation est un autre travail, qui se situe sur le compte lui-même. Si votre évaluation est adossée à Tradovate et que vous voulez que votre stratégie se déclenche sans surveiller la plateforme, c'est là qu'une couche d'automatisation prend tout son sens. PickMyTrade relie vos alertes TradingView au compte que vous autorisez et y achemine les ordres, quelle que soit la fenêtre dans laquelle vous observez le marché." },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Des alertes vers le bon compte</strong>, connectez une fois votre compte adossé à Tradovate et chaque signal TradingView y est acheminé automatiquement.",
        "<strong class='text-white'>Multi-Account Sync</strong>, répliquez un signal sur plusieurs évaluations depuis un seul endroit au lieu de vous reconnecter à chaque plateforme.",
        "<strong class='text-white'>Connexion à configurer une seule fois</strong>, une connexion enregistrée signifie que vous n'avez pas à vous réauthentifier à chaque changement d'appareil ou de plateforme.",
        "<strong class='text-white'>Indépendant de la plateforme de graphiques</strong>, suivez le tape dans Volumetrica si vous le souhaitez ; l'automatisation se fait côté compte dans tous les cas.",
      ],
    },
  ], it: [
    { type: "paragraph",html: "Apre Volumetrica aspettandosi il consueto login Tradovate, un campo in cui incollare nome utente e password di Tradovate, e semplicemente non c'è. Nessun &ldquo;Connetti a Tradovate&rdquo;, nessun interruttore Live/Demo, nulla che assomigli all'accesso che ha usato finora. Non è un bug e non le sono state date credenziali difettose. Volumetrica non accede affatto a Tradovate. È una piattaforma separata di grafici order flow e DOM che ricava i dati di mercato da <strong class='text-white'>dxFeed</strong> e le fa accedere con le <strong class='text-white'>credenziali della piattaforma che la sua prop firm le ha inviato via e-mail</strong>, non con i suoi dati Tradovate. Una volta dentro, l'unico passaggio che la porta davvero in diretta è selezionare il feed dxFeed con il nome della sua società. Lo salti e la piattaforma resta lì, senza quotazioni e senza modo di fare trading. Ecco perché non esiste un collegamento nativo con Tradovate, quale login usare e l'esatto percorso di clic che fa passare l'indicatore di connessione da grigio a verde." },
    {
      type: "checklist",
      heading: "Checklist rapida per iniziare a fare trading con Volumetrica",
      items: [
        "<strong class='text-white'>Qui non c'è alcun login Tradovate</strong>, Volumetrica è una piattaforma alimentata da dxFeed, non un front-end di Tradovate.",
        "<strong class='text-white'>Acceda con le credenziali della piattaforma che la sua società le ha inviato via e-mail</strong>, non con nome utente e password Tradovate.",
        "<strong class='text-white'>Le password distinguono tra maiuscole e minuscole</strong>, una prima lettera incollata diventata minuscola è un errore comune.",
        "<strong class='text-white'>Selezioni il feed dxFeed con il nome della sua società</strong>, sul web, dal pannello di connessione; sul desktop, nello Startup Wizard.",
        "<strong class='text-white'>Indicatore verde = online e pronto</strong>, grigio significa che non è ancora stato selezionato alcun feed.",
        "<strong class='text-white'>Nessun feed selezionato significa nessun dato e nessun ordine</strong>, è il passaggio che molti saltano.",
        "<strong class='text-white'>L'autorizzazione ai dati è compito della sua società</strong>, chieda a loro della profondità di Livello 2 invece di cercare un abbonamento Tradovate.",
      ],
    },
    { type: "heading",text: "Perché non c'è un login Tradovate in Volumetrica" },
    { type: "paragraph",html: "La confusione è comprensibile. Molte prop firm eseguono le loro valutazioni su Tradovate, quindi quando propongono Volumetrica come scelta di piattaforma, i trader presumono che Volumetrica debba collegarsi a Tradovate come fanno TradingView o NinjaTrader. Non è così. Volumetrica è un ambiente a sé, una suite professionale di grafici di volume e footprint (la vedrà anche con il marchio DeepChart o DeepDOM, con app desktop chiamate VolSys e VolBook). Le sue quotazioni e la profondità di mercato provengono da dxFeed, un fornitore di dati di mercato, non da una connessione Tradovate." },
    { type: "paragraph",html: "Poiché il fornitore dei dati è dxFeed, il login che usa è quello generato dalla sua società per quella piattaforma e consegnato via e-mail. dxFeed funge da fornitore ufficiale dei dati di borsa, ed è per questo che la società gestisce licenze e autorizzazioni invece di chiederle di abbonarsi a qualcosa tramite Tradovate. Il modello mentale «collegare Volumetrica al mio conto Tradovate» semplicemente non corrisponde al funzionamento della piattaforma. Quando smette di cercare un campo Tradovate e lo tratta come un login a sé più la selezione di un feed, la configurazione richiede due minuti." },
    { type: "heading",text: "Principali motivi per cui resta bloccato al login o davanti a un feed vuoto" },
    { type: "heading",text: "1. Cerca un login Tradovate che non esiste" },
    { type: "paragraph",html: "È la radice del problema. Scorre la schermata di accesso alla ricerca di un'opzione Tradovate, di un interruttore di ambiente o di un flusso &ldquo;collega conto&rdquo;, e non ce n'è nessuno. Volumetrica la autentica direttamente con le proprie credenziali di piattaforma. Non c'è alcun passaggio in cui Tradovate entri in gioco." },
    { type: "heading",text: "2. Ha digitato credenziali Tradovate invece del login della piattaforma ricevuto via e-mail" },
    { type: "paragraph",html: "Anche dopo aver accettato che non esiste un pulsante Tradovate, è facile inserire d'istinto la sua e-mail e password Tradovate. Non corrisponderanno. Il login necessario è il nome utente e la password della piattaforma che la sua società le ha inviato via e-mail quando è stato attivato il suo accesso a Volumetrica, di solito raggiungibili dalla dashboard della società in una sezione Platforms." },
    { type: "heading",text: "3. Le maiuscole e minuscole della password sono state alterate con l'incolla" },
    { type: "paragraph",html: "Queste password della piattaforma sono generate automaticamente e distinguono tra maiuscole e minuscole. Copia e incolla possono trasformare silenziosamente in minuscolo il primo carattere o aggiungere uno spazio finale, e ciò viene letto come password errata. Sembra identico a &ldquo;il mio login non funziona&rdquo;, quindi lo escluda digitando di nuovo la password a mano." },
    { type: "heading",text: "4. Ha effettuato l'accesso ma non ha mai selezionato il feed dxFeed" },
    { type: "paragraph",html: "Questo è il punto principale. L'accesso la porta nella piattaforma, ma non è collegato ad alcun dato di mercato finché non sceglie un feed. Arriva alla dashboard, vede grafici vuoti e un indicatore grigio, e sembra che la piattaforma sia morta, quando in realtà non ha ancora scelto la connessione dxFeed. Nulla viene trasmesso e nessun ordine passa finché non lo fa." },
    { type: "heading",text: "5. Ha saltato gli accordi della piattaforma o dei dati" },
    { type: "paragraph",html: "La prima volta che entra, di solito le viene chiesto di firmare gli accordi della piattaforma e dei dati di mercato prima che il feed si connetta. Se li ignora, la connessione può rifiutarsi di attivarsi. Se il feed non diventa verde qualunque cosa clicchi, controlli se c'è un accordo in sospeso in attesa della sua accettazione." },
    { type: "heading",text: "6. Lo Startup Wizard del desktop ha la sorgente del feed o il server sbagliati" },
    { type: "paragraph",html: "Sulle app desktop (VolSys e VolBook), uno Startup Wizard la guida nella connessione. Se sceglie la sorgente del feed o il server sbagliati, non si connetterà. Le serve <strong class='text-white'>dxFeed</strong> come feed e l'opzione server della sua società, poi le credenziali ricevute via e-mail." },
    { type: "heading",text: "Come portare Volumetrica online: passo dopo passo" },
    { type: "heading",text: "Soluzione 1: accedere con le credenziali della piattaforma ricevute via e-mail" },
    {
      type: "steps",
      items: [
        { title: "Apra la dashboard della sua prop firm", html: "Apra la dashboard della sua prop firm e trovi l'area <strong class='text-white'>Platforms</strong>, quindi clicchi sul link che apre Volumetrica (potrebbe chiamarsi Volumetrica, DeepChart, DeepDOM o piattaforma web)." },
        { title: "Inserisca le credenziali della piattaforma ricevute via e-mail", html: "Quando richiesto, inserisca il <strong class='text-white'>nome utente e la password della piattaforma che la sua società le ha inviato via e-mail</strong>, non il suo login Tradovate." },
        { title: "Controlli le maiuscole e minuscole della password", html: "Controlli che il primo carattere della password non sia stato trasformato automaticamente in minuscolo e che non ci sia uno spazio finale. In caso di dubbio, la digiti a mano." },
        { title: "Accetti gli accordi", html: "Accetti gli eventuali accordi di piattaforma o dei dati di mercato mostrati, in modo che il feed possa connettersi." },
      ],
    },
    { type: "heading",text: "Soluzione 2: sulla piattaforma web, selezionare il feed dxFeed" },
    {
      type: "steps",
      items: [
        { title: "Apra il pannello di connessione", html: "Una volta dentro, apra il pannello di connessione, cerchi una voce &ldquo;Web Platform&rdquo; nel menu a sinistra o un controllo di connessione/feed nel pannello di accesso." },
        { title: "Selezioni il feed dxFeed della sua società", html: "Clicchi per connettersi al feed dati, quindi <strong class='text-white'>selezioni il feed dxFeed con il nome della sua società</strong> (di solito riporta il nome della società o una sua abbreviazione)." },
        { title: "Confermi la connessione", html: "Confermi la connessione. L'indicatore dovrebbe diventare <strong class='text-white'>verde</strong>, segno che è online e pronto a fare trading." },
      ],
    },
    { type: "heading",text: "Soluzione 3: sull'app desktop, impostare dxFeed e il server della sua società nello Startup Wizard" },
    {
      type: "steps",
      items: [
        { title: "Installi la piattaforma desktop", html: "Scarichi e installi la piattaforma desktop (VolSys o VolBook) dalla dashboard di dxFeed, quindi la avvii." },
        { title: "Selezioni le borse a cui ha diritto", html: "Nello <strong class='text-white'>Startup Wizard</strong>, selezioni le borse a cui ha diritto (comunemente CME, COMEX, CBOT e NYMEX, confermi cosa copre la sua società)." },
        { title: "Scelga dxFeed e il server della sua società", html: "Scelga <strong class='text-white'>dxFeed</strong> come sorgente del feed e l'opzione server della sua società (spesso mostrata come server «Propfirm»), quindi inserisca le credenziali ricevute via e-mail." },
        { title: "Scelga il feed della sua società sulla dashboard", html: "Sulla dashboard, usi il selettore di connessione per scegliere il feed della sua società. Un <strong class='text-white'>punto verde</strong> conferma la connessione." },
      ],
    },
    { type: "heading",text: "Soluzione 4: confermare l'indicatore verde e caricare un simbolo" },
    {
      type: "steps",
      items: [
        { title: "Verifichi che l'indicatore sia verde", html: "Verifichi che l'indicatore di connessione sia <strong class='text-white'>verde</strong> prima di fare qualsiasi altra cosa. Grigio o rosso significa che il feed non è ancora connesso." },
        { title: "Apra la casella del simbolo e inserisca lo strumento", html: "Apra la casella del simbolo (vicino ai controlli del timeframe) e inserisca lo strumento, digiti le prime lettere della sua radice, ad esempio NQ per l'E-mini Nasdaq o CL per il petrolio greggio, e scelga il contratto continuo o del mese frontale." },
        { title: "Imposti il timeframe e lo applichi", html: "Imposti il timeframe e lo applichi. Se ora quotazioni e candele scorrono, è connesso e può fare trading." },
      ],
    },
    { type: "heading",text: "Soluzione 5: per l'autorizzazione ai dati o la profondità di Livello 2, passare dalla sua società" },
    {
      type: "steps",
      items: [
        { title: "Verifichi se la sua autorizzazione è abilitata", html: "Se mancano le quotazioni su un prodotto specifico, la sua autorizzazione per quella borsa potrebbe non essere abilitata. Ciò è controllato dalla sua società tramite dxFeed, non da Lei tramite Tradovate." },
        { title: "Chieda della profondità di Livello 2", html: "I dati di Livello 1 sono generalmente inclusi, mentre la profondità completa del book di <strong class='text-white'>Livello 2</strong> può richiedere una richiesta separata. Le regole variano in base alla società e alla dimensione del conto, quindi consulti i termini attuali della sua società." },
        { title: "Apra un ticket di supporto con la sua società", html: "Apra un ticket di supporto con la sua prop firm per abilitare o correggere eventuali dati mancanti, Tradovate non può aiutarla qui, perché il suo feed non è un feed Tradovate." },
      ],
    },
    { type: "heading",text: "Tabella di risoluzione dei problemi" },
    { type: "table", headers: ["Cosa vede","Cosa significa","Soluzione"], rows: [
      ["Nessun login Tradovate sullo schermo","Volumetrica non è un front-end di Tradovate; è alimentata da dxFeed","Smetta di cercare un campo Tradovate, usi le credenziali della piattaforma ricevute via e-mail"],
      ["«Invalid» / login rifiutato","Probabilmente ha inserito credenziali Tradovate, oppure le maiuscole/minuscole sono state alterate","Usi il login della piattaforma inviato dalla società e digiti di nuovo la password, che distingue tra maiuscole e minuscole"],
      ["Accesso effettuato, ma i grafici sono vuoti e l'indicatore è grigio","Non è ancora stato selezionato alcun feed dati","Apra il pannello di connessione e selezioni il feed dxFeed con il nome della sua società"],
      ["Il feed non diventa verde","Un accordo non è firmato, oppure è stato scelto il feed/server sbagliato","Firmi gli accordi di piattaforma/dati; su desktop scelga dxFeed + il server della sua società"],
      ["Alcuni simboli non hanno quotazioni","Non è autorizzato ai dati di quella borsa","Chieda alla sua società di abilitare la borsa o la profondità di Livello 2"],
      ["Punto verde, quotazioni in streaming","È connesso e pronto","Nulla da correggere, carichi il suo simbolo e il timeframe"],
    ] },
    { type: "heading",text: "Eviti la corsa alla configurazione con PickMyTrade" },
    { type: "paragraph",html: "Volumetrica è una finestra di grafici ed esecuzione; l'automazione è un lavoro diverso che vive sul conto stesso. Se la sua valutazione è supportata da Tradovate e vuole che la sua strategia scatti senza dover sorvegliare la piattaforma, è lì che un livello di automazione si guadagna il suo posto. PickMyTrade collega i suoi alert di TradingView al conto che autorizza e vi instrada gli ordini, indipendentemente dalla finestra in cui sta osservando il mercato." },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Alert verso il conto giusto</strong>, colleghi una volta il suo conto supportato da Tradovate e ogni segnale di TradingView viene instradato lì automaticamente.",
        "<strong class='text-white'>Multi-Account Sync</strong>, replichi un segnale su più valutazioni da un unico punto invece di accedere di nuovo a ogni piattaforma.",
        "<strong class='text-white'>Connessione da impostare una sola volta</strong>, una connessione memorizzata significa che non deve riautenticare una sessione ogni volta che cambia dispositivo o piattaforma.",
        "<strong class='text-white'>Indipendente dalla piattaforma di grafici</strong>, osservi pure il tape in Volumetrica; l'automazione avviene comunque lato conto.",
      ],
    },
  ] },
  ctaHeading: { en: "Stop Babysitting the Platform", de: "Schluss mit der Plattform-Überwachung", es: "Deje de vigilar la plataforma", fr: "Arrêtez de surveiller la plateforme", it: "Smetta di sorvegliare la piattaforma" },
  ctaText: { en: "Start your free trial, automate your Tradovate alerts and stop babysitting the platform.", de: "Starten Sie Ihre kostenlose Testphase, automatisieren Sie Ihre Tradovate-Alarme und hören Sie auf, die Plattform zu überwachen.", es: "Comience su prueba gratuita, automatice sus alertas de Tradovate y deje de vigilar la plataforma.", fr: "Commencez votre essai gratuit, automatisez vos alertes Tradovate et arrêtez de surveiller la plateforme.", it: "Inizi la prova gratuita, automatizzi i suoi alert Tradovate e smetta di sorvegliare la piattaforma." },
  ctaButtonText: { en: "Start Your Free 7-Day Trial", de: "Starten Sie Ihre kostenlose 7-Tage-Testphase", es: "Comience su prueba gratuita de 7 días", fr: "Commencez votre essai gratuit de 7 jours", it: "Inizi la prova gratuita di 7 giorni" },
  ctaUrl: "https://app.pickmytrade.trade/?register=true&utm_source=content&utm_medium=debugging",
  faqHeading: { en: "Frequently Asked Questions", de: "Häufig gestellte Fragen", es: "Preguntas frecuentes", fr: "Questions fréquentes", it: "Domande frequenti" },
  faqs: { en: [
    { q: "Why isn't there a Tradovate login option in Volumetrica?", a: "Because Volumetrica doesn't connect to Tradovate. It's a separate order-flow charting and DOM platform that gets its market data from dxFeed, and it signs you in with the platform credentials your prop firm emailed you. There's no place to type Tradovate details, so don't go looking for a \"Connect to Tradovate\" button that doesn't exist." },
    { q: "What credentials do I use to log into Volumetrica?", a: "Use the platform username and password your prop firm sent you by email when your subscription was set up, usually reached from your firm dashboard under Platforms. These are not your Tradovate credentials. The password is case-sensitive, so watch for a lowercased first letter or a stray space when you paste it." },
    { q: "How do I get Volumetrica online after I log in?", a: "You have to select the data feed. On the web platform, open the connection panel and pick the dxFeed feed named after your firm. In the desktop app (VolSys or VolBook), the Startup Wizard asks you to choose dxFeed as the Feed source and your firm's server, then log in. Nothing streams until a feed is selected." },
    { q: "What does the green dot in Volumetrica mean?", a: "The connection indicator turns green once the dxFeed feed is connected, meaning you're online and ready to trade. A grey or red indicator means no feed is selected or the connection hasn't been established yet, so quotes and charts won't load." },
    { q: "My Volumetrica password won't work. What's wrong?", a: "Two things catch most people. First, make sure you're using the emailed platform credentials, not a Tradovate login. Second, the password is case-sensitive and auto-generated, so a pasted first character that got lowercased or a trailing space reads as wrong. Re-type it by hand if you're unsure." },
    { q: "Do I need to buy Tradovate market data for Volumetrica?", a: "No. Volumetrica's data comes through dxFeed, and your prop firm manages that entitlement as part of your platform access. Standard Level 1 data is typically included; full Level 2 order-book depth may need a separate request. Check your firm's current rules and open a ticket with them rather than subscribing to Tradovate data." },
    { q: "Can I still automate a Tradovate-backed account if I chart in Volumetrica?", a: "Automation runs on the account side, not inside the charting window. If your evaluation is Tradovate-backed, an automation layer like PickMyTrade can route your TradingView alerts to that account regardless of whether you watch the market in Volumetrica, Tradovate, or anything else. Confirm your account's supported integration first." },
  ], de: [
    { q: "Warum gibt es in Volumetrica keine Tradovate-Anmeldeoption?", a: "Weil Volumetrica sich nicht mit Tradovate verbindet. Es ist eine eigenständige Plattform für Orderflow-Charting und DOM, die ihre Marktdaten von dxFeed bezieht und Sie mit den Plattform-Zugangsdaten anmeldet, die Ihre Prop-Firma Ihnen per E-Mail geschickt hat. Es gibt keine Stelle, an der Sie Tradovate-Daten eingeben könnten, suchen Sie also nicht nach einer Schaltfläche „Mit Tradovate verbinden“, die es nicht gibt." },
    { q: "Welche Zugangsdaten verwende ich für die Anmeldung bei Volumetrica?", a: "Verwenden Sie den Plattform-Benutzernamen und das Passwort, die Ihre Prop-Firma Ihnen bei der Einrichtung Ihres Abonnements per E-Mail geschickt hat, meist erreichbar über Ihr Firmen-Dashboard unter „Platforms“. Das sind nicht Ihre Tradovate-Zugangsdaten. Beim Passwort wird zwischen Groß- und Kleinschreibung unterschieden, achten Sie also beim Einfügen auf einen kleingeschriebenen ersten Buchstaben oder ein versehentliches Leerzeichen." },
    { q: "Wie bringe ich Volumetrica nach der Anmeldung online?", a: "Sie müssen den Datenfeed auswählen. In der Webplattform öffnen Sie das Verbindungspanel und wählen den nach Ihrer Firma benannten dxFeed-Feed. In der Desktop-App (VolSys oder VolBook) fordert Sie der Startup Wizard auf, dxFeed als Feed-Quelle und den Server Ihrer Firma zu wählen und sich dann anzumelden. Ohne ausgewählten Feed werden keine Daten gestreamt." },
    { q: "Was bedeutet der grüne Punkt in Volumetrica?", a: "Die Verbindungsanzeige wird grün, sobald der dxFeed-Feed verbunden ist, was bedeutet, dass Sie online und handelsbereit sind. Eine graue oder rote Anzeige bedeutet, dass kein Feed ausgewählt ist oder die Verbindung noch nicht hergestellt wurde, sodass Kurse und Charts nicht geladen werden." },
    { q: "Mein Volumetrica-Passwort funktioniert nicht. Was ist los?", a: "Zwei Dinge erwischen die meisten. Erstens: Stellen Sie sicher, dass Sie die per E-Mail erhaltenen Plattform-Zugangsdaten verwenden, nicht einen Tradovate-Login. Zweitens: Das Passwort ist automatisch generiert und unterscheidet zwischen Groß- und Kleinschreibung, sodass ein beim Einfügen kleingeschriebenes erstes Zeichen oder ein angehängtes Leerzeichen als falsch gewertet wird. Tippen Sie es im Zweifel von Hand ein." },
    { q: "Muss ich Tradovate-Marktdaten für Volumetrica kaufen?", a: "Nein. Die Daten von Volumetrica kommen über dxFeed, und Ihre Prop-Firma verwaltet diese Berechtigung als Teil Ihres Plattformzugangs. Standard-Level-1-Daten sind in der Regel enthalten, volle Level-2-Orderbuchtiefe kann eine separate Anfrage erfordern. Prüfen Sie die aktuellen Regeln Ihrer Firma und eröffnen Sie dort ein Ticket, statt Tradovate-Daten zu abonnieren." },
    { q: "Kann ich ein Tradovate-gestütztes Konto weiterhin automatisieren, wenn ich in Volumetrica charte?", a: "Die Automatisierung läuft auf der Kontoseite, nicht im Chartfenster. Ist Ihre Evaluierung Tradovate-gestützt, kann eine Automatisierungsschicht wie PickMyTrade Ihre TradingView-Alarme an dieses Konto weiterleiten, unabhängig davon, ob Sie den Markt in Volumetrica, Tradovate oder sonst wo beobachten. Bestätigen Sie zuerst die unterstützte Integration Ihres Kontos." },
  ], es: [
    { q: "¿Por qué no hay una opción de inicio de sesión de Tradovate en Volumetrica?", a: "Porque Volumetrica no se conecta a Tradovate. Es una plataforma independiente de gráficos de order flow y DOM que obtiene sus datos de mercado de dxFeed y le hace iniciar sesión con las credenciales de plataforma que su prop firm le envió por correo. No hay ningún lugar donde escribir datos de Tradovate, así que no busque un botón «Conectar con Tradovate» que no existe." },
    { q: "¿Qué credenciales uso para iniciar sesión en Volumetrica?", a: "Use el nombre de usuario y la contraseña de plataforma que su prop firm le envió por correo al configurar su suscripción, normalmente accesibles desde el panel de su firma en Platforms. No son sus credenciales de Tradovate. La contraseña distingue entre mayúsculas y minúsculas, así que fíjese en que la primera letra no se haya puesto en minúscula o que no haya un espacio de más al pegarla." },
    { q: "¿Cómo pongo Volumetrica en línea después de iniciar sesión?", a: "Tiene que seleccionar el feed de datos. En la plataforma web, abra el panel de conexión y elija el feed de dxFeed con el nombre de su firma. En la aplicación de escritorio (VolSys o VolBook), el Startup Wizard le pide que elija dxFeed como fuente de feed y el servidor de su firma, y luego inicie sesión. No se transmite nada hasta que se selecciona un feed." },
    { q: "¿Qué significa el punto verde en Volumetrica?", a: "El indicador de conexión se pone verde cuando el feed de dxFeed está conectado, lo que significa que está en línea y listo para operar. Un indicador gris o rojo significa que no hay ningún feed seleccionado o que la conexión aún no se ha establecido, por lo que las cotizaciones y los gráficos no cargarán." },
    { q: "Mi contraseña de Volumetrica no funciona. ¿Qué pasa?", a: "Dos cosas afectan a la mayoría de las personas. Primero, asegúrese de usar las credenciales de plataforma recibidas por correo, no un inicio de sesión de Tradovate. Segundo, la contraseña distingue mayúsculas y minúsculas y se genera automáticamente, por lo que un primer carácter pegado que quedó en minúscula o un espacio al final se interpreta como incorrecto. Si tiene dudas, vuelva a escribirla a mano." },
    { q: "¿Necesito comprar datos de mercado de Tradovate para Volumetrica?", a: "No. Los datos de Volumetrica llegan a través de dxFeed y su prop firm gestiona esa autorización como parte de su acceso a la plataforma. Los datos de Nivel 1 estándar suelen estar incluidos; la profundidad completa del libro de órdenes de Nivel 2 puede requerir una solicitud aparte. Consulte las reglas actuales de su firma y abra un ticket con ellos en lugar de suscribirse a datos de Tradovate." },
    { q: "¿Puedo seguir automatizando una cuenta respaldada por Tradovate si hago mis gráficos en Volumetrica?", a: "La automatización se ejecuta en el lado de la cuenta, no dentro de la ventana de gráficos. Si su evaluación está respaldada por Tradovate, una capa de automatización como PickMyTrade puede enrutar sus alertas de TradingView a esa cuenta, sin importar si observa el mercado en Volumetrica, Tradovate o en cualquier otra plataforma. Confirme primero la integración compatible de su cuenta." },
  ], fr: [
    { q: "Pourquoi n'y a-t-il pas d'option de connexion Tradovate dans Volumetrica ?", a: "Parce que Volumetrica ne se connecte pas à Tradovate. C'est une plateforme distincte de graphiques d'order flow et de DOM qui tire ses données de marché de dxFeed et vous connecte avec les identifiants de plateforme que votre prop firm vous a envoyés par e-mail. Il n'y a aucun endroit où saisir des informations Tradovate ; ne cherchez donc pas un bouton « Se connecter à Tradovate » qui n'existe pas." },
    { q: "Quels identifiants utiliser pour me connecter à Volumetrica ?", a: "Utilisez le nom d'utilisateur et le mot de passe de plateforme que votre prop firm vous a envoyés par e-mail lors de la configuration de votre abonnement, généralement accessibles depuis le tableau de bord de votre firme sous Platforms. Ce ne sont pas vos identifiants Tradovate. Le mot de passe est sensible à la casse ; surveillez donc une première lettre passée en minuscule ou un espace parasite lors du collage." },
    { q: "Comment mettre Volumetrica en ligne après la connexion ?", a: "Vous devez sélectionner le flux de données. Sur la plateforme web, ouvrez le panneau de connexion et choisissez le flux dxFeed portant le nom de votre firme. Dans l'application de bureau (VolSys ou VolBook), le Startup Wizard vous demande de choisir dxFeed comme source de flux et le serveur de votre firme, puis de vous connecter. Rien n'est diffusé tant qu'un flux n'est pas sélectionné." },
    { q: "Que signifie le point vert dans Volumetrica ?", a: "L'indicateur de connexion passe au vert dès que le flux dxFeed est connecté, ce qui signifie que vous êtes en ligne et prêt à trader. Un indicateur gris ou rouge signifie qu'aucun flux n'est sélectionné ou que la connexion n'est pas encore établie ; les cotations et les graphiques ne se chargeront donc pas." },
    { q: "Mon mot de passe Volumetrica ne fonctionne pas. Que se passe-t-il ?", a: "Deux choses piègent la plupart des gens. D'abord, assurez-vous d'utiliser les identifiants de plateforme reçus par e-mail, et non une connexion Tradovate. Ensuite, le mot de passe est généré automatiquement et sensible à la casse ; un premier caractère collé qui est passé en minuscule ou un espace final est donc lu comme erroné. Ressaisissez-le à la main en cas de doute." },
    { q: "Dois-je acheter des données de marché Tradovate pour Volumetrica ?", a: "Non. Les données de Volumetrica transitent par dxFeed, et votre prop firm gère cette autorisation dans le cadre de votre accès à la plateforme. Les données de niveau 1 standard sont généralement incluses ; la profondeur complète du carnet d'ordres de niveau 2 peut nécessiter une demande séparée. Consultez les règles actuelles de votre firme et ouvrez un ticket auprès d'elle plutôt que de vous abonner aux données Tradovate." },
    { q: "Puis-je toujours automatiser un compte adossé à Tradovate si je trace mes graphiques dans Volumetrica ?", a: "L'automatisation s'exécute côté compte, pas dans la fenêtre de graphiques. Si votre évaluation est adossée à Tradovate, une couche d'automatisation comme PickMyTrade peut acheminer vos alertes TradingView vers ce compte, que vous suiviez le marché dans Volumetrica, Tradovate ou ailleurs. Confirmez d'abord l'intégration prise en charge par votre compte." },
  ], it: [
    { q: "Perché non c'è un'opzione di login Tradovate in Volumetrica?", a: "Perché Volumetrica non si collega a Tradovate. È una piattaforma separata di grafici order flow e DOM che ottiene i dati di mercato da dxFeed e le fa accedere con le credenziali della piattaforma che la sua prop firm le ha inviato via e-mail. Non c'è alcun posto in cui digitare i dati di Tradovate, quindi non cerchi un pulsante «Connetti a Tradovate» che non esiste." },
    { q: "Quali credenziali uso per accedere a Volumetrica?", a: "Usi il nome utente e la password della piattaforma che la sua prop firm le ha inviato via e-mail al momento dell'attivazione dell'abbonamento, di solito raggiungibili dalla dashboard della società sotto Platforms. Non sono le sue credenziali Tradovate. La password distingue tra maiuscole e minuscole, quindi faccia attenzione a una prima lettera trasformata in minuscola o a uno spazio di troppo quando la incolla." },
    { q: "Come porto Volumetrica online dopo l'accesso?", a: "Deve selezionare il feed dati. Sulla piattaforma web, apra il pannello di connessione e scelga il feed dxFeed con il nome della sua società. Nell'app desktop (VolSys o VolBook), lo Startup Wizard le chiede di scegliere dxFeed come sorgente del feed e il server della sua società, quindi di accedere. Nulla viene trasmesso finché non viene selezionato un feed." },
    { q: "Cosa significa il punto verde in Volumetrica?", a: "L'indicatore di connessione diventa verde quando il feed dxFeed è connesso, il che significa che è online e pronto a fare trading. Un indicatore grigio o rosso significa che non è selezionato alcun feed o che la connessione non è ancora stata stabilita, quindi quotazioni e grafici non si caricheranno." },
    { q: "La mia password di Volumetrica non funziona. Cosa c'è che non va?", a: "Due cose colgono la maggior parte delle persone. Primo, si assicuri di usare le credenziali della piattaforma ricevute via e-mail, non un login Tradovate. Secondo, la password è generata automaticamente e distingue tra maiuscole e minuscole, quindi un primo carattere incollato diventato minuscolo o uno spazio finale viene letto come errato. In caso di dubbio, la digiti di nuovo a mano." },
    { q: "Devo acquistare i dati di mercato Tradovate per Volumetrica?", a: "No. I dati di Volumetrica arrivano tramite dxFeed e la sua prop firm gestisce quell'autorizzazione come parte dell'accesso alla piattaforma. I dati standard di Livello 1 sono in genere inclusi; la profondità completa del book di Livello 2 può richiedere una richiesta separata. Verifichi le regole attuali della sua società e apra un ticket con loro invece di abbonarsi ai dati Tradovate." },
    { q: "Posso comunque automatizzare un conto supportato da Tradovate se uso i grafici in Volumetrica?", a: "L'automazione gira lato conto, non all'interno della finestra dei grafici. Se la sua valutazione è supportata da Tradovate, un livello di automazione come PickMyTrade può instradare i suoi alert di TradingView verso quel conto, indipendentemente dal fatto che segua il mercato in Volumetrica, Tradovate o altrove. Confermi prima l'integrazione supportata dal suo conto." },
  ] },
  relatedHeading: { en: "Related Guides", de: "Verwandte Leitfäden", es: "Guías relacionadas", fr: "Guides associés", it: "Guide correlate" },
  disclosureText: { en: "This guide is for educational and informational purposes only and is not financial, investment, or trading advice. Trading futures and other leveraged products carries a substantial risk of loss and is not suitable for every investor. PickMyTrade is an independent third-party automation platform and is not affiliated with, endorsed by, or sponsored by Tradovate, Inc. \"Tradovate\" and all related names, logos, and trademarks are the property of their respective owners. Platform features and steps change over time, so always confirm the current process in the official Tradovate platform and documentation before acting.", de: "Dieser Leitfaden dient ausschließlich Bildungs- und Informationszwecken und stellt keine Finanz-, Anlage- oder Handelsberatung dar. Der Handel mit Futures und anderen gehebelten Produkten birgt ein erhebliches Verlustrisiko und ist nicht für jeden Anleger geeignet. PickMyTrade ist eine unabhängige Automatisierungsplattform eines Drittanbieters und steht in keiner Verbindung zu Tradovate, Inc., wird von diesem weder unterstützt noch gesponsert. „Tradovate“ und alle zugehörigen Namen, Logos und Marken sind Eigentum ihrer jeweiligen Inhaber. Plattformfunktionen und Abläufe ändern sich im Laufe der Zeit. Bestätigen Sie daher stets den aktuellen Ablauf in der offiziellen Tradovate-Plattform und -Dokumentation, bevor Sie handeln.", es: "Esta guía tiene fines exclusivamente educativos e informativos y no constituye asesoramiento financiero, de inversión ni de trading. Operar con futuros y otros productos apalancados conlleva un riesgo sustancial de pérdida y no es adecuado para todos los inversores. PickMyTrade es una plataforma de automatización independiente de terceros y no está afiliada, respaldada ni patrocinada por Tradovate, Inc. «Tradovate» y todos los nombres, logotipos y marcas relacionados son propiedad de sus respectivos titulares. Las funciones de la plataforma y los pasos cambian con el tiempo, por lo que debe confirmar siempre el proceso vigente en la plataforma y la documentación oficiales de Tradovate antes de actuar.", fr: "Ce guide est fourni à des fins exclusivement éducatives et informatives et ne constitue pas un conseil financier, d'investissement ou de trading. Le trading de contrats à terme et d'autres produits à effet de levier comporte un risque de perte important et ne convient pas à tous les investisseurs. PickMyTrade est une plateforme d'automatisation tierce indépendante et n'est ni affiliée à Tradovate, Inc., ni approuvée ou parrainée par cette dernière. « Tradovate » ainsi que tous les noms, logos et marques associés sont la propriété de leurs détenteurs respectifs. Les fonctionnalités de la plateforme et les étapes évoluent avec le temps ; confirmez donc toujours la procédure en vigueur dans la plateforme et la documentation officielles de Tradovate avant d'agir.", it: "Questa guida ha esclusivamente finalità educative e informative e non costituisce consulenza finanziaria, di investimento o di trading. Il trading di futures e di altri prodotti a leva comporta un rischio di perdita sostanziale e non è adatto a tutti gli investitori. PickMyTrade è una piattaforma di automazione indipendente di terze parti e non è affiliata a Tradovate, Inc., né approvata o sponsorizzata da essa. «Tradovate» e tutti i nomi, loghi e marchi correlati sono di proprietà dei rispettivi titolari. Le funzionalità della piattaforma e le procedure cambiano nel tempo, quindi verifichi sempre la procedura attuale nella piattaforma e nella documentazione ufficiali di Tradovate prima di agire." },
};
const data: GuideArticleData = resolveGuideContent(content, locale, related);

const faqSchema = {
