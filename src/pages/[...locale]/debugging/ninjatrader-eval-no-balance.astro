---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "ninjatrader-eval-no-balance";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/debugging/${SLUG}`;

const META_TITLE = "NinjaTrader Apex Eval Connects, No Balance Shows";
const META_DESCRIPTION =
  "Apex eval connects in NinjaTrader but no balance shows? Log in with your NinjaTrader account, not the Tradovate login, to restore the Rithmic account.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "NinjaTrader-Apex-Eval verbunden, aber kein Kontostand sichtbar", es: "NinjaTrader Apex Eval se conecta, pero no aparece el saldo", fr: "NinjaTrader Apex Eval se connecte, mais aucun solde n'apparaît", it: "NinjaTrader Apex Eval si connette, ma non compare alcun saldo" },
  dek: { en: "Your Rithmic connection turns green, quotes tick, and the chart is live, but there's no account to trade against. Here's why the balance stays blank and the exact steps to bring it back.", de: "Ihre Rithmic-Verbindung wird grün, die Kurse laufen und der Chart ist live, doch es gibt kein Konto zum Handeln. Hier erfahren Sie, warum der Kontostand leer bleibt und mit welchen Schritten er zurückkommt.", es: "Su conexión Rithmic se pone en verde, las cotizaciones se mueven y el gráfico está en vivo, pero no hay ninguna cuenta con la que operar. Aquí le explicamos por qué el saldo sigue en blanco y los pasos exactos para recuperarlo.", fr: "Votre connexion Rithmic passe au vert, les cotations défilent et le graphique est en direct, mais il n'y a aucun compte sur lequel trader. Voici pourquoi le solde reste vide et les étapes exactes pour le faire revenir.", it: "La Sua connessione Rithmic diventa verde, le quotazioni scorrono e il grafico è live, ma non c'è alcun conto su cui operare. Ecco perché il saldo resta vuoto e i passaggi esatti per farlo tornare." },
  readTime: { en: "7 min read", de: "7 Min. Lesezeit", es: "Lectura de 7 min", fr: "Lecture : 7 min", it: "Lettura di 7 min" },
  lastUpdated: "2026-07-10",
  blocks: { en: [
    { type: "paragraph", html: "You bought an Apex evaluation, set up the Rithmic connection in NinjaTrader, and the connection indicator went green. Quotes are ticking, the chart is live, everything looks healthy. Then you go to place a trade and there's no account to trade against: no balance, no buying power, the account dropdown is empty. The connection works, but the account itself is nowhere. Here's the short version. You almost certainly logged into NinjaTrader with an old Tradovate-based login instead of a native NinjaTrader account, and only NinjaTrader accounts carry the Rithmic entitlement that makes your evaluation account show up. Log out, restart, sign back in with your NinjaTrader credentials, and confirm the Rithmic entitlement is on that account. Below is what's really happening, why it trips so many people, and the exact steps to get your balance back on screen." },
    {
      type: "checklist",
      heading: "Quick Checklist",
      items: [
        "<strong class='text-white'>Check which login you used</strong>: the account balance only shows when you're signed into the NinjaTrader desktop with your NinjaTrader account, not a Tradovate login.",
        "<strong class='text-white'>Confirm you have a NinjaTrader account</strong>: create or verify one in the NinjaTrader Account Dashboard at account.ninjatrader.com.",
        "<strong class='text-white'>Fully restart NinjaTrader Desktop</strong>: log out, close it completely, reopen, and log back in with the NinjaTrader account.",
        "<strong class='text-white'>Verify the Rithmic entitlement</strong>: open Help then About and look for the Evaluation (Rithmic) entitlement on that account.",
        "<strong class='text-white'>Missing entitlement? Contact NinjaTrader Support</strong>: only they can add the Evaluation (Rithmic) entitlement to your account.",
        "<strong class='text-white'>Skip the license-key import</strong>: it's no longer required, so re-importing keys won't bring the balance back.",
        "<strong class='text-white'>Reconnect cleanly</strong>: use a letters-and-numbers-only Rithmic password, pick your firm's connection profile, and choose Simulation.",
      ],
    },
    { type: "heading", text: "What “Connected But No Balance” Actually Means" },
    { type: "paragraph", html: "The green connection light is deceiving. All it confirms is that Rithmic accepted your credentials and the market-data and order route is live. That's a separate thing from whether NinjaTrader is allowed to <em>display</em> a given account. NinjaTrader gates which accounts appear behind an account-level entitlement. When that entitlement is present, your Rithmic evaluation account loads with its balance, buying power, and position data. When it's missing, the platform connects to the feed but never populates the account object, so the balance field stays blank and there's nothing to select in the order ticket." },
    { type: "paragraph", html: "The entitlement lives on your NinjaTrader account, and this is the crux of the whole problem. Plenty of traders come to Apex from a Tradovate setup and already have a Tradovate-based login saved in NinjaTrader. That credential will happily sign you into the desktop and even connect the Rithmic feed. What it won't do is carry the Rithmic entitlement, because that entitlement only rides on accounts you create through the NinjaTrader Account Dashboard. So you end up in this odd middle state: connected, data flowing, and yet no account to actually trade. It's not a broken evaluation, and it's not an Apex outage. Your funded or evaluation account exists on Rithmic's side the whole time. NinjaTrader just hasn't been given permission to show it to you." },
    { type: "heading", text: "Why the Account Shows Up Empty" },
    { type: "heading", text: "1. You signed in with a Tradovate-based login" },
    { type: "paragraph", html: "This is the big one, and it accounts for most cases. If you connected Tradovate to NinjaTrader in the past, that login may still be your default. Signing in with it connects Rithmic but withholds the entitlement, so the evaluation account never lists. The tell is a green connection with an empty account dropdown and a blank balance." },
    { type: "heading", text: "2. The Evaluation (Rithmic) entitlement isn't on your account" },
    { type: "paragraph", html: "Even on a proper NinjaTrader account, the specific Evaluation (Rithmic) entitlement has to be enabled for the evaluation account to appear. If it was never applied, or it's attached to a different account than the one you're logged into, the balance stays hidden. You can check this yourself under Help then About, and if it's absent, NinjaTrader Support has to add it." },
    { type: "heading", text: "3. You're still chasing the old license-key workflow" },
    { type: "paragraph", html: "Older Apex setup guides told you to import a license key into NinjaTrader. That step is retired. The connection now keys off your NinjaTrader account and its entitlements, not a key file. If you're re-importing keys to force the balance to appear, you're spending effort on a step that no longer does anything." },
    { type: "heading", text: "4. A separate Rithmic connection quirk is stacking on top" },
    { type: "paragraph", html: "Sometimes the login is right but the connection itself never fully completes, which also leaves you with no account. The usual culprits: a Rithmic password containing special characters (Rithmic prefers plain letters and numbers), the wrong connection profile selected instead of your firm's, or a Live versus Simulation prompt answered incorrectly. Evaluation accounts run in simulation, so pick Simulation if you're asked." },
    { type: "heading", text: "How to Fix It: Step-by-Step" },
    {
      type: "steps",
      items: [
        { title: "Make sure you have a native NinjaTrader account", html: "Go to the NinjaTrader Account Dashboard at account.ninjatrader.com and confirm you have an account there, or create one if you don't. This is the credential that carries entitlements. It's a different thing from any Tradovate login you may have saved, even if the email looks similar. Note the exact username and password you set here, because this is what you'll use to sign into the desktop." },
        { title: "Restart NinjaTrader and log in with the NinjaTrader account", html: "Don't just reconnect. Log out of the desktop entirely, close the application, reopen it, and at the login prompt sign in with your NinjaTrader account credentials from the previous step. A full restart matters here because the entitlement set is read at login, so switching accounts without restarting can leave the platform holding the old, unentitled session. Once you're back in on the right account, open your Rithmic connection again." },
        { title: "Verify the Rithmic entitlement under Help then About", html: "With the NinjaTrader account signed in, open <strong class='text-white'>Help</strong> and then <strong class='text-white'>About</strong>. The platform lists the entitlements tied to your account. Look for an <strong class='text-white'>Evaluation (Rithmic)</strong> entitlement. If it's there, your evaluation account should now appear in the account list with its balance filled in, and you're done. Confirm the exact label in your current build, since NinjaTrader adjusts wording between releases." },
        { title: "If the entitlement is missing, contact NinjaTrader Support", html: "If Help then About doesn't list the Evaluation (Rithmic) entitlement, NinjaTrader hasn't enabled it on your account, and there's no self-serve toggle for it. Reach NinjaTrader Support directly, tell them you're connecting an Apex evaluation over Rithmic, and ask them to add the Evaluation (Rithmic) entitlement to your NinjaTrader account. Once they confirm it's applied, restart NinjaTrader and reconnect. The balance should populate on the next connection." },
        { title: "Clean up the Rithmic connection itself", html: "If you're on the right login and the entitlement is present but the connection still won't complete, tidy up the connection details. Reset your Rithmic password to letters and numbers only if it contains symbols, since special characters can break the handshake. Make sure you've selected your firm's connection profile rather than a generic option, and if you're asked to choose between Live and Simulation, choose Simulation. Let the connection settle and the account load before you place any orders." },
      ],
    },
    { type: "heading", text: "What Not to Waste Time On" },
    { type: "paragraph", html: "Once the connection is green, several instincts send you down dead ends. Skip these until you've checked the login and the entitlement:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Re-importing a license key</strong>: the key workflow is retired and won't summon a missing balance.",
        "<strong class='text-white'>Resubscribing to market data</strong>: your data is already flowing, that's what the green light means, so the feed isn't the issue.",
        "<strong class='text-white'>Reinstalling NinjaTrader</strong>: a clean reinstall won't change which login you use or which entitlements your account holds.",
        "<strong class='text-white'>Assuming the evaluation is broken</strong>: the account exists on Rithmic's side; NinjaTrader simply hasn't been cleared to display it.",
      ],
    },
    { type: "heading", text: "Automate Your Apex Account Without the Desktop Login Dance" },
    { type: "paragraph", html: "Straight talk first: no third-party tool can add a Rithmic entitlement to your NinjaTrader account. That has to come from NinjaTrader. What a tool like PickMyTrade can do is take the NinjaTrader desktop out of your order path entirely. If your real goal is running TradingView signals into your Apex account, PickMyTrade holds a server-side connection to your account and fires your alerts to it directly, so you're not depending on the desktop being logged into the exact right credential for orders to route." },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Set-once account link</strong>: connect your account a single time instead of babysitting which login the desktop is holding today.",
        "<strong class='text-white'>Signals straight from TradingView</strong>: your strategy alerts route to your account without a charting platform sitting in the middle.",
        "<strong class='text-white'>Live and simulation aware</strong>: send to the exact account you mean, which matters on evaluation accounts that run in simulation.",
        "<strong class='text-white'>Multi-account sync</strong>: mirror one alert across several accounts from one place, no per-account desktop login required.",
      ],
    },
    { type: "paragraph", html: "Always check your prop firm's current rules on automated order routing before you switch anything on, since firms set their own policies." },
  ], de: [
    { type: "paragraph",html: "Sie haben eine Apex-Evaluation gekauft, die Rithmic-Verbindung in NinjaTrader eingerichtet, und die Verbindungsanzeige wurde grün. Die Kurse laufen, der Chart ist live, alles sieht gesund aus. Dann wollen Sie einen Trade platzieren, und es gibt kein Konto zum Handeln: kein Kontostand, keine Kaufkraft, die Konto-Auswahlliste ist leer. Die Verbindung funktioniert, aber das Konto selbst fehlt. Hier die Kurzfassung: Sie haben sich mit ziemlicher Sicherheit bei NinjaTrader mit einem alten Tradovate-basierten Login statt mit einem nativen NinjaTrader-Konto angemeldet, und nur NinjaTrader-Konten tragen die Rithmic-Berechtigung, durch die Ihr Evaluationskonto erscheint. Melden Sie sich ab, starten Sie neu, melden Sie sich mit Ihren NinjaTrader-Zugangsdaten wieder an und bestätigen Sie, dass die Rithmic-Berechtigung auf diesem Konto vorhanden ist. Unten finden Sie, was tatsächlich passiert, warum so viele darüber stolpern und die genauen Schritte, um Ihren Kontostand wieder auf den Bildschirm zu bringen." },
    {
      type: "checklist",
      heading: "Kurze Checkliste",
      items: [
        "<strong class='text-white'>Prüfen Sie, welchen Login Sie verwendet haben</strong>: Der Kontostand erscheint nur, wenn Sie am NinjaTrader-Desktop mit Ihrem NinjaTrader-Konto angemeldet sind, nicht mit einem Tradovate-Login.",
        "<strong class='text-white'>Bestätigen Sie, dass Sie ein NinjaTrader-Konto haben</strong>: Erstellen oder prüfen Sie eines im NinjaTrader Account Dashboard unter account.ninjatrader.com.",
        "<strong class='text-white'>Starten Sie NinjaTrader Desktop vollständig neu</strong>: Melden Sie sich ab, schließen Sie die Anwendung komplett, öffnen Sie sie erneut und melden Sie sich mit dem NinjaTrader-Konto an.",
        "<strong class='text-white'>Prüfen Sie die Rithmic-Berechtigung</strong>: Öffnen Sie Help und dann About und suchen Sie auf diesem Konto nach der Berechtigung Evaluation (Rithmic).",
        "<strong class='text-white'>Berechtigung fehlt? Kontaktieren Sie den NinjaTrader-Support</strong>: Nur dieser kann die Berechtigung Evaluation (Rithmic) zu Ihrem Konto hinzufügen.",
        "<strong class='text-white'>Überspringen Sie den Lizenzschlüssel-Import</strong>: Er ist nicht mehr erforderlich, daher bringt erneutes Importieren von Schlüsseln den Kontostand nicht zurück.",
        "<strong class='text-white'>Verbinden Sie sich sauber neu</strong>: Verwenden Sie ein Rithmic-Passwort nur aus Buchstaben und Zahlen, wählen Sie das Verbindungsprofil Ihrer Firma und wählen Sie Simulation.",
      ],
    },
    { type: "heading",text: "Was „Verbunden, aber kein Kontostand“ tatsächlich bedeutet" },
    { type: "paragraph",html: "Das grüne Verbindungslicht täuscht. Es bestätigt lediglich, dass Rithmic Ihre Zugangsdaten akzeptiert hat und der Marktdaten- und Orderweg live ist. Das ist etwas anderes als die Frage, ob NinjaTrader ein bestimmtes Konto <em>anzeigen</em> darf. NinjaTrader macht die Anzeige von Konten von einer Berechtigung auf Kontoebene abhängig. Ist diese Berechtigung vorhanden, wird Ihr Rithmic-Evaluationskonto mit Kontostand, Kaufkraft und Positionsdaten geladen. Fehlt sie, verbindet sich die Plattform mit dem Feed, befüllt das Kontoobjekt aber nie, sodass das Kontostandfeld leer bleibt und im Orderticket nichts auswählbar ist." },
    { type: "paragraph",html: "Die Berechtigung liegt auf Ihrem NinjaTrader-Konto, und das ist der Kern des ganzen Problems. Viele Trader kommen von einem Tradovate-Setup zu Apex und haben bereits einen Tradovate-basierten Login in NinjaTrader gespeichert. Diese Zugangsdaten melden Sie bereitwillig am Desktop an und verbinden sogar den Rithmic-Feed. Was sie nicht tragen, ist die Rithmic-Berechtigung, denn diese gibt es nur für Konten, die Sie über das NinjaTrader Account Dashboard erstellen. So landen Sie in diesem seltsamen Zwischenzustand: verbunden, Daten fließen, und trotzdem kein Konto zum Handeln. Es ist keine defekte Evaluation und kein Apex-Ausfall. Ihr Evaluations- oder Funded-Konto existiert die ganze Zeit auf der Seite von Rithmic. NinjaTrader wurde nur nicht die Erlaubnis erteilt, es Ihnen anzuzeigen." },
    { type: "heading",text: "Warum das Konto leer erscheint" },
    { type: "heading",text: "1. Sie haben sich mit einem Tradovate-basierten Login angemeldet" },
    { type: "paragraph",html: "Das ist der Hauptgrund und erklärt die meisten Fälle. Wenn Sie Tradovate früher mit NinjaTrader verbunden haben, ist dieser Login möglicherweise noch Ihre Vorgabe. Die Anmeldung damit verbindet Rithmic, hält aber die Berechtigung zurück, sodass das Evaluationskonto nie aufgelistet wird. Das Erkennungszeichen ist eine grüne Verbindung mit leerer Konto-Auswahlliste und leerem Kontostand." },
    { type: "heading",text: "2. Die Berechtigung Evaluation (Rithmic) fehlt auf Ihrem Konto" },
    { type: "paragraph",html: "Selbst bei einem korrekten NinjaTrader-Konto muss die spezifische Berechtigung Evaluation (Rithmic) aktiviert sein, damit das Evaluationskonto erscheint. Wurde sie nie angewendet oder ist sie einem anderen Konto zugeordnet als dem, mit dem Sie angemeldet sind, bleibt der Kontostand verborgen. Sie können das selbst unter Help und dann About prüfen, und falls sie fehlt, muss der NinjaTrader-Support sie hinzufügen." },
    { type: "heading",text: "3. Sie folgen noch dem alten Lizenzschlüssel-Ablauf" },
    { type: "paragraph",html: "Ältere Apex-Einrichtungsanleitungen wiesen Sie an, einen Lizenzschlüssel in NinjaTrader zu importieren. Dieser Schritt ist abgeschafft. Die Verbindung richtet sich jetzt nach Ihrem NinjaTrader-Konto und dessen Berechtigungen, nicht nach einer Schlüsseldatei. Wenn Sie Schlüssel erneut importieren, um den Kontostand zu erzwingen, investieren Sie Mühe in einen Schritt, der nichts mehr bewirkt." },
    { type: "heading",text: "4. Eine separate Rithmic-Verbindungseigenheit kommt hinzu" },
    { type: "paragraph",html: "Manchmal stimmt der Login, aber die Verbindung selbst wird nie ganz hergestellt, was ebenfalls zu einem fehlenden Konto führt. Die üblichen Ursachen: ein Rithmic-Passwort mit Sonderzeichen (Rithmic bevorzugt reine Buchstaben und Zahlen), das falsche Verbindungsprofil statt dem Ihrer Firma oder eine falsch beantwortete Abfrage Live oder Simulation. Evaluationskonten laufen in der Simulation, wählen Sie also Simulation, wenn Sie gefragt werden." },
    { type: "heading",text: "So beheben Sie es: Schritt für Schritt" },
    {
      type: "steps",
      items: [
        { title: "Stellen Sie sicher, dass Sie ein natives NinjaTrader-Konto haben", html: "Gehen Sie zum NinjaTrader Account Dashboard unter account.ninjatrader.com und bestätigen Sie, dass Sie dort ein Konto haben, oder erstellen Sie eines, falls nicht. Das sind die Zugangsdaten, die Berechtigungen tragen. Sie unterscheiden sich von jedem gespeicherten Tradovate-Login, auch wenn die E-Mail-Adresse ähnlich aussieht. Notieren Sie sich Benutzernamen und Passwort, die Sie hier festlegen, denn damit melden Sie sich am Desktop an." },
        { title: "Starten Sie NinjaTrader neu und melden Sie sich mit dem NinjaTrader-Konto an", html: "Verbinden Sie sich nicht einfach nur neu. Melden Sie sich vollständig vom Desktop ab, schließen Sie die Anwendung, öffnen Sie sie erneut und melden Sie sich an der Anmeldeaufforderung mit den Zugangsdaten Ihres NinjaTrader-Kontos aus dem vorherigen Schritt an. Ein vollständiger Neustart ist hier wichtig, weil die Berechtigungen beim Login gelesen werden. Ein Kontowechsel ohne Neustart kann dazu führen, dass die Plattform an der alten, nicht berechtigten Sitzung festhält. Sobald Sie mit dem richtigen Konto angemeldet sind, öffnen Sie Ihre Rithmic-Verbindung erneut." },
        { title: "Prüfen Sie die Rithmic-Berechtigung unter Help und dann About", html: "Öffnen Sie mit angemeldetem NinjaTrader-Konto <strong class='text-white'>Help</strong> und dann <strong class='text-white'>About</strong>. Die Plattform listet die mit Ihrem Konto verknüpften Berechtigungen auf. Suchen Sie nach einer Berechtigung <strong class='text-white'>Evaluation (Rithmic)</strong>. Ist sie vorhanden, sollte Ihr Evaluationskonto jetzt mit ausgefülltem Kontostand in der Kontoliste erscheinen, und Sie sind fertig. Prüfen Sie die genaue Bezeichnung in Ihrer aktuellen Version, da NinjaTrader die Formulierung zwischen Releases anpasst." },
        { title: "Fehlt die Berechtigung, kontaktieren Sie den NinjaTrader-Support", html: "Wenn Help und dann About die Berechtigung Evaluation (Rithmic) nicht auflistet, hat NinjaTrader sie für Ihr Konto nicht aktiviert, und es gibt dafür keinen Selbstbedienungsschalter. Wenden Sie sich direkt an den NinjaTrader-Support, teilen Sie mit, dass Sie eine Apex-Evaluation über Rithmic verbinden, und bitten Sie darum, die Berechtigung Evaluation (Rithmic) zu Ihrem NinjaTrader-Konto hinzuzufügen. Sobald NinjaTrader bestätigt, dass sie angewendet wurde, starten Sie NinjaTrader neu und verbinden Sie sich erneut. Der Kontostand sollte bei der nächsten Verbindung erscheinen." },
        { title: "Bereinigen Sie die Rithmic-Verbindung selbst", html: "Wenn Sie den richtigen Login verwenden und die Berechtigung vorhanden ist, die Verbindung aber trotzdem nicht zustande kommt, bereinigen Sie die Verbindungsdetails. Setzen Sie Ihr Rithmic-Passwort auf nur Buchstaben und Zahlen zurück, falls es Symbole enthält, da Sonderzeichen den Verbindungsaufbau stören können. Stellen Sie sicher, dass Sie das Verbindungsprofil Ihrer Firma statt einer allgemeinen Option gewählt haben, und wählen Sie Simulation, falls Sie zwischen Live und Simulation wählen sollen. Lassen Sie die Verbindung sich stabilisieren und das Konto laden, bevor Sie Orders platzieren." },
      ],
    },
    { type: "heading",text: "Worauf Sie keine Zeit verschwenden sollten" },
    { type: "paragraph",html: "Sobald die Verbindung grün ist, führen mehrere Instinkte in Sackgassen. Überspringen Sie diese, bis Sie Login und Berechtigung geprüft haben:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Erneutes Importieren eines Lizenzschlüssels</strong>: Der Schlüssel-Ablauf ist abgeschafft und lässt keinen fehlenden Kontostand erscheinen.",
        "<strong class='text-white'>Marktdaten erneut abonnieren</strong>: Ihre Daten fließen bereits, das bedeutet das grüne Licht, daher ist der Feed nicht das Problem.",
        "<strong class='text-white'>NinjaTrader neu installieren</strong>: Eine saubere Neuinstallation ändert weder den verwendeten Login noch die Berechtigungen Ihres Kontos.",
        "<strong class='text-white'>Annehmen, die Evaluation sei defekt</strong>: Das Konto existiert auf der Seite von Rithmic, NinjaTrader wurde lediglich nicht freigegeben, es anzuzeigen.",
      ],
    },
    { type: "heading",text: "Automatisieren Sie Ihr Apex-Konto ohne den Desktop-Login-Tanz" },
    { type: "paragraph",html: "Klartext vorweg: Kein Drittanbieter-Tool kann Ihrem NinjaTrader-Konto eine Rithmic-Berechtigung hinzufügen. Das muss von NinjaTrader kommen. Was ein Tool wie PickMyTrade tun kann, ist, den NinjaTrader-Desktop vollständig aus Ihrem Orderweg zu nehmen. Wenn Ihr eigentliches Ziel darin besteht, TradingView-Signale an Ihr Apex-Konto zu senden, hält PickMyTrade eine serverseitige Verbindung zu Ihrem Konto und feuert Ihre Alerts direkt dorthin ab, sodass das Routing von Orders nicht davon abhängt, dass der Desktop mit genau den richtigen Zugangsdaten angemeldet ist." },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Einmalige Kontoverknüpfung</strong>: Verbinden Sie Ihr Konto ein einziges Mal, statt darauf zu achten, welchen Login der Desktop heute hält.",
        "<strong class='text-white'>Signale direkt von TradingView</strong>: Ihre Strategie-Alerts werden an Ihr Konto geleitet, ohne dass eine Charting-Plattform dazwischensitzt.",
        "<strong class='text-white'>Live- und Simulationsbewusst</strong>: Senden Sie an genau das Konto, das Sie meinen, was bei Evaluationskonten wichtig ist, die in der Simulation laufen.",
        "<strong class='text-white'>Multi-Konto-Synchronisierung</strong>: Spiegeln Sie einen Alert über mehrere Konten von einem Ort aus, ohne Desktop-Login pro Konto.",
      ],
    },
    { type: "paragraph",html: "Prüfen Sie stets die aktuellen Regeln Ihrer Prop-Firma zum automatisierten Order-Routing, bevor Sie etwas aktivieren, da Firmen ihre eigenen Richtlinien festlegen." },
  ], es: [
    { type: "paragraph",html: "Compró una evaluación de Apex, configuró la conexión Rithmic en NinjaTrader y el indicador de conexión se puso en verde. Las cotizaciones se mueven, el gráfico está en vivo, todo parece sano. Entonces va a colocar una operación y no hay ninguna cuenta con la que operar: ni saldo, ni poder de compra, y el menú desplegable de cuentas está vacío. La conexión funciona, pero la cuenta en sí no aparece por ningún lado. Esta es la versión corta. Casi con seguridad inició sesión en NinjaTrader con un antiguo acceso basado en Tradovate en lugar de una cuenta nativa de NinjaTrader, y solo las cuentas de NinjaTrader llevan el derecho de Rithmic que hace aparecer su cuenta de evaluación. Cierre sesión, reinicie, vuelva a iniciar sesión con sus credenciales de NinjaTrader y confirme que el derecho de Rithmic está en esa cuenta. A continuación le explicamos qué ocurre realmente, por qué tanta gente tropieza con esto y los pasos exactos para que su saldo vuelva a la pantalla." },
    {
      type: "checklist",
      heading: "Lista de verificación rápida",
      items: [
        "<strong class='text-white'>Compruebe qué acceso utilizó</strong>: el saldo de la cuenta solo aparece cuando ha iniciado sesión en el escritorio de NinjaTrader con su cuenta de NinjaTrader, no con un acceso de Tradovate.",
        "<strong class='text-white'>Confirme que tiene una cuenta de NinjaTrader</strong>: cree o verifique una en el NinjaTrader Account Dashboard en account.ninjatrader.com.",
        "<strong class='text-white'>Reinicie por completo NinjaTrader Desktop</strong>: cierre sesión, ciérrelo por completo, ábralo de nuevo e inicie sesión con la cuenta de NinjaTrader.",
        "<strong class='text-white'>Verifique el derecho de Rithmic</strong>: abra Help y luego About y busque el derecho Evaluation (Rithmic) en esa cuenta.",
        "<strong class='text-white'>¿Falta el derecho? Contacte con el soporte de NinjaTrader</strong>: solo ellos pueden añadir el derecho Evaluation (Rithmic) a su cuenta.",
        "<strong class='text-white'>Omita la importación de la clave de licencia</strong>: ya no es necesaria, por lo que volver a importar claves no recuperará el saldo.",
        "<strong class='text-white'>Vuelva a conectarse correctamente</strong>: utilice una contraseña de Rithmic solo con letras y números, elija el perfil de conexión de su firma y seleccione Simulation.",
      ],
    },
    { type: "heading",text: "Qué significa realmente «conectado pero sin saldo»" },
    { type: "paragraph",html: "La luz verde de conexión engaña. Todo lo que confirma es que Rithmic aceptó sus credenciales y que la ruta de datos de mercado y de órdenes está activa. Eso es algo distinto de si NinjaTrader tiene permiso para <em>mostrar</em> una cuenta determinada. NinjaTrader condiciona qué cuentas aparecen a un derecho a nivel de cuenta. Cuando ese derecho está presente, su cuenta de evaluación de Rithmic se carga con su saldo, poder de compra y datos de posición. Cuando falta, la plataforma se conecta al feed pero nunca rellena el objeto de cuenta, de modo que el campo de saldo queda en blanco y no hay nada que seleccionar en el ticket de orden." },
    { type: "paragraph",html: "El derecho reside en su cuenta de NinjaTrader, y este es el núcleo de todo el problema. Muchos traders llegan a Apex desde una configuración de Tradovate y ya tienen un acceso basado en Tradovate guardado en NinjaTrader. Esa credencial le permite iniciar sesión en el escritorio e incluso conectar el feed de Rithmic. Lo que no hace es llevar el derecho de Rithmic, porque ese derecho solo viaja con las cuentas que crea a través del NinjaTrader Account Dashboard. Así termina en este curioso punto intermedio: conectado, con datos fluyendo y, aun así, sin cuenta con la que operar. No es una evaluación rota ni una caída de Apex. Su cuenta de evaluación o fondeada existe todo el tiempo en el lado de Rithmic. Simplemente NinjaTrader no ha recibido permiso para mostrársela." },
    { type: "heading",text: "Por qué la cuenta aparece vacía" },
    { type: "heading",text: "1. Inició sesión con un acceso basado en Tradovate" },
    { type: "paragraph",html: "Esta es la causa principal y explica la mayoría de los casos. Si conectó Tradovate a NinjaTrader en el pasado, ese acceso puede seguir siendo el predeterminado. Iniciar sesión con él conecta Rithmic pero retiene el derecho, por lo que la cuenta de evaluación nunca aparece en la lista. La señal es una conexión en verde con el menú de cuentas vacío y el saldo en blanco." },
    { type: "heading",text: "2. El derecho Evaluation (Rithmic) no está en su cuenta" },
    { type: "paragraph",html: "Incluso en una cuenta de NinjaTrader correcta, el derecho específico Evaluation (Rithmic) debe estar activado para que aparezca la cuenta de evaluación. Si nunca se aplicó o está asociado a una cuenta distinta de aquella con la que ha iniciado sesión, el saldo permanece oculto. Puede comprobarlo usted mismo en Help y luego About, y si no está, el soporte de NinjaTrader debe añadirlo." },
    { type: "heading",text: "3. Sigue persiguiendo el antiguo flujo de la clave de licencia" },
    { type: "paragraph",html: "Las guías de configuración de Apex más antiguas le indicaban importar una clave de licencia en NinjaTrader. Ese paso está retirado. La conexión ahora se basa en su cuenta de NinjaTrader y sus derechos, no en un archivo de clave. Si vuelve a importar claves para forzar que aparezca el saldo, está dedicando esfuerzo a un paso que ya no hace nada." },
    { type: "heading",text: "4. Una peculiaridad distinta de la conexión Rithmic se suma al problema" },
    { type: "paragraph",html: "A veces el acceso es correcto, pero la conexión en sí nunca se completa del todo, lo que también le deja sin cuenta. Los culpables habituales: una contraseña de Rithmic con caracteres especiales (Rithmic prefiere letras y números simples), el perfil de conexión equivocado en lugar del de su firma, o un aviso de Live frente a Simulation respondido incorrectamente. Las cuentas de evaluación funcionan en simulación, así que elija Simulation si se le pregunta." },
    { type: "heading",text: "Cómo solucionarlo: paso a paso" },
    {
      type: "steps",
      items: [
        { title: "Asegúrese de tener una cuenta nativa de NinjaTrader", html: "Vaya al NinjaTrader Account Dashboard en account.ninjatrader.com y confirme que tiene allí una cuenta, o cree una si no la tiene. Esta es la credencial que lleva los derechos. Es distinta de cualquier acceso de Tradovate que pueda tener guardado, aunque el correo electrónico se parezca. Anote el nombre de usuario y la contraseña exactos que establezca aquí, porque es lo que usará para iniciar sesión en el escritorio." },
        { title: "Reinicie NinjaTrader e inicie sesión con la cuenta de NinjaTrader", html: "No se limite a reconectar. Cierre sesión por completo en el escritorio, cierre la aplicación, ábrala de nuevo y, en el aviso de inicio de sesión, entre con las credenciales de su cuenta de NinjaTrader del paso anterior. Un reinicio completo es importante aquí porque el conjunto de derechos se lee al iniciar sesión, así que cambiar de cuenta sin reiniciar puede dejar a la plataforma con la sesión antigua sin derechos. Una vez que haya entrado con la cuenta correcta, abra de nuevo su conexión Rithmic." },
        { title: "Verifique el derecho de Rithmic en Help y luego About", html: "Con la cuenta de NinjaTrader iniciada, abra <strong class='text-white'>Help</strong> y luego <strong class='text-white'>About</strong>. La plataforma lista los derechos asociados a su cuenta. Busque un derecho <strong class='text-white'>Evaluation (Rithmic)</strong>. Si está ahí, su cuenta de evaluación debería aparecer ahora en la lista de cuentas con el saldo completado, y habrá terminado. Confirme la etiqueta exacta en su versión actual, ya que NinjaTrader ajusta la redacción entre versiones." },
        { title: "Si falta el derecho, contacte con el soporte de NinjaTrader", html: "Si Help y luego About no lista el derecho Evaluation (Rithmic), NinjaTrader no lo ha habilitado en su cuenta y no existe un interruptor de autoservicio para ello. Contacte directamente con el soporte de NinjaTrader, dígales que está conectando una evaluación de Apex a través de Rithmic y pídales que añadan el derecho Evaluation (Rithmic) a su cuenta de NinjaTrader. Cuando le confirmen que se ha aplicado, reinicie NinjaTrader y vuelva a conectarse. El saldo debería aparecer en la siguiente conexión." },
        { title: "Limpie la propia conexión Rithmic", html: "Si utiliza el acceso correcto y el derecho está presente pero la conexión sigue sin completarse, revise los datos de conexión. Restablezca su contraseña de Rithmic con solo letras y números si contiene símbolos, ya que los caracteres especiales pueden romper el handshake. Asegúrese de haber seleccionado el perfil de conexión de su firma en lugar de una opción genérica y, si se le pide elegir entre Live y Simulation, elija Simulation. Deje que la conexión se estabilice y que la cuenta se cargue antes de colocar cualquier orden." },
      ],
    },
    { type: "heading",text: "En qué no perder el tiempo" },
    { type: "paragraph",html: "Una vez que la conexión está en verde, varios instintos le llevan a callejones sin salida. Omítalos hasta haber comprobado el acceso y el derecho:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Volver a importar una clave de licencia</strong>: el flujo de la clave está retirado y no hará aparecer un saldo que falta.",
        "<strong class='text-white'>Volver a suscribirse a los datos de mercado</strong>: sus datos ya fluyen, eso es lo que significa la luz verde, así que el feed no es el problema.",
        "<strong class='text-white'>Reinstalar NinjaTrader</strong>: una reinstalación limpia no cambiará qué acceso utiliza ni qué derechos tiene su cuenta.",
        "<strong class='text-white'>Suponer que la evaluación está rota</strong>: la cuenta existe en el lado de Rithmic; simplemente NinjaTrader no ha sido autorizado a mostrarla.",
      ],
    },
    { type: "heading",text: "Automatice su cuenta Apex sin el baile de inicios de sesión del escritorio" },
    { type: "paragraph",html: "Hablemos claro: ninguna herramienta de terceros puede añadir un derecho de Rithmic a su cuenta de NinjaTrader. Eso debe venir de NinjaTrader. Lo que una herramienta como PickMyTrade sí puede hacer es sacar por completo el escritorio de NinjaTrader de su ruta de órdenes. Si su objetivo real es enviar señales de TradingView a su cuenta Apex, PickMyTrade mantiene una conexión del lado del servidor con su cuenta y dispara sus alertas directamente hacia ella, de modo que el enrutamiento de órdenes no dependa de que el escritorio esté conectado con la credencial exacta." },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Vinculación de cuenta única</strong>: conecte su cuenta una sola vez en lugar de vigilar qué acceso mantiene hoy el escritorio.",
        "<strong class='text-white'>Señales directas desde TradingView</strong>: las alertas de su estrategia llegan a su cuenta sin una plataforma de gráficos en medio.",
        "<strong class='text-white'>Consciente de Live y simulación</strong>: envíe a la cuenta exacta que desea, lo que importa en cuentas de evaluación que funcionan en simulación.",
        "<strong class='text-white'>Sincronización multicuenta</strong>: replique una alerta en varias cuentas desde un solo lugar, sin necesidad de un inicio de sesión de escritorio por cuenta.",
      ],
    },
    { type: "paragraph",html: "Revise siempre las reglas vigentes de su firma de prop trading sobre el enrutamiento automatizado de órdenes antes de activar nada, ya que cada firma establece sus propias políticas." },
  ], fr: [
    { type: "paragraph",html: "Vous avez acheté une évaluation Apex, configuré la connexion Rithmic dans NinjaTrader, et l'indicateur de connexion est passé au vert. Les cotations défilent, le graphique est en direct, tout semble sain. Puis vous allez passer un trade et il n'y a aucun compte sur lequel trader : pas de solde, pas de pouvoir d'achat, la liste déroulante des comptes est vide. La connexion fonctionne, mais le compte lui-même est introuvable. Voici la version courte. Vous vous êtes presque certainement connecté à NinjaTrader avec un ancien identifiant basé sur Tradovate au lieu d'un compte NinjaTrader natif, et seuls les comptes NinjaTrader portent le droit Rithmic qui fait apparaître votre compte d'évaluation. Déconnectez-vous, redémarrez, reconnectez-vous avec vos identifiants NinjaTrader et confirmez que le droit Rithmic figure sur ce compte. Ci-dessous, ce qui se passe réellement, pourquoi cela piège tant de monde et les étapes exactes pour faire revenir votre solde à l'écran." },
    {
      type: "checklist",
      heading: "Liste de vérification rapide",
      items: [
        "<strong class='text-white'>Vérifiez quel identifiant vous avez utilisé</strong> : le solde du compte ne s'affiche que lorsque vous êtes connecté au bureau NinjaTrader avec votre compte NinjaTrader, et non avec un identifiant Tradovate.",
        "<strong class='text-white'>Confirmez que vous avez un compte NinjaTrader</strong> : créez-en un ou vérifiez-le dans le NinjaTrader Account Dashboard sur account.ninjatrader.com.",
        "<strong class='text-white'>Redémarrez complètement NinjaTrader Desktop</strong> : déconnectez-vous, fermez-le entièrement, rouvrez-le et reconnectez-vous avec le compte NinjaTrader.",
        "<strong class='text-white'>Vérifiez le droit Rithmic</strong> : ouvrez Help puis About et cherchez le droit Evaluation (Rithmic) sur ce compte.",
        "<strong class='text-white'>Droit manquant ? Contactez le support NinjaTrader</strong> : seul celui-ci peut ajouter le droit Evaluation (Rithmic) à votre compte.",
        "<strong class='text-white'>Ignorez l'importation de clé de licence</strong> : elle n'est plus requise, donc réimporter des clés ne ramènera pas le solde.",
        "<strong class='text-white'>Reconnectez-vous proprement</strong> : utilisez un mot de passe Rithmic composé uniquement de lettres et de chiffres, choisissez le profil de connexion de votre firme et sélectionnez Simulation.",
      ],
    },
    { type: "heading",text: "Ce que signifie réellement « connecté mais sans solde »" },
    { type: "paragraph",html: "Le voyant vert de connexion est trompeur. Tout ce qu'il confirme, c'est que Rithmic a accepté vos identifiants et que la voie des données de marché et des ordres est active. C'est une chose distincte de la question de savoir si NinjaTrader est autorisé à <em>afficher</em> un compte donné. NinjaTrader conditionne l'affichage des comptes à un droit au niveau du compte. Lorsque ce droit est présent, votre compte d'évaluation Rithmic se charge avec son solde, son pouvoir d'achat et ses données de position. Lorsqu'il est absent, la plateforme se connecte au flux mais ne renseigne jamais l'objet compte, de sorte que le champ du solde reste vide et qu'il n'y a rien à sélectionner dans le ticket d'ordre." },
    { type: "paragraph",html: "Le droit réside sur votre compte NinjaTrader, et c'est le cœur de tout le problème. De nombreux traders arrivent chez Apex depuis une configuration Tradovate et ont déjà un identifiant basé sur Tradovate enregistré dans NinjaTrader. Cet identifiant vous connecte volontiers au bureau et connecte même le flux Rithmic. Ce qu'il ne fait pas, c'est porter le droit Rithmic, car ce droit n'accompagne que les comptes que vous créez via le NinjaTrader Account Dashboard. Vous vous retrouvez donc dans cet étrange état intermédiaire : connecté, données qui circulent, et pourtant aucun compte sur lequel trader. Ce n'est ni une évaluation défectueuse ni une panne d'Apex. Votre compte d'évaluation ou financé existe depuis le début côté Rithmic. NinjaTrader n'a simplement pas reçu l'autorisation de vous l'afficher." },
    { type: "heading",text: "Pourquoi le compte apparaît vide" },
    { type: "heading",text: "1. Vous vous êtes connecté avec un identifiant basé sur Tradovate" },
    { type: "paragraph",html: "C'est la cause principale, et elle explique la plupart des cas. Si vous avez déjà connecté Tradovate à NinjaTrader, cet identifiant est peut-être encore celui par défaut. S'y connecter relie Rithmic mais retient le droit, de sorte que le compte d'évaluation n'est jamais listé. Le signe : une connexion verte avec une liste de comptes vide et un solde vide." },
    { type: "heading",text: "2. Le droit Evaluation (Rithmic) n'est pas sur votre compte" },
    { type: "paragraph",html: "Même sur un vrai compte NinjaTrader, le droit spécifique Evaluation (Rithmic) doit être activé pour que le compte d'évaluation apparaisse. S'il n'a jamais été appliqué ou s'il est rattaché à un autre compte que celui avec lequel vous êtes connecté, le solde reste masqué. Vous pouvez le vérifier vous-même sous Help puis About, et s'il est absent, le support NinjaTrader doit l'ajouter." },
    { type: "heading",text: "3. Vous suivez encore l'ancien flux de la clé de licence" },
    { type: "paragraph",html: "Les anciens guides de configuration Apex vous demandaient d'importer une clé de licence dans NinjaTrader. Cette étape est supprimée. La connexion repose désormais sur votre compte NinjaTrader et ses droits, et non sur un fichier de clé. Si vous réimportez des clés pour forcer l'apparition du solde, vous dépensez des efforts sur une étape qui ne fait plus rien." },
    { type: "heading",text: "4. Une particularité distincte de la connexion Rithmic s'y ajoute" },
    { type: "paragraph",html: "Parfois l'identifiant est correct mais la connexion elle-même n'aboutit jamais complètement, ce qui vous laisse également sans compte. Les coupables habituels : un mot de passe Rithmic contenant des caractères spéciaux (Rithmic préfère des lettres et des chiffres simples), un mauvais profil de connexion sélectionné au lieu de celui de votre firme, ou une invite Live ou Simulation mal renseignée. Les comptes d'évaluation fonctionnent en simulation, choisissez donc Simulation si on vous le demande." },
    { type: "heading",text: "Comment le corriger : étape par étape" },
    {
      type: "steps",
      items: [
        { title: "Assurez-vous d'avoir un compte NinjaTrader natif", html: "Rendez-vous sur le NinjaTrader Account Dashboard à l'adresse account.ninjatrader.com et vérifiez que vous y avez un compte, ou créez-en un si ce n'est pas le cas. C'est l'identifiant qui porte les droits. Il est distinct de tout identifiant Tradovate que vous avez pu enregistrer, même si l'adresse e-mail paraît similaire. Notez le nom d'utilisateur et le mot de passe exacts que vous définissez ici, car c'est ce que vous utiliserez pour vous connecter au bureau." },
        { title: "Redémarrez NinjaTrader et connectez-vous avec le compte NinjaTrader", html: "Ne vous contentez pas de vous reconnecter. Déconnectez-vous entièrement du bureau, fermez l'application, rouvrez-la et, à l'invite de connexion, entrez les identifiants de votre compte NinjaTrader de l'étape précédente. Un redémarrage complet est important ici, car l'ensemble des droits est lu à la connexion ; changer de compte sans redémarrer peut laisser la plateforme sur l'ancienne session sans droits. Une fois connecté avec le bon compte, rouvrez votre connexion Rithmic." },
        { title: "Vérifiez le droit Rithmic sous Help puis About", html: "Le compte NinjaTrader étant connecté, ouvrez <strong class='text-white'>Help</strong> puis <strong class='text-white'>About</strong>. La plateforme liste les droits associés à votre compte. Cherchez un droit <strong class='text-white'>Evaluation (Rithmic)</strong>. S'il est présent, votre compte d'évaluation devrait maintenant apparaître dans la liste des comptes avec son solde renseigné, et vous avez terminé. Vérifiez le libellé exact dans votre version actuelle, car NinjaTrader ajuste la formulation d'une version à l'autre." },
        { title: "Si le droit est absent, contactez le support NinjaTrader", html: "Si Help puis About ne liste pas le droit Evaluation (Rithmic), NinjaTrader ne l'a pas activé sur votre compte et il n'existe aucun interrupteur en libre-service. Contactez directement le support NinjaTrader, indiquez que vous connectez une évaluation Apex via Rithmic et demandez-lui d'ajouter le droit Evaluation (Rithmic) à votre compte NinjaTrader. Une fois qu'il confirme l'application, redémarrez NinjaTrader et reconnectez-vous. Le solde devrait s'afficher à la connexion suivante." },
        { title: "Nettoyez la connexion Rithmic elle-même", html: "Si vous utilisez le bon identifiant et que le droit est présent mais que la connexion n'aboutit toujours pas, remettez en ordre les détails de connexion. Réinitialisez votre mot de passe Rithmic avec uniquement des lettres et des chiffres s'il contient des symboles, car les caractères spéciaux peuvent faire échouer la négociation. Assurez-vous d'avoir sélectionné le profil de connexion de votre firme plutôt qu'une option générique et, si on vous demande de choisir entre Live et Simulation, choisissez Simulation. Laissez la connexion se stabiliser et le compte se charger avant de passer des ordres." },
      ],
    },
    { type: "heading",text: "Ce qui ne mérite pas votre temps" },
    { type: "paragraph",html: "Une fois la connexion verte, plusieurs réflexes vous mènent à des impasses. Ignorez-les tant que vous n'avez pas vérifié l'identifiant et le droit :" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Réimporter une clé de licence</strong> : le flux de clé est supprimé et ne fera pas apparaître un solde manquant.",
        "<strong class='text-white'>Se réabonner aux données de marché</strong> : vos données circulent déjà, c'est ce que signifie le voyant vert, donc le flux n'est pas le problème.",
        "<strong class='text-white'>Réinstaller NinjaTrader</strong> : une réinstallation propre ne changera ni l'identifiant que vous utilisez ni les droits de votre compte.",
        "<strong class='text-white'>Supposer que l'évaluation est cassée</strong> : le compte existe côté Rithmic ; NinjaTrader n'a simplement pas été autorisé à l'afficher.",
      ],
    },
    { type: "heading",text: "Automatisez votre compte Apex sans la danse des connexions de bureau" },
    { type: "paragraph",html: "Parlons franchement : aucun outil tiers ne peut ajouter un droit Rithmic à votre compte NinjaTrader. Cela doit venir de NinjaTrader. Ce qu'un outil comme PickMyTrade peut faire, c'est sortir entièrement le bureau NinjaTrader de votre chemin d'ordres. Si votre véritable objectif est d'envoyer des signaux TradingView vers votre compte Apex, PickMyTrade maintient une connexion côté serveur avec votre compte et y déclenche directement vos alertes, de sorte que le routage des ordres ne dépend pas du fait que le bureau soit connecté avec les bons identifiants exacts." },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Liaison de compte unique</strong> : connectez votre compte une seule fois au lieu de surveiller quel identifiant le bureau utilise aujourd'hui.",
        "<strong class='text-white'>Signaux directement depuis TradingView</strong> : les alertes de votre stratégie sont acheminées vers votre compte sans plateforme graphique au milieu.",
        "<strong class='text-white'>Conscient du mode live et simulation</strong> : envoyez vers le compte exact visé, ce qui compte sur les comptes d'évaluation fonctionnant en simulation.",
        "<strong class='text-white'>Synchronisation multi-comptes</strong> : répliquez une alerte sur plusieurs comptes depuis un seul endroit, sans connexion de bureau par compte.",
      ],
    },
    { type: "paragraph",html: "Vérifiez toujours les règles actuelles de votre prop firm sur l'acheminement automatisé des ordres avant d'activer quoi que ce soit, car chaque firme fixe ses propres politiques." },
  ], it: [
    { type: "paragraph",html: "Ha acquistato una valutazione Apex, ha configurato la connessione Rithmic in NinjaTrader e l'indicatore di connessione è diventato verde. Le quotazioni scorrono, il grafico è live, tutto sembra in ordine. Poi va a piazzare un trade e non c'è alcun conto su cui operare: nessun saldo, nessun potere d'acquisto, il menu a tendina dei conti è vuoto. La connessione funziona, ma il conto non si trova da nessuna parte. Ecco la versione breve. Con ogni probabilità ha effettuato l'accesso a NinjaTrader con un vecchio login basato su Tradovate invece che con un account NinjaTrader nativo, e solo gli account NinjaTrader portano il diritto Rithmic che fa comparire il Suo conto di valutazione. Esca, riavvii, acceda di nuovo con le Sue credenziali NinjaTrader e confermi che il diritto Rithmic sia presente su quell'account. Di seguito trova cosa succede davvero, perché inciampano in tanti e i passaggi esatti per riportare il saldo sullo schermo." },
    {
      type: "checklist",
      heading: "Checklist rapida",
      items: [
        "<strong class='text-white'>Verifichi quale login ha usato</strong>: il saldo del conto compare solo quando ha effettuato l'accesso al desktop di NinjaTrader con il Suo account NinjaTrader, non con un login Tradovate.",
        "<strong class='text-white'>Confermi di avere un account NinjaTrader</strong>: ne crei o ne verifichi uno nel NinjaTrader Account Dashboard su account.ninjatrader.com.",
        "<strong class='text-white'>Riavvii completamente NinjaTrader Desktop</strong>: esca, lo chiuda del tutto, lo riapra e acceda di nuovo con l'account NinjaTrader.",
        "<strong class='text-white'>Verifichi il diritto Rithmic</strong>: apra Help e poi About e cerchi il diritto Evaluation (Rithmic) su quell'account.",
        "<strong class='text-white'>Diritto mancante? Contatti il supporto NinjaTrader</strong>: solo loro possono aggiungere il diritto Evaluation (Rithmic) al Suo account.",
        "<strong class='text-white'>Salti l'importazione della chiave di licenza</strong>: non è più richiesta, quindi reimportare le chiavi non riporterà il saldo.",
        "<strong class='text-white'>Si riconnetta correttamente</strong>: usi una password Rithmic composta solo da lettere e numeri, scelga il profilo di connessione della Sua azienda e selezioni Simulation.",
      ],
    },
    { type: "heading",text: "Cosa significa davvero «connesso ma senza saldo»" },
    { type: "paragraph",html: "La luce verde di connessione inganna. Tutto ciò che conferma è che Rithmic ha accettato le Sue credenziali e che il percorso dei dati di mercato e degli ordini è attivo. È una cosa distinta dal fatto che NinjaTrader sia autorizzato a <em>mostrare</em> un determinato conto. NinjaTrader subordina la visualizzazione dei conti a un diritto a livello di account. Quando tale diritto è presente, il Suo conto di valutazione Rithmic si carica con saldo, potere d'acquisto e dati di posizione. Quando manca, la piattaforma si connette al feed ma non popola mai l'oggetto conto, quindi il campo del saldo resta vuoto e non c'è nulla da selezionare nel ticket d'ordine." },
    { type: "paragraph",html: "Il diritto risiede sul Suo account NinjaTrader, ed è questo il nodo di tutto il problema. Molti trader arrivano ad Apex da una configurazione Tradovate e hanno già un login basato su Tradovate salvato in NinjaTrader. Quella credenziale La farà accedere volentieri al desktop e collegherà persino il feed Rithmic. Ciò che non fa è portare il diritto Rithmic, perché quel diritto accompagna solo gli account creati tramite il NinjaTrader Account Dashboard. Si ritrova così in questo strano stato intermedio: connesso, dati che scorrono, eppure nessun conto su cui operare. Non è una valutazione difettosa e non è un'interruzione di Apex. Il Suo conto di valutazione o finanziato esiste da sempre sul lato Rithmic. NinjaTrader semplicemente non ha ricevuto il permesso di mostrarglielo." },
    { type: "heading",text: "Perché il conto compare vuoto" },
    { type: "heading",text: "1. Ha effettuato l'accesso con un login basato su Tradovate" },
    { type: "paragraph",html: "È il motivo principale e spiega la maggior parte dei casi. Se in passato ha collegato Tradovate a NinjaTrader, quel login potrebbe essere ancora quello predefinito. Accedere con esso connette Rithmic ma trattiene il diritto, quindi il conto di valutazione non viene mai elencato. Il segnale è una connessione verde con il menu dei conti vuoto e il saldo vuoto." },
    { type: "heading",text: "2. Il diritto Evaluation (Rithmic) non è presente sul Suo account" },
    { type: "paragraph",html: "Anche su un account NinjaTrader corretto, lo specifico diritto Evaluation (Rithmic) deve essere abilitato affinché il conto di valutazione compaia. Se non è mai stato applicato o è associato a un account diverso da quello con cui ha effettuato l'accesso, il saldo resta nascosto. Può verificarlo da solo in Help e poi About, e se è assente, il supporto NinjaTrader deve aggiungerlo." },
    { type: "heading",text: "3. Sta ancora seguendo il vecchio flusso della chiave di licenza" },
    { type: "paragraph",html: "Le vecchie guide di configurazione Apex indicavano di importare una chiave di licenza in NinjaTrader. Quel passaggio è stato eliminato. La connessione ora si basa sul Suo account NinjaTrader e sui suoi diritti, non su un file chiave. Se reimporta le chiavi per forzare la comparsa del saldo, sta spendendo energie su un passaggio che non fa più nulla." },
    { type: "heading",text: "4. Una particolarità separata della connessione Rithmic si sovrappone" },
    { type: "paragraph",html: "A volte il login è corretto ma la connessione stessa non si completa del tutto, lasciandoLa comunque senza conto. I soliti responsabili: una password Rithmic con caratteri speciali (Rithmic preferisce semplici lettere e numeri), il profilo di connessione sbagliato selezionato al posto di quello della Sua azienda, o una richiesta Live o Simulation risposta in modo errato. I conti di valutazione funzionano in simulazione, quindi scelga Simulation se richiesto." },
    { type: "heading",text: "Come risolvere: passo dopo passo" },
    {
      type: "steps",
      items: [
        { title: "Si assicuri di avere un account NinjaTrader nativo", html: "Vada al NinjaTrader Account Dashboard su account.ninjatrader.com e confermi di avere lì un account, oppure ne crei uno se non lo ha. È la credenziale che porta i diritti. È diversa da qualsiasi login Tradovate che potrebbe aver salvato, anche se l'e-mail sembra simile. Annoti il nome utente e la password esatti che imposta qui, perché sono quelli che userà per accedere al desktop." },
        { title: "Riavvii NinjaTrader e acceda con l'account NinjaTrader", html: "Non si limiti a riconnettersi. Esca completamente dal desktop, chiuda l'applicazione, la riapra e, alla richiesta di accesso, inserisca le credenziali del Suo account NinjaTrader del passaggio precedente. Un riavvio completo è importante perché l'insieme dei diritti viene letto al login, quindi cambiare account senza riavviare può lasciare la piattaforma con la vecchia sessione priva di diritti. Una volta entrato con l'account corretto, riapra la Sua connessione Rithmic." },
        { title: "Verifichi il diritto Rithmic in Help e poi About", html: "Con l'account NinjaTrader connesso, apra <strong class='text-white'>Help</strong> e poi <strong class='text-white'>About</strong>. La piattaforma elenca i diritti associati al Suo account. Cerchi un diritto <strong class='text-white'>Evaluation (Rithmic)</strong>. Se è presente, il Suo conto di valutazione dovrebbe ora comparire nell'elenco dei conti con il saldo compilato, e ha finito. Verifichi l'etichetta esatta nella Sua build attuale, poiché NinjaTrader modifica la dicitura tra una versione e l'altra." },
        { title: "Se il diritto manca, contatti il supporto NinjaTrader", html: "Se Help e poi About non elenca il diritto Evaluation (Rithmic), NinjaTrader non lo ha abilitato sul Suo account e non esiste un interruttore self-service. Contatti direttamente il supporto NinjaTrader, indichi che sta collegando una valutazione Apex tramite Rithmic e chieda di aggiungere il diritto Evaluation (Rithmic) al Suo account NinjaTrader. Una volta che confermano l'applicazione, riavvii NinjaTrader e si riconnetta. Il saldo dovrebbe popolarsi alla connessione successiva." },
        { title: "Ripulisca la connessione Rithmic stessa", html: "Se usa il login corretto e il diritto è presente ma la connessione continua a non completarsi, riordini i dettagli di connessione. Reimposti la Sua password Rithmic con solo lettere e numeri se contiene simboli, poiché i caratteri speciali possono interrompere l'handshake. Si assicuri di aver selezionato il profilo di connessione della Sua azienda anziché un'opzione generica e, se Le viene chiesto di scegliere tra Live e Simulation, scelga Simulation. Lasci che la connessione si stabilizzi e che il conto si carichi prima di piazzare qualsiasi ordine." },
      ],
    },
    { type: "heading",text: "Su cosa non perdere tempo" },
    { type: "paragraph",html: "Una volta che la connessione è verde, diversi istinti portano a vicoli ciechi. Li salti finché non ha verificato il login e il diritto:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Reimportare una chiave di licenza</strong>: il flusso della chiave è stato eliminato e non farà comparire un saldo mancante.",
        "<strong class='text-white'>Riabbonarsi ai dati di mercato</strong>: i Suoi dati scorrono già, è ciò che significa la luce verde, quindi il feed non è il problema.",
        "<strong class='text-white'>Reinstallare NinjaTrader</strong>: una reinstallazione pulita non cambierà quale login usa né quali diritti ha il Suo account.",
        "<strong class='text-white'>Presumere che la valutazione sia rotta</strong>: il conto esiste sul lato Rithmic; NinjaTrader semplicemente non è stato autorizzato a mostrarlo.",
      ],
    },
    { type: "heading",text: "Automatizzi il Suo conto Apex senza la danza dei login del desktop" },
    { type: "paragraph",html: "Parliamoci chiaro: nessuno strumento di terze parti può aggiungere un diritto Rithmic al Suo account NinjaTrader. Deve arrivare da NinjaTrader. Ciò che uno strumento come PickMyTrade può fare è togliere del tutto il desktop di NinjaTrader dal Suo percorso degli ordini. Se il Suo vero obiettivo è inviare segnali TradingView al Suo conto Apex, PickMyTrade mantiene una connessione lato server con il Suo conto e vi invia direttamente i Suoi alert, quindi l'instradamento degli ordini non dipende dal fatto che il desktop sia collegato con le credenziali esatte." },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Collegamento del conto una tantum</strong>: colleghi il Suo conto una sola volta invece di controllare quale login tiene oggi il desktop.",
        "<strong class='text-white'>Segnali direttamente da TradingView</strong>: gli alert della Sua strategia raggiungono il Suo conto senza una piattaforma grafica nel mezzo.",
        "<strong class='text-white'>Consapevole di live e simulazione</strong>: invii al conto esatto che intende, il che conta sui conti di valutazione che funzionano in simulazione.",
        "<strong class='text-white'>Sincronizzazione multi-conto</strong>: replichi un alert su più conti da un unico posto, senza un login desktop per ogni conto.",
      ],
    },
    { type: "paragraph",html: "Verifichi sempre le regole attuali della Sua prop firm sull'instradamento automatizzato degli ordini prima di attivare qualsiasi cosa, poiché ogni azienda stabilisce le proprie politiche." },
  ] },
  ctaHeading: { en: "Route Your Alerts Straight to Your Account", de: "Leiten Sie Ihre Alerts direkt an Ihr Konto", es: "Envíe sus alertas directamente a su cuenta", fr: "Acheminez vos alertes directement vers votre compte", it: "Instradi i Suoi alert direttamente sul Suo conto" },
  ctaText: { en: "PickMyTrade holds a server-side connection to your account, so orders don't depend on the desktop being logged into the exact right credential.", de: "PickMyTrade hält eine serverseitige Verbindung zu Ihrem Konto, sodass Orders nicht davon abhängen, dass der Desktop mit genau den richtigen Zugangsdaten angemeldet ist.", es: "PickMyTrade mantiene una conexión del lado del servidor con su cuenta, de modo que las órdenes no dependen de que el escritorio esté conectado con la credencial exacta.", fr: "PickMyTrade maintient une connexion côté serveur avec votre compte, de sorte que les ordres ne dépendent pas du fait que le bureau soit connecté avec les bons identifiants exacts.", it: "PickMyTrade mantiene una connessione lato server con il Suo conto, quindi gli ordini non dipendono dal fatto che il desktop sia collegato con le credenziali esatte." },
  ctaButtonText: { en: "Start Your Free 7-Day Trial", de: "Starten Sie Ihre kostenlose 7-Tage-Testphase", es: "Comience su prueba gratuita de 7 días", fr: "Commencez votre essai gratuit de 7 jours", it: "Inizi la prova gratuita di 7 giorni" },
  ctaUrl: "https://app.pickmytrade.trade/?register=true&utm_source=content&utm_medium=debugging",
  faqHeading: { en: "Frequently Asked Questions", de: "Häufig gestellte Fragen", es: "Preguntas frecuentes", fr: "Questions fréquentes", it: "Domande frequenti" },
  faqs: { en: [
    { q: "Why does my Apex evaluation connect in NinjaTrader but show no balance?", a: "Almost always because you logged into NinjaTrader with an old Tradovate-based login instead of a native NinjaTrader account. The Rithmic connection authenticates and turns green, so data flows, but only NinjaTrader accounts carry the Rithmic entitlement that actually displays your connected evaluation account. Without it, the account never populates, so you see no balance and nothing to trade against. Log out, restart NinjaTrader, and sign back in with your NinjaTrader account credentials." },
    { q: "What's the difference between a NinjaTrader account and a Tradovate login?", a: "A NinjaTrader account is the login you create in the NinjaTrader Account Dashboard at account.ninjatrader.com. A Tradovate login is a separate broker credential. Both can sign you into the NinjaTrader desktop, but only the NinjaTrader account carries the entitlements that let Rithmic evaluation accounts appear. If you sign in with the Tradovate credential, the platform connects but never lists the Rithmic account, which is why the balance is blank." },
    { q: "Where do I find the Evaluation (Rithmic) entitlement in NinjaTrader?", a: "Open the NinjaTrader desktop and check Help then About, where the platform lists the entitlements tied to the account you're logged in with. Look for an Evaluation (Rithmic) entitlement. Confirm the exact wording in your current build, since labels change over time. If it's not listed, the account you're signed in with doesn't have it, and NinjaTrader Support has to add it before your evaluation account will display." },
    { q: "Do I still need to import an Apex license key into NinjaTrader?", a: "No. Importing a license key used to be part of the setup, but it's no longer necessary. The connection now runs off your NinjaTrader account and its entitlements rather than a key file. If you're chasing a missing balance by re-importing keys, you're working the wrong problem. Focus on which login you used and whether the Rithmic entitlement is present." },
    { q: "My Rithmic connection turns green but the account still won't show. What now?", a: "A green light only means Rithmic accepted your credentials and the data route is live. It says nothing about whether the account is entitled to display. First confirm you're logged into NinjaTrader with your NinjaTrader account, not a Tradovate login. Then verify the Evaluation (Rithmic) entitlement under Help then About. If you're on the right login and the entitlement is missing, contact NinjaTrader Support and ask them to add it, then restart and reconnect." },
    { q: "Does resetting my Rithmic password fix a missing balance?", a: "Only if the connection itself was failing. A password with special characters can stop a Rithmic connection from completing, and resetting it to letters and numbers only often clears that. But if your connection is already green and the balance is still blank, the password isn't your problem. That's an entitlement and login issue, so fixing the password won't make the account appear." },
  ], de: [
    { q: "Warum verbindet sich meine Apex-Evaluation in NinjaTrader, zeigt aber keinen Kontostand an?", a: "Fast immer, weil Sie sich bei NinjaTrader mit einem alten Tradovate-basierten Login statt mit einem nativen NinjaTrader-Konto angemeldet haben. Die Rithmic-Verbindung authentifiziert sich und wird grün, daher fließen Daten, aber nur NinjaTrader-Konten tragen die Rithmic-Berechtigung, die Ihr verbundenes Evaluationskonto tatsächlich anzeigt. Ohne sie wird das Konto nie befüllt, sodass Sie keinen Kontostand und nichts zum Handeln sehen. Melden Sie sich ab, starten Sie NinjaTrader neu und melden Sie sich erneut mit den Zugangsdaten Ihres NinjaTrader-Kontos an." },
    { q: "Was ist der Unterschied zwischen einem NinjaTrader-Konto und einem Tradovate-Login?", a: "Ein NinjaTrader-Konto ist der Login, den Sie im NinjaTrader Account Dashboard unter account.ninjatrader.com erstellen. Ein Tradovate-Login ist eine separate Broker-Zugangsberechtigung. Mit beiden können Sie sich am NinjaTrader-Desktop anmelden, aber nur das NinjaTrader-Konto trägt die Berechtigungen, durch die Rithmic-Evaluationskonten erscheinen. Wenn Sie sich mit den Tradovate-Zugangsdaten anmelden, verbindet sich die Plattform, listet das Rithmic-Konto aber nie auf. Deshalb ist der Kontostand leer." },
    { q: "Wo finde ich die Berechtigung „Evaluation (Rithmic)“ in NinjaTrader?", a: "Öffnen Sie den NinjaTrader-Desktop und prüfen Sie Help und dann About. Dort listet die Plattform die Berechtigungen auf, die mit dem Konto verknüpft sind, mit dem Sie angemeldet sind. Suchen Sie nach einer Berechtigung Evaluation (Rithmic). Prüfen Sie die genaue Bezeichnung in Ihrer aktuellen Version, da sich Beschriftungen im Laufe der Zeit ändern. Ist sie nicht aufgeführt, besitzt das Konto, mit dem Sie angemeldet sind, sie nicht, und der NinjaTrader-Support muss sie hinzufügen, bevor Ihr Evaluationskonto angezeigt wird." },
    { q: "Muss ich noch einen Apex-Lizenzschlüssel in NinjaTrader importieren?", a: "Nein. Der Import eines Lizenzschlüssels war früher Teil der Einrichtung, ist aber nicht mehr nötig. Die Verbindung läuft jetzt über Ihr NinjaTrader-Konto und dessen Berechtigungen statt über eine Schlüsseldatei. Wenn Sie einem fehlenden Kontostand durch erneutes Importieren von Schlüsseln nachjagen, arbeiten Sie am falschen Problem. Konzentrieren Sie sich darauf, welchen Login Sie verwendet haben und ob die Rithmic-Berechtigung vorhanden ist." },
    { q: "Meine Rithmic-Verbindung wird grün, aber das Konto erscheint trotzdem nicht. Was nun?", a: "Ein grünes Licht bedeutet nur, dass Rithmic Ihre Zugangsdaten akzeptiert hat und der Datenweg live ist. Es sagt nichts darüber aus, ob das Konto zur Anzeige berechtigt ist. Bestätigen Sie zuerst, dass Sie bei NinjaTrader mit Ihrem NinjaTrader-Konto angemeldet sind und nicht mit einem Tradovate-Login. Prüfen Sie dann die Berechtigung Evaluation (Rithmic) unter Help und dann About. Wenn Sie den richtigen Login verwenden und die Berechtigung fehlt, wenden Sie sich an den NinjaTrader-Support, bitten Sie um deren Hinzufügung und starten Sie anschließend neu und verbinden Sie sich erneut." },
    { q: "Behebt das Zurücksetzen meines Rithmic-Passworts einen fehlenden Kontostand?", a: "Nur, wenn die Verbindung selbst fehlgeschlagen ist. Ein Passwort mit Sonderzeichen kann verhindern, dass eine Rithmic-Verbindung zustande kommt, und das Zurücksetzen auf ausschließlich Buchstaben und Zahlen löst das oft. Wenn Ihre Verbindung aber bereits grün ist und der Kontostand trotzdem leer bleibt, liegt es nicht am Passwort. Dann handelt es sich um ein Berechtigungs- und Login-Problem, und eine Passwortänderung lässt das Konto nicht erscheinen." },
  ], es: [
    { q: "¿Por qué mi evaluación de Apex se conecta en NinjaTrader pero no muestra saldo?", a: "Casi siempre porque inició sesión en NinjaTrader con un antiguo acceso basado en Tradovate en lugar de una cuenta nativa de NinjaTrader. La conexión Rithmic se autentica y se pone en verde, por lo que los datos fluyen, pero solo las cuentas de NinjaTrader llevan el derecho de Rithmic que realmente muestra su cuenta de evaluación conectada. Sin él, la cuenta nunca se carga, así que no ve saldo ni nada con lo que operar. Cierre sesión, reinicie NinjaTrader y vuelva a iniciar sesión con las credenciales de su cuenta de NinjaTrader." },
    { q: "¿Cuál es la diferencia entre una cuenta de NinjaTrader y un acceso de Tradovate?", a: "Una cuenta de NinjaTrader es el acceso que crea en el NinjaTrader Account Dashboard en account.ninjatrader.com. Un acceso de Tradovate es una credencial de bróker independiente. Ambos pueden iniciar sesión en el escritorio de NinjaTrader, pero solo la cuenta de NinjaTrader lleva los derechos que hacen aparecer las cuentas de evaluación de Rithmic. Si inicia sesión con la credencial de Tradovate, la plataforma se conecta pero nunca lista la cuenta de Rithmic, y por eso el saldo aparece en blanco." },
    { q: "¿Dónde encuentro el derecho Evaluation (Rithmic) en NinjaTrader?", a: "Abra el escritorio de NinjaTrader y revise Help y luego About, donde la plataforma lista los derechos asociados a la cuenta con la que ha iniciado sesión. Busque un derecho Evaluation (Rithmic). Confirme la redacción exacta en su versión actual, ya que las etiquetas cambian con el tiempo. Si no aparece, la cuenta con la que ha iniciado sesión no lo tiene, y el soporte de NinjaTrader debe añadirlo antes de que se muestre su cuenta de evaluación." },
    { q: "¿Todavía necesito importar una clave de licencia de Apex en NinjaTrader?", a: "No. Importar una clave de licencia formaba parte de la configuración, pero ya no es necesario. La conexión ahora funciona con su cuenta de NinjaTrader y sus derechos, en lugar de un archivo de clave. Si persigue un saldo que falta volviendo a importar claves, está trabajando en el problema equivocado. Concéntrese en qué acceso utilizó y en si el derecho de Rithmic está presente." },
    { q: "Mi conexión Rithmic se pone en verde pero la cuenta sigue sin aparecer. ¿Qué hago?", a: "Una luz verde solo significa que Rithmic aceptó sus credenciales y que la ruta de datos está activa. No indica nada sobre si la cuenta tiene derecho a mostrarse. Primero confirme que ha iniciado sesión en NinjaTrader con su cuenta de NinjaTrader, no con un acceso de Tradovate. Luego verifique el derecho Evaluation (Rithmic) en Help y luego About. Si utiliza el acceso correcto y falta el derecho, contacte con el soporte de NinjaTrader y pídales que lo añadan; después reinicie y vuelva a conectarse." },
    { q: "¿Restablecer mi contraseña de Rithmic soluciona un saldo que no aparece?", a: "Solo si la conexión en sí estaba fallando. Una contraseña con caracteres especiales puede impedir que se complete una conexión Rithmic, y restablecerla con solo letras y números a menudo lo resuelve. Pero si su conexión ya está en verde y el saldo sigue en blanco, la contraseña no es el problema. Se trata de un problema de derechos y de acceso, por lo que arreglar la contraseña no hará que aparezca la cuenta." },
  ], fr: [
    { q: "Pourquoi mon évaluation Apex se connecte-t-elle dans NinjaTrader mais n'affiche-t-elle aucun solde ?", a: "Presque toujours parce que vous vous êtes connecté à NinjaTrader avec un ancien identifiant basé sur Tradovate au lieu d'un compte NinjaTrader natif. La connexion Rithmic s'authentifie et passe au vert, donc les données circulent, mais seuls les comptes NinjaTrader portent le droit Rithmic qui affiche réellement votre compte d'évaluation connecté. Sans lui, le compte ne se remplit jamais, si bien que vous ne voyez aucun solde ni rien sur quoi trader. Déconnectez-vous, redémarrez NinjaTrader et reconnectez-vous avec les identifiants de votre compte NinjaTrader." },
    { q: "Quelle est la différence entre un compte NinjaTrader et un identifiant Tradovate ?", a: "Un compte NinjaTrader est l'identifiant que vous créez dans le NinjaTrader Account Dashboard sur account.ninjatrader.com. Un identifiant Tradovate est une information d'identification de courtier distincte. Les deux peuvent vous connecter au bureau NinjaTrader, mais seul le compte NinjaTrader porte les droits qui font apparaître les comptes d'évaluation Rithmic. Si vous vous connectez avec l'identifiant Tradovate, la plateforme se connecte mais ne liste jamais le compte Rithmic, ce qui explique le solde vide." },
    { q: "Où trouver le droit Evaluation (Rithmic) dans NinjaTrader ?", a: "Ouvrez le bureau NinjaTrader et consultez Help puis About, où la plateforme liste les droits associés au compte avec lequel vous êtes connecté. Cherchez un droit Evaluation (Rithmic). Vérifiez le libellé exact dans votre version actuelle, car les intitulés évoluent avec le temps. S'il n'est pas listé, le compte avec lequel vous êtes connecté ne l'a pas, et le support NinjaTrader doit l'ajouter avant que votre compte d'évaluation s'affiche." },
    { q: "Dois-je encore importer une clé de licence Apex dans NinjaTrader ?", a: "Non. L'importation d'une clé de licence faisait autrefois partie de la configuration, mais elle n'est plus nécessaire. La connexion repose désormais sur votre compte NinjaTrader et ses droits plutôt que sur un fichier de clé. Si vous cherchez un solde manquant en réimportant des clés, vous travaillez sur le mauvais problème. Concentrez-vous sur l'identifiant utilisé et sur la présence du droit Rithmic." },
    { q: "Ma connexion Rithmic passe au vert mais le compte n'apparaît toujours pas. Que faire ?", a: "Un voyant vert signifie seulement que Rithmic a accepté vos identifiants et que la voie de données est active. Il ne dit rien sur le fait que le compte soit autorisé à s'afficher. Commencez par confirmer que vous êtes connecté à NinjaTrader avec votre compte NinjaTrader, et non avec un identifiant Tradovate. Vérifiez ensuite le droit Evaluation (Rithmic) sous Help puis About. Si vous utilisez le bon identifiant et que le droit est absent, contactez le support NinjaTrader et demandez-lui de l'ajouter, puis redémarrez et reconnectez-vous." },
    { q: "Réinitialiser mon mot de passe Rithmic corrige-t-il un solde manquant ?", a: "Uniquement si la connexion elle-même échouait. Un mot de passe contenant des caractères spéciaux peut empêcher l'aboutissement d'une connexion Rithmic, et le réinitialiser avec uniquement des lettres et des chiffres règle souvent le problème. Mais si votre connexion est déjà verte et que le solde reste vide, le mot de passe n'est pas en cause. Il s'agit d'un problème de droits et d'identifiant, et corriger le mot de passe ne fera pas apparaître le compte." },
  ], it: [
    { q: "Perché la mia valutazione Apex si connette in NinjaTrader ma non mostra alcun saldo?", a: "Quasi sempre perché ha effettuato l'accesso a NinjaTrader con un vecchio login basato su Tradovate invece che con un account NinjaTrader nativo. La connessione Rithmic si autentica e diventa verde, quindi i dati scorrono, ma solo gli account NinjaTrader portano il diritto Rithmic che mostra effettivamente il Suo conto di valutazione collegato. Senza di esso, il conto non viene mai popolato, quindi non vede alcun saldo né nulla su cui operare. Esca, riavvii NinjaTrader e acceda di nuovo con le credenziali del Suo account NinjaTrader." },
    { q: "Qual è la differenza tra un account NinjaTrader e un login Tradovate?", a: "Un account NinjaTrader è il login che crea nel NinjaTrader Account Dashboard su account.ninjatrader.com. Un login Tradovate è una credenziale broker separata. Entrambi possono farLa accedere al desktop di NinjaTrader, ma solo l'account NinjaTrader porta i diritti che fanno comparire i conti di valutazione Rithmic. Se accede con la credenziale Tradovate, la piattaforma si connette ma non elenca mai il conto Rithmic, ed è per questo che il saldo è vuoto." },
    { q: "Dove trovo il diritto Evaluation (Rithmic) in NinjaTrader?", a: "Apra il desktop di NinjaTrader e controlli Help e poi About, dove la piattaforma elenca i diritti associati all'account con cui ha effettuato l'accesso. Cerchi un diritto Evaluation (Rithmic). Verifichi la dicitura esatta nella Sua build attuale, poiché le etichette cambiano nel tempo. Se non è elencato, l'account con cui ha effettuato l'accesso non lo possiede, e il supporto NinjaTrader deve aggiungerlo prima che il Suo conto di valutazione venga mostrato." },
    { q: "Devo ancora importare una chiave di licenza Apex in NinjaTrader?", a: "No. L'importazione di una chiave di licenza faceva parte della configurazione, ma non è più necessaria. La connessione ora si basa sul Suo account NinjaTrader e sui suoi diritti anziché su un file chiave. Se cerca di risolvere un saldo mancante reimportando le chiavi, sta lavorando sul problema sbagliato. Si concentri su quale login ha usato e sulla presenza del diritto Rithmic." },
    { q: "La mia connessione Rithmic diventa verde ma il conto continua a non comparire. Cosa faccio?", a: "Una luce verde significa solo che Rithmic ha accettato le Sue credenziali e che il percorso dei dati è attivo. Non dice nulla su se il conto abbia il diritto di essere visualizzato. Per prima cosa verifichi di aver effettuato l'accesso a NinjaTrader con il Suo account NinjaTrader, non con un login Tradovate. Poi controlli il diritto Evaluation (Rithmic) in Help e poi About. Se usa il login corretto e il diritto manca, contatti il supporto NinjaTrader e chieda di aggiungerlo, quindi riavvii e si riconnetta." },
    { q: "Reimpostare la mia password Rithmic risolve un saldo mancante?", a: "Solo se la connessione stessa non andava a buon fine. Una password con caratteri speciali può impedire il completamento di una connessione Rithmic, e reimpostarla con solo lettere e numeri spesso risolve. Ma se la Sua connessione è già verde e il saldo resta vuoto, la password non è il problema. Si tratta di un problema di diritti e di login, quindi correggere la password non farà comparire il conto." },
  ] },
