---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "tradingview-order-rejected-live-tradovate";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/debugging/${SLUG}`;

const META_TITLE = "TradingView Order Rejected on Live Tradovate Account";
const META_DESCRIPTION =
  "TradingView order rejected on live Tradovate but demo works? Fix live market data, sign the data agreement, and approve your device to trade again.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "TradingView-Order auf dem Live-Tradovate-Konto abgelehnt", es: "Orden de TradingView rechazada en la cuenta real de Tradovate", fr: "Ordre TradingView rejeté sur un compte Tradovate réel", it: "Ordine TradingView rifiutato sul conto Tradovate reale" },
  dek: { en: "The exact same TradingView alert fills instantly on sim but bounces rejected on your live Tradovate account. Here's the short list of live-only gates, data, agreement, device, entitlement, and how to clear each one.", de: "Derselbe TradingView-Alert wird im Sim-Konto sofort ausgeführt, auf Ihrem Live-Tradovate-Konto aber abgelehnt. Hier ist die kurze Liste der reinen Live-Hürden – Daten, Vereinbarung, Gerät, Berechtigung – und wie Sie jede einzelne beseitigen.", es: "La misma alerta de TradingView se ejecuta al instante en sim, pero rebota rechazada en su cuenta real de Tradovate. Esta es la lista corta de requisitos exclusivos de la cuenta real (datos, acuerdo, dispositivo, habilitación) y cómo resolver cada uno.", fr: "La même alerte TradingView s'exécute instantanément en sim, mais est rejetée sur votre compte Tradovate réel. Voici la courte liste des verrous propres au réel (données, accord, appareil, habilitation) et comment lever chacun d'eux.", it: "Lo stesso alert di TradingView viene eseguito subito sul sim ma viene rifiutato sul Suo conto Tradovate reale. Ecco l'elenco breve dei requisiti validi solo per il reale (dati, accordo, dispositivo, abilitazione) e come risolvere ciascuno." },
  readTime: { en: "8 min read", de: "8 Min. Lesezeit", es: "Lectura de 8 min", fr: "Lecture : 8 min", it: "Lettura di 8 min" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "You funded your live Tradovate account, wired a TradingView strategy to it, hit <strong class='text-white'>Buy</strong>, and the order bounced straight back rejected. Meanwhile the exact same alert fills instantly on your sim account. It's one of the most common (and most maddening) Tradovate problems, and here's the reassuring part: a rejection that shows up <strong class='text-white'>only on live</strong> almost never means your strategy is broken. It means one of a short list of account-state gates isn't satisfied yet, live market data, a signed data agreement, device approval, or the TradingView entitlement. It might land as a <code>Non-tradable symbol</code> message, a <code>You do not have access to Live/Demo accounts</code> error, or a bare <code>Something went wrong, contact your broker</code>. Below I walk through each cause and its exact fix, then show how routing alerts through an automation layer like PickMyTrade catches most of these before an order ever leaves the gate." },
    {
      type: "checklist",
      heading: "Quick Checklist for Live Order Rejections",
      items: [
        "<strong class='text-white'>Live market data is active</strong>, subscribe to real-time exchange (CME/EUREX) data on the live account. A missing or 10-minute-delayed feed blocks live orders.",
        "<strong class='text-white'>Data agreement is signed</strong>, accept the live market-data / exchange agreement Tradovate prompts you with on first live login.",
        "<strong class='text-white'>Device is approved</strong>, open the device-approval email and confirm the machine. Live enforces this; demo usually doesn't.",
        "<strong class='text-white'>TradingView add-on is enabled</strong>, the TradingView entitlement (or a plan that includes it) has to be active on the live account.",
        "<strong class='text-white'>Correct account selected</strong>, choose the <strong class='text-white'>Live</strong> account, not Demo, on the TradingView broker-authorization screen.",
        "<strong class='text-white'>Funded and within limits</strong>, the account must be funded and the order size within its risk/position caps. Limits vary by firm and account size, so check your current rules.",
      ],
    },
    { type: "heading", text: "What &ldquo;Order Rejected on a Live Tradovate Account&rdquo; Means" },
    { type: "paragraph", html: "A live-only rejection is Tradovate telling you that something about the <strong class='text-white'>account's live state</strong>, not the order itself, isn't ready. Demo and simulation accounts are deliberately lenient: they hand you delayed or simulated data, skip strict device checks, and don't require you to be entitled to real exchange data. A live account is the opposite. Before it accepts a working order, it wants a real-time data subscription, a signed exchange agreement, an approved device, and an active TradingView entitlement. Miss any one and the order gets refused while the demo version sails through." },
    { type: "paragraph", html: "The rejection wears different labels depending on which piece is missing. Without a live real-time data subscription on the Tradovate side, you'll usually see something like <strong class='text-white'>&ldquo;Non-tradable symbol: You can't trade this symbol &hellip; at TradingView via Tradovate.&rdquo;</strong> Buying a data package <em>inside TradingView</em> doesn't satisfy this, the real-time subscription has to exist on the broker (Tradovate) account. Pick the wrong account mode on the authorization screen and you'll get <strong class='text-white'>&ldquo;You do not have access to Live/Demo accounts.&rdquo;</strong> If the live account isn't funded or enabled, you may get <strong class='text-white'>&ldquo;Something went wrong, contact your broker.&rdquo;</strong>" },
    { type: "paragraph", html: "Since the fix depends on which gate is closed, work through them in order: confirm the order is fine on demo (which isolates it as a live-only issue), then check data, agreement, device, and entitlement. Most live-only rejections are solved by the first two." },
    { type: "heading", text: "Top Causes of Live Order Rejections in 2026" },
    { type: "heading", text: "1. No active live market data subscription" },
    { type: "paragraph", html: "This is the single most common cause. A live Tradovate account needs a real-time exchange data subscription to route live orders. Without it, your quotes lag by ten minutes and orders reject as non-tradable. A funded live trader is generally classified by the exchanges as a <strong class='text-white'>Market Professional</strong>, so live data is a paid subscription you maintain yourself, not the free, delayed feed you had in demo." },
    { type: "heading", text: "2. The live market-data / exchange agreement isn't signed" },
    { type: "paragraph", html: "The first time you log in to a live account, Tradovate prompts you to review and accept a market-data agreement (and select your exchanges) before real-time data, and therefore live order routing, turns on. If that agreement got skipped or was never completed, live orders keep bouncing even though a subscription looks selected." },
    { type: "heading", text: "3. A new device hasn't been approved" },
    { type: "paragraph", html: "Live accounts strictly enforce device approval. Sign in from an unrecognized machine, browser, VPS, or through TradingView for the first time, and Tradovate emails you to <strong class='text-white'>Approve</strong> or <strong class='text-white'>Deny</strong> the device, holding the session (and order routing) until you approve it. Demo accounts are far more forgiving, which is exactly why the same connection works in sim and fails on live." },
    { type: "heading", text: "4. The TradingView add-on / entitlement isn't active" },
    { type: "paragraph", html: "To trade a live account through TradingView, you need an active TradingView add-on (or an account plan that includes TradingView) on the Tradovate side. If it's missing, TradingView reports <strong class='text-white'>&ldquo;TradingView has not been entitled to access your account,&rdquo;</strong> and nothing routes." },
    { type: "heading", text: "5. Wrong account selected, unfunded, or a prop-firm gate" },
    { type: "paragraph", html: "On TradingView's broker-authorization page you choose which account type to connect. Pick the wrong one and you land on &ldquo;You do not have access to Live/Demo accounts.&rdquo; An unfunded live account may not reach live mode at all. And on a prop-firm evaluation account, TradingView access and market data are controlled by the <strong class='text-white'>prop firm</strong>, you can't self-subscribe and have to ask the firm to enable them." },
    { type: "heading", text: "How to Fix Live Order Rejections: Step-by-Step" },
    { type: "heading", text: "Fixing live market data (the usual culprit)" },
    {
      type: "steps",
      items: [
        { title: "Log in to the live account", html: "Log in to the Tradovate web trader on your live account." },
        { title: "Open Market Data settings", html: "Open <strong class='text-white'>Application Settings</strong> (the gear/settings menu) and go to the <strong class='text-white'>Market Data</strong> section." },
        { title: "Subscribe to real-time data", html: "Subscribe to the real-time exchange data you trade (for example CME Group / EUREX Level 1). A live real-time subscription, not a delayed feed, is what enables live order routing." },
        { title: "Complete the subscription", html: "Complete any payment/subscription step. Fees vary and change over time, so check Tradovate's current market-data rates rather than relying on an old figure." },
        { title: "Re-log and retry", html: "Log out and back in so the new subscription takes effect, then resubmit the order." },
      ],
    },
    { type: "heading", text: "Fixing the signed data agreement" },
    {
      type: "steps",
      items: [
        { title: "Find the agreement prompt", html: "In the same <strong class='text-white'>Market Data</strong> area, find the live market-data / exchange agreement prompt (Tradovate presents this on first live login)." },
        { title: "Pick your classification", html: "Review the Professional / Non-Professional classification (there's a link explaining the two user types) and pick the status that honestly matches you." },
        { title: "Accept the terms", html: "Read and <strong class='text-white'>accept</strong> the Terms and Conditions to finish enabling real-time data." },
        { title: "Confirm and retry", html: "Confirm the subscription now shows as active, then retry your live order." },
      ],
    },
    { type: "heading", text: "Fixing device approval" },
    {
      type: "steps",
      items: [
        { title: "Find the device-login email", html: "Open the email inbox tied to your Tradovate account and find the device-login notification. Check <strong class='text-white'>Spam/Junk</strong> and <strong class='text-white'>Promotions</strong>, and search for &ldquo;Tradovate&rdquo; if it isn't in your inbox." },
        { title: "Approve the device", html: "Open it and click <strong class='text-white'>Approve</strong> (never Deny, Deny blocks that device for the attempt)." },
        { title: "Resend if it never arrived", html: "If no email arrived, log in from an already-approved device, open <strong class='text-white'>Application Settings &gt; My Devices</strong>, find the <strong class='text-white'>Pending</strong> device, and click <strong class='text-white'>Forget</strong> to regenerate a fresh approve/deny email." },
        { title: "Place the order again", html: "Return to TradingView (or the app) and place the order again." },
      ],
    },
    { type: "heading", text: "Fixing the entitlement and account selection" },
    {
      type: "steps",
      items: [
        { title: "Confirm the add-on is enabled", html: "In Tradovate settings, confirm the <strong class='text-white'>TradingView add-on</strong> (or a plan that includes it) is enabled on the live account. On a prop-firm evaluation account, contact the firm to enable it, you can't turn it on yourself." },
        { title: "Reconnect and select Live", html: "In TradingView, open the Tradovate broker connection and reconnect. On the authorization screen, make sure you select the correct <strong class='text-white'>Live</strong> account (not Demo). Selecting the wrong mode is what triggers &ldquo;You do not have access to Live/Demo accounts.&rdquo;" },
        { title: "Refresh the entitlement if needed", html: "If TradingView still says the account isn't entitled after you've enabled the add-on, disconnect and reconnect the broker so the entitlement refreshes." },
      ],
    },
    { type: "heading", text: "When it's still rejecting only on live" },
    { type: "paragraph", html: "If demo fills, data is subscribed, the agreement is signed, the device is approved, and the add-on is active, but live still rejects, <strong class='text-white'>contact support</strong>. The fix for the live/demo access error is to have your broker verify your account status and confirm everything is enabled for trading. For a self-directed account, contact Tradovate; for a prop-firm evaluation, contact the firm, since only they can flip account-side flags." },
    { type: "heading", text: "Troubleshooting Table" },
    {
      type: "table",
      headers: ["Error", "Meaning", "Fix"],
      rows: [
        ["Non-tradable symbol: You can't trade this symbol &hellip; at TradingView via Tradovate", "No active real-time data subscription on the Tradovate side (or a non-tradable/continuous symbol)", "Subscribe to live exchange data in Tradovate and trade the active front-month contract"],
        ["You do not have access to Live/Demo accounts", "Wrong account type chosen on the authorization page, or the account isn't enabled for TradingView", "Reselect the correct (Live) account on the authorization screen; ask the broker to confirm it's enabled"],
        ["Something went wrong, contact your broker", "Live account isn't funded or enabled for live TradingView access", "Fund/enable the live account, or use Demo with the TradingView add-on"],
        ["TradingView has not been entitled to access your account", "The TradingView add-on/entitlement isn't active on the account", "Enable the TradingView add-on in Tradovate settings (or ask your prop firm to enable it)"],
        ["Fills on demo, rejects on live", "A live-only gate, data agreement unsigned or device not approved", "Sign the live data agreement and approve the device from the emailed link"],
        ["Order rejected as exceeding account size", "Order quantity above the account's risk/position cap", "Reduce quantity or raise the limit (limits vary by firm and account size, check your current rules)"],
      ],
    },
    { type: "heading", text: "Prevent This with PickMyTrade" },
    { type: "paragraph", html: "Most live-only rejections come from an account gate that's easy to miss until an order fails at the worst possible moment. PickMyTrade sits between your TradingView alerts and Tradovate and fails safe when a gate isn't ready, instead of firing an order that bounces." },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Live-vs-Demo routing guardrails</strong>, map each alert to the exact live account you intend, so orders never fire against the wrong mode or an unentitled account.",
        "<strong class='text-white'>Qty / symbol validation</strong>, blocks orders on non-tradable or oversized symbols before they ever reach Tradovate.",
        "<strong class='text-white'>Risk & entitlement filters</strong>, respect prop-firm limits and data-agreement state, so a not-yet-enabled account fails safe rather than spraying rejects.",
        "<strong class='text-white'>Multi-account sync</strong>, once the gate clears, mirror the corrected order across all of your accounts from one place.",
      ],
    },
  ], de: [
    { type: "paragraph",html: "Sie haben Ihr Live-Tradovate-Konto finanziert, eine TradingView-Strategie damit verbunden, auf <strong class='text-white'>Buy</strong> geklickt – und die Order kam sofort abgelehnt zurück. Derselbe Alert wird im Sim-Konto dagegen augenblicklich ausgeführt. Das ist eines der häufigsten (und nervigsten) Tradovate-Probleme, und hier die beruhigende Nachricht: Eine Ablehnung, die <strong class='text-white'>nur live</strong> auftritt, bedeutet fast nie, dass Ihre Strategie defekt ist. Es heißt, dass eine von wenigen kontobezogenen Hürden noch nicht erfüllt ist: Live-Marktdaten, eine unterzeichnete Datenvereinbarung, die Geräteverifizierung oder die TradingView-Berechtigung. Sie kann als Meldung <code>Non-tradable symbol</code>, als Fehler <code>You do not have access to Live/Demo accounts</code> oder als schlichtes <code>Something went wrong, contact your broker</code> erscheinen. Unten gehe ich jede Ursache mit der genauen Lösung durch und zeige dann, wie das Routing von Alerts über eine Automatisierungsschicht wie PickMyTrade die meisten dieser Probleme abfängt, bevor eine Order überhaupt abgeschickt wird." },
    {
      type: "checklist",
      heading: "Kurze Checkliste bei Live-Order-Ablehnungen",
      items: [
        "<strong class='text-white'>Live-Marktdaten sind aktiv</strong>, abonnieren Sie Echtzeit-Börsendaten (CME/EUREX) auf dem Live-Konto. Ein fehlender oder um 10 Minuten verzögerter Datenfeed blockiert Live-Orders.",
        "<strong class='text-white'>Datenvereinbarung ist unterzeichnet</strong>, akzeptieren Sie die Marktdaten-/Börsenvereinbarung, die Tradovate Ihnen beim ersten Live-Login anzeigt.",
        "<strong class='text-white'>Gerät ist genehmigt</strong>, öffnen Sie die Geräte-Genehmigungs-E-Mail und bestätigen Sie den Rechner. Live erzwingt dies; Demo in der Regel nicht.",
        "<strong class='text-white'>TradingView-Add-on ist aktiviert</strong>, die TradingView-Berechtigung (oder ein Tarif, der sie enthält) muss auf dem Live-Konto aktiv sein.",
        "<strong class='text-white'>Richtiges Konto ausgewählt</strong>, wählen Sie auf dem TradingView-Broker-Autorisierungsbildschirm das <strong class='text-white'>Live</strong>-Konto, nicht Demo.",
        "<strong class='text-white'>Finanziert und innerhalb der Limits</strong>, das Konto muss finanziert und die Ordergröße innerhalb der Risiko-/Positionslimits sein. Limits variieren je nach Firma und Kontogröße, prüfen Sie daher Ihre aktuellen Regeln.",
      ],
    },
    { type: "heading",text: "Was &ldquo;Order auf einem Live-Tradovate-Konto abgelehnt&rdquo; bedeutet" },
    { type: "paragraph",html: "Eine reine Live-Ablehnung bedeutet, dass Tradovate Ihnen mitteilt: Etwas am <strong class='text-white'>Live-Status des Kontos</strong>, nicht an der Order selbst, ist noch nicht bereit. Demo- und Simulationskonten sind bewusst nachsichtig: Sie liefern verzögerte oder simulierte Daten, überspringen strenge Geräteprüfungen und verlangen keine Berechtigung für echte Börsendaten. Ein Live-Konto ist das Gegenteil. Bevor es eine Working-Order akzeptiert, verlangt es ein Echtzeit-Datenabonnement, eine unterzeichnete Börsenvereinbarung, ein genehmigtes Gerät und eine aktive TradingView-Berechtigung. Fehlt eines davon, wird die Order abgelehnt, während die Demo-Variante problemlos durchläuft." },
    { type: "paragraph",html: "Die Ablehnung erscheint unter verschiedenen Bezeichnungen, je nachdem, was fehlt. Ohne Live-Echtzeit-Datenabonnement auf der Tradovate-Seite sehen Sie meist etwas wie <strong class='text-white'>&ldquo;Non-tradable symbol: You can't trade this symbol &hellip; at TradingView via Tradovate.&rdquo;</strong> Der Kauf eines Datenpakets <em>innerhalb von TradingView</em> genügt dafür nicht – das Echtzeit-Abonnement muss auf dem Broker-Konto (Tradovate) bestehen. Wählen Sie auf dem Autorisierungsbildschirm den falschen Kontomodus, erhalten Sie <strong class='text-white'>&ldquo;You do not have access to Live/Demo accounts.&rdquo;</strong> Ist das Live-Konto nicht finanziert oder nicht aktiviert, erscheint möglicherweise <strong class='text-white'>&ldquo;Something went wrong, contact your broker.&rdquo;</strong>" },
    { type: "paragraph",html: "Da die Lösung davon abhängt, welche Hürde geschlossen ist, gehen Sie sie der Reihe nach durch: Prüfen Sie zuerst, dass die Order im Demo-Konto funktioniert (das grenzt das Problem als reines Live-Problem ein), und kontrollieren Sie dann Daten, Vereinbarung, Gerät und Berechtigung. Die meisten reinen Live-Ablehnungen lassen sich mit den ersten beiden beheben." },
    { type: "heading",text: "Die häufigsten Ursachen für Live-Order-Ablehnungen 2026" },
    { type: "heading",text: "1. Kein aktives Live-Marktdatenabonnement" },
    { type: "paragraph",html: "Dies ist mit Abstand die häufigste Ursache. Ein Live-Tradovate-Konto benötigt ein Echtzeit-Börsendatenabonnement, um Live-Orders zu routen. Ohne es hinken Ihre Kurse um zehn Minuten hinterher und Orders werden als nicht handelbar abgelehnt. Ein finanzierter Live-Trader wird von den Börsen in der Regel als <strong class='text-white'>Market Professional</strong> eingestuft; Live-Daten sind daher ein kostenpflichtiges Abonnement, das Sie selbst pflegen, und nicht der kostenlose, verzögerte Feed aus der Demo." },
    { type: "heading",text: "2. Die Live-Marktdaten-/Börsenvereinbarung ist nicht unterzeichnet" },
    { type: "paragraph",html: "Beim ersten Login in ein Live-Konto fordert Tradovate Sie auf, eine Marktdatenvereinbarung zu prüfen und zu akzeptieren (und Ihre Börsen auszuwählen), bevor Echtzeitdaten und damit das Live-Order-Routing aktiviert werden. Wurde diese Vereinbarung übersprungen oder nie abgeschlossen, werden Live-Orders weiterhin abgelehnt, obwohl ein Abonnement ausgewählt zu sein scheint." },
    { type: "heading",text: "3. Ein neues Gerät wurde nicht genehmigt" },
    { type: "paragraph",html: "Live-Konten setzen die Geräteverifizierung streng durch. Melden Sie sich von einem unbekannten Rechner, Browser, VPS oder erstmals über TradingView an, sendet Tradovate Ihnen eine E-Mail, um das Gerät mit <strong class='text-white'>Approve</strong> zu genehmigen oder mit <strong class='text-white'>Deny</strong> abzulehnen, und hält die Sitzung (und das Order-Routing) an, bis Sie genehmigen. Demo-Konten sind deutlich nachsichtiger – genau deshalb funktioniert dieselbe Verbindung im Sim und scheitert live." },
    { type: "heading",text: "4. Das TradingView-Add-on bzw. die Berechtigung ist nicht aktiv" },
    { type: "paragraph",html: "Um ein Live-Konto über TradingView zu handeln, benötigen Sie ein aktives TradingView-Add-on (oder einen Kontotarif, der TradingView enthält) auf der Tradovate-Seite. Fehlt es, meldet TradingView <strong class='text-white'>&ldquo;TradingView has not been entitled to access your account&rdquo;</strong>, und nichts wird geroutet." },
    { type: "heading",text: "5. Falsches Konto gewählt, nicht finanziert oder Prop-Firm-Hürde" },
    { type: "paragraph",html: "Auf der Broker-Autorisierungsseite von TradingView wählen Sie, welchen Kontotyp Sie verbinden. Wählen Sie den falschen, landen Sie bei &ldquo;You do not have access to Live/Demo accounts.&rdquo; Ein nicht finanziertes Live-Konto erreicht den Live-Modus möglicherweise gar nicht. Und bei einem Prop-Firm-Evaluationskonto werden TradingView-Zugang und Marktdaten von der <strong class='text-white'>Prop Firm</strong> kontrolliert – Sie können sie nicht selbst abonnieren und müssen die Firma bitten, sie zu aktivieren." },
    { type: "heading",text: "So beheben Sie Live-Order-Ablehnungen: Schritt für Schritt" },
    { type: "heading",text: "Live-Marktdaten beheben (der übliche Verdächtige)" },
    {
      type: "steps",
      items: [
        { title: "Beim Live-Konto anmelden", html: "Melden Sie sich im Tradovate Web Trader auf Ihrem Live-Konto an." },
        { title: "Market-Data-Einstellungen öffnen", html: "Öffnen Sie die <strong class='text-white'>Application Settings</strong> (das Zahnrad-/Einstellungsmenü) und wechseln Sie zum Bereich <strong class='text-white'>Market Data</strong>." },
        { title: "Echtzeitdaten abonnieren", html: "Abonnieren Sie die Echtzeit-Börsendaten, die Sie handeln (zum Beispiel CME Group / EUREX Level 1). Ein Live-Echtzeitabonnement, kein verzögerter Feed, aktiviert das Live-Order-Routing." },
        { title: "Abonnement abschließen", html: "Schließen Sie den Zahlungs-/Abonnementschritt ab. Gebühren variieren und ändern sich im Lauf der Zeit; prüfen Sie daher die aktuellen Marktdatenpreise von Tradovate, statt sich auf eine alte Zahl zu verlassen." },
        { title: "Erneut anmelden und wiederholen", html: "Melden Sie sich ab und wieder an, damit das neue Abonnement wirksam wird, und senden Sie die Order dann erneut." },
      ],
    },
    { type: "heading",text: "Die unterzeichnete Datenvereinbarung beheben" },
    {
      type: "steps",
      items: [
        { title: "Vereinbarungsaufforderung finden", html: "Suchen Sie im selben Bereich <strong class='text-white'>Market Data</strong> die Aufforderung zur Live-Marktdaten-/Börsenvereinbarung (Tradovate zeigt sie beim ersten Live-Login an)." },
        { title: "Klassifizierung wählen", html: "Prüfen Sie die Einstufung Professional / Non-Professional (ein Link erklärt die beiden Nutzertypen) und wählen Sie den Status, der ehrlich auf Sie zutrifft." },
        { title: "Bedingungen akzeptieren", html: "Lesen Sie die Allgemeinen Geschäftsbedingungen und <strong class='text-white'>akzeptieren</strong> Sie sie, um die Echtzeitdaten freizuschalten." },
        { title: "Bestätigen und wiederholen", html: "Vergewissern Sie sich, dass das Abonnement nun als aktiv angezeigt wird, und wiederholen Sie dann Ihre Live-Order." },
      ],
    },
    { type: "heading",text: "Die Geräteverifizierung beheben" },
    {
      type: "steps",
      items: [
        { title: "Geräte-Login-E-Mail finden", html: "Öffnen Sie das mit Ihrem Tradovate-Konto verknüpfte E-Mail-Postfach und suchen Sie die Geräte-Login-Benachrichtigung. Prüfen Sie <strong class='text-white'>Spam/Junk</strong> und <strong class='text-white'>Promotions</strong> und suchen Sie nach &ldquo;Tradovate&rdquo;, falls sie nicht im Posteingang liegt." },
        { title: "Gerät genehmigen", html: "Öffnen Sie sie und klicken Sie auf <strong class='text-white'>Approve</strong> (niemals Deny – Deny blockiert dieses Gerät für den Versuch)." },
        { title: "Erneut senden, falls nichts ankam", html: "Falls keine E-Mail ankam, melden Sie sich von einem bereits genehmigten Gerät an, öffnen Sie <strong class='text-white'>Application Settings &gt; My Devices</strong>, suchen Sie das Gerät mit <strong class='text-white'>Pending</strong> und klicken Sie auf <strong class='text-white'>Forget</strong>, um eine neue Approve/Deny-E-Mail zu erzeugen." },
        { title: "Order erneut platzieren", html: "Kehren Sie zu TradingView (oder zur App) zurück und platzieren Sie die Order erneut." },
      ],
    },
    { type: "heading",text: "Berechtigung und Kontoauswahl beheben" },
    {
      type: "steps",
      items: [
        { title: "Bestätigen, dass das Add-on aktiviert ist", html: "Bestätigen Sie in den Tradovate-Einstellungen, dass das <strong class='text-white'>TradingView add-on</strong> (oder ein Tarif, der es enthält) auf dem Live-Konto aktiviert ist. Bei einem Prop-Firm-Evaluationskonto wenden Sie sich an die Firma, damit sie es aktiviert – Sie können es nicht selbst einschalten." },
        { title: "Erneut verbinden und Live wählen", html: "Öffnen Sie in TradingView die Tradovate-Broker-Verbindung und verbinden Sie neu. Achten Sie auf dem Autorisierungsbildschirm darauf, das richtige <strong class='text-white'>Live</strong>-Konto (nicht Demo) auszuwählen. Die Wahl des falschen Modus löst &ldquo;You do not have access to Live/Demo accounts.&rdquo; aus." },
        { title: "Berechtigung bei Bedarf aktualisieren", html: "Meldet TradingView weiterhin, dass das Konto nicht berechtigt ist, obwohl Sie das Add-on aktiviert haben, trennen Sie den Broker und verbinden Sie ihn neu, damit die Berechtigung aktualisiert wird." },
      ],
    },
    { type: "heading",text: "Wenn die Order nur live weiterhin abgelehnt wird" },
    { type: "paragraph",html: "Wenn die Demo-Order ausgeführt wird, die Daten abonniert, die Vereinbarung unterzeichnet, das Gerät genehmigt und das Add-on aktiv sind, live aber weiterhin abgelehnt wird, <strong class='text-white'>kontaktieren Sie den Support</strong>. Die Lösung für den Live-/Demo-Zugriffsfehler besteht darin, dass Ihr Broker Ihren Kontostatus prüft und bestätigt, dass alles für den Handel aktiviert ist. Bei einem selbstverwalteten Konto wenden Sie sich an Tradovate; bei einer Prop-Firm-Evaluation an die Firma, da nur sie kontoseitige Flags umlegen kann." },
    { type: "heading",text: "Fehlerbehebungstabelle" },
    { type: "table", headers: ["Fehler","Bedeutung","Lösung"], rows: [
      ["Non-tradable symbol: You can't trade this symbol &hellip; at TradingView via Tradovate","Kein aktives Echtzeit-Datenabonnement auf der Tradovate-Seite (oder ein nicht handelbares/fortlaufendes Symbol)","Abonnieren Sie Live-Börsendaten in Tradovate und handeln Sie den aktiven Front-Month-Kontrakt"],
      ["You do not have access to Live/Demo accounts","Falscher Kontotyp auf der Autorisierungsseite gewählt oder das Konto ist nicht für TradingView aktiviert","Wählen Sie auf dem Autorisierungsbildschirm erneut das richtige (Live-)Konto; bitten Sie den Broker zu bestätigen, dass es aktiviert ist"],
      ["Something went wrong, contact your broker","Das Live-Konto ist nicht finanziert oder nicht für den Live-TradingView-Zugriff aktiviert","Finanzieren/aktivieren Sie das Live-Konto oder nutzen Sie Demo mit dem TradingView-Add-on"],
      ["TradingView has not been entitled to access your account","Das TradingView-Add-on bzw. die Berechtigung ist auf dem Konto nicht aktiv","Aktivieren Sie das TradingView-Add-on in den Tradovate-Einstellungen (oder bitten Sie Ihre Prop Firm, es zu aktivieren)"],
      ["Wird in Demo ausgeführt, live abgelehnt","Eine reine Live-Hürde: Datenvereinbarung nicht unterzeichnet oder Gerät nicht genehmigt","Unterzeichnen Sie die Live-Datenvereinbarung und genehmigen Sie das Gerät über den per E-Mail gesendeten Link"],
      ["Order wegen Überschreitung der Kontogröße abgelehnt","Ordermenge liegt über dem Risiko-/Positionslimit des Kontos","Reduzieren Sie die Menge oder erhöhen Sie das Limit (Limits variieren je nach Firma und Kontogröße, prüfen Sie Ihre aktuellen Regeln)"],
    ] },
    { type: "heading",text: "Verhindern Sie das mit PickMyTrade" },
    { type: "paragraph",html: "Die meisten reinen Live-Ablehnungen entstehen durch eine Kontohürde, die leicht übersehen wird, bis eine Order im ungünstigsten Moment fehlschlägt. PickMyTrade sitzt zwischen Ihren TradingView-Alerts und Tradovate und bricht sicher ab, wenn eine Hürde nicht bereit ist, statt eine Order abzusenden, die zurückprallt." },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Live-vs-Demo-Routing-Schutz</strong>, ordnen Sie jeden Alert dem exakten Live-Konto zu, das Sie meinen, damit Orders nie gegen den falschen Modus oder ein nicht berechtigtes Konto abgesetzt werden.",
        "<strong class='text-white'>Mengen-/Symbolvalidierung</strong>, blockiert Orders auf nicht handelbaren oder überdimensionierten Symbolen, bevor sie Tradovate überhaupt erreichen.",
        "<strong class='text-white'>Risiko- & Berechtigungsfilter</strong>, berücksichtigen Prop-Firm-Limits und den Status der Datenvereinbarung, sodass ein noch nicht aktiviertes Konto sicher abbricht, statt Ablehnungen zu streuen.",
        "<strong class='text-white'>Multi-Account-Sync</strong>, sobald die Hürde beseitigt ist, spiegeln Sie die korrigierte Order von einem Ort aus auf alle Ihre Konten.",
      ],
    },
  ], es: [
    { type: "paragraph",html: "Usted fondeó su cuenta real de Tradovate, conectó una estrategia de TradingView, pulsó <strong class='text-white'>Buy</strong> y la orden volvió rechazada de inmediato. Mientras tanto, la misma alerta se ejecuta al instante en su cuenta sim. Es uno de los problemas más comunes (y más exasperantes) de Tradovate, y aquí va lo tranquilizador: un rechazo que aparece <strong class='text-white'>solo en real</strong> casi nunca significa que su estrategia esté rota. Significa que aún no se cumple uno de los pocos requisitos de estado de la cuenta: datos de mercado en vivo, un acuerdo de datos firmado, la aprobación del dispositivo o la habilitación de TradingView. Puede aparecer como un mensaje <code>Non-tradable symbol</code>, un error <code>You do not have access to Live/Demo accounts</code> o un simple <code>Something went wrong, contact your broker</code>. A continuación repaso cada causa con su solución exacta y luego muestro cómo enrutar las alertas a través de una capa de automatización como PickMyTrade detecta la mayoría de estos problemas antes de que una orden salga siquiera." },
    {
      type: "checklist",
      heading: "Lista rápida para rechazos de órdenes en real",
      items: [
        "<strong class='text-white'>Los datos de mercado en vivo están activos</strong>, suscríbase a datos de bolsa en tiempo real (CME/EUREX) en la cuenta real. Un feed ausente o retrasado 10 minutos bloquea las órdenes reales.",
        "<strong class='text-white'>El acuerdo de datos está firmado</strong>, acepte el acuerdo de datos de mercado/bolsa que Tradovate le muestra en el primer inicio de sesión real.",
        "<strong class='text-white'>El dispositivo está aprobado</strong>, abra el correo de aprobación de dispositivo y confirme el equipo. La cuenta real lo exige; la demo normalmente no.",
        "<strong class='text-white'>El complemento de TradingView está habilitado</strong>, la habilitación de TradingView (o un plan que la incluya) debe estar activa en la cuenta real.",
        "<strong class='text-white'>Cuenta correcta seleccionada</strong>, elija la cuenta <strong class='text-white'>Live</strong>, no Demo, en la pantalla de autorización del bróker de TradingView.",
        "<strong class='text-white'>Fondeada y dentro de los límites</strong>, la cuenta debe estar fondeada y el tamaño de la orden dentro de sus límites de riesgo/posición. Los límites varían según la firma y el tamaño de la cuenta, así que revise sus reglas actuales.",
      ],
    },
    { type: "heading",text: "Qué significa &ldquo;orden rechazada en una cuenta real de Tradovate&rdquo;" },
    { type: "paragraph",html: "Un rechazo exclusivo de la cuenta real es Tradovate diciéndole que algo en el <strong class='text-white'>estado real de la cuenta</strong>, no en la orden en sí, no está listo. Las cuentas demo y de simulación son deliberadamente permisivas: ofrecen datos retrasados o simulados, omiten las comprobaciones estrictas de dispositivo y no exigen que tenga derecho a datos reales de bolsa. Una cuenta real es lo contrario. Antes de aceptar una orden activa, pide una suscripción de datos en tiempo real, un acuerdo de bolsa firmado, un dispositivo aprobado y una habilitación activa de TradingView. Si falta cualquiera, la orden se rechaza mientras que la versión demo pasa sin problema." },
    { type: "paragraph",html: "El rechazo aparece con distintas etiquetas según qué pieza falte. Sin una suscripción de datos en tiempo real en vivo en el lado de Tradovate, normalmente verá algo como <strong class='text-white'>&ldquo;Non-tradable symbol: You can't trade this symbol &hellip; at TradingView via Tradovate.&rdquo;</strong> Comprar un paquete de datos <em>dentro de TradingView</em> no lo soluciona; la suscripción en tiempo real debe existir en la cuenta del bróker (Tradovate). Si elige el modo de cuenta equivocado en la pantalla de autorización, obtendrá <strong class='text-white'>&ldquo;You do not have access to Live/Demo accounts.&rdquo;</strong> Si la cuenta real no está fondeada o habilitada, puede aparecer <strong class='text-white'>&ldquo;Something went wrong, contact your broker.&rdquo;</strong>" },
    { type: "paragraph",html: "Como la solución depende de qué requisito esté cerrado, repáselos en orden: confirme que la orden funciona en demo (lo que aísla el problema como exclusivo de la cuenta real) y luego revise datos, acuerdo, dispositivo y habilitación. La mayoría de los rechazos exclusivos de la cuenta real se resuelven con los dos primeros." },
    { type: "heading",text: "Principales causas de rechazos de órdenes en real en 2026" },
    { type: "heading",text: "1. No hay una suscripción activa de datos de mercado en vivo" },
    { type: "paragraph",html: "Esta es la causa más común con diferencia. Una cuenta real de Tradovate necesita una suscripción de datos de bolsa en tiempo real para enrutar órdenes reales. Sin ella, sus cotizaciones se retrasan diez minutos y las órdenes se rechazan como no negociables. Un trader con cuenta real fondeada suele ser clasificado por las bolsas como <strong class='text-white'>Market Professional</strong>, así que los datos en vivo son una suscripción de pago que usted mantiene, no el feed gratuito y retrasado que tenía en demo." },
    { type: "heading",text: "2. El acuerdo de datos de mercado/bolsa en vivo no está firmado" },
    { type: "paragraph",html: "La primera vez que inicia sesión en una cuenta real, Tradovate le pide revisar y aceptar un acuerdo de datos de mercado (y seleccionar sus bolsas) antes de activar los datos en tiempo real y, con ellos, el enrutamiento de órdenes reales. Si ese acuerdo se omitió o nunca se completó, las órdenes reales siguen rebotando aunque parezca que hay una suscripción seleccionada." },
    { type: "heading",text: "3. Un dispositivo nuevo no ha sido aprobado" },
    { type: "paragraph",html: "Las cuentas reales aplican estrictamente la aprobación de dispositivos. Si inicia sesión desde un equipo, navegador o VPS no reconocido, o a través de TradingView por primera vez, Tradovate le envía un correo para <strong class='text-white'>Approve</strong> (aprobar) o <strong class='text-white'>Deny</strong> (denegar) el dispositivo, y mantiene la sesión (y el enrutamiento de órdenes) detenida hasta que lo apruebe. Las cuentas demo son mucho más permisivas, y por eso la misma conexión funciona en sim y falla en real." },
    { type: "heading",text: "4. El complemento o la habilitación de TradingView no está activo" },
    { type: "paragraph",html: "Para operar una cuenta real a través de TradingView, necesita un complemento de TradingView activo (o un plan de cuenta que lo incluya) en el lado de Tradovate. Si falta, TradingView informa <strong class='text-white'>&ldquo;TradingView has not been entitled to access your account,&rdquo;</strong> y nada se enruta." },
    { type: "heading",text: "5. Cuenta equivocada, sin fondos o requisito de la prop firm" },
    { type: "paragraph",html: "En la página de autorización de bróker de TradingView elige qué tipo de cuenta conectar. Si elige el equivocado, terminará en &ldquo;You do not have access to Live/Demo accounts.&rdquo; Una cuenta real sin fondos puede no llegar nunca al modo real. Y en una cuenta de evaluación de prop firm, el acceso a TradingView y los datos de mercado los controla la <strong class='text-white'>prop firm</strong>: no puede suscribirse usted mismo y debe pedir a la firma que los habilite." },
    { type: "heading",text: "Cómo solucionar los rechazos de órdenes en real: paso a paso" },
    { type: "heading",text: "Solucionar los datos de mercado en vivo (el culpable habitual)" },
    {
      type: "steps",
      items: [
        { title: "Inicie sesión en la cuenta real", html: "Inicie sesión en el Tradovate Web Trader con su cuenta real." },
        { title: "Abra la configuración de Market Data", html: "Abra <strong class='text-white'>Application Settings</strong> (el menú de engranaje/configuración) y vaya a la sección <strong class='text-white'>Market Data</strong>." },
        { title: "Suscríbase a datos en tiempo real", html: "Suscríbase a los datos de bolsa en tiempo real que opera (por ejemplo, CME Group / EUREX Level 1). Una suscripción en tiempo real en vivo, no un feed retrasado, es lo que habilita el enrutamiento de órdenes reales." },
        { title: "Complete la suscripción", html: "Complete cualquier paso de pago o suscripción. Las tarifas varían y cambian con el tiempo, así que consulte las tarifas actuales de datos de mercado de Tradovate en lugar de fiarse de una cifra antigua." },
        { title: "Vuelva a iniciar sesión y reintente", html: "Cierre sesión y vuelva a entrar para que la nueva suscripción surta efecto, y luego reenvíe la orden." },
      ],
    },
    { type: "heading",text: "Solucionar el acuerdo de datos firmado" },
    {
      type: "steps",
      items: [
        { title: "Encuentre la solicitud del acuerdo", html: "En la misma área de <strong class='text-white'>Market Data</strong>, busque la solicitud del acuerdo de datos de mercado/bolsa en vivo (Tradovate la presenta en el primer inicio de sesión real)." },
        { title: "Elija su clasificación", html: "Revise la clasificación Professional / Non-Professional (hay un enlace que explica los dos tipos de usuario) y elija el estado que corresponda sinceramente a su caso." },
        { title: "Acepte los términos", html: "Lea y <strong class='text-white'>acepte</strong> los Términos y Condiciones para terminar de habilitar los datos en tiempo real." },
        { title: "Confirme y reintente", html: "Confirme que la suscripción aparece ahora como activa y luego reintente su orden real." },
      ],
    },
    { type: "heading",text: "Solucionar la aprobación del dispositivo" },
    {
      type: "steps",
      items: [
        { title: "Encuentre el correo de inicio de sesión del dispositivo", html: "Abra la bandeja de entrada asociada a su cuenta de Tradovate y busque la notificación de inicio de sesión del dispositivo. Revise <strong class='text-white'>Spam/Junk</strong> y <strong class='text-white'>Promotions</strong>, y busque &ldquo;Tradovate&rdquo; si no está en su bandeja de entrada." },
        { title: "Apruebe el dispositivo", html: "Ábralo y haga clic en <strong class='text-white'>Approve</strong> (nunca en Deny: Deny bloquea ese dispositivo durante el intento)." },
        { title: "Reenvíe si nunca llegó", html: "Si no llegó ningún correo, inicie sesión desde un dispositivo ya aprobado, abra <strong class='text-white'>Application Settings &gt; My Devices</strong>, busque el dispositivo <strong class='text-white'>Pending</strong> y haga clic en <strong class='text-white'>Forget</strong> para regenerar un correo nuevo de aprobar/denegar." },
        { title: "Vuelva a colocar la orden", html: "Vuelva a TradingView (o a la app) y coloque la orden de nuevo." },
      ],
    },
    { type: "heading",text: "Solucionar la habilitación y la selección de cuenta" },
    {
      type: "steps",
      items: [
        { title: "Confirme que el complemento está habilitado", html: "En la configuración de Tradovate, confirme que el <strong class='text-white'>TradingView add-on</strong> (o un plan que lo incluya) está habilitado en la cuenta real. En una cuenta de evaluación de prop firm, contacte con la firma para que lo habilite; no puede activarlo usted mismo." },
        { title: "Reconecte y seleccione Live", html: "En TradingView, abra la conexión del bróker Tradovate y reconecte. En la pantalla de autorización, asegúrese de seleccionar la cuenta <strong class='text-white'>Live</strong> correcta (no Demo). Elegir el modo equivocado es lo que provoca &ldquo;You do not have access to Live/Demo accounts.&rdquo;" },
        { title: "Actualice la habilitación si es necesario", html: "Si TradingView sigue diciendo que la cuenta no está habilitada después de activar el complemento, desconecte y reconecte el bróker para que la habilitación se actualice." },
      ],
    },
    { type: "heading",text: "Cuando sigue rechazando solo en real" },
    { type: "paragraph",html: "Si la demo se ejecuta, los datos están suscritos, el acuerdo firmado, el dispositivo aprobado y el complemento activo, pero la cuenta real sigue rechazando, <strong class='text-white'>contacte con soporte</strong>. La solución al error de acceso real/demo es que su bróker verifique el estado de su cuenta y confirme que todo está habilitado para operar. En una cuenta autogestionada, contacte con Tradovate; en una evaluación de prop firm, con la firma, ya que solo ella puede cambiar los indicadores del lado de la cuenta." },
    { type: "heading",text: "Tabla de solución de problemas" },
    { type: "table", headers: ["Error","Significado","Solución"], rows: [
      ["Non-tradable symbol: You can't trade this symbol &hellip; at TradingView via Tradovate","No hay una suscripción activa de datos en tiempo real en el lado de Tradovate (o es un símbolo no negociable/continuo)","Suscríbase a datos de bolsa en vivo en Tradovate y opere el contrato activo del mes más cercano"],
      ["You do not have access to Live/Demo accounts","Se eligió el tipo de cuenta equivocado en la página de autorización, o la cuenta no está habilitada para TradingView","Vuelva a seleccionar la cuenta correcta (Live) en la pantalla de autorización; pida al bróker que confirme que está habilitada"],
      ["Something went wrong, contact your broker","La cuenta real no está fondeada o no está habilitada para el acceso real a TradingView","Fondee/habilite la cuenta real, o use Demo con el complemento de TradingView"],
      ["TradingView has not been entitled to access your account","El complemento o la habilitación de TradingView no está activo en la cuenta","Habilite el complemento de TradingView en la configuración de Tradovate (o pida a su prop firm que lo habilite)"],
      ["Se ejecuta en demo, se rechaza en real","Un requisito exclusivo de la cuenta real: acuerdo de datos sin firmar o dispositivo sin aprobar","Firme el acuerdo de datos en vivo y apruebe el dispositivo desde el enlace del correo"],
      ["Orden rechazada por exceder el tamaño de la cuenta","La cantidad de la orden supera el límite de riesgo/posición de la cuenta","Reduzca la cantidad o aumente el límite (los límites varían según la firma y el tamaño de la cuenta, revise sus reglas actuales)"],
    ] },
    { type: "heading",text: "Evítelo con PickMyTrade" },
    { type: "paragraph",html: "La mayoría de los rechazos exclusivos de la cuenta real provienen de un requisito de la cuenta que es fácil pasar por alto hasta que una orden falla en el peor momento posible. PickMyTrade se sitúa entre sus alertas de TradingView y Tradovate y falla de forma segura cuando un requisito no está listo, en lugar de lanzar una orden que rebote." },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Protecciones de enrutamiento live vs demo</strong>, asigne cada alerta a la cuenta real exacta que desea, para que las órdenes nunca se disparen contra el modo equivocado o una cuenta sin habilitación.",
        "<strong class='text-white'>Validación de cantidad / símbolo</strong>, bloquea órdenes sobre símbolos no negociables o de tamaño excesivo antes de que lleguen a Tradovate.",
        "<strong class='text-white'>Filtros de riesgo y habilitación</strong>, respetan los límites de la prop firm y el estado del acuerdo de datos, de modo que una cuenta aún no habilitada falla de forma segura en lugar de generar rechazos en cascada.",
        "<strong class='text-white'>Sincronización multicuenta</strong>, una vez superado el requisito, replique la orden corregida en todas sus cuentas desde un solo lugar.",
      ],
    },
  ], fr: [
    { type: "paragraph",html: "Vous avez approvisionné votre compte Tradovate réel, relié une stratégie TradingView, cliqué sur <strong class='text-white'>Buy</strong>, et l'ordre est revenu aussitôt rejeté. Pendant ce temps, la même alerte s'exécute instantanément sur votre compte sim. C'est l'un des problèmes Tradovate les plus courants (et les plus exaspérants), et voici le point rassurant : un rejet qui n'apparaît <strong class='text-white'>qu'en réel</strong> ne signifie presque jamais que votre stratégie est défaillante. Cela signifie que l'un des rares verrous d'état du compte n'est pas encore satisfait : données de marché en direct, accord de données signé, approbation de l'appareil ou habilitation TradingView. Il peut se manifester par un message <code>Non-tradable symbol</code>, une erreur <code>You do not have access to Live/Demo accounts</code> ou un simple <code>Something went wrong, contact your broker</code>. Ci-dessous, je passe en revue chaque cause avec son correctif exact, puis je montre comment l'acheminement des alertes via une couche d'automatisation comme PickMyTrade intercepte la plupart de ces problèmes avant même qu'un ordre ne parte." },
    {
      type: "checklist",
      heading: "Liste de contrôle rapide pour les rejets d'ordres en réel",
      items: [
        "<strong class='text-white'>Les données de marché en direct sont actives</strong>, abonnez-vous aux données de bourse en temps réel (CME/EUREX) sur le compte réel. Un flux absent ou retardé de 10 minutes bloque les ordres réels.",
        "<strong class='text-white'>L'accord de données est signé</strong>, acceptez l'accord de données de marché/de bourse que Tradovate vous présente à la première connexion réelle.",
        "<strong class='text-white'>L'appareil est approuvé</strong>, ouvrez l'e-mail d'approbation d'appareil et confirmez la machine. Le réel l'impose ; la démo, généralement pas.",
        "<strong class='text-white'>Le module TradingView est activé</strong>, l'habilitation TradingView (ou une formule qui l'inclut) doit être active sur le compte réel.",
        "<strong class='text-white'>Bon compte sélectionné</strong>, choisissez le compte <strong class='text-white'>Live</strong>, et non Demo, sur l'écran d'autorisation du courtier de TradingView.",
        "<strong class='text-white'>Approvisionné et dans les limites</strong>, le compte doit être approvisionné et la taille de l'ordre rester dans ses plafonds de risque/position. Les limites varient selon la société et la taille du compte ; vérifiez donc vos règles actuelles.",
      ],
    },
    { type: "heading",text: "Ce que signifie &ldquo;ordre rejeté sur un compte Tradovate réel&rdquo;" },
    { type: "paragraph",html: "Un rejet propre au réel signifie que Tradovate vous indique que quelque chose dans <strong class='text-white'>l'état réel du compte</strong>, et non dans l'ordre lui-même, n'est pas prêt. Les comptes démo et de simulation sont volontairement permissifs : ils fournissent des données retardées ou simulées, ignorent les contrôles stricts d'appareil et n'exigent pas que vous ayez droit aux données de bourse réelles. Un compte réel est l'inverse. Avant d'accepter un ordre actif, il exige un abonnement aux données en temps réel, un accord de bourse signé, un appareil approuvé et une habilitation TradingView active. S'il en manque un seul, l'ordre est refusé alors que la version démo passe sans problème." },
    { type: "paragraph",html: "Le rejet prend différentes formes selon l'élément manquant. Sans abonnement aux données en temps réel en direct côté Tradovate, vous verrez généralement quelque chose comme <strong class='text-white'>&ldquo;Non-tradable symbol: You can't trade this symbol &hellip; at TradingView via Tradovate.&rdquo;</strong> Acheter un pack de données <em>dans TradingView</em> ne suffit pas : l'abonnement en temps réel doit exister sur le compte du courtier (Tradovate). Si vous choisissez le mauvais mode de compte sur l'écran d'autorisation, vous obtiendrez <strong class='text-white'>&ldquo;You do not have access to Live/Demo accounts.&rdquo;</strong> Si le compte réel n'est pas approvisionné ou activé, vous pouvez obtenir <strong class='text-white'>&ldquo;Something went wrong, contact your broker.&rdquo;</strong>" },
    { type: "paragraph",html: "Comme le correctif dépend du verrou qui est fermé, passez-les en revue dans l'ordre : confirmez que l'ordre fonctionne en démo (ce qui isole le problème comme propre au réel), puis vérifiez les données, l'accord, l'appareil et l'habilitation. La plupart des rejets propres au réel se règlent avec les deux premiers." },
    { type: "heading",text: "Principales causes des rejets d'ordres en réel en 2026" },
    { type: "heading",text: "1. Aucun abonnement actif aux données de marché en direct" },
    { type: "paragraph",html: "C'est de loin la cause la plus fréquente. Un compte Tradovate réel a besoin d'un abonnement aux données de bourse en temps réel pour acheminer les ordres réels. Sans lui, vos cotations ont dix minutes de retard et les ordres sont rejetés comme non négociables. Un trader réel financé est généralement classé par les bourses comme <strong class='text-white'>Market Professional</strong> ; les données en direct sont donc un abonnement payant que vous gérez vous-même, et non le flux gratuit et retardé dont vous disposiez en démo." },
    { type: "heading",text: "2. L'accord de données de marché/de bourse en direct n'est pas signé" },
    { type: "paragraph",html: "À la première connexion à un compte réel, Tradovate vous invite à examiner et accepter un accord de données de marché (et à sélectionner vos bourses) avant d'activer les données en temps réel, et donc l'acheminement des ordres réels. Si cet accord a été ignoré ou jamais finalisé, les ordres réels continuent d'être rejetés même si un abonnement semble sélectionné." },
    { type: "heading",text: "3. Un nouvel appareil n'a pas été approuvé" },
    { type: "paragraph",html: "Les comptes réels appliquent strictement l'approbation des appareils. Si vous vous connectez depuis une machine, un navigateur ou un VPS non reconnu, ou via TradingView pour la première fois, Tradovate vous envoie un e-mail pour <strong class='text-white'>Approve</strong> (approuver) ou <strong class='text-white'>Deny</strong> (refuser) l'appareil, et suspend la session (et l'acheminement des ordres) jusqu'à votre approbation. Les comptes démo sont bien plus indulgents, ce qui explique précisément pourquoi la même connexion fonctionne en sim et échoue en réel." },
    { type: "heading",text: "4. Le module/l'habilitation TradingView n'est pas actif" },
    { type: "paragraph",html: "Pour trader un compte réel via TradingView, vous avez besoin d'un module TradingView actif (ou d'une formule de compte qui l'inclut) côté Tradovate. S'il manque, TradingView signale <strong class='text-white'>&ldquo;TradingView has not been entitled to access your account,&rdquo;</strong> et rien n'est acheminé." },
    { type: "heading",text: "5. Mauvais compte sélectionné, non approvisionné ou verrou de prop firm" },
    { type: "paragraph",html: "Sur la page d'autorisation du courtier de TradingView, vous choisissez le type de compte à connecter. Si vous choisissez le mauvais, vous tombez sur &ldquo;You do not have access to Live/Demo accounts.&rdquo; Un compte réel non approvisionné peut ne jamais atteindre le mode réel. Et sur un compte d'évaluation de prop firm, l'accès à TradingView et les données de marché sont contrôlés par la <strong class='text-white'>prop firm</strong> : vous ne pouvez pas vous abonner vous-même et devez demander à la société de les activer." },
    { type: "heading",text: "Comment corriger les rejets d'ordres en réel : pas à pas" },
    { type: "heading",text: "Corriger les données de marché en direct (le coupable habituel)" },
    {
      type: "steps",
      items: [
        { title: "Connectez-vous au compte réel", html: "Connectez-vous au Tradovate Web Trader avec votre compte réel." },
        { title: "Ouvrez les paramètres Market Data", html: "Ouvrez <strong class='text-white'>Application Settings</strong> (le menu engrenage/paramètres) et accédez à la section <strong class='text-white'>Market Data</strong>." },
        { title: "Abonnez-vous aux données en temps réel", html: "Abonnez-vous aux données de bourse en temps réel que vous tradez (par exemple CME Group / EUREX Level 1). C'est un abonnement en temps réel en direct, et non un flux retardé, qui active l'acheminement des ordres réels." },
        { title: "Finalisez l'abonnement", html: "Effectuez toute étape de paiement/d'abonnement. Les tarifs varient et évoluent avec le temps ; consultez donc les tarifs actuels des données de marché de Tradovate plutôt que de vous fier à un ancien chiffre." },
        { title: "Reconnectez-vous et réessayez", html: "Déconnectez-vous puis reconnectez-vous pour que le nouvel abonnement prenne effet, puis soumettez de nouveau l'ordre." },
      ],
    },
    { type: "heading",text: "Corriger l'accord de données signé" },
    {
      type: "steps",
      items: [
        { title: "Trouvez l'invite de l'accord", html: "Dans la même zone <strong class='text-white'>Market Data</strong>, repérez l'invite de l'accord de données de marché/de bourse en direct (Tradovate la présente à la première connexion réelle)." },
        { title: "Choisissez votre classification", html: "Examinez la classification Professional / Non-Professional (un lien explique les deux types d'utilisateurs) et choisissez le statut qui correspond honnêtement à votre situation." },
        { title: "Acceptez les conditions", html: "Lisez et <strong class='text-white'>acceptez</strong> les Conditions générales pour finaliser l'activation des données en temps réel." },
        { title: "Confirmez et réessayez", html: "Vérifiez que l'abonnement apparaît maintenant comme actif, puis relancez votre ordre réel." },
      ],
    },
    { type: "heading",text: "Corriger l'approbation de l'appareil" },
    {
      type: "steps",
      items: [
        { title: "Trouvez l'e-mail de connexion d'appareil", html: "Ouvrez la boîte de réception associée à votre compte Tradovate et trouvez la notification de connexion d'appareil. Vérifiez <strong class='text-white'>Spam/Junk</strong> et <strong class='text-white'>Promotions</strong>, et recherchez &ldquo;Tradovate&rdquo; s'il n'est pas dans votre boîte de réception." },
        { title: "Approuvez l'appareil", html: "Ouvrez-le et cliquez sur <strong class='text-white'>Approve</strong> (jamais Deny : Deny bloque cet appareil pour la tentative)." },
        { title: "Renvoyez-le s'il n'est jamais arrivé", html: "Si aucun e-mail n'est arrivé, connectez-vous depuis un appareil déjà approuvé, ouvrez <strong class='text-white'>Application Settings &gt; My Devices</strong>, repérez l'appareil <strong class='text-white'>Pending</strong> et cliquez sur <strong class='text-white'>Forget</strong> pour régénérer un nouvel e-mail d'approbation/de refus." },
        { title: "Passez à nouveau l'ordre", html: "Retournez dans TradingView (ou dans l'application) et passez de nouveau l'ordre." },
      ],
    },
    { type: "heading",text: "Corriger l'habilitation et la sélection du compte" },
    {
      type: "steps",
      items: [
        { title: "Confirmez que le module est activé", html: "Dans les paramètres de Tradovate, confirmez que le <strong class='text-white'>TradingView add-on</strong> (ou une formule qui l'inclut) est activé sur le compte réel. Sur un compte d'évaluation de prop firm, contactez la société pour qu'elle l'active : vous ne pouvez pas l'activer vous-même." },
        { title: "Reconnectez-vous et sélectionnez Live", html: "Dans TradingView, ouvrez la connexion au courtier Tradovate et reconnectez-vous. Sur l'écran d'autorisation, veillez à sélectionner le bon compte <strong class='text-white'>Live</strong> (et non Demo). Choisir le mauvais mode déclenche &ldquo;You do not have access to Live/Demo accounts.&rdquo;" },
        { title: "Actualisez l'habilitation si nécessaire", html: "Si TradingView indique toujours que le compte n'est pas habilité après l'activation du module, déconnectez puis reconnectez le courtier afin que l'habilitation soit actualisée." },
      ],
    },
    { type: "heading",text: "Quand l'ordre n'est toujours rejeté qu'en réel" },
    { type: "paragraph",html: "Si la démo s'exécute, que les données sont souscrites, que l'accord est signé, que l'appareil est approuvé et que le module est actif, mais que le réel rejette toujours, <strong class='text-white'>contactez le support</strong>. La solution à l'erreur d'accès réel/démo est de faire vérifier l'état de votre compte par votre courtier et de confirmer que tout est activé pour le trading. Pour un compte en gestion autonome, contactez Tradovate ; pour une évaluation de prop firm, contactez la société, car elle seule peut modifier les indicateurs côté compte." },
    { type: "heading",text: "Tableau de dépannage" },
    { type: "table", headers: ["Erreur","Signification","Correctif"], rows: [
      ["Non-tradable symbol: You can't trade this symbol &hellip; at TradingView via Tradovate","Aucun abonnement actif aux données en temps réel côté Tradovate (ou symbole non négociable/continu)","Abonnez-vous aux données de bourse en direct dans Tradovate et tradez le contrat actif du mois le plus proche"],
      ["You do not have access to Live/Demo accounts","Mauvais type de compte choisi sur la page d'autorisation, ou le compte n'est pas activé pour TradingView","Resélectionnez le bon compte (Live) sur l'écran d'autorisation ; demandez au courtier de confirmer qu'il est activé"],
      ["Something went wrong, contact your broker","Le compte réel n'est pas approvisionné ou pas activé pour l'accès TradingView en réel","Approvisionnez/activez le compte réel, ou utilisez Demo avec le module TradingView"],
      ["TradingView has not been entitled to access your account","Le module/l'habilitation TradingView n'est pas actif sur le compte","Activez le module TradingView dans les paramètres de Tradovate (ou demandez à votre prop firm de l'activer)"],
      ["S'exécute en démo, rejeté en réel","Un verrou propre au réel : accord de données non signé ou appareil non approuvé","Signez l'accord de données en direct et approuvez l'appareil depuis le lien reçu par e-mail"],
      ["Ordre rejeté pour dépassement de la taille du compte","La quantité de l'ordre dépasse le plafond de risque/position du compte","Réduisez la quantité ou relevez la limite (les limites varient selon la société et la taille du compte ; vérifiez vos règles actuelles)"],
    ] },
    { type: "heading",text: "Évitez cela avec PickMyTrade" },
    { type: "paragraph",html: "La plupart des rejets propres au réel proviennent d'un verrou de compte facile à manquer jusqu'à ce qu'un ordre échoue au pire moment. PickMyTrade s'intercale entre vos alertes TradingView et Tradovate et échoue en toute sécurité lorsqu'un verrou n'est pas prêt, au lieu d'envoyer un ordre qui sera rejeté." },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Garde-fous d'acheminement live vs démo</strong>, associez chaque alerte au compte réel exact visé, afin que les ordres ne partent jamais vers le mauvais mode ou vers un compte non habilité.",
        "<strong class='text-white'>Validation de la quantité / du symbole</strong>, bloque les ordres sur des symboles non négociables ou surdimensionnés avant qu'ils n'atteignent Tradovate.",
        "<strong class='text-white'>Filtres de risque et d'habilitation</strong>, respectent les limites de la prop firm et l'état de l'accord de données, de sorte qu'un compte pas encore activé échoue en toute sécurité au lieu de multiplier les rejets.",
        "<strong class='text-white'>Synchronisation multi-comptes</strong>, une fois le verrou levé, répliquez l'ordre corrigé sur tous vos comptes depuis un seul endroit.",
      ],
    },
  ], it: [
    { type: "paragraph",html: "Ha finanziato il Suo conto Tradovate reale, ha collegato una strategia TradingView, ha premuto <strong class='text-white'>Buy</strong> e l'ordine è tornato subito rifiutato. Nel frattempo lo stesso alert viene eseguito all'istante sul Suo conto sim. È uno dei problemi Tradovate più comuni (e più esasperanti), e c'è una buona notizia: un rifiuto che compare <strong class='text-white'>solo sul reale</strong> non significa quasi mai che la Sua strategia sia difettosa. Significa che uno di pochi requisiti legati allo stato del conto non è ancora soddisfatto: dati di mercato live, un accordo sui dati firmato, l'approvazione del dispositivo o l'abilitazione TradingView. Può presentarsi come messaggio <code>Non-tradable symbol</code>, come errore <code>You do not have access to Live/Demo accounts</code> o come un semplice <code>Something went wrong, contact your broker</code>. Di seguito esamino ogni causa con la correzione esatta, poi mostro come instradare gli alert tramite un livello di automazione come PickMyTrade intercetti la maggior parte di questi problemi prima ancora che un ordine parta." },
    {
      type: "checklist",
      heading: "Checklist rapida per i rifiuti di ordini sul reale",
      items: [
        "<strong class='text-white'>I dati di mercato live sono attivi</strong>, si abboni ai dati di borsa in tempo reale (CME/EUREX) sul conto reale. Un feed mancante o ritardato di 10 minuti blocca gli ordini reali.",
        "<strong class='text-white'>L'accordo sui dati è firmato</strong>, accetti l'accordo sui dati di mercato/di borsa che Tradovate Le propone al primo accesso reale.",
        "<strong class='text-white'>Il dispositivo è approvato</strong>, apra l'e-mail di approvazione del dispositivo e confermi la macchina. Il reale lo impone; la demo di solito no.",
        "<strong class='text-white'>L'add-on TradingView è abilitato</strong>, l'abilitazione TradingView (o un piano che la includa) deve essere attiva sul conto reale.",
        "<strong class='text-white'>Conto corretto selezionato</strong>, scelga il conto <strong class='text-white'>Live</strong>, non Demo, nella schermata di autorizzazione del broker di TradingView.",
        "<strong class='text-white'>Finanziato e nei limiti</strong>, il conto deve essere finanziato e la dimensione dell'ordine entro i limiti di rischio/posizione. I limiti variano in base alla società e alla dimensione del conto, quindi verifichi le Sue regole attuali.",
      ],
    },
    { type: "heading",text: "Che cosa significa &ldquo;ordine rifiutato su un conto Tradovate reale&rdquo;" },
    { type: "paragraph",html: "Un rifiuto solo sul reale è Tradovate che Le dice che qualcosa nello <strong class='text-white'>stato reale del conto</strong>, non nell'ordine in sé, non è pronto. I conti demo e di simulazione sono volutamente permissivi: forniscono dati ritardati o simulati, saltano i controlli rigorosi sul dispositivo e non richiedono che Lei sia abilitato ai dati di borsa reali. Un conto reale è l'opposto. Prima di accettare un ordine di lavoro, richiede un abbonamento ai dati in tempo reale, un accordo di borsa firmato, un dispositivo approvato e un'abilitazione TradingView attiva. Se ne manca uno, l'ordine viene rifiutato mentre la versione demo passa senza problemi." },
    { type: "paragraph",html: "Il rifiuto compare con etichette diverse a seconda di quale elemento manca. Senza un abbonamento live ai dati in tempo reale lato Tradovate, di solito vedrà qualcosa come <strong class='text-white'>&ldquo;Non-tradable symbol: You can't trade this symbol &hellip; at TradingView via Tradovate.&rdquo;</strong> Acquistare un pacchetto di dati <em>all'interno di TradingView</em> non basta: l'abbonamento in tempo reale deve esistere sul conto del broker (Tradovate). Se sceglie la modalità di conto sbagliata nella schermata di autorizzazione, otterrà <strong class='text-white'>&ldquo;You do not have access to Live/Demo accounts.&rdquo;</strong> Se il conto reale non è finanziato o abilitato, può comparire <strong class='text-white'>&ldquo;Something went wrong, contact your broker.&rdquo;</strong>" },
    { type: "paragraph",html: "Poiché la soluzione dipende da quale requisito è chiuso, li esamini in ordine: confermi che l'ordine funziona in demo (il che isola il problema come solo reale), poi controlli dati, accordo, dispositivo e abilitazione. La maggior parte dei rifiuti solo reali si risolve con i primi due." },
    { type: "heading",text: "Cause principali dei rifiuti di ordini sul reale nel 2026" },
    { type: "heading",text: "1. Nessun abbonamento attivo ai dati di mercato live" },
    { type: "paragraph",html: "È di gran lunga la causa più comune. Un conto Tradovate reale richiede un abbonamento ai dati di borsa in tempo reale per instradare gli ordini reali. Senza, le quotazioni sono in ritardo di dieci minuti e gli ordini vengono rifiutati come non negoziabili. Un trader con conto reale finanziato viene in genere classificato dalle borse come <strong class='text-white'>Market Professional</strong>, quindi i dati live sono un abbonamento a pagamento che Lei stesso mantiene, non il feed gratuito e ritardato della demo." },
    { type: "heading",text: "2. L'accordo sui dati di mercato/di borsa live non è firmato" },
    { type: "paragraph",html: "La prima volta che accede a un conto reale, Tradovate Le chiede di leggere e accettare un accordo sui dati di mercato (e di selezionare le borse) prima di attivare i dati in tempo reale e quindi l'instradamento degli ordini reali. Se l'accordo è stato saltato o mai completato, gli ordini reali continuano a essere rifiutati anche se un abbonamento sembra selezionato." },
    { type: "heading",text: "3. Un nuovo dispositivo non è stato approvato" },
    { type: "paragraph",html: "I conti reali applicano rigorosamente l'approvazione dei dispositivi. Se accede da una macchina, un browser o una VPS non riconosciuti, o tramite TradingView per la prima volta, Tradovate Le invia un'e-mail per <strong class='text-white'>Approve</strong> (approvare) o <strong class='text-white'>Deny</strong> (negare) il dispositivo, tenendo in sospeso la sessione (e l'instradamento degli ordini) finché non approva. I conti demo sono molto più indulgenti, ed è proprio per questo che la stessa connessione funziona sul sim e fallisce sul reale." },
    { type: "heading",text: "4. L'add-on/abilitazione TradingView non è attivo" },
    { type: "paragraph",html: "Per operare su un conto reale tramite TradingView serve un add-on TradingView attivo (o un piano di conto che lo includa) lato Tradovate. Se manca, TradingView segnala <strong class='text-white'>&ldquo;TradingView has not been entitled to access your account,&rdquo;</strong> e nulla viene instradato." },
    { type: "heading",text: "5. Conto sbagliato, non finanziato o vincolo della prop firm" },
    { type: "paragraph",html: "Nella pagina di autorizzazione del broker di TradingView sceglie quale tipo di conto collegare. Se sceglie quello sbagliato, finisce su &ldquo;You do not have access to Live/Demo accounts.&rdquo; Un conto reale non finanziato può non raggiungere affatto la modalità reale. E su un conto di valutazione di una prop firm, l'accesso a TradingView e i dati di mercato sono controllati dalla <strong class='text-white'>prop firm</strong>: non può abbonarsi da solo e deve chiedere alla società di abilitarli." },
    { type: "heading",text: "Come risolvere i rifiuti di ordini sul reale: passo dopo passo" },
    { type: "heading",text: "Risolvere i dati di mercato live (il solito colpevole)" },
    {
      type: "steps",
      items: [
        { title: "Acceda al conto reale", html: "Acceda al Tradovate Web Trader con il Suo conto reale." },
        { title: "Apra le impostazioni Market Data", html: "Apra <strong class='text-white'>Application Settings</strong> (il menu a ingranaggio/impostazioni) e vada alla sezione <strong class='text-white'>Market Data</strong>." },
        { title: "Si abboni ai dati in tempo reale", html: "Si abboni ai dati di borsa in tempo reale su cui opera (per esempio CME Group / EUREX Level 1). Un abbonamento live in tempo reale, non un feed ritardato, è ciò che abilita l'instradamento degli ordini reali." },
        { title: "Completi l'abbonamento", html: "Completi l'eventuale passaggio di pagamento/abbonamento. Le tariffe variano e cambiano nel tempo, quindi verifichi le tariffe attuali dei dati di mercato di Tradovate anziché affidarsi a una cifra vecchia." },
        { title: "Acceda di nuovo e riprovi", html: "Esca e riaccede affinché il nuovo abbonamento abbia effetto, poi invii di nuovo l'ordine." },
      ],
    },
    { type: "heading",text: "Risolvere l'accordo sui dati firmato" },
    {
      type: "steps",
      items: [
        { title: "Trovi la richiesta dell'accordo", html: "Nella stessa area <strong class='text-white'>Market Data</strong>, trovi la richiesta dell'accordo sui dati di mercato/di borsa live (Tradovate la presenta al primo accesso reale)." },
        { title: "Scelga la classificazione", html: "Esamini la classificazione Professional / Non-Professional (un link spiega i due tipi di utente) e scelga lo status che Le corrisponde onestamente." },
        { title: "Accetti i termini", html: "Legga e <strong class='text-white'>accetti</strong> i Termini e Condizioni per completare l'abilitazione dei dati in tempo reale." },
        { title: "Confermi e riprovi", html: "Confermi che l'abbonamento risulti ora attivo, poi riprovi il Suo ordine reale." },
      ],
    },
    { type: "heading",text: "Risolvere l'approvazione del dispositivo" },
    {
      type: "steps",
      items: [
        { title: "Trovi l'e-mail di accesso del dispositivo", html: "Apra la casella di posta associata al Suo conto Tradovate e trovi la notifica di accesso del dispositivo. Controlli <strong class='text-white'>Spam/Junk</strong> e <strong class='text-white'>Promotions</strong> e cerchi &ldquo;Tradovate&rdquo; se non è nella posta in arrivo." },
        { title: "Approvi il dispositivo", html: "La apra e clicchi su <strong class='text-white'>Approve</strong> (mai Deny: Deny blocca quel dispositivo per il tentativo)." },
        { title: "Reinvii se non è mai arrivata", html: "Se non è arrivata alcuna e-mail, acceda da un dispositivo già approvato, apra <strong class='text-white'>Application Settings &gt; My Devices</strong>, trovi il dispositivo <strong class='text-white'>Pending</strong> e clicchi su <strong class='text-white'>Forget</strong> per rigenerare una nuova e-mail di approvazione/rifiuto." },
        { title: "Inserisca di nuovo l'ordine", html: "Torni su TradingView (o sull'app) e inserisca di nuovo l'ordine." },
      ],
    },
    { type: "heading",text: "Risolvere l'abilitazione e la selezione del conto" },
    {
      type: "steps",
      items: [
        { title: "Confermi che l'add-on è abilitato", html: "Nelle impostazioni di Tradovate, confermi che il <strong class='text-white'>TradingView add-on</strong> (o un piano che lo includa) sia abilitato sul conto reale. Su un conto di valutazione di una prop firm, contatti la società affinché lo abiliti: non può attivarlo da solo." },
        { title: "Ricolleghi e selezioni Live", html: "In TradingView, apra la connessione al broker Tradovate e ricolleghi. Nella schermata di autorizzazione, si assicuri di selezionare il conto <strong class='text-white'>Live</strong> corretto (non Demo). Scegliere la modalità sbagliata è ciò che genera &ldquo;You do not have access to Live/Demo accounts.&rdquo;" },
        { title: "Aggiorni l'abilitazione se necessario", html: "Se TradingView continua a dire che il conto non è abilitato dopo aver attivato l'add-on, scolleghi e ricolleghi il broker in modo che l'abilitazione venga aggiornata." },
      ],
    },
    { type: "heading",text: "Quando l'ordine viene ancora rifiutato solo sul reale" },
    { type: "paragraph",html: "Se la demo viene eseguita, i dati sono sottoscritti, l'accordo è firmato, il dispositivo è approvato e l'add-on è attivo, ma il reale rifiuta ancora, <strong class='text-white'>contatti il supporto</strong>. La soluzione all'errore di accesso live/demo è far verificare al Suo broker lo stato del conto e confermare che tutto sia abilitato per il trading. Per un conto autogestito contatti Tradovate; per una valutazione di una prop firm contatti la società, perché solo lei può modificare i flag lato conto." },
    { type: "heading",text: "Tabella di risoluzione dei problemi" },
    { type: "table", headers: ["Errore","Significato","Soluzione"], rows: [
      ["Non-tradable symbol: You can't trade this symbol &hellip; at TradingView via Tradovate","Nessun abbonamento attivo ai dati in tempo reale lato Tradovate (oppure simbolo non negoziabile/continuo)","Si abboni ai dati di borsa live in Tradovate e operi sul contratto front-month attivo"],
      ["You do not have access to Live/Demo accounts","Tipo di conto sbagliato scelto nella pagina di autorizzazione, oppure il conto non è abilitato per TradingView","Riselezioni il conto corretto (Live) nella schermata di autorizzazione; chieda al broker di confermare che sia abilitato"],
      ["Something went wrong, contact your broker","Il conto reale non è finanziato o non è abilitato all'accesso TradingView live","Finanzi/abiliti il conto reale, oppure usi Demo con l'add-on TradingView"],
      ["TradingView has not been entitled to access your account","L'add-on/abilitazione TradingView non è attivo sul conto","Abiliti l'add-on TradingView nelle impostazioni di Tradovate (oppure chieda alla prop firm di abilitarlo)"],
      ["Eseguito in demo, rifiutato sul reale","Un requisito solo reale: accordo sui dati non firmato o dispositivo non approvato","Firmi l'accordo sui dati live e approvi il dispositivo dal link ricevuto via e-mail"],
      ["Ordine rifiutato per superamento della dimensione del conto","La quantità dell'ordine supera il limite di rischio/posizione del conto","Riduca la quantità o aumenti il limite (i limiti variano in base alla società e alla dimensione del conto, verifichi le Sue regole attuali)"],
    ] },
    { type: "heading",text: "Lo prevenga con PickMyTrade" },
    { type: "paragraph",html: "La maggior parte dei rifiuti solo reali deriva da un requisito del conto facile da trascurare finché un ordine fallisce nel momento peggiore. PickMyTrade si colloca tra i Suoi alert TradingView e Tradovate e fallisce in sicurezza quando un requisito non è pronto, invece di inviare un ordine che viene respinto." },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Protezioni di instradamento live vs demo</strong>, associ ogni alert all'esatto conto reale desiderato, così gli ordini non partono mai verso la modalità sbagliata o un conto non abilitato.",
        "<strong class='text-white'>Validazione di quantità / simbolo</strong>, blocca gli ordini su simboli non negoziabili o sovradimensionati prima che raggiungano Tradovate.",
        "<strong class='text-white'>Filtri di rischio e abilitazione</strong>, rispettano i limiti della prop firm e lo stato dell'accordo sui dati, così un conto non ancora abilitato fallisce in sicurezza anziché generare una raffica di rifiuti.",
        "<strong class='text-white'>Sincronizzazione multi-account</strong>, una volta superato il requisito, replichi l'ordine corretto su tutti i Suoi conti da un unico punto.",
      ],
    },
