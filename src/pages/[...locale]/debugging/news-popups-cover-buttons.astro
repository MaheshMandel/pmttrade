---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "news-popups-cover-buttons";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/debugging/${SLUG}`;

const META_TITLE = "Tradovate News Popups Cover DOM Trading Buttons";
const META_DESCRIPTION =
  "News popups covering your Tradovate order buttons? Disable news notifications in Application Settings to stop the overlay and avoid accidental clicks.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Tradovate-News-Popups verdecken die DOM-Handelsbuttons", es: "Las ventanas emergentes de noticias de Tradovate tapan los botones del DOM", fr: "Les pop-ups d'actualités Tradovate masquent les boutons du DOM", it: "I popup delle notizie di Tradovate coprono i pulsanti del DOM" },
  dek: { en: "A news alert slides over your DOM mid-trade, you misjudge the click to dismiss it, and now there's an order working you never meant to send. There's a real setting for this, not a workaround.", de: "Mitten im Trade schiebt sich eine Nachrichtenmeldung über Ihr DOM, Sie verfehlen beim Wegklicken den Button, und plötzlich läuft eine Order, die Sie nie senden wollten. Dafür gibt es eine echte Einstellung, keinen Umweg.", es: "Una alerta de noticias se desliza sobre su DOM en pleno trade, usted calcula mal el clic para cerrarla y de repente hay una orden en marcha que nunca quiso enviar. Existe un ajuste real para esto, no una solución improvisada.", fr: "Une alerte d'actualités glisse sur votre DOM en plein trade, vous manquez le clic pour la fermer, et voilà un ordre en cours que vous n'aviez jamais voulu envoyer. Il existe un vrai réglage pour cela, pas une solution de contournement.", it: "Un avviso di notizie scorre sopra il suo DOM nel mezzo di un trade, lei sbaglia il clic per chiuderlo e ora c'è un ordine in corso che non voleva mai inviare. Esiste un'impostazione vera per questo, non un ripiego." },
  readTime: { en: "6 min read", de: "6 Min. Lesezeit", es: "Lectura de 6 min", fr: "Lecture : 6 min", it: "Lettura di 6 min" },
  lastUpdated: "2026-07-10",
  blocks: { en: [
    { type: "paragraph", html: "You're in a scalp on ES, price is ripping toward your target, and a news alert box slides up right over the top of your DOM. You reach to swat it away, misjudge the click by a few pixels, and now there's a market order working that you never meant to send. If that's happened to you, you already know the news popup isn't just an annoyance, it costs money. The fix is simple, and it's an actual setting, not a hack: Tradovate added a switch for news notifications a few years back, so you can shut them off in a couple of clicks and stop them from parking over your order buttons." },
    {
      type: "checklist",
      heading: "Quick Checklist",
      items: [
        "<strong class='text-white'>Fastest fix</strong>, open <strong class='text-white'>Application Settings</strong> (top right), go to <strong class='text-white'>Preferences</strong>, find the <strong class='text-white'>Notifications</strong> section, and turn news notifications off.",
        "<strong class='text-white'>Want to keep the news but kill the popup</strong>, leave the notification <em>unread</em> (don't clear the red flag) and the box won't pop up on its own.",
        "<strong class='text-white'>Want the whole panel gone</strong>, toggle off the <strong class='text-white'>Notification Ticker</strong> to remove the entire strip that carries the clock and the notifications.",
        "<strong class='text-white'>On the mobile app</strong>, there's no full off switch; swipe left on an update to suspend it.",
        "<strong class='text-white'>Still popping after you changed it?</strong>, make sure you saved on the profile and workspace you actually trade in, then restart the platform.",
      ],
    },
    { type: "heading", text: "Why the News Popup Lands Right on Your Order Buttons" },
    { type: "paragraph", html: "The news alert is a floating notification, a small panel that renders <em>on top</em> of everything else in the workspace so you'll actually notice it. That's fine when it appears over an empty corner of the screen. It's a problem when your DOM, SuperDOM, or order ticket happens to sit exactly where the box pops up. The alert covers the price ladder and the Buy/Sell buttons, and the natural reflex, click to dismiss it, puts your cursor right in the danger zone. One misjudged click and you've filled a contract you didn't want, or flattened a position you were still holding." },
    { type: "paragraph", html: "This gets worse the more compact your layout is. If you run a tight single-monitor setup with the DOM front and center, there's nowhere for the popup to go <em>except</em> over your working area. And because news hits are unpredictable, it always seems to show up at the worst possible moment, right as you're clicking into a position." },
    { type: "paragraph", html: "The clean answer is to stop the popups from appearing at all. Since a 2021 platform update, Tradovate has a dedicated on/off control for news notifications, so you're not stuck choosing between living with the overlay and dragging your DOM somewhere awkward every session." },
    { type: "heading", text: "How to Turn Off News Notifications in Tradovate" },
    { type: "paragraph", html: "This lives in Application Settings and takes under a minute. Labels shift a little between platform versions, so if a name doesn't match exactly, look for the closest equivalent in the same area." },
    {
      type: "steps",
      items: [
        { title: "Open Application Settings", html: "Click the <strong class='text-white'>Application Settings</strong> button in the top-right corner of the platform (the gear-style control). This is the same panel where you manage your workspace, notifications, and audio preferences." },
        { title: "Go to Preferences and find Notifications", html: "Open the <strong class='text-white'>Preferences</strong> tab, then scroll down to the <strong class='text-white'>Notifications</strong> section. This is the hub for what the platform is allowed to surface at you, order status alerts, the notification ticker, audio, and the news notifications you're here to switch off." },
        { title: "Switch news notifications off", html: "In the Notifications section, find the toggle that controls <strong class='text-white'>news notifications</strong> and turn it off. Save if the panel asks you to. That single switch stops the news box from popping over your trading modules, it doesn't touch your market data, your orders, or your price alerts." },
      ],
    },
    { type: "paragraph", html: "Back on your chart or DOM, the popups should stop. If you don't see any change right away, restart the platform so the setting takes hold, and double-check you made the change on the workspace you're actually trading in." },
    { type: "heading", text: "Other Ways to Keep News Out of Your Way" },
    { type: "heading", text: "Leave the Notification Unread" },
    { type: "paragraph", html: "Don't want to lose the news entirely? There's a lighter touch. If you <em>leave the notification unread</em>, meaning you let the red flag sit there without clicking to clear it, the popup box won't force itself onto the screen. You still get the signal that something came through, and you read it when you choose to, instead of the platform shoving it over your order buttons in the middle of a trade. It's a good middle ground if you like having news on hand but hate the interruption." },
    { type: "heading", text: "Remove the Whole Notification Ticker" },
    { type: "paragraph", html: "If it's not just news that bugs you, if you'd rather reclaim the whole strip, the Notifications section has a <strong class='text-white'>Notification Ticker</strong> toggle. Turning that off hides the entire panel that carries the clock and the running notifications, not just the news items. That's the most aggressive option, and it's handy when you want a stripped-down, distraction-free workspace with maximum room for your chart and ladder." },
    { type: "heading", text: "On the Mobile App" },
    { type: "paragraph", html: "The mobile app doesn't give you a full off switch for internal notifications the way the desktop and web platforms do. What you can do is <strong class='text-white'>swipe left on an update</strong> to suspend it and clear it off your screen. Keep in mind these in-app updates aren't the same as push notifications, push alerts are the ones that show up outside the app and are governed by your phone's own notification settings." },
    { type: "heading", text: "Troubleshooting Table" },
    {
      type: "table",
      headers: ["Situation", "What's going on", "What to do"],
      rows: [
        ["Popup lands over the DOM buttons", "News alert renders on top of your trading modules", "Turn off news notifications in Application Settings &gt; Preferences &gt; Notifications"],
        ["Accidental order while dismissing news", "Click to close the box lands on a Buy/Sell button", "Disable news popups, or move the DOM so nothing sits under the alert"],
        ["You still want the news, just not the interruption", "Popup only fires when the item is unread and surfaced", "Leave the notification unread, keep the red flag, skip the popup"],
        ["Whole ticker/clock strip is in the way", "The notification panel itself is taking screen space", "Toggle off the Notification Ticker to hide the entire panel"],
        ["Turned news off but it still pops", "Change didn't save, or wrong profile/workspace", "Re-save, restart the platform, confirm you edited the active workspace"],
        ["Can't fully disable on your phone", "Mobile has no complete off switch for internal updates", "Swipe left to suspend an update; manage push alerts in phone settings"],
      ],
    },
    { type: "heading", text: "Stop Babysitting the DOM with PickMyTrade" },
    { type: "paragraph", html: "Turning off the news popup fixes the overlay, but there's a deeper issue hiding in that misclick story: you were manually clicking into a position when the interruption hit. Anytime your entries and exits depend on a well-placed click on a live ladder, a popup, or a lag spike, or a fat finger, can turn into a real trade. PickMyTrade takes that risk off the table by automating the execution itself." },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Alerts route straight to Tradovate</strong>, your TradingView signals fire orders directly, so a news box floating over the DOM can't cause a misclick, because you're not clicking the DOM to enter.",
        "<strong class='text-white'>Consistent, rule-based entries</strong>, every order goes in at the level your strategy defines, not wherever your cursor happened to be when the popup interrupted you.",
        "<strong class='text-white'>Hands-off during news</strong>, you can step back from the screen during volatile releases and let your logic handle entries and exits, instead of fighting popups in real time.",
        "<strong class='text-white'>Multi-account sync</strong>, the same automated flow runs across every connected Tradovate account at once, so no single window's clutter throws off your execution.",
      ],
    },
    { type: "paragraph", html: "Clean up the interface, sure, but if a popup could ever cost you a trade, the real answer is to stop trading through a screen you have to babysit." },
  ], de: [
    { type: "paragraph",html: "Sie sind in einem Scalp auf ES, der Kurs läuft auf Ihr Ziel zu, und ein News-Fenster schiebt sich genau über Ihr DOM. Sie wollen es wegwischen, verfehlen den Klick um ein paar Pixel, und schon läuft eine Market-Order, die Sie nie senden wollten. Wenn Ihnen das passiert ist, wissen Sie: Das News-Popup ist nicht nur lästig, es kostet Geld. Die Lösung ist einfach und eine echte Einstellung, kein Hack: Tradovate hat vor einigen Jahren einen Schalter für News-Benachrichtigungen ergänzt, sodass Sie diese mit wenigen Klicks ausschalten und verhindern können, dass sie sich über Ihre Order-Buttons legen." },
    {
      type: "checklist",
      heading: "Schnell-Checkliste",
      items: [
        "<strong class='text-white'>Schnellste Lösung</strong>: Öffnen Sie die <strong class='text-white'>Application Settings</strong> (oben rechts), wechseln Sie zu <strong class='text-white'>Preferences</strong>, suchen Sie den Bereich <strong class='text-white'>Notifications</strong> und schalten Sie die News-Benachrichtigungen aus.",
        "<strong class='text-white'>News behalten, Popup abstellen</strong>: Lassen Sie die Benachrichtigung <em>ungelesen</em> (löschen Sie die rote Markierung nicht), dann erscheint das Fenster nicht von selbst.",
        "<strong class='text-white'>Das ganze Panel loswerden</strong>: Deaktivieren Sie den <strong class='text-white'>Notification Ticker</strong>, um den gesamten Streifen mit Uhr und Benachrichtigungen zu entfernen.",
        "<strong class='text-white'>In der mobilen App</strong> gibt es keinen vollständigen Ausschalter; wischen Sie eine Meldung nach links, um sie zu unterdrücken.",
        "<strong class='text-white'>Popups trotz Änderung?</strong> Stellen Sie sicher, dass Sie in dem Profil und Workspace gespeichert haben, in dem Sie handeln, und starten Sie die Plattform neu.",
      ],
    },
    { type: "heading",text: "Warum das News-Popup genau auf Ihren Order-Buttons landet" },
    { type: "paragraph",html: "Die News-Meldung ist eine schwebende Benachrichtigung, ein kleines Fenster, das <em>über</em> allem anderen im Workspace gerendert wird, damit Sie es auch bemerken. Das ist in Ordnung, wenn es in einer leeren Ecke des Bildschirms erscheint. Zum Problem wird es, wenn Ihr DOM, SuperDOM oder Order-Ticket genau dort liegt, wo das Fenster aufpoppt. Die Meldung verdeckt die Preisleiter und die Buy/Sell-Buttons, und der natürliche Reflex, sie wegzuklicken, bringt Ihren Cursor mitten in die Gefahrenzone. Ein einziger verfehlter Klick, und Sie haben einen Kontrakt gekauft, den Sie nicht wollten, oder eine Position glattgestellt, die Sie noch halten wollten." },
    { type: "paragraph",html: "Das wird umso schlimmer, je kompakter Ihr Layout ist. Wenn Sie mit einem engen Ein-Monitor-Setup arbeiten und das DOM im Mittelpunkt steht, hat das Popup <em>nur</em> Ihren Arbeitsbereich als Ziel. Und weil News-Treffer unvorhersehbar sind, erscheinen sie immer im ungünstigsten Moment, genau dann, wenn Sie in eine Position klicken." },
    { type: "paragraph",html: "Die saubere Lösung ist, die Popups gar nicht erst erscheinen zu lassen. Seit einem Plattform-Update von 2021 bietet Tradovate einen eigenen Ein/Aus-Schalter für News-Benachrichtigungen, sodass Sie nicht zwischen dem Overlay und dem ständigen Verschieben Ihres DOM in jeder Sitzung wählen müssen." },
    { type: "heading",text: "So schalten Sie die News-Benachrichtigungen in Tradovate aus" },
    { type: "paragraph",html: "Die Einstellung befindet sich in den Application Settings und ist in unter einer Minute erledigt. Die Bezeichnungen unterscheiden sich leicht zwischen Plattformversionen. Passt ein Name nicht genau, suchen Sie die nächstliegende Entsprechung im selben Bereich." },
    {
      type: "steps",
      items: [
        { title: "Application Settings öffnen", html: "Klicken Sie oben rechts in der Plattform auf die Schaltfläche <strong class='text-white'>Application Settings</strong> (das zahnradartige Symbol). In diesem Panel verwalten Sie Ihren Workspace, Benachrichtigungen und Audio-Einstellungen." },
        { title: "Zu Preferences wechseln und Notifications finden", html: "Öffnen Sie den Tab <strong class='text-white'>Preferences</strong> und scrollen Sie dann zum Bereich <strong class='text-white'>Notifications</strong>. Hier legen Sie fest, was die Plattform Ihnen anzeigen darf: Order-Status-Alerts, den Notification Ticker, Audio und die News-Benachrichtigungen, die Sie ausschalten möchten." },
        { title: "News-Benachrichtigungen ausschalten", html: "Suchen Sie im Bereich Notifications den Schalter für <strong class='text-white'>News-Benachrichtigungen</strong> und schalten Sie ihn aus. Speichern Sie, falls das Panel dazu auffordert. Dieser eine Schalter verhindert, dass das News-Fenster über Ihren Handelsmodulen aufpoppt; Marktdaten, Orders und Preis-Alerts bleiben unberührt." },
      ],
    },
    { type: "paragraph",html: "Zurück auf Ihrem Chart oder DOM sollten die Popups aufhören. Sehen Sie nicht sofort eine Änderung, starten Sie die Plattform neu, damit die Einstellung übernommen wird, und prüfen Sie, ob Sie die Änderung in dem Workspace vorgenommen haben, in dem Sie tatsächlich handeln." },
    { type: "heading",text: "Weitere Wege, News aus dem Weg zu halten" },
    { type: "heading",text: "Benachrichtigung ungelesen lassen" },
    { type: "paragraph",html: "Sie möchten die News nicht ganz verlieren? Es gibt eine sanftere Variante. Wenn Sie die Benachrichtigung <em>ungelesen lassen</em>, also die rote Markierung stehen lassen, ohne sie wegzuklicken, drängt sich das Popup nicht von selbst auf den Bildschirm. Sie erhalten weiterhin das Signal, dass etwas eingegangen ist, und lesen es, wenn Sie es möchten, statt dass die Plattform es Ihnen mitten im Trade über die Order-Buttons schiebt. Das ist ein guter Mittelweg, wenn Sie News griffbereit haben, aber die Unterbrechung hassen." },
    { type: "heading",text: "Den gesamten Notification Ticker entfernen" },
    { type: "paragraph",html: "Wenn nicht nur die News stören und Sie den ganzen Streifen zurückgewinnen möchten, gibt es im Bereich Notifications den Schalter <strong class='text-white'>Notification Ticker</strong>. Wenn Sie ihn ausschalten, wird das gesamte Panel mit Uhr und laufenden Benachrichtigungen ausgeblendet, nicht nur die News-Einträge. Das ist die radikalste Option und praktisch, wenn Sie einen reduzierten, ablenkungsfreien Workspace mit maximalem Platz für Chart und Preisleiter wünschen." },
    { type: "heading",text: "In der mobilen App" },
    { type: "paragraph",html: "Die mobile App bietet nicht wie die Desktop- und Web-Plattformen einen vollständigen Ausschalter für interne Benachrichtigungen. Sie können jedoch <strong class='text-white'>eine Meldung nach links wischen</strong>, um sie zu unterdrücken und vom Bildschirm zu entfernen. Beachten Sie, dass diese In-App-Meldungen nicht dasselbe sind wie Push-Benachrichtigungen: Push-Alerts erscheinen außerhalb der App und werden über die Benachrichtigungseinstellungen Ihres Telefons gesteuert." },
    { type: "heading",text: "Tabelle zur Fehlerbehebung" },
    { type: "table", headers: ["Situation","Was passiert","Was zu tun ist"], rows: [
      ["Popup liegt über den DOM-Buttons","Die News-Meldung wird über Ihren Handelsmodulen gerendert","News-Benachrichtigungen unter Application Settings &gt; Preferences &gt; Notifications ausschalten"],
      ["Versehentliche Order beim Wegklicken der News","Der Klick zum Schließen des Fensters landet auf einem Buy/Sell-Button","News-Popups deaktivieren oder das DOM so verschieben, dass nichts unter der Meldung liegt"],
      ["Sie möchten die News, aber ohne Unterbrechung","Das Popup erscheint nur, wenn der Eintrag ungelesen und aktiv ist","Benachrichtigung ungelesen lassen, rote Markierung behalten, Popup überspringen"],
      ["Der gesamte Ticker-/Uhr-Streifen stört","Das Benachrichtigungs-Panel selbst beansprucht Platz auf dem Bildschirm","Notification Ticker ausschalten, um das gesamte Panel auszublenden"],
      ["News ausgeschaltet, aber es erscheint noch immer","Änderung wurde nicht gespeichert oder falsches Profil/Workspace","Erneut speichern, Plattform neu starten, prüfen, ob Sie den aktiven Workspace bearbeitet haben"],
      ["Auf dem Smartphone nicht vollständig deaktivierbar","Die mobile App hat keinen vollständigen Ausschalter für interne Meldungen","Meldung nach links wischen, um sie zu unterdrücken; Push-Alerts in den Telefoneinstellungen verwalten"],
    ] },
    { type: "heading",text: "Hören Sie auf, das DOM zu babysitten, mit PickMyTrade" },
    { type: "paragraph",html: "Das Ausschalten des News-Popups behebt das Overlay, aber hinter der Fehlklick-Geschichte steckt ein tieferes Problem: Sie haben manuell in eine Position geklickt, als die Unterbrechung kam. Immer wenn Ihre Ein- und Ausstiege von einem gut platzierten Klick auf eine Live-Preisleiter abhängen, kann ein Popup, ein Lag-Spike oder ein Vertipper zu einem echten Trade werden. PickMyTrade nimmt Ihnen dieses Risiko ab, indem es die Ausführung selbst automatisiert." },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Alerts gehen direkt an Tradovate</strong>: Ihre TradingView-Signale lösen Orders direkt aus, sodass ein über dem DOM schwebendes News-Fenster keinen Fehlklick verursachen kann, denn Sie klicken nicht ins DOM, um einzusteigen.",
        "<strong class='text-white'>Konsistente, regelbasierte Einstiege</strong>: Jede Order wird auf dem Niveau platziert, das Ihre Strategie vorgibt, nicht dort, wo Ihr Cursor gerade war, als das Popup Sie unterbrach.",
        "<strong class='text-white'>Freihändig bei News</strong>: Sie können sich bei volatilen Veröffentlichungen vom Bildschirm zurückziehen und Ihre Logik Ein- und Ausstiege erledigen lassen, statt in Echtzeit gegen Popups zu kämpfen.",
        "<strong class='text-white'>Multi-Account-Synchronisierung</strong>: Derselbe automatisierte Ablauf läuft gleichzeitig über alle verbundenen Tradovate-Konten, sodass kein einzelnes überladenes Fenster Ihre Ausführung stört.",
      ],
    },
    { type: "paragraph",html: "Räumen Sie die Oberfläche gern auf, aber wenn ein Popup Sie je einen Trade kosten könnte, besteht die eigentliche Antwort darin, nicht mehr über einen Bildschirm zu handeln, den Sie ständig beaufsichtigen müssen." },
  ], es: [
    { type: "paragraph",html: "Está en un scalp en ES, el precio avanza hacia su objetivo y un cuadro de alerta de noticias se desliza justo sobre su DOM. Va a descartarlo, calcula mal el clic por unos píxeles y ahora hay una orden a mercado en marcha que nunca quiso enviar. Si le ha ocurrido, ya sabe que la ventana de noticias no es solo una molestia, cuesta dinero. La solución es sencilla y es un ajuste real, no un truco: Tradovate añadió hace unos años un interruptor para las notificaciones de noticias, de modo que puede desactivarlas en un par de clics y evitar que se coloquen sobre sus botones de órdenes." },
    {
      type: "checklist",
      heading: "Lista de verificación rápida",
      items: [
        "<strong class='text-white'>Solución más rápida</strong>: abra <strong class='text-white'>Application Settings</strong> (arriba a la derecha), vaya a <strong class='text-white'>Preferences</strong>, busque la sección <strong class='text-white'>Notifications</strong> y desactive las notificaciones de noticias.",
        "<strong class='text-white'>Quiere conservar las noticias pero sin ventana emergente</strong>: deje la notificación <em>sin leer</em> (no elimine la bandera roja) y el cuadro no aparecerá por sí solo.",
        "<strong class='text-white'>Quiere eliminar todo el panel</strong>: desactive el <strong class='text-white'>Notification Ticker</strong> para quitar toda la franja que contiene el reloj y las notificaciones.",
        "<strong class='text-white'>En la app móvil</strong> no hay un interruptor completo; deslice una actualización hacia la izquierda para suspenderla.",
        "<strong class='text-white'>¿Siguen apareciendo tras el cambio?</strong> Asegúrese de haber guardado en el perfil y el workspace en el que realmente opera y reinicie la plataforma.",
      ],
    },
    { type: "heading",text: "Por qué la ventana de noticias aparece justo sobre sus botones de órdenes" },
    { type: "paragraph",html: "La alerta de noticias es una notificación flotante, un pequeño panel que se muestra <em>por encima</em> de todo lo demás en el workspace para que usted la advierta. Eso no es problema cuando aparece sobre una esquina vacía de la pantalla. Lo es cuando su DOM, SuperDOM o ticket de órdenes está justo donde aparece el cuadro. La alerta cubre la escalera de precios y los botones Buy/Sell, y el reflejo natural de hacer clic para cerrarla coloca su cursor en plena zona de peligro. Un solo clic mal calculado y habrá ejecutado un contrato que no quería, o cerrado una posición que aún quería mantener." },
    { type: "paragraph",html: "Esto empeora cuanto más compacto es su diseño. Si trabaja con una configuración ajustada de un solo monitor con el DOM en el centro, la ventana emergente no tiene dónde ir <em>salvo</em> sobre su área de trabajo. Y como las noticias son impredecibles, siempre parecen llegar en el peor momento posible, justo cuando está haciendo clic en una posición." },
    { type: "paragraph",html: "La respuesta limpia es evitar por completo que las ventanas aparezcan. Desde una actualización de la plataforma de 2021, Tradovate ofrece un control específico de activación/desactivación para las notificaciones de noticias, de modo que no tiene que elegir entre soportar el overlay y mover su DOM a un lugar incómodo en cada sesión." },
    { type: "heading",text: "Cómo desactivar las notificaciones de noticias en Tradovate" },
    { type: "paragraph",html: "El ajuste está en Application Settings y lleva menos de un minuto. Las etiquetas cambian un poco entre versiones de la plataforma, así que, si un nombre no coincide exactamente, busque el equivalente más cercano en la misma zona." },
    {
      type: "steps",
      items: [
        { title: "Abra Application Settings", html: "Haga clic en el botón <strong class='text-white'>Application Settings</strong> en la esquina superior derecha de la plataforma (el control con forma de engranaje). Es el mismo panel donde gestiona su workspace, las notificaciones y las preferencias de audio." },
        { title: "Vaya a Preferences y localice Notifications", html: "Abra la pestaña <strong class='text-white'>Preferences</strong> y desplácese hasta la sección <strong class='text-white'>Notifications</strong>. Es el centro desde el que se decide qué puede mostrarle la plataforma: alertas de estado de órdenes, el notification ticker, el audio y las notificaciones de noticias que desea desactivar." },
        { title: "Desactive las notificaciones de noticias", html: "En la sección Notifications, busque el interruptor que controla las <strong class='text-white'>notificaciones de noticias</strong> y desactívelo. Guarde si el panel se lo pide. Ese único interruptor evita que el cuadro de noticias aparezca sobre sus módulos de trading; no afecta a sus datos de mercado, a sus órdenes ni a sus alertas de precio." },
      ],
    },
    { type: "paragraph",html: "De vuelta en su gráfico o DOM, las ventanas deberían dejar de aparecer. Si no ve ningún cambio de inmediato, reinicie la plataforma para que el ajuste se aplique y compruebe que realizó el cambio en el workspace en el que realmente opera." },
    { type: "heading",text: "Otras formas de mantener las noticias fuera de su camino" },
    { type: "heading",text: "Deje la notificación sin leer" },
    { type: "paragraph",html: "¿No quiere perder las noticias por completo? Hay una opción más suave. Si <em>deja la notificación sin leer</em>, es decir, deja la bandera roja sin hacer clic para borrarla, el cuadro emergente no se impondrá en la pantalla. Seguirá recibiendo la señal de que ha llegado algo y lo leerá cuando usted decida, en lugar de que la plataforma se lo coloque sobre los botones de órdenes en mitad de un trade. Es un buen punto intermedio si le gusta tener las noticias a mano pero detesta la interrupción." },
    { type: "heading",text: "Elimine todo el Notification Ticker" },
    { type: "paragraph",html: "Si no son solo las noticias lo que le molesta y prefiere recuperar toda la franja, la sección Notifications incluye un interruptor <strong class='text-white'>Notification Ticker</strong>. Al desactivarlo se oculta todo el panel que contiene el reloj y las notificaciones en curso, no solo las noticias. Es la opción más radical y resulta útil cuando desea un espacio de trabajo depurado y sin distracciones, con el máximo sitio para su gráfico y su escalera." },
    { type: "heading",text: "En la app móvil" },
    { type: "paragraph",html: "La app móvil no ofrece un interruptor completo para las notificaciones internas como sí lo hacen las plataformas de escritorio y web. Lo que sí puede hacer es <strong class='text-white'>deslizar una actualización hacia la izquierda</strong> para suspenderla y quitarla de la pantalla. Tenga en cuenta que estas actualizaciones dentro de la app no son lo mismo que las notificaciones push: las alertas push aparecen fuera de la app y se rigen por los ajustes de notificaciones de su propio teléfono." },
    { type: "heading",text: "Tabla de resolución de problemas" },
    { type: "table", headers: ["Situación","Qué ocurre","Qué hacer"], rows: [
      ["La ventana tapa los botones del DOM","La alerta de noticias se muestra por encima de sus módulos de trading","Desactive las notificaciones de noticias en Application Settings &gt; Preferences &gt; Notifications"],
      ["Orden accidental al cerrar la noticia","El clic para cerrar el cuadro cae sobre un botón Buy/Sell","Desactive las ventanas de noticias o mueva el DOM para que no haya nada bajo la alerta"],
      ["Quiere las noticias, pero sin la interrupción","La ventana solo salta cuando el elemento está sin leer y visible","Deje la notificación sin leer, conserve la bandera roja y evite la ventana"],
      ["Toda la franja de ticker/reloj estorba","El propio panel de notificaciones ocupa espacio en pantalla","Desactive el Notification Ticker para ocultar todo el panel"],
      ["Desactivó las noticias pero siguen apareciendo","El cambio no se guardó, o es el perfil/workspace equivocado","Vuelva a guardar, reinicie la plataforma y confirme que editó el workspace activo"],
      ["No se puede desactivar por completo en el móvil","El móvil no tiene un interruptor completo para las actualizaciones internas","Deslice una actualización hacia la izquierda para suspenderla; gestione las alertas push en los ajustes del teléfono"],
    ] },
    { type: "heading",text: "Deje de vigilar el DOM con PickMyTrade" },
    { type: "paragraph",html: "Desactivar la ventana de noticias soluciona el overlay, pero en esa historia del clic erróneo hay un problema más profundo: estaba haciendo clic manualmente en una posición cuando llegó la interrupción. Siempre que sus entradas y salidas dependan de un clic bien colocado en una escalera en vivo, una ventana emergente, un pico de latencia o un dedo torpe pueden convertirse en una operación real. PickMyTrade elimina ese riesgo automatizando la propia ejecución." },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Las alertas van directamente a Tradovate</strong>: sus señales de TradingView disparan las órdenes directamente, por lo que un cuadro de noticias flotando sobre el DOM no puede causar un clic erróneo, porque usted no hace clic en el DOM para entrar.",
        "<strong class='text-white'>Entradas coherentes y basadas en reglas</strong>: cada orden se coloca en el nivel que define su estrategia, no donde estuviera su cursor cuando la ventana lo interrumpió.",
        "<strong class='text-white'>Sin intervención durante las noticias</strong>: puede apartarse de la pantalla durante publicaciones volátiles y dejar que su lógica gestione entradas y salidas, en lugar de pelear con ventanas emergentes en tiempo real.",
        "<strong class='text-white'>Sincronización multicuenta</strong>: el mismo flujo automatizado se ejecuta en todas las cuentas de Tradovate conectadas a la vez, de modo que el desorden de una sola ventana no altera su ejecución.",
      ],
    },
    { type: "paragraph",html: "Limpie la interfaz, por supuesto, pero si una ventana emergente pudiera costarle una operación, la verdadera respuesta es dejar de operar a través de una pantalla que tiene que vigilar constantemente." },
  ], fr: [
    { type: "paragraph",html: "Vous êtes en plein scalp sur ES, le prix file vers votre objectif et une fenêtre d'alerte d'actualités glisse juste au-dessus de votre DOM. Vous tendez la main pour la chasser, manquez le clic de quelques pixels, et voilà un ordre au marché en cours que vous n'aviez jamais voulu envoyer. Si cela vous est arrivé, vous savez que le pop-up d'actualités n'est pas qu'un désagrément : il coûte de l'argent. La solution est simple et il s'agit d'un vrai réglage, pas d'une astuce : Tradovate a ajouté il y a quelques années un commutateur pour les notifications d'actualités, que vous pouvez désactiver en quelques clics pour qu'elles cessent de se poser sur vos boutons d'ordre." },
    {
      type: "checklist",
      heading: "Liste de vérification rapide",
      items: [
        "<strong class='text-white'>Solution la plus rapide</strong> : ouvrez <strong class='text-white'>Application Settings</strong> (en haut à droite), allez dans <strong class='text-white'>Preferences</strong>, trouvez la section <strong class='text-white'>Notifications</strong> et désactivez les notifications d'actualités.",
        "<strong class='text-white'>Garder les actualités sans le pop-up</strong> : laissez la notification <em>non lue</em> (n'effacez pas le drapeau rouge) et la fenêtre n'apparaîtra pas d'elle-même.",
        "<strong class='text-white'>Supprimer tout le panneau</strong> : désactivez le <strong class='text-white'>Notification Ticker</strong> pour retirer toute la bande qui contient l'horloge et les notifications.",
        "<strong class='text-white'>Sur l'application mobile</strong>, il n'existe pas de commutateur complet ; faites glisser une mise à jour vers la gauche pour la suspendre.",
        "<strong class='text-white'>Toujours des pop-ups après la modification ?</strong> Assurez-vous d'avoir enregistré sur le profil et le workspace dans lesquels vous tradez réellement, puis redémarrez la plateforme.",
      ],
    },
    { type: "heading",text: "Pourquoi le pop-up d'actualités atterrit juste sur vos boutons d'ordre" },
    { type: "paragraph",html: "L'alerte d'actualités est une notification flottante, un petit panneau affiché <em>au-dessus</em> de tout le reste de l'espace de travail pour que vous la remarquiez. Ce n'est pas gênant quand elle apparaît sur un coin vide de l'écran. Cela le devient quand votre DOM, votre SuperDOM ou votre ticket d'ordre se trouve précisément là où la fenêtre s'affiche. L'alerte recouvre l'échelle de prix et les boutons Buy/Sell, et le réflexe naturel, cliquer pour la fermer, place votre curseur en pleine zone de danger. Un seul clic manqué et vous avez exécuté un contrat que vous ne vouliez pas, ou clôturé une position que vous comptiez encore garder." },
    { type: "paragraph",html: "C'est d'autant plus problématique que votre disposition est compacte. Si vous travaillez avec une configuration serrée sur un seul écran, avec le DOM au centre, le pop-up n'a <em>nulle part</em> où aller sauf sur votre zone de travail. Et comme les actualités sont imprévisibles, elles semblent toujours arriver au pire moment, juste quand vous cliquez dans une position." },
    { type: "paragraph",html: "La réponse la plus propre consiste à empêcher complètement l'apparition des pop-ups. Depuis une mise à jour de la plateforme de 2021, Tradovate propose un commutateur dédié pour les notifications d'actualités ; vous n'avez donc plus à choisir entre subir la fenêtre superposée et déplacer votre DOM à un endroit peu pratique à chaque session." },
    { type: "heading",text: "Comment désactiver les notifications d'actualités dans Tradovate" },
    { type: "paragraph",html: "Ce réglage se trouve dans Application Settings et prend moins d'une minute. Les libellés varient un peu d'une version de la plateforme à l'autre ; si un nom ne correspond pas exactement, cherchez l'équivalent le plus proche dans la même zone." },
    {
      type: "steps",
      items: [
        { title: "Ouvrez Application Settings", html: "Cliquez sur le bouton <strong class='text-white'>Application Settings</strong> dans le coin supérieur droit de la plateforme (le contrôle en forme d'engrenage). C'est le panneau où vous gérez votre workspace, vos notifications et vos préférences audio." },
        { title: "Allez dans Preferences et trouvez Notifications", html: "Ouvrez l'onglet <strong class='text-white'>Preferences</strong>, puis faites défiler jusqu'à la section <strong class='text-white'>Notifications</strong>. C'est le centre qui définit ce que la plateforme peut vous afficher : alertes d'état d'ordre, bandeau de notifications, audio et les notifications d'actualités que vous souhaitez désactiver." },
        { title: "Désactivez les notifications d'actualités", html: "Dans la section Notifications, repérez le commutateur qui contrôle les <strong class='text-white'>notifications d'actualités</strong> et désactivez-le. Enregistrez si le panneau vous le demande. Ce seul commutateur empêche la fenêtre d'actualités d'apparaître au-dessus de vos modules de trading ; il n'affecte ni vos données de marché, ni vos ordres, ni vos alertes de prix." },
      ],
    },
    { type: "paragraph",html: "De retour sur votre graphique ou votre DOM, les pop-ups devraient cesser. Si vous ne voyez aucun changement immédiat, redémarrez la plateforme pour que le réglage soit pris en compte et vérifiez que vous avez modifié le workspace dans lequel vous tradez réellement." },
    { type: "heading",text: "Autres moyens de tenir les actualités à l'écart" },
    { type: "heading",text: "Laissez la notification non lue" },
    { type: "paragraph",html: "Vous ne voulez pas perdre complètement les actualités ? Il existe une approche plus douce. Si vous <em>laissez la notification non lue</em>, c'est-à-dire que vous laissez le drapeau rouge en place sans cliquer pour l'effacer, la fenêtre ne s'imposera pas à l'écran. Vous recevez toujours le signal qu'une information est arrivée et la lisez quand vous le décidez, au lieu que la plateforme vous l'impose sur vos boutons d'ordre en plein trade. C'est un bon compromis si vous aimez avoir les actualités à portée de main mais détestez l'interruption." },
    { type: "heading",text: "Supprimez tout le Notification Ticker" },
    { type: "paragraph",html: "Si ce ne sont pas seulement les actualités qui vous gênent et que vous préférez récupérer toute la bande, la section Notifications comporte un commutateur <strong class='text-white'>Notification Ticker</strong>. Le désactiver masque l'ensemble du panneau qui contient l'horloge et les notifications en cours, pas seulement les actualités. C'est l'option la plus radicale, pratique lorsque vous voulez un espace de travail épuré, sans distraction, avec un maximum de place pour votre graphique et votre échelle." },
    { type: "heading",text: "Sur l'application mobile" },
    { type: "paragraph",html: "L'application mobile ne propose pas de commutateur complet pour les notifications internes, contrairement aux plateformes de bureau et web. Vous pouvez en revanche <strong class='text-white'>faire glisser une mise à jour vers la gauche</strong> pour la suspendre et l'enlever de l'écran. Gardez à l'esprit que ces mises à jour intégrées à l'application ne sont pas des notifications push : les alertes push s'affichent en dehors de l'application et dépendent des réglages de notification de votre téléphone." },
    { type: "heading",text: "Tableau de dépannage" },
    { type: "table", headers: ["Situation","Ce qui se passe","Que faire"], rows: [
      ["Le pop-up recouvre les boutons du DOM","L'alerte d'actualités s'affiche au-dessus de vos modules de trading","Désactivez les notifications d'actualités dans Application Settings &gt; Preferences &gt; Notifications"],
      ["Ordre accidentel en fermant l'actualité","Le clic pour fermer la fenêtre tombe sur un bouton Buy/Sell","Désactivez les pop-ups d'actualités ou déplacez le DOM pour que rien ne se trouve sous l'alerte"],
      ["Vous voulez les actualités, mais sans l'interruption","Le pop-up ne se déclenche que lorsque l'élément est non lu et affiché","Laissez la notification non lue, gardez le drapeau rouge, évitez le pop-up"],
      ["Toute la bande ticker/horloge gêne","Le panneau de notifications lui-même occupe de la place à l'écran","Désactivez le Notification Ticker pour masquer tout le panneau"],
      ["Actualités désactivées mais le pop-up s'affiche encore","La modification n'a pas été enregistrée, ou mauvais profil/workspace","Enregistrez de nouveau, redémarrez la plateforme, vérifiez que vous avez modifié le workspace actif"],
      ["Impossible de tout désactiver sur le téléphone","Le mobile n'a pas de commutateur complet pour les mises à jour internes","Faites glisser une mise à jour vers la gauche pour la suspendre ; gérez les alertes push dans les réglages du téléphone"],
    ] },
    { type: "heading",text: "Cessez de surveiller le DOM avec PickMyTrade" },
    { type: "paragraph",html: "Désactiver le pop-up d'actualités règle le problème de superposition, mais cette histoire de faux clic cache un problème plus profond : vous cliquiez manuellement dans une position quand l'interruption est survenue. Dès que vos entrées et sorties dépendent d'un clic bien placé sur une échelle en direct, un pop-up, un pic de latence ou un doigt maladroit peut devenir un vrai trade. PickMyTrade élimine ce risque en automatisant l'exécution elle-même." },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Les alertes vont directement vers Tradovate</strong> : vos signaux TradingView déclenchent les ordres directement, de sorte qu'une fenêtre d'actualités flottant au-dessus du DOM ne peut pas causer de faux clic, puisque vous ne cliquez pas sur le DOM pour entrer.",
        "<strong class='text-white'>Entrées cohérentes et fondées sur des règles</strong> : chaque ordre est placé au niveau défini par votre stratégie, et non là où se trouvait votre curseur quand le pop-up vous a interrompu.",
        "<strong class='text-white'>Les mains libres pendant les actualités</strong> : vous pouvez vous éloigner de l'écran lors des publications volatiles et laisser votre logique gérer entrées et sorties, au lieu de lutter contre des pop-ups en temps réel.",
        "<strong class='text-white'>Synchronisation multi-comptes</strong> : le même flux automatisé s'exécute sur tous les comptes Tradovate connectés en même temps, de sorte que l'encombrement d'une seule fenêtre ne perturbe pas votre exécution.",
      ],
    },
    { type: "paragraph",html: "Épurez l'interface, bien sûr, mais si un pop-up peut un jour vous coûter un trade, la vraie réponse est d'arrêter de trader via un écran que vous devez surveiller sans relâche." },
  ], it: [
    { type: "paragraph",html: "È in uno scalp su ES, il prezzo corre verso il suo target e una finestra di avviso delle notizie scorre proprio sopra il suo DOM. Allunga la mano per scacciarla, sbaglia il clic di qualche pixel e ora c'è un ordine a mercato in corso che non voleva mai inviare. Se le è capitato, sa già che il popup delle notizie non è solo un fastidio: costa denaro. La soluzione è semplice ed è un'impostazione vera, non un trucco: Tradovate ha aggiunto alcuni anni fa un interruttore per le notifiche delle notizie, così può disattivarle in un paio di clic e impedire che si piazzino sopra i suoi pulsanti d'ordine." },
    {
      type: "checklist",
      heading: "Checklist rapida",
      items: [
        "<strong class='text-white'>Soluzione più veloce</strong>: apra <strong class='text-white'>Application Settings</strong> (in alto a destra), vada su <strong class='text-white'>Preferences</strong>, trovi la sezione <strong class='text-white'>Notifications</strong> e disattivi le notifiche delle notizie.",
        "<strong class='text-white'>Vuole tenere le notizie ma eliminare il popup</strong>: lasci la notifica <em>non letta</em> (non cancelli la bandierina rossa) e la finestra non comparirà da sola.",
        "<strong class='text-white'>Vuole eliminare l'intero pannello</strong>: disattivi il <strong class='text-white'>Notification Ticker</strong> per rimuovere l'intera striscia che contiene l'orologio e le notifiche.",
        "<strong class='text-white'>Nell'app mobile</strong> non esiste un interruttore completo; scorra un aggiornamento verso sinistra per sospenderlo.",
        "<strong class='text-white'>Compaiono ancora dopo la modifica?</strong> Si assicuri di aver salvato sul profilo e sul workspace in cui opera effettivamente, poi riavvii la piattaforma.",
      ],
    },
    { type: "heading",text: "Perché il popup delle notizie finisce proprio sui suoi pulsanti d'ordine" },
    { type: "paragraph",html: "L'avviso delle notizie è una notifica flottante, un piccolo pannello che viene visualizzato <em>sopra</em> tutto il resto nel workspace affinché lei lo noti. Va bene quando compare su un angolo vuoto dello schermo. Diventa un problema quando il suo DOM, SuperDOM o ticket d'ordine si trova esattamente dove compare la finestra. L'avviso copre la scala dei prezzi e i pulsanti Buy/Sell, e il riflesso naturale di cliccare per chiuderlo porta il cursore proprio nella zona di pericolo. Un solo clic sbagliato e ha eseguito un contratto che non voleva, o chiuso una posizione che intendeva ancora mantenere." },
    { type: "paragraph",html: "La situazione peggiora quanto più è compatto il suo layout. Se usa una configurazione stretta con un solo monitor e il DOM al centro, il popup non ha <em>altro posto</em> dove andare se non sopra la sua area di lavoro. E poiché le notizie sono imprevedibili, sembrano sempre arrivare nel momento peggiore, proprio mentre sta cliccando su una posizione." },
    { type: "paragraph",html: "La risposta pulita è impedire del tutto la comparsa dei popup. Da un aggiornamento della piattaforma del 2021, Tradovate offre un controllo on/off dedicato per le notifiche delle notizie, così non deve scegliere tra sopportare la sovrapposizione e spostare il DOM in un punto scomodo a ogni sessione." },
    { type: "heading",text: "Come disattivare le notifiche delle notizie in Tradovate" },
    { type: "paragraph",html: "L'impostazione si trova in Application Settings e richiede meno di un minuto. Le etichette cambiano leggermente tra le versioni della piattaforma, quindi, se un nome non corrisponde esattamente, cerchi l'equivalente più vicino nella stessa area." },
    {
      type: "steps",
      items: [
        { title: "Apra Application Settings", html: "Clicchi sul pulsante <strong class='text-white'>Application Settings</strong> nell'angolo in alto a destra della piattaforma (il controllo a forma di ingranaggio). È lo stesso pannello in cui gestisce il workspace, le notifiche e le preferenze audio." },
        { title: "Vada su Preferences e trovi Notifications", html: "Apra la scheda <strong class='text-white'>Preferences</strong>, poi scorra fino alla sezione <strong class='text-white'>Notifications</strong>. È il punto centrale che stabilisce cosa la piattaforma può mostrarle: alert di stato degli ordini, il ticker delle notifiche, l'audio e le notifiche delle notizie che intende disattivare." },
        { title: "Disattivi le notifiche delle notizie", html: "Nella sezione Notifications, trovi l'interruttore che controlla le <strong class='text-white'>notifiche delle notizie</strong> e lo disattivi. Salvi se il pannello lo richiede. Questo singolo interruttore impedisce alla finestra delle notizie di comparire sopra i suoi moduli di trading; non influisce sui dati di mercato, sugli ordini né sugli alert di prezzo." },
      ],
    },
    { type: "paragraph",html: "Tornando al grafico o al DOM, i popup dovrebbero cessare. Se non nota alcuna modifica subito, riavvii la piattaforma affinché l'impostazione abbia effetto e controlli di aver modificato il workspace in cui opera effettivamente." },
    { type: "heading",text: "Altri modi per tenere le notizie fuori dai piedi" },
    { type: "heading",text: "Lasci la notifica non letta" },
    { type: "paragraph",html: "Non vuole perdere del tutto le notizie? C'è un approccio più leggero. Se <em>lascia la notifica non letta</em>, cioè lascia la bandierina rossa senza cliccare per cancellarla, la finestra non si imporrà sullo schermo. Riceve comunque il segnale che è arrivato qualcosa e lo legge quando decide lei, invece di vedersi la piattaforma sbattere la notizia sopra i pulsanti d'ordine nel mezzo di un trade. È un buon compromesso se le piace avere le notizie a portata di mano ma detesta l'interruzione." },
    { type: "heading",text: "Rimuova l'intero Notification Ticker" },
    { type: "paragraph",html: "Se non sono solo le notizie a darle fastidio e preferisce recuperare l'intera striscia, la sezione Notifications ha un interruttore <strong class='text-white'>Notification Ticker</strong>. Disattivandolo si nasconde l'intero pannello che contiene l'orologio e le notifiche in corso, non solo le notizie. È l'opzione più drastica ed è utile quando desidera un workspace essenziale, senza distrazioni, con il massimo spazio per grafico e scala." },
    { type: "heading",text: "Nell'app mobile" },
    { type: "paragraph",html: "L'app mobile non offre un interruttore completo per le notifiche interne come le piattaforme desktop e web. Quello che può fare è <strong class='text-white'>scorrere un aggiornamento verso sinistra</strong> per sospenderlo e toglierlo dallo schermo. Tenga presente che questi aggiornamenti interni all'app non sono la stessa cosa delle notifiche push: gli alert push compaiono fuori dall'app e sono regolati dalle impostazioni di notifica del telefono." },
    { type: "heading",text: "Tabella di risoluzione dei problemi" },
    { type: "table", headers: ["Situazione","Cosa sta succedendo","Cosa fare"], rows: [
      ["Il popup finisce sopra i pulsanti del DOM","L'avviso delle notizie viene visualizzato sopra i suoi moduli di trading","Disattivi le notifiche delle notizie in Application Settings &gt; Preferences &gt; Notifications"],
      ["Ordine accidentale mentre chiude la notizia","Il clic per chiudere la finestra finisce su un pulsante Buy/Sell","Disattivi i popup delle notizie o sposti il DOM in modo che nulla si trovi sotto l'avviso"],
      ["Vuole le notizie, ma senza l'interruzione","Il popup scatta solo quando l'elemento è non letto e in evidenza","Lasci la notifica non letta, mantenga la bandierina rossa, salti il popup"],
      ["L'intera striscia ticker/orologio è d'intralcio","Il pannello delle notifiche occupa spazio sullo schermo","Disattivi il Notification Ticker per nascondere l'intero pannello"],
      ["Notizie disattivate ma il popup compare ancora","La modifica non è stata salvata, oppure profilo/workspace sbagliato","Salvi di nuovo, riavvii la piattaforma, verifichi di aver modificato il workspace attivo"],
      ["Impossibile disattivare del tutto sul telefono","Il mobile non ha un interruttore completo per gli aggiornamenti interni","Scorra un aggiornamento verso sinistra per sospenderlo; gestisca gli alert push dalle impostazioni del telefono"],
    ] },
    { type: "heading",text: "Smetta di sorvegliare il DOM con PickMyTrade" },
    { type: "paragraph",html: "Disattivare il popup delle notizie risolve la sovrapposizione, ma nella storia del clic sbagliato si nasconde un problema più profondo: stava cliccando manualmente su una posizione quando è arrivata l'interruzione. Ogni volta che i suoi ingressi e le sue uscite dipendono da un clic ben piazzato su una scala in tempo reale, un popup, un picco di latenza o un dito maldestro possono trasformarsi in un vero trade. PickMyTrade elimina questo rischio automatizzando l'esecuzione stessa." },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Gli alert vanno direttamente a Tradovate</strong>: i suoi segnali di TradingView inviano gli ordini direttamente, quindi una finestra di notizie sopra il DOM non può causare un clic sbagliato, perché non clicca sul DOM per entrare.",
        "<strong class='text-white'>Ingressi coerenti e basati su regole</strong>: ogni ordine viene inserito al livello definito dalla sua strategia, non dove si trovava il cursore quando il popup l'ha interrotta.",
        "<strong class='text-white'>Mani libere durante le notizie</strong>: può allontanarsi dallo schermo durante le pubblicazioni volatili e lasciare che sia la sua logica a gestire ingressi e uscite, invece di combattere con i popup in tempo reale.",
        "<strong class='text-white'>Sincronizzazione multi-account</strong>: lo stesso flusso automatizzato gira contemporaneamente su tutti gli account Tradovate collegati, così il disordine di una singola finestra non altera la sua esecuzione.",
      ],
    },
    { type: "paragraph",html: "Pulisca pure l'interfaccia, ma se un popup potesse mai costarle un trade, la vera risposta è smettere di operare attraverso uno schermo che deve sorvegliare continuamente." },
  ] },
  ctaHeading: { en: "Trade Without Watching Every Click", de: "Handeln Sie, ohne jeden Klick zu überwachen", es: "Opere sin vigilar cada clic", fr: "Tradez sans surveiller chaque clic", it: "Operi senza controllare ogni clic" },
  ctaText: { en: "PickMyTrade routes your TradingView alerts straight into Tradovate, so a news popup floating over the DOM can never cause a misclick again.", de: "PickMyTrade leitet Ihre TradingView-Alerts direkt an Tradovate weiter, sodass ein über dem DOM schwebendes News-Popup nie wieder zu einem Fehlklick führen kann.", es: "PickMyTrade envía sus alertas de TradingView directamente a Tradovate, de modo que una ventana de noticias flotando sobre el DOM nunca más pueda provocar un clic erróneo.", fr: "PickMyTrade achemine vos alertes TradingView directement vers Tradovate : un pop-up d'actualités flottant au-dessus du DOM ne pourra donc plus jamais provoquer de faux clic.", it: "PickMyTrade instrada i suoi alert di TradingView direttamente su Tradovate, così un popup di notizie sopra il DOM non potrà più causare un clic sbagliato." },
  ctaButtonText: { en: "Start Your Free 7-Day Trial", de: "Starten Sie Ihre kostenlose 7-Tage-Testphase", es: "Comience su prueba gratuita de 7 días", fr: "Commencez votre essai gratuit de 7 jours", it: "Inizi la prova gratuita di 7 giorni" },
  ctaUrl: "https://app.pickmytrade.trade/?register=true&utm_source=content&utm_medium=debugging",
  faqHeading: { en: "Frequently Asked Questions", de: "Häufig gestellte Fragen", es: "Preguntas frecuentes", fr: "Questions fréquentes", it: "Domande frequenti" },
  faqs: { en: [
    { q: "How do I stop Tradovate news popups from covering my trading buttons?", a: "Turn off news notifications. Open Application Settings (top right), go to the Preferences tab, scroll to the Notifications section, and switch news notifications off. Tradovate added this on/off control in a 2021 platform release, so it's a built-in setting rather than a workaround." },
    { q: "Why does the news alert box appear right over my DOM?", a: "The news alert is a floating notification panel that renders on top of the trading interface. If your DOM or order ticket is positioned underneath where the box pops up, a click meant to dismiss the news can land on a Buy or Sell button and send an order you didn't intend." },
    { q: "Can I keep the news feed but stop the popup?", a: "Yes. Leave the news notification unread, don't clear the red flag, and the popup box won't force itself onto the screen. You still see that news is available and can open it on your own terms, without the alert parking itself over your order buttons mid-trade." },
    { q: "How do I remove the whole notification ticker and clock panel?", a: "In the same Notifications section of Application Settings, toggle off the Notification Ticker. That hides the entire panel that carries the clock and the notification items, not just the news popups, which frees up screen space around your trading modules." },
    { q: "Can I turn off news notifications on the Tradovate mobile app?", a: "Not completely on mobile. You can suspend an internal update by swiping left on it until it's removed from the screen. These in-app updates are different from push notifications, which are controlled through your phone's system settings." },
    { q: "I turned news notifications off but popups still show, what now?", a: "Confirm the change saved on the profile and workspace you're actually trading in, then restart the platform so the setting takes effect. Also check you're not confusing news popups with price alerts or order-status notifications, which have their own separate toggles." },
    { q: "Does disabling news notifications affect my orders or market data?", a: "No. The news toggle only controls whether news items pop up in the platform. Your market data feed, order routing, fills, and price or order-status alerts all keep working exactly as before." },
  ], de: [
    { q: "Wie verhindere ich, dass Tradovate-News-Popups meine Handelsbuttons verdecken?", a: "Schalten Sie die News-Benachrichtigungen aus. Öffnen Sie die Application Settings (oben rechts), wechseln Sie zum Tab Preferences, scrollen Sie zum Bereich Notifications und deaktivieren Sie die News-Benachrichtigungen. Tradovate hat diesen Ein/Aus-Schalter in einem Plattform-Release von 2021 ergänzt; es handelt sich also um eine integrierte Einstellung und nicht um einen Workaround." },
    { q: "Warum erscheint das News-Fenster direkt über meinem DOM?", a: "Die News-Meldung ist ein schwebendes Benachrichtigungsfenster, das über der Handelsoberfläche gerendert wird. Liegt Ihr DOM oder Ihr Order-Ticket genau unter der Stelle, an der das Fenster erscheint, kann ein Klick zum Wegklicken der Nachricht auf einem Buy- oder Sell-Button landen und eine ungewollte Order senden." },
    { q: "Kann ich den News-Feed behalten, aber das Popup unterdrücken?", a: "Ja. Lassen Sie die News-Benachrichtigung ungelesen, löschen Sie die rote Markierung nicht, und das Popup drängt sich nicht von selbst auf den Bildschirm. Sie sehen weiterhin, dass eine Nachricht verfügbar ist, und können sie öffnen, wann es Ihnen passt, ohne dass die Meldung mitten im Trade über Ihren Order-Buttons hängt." },
    { q: "Wie entferne ich das gesamte Benachrichtigungs-Ticker- und Uhr-Panel?", a: "Deaktivieren Sie im selben Bereich Notifications der Application Settings den Notification Ticker. Dadurch wird das gesamte Panel mit Uhr und Benachrichtigungen ausgeblendet, nicht nur die News-Popups, und es entsteht mehr Platz rund um Ihre Handelsmodule." },
    { q: "Kann ich die News-Benachrichtigungen in der mobilen Tradovate-App ausschalten?", a: "Auf dem Smartphone nicht vollständig. Sie können eine interne Meldung unterdrücken, indem Sie sie nach links wischen, bis sie vom Bildschirm verschwindet. Diese In-App-Meldungen unterscheiden sich von Push-Benachrichtigungen, die über die Systemeinstellungen Ihres Telefons gesteuert werden." },
    { q: "Ich habe die News-Benachrichtigungen ausgeschaltet, aber die Popups erscheinen weiterhin. Was nun?", a: "Prüfen Sie, ob die Änderung in dem Profil und Workspace gespeichert wurde, in dem Sie tatsächlich handeln, und starten Sie die Plattform neu, damit die Einstellung greift. Achten Sie außerdem darauf, News-Popups nicht mit Preis-Alerts oder Order-Status-Benachrichtigungen zu verwechseln, die jeweils eigene Schalter haben." },
    { q: "Beeinflusst das Deaktivieren der News-Benachrichtigungen meine Orders oder Marktdaten?", a: "Nein. Der News-Schalter steuert lediglich, ob News-Meldungen in der Plattform aufpoppen. Ihr Marktdaten-Feed, das Order-Routing, Ausführungen sowie Preis- und Order-Status-Alerts funktionieren unverändert weiter." },
  ], es: [
    { q: "¿Cómo evito que las ventanas emergentes de noticias de Tradovate tapen mis botones de trading?", a: "Desactive las notificaciones de noticias. Abra Application Settings (arriba a la derecha), vaya a la pestaña Preferences, desplácese hasta la sección Notifications y desactive las notificaciones de noticias. Tradovate añadió este control de activación/desactivación en una versión de la plataforma de 2021, por lo que es un ajuste integrado y no una solución alternativa." },
    { q: "¿Por qué el cuadro de alerta de noticias aparece justo sobre mi DOM?", a: "La alerta de noticias es un panel de notificación flotante que se muestra por encima de la interfaz de trading. Si su DOM o su ticket de órdenes está justo debajo del lugar donde aparece el cuadro, un clic destinado a cerrar la noticia puede caer sobre un botón Buy o Sell y enviar una orden que no pretendía." },
    { q: "¿Puedo mantener el feed de noticias pero evitar la ventana emergente?", a: "Sí. Deje la notificación de noticias sin leer, no elimine la bandera roja y el cuadro emergente no se impondrá en la pantalla. Seguirá viendo que hay una noticia disponible y podrá abrirla cuando quiera, sin que la alerta se quede encima de sus botones de órdenes en mitad de un trade." },
    { q: "¿Cómo elimino todo el panel del ticker de notificaciones y el reloj?", a: "En la misma sección Notifications de Application Settings, desactive el Notification Ticker. Eso oculta todo el panel que contiene el reloj y los elementos de notificación, no solo las ventanas de noticias, y libera espacio alrededor de sus módulos de trading." },
    { q: "¿Puedo desactivar las notificaciones de noticias en la app móvil de Tradovate?", a: "No por completo en el móvil. Puede suspender una actualización interna deslizándola hacia la izquierda hasta que desaparezca de la pantalla. Estas actualizaciones dentro de la app son distintas de las notificaciones push, que se controlan desde los ajustes del sistema de su teléfono." },
    { q: "Desactivé las notificaciones de noticias pero las ventanas siguen apareciendo, ¿qué hago?", a: "Confirme que el cambio se guardó en el perfil y el workspace en el que realmente opera y reinicie la plataforma para que el ajuste surta efecto. Compruebe también que no está confundiendo las ventanas de noticias con las alertas de precio o las notificaciones de estado de órdenes, que tienen sus propios interruptores independientes." },
    { q: "¿Desactivar las notificaciones de noticias afecta a mis órdenes o a los datos de mercado?", a: "No. El interruptor de noticias solo controla si las noticias aparecen como ventana emergente en la plataforma. Su feed de datos de mercado, el enrutamiento de órdenes, las ejecuciones y las alertas de precio o de estado de órdenes siguen funcionando exactamente igual." },
  ], fr: [
    { q: "Comment empêcher les pop-ups d'actualités de Tradovate de masquer mes boutons de trading ?", a: "Désactivez les notifications d'actualités. Ouvrez Application Settings (en haut à droite), allez dans l'onglet Preferences, faites défiler jusqu'à la section Notifications et désactivez les notifications d'actualités. Tradovate a ajouté ce commutateur dans une version de la plateforme de 2021 ; il s'agit donc d'un réglage intégré et non d'une solution de contournement." },
    { q: "Pourquoi la fenêtre d'alerte d'actualités apparaît-elle juste au-dessus de mon DOM ?", a: "L'alerte d'actualités est un panneau de notification flottant affiché par-dessus l'interface de trading. Si votre DOM ou votre ticket d'ordre se trouve sous l'endroit où la fenêtre apparaît, un clic destiné à fermer l'actualité peut tomber sur un bouton Buy ou Sell et envoyer un ordre non voulu." },
    { q: "Puis-je garder le flux d'actualités tout en supprimant le pop-up ?", a: "Oui. Laissez la notification d'actualités non lue, n'effacez pas le drapeau rouge, et la fenêtre ne s'imposera pas à l'écran. Vous voyez toujours qu'une actualité est disponible et pouvez l'ouvrir quand vous le souhaitez, sans que l'alerte ne s'installe au-dessus de vos boutons d'ordre en plein trade." },
    { q: "Comment supprimer tout le panneau du bandeau de notifications et de l'horloge ?", a: "Dans la même section Notifications des Application Settings, désactivez le Notification Ticker. Cela masque l'ensemble du panneau contenant l'horloge et les notifications, et pas seulement les pop-ups d'actualités, ce qui libère de l'espace autour de vos modules de trading." },
    { q: "Puis-je désactiver les notifications d'actualités sur l'application mobile Tradovate ?", a: "Pas complètement sur mobile. Vous pouvez suspendre une mise à jour interne en la faisant glisser vers la gauche jusqu'à ce qu'elle disparaisse de l'écran. Ces mises à jour intégrées à l'application sont différentes des notifications push, qui se gèrent dans les réglages système de votre téléphone." },
    { q: "J'ai désactivé les notifications d'actualités mais les pop-ups s'affichent toujours, que faire ?", a: "Vérifiez que la modification a bien été enregistrée sur le profil et le workspace dans lesquels vous tradez réellement, puis redémarrez la plateforme pour que le réglage prenne effet. Vérifiez aussi que vous ne confondez pas les pop-ups d'actualités avec les alertes de prix ou les notifications d'état d'ordre, qui ont leurs propres commutateurs." },
    { q: "La désactivation des notifications d'actualités affecte-t-elle mes ordres ou mes données de marché ?", a: "Non. Le commutateur d'actualités contrôle uniquement l'affichage des actualités en pop-up dans la plateforme. Votre flux de données de marché, l'acheminement des ordres, les exécutions et les alertes de prix ou d'état d'ordre continuent de fonctionner exactement comme avant." },
  ], it: [
    { q: "Come impedisco ai popup delle notizie di Tradovate di coprire i miei pulsanti di trading?", a: "Disattivi le notifiche delle notizie. Apra Application Settings (in alto a destra), vada alla scheda Preferences, scorra fino alla sezione Notifications e disattivi le notifiche delle notizie. Tradovate ha aggiunto questo controllo on/off in una release della piattaforma del 2021, quindi si tratta di un'impostazione integrata e non di un ripiego." },
    { q: "Perché la finestra di avviso delle notizie compare proprio sopra il mio DOM?", a: "L'avviso delle notizie è un pannello di notifica flottante che viene visualizzato sopra l'interfaccia di trading. Se il suo DOM o il ticket d'ordine si trova sotto il punto in cui compare la finestra, un clic destinato a chiudere la notizia può finire su un pulsante Buy o Sell e inviare un ordine non voluto." },
    { q: "Posso mantenere il feed delle notizie ma eliminare il popup?", a: "Sì. Lasci la notifica delle notizie non letta, non cancelli la bandierina rossa e la finestra non si imporrà sullo schermo. Vedrà comunque che è disponibile una notizia e potrà aprirla quando vuole, senza che l'avviso si piazzi sopra i suoi pulsanti d'ordine nel mezzo di un trade." },
    { q: "Come rimuovo l'intero pannello del ticker di notifiche e dell'orologio?", a: "Nella stessa sezione Notifications di Application Settings, disattivi il Notification Ticker. Questo nasconde l'intero pannello che contiene l'orologio e le notifiche, non solo i popup delle notizie, liberando spazio intorno ai suoi moduli di trading." },
    { q: "Posso disattivare le notifiche delle notizie nell'app mobile di Tradovate?", a: "Non completamente su mobile. Può sospendere un aggiornamento interno scorrendolo verso sinistra finché non scompare dallo schermo. Questi aggiornamenti interni all'app sono diversi dalle notifiche push, che vengono gestite dalle impostazioni di sistema del telefono." },
    { q: "Ho disattivato le notifiche delle notizie ma i popup compaiono ancora, cosa faccio?", a: "Verifichi che la modifica sia stata salvata sul profilo e sul workspace in cui sta effettivamente operando, poi riavvii la piattaforma affinché l'impostazione abbia effetto. Controlli inoltre di non confondere i popup delle notizie con gli alert di prezzo o le notifiche di stato degli ordini, che hanno interruttori separati." },
    { q: "La disattivazione delle notifiche delle notizie influisce sui miei ordini o sui dati di mercato?", a: "No. L'interruttore delle notizie controlla soltanto se le notizie compaiono come popup nella piattaforma. Il feed dei dati di mercato, l'instradamento degli ordini, le esecuzioni e gli alert di prezzo o di stato degli ordini continuano a funzionare esattamente come prima." },
  ] },
