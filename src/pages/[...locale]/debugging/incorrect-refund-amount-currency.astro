---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "incorrect-refund-amount-currency";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/debugging/${SLUG}`;

const META_TITLE = "Tradovate Refund Wrong Amount / Wrong Currency";
const META_DESCRIPTION =
  "Refund landed in the wrong amount or currency and support went quiet? Document it, escalate to a supervisor, and get your money corrected step by step.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Tradovate-Rückerstattung: falscher Betrag / falsche Währung", es: "Tradovate: reembolso con importe o divisa incorrectos", fr: "Tradovate : remboursement avec montant ou devise incorrects", it: "Tradovate: rimborso con importo o valuta errati" },
  dek: { en: "Your refund arrived short, or in the wrong currency, and support keeps starting from zero. Here's how to document the gap and escalate it to the team that can actually fix it.", de: "Ihre Rückerstattung kam zu niedrig oder in der falschen Währung an, und der Support fängt immer wieder bei null an. So dokumentieren Sie die Differenz und eskalieren sie an das Team, das sie tatsächlich beheben kann.", es: "Su reembolso llegó incompleto o en la divisa equivocada, y el soporte sigue empezando de cero. Así puede documentar la diferencia y escalarla al equipo que realmente puede corregirla.", fr: "Votre remboursement est arrivé incomplet, ou dans la mauvaise devise, et le support recommence sans cesse à zéro. Voici comment documenter l'écart et l'escalader vers l'équipe qui peut réellement le corriger.", it: "Il vostro rimborso è arrivato incompleto, o nella valuta sbagliata, e l'assistenza continua a ripartire da zero. Ecco come documentare la discrepanza ed escalarla al team che può davvero risolverla." },
  readTime: { en: "8 min read", de: "8 Minuten Lesezeit", es: "Lectura de 8 minutos", fr: "Lecture de 8 minutes", it: "Lettura di 8 minuti" },
  lastUpdated: "2026-07-10",
  blocks: { en: [
    { type: "paragraph", html: "You asked for one number in dollars, and something smaller landed, sometimes in a completely different currency. Then the replies dried up. One rep answered a single question, marked it solved, and moved on, and the next started from zero as if you'd never written. It's infuriating when it's your money on the line, but this is a solvable billing problem, not a lost cause. The way out is the same one that works with any financial institution when the front line stalls: stop repeating yourself to different people, pin down exactly what's wrong with hard documentation, and push the case up to a supervisor and the team that controls the funds. Here's how, from confirming whether you're actually owed a correction to escalating until it's paid." },
    {
      type: "checklist",
      heading: "Quick Answer: What to Do Right Now",
      items: [
        "<strong class='text-white'>Don't open five new tickets.</strong> Keep everything on one thread so nobody treats your follow-up as a fresh, unrelated question.",
        "<strong class='text-white'>Screenshot the proof.</strong> The amount requested, the amount and currency that arrived, the dates, and every transaction or reference ID.",
        "<strong class='text-white'>Name the right team.</strong> Withdrawals go to the Treasury team, and only Treasury can cancel or correct one. For a subscription or platform-fee refund, ask for billing.",
        "<strong class='text-white'>Ask for a supervisor explicitly.</strong> &ldquo;Please escalate this to a supervisor&rdquo; is a specific request that's harder to ignore than a vague complaint.",
        "<strong class='text-white'>Set a deadline in writing,</strong> and keep a card chargeback as a last resort for card-payment refunds after support has had a fair chance.",
      ],
    },
    { type: "heading", text: "Why a Tradovate Refund Shows Up in the Wrong Amount or Currency" },
    { type: "paragraph", html: "Before you escalate, know what actually happened, because a chunk of these cases aren't errors at all. They're the normal mechanics of moving money across borders, and knowing them tells you whether you're owed a correction or just looking at expected fees. Here are the usual causes." },
    { type: "heading", text: "1. International wire currency conversion" },
    { type: "paragraph", html: "If you requested a withdrawal to a bank outside the United States, the payout is sent in dollars and converted to your local currency somewhere along the chain, at an intermediary or your receiving bank. That's why a dollar figure can land as euros, pounds, or rupees. During processing, an international wire withdrawal can briefly show a <strong class='text-white'>suspended</strong> status while the funds are handled for that conversion. It looks alarming, but it's a standard step, not a failure. The rate used is the receiving side's, not one you picked, so the converted total rarely matches a back-of-the-napkin figure." },
    { type: "heading", text: "2. Intermediary and correspondent bank fees" },
    { type: "paragraph", html: "A cross-border wire almost never travels directly. It hops through one or more correspondent banks, and each one can skim a handling fee before passing the money along. Add the sending fee and any lifting fees, and the amount that lands can be noticeably less than you requested. If the shortfall lines up with a wire fee or two, that's the banking system working as designed, not a broker mistake." },
    { type: "heading", text: "3. A partial or duplicate refund" },
    { type: "paragraph", html: "Sometimes the number is wrong because only part of what you were owed got processed, or a first attempt failed and a second, smaller correction went out on its own. When two entries exist for one problem, the running total looks wrong even though each line was &ldquo;correct&rdquo; to whoever keyed it in. This is exactly the kind of thing that gets lost when your case bounces between reps who each see only their piece." },
    { type: "heading", text: "4. Refund routed to the wrong method or original currency" },
    { type: "paragraph", html: "Refunds tend to go back to the original payment method. If you paid with a card denominated in a foreign currency, the money returns through that same rail and gets re-converted, which can leave you with a figure that doesn't match what left your account, purely from exchange-rate drift between the two dates. A refund sent to a closed or changed account adds more delay." },
    { type: "heading", text: "5. A genuine processing error" },
    { type: "paragraph", html: "And yes, sometimes it really is a mistake: a wrong amount entered, a slipped decimal, a currency field set incorrectly, or the wrong account credited. These cases fully justify a firm escalation, and the only way to prove one is with the documentation you're about to gather." },
    { type: "heading", text: "How to Fix a Wrong Refund: Step-by-Step" },
    {
      type: "steps",
      items: [
        { title: "Confirm it's actually wrong before you escalate", html: "Walking in with &ldquo;I'm missing money&rdquo; gets a slow, defensive response. Walking in with exact figures and IDs gets action. Open your <strong class='text-white'>account statement or cash-transactions report</strong> and find the refund or withdrawal line, noting the exact amount credited, the currency, and the value date. Compare it against your original request. Pull your <strong class='text-white'>bank or card statement</strong> for the matching entry, since the bank's advice slip often itemizes the incoming amount and any fees deducted. Do the math: requested amount, minus documented wire/FX fees, versus what arrived. If the leftover gap is small and matches known fees, you may not have an error. If it's large and unexplained, you have a real case." },
        { title: "Open one documented support ticket", html: "Resist the urge to fire off angry messages across chat, email, and phone at once. Scattered contacts are how a case fragments, with each rep seeing a different slice and nobody owning the whole thing. Pick one written channel, the support ticket, and make it your single source of truth. You can reach Tradovate support through the in-platform live chat, by email at <strong class='text-white'>support@tradovate.com</strong>, by phone at <strong class='text-white'>1 (844) 283-3100</strong>, or through the Help Center contact form. Confirm the current numbers and hours on the official contact page first, since they change. In that first ticket, lay it all out in one place: a one-line summary, the requested and actual amounts with dates, every transaction ID, the exact discrepancy and why fees don't explain it, and a clear ask." },
        { title: "Escalate to the Treasury team and a supervisor", html: "This is where most people go wrong: they keep re-explaining the problem to whichever front-line agent picks up, and each one resets the clock. Withdrawals are handled by Tradovate's <strong class='text-white'>Treasury team</strong>, and a withdrawal can only be canceled or corrected by that team on request. Write something like: &ldquo;Please route this to the Treasury team, since it's a withdrawal correction, and have a supervisor review it.&rdquo; For a subscription or platform-fee refund rather than a trading-account payout, ask for billing instead. Two phrases carry the weight: &ldquo;I'd like this escalated to a supervisor&rdquo; and &ldquo;please keep this on ticket number ___.&rdquo;" },
        { title: "Know what to do if reps go silent", html: "Silence is the hard part, and it's usually where people give up. <strong class='text-white'>Consolidate, then bump the same thread</strong>, reply on the existing ticket, quote your reference IDs, and ask for a status and a named owner. <strong class='text-white'>Switch channel, keep the reference</strong>, if written replies stall, jump on live chat or the phone during business hours. <strong class='text-white'>Set and state a deadline</strong> in writing. <strong class='text-white'>Ask for the complaints or escalation path</strong> by name. Use a <strong class='text-white'>card dispute as a genuine last resort</strong> only after support has had a fair, documented chance, since a disputed payment can trigger a hold or lock on the trading account while it's investigated." },
      ],
    },
    { type: "heading", text: "Troubleshooting Table" },
    {
      type: "table",
      headers: ["What you see", "What it likely means", "What to do"],
      rows: [
        ["Dollar request arrived as euros/pounds/etc.", "International wire currency conversion at the receiving side", "Confirm the FX rate with your bank; escalate only if the rate is clearly off"],
        ["Amount short by a wire fee or two", "Intermediary/correspondent bank handling fees", "Match the bank advice slip; usually expected, not an error"],
        ["Withdrawal stuck on &ldquo;suspended&rdquo;", "Funds being processed for currency conversion", "Wait out the stated timeframe; if it overruns, ask Treasury to check it"],
        ["Large, unexplained shortfall", "Partial refund, duplicate entry, or a processing error", "Document the gap and escalate to Treasury with all IDs"],
        ["Refund smaller than the original charge", "Re-conversion on a foreign-currency card between two dates", "Compare both statement entries; raise with billing if the gap is large"],
        ["Reps answer once, then go quiet", "Case fragmented across agents", "Consolidate on one ticket, request a supervisor, set a deadline"],
      ],
    },
    { type: "heading", text: "How to Avoid Refund and Currency Surprises Next Time" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Withdraw to a same-currency, domestic account where you can.</strong> Fewer conversions and correspondent hops mean fewer places for the number to shrink.",
        "<strong class='text-white'>Read the method's fees and timeframes first.</strong> Wire, ACH, and card refunds each carry different fees and settlement windows, so you know what &ldquo;correct&rdquo; looks like before it arrives.",
        "<strong class='text-white'>Keep your own log.</strong> Note every request with its date, amount, currency, and reference ID as you submit it. Reconciling later is trivial when you already have the paper trail.",
        "<strong class='text-white'>Confirm your destination details are current and open</strong> before requesting a payout, so nothing bounces to a stale account.",
        "<strong class='text-white'>Move fast on obvious errors.</strong> Since only Treasury can cancel a withdrawal, and only on request, catching a wrong amount before the wire settles gives you the best shot at a clean fix.",
      ],
    },
    { type: "heading", text: "Keep Your Records Clean With PickMyTrade" },
    { type: "paragraph", html: "PickMyTrade can't process a broker refund for you, and it won't pretend to. What it does is keep the trading side of your paper trail tidy, so when a billing question comes up you're not rebuilding anything from memory. Your automated orders route through one consistent layer, your fills and history stay in order, and your subscription is a flat, transparent price with no surprise conversions. When the money you're chasing sits on the broker's side, clean timestamped trade records on yours make every escalation easier to win." },
  ], de: [
    { type: "paragraph", html: "Sie haben um einen bestimmten Betrag in Dollar gebeten, und es kam weniger an, manchmal sogar in einer völlig anderen Währung. Dann versiegten die Antworten. Ein Mitarbeiter beantwortete eine einzelne Frage, markierte sie als gelöst und ging weiter, und der Nächste fing bei null an, als hätten Sie nie geschrieben. Es ist zermürbend, wenn es um Ihr Geld geht, aber das ist ein lösbares Abrechnungsproblem, kein verlorener Fall. Der Ausweg ist derselbe, der bei jedem Finanzinstitut funktioniert, wenn die erste Linie ins Stocken gerät: Hören Sie auf, sich gegenüber verschiedenen Personen zu wiederholen, legen Sie mit belastbarer Dokumentation genau fest, was falsch ist, und eskalieren Sie den Fall an einen Vorgesetzten und das Team, das die Gelder kontrolliert. Hier erfahren Sie, wie, von der Bestätigung, ob Ihnen tatsächlich eine Korrektur zusteht, bis zur Eskalation, bis bezahlt wird." },
    {
      type: "checklist",
      heading: "Kurzantwort: Was Sie jetzt sofort tun sollten",
      items: [
        "<strong class='text-white'>Eröffnen Sie nicht fünf neue Tickets.</strong> Halten Sie alles in einem Thread, damit niemand Ihre Nachfrage als neue, unabhängige Frage behandelt.",
        "<strong class='text-white'>Machen Sie Screenshots als Beweis.</strong> Den angeforderten Betrag, den angekommenen Betrag und die Währung, die Daten und jede Transaktions- oder Referenz-ID.",
        "<strong class='text-white'>Nennen Sie das richtige Team.</strong> Auszahlungen gehen an das Treasury-Team, und nur Treasury kann eine Auszahlung stornieren oder korrigieren. Bei einer Rückerstattung für ein Abo oder eine Plattformgebühr fragen Sie nach der Abrechnungsabteilung.",
        "<strong class='text-white'>Verlangen Sie ausdrücklich einen Vorgesetzten.</strong> &ldquo;Bitte eskalieren Sie das an einen Vorgesetzten&rdquo; ist eine konkrete Bitte, die schwerer zu ignorieren ist als eine vage Beschwerde.",
        "<strong class='text-white'>Setzen Sie schriftlich eine Frist,</strong> und behalten Sie eine Kartenrückbuchung als letztes Mittel für Rückerstattungen bei Kartenzahlungen, nachdem der Support eine faire Chance hatte.",
      ],
    },
    { type: "heading", text: "Warum eine Tradovate-Rückerstattung mit falschem Betrag oder falscher Währung ankommt" },
    { type: "paragraph", html: "Bevor Sie eskalieren, sollten Sie wissen, was tatsächlich passiert ist, denn ein Teil dieser Fälle sind gar keine Fehler. Es handelt sich um die normale Mechanik grenzüberschreitender Geldbewegungen, und wer sie kennt, weiß, ob ihm eine Korrektur zusteht oder ob er nur erwartete Gebühren vor sich hat. Hier sind die üblichen Ursachen." },
    { type: "heading", text: "1. Währungsumrechnung bei internationalen Überweisungen" },
    { type: "paragraph", html: "Wenn Sie eine Auszahlung an eine Bank außerhalb der Vereinigten Staaten beantragt haben, wird die Auszahlung in Dollar gesendet und irgendwo in der Kette, bei einer Zwischenbank oder Ihrer Empfängerbank, in Ihre Landeswährung umgerechnet. Deshalb kann ein Dollarbetrag als Euro, Pfund oder Rupien ankommen. Während der Bearbeitung kann eine internationale Überweisungsauszahlung kurzzeitig den Status <strong class='text-white'>suspended</strong> anzeigen, während die Gelder für diese Umrechnung bearbeitet werden. Das wirkt beunruhigend, ist aber ein Standardschritt und kein Fehler. Der verwendete Kurs ist der der Empfängerseite, nicht einer, den Sie ausgewählt haben, daher stimmt der umgerechnete Gesamtbetrag selten mit einer Überschlagsrechnung überein." },
    { type: "heading", text: "2. Gebühren von Zwischen- und Korrespondenzbanken" },
    { type: "paragraph", html: "Eine grenzüberschreitende Überweisung reist fast nie direkt. Sie durchläuft eine oder mehrere Korrespondenzbanken, und jede kann eine Bearbeitungsgebühr abziehen, bevor sie das Geld weiterleitet. Zählen Sie die Versandgebühr und etwaige Lifting-Gebühren hinzu, und der ankommende Betrag kann spürbar niedriger sein als angefordert. Wenn die Differenz einer oder zwei Überweisungsgebühren entspricht, funktioniert das Bankensystem wie vorgesehen, kein Fehler des Brokers." },
    { type: "heading", text: "3. Eine teilweise oder doppelte Rückerstattung" },
    { type: "paragraph", html: "Manchmal stimmt die Zahl nicht, weil nur ein Teil des Ihnen zustehenden Betrags bearbeitet wurde oder ein erster Versuch fehlschlug und eine zweite, kleinere Korrektur separat hinausging. Wenn zwei Einträge für ein Problem existieren, sieht die laufende Summe falsch aus, obwohl jede Zeile für denjenigen, der sie erfasst hat, &ldquo;korrekt&rdquo; war. Genau das geht verloren, wenn Ihr Fall zwischen Mitarbeitern hin- und herspringt, die jeweils nur ihren eigenen Ausschnitt sehen." },
    { type: "heading", text: "4. Rückerstattung an die falsche Methode oder ursprüngliche Währung geleitet" },
    { type: "paragraph", html: "Rückerstattungen gehen tendenziell an die ursprüngliche Zahlungsmethode zurück. Wenn Sie mit einer auf eine Fremdwährung lautenden Karte bezahlt haben, kehrt das Geld über denselben Weg zurück und wird erneut umgerechnet, was zu einem Betrag führen kann, der nicht mit dem übereinstimmt, der Ihr Konto verlassen hat, rein durch Wechselkursschwankungen zwischen den beiden Daten. Eine Rückerstattung an ein geschlossenes oder geändertes Konto verzögert die Sache zusätzlich." },
    { type: "heading", text: "5. Ein echter Bearbeitungsfehler" },
    { type: "paragraph", html: "Und ja, manchmal ist es tatsächlich ein Fehler: ein falsch eingegebener Betrag, eine verrutschte Dezimalstelle, ein falsch gesetztes Währungsfeld oder das falsche gutgeschriebene Konto. Diese Fälle rechtfertigen eine entschlossene Eskalation voll und ganz, und der einzige Weg, das zu beweisen, ist die Dokumentation, die Sie jetzt zusammentragen." },
    { type: "heading", text: "So beheben Sie eine falsche Rückerstattung: Schritt für Schritt" },
    {
      type: "steps",
      items: [
        { title: "Bestätigen Sie, dass es wirklich falsch ist, bevor Sie eskalieren", html: "Wer mit &ldquo;mir fehlt Geld&rdquo; ankommt, bekommt eine langsame, abwehrende Antwort. Wer mit exakten Zahlen und IDs ankommt, bekommt Handlung. Öffnen Sie Ihren <strong class='text-white'>Kontoauszug oder Cash-Transactions-Report</strong> und suchen Sie die Zeile mit der Rückerstattung oder Auszahlung, notieren Sie den genauen gutgeschriebenen Betrag, die Währung und das Valutadatum. Vergleichen Sie das mit Ihrer ursprünglichen Anfrage. Rufen Sie Ihren <strong class='text-white'>Bank- oder Kartenauszug</strong> für den passenden Eintrag ab, da der Bankbeleg oft den eingehenden Betrag und alle abgezogenen Gebühren einzeln aufführt. Rechnen Sie nach: angeforderter Betrag minus dokumentierter Überweisungs-/FX-Gebühren gegenüber dem, was ankam. Wenn die verbleibende Lücke klein ist und bekannten Gebühren entspricht, liegt möglicherweise kein Fehler vor. Ist sie groß und unerklärt, haben Sie einen echten Fall." },
        { title: "Eröffnen Sie ein dokumentiertes Support-Ticket", html: "Widerstehen Sie dem Impuls, gleichzeitig wütende Nachrichten über Chat, E-Mail und Telefon zu verschicken. Verstreute Kontakte sind genau der Grund, warum ein Fall zerfällt, jeder Mitarbeiter sieht nur einen anderen Ausschnitt, und niemand ist für das Ganze zuständig. Wählen Sie einen schriftlichen Kanal, das Support-Ticket, und machen Sie ihn zu Ihrer einzigen verlässlichen Quelle. Sie erreichen den Tradovate-Support über den plattforminternen Live-Chat, per E-Mail an <strong class='text-white'>support@tradovate.com</strong>, telefonisch unter <strong class='text-white'>1 (844) 283-3100</strong> oder über das Kontaktformular des Help Centers. Bestätigen Sie zuerst die aktuellen Nummern und Öffnungszeiten auf der offiziellen Kontaktseite, da sie sich ändern. Legen Sie in diesem ersten Ticket alles an einem Ort dar: eine einzeilige Zusammenfassung, den angeforderten und tatsächlichen Betrag mit Daten, jede Transaktions-ID, die genaue Abweichung und warum Gebühren sie nicht erklären, sowie eine klare Bitte." },
        { title: "Eskalieren Sie an das Treasury-Team und einen Vorgesetzten", html: "Hier machen die meisten Leute den Fehler: Sie erklären das Problem immer wieder dem jeweiligen Erstlinien-Mitarbeiter, der abnimmt, und jeder setzt die Uhr zurück. Auszahlungen werden vom <strong class='text-white'>Treasury-Team</strong> von Tradovate bearbeitet, und eine Auszahlung kann nur auf Anfrage von diesem Team storniert oder korrigiert werden. Schreiben Sie etwa: &ldquo;Bitte leiten Sie das an das Treasury-Team weiter, da es sich um eine Auszahlungskorrektur handelt, und lassen Sie einen Vorgesetzten es prüfen.&rdquo; Bei einer Rückerstattung für ein Abo oder eine Plattformgebühr statt einer Auszahlung vom Handelskonto fragen Sie stattdessen nach der Abrechnungsabteilung. Zwei Formulierungen haben Gewicht: &ldquo;Ich möchte, dass dies an einen Vorgesetzten eskaliert wird&rdquo; und &ldquo;bitte behalten Sie das unter Ticket-Nummer ___.&rdquo;" },
        { title: "Wissen Sie, was zu tun ist, wenn Mitarbeiter nicht mehr antworten", html: "Schweigen ist der schwierige Teil, und meist geben Menschen genau dann auf. <strong class='text-white'>Konsolidieren, dann denselben Thread nach oben holen</strong>, antworten Sie im bestehenden Ticket, zitieren Sie Ihre Referenz-IDs und fragen Sie nach einem Status und einem namentlich genannten Verantwortlichen. <strong class='text-white'>Kanal wechseln, Referenz behalten</strong>, stocken schriftliche Antworten, wechseln Sie während der Geschäftszeiten zum Live-Chat oder Telefon. <strong class='text-white'>Setzen und nennen Sie eine Frist</strong> schriftlich. <strong class='text-white'>Fragen Sie ausdrücklich nach dem Beschwerde- oder Eskalationsweg</strong>. Nutzen Sie eine <strong class='text-white'>Kartenrückbuchung nur als echtes letztes Mittel</strong>, nachdem der Support eine faire, dokumentierte Chance hatte, denn eine angefochtene Zahlung kann während der Prüfung eine Sperre oder Blockierung des Handelskontos auslösen." },
      ],
    },
    { type: "heading", text: "Fehlerbehebungstabelle" },
    {
      type: "table",
      headers: ["Was Sie sehen", "Was es wahrscheinlich bedeutet", "Was zu tun ist"],
      rows: [
        ["Dollaranfrage kam als Euro/Pfund/etc. an", "Währungsumrechnung bei einer internationalen Überweisung auf Empfängerseite", "Den Wechselkurs mit Ihrer Bank bestätigen; nur eskalieren, wenn der Kurs eindeutig falsch ist"],
        ["Betrag um eine oder zwei Überweisungsgebühren zu niedrig", "Bearbeitungsgebühren von Zwischen-/Korrespondenzbanken", "Mit dem Bankbeleg abgleichen; meist zu erwarten, kein Fehler"],
        ["Auszahlung hängt bei &ldquo;suspended&rdquo;", "Gelder werden für die Währungsumrechnung bearbeitet", "Die angegebene Frist abwarten; überschreitet sie diese, Treasury um Prüfung bitten"],
        ["Große, unerklärte Fehlbetragsdifferenz", "Teilweise Rückerstattung, doppelter Eintrag oder ein Bearbeitungsfehler", "Die Lücke dokumentieren und mit allen IDs an Treasury eskalieren"],
        ["Rückerstattung kleiner als die ursprüngliche Belastung", "Erneute Umrechnung bei einer Fremdwährungskarte zwischen zwei Daten", "Beide Kontoauszugseinträge vergleichen; bei großer Lücke bei der Abrechnung melden"],
        ["Mitarbeiter antworten einmal und schweigen dann", "Fall über mehrere Mitarbeiter verteilt", "Auf einem Ticket konsolidieren, einen Vorgesetzten anfordern, eine Frist setzen"],
      ],
    },
    { type: "heading", text: "So vermeiden Sie künftig Überraschungen bei Rückerstattungen und Währungen" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Zahlen Sie nach Möglichkeit auf ein inländisches Konto in derselben Währung aus.</strong> Weniger Umrechnungen und Korrespondenzbank-Stationen bedeuten weniger Stellen, an denen der Betrag schrumpfen kann.",
        "<strong class='text-white'>Lesen Sie zuerst die Gebühren und Zeitrahmen der Methode.</strong> Überweisung, ACH und Kartenrückerstattungen haben jeweils unterschiedliche Gebühren und Abwicklungsfenster, sodass Sie wissen, wie &ldquo;korrekt&rdquo; aussieht, bevor der Betrag ankommt.",
        "<strong class='text-white'>Führen Sie Ihr eigenes Protokoll.</strong> Notieren Sie jede Anfrage mit Datum, Betrag, Währung und Referenz-ID beim Absenden. Der spätere Abgleich ist trivial, wenn Sie die Belege bereits haben.",
        "<strong class='text-white'>Bestätigen Sie, dass Ihre Zieldaten aktuell und aktiv sind,</strong> bevor Sie eine Auszahlung beantragen, damit nichts an ein veraltetes Konto zurückgeht.",
        "<strong class='text-white'>Handeln Sie bei offensichtlichen Fehlern schnell.</strong> Da nur Treasury eine Auszahlung stornieren kann, und nur auf Anfrage, haben Sie die besten Chancen auf eine saubere Korrektur, wenn Sie einen falschen Betrag entdecken, bevor die Überweisung abgewickelt ist.",
      ],
    },
    { type: "heading", text: "Halten Sie Ihre Aufzeichnungen sauber mit PickMyTrade" },
    { type: "paragraph", html: "PickMyTrade kann keine Broker-Rückerstattung für Sie abwickeln, und es tut auch nicht so. Was es leistet: die Handelsseite Ihrer Belege sauber zu halten, damit Sie bei einer Abrechnungsfrage nichts aus dem Gedächtnis rekonstruieren müssen. Ihre automatisierten Orders laufen über eine einheitliche Schicht, Ihre Fills und Ihr Verlauf bleiben geordnet, und Ihr Abo hat einen festen, transparenten Preis ohne überraschende Umrechnungen. Wenn das Geld, das Sie verfolgen, auf der Seite des Brokers liegt, machen saubere, zeitgestempelte Handelsaufzeichnungen auf Ihrer Seite jede Eskalation leichter zu gewinnen." },
  ], es: [
    { type: "paragraph", html: "Usted pidió una cifra concreta en dólares, y llegó algo menor, a veces en una divisa completamente distinta. Luego las respuestas se agotaron. Un agente respondió una sola pregunta, la marcó como resuelta y siguió adelante, y el siguiente empezó de cero como si usted nunca hubiera escrito. Es exasperante cuando está en juego su dinero, pero se trata de un problema de facturación solucionable, no de una causa perdida. La salida es la misma que funciona con cualquier institución financiera cuando la primera línea se estanca: deje de repetirse ante personas distintas, precise exactamente qué está mal con documentación sólida, y eleve el caso a un supervisor y al equipo que controla los fondos. A continuación se explica cómo, desde confirmar si realmente se le debe una corrección hasta escalar hasta que se pague." },
    {
      type: "checklist",
      heading: "Respuesta rápida: qué hacer ahora mismo",
      items: [
        "<strong class='text-white'>No abra cinco tickets nuevos.</strong> Mantenga todo en un solo hilo para que nadie trate su seguimiento como una pregunta nueva y sin relación.",
        "<strong class='text-white'>Capture la prueba con capturas de pantalla.</strong> El importe solicitado, el importe y la divisa que llegaron, las fechas y cada ID de transacción o referencia.",
        "<strong class='text-white'>Identifique al equipo correcto.</strong> Los retiros van al equipo de Treasury, y solo Treasury puede cancelar o corregir uno. Para un reembolso de suscripción o de tarifa de plataforma, pida hablar con facturación.",
        "<strong class='text-white'>Pida un supervisor de forma explícita.</strong> &ldquo;Por favor, escale esto a un supervisor&rdquo; es una petición concreta más difícil de ignorar que una queja vaga.",
        "<strong class='text-white'>Fije un plazo por escrito,</strong> y reserve una impugnación de cargo (chargeback) como último recurso para reembolsos con tarjeta, después de que el soporte haya tenido una oportunidad justa.",
      ],
    },
    { type: "heading", text: "Por qué un reembolso de Tradovate llega con el importe o la divisa equivocados" },
    { type: "paragraph", html: "Antes de escalar, entienda lo que realmente ocurrió, porque una buena parte de estos casos no son errores en absoluto. Son la mecánica normal de mover dinero a través de fronteras, y conocerla le indica si se le debe una corrección o si solo está viendo tarifas esperadas. Estas son las causas habituales." },
    { type: "heading", text: "1. Conversión de divisa en transferencias internacionales" },
    { type: "paragraph", html: "Si solicitó un retiro a un banco fuera de Estados Unidos, el pago se envía en dólares y se convierte a su divisa local en algún punto de la cadena, en un banco intermediario o en su banco receptor. Por eso una cifra en dólares puede llegar como euros, libras o rupias. Durante el procesamiento, un retiro por transferencia internacional puede mostrar brevemente un estado <strong class='text-white'>suspended</strong> mientras los fondos se procesan para esa conversión. Parece alarmante, pero es un paso estándar, no un fallo. La tasa usada es la del lado receptor, no una que usted eligió, así que el total convertido rara vez coincide con un cálculo aproximado." },
    { type: "heading", text: "2. Comisiones de bancos intermediarios y corresponsales" },
    { type: "paragraph", html: "Una transferencia transfronteriza casi nunca viaja de forma directa. Pasa por uno o más bancos corresponsales, y cada uno puede descontar una comisión de gestión antes de transferir el dinero. Sume la comisión de envío y las posibles comisiones de manejo, y el importe que llega puede ser notablemente menor al solicitado. Si el faltante coincide con una o dos comisiones de transferencia, el sistema bancario está funcionando como está diseñado, no es un error del bróker." },
    { type: "heading", text: "3. Un reembolso parcial o duplicado" },
    { type: "paragraph", html: "A veces la cifra está mal porque solo se procesó una parte de lo que se le debía, o un primer intento falló y una segunda corrección, más pequeña, se envió por separado. Cuando existen dos entradas para un mismo problema, el total corriente parece incorrecto aunque cada línea fuera &ldquo;correcta&rdquo; para quien la registró. Esto es exactamente lo que se pierde cuando su caso rebota entre agentes que solo ven su propia parte." },
    { type: "heading", text: "4. Reembolso enviado al método o divisa original equivocados" },
    { type: "paragraph", html: "Los reembolsos suelen volver al método de pago original. Si pagó con una tarjeta denominada en divisa extranjera, el dinero regresa por esa misma vía y se vuelve a convertir, lo que puede dejarle una cifra que no coincide con lo que salió de su cuenta, únicamente por la variación del tipo de cambio entre las dos fechas. Un reembolso enviado a una cuenta cerrada o modificada añade más demora." },
    { type: "heading", text: "5. Un error de procesamiento real" },
    { type: "paragraph", html: "Y sí, a veces realmente es un error: un importe mal introducido, un decimal desplazado, un campo de divisa configurado incorrectamente, o la cuenta equivocada acreditada. Estos casos justifican plenamente una escalada firme, y la única forma de demostrarlo es con la documentación que está a punto de reunir." },
    { type: "heading", text: "Cómo corregir un reembolso incorrecto: paso a paso" },
    {
      type: "steps",
      items: [
        { title: "Confirmar que realmente está mal antes de escalar", html: "Presentarse con &ldquo;me falta dinero&rdquo; obtiene una respuesta lenta y defensiva. Presentarse con cifras exactas e IDs consigue acción. Abra su <strong class='text-white'>estado de cuenta o informe de transacciones en efectivo</strong> y localice la línea de reembolso o retiro, anotando el importe exacto acreditado, la divisa y la fecha valor. Compárelo con su solicitud original. Obtenga su <strong class='text-white'>estado de cuenta bancario o de tarjeta</strong> para la entrada correspondiente, ya que el aviso del banco a menudo detalla el importe entrante y cualquier comisión deducida. Haga el cálculo: importe solicitado, menos las comisiones de transferencia/FX documentadas, frente a lo que llegó. Si la diferencia restante es pequeña y coincide con comisiones conocidas, puede que no haya ningún error. Si es grande e inexplicada, tiene un caso real." },
        { title: "Abrir un único ticket de soporte documentado", html: "Resista el impulso de disparar mensajes airados por chat, correo y teléfono a la vez. Los contactos dispersos son la forma en que un caso se fragmenta, cada agente ve una parte distinta y nadie es dueño del conjunto. Elija un canal escrito, el ticket de soporte, y conviértalo en su única fuente de verdad. Puede contactar con el soporte de Tradovate a través del chat en vivo dentro de la plataforma, por correo electrónico a <strong class='text-white'>support@tradovate.com</strong>, por teléfono al <strong class='text-white'>1 (844) 283-3100</strong>, o mediante el formulario de contacto del Help Center. Confirme primero los números y horarios actuales en la página oficial de contacto, ya que cambian. En ese primer ticket, exponga todo en un solo lugar: un resumen de una línea, los importes solicitado y real con fechas, cada ID de transacción, la discrepancia exacta y por qué las comisiones no la explican, y una petición clara." },
        { title: "Escalar al equipo de Treasury y a un supervisor", html: "Aquí es donde la mayoría se equivoca: siguen reexplicando el problema a cada agente de primera línea que atiende, y cada uno reinicia el reloj. Los retiros son gestionados por el <strong class='text-white'>equipo de Treasury</strong> de Tradovate, y un retiro solo puede cancelarse o corregirse por ese equipo, a petición. Escriba algo como: &ldquo;Por favor, dirijan esto al equipo de Treasury, ya que es una corrección de retiro, y que un supervisor lo revise.&rdquo; Para un reembolso de suscripción o de tarifa de plataforma, en lugar de un pago de cuenta de trading, pida hablar con facturación. Dos frases tienen peso: &ldquo;me gustaría que esto se escalara a un supervisor&rdquo; y &ldquo;por favor, mantengan esto en el ticket número ___.&rdquo;" },
        { title: "Saber qué hacer si los agentes dejan de responder", html: "El silencio es la parte difícil, y suele ser donde la gente se rinde. <strong class='text-white'>Consolide y luego reactive el mismo hilo</strong>, responda en el ticket existente, cite sus IDs de referencia y pida un estado y un responsable con nombre. <strong class='text-white'>Cambie de canal, conserve la referencia</strong>, si las respuestas escritas se estancan, pase al chat en vivo o al teléfono en horario laboral. <strong class='text-white'>Fije y comunique un plazo</strong> por escrito. <strong class='text-white'>Pida por su nombre la vía de quejas o escalada</strong>. Use una <strong class='text-white'>impugnación de tarjeta solo como último recurso genuino</strong>, después de que el soporte haya tenido una oportunidad justa y documentada, ya que un pago impugnado puede provocar una retención o bloqueo de la cuenta de trading mientras se investiga." },
      ],
    },
    { type: "heading", text: "Tabla de solución de problemas" },
    {
      type: "table",
      headers: ["Lo que ve", "Lo que probablemente significa", "Qué hacer"],
      rows: [
        ["La solicitud en dólares llegó en euros/libras/etc.", "Conversión de divisa de transferencia internacional en el lado receptor", "Confirme el tipo de cambio con su banco; escale solo si el tipo está claramente equivocado"],
        ["El importe está corto por una o dos comisiones de transferencia", "Comisiones de gestión de bancos intermediarios/corresponsales", "Compárelo con el aviso del banco; suele ser lo esperado, no un error"],
        ["Retiro atascado en &ldquo;suspended&rdquo;", "Fondos en procesamiento para la conversión de divisa", "Espere el plazo indicado; si se excede, pida a Treasury que lo revise"],
        ["Faltante grande e inexplicado", "Reembolso parcial, entrada duplicada o error de procesamiento", "Documente la diferencia y escale a Treasury con todos los IDs"],
        ["Reembolso menor que el cargo original", "Reconversión en una tarjeta de divisa extranjera entre dos fechas", "Compare ambas entradas del estado de cuenta; escale con facturación si la diferencia es grande"],
        ["Los agentes responden una vez y luego callan", "Caso fragmentado entre agentes", "Consolide en un solo ticket, pida un supervisor, fije un plazo"],
      ],
    },
    { type: "heading", text: "Cómo evitar sorpresas de reembolso y divisa la próxima vez" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Retire a una cuenta doméstica en la misma divisa cuando pueda.</strong> Menos conversiones y saltos entre corresponsales significan menos lugares donde la cifra puede reducirse.",
        "<strong class='text-white'>Lea antes las comisiones y plazos del método.</strong> Las transferencias, ACH y reembolsos con tarjeta conllevan comisiones y ventanas de liquidación distintas, así sabe cómo debe verse &ldquo;correcto&rdquo; antes de que llegue.",
        "<strong class='text-white'>Lleve su propio registro.</strong> Anote cada solicitud con su fecha, importe, divisa e ID de referencia al enviarla. Conciliar después es trivial cuando ya tiene el rastro documental.",
        "<strong class='text-white'>Confirme que sus datos de destino estén actuales y activos</strong> antes de solicitar un pago, para que nada rebote a una cuenta obsoleta.",
        "<strong class='text-white'>Actúe rápido ante errores evidentes.</strong> Dado que solo Treasury puede cancelar un retiro, y solo a petición, detectar un importe incorrecto antes de que la transferencia se liquide le da la mejor oportunidad de una corrección limpia.",
      ],
    },
    { type: "heading", text: "Mantenga sus registros limpios con PickMyTrade" },
    { type: "paragraph", html: "PickMyTrade no puede procesar un reembolso del bróker por usted, y no pretende hacerlo. Lo que sí hace es mantener ordenado el lado de trading de su rastro documental, para que cuando surja una duda de facturación no tenga que reconstruir nada de memoria. Sus órdenes automatizadas se enrutan a través de una capa consistente, sus fills e historial se mantienen en orden, y su suscripción tiene un precio plano y transparente sin conversiones sorpresa. Cuando el dinero que persigue está del lado del bróker, unos registros de operaciones limpios y con marca de tiempo de su parte hacen que cada escalada sea más fácil de ganar." },
  ], fr: [
    { type: "paragraph", html: "Vous avez demandé un montant précis en dollars, et une somme moindre est arrivée, parfois dans une devise complètement différente. Puis les réponses se sont taries. Un agent a répondu à une seule question, l'a marquée comme résolue et est passé à autre chose, et le suivant est reparti de zéro comme si vous n'aviez jamais écrit. C'est exaspérant lorsque c'est votre argent qui est en jeu, mais c'est un problème de facturation soluble, pas une cause perdue. La sortie est la même que celle qui fonctionne avec n'importe quelle institution financière lorsque la première ligne cale : arrêtez de vous répéter auprès de personnes différentes, cernez précisément ce qui ne va pas avec une documentation solide, et faites remonter le dossier à un superviseur et à l'équipe qui contrôle les fonds. Voici comment procéder, de la confirmation qu'une correction vous est réellement due jusqu'à l'escalade jusqu'au paiement." },
    {
      type: "checklist",
      heading: "Réponse rapide : que faire dès maintenant",
      items: [
        "<strong class='text-white'>N'ouvrez pas cinq nouveaux tickets.</strong> Gardez tout sur un seul fil pour que personne ne traite votre relance comme une nouvelle question sans rapport.",
        "<strong class='text-white'>Faites des captures d'écran comme preuve.</strong> Le montant demandé, le montant et la devise reçus, les dates, et chaque ID de transaction ou de référence.",
        "<strong class='text-white'>Identifiez la bonne équipe.</strong> Les retraits vont à l'équipe Treasury, et seule Treasury peut en annuler ou en corriger un. Pour un remboursement d'abonnement ou de frais de plateforme, demandez la facturation.",
        "<strong class='text-white'>Demandez explicitement un superviseur.</strong> &laquo;Veuillez faire remonter ceci à un superviseur&raquo; est une demande précise plus difficile à ignorer qu'une plainte vague.",
        "<strong class='text-white'>Fixez un délai par écrit,</strong> et gardez une rétrofacturation par carte comme dernier recours pour les remboursements par carte, après que le support a eu une chance équitable.",
      ],
    },
    { type: "heading", text: "Pourquoi un remboursement Tradovate arrive avec un montant ou une devise incorrects" },
    { type: "paragraph", html: "Avant d'escalader, sachez ce qui s'est réellement passé, car une bonne partie de ces cas ne sont pas des erreurs du tout. Ce sont les mécanismes normaux du transfert d'argent transfrontalier, et les connaître vous indique si une correction vous est due ou si vous ne faites que constater des frais attendus. Voici les causes habituelles." },
    { type: "heading", text: "1. Conversion de devise sur virement international" },
    { type: "paragraph", html: "Si vous avez demandé un retrait vers une banque en dehors des États-Unis, le paiement est envoyé en dollars et converti dans votre devise locale quelque part le long de la chaîne, chez une banque intermédiaire ou votre banque réceptrice. C'est pourquoi un montant en dollars peut arriver en euros, en livres ou en roupies. Pendant le traitement, un retrait par virement international peut brièvement afficher un statut <strong class='text-white'>suspended</strong> pendant que les fonds sont traités pour cette conversion. Cela paraît alarmant, mais c'est une étape standard, pas un échec. Le taux utilisé est celui du côté récepteur, pas celui que vous avez choisi, donc le total converti correspond rarement à un calcul approximatif." },
    { type: "heading", text: "2. Frais de banques intermédiaires et correspondantes" },
    { type: "paragraph", html: "Un virement transfrontalier ne voyage presque jamais directement. Il passe par une ou plusieurs banques correspondantes, et chacune peut prélever des frais de traitement avant de transmettre l'argent. Ajoutez les frais d'envoi et d'éventuels frais de traitement supplémentaires, et le montant qui arrive peut être sensiblement inférieur à celui demandé. Si le manque correspond à un ou deux frais de virement, c'est le système bancaire qui fonctionne comme prévu, pas une erreur du courtier." },
    { type: "heading", text: "3. Un remboursement partiel ou en double" },
    { type: "paragraph", html: "Parfois, le chiffre est faux parce que seule une partie de ce qui vous était dû a été traitée, ou une première tentative a échoué et une seconde correction, plus petite, est partie séparément. Lorsque deux entrées existent pour un même problème, le total courant paraît incorrect même si chaque ligne était &laquo;correcte&raquo; pour celui qui l'a saisie. C'est exactement le genre de chose qui se perd lorsque votre dossier rebondit entre des agents qui ne voient chacun qu'une partie." },
    { type: "heading", text: "4. Remboursement acheminé vers la mauvaise méthode ou devise d'origine" },
    { type: "paragraph", html: "Les remboursements ont tendance à revenir vers le moyen de paiement d'origine. Si vous avez payé avec une carte libellée dans une devise étrangère, l'argent revient par cette même voie et est reconverti, ce qui peut vous laisser un chiffre qui ne correspond pas à ce qui a quitté votre compte, uniquement en raison de la variation du taux de change entre les deux dates. Un remboursement envoyé vers un compte clôturé ou modifié ajoute un délai supplémentaire." },
    { type: "heading", text: "5. Une véritable erreur de traitement" },
    { type: "paragraph", html: "Et oui, parfois c'est vraiment une erreur : un montant mal saisi, une décimale décalée, un champ de devise mal configuré, ou le mauvais compte crédité. Ces cas justifient pleinement une escalade ferme, et le seul moyen de le prouver est la documentation que vous êtes sur le point de rassembler." },
    { type: "heading", text: "Comment corriger un remboursement erroné : étape par étape" },
    {
      type: "steps",
      items: [
        { title: "Confirmer que c'est réellement une erreur avant d'escalader", html: "Se présenter avec &laquo;il me manque de l'argent&raquo; obtient une réponse lente et défensive. Se présenter avec des chiffres et des ID exacts obtient de l'action. Ouvrez votre <strong class='text-white'>relevé de compte ou rapport des transactions en espèces</strong> et trouvez la ligne du remboursement ou du retrait, en notant le montant exact crédité, la devise et la date de valeur. Comparez-le à votre demande d'origine. Récupérez votre <strong class='text-white'>relevé bancaire ou de carte</strong> pour l'entrée correspondante, car l'avis de la banque détaille souvent le montant reçu et les frais déduits. Faites le calcul : montant demandé, moins les frais de virement/FX documentés, comparé à ce qui est arrivé. Si l'écart restant est faible et correspond à des frais connus, il n'y a peut-être pas d'erreur. S'il est important et inexpliqué, vous avez un cas réel." },
        { title: "Ouvrir un seul ticket de support documenté", html: "Résistez à l'envie d'envoyer des messages en colère par chat, e-mail et téléphone à la fois. Des contacts dispersés sont la façon dont un dossier se fragmente, chaque agent voyant une partie différente et personne ne possédant l'ensemble. Choisissez un canal écrit, le ticket de support, et faites-en votre unique source de vérité. Vous pouvez joindre le support Tradovate via le chat en direct intégré à la plateforme, par e-mail à <strong class='text-white'>support@tradovate.com</strong>, par téléphone au <strong class='text-white'>1 (844) 283-3100</strong>, ou via le formulaire de contact du Help Center. Confirmez d'abord les numéros et horaires actuels sur la page de contact officielle, car ils changent. Dans ce premier ticket, exposez tout en un seul endroit : un résumé en une ligne, les montants demandé et réel avec les dates, chaque ID de transaction, l'écart exact et pourquoi les frais ne l'expliquent pas, et une demande claire." },
        { title: "Escalader vers l'équipe Treasury et un superviseur", html: "C'est là que la plupart des gens se trompent : ils continuent à réexpliquer le problème à chaque agent de première ligne qui répond, et chacun remet le compteur à zéro. Les retraits sont gérés par l'<strong class='text-white'>équipe Treasury</strong> de Tradovate, et un retrait ne peut être annulé ou corrigé que par cette équipe, sur demande. Écrivez quelque chose comme : &laquo;Veuillez acheminer ceci vers l'équipe Treasury, car il s'agit d'une correction de retrait, et faites-le examiner par un superviseur.&raquo; Pour un remboursement d'abonnement ou de frais de plateforme plutôt qu'un versement de compte de trading, demandez plutôt la facturation. Deux formules pèsent lourd : &laquo;je souhaiterais que ceci soit escaladé vers un superviseur&raquo; et &laquo;merci de garder ceci sur le ticket numéro ___.&raquo;" },
        { title: "Savoir quoi faire si les agents ne répondent plus", html: "Le silence est la partie difficile, et c'est généralement là que les gens abandonnent. <strong class='text-white'>Consolidez, puis relancez le même fil</strong>, répondez sur le ticket existant, citez vos ID de référence et demandez un statut et un responsable nommé. <strong class='text-white'>Changez de canal, gardez la référence</strong>, si les réponses écrites stagnent, passez au chat en direct ou au téléphone pendant les heures ouvrées. <strong class='text-white'>Fixez et indiquez un délai</strong> par écrit. <strong class='text-white'>Demandez nommément la voie de réclamation ou d'escalade</strong>. Utilisez une <strong class='text-white'>contestation de carte uniquement en dernier recours véritable</strong>, seulement après que le support a eu une chance équitable et documentée, car un paiement contesté peut déclencher un blocage ou un gel du compte de trading pendant l'enquête." },
      ],
    },
    { type: "heading", text: "Tableau de dépannage" },
    {
      type: "table",
      headers: ["Ce que vous voyez", "Ce que cela signifie probablement", "Que faire"],
      rows: [
        ["Demande en dollars arrivée en euros/livres/etc.", "Conversion de devise de virement international côté récepteur", "Confirmez le taux de change avec votre banque ; n'escaladez que si le taux est clairement erroné"],
        ["Montant inférieur d'un ou deux frais de virement", "Frais de traitement des banques intermédiaires/correspondantes", "Comparez avec l'avis de la banque ; généralement attendu, pas une erreur"],
        ["Retrait bloqué sur &laquo;suspended&raquo;", "Fonds en cours de traitement pour la conversion de devise", "Attendez le délai indiqué ; s'il est dépassé, demandez à Treasury de vérifier"],
        ["Manque important et inexpliqué", "Remboursement partiel, entrée en double, ou erreur de traitement", "Documentez l'écart et escaladez vers Treasury avec tous les ID"],
        ["Remboursement inférieur au débit d'origine", "Reconversion sur une carte en devise étrangère entre deux dates", "Comparez les deux entrées de relevé ; signalez à la facturation si l'écart est important"],
        ["Les agents répondent une fois puis se taisent", "Dossier fragmenté entre agents", "Consolidez sur un seul ticket, demandez un superviseur, fixez un délai"],
      ],
    },
    { type: "heading", text: "Comment éviter les surprises de remboursement et de devise la prochaine fois" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Retirez vers un compte domestique dans la même devise lorsque c'est possible.</strong> Moins de conversions et de passages par des correspondants signifient moins d'endroits où le montant peut diminuer.",
        "<strong class='text-white'>Lisez d'abord les frais et délais de la méthode.</strong> Les remboursements par virement, ACH et carte comportent chacun des frais et des délais de règlement différents, afin que vous sachiez à quoi ressemble un montant &laquo;correct&raquo; avant son arrivée.",
        "<strong class='text-white'>Tenez votre propre registre.</strong> Notez chaque demande avec sa date, son montant, sa devise et son ID de référence au moment de la soumettre. La réconciliation ultérieure est triviale lorsque vous avez déjà la trace documentaire.",
        "<strong class='text-white'>Vérifiez que vos coordonnées de destination sont à jour et actives</strong> avant de demander un versement, afin que rien ne rebondisse vers un compte obsolète.",
        "<strong class='text-white'>Agissez vite face à des erreurs évidentes.</strong> Comme seule Treasury peut annuler un retrait, et seulement sur demande, repérer un montant erroné avant que le virement ne soit réglé vous donne la meilleure chance d'une correction propre.",
      ],
    },
    { type: "heading", text: "Gardez vos registres propres avec PickMyTrade" },
    { type: "paragraph", html: "PickMyTrade ne peut pas traiter un remboursement du courtier à votre place, et ne prétend pas le faire. Ce qu'il fait, c'est garder le volet trading de votre trace documentaire bien ordonné, afin que lorsqu'une question de facturation se pose, vous n'ayez rien à reconstituer de mémoire. Vos ordres automatisés passent par une couche cohérente, vos exécutions et votre historique restent en ordre, et votre abonnement a un prix fixe et transparent, sans conversion surprise. Lorsque l'argent que vous poursuivez se trouve du côté du courtier, des registres de transactions propres et horodatés de votre côté rendent chaque escalade plus facile à gagner." },
  ], it: [
    { type: "paragraph", html: "Avete chiesto una cifra precisa in dollari, ed è arrivato qualcosa di inferiore, a volte in una valuta completamente diversa. Poi le risposte si sono esaurite. Un operatore ha risposto a una singola domanda, l'ha segnata come risolta ed è passato oltre, e quello successivo è ripartito da zero come se non aveste mai scritto. È esasperante quando in gioco c'è il vostro denaro, ma è un problema di fatturazione risolvibile, non una causa persa. La via d'uscita è la stessa che funziona con qualsiasi istituto finanziario quando la prima linea si blocca: smettete di ripetervi con persone diverse, definite esattamente cosa non va con documentazione solida, e portate il caso a un supervisore e al team che controlla i fondi. Ecco come fare, dal confermare se vi spetta davvero una correzione fino a scalare finché non viene pagata." },
    {
      type: "checklist",
      heading: "Risposta rapida: cosa fare subito",
      items: [
        "<strong class='text-white'>Non aprite cinque nuovi ticket.</strong> Mantenete tutto in un unico thread così nessuno tratta il vostro follow-up come una domanda nuova e non correlata.",
        "<strong class='text-white'>Fotografate la prova.</strong> L'importo richiesto, l'importo e la valuta arrivati, le date, e ogni ID di transazione o riferimento.",
        "<strong class='text-white'>Individuate il team giusto.</strong> I prelievi vanno al team Treasury, e solo Treasury può annullare o correggere un prelievo. Per un rimborso di abbonamento o di costo della piattaforma, chiedete della fatturazione.",
        "<strong class='text-white'>Chiedete esplicitamente un supervisore.</strong> &ldquo;Vi prego di far scalare questo a un supervisore&rdquo; è una richiesta specifica più difficile da ignorare di un reclamo vago.",
        "<strong class='text-white'>Fissate una scadenza per iscritto,</strong> e tenete uno storno con carta come ultima risorsa per i rimborsi con pagamento tramite carta, dopo che l'assistenza ha avuto un'equa possibilità.",
      ],
    },
    { type: "heading", text: "Perché un rimborso Tradovate arriva con l'importo o la valuta sbagliati" },
    { type: "paragraph", html: "Prima di scalare, capite cosa è realmente successo, perché una parte di questi casi non sono affatto errori. Sono la normale meccanica del movimento di denaro attraverso confini, e conoscerla vi dice se vi spetta una correzione o se state semplicemente osservando costi previsti. Ecco le cause abituali." },
    { type: "heading", text: "1. Conversione valutaria sui bonifici internazionali" },
    { type: "paragraph", html: "Se avete richiesto un prelievo verso una banca fuori dagli Stati Uniti, il pagamento viene inviato in dollari e convertito nella vostra valuta locale in un punto della catena, presso una banca intermediaria o la vostra banca ricevente. Ecco perché una cifra in dollari può arrivare in euro, sterline o rupie. Durante l'elaborazione, un prelievo tramite bonifico internazionale può mostrare brevemente lo stato <strong class='text-white'>suspended</strong> mentre i fondi vengono gestiti per quella conversione. Sembra allarmante, ma è un passaggio standard, non un fallimento. Il tasso usato è quello del lato ricevente, non uno scelto da voi, quindi il totale convertito raramente corrisponde a un calcolo approssimativo." },
    { type: "heading", text: "2. Costi di banche intermediarie e corrispondenti" },
    { type: "paragraph", html: "Un bonifico transfrontaliero quasi mai viaggia in modo diretto. Passa attraverso una o più banche corrispondenti, e ciascuna può trattenere un costo di gestione prima di trasferire il denaro. Aggiungete il costo di invio ed eventuali costi di gestione aggiuntivi, e l'importo che arriva può essere notevolmente inferiore a quello richiesto. Se la differenza corrisponde a uno o due costi di bonifico, è il sistema bancario che funziona come previsto, non un errore del broker." },
    { type: "heading", text: "3. Un rimborso parziale o duplicato" },
    { type: "paragraph", html: "A volte la cifra è sbagliata perché è stata elaborata solo una parte di quanto vi spettava, oppure un primo tentativo è fallito e una seconda correzione, più piccola, è stata inviata separatamente. Quando esistono due voci per un unico problema, il totale corrente sembra sbagliato anche se ogni riga era &ldquo;corretta&rdquo; per chi l'ha inserita. Questo è esattamente il tipo di cosa che si perde quando il vostro caso rimbalza tra operatori che vedono ciascuno solo la propria parte." },
    { type: "heading", text: "4. Rimborso indirizzato al metodo o alla valuta originale sbagliati" },
    { type: "paragraph", html: "I rimborsi tendono a tornare al metodo di pagamento originale. Se avete pagato con una carta denominata in valuta estera, il denaro torna tramite lo stesso canale e viene riconvertito, il che può lasciarvi una cifra che non corrisponde a quanto è uscito dal vostro conto, semplicemente per la variazione del tasso di cambio tra le due date. Un rimborso inviato a un conto chiuso o modificato aggiunge ulteriore ritardo." },
    { type: "heading", text: "5. Un vero errore di elaborazione" },
    { type: "paragraph", html: "E sì, a volte è davvero un errore: un importo inserito male, un decimale sbagliato, un campo valuta impostato in modo errato, oppure il conto sbagliato accreditato. Questi casi giustificano pienamente un'escalation decisa, e l'unico modo per dimostrarlo è con la documentazione che state per raccogliere." },
    { type: "heading", text: "Come correggere un rimborso sbagliato: passo dopo passo" },
    {
      type: "steps",
      items: [
        { title: "Confermare che sia davvero sbagliato prima di scalare", html: "Presentarsi con &ldquo;mi manca del denaro&rdquo; ottiene una risposta lenta e difensiva. Presentarsi con cifre e ID esatti ottiene azione. Aprite il vostro <strong class='text-white'>estratto conto o report delle transazioni in contanti</strong> e individuate la riga del rimborso o del prelievo, annotando l'importo esatto accreditato, la valuta e la data di valuta. Confrontatelo con la vostra richiesta originale. Recuperate il vostro <strong class='text-white'>estratto conto bancario o della carta</strong> per la voce corrispondente, poiché l'avviso della banca spesso elenca l'importo in entrata e le eventuali commissioni dedotte. Fate i conti: importo richiesto, meno le commissioni di bonifico/FX documentate, rispetto a quanto è arrivato. Se la differenza residua è piccola e corrisponde a commissioni note, potreste non avere un errore. Se è ampia e inspiegata, avete un caso reale." },
        { title: "Aprire un unico ticket di assistenza documentato", html: "Resistete all'impulso di inviare messaggi arrabbiati contemporaneamente via chat, e-mail e telefono. I contatti dispersi sono il modo in cui un caso si frammenta, ogni operatore vede una parte diversa e nessuno è responsabile dell'insieme. Scegliete un canale scritto, il ticket di assistenza, e rendetelo la vostra unica fonte di verità. Potete contattare l'assistenza Tradovate tramite la live chat integrata nella piattaforma, via e-mail a <strong class='text-white'>support@tradovate.com</strong>, per telefono al <strong class='text-white'>1 (844) 283-3100</strong>, oppure tramite il modulo di contatto dell'Help Center. Confermate prima i numeri e gli orari attuali sulla pagina di contatto ufficiale, poiché cambiano. In quel primo ticket, esponete tutto in un unico posto: un riepilogo in una riga, gli importi richiesto ed effettivo con le date, ogni ID di transazione, la discrepanza esatta e perché le commissioni non la spiegano, e una richiesta chiara." },
        { title: "Scalare al team Treasury e a un supervisore", html: "Qui è dove la maggior parte delle persone sbaglia: continuano a rispiegare il problema a qualsiasi operatore di prima linea risponda, e ciascuno azzera l'orologio. I prelievi sono gestiti dal <strong class='text-white'>team Treasury</strong> di Tradovate, e un prelievo può essere annullato o corretto solo da quel team, su richiesta. Scrivete qualcosa come: &ldquo;Vi prego di indirizzare questo al team Treasury, poiché si tratta di una correzione di prelievo, e fatelo esaminare da un supervisore.&rdquo; Per un rimborso di abbonamento o di costo della piattaforma anziché un pagamento dal conto di trading, chiedete invece della fatturazione. Due frasi pesano: &ldquo;vorrei che questo venisse scalato a un supervisore&rdquo; e &ldquo;vi prego di mantenere questo sul ticket numero ___.&rdquo;" },
        { title: "Sapere cosa fare se gli operatori smettono di rispondere", html: "Il silenzio è la parte difficile, ed è di solito il punto in cui le persone si arrendono. <strong class='text-white'>Consolidate, poi riportate in alto lo stesso thread</strong>, rispondete sul ticket esistente, citate i vostri ID di riferimento e chiedete uno stato e un responsabile nominato. <strong class='text-white'>Cambiate canale, mantenete il riferimento</strong>, se le risposte scritte si bloccano, passate alla live chat o al telefono durante l'orario lavorativo. <strong class='text-white'>Fissate e comunicate una scadenza</strong> per iscritto. <strong class='text-white'>Chiedete esplicitamente il percorso di reclamo o escalation</strong>. Usate una <strong class='text-white'>contestazione della carta solo come autentica ultima risorsa</strong>, solo dopo che l'assistenza ha avuto un'equa possibilità documentata, poiché un pagamento contestato può innescare un blocco del conto di trading durante l'indagine." },
      ],
    },
    { type: "heading", text: "Tabella di risoluzione dei problemi" },
    {
      type: "table",
      headers: ["Cosa vedete", "Cosa probabilmente significa", "Cosa fare"],
      rows: [
        ["Richiesta in dollari arrivata in euro/sterline/ecc.", "Conversione valutaria del bonifico internazionale lato ricevente", "Confermate il tasso di cambio con la vostra banca; scalate solo se il tasso è chiaramente sbagliato"],
        ["Importo inferiore di uno o due costi di bonifico", "Costi di gestione di banche intermediarie/corrispondenti", "Confrontate con l'avviso della banca; di solito è previsto, non un errore"],
        ["Prelievo bloccato su &ldquo;suspended&rdquo;", "Fondi in elaborazione per la conversione valutaria", "Attendete il periodo indicato; se viene superato, chiedete a Treasury di verificare"],
        ["Ammanco ampio e inspiegato", "Rimborso parziale, voce duplicata, o errore di elaborazione", "Documentate la differenza e scalate a Treasury con tutti gli ID"],
        ["Rimborso inferiore all'addebito originale", "Riconversione su una carta in valuta estera tra due date", "Confrontate entrambe le voci dell'estratto conto; segnalate alla fatturazione se la differenza è ampia"],
        ["Gli operatori rispondono una volta e poi tacciono", "Caso frammentato tra operatori", "Consolidate su un unico ticket, chiedete un supervisore, fissate una scadenza"],
      ],
    },
    { type: "heading", text: "Come evitare sorprese di rimborso e valuta la prossima volta" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Prelevate su un conto domestico nella stessa valuta quando potete.</strong> Meno conversioni e passaggi tra corrispondenti significano meno punti in cui la cifra può ridursi.",
        "<strong class='text-white'>Leggete prima le commissioni e i tempi del metodo.</strong> Bonifico, ACH e rimborsi con carta comportano ciascuno commissioni e finestre di regolamento diverse, così sapete come dovrebbe apparire un importo &ldquo;corretto&rdquo; prima che arrivi.",
        "<strong class='text-white'>Tenete un vostro registro.</strong> Annotate ogni richiesta con data, importo, valuta e ID di riferimento al momento dell'invio. Riconciliare in seguito è banale quando avete già la documentazione.",
        "<strong class='text-white'>Confermate che i dati di destinazione siano attuali e attivi</strong> prima di richiedere un pagamento, così nulla rimbalza su un conto non più valido.",
        "<strong class='text-white'>Agite rapidamente sugli errori evidenti.</strong> Poiché solo Treasury può annullare un prelievo, e solo su richiesta, individuare un importo sbagliato prima che il bonifico si regoli vi dà la migliore possibilità di una correzione pulita.",
      ],
    },
    { type: "heading", text: "Mantenete puliti i vostri registri con PickMyTrade" },
    { type: "paragraph", html: "PickMyTrade non può elaborare un rimborso del broker al posto vostro, e non finge di poterlo fare. Quello che fa è mantenere ordinato il lato trading della vostra documentazione, così quando emerge una domanda di fatturazione non dovete ricostruire nulla a memoria. I vostri ordini automatizzati passano attraverso un unico livello coerente, le vostre esecuzioni e la vostra cronologia restano in ordine, e il vostro abbonamento ha un prezzo fisso e trasparente senza conversioni a sorpresa. Quando il denaro che state inseguendo si trova dal lato del broker, registri di operazioni puliti e con timestamp dalla vostra parte rendono più facile vincere ogni escalation." },
  ] },
  ctaHeading: { en: "Automate Your Alerts on Transparent Pricing", de: "Automatisieren Sie Ihre Alerts zu transparenten Preisen", es: "Automatice sus alertas con precios transparentes", fr: "Automatisez vos alertes avec une tarification transparente", it: "Automatizzate i vostri alert con prezzi trasparenti" },
  ctaText: { en: "PickMyTrade keeps your trading side of the paper trail clean, flat pricing, no surprise conversions, so escalations are easier to win.", de: "PickMyTrade hält die Handelsseite Ihrer Belege sauber, mit Festpreisen und ohne überraschende Umrechnungen, damit Eskalationen leichter zu gewinnen sind.", es: "PickMyTrade mantiene limpio el lado de trading de su rastro documental, con precios fijos y sin conversiones sorpresa, para que las escaladas sean más fáciles de ganar.", fr: "PickMyTrade garde le volet trading de votre trace documentaire propre, avec un prix fixe et sans conversion surprise, pour que les escalades soient plus faciles à gagner.", it: "PickMyTrade mantiene pulito il lato trading della vostra documentazione, con prezzi fissi e senza conversioni a sorpresa, così le escalation sono più facili da vincere." },
  ctaButtonText: { en: "Start Your Free 7-Day Trial", de: "Starten Sie Ihre kostenlose 5-tägige Testversion", es: "Inicie su prueba gratuita de 5 días", fr: "Démarrez votre essai gratuit de 5 jours", it: "Avviate la vostra prova gratuita di 5 giorni" },
  ctaUrl: "https://app.pickmytrade.trade/?register=true&utm_source=content&utm_medium=debugging",
  faqHeading: { en: "Frequently Asked Questions", de: "Häufig gestellte Fragen", es: "Preguntas frecuentes", fr: "Questions fréquentes", it: "Domande frequenti" },
  faqs: { en: [
    { q: "Why did my refund arrive in a different currency than I requested?", a: "International wire withdrawals pass through currency conversion, so a USD payout can land in your local currency at the receiving bank's rate. A brief suspended status during that step is normal; a rate that's clearly off is what's worth escalating with your bank's confirmation in hand." },
    { q: "Why is the refunded amount smaller than what I requested?", a: "On international wires, intermediary and correspondent banks each deduct a handling fee before the money reaches you, with FX applied on top. A shortfall of a wire fee or two is expected; a large, unexplained gap is a red flag to document and escalate." },
    { q: "What does a suspended status on my withdrawal mean?", a: "For international wire withdrawals, a temporary suspended status generally means the funds are being processed for currency conversion. It's a normal step, not an outage. If it overruns the stated timeframe, ask the Treasury team to check the transfer." },
    { q: "Who handles refunds and withdrawals at Tradovate?", a: "Withdrawals go through the Treasury team, and only that team can cancel one, on request. Ask support to route the case to Treasury and state your request clearly. For a subscription or platform-fee refund, ask for billing instead." },
    { q: "Support stopped responding to my ticket. What should I do?", a: "Reply on the same ticket, restate your transaction IDs and the exact discrepancy, and ask directly for a supervisor. If written replies keep stalling, use live chat or the phone during business hours and quote your ticket number so it isn't treated as a new question." },
    { q: "Can a withdrawal be canceled once it's submitted?", a: "Only the Treasury team can cancel a withdrawal, and only on request, so move fast. If you catch a wrong amount or destination before the wire settles, contact support, ask to speak to an agent, and clearly state you want it canceled or corrected." },
    { q: "Should I dispute the charge with my bank or card issuer?", a: "Treat a chargeback as a last resort after support has had a fair, documented chance, since a disputed payment can lock a trading account while it's investigated. For a card refund that's provably wrong, your card issuer's dispute process is a legitimate fallback with your ticket history as evidence." },
  ], de: [
    { q: "Warum kam meine Rückerstattung in einer anderen Währung an, als ich beantragt hatte?", a: "Internationale Überweisungsauszahlungen durchlaufen eine Währungsumrechnung, sodass eine USD-Auszahlung zum Kurs der Empfängerbank in Ihrer Landeswährung ankommen kann. Ein kurzer Status &ldquo;suspended&rdquo; während dieses Schritts ist normal; eskalationswürdig ist ein Kurs, der eindeutig falsch ist, mit der Bestätigung Ihrer Bank in der Hand." },
    { q: "Warum ist der erstattete Betrag kleiner als der von mir beantragte?", a: "Bei internationalen Überweisungen ziehen Zwischen- und Korrespondenzbanken jeweils eine Bearbeitungsgebühr ab, bevor das Geld bei Ihnen ankommt, zusätzlich zur Währungsumrechnung. Eine Differenz von ein bis zwei Überweisungsgebühren ist zu erwarten; eine große, unerklärte Lücke ist ein Warnsignal, das zu dokumentieren und zu eskalieren ist." },
    { q: "Was bedeutet der Status \"suspended\" bei meiner Auszahlung?", a: "Bei internationalen Überweisungsauszahlungen bedeutet ein vorübergehender Status &ldquo;suspended&rdquo; im Allgemeinen, dass die Gelder für die Währungsumrechnung bearbeitet werden. Das ist ein normaler Schritt, keine Störung. Überschreitet er die angegebene Frist, bitten Sie das Treasury-Team, die Überweisung zu prüfen." },
    { q: "Wer bearbeitet Rückerstattungen und Auszahlungen bei Tradovate?", a: "Auszahlungen laufen über das Treasury-Team, und nur dieses Team kann eine Auszahlung auf Anfrage stornieren. Bitten Sie den Support, den Fall an Treasury weiterzuleiten, und formulieren Sie Ihre Bitte klar. Bei einer Rückerstattung für ein Abo oder eine Plattformgebühr fragen Sie stattdessen nach der Abrechnungsabteilung." },
    { q: "Der Support antwortet nicht mehr auf mein Ticket. Was soll ich tun?", a: "Antworten Sie auf demselben Ticket, wiederholen Sie Ihre Transaktions-IDs und die genaue Abweichung, und bitten Sie direkt um einen Vorgesetzten. Stocken schriftliche Antworten weiterhin, nutzen Sie während der Geschäftszeiten Live-Chat oder Telefon und nennen Sie Ihre Ticket-Nummer, damit es nicht als neue Frage behandelt wird." },
    { q: "Kann eine Auszahlung storniert werden, sobald sie eingereicht wurde?", a: "Nur das Treasury-Team kann eine Auszahlung stornieren, und nur auf Anfrage, also handeln Sie schnell. Entdecken Sie einen falschen Betrag oder ein falsches Ziel, bevor die Überweisung abgewickelt ist, kontaktieren Sie den Support, bitten Sie um ein Gespräch mit einem Mitarbeiter und erklären Sie klar, dass Sie die Stornierung oder Korrektur wünschen." },
    { q: "Sollte ich die Belastung bei meiner Bank oder meinem Kartenaussteller anfechten?", a: "Behandeln Sie eine Rückbuchung als letztes Mittel, nachdem der Support eine faire, dokumentierte Chance hatte, denn eine angefochtene Zahlung kann ein Handelskonto während der Prüfung sperren. Bei einer nachweislich falschen Kartenrückerstattung ist das Streitverfahren Ihres Kartenausstellers eine legitime Rückfalloption mit Ihrer Ticket-Historie als Beweis." },
  ], es: [
    { q: "¿Por qué mi reembolso llegó en una divisa distinta a la que solicité?", a: "Los retiros por transferencia internacional pasan por una conversión de divisa, así que un pago en USD puede llegar en su divisa local al tipo del banco receptor. Un breve estado suspended durante ese paso es normal; un tipo claramente equivocado es lo que merece escalarse con la confirmación de su banco en mano." },
    { q: "¿Por qué el importe reembolsado es menor de lo que solicité?", a: "En las transferencias internacionales, los bancos intermediarios y corresponsales descuentan cada uno una comisión de gestión antes de que el dinero llegue a usted, además del tipo de cambio aplicado. Un faltante de una o dos comisiones de transferencia es esperado; una brecha grande e inexplicada es una señal de alerta que hay que documentar y escalar." },
    { q: "¿Qué significa el estado suspended en mi retiro?", a: "En los retiros por transferencia internacional, un estado suspended temporal generalmente significa que los fondos se están procesando para la conversión de divisa. Es un paso normal, no una interrupción. Si excede el plazo indicado, pida al equipo de Treasury que revise la transferencia." },
    { q: "¿Quién gestiona los reembolsos y retiros en Tradovate?", a: "Los retiros pasan por el equipo de Treasury, y solo ese equipo puede cancelar uno, a petición. Pida al soporte que dirija el caso a Treasury y exprese su solicitud con claridad. Para un reembolso de suscripción o de tarifa de plataforma, pida hablar con facturación." },
    { q: "El soporte dejó de responder a mi ticket. ¿Qué debo hacer?", a: "Responda en el mismo ticket, reitere sus IDs de transacción y la discrepancia exacta, y pida directamente un supervisor. Si las respuestas escritas siguen estancadas, use el chat en vivo o el teléfono en horario laboral y cite su número de ticket para que no se trate como una pregunta nueva." },
    { q: "¿Se puede cancelar un retiro una vez enviado?", a: "Solo el equipo de Treasury puede cancelar un retiro, y solo a petición, así que actúe rápido. Si detecta un importe o destino incorrecto antes de que la transferencia se liquide, contacte con soporte, pida hablar con un agente y exprese claramente que desea que se cancele o corrija." },
    { q: "¿Debería impugnar el cargo ante mi banco o emisor de tarjeta?", a: "Trate una impugnación de cargo (chargeback) como último recurso, después de que el soporte haya tenido una oportunidad justa y documentada, ya que un pago impugnado puede bloquear una cuenta de trading mientras se investiga. Para un reembolso con tarjeta demostrablemente erróneo, el proceso de disputa de su emisor de tarjeta es un recurso legítimo, con el historial de su ticket como prueba." },
  ], fr: [
    { q: "Pourquoi mon remboursement est-il arrivé dans une devise différente de celle que j'ai demandée ?", a: "Les retraits par virement international passent par une conversion de devise, donc un versement en USD peut arriver dans votre devise locale au taux de la banque réceptrice. Un bref statut suspended pendant cette étape est normal ; un taux clairement erroné mérite d'être escaladé avec la confirmation de votre banque en main." },
    { q: "Pourquoi le montant remboursé est-il inférieur à ce que j'ai demandé ?", a: "Sur les virements internationaux, les banques intermédiaires et correspondantes déduisent chacune des frais de traitement avant que l'argent ne vous parvienne, avec le change appliqué en plus. Un manque d'un ou deux frais de virement est attendu ; un écart important et inexpliqué est un signal d'alerte à documenter et à escalader." },
    { q: "Que signifie le statut suspended sur mon retrait ?", a: "Pour les retraits par virement international, un statut suspended temporaire signifie généralement que les fonds sont en cours de traitement pour la conversion de devise. C'est une étape normale, pas une panne. S'il dépasse le délai indiqué, demandez à l'équipe Treasury de vérifier le virement." },
    { q: "Qui traite les remboursements et les retraits chez Tradovate ?", a: "Les retraits passent par l'équipe Treasury, et seule cette équipe peut en annuler un, sur demande. Demandez au support d'acheminer le dossier vers Treasury et formulez clairement votre demande. Pour un remboursement d'abonnement ou de frais de plateforme, demandez plutôt la facturation." },
    { q: "Le support a cessé de répondre à mon ticket. Que dois-je faire ?", a: "Répondez sur le même ticket, réaffirmez vos ID de transaction et l'écart exact, et demandez directement un superviseur. Si les réponses écrites continuent de stagner, utilisez le chat en direct ou le téléphone pendant les heures ouvrées et citez votre numéro de ticket pour qu'il ne soit pas traité comme une nouvelle question." },
    { q: "Un retrait peut-il être annulé une fois soumis ?", a: "Seule l'équipe Treasury peut annuler un retrait, et seulement sur demande, alors agissez vite. Si vous repérez un montant ou une destination incorrects avant que le virement ne soit réglé, contactez le support, demandez à parler à un agent et indiquez clairement que vous souhaitez qu'il soit annulé ou corrigé." },
