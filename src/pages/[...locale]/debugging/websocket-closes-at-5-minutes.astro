---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "websocket-closes-at-5-minutes";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/debugging/${SLUG}`;

const META_TITLE = "Tradovate WebSocket Closes at Exactly 5 Minutes";
const META_DESCRIPTION =
  "Tradovate WebSocket closes at exactly 5 minutes? Send heartbeat frames every 2.5 seconds and add reconnect logic to keep the connection alive.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate API", de: "Tradovate API", es: "Tradovate API", fr: "Tradovate API", it: "Tradovate API" },
  h1: { en: META_TITLE, de: "Tradovate-WebSocket schließt sich genau nach 5 Minuten", es: "El WebSocket de Tradovate se cierra exactamente a los 5 minutos", fr: "Le WebSocket Tradovate se ferme exactement au bout de 5 minutes", it: "Il WebSocket di Tradovate si chiude esattamente dopo 5 minuti" },
  dek: { en: "The socket streams perfectly for 300 seconds, then drops with no error and no warning. Here's what's really closing it, the heartbeat cadence that extends it, and the reconnect pattern that makes the drop a non-event.", de: "Der Socket streamt 300 Sekunden lang einwandfrei und bricht dann ohne Fehler und ohne Warnung ab. Hier erfahren Sie, was ihn wirklich schließt, welcher Heartbeat-Takt ihn verlängert und welches Reconnect-Muster den Abbruch zum Nicht-Ereignis macht.", es: "El socket transmite perfectamente durante 300 segundos y luego se cae sin error ni aviso. Esto es lo que realmente lo cierra, la cadencia de heartbeat que lo extiende y el patrón de reconexión que convierte la caída en algo irrelevante.", fr: "Le socket diffuse parfaitement pendant 300 secondes, puis tombe sans erreur ni avertissement. Voici ce qui le ferme réellement, la cadence de heartbeat qui le prolonge et le schéma de reconnexion qui fait de la coupure un non-événement.", it: "Il socket trasmette perfettamente per 300 secondi, poi cade senza errori e senza avvisi. Ecco cosa lo chiude davvero, la cadenza di heartbeat che lo prolunga e lo schema di riconnessione che trasforma la caduta in un non-evento." },
  readTime: { en: "8 min read", de: "8 Min. Lesezeit", es: "Lectura de 8 min", fr: "Lecture : 8 min", it: "Lettura di 8 min" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "When you're automating fast movers like ES or NQ, few things sting more than a Tradovate WebSocket that dies on a timer. You connect, authorize, subscribe to market data, and everything streams beautifully, right up until 300 seconds, when the socket drops with no error, no close reason, no warning. It's the same story every time: the connection closes at exactly 5 minutes, even when your heartbeats look like they're firing correctly. Two related errors usually tag along, a <strong class='text-white'>WebSocket is not open: readyState 0 (CONNECTING)</strong> exception when your code writes to a half-open socket, and a bare <strong class='text-white'>close code 1006</strong> (abnormal closure) from the remote peer. Here's what the 5-minute close actually means in 2026, the real causes behind it, and the exact heartbeat-plus-reconnect pattern that keeps the connection alive, plus how PickMyTrade runs this plumbing for you so a dropped socket never costs you a fill." },
    {
      type: "checklist",
      heading: "Quick Checklist for the 5-Minute WebSocket Close",
      items: [
        "<strong class='text-white'>Send a heartbeat roughly every 2.5 seconds</strong>, a frame whose text is an empty JSON array, <code>[]</code>. Skip it, and Tradovate closes the socket for inactivity.",
        "<strong class='text-white'>Don't trust setInterval in a browser tab</strong>, background tabs get throttled, your heartbeat slips past 2.5s, and the server hangs up.",
        "<strong class='text-white'>Send your own heartbeats</strong>, once real-time data starts flowing, the server stops sending them, so the client has to keep the rhythm going.",
        "<strong class='text-white'>Guard every send with a readyState check</strong>, only write when the socket is OPEN (1), never while it's still CONNECTING (0).",
        "<strong class='text-white'>Log the close event</strong>, <code>ws.addEventListener('close', e =&gt; console.log(e))</code> reveals the code (often 1006) and any reason.",
        "<strong class='text-white'>Assume drops will happen and reconnect</strong>, wrap the socket so a close automatically re-authorizes and resubscribes.",
      ],
    },
    { type: "heading", text: "What \"WebSocket Closes at Exactly 5 Minutes\" Means" },
    { type: "paragraph", html: "Tradovate's real-time API is a WebSocket connection: you open it, send an authorization frame, then subscribe to the data and events you care about. To keep that connection open, <strong class='text-white'>the client is responsible for sending heartbeats</strong>, small keep-alive frames, on a fixed cadence. Stop sending them and Tradovate treats the socket as idle, then closes it from the server side." },
    { type: "paragraph", html: "The reason the failure so often lands on a clean 5-minute mark is that timeouts along the network path, the server, a load balancer, or a proxy in between, tend to be enforced in round numbers. The connection disconnects every 5 minutes exactly (300 seconds) with no message, and tellingly, <strong class='text-white'>without heartbeats the drop happens after about 2 minutes instead.</strong> So heartbeats extend the life of the socket, but a lagging or missed heartbeat, or an independent idle timer somewhere on the path, can still guillotine it at 300 seconds. There's no published root cause for the exact-5-minute case, so the durable engineering answer isn't to prevent every close. It's to survive it." },
    { type: "paragraph", html: "The two error strings you'll see are symptoms of the same underlying problem. <strong class='text-white'>WebSocket is not open: readyState 0 (CONNECTING)</strong> means your code tried to send() before the handshake finished, common inside a heartbeat function that fires while the socket is mid-reconnect. <strong class='text-white'>Close code 1006</strong> is the browser or library's way of saying &ldquo;the connection dropped abnormally,&rdquo; with no clean close handshake, exactly what you get when a server-side idle timer cuts the line." },
    { type: "heading", text: "Top Causes of the 5-Minute WebSocket Close in 2026" },
    { type: "heading", text: "1. Heartbeat frames arriving late or missing entirely" },
    { type: "paragraph", html: "This is the number-one cause. Tradovate expects a heartbeat frame, text content <code>[]</code>, roughly every 2.5 seconds to prove the client is alive. Miss that window and the server starts the countdown to close. And here's the catch: <strong class='text-white'>once you start streaming real-time quotes, Tradovate's server stops sending its own heartbeats</strong>, so you can't lean on the connection's built-in traffic to hold it open. Your client has to send the empty-bracket frame on its own schedule." },
    { type: "heading", text: "2. Browser timer throttling (setInterval / setTimeout)" },
    { type: "paragraph", html: "If you schedule heartbeats with setInterval() or setTimeout() in a browser, you're at the mercy of the tab's priority. When the tab loses focus, Chrome (and most browsers) lower the priority of those timers, so a &ldquo;2.5-second&rdquo; interval can quietly stretch to several seconds. The heartbeat slips past the deadline and the socket closes, often right around the 5-minute mark, once enough lag piles up." },
    { type: "heading", text: "3. Server-side idle or session timeout" },
    { type: "paragraph", html: "Even a perfectly paced heartbeat can't override a timeout enforced upstream. A proxy, a gateway, or the Tradovate session itself may cap idle or total connection time, which is why the close lands on that suspiciously round 300-second boundary. Since this is outside your control, the fix is reconnection, not prevention." },
    { type: "heading", text: "4. Sending on a socket that is not OPEN (readyState 0)" },
    { type: "paragraph", html: "A WebSocket has four states: CONNECTING (0), OPEN (1), CLOSING (2), and CLOSED (3). If your heartbeat loop or order code calls send() while the socket is still at readyState 0, you get <strong class='text-white'>WebSocket is not open: readyState 0 (CONNECTING)</strong> and, often, a &ldquo;Disconnected from Tradovate Market WebSocket&rdquo; message right behind it. This one bites hardest in the instant after a drop, when your reconnect has spun up a new socket that hasn't finished its handshake yet." },
    { type: "heading", text: "5. Token expiry and long-lived connections" },
    { type: "paragraph", html: "A Tradovate access token has a limited lifetime, and these connections aren't built to live forever, hold a single socket open for very long stretches (over a day) and it tends to drop. If your token expires mid-session or the connection ages out, the socket closes and any re-authorization on the old token fails. Token lifetimes vary and change over time, so confirm the current values in Tradovate's API docs and refresh proactively instead of waiting for a failure." },
    { type: "heading", text: "How to Fix the 5-Minute WebSocket Close: Step-by-Step" },
    { type: "heading", text: "Fix 1: Send a Heartbeat Frame Roughly Every 2.5 Seconds" },
    { type: "paragraph", html: "The heartbeat is the foundation. On a cadence of about every 2.5 seconds, send a frame whose text is an empty JSON array:" },
    {
      type: "steps",
      items: [
        { title: "Start the keep-alive routine", html: "After the socket opens and you've authorized, start a keep-alive routine." },
        { title: "Send the empty-bracket frame", html: "On each tick, call <code>ws.send('[]')</code>, the empty-bracket frame is Tradovate's heartbeat." },
        { title: "Keep the interval under 2.5s", html: "Keep the interval comfortably under the limit (2.5 seconds is the target; a touch more often is safer than a touch less)." },
        { title: "Never assume server pings", html: "Never assume the server will ping you, after data starts streaming, it won't." },
      ],
    },
    { type: "heading", text: "Fix 2: Replace setInterval with a Timestamp Check or a Web Worker" },
    { type: "paragraph", html: "Because browser timers get throttled, don't lean on setInterval alone in a foreground or background tab. Two proven alternatives:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Timestamp-driven heartbeats.</strong> Record a timestamp (<code>new Date()</code>) each time you receive a message. Compare it against the last time you sent a heartbeat; if more than 2500ms has elapsed, send <code>[]</code> now. This reacts to real traffic instead of a timer the browser can starve.",
        "<strong class='text-white'>Move the timer off the main thread.</strong> Run the heartbeat inside a Web Worker, or run the whole connection as a Node.js service. Both sidestep browser tab throttling entirely, a Node process isn't subject to the background-tab penalty at all.",
      ],
    },
    { type: "heading", text: "Fix 3: Guard Every Send with a readyState Check" },
    { type: "paragraph", html: "Kill the readyState 0 error by never writing to a socket that isn't open:" },
    {
      type: "steps",
      items: [
        { title: "Check readyState before every send", html: "Before every send(), heartbeat or order, check <code>if (ws.readyState === WebSocket.OPEN)</code> (that's state 1)." },
        { title: "Skip and let reconnect logic take over", html: "If it's still CONNECTING (0) or already CLOSING/CLOSED, skip the send and let your reconnect logic take over." },
        { title: "Attach listeners for all state transitions", html: "Attach listeners for open, message, error, and close so state transitions are explicit, and log the close event object to capture the code and reason." },
      ],
    },
    { type: "heading", text: "Fix 4: Add Reconnect, Re-Authorize, and Resubscribe Logic" },
    { type: "paragraph", html: "Since some 5-minute closes are enforced upstream and can't be prevented, treat every drop as a recoverable error and rebuild automatically:" },
    {
      type: "steps",
      items: [
        { title: "Wrap the socket", html: "Wrap the socket in a class or function that owns its lifecycle, so one place is responsible for creating and tearing it down." },
        { title: "Reconnect on close", html: "On close, reconnect, open a fresh socket rather than trying to revive the dead one." },
        { title: "Re-authorize the new socket", html: "Re-authorize the new socket with a valid token (regenerate the token before it expires so a fresh one is always ready)." },
        { title: "Resubscribe to everything", html: "Resubscribe to everything you had, resend your user/syncrequest and re-subscribe to each market-data feed, because a new socket starts with no subscriptions." },
        { title: "Wait for OPEN before sending", html: "Wait for OPEN before sending anything on the new socket, and add a short backoff so a flapping connection doesn't hammer the server." },
      ],
    },
    { type: "heading", text: "Troubleshooting Table" },
    {
      type: "table",
      headers: ["Error / signal", "What it means", "Fix"],
      rows: [
        ["Socket closes at exactly 300s", "An idle or session timeout on the path cut the connection", "Send heartbeats every ~2.5s and auto-reconnect on close"],
        ["Drops after ~2 minutes", "No heartbeats are being sent at all", "Start a keep-alive that sends the [] frame on a 2.5s cadence"],
        ["WebSocket is not open: readyState 0 (CONNECTING)", "Code called send() before the handshake finished", "Only send when readyState === OPEN (1); skip otherwise"],
        ["Close code 1006", "Abnormal closure with no clean handshake", "Reconnect on close, re-authorize, and resubscribe"],
        ["\"Disconnected from Tradovate Market WebSocket\"", "The socket dropped mid-stream", "Rebuild the socket and restore your subscriptions"],
        ["Heartbeats fine but tab was inactive", "Browser throttled setInterval/setTimeout", "Use timestamp-based heartbeats or a Web Worker / Node.js"],
        ["Drop after very long uptime", "Token expired or the connection aged out", "Refresh the token before expiry and reconnect on a schedule"],
      ],
    },
    { type: "heading", text: "Prevent This with PickMyTrade" },
    { type: "paragraph", html: "PickMyTrade sits between your TradingView alerts and Tradovate and runs the WebSocket layer as a managed, server-side service, so the 5-minute close is handled before it ever reaches you:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Managed Heartbeats</strong>, sends the keep-alive frame on a reliable server-side cadence, with no browser tab to throttle the timer.",
        "<strong class='text-white'>Auto-Reconnect &amp; Re-Auth</strong>, detects a dropped socket, opens a fresh one, re-authorizes with a valid token, and resubscribes automatically.",
        "<strong class='text-white'>Connection-State Guards</strong>, only transmits when the socket is genuinely open, eliminating readyState 0 send errors.",
        "<strong class='text-white'>Multi-Account Sync</strong>, keeps every connected account's stream healthy so a single reconnect never leaves one account behind.",
      ],
    },
  ], de: [
    { type: "paragraph",html: "Beim Automatisieren schneller Werte wie ES oder NQ ärgert wenig mehr als ein Tradovate-WebSocket, der nach einem Timer stirbt. Sie verbinden sich, autorisieren, abonnieren Marktdaten, und alles streamt wunderbar, bis genau zu den 300 Sekunden, wenn der Socket ohne Fehler, ohne Close-Grund und ohne Warnung abbricht. Es ist jedes Mal dieselbe Geschichte: Die Verbindung schließt sich genau nach 5 Minuten, selbst wenn Ihre Heartbeats korrekt zu feuern scheinen. Meist treten zwei verwandte Fehler auf, eine Ausnahme <strong class='text-white'>WebSocket is not open: readyState 0 (CONNECTING)</strong>, wenn Ihr Code auf einen halb offenen Socket schreibt, und ein nackter <strong class='text-white'>Close-Code 1006</strong> (abnormaler Abbruch) von der Gegenstelle. Hier erfahren Sie, was das 5-Minuten-Schließen 2026 tatsächlich bedeutet, die wirklichen Ursachen dahinter und das genaue Heartbeat-plus-Reconnect-Muster, das die Verbindung am Leben hält, außerdem, wie PickMyTrade diese Infrastruktur für Sie betreibt, sodass ein abgebrochener Socket Sie nie einen Fill kostet." },
    {
      type: "checklist",
      heading: "Kurze Checkliste für das 5-Minuten-Schließen des WebSockets",
      items: [
        "<strong class='text-white'>Senden Sie etwa alle 2,5 Sekunden einen Heartbeat</strong>, einen Frame, dessen Text ein leeres JSON-Array ist, <code>[]</code>. Lassen Sie ihn aus, und Tradovate schließt den Socket wegen Inaktivität.",
        "<strong class='text-white'>Vertrauen Sie setInterval in einem Browser-Tab nicht</strong>, Hintergrund-Tabs werden gedrosselt, Ihr Heartbeat rutscht über 2,5 s hinaus, und der Server legt auf.",
        "<strong class='text-white'>Senden Sie Ihre eigenen Heartbeats</strong>, sobald Echtzeitdaten fließen, hört der Server auf, welche zu senden, der Client muss den Rhythmus also selbst halten.",
        "<strong class='text-white'>Sichern Sie jedes Senden mit einer readyState-Prüfung ab</strong>, schreiben Sie nur, wenn der Socket OPEN (1) ist, niemals solange er noch CONNECTING (0) ist.",
        "<strong class='text-white'>Protokollieren Sie das Close-Ereignis</strong>, <code>ws.addEventListener('close', e =&gt; console.log(e))</code> zeigt den Code (oft 1006) und einen etwaigen Grund.",
        "<strong class='text-white'>Gehen Sie davon aus, dass Abbrüche vorkommen, und verbinden Sie sich neu</strong>, kapseln Sie den Socket so, dass ein Schließen automatisch neu autorisiert und neu abonniert.",
      ],
    },
    { type: "heading",text: "Was „WebSocket schließt sich genau nach 5 Minuten“ bedeutet" },
    { type: "paragraph",html: "Die Echtzeit-API von Tradovate ist eine WebSocket-Verbindung: Sie öffnen sie, senden einen Autorisierungs-Frame und abonnieren dann die Daten und Ereignisse, die Sie interessieren. Damit die Verbindung offen bleibt, ist <strong class='text-white'>der Client dafür verantwortlich, Heartbeats zu senden</strong>, kleine Keep-Alive-Frames in einem festen Takt. Hören Sie damit auf, betrachtet Tradovate den Socket als im Leerlauf und schließt ihn serverseitig." },
    { type: "paragraph",html: "Dass der Ausfall so oft genau auf die 5-Minuten-Marke fällt, liegt daran, dass Timeouts entlang des Netzwerkpfads, beim Server, einem Load Balancer oder einem Proxy dazwischen, tendenziell in runden Zahlen durchgesetzt werden. Die Verbindung trennt sich genau alle 5 Minuten (300 Sekunden) ohne Meldung, und bezeichnenderweise <strong class='text-white'>erfolgt der Abbruch ohne Heartbeats stattdessen nach etwa 2 Minuten.</strong> Heartbeats verlängern also die Lebensdauer des Sockets, aber ein verspäteter oder ausgefallener Heartbeat oder ein unabhängiger Leerlauf-Timer irgendwo auf dem Pfad kann ihn dennoch bei 300 Sekunden guillotinieren. Es gibt keine veröffentlichte Grundursache für den exakten 5-Minuten-Fall, die dauerhafte technische Antwort lautet also nicht, jedes Schließen zu verhindern, sondern es zu überleben." },
    { type: "paragraph",html: "Die beiden Fehlermeldungen, die Sie sehen, sind Symptome desselben zugrunde liegenden Problems. <strong class='text-white'>WebSocket is not open: readyState 0 (CONNECTING)</strong> bedeutet, dass Ihr Code versuchte, send() aufzurufen, bevor der Handshake abgeschlossen war, häufig in einer Heartbeat-Funktion, die mitten in einer Neuverbindung feuert. <strong class='text-white'>Close-Code 1006</strong> ist die Art von Browser oder Bibliothek zu sagen: &ldquo;Die Verbindung ist abnormal abgebrochen&rdquo;, ohne sauberen Close-Handshake, genau das, was Sie erhalten, wenn ein serverseitiger Leerlauf-Timer die Leitung kappt." },
    { type: "heading",text: "Die häufigsten Ursachen für das 5-Minuten-Schließen des WebSockets 2026" },
    { type: "heading",text: "1. Heartbeat-Frames kommen verspätet oder fehlen ganz" },
    { type: "paragraph",html: "Das ist die Ursache Nummer eins. Tradovate erwartet etwa alle 2,5 Sekunden einen Heartbeat-Frame mit dem Textinhalt <code>[]</code>, um zu belegen, dass der Client lebt. Verpassen Sie dieses Fenster, startet der Server den Countdown zum Schließen. Und hier der Haken: <strong class='text-white'>Sobald Sie Echtzeitkurse streamen, hört der Tradovate-Server auf, eigene Heartbeats zu senden</strong>, Sie können sich also nicht auf den eingebauten Verkehr der Verbindung verlassen, um sie offen zu halten. Ihr Client muss den Frame mit den leeren Klammern nach eigenem Zeitplan senden." },
    { type: "heading",text: "2. Timer-Drosselung im Browser (setInterval / setTimeout)" },
    { type: "paragraph",html: "Wenn Sie Heartbeats mit setInterval() oder setTimeout() in einem Browser planen, sind Sie der Priorität des Tabs ausgeliefert. Verliert der Tab den Fokus, senken Chrome (und die meisten Browser) die Priorität dieser Timer, sodass sich ein &ldquo;2,5-Sekunden&rdquo;-Intervall unbemerkt auf mehrere Sekunden dehnen kann. Der Heartbeat verpasst die Frist und der Socket schließt sich, oft rund um die 5-Minuten-Marke, sobald genügend Verzögerung aufgelaufen ist." },
    { type: "heading",text: "3. Serverseitiges Leerlauf- oder Sitzungs-Timeout" },
    { type: "paragraph",html: "Selbst ein perfekt getakteter Heartbeat kann ein vorgelagert durchgesetztes Timeout nicht außer Kraft setzen. Ein Proxy, ein Gateway oder die Tradovate-Sitzung selbst kann die Leerlauf- oder Gesamtverbindungszeit begrenzen, weshalb der Abbruch auf die verdächtig runde 300-Sekunden-Grenze fällt. Da dies außerhalb Ihrer Kontrolle liegt, ist die Lösung die Wiederverbindung, nicht die Vorbeugung." },
    { type: "heading",text: "4. Senden auf einem Socket, der nicht OPEN ist (readyState 0)" },
    { type: "paragraph",html: "Ein WebSocket hat vier Zustände: CONNECTING (0), OPEN (1), CLOSING (2) und CLOSED (3). Ruft Ihre Heartbeat-Schleife oder Ihr Order-Code send() auf, während der Socket noch bei readyState 0 ist, erhalten Sie <strong class='text-white'>WebSocket is not open: readyState 0 (CONNECTING)</strong> und oft direkt dahinter eine Meldung &ldquo;Disconnected from Tradovate Market WebSocket&rdquo;. Das trifft am härtesten im Augenblick nach einem Abbruch, wenn Ihre Neuverbindung einen neuen Socket gestartet hat, der seinen Handshake noch nicht abgeschlossen hat." },
    { type: "heading",text: "5. Token-Ablauf und langlebige Verbindungen" },
    { type: "paragraph",html: "Ein Tradovate-Zugriffstoken hat eine begrenzte Lebensdauer, und diese Verbindungen sind nicht dafür gebaut, ewig zu leben, halten Sie einen einzelnen Socket sehr lange offen (über einen Tag), bricht er tendenziell ab. Läuft Ihr Token mitten in der Sitzung ab oder altert die Verbindung aus, schließt sich der Socket und jede erneute Autorisierung mit dem alten Token schlägt fehl. Token-Laufzeiten variieren und ändern sich im Lauf der Zeit, bestätigen Sie also die aktuellen Werte in der API-Dokumentation von Tradovate und erneuern Sie proaktiv, statt auf einen Fehler zu warten." },
    { type: "heading",text: "So beheben Sie das 5-Minuten-Schließen des WebSockets: Schritt für Schritt" },
    { type: "heading",text: "Lösung 1: Etwa alle 2,5 Sekunden einen Heartbeat-Frame senden" },
    { type: "paragraph",html: "Der Heartbeat ist die Grundlage. Senden Sie im Takt von etwa 2,5 Sekunden einen Frame, dessen Text ein leeres JSON-Array ist:" },
    {
      type: "steps",
      items: [
        { title: "Die Keep-Alive-Routine starten", html: "Starten Sie nach dem Öffnen des Sockets und der Autorisierung eine Keep-Alive-Routine." },
        { title: "Den Frame mit den leeren Klammern senden", html: "Rufen Sie bei jedem Takt <code>ws.send('[]')</code> auf, der Frame mit den leeren Klammern ist der Heartbeat von Tradovate." },
        { title: "Das Intervall unter 2,5 s halten", html: "Halten Sie das Intervall deutlich unter dem Limit (2,5 Sekunden ist das Ziel, etwas häufiger ist sicherer als etwas seltener)." },
        { title: "Nie auf Server-Pings vertrauen", html: "Gehen Sie nie davon aus, dass der Server Sie anpingt, nachdem Daten zu streamen begonnen haben, tut er es nicht." },
      ],
    },
    { type: "heading",text: "Lösung 2: setInterval durch eine Zeitstempelprüfung oder einen Web Worker ersetzen" },
    { type: "paragraph",html: "Da Browser-Timer gedrosselt werden, verlassen Sie sich nicht allein auf setInterval, weder in einem Vordergrund- noch in einem Hintergrund-Tab. Zwei bewährte Alternativen:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Zeitstempelgesteuerte Heartbeats.</strong> Speichern Sie bei jeder empfangenen Nachricht einen Zeitstempel (<code>new Date()</code>). Vergleichen Sie ihn mit dem Zeitpunkt, an dem Sie zuletzt einen Heartbeat gesendet haben; sind mehr als 2500 ms vergangen, senden Sie sofort <code>[]</code>. Das reagiert auf echten Verkehr statt auf einen Timer, den der Browser aushungern kann.",
        "<strong class='text-white'>Den Timer vom Hauptthread verlagern.</strong> Führen Sie den Heartbeat in einem Web Worker aus oder betreiben Sie die gesamte Verbindung als Node.js-Dienst. Beides umgeht die Tab-Drosselung des Browsers vollständig, ein Node-Prozess unterliegt der Hintergrund-Tab-Strafe überhaupt nicht.",
      ],
    },
    { type: "heading",text: "Lösung 3: Jedes Senden mit einer readyState-Prüfung absichern" },
    { type: "paragraph",html: "Beseitigen Sie den readyState-0-Fehler, indem Sie nie auf einen Socket schreiben, der nicht offen ist:" },
    {
      type: "steps",
      items: [
        { title: "readyState vor jedem Senden prüfen", html: "Prüfen Sie vor jedem send(), ob Heartbeat oder Order, <code>if (ws.readyState === WebSocket.OPEN)</code> (das ist Zustand 1)." },
        { title: "Überspringen und die Reconnect-Logik übernehmen lassen", html: "Ist er noch CONNECTING (0) oder bereits CLOSING/CLOSED, überspringen Sie das Senden und lassen Sie Ihre Reconnect-Logik übernehmen." },
        { title: "Listener für alle Zustandsübergänge anhängen", html: "Hängen Sie Listener für open, message, error und close an, damit Zustandsübergänge explizit sind, und protokollieren Sie das Close-Ereignisobjekt, um Code und Grund zu erfassen." },
      ],
    },
    { type: "heading",text: "Lösung 4: Reconnect-, Re-Authorize- und Resubscribe-Logik hinzufügen" },
    { type: "paragraph",html: "Da einige 5-Minuten-Abbrüche vorgelagert erzwungen werden und nicht verhindert werden können, behandeln Sie jeden Abbruch als behebbaren Fehler und bauen Sie automatisch neu auf:" },
    {
      type: "steps",
      items: [
        { title: "Den Socket kapseln", html: "Kapseln Sie den Socket in einer Klasse oder Funktion, die seinen Lebenszyklus besitzt, sodass eine einzige Stelle für Erzeugung und Abbau verantwortlich ist." },
        { title: "Beim Schließen neu verbinden", html: "Verbinden Sie sich beim Schließen neu, öffnen Sie einen frischen Socket, statt zu versuchen, den toten wiederzubeleben." },
        { title: "Den neuen Socket neu autorisieren", html: "Autorisieren Sie den neuen Socket mit einem gültigen Token neu (erzeugen Sie das Token vor Ablauf neu, damit immer ein frisches bereitsteht)." },
        { title: "Alles neu abonnieren", html: "Abonnieren Sie alles neu, was Sie hatten, senden Sie Ihren user/syncrequest erneut und abonnieren Sie jeden Marktdaten-Feed neu, denn ein neuer Socket beginnt ohne Abonnements." },
        { title: "Vor dem Senden auf OPEN warten", html: "Warten Sie auf OPEN, bevor Sie irgendetwas auf dem neuen Socket senden, und fügen Sie ein kurzes Backoff hinzu, damit eine flatternde Verbindung den Server nicht bombardiert." },
      ],
    },
    { type: "heading",text: "Tabelle zur Fehlerbehebung" },
    { type: "table", headers: ["Fehler / Signal","Was es bedeutet","Lösung"], rows: [
      ["Socket schließt sich genau nach 300 s","Ein Leerlauf- oder Sitzungs-Timeout auf dem Pfad hat die Verbindung gekappt","Heartbeats etwa alle 2,5 s senden und beim Schließen automatisch neu verbinden"],
      ["Abbruch nach ca. 2 Minuten","Es werden überhaupt keine Heartbeats gesendet","Eine Keep-Alive-Routine starten, die den []-Frame im 2,5-s-Takt sendet"],
      ["WebSocket is not open: readyState 0 (CONNECTING)","Code hat send() aufgerufen, bevor der Handshake abgeschlossen war","Nur senden, wenn readyState === OPEN (1); sonst überspringen"],
      ["Close-Code 1006","Abnormaler Abbruch ohne sauberen Handshake","Beim Schließen neu verbinden, neu autorisieren und neu abonnieren"],
      ["„Disconnected from Tradovate Market WebSocket“","Der Socket ist mitten im Stream abgebrochen","Den Socket neu aufbauen und Ihre Abonnements wiederherstellen"],
      ["Heartbeats in Ordnung, aber Tab war inaktiv","Browser hat setInterval/setTimeout gedrosselt","Zeitstempelbasierte Heartbeats oder einen Web Worker / Node.js verwenden"],
      ["Abbruch nach sehr langer Laufzeit","Token abgelaufen oder Verbindung gealtert","Das Token vor Ablauf erneuern und planmäßig neu verbinden"],
