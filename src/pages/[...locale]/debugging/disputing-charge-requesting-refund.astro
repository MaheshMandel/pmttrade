---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "disputing-charge-requesting-refund";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/debugging/${SLUG}`;

const META_TITLE = "How to Dispute a Tradovate Charge / Get a Refund";
const META_DESCRIPTION =
  "Disputing a charge or want a refund? Contact billing with proof first, because a bank chargeback can freeze your futures account under the dispute terms.";

// Short SEO title (<=60 chars) for locales where the shared h1 is too long for a SERP title.
const TITLE_OVERRIDE: Partial<Record<Locale, string>> = { de: "Tradovate-Abbuchung bestreiten und Rückerstattung erhalten", fr: "Tradovate : contester un débit et obtenir un remboursement" };

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "So bestreiten Sie eine Tradovate-Abbuchung / erhalten eine Rückerstattung", es: "Cómo impugnar un cargo de Tradovate y obtener un reembolso", fr: "Comment contester un débit Tradovate et obtenir un remboursement", it: "Come contestare un addebito Tradovate e ottenere un rimborso" },
  dek: { en: "A bank chargeback feels like the fast lane, but on a brokerage it's the move most likely to lock you out of your own account. Here's how to identify the charge, request a refund the right way, and when a chargeback is actually worth the risk.", de: "Eine Rückbuchung bei der Bank fühlt sich wie der schnelle Weg an, ist aber bei einem Broker der Schritt, der am wahrscheinlichsten dazu führt, dass Sie aus Ihrem eigenen Konto ausgesperrt werden. Hier erfahren Sie, wie Sie die Abbuchung identifizieren, eine Rückerstattung richtig beantragen, und wann eine Rückbuchung das Risiko tatsächlich wert ist.", es: "Una devolución de cargo bancario parece el camino rápido, pero en una correduría es la medida con más probabilidades de dejarlo fuera de su propia cuenta. Aquí le explicamos cómo identificar el cargo, solicitar un reembolso de la forma correcta, y cuándo una devolución de cargo realmente vale el riesgo.", fr: "Un rétrofacturation bancaire semble être la voie rapide, mais chez un courtier, c'est le geste le plus susceptible de vous exclure de votre propre compte. Voici comment identifier le débit, demander un remboursement de la bonne manière, et quand une rétrofacturation vaut réellement le risque.", it: "Uno storno bancario sembra la scorciatoia, ma presso un broker è la mossa più probabile a farvi rimanere esclusi dal vostro stesso account. Ecco come identificare l'addebito, richiedere un rimborso nel modo corretto, e quando uno storno vale davvero il rischio." },
  readTime: { en: "9 min read", de: "9 Minuten Lesezeit", es: "Lectura de 9 minutos", fr: "Lecture de 9 minutes", it: "Lettura di 9 minuti" },
  lastUpdated: "2026-07-09",
  blocks: { en: [
    { type: "paragraph", html: "You check your card statement, spot a Tradovate charge you didn't expect, and your first instinct is to fire off a dispute with your bank. Slow down. A bank chargeback feels like the fast lane, but on a brokerage it's the move most likely to lock you out of your own account. The smarter path is almost always to contact billing directly, with proof in hand, and give them a chance to fix it. This guide covers how to figure out what you were actually charged for, how to request a refund the right way, and the account risk of jumping straight to your bank. It applies to standard Tradovate accounts and, with one important exception, to prop-firm evaluations billed through Tradovate too." },
    {
      type: "checklist",
      heading: "Quick Checklist Before You Dispute Anything",
      items: [
        "<strong class='text-white'>Identify the exact charge first.</strong> Note the date, the amount, and the descriptor on your statement before you decide it's wrong. Half of &ldquo;mystery&rdquo; charges are documented fees.",
        "<strong class='text-white'>Screenshot everything.</strong> The statement line, your plan page, and any confirmation email. Proof is what turns a refund request into a quick yes.",
        "<strong class='text-white'>Cancel the recurring plan</strong> if you don't want to be billed again, so a second charge doesn't land while you're still sorting out the first.",
        "<strong class='text-white'>Contact billing directly before your bank.</strong> Email, the support portal, or phone. A written ticket gives you a paper trail.",
        "<strong class='text-white'>Know who owns the charge.</strong> If it came from a prop firm, the firm handles the refund, not Tradovate.",
        "<strong class='text-white'>Hold the chargeback in reserve.</strong> It stays available if support stalls, but filing it early can freeze the account.",
      ],
    },
    { type: "heading", text: "First, Figure Out What You Were Actually Charged For" },
    { type: "paragraph", html: "Before you call anything a mistake, pin down the charge. Trading platforms bill for more things than most people track, and a &ldquo;surprise&rdquo; charge is often a fee you agreed to when you opened the account. Getting this right matters, because a correctly applied fee won't be refunded just because you forgot about it, and knowing the charge type tells you exactly who to talk to." },
    { type: "paragraph", html: "Here are the usual suspects behind an unexpected Tradovate charge:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Monthly plan subscription.</strong> If you're on a paid monthly plan, it renews automatically until you cancel. A charge right around your signup anniversary is almost always the renewal.",
        "<strong class='text-white'>Free-plan admin fees.</strong> The commission-free plan carries inactivity and maintenance fees that bill when the account sits idle past a set window. It catches people who assumed &ldquo;free&rdquo; meant &ldquo;no charges ever.&rdquo;",
        "<strong class='text-white'>Liquidation fee.</strong> When a position gets auto-flattened for breaching margin, a per-event liquidation fee can hit the account, sometimes with no warning.",
        "<strong class='text-white'>Market-data subscriptions.</strong> Real-time exchange data (CME and others) bills monthly and renews on its own until you cancel the data subscription specifically.",
        "<strong class='text-white'>Prop-firm evaluation or reset fee.</strong> Buying an eval, a reset, or an activation through a funding firm is billed by that firm. On your statement it may still read like a platform charge.",
      ],
    },
    { type: "paragraph", html: "Once you can name the charge, matching it to the fee schedule for your plan is quick. If the number lines up with a published fee, you're looking at a documented charge, and your best move is to prevent the next one, not dispute the last one. If it doesn't line up, or you were billed after cancelling, or you see the same charge twice, you have a genuine refund case worth raising." },
    { type: "heading", text: "Why to Contact Support Before Filing a Chargeback" },
    { type: "paragraph", html: "This is the part that saves accounts. A chargeback isn't a complaint, it's your bank forcibly clawing money back from the merchant, and brokerages treat it as a serious event. When a payment dispute lands, the common response is an automatic hold: the disputed account, and frequently every account linked to it, gets blocked or suspended while the dispute plays out. For an evaluation or funded account, that can mean the eval is over. You could win the chargeback and still lose access to the account you were trying to protect." },
    { type: "paragraph", html: "The platform terms are built around resolving things directly first. Tradovate's user agreement sets a 60-day window to work a dispute out informally after you send written notice, before either side escalates to formal arbitration, and it caps how long you have to bring a claim at all. Translated into plain terms: they expect you to raise the issue with them, in writing, and give them a fair chance to make it right. A bank chargeback skips that step entirely and can put you offside on the very agreement you'd need on your side if things get contentious." },
    { type: "paragraph", html: "None of this means you can never dispute through your bank. It means the order of operations matters. Support first, chargeback last. If billing genuinely ignores a legitimate, well-documented request, the chargeback is still there. But most refundable charges, a double bill, a post-cancellation renewal, a clear error, get resolved faster and cleaner with a ticket than with a fight." },
    { type: "heading", text: "How to Request a Refund the Right Way: Step-by-Step" },
    { type: "heading", text: "Step 1: Build your proof" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Grab the statement line.</strong> Screenshot the charge showing the date, amount, and merchant descriptor.",
        "<strong class='text-white'>Pull your account records.</strong> Open your account reports or billing history and capture the matching (or missing) entry. If you cancelled, find the cancellation confirmation email and note its timestamp.",
        "<strong class='text-white'>Write the one-line reason.</strong> &ldquo;Charged $X on [date] after cancelling on [earlier date],&rdquo; or &ldquo;billed twice for the same plan on [date].&rdquo; A tight, factual summary gets you a faster yes than a long complaint.",
      ],
    },
    { type: "heading", text: "Step 2: Cancel the recurring plan so it can't bill again" },
    { type: "paragraph", html: "If you don't intend to keep paying, cancel before the next renewal so a fresh charge doesn't land mid-dispute. Cancellation lives in your account dashboard, in the Settings area under the plan or subscription section. Turn off auto-renewal for the specific item, whether that's the monthly plan or a market-data subscription, since those are billed and cancelled separately. One key point: cancelling stops future charges but doesn't automatically refund one that already posted. You usually keep access until the end of the period you already paid for." },
    { type: "heading", text: "Step 3: Open a billing ticket with support" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Use an official channel.</strong> Email support@tradovate.com, submit a request through the support portal at support.tradovate.com, or call the support line at 1-844-283-3100 (also reachable at 312-283-3100). A written ticket is best because it timestamps your request and starts that dispute clock in your favor.",
        "<strong class='text-white'>State the ask plainly.</strong> Attach your screenshots, give the charge date and amount, and ask directly for a refund or reversal. Don't bury the request.",
        "<strong class='text-white'>Keep the thread.</strong> Save the ticket number and every reply. If you ever do need a chargeback later, this record is the evidence that you tried to resolve it directly.",
      ],
    },
    { type: "heading", text: "Step 4: If it's a prop-firm charge, go to the firm" },
    { type: "paragraph", html: "This is the exception that trips people up. If the charge was for a prop-firm evaluation, reset, or activation, the firm billed you and the firm controls the refund, even though the platform is Tradovate. Send your request to the firm's billing or support team, not to Tradovate, and check the firm's own refund policy first. Refund windows, non-refundable activation fees, and dispute terms vary by firm and account size, so confirm your firm's current rules rather than assuming. Filing a bank chargeback against a prop firm is especially risky, since it commonly blocks every account you hold with them at once." },
    { type: "heading", text: "The Chargeback: A Real Last Resort" },
    { type: "paragraph", html: "If you've documented a legitimate charge, asked billing directly, and been refused unfairly, a chargeback is a legitimate tool, just go in with eyes open. Your bank or card network has its own filing window, often around 60 days from the statement date but it varies by issuer, so don't sit on it. Bring the same proof you sent support, plus the support thread showing you tried to resolve it first. And accept the trade-off: filing it will very likely freeze the associated account and possibly close a prop evaluation, so only pull this lever when you've already decided you're done with that account or you have no other option." },
    { type: "heading", text: "Charge Type &rarr; Who to Contact &rarr; What to Do" },
    {
      type: "table",
      headers: ["Charge on your statement", "What it usually is", "Your move"],
      rows: [
        ["Recurring monthly amount near signup anniversary", "Auto-renewing paid plan subscription", "Cancel in Settings > Plans, then ask billing to refund if it was in error"],
        ["Small fee after the account sat idle", "Free-plan inactivity / maintenance fee", "Check the fee schedule; documented fees generally aren't refunded, so prevent the next one"],
        ["Fee right after a position was force-closed", "Per-event liquidation fee", "Verify it matches the liquidation policy; keep a margin buffer to avoid repeats"],
        ["Monthly data charge", "Real-time market-data subscription", "Cancel the data subscription specifically; it's separate from the plan"],
        ["Eval, reset, or activation charge", "Prop-firm billing, not Tradovate", "Contact the prop firm's billing team under its refund policy"],
        ["Same charge twice, or a charge after cancelling", "Genuine billing error", "Open a support ticket with proof and request a reversal"],
      ],
    },
    { type: "heading", text: "Cut Down on Surprise Charges" },
    { type: "paragraph", html: "A refund fight is a bad way to spend a trading day, and a good chunk of disputed charges are avoidable. Inactivity fees hit dormant accounts. Liquidation fees hit positions that ran past their margin. Both come from an account being under-managed rather than from a billing glitch. Keeping your strategy running and your risk watched removes a lot of those triggers. That's where automation earns its keep:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Consistent activity</strong>, routing your TradingView alerts to Tradovate keeps the account trading on schedule instead of drifting into an idle-fee window.",
        "<strong class='text-white'>Hands-off risk exits</strong>, automated stops and targets fire on every position, so trades close on your terms rather than getting force-liquidated into a fee.",
        "<strong class='text-white'>One clear subscription</strong>, PickMyTrade billing is month-to-month and you cancel anytime from your dashboard, so there's no tangle of renewals to dispute later.",
        "<strong class='text-white'>A clean paper trail</strong>, every order is logged, which makes reconciling any charge against real activity straightforward.",
      ],
    },
    { type: "paragraph", html: "Automation can't refund a fee that already posted, and it won't override a prop firm's rules. But fewer idle accounts and cleaner exits mean fewer charges to argue about in the first place." },
  ], de: [
    { type: "paragraph", html: "Sie prüfen Ihren Kartenauszug, entdecken eine unerwartete Tradovate-Abbuchung, und Ihr erster Instinkt ist, sofort eine Rückbuchung bei Ihrer Bank einzureichen. Bremsen Sie ab. Eine Rückbuchung bei der Bank fühlt sich wie der schnelle Weg an, ist aber bei einem Broker der Schritt, der am wahrscheinlichsten dazu führt, dass Sie aus Ihrem eigenen Konto ausgesperrt werden. Der klügere Weg ist fast immer, sich direkt an die Buchhaltung zu wenden, mit Nachweisen in der Hand, und ihr die Chance zu geben, es zu beheben. Dieser Leitfaden erklärt, wie Sie herausfinden, wofür Sie tatsächlich belastet wurden, wie Sie eine Rückerstattung richtig beantragen, und das Kontorisiko, wenn Sie direkt zu Ihrer Bank gehen. Er gilt für Standard-Tradovate-Konten und, mit einer wichtigen Ausnahme, auch für Prop-Firm-Evaluierungen, die über Tradovate abgerechnet werden." },
    {
      type: "checklist",
      heading: "Schnelle Checkliste, bevor Sie etwas bestreiten",
      items: [
        "<strong class='text-white'>Identifizieren Sie zuerst die genaue Abbuchung.</strong> Notieren Sie sich Datum, Betrag und Bezeichnung auf Ihrem Kontoauszug, bevor Sie entscheiden, dass sie falsch ist. Die Hälfte der &ldquo;mysteriösen&rdquo; Abbuchungen sind dokumentierte Gebühren.",
        "<strong class='text-white'>Machen Sie von allem Screenshots.</strong> Die Kontoauszugszeile, Ihre Plan-Seite und jede Bestätigungs-E-Mail. Nachweise sind es, die eine Rückerstattungsanfrage zu einem schnellen Ja machen.",
        "<strong class='text-white'>Kündigen Sie den wiederkehrenden Plan,</strong> wenn Sie nicht erneut belastet werden möchten, damit keine zweite Abbuchung erfolgt, während Sie die erste noch klären.",
        "<strong class='text-white'>Kontaktieren Sie die Buchhaltung direkt, bevor Sie zu Ihrer Bank gehen.</strong> E-Mail, das Support-Portal oder Telefon. Ein schriftliches Ticket gibt Ihnen eine nachvollziehbare Dokumentation.",
        "<strong class='text-white'>Wissen Sie, wem die Abbuchung gehört.</strong> Stammt sie von einer Prop-Firma, kümmert sich diese Firma um die Rückerstattung, nicht Tradovate.",
        "<strong class='text-white'>Halten Sie die Rückbuchung als Reserve bereit.</strong> Sie bleibt verfügbar, falls der Support blockiert, aber sie zu früh einzureichen, kann das Konto sperren.",
      ],
    },
    { type: "heading", text: "Finden Sie zunächst heraus, wofür Sie tatsächlich belastet wurden" },
    { type: "paragraph", html: "Bevor Sie irgendetwas als Fehler bezeichnen, klären Sie die Abbuchung. Handelsplattformen berechnen für mehr Dinge, als die meisten Menschen im Blick behalten, und eine &ldquo;überraschende&rdquo; Abbuchung ist oft eine Gebühr, der Sie bei der Kontoeröffnung zugestimmt haben. Das richtig zu klären ist wichtig, denn eine korrekt angewandte Gebühr wird nicht erstattet, nur weil Sie sie vergessen haben, und die Kenntnis der Abbuchungsart sagt Ihnen genau, an wen Sie sich wenden müssen." },
    { type: "paragraph", html: "Hier sind die üblichen Verdächtigen hinter einer unerwarteten Tradovate-Abbuchung:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Monatliches Plan-Abonnement.</strong> Wenn Sie einen kostenpflichtigen monatlichen Plan haben, verlängert er sich automatisch, bis Sie kündigen. Eine Abbuchung genau um Ihr Anmeldejubiläum herum ist fast immer die Verlängerung.",
        "<strong class='text-white'>Verwaltungsgebühren beim kostenlosen Plan.</strong> Der provisionsfreie Plan hat Inaktivitäts- und Wartungsgebühren, die abgebucht werden, wenn das Konto über ein festgelegtes Zeitfenster hinaus ungenutzt bleibt. Das erwischt Leute, die annahmen, &ldquo;kostenlos&rdquo; bedeute &ldquo;nie irgendwelche Abbuchungen&rdquo;.",
        "<strong class='text-white'>Liquidationsgebühr.</strong> Wenn eine Position wegen Margin-Überschreitung automatisch glattgestellt wird, kann eine ereignisbezogene Liquidationsgebühr das Konto belasten, manchmal ohne Vorwarnung.",
        "<strong class='text-white'>Marktdaten-Abonnements.</strong> Echtzeit-Börsendaten (CME und andere) werden monatlich abgerechnet und verlängern sich von selbst, bis Sie das Datenabonnement gezielt kündigen.",
        "<strong class='text-white'>Prop-Firm-Evaluierungs- oder Reset-Gebühr.</strong> Der Kauf einer Evaluierung, eines Resets oder einer Aktivierung über eine Funding-Firma wird von dieser Firma in Rechnung gestellt. Auf Ihrem Kontoauszug kann das dennoch wie eine Plattformabbuchung aussehen.",
      ],
    },
    { type: "paragraph", html: "Sobald Sie die Abbuchung benennen können, ist es schnell erledigt, sie mit dem Gebührenplan Ihres Plans abzugleichen. Stimmt die Zahl mit einer veröffentlichten Gebühr überein, handelt es sich um eine dokumentierte Abbuchung, und Ihr bester Schritt ist, die nächste zu verhindern, nicht die letzte zu bestreiten. Stimmt sie nicht überein, oder wurden Sie nach der Kündigung belastet, oder sehen Sie dieselbe Abbuchung zweimal, haben Sie einen echten Rückerstattungsfall, den es sich zu melden lohnt." },
    { type: "heading", text: "Warum Sie den Support kontaktieren sollten, bevor Sie eine Rückbuchung einreichen" },
    { type: "paragraph", html: "Das ist der Teil, der Konten rettet. Eine Rückbuchung ist keine Beschwerde, sondern Ihre Bank, die dem Händler zwangsweise Geld zurückholt, und Broker behandeln das als ernstes Ereignis. Landet ein Zahlungsstreit, ist die übliche Reaktion eine automatische Sperre: Das betroffene Konto, und oft jedes damit verknüpfte Konto, wird blockiert oder ausgesetzt, während der Streit läuft. Bei einem Evaluierungs- oder finanzierten Konto kann das bedeuten, dass die Evaluierung vorbei ist. Sie könnten die Rückbuchung gewinnen und trotzdem den Zugang zu dem Konto verlieren, das Sie schützen wollten." },
    { type: "paragraph", html: "Die Plattformbedingungen sind darauf ausgelegt, Dinge zunächst direkt zu lösen. Tradovates Nutzungsvereinbarung sieht ein Fenster von 60 Tagen vor, um einen Streit nach schriftlicher Mitteilung informell zu klären, bevor eine Seite zur formellen Schlichtung eskaliert, und sie begrenzt auch, wie lange Sie überhaupt Zeit haben, einen Anspruch geltend zu machen. Auf einfache Worte gebracht: Man erwartet, dass Sie das Problem schriftlich bei ihnen ansprechen und ihnen eine faire Chance geben, es zu beheben. Eine Rückbuchung bei der Bank überspringt diesen Schritt vollständig und kann Sie ausgerechnet mit der Vereinbarung ins Unrecht setzen, die Sie auf Ihrer Seite bräuchten, falls es strittig wird." },
    { type: "paragraph", html: "Nichts davon bedeutet, dass Sie nie über Ihre Bank bestreiten können. Es bedeutet, dass die Reihenfolge wichtig ist. Zuerst Support, Rückbuchung zuletzt. Wenn die Buchhaltung eine legitime, gut dokumentierte Anfrage tatsächlich ignoriert, steht die Rückbuchung immer noch zur Verfügung. Aber die meisten erstattungsfähigen Abbuchungen – eine Doppelbelastung, eine Verlängerung nach der Kündigung, ein klarer Fehler – werden mit einem Ticket schneller und sauberer gelöst als mit einem Streit." },
    { type: "heading", text: "So beantragen Sie eine Rückerstattung richtig: Schritt für Schritt" },
    { type: "heading", text: "Schritt 1: Ihre Nachweise zusammenstellen" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Erfassen Sie die Kontoauszugszeile.</strong> Machen Sie einen Screenshot der Abbuchung mit Datum, Betrag und Händlerbezeichnung.",
        "<strong class='text-white'>Ziehen Sie Ihre Kontounterlagen heran.</strong> Öffnen Sie Ihre Kontoberichte oder Abrechnungshistorie und erfassen Sie den passenden (oder fehlenden) Eintrag. Wenn Sie gekündigt haben, suchen Sie die Kündigungsbestätigungs-E-Mail und notieren Sie deren Zeitstempel.",
        "<strong class='text-white'>Formulieren Sie den Grund in einer Zeile.</strong> &ldquo;$X am [Datum] belastet, nachdem am [früheres Datum] gekündigt wurde&rdquo;, oder &ldquo;am [Datum] zweimal für denselben Plan belastet&rdquo;. Eine knappe, sachliche Zusammenfassung führt schneller zu einem Ja als eine lange Beschwerde.",
      ],
    },
    { type: "heading", text: "Schritt 2: Den wiederkehrenden Plan kündigen, damit er nicht erneut abbucht" },
    { type: "paragraph", html: "Wenn Sie nicht weiter zahlen möchten, kündigen Sie vor der nächsten Verlängerung, damit keine neue Abbuchung mitten im Streitfall erfolgt. Die Kündigung finden Sie in Ihrem Konto-Dashboard, im Bereich Einstellungen unter dem Plan- oder Abonnement-Bereich. Deaktivieren Sie die automatische Verlängerung für das jeweilige Element, egal ob es sich um den monatlichen Plan oder ein Marktdaten-Abonnement handelt, da diese getrennt abgerechnet und gekündigt werden. Ein wichtiger Punkt: Die Kündigung stoppt zukünftige Abbuchungen, erstattet aber nicht automatisch eine bereits gebuchte Abbuchung. In der Regel behalten Sie den Zugang bis zum Ende des bereits bezahlten Zeitraums." },
    { type: "heading", text: "Schritt 3: Ein Abrechnungsticket beim Support eröffnen" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Nutzen Sie einen offiziellen Kanal.</strong> E-Mail an support@tradovate.com, eine Anfrage über das Support-Portal unter support.tradovate.com, oder Anruf bei der Support-Hotline unter 1-844-283-3100 (auch erreichbar unter 312-283-3100). Ein schriftliches Ticket ist am besten, da es Ihre Anfrage mit Zeitstempel versieht und die Streitfrist zu Ihren Gunsten in Gang setzt.",
        "<strong class='text-white'>Formulieren Sie Ihre Bitte klar.</strong> Fügen Sie Ihre Screenshots bei, nennen Sie Abbuchungsdatum und -betrag, und bitten Sie direkt um eine Rückerstattung oder Stornierung. Verstecken Sie die Bitte nicht.",
        "<strong class='text-white'>Bewahren Sie den Verlauf auf.</strong> Speichern Sie die Ticketnummer und jede Antwort. Sollten Sie später doch eine Rückbuchung benötigen, ist diese Aufzeichnung der Nachweis, dass Sie versucht haben, es direkt zu lösen.",
      ],
    },
    { type: "heading", text: "Schritt 4: Bei einer Prop-Firm-Abbuchung wenden Sie sich an die Firma" },
    { type: "paragraph", html: "Das ist die Ausnahme, die Leute ins Straucheln bringt. Wenn die Abbuchung für eine Prop-Firm-Evaluierung, einen Reset oder eine Aktivierung war, hat die Firma Sie belastet, und die Firma kontrolliert die Rückerstattung, auch wenn die Plattform Tradovate ist. Senden Sie Ihre Anfrage an das Abrechnungs- oder Support-Team der Firma, nicht an Tradovate, und prüfen Sie zuerst die eigene Rückerstattungsrichtlinie der Firma. Rückerstattungsfristen, nicht erstattungsfähige Aktivierungsgebühren und Streitbedingungen unterscheiden sich je nach Firma und Kontogröße, prüfen Sie also die aktuellen Regeln Ihrer Firma, statt es anzunehmen. Eine Rückbuchung bei der Bank gegen eine Prop-Firma ist besonders riskant, da sie üblicherweise alle Konten blockiert, die Sie bei ihr haben, und zwar gleichzeitig." },
    { type: "heading", text: "Die Rückbuchung: ein echtes letztes Mittel" },
    { type: "paragraph", html: "Wenn Sie eine legitime Abbuchung dokumentiert, die Buchhaltung direkt gefragt haben und unfair abgelehnt wurden, ist eine Rückbuchung ein legitimes Mittel – gehen Sie nur mit offenen Augen hinein. Ihre Bank oder Ihr Kartennetzwerk hat eine eigene Einreichungsfrist, oft rund 60 Tage ab dem Kontoauszugsdatum, aber das variiert je nach Aussteller, warten Sie also nicht zu lange. Bringen Sie dieselben Nachweise mit, die Sie an den Support geschickt haben, plus den Support-Verlauf, der zeigt, dass Sie es zuerst direkt lösen wollten. Und akzeptieren Sie den Kompromiss: Das Einreichen wird höchstwahrscheinlich das zugehörige Konto einfrieren und möglicherweise eine Prop-Evaluierung beenden, ziehen Sie diesen Hebel also nur, wenn Sie bereits entschieden haben, mit diesem Konto abzuschließen, oder Sie keine andere Option haben." },
    { type: "heading", text: "Abbuchungsart &rarr; Wen kontaktieren &rarr; Was zu tun ist" },
    {
      type: "table",
      headers: ["Abbuchung auf Ihrem Kontoauszug", "Was es normalerweise ist", "Ihr nächster Schritt"],
      rows: [
        ["Wiederkehrender monatlicher Betrag nahe dem Anmeldejubiläum", "Automatisch verlängertes kostenpflichtiges Plan-Abonnement", "In Einstellungen > Pläne kündigen, dann bei der Buchhaltung um Rückerstattung bitten, falls es ein Fehler war"],
        ["Kleine Gebühr, nachdem das Konto inaktiv war", "Inaktivitäts-/Wartungsgebühr des kostenlosen Plans", "Gebührenplan prüfen; dokumentierte Gebühren werden in der Regel nicht erstattet, verhindern Sie also die nächste"],
        ["Gebühr direkt nach zwangsweiser Schließung einer Position", "Ereignisbezogene Liquidationsgebühr", "Prüfen, ob sie mit der Liquidationsrichtlinie übereinstimmt; einen Margin-Puffer halten, um Wiederholungen zu vermeiden"],
        ["Monatliche Datengebühr", "Echtzeit-Marktdaten-Abonnement", "Das Datenabonnement gezielt kündigen; es ist getrennt vom Plan"],
        ["Abbuchung für Evaluierung, Reset oder Aktivierung", "Abrechnung der Prop-Firma, nicht Tradovate", "Das Abrechnungsteam der Prop-Firma gemäß deren Rückerstattungsrichtlinie kontaktieren"],
        ["Dieselbe Abbuchung zweimal, oder eine Abbuchung nach Kündigung", "Echter Abrechnungsfehler", "Ein Support-Ticket mit Nachweisen eröffnen und eine Stornierung beantragen"],
      ],
    },
    { type: "heading", text: "Überraschende Abbuchungen reduzieren" },
    { type: "paragraph", html: "Ein Streit um eine Rückerstattung ist eine schlechte Art, einen Handelstag zu verbringen, und ein guter Teil der strittigen Abbuchungen ist vermeidbar. Inaktivitätsgebühren treffen ruhende Konten. Liquidationsgebühren treffen Positionen, die über ihre Margin hinausliefen. Beides entsteht durch ein unzureichend verwaltetes Konto, nicht durch einen Abrechnungsfehler. Wenn Ihre Strategie läuft und Ihr Risiko im Blick behalten wird, entfällt ein Großteil dieser Auslöser. Genau hier zahlt sich Automatisierung aus:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Konsequente Aktivität</strong> – das Weiterleiten Ihrer TradingView-Alerts an Tradovate hält das Konto planmäßig handelnd, statt in ein Inaktivitätsgebühren-Fenster abzudriften.",
        "<strong class='text-white'>Risikoausstiege ohne Zutun</strong> – automatisierte Stops und Ziele lösen bei jeder Position aus, sodass Trades zu Ihren Bedingungen schließen, statt zwangsweise in eine Gebühr liquidiert zu werden.",
        "<strong class='text-white'>Ein klares Abonnement</strong> – die Abrechnung von PickMyTrade erfolgt monatlich, und Sie können jederzeit über Ihr Dashboard kündigen, sodass später kein Gewirr von Verlängerungen zu bestreiten ist.",
        "<strong class='text-white'>Eine lückenlose Dokumentation</strong> – jede Order wird protokolliert, was den Abgleich jeder Abbuchung mit der tatsächlichen Aktivität einfach macht.",
      ],
    },
    { type: "paragraph", html: "Automatisierung kann eine bereits gebuchte Gebühr nicht erstatten und hebelt nicht die Regeln einer Prop-Firma aus. Aber weniger inaktive Konten und sauberere Ausstiege bedeuten von vornherein weniger Abbuchungen, über die man streiten muss." },
  ], es: [
    { type: "paragraph", html: "Revisa el estado de su tarjeta, detecta un cargo de Tradovate que no esperaba, y su primer instinto es disparar una disputa con su banco. Frene. Una devolución de cargo bancario parece el camino rápido, pero en una correduría es la medida con más probabilidades de dejarlo fuera de su propia cuenta. El camino más inteligente es casi siempre contactar directamente a facturación, con pruebas en mano, y darles la oportunidad de solucionarlo. Esta guía cubre cómo averiguar por qué se le cobró realmente, cómo solicitar un reembolso de la forma correcta, y el riesgo para la cuenta de acudir directamente a su banco. Aplica a las cuentas estándar de Tradovate y, con una excepción importante, también a las evaluaciones de prop firm facturadas a través de Tradovate." },
    {
      type: "checklist",
      heading: "Lista de verificación rápida antes de impugnar algo",
      items: [
        "<strong class='text-white'>Identifique primero el cargo exacto.</strong> Anote la fecha, el monto y la descripción en su estado de cuenta antes de decidir que está mal. La mitad de los cargos &ldquo;misteriosos&rdquo; son comisiones documentadas.",
        "<strong class='text-white'>Capture todo en pantalla.</strong> La línea del estado de cuenta, la página de su plan y cualquier correo de confirmación. La prueba es lo que convierte una solicitud de reembolso en un sí rápido.",
        "<strong class='text-white'>Cancele el plan recurrente</strong> si no quiere que le vuelvan a cobrar, para que no llegue un segundo cargo mientras todavía está resolviendo el primero.",
        "<strong class='text-white'>Contacte a facturación directamente antes que a su banco.</strong> Correo electrónico, el portal de soporte o teléfono. Un ticket por escrito le proporciona un rastro documental.",
        "<strong class='text-white'>Sepa a quién pertenece el cargo.</strong> Si provino de una prop firm, es la firma quien gestiona el reembolso, no Tradovate.",
        "<strong class='text-white'>Mantenga la devolución de cargo en reserva.</strong> Sigue disponible si soporte se estanca, pero presentarla demasiado pronto puede congelar la cuenta.",
      ],
    },
    { type: "heading", text: "Primero, averigüe por qué se le cobró realmente" },
    { type: "paragraph", html: "Antes de calificar algo como un error, precise el cargo. Las plataformas de trading cobran por más cosas de las que la mayoría de la gente controla, y un cargo &ldquo;sorpresa&rdquo; suele ser una comisión que aceptó al abrir la cuenta. Aclarar esto es importante, porque una comisión correctamente aplicada no se reembolsará solo porque se olvidó de ella, y saber el tipo de cargo le dice exactamente con quién hablar." },
    { type: "paragraph", html: "Estos son los sospechosos habituales detrás de un cargo inesperado de Tradovate:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Suscripción al plan mensual.</strong> Si tiene un plan mensual de pago, se renueva automáticamente hasta que lo cancele. Un cargo justo alrededor de su aniversario de registro es casi siempre la renovación.",
        "<strong class='text-white'>Comisiones administrativas del plan gratuito.</strong> El plan sin comisiones tiene comisiones por inactividad y mantenimiento que se cobran cuando la cuenta permanece inactiva más allá de una ventana establecida. Sorprende a quienes asumieron que &ldquo;gratis&rdquo; significaba &ldquo;sin cargos nunca&rdquo;.",
        "<strong class='text-white'>Comisión de liquidación.</strong> Cuando una posición se cierra automáticamente por incumplir el margen, una comisión de liquidación por evento puede afectar la cuenta, a veces sin previo aviso.",
        "<strong class='text-white'>Suscripciones de datos de mercado.</strong> Los datos de bolsa en tiempo real (CME y otros) se facturan mensualmente y se renuevan por sí solos hasta que cancele específicamente la suscripción de datos.",
        "<strong class='text-white'>Comisión de evaluación o reinicio de una prop firm.</strong> Comprar una evaluación, un reinicio o una activación a través de una firma de financiamiento es facturado por esa firma. En su estado de cuenta puede seguir apareciendo como un cargo de la plataforma.",
      ],
    },
    { type: "paragraph", html: "Una vez que puede nombrar el cargo, compararlo con el listado de comisiones de su plan es rápido. Si el número coincide con una comisión publicada, está ante un cargo documentado, y su mejor movimiento es prevenir el siguiente, no impugnar el último. Si no coincide, o le cobraron después de cancelar, o ve el mismo cargo dos veces, tiene un caso genuino de reembolso que vale la pena plantear." },
    { type: "heading", text: "Por qué contactar a soporte antes de presentar una devolución de cargo" },
    { type: "paragraph", html: "Esta es la parte que salva cuentas. Una devolución de cargo no es una queja, es su banco recuperando forzosamente el dinero del comerciante, y las correduías lo tratan como un evento serio. Cuando llega una disputa de pago, la respuesta habitual es una retención automática: la cuenta en disputa, y con frecuencia cada cuenta vinculada a ella, se bloquea o suspende mientras se resuelve la disputa. Para una cuenta de evaluación o financiada, eso puede significar que la evaluación se termine. Podría ganar la devolución de cargo y aun así perder el acceso a la cuenta que intentaba proteger." },
    { type: "paragraph", html: "Las condiciones de la plataforma están construidas para resolver primero las cosas directamente. El acuerdo de usuario de Tradovate establece una ventana de 60 días para resolver una disputa de manera informal después de enviar aviso por escrito, antes de que cualquiera de las partes escale a un arbitraje formal, y también limita el tiempo que tiene para presentar una reclamación. Traducido a términos simples: esperan que plantee el problema con ellos, por escrito, y les dé una oportunidad justa de solucionarlo. Una devolución de cargo bancaria se salta ese paso por completo y puede ponerlo en falta respecto al mismo acuerdo que necesitaría a su favor si las cosas se vuelven conflictivas." },
    { type: "paragraph", html: "Nada de esto significa que nunca pueda impugnar a través de su banco. Significa que el orden de las operaciones importa. Soporte primero, devolución de cargo al final. Si facturación realmente ignora una solicitud legítima y bien documentada, la devolución de cargo sigue estando disponible. Pero la mayoría de los cargos reembolsables, un doble cobro, una renovación tras la cancelación, un error claro, se resuelven más rápido y de forma más limpia con un ticket que con una pelea." },
    { type: "heading", text: "Cómo solicitar un reembolso de la forma correcta: paso a paso" },
    { type: "heading", text: "Paso 1: reúna sus pruebas" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Capture la línea del estado de cuenta.</strong> Haga una captura de pantalla del cargo mostrando la fecha, el monto y la descripción del comerciante.",
        "<strong class='text-white'>Reúna sus registros de cuenta.</strong> Abra sus informes de cuenta o historial de facturación y capture la entrada coincidente (o faltante). Si canceló, encuentre el correo de confirmación de cancelación y anote su marca de tiempo.",
        "<strong class='text-white'>Escriba el motivo en una línea.</strong> &ldquo;Cargo de $X el [fecha] tras cancelar el [fecha anterior]&rdquo;, o &ldquo;facturado dos veces por el mismo plan el [fecha]&rdquo;. Un resumen conciso y factual le consigue un sí más rápido que una queja larga.",
      ],
    },
    { type: "heading", text: "Paso 2: cancele el plan recurrente para que no vuelva a cobrar" },
    { type: "paragraph", html: "Si no tiene intención de seguir pagando, cancele antes de la próxima renovación para que no llegue un nuevo cargo en medio de la disputa. La cancelación se encuentra en el panel de su cuenta, en el área de Configuración, bajo la sección de planes o suscripción. Desactive la renovación automática del elemento específico, ya sea el plan mensual o una suscripción de datos de mercado, ya que se facturan y cancelan por separado. Un punto clave: cancelar detiene los cargos futuros pero no reembolsa automáticamente uno que ya se registró. Normalmente conserva el acceso hasta el final del período que ya pagó." },
    { type: "heading", text: "Paso 3: abra un ticket de facturación con soporte" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Use un canal oficial.</strong> Envíe un correo a support@tradovate.com, envíe una solicitud a través del portal de soporte en support.tradovate.com, o llame a la línea de soporte al 1-844-283-3100 (también accesible al 312-283-3100). Un ticket por escrito es lo mejor porque marca la fecha y hora de su solicitud y pone en marcha ese plazo de disputa a su favor.",
        "<strong class='text-white'>Exponga la solicitud con claridad.</strong> Adjunte sus capturas de pantalla, indique la fecha y el monto del cargo, y pida directamente un reembolso o reversión. No esconda la solicitud.",
        "<strong class='text-white'>Conserve el hilo.</strong> Guarde el número de ticket y cada respuesta. Si más adelante necesita una devolución de cargo, este registro es la evidencia de que intentó resolverlo directamente.",
      ],
    },
    { type: "heading", text: "Paso 4: si es un cargo de una prop firm, acuda a la firma" },
    { type: "paragraph", html: "Esta es la excepción que confunde a la gente. Si el cargo fue por una evaluación, reinicio o activación de una prop firm, la firma le cobró y la firma controla el reembolso, aunque la plataforma sea Tradovate. Envíe su solicitud al equipo de facturación o soporte de la firma, no a Tradovate, y consulte primero la propia política de reembolso de la firma. Los plazos de reembolso, las comisiones de activación no reembolsables y los términos de disputa varían según la firma y el tamaño de la cuenta, así que confirme las reglas actuales de su firma en lugar de suponerlas. Presentar una devolución de cargo bancaria contra una prop firm es especialmente arriesgado, ya que comúnmente bloquea todas las cuentas que tiene con ella a la vez." },
    { type: "heading", text: "La devolución de cargo: un verdadero último recurso" },
    { type: "paragraph", html: "Si ha documentado un cargo legítimo, preguntado directamente a facturación, y sido rechazado injustamente, una devolución de cargo es una herramienta legítima, solo entre con los ojos abiertos. Su banco o red de tarjetas tiene su propio plazo de presentación, a menudo alrededor de 60 días desde la fecha del estado de cuenta, pero varía según el emisor, así que no lo deje pasar. Aporte las mismas pruebas que envió a soporte, más el hilo de soporte que muestra que intentó resolverlo primero. Y acepte la contrapartida: presentarla muy probablemente congelará la cuenta asociada y posiblemente cierre una evaluación de prop firm, así que active esta palanca solo cuando ya haya decidido que ha terminado con esa cuenta o no tenga otra opción." },
    { type: "heading", text: "Tipo de cargo &rarr; A quién contactar &rarr; Qué hacer" },
    {
      type: "table",
      headers: ["Cargo en su estado de cuenta", "Qué es normalmente", "Su siguiente paso"],
      rows: [
        ["Monto mensual recurrente cerca del aniversario de registro", "Suscripción de plan de pago con renovación automática", "Cancele en Configuración > Planes, luego pida a facturación un reembolso si fue un error"],
        ["Pequeña comisión tras la inactividad de la cuenta", "Comisión de inactividad/mantenimiento del plan gratuito", "Revise el listado de comisiones; las comisiones documentadas generalmente no se reembolsan, así que evite la siguiente"],
        ["Comisión justo después del cierre forzoso de una posición", "Comisión de liquidación por evento", "Verifique que coincida con la política de liquidación; mantenga un colchón de margen para evitar repeticiones"],
        ["Cargo mensual de datos", "Suscripción de datos de mercado en tiempo real", "Cancele específicamente la suscripción de datos; es independiente del plan"],
        ["Cargo de evaluación, reinicio o activación", "Facturación de la prop firm, no de Tradovate", "Contacte al equipo de facturación de la prop firm según su política de reembolso"],
        ["El mismo cargo dos veces, o un cargo después de cancelar", "Error de facturación genuino", "Abra un ticket de soporte con pruebas y solicite una reversión"],
      ],
    },
    { type: "heading", text: "Reduzca los cargos sorpresa" },
    { type: "paragraph", html: "Una pelea por un reembolso es una mala forma de pasar un día de trading, y una buena parte de los cargos impugnados son evitables. Las comisiones por inactividad afectan a las cuentas inactivas. Las comisiones de liquidación afectan a las posiciones que superaron su margen. Ambas provienen de una cuenta mal gestionada, no de un fallo de facturación. Mantener su estrategia en funcionamiento y su riesgo vigilado elimina muchos de esos desencadenantes. Ahí es donde la automatización demuestra su valor:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Actividad constante</strong>, enrutar sus alertas de TradingView a Tradovate mantiene la cuenta operando según lo programado en lugar de derivar en una ventana de comisión por inactividad.",
        "<strong class='text-white'>Salidas de riesgo sin intervención manual</strong>, los stops y objetivos automatizados se activan en cada posición, así que las operaciones se cierran en sus términos en lugar de ser liquidadas forzosamente en una comisión.",
        "<strong class='text-white'>Una suscripción clara</strong>, la facturación de PickMyTrade es mes a mes y puede cancelar en cualquier momento desde su panel, así que no hay un enredo de renovaciones que impugnar más tarde.",
        "<strong class='text-white'>Un rastro documental limpio</strong>, cada orden queda registrada, lo que hace sencillo conciliar cualquier cargo con la actividad real.",
      ],
    },
    { type: "paragraph", html: "La automatización no puede reembolsar una comisión ya registrada, y no anula las reglas de una prop firm. Pero menos cuentas inactivas y salidas más limpias significan menos cargos por los que discutir desde el principio." },
  ], fr: [
    { type: "paragraph", html: "Vous vérifiez le relevé de votre carte, repérez un débit Tradovate que vous n'attendiez pas, et votre premier réflexe est de déclencher une contestation auprès de votre banque. Ralentissez. Une rétrofacturation bancaire semble être la voie rapide, mais chez un courtier, c'est le geste le plus susceptible de vous exclure de votre propre compte. La voie la plus intelligente consiste presque toujours à contacter directement la facturation, preuves en main, et à leur donner une chance de corriger le problème. Ce guide explique comment déterminer ce pour quoi vous avez réellement été débité, comment demander un remboursement de la bonne manière, et le risque pour le compte de vous adresser directement à votre banque. Il s'applique aux comptes Tradovate standard et, avec une exception importante, aux évaluations prop firm facturées via Tradovate également." },
    {
      type: "checklist",
      heading: "Liste de contrôle rapide avant de contester quoi que ce soit",
      items: [
        "<strong class='text-white'>Identifiez d'abord le débit exact.</strong> Notez la date, le montant et le libellé sur votre relevé avant de décider qu'il est erroné. La moitié des débits &laquo;&nbsp;mystères&nbsp;&raquo; sont des frais documentés.",
        "<strong class='text-white'>Faites une capture d'écran de tout.</strong> La ligne du relevé, la page de votre plan, et tout e-mail de confirmation. La preuve est ce qui transforme une demande de remboursement en un oui rapide.",
        "<strong class='text-white'>Annulez le plan récurrent</strong> si vous ne voulez plus être facturé, afin qu'un second débit n'arrive pas pendant que vous réglez encore le premier.",
        "<strong class='text-white'>Contactez directement la facturation avant votre banque.</strong> E-mail, portail d'assistance, ou téléphone. Un ticket écrit vous fournit une trace documentée.",
        "<strong class='text-white'>Sachez à qui appartient le débit.</strong> S'il provient d'une prop firm, c'est la firme qui gère le remboursement, pas Tradovate.",
        "<strong class='text-white'>Gardez la rétrofacturation en réserve.</strong> Elle reste disponible si le support traîne, mais la déposer trop tôt peut geler le compte.",
      ],
    },
    { type: "heading", text: "D'abord, déterminez ce pour quoi vous avez réellement été débité" },
    { type: "paragraph", html: "Avant de qualifier quoi que ce soit d'erreur, cernez le débit. Les plateformes de trading facturent plus de choses que la plupart des gens ne le suivent, et un débit &laquo;&nbsp;surprise&nbsp;&raquo; est souvent des frais que vous avez acceptés à l'ouverture du compte. Bien cerner cela compte, car des frais correctement appliqués ne seront pas remboursés simplement parce que vous les aviez oubliés, et connaître le type de débit vous indique exactement à qui vous adresser." },
    { type: "paragraph", html: "Voici les suspects habituels derrière un débit Tradovate inattendu :" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Abonnement au plan mensuel.</strong> Si vous êtes sur un plan mensuel payant, il se renouvelle automatiquement jusqu'à ce que vous l'annuliez. Un débit juste autour de votre anniversaire d'inscription est presque toujours le renouvellement.",
        "<strong class='text-white'>Frais administratifs du plan gratuit.</strong> Le plan sans commission comporte des frais d'inactivité et de maintenance facturés lorsque le compte reste inactif au-delà d'une période définie. Cela surprend les personnes qui pensaient que &laquo;&nbsp;gratuit&nbsp;&raquo; signifiait &laquo;&nbsp;aucuns frais, jamais&nbsp;&raquo;.",
        "<strong class='text-white'>Frais de liquidation.</strong> Lorsqu'une position est automatiquement clôturée pour non-respect de la marge, des frais de liquidation par événement peuvent frapper le compte, parfois sans avertissement.",
        "<strong class='text-white'>Abonnements aux données de marché.</strong> Les données d'échange en temps réel (CME et autres) sont facturées mensuellement et se renouvellent d'elles-mêmes jusqu'à ce que vous annuliez spécifiquement l'abonnement de données.",
        "<strong class='text-white'>Frais d'évaluation ou de réinitialisation d'une prop firm.</strong> L'achat d'une évaluation, d'une réinitialisation ou d'une activation auprès d'une firme de financement est facturé par cette firme. Sur votre relevé, cela peut toujours ressembler à un débit de la plateforme.",
      ],
    },
    { type: "paragraph", html: "Une fois que vous pouvez nommer le débit, le faire correspondre au barème de frais de votre plan est rapide. Si le montant correspond à des frais publiés, vous avez affaire à un débit documenté, et votre meilleure décision est d'empêcher le prochain, pas de contester le dernier. S'il ne correspond pas, ou si vous avez été facturé après l'annulation, ou si vous voyez le même débit deux fois, vous avez un dossier de remboursement légitime qui mérite d'être soulevé." },
    { type: "heading", text: "Pourquoi contacter le support avant de déposer une rétrofacturation" },
    { type: "paragraph", html: "Voici la partie qui sauve les comptes. Une rétrofacturation n'est pas une plainte, c'est votre banque qui récupère de force l'argent auprès du commerçant, et les courtiers la traitent comme un événement sérieux. Lorsqu'un litige de paiement arrive, la réponse habituelle est un blocage automatique : le compte concerné, et souvent tout compte lié, est bloqué ou suspendu pendant que le litige se déroule. Pour un compte d'évaluation ou financé, cela peut signifier la fin de l'évaluation. Vous pourriez gagner la rétrofacturation et perdre quand même l'accès au compte que vous essayiez de protéger." },
    { type: "paragraph", html: "Les conditions de la plateforme sont conçues pour d'abord résoudre les choses directement. Le contrat d'utilisateur de Tradovate prévoit une fenêtre de 60 jours pour régler un différend à l'amiable après l'envoi d'un avis écrit, avant que l'une ou l'autre partie n'escalade vers un arbitrage formel, et il limite également le délai dont vous disposez pour introduire une réclamation. Traduit simplement : ils s'attendent à ce que vous souleviez le problème avec eux, par écrit, et leur donniez une chance équitable de le résoudre. Une rétrofacturation bancaire saute entièrement cette étape et peut vous mettre en porte-à-faux vis-à-vis de l'accord même dont vous auriez besoin de votre côté si les choses deviennent litigieuses." },
    { type: "paragraph", html: "Rien de tout cela ne signifie que vous ne pouvez jamais contester via votre banque. Cela signifie que l'ordre des opérations compte. Le support d'abord, la rétrofacturation en dernier. Si la facturation ignore réellement une demande légitime et bien documentée, la rétrofacturation reste disponible. Mais la plupart des débits remboursables, une double facturation, un renouvellement après annulation, une erreur claire, se résolvent plus vite et plus proprement avec un ticket qu'avec un conflit." },
    { type: "heading", text: "Comment demander un remboursement de la bonne manière : étape par étape" },
    { type: "heading", text: "Étape 1 : constituez vos preuves" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Récupérez la ligne du relevé.</strong> Faites une capture d'écran du débit montrant la date, le montant et le libellé du commerçant.",
        "<strong class='text-white'>Récupérez vos relevés de compte.</strong> Ouvrez vos rapports de compte ou votre historique de facturation et capturez l'entrée correspondante (ou manquante). Si vous avez annulé, retrouvez l'e-mail de confirmation d'annulation et notez son horodatage.",
        "<strong class='text-white'>Rédigez la raison en une ligne.</strong> &laquo;&nbsp;Débité de X $ le [date] après avoir annulé le [date antérieure]&nbsp;&raquo;, ou &laquo;&nbsp;facturé deux fois pour le même plan le [date]&nbsp;&raquo;. Un résumé concis et factuel vous obtient un oui plus rapide qu'une longue plainte.",
      ],
    },
    { type: "heading", text: "Étape 2 : annulez le plan récurrent pour qu'il ne puisse plus facturer" },
    { type: "paragraph", html: "Si vous n'avez pas l'intention de continuer à payer, annulez avant le prochain renouvellement afin qu'un nouveau débit n'arrive pas en pleine contestation. L'annulation se trouve dans le tableau de bord de votre compte, dans la section Paramètres, sous la rubrique plan ou abonnement. Désactivez le renouvellement automatique pour l'élément spécifique, qu'il s'agisse du plan mensuel ou d'un abonnement de données de marché, car ceux-ci sont facturés et annulés séparément. Un point clé : l'annulation arrête les débits futurs mais ne rembourse pas automatiquement un débit déjà comptabilisé. Vous conservez généralement l'accès jusqu'à la fin de la période déjà payée." },
    { type: "heading", text: "Étape 3 : ouvrez un ticket de facturation auprès du support" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Utilisez un canal officiel.</strong> E-mail à support@tradovate.com, soumettez une demande via le portail d'assistance sur support.tradovate.com, ou appelez la ligne d'assistance au 1-844-283-3100 (également joignable au 312-283-3100). Un ticket écrit est préférable car il horodate votre demande et déclenche ce délai de contestation en votre faveur.",
        "<strong class='text-white'>Formulez clairement votre demande.</strong> Joignez vos captures d'écran, indiquez la date et le montant du débit, et demandez directement un remboursement ou une annulation. N'enfouissez pas la demande.",
        "<strong class='text-white'>Conservez le fil de discussion.</strong> Enregistrez le numéro de ticket et chaque réponse. Si vous avez plus tard besoin d'une rétrofacturation, cette trace est la preuve que vous avez essayé de le résoudre directement.",
      ],
    },
    { type: "heading", text: "Étape 4 : s'il s'agit d'un débit prop firm, adressez-vous à la firme" },
    { type: "paragraph", html: "C'est l'exception qui déstabilise les gens. Si le débit concernait une évaluation, une réinitialisation ou une activation prop firm, c'est la firme qui vous a facturé et c'est elle qui contrôle le remboursement, même si la plateforme est Tradovate. Envoyez votre demande à l'équipe de facturation ou de support de la firme, pas à Tradovate, et vérifiez d'abord la propre politique de remboursement de la firme. Les délais de remboursement, les frais d'activation non remboursables et les conditions de litige varient selon la firme et la taille du compte, confirmez donc les règles actuelles de votre firme plutôt que de les supposer. Déposer une rétrofacturation bancaire contre une prop firm est particulièrement risqué, car cela bloque généralement tous les comptes que vous détenez chez elle en même temps." },
    { type: "heading", text: "La rétrofacturation : un véritable dernier recours" },
    { type: "paragraph", html: "Si vous avez documenté un débit légitime, interrogé directement la facturation, et été refusé de manière injuste, une rétrofacturation est un outil légitime, entrez-y simplement les yeux ouverts. Votre banque ou réseau de carte a son propre délai de dépôt, souvent autour de 60 jours à compter de la date du relevé, mais cela varie selon l'émetteur, ne trainez donc pas. Apportez les mêmes preuves que celles envoyées au support, plus le fil du support montrant que vous avez d'abord essayé de le résoudre. Et acceptez le compromis : le déposer gèlera très probablement le compte associé et pourrait fermer une évaluation prop firm, alors n'actionnez ce levier que lorsque vous avez déjà décidé d'en finir avec ce compte ou que vous n'avez pas d'autre option." },
    { type: "heading", text: "Type de débit &rarr; Qui contacter &rarr; Que faire" },
    {
      type: "table",
      headers: ["Débit sur votre relevé", "Ce que c'est généralement", "Votre action"],
      rows: [
        ["Montant mensuel récurrent proche de l'anniversaire d'inscription", "Abonnement à un plan payant à renouvellement automatique", "Annulez dans Paramètres > Plans, puis demandez à la facturation un remboursement si c'était une erreur"],
        ["Petits frais après une période d'inactivité du compte", "Frais d'inactivité / de maintenance du plan gratuit", "Vérifiez le barème de frais ; les frais documentés ne sont généralement pas remboursés, évitez donc le prochain"],
        ["Frais juste après la clôture forcée d'une position", "Frais de liquidation par événement", "Vérifiez qu'ils correspondent à la politique de liquidation ; gardez une marge tampon pour éviter les répétitions"],
        ["Frais mensuels de données", "Abonnement de données de marché en temps réel", "Annulez spécifiquement l'abonnement de données ; il est distinct du plan"],
        ["Débit d'évaluation, de réinitialisation ou d'activation", "Facturation de la prop firm, pas Tradovate", "Contactez l'équipe de facturation de la prop firm selon sa politique de remboursement"],
        ["Le même débit deux fois, ou un débit après annulation", "Erreur de facturation réelle", "Ouvrez un ticket de support avec des preuves et demandez une annulation"],
      ],
    },
    { type: "heading", text: "Réduisez les débits surprises" },
    { type: "paragraph", html: "Un litige de remboursement est une mauvaise façon de passer une journée de trading, et une bonne partie des débits contestés sont évitables. Les frais d'inactivité touchent les comptes dormants. Les frais de liquidation touchent les positions qui ont dépassé leur marge. Les deux proviennent d'un compte mal géré plutôt que d'un bug de facturation. Garder votre stratégie active et votre risque surveillé élimine bon nombre de ces déclencheurs. C'est là que l'automatisation fait ses preuves :" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Activité constante</strong>, l'acheminement de vos alertes TradingView vers Tradovate maintient le compte tradant selon le calendrier prévu au lieu de dériver vers une fenêtre de frais d'inactivité.",
        "<strong class='text-white'>Sorties de risque sans intervention</strong>, les stops et objectifs automatisés se déclenchent sur chaque position, de sorte que les trades se clôturent selon vos conditions plutôt que d'être liquidés de force et de générer des frais.",
        "<strong class='text-white'>Un abonnement clair</strong>, la facturation PickMyTrade est mensuelle et vous pouvez annuler à tout moment depuis votre tableau de bord, il n'y a donc pas d'enchevêtrement de renouvellements à contester plus tard.",
        "<strong class='text-white'>Une trace documentée propre</strong>, chaque ordre est enregistré, ce qui simplifie la réconciliation de tout débit avec l'activité réelle.",
      ],
    },
    { type: "paragraph", html: "L'automatisation ne peut pas rembourser des frais déjà comptabilisés, et elle ne remplace pas les règles d'une prop firm. Mais moins de comptes inactifs et des sorties plus propres signifient moins de débits à contester dès le départ." },
  ], it: [
    { type: "paragraph", html: "Controllate l'estratto conto della vostra carta, notate un addebito Tradovate che non vi aspettavate, e il vostro primo istinto è avviare una contestazione con la vostra banca. Rallentate. Uno storno bancario sembra la scorciatoia, ma presso un broker è la mossa più probabile a farvi rimanere esclusi dal vostro stesso account. La via più intelligente è quasi sempre contattare direttamente la fatturazione, con le prove in mano, e dare loro la possibilità di risolvere. Questa guida illustra come capire per cosa siete stati realmente addebitati, come richiedere un rimborso nel modo corretto, e il rischio per l'account nel rivolgersi direttamente alla vostra banca. Si applica agli account Tradovate standard e, con un'eccezione importante, anche alle valutazioni di prop firm fatturate tramite Tradovate." },
    {
      type: "checklist",
      heading: "Checklist rapida prima di contestare qualsiasi cosa",
      items: [
        "<strong class='text-white'>Identificate prima l'addebito esatto.</strong> Annotate la data, l'importo e la descrizione sul vostro estratto conto prima di decidere che sia sbagliato. Metà degli addebiti &ldquo;misteriosi&rdquo; sono commissioni documentate.",
        "<strong class='text-white'>Fate uno screenshot di tutto.</strong> La riga dell'estratto conto, la pagina del vostro piano e qualsiasi email di conferma. La prova è ciò che trasforma una richiesta di rimborso in un sì rapido.",
        "<strong class='text-white'>Annullate il piano ricorrente</strong> se non volete essere addebitati di nuovo, in modo che un secondo addebito non arrivi mentre state ancora risolvendo il primo.",
        "<strong class='text-white'>Contattate direttamente la fatturazione prima della vostra banca.</strong> Email, il portale di supporto o telefono. Un ticket scritto vi fornisce una traccia documentale.",
        "<strong class='text-white'>Sappiate a chi appartiene l'addebito.</strong> Se proviene da una prop firm, è la società a gestire il rimborso, non Tradovate.",
        "<strong class='text-white'>Tenete lo storno in riserva.</strong> Resta disponibile se il supporto si blocca, ma presentarlo troppo presto può congelare l'account.",
      ],
    },
    { type: "heading", text: "Prima di tutto, capite per cosa siete stati realmente addebitati" },
    { type: "paragraph", html: "Prima di definire qualcosa un errore, individuate con precisione l'addebito. Le piattaforme di trading fatturano per più cose di quante la maggior parte delle persone tenga traccia, e un addebito &ldquo;a sorpresa&rdquo; è spesso una commissione che avete accettato all'apertura dell'account. Chiarire questo è importante, perché una commissione applicata correttamente non verrà rimborsata solo perché ve ne siete dimenticati, e conoscere il tipo di addebito vi dice esattamente con chi parlare." },
    { type: "paragraph", html: "Ecco i soliti sospetti dietro un addebito Tradovate inaspettato:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Abbonamento al piano mensile.</strong> Se avete un piano mensile a pagamento, si rinnova automaticamente finché non lo annullate. Un addebito proprio intorno al vostro anniversario di iscrizione è quasi sempre il rinnovo.",
        "<strong class='text-white'>Commissioni amministrative del piano gratuito.</strong> Il piano senza commissioni comporta commissioni di inattività e manutenzione che vengono addebitate quando l'account resta inattivo oltre una finestra prestabilita. Coglie di sorpresa chi ha presunto che &ldquo;gratuito&rdquo; significasse &ldquo;nessun addebito mai&rdquo;.",
        "<strong class='text-white'>Commissione di liquidazione.</strong> Quando una posizione viene chiusa automaticamente per violazione del margine, una commissione di liquidazione per evento può colpire l'account, a volte senza preavviso.",
        "<strong class='text-white'>Abbonamenti ai dati di mercato.</strong> I dati di borsa in tempo reale (CME e altri) vengono fatturati mensilmente e si rinnovano da soli finché non annullate specificamente l'abbonamento ai dati.",
        "<strong class='text-white'>Commissione di valutazione o reset di una prop firm.</strong> L'acquisto di una valutazione, un reset o un'attivazione tramite una società di finanziamento viene fatturato da quella società. Sul vostro estratto conto può comunque sembrare un addebito della piattaforma.",
      ],
    },
    { type: "paragraph", html: "Una volta che riuscite a identificare l'addebito, confrontarlo con la tabella delle commissioni del vostro piano è rapido. Se il numero corrisponde a una commissione pubblicata, state guardando un addebito documentato, e la vostra mossa migliore è prevenire il prossimo, non contestare l'ultimo. Se non corrisponde, oppure siete stati addebitati dopo aver annullato, oppure vedete lo stesso addebito due volte, avete un caso di rimborso genuino che vale la pena sollevare." },
    { type: "heading", text: "Perché contattare il supporto prima di presentare uno storno" },
    { type: "paragraph", html: "Questa è la parte che salva gli account. Uno storno non è un reclamo, è la vostra banca che recupera forzatamente il denaro dal commerciante, e i broker lo trattano come un evento serio. Quando arriva una contestazione di pagamento, la risposta comune è un blocco automatico: l'account contestato, e spesso ogni account collegato ad esso, viene bloccato o sospeso mentre la contestazione si svolge. Per un account di valutazione o finanziato, questo può significare che la valutazione è finita. Potreste vincere lo storno e comunque perdere l'accesso all'account che stavate cercando di proteggere." },
    { type: "paragraph", html: "Le condizioni della piattaforma sono costruite attorno alla risoluzione diretta delle cose per prime. L'accordo utente di Tradovate prevede una finestra di 60 giorni per risolvere informalmente una contestazione dopo l'invio di una comunicazione scritta, prima che una delle parti passi all'arbitrato formale, e limita anche il tempo a disposizione per presentare un reclamo. Tradotto in termini semplici: si aspettano che solleviate il problema con loro, per iscritto, e diate loro un'equa possibilità di risolverlo. Uno storno bancario salta completamente quel passaggio e può mettervi in torto proprio rispetto all'accordo che vi servirebbe dalla vostra parte se le cose diventassero controverse." },
    { type: "paragraph", html: "Niente di tutto ciò significa che non possiate mai contestare tramite la vostra banca. Significa che l'ordine delle operazioni conta. Prima il supporto, lo storno per ultimo. Se la fatturazione ignora davvero una richiesta legittima e ben documentata, lo storno resta comunque disponibile. Ma la maggior parte degli addebiti rimborsabili, una doppia fatturazione, un rinnovo dopo la cancellazione, un errore chiaro, si risolvono più velocemente e più pulitamente con un ticket che con uno scontro." },
    { type: "heading", text: "Come richiedere un rimborso nel modo corretto: passo dopo passo" },
    { type: "heading", text: "Passaggio 1: raccogliete le vostre prove" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Prendete la riga dell'estratto conto.</strong> Fate uno screenshot dell'addebito che mostri data, importo e descrizione del commerciante.",
        "<strong class='text-white'>Recuperate i vostri registri account.</strong> Aprite i vostri report account o la cronologia di fatturazione e catturate la voce corrispondente (o mancante). Se avete annullato, trovate l'email di conferma dell'annullamento e annotate il suo orario.",
        "<strong class='text-white'>Scrivete il motivo in una riga.</strong> &ldquo;Addebitato $X il [data] dopo aver annullato il [data precedente]&rdquo;, oppure &ldquo;fatturato due volte per lo stesso piano il [data]&rdquo;. Un riassunto conciso e fattuale vi ottiene un sì più veloce di un lungo reclamo.",
      ],
    },
    { type: "heading", text: "Passaggio 2: annullate il piano ricorrente in modo che non possa fatturare di nuovo" },
    { type: "paragraph", html: "Se non intendete continuare a pagare, annullate prima del prossimo rinnovo in modo che un nuovo addebito non arrivi a metà della contestazione. L'annullamento si trova nella dashboard del vostro account, nell'area Impostazioni sotto la sezione piano o abbonamento. Disattivate il rinnovo automatico per l'elemento specifico, che sia il piano mensile o un abbonamento ai dati di mercato, poiché questi vengono fatturati e annullati separatamente. Un punto chiave: annullare interrompe gli addebiti futuri ma non rimborsa automaticamente uno già registrato. Di solito mantenete l'accesso fino alla fine del periodo già pagato." },
    { type: "heading", text: "Passaggio 3: aprite un ticket di fatturazione con il supporto" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Usate un canale ufficiale.</strong> Inviate un'email a support@tradovate.com, inviate una richiesta tramite il portale di supporto su support.tradovate.com, oppure chiamate la linea di supporto al numero 1-844-283-3100 (raggiungibile anche al 312-283-3100). Un ticket scritto è la scelta migliore perché registra l'orario della vostra richiesta e avvia quel termine di contestazione a vostro favore.",
        "<strong class='text-white'>Esponete la richiesta chiaramente.</strong> Allegate i vostri screenshot, indicate la data e l'importo dell'addebito, e chiedete direttamente un rimborso o uno storno. Non nascondete la richiesta.",
        "<strong class='text-white'>Conservate il thread.</strong> Salvate il numero del ticket e ogni risposta. Se in futuro vi servisse uno storno, questo registro è la prova che avete provato a risolverlo direttamente.",
      ],
    },
    { type: "heading", text: "Passaggio 4: se è un addebito di una prop firm, rivolgetevi alla società" },
    { type: "paragraph", html: "Questa è l'eccezione che confonde le persone. Se l'addebito era per una valutazione, un reset o un'attivazione di una prop firm, è stata la società ad addebitarvi e la società controlla il rimborso, anche se la piattaforma è Tradovate. Inviate la vostra richiesta al team di fatturazione o supporto della società, non a Tradovate, e controllate prima la politica di rimborso della società stessa. Le finestre di rimborso, le commissioni di attivazione non rimborsabili e i termini di contestazione variano in base alla società e alla dimensione dell'account, quindi confermate le regole attuali della vostra società invece di darle per scontate. Presentare uno storno bancario contro una prop firm è particolarmente rischioso, poiché di solito blocca contemporaneamente tutti gli account che avete presso di essa." },
    { type: "heading", text: "Lo storno: una vera ultima risorsa" },
    { type: "paragraph", html: "Se avete documentato un addebito legittimo, chiesto direttamente alla fatturazione, e siete stati rifiutati ingiustamente, uno storno è uno strumento legittimo, ma entrateci ad occhi aperti. La vostra banca o il circuito della carta ha una propria finestra di presentazione, spesso intorno ai 60 giorni dalla data dell'estratto conto ma varia in base all'emittente, quindi non aspettate troppo. Portate le stesse prove inviate al supporto, più il thread di supporto che dimostra che avete provato a risolverlo prima. E accettate il compromesso: presentarlo bloccherà molto probabilmente l'account associato e possibilmente chiuderà una valutazione prop, quindi azionate questa leva solo quando avete già deciso di chiudere con quell'account o non avete altra opzione." },
    { type: "heading", text: "Tipo di addebito &rarr; Chi contattare &rarr; Cosa fare" },
    {
      type: "table",
      headers: ["Addebito sul vostro estratto conto", "Cosa è di solito", "La vostra mossa"],
      rows: [
        ["Importo mensile ricorrente vicino all'anniversario di iscrizione", "Abbonamento a piano a pagamento con rinnovo automatico", "Annullate in Impostazioni > Piani, poi chiedete alla fatturazione un rimborso se era un errore"],
        ["Piccola commissione dopo che l'account è rimasto inattivo", "Commissione di inattività/manutenzione del piano gratuito", "Controllate la tabella delle commissioni; le commissioni documentate generalmente non vengono rimborsate, quindi prevenite la prossima"],
        ["Commissione subito dopo la chiusura forzata di una posizione", "Commissione di liquidazione per evento", "Verificate che corrisponda alla politica di liquidazione; mantenete un margine cuscinetto per evitare ripetizioni"],
        ["Addebito dati mensile", "Abbonamento ai dati di mercato in tempo reale", "Annullate specificamente l'abbonamento ai dati; è separato dal piano"],
        ["Addebito di valutazione, reset o attivazione", "Fatturazione della prop firm, non Tradovate", "Contattate il team di fatturazione della prop firm secondo la sua politica di rimborso"],
        ["Stesso addebito due volte, o un addebito dopo l'annullamento", "Errore di fatturazione genuino", "Aprite un ticket di supporto con prove e richiedete uno storno"],
      ],
    },
    { type: "heading", text: "Riducete gli addebiti a sorpresa" },
    { type: "paragraph", html: "Una battaglia per un rimborso è un modo pessimo di passare una giornata di trading, e una buona parte degli addebiti contestati è evitabile. Le commissioni di inattività colpiscono gli account dormienti. Le commissioni di liquidazione colpiscono le posizioni che hanno superato il margine. Entrambe derivano da un account mal gestito, non da un errore di fatturazione. Mantenere la vostra strategia attiva e il vostro rischio sotto controllo elimina molti di questi fattori scatenanti. È qui che l'automazione dimostra il suo valore:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Attività costante</strong>, instradare i vostri alert di TradingView a Tradovate mantiene l'account operativo secondo programma invece di scivolare in una finestra di commissione per inattività.",
        "<strong class='text-white'>Uscite di rischio senza intervento manuale</strong>, stop e target automatizzati si attivano su ogni posizione, così le operazioni si chiudono alle vostre condizioni invece di essere liquidate forzatamente generando una commissione.",
        "<strong class='text-white'>Un abbonamento chiaro</strong>, la fatturazione di PickMyTrade è mensile e potete annullare in qualsiasi momento dalla vostra dashboard, quindi non c'è un groviglio di rinnovi da contestare in seguito.",
        "<strong class='text-white'>Una traccia documentale pulita</strong>, ogni ordine viene registrato, il che rende semplice riconciliare qualsiasi addebito con l'attività reale.",
      ],
    },
    { type: "paragraph", html: "L'automazione non può rimborsare una commissione già registrata, e non annulla le regole di una prop firm. Ma meno account inattivi e uscite più pulite significano meno addebiti su cui discutere fin dall'inizio." },
  ] },
  ctaHeading: { en: "Keep Your Account Active, Automated, and Easy to Reconcile", de: "Halten Sie Ihr Konto aktiv, automatisiert und leicht abzugleichen", es: "Mantenga su cuenta activa, automatizada y fácil de conciliar", fr: "Gardez votre compte actif, automatisé et facile à réconcilier", it: "Mantieni il tuo account attivo, automatizzato e facile da riconciliare" },
  ctaText: { en: "Connect TradingView to Tradovate and keep your account active, automated, and easy to reconcile.", de: "Verbinden Sie TradingView mit Tradovate und halten Sie Ihr Konto aktiv, automatisiert und leicht abzugleichen.", es: "Conecte TradingView con Tradovate y mantenga su cuenta activa, automatizada y fácil de conciliar.", fr: "Connectez TradingView à Tradovate et gardez votre compte actif, automatisé et facile à réconcilier.", it: "Collega TradingView a Tradovate e mantieni il tuo account attivo, automatizzato e facile da riconciliare." },
  ctaButtonText: { en: "Start Your Free 7-Day Trial", de: "Starten Sie Ihre kostenlose 5-Tage-Testversion", es: "Inicie su prueba gratuita de 5 días", fr: "Démarrez votre essai gratuit de 5 jours", it: "Avvia la tua prova gratuita di 5 giorni" },
  ctaUrl: "https://app.pickmytrade.trade/?register=true&utm_source=content&utm_medium=debugging",
  faqHeading: { en: "Frequently Asked Questions", de: "Häufig gestellte Fragen", es: "Preguntas frecuentes", fr: "Questions fréquentes", it: "Domande frequenti" },
  faqs: { en: [
    { q: "Can I get a refund on a Tradovate charge?", a: "Sometimes. The Tradovate EULA doesn't publish a blanket refund policy, so refunds are handled case by case by the billing team. Duplicate charges, a plan you cancelled but were still billed for, or an obvious error are your strongest cases. Open a support ticket with the exact charge date, amount, and a screenshot, and ask directly for a refund or reversal." },
    { q: "Should I file a chargeback with my bank instead?", a: "Treat a chargeback as a last resort, not a first move. Filing a dispute through your bank before you've contacted the broker usually gets your trading account flagged, suspended, or frozen while the dispute runs, and it can burn the relationship even if you were right. Try support first and keep a written record; a chargeback still stays available if support goes nowhere." },
    { q: "What happens to my account if I do a chargeback?", a: "A payment dispute typically triggers an automatic hold. Many brokers and prop firms block the disputed account, and often every linked account, the moment a chargeback is filed, and access stays blocked until the disputed amount is settled. For an evaluation or funded account this can also end the eval. Exact enforcement varies by firm and account type, so check your current rules before you file." },
    { q: "How do I stop being billed for my monthly plan?", a: "Cancel the recurring plan yourself from your account dashboard, in the Settings area under the Plans (or subscription) section, before the next renewal date. Cancelling stops future charges but usually leaves access active until the end of the current billing period. It doesn't automatically refund a charge that already went through, so pair the cancellation with a refund request if you were billed in error." },
    { q: "Why was I charged when I barely used the platform?", a: "A lot of surprise charges are documented admin fees, not billing mistakes. Inactivity or maintenance fees on the Free plan, a per-event liquidation fee when a position is auto-flattened, and market-data subscription fees all bill automatically. Check the fee schedule for your plan before disputing, because a correctly applied admin fee won't be refunded just for being unexpected." },
    { q: "My charge was for a prop-firm evaluation. Who refunds me?", a: "The prop firm, not Tradovate. When you buy an evaluation or reset through a firm like Apex, Topstep, or another provider, that firm bills you and controls refunds under its own policy. Tradovate only supplies the platform. Send refund and dispute requests to the firm's billing or support team, and check the firm's current refund window and terms first." },
    { q: "How long do I have to dispute a charge?", a: "Two clocks matter. The platform terms build in a 60-day period to resolve a dispute informally after you send notice, and limit how long you have to bring a formal claim. Your bank or card network also sets its own chargeback window, often around 60 days from the statement but it varies. Raise the issue quickly and in writing so you stay inside both windows." },
  ], de: [
    { q: "Kann ich eine Rückerstattung für eine Tradovate-Abbuchung erhalten?", a: "Manchmal. Der Tradovate-EULA veröffentlicht keine pauschale Rückerstattungsrichtlinie, daher werden Rückerstattungen vom Abrechnungsteam von Fall zu Fall bearbeitet. Doppelte Abbuchungen, ein gekündigter Plan, für den Sie dennoch belastet wurden, oder ein offensichtlicher Fehler sind Ihre stärksten Fälle. Eröffnen Sie ein Support-Ticket mit dem genauen Abbuchungsdatum, Betrag und einem Screenshot, und bitten Sie direkt um eine Rückerstattung oder Stornierung." },
    { q: "Sollte ich stattdessen eine Rückbuchung bei meiner Bank einreichen?", a: "Behandeln Sie eine Rückbuchung als letztes Mittel, nicht als ersten Schritt. Reicht man einen Streitfall über die Bank ein, bevor man den Broker kontaktiert hat, wird das Handelskonto meist markiert, ausgesetzt oder eingefroren, während der Streit läuft, und es kann die Beziehung belasten, selbst wenn Sie recht hatten. Versuchen Sie zuerst den Support und führen Sie eine schriftliche Aufzeichnung; eine Rückbuchung steht weiterhin zur Verfügung, falls der Support nicht weiterkommt." },
    { q: "Was passiert mit meinem Konto, wenn ich eine Rückbuchung durchführe?", a: "Ein Zahlungsstreit löst in der Regel eine automatische Sperre aus. Viele Broker und Prop-Firmen blockieren das betroffene Konto, und oft jedes damit verknüpfte Konto, sobald eine Rückbuchung eingereicht wird, und der Zugang bleibt gesperrt, bis der strittige Betrag geklärt ist. Bei einem Evaluierungs- oder finanzierten Konto kann dies auch das Ende der Evaluierung bedeuten. Die genaue Durchsetzung variiert je nach Firma und Kontotyp, prüfen Sie also Ihre aktuellen Regeln, bevor Sie einreichen." },
    { q: "Wie stoppe ich die Abbuchungen für meinen monatlichen Plan?", a: "Kündigen Sie den wiederkehrenden Plan selbst über Ihr Konto-Dashboard, im Bereich Einstellungen unter dem Abschnitt Pläne (oder Abonnement), vor dem nächsten Verlängerungsdatum. Die Kündigung stoppt zukünftige Abbuchungen, lässt den Zugang aber in der Regel bis zum Ende des laufenden Abrechnungszeitraums aktiv. Sie erstattet nicht automatisch eine bereits erfolgte Abbuchung, kombinieren Sie die Kündigung also mit einer Rückerstattungsanfrage, falls Sie fälschlicherweise belastet wurden." },
    { q: "Warum wurde ich belastet, obwohl ich die Plattform kaum genutzt habe?", a: "Viele überraschende Abbuchungen sind dokumentierte Verwaltungsgebühren, keine Abrechnungsfehler. Inaktivitäts- oder Wartungsgebühren beim kostenlosen Plan, eine ereignisbezogene Liquidationsgebühr bei automatischer Glattstellung einer Position, und Marktdaten-Abonnementgebühren werden alle automatisch abgebucht. Prüfen Sie den Gebührenplan für Ihren Plan, bevor Sie bestreiten, denn eine korrekt angewandte Verwaltungsgebühr wird nicht erstattet, nur weil sie unerwartet kam." },
    { q: "Meine Abbuchung war für eine Prop-Firm-Evaluierung. Wer erstattet mir das?", a: "Die Prop-Firma, nicht Tradovate. Wenn Sie eine Evaluierung oder einen Reset über eine Firma wie Apex, Topstep oder einen anderen Anbieter kaufen, stellt diese Firma Ihnen Rechnungen und kontrolliert Rückerstattungen gemäß ihrer eigenen Richtlinie. Tradovate liefert nur die Plattform. Senden Sie Rückerstattungs- und Streitanfragen an das Abrechnungs- oder Support-Team der Firma, und prüfen Sie zuerst deren aktuelles Rückerstattungsfenster und die Bedingungen." },
    { q: "Wie viel Zeit habe ich, um eine Abbuchung zu bestreiten?", a: "Zwei Fristen sind wichtig. Die Plattformbedingungen sehen eine Frist von 60 Tagen vor, um einen Streit informell zu lösen, nachdem Sie eine Mitteilung gesendet haben, und begrenzen, wie lange Sie Zeit haben, einen formellen Anspruch geltend zu machen. Ihre Bank oder Ihr Kartennetzwerk legt ebenfalls eine eigene Rückbuchungsfrist fest, oft rund 60 Tage ab dem Kontoauszug, aber das variiert. Bringen Sie das Problem schnell und schriftlich vor, damit Sie innerhalb beider Fristen bleiben." },
  ], es: [
    { q: "¿Puedo obtener un reembolso por un cargo de Tradovate?", a: "A veces. El EULA de Tradovate no publica una política de reembolso general, así que los reembolsos son gestionados caso por caso por el equipo de facturación. Los cargos duplicados, un plan que canceló pero por el que aun así le cobraron, o un error evidente son sus mejores argumentos. Abra un ticket de soporte con la fecha exacta del cargo, el monto y una captura de pantalla, y pida directamente un reembolso o reversión." },
    { q: "¿Debería presentar una devolución de cargo con mi banco en su lugar?", a: "Trate la devolución de cargo como último recurso, no como primer movimiento. Presentar una disputa a través de su banco antes de haber contactado al broker suele hacer que su cuenta de trading sea marcada, suspendida o congelada mientras dura la disputa, y puede dañar la relación incluso si usted tenía razón. Intente primero con soporte y conserve un registro escrito; la devolución de cargo sigue estando disponible si soporte no llega a ningún lado." },
    { q: "¿Qué le pasa a mi cuenta si hago una devolución de cargo?", a: "Una disputa de pago normalmente desencadena una retención automática. Muchos brokers y prop firms bloquean la cuenta en disputa, y a menudo cada cuenta vinculada, en el momento en que se presenta una devolución de cargo, y el acceso permanece bloqueado hasta que se resuelva el monto en disputa. Para una cuenta de evaluación o financiada, esto también puede terminar la evaluación. La aplicación exacta varía según la firma y el tipo de cuenta, así que revise sus reglas actuales antes de presentarla." },
    { q: "¿Cómo dejo de recibir cargos por mi plan mensual?", a: "Cancele el plan recurrente usted mismo desde el panel de su cuenta, en el área de Configuración bajo la sección de Planes (o suscripción), antes de la próxima fecha de renovación. Cancelar detiene los cargos futuros pero normalmente deja el acceso activo hasta el final del período de facturación actual. No reembolsa automáticamente un cargo que ya se procesó, así que combine la cancelación con una solicitud de reembolso si le cobraron por error." },
    { q: "¿Por qué me cobraron si apenas usé la plataforma?", a: "Muchos cargos sorpresa son comisiones administrativas documentadas, no errores de facturación. Las comisiones de inactividad o mantenimiento del plan gratuito, una comisión de liquidación por evento cuando una posición se cierra automáticamente, y las comisiones de suscripción de datos de mercado se cobran todas automáticamente. Revise el listado de comisiones de su plan antes de impugnar, porque una comisión administrativa correctamente aplicada no se reembolsará solo por ser inesperada." },
    { q: "Mi cargo era por una evaluación de una prop firm. ¿Quién me reembolsa?", a: "La prop firm, no Tradovate. Cuando compra una evaluación o reinicio a través de una firma como Apex, Topstep u otro proveedor, esa firma le factura y controla los reembolsos según su propia política. Tradovate solo suministra la plataforma. Envíe las solicitudes de reembolso y disputa al equipo de facturación o soporte de la firma, y consulte primero su plazo y términos de reembolso vigentes." },
    { q: "¿Cuánto tiempo tengo para impugnar un cargo?", a: "Importan dos plazos. Las condiciones de la plataforma incorporan un período de 60 días para resolver una disputa de manera informal después de enviar aviso, y limitan cuánto tiempo tiene para presentar una reclamación formal. Su banco o red de tarjetas también establece su propio plazo de devolución de cargo, a menudo alrededor de 60 días desde el estado de cuenta, pero varía. Plantee el problema rápidamente y por escrito para permanecer dentro de ambos plazos." },
  ], fr: [
    { q: "Puis-je obtenir un remboursement sur un débit Tradovate ?", a: "Parfois. Le CLUF de Tradovate ne publie pas de politique de remboursement générale, les remboursements sont donc traités au cas par cas par l'équipe de facturation. Des débits en double, un plan que vous avez annulé mais pour lequel vous avez quand même été facturé, ou une erreur évidente sont vos meilleurs arguments. Ouvrez un ticket de support avec la date exacte du débit, le montant, et une capture d'écran, et demandez directement un remboursement ou une annulation." },
    { q: "Devrais-je plutôt déposer une rétrofacturation auprès de ma banque ?", a: "Traitez la rétrofacturation comme un dernier recours, pas un premier geste. Déposer une contestation via votre banque avant d'avoir contacté le courtier fait généralement signaler, suspendre ou geler votre compte de trading pendant la durée du litige, et cela peut nuire à la relation même si vous aviez raison. Essayez d'abord le support et conservez une trace écrite ; une rétrofacturation reste disponible si le support ne mène nulle part." },
    { q: "Qu'arrive-t-il à mon compte si je fais une rétrofacturation ?", a: "Un litige de paiement déclenche généralement un blocage automatique. De nombreux courtiers et prop firms bloquent le compte contesté, et souvent chaque compte lié, dès qu'une rétrofacturation est déposée, et l'accès reste bloqué jusqu'à ce que le montant contesté soit réglé. Pour un compte d'évaluation ou financé, cela peut aussi mettre fin à l'évaluation. L'application exacte varie selon la firme et le type de compte, vérifiez donc vos règles actuelles avant de la déposer." },
    { q: "Comment arrêter d'être facturé pour mon plan mensuel ?", a: "Annulez vous-même le plan récurrent depuis le tableau de bord de votre compte, dans la section Paramètres sous la rubrique Plans (ou abonnement), avant la prochaine date de renouvellement. L'annulation arrête les débits futurs mais laisse généralement l'accès actif jusqu'à la fin de la période de facturation en cours. Elle ne rembourse pas automatiquement un débit déjà passé, associez donc l'annulation à une demande de remboursement si vous avez été facturé par erreur." },
    { q: "Pourquoi ai-je été facturé alors que j'ai à peine utilisé la plateforme ?", a: "Beaucoup de débits surprises sont des frais administratifs documentés, pas des erreurs de facturation. Les frais d'inactivité ou de maintenance du plan gratuit, des frais de liquidation par événement lorsqu'une position est clôturée automatiquement, et les frais d'abonnement aux données de marché sont tous facturés automatiquement. Vérifiez le barème de frais de votre plan avant de contester, car des frais administratifs correctement appliqués ne seront pas remboursés simplement parce qu'ils sont inattendus." },
    { q: "Mon débit concernait une évaluation prop firm. Qui me rembourse ?", a: "La prop firm, pas Tradovate. Lorsque vous achetez une évaluation ou une réinitialisation auprès d'une firme comme Apex, Topstep ou un autre fournisseur, c'est cette firme qui vous facture et contrôle les remboursements selon sa propre politique. Tradovate ne fournit que la plateforme. Envoyez les demandes de remboursement et de contestation à l'équipe de facturation ou de support de la firme, et vérifiez d'abord son délai et ses conditions de remboursement actuels." },
    { q: "Combien de temps ai-je pour contester un débit ?", a: "Deux délais comptent. Les conditions de la plateforme intègrent une période de 60 jours pour résoudre un litige à l'amiable après l'envoi d'un avis, et limitent le délai dont vous disposez pour introduire une réclamation formelle. Votre banque ou réseau de carte fixe également son propre délai de rétrofacturation, souvent autour de 60 jours à compter du relevé, mais cela varie. Soulevez le problème rapidement et par écrit afin de rester dans les deux délais." },
  ], it: [
    { q: "Posso ottenere un rimborso per un addebito Tradovate?", a: "A volte. Il CLUF di Tradovate non pubblica una politica di rimborso generale, quindi i rimborsi vengono gestiti caso per caso dal team di fatturazione. Addebiti duplicati, un piano che avete annullato ma per cui siete stati comunque fatturati, o un errore evidente sono i vostri casi più forti. Aprite un ticket di supporto con la data esatta dell'addebito, l'importo e uno screenshot, e chiedete direttamente un rimborso o uno storno." },
    { q: "Dovrei invece presentare uno storno con la mia banca?", a: "Trattate lo storno come ultima risorsa, non come prima mossa. Presentare una contestazione tramite la vostra banca prima di aver contattato il broker di solito fa segnalare, sospendere o congelare il vostro account di trading mentre la contestazione è in corso, e può danneggiare il rapporto anche se avevate ragione. Provate prima con il supporto e conservate un registro scritto; uno storno resta comunque disponibile se il supporto non porta a nulla." },
    { q: "Cosa succede al mio account se faccio uno storno?", a: "Una contestazione di pagamento in genere innesca un blocco automatico. Molti broker e prop firm bloccano l'account contestato, e spesso ogni account collegato, nel momento in cui viene presentato uno storno, e l'accesso resta bloccato finché l'importo contestato non viene risolto. Per un account di valutazione o finanziato, questo può anche porre fine alla valutazione. L'applicazione esatta varia in base alla società e al tipo di account, quindi controllate le vostre regole attuali prima di presentarlo." },
    { q: "Come faccio a smettere di essere addebitato per il mio piano mensile?", a: "Annullate voi stessi il piano ricorrente dalla dashboard del vostro account, nell'area Impostazioni sotto la sezione Piani (o abbonamento), prima della prossima data di rinnovo. Annullare interrompe gli addebiti futuri ma di solito lascia l'accesso attivo fino alla fine del periodo di fatturazione corrente. Non rimborsa automaticamente un addebito già effettuato, quindi abbinate l'annullamento a una richiesta di rimborso se siete stati fatturati per errore." },
    { q: "Perché sono stato addebitato quando ho usato a malapena la piattaforma?", a: "Molti addebiti a sorpresa sono commissioni amministrative documentate, non errori di fatturazione. Le commissioni di inattività o manutenzione sul piano gratuito, una commissione di liquidazione per evento quando una posizione viene chiusa automaticamente, e le commissioni di abbonamento ai dati di mercato vengono tutte addebitate automaticamente. Controllate la tabella delle commissioni del vostro piano prima di contestare, perché una commissione amministrativa applicata correttamente non verrà rimborsata solo perché inaspettata." },
    { q: "Il mio addebito era per una valutazione di una prop firm. Chi mi rimborsa?", a: "La prop firm, non Tradovate. Quando acquistate una valutazione o un reset tramite una società come Apex, Topstep o un altro fornitore, è quella società a fatturarvi e a controllare i rimborsi secondo la propria politica. Tradovate fornisce solo la piattaforma. Inviate le richieste di rimborso e contestazione al team di fatturazione o supporto della società, e controllate prima la sua finestra e i suoi termini di rimborso attuali." },
    { q: "Quanto tempo ho per contestare un addebito?", a: "Contano due scadenze. I termini della piattaforma prevedono un periodo di 60 giorni per risolvere informalmente una contestazione dopo l'invio di una comunicazione, e limitano il tempo a disposizione per presentare un reclamo formale. La vostra banca o il circuito della carta stabilisce anche la propria finestra per lo storno, spesso intorno ai 60 giorni dall'estratto conto ma varia. Sollevate il problema rapidamente e per iscritto in modo da rimanere entro entrambe le finestre." },
  ] },
  relatedHeading: { en: "Related Guides", de: "Verwandte Leitfäden", es: "Guías relacionadas", fr: "Guides connexes", it: "Guide correlate" },
  disclosureText: { en: "This guide is for educational and informational purposes only and is not financial, investment, or trading advice. Trading futures and other leveraged products carries a substantial risk of loss and is not suitable for every investor. PickMyTrade is an independent third-party automation platform and is not affiliated with, endorsed by, or sponsored by Tradovate, Inc. or Bookmap. All related names, logos, and trademarks are the property of their respective owners. Platform features and steps change over time, so always confirm the current process in the official platform documentation before acting.", de: "Dieser Leitfaden dient ausschließlich Bildungs- und Informationszwecken und stellt keine Finanz-, Anlage- oder Handelsberatung dar. Der Handel mit Futures und anderen gehebelten Produkten birgt ein erhebliches Verlustrisiko und ist nicht für jeden Anleger geeignet. PickMyTrade ist eine unabhängige Drittanbieter-Automatisierungsplattform und steht in keiner Verbindung zu Tradovate, Inc. oder Bookmap und wird von diesen weder unterstützt noch gesponsert. Alle zugehörigen Namen, Logos und Marken sind Eigentum ihrer jeweiligen Inhaber. Funktionen und Abläufe der Plattform ändern sich im Laufe der Zeit; bestätigen Sie den aktuellen Prozess daher stets in der offiziellen Plattformdokumentation, bevor Sie handeln.", es: "Esta guía tiene fines exclusivamente educativos e informativos y no constituye asesoramiento financiero, de inversión o de trading. Operar con futuros y otros productos apalancados conlleva un riesgo sustancial de pérdida y no es adecuado para todos los inversores. PickMyTrade es una plataforma de automatización independiente de terceros y no está afiliada, respaldada ni patrocinada por Tradovate, Inc. ni por Bookmap. Todos los nombres, logotipos y marcas relacionados son propiedad de sus respectivos titulares. Las funciones y los pasos de la plataforma cambian con el tiempo, así que confirme siempre el proceso actual en la documentación oficial de la plataforma antes de actuar.", fr: "Ce guide est fourni à des fins éducatives et informatives uniquement et ne constitue pas un conseil financier, d'investissement ou de trading. Le trading de contrats à terme et d'autres produits à effet de levier comporte un risque de perte substantiel et ne convient pas à tous les investisseurs. PickMyTrade est une plateforme d'automatisation tierce indépendante et n'est affiliée à, approuvée par, ni sponsorisée par Tradovate, Inc. ou Bookmap. Tous les noms, logos et marques associés sont la propriété de leurs détenteurs respectifs. Les fonctionnalités et les étapes de la plateforme évoluent avec le temps ; confirmez donc toujours le processus actuel dans la documentation officielle de la plateforme avant d'agir.", it: "Questa guida ha uno scopo puramente educativo e informativo e non costituisce consulenza finanziaria, di investimento o di trading. Il trading di futures e altri prodotti a leva comporta un rischio sostanziale di perdita e non è adatto a tutti gli investitori. PickMyTrade è una piattaforma di automazione indipendente di terze parti e non è affiliata, approvata o sponsorizzata da Tradovate, Inc. o Bookmap. Tutti i nomi, i loghi e i marchi correlati sono di proprietà dei rispettivi titolari. Le funzionalità e i passaggi della piattaforma cambiano nel tempo, quindi verificate sempre il processo attuale nella documentazione ufficiale della piattaforma prima di agire." },
};
const data: GuideArticleData = resolveGuideContent(content, locale, related);

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: data.faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: `${SITE_URL}${withSlash(localizedPath(locale))}` },
    { "@type": "ListItem", position: 2, name: "Debugging", item: `${SITE_URL}${withSlash(localizedPath(locale, "debugging"))}` },
    { "@type": "ListItem", position: 3, name: content.h1[locale], item: `${SITE_URL}${withSlash(localizedPath(locale, `debugging/${SLUG}`))}` },
  ],
};

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: content.h1[locale],
  description: content.dek[locale],
  image: `${SITE_URL}/assets/og-default.webp`,
  publisher: { "@type": "Organization", name: "PickMyTrade", logo: { "@type": "ImageObject", url: `${SITE_URL}/assets/logo.png` } },
