---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "demo-account-disabled-inactivity";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/debugging/${SLUG}`;

const META_TITLE = "Tradovate 'Demo Account Disabled Due to Inactivity'";
const META_DESCRIPTION =
  "Tradovate demo account disabled due to inactivity? Learn why prop-firm and simulation accounts get locked and the exact steps to get trading again fast.";

// Short SEO title (<=60 chars) for locales where the shared h1 is too long for a SERP title.
const TITLE_OVERRIDE: Partial<Record<Locale, string>> = { de: "Tradovate: „Demo-Konto wegen Inaktivität deaktiviert“", es: "Tradovate: “cuenta demo deshabilitada por inactividad”", fr: "Tradovate : « compte démo désactivé pour inactivité »", it: "Tradovate: “account demo disabilitato per inattività”" };

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Tradovate: &ldquo;Demo-Konto wegen Inaktivität deaktiviert&rdquo;", es: "Tradovate: &ldquo;cuenta demo deshabilitada por inactividad&rdquo;", fr: "Tradovate : &laquo;&nbsp;compte démo désactivé pour inactivité&nbsp;&raquo;", it: "Tradovate: &ldquo;account demo disabilitato per inattività&rdquo;" },
  dek: { en: "You log in expecting a live DOM and instead hit &ldquo;Your demo account has been disabled due to inactivity.&rdquo; Here's what the message means, why Tradovate usually can't fix it, and the step-by-step path to getting reinstated.", de: "Sie melden sich an und erwarten einen Live-DOM, stoßen aber stattdessen auf die Meldung &ldquo;Your demo account has been disabled due to inactivity.&rdquo; Hier erfahren Sie, was diese Meldung bedeutet, warum Tradovate sie meist nicht selbst beheben kann, und den schrittweisen Weg zur Wiederherstellung.", es: "Inicia sesión esperando un DOM en vivo y, en su lugar, aparece el mensaje &ldquo;Your demo account has been disabled due to inactivity.&rdquo; Aquí explicamos qué significa el mensaje, por qué Tradovate normalmente no puede solucionarlo y los pasos exactos para recuperar el acceso.", fr: "Vous vous connectez en attendant un DOM en direct et tombez à la place sur le message &ldquo;Your demo account has been disabled due to inactivity.&rdquo; Voici ce que signifie ce message, pourquoi Tradovate ne peut généralement pas le résoudre, et la marche à suivre étape par étape pour être rétabli.", it: "Accedete aspettandovi un DOM live e vi ritrovate invece davanti al messaggio &ldquo;Your demo account has been disabled due to inactivity.&rdquo; Ecco cosa significa questo messaggio, perché Tradovate di solito non può risolverlo direttamente, e il percorso passo dopo passo per essere riattivati." },
  readTime: { en: "8 min read", de: "8 Minuten Lesezeit", es: "Lectura de 8 minutos", fr: "Lecture de 8 minutes", it: "Lettura di 8 minuti" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "You sit down to trade your evaluation, log in, and instead of a live DOM you hit a wall: &ldquo;Your demo account has been disabled due to inactivity.&rdquo; Nothing loads. No orders route. And the clock on your prop-firm challenge is still running. What makes this one so maddening is that the fix almost never lives on Tradovate's side. The account was disabled by whoever owns it, and that is usually your prop firm. Here's exactly what the message means, why Tradovate can't just flip it back on, and the step-by-step path to getting reinstated, plus how automating your entries with PickMyTrade keeps an account active enough that it rarely goes dormant to begin with." },
    {
      type: "checklist",
      heading: "Quick Checklist for a Disabled Tradovate Demo Account",
      items: [
        "<strong class='text-white'>Figure out who owns the account.</strong> A prop-firm evaluation (Apex, Topstep, and the like) versus a standalone Tradovate simulation account decides who you contact.",
        "<strong class='text-white'>Stop hammering the login.</strong> The account is disabled server-side. Retrying won't re-enable it and can trip a separate login lockout on top of the first problem.",
        "<strong class='text-white'>Contact your prop firm first if it's an evaluation account.</strong> Tradovate Help routinely bounces these tickets straight back to the firm that issued the account.",
        "<strong class='text-white'>Ask specifically for a reset or reinstatement.</strong> The firm placed the hold, so only they (or a fresh account) can lift it.",
        "<strong class='text-white'>Confirm the account is even still active.</strong> Some firms retire or expire idle accounts entirely, and reinstatement rules differ by firm and plan.",
        "<strong class='text-white'>Rule out a different cause.</strong> An unpaid subscription, a security flag, or signing in with the wrong credentials can all masquerade as an &ldquo;inactivity&rdquo; lockout.",
      ],
    },
    { type: "heading", text: "What &ldquo;Your Demo Account Has Been Disabled Due to Inactivity&rdquo; Means" },
    { type: "paragraph", html: "This message means the simulated (paper) account you're trying to open has been switched off on the server, and Tradovate's records show it went unused long enough to be flagged as dormant. It isn't a bug, a connectivity hiccup, or something a refresh clears. The account carries an explicit &ldquo;disabled&rdquo; state." },
    { type: "paragraph", html: "The part most traders miss is ownership. When you buy a Combine, an evaluation, or a funded challenge from a prop firm, that firm provisions your account and lets you trade it through Tradovate as the platform. Tradovate is the trading front-end; the prop firm is the account holder. Dormant accounts still cost money to keep alive, market-data licensing and platform provisioning among them, so the owner of the account, your prop firm, is the one that disables it after a stretch of inactivity. That's why traders who take this error to Tradovate support get sent back to their firm. Tradovate can't restore an account it doesn't own." },
    { type: "paragraph", html: "There's also a plain standalone case. If you opened a free Tradovate simulation account directly, not through any firm, the same &ldquo;disabled due to inactivity&rdquo; state can show up once the account has sat idle. Here Tradovate itself is the owner, so Tradovate support, or simply starting a fresh simulation, is the way back in." },
    { type: "heading", text: "Top Causes of a Disabled Tradovate Demo Account" },
    { type: "heading", text: "1. A prop-firm evaluation account was placed on hold" },
    { type: "paragraph", html: "This is by far the most common cause in 2026. Firms like Apex and Topstep issue evaluation and funded accounts that run on Tradovate. When one of those accounts sits unused for a while, the firm disables it to stop paying to keep a dormant account provisioned. The account still exists, but it's in a held state that only the firm can release. Take one of these to Tradovate support and you'll be redirected right back to the prop firm." },
    { type: "heading", text: "2. A standalone Tradovate simulation account went dormant" },
    { type: "paragraph", html: "If you signed up for Tradovate's own free simulated-trading account and left it idle, it can get flagged for inactivity on Tradovate's side. There's no third party here. Tradovate is the owner, so the resolution runs through Tradovate rather than a firm." },
    { type: "heading", text: "3. Market-data or platform licensing tied to the account" },
    { type: "paragraph", html: "Live futures data carries exchange licensing costs that recur whether or not you're actively trading. Disabling an idle account is how the owner avoids paying to keep entitlements and provisioning live on something nobody's using. That's why &ldquo;inactivity&rdquo; specifically triggers the shutdown instead of a random error." },
    { type: "heading", text: "4. Wrong login, expired account, or a separate flag" },
    { type: "paragraph", html: "Sometimes the account isn't disabled at all. You might be signing in with the wrong set of credentials, a personal Tradovate login instead of the firm-issued one, or the evaluation may have expired on schedule rather than from inactivity. A lapsed subscription payment or a security hold can also surface as a lockout that reads like inactivity. Confirming the account's true status with the owner rules these out before you assume &ldquo;inactivity&rdquo; is the whole story." },
    { type: "heading", text: "How to Fix a Disabled Tradovate Demo Account: Step-by-Step" },
    { type: "heading", text: "Fixing a prop-firm evaluation account" },
    {
      type: "list",
      items: [
        "Confirm which firm issued the account (Apex, Topstep, or whichever firm you bought from). The firm, not Tradovate, is the account owner.",
        "Open a support request in that firm's own help portal or dashboard, not with Tradovate. Contact Tradovate first and you'll simply be pointed back to the firm.",
        "Quote the exact error text, &ldquo;Your demo account has been disabled due to inactivity,&rdquo; and ask them to <strong class='text-white'>reset or reinstate</strong> the account. Being specific about a reset speeds up the ticket.",
        "Ask whether a reset is even possible for your plan. Reinstatement policies vary by firm and account type. Some firms restore an inactive account, others retire it and require a new one. Check your firm's current rules rather than assuming.",
        "Once the firm confirms the hold is lifted, fully log out of every Tradovate surface (web, desktop, mobile, and any linked TradingView session), then log back in with the firm-issued credentials.",
      ],
    },
    { type: "heading", text: "Fixing a standalone Tradovate simulation account" },
    {
      type: "list",
      items: [
        "Verify it's a direct Tradovate simulation account and not a firm-issued one. If no prop firm is involved, Tradovate is the owner.",
        "Log out completely and confirm you're using the correct Tradovate credentials for the simulation account.",
        "Contact Tradovate support directly, quote the exact error, and ask whether the dormant account can be re-enabled.",
        "If reinstating the old sim isn't offered, start a fresh simulated-trading account. Tradovate's free simulation can be re-created, which restores immediate access to paper trading.",
        "Once you're back in, place a trade or at least sign in on a regular cadence so the account doesn't get re-flagged as inactive.",
      ],
    },
    { type: "heading", text: "Troubleshooting Table" },
    {
      type: "table",
      headers: ["Error / Symptom", "What it means", "Fix"],
      rows: [
        ["Your demo account has been disabled due to inactivity", "The account went dormant and was switched off by its owner", "Contact the account owner (prop firm or Tradovate) to reset or reinstate it"],
        ["Tradovate support redirects you to your prop firm", "Tradovate is only the platform; the firm owns the evaluation account", "Open the ticket with your prop firm and request a reset"],
        ["Account still disabled after the firm &ldquo;reset&rdquo; it", "Reinstatement policy varies, or the reset hasn't propagated yet", "Confirm status with the firm; fully log out and back in; ask if a new account is required"],
        ["Login fails but no inactivity message", "Wrong credentials or an expired/held account", "Sign in with the firm-issued login; verify the account hasn't expired or been flagged"],
        ["Repeated inactivity disables on the same account", "The account keeps sitting idle between sessions", "Trade or log in on a regular cadence; automate entries so it stays active"],
      ],
    },
    { type: "heading", text: "Prevent This with PickMyTrade" },
    { type: "paragraph", html: "An account gets flagged for inactivity because it sits idle, so the durable fix is to keep it genuinely, consistently traded. PickMyTrade links your TradingView strategy alerts straight through to Tradovate so your plan actually fires instead of waiting on you to be at the screen:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Hands-Off Execution</strong>, TradingView alerts route to your Tradovate account automatically, so the account keeps trading on schedule instead of going dormant.",
        "<strong class='text-white'>Multi-Account Sync</strong>, mirror the same strategy across several evaluation or funded accounts so none of them drift into an idle, disable-prone state.",
        "<strong class='text-white'>Risk &amp; Entitlement Awareness</strong>, routing respects your account's limits and data-agreement state, so orders go out clean rather than bouncing.",
        "<strong class='text-white'>Rate-Limit-Safe Routing</strong>, order flow is spaced out to stay within Tradovate's limits, avoiding the retry storms that create separate lockouts.",
      ],
    },
    { type: "paragraph", html: "Keeping an account active won't override a prop firm's inactivity policy, but a consistently traded account is far less likely to get flagged in the first place." },
  ], de: [
    { type: "paragraph", html: "Sie setzen sich hin, um Ihre Evaluierung zu handeln, melden sich an, und statt eines Live-DOM stoßen Sie auf eine Wand: &ldquo;Your demo account has been disabled due to inactivity.&rdquo; Nichts lädt. Keine Order wird geroutet. Und die Uhr Ihrer Prop-Firm-Challenge läuft weiter. Das Frustrierende daran: Die Lösung liegt fast nie bei Tradovate. Das Konto wurde von dem deaktiviert, dem es gehört, und das ist meist Ihre Prop-Firm. Hier erfahren Sie genau, was die Meldung bedeutet, warum Tradovate sie nicht einfach zurückschalten kann, und den schrittweisen Weg zur Wiederherstellung – plus, wie das Automatisieren Ihrer Einstiege mit PickMyTrade ein Konto so aktiv hält, dass es erst gar nicht so leicht in den Ruhezustand fällt." },
    {
      type: "checklist",
      heading: "Schnelle Checkliste für ein deaktiviertes Tradovate-Demo-Konto",
      items: [
        "<strong class='text-white'>Finden Sie heraus, wem das Konto gehört.</strong> Ob es sich um eine Prop-Firm-Evaluierung (Apex, Topstep und Ähnliche) oder ein eigenständiges Tradovate-Simulationskonto handelt, entscheidet, wen Sie kontaktieren müssen.",
        "<strong class='text-white'>Hören Sie auf, sich ständig neu anzumelden.</strong> Das Konto ist serverseitig deaktiviert. Wiederholte Versuche aktivieren es nicht erneut und können zusätzlich eine separate Login-Sperre auslösen.",
        "<strong class='text-white'>Wenden Sie sich bei einem Evaluierungskonto zuerst an Ihre Prop-Firm.</strong> Der Tradovate-Support leitet solche Tickets in der Regel direkt an die Firma zurück, die das Konto ausgestellt hat.",
        "<strong class='text-white'>Fragen Sie gezielt nach einem Reset oder einer Wiederherstellung.</strong> Die Firma hat die Sperre veranlasst, also kann nur sie (oder ein neues Konto) sie aufheben.",
        "<strong class='text-white'>Prüfen Sie, ob das Konto überhaupt noch aktiv ist.</strong> Manche Firmen legen inaktive Konten vollständig still oder lassen sie ablaufen, und die Regeln zur Wiederherstellung unterscheiden sich je nach Firma und Plan.",
        "<strong class='text-white'>Schließen Sie eine andere Ursache aus.</strong> Eine unbezahlte Abonnementgebühr, eine Sicherheitsmarkierung oder eine falsche Anmeldung können sich alle wie eine &ldquo;Inaktivitäts&rdquo;-Sperre darstellen.",
      ],
    },
    { type: "heading", text: "Was &ldquo;Your Demo Account Has Been Disabled Due to Inactivity&rdquo; bedeutet" },
    { type: "paragraph", html: "Diese Meldung bedeutet, dass das simulierte Konto (Paper-Konto), das Sie öffnen möchten, serverseitig abgeschaltet wurde und laut Tradovate-Aufzeichnungen lange genug ungenutzt war, um als ruhend markiert zu werden. Es handelt sich weder um einen Fehler noch um ein Verbindungsproblem noch um etwas, das ein Neuladen behebt. Das Konto trägt einen expliziten &ldquo;deaktiviert&rdquo;-Status." },
    { type: "paragraph", html: "Was die meisten Trader übersehen, ist die Eigentumsfrage. Wenn Sie ein Combine, eine Evaluierung oder eine finanzierte Challenge bei einer Prop-Firm kaufen, richtet diese Firma Ihr Konto ein und lässt Sie über Tradovate als Plattform handeln. Tradovate ist die Handelsoberfläche; die Prop-Firm ist der Kontoinhaber. Ruhende Konten kosten weiterhin Geld – unter anderem Marktdaten-Lizenzierung und Plattform-Provisionierung –, weshalb der Kontoinhaber, Ihre Prop-Firm, es nach einer Phase der Inaktivität deaktiviert. Deshalb werden Trader, die diesen Fehler beim Tradovate-Support melden, an ihre Firma zurückverwiesen. Tradovate kann kein Konto wiederherstellen, das ihm nicht gehört." },
    { type: "paragraph", html: "Es gibt auch den einfachen eigenständigen Fall. Wenn Sie direkt ein kostenloses Tradovate-Simulationskonto eröffnet haben, ohne eine Firma dazwischen, kann derselbe Status &ldquo;wegen Inaktivität deaktiviert&rdquo; auftreten, sobald das Konto längere Zeit ungenutzt war. Hier ist Tradovate selbst der Eigentümer, also führt der Weg zurück über den Tradovate-Support oder einfach über die Neueröffnung einer Simulation." },
    { type: "heading", text: "Häufigste Ursachen für ein deaktiviertes Tradovate-Demo-Konto" },
    { type: "heading", text: "1. Ein Prop-Firm-Evaluierungskonto wurde gesperrt" },
    { type: "paragraph", html: "Dies ist mit Abstand die häufigste Ursache im Jahr 2026. Firmen wie Apex und Topstep vergeben Evaluierungs- und finanzierte Konten, die auf Tradovate laufen. Bleibt eines dieser Konten eine Weile ungenutzt, deaktiviert die Firma es, um nicht weiter für die Bereitstellung eines ruhenden Kontos zu zahlen. Das Konto existiert weiterhin, befindet sich aber in einem gesperrten Zustand, den nur die Firma aufheben kann. Wenden Sie sich damit an den Tradovate-Support, werden Sie direkt an die Prop-Firma zurückverwiesen." },
    { type: "heading", text: "2. Ein eigenständiges Tradovate-Simulationskonto wurde inaktiv" },
    { type: "paragraph", html: "Wenn Sie sich für Tradovates eigenes kostenloses Simulationskonto angemeldet und es ungenutzt gelassen haben, kann es auf Tradovate-Seite wegen Inaktivität markiert werden. Hier ist kein Dritter im Spiel. Tradovate ist der Eigentümer, also läuft die Lösung über Tradovate und nicht über eine Firma." },
    { type: "heading", text: "3. An das Konto gebundene Marktdaten- oder Plattformlizenzierung" },
    { type: "paragraph", html: "Live-Futures-Daten sind mit wiederkehrenden Börsenlizenzkosten verbunden, unabhängig davon, ob Sie aktiv handeln oder nicht. Das Deaktivieren eines inaktiven Kontos ist die Art und Weise, wie der Eigentümer vermeidet, weiterhin für Berechtigungen und Bereitstellung bei etwas zu zahlen, das niemand nutzt. Deshalb löst gezielt &ldquo;Inaktivität&rdquo; die Abschaltung aus und nicht ein zufälliger Fehler." },
    { type: "heading", text: "4. Falsche Anmeldedaten, abgelaufenes Konto oder eine separate Markierung" },
    { type: "paragraph", html: "Manchmal ist das Konto gar nicht deaktiviert. Möglicherweise melden Sie sich mit den falschen Zugangsdaten an, einem persönlichen Tradovate-Login statt dem von der Firma ausgestellten, oder die Evaluierung ist planmäßig abgelaufen und nicht wegen Inaktivität. Auch eine überfällige Abonnementzahlung oder eine Sicherheitssperre kann sich wie eine Inaktivitätssperre darstellen. Bestätigen Sie den tatsächlichen Status des Kontos beim Eigentümer, um diese Möglichkeiten auszuschließen, bevor Sie &ldquo;Inaktivität&rdquo; als alleinige Erklärung annehmen." },
    { type: "heading", text: "So beheben Sie ein deaktiviertes Tradovate-Demo-Konto: Schritt für Schritt" },
    { type: "heading", text: "Ein Prop-Firm-Evaluierungskonto beheben" },
    {
      type: "list",
      items: [
        "Bestätigen Sie, welche Firma das Konto ausgestellt hat (Apex, Topstep oder die jeweilige Firma, bei der Sie gekauft haben). Die Firma, nicht Tradovate, ist der Kontoinhaber.",
        "Öffnen Sie eine Support-Anfrage im eigenen Hilfeportal oder Dashboard dieser Firma, nicht bei Tradovate. Wenden Sie sich zuerst an Tradovate, werden Sie einfach wieder an die Firma verwiesen.",
        "Zitieren Sie den genauen Fehlertext, &ldquo;Your demo account has been disabled due to inactivity&rdquo;, und bitten Sie um ein <strong class='text-white'>Zurücksetzen oder eine Wiederherstellung</strong> des Kontos. Konkrete Angaben zum Reset beschleunigen die Bearbeitung des Tickets.",
        "Fragen Sie, ob ein Reset für Ihren Plan überhaupt möglich ist. Die Wiederherstellungsrichtlinien variieren je nach Firma und Kontotyp. Manche Firmen stellen ein inaktives Konto wieder her, andere legen es still und verlangen ein neues. Prüfen Sie die aktuellen Regeln Ihrer Firma, statt es anzunehmen.",
        "Sobald die Firma bestätigt, dass die Sperre aufgehoben wurde, melden Sie sich vollständig von jeder Tradovate-Oberfläche ab (Web, Desktop, Mobil und jede verknüpfte TradingView-Sitzung) und dann mit den von der Firma ausgestellten Zugangsdaten wieder an.",
      ],
    },
    { type: "heading", text: "Ein eigenständiges Tradovate-Simulationskonto beheben" },
    {
      type: "list",
      items: [
        "Prüfen Sie, ob es sich um ein direktes Tradovate-Simulationskonto und nicht um ein von einer Firma ausgestelltes Konto handelt. Ist keine Prop-Firm beteiligt, ist Tradovate der Eigentümer.",
        "Melden Sie sich vollständig ab und bestätigen Sie, dass Sie die richtigen Tradovate-Zugangsdaten für das Simulationskonto verwenden.",
        "Wenden Sie sich direkt an den Tradovate-Support, zitieren Sie den genauen Fehler und fragen Sie, ob das ruhende Konto reaktiviert werden kann.",
        "Wird die Wiederherstellung der alten Simulation nicht angeboten, eröffnen Sie ein neues Simulationskonto. Tradovates kostenlose Simulation kann neu erstellt werden, wodurch der sofortige Zugang zum Paper-Trading wiederhergestellt wird.",
        "Sobald Sie wieder Zugang haben, tätigen Sie einen Trade oder melden Sie sich zumindest regelmäßig an, damit das Konto nicht erneut als inaktiv markiert wird.",
      ],
    },
    { type: "heading", text: "Fehlerbehebungstabelle" },
    {
      type: "table",
      headers: ["Fehler / Symptom", "Was es bedeutet", "Lösung"],
      rows: [
        ["Your demo account has been disabled due to inactivity", "Das Konto wurde ruhend und vom Eigentümer abgeschaltet", "Kontaktieren Sie den Kontoinhaber (Prop-Firma oder Tradovate), um es zurückzusetzen oder wiederherzustellen"],
        ["Der Tradovate-Support verweist Sie an Ihre Prop-Firma", "Tradovate ist nur die Plattform; die Firma besitzt das Evaluierungskonto", "Öffnen Sie das Ticket bei Ihrer Prop-Firma und fordern Sie einen Reset an"],
        ["Konto weiterhin deaktiviert, nachdem die Firma es &ldquo;zurückgesetzt&rdquo; hat", "Die Wiederherstellungsrichtlinie variiert, oder der Reset hat sich noch nicht ausgewirkt", "Status bei der Firma bestätigen; vollständig ab- und wieder anmelden; fragen, ob ein neues Konto nötig ist"],
        ["Anmeldung schlägt fehl, aber keine Inaktivitätsmeldung", "Falsche Zugangsdaten oder ein abgelaufenes/gesperrtes Konto", "Mit den von der Firma ausgestellten Zugangsdaten anmelden; prüfen, ob das Konto abgelaufen oder markiert ist"],
        ["Wiederholte Inaktivitätsdeaktivierungen beim gleichen Konto", "Das Konto bleibt zwischen den Sitzungen immer wieder ungenutzt", "Regelmäßig handeln oder sich anmelden; Einstiege automatisieren, damit es aktiv bleibt"],
      ],
    },
    { type: "heading", text: "So verhindern Sie das mit PickMyTrade" },
    { type: "paragraph", html: "Ein Konto wird wegen Inaktivität markiert, weil es ungenutzt bleibt – die dauerhafte Lösung besteht darin, es tatsächlich und konsequent zu handeln. PickMyTrade verbindet Ihre TradingView-Strategie-Alerts direkt mit Tradovate, sodass Ihr Plan tatsächlich ausgeführt wird, statt darauf zu warten, dass Sie am Bildschirm sitzen:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Hands-Off-Ausführung</strong> – TradingView-Alerts werden automatisch an Ihr Tradovate-Konto weitergeleitet, sodass das Konto planmäßig weiterhandelt, statt in den Ruhezustand zu fallen.",
        "<strong class='text-white'>Multi-Konto-Synchronisierung</strong> – spiegeln Sie dieselbe Strategie auf mehrere Evaluierungs- oder finanzierte Konten, damit keines davon in einen inaktiven, deaktivierungsanfälligen Zustand abdriftet.",
        "<strong class='text-white'>Risiko- &amp; Berechtigungsbewusstsein</strong> – das Routing respektiert die Limits und den Status der Datenvereinbarung Ihres Kontos, sodass Orders sauber hinausgehen, statt abzuprallen.",
        "<strong class='text-white'>Rate-Limit-sicheres Routing</strong> – der Orderfluss wird zeitlich gestaffelt, um innerhalb der Tradovate-Limits zu bleiben, und vermeidet so Retry-Stürme, die separate Sperren verursachen.",
      ],
    },
    { type: "paragraph", html: "Ein aktiv gehaltenes Konto hebelt nicht die Inaktivitätsrichtlinie einer Prop-Firma aus, aber ein konsequent gehandeltes Konto wird von vornherein deutlich seltener markiert." },
  ], es: [
    { type: "paragraph", html: "Se sienta a operar su evaluación, inicia sesión, y en lugar de un DOM en vivo se encuentra con un muro: &ldquo;Your demo account has been disabled due to inactivity.&rdquo; Nada carga. Ninguna orden se enruta. Y el reloj de su desafío de la prop firm sigue corriendo. Lo más frustrante es que la solución casi nunca depende de Tradovate. La cuenta fue deshabilitada por quien la posee, y normalmente esa es su prop firm. A continuación se explica exactamente qué significa el mensaje, por qué Tradovate no puede simplemente reactivarla, y los pasos exactos para recuperar el acceso, además de cómo automatizar sus entradas con PickMyTrade mantiene una cuenta lo bastante activa como para que rara vez quede inactiva." },
    {
      type: "checklist",
      heading: "Lista de verificación rápida para una cuenta demo de Tradovate deshabilitada",
      items: [
        "<strong class='text-white'>Averigüe quién es el propietario de la cuenta.</strong> Que se trate de una evaluación de una prop firm (Apex, Topstep y similares) o de una cuenta de simulación independiente de Tradovate determina a quién debe contactar.",
        "<strong class='text-white'>Deje de insistir con el inicio de sesión.</strong> La cuenta está deshabilitada del lado del servidor. Reintentar no la reactivará y puede provocar un bloqueo de inicio de sesión adicional además del problema original.",
        "<strong class='text-white'>Si es una cuenta de evaluación, contacte primero a su prop firm.</strong> El soporte de Tradovate suele devolver estos tickets directamente a la firma que emitió la cuenta.",
        "<strong class='text-white'>Pida específicamente un reinicio o una reactivación.</strong> La firma impuso la retención, así que solo ella (o una cuenta nueva) puede levantarla.",
        "<strong class='text-white'>Confirme si la cuenta sigue activa siquiera.</strong> Algunas firmas retiran o hacen expirar por completo las cuentas inactivas, y las reglas de reactivación varían según la firma y el plan.",
        "<strong class='text-white'>Descarte otra causa.</strong> Una suscripción impaga, una marca de seguridad o iniciar sesión con las credenciales equivocadas pueden disfrazarse todas de un bloqueo por &ldquo;inactividad&rdquo;.",
      ],
    },
    { type: "heading", text: "Qué significa &ldquo;Your Demo Account Has Been Disabled Due to Inactivity&rdquo;" },
    { type: "paragraph", html: "Este mensaje significa que la cuenta simulada (paper) que intenta abrir se apagó en el servidor, y los registros de Tradovate muestran que estuvo sin usar el tiempo suficiente como para marcarla como inactiva. No es un error, ni un problema de conectividad, ni algo que se soluciona recargando la página. La cuenta lleva un estado explícito de &ldquo;deshabilitada&rdquo;." },
    { type: "paragraph", html: "Lo que la mayoría de los traders pasa por alto es la propiedad. Cuando compra un Combine, una evaluación o un desafío financiado a una prop firm, esa firma aprovisiona su cuenta y le permite operarla a través de Tradovate como plataforma. Tradovate es la interfaz de trading; la prop firm es la titular de la cuenta. Las cuentas inactivas siguen costando dinero mantenerlas activas, entre ellos la licencia de datos de mercado y el aprovisionamiento de la plataforma, así que el propietario de la cuenta, su prop firm, es quien la deshabilita tras un periodo de inactividad. Por eso los traders que llevan este error al soporte de Tradovate son remitidos de vuelta a su firma. Tradovate no puede restaurar una cuenta que no le pertenece." },
    { type: "paragraph", html: "También existe el caso independiente y sencillo. Si abrió directamente una cuenta de simulación gratuita de Tradovate, sin pasar por ninguna firma, puede aparecer el mismo estado de &ldquo;deshabilitada por inactividad&rdquo; una vez que la cuenta ha estado inactiva. Aquí el propio Tradovate es el propietario, así que el soporte de Tradovate, o simplemente crear una nueva simulación, es el camino de regreso." },
    { type: "heading", text: "Principales causas de una cuenta demo de Tradovate deshabilitada" },
    { type: "heading", text: "1. Una cuenta de evaluación de una prop firm quedó en espera" },
    { type: "paragraph", html: "Esta es, con diferencia, la causa más común en 2026. Firmas como Apex y Topstep emiten cuentas de evaluación y financiadas que funcionan sobre Tradovate. Cuando una de esas cuentas permanece sin usar durante un tiempo, la firma la deshabilita para dejar de pagar por mantener aprovisionada una cuenta inactiva. La cuenta sigue existiendo, pero está en un estado de retención que solo la firma puede liberar. Si lleva esto al soporte de Tradovate, lo redirigirán directamente de vuelta a la prop firm." },
    { type: "heading", text: "2. Una cuenta de simulación independiente de Tradovate quedó inactiva" },
    { type: "paragraph", html: "Si se registró para la propia cuenta de trading simulado gratuita de Tradovate y la dejó inactiva, puede marcarse por inactividad del lado de Tradovate. Aquí no hay ningún tercero. Tradovate es el propietario, así que la solución pasa por Tradovate y no por una firma." },
    { type: "heading", text: "3. Licencias de datos de mercado o de la plataforma vinculadas a la cuenta" },
    { type: "paragraph", html: "Los datos de futuros en vivo conllevan costos de licencia de la bolsa que se repiten, opere o no activamente. Deshabilitar una cuenta inactiva es la forma en que el propietario evita seguir pagando por mantener activos los derechos y el aprovisionamiento de algo que nadie está usando. Por eso es específicamente la &ldquo;inactividad&rdquo; la que desencadena el cierre y no un error aleatorio." },
    { type: "heading", text: "4. Inicio de sesión incorrecto, cuenta expirada o una marca independiente" },
    { type: "paragraph", html: "A veces la cuenta no está deshabilitada en absoluto. Puede que esté iniciando sesión con las credenciales equivocadas, un login personal de Tradovate en lugar del emitido por la firma, o que la evaluación haya expirado según lo programado en lugar de por inactividad. Un pago de suscripción vencido o una retención de seguridad también pueden manifestarse como un bloqueo que parece inactividad. Confirmar el estado real de la cuenta con el propietario descarta estas opciones antes de asumir que la &ldquo;inactividad&rdquo; es toda la historia." },
    { type: "heading", text: "Cómo solucionar una cuenta demo de Tradovate deshabilitada: paso a paso" },
