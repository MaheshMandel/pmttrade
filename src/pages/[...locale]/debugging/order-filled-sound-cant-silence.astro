---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "order-filled-sound-cant-silence";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/debugging/${SLUG}`;

const META_TITLE = "Tradovate 'ORDER FILLED' Sound Won't Turn Off";
const META_DESCRIPTION =
  "Order-filled sound still blaring after you turned off every notification? Web and desktop ways to silence it, plus when it's a defect to report.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Tradovate „ORDER FILLED“-Ton lässt sich nicht abschalten", es: "El sonido «ORDER FILLED» de Tradovate no se apaga", fr: "Le son « ORDER FILLED » de Tradovate ne s'éteint pas", it: "Il suono «ORDER FILLED» di Tradovate non si disattiva" },
  dek: { en: "You flipped off every notification toggle you could find, and the ORDER FILLED chime still fires on every fill. Here's the in-app fix, the fallbacks, and when to report it as a defect.", de: "Sie haben jeden Benachrichtigungsschalter ausgeschaltet, den Sie finden konnten, und der ORDER-FILLED-Signalton ertönt trotzdem bei jeder Ausführung. Hier sind die Lösung in der App, die Ausweichmöglichkeiten und der Zeitpunkt, an dem Sie es als Fehler melden sollten.", es: "Ha desactivado todos los interruptores de notificación que encontró y el tono ORDER FILLED sigue sonando en cada ejecución. Aquí tiene la solución dentro de la aplicación, las alternativas y cuándo informarlo como defecto.", fr: "Vous avez désactivé tous les interrupteurs de notification que vous avez trouvés, et le carillon ORDER FILLED retentit toujours à chaque exécution. Voici la solution dans l'application, les solutions de repli et le moment où le signaler comme un défaut.", it: "Ha disattivato tutti gli interruttori di notifica che ha trovato e il segnale ORDER FILLED suona ancora a ogni esecuzione. Ecco la soluzione nell'app, le alternative e quando segnalarlo come difetto." },
  readTime: { en: "6 min read", de: "6 Min. Lesezeit", es: "Lectura de 6 min", fr: "Lecture : 6 min", it: "Lettura di 6 min" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "You flipped off every notification toggle you could find, and that &ldquo;ORDER FILLED&rdquo; chime still fires on every single fill. If you run any kind of automation it's worse, because your strategy rattles off orders and the platform jumpscares you each time one hits. Here's the short version. The switch that's supposed to kill it lives under Application Settings, and most of the time flipping it off does the job. When it doesn't, and there are cases where it flat out won't, you drop down to muting the platform at the browser or operating-system level and you report the miss to support, because there's no single documented setting that reliably covers this." },
    { type: "paragraph", html: "This guide walks the in-app path first, then the fallbacks that actually silence the sound when the toggle refuses to stick, and finally what to send support so it gets fixed properly instead of you living with a muted tab forever." },
    { type: "heading", text: "The Setting That's Supposed to Silence It" },
    { type: "paragraph", html: "Start with the built-in control, because for a lot of people it's the whole fix. In the web trader, click the <strong class='text-white'>Application Settings</strong> button (the gear) in the top-right corner of the screen." },
    { type: "paragraph", html: "Open the <strong class='text-white'>Preferences</strong> tab, then scroll down to the <strong class='text-white'>Notifications</strong> section. There's an <strong class='text-white'>Order Notifications</strong> toggle here. Turning it off stops the order status pop-ups and their sounds in one move. If your only goal is silence, that's the switch to flip." },
    { type: "paragraph", html: "If you'd rather keep some notifications and only kill the fill sound, don't flip the master toggle. Click <strong class='text-white'>Advanced Configuration</strong> instead. That opens a per-status list where you can toggle each order status on its own, and for each one you can turn the audio on or off, test the sound, and swap it for a different file (the platform ships with more than a dozen sound options). Find the status that maps to a fill, mute its audio, and leave the rest alone." },
    { type: "paragraph", html: "One more control worth knowing about: the <strong class='text-white'>Notification Ticker</strong> toggle. That removes the whole panel that carries the clock and these status messages, which is handy if you want the visual noise gone along with the sound. Labels and exact placement shift between platform builds, so if a name here doesn't match what's on your screen, look for the closest equivalent under Application Settings and the Notifications area." },
    { type: "heading", text: "When the Toggle Doesn't Stick" },
    { type: "paragraph", html: "Here's the frustrating part, and the reason this page exists. There are setups where you turn off every sound notification you can find, in both the main settings and the advanced ones, on a live account and on a simulated one, and the &ldquo;ORDER FILLED&rdquo; sound keeps playing anyway. The web app doesn't give you a master volume slider to fall back on, so once the toggle is ignored you're out of in-app options. That's a genuine gap. It isn't your setup being wrong, and it's the specific behavior you should flag to support (more on that below)." },
    { type: "paragraph", html: "Before you assume it's the defect, rule out the boring causes first. If you have Tradovate open in more than one place at once (a second browser tab, the desktop app, mobile, or a linked charting platform), the sound might be coming from a session you forgot about. Close the extras and test again. A stale browser session can also hold onto old settings, so a hard refresh and a fresh login sometimes clears it. And double-check you actually saved the change, since flipping a toggle and navigating away without confirming can leave the old state in place." },
    { type: "heading", text: "Silence It in the Browser (Web App)" },
    { type: "paragraph", html: "If you're on the web version and the in-app toggle won't cooperate, the fastest hard mute is at the browser level. Right-click the tab where the platform is open and choose <strong class='text-white'>Mute site</strong> (some browsers word it &ldquo;Mute tab&rdquo;). Every sound from that tab stops immediately." },
    { type: "paragraph", html: "A couple of related moves in the same vein:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Site sound permission.</strong> In your browser's site settings for the Tradovate URL, set Sound to &ldquo;Mute.&rdquo; This survives tab reloads, unlike a one-off tab mute that can reset.",
        "<strong class='text-white'>Clear cache and cookies, then log back in.</strong> If a stale session is the culprit rather than the underlying defect, a clean login can restore your saved sound preferences.",
      ],
    },
    { type: "paragraph", html: "The trade-off with any browser-level mute is that it's all or nothing. It kills the fill chime, but it also silences price alerts, drawing alerts, and anything else the platform plays in that tab. If you lean on audible price alerts, weigh that before you reach for the mute. It's worth deciding which sounds you actually want before you nuke all of them." },
    { type: "heading", text: "Silence It at the OS Level (Desktop App)" },
    { type: "paragraph", html: "The desktop app gives you something the web app doesn't: a real volume you can dial down instead of a blunt on/off. On Windows, open the <strong class='text-white'>Volume Mixer</strong> (right-click the speaker icon in the system tray, choose Open Volume Mixer, or find it under Sound settings), locate Tradovate in the per-app list, and drop its slider. Setting it low rather than fully muted, around ten percent, keeps the sound present but quiet enough that a burst of algo fills won't blow you out of your chair." },
    { type: "paragraph", html: "On macOS there's no built-in per-app volume, so you're back to the in-app toggles or a third-party audio mixer. Either way, the desktop path is the more flexible one when you want to soften the fill sound without losing every other cue." },
    { type: "heading", text: "Web vs Desktop: What You Can Actually Control" },
    {
      type: "table",
      headers: ["Control", "Web app", "Desktop app"],
      rows: [
        ["Turn order notifications off", "Yes (Application Settings)", "Yes (Application Settings)"],
        ["Mute a single order status", "Yes (Advanced Configuration)", "Yes (Advanced Configuration)"],
        ["Adjust the actual volume", "No master volume", "Yes, via the OS volume mixer"],
        ["Hard mute everything fast", "Right-click tab &gt; Mute site", "Mute the app in the OS mixer"],
      ],
    },
    { type: "heading", text: "Report It to Tradovate Support" },
    { type: "paragraph", html: "If you've turned off the order sound in both the standard and advanced settings and it still plays, that's not documented behavior with a clean fix, so open a ticket. The mute workarounds keep you sane in the meantime, but a support report is the only path to an actual repair. Make the ticket easy to act on by including:" },
    {
      type: "list",
      items: [
        "The platform and build you're on (web, desktop, or mobile), and your browser if it's the web app.",
        "Whether it happens on a live account, a simulated one, or both.",
        "Exactly which toggles you turned off, ideally with a screenshot of the Notifications section and the Advanced Configuration panel showing them disabled.",
        "Whether a hard refresh or fresh login changed anything.",
      ],
    },
    { type: "paragraph", html: "If you're on a prop-firm evaluation account, note that too, since some settings and support routing differ by firm. Rules and available controls vary by firm and account size, so check your firm's current setup if something looks locked down that shouldn't be." },
    { type: "paragraph", html: "And if you got here because you're already automating from TradingView, the setup side of that is worth getting right too, so the orders that trigger the sound are at least firing exactly the way you intend." },
  ], de: [
    { type: "paragraph",html: "Sie haben jeden Benachrichtigungsschalter ausgeschaltet, den Sie finden konnten, und dieser &ldquo;ORDER FILLED&rdquo;-Signalton ertönt trotzdem bei jeder einzelnen Ausführung. Wenn Sie irgendeine Art von Automatisierung nutzen, ist es noch schlimmer, denn Ihre Strategie feuert Orders ab, und die Plattform erschreckt Sie bei jedem Treffer. Hier die Kurzfassung. Der Schalter, der den Ton ausschalten soll, befindet sich unter Application Settings, und meistens erledigt das Ausschalten die Sache. Wenn nicht, und es gibt Fälle, in denen es schlicht nicht klappt, weichen Sie auf die Stummschaltung der Plattform auf Browser- oder Betriebssystemebene aus und melden das dem Support, denn es gibt keine einzelne dokumentierte Einstellung, die das zuverlässig abdeckt." },
    { type: "paragraph",html: "Diese Anleitung führt zuerst durch den Weg in der App, dann durch die Ausweichmöglichkeiten, die den Ton tatsächlich stumm schalten, wenn der Schalter nicht hält, und schließlich dazu, was Sie dem Support schicken sollten, damit es richtig behoben wird, statt dass Sie für immer mit einem stummgeschalteten Tab leben." },
    { type: "heading",text: "Die Einstellung, die ihn eigentlich abschalten soll" },
    { type: "paragraph",html: "Beginnen Sie mit der eingebauten Steuerung, denn für viele ist sie die ganze Lösung. Klicken Sie im Web-Trader oben rechts auf dem Bildschirm auf die Schaltfläche <strong class='text-white'>Application Settings</strong> (das Zahnrad)." },
    { type: "paragraph",html: "Öffnen Sie den Tab <strong class='text-white'>Preferences</strong> und scrollen Sie dann nach unten zum Abschnitt <strong class='text-white'>Notifications</strong>. Dort gibt es einen Schalter <strong class='text-white'>Order Notifications</strong>. Wenn Sie ihn ausschalten, werden die Order-Status-Pop-ups und ihre Töne auf einmal abgestellt. Wenn Ihr einziges Ziel Ruhe ist, ist das der Schalter, den Sie umlegen sollten." },
    { type: "paragraph",html: "Wenn Sie lieber einige Benachrichtigungen behalten und nur den Ausführungston abschalten möchten, legen Sie nicht den Hauptschalter um. Klicken Sie stattdessen auf <strong class='text-white'>Advanced Configuration</strong>. Dort öffnet sich eine Liste pro Status, in der Sie jeden Orderstatus einzeln umschalten können, und für jeden können Sie den Ton ein- oder ausschalten, ihn testen und durch eine andere Datei ersetzen (die Plattform liefert mehr als ein Dutzend Soundoptionen mit). Suchen Sie den Status, der einer Ausführung entspricht, schalten Sie dessen Ton stumm und lassen Sie den Rest unverändert." },
    { type: "paragraph",html: "Eine weitere Steuerung, die man kennen sollte: der Schalter <strong class='text-white'>Notification Ticker</strong>. Er entfernt das gesamte Panel, das die Uhr und diese Statusmeldungen trägt, was praktisch ist, wenn Sie das visuelle Rauschen zusammen mit dem Ton loswerden möchten. Bezeichnungen und genaue Platzierung ändern sich zwischen Plattform-Builds. Wenn ein hier genannter Name nicht mit dem auf Ihrem Bildschirm übereinstimmt, suchen Sie unter Application Settings und im Bereich Notifications nach der nächstliegenden Entsprechung." },
    { type: "heading",text: "Wenn der Schalter nicht hält" },
    { type: "paragraph",html: "Und jetzt der frustrierende Teil, der Grund, warum diese Seite existiert. Es gibt Konstellationen, in denen Sie jede Tonbenachrichtigung ausschalten, die Sie finden können, sowohl in den Haupt- als auch in den erweiterten Einstellungen, auf einem Live-Konto und auf einem Simulationskonto, und der &ldquo;ORDER FILLED&rdquo;-Ton spielt trotzdem weiter. Die Web-App bietet Ihnen keinen Gesamtlautstärkeregler als Ausweichmöglichkeit, sodass Ihnen, sobald der Schalter ignoriert wird, die In-App-Optionen ausgehen. Das ist eine echte Lücke. Es liegt nicht an Ihrer Einrichtung, und es ist genau das Verhalten, das Sie dem Support melden sollten (mehr dazu unten)." },
    { type: "paragraph",html: "Bevor Sie annehmen, dass es der Fehler ist, schließen Sie zuerst die banalen Ursachen aus. Wenn Sie Tradovate an mehr als einer Stelle gleichzeitig geöffnet haben (ein zweiter Browser-Tab, die Desktop-App, Mobil oder eine verknüpfte Charting-Plattform), kann der Ton aus einer Sitzung kommen, die Sie vergessen haben. Schließen Sie die zusätzlichen und testen Sie erneut. Eine veraltete Browser-Sitzung kann außerdem alte Einstellungen festhalten, sodass ein harter Refresh und eine frische Anmeldung es manchmal beheben. Und prüfen Sie noch einmal, ob Sie die Änderung tatsächlich gespeichert haben, denn einen Schalter umzulegen und wegzunavigieren, ohne zu bestätigen, kann den alten Zustand bestehen lassen." },
    { type: "heading",text: "Im Browser stummschalten (Web-App)" },
    { type: "paragraph",html: "Wenn Sie die Web-Version nutzen und der Schalter in der App nicht mitspielt, ist die schnellste harte Stummschaltung die auf Browser-Ebene. Klicken Sie mit der rechten Maustaste auf den Tab, in dem die Plattform geöffnet ist, und wählen Sie <strong class='text-white'>Mute site</strong> (einige Browser nennen es &ldquo;Mute tab&rdquo;). Jeder Ton aus diesem Tab stoppt sofort." },
    { type: "paragraph",html: "Ein paar verwandte Möglichkeiten in diesem Sinne:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Website-Tonberechtigung.</strong> Setzen Sie in den Website-Einstellungen Ihres Browsers für die Tradovate-URL den Ton auf &ldquo;Mute&rdquo;. Das übersteht das Neuladen von Tabs, im Gegensatz zu einer einmaligen Tab-Stummschaltung, die zurückgesetzt werden kann.",
        "<strong class='text-white'>Cache und Cookies leeren, dann wieder anmelden.</strong> Wenn eine veraltete Sitzung der Verursacher ist und nicht der zugrunde liegende Fehler, kann eine saubere Anmeldung Ihre gespeicherten Toneinstellungen wiederherstellen.",
      ],
    },
    { type: "paragraph",html: "Der Nachteil jeder Stummschaltung auf Browser-Ebene ist, dass es ein Alles-oder-Nichts ist. Sie unterdrückt den Ausführungston, aber auch Preisalarme, Zeichnungsalarme und alles andere, was die Plattform in diesem Tab abspielt. Wenn Sie auf hörbare Preisalarme angewiesen sind, wägen Sie das ab, bevor Sie zur Stummschaltung greifen. Es lohnt sich zu entscheiden, welche Töne Sie tatsächlich behalten möchten, bevor Sie alle auf einmal abschalten." },
    { type: "heading",text: "Auf Betriebssystemebene stummschalten (Desktop-App)" },
    { type: "paragraph",html: "Die Desktop-App bietet Ihnen etwas, das die Web-App nicht hat: eine echte Lautstärke, die Sie herunterregeln können, statt nur ein stumpfes Ein/Aus. Öffnen Sie unter Windows den <strong class='text-white'>Lautstärkemixer</strong> (Rechtsklick auf das Lautsprechersymbol in der Taskleiste, Lautstärkemixer öffnen wählen oder in den Soundeinstellungen suchen), suchen Sie Tradovate in der Liste pro App und ziehen Sie dessen Regler herunter. Stellen Sie ihn eher niedrig als ganz stumm, etwa auf zehn Prozent, damit der Ton vorhanden, aber leise genug bleibt, dass eine Salve algorithmischer Ausführungen Sie nicht vom Stuhl haut." },
    { type: "paragraph",html: "Unter macOS gibt es keine eingebaute Lautstärke pro App, also bleiben Ihnen die Schalter in der App oder ein Audiomixer von Drittanbietern. So oder so ist der Desktop-Weg der flexiblere, wenn Sie den Ausführungston dämpfen möchten, ohne alle anderen Signale zu verlieren." },
    { type: "heading",text: "Web vs. Desktop: Was Sie tatsächlich steuern können" },
    { type: "table", headers: ["Steuerung","Web-App","Desktop-App"], rows: [
      ["Order-Benachrichtigungen ausschalten","Ja (Application Settings)","Ja (Application Settings)"],
      ["Einen einzelnen Orderstatus stummschalten","Ja (Advanced Configuration)","Ja (Advanced Configuration)"],
      ["Die tatsächliche Lautstärke anpassen","Keine Gesamtlautstärke","Ja, über den Lautstärkemixer des Betriebssystems"],
      ["Alles schnell hart stummschalten","Rechtsklick auf Tab &gt; Mute site","Die App im Mixer des Betriebssystems stummschalten"],
    ] },
    { type: "heading",text: "Beim Tradovate-Support melden" },
    { type: "paragraph",html: "Wenn Sie den Ordersound sowohl in den Standard- als auch in den erweiterten Einstellungen ausgeschaltet haben und er trotzdem ertönt, ist das kein dokumentiertes Verhalten mit einer sauberen Lösung. Eröffnen Sie also ein Ticket. Die Stummschaltungs-Workarounds halten Sie in der Zwischenzeit bei Verstand, aber eine Support-Meldung ist der einzige Weg zu einer tatsächlichen Reparatur. Machen Sie das Ticket leicht bearbeitbar, indem Sie Folgendes angeben:" },
    {
      type: "list",
      items: [
        "Die Plattform und den Build, den Sie nutzen (Web, Desktop oder Mobil), und Ihren Browser, falls es die Web-App ist.",
        "Ob es auf einem Live-Konto, einem Simulationskonto oder beiden auftritt.",
        "Genau welche Schalter Sie ausgeschaltet haben, idealerweise mit einem Screenshot des Bereichs Notifications und des Panels Advanced Configuration, in denen sie deaktiviert sind.",
        "Ob ein harter Refresh oder eine frische Anmeldung etwas verändert hat.",
      ],
    },
    { type: "paragraph",html: "Wenn Sie ein Prop-Firm-Evaluierungskonto nutzen, erwähnen Sie das ebenfalls, da sich einige Einstellungen und das Support-Routing je nach Firma unterscheiden. Regeln und verfügbare Steuerungen variieren je nach Firma und Kontogröße. Prüfen Sie daher die aktuelle Einrichtung Ihrer Firma, wenn etwas gesperrt aussieht, das es nicht sein sollte." },
    { type: "paragraph",html: "Und wenn Sie hier gelandet sind, weil Sie bereits aus TradingView automatisieren, lohnt es sich, auch die Einrichtung dieser Seite richtig zu machen, damit die Orders, die den Ton auslösen, zumindest genau so ausgeführt werden, wie Sie es beabsichtigen." },
  ], es: [
    { type: "paragraph",html: "Ha desactivado todos los interruptores de notificación que encontró y ese tono de &ldquo;ORDER FILLED&rdquo; sigue sonando en cada ejecución. Si usa cualquier tipo de automatización, es peor, porque su estrategia lanza órdenes una tras otra y la plataforma le sobresalta cada vez que una se ejecuta. Aquí va la versión corta. El interruptor que se supone que lo apaga se encuentra en Application Settings, y la mayoría de las veces desactivarlo basta. Cuando no es así, y hay casos en que simplemente no funciona, pase a silenciar la plataforma a nivel del navegador o del sistema operativo y comuníquelo a soporte, porque no existe un único ajuste documentado que lo cubra de forma fiable." },
    { type: "paragraph",html: "Esta guía recorre primero el camino dentro de la aplicación, después las alternativas que realmente silencian el sonido cuando el interruptor no se mantiene y, por último, qué enviar a soporte para que se corrija de verdad en lugar de vivir para siempre con una pestaña silenciada." },
    { type: "heading",text: "El ajuste que se supone que lo silencia" },
    { type: "paragraph",html: "Empiece por el control integrado, porque para muchas personas es toda la solución. En el trader web, haga clic en el botón <strong class='text-white'>Application Settings</strong> (el engranaje) en la esquina superior derecha de la pantalla." },
    { type: "paragraph",html: "Abra la pestaña <strong class='text-white'>Preferences</strong> y desplácese hacia abajo hasta la sección <strong class='text-white'>Notifications</strong>. Aquí hay un interruptor <strong class='text-white'>Order Notifications</strong>. Desactivarlo detiene las ventanas emergentes de estado de órdenes y sus sonidos de una vez. Si su único objetivo es el silencio, ese es el interruptor que debe pulsar." },
    { type: "paragraph",html: "Si prefiere conservar algunas notificaciones y silenciar solo el sonido de ejecución, no pulse el interruptor general. Haga clic en <strong class='text-white'>Advanced Configuration</strong> en su lugar. Eso abre una lista por estado donde puede activar o desactivar cada estado de orden por separado y, para cada uno, puede activar o desactivar el audio, probar el sonido y cambiarlo por otro archivo (la plataforma incluye más de una docena de opciones de sonido). Busque el estado que corresponde a una ejecución, silencie su audio y deje el resto como está." },
    { type: "paragraph",html: "Otro control que conviene conocer: el interruptor <strong class='text-white'>Notification Ticker</strong>. Elimina todo el panel que contiene el reloj y estos mensajes de estado, lo cual es útil si quiere que el ruido visual desaparezca junto con el sonido. Las etiquetas y la ubicación exacta cambian entre versiones de la plataforma, así que si algún nombre de aquí no coincide con lo que ve en pantalla, busque el equivalente más cercano en Application Settings y en el área de Notifications." },
    { type: "heading",text: "Cuando el interruptor no se mantiene" },
    { type: "paragraph",html: "Aquí viene la parte frustrante y el motivo de esta página. Hay configuraciones en las que desactiva todas las notificaciones de sonido que puede encontrar, tanto en los ajustes principales como en los avanzados, en una cuenta real y en una simulada, y el sonido de &ldquo;ORDER FILLED&rdquo; sigue sonando de todos modos. La aplicación web no le da un control de volumen general al que recurrir, así que, una vez que se ignora el interruptor, se queda sin opciones dentro de la aplicación. Es una carencia genuina. No es que su configuración esté mal, y es justo el comportamiento que debe señalar a soporte (más abajo)." },
    { type: "paragraph",html: "Antes de asumir que es el defecto, descarte primero las causas aburridas. Si tiene Tradovate abierto en más de un lugar a la vez (una segunda pestaña del navegador, la aplicación de escritorio, el móvil o una plataforma de gráficos vinculada), el sonido podría venir de una sesión que olvidó. Cierre las adicionales y pruebe de nuevo. Una sesión de navegador obsoleta también puede retener ajustes antiguos, por lo que un refresco forzado y un nuevo inicio de sesión a veces lo resuelven. Y compruebe que realmente guardó el cambio, ya que pulsar un interruptor y navegar a otra parte sin confirmar puede dejar el estado anterior." },
    { type: "heading",text: "Silenciarlo en el navegador (aplicación web)" },
    { type: "paragraph",html: "Si usa la versión web y el interruptor de la aplicación no coopera, el silenciado más rápido es a nivel del navegador. Haga clic derecho en la pestaña donde está abierta la plataforma y elija <strong class='text-white'>Mute site</strong> (algunos navegadores lo llaman &ldquo;Mute tab&rdquo;). Todo sonido de esa pestaña se detiene de inmediato." },
    { type: "paragraph",html: "Un par de medidas relacionadas en la misma línea:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Permiso de sonido del sitio.</strong> En la configuración del sitio de su navegador para la URL de Tradovate, establezca Sonido en &ldquo;Mute&rdquo;. Esto sobrevive a las recargas de pestañas, a diferencia del silenciado puntual de una pestaña, que puede restablecerse.",
        "<strong class='text-white'>Borre la caché y las cookies y vuelva a iniciar sesión.</strong> Si una sesión obsoleta es la culpable y no el defecto subyacente, un inicio de sesión limpio puede restaurar sus preferencias de sonido guardadas.",
      ],
    },
    { type: "paragraph",html: "La contrapartida de cualquier silenciado a nivel del navegador es que es todo o nada. Elimina el tono de ejecución, pero también silencia las alertas de precio, las alertas de dibujo y cualquier otra cosa que la plataforma reproduzca en esa pestaña. Si depende de alertas de precio audibles, sopese esto antes de recurrir al silenciado. Conviene decidir qué sonidos quiere realmente antes de eliminarlos todos." },
    { type: "heading",text: "Silenciarlo a nivel del sistema operativo (aplicación de escritorio)" },
    { type: "paragraph",html: "La aplicación de escritorio le ofrece algo que la aplicación web no: un volumen real que puede bajar en lugar de un encendido/apagado brusco. En Windows, abra el <strong class='text-white'>Mezclador de volumen</strong> (clic derecho en el icono del altavoz en la bandeja del sistema, elija Abrir mezclador de volumen o búsquelo en la configuración de Sonido), localice Tradovate en la lista por aplicación y baje su control deslizante. Dejarlo bajo en lugar de totalmente silenciado, alrededor del diez por ciento, mantiene el sonido presente pero lo bastante suave como para que una ráfaga de ejecuciones algorítmicas no le saque de la silla." },
    { type: "paragraph",html: "En macOS no hay volumen por aplicación integrado, así que debe volver a los interruptores de la aplicación o a un mezclador de audio de terceros. En cualquier caso, la vía de escritorio es la más flexible cuando desea suavizar el sonido de ejecución sin perder el resto de avisos." },
    { type: "heading",text: "Web frente a escritorio: qué puede controlar realmente" },
    { type: "table", headers: ["Control","Aplicación web","Aplicación de escritorio"], rows: [
      ["Desactivar las notificaciones de órdenes","Sí (Application Settings)","Sí (Application Settings)"],
      ["Silenciar un estado de orden concreto","Sí (Advanced Configuration)","Sí (Advanced Configuration)"],
      ["Ajustar el volumen real","Sin volumen general","Sí, mediante el mezclador de volumen del sistema operativo"],
      ["Silenciar todo de forma rápida y total","Clic derecho en la pestaña &gt; Mute site","Silenciar la aplicación en el mezclador del sistema operativo"],
    ] },
    { type: "heading",text: "Informarlo al soporte de Tradovate" },
    { type: "paragraph",html: "Si ha desactivado el sonido de órdenes tanto en los ajustes estándar como en los avanzados y aun así suena, eso no es un comportamiento documentado con una solución limpia, así que abra un ticket. Las soluciones alternativas de silenciado le mantienen cuerdo mientras tanto, pero un informe a soporte es la única vía hacia una reparación real. Facilite la gestión del ticket incluyendo:" },
    {
      type: "list",
      items: [
        "La plataforma y la versión que usa (web, escritorio o móvil), y su navegador si es la aplicación web.",
        "Si ocurre en una cuenta real, en una simulada o en ambas.",
        "Exactamente qué interruptores desactivó, idealmente con una captura de pantalla de la sección Notifications y del panel Advanced Configuration mostrándolos desactivados.",
        "Si un refresco forzado o un nuevo inicio de sesión cambió algo.",
      ],
    },
    { type: "paragraph",html: "Si usa una cuenta de evaluación de una prop firm, anótelo también, ya que algunos ajustes y el enrutamiento del soporte difieren según la firma. Las reglas y los controles disponibles varían según la firma y el tamaño de la cuenta, así que consulte la configuración vigente de su firma si algo parece bloqueado sin motivo." },
    { type: "paragraph",html: "Y si llegó aquí porque ya automatiza desde TradingView, conviene acertar también con la configuración de ese lado, para que las órdenes que activan el sonido se ejecuten al menos exactamente como usted pretende." },
  ], fr: [
    { type: "paragraph",html: "Vous avez désactivé tous les interrupteurs de notification que vous avez trouvés, et ce carillon &ldquo;ORDER FILLED&rdquo; retentit toujours à chaque exécution. Si vous utilisez une forme d'automatisation, c'est pire, car votre stratégie enchaîne les ordres et la plateforme vous fait sursauter à chaque exécution. Voici la version courte. L'interrupteur censé le supprimer se trouve sous Application Settings, et la plupart du temps, le désactiver suffit. Quand ce n'est pas le cas, et il y a des cas où cela ne fonctionne tout simplement pas, vous passez à la mise en sourdine de la plateforme au niveau du navigateur ou du système d'exploitation et vous signalez le problème au support, car il n'existe aucun paramètre documenté unique qui couvre cela de manière fiable." },
    { type: "paragraph",html: "Ce guide parcourt d'abord le chemin dans l'application, puis les solutions de repli qui coupent réellement le son lorsque l'interrupteur ne tient pas, et enfin ce qu'il faut envoyer au support pour que le problème soit correctement corrigé au lieu de vivre à jamais avec un onglet muet." },
    { type: "heading",text: "Le paramètre censé le faire taire" },
    { type: "paragraph",html: "Commencez par le contrôle intégré, car pour beaucoup de gens, c'est toute la solution. Dans le trader web, cliquez sur le bouton <strong class='text-white'>Application Settings</strong> (l'engrenage) dans le coin supérieur droit de l'écran." },
    { type: "paragraph",html: "Ouvrez l'onglet <strong class='text-white'>Preferences</strong>, puis faites défiler jusqu'à la section <strong class='text-white'>Notifications</strong>. Il s'y trouve un interrupteur <strong class='text-white'>Order Notifications</strong>. Le désactiver supprime d'un coup les fenêtres contextuelles d'état des ordres et leurs sons. Si votre seul but est le silence, c'est l'interrupteur à basculer." },
    { type: "paragraph",html: "Si vous préférez conserver certaines notifications et ne supprimer que le son d'exécution, ne basculez pas l'interrupteur général. Cliquez plutôt sur <strong class='text-white'>Advanced Configuration</strong>. Cela ouvre une liste par statut où vous pouvez activer ou désactiver chaque statut d'ordre individuellement, et pour chacun, vous pouvez activer ou désactiver l'audio, tester le son et le remplacer par un autre fichier (la plateforme propose plus d'une douzaine d'options sonores). Trouvez le statut correspondant à une exécution, coupez son audio et laissez le reste intact." },
    { type: "paragraph",html: "Un autre contrôle à connaître : l'interrupteur <strong class='text-white'>Notification Ticker</strong>. Il supprime tout le panneau qui contient l'horloge et ces messages d'état, ce qui est pratique si vous voulez faire disparaître le bruit visuel en même temps que le son. Les libellés et l'emplacement exact varient d'une version de la plateforme à l'autre ; si un nom cité ici ne correspond pas à votre écran, cherchez l'équivalent le plus proche sous Application Settings et dans la zone Notifications." },
    { type: "heading",text: "Quand l'interrupteur ne tient pas" },
    { type: "paragraph",html: "Voici la partie frustrante, et la raison d'être de cette page. Il existe des configurations où vous désactivez tous les sons de notification que vous trouvez, dans les paramètres principaux comme avancés, sur un compte réel comme sur un compte simulé, et le son &ldquo;ORDER FILLED&rdquo; continue malgré tout. L'application web ne vous offre pas de curseur de volume général sur lequel vous replier ; une fois l'interrupteur ignoré, vous n'avez plus d'options dans l'application. C'est une véritable lacune. Ce n'est pas votre configuration qui est en cause, et c'est précisément le comportement à signaler au support (voir plus bas)." },
    { type: "paragraph",html: "Avant de conclure qu'il s'agit du défaut, écartez d'abord les causes banales. Si Tradovate est ouvert à plusieurs endroits à la fois (un second onglet de navigateur, l'application de bureau, le mobile ou une plateforme de graphiques liée), le son peut provenir d'une session que vous avez oubliée. Fermez les autres et testez à nouveau. Une session de navigateur obsolète peut aussi conserver d'anciens paramètres ; une actualisation forcée et une nouvelle connexion règlent parfois le problème. Et vérifiez que vous avez bien enregistré la modification, car basculer un interrupteur et naviguer ailleurs sans confirmer peut laisser l'ancien état en place." },
    { type: "heading",text: "Le couper dans le navigateur (application web)" },
    { type: "paragraph",html: "Si vous êtes sur la version web et que l'interrupteur de l'application ne coopère pas, la mise en sourdine la plus rapide se fait au niveau du navigateur. Faites un clic droit sur l'onglet où la plateforme est ouverte et choisissez <strong class='text-white'>Mute site</strong> (certains navigateurs l'appellent &ldquo;Mute tab&rdquo;). Tous les sons de cet onglet s'arrêtent immédiatement." },
    { type: "paragraph",html: "Quelques mesures voisines dans le même esprit :" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Autorisation sonore du site.</strong> Dans les paramètres de site de votre navigateur pour l'URL de Tradovate, réglez le Son sur &ldquo;Mute&rdquo;. Cela survit aux rechargements d'onglet, contrairement à une mise en sourdine ponctuelle de l'onglet qui peut être réinitialisée.",
        "<strong class='text-white'>Videz le cache et les cookies, puis reconnectez-vous.</strong> Si une session obsolète est la cause plutôt que le défaut sous-jacent, une connexion propre peut restaurer vos préférences sonores enregistrées.",
      ],
    },
    { type: "paragraph",html: "Le compromis de toute mise en sourdine au niveau du navigateur est qu'elle est du tout ou rien. Elle supprime le carillon d'exécution, mais elle fait aussi taire les alertes de prix, les alertes de dessin et tout ce que la plateforme joue dans cet onglet. Si vous vous appuyez sur des alertes de prix sonores, pesez cela avant de recourir à la mise en sourdine. Mieux vaut décider quels sons vous voulez vraiment avant de tous les supprimer." },
    { type: "heading",text: "Le couper au niveau du système d'exploitation (application de bureau)" },
    { type: "paragraph",html: "L'application de bureau vous offre ce que l'application web n'a pas : un vrai volume que vous pouvez baisser plutôt qu'un tout ou rien brutal. Sous Windows, ouvrez le <strong class='text-white'>Mélangeur de volume</strong> (clic droit sur l'icône du haut-parleur dans la zone de notification, choisissez Ouvrir le mélangeur de volume ou trouvez-le dans les paramètres Son), repérez Tradovate dans la liste par application et baissez son curseur. Le régler bas plutôt que totalement muet, autour de dix pour cent, garde le son présent mais assez discret pour qu'une rafale d'exécutions algorithmiques ne vous fasse pas bondir de votre chaise." },
    { type: "paragraph",html: "Sous macOS, il n'existe pas de volume par application intégré ; vous en êtes donc réduit aux interrupteurs de l'application ou à un mélangeur audio tiers. Dans les deux cas, la voie du bureau est la plus souple lorsque vous voulez atténuer le son d'exécution sans perdre tous les autres signaux." },
    { type: "heading",text: "Web ou bureau : ce que vous pouvez réellement contrôler" },
    { type: "table", headers: ["Contrôle","Application web","Application de bureau"], rows: [
      ["Désactiver les notifications d'ordres","Oui (Application Settings)","Oui (Application Settings)"],
      ["Couper le son d'un seul statut d'ordre","Oui (Advanced Configuration)","Oui (Advanced Configuration)"],
      ["Régler le volume réel","Pas de volume général","Oui, via le mélangeur de volume du système d'exploitation"],
      ["Tout couper rapidement et totalement","Clic droit sur l'onglet &gt; Mute site","Couper l'application dans le mélangeur du système d'exploitation"],
    ] },
    { type: "heading",text: "Le signaler au support de Tradovate" },
    { type: "paragraph",html: "Si vous avez désactivé le son des ordres dans les paramètres standard et avancés et qu'il retentit toujours, ce n'est pas un comportement documenté avec une solution propre ; ouvrez donc un ticket. Les contournements par mise en sourdine vous gardent sain d'esprit en attendant, mais un signalement au support est le seul chemin vers une vraie réparation. Rendez le ticket facile à traiter en y incluant :" },
    {
      type: "list",
      items: [
        "La plateforme et la version que vous utilisez (web, bureau ou mobile), ainsi que votre navigateur s'il s'agit de l'application web.",
        "Si le problème survient sur un compte réel, un compte simulé ou les deux.",
        "Exactement quels interrupteurs vous avez désactivés, idéalement avec une capture d'écran de la section Notifications et du panneau Advanced Configuration les montrant désactivés.",
        "Si une actualisation forcée ou une nouvelle connexion a changé quelque chose.",
      ],
    },
    { type: "paragraph",html: "Si vous êtes sur un compte d'évaluation de prop firm, mentionnez-le aussi, car certains paramètres et le routage du support diffèrent selon la firme. Les règles et les contrôles disponibles varient selon la firme et la taille du compte ; vérifiez donc la configuration actuelle de votre firme si quelque chose semble verrouillé alors que ça ne devrait pas l'être." },
    { type: "paragraph",html: "Et si vous êtes arrivé ici parce que vous automatisez déjà depuis TradingView, il vaut la peine de bien régler aussi ce côté, afin que les ordres qui déclenchent le son s'exécutent au moins exactement comme vous l'entendez." },
  ], it: [
    { type: "paragraph",html: "Ha disattivato tutti gli interruttori di notifica che ha trovato e quel segnale &ldquo;ORDER FILLED&rdquo; suona ancora a ogni singola esecuzione. Se usa qualsiasi tipo di automazione, è peggio, perché la Sua strategia spara ordini uno dopo l'altro e la piattaforma Le fa fare un salto a ogni esecuzione. Ecco la versione breve. L'interruttore che dovrebbe spegnerlo si trova in Application Settings e, per lo più, disattivarlo risolve. Quando non basta, e ci sono casi in cui semplicemente non funziona, passi a silenziare la piattaforma a livello di browser o di sistema operativo e segnali il problema al supporto, perché non esiste una singola impostazione documentata che lo copra in modo affidabile." },
    { type: "paragraph",html: "Questa guida percorre prima la strada nell'app, poi le alternative che silenziano davvero il suono quando l'interruttore non regge e, infine, cosa inviare al supporto affinché venga corretto come si deve invece di convivere per sempre con una scheda silenziata." },
    { type: "heading",text: "L'impostazione che dovrebbe silenziarlo" },
    { type: "paragraph",html: "Inizi dal controllo integrato, perché per molte persone è l'intera soluzione. Nel trader web, clicchi sul pulsante <strong class='text-white'>Application Settings</strong> (l'ingranaggio) nell'angolo in alto a destra dello schermo." },
    { type: "paragraph",html: "Apra la scheda <strong class='text-white'>Preferences</strong>, poi scorra fino alla sezione <strong class='text-white'>Notifications</strong>. Qui c'è un interruttore <strong class='text-white'>Order Notifications</strong>. Disattivarlo interrompe in un colpo solo i pop-up di stato degli ordini e i relativi suoni. Se il Suo unico obiettivo è il silenzio, è l'interruttore da azionare." },
    { type: "paragraph",html: "Se preferisce mantenere alcune notifiche e silenziare solo il suono di esecuzione, non azioni l'interruttore generale. Clicchi invece su <strong class='text-white'>Advanced Configuration</strong>. Si apre un elenco per stato in cui può attivare o disattivare ogni stato dell'ordine singolarmente e, per ciascuno, può attivare o disattivare l'audio, provare il suono e sostituirlo con un altro file (la piattaforma include più di una dozzina di opzioni sonore). Trovi lo stato che corrisponde a un'esecuzione, silenzi il suo audio e lasci stare il resto." },
    { type: "paragraph",html: "Un altro controllo da conoscere: l'interruttore <strong class='text-white'>Notification Ticker</strong>. Rimuove l'intero pannello che contiene l'orologio e questi messaggi di stato, il che è utile se vuole eliminare il rumore visivo insieme al suono. Le etichette e la posizione esatta cambiano tra le build della piattaforma, quindi se un nome qui riportato non corrisponde a quanto vede sullo schermo, cerchi l'equivalente più vicino in Application Settings e nell'area Notifications." },
    { type: "heading",text: "Quando l'interruttore non regge" },
    { type: "paragraph",html: "Ecco la parte frustrante e il motivo per cui questa pagina esiste. Ci sono configurazioni in cui disattiva ogni notifica sonora che riesce a trovare, sia nelle impostazioni principali sia in quelle avanzate, su un conto live e su uno simulato, e il suono &ldquo;ORDER FILLED&rdquo; continua comunque a suonare. L'app web non Le offre un cursore del volume generale a cui ripiegare, quindi, una volta che l'interruttore viene ignorato, non Le restano opzioni nell'app. È una lacuna reale. Non è la Sua configurazione a essere sbagliata, ed è proprio il comportamento da segnalare al supporto (più avanti)." },
    { type: "paragraph",html: "Prima di presumere che sia il difetto, escluda le cause banali. Se ha Tradovate aperto in più posti contemporaneamente (una seconda scheda del browser, l'app desktop, il mobile o una piattaforma di grafici collegata), il suono potrebbe provenire da una sessione che ha dimenticato. Chiuda quelle in più e provi di nuovo. Una sessione del browser obsoleta può anche conservare vecchie impostazioni, quindi un aggiornamento forzato e un nuovo accesso a volte risolvono. E ricontrolli di aver effettivamente salvato la modifica, perché azionare un interruttore e navigare altrove senza confermare può lasciare lo stato precedente." },
    { type: "heading",text: "Silenziarlo nel browser (app web)" },
    { type: "paragraph",html: "Se usa la versione web e l'interruttore nell'app non collabora, il modo più rapido per silenziare del tutto è a livello di browser. Clicchi con il tasto destro sulla scheda in cui la piattaforma è aperta e scelga <strong class='text-white'>Mute site</strong> (alcuni browser lo chiamano &ldquo;Mute tab&rdquo;). Ogni suono di quella scheda si interrompe immediatamente." },
    { type: "paragraph",html: "Un paio di mosse correlate nella stessa direzione:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Permesso audio del sito.</strong> Nelle impostazioni del sito del browser per l'URL di Tradovate, imposti l'Audio su &ldquo;Mute&rdquo;. Questo sopravvive ai ricaricamenti della scheda, a differenza di una disattivazione una tantum della scheda che può azzerarsi.",
        "<strong class='text-white'>Svuoti cache e cookie, poi acceda di nuovo.</strong> Se il colpevole è una sessione obsoleta e non il difetto sottostante, un accesso pulito può ripristinare le Sue preferenze audio salvate.",
      ],
    },
    { type: "paragraph",html: "Il compromesso di qualsiasi silenziamento a livello di browser è che è tutto o niente. Elimina il segnale di esecuzione, ma silenzia anche gli alert di prezzo, gli alert di disegno e qualsiasi altra cosa la piattaforma riproduca in quella scheda. Se si affida ad alert di prezzo udibili, lo valuti prima di ricorrere al silenziamento. Vale la pena decidere quali suoni vuole davvero prima di eliminarli tutti." },
    { type: "heading",text: "Silenziarlo a livello di sistema operativo (app desktop)" },
    { type: "paragraph",html: "L'app desktop Le offre qualcosa che l'app web non ha: un vero volume che può abbassare invece di un brusco on/off. In Windows, apra il <strong class='text-white'>Mixer volume</strong> (clic destro sull'icona dell'altoparlante nell'area di notifica, scelga Apri Mixer volume oppure lo trovi nelle impostazioni Audio), individui Tradovate nell'elenco per app e abbassi il suo cursore. Impostarlo basso anziché completamente muto, intorno al dieci per cento, mantiene il suono presente ma abbastanza basso da evitare che una raffica di esecuzioni algoritmiche La faccia saltare dalla sedia." },
    { type: "paragraph",html: "Su macOS non esiste un volume per app integrato, quindi si torna agli interruttori nell'app o a un mixer audio di terze parti. In ogni caso, la via desktop è la più flessibile quando vuole attenuare il suono di esecuzione senza perdere ogni altro segnale." },
    { type: "heading",text: "Web o desktop: cosa può effettivamente controllare" },
    { type: "table", headers: ["Controllo","App web","App desktop"], rows: [
      ["Disattivare le notifiche degli ordini","Sì (Application Settings)","Sì (Application Settings)"],
      ["Silenziare un singolo stato dell'ordine","Sì (Advanced Configuration)","Sì (Advanced Configuration)"],
      ["Regolare il volume effettivo","Nessun volume generale","Sì, tramite il mixer del volume del sistema operativo"],
      ["Silenziare tutto in fretta e del tutto","Clic destro sulla scheda &gt; Mute site","Silenziare l'app nel mixer del sistema operativo"],
    ] },
    { type: "heading",text: "Segnalarlo al supporto di Tradovate" },
    { type: "paragraph",html: "Se ha disattivato il suono degli ordini sia nelle impostazioni standard sia in quelle avanzate e suona ancora, non è un comportamento documentato con una soluzione pulita, quindi apra un ticket. I workaround di silenziamento La mantengono sano nel frattempo, ma una segnalazione al supporto è l'unica strada verso una vera riparazione. Renda il ticket facile da gestire includendo:" },
    {
      type: "list",
      items: [
        "La piattaforma e la build che usa (web, desktop o mobile) e il Suo browser se è l'app web.",
        "Se accade su un conto live, su uno simulato o su entrambi.",
        "Esattamente quali interruttori ha disattivato, idealmente con uno screenshot della sezione Notifications e del pannello Advanced Configuration che li mostra disattivati.",
        "Se un aggiornamento forzato o un nuovo accesso ha cambiato qualcosa.",
      ],
    },
    { type: "paragraph",html: "Se utilizza un conto di valutazione di una prop firm, lo indichi, poiché alcune impostazioni e l'instradamento del supporto differiscono a seconda della firm. Regole e controlli disponibili variano in base alla firm e alla dimensione del conto, quindi verifichi la configurazione attuale della Sua firm se qualcosa sembra bloccato senza motivo." },
    { type: "paragraph",html: "E se è arrivato qui perché sta già automatizzando da TradingView, vale la pena sistemare bene anche quel lato, così che gli ordini che attivano il suono vengano almeno eseguiti esattamente come intende." },
  ] },
  ctaHeading: { en: "Let Automation Handle the Fills", de: "Lassen Sie die Automatisierung die Ausführungen übernehmen", es: "Deje que la automatización gestione las ejecuciones", fr: "Laissez l'automatisation gérer les exécutions", it: "Lasci che l'automazione gestisca le esecuzioni" },
  ctaText: { en: "If the whole reason the chime is driving you nuts is that a strategy is firing orders while you watch, let PickMyTrade route your TradingView signals straight to Tradovate so entries and exits execute without you glued to the platform.", de: "Wenn der Signalton Sie nur deshalb nervt, weil eine Strategie Orders auslöst, während Sie zuschauen, lassen Sie PickMyTrade Ihre TradingView-Signale direkt an Tradovate weiterleiten, damit Einstiege und Ausstiege ausgeführt werden, ohne dass Sie an der Plattform kleben.", es: "Si el motivo por el que el tono le saca de quicio es que una estrategia lanza órdenes mientras usted observa, deje que PickMyTrade enrute sus señales de TradingView directamente a Tradovate para que las entradas y salidas se ejecuten sin que tenga que estar pegado a la plataforma.", fr: "Si le carillon vous exaspère uniquement parce qu'une stratégie envoie des ordres pendant que vous regardez, laissez PickMyTrade acheminer vos signaux TradingView directement vers Tradovate afin que les entrées et sorties s'exécutent sans que vous soyez rivé à la plateforme.", it: "Se il segnale La infastidisce solo perché una strategia sta inviando ordini mentre Lei guarda, lasci che PickMyTrade instradi i Suoi segnali di TradingView direttamente a Tradovate, così ingressi e uscite vengono eseguiti senza che Lei sia incollato alla piattaforma." },
  ctaButtonText: { en: "Start Your Free 7-Day Trial", de: "Starten Sie Ihre kostenlose 7-Tage-Testphase", es: "Comience su prueba gratuita de 7 días", fr: "Commencez votre essai gratuit de 7 jours", it: "Inizi la prova gratuita di 7 giorni" },
  ctaUrl: "https://app.pickmytrade.trade/?register=true&utm_source=content&utm_medium=debugging",
  faqHeading: { en: "Frequently Asked Questions", de: "Häufig gestellte Fragen", es: "Preguntas frecuentes", fr: "Questions fréquentes", it: "Domande frequenti" },
  faqs: { en: [
    { q: "Why does the ORDER FILLED sound play even on a simulated account?", a: "The order status audio is tied to order events, not to whether the account is live or funded. A simulated fill is still a fill, so the same chime fires. Turn it off in the notification settings the same way you would on a live account. If it ignores the toggle, fall back to muting at the browser or operating-system level." },
    { q: "Does muting the browser tab also kill my price alerts?", a: "Yes. Muting the site or the tab silences every sound the platform makes in that tab, including price and drawing alerts. If you rely on alerts, use the per-status audio toggles or the desktop app's volume control so you can keep alerts while dropping the fill chime." },
    { q: "Is there a volume slider in the Tradovate web app?", a: "No. The web app lets you toggle sounds on or off and pick sound files, but there's no master volume. For a level you can dial down instead of a hard on/off, use the desktop app and set its volume in your operating system's volume mixer." },
    { q: "Will reinstalling the app or clearing my cache stop the sound?", a: "Sometimes, when the cause is a stale session state rather than the underlying defect. A hard refresh, a cache and cookie clear, and a fresh login are worth trying first. If the chime returns immediately after that, treat it as the defect and fall back to muting plus a support ticket." },
  ], de: [
