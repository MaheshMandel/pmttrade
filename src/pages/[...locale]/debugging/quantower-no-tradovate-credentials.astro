---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "quantower-no-tradovate-credentials";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/debugging/${SLUG}`;

const META_TITLE = "Quantower Won't Accept Tradovate Login (Use Rithmic)";
const META_DESCRIPTION =
  "Quantower rejects Tradovate usernames because it has no native Tradovate feed. Connect with the Rithmic credentials from your prop firm instead.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Quantower akzeptiert den Tradovate-Login nicht (Rithmic verwenden)", es: "Quantower no acepta el inicio de sesión de Tradovate (use Rithmic)", fr: "Quantower n'accepte pas la connexion Tradovate (utilisez Rithmic)", it: "Quantower non accetta il login Tradovate (usi Rithmic)" },
  dek: { en: "You bought a prop combine that runs on Tradovate, opened Quantower, and there's nowhere to type your Tradovate login. Here's why, and how to connect with the Rithmic credentials your firm already issued.", de: "Sie haben eine Prop-Combine gekauft, die auf Tradovate läuft, Quantower geöffnet, und es gibt keine Stelle, um Ihren Tradovate-Login einzugeben. Hier erfahren Sie, warum, und wie Sie sich mit den Rithmic-Zugangsdaten verbinden, die Ihre Firma bereits ausgestellt hat.", es: "Compró un combine prop que funciona sobre Tradovate, abrió Quantower y no hay dónde escribir su inicio de sesión de Tradovate. Aquí le explicamos por qué y cómo conectarse con las credenciales de Rithmic que su firma ya le emitió.", fr: "Vous avez acheté un combine prop qui fonctionne sur Tradovate, ouvert Quantower, et il n'y a aucun endroit où saisir votre connexion Tradovate. Voici pourquoi, et comment vous connecter avec les identifiants Rithmic que votre société vous a déjà fournis.", it: "Ha acquistato un combine prop che gira su Tradovate, ha aperto Quantower e non c'è nessun posto dove digitare il Suo login Tradovate. Ecco perché, e come collegarsi con le credenziali Rithmic che la Sua società Le ha già rilasciato." },
  readTime: { en: "7 min read", de: "7 Min. Lesezeit", es: "Lectura de 7 min", fr: "Lecture : 7 min", it: "Lettura di 7 min" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "You bought a prop combine that runs on Tradovate, you open Quantower, and there's nowhere to type your Tradovate username. Or you force it into the wrong box and it just fails. That's expected in 2026: Quantower doesn't route futures through Tradovate at all, so your Tradovate login was never going to work. The account you funded is almost certainly reachable, though, through the Rithmic credentials your firm hands out alongside it." },
    {
      type: "checklist",
      heading: "Quick Checklist for the Quantower Tradovate Login Problem",
      items: [
        "<strong class='text-white'>Stop looking for a Tradovate connection.</strong> Quantower doesn't have one. Its futures side runs on Rithmic, CQG, and ProjectX, not on the Tradovate API.",
        "<strong class='text-white'>Find your Rithmic username and password.</strong> Your prop firm issues these separately from your Tradovate login, usually in the account dashboard or the welcome email.",
        "<strong class='text-white'>Open Connections and pick Rithmic.</strong> Enter the Rithmic login exactly as issued, including case, with no leading or trailing spaces.",
        "<strong class='text-white'>Choose the right server.</strong> Evaluation accounts and funded accounts sit on different Rithmic gateways. Use the one your firm tells you to use.",
        "<strong class='text-white'>Log out everywhere else first.</strong> If the same Rithmic login is live in R Trader Pro or another platform, Quantower can throw a connection error.",
        "<strong class='text-white'>No Rithmic option from your firm?</strong> Then that account is Tradovate-only, and you'll need a Tradovate-compatible platform instead of Quantower.",
      ],
    },
    { type: "heading", text: "What “Quantower Won't Accept Your Tradovate Login” Means" },
    { type: "paragraph", html: "Here's the short version: this isn't a bug, and there's nothing broken about your Tradovate account. Quantower simply never built a direct Tradovate integration. When you scroll its list of futures connections you'll see Rithmic, CQG, ProjectX, and firm-branded gateways, but no &ldquo;Tradovate&rdquo; entry. So the credentials Tradovate gave you have no field to go into, and any attempt to reuse them in a different connection gets rejected." },
    { type: "paragraph", html: "The reason this trips up so many prop traders is that Tradovate and Rithmic often sit behind the same account. A lot of firms clear through infrastructure that exposes both a Tradovate login (for the Tradovate web platform, TradingView, and tools like it) and a Rithmic login (for Rithmic-compatible platforms such as Quantower, NinjaTrader, and Sierra Chart). Same balance, same positions, two different sets of credentials for two different technology stacks." },
    { type: "paragraph", html: "So the fix isn't to make Quantower &ldquo;accept&rdquo; Tradovate. It's to connect Quantower the way it was designed to connect, using the Rithmic credentials your firm already provisioned for exactly this purpose." },
    { type: "heading", text: "Top Causes of Quantower Rejecting Tradovate Credentials" },
    { type: "heading", text: "1. Quantower has no native Tradovate connection" },
    { type: "paragraph", html: "This is the root cause and it catches almost everyone. Quantower's futures data and order routing come through Rithmic, CQG, and ProjectX. There is no Tradovate adapter in the connection list, so there's physically no place to enter a Tradovate email and password. Nothing you type in a Rithmic or CQG box will validate against Tradovate's servers." },
    { type: "heading", text: "2. You're using the Tradovate login instead of the Rithmic login" },
    { type: "paragraph", html: "Prop firms hand out more than one credential set, and it's easy to grab the wrong one. Your Tradovate username (often an email, or a firm-prefixed name) is for the Tradovate side. Your Rithmic username is a distinct string, frequently shorter, sometimes with a firm tag. Plugging the Tradovate one into Quantower's Rithmic connection fails every time because Rithmic's servers have never heard of it." },
    { type: "heading", text: "3. Your firm never enabled Rithmic on that account" },
    { type: "paragraph", html: "Some firms let you choose your data feed or platform when you buy the evaluation. If you picked a Tradovate-only route, a Rithmic login may not exist yet for that account. In that case Quantower can't connect it no matter what you type, and you'll need to either request Rithmic access from support or switch the account's platform selection. Whether that's free, paid, or even available at all varies by firm and account size, so check your firm's current rules before you assume." },
    { type: "heading", text: "4. Wrong Rithmic server or gateway" },
    { type: "paragraph", html: "Rithmic runs multiple gateways, and the login only works on the one your account lives on. Demo and evaluation accounts typically sit on a paper gateway, while funded and live accounts sit on a live gateway. If you point a funded login at the paper server (or the reverse), the connection is refused even though the username and password are correct." },
    { type: "heading", text: "5. Credential formatting: spaces and capitalization" },
    { type: "paragraph", html: "Rithmic logins are case-sensitive, and a single trailing space copied out of a dashboard will break authentication. If you paste the username or password and it fails, retype it by hand, watch the capitalization, and make sure autofill hasn't slipped an old value in." },
    { type: "heading", text: "How to Fix It: Step-by-Step" },
    { type: "heading", text: "Fixing the login: connect Quantower with Rithmic" },
    {
      type: "steps",
      items: [
        { title: "Get your Rithmic credentials", html: "Sign in to your prop firm's client dashboard and locate the platform access section. Copy the <strong class='text-white'>Rithmic</strong> username and password. These sit separately from your Tradovate credentials, and some firms only reveal them after the account is activated." },
        { title: "Open Connections in Quantower", html: "Open the <strong class='text-white'>Connections</strong> panel (the connection manager where you add and manage brokers). Confirm the exact label in your build, since Quantower revises this UI periodically." },
        { title: "Select Rithmic", html: "Select <strong class='text-white'>Rithmic</strong> from the connection list. Do not look for Tradovate; it isn't there and won't be." },
        { title: "Enter the login by hand", html: "Enter the Rithmic login and password exactly as issued. Type them by hand rather than pasting, and check the case on every character." },
        { title: "Pick the correct server", html: "Pick the <strong class='text-white'>server</strong> your firm specified. As a rule, evaluation and demo accounts use a paper gateway and funded accounts use a live gateway, but the exact gateway name is firm-specific, so use the one in your welcome email." },
        { title: "Click Connect", html: "Click <strong class='text-white'>Connect</strong>. When it succeeds, your prop account's balance and positions load into Quantower, and you can chart and trade it there." },
      ],
    },
    { type: "heading", text: "Choosing the correct Rithmic server" },
    {
      type: "steps",
      items: [
        { title: "Match the environment to the account", html: "A paper or demo gateway is the default for evaluations; a live gateway is the default for funded accounts." },
        { title: "Use the gateway your firm named", html: "If your firm named a specific gateway in your onboarding email, use that exact entry. Firm-branded and region-specific gateways exist, and only one is correct for your account." },
        { title: "Try the other environment if refused", html: "If the connection is refused with correct credentials, switch to the other environment and try again. A mismatched server is the most common reason a valid login won't connect." },
      ],
    },
    { type: "heading", text: "Clearing a “No handle” or duplicate-session error" },
    {
      type: "steps",
      items: [
        { title: "Close other Rithmic sessions", html: "Close R Trader Pro if you have it open, and disconnect the same Rithmic login from any other platform such as NinjaTrader." },
        { title: "Wait for the old session to drop", html: "Wait a few seconds for the old session to drop, then reconnect in Quantower." },
        { title: "Check plugin mode", html: "If you rely on R Trader Pro's plugin mode, either start it in &ldquo;Allow Plugins&rdquo; mode or turn off the Use R Trader option in Quantower to make a direct connection instead." },
      ],
    },
    { type: "heading", text: "Troubleshooting Table" },
    {
      type: "table",
      headers: ["What you see", "What it means", "Fix"],
      rows: [
        ["No Tradovate option in Quantower", "Quantower has no native Tradovate connection", "Connect through Rithmic instead, using your firm's Rithmic credentials"],
        ["Login failed with Tradovate username", "Tradovate credentials don't authenticate against Rithmic servers", "Enter the separate Rithmic username and password from your dashboard"],
        ["Login failed with correct Rithmic details", "Wrong server, or Rithmic not enabled on the account", "Select the correct gateway, or ask your firm to enable Rithmic access"],
        ["&ldquo;No handle&rdquo; / connection refused", "The same Rithmic login is active elsewhere", "Close R Trader Pro and other platforms, then reconnect"],
        ["Intermittent auth failure", "Trailing spaces or wrong capitalization in the credentials", "Retype the login by hand; Rithmic logins are case-sensitive"],
        ["Firm offers no Rithmic login at all", "The account is provisioned Tradovate-only", "Trade it in a Tradovate-compatible platform, or request a platform switch"],
      ],
    },
    { type: "heading", text: "Prevent This with PickMyTrade" },
    { type: "paragraph", html: "If your goal is to automate that prop account, whether Quantower takes a Tradovate login becomes a non-issue. PickMyTrade connects to your Tradovate-hosted account directly and fires orders from your TradingView alerts, so you can keep charting in Quantower over Rithmic while execution runs on the Tradovate side without you juggling logins." },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Direct Tradovate routing</strong> sends orders straight to your Tradovate prop account, no third-party platform login required.",
        "<strong class='text-white'>TradingView-to-broker automation</strong> turns your alerts into live orders on the account your firm actually cleared.",
        "<strong class='text-white'>Prop-aware risk filters</strong> respect your firm's limits and data-agreement state before an order goes out.",
        "<strong class='text-white'>Multi-account sync</strong> mirrors a single alert across several prop accounts at once.",
      ],
    },
  ], de: [
    { type: "paragraph",html: "Sie haben eine Prop-Combine gekauft, die auf Tradovate läuft, öffnen Quantower, und es gibt keine Stelle, um Ihren Tradovate-Benutzernamen einzugeben. Oder Sie zwängen ihn in das falsche Feld, und es schlägt einfach fehl. Das ist 2026 zu erwarten: Quantower leitet Futures überhaupt nicht über Tradovate, Ihr Tradovate-Login konnte also nie funktionieren. Das finanzierte Konto ist aber mit hoher Wahrscheinlichkeit über die Rithmic-Zugangsdaten erreichbar, die Ihre Firma dazu ausgibt." },
    {
      type: "checklist",
      heading: "Kurze Checkliste zum Quantower-Tradovate-Login-Problem",
      items: [
        "<strong class='text-white'>Hören Sie auf, nach einer Tradovate-Verbindung zu suchen.</strong> Quantower hat keine. Die Futures-Seite läuft über Rithmic, CQG und ProjectX, nicht über die Tradovate-API.",
        "<strong class='text-white'>Finden Sie Ihren Rithmic-Benutzernamen und Ihr Passwort.</strong> Ihre Prop-Firma stellt diese getrennt von Ihrem Tradovate-Login aus, meist im Konto-Dashboard oder in der Willkommens-E-Mail.",
        "<strong class='text-white'>Öffnen Sie Connections und wählen Sie Rithmic.</strong> Geben Sie den Rithmic-Login exakt wie ausgestellt ein, einschließlich Groß-/Kleinschreibung, ohne führende oder nachgestellte Leerzeichen.",
        "<strong class='text-white'>Wählen Sie den richtigen Server.</strong> Evaluierungskonten und finanzierte Konten liegen auf verschiedenen Rithmic-Gateways. Nutzen Sie das, das Ihre Firma Ihnen nennt.",
        "<strong class='text-white'>Melden Sie sich zuerst überall sonst ab.</strong> Ist derselbe Rithmic-Login in R Trader Pro oder einer anderen Plattform aktiv, kann Quantower einen Verbindungsfehler ausgeben.",
        "<strong class='text-white'>Keine Rithmic-Option von Ihrer Firma?</strong> Dann ist das Konto nur für Tradovate, und Sie brauchen statt Quantower eine Tradovate-kompatible Plattform.",
      ],
    },
    { type: "heading",text: "Was „Quantower akzeptiert Ihren Tradovate-Login nicht“ bedeutet" },
    { type: "paragraph",html: "Die Kurzfassung: Das ist kein Fehler, und an Ihrem Tradovate-Konto ist nichts kaputt. Quantower hat schlicht nie eine direkte Tradovate-Integration gebaut. Wenn Sie durch die Liste der Futures-Verbindungen scrollen, sehen Sie Rithmic, CQG, ProjectX und firmengebrandete Gateways, aber keinen Eintrag &ldquo;Tradovate&rdquo;. Die Zugangsdaten von Tradovate haben also kein Feld, in das sie passen, und jeder Versuch, sie in einer anderen Verbindung wiederzuverwenden, wird abgewiesen." },
    { type: "paragraph",html: "Das bringt so viele Prop-Trader zum Stolpern, weil Tradovate und Rithmic oft hinter demselben Konto stehen. Viele Firmen clearen über eine Infrastruktur, die sowohl einen Tradovate-Login (für die Tradovate-Webplattform, TradingView und ähnliche Tools) als auch einen Rithmic-Login (für Rithmic-kompatible Plattformen wie Quantower, NinjaTrader und Sierra Chart) bereitstellt. Gleicher Kontostand, gleiche Positionen, zwei verschiedene Zugangsdatensätze für zwei verschiedene Technologie-Stacks." },
    { type: "paragraph",html: "Die Lösung ist also nicht, Quantower dazu zu bringen, Tradovate zu &ldquo;akzeptieren&rdquo;. Sie besteht darin, Quantower so zu verbinden, wie es dafür gedacht ist, mit den Rithmic-Zugangsdaten, die Ihre Firma genau zu diesem Zweck bereits bereitgestellt hat." },
    { type: "heading",text: "Die häufigsten Ursachen, warum Quantower Tradovate-Zugangsdaten ablehnt" },
    { type: "heading",text: "1. Quantower hat keine native Tradovate-Verbindung" },
    { type: "paragraph",html: "Das ist die Grundursache, und sie erwischt fast jeden. Die Futures-Daten und das Order-Routing von Quantower laufen über Rithmic, CQG und ProjectX. In der Verbindungsliste gibt es keinen Tradovate-Adapter, daher gibt es physisch keinen Ort, an dem Sie eine Tradovate-E-Mail und ein Passwort eingeben könnten. Nichts, was Sie in ein Rithmic- oder CQG-Feld tippen, wird gegen die Server von Tradovate validiert." },
    { type: "heading",text: "2. Sie verwenden den Tradovate-Login statt des Rithmic-Logins" },
    { type: "paragraph",html: "Prop-Firmen geben mehr als einen Zugangsdatensatz aus, und man greift leicht zum falschen. Ihr Tradovate-Benutzername (oft eine E-Mail oder ein Name mit Firmenpräfix) gehört zur Tradovate-Seite. Ihr Rithmic-Benutzername ist eine eigene Zeichenfolge, häufig kürzer, manchmal mit einem Firmenkürzel. Der Tradovate-Login in der Rithmic-Verbindung von Quantower schlägt jedes Mal fehl, weil die Rithmic-Server ihn nicht kennen." },
    { type: "heading",text: "3. Ihre Firma hat Rithmic für dieses Konto nie aktiviert" },
    { type: "paragraph",html: "Manche Firmen lassen Sie beim Kauf der Evaluierung Ihren Datenfeed oder Ihre Plattform wählen. Haben Sie eine reine Tradovate-Route gewählt, existiert für dieses Konto möglicherweise noch kein Rithmic-Login. In diesem Fall kann Quantower es nicht verbinden, egal was Sie eingeben, und Sie müssen entweder beim Support Rithmic-Zugang anfordern oder die Plattformauswahl des Kontos wechseln. Ob das kostenlos, kostenpflichtig oder überhaupt möglich ist, variiert je nach Firma und Kontogröße, prüfen Sie also die aktuellen Regeln Ihrer Firma, bevor Sie etwas annehmen." },
    { type: "heading",text: "4. Falscher Rithmic-Server oder falsches Gateway" },
    { type: "paragraph",html: "Rithmic betreibt mehrere Gateways, und der Login funktioniert nur auf demjenigen, auf dem Ihr Konto liegt. Demo- und Evaluierungskonten liegen typischerweise auf einem Paper-Gateway, finanzierte und Live-Konten auf einem Live-Gateway. Richten Sie einen Login eines finanzierten Kontos auf den Paper-Server (oder umgekehrt), wird die Verbindung abgelehnt, obwohl Benutzername und Passwort korrekt sind." },
    { type: "heading",text: "5. Format der Zugangsdaten: Leerzeichen und Groß-/Kleinschreibung" },
    { type: "paragraph",html: "Rithmic-Logins unterscheiden Groß- und Kleinschreibung, und ein einzelnes nachgestelltes Leerzeichen aus einem Dashboard bricht die Authentifizierung. Schlägt es nach dem Einfügen von Benutzername oder Passwort fehl, tippen Sie es von Hand neu ein, achten Sie auf die Großschreibung und stellen Sie sicher, dass Autofill keinen alten Wert eingeschleust hat." },
    { type: "heading",text: "So beheben Sie es: Schritt für Schritt" },
    { type: "heading",text: "Den Login beheben: Quantower mit Rithmic verbinden" },
    {
      type: "steps",
      items: [
        { title: "Rithmic-Zugangsdaten besorgen", html: "Melden Sie sich im Kunden-Dashboard Ihrer Prop-Firma an und suchen Sie den Bereich für den Plattformzugang. Kopieren Sie den <strong class='text-white'>Rithmic</strong>-Benutzernamen und das Passwort. Diese liegen getrennt von Ihren Tradovate-Zugangsdaten, und manche Firmen zeigen sie erst nach der Aktivierung des Kontos an." },
        { title: "Connections in Quantower öffnen", html: "Öffnen Sie das Panel <strong class='text-white'>Connections</strong> (der Verbindungsmanager, in dem Sie Broker hinzufügen und verwalten). Bestätigen Sie die genaue Bezeichnung in Ihrem Build, denn Quantower überarbeitet diese Oberfläche regelmäßig." },
        { title: "Rithmic auswählen", html: "Wählen Sie <strong class='text-white'>Rithmic</strong> aus der Verbindungsliste. Suchen Sie nicht nach Tradovate, es ist nicht da und wird es nicht sein." },
        { title: "Den Login von Hand eingeben", html: "Geben Sie den Rithmic-Login und das Passwort exakt wie ausgestellt ein. Tippen Sie sie von Hand statt sie einzufügen und prüfen Sie die Schreibweise jedes Zeichens." },
        { title: "Den richtigen Server wählen", html: "Wählen Sie den von Ihrer Firma angegebenen <strong class='text-white'>Server</strong>. In der Regel nutzen Evaluierungs- und Demokonten ein Paper-Gateway und finanzierte Konten ein Live-Gateway, doch der genaue Gateway-Name ist firmenspezifisch, nutzen Sie daher den aus Ihrer Willkommens-E-Mail." },
        { title: "Auf Connect klicken", html: "Klicken Sie auf <strong class='text-white'>Connect</strong>. Bei Erfolg werden Kontostand und Positionen Ihres Prop-Kontos in Quantower geladen, und Sie können dort charten und handeln." },
      ],
    },
    { type: "heading",text: "Den richtigen Rithmic-Server wählen" },
    {
      type: "steps",
      items: [
        { title: "Umgebung dem Konto zuordnen", html: "Ein Paper- oder Demo-Gateway ist der Standard für Evaluierungen, ein Live-Gateway der Standard für finanzierte Konten." },
        { title: "Das von Ihrer Firma genannte Gateway verwenden", html: "Hat Ihre Firma in der Onboarding-E-Mail ein bestimmtes Gateway genannt, verwenden Sie genau diesen Eintrag. Es gibt firmengebrandete und regionsspezifische Gateways, und nur eines ist für Ihr Konto richtig." },
        { title: "Bei Ablehnung die andere Umgebung probieren", html: "Wird die Verbindung trotz korrekter Zugangsdaten abgelehnt, wechseln Sie zur anderen Umgebung und versuchen es erneut. Ein nicht passender Server ist der häufigste Grund, warum ein gültiger Login sich nicht verbindet." },
      ],
    },
    { type: "heading",text: "Einen „No handle“- oder Doppelsitzungs-Fehler beseitigen" },
    {
      type: "steps",
      items: [
        { title: "Andere Rithmic-Sitzungen schließen", html: "Schließen Sie R Trader Pro, falls geöffnet, und trennen Sie denselben Rithmic-Login von jeder anderen Plattform wie NinjaTrader." },
        { title: "Warten, bis die alte Sitzung beendet ist", html: "Warten Sie einige Sekunden, bis die alte Sitzung beendet ist, und verbinden Sie sich dann erneut in Quantower." },
        { title: "Plugin-Modus prüfen", html: "Wenn Sie auf den Plugin-Modus von R Trader Pro setzen, starten Sie ihn entweder im Modus &ldquo;Allow Plugins&rdquo; oder schalten Sie die Option Use R Trader in Quantower aus, um stattdessen eine direkte Verbindung herzustellen." },
      ],
    },
    { type: "heading",text: "Tabelle zur Fehlersuche" },
    { type: "table", headers: ["Was Sie sehen","Was es bedeutet","Lösung"], rows: [
      ["Keine Tradovate-Option in Quantower","Quantower hat keine native Tradovate-Verbindung","Stattdessen über Rithmic verbinden, mit den Rithmic-Zugangsdaten Ihrer Firma"],
      ["Login mit Tradovate-Benutzernamen fehlgeschlagen","Tradovate-Zugangsdaten authentifizieren sich nicht gegen Rithmic-Server","Den separaten Rithmic-Benutzernamen und das Passwort aus Ihrem Dashboard eingeben"],
      ["Login mit korrekten Rithmic-Daten fehlgeschlagen","Falscher Server, oder Rithmic ist für das Konto nicht aktiviert","Das richtige Gateway wählen oder Ihre Firma bitten, Rithmic-Zugang zu aktivieren"],
      ["&ldquo;No handle&rdquo; / Verbindung abgelehnt","Derselbe Rithmic-Login ist anderswo aktiv","R Trader Pro und andere Plattformen schließen, dann erneut verbinden"],
      ["Zeitweiliger Authentifizierungsfehler","Nachgestellte Leerzeichen oder falsche Groß-/Kleinschreibung in den Zugangsdaten","Login von Hand neu eingeben; Rithmic-Logins unterscheiden Groß- und Kleinschreibung"],
      ["Firma bietet überhaupt keinen Rithmic-Login","Das Konto ist nur für Tradovate bereitgestellt","In einer Tradovate-kompatiblen Plattform handeln oder einen Plattformwechsel beantragen"],
    ] },
    { type: "heading",text: "Vermeiden Sie das mit PickMyTrade" },
    { type: "paragraph",html: "Wenn Ihr Ziel ist, dieses Prop-Konto zu automatisieren, wird die Frage, ob Quantower einen Tradovate-Login akzeptiert, bedeutungslos. PickMyTrade verbindet sich direkt mit Ihrem bei Tradovate gehosteten Konto und löst Orders aus Ihren TradingView-Alerts aus, sodass Sie weiter in Quantower über Rithmic charten können, während die Ausführung auf der Tradovate-Seite läuft, ohne dass Sie Logins jonglieren müssen." },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Direktes Tradovate-Routing</strong> sendet Orders direkt an Ihr Tradovate-Prop-Konto, ohne Login bei einer Drittplattform.",
        "<strong class='text-white'>TradingView-zu-Broker-Automatisierung</strong> verwandelt Ihre Alerts in Live-Orders auf dem Konto, das Ihre Firma tatsächlich cleart.",
        "<strong class='text-white'>Prop-bewusste Risikofilter</strong> berücksichtigen die Limits Ihrer Firma und den Stand der Datenvereinbarung, bevor eine Order hinausgeht.",
        "<strong class='text-white'>Multi-Account-Sync</strong> spiegelt einen einzelnen Alert gleichzeitig auf mehrere Prop-Konten.",
      ],
    },
  ], es: [
    { type: "paragraph",html: "Compró un combine prop que funciona sobre Tradovate, abre Quantower y no hay dónde escribir su usuario de Tradovate. O lo fuerza en el cuadro equivocado y simplemente falla. Eso es lo esperado en 2026: Quantower no enruta futuros a través de Tradovate en absoluto, así que su inicio de sesión de Tradovate nunca iba a funcionar. La cuenta que fondeó, sin embargo, casi con seguridad es accesible a través de las credenciales de Rithmic que su firma entrega junto con ella." },
    {
      type: "checklist",
      heading: "Lista rápida para el problema de inicio de sesión de Tradovate en Quantower",
      items: [
        "<strong class='text-white'>Deje de buscar una conexión con Tradovate.</strong> Quantower no tiene ninguna. Su lado de futuros funciona sobre Rithmic, CQG y ProjectX, no sobre la API de Tradovate.",
        "<strong class='text-white'>Encuentre su usuario y contraseña de Rithmic.</strong> Su firma prop los emite por separado de su inicio de sesión de Tradovate, normalmente en el panel de la cuenta o en el correo de bienvenida.",
        "<strong class='text-white'>Abra Connections y elija Rithmic.</strong> Introduzca el inicio de sesión de Rithmic exactamente como se emitió, incluidas las mayúsculas y minúsculas, sin espacios iniciales ni finales.",
        "<strong class='text-white'>Elija el servidor correcto.</strong> Las cuentas de evaluación y las fondeadas están en gateways de Rithmic distintos. Use el que su firma le indique.",
        "<strong class='text-white'>Cierre sesión en todos los demás sitios primero.</strong> Si el mismo inicio de sesión de Rithmic está activo en R Trader Pro u otra plataforma, Quantower puede lanzar un error de conexión.",
        "<strong class='text-white'>¿Su firma no ofrece opción de Rithmic?</strong> Entonces esa cuenta es solo de Tradovate y necesitará una plataforma compatible con Tradovate en lugar de Quantower.",
      ],
    },
    { type: "heading",text: "Qué significa «Quantower no acepta su inicio de sesión de Tradovate»" },
    { type: "paragraph",html: "La versión corta: esto no es un error y no hay nada roto en su cuenta de Tradovate. Quantower simplemente nunca construyó una integración directa con Tradovate. Al recorrer su lista de conexiones de futuros verá Rithmic, CQG, ProjectX y gateways con marca de firma, pero ninguna entrada &ldquo;Tradovate&rdquo;. Así que las credenciales que le dio Tradovate no tienen ningún campo donde ir, y cualquier intento de reutilizarlas en otra conexión es rechazado." },
    { type: "paragraph",html: "La razón por la que esto confunde a tantos traders prop es que Tradovate y Rithmic suelen estar detrás de la misma cuenta. Muchas firmas compensan a través de una infraestructura que expone tanto un inicio de sesión de Tradovate (para la plataforma web de Tradovate, TradingView y herramientas similares) como un inicio de sesión de Rithmic (para plataformas compatibles con Rithmic como Quantower, NinjaTrader y Sierra Chart). Mismo saldo, mismas posiciones, dos conjuntos de credenciales distintos para dos pilas tecnológicas distintas." },
    { type: "paragraph",html: "Así que la solución no es lograr que Quantower &ldquo;acepte&rdquo; Tradovate. Es conectar Quantower de la manera en que fue diseñado para conectarse, usando las credenciales de Rithmic que su firma ya aprovisionó exactamente para este fin." },
    { type: "heading",text: "Principales causas de que Quantower rechace las credenciales de Tradovate" },
    { type: "heading",text: "1. Quantower no tiene una conexión nativa con Tradovate" },
    { type: "paragraph",html: "Esta es la causa raíz y atrapa a casi todos. Los datos de futuros y el enrutamiento de órdenes de Quantower pasan por Rithmic, CQG y ProjectX. No hay un adaptador de Tradovate en la lista de conexiones, así que físicamente no existe un lugar donde introducir un correo y una contraseña de Tradovate. Nada de lo que escriba en un cuadro de Rithmic o CQG se validará contra los servidores de Tradovate." },
    { type: "heading",text: "2. Está usando el inicio de sesión de Tradovate en lugar del de Rithmic" },
    { type: "paragraph",html: "Las firmas prop entregan más de un conjunto de credenciales y es fácil tomar el equivocado. Su usuario de Tradovate (a menudo un correo o un nombre con prefijo de firma) es para el lado de Tradovate. Su usuario de Rithmic es una cadena distinta, con frecuencia más corta, a veces con una etiqueta de la firma. Introducir el de Tradovate en la conexión Rithmic de Quantower falla siempre porque los servidores de Rithmic nunca han oído hablar de él." },
    { type: "heading",text: "3. Su firma nunca habilitó Rithmic en esa cuenta" },
    { type: "paragraph",html: "Algunas firmas le dejan elegir su feed de datos o plataforma al comprar la evaluación. Si eligió una ruta solo de Tradovate, puede que aún no exista un inicio de sesión de Rithmic para esa cuenta. En ese caso Quantower no puede conectarla por mucho que escriba, y tendrá que solicitar acceso a Rithmic al soporte o cambiar la selección de plataforma de la cuenta. Que sea gratis, de pago o siquiera posible varía según la firma y el tamaño de la cuenta, así que revise las reglas actuales de su firma antes de dar nada por sentado." },
    { type: "heading",text: "4. Servidor o gateway de Rithmic incorrecto" },
    { type: "paragraph",html: "Rithmic opera varios gateways y el inicio de sesión solo funciona en aquel donde vive su cuenta. Las cuentas demo y de evaluación suelen estar en un gateway de paper, mientras que las fondeadas y las reales están en un gateway live. Si apunta un inicio de sesión de cuenta fondeada al servidor de paper (o al revés), la conexión es rechazada aunque el usuario y la contraseña sean correctos." },
    { type: "heading",text: "5. Formato de las credenciales: espacios y mayúsculas" },
    { type: "paragraph",html: "Los inicios de sesión de Rithmic distinguen mayúsculas de minúsculas, y un solo espacio final copiado de un panel romperá la autenticación. Si pega el usuario o la contraseña y falla, vuelva a escribirlo a mano, vigile las mayúsculas y asegúrese de que el autocompletado no haya colado un valor antiguo." },
    { type: "heading",text: "Cómo solucionarlo: paso a paso" },
    { type: "heading",text: "Solucionar el inicio de sesión: conecte Quantower con Rithmic" },
    {
      type: "steps",
      items: [
        { title: "Obtenga sus credenciales de Rithmic", html: "Inicie sesión en el panel de cliente de su firma prop y localice la sección de acceso a plataformas. Copie el usuario y la contraseña de <strong class='text-white'>Rithmic</strong>. Estos están separados de sus credenciales de Tradovate, y algunas firmas solo los revelan después de activar la cuenta." },
        { title: "Abra Connections en Quantower", html: "Abra el panel <strong class='text-white'>Connections</strong> (el gestor de conexiones donde añade y administra brokers). Confirme la etiqueta exacta en su versión, ya que Quantower revisa esta interfaz periódicamente." },
        { title: "Seleccione Rithmic", html: "Seleccione <strong class='text-white'>Rithmic</strong> de la lista de conexiones. No busque Tradovate; no está y no estará." },
        { title: "Introduzca el inicio de sesión a mano", html: "Introduzca el inicio de sesión y la contraseña de Rithmic exactamente como se emitieron. Escríbalos a mano en lugar de pegarlos y revise las mayúsculas de cada carácter." },
        { title: "Elija el servidor correcto", html: "Elija el <strong class='text-white'>servidor</strong> que especificó su firma. Por regla general, las cuentas de evaluación y demo usan un gateway de paper y las fondeadas un gateway live, pero el nombre exacto del gateway es específico de cada firma, así que use el de su correo de bienvenida." },
        { title: "Haga clic en Connect", html: "Haga clic en <strong class='text-white'>Connect</strong>. Cuando tenga éxito, el saldo y las posiciones de su cuenta prop se cargarán en Quantower y podrá graficar y operar allí." },
      ],
    },
    { type: "heading",text: "Elegir el servidor de Rithmic correcto" },
    {
      type: "steps",
      items: [
        { title: "Haga coincidir el entorno con la cuenta", html: "Un gateway de paper o demo es el predeterminado para las evaluaciones; un gateway live es el predeterminado para las cuentas fondeadas." },
        { title: "Use el gateway que nombró su firma", html: "Si su firma nombró un gateway específico en su correo de incorporación, use exactamente esa entrada. Existen gateways con marca de firma y específicos de región, y solo uno es correcto para su cuenta." },
        { title: "Pruebe el otro entorno si se rechaza", html: "Si la conexión es rechazada con credenciales correctas, cambie al otro entorno y vuelva a intentarlo. Un servidor que no coincide es el motivo más común por el que un inicio de sesión válido no conecta." },
      ],
    },
    { type: "heading",text: "Resolver un error «No handle» o de sesión duplicada" },
    {
      type: "steps",
      items: [
        { title: "Cierre otras sesiones de Rithmic", html: "Cierre R Trader Pro si lo tiene abierto y desconecte el mismo inicio de sesión de Rithmic de cualquier otra plataforma, como NinjaTrader." },
        { title: "Espere a que caiga la sesión antigua", html: "Espere unos segundos a que caiga la sesión antigua y luego vuelva a conectar en Quantower." },
        { title: "Revise el modo plugin", html: "Si depende del modo plugin de R Trader Pro, inícielo en modo &ldquo;Allow Plugins&rdquo; o desactive la opción Use R Trader en Quantower para hacer una conexión directa." },
      ],
    },
    { type: "heading",text: "Tabla de resolución de problemas" },
    { type: "table", headers: ["Qué ve","Qué significa","Solución"], rows: [
      ["No hay opción de Tradovate en Quantower","Quantower no tiene una conexión nativa con Tradovate","Conéctese a través de Rithmic, usando las credenciales de Rithmic de su firma"],
      ["Falló el inicio de sesión con el usuario de Tradovate","Las credenciales de Tradovate no se autentican contra los servidores de Rithmic","Introduzca el usuario y la contraseña de Rithmic independientes de su panel"],
      ["Falló el inicio de sesión con datos de Rithmic correctos","Servidor equivocado, o Rithmic no habilitado en la cuenta","Seleccione el gateway correcto o pida a su firma que habilite el acceso a Rithmic"],
      ["&ldquo;No handle&rdquo; / conexión rechazada","El mismo inicio de sesión de Rithmic está activo en otro lugar","Cierre R Trader Pro y otras plataformas, luego vuelva a conectar"],
      ["Fallo de autenticación intermitente","Espacios finales o mayúsculas incorrectas en las credenciales","Vuelva a escribir el inicio de sesión a mano; los inicios de sesión de Rithmic distinguen mayúsculas de minúsculas"],
      ["La firma no ofrece ningún inicio de sesión de Rithmic","La cuenta está aprovisionada solo para Tradovate","Opérela en una plataforma compatible con Tradovate o solicite un cambio de plataforma"],
    ] },
    { type: "heading",text: "Evítelo con PickMyTrade" },
    { type: "paragraph",html: "Si su objetivo es automatizar esa cuenta prop, que Quantower acepte o no un inicio de sesión de Tradovate deja de importar. PickMyTrade se conecta directamente a su cuenta alojada en Tradovate y dispara órdenes desde sus alertas de TradingView, de modo que puede seguir graficando en Quantower sobre Rithmic mientras la ejecución corre en el lado de Tradovate sin que tenga que hacer malabares con inicios de sesión." },
    {
      type: "list",
      items: [
        "<strong class='text-white'>El enrutamiento directo a Tradovate</strong> envía las órdenes directamente a su cuenta prop de Tradovate, sin necesidad de iniciar sesión en una plataforma de terceros.",
        "<strong class='text-white'>La automatización de TradingView a broker</strong> convierte sus alertas en órdenes reales en la cuenta que su firma realmente compensa.",
        "<strong class='text-white'>Los filtros de riesgo conscientes de prop</strong> respetan los límites de su firma y el estado del acuerdo de datos antes de que salga una orden.",
        "<strong class='text-white'>La sincronización multicuenta</strong> replica una sola alerta en varias cuentas prop a la vez.",
      ],
    },
  ], fr: [
    { type: "paragraph",html: "Vous avez acheté un combine prop qui fonctionne sur Tradovate, vous ouvrez Quantower, et il n'y a aucun endroit où saisir votre identifiant Tradovate. Ou vous le forcez dans la mauvaise case et cela échoue tout simplement. C'est normal en 2026 : Quantower n'achemine pas du tout les contrats à terme via Tradovate ; votre connexion Tradovate ne pouvait donc jamais fonctionner. Le compte que vous avez financé est en revanche presque certainement accessible via les identifiants Rithmic que votre société remet avec lui." },
    {
      type: "checklist",
      heading: "Liste de vérification rapide pour le problème de connexion Tradovate dans Quantower",
      items: [
        "<strong class='text-white'>Cessez de chercher une connexion Tradovate.</strong> Quantower n'en a pas. Son volet contrats à terme repose sur Rithmic, CQG et ProjectX, pas sur l'API de Tradovate.",
        "<strong class='text-white'>Trouvez votre identifiant et mot de passe Rithmic.</strong> Votre société prop les émet séparément de votre connexion Tradovate, généralement dans le tableau de bord du compte ou dans l'e-mail de bienvenue.",
        "<strong class='text-white'>Ouvrez Connections et choisissez Rithmic.</strong> Saisissez la connexion Rithmic exactement comme émise, casse comprise, sans espace initial ni final.",
        "<strong class='text-white'>Choisissez le bon serveur.</strong> Les comptes d'évaluation et les comptes financés se trouvent sur des passerelles Rithmic différentes. Utilisez celle que votre société vous indique.",
        "<strong class='text-white'>Déconnectez-vous d'abord partout ailleurs.</strong> Si la même connexion Rithmic est active dans R Trader Pro ou une autre plateforme, Quantower peut renvoyer une erreur de connexion.",
        "<strong class='text-white'>Aucune option Rithmic de la part de votre société ?</strong> Alors ce compte est réservé à Tradovate, et il vous faudra une plateforme compatible Tradovate à la place de Quantower.",
      ],
    },
    { type: "heading",text: "Ce que signifie « Quantower n'accepte pas votre connexion Tradovate »" },
    { type: "paragraph",html: "La version courte : ce n'est pas un bug, et rien n'est cassé dans votre compte Tradovate. Quantower n'a simplement jamais construit d'intégration directe avec Tradovate. Lorsque vous faites défiler sa liste de connexions pour les contrats à terme, vous voyez Rithmic, CQG, ProjectX et des passerelles aux couleurs des sociétés, mais aucune entrée &ldquo;Tradovate&rdquo;. Les identifiants que Tradovate vous a donnés n'ont donc aucun champ où aller, et toute tentative de les réutiliser dans une autre connexion est rejetée." },
    { type: "paragraph",html: "La raison pour laquelle cela piège autant de traders prop est que Tradovate et Rithmic se trouvent souvent derrière le même compte. De nombreuses sociétés compensent via une infrastructure qui expose à la fois une connexion Tradovate (pour la plateforme web Tradovate, TradingView et les outils du même genre) et une connexion Rithmic (pour les plateformes compatibles Rithmic comme Quantower, NinjaTrader et Sierra Chart). Même solde, mêmes positions, deux jeux d'identifiants différents pour deux piles technologiques différentes." },
    { type: "paragraph",html: "Le correctif ne consiste donc pas à faire &ldquo;accepter&rdquo; Tradovate par Quantower. Il consiste à connecter Quantower de la manière dont il a été conçu pour l'être, avec les identifiants Rithmic que votre société a déjà provisionnés précisément à cette fin." },
    { type: "heading",text: "Principales causes du rejet des identifiants Tradovate par Quantower" },
    { type: "heading",text: "1. Quantower n'a pas de connexion native à Tradovate" },
    { type: "paragraph",html: "C'est la cause racine, et elle piège presque tout le monde. Les données de contrats à terme et l'acheminement des ordres de Quantower passent par Rithmic, CQG et ProjectX. Il n'y a pas d'adaptateur Tradovate dans la liste des connexions ; il n'existe donc physiquement aucun endroit où saisir un e-mail et un mot de passe Tradovate. Rien de ce que vous tapez dans une case Rithmic ou CQG ne sera validé auprès des serveurs de Tradovate." },
    { type: "heading",text: "2. Vous utilisez la connexion Tradovate au lieu de la connexion Rithmic" },
    { type: "paragraph",html: "Les sociétés prop remettent plus d'un jeu d'identifiants, et il est facile de prendre le mauvais. Votre identifiant Tradovate (souvent un e-mail, ou un nom préfixé par la société) concerne le côté Tradovate. Votre identifiant Rithmic est une chaîne distincte, souvent plus courte, parfois avec une balise de société. Saisir celui de Tradovate dans la connexion Rithmic de Quantower échoue à chaque fois, car les serveurs de Rithmic n'en ont jamais entendu parler." },
    { type: "heading",text: "3. Votre société n'a jamais activé Rithmic sur ce compte" },
    { type: "paragraph",html: "Certaines sociétés vous laissent choisir votre flux de données ou votre plateforme lors de l'achat de l'évaluation. Si vous avez choisi une voie réservée à Tradovate, il se peut qu'aucune connexion Rithmic n'existe encore pour ce compte. Dans ce cas, Quantower ne peut pas le connecter quoi que vous tapiez, et vous devrez soit demander l'accès à Rithmic au support, soit changer la sélection de plateforme du compte. Que ce soit gratuit, payant ou même possible varie selon la société et la taille du compte ; vérifiez donc les règles actuelles de votre société avant de présumer quoi que ce soit." },
    { type: "heading",text: "4. Mauvais serveur ou mauvaise passerelle Rithmic" },
    { type: "paragraph",html: "Rithmic exploite plusieurs passerelles, et la connexion ne fonctionne que sur celle où se trouve votre compte. Les comptes de démo et d'évaluation se trouvent généralement sur une passerelle paper, tandis que les comptes financés et réels se trouvent sur une passerelle live. Si vous dirigez une connexion de compte financé vers le serveur paper (ou l'inverse), la connexion est refusée même si l'identifiant et le mot de passe sont corrects." },
    { type: "heading",text: "5. Format des identifiants : espaces et majuscules" },
    { type: "paragraph",html: "Les connexions Rithmic sont sensibles à la casse, et un seul espace final copié depuis un tableau de bord fera échouer l'authentification. Si vous collez l'identifiant ou le mot de passe et que cela échoue, retapez-le à la main, surveillez les majuscules et assurez-vous que le remplissage automatique n'a pas glissé une ancienne valeur." },
    { type: "heading",text: "Comment le corriger : pas à pas" },
    { type: "heading",text: "Corriger la connexion : connectez Quantower avec Rithmic" },
    {
      type: "steps",
      items: [
        { title: "Obtenez vos identifiants Rithmic", html: "Connectez-vous au tableau de bord client de votre société prop et repérez la section d'accès aux plateformes. Copiez l'identifiant et le mot de passe <strong class='text-white'>Rithmic</strong>. Ils sont distincts de vos identifiants Tradovate, et certaines sociétés ne les révèlent qu'après l'activation du compte." },
        { title: "Ouvrez Connections dans Quantower", html: "Ouvrez le panneau <strong class='text-white'>Connections</strong> (le gestionnaire de connexions où vous ajoutez et gérez les courtiers). Confirmez le libellé exact dans votre version, car Quantower révise cette interface périodiquement." },
        { title: "Sélectionnez Rithmic", html: "Sélectionnez <strong class='text-white'>Rithmic</strong> dans la liste des connexions. Ne cherchez pas Tradovate ; il n'y est pas et n'y sera pas." },
        { title: "Saisissez la connexion à la main", html: "Saisissez l'identifiant et le mot de passe Rithmic exactement comme émis. Tapez-les à la main plutôt que de les coller, et vérifiez la casse de chaque caractère." },
        { title: "Choisissez le bon serveur", html: "Choisissez le <strong class='text-white'>serveur</strong> indiqué par votre société. En règle générale, les comptes d'évaluation et de démo utilisent une passerelle paper et les comptes financés une passerelle live, mais le nom exact de la passerelle est propre à chaque société ; utilisez donc celui de votre e-mail de bienvenue." },
        { title: "Cliquez sur Connect", html: "Cliquez sur <strong class='text-white'>Connect</strong>. En cas de succès, le solde et les positions de votre compte prop se chargent dans Quantower, et vous pouvez y analyser vos graphiques et y trader." },
      ],
    },
    { type: "heading",text: "Choisir le bon serveur Rithmic" },
    {
      type: "steps",
      items: [
        { title: "Faites correspondre l'environnement au compte", html: "Une passerelle paper ou démo est la valeur par défaut pour les évaluations ; une passerelle live est la valeur par défaut pour les comptes financés." },
        { title: "Utilisez la passerelle nommée par votre société", html: "Si votre société a nommé une passerelle précise dans votre e-mail d'intégration, utilisez exactement cette entrée. Il existe des passerelles aux couleurs des sociétés et propres à une région, et une seule est la bonne pour votre compte." },
        { title: "Essayez l'autre environnement en cas de refus", html: "Si la connexion est refusée alors que les identifiants sont corrects, passez à l'autre environnement et réessayez. Un serveur qui ne correspond pas est la raison la plus courante pour laquelle une connexion valide ne passe pas." },
      ],
    },
    { type: "heading",text: "Résoudre une erreur « No handle » ou de session en double" },
    {
      type: "steps",
      items: [
        { title: "Fermez les autres sessions Rithmic", html: "Fermez R Trader Pro s'il est ouvert, et déconnectez la même connexion Rithmic de toute autre plateforme comme NinjaTrader." },
        { title: "Attendez que l'ancienne session se ferme", html: "Attendez quelques secondes que l'ancienne session se ferme, puis reconnectez-vous dans Quantower." },
        { title: "Vérifiez le mode plugin", html: "Si vous comptez sur le mode plugin de R Trader Pro, lancez-le en mode &ldquo;Allow Plugins&rdquo; ou désactivez l'option Use R Trader dans Quantower afin d'établir une connexion directe." },
      ],
    },
    { type: "heading",text: "Tableau de dépannage" },
    { type: "table", headers: ["Ce que vous voyez","Ce que cela signifie","Correctif"], rows: [
      ["Aucune option Tradovate dans Quantower","Quantower n'a pas de connexion native à Tradovate","Connectez-vous via Rithmic, avec les identifiants Rithmic de votre société"],
      ["Échec de la connexion avec l'identifiant Tradovate","Les identifiants Tradovate ne s'authentifient pas auprès des serveurs Rithmic","Saisissez l'identifiant et le mot de passe Rithmic distincts de votre tableau de bord"],
      ["Échec de la connexion avec des identifiants Rithmic corrects","Mauvais serveur, ou Rithmic non activé sur le compte","Sélectionnez la bonne passerelle, ou demandez à votre société d'activer l'accès Rithmic"],
      ["&ldquo;No handle&rdquo; / connexion refusée","La même connexion Rithmic est active ailleurs","Fermez R Trader Pro et les autres plateformes, puis reconnectez-vous"],
      ["Échec d'authentification intermittent","Espaces finaux ou majuscules incorrectes dans les identifiants","Retapez la connexion à la main ; les connexions Rithmic sont sensibles à la casse"],
      ["La société n'offre aucune connexion Rithmic","Le compte est provisionné uniquement pour Tradovate","Tradez-le sur une plateforme compatible Tradovate, ou demandez un changement de plateforme"],
    ] },
    { type: "heading",text: "Évitez cela avec PickMyTrade" },
    { type: "paragraph",html: "Si votre objectif est d'automatiser ce compte prop, le fait que Quantower accepte ou non une connexion Tradovate devient sans importance. PickMyTrade se connecte directement à votre compte hébergé chez Tradovate et déclenche des ordres à partir de vos alertes TradingView ; vous pouvez ainsi continuer à analyser vos graphiques dans Quantower via Rithmic pendant que l'exécution tourne côté Tradovate, sans avoir à jongler avec les connexions." },
    {
      type: "list",
      items: [
        "<strong class='text-white'>L'acheminement direct vers Tradovate</strong> envoie les ordres directement à votre compte prop Tradovate, sans connexion à une plateforme tierce.",
        "<strong class='text-white'>L'automatisation de TradingView vers le courtier</strong> transforme vos alertes en ordres réels sur le compte que votre société compense réellement.",
        "<strong class='text-white'>Les filtres de risque adaptés aux sociétés prop</strong> respectent les limites de votre société et l'état de l'accord de données avant qu'un ordre ne parte.",
        "<strong class='text-white'>La synchronisation multicompte</strong> réplique une seule alerte sur plusieurs comptes prop à la fois.",
      ],
    },
  ], it: [
    { type: "paragraph",html: "Ha acquistato un combine prop che gira su Tradovate, apre Quantower e non c'è nessun posto dove digitare il Suo nome utente Tradovate. Oppure lo forza nella casella sbagliata e semplicemente fallisce. È normale nel 2026: Quantower non instrada affatto i futures tramite Tradovate, quindi il Suo login Tradovate non avrebbe mai funzionato. Il conto che ha finanziato è però quasi certamente raggiungibile tramite le credenziali Rithmic che la Sua società consegna insieme ad esso." },
    {
      type: "checklist",
      heading: "Checklist rapida per il problema del login Tradovate in Quantower",
      items: [
        "<strong class='text-white'>Smetta di cercare una connessione Tradovate.</strong> Quantower non ne ha una. Il suo lato futures gira su Rithmic, CQG e ProjectX, non sull'API di Tradovate.",
        "<strong class='text-white'>Trovi il Suo nome utente e la password Rithmic.</strong> La Sua società prop li rilascia separatamente dal login Tradovate, di solito nella dashboard del conto o nell'e-mail di benvenuto.",
        "<strong class='text-white'>Apra Connections e scelga Rithmic.</strong> Inserisca il login Rithmic esattamente come rilasciato, maiuscole incluse, senza spazi iniziali o finali.",
        "<strong class='text-white'>Scelga il server giusto.</strong> I conti di valutazione e quelli finanziati stanno su gateway Rithmic diversi. Usi quello che la Sua società Le indica.",
        "<strong class='text-white'>Prima esca da ogni altro posto.</strong> Se lo stesso login Rithmic è attivo in R Trader Pro o in un'altra piattaforma, Quantower può restituire un errore di connessione.",
        "<strong class='text-white'>Nessuna opzione Rithmic dalla Sua società?</strong> Allora quel conto è solo Tradovate e Le serve una piattaforma compatibile con Tradovate al posto di Quantower.",
      ],
    },
    { type: "heading",text: "Cosa significa «Quantower non accetta il Suo login Tradovate»" },
    { type: "paragraph",html: "La versione breve: non è un bug e non c'è nulla di rotto nel Suo conto Tradovate. Quantower semplicemente non ha mai costruito un'integrazione diretta con Tradovate. Scorrendo l'elenco delle sue connessioni per i futures vedrà Rithmic, CQG, ProjectX e gateway con il marchio delle società, ma nessuna voce &ldquo;Tradovate&rdquo;. Le credenziali che Tradovate Le ha dato non hanno quindi alcun campo in cui andare, e qualsiasi tentativo di riutilizzarle in un'altra connessione viene respinto." },
    { type: "paragraph",html: "Il motivo per cui questo mette in difficoltà così tanti trader prop è che Tradovate e Rithmic spesso stanno dietro allo stesso conto. Molte società effettuano il clearing tramite un'infrastruttura che espone sia un login Tradovate (per la piattaforma web Tradovate, TradingView e strumenti simili) sia un login Rithmic (per piattaforme compatibili con Rithmic come Quantower, NinjaTrader e Sierra Chart). Stesso saldo, stesse posizioni, due diversi set di credenziali per due diversi stack tecnologici." },
    { type: "paragraph",html: "La soluzione quindi non è far sì che Quantower &ldquo;accetti&rdquo; Tradovate. È collegare Quantower nel modo in cui è stato progettato per collegarsi, usando le credenziali Rithmic che la Sua società ha già predisposto esattamente per questo scopo." },
    { type: "heading",text: "Cause principali del rifiuto delle credenziali Tradovate da parte di Quantower" },
    { type: "heading",text: "1. Quantower non ha una connessione nativa con Tradovate" },
    { type: "paragraph",html: "Questa è la causa radice e frega quasi tutti. I dati dei futures e l'instradamento degli ordini di Quantower passano per Rithmic, CQG e ProjectX. Non c'è un adattatore Tradovate nell'elenco delle connessioni, quindi fisicamente non esiste un posto dove inserire un'e-mail e una password Tradovate. Nulla di ciò che digita in una casella Rithmic o CQG verrà validato dai server di Tradovate." },
    { type: "heading",text: "2. Sta usando il login Tradovate anziché quello Rithmic" },
    { type: "paragraph",html: "Le società prop consegnano più di un set di credenziali ed è facile prendere quello sbagliato. Il Suo nome utente Tradovate (spesso un'e-mail, o un nome con prefisso della società) è per il lato Tradovate. Il Suo nome utente Rithmic è una stringa distinta, spesso più corta, a volte con un'etichetta della società. Inserire quello Tradovate nella connessione Rithmic di Quantower fallisce ogni volta perché i server di Rithmic non lo conoscono." },
    { type: "heading",text: "3. La Sua società non ha mai abilitato Rithmic su quel conto" },
    { type: "paragraph",html: "Alcune società Le fanno scegliere il feed di dati o la piattaforma quando acquista la valutazione. Se ha scelto un percorso solo Tradovate, potrebbe non esistere ancora un login Rithmic per quel conto. In tal caso Quantower non può collegarlo qualunque cosa digiti, e dovrà richiedere l'accesso a Rithmic al supporto oppure cambiare la selezione della piattaforma del conto. Se sia gratuito, a pagamento o addirittura disponibile varia in base alla società e alla dimensione del conto, quindi controlli le regole attuali della Sua società prima di dare qualcosa per scontato." },
    { type: "heading",text: "4. Server o gateway Rithmic sbagliato" },
    { type: "paragraph",html: "Rithmic gestisce più gateway e il login funziona solo su quello su cui risiede il Suo conto. I conti demo e di valutazione di solito stanno su un gateway paper, mentre quelli finanziati e live stanno su un gateway live. Se punta il login di un conto finanziato al server paper (o viceversa), la connessione viene rifiutata anche se nome utente e password sono corretti." },
    { type: "heading",text: "5. Formato delle credenziali: spazi e maiuscole" },
    { type: "paragraph",html: "I login Rithmic distinguono maiuscole e minuscole, e un singolo spazio finale copiato da una dashboard farà fallire l'autenticazione. Se incolla il nome utente o la password e fallisce, li ridigiti a mano, faccia attenzione alle maiuscole e si assicuri che il riempimento automatico non abbia inserito un vecchio valore." },
    { type: "heading",text: "Come correggere: passo dopo passo" },
    { type: "heading",text: "Correggere il login: colleghi Quantower con Rithmic" },
    {
      type: "steps",
      items: [
        { title: "Ottenga le Sue credenziali Rithmic", html: "Acceda alla dashboard cliente della Sua società prop e individui la sezione di accesso alle piattaforme. Copi il nome utente e la password <strong class='text-white'>Rithmic</strong>. Sono separati dalle Sue credenziali Tradovate, e alcune società li rivelano solo dopo l'attivazione del conto." },
        { title: "Apra Connections in Quantower", html: "Apra il pannello <strong class='text-white'>Connections</strong> (il gestore delle connessioni in cui aggiunge e gestisce i broker). Confermi l'etichetta esatta nella Sua versione, poiché Quantower rivede periodicamente questa interfaccia." },
        { title: "Selezioni Rithmic", html: "Selezioni <strong class='text-white'>Rithmic</strong> dall'elenco delle connessioni. Non cerchi Tradovate: non c'è e non ci sarà." },
        { title: "Inserisca il login a mano", html: "Inserisca login e password Rithmic esattamente come rilasciati. Li digiti a mano anziché incollarli e controlli le maiuscole di ogni carattere." },
        { title: "Scelga il server corretto", html: "Scelga il <strong class='text-white'>server</strong> indicato dalla Sua società. Di norma i conti di valutazione e demo usano un gateway paper e i conti finanziati un gateway live, ma il nome esatto del gateway è specifico della società, quindi usi quello della Sua e-mail di benvenuto." },
        { title: "Clicchi su Connect", html: "Clicchi su <strong class='text-white'>Connect</strong>. Quando riesce, saldo e posizioni del Suo conto prop si caricano in Quantower e può fare grafici e operare lì." },
      ],
    },
    { type: "heading",text: "Scegliere il server Rithmic corretto" },
    {
      type: "steps",
      items: [
        { title: "Abbini l'ambiente al conto", html: "Un gateway paper o demo è l'impostazione predefinita per le valutazioni; un gateway live è l'impostazione predefinita per i conti finanziati." },
        { title: "Usi il gateway indicato dalla Sua società", html: "Se la Sua società ha indicato un gateway specifico nell'e-mail di onboarding, usi esattamente quella voce. Esistono gateway con il marchio della società e specifici per regione, e solo uno è corretto per il Suo conto." },
        { title: "Provi l'altro ambiente se rifiutato", html: "Se la connessione viene rifiutata con credenziali corrette, passi all'altro ambiente e riprovi. Un server non corrispondente è il motivo più comune per cui un login valido non si collega." },
      ],
    },
    { type: "heading",text: "Risolvere un errore «No handle» o di sessione duplicata" },
    {
      type: "steps",
      items: [
        { title: "Chiuda le altre sessioni Rithmic", html: "Chiuda R Trader Pro se è aperto e scolleghi lo stesso login Rithmic da qualsiasi altra piattaforma come NinjaTrader." },
        { title: "Attenda che la vecchia sessione cada", html: "Attenda qualche secondo che la vecchia sessione cada, poi si ricolleghi in Quantower." },
        { title: "Controlli la modalità plugin", html: "Se si affida alla modalità plugin di R Trader Pro, la avvii in modalità &ldquo;Allow Plugins&rdquo; oppure disattivi l'opzione Use R Trader in Quantower per stabilire invece una connessione diretta." },
      ],
    },
    { type: "heading",text: "Tabella di risoluzione dei problemi" },
    { type: "table", headers: ["Cosa vede","Cosa significa","Soluzione"], rows: [
      ["Nessuna opzione Tradovate in Quantower","Quantower non ha una connessione nativa con Tradovate","Si colleghi tramite Rithmic, usando le credenziali Rithmic della Sua società"],
      ["Login fallito con il nome utente Tradovate","Le credenziali Tradovate non si autenticano sui server Rithmic","Inserisca il nome utente e la password Rithmic separati dalla Sua dashboard"],
      ["Login fallito con dati Rithmic corretti","Server sbagliato, o Rithmic non abilitato sul conto","Selezioni il gateway corretto, o chieda alla Sua società di abilitare l'accesso Rithmic"],
      ["&ldquo;No handle&rdquo; / connessione rifiutata","Lo stesso login Rithmic è attivo altrove","Chiuda R Trader Pro e le altre piattaforme, poi si ricolleghi"],
      ["Errore di autenticazione intermittente","Spazi finali o maiuscole errate nelle credenziali","Ridigiti il login a mano; i login Rithmic distinguono maiuscole e minuscole"],
      ["La società non offre alcun login Rithmic","Il conto è predisposto solo per Tradovate","Operi su una piattaforma compatibile con Tradovate o richieda un cambio di piattaforma"],
    ] },
    { type: "heading",text: "Lo eviti con PickMyTrade" },
    { type: "paragraph",html: "Se il Suo obiettivo è automatizzare quel conto prop, il fatto che Quantower accetti o meno un login Tradovate diventa irrilevante. PickMyTrade si collega direttamente al Suo conto ospitato su Tradovate e lancia ordini dai Suoi alert di TradingView, così può continuare a fare grafici in Quantower tramite Rithmic mentre l'esecuzione gira sul lato Tradovate senza che debba destreggiarsi tra i login." },
    {
      type: "list",
      items: [
        "<strong class='text-white'>L'instradamento diretto verso Tradovate</strong> invia gli ordini direttamente al Suo conto prop Tradovate, senza bisogno del login di una piattaforma di terze parti.",
        "<strong class='text-white'>L'automazione da TradingView al broker</strong> trasforma i Suoi alert in ordini reali sul conto che la Sua società effettivamente gestisce.",
        "<strong class='text-white'>I filtri di rischio consapevoli del prop</strong> rispettano i limiti della Sua società e lo stato dell'accordo sui dati prima che un ordine parta.",
        "<strong class='text-white'>La sincronizzazione multi-account</strong> replica un singolo alert su più conti prop contemporaneamente.",
      ],
    },
  ] },
  ctaHeading: { en: "Automate Your Tradovate Prop Account", de: "Automatisieren Sie Ihr Tradovate-Prop-Konto", es: "Automatice su cuenta prop de Tradovate", fr: "Automatisez votre compte prop Tradovate", it: "Automatizzi il Suo conto prop Tradovate" },
  ctaText: { en: "Keep charting in Quantower over Rithmic and let PickMyTrade handle order routing to your Tradovate account automatically.", de: "Charten Sie weiter in Quantower über Rithmic und lassen Sie PickMyTrade das Order-Routing zu Ihrem Tradovate-Konto automatisch übernehmen.", es: "Siga graficando en Quantower sobre Rithmic y deje que PickMyTrade se encargue del enrutamiento de órdenes a su cuenta de Tradovate automáticamente.", fr: "Continuez à analyser vos graphiques dans Quantower via Rithmic et laissez PickMyTrade gérer automatiquement l'acheminement des ordres vers votre compte Tradovate.", it: "Continui a fare grafici in Quantower tramite Rithmic e lasci che PickMyTrade gestisca automaticamente l'instradamento degli ordini verso il Suo conto Tradovate." },
  ctaButtonText: { en: "Start Your Free 7-Day Trial", de: "Starten Sie Ihre kostenlose 7-Tage-Testphase", es: "Comience su prueba gratuita de 7 días", fr: "Commencez votre essai gratuit de 7 jours", it: "Inizi la prova gratuita di 7 giorni" },
