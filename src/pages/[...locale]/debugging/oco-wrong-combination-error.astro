---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "oco-wrong-combination-error";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/debugging/${SLUG}`;

const META_TITLE = "Tradovate OCO 'Wrong Combination' Error Fix";
const META_DESCRIPTION =
  "Getting the Tradovate OCO wrong-combination error or an accidental exit? Learn the left-click limit, right-click stop rule to place a clean one-time OCO.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Tradovate OCO „Wrong Combination“-Fehler beheben", es: "Cómo solucionar el error «Wrong Combination» de OCO en Tradovate", fr: "Corriger l'erreur « Wrong Combination » d'OCO sur Tradovate", it: "Come risolvere l'errore OCO «Wrong Combination» di Tradovate" },
  dek: { en: "A one-time OCO on the SuperDOM keeps rejecting as a wrong combination, or worse, closes your position outright. Both trace back to how you clicked.", de: "Ein einmaliges OCO im SuperDOM wird immer wieder als falsche Kombination abgelehnt oder schließt sogar Ihre Position komplett. Beides liegt daran, wie Sie geklickt haben.", es: "Un OCO de una sola vez en el SuperDOM sigue rechazándose como combinación incorrecta o, peor aún, cierra su posición por completo. Ambos casos se deben a cómo hizo clic.", fr: "Un OCO à usage unique sur le SuperDOM est sans cesse rejeté comme mauvaise combinaison ou, pire, ferme purement et simplement votre position. Les deux cas tiennent à la façon dont vous avez cliqué.", it: "Un OCO una tantum sul SuperDOM continua a essere rifiutato come combinazione errata o, peggio, chiude del tutto la Sua posizione. Entrambi i casi dipendono da come ha cliccato." },
  readTime: { en: "6 min read", de: "6 Min. Lesezeit", es: "Lectura de 6 min", fr: "Lecture : 6 min", it: "Lettura di 6 min" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "You're already in a position, you flip on one-time OCO to drop a stop and a target on the ladder, and instead of a tidy bracket you get a red <strong class='text-white'>&ldquo;wrong combination&rdquo;</strong> warning. Or worse, your position just closed on its own. Both problems trace back to the same thing: how you clicked. On the SuperDOM, a one-time OCO expects <strong class='text-white'>exactly one stop order and one limit order</strong> placed on the correct side of the market, and Tradovate decides which order is which by whether you left-click or right-click. Get the pairing wrong and it rejects the group as an invalid combination. Left-click a price that's already through the market and you fire a marketable order that flattens you instead. Once you understand the click rule, this stops happening. And if you'd rather never touch the ladder for exits, an automation bridge like PickMyTrade attaches the stop and target for you." },
    {
      type: "checklist",
      heading: "Quick Checklist to Avoid the Wrong-Combination Error",
      items: [
        "<strong class='text-white'>One stop, one limit.</strong> A valid exit OCO is exactly one stop order and one limit order. Never two of the same.",
        "<strong class='text-white'>Know the click rule.</strong> In the default DOM mode, left-click places a <em>limit</em> and right-click places a <em>stop</em>.",
        "<strong class='text-white'>Both orders on your exit side.</strong> If you're long, both exits are sells. If you're short, both are buys.",
        "<strong class='text-white'>Target and stop straddle your entry.</strong> Take-profit above entry on a long, stop below it. Mirror that on a short.",
        "<strong class='text-white'>Enable OCO first, then place the two orders.</strong> One-time OCO applies to the very next pair you drop.",
        "<strong class='text-white'>Check your DOM click-mode setting</strong> if the order types aren't coming out how you expect.",
      ],
    },
    { type: "heading", text: "What the \"Wrong Combination\" Error Means" },
    { type: "paragraph", html: "A one-time OCO (one-cancels-other) groups two orders so that the moment one fills, the other cancels automatically. It's how you protect an open position with a stop loss and a take-profit at the same time without ending up double-filled. Tradovate only accepts the group if the two orders form a valid one-cancels-other pair for the position you're holding: one profit-taking limit and one protective stop, sitting on opposite sides of your entry price." },
    { type: "paragraph", html: "&ldquo;Wrong combination&rdquo; is Tradovate telling you the two orders you placed can't work as that pair. Maybe both came out as limits. Maybe both came out as stops. Maybe the two prices you clicked don't make sense as a bracket around your position. Whatever the specifics, the platform refuses to bind them into an OCO and warns you instead of guessing. Read it as a guard rail, not a glitch. The order group was malformed, so nothing got attached." },
    { type: "heading", text: "Why You Get It (and Why It Sometimes Closes Your Position Instead)" },
    { type: "heading", text: "The Left-Click / Right-Click Rule" },
    { type: "paragraph", html: "This is the part that trips almost everyone. In Tradovate's default DOM click mode, the <em>mouse button</em> decides the order type, not the price level:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Left-click</strong> on the ladder places a <strong class='text-white'>limit</strong> order.",
        "<strong class='text-white'>Right-click</strong> on the ladder places a <strong class='text-white'>stop</strong> order.",
      ],
    },
    { type: "paragraph", html: "That holds whether your pointer is above or below the current market. So to build a legal OCO pair you have to left-click one price (that becomes your limit / target) and right-click the other price (that becomes your stop). Left-click both prices and you've placed two limits. Right-click both and you've placed two stops. Neither is a valid one-cancels-other pair, and that's when the wrong-combination warning appears." },
    { type: "paragraph", html: "There's a second, newer click mode you can switch to in the DOM settings, where a single left-click handles both types and the platform infers stop versus limit from where the price sits relative to the best bid and ask. It's a real option and some traders prefer it, but it behaves differently, so if your order types keep coming out wrong, the first thing to check is which mode you're actually in." },
    { type: "heading", text: "Which Side and Level Each Order Belongs On" },
    { type: "paragraph", html: "Your exit orders always sit on the opposite side of your entry. If you bought (you're long), you exit by selling, so both the target and the stop are sell orders. If you sold (you're short), you exit by buying. Getting the direction and the level right is half the battle:" },
    {
      type: "table",
      headers: ["Your position", "Take-profit (limit, left-click)", "Stop loss (stop, right-click)"],
      rows: [
        ["<strong class='text-white'>Long</strong> (you bought)", "Sell limit <strong class='text-white'>above</strong> your entry", "Sell stop <strong class='text-white'>below</strong> your entry"],
        ["<strong class='text-white'>Short</strong> (you sold)", "Buy limit <strong class='text-white'>below</strong> your entry", "Buy stop <strong class='text-white'>above</strong> your entry"],
      ],
    },
    { type: "heading", text: "How the Accidental Position Close Happens" },
    { type: "paragraph", html: "This is the nastier failure mode, because there's no error at all, your trade just disappears. Say you're long and you go to place your take-profit. If you left-click a price <em>below</em> the current market on the sell side, you've put in a sell limit under the market. A limit to sell below the going price is immediately marketable, so it fills right away and closes your position. Same trap in reverse for a short: a buy limit left-clicked above the market fills instantly. The order was technically valid, it just wasn't what you meant. Keep your limit target on the far side of the market (above for a long, below for a short) and reserve the near side for your right-click stop, and this can't sneak up on you." },
    { type: "heading", text: "How to Fix It, Step by Step" },
    { type: "heading", text: "Build a Clean One-Time OCO on a Long Position" },
    {
      type: "steps",
      items: [
        { title: "Confirm you're in the position", html: "The Positions module should show your open contracts and average entry price." },
        { title: "Enable one-time OCO", html: "On the SuperDOM, open the order-type / ATM dropdown at the top of the ladder and select the <strong class='text-white'>one-time OCO</strong> option. (Label wording shifts between platform versions, so confirm the exact current name on your screen.)" },
        { title: "Left-click above entry for the target", html: "<strong class='text-white'>Left-click</strong> the price <em>above</em> your entry where you want to take profit. That drops your sell <em>limit</em> (the target)." },
        { title: "Right-click below entry for the stop", html: "<strong class='text-white'>Right-click</strong> the price <em>below</em> your entry where you want protection. That drops your sell <em>stop</em> (the stop loss)." },
        { title: "Confirm the pair is working", html: "Check that both now show as working orders on the ladder and in the Orders module. When either one fills, Tradovate cancels the other for you." },
      ],
    },
    { type: "heading", text: "Mirror It on a Short Position" },
    { type: "paragraph", html: "Same idea, flipped. <strong class='text-white'>Left-click below</strong> the market for the buy limit that takes your profit, and <strong class='text-white'>right-click above</strong> the market for the buy stop that protects you. One left-click, one right-click, one order on each side of your entry. That's always a valid combination." },
    { type: "heading", text: "If It Still Says \"Wrong Combination\"" },
    { type: "paragraph", html: "Cancel both working orders, re-enable one-time OCO (remember it's single-use and switches off after each pair), and place the orders one at a time so you can watch the type badge on each before committing. If a target keeps coming through as a stop or the reverse, you're almost certainly in the other DOM click mode. Open your DOM settings and confirm the order-entry behavior, then set it back to the mode you expect." },
    { type: "heading", text: "Troubleshooting Table" },
    {
      type: "table",
      headers: ["What you did", "What happened", "Fix"],
      rows: [
        ["Left-clicked both exit prices", "Two limit orders, &ldquo;wrong combination&rdquo;", "Right-click the stop side so you have one limit and one stop"],
        ["Right-clicked both exit prices", "Two stop orders, &ldquo;wrong combination&rdquo;", "Left-click the target side to make it a limit"],
        ["Left-clicked below market while long", "Marketable sell limit, position closed", "Place the limit target above the market; use right-click for the stop below"],
        ["Placed orders before enabling OCO", "Two independent orders, no cancel link", "Turn on one-time OCO first, then drop the pair"],
        ["Order types come out reversed", "Limit lands as stop or vice versa", "Check the DOM click-mode setting and switch back to the expected mode"],
        ["OCO worked once, gone next trade", "One-time OCO is single-use", "Re-enable it each position, or use an ATM strategy for a repeatable bracket"],
      ],
    },
    { type: "heading", text: "A Steadier Way: Let the Platform Build the Bracket" },
    { type: "paragraph", html: "Clicking a stop and a target onto a live ladder, in the right places, on the right mouse button, while price is moving, is a lot to get right every single trade. If the manual dance keeps biting you, take your fingers off the ladder for exits." },
    { type: "paragraph", html: "An ATM strategy lets you pre-define your target and stop once, then attaches them as an OCO bracket automatically the instant your entry fills. No left-click / right-click gymnastics, no chance of a wrong-combination reject, because the platform assembles the pair for you." },
    { type: "heading", text: "Prevent This Entirely with PickMyTrade" },
    { type: "paragraph", html: "If your entries come from a TradingView strategy or indicator, you can skip manual order entry altogether. PickMyTrade sits between TradingView and Tradovate and places your orders from your alerts, so the stop and target attach programmatically:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Stop and target sent as one bracket</strong> from your alert, so there's no invalid pair to reject.",
        "<strong class='text-white'>No ladder clicking</strong> for exits, which means no left-click / right-click mix-ups and no accidental marketable fills.",
        "<strong class='text-white'>Consistent every trade</strong>, instead of re-enabling one-time OCO by hand after each position.",
        "<strong class='text-white'>Direction handled for you</strong>, so a long gets its sell exits and a short gets its buy exits without you thinking about it mid-trade.",
      ],
    },
    { type: "paragraph", html: "You define the logic once in TradingView, and your protective orders show up on Tradovate the same way every time." },
  ], de: [
    { type: "paragraph",html: "Sie sind bereits in einer Position, schalten das einmalige OCO ein, um einen Stop und ein Ziel auf der Preisleiter zu setzen, und statt eines sauberen Brackets erscheint eine rote Warnung <strong class='text-white'>&ldquo;wrong combination&rdquo;</strong>. Oder schlimmer: Ihre Position schließt sich von selbst. Beide Probleme haben dieselbe Ursache: wie Sie geklickt haben. Im SuperDOM erwartet ein einmaliges OCO <strong class='text-white'>genau eine Stop-Order und eine Limit-Order</strong> auf der richtigen Marktseite, und Tradovate entscheidet anhand von Links- oder Rechtsklick, welche Order welche ist. Stimmt die Zuordnung nicht, wird die Gruppe als ungültige Kombination abgelehnt. Klicken Sie links auf einen Preis, der bereits jenseits des Marktes liegt, lösen Sie stattdessen eine marktfähige Order aus, die Sie flat stellt. Sobald Sie die Klickregel verstanden haben, passiert das nicht mehr. Und wenn Sie für Ausstiege lieber nie die Preisleiter anfassen möchten, hängt eine Automatisierungsbrücke wie PickMyTrade Stop und Ziel für Sie an." },
    {
      type: "checklist",
      heading: "Kurze Checkliste zur Vermeidung des Wrong-Combination-Fehlers",
      items: [
        "<strong class='text-white'>Ein Stop, ein Limit.</strong> Ein gültiges Ausstiegs-OCO besteht aus genau einer Stop-Order und einer Limit-Order. Niemals zwei vom gleichen Typ.",
        "<strong class='text-white'>Kennen Sie die Klickregel.</strong> Im standardmäßigen DOM-Modus platziert ein Linksklick ein <em>Limit</em> und ein Rechtsklick einen <em>Stop</em>.",
        "<strong class='text-white'>Beide Orders auf Ihrer Ausstiegsseite.</strong> Wenn Sie long sind, sind beide Ausstiege Verkäufe. Wenn Sie short sind, sind beide Käufe.",
        "<strong class='text-white'>Ziel und Stop umschließen Ihren Einstieg.</strong> Take-Profit oberhalb des Einstiegs bei Long, Stop darunter. Bei Short spiegelverkehrt.",
        "<strong class='text-white'>Erst OCO aktivieren, dann die beiden Orders platzieren.</strong> Das einmalige OCO gilt für das nächste Paar, das Sie setzen.",
        "<strong class='text-white'>Prüfen Sie die Einstellung des DOM-Klickmodus</strong>, wenn die Ordertypen nicht wie erwartet entstehen.",
      ],
    },
    { type: "heading",text: "Was der „Wrong Combination“-Fehler bedeutet" },
    { type: "paragraph",html: "Ein einmaliges OCO (One-Cancels-Other) gruppiert zwei Orders so, dass die andere automatisch storniert wird, sobald eine ausgeführt wird. So sichern Sie eine offene Position gleichzeitig mit Stop-Loss und Take-Profit ab, ohne doppelt ausgeführt zu werden. Tradovate akzeptiert die Gruppe nur, wenn die beiden Orders für die gehaltene Position ein gültiges One-Cancels-Other-Paar bilden: ein Gewinnziel-Limit und ein schützender Stop auf gegenüberliegenden Seiten Ihres Einstiegspreises." },
    { type: "paragraph",html: "&ldquo;Wrong combination&rdquo; ist Tradovates Hinweis, dass die beiden platzierten Orders nicht als dieses Paar funktionieren können. Vielleicht wurden beide zu Limits. Vielleicht beide zu Stops. Vielleicht ergeben die beiden angeklickten Preise als Bracket um Ihre Position keinen Sinn. Was auch immer im Einzelnen vorliegt, die Plattform weigert sich, sie zu einem OCO zu verbinden, und warnt Sie, statt zu raten. Verstehen Sie es als Leitplanke, nicht als Störung. Die Ordergruppe war fehlerhaft aufgebaut, daher wurde nichts angehängt." },
    { type: "heading",text: "Warum es passiert (und warum stattdessen manchmal Ihre Position geschlossen wird)" },
    { type: "heading",text: "Die Regel für Links- und Rechtsklick" },
    { type: "paragraph",html: "Genau das bringt fast jeden aus dem Konzept. Im standardmäßigen DOM-Klickmodus von Tradovate bestimmt die <em>Maustaste</em> den Ordertyp, nicht das Preisniveau:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Linksklick</strong> auf der Preisleiter platziert eine <strong class='text-white'>Limit</strong>-Order.",
        "<strong class='text-white'>Rechtsklick</strong> auf der Preisleiter platziert eine <strong class='text-white'>Stop</strong>-Order.",
      ],
    },
    { type: "paragraph",html: "Das gilt unabhängig davon, ob Ihr Zeiger über oder unter dem aktuellen Markt steht. Um ein gültiges OCO-Paar zu bilden, müssen Sie also einen Preis mit Linksklick wählen (das wird Ihr Limit bzw. Ziel) und den anderen Preis mit Rechtsklick (das wird Ihr Stop). Klicken Sie beide Preise links an, haben Sie zwei Limits platziert. Klicken Sie beide rechts an, haben Sie zwei Stops platziert. Keines davon ist ein gültiges One-Cancels-Other-Paar, und dann erscheint die Wrong-Combination-Warnung." },
    { type: "paragraph",html: "Es gibt außerdem einen zweiten, neueren Klickmodus, den Sie in den DOM-Einstellungen aktivieren können. Dort übernimmt ein einzelner Linksklick beide Ordertypen, und die Plattform leitet Stop oder Limit aus der Lage des Preises relativ zu Bid und Ask ab. Das ist eine echte Option, die manche Trader bevorzugen, aber sie verhält sich anders. Wenn Ihre Ordertypen also immer falsch ausfallen, prüfen Sie zuerst, in welchem Modus Sie tatsächlich sind." },
    { type: "heading",text: "Auf welche Seite und Ebene welche Order gehört" },
    { type: "paragraph",html: "Ihre Ausstiegsorders liegen immer auf der gegenüberliegenden Seite Ihres Einstiegs. Wenn Sie gekauft haben (long), steigen Sie durch Verkaufen aus, also sind Ziel und Stop beides Verkaufsorders. Wenn Sie verkauft haben (short), steigen Sie durch Kaufen aus. Die richtige Richtung und die richtige Ebene sind die halbe Miete:" },
    { type: "table", headers: ["Ihre Position","Take-Profit (Limit, Linksklick)","Stop-Loss (Stop, Rechtsklick)"], rows: [
      ["<strong class='text-white'>Long</strong> (Sie haben gekauft)","Verkaufs-Limit <strong class='text-white'>oberhalb</strong> Ihres Einstiegs","Verkaufs-Stop <strong class='text-white'>unterhalb</strong> Ihres Einstiegs"],
      ["<strong class='text-white'>Short</strong> (Sie haben verkauft)","Kauf-Limit <strong class='text-white'>unterhalb</strong> Ihres Einstiegs","Kauf-Stop <strong class='text-white'>oberhalb</strong> Ihres Einstiegs"],
    ] },
    { type: "heading",text: "Wie es zum versehentlichen Schließen der Position kommt" },
    { type: "paragraph",html: "Das ist der unangenehmere Fehlerfall, denn es gibt keinen Fehler, Ihr Trade verschwindet einfach. Angenommen, Sie sind long und platzieren Ihr Take-Profit. Klicken Sie links auf einen Preis <em>unterhalb</em> des aktuellen Marktes auf der Verkaufsseite, haben Sie ein Verkaufs-Limit unter dem Markt gesetzt. Ein Verkaufs-Limit unter dem aktuellen Preis ist sofort marktfähig, wird also umgehend ausgeführt und schließt Ihre Position. Dieselbe Falle gibt es umgekehrt bei einer Short-Position: Ein per Linksklick über dem Markt gesetztes Kauf-Limit wird sofort ausgeführt. Die Order war formal gültig, nur nicht das, was Sie wollten. Halten Sie Ihr Limit-Ziel auf der fernen Marktseite (oberhalb bei Long, unterhalb bei Short) und reservieren Sie die nahe Seite für Ihren Stop per Rechtsklick, dann kann Ihnen das nicht passieren." },
    { type: "heading",text: "So beheben Sie es, Schritt für Schritt" },
    { type: "heading",text: "Ein sauberes einmaliges OCO bei einer Long-Position aufbauen" },
    {
      type: "steps",
      items: [
        { title: "Bestätigen Sie, dass Sie in der Position sind", html: "Das Modul „Positions“ sollte Ihre offenen Kontrakte und den durchschnittlichen Einstiegspreis anzeigen." },
        { title: "Einmaliges OCO aktivieren", html: "Öffnen Sie im SuperDOM das Dropdown für Ordertyp bzw. ATM oben an der Preisleiter und wählen Sie die Option <strong class='text-white'>one-time OCO</strong>. (Die Bezeichnung variiert je nach Plattformversion, bestätigen Sie daher den genauen aktuellen Namen auf Ihrem Bildschirm.)" },
        { title: "Linksklick oberhalb des Einstiegs für das Ziel", html: "Klicken Sie mit <strong class='text-white'>links</strong> auf den Preis <em>oberhalb</em> Ihres Einstiegs, bei dem Sie Gewinn mitnehmen möchten. Damit setzen Sie Ihr Verkaufs-<em>Limit</em> (das Ziel)." },
        { title: "Rechtsklick unterhalb des Einstiegs für den Stop", html: "Klicken Sie mit <strong class='text-white'>rechts</strong> auf den Preis <em>unterhalb</em> Ihres Einstiegs, bei dem Sie abgesichert sein möchten. Damit setzen Sie Ihren Verkaufs-<em>Stop</em> (den Stop-Loss)." },
        { title: "Bestätigen Sie, dass das Paar aktiv ist", html: "Prüfen Sie, dass beide nun als aktive Orders auf der Preisleiter und im Modul „Orders“ angezeigt werden. Sobald eine ausgeführt wird, storniert Tradovate die andere für Sie." },
      ],
    },
    { type: "heading",text: "Bei einer Short-Position spiegeln" },
    { type: "paragraph",html: "Dieselbe Idee, nur umgekehrt. <strong class='text-white'>Linksklick unterhalb</strong> des Marktes für das Kauf-Limit, das Ihren Gewinn mitnimmt, und <strong class='text-white'>Rechtsklick oberhalb</strong> des Marktes für den Kauf-Stop, der Sie absichert. Ein Linksklick, ein Rechtsklick, je eine Order auf jeder Seite Ihres Einstiegs. Das ist immer eine gültige Kombination." },
    { type: "heading",text: "Wenn weiterhin „Wrong Combination“ erscheint" },
    { type: "paragraph",html: "Stornieren Sie beide aktiven Orders, aktivieren Sie das einmalige OCO erneut (denken Sie daran, dass es nur einmal gilt und sich nach jedem Paar ausschaltet) und platzieren Sie die Orders nacheinander, damit Sie das Typ-Label jeder Order prüfen können, bevor Sie sie bestätigen. Wenn ein Ziel immer wieder als Stop ankommt oder umgekehrt, befinden Sie sich mit hoher Wahrscheinlichkeit im anderen DOM-Klickmodus. Öffnen Sie Ihre DOM-Einstellungen, prüfen Sie das Verhalten bei der Ordereingabe und stellen Sie es auf den erwarteten Modus zurück." },
    { type: "heading",text: "Tabelle zur Fehlerbehebung" },
    { type: "table", headers: ["Was Sie getan haben","Was passiert ist","Lösung"], rows: [
      ["Beide Ausstiegspreise per Linksklick gesetzt","Zwei Limit-Orders, &ldquo;wrong combination&rdquo;","Setzen Sie die Stop-Seite per Rechtsklick, damit Sie ein Limit und einen Stop haben"],
      ["Beide Ausstiegspreise per Rechtsklick gesetzt","Zwei Stop-Orders, &ldquo;wrong combination&rdquo;","Setzen Sie die Zielseite per Linksklick, damit sie ein Limit wird"],
      ["Bei Long per Linksklick unterhalb des Marktes gesetzt","Marktfähiges Verkaufs-Limit, Position geschlossen","Platzieren Sie das Limit-Ziel oberhalb des Marktes; verwenden Sie für den Stop darunter den Rechtsklick"],
      ["Orders vor dem Aktivieren von OCO platziert","Zwei unabhängige Orders, keine Stornoverknüpfung","Schalten Sie zuerst das einmalige OCO ein, setzen Sie dann das Paar"],
      ["Ordertypen kommen vertauscht an","Limit landet als Stop oder umgekehrt","Prüfen Sie die Einstellung des DOM-Klickmodus und wechseln Sie zurück in den erwarteten Modus"],
      ["OCO hat einmal funktioniert, beim nächsten Trade ist es weg","Das einmalige OCO gilt nur einmal","Aktivieren Sie es bei jeder Position erneut oder nutzen Sie eine ATM-Strategie für ein wiederholbares Bracket"],
    ] },
    { type: "heading",text: "Eine stabilere Lösung: Die Plattform das Bracket bauen lassen" },
    { type: "paragraph",html: "Einen Stop und ein Ziel auf eine laufende Preisleiter zu klicken, an den richtigen Stellen, mit der richtigen Maustaste, während der Kurs sich bewegt, ist bei jedem einzelnen Trade eine Menge, die man richtig machen muss. Wenn Sie diese manuelle Prozedur immer wieder ausbremst, nehmen Sie bei Ausstiegen die Finger von der Preisleiter." },
    { type: "paragraph",html: "Eine ATM-Strategie lässt Sie Ziel und Stop einmal vorab definieren und hängt sie dann automatisch als OCO-Bracket an, sobald Ihr Einstieg ausgeführt wird. Kein Links-/Rechtsklick-Gefummel, kein Risiko einer Wrong-Combination-Ablehnung, weil die Plattform das Paar für Sie zusammenstellt." },
    { type: "heading",text: "Vermeiden Sie das Problem komplett mit PickMyTrade" },
    { type: "paragraph",html: "Wenn Ihre Einstiege aus einer TradingView-Strategie oder einem Indikator stammen, können Sie die manuelle Ordereingabe ganz überspringen. PickMyTrade sitzt zwischen TradingView und Tradovate und platziert Ihre Orders anhand Ihrer Alerts, sodass Stop und Ziel programmatisch angehängt werden:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Stop und Ziel als ein Bracket gesendet</strong> aus Ihrem Alert, sodass es kein ungültiges Paar gibt, das abgelehnt werden könnte.",
        "<strong class='text-white'>Kein Klicken auf der Preisleiter</strong> für Ausstiege, also keine Verwechslung von Links- und Rechtsklick und keine versehentlichen marktfähigen Ausführungen.",
        "<strong class='text-white'>Bei jedem Trade konsistent</strong>, statt das einmalige OCO nach jeder Position von Hand neu zu aktivieren.",
        "<strong class='text-white'>Richtung wird für Sie erledigt</strong>, sodass eine Long-Position ihre Verkaufsausstiege und eine Short-Position ihre Kaufausstiege erhält, ohne dass Sie mitten im Trade darüber nachdenken müssen.",
      ],
    },
    { type: "paragraph",html: "Sie definieren die Logik einmal in TradingView, und Ihre Schutzorders erscheinen bei Tradovate jedes Mal auf dieselbe Weise." },
  ], es: [
    { type: "paragraph",html: "Ya está en una posición, activa el OCO de una sola vez para colocar un stop y un objetivo en la escalera y, en lugar de un bracket ordenado, recibe una advertencia roja de <strong class='text-white'>&ldquo;wrong combination&rdquo;</strong>. O peor aún, su posición se cierra sola. Ambos problemas tienen el mismo origen: cómo hizo clic. En el SuperDOM, un OCO de una sola vez espera <strong class='text-white'>exactamente una orden stop y una orden límite</strong> colocadas en el lado correcto del mercado, y Tradovate decide cuál es cuál según haga clic izquierdo o derecho. Si el emparejamiento es incorrecto, rechaza el grupo como combinación no válida. Si hace clic izquierdo en un precio que ya está más allá del mercado, dispara una orden ejecutable que lo deja sin posición. Una vez que entienda la regla del clic, esto deja de ocurrir. Y si prefiere no tocar nunca la escalera para las salidas, un puente de automatización como PickMyTrade adjunta el stop y el objetivo por usted." },
    {
      type: "checklist",
      heading: "Lista de verificación rápida para evitar el error de combinación incorrecta",
      items: [
        "<strong class='text-white'>Un stop, un límite.</strong> Un OCO de salida válido es exactamente una orden stop y una orden límite. Nunca dos del mismo tipo.",
        "<strong class='text-white'>Conozca la regla del clic.</strong> En el modo predeterminado del DOM, el clic izquierdo coloca un <em>límite</em> y el clic derecho coloca un <em>stop</em>.",
        "<strong class='text-white'>Ambas órdenes en su lado de salida.</strong> Si está en largo, ambas salidas son ventas. Si está en corto, ambas son compras.",
        "<strong class='text-white'>El objetivo y el stop flanquean su entrada.</strong> Toma de beneficios por encima de la entrada en un largo, stop por debajo. En un corto, al revés.",
        "<strong class='text-white'>Active primero OCO y luego coloque las dos órdenes.</strong> El OCO de una sola vez se aplica al siguiente par que coloque.",
        "<strong class='text-white'>Revise la configuración del modo de clic del DOM</strong> si los tipos de orden no salen como espera.",
      ],
    },
    { type: "heading",text: "Qué significa el error «Wrong Combination»" },
    { type: "paragraph",html: "Un OCO de una sola vez (one-cancels-other, una cancela a la otra) agrupa dos órdenes de modo que, en cuanto una se ejecuta, la otra se cancela automáticamente. Así protege una posición abierta con un stop loss y una toma de beneficios al mismo tiempo sin terminar con una doble ejecución. Tradovate solo acepta el grupo si las dos órdenes forman un par válido de una cancela a la otra para la posición que mantiene: un límite para tomar beneficios y un stop protector, situados en lados opuestos de su precio de entrada." },
    { type: "paragraph",html: "&ldquo;Wrong combination&rdquo; es la forma en que Tradovate le indica que las dos órdenes que colocó no pueden funcionar como ese par. Quizá ambas salieron como límites. Quizá ambas salieron como stops. Quizá los dos precios en los que hizo clic no tienen sentido como bracket alrededor de su posición. Sean cuales sean los detalles, la plataforma se niega a vincularlas en un OCO y le avisa en lugar de adivinar. Interprételo como una barrera de protección, no como un fallo. El grupo de órdenes estaba mal formado, así que no se adjuntó nada." },
    { type: "heading",text: "Por qué ocurre (y por qué a veces cierra su posición en su lugar)" },
    { type: "heading",text: "La regla del clic izquierdo y derecho" },
    { type: "paragraph",html: "Esta es la parte que confunde a casi todos. En el modo de clic predeterminado del DOM de Tradovate, el <em>botón del ratón</em> decide el tipo de orden, no el nivel de precio:" },
    {
      type: "list",
      items: [
        "El <strong class='text-white'>clic izquierdo</strong> en la escalera coloca una orden <strong class='text-white'>límite</strong>.",
        "El <strong class='text-white'>clic derecho</strong> en la escalera coloca una orden <strong class='text-white'>stop</strong>.",
      ],
    },
    { type: "paragraph",html: "Eso se cumple tanto si el puntero está por encima como por debajo del mercado actual. Por tanto, para construir un par OCO legal debe hacer clic izquierdo en un precio (que será su límite u objetivo) y clic derecho en el otro (que será su stop). Si hace clic izquierdo en ambos precios, ha colocado dos límites. Si hace clic derecho en ambos, ha colocado dos stops. Ninguno es un par válido de una cancela a la otra, y entonces aparece la advertencia de combinación incorrecta." },
    { type: "paragraph",html: "Hay un segundo modo de clic, más reciente, al que puede cambiar en la configuración del DOM, donde un solo clic izquierdo gestiona ambos tipos y la plataforma deduce si es stop o límite según dónde se sitúa el precio respecto al mejor bid y ask. Es una opción real y algunos traders la prefieren, pero se comporta de forma distinta, así que si los tipos de orden siguen saliendo mal, lo primero que debe comprobar es en qué modo está realmente." },
    { type: "heading",text: "A qué lado y nivel pertenece cada orden" },
    { type: "paragraph",html: "Sus órdenes de salida siempre se sitúan en el lado opuesto de su entrada. Si compró (está en largo), sale vendiendo, así que tanto el objetivo como el stop son órdenes de venta. Si vendió (está en corto), sale comprando. Acertar con la dirección y el nivel es la mitad de la batalla:" },
    { type: "table", headers: ["Su posición","Toma de beneficios (límite, clic izquierdo)","Stop loss (stop, clic derecho)"], rows: [
      ["<strong class='text-white'>Largo</strong> (compró)","Límite de venta <strong class='text-white'>por encima</strong> de su entrada","Stop de venta <strong class='text-white'>por debajo</strong> de su entrada"],
      ["<strong class='text-white'>Corto</strong> (vendió)","Límite de compra <strong class='text-white'>por debajo</strong> de su entrada","Stop de compra <strong class='text-white'>por encima</strong> de su entrada"],
    ] },
    { type: "heading",text: "Cómo ocurre el cierre accidental de la posición" },
    { type: "paragraph",html: "Este es el modo de fallo más desagradable, porque no hay ningún error, simplemente su operación desaparece. Supongamos que está en largo y va a colocar su toma de beneficios. Si hace clic izquierdo en un precio <em>por debajo</em> del mercado actual en el lado de venta, ha puesto un límite de venta bajo el mercado. Un límite de venta por debajo del precio vigente es ejecutable de inmediato, así que se llena al instante y cierra su posición. La misma trampa a la inversa en un corto: un límite de compra con clic izquierdo por encima del mercado se llena al instante. La orden era técnicamente válida, simplemente no era lo que quería. Mantenga su objetivo límite en el lado lejano del mercado (por encima en un largo, por debajo en un corto) y reserve el lado cercano para su stop con clic derecho, y esto no podrá sorprenderle." },
    { type: "heading",text: "Cómo solucionarlo, paso a paso" },
    { type: "heading",text: "Construir un OCO de una sola vez limpio en una posición larga" },
    {
      type: "steps",
      items: [
        { title: "Confirme que está en la posición", html: "El módulo Positions debe mostrar sus contratos abiertos y el precio medio de entrada." },
        { title: "Active el OCO de una sola vez", html: "En el SuperDOM, abra el menú desplegable de tipo de orden o ATM en la parte superior de la escalera y seleccione la opción <strong class='text-white'>one-time OCO</strong>. (La redacción de la etiqueta cambia entre versiones de la plataforma, así que confirme el nombre exacto actual en su pantalla.)" },
        { title: "Clic izquierdo por encima de la entrada para el objetivo", html: "Haga <strong class='text-white'>clic izquierdo</strong> en el precio <em>por encima</em> de su entrada donde desea tomar beneficios. Eso coloca su <em>límite</em> de venta (el objetivo)." },
        { title: "Clic derecho por debajo de la entrada para el stop", html: "Haga <strong class='text-white'>clic derecho</strong> en el precio <em>por debajo</em> de su entrada donde desea protección. Eso coloca su <em>stop</em> de venta (el stop loss)." },
        { title: "Confirme que el par está activo", html: "Compruebe que ambas aparecen ahora como órdenes activas en la escalera y en el módulo Orders. Cuando una se ejecute, Tradovate cancela la otra por usted." },
      ],
    },
    { type: "heading",text: "Replicarlo en una posición corta" },
    { type: "paragraph",html: "La misma idea, invertida. <strong class='text-white'>Clic izquierdo por debajo</strong> del mercado para el límite de compra que toma sus beneficios y <strong class='text-white'>clic derecho por encima</strong> del mercado para el stop de compra que lo protege. Un clic izquierdo, un clic derecho, una orden a cada lado de su entrada. Esa siempre es una combinación válida." },
    { type: "heading",text: "Si sigue apareciendo «Wrong Combination»" },
    { type: "paragraph",html: "Cancele ambas órdenes activas, vuelva a activar el OCO de una sola vez (recuerde que es de un único uso y se desactiva tras cada par) y coloque las órdenes una a una para poder ver la etiqueta de tipo de cada una antes de confirmar. Si un objetivo sigue saliendo como stop o al revés, es casi seguro que está en el otro modo de clic del DOM. Abra la configuración del DOM, confirme el comportamiento de introducción de órdenes y vuelva a ponerlo en el modo que espera." },
    { type: "heading",text: "Tabla de solución de problemas" },
    { type: "table", headers: ["Qué hizo","Qué ocurrió","Solución"], rows: [
      ["Clic izquierdo en ambos precios de salida","Dos órdenes límite, &ldquo;wrong combination&rdquo;","Haga clic derecho en el lado del stop para tener un límite y un stop"],
      ["Clic derecho en ambos precios de salida","Dos órdenes stop, &ldquo;wrong combination&rdquo;","Haga clic izquierdo en el lado del objetivo para que sea un límite"],
      ["Clic izquierdo por debajo del mercado estando en largo","Límite de venta ejecutable, posición cerrada","Coloque el objetivo límite por encima del mercado; use clic derecho para el stop por debajo"],
      ["Órdenes colocadas antes de activar OCO","Dos órdenes independientes, sin vínculo de cancelación","Active primero el OCO de una sola vez y luego coloque el par"],
      ["Los tipos de orden salen invertidos","El límite aparece como stop o viceversa","Revise la configuración del modo de clic del DOM y vuelva al modo esperado"],
      ["El OCO funcionó una vez y desaparece en la siguiente operación","El OCO de una sola vez es de un único uso","Vuelva a activarlo en cada posición o use una estrategia ATM para un bracket repetible"],
    ] },
    { type: "heading",text: "Una forma más estable: deje que la plataforma construya el bracket" },
    { type: "paragraph",html: "Hacer clic para colocar un stop y un objetivo en una escalera en vivo, en los lugares correctos, con el botón correcto del ratón, mientras el precio se mueve, es mucho que acertar en cada operación. Si esa maniobra manual le sigue jugando malas pasadas, retire los dedos de la escalera para las salidas." },
    { type: "paragraph",html: "Una estrategia ATM le permite predefinir su objetivo y su stop una sola vez y luego los adjunta automáticamente como bracket OCO en el instante en que se ejecuta su entrada. Sin malabares de clic izquierdo y derecho, sin posibilidad de rechazo por combinación incorrecta, porque la plataforma arma el par por usted." },
    { type: "heading",text: "Evítelo por completo con PickMyTrade" },
    { type: "paragraph",html: "Si sus entradas provienen de una estrategia o un indicador de TradingView, puede prescindir por completo de la introducción manual de órdenes. PickMyTrade se sitúa entre TradingView y Tradovate y coloca sus órdenes a partir de sus alertas, de modo que el stop y el objetivo se adjuntan de forma programática:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Stop y objetivo enviados como un solo bracket</strong> desde su alerta, así que no hay ningún par no válido que rechazar.",
        "<strong class='text-white'>Sin clics en la escalera</strong> para las salidas, lo que significa que no hay confusiones entre clic izquierdo y derecho ni ejecuciones accidentales a mercado.",
        "<strong class='text-white'>Coherente en cada operación</strong>, en lugar de volver a activar el OCO de una sola vez a mano después de cada posición.",
        "<strong class='text-white'>La dirección se gestiona por usted</strong>, de modo que un largo recibe sus salidas de venta y un corto sus salidas de compra sin que usted tenga que pensarlo en plena operación.",
      ],
    },
    { type: "paragraph",html: "Usted define la lógica una vez en TradingView y sus órdenes de protección aparecen en Tradovate siempre de la misma manera." },
  ], fr: [
    { type: "paragraph",html: "Vous êtes déjà dans une position, vous activez l'OCO à usage unique pour poser un stop et un objectif sur l'échelle et, au lieu d'un bracket propre, vous obtenez un avertissement rouge <strong class='text-white'>&ldquo;wrong combination&rdquo;</strong>. Ou pire, votre position se ferme toute seule. Les deux problèmes ont la même origine : la façon dont vous avez cliqué. Sur le SuperDOM, un OCO à usage unique attend <strong class='text-white'>exactement un ordre stop et un ordre limite</strong> placés du bon côté du marché, et Tradovate détermine quel ordre est lequel selon que vous faites un clic gauche ou un clic droit. Si l'association est mauvaise, il rejette le groupe comme combinaison invalide. Si vous cliquez à gauche sur un prix déjà au-delà du marché, vous déclenchez un ordre exécutable qui vous met à plat. Une fois la règle du clic comprise, cela n'arrive plus. Et si vous préférez ne plus jamais toucher à l'échelle pour vos sorties, un pont d'automatisation comme PickMyTrade rattache le stop et l'objectif à votre place." },
    {
      type: "checklist",
      heading: "Liste de contrôle rapide pour éviter l'erreur de mauvaise combinaison",
      items: [
        "<strong class='text-white'>Un stop, un limite.</strong> Un OCO de sortie valide est exactement un ordre stop et un ordre limite. Jamais deux du même type.",
        "<strong class='text-white'>Connaissez la règle du clic.</strong> En mode DOM par défaut, le clic gauche place un <em>limite</em> et le clic droit place un <em>stop</em>.",
        "<strong class='text-white'>Les deux ordres du côté de votre sortie.</strong> Si vous êtes acheteur, les deux sorties sont des ventes. Si vous êtes vendeur, ce sont deux achats.",
        "<strong class='text-white'>L'objectif et le stop encadrent votre entrée.</strong> Prise de profit au-dessus de l'entrée pour une position longue, stop en dessous. L'inverse pour une position courte.",
        "<strong class='text-white'>Activez d'abord l'OCO, puis placez les deux ordres.</strong> L'OCO à usage unique s'applique à la toute prochaine paire que vous posez.",
        "<strong class='text-white'>Vérifiez le réglage du mode de clic du DOM</strong> si les types d'ordre ne sortent pas comme prévu.",
      ],
    },
    { type: "heading",text: "Ce que signifie l'erreur « Wrong Combination »" },
    { type: "paragraph",html: "Un OCO à usage unique (one-cancels-other, l'un annule l'autre) regroupe deux ordres de sorte que, dès que l'un est exécuté, l'autre est annulé automatiquement. C'est ainsi que vous protégez une position ouverte avec un stop loss et une prise de profit en même temps sans risquer une double exécution. Tradovate n'accepte le groupe que si les deux ordres forment une paire valide d'ordres où l'un annule l'autre pour la position détenue : un limite de prise de profit et un stop de protection, placés de part et d'autre de votre prix d'entrée." },
    { type: "paragraph",html: "&ldquo;Wrong combination&rdquo; est la façon dont Tradovate vous indique que les deux ordres que vous avez placés ne peuvent pas fonctionner comme cette paire. Peut-être que les deux sont devenus des limites. Peut-être les deux des stops. Peut-être que les deux prix sur lesquels vous avez cliqué n'ont pas de sens comme bracket autour de votre position. Quels que soient les détails, la plateforme refuse de les lier en OCO et vous avertit plutôt que de deviner. Voyez-y un garde-fou, pas un dysfonctionnement. Le groupe d'ordres était mal formé, donc rien n'a été rattaché." },
    { type: "heading",text: "Pourquoi cela arrive (et pourquoi cela ferme parfois votre position à la place)" },
    { type: "heading",text: "La règle du clic gauche et du clic droit" },
    { type: "paragraph",html: "C'est le point qui piège presque tout le monde. Dans le mode de clic par défaut du DOM de Tradovate, c'est le <em>bouton de la souris</em> qui détermine le type d'ordre, et non le niveau de prix :" },
    {
      type: "list",
      items: [
        "Le <strong class='text-white'>clic gauche</strong> sur l'échelle place un ordre <strong class='text-white'>limite</strong>.",
        "Le <strong class='text-white'>clic droit</strong> sur l'échelle place un ordre <strong class='text-white'>stop</strong>.",
      ],
    },
    { type: "paragraph",html: "Cela vaut que votre pointeur soit au-dessus ou en dessous du marché actuel. Pour construire une paire OCO légale, vous devez donc cliquer à gauche sur un prix (qui devient votre limite ou objectif) et cliquer à droite sur l'autre (qui devient votre stop). Si vous cliquez à gauche sur les deux prix, vous avez placé deux limites. Si vous cliquez à droite sur les deux, vous avez placé deux stops. Aucun des deux n'est une paire valide d'ordres où l'un annule l'autre, et c'est alors que l'avertissement de mauvaise combinaison apparaît." },
    { type: "paragraph",html: "Il existe un second mode de clic, plus récent, que vous pouvez activer dans les paramètres du DOM, où un seul clic gauche gère les deux types et où la plateforme déduit stop ou limite d'après la position du prix par rapport au meilleur bid et au meilleur ask. C'est une vraie option que certains traders préfèrent, mais elle se comporte différemment ; si vos types d'ordre sortent toujours de travers, la première chose à vérifier est donc le mode dans lequel vous êtes réellement." },
    { type: "heading",text: "De quel côté et à quel niveau se place chaque ordre" },
    { type: "paragraph",html: "Vos ordres de sortie se trouvent toujours du côté opposé de votre entrée. Si vous avez acheté (vous êtes long), vous sortez en vendant, donc l'objectif et le stop sont tous deux des ordres de vente. Si vous avez vendu (vous êtes short), vous sortez en achetant. Avoir la bonne direction et le bon niveau, c'est la moitié du travail :" },
    { type: "table", headers: ["Votre position","Prise de profit (limite, clic gauche)","Stop loss (stop, clic droit)"], rows: [
      ["<strong class='text-white'>Longue</strong> (vous avez acheté)","Limite de vente <strong class='text-white'>au-dessus</strong> de votre entrée","Stop de vente <strong class='text-white'>en dessous</strong> de votre entrée"],
      ["<strong class='text-white'>Courte</strong> (vous avez vendu)","Limite d'achat <strong class='text-white'>en dessous</strong> de votre entrée","Stop d'achat <strong class='text-white'>au-dessus</strong> de votre entrée"],
    ] },
    { type: "heading",text: "Comment la fermeture accidentelle de la position se produit" },
    { type: "paragraph",html: "C'est le mode d'échec le plus vicieux, car il n'y a aucune erreur, votre trade disparaît simplement. Supposons que vous soyez long et que vous placiez votre prise de profit. Si vous cliquez à gauche sur un prix <em>en dessous</em> du marché actuel côté vente, vous avez posé un limite de vente sous le marché. Un limite de vente sous le prix courant est immédiatement exécutable : il est rempli tout de suite et ferme votre position. Même piège en sens inverse pour une position courte : un limite d'achat posé par clic gauche au-dessus du marché est exécuté instantanément. L'ordre était techniquement valide, ce n'était simplement pas ce que vous vouliez. Gardez votre objectif limite du côté éloigné du marché (au-dessus pour une position longue, en dessous pour une courte) et réservez le côté proche à votre stop par clic droit, et cela ne pourra plus vous surprendre." },
    { type: "heading",text: "Comment le corriger, étape par étape" },
    { type: "heading",text: "Construire un OCO à usage unique propre sur une position longue" },
    {
      type: "steps",
      items: [
        { title: "Confirmez que vous êtes dans la position", html: "Le module Positions doit afficher vos contrats ouverts et votre prix d'entrée moyen." },
        { title: "Activez l'OCO à usage unique", html: "Sur le SuperDOM, ouvrez la liste déroulante de type d'ordre ou ATM en haut de l'échelle et sélectionnez l'option <strong class='text-white'>one-time OCO</strong>. (Le libellé varie selon les versions de la plateforme ; confirmez donc le nom exact actuel sur votre écran.)" },
        { title: "Clic gauche au-dessus de l'entrée pour l'objectif", html: "Faites un <strong class='text-white'>clic gauche</strong> sur le prix <em>au-dessus</em> de votre entrée où vous voulez prendre vos profits. Cela pose votre <em>limite</em> de vente (l'objectif)." },
        { title: "Clic droit sous l'entrée pour le stop", html: "Faites un <strong class='text-white'>clic droit</strong> sur le prix <em>en dessous</em> de votre entrée où vous voulez être protégé. Cela pose votre <em>stop</em> de vente (le stop loss)." },
        { title: "Confirmez que la paire est active", html: "Vérifiez que les deux apparaissent désormais comme ordres actifs sur l'échelle et dans le module Orders. Lorsque l'un est exécuté, Tradovate annule l'autre pour vous." },
      ],
    },
    { type: "heading",text: "L'appliquer en miroir sur une position courte" },
    { type: "paragraph",html: "Même principe, inversé. <strong class='text-white'>Clic gauche sous</strong> le marché pour le limite d'achat qui prend votre profit, et <strong class='text-white'>clic droit au-dessus</strong> du marché pour le stop d'achat qui vous protège. Un clic gauche, un clic droit, un ordre de chaque côté de votre entrée. C'est toujours une combinaison valide." },
    { type: "heading",text: "Si « Wrong Combination » s'affiche encore" },
    { type: "paragraph",html: "Annulez les deux ordres actifs, réactivez l'OCO à usage unique (rappelez-vous qu'il est à usage unique et se désactive après chaque paire) et placez les ordres un par un afin de voir le badge de type de chacun avant de valider. Si un objectif sort sans cesse comme stop ou inversement, vous êtes presque certainement dans l'autre mode de clic du DOM. Ouvrez les paramètres du DOM, vérifiez le comportement de saisie d'ordres, puis remettez le mode attendu." },
    { type: "heading",text: "Tableau de dépannage" },
    { type: "table", headers: ["Ce que vous avez fait","Ce qui s'est passé","Solution"], rows: [
      ["Clic gauche sur les deux prix de sortie","Deux ordres limites, &ldquo;wrong combination&rdquo;","Faites un clic droit côté stop pour avoir un limite et un stop"],
      ["Clic droit sur les deux prix de sortie","Deux ordres stop, &ldquo;wrong combination&rdquo;","Faites un clic gauche côté objectif pour en faire un limite"],
      ["Clic gauche sous le marché en position longue","Limite de vente exécutable, position fermée","Placez l'objectif limite au-dessus du marché ; utilisez le clic droit pour le stop en dessous"],
      ["Ordres placés avant d'activer l'OCO","Deux ordres indépendants, sans lien d'annulation","Activez d'abord l'OCO à usage unique, puis posez la paire"],
      ["Les types d'ordre sortent inversés","Le limite devient un stop ou inversement","Vérifiez le réglage du mode de clic du DOM et revenez au mode attendu"],
      ["L'OCO a fonctionné une fois, puis disparaît au trade suivant","L'OCO à usage unique n'est valable qu'une fois","Réactivez-le à chaque position ou utilisez une stratégie ATM pour un bracket reproductible"],
    ] },
    { type: "heading",text: "Une approche plus fiable : laisser la plateforme construire le bracket" },
    { type: "paragraph",html: "Cliquer pour placer un stop et un objectif sur une échelle en direct, aux bons endroits, avec le bon bouton de souris, pendant que le prix bouge, c'est beaucoup à réussir à chaque trade. Si cette gymnastique manuelle vous piège sans cesse, ôtez vos doigts de l'échelle pour vos sorties." },
    { type: "paragraph",html: "Une stratégie ATM vous permet de prédéfinir une fois votre objectif et votre stop, puis les rattache automatiquement comme bracket OCO à l'instant où votre entrée est exécutée. Pas de gymnastique clic gauche / clic droit, aucun risque de rejet pour mauvaise combinaison, car la plateforme assemble la paire pour vous." },
    { type: "heading",text: "Évitez tout cela avec PickMyTrade" },
    { type: "paragraph",html: "Si vos entrées proviennent d'une stratégie ou d'un indicateur TradingView, vous pouvez vous passer entièrement de la saisie manuelle des ordres. PickMyTrade s'intercale entre TradingView et Tradovate et place vos ordres à partir de vos alertes, de sorte que le stop et l'objectif sont rattachés par programmation :" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Stop et objectif envoyés en un seul bracket</strong> depuis votre alerte, donc aucune paire invalide à rejeter.",
        "<strong class='text-white'>Aucun clic sur l'échelle</strong> pour les sorties, donc pas de confusion entre clic gauche et clic droit ni d'exécutions accidentelles au marché.",
        "<strong class='text-white'>Cohérent à chaque trade</strong>, au lieu de réactiver l'OCO à usage unique à la main après chaque position.",
        "<strong class='text-white'>Direction gérée pour vous</strong>, de sorte qu'une position longue reçoit ses sorties de vente et une courte ses sorties d'achat sans que vous ayez à y penser en plein trade.",
      ],
    },
    { type: "paragraph",html: "Vous définissez la logique une fois dans TradingView, et vos ordres de protection apparaissent sur Tradovate de la même manière à chaque fois." },
  ], it: [
    { type: "paragraph",html: "È già in una posizione, attiva l'OCO una tantum per inserire uno stop e un target sulla ladder e, invece di un bracket ordinato, compare un avviso rosso <strong class='text-white'>&ldquo;wrong combination&rdquo;</strong>. O peggio, la Sua posizione si chiude da sola. Entrambi i problemi hanno la stessa origine: come ha cliccato. Sul SuperDOM, un OCO una tantum si aspetta <strong class='text-white'>esattamente un ordine stop e un ordine limit</strong> posizionati dal lato corretto del mercato, e Tradovate decide quale ordine sia quale in base al clic sinistro o destro. Se l'abbinamento è sbagliato, rifiuta il gruppo come combinazione non valida. Se clicca con il sinistro su un prezzo già oltre il mercato, genera un ordine eseguibile che La porta flat. Una volta compresa la regola del clic, questo non accade più. E se preferisce non toccare mai la ladder per le uscite, un bridge di automazione come PickMyTrade collega stop e target per Lei." },
    {
      type: "checklist",
      heading: "Rapida checklist per evitare l'errore di combinazione errata",
      items: [
        "<strong class='text-white'>Uno stop, un limit.</strong> Un OCO di uscita valido è esattamente un ordine stop e un ordine limit. Mai due dello stesso tipo.",
        "<strong class='text-white'>Conosca la regola del clic.</strong> Nella modalità DOM predefinita, il clic sinistro inserisce un <em>limit</em> e il clic destro inserisce uno <em>stop</em>.",
        "<strong class='text-white'>Entrambi gli ordini sul Suo lato di uscita.</strong> Se è long, entrambe le uscite sono vendite. Se è short, entrambe sono acquisti.",
        "<strong class='text-white'>Target e stop racchiudono il Suo ingresso.</strong> Presa profitto sopra l'ingresso in una long, stop sotto. Specularmente in una short.",
        "<strong class='text-white'>Prima attivi l'OCO, poi inserisca i due ordini.</strong> L'OCO una tantum si applica alla successiva coppia che inserisce.",
        "<strong class='text-white'>Verifichi l'impostazione della modalità di clic del DOM</strong> se i tipi di ordine non risultano come si aspetta.",
      ],
    },
    { type: "heading",text: "Cosa significa l'errore «Wrong Combination»" },
    { type: "paragraph",html: "Un OCO una tantum (one-cancels-other) raggruppa due ordini in modo che, non appena uno viene eseguito, l'altro venga annullato automaticamente. È così che protegge una posizione aperta con uno stop loss e una presa profitto contemporaneamente senza ritrovarsi con una doppia esecuzione. Tradovate accetta il gruppo solo se i due ordini formano una coppia one-cancels-other valida per la posizione che detiene: un limit di presa profitto e uno stop di protezione, sui lati opposti del Suo prezzo di ingresso." },
    { type: "paragraph",html: "&ldquo;Wrong combination&rdquo; è Tradovate che Le dice che i due ordini inseriti non possono funzionare come quella coppia. Forse entrambi sono risultati limit. Forse entrambi stop. Forse i due prezzi cliccati non hanno senso come bracket attorno alla Sua posizione. Quali che siano i dettagli, la piattaforma si rifiuta di collegarli in un OCO e La avvisa invece di tirare a indovinare. La interpreti come un guardrail, non come un malfunzionamento. Il gruppo di ordini era malformato, quindi non è stato collegato nulla." },
    { type: "heading",text: "Perché accade (e perché a volte chiude invece la Sua posizione)" },
    { type: "heading",text: "La regola del clic sinistro e destro" },
    { type: "paragraph",html: "È il punto in cui inciampano quasi tutti. Nella modalità di clic predefinita del DOM di Tradovate, è il <em>tasto del mouse</em> a decidere il tipo di ordine, non il livello di prezzo:" },
    {
      type: "list",
      items: [
        "Il <strong class='text-white'>clic sinistro</strong> sulla ladder inserisce un ordine <strong class='text-white'>limit</strong>.",
        "Il <strong class='text-white'>clic destro</strong> sulla ladder inserisce un ordine <strong class='text-white'>stop</strong>.",
      ],
    },
    { type: "paragraph",html: "Questo vale sia che il puntatore si trovi sopra sia che si trovi sotto il mercato corrente. Quindi, per costruire una coppia OCO valida, deve cliccare con il sinistro su un prezzo (che diventa il Suo limit o target) e con il destro sull'altro prezzo (che diventa il Suo stop). Se clicca con il sinistro su entrambi i prezzi, ha inserito due limit. Se clicca con il destro su entrambi, ha inserito due stop. Nessuna delle due è una coppia one-cancels-other valida, ed è allora che compare l'avviso di combinazione errata." },
    { type: "paragraph",html: "Esiste una seconda modalità di clic, più recente, che può attivare nelle impostazioni del DOM, in cui un singolo clic sinistro gestisce entrambi i tipi e la piattaforma deduce stop o limit dalla posizione del prezzo rispetto al miglior bid e ask. È un'opzione reale e alcuni trader la preferiscono, ma si comporta in modo diverso, quindi se i tipi di ordine continuano a risultare errati, la prima cosa da controllare è in quale modalità si trova effettivamente." },
    { type: "heading",text: "Su quale lato e livello si colloca ogni ordine" },
    { type: "paragraph",html: "I Suoi ordini di uscita si trovano sempre sul lato opposto del Suo ingresso. Se ha comprato (è long), esce vendendo, quindi sia il target sia lo stop sono ordini di vendita. Se ha venduto (è short), esce comprando. Direzione e livello corretti sono metà del lavoro:" },
    { type: "table", headers: ["La Sua posizione","Presa profitto (limit, clic sinistro)","Stop loss (stop, clic destro)"], rows: [
      ["<strong class='text-white'>Long</strong> (ha comprato)","Limit di vendita <strong class='text-white'>sopra</strong> il Suo ingresso","Stop di vendita <strong class='text-white'>sotto</strong> il Suo ingresso"],
      ["<strong class='text-white'>Short</strong> (ha venduto)","Limit di acquisto <strong class='text-white'>sotto</strong> il Suo ingresso","Stop di acquisto <strong class='text-white'>sopra</strong> il Suo ingresso"],
    ] },
    { type: "heading",text: "Come avviene la chiusura accidentale della posizione" },
    { type: "paragraph",html: "Questa è la modalità di errore più insidiosa, perché non c'è alcun errore, il Suo trade semplicemente scompare. Supponga di essere long e di inserire la presa profitto. Se clicca con il sinistro su un prezzo <em>sotto</em> il mercato corrente sul lato vendita, ha messo un limit di vendita sotto il mercato. Un limit di vendita sotto il prezzo corrente è immediatamente eseguibile, quindi viene riempito subito e chiude la Sua posizione. Stessa trappola al contrario per una short: un limit di acquisto inserito con il clic sinistro sopra il mercato viene eseguito all'istante. L'ordine era tecnicamente valido, semplicemente non era ciò che intendeva. Mantenga il target limit sul lato lontano del mercato (sopra per una long, sotto per una short) e riservi il lato vicino al Suo stop con clic destro, e questo non potrà coglierLa di sorpresa." },
    { type: "heading",text: "Come risolvere, passo dopo passo" },
    { type: "heading",text: "Costruire un OCO una tantum pulito su una posizione long" },
    {
      type: "steps",
      items: [
        { title: "Confermi di essere nella posizione", html: "Il modulo Positions dovrebbe mostrare i Suoi contratti aperti e il prezzo medio di ingresso." },
        { title: "Attivi l'OCO una tantum", html: "Sul SuperDOM, apra il menu a discesa del tipo di ordine o ATM in cima alla ladder e selezioni l'opzione <strong class='text-white'>one-time OCO</strong>. (La dicitura dell'etichetta cambia tra le versioni della piattaforma, quindi confermi il nome esatto attuale sul Suo schermo.)" },
        { title: "Clic sinistro sopra l'ingresso per il target", html: "Clicchi con il <strong class='text-white'>sinistro</strong> sul prezzo <em>sopra</em> il Suo ingresso in cui vuole prendere profitto. Così inserisce il Suo <em>limit</em> di vendita (il target)." },
        { title: "Clic destro sotto l'ingresso per lo stop", html: "Clicchi con il <strong class='text-white'>destro</strong> sul prezzo <em>sotto</em> il Suo ingresso in cui vuole protezione. Così inserisce il Suo <em>stop</em> di vendita (lo stop loss)." },
        { title: "Confermi che la coppia sia attiva", html: "Verifichi che entrambi risultino ora come ordini attivi sulla ladder e nel modulo Orders. Quando uno dei due viene eseguito, Tradovate annulla l'altro per Lei." },
      ],
    },
    { type: "heading",text: "Specularmente su una posizione short" },
    { type: "paragraph",html: "Stessa idea, rovesciata. <strong class='text-white'>Clic sinistro sotto</strong> il mercato per il limit di acquisto che prende profitto, e <strong class='text-white'>clic destro sopra</strong> il mercato per lo stop di acquisto che La protegge. Un clic sinistro, un clic destro, un ordine su ciascun lato del Suo ingresso. È sempre una combinazione valida." },
    { type: "heading",text: "Se compare ancora «Wrong Combination»" },
    { type: "paragraph",html: "Annulli entrambi gli ordini attivi, riattivi l'OCO una tantum (ricordi che è a utilizzo singolo e si disattiva dopo ogni coppia) e inserisca gli ordini uno alla volta, in modo da vedere il badge del tipo di ciascuno prima di confermare. Se un target continua a risultare come stop o viceversa, è quasi certamente nell'altra modalità di clic del DOM. Apra le impostazioni del DOM, verifichi il comportamento di inserimento degli ordini e lo riporti alla modalità attesa." },
    { type: "heading",text: "Tabella di risoluzione dei problemi" },
    { type: "table", headers: ["Cosa ha fatto","Cosa è successo","Soluzione"], rows: [
      ["Clic sinistro su entrambi i prezzi di uscita","Due ordini limit, &ldquo;wrong combination&rdquo;","Clicchi con il destro sul lato dello stop così da avere un limit e uno stop"],
      ["Clic destro su entrambi i prezzi di uscita","Due ordini stop, &ldquo;wrong combination&rdquo;","Clicchi con il sinistro sul lato del target per renderlo un limit"],
      ["Clic sinistro sotto il mercato essendo long","Limit di vendita eseguibile, posizione chiusa","Posizioni il target limit sopra il mercato; usi il clic destro per lo stop sotto"],
      ["Ordini inseriti prima di attivare l'OCO","Due ordini indipendenti, nessun collegamento di annullamento","Attivi prima l'OCO una tantum, poi inserisca la coppia"],
      ["I tipi di ordine risultano invertiti","Il limit diventa stop o viceversa","Verifichi l'impostazione della modalità di clic del DOM e torni alla modalità attesa"],
      ["L'OCO ha funzionato una volta, al trade successivo non c'è più","L'OCO una tantum è a utilizzo singolo","Lo riattivi a ogni posizione o usi una strategia ATM per un bracket ripetibile"],
    ] },
    { type: "heading",text: "Un modo più stabile: lasci che sia la piattaforma a costruire il bracket" },
    { type: "paragraph",html: "Cliccare uno stop e un target su una ladder in tempo reale, nei punti giusti, con il tasto del mouse giusto, mentre il prezzo si muove, è molto da azzeccare a ogni singolo trade. Se questa danza manuale continua a metterLa in difficoltà, tolga le dita dalla ladder per le uscite." },
    { type: "paragraph",html: "Una strategia ATM Le permette di predefinire target e stop una volta sola e poi li collega automaticamente come bracket OCO nell'istante in cui il Suo ingresso viene eseguito. Nessuna ginnastica di clic sinistro e destro, nessuna possibilità di rifiuto per combinazione errata, perché la piattaforma assembla la coppia per Lei." },
    { type: "heading",text: "Lo eviti del tutto con PickMyTrade" },
    { type: "paragraph",html: "Se i Suoi ingressi provengono da una strategia o da un indicatore di TradingView, può saltare del tutto l'inserimento manuale degli ordini. PickMyTrade si colloca tra TradingView e Tradovate e inserisce i Suoi ordini a partire dai Suoi alert, in modo che stop e target vengano collegati in modo programmatico:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Stop e target inviati come un unico bracket</strong> dal Suo alert, quindi non c'è alcuna coppia non valida da rifiutare.",
        "<strong class='text-white'>Nessun clic sulla ladder</strong> per le uscite, quindi nessuna confusione tra clic sinistro e destro e nessuna esecuzione a mercato accidentale.",
        "<strong class='text-white'>Coerente a ogni trade</strong>, invece di riattivare a mano l'OCO una tantum dopo ogni posizione.",
        "<strong class='text-white'>Direzione gestita per Lei</strong>, così una long riceve le sue uscite di vendita e una short le sue uscite di acquisto senza che Lei debba pensarci nel mezzo del trade.",
      ],
    },
    { type: "paragraph",html: "Lei definisce la logica una volta in TradingView, e i Suoi ordini di protezione compaiono su Tradovate sempre allo stesso modo." },
  ] },
  ctaHeading: { en: "Automate Your Stops and Targets", de: "Automatisieren Sie Ihre Stops und Ziele", es: "Automatice sus stops y objetivos", fr: "Automatisez vos stops et vos objectifs", it: "Automatizzi i Suoi stop e i Suoi target" },
  ctaText: { en: "Start your free trial and automate your Tradovate stops and targets, no ladder clicking required.", de: "Starten Sie Ihre kostenlose Testphase und automatisieren Sie Ihre Tradovate-Stops und -Ziele, ganz ohne Klicks auf der Preisleiter.", es: "Comience su prueba gratuita y automatice sus stops y objetivos de Tradovate, sin necesidad de hacer clic en la escalera de precios.", fr: "Commencez votre essai gratuit et automatisez vos stops et objectifs Tradovate, sans avoir à cliquer sur l'échelle de prix.", it: "Inizi la prova gratuita e automatizzi gli stop e i target di Tradovate, senza bisogno di cliccare sulla ladder." },
  ctaButtonText: { en: "Start Your Free 7-Day Trial", de: "Starten Sie Ihre kostenlose 7-Tage-Testphase", es: "Comience su prueba gratuita de 7 días", fr: "Commencez votre essai gratuit de 7 jours", it: "Inizi la prova gratuita di 7 giorni" },
  ctaUrl: "https://app.pickmytrade.trade/?register=true&utm_source=content&utm_medium=debugging",
  faqHeading: { en: "Frequently Asked Questions", de: "Häufig gestellte Fragen", es: "Preguntas frecuentes", fr: "Questions fréquentes", it: "Domande frequenti" },
  faqs: { en: [
    { q: "What does the \"wrong combination\" error mean in Tradovate?", a: "It means the two orders you dropped on the ladder don't form a valid one-cancels-other pair. A one-time OCO expects exactly one protective stop and one profit-taking limit sitting on opposite sides of your entry. If you place two stops, two limits, or a geometry that can't work as a bracket, Tradovate rejects the group as a wrong combination. It's a validation guard, not a bug." },
    { q: "Why did Tradovate close my position instead of setting the OCO?", a: "You most likely left-clicked a price that was already through the market on your exit side, which sends a marketable limit that fills instantly and flattens you. When you're long, a sell limit placed below the current price is immediately fillable. Keep your take-profit limit above the market on a long (below the market on a short) and use a right-click for the stop so nothing fires at market." },
    { q: "Do I left-click or right-click for the stop loss on the Tradovate DOM?", a: "In the default DOM click mode, a left-click places a limit order and a right-click places a stop order, no matter whether the pointer is above or below the market. So your protective stop is a right-click and your take-profit target is a left-click. There's also an alternative click mode in DOM settings where a left-click does both and the platform picks the type from the price level, so confirm which mode you're in." },
    { q: "Can I set a one-time OCO before I'm in a trade?", a: "A one-time OCO is built to manage an existing position by attaching an exit stop and target. If you want the bracket to appear automatically the moment your entry fills, use an ATM strategy instead, which pre-defines the target and stop and drops them as an OCO on entry without any manual clicking." },
    { q: "Why do I have to turn OCO back on after every trade?", a: "One-time OCO is exactly that, a single use. It applies to the next pair of orders you place and then switches itself off, so you re-enable it for the next position. If you want a repeatable, hands-off bracket, save an ATM strategy or route your entries and exits through an automation bridge so the stop and target attach every time." },
  ], de: [
    { q: "Was bedeutet der Fehler „wrong combination“ in Tradovate?", a: "Er bedeutet, dass die beiden Orders, die Sie auf der Preisleiter platziert haben, kein gültiges One-Cancels-Other-Paar bilden. Ein einmaliges OCO erwartet genau einen schützenden Stop und ein Gewinnziel-Limit, die auf gegenüberliegenden Seiten Ihres Einstiegs liegen. Wenn Sie zwei Stops, zwei Limits oder eine Konstellation platzieren, die als Bracket nicht funktionieren kann, lehnt Tradovate die Gruppe als falsche Kombination ab. Das ist eine Validierungsschranke, kein Fehler." },
    { q: "Warum hat Tradovate meine Position geschlossen, statt das OCO zu setzen?", a: "Sie haben höchstwahrscheinlich mit Linksklick einen Preis gewählt, der auf Ihrer Ausstiegsseite bereits jenseits des Marktes lag. Dadurch wird ein marktfähiges Limit gesendet, das sofort ausgeführt wird und Sie flat stellt. Wenn Sie long sind, ist ein Verkaufs-Limit unterhalb des aktuellen Preises sofort ausführbar. Halten Sie Ihr Take-Profit-Limit bei einer Long-Position oberhalb des Marktes (bei einer Short-Position unterhalb) und setzen Sie den Stop per Rechtsklick, damit nichts zum Marktpreis ausgelöst wird." },
    { q: "Muss ich für den Stop-Loss im Tradovate-DOM links- oder rechtsklicken?", a: "Im standardmäßigen DOM-Klickmodus platziert ein Linksklick eine Limit-Order und ein Rechtsklick eine Stop-Order, unabhängig davon, ob sich der Zeiger über oder unter dem Markt befindet. Ihr schützender Stop ist also ein Rechtsklick und Ihr Take-Profit-Ziel ein Linksklick. In den DOM-Einstellungen gibt es außerdem einen alternativen Klickmodus, in dem ein Linksklick beides übernimmt und die Plattform den Ordertyp anhand des Preisniveaus bestimmt. Prüfen Sie daher, in welchem Modus Sie sich befinden." },
    { q: "Kann ich ein einmaliges OCO setzen, bevor ich in einem Trade bin?", a: "Ein einmaliges OCO dient dazu, eine bestehende Position zu verwalten, indem es einen Ausstiegs-Stop und ein Ziel anhängt. Wenn das Bracket automatisch erscheinen soll, sobald Ihr Einstieg ausgeführt wird, verwenden Sie stattdessen eine ATM-Strategie. Sie definiert Ziel und Stop vorab und legt sie beim Einstieg ohne manuelles Klicken als OCO an." },
    { q: "Warum muss ich OCO nach jedem Trade wieder einschalten?", a: "Das einmalige OCO gilt genau einmal. Es wird auf das nächste Orderpaar angewendet, das Sie platzieren, und schaltet sich danach selbst aus, sodass Sie es für die nächste Position erneut aktivieren müssen. Wenn Sie ein wiederholbares, automatisches Bracket möchten, speichern Sie eine ATM-Strategie oder leiten Sie Ihre Einstiege und Ausstiege über eine Automatisierungsbrücke, damit Stop und Ziel jedes Mal angehängt werden." },
  ], es: [
    { q: "¿Qué significa el error «wrong combination» en Tradovate?", a: "Significa que las dos órdenes que colocó en la escalera no forman un par válido de una cancela a la otra. Un OCO de una sola vez espera exactamente un stop protector y un límite para tomar beneficios, situados en lados opuestos de su entrada. Si coloca dos stops, dos límites o una geometría que no puede funcionar como bracket, Tradovate rechaza el grupo como una combinación incorrecta. Es una barrera de validación, no un error." },
    { q: "¿Por qué Tradovate cerró mi posición en lugar de configurar el OCO?", a: "Lo más probable es que haya hecho clic izquierdo en un precio que ya estaba más allá del mercado en su lado de salida, lo que envía un límite ejecutable al instante que se llena de inmediato y lo deja sin posición. Cuando está en largo, un límite de venta colocado por debajo del precio actual es ejecutable de inmediato. Mantenga su límite de toma de beneficios por encima del mercado en un largo (por debajo en un corto) y use clic derecho para el stop, de modo que nada se dispare a mercado." },
    { q: "¿Hago clic izquierdo o derecho para el stop loss en el DOM de Tradovate?", a: "En el modo de clic predeterminado del DOM, un clic izquierdo coloca una orden límite y un clic derecho coloca una orden stop, sin importar si el puntero está por encima o por debajo del mercado. Por tanto, su stop protector es un clic derecho y su objetivo de toma de beneficios es un clic izquierdo. También hay un modo de clic alternativo en la configuración del DOM donde el clic izquierdo hace ambas cosas y la plataforma elige el tipo según el nivel de precio, así que confirme en qué modo está." },
    { q: "¿Puedo configurar un OCO de una sola vez antes de estar en una operación?", a: "Un OCO de una sola vez está pensado para gestionar una posición existente adjuntando un stop de salida y un objetivo. Si desea que el bracket aparezca automáticamente en cuanto se ejecute su entrada, use en su lugar una estrategia ATM, que predefine el objetivo y el stop y los coloca como OCO en la entrada sin hacer clic manualmente." },
    { q: "¿Por qué tengo que volver a activar OCO después de cada operación?", a: "El OCO de una sola vez es exactamente eso, un único uso. Se aplica al siguiente par de órdenes que coloque y luego se desactiva solo, por lo que debe volver a activarlo para la siguiente posición. Si desea un bracket repetible y automático, guarde una estrategia ATM o dirija sus entradas y salidas a través de un puente de automatización para que el stop y el objetivo se adjunten siempre." },
  ], fr: [
    { q: "Que signifie l'erreur « wrong combination » dans Tradovate ?", a: "Elle signifie que les deux ordres que vous avez posés sur l'échelle ne forment pas une paire valide d'ordres où l'un annule l'autre. Un OCO à usage unique attend exactement un stop de protection et un limite de prise de profit, placés de part et d'autre de votre entrée. Si vous placez deux stops, deux limites ou une géométrie qui ne peut pas fonctionner comme bracket, Tradovate rejette le groupe comme une mauvaise combinaison. C'est un garde-fou de validation, pas un bug." },
    { q: "Pourquoi Tradovate a-t-il fermé ma position au lieu de définir l'OCO ?", a: "Vous avez très probablement cliqué avec le bouton gauche sur un prix déjà au-delà du marché de votre côté de sortie, ce qui envoie un ordre limite exécutable immédiatement qui est rempli aussitôt et vous met à plat. Lorsque vous êtes acheteur, un limite de vente placé sous le prix actuel est immédiatement exécutable. Gardez votre limite de prise de profit au-dessus du marché pour une position longue (en dessous pour une position courte) et utilisez un clic droit pour le stop afin que rien ne parte au marché." },
    { q: "Dois-je faire un clic gauche ou un clic droit pour le stop loss sur le DOM de Tradovate ?", a: "Dans le mode de clic par défaut du DOM, un clic gauche place un ordre limite et un clic droit place un ordre stop, que le pointeur soit au-dessus ou en dessous du marché. Votre stop de protection se fait donc par clic droit et votre objectif de prise de profit par clic gauche. Il existe aussi un autre mode de clic dans les paramètres du DOM où un clic gauche fait les deux et où la plateforme choisit le type selon le niveau de prix ; vérifiez donc dans quel mode vous êtes." },
    { q: "Puis-je définir un OCO à usage unique avant d'être dans un trade ?", a: "Un OCO à usage unique est conçu pour gérer une position existante en y rattachant un stop de sortie et un objectif. Si vous voulez que le bracket apparaisse automatiquement dès l'exécution de votre entrée, utilisez plutôt une stratégie ATM, qui prédéfinit l'objectif et le stop et les place en OCO à l'entrée sans aucun clic manuel." },
    { q: "Pourquoi dois-je réactiver l'OCO après chaque trade ?", a: "L'OCO à usage unique est exactement cela, un seul usage. Il s'applique à la prochaine paire d'ordres que vous placez, puis se désactive de lui-même ; vous le réactivez donc pour la position suivante. Si vous voulez un bracket reproductible et automatique, enregistrez une stratégie ATM ou faites passer vos entrées et sorties par un pont d'automatisation afin que le stop et l'objectif soient rattachés à chaque fois." },
  ], it: [
    { q: "Cosa significa l'errore «wrong combination» in Tradovate?", a: "Significa che i due ordini inseriti sulla ladder non formano una coppia one-cancels-other valida. Un OCO una tantum si aspetta esattamente uno stop di protezione e un limite di presa profitto, posizionati sui lati opposti del Suo ingresso. Se inserisce due stop, due limit o una geometria che non può funzionare come bracket, Tradovate rifiuta il gruppo come combinazione errata. È un controllo di validazione, non un bug." },
    { q: "Perché Tradovate ha chiuso la mia posizione invece di impostare l'OCO?", a: "Molto probabilmente ha cliccato con il tasto sinistro su un prezzo già oltre il mercato sul Suo lato di uscita, il che invia un limit eseguibile immediatamente che viene riempito subito e La porta flat. Quando è long, un limit di vendita posto sotto il prezzo corrente è immediatamente eseguibile. Mantenga il limit di presa profitto sopra il mercato in una posizione long (sotto il mercato in una short) e usi il clic destro per lo stop, così nulla parte a mercato." },
    { q: "Devo cliccare con il tasto sinistro o destro per lo stop loss sul DOM di Tradovate?", a: "Nella modalità di clic predefinita del DOM, il clic sinistro inserisce un ordine limit e il clic destro inserisce un ordine stop, indipendentemente dal fatto che il puntatore sia sopra o sotto il mercato. Quindi il Suo stop di protezione si inserisce con il clic destro e il Suo target di presa profitto con il clic sinistro. Esiste anche una modalità di clic alternativa nelle impostazioni del DOM in cui il clic sinistro fa entrambe le cose e la piattaforma sceglie il tipo in base al livello di prezzo, quindi verifichi in quale modalità si trova." },
    { q: "Posso impostare un OCO una tantum prima di essere in un trade?", a: "Un OCO una tantum è pensato per gestire una posizione esistente collegando uno stop di uscita e un target. Se desidera che il bracket compaia automaticamente non appena il Suo ingresso viene eseguito, usi invece una strategia ATM, che predefinisce target e stop e li inserisce come OCO all'ingresso senza alcun clic manuale." },
    { q: "Perché devo riattivare l'OCO dopo ogni trade?", a: "L'OCO una tantum è esattamente questo, un solo utilizzo. Si applica alla successiva coppia di ordini che inserisce e poi si disattiva da solo, quindi lo riattiva per la posizione seguente. Se desidera un bracket ripetibile e automatico, salvi una strategia ATM o instradi ingressi e uscite tramite un bridge di automazione, in modo che stop e target vengano collegati ogni volta." },
