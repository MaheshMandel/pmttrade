---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "jigsaw-daytradr-connection-failed";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/debugging/${SLUG}`;

const META_TITLE = "Jigsaw Daytradr 'Connection Failed' With Tradovate";
const META_DESCRIPTION =
  "Jigsaw Daytradr 'connection failed' with Tradovate? Reinstall the latest Daytradr build and check your Live/Demo server and 2FA to reconnect fast.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Jigsaw Daytradr „Connection Failed“ bei Tradovate", es: "Jigsaw Daytradr: error «Connection Failed» al conectar con Tradovate", fr: "Jigsaw Daytradr « Connection Failed » avec Tradovate", it: "Jigsaw Daytradr: errore «Connection Failed» con Tradovate" },
  dek: { en: "Daytradr hangs on connection pending or flat-out fails while Tradovate's own web platform logs in fine. Here's why it's almost always a Daytradr-side bug, and how to reconnect.", de: "Daytradr bleibt bei „connection pending“ hängen oder schlägt direkt fehl, während sich die Tradovate-Webplattform problemlos anmelden lässt. Hier erfahren Sie, warum es fast immer ein Fehler auf Daytradr-Seite ist und wie Sie die Verbindung wiederherstellen.", es: "Daytradr se queda en «connection pending» o falla directamente mientras la plataforma web de Tradovate inicia sesión sin problemas. Le explicamos por qué casi siempre es un error del lado de Daytradr y cómo volver a conectar.", fr: "Daytradr reste bloqué sur « connection pending » ou échoue d'emblée alors que la plateforme web de Tradovate se connecte sans problème. Voici pourquoi il s'agit presque toujours d'un bug côté Daytradr et comment vous reconnecter.", it: "Daytradr resta bloccato su «connection pending» o fallisce subito mentre la piattaforma web di Tradovate si connette senza problemi. Ecco perché è quasi sempre un bug lato Daytradr e come riconnettersi." },
  readTime: { en: "8 min read", de: "8 Min. Lesezeit", es: "Lectura de 8 min", fr: "Lecture : 8 min", it: "Lettura di 8 min" },
  lastUpdated: "2026-07-10",
  blocks: { en: [
    { type: "paragraph", html: "You open Jigsaw Daytradr, hit Connect on your Tradovate account, and instead of a live DOM you get a stubborn <strong class='text-white'>&ldquo;connection pending&rdquo;</strong> that never clears, or a flat <strong class='text-white'>&ldquo;connection failed.&rdquo;</strong> Meanwhile Tradovate's own web platform logs in without a hiccup, which makes the whole thing more maddening. Here's the short version: this is almost always a Daytradr-side bug, not a Tradovate outage, and the fix that clears it for most people is to <strong class='text-white'>re-download and install the latest Daytradr build</strong> from your Jigsaw members portal. Jigsaw patched the defect that stopped Daytradr from establishing the Tradovate connection, so an older copy of the app is often the whole problem. If a fresh install alone doesn't do it, the culprit is usually a mismatched Live/Demo server, wrong credentials, or a 2FA step that hasn't been approved yet. Below is the full fix, plus how to keep your automated Tradovate orders flowing even when a desktop app is having a bad day." },
    {
      type: "checklist",
      heading: "Quick Checklist for a Daytradr Connection Failure",
      items: [
        "<strong class='text-white'>Update Daytradr first.</strong> Re-download and install the latest build from your Jigsaw members portal. This alone fixes most Tradovate connection failures.",
        "<strong class='text-white'>Confirm the server.</strong> Live account uses Live, simulation uses Demo. Funded/eval accounts often run as Live inside Tradovate, so check with your firm.",
        "<strong class='text-white'>Re-enter credentials carefully.</strong> Use the exact Tradovate username and password for that account, with no stray spaces.",
        "<strong class='text-white'>Handle 2FA.</strong> With the 2FA option on, the first Connect is meant to fail and trigger an email. Approve the device, then reconnect.",
        "<strong class='text-white'>Restart clean.</strong> Disconnect everything, fully close Daytradr, reopen, and reconnect. Restart Tradovate too if needed.",
        "<strong class='text-white'>Check the basics.</strong> Stable wired network, no firewall/antivirus block, and you're not logged in to the same account in too many places.",
        "<strong class='text-white'>Still stuck?</strong> Contact Jigsaw support, since a persistent Daytradr connection bug is theirs to resolve.",
      ],
    },
    { type: "heading", text: "What \"Connection Failed\" in Daytradr Actually Means" },
    { type: "paragraph", html: "Daytradr connects to Tradovate through its own Connection Manager, using the username and password you saved for that account. When it shows <strong class='text-white'>connection pending</strong> that never resolves, or drops straight to <strong class='text-white'>connection failed</strong>, the app couldn't complete the handshake with Tradovate's servers. That can happen even when your login details are perfect, because the failure is often inside the Daytradr build rather than your account." },
    { type: "paragraph", html: "The tell is simple: if you can log in to Tradovate's web trader or mobile app right now with the same credentials, Tradovate itself is up and your account is fine. The break is between Daytradr and Tradovate. That's exactly the pattern Jigsaw addressed with a fix for Daytradr not establishing (and not re-establishing) the Tradovate connection, and it's why an out-of-date app is the first thing to rule out. Tradovate's own support has told traders hitting this to reach out to Jigsaw, which tells you where the fix lives." },
    { type: "heading", text: "Top Causes of the Daytradr–Tradovate Connection Failure" },
    { type: "heading", text: "1. You're running an outdated Daytradr build" },
    { type: "paragraph", html: "This is the big one. Jigsaw shipped fixes for Daytradr failing to connect to Tradovate and for Tradovate not reconnecting after an internet blip. If your copy predates those fixes, it can hang on pending or fail outright while Tradovate itself is perfectly healthy. Updating to the current build is the single most effective move." },
    { type: "heading", text: "2. Wrong server selected (Live vs Demo)" },
    { type: "paragraph", html: "Every Tradovate connection in Daytradr is tied to a server environment. Point a live account at the Demo server, or a simulation account at Live, and the connection won't complete. This trips up funded and evaluation traders constantly, because many prop firms run their funded sim as a <strong class='text-white'>Live</strong> environment inside Tradovate rather than Demo." },
    { type: "heading", text: "3. Incorrect or mismatched credentials" },
    { type: "paragraph", html: "A typo, a trailing space, an expired password, or using your personal Tradovate login when the account you actually trade is a prop-firm account with its own separate credentials will all read as a failed connection. The username and password have to match the exact account and environment you're selecting." },
    { type: "heading", text: "4. 2FA hasn't been approved yet" },
    { type: "paragraph", html: "If you use two-factor authentication, Daytradr has a specific dance: with the 2FA option enabled on the connection, the <strong class='text-white'>first</strong> click of Connect is designed to fail and trigger Tradovate's device-approval email. If you don't know that's the intended behavior, it looks exactly like a broken connection. Approve the device, then reconnect." },
    { type: "heading", text: "5. A dropped connection that won't re-establish" },
    { type: "paragraph", html: "Lose your internet for a moment, put the machine to sleep, or let the session idle, and older Daytradr builds sometimes fail to reconnect to Tradovate on their own. You end up stuck on pending until you force a clean restart, which is another reason the latest build matters." },
    { type: "heading", text: "6. Network, firewall, or too many sessions" },
    { type: "paragraph", html: "An unstable connection, a firewall or antivirus blocking Daytradr, or being logged in to the same Tradovate account across too many places at once can all interfere with the handshake. Tradovate limits how many active sessions a single account can hold, so a stray web or mobile login competing with Daytradr can knock you offline." },
    { type: "heading", text: "How to Fix the Daytradr Connection Failure: Step-by-Step" },
    {
      type: "steps",
      items: [
        { title: "Reinstall the latest Daytradr build (do this first)", html: "Fully close Daytradr, making sure it isn't still running in the system tray. Log in to your <strong class='text-white'>Jigsaw members portal</strong> and open the Daytradr download area. Download the current Daytradr installer, get it from Jigsaw, not from Tradovate. Run the installer over your existing version; if the failure persists afterward, uninstall Daytradr cleanly and install fresh. Relaunch Daytradr and try connecting to Tradovate again. For a large share of these failures, this step alone fixes it." },
        { title: "Verify your connection settings", html: "Open the Connection Manager (under Daytradr's <strong class='text-white'>Connections</strong> menu), then add or edit your Tradovate connection and confirm each field: <strong class='text-white'>Connection name</strong> (anything you'll recognize), <strong class='text-white'>User Name / Password</strong> (the exact credentials, no leading or trailing spaces), <strong class='text-white'>Server</strong> (Live or Demo to match the account, confirm with your firm if it's a funded/eval account), <strong class='text-white'>Market Replay</strong> (leave off unless connecting for replay), and <strong class='text-white'>Login with 2FA</strong> (only if your account uses two-factor)." },
        { title: "Clear the 2FA handshake", html: "With the <strong class='text-white'>Login with 2FA</strong> option enabled, click Connect once and expect it to fail, that's what triggers the approval email. Open the device-approval email Tradovate sends to the address on your account and approve the device. Back in Daytradr, disconnect, then reconnect. The second attempt should authenticate cleanly." },
        { title: "Restart clean if it's still pending", html: "Disconnect every active connection in Daytradr. Close Daytradr completely, then reopen it and reconnect. If it still hangs, restart Tradovate as well, sign out of the web and mobile apps, then bring Daytradr back up on its own. Move to a stable wired connection if you're on flaky Wi-Fi, and confirm your firewall or antivirus isn't blocking Daytradr." },
        { title: "Escalate to Jigsaw support", html: "If Tradovate's own platforms log in but Daytradr still can't connect after a clean reinstall and settings check, the ball is in Jigsaw's court. Open a ticket with Jigsaw support and tell them you've updated to the latest build, confirmed your credentials and server, and cleared 2FA, that context gets you to a real fix faster." },
      ],
    },
    { type: "heading", text: "Troubleshooting Table" },
    {
      type: "table",
      headers: ["Symptom / State", "Likely cause", "Fix"],
      rows: [
        ["Stuck on &ldquo;connection pending,&rdquo; then fails", "Outdated Daytradr build", "Re-download and install the latest Daytradr build from the Jigsaw members portal"],
        ["Credentials correct but still won't connect", "Wrong server environment", "Set the connection's server to Live or Demo to match the account; confirm with your firm on funded/eval accounts"],
        ["First Connect fails immediately after enabling 2FA", "Expected 2FA handshake", "Approve the emailed device, then disconnect and reconnect"],
        ["Was connected, dropped, won't come back", "Reconnect bug after network blip", "Update the build, then fully restart Daytradr and reconnect"],
        ["Random disconnects while Tradovate web is fine", "Too many active sessions or network/firewall", "Close extra Tradovate logins, use a wired connection, and allow Daytradr through your firewall"],
        ["Nothing works after a clean reinstall", "Daytradr-side defect", "Contact Jigsaw support with your build version and steps already tried"],
      ],
    },
    { type: "heading", text: "Keep Your Tradovate Automation Running With PickMyTrade" },
    { type: "paragraph", html: "Daytradr is a discretionary DOM tool, brilliant for reading order flow and clicking trades by hand. But if your edge is automated, you don't want your fills depending on whether a desktop app on your machine is currently connected. When Daytradr drops its Tradovate link mid-session, a hand trader loses their ladder; an automated trader can lose an entry or, worse, an exit." },
    { type: "paragraph", html: "PickMyTrade routes your TradingView alerts to Tradovate over a steady, server-side connection, so your automated entries and exits keep firing whether or not a desktop platform on your laptop is connected at that moment. Use Daytradr for the click-trading you love, and let PickMyTrade carry the automated side." },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Cloud-side connection</strong>, your alerts route through PickMyTrade's server link to Tradovate, not through a desktop app that can drop when your Wi-Fi hiccups.",
        "<strong class='text-white'>Set-once account link</strong>, connect your Tradovate account a single time; there's no Connection Manager to babysit before every session.",
        "<strong class='text-white'>Live and demo aware</strong>, point automation at the exact account and environment you mean, which is the same mismatch that trips up desktop connections.",
        "<strong class='text-white'>Multi-account sync</strong>, mirror one TradingView alert across several Tradovate accounts from one place, no separate desktop login for each.",
      ],
    },
  ], de: [
    { type: "paragraph",html: "Sie öffnen Jigsaw Daytradr, klicken bei Ihrem Tradovate-Konto auf Connect, und statt eines Live-DOM erhalten Sie ein hartnäckiges <strong class='text-white'>&ldquo;connection pending&rdquo;</strong>, das nie verschwindet, oder ein schlichtes <strong class='text-white'>&ldquo;connection failed.&rdquo;</strong> Währenddessen lässt sich die Tradovate-Webplattform ohne Probleme anmelden, was alles noch ärgerlicher macht. Die Kurzfassung: Das ist fast immer ein Fehler auf Daytradr-Seite und kein Ausfall bei Tradovate, und die Lösung, die das Problem für die meisten Nutzer behebt, ist, <strong class='text-white'>den neuesten Daytradr-Build erneut herunterzuladen und zu installieren</strong>, und zwar aus Ihrem Jigsaw-Mitgliederportal. Jigsaw hat den Fehler behoben, der Daytradr daran hinderte, die Verbindung zu Tradovate herzustellen, daher ist eine ältere Kopie der App oft das ganze Problem. Reicht eine frische Installation allein nicht aus, ist meist ein nicht passender Live/Demo-Server, falsche Zugangsdaten oder ein noch nicht freigegebener 2FA-Schritt der Übeltäter. Unten finden Sie die vollständige Lösung sowie Hinweise, wie Ihre automatisierten Tradovate-Orders weiterlaufen, selbst wenn eine Desktop-App einen schlechten Tag hat." },
    {
      type: "checklist",
      heading: "Kurze Checkliste bei einem Daytradr-Verbindungsfehler",
      items: [
        "<strong class='text-white'>Aktualisieren Sie zuerst Daytradr.</strong> Laden Sie den neuesten Build erneut aus Ihrem Jigsaw-Mitgliederportal herunter und installieren Sie ihn. Das allein behebt die meisten Verbindungsfehler mit Tradovate.",
        "<strong class='text-white'>Bestätigen Sie den Server.</strong> Ein Live-Konto nutzt Live, Simulation nutzt Demo. Funded-/Eval-Konten laufen in Tradovate oft als Live, prüfen Sie dies daher bei Ihrer Firma.",
        "<strong class='text-white'>Geben Sie die Zugangsdaten sorgfältig neu ein.</strong> Verwenden Sie genau den Tradovate-Benutzernamen und das Passwort für dieses Konto, ohne überflüssige Leerzeichen.",
        "<strong class='text-white'>Behandeln Sie 2FA.</strong> Bei aktivierter 2FA-Option soll der erste Connect fehlschlagen und eine E-Mail auslösen. Geben Sie das Gerät frei und verbinden Sie sich dann erneut.",
        "<strong class='text-white'>Starten Sie sauber neu.</strong> Trennen Sie alle Verbindungen, beenden Sie Daytradr vollständig, öffnen Sie es erneut und verbinden Sie sich neu. Starten Sie bei Bedarf auch Tradovate neu.",
        "<strong class='text-white'>Prüfen Sie die Grundlagen.</strong> Stabiles kabelgebundenes Netzwerk, keine Blockade durch Firewall/Virenschutz, und Sie sind nicht an zu vielen Orten im selben Konto angemeldet.",
        "<strong class='text-white'>Immer noch festgefahren?</strong> Wenden Sie sich an den Jigsaw-Support, denn ein dauerhafter Daytradr-Verbindungsfehler ist deren Sache.",
      ],
    },
    { type: "heading",text: "Was „Connection Failed“ in Daytradr tatsächlich bedeutet" },
    { type: "paragraph",html: "Daytradr verbindet sich über seinen eigenen Connection Manager mit Tradovate und nutzt dabei den Benutzernamen und das Passwort, die Sie für dieses Konto gespeichert haben. Zeigt es <strong class='text-white'>connection pending</strong>, das nie endet, oder springt direkt auf <strong class='text-white'>connection failed</strong>, konnte die App den Handshake mit den Servern von Tradovate nicht abschließen. Das kann selbst bei einwandfreien Zugangsdaten passieren, weil der Fehler oft im Daytradr-Build statt in Ihrem Konto liegt." },
    { type: "paragraph",html: "Das Erkennungszeichen ist einfach: Wenn Sie sich jetzt mit denselben Zugangsdaten bei Tradovates Web-Trader oder der mobilen App anmelden können, ist Tradovate selbst erreichbar und Ihr Konto in Ordnung. Der Bruch liegt zwischen Daytradr und Tradovate. Genau dieses Muster hat Jigsaw mit einer Korrektur dafür behoben, dass Daytradr die Verbindung zu Tradovate nicht herstellte (und nicht wiederherstellte), und deshalb ist eine veraltete App das Erste, was Sie ausschließen sollten. Der Support von Tradovate hat Tradern, die darauf stoßen, geraten, sich an Jigsaw zu wenden, was Ihnen zeigt, wo die Lösung liegt." },
    { type: "heading",text: "Die häufigsten Ursachen für den Verbindungsfehler zwischen Daytradr und Tradovate" },
    { type: "heading",text: "1. Sie nutzen einen veralteten Daytradr-Build" },
    { type: "paragraph",html: "Das ist die wichtigste Ursache. Jigsaw hat Korrekturen dafür ausgeliefert, dass Daytradr keine Verbindung zu Tradovate herstellt und dass Tradovate sich nach einem kurzen Internetausfall nicht wieder verbindet. Stammt Ihre Kopie aus der Zeit vor diesen Korrekturen, kann sie bei „pending“ hängen bleiben oder direkt fehlschlagen, während Tradovate selbst völlig gesund ist. Das Update auf den aktuellen Build ist der wirksamste Einzelschritt." },
    { type: "heading",text: "2. Falscher Server ausgewählt (Live vs. Demo)" },
    { type: "paragraph",html: "Jede Tradovate-Verbindung in Daytradr ist an eine Serverumgebung gebunden. Richten Sie ein Live-Konto auf den Demo-Server oder ein Simulationskonto auf Live, kommt die Verbindung nicht zustande. Das bringt Funded- und Evaluierungs-Trader ständig durcheinander, weil viele Prop Firms ihre Funded-Simulation innerhalb von Tradovate als <strong class='text-white'>Live</strong>-Umgebung statt als Demo betreiben." },
    { type: "heading",text: "3. Falsche oder nicht passende Zugangsdaten" },
    { type: "paragraph",html: "Ein Tippfehler, ein angehängtes Leerzeichen, ein abgelaufenes Passwort oder die Verwendung Ihres persönlichen Tradovate-Logins, obwohl das Konto, mit dem Sie handeln, ein Prop-Firm-Konto mit eigenen Zugangsdaten ist, wird jeweils als fehlgeschlagene Verbindung gewertet. Benutzername und Passwort müssen zu genau dem Konto und der Umgebung passen, die Sie auswählen." },
    { type: "heading",text: "4. 2FA wurde noch nicht freigegeben" },
    { type: "paragraph",html: "Wenn Sie Zwei-Faktor-Authentifizierung nutzen, hat Daytradr einen besonderen Ablauf: Bei aktivierter 2FA-Option für die Verbindung ist der <strong class='text-white'>erste</strong> Klick auf Connect so gedacht, dass er fehlschlägt und die Geräte-Freigabe-E-Mail von Tradovate auslöst. Wer nicht weiß, dass das beabsichtigt ist, hält es für eine defekte Verbindung. Geben Sie das Gerät frei und verbinden Sie sich dann erneut." },
    { type: "heading",text: "5. Eine unterbrochene Verbindung, die sich nicht wiederherstellt" },
    { type: "paragraph",html: "Wenn Ihr Internet kurz ausfällt, der Rechner in den Ruhezustand geht oder die Sitzung im Leerlauf ist, schaffen es ältere Daytradr-Builds manchmal nicht, sich von selbst wieder mit Tradovate zu verbinden. Sie bleiben bei „pending“ hängen, bis Sie einen sauberen Neustart erzwingen, ein weiterer Grund, warum der neueste Build wichtig ist." },
    { type: "heading",text: "6. Netzwerk, Firewall oder zu viele Sitzungen" },
    { type: "paragraph",html: "Eine instabile Verbindung, eine Firewall oder ein Virenschutz, die Daytradr blockieren, oder eine gleichzeitige Anmeldung im selben Tradovate-Konto an zu vielen Orten können den Handshake stören. Tradovate begrenzt, wie viele aktive Sitzungen ein einzelnes Konto halten kann, sodass eine vergessene Web- oder Mobil-Anmeldung, die mit Daytradr konkurriert, Sie offline werfen kann." },
    { type: "heading",text: "So beheben Sie den Daytradr-Verbindungsfehler: Schritt für Schritt" },
    {
      type: "steps",
      items: [
        { title: "Den neuesten Daytradr-Build neu installieren (zuerst erledigen)", html: "Beenden Sie Daytradr vollständig und stellen Sie sicher, dass es nicht mehr im Infobereich der Taskleiste läuft. Melden Sie sich in Ihrem <strong class='text-white'>Jigsaw-Mitgliederportal</strong> an und öffnen Sie den Daytradr-Download-Bereich. Laden Sie das aktuelle Daytradr-Installationsprogramm herunter, beziehen Sie es von Jigsaw, nicht von Tradovate. Führen Sie das Installationsprogramm über Ihre bestehende Version aus; bleibt der Fehler danach bestehen, deinstallieren Sie Daytradr sauber und installieren Sie es neu. Starten Sie Daytradr neu und versuchen Sie erneut, sich mit Tradovate zu verbinden. Bei einem großen Teil dieser Fehler behebt allein dieser Schritt das Problem." },
        { title: "Verbindungseinstellungen überprüfen", html: "Öffnen Sie den Connection Manager (im Menü <strong class='text-white'>Connections</strong> von Daytradr), fügen Sie dann Ihre Tradovate-Verbindung hinzu oder bearbeiten Sie sie und prüfen Sie jedes Feld: <strong class='text-white'>Connection name</strong> (beliebig, solange Sie ihn erkennen), <strong class='text-white'>User Name / Password</strong> (die exakten Zugangsdaten, ohne führende oder nachgestellte Leerzeichen), <strong class='text-white'>Server</strong> (Live oder Demo passend zum Konto, bei Funded-/Eval-Konten bei Ihrer Firma bestätigen), <strong class='text-white'>Market Replay</strong> (ausgeschaltet lassen, sofern Sie sich nicht für Replay verbinden) und <strong class='text-white'>Login with 2FA</strong> (nur wenn Ihr Konto Zwei-Faktor-Authentifizierung nutzt)." },
        { title: "Den 2FA-Handshake abschließen", html: "Klicken Sie bei aktivierter Option <strong class='text-white'>Login with 2FA</strong> einmal auf Connect und rechnen Sie mit einem Fehlschlag, genau das löst die Freigabe-E-Mail aus. Öffnen Sie die Geräte-Freigabe-E-Mail, die Tradovate an die Adresse Ihres Kontos sendet, und geben Sie das Gerät frei. Trennen Sie die Verbindung zurück in Daytradr und verbinden Sie sich dann erneut. Der zweite Versuch sollte sich sauber authentifizieren." },
        { title: "Sauber neu starten, falls es weiter hängt", html: "Trennen Sie jede aktive Verbindung in Daytradr. Beenden Sie Daytradr vollständig, öffnen Sie es erneut und verbinden Sie sich neu. Hängt es weiterhin, starten Sie auch Tradovate neu, melden Sie sich in den Web- und Mobil-Apps ab und fahren Sie Daytradr dann allein wieder hoch. Wechseln Sie bei instabilem WLAN zu einer stabilen Kabelverbindung und stellen Sie sicher, dass Ihre Firewall oder Ihr Virenschutz Daytradr nicht blockiert." },
        { title: "An den Jigsaw-Support eskalieren", html: "Wenn sich die Plattformen von Tradovate anmelden lassen, Daytradr nach einer sauberen Neuinstallation und Einstellungsprüfung aber weiterhin keine Verbindung herstellt, liegt der Ball bei Jigsaw. Eröffnen Sie ein Ticket beim Jigsaw-Support und teilen Sie mit, dass Sie auf den neuesten Build aktualisiert, Ihre Zugangsdaten und den Server bestätigt und 2FA abgeschlossen haben, dieser Kontext führt Sie schneller zu einer echten Lösung." },
      ],
    },
    { type: "heading",text: "Tabelle zur Fehlerbehebung" },
    { type: "table", headers: ["Symptom / Zustand","Wahrscheinliche Ursache","Lösung"], rows: [
      ["Hängt bei &ldquo;connection pending,&rdquo; schlägt dann fehl","Veralteter Daytradr-Build","Neuesten Daytradr-Build aus dem Jigsaw-Mitgliederportal erneut herunterladen und installieren"],
      ["Zugangsdaten korrekt, verbindet sich trotzdem nicht","Falsche Serverumgebung","Server der Verbindung passend zum Konto auf Live oder Demo setzen; bei Funded-/Eval-Konten bei Ihrer Firma bestätigen"],
      ["Erster Connect schlägt direkt nach Aktivieren von 2FA fehl","Erwarteter 2FA-Handshake","Das per E-Mail gesendete Gerät freigeben, dann trennen und erneut verbinden"],
      ["War verbunden, Verbindung abgebrochen, kommt nicht zurück","Wiederverbindungsfehler nach Netzwerkaussetzer","Build aktualisieren, dann Daytradr vollständig neu starten und erneut verbinden"],
      ["Zufällige Verbindungsabbrüche, während Tradovate Web funktioniert","Zu viele aktive Sitzungen oder Netzwerk/Firewall","Zusätzliche Tradovate-Anmeldungen schließen, Kabelverbindung nutzen und Daytradr in der Firewall zulassen"],
      ["Nach sauberer Neuinstallation funktioniert nichts","Fehler auf Daytradr-Seite","Jigsaw-Support mit Ihrer Build-Version und den bereits versuchten Schritten kontaktieren"],
    ] },
    { type: "heading",text: "Halten Sie Ihre Tradovate-Automatisierung mit PickMyTrade am Laufen" },
    { type: "paragraph",html: "Daytradr ist ein diskretionäres DOM-Tool, hervorragend zum Lesen des Orderflusses und zum manuellen Klicken von Trades. Wenn Ihr Vorteil jedoch automatisiert ist, möchten Sie nicht, dass Ihre Fills davon abhängen, ob eine Desktop-App auf Ihrem Rechner gerade verbunden ist. Wenn Daytradr mitten in der Sitzung die Tradovate-Verbindung verliert, verliert ein manueller Trader seine Leiter; ein automatisierter Trader kann einen Einstieg oder, schlimmer, einen Ausstieg verlieren." },
    { type: "paragraph",html: "PickMyTrade leitet Ihre TradingView-Alerts über eine stabile, serverseitige Verbindung an Tradovate weiter, sodass Ihre automatisierten Einstiege und Ausstiege weiter ausgeführt werden, ganz gleich, ob eine Desktop-Plattform auf Ihrem Laptop gerade verbunden ist. Nutzen Sie Daytradr für das Click-Trading, das Sie lieben, und lassen Sie PickMyTrade die automatisierte Seite tragen." },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Cloudseitige Verbindung</strong>, Ihre Alerts laufen über die Serververbindung von PickMyTrade zu Tradovate und nicht über eine Desktop-App, die abbrechen kann, wenn Ihr WLAN kurz aussetzt.",
        "<strong class='text-white'>Einmalige Kontoverknüpfung</strong>, verbinden Sie Ihr Tradovate-Konto ein einziges Mal; es gibt keinen Connection Manager, den Sie vor jeder Sitzung betreuen müssen.",
        "<strong class='text-white'>Live und Demo im Blick</strong>, richten Sie die Automatisierung auf exakt das Konto und die Umgebung, die Sie meinen, dieselbe Verwechslung, die Desktop-Verbindungen zum Stolpern bringt.",
        "<strong class='text-white'>Multi-Konto-Synchronisierung</strong>, spiegeln Sie einen TradingView-Alert von einem Ort aus auf mehrere Tradovate-Konten, ohne separate Desktop-Anmeldung für jedes.",
      ],
    },
  ], es: [
    { type: "paragraph",html: "Abre Jigsaw Daytradr, pulsa Connect en su cuenta de Tradovate y, en lugar de un DOM en vivo, obtiene un persistente <strong class='text-white'>&ldquo;connection pending&rdquo;</strong> que nunca desaparece, o un simple <strong class='text-white'>&ldquo;connection failed.&rdquo;</strong> Mientras tanto, la plataforma web de Tradovate inicia sesión sin ningún problema, lo que hace todo aún más exasperante. La versión corta: casi siempre es un error del lado de Daytradr, no una caída de Tradovate, y la solución que lo resuelve para la mayoría es <strong class='text-white'>volver a descargar e instalar la última versión de Daytradr</strong> desde su portal de miembros de Jigsaw. Jigsaw corrigió el defecto que impedía a Daytradr establecer la conexión con Tradovate, así que una copia antigua de la app suele ser todo el problema. Si una instalación nueva por sí sola no basta, el culpable suele ser un servidor Live/Demo que no coincide, credenciales incorrectas o un paso de 2FA que aún no se ha aprobado. A continuación encontrará la solución completa y cómo mantener en marcha sus órdenes automatizadas de Tradovate incluso cuando una app de escritorio tiene un mal día." },
    {
      type: "checklist",
      heading: "Lista de comprobación rápida para un fallo de conexión de Daytradr",
      items: [
        "<strong class='text-white'>Actualice primero Daytradr.</strong> Vuelva a descargar e instalar la última versión desde su portal de miembros de Jigsaw. Esto por sí solo corrige la mayoría de los fallos de conexión con Tradovate.",
        "<strong class='text-white'>Confirme el servidor.</strong> Una cuenta real usa Live, la simulación usa Demo. Las cuentas financiadas/de evaluación suelen funcionar como Live dentro de Tradovate, así que consulte con su firma.",
        "<strong class='text-white'>Vuelva a introducir las credenciales con cuidado.</strong> Use el nombre de usuario y la contraseña exactos de Tradovate para esa cuenta, sin espacios sobrantes.",
        "<strong class='text-white'>Gestione la 2FA.</strong> Con la opción 2FA activada, el primer Connect está pensado para fallar y disparar un correo. Apruebe el dispositivo y vuelva a conectar.",
        "<strong class='text-white'>Reinicie limpiamente.</strong> Desconecte todo, cierre Daytradr por completo, vuelva a abrirlo y reconecte. Reinicie también Tradovate si es necesario.",
        "<strong class='text-white'>Revise lo básico.</strong> Red estable por cable, sin bloqueo de firewall/antivirus, y sin sesiones en la misma cuenta en demasiados lugares.",
        "<strong class='text-white'>¿Sigue atascado?</strong> Contacte con el soporte de Jigsaw, ya que un fallo de conexión persistente de Daytradr les corresponde a ellos.",
      ],
    },
    { type: "heading",text: "Qué significa realmente «Connection Failed» en Daytradr" },
    { type: "paragraph",html: "Daytradr se conecta a Tradovate a través de su propio Connection Manager, usando el nombre de usuario y la contraseña que guardó para esa cuenta. Cuando muestra <strong class='text-white'>connection pending</strong> sin resolverse nunca, o pasa directamente a <strong class='text-white'>connection failed</strong>, la app no pudo completar el protocolo de enlace con los servidores de Tradovate. Eso puede ocurrir incluso cuando sus datos de acceso son perfectos, porque el fallo suele estar dentro de la versión de Daytradr y no en su cuenta." },
    { type: "paragraph",html: "El indicio es sencillo: si ahora mismo puede iniciar sesión en el trader web o en la app móvil de Tradovate con las mismas credenciales, Tradovate funciona y su cuenta está bien. La ruptura está entre Daytradr y Tradovate. Es exactamente el patrón que Jigsaw abordó con una corrección para que Daytradr no establecía (ni restablecía) la conexión con Tradovate, y por eso una app desactualizada es lo primero que hay que descartar. El propio soporte de Tradovate ha indicado a los traders que encuentran esto que se pongan en contacto con Jigsaw, lo que le dice dónde está la solución." },
    { type: "heading",text: "Principales causas del fallo de conexión entre Daytradr y Tradovate" },
    { type: "heading",text: "1. Está ejecutando una versión desactualizada de Daytradr" },
    { type: "paragraph",html: "Esta es la principal. Jigsaw publicó correcciones para que Daytradr no conectaba con Tradovate y para que Tradovate no se reconectaba tras un corte breve de internet. Si su copia es anterior a esas correcciones, puede quedarse en «pending» o fallar directamente aunque Tradovate esté perfectamente sano. Actualizar a la versión actual es la medida más eficaz." },
    { type: "heading",text: "2. Servidor equivocado seleccionado (Live vs Demo)" },
    { type: "paragraph",html: "Cada conexión de Tradovate en Daytradr está vinculada a un entorno de servidor. Si apunta una cuenta real al servidor Demo, o una cuenta de simulación a Live, la conexión no se completa. Esto confunde constantemente a los traders de cuentas financiadas y de evaluación, porque muchas prop firms ejecutan su simulación financiada como un entorno <strong class='text-white'>Live</strong> dentro de Tradovate en lugar de Demo." },
    { type: "heading",text: "3. Credenciales incorrectas o que no coinciden" },
    { type: "paragraph",html: "Un error tipográfico, un espacio al final, una contraseña caducada o usar su acceso personal de Tradovate cuando la cuenta con la que realmente opera es una cuenta de prop firm con credenciales propias aparecerán como una conexión fallida. El nombre de usuario y la contraseña deben corresponder a la cuenta y al entorno exactos que está seleccionando." },
    { type: "heading",text: "4. La 2FA aún no se ha aprobado" },
    { type: "paragraph",html: "Si usa autenticación en dos pasos, Daytradr tiene una dinámica concreta: con la opción 2FA activada en la conexión, el <strong class='text-white'>primer</strong> clic en Connect está diseñado para fallar y disparar el correo de aprobación del dispositivo de Tradovate. Si no sabe que es el comportamiento previsto, parece exactamente una conexión rota. Apruebe el dispositivo y vuelva a conectar." },
    { type: "heading",text: "5. Una conexión caída que no se restablece" },
    { type: "paragraph",html: "Si pierde internet un momento, suspende el equipo o deja la sesión inactiva, las versiones antiguas de Daytradr a veces no consiguen reconectarse a Tradovate por sí solas. Se queda atascado en «pending» hasta que fuerza un reinicio limpio, otra razón por la que importa la última versión." },
    { type: "heading",text: "6. Red, firewall o demasiadas sesiones" },
    { type: "paragraph",html: "Una conexión inestable, un firewall o antivirus que bloquea Daytradr, o tener la sesión iniciada en la misma cuenta de Tradovate en demasiados lugares a la vez pueden interferir con el protocolo de enlace. Tradovate limita cuántas sesiones activas puede mantener una sola cuenta, así que un inicio de sesión olvidado en la web o el móvil que compita con Daytradr puede dejarle sin conexión." },
    { type: "heading",text: "Cómo solucionar el fallo de conexión de Daytradr: paso a paso" },
    {
      type: "steps",
      items: [
        { title: "Reinstalar la última versión de Daytradr (hágalo primero)", html: "Cierre Daytradr por completo, asegurándose de que no siga ejecutándose en la bandeja del sistema. Inicie sesión en su <strong class='text-white'>portal de miembros de Jigsaw</strong> y abra la zona de descargas de Daytradr. Descargue el instalador actual de Daytradr, obténgalo de Jigsaw, no de Tradovate. Ejecute el instalador sobre su versión existente; si el fallo persiste después, desinstale Daytradr limpiamente e instálelo de nuevo. Vuelva a iniciar Daytradr e intente conectar de nuevo con Tradovate. En una gran parte de estos fallos, solo este paso lo soluciona." },
        { title: "Verificar los ajustes de conexión", html: "Abra el Connection Manager (en el menú <strong class='text-white'>Connections</strong> de Daytradr), luego añada o edite su conexión de Tradovate y confirme cada campo: <strong class='text-white'>Connection name</strong> (cualquiera que reconozca), <strong class='text-white'>User Name / Password</strong> (las credenciales exactas, sin espacios al principio ni al final), <strong class='text-white'>Server</strong> (Live o Demo según la cuenta; consulte con su firma si es una cuenta financiada/de evaluación), <strong class='text-white'>Market Replay</strong> (déjelo desactivado salvo que se conecte para replay) y <strong class='text-white'>Login with 2FA</strong> (solo si su cuenta usa autenticación en dos pasos)." },
        { title: "Completar el protocolo de 2FA", html: "Con la opción <strong class='text-white'>Login with 2FA</strong> activada, pulse Connect una vez y espere que falle; eso es lo que dispara el correo de aprobación. Abra el correo de aprobación de dispositivo que Tradovate envía a la dirección de su cuenta y apruebe el dispositivo. De vuelta en Daytradr, desconecte y luego vuelva a conectar. El segundo intento debería autenticarse sin problemas." },
        { title: "Reiniciar limpiamente si sigue en pending", html: "Desconecte todas las conexiones activas en Daytradr. Cierre Daytradr por completo, vuelva a abrirlo y reconecte. Si sigue colgado, reinicie también Tradovate, cierre sesión en las apps web y móvil y luego vuelva a iniciar Daytradr por sí solo. Pase a una conexión por cable estable si usa un Wi-Fi inestable y confirme que su firewall o antivirus no bloquea Daytradr." },
        { title: "Escalar al soporte de Jigsaw", html: "Si las plataformas de Tradovate inician sesión pero Daytradr sigue sin poder conectar tras una reinstalación limpia y la revisión de ajustes, la pelota está en el tejado de Jigsaw. Abra un ticket con el soporte de Jigsaw e indíqueles que ha actualizado a la última versión, confirmado sus credenciales y servidor y completado la 2FA; ese contexto le lleva más rápido a una solución real." },
      ],
    },
    { type: "heading",text: "Tabla de solución de problemas" },
    { type: "table", headers: ["Síntoma / Estado","Causa probable","Solución"], rows: [
      ["Atascado en &ldquo;connection pending,&rdquo; y luego falla","Versión desactualizada de Daytradr","Volver a descargar e instalar la última versión de Daytradr desde el portal de miembros de Jigsaw"],
      ["Credenciales correctas pero sigue sin conectar","Entorno de servidor equivocado","Configurar el servidor de la conexión en Live o Demo según la cuenta; confirmar con su firma en cuentas financiadas/de evaluación"],
      ["El primer Connect falla justo después de activar 2FA","Protocolo de 2FA esperado","Aprobar el dispositivo del correo, luego desconectar y volver a conectar"],
      ["Estaba conectado, se cayó y no vuelve","Error de reconexión tras un corte de red","Actualizar la versión, luego reiniciar Daytradr por completo y reconectar"],
      ["Desconexiones aleatorias mientras la web de Tradovate funciona","Demasiadas sesiones activas o red/firewall","Cerrar inicios de sesión extra de Tradovate, usar conexión por cable y permitir Daytradr en el firewall"],
      ["Nada funciona tras una reinstalación limpia","Defecto del lado de Daytradr","Contactar con el soporte de Jigsaw con su versión y los pasos ya probados"],
    ] },
    { type: "heading",text: "Mantenga en marcha su automatización de Tradovate con PickMyTrade" },
    { type: "paragraph",html: "Daytradr es una herramienta DOM discrecional, brillante para leer el flujo de órdenes y hacer clic en operaciones a mano. Pero si su ventaja es automatizada, no querrá que sus ejecuciones dependan de si una app de escritorio de su equipo está conectada en ese momento. Cuando Daytradr pierde su enlace con Tradovate a mitad de sesión, un trader manual pierde su escalera; un trader automatizado puede perder una entrada o, peor, una salida." },
    { type: "paragraph",html: "PickMyTrade enruta sus alertas de TradingView a Tradovate mediante una conexión estable del lado del servidor, de modo que sus entradas y salidas automatizadas se siguen ejecutando esté o no conectada en ese momento una plataforma de escritorio en su portátil. Use Daytradr para el trading con clics que le gusta y deje que PickMyTrade se encargue de la parte automatizada." },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Conexión del lado de la nube</strong>, sus alertas se enrutan a través del enlace de servidor de PickMyTrade hacia Tradovate, no a través de una app de escritorio que puede caerse cuando su Wi-Fi falla un instante.",
        "<strong class='text-white'>Vinculación de cuenta una sola vez</strong>, conecte su cuenta de Tradovate una única vez; no hay un Connection Manager que vigilar antes de cada sesión.",
        "<strong class='text-white'>Consciente de Live y Demo</strong>, dirija la automatización a la cuenta y el entorno exactos que quiere, el mismo desajuste que hace tropezar a las conexiones de escritorio.",
        "<strong class='text-white'>Sincronización multicuenta</strong>, replique una alerta de TradingView en varias cuentas de Tradovate desde un solo lugar, sin un inicio de sesión de escritorio separado para cada una.",
      ],
    },
  ], fr: [
    { type: "paragraph",html: "Vous ouvrez Jigsaw Daytradr, cliquez sur Connect pour votre compte Tradovate et, au lieu d'un DOM en direct, vous obtenez un tenace <strong class='text-white'>&ldquo;connection pending&rdquo;</strong> qui ne disparaît jamais, ou un sec <strong class='text-white'>&ldquo;connection failed.&rdquo;</strong> Pendant ce temps, la plateforme web de Tradovate se connecte sans accroc, ce qui rend le tout encore plus exaspérant. En bref : il s'agit presque toujours d'un bug côté Daytradr, pas d'une panne de Tradovate, et la solution qui règle le problème pour la plupart des utilisateurs est de <strong class='text-white'>retélécharger et installer la dernière version de Daytradr</strong> depuis votre portail membres Jigsaw. Jigsaw a corrigé le défaut qui empêchait Daytradr d'établir la connexion avec Tradovate ; une ancienne copie de l'application est donc souvent tout le problème. Si une installation neuve ne suffit pas, le coupable est généralement un serveur Live/Demo qui ne correspond pas, des identifiants erronés ou une étape de 2FA non approuvée. Vous trouverez ci-dessous la solution complète, ainsi que la manière de maintenir vos ordres Tradovate automatisés en marche même lorsqu'une application de bureau a une mauvaise journée." },
    {
      type: "checklist",
      heading: "Liste de vérification rapide pour un échec de connexion de Daytradr",
      items: [
        "<strong class='text-white'>Mettez d'abord Daytradr à jour.</strong> Retéléchargez et installez la dernière version depuis votre portail membres Jigsaw. Cela seul corrige la plupart des échecs de connexion à Tradovate.",
        "<strong class='text-white'>Confirmez le serveur.</strong> Un compte réel utilise Live, la simulation utilise Demo. Les comptes financés/d'évaluation fonctionnent souvent comme Live dans Tradovate, vérifiez donc auprès de votre firme.",
        "<strong class='text-white'>Ressaisissez soigneusement vos identifiants.</strong> Utilisez exactement le nom d'utilisateur et le mot de passe Tradovate de ce compte, sans espaces parasites.",
        "<strong class='text-white'>Gérez la 2FA.</strong> Avec l'option 2FA activée, le premier Connect est censé échouer et déclencher un e-mail. Approuvez l'appareil, puis reconnectez-vous.",
        "<strong class='text-white'>Redémarrez proprement.</strong> Déconnectez tout, fermez complètement Daytradr, rouvrez-le et reconnectez-vous. Redémarrez aussi Tradovate si nécessaire.",
        "<strong class='text-white'>Vérifiez les bases.</strong> Réseau filaire stable, aucun blocage par pare-feu/antivirus, et pas de connexions au même compte à trop d'endroits.",
        "<strong class='text-white'>Toujours bloqué ?</strong> Contactez le support Jigsaw, car un bug de connexion persistant de Daytradr relève d'eux.",
      ],
    },
    { type: "heading",text: "Ce que signifie réellement « Connection Failed » dans Daytradr" },
    { type: "paragraph",html: "Daytradr se connecte à Tradovate via son propre Connection Manager, en utilisant le nom d'utilisateur et le mot de passe que vous avez enregistrés pour ce compte. Lorsqu'il affiche <strong class='text-white'>connection pending</strong> sans jamais se résoudre, ou passe directement à <strong class='text-white'>connection failed</strong>, l'application n'a pas pu terminer la poignée de main avec les serveurs de Tradovate. Cela peut arriver même lorsque vos identifiants sont parfaits, car la défaillance se situe souvent dans la version de Daytradr plutôt que dans votre compte." },
    { type: "paragraph",html: "L'indice est simple : si vous pouvez vous connecter dès maintenant au trader web ou à l'application mobile de Tradovate avec les mêmes identifiants, Tradovate fonctionne et votre compte va bien. La rupture se situe entre Daytradr et Tradovate. C'est exactement le schéma que Jigsaw a traité avec un correctif pour Daytradr qui n'établissait pas (et ne rétablissait pas) la connexion à Tradovate, et c'est pourquoi une application obsolète est la première chose à écarter. Le support de Tradovate lui-même a conseillé aux traders confrontés à ce problème de contacter Jigsaw, ce qui vous indique où se trouve la solution." },
    { type: "heading",text: "Principales causes de l'échec de connexion entre Daytradr et Tradovate" },
    { type: "heading",text: "1. Vous utilisez une version obsolète de Daytradr" },
    { type: "paragraph",html: "C'est la cause principale. Jigsaw a publié des correctifs pour Daytradr qui n'arrivait pas à se connecter à Tradovate et pour Tradovate qui ne se reconnectait pas après une brève coupure Internet. Si votre copie est antérieure à ces correctifs, elle peut rester bloquée sur « pending » ou échouer d'emblée alors que Tradovate lui-même est en parfaite santé. Passer à la version actuelle est la mesure la plus efficace." },
    { type: "heading",text: "2. Mauvais serveur sélectionné (Live ou Demo)" },
    { type: "paragraph",html: "Chaque connexion Tradovate dans Daytradr est liée à un environnement de serveur. Si vous dirigez un compte réel vers le serveur Demo, ou un compte de simulation vers Live, la connexion n'aboutit pas. Cela piège constamment les traders de comptes financés et d'évaluation, car de nombreuses prop firms exploitent leur simulation financée comme un environnement <strong class='text-white'>Live</strong> dans Tradovate plutôt que comme Demo." },
    { type: "heading",text: "3. Identifiants incorrects ou non concordants" },
    { type: "paragraph",html: "Une faute de frappe, un espace final, un mot de passe expiré, ou l'utilisation de votre identifiant Tradovate personnel alors que le compte sur lequel vous tradez est un compte de prop firm avec ses propres identifiants, tout cela apparaît comme une connexion échouée. Le nom d'utilisateur et le mot de passe doivent correspondre au compte et à l'environnement exacts que vous sélectionnez." },
    { type: "heading",text: "4. La 2FA n'a pas encore été approuvée" },
    { type: "paragraph",html: "Si vous utilisez l'authentification à deux facteurs, Daytradr suit une chorégraphie précise : avec l'option 2FA activée sur la connexion, le <strong class='text-white'>premier</strong> clic sur Connect est conçu pour échouer et déclencher l'e-mail d'approbation d'appareil de Tradovate. Si vous ne savez pas que c'est le comportement prévu, cela ressemble exactement à une connexion défaillante. Approuvez l'appareil, puis reconnectez-vous." },
    { type: "heading",text: "5. Une connexion interrompue qui ne se rétablit pas" },
    { type: "paragraph",html: "Si vous perdez Internet un instant, mettez la machine en veille ou laissez la session inactive, les anciennes versions de Daytradr n'arrivent parfois pas à se reconnecter seules à Tradovate. Vous restez bloqué sur « pending » jusqu'à ce que vous forciez un redémarrage propre, une raison de plus pour laquelle la dernière version compte." },
    { type: "heading",text: "6. Réseau, pare-feu ou trop de sessions" },
    { type: "paragraph",html: "Une connexion instable, un pare-feu ou un antivirus qui bloque Daytradr, ou le fait d'être connecté au même compte Tradovate à trop d'endroits à la fois peuvent perturber la poignée de main. Tradovate limite le nombre de sessions actives qu'un compte peut détenir ; une connexion web ou mobile oubliée qui concurrence Daytradr peut donc vous mettre hors ligne." },
    { type: "heading",text: "Comment corriger l'échec de connexion de Daytradr : étape par étape" },
    {
      type: "steps",
      items: [
        { title: "Réinstaller la dernière version de Daytradr (à faire en premier)", html: "Fermez complètement Daytradr en vous assurant qu'il ne tourne plus dans la zone de notification. Connectez-vous à votre <strong class='text-white'>portail membres Jigsaw</strong> et ouvrez la zone de téléchargement de Daytradr. Téléchargez l'installateur actuel de Daytradr, obtenez-le auprès de Jigsaw, pas de Tradovate. Exécutez l'installateur par-dessus votre version existante ; si l'échec persiste ensuite, désinstallez Daytradr proprement et installez-le de nouveau. Relancez Daytradr et essayez de vous reconnecter à Tradovate. Pour une grande partie de ces échecs, cette étape suffit." },
        { title: "Vérifier vos paramètres de connexion", html: "Ouvrez le Connection Manager (dans le menu <strong class='text-white'>Connections</strong> de Daytradr), puis ajoutez ou modifiez votre connexion Tradovate et vérifiez chaque champ : <strong class='text-white'>Connection name</strong> (tout nom que vous reconnaîtrez), <strong class='text-white'>User Name / Password</strong> (les identifiants exacts, sans espaces au début ni à la fin), <strong class='text-white'>Server</strong> (Live ou Demo selon le compte ; confirmez auprès de votre firme pour un compte financé/d'évaluation), <strong class='text-white'>Market Replay</strong> (laissez désactivé sauf pour une connexion en replay) et <strong class='text-white'>Login with 2FA</strong> (uniquement si votre compte utilise l'authentification à deux facteurs)." },
        { title: "Terminer la poignée de main 2FA", html: "Avec l'option <strong class='text-white'>Login with 2FA</strong> activée, cliquez une fois sur Connect et attendez-vous à un échec, c'est ce qui déclenche l'e-mail d'approbation. Ouvrez l'e-mail d'approbation d'appareil que Tradovate envoie à l'adresse de votre compte et approuvez l'appareil. De retour dans Daytradr, déconnectez-vous puis reconnectez-vous. La deuxième tentative devrait s'authentifier proprement." },
        { title: "Redémarrer proprement si cela reste en pending", html: "Déconnectez toutes les connexions actives dans Daytradr. Fermez complètement Daytradr, rouvrez-le et reconnectez-vous. Si cela reste bloqué, redémarrez aussi Tradovate, déconnectez-vous des applications web et mobile, puis relancez Daytradr seul. Passez à une connexion filaire stable si votre Wi-Fi est instable et vérifiez que votre pare-feu ou votre antivirus ne bloque pas Daytradr." },
        { title: "Escalader vers le support Jigsaw", html: "Si les plateformes de Tradovate se connectent mais que Daytradr ne parvient toujours pas à se connecter après une réinstallation propre et une vérification des paramètres, la balle est dans le camp de Jigsaw. Ouvrez un ticket auprès du support Jigsaw et indiquez que vous avez mis à jour vers la dernière version, confirmé vos identifiants et votre serveur et traité la 2FA ; ce contexte vous mène plus vite à une vraie solution." },
      ],
    },
    { type: "heading",text: "Tableau de dépannage" },
    { type: "table", headers: ["Symptôme / État","Cause probable","Solution"], rows: [
      ["Bloqué sur &ldquo;connection pending,&rdquo; puis échoue","Version obsolète de Daytradr","Retélécharger et installer la dernière version de Daytradr depuis le portail membres Jigsaw"],
      ["Identifiants corrects mais ne se connecte toujours pas","Mauvais environnement de serveur","Définir le serveur de la connexion sur Live ou Demo selon le compte ; confirmer auprès de votre firme pour les comptes financés/d'évaluation"],
      ["Le premier Connect échoue juste après l'activation de la 2FA","Poignée de main 2FA attendue","Approuver l'appareil de l'e-mail, puis déconnecter et reconnecter"],
      ["Était connecté, a été coupé, ne revient pas","Bug de reconnexion après une coupure réseau","Mettre à jour la version, puis redémarrer complètement Daytradr et se reconnecter"],
      ["Déconnexions aléatoires alors que le web Tradovate fonctionne","Trop de sessions actives ou réseau/pare-feu","Fermer les connexions Tradovate en trop, utiliser une connexion filaire et autoriser Daytradr dans le pare-feu"],
      ["Rien ne marche après une réinstallation propre","Défaut côté Daytradr","Contacter le support Jigsaw avec votre numéro de version et les étapes déjà essayées"],
    ] },
    { type: "heading",text: "Gardez votre automatisation Tradovate en marche avec PickMyTrade" },
    { type: "paragraph",html: "Daytradr est un outil DOM discrétionnaire, excellent pour lire le flux d'ordres et cliquer ses trades à la main. Mais si votre avantage est automatisé, vous ne voulez pas que vos exécutions dépendent de la connexion d'une application de bureau sur votre machine à un instant donné. Lorsque Daytradr perd son lien avec Tradovate en pleine session, un trader manuel perd son échelle ; un trader automatisé peut perdre une entrée ou, pire, une sortie." },
    { type: "paragraph",html: "PickMyTrade achemine vos alertes TradingView vers Tradovate via une connexion stable côté serveur, de sorte que vos entrées et sorties automatisées continuent de s'exécuter que la plateforme de bureau de votre ordinateur portable soit connectée ou non à cet instant. Utilisez Daytradr pour le trading au clic que vous aimez et laissez PickMyTrade porter la partie automatisée." },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Connexion côté cloud</strong>, vos alertes passent par le lien serveur de PickMyTrade vers Tradovate, et non par une application de bureau qui peut décrocher quand votre Wi-Fi hoquette.",
        "<strong class='text-white'>Liaison de compte à configurer une fois</strong>, connectez votre compte Tradovate une seule fois ; aucun Connection Manager à surveiller avant chaque session.",
        "<strong class='text-white'>Conscience du Live et du Demo</strong>, dirigez l'automatisation vers le compte et l'environnement exacts que vous visez, la même confusion qui piège les connexions de bureau.",
        "<strong class='text-white'>Synchronisation multi-comptes</strong>, répliquez une alerte TradingView sur plusieurs comptes Tradovate depuis un seul endroit, sans connexion de bureau distincte pour chacun.",
      ],
    },
  ], it: [
    { type: "paragraph",html: "Apre Jigsaw Daytradr, preme Connect sul Suo account Tradovate e, invece di un DOM in tempo reale, ottiene un ostinato <strong class='text-white'>&ldquo;connection pending&rdquo;</strong> che non scompare mai, oppure un secco <strong class='text-white'>&ldquo;connection failed.&rdquo;</strong> Nel frattempo la piattaforma web di Tradovate si connette senza intoppi, il che rende tutto ancora più esasperante. In breve: è quasi sempre un bug lato Daytradr, non un'interruzione di Tradovate, e la soluzione che lo risolve per la maggior parte delle persone è <strong class='text-white'>riscaricare e installare l'ultima build di Daytradr</strong> dal portale membri di Jigsaw. Jigsaw ha corretto il difetto che impediva a Daytradr di stabilire la connessione con Tradovate, quindi una vecchia copia dell'app è spesso l'intero problema. Se una nuova installazione da sola non basta, il colpevole è di solito un server Live/Demo non corrispondente, credenziali errate o un passaggio 2FA non ancora approvato. Di seguito trova la soluzione completa e come mantenere attivi i Suoi ordini Tradovate automatizzati anche quando un'app desktop ha una brutta giornata." },
    {
      type: "checklist",
      heading: "Checklist rapida per un errore di connessione di Daytradr",
      items: [
        "<strong class='text-white'>Aggiorni prima Daytradr.</strong> Riscarichi e installi l'ultima build dal portale membri di Jigsaw. Da solo questo risolve la maggior parte degli errori di connessione a Tradovate.",
        "<strong class='text-white'>Confermi il server.</strong> Un conto reale usa Live, la simulazione usa Demo. I conti finanziati/di valutazione spesso funzionano come Live all'interno di Tradovate, quindi verifichi con la Sua società.",
        "<strong class='text-white'>Reinserisca con attenzione le credenziali.</strong> Usi il nome utente e la password Tradovate esatti per quell'account, senza spazi superflui.",
        "<strong class='text-white'>Gestisca la 2FA.</strong> Con l'opzione 2FA attiva, il primo Connect è pensato per fallire e innescare un'e-mail. Approvi il dispositivo, poi si riconnetta.",
        "<strong class='text-white'>Riavvii in modo pulito.</strong> Disconnetta tutto, chiuda completamente Daytradr, lo riapra e si riconnetta. Riavvii anche Tradovate se necessario.",
        "<strong class='text-white'>Controlli le basi.</strong> Rete cablata stabile, nessun blocco di firewall/antivirus e nessun accesso allo stesso account in troppi posti.",
        "<strong class='text-white'>Ancora bloccato?</strong> Contatti il supporto di Jigsaw, perché un bug di connessione persistente di Daytradr spetta a loro.",
      ],
    },
    { type: "heading",text: "Che cosa significa davvero «Connection Failed» in Daytradr" },
    { type: "paragraph",html: "Daytradr si connette a Tradovate tramite il proprio Connection Manager, usando il nome utente e la password che ha salvato per quell'account. Quando mostra <strong class='text-white'>connection pending</strong> che non si risolve mai, oppure passa direttamente a <strong class='text-white'>connection failed</strong>, l'app non è riuscita a completare l'handshake con i server di Tradovate. Può succedere anche quando i Suoi dati di accesso sono perfetti, perché l'errore è spesso all'interno della build di Daytradr e non nel Suo account." },
    { type: "paragraph",html: "L'indizio è semplice: se in questo momento riesce ad accedere al web trader o all'app mobile di Tradovate con le stesse credenziali, Tradovate è attivo e il Suo account è a posto. La frattura è tra Daytradr e Tradovate. È esattamente lo schema che Jigsaw ha affrontato con una correzione per Daytradr che non stabiliva (e non ristabiliva) la connessione con Tradovate, ed è per questo che un'app non aggiornata è la prima cosa da escludere. Lo stesso supporto di Tradovate ha detto ai trader che incontrano questo problema di rivolgersi a Jigsaw, il che Le indica dove si trova la soluzione." },
    { type: "heading",text: "Cause principali dell'errore di connessione tra Daytradr e Tradovate" },
    { type: "heading",text: "1. Sta usando una build obsoleta di Daytradr" },
    { type: "paragraph",html: "È la causa principale. Jigsaw ha rilasciato correzioni per Daytradr che non riusciva a connettersi a Tradovate e per Tradovate che non si riconnetteva dopo un breve calo di internet. Se la Sua copia è precedente a quelle correzioni, può restare bloccata su «pending» o fallire subito mentre Tradovate stesso è perfettamente sano. Aggiornare alla build attuale è la mossa singola più efficace." },
    { type: "heading",text: "2. Server sbagliato selezionato (Live o Demo)" },
    { type: "paragraph",html: "Ogni connessione Tradovate in Daytradr è legata a un ambiente server. Se punta un conto reale al server Demo, o un conto di simulazione a Live, la connessione non si completa. Questo mette costantemente in difficoltà i trader con conti finanziati e di valutazione, perché molte prop firm gestiscono la propria simulazione finanziata come ambiente <strong class='text-white'>Live</strong> all'interno di Tradovate anziché come Demo." },
    { type: "heading",text: "3. Credenziali errate o non corrispondenti" },
    { type: "paragraph",html: "Un errore di battitura, uno spazio finale, una password scaduta o l'uso del Suo accesso Tradovate personale quando il conto con cui opera è un conto di una prop firm con credenziali proprie vengono tutti interpretati come una connessione fallita. Nome utente e password devono corrispondere all'account e all'ambiente esatti che sta selezionando." },
    { type: "heading",text: "4. La 2FA non è stata ancora approvata" },
    { type: "paragraph",html: "Se usa l'autenticazione a due fattori, Daytradr ha una procedura specifica: con l'opzione 2FA attiva sulla connessione, il <strong class='text-white'>primo</strong> clic su Connect è progettato per fallire e innescare l'e-mail di approvazione del dispositivo di Tradovate. Se non sa che è il comportamento previsto, sembra esattamente una connessione guasta. Approvi il dispositivo, poi si riconnetta." },
    { type: "heading",text: "5. Una connessione caduta che non si ristabilisce" },
    { type: "paragraph",html: "Se perde internet per un momento, mette il computer in stop o lascia la sessione inattiva, le build più vecchie di Daytradr a volte non riescono a riconnettersi da sole a Tradovate. Resta bloccato su «pending» finché non forza un riavvio pulito, un altro motivo per cui l'ultima build è importante." },
    { type: "heading",text: "6. Rete, firewall o troppe sessioni" },
    { type: "paragraph",html: "Una connessione instabile, un firewall o un antivirus che blocca Daytradr, o l'essere connessi allo stesso account Tradovate in troppi posti contemporaneamente possono interferire con l'handshake. Tradovate limita quante sessioni attive può mantenere un singolo account, quindi un accesso web o mobile dimenticato che compete con Daytradr può metterLa offline." },
    { type: "heading",text: "Come risolvere l'errore di connessione di Daytradr: passo dopo passo" },
    {
      type: "steps",
      items: [
        { title: "Reinstallare l'ultima build di Daytradr (lo faccia per primo)", html: "Chiuda completamente Daytradr, assicurandosi che non sia ancora in esecuzione nell'area di notifica. Acceda al <strong class='text-white'>portale membri di Jigsaw</strong> e apra l'area di download di Daytradr. Scarichi l'installer attuale di Daytradr, lo prenda da Jigsaw, non da Tradovate. Esegua l'installer sopra la versione esistente; se l'errore persiste, disinstalli Daytradr in modo pulito e lo installi da zero. Rilanci Daytradr e provi a connettersi di nuovo a Tradovate. Per una larga parte di questi errori, questo passaggio da solo basta." },
        { title: "Verificare le impostazioni di connessione", html: "Apra il Connection Manager (nel menu <strong class='text-white'>Connections</strong> di Daytradr), poi aggiunga o modifichi la Sua connessione Tradovate e controlli ogni campo: <strong class='text-white'>Connection name</strong> (qualsiasi nome riconoscibile), <strong class='text-white'>User Name / Password</strong> (le credenziali esatte, senza spazi iniziali o finali), <strong class='text-white'>Server</strong> (Live o Demo in base all'account; confermi con la Sua società se è un conto finanziato/di valutazione), <strong class='text-white'>Market Replay</strong> (lo lasci disattivato a meno che non si connetta per il replay) e <strong class='text-white'>Login with 2FA</strong> (solo se il Suo account usa l'autenticazione a due fattori)." },
        { title: "Completare l'handshake 2FA", html: "Con l'opzione <strong class='text-white'>Login with 2FA</strong> attiva, faccia clic una volta su Connect e si aspetti che fallisca, è ciò che innesca l'e-mail di approvazione. Apra l'e-mail di approvazione del dispositivo che Tradovate invia all'indirizzo del Suo account e approvi il dispositivo. Tornato in Daytradr, si disconnetta e poi si riconnetta. Il secondo tentativo dovrebbe autenticarsi correttamente." },
        { title: "Riavviare in modo pulito se è ancora in pending", html: "Disconnetta ogni connessione attiva in Daytradr. Chiuda completamente Daytradr, lo riapra e si riconnetta. Se si blocca ancora, riavvii anche Tradovate, esca dalle app web e mobile, poi riporti su Daytradr da solo. Passi a una connessione cablata stabile se usa un Wi-Fi instabile e verifichi che il firewall o l'antivirus non blocchi Daytradr." },
        { title: "Passare al supporto di Jigsaw", html: "Se le piattaforme di Tradovate si connettono ma Daytradr continua a non connettersi dopo una reinstallazione pulita e il controllo delle impostazioni, la palla passa a Jigsaw. Apra un ticket con il supporto di Jigsaw e indichi che ha aggiornato all'ultima build, confermato credenziali e server e gestito la 2FA: questo contesto La porta più in fretta a una vera soluzione." },
      ],
    },
    { type: "heading",text: "Tabella di risoluzione dei problemi" },
    { type: "table", headers: ["Sintomo / Stato","Causa probabile","Soluzione"], rows: [
      ["Bloccato su &ldquo;connection pending,&rdquo; poi fallisce","Build obsoleta di Daytradr","Riscaricare e installare l'ultima build di Daytradr dal portale membri di Jigsaw"],
      ["Credenziali corrette ma non si connette comunque","Ambiente server sbagliato","Impostare il server della connessione su Live o Demo in base all'account; confermare con la propria società per i conti finanziati/di valutazione"],
      ["Il primo Connect fallisce subito dopo aver attivato la 2FA","Handshake 2FA previsto","Approvare il dispositivo ricevuto via e-mail, poi disconnettersi e riconnettersi"],
      ["Era connesso, è caduto, non ritorna","Bug di riconnessione dopo un calo di rete","Aggiornare la build, poi riavviare completamente Daytradr e riconnettersi"],
      ["Disconnessioni casuali mentre il web di Tradovate funziona","Troppe sessioni attive o rete/firewall","Chiudere gli accessi Tradovate in più, usare una connessione cablata e consentire Daytradr nel firewall"],
      ["Nulla funziona dopo una reinstallazione pulita","Difetto lato Daytradr","Contattare il supporto di Jigsaw con la versione della build e i passaggi già provati"],
    ] },
    { type: "heading",text: "Mantenga attiva la Sua automazione Tradovate con PickMyTrade" },
    { type: "paragraph",html: "Daytradr è uno strumento DOM discrezionale, eccellente per leggere l'order flow e cliccare i trade a mano. Ma se il Suo vantaggio è automatizzato, non vuole che le Sue esecuzioni dipendano dal fatto che un'app desktop sul Suo computer sia connessa in quel momento. Quando Daytradr perde il collegamento con Tradovate a metà sessione, un trader manuale perde la propria ladder; un trader automatizzato può perdere un ingresso o, peggio, un'uscita." },
    { type: "paragraph",html: "PickMyTrade instrada i Suoi alert di TradingView verso Tradovate tramite una connessione stabile lato server, così i Suoi ingressi e le Sue uscite automatizzati continuano a essere eseguiti che una piattaforma desktop sul Suo portatile sia connessa o meno in quel momento. Usi Daytradr per il click trading che ama e lasci che PickMyTrade porti avanti la parte automatizzata." },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Connessione lato cloud</strong>, i Suoi alert passano attraverso il collegamento server di PickMyTrade verso Tradovate, non attraverso un'app desktop che può cadere quando il Wi-Fi ha un singhiozzo.",
        "<strong class='text-white'>Collegamento dell'account da configurare una volta</strong>, colleghi il Suo account Tradovate una sola volta; non c'è alcun Connection Manager da sorvegliare prima di ogni sessione.",
        "<strong class='text-white'>Consapevole di Live e Demo</strong>, punti l'automazione sull'account e sull'ambiente esatti che intende, lo stesso disallineamento che mette in difficoltà le connessioni desktop.",
        "<strong class='text-white'>Sincronizzazione multi-account</strong>, replichi un alert di TradingView su più account Tradovate da un unico posto, senza un accesso desktop separato per ciascuno.",
      ],
    },
  ] },
  ctaHeading: { en: "Stop Babysitting Connections", de: "Schluss mit dem Babysitten von Verbindungen", es: "Deje de vigilar las conexiones", fr: "Cessez de surveiller vos connexions", it: "Smetta di sorvegliare le connessioni" },
  ctaText: { en: "Automate Tradovate from TradingView with PickMyTrade's steady, server-side connection.", de: "Automatisieren Sie Tradovate von TradingView aus mit der stabilen, serverseitigen Verbindung von PickMyTrade.", es: "Automatice Tradovate desde TradingView con la conexión estable del lado del servidor de PickMyTrade.", fr: "Automatisez Tradovate depuis TradingView grâce à la connexion stable côté serveur de PickMyTrade.", it: "Automatizzi Tradovate da TradingView con la connessione stabile lato server di PickMyTrade." },
  ctaButtonText: { en: "Start Your Free 7-Day Trial", de: "Starten Sie Ihre kostenlose 7-Tage-Testphase", es: "Comience su prueba gratuita de 7 días", fr: "Commencez votre essai gratuit de 7 jours", it: "Inizi la prova gratuita di 7 giorni" },
  ctaUrl: "https://app.pickmytrade.trade/?register=true&utm_source=content&utm_medium=debugging",
  faqHeading: { en: "Frequently Asked Questions", de: "Häufig gestellte Fragen", es: "Preguntas frecuentes", fr: "Questions fréquentes", it: "Domande frequenti" },
  faqs: { en: [
    { q: "Why does Jigsaw Daytradr say \"connection failed\" with Tradovate?", a: "The most common cause is an outdated Daytradr build. Jigsaw shipped a fix for a defect where Daytradr couldn't establish the Tradovate connection, so re-downloading and installing the latest build clears it for most people. The other usual suspects are the wrong server (Live vs Demo), incorrect credentials, or 2FA that hasn't been approved yet." },
    { q: "Where do I download the latest Daytradr build, from Tradovate or Jigsaw?", a: "From Jigsaw, not Tradovate. Log in to your Jigsaw members portal and download the current Daytradr installer there. Tradovate doesn't host or update the Daytradr app, so their support will point you back to Jigsaw for connection bugs on the Daytradr side." },
    { q: "Should I choose Demo or Live when I add my Tradovate connection?", a: "Match the server to the account. A personal live account uses Live; a free simulation account uses Demo. Funded and evaluation accounts are the tricky part, because many prop firms run their funded sim as \"Live\" inside Tradovate. Pick the wrong environment and the login fails even with a correct username and password, so confirm the exact environment with your firm." },
    { q: "My first connect attempt fails right after I turn on 2FA. Is that normal?", a: "Yes. When you enable the 2FA option on the connection, the first click of Connect is expected to fail on purpose so Tradovate sends the device-approval email. Open that email and approve the device, then disconnect and reconnect in Daytradr. The second attempt should go through." },
    { q: "I reinstalled the latest build and it still won't connect. What next?", a: "Fully close Daytradr, disconnect everything, then restart the app and reconnect. Double-check the username, password and Live/Demo server, approve any pending 2FA device email, and make sure you're not logged in to the same Tradovate account in too many places at once. Switch to a stable wired connection and confirm a firewall or antivirus isn't blocking Daytradr. If it still fails, contact Jigsaw support, since a persistent Daytradr-side connection failure is theirs to fix." },
    { q: "Does reinstalling Daytradr delete my layouts or saved connections?", a: "Installing the latest build over your existing version normally keeps your workspaces and saved connections. Still, note your Tradovate username and which server you use before you start, so you can re-enter the connection quickly if anything doesn't carry over." },
    { q: "Is a Daytradr connection failure a Tradovate problem or a Jigsaw problem?", a: "When Tradovate's own web and mobile platforms log in fine but Daytradr can't connect, it's almost always on the Daytradr side. Tradovate support has pointed traders to Jigsaw for exactly this, and Jigsaw has patched Tradovate connection and reconnect bugs across several Daytradr releases, which is why staying on the current build matters." },
  ], de: [
    { q: "Warum meldet Jigsaw Daytradr bei Tradovate „connection failed“?", a: "Die häufigste Ursache ist ein veralteter Daytradr-Build. Jigsaw hat einen Fehler behoben, bei dem Daytradr die Verbindung zu Tradovate nicht herstellen konnte; ein erneutes Herunterladen und Installieren des neuesten Builds löst das Problem daher für die meisten Nutzer. Die weiteren üblichen Verdächtigen sind der falsche Server (Live vs. Demo), falsche Zugangsdaten oder eine 2FA, die noch nicht freigegeben wurde." },
    { q: "Wo lade ich den neuesten Daytradr-Build herunter, bei Tradovate oder bei Jigsaw?", a: "Bei Jigsaw, nicht bei Tradovate. Melden Sie sich in Ihrem Jigsaw-Mitgliederportal an und laden Sie dort das aktuelle Daytradr-Installationsprogramm herunter. Tradovate hostet oder aktualisiert die Daytradr-App nicht, daher verweist dessen Support Sie bei Verbindungsfehlern auf der Daytradr-Seite an Jigsaw zurück." },
    { q: "Sollte ich Demo oder Live wählen, wenn ich meine Tradovate-Verbindung hinzufüge?", a: "Passen Sie den Server an das Konto an. Ein persönliches Live-Konto nutzt Live, ein kostenloses Simulationskonto nutzt Demo. Funded- und Evaluierungskonten sind der knifflige Teil, denn viele Prop Firms betreiben ihre Funded-Simulation innerhalb von Tradovate als „Live“. Wählen Sie die falsche Umgebung, schlägt die Anmeldung selbst mit korrektem Benutzernamen und Passwort fehl. Bestätigen Sie daher die genaue Umgebung bei Ihrer Firma." },
    { q: "Mein erster Verbindungsversuch schlägt direkt nach dem Aktivieren von 2FA fehl. Ist das normal?", a: "Ja. Wenn Sie die 2FA-Option für die Verbindung aktivieren, soll der erste Klick auf Connect absichtlich fehlschlagen, damit Tradovate die E-Mail zur Geräte-Freigabe sendet. Öffnen Sie diese E-Mail und geben Sie das Gerät frei, trennen Sie dann die Verbindung in Daytradr und verbinden Sie sich erneut. Der zweite Versuch sollte funktionieren." },
    { q: "Ich habe den neuesten Build neu installiert und es verbindet sich trotzdem nicht. Was nun?", a: "Beenden Sie Daytradr vollständig, trennen Sie alle Verbindungen, starten Sie die App neu und verbinden Sie sich erneut. Prüfen Sie Benutzernamen, Passwort und den Live/Demo-Server, geben Sie jede ausstehende 2FA-Geräte-E-Mail frei und stellen Sie sicher, dass Sie nicht an zu vielen Orten gleichzeitig im selben Tradovate-Konto angemeldet sind. Wechseln Sie zu einer stabilen Kabelverbindung und prüfen Sie, dass eine Firewall oder ein Virenschutz Daytradr nicht blockiert. Schlägt es weiterhin fehl, wenden Sie sich an den Jigsaw-Support, denn ein dauerhafter Verbindungsfehler auf Daytradr-Seite ist deren Sache." },
    { q: "Löscht eine Neuinstallation von Daytradr meine Layouts oder gespeicherten Verbindungen?", a: "Wenn Sie den neuesten Build über Ihre bestehende Version installieren, bleiben Ihre Workspaces und gespeicherten Verbindungen normalerweise erhalten. Notieren Sie sich dennoch vorab Ihren Tradovate-Benutzernamen und den verwendeten Server, damit Sie die Verbindung schnell neu eingeben können, falls etwas nicht übernommen wird." },
    { q: "Ist ein Verbindungsfehler bei Daytradr ein Problem von Tradovate oder von Jigsaw?", a: "Wenn sich die Web- und Mobilplattformen von Tradovate problemlos anmelden lassen, Daytradr aber keine Verbindung herstellen kann, liegt es fast immer auf Seiten von Daytradr. Der Tradovate-Support hat Trader genau dafür an Jigsaw verwiesen, und Jigsaw hat Verbindungs- und Wiederverbindungsfehler mit Tradovate in mehreren Daytradr-Releases behoben, weshalb es wichtig ist, auf dem aktuellen Build zu bleiben." },
  ], es: [
    { q: "¿Por qué Jigsaw Daytradr dice «connection failed» con Tradovate?", a: "La causa más común es una versión desactualizada de Daytradr. Jigsaw publicó una corrección para un defecto por el que Daytradr no podía establecer la conexión con Tradovate, así que volver a descargar e instalar la última versión lo resuelve para la mayoría de las personas. Los otros sospechosos habituales son el servidor equivocado (Live vs Demo), credenciales incorrectas o una 2FA que aún no se ha aprobado." },
    { q: "¿Dónde descargo la última versión de Daytradr, en Tradovate o en Jigsaw?", a: "En Jigsaw, no en Tradovate. Inicie sesión en su portal de miembros de Jigsaw y descargue allí el instalador actual de Daytradr. Tradovate no aloja ni actualiza la app Daytradr, así que su soporte le remitirá de nuevo a Jigsaw para los errores de conexión del lado de Daytradr." },
    { q: "¿Debo elegir Demo o Live al añadir mi conexión de Tradovate?", a: "Haga coincidir el servidor con la cuenta. Una cuenta real personal usa Live; una cuenta de simulación gratuita usa Demo. Las cuentas financiadas y de evaluación son la parte complicada, porque muchas prop firms ejecutan su simulación financiada como «Live» dentro de Tradovate. Si elige el entorno equivocado, el inicio de sesión falla incluso con el nombre de usuario y la contraseña correctos, así que confirme el entorno exacto con su firma." },
    { q: "Mi primer intento de conexión falla justo después de activar 2FA. ¿Es normal?", a: "Sí. Cuando activa la opción 2FA en la conexión, se espera que el primer clic en Connect falle a propósito para que Tradovate envíe el correo de aprobación del dispositivo. Abra ese correo y apruebe el dispositivo, luego desconecte y vuelva a conectar en Daytradr. El segundo intento debería funcionar." },
    { q: "Reinstalé la última versión y sigue sin conectar. ¿Qué hago ahora?", a: "Cierre Daytradr por completo, desconecte todo, reinicie la app y vuelva a conectar. Verifique de nuevo el nombre de usuario, la contraseña y el servidor Live/Demo, apruebe cualquier correo pendiente de dispositivo de 2FA y asegúrese de no tener la sesión iniciada en la misma cuenta de Tradovate en demasiados lugares a la vez. Cambie a una conexión por cable estable y confirme que un firewall o antivirus no bloquea Daytradr. Si sigue fallando, contacte con el soporte de Jigsaw, ya que un fallo de conexión persistente del lado de Daytradr les corresponde a ellos." },
    { q: "¿Reinstalar Daytradr elimina mis diseños o mis conexiones guardadas?", a: "Instalar la última versión sobre la existente normalmente conserva sus espacios de trabajo y conexiones guardadas. Aun así, anote su nombre de usuario de Tradovate y el servidor que usa antes de empezar, para poder volver a introducir la conexión rápidamente si algo no se conserva." },
    { q: "¿Un fallo de conexión de Daytradr es un problema de Tradovate o de Jigsaw?", a: "Cuando las plataformas web y móvil de Tradovate inician sesión sin problemas pero Daytradr no puede conectar, casi siempre es del lado de Daytradr. El soporte de Tradovate ha remitido a los traders a Jigsaw precisamente por esto, y Jigsaw ha corregido errores de conexión y reconexión con Tradovate en varias versiones de Daytradr, por lo que mantenerse en la versión actual es importante." },
  ], fr: [
    { q: "Pourquoi Jigsaw Daytradr affiche-t-il « connection failed » avec Tradovate ?", a: "La cause la plus courante est une version obsolète de Daytradr. Jigsaw a publié un correctif pour un défaut empêchant Daytradr d'établir la connexion avec Tradovate ; retélécharger et installer la dernière version règle donc le problème pour la plupart des utilisateurs. Les autres suspects habituels sont le mauvais serveur (Live ou Demo), des identifiants incorrects ou une 2FA qui n'a pas encore été approuvée." },
    { q: "Où télécharger la dernière version de Daytradr, chez Tradovate ou chez Jigsaw ?", a: "Chez Jigsaw, pas chez Tradovate. Connectez-vous à votre portail membres Jigsaw et téléchargez-y l'installateur actuel de Daytradr. Tradovate n'héberge ni ne met à jour l'application Daytradr ; son support vous renverra donc vers Jigsaw pour les bugs de connexion côté Daytradr." },
    { q: "Dois-je choisir Demo ou Live lorsque j'ajoute ma connexion Tradovate ?", a: "Faites correspondre le serveur au compte. Un compte réel personnel utilise Live ; un compte de simulation gratuit utilise Demo. Les comptes financés et d'évaluation sont la partie délicate, car de nombreuses prop firms exploitent leur simulation financée comme « Live » dans Tradovate. Si vous choisissez le mauvais environnement, la connexion échoue même avec un nom d'utilisateur et un mot de passe corrects ; confirmez donc l'environnement exact auprès de votre firme." },
    { q: "Ma première tentative de connexion échoue juste après l'activation de la 2FA. Est-ce normal ?", a: "Oui. Lorsque vous activez l'option 2FA sur la connexion, le premier clic sur Connect est censé échouer volontairement afin que Tradovate envoie l'e-mail d'approbation de l'appareil. Ouvrez cet e-mail et approuvez l'appareil, puis déconnectez-vous et reconnectez-vous dans Daytradr. La deuxième tentative devrait aboutir." },
    { q: "J'ai réinstallé la dernière version et cela ne se connecte toujours pas. Et maintenant ?", a: "Fermez complètement Daytradr, déconnectez tout, puis redémarrez l'application et reconnectez-vous. Vérifiez à nouveau le nom d'utilisateur, le mot de passe et le serveur Live/Demo, approuvez tout e-mail d'appareil 2FA en attente et assurez-vous de ne pas être connecté au même compte Tradovate à trop d'endroits à la fois. Passez à une connexion filaire stable et vérifiez qu'un pare-feu ou un antivirus ne bloque pas Daytradr. Si cela échoue encore, contactez le support Jigsaw, car un échec de connexion persistant côté Daytradr relève d'eux." },
    { q: "Réinstaller Daytradr supprime-t-il mes dispositions ou mes connexions enregistrées ?", a: "Installer la dernière version par-dessus votre version existante conserve normalement vos espaces de travail et vos connexions enregistrées. Notez néanmoins votre nom d'utilisateur Tradovate et le serveur que vous utilisez avant de commencer, afin de pouvoir ressaisir rapidement la connexion si quelque chose n'est pas conservé." },
    { q: "Un échec de connexion de Daytradr est-il un problème de Tradovate ou de Jigsaw ?", a: "Lorsque les plateformes web et mobile de Tradovate se connectent sans problème mais que Daytradr ne parvient pas à se connecter, cela vient presque toujours du côté de Daytradr. Le support de Tradovate a orienté des traders vers Jigsaw précisément pour cela, et Jigsaw a corrigé des bugs de connexion et de reconnexion à Tradovate sur plusieurs versions de Daytradr ; il est donc important de rester sur la version actuelle." },
  ], it: [
    { q: "Perché Jigsaw Daytradr dice «connection failed» con Tradovate?", a: "La causa più comune è una build obsoleta di Daytradr. Jigsaw ha rilasciato una correzione per un difetto per cui Daytradr non riusciva a stabilire la connessione con Tradovate, quindi riscaricare e installare l'ultima build risolve il problema per la maggior parte delle persone. Gli altri sospettati abituali sono il server sbagliato (Live o Demo), credenziali errate o una 2FA non ancora approvata." },
    { q: "Dove scarico l'ultima build di Daytradr, da Tradovate o da Jigsaw?", a: "Da Jigsaw, non da Tradovate. Acceda al portale membri di Jigsaw e scarichi lì l'installer attuale di Daytradr. Tradovate non ospita né aggiorna l'app Daytradr, quindi il suo supporto La rimanderà a Jigsaw per i bug di connessione lato Daytradr." },
    { q: "Devo scegliere Demo o Live quando aggiungo la mia connessione Tradovate?", a: "Faccia corrispondere il server all'account. Un conto reale personale usa Live; un conto di simulazione gratuito usa Demo. I conti finanziati e di valutazione sono la parte insidiosa, perché molte prop firm gestiscono la propria simulazione finanziata come «Live» all'interno di Tradovate. Se sceglie l'ambiente sbagliato, l'accesso fallisce anche con nome utente e password corretti, quindi confermi l'ambiente esatto con la Sua società." },
    { q: "Il mio primo tentativo di connessione fallisce subito dopo aver attivato la 2FA. È normale?", a: "Sì. Quando attiva l'opzione 2FA sulla connessione, è previsto che il primo clic su Connect fallisca di proposito, così Tradovate invia l'e-mail di approvazione del dispositivo. Apra quell'e-mail e approvi il dispositivo, poi si disconnetta e si riconnetta in Daytradr. Il secondo tentativo dovrebbe andare a buon fine." },
    { q: "Ho reinstallato l'ultima build e non si connette ancora. Che cosa faccio?", a: "Chiuda completamente Daytradr, disconnetta tutto, poi riavvii l'app e si riconnetta. Ricontrolli nome utente, password e server Live/Demo, approvi eventuali e-mail di dispositivo 2FA in sospeso e si assicuri di non essere connesso allo stesso account Tradovate in troppi posti contemporaneamente. Passi a una connessione cablata stabile e verifichi che un firewall o un antivirus non blocchi Daytradr. Se continua a fallire, contatti il supporto di Jigsaw, perché un errore di connessione persistente lato Daytradr spetta a loro." },
    { q: "Reinstallare Daytradr elimina i miei layout o le connessioni salvate?", a: "Installare l'ultima build sopra la versione esistente normalmente conserva i Suoi workspace e le connessioni salvate. Annoti comunque il Suo nome utente Tradovate e il server che usa prima di iniziare, in modo da poter reinserire rapidamente la connessione se qualcosa non viene mantenuto." },
    { q: "Un errore di connessione di Daytradr è un problema di Tradovate o di Jigsaw?", a: "Quando le piattaforme web e mobile di Tradovate si connettono senza problemi ma Daytradr non riesce a connettersi, quasi sempre il problema è lato Daytradr. Il supporto di Tradovate ha indirizzato i trader a Jigsaw proprio per questo, e Jigsaw ha corretto bug di connessione e riconnessione a Tradovate in diverse versioni di Daytradr, motivo per cui è importante restare sulla build attuale." },
  ] },
