---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "ios-white-screen-crash";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/debugging/${SLUG}`;

const META_TITLE = "Tradovate iOS App White Screen Then Crash";
const META_DESCRIPTION =
  "Tradovate iOS app stuck on a white screen then crashing after an update? Reinstall, update, and fall back to web so you never miss a futures fill.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Tradovate iOS-App: Weißer Bildschirm, dann Absturz", es: "App de Tradovate para iOS: pantalla blanca y luego cierre inesperado", fr: "Application Tradovate iOS : écran blanc puis plantage", it: "App Tradovate per iOS: schermata bianca e poi crash" },
  dek: { en: "The Tradovate iOS app flashes white and then crashes before it loads, usually right after an update. Here's why the startup breaks and how to get back into your account fast.", de: "Die Tradovate iOS-App blitzt weiß auf und stürzt dann ab, bevor sie lädt, meist direkt nach einem Update. Hier erfahren Sie, warum der Start scheitert und wie Sie schnell wieder in Ihr Konto kommen.", es: "La app de Tradovate para iOS parpadea en blanco y luego se cierra antes de cargar, normalmente justo después de una actualización. Le explicamos por qué falla el arranque y cómo volver rápido a su cuenta.", fr: "L'application Tradovate iOS clignote en blanc puis plante avant de se charger, généralement juste après une mise à jour. Voici pourquoi le démarrage échoue et comment retrouver rapidement votre compte.", it: "L'app Tradovate per iOS lampeggia di bianco e poi va in crash prima di caricarsi, di solito subito dopo un aggiornamento. Ecco perché l'avvio fallisce e come tornare rapidamente nel Suo account." },
  readTime: { en: "7 min read", de: "7 Min. Lesezeit", es: "Lectura de 7 min", fr: "Lecture : 7 min", it: "Lettura di 7 min" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "You tap the Tradovate icon on your iPhone, the screen flashes blank white for a second, and then the app slams shut before a single chart loads. When you're holding a live ES or NQ position, that half-second of dead white screen feels like an eternity, and you're locked out of your own account. This crash almost always shows up right after an app update, and it rarely hits just one trader at a time. Here's why it happens, how to recover fast, and how PickMyTrade keeps your automation running even when the phone app is down." },
    {
      type: "checklist",
      heading: "Quick Checklist for the Tradovate iOS Crash",
      items: [
        "<strong class='text-white'>Force-close the app first,</strong> swipe it away from the App Switcher and relaunch. A stale session is the fastest thing to rule out.",
        "<strong class='text-white'>Update the app,</strong> open the App Store and install any pending Tradovate update. Post-update crashes are frequently fixed by the <em>next</em> update.",
        "<strong class='text-white'>Delete and reinstall,</strong> a clean install clears the corrupted cache that a mid-update failure often leaves behind.",
        "<strong class='text-white'>Update iOS and free up storage,</strong> an out-of-date OS or a nearly full device makes apps crash on launch.",
        "<strong class='text-white'>Fall back to the web or desktop platform,</strong> log in through a browser so you can manage open positions while the phone app is broken.",
        "<strong class='text-white'>Watch for a hotfix and report it,</strong> if a fresh install still white-screens, the fix is on Tradovate's side. Report it and wait for the patched build.",
      ],
    },
    { type: "heading", text: "What \"White Screen Then Crashes\" Means" },
    { type: "paragraph", html: "The white flash you see is the app's web layer starting to load and then failing before it can render the trading interface. Tradovate's mobile apps wrap a web-based front end, so when the app launches it briefly paints a blank white canvas, then loads your session, charts, and order tickets on top of it. When something in that startup sequence breaks, a corrupted cache from an interrupted update, an incompatible app build, or a bad stored session, the app never gets past the white canvas and iOS force-quits it." },
    { type: "paragraph", html: "This is a startup crash, not an order rejection or a login error. Nothing is blocking you at the account level; there's no risk setting or bad password in play. The app simply can't finish loading its own interface. That distinction matters, because it points the fix at the <em>app installation and cache</em> rather than at your account." },
    { type: "paragraph", html: "It also tends to arrive in clusters right after an app update ships. When the white-screen-then-crash lands on the same day for a batch of traders, that's a strong signal the update itself introduced the bug, which is why the most reliable long-term fix is usually the follow-up build, not anything you change on your device." },
    { type: "heading", text: "Top Causes of the Tradovate iOS White Screen Crash" },
    { type: "heading", text: "1. A recent app update introduced the bug" },
    { type: "paragraph", html: "This is the most common trigger. The app works well until a recent update, and then it white-screens and crashes on every launch. When a shipped build has a startup defect, no amount of local troubleshooting fully fixes it until Tradovate releases a corrected version." },
    { type: "heading", text: "2. A corrupted cache from an interrupted update" },
    { type: "paragraph", html: "If the app was mid-update when your connection dropped, your phone rebooted, or storage ran out, the local app data can be left half-written. On the next launch the app tries to read that corrupted cache, fails, and crashes. This is the cause a delete-and-reinstall targets directly." },
    { type: "heading", text: "3. An outdated app or iOS version" },
    { type: "paragraph", html: "Running an old app build against Tradovate's current back end, or running an old version of iOS, can stop the front end from initializing. Apple ships frequent minor iOS patches specifically to fix bugs like apps crashing on open, so a device that's several versions behind is a real suspect." },
    { type: "heading", text: "4. Low device storage" },
    { type: "paragraph", html: "When your iPhone is nearly full, apps can crash, freeze, or fail to open because there's no room to write the cache and temporary files they need at launch. Freeing up space is a quick fix that's easy to overlook." },
    { type: "heading", text: "5. A back-end or session issue that also hits mobile web" },
    { type: "paragraph", html: "Sometimes the mobile web platform goes basically unusable at the same moment the app is crashing. When the app <em>and</em> mobile web degrade together, the root cause is on Tradovate's side rather than your specific installation, and the practical move is to switch to the desktop or full web platform." },
    { type: "heading", text: "How to Fix the Tradovate iOS White Screen Crash: Step-by-Step" },
    {
      type: "steps",
      items: [
        { title: "Fix a stale session (force-close first)", html: "From the iPhone home screen, swipe up from the bottom (or double-press Home on older devices) to open the App Switcher. Find the Tradovate card and swipe it up and off the screen to fully quit it. Wait a few seconds, then tap the Tradovate icon to relaunch. If it was just a stuck session, it now loads normally." },
        { title: "Fix an outdated build (update the app and iOS)", html: "Open the <strong class='text-white'>App Store</strong>, tap your profile icon, and scroll to pending updates, or search Tradovate and open the app's listing. If an <strong class='text-white'>Update</strong> button appears next to Tradovate, tap it and let the new build install completely before reopening. Separately, open <strong class='text-white'>Settings &rsaquo; General &rsaquo; Software Update</strong> and install any pending iOS update, since Apple's patches often resolve apps that crash on launch." },
        { title: "Fix a corrupted cache (delete and reinstall)", html: "Press and hold the Tradovate app icon on the home screen until the menu appears, then choose to remove or delete the app so its corrupted local data is wiped. Open the <strong class='text-white'>App Store</strong>, search Tradovate, and reinstall the fresh copy. Log back in. A clean install removes the half-written cache that an interrupted update leaves behind, the single most effective local fix for this crash." },
        { title: "Fix storage pressure", html: "Open <strong class='text-white'>Settings &rsaquo; General &rsaquo; iPhone Storage</strong> and check how much free space remains. Offload or delete apps, photos, or downloads until you have a comfortable buffer of free space. Reopen Tradovate. With room to write its cache, the app can complete its startup sequence." },
        { title: "Fix it when nothing local works (use web/desktop and wait for the hotfix)", html: "If a clean reinstall still white-screens, stop troubleshooting the phone, the defect is in the shipped build. Log in at the <strong class='text-white'>web platform in a browser</strong> (or the desktop app) so you can monitor and manage open positions right away. Report the crash to Tradovate support with your device and app version, then watch the App Store for the next update, which typically carries the fix." },
      ],
    },
    { type: "quote", html: "On Android, the equivalent step is to open the app's system settings and <em>clear cache and clear storage</em>, then relaunch. iOS doesn't expose a per-app &ldquo;clear cache&rdquo; button, so on iPhone the delete-and-reinstall step does the same job." },
    { type: "heading", text: "Troubleshooting Table" },
    {
      type: "table",
      headers: ["Symptom", "What it means", "Fix"],
      rows: [
        ["White screen then crashes on every launch", "App front end fails to initialize, usually post-update", "Update, then delete and reinstall the app"],
        ["Crash started right after an app update", "The shipped build has a startup defect", "Install the next update / hotfix; use web meanwhile"],
        ["Crashes only after an interrupted update", "Corrupted local cache", "Delete and reinstall for a clean copy"],
        ["App and mobile web both broken at once", "Back-end or session issue on Tradovate's side", "Switch to desktop/full web; report to support"],
        ["App crashes and iOS is several versions behind", "OS-level incompatibility or bug", "Update iOS via Settings &rsaquo; General &rsaquo; Software Update"],
        ["App crashes and storage is nearly full", "No room to write cache/temp files", "Free up device storage, then relaunch"],
      ],
    },
    { type: "heading", text: "Prevent This with PickMyTrade" },
    { type: "paragraph", html: "A phone app that white-screens at the worst possible moment shouldn't be the only thing standing between your strategy and the market. PickMyTrade links your TradingView alerts straight to your Tradovate account on the server side, so your entries, stops, and exits keep firing even when the iOS app won't open:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Server-side execution</strong>, your automation runs on PickMyTrade's infrastructure, not your phone, so a crashing app doesn't stall your strategy.",
        "<strong class='text-white'>Multi-account sync</strong>, mirror the same orders across every connected account without touching the mobile app.",
        "<strong class='text-white'>Reliable alert-to-order routing</strong>, TradingView signals reach Tradovate through a stable bridge instead of a fragile front end.",
        "<strong class='text-white'>Hands-off risk management</strong>, attach stops and targets automatically so open positions stay protected while you get the app working again.",
      ],
    },
  ], de: [
    { type: "paragraph",html: "Sie tippen auf das Tradovate-Symbol auf Ihrem iPhone, der Bildschirm blitzt eine Sekunde lang leer weiß auf, und dann schließt sich die App, bevor auch nur ein Chart geladen wurde. Wenn Sie eine laufende ES- oder NQ-Position halten, fühlt sich diese halbe Sekunde toter weißer Bildschirm wie eine Ewigkeit an, und Sie sind aus Ihrem eigenen Konto ausgesperrt. Dieser Absturz tritt fast immer direkt nach einem App-Update auf und betrifft selten nur einen einzelnen Trader. Hier erfahren Sie, warum das passiert, wie Sie sich schnell erholen und wie PickMyTrade Ihre Automatisierung weiterlaufen lässt, selbst wenn die Handy-App ausfällt." },
    {
      type: "checklist",
      heading: "Kurze Checkliste für den Absturz der Tradovate iOS-App",
      items: [
        "<strong class='text-white'>Beenden Sie die App zuerst zwangsweise,</strong> wischen Sie sie im App-Umschalter weg und starten Sie sie neu. Eine veraltete Sitzung lässt sich am schnellsten ausschließen.",
        "<strong class='text-white'>Aktualisieren Sie die App,</strong> öffnen Sie den App Store und installieren Sie jedes ausstehende Tradovate-Update. Abstürze nach einem Update werden häufig durch das <em>nächste</em> Update behoben.",
        "<strong class='text-white'>Löschen und neu installieren,</strong> eine saubere Installation beseitigt den beschädigten Cache, den ein Fehler mitten im Update oft hinterlässt.",
        "<strong class='text-white'>Aktualisieren Sie iOS und schaffen Sie Speicherplatz,</strong> ein veraltetes Betriebssystem oder ein fast volles Gerät lässt Apps beim Start abstürzen.",
        "<strong class='text-white'>Weichen Sie auf die Web- oder Desktop-Plattform aus,</strong> melden Sie sich über einen Browser an, um offene Positionen zu verwalten, solange die Handy-App defekt ist.",
        "<strong class='text-white'>Achten Sie auf einen Hotfix und melden Sie das Problem,</strong> wenn eine frische Installation weiterhin einen weißen Bildschirm zeigt, liegt die Lösung bei Tradovate. Melden Sie es und warten Sie auf den korrigierten Build.",
      ],
    },
    { type: "heading",text: "Was „Weißer Bildschirm, dann Absturz“ bedeutet" },
    { type: "paragraph",html: "Das weiße Aufblitzen ist die Web-Ebene der App, die zu laden beginnt und dann scheitert, bevor sie die Handelsoberfläche darstellen kann. Die mobilen Apps von Tradovate kapseln ein webbasiertes Frontend: Beim Start malt die App kurz eine leere weiße Fläche und lädt dann Ihre Sitzung, Charts und Order-Tickets darüber. Bricht in dieser Startabfolge etwas, ein beschädigter Cache nach einem unterbrochenen Update, ein inkompatibler App-Build oder eine fehlerhafte gespeicherte Sitzung, kommt die App nie über die weiße Fläche hinaus und iOS beendet sie zwangsweise." },
    { type: "paragraph",html: "Dies ist ein Absturz beim Start, keine Order-Ablehnung und kein Anmeldefehler. Auf Kontoebene blockiert Sie nichts; weder eine Risikoeinstellung noch ein falsches Passwort spielt eine Rolle. Die App kann ihre eigene Oberfläche schlicht nicht fertig laden. Diese Unterscheidung ist wichtig, denn sie richtet die Lösung auf die <em>App-Installation und den Cache</em> statt auf Ihr Konto." },
    { type: "paragraph",html: "Der Fehler tritt außerdem häufig gehäuft direkt nach der Auslieferung eines App-Updates auf. Wenn der Absturz mit weißem Bildschirm am selben Tag bei einer ganzen Gruppe von Tradern auftritt, ist das ein starkes Zeichen dafür, dass das Update selbst den Fehler eingeführt hat. Deshalb ist die zuverlässigste langfristige Lösung meist der Folge-Build und nicht etwas, das Sie auf Ihrem Gerät ändern." },
    { type: "heading",text: "Die häufigsten Ursachen für den Absturz der Tradovate iOS-App mit weißem Bildschirm" },
    { type: "heading",text: "1. Ein aktuelles App-Update hat den Fehler eingeführt" },
    { type: "paragraph",html: "Das ist der häufigste Auslöser. Die App funktioniert gut bis zu einem aktuellen Update, danach zeigt sie bei jedem Start einen weißen Bildschirm und stürzt ab. Hat ein ausgelieferter Build einen Startfehler, behebt keine lokale Fehlersuche ihn vollständig, bis Tradovate eine korrigierte Version veröffentlicht." },
    { type: "heading",text: "2. Ein beschädigter Cache nach einem unterbrochenen Update" },
    { type: "paragraph",html: "Wenn die App mitten im Update war, als Ihre Verbindung abbrach, Ihr Handy neu startete oder der Speicher ausging, können die lokalen App-Daten halb geschrieben zurückbleiben. Beim nächsten Start versucht die App, diesen beschädigten Cache zu lesen, scheitert und stürzt ab. Genau diese Ursache adressiert ein Löschen und Neuinstallieren." },
    { type: "heading",text: "3. Eine veraltete App- oder iOS-Version" },
    { type: "paragraph",html: "Ein alter App-Build gegenüber dem aktuellen Backend von Tradovate oder eine alte iOS-Version kann verhindern, dass das Frontend initialisiert wird. Apple liefert häufig kleinere iOS-Patches gezielt zur Behebung von Fehlern wie Apps, die beim Öffnen abstürzen, daher ist ein Gerät, das mehrere Versionen zurückliegt, ein echter Verdächtiger." },
    { type: "heading",text: "4. Zu wenig Gerätespeicher" },
    { type: "paragraph",html: "Wenn Ihr iPhone fast voll ist, können Apps abstürzen, einfrieren oder sich nicht öffnen lassen, weil kein Platz für den Cache und die temporären Dateien vorhanden ist, die sie beim Start benötigen. Speicherplatz freizugeben ist eine schnelle Lösung, die leicht übersehen wird." },
    { type: "heading",text: "5. Ein Backend- oder Sitzungsproblem, das auch das mobile Web betrifft" },
    { type: "paragraph",html: "Manchmal wird die mobile Webplattform im selben Moment praktisch unbenutzbar, in dem die App abstürzt. Wenn sich die App <em>und</em> das mobile Web gemeinsam verschlechtern, liegt die Ursache auf Seiten von Tradovate und nicht bei Ihrer konkreten Installation, und der praktische Schritt ist der Wechsel zur Desktop- oder vollständigen Webplattform." },
    { type: "heading",text: "So beheben Sie den Absturz der Tradovate iOS-App mit weißem Bildschirm: Schritt für Schritt" },
    {
      type: "steps",
      items: [
        { title: "Veraltete Sitzung beheben (zuerst zwangsweise beenden)", html: "Wischen Sie auf dem iPhone-Home-Bildschirm vom unteren Rand nach oben (bzw. drücken Sie bei älteren Geräten zweimal die Home-Taste), um den App-Umschalter zu öffnen. Suchen Sie die Tradovate-Karte und wischen Sie sie nach oben vom Bildschirm, um sie vollständig zu beenden. Warten Sie einige Sekunden und tippen Sie dann auf das Tradovate-Symbol, um die App neu zu starten. War es nur eine hängende Sitzung, lädt sie jetzt normal." },
        { title: "Veralteten Build beheben (App und iOS aktualisieren)", html: "Öffnen Sie den <strong class='text-white'>App Store</strong>, tippen Sie auf Ihr Profilsymbol und scrollen Sie zu den ausstehenden Updates, oder suchen Sie nach Tradovate und öffnen Sie den Eintrag der App. Erscheint neben Tradovate eine Schaltfläche <strong class='text-white'>Update</strong>, tippen Sie darauf und lassen Sie den neuen Build vollständig installieren, bevor Sie die App wieder öffnen. Öffnen Sie außerdem <strong class='text-white'>Settings &rsaquo; General &rsaquo; Software Update</strong> und installieren Sie jedes ausstehende iOS-Update, da Apples Patches Apps, die beim Start abstürzen, oft beheben." },
        { title: "Beschädigten Cache beheben (löschen und neu installieren)", html: "Halten Sie das Tradovate-App-Symbol auf dem Home-Bildschirm gedrückt, bis das Menü erscheint, und wählen Sie dann, die App zu entfernen bzw. zu löschen, damit ihre beschädigten lokalen Daten entfernt werden. Öffnen Sie den <strong class='text-white'>App Store</strong>, suchen Sie nach Tradovate und installieren Sie die frische Kopie neu. Melden Sie sich wieder an. Eine saubere Installation entfernt den halb geschriebenen Cache, den ein unterbrochenes Update hinterlässt, die wirksamste lokale Lösung für diesen Absturz." },
        { title: "Speicherdruck beheben", html: "Öffnen Sie <strong class='text-white'>Settings &rsaquo; General &rsaquo; iPhone Storage</strong> und prüfen Sie, wie viel freier Speicher übrig ist. Lagern Sie Apps aus oder löschen Sie Apps, Fotos oder Downloads, bis Sie einen komfortablen Puffer an freiem Speicher haben. Öffnen Sie Tradovate erneut. Mit Platz zum Schreiben seines Caches kann die App ihre Startabfolge abschließen." },
        { title: "Beheben, wenn lokal nichts hilft (Web/Desktop nutzen und auf den Hotfix warten)", html: "Zeigt eine saubere Neuinstallation weiterhin einen weißen Bildschirm, hören Sie auf, das Handy zu untersuchen, der Fehler steckt im ausgelieferten Build. Melden Sie sich auf der <strong class='text-white'>Webplattform im Browser</strong> (oder in der Desktop-App) an, um offene Positionen sofort zu überwachen und zu verwalten. Melden Sie den Absturz dem Tradovate-Support mit Ihrem Gerät und der App-Version und achten Sie dann im App Store auf das nächste Update, das in der Regel die Lösung enthält." },
      ],
    },
    { type: "quote",html: "Unter Android besteht der entsprechende Schritt darin, die Systemeinstellungen der App zu öffnen und <em>Cache zu leeren und Speicher zu leeren</em>, dann neu zu starten. iOS bietet keine App-spezifische Schaltfläche &ldquo;Cache leeren&rdquo;, daher erledigt auf dem iPhone der Schritt Löschen und Neuinstallieren dieselbe Aufgabe." },
    { type: "heading",text: "Tabelle zur Fehlerbehebung" },
    { type: "table", headers: ["Symptom","Was es bedeutet","Lösung"], rows: [
      ["Weißer Bildschirm, dann Absturz bei jedem Start","Frontend der App lässt sich nicht initialisieren, meist nach einem Update","Aktualisieren, dann App löschen und neu installieren"],
      ["Absturz begann direkt nach einem App-Update","Der ausgelieferte Build hat einen Startfehler","Nächstes Update / Hotfix installieren; währenddessen das Web nutzen"],
      ["Abstürze nur nach einem unterbrochenen Update","Beschädigter lokaler Cache","Löschen und für eine saubere Kopie neu installieren"],
      ["App und mobiles Web gleichzeitig defekt","Backend- oder Sitzungsproblem auf Seiten von Tradovate","Zu Desktop/vollständigem Web wechseln; dem Support melden"],
      ["App stürzt ab und iOS liegt mehrere Versionen zurück","Inkompatibilität oder Fehler auf Betriebssystemebene","iOS über Settings &rsaquo; General &rsaquo; Software Update aktualisieren"],
      ["App stürzt ab und der Speicher ist fast voll","Kein Platz zum Schreiben von Cache-/temporären Dateien","Gerätespeicher freigeben, dann neu starten"],
    ] },
    { type: "heading",text: "Vorbeugen mit PickMyTrade" },
    { type: "paragraph",html: "Eine Handy-App, die im ungünstigsten Moment einen weißen Bildschirm zeigt, sollte nicht das Einzige sein, was zwischen Ihrer Strategie und dem Markt steht. PickMyTrade verbindet Ihre TradingView-Alerts serverseitig direkt mit Ihrem Tradovate-Konto, sodass Ihre Einstiege, Stopps und Ausstiege weiter ausgeführt werden, selbst wenn sich die iOS-App nicht öffnen lässt:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Serverseitige Ausführung</strong>, Ihre Automatisierung läuft auf der Infrastruktur von PickMyTrade und nicht auf Ihrem Handy, sodass eine abstürzende App Ihre Strategie nicht blockiert.",
        "<strong class='text-white'>Multi-Konto-Synchronisierung</strong>, spiegeln Sie dieselben Orders auf alle verbundenen Konten, ohne die mobile App anzufassen.",
        "<strong class='text-white'>Zuverlässiges Alert-zu-Order-Routing</strong>, TradingView-Signale erreichen Tradovate über eine stabile Brücke statt über ein fragiles Frontend.",
        "<strong class='text-white'>Automatisches Risikomanagement</strong>, hängen Sie Stopps und Ziele automatisch an, damit offene Positionen geschützt bleiben, während Sie die App wieder zum Laufen bringen.",
      ],
    },
  ], es: [
    { type: "paragraph",html: "Toca el icono de Tradovate en su iPhone, la pantalla parpadea en blanco durante un segundo y luego la app se cierra antes de que cargue un solo gráfico. Cuando mantiene una posición abierta en ES o NQ, ese medio segundo de pantalla blanca muerta parece una eternidad y queda fuera de su propia cuenta. Este fallo casi siempre aparece justo después de una actualización de la app y rara vez afecta a un solo trader. Le explicamos por qué ocurre, cómo recuperarse rápido y cómo PickMyTrade mantiene su automatización en marcha incluso cuando la app del teléfono está caída." },
    {
      type: "checklist",
      heading: "Lista de comprobación rápida para el cierre de Tradovate en iOS",
      items: [
        "<strong class='text-white'>Fuerce primero el cierre de la app,</strong> deslícela fuera del selector de apps y vuelva a abrirla. Una sesión obsoleta es lo más rápido de descartar.",
        "<strong class='text-white'>Actualice la app,</strong> abra la App Store e instale cualquier actualización pendiente de Tradovate. Los cierres posteriores a una actualización suelen corregirse con la <em>siguiente</em> actualización.",
        "<strong class='text-white'>Elimine y reinstale,</strong> una instalación limpia borra la caché corrupta que suele dejar un fallo a mitad de actualización.",
        "<strong class='text-white'>Actualice iOS y libere almacenamiento,</strong> un sistema operativo desactualizado o un dispositivo casi lleno hace que las apps se cierren al iniciarse.",
        "<strong class='text-white'>Recurra a la plataforma web o de escritorio,</strong> inicie sesión desde un navegador para gestionar las posiciones abiertas mientras la app del teléfono no funciona.",
        "<strong class='text-white'>Esté atento a una corrección e infórmelo,</strong> si una instalación nueva sigue mostrando pantalla blanca, la solución está en el lado de Tradovate. Infórmelo y espere la versión corregida.",
      ],
    },
    { type: "heading",text: "Qué significa «pantalla blanca y luego cierre inesperado»" },
    { type: "paragraph",html: "El destello blanco que ve es la capa web de la app que empieza a cargarse y falla antes de poder mostrar la interfaz de trading. Las apps móviles de Tradovate envuelven una interfaz web, así que al iniciarse la app pinta brevemente un lienzo blanco en blanco y luego carga encima su sesión, sus gráficos y sus tickets de órdenes. Cuando algo en esa secuencia de arranque falla, una caché corrupta por una actualización interrumpida, una versión incompatible de la app o una sesión almacenada defectuosa, la app nunca pasa del lienzo blanco e iOS fuerza su cierre." },
    { type: "paragraph",html: "Se trata de un fallo de arranque, no de un rechazo de órdenes ni de un error de inicio de sesión. Nada le bloquea a nivel de cuenta; no hay ningún ajuste de riesgo ni contraseña incorrecta en juego. La app simplemente no puede terminar de cargar su propia interfaz. Esa distinción importa, porque dirige la solución hacia la <em>instalación y la caché de la app</em> y no hacia su cuenta." },
    { type: "paragraph",html: "Además, tiende a aparecer en oleadas justo después de que se publica una actualización de la app. Cuando la pantalla blanca con cierre aparece el mismo día en un grupo de traders, es una señal clara de que la propia actualización introdujo el error, por lo que la solución más fiable a largo plazo suele ser la versión siguiente y no algo que usted cambie en su dispositivo." },
    { type: "heading",text: "Principales causas del cierre de Tradovate en iOS con pantalla blanca" },
    { type: "heading",text: "1. Una actualización reciente de la app introdujo el error" },
    { type: "paragraph",html: "Es el desencadenante más común. La app funciona bien hasta una actualización reciente y después muestra pantalla blanca y se cierra en cada inicio. Cuando una versión publicada tiene un defecto de arranque, ninguna solución local lo arregla por completo hasta que Tradovate publica una versión corregida." },
    { type: "heading",text: "2. Una caché corrupta por una actualización interrumpida" },
    { type: "paragraph",html: "Si la app estaba a mitad de actualización cuando se cayó su conexión, su teléfono se reinició o se agotó el almacenamiento, los datos locales de la app pueden quedar escritos a medias. En el siguiente inicio, la app intenta leer esa caché corrupta, falla y se cierra. Esta es la causa a la que apunta directamente eliminar y reinstalar." },
    { type: "heading",text: "3. Una versión desactualizada de la app o de iOS" },
    { type: "paragraph",html: "Ejecutar una versión antigua de la app contra el backend actual de Tradovate, o una versión antigua de iOS, puede impedir que la interfaz se inicialice. Apple publica con frecuencia parches menores de iOS precisamente para corregir fallos como apps que se cierran al abrirse, así que un dispositivo con varias versiones de retraso es un sospechoso real." },
    { type: "heading",text: "4. Poco almacenamiento en el dispositivo" },
    { type: "paragraph",html: "Cuando su iPhone está casi lleno, las apps pueden cerrarse, congelarse o no abrirse porque no hay espacio para escribir la caché y los archivos temporales que necesitan al iniciarse. Liberar espacio es una solución rápida que es fácil pasar por alto." },
    { type: "heading",text: "5. Un problema de backend o de sesión que también afecta a la web móvil" },
    { type: "paragraph",html: "A veces la plataforma web móvil queda prácticamente inutilizable en el mismo momento en que la app se cierra. Cuando la app <em>y</em> la web móvil se degradan a la vez, la causa raíz está en el lado de Tradovate y no en su instalación concreta, y lo práctico es cambiar a la plataforma de escritorio o a la web completa." },
    { type: "heading",text: "Cómo solucionar el cierre de Tradovate en iOS con pantalla blanca: paso a paso" },
    {
      type: "steps",
      items: [
        { title: "Solucionar una sesión obsoleta (forzar primero el cierre)", html: "Desde la pantalla de inicio del iPhone, deslice hacia arriba desde el borde inferior (o pulse dos veces el botón de inicio en dispositivos antiguos) para abrir el selector de apps. Busque la tarjeta de Tradovate y deslícela hacia arriba fuera de la pantalla para cerrarla por completo. Espere unos segundos y toque el icono de Tradovate para volver a abrirla. Si solo era una sesión bloqueada, ahora carga con normalidad." },
        { title: "Solucionar una versión obsoleta (actualizar la app e iOS)", html: "Abra la <strong class='text-white'>App Store</strong>, toque el icono de su perfil y desplácese hasta las actualizaciones pendientes, o busque Tradovate y abra la ficha de la app. Si aparece un botón <strong class='text-white'>Update</strong> junto a Tradovate, tóquelo y deje que la nueva versión se instale por completo antes de volver a abrir. Por separado, abra <strong class='text-white'>Settings &rsaquo; General &rsaquo; Software Update</strong> e instale cualquier actualización pendiente de iOS, ya que los parches de Apple suelen resolver las apps que se cierran al iniciarse." },
        { title: "Solucionar una caché corrupta (eliminar y reinstalar)", html: "Mantenga pulsado el icono de la app de Tradovate en la pantalla de inicio hasta que aparezca el menú y luego elija quitar o eliminar la app para borrar sus datos locales corruptos. Abra la <strong class='text-white'>App Store</strong>, busque Tradovate y reinstale la copia nueva. Vuelva a iniciar sesión. Una instalación limpia elimina la caché escrita a medias que deja una actualización interrumpida, la solución local más eficaz para este fallo." },
        { title: "Solucionar la falta de almacenamiento", html: "Abra <strong class='text-white'>Settings &rsaquo; General &rsaquo; iPhone Storage</strong> y compruebe cuánto espacio libre queda. Descargue o elimine apps, fotos o descargas hasta tener un margen cómodo de espacio libre. Vuelva a abrir Tradovate. Con espacio para escribir su caché, la app puede completar su secuencia de arranque." },
        { title: "Solucionarlo cuando nada local funciona (usar web/escritorio y esperar la corrección)", html: "Si una reinstalación limpia sigue mostrando pantalla blanca, deje de depurar el teléfono: el defecto está en la versión publicada. Inicie sesión en la <strong class='text-white'>plataforma web en un navegador</strong> (o en la app de escritorio) para supervisar y gestionar de inmediato las posiciones abiertas. Informe del fallo al soporte de Tradovate con su dispositivo y la versión de la app y luego esté atento en la App Store a la siguiente actualización, que normalmente incluye la corrección." },
      ],
    },
    { type: "quote",html: "En Android, el paso equivalente es abrir los ajustes del sistema de la app y <em>borrar la caché y borrar el almacenamiento</em>, y luego volver a abrirla. iOS no ofrece un botón de &ldquo;borrar caché&rdquo; por app, así que en iPhone el paso de eliminar y reinstalar cumple la misma función." },
    { type: "heading",text: "Tabla de solución de problemas" },
    { type: "table", headers: ["Síntoma","Qué significa","Solución"], rows: [
      ["Pantalla blanca y cierre en cada inicio","La interfaz de la app no se inicializa, normalmente tras una actualización","Actualizar, y luego eliminar y reinstalar la app"],
      ["El fallo empezó justo después de una actualización de la app","La versión publicada tiene un defecto de arranque","Instalar la siguiente actualización / corrección; usar la web mientras tanto"],
      ["Se cierra solo tras una actualización interrumpida","Caché local corrupta","Eliminar y reinstalar para obtener una copia limpia"],
      ["La app y la web móvil fallan a la vez","Problema de backend o de sesión en el lado de Tradovate","Cambiar a escritorio/web completa; informar al soporte"],
      ["La app se cierra e iOS va varias versiones por detrás","Incompatibilidad o error a nivel del sistema operativo","Actualizar iOS en Settings &rsaquo; General &rsaquo; Software Update"],
      ["La app se cierra y el almacenamiento está casi lleno","No hay espacio para escribir caché/archivos temporales","Liberar almacenamiento del dispositivo y volver a abrir"],
    ] },
    { type: "heading",text: "Evítelo con PickMyTrade" },
    { type: "paragraph",html: "Una app de teléfono que muestra pantalla blanca en el peor momento posible no debería ser lo único que se interponga entre su estrategia y el mercado. PickMyTrade conecta sus alertas de TradingView directamente con su cuenta de Tradovate desde el servidor, para que sus entradas, stops y salidas se sigan ejecutando incluso cuando la app de iOS no se abre:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Ejecución del lado del servidor</strong>, su automatización se ejecuta en la infraestructura de PickMyTrade y no en su teléfono, de modo que una app que se cierra no paraliza su estrategia.",
        "<strong class='text-white'>Sincronización multicuenta</strong>, replique las mismas órdenes en todas las cuentas conectadas sin tocar la app móvil.",
        "<strong class='text-white'>Enrutamiento fiable de alertas a órdenes</strong>, las señales de TradingView llegan a Tradovate a través de un puente estable en lugar de una interfaz frágil.",
        "<strong class='text-white'>Gestión de riesgo automática</strong>, adjunte stops y objetivos automáticamente para que las posiciones abiertas sigan protegidas mientras vuelve a poner la app en marcha.",
      ],
    },
  ], fr: [
    { type: "paragraph",html: "Vous touchez l'icône Tradovate sur votre iPhone, l'écran clignote en blanc pendant une seconde, puis l'application se ferme avant qu'un seul graphique ne se charge. Lorsque vous détenez une position ES ou NQ en cours, cette demi-seconde d'écran blanc mort paraît une éternité, et vous êtes exclu de votre propre compte. Ce plantage survient presque toujours juste après une mise à jour de l'application et touche rarement un seul trader. Voici pourquoi cela se produit, comment récupérer vite et comment PickMyTrade maintient votre automatisation en marche même lorsque l'application du téléphone est hors service." },
    {
      type: "checklist",
      heading: "Liste de vérification rapide pour le plantage de Tradovate sur iOS",
      items: [
        "<strong class='text-white'>Forcez d'abord la fermeture de l'application,</strong> faites-la glisser hors du sélecteur d'apps et relancez-la. Une session périmée est la chose la plus rapide à écarter.",
        "<strong class='text-white'>Mettez l'application à jour,</strong> ouvrez l'App Store et installez toute mise à jour Tradovate en attente. Les plantages survenant après une mise à jour sont souvent corrigés par la mise à jour <em>suivante</em>.",
        "<strong class='text-white'>Supprimez et réinstallez,</strong> une installation propre efface le cache corrompu que laisse souvent un échec en pleine mise à jour.",
        "<strong class='text-white'>Mettez à jour iOS et libérez de l'espace de stockage,</strong> un système obsolète ou un appareil presque plein fait planter les applications au lancement.",
        "<strong class='text-white'>Repliez-vous sur la plateforme web ou de bureau,</strong> connectez-vous via un navigateur pour gérer vos positions ouvertes pendant que l'application du téléphone est hors service.",
        "<strong class='text-white'>Surveillez un correctif et signalez le problème,</strong> si une installation neuve affiche toujours un écran blanc, la solution se trouve du côté de Tradovate. Signalez-le et attendez la version corrigée.",
      ],
    },
    { type: "heading",text: "Ce que signifie « écran blanc puis plantage »" },
    { type: "paragraph",html: "Le flash blanc que vous voyez est la couche web de l'application qui commence à se charger puis échoue avant de pouvoir afficher l'interface de trading. Les applications mobiles de Tradovate encapsulent une interface web : au lancement, l'application affiche brièvement un canevas blanc vide, puis charge par-dessus votre session, vos graphiques et vos tickets d'ordre. Lorsque quelque chose se brise dans cette séquence de démarrage, un cache corrompu par une mise à jour interrompue, une version d'application incompatible ou une session enregistrée défectueuse, l'application ne dépasse jamais le canevas blanc et iOS la ferme de force." },
    { type: "paragraph",html: "Il s'agit d'un plantage au démarrage, pas d'un rejet d'ordre ni d'une erreur de connexion. Rien ne vous bloque au niveau du compte ; aucun paramètre de risque ni mot de passe erroné n'est en cause. L'application ne parvient simplement pas à finir de charger sa propre interface. Cette distinction compte, car elle oriente la solution vers <em>l'installation et le cache de l'application</em> plutôt que vers votre compte." },
    { type: "paragraph",html: "Il a aussi tendance à arriver par grappes juste après la publication d'une mise à jour de l'application. Lorsque l'écran blanc suivi d'un plantage touche le même jour tout un groupe de traders, c'est un signal fort que la mise à jour elle-même a introduit le bug ; c'est pourquoi la solution la plus fiable à long terme est généralement la version suivante, et non quelque chose que vous modifiez sur votre appareil." },
    { type: "heading",text: "Principales causes du plantage de Tradovate sur iOS avec écran blanc" },
    { type: "heading",text: "1. Une mise à jour récente de l'application a introduit le bug" },
    { type: "paragraph",html: "C'est le déclencheur le plus courant. L'application fonctionne bien jusqu'à une mise à jour récente, puis elle affiche un écran blanc et plante à chaque lancement. Lorsqu'une version publiée présente un défaut de démarrage, aucun dépannage local ne le corrige complètement tant que Tradovate n'a pas publié une version corrigée." },
    { type: "heading",text: "2. Un cache corrompu par une mise à jour interrompue" },
    { type: "paragraph",html: "Si l'application était en pleine mise à jour lorsque votre connexion a coupé, que votre téléphone a redémarré ou que le stockage s'est épuisé, les données locales de l'application peuvent rester à moitié écrites. Au lancement suivant, l'application tente de lire ce cache corrompu, échoue et plante. C'est la cause que cible directement la suppression suivie de la réinstallation." },
    { type: "heading",text: "3. Une version obsolète de l'application ou d'iOS" },
    { type: "paragraph",html: "Faire tourner une ancienne version de l'application face au back-end actuel de Tradovate, ou une ancienne version d'iOS, peut empêcher l'interface de s'initialiser. Apple publie fréquemment des correctifs iOS mineurs précisément pour corriger des bugs comme les applications qui plantent à l'ouverture ; un appareil en retard de plusieurs versions est donc un suspect sérieux." },
    { type: "heading",text: "4. Espace de stockage de l'appareil insuffisant" },
    { type: "paragraph",html: "Lorsque votre iPhone est presque plein, les applications peuvent planter, se figer ou ne pas s'ouvrir faute de place pour écrire le cache et les fichiers temporaires dont elles ont besoin au lancement. Libérer de l'espace est une solution rapide que l'on oublie facilement." },
    { type: "heading",text: "5. Un problème de back-end ou de session qui touche aussi le web mobile" },
    { type: "paragraph",html: "Parfois, la plateforme web mobile devient pratiquement inutilisable au moment même où l'application plante. Lorsque l'application <em>et</em> le web mobile se dégradent ensemble, la cause racine se trouve du côté de Tradovate plutôt que dans votre installation, et la démarche pratique est de passer à la plateforme de bureau ou à la plateforme web complète." },
    { type: "heading",text: "Comment corriger le plantage de Tradovate sur iOS avec écran blanc : étape par étape" },
    {
      type: "steps",
      items: [
        { title: "Corriger une session périmée (forcer d'abord la fermeture)", html: "Depuis l'écran d'accueil de l'iPhone, balayez vers le haut depuis le bas de l'écran (ou appuyez deux fois sur le bouton principal sur les appareils plus anciens) pour ouvrir le sélecteur d'apps. Repérez la carte Tradovate et faites-la glisser vers le haut hors de l'écran pour la quitter complètement. Patientez quelques secondes, puis touchez l'icône Tradovate pour relancer l'application. S'il ne s'agissait que d'une session bloquée, elle se charge maintenant normalement." },
        { title: "Corriger une version obsolète (mettre à jour l'application et iOS)", html: "Ouvrez l'<strong class='text-white'>App Store</strong>, touchez l'icône de votre profil et faites défiler jusqu'aux mises à jour en attente, ou recherchez Tradovate et ouvrez la fiche de l'application. Si un bouton <strong class='text-white'>Update</strong> apparaît à côté de Tradovate, touchez-le et laissez la nouvelle version s'installer complètement avant de rouvrir. Par ailleurs, ouvrez <strong class='text-white'>Settings &rsaquo; General &rsaquo; Software Update</strong> et installez toute mise à jour iOS en attente, car les correctifs d'Apple résolvent souvent les applications qui plantent au lancement." },
        { title: "Corriger un cache corrompu (supprimer et réinstaller)", html: "Maintenez l'icône de l'application Tradovate sur l'écran d'accueil jusqu'à l'apparition du menu, puis choisissez de retirer ou de supprimer l'application afin d'effacer ses données locales corrompues. Ouvrez l'<strong class='text-white'>App Store</strong>, recherchez Tradovate et réinstallez la copie neuve. Reconnectez-vous. Une installation propre supprime le cache à moitié écrit que laisse une mise à jour interrompue, la solution locale la plus efficace contre ce plantage." },
        { title: "Corriger la pression sur le stockage", html: "Ouvrez <strong class='text-white'>Settings &rsaquo; General &rsaquo; iPhone Storage</strong> et vérifiez combien d'espace libre il reste. Déchargez ou supprimez des applications, des photos ou des téléchargements jusqu'à disposer d'une marge confortable d'espace libre. Rouvrez Tradovate. Avec de la place pour écrire son cache, l'application peut terminer sa séquence de démarrage." },
        { title: "Corriger le cas où rien de local ne fonctionne (utiliser le web/bureau et attendre le correctif)", html: "Si une réinstallation propre affiche toujours un écran blanc, arrêtez de dépanner le téléphone : le défaut se trouve dans la version publiée. Connectez-vous à la <strong class='text-white'>plateforme web dans un navigateur</strong> (ou à l'application de bureau) afin de surveiller et gérer immédiatement vos positions ouvertes. Signalez le plantage au support Tradovate en indiquant votre appareil et la version de l'application, puis surveillez l'App Store pour la prochaine mise à jour, qui contient généralement le correctif." },
      ],
    },
    { type: "quote",html: "Sur Android, l'étape équivalente consiste à ouvrir les paramètres système de l'application et à <em>vider le cache puis vider le stockage</em>, puis à relancer. iOS n'expose pas de bouton &ldquo;vider le cache&rdquo; par application ; sur iPhone, l'étape de suppression et de réinstallation remplit donc la même fonction." },
    { type: "heading",text: "Tableau de dépannage" },
    { type: "table", headers: ["Symptôme","Ce que cela signifie","Solution"], rows: [
      ["Écran blanc puis plantage à chaque lancement","L'interface de l'application ne s'initialise pas, généralement après une mise à jour","Mettre à jour, puis supprimer et réinstaller l'application"],
      ["Le plantage a commencé juste après une mise à jour de l'application","La version publiée présente un défaut de démarrage","Installer la prochaine mise à jour / le correctif ; utiliser le web entre-temps"],
      ["Plante seulement après une mise à jour interrompue","Cache local corrompu","Supprimer et réinstaller pour obtenir une copie propre"],
      ["Application et web mobile en panne en même temps","Problème de back-end ou de session du côté de Tradovate","Passer au bureau/web complet ; signaler au support"],
      ["L'application plante et iOS a plusieurs versions de retard","Incompatibilité ou bug au niveau du système","Mettre à jour iOS via Settings &rsaquo; General &rsaquo; Software Update"],
      ["L'application plante et le stockage est presque plein","Pas de place pour écrire le cache/les fichiers temporaires","Libérer de l'espace de stockage, puis relancer"],
    ] },
    { type: "heading",text: "Évitez cela avec PickMyTrade" },
    { type: "paragraph",html: "Une application de téléphone qui affiche un écran blanc au pire moment ne devrait pas être la seule chose qui se dresse entre votre stratégie et le marché. PickMyTrade relie vos alertes TradingView directement à votre compte Tradovate côté serveur, afin que vos entrées, vos stops et vos sorties continuent de s'exécuter même lorsque l'application iOS ne s'ouvre pas :" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Exécution côté serveur</strong>, votre automatisation s'exécute sur l'infrastructure de PickMyTrade et non sur votre téléphone, de sorte qu'une application qui plante ne bloque pas votre stratégie.",
        "<strong class='text-white'>Synchronisation multi-comptes</strong>, répliquez les mêmes ordres sur tous les comptes connectés sans toucher à l'application mobile.",
        "<strong class='text-white'>Acheminement fiable des alertes vers les ordres</strong>, les signaux TradingView atteignent Tradovate via un pont stable plutôt qu'une interface fragile.",
        "<strong class='text-white'>Gestion du risque automatique</strong>, associez automatiquement des stops et des objectifs afin que les positions ouvertes restent protégées pendant que vous remettez l'application en état.",
      ],
    },
  ], it: [
    { type: "paragraph",html: "Tocca l'icona di Tradovate sul Suo iPhone, lo schermo lampeggia di bianco per un secondo e poi l'app si chiude prima che si carichi un solo grafico. Quando detiene una posizione ES o NQ aperta, quel mezzo secondo di schermata bianca morta sembra un'eternità e Lei resta escluso dal proprio account. Questo crash compare quasi sempre subito dopo un aggiornamento dell'app e raramente colpisce un solo trader alla volta. Ecco perché succede, come riprendersi in fretta e come PickMyTrade mantiene attiva la Sua automazione anche quando l'app del telefono è fuori uso." },
    {
      type: "checklist",
      heading: "Checklist rapida per il crash di Tradovate su iOS",
      items: [
        "<strong class='text-white'>Forzi prima la chiusura dell'app,</strong> la faccia scorrere via dal selettore di app e la rilanci. Una sessione obsoleta è la cosa più rapida da escludere.",
        "<strong class='text-white'>Aggiorni l'app,</strong> apra l'App Store e installi ogni aggiornamento di Tradovate in sospeso. I crash successivi a un aggiornamento vengono spesso risolti dall'aggiornamento <em>successivo</em>.",
        "<strong class='text-white'>Elimini e reinstalli,</strong> un'installazione pulita cancella la cache danneggiata che un errore a metà aggiornamento lascia spesso dietro di sé.",
        "<strong class='text-white'>Aggiorni iOS e liberi spazio,</strong> un sistema operativo non aggiornato o un dispositivo quasi pieno fa andare in crash le app all'avvio.",
        "<strong class='text-white'>Ripieghi sulla piattaforma web o desktop,</strong> acceda tramite un browser per gestire le posizioni aperte mentre l'app del telefono non funziona.",
        "<strong class='text-white'>Controlli la comparsa di un hotfix e lo segnali,</strong> se un'installazione nuova mostra ancora la schermata bianca, la soluzione è lato Tradovate. Lo segnali e attenda la build corretta.",
      ],
    },
    { type: "heading",text: "Che cosa significa «schermata bianca e poi crash»" },
    { type: "paragraph",html: "Il lampo bianco che vede è il livello web dell'app che inizia a caricarsi e poi fallisce prima di riuscire a mostrare l'interfaccia di trading. Le app mobili di Tradovate incapsulano un front end web: all'avvio l'app dipinge brevemente una tela bianca vuota, poi carica sopra di essa la Sua sessione, i grafici e i ticket d'ordine. Quando qualcosa in quella sequenza di avvio si rompe, una cache danneggiata da un aggiornamento interrotto, una build dell'app incompatibile o una sessione memorizzata errata, l'app non supera mai la tela bianca e iOS la chiude forzatamente." },
    { type: "paragraph",html: "Si tratta di un crash all'avvio, non di un rifiuto d'ordine né di un errore di accesso. Nulla La blocca a livello di account; non entrano in gioco né un'impostazione di rischio né una password errata. L'app semplicemente non riesce a completare il caricamento della propria interfaccia. Questa distinzione è importante, perché indirizza la soluzione verso <em>l'installazione e la cache dell'app</em> anziché verso il Suo account." },
    { type: "paragraph",html: "Tende inoltre a manifestarsi a gruppi subito dopo il rilascio di un aggiornamento dell'app. Quando la schermata bianca seguita da crash colpisce lo stesso giorno un gruppo di trader, è un forte segnale che l'aggiornamento stesso ha introdotto il bug; per questo la soluzione a lungo termine più affidabile è di solito la build successiva e non qualcosa che modifica sul Suo dispositivo." },
    { type: "heading",text: "Cause principali del crash con schermata bianca di Tradovate su iOS" },
    { type: "heading",text: "1. Un recente aggiornamento dell'app ha introdotto il bug" },
    { type: "paragraph",html: "È la causa scatenante più comune. L'app funziona bene fino a un aggiornamento recente, poi mostra la schermata bianca e va in crash a ogni avvio. Quando una build rilasciata ha un difetto di avvio, nessuna risoluzione locale lo corregge del tutto finché Tradovate non rilascia una versione corretta." },
    { type: "heading",text: "2. Una cache danneggiata da un aggiornamento interrotto" },
    { type: "paragraph",html: "Se l'app era a metà aggiornamento quando la connessione è caduta, il telefono si è riavviato o lo spazio si è esaurito, i dati locali dell'app possono restare scritti a metà. Al lancio successivo l'app tenta di leggere quella cache danneggiata, fallisce e va in crash. È la causa a cui punta direttamente l'eliminazione seguita dalla reinstallazione." },
    { type: "heading",text: "3. Una versione obsoleta dell'app o di iOS" },
    { type: "paragraph",html: "Eseguire una vecchia build dell'app rispetto al back end attuale di Tradovate, o una vecchia versione di iOS, può impedire l'inizializzazione del front end. Apple rilascia di frequente piccole patch di iOS proprio per correggere bug come le app che vanno in crash all'apertura, quindi un dispositivo indietro di diverse versioni è un sospettato concreto." },
    { type: "heading",text: "4. Poco spazio di archiviazione sul dispositivo" },
    { type: "paragraph",html: "Quando il Suo iPhone è quasi pieno, le app possono andare in crash, bloccarsi o non aprirsi perché non c'è spazio per scrivere la cache e i file temporanei di cui hanno bisogno all'avvio. Liberare spazio è una soluzione rapida che è facile trascurare." },
    { type: "heading",text: "5. Un problema di back end o di sessione che colpisce anche il web mobile" },
    { type: "paragraph",html: "A volte la piattaforma web mobile diventa sostanzialmente inutilizzabile nello stesso momento in cui l'app va in crash. Quando l'app <em>e</em> il web mobile peggiorano insieme, la causa principale è lato Tradovate e non nella Sua specifica installazione, e la mossa pratica è passare alla piattaforma desktop o al web completo." },
    { type: "heading",text: "Come risolvere il crash con schermata bianca di Tradovate su iOS: passo dopo passo" },
    {
      type: "steps",
      items: [
        { title: "Risolvere una sessione obsoleta (prima forzare la chiusura)", html: "Dalla schermata Home dell'iPhone, scorra verso l'alto dal bordo inferiore (o prema due volte il tasto Home sui dispositivi più vecchi) per aprire il selettore di app. Trovi la scheda di Tradovate e la faccia scorrere verso l'alto fuori dallo schermo per chiuderla completamente. Attenda qualche secondo, poi tocchi l'icona di Tradovate per rilanciarla. Se era solo una sessione bloccata, ora si carica normalmente." },
        { title: "Risolvere una build obsoleta (aggiornare l'app e iOS)", html: "Apra l'<strong class='text-white'>App Store</strong>, tocchi l'icona del Suo profilo e scorra fino agli aggiornamenti in sospeso, oppure cerchi Tradovate e apra la scheda dell'app. Se accanto a Tradovate compare un pulsante <strong class='text-white'>Update</strong>, lo tocchi e lasci che la nuova build si installi completamente prima di riaprire. Separatamente, apra <strong class='text-white'>Settings &rsaquo; General &rsaquo; Software Update</strong> e installi ogni aggiornamento di iOS in sospeso, poiché le patch di Apple risolvono spesso le app che vanno in crash all'avvio." },
        { title: "Risolvere una cache danneggiata (eliminare e reinstallare)", html: "Tenga premuta l'icona dell'app Tradovate nella schermata Home finché non compare il menu, quindi scelga di rimuovere o eliminare l'app in modo da cancellare i suoi dati locali danneggiati. Apra l'<strong class='text-white'>App Store</strong>, cerchi Tradovate e reinstalli la copia nuova. Acceda di nuovo. Un'installazione pulita rimuove la cache scritta a metà che un aggiornamento interrotto lascia dietro di sé, la soluzione locale singola più efficace per questo crash." },
        { title: "Risolvere la scarsità di spazio", html: "Apra <strong class='text-white'>Settings &rsaquo; General &rsaquo; iPhone Storage</strong> e controlli quanto spazio libero rimane. Scarichi o elimini app, foto o download finché non ha un comodo margine di spazio libero. Riapra Tradovate. Con lo spazio per scrivere la propria cache, l'app può completare la sequenza di avvio." },
        { title: "Risolvere quando nulla in locale funziona (usare web/desktop e attendere l'hotfix)", html: "Se una reinstallazione pulita mostra ancora la schermata bianca, smetta di risolvere i problemi del telefono: il difetto è nella build rilasciata. Acceda alla <strong class='text-white'>piattaforma web in un browser</strong> (o all'app desktop) per monitorare e gestire subito le posizioni aperte. Segnali il crash al supporto di Tradovate indicando dispositivo e versione dell'app, poi controlli l'App Store per il prossimo aggiornamento, che di solito contiene la correzione." },
      ],
    },
    { type: "quote",html: "Su Android, il passaggio equivalente è aprire le impostazioni di sistema dell'app e <em>cancellare la cache e cancellare i dati di archiviazione</em>, poi rilanciare. iOS non espone un pulsante &ldquo;cancella cache&rdquo; per singola app, quindi su iPhone il passaggio di eliminazione e reinstallazione svolge la stessa funzione." },
    { type: "heading",text: "Tabella di risoluzione dei problemi" },
    { type: "table", headers: ["Sintomo","Che cosa significa","Soluzione"], rows: [
      ["Schermata bianca e poi crash a ogni avvio","Il front end dell'app non si inizializza, di solito dopo un aggiornamento","Aggiornare, poi eliminare e reinstallare l'app"],
      ["Il crash è iniziato subito dopo un aggiornamento dell'app","La build rilasciata ha un difetto di avvio","Installare il prossimo aggiornamento / hotfix; nel frattempo usare il web"],
      ["Va in crash solo dopo un aggiornamento interrotto","Cache locale danneggiata","Eliminare e reinstallare per una copia pulita"],
      ["App e web mobile non funzionano insieme","Problema di back end o di sessione lato Tradovate","Passare a desktop/web completo; segnalare al supporto"],
      ["L'app va in crash e iOS è indietro di diverse versioni","Incompatibilità o bug a livello di sistema operativo","Aggiornare iOS tramite Settings &rsaquo; General &rsaquo; Software Update"],
      ["L'app va in crash e lo spazio è quasi esaurito","Nessuno spazio per scrivere cache/file temporanei","Liberare spazio sul dispositivo, poi rilanciare"],
    ] },
    { type: "heading",text: "Lo eviti con PickMyTrade" },
    { type: "paragraph",html: "Un'app del telefono che mostra la schermata bianca nel momento peggiore non dovrebbe essere l'unica cosa che si frappone tra la Sua strategia e il mercato. PickMyTrade collega i Suoi alert di TradingView direttamente al Suo account Tradovate lato server, così ingressi, stop e uscite continuano a essere eseguiti anche quando l'app iOS non si apre:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Esecuzione lato server</strong>, la Sua automazione gira sull'infrastruttura di PickMyTrade e non sul telefono, quindi un'app in crash non blocca la Sua strategia.",
        "<strong class='text-white'>Sincronizzazione multi-account</strong>, replichi gli stessi ordini su tutti gli account collegati senza toccare l'app mobile.",
        "<strong class='text-white'>Instradamento affidabile da alert a ordine</strong>, i segnali di TradingView raggiungono Tradovate attraverso un ponte stabile anziché un front end fragile.",
        "<strong class='text-white'>Gestione del rischio automatica</strong>, associ automaticamente stop e target in modo che le posizioni aperte restino protette mentre rimette in funzione l'app.",
      ],
    },
  ] },
