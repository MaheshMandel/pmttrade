---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "ninjatrader-delayed-data-tradovate";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/debugging/${SLUG}`;

const META_TITLE = "NinjaTrader 'Delayed 10 Minutes' With Tradovate";
const META_DESCRIPTION =
  "NinjaTrader stuck on delayed 10-minute data with Tradovate? Fix the real-time subscription on every workspace instrument to clear the warning fast.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "NinjaTrader „10 Minuten verzögert“ bei Tradovate", es: "NinjaTrader “10 minutos de retraso” con Tradovate", fr: "NinjaTrader « différé de 10 minutes » avec Tradovate", it: "NinjaTrader “ritardo di 10 minuti” con Tradovate" },
  dek: { en: "Your Tradovate account has a live data subscription, yet NinjaTrader slaps a 10-minute delayed-data banner across the screen. Usually it's one stray symbol buried in your workspace. Here's how to find it and clear the warning.", de: "Ihr Tradovate-Konto hat ein Live-Daten-Abonnement, doch NinjaTrader legt ein Banner für 10 Minuten verzögerte Daten über den Bildschirm. Meist ist es ein einziges verirrtes Symbol in Ihrem Workspace. So finden Sie es und beseitigen die Warnung.", es: "Su cuenta de Tradovate tiene una suscripción de datos en vivo, pero NinjaTrader le muestra un banner de datos retrasados 10 minutos. Normalmente es un símbolo suelto escondido en su workspace. Le mostramos cómo encontrarlo y eliminar la advertencia.", fr: "Votre compte Tradovate dispose d'un abonnement de données en direct, et pourtant NinjaTrader affiche une bannière de données différées de 10 minutes. En général, c'est un symbole isolé caché dans votre workspace. Voici comment le trouver et faire disparaître l'avertissement.", it: "Il suo account Tradovate ha un abbonamento ai dati live, eppure NinjaTrader mostra un banner di dati ritardati di 10 minuti. Di solito è un simbolo isolato nascosto nel suo workspace. Ecco come trovarlo e far sparire l'avviso." },
  readTime: { en: "7 min read", de: "7 Min. Lesezeit", es: "Lectura de 7 min", fr: "Lecture : 7 min", it: "Lettura di 7 min" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "You open a chart, the tape crawls, and NinjaTrader slaps a banner across the screen: <em>“Instruments not subscribed for real-time data have been detected and will have a 10 minute delay.”</em> Your Tradovate account has a live data subscription, so what gives? Usually it comes down to one stray symbol buried in your workspace, a single unsubscribed instrument is all it takes. And while that warning is up, those instruments won't plot correctly or fill orders. Here's the reassuring part: this is almost always a subscription-scope problem, not a broken account. Below you'll find what the warning actually means, the exact causes, and how to clear it in a few minutes, plus how routing your entries through PickMyTrade keeps a delayed feed from ever costing you a fill." },
    {
      type: "checklist",
      heading: "Quick Checklist for NinjaTrader Delayed Data With Tradovate",
      items: [
        "<strong class='text-white'>Read the Log tab first.</strong> Control Center &gt; Log shows exactly which instrument is flagged, look for “Instrument with delayed data has been detected.”",
        "<strong class='text-white'>Confirm the Tradovate data subscription.</strong> A Tradovate username without a live market-data subscription gets 10-minute delayed data by design.",
        "<strong class='text-white'>Sign the Non-Professional Data Agreement.</strong> An unsigned exchange agreement on the Tradovate side keeps you on delayed data even after you've paid.",
        "<strong class='text-white'>Remove or replace stray symbols.</strong> Default workspaces often ship with instruments like FDAX you never subscribed to. Delete them and save the workspace.",
        "<strong class='text-white'>Check your connection order.</strong> With multiple connections, NinjaTrader uses data from whichever one connects first, so connect to the entitled feed.",
        "<strong class='text-white'>Restart after any change.</strong> Give the subscription a short while to propagate, then relaunch NinjaTrader.",
      ],
    },
    { type: "heading", text: "What “Instruments Not Subscribed for Real-Time Data Have Been Detected” Means" },
    { type: "paragraph", html: "NinjaTrader watches every instrument your workspace pulls data for, charts, DOMs, Market Analyzer rows, strategies, all of it. The instant it asks Tradovate for data on a symbol your account isn't entitled to receive in real time, it drops to a delayed feed and throws the warning. The key detail: the message fires if <em>there's at least one instrument in the workspace without a real-time data subscription</em>. It doesn't mean your whole account is delayed. It means at least one symbol is." },
    { type: "paragraph", html: "That's exactly why the warning trips people up. Your ES or NQ chart can be ticking live while a forgotten FDAX or a stale contract month sits quietly in a saved workspace, pulling up the banner. NinjaTrader also flags that those instruments “cannot be traded and will not properly plot on a chart,” so this is a banner worth clearing rather than clicking past." },
    { type: "paragraph", html: "With Tradovate, the real-time entitlement lives on the <strong class='text-white'>Tradovate account</strong> itself, not inside NinjaTrader's own data settings. If your Tradovate username doesn't carry a live market-data subscription, or the required exchange data agreement hasn't been signed, Tradovate serves the free 10-minute delayed feed, and NinjaTrader reports it faithfully." },
    { type: "heading", text: "Top Causes of the Delayed-Data Warning in 2026" },
    { type: "heading", text: "1. One unsubscribed instrument in the workspace" },
    { type: "paragraph", html: "This is the number-one cause, hands down. A single symbol you're not entitled to, often a leftover from a default or imported workspace, triggers the banner for the entire platform. On default workspaces, non-US instruments like FDAX are a common culprit because their exchange data isn't included by default." },
    { type: "heading", text: "2. No live market-data subscription on the Tradovate account" },
    { type: "paragraph", html: "If the Tradovate username connected to NinjaTrader has no active real-time data subscription for the exchange (CME, for example), Tradovate delivers 10-minute delayed data. Data subscription fees and available packages vary by exchange and plan, so check Tradovate's current market-data pricing for the instruments you actually trade." },
    { type: "heading", text: "3. Unsigned Non-Professional Data Agreement" },
    { type: "paragraph", html: "You can pay for data and still be delayed if the exchange's Non-Professional (or Professional) data agreement hasn't been accepted on the Tradovate side. Until it's signed, the entitlement simply doesn't activate." },
    { type: "heading", text: "4. Connection order with multiple connections" },
    { type: "paragraph", html: "Keep more than one connection configured and NinjaTrader uses the real-time and historical data from whichever connection establishes first. Connect a NinjaTrader demo feed or a Tradovate-based evaluation connection that lacks the subscription before your entitled connection, and the delayed-data warning shows up." },
    { type: "heading", text: "5. Prop-firm evaluation account data not enabled" },
    { type: "paragraph", html: "On prop-firm (evaluation or funded) accounts, the firm, not you, controls market-data entitlement. If the firm hasn't enabled live data on the account, you'll sit on delayed data no matter what you change in NinjaTrader. This is firm- and account-specific, so the rules vary by firm and account size. Check your firm's current data policy." },
    { type: "heading", text: "How to Fix NinjaTrader Delayed Data With Tradovate: Step-by-Step" },
    {
      type: "steps",
      items: [
        { title: "Pinpoint the delayed instrument in the Log tab", html: "Don't guess which symbol is delayed, let NinjaTrader tell you. Open the <strong class='text-white'>Control Center</strong>, then click the <strong class='text-white'>Log</strong> tab along the bottom. Look for entries like <em>“Instrument with delayed data has been detected: MES MAR23”</em> (your symbol and contract month will differ). This lists exactly which instrument (or instruments) fell back to the delayed feed, so you fix the right one instead of tearing apart the whole workspace." },
        { title: "Subscribe that instrument to real-time data on Tradovate", html: "Since NinjaTrader is only reporting Tradovate's entitlement, the fix happens on the Tradovate side. Log in to the Tradovate web platform at <strong class='text-white'>trader.tradovate.com</strong> and open your market-data settings. Add or confirm the real-time data subscription for the exchange behind the flagged symbol, and accept the <strong class='text-white'>Non-Professional Data Agreement</strong> if a pop-up or banner prompts you. Give the entitlement a short while to propagate, often around 15 to 20 minutes, then fully restart NinjaTrader so it re-requests data with the updated permissions." },
        { title: "Remove or replace unsubscribed instruments in the workspace", html: "Don't want to pay for an exchange you'll never trade? Just remove the offending instrument instead. Close every chart, DOM, and Market Analyzer row using the flagged symbol, then <strong class='text-white'>save the workspace</strong>. NinjaTrader stops requesting data for it, and the warning vanishes on the next launch. A clean, single-exchange workspace is the most reliable way to keep the banner from coming back." },
        { title: "Fix your connection order", html: "Running multiple connections? Disconnect all of them, then connect only to the Tradovate connection that carries your real-time entitlement, or make sure it's the first to connect. Because NinjaTrader inherits data from whatever connects first, leading with the entitled connection stops a delayed feed from a demo or evaluation connection sneaking in ahead of it." },
        { title: "For prop accounts, contact your firm", html: "If you're on an evaluation or funded account and the data is still delayed after everything above, the entitlement is on the firm's side. Reach out to your prop firm's support to have live market data enabled on the account. Firm rules and data inclusions vary by firm and account size, so check your firm's current rules rather than assuming self-subscription will do the trick." },
      ],
    },
    { type: "heading", text: "Troubleshooting Table" },
    {
      type: "table",
      headers: ["Error / Symptom", "Meaning", "Fix"],
      rows: [
        ["Instruments not subscribed for real-time data have been detected and will have a 10 minute delay", "At least one workspace instrument lacks a real-time subscription", "Identify it in the Log tab, then subscribe on Tradovate or remove it"],
        ["Instrument with delayed data has been detected: [symbol]", "That specific symbol fell back to the 10-minute delayed feed", "Add the exchange subscription for that instrument on Tradovate"],
        ["Data delayed even after paying", "Non-Professional Data Agreement not signed", "Sign the data agreement at trader.tradovate.com, wait, then restart"],
        ["Orange / greyed symbol or slow tape in NinjaTrader", "Delayed (non-live) data on that instrument", "Confirm the live subscription and agreement on the Tradovate account"],
        ["Delayed data only sometimes, on certain launches", "Wrong connection connecting first", "Connect only the entitled Tradovate connection, or connect it first"],
        ["Prop/eval account stuck on delayed data", "Firm hasn't enabled live market data", "Contact your prop firm to enable data on the account"],
      ],
    },
    { type: "heading", text: "Prevent This With PickMyTrade" },
    { type: "paragraph", html: "Delayed data is dangerous because a stale chart hides the real price your order will hit. PickMyTrade sends your entries straight from TradingView to Tradovate through a dedicated execution path, so your automation isn't held hostage by a workspace subscription glitch:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Symbol &amp; Contract Validation</strong>, normalizes the traded symbol and active contract month so a stray or expired instrument can't quietly delay or misroute an order.",
        "<strong class='text-white'>Entitlement &amp; Data-Agreement Awareness</strong>, surfaces account and market-data state so you catch a missing subscription before it costs you a fill.",
        "<strong class='text-white'>Rate-Limit-Safe Routing</strong>, spaces order flow to Tradovate so nothing bounces during fast markets.",
        "<strong class='text-white'>Multi-Account Sync</strong>, mirrors the same corrected entry across every connected account, so one clean signal drives them all.",
      ],
    },
  ], de: [
    { type: "paragraph",html: "Sie öffnen einen Chart, der Tape kriecht, und NinjaTrader legt ein Banner über den Bildschirm: <em>„Instruments not subscribed for real-time data have been detected and will have a 10 minute delay.“</em> Ihr Tradovate-Konto hat ein Live-Daten-Abonnement, was ist also los? Meist liegt es an einem einzigen verirrten Symbol in Ihrem Workspace, ein einziges nicht abonniertes Instrument genügt. Und solange die Warnung angezeigt wird, werden diese Instrumente nicht korrekt dargestellt und führen keine Orders aus. Die beruhigende Nachricht: Fast immer ist das ein Problem des Abonnementumfangs, kein defektes Konto. Unten finden Sie, was die Warnung tatsächlich bedeutet, die genauen Ursachen und wie Sie sie in wenigen Minuten beseitigen, plus wie das Routing Ihrer Einstiege über PickMyTrade verhindert, dass ein verzögerter Feed Sie je eine Ausführung kostet." },
    {
      type: "checklist",
      heading: "Schnell-Checkliste zu verzögerten NinjaTrader-Daten mit Tradovate",
      items: [
        "<strong class='text-white'>Lesen Sie zuerst den Log-Tab.</strong> Control Center &gt; Log zeigt genau, welches Instrument markiert ist; achten Sie auf „Instrument with delayed data has been detected“.",
        "<strong class='text-white'>Bestätigen Sie das Tradovate-Datenabonnement.</strong> Ein Tradovate-Benutzername ohne Live-Marktdaten-Abonnement erhält systembedingt um 10 Minuten verzögerte Daten.",
        "<strong class='text-white'>Unterzeichnen Sie die Non-Professional Data Agreement.</strong> Eine nicht unterzeichnete Börsenvereinbarung auf der Tradovate-Seite hält Sie auch nach der Zahlung bei verzögerten Daten.",
        "<strong class='text-white'>Entfernen oder ersetzen Sie verirrte Symbole.</strong> Standard-Workspaces enthalten oft Instrumente wie FDAX, die Sie nie abonniert haben. Löschen Sie sie und speichern Sie den Workspace.",
        "<strong class='text-white'>Prüfen Sie die Verbindungsreihenfolge.</strong> Bei mehreren Verbindungen verwendet NinjaTrader die Daten der Verbindung, die sich zuerst aufbaut; verbinden Sie sich also zuerst mit dem berechtigten Feed.",
        "<strong class='text-white'>Starten Sie nach jeder Änderung neu.</strong> Geben Sie dem Abonnement kurz Zeit zur Übernahme und starten Sie NinjaTrader dann neu.",
      ],
    },
    { type: "heading",text: "Was „Instruments Not Subscribed for Real-Time Data Have Been Detected“ bedeutet" },
    { type: "paragraph",html: "NinjaTrader überwacht jedes Instrument, für das Ihr Workspace Daten abruft: Charts, DOMs, Market-Analyzer-Zeilen, Strategien, alles. Sobald es bei Tradovate Daten zu einem Symbol anfordert, für das Ihr Konto keine Echtzeitberechtigung hat, fällt es auf einen verzögerten Feed zurück und zeigt die Warnung. Der entscheidende Punkt: Die Meldung wird ausgelöst, wenn <em>mindestens ein Instrument im Workspace kein Echtzeit-Datenabonnement hat</em>. Sie bedeutet nicht, dass Ihr gesamtes Konto verzögert ist. Sie bedeutet, dass mindestens ein Symbol es ist." },
    { type: "paragraph",html: "Genau deshalb stolpern viele über die Warnung. Ihr ES- oder NQ-Chart kann live ticken, während ein vergessenes FDAX oder ein veralteter Kontraktmonat still in einem gespeicherten Workspace liegt und das Banner hervorholt. NinjaTrader weist außerdem darauf hin, dass diese Instrumente „cannot be traded and will not properly plot on a chart“, sodass dieses Banner beseitigt und nicht einfach weggeklickt werden sollte." },
    { type: "paragraph",html: "Bei Tradovate liegt die Echtzeit-Berechtigung auf dem <strong class='text-white'>Tradovate-Konto</strong> selbst, nicht in den eigenen Dateneinstellungen von NinjaTrader. Trägt Ihr Tradovate-Benutzername kein Live-Marktdaten-Abonnement oder wurde die erforderliche Börsen-Datenvereinbarung nicht unterzeichnet, liefert Tradovate den kostenlosen um 10 Minuten verzögerten Feed, und NinjaTrader meldet das korrekt." },
    { type: "heading",text: "Die häufigsten Ursachen der Warnung zu verzögerten Daten 2026" },
    { type: "heading",text: "1. Ein nicht abonniertes Instrument im Workspace" },
    { type: "paragraph",html: "Das ist mit Abstand die Ursache Nummer eins. Ein einzelnes Symbol, für das Sie keine Berechtigung haben, oft ein Überbleibsel aus einem Standard- oder importierten Workspace, löst das Banner für die gesamte Plattform aus. In Standard-Workspaces sind nicht-amerikanische Instrumente wie FDAX ein häufiger Verursacher, da deren Börsendaten standardmäßig nicht enthalten sind." },
    { type: "heading",text: "2. Kein Live-Marktdaten-Abonnement auf dem Tradovate-Konto" },
    { type: "paragraph",html: "Hat der mit NinjaTrader verbundene Tradovate-Benutzername kein aktives Echtzeit-Datenabonnement für die Börse (z. B. CME), liefert Tradovate um 10 Minuten verzögerte Daten. Gebühren und verfügbare Pakete für Daten variieren je nach Börse und Tarif; prüfen Sie daher die aktuelle Marktdaten-Preisgestaltung von Tradovate für die Instrumente, die Sie tatsächlich handeln." },
    { type: "heading",text: "3. Nicht unterzeichnete Non-Professional Data Agreement" },
    { type: "paragraph",html: "Sie können für Daten bezahlen und trotzdem verzögert sein, wenn die Non-Professional- (oder Professional-)Datenvereinbarung der Börse auf der Tradovate-Seite nicht akzeptiert wurde. Solange sie nicht unterzeichnet ist, wird die Berechtigung schlicht nicht aktiviert." },
    { type: "heading",text: "4. Verbindungsreihenfolge bei mehreren Verbindungen" },
    { type: "paragraph",html: "Halten Sie mehr als eine Verbindung konfiguriert, verwendet NinjaTrader die Echtzeit- und historischen Daten der Verbindung, die sich zuerst aufbaut. Verbinden Sie einen NinjaTrader-Demo-Feed oder eine Tradovate-basierte Evaluierungsverbindung ohne das Abonnement vor Ihrer berechtigten Verbindung, erscheint die Warnung zu verzögerten Daten." },
    { type: "heading",text: "5. Daten des Prop-Firm-Evaluierungskontos nicht aktiviert" },
    { type: "paragraph",html: "Bei Prop-Firm-Konten (Evaluierung oder Funded) kontrolliert die Firma, nicht Sie, die Marktdaten-Berechtigung. Hat die Firma keine Live-Daten für das Konto aktiviert, bleiben Sie bei verzögerten Daten, egal was Sie in NinjaTrader ändern. Das ist firmen- und kontospezifisch, die Regeln variieren also je nach Firma und Kontogröße. Prüfen Sie die aktuelle Datenrichtlinie Ihrer Firma." },
    { type: "heading",text: "So beheben Sie verzögerte NinjaTrader-Daten mit Tradovate: Schritt für Schritt" },
    {
      type: "steps",
      items: [
        { title: "Das verzögerte Instrument im Log-Tab ermitteln", html: "Raten Sie nicht, welches Symbol verzögert ist, sondern lassen Sie es sich von NinjaTrader sagen. Öffnen Sie das <strong class='text-white'>Control Center</strong> und klicken Sie unten auf den Tab <strong class='text-white'>Log</strong>. Achten Sie auf Einträge wie <em>„Instrument with delayed data has been detected: MES MAR23“</em> (Ihr Symbol und Kontraktmonat werden abweichen). Dort steht genau, welches Instrument (oder welche Instrumente) auf den verzögerten Feed zurückgefallen ist, sodass Sie das richtige korrigieren, statt den gesamten Workspace auseinanderzunehmen." },
        { title: "Dieses Instrument bei Tradovate für Echtzeitdaten abonnieren", html: "Da NinjaTrader nur die Berechtigung von Tradovate meldet, erfolgt die Behebung auf der Tradovate-Seite. Melden Sie sich bei der Tradovate-Webplattform unter <strong class='text-white'>trader.tradovate.com</strong> an und öffnen Sie Ihre Marktdaten-Einstellungen. Fügen Sie das Echtzeit-Datenabonnement für die Börse hinter dem markierten Symbol hinzu oder bestätigen Sie es, und akzeptieren Sie die <strong class='text-white'>Non-Professional Data Agreement</strong>, falls ein Pop-up oder Banner dazu auffordert. Geben Sie der Berechtigung kurz Zeit zur Übernahme, oft etwa 15 bis 20 Minuten, und starten Sie NinjaTrader dann vollständig neu, damit es die Daten mit den aktualisierten Berechtigungen neu anfordert." },
        { title: "Nicht abonnierte Instrumente im Workspace entfernen oder ersetzen", html: "Sie möchten nicht für eine Börse zahlen, die Sie nie handeln werden? Entfernen Sie einfach das betreffende Instrument. Schließen Sie jeden Chart, jedes DOM und jede Market-Analyzer-Zeile, die das markierte Symbol verwenden, und <strong class='text-white'>speichern Sie dann den Workspace</strong>. NinjaTrader fordert dafür keine Daten mehr an, und die Warnung verschwindet beim nächsten Start. Ein sauberer Workspace mit nur einer Börse ist der zuverlässigste Weg, das Banner nicht zurückkehren zu lassen." },
        { title: "Die Verbindungsreihenfolge korrigieren", html: "Betreiben Sie mehrere Verbindungen? Trennen Sie alle und verbinden Sie sich dann nur mit der Tradovate-Verbindung, die Ihre Echtzeit-Berechtigung trägt, oder stellen Sie sicher, dass sie sich als Erste verbindet. Da NinjaTrader die Daten von der zuerst verbundenen Verbindung übernimmt, verhindert es, die berechtigte Verbindung voranzustellen, dass ein verzögerter Feed einer Demo- oder Evaluierungsverbindung sich davorschiebt." },
        { title: "Bei Prop-Konten die Firma kontaktieren", html: "Befinden Sie sich auf einem Evaluierungs- oder Funded-Konto und die Daten sind nach allem oben immer noch verzögert, liegt die Berechtigung auf Seiten der Firma. Wenden Sie sich an den Support Ihrer Prop Firm, damit Live-Marktdaten auf dem Konto aktiviert werden. Regeln und Dateninhalte der Firma variieren je nach Firma und Kontogröße; prüfen Sie daher die aktuellen Regeln Ihrer Firma, statt anzunehmen, dass eine Selbstabonnierung genügt." },
      ],
    },
    { type: "heading",text: "Tabelle zur Fehlerbehebung" },
    { type: "table", headers: ["Fehler / Symptom","Bedeutung","Lösung"], rows: [
      ["Instruments not subscribed for real-time data have been detected and will have a 10 minute delay","Mindestens ein Workspace-Instrument hat kein Echtzeit-Abonnement","Im Log-Tab identifizieren, dann bei Tradovate abonnieren oder entfernen"],
      ["Instrument with delayed data has been detected: [symbol]","Dieses Symbol ist auf den um 10 Minuten verzögerten Feed zurückgefallen","Börsenabonnement für dieses Instrument bei Tradovate hinzufügen"],
      ["Daten trotz Bezahlung verzögert","Non-Professional Data Agreement nicht unterzeichnet","Datenvereinbarung unter trader.tradovate.com unterzeichnen, warten, dann neu starten"],
      ["Orangefarbenes / ausgegrautes Symbol oder träger Tape in NinjaTrader","Verzögerte (nicht live) Daten bei diesem Instrument","Live-Abonnement und Vereinbarung im Tradovate-Konto bestätigen"],
      ["Verzögerte Daten nur manchmal, bei bestimmten Starts","Die falsche Verbindung baut sich zuerst auf","Nur die berechtigte Tradovate-Verbindung verbinden oder sie zuerst verbinden"],
      ["Prop-/Evaluierungskonto bleibt bei verzögerten Daten","Die Firma hat keine Live-Marktdaten aktiviert","Prop Firm kontaktieren, damit Daten auf dem Konto aktiviert werden"],
    ] },
    { type: "heading",text: "Verhindern Sie das mit PickMyTrade" },
    { type: "paragraph",html: "Verzögerte Daten sind gefährlich, weil ein veralteter Chart den realen Preis verbirgt, zu dem Ihre Order ausgeführt wird. PickMyTrade sendet Ihre Einstiege direkt von TradingView über einen dedizierten Ausführungspfad an Tradovate, sodass Ihre Automatisierung nicht von einer Panne im Workspace-Abonnement abhängig ist:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Symbol- &amp; Kontraktvalidierung</strong>: normalisiert das gehandelte Symbol und den aktiven Kontraktmonat, sodass ein verirrtes oder abgelaufenes Instrument eine Order nicht unbemerkt verzögern oder fehlleiten kann.",
        "<strong class='text-white'>Berechtigungs- &amp; Datenvereinbarungs-Bewusstsein</strong>: zeigt Konto- und Marktdatenstatus an, sodass Sie ein fehlendes Abonnement bemerken, bevor es Sie eine Ausführung kostet.",
        "<strong class='text-white'>Ratenlimit-sicheres Routing</strong>: verteilt den Order-Fluss zu Tradovate so, dass in schnellen Märkten nichts abprallt.",
