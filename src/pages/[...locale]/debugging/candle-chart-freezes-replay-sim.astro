---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "candle-chart-freezes-replay-sim";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/debugging/${SLUG}`;

const META_TITLE = "Tradovate Sim/Replay Candle Chart Freezes";
const META_DESCRIPTION =
  "Candle charts frozen in sim or market replay while the order book keeps moving? Restart the browser and use a recent contract to get bars updating again.";

// Short SEO title (<=60 chars) for locales where the shared h1 is too long for a SERP title.
const TITLE_OVERRIDE: Partial<Record<Locale, string>> = { es: "Tradovate: el gráfico de velas se congela en sim/replay", fr: "Tradovate : graphique en chandeliers figé en sim/replay" };

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Tradovate Sim/Replay: Kerzenchart friert ein", es: "El gráfico de velas de Tradovate se congela en sim/repetición", fr: "Le graphique en chandeliers de Tradovate se fige en simulation/replay", it: "Il grafico a candele di Tradovate si blocca in sim/replay" },
  dek: { en: "The DOM keeps ticking but the candles just stop, or new bars print an open with no high, low, or wick. Here's why the chart feed stalls in sim and replay, and the restart-and-contract fix that actually holds.", de: "Das Orderbuch (DOM) tickt weiter, aber die Kerzen bleiben einfach stehen, oder neue Balken zeigen nur eine Eröffnung ohne Hoch, Tief oder Docht. Hier erfahren Sie, warum der Chart-Feed in Sim und Replay stockt, und welche Kombination aus Neustart und richtigem Kontrakt wirklich dauerhaft hilft.", es: "El DOM sigue moviéndose, pero las velas simplemente se detienen, o las nuevas barras muestran solo un precio de apertura sin máximo, mínimo ni mecha. Esto es lo que hace que el feed del gráfico se bloquee en sim y repetición, y la solución de reiniciar y elegir el contrato correcto que realmente funciona.", fr: "Le carnet d'ordres (DOM) continue de s'actualiser, mais les bougies s'arrêtent tout simplement, ou les nouvelles barres n'affichent qu'un prix d'ouverture sans plus haut, plus bas ni mèche. Voici pourquoi le flux du graphique se bloque en simulation et en replay, et la solution redémarrage + bon contrat qui fonctionne vraiment.", it: "Il DOM continua ad aggiornarsi, ma le candele si bloccano semplicemente, oppure le nuove barre mostrano solo un prezzo di apertura senza massimo, minimo o ombra. Ecco perché il feed del grafico si blocca in modalità sim e replay, e la soluzione riavvio più contratto corretto che funziona davvero." },
  readTime: { en: "6 min read", de: "6 Minuten Lesezeit", es: "Lectura de 6 minutos", fr: "Lecture de 6 minutes", it: "Lettura di 6 minuti" },
  lastUpdated: "2026-07-10",
  heroImage: { src: `${IMG}/candle-chart-freezes-replay-sim-1.png`, alt: { en: "Tradovate chart with frozen candlesticks in a sim session while the DOM order book beside it keeps updating", de: "Tradovate-Chart mit eingefrorenen Kerzen in einer Sim-Sitzung, während das DOM-Orderbuch daneben weiter aktualisiert wird", es: "Gráfico de Tradovate con velas congeladas en una sesión sim mientras el libro de órdenes DOM al lado sigue actualizándose", fr: "Graphique Tradovate avec des chandeliers figés dans une session sim pendant que le carnet d'ordres DOM à côté continue de s'actualiser", it: "Grafico Tradovate con candele bloccate in una sessione sim mentre il libro ordini DOM accanto continua ad aggiornarsi" } },
  blocks: { en: [
    { type: "paragraph", html: "You're deep in a replay session or grinding the sim, and the candles just&hellip; stop. The current bar sits there half-formed, or every new bar prints a flat open with no high, no low, no wick. Flip over to the DOM and it's alive, quotes rolling like nothing's wrong. Look back at the chart and it's a still photo. That split, a moving order book next to a dead chart, is the exact signature of this bug." },
    { type: "paragraph", html: "Here's the short version before the detail: the quickest reliable recovery is a <strong class='text-white'>full browser restart</strong>, close the browser (or the desktop app) completely, reopen it, reconnect to your session, and reload the chart. That re-establishes the chart's data feed and clears the freeze almost every time. Two habits make it far less likely to happen at all: <strong class='text-white'>replay recent dates</strong> (roughly the last two weeks of data behaves far better than older history), and <strong class='text-white'>load the correct active contract month</strong> instead of an expired or continuous symbol. Everything below unpacks why the freeze happens and how to keep it from eating your practice sessions." },
    {
      type: "checklist",
      heading: "Quick Checklist",
      items: [
        "<strong class='text-white'>Restart the browser or desktop app fully, then reconnect.</strong> This is the recovery that actually holds, a plain refresh often isn't enough.",
        "<strong class='text-white'>Nudge it first if you're mid-analysis.</strong> Switch the chart to another symbol and back, change the timeframe, or flip chart tabs, candles usually repaint for a moment.",
        "<strong class='text-white'>Replay recent data.</strong> Sessions from about the last two weeks stall far less than older ones.",
        "<strong class='text-white'>Load the correct contract month.</strong> Use the specific expiration that was trading that day, not a continuous or expired symbol.",
        "<strong class='text-white'>Keep long replays shorter.</strong> Freezes pile up after 30&ndash;60 minutes of continuous replay on older contracts, break it into chunks.",
        "<strong class='text-white'>Confirm market data for the symbol.</strong> A missing or delayed data subscription can leave bars half-drawn.",
        "<strong class='text-white'>Check the release notes and status.</strong> Some freezes are platform-side and clear only when Tradovate ships a fix.",
      ],
    },
    { type: "heading", text: "What's Actually Happening Under the Hood" },
    { type: "paragraph", html: "The chart and the DOM don't share a data path, and that's the whole story. The DOM is wired straight to the live quote stream, every bid, ask, and print. The chart is built differently: it pulls a block of historical bars, then layers streaming updates on top to grow the current candle and start new ones. In sim and market replay, those candles come from a replay/history feed that's simply more delicate than the raw quote stream, and it gets more delicate the further back in time you go." },
    { type: "paragraph", html: "When that bar feed stalls, the DOM carries on because it's on a different pipe, but the candles freeze. If the freeze catches a bar mid-formation, you get the tell-tale symptom people describe over and over: new bars show only the <strong class='text-white'>open</strong> price, because the tick updates that would fill in the high, low, and close simply stop arriving. The bar can't finish. That's also why a hard restart works, reopening the app rebuilds the chart session and reconnects the feed from scratch, so the bars start populating again." },
    { type: "quote", html: "A frozen chart is a display and data problem, not a money problem, but don't trade off it. If the candles are stale, live price could be well away from where the last bar shows. Read the real price off the DOM or the positions module before you act, and restart to get an honest chart back." },
    { type: "paragraph", html: "One more thing worth knowing: this isn't always on your machine. Waves of frozen-candle reports have lined up with new platform releases and then been fixed in a later Tradovate update. If a restart and a recent contract don't help and every symbol freezes at once, you may be waiting on a server-side fix rather than chasing a local one." },
    { type: "heading", text: "Fix It: Restart, Reconnect, Reload" },
    {
      type: "steps",
      items: [
        { title: "Nudge the chart (buys you a moment)", html: "If you just need the current bar to catch up without blowing away your layout, force the chart to redraw. Change the symbol to something else and switch straight back, flip the timeframe up or down a notch, or click between chart tabs. The candles typically repaint and update for a bit. Treat this as a stopgap, it's fast, but the freeze tends to creep back, so it's not a substitute for the real reset." },
        { title: "Restart the browser or desktop app completely", html: "This is the fix that sticks. Don't just hit F5, close the browser window (or quit the desktop app) entirely so the session is fully torn down, then open it again. A complete restart clears the wedged chart feed and forces a clean reconnection. On the web platform, closing every Tradovate tab and reopening one fresh does the job; on desktop, quit the app from the tray or task manager if it's unresponsive, then relaunch." },
        { title: "Reconnect and reload the chart", html: "After the restart, log back in, select your sim or replay account, and reopen the chart module. Give it a second to pull history and start streaming, the current bar should grow tick by tick again, with proper highs, lows, and wicks. If you were mid-replay, restart it from the point you need; the bars should populate cleanly on the fresh session." },
      ],
    },
    { type: "image", src: `${IMG}/candle-chart-freezes-replay-sim-2.png`, alt: "Reopening the Tradovate web platform in a fresh browser window and reconnecting to a sim session after a chart freeze" },
    { type: "heading", text: "Pick the Right Contract for Replay" },
    { type: "paragraph", html: "Contract choice matters more than most people expect, and it's the single biggest lever on whether replay behaves. Load the exact contract that was actually trading during the session you're replaying, the real expiration, like the March E-mini contract for a March session, not a continuous &ldquo;rolling&rdquo; symbol and not a month that has already expired. Point replay at the wrong or dead expiration and the candles may never populate in the first place." },
    { type: "paragraph", html: "Age is the other half of it. Recent data, roughly the last couple of weeks, replays smoothly. Push much further back and freezes get common, particularly on longer runs. Tradovate's Market Replay add-on gives you history stretching back years, so the data is <em>there</em>; it's just that the older the window, the more you should expect to restart and the shorter you should keep each session. If you're studying an old day and the candles keep locking up, break the replay into shorter blocks and restart the browser between them." },
    { type: "paragraph", html: "There's also a workspace behavior to know about. By default Tradovate rolls an expired symbol forward to the next active contract in your quotes, DOM, and charts, helpful for live trading, but a nuisance in replay, where you often want to sit on an old expiration on purpose. Application Settings includes a toggle to stop that auto-roll-forward; turn it off when you need Market Replay to hold an expired contract instead of jumping you to the front month. Confirm the exact wording in your current build, since Tradovate revises these menus periodically." },
    { type: "image", src: `${IMG}/candle-chart-freezes-replay-sim-3.png`, alt: "Tradovate Application Settings with the option to disable automatic contract roll-forward so an expired contract stays loaded in market replay" },
    { type: "heading", text: "Troubleshooting Table" },
    {
      type: "table",
      headers: ["Symptom", "Likely Cause", "Fix"],
      rows: [
        ["Candles frozen, DOM still ticking", "Chart/bar feed stalled; DOM on a separate stream", "Restart the browser or desktop app fully, then reconnect and reload the chart"],
        ["New bars print only the open, no high/low/wick", "Streaming tick updates to the current bar stopped arriving", "Restart to rebuild the chart session; a symbol/tab switch nudges it temporarily"],
        ["Replay freezes on old dates after a while", "Older replay data is unreliable, especially on long runs", "Replay recent data, keep sessions short, restart between blocks"],
        ["Candles never populate at all", "Wrong, continuous, or expired contract loaded", "Load the correct active expiration; disable auto roll-forward for expired-contract replay"],
        ["Every symbol freezes at once, restart doesn't help", "Platform-side issue, often tied to a new release", "Check Tradovate release notes/status; wait for the server-side fix"],
        ["Bars half-drawn or blank", "Missing or delayed market-data subscription", "Confirm a real-time data subscription is active for the instrument"],
      ],
    },
    { type: "heading", text: "Where PickMyTrade Fits" },
    { type: "paragraph", html: "A frozen chart in the sim is an annoyance. A frozen chart with real money on the line is a different animal, if your entries and exits depend on watching bars paint, a stalled feed can cost you a fill at the worst moment. That's the case for taking execution off the chart entirely. PickMyTrade links your TradingView alerts straight to Tradovate and runs the orders on our servers, so your strategy fires whether or not the candles on your screen are updating:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Server-side execution</strong>, alerts route from TradingView to Tradovate through our infrastructure, so a frozen or half-drawn chart never blocks an entry or an exit.",
        "<strong class='text-white'>No manual watching required</strong>, the trade triggers off your alert logic, not off whichever bar your local chart happens to be rendering.",
        "<strong class='text-white'>Stops and targets that stick</strong>, SL/TP defined in the alert are placed on Tradovate regardless of what your display is doing, so protection isn't hostage to a stalled feed.",
        "<strong class='text-white'>Multi-account sync</strong>, mirror the same orders across every connected account at once, so nothing is left unmanaged while you restart a wedged platform.",
      ],
    },
  ], de: [
    { type: "paragraph", html: "Sie sind mitten in einer Replay-Sitzung oder üben im Sim, und die Kerzen bleiben einfach&hellip; stehen. Der aktuelle Balken hängt halb fertig da, oder jeder neue Balken zeigt nur eine flache Eröffnung ohne Hoch, Tief oder Docht. Wechseln Sie zum DOM, und es ist lebendig, die Kurse laufen weiter, als wäre nichts. Schauen Sie zurück zum Chart, und es ist ein Standbild. Genau diese Diskrepanz, ein sich bewegendes Orderbuch neben einem toten Chart, ist das eindeutige Erkennungsmerkmal dieses Fehlers." },
    { type: "paragraph", html: "Hier die Kurzfassung vor den Details: Die schnellste zuverlässige Lösung ist ein <strong class='text-white'>vollständiger Browser-Neustart</strong> – schließen Sie den Browser (oder die Desktop-App) komplett, öffnen Sie ihn erneut, verbinden Sie sich wieder mit Ihrer Sitzung und laden Sie den Chart neu. Das stellt den Daten-Feed des Charts wieder her und behebt das Einfrieren fast immer. Zwei Gewohnheiten verringern die Wahrscheinlichkeit erheblich, dass es überhaupt erst passiert: <strong class='text-white'>aktuelle Daten wiedergeben</strong> (Daten der letzten rund zwei Wochen verhalten sich deutlich besser als ältere Historie) und <strong class='text-white'>den korrekten aktiven Kontraktmonat laden</strong> statt eines abgelaufenen oder fortlaufenden Symbols. Im Folgenden wird erklärt, warum das Einfrieren passiert und wie Sie verhindern, dass es Ihre Übungssitzungen ruiniert." },
    {
      type: "checklist",
      heading: "Kurz-Checkliste",
      items: [
        "<strong class='text-white'>Browser oder Desktop-App vollständig neu starten, dann neu verbinden.</strong> Das ist die Lösung, die wirklich hält – ein einfaches Neuladen reicht oft nicht.",
        "<strong class='text-white'>Erst kurz anstoßen, wenn Sie mitten in der Analyse sind.</strong> Wechseln Sie den Chart zu einem anderen Symbol und zurück, ändern Sie den Zeitrahmen oder wechseln Sie zwischen Chart-Tabs – die Kerzen bauen sich meist kurz neu auf.",
        "<strong class='text-white'>Aktuelle Daten wiedergeben.</strong> Sitzungen aus den letzten rund zwei Wochen hängen deutlich seltener als ältere.",
        "<strong class='text-white'>Den richtigen Kontraktmonat laden.</strong> Verwenden Sie den konkreten Verfallstermin, der an diesem Tag gehandelt wurde, kein fortlaufendes oder abgelaufenes Symbol.",
        "<strong class='text-white'>Lange Replays kürzer halten.</strong> Bei älteren Kontrakten häufen sich Einfrierungen nach 30&ndash;60 Minuten durchgehendem Replay – teilen Sie es in Abschnitte auf.",
        "<strong class='text-white'>Marktdaten für das Symbol prüfen.</strong> Ein fehlendes oder verzögertes Datenabonnement kann Balken halb gezeichnet zurücklassen.",
        "<strong class='text-white'>Release Notes und Status prüfen.</strong> Manche Einfrierungen liegen an der Plattform selbst und verschwinden erst, wenn Tradovate einen Fix ausliefert.",
      ],
    },
    { type: "heading", text: "Was tatsächlich im Hintergrund passiert" },
    { type: "paragraph", html: "Chart und DOM teilen sich keinen Datenpfad, das ist die ganze Geschichte. Das DOM ist direkt an den Live-Kursstream angebunden, jedes Gebot, jeden Brief, jeden Abschluss. Der Chart ist anders aufgebaut: Er lädt zunächst einen Block historischer Balken und legt dann Streaming-Updates darüber, um die aktuelle Kerze wachsen zu lassen und neue zu starten. In Sim und Market Replay stammen diese Kerzen aus einem Replay-/Historien-Feed, der schlicht empfindlicher ist als der reine Kursstream, und er wird umso empfindlicher, je weiter man in der Zeit zurückgeht." },
    { type: "paragraph", html: "Wenn dieser Balken-Feed stockt, läuft das DOM weiter, weil es über eine andere Leitung läuft, aber die Kerzen frieren ein. Erwischt das Einfrieren einen Balken mitten in der Bildung, entsteht das typische Symptom, das immer wieder beschrieben wird: Neue Balken zeigen nur den <strong class='text-white'>Eröffnungskurs</strong>, weil die Tick-Updates, die Hoch, Tief und Schlusskurs füllen würden, einfach ausbleiben. Der Balken kann nicht fertig werden. Genau deshalb wirkt ein harter Neustart: Das erneute Öffnen der App baut die Chart-Sitzung neu auf und verbindet den Feed von Grund auf neu, sodass die Balken wieder gefüllt werden." },
    { type: "quote", html: "Ein eingefrorener Chart ist ein Anzeige- und Datenproblem, kein Geldproblem – aber handeln Sie trotzdem nicht danach. Sind die Kerzen veraltet, kann der Live-Kurs deutlich von dem abweichen, was der letzte Balken zeigt. Lesen Sie den tatsächlichen Kurs im DOM oder im Positionsmodul ab, bevor Sie handeln, und starten Sie neu, um wieder einen verlässlichen Chart zu erhalten." },
    { type: "paragraph", html: "Noch etwas Wichtiges: Das liegt nicht immer an Ihrem eigenen Rechner. Wellen von Meldungen über eingefrorene Kerzen fielen wiederholt mit neuen Plattform-Releases zusammen und wurden dann in einem späteren Tradovate-Update behoben. Helfen Neustart und ein aktueller Kontrakt nicht weiter und frieren alle Symbole gleichzeitig ein, warten Sie womöglich auf eine serverseitige Lösung statt eine lokale Ursache zu suchen." },
    { type: "heading", text: "So beheben Sie es: Neustarten, neu verbinden, neu laden" },
    {
      type: "steps",
      items: [
        { title: "Chart anstoßen (verschafft Ihnen einen Moment)", html: "Wenn Sie nur brauchen, dass der aktuelle Balken kurz aufholt, ohne Ihr Layout zu zerstören, zwingen Sie den Chart zum Neuzeichnen. Wechseln Sie das Symbol auf ein anderes und sofort zurück, stellen Sie den Zeitrahmen eine Stufe höher oder tiefer, oder klicken Sie zwischen Chart-Tabs. Die Kerzen bauen sich in der Regel kurz neu auf und aktualisieren sich. Betrachten Sie das als Übergangslösung – sie ist schnell, aber das Einfrieren kehrt tendenziell zurück, sie ersetzt also nicht den echten Reset." },
        { title: "Browser oder Desktop-App vollständig neu starten", html: "Das ist die Lösung, die hält. Drücken Sie nicht einfach F5, sondern schließen Sie das Browserfenster (oder beenden Sie die Desktop-App) komplett, sodass die Sitzung vollständig beendet wird, und öffnen Sie sie dann erneut. Ein vollständiger Neustart löscht den blockierten Chart-Feed und erzwingt eine saubere Neuverbindung. Auf der Web-Plattform reicht es, alle Tradovate-Tabs zu schließen und einen frischen zu öffnen; auf dem Desktop beenden Sie die App bei Bedarf über das Systemtray oder den Task-Manager, falls sie nicht mehr reagiert, und starten sie neu." },
        { title: "Neu verbinden und Chart neu laden", html: "Melden Sie sich nach dem Neustart wieder an, wählen Sie Ihr Sim- oder Replay-Konto und öffnen Sie das Chart-Modul erneut. Geben Sie ihm einen Moment, um Historie zu laden und mit dem Streaming zu beginnen – der aktuelle Balken sollte wieder Tick für Tick wachsen, mit korrektem Hoch, Tief und Docht. Waren Sie mitten im Replay, starten Sie es ab dem gewünschten Punkt neu; die Balken sollten sich in der frischen Sitzung sauber aufbauen." },
      ],
    },
    { type: "image", src: `${IMG}/candle-chart-freezes-replay-sim-2.png`, alt: "Erneutes Öffnen der Tradovate-Web-Plattform in einem frischen Browserfenster und Neuverbindung mit einer Sim-Sitzung nach einem Chart-Einfrieren" },
    { type: "heading", text: "Den richtigen Kontrakt für das Replay wählen" },
    { type: "paragraph", html: "Die Kontraktwahl ist wichtiger, als die meisten erwarten, und sie ist der größte einzelne Hebel dafür, ob das Replay funktioniert. Laden Sie genau den Kontrakt, der während der Sitzung, die Sie wiedergeben, tatsächlich gehandelt wurde – den echten Verfallstermin, etwa den März-E-mini-Kontrakt für eine März-Sitzung, nicht ein fortlaufendes &ldquo;Rolling&rdquo;-Symbol und keinen bereits abgelaufenen Monat. Richten Sie das Replay auf den falschen oder toten Verfallstermin, füllen sich die Kerzen unter Umständen von Anfang an nie." },
    { type: "paragraph", html: "Das Alter ist die andere Hälfte der Geschichte. Aktuelle Daten, etwa aus den letzten zwei Wochen, laufen im Replay reibungslos. Gehen Sie deutlich weiter zurück, häufen sich Einfrierungen, besonders bei längeren Läufen. Tradovates Market-Replay-Add-on bietet Ihnen Historie über Jahre zurück, die Daten sind also <em>vorhanden</em>; nur gilt: Je älter das Zeitfenster, desto eher sollten Sie mit Neustarts rechnen und desto kürzer sollten Sie jede Sitzung halten. Untersuchen Sie einen alten Tag und die Kerzen frieren immer wieder ein, teilen Sie das Replay in kürzere Abschnitte auf und starten Sie den Browser zwischen den Abschnitten neu." },
    { type: "paragraph", html: "Es gibt außerdem ein Arbeitsbereich-Verhalten, das Sie kennen sollten. Standardmäßig rollt Tradovate ein abgelaufenes Symbol in Ihren Kursen, im DOM und in den Charts auf den nächsten aktiven Kontrakt weiter – hilfreich für den Live-Handel, aber lästig beim Replay, wo Sie oft absichtlich auf einem alten Verfallstermin bleiben möchten. Die Anwendungseinstellungen enthalten einen Schalter, um dieses automatische Weiterrollen zu stoppen; schalten Sie ihn aus, wenn Market Replay einen abgelaufenen Kontrakt halten soll, statt Sie zum vorderen Monat zu springen. Prüfen Sie den genauen Wortlaut in Ihrer aktuellen Version, da Tradovate diese Menüs regelmäßig überarbeitet." },
    { type: "image", src: `${IMG}/candle-chart-freezes-replay-sim-3.png`, alt: "Tradovate-Anwendungseinstellungen mit der Option, das automatische Weiterrollen von Kontrakten zu deaktivieren, sodass ein abgelaufener Kontrakt im Market Replay geladen bleibt" },
    { type: "heading", text: "Fehlerbehebungstabelle" },
    {
      type: "table",
      headers: ["Symptom", "Wahrscheinliche Ursache", "Lösung"],
      rows: [
        ["Kerzen eingefroren, DOM tickt weiter", "Chart-/Balken-Feed gestockt; DOM auf separatem Stream", "Browser oder Desktop-App vollständig neu starten, dann neu verbinden und Chart neu laden"],
        ["Neue Balken zeigen nur die Eröffnung, kein Hoch/Tief/Docht", "Streaming-Tick-Updates für den aktuellen Balken bleiben aus", "Neustart, um die Chart-Sitzung neu aufzubauen; ein Symbol-/Tab-Wechsel stößt sie vorübergehend an"],
        ["Replay friert nach einer Weile bei alten Terminen ein", "Ältere Replay-Daten sind unzuverlässig, besonders bei langen Läufen", "Aktuelle Daten wiedergeben, Sitzungen kurz halten, zwischen Abschnitten neu starten"],
        ["Kerzen füllen sich überhaupt nicht", "Falscher, fortlaufender oder abgelaufener Kontrakt geladen", "Den korrekten aktiven Verfallstermin laden; automatisches Weiterrollen für Replay mit abgelaufenem Kontrakt deaktivieren"],
        ["Alle Symbole frieren gleichzeitig ein, Neustart hilft nicht", "Problem auf Plattformseite, oft im Zusammenhang mit einem neuen Release", "Tradovate-Release-Notes/Status prüfen; auf die serverseitige Lösung warten"],
        ["Balken halb gezeichnet oder leer", "Fehlendes oder verzögertes Marktdatenabonnement", "Prüfen, ob ein Echtzeit-Datenabonnement für das Instrument aktiv ist"],
      ],
    },
    { type: "heading", text: "Wo PickMyTrade ins Spiel kommt" },
    { type: "paragraph", html: "Ein eingefrorener Chart im Sim ist ärgerlich. Ein eingefrorener Chart mit echtem Geld auf dem Spiel ist eine andere Kategorie – hängen Ihre Ein- und Ausstiege davon ab, das Malen der Balken zu beobachten, kann ein stockender Feed Sie im ungünstigsten Moment eine Ausführung kosten. Das spricht dafür, die Ausführung ganz vom Chart zu lösen. PickMyTrade verbindet Ihre TradingView-Alerts direkt mit Tradovate und führt die Orders auf unseren Servern aus, sodass Ihre Strategie auslöst, unabhängig davon, ob sich die Kerzen auf Ihrem Bildschirm aktualisieren:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Serverseitige Ausführung</strong> – Alerts werden von TradingView über unsere Infrastruktur direkt an Tradovate geleitet, sodass ein eingefrorener oder halb gezeichneter Chart nie einen Einstieg oder Ausstieg blockiert.",
        "<strong class='text-white'>Keine manuelle Überwachung nötig</strong> – der Trade wird durch Ihre Alert-Logik ausgelöst, nicht durch den Balken, den Ihr lokaler Chart gerade zeichnet.",
        "<strong class='text-white'>Stopps und Ziele, die halten</strong> – im Alert definierte SL/TP werden bei Tradovate platziert, unabhängig davon, was Ihre Anzeige tut, sodass der Schutz nicht von einem stockenden Feed abhängt.",
        "<strong class='text-white'>Multi-Konto-Synchronisierung</strong> – spiegeln Sie dieselben Orders gleichzeitig auf jedem verbundenen Konto, sodass nichts unversorgt bleibt, während Sie eine blockierte Plattform neu starten.",
      ],
    },
  ], es: [
    { type: "paragraph", html: "Está inmerso en una sesión de repetición o practicando en el simulador, y las velas simplemente&hellip; se detienen. La barra actual queda a medio formar, o cada barra nueva muestra una apertura plana sin máximo, mínimo ni mecha. Cambie al DOM y está vivo, las cotizaciones siguen moviéndose como si nada pasara. Vuelva a mirar el gráfico y es una foto fija. Esa disparidad, un libro de órdenes en movimiento junto a un gráfico muerto, es la firma exacta de este problema." },
    { type: "paragraph", html: "Aquí va la versión corta antes de los detalles: la recuperación fiable más rápida es un <strong class='text-white'>reinicio completo del navegador</strong>, cierre el navegador (o la aplicación de escritorio) por completo, vuelva a abrirlo, reconéctese a su sesión y recargue el gráfico. Eso restablece el feed de datos del gráfico y elimina el bloqueo casi siempre. Dos hábitos reducen mucho la probabilidad de que ocurra: <strong class='text-white'>reproducir fechas recientes</strong> (los datos de las últimas dos semanas, aproximadamente, se comportan mucho mejor que el histórico antiguo) y <strong class='text-white'>cargar el mes de contrato activo correcto</strong> en lugar de un símbolo vencido o continuo. A continuación se explica por qué ocurre el bloqueo y cómo evitar que arruine sus sesiones de práctica." },
    {
      type: "checklist",
      heading: "Lista rápida de verificación",
      items: [
        "<strong class='text-white'>Reinicie por completo el navegador o la aplicación de escritorio y vuelva a conectarse.</strong> Esta es la solución que realmente funciona; una simple actualización de página a menudo no basta.",
        "<strong class='text-white'>Primero intente un pequeño empujón si está en pleno análisis.</strong> Cambie el gráfico a otro símbolo y vuelva, cambie el marco temporal o alterne entre pestañas de gráficos; las velas suelen redibujarse por un momento.",
        "<strong class='text-white'>Reproduzca datos recientes.</strong> Las sesiones de las últimas dos semanas, aproximadamente, se bloquean mucho menos que las más antiguas.",
        "<strong class='text-white'>Cargue el mes de contrato correcto.</strong> Use el vencimiento específico que se negociaba ese día, no un símbolo continuo o vencido.",
        "<strong class='text-white'>Mantenga las repeticiones largas más cortas.</strong> Los bloqueos se acumulan después de 30&ndash;60 minutos de repetición continua en contratos antiguos; divídala en tramos.",
        "<strong class='text-white'>Confirme los datos de mercado del símbolo.</strong> Una suscripción de datos ausente o retrasada puede dejar barras a medio dibujar.",
        "<strong class='text-white'>Revise las notas de la versión y el estado del servicio.</strong> Algunos bloqueos son del lado de la plataforma y solo se resuelven cuando Tradovate publica una corrección.",
      ],
    },
    { type: "heading", text: "Qué está pasando realmente por dentro" },
    { type: "paragraph", html: "El gráfico y el DOM no comparten una ruta de datos, y esa es toda la historia. El DOM está conectado directamente al flujo de cotizaciones en vivo, cada oferta, demanda y operación. El gráfico se construye de forma distinta: obtiene un bloque de barras históricas y luego superpone actualizaciones en streaming para hacer crecer la vela actual e iniciar otras nuevas. En el simulador y en la repetición de mercado, esas velas provienen de un feed de repetición/histórico que es simplemente más delicado que el flujo de cotizaciones puro, y se vuelve más delicado cuanto más se retrocede en el tiempo." },
    { type: "paragraph", html: "Cuando ese feed de barras se bloquea, el DOM sigue funcionando porque está en otra vía, pero las velas se congelan. Si el bloqueo atrapa una barra a mitad de su formación, aparece el síntoma característico que la gente describe una y otra vez: las barras nuevas muestran solo el precio de <strong class='text-white'>apertura</strong>, porque las actualizaciones tick a tick que completarían el máximo, el mínimo y el cierre simplemente dejan de llegar. La barra no puede terminarse. Por eso también funciona un reinicio completo: al reabrir la aplicación se reconstruye la sesión del gráfico y se reconecta el feed desde cero, así que las barras vuelven a completarse." },
    { type: "quote", html: "Un gráfico congelado es un problema de visualización y de datos, no un problema de dinero, pero no opere basándose en él. Si las velas están desactualizadas, el precio en vivo podría estar bastante alejado de lo que muestra la última barra. Consulte el precio real en el DOM o en el módulo de posiciones antes de actuar, y reinicie para recuperar un gráfico fiable." },
    { type: "paragraph", html: "Algo más que conviene saber: esto no siempre depende de su equipo. Oleadas de reportes de velas congeladas han coincidido con nuevas versiones de la plataforma y luego se han solucionado en una actualización posterior de Tradovate. Si un reinicio y un contrato reciente no ayudan, y todos los símbolos se congelan a la vez, es posible que esté esperando una corrección del lado del servidor en lugar de perseguir una causa local." },
    { type: "heading", text: "Solucionarlo: reiniciar, reconectar, recargar" },
    {
      type: "steps",
      items: [
        { title: "Dé un pequeño empujón al gráfico (le da un momento de margen)", html: "Si solo necesita que la barra actual se ponga al día sin destruir su diseño, obligue al gráfico a redibujarse. Cambie el símbolo a otro y vuelva de inmediato, suba o baje un nivel el marco temporal, o haga clic entre pestañas de gráficos. Las velas normalmente se redibujan y actualizan por un rato. Trátelo como una solución provisional, es rápida, pero el bloqueo tiende a reaparecer, así que no sustituye al reinicio real." },
        { title: "Reinicie por completo el navegador o la aplicación de escritorio", html: "Esta es la solución que perdura. No se limite a pulsar F5; cierre por completo la ventana del navegador (o cierre del todo la aplicación de escritorio) para que la sesión quede totalmente finalizada, y luego vuelva a abrirla. Un reinicio completo elimina el feed de gráfico atascado y fuerza una reconexión limpia. En la plataforma web basta con cerrar todas las pestañas de Tradovate y abrir una nueva; en el escritorio, si no responde, cierre la aplicación desde la bandeja del sistema o el administrador de tareas y vuelva a iniciarla." },
        { title: "Reconéctese y recargue el gráfico", html: "Después del reinicio, vuelva a iniciar sesión, seleccione su cuenta de simulador o repetición, y vuelva a abrir el módulo de gráficos. Déle un momento para obtener el histórico y comenzar a transmitir datos; la barra actual debería volver a crecer tick a tick, con máximos, mínimos y mechas correctos. Si estaba en mitad de una repetición, reinícala desde el punto que necesite; las barras deberían completarse limpiamente en la sesión nueva." },
      ],
    },
    { type: "image", src: `${IMG}/candle-chart-freezes-replay-sim-2.png`, alt: "Reapertura de la plataforma web de Tradovate en una ventana de navegador nueva y reconexión a una sesión de simulador tras un bloqueo del gráfico" },
    { type: "heading", text: "Elija el contrato correcto para la repetición" },
    { type: "paragraph", html: "La elección del contrato importa más de lo que la mayoría espera, y es la palanca individual más importante para que la repetición funcione bien. Cargue exactamente el contrato que realmente se negociaba durante la sesión que está reproduciendo, el vencimiento real, como el contrato E-mini de marzo para una sesión de marzo, no un símbolo continuo &ldquo;rolling&rdquo; ni un mes que ya haya vencido. Si dirige la repetición a un vencimiento incorrecto o muerto, es posible que las velas nunca lleguen a completarse." },
    { type: "paragraph", html: "La antigüedad es la otra mitad del asunto. Los datos recientes, de las últimas dos semanas aproximadamente, se reproducen sin problemas. Retroceda mucho más y los bloqueos se vuelven habituales, sobre todo en sesiones largas. El complemento Market Replay de Tradovate le da acceso a un histórico de varios años, así que los datos <em>sí están ahí</em>; simplemente, cuanto más antigua sea la ventana, más debe esperar reiniciar y más corta debe mantener cada sesión. Si estudia un día antiguo y las velas siguen bloqueándose, divida la repetición en tramos más cortos y reinicie el navegador entre ellos." },
    { type: "paragraph", html: "También hay un comportamiento del espacio de trabajo que conviene conocer. Por defecto, Tradovate hace avanzar automáticamente un símbolo vencido al siguiente contrato activo en sus cotizaciones, DOM y gráficos, algo útil para operar en vivo, pero una molestia en la repetición, donde a menudo quiere quedarse deliberadamente en un vencimiento antiguo. Los ajustes de la aplicación incluyen un interruptor para detener ese avance automático; desactívelo cuando necesite que Market Replay mantenga un contrato vencido en lugar de llevarlo al mes frontal. Confirme la redacción exacta en su versión actual, ya que Tradovate revisa estos menús periódicamente." },
    { type: "image", src: `${IMG}/candle-chart-freezes-replay-sim-3.png`, alt: "Ajustes de la aplicación de Tradovate con la opción para desactivar el avance automático del contrato, de modo que un contrato vencido permanezca cargado en la repetición de mercado" },
    { type: "heading", text: "Tabla de resolución de problemas" },
    {
      type: "table",
      headers: ["Síntoma", "Causa probable", "Solución"],
      rows: [
        ["Velas congeladas, el DOM sigue actualizándose", "El feed del gráfico/barras se bloqueó; el DOM va por un flujo aparte", "Reinicie por completo el navegador o la aplicación de escritorio, luego reconéctese y recargue el gráfico"],
        ["Las barras nuevas solo muestran la apertura, sin máximo/mínimo/mecha", "Dejaron de llegar las actualizaciones tick a tick de la barra actual", "Reinicie para reconstruir la sesión del gráfico; cambiar de símbolo/pestaña la reactiva temporalmente"],
        ["La repetición se bloquea en fechas antiguas tras un rato", "Los datos de repetición antiguos son poco fiables, sobre todo en sesiones largas", "Reproduzca datos recientes, mantenga las sesiones cortas, reinicie entre tramos"],
        ["Las velas nunca llegan a completarse", "Se cargó un contrato incorrecto, continuo o vencido", "Cargue el vencimiento activo correcto; desactive el avance automático para repeticiones con contrato vencido"],
        ["Todos los símbolos se congelan a la vez, el reinicio no ayuda", "Problema del lado de la plataforma, a menudo ligado a una nueva versión", "Consulte las notas de la versión o el estado de Tradovate; espere la corrección del lado del servidor"],
        ["Barras a medio dibujar o en blanco", "Suscripción de datos de mercado ausente o retrasada", "Confirme que hay una suscripción de datos en tiempo real activa para el instrumento"],
      ],
    },
    { type: "heading", text: "Dónde encaja PickMyTrade" },
    { type: "paragraph", html: "Un gráfico congelado en el simulador es una molestia. Un gráfico congelado con dinero real en juego es otro asunto muy distinto; si sus entradas y salidas dependen de observar cómo se dibujan las barras, un feed bloqueado puede costarle una ejecución en el peor momento posible. Ese es el argumento para sacar la ejecución del gráfico por completo. PickMyTrade conecta sus alertas de TradingView directamente con Tradovate y ejecuta las órdenes en nuestros servidores, de modo que su estrategia se activa independientemente de que las velas de su pantalla se estén actualizando o no:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Ejecución del lado del servidor</strong>, las alertas se enrutan de TradingView a Tradovate a través de nuestra infraestructura, así que un gráfico congelado o a medio dibujar nunca bloquea una entrada ni una salida.",
        "<strong class='text-white'>No requiere vigilancia manual</strong>, la operación se activa por la lógica de su alerta, no por la barra que su gráfico local esté renderizando en ese momento.",
        "<strong class='text-white'>Stops y objetivos que se mantienen firmes</strong>, el SL/TP definido en la alerta se coloca en Tradovate sin importar lo que haga su pantalla, así que la protección no depende de un feed bloqueado.",
        "<strong class='text-white'>Sincronización multicuenta</strong>, replique las mismas órdenes en todas las cuentas conectadas a la vez, de modo que nada quede sin gestionar mientras reinicia una plataforma atascada.",
      ],
    },
  ], fr: [
    { type: "paragraph", html: "Vous êtes en pleine session de replay ou en train de vous entraîner sur le simulateur, et les chandeliers s'arrêtent tout simplement&hellip;. La barre en cours reste à moitié formée, ou chaque nouvelle barre affiche une ouverture plate sans plus haut, plus bas ni mèche. Passez au DOM et il est bien vivant, les cotations continuent de défiler comme si de rien n'était. Regardez de nouveau le graphique et c'est une photo figée. Ce décalage, un carnet d'ordres qui bouge à côté d'un graphique mort, est la signature exacte de ce bug." },
    { type: "paragraph", html: "Voici la version courte avant les détails : la solution la plus rapide et la plus fiable est un <strong class='text-white'>redémarrage complet du navigateur</strong>, fermez complètement le navigateur (ou l'application de bureau), rouvrez-le, reconnectez-vous à votre session et rechargez le graphique. Cela rétablit le flux de données du graphique et supprime le blocage presque à chaque fois. Deux habitudes réduisent nettement le risque que cela se produise : <strong class='text-white'>rejouer des dates récentes</strong> (les données des deux dernières semaines environ se comportent bien mieux qu'un historique plus ancien) et <strong class='text-white'>charger le bon mois de contrat actif</strong> plutôt qu'un symbole expiré ou continu. Tout ce qui suit explique pourquoi ce blocage se produit et comment éviter qu'il ne gâche vos sessions d'entraînement." },
    {
      type: "checklist",
      heading: "Liste de vérification rapide",
      items: [
        "<strong class='text-white'>Redémarrez complètement le navigateur ou l'application de bureau, puis reconnectez-vous.</strong> C'est la solution qui tient vraiment, un simple rafraîchissement ne suffit souvent pas.",
        "<strong class='text-white'>Donnez-lui d'abord une petite impulsion si vous êtes en pleine analyse.</strong> Changez le graphique vers un autre symbole puis revenez, modifiez l'unité de temps ou basculez entre les onglets de graphiques, les chandeliers se redessinent généralement pendant un instant.",
        "<strong class='text-white'>Rejouez des données récentes.</strong> Les sessions des deux dernières semaines environ se bloquent bien moins que les plus anciennes.",
        "<strong class='text-white'>Chargez le bon mois de contrat.</strong> Utilisez l'échéance précise qui se négociait ce jour-là, pas un symbole continu ou expiré.",
        "<strong class='text-white'>Raccourcissez les longs replays.</strong> Les blocages s'accumulent après 30&ndash;60 minutes de replay continu sur des contrats anciens, découpez-le en plusieurs segments.",
        "<strong class='text-white'>Vérifiez les données de marché du symbole.</strong> Un abonnement de données manquant ou retardé peut laisser des barres à moitié dessinées.",
        "<strong class='text-white'>Consultez les notes de version et le statut.</strong> Certains blocages viennent de la plateforme elle-même et ne disparaissent que lorsque Tradovate publie un correctif.",
      ],
    },
    { type: "heading", text: "Ce qui se passe réellement en coulisses" },
    { type: "paragraph", html: "Le graphique et le DOM ne partagent pas la même source de données, et c'est toute l'histoire. Le DOM est connecté directement au flux de cotations en direct, chaque offre, chaque demande, chaque transaction. Le graphique est construit différemment : il récupère un bloc de barres historiques, puis superpose des mises à jour en streaming pour faire grandir le chandelier en cours et en démarrer de nouveaux. En simulation et en replay de marché, ces chandeliers proviennent d'un flux replay/historique tout simplement plus fragile que le flux de cotations brut, et il devient plus fragile encore à mesure que l'on remonte dans le temps." },
    { type: "paragraph", html: "Lorsque ce flux de barres se bloque, le DOM continue de fonctionner car il passe par un autre canal, mais les chandeliers se figent. Si le blocage surprend une barre en cours de formation, on obtient le symptôme caractéristique décrit encore et encore : les nouvelles barres n'affichent que le prix d'<strong class='text-white'>ouverture</strong>, car les mises à jour tick par tick qui rempliraient le plus haut, le plus bas et la clôture cessent tout simplement d'arriver. La barre ne peut pas se terminer. C'est aussi pourquoi un redémarrage complet fonctionne : rouvrir l'application reconstruit la session du graphique et reconnecte le flux depuis le début, si bien que les barres recommencent à se remplir." },
    { type: "quote", html: "Un graphique figé est un problème d'affichage et de données, pas un problème d'argent, mais ne tradez pas dessus pour autant. Si les chandeliers sont obsolètes, le prix en direct peut être très éloigné de ce que montre la dernière barre. Lisez le prix réel dans le DOM ou le module de positions avant d'agir, et redémarrez pour retrouver un graphique fiable." },
    { type: "paragraph", html: "Autre chose à savoir : ce n'est pas toujours de votre côté. Des vagues de signalements de chandeliers figés ont coïncidé avec de nouvelles versions de la plateforme, puis ont été corrigées dans une mise à jour Tradovate ultérieure. Si un redémarrage et un contrat récent n'aident pas et que tous les symboles se figent en même temps, vous attendez peut-être un correctif côté serveur plutôt qu'une cause locale." },
    { type: "heading", text: "La solution : redémarrer, se reconnecter, recharger" },
    {
      type: "steps",
      items: [
        { title: "Donnez une impulsion au graphique (vous gagne un instant)", html: "Si vous avez simplement besoin que la barre en cours se remette à jour sans détruire votre mise en page, forcez le graphique à se redessiner. Changez le symbole pour un autre puis revenez immédiatement, montez ou descendez l'unité de temps d'un cran, ou cliquez entre les onglets de graphiques. Les chandeliers se redessinent et se mettent généralement à jour pendant un moment. Considérez cela comme une solution temporaire, c'est rapide, mais le blocage a tendance à revenir, ce n'est donc pas un substitut à la vraie réinitialisation." },
        { title: "Redémarrez complètement le navigateur ou l'application de bureau", html: "C'est la solution qui tient dans la durée. Ne vous contentez pas d'appuyer sur F5 ; fermez entièrement la fenêtre du navigateur (ou quittez complètement l'application de bureau) pour que la session soit totalement fermée, puis rouvrez-la. Un redémarrage complet efface le flux de graphique bloqué et force une reconnexion propre. Sur la plateforme web, fermer tous les onglets Tradovate et en rouvrir un nouveau suffit ; sur le bureau, quittez l'application depuis la zone de notification ou le gestionnaire des tâches si elle ne répond plus, puis relancez-la." },
        { title: "Reconnectez-vous et rechargez le graphique", html: "Après le redémarrage, reconnectez-vous, sélectionnez votre compte de simulation ou de replay, et rouvrez le module graphique. Laissez-lui un instant pour récupérer l'historique et démarrer le streaming, la barre en cours devrait de nouveau grandir tick par tick, avec des plus hauts, plus bas et mèches corrects. Si vous étiez en plein replay, redémarrez-le à partir du point souhaité ; les barres devraient se remplir correctement sur la nouvelle session." },
      ],
    },
    { type: "image", src: `${IMG}/candle-chart-freezes-replay-sim-2.png`, alt: "Réouverture de la plateforme web Tradovate dans une nouvelle fenêtre de navigateur et reconnexion à une session de simulation après un blocage du graphique" },
    { type: "heading", text: "Choisir le bon contrat pour le replay" },
    { type: "paragraph", html: "Le choix du contrat compte plus que ce que la plupart des gens imaginent, et c'est le levier le plus important pour que le replay fonctionne correctement. Chargez exactement le contrat qui se négociait réellement pendant la session que vous rejouez, l'échéance réelle, comme le contrat E-mini de mars pour une session de mars, pas un symbole continu « rolling » ni un mois déjà expiré. Pointer le replay vers une échéance erronée ou morte peut empêcher les chandeliers de se remplir dès le départ." },
    { type: "paragraph", html: "L'ancienneté est l'autre moitié du problème. Les données récentes, environ les deux dernières semaines, se rejouent sans accroc. Remontez beaucoup plus loin et les blocages deviennent fréquents, en particulier sur les sessions longues. Le module complémentaire Market Replay de Tradovate vous donne accès à un historique remontant à plusieurs années, les données sont donc bien <em>présentes</em> ; simplement, plus la fenêtre est ancienne, plus vous devez vous attendre à redémarrer et plus vous devez raccourcir chaque session. Si vous étudiez une ancienne journée et que les chandeliers continuent de se bloquer, découpez le replay en segments plus courts et redémarrez le navigateur entre chacun." },
    { type: "paragraph", html: "Il existe aussi un comportement d'espace de travail à connaître. Par défaut, Tradovate fait avancer automatiquement un symbole expiré vers le contrat actif suivant dans vos cotations, votre DOM et vos graphiques, ce qui est utile pour le trading en direct, mais gênant en replay, où vous souhaitez souvent rester délibérément sur une ancienne échéance. Les paramètres de l'application incluent un interrupteur pour désactiver cette bascule automatique ; désactivez-la lorsque vous avez besoin que Market Replay conserve un contrat expiré au lieu de vous faire passer au mois le plus proche. Vérifiez le libellé exact dans votre version actuelle, car Tradovate révise régulièrement ces menus." },
    { type: "image", src: `${IMG}/candle-chart-freezes-replay-sim-3.png`, alt: "Paramètres de l'application Tradovate avec l'option permettant de désactiver la bascule automatique de contrat, afin qu'un contrat expiré reste chargé dans le replay de marché" },
    { type: "heading", text: "Tableau de dépannage" },
    {
      type: "table",
      headers: ["Symptôme", "Cause probable", "Solution"],
      rows: [
        ["Chandeliers figés, le DOM continue de s'actualiser", "Flux du graphique/des barres bloqué ; le DOM utilise un flux séparé", "Redémarrez complètement le navigateur ou l'application de bureau, puis reconnectez-vous et rechargez le graphique"],
        ["Les nouvelles barres n'affichent que l'ouverture, sans plus haut/plus bas/mèche", "Les mises à jour tick par tick de la barre en cours ont cessé d'arriver", "Redémarrez pour reconstruire la session du graphique ; changer de symbole/onglet le relance temporairement"],
        ["Le replay se bloque sur d'anciennes dates après un moment", "Les données de replay anciennes sont peu fiables, surtout sur les sessions longues", "Rejouez des données récentes, gardez des sessions courtes, redémarrez entre les segments"],
        ["Les chandeliers ne se remplissent jamais", "Contrat erroné, continu ou expiré chargé", "Chargez l'échéance active correcte ; désactivez la bascule automatique pour le replay avec un contrat expiré"],
        ["Tous les symboles se figent en même temps, le redémarrage n'aide pas", "Problème côté plateforme, souvent lié à une nouvelle version", "Consultez les notes de version/le statut de Tradovate ; attendez le correctif côté serveur"],
        ["Barres à moitié dessinées ou vides", "Abonnement aux données de marché manquant ou retardé", "Vérifiez qu'un abonnement de données en temps réel est actif pour l'instrument"],
      ],
    },
    { type: "heading", text: "Où PickMyTrade intervient" },
    { type: "paragraph", html: "Un graphique figé en simulation est une gêne. Un graphique figé avec de l'argent réel en jeu est une tout autre affaire ; si vos entrées et sorties dépendent de l'observation de la formation des barres, un flux bloqué peut vous coûter une exécution au pire moment. C'est l'argument en faveur de retirer complètement l'exécution du graphique. PickMyTrade relie vos alertes TradingView directement à Tradovate et exécute les ordres sur nos serveurs, de sorte que votre stratégie se déclenche que les chandeliers de votre écran se mettent à jour ou non :" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Exécution côté serveur</strong>, les alertes sont acheminées de TradingView vers Tradovate via notre infrastructure, si bien qu'un graphique figé ou à moitié dessiné ne bloque jamais une entrée ou une sortie.",
        "<strong class='text-white'>Aucune surveillance manuelle requise</strong>, la transaction se déclenche selon la logique de votre alerte, et non selon la barre que votre graphique local est en train d'afficher.",
        "<strong class='text-white'>Des stops et objectifs qui tiennent</strong>, le SL/TP défini dans l'alerte est placé sur Tradovate quel que soit l'état de votre affichage, la protection ne dépend donc pas d'un flux bloqué.",
        "<strong class='text-white'>Synchronisation multi-compte</strong>, répliquez les mêmes ordres sur tous les comptes connectés à la fois, afin que rien ne reste sans surveillance pendant que vous redémarrez une plateforme bloquée.",
      ],
    },
  ], it: [
    { type: "paragraph", html: "È nel bel mezzo di una sessione di replay o si sta esercitando sul simulatore, e le candele semplicemente&hellip; si fermano. La barra corrente resta a metà formata, oppure ogni nuova barra mostra un'apertura piatta senza massimo, minimo o ombra. Passi al DOM ed è vivo, le quotazioni continuano a scorrere come se nulla fosse. Torni a guardare il grafico ed è una foto ferma. Questo scarto, un libro ordini in movimento accanto a un grafico morto, è la firma esatta di questo bug." },
    { type: "paragraph", html: "Ecco la versione breve prima dei dettagli: il ripristino affidabile più rapido è un <strong class='text-white'>riavvio completo del browser</strong>, chiuda completamente il browser (o l'app desktop), lo riapra, si riconnetta alla sessione e ricarichi il grafico. Questo ristabilisce il feed dati del grafico ed elimina il blocco quasi sempre. Due abitudini riducono molto la probabilità che accada del tutto: <strong class='text-white'>riprodurre date recenti</strong> (i dati delle ultime due settimane circa si comportano molto meglio di uno storico più vecchio) e <strong class='text-white'>caricare il mese di contratto attivo corretto</strong> invece di un simbolo scaduto o continuo. Tutto ciò che segue spiega perché si verifica il blocco e come evitare che rovini le sue sessioni di pratica." },
    {
      type: "checklist",
      heading: "Lista di controllo rapida",
      items: [
        "<strong class='text-white'>Riavvii completamente il browser o l'app desktop, quindi si riconnetta.</strong> Questo è il ripristino che funziona davvero, un semplice aggiornamento della pagina spesso non basta.",
        "<strong class='text-white'>Provi prima a smuoverlo se è a metà di un'analisi.</strong> Cambi il grafico su un altro simbolo e torni indietro, modifichi il timeframe o passi tra le schede del grafico, di solito le candele si ridisegnano per un momento.",
        "<strong class='text-white'>Riproduca dati recenti.</strong> Le sessioni delle ultime due settimane circa si bloccano molto meno di quelle più vecchie.",
        "<strong class='text-white'>Carichi il mese di contratto corretto.</strong> Usi la scadenza specifica che veniva negoziata quel giorno, non un simbolo continuo o scaduto.",
        "<strong class='text-white'>Tenga i replay lunghi più brevi.</strong> I blocchi si accumulano dopo 30&ndash;60 minuti di replay continuo su contratti più vecchi, lo suddivida in blocchi più piccoli.",
        "<strong class='text-white'>Confermi i dati di mercato per il simbolo.</strong> Un abbonamento ai dati mancante o in ritardo può lasciare le barre disegnate a metà.",
        "<strong class='text-white'>Controlli le note di rilascio e lo stato del servizio.</strong> Alcuni blocchi dipendono dalla piattaforma e si risolvono solo quando Tradovate rilascia una correzione.",
      ],
    },
    { type: "heading", text: "Cosa succede realmente dietro le quinte" },
    { type: "paragraph", html: "Il grafico e il DOM non condividono lo stesso percorso dati, ed è tutta qui la questione. Il DOM è collegato direttamente al flusso di quotazioni in tempo reale, ogni bid, ask e transazione. Il grafico è costruito in modo diverso: recupera un blocco di barre storiche, quindi aggiunge aggiornamenti in streaming per far crescere la candela corrente e avviarne di nuove. In modalità sim e nel replay di mercato, quelle candele provengono da un feed di replay/storico semplicemente più delicato del flusso di quotazioni grezzo, e diventa ancora più delicato più si torna indietro nel tempo." },
    { type: "paragraph", html: "Quando quel feed di barre si blocca, il DOM continua a funzionare perché passa da un canale diverso, ma le candele si congelano. Se il blocco coglie una barra a metà formazione, si presenta il sintomo tipico descritto ripetutamente: le nuove barre mostrano solo il prezzo di <strong class='text-white'>apertura</strong>, perché gli aggiornamenti tick che completerebbero massimo, minimo e chiusura semplicemente smettono di arrivare. La barra non può completarsi. È anche per questo che un riavvio completo funziona: riaprire l'app ricostruisce la sessione del grafico e riconnette il feed da zero, così le barre ricominciano a popolarsi." },
    { type: "quote", html: "Un grafico bloccato è un problema di visualizzazione e di dati, non un problema di denaro, ma non faccia trading basandosi su di esso. Se le candele sono obsolete, il prezzo in tempo reale potrebbe essere ben distante da ciò che mostra l'ultima barra. Legga il prezzo reale sul DOM o nel modulo posizioni prima di agire, e riavvii per ottenere di nuovo un grafico affidabile." },
    { type: "paragraph", html: "Un'altra cosa da sapere: non dipende sempre dal suo computer. Ondate di segnalazioni di candele bloccate hanno coinciso con nuove versioni della piattaforma e sono state poi risolte in un successivo aggiornamento Tradovate. Se un riavvio e un contratto recente non aiutano e tutti i simboli si bloccano contemporaneamente, potrebbe essere in attesa di una correzione lato server piuttosto che di una causa locale." },
    { type: "heading", text: "Come risolverlo: riavviare, riconnettersi, ricaricare" },
    {
      type: "steps",
      items: [
        { title: "Smuova il grafico (guadagna un momento)", html: "Se le serve solo che la barra corrente si aggiorni senza distruggere il suo layout, forzi il grafico a ridisegnarsi. Cambi il simbolo con un altro e torni subito indietro, alzi o abbassi il timeframe di un livello, oppure clicchi tra le schede del grafico. Le candele in genere si ridisegnano e si aggiornano per un po'. Consideri questa una soluzione temporanea: è veloce, ma il blocco tende a ripresentarsi, quindi non sostituisce il vero ripristino." },
        { title: "Riavvii completamente il browser o l'app desktop", html: "Questa è la soluzione che dura. Non si limiti a premere F5; chiuda completamente la finestra del browser (o esca del tutto dall'app desktop) in modo che la sessione venga chiusa completamente, quindi la riapra. Un riavvio completo elimina il feed del grafico bloccato e forza una riconnessione pulita. Sulla piattaforma web basta chiudere tutte le schede Tradovate e riaprirne una nuova; sul desktop, se l'app non risponde, la chiuda dalla barra delle applicazioni o dal task manager e la riavvii." },
        { title: "Si riconnetta e ricarichi il grafico", html: "Dopo il riavvio, effettui di nuovo l'accesso, selezioni il suo account sim o replay e riapra il modulo grafico. Gli dia un momento per recuperare lo storico e avviare lo streaming: la barra corrente dovrebbe tornare a crescere tick dopo tick, con massimi, minimi e ombre corretti. Se era a metà di un replay, lo riavvii dal punto necessario; le barre dovrebbero popolarsi correttamente nella nuova sessione." },
      ],
    },
    { type: "image", src: `${IMG}/candle-chart-freezes-replay-sim-2.png`, alt: "Riapertura della piattaforma web Tradovate in una nuova finestra del browser e riconnessione a una sessione sim dopo un blocco del grafico" },
    { type: "heading", text: "Scegliere il contratto giusto per il replay" },
    { type: "paragraph", html: "La scelta del contratto conta più di quanto la maggior parte delle persone si aspetti, ed è la leva singola più importante per il corretto funzionamento del replay. Carichi esattamente il contratto che veniva effettivamente negoziato durante la sessione che sta riproducendo, la scadenza reale, come il contratto E-mini di marzo per una sessione di marzo, non un simbolo continuo &ldquo;rolling&rdquo; e non un mese già scaduto. Se punta il replay su una scadenza sbagliata o non più attiva, le candele potrebbero non popolarsi affatto." },
    { type: "paragraph", html: "L'anzianità dei dati è l'altra metà della questione. I dati recenti, circa delle ultime due settimane, si riproducono senza problemi. Andando molto più indietro, i blocchi diventano frequenti, soprattutto nelle sessioni più lunghe. Il componente aggiuntivo Market Replay di Tradovate offre uno storico che risale ad anni fa, quindi i dati <em>ci sono</em>; semplicemente, più vecchia è la finestra temporale, più deve aspettarsi di dover riavviare e più corta deve tenere ogni sessione. Se sta studiando un giorno lontano nel tempo e le candele continuano a bloccarsi, suddivida il replay in blocchi più brevi e riavvii il browser tra un blocco e l'altro." },
    { type: "paragraph", html: "C'è anche un comportamento dello spazio di lavoro da conoscere. Per impostazione predefinita, Tradovate fa avanzare automaticamente un simbolo scaduto verso il contratto attivo successivo nelle sue quotazioni, nel DOM e nei grafici, utile per il trading live, ma fastidioso nel replay, dove spesso si vuole restare deliberatamente su una scadenza vecchia. Le impostazioni dell'applicazione includono un interruttore per fermare questo avanzamento automatico; lo disattivi quando ha bisogno che Market Replay mantenga un contratto scaduto invece di farla passare al mese corrente. Verifichi la dicitura esatta nella sua versione attuale, poiché Tradovate rivede periodicamente questi menu." },
    { type: "image", src: `${IMG}/candle-chart-freezes-replay-sim-3.png`, alt: "Impostazioni dell'applicazione Tradovate con l'opzione per disattivare l'avanzamento automatico del contratto, in modo che un contratto scaduto rimanga caricato nel replay di mercato" },
    { type: "heading", text: "Tabella di risoluzione dei problemi" },
    {
      type: "table",
      headers: ["Sintomo", "Causa probabile", "Soluzione"],
      rows: [
        ["Candele bloccate, il DOM continua ad aggiornarsi", "Feed del grafico/delle barre bloccato; il DOM è su uno stream separato", "Riavvii completamente il browser o l'app desktop, quindi si riconnetta e ricarichi il grafico"],
        ["Le nuove barre mostrano solo l'apertura, senza massimo/minimo/ombra", "Gli aggiornamenti tick della barra corrente hanno smesso di arrivare", "Riavvii per ricostruire la sessione del grafico; il cambio di simbolo/scheda la smuove temporaneamente"],
        ["Il replay si blocca su date vecchie dopo un po'", "I dati di replay più vecchi sono inaffidabili, specialmente nelle sessioni lunghe", "Riproduca dati recenti, tenga le sessioni brevi, riavvii tra un blocco e l'altro"],
        ["Le candele non si popolano mai", "Contratto sbagliato, continuo o scaduto caricato", "Carichi la scadenza attiva corretta; disattivi l'avanzamento automatico per il replay con contratto scaduto"],
        ["Tutti i simboli si bloccano contemporaneamente, il riavvio non aiuta", "Problema lato piattaforma, spesso legato a una nuova versione", "Controlli le note di rilascio/lo stato di Tradovate; attenda la correzione lato server"],
        ["Barre disegnate a metà o vuote", "Abbonamento ai dati di mercato mancante o in ritardo", "Confermi che un abbonamento ai dati in tempo reale sia attivo per lo strumento"],
      ],
    },
    { type: "heading", text: "Dove si inserisce PickMyTrade" },
    { type: "paragraph", html: "Un grafico bloccato nel simulatore è un fastidio. Un grafico bloccato con denaro reale in gioco è tutta un'altra storia: se i suoi ingressi e uscite dipendono dall'osservare la formazione delle barre, un feed bloccato può costarle un'esecuzione nel momento peggiore. Questo è l'argomento a favore di spostare del tutto l'esecuzione fuori dal grafico. PickMyTrade collega i suoi alert di TradingView direttamente a Tradovate ed esegue gli ordini sui nostri server, così la sua strategia scatta indipendentemente dal fatto che le candele sullo schermo si stiano aggiornando o meno:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Esecuzione lato server</strong>, gli alert vengono instradati da TradingView a Tradovate tramite la nostra infrastruttura, quindi un grafico bloccato o disegnato a metà non blocca mai un ingresso o un'uscita.",
        "<strong class='text-white'>Nessun monitoraggio manuale richiesto</strong>, l'operazione si attiva in base alla logica del suo alert, non in base alla barra che il grafico locale sta visualizzando in quel momento.",
        "<strong class='text-white'>Stop e target che tengono</strong>, lo SL/TP definito nell'alert viene posizionato su Tradovate indipendentemente da ciò che fa il suo display, quindi la protezione non dipende da un feed bloccato.",
        "<strong class='text-white'>Sincronizzazione multi-account</strong>, replichi gli stessi ordini su tutti gli account collegati contemporaneamente, così nulla resta senza gestione mentre riavvia una piattaforma bloccata.",
      ],
    },
  ] },
  ctaHeading: { en: "Keep Trading Even When the Chart Freezes", de: "Weiterhandeln, selbst wenn der Chart einfriert", es: "Siga operando incluso cuando el gráfico se congele", fr: "Continuez à trader même quand le graphique se fige", it: "Continui a fare trading anche quando il grafico si blocca" },
  ctaText: { en: "Link your TradingView alerts straight to Tradovate so a frozen or half-drawn chart never stands between you and a fill.", de: "Verbinden Sie Ihre TradingView-Alerts direkt mit Tradovate, sodass ein eingefrorener oder halb gezeichneter Chart nie zwischen Ihnen und einer Ausführung steht.", es: "Conecte sus alertas de TradingView directamente con Tradovate para que un gráfico congelado o a medio dibujar nunca se interponga entre usted y una ejecución.", fr: "Reliez vos alertes TradingView directement à Tradovate afin qu'un graphique figé ou à moitié dessiné ne se mette jamais entre vous et une exécution.", it: "Colleghi i suoi alert di TradingView direttamente a Tradovate, così un grafico bloccato o disegnato a metà non si interpone mai tra lei e un'esecuzione." },
  ctaButtonText: { en: "Start Your Free 7-Day Trial", de: "Starten Sie Ihre kostenlose 5-Tage-Testversion", es: "Inicie su prueba gratuita de 5 días", fr: "Démarrez votre essai gratuit de 5 jours", it: "Inizi la sua prova gratuita di 5 giorni" },
  ctaUrl: "https://app.pickmytrade.trade/?register=true&utm_source=content&utm_medium=debugging",
  faqHeading: { en: "Frequently Asked Questions", de: "Häufig gestellte Fragen", es: "Preguntas frecuentes", fr: "Questions fréquentes", it: "Domande frequenti" },
  faqs: { en: [
    { q: "Why do my candle charts freeze in Tradovate sim or market replay?", a: "The chart's bar feed stalls while the rest of the platform keeps running. Charts are built from a separate historical-plus-streaming data pipeline than the live quote and DOM stream, and in sim or replay that bar pipeline is more fragile, especially on older data. When it stalls, the last candle stops updating or new candles print only an open price with no high, low, or wick. It's a session and data-feed issue, not a problem with your account, which is why a full browser restart usually clears it." },
    { q: "Why does the DOM keep moving but the candles stop updating?", a: "The DOM and the chart are fed by different data paths. The DOM shows the live order book straight off the quote stream, while candles are assembled from the bar/history feed. The freeze hits the bar feed only, so the ladder keeps ticking while the candles sit frozen. Seeing a live DOM next to a dead chart is the classic signature of this bug, and confirmation that your connection itself is fine." },
    { q: "How do I get frozen candles updating again fast?", a: "Close the browser (or the desktop app) completely and reopen it, then reconnect to your sim or replay session and reload the chart. A full restart re-establishes the chart feed and is the most reliable recovery. For a quicker temporary nudge, switch the chart to another symbol and back, or flip between chart tabs, candles often repaint for a moment, though the freeze can return until you do the full restart." },
    { q: "Why won't market replay work with older data?", a: "Older replay data is where freezes cluster. Data from roughly the last two weeks tends to replay smoothly, while sessions much older than that are far more likely to stall the candles, often after 30 to 60 minutes of continuous replay. If you can, run your replay on recent dates. When you need older sessions for study, expect to restart the browser more often and keep each run shorter." },
    { q: "Which contract should I load for market replay?", a: "Load the specific contract that was actually trading during the session you're replaying, not a continuous symbol or an expired month. For a March E-mini S&P replay, for example, you'd use the March contract code rather than a rolling symbol. Loading the wrong or expired expiration is a common cause of candles that never populate. Tradovate can auto-roll expired symbols forward in your workspace, and there's an application setting to turn that roll-forward off when you specifically want to view an expired contract in replay." },
    { q: "Do frozen candles mean my orders or fills are stuck too?", a: "Not necessarily, a frozen chart is a display and data-feed problem, and the DOM usually keeps working. But don't make decisions off a chart you can't trust. If the candles are stale, price may be well away from where the last bar shows. Check the DOM or the positions module for the real, current price before you act, and restart to get an accurate chart back." },
    { q: "Does switching symbols or timeframes fix frozen candles?", a: "It helps briefly. Switching to a different symbol and back, changing the timeframe, or flipping chart tabs forces the chart to redraw, and the candles often catch up for a moment. It's a useful stopgap when you don't want to lose your layout, but it tends not to hold. When the freeze keeps coming back, the full browser restart is the fix that actually sticks." },
    { q: "Is this a bug on my end or Tradovate's?", a: "Often it's platform-side. Waves of frozen-candle reports have lined up with new platform releases and then been resolved by Tradovate in a later update. If a restart and a recent contract don't fix it and the freeze hits every symbol, check the Tradovate release notes or status page, you may be waiting on a server-side fix rather than anything you can change locally." },
  ], de: [
    { q: "Warum frieren meine Kerzencharts in Tradovate Sim oder Market Replay ein?", a: "Der Balken-Feed des Charts stockt, während der Rest der Plattform weiterläuft. Charts werden aus einer separaten Kombination aus historischer und Streaming-Datenpipeline aufgebaut, anders als der Live-Kurs- und DOM-Stream, und in Sim oder Replay ist diese Balken-Pipeline anfälliger, besonders bei älteren Daten. Stockt sie, hört die letzte Kerze auf, sich zu aktualisieren, oder neue Kerzen zeigen nur einen Eröffnungskurs ohne Hoch, Tief oder Docht. Es ist ein Sitzungs- und Datenfeed-Problem, kein Problem mit Ihrem Konto, weshalb ein vollständiger Browser-Neustart es meist behebt." },
    { q: "Warum bewegt sich das DOM weiter, während die Kerzen mit dem Aktualisieren aufhören?", a: "DOM und Chart werden über unterschiedliche Datenpfade gespeist. Das DOM zeigt das Live-Orderbuch direkt aus dem Kursstream, während Kerzen aus dem Balken-/Historien-Feed zusammengesetzt werden. Das Einfrieren betrifft nur den Balken-Feed, sodass die Kursleiter weiter tickt, während die Kerzen stillstehen. Ein lebendiges DOM neben einem toten Chart zu sehen, ist das klassische Erkennungsmerkmal dieses Fehlers und zugleich die Bestätigung, dass Ihre Verbindung selbst in Ordnung ist." },
    { q: "Wie bringe ich eingefrorene Kerzen schnell wieder zum Aktualisieren?", a: "Schließen Sie den Browser (oder die Desktop-App) vollständig und öffnen Sie ihn erneut, verbinden Sie sich dann wieder mit Ihrer Sim- oder Replay-Sitzung und laden Sie den Chart neu. Ein vollständiger Neustart stellt den Chart-Feed wieder her und ist die zuverlässigste Lösung. Für einen schnelleren, vorübergehenden Anstoß wechseln Sie den Chart zu einem anderen Symbol und zurück oder wechseln zwischen Chart-Tabs – die Kerzen bauen sich oft kurz neu auf, allerdings kann das Einfrieren zurückkehren, bis Sie den vollständigen Neustart durchführen." },
    { q: "Warum funktioniert Market Replay nicht mit älteren Daten?", a: "Bei älteren Replay-Daten häufen sich Einfrierungen. Daten aus den letzten rund zwei Wochen laufen meist reibungslos im Replay, während deutlich ältere Sitzungen die Kerzen sehr viel eher zum Stocken bringen, oft nach 30 bis 60 Minuten durchgehendem Replay. Führen Sie Ihr Replay nach Möglichkeit mit aktuellen Terminen aus. Benötigen Sie ältere Sitzungen zum Studium, rechnen Sie mit häufigeren Browser-Neustarts und halten Sie jeden Lauf kürzer." },
    { q: "Welchen Kontrakt sollte ich für Market Replay laden?", a: "Laden Sie den konkreten Kontrakt, der während der Sitzung, die Sie wiedergeben, tatsächlich gehandelt wurde, kein fortlaufendes Symbol und keinen abgelaufenen Monat. Für ein März-E-mini-S&P-Replay würden Sie beispielsweise den März-Kontraktcode verwenden statt eines fortlaufenden Symbols. Der falsche oder abgelaufene Verfallstermin ist eine häufige Ursache dafür, dass sich Kerzen nie füllen. Tradovate kann abgelaufene Symbole in Ihrem Arbeitsbereich automatisch weiterrollen, und es gibt eine Anwendungseinstellung, um dieses Weiterrollen auszuschalten, wenn Sie gezielt einen abgelaufenen Kontrakt im Replay betrachten möchten." },
    { q: "Bedeuten eingefrorene Kerzen, dass auch meine Orders oder Ausführungen feststecken?", a: "Nicht zwangsläufig – ein eingefrorener Chart ist ein Anzeige- und Datenfeed-Problem, und das DOM funktioniert meist weiter. Treffen Sie aber keine Entscheidungen anhand eines Charts, dem Sie nicht trauen können. Sind die Kerzen veraltet, kann der Kurs deutlich von dem abweichen, was der letzte Balken zeigt. Prüfen Sie das DOM oder das Positionsmodul auf den echten, aktuellen Kurs, bevor Sie handeln, und starten Sie neu, um wieder einen zuverlässigen Chart zu erhalten." },
    { q: "Behebt der Wechsel von Symbol oder Zeitrahmen eingefrorene Kerzen?", a: "Es hilft kurzzeitig. Der Wechsel zu einem anderen Symbol und zurück, das Ändern des Zeitrahmens oder das Wechseln zwischen Chart-Tabs zwingt den Chart zum Neuzeichnen, und die Kerzen holen oft für einen Moment auf. Das ist eine nützliche Übergangslösung, wenn Sie Ihr Layout nicht verlieren möchten, hält aber meist nicht dauerhaft. Kehrt das Einfrieren immer wieder zurück, ist der vollständige Browser-Neustart die Lösung, die wirklich hält." },
    { q: "Liegt der Fehler bei mir oder bei Tradovate?", a: "Häufig liegt es an der Plattform. Wellen von Meldungen über eingefrorene Kerzen fielen wiederholt mit neuen Plattform-Releases zusammen und wurden später von Tradovate in einem Update behoben. Helfen Neustart und ein aktueller Kontrakt nicht und betrifft das Einfrieren jedes Symbol, prüfen Sie die Tradovate-Release-Notes oder die Statusseite – möglicherweise warten Sie auf eine serverseitige Lösung statt auf etwas, das Sie selbst ändern können." },
  ], es: [
    { q: "¿Por qué se congelan mis gráficos de velas en el simulador o en la repetición de mercado de Tradovate?", a: "El feed de barras del gráfico se bloquea mientras el resto de la plataforma sigue funcionando. Los gráficos se construyen a partir de una canalización de datos histórica más streaming distinta del flujo de cotizaciones en vivo y del DOM, y en el simulador o la repetición esa canalización de barras es más frágil, especialmente con datos antiguos. Cuando se bloquea, la última vela deja de actualizarse o las velas nuevas solo muestran un precio de apertura, sin máximo, mínimo ni mecha. Es un problema de sesión y de feed de datos, no un problema con su cuenta, por eso un reinicio completo del navegador suele resolverlo." },
    { q: "¿Por qué el DOM sigue moviéndose pero las velas dejan de actualizarse?", a: "El DOM y el gráfico se alimentan de rutas de datos distintas. El DOM muestra el libro de órdenes en vivo directamente del flujo de cotizaciones, mientras que las velas se ensamblan a partir del feed de barras/histórico. El bloqueo afecta solo al feed de barras, así que la escalera sigue actualizándose mientras las velas quedan congeladas. Ver un DOM activo junto a un gráfico muerto es la firma clásica de este problema, y también confirma que su conexión en sí funciona bien." },
    { q: "¿Cómo hago que las velas congeladas vuelvan a actualizarse rápido?", a: "Cierre el navegador (o la aplicación de escritorio) por completo y vuelva a abrirlo, luego reconéctese a su sesión de simulador o repetición y recargue el gráfico. Un reinicio completo restablece el feed del gráfico y es la solución más fiable. Para un empujón temporal más rápido, cambie el gráfico a otro símbolo y vuelva, o alterne entre pestañas de gráficos; las velas suelen redibujarse por un momento, aunque el bloqueo puede volver hasta que realice el reinicio completo." },
    { q: "¿Por qué no funciona bien la repetición de mercado con datos antiguos?", a: "En los datos de repetición antiguos es donde se acumulan los bloqueos. Los datos de las últimas dos semanas, aproximadamente, suelen reproducirse sin problemas, mientras que las sesiones mucho más antiguas tienen muchas más probabilidades de bloquear las velas, a menudo tras 30 a 60 minutos de repetición continua. Si puede, ejecute su repetición con fechas recientes. Cuando necesite sesiones antiguas para estudiar, espere reiniciar el navegador con más frecuencia y mantenga cada sesión más corta." },
    { q: "¿Qué contrato debo cargar para la repetición de mercado?", a: "Cargue el contrato específico que realmente se negociaba durante la sesión que está reproduciendo, no un símbolo continuo ni un mes vencido. Para una repetición del E-mini S&P de marzo, por ejemplo, usaría el código del contrato de marzo en lugar de un símbolo continuo. Cargar el vencimiento incorrecto o vencido es una causa habitual de que las velas nunca se completen. Tradovate puede hacer avanzar automáticamente los símbolos vencidos en su espacio de trabajo, y existe un ajuste de aplicación para desactivar ese avance automático cuando desee ver específicamente un contrato vencido en la repetición." },
    { q: "¿Las velas congeladas significan que mis órdenes o ejecuciones también están atascadas?", a: "No necesariamente; un gráfico congelado es un problema de visualización y de feed de datos, y el DOM suele seguir funcionando. Pero no tome decisiones basándose en un gráfico en el que no puede confiar. Si las velas están desactualizadas, el precio puede estar bastante alejado de lo que muestra la última barra. Compruebe el DOM o el módulo de posiciones para conocer el precio real y actual antes de actuar, y reinicie para recuperar un gráfico fiable." },
    { q: "¿Cambiar de símbolo o de marco temporal soluciona las velas congeladas?", a: "Ayuda brevemente. Cambiar a otro símbolo y volver, cambiar el marco temporal o alternar entre pestañas de gráficos obliga al gráfico a redibujarse, y las velas suelen ponerse al día por un momento. Es una solución provisional útil cuando no quiere perder su diseño, pero tiende a no durar. Cuando el bloqueo sigue reapareciendo, el reinicio completo del navegador es la solución que realmente se mantiene." },
    { q: "¿Es un problema de mi lado o de Tradovate?", a: "A menudo es del lado de la plataforma. Oleadas de reportes de velas congeladas han coincidido con nuevas versiones de la plataforma y luego se han resuelto en una actualización posterior de Tradovate. Si un reinicio y un contrato reciente no lo solucionan y el bloqueo afecta a todos los símbolos, revise las notas de la versión o la página de estado de Tradovate; es posible que esté esperando una corrección del lado del servidor en lugar de algo que pueda cambiar localmente." },
  ], fr: [
    { q: "Pourquoi mes graphiques en chandeliers se figent-ils en simulation ou en replay de marché sur Tradovate ?", a: "Le flux de barres du graphique se bloque pendant que le reste de la plateforme continue de fonctionner. Les graphiques sont construits à partir d'un pipeline de données historique et en streaming distinct du flux de cotations en direct et du DOM, et en simulation ou en replay, ce pipeline de barres est plus fragile, surtout sur des données anciennes. Lorsqu'il se bloque, le dernier chandelier cesse de se mettre à jour ou les nouveaux chandeliers n'affichent qu'un prix d'ouverture, sans plus haut, plus bas ni mèche. C'est un problème de session et de flux de données, pas un problème lié à votre compte, c'est pourquoi un redémarrage complet du navigateur le résout généralement." },
    { q: "Pourquoi le DOM continue-t-il de bouger alors que les chandeliers cessent de se mettre à jour ?", a: "Le DOM et le graphique sont alimentés par des chemins de données différents. Le DOM affiche le carnet d'ordres en direct issu directement du flux de cotations, tandis que les chandeliers sont assemblés à partir du flux de barres/historique. Le blocage n'affecte que le flux de barres, si bien que l'échelle de prix continue de s'actualiser pendant que les chandeliers restent figés. Voir un DOM vivant à côté d'un graphique mort est la signature classique de ce bug, et confirme que votre connexion elle-même fonctionne bien." },
    { q: "Comment faire repartir rapidement des chandeliers figés ?", a: "Fermez complètement le navigateur (ou l'application de bureau) et rouvrez-le, puis reconnectez-vous à votre session de simulation ou de replay et rechargez le graphique. Un redémarrage complet rétablit le flux du graphique et constitue la solution la plus fiable. Pour une impulsion temporaire plus rapide, changez le graphique vers un autre symbole puis revenez, ou basculez entre les onglets de graphiques, les chandeliers se redessinent souvent pendant un instant, bien que le blocage puisse revenir tant que vous n'avez pas effectué le redémarrage complet." },
    { q: "Pourquoi le replay de marché ne fonctionne-t-il pas bien avec des données anciennes ?", a: "C'est sur les données de replay anciennes que les blocages se concentrent. Les données des deux dernières semaines environ se rejouent généralement sans accroc, tandis que les sessions bien plus anciennes ont beaucoup plus de risques de bloquer les chandeliers, souvent après 30 à 60 minutes de replay continu. Si possible, exécutez votre replay sur des dates récentes. Lorsque vous avez besoin de sessions plus anciennes pour étudier, attendez-vous à redémarrer le navigateur plus souvent et raccourcissez chaque session." },
    { q: "Quel contrat dois-je charger pour le replay de marché ?", a: "Chargez le contrat précis qui se négociait réellement pendant la session que vous rejouez, pas un symbole continu ni un mois expiré. Pour un replay E-mini S&P de mars, par exemple, vous utiliseriez le code du contrat de mars plutôt qu'un symbole continu. Charger une échéance erronée ou expirée est une cause fréquente de chandeliers qui ne se remplissent jamais. Tradovate peut faire avancer automatiquement les symboles expirés dans votre espace de travail, et il existe un paramètre d'application pour désactiver cette bascule automatique lorsque vous souhaitez spécifiquement afficher un contrat expiré en replay." },
    { q: "Des chandeliers figés signifient-ils que mes ordres ou exécutions sont eux aussi bloqués ?", a: "Pas nécessairement, un graphique figé est un problème d'affichage et de flux de données, et le DOM continue généralement de fonctionner. Mais ne prenez pas de décisions à partir d'un graphique auquel vous ne pouvez pas faire confiance. Si les chandeliers sont obsolètes, le prix peut être très éloigné de ce que montre la dernière barre. Vérifiez le DOM ou le module de positions pour connaître le prix réel et actuel avant d'agir, et redémarrez pour retrouver un graphique fiable." },
    { q: "Changer de symbole ou d'unité de temps corrige-t-il les chandeliers figés ?", a: "Cela aide brièvement. Changer vers un autre symbole puis revenir, modifier l'unité de temps ou basculer entre les onglets de graphiques force le graphique à se redessiner, et les chandeliers se remettent souvent à jour pendant un instant. C'est une solution provisoire utile lorsque vous ne voulez pas perdre votre mise en page, mais elle tient rarement dans la durée. Lorsque le blocage revient sans cesse, le redémarrage complet du navigateur est la solution qui tient vraiment." },
    { q: "Est-ce un problème de mon côté ou de celui de Tradovate ?", a: "C'est souvent un problème côté plateforme. Des vagues de signalements de chandeliers figés ont coïncidé avec de nouvelles versions de la plateforme, puis ont été résolues par Tradovate dans une mise à jour ultérieure. Si un redémarrage et un contrat récent ne corrigent pas le problème et que le blocage touche tous les symboles, consultez les notes de version ou la page de statut de Tradovate, vous attendez peut-être un correctif côté serveur plutôt que quelque chose que vous pouvez changer localement." },
  ], it: [
    { q: "Perché i miei grafici a candele si bloccano in Tradovate sim o nel market replay?", a: "Il feed di barre del grafico si blocca mentre il resto della piattaforma continua a funzionare. I grafici sono costruiti a partire da una pipeline di dati storico più streaming distinta dal flusso di quotazioni live e dal DOM, e in sim o nel replay quella pipeline di barre è più fragile, specialmente sui dati più vecchi. Quando si blocca, l'ultima candela smette di aggiornarsi oppure le nuove candele mostrano solo un prezzo di apertura, senza massimo, minimo o ombra. È un problema di sessione e di feed dati, non un problema del suo account, ed è per questo che un riavvio completo del browser di solito lo risolve." },
    { q: "Perché il DOM continua a muoversi mentre le candele smettono di aggiornarsi?", a: "Il DOM e il grafico sono alimentati da percorsi dati diversi. Il DOM mostra il libro ordini in tempo reale direttamente dal flusso di quotazioni, mentre le candele vengono assemblate a partire dal feed di barre/storico. Il blocco colpisce solo il feed di barre, quindi la scala prezzi continua ad aggiornarsi mentre le candele restano ferme. Vedere un DOM vivo accanto a un grafico morto è la firma classica di questo bug, oltre a confermare che la sua connessione di per sé funziona correttamente." },
    { q: "Come faccio a far aggiornare di nuovo rapidamente le candele bloccate?", a: "Chiuda completamente il browser (o l'app desktop) e lo riapra, quindi si riconnetta alla sua sessione sim o replay e ricarichi il grafico. Un riavvio completo ristabilisce il feed del grafico ed è il ripristino più affidabile. Per una soluzione temporanea più rapida, cambi il grafico su un altro simbolo e torni indietro, oppure passi tra le schede del grafico: le candele spesso si ridisegnano per un momento, anche se il blocco può ripresentarsi finché non esegue il riavvio completo." },
    { q: "Perché il market replay non funziona bene con dati più vecchi?", a: "È sui dati di replay più vecchi che si concentrano i blocchi. I dati delle ultime due settimane circa tendono a riprodursi senza problemi, mentre le sessioni molto più vecchie hanno molte più probabilità di bloccare le candele, spesso dopo 30-60 minuti di replay continuo. Se possibile, esegua il replay su date recenti. Quando ha bisogno di sessioni più vecchie per lo studio, si aspetti di dover riavviare il browser più spesso e tenga ogni sessione più breve." },
    { q: "Quale contratto dovrei caricare per il market replay?", a: "Carichi il contratto specifico che veniva effettivamente negoziato durante la sessione che sta riproducendo, non un simbolo continuo né un mese scaduto. Per un replay dell'E-mini S&P di marzo, ad esempio, userebbe il codice del contratto di marzo invece di un simbolo continuo. Caricare la scadenza sbagliata o scaduta è una causa comune di candele che non si popolano mai. Tradovate può far avanzare automaticamente i simboli scaduti nel suo spazio di lavoro, ed esiste un'impostazione dell'applicazione per disattivare questo avanzamento automatico quando desidera vedere specificamente un contratto scaduto nel replay." },
    { q: "Le candele bloccate significano che anche i miei ordini o le mie esecuzioni sono bloccati?", a: "Non necessariamente: un grafico bloccato è un problema di visualizzazione e di feed dati, e il DOM di solito continua a funzionare. Ma non prenda decisioni basandosi su un grafico di cui non può fidarsi. Se le candele sono obsolete, il prezzo potrebbe essere ben distante da ciò che mostra l'ultima barra. Controlli il DOM o il modulo posizioni per conoscere il prezzo reale e attuale prima di agire, e riavvii per ottenere di nuovo un grafico affidabile." },
    { q: "Cambiare simbolo o timeframe risolve le candele bloccate?", a: "Aiuta brevemente. Passare a un altro simbolo e tornare indietro, cambiare il timeframe o passare tra le schede del grafico forza il grafico a ridisegnarsi, e le candele spesso si aggiornano per un momento. È una soluzione temporanea utile quando non vuole perdere il suo layout, ma tende a non durare. Quando il blocco continua a ripresentarsi, il riavvio completo del browser è la soluzione che funziona davvero." },
    { q: "È un problema dal mio lato o da quello di Tradovate?", a: "Spesso è un problema lato piattaforma. Ondate di segnalazioni di candele bloccate hanno coinciso con nuove versioni della piattaforma e sono state poi risolte da Tradovate in un aggiornamento successivo. Se un riavvio e un contratto recente non risolvono il problema e il blocco colpisce tutti i simboli, controlli le note di rilascio o la pagina di stato di Tradovate: potrebbe essere in attesa di una correzione lato server piuttosto che di qualcosa che può cambiare localmente." },
  ] },
  relatedHeading: { en: "Related Guides", de: "Weitere Anleitungen", es: "Guías relacionadas", fr: "Guides connexes", it: "Guide correlate" },
