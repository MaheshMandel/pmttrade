---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "poor-limit-order-fill-quality";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/debugging/${SLUG}`;

const META_TITLE = "Tradovate Limit Orders Not Filling at Price";
const META_DESCRIPTION =
  "Limit price touched but your order never filled? See why futures FIFO queue priority blocks limit fills and how to exit cleanly with a market order.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Tradovate-Limit-Orders werden nicht zum Kurs ausgeführt", es: "Las órdenes limitadas de Tradovate no se ejecutan al precio", fr: "Ordres à cours limité Tradovate non exécutés au prix", it: "Ordini limite Tradovate non eseguiti al prezzo" },
  dek: { en: "Price ticked right down to your limit, sat there, and walked away without a fill. In almost every case the platform did exactly what a limit order is supposed to do, here's why a touched price isn't a filled price.", de: "Der Kurs fiel genau auf Ihr Limit, blieb dort und zog weiter, ohne dass Ihre Order ausgeführt wurde. In fast allen Fällen hat die Plattform genau das getan, was eine Limit-Order tun soll – hier erfahren Sie, warum ein berührter Kurs noch kein ausgeführter Kurs ist.", es: "El precio bajó justo hasta su límite, se quedó ahí y se fue sin ejecutarle la orden. En casi todos los casos la plataforma hizo exactamente lo que debe hacer una orden limitada: aquí le explicamos por qué un precio tocado no es un precio ejecutado.", fr: "Le prix est descendu pile à votre limite, y est resté, puis est reparti sans exécution. Dans presque tous les cas, la plateforme a fait exactement ce qu'un ordre à cours limité est censé faire : voici pourquoi un prix touché n'est pas un prix exécuté.", it: "Il prezzo è sceso esattamente al Suo limite, ci è rimasto e se n'è andato senza eseguire l'ordine. Quasi sempre la piattaforma ha fatto esattamente ciò che un ordine limite deve fare: ecco perché un prezzo toccato non è un prezzo eseguito." },
  readTime: { en: "7 min read", de: "7 Min. Lesezeit", es: "Lectura de 7 min", fr: "Lecture : 7 min", it: "Lettura di 7 min" },
  lastUpdated: "2026-07-10",
  blocks: { en: [
    { type: "paragraph", html: "You set a buy limit at 5999.00, price ticks right down to 5999.00, sits there, and then walks away without giving you a fill. It looks broken. You watched the exact number print on the tape and your order never moved. This is one of the oldest execution gripes on Tradovate, and it stings most when you're exiting and the market just teases your level. Here's the part nobody likes to hear: in almost every case the platform did exactly what a limit order is supposed to do. There's no bug toggle to flip and no setting that “fixes” fill quality, because live limit orders are matched by the exchange, not by Tradovate. What you can do is understand why a touched price isn't a filled price, and change how you exit when being flat actually matters." },
    {
      type: "checklist",
      heading: "Quick Checklist for Limit Orders Not Filling",
      items: [
        "<strong class='text-white'>A touch is not a fill.</strong> Price reaching your limit doesn't entitle you to an execution; enough volume has to trade through the queue ahead of you first.",
        "<strong class='text-white'>Check whether price traded through or just tagged your level.</strong> A one-tick-past move usually fills you; a tag-and-bounce often doesn't.",
        "<strong class='text-white'>Stop re-queuing yourself.</strong> Every time you modify a working limit's price or size, you drop to the back of the line at that level.",
        "<strong class='text-white'>Use a market order when you must be out.</strong> It guarantees a fill (not a price). A passive limit trades that certainty away.",
        "<strong class='text-white'>Don't trust demo fills as live fills.</strong> The simulator is friendlier than the real queue.",
        "<strong class='text-white'>Grab the Order ID for anything that looks truly wrong.</strong> That's what the Trade Desk needs to investigate a single order.",
      ],
    },
    { type: "heading", text: "What “Price Hit My Limit and Didn't Fill” Actually Means" },
    { type: "paragraph", html: "A limit order has one job: fill at your price or better, never worse. That protection is the whole point, and it's also why it can leave you empty-handed. Because a limit refuses a worse price, it fills only when the market reaches your level and there's enough trading to reach your specific spot in line." },
    { type: "paragraph", html: "On futures, that line is run by the exchange's matching engine using <strong class='text-white'>price-time priority</strong>, commonly called FIFO. Best price gets served first, and among everyone resting at the same price, whoever got there first fills first. When you drop a buy limit onto a level that already has size resting on it, you're not first, you're last. Say 400 contracts are already bid at 5999.00 when your order lands. You're effectively the 401st contract in the queue. Now price trades down to 5999.00, but only 350 contracts trade before it lifts back to 5999.50. Those 350 fills went to the orders in front of you. You didn't get a single one, because the market never traded deep enough to reach your position, and it never traded <em>through</em> the level to sweep the whole queue." },
    { type: "paragraph", html: "That's the difference that trips everyone up. If price had ticked to 5998.75, one level past your limit, the entire 5999.00 queue typically clears and you fill. A tag-and-bounce at exactly your price is the classic “it hit my level and I didn't get filled” scenario, and it's not a malfunction. It's queue mechanics working the way they always do." },
    { type: "heading", text: "Top Causes of Poor Limit Fill Quality" },
    { type: "heading", text: "1. Queue position (the main cause)" },
    { type: "paragraph", html: "You almost always land at the back of the line at your price. If the market only partially trades your level before reversing, the fills go to the orders ahead of you and you're left working. The more size resting at that level, the more volume has to print before your turn arrives." },
    { type: "heading", text: "2. Price only tagged the level, never traded through" },
    { type: "paragraph", html: "A single touch, or a fast wick that prints your price for a heartbeat, rarely moves enough size to clear the queue. Limits fill cleanly when price trades a tick or more past them, not when they're grazed." },
    { type: "heading", text: "3. You modified the order and lost priority" },
    { type: "paragraph", html: "Changing a working limit's price, or bumping its quantity up, re-queues it. All the time priority you'd earned by resting there is gone, and you restart at the back. Chasing a level by nudging your order repeatedly can actively hurt your odds." },
    { type: "heading", text: "4. Demo fills set the wrong expectation" },
    { type: "paragraph", html: "Simulated accounts, including most prop-firm evaluations, don't route to the exchange. They model fills, and the model tends to be generous. A limit approach that fills every time in demo can start missing once it faces a real live queue, which makes live fills feel “worse” when they're really just honest." },
    { type: "heading", text: "5. Thin liquidity or off-hours trading" },
    { type: "paragraph", html: "In a low-volume contract or during quiet overnight hours, there aren't enough contracts trading to clear a resting queue quickly. The order isn't stuck; there's just no flow to fill it." },
    { type: "heading", text: "How to Fix Poor Limit Fills and Exit Cleanly: Step-by-Step" },
    { type: "heading", text: "Confirm it's queue mechanics, not a stuck order" },
    {
      type: "steps",
      items: [
        { title: "Check the order's status", html: "Open the Orders module and check the order's status. If it reads working or accepted, the order is live and just hasn't been reached in the queue, this is normal, not a freeze." },
        { title: "Check if price traded through", html: "Look at whether price traded <em>through</em> your level or only tagged it. A tag-and-bounce no-fill is expected; a clean trade-through that skipped you is worth a closer look." },
        { title: "Watch the DOM at your price", html: "Heavy size resting ahead of you means a lot of contracts have to print before your turn." },
      ],
    },
    { type: "heading", text: "When you must be out, send a market order" },
    {
      type: "steps",
      items: [
        { title: "Cancel the resting limit first", html: "Cancel the resting limit first so you don't end up double-filled if it triggers a moment later." },
        { title: "Place a market order", html: "Place a plain <strong class='text-white'>market order</strong> in the opposite direction and matching quantity to flatten the position. A market order guarantees a fill; it does not guarantee price, so expect to give up a tick or two of slippage in a moving market." },
        { title: "Confirm you're flat", html: "Confirm your net position reads flat before you do anything else." },
      ],
    },
    { type: "paragraph", html: "This is the honest trade-off at the center of the problem: a limit protects your price but risks no fill; a market guarantees the fill but risks the price. If being out matters more than the exact level, don't ask a passive limit to do a market order's job." },
    { type: "heading", text: "Improve your fill odds without giving up price" },
    {
      type: "list",
      items: [
        "Rest your limit slightly more aggressively. A buy limit placed a tick or two higher sits closer to the front of realistic trading and fills more often, at the cost of a marginally worse entry.",
        "Place the order early and leave it alone. Time priority rewards patience; the earlier you rest and the less you fiddle, the closer to the front you stay.",
        "For protective stops, prefer a stop that becomes a market order over a stop-limit, which can refuse to fill in a fast move, exactly when you can't afford to be stuck.",
        "Trade the active contract during liquid hours, since more flow clears the queue faster.",
      ],
    },
    { type: "heading", text: "Report a specific order that truly should have filled" },
    {
      type: "steps",
      items: [
        { title: "Copy the Order ID", html: "Open your Orders report and copy the <strong class='text-white'>Order ID</strong> for the order in question." },
        { title: "Note the details", html: "Note the exact time, symbol, and price, and whether the tape shows a clean trade-through of your level." },
        { title: "Send it to the Trade Desk", html: "Send that Order ID to the Trade Desk and ask them to check what happened to it at the exchange. A specific order is the only thing they can meaningfully investigate; there's no global “fix fills” button on their end either." },
      ],
    },
    { type: "heading", text: "Troubleshooting Table" },
    {
      type: "table",
      headers: ["Symptom", "What it means", "Fix"],
      rows: [
        ["Price tagged my limit and bounced, no fill", "Queue never cleared to your position at that level", "Expected; place more aggressively or use a market order if you must be filled"],
        ["Price traded through but I still didn't fill", "Possible routing or a genuine order issue", "Grab the Order ID and send it to the Trade Desk to investigate"],
        ["Fills were perfect in demo, poor when live", "Simulator was more generous than the real queue", "Re-test on a live account; don't size up on demo fill assumptions"],
        ["Kept modifying my limit, fills got worse", "Each change re-queued you to the back of the line", "Set it once and let it rest; stop chasing the level"],
        ["Can't exit; my limit won't fill", "Passive exit is waiting on the queue", "Cancel the limit and send an opposite market order to flatten"],
        ["Stop-limit didn't get me out on a fast move", "The limit leg refused a worse price in a gap", "Use a stop that converts to a market order for protection"],
      ],
    },
    { type: "heading", text: "Get Consistent Execution with PickMyTrade" },
    { type: "paragraph", html: "No tool can rewrite the exchange's matching engine, and any product promising “guaranteed” limit fills is selling you a story. What automation can do is make sure your orders go out the way you intended, every time, without you fat-fingering an order type under pressure. PickMyTrade links your TradingView alerts straight to Tradovate and takes the manual guesswork out of execution:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Order type per signal.</strong> Decide up front whether an entry or exit goes out as a limit or a market order, so a “must be out” exit isn't left sitting on a passive limit.",
        "<strong class='text-white'>Price offsets on entries.</strong> Rest limits a defined distance from signal price, the aggressive-placement idea above, applied automatically.",
        "<strong class='text-white'>Protective stops on every position.</strong> Attach a real stop the moment you're in, sized to a loss you can survive, instead of a mental exit a passive limit might never reach.",
        "<strong class='text-white'>Multi-account consistency.</strong> Send the same intended order across every connected account, so you're not hand-keying order types on five platforms while price moves.",
      ],
    },
    { type: "paragraph", html: "The goal isn't to beat the queue. It's to make sure the order you meant to send is the one that actually goes out, so you're never trapped in a position because a limit wouldn't fill." },
  ], de: [
    { type: "paragraph",html: "Sie setzen ein Kauf-Limit bei 5999.00, der Kurs fällt exakt auf 5999.00, bleibt dort und zieht dann weiter, ohne Sie auszuführen. Es sieht defekt aus. Sie haben die genaue Zahl im Tape gesehen, und Ihre Order hat sich nie bewegt. Das ist eines der ältesten Ärgernisse bei der Ausführung auf Tradovate und es schmerzt am meisten, wenn Sie aussteigen wollen und der Markt Ihr Niveau nur anteasert. Was niemand gern hört: In fast allen Fällen hat die Plattform genau das getan, was eine Limit-Order tun soll. Es gibt keinen Fehlerschalter und keine Einstellung, die die Ausführungsqualität „repariert“, denn aktive Limit-Orders werden von der Börse gematcht, nicht von Tradovate. Was Sie tun können: verstehen, warum ein berührter Kurs kein ausgeführter Kurs ist, und ändern, wie Sie aussteigen, wenn es wirklich darauf ankommt, flat zu sein." },
    {
      type: "checklist",
      heading: "Kurze Checkliste bei nicht ausgeführten Limit-Orders",
      items: [
        "<strong class='text-white'>Eine Berührung ist keine Ausführung.</strong> Dass der Kurs Ihr Limit erreicht, gibt Ihnen keinen Anspruch auf Ausführung; zuerst muss genug Volumen durch die Warteschlange vor Ihnen gehandelt werden.",
        "<strong class='text-white'>Prüfen Sie, ob der Kurs Ihr Niveau durchhandelt oder nur angetippt hat.</strong> Ein Move einen Tick darüber hinaus führt meist zur Ausführung; Antippen und Abprallen oft nicht.",
        "<strong class='text-white'>Hören Sie auf, sich selbst neu einzureihen.</strong> Jedes Mal, wenn Sie Preis oder Größe eines aktiven Limits ändern, rutschen Sie ans Ende der Warteschlange auf diesem Niveau.",
        "<strong class='text-white'>Nutzen Sie eine Market-Order, wenn Sie raus müssen.</strong> Sie garantiert eine Ausführung (nicht den Kurs). Ein passives Limit gibt diese Sicherheit auf.",
        "<strong class='text-white'>Vertrauen Sie Demo-Ausführungen nicht als Live-Ausführungen.</strong> Der Simulator ist gnädiger als die echte Warteschlange.",
        "<strong class='text-white'>Notieren Sie die Order ID, wenn etwas wirklich falsch aussieht.</strong> Das braucht der Trade Desk, um eine einzelne Order zu untersuchen.",
      ],
    },
    { type: "heading",text: "Was „Kurs hat mein Limit erreicht und nicht ausgeführt“ tatsächlich bedeutet" },
    { type: "paragraph",html: "Eine Limit-Order hat genau eine Aufgabe: zu Ihrem Kurs oder besser auszuführen, nie schlechter. Dieser Schutz ist der ganze Sinn, und er ist auch der Grund, warum Sie mit leeren Händen dastehen können. Weil ein Limit einen schlechteren Kurs ablehnt, wird es nur ausgeführt, wenn der Markt Ihr Niveau erreicht und genug gehandelt wird, um Ihren konkreten Platz in der Warteschlange zu erreichen." },
    { type: "paragraph",html: "Bei Futures wird diese Warteschlange von der Matching-Engine der Börse nach <strong class='text-white'>Preis-Zeit-Priorität</strong> geführt, gemeinhin FIFO genannt. Der beste Preis wird zuerst bedient, und unter allen, die zum selben Preis warten, wird zuerst ausgeführt, wer zuerst da war. Setzen Sie ein Kauf-Limit auf ein Niveau, auf dem bereits Volumen wartet, sind Sie nicht der Erste, sondern der Letzte. Angenommen, 400 Kontrakte stehen bereits im Bid bei 5999.00, wenn Ihre Order eintrifft. Dann sind Sie praktisch der 401. Kontrakt in der Warteschlange. Nun handelt der Kurs auf 5999.00, aber es werden nur 350 Kontrakte gehandelt, bevor er zurück auf 5999.50 steigt. Diese 350 Ausführungen gingen an die Orders vor Ihnen. Sie haben keine einzige bekommen, weil der Markt nie tief genug handelte, um Ihre Position zu erreichen, und das Niveau nie <em>durchlief</em>, um die gesamte Warteschlange abzuräumen." },
    { type: "paragraph",html: "Das ist der Unterschied, über den alle stolpern. Wäre der Kurs auf 5998.75 gefallen, einen Tick über Ihr Limit hinaus, wäre die gesamte Warteschlange bei 5999.00 in der Regel abgearbeitet worden, und Sie wären ausgeführt worden. Ein Antippen mit Abprallen genau auf Ihrem Kurs ist das klassische „Er hat mein Niveau erreicht und ich wurde nicht ausgeführt“-Szenario, und es ist keine Fehlfunktion. Es ist die Mechanik der Warteschlange, die so arbeitet, wie sie es immer tut." },
    { type: "heading",text: "Die häufigsten Ursachen für schlechte Limit-Ausführung" },
    { type: "heading",text: "1. Position in der Warteschlange (die Hauptursache)" },
    { type: "paragraph",html: "Sie landen fast immer am Ende der Schlange auf Ihrem Kurs. Wird Ihr Niveau nur teilweise gehandelt, bevor der Markt dreht, gehen die Ausführungen an die Orders vor Ihnen, und Sie bleiben im Markt. Je mehr Volumen auf diesem Niveau wartet, desto mehr muss gehandelt werden, bevor Sie an der Reihe sind." },
    { type: "heading",text: "2. Der Kurs hat das Niveau nur angetippt, aber nicht durchhandelt" },
    { type: "paragraph",html: "Eine einzelne Berührung oder ein schneller Docht, der Ihren Kurs für einen Herzschlag druckt, bewegt selten genug Volumen, um die Warteschlange zu räumen. Limits werden sauber ausgeführt, wenn der Kurs einen Tick oder mehr darüber hinaus handelt, nicht wenn sie gestreift werden." },
    { type: "heading",text: "3. Sie haben die Order geändert und die Priorität verloren" },
    { type: "paragraph",html: "Wenn Sie den Preis eines aktiven Limits ändern oder die Menge erhöhen, wird es neu eingereiht. Die gesamte Zeitpriorität, die Sie durch das Warten erworben haben, ist weg, und Sie beginnen wieder am Ende. Ein Niveau durch wiederholtes Nachjustieren Ihrer Order zu jagen, kann Ihre Chancen aktiv verschlechtern." },
    { type: "heading",text: "4. Demo-Ausführungen wecken falsche Erwartungen" },
    { type: "paragraph",html: "Simulierte Konten, einschließlich der meisten Prop-Firm-Evaluierungen, routen nicht an die Börse. Sie modellieren Ausführungen, und das Modell ist tendenziell großzügig. Ein Limit-Ansatz, der in der Demo jedes Mal ausgeführt wird, kann anfangen, Ausführungen zu verpassen, sobald er auf eine echte Live-Warteschlange trifft – wodurch Live-Ausführungen „schlechter“ wirken, obwohl sie einfach nur ehrlich sind." },
    { type: "heading",text: "5. Dünne Liquidität oder Handel außerhalb der Handelszeiten" },
    { type: "paragraph",html: "Bei einem Kontrakt mit geringem Volumen oder in ruhigen Nachtstunden werden nicht genug Kontrakte gehandelt, um eine wartende Schlange schnell zu räumen. Die Order steckt nicht fest; es fehlt schlicht der Orderfluss, um sie auszuführen." },
    { type: "heading",text: "So beheben Sie schlechte Limit-Ausführungen und steigen sauber aus: Schritt für Schritt" },
    { type: "heading",text: "Bestätigen Sie, dass es die Warteschlangenmechanik ist und keine hängende Order" },
    {
      type: "steps",
      items: [
        { title: "Orderstatus prüfen", html: "Öffnen Sie das Orders-Modul und prüfen Sie den Status der Order. Steht dort „working“ oder „accepted“, ist die Order aktiv und wurde in der Warteschlange nur noch nicht erreicht – das ist normal, kein Einfrieren." },
        { title: "Prüfen, ob der Kurs durchgehandelt hat", html: "Sehen Sie nach, ob der Kurs Ihr Niveau <em>durchhandelt</em> oder es nur angetippt hat. Eine Nichtausführung bei Antippen und Abprallen ist zu erwarten; ein sauberes Durchhandeln, bei dem Sie übersprungen wurden, verdient einen genaueren Blick." },
        { title: "DOM bei Ihrem Kurs beobachten", html: "Viel Volumen vor Ihnen bedeutet, dass viele Kontrakte gehandelt werden müssen, bevor Sie an der Reihe sind." },
      ],
    },
    { type: "heading",text: "Wenn Sie raus müssen, senden Sie eine Market-Order" },
    {
      type: "steps",
      items: [
        { title: "Zuerst das wartende Limit stornieren", html: "Stornieren Sie zuerst das wartende Limit, damit Sie nicht doppelt ausgeführt werden, falls es einen Moment später doch auslöst." },
        { title: "Market-Order platzieren", html: "Platzieren Sie eine einfache <strong class='text-white'>Market-Order</strong> in Gegenrichtung und mit passender Menge, um die Position glattzustellen. Eine Market-Order garantiert die Ausführung, nicht den Kurs; rechnen Sie in einem bewegten Markt also mit ein bis zwei Ticks Slippage." },
        { title: "Prüfen, dass Sie flat sind", html: "Bestätigen Sie, dass Ihre Nettoposition flat anzeigt, bevor Sie irgendetwas anderes tun." },
      ],
    },
    { type: "paragraph",html: "Das ist der ehrliche Zielkonflikt im Kern des Problems: Ein Limit schützt Ihren Kurs, riskiert aber keine Ausführung; eine Market-Order garantiert die Ausführung, riskiert aber den Kurs. Wenn es wichtiger ist, draußen zu sein, als das exakte Niveau zu treffen, verlangen Sie von einem passiven Limit nicht die Arbeit einer Market-Order." },
    { type: "heading",text: "Verbessern Sie Ihre Ausführungschancen, ohne den Kurs aufzugeben" },
    {
      type: "list",
      items: [
        "Platzieren Sie Ihr Limit etwas aggressiver. Ein Kauf-Limit, das ein bis zwei Ticks höher liegt, steht näher an der Spitze des realistischen Handels und wird häufiger ausgeführt – auf Kosten eines marginal schlechteren Einstiegs.",
        "Platzieren Sie die Order früh und lassen Sie sie in Ruhe. Zeitpriorität belohnt Geduld; je früher Sie sich einreihen und je weniger Sie herumspielen, desto näher an der Spitze bleiben Sie.",
        "Bevorzugen Sie für Schutz-Stops einen Stop, der zur Market-Order wird, gegenüber einem Stop-Limit, das sich in einem schnellen Markt weigern kann, auszuführen – genau dann, wenn Sie es sich nicht leisten können, festzustecken.",
        "Handeln Sie den aktiven Kontrakt während liquider Zeiten, denn mehr Orderfluss räumt die Warteschlange schneller.",
      ],
    },
    { type: "heading",text: "Melden Sie eine bestimmte Order, die wirklich hätte ausgeführt werden müssen" },
    {
      type: "steps",
      items: [
        { title: "Order ID kopieren", html: "Öffnen Sie Ihren Orders-Bericht und kopieren Sie die <strong class='text-white'>Order ID</strong> der betreffenden Order." },
        { title: "Details festhalten", html: "Notieren Sie genaue Uhrzeit, Symbol und Kurs sowie ob das Tape ein sauberes Durchhandeln Ihres Niveaus zeigt." },
        { title: "An den Trade Desk senden", html: "Senden Sie diese Order ID an den Trade Desk und bitten Sie darum, zu prüfen, was an der Börse mit ihr geschehen ist. Eine bestimmte Order ist das Einzige, was dort sinnvoll untersucht werden kann; auch dort gibt es keinen globalen „Ausführung reparieren“-Knopf." },
      ],
    },
    { type: "heading",text: "Tabelle zur Fehlerbehebung" },
    { type: "table", headers: ["Symptom","Was es bedeutet","Lösung"], rows: [
      ["Der Kurs tippte mein Limit an und prallte ab, keine Ausführung","Die Warteschlange wurde auf diesem Niveau nie bis zu Ihrer Position geräumt","Zu erwarten; platzieren Sie aggressiver oder nutzen Sie eine Market-Order, wenn Sie ausgeführt werden müssen"],
      ["Der Kurs handelte durch, aber ich wurde trotzdem nicht ausgeführt","Möglicherweise Routing oder ein echtes Orderproblem","Notieren Sie die Order ID und senden Sie sie zur Untersuchung an den Trade Desk"],
      ["Ausführungen waren in der Demo perfekt, live schlecht","Der Simulator war großzügiger als die echte Warteschlange","Auf einem Live-Konto neu testen; stocken Sie nicht auf Basis von Demo-Annahmen auf"],
      ["Ich habe mein Limit ständig geändert, die Ausführungen wurden schlechter","Jede Änderung hat Sie ans Ende der Warteschlange zurückgesetzt","Einmal setzen und ruhen lassen; hören Sie auf, dem Niveau nachzujagen"],
      ["Ich komme nicht raus; mein Limit wird nicht ausgeführt","Der passive Ausstieg wartet auf die Warteschlange","Limit stornieren und eine Market-Order in Gegenrichtung senden, um flat zu werden"],
      ["Das Stop-Limit hat mich bei einem schnellen Move nicht rausgebracht","Der Limit-Teil hat bei einer Kurslücke einen schlechteren Kurs abgelehnt","Nutzen Sie einen Stop, der zur Market-Order wird, als Schutz"],
    ] },
    { type: "heading",text: "Konsistente Ausführung mit PickMyTrade" },
    { type: "paragraph",html: "Kein Tool kann die Matching-Engine der Börse umschreiben, und jedes Produkt, das „garantierte“ Limit-Ausführungen verspricht, verkauft Ihnen ein Märchen. Was Automatisierung leisten kann: sicherstellen, dass Ihre Orders jedes Mal so hinausgehen, wie Sie es beabsichtigt haben, ohne dass Sie sich unter Druck beim Ordertyp vertippen. PickMyTrade verbindet Ihre TradingView-Alerts direkt mit Tradovate und nimmt das manuelle Raten aus der Ausführung:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Ordertyp pro Signal.</strong> Legen Sie vorab fest, ob ein Einstieg oder Ausstieg als Limit- oder Market-Order hinausgeht, damit ein „Muss-raus“-Ausstieg nicht auf einem passiven Limit hängen bleibt.",
        "<strong class='text-white'>Preis-Offsets bei Einstiegen.</strong> Platzieren Sie Limits in einem definierten Abstand zum Signalkurs – die oben beschriebene aggressive Platzierung, automatisch angewendet.",
        "<strong class='text-white'>Schutz-Stops bei jeder Position.</strong> Hängen Sie einen echten Stop an, sobald Sie drin sind, bemessen auf einen Verlust, den Sie verkraften können, statt eines gedanklichen Ausstiegs, den ein passives Limit vielleicht nie erreicht.",
        "<strong class='text-white'>Konsistenz über mehrere Konten.</strong> Senden Sie dieselbe beabsichtigte Order an alle verbundenen Konten, damit Sie nicht auf fünf Plattformen von Hand Ordertypen eintippen, während der Kurs sich bewegt.",
      ],
    },
    { type: "paragraph",html: "Das Ziel ist nicht, die Warteschlange zu schlagen. Es geht darum sicherzustellen, dass die Order, die Sie senden wollten, auch tatsächlich hinausgeht, damit Sie nie in einer Position festsitzen, weil ein Limit nicht ausgeführt wurde." },
  ], es: [
    { type: "paragraph",html: "Coloca un límite de compra en 5999.00, el precio baja justo hasta 5999.00, se queda ahí y luego se aleja sin ejecutarle. Parece roto. Vio el número exacto imprimirse en la cinta y su orden nunca se movió. Es una de las quejas de ejecución más antiguas en Tradovate, y duele más cuando está saliendo y el mercado solo coquetea con su nivel. Lo que a nadie le gusta oír: en casi todos los casos la plataforma hizo exactamente lo que debe hacer una orden limitada. No hay ningún interruptor de errores que accionar ni ningún ajuste que «arregle» la calidad de ejecución, porque las órdenes limitadas activas las casa la bolsa, no Tradovate. Lo que sí puede hacer es entender por qué un precio tocado no es un precio ejecutado y cambiar cómo sale cuando estar flat realmente importa." },
    {
      type: "checklist",
      heading: "Lista de comprobación rápida para órdenes limitadas que no se ejecutan",
      items: [
        "<strong class='text-white'>Un toque no es una ejecución.</strong> Que el precio llegue a su límite no le da derecho a una ejecución; primero tiene que negociarse volumen suficiente a través de la cola que tiene delante.",
        "<strong class='text-white'>Compruebe si el precio atravesó su nivel o solo lo rozó.</strong> Un movimiento de un tick más allá normalmente le ejecuta; un roce con rebote a menudo no.",
        "<strong class='text-white'>Deje de volver a ponerse en cola.</strong> Cada vez que modifica el precio o el tamaño de un límite activo, cae al final de la cola en ese nivel.",
        "<strong class='text-white'>Use una orden de mercado cuando deba salir.</strong> Garantiza una ejecución (no un precio). Un límite pasivo renuncia a esa certeza.",
        "<strong class='text-white'>No confíe en las ejecuciones demo como si fueran reales.</strong> El simulador es más amable que la cola real.",
        "<strong class='text-white'>Anote el Order ID de cualquier cosa que parezca realmente incorrecta.</strong> Eso es lo que necesita el Trade Desk para investigar una orden concreta.",
      ],
    },
    { type: "heading",text: "Qué significa realmente «el precio tocó mi límite y no se ejecutó»" },
    { type: "paragraph",html: "Una orden limitada tiene una sola tarea: ejecutarse a su precio o mejor, nunca peor. Esa protección es todo el sentido de la orden, y también es la razón por la que puede dejarle con las manos vacías. Como un límite rechaza un precio peor, solo se ejecuta cuando el mercado llega a su nivel y hay negociación suficiente para alcanzar su lugar concreto en la cola." },
    { type: "paragraph",html: "En futuros, esa cola la gestiona el motor de casación de la bolsa mediante <strong class='text-white'>prioridad precio-tiempo</strong>, comúnmente llamada FIFO. El mejor precio se atiende primero y, entre todos los que esperan al mismo precio, se ejecuta primero quien llegó antes. Cuando coloca un límite de compra en un nivel que ya tiene volumen en espera, no es el primero, es el último. Digamos que ya hay 400 contratos en el bid en 5999.00 cuando llega su orden. Usted es, en la práctica, el contrato 401 de la cola. Ahora el precio baja a 5999.00, pero solo se negocian 350 contratos antes de que vuelva a subir a 5999.50. Esas 350 ejecuciones fueron a las órdenes que tenía delante. No recibió ni una, porque el mercado nunca negoció lo bastante profundo para alcanzar su posición, y nunca <em>atravesó</em> el nivel para barrer toda la cola." },
    { type: "paragraph",html: "Esa es la diferencia con la que tropieza todo el mundo. Si el precio hubiera bajado a 5998.75, un nivel más allá de su límite, normalmente se habría despejado toda la cola de 5999.00 y usted se habría ejecutado. Un roce con rebote exactamente en su precio es el clásico escenario de «tocó mi nivel y no me ejecutaron», y no es un mal funcionamiento. Es la mecánica de la cola funcionando como siempre." },
    { type: "heading",text: "Principales causas de una mala calidad de ejecución en límites" },
    { type: "heading",text: "1. Posición en la cola (la causa principal)" },
    { type: "paragraph",html: "Casi siempre acaba al final de la cola a su precio. Si el mercado solo negocia parcialmente su nivel antes de revertir, las ejecuciones van a las órdenes que tiene delante y a usted le toca seguir esperando. Cuanto más volumen haya en espera en ese nivel, más tiene que imprimirse antes de que llegue su turno." },
    { type: "heading",text: "2. El precio solo rozó el nivel, sin atravesarlo" },
    { type: "paragraph",html: "Un solo toque, o una mecha rápida que imprime su precio por un instante, rara vez mueve volumen suficiente para despejar la cola. Los límites se ejecutan limpiamente cuando el precio cotiza un tick o más más allá, no cuando son rozados." },
    { type: "heading",text: "3. Modificó la orden y perdió la prioridad" },
    { type: "paragraph",html: "Cambiar el precio de un límite activo, o subir su cantidad, lo vuelve a poner en cola. Toda la prioridad de tiempo que había ganado al esperar ahí desaparece y vuelve a empezar al final. Perseguir un nivel ajustando la orden repetidamente puede perjudicar activamente sus probabilidades." },
    { type: "heading",text: "4. Las ejecuciones demo crean una expectativa equivocada" },
    { type: "paragraph",html: "Las cuentas simuladas, incluidas la mayoría de las evaluaciones de prop firms, no enrutan a la bolsa. Modelan las ejecuciones, y el modelo tiende a ser generoso. Un enfoque de límites que se ejecuta siempre en demo puede empezar a fallar cuando se enfrenta a una cola real en vivo, lo que hace que las ejecuciones reales parezcan «peores» cuando en realidad solo son honestas." },
    { type: "heading",text: "5. Liquidez escasa u operativa fuera de horario" },
    { type: "paragraph",html: "En un contrato de poco volumen o durante las horas tranquilas de la noche, no se negocian contratos suficientes para despejar rápidamente una cola en espera. La orden no está atascada; simplemente no hay flujo que la ejecute." },
    { type: "heading",text: "Cómo corregir las malas ejecuciones limitadas y salir limpiamente: paso a paso" },
    { type: "heading",text: "Confirme que es la mecánica de la cola y no una orden atascada" },
    {
      type: "steps",
      items: [
        { title: "Compruebe el estado de la orden", html: "Abra el módulo de Orders y compruebe el estado de la orden. Si indica working o accepted, la orden está activa y simplemente no se ha llegado a ella en la cola; es normal, no un bloqueo." },
        { title: "Compruebe si el precio atravesó el nivel", html: "Mire si el precio <em>atravesó</em> su nivel o solo lo rozó. Que no se ejecute un roce con rebote es lo esperado; un cruce limpio en el que le saltaron merece una revisión más detenida." },
        { title: "Observe el DOM en su precio", html: "Mucho volumen delante de usted significa que tienen que imprimirse muchos contratos antes de que llegue su turno." },
      ],
    },
    { type: "heading",text: "Cuando deba salir, envíe una orden de mercado" },
    {
      type: "steps",
      items: [
        { title: "Cancele primero el límite en espera", html: "Cancele primero el límite en espera para no acabar con una doble ejecución si se activa un momento después." },
        { title: "Coloque una orden de mercado", html: "Coloque una simple <strong class='text-white'>orden de mercado</strong> en la dirección contraria y con la misma cantidad para cerrar la posición. Una orden de mercado garantiza la ejecución; no garantiza el precio, así que espere ceder un tick o dos de slippage en un mercado en movimiento." },
        { title: "Confirme que está flat", html: "Confirme que su posición neta aparece como flat antes de hacer cualquier otra cosa." },
      ],
    },
    { type: "paragraph",html: "Este es el honesto equilibrio en el centro del problema: un límite protege su precio pero arriesga no ejecutarse; una orden de mercado garantiza la ejecución pero arriesga el precio. Si estar fuera importa más que el nivel exacto, no le pida a un límite pasivo que haga el trabajo de una orden de mercado." },
    { type: "heading",text: "Mejore sus probabilidades de ejecución sin renunciar al precio" },
    {
      type: "list",
      items: [
        "Coloque su límite algo más agresivo. Un límite de compra colocado uno o dos ticks más alto queda más cerca del frente de la negociación realista y se ejecuta con más frecuencia, a costa de una entrada ligeramente peor.",
        "Coloque la orden pronto y déjela en paz. La prioridad de tiempo premia la paciencia; cuanto antes se coloque y menos la toquetee, más cerca del frente se mantiene.",
        "Para los stops de protección, prefiera un stop que se convierta en orden de mercado antes que un stop-limit, que puede negarse a ejecutarse en un movimiento rápido, justo cuando no puede permitirse quedarse atascado.",
        "Opere el contrato activo durante las horas líquidas, ya que más flujo despeja la cola más rápido.",
      ],
    },
    { type: "heading",text: "Informe de una orden concreta que realmente debería haberse ejecutado" },
    {
      type: "steps",
      items: [
        { title: "Copie el Order ID", html: "Abra su informe de Orders y copie el <strong class='text-white'>Order ID</strong> de la orden en cuestión." },
        { title: "Anote los detalles", html: "Anote la hora exacta, el símbolo y el precio, y si la cinta muestra un cruce limpio de su nivel." },
        { title: "Envíelo al Trade Desk", html: "Envíe ese Order ID al Trade Desk y pídales que comprueben qué ocurrió con ella en la bolsa. Una orden concreta es lo único que pueden investigar de forma significativa; tampoco existe en su lado un botón global para «arreglar las ejecuciones»." },
      ],
    },
    { type: "heading",text: "Tabla de solución de problemas" },
    { type: "table", headers: ["Síntoma","Qué significa","Solución"], rows: [
      ["El precio tocó mi límite y rebotó, sin ejecución","La cola nunca se despejó hasta su posición en ese nivel","Es lo esperado; coloque de forma más agresiva o use una orden de mercado si necesita ejecutarse"],
      ["El precio atravesó el nivel pero aun así no me ejecutaron","Posible problema de enrutamiento o de la orden","Anote el Order ID y envíelo al Trade Desk para que lo investigue"],
      ["Las ejecuciones eran perfectas en demo, malas en real","El simulador fue más generoso que la cola real","Vuelva a probar en una cuenta real; no aumente el tamaño basándose en supuestos de ejecución de la demo"],
      ["Seguí modificando mi límite y las ejecuciones empeoraron","Cada cambio le devolvió al final de la cola","Colóquelo una vez y déjelo reposar; deje de perseguir el nivel"],
      ["No puedo salir; mi límite no se ejecuta","La salida pasiva está esperando en la cola","Cancele el límite y envíe una orden de mercado contraria para quedar flat"],
      ["El stop-limit no me sacó en un movimiento rápido","El tramo límite rechazó un precio peor en un gap","Use un stop que se convierta en orden de mercado como protección"],
    ] },
    { type: "heading",text: "Obtenga una ejecución consistente con PickMyTrade" },
    { type: "paragraph",html: "Ninguna herramienta puede reescribir el motor de casación de la bolsa, y cualquier producto que prometa ejecuciones limitadas «garantizadas» le está vendiendo un cuento. Lo que sí puede hacer la automatización es asegurarse de que sus órdenes salgan como usted pretendía, siempre, sin que se equivoque de tipo de orden bajo presión. PickMyTrade conecta sus alertas de TradingView directamente con Tradovate y elimina las conjeturas manuales de la ejecución:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Tipo de orden por señal.</strong> Decida de antemano si una entrada o una salida se envía como orden limitada o de mercado, para que una salida de «debo salir» no se quede esperando en un límite pasivo.",
        "<strong class='text-white'>Desplazamientos de precio en las entradas.</strong> Coloque límites a una distancia definida del precio de la señal: la idea de colocación agresiva descrita arriba, aplicada automáticamente.",
        "<strong class='text-white'>Stops de protección en cada posición.</strong> Adjunte un stop real en cuanto esté dentro, dimensionado a una pérdida que pueda soportar, en lugar de una salida mental que un límite pasivo quizá nunca alcance.",
        "<strong class='text-white'>Coherencia multicuenta.</strong> Envíe la misma orden prevista a todas las cuentas conectadas, para no teclear a mano los tipos de orden en cinco plataformas mientras el precio se mueve.",
      ],
    },
    { type: "paragraph",html: "El objetivo no es vencer a la cola. Es asegurarse de que la orden que quería enviar sea la que realmente sale, para que nunca quede atrapado en una posición porque un límite no se ejecutó." },
  ], fr: [
    { type: "paragraph",html: "Vous placez une limite d'achat à 5999.00, le prix descend pile à 5999.00, y reste, puis repart sans vous exécuter. Cela semble cassé. Vous avez vu le chiffre exact s'imprimer sur le tape et votre ordre n'a jamais bougé. C'est l'un des plus anciens griefs d'exécution sur Tradovate, et il pique surtout quand vous sortez et que le marché ne fait que taquiner votre niveau. Ce que personne n'aime entendre : dans presque tous les cas, la plateforme a fait exactement ce qu'un ordre à cours limité est censé faire. Il n'y a aucun bouton de bogue à actionner ni aucun réglage qui « corrige » la qualité d'exécution, car les ordres à cours limité actifs sont appariés par la bourse, pas par Tradovate. Ce que vous pouvez faire, c'est comprendre pourquoi un prix touché n'est pas un prix exécuté, et changer votre façon de sortir quand être à plat compte vraiment." },
    {
      type: "checklist",
      heading: "Liste de contrôle rapide pour les ordres à cours limité non exécutés",
      items: [
        "<strong class='text-white'>Un contact n'est pas une exécution.</strong> Le fait que le prix atteigne votre limite ne vous donne pas droit à une exécution ; il faut d'abord qu'un volume suffisant traverse la file devant vous.",
        "<strong class='text-white'>Vérifiez si le prix a traversé votre niveau ou l'a simplement effleuré.</strong> Un mouvement d'un tick au-delà vous exécute généralement ; un effleurement suivi d'un rebond, souvent non.",
        "<strong class='text-white'>Arrêtez de vous remettre vous-même en file.</strong> Chaque fois que vous modifiez le prix ou la taille d'une limite active, vous retombez au bout de la file à ce niveau.",
        "<strong class='text-white'>Utilisez un ordre au marché quand vous devez sortir.</strong> Il garantit une exécution (pas un prix). Une limite passive abandonne cette certitude.",
        "<strong class='text-white'>Ne prenez pas les exécutions démo pour des exécutions réelles.</strong> Le simulateur est plus clément que la vraie file.",
        "<strong class='text-white'>Notez l'Order ID de tout ce qui semble réellement anormal.</strong> C'est ce dont le Trade Desk a besoin pour enquêter sur un ordre précis.",
      ],
    },
    { type: "heading",text: "Ce que signifie vraiment « le prix a touché ma limite et n'a pas été exécuté »" },
    { type: "paragraph",html: "Un ordre à cours limité n'a qu'une mission : s'exécuter à votre prix ou mieux, jamais pire. Cette protection est tout l'intérêt de l'ordre, et c'est aussi pourquoi il peut vous laisser les mains vides. Parce qu'une limite refuse un prix moins bon, elle ne s'exécute que lorsque le marché atteint votre niveau et qu'il s'échange assez de contrats pour atteindre votre place précise dans la file." },
    { type: "paragraph",html: "Sur les contrats à terme, cette file est gérée par le moteur d'appariement de la bourse selon la <strong class='text-white'>priorité prix-temps</strong>, couramment appelée FIFO. Le meilleur prix est servi en premier et, parmi tous ceux qui attendent au même prix, celui qui est arrivé le premier est exécuté le premier. Quand vous posez une limite d'achat sur un niveau où il y a déjà du volume en attente, vous n'êtes pas le premier, vous êtes le dernier. Imaginons que 400 contrats soient déjà au bid à 5999.00 quand votre ordre arrive. Vous êtes en pratique le 401e contrat de la file. Le prix descend à 5999.00, mais seuls 350 contrats s'échangent avant qu'il ne remonte à 5999.50. Ces 350 exécutions sont allées aux ordres devant vous. Vous n'en avez reçu aucune, car le marché n'a jamais échangé assez profondément pour atteindre votre position, et n'a jamais <em>traversé</em> le niveau pour balayer toute la file." },
    { type: "paragraph",html: "C'est la différence qui piège tout le monde. Si le prix était descendu à 5998.75, un niveau au-delà de votre limite, toute la file à 5999.00 aurait généralement été purgée et vous auriez été exécuté. Un effleurement suivi d'un rebond exactement à votre prix est le scénario classique du « il a touché mon niveau et je n'ai pas été exécuté », et ce n'est pas un dysfonctionnement. C'est la mécanique de la file qui fonctionne comme toujours." },
    { type: "heading",text: "Principales causes d'une mauvaise qualité d'exécution des limites" },
    { type: "heading",text: "1. La position dans la file (la cause principale)" },
    { type: "paragraph",html: "Vous vous retrouvez presque toujours au bout de la file à votre prix. Si le marché n'échange que partiellement votre niveau avant de se retourner, les exécutions vont aux ordres devant vous et vous restez en attente. Plus il y a de volume en attente à ce niveau, plus il faut de contrats échangés avant que votre tour n'arrive." },
    { type: "heading",text: "2. Le prix n'a fait qu'effleurer le niveau, sans le traverser" },
    { type: "paragraph",html: "Un simple contact, ou une mèche rapide qui imprime votre prix l'espace d'un battement de cœur, déplace rarement assez de volume pour purger la file. Les limites s'exécutent proprement quand le prix s'échange un tick ou plus au-delà, pas quand elles sont frôlées." },
    { type: "heading",text: "3. Vous avez modifié l'ordre et perdu la priorité" },
    { type: "paragraph",html: "Changer le prix d'une limite active, ou augmenter sa quantité, la remet en file. Toute la priorité de temps gagnée en attendant là est perdue et vous repartez au bout de la file. Courir après un niveau en ajustant sans cesse votre ordre peut activement réduire vos chances." },
    { type: "heading",text: "4. Les exécutions démo créent de fausses attentes" },
    { type: "paragraph",html: "Les comptes simulés, y compris la plupart des évaluations de prop firms, ne sont pas acheminés vers la bourse. Ils modélisent les exécutions, et le modèle tend à être généreux. Une approche à limites qui s'exécute à chaque fois en démo peut se mettre à rater des exécutions face à une vraie file en réel, ce qui fait paraître les exécutions réelles « moins bonnes » alors qu'elles sont simplement honnêtes." },
    { type: "heading",text: "5. Liquidité mince ou trading hors horaires" },
    { type: "paragraph",html: "Sur un contrat à faible volume ou pendant les heures calmes de la nuit, il ne s'échange pas assez de contrats pour purger rapidement une file en attente. L'ordre n'est pas bloqué ; il n'y a simplement pas de flux pour l'exécuter." },
    { type: "heading",text: "Comment corriger une mauvaise exécution des limites et sortir proprement : pas à pas" },
    { type: "heading",text: "Confirmez qu'il s'agit de la mécanique de file et non d'un ordre bloqué" },
    {
      type: "steps",
      items: [
        { title: "Vérifier le statut de l'ordre", html: "Ouvrez le module Orders et vérifiez le statut de l'ordre. S'il indique working ou accepted, l'ordre est actif et n'a simplement pas encore été atteint dans la file ; c'est normal, pas un blocage." },
        { title: "Vérifier si le prix a traversé", html: "Regardez si le prix a <em>traversé</em> votre niveau ou l'a seulement effleuré. Une absence d'exécution après un effleurement suivi d'un rebond est attendue ; une traversée nette qui vous a ignoré mérite un examen plus attentif." },
        { title: "Observer le DOM à votre prix", html: "Un gros volume devant vous signifie que beaucoup de contrats doivent s'échanger avant que votre tour n'arrive." },
      ],
    },
    { type: "heading",text: "Quand vous devez sortir, envoyez un ordre au marché" },
    {
      type: "steps",
      items: [
        { title: "Annuler d'abord la limite en attente", html: "Annulez d'abord la limite en attente afin de ne pas être exécuté deux fois si elle se déclenche un instant plus tard." },
        { title: "Passer un ordre au marché", html: "Passez un simple <strong class='text-white'>ordre au marché</strong> dans la direction opposée et avec la quantité correspondante pour clôturer la position. Un ordre au marché garantit l'exécution ; il ne garantit pas le prix, attendez-vous donc à céder un tick ou deux de slippage sur un marché en mouvement." },
        { title: "Confirmer que vous êtes à plat", html: "Vérifiez que votre position nette indique bien flat avant de faire quoi que ce soit d'autre." },
      ],
    },
    { type: "paragraph",html: "C'est le compromis honnête au cœur du problème : une limite protège votre prix mais risque la non-exécution ; un ordre au marché garantit l'exécution mais risque le prix. Si être sorti compte plus que le niveau exact, ne demandez pas à une limite passive de faire le travail d'un ordre au marché." },
    { type: "heading",text: "Améliorez vos chances d'exécution sans renoncer au prix" },
    {
      type: "list",
      items: [
        "Placez votre limite un peu plus agressivement. Une limite d'achat placée un ou deux ticks plus haut se trouve plus près du front du trading réaliste et s'exécute plus souvent, au prix d'une entrée légèrement moins bonne.",
        "Placez l'ordre tôt et laissez-le tranquille. La priorité de temps récompense la patience ; plus tôt vous vous placez et moins vous y touchez, plus vous restez près du front.",
        "Pour les stops de protection, préférez un stop qui devient un ordre au marché à un stop-limite, qui peut refuser de s'exécuter lors d'un mouvement rapide, précisément quand vous ne pouvez pas vous permettre d'être bloqué.",
        "Tradez le contrat actif pendant les heures liquides, car un flux plus important purge la file plus vite.",
      ],
    },
    { type: "heading",text: "Signalez un ordre précis qui aurait vraiment dû être exécuté" },
    {
      type: "steps",
      items: [
        { title: "Copier l'Order ID", html: "Ouvrez votre rapport Orders et copiez l'<strong class='text-white'>Order ID</strong> de l'ordre concerné." },
        { title: "Noter les détails", html: "Notez l'heure exacte, le symbole et le prix, ainsi que si le tape montre une traversée nette de votre niveau." },
        { title: "L'envoyer au Trade Desk", html: "Envoyez cet Order ID au Trade Desk et demandez-lui de vérifier ce qui est arrivé à l'ordre à la bourse. Un ordre précis est la seule chose qu'il peut examiner utilement ; il n'existe pas non plus de bouton global « corriger les exécutions » de son côté." },
      ],
    },
    { type: "heading",text: "Tableau de dépannage" },
    { type: "table", headers: ["Symptôme","Ce que cela signifie","Solution"], rows: [
