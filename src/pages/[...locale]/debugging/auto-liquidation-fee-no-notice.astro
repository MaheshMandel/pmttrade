---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "auto-liquidation-fee-no-notice";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/debugging/${SLUG}`;

const META_TITLE = "Tradovate $50 Auto-Liquidation Fee & No Warning";
const META_DESCRIPTION =
  "Tradovate auto-liquidation fee explained: why margin shortfalls trigger a no-warning close and a $25/$50 charge, plus how a buffer prevents it.";

// Short SEO title (<=60 chars) for locales where the shared h1 is too long for a SERP title.
const TITLE_OVERRIDE: Partial<Record<Locale, string>> = { de: "Tradovate: 50-$-Auto-Liquidation-Gebühr ohne Vorwarnung", es: "Tradovate: comisión de auto-liquidación de 50 $ sin aviso", fr: "Tradovate : frais d'auto-liquidation de 50 $ sans préavis", it: "Tradovate: auto-liquidazione da 50 $ senza preavviso" };

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Tradovate 50 $ Auto-Liquidation-Gebühr ohne Vorwarnung beheben", es: "Cómo solucionar la comisión de auto-liquidación de 50 $ sin aviso de Tradovate", fr: "Corriger les frais d'auto-liquidation de 50 $ sans préavis de Tradovate", it: "Come risolvere la commissione di auto-liquidazione da 50 $ senza preavviso di Tradovate" },
  dek: { en: "The position is gone and there's a charge on your statement you never authorized. Tradovate can close a margin-deficient account with or without notice, here's every trigger and how to stay ahead of it.", de: "Die Position ist verschwunden, und auf Ihrem Kontoauszug steht eine Belastung, die Sie nie autorisiert haben. Tradovate kann ein Konto mit unzureichender Margin mit oder ohne Vorwarnung schließen, hier sind alle Auslöser und wie Sie ihnen zuvorkommen.", es: "La posición ha desaparecido y hay un cargo en su estado de cuenta que nunca autorizó. Tradovate puede cerrar una cuenta con margen insuficiente con o sin aviso, aquí tiene todos los desencadenantes y cómo adelantarse a ellos.", fr: "La position a disparu et il y a des frais sur votre relevé que vous n'avez jamais autorisés. Tradovate peut fermer un compte à marge insuffisante avec ou sans préavis, voici tous les déclencheurs et comment les anticiper.", it: "La posizione è sparita e c'è un addebito sul vostro estratto conto che non avete mai autorizzato. Tradovate può chiudere un conto con margine insufficiente con o senza preavviso, ecco tutti i fattori scatenanti e come anticiparli." },
  readTime: { en: "8 min read", de: "8 Minuten Lesezeit", es: "Lectura de 8 minutos", fr: "Lecture de 8 minutes", it: "Lettura di 8 minuti" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "You log in, the account is flat, the open position is gone, and there's a small charge on your statement you never authorized. That's the Tradovate auto-liquidation fee doing its job in 2026, and it sits entirely inside the rules you agreed to. Tradovate's published policy is blunt: the firm &ldquo;may liquidate the account with or without notification depending upon market conditions based upon the sole discretion of the firm.&rdquo; When your account slips below the margin it has to hold, the platform closes the position for you and bills an execution fee per event, $25 for the first liquidation and $50 for each one after that. No pop-up, no confirmation, no second chance. Here's the upside: this is one of the most preventable charges in futures trading, and this guide shows you exactly how to stay ahead of it." },
    {
      type: "checklist",
      heading: "Quick checklist for avoiding auto-liquidation",
      items: [
        "<strong class='text-white'>Keep a real margin buffer.</strong> Never run the account right at the margin requirement, leave headroom for a fast tick against you.",
        "<strong class='text-white'>Know your overnight (initial) margin.</strong> Intraday margin is far lower than the margin needed to <em>hold</em> a position past the session close.",
        "<strong class='text-white'>Flatten before the daily reset</strong> if you can't meet the higher overnight requirement. Don't let the platform do it for you.",
        "<strong class='text-white'>Check whether a loss limit is enabled.</strong> A tripped daily loss limit can auto-liquidate and lock the account on a &ldquo;not held&rdquo; basis.",
        "<strong class='text-white'>Roll expiring contracts early.</strong> Positions left in a contract heading into delivery get liquidated.",
        "<strong class='text-white'>Read your statement.</strong> The liquidation fee shows up as a line item, catch it early so you can fix the behavior.",
      ],
    },
    { type: "heading", text: "What the Tradovate auto-liquidation fee actually is" },
    { type: "paragraph", html: "Auto-liquidation is Tradovate's automated risk process. When your account equity can no longer support the margin on your open positions, the system doesn't wait for you to react, it closes the position at market to protect the account (and the broker) from going negative. Because a human didn't place that closing order, Tradovate treats it as a firm-initiated execution and applies an administrative charge for it." },
    { type: "paragraph", html: "The fee is small next to a blown trade, but it's real money, and it's charged <strong class='text-white'>per liquidation event</strong>, not once per day. The amount is $25 for the first liquidation and $50 for each subsequent one. A separate margin-call fee is often listed alongside it ($50 for the first, $100 after). These schedules can be revised, so treat the exact figures as a guide and confirm the current numbers in Tradovate's admin-fee documentation before you rely on them." },
    { type: "paragraph", html: "The part that catches traders off guard is the &ldquo;no warning.&rdquo; Tradovate explicitly reserves the right to act &ldquo;with or without notification&rdquo; and to &ldquo;increase or decrease margin requirements in its sole discretion at any time.&rdquo; So the trigger can move without you touching anything, a margin bump around a news event or the session close is enough to put an otherwise fine position underwater." },
    { type: "heading", text: "Top causes of a Tradovate auto-liquidation in 2026" },
    { type: "heading", text: "1. Margin deficiency during the session" },
    { type: "paragraph", html: "This is the core trigger. Every futures position has a margin requirement, and your account has to cover it at all times. If price moves against you and your available (excess) margin turns negative, Tradovate can liquidate the position immediately. Requirements vary by contract, volatility, and your account or prop firm, so check your current number instead of assuming yesterday's still holds." },
    { type: "heading", text: "2. Holding overnight without initial margin" },
    { type: "paragraph", html: "This is the classic trap. Intraday day-trading margin is a fraction of the <em>initial</em> margin needed to carry a position into the next session. Tradovate's policy states accounts &ldquo;must meet Initial Margin requirements&rdquo; to hold positions overnight. If you're cruising on low intraday margin and you don't flatten before the daily reset (around the session close), the platform can close the position at the reset and bill the fee. The position &ldquo;closed by itself&rdquo;, with nothing you did wrong except stay in it." },
    { type: "heading", text: "3. A tripped daily loss limit or risk setting" },
    { type: "paragraph", html: "If a daily loss limit or auto-liquidation risk rule is enabled on the account, hitting it automatically liquidates open positions and can lock the account on a &ldquo;not held&rdquo; basis for the rest of the session. On prop-firm evaluation accounts, the firm usually configures these rules for you, so the liquidation is the firm's risk engine acting, not a Tradovate billing decision." },
    { type: "heading", text: "4. Expiring or delivery-period contracts" },
    { type: "paragraph", html: "Positions left in a physically deliverable future past its roll or first-notice window get liquidated to avoid delivery. Trade continuous symbols or forget to roll, and you can be flattened simply because the contract is expiring." },
    { type: "heading", text: "5. A discretionary margin increase" },
    { type: "paragraph", html: "Tradovate can raise margin requirements at any time, often around high-impact economic releases or ahead of a weekend. A position that fit comfortably an hour ago can breach the new requirement the moment it takes effect, and the account gets liquidated with no notice." },
    { type: "heading", text: "How to fix and prevent Tradovate auto-liquidation: step by step" },
    { type: "heading", text: "Fixing margin-buffer problems" },
    {
      type: "list",
      items: [
        "Open the account/margin panel and compare your <strong class='text-white'>total margin used</strong> against your <strong class='text-white'>available margin</strong>. If the two are close, you're one bad tick from liquidation.",
        "Reduce size until your available margin leaves genuine headroom. Keep a buffer well above the bare minimum so normal noise never breaches it.",
        "Before any position you might hold past the close, confirm the <strong class='text-white'>overnight/initial</strong> requirement, not just the intraday number, and make sure your equity covers it.",
      ],
    },
    { type: "heading", text: "Confirming and disputing the fee on your statement" },
    {
      type: "list",
      items: [
        "Open your account statement or activity/reports view and find the liquidation (execution) fee line item tied to the timestamp of the close.",
        "Match it against the liquidated order in your order history so you know exactly which event was charged.",
        "If the fee looks wrong, say you believe the account was never actually margin-deficient, contact Tradovate (or your prop firm, if it's a funded account) with the timestamps and order IDs. The fee is administrative, so disputes go through support and aren't reversed automatically.",
      ],
    },
    { type: "heading", text: "Setting your own guardrails so the platform never has to" },
    {
      type: "list",
      items: [
        "Open <strong class='text-white'>Risk Settings</strong> for the account and review any daily loss limit, max position, and auto-liquidation rules already in place.",
        "Set a loss limit <em>you</em> control at a level above your normal drawdown but below a catastrophic loss, so your own rule flattens you cleanly before a margin breach does it messier.",
        "Cap your max position size so a fat-finger or a runaway automation can't build a position larger than your margin can hold.",
      ],
    },
    { type: "heading", text: "Handling the overnight and rollover cases" },
    {
      type: "list",
      items: [
        "If you can't meet overnight margin, set a personal alarm before the session reset and flatten manually. Never rely on the reset to be gentle.",
        "Trade the correct front-month contract and roll early. Don't hold anything into its delivery/expiration window.",
        "Around major news, assume margin can jump. If you must hold through it, carry extra buffer or reduce size going in.",
      ],
    },
    { type: "heading", text: "Troubleshooting table" },
    {
      type: "table",
      headers: ["What you see", "What it means", "Fix"],
      rows: [
        ["Position gone, small fee on statement", "Auto-liquidation for margin deficiency ($25 first event, $50 after, confirm current schedule)", "Add margin buffer; reduce size"],
        ["Position \"closed by itself\" near session close", "Didn't meet overnight/initial margin at the daily reset", "Flatten before reset or fund for overnight margin"],
        ["Account liquidated and locked mid-session", "A daily loss limit / risk rule tripped (\"not held\" basis)", "Review Risk Settings or contact your prop firm"],
        ["Flattened as contract nears expiry", "Delivery/expiration liquidation", "Roll to the active front-month contract early"],
        ["Fine one minute, liquidated the next", "Discretionary margin increase (e.g., news/weekend)", "Keep extra buffer; cut size before high-impact events"],
        ["Fee you don't recognize on the statement", "Per-event execution/liquidation charge", "Match to the order, then dispute with support if wrong"],
      ],
    },
    { type: "heading", text: "Prevent this with PickMyTrade" },
    { type: "paragraph", html: "Most auto-liquidations trace back to size and timing that a disciplined order layer would have caught. PickMyTrade sits between your TradingView alerts and Tradovate and enforces the guardrails automatically:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Qty / Symbol Validation</strong>, blocks orders that would build a position larger than your account can margin, before they ever reach Tradovate.",
        "<strong class='text-white'>Entitlement &amp; Risk Filters</strong>, respect prop-firm limits and account risk state, so automation can't push you into a breach.",
        "<strong class='text-white'>Rate-Limit-Safe Routing</strong>, spaces out order flow so exits and adjustments land cleanly when you need them most.",
        "<strong class='text-white'>Multi-Account Sync</strong>, mirrors your corrected, correctly sized orders across every connected account at once.",
      ],
    },
    { type: "paragraph", html: "Instead of discovering a liquidation after the fact, you trade with the caps baked into every order." },
  ], de: [
    { type: "paragraph", html: "Sie loggen sich ein, das Konto ist flach, die offene Position ist verschwunden, und auf Ihrem Kontoauszug steht eine kleine Belastung, die Sie nie autorisiert haben. Das ist die Tradovate Auto-Liquidation-Gebühr, die 2026 ihre Arbeit tut, und sie liegt vollständig innerhalb der Regeln, denen Sie zugestimmt haben. Tradovates veröffentlichte Richtlinie ist unverblümt: Die Firma „kann das Konto mit oder ohne Benachrichtigung liquidieren, je nach Marktbedingungen und nach alleinigem Ermessen der Firma.“ Sinkt Ihr Konto unter die Margin, die es halten muss, schließt die Plattform die Position für Sie und stellt eine Ausführungsgebühr pro Ereignis in Rechnung, 25 $ für die erste Liquidation und 50 $ für jede weitere. Kein Pop-up, keine Bestätigung, keine zweite Chance. Die gute Nachricht: Das ist eine der am leichtesten vermeidbaren Gebühren im Futures-Handel, und dieser Leitfaden zeigt Ihnen genau, wie Sie ihr zuvorkommen." },
    {
      type: "checklist",
      heading: "Kurz-Checkliste zur Vermeidung der Auto-Liquidation",
      items: [
        "<strong class='text-white'>Halten Sie einen echten Margin-Puffer.</strong> Fahren Sie das Konto nie exakt an der Margin-Anforderung, lassen Sie Spielraum für einen schnellen Tick gegen Sie.",
        "<strong class='text-white'>Kennen Sie Ihre Overnight-(Initial-)Margin.</strong> Die Intraday-Margin liegt weit unter der Margin, die nötig ist, um eine Position über den Sitzungsschluss hinaus zu <em>halten</em>.",
        "<strong class='text-white'>Vor dem täglichen Reset glattstellen</strong>, wenn Sie die höhere Overnight-Anforderung nicht erfüllen können. Überlassen Sie das nicht der Plattform.",
        "<strong class='text-white'>Prüfen Sie, ob ein Verlustlimit aktiviert ist.</strong> Ein ausgelöstes tägliches Verlustlimit kann automatisch liquidieren und das Konto für den Rest der Sitzung „not held“ sperren.",
        "<strong class='text-white'>Ablaufende Kontrakte frühzeitig rollen.</strong> Positionen, die in einem Kontrakt bis zur Lieferung verbleiben, werden liquidiert.",
        "<strong class='text-white'>Lesen Sie Ihren Kontoauszug.</strong> Die Liquidationsgebühr erscheint als Position, erkennen Sie sie früh, damit Sie das Verhalten korrigieren können.",
      ],
    },
    { type: "heading", text: "Was die Tradovate Auto-Liquidation-Gebühr tatsächlich ist" },
    { type: "paragraph", html: "Auto-Liquidation ist Tradovates automatisierter Risikoprozess. Wenn Ihr Kontoeigenkapital die Margin auf Ihre offenen Positionen nicht mehr trägt, wartet das System nicht darauf, dass Sie reagieren, es schließt die Position zum Marktpreis, um das Konto (und den Broker) davor zu schützen, ins Negative zu rutschen. Da ein Mensch diese Schließ-Order nicht platziert hat, behandelt Tradovate sie als von der Firma initiierte Ausführung und erhebt dafür eine Verwaltungsgebühr." },
    { type: "paragraph", html: "Die Gebühr ist klein im Vergleich zu einem gesprengten Trade, aber es ist echtes Geld, und sie wird <strong class='text-white'>pro Liquidationsereignis</strong> berechnet, nicht einmal pro Tag. Der Betrag liegt bei 25 $ für die erste Liquidation und 50 $ für jede weitere. Eine separate Margin-Call-Gebühr wird oft daneben aufgeführt (50 $ für die erste, 100 $ danach). Diese Gebührenstaffeln können überarbeitet werden, betrachten Sie die genauen Zahlen also als Richtwert und bestätigen Sie die aktuellen Beträge in Tradovates Verwaltungsgebühren-Dokumentation, bevor Sie sich darauf verlassen." },
    { type: "paragraph", html: "Der Teil, der Trader überrascht, ist die „keine Vorwarnung“. Tradovate behält sich ausdrücklich das Recht vor, „mit oder ohne Benachrichtigung“ zu handeln und „Margin-Anforderungen nach alleinigem Ermessen jederzeit zu erhöhen oder zu senken.“ Der Auslöser kann sich also verschieben, ohne dass Sie irgendetwas anfassen, eine Margin-Erhöhung rund um ein Nachrichtenereignis oder den Sitzungsschluss reicht aus, um eine ansonsten in Ordnung befindliche Position unter Wasser zu setzen." },
    { type: "heading", text: "Häufigste Ursachen für eine Tradovate Auto-Liquidation im Jahr 2026" },
    { type: "heading", text: "1. Margin-Defizit während der Sitzung" },
    { type: "paragraph", html: "Das ist der Kernauslöser. Jede Futures-Position hat eine Margin-Anforderung, und Ihr Konto muss diese jederzeit decken. Bewegt sich der Preis gegen Sie und wird Ihre verfügbare (Überschuss-)Margin negativ, kann Tradovate die Position sofort liquidieren. Die Anforderungen variieren je nach Kontrakt, Volatilität und Ihrem Konto oder Ihrer Prop-Firma, prüfen Sie also Ihre aktuelle Zahl, statt anzunehmen, dass die von gestern noch gilt." },
    { type: "heading", text: "2. Übernacht halten ohne Initial-Margin" },
    { type: "paragraph", html: "Das ist die klassische Falle. Die Intraday-Daytrading-Margin ist ein Bruchteil der <em>Initial</em>-Margin, die nötig ist, um eine Position in die nächste Sitzung zu tragen. Tradovates Richtlinie besagt, dass Konten „die Initial-Margin-Anforderungen erfüllen müssen“, um Positionen über Nacht zu halten. Wenn Sie mit niedriger Intraday-Margin unterwegs sind und vor dem täglichen Reset (rund um den Sitzungsschluss) nicht glattstellen, kann die Plattform die Position beim Reset schließen und die Gebühr berechnen. Die Position „schloss sich von selbst“, ohne dass Sie etwas falsch gemacht hätten, außer darin zu bleiben." },
    { type: "heading", text: "3. Ein ausgelöstes tägliches Verlustlimit oder eine Risikoeinstellung" },
    { type: "paragraph", html: "Ist auf dem Konto ein tägliches Verlustlimit oder eine Auto-Liquidation-Risikoregel aktiviert, liquidiert deren Erreichen automatisch offene Positionen und kann das Konto für den Rest der Sitzung „not held“ sperren. Bei Prop-Firma-Evaluierungskonten konfiguriert die Firma diese Regeln in der Regel für Sie, sodass die Liquidation von der Risiko-Engine der Firma stammt, nicht von einer Tradovate-Abrechnungsentscheidung." },
    { type: "heading", text: "4. Ablaufende oder in der Lieferperiode befindliche Kontrakte" },
    { type: "paragraph", html: "Positionen, die in einem physisch lieferbaren Future über dessen Roll- oder First-Notice-Fenster hinaus verbleiben, werden liquidiert, um die Lieferung zu vermeiden. Handeln Sie kontinuierliche Symbole oder vergessen Sie das Rollen, kann Ihre Position schlicht glattgestellt werden, weil der Kontrakt ausläuft." },
    { type: "heading", text: "5. Eine Margin-Erhöhung nach Ermessen" },
    { type: "paragraph", html: "Tradovate kann Margin-Anforderungen jederzeit erhöhen, oft rund um wirkungsstarke Wirtschaftsveröffentlichungen oder vor einem Wochenende. Eine Position, die vor einer Stunde noch bequem passte, kann die neue Anforderung in dem Moment verletzen, in dem sie in Kraft tritt, und das Konto wird ohne Vorwarnung liquidiert." },
    { type: "heading", text: "So beheben und verhindern Sie eine Tradovate Auto-Liquidation: Schritt für Schritt" },
    { type: "heading", text: "Margin-Puffer-Probleme beheben" },
    {
      type: "list",
      items: [
        "Öffnen Sie das Konto-/Margin-Panel und vergleichen Sie Ihre <strong class='text-white'>genutzte Gesamtmargin</strong> mit Ihrer <strong class='text-white'>verfügbaren Margin</strong>. Liegen beide nah beieinander, sind Sie einen schlechten Tick von der Liquidation entfernt.",
        "Reduzieren Sie die Größe, bis Ihre verfügbare Margin echten Spielraum lässt. Halten Sie einen Puffer deutlich über dem bloßen Minimum, damit normales Rauschen ihn nie verletzt.",
        "Bestätigen Sie vor jeder Position, die Sie über den Sitzungsschluss hinaus halten könnten, die <strong class='text-white'>Overnight-/Initial</strong>-Anforderung, nicht nur die Intraday-Zahl, und stellen Sie sicher, dass Ihr Eigenkapital sie deckt.",
      ],
    },
    { type: "heading", text: "Die Gebühr auf Ihrem Kontoauszug bestätigen und anfechten" },
    {
      type: "list",
      items: [
        "Öffnen Sie Ihren Kontoauszug oder die Aktivitäts-/Berichtsansicht und finden Sie die Liquidations-(Ausführungs-)Gebührenposition, die mit dem Zeitstempel der Schließung verknüpft ist.",
        "Gleichen Sie sie mit der liquidierten Order in Ihrer Order-Historie ab, damit Sie genau wissen, welches Ereignis berechnet wurde.",
        "Wirkt die Gebühr falsch, etwa weil Sie glauben, das Konto sei nie tatsächlich margin-defizitär gewesen, kontaktieren Sie Tradovate (oder Ihre Prop-Firma, bei einem finanzierten Konto) mit den Zeitstempeln und Order-IDs. Die Gebühr ist administrativ, Einsprüche laufen also über den Support und werden nicht automatisch storniert.",
      ],
    },
    { type: "heading", text: "Eigene Leitplanken setzen, damit die Plattform es nie muss" },
    {
      type: "list",
      items: [
        "Öffnen Sie <strong class='text-white'>Risk Settings</strong> für das Konto und prüfen Sie jedes bereits vorhandene tägliche Verlustlimit, die maximale Position und Auto-Liquidation-Regeln.",
        "Setzen Sie ein Verlustlimit, das <em>Sie</em> selbst kontrollieren, auf einem Niveau über Ihrem normalen Drawdown, aber unter einem katastrophalen Verlust, sodass Ihre eigene Regel Sie sauber glattstellt, bevor eine Margin-Verletzung es unordentlicher tut.",
        "Begrenzen Sie Ihre maximale Positionsgröße, damit ein Verwählen oder eine außer Kontrolle geratene Automatisierung keine größere Position aufbauen kann, als Ihre Margin tragen kann.",
      ],
    },
    { type: "heading", text: "Umgang mit Overnight- und Rollover-Fällen" },
    {
      type: "list",
      items: [
        "Können Sie die Overnight-Margin nicht erfüllen, stellen Sie sich einen persönlichen Alarm vor dem Sitzungs-Reset und stellen Sie manuell glatt. Verlassen Sie sich nie darauf, dass der Reset sanft ausfällt.",
        "Handeln Sie den richtigen Frontmonat-Kontrakt und rollen Sie frühzeitig. Halten Sie nichts bis in dessen Liefer-/Ablauffenster hinein.",
        "Nehmen Sie rund um wichtige Nachrichten an, dass die Margin springen kann. Müssen Sie durchhalten, tragen Sie zusätzlichen Puffer oder reduzieren Sie die Größe vorher.",
      ],
    },
    { type: "heading", text: "Fehlerbehebungstabelle" },
    {
      type: "table",
      headers: ["Was Sie sehen", "Was es bedeutet", "Lösung"],
      rows: [
        ["Position weg, kleine Gebühr auf dem Auszug", "Auto-Liquidation wegen Margin-Defizit (25 $ erstes Ereignis, 50 $ danach, aktuelle Staffel bestätigen)", "Margin-Puffer hinzufügen; Größe reduzieren"],
        ["Position „schloss sich von selbst“ nahe Sitzungsschluss", "Overnight-/Initial-Margin beim täglichen Reset nicht erfüllt", "Vor dem Reset glattstellen oder für Overnight-Margin finanzieren"],
        ["Konto mitten in der Sitzung liquidiert und gesperrt", "Ein tägliches Verlustlimit / eine Risikoregel wurde ausgelöst („not held“)", "Risk Settings prüfen oder Prop-Firma kontaktieren"],
        ["Glattgestellt, während der Kontrakt sich dem Ablauf nähert", "Liefer-/Ablauf-Liquidation", "Frühzeitig auf den aktiven Frontmonat-Kontrakt rollen"],
        ["Eine Minute in Ordnung, die nächste liquidiert", "Margin-Erhöhung nach Ermessen (z. B. Nachrichten/Wochenende)", "Zusätzlichen Puffer halten; Größe vor wirkungsstarken Ereignissen kürzen"],
        ["Gebühr auf dem Auszug, die Sie nicht erkennen", "Ausführungs-/Liquidationsgebühr pro Ereignis", "Mit der Order abgleichen, dann bei Fehler beim Support anfechten"],
      ],
    },
    { type: "heading", text: "So verhindern Sie das mit PickMyTrade" },
    { type: "paragraph", html: "Die meisten Auto-Liquidationen lassen sich auf Größe und Timing zurückführen, die eine diszipliniertes Order-Layer abgefangen hätte. PickMyTrade sitzt zwischen Ihren TradingView-Alerts und Tradovate und setzt die Leitplanken automatisch durch:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Mengen-/Symbolvalidierung</strong>, blockiert Orders, die eine größere Position aufbauen würden, als Ihr Konto absichern kann, bevor sie Tradovate überhaupt erreichen.",
        "<strong class='text-white'>Berechtigungs- &amp; Risikofilter</strong>, respektieren Prop-Firma-Limits und den Risikostatus des Kontos, sodass Automatisierung Sie nicht in eine Verletzung drängen kann.",
        "<strong class='text-white'>Rate-Limit-sicheres Routing</strong>, verteilt den Order-Flow zeitlich, sodass Ausstiege und Anpassungen sauber ankommen, wenn Sie sie am dringendsten brauchen.",
        "<strong class='text-white'>Multi-Account-Sync</strong>, spiegelt Ihre korrigierten, korrekt bemessenen Orders über jedes verbundene Konto hinweg auf einmal.",
      ],
    },
    { type: "paragraph", html: "Statt eine Liquidation im Nachhinein zu entdecken, handeln Sie mit den Obergrenzen, die in jede Order eingebacken sind." },
  ], es: [
    { type: "paragraph", html: "Inicia sesión, la cuenta está plana, la posición abierta ha desaparecido, y hay un pequeño cargo en su estado de cuenta que nunca autorizó. Esa es la comisión de auto-liquidación de Tradovate haciendo su trabajo en 2026, y se encuentra enteramente dentro de las reglas que usted aceptó. La política publicada de Tradovate es contundente: la firma «puede liquidar la cuenta con o sin notificación según las condiciones del mercado, a discreción exclusiva de la firma». Cuando su cuenta cae por debajo del margen que debe mantener, la plataforma cierra la posición por usted y factura una comisión de ejecución por evento, 25 $ por la primera liquidación y 50 $ por cada una posterior. Sin ventana emergente, sin confirmación, sin segunda oportunidad. Aquí está la buena noticia: este es uno de los cargos más evitables en el trading de futuros, y esta guía le muestra exactamente cómo adelantarse a él." },
    {
      type: "checklist",
      heading: "Lista de verificación rápida para evitar la auto-liquidación",
      items: [
        "<strong class='text-white'>Mantenga un colchón de margen real.</strong> Nunca opere la cuenta justo en el requisito de margen, deje espacio para un tick rápido en su contra.",
        "<strong class='text-white'>Conozca su margen nocturno (inicial).</strong> El margen intradía es mucho menor que el margen necesario para <em>mantener</em> una posición más allá del cierre de la sesión.",
        "<strong class='text-white'>Cierre posiciones antes del reinicio diario</strong> si no puede cumplir el requisito nocturno más alto. No deje que la plataforma lo haga por usted.",
        "<strong class='text-white'>Compruebe si hay un límite de pérdidas habilitado.</strong> Un límite de pérdida diario alcanzado puede auto-liquidar y bloquear la cuenta en modo «not held».",
        "<strong class='text-white'>Haga rollover de los contratos que vencen con antelación.</strong> Las posiciones que quedan en un contrato camino a la entrega se liquidan.",
        "<strong class='text-white'>Lea su estado de cuenta.</strong> La comisión de liquidación aparece como una línea, detéctela pronto para poder corregir el comportamiento.",
      ],
    },
    { type: "heading", text: "Qué es realmente la comisión de auto-liquidación de Tradovate" },
    { type: "paragraph", html: "La auto-liquidación es el proceso de riesgo automatizado de Tradovate. Cuando el capital de su cuenta ya no puede sostener el margen de sus posiciones abiertas, el sistema no espera a que usted reaccione, cierra la posición a mercado para proteger la cuenta (y al bróker) de caer en negativo. Como un humano no colocó esa orden de cierre, Tradovate la trata como una ejecución iniciada por la firma y aplica un cargo administrativo por ella." },
    { type: "paragraph", html: "La comisión es pequeña frente a una operación fallida, pero es dinero real, y se cobra <strong class='text-white'>por evento de liquidación</strong>, no una vez al día. El importe es de 25 $ por la primera liquidación y 50 $ por cada una posterior. A menudo se lista junto a ella una comisión de margin call independiente (50 $ la primera, 100 $ después). Estas tarifas pueden revisarse, así que trate las cifras exactas como una referencia y confirme los importes actuales en la documentación de comisiones administrativas de Tradovate antes de confiar en ellos." },
    { type: "paragraph", html: "La parte que agarra a los traders desprevenidos es el «sin aviso». Tradovate se reserva expresamente el derecho de actuar «con o sin notificación» y de «aumentar o disminuir los requisitos de margen a su exclusiva discreción en cualquier momento». Así que el desencadenante puede moverse sin que usted toque nada, un aumento de margen en torno a un evento de noticias o al cierre de la sesión basta para dejar bajo el agua una posición que por lo demás estaba bien." },
    { type: "heading", text: "Principales causas de una auto-liquidación de Tradovate en 2026" },
    { type: "heading", text: "1. Déficit de margen durante la sesión" },
    { type: "paragraph", html: "Este es el desencadenante principal. Cada posición de futuros tiene un requisito de margen, y su cuenta debe cubrirlo en todo momento. Si el precio se mueve en su contra y su margen disponible (excedente) se vuelve negativo, Tradovate puede liquidar la posición de inmediato. Los requisitos varían según el contrato, la volatilidad y su cuenta o firma prop, así que consulte su cifra actual en lugar de asumir que la de ayer sigue vigente." },
    { type: "heading", text: "2. Mantener posiciones durante la noche sin margen inicial" },
    { type: "paragraph", html: "Esta es la trampa clásica. El margen de day trading intradía es una fracción del margen <em>inicial</em> necesario para llevar una posición a la siguiente sesión. La política de Tradovate establece que las cuentas «deben cumplir los requisitos de margen inicial» para mantener posiciones durante la noche. Si opera con margen intradía bajo y no cierra antes del reinicio diario (en torno al cierre de la sesión), la plataforma puede cerrar la posición en el reinicio y cobrar la comisión. La posición «se cerró sola», sin que usted haya hecho nada mal salvo permanecer en ella." },
    { type: "heading", text: "3. Un límite de pérdida diaria o ajuste de riesgo alcanzado" },
    { type: "paragraph", html: "Si hay habilitado en la cuenta un límite de pérdida diaria o una regla de riesgo de auto-liquidación, alcanzarlo liquida automáticamente las posiciones abiertas y puede bloquear la cuenta en modo «not held» por el resto de la sesión. En cuentas de evaluación de firmas prop, la firma suele configurar estas reglas por usted, así que la liquidación es el motor de riesgo de la firma actuando, no una decisión de facturación de Tradovate." },
    { type: "heading", text: "4. Contratos que vencen o en periodo de entrega" },
    { type: "paragraph", html: "Las posiciones que quedan en un futuro con entrega física más allá de su ventana de rollover o de primer aviso se liquidan para evitar la entrega. Opere símbolos continuos u olvide hacer el rollover, y puede quedar cerrado simplemente porque el contrato está venciendo." },
    { type: "heading", text: "5. Un aumento de margen discrecional" },
    { type: "paragraph", html: "Tradovate puede elevar los requisitos de margen en cualquier momento, a menudo en torno a publicaciones económicas de alto impacto o antes de un fin de semana. Una posición que encajaba cómodamente hace una hora puede incumplir el nuevo requisito en el momento en que entra en vigor, y la cuenta se liquida sin aviso." },
    { type: "heading", text: "Cómo solucionar y prevenir la auto-liquidación de Tradovate: paso a paso" },
    { type: "heading", text: "Solucionar problemas de colchón de margen" },
