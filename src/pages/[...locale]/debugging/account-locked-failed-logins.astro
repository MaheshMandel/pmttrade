---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "account-locked-failed-logins";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/debugging/${SLUG}`;

const META_TITLE = "Tradovate Account Locked After Failed Logins";
const META_DESCRIPTION =
  "Tradovate account locked after failed logins? Wait out the temporary lock, reset your password, and clear any billing hold to get back in fast.";

// Short SEO title (<=60 chars) for locales where the shared h1 is too long for a SERP title.
const TITLE_OVERRIDE: Partial<Record<Locale, string>> = { es: "Cuenta de Tradovate bloqueada por inicios fallidos" };

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Tradovate-Konto nach fehlgeschlagenen Anmeldungen gesperrt", es: "Cuenta de Tradovate bloqueada tras inicios de sesión fallidos", fr: "Compte Tradovate verrouillé après des échecs de connexion", it: "Account Tradovate bloccato dopo accessi falliti" },
  dek: { en: "A locked Tradovate account isn't one problem, it can be a failed-login security lock, a self-imposed Trader Lockout, or a billing hold. Here's how to tell which one you're in and clear it fast.", de: "Ein gesperrtes Tradovate-Konto ist kein einzelnes Problem, es kann eine Sicherheitssperre nach fehlgeschlagenen Anmeldungen, ein selbst gesetzter Trader Lockout oder eine Zahlungssperre sein. Hier erfahren Sie, welche davon bei Ihnen vorliegt und wie Sie sie schnell aufheben.", es: "Una cuenta de Tradovate bloqueada no es un único problema: puede ser un bloqueo de seguridad por inicio de sesión fallido, un Trader Lockout autoimpuesto, o una retención por facturación. Le explicamos cómo identificar cuál de ellos tiene y resolverlo rápido.", fr: "Un compte Tradovate verrouillé n'est pas un problème unique, cela peut être un verrouillage de sécurité dû à des échecs de connexion, un Trader Lockout que vous avez activé vous-même, ou une suspension liée à la facturation. Voici comment identifier lequel vous concerne et le résoudre rapidement.", it: "Un account Tradovate bloccato non è un unico problema: può essere un blocco di sicurezza per accessi falliti, un Trader Lockout autoimposto, o una sospensione per fatturazione. Ecco come capire quale dei tre La riguarda e risolverlo rapidamente." },
  readTime: { en: "8 min read", de: "8 Minuten Lesezeit", es: "Lectura de 8 minutos", fr: "Lecture de 8 minutes", it: "Lettura di 8 minuti" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "Getting shut out of your own account is stressful, and it's worse when the futures market is moving and you can't place or exit a trade. After a handful of wrong sign-in attempts, Tradovate can throw a captcha challenge or lock the login outright. That kind of temporary security lock usually clears in about an hour once you stop retrying. But a locked Tradovate account isn't one single problem. It can be a security lock from repeated bad passwords, a Trader Lockout you (or your prop firm) switched on yourself, or a billing hold from a failed subscription payment or a chargeback. This guide walks through every version of a locked Tradovate account in 2026, what each one actually means, exactly how to get back in, and how routing your alerts through PickMyTrade keeps one stable session so repeated logins never trip the lock in the first place." },
    {
      type: "checklist",
      heading: "Quick Checklist for a Locked Tradovate Account",
      items: [
        "<strong class='text-white'>Stop retrying immediately.</strong> Every extra failed attempt deepens a security lock and can trigger a captcha that forces you to wait roughly an hour.",
        "<strong class='text-white'>Confirm you're using the right credentials.</strong> A prop-firm evaluation login is not the same as a personal Tradovate login, and mixing them up looks exactly like a &ldquo;wrong password&rdquo; lock.",
        "<strong class='text-white'>Reset your password</strong> if you're unsure of it. Use the Forgot Password link instead of guessing and burning more attempts.",
        "<strong class='text-white'>Check for a self-imposed Trader Lockout.</strong> If you or your firm enabled it, no one can end it early, you wait for the timer.",
        "<strong class='text-white'>Rule out a billing hold.</strong> A failed subscription payment, a missed deadline, or a chargeback dispute can suspend access until it's resolved.",
        "<strong class='text-white'>Contact support or your prop firm</strong> if the lock survives the wait and a password reset. Some flags can only be cleared by the account owner.",
      ],
    },
    { type: "heading", text: "What “Account Locked” Means on Tradovate" },
    { type: "paragraph", html: "&ldquo;Account locked&rdquo; is a plain-English label for several different states, and the wording you see on screen depends on which one you've hit, a login modal, a greyed-out account, or a countdown banner. The most common version is a <strong class='text-white'>security lock</strong>: Tradovate spotted too many incorrect sign-in attempts in a short window and temporarily blocked further tries to protect the account. It's the same protective mechanism that surfaces a captcha challenge, and when that captcha state appears, the guidance is blunt, you should be directed to try again in about an hour. The lock is deliberate, time-based, and usually clears itself." },
    { type: "paragraph", html: "The second version is a <strong class='text-white'>Trader Lockout</strong> (also called Manual Lockout). This one isn't a punishment. It's a risk-management feature you or your prop firm can switch on to force yourself away from the platform for a set period, up to 24 hours. When it activates, all open positions are flattened, working orders are cancelled, and support cannot end it early. If your account is &ldquo;locked&rdquo; but you remember setting a timer, this is almost certainly what you're looking at." },
    { type: "paragraph", html: "The third version is a <strong class='text-white'>billing or account hold</strong>. If a subscription payment fails, a renewal deadline slips past, or a prior payment gets disputed as a chargeback, access can be suspended until the money side is sorted out. Accounts also sometimes lock immediately after funding, where the real trigger is a security flag or manual review, not a wrong password. Figuring out which of these three you're in is the whole game, because each one has a different fix." },
    { type: "heading", text: "Top Causes of a Locked Tradovate Account in 2026" },
    { type: "heading", text: "1. Too many incorrect login attempts" },
    { type: "paragraph", html: "This is the classic &ldquo;account locked after failed logins&rdquo; case. Enter the wrong username or password enough times and Tradovate's security layer temporarily blocks the login and may present a captcha. The lock is short-lived by design, but hammering the login button while it's active just resets the clock. When support looks into these, they'll often tell you the system registered too many wrong attempts in a row, the textbook signature of a failed-login lock." },
    { type: "heading", text: "2. A captcha challenge you keep failing" },
    { type: "paragraph", html: "Rapid repeated attempts, whether that's a human retyping a password or an app re-authenticating in a loop, can escalate a plain lock into a captcha requirement. Once you reach that captcha state, the only real remedy is to wait roughly an hour before trying again. Keep refreshing and re-submitting and you stay stuck." },
    { type: "heading", text: "3. A self-imposed Trader Lockout (Manual Lockout)" },
    { type: "paragraph", html: "If you turned on the Trader Lockout feature, or your prop firm applied it, the account is intentionally locked for the duration you chose, which can run up to 24 hours. This feature is offered on simulated (evaluation) prop accounts, it flattens all positions the moment it starts, and it can't be lifted before the timer expires. Traders who forget they set it usually mistake it for a security lockout." },
    { type: "heading", text: "4. A payment, subscription, or chargeback hold" },
    { type: "paragraph", html: "Access can be suspended when the money side breaks: a monthly subscription payment fails, a renewal or pre-approval deadline is missed, or a past charge is disputed as a chargeback. The exact fees, renewal cadence, and reset costs vary by firm, plan, and account size, check your firm's current rules rather than assuming a number, but the pattern is consistent. Until the billing issue clears, the account stays restricted." },
    { type: "heading", text: "5. A security flag right after funding" },
    { type: "paragraph", html: "A less obvious cause is a lock that lands right after you fund or open an account. Here the trigger is usually a manual review or fraud-prevention flag, not a bad password. In these cases the account can show up locked with no obvious reason, and the workaround support tends to suggest is opening a fresh account on the same email with a different username, a route only support can authorize." },
    { type: "heading", text: "How to Fix a Locked Tradovate Account: Step-by-Step" },
    { type: "heading", text: "Fixing a Failed-Login or Captcha Lock" },
    {
      type: "steps",
      items: [
        { title: "Stop trying", html: "The lock is time-based, and extra attempts extend it. Close the login tab or app and step away." },
        { title: "Wait it out", html: "For a captcha-triggered lock, plan on roughly an hour before your next attempt. A plain security lock often clears faster, but patience is the fix either way." },
        { title: "Reset your password", html: "Use the Forgot Password link before you try again, so your next attempt is guaranteed to use correct credentials instead of another guess." },
        { title: "Confirm the exact login you should be using", html: "If you trade a prop-firm evaluation, sign in with the firm-issued credentials, not a personal Tradovate account. Using the wrong set is a common cause of the &ldquo;many wrong attempts&rdquo; lock." },
        { title: "Try one clean login", html: "After the wait, if it goes through, you're back in. If it still fails, move to the support step below instead of retrying in a loop." },
      ],
    },
    { type: "heading", text: "Fixing a Self-Imposed Trader Lockout" },
    {
      type: "steps",
      items: [
        { title: "Check whether you set a lockout timer", html: "If the account shows a countdown or a Trader/Manual Lockout state, this is a deliberate self-lock, not a security block." },
        { title: "Wait for the timer to expire", html: "There's no early exit, support cannot end a Trader Lockout ahead of schedule." },
        { title: "Contact your evaluation provider if you think it was applied in error", html: "For firm-issued accounts, the company that granted the lock is the only party that can review it. Confirm the exact steps and labels in your firm's current portal, since these change over time." },
      ],
    },
    { type: "heading", text: "Fixing a Payment or Billing Hold" },
    {
      type: "steps",
      items: [
        { title: "Open your account or subscription dashboard", html: "Look for a failed, suspended, or past-due status." },
        { title: "Update your payment method", html: "If a charge bounced, update it and let the platform re-attempt the payment. Exact fees and reset amounts vary by firm and plan, verify the current figure before paying." },
        { title: "Resolve any chargeback dispute directly", html: "If a previous payment was reversed through your bank, the account usually stays locked until you settle the disputed amount with Tradovate or your firm's billing team." },
        { title: "Watch renewal and pre-approval deadlines", html: "A missed deadline can lock an account on its own. Renewing or re-approving on time restores access." },
      ],
    },
    { type: "heading", text: "When to Contact Support" },
    {
      type: "steps",
      items: [
        { title: "Reach out after the wait and a password reset both fail", html: "If a clean login still won't go through, the flag likely needs a human to clear it." },
        { title: "Use the right owner", html: "For a standalone Tradovate account, contact Tradovate support. For a prop-firm evaluation, contact the firm that issued it, Tradovate routinely redirects firm-account tickets back to the firm." },
        { title: "State your situation precisely", html: "When the lock started, and whether it followed failed logins, funding, or a payment issue, so support can find the right flag quickly. If they suggest a new account on the same email, only they can authorize that path." },
      ],
    },
    { type: "heading", text: "Troubleshooting Table" },
    {
      type: "table",
      headers: ["Symptom / State", "What it means", "Fix"],
      rows: [
        ["Account locked after repeated sign-in attempts", "Security lock from too many wrong username/password tries", "Stop retrying, wait it out, reset your password, then attempt one clean login"],
        ["Captcha challenge that won't clear", "Rapid attempts escalated the lock to a captcha requirement", "Stop retrying and wait about an hour before trying again"],
        ["Trader Lockout / Manual Lockout countdown active", "A self-imposed risk lock you or your firm enabled", "Wait for the timer to expire; support cannot end it early"],
        ["Account greyed out, suspended, or &ldquo;past due&rdquo;", "A subscription payment failed or a deadline was missed", "Update your payment method or clear the billing issue with support"],
        ["Locked immediately after funding", "A security flag or manual review, not a bad password", "Contact support; they may authorize a new username on the same email"],
        ["Cannot create a replacement account", "The original account is still flagged", "Ask support to clear the flag before re-registering"],
      ],
    },
    { type: "heading", text: "Prevent This with PickMyTrade" },
    { type: "paragraph", html: "Most failed-login lockouts come from the login endpoint getting hit over and over, a person retyping a password, or an app re-authenticating in a loop and tripping the captcha. PickMyTrade routes your TradingView alerts to Tradovate through one managed connection, so you're not repeatedly logging in and provoking the lock:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Single Persistent Session</strong>, connects once and holds an authenticated session, so your strategy fires without hammering the login and triggering a captcha lockout.",
        "<strong class='text-white'>Automatic Token Renewal</strong>, refreshes access before it expires instead of re-authenticating in a loop, avoiding the rapid-retry pattern that locks accounts.",
        "<strong class='text-white'>Rate-Limit-Safe Routing</strong>, order and auth traffic is spaced out to stay within Tradovate's thresholds, so nothing bounces into a penalty or captcha.",
        "<strong class='text-white'>Multi-Account Sync</strong>, mirrors orders across several accounts from that one connection, instead of juggling multiple manual logins that each risk a lock.",
      ],
    },
    { type: "paragraph", html: "Automation can't override a self-imposed Trader Lockout or a billing hold, but keeping a single stable session means your day-to-day trading almost never runs into a failed-login lock at all." },
  ], de: [
    { type: "paragraph", html: "Aus dem eigenen Konto ausgesperrt zu werden ist belastend, und es ist noch schlimmer, wenn sich der Futures-Markt bewegt und Sie eine Position weder eröffnen noch schließen können. Nach ein paar falschen Anmeldeversuchen kann Tradovate eine Captcha-Abfrage stellen oder die Anmeldung direkt sperren. Diese Art temporärer Sicherheitssperre hebt sich meist nach etwa einer Stunde von selbst auf, sobald Sie mit dem erneuten Versuchen aufhören. Aber ein gesperrtes Tradovate-Konto ist kein einzelnes Problem. Es kann eine Sicherheitssperre wegen wiederholt falscher Passwörter sein, ein von Ihnen (oder Ihrer Prop-Firm) selbst aktivierter Trader Lockout, oder eine Zahlungssperre wegen einer fehlgeschlagenen Abo-Zahlung oder einer Rückbuchung. Diese Anleitung geht jede Variante eines gesperrten Tradovate-Kontos im Jahr 2026 durch, was jede davon tatsächlich bedeutet, wie Sie genau wieder hineinkommen, und wie das Routen Ihrer Alerts über PickMyTrade eine stabile Sitzung aufrechterhält, sodass wiederholte Anmeldungen die Sperre gar nicht erst auslösen." },
    {
      type: "checklist",
      heading: "Kurz-Checkliste für ein gesperrtes Tradovate-Konto",
      items: [
        "<strong class='text-white'>Hören Sie sofort auf, es erneut zu versuchen.</strong> Jeder weitere fehlgeschlagene Versuch vertieft eine Sicherheitssperre und kann ein Captcha auslösen, das Sie zu einer Wartezeit von etwa einer Stunde zwingt.",
        "<strong class='text-white'>Bestätigen Sie, dass Sie die richtigen Zugangsdaten verwenden.</strong> Eine Prop-Firm-Evaluierungsanmeldung ist nicht dasselbe wie eine persönliche Tradovate-Anmeldung, und beide zu verwechseln sieht exakt aus wie eine Sperre wegen &ldquo;falschem Passwort&rdquo;.",
        "<strong class='text-white'>Setzen Sie Ihr Passwort zurück</strong>, wenn Sie sich unsicher sind. Nutzen Sie den Link Forgot Password, statt zu raten und weitere Versuche zu verbrauchen.",
        "<strong class='text-white'>Prüfen Sie auf einen selbst gesetzten Trader Lockout.</strong> Haben Sie oder Ihre Firma ihn aktiviert, kann ihn niemand vorzeitig beenden, Sie warten den Timer ab.",
        "<strong class='text-white'>Schließen Sie eine Zahlungssperre aus.</strong> Eine fehlgeschlagene Abo-Zahlung, eine verpasste Frist oder eine Rückbuchungsstreitigkeit kann den Zugriff aussetzen, bis sie gelöst ist.",
        "<strong class='text-white'>Kontaktieren Sie den Support oder Ihre Prop-Firm</strong>, falls die Sperre die Wartezeit und ein Passwort-Reset übersteht. Manche Markierungen kann nur der Kontoinhaber aufheben lassen.",
      ],
    },
    { type: "heading", text: "Was &ldquo;Account Locked&rdquo; bei Tradovate bedeutet" },
    { type: "paragraph", html: "&ldquo;Account locked&rdquo; ist eine allgemeine Bezeichnung für mehrere unterschiedliche Zustände, und der Wortlaut, den Sie auf dem Bildschirm sehen, hängt davon ab, welchen Sie getroffen haben, ein Anmelde-Modal, ein ausgegrautes Konto, oder ein Countdown-Banner. Die häufigste Variante ist eine <strong class='text-white'>Sicherheitssperre</strong>: Tradovate hat in einem kurzen Zeitfenster zu viele fehlerhafte Anmeldeversuche erkannt und weitere Versuche vorübergehend blockiert, um das Konto zu schützen. Es ist derselbe Schutzmechanismus, der eine Captcha-Abfrage auslöst, und erscheint dieser Captcha-Zustand, ist die Anweisung eindeutig, Sie sollten aufgefordert werden, es in etwa einer Stunde erneut zu versuchen. Die Sperre ist bewusst gesetzt, zeitbasiert, und hebt sich meist von selbst auf." },
    { type: "paragraph", html: "Die zweite Variante ist ein <strong class='text-white'>Trader Lockout</strong> (auch Manual Lockout genannt). Das ist keine Strafe. Es ist eine Risikomanagement-Funktion, die Sie oder Ihre Prop-Firm aktivieren können, um sich selbst für einen festgelegten Zeitraum, bis zu 24 Stunden, von der Plattform fernzuhalten. Sobald sie aktiv wird, werden alle offenen Positionen glattgestellt, ausstehende Orders storniert, und der Support kann sie nicht vorzeitig beenden. Ist Ihr Konto &ldquo;gesperrt&rdquo;, Sie erinnern sich aber, einen Timer gesetzt zu haben, ist dies fast sicher der Fall, vor dem Sie stehen." },
    { type: "paragraph", html: "Die dritte Variante ist eine <strong class='text-white'>Zahlungs- oder Kontosperre</strong>. Schlägt eine Abo-Zahlung fehl, verstreicht eine Verlängerungsfrist, oder wird eine frühere Zahlung als Rückbuchung angefochten, kann der Zugriff ausgesetzt werden, bis die finanzielle Seite geklärt ist. Konten sperren sich manchmal auch unmittelbar nach der Einzahlung, wobei der eigentliche Auslöser eine Sicherheitsmarkierung oder manuelle Prüfung ist, kein falsches Passwort. Herauszufinden, welche dieser drei Varianten bei Ihnen vorliegt, ist der entscheidende Schritt, denn jede hat eine andere Lösung." },
    { type: "heading", text: "Die häufigsten Ursachen für ein gesperrtes Tradovate-Konto im Jahr 2026" },
    { type: "heading", text: "1. Zu viele fehlerhafte Anmeldeversuche" },
    { type: "paragraph", html: "Das ist der klassische Fall &ldquo;Konto nach fehlgeschlagenen Anmeldungen gesperrt&rdquo;. Geben Sie oft genug den falschen Benutzernamen oder das falsche Passwort ein, blockiert die Sicherheitsschicht von Tradovate die Anmeldung vorübergehend und zeigt eventuell ein Captcha. Die Sperre ist bewusst kurzlebig, aber wiederholtes Klicken auf die Anmeldeschaltfläche, während sie aktiv ist, setzt lediglich die Uhr zurück. Sieht sich der Support solche Fälle an, teilt er oft mit, dass das System zu viele falsche Versuche in Folge registriert hat, das Lehrbuchbeispiel einer Sperre nach fehlgeschlagener Anmeldung." },
    { type: "heading", text: "2. Eine Captcha-Abfrage, die Sie immer wieder nicht besteht" },
    { type: "paragraph", html: "Schnelle, wiederholte Versuche, ob durch einen Menschen, der ein Passwort erneut eintippt, oder eine App, die sich in einer Schleife neu authentifiziert, können eine einfache Sperre zu einer Captcha-Anforderung eskalieren lassen. Sobald Sie diesen Captcha-Zustand erreichen, besteht die einzige echte Lösung darin, etwa eine Stunde zu warten, bevor Sie es erneut versuchen. Wenn Sie weiter aktualisieren und erneut absenden, bleiben Sie festhängen." },
    { type: "heading", text: "3. Ein selbst gesetzter Trader Lockout (Manual Lockout)" },
    { type: "paragraph", html: "Haben Sie die Trader-Lockout-Funktion aktiviert, oder hat Ihre Prop-Firm sie angewendet, ist das Konto absichtlich für den von Ihnen gewählten Zeitraum gesperrt, der bis zu 24 Stunden dauern kann. Diese Funktion wird auf simulierten (Evaluierungs-)Prop-Konten angeboten, sie stellt alle Positionen in dem Moment glatt, in dem sie beginnt, und kann nicht vor Ablauf des Timers aufgehoben werden. Trader, die vergessen, dass sie sie gesetzt haben, halten sie meist fälschlich für eine Sicherheitssperre." },
    { type: "heading", text: "4. Eine Zahlungs-, Abo- oder Rückbuchungssperre" },
    { type: "paragraph", html: "Der Zugriff kann ausgesetzt werden, wenn die finanzielle Seite scheitert: eine monatliche Abo-Zahlung schlägt fehl, eine Verlängerungs- oder Vorabgenehmigungsfrist wird verpasst, oder eine frühere Belastung wird als Rückbuchung angefochten. Die genauen Gebühren, der Verlängerungsrhythmus und die Reset-Kosten variieren je nach Firma, Plan und Kontogröße, prüfen Sie die aktuellen Regeln Ihrer Firma statt eine Zahl anzunehmen, aber das Muster ist durchgängig. Bis das Zahlungsproblem behoben ist, bleibt das Konto eingeschränkt." },
    { type: "heading", text: "5. Eine Sicherheitsmarkierung direkt nach der Einzahlung" },
    { type: "paragraph", html: "Eine weniger offensichtliche Ursache ist eine Sperre, die direkt nach der Einzahlung oder Eröffnung eines Kontos eintritt. Hier ist der Auslöser meist eine manuelle Prüfung oder eine Betrugspräventionsmarkierung, kein falsches Passwort. In diesen Fällen kann das Konto ohne offensichtlichen Grund gesperrt erscheinen, und der Workaround, den der Support meist vorschlägt, ist die Eröffnung eines neuen Kontos mit derselben E-Mail-Adresse und einem anderen Benutzernamen, ein Weg, den nur der Support autorisieren kann." },
    { type: "heading", text: "So beheben Sie ein gesperrtes Tradovate-Konto: Schritt für Schritt" },
    { type: "heading", text: "Eine Sperre nach fehlgeschlagener Anmeldung oder ein Captcha beheben" },
    {
      type: "steps",
      items: [
        { title: "Hören Sie auf, es zu versuchen", html: "Die Sperre ist zeitbasiert, und zusätzliche Versuche verlängern sie. Schließen Sie den Anmelde-Tab oder die App und legen Sie eine Pause ein." },
        { title: "Warten Sie es ab", html: "Bei einer durch Captcha ausgelösten Sperre planen Sie mit etwa einer Stunde bis zum nächsten Versuch. Eine reine Sicherheitssperre hebt sich oft schneller auf, aber Geduld ist in jedem Fall die Lösung." },
        { title: "Setzen Sie Ihr Passwort zurück", html: "Nutzen Sie den Link Forgot Password, bevor Sie es erneut versuchen, damit Ihr nächster Versuch garantiert korrekte Zugangsdaten nutzt statt eines weiteren Ratens." },
        { title: "Bestätigen Sie die exakte Anmeldung, die Sie nutzen sollten", html: "Handeln Sie eine Prop-Firm-Evaluierung, melden Sie sich mit den von der Firma ausgegebenen Zugangsdaten an, nicht mit einem persönlichen Tradovate-Konto. Die falschen Daten zu nutzen ist eine häufige Ursache der Sperre wegen &ldquo;vieler falscher Versuche&rdquo;." },
        { title: "Versuchen Sie eine einzige saubere Anmeldung", html: "Klappt es nach der Wartezeit, sind Sie wieder drin. Scheitert es weiterhin, gehen Sie zum Support-Schritt unten über, statt es in einer Schleife erneut zu versuchen." },
      ],
    },
    { type: "heading", text: "Einen selbst gesetzten Trader Lockout beheben" },
    {
      type: "steps",
      items: [
        { title: "Prüfen Sie, ob Sie einen Sperr-Timer gesetzt haben", html: "Zeigt das Konto einen Countdown oder einen Trader/Manual-Lockout-Zustand, handelt es sich um eine bewusste Selbstsperre, keine Sicherheitssperre." },
        { title: "Warten Sie, bis der Timer abläuft", html: "Es gibt keinen vorzeitigen Ausstieg, der Support kann einen Trader Lockout nicht vor Ablauf beenden." },
        { title: "Kontaktieren Sie Ihren Evaluierungsanbieter, falls Sie glauben, sie wurde irrtümlich angewendet", html: "Bei von Firmen ausgegebenen Konten ist das Unternehmen, das die Sperre gewährt hat, die einzige Partei, die sie prüfen kann. Bestätigen Sie die genauen Schritte und Bezeichnungen im aktuellen Portal Ihrer Firma, da sich diese mit der Zeit ändern." },
      ],
    },
    { type: "heading", text: "Eine Zahlungs- oder Abrechnungssperre beheben" },
    {
      type: "steps",
      items: [
        { title: "Öffnen Sie Ihr Konto- oder Abo-Dashboard", html: "Suchen Sie nach einem Status fehlgeschlagen, ausgesetzt oder überfällig." },
        { title: "Aktualisieren Sie Ihre Zahlungsmethode", html: "Ist eine Belastung fehlgeschlagen, aktualisieren Sie sie und lassen Sie die Plattform die Zahlung erneut versuchen. Genaue Gebühren und Reset-Beträge variieren je nach Firma und Plan, prüfen Sie die aktuelle Zahl vor der Zahlung." },
        { title: "Klären Sie eine Rückbuchungsstreitigkeit direkt", html: "Wurde eine frühere Zahlung über Ihre Bank rückgängig gemacht, bleibt das Konto meist gesperrt, bis Sie den strittigen Betrag mit Tradovate oder dem Abrechnungsteam Ihrer Firma begleichen." },
        { title: "Beachten Sie Verlängerungs- und Vorabgenehmigungsfristen", html: "Eine verpasste Frist kann ein Konto von sich aus sperren. Rechtzeitiges Verlängern oder erneutes Genehmigen stellt den Zugriff wieder her." },
      ],
    },
    { type: "heading", text: "Wann Sie den Support kontaktieren sollten" },
    {
      type: "steps",
      items: [
        { title: "Melden Sie sich, wenn sowohl die Wartezeit als auch ein Passwort-Reset scheitern", html: "Klappt eine saubere Anmeldung weiterhin nicht, muss die Markierung wahrscheinlich von einem Menschen aufgehoben werden." },
        { title: "Wenden Sie sich an die richtige Stelle", html: "Für ein eigenständiges Tradovate-Konto kontaktieren Sie den Tradovate-Support. Für eine Prop-Firm-Evaluierung kontaktieren Sie die ausgebende Firma, Tradovate leitet Tickets zu Firmenkonten routinemäßig an die Firma zurück." },
        { title: "Schildern Sie Ihre Situation genau", html: "Wann die Sperre begann, und ob sie auf fehlgeschlagene Anmeldungen, eine Einzahlung oder ein Zahlungsproblem folgte, damit der Support die richtige Markierung schnell findet. Schlägt er ein neues Konto mit derselben E-Mail vor, kann nur er diesen Weg autorisieren." },
      ],
    },
    { type: "heading", text: "Fehlerbehebungstabelle" },
    {
      type: "table",
      headers: ["Symptom / Zustand", "Was es bedeutet", "Lösung"],
      rows: [
        ["Konto nach wiederholten Anmeldeversuchen gesperrt", "Sicherheitssperre wegen zu vieler falscher Benutzername-/Passwort-Versuche", "Nicht erneut versuchen, abwarten, Passwort zurücksetzen, dann einmal sauber anmelden"],
        ["Captcha-Abfrage, die sich nicht auflöst", "Schnelle Versuche haben die Sperre zu einer Captcha-Anforderung eskaliert", "Nicht erneut versuchen und etwa eine Stunde warten, bevor Sie es erneut probieren"],
        ["Trader-Lockout-/Manual-Lockout-Countdown aktiv", "Eine selbst gesetzte Risikosperre, die Sie oder Ihre Firma aktiviert haben", "Warten, bis der Timer abläuft; der Support kann sie nicht vorzeitig beenden"],
        ["Konto ausgegraut, ausgesetzt, oder &ldquo;past due&rdquo;", "Eine Abo-Zahlung ist fehlgeschlagen oder eine Frist wurde verpasst", "Zahlungsmethode aktualisieren oder das Zahlungsproblem mit dem Support klären"],
        ["Sofort nach der Einzahlung gesperrt", "Eine Sicherheitsmarkierung oder manuelle Prüfung, kein falsches Passwort", "Support kontaktieren; er kann eventuell einen neuen Benutzernamen unter derselben E-Mail autorisieren"],
        ["Kann kein Ersatzkonto anlegen", "Das ursprüngliche Konto ist weiterhin markiert", "Support bitten, die Markierung vor der Neuregistrierung aufzuheben"],
      ],
    },
    { type: "heading", text: "Vermeiden Sie das mit PickMyTrade" },
    { type: "paragraph", html: "Die meisten Sperren nach fehlgeschlagener Anmeldung entstehen dadurch, dass der Anmelde-Endpunkt immer wieder getroffen wird, eine Person tippt ein Passwort erneut ein, oder eine App authentifiziert sich in einer Schleife neu und löst das Captcha aus. PickMyTrade leitet Ihre TradingView-Alerts über eine einzige verwaltete Verbindung an Tradovate weiter, sodass Sie sich nicht wiederholt anmelden und die Sperre provozieren:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Eine einzige dauerhafte Sitzung</strong>, verbindet sich einmal und hält eine authentifizierte Sitzung aufrecht, sodass Ihre Strategie feuert, ohne die Anmeldung zu bombardieren und einen Captcha-Lockout auszulösen.",
        "<strong class='text-white'>Automatische Token-Erneuerung</strong>, erneuert den Zugriff, bevor er abläuft, statt sich in einer Schleife neu zu authentifizieren, und vermeidet so das Muster schneller Wiederholungsversuche, das Konten sperrt.",
        "<strong class='text-white'>Ratenlimit-sichere Weiterleitung</strong>, Order- und Auth-Verkehr wird gestaffelt, um innerhalb der Schwellenwerte von Tradovate zu bleiben, sodass nichts in eine Strafe oder ein Captcha abprallt.",
        "<strong class='text-white'>Synchronisation mehrerer Konten</strong>, spiegelt Orders über mehrere Konten aus dieser einen Verbindung, statt mehrere manuelle Anmeldungen zu jonglieren, von denen jede eine Sperre riskiert.",
      ],
    },
    { type: "paragraph", html: "Automatisierung kann einen selbst gesetzten Trader Lockout oder eine Zahlungssperre nicht außer Kraft setzen, aber eine einzige stabile Sitzung aufrechtzuerhalten bedeutet, dass Ihr alltägliches Trading fast nie in eine Sperre nach fehlgeschlagener Anmeldung läuft." },
  ], es: [
    { type: "paragraph", html: "Quedarse fuera de su propia cuenta es estresante, y es peor cuando el mercado de futuros se está moviendo y no puede colocar ni cerrar una operación. Tras un puñado de intentos de inicio de sesión fallidos, Tradovate puede lanzar un desafío captcha o bloquear directamente el inicio de sesión. Ese tipo de bloqueo de seguridad temporal suele resolverse en aproximadamente una hora una vez que deja de reintentar. Pero una cuenta de Tradovate bloqueada no es un único problema. Puede ser un bloqueo de seguridad por contraseñas incorrectas repetidas, un Trader Lockout que usted (o su prop firm) activó, o una retención por facturación debida a un pago de suscripción fallido o a un contracargo. Esta guía recorre cada variante de una cuenta de Tradovate bloqueada en 2026, qué significa realmente cada una, exactamente cómo recuperar el acceso, y cómo enrutar sus alertas a través de PickMyTrade mantiene una sesión estable para que los inicios de sesión repetidos nunca activen el bloqueo en primer lugar." },
    {
      type: "checklist",
      heading: "Lista rápida para una cuenta de Tradovate bloqueada",
      items: [
        "<strong class='text-white'>Deje de reintentar de inmediato.</strong> Cada intento fallido adicional profundiza un bloqueo de seguridad y puede activar un captcha que le obliga a esperar aproximadamente una hora.",
        "<strong class='text-white'>Confirme que está usando las credenciales correctas.</strong> Un inicio de sesión de evaluación de prop firm no es lo mismo que un inicio de sesión personal de Tradovate, y confundirlos se ve exactamente igual que un bloqueo por &ldquo;contraseña incorrecta&rdquo;.",
        "<strong class='text-white'>Restablezca su contraseña</strong> si no está seguro de ella. Use el enlace Forgot Password en lugar de adivinar y consumir más intentos.",
        "<strong class='text-white'>Descarte un Trader Lockout autoimpuesto.</strong> Si usted o su firma lo activaron, nadie puede terminarlo antes de tiempo, hay que esperar el temporizador.",
        "<strong class='text-white'>Descarte una retención por facturación.</strong> Un pago de suscripción fallido, una fecha límite incumplida, o una disputa de contracargo pueden suspender el acceso hasta que se resuelva.",
        "<strong class='text-white'>Contacte al soporte o a su prop firm</strong> si el bloqueo persiste tras la espera y un restablecimiento de contraseña. Algunas marcas solo puede resolverlas el titular de la cuenta.",
      ],
    },
    { type: "heading", text: "Qué significa &ldquo;Account Locked&rdquo; en Tradovate" },
    { type: "paragraph", html: "&ldquo;Account locked&rdquo; es una etiqueta genérica para varios estados distintos, y la redacción que ve en pantalla depende de cuál haya encontrado, un modal de inicio de sesión, una cuenta atenuada, o un banner con cuenta regresiva. La versión más común es un <strong class='text-white'>bloqueo de seguridad</strong>: Tradovate detectó demasiados intentos de inicio de sesión incorrectos en una ventana corta y bloqueó temporalmente más intentos para proteger la cuenta. Es el mismo mecanismo de protección que hace aparecer un desafío captcha, y cuando ese estado captcha aparece, la indicación es directa, debería recibir instrucciones de volver a intentarlo en aproximadamente una hora. El bloqueo es deliberado, basado en tiempo, y por lo general se resuelve solo." },
    { type: "paragraph", html: "La segunda versión es un <strong class='text-white'>Trader Lockout</strong> (también llamado Manual Lockout). Este no es un castigo. Es una función de gestión de riesgo que usted o su prop firm pueden activar para mantenerse alejado de la plataforma durante un periodo fijo, de hasta 24 horas. Cuando se activa, todas las posiciones abiertas se cierran, las órdenes pendientes se cancelan, y el soporte no puede terminarlo antes de tiempo. Si su cuenta está &ldquo;bloqueada&rdquo; pero recuerda haber configurado un temporizador, esto es casi con certeza lo que está viendo." },
    { type: "paragraph", html: "La tercera versión es una <strong class='text-white'>retención de facturación o de cuenta</strong>. Si un pago de suscripción falla, una fecha límite de renovación se pasa, o un pago anterior se disputa como contracargo, el acceso puede suspenderse hasta que se resuelva el aspecto económico. Las cuentas también a veces se bloquean inmediatamente después de la financiación, donde el desencadenante real es una marca de seguridad o una revisión manual, no una contraseña incorrecta. Averiguar cuál de estos tres casos tiene es todo el juego, porque cada uno tiene una solución distinta." },
    { type: "heading", text: "Principales causas de una cuenta de Tradovate bloqueada en 2026" },
    { type: "heading", text: "1. Demasiados intentos de inicio de sesión incorrectos" },
    { type: "paragraph", html: "Este es el caso clásico de &ldquo;cuenta bloqueada tras inicios de sesión fallidos&rdquo;. Introduzca el usuario o la contraseña incorrectos las veces suficientes y la capa de seguridad de Tradovate bloqueará temporalmente el inicio de sesión y puede mostrar un captcha. El bloqueo está diseñado para ser breve, pero insistir en el botón de inicio de sesión mientras está activo simplemente reinicia el reloj. Cuando el soporte investiga estos casos, suele indicar que el sistema registró demasiados intentos incorrectos seguidos, la firma característica de un bloqueo por inicio de sesión fallido." },
    { type: "heading", text: "2. Un desafío captcha que sigue fallando" },
    { type: "paragraph", html: "Los intentos rápidos y repetidos, ya sea una persona reescribiendo una contraseña o una app reautenticándose en bucle, pueden escalar un bloqueo simple a un requisito de captcha. Una vez que llega a ese estado captcha, el único remedio real es esperar aproximadamente una hora antes de volver a intentarlo. Seguir actualizando y reenviando le mantendrá atascado." },
    { type: "heading", text: "3. Un Trader Lockout autoimpuesto (Manual Lockout)" },
    { type: "paragraph", html: "Si activó la función Trader Lockout, o su prop firm la aplicó, la cuenta está intencionalmente bloqueada durante la duración que eligió, que puede llegar hasta 24 horas. Esta función está disponible en cuentas de prop firm simuladas (de evaluación), cierra todas las posiciones en el momento en que comienza, y no puede levantarse antes de que expire el temporizador. Los traders que olvidan haberla configurado suelen confundirla con un bloqueo de seguridad." },
    { type: "heading", text: "4. Una retención de pago, suscripción o contracargo" },
    { type: "paragraph", html: "El acceso puede suspenderse cuando el aspecto económico falla: un pago de suscripción mensual falla, se pasa una fecha límite de renovación o preaprobación, o un cargo anterior se disputa como contracargo. Las tarifas exactas, la periodicidad de renovación y los costes de reinicio varían según la firma, el plan y el tamaño de la cuenta, consulte las reglas actuales de su firma en lugar de asumir una cifra, pero el patrón es consistente. Hasta que se resuelva el problema de facturación, la cuenta permanece restringida." },
    { type: "heading", text: "5. Una marca de seguridad justo después de la financiación" },
    { type: "paragraph", html: "Una causa menos obvia es un bloqueo que aparece justo después de financiar o abrir una cuenta. Aquí el desencadenante suele ser una revisión manual o una marca de prevención de fraude, no una contraseña incorrecta. En estos casos la cuenta puede aparecer bloqueada sin razón evidente, y la solución alternativa que suele sugerir el soporte es abrir una cuenta nueva con el mismo correo y un nombre de usuario distinto, una vía que solo el soporte puede autorizar." },
    { type: "heading", text: "Cómo solucionar una cuenta de Tradovate bloqueada: paso a paso" },
    { type: "heading", text: "Solucionar un bloqueo por inicio de sesión fallido o captcha" },
    {
      type: "steps",
      items: [
        { title: "Deje de intentarlo", html: "El bloqueo está basado en tiempo, y los intentos adicionales lo extienden. Cierre la pestaña o la app de inicio de sesión y aléjese." },
        { title: "Espere a que pase", html: "Para un bloqueo activado por captcha, cuente con aproximadamente una hora antes de su próximo intento. Un bloqueo de seguridad simple suele resolverse más rápido, pero la paciencia es la solución en ambos casos." },
        { title: "Restablezca su contraseña", html: "Use el enlace Forgot Password antes de volver a intentarlo, así su próximo intento tiene garantizado usar credenciales correctas en lugar de otra suposición." },
        { title: "Confirme el inicio de sesión exacto que debería usar", html: "Si opera una evaluación de prop firm, inicie sesión con las credenciales emitidas por la firma, no con una cuenta personal de Tradovate. Usar el conjunto equivocado es una causa común del bloqueo por &ldquo;muchos intentos incorrectos&rdquo;." },
        { title: "Intente un único inicio de sesión limpio", html: "Tras la espera, si funciona, ha recuperado el acceso. Si sigue fallando, pase al paso de soporte más abajo en lugar de reintentar en bucle." },
      ],
    },
    { type: "heading", text: "Solucionar un Trader Lockout autoimpuesto" },
    {
      type: "steps",
      items: [
        { title: "Compruebe si configuró un temporizador de bloqueo", html: "Si la cuenta muestra una cuenta regresiva o un estado Trader/Manual Lockout, se trata de un autobloqueo deliberado, no de un bloqueo de seguridad." },
        { title: "Espere a que expire el temporizador", html: "No hay salida anticipada, el soporte no puede terminar un Trader Lockout antes de tiempo." },
        { title: "Contacte a su proveedor de evaluación si cree que se aplicó por error", html: "En cuentas emitidas por una firma, la empresa que otorgó el bloqueo es la única parte que puede revisarlo. Confirme los pasos y las etiquetas exactas en el portal actual de su firma, ya que cambian con el tiempo." },
      ],
    },
    { type: "heading", text: "Solucionar una retención de pago o facturación" },
    {
      type: "steps",
      items: [
        { title: "Abra su panel de cuenta o suscripción", html: "Busque un estado fallido, suspendido, o vencido." },
        { title: "Actualice su método de pago", html: "Si un cargo rebotó, actualícelo y deje que la plataforma reintente el pago. Las tarifas exactas y los importes de reinicio varían según la firma y el plan, verifique la cifra actual antes de pagar." },
        { title: "Resuelva directamente cualquier disputa de contracargo", html: "Si un pago anterior fue revertido a través de su banco, la cuenta suele permanecer bloqueada hasta que salde el importe disputado con Tradovate o el equipo de facturación de su firma." },
        { title: "Vigile las fechas límite de renovación y preaprobación", html: "Una fecha límite incumplida puede bloquear una cuenta por sí sola. Renovar o volver a aprobar a tiempo restaura el acceso." },
      ],
    },
    { type: "heading", text: "Cuándo contactar al soporte" },
    {
      type: "steps",
      items: [
        { title: "Contacte cuando tanto la espera como un restablecimiento de contraseña fallen", html: "Si un inicio de sesión limpio sigue sin funcionar, la marca probablemente necesite que una persona la resuelva." },
        { title: "Use el titular correcto", html: "Para una cuenta de Tradovate independiente, contacte al soporte de Tradovate. Para una evaluación de prop firm, contacte a la firma que la emitió, Tradovate suele redirigir los tickets de cuentas de firma de vuelta a la firma." },
        { title: "Exponga su situación con precisión", html: "Cuándo comenzó el bloqueo, y si siguió a inicios de sesión fallidos, a una financiación, o a un problema de pago, para que el soporte pueda encontrar la marca correcta rápidamente. Si sugieren una cuenta nueva con el mismo correo, solo ellos pueden autorizar esa vía." },
      ],
    },
    { type: "heading", text: "Tabla de solución de problemas" },
    {
      type: "table",
      headers: ["Síntoma / Estado", "Qué significa", "Solución"],
      rows: [
        ["Cuenta bloqueada tras repetidos intentos de inicio de sesión", "Bloqueo de seguridad por demasiados intentos incorrectos de usuario/contraseña", "Deje de reintentar, espere, restablezca su contraseña, luego intente un único inicio de sesión limpio"],
        ["Desafío captcha que no se resuelve", "Los intentos rápidos escalaron el bloqueo a un requisito de captcha", "Deje de reintentar y espere aproximadamente una hora antes de volver a intentarlo"],
        ["Cuenta regresiva de Trader Lockout / Manual Lockout activa", "Un bloqueo de riesgo autoimpuesto que usted o su firma activaron", "Espere a que expire el temporizador; el soporte no puede terminarlo antes de tiempo"],
        ["Cuenta atenuada, suspendida, o &ldquo;vencida&rdquo;", "Un pago de suscripción falló o se incumplió una fecha límite", "Actualice su método de pago o resuelva el problema de facturación con el soporte"],
        ["Bloqueada inmediatamente tras la financiación", "Una marca de seguridad o revisión manual, no una contraseña incorrecta", "Contacte al soporte; pueden autorizar un nuevo nombre de usuario con el mismo correo"],
        ["No puede crear una cuenta de reemplazo", "La cuenta original sigue marcada", "Pida al soporte que resuelva la marca antes de volver a registrarse"],
      ],
    },
    { type: "heading", text: "Evítelo con PickMyTrade" },
    { type: "paragraph", html: "La mayoría de los bloqueos por inicio de sesión fallido provienen de que el endpoint de inicio de sesión se golpea una y otra vez, una persona reescribiendo una contraseña, o una app reautenticándose en bucle y activando el captcha. PickMyTrade enruta sus alertas de TradingView hacia Tradovate a través de una única conexión gestionada, para que no esté iniciando sesión repetidamente y provocando el bloqueo:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Una única sesión persistente</strong>, se conecta una vez y mantiene una sesión autenticada, para que su estrategia se dispare sin bombardear el inicio de sesión ni activar un bloqueo por captcha.",
        "<strong class='text-white'>Renovación automática de token</strong>, refresca el acceso antes de que expire en lugar de reautenticarse en bucle, evitando el patrón de reintentos rápidos que bloquea cuentas.",
        "<strong class='text-white'>Enrutamiento seguro frente a límites de tasa</strong>, el tráfico de órdenes y autenticación se espacia para mantenerse dentro de los umbrales de Tradovate, así nada rebota en una penalización o un captcha.",
        "<strong class='text-white'>Sincronización multicuenta</strong>, replica órdenes en varias cuentas desde esa única conexión, en lugar de hacer malabares con múltiples inicios de sesión manuales que cada uno arriesga un bloqueo.",
      ],
    },
    { type: "paragraph", html: "La automatización no puede anular un Trader Lockout autoimpuesto ni una retención de facturación, pero mantener una única sesión estable significa que su trading del día a día casi nunca se topa con un bloqueo por inicio de sesión fallido." },
  ], fr: [
    { type: "paragraph", html: "Se retrouver bloqué hors de son propre compte est stressant, et c'est pire lorsque le marché des futures bouge et que vous ne pouvez ni ouvrir ni clôturer une position. Après quelques tentatives de connexion erronées, Tradovate peut lancer un défi captcha ou verrouiller directement la connexion. Ce type de verrouillage de sécurité temporaire se résout généralement en environ une heure une fois que vous arrêtez de réessayer. Mais un compte Tradovate verrouillé n'est pas un problème unique. Il peut s'agir d'un verrouillage de sécurité dû à des mots de passe erronés répétés, d'un Trader Lockout que vous (ou votre prop firm) avez activé vous-même, ou d'une suspension liée à la facturation causée par un paiement d'abonnement échoué ou un rétrofacturation. Ce guide passe en revue chaque variante d'un compte Tradovate verrouillé en 2026, ce que chacune signifie réellement, comment récupérer l'accès exactement, et comment acheminer vos alertes via PickMyTrade maintient une session stable pour que les connexions répétées ne déclenchent jamais le verrouillage en premier lieu." },
    {
      type: "checklist",
      heading: "Check-list rapide pour un compte Tradovate verrouillé",
      items: [
        "<strong class='text-white'>Arrêtez immédiatement de réessayer.</strong> Chaque tentative échouée supplémentaire aggrave un verrouillage de sécurité et peut déclencher un captcha vous obligeant à attendre environ une heure.",
        "<strong class='text-white'>Confirmez que vous utilisez les bons identifiants.</strong> Une connexion d'évaluation de prop firm n'est pas la même chose qu'une connexion Tradovate personnelle, et les confondre ressemble exactement à un verrouillage pour &ldquo;mot de passe erroné&rdquo;.",
        "<strong class='text-white'>Réinitialisez votre mot de passe</strong> si vous n'en êtes pas sûr. Utilisez le lien Forgot Password au lieu de deviner et de consommer davantage de tentatives.",
        "<strong class='text-white'>Vérifiez l'existence d'un Trader Lockout auto-imposé.</strong> Si vous ou votre société l'avez activé, personne ne peut y mettre fin plus tôt, il faut attendre le minuteur.",
        "<strong class='text-white'>Écartez une suspension liée à la facturation.</strong> Un paiement d'abonnement échoué, une échéance manquée, ou un litige de rétrofacturation peuvent suspendre l'accès jusqu'à sa résolution.",
        "<strong class='text-white'>Contactez le support ou votre prop firm</strong> si le verrouillage persiste malgré l'attente et une réinitialisation de mot de passe. Certains signalements ne peuvent être levés que par le titulaire du compte.",
      ],
    },
    { type: "heading", text: "Ce que signifie &ldquo;Account Locked&rdquo; sur Tradovate" },
    { type: "paragraph", html: "&ldquo;Account locked&rdquo; est une étiquette générique pour plusieurs états distincts, et le libellé affiché à l'écran dépend duquel vous avez rencontré, une fenêtre de connexion, un compte grisé, ou une bannière avec compte à rebours. La version la plus courante est un <strong class='text-white'>verrouillage de sécurité</strong> : Tradovate a détecté trop de tentatives de connexion incorrectes dans une fenêtre courte et a temporairement bloqué de nouvelles tentatives pour protéger le compte. C'est le même mécanisme de protection qui fait apparaître un défi captcha, et lorsque cet état captcha apparaît, la consigne est claire, vous devriez être invité à réessayer dans environ une heure. Le verrouillage est délibéré, basé sur le temps, et se résout généralement de lui-même." },
    { type: "paragraph", html: "La deuxième version est un <strong class='text-white'>Trader Lockout</strong> (aussi appelé Manual Lockout). Ce n'est pas une punition. C'est une fonctionnalité de gestion du risque que vous ou votre prop firm pouvez activer pour vous éloigner de force de la plateforme pendant une période définie, jusqu'à 24 heures. Lorsqu'il s'active, toutes les positions ouvertes sont clôturées, les ordres en attente sont annulés, et le support ne peut pas y mettre fin plus tôt. Si votre compte est &ldquo;verrouillé&rdquo; mais que vous vous souvenez avoir réglé un minuteur, c'est presque certainement ce dont il s'agit." },
    { type: "paragraph", html: "La troisième version est une <strong class='text-white'>suspension liée à la facturation ou au compte</strong>. Si un paiement d'abonnement échoue, une échéance de renouvellement est dépassée, ou un paiement antérieur est contesté sous forme de rétrofacturation, l'accès peut être suspendu jusqu'à résolution de l'aspect financier. Les comptes se verrouillent aussi parfois immédiatement après un financement, où le véritable déclencheur est un signalement de sécurité ou une revue manuelle, pas un mot de passe erroné. Déterminer laquelle de ces trois situations vous concerne est l'enjeu principal, car chacune a une solution différente." },
    { type: "heading", text: "Principales causes d'un compte Tradovate verrouillé en 2026" },
    { type: "heading", text: "1. Trop de tentatives de connexion incorrectes" },
    { type: "paragraph", html: "C'est le cas classique du &ldquo;compte verrouillé après des échecs de connexion&rdquo;. Saisissez suffisamment de fois un identifiant ou un mot de passe erroné et la couche de sécurité de Tradovate bloque temporairement la connexion et peut afficher un captcha. Le verrouillage est volontairement de courte durée, mais marteler le bouton de connexion pendant qu'il est actif ne fait que réinitialiser le compteur. Lorsque le support examine ces cas, il indique souvent que le système a enregistré trop de tentatives erronées d'affilée, la signature classique d'un verrouillage pour échec de connexion." },
    { type: "heading", text: "2. Un défi captcha que vous continuez d'échouer" },
    { type: "paragraph", html: "Des tentatives rapides et répétées, qu'il s'agisse d'une personne retapant un mot de passe ou d'une application se réauthentifiant en boucle, peuvent faire évoluer un simple verrouillage vers une exigence de captcha. Une fois cet état captcha atteint, le seul véritable remède est d'attendre environ une heure avant de réessayer. Continuer à actualiser et à soumettre à nouveau vous maintient bloqué." },
    { type: "heading", text: "3. Un Trader Lockout auto-imposé (Manual Lockout)" },
    { type: "paragraph", html: "Si vous avez activé la fonctionnalité Trader Lockout, ou si votre prop firm l'a appliquée, le compte est intentionnellement verrouillé pour la durée que vous avez choisie, pouvant aller jusqu'à 24 heures. Cette fonctionnalité est proposée sur les comptes prop simulés (évaluation), elle clôture toutes les positions dès son déclenchement, et elle ne peut pas être levée avant l'expiration du minuteur. Les traders qui oublient l'avoir activée la confondent généralement avec un verrouillage de sécurité." },
    { type: "heading", text: "4. Une suspension liée à un paiement, un abonnement ou une rétrofacturation" },
    { type: "paragraph", html: "L'accès peut être suspendu lorsque l'aspect financier fait défaut : un paiement d'abonnement mensuel échoue, une échéance de renouvellement ou de pré-approbation est manquée, ou une charge passée est contestée sous forme de rétrofacturation. Les frais exacts, la cadence de renouvellement et les coûts de réinitialisation varient selon la société, le plan et la taille du compte, vérifiez les règles actuelles de votre société plutôt que de supposer un chiffre, mais le schéma reste constant. Tant que le problème de facturation n'est pas résolu, le compte reste restreint." },
    { type: "heading", text: "5. Un signalement de sécurité juste après un financement" },
    { type: "paragraph", html: "Une cause moins évidente est un verrouillage qui survient juste après avoir financé ou ouvert un compte. Ici, le déclencheur est généralement une revue manuelle ou un signalement de prévention de la fraude, pas un mauvais mot de passe. Dans ces cas, le compte peut apparaître verrouillé sans raison évidente, et la solution de contournement généralement suggérée par le support consiste à ouvrir un nouveau compte avec le même e-mail et un identifiant différent, une voie que seul le support peut autoriser." },
    { type: "heading", text: "Comment résoudre un compte Tradovate verrouillé : étape par étape" },
    { type: "heading", text: "Résoudre un verrouillage pour échec de connexion ou captcha" },
    {
      type: "steps",
      items: [
        { title: "Arrêtez d'essayer", html: "Le verrouillage est basé sur le temps, et les tentatives supplémentaires le prolongent. Fermez l'onglet ou l'application de connexion et laissez de côté." },
        { title: "Attendez que ça passe", html: "Pour un verrouillage déclenché par captcha, prévoyez environ une heure avant votre prochaine tentative. Un simple verrouillage de sécurité se résout souvent plus vite, mais la patience est la solution dans les deux cas." },
        { title: "Réinitialisez votre mot de passe", html: "Utilisez le lien Forgot Password avant de réessayer, afin que votre prochaine tentative utilise garantie des identifiants corrects plutôt qu'une nouvelle supposition." },
        { title: "Confirmez la connexion exacte que vous devriez utiliser", html: "Si vous tradez une évaluation de prop firm, connectez-vous avec les identifiants fournis par la société, pas avec un compte Tradovate personnel. Utiliser le mauvais jeu d'identifiants est une cause fréquente du verrouillage pour &ldquo;trop de tentatives erronées&rdquo;." },
        { title: "Essayez une connexion propre", html: "Après l'attente, si elle passe, vous êtes de nouveau connecté. Si elle échoue encore, passez à l'étape support ci-dessous plutôt que de réessayer en boucle." },
      ],
    },
    { type: "heading", text: "Résoudre un Trader Lockout auto-imposé" },
    {
      type: "steps",
      items: [
        { title: "Vérifiez si vous avez réglé un minuteur de verrouillage", html: "Si le compte affiche un compte à rebours ou un état Trader/Manual Lockout, il s'agit d'un auto-verrouillage délibéré, pas d'un blocage de sécurité." },
        { title: "Attendez l'expiration du minuteur", html: "Il n'y a pas de sortie anticipée, le support ne peut pas mettre fin à un Trader Lockout avant terme." },
        { title: "Contactez votre fournisseur d'évaluation si vous pensez qu'il a été appliqué par erreur", html: "Pour les comptes émis par une société, l'entreprise qui a accordé le verrouillage est la seule partie pouvant le revoir. Confirmez les étapes et libellés exacts dans le portail actuel de votre société, car ils évoluent avec le temps." },
      ],
    },
    { type: "heading", text: "Résoudre une suspension de paiement ou de facturation" },
    {
      type: "steps",
      items: [
        { title: "Ouvrez votre tableau de bord de compte ou d'abonnement", html: "Recherchez un statut échoué, suspendu, ou en retard." },
        { title: "Mettez à jour votre moyen de paiement", html: "Si un prélèvement a rebondi, mettez-le à jour et laissez la plateforme retenter le paiement. Les frais exacts et les montants de réinitialisation varient selon la société et le plan, vérifiez le chiffre actuel avant de payer." },
        { title: "Résolvez directement tout litige de rétrofacturation", html: "Si un paiement précédent a été annulé via votre banque, le compte reste généralement verrouillé jusqu'à ce que vous régliez le montant contesté avec Tradovate ou l'équipe de facturation de votre société." },
        { title: "Surveillez les échéances de renouvellement et de pré-approbation", html: "Une échéance manquée peut verrouiller un compte à elle seule. Renouveler ou re-approuver à temps restaure l'accès." },
      ],
    },
    { type: "heading", text: "Quand contacter le support" },
    {
      type: "steps",
      items: [
        { title: "Contactez après l'échec conjoint de l'attente et d'une réinitialisation de mot de passe", html: "Si une connexion propre ne passe toujours pas, le signalement nécessite probablement l'intervention d'une personne pour le lever." },
        { title: "Adressez-vous au bon interlocuteur", html: "Pour un compte Tradovate autonome, contactez le support Tradovate. Pour une évaluation de prop firm, contactez la société qui l'a émise, Tradovate redirige systématiquement les tickets de comptes de société vers la société." },
        { title: "Exposez précisément votre situation", html: "Quand le verrouillage a commencé, et s'il a suivi des échecs de connexion, un financement, ou un problème de paiement, afin que le support puisse trouver rapidement le bon signalement. S'ils suggèrent un nouveau compte avec le même e-mail, seuls eux peuvent autoriser cette voie." },
      ],
    },
    { type: "heading", text: "Tableau de dépannage" },
    {
      type: "table",
      headers: ["Symptôme / État", "Ce que cela signifie", "Solution"],
      rows: [
        ["Compte verrouillé après des tentatives de connexion répétées", "Verrouillage de sécurité dû à trop d'essais erronés d'identifiant/mot de passe", "Arrêtez de réessayer, attendez, réinitialisez votre mot de passe, puis tentez une connexion propre"],
        ["Défi captcha qui ne se résout pas", "Des tentatives rapides ont fait évoluer le verrouillage vers une exigence de captcha", "Arrêtez de réessayer et attendez environ une heure avant de retenter"],
        ["Compte à rebours Trader Lockout / Manual Lockout actif", "Un verrouillage de risque auto-imposé que vous ou votre société avez activé", "Attendez l'expiration du minuteur ; le support ne peut pas y mettre fin plus tôt"],
        ["Compte grisé, suspendu, ou &ldquo;en retard&rdquo;", "Un paiement d'abonnement a échoué ou une échéance a été manquée", "Mettez à jour votre moyen de paiement ou résolvez le problème de facturation avec le support"],
        ["Verrouillé immédiatement après le financement", "Un signalement de sécurité ou une revue manuelle, pas un mauvais mot de passe", "Contactez le support ; il peut autoriser un nouvel identifiant avec le même e-mail"],
        ["Impossible de créer un compte de remplacement", "Le compte d'origine est toujours signalé", "Demandez au support de lever le signalement avant de vous réinscrire"],
      ],
