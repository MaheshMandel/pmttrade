---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "websocket-heartbeats-duplicate-ids-24h";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/debugging/${SLUG}`;

const META_TITLE = "Tradovate WebSocket Drops: Heartbeats & 24h Limit";
const META_DESCRIPTION =
  "Tradovate WebSocket keeps disconnecting? Send a heartbeat every 2.5s, use unique request IDs, and reconnect before the 24-hour limit.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate API", de: "Tradovate API", es: "Tradovate API", fr: "Tradovate API", it: "Tradovate API" },
  h1: { en: META_TITLE, de: "Tradovate-WebSocket bricht ab: Heartbeats & 24-h-Limit", es: "Caídas del WebSocket de Tradovate: heartbeats y límite de 24 h", fr: "Déconnexions WebSocket Tradovate : heartbeats et limite de 24 h", it: "Disconnessioni WebSocket Tradovate: heartbeat e limite di 24 h" },
  dek: { en: "A Tradovate socket that keeps disconnecting almost always traces back to three fixable mistakes: missing heartbeats, duplicate request IDs, and holding one connection past the 24-hour limit. Here's each cause and the exact fix.", de: "Ein Tradovate-Socket, der ständig die Verbindung verliert, geht fast immer auf drei behebbare Fehler zurück: fehlende Heartbeats, doppelte Request-IDs und eine Verbindung, die länger als 24 Stunden offen gehalten wird. Hier ist jede Ursache mit der genauen Lösung.", es: "Un socket de Tradovate que se desconecta constantemente casi siempre se debe a tres errores solucionables: heartbeats ausentes, ID de solicitud duplicados y mantener una conexión abierta más allá del límite de 24 horas. Aquí tiene cada causa y la solución exacta.", fr: "Un socket Tradovate qui se déconnecte sans cesse tient presque toujours à trois erreurs corrigeables : des heartbeats manquants, des identifiants de requête en double et une connexion maintenue au-delà de la limite de 24 heures. Voici chaque cause et le correctif exact.", it: "Un socket Tradovate che continua a disconnettersi quasi sempre dipende da tre errori risolvibili: heartbeat mancanti, ID di richiesta duplicati e una connessione mantenuta oltre il limite di 24 ore. Ecco ogni causa e la correzione esatta." },
  readTime: { en: "8 min read", de: "8 Min. Lesezeit", es: "Lectura de 8 min", fr: "Lecture : 8 min", it: "Lettura di 8 min" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "Stream live ES or NQ quotes into an automated strategy and a Tradovate WebSocket that silently disconnects can leave a position unmanaged for minutes before you even notice. Tradovate's real-time socket is unforgiving. The server closes an idle connection within about 10 seconds if it stops hearing from your client, and a single connection has a hard lifespan measured in hours, not days. When a Tradovate WebSocket keeps disconnecting, it almost always comes down to three fixable mistakes, missing heartbeats, duplicate request IDs, and holding one connection past the 24-hour limit, plus a fourth, flooding the socket with requests. Below, you'll get each cause, the exact fix, and how routing your alerts through PickMyTrade skips the raw socket plumbing altogether." },
    {
      type: "checklist",
      heading: "Quick Checklist for Tradovate WebSocket Drops",
      items: [
        "<strong class='text-white'>Send a heartbeat every 2.5 seconds</strong>, a frame containing an empty array <code>[]</code>, sent from the client, keeps the socket open.",
        "<strong class='text-white'>Don't trust setInterval in a browser tab</strong>, background tabs throttle timers and starve your heartbeat. Use a timestamp check or a Web Worker.",
        "<strong class='text-white'>Give every request a unique, incrementing i (request ID)</strong>, never reuse an integer ID on the same socket.",
        "<strong class='text-white'>Pace your requests</strong>, bursting too many frames too quickly triggers a server-side disconnect.",
        "<strong class='text-white'>Reconnect before ~24 hours</strong>, a single Tradovate WebSocket isn't meant to live indefinitely, so schedule a clean reconnect.",
        "<strong class='text-white'>Renew the access token before it expires</strong>, an expired token means your re-authorize on reconnect fails.",
      ],
    },
    { type: "heading", text: "What \"Tradovate WebSocket Keeps Disconnecting\" Means" },
    { type: "paragraph", html: "Tradovate's WebSocket protocol is chatty by design. After you open the socket, the server sends an open frame (<code>o</code>), you send an authorize frame with your access token, and from then on both sides are expected to keep talking. If the server doesn't hear anything from your client for roughly 10 seconds, it assumes the connection is dead and closes it. That's why a socket that &ldquo;was working a second ago&rdquo; drops the moment your code stops sending frames." },
    { type: "paragraph", html: "Here's the catch that surprises most developers: <strong class='text-white'>once you subscribe to a live data feed, the server stops sending you its own heartbeat frames</strong> because the streaming messages themselves prove the link is alive. Your client, though, still has to prove <em>it</em> is alive. If your data feed goes quiet, a slow overnight session, a thin symbol, and your client isn't sending its own heartbeats, the server closes the socket even though nothing is &ldquo;wrong.&rdquo;" },
    { type: "paragraph", html: "On top of the idle timeout, holding a single connection open for <strong class='text-white'>more than 24 hours</strong> leads to disconnections. So even a perfectly behaved, heartbeat-sending client eventually gets dropped if it never reconnects. Understanding these two clocks, the ~10-second idle timer and the ~24-hour connection ceiling, is the key to a stable feed." },
    { type: "heading", text: "Top Causes of Tradovate WebSocket Drops in 2026" },
    { type: "heading", text: "1. No heartbeat (or a late one)" },
    { type: "paragraph", html: "This is the number-one cause. Your client is responsible for sending a heartbeat every 2.5 seconds, a frame whose text is exactly <code>[]</code>, to avoid being closed for inactivity. Miss the window and the socket closes." },
    { type: "heading", text: "2. Browser tabs throttling your timer" },
    { type: "paragraph", html: "If your app runs in a browser and you drive heartbeats with setInterval or setTimeout, an inactive or background tab gets its timers throttled by the browser. Your heartbeats arrive late or stop entirely, and the socket dies &ldquo;for no reason&rdquo; the moment you switch tabs." },
    { type: "heading", text: "3. Duplicate request IDs" },
    { type: "paragraph", html: "Every request you send carries an integer ID in its <code>i</code> field. Send two requests with the same <code>i</code> on the same socket and you confuse the request/response matching, which can break the connection or leave you waiting forever for a response that never resolves cleanly." },
    { type: "heading", text: "4. Sending requests too rapidly" },
    { type: "paragraph", html: "Fire a burst of frames at the socket, subscribing to dozens of symbols in a tight loop, say, or hammering order modifications, and you can trip Tradovate's flood protection and cause a disconnect." },
    { type: "heading", text: "5. Hitting the 24-hour limit or an expired token" },
    { type: "paragraph", html: "A connection held open past roughly 24 hours gets dropped. Related: the access token behind your session expires (Tradovate access tokens are short-lived, on the order of 90 minutes), so if you try to re-authorize a reconnected socket with a stale token, the auth fails and you stay disconnected." },
    { type: "heading", text: "How to Fix Tradovate WebSocket Drops: Step-by-Step" },
    { type: "heading", text: "Fixing Missing Heartbeats" },
    {
      type: "steps",
      items: [
        { title: "Start a heartbeat routine after authorizing", html: "As soon as your socket is authorized, start a heartbeat routine." },
        { title: "Send the empty array on a 2.5s cadence", html: "Every 2.5 seconds (2500 ms), send a frame containing an empty array <code>[]</code> using the standard WebSocket send method." },
        { title: "Keep sending even while streaming", html: "Keep sending heartbeats <strong class='text-white'>even while streaming market data</strong>, don't assume the server's silence means the link is healthy. When live data is flowing, the server stops sending its own heartbeats, so yours are the only thing keeping the socket open during quiet stretches." },
        { title: "Treat it as fire-and-forget", html: "Treat the heartbeat as fire-and-forget. It carries no request ID and expects no response." },
      ],
    },
    { type: "heading", text: "Fixing Browser-Tab Throttling" },
    {
      type: "steps",
      items: [
        { title: "Stop relying on setInterval alone", html: "Stop relying on setInterval / setTimeout alone for heartbeats in a browser." },
        { title: "Use a timestamp-based approach", html: "Use a <strong class='text-white'>timestamp-based</strong> approach instead: on every incoming message, record the current time and compare it to the time of the last heartbeat. If more than 2500 ms have elapsed, send a heartbeat frame immediately." },
        { title: "Move the timer off the main thread", html: "For apps that must survive long stretches with no incoming data in a background tab, move the timer into a <strong class='text-white'>Web Worker</strong> (which isn't throttled the same way), or run the socket in a server-side Node.js process where there's no inactive-tab concept at all." },
      ],
    },
    { type: "heading", text: "Fixing Duplicate Request IDs" },
    {
      type: "steps",
      items: [
        { title: "Maintain one incrementing counter", html: "Maintain a single, monotonically increasing counter for the <code>i</code> field on each socket." },
        { title: "Reserve the low IDs for setup", html: "Reserve the low IDs the protocol uses for setup (authorization and the initial sync request) and start your general counter above them." },
        { title: "Increment atomically", html: "Increment the counter <strong class='text-white'>atomically</strong> so two async tasks can never grab the same value. In multi-threaded or heavily concurrent code, guard the counter with a lock, a closure, or a thread-safe structure." },
        { title: "Never reuse an ID on retry", html: "Never hand-write the same ID twice. If you retry a request, give the retry a fresh ID." },
      ],
    },
    { type: "heading", text: "Fixing Request Floods and the 24-Hour Limit" },
    {
      type: "steps",
      items: [
        { title: "Throttle outbound frames", html: "Queue your requests and release them at a steady pace instead of bursting. Spacing subscriptions and order actions keeps you under the socket's tolerance." },
        { title: "Schedule a proactive reconnect", html: "Don't wait for the ~24-hour drop. Reconnect on your own schedule (well inside 24 hours), re-send the authorize frame, and re-subscribe to your feeds so the switch is smooth." },
        { title: "Refresh the token first", html: "Track your access token's expiry and renew it <em>before</em> it lapses so the re-authorize on reconnect always uses a valid token. Exact token lifetimes are set by Tradovate and can change, check the current API docs rather than hard-coding a number." },
        { title: "Auto-recover on every unexpected close", html: "Treat every unexpected close as an error and auto-recover. Unless you're intentionally shutting down, reopen the socket, re-authorize, and resubscribe automatically. Add a timeout on pending responses so a stuck request never hangs your whole client." },
      ],
    },
    { type: "heading", text: "Troubleshooting Table" },
    {
      type: "table",
      headers: ["Symptom / error", "What it means", "Fix"],
      rows: [
        ["Socket closes after ~10 seconds of silence", "No client heartbeat; server closed the idle connection", "Send an empty-array [] heartbeat every 2.5s"],
        ["Feed dies the moment the tab goes to background", "Browser throttled setInterval / setTimeout", "Use timestamp-based heartbeats or a Web Worker"],
        ["Live data stops but socket \"looks\" connected", "Server stopped its own heartbeats while streaming; client sent none", "Keep sending client heartbeats even while streaming"],
        ["Responses mismatch or requests hang", "Duplicate integer i (request ID) values", "Use one atomic, incrementing request-ID counter"],
        ["Connection drops after a burst of frames", "Too many requests sent too rapidly", "Queue and pace outbound requests"],
        ["Connection drops around the 24-hour mark", "Single connection held past its lifespan", "Reconnect, re-authorize, and resubscribe well inside 24h"],
        ["Re-authorize fails after a reconnect", "Access token expired", "Renew the token before it expires, then re-send authorize"],
      ],
    },
    { type: "heading", text: "Prevent This with PickMyTrade" },
    { type: "paragraph", html: "If you're wiring up automation just to get orders into Tradovate, you may not need to manage a raw WebSocket at all. PickMyTrade takes your TradingView alerts and delivers them to Tradovate for you, so the heartbeat timing, request-ID hygiene, and reconnect logic all live on our side:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Managed Connection Health</strong>, the connection to Tradovate is kept alive and reconnected for you, so heartbeat gaps and the 24-hour ceiling never reach your strategy.",
        "<strong class='text-white'>Rate-Limit-Safe Routing</strong>, alerts are paced and queued so a burst of signals never floods the socket into a disconnect.",
        "<strong class='text-white'>Token &amp; Session Handling</strong>, authentication and renewal are managed behind the scenes, so an expired token never silently kills your automation.",
        "<strong class='text-white'>Multi-Account Sync</strong>, one alert mirrors cleanly across multiple Tradovate accounts without you juggling a socket per account.",
      ],
    },
  ], de: [
    { type: "paragraph",html: "Streamen Sie Live-Kurse von ES oder NQ in eine automatisierte Strategie, und ein Tradovate-WebSocket, der sich stillschweigend trennt, kann eine Position minutenlang unbeaufsichtigt lassen, bevor Sie es überhaupt bemerken. Tradovates Echtzeit-Socket ist unerbittlich. Der Server schließt eine inaktive Verbindung innerhalb von etwa 10 Sekunden, wenn er nichts mehr von Ihrem Client hört, und eine einzelne Verbindung hat eine harte Lebensdauer, die in Stunden und nicht in Tagen gemessen wird. Wenn ein Tradovate-WebSocket ständig abbricht, liegt es fast immer an drei behebbaren Fehlern, nämlich fehlenden Heartbeats, doppelten Request-IDs und einer Verbindung, die über das 24-Stunden-Limit hinaus offen gehalten wird, plus einem vierten, der Überflutung des Sockets mit Anfragen. Unten finden Sie jede Ursache, die genaue Lösung und wie Sie mit der Weiterleitung Ihrer Alerts über PickMyTrade die rohe Socket-Verwaltung ganz umgehen." },
    {
      type: "checklist",
      heading: "Kurz-Checkliste bei Tradovate-WebSocket-Abbrüchen",
      items: [
        "<strong class='text-white'>Senden Sie alle 2,5 Sekunden einen Heartbeat</strong>, einen Frame mit einem leeren Array <code>[]</code>, vom Client gesendet, hält den Socket offen.",
        "<strong class='text-white'>Verlassen Sie sich in einem Browser-Tab nicht auf setInterval</strong>, Hintergrund-Tabs drosseln Timer und lassen Ihren Heartbeat verhungern. Verwenden Sie eine Zeitstempelprüfung oder einen Web Worker.",
        "<strong class='text-white'>Geben Sie jeder Anfrage eine eindeutige, aufsteigende i (Request-ID)</strong>, verwenden Sie auf demselben Socket niemals eine Ganzzahl-ID erneut.",
        "<strong class='text-white'>Takten Sie Ihre Anfragen</strong>, zu viele Frames in zu kurzer Zeit lösen eine serverseitige Trennung aus.",
        "<strong class='text-white'>Verbinden Sie sich vor Ablauf von ca. 24 Stunden neu</strong>, ein einzelner Tradovate-WebSocket ist nicht für unbegrenzte Lebensdauer gedacht, planen Sie daher eine saubere Wiederverbindung ein.",
        "<strong class='text-white'>Erneuern Sie das Access-Token vor dem Ablauf</strong>, ein abgelaufenes Token bedeutet, dass Ihre erneute Autorisierung bei der Wiederverbindung fehlschlägt.",
      ],
    },
    { type: "heading",text: "Was „Tradovate-WebSocket trennt ständig die Verbindung“ bedeutet" },
    { type: "paragraph",html: "Das WebSocket-Protokoll von Tradovate ist von Haus aus gesprächig. Nachdem Sie den Socket geöffnet haben, sendet der Server einen Open-Frame (<code>o</code>), Sie senden einen Authorize-Frame mit Ihrem Access-Token, und von da an wird erwartet, dass beide Seiten weiter kommunizieren. Wenn der Server etwa 10 Sekunden lang nichts von Ihrem Client hört, geht er davon aus, dass die Verbindung tot ist, und schließt sie. Deshalb bricht ein Socket, der &ldquo;eben noch funktionierte&rdquo;, in dem Moment ab, in dem Ihr Code keine Frames mehr sendet." },
    { type: "paragraph",html: "Hier ist der Haken, der die meisten Entwickler überrascht: <strong class='text-white'>Sobald Sie einen Live-Datenfeed abonnieren, sendet der Server keine eigenen Heartbeat-Frames mehr</strong>, weil die Streaming-Nachrichten selbst beweisen, dass die Verbindung aktiv ist. Ihr Client muss jedoch weiterhin beweisen, dass <em>er</em> aktiv ist. Wird Ihr Datenfeed ruhig, etwa in einer langsamen Nachtsitzung oder bei einem wenig gehandelten Symbol, und Ihr Client sendet keine eigenen Heartbeats, schließt der Server den Socket, obwohl nichts &ldquo;falsch&rdquo; ist." },
    { type: "paragraph",html: "Zusätzlich zum Inaktivitäts-Timeout führt eine einzelne Verbindung, die <strong class='text-white'>länger als 24 Stunden</strong> offen gehalten wird, zu Trennungen. Selbst ein perfekt funktionierender Client, der Heartbeats sendet, wird also irgendwann getrennt, wenn er sich nie neu verbindet. Diese beiden Uhren zu verstehen, den Inaktivitäts-Timer von ca. 10 Sekunden und die Verbindungsobergrenze von ca. 24 Stunden, ist der Schlüssel zu einem stabilen Feed." },
    { type: "heading",text: "Die häufigsten Ursachen für Tradovate-WebSocket-Abbrüche 2026" },
    { type: "heading",text: "1. Kein Heartbeat (oder ein verspäteter)" },
    { type: "paragraph",html: "Das ist die Ursache Nummer eins. Ihr Client ist dafür verantwortlich, alle 2,5 Sekunden einen Heartbeat zu senden, einen Frame, dessen Text genau <code>[]</code> lautet, um nicht wegen Inaktivität geschlossen zu werden. Verpassen Sie das Zeitfenster, schließt sich der Socket." },
    { type: "heading",text: "2. Browser-Tabs drosseln Ihren Timer" },
    { type: "paragraph",html: "Läuft Ihre App in einem Browser und steuern Sie Heartbeats mit setInterval oder setTimeout, werden die Timer eines inaktiven oder im Hintergrund laufenden Tabs vom Browser gedrosselt. Ihre Heartbeats kommen verspätet oder bleiben ganz aus, und der Socket stirbt &ldquo;ohne Grund&rdquo;, sobald Sie den Tab wechseln." },
    { type: "heading",text: "3. Doppelte Request-IDs" },
    { type: "paragraph",html: "Jede Anfrage, die Sie senden, trägt im Feld <code>i</code> eine Ganzzahl-ID. Senden Sie zwei Anfragen mit demselben <code>i</code> auf demselben Socket, bringen Sie die Zuordnung von Anfrage und Antwort durcheinander, was die Verbindung unterbrechen oder Sie ewig auf eine Antwort warten lassen kann, die nie sauber aufgelöst wird." },
    { type: "heading",text: "4. Zu schnelles Senden von Anfragen" },
    { type: "paragraph",html: "Wenn Sie einen Schwall von Frames auf den Socket abfeuern, etwa Dutzende Symbole in einer engen Schleife abonnieren oder Ordermodifikationen im Dauerfeuer senden, können Sie den Flood-Schutz von Tradovate auslösen und eine Trennung verursachen." },
    { type: "heading",text: "5. Das 24-Stunden-Limit erreicht oder ein abgelaufenes Token" },
    { type: "paragraph",html: "Eine Verbindung, die länger als etwa 24 Stunden offen gehalten wird, wird getrennt. Ähnlich verhält es sich mit dem Access-Token Ihrer Sitzung, das abläuft (Tradovate-Access-Tokens sind kurzlebig, in der Größenordnung von 90 Minuten). Versuchen Sie, einen neu verbundenen Socket mit einem veralteten Token erneut zu autorisieren, schlägt die Authentifizierung fehl und Sie bleiben getrennt." },
    { type: "heading",text: "So beheben Sie Tradovate-WebSocket-Abbrüche: Schritt für Schritt" },
    { type: "heading",text: "Fehlende Heartbeats beheben" },
    {
      type: "steps",
      items: [
        { title: "Heartbeat-Routine nach der Autorisierung starten", html: "Starten Sie eine Heartbeat-Routine, sobald Ihr Socket autorisiert ist." },
        { title: "Das leere Array im 2,5-Sekunden-Takt senden", html: "Senden Sie alle 2,5 Sekunden (2500 ms) mit der Standardmethode send des WebSockets einen Frame mit einem leeren Array <code>[]</code>." },
        { title: "Auch beim Streaming weitersenden", html: "Senden Sie Heartbeats weiter, <strong class='text-white'>auch während des Streamings von Marktdaten</strong>, und gehen Sie nicht davon aus, dass die Stille des Servers eine intakte Verbindung bedeutet. Fließen Live-Daten, sendet der Server keine eigenen Heartbeats mehr, sodass Ihre das Einzige sind, was den Socket in ruhigen Phasen offen hält." },
        { title: "Als Fire-and-Forget behandeln", html: "Behandeln Sie den Heartbeat als Fire-and-Forget. Er trägt keine Request-ID und erwartet keine Antwort." },
      ],
    },
    { type: "heading",text: "Browser-Tab-Drosselung beheben" },
    {
      type: "steps",
      items: [
        { title: "Nicht allein auf setInterval verlassen", html: "Verlassen Sie sich in einem Browser für Heartbeats nicht allein auf setInterval / setTimeout." },
        { title: "Einen zeitstempelbasierten Ansatz verwenden", html: "Verwenden Sie stattdessen einen <strong class='text-white'>zeitstempelbasierten</strong> Ansatz: Erfassen Sie bei jeder eingehenden Nachricht die aktuelle Zeit und vergleichen Sie sie mit dem Zeitpunkt des letzten Heartbeats. Sind mehr als 2500 ms vergangen, senden Sie sofort einen Heartbeat-Frame." },
        { title: "Den Timer vom Hauptthread auslagern", html: "Verlagern Sie den Timer bei Apps, die lange Phasen ohne eingehende Daten in einem Hintergrund-Tab überstehen müssen, in einen <strong class='text-white'>Web Worker</strong> (der nicht auf dieselbe Weise gedrosselt wird), oder betreiben Sie den Socket in einem serverseitigen Node.js-Prozess, in dem es das Konzept eines inaktiven Tabs gar nicht gibt." },
      ],
    },
    { type: "heading",text: "Doppelte Request-IDs beheben" },
    {
      type: "steps",
      items: [
        { title: "Einen aufsteigenden Zähler führen", html: "Führen Sie für das Feld <code>i</code> auf jedem Socket einen einzigen, streng monoton steigenden Zähler." },
        { title: "Niedrige IDs für die Einrichtung reservieren", html: "Reservieren Sie die niedrigen IDs, die das Protokoll für die Einrichtung verwendet (Autorisierung und die erste Sync-Anfrage), und starten Sie Ihren allgemeinen Zähler oberhalb davon." },
        { title: "Atomar erhöhen", html: "Erhöhen Sie den Zähler <strong class='text-white'>atomar</strong>, damit zwei asynchrone Aufgaben nie denselben Wert erhalten. Sichern Sie den Zähler in Multithread- oder stark nebenläufigem Code mit einem Lock, einer Closure oder einer threadsicheren Struktur." },
        { title: "Bei Wiederholung nie eine ID erneut verwenden", html: "Vergeben Sie nie von Hand dieselbe ID zweimal. Wenn Sie eine Anfrage wiederholen, geben Sie der Wiederholung eine neue ID." },
      ],
    },
    { type: "heading",text: "Anfrageflut und 24-Stunden-Limit beheben" },
    {
      type: "steps",
      items: [
        { title: "Ausgehende Frames drosseln", html: "Reihen Sie Ihre Anfragen in eine Warteschlange ein und geben Sie sie in gleichmäßigem Tempo frei, statt sie als Schwall zu senden. Abgestufte Abonnements und Order-Aktionen halten Sie unter der Toleranz des Sockets." },
        { title: "Eine proaktive Wiederverbindung planen", html: "Warten Sie nicht auf die Trennung nach ca. 24 Stunden. Verbinden Sie sich nach Ihrem eigenen Zeitplan neu (deutlich innerhalb von 24 Stunden), senden Sie den Authorize-Frame erneut und abonnieren Sie Ihre Feeds erneut, damit der Wechsel reibungslos verläuft." },
        { title: "Zuerst das Token erneuern", html: "Verfolgen Sie den Ablauf Ihres Access-Tokens und erneuern Sie es, <em>bevor</em> es abläuft, damit die erneute Autorisierung bei der Wiederverbindung immer ein gültiges Token verwendet. Die genauen Token-Laufzeiten legt Tradovate fest und sie können sich ändern. Prüfen Sie die aktuelle API-Dokumentation, anstatt eine Zahl fest zu codieren." },
        { title: "Bei jedem unerwarteten Schließen automatisch wiederherstellen", html: "Behandeln Sie jedes unerwartete Schließen als Fehler und stellen Sie die Verbindung automatisch wieder her. Sofern Sie nicht absichtlich herunterfahren, öffnen Sie den Socket erneut, autorisieren Sie sich neu und abonnieren Sie automatisch erneut. Fügen Sie ein Timeout für ausstehende Antworten hinzu, damit eine festhängende Anfrage nie Ihren gesamten Client blockiert." },
      ],
    },
    { type: "heading",text: "Tabelle zur Fehlerbehebung" },
    { type: "table", headers: ["Symptom / Fehler","Was es bedeutet","Lösung"], rows: [
      ["Socket schließt sich nach ca. 10 Sekunden Stille","Kein Client-Heartbeat, der Server hat die inaktive Verbindung geschlossen","Alle 2,5 s einen Heartbeat mit leerem Array [] senden"],
      ["Feed bricht ab, sobald der Tab in den Hintergrund geht","Browser hat setInterval / setTimeout gedrosselt","Zeitstempelbasierte Heartbeats oder einen Web Worker verwenden"],
      ["Live-Daten stoppen, aber der Socket „sieht“ verbunden aus","Server hat beim Streaming seine eigenen Heartbeats eingestellt, der Client sendete keine","Client-Heartbeats auch während des Streamings weitersenden"],
      ["Antworten passen nicht oder Anfragen hängen","Doppelte Ganzzahlwerte für i (Request-ID)","Einen atomaren, aufsteigenden Request-ID-Zähler verwenden"],
      ["Verbindung bricht nach einem Schwall von Frames ab","Zu viele Anfragen zu schnell gesendet","Ausgehende Anfragen in eine Warteschlange stellen und takten"],
      ["Verbindung bricht um die 24-Stunden-Marke ab","Einzelne Verbindung über ihre Lebensdauer hinaus gehalten","Deutlich innerhalb von 24 h neu verbinden, neu autorisieren und neu abonnieren"],
      ["Erneute Autorisierung schlägt nach einer Wiederverbindung fehl","Access-Token abgelaufen","Token vor dem Ablauf erneuern, dann Authorize erneut senden"],
    ] },
    { type: "heading",text: "Vermeiden Sie das mit PickMyTrade" },
    { type: "paragraph",html: "Wenn Sie Automatisierung nur einrichten, um Orders in Tradovate zu bekommen, müssen Sie möglicherweise gar keinen rohen WebSocket verwalten. PickMyTrade nimmt Ihre TradingView-Alerts entgegen und liefert sie für Sie an Tradovate aus, sodass Heartbeat-Timing, Request-ID-Hygiene und Wiederverbindungslogik auf unserer Seite liegen:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Verwaltete Verbindungsstabilität</strong>, die Verbindung zu Tradovate wird für Sie aufrechterhalten und neu aufgebaut, sodass Heartbeat-Lücken und die 24-Stunden-Obergrenze Ihre Strategie nie erreichen.",
        "<strong class='text-white'>Ratenlimit-sicheres Routing</strong>, Alerts werden getaktet und in eine Warteschlange gestellt, damit ein Schwall von Signalen den Socket nie bis zur Trennung überflutet.",
        "<strong class='text-white'>Token- &amp; Sitzungsverwaltung</strong>, Authentifizierung und Erneuerung werden im Hintergrund verwaltet, sodass ein abgelaufenes Token Ihre Automatisierung nie unbemerkt lahmlegt.",
        "<strong class='text-white'>Multi-Account-Synchronisierung</strong>, ein Alert wird sauber auf mehrere Tradovate-Konten gespiegelt, ohne dass Sie einen Socket pro Konto jonglieren müssen.",
      ],
    },
  ], es: [
    { type: "paragraph",html: "Si transmite cotizaciones en vivo de ES o NQ a una estrategia automatizada, un WebSocket de Tradovate que se desconecta en silencio puede dejar una posición sin gestionar durante minutos antes de que usted lo note. El socket en tiempo real de Tradovate no perdona. El servidor cierra una conexión inactiva en unos 10 segundos si deja de recibir noticias de su cliente, y una única conexión tiene una vida útil estricta que se mide en horas, no en días. Cuando un WebSocket de Tradovate se desconecta continuamente, casi siempre se reduce a tres errores solucionables, heartbeats ausentes, ID de solicitud duplicados y mantener una conexión más allá del límite de 24 horas, más un cuarto, saturar el socket con solicitudes. A continuación encontrará cada causa, la solución exacta y cómo enrutar sus alertas a través de PickMyTrade le evita por completo la gestión del socket en bruto." },
    {
      type: "checklist",
      heading: "Lista de verificación rápida para las caídas del WebSocket de Tradovate",
      items: [
        "<strong class='text-white'>Envíe un heartbeat cada 2,5 segundos</strong>, una trama que contiene un array vacío <code>[]</code>, enviada desde el cliente, mantiene abierto el socket.",
        "<strong class='text-white'>No confíe en setInterval en una pestaña del navegador</strong>, las pestañas en segundo plano limitan los temporizadores y dejan sin heartbeats a su conexión. Use una comprobación de marca de tiempo o un Web Worker.",
        "<strong class='text-white'>Dé a cada solicitud una i (ID de solicitud) única e incremental</strong>, nunca reutilice un ID entero en el mismo socket.",
        "<strong class='text-white'>Regule el ritmo de sus solicitudes</strong>, enviar demasiadas tramas demasiado rápido provoca una desconexión por parte del servidor.",
        "<strong class='text-white'>Reconecte antes de ~24 horas</strong>, un único WebSocket de Tradovate no está pensado para vivir indefinidamente, así que programe una reconexión limpia.",
        "<strong class='text-white'>Renueve el token de acceso antes de que caduque</strong>, un token caducado significa que su nueva autorización al reconectar falla.",
      ],
    },
    { type: "heading",text: "Qué significa «el WebSocket de Tradovate se desconecta constantemente»" },
    { type: "paragraph",html: "El protocolo WebSocket de Tradovate es conversador por diseño. Tras abrir el socket, el servidor envía una trama open (<code>o</code>), usted envía una trama authorize con su token de acceso y, a partir de ahí, se espera que ambas partes sigan comunicándose. Si el servidor no recibe nada de su cliente durante aproximadamente 10 segundos, asume que la conexión está muerta y la cierra. Por eso un socket que &ldquo;funcionaba hace un segundo&rdquo; se cae en el momento en que su código deja de enviar tramas." },
    { type: "paragraph",html: "Aquí está el detalle que sorprende a la mayoría de los desarrolladores: <strong class='text-white'>una vez que se suscribe a un feed de datos en vivo, el servidor deja de enviarle sus propias tramas de heartbeat</strong> porque los propios mensajes de streaming demuestran que el enlace está activo. Sin embargo, su cliente aún tiene que demostrar que <em>él</em> está activo. Si su feed de datos se queda en silencio, en una sesión nocturna lenta o con un símbolo poco negociado, y su cliente no envía sus propios heartbeats, el servidor cierra el socket aunque nada esté &ldquo;mal&rdquo;." },
    { type: "paragraph",html: "Además del tiempo de espera por inactividad, mantener una única conexión abierta durante <strong class='text-white'>más de 24 horas</strong> provoca desconexiones. Así que incluso un cliente perfectamente correcto que envía heartbeats acaba siendo desconectado si nunca reconecta. Comprender estos dos relojes, el temporizador de inactividad de ~10 segundos y el techo de conexión de ~24 horas, es la clave para un feed estable." },
    { type: "heading",text: "Principales causas de las caídas del WebSocket de Tradovate en 2026" },
    { type: "heading",text: "1. Sin heartbeat (o uno tardío)" },
    { type: "paragraph",html: "Esta es la causa número uno. Su cliente es responsable de enviar un heartbeat cada 2,5 segundos, una trama cuyo texto es exactamente <code>[]</code>, para evitar que lo cierren por inactividad. Si pierde la ventana, el socket se cierra." },
    { type: "heading",text: "2. Las pestañas del navegador limitan su temporizador" },
    { type: "paragraph",html: "Si su aplicación se ejecuta en un navegador y controla los heartbeats con setInterval o setTimeout, el navegador limita los temporizadores de una pestaña inactiva o en segundo plano. Sus heartbeats llegan tarde o se detienen por completo, y el socket muere &ldquo;sin motivo&rdquo; en cuanto cambia de pestaña." },
    { type: "heading",text: "3. ID de solicitud duplicados" },
    { type: "paragraph",html: "Cada solicitud que envía lleva un ID entero en su campo <code>i</code>. Si envía dos solicitudes con el mismo <code>i</code> en el mismo socket, confunde la asociación entre solicitud y respuesta, lo que puede romper la conexión o dejarle esperando indefinidamente una respuesta que nunca se resuelve limpiamente." },
    { type: "heading",text: "4. Enviar solicitudes demasiado rápido" },
    { type: "paragraph",html: "Si lanza una ráfaga de tramas al socket, por ejemplo suscribiéndose a docenas de símbolos en un bucle cerrado o martilleando modificaciones de órdenes, puede activar la protección contra saturación de Tradovate y provocar una desconexión." },
    { type: "heading",text: "5. Alcanzar el límite de 24 horas o un token caducado" },
    { type: "paragraph",html: "Una conexión mantenida abierta más de unas 24 horas se cierra. Relacionado con esto: el token de acceso de su sesión caduca (los tokens de acceso de Tradovate son de corta duración, del orden de 90 minutos), así que si intenta volver a autorizar un socket reconectado con un token obsoleto, la autenticación falla y sigue desconectado." },
    { type: "heading",text: "Cómo solucionar las caídas del WebSocket de Tradovate: paso a paso" },
    { type: "heading",text: "Solución de los heartbeats ausentes" },
    {
      type: "steps",
      items: [
        { title: "Inicie una rutina de heartbeat tras autorizar", html: "En cuanto su socket esté autorizado, inicie una rutina de heartbeat." },
        { title: "Envíe el array vacío con una cadencia de 2,5 s", html: "Cada 2,5 segundos (2500 ms), envíe una trama que contenga un array vacío <code>[]</code> usando el método send estándar del WebSocket." },
        { title: "Siga enviando incluso durante el streaming", html: "Siga enviando heartbeats <strong class='text-white'>incluso mientras recibe datos de mercado</strong>, no asuma que el silencio del servidor significa que el enlace está sano. Cuando fluyen datos en vivo, el servidor deja de enviar sus propios heartbeats, así que los suyos son lo único que mantiene abierto el socket durante los periodos tranquilos." },
        { title: "Trátelo como «enviar y olvidar»", html: "Trate el heartbeat como «enviar y olvidar». No lleva ID de solicitud y no espera respuesta." },
      ],
    },
    { type: "heading",text: "Solución de la limitación de las pestañas del navegador" },
    {
      type: "steps",
      items: [
        { title: "Deje de depender solo de setInterval", html: "Deje de depender únicamente de setInterval / setTimeout para los heartbeats en un navegador." },
        { title: "Use un enfoque basado en marcas de tiempo", html: "Use en su lugar un enfoque <strong class='text-white'>basado en marcas de tiempo</strong>: en cada mensaje entrante, registre la hora actual y compárela con la hora del último heartbeat. Si han transcurrido más de 2500 ms, envíe una trama de heartbeat de inmediato." },
        { title: "Mueva el temporizador fuera del hilo principal", html: "En aplicaciones que deben sobrevivir a largos periodos sin datos entrantes en una pestaña en segundo plano, mueva el temporizador a un <strong class='text-white'>Web Worker</strong> (que no se limita de la misma manera), o ejecute el socket en un proceso Node.js del lado del servidor, donde no existe el concepto de pestaña inactiva." },
      ],
    },
    { type: "heading",text: "Solución de los ID de solicitud duplicados" },
    {
      type: "steps",
      items: [
        { title: "Mantenga un único contador incremental", html: "Mantenga un único contador estrictamente creciente para el campo <code>i</code> en cada socket." },
        { title: "Reserve los ID bajos para la configuración", html: "Reserve los ID bajos que el protocolo usa para la configuración (la autorización y la solicitud de sincronización inicial) y haga que su contador general empiece por encima de ellos." },
        { title: "Incremente de forma atómica", html: "Incremente el contador de forma <strong class='text-white'>atómica</strong> para que dos tareas asíncronas nunca obtengan el mismo valor. En código multihilo o muy concurrente, proteja el contador con un bloqueo, un closure o una estructura segura para hilos." },
        { title: "Nunca reutilice un ID al reintentar", html: "Nunca escriba a mano el mismo ID dos veces. Si reintenta una solicitud, asigne al reintento un ID nuevo." },
      ],
    },
    { type: "heading",text: "Solución de las ráfagas de solicitudes y el límite de 24 horas" },
    {
      type: "steps",
      items: [
        { title: "Limite las tramas salientes", html: "Ponga sus solicitudes en cola y libérelas a un ritmo constante en lugar de enviarlas en ráfagas. Espaciar las suscripciones y las acciones sobre órdenes le mantiene por debajo de la tolerancia del socket." },
        { title: "Programe una reconexión proactiva", html: "No espere a la caída de ~24 horas. Reconecte con su propio calendario (bien dentro de las 24 horas), vuelva a enviar la trama authorize y vuelva a suscribirse a sus feeds para que el cambio sea fluido." },
        { title: "Renueve primero el token", html: "Controle la caducidad de su token de acceso y renuévelo <em>antes</em> de que expire para que la nueva autorización al reconectar use siempre un token válido. Tradovate fija la duración exacta de los tokens y puede cambiar, consulte la documentación actual de la API en lugar de codificar un número fijo." },
        { title: "Recupérese automáticamente tras cada cierre inesperado", html: "Trate cada cierre inesperado como un error y recupérese automáticamente. A menos que esté apagando de forma intencionada, vuelva a abrir el socket, vuelva a autorizar y vuelva a suscribirse automáticamente. Añada un tiempo de espera a las respuestas pendientes para que una solicitud atascada nunca bloquee a todo su cliente." },
      ],
    },
    { type: "heading",text: "Tabla de solución de problemas" },
    { type: "table", headers: ["Síntoma / error","Qué significa","Solución"], rows: [
      ["El socket se cierra tras ~10 segundos de silencio","Sin heartbeat del cliente; el servidor cerró la conexión inactiva","Enviar un heartbeat con array vacío [] cada 2,5 s"],
      ["El feed muere en cuanto la pestaña pasa a segundo plano","El navegador limitó setInterval / setTimeout","Usar heartbeats basados en marcas de tiempo o un Web Worker"],
      ["Los datos en vivo se detienen pero el socket «parece» conectado","El servidor dejó de enviar sus propios heartbeats durante el streaming; el cliente no envió ninguno","Seguir enviando heartbeats del cliente incluso durante el streaming"],
      ["Las respuestas no coinciden o las solicitudes se bloquean","Valores enteros i (ID de solicitud) duplicados","Usar un único contador de ID de solicitud atómico e incremental"],
      ["La conexión se cae tras una ráfaga de tramas","Se enviaron demasiadas solicitudes demasiado rápido","Poner en cola y regular el ritmo de las solicitudes salientes"],
      ["La conexión se cae alrededor de las 24 horas","Una única conexión mantenida más allá de su vida útil","Reconectar, volver a autorizar y volver a suscribirse bien dentro de las 24 h"],
      ["La nueva autorización falla tras una reconexión","El token de acceso caducó","Renovar el token antes de que caduque y luego volver a enviar authorize"],
    ] },
    { type: "heading",text: "Evítelo con PickMyTrade" },
    { type: "paragraph",html: "Si está montando la automatización solo para hacer llegar órdenes a Tradovate, es posible que no necesite gestionar un WebSocket en bruto en absoluto. PickMyTrade toma sus alertas de TradingView y se las entrega a Tradovate por usted, de modo que el momento de los heartbeats, la higiene de los ID de solicitud y la lógica de reconexión quedan de nuestro lado:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Salud de la conexión gestionada</strong>, la conexión con Tradovate se mantiene activa y se reconecta por usted, de modo que las interrupciones de heartbeat y el techo de 24 horas nunca llegan a su estrategia.",
        "<strong class='text-white'>Enrutamiento seguro frente a límites de tasa</strong>, las alertas se espacian y se ponen en cola para que una ráfaga de señales nunca sature el socket hasta provocar una desconexión.",
        "<strong class='text-white'>Gestión de tokens &amp; sesión</strong>, la autenticación y la renovación se gestionan entre bastidores, de modo que un token caducado nunca mata silenciosamente su automatización.",
        "<strong class='text-white'>Sincronización multicuenta</strong>, una alerta se replica limpiamente en varias cuentas de Tradovate sin que tenga que manejar un socket por cuenta.",
      ],
    },
  ], fr: [
    { type: "paragraph",html: "Diffusez des cotations ES ou NQ en direct vers une stratégie automatisée, et un WebSocket Tradovate qui se déconnecte silencieusement peut laisser une position sans surveillance pendant des minutes avant même que vous ne vous en aperceviez. Le socket temps réel de Tradovate est impitoyable. Le serveur ferme une connexion inactive en environ 10 secondes s'il cesse d'entendre votre client, et une connexion unique a une durée de vie stricte mesurée en heures, pas en jours. Lorsqu'un WebSocket Tradovate se déconnecte sans cesse, cela tient presque toujours à trois erreurs corrigeables, des heartbeats manquants, des identifiants de requête en double et une connexion maintenue au-delà de la limite de 24 heures, plus une quatrième, l'inondation du socket de requêtes. Vous trouverez ci-dessous chaque cause, le correctif exact, et comment l'acheminement de vos alertes via PickMyTrade vous évite entièrement la plomberie de socket brute." },
    {
      type: "checklist",
      heading: "Liste de contrôle rapide pour les déconnexions WebSocket Tradovate",
      items: [
        "<strong class='text-white'>Envoyez un heartbeat toutes les 2,5 secondes</strong>, une trame contenant un tableau vide <code>[]</code>, envoyée par le client, maintient le socket ouvert.",
        "<strong class='text-white'>Ne vous fiez pas à setInterval dans un onglet de navigateur</strong>, les onglets en arrière-plan brident les minuteries et privent votre heartbeat. Utilisez une vérification d'horodatage ou un Web Worker.",
        "<strong class='text-white'>Donnez à chaque requête un i (identifiant de requête) unique et incrémental</strong>, ne réutilisez jamais un identifiant entier sur le même socket.",
        "<strong class='text-white'>Rythmez vos requêtes</strong>, envoyer trop de trames trop vite déclenche une déconnexion côté serveur.",
        "<strong class='text-white'>Reconnectez-vous avant ~24 heures</strong>, un WebSocket Tradovate unique n'est pas fait pour vivre indéfiniment, planifiez donc une reconnexion propre.",
        "<strong class='text-white'>Renouvelez le jeton d'accès avant son expiration</strong>, un jeton expiré signifie que votre réautorisation lors de la reconnexion échoue.",
      ],
    },
    { type: "heading",text: "Ce que signifie « le WebSocket Tradovate se déconnecte sans cesse »" },
    { type: "paragraph",html: "Le protocole WebSocket de Tradovate est bavard par conception. Une fois le socket ouvert, le serveur envoie une trame open (<code>o</code>), vous envoyez une trame authorize avec votre jeton d'accès, et à partir de là les deux parties sont censées continuer à échanger. Si le serveur n'entend rien de votre client pendant environ 10 secondes, il suppose que la connexion est morte et la ferme. C'est pourquoi un socket qui &ldquo;fonctionnait il y a une seconde&rdquo; tombe dès que votre code cesse d'envoyer des trames." },
    { type: "paragraph",html: "Voici le piège qui surprend la plupart des développeurs : <strong class='text-white'>une fois abonné à un flux de données en direct, le serveur cesse de vous envoyer ses propres trames de heartbeat</strong>, car les messages de streaming prouvent eux-mêmes que la liaison est active. Votre client, lui, doit toujours prouver qu'<em>il</em> est actif. Si votre flux de données devient silencieux, une séance nocturne calme, un symbole peu échangé, et que votre client n'envoie pas ses propres heartbeats, le serveur ferme le socket alors que rien n'est &ldquo;anormal&rdquo;." },
    { type: "paragraph",html: "En plus du délai d'inactivité, maintenir une seule connexion ouverte pendant <strong class='text-white'>plus de 24 heures</strong> entraîne des déconnexions. Même un client parfaitement sage qui envoie des heartbeats finit donc par être déconnecté s'il ne se reconnecte jamais. Comprendre ces deux horloges, la minuterie d'inactivité d'environ 10 secondes et le plafond de connexion d'environ 24 heures, est la clé d'un flux stable." },
    { type: "heading",text: "Principales causes des déconnexions WebSocket Tradovate en 2026" },
    { type: "heading",text: "1. Pas de heartbeat (ou un heartbeat tardif)" },
    { type: "paragraph",html: "C'est la cause numéro un. Votre client est chargé d'envoyer un heartbeat toutes les 2,5 secondes, une trame dont le texte est exactement <code>[]</code>, afin d'éviter d'être fermé pour inactivité. Si vous manquez la fenêtre, le socket se ferme." },
    { type: "heading",text: "2. Les onglets du navigateur brident votre minuterie" },
    { type: "paragraph",html: "Si votre application s'exécute dans un navigateur et que vous pilotez les heartbeats avec setInterval ou setTimeout, un onglet inactif ou en arrière-plan voit ses minuteries bridées par le navigateur. Vos heartbeats arrivent en retard ou s'arrêtent complètement, et le socket meurt &ldquo;sans raison&rdquo; dès que vous changez d'onglet." },
    { type: "heading",text: "3. Identifiants de requête en double" },
    { type: "paragraph",html: "Chaque requête que vous envoyez porte un identifiant entier dans son champ <code>i</code>. Envoyez deux requêtes avec le même <code>i</code> sur le même socket et vous perturbez l'association requête/réponse, ce qui peut casser la connexion ou vous laisser attendre indéfiniment une réponse qui ne se résout jamais proprement." },
    { type: "heading",text: "4. Envoi de requêtes trop rapide" },
    { type: "paragraph",html: "Si vous lancez une rafale de trames sur le socket, par exemple en vous abonnant à des dizaines de symboles dans une boucle serrée ou en martelant des modifications d'ordres, vous pouvez déclencher la protection anti-inondation de Tradovate et provoquer une déconnexion." },
    { type: "heading",text: "5. Limite de 24 heures atteinte ou jeton expiré" },
    { type: "paragraph",html: "Une connexion maintenue ouverte au-delà d'environ 24 heures est coupée. Dans le même ordre d'idées, le jeton d'accès de votre session expire (les jetons d'accès Tradovate ont une durée de vie courte, de l'ordre de 90 minutes) : si vous tentez de réautoriser un socket reconnecté avec un jeton périmé, l'authentification échoue et vous restez déconnecté." },
    { type: "heading",text: "Comment corriger les déconnexions WebSocket Tradovate : pas à pas" },
    { type: "heading",text: "Corriger les heartbeats manquants" },
    {
      type: "steps",
      items: [
        { title: "Démarrer une routine de heartbeat après l'autorisation", html: "Dès que votre socket est autorisé, démarrez une routine de heartbeat." },
        { title: "Envoyer le tableau vide toutes les 2,5 s", html: "Toutes les 2,5 secondes (2500 ms), envoyez une trame contenant un tableau vide <code>[]</code> avec la méthode send standard du WebSocket." },
        { title: "Continuer d'envoyer même pendant le streaming", html: "Continuez d'envoyer des heartbeats <strong class='text-white'>même pendant la diffusion de données de marché</strong>, ne supposez pas que le silence du serveur signifie que la liaison est saine. Lorsque des données en direct circulent, le serveur cesse d'envoyer ses propres heartbeats, si bien que les vôtres sont la seule chose qui maintient le socket ouvert pendant les périodes calmes." },
        { title: "Le traiter en « envoyer et oublier »", html: "Traitez le heartbeat en « envoyer et oublier ». Il ne porte aucun identifiant de requête et n'attend aucune réponse." },
      ],
    },
    { type: "heading",text: "Corriger le bridage des onglets du navigateur" },
    {
      type: "steps",
      items: [
        { title: "Ne plus compter uniquement sur setInterval", html: "Cessez de vous reposer uniquement sur setInterval / setTimeout pour les heartbeats dans un navigateur." },
        { title: "Utiliser une approche basée sur l'horodatage", html: "Utilisez plutôt une approche <strong class='text-white'>basée sur l'horodatage</strong> : à chaque message entrant, enregistrez l'heure actuelle et comparez-la à l'heure du dernier heartbeat. Si plus de 2500 ms se sont écoulées, envoyez immédiatement une trame de heartbeat." },
        { title: "Sortir la minuterie du thread principal", html: "Pour les applications qui doivent survivre à de longues périodes sans données entrantes dans un onglet en arrière-plan, déplacez la minuterie dans un <strong class='text-white'>Web Worker</strong> (qui n'est pas bridé de la même façon), ou exécutez le socket dans un processus Node.js côté serveur, où la notion d'onglet inactif n'existe pas." },
      ],
    },
    { type: "heading",text: "Corriger les identifiants de requête en double" },
    {
      type: "steps",
      items: [
        { title: "Maintenir un seul compteur incrémental", html: "Maintenez un seul compteur strictement croissant pour le champ <code>i</code> sur chaque socket." },
        { title: "Réserver les identifiants bas pour la configuration", html: "Réservez les identifiants bas utilisés par le protocole pour la configuration (l'autorisation et la requête de synchronisation initiale) et faites démarrer votre compteur général au-dessus." },
        { title: "Incrémenter de façon atomique", html: "Incrémentez le compteur de façon <strong class='text-white'>atomique</strong> afin que deux tâches asynchrones ne puissent jamais obtenir la même valeur. Dans un code multithread ou fortement concurrent, protégez le compteur par un verrou, une fermeture (closure) ou une structure thread-safe." },
        { title: "Ne jamais réutiliser un identifiant lors d'une nouvelle tentative", html: "N'écrivez jamais le même identifiant deux fois à la main. Si vous retentez une requête, donnez à la nouvelle tentative un identifiant neuf." },
      ],
    },
    { type: "heading",text: "Corriger les inondations de requêtes et la limite de 24 heures" },
    {
      type: "steps",
      items: [
        { title: "Limiter les trames sortantes", html: "Mettez vos requêtes en file d'attente et libérez-les à un rythme régulier au lieu de les envoyer en rafale. Espacer les abonnements et les actions sur ordres vous maintient sous la tolérance du socket." },
        { title: "Planifier une reconnexion proactive", html: "N'attendez pas la coupure d'environ 24 heures. Reconnectez-vous selon votre propre calendrier (bien en deçà de 24 heures), renvoyez la trame authorize et réabonnez-vous à vos flux pour que la transition soit fluide." },
        { title: "Renouveler d'abord le jeton", html: "Suivez l'expiration de votre jeton d'accès et renouvelez-le <em>avant</em> qu'il n'expire, afin que la réautorisation lors de la reconnexion utilise toujours un jeton valide. Les durées exactes des jetons sont fixées par Tradovate et peuvent changer, consultez la documentation actuelle de l'API plutôt que de coder un nombre en dur." },
        { title: "Récupérer automatiquement après chaque fermeture inattendue", html: "Traitez chaque fermeture inattendue comme une erreur et récupérez automatiquement. Sauf si vous arrêtez volontairement, rouvrez le socket, réautorisez-vous et réabonnez-vous automatiquement. Ajoutez un délai d'attente sur les réponses en attente afin qu'une requête bloquée ne paralyse jamais tout votre client." },
      ],
    },
    { type: "heading",text: "Tableau de dépannage" },
    { type: "table", headers: ["Symptôme / erreur","Ce que cela signifie","Correctif"], rows: [
