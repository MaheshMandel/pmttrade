---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "lost-authenticator-no-backup-2fa";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/debugging/${SLUG}`;

const META_TITLE = "Tradovate 2FA Lockout: Lost Authenticator, No Backup";
const META_DESCRIPTION =
  "Lost your authenticator app and locked out of two-factor login? Here's how to regain account access and set up backup 2FA methods to prevent it.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Tradovate-2FA-Sperre: Authenticator verloren, kein Backup", es: "Bloqueo de 2FA en Tradovate: authenticator perdido, sin copia de seguridad", fr: "Blocage 2FA Tradovate : authenticator perdu, aucune sauvegarde", it: "Blocco 2FA su Tradovate: authenticator perso, nessun backup" },
  dek: { en: "You wiped your old phone, and the authenticator that guards your login went with it. There's no backup method, and no code will get you in. Here's the real fix, and how to make sure one lost phone never locks you out again.", de: "Sie haben Ihr altes Handy zurückgesetzt, und der Authenticator, der Ihren Login schützt, ist damit verschwunden. Es gibt keine Backup-Methode, und kein Code lässt Sie herein. Hier ist die echte Lösung und wie Sie dafür sorgen, dass ein verlorenes Handy Sie nie wieder aussperrt.", es: "Usted restableció su teléfono antiguo y el authenticator que protege su inicio de sesión se fue con él. No hay método de respaldo y ningún código le dejará entrar. Esta es la solución real y cómo asegurarse de que un teléfono perdido nunca vuelva a dejarle fuera.", fr: "Vous avez réinitialisé votre ancien téléphone, et l'authenticator qui protège votre connexion est parti avec lui. Il n'existe aucune méthode de secours, et aucun code ne vous fera entrer. Voici la vraie solution, et comment vous assurer qu'un téléphone perdu ne vous bloquera plus jamais.", it: "Ha reimpostato il suo vecchio telefono e l'authenticator che protegge il suo login se n'è andato con lui. Non c'è alcun metodo di backup e nessun codice la farà entrare. Ecco la vera soluzione e come assicurarsi che un telefono perso non la blocchi mai più." },
  readTime: { en: "7 min read", de: "7 Min. Lesezeit", es: "Lectura de 7 min", fr: "Lecture : 7 min", it: "Lettura di 7 min" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "You wiped your old phone, switched to a new one, and only now realize your authenticator app didn't come with it. The login screen wants a six-digit code you can't produce, there's no &ldquo;email me a code instead&rdquo; link, and you never set a backup method. Your account, your balance, maybe an open position, all sit behind a wall you built yourself." },
    { type: "paragraph", html: "It's a bad feeling, but it's a solvable one. This isn't a hacked account or a corrupted login. It's a verification gap, and there are exactly two things that matter now: getting back in, and making sure you never end up here again." },
    { type: "quote", html: "<strong class='text-white'>Short version:</strong> If you're already locked out with no backup method, you can't fix this from the login screen. Contact Tradovate customer service, verify that you own the account, and ask them to reset your two-factor authentication. Once you're back in, turn on at least two 2FA methods and register a trusted device so a single lost phone can't do this again." },
    { type: "heading", text: "Why a lost authenticator locks you out completely" },
    { type: "paragraph", html: "Two-factor authentication works by demanding something you know (your password) plus something you have (a code from your authenticator, a security key, a trusted device, or an SMS). That second factor is the whole point. It's supposed to stop anyone who steals your password from getting in." },
    { type: "paragraph", html: "The catch is that the system can't tell the difference between an attacker who doesn't have your second factor and you after you've lost it. From the login screen's side, both look identical: correct password, no valid code. So it does exactly what it's designed to do and refuses entry. There's no secret bypass, and honestly you wouldn't want one, because a bypass would defeat the entire security model." },
    { type: "paragraph", html: "When you enabled 2FA, you likely picked a single method, an authenticator app, and skipped past the prompt to add a backup. That's the trap. A time-based one-time password app like Google Authenticator stores its secret key on the device itself. Unless you backed that key up or migrated it, wiping or losing the phone erases it for good. The codes it generated are gone, and there's no way to regenerate them without the original secret." },
    { type: "heading", text: "Step 1: Confirm what you actually still have" },
    { type: "paragraph", html: "Before you assume the worst, take two minutes to check whether any working method survives. People forget they set more than one. Any of the following can get you in without a support ticket:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>A trusted device.</strong> If you previously marked a browser or computer as trusted, logging in from that exact machine may skip the code prompt entirely. Try your usual desktop first.",
        "<strong class='text-white'>A second authenticator install.</strong> Some people scan the 2FA QR code into two apps or two phones. Check any older device or a password manager that stores TOTP codes.",
        "<strong class='text-white'>A security key.</strong> If you registered a hardware key (USB, NFC, or a passkey saved in your password manager or Windows Hello), plug it in and use it.",
        "<strong class='text-white'>SMS.</strong> If you ever enabled text-message codes, the login flow may let you request one to your phone number.",
      ],
    },
    { type: "paragraph", html: "If even one of these works, log in and jump straight to the prevention section below to fix your setup properly. If none of them do, you're genuinely locked out and it's time to contact support." },
    { type: "heading", text: "Step 2: Contact Tradovate customer service to reset your 2FA" },
    { type: "paragraph", html: "This is the real fix when you have no backup. A human on Tradovate's side can verify your identity and reset the two-factor setting on your account, which drops you back to password-only login long enough to reconfigure things. Here's how to reach them:" },
    {
      type: "table",
      headers: ["Channel", "How to use it", "Best for"],
      rows: [
        ["In-app live chat", "Available to Tradovate customers inside the platform (and on the website help widget)", "Fastest first contact if you can reach any signed-in surface"],
        ["Phone", "1 (844) 283-3100", "Urgent lockouts, especially with an open position"],
        ["Email", "support@tradovate.com", "Non-urgent cases and attaching identity documents"],
        ["Support portal", "support.tradovate.com", "Submitting a ticket and tracking the response"],
      ],
    },
    { type: "paragraph", html: "When you reach out, make their job easy. Tell them up front that you've lost your only 2FA method and need it reset. Have your account details ready, the email tied to the account, your account username or ID, and whatever identity confirmation they ask for. Expect them to verify you're the owner before they touch anything. That verification step is a feature, not an obstacle. It's the same protection that's currently keeping a stranger out." },
    { type: "quote", html: "<strong class='text-white'>Open position while locked out?</strong> Say so in your very first message and lead with it on the phone. Market risk doesn't pause while a ticket sits in a queue. If you have any other signed-in device or platform still connected to the account, use it to manage or flatten the position while support works on the reset." },
    { type: "paragraph", html: "One reassurance: a 2FA reset doesn't wipe anything. Your balance, trade history, risk settings, and order records all stay exactly as they were. The only thing that changes is how you prove it's you at the door." },
    { type: "heading", text: "Prop firm and evaluation accounts work differently" },
    { type: "paragraph", html: "If you're logging into a prop firm evaluation or funded account, the reset path may not run through Tradovate at all. Many of those accounts are owned and administered by the firm, and the firm, not Tradovate, controls access recovery. Two-factor requirements, who can reset them, and how long it takes all vary by firm and account type, so check your firm's current rules and open a ticket with them first. Trying Tradovate directly on a firm-owned account usually just bounces you back to the firm anyway." },
    { type: "heading", text: "Step 3: Set up backup 2FA methods so this can't happen again" },
    { type: "paragraph", html: "Once you're back in, don't just re-add a single authenticator and walk away. That's how you end up right back here after your next phone upgrade. Tradovate lets you run several verification methods at once, and the whole idea is redundancy: lose one, fall back to another." },
    { type: "paragraph", html: "Head to your <strong class='text-white'>Application Settings</strong> and open the security area. On that page you'll find the two-factor toggle and, below it, the options to add additional verification steps." },
    { type: "paragraph", html: "Tradovate supports four kinds of second factor, and I'd enable at least two of them:" },
    {
      type: "table",
      headers: ["Method", "What it is", "Why it helps as a backup"],
      rows: [
        ["Authenticator app", "A TOTP app such as Google Authenticator that generates rotating six-digit codes", "Works offline; pick one that supports cloud backup or export so a lost phone isn't fatal"],
        ["Security key", "A hardware key over USB, NFC, or Bluetooth, a passkey in a password manager, or Windows Hello", "Physical and phishing-resistant; hard to lose if it lives on your keyring or in your manager"],
        ["Trusted device", "A browser or machine you've marked as known and authenticated", "Lets your everyday computer skip the code prompt, so a lost phone doesn't strand you"],
        ["SMS code", "A one-time code texted to your phone number", "A simple fallback tied to your number rather than a specific app install"],
      ],
    },
    { type: "paragraph", html: "To add a hardware or passkey option, look for the section that lets you add extra verification steps (labeled along the lines of &ldquo;Add additional verification steps&rdquo;) and choose to add a security key. The platform walks you through registering it. Exact wording and menu labels shift between platform updates, so if a label on your screen doesn't match word for word, look for the closest equivalent under the same security settings and follow the on-screen prompt." },
    { type: "paragraph", html: "Scroll to the bottom of the security page and you'll also find your list of trusted devices, which you can view and manage there. Register the computer you actually trade from. That single step means that even if your phone vanishes tomorrow, your desktop still gets you in while you sort out a replacement authenticator." },
    { type: "heading", text: "A few habits that keep you out of trouble" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Migrate before you wipe.</strong> When you replace a phone, move or re-add your authenticator to the new device before you factory-reset the old one. This is the single most common way people lock themselves out.",
        "<strong class='text-white'>Use an authenticator with backup.</strong> Some TOTP apps sync an encrypted backup to the cloud or let you export your seeds. That turns a lost phone into a minor annoyance instead of a support ticket.",
        "<strong class='text-white'>Keep your account email current.</strong> Recovery and verification lean on the email tied to your account. If it's an old address you can't open, fix that first.",
        "<strong class='text-white'>Store recovery details offline.</strong> If you're issued any backup or recovery information, write it down and keep it somewhere physical and safe, not only inside the same phone that holds your authenticator.",
      ],
    },
    { type: "heading", text: "What about the \"new machine\" 2FA prompt?" },
    { type: "paragraph", html: "Worth separating two things people mix up. Losing your authenticator with no backup is one problem. Getting a &ldquo;you have 2FA enabled and are logging in from a new machine&rdquo; message is a different, milder one. In that second case you usually still have access; Tradovate just emails a device-approval link you need to confirm before the new device can trade. If that's actually your situation, check your inbox (and spam) for the approval email rather than assuming you're locked out." },
    { type: "paragraph", html: "And if your trouble is really the login screen hanging, a failing captcha, or a temporary lock after too many wrong attempts, those have their own fixes, don't assume it's a 2FA problem until you've ruled those out." },
  ], de: [
    { type: "paragraph",html: "Sie haben Ihr altes Handy zurückgesetzt, auf ein neues gewechselt und merken erst jetzt, dass Ihre Authenticator-App nicht mitgekommen ist. Der Login-Bildschirm verlangt einen sechsstelligen Code, den Sie nicht liefern können, es gibt keinen Link &ldquo;Code stattdessen per E-Mail senden&rdquo;, und Sie haben nie eine Backup-Methode eingerichtet. Ihr Konto, Ihr Guthaben, vielleicht eine offene Position, alles liegt hinter einer Mauer, die Sie selbst gebaut haben." },
    { type: "paragraph",html: "Das ist ein schlechtes Gefühl, aber es ist lösbar. Das ist kein gehacktes Konto und kein beschädigter Login. Es ist eine Verifizierungslücke, und jetzt zählen genau zwei Dinge: wieder hineinzukommen und sicherzustellen, dass Sie nie wieder hier landen." },
    { type: "quote",html: "<strong class='text-white'>Kurzfassung:</strong> Wenn Sie bereits ausgesperrt sind und keine Backup-Methode haben, lässt sich das nicht über den Login-Bildschirm beheben. Kontaktieren Sie den Tradovate-Kundenservice, bestätigen Sie, dass Ihnen das Konto gehört, und bitten Sie darum, Ihre Zwei-Faktor-Authentifizierung zurückzusetzen. Sobald Sie wieder drin sind, aktivieren Sie mindestens zwei 2FA-Methoden und registrieren Sie ein vertrauenswürdiges Gerät, damit ein einzelnes verlorenes Handy das nicht noch einmal auslösen kann." },
    { type: "heading",text: "Warum ein verlorener Authenticator Sie komplett aussperrt" },
    { type: "paragraph",html: "Die Zwei-Faktor-Authentifizierung verlangt etwas, das Sie wissen (Ihr Passwort), plus etwas, das Sie haben (einen Code aus Ihrem Authenticator, einen Sicherheitsschlüssel, ein vertrauenswürdiges Gerät oder eine SMS). Dieser zweite Faktor ist der ganze Sinn. Er soll jeden stoppen, der Ihr Passwort stiehlt." },
    { type: "paragraph",html: "Der Haken: Das System kann einen Angreifer ohne Ihren zweiten Faktor nicht von Ihnen unterscheiden, nachdem Sie ihn verloren haben. Aus Sicht des Login-Bildschirms sehen beide identisch aus: richtiges Passwort, kein gültiger Code. Also tut er genau das, wofür er gebaut wurde, und verweigert den Zutritt. Es gibt keine geheime Umgehung, und ehrlich gesagt wollen Sie auch keine, denn eine Umgehung würde das gesamte Sicherheitsmodell aushebeln." },
    { type: "paragraph",html: "Als Sie 2FA aktiviert haben, haben Sie wahrscheinlich eine einzige Methode gewählt, eine Authenticator-App, und die Aufforderung zum Hinzufügen eines Backups übersprungen. Das ist die Falle. Eine App für zeitbasierte Einmalpasswörter wie Google Authenticator speichert ihren geheimen Schlüssel auf dem Gerät selbst. Wenn Sie diesen Schlüssel nicht gesichert oder migriert haben, löscht das Zurücksetzen oder der Verlust des Handys ihn endgültig. Die erzeugten Codes sind weg, und ohne den ursprünglichen Schlüssel lassen sie sich nicht neu erzeugen." },
    { type: "heading",text: "Schritt 1: Prüfen, was Sie tatsächlich noch haben" },
    { type: "paragraph",html: "Bevor Sie vom Schlimmsten ausgehen, nehmen Sie sich zwei Minuten und prüfen Sie, ob noch eine funktionierende Methode übrig ist. Viele vergessen, dass sie mehr als eine eingerichtet haben. Jedes der folgenden Dinge kann Sie ohne Support-Ticket hineinbringen:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Ein vertrauenswürdiges Gerät.</strong> Wenn Sie einen Browser oder Computer zuvor als vertrauenswürdig markiert haben, überspringt der Login von genau diesem Rechner möglicherweise die Code-Abfrage komplett. Probieren Sie zuerst Ihren üblichen Desktop.",
        "<strong class='text-white'>Eine zweite Authenticator-Installation.</strong> Manche scannen den 2FA-QR-Code in zwei Apps oder auf zwei Handys. Prüfen Sie ältere Geräte oder einen Passwortmanager, der TOTP-Codes speichert.",
        "<strong class='text-white'>Ein Sicherheitsschlüssel.</strong> Wenn Sie einen Hardware-Schlüssel registriert haben (USB, NFC oder einen Passkey, der in Ihrem Passwortmanager oder Windows Hello gespeichert ist), stecken Sie ihn an und verwenden Sie ihn.",
        "<strong class='text-white'>SMS.</strong> Wenn Sie je SMS-Codes aktiviert haben, lässt der Login-Ablauf Sie möglicherweise einen an Ihre Telefonnummer anfordern.",
      ],
    },
    { type: "paragraph",html: "Wenn auch nur eine davon funktioniert, melden Sie sich an und springen Sie direkt zum Abschnitt zur Vorbeugung weiter unten, um Ihr Setup richtig zu korrigieren. Wenn keine funktioniert, sind Sie tatsächlich ausgesperrt und es ist Zeit, den Support zu kontaktieren." },
    { type: "heading",text: "Schritt 2: Tradovate-Kundenservice kontaktieren, um die 2FA zurückzusetzen" },
    { type: "paragraph",html: "Das ist die echte Lösung, wenn Sie kein Backup haben. Ein Mensch bei Tradovate kann Ihre Identität verifizieren und die Zwei-Faktor-Einstellung Ihres Kontos zurücksetzen, was Sie lange genug auf einen reinen Passwort-Login zurückstellt, um alles neu einzurichten. So erreichen Sie den Support:" },
    { type: "table", headers: ["Kanal","So nutzen Sie ihn","Am besten für"], rows: [
      ["In-App-Live-Chat","Für Tradovate-Kunden innerhalb der Plattform (und im Hilfe-Widget auf der Website) verfügbar","Schnellster Erstkontakt, wenn Sie irgendeine angemeldete Oberfläche erreichen können"],
      ["Telefon","1 (844) 283-3100","Dringende Sperren, besonders bei offener Position"],
      ["E-Mail","support@tradovate.com","Nicht dringende Fälle und das Anhängen von Ausweisdokumenten"],
      ["Support-Portal","support.tradovate.com","Ein Ticket einreichen und die Antwort verfolgen"],
    ] },
    { type: "paragraph",html: "Machen Sie es dem Support leicht, wenn Sie ihn kontaktieren. Sagen Sie gleich zu Beginn, dass Sie Ihre einzige 2FA-Methode verloren haben und sie zurückgesetzt werden muss. Halten Sie Ihre Kontodaten bereit, die mit dem Konto verknüpfte E-Mail-Adresse, Ihren Benutzernamen oder Ihre Konto-ID und die Identitätsbestätigung, nach der gefragt wird. Rechnen Sie damit, dass man Ihre Eigentümerschaft prüft, bevor etwas angefasst wird. Dieser Verifizierungsschritt ist ein Feature, kein Hindernis. Es ist derselbe Schutz, der gerade einen Fremden draußen hält." },
    { type: "quote",html: "<strong class='text-white'>Offene Position während der Sperre?</strong> Sagen Sie das gleich in Ihrer allerersten Nachricht und stellen Sie es am Telefon an den Anfang. Das Marktrisiko pausiert nicht, während ein Ticket in der Warteschlange liegt. Wenn noch ein anderes angemeldetes Gerät oder eine andere Plattform mit dem Konto verbunden ist, nutzen Sie es, um die Position zu verwalten oder glattzustellen, während der Support am Zurücksetzen arbeitet." },
    { type: "paragraph",html: "Eine Beruhigung: Ein 2FA-Reset löscht nichts. Ihr Guthaben, Ihr Handelsverlauf, Ihre Risikoeinstellungen und Ihre Orderdaten bleiben genau so, wie sie waren. Das Einzige, was sich ändert, ist, wie Sie an der Tür beweisen, dass Sie es sind." },
    { type: "heading",text: "Prop-Firm- und Evaluierungskonten funktionieren anders" },
    { type: "paragraph",html: "Wenn Sie sich bei einem Evaluierungs- oder Funded-Konto einer Prop-Firma anmelden, läuft der Reset-Weg möglicherweise gar nicht über Tradovate. Viele dieser Konten gehören der Firma und werden von ihr verwaltet, und die Firma, nicht Tradovate, kontrolliert die Zugangswiederherstellung. Zwei-Faktor-Anforderungen, wer sie zurücksetzen darf und wie lange es dauert, unterscheiden sich je nach Firma und Kontotyp. Prüfen Sie daher die aktuellen Regeln Ihrer Firma und eröffnen Sie zuerst dort ein Ticket. Bei einem Firmenkonto direkt Tradovate zu kontaktieren, schickt Sie meist ohnehin zurück zur Firma." },
    { type: "heading",text: "Schritt 3: Backup-2FA-Methoden einrichten, damit das nicht wieder passiert" },
    { type: "paragraph",html: "Sobald Sie wieder drin sind, fügen Sie nicht einfach einen einzelnen Authenticator hinzu und gehen weg. So landen Sie nach Ihrem nächsten Handy-Upgrade direkt wieder hier. Tradovate lässt Sie mehrere Verifizierungsmethoden gleichzeitig betreiben, und der ganze Sinn ist Redundanz: Fällt eine aus, greifen Sie auf eine andere zurück." },
    { type: "paragraph",html: "Gehen Sie zu Ihren <strong class='text-white'>Application Settings</strong> und öffnen Sie den Sicherheitsbereich. Auf dieser Seite finden Sie den Zwei-Faktor-Schalter und darunter die Optionen, weitere Verifizierungsschritte hinzuzufügen." },
    { type: "paragraph",html: "Tradovate unterstützt vier Arten des zweiten Faktors, und ich würde mindestens zwei davon aktivieren:" },
    { type: "table", headers: ["Methode","Was es ist","Warum es als Backup hilft"], rows: [
      ["Authenticator-App","Eine TOTP-App wie Google Authenticator, die wechselnde sechsstellige Codes erzeugt","Funktioniert offline; wählen Sie eine mit Cloud-Backup oder Export, damit ein verlorenes Handy nicht fatal ist"],
      ["Sicherheitsschlüssel","Ein Hardware-Schlüssel über USB, NFC oder Bluetooth, ein Passkey in einem Passwortmanager oder Windows Hello","Physisch und phishing-resistent; schwer zu verlieren, wenn er am Schlüsselbund hängt oder in Ihrem Manager liegt"],
      ["Vertrauenswürdiges Gerät","Ein Browser oder Rechner, den Sie als bekannt und authentifiziert markiert haben","Lässt Ihren Alltagscomputer die Code-Abfrage überspringen, sodass ein verlorenes Handy Sie nicht festsetzt"],
      ["SMS-Code","Ein per SMS an Ihre Telefonnummer gesendeter Einmalcode","Ein einfacher Fallback, der an Ihre Nummer statt an eine bestimmte App-Installation gebunden ist"],
    ] },
    { type: "paragraph",html: "Um eine Hardware- oder Passkey-Option hinzuzufügen, suchen Sie den Abschnitt, in dem sich zusätzliche Verifizierungsschritte hinzufügen lassen (etwa mit der Bezeichnung &ldquo;Add additional verification steps&rdquo;), und wählen Sie, einen Sicherheitsschlüssel hinzuzufügen. Die Plattform führt Sie durch die Registrierung. Genauer Wortlaut und Menübezeichnungen ändern sich zwischen Plattform-Updates. Wenn eine Bezeichnung auf Ihrem Bildschirm nicht wortwörtlich übereinstimmt, suchen Sie unter denselben Sicherheitseinstellungen nach dem nächsten Äquivalent und folgen Sie der Anweisung auf dem Bildschirm." },
    { type: "paragraph",html: "Scrollen Sie ans Ende der Sicherheitsseite, dort finden Sie auch Ihre Liste vertrauenswürdiger Geräte, die Sie dort ansehen und verwalten können. Registrieren Sie den Computer, von dem aus Sie tatsächlich handeln. Dieser eine Schritt sorgt dafür, dass Sie selbst bei einem morgen verschwundenen Handy mit Ihrem Desktop hineinkommen, während Sie einen Ersatz-Authenticator organisieren." },
    { type: "heading",text: "Ein paar Gewohnheiten, die Sie vor Ärger bewahren" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Migrieren, bevor Sie zurücksetzen.</strong> Wenn Sie ein Handy ersetzen, übertragen oder richten Sie Ihren Authenticator auf dem neuen Gerät neu ein, bevor Sie das alte auf Werkseinstellungen zurücksetzen. Das ist der häufigste Weg, sich selbst auszusperren.",
        "<strong class='text-white'>Nutzen Sie einen Authenticator mit Backup.</strong> Manche TOTP-Apps synchronisieren ein verschlüsseltes Backup in die Cloud oder lassen Sie Ihre Seeds exportieren. Das macht aus einem verlorenen Handy ein kleines Ärgernis statt eines Support-Tickets.",
        "<strong class='text-white'>Halten Sie Ihre Konto-E-Mail aktuell.</strong> Wiederherstellung und Verifizierung stützen sich auf die mit Ihrem Konto verknüpfte E-Mail-Adresse. Ist es eine alte Adresse, auf die Sie nicht mehr zugreifen können, beheben Sie das zuerst.",
        "<strong class='text-white'>Bewahren Sie Wiederherstellungsdaten offline auf.</strong> Wenn Ihnen Backup- oder Wiederherstellungsinformationen ausgestellt werden, schreiben Sie sie auf und bewahren Sie sie physisch und sicher auf, nicht nur auf demselben Handy, das Ihren Authenticator enthält.",
      ],
    },
    { type: "heading",text: "Und die 2FA-Abfrage bei einem „neuen Rechner“?" },
    { type: "paragraph",html: "Es lohnt sich, zwei Dinge zu trennen, die oft verwechselt werden. Den Authenticator ohne Backup zu verlieren, ist ein Problem. Die Meldung &ldquo;you have 2FA enabled and are logging in from a new machine&rdquo; zu erhalten, ist ein anderes, harmloseres. In diesem zweiten Fall haben Sie meist weiterhin Zugriff. Tradovate sendet lediglich einen Link zur Geräte-Freigabe per E-Mail, den Sie bestätigen müssen, bevor das neue Gerät handeln kann. Wenn das tatsächlich Ihre Situation ist, prüfen Sie Ihren Posteingang (und Spam) auf die Freigabe-E-Mail, statt davon auszugehen, dass Sie ausgesperrt sind." },
    { type: "paragraph",html: "Und wenn Ihr Problem eigentlich ein hängender Login-Bildschirm, ein fehlschlagendes Captcha oder eine vorübergehende Sperre nach zu vielen falschen Versuchen ist, haben diese ihre eigenen Lösungen. Gehen Sie nicht von einem 2FA-Problem aus, bevor Sie diese ausgeschlossen haben." },
  ], es: [
    { type: "paragraph",html: "Usted restableció su teléfono antiguo, cambió a uno nuevo y solo ahora se da cuenta de que su app authenticator no vino con él. La pantalla de inicio de sesión pide un código de seis dígitos que no puede generar, no hay un enlace &ldquo;envíame un código por correo&rdquo; y nunca configuró un método de respaldo. Su cuenta, su saldo, quizá una posición abierta, todo queda tras un muro que usted mismo construyó." },
    { type: "paragraph",html: "Es una mala sensación, pero tiene solución. No es una cuenta hackeada ni un inicio de sesión corrupto. Es una brecha de verificación, y ahora solo importan dos cosas: volver a entrar y asegurarse de no volver a acabar aquí." },
    { type: "quote",html: "<strong class='text-white'>Versión corta:</strong> si ya está bloqueado y sin método de respaldo, no puede solucionarlo desde la pantalla de inicio de sesión. Contacte con el servicio de atención al cliente de Tradovate, verifique que es el titular de la cuenta y pida que restablezcan su autenticación de dos factores. Cuando vuelva a entrar, active al menos dos métodos de 2FA y registre un dispositivo de confianza para que un solo teléfono perdido no pueda repetir esto." },
    { type: "heading",text: "Por qué un authenticator perdido le bloquea por completo" },
    { type: "paragraph",html: "La autenticación de dos factores funciona exigiendo algo que usted sabe (su contraseña) más algo que usted tiene (un código de su authenticator, una llave de seguridad, un dispositivo de confianza o un SMS). Ese segundo factor es todo el sentido. Está pensado para detener a cualquiera que le robe la contraseña." },
    { type: "paragraph",html: "El problema es que el sistema no puede distinguir entre un atacante que no tiene su segundo factor y usted después de haberlo perdido. Desde el punto de vista de la pantalla de inicio de sesión, ambos son idénticos: contraseña correcta, sin código válido. Así que hace exactamente lo que está diseñada para hacer y deniega la entrada. No hay una vía secreta de acceso y, sinceramente, no la querría, porque una vía así destruiría todo el modelo de seguridad." },
    { type: "paragraph",html: "Cuando activó la 2FA, probablemente eligió un solo método, una app authenticator, y se saltó el aviso para añadir un respaldo. Esa es la trampa. Una app de contraseñas de un solo uso basadas en el tiempo como Google Authenticator guarda su clave secreta en el propio dispositivo. A menos que haya respaldado o migrado esa clave, restablecer o perder el teléfono la borra para siempre. Los códigos que generaba han desaparecido y no hay forma de regenerarlos sin la clave original." },
    { type: "heading",text: "Paso 1: Confirme qué le queda realmente" },
    { type: "paragraph",html: "Antes de asumir lo peor, dedique dos minutos a comprobar si sobrevive algún método que funcione. La gente olvida que configuró más de uno. Cualquiera de los siguientes puede dejarle entrar sin un ticket de soporte:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Un dispositivo de confianza.</strong> Si antes marcó un navegador u ordenador como de confianza, iniciar sesión desde esa misma máquina puede omitir por completo la solicitud del código. Pruebe primero con su escritorio habitual.",
        "<strong class='text-white'>Una segunda instalación del authenticator.</strong> Algunas personas escanean el código QR de la 2FA en dos apps o dos teléfonos. Revise cualquier dispositivo antiguo o un gestor de contraseñas que guarde códigos TOTP.",
        "<strong class='text-white'>Una llave de seguridad.</strong> Si registró una llave de hardware (USB, NFC o una passkey guardada en su gestor de contraseñas o en Windows Hello), conéctela y úsela.",
        "<strong class='text-white'>SMS.</strong> Si alguna vez activó los códigos por mensaje de texto, el flujo de inicio de sesión puede permitirle solicitar uno a su número de teléfono.",
      ],
    },
    { type: "paragraph",html: "Si funciona aunque sea uno de ellos, inicie sesión y vaya directamente a la sección de prevención de más abajo para corregir su configuración como es debido. Si ninguno funciona, está realmente bloqueado y es hora de contactar con el soporte." },
    { type: "heading",text: "Paso 2: Contacte con el servicio de atención al cliente de Tradovate para restablecer su 2FA" },
    { type: "paragraph",html: "Esta es la solución real cuando no tiene respaldo. Una persona del lado de Tradovate puede verificar su identidad y restablecer el ajuste de dos factores de su cuenta, lo que le devuelve al inicio de sesión solo con contraseña el tiempo suficiente para reconfigurarlo todo. Así puede contactarles:" },
    { type: "table", headers: ["Canal","Cómo usarlo","Ideal para"], rows: [
      ["Chat en vivo en la app","Disponible para los clientes de Tradovate dentro de la plataforma (y en el widget de ayuda del sitio web)","Primer contacto más rápido si puede acceder a cualquier superficie con sesión iniciada"],
      ["Teléfono","1 (844) 283-3100","Bloqueos urgentes, especialmente con una posición abierta"],
      ["Correo electrónico","support@tradovate.com","Casos no urgentes y adjuntar documentos de identidad"],
      ["Portal de soporte","support.tradovate.com","Enviar un ticket y seguir la respuesta"],
    ] },
    { type: "paragraph",html: "Cuando se ponga en contacto, facilite su trabajo. Dígales desde el principio que ha perdido su único método de 2FA y necesita restablecerlo. Tenga a mano los datos de su cuenta, el correo asociado a la cuenta, su nombre de usuario o ID de cuenta y cualquier confirmación de identidad que le pidan. Espere que verifiquen que es el titular antes de tocar nada. Ese paso de verificación es una característica, no un obstáculo. Es la misma protección que ahora mismo mantiene fuera a un extraño." },
    { type: "quote",html: "<strong class='text-white'>¿Posición abierta mientras está bloqueado?</strong> Dígalo en su primerísimo mensaje y empiece por ello por teléfono. El riesgo de mercado no se detiene mientras un ticket espera en una cola. Si tiene algún otro dispositivo o plataforma con la sesión iniciada y aún conectado a la cuenta, úselo para gestionar o cerrar la posición mientras el soporte trabaja en el restablecimiento." },
    { type: "paragraph",html: "Una tranquilidad: un restablecimiento de 2FA no borra nada. Su saldo, historial de operaciones, ajustes de riesgo y registros de órdenes se quedan exactamente como estaban. Lo único que cambia es cómo demuestra que es usted en la puerta." },
    { type: "heading",text: "Las cuentas de prop firm y de evaluación funcionan de forma distinta" },
    { type: "paragraph",html: "Si inicia sesión en una cuenta de evaluación o financiada de una prop firm, la vía de restablecimiento puede no pasar por Tradovate en absoluto. Muchas de esas cuentas son propiedad de la firma y las administra ella, y es la firma, no Tradovate, quien controla la recuperación del acceso. Los requisitos de dos factores, quién puede restablecerlos y cuánto tarda varían según la firma y el tipo de cuenta, así que consulte las reglas actuales de su firma y abra primero un ticket con ellos. Probar directamente con Tradovate en una cuenta de una firma suele devolverle a la firma de todos modos." },
    { type: "heading",text: "Paso 3: Configure métodos de 2FA de respaldo para que esto no vuelva a pasar" },
    { type: "paragraph",html: "Cuando vuelva a entrar, no se limite a añadir de nuevo un único authenticator y marcharse. Así es como acaba otra vez aquí tras su próxima actualización de teléfono. Tradovate le permite usar varios métodos de verificación a la vez, y toda la idea es la redundancia: si pierde uno, recurra a otro." },
    { type: "paragraph",html: "Vaya a sus <strong class='text-white'>Application Settings</strong> y abra el área de seguridad. En esa página encontrará el interruptor de dos factores y, debajo, las opciones para añadir pasos de verificación adicionales." },
    { type: "paragraph",html: "Tradovate admite cuatro tipos de segundo factor y yo activaría al menos dos de ellos:" },
    { type: "table", headers: ["Método","Qué es","Por qué ayuda como respaldo"], rows: [
      ["App authenticator","Una app TOTP como Google Authenticator que genera códigos rotativos de seis dígitos","Funciona sin conexión; elija una que admita copia en la nube o exportación para que un teléfono perdido no sea fatal"],
      ["Llave de seguridad","Una llave de hardware por USB, NFC o Bluetooth, una passkey en un gestor de contraseñas o Windows Hello","Física y resistente al phishing; difícil de perder si está en su llavero o en su gestor"],
      ["Dispositivo de confianza","Un navegador o equipo que ha marcado como conocido y autenticado","Permite que su ordenador de uso diario omita la solicitud del código, así un teléfono perdido no le deja tirado"],
      ["Código SMS","Un código de un solo uso enviado por mensaje a su número de teléfono","Un respaldo sencillo vinculado a su número en lugar de a una instalación concreta de una app"],
    ] },
    { type: "paragraph",html: "Para añadir una opción de hardware o passkey, busque la sección que permite añadir pasos de verificación adicionales (con una etiqueta parecida a &ldquo;Add additional verification steps&rdquo;) y elija añadir una llave de seguridad. La plataforma le guía en el registro. La redacción exacta y las etiquetas de menú cambian entre actualizaciones de la plataforma, así que si una etiqueta en su pantalla no coincide palabra por palabra, busque el equivalente más cercano dentro de la misma configuración de seguridad y siga la indicación en pantalla." },
    { type: "paragraph",html: "Desplácese hasta el final de la página de seguridad y también encontrará su lista de dispositivos de confianza, que puede ver y gestionar allí. Registre el ordenador desde el que opera realmente. Ese único paso significa que, aunque su teléfono desaparezca mañana, su escritorio le seguirá dejando entrar mientras consigue un authenticator de reemplazo." },
    { type: "heading",text: "Algunos hábitos que le evitan problemas" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Migre antes de borrar.</strong> Cuando cambie de teléfono, traslade o vuelva a añadir su authenticator al dispositivo nuevo antes de restablecer de fábrica el antiguo. Esta es la forma más común de bloquearse a uno mismo.",
        "<strong class='text-white'>Use un authenticator con copia de seguridad.</strong> Algunas apps TOTP sincronizan una copia cifrada en la nube o le permiten exportar sus semillas. Eso convierte un teléfono perdido en una molestia menor en lugar de un ticket de soporte.",
        "<strong class='text-white'>Mantenga actualizado el correo de su cuenta.</strong> La recuperación y la verificación se apoyan en el correo asociado a su cuenta. Si es una dirección antigua a la que no puede acceder, arréglelo primero.",
        "<strong class='text-white'>Guarde los datos de recuperación sin conexión.</strong> Si le facilitan información de respaldo o recuperación, anótela y guárdela en un lugar físico y seguro, no solo dentro del mismo teléfono que contiene su authenticator.",
      ],
    },
    { type: "heading",text: "¿Y la solicitud de 2FA de «equipo nuevo»?" },
    { type: "paragraph",html: "Conviene separar dos cosas que la gente confunde. Perder su authenticator sin respaldo es un problema. Recibir un mensaje &ldquo;you have 2FA enabled and are logging in from a new machine&rdquo; es otro distinto y más leve. En ese segundo caso normalmente sigue teniendo acceso; Tradovate simplemente envía por correo un enlace de aprobación del dispositivo que debe confirmar antes de que el equipo nuevo pueda operar. Si esa es realmente su situación, revise su bandeja de entrada (y el spam) en busca del correo de aprobación en lugar de asumir que está bloqueado." },
    { type: "paragraph",html: "Y si su problema es en realidad que la pantalla de inicio de sesión se cuelga, un captcha que falla o un bloqueo temporal tras demasiados intentos erróneos, esos tienen sus propias soluciones; no asuma que es un problema de 2FA hasta haberlos descartado." },
  ], fr: [
    { type: "paragraph",html: "Vous avez réinitialisé votre ancien téléphone, êtes passé à un nouveau et ne réalisez que maintenant que votre application authenticator n'a pas suivi. L'écran de connexion réclame un code à six chiffres que vous ne pouvez pas fournir, il n'y a pas de lien &ldquo;envoyez-moi plutôt un code par e-mail&rdquo;, et vous n'avez jamais configuré de méthode de secours. Votre compte, votre solde, peut-être une position ouverte, tout se trouve derrière un mur que vous avez construit vous-même." },
    { type: "paragraph",html: "C'est une mauvaise sensation, mais le problème se résout. Ce n'est ni un compte piraté ni une connexion corrompue. C'est une faille de vérification, et seules deux choses comptent maintenant : y retourner, et vous assurer de ne plus jamais vous retrouver ici." },
    { type: "quote",html: "<strong class='text-white'>En bref :</strong> si vous êtes déjà bloqué sans méthode de secours, vous ne pouvez pas régler cela depuis l'écran de connexion. Contactez le service client de Tradovate, vérifiez que vous êtes titulaire du compte et demandez la réinitialisation de votre authentification à deux facteurs. Une fois de retour, activez au moins deux méthodes 2FA et enregistrez un appareil de confiance pour qu'un seul téléphone perdu ne puisse plus recommencer." },
    { type: "heading",text: "Pourquoi la perte d'un authenticator vous bloque complètement" },
    { type: "paragraph",html: "L'authentification à deux facteurs exige quelque chose que vous connaissez (votre mot de passe) plus quelque chose que vous possédez (un code de votre authenticator, une clé de sécurité, un appareil de confiance ou un SMS). Ce second facteur est tout l'intérêt. Il est censé arrêter quiconque vole votre mot de passe." },
    { type: "paragraph",html: "Le hic, c'est que le système ne peut pas distinguer un attaquant qui n'a pas votre second facteur de vous-même après l'avoir perdu. Du point de vue de l'écran de connexion, les deux se ressemblent : bon mot de passe, aucun code valide. Il fait donc exactement ce pour quoi il est conçu et refuse l'accès. Il n'existe aucun contournement secret, et honnêtement vous n'en voudriez pas, car un contournement détruirait tout le modèle de sécurité." },
    { type: "paragraph",html: "Lorsque vous avez activé la 2FA, vous avez probablement choisi une seule méthode, une application authenticator, et ignoré l'invite d'ajouter une sauvegarde. C'est le piège. Une application de mots de passe à usage unique basés sur le temps comme Google Authenticator stocke sa clé secrète sur l'appareil lui-même. À moins d'avoir sauvegardé ou migré cette clé, réinitialiser ou perdre le téléphone l'efface définitivement. Les codes qu'elle générait ont disparu, et il est impossible de les régénérer sans la clé d'origine." },
    { type: "heading",text: "Étape 1 : Vérifiez ce qu'il vous reste réellement" },
    { type: "paragraph",html: "Avant de supposer le pire, prenez deux minutes pour vérifier si une méthode fonctionnelle subsiste. On oublie souvent qu'on en a configuré plus d'une. Chacun des éléments suivants peut vous faire entrer sans ticket de support :" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Un appareil de confiance.</strong> Si vous avez déjà marqué un navigateur ou un ordinateur comme appareil de confiance, vous connecter depuis cette machine précise peut contourner entièrement l'invite de code. Essayez d'abord votre ordinateur habituel.",
        "<strong class='text-white'>Une seconde installation de l'authenticator.</strong> Certaines personnes scannent le QR code de la 2FA dans deux applications ou sur deux téléphones. Vérifiez tout ancien appareil ou un gestionnaire de mots de passe qui stocke des codes TOTP.",
        "<strong class='text-white'>Une clé de sécurité.</strong> Si vous avez enregistré une clé matérielle (USB, NFC ou une passkey enregistrée dans votre gestionnaire de mots de passe ou Windows Hello), branchez-la et utilisez-la.",
        "<strong class='text-white'>SMS.</strong> Si vous avez déjà activé les codes par SMS, le parcours de connexion peut vous permettre d'en demander un sur votre numéro de téléphone.",
      ],
    },
    { type: "paragraph",html: "Si ne serait-ce qu'une seule de ces méthodes fonctionne, connectez-vous et passez directement à la section de prévention ci-dessous pour corriger correctement votre configuration. Si aucune ne fonctionne, vous êtes réellement bloqué et il est temps de contacter le support." },
    { type: "heading",text: "Étape 2 : Contactez le service client de Tradovate pour réinitialiser votre 2FA" },
    { type: "paragraph",html: "C'est la vraie solution lorsque vous n'avez pas de sauvegarde. Une personne chez Tradovate peut vérifier votre identité et réinitialiser le paramètre à deux facteurs de votre compte, ce qui vous ramène à une connexion par mot de passe seul le temps de tout reconfigurer. Voici comment les joindre :" },
    { type: "table", headers: ["Canal","Comment l'utiliser","Idéal pour"], rows: [
      ["Chat en direct dans l'application","Disponible pour les clients Tradovate dans la plateforme (et dans le widget d'aide du site web)","Premier contact le plus rapide si vous pouvez accéder à une interface connectée"],
      ["Téléphone","1 (844) 283-3100","Blocages urgents, surtout avec une position ouverte"],
      ["E-mail","support@tradovate.com","Cas non urgents et envoi de pièces d'identité"],
      ["Portail de support","support.tradovate.com","Soumettre un ticket et suivre la réponse"],
    ] },
    { type: "paragraph",html: "Quand vous les contactez, facilitez leur travail. Dites-leur d'emblée que vous avez perdu votre seule méthode 2FA et qu'il faut la réinitialiser. Ayez vos informations de compte sous la main : l'e-mail associé au compte, votre nom d'utilisateur ou identifiant de compte et la confirmation d'identité qu'ils demandent. Attendez-vous à ce qu'ils vérifient que vous êtes le titulaire avant de toucher à quoi que ce soit. Cette étape de vérification est une fonctionnalité, pas un obstacle. C'est la même protection qui tient actuellement un inconnu à l'écart." },
    { type: "quote",html: "<strong class='text-white'>Position ouverte pendant le blocage ?</strong> Dites-le dès votre tout premier message et mettez-le en avant au téléphone. Le risque de marché ne s'arrête pas pendant qu'un ticket attend dans une file. Si vous avez un autre appareil ou une autre plateforme encore connecté(e) au compte, utilisez-le pour gérer ou clôturer la position pendant que le support travaille sur la réinitialisation." },
    { type: "paragraph",html: "Un point rassurant : une réinitialisation 2FA n'efface rien. Votre solde, votre historique de trades, vos paramètres de risque et vos enregistrements d'ordres restent exactement tels quels. La seule chose qui change est la façon dont vous prouvez que c'est bien vous à la porte." },
    { type: "heading",text: "Les comptes de prop firm et d'évaluation fonctionnent différemment" },
    { type: "paragraph",html: "Si vous vous connectez à un compte d'évaluation ou financé d'une prop firm, la voie de réinitialisation peut ne pas passer par Tradovate du tout. Beaucoup de ces comptes appartiennent à la firme et sont administrés par elle, et c'est la firme, et non Tradovate, qui contrôle la récupération d'accès. Les exigences de double authentification, les personnes pouvant la réinitialiser et les délais varient selon la firme et le type de compte ; vérifiez donc les règles actuelles de votre firme et ouvrez d'abord un ticket auprès d'elle. Contacter directement Tradovate pour un compte appartenant à une firme vous renvoie généralement de toute façon vers la firme." },
    { type: "heading",text: "Étape 3 : Configurez des méthodes 2FA de secours pour que cela ne se reproduise pas" },
    { type: "paragraph",html: "Une fois de retour, ne vous contentez pas de rajouter un seul authenticator avant de partir. C'est ainsi que vous vous retrouvez ici après votre prochain changement de téléphone. Tradovate vous permet d'utiliser plusieurs méthodes de vérification à la fois, et toute l'idée est la redondance : si vous en perdez une, repliez-vous sur une autre." },
    { type: "paragraph",html: "Rendez-vous dans vos <strong class='text-white'>Application Settings</strong> et ouvrez la zone de sécurité. Sur cette page, vous trouverez le commutateur à deux facteurs et, en dessous, les options pour ajouter des étapes de vérification supplémentaires." },
    { type: "paragraph",html: "Tradovate prend en charge quatre types de second facteur, et j'en activerais au moins deux :" },
    { type: "table", headers: ["Méthode","De quoi il s'agit","Pourquoi c'est utile comme secours"], rows: [
      ["Application authenticator","Une application TOTP comme Google Authenticator qui génère des codes à six chiffres changeants","Fonctionne hors ligne ; choisissez-en une qui prend en charge la sauvegarde cloud ou l'export pour qu'un téléphone perdu ne soit pas fatal"],
      ["Clé de sécurité","Une clé matérielle via USB, NFC ou Bluetooth, une passkey dans un gestionnaire de mots de passe ou Windows Hello","Physique et résistante à l'hameçonnage ; difficile à perdre si elle est sur votre porte-clés ou dans votre gestionnaire"],
      ["Appareil de confiance","Un navigateur ou une machine que vous avez marqué comme connu et authentifié","Permet à votre ordinateur de tous les jours de contourner l'invite de code, pour qu'un téléphone perdu ne vous laisse pas en plan"],
      ["Code SMS","Un code à usage unique envoyé par SMS à votre numéro de téléphone","Un secours simple lié à votre numéro plutôt qu'à une installation d'application précise"],
    ] },
    { type: "paragraph",html: "Pour ajouter une option matérielle ou passkey, cherchez la section permettant d'ajouter des étapes de vérification supplémentaires (libellée à peu près &ldquo;Add additional verification steps&rdquo;) et choisissez d'ajouter une clé de sécurité. La plateforme vous guide dans l'enregistrement. La formulation exacte et les libellés de menu changent entre les mises à jour de la plateforme ; si un libellé à l'écran ne correspond pas mot pour mot, cherchez l'équivalent le plus proche dans les mêmes paramètres de sécurité et suivez l'invite à l'écran." },
    { type: "paragraph",html: "Faites défiler jusqu'au bas de la page de sécurité et vous y trouverez aussi votre liste d'appareils de confiance, que vous pouvez consulter et gérer à cet endroit. Enregistrez l'ordinateur depuis lequel vous tradez réellement. Cette seule étape signifie que, même si votre téléphone disparaît demain, votre ordinateur vous fait toujours entrer pendant que vous réglez le remplacement de l'authenticator." },
    { type: "heading",text: "Quelques habitudes qui vous évitent des ennuis" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Migrez avant d'effacer.</strong> Lorsque vous remplacez un téléphone, déplacez ou ajoutez de nouveau votre authenticator sur le nouvel appareil avant de réinitialiser l'ancien aux paramètres d'usine. C'est la façon la plus courante de se bloquer soi-même.",
        "<strong class='text-white'>Utilisez un authenticator avec sauvegarde.</strong> Certaines applications TOTP synchronisent une sauvegarde chiffrée dans le cloud ou vous laissent exporter vos clés. Un téléphone perdu devient alors un simple désagrément plutôt qu'un ticket de support.",
        "<strong class='text-white'>Gardez l'e-mail de votre compte à jour.</strong> La récupération et la vérification s'appuient sur l'e-mail associé à votre compte. Si c'est une ancienne adresse à laquelle vous n'avez plus accès, corrigez cela en premier.",
        "<strong class='text-white'>Conservez les informations de récupération hors ligne.</strong> Si on vous fournit des informations de secours ou de récupération, notez-les et gardez-les dans un endroit physique et sûr, pas uniquement dans le même téléphone qui contient votre authenticator.",
      ],
    },
    { type: "heading",text: "Et l'invite 2FA « nouvelle machine » ?" },
    { type: "paragraph",html: "Il vaut la peine de séparer deux choses que l'on confond. Perdre votre authenticator sans sauvegarde est un problème. Recevoir un message &ldquo;you have 2FA enabled and are logging in from a new machine&rdquo; en est un autre, plus bénin. Dans ce second cas, vous avez généralement encore accès ; Tradovate vous envoie simplement par e-mail un lien d'approbation d'appareil que vous devez confirmer avant que le nouvel appareil puisse trader. Si c'est bien votre situation, vérifiez votre boîte de réception (et vos spams) pour l'e-mail d'approbation plutôt que de supposer que vous êtes bloqué." },
    { type: "paragraph",html: "Et si votre problème est en réalité un écran de connexion qui se fige, un captcha en échec ou un verrouillage temporaire après trop de tentatives erronées, ces cas ont leurs propres solutions ; ne supposez pas qu'il s'agit d'un problème de 2FA avant de les avoir écartés." },
  ], it: [
    { type: "paragraph",html: "Ha reimpostato il suo vecchio telefono, è passato a uno nuovo e solo ora si accorge che la sua app authenticator non è venuta con lui. La schermata di login richiede un codice a sei cifre che non può fornire, non c'è un link &ldquo;mi invii invece un codice via e-mail&rdquo; e non ha mai impostato un metodo di backup. Il suo account, il suo saldo, forse una posizione aperta, tutto sta dietro un muro che ha costruito lei stesso." },
    { type: "paragraph",html: "È una brutta sensazione, ma è risolvibile. Non è un account violato né un login corrotto. È una lacuna di verifica e ora contano solo due cose: rientrare e assicurarsi di non ritrovarsi mai più qui." },
    { type: "quote",html: "<strong class='text-white'>In breve:</strong> se è già bloccato e non ha un metodo di backup, non può risolvere dalla schermata di login. Contatti il servizio clienti di Tradovate, verifichi di essere il titolare dell'account e chieda di reimpostare la sua autenticazione a due fattori. Una volta rientrato, attivi almeno due metodi 2FA e registri un dispositivo attendibile, così un solo telefono perso non potrà ripetere tutto questo." },
    { type: "heading",text: "Perché un authenticator perso la blocca completamente" },
    { type: "paragraph",html: "L'autenticazione a due fattori funziona richiedendo qualcosa che lei conosce (la sua password) più qualcosa che lei possiede (un codice dal suo authenticator, una chiave di sicurezza, un dispositivo attendibile o un SMS). Quel secondo fattore è il senso di tutto. Serve a fermare chiunque le rubi la password." },
    { type: "paragraph",html: "Il problema è che il sistema non può distinguere un aggressore che non ha il suo secondo fattore da lei dopo che l'ha perso. Dal punto di vista della schermata di login, i due casi sono identici: password corretta, nessun codice valido. Quindi fa esattamente ciò per cui è progettata e nega l'accesso. Non esiste un bypass segreto e, onestamente, non lo vorrebbe, perché un bypass vanificherebbe l'intero modello di sicurezza." },
    { type: "paragraph",html: "Quando ha attivato la 2FA, probabilmente ha scelto un solo metodo, un'app authenticator, e ha saltato la richiesta di aggiungere un backup. Questa è la trappola. Un'app di password monouso basate sul tempo come Google Authenticator memorizza la propria chiave segreta sul dispositivo stesso. A meno che non abbia fatto il backup o migrato quella chiave, reimpostare o perdere il telefono la cancella per sempre. I codici che generava sono spariti e non c'è modo di rigenerarli senza la chiave originale." },
    { type: "heading",text: "Passaggio 1: Verifichi che cosa le è rimasto davvero" },
    { type: "paragraph",html: "Prima di supporre il peggio, si prenda due minuti per controllare se sopravvive un metodo funzionante. Le persone dimenticano di averne impostato più di uno. Uno qualsiasi dei seguenti può farla entrare senza un ticket di supporto:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Un dispositivo attendibile.</strong> Se in precedenza ha contrassegnato un browser o un computer come attendibile, accedere da quella stessa macchina può saltare del tutto la richiesta del codice. Provi prima con il suo desktop abituale.",
        "<strong class='text-white'>Una seconda installazione dell'authenticator.</strong> Alcune persone scansionano il QR code della 2FA in due app o su due telefoni. Controlli qualsiasi dispositivo più vecchio o un gestore di password che memorizza codici TOTP.",
        "<strong class='text-white'>Una chiave di sicurezza.</strong> Se ha registrato una chiave hardware (USB, NFC o una passkey salvata nel suo gestore di password o in Windows Hello), la colleghi e la usi.",
        "<strong class='text-white'>SMS.</strong> Se ha mai attivato i codici via SMS, il flusso di login potrebbe permetterle di richiederne uno al suo numero di telefono.",
      ],
    },
    { type: "paragraph",html: "Se anche uno solo di questi funziona, acceda e passi direttamente alla sezione sulla prevenzione qui sotto per sistemare correttamente la sua configurazione. Se nessuno funziona, è davvero bloccato ed è il momento di contattare il supporto." },
    { type: "heading",text: "Passaggio 2: Contatti il servizio clienti di Tradovate per reimpostare la sua 2FA" },
    { type: "paragraph",html: "Questa è la vera soluzione quando non ha un backup. Una persona dalla parte di Tradovate può verificare la sua identità e reimpostare l'impostazione a due fattori del suo account, il che la riporta al login con sola password quanto basta per riconfigurare tutto. Ecco come raggiungerli:" },
    { type: "table", headers: ["Canale","Come usarlo","Ideale per"], rows: [
      ["Live chat nell'app","Disponibile per i clienti Tradovate all'interno della piattaforma (e nel widget di assistenza del sito web)","Primo contatto più rapido se riesce ad accedere a una qualsiasi superficie con sessione attiva"],
      ["Telefono","1 (844) 283-3100","Blocchi urgenti, soprattutto con una posizione aperta"],
      ["E-mail","support@tradovate.com","Casi non urgenti e invio di documenti di identità"],
      ["Portale di supporto","support.tradovate.com","Invio di un ticket e monitoraggio della risposta"],
    ] },
    { type: "paragraph",html: "Quando li contatta, renda facile il loro lavoro. Dica fin dall'inizio che ha perso il suo unico metodo 2FA e che deve essere reimpostato. Abbia a portata di mano i dati dell'account, l'e-mail associata all'account, il suo nome utente o ID account e qualsiasi conferma di identità richiesta. Si aspetti che verifichino che lei è il titolare prima di toccare qualsiasi cosa. Quel passaggio di verifica è una funzione, non un ostacolo. È la stessa protezione che in questo momento tiene fuori un estraneo." },
    { type: "quote",html: "<strong class='text-white'>Posizione aperta mentre è bloccato?</strong> Lo dica già nel suo primissimo messaggio e lo metta in apertura al telefono. Il rischio di mercato non si ferma mentre un ticket resta in coda. Se ha un altro dispositivo o un'altra piattaforma ancora connessi all'account, li usi per gestire o chiudere la posizione mentre il supporto lavora alla reimpostazione." },
    { type: "paragraph",html: "Una rassicurazione: una reimpostazione della 2FA non cancella nulla. Il suo saldo, lo storico dei trade, le impostazioni di rischio e i registri degli ordini restano esattamente come erano. L'unica cosa che cambia è il modo in cui dimostra alla porta che è davvero lei." },
    { type: "heading",text: "Gli account prop firm e di valutazione funzionano in modo diverso" },
    { type: "paragraph",html: "Se accede a un account di valutazione o finanziato di una prop firm, il percorso di reimpostazione potrebbe non passare affatto da Tradovate. Molti di quegli account sono di proprietà della firm e da essa amministrati, ed è la firm, non Tradovate, a controllare il recupero dell'accesso. I requisiti dei due fattori, chi può reimpostarli e quanto tempo ci vuole variano in base alla firm e al tipo di account, quindi controlli le regole attuali della sua firm e apra prima un ticket con loro. Rivolgersi direttamente a Tradovate per un account di una firm di solito la rimanda comunque alla firm." },
    { type: "heading",text: "Passaggio 3: Configuri metodi 2FA di backup in modo che non riaccada" },
    { type: "paragraph",html: "Una volta rientrato, non si limiti ad aggiungere di nuovo un solo authenticator e ad andarsene. È così che si ritrova qui dopo il suo prossimo cambio di telefono. Tradovate le permette di usare più metodi di verifica contemporaneamente e tutta l'idea è la ridondanza: se ne perde uno, ripieghi su un altro." },
    { type: "paragraph",html: "Vada nelle sue <strong class='text-white'>Application Settings</strong> e apra l'area della sicurezza. In quella pagina troverà l'interruttore dei due fattori e, sotto, le opzioni per aggiungere ulteriori passaggi di verifica." },
    { type: "paragraph",html: "Tradovate supporta quattro tipi di secondo fattore e io ne attiverei almeno due:" },
    { type: "table", headers: ["Metodo","Che cos'è","Perché aiuta come backup"], rows: [
      ["App authenticator","Un'app TOTP come Google Authenticator che genera codici a sei cifre che cambiano di continuo","Funziona offline; ne scelga una che supporti backup nel cloud o esportazione, così un telefono perso non è fatale"],
      ["Chiave di sicurezza","Una chiave hardware tramite USB, NFC o Bluetooth, una passkey in un gestore di password o Windows Hello","Fisica e resistente al phishing; difficile da perdere se sta nel portachiavi o nel suo gestore"],
      ["Dispositivo attendibile","Un browser o una macchina che ha contrassegnato come noto e autenticato","Permette al suo computer di tutti i giorni di saltare la richiesta del codice, così un telefono perso non la lascia bloccata"],
      ["Codice SMS","Un codice monouso inviato via SMS al suo numero di telefono","Un semplice ripiego legato al suo numero anziché a una specifica installazione di app"],
    ] },
    { type: "paragraph",html: "Per aggiungere un'opzione hardware o passkey, cerchi la sezione che permette di aggiungere ulteriori passaggi di verifica (con un'etichetta simile a &ldquo;Add additional verification steps&rdquo;) e scelga di aggiungere una chiave di sicurezza. La piattaforma la guida nella registrazione. La formulazione esatta e le etichette dei menu cambiano tra un aggiornamento e l'altro della piattaforma, quindi se un'etichetta sul suo schermo non corrisponde parola per parola, cerchi l'equivalente più vicino nelle stesse impostazioni di sicurezza e segua le indicazioni sullo schermo." },
    { type: "paragraph",html: "Scorra fino in fondo alla pagina della sicurezza e troverà anche l'elenco dei suoi dispositivi attendibili, che può visualizzare e gestire lì. Registri il computer da cui fa davvero trading. Quel singolo passaggio significa che, anche se il suo telefono sparisse domani, il suo desktop la farebbe comunque entrare mentre si procura un authenticator sostitutivo." },
    { type: "heading",text: "Alcune abitudini che la tengono lontano dai guai" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Migri prima di cancellare.</strong> Quando sostituisce un telefono, sposti o riaggiunga il suo authenticator sul nuovo dispositivo prima di ripristinare le impostazioni di fabbrica di quello vecchio. È il modo più comune in cui ci si blocca da soli.",
        "<strong class='text-white'>Usi un authenticator con backup.</strong> Alcune app TOTP sincronizzano un backup cifrato nel cloud o le permettono di esportare i seed. Questo trasforma un telefono perso in un fastidio minore anziché in un ticket di supporto.",
        "<strong class='text-white'>Mantenga aggiornata l'e-mail del suo account.</strong> Recupero e verifica si appoggiano all'e-mail associata al suo account. Se è un vecchio indirizzo a cui non può accedere, sistemi prima questo.",
        "<strong class='text-white'>Conservi i dati di recupero offline.</strong> Se le vengono forniti dati di backup o di recupero, li annoti e li tenga in un luogo fisico e sicuro, non solo all'interno dello stesso telefono che contiene il suo authenticator.",
      ],
    },
    { type: "heading",text: "E la richiesta 2FA per un «nuovo computer»?" },
    { type: "paragraph",html: "Vale la pena distinguere due cose che spesso si confondono. Perdere l'authenticator senza backup è un problema. Ricevere un messaggio &ldquo;you have 2FA enabled and are logging in from a new machine&rdquo; è un altro, più lieve. In quel secondo caso di solito ha ancora accesso; Tradovate invia semplicemente via e-mail un link di approvazione del dispositivo che deve confermare prima che il nuovo dispositivo possa operare. Se è davvero la sua situazione, controlli la posta in arrivo (e lo spam) per l'e-mail di approvazione invece di supporre di essere bloccato." },
    { type: "paragraph",html: "E se il suo problema è in realtà la schermata di login che si blocca, un captcha che fallisce o un blocco temporaneo dopo troppi tentativi errati, quelli hanno le loro soluzioni; non supponga che sia un problema di 2FA finché non li ha esclusi." },
  ] },
  ctaHeading: { en: "Don't Let a Login Screen Stall Your Strategy", de: "Lassen Sie einen Login-Bildschirm nicht Ihre Strategie ausbremsen", es: "No deje que una pantalla de inicio de sesión frene su estrategia", fr: "Ne laissez pas un écran de connexion bloquer votre stratégie", it: "Non lasci che una schermata di login blocchi la sua strategia" },
  ctaText: { en: "Once you're back into your account, PickMyTrade automates your Tradovate orders straight from TradingView, so entries and exits fire on signal instead of waiting on you to be logged in and watching.", de: "Sobald Sie wieder in Ihrem Konto sind, automatisiert PickMyTrade Ihre Tradovate-Orders direkt aus TradingView, sodass Ein- und Ausstiege auf Signal ausgelöst werden, statt darauf zu warten, dass Sie eingeloggt sind und zusehen.", es: "Una vez que vuelva a entrar en su cuenta, PickMyTrade automatiza sus órdenes de Tradovate directamente desde TradingView, de modo que las entradas y salidas se disparan con la señal en lugar de esperar a que usted esté conectado y mirando.", fr: "Une fois de retour dans votre compte, PickMyTrade automatise vos ordres Tradovate directement depuis TradingView, de sorte que les entrées et sorties se déclenchent sur signal au lieu d'attendre que vous soyez connecté et devant l'écran.", it: "Una volta rientrato nel suo account, PickMyTrade automatizza i suoi ordini Tradovate direttamente da TradingView, così ingressi e uscite scattano sul segnale invece di aspettare che lei sia connesso e davanti allo schermo." },
  ctaButtonText: { en: "Start Your Free 7-Day Trial", de: "Starten Sie Ihre kostenlose 7-Tage-Testphase", es: "Comience su prueba gratuita de 7 días", fr: "Commencez votre essai gratuit de 7 jours", it: "Inizi la prova gratuita di 7 giorni" },
  ctaUrl: "https://app.pickmytrade.trade/?register=true&utm_source=content&utm_medium=debugging",
  faqHeading: { en: "Frequently Asked Questions", de: "Häufig gestellte Fragen", es: "Preguntas frecuentes", fr: "Questions fréquentes", it: "Domande frequenti" },
  faqs: { en: [
    { q: "Can I recover my account if I lost my authenticator app and set no backup method?", a: "Yes, but not on your own. With no working second factor and no backup configured, the login screen has no way to verify you. Your only path is to contact Tradovate customer service, prove you own the account, and ask them to reset the 2FA. There's no self-service button for this." },
    { q: "What backup 2FA methods does Tradovate support?", a: "Trusted devices, security keys, authenticator apps that generate time-based one-time passwords like Google Authenticator, and SMS codes. Enable more than one so losing a single method doesn't lock you out." },
    { q: "Will resetting my 2FA delete my trades, balance, or open positions?", a: "No. A reset only changes how you verify your identity at login. Your balance, history, and settings stay put. If you're holding a position while locked out, flag it as urgent in your first message so support prioritizes it." },
    { q: "I trade a prop firm or evaluation account. Who do I contact?", a: "It depends on who owns the account. Many evaluation and funded accounts belong to the prop firm, which handles access issues rather than Tradovate. Rules and reset steps vary by firm and account type, so check your firm's current rules and open a ticket with them first." },
    { q: "How do I make sure a lost phone never locks me out again?", a: "Enable at least two verification methods, register the computer you trade from as a trusted device, and store any recovery information somewhere safe and offline. When you switch phones, move or re-add your authenticator before wiping the old one." },
  ], de: [
    { q: "Kann ich mein Konto wiederherstellen, wenn ich meine Authenticator-App verloren und keine Backup-Methode eingerichtet habe?", a: "Ja, aber nicht auf eigene Faust. Ohne funktionierenden zweiten Faktor und ohne eingerichtetes Backup kann der Login-Bildschirm Sie nicht verifizieren. Ihr einziger Weg ist, den Tradovate-Kundenservice zu kontaktieren, nachzuweisen, dass Ihnen das Konto gehört, und um das Zurücksetzen der 2FA zu bitten. Dafür gibt es keine Selbstbedienungsschaltfläche." },
    { q: "Welche Backup-2FA-Methoden unterstützt Tradovate?", a: "Vertrauenswürdige Geräte, Sicherheitsschlüssel, Authenticator-Apps, die zeitbasierte Einmalpasswörter erzeugen, wie Google Authenticator, sowie SMS-Codes. Aktivieren Sie mehr als eine, damit der Verlust einer einzelnen Methode Sie nicht aussperrt." },
    { q: "Löscht das Zurücksetzen meiner 2FA meine Trades, mein Guthaben oder offene Positionen?", a: "Nein. Ein Zurücksetzen ändert nur, wie Sie beim Login Ihre Identität bestätigen. Ihr Guthaben, Ihr Verlauf und Ihre Einstellungen bleiben unverändert. Wenn Sie während der Sperre eine Position halten, kennzeichnen Sie das in Ihrer ersten Nachricht als dringend, damit der Support es priorisiert." },
    { q: "Ich handle ein Prop-Firm- oder Evaluierungskonto. Wen kontaktiere ich?", a: "Das hängt davon ab, wem das Konto gehört. Viele Evaluierungs- und Funded-Konten gehören der Prop-Firma, die Zugangsprobleme statt Tradovate bearbeitet. Regeln und Zurücksetzungsschritte unterscheiden sich je nach Firma und Kontotyp. Prüfen Sie daher die aktuellen Regeln Ihrer Firma und eröffnen Sie zuerst dort ein Ticket." },
    { q: "Wie stelle ich sicher, dass mich ein verlorenes Handy nie wieder aussperrt?", a: "Aktivieren Sie mindestens zwei Verifizierungsmethoden, registrieren Sie den Computer, von dem aus Sie handeln, als vertrauenswürdiges Gerät und bewahren Sie Wiederherstellungsinformationen an einem sicheren Ort offline auf. Wenn Sie das Handy wechseln, übertragen Sie Ihren Authenticator oder richten ihn neu ein, bevor Sie das alte Gerät zurücksetzen." },
  ], es: [
    { q: "¿Puedo recuperar mi cuenta si perdí mi app authenticator y no configuré ningún método de respaldo?", a: "Sí, pero no por su cuenta. Sin un segundo factor que funcione y sin respaldo configurado, la pantalla de inicio de sesión no tiene forma de verificarle. Su único camino es contactar con el servicio de atención al cliente de Tradovate, demostrar que es el titular de la cuenta y pedirles que restablezcan la 2FA. No existe un botón de autoservicio para esto." },
    { q: "¿Qué métodos de 2FA de respaldo admite Tradovate?", a: "Dispositivos de confianza, llaves de seguridad, apps authenticator que generan contraseñas de un solo uso basadas en el tiempo, como Google Authenticator, y códigos por SMS. Active más de uno para que perder un solo método no le deje fuera." },
    { q: "¿Restablecer mi 2FA borrará mis operaciones, mi saldo o mis posiciones abiertas?", a: "No. Un restablecimiento solo cambia cómo verifica su identidad al iniciar sesión. Su saldo, historial y configuración se mantienen. Si mantiene una posición mientras está bloqueado, indíquelo como urgente en su primer mensaje para que el soporte lo priorice." },
    { q: "Opero con una cuenta de prop firm o de evaluación. ¿A quién contacto?", a: "Depende de quién sea el titular de la cuenta. Muchas cuentas de evaluación y financiadas pertenecen a la prop firm, que gestiona los problemas de acceso en lugar de Tradovate. Las reglas y los pasos de restablecimiento varían según la firma y el tipo de cuenta, así que consulte las reglas actuales de su firma y abra primero un ticket con ellos." },
    { q: "¿Cómo me aseguro de que un teléfono perdido nunca vuelva a dejarme fuera?", a: "Active al menos dos métodos de verificación, registre el ordenador desde el que opera como dispositivo de confianza y guarde cualquier información de recuperación en un lugar seguro y sin conexión. Cuando cambie de teléfono, traslade o vuelva a añadir su authenticator antes de borrar el antiguo." },
  ], fr: [
    { q: "Puis-je récupérer mon compte si j'ai perdu mon application authenticator et n'ai configuré aucune méthode de secours ?", a: "Oui, mais pas seul. Sans second facteur fonctionnel et sans sauvegarde configurée, l'écran de connexion n'a aucun moyen de vous vérifier. Votre seule voie est de contacter le service client de Tradovate, de prouver que vous êtes titulaire du compte et de demander la réinitialisation de la 2FA. Il n'existe pas de bouton en libre-service pour cela." },
    { q: "Quelles méthodes 2FA de secours Tradovate prend-il en charge ?", a: "Les appareils de confiance, les clés de sécurité, les applications authenticator qui génèrent des mots de passe à usage unique basés sur le temps comme Google Authenticator, et les codes SMS. Activez-en plus d'une afin que la perte d'une seule méthode ne vous bloque pas." },
    { q: "La réinitialisation de ma 2FA supprimera-t-elle mes trades, mon solde ou mes positions ouvertes ?", a: "Non. Une réinitialisation ne modifie que la façon dont vous vérifiez votre identité à la connexion. Votre solde, votre historique et vos paramètres restent en place. Si vous détenez une position pendant le blocage, signalez-le comme urgent dans votre premier message pour que le support le traite en priorité." },
    { q: "Je trade avec un compte de prop firm ou d'évaluation. Qui dois-je contacter ?", a: "Cela dépend de qui possède le compte. De nombreux comptes d'évaluation et financés appartiennent à la prop firm, qui gère les problèmes d'accès à la place de Tradovate. Les règles et les étapes de réinitialisation varient selon la firme et le type de compte ; vérifiez donc les règles actuelles de votre firme et ouvrez d'abord un ticket auprès d'elle." },
    { q: "Comment m'assurer qu'un téléphone perdu ne me bloquera plus jamais ?", a: "Activez au moins deux méthodes de vérification, enregistrez l'ordinateur depuis lequel vous tradez comme appareil de confiance et conservez les informations de récupération dans un endroit sûr et hors ligne. Lorsque vous changez de téléphone, déplacez ou ajoutez de nouveau votre authenticator avant d'effacer l'ancien." },
  ], it: [
    { q: "Posso recuperare il mio account se ho perso l'app authenticator e non ho impostato alcun metodo di backup?", a: "Sì, ma non da solo. Senza un secondo fattore funzionante e senza un backup configurato, la schermata di login non ha modo di verificarla. L'unica strada è contattare il servizio clienti di Tradovate, dimostrare di essere il titolare dell'account e chiedere di reimpostare la 2FA. Non esiste un pulsante self-service per questo." },
    { q: "Quali metodi 2FA di backup supporta Tradovate?", a: "Dispositivi attendibili, chiavi di sicurezza, app authenticator che generano password monouso basate sul tempo come Google Authenticator e codici SMS. Ne attivi più di uno, così perdere un solo metodo non la blocca." },
    { q: "Reimpostare la mia 2FA eliminerà i miei trade, il saldo o le posizioni aperte?", a: "No. Una reimpostazione cambia solo il modo in cui verifica la sua identità al login. Il suo saldo, lo storico e le impostazioni restano al loro posto. Se detiene una posizione mentre è bloccato, la segnali come urgente nel primo messaggio, in modo che il supporto le dia priorità." },
    { q: "Opero con un account prop firm o di valutazione. Chi devo contattare?", a: "Dipende da chi possiede l'account. Molti account di valutazione e finanziati appartengono alla prop firm, che gestisce i problemi di accesso al posto di Tradovate. Regole e passaggi di reimpostazione variano in base alla firm e al tipo di account, quindi controlli le regole attuali della sua firm e apra prima un ticket con loro." },
    { q: "Come faccio a essere sicuro che un telefono perso non mi blocchi mai più?", a: "Attivi almeno due metodi di verifica, registri il computer da cui fa trading come dispositivo attendibile e conservi le informazioni di recupero in un luogo sicuro e offline. Quando cambia telefono, sposti o riaggiunga il suo authenticator prima di cancellare quello vecchio." },
  ] },
