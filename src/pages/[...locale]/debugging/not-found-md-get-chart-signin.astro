---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "not-found-md-get-chart-signin";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/debugging/${SLUG}`;

const META_TITLE = "Tradovate 'Not Found: md/get chart' at Sign-In";
const META_DESCRIPTION =
  "Fix the 'Not Found: md/get chart' sign-in error by clearing cache and cookies, restarting or updating the app, disabling extensions, or reinstalling.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate API", de: "Tradovate API", es: "Tradovate API", fr: "Tradovate API", it: "Tradovate API" },
  h1: { en: META_TITLE, de: "Tradovate 'Not Found: md/get chart' bei der Anmeldung", es: "Tradovate 'Not Found: md/get chart' al iniciar sesión", fr: "Tradovate 'Not Found: md/get chart' à la connexion", it: "Tradovate 'Not Found: md/get chart' all'accesso" },
  dek: { en: "The desktop app throws a red “Not Found: md/get chart” banner at sign-in, but the mobile app loads the same charts perfectly. That mismatch tells you exactly where the problem is, and it's almost always a stale cache.", de: "Die Desktop-App zeigt bei der Anmeldung ein rotes Banner „Not Found: md/get chart“, während die mobile App dieselben Charts einwandfrei lädt. Dieser Unterschied verrät Ihnen genau, wo das Problem liegt, und fast immer ist es ein veralteter Cache.", es: "La aplicación de escritorio muestra un banner rojo “Not Found: md/get chart” al iniciar sesión, pero la aplicación móvil carga los mismos gráficos sin problemas. Esa diferencia le dice exactamente dónde está el problema, y casi siempre es una caché obsoleta.", fr: "L'application de bureau affiche une bannière rouge « Not Found: md/get chart » à la connexion, alors que l'application mobile charge les mêmes graphiques sans problème. Ce décalage vous indique exactement où se situe le problème, et c'est presque toujours un cache périmé.", it: "L'app desktop mostra un banner rosso “Not Found: md/get chart” all'accesso, mentre l'app mobile carica gli stessi grafici senza problemi. Questa differenza Le indica esattamente dove si trova il problema, e quasi sempre si tratta di una cache obsoleta." },
  readTime: { en: "6 min read", de: "6 Min. Lesezeit", es: "Lectura de 6 min", fr: "Lecture : 6 min", it: "Lettura di 6 min" },
  lastUpdated: "2026-07-10",
  blocks: { en: [
    { type: "paragraph", html: "You open the desktop app, log in, and instead of your charts you get a red <strong class='text-white'>Not Found: md/get chart</strong> banner. Then you grab your phone, open the mobile app, and everything loads perfectly. Frustrating, but that mismatch is actually the good news: it tells you exactly where the problem is. Your account, your data subscription, and the exchange feed are all fine, the fault is sitting on your desktop, in the app or the browser you're signing in with. The <code>md/getChart</code> request is how the platform pulls your chart data as it loads, and “Not Found” just means that request didn't come back cleanly this time. In almost every case it's a stale cache or a bad session, and it clears with a few minutes of housekeeping. Here's how to fix it and stop it from coming back." },
    {
      type: "checklist",
      heading: "Quick Checklist",
      items: [
        "<strong class='text-white'>Confirm it's desktop-only</strong>, if the mobile app loads charts fine, your account and data feed are healthy, so focus on the desktop.",
        "<strong class='text-white'>Fully quit and relaunch the app</strong>, a clean restart clears the most common transient glitch.",
        "<strong class='text-white'>Clear cache and cookies</strong>, for the desktop app's stored data, or for the Tradovate site if you use a browser.",
        "<strong class='text-white'>Update to the current version</strong>, an outdated build is a frequent cause of chart requests failing.",
        "<strong class='text-white'>Disable extensions / test incognito</strong>, ad and script blockers can break the market-data request in a browser.",
        "<strong class='text-white'>Reinstall if it persists</strong>, a fresh install replaces a corrupted build and wipes its local storage in one step.",
      ],
    },
    { type: "heading", text: "What “Not Found: md/get chart” Actually Means" },
    { type: "paragraph", html: "<code>md/getChart</code> is a market-data request. “md” is short for market data, and <code>getChart</code> is the specific call the platform fires to fetch the bars for the chart you're opening. When you sign in, the app runs a burst of these requests to paint your workspace. If one of them comes back with <strong class='text-white'>Not Found</strong> instead of chart data, you get the error banner and an empty or missing chart." },
    { type: "paragraph", html: "The important thing is what this error is <em>not</em>. It's not a billing problem, it's not your login being wrong, and, when mobile works, it's not your market-data subscription. A subscription gap would starve every device of quotes, not throw a one-off “Not Found” on desktop while your phone streams live. So treat this as a local desktop hiccup: the request left your machine in a state the server couldn't answer, usually because the app was working from a stale or corrupted cache, an outdated build, or a session that got tangled." },
    { type: "heading", text: "Top Causes in 2026" },
    { type: "heading", text: "1. A stale or corrupted cache" },
    { type: "paragraph", html: "The desktop app and the browser both cache data to load your workspace faster. When that cached data gets out of date or corrupts, often after an app update, a forced quit, or a network drop mid-session, the chart request can point at something that's no longer valid and come back Not Found. This is the single most common cause, and it's why a cache clear fixes it so often." },
    { type: "heading", text: "2. An outdated app or browser version" },
    { type: "paragraph", html: "Tradovate ships fixes and performance improvements regularly. If your desktop app or browser has fallen behind, the chart-loading request it sends may not line up with what the current servers expect. Keeping the app and browser on their latest versions is the baseline cure for a whole class of loading errors, this one included." },
    { type: "heading", text: "3. A browser extension getting in the way" },
    { type: "paragraph", html: "If you run the platform in a browser rather than the desktop app, ad blockers, script blockers, and privacy extensions are prime suspects. They can silently block or rewrite the market-data request that loads charts, and the result surfaces as Not Found. The dedicated desktop app runs in its own self-contained environment with none of your browser extensions loaded, which is exactly why it's often more stable than the browser." },
    { type: "heading", text: "4. A leftover or conflicting session" },
    { type: "paragraph", html: "Tradovate limits how many active sessions you can hold at once across web, desktop, mobile, and TradingView. If old sessions are still hanging around, or you're signed in on several places at once, the desktop sign-in can land in a half-connected state where some data requests never resolve. Signing out everywhere and back in on one device clears it." },
    { type: "heading", text: "How to Fix It: Step-by-Step" },
    {
      type: "steps",
      items: [
        { title: "Restart the app cleanly", html: "Don't just close the window, fully quit the process. On Windows, close the app, then open <strong class='text-white'>Task Manager</strong> (Ctrl+Shift+Esc), find any lingering Tradovate entry, and choose <strong class='text-white'>End task</strong>. On macOS, right-click the dock icon and choose <strong class='text-white'>Quit</strong>, or force-quit from the Apple menu. Relaunch and sign in. A clean restart clears the transient version of this glitch surprisingly often, so it's always the first move." },
        { title: "Clear cache and cookies", html: "If the restart didn't do it, wipe the stale cache. How you do this depends on how you sign in: <strong class='text-white'>Browser:</strong> open your browser settings, clear cached images/files and cookies for the Tradovate site (or clear browsing data for “All time” if you want to be thorough), then reload the platform and log in again. <strong class='text-white'>Desktop app:</strong> the app stores its own cache. If there's a data or cache reset inside the app's settings, use it; otherwise reinstalling accomplishes the same thing by wiping local storage. Heads up: clearing cookies signs you out, so have your credentials ready. Your saved workspaces and chart templates live server-side against your account, so they reload once you log back in, you're only clearing the local junk, not your setup." },
        { title: "Update the app and browser", html: "Make sure you're on the current version. For the desktop app, check for an update prompt on launch or download the latest build from the official site and install over the old one. For the browser, update it to the newest release. Running the latest version removes the “old build talking to new servers” mismatch that throws chart errors." },
        { title: "Disable extensions or test incognito (browser only)", html: "If you're in a browser, open a <strong class='text-white'>private/incognito window</strong> and sign in there. Incognito runs with extensions off by default, so if the charts load cleanly, an extension is your culprit. Go back to your normal window and disable ad blockers, script blockers, and privacy extensions for the Tradovate site one at a time until you find the one causing trouble. If you'd rather skip the whole issue, switch to the dedicated desktop app, which doesn't load browser extensions at all." },
        { title: "Reinstall the desktop app", html: "If it's still throwing the error, reinstall. This replaces a possibly corrupted or outdated build and wipes its local storage in one clean sweep, it's the most reliable fix when the lighter steps don't stick. Uninstall the Tradovate desktop app the normal way for your OS, download the current version from the official Tradovate download page, and install it fresh. While you're at it, if the problem started right after signing in on several devices, sign out of every session, web, desktop, mobile, and any TradingView connection, then sign back in on just this one machine to clear a session conflict." },
        { title: "Rule out a platform issue", html: "If you've cleared cache, updated, reinstalled, and it still won't load, and especially if other people are hitting the same wall at the same time, check the official status page at <code>status.tradovate.com</code>. A wider outage or maintenance window is out of your hands and just needs waiting out. If the status page is green and the error only affects your desktop, it's still a local issue and reinstalling is your best lever." },
      ],
    },
    { type: "heading", text: "Troubleshooting Table" },
    {
      type: "table",
      headers: ["Situation", "Likely Cause", "Fix"],
      rows: [
        ["Error on desktop, mobile works fine", "Local cache or session glitch on desktop", "Restart cleanly, clear cache/cookies, then reinstall if needed"],
        ["Started after an app update or forced quit", "Stale or corrupted cache", "Clear cache and cookies, or reinstall to wipe local storage"],
        ["Charts load in incognito but not normally", "A browser extension blocking the request", "Disable ad/script/privacy extensions for the site, or use the desktop app"],
        ["App feels behind on features", "Outdated build", "Update the desktop app and browser to the latest version"],
        ["Signed in on several devices at once", "Session conflict / limit reached", "Sign out everywhere, then sign in on one device"],
        ["Everyone is affected at the same time", "Platform outage or maintenance", "Check status.tradovate.com and wait it out"],
      ],
    },
    { type: "heading", text: "Keep Your Automation Running with PickMyTrade" },
    { type: "paragraph", html: "A blank chart on the desktop is annoying on its own, but if you trade a strategy that fires from those charts, a sign-in glitch can mean missed entries and exits while you're busy reinstalling. PickMyTrade takes that dependency off your desktop:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Server-side execution</strong>, your TradingView alerts route to Tradovate through PickMyTrade's infrastructure, so your trades don't wait on your desktop app painting charts correctly.",
        "<strong class='text-white'>Runs while you troubleshoot</strong>, clear your cache, update, and reinstall without your automation going dark, because the order flow doesn't live on your machine.",
        "<strong class='text-white'>Multi-account sync</strong>, mirror the same managed orders across accounts, so one glitchy desktop session doesn't leave positions unmanaged.",
        "<strong class='text-white'>Prop-firm-aware routing</strong>, respects your account's risk and data-agreement state so recovered orders don't get rejected.",
      ],
    },
  ], de: [
    { type: "paragraph",html: "Sie öffnen die Desktop-App, melden sich an und statt Ihrer Charts erscheint ein rotes Banner <strong class='text-white'>Not Found: md/get chart</strong>. Dann greifen Sie zum Smartphone, öffnen die mobile App, und alles lädt einwandfrei. Frustrierend, aber genau dieser Unterschied ist die gute Nachricht: Er verrät Ihnen, wo das Problem liegt. Ihr Konto, Ihr Datenabonnement und der Börsenfeed sind in Ordnung, der Fehler sitzt auf Ihrem Desktop, in der App oder dem Browser, mit dem Sie sich anmelden. Die Anfrage <code>md/getChart</code> ist die Art, wie die Plattform Ihre Chartdaten beim Laden abruft, und „Not Found“ bedeutet lediglich, dass diese Anfrage diesmal nicht sauber zurückkam. In nahezu allen Fällen ist es ein veralteter Cache oder eine fehlerhafte Sitzung, und mit ein paar Minuten Aufräumarbeit ist es behoben. So beheben Sie es und verhindern, dass es wiederkommt." },
    {
      type: "checklist",
      heading: "Kurz-Checkliste",
      items: [
        "<strong class='text-white'>Bestätigen Sie, dass es nur den Desktop betrifft</strong>, wenn die mobile App Charts einwandfrei lädt, sind Ihr Konto und Ihr Datenfeed gesund, konzentrieren Sie sich also auf den Desktop.",
        "<strong class='text-white'>App vollständig beenden und neu starten</strong>, ein sauberer Neustart behebt die häufigste vorübergehende Störung.",
        "<strong class='text-white'>Cache und Cookies löschen</strong>, für die gespeicherten Daten der Desktop-App oder für die Tradovate-Website, wenn Sie einen Browser nutzen.",
        "<strong class='text-white'>Auf die aktuelle Version aktualisieren</strong>, eine veraltete Version ist eine häufige Ursache für fehlschlagende Chartanfragen.",
        "<strong class='text-white'>Erweiterungen deaktivieren / Inkognito testen</strong>, Werbe- und Skriptblocker können im Browser die Marktdatenanfrage stören.",
        "<strong class='text-white'>Bei anhaltendem Fehler neu installieren</strong>, eine frische Installation ersetzt eine beschädigte Version und löscht den lokalen Speicher in einem Schritt.",
      ],
    },
    { type: "heading",text: "Was „Not Found: md/get chart“ tatsächlich bedeutet" },
    { type: "paragraph",html: "<code>md/getChart</code> ist eine Marktdatenanfrage. „md“ steht für Market Data (Marktdaten), und <code>getChart</code> ist der konkrete Aufruf, mit dem die Plattform die Kerzen für das Chart abruft, das Sie öffnen. Bei der Anmeldung führt die App eine ganze Reihe solcher Anfragen aus, um Ihren Arbeitsbereich aufzubauen. Wenn eine davon statt Chartdaten <strong class='text-white'>Not Found</strong> zurückgibt, erhalten Sie das Fehlerbanner und ein leeres oder fehlendes Chart." },
    { type: "paragraph",html: "Wichtig ist, was dieser Fehler <em>nicht</em> ist. Es ist kein Abrechnungsproblem, es liegt nicht an falschen Zugangsdaten und, wenn die mobile App funktioniert, auch nicht an Ihrem Marktdaten-Abonnement. Eine Abonnementlücke würde alle Geräte ohne Kurse lassen, nicht ein einmaliges „Not Found“ auf dem Desktop, während Ihr Smartphone live streamt. Behandeln Sie es also als lokalen Desktop-Aussetzer: Die Anfrage verließ Ihren Rechner in einem Zustand, den der Server nicht beantworten konnte, meist weil die App mit einem veralteten oder beschädigten Cache, einer veralteten Version oder einer verhedderten Sitzung arbeitete." },
    { type: "heading",text: "Die häufigsten Ursachen 2026" },
    { type: "heading",text: "1. Ein veralteter oder beschädigter Cache" },
    { type: "paragraph",html: "Sowohl die Desktop-App als auch der Browser speichern Daten im Cache, um Ihren Arbeitsbereich schneller zu laden. Wenn diese zwischengespeicherten Daten veralten oder beschädigt werden, oft nach einem App-Update, einem erzwungenen Beenden oder einem Netzwerkabbruch während der Sitzung, kann die Chartanfrage auf etwas zeigen, das nicht mehr gültig ist, und mit Not Found antworten. Das ist mit Abstand die häufigste Ursache, und deshalb behebt das Leeren des Caches es so oft." },
    { type: "heading",text: "2. Eine veraltete App- oder Browser-Version" },
    { type: "paragraph",html: "Tradovate liefert regelmäßig Fehlerbehebungen und Leistungsverbesserungen aus. Wenn Ihre Desktop-App oder Ihr Browser zurückliegt, passt die gesendete Chart-Ladeanfrage möglicherweise nicht zu dem, was die aktuellen Server erwarten. App und Browser auf dem neuesten Stand zu halten, ist die Grundlösung für eine ganze Klasse von Ladefehlern, auch für diesen." },
    { type: "heading",text: "3. Eine störende Browser-Erweiterung" },
    { type: "paragraph",html: "Wenn Sie die Plattform im Browser statt in der Desktop-App nutzen, sind Werbeblocker, Skriptblocker und Datenschutz-Erweiterungen die Hauptverdächtigen. Sie können die Marktdatenanfrage, die Charts lädt, unbemerkt blockieren oder umschreiben, und das Ergebnis zeigt sich als Not Found. Die dedizierte Desktop-App läuft in einer eigenen, abgeschlossenen Umgebung ohne Ihre Browser-Erweiterungen, weshalb sie oft stabiler ist als der Browser." },
    { type: "heading",text: "4. Eine übrig gebliebene oder konfliktierende Sitzung" },
    { type: "paragraph",html: "Tradovate begrenzt, wie viele aktive Sitzungen Sie gleichzeitig über Web, Desktop, Mobil und TradingView halten können. Wenn alte Sitzungen noch aktiv sind oder Sie an mehreren Orten gleichzeitig angemeldet sind, kann die Desktop-Anmeldung in einem halb verbundenen Zustand landen, in dem manche Datenanfragen nie aufgelöst werden. Überall abmelden und auf nur einem Gerät wieder anmelden behebt das." },
    { type: "heading",text: "So beheben Sie es: Schritt für Schritt" },
    {
      type: "steps",
      items: [
        { title: "App sauber neu starten", html: "Schließen Sie nicht nur das Fenster, beenden Sie den Prozess vollständig. Schließen Sie unter Windows die App, öffnen Sie dann den <strong class='text-white'>Task Manager</strong> (Strg+Umschalt+Esc), suchen Sie verbliebene Tradovate-Einträge und wählen Sie <strong class='text-white'>End task</strong>. Klicken Sie unter macOS mit der rechten Maustaste auf das Dock-Symbol und wählen Sie <strong class='text-white'>Quit</strong>, oder erzwingen Sie das Beenden über das Apple-Menü. Starten Sie neu und melden Sie sich an. Ein sauberer Neustart behebt die vorübergehende Variante dieser Störung überraschend oft, deshalb ist er immer der erste Schritt." },
        { title: "Cache und Cookies löschen", html: "Wenn der Neustart nicht geholfen hat, löschen Sie den veralteten Cache. Wie, hängt davon ab, wie Sie sich anmelden: <strong class='text-white'>Browser:</strong> Öffnen Sie die Browsereinstellungen, löschen Sie zwischengespeicherte Bilder/Dateien und Cookies für die Tradovate-Website (oder löschen Sie die Browserdaten für „Gesamte Zeit“, wenn Sie gründlich sein möchten), laden Sie dann die Plattform neu und melden Sie sich erneut an. <strong class='text-white'>Desktop-App:</strong> Die App speichert einen eigenen Cache. Wenn es in den Einstellungen der App einen Daten- oder Cache-Reset gibt, nutzen Sie ihn; andernfalls erreicht eine Neuinstallation dasselbe, indem sie den lokalen Speicher löscht. Hinweis: Das Löschen von Cookies meldet Sie ab, halten Sie also Ihre Zugangsdaten bereit. Ihre gespeicherten Arbeitsbereiche und Chart-Vorlagen liegen serverseitig zu Ihrem Konto und werden nach der erneuten Anmeldung wieder geladen, Sie löschen nur lokalen Ballast, nicht Ihr Setup." },
        { title: "App und Browser aktualisieren", html: "Stellen Sie sicher, dass Sie die aktuelle Version nutzen. Prüfen Sie bei der Desktop-App beim Start auf eine Update-Aufforderung oder laden Sie die neueste Version von der offiziellen Website herunter und installieren Sie sie über die alte. Aktualisieren Sie den Browser auf die neueste Version. Die aktuelle Version beseitigt das Missverhältnis „alte Version spricht mit neuen Servern“, das Chartfehler auslöst." },
        { title: "Erweiterungen deaktivieren oder Inkognito testen (nur Browser)", html: "Wenn Sie einen Browser nutzen, öffnen Sie ein <strong class='text-white'>privates Fenster/Inkognito-Fenster</strong> und melden Sie sich dort an. Inkognito läuft standardmäßig ohne Erweiterungen. Laden die Charts dort sauber, ist eine Erweiterung der Übeltäter. Kehren Sie zum normalen Fenster zurück und deaktivieren Sie Werbeblocker, Skriptblocker und Datenschutz-Erweiterungen für die Tradovate-Website nacheinander, bis Sie die Ursache finden. Wenn Sie das ganze Thema umgehen möchten, wechseln Sie zur dedizierten Desktop-App, die überhaupt keine Browser-Erweiterungen lädt." },
        { title: "Desktop-App neu installieren", html: "Wenn der Fehler weiterhin auftritt, installieren Sie neu. Das ersetzt eine möglicherweise beschädigte oder veraltete Version und löscht den lokalen Speicher in einem Zug, es ist die zuverlässigste Lösung, wenn die leichteren Schritte nicht greifen. Deinstallieren Sie die Tradovate-Desktop-App auf die für Ihr Betriebssystem übliche Weise, laden Sie die aktuelle Version von der offiziellen Tradovate-Downloadseite herunter und installieren Sie sie neu. Wenn das Problem direkt nach der Anmeldung auf mehreren Geräten begann, melden Sie sich außerdem von jeder Sitzung ab, Web, Desktop, Mobil und jeder TradingView-Verbindung, und melden Sie sich dann nur auf diesem einen Rechner wieder an, um einen Sitzungskonflikt aufzulösen." },
        { title: "Ein Plattformproblem ausschließen", html: "Wenn Sie den Cache geleert, aktualisiert, neu installiert haben und es immer noch nicht lädt, und besonders wenn andere gleichzeitig auf dasselbe Problem stoßen, prüfen Sie die offizielle Statusseite unter <code>status.tradovate.com</code>. Eine größere Störung oder ein Wartungsfenster liegt nicht in Ihrer Hand und muss einfach abgewartet werden. Wenn die Statusseite grün ist und der Fehler nur Ihren Desktop betrifft, ist es weiterhin ein lokales Problem, und die Neuinstallation ist Ihr bester Hebel." },
      ],
    },
    { type: "heading",text: "Tabelle zur Fehlerbehebung" },
    { type: "table", headers: ["Situation","Wahrscheinliche Ursache","Lösung"], rows: [
      ["Fehler auf dem Desktop, mobil funktioniert einwandfrei","Lokaler Cache- oder Sitzungsfehler auf dem Desktop","Sauber neu starten, Cache/Cookies löschen, bei Bedarf neu installieren"],
      ["Begann nach einem App-Update oder erzwungenem Beenden","Veralteter oder beschädigter Cache","Cache und Cookies löschen oder neu installieren, um den lokalen Speicher zu leeren"],
      ["Charts laden im Inkognito-Modus, aber nicht normal","Eine Browser-Erweiterung blockiert die Anfrage","Werbe-/Skript-/Datenschutz-Erweiterungen für die Seite deaktivieren oder die Desktop-App nutzen"],
      ["App wirkt bei Funktionen veraltet","Veraltete Version","Desktop-App und Browser auf die neueste Version aktualisieren"],
      ["Auf mehreren Geräten gleichzeitig angemeldet","Sitzungskonflikt / Limit erreicht","Überall abmelden, dann auf einem Gerät anmelden"],
      ["Alle sind gleichzeitig betroffen","Plattformausfall oder Wartung","status.tradovate.com prüfen und abwarten"],
    ] },
    { type: "heading",text: "Halten Sie Ihre Automatisierung mit PickMyTrade am Laufen" },
    { type: "paragraph",html: "Ein leeres Chart auf dem Desktop ist für sich genommen lästig, aber wenn Sie eine Strategie handeln, die von diesen Charts aus Signale auslöst, kann ein Anmeldefehler verpasste Ein- und Ausstiege bedeuten, während Sie mit der Neuinstallation beschäftigt sind. PickMyTrade nimmt diese Abhängigkeit von Ihrem Desktop:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Serverseitige Ausführung</strong>, Ihre TradingView-Alerts werden über die Infrastruktur von PickMyTrade an Tradovate geleitet, Ihre Trades warten also nicht darauf, dass Ihre Desktop-App Charts korrekt darstellt.",
        "<strong class='text-white'>Läuft, während Sie Fehler beheben</strong>, leeren Sie den Cache, aktualisieren und installieren Sie neu, ohne dass Ihre Automatisierung ausfällt, denn der Orderfluss liegt nicht auf Ihrem Rechner.",
        "<strong class='text-white'>Multi-Konto-Synchronisierung</strong>, spiegeln Sie dieselben verwalteten Orders über mehrere Konten, sodass eine fehlerhafte Desktop-Sitzung keine unverwalteten Positionen hinterlässt.",
        "<strong class='text-white'>Prop-Firm-bewusstes Routing</strong>, berücksichtigt den Risiko- und Datenvereinbarungsstatus Ihres Kontos, damit wiederhergestellte Orders nicht abgelehnt werden.",
      ],
    },
  ], es: [
    { type: "paragraph",html: "Abre la aplicación de escritorio, inicia sesión y, en lugar de sus gráficos, aparece un banner rojo <strong class='text-white'>Not Found: md/get chart</strong>. Entonces toma el teléfono, abre la aplicación móvil y todo carga perfectamente. Es frustrante, pero esa diferencia es en realidad la buena noticia: le dice exactamente dónde está el problema. Su cuenta, su suscripción de datos y el feed del mercado están bien; el fallo está en su escritorio, en la aplicación o el navegador con el que inicia sesión. La solicitud <code>md/getChart</code> es la forma en que la plataforma obtiene los datos de sus gráficos al cargar, y “Not Found” solo significa que esa solicitud no regresó correctamente esta vez. En casi todos los casos es una caché obsoleta o una sesión defectuosa, y se resuelve con unos minutos de mantenimiento. Aquí le explicamos cómo arreglarlo y evitar que vuelva a ocurrir." },
    {
      type: "checklist",
      heading: "Lista de comprobación rápida",
      items: [
        "<strong class='text-white'>Confirme que solo ocurre en el escritorio</strong>, si la aplicación móvil carga los gráficos bien, su cuenta y su feed de datos están sanos, así que concéntrese en el escritorio.",
        "<strong class='text-white'>Cierre por completo y vuelva a abrir la aplicación</strong>, un reinicio limpio elimina el fallo transitorio más común.",
        "<strong class='text-white'>Borre la caché y las cookies</strong>, de los datos almacenados de la aplicación de escritorio o del sitio de Tradovate si usa un navegador.",
        "<strong class='text-white'>Actualice a la versión actual</strong>, una versión desactualizada es una causa frecuente de fallos en las solicitudes de gráficos.",
        "<strong class='text-white'>Desactive las extensiones / pruebe en incógnito</strong>, los bloqueadores de anuncios y scripts pueden romper la solicitud de datos de mercado en un navegador.",
        "<strong class='text-white'>Reinstale si persiste</strong>, una instalación limpia sustituye una versión dañada y borra su almacenamiento local en un solo paso.",
      ],
    },
    { type: "heading",text: "Qué significa realmente “Not Found: md/get chart”" },
    { type: "paragraph",html: "<code>md/getChart</code> es una solicitud de datos de mercado. “md” es la abreviatura de market data (datos de mercado), y <code>getChart</code> es la llamada concreta que la plataforma lanza para obtener las velas del gráfico que abre. Al iniciar sesión, la aplicación ejecuta una ráfaga de estas solicitudes para dibujar su espacio de trabajo. Si una de ellas devuelve <strong class='text-white'>Not Found</strong> en lugar de datos del gráfico, aparece el banner de error y un gráfico vacío o ausente." },
    { type: "paragraph",html: "Lo importante es lo que este error <em>no</em> es. No es un problema de facturación, no es que sus credenciales sean incorrectas y, cuando el móvil funciona, tampoco es su suscripción de datos de mercado. Una suscripción deficiente dejaría sin cotizaciones a todos los dispositivos, no lanzaría un “Not Found” puntual en el escritorio mientras su teléfono transmite en vivo. Trátelo, pues, como un contratiempo local del escritorio: la solicitud salió de su equipo en un estado que el servidor no pudo responder, normalmente porque la aplicación trabajaba con una caché obsoleta o dañada, una versión desactualizada o una sesión enredada." },
    { type: "heading",text: "Principales causas en 2026" },
    { type: "heading",text: "1. Una caché obsoleta o dañada" },
    { type: "paragraph",html: "Tanto la aplicación de escritorio como el navegador almacenan datos en caché para cargar su espacio de trabajo más rápido. Cuando esos datos se quedan obsoletos o se corrompen, a menudo tras una actualización de la aplicación, un cierre forzado o una caída de red a mitad de sesión, la solicitud del gráfico puede apuntar a algo que ya no es válido y devolver Not Found. Es la causa más común con diferencia, y por eso limpiar la caché lo arregla tan a menudo." },
    { type: "heading",text: "2. Una versión desactualizada de la aplicación o del navegador" },
    { type: "paragraph",html: "Tradovate publica correcciones y mejoras de rendimiento con regularidad. Si su aplicación de escritorio o su navegador se ha quedado atrás, la solicitud de carga de gráficos que envía puede no coincidir con lo que esperan los servidores actuales. Mantener la aplicación y el navegador en sus últimas versiones es la cura básica para toda una clase de errores de carga, incluido este." },
    { type: "heading",text: "3. Una extensión del navegador que interfiere" },
    { type: "paragraph",html: "Si usa la plataforma en un navegador en lugar de la aplicación de escritorio, los bloqueadores de anuncios, de scripts y las extensiones de privacidad son los principales sospechosos. Pueden bloquear o reescribir en silencio la solicitud de datos de mercado que carga los gráficos, y el resultado aparece como Not Found. La aplicación de escritorio dedicada se ejecuta en su propio entorno autónomo, sin ninguna de las extensiones de su navegador, y por eso suele ser más estable que el navegador." },
    { type: "heading",text: "4. Una sesión residual o en conflicto" },
    { type: "paragraph",html: "Tradovate limita cuántas sesiones activas puede mantener a la vez entre web, escritorio, móvil y TradingView. Si siguen activas sesiones antiguas, o si ha iniciado sesión en varios lugares a la vez, el inicio de sesión en el escritorio puede quedar en un estado a medio conectar en el que algunas solicitudes de datos nunca se resuelven. Cerrar sesión en todas partes y volver a entrar en un solo dispositivo lo soluciona." },
    { type: "heading",text: "Cómo solucionarlo: paso a paso" },
    {
      type: "steps",
      items: [
        { title: "Reinicie la aplicación correctamente", html: "No se limite a cerrar la ventana, cierre el proceso por completo. En Windows, cierre la aplicación, abra el <strong class='text-white'>Task Manager</strong> (Ctrl+Shift+Esc), busque cualquier entrada persistente de Tradovate y elija <strong class='text-white'>End task</strong>. En macOS, haga clic con el botón derecho en el icono del Dock y elija <strong class='text-white'>Quit</strong>, o fuerce el cierre desde el menú Apple. Vuelva a abrirla e inicie sesión. Un reinicio limpio elimina la versión transitoria de este fallo con sorprendente frecuencia, por eso es siempre el primer paso." },
        { title: "Borre la caché y las cookies", html: "Si el reinicio no bastó, elimine la caché obsoleta. Cómo hacerlo depende de cómo inicie sesión: <strong class='text-white'>Navegador:</strong> abra los ajustes de su navegador, borre las imágenes/archivos en caché y las cookies del sitio de Tradovate (o borre los datos de navegación de “Todo el tiempo” si quiere ser minucioso), luego recargue la plataforma e inicie sesión de nuevo. <strong class='text-white'>Aplicación de escritorio:</strong> la aplicación guarda su propia caché. Si hay un restablecimiento de datos o caché en los ajustes de la aplicación, úselo; de lo contrario, reinstalar logra lo mismo al borrar el almacenamiento local. Atención: borrar las cookies cierra su sesión, así que tenga sus credenciales listas. Sus espacios de trabajo y plantillas de gráficos guardados viven en el servidor asociados a su cuenta, por lo que se recargan al volver a iniciar sesión, solo está borrando basura local, no su configuración." },
        { title: "Actualice la aplicación y el navegador", html: "Asegúrese de tener la versión actual. En la aplicación de escritorio, busque un aviso de actualización al iniciar o descargue la última versión desde el sitio oficial e instálela sobre la anterior. En el navegador, actualícelo a la versión más reciente. Usar la última versión elimina el desajuste de “versión antigua hablando con servidores nuevos” que provoca errores de gráficos." },
        { title: "Desactive las extensiones o pruebe en incógnito (solo navegador)", html: "Si usa un navegador, abra una <strong class='text-white'>ventana privada/incógnito</strong> e inicie sesión allí. El modo incógnito se ejecuta por defecto sin extensiones, así que si los gráficos cargan limpiamente, una extensión es la culpable. Vuelva a su ventana normal y desactive los bloqueadores de anuncios, de scripts y las extensiones de privacidad para el sitio de Tradovate, una a una, hasta encontrar la que causa el problema. Si prefiere evitar todo el asunto, cambie a la aplicación de escritorio dedicada, que no carga extensiones del navegador en absoluto." },
        { title: "Reinstale la aplicación de escritorio", html: "Si sigue mostrando el error, reinstale. Esto sustituye una versión posiblemente dañada o desactualizada y borra su almacenamiento local de una vez, es la solución más fiable cuando los pasos más ligeros no resuelven. Desinstale la aplicación de escritorio de Tradovate de la forma habitual en su sistema operativo, descargue la versión actual desde la página oficial de descargas de Tradovate e instálela desde cero. Ya que está, si el problema empezó justo después de iniciar sesión en varios dispositivos, cierre todas las sesiones, web, escritorio, móvil y cualquier conexión de TradingView, y luego vuelva a iniciar sesión solo en este equipo para resolver un conflicto de sesión." },
        { title: "Descarte un problema de la plataforma", html: "Si ha limpiado la caché, actualizado y reinstalado y sigue sin cargar, y sobre todo si otras personas se topan con el mismo muro al mismo tiempo, consulte la página oficial de estado en <code>status.tradovate.com</code>. Una interrupción general o una ventana de mantenimiento escapa a su control y solo hay que esperar. Si la página de estado está en verde y el error solo afecta a su escritorio, sigue siendo un problema local y reinstalar es su mejor palanca." },
      ],
    },
    { type: "heading",text: "Tabla de solución de problemas" },
    { type: "table", headers: ["Situación","Causa probable","Solución"], rows: [
      ["Error en el escritorio, el móvil funciona bien","Fallo local de caché o sesión en el escritorio","Reiniciar correctamente, borrar caché/cookies y reinstalar si es necesario"],
