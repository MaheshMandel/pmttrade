---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "pnl-differs-desktop-vs-pulse";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/debugging/${SLUG}`;

const META_TITLE = "Tradovate P&L Differs: Desktop LAST vs Pulse Bid/Ask";
const META_DESCRIPTION =
  "Desktop and mobile P&L don't match? Desktop marks open P&L to LAST, mobile to bid/ask. Trust bid/ask for the real exit value on illiquid options.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Tradovate-P&L weicht ab: Desktop LAST vs. Pulse Bid/Ask", es: "El P&L de Tradovate difiere: LAST en escritorio vs. Bid/Ask en Pulse", fr: "P&L Tradovate différent : LAST sur le bureau vs Bid/Ask sur Pulse", it: "P&L Tradovate diverso: LAST su desktop vs Bid/Ask su Pulse" },
  dek: { en: "Desktop says you're down forty bucks; Pulse shows a bigger loss on the same position. Nothing synced wrong, here's why the two apps disagree and which number to trust before you exit.", de: "Auf dem Desktop liegen Sie vierzig Dollar im Minus, Pulse zeigt für dieselbe Position einen größeren Verlust. Nichts ist falsch synchronisiert – hier erfahren Sie, warum die beiden Apps abweichen und welcher Zahl Sie vor dem Ausstieg trauen sollten.", es: "El escritorio dice que va perdiendo cuarenta dólares; Pulse muestra una pérdida mayor en la misma posición. Nada se sincronizó mal: aquí le explicamos por qué las dos apps no coinciden y en qué cifra confiar antes de salir.", fr: "Le bureau indique que vous perdez quarante dollars ; Pulse affiche une perte plus importante sur la même position. Rien n'est mal synchronisé : voici pourquoi les deux applications divergent et quel chiffre croire avant de sortir.", it: "Il desktop dice che sta perdendo quaranta dollari; Pulse mostra una perdita maggiore sulla stessa posizione. Nulla si è sincronizzato male: ecco perché le due app non concordano e di quale numero fidarsi prima di uscire." },
  readTime: { en: "7 min read", de: "7 Min. Lesezeit", es: "Lectura de 7 min", fr: "Lecture : 7 min", it: "Lettura di 7 min" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "You've got a position open, glance at the desktop platform, and it says you're down forty bucks. Then you pull out your phone, open Pulse, and the same position shows a bigger loss. Nothing synced wrong, nobody moved the market between glances, and yet the two numbers don't agree. Before you file a support ticket or start doubting your fills, here's the short version: this is a <strong class='text-white'>Tradovate P&amp;L difference between the desktop app and the Pulse mobile app</strong>, and it comes down to which price each one uses to value a live position. The desktop marks your open P&amp;L to the <em>last traded price</em>. Pulse marks it to the <em>bid/ask</em>. On a tight market you'll never notice. On an illiquid option with a wide spread, the desktop figure can quietly understate what the trade is really worth if you had to get out right now. This guide shows you why it happens, which number to trust, and how to read the real exit value." },
    {
      type: "checklist",
      heading: "Quick Answer: Which P&L to Trust",
      items: [
        "<strong class='text-white'>Trust the bid/ask value for exit decisions</strong>, Pulse marks open P&amp;L to the bid/ask, which is what you'd actually get filled at, so it reflects real liquidation value.",
        "<strong class='text-white'>Treat the desktop number as a rough mark</strong>, it's based on the last trade, which can sit on the favorable side of the spread and flatter the position.",
        "<strong class='text-white'>Neither app is broken</strong>, this is a by-design valuation difference, not a sync bug or a wrong number.",
        "<strong class='text-white'>It only affects open P&amp;L</strong>, once you close, realized P&amp;L is identical on both apps because it's based on your actual fill.",
        "<strong class='text-white'>The gap widens on illiquid contracts</strong>, options on futures, far strikes, and thin markets. On ES or NQ the two agree.",
        "<strong class='text-white'>Cross-check the DOM</strong>, read the live bid and ask, value a long at the bid and a short at the ask, and you've got the truthful exit figure.",
      ],
    },
    { type: "heading", text: "What “LAST vs Bid/Ask” P&L Actually Means" },
    { type: "paragraph", html: "Open P&amp;L (also called unrealized P&amp;L) is an estimate. Your entry price is fixed, but the “current price” side of the calculation is a moving target, and there's more than one honest way to pick it. That's the whole story here. Both Tradovate apps take your entry, apply the contract's point value and your size, and subtract it from a current mark. They just disagree on what “current” means." },
    { type: "paragraph", html: "The <strong class='text-white'>desktop platform uses the last traded price</strong>, the price at which the most recent transaction printed. It's the number most people picture when they think “the price.” The <strong class='text-white'>Pulse mobile app uses the bid/ask</strong>, the live quotes showing what buyers are willing to pay and what sellers are asking. For a contract that trades constantly, the last price and the bid/ask are basically on top of each other, separated by a single tick at most, and both marks land in the same place." },
    { type: "paragraph", html: "The split opens up when the market gets thin. In a quiet order book, one aggressive order can drag the last price to one side and leave it there, because nothing else trades. Meanwhile the resting bid and ask tell a more current story about where you could actually do business. Value your position off that stale last print and you get a number that looks fine on screen but wouldn't survive contact with a real exit order." },
    { type: "heading", text: "Why Your Tradovate P&L Differs Across Apps" },
    { type: "heading", text: "1. Desktop marks open positions to the last trade" },
    { type: "paragraph", html: "On the desktop platform, the open P&amp;L on your position is driven by the last traded price of the contract. When that contract is trading actively, this is perfectly reasonable, the last print is a fair proxy for fair value. The catch is that the last trade tells you where <em>someone else</em> did business a moment ago, not where <em>you</em> can do business now. If the last fill happened to hit the ask, a long position marked to that price looks better than the price you'd realize selling into the bid." },
    { type: "heading", text: "2. Pulse marks the same position to bid/ask" },
    { type: "paragraph", html: "Pulse takes the more conservative, execution-honest route. It values a long at the bid, the price a buyer is standing ready to pay you, and a short at the ask, the price a seller is offering. That's the actual liquidation value: hit the button to flatten and this is roughly where you fill. It's why the Pulse number often reads worse than desktop on a wide spread. It isn't being pessimistic; it's being literal about what the market will give you." },
    { type: "heading", text: "3. Illiquid options and wide spreads blow the gap open" },
    { type: "paragraph", html: "This is where the difference goes from academic to painful. Options on futures, deep out-of-the-money strikes, far-dated contracts, and any thin market can carry a spread that's several ticks, sometimes a large percentage of the option's value. Picture a contract with a $0.75 bid and a $1.00 ask. Buy at $1.00, and if you turned around and sold immediately into the $0.75 bid, you're out 25% before the market moves a hair. Desktop, marking to a last trade that printed up near $1.00, shows you roughly flat. Pulse, marking to the $0.75 bid, shows the quarter-point you'd actually eat. Same position, same instant, two very different-looking screens, and the last-trade mark almost always lands on the favorable side of where you'd truly get filled." },
    { type: "heading", text: "4. Stale or delayed quotes can distort either number" },
    { type: "paragraph", html: "Both marks are only as good as the data feeding them. If your market data is delayed, not subscribed, or lagging, the “current” price on one or both apps can be out of date, which widens the apparent gap for reasons that have nothing to do with LAST vs bid/ask. Before you conclude it's the valuation method, confirm you're on live, real-time data on the device that looks off. A delayed feed on one app and a live feed on the other will make two correct methods look even further apart than they are." },
    { type: "heading", text: "5. It's open P&L only, realized P&L always agrees" },
    { type: "paragraph", html: "Here's the reassuring part. This entire difference lives in <em>unrealized</em> P&amp;L on an open position. The moment you close, your realized result is computed from your actual fill price, and that fill is the same regardless of which app you were staring at. So the two apps can disagree all day while a trade is live, then snap to the exact same realized number once it's closed. If your closed-trade history matches between desktop and Pulse, nothing is wrong, you were just watching two different open-position estimates." },
    { type: "heading", text: "How to Read the Right P&L Number: Step-by-Step" },
    { type: "heading", text: "Step 1: Decide what you're actually asking" },
    { type: "paragraph", html: "Get clear on the question first, because it changes which number matters:" },
    {
      type: "list",
      items: [
        "If you're asking <strong class='text-white'>“what will I net if I flatten right now?”</strong>, that's a liquidation-value question, and the bid/ask figure (Pulse) is the honest answer.",
        "If you're asking <strong class='text-white'>“where did the contract last trade?”</strong>, that's the last-price mark on desktop, useful for a quick pulse-check on a liquid instrument.",
        "For managing risk and planning exits on anything thin, default to the bid/ask value. It's the one that survives an actual order.",
      ],
    },
    { type: "heading", text: "Step 2: Cross-check the live bid and ask on the DOM" },
    { type: "paragraph", html: "You don't have to switch to your phone to get the truthful number. Pull up the depth-of-market ladder or the quote for the contract on desktop and read the live quotes directly:" },
    {
      type: "steps",
      items: [
        { title: "Open the DOM or quote panel", html: "Open the DOM (or the quote panel) for the contract you're holding." },
        { title: "Compare bid, ask, and last", html: "Note the current <strong class='text-white'>bid</strong> and <strong class='text-white'>ask</strong>, and how far the <strong class='text-white'>last</strong> print sits from them. A wide gap between them is your warning sign that the desktop P&amp;L is marking to a price you can't actually exit at." },
        { title: "Re-price the position manually", html: "Value a <strong class='text-white'>long</strong> at the bid and a <strong class='text-white'>short</strong> at the ask. That re-creates the same realistic figure Pulse is showing you, right there on desktop." },
      ],
    },
    { type: "heading", text: "Step 3: Use the bid/ask value for exit and risk decisions" },
    { type: "paragraph", html: "Once you can see both marks, use them for what each is good for:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Base exit and stop decisions on the bid/ask value.</strong> If you'd be forced out at the bid, size and manage the trade against that number, not the friendlier last-price mark.",
        "<strong class='text-white'>Confirm your data is live</strong> on the device you're trusting. A delayed feed makes any mark unreliable, make sure the contract isn't showing delayed or unsubscribed before you act on its P&amp;L.",
        "<strong class='text-white'>Don't chase the discrepancy as a bug.</strong> It won't “fix,” because nothing is broken. Reconcile it once you close: realized P&amp;L will match on both apps, every time.",
      ],
    },
    { type: "heading", text: "Troubleshooting Table" },
    {
      type: "table",
      headers: ["What you see", "What it means", "What to do"],
      rows: [
        ["Desktop shows a smaller loss than Pulse on the same position", "Desktop marks to last; Pulse marks to the bid you'd exit at", "Trust the bid/ask value for real exit worth"],
        ["Numbers match on ES/NQ but split on options", "Tight vs wide spread, last and bid/ask only diverge when thin", "Expect it; use bid/ask on illiquid contracts"],
        ["Open P&L differs, closed trades match", "Only unrealized P&L uses different marks", "Nothing to fix, realized P&L is fill-based"],
        ["Gap looks huge and quotes seem frozen", "Delayed or unsubscribed market data on one device", "Confirm live real-time data before acting"],
        ["Desktop P&L “flatters” a long position", "Last trade printed near the ask, above the bid", "Re-price the long at the current bid"],
        ["Short shows worse on Pulse than desktop", "Pulse marks the short to the ask you'd buy back at", "Value the short at the ask, not the last print"],
        ["You want the true number on desktop", "Desktop P&L display uses last, but the DOM shows bid/ask", "Read bid/ask off the DOM and re-price manually"],
      ],
    },
    { type: "heading", text: "Trade Cleaner Exits with PickMyTrade" },
    { type: "paragraph", html: "The desktop-vs-Pulse gap matters most at one moment, the exit, and that's exactly where eyeballing a possibly-misleading open P&amp;L number costs you. PickMyTrade sits between your TradingView alerts and Tradovate so your exits fire on defined price levels instead of a P&amp;L readout you have to second-guess:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Rule-based stops and targets</strong>, brackets attach to real price levels, so you're not deciding to bail off a last-trade mark that's flattering the position.",
        "<strong class='text-white'>Consistent order routing</strong>, every alert lands with a validated symbol and size, so your fills are clean and your P&amp;L reconciles later without surprises.",
        "<strong class='text-white'>Multi-account sync</strong>, the same exit mirrors across every connected account, so no single screen's open-P&amp;L quirk drives an inconsistent decision.",
        "<strong class='text-white'>Works with your live data</strong>, automation runs off the price action, not a delayed or stale mark on one device.",
      ],
    },
  ], de: [
    { type: "paragraph",html: "Sie haben eine Position offen, werfen einen Blick auf die Desktop-Plattform, und dort liegen Sie vierzig Dollar im Minus. Dann holen Sie Ihr Handy heraus, öffnen Pulse, und dieselbe Position zeigt einen größeren Verlust. Nichts ist falsch synchronisiert, niemand hat den Markt zwischen den beiden Blicken bewegt – und trotzdem stimmen die beiden Zahlen nicht überein. Bevor Sie ein Support-Ticket eröffnen oder an Ihren Ausführungen zweifeln, die Kurzfassung: Dies ist ein <strong class='text-white'>Tradovate-P&amp;L-Unterschied zwischen der Desktop-App und der mobilen Pulse-App</strong>, und er hängt davon ab, welchen Kurs jede App zur Bewertung einer laufenden Position verwendet. Der Desktop bewertet Ihr offenes P&amp;L zum <em>letzten gehandelten Kurs</em>. Pulse bewertet es zum <em>Bid/Ask</em>. In einem engen Markt fällt das nie auf. Bei einer illiquiden Option mit großem Spread kann die Desktop-Zahl unbemerkt unterschätzen, was der Trade wirklich wert ist, wenn Sie sofort aussteigen müssten. Diese Anleitung zeigt Ihnen, warum das passiert, welcher Zahl Sie trauen sollten und wie Sie den tatsächlichen Ausstiegswert ablesen." },
    {
      type: "checklist",
      heading: "Kurzantwort: Welchem P&L Sie trauen sollten",
      items: [
        "<strong class='text-white'>Vertrauen Sie dem Bid/Ask-Wert für Ausstiegsentscheidungen</strong>, Pulse bewertet das offene P&amp;L zum Bid/Ask, also zu dem Kurs, zu dem Sie tatsächlich ausgeführt würden, und spiegelt damit den realen Liquidationswert wider.",
        "<strong class='text-white'>Betrachten Sie die Desktop-Zahl als grobe Bewertung</strong>, sie basiert auf dem letzten Handel, der auf der günstigeren Seite des Spreads liegen und die Position beschönigen kann.",
        "<strong class='text-white'>Keine der Apps ist defekt</strong>, es handelt sich um einen bewussten Bewertungsunterschied, nicht um einen Synchronisationsfehler oder eine falsche Zahl.",
        "<strong class='text-white'>Es betrifft nur das offene P&amp;L</strong>, nach dem Schließen ist das realisierte P&amp;L in beiden Apps identisch, weil es auf Ihrer tatsächlichen Ausführung beruht.",
        "<strong class='text-white'>Die Differenz wächst bei illiquiden Kontrakten</strong>, Optionen auf Futures, weit entfernte Strikes und dünne Märkte. Bei ES oder NQ stimmen beide überein.",
        "<strong class='text-white'>Prüfen Sie das DOM</strong>, lesen Sie den aktuellen Bid und Ask ab, bewerten Sie eine Long-Position zum Bid und eine Short-Position zum Ask, und Sie haben den wahrheitsgetreuen Ausstiegswert.",
      ],
    },
    { type: "heading",text: "Was „LAST vs. Bid/Ask“-P&L tatsächlich bedeutet" },
    { type: "paragraph",html: "Das offene P&amp;L (auch nicht realisiertes P&amp;L genannt) ist eine Schätzung. Ihr Einstiegskurs steht fest, doch der „aktuelle Kurs“ in der Berechnung ist ein bewegliches Ziel, und es gibt mehr als eine ehrliche Möglichkeit, ihn zu wählen. Das ist die ganze Geschichte. Beide Tradovate-Apps nehmen Ihren Einstieg, wenden den Punktwert des Kontrakts und Ihre Positionsgröße an und ziehen das Ergebnis von einer aktuellen Bewertung ab. Sie sind sich nur uneinig darüber, was „aktuell“ bedeutet." },
    { type: "paragraph",html: "Die <strong class='text-white'>Desktop-Plattform verwendet den letzten gehandelten Kurs</strong>, den Preis, zu dem die jüngste Transaktion zustande kam. Das ist die Zahl, die die meisten sich vorstellen, wenn sie an „den Kurs“ denken. Die <strong class='text-white'>mobile Pulse-App verwendet Bid/Ask</strong>, die Live-Kurse, die zeigen, was Käufer zu zahlen bereit sind und was Verkäufer verlangen. Bei einem Kontrakt, der ständig gehandelt wird, liegen der letzte Kurs und Bid/Ask praktisch übereinander, höchstens einen Tick voneinander entfernt, und beide Bewertungen landen am selben Punkt." },
    { type: "paragraph",html: "Die Abweichung entsteht, wenn der Markt dünn wird. In einem ruhigen Orderbuch kann eine einzige aggressive Order den letzten Kurs auf eine Seite ziehen und dort belassen, weil sonst nichts gehandelt wird. Der stehende Bid und Ask erzählen währenddessen eine aktuellere Geschichte darüber, wo Sie tatsächlich handeln könnten. Bewerten Sie Ihre Position anhand dieses veralteten letzten Kurses, erhalten Sie eine Zahl, die auf dem Bildschirm gut aussieht, aber den Kontakt mit einer echten Ausstiegsorder nicht überstehen würde." },
    { type: "heading",text: "Warum Ihr Tradovate-P&L zwischen den Apps abweicht" },
    { type: "heading",text: "1. Der Desktop bewertet offene Positionen zum letzten Handel" },
    { type: "paragraph",html: "Auf der Desktop-Plattform wird das offene P&amp;L Ihrer Position vom letzten gehandelten Kurs des Kontrakts bestimmt. Wird der Kontrakt aktiv gehandelt, ist das völlig vernünftig, denn der letzte Kurs ist ein guter Näherungswert für den fairen Wert. Der Haken: Der letzte Handel sagt Ihnen, wo <em>jemand anderes</em> vor einem Moment gehandelt hat, nicht wo <em>Sie</em> jetzt handeln können. Wurde die letzte Ausführung am Ask abgeschlossen, sieht eine zu diesem Kurs bewertete Long-Position besser aus als der Kurs, den Sie beim Verkauf in den Bid tatsächlich erzielen würden." },
    { type: "heading",text: "2. Pulse bewertet dieselbe Position zum Bid/Ask" },
    { type: "paragraph",html: "Pulse wählt den konservativeren, ausführungsnahen Weg. Eine Long-Position wird zum Bid bewertet, dem Preis, den ein Käufer Ihnen zu zahlen bereit ist, eine Short-Position zum Ask, dem Preis, den ein Verkäufer verlangt. Das ist der tatsächliche Liquidationswert: Drücken Sie den Button zum Glattstellen, und etwa hier werden Sie ausgeführt. Deshalb wirkt die Pulse-Zahl bei einem großen Spread oft schlechter als die des Desktops. Pulse ist nicht pessimistisch, sondern wörtlich genommen ehrlich darüber, was der Markt Ihnen gibt." },
    { type: "heading",text: "3. Illiquide Optionen und große Spreads öffnen die Lücke" },
    { type: "paragraph",html: "Hier wird der Unterschied von akademisch zu schmerzhaft. Optionen auf Futures, weit aus dem Geld liegende Strikes, weit entfernte Fälligkeiten und jeder dünne Markt können einen Spread von mehreren Ticks haben, mitunter einen großen Prozentsatz des Optionswerts. Stellen Sie sich einen Kontrakt mit einem Bid von $0.75 und einem Ask von $1.00 vor. Sie kaufen zu $1.00, und wenn Sie sofort in den Bid von $0.75 verkaufen würden, liegen Sie 25% im Minus, bevor sich der Markt auch nur bewegt hat. Der Desktop, der zu einem letzten Handel nahe $1.00 bewertet, zeigt Ihnen ungefähr null. Pulse, das zum Bid von $0.75 bewertet, zeigt die Viertelpunkt-Differenz, die Sie tatsächlich hinnehmen müssten. Dieselbe Position, derselbe Moment, zwei sehr unterschiedlich aussehende Bildschirme – und die Bewertung zum letzten Handel liegt fast immer auf der günstigeren Seite dessen, wo Sie tatsächlich ausgeführt würden." },
    { type: "heading",text: "4. Veraltete oder verzögerte Kurse können jede der beiden Zahlen verzerren" },
    { type: "paragraph",html: "Beide Bewertungen sind nur so gut wie die Daten, die sie speisen. Sind Ihre Marktdaten verzögert, nicht abonniert oder hinken sie hinterher, kann der „aktuelle“ Kurs in einer oder beiden Apps veraltet sein, was die scheinbare Differenz aus Gründen vergrößert, die nichts mit LAST vs. Bid/Ask zu tun haben. Bevor Sie schlussfolgern, dass es an der Bewertungsmethode liegt, prüfen Sie, ob Sie auf dem Gerät, das abweicht, Live-Echtzeitdaten verwenden. Ein verzögerter Feed in der einen App und ein Live-Feed in der anderen lassen zwei korrekte Methoden noch weiter auseinanderliegend aussehen, als sie es sind." },
    { type: "heading",text: "5. Nur das offene P&L, das realisierte P&L stimmt immer überein" },
    { type: "paragraph",html: "Hier der beruhigende Teil. Diese gesamte Differenz betrifft das <em>nicht realisierte</em> P&amp;L einer offenen Position. Sobald Sie schließen, wird Ihr realisiertes Ergebnis aus Ihrem tatsächlichen Ausführungspreis berechnet, und dieser ist derselbe, egal auf welche App Sie geschaut haben. Die beiden Apps können also den ganzen Tag abweichen, solange ein Trade läuft, und springen nach dem Schließen auf exakt dieselbe realisierte Zahl. Stimmt Ihr Verlauf geschlossener Trades zwischen Desktop und Pulse überein, ist nichts falsch – Sie haben lediglich zwei unterschiedliche Schätzungen der offenen Position beobachtet." },
    { type: "heading",text: "So lesen Sie die richtige P&L-Zahl ab: Schritt für Schritt" },
    { type: "heading",text: "Schritt 1: Klären Sie, was Sie eigentlich fragen" },
    { type: "paragraph",html: "Machen Sie sich zuerst klar, welche Frage Sie stellen, denn sie bestimmt, welche Zahl zählt:" },
    {
      type: "list",
      items: [
        "Fragen Sie <strong class='text-white'>„Was erhalte ich netto, wenn ich jetzt glattstelle?“</strong>, ist das eine Frage nach dem Liquidationswert, und der Bid/Ask-Wert (Pulse) ist die ehrliche Antwort.",
        "Fragen Sie <strong class='text-white'>„Wo wurde der Kontrakt zuletzt gehandelt?“</strong>, ist das die Bewertung zum letzten Kurs auf dem Desktop, nützlich für einen schnellen Check bei einem liquiden Instrument.",
        "Für Risikomanagement und Ausstiegsplanung bei allem, was dünn gehandelt wird, verwenden Sie standardmäßig den Bid/Ask-Wert. Er ist derjenige, der einer echten Order standhält.",
      ],
    },
    { type: "heading",text: "Schritt 2: Prüfen Sie Bid und Ask im DOM gegen" },
    { type: "paragraph",html: "Sie müssen nicht zum Handy wechseln, um die wahrheitsgetreue Zahl zu erhalten. Öffnen Sie auf dem Desktop die Depth-of-Market-Leiter oder die Kursanzeige des Kontrakts und lesen Sie die Live-Kurse direkt ab:" },
    {
      type: "steps",
      items: [
        { title: "DOM oder Kursfenster öffnen", html: "Öffnen Sie das DOM (oder das Kursfenster) für den Kontrakt, den Sie halten." },
        { title: "Bid, Ask und Last vergleichen", html: "Notieren Sie den aktuellen <strong class='text-white'>Bid</strong> und <strong class='text-white'>Ask</strong> und wie weit der letzte Kurs (<strong class='text-white'>Last</strong>) davon entfernt liegt. Eine große Lücke zwischen ihnen ist Ihr Warnsignal, dass das Desktop-P&amp;L zu einem Kurs bewertet wird, zu dem Sie nicht tatsächlich aussteigen können." },
        { title: "Position manuell neu bewerten", html: "Bewerten Sie eine <strong class='text-white'>Long-Position</strong> zum Bid und eine <strong class='text-white'>Short-Position</strong> zum Ask. So erhalten Sie direkt auf dem Desktop denselben realistischen Wert, den Pulse Ihnen anzeigt." },
      ],
    },
    { type: "heading",text: "Schritt 3: Verwenden Sie den Bid/Ask-Wert für Ausstiegs- und Risikoentscheidungen" },
    { type: "paragraph",html: "Wenn Sie beide Bewertungen sehen können, nutzen Sie sie für das, wofür jede taugt:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Stützen Sie Ausstiegs- und Stop-Entscheidungen auf den Bid/Ask-Wert.</strong> Wenn Sie zum Bid aussteigen müssten, dimensionieren und steuern Sie den Trade an dieser Zahl, nicht an der freundlicheren Bewertung zum letzten Kurs.",
        "<strong class='text-white'>Vergewissern Sie sich, dass Ihre Daten live sind</strong>, auf dem Gerät, dem Sie vertrauen. Ein verzögerter Feed macht jede Bewertung unzuverlässig; stellen Sie sicher, dass der Kontrakt nicht verzögert oder nicht abonniert angezeigt wird, bevor Sie nach seinem P&amp;L handeln.",
        "<strong class='text-white'>Jagen Sie der Abweichung nicht als Fehler hinterher.</strong> Sie wird sich nicht „beheben“, weil nichts defekt ist. Gleichen Sie sie nach dem Schließen ab: Das realisierte P&amp;L stimmt in beiden Apps jedes Mal überein.",
      ],
    },
    { type: "heading",text: "Tabelle zur Fehlerbehebung" },
    { type: "table", headers: ["Was Sie sehen","Was es bedeutet","Was zu tun ist"], rows: [
      ["Der Desktop zeigt für dieselbe Position einen kleineren Verlust als Pulse","Der Desktop bewertet zum letzten Kurs; Pulse zum Bid, zu dem Sie aussteigen würden","Vertrauen Sie dem Bid/Ask-Wert für den realen Ausstiegswert"],
      ["Zahlen stimmen bei ES/NQ überein, weichen aber bei Optionen ab","Enger vs. großer Spread, Last und Bid/Ask weichen nur bei dünnem Handel ab","Das ist zu erwarten; verwenden Sie bei illiquiden Kontrakten Bid/Ask"],
      ["Offenes P&L weicht ab, geschlossene Trades stimmen überein","Nur das nicht realisierte P&L verwendet unterschiedliche Bewertungen","Nichts zu beheben, das realisierte P&L basiert auf der Ausführung"],
      ["Die Lücke wirkt riesig und die Kurse scheinen eingefroren","Verzögerte oder nicht abonnierte Marktdaten auf einem Gerät","Bestätigen Sie Live-Echtzeitdaten, bevor Sie handeln"],
