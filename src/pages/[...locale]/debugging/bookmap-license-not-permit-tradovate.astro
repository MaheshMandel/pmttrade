---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "bookmap-license-not-permit-tradovate";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/debugging/${SLUG}`;

const META_TITLE = "Bookmap 'License Doesn't Permit' Tradovate Symbols";
const META_DESCRIPTION =
  "Subscribing to futures like ES or MES and hit a 'license doesn't permit' error? Here's why your data-license tier blocks the symbol and how to fix it.";

// Short SEO title (<=60 chars) for locales where the shared h1 is too long for a SERP title.
const TITLE_OVERRIDE: Partial<Record<Locale, string>> = { es: "Bookmap: “la licencia no lo permite” en Tradovate", fr: "Bookmap : « la licence ne le permet pas » (Tradovate)", it: "Bookmap: “la licenza non lo consente” su Tradovate" };

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Bookmap 'Lizenz erlaubt nicht' bei Tradovate-Symbolen", es: "Bookmap: 'la licencia no lo permite' en símbolos de Tradovate", fr: "Bookmap : « la licence ne le permet pas » pour les symboles Tradovate", it: "Bookmap: 'la licenza non lo consente' per i simboli Tradovate" },
  dek: { en: "The Tradovate connection works fine, your login goes through, and Bookmap still refuses the symbol. It's a licensing and entitlement wall, not a broken connection, here's how to clear it.", de: "Die Tradovate-Verbindung funktioniert einwandfrei, Ihr Login klappt, und trotzdem verweigert Bookmap das Symbol. Es ist eine Lizenz- und Berechtigungssperre, keine defekte Verbindung – so umgehen Sie sie.", es: "La conexión con Tradovate funciona bien, su inicio de sesión se completa y, aun así, Bookmap sigue rechazando el símbolo. Es una barrera de licencia y de permisos de datos, no una conexión rota; así se resuelve.", fr: "La connexion Tradovate fonctionne parfaitement, votre connexion aboutit, et pourtant Bookmap continue de refuser le symbole. C'est un blocage de licence et de droits d'accès, pas une connexion défaillante : voici comment le résoudre.", it: "La connessione a Tradovate funziona perfettamente, il login va a buon fine, eppure Bookmap continua a rifiutare il simbolo. È un blocco di licenza e di autorizzazione ai dati, non una connessione difettosa: ecco come risolverlo." },
  readTime: { en: "7 min read", de: "7 Minuten Lesezeit", es: "Lectura de 7 minutos", fr: "Lecture de 7 minutes", it: "Lettura di 7 minuti" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "You link your Tradovate account to Bookmap, type in a symbol you trade every day, ES, MES, whatever, hit subscribe, and instead of a heatmap you get a flat little message: <em>your license does not permit</em>. No chart, no data, no obvious reason. The connection looks fine, your Tradovate login worked, and yet the platform won't show you the one instrument you came for. Frustrating, but it's almost never a bug. It's a licensing and data-entitlement wall, and once you understand the two layers behind it, the fix is usually quick. Let's break down exactly what that message means, why it lands on CME futures in particular, and how to clear it." },
    {
      type: "checklist",
      heading: "Quick Checklist Before You Dig In",
      items: [
        "<strong class='text-white'>Check your Bookmap plan tier.</strong> Digital and Digital+ are crypto-only. CME futures like ES and MES need Global or Global+.",
        "<strong class='text-white'>Count your symbols.</strong> Each tier caps how many instruments you can watch at once. Blow past the cap and you get the same license message.",
        "<strong class='text-white'>Confirm the CME data entitlement.</strong> Real-time futures data needs a signed exchange agreement and its separate fee, independent of the Bookmap plan.",
        "<strong class='text-white'>Know which market you're actually asking for.</strong> The “free” Tradovate + Bookmap deal covers specific Coinbase (FairX) crypto futures, not the full CME suite.",
        "<strong class='text-white'>Check your connection mode.</strong> Tradovate can supply data and execution, or just route orders while another provider feeds data.",
        "<strong class='text-white'>On a prop account, loop in the firm.</strong> Evaluation and funded accounts have data entitlements the firm controls, not you.",
      ],
    },
    { type: "heading", text: "What “License Does Not Permit” Actually Means" },
    { type: "paragraph", html: "Bookmap keeps two things separate that traders tend to lump together: the <strong class='text-white'>plan</strong> you pay Bookmap for, and the <strong class='text-white'>market data</strong> you're entitled to receive from an exchange. The “license does not permit” message is Bookmap telling you that one of those two is missing for the symbol you requested. Either your Bookmap tier doesn't include that market, or the exchange data license behind the feed isn't active on your account. The Tradovate connection itself is working, that's why your login went through and the platform accepted your credentials. What failed is the entitlement check that runs the instant you try to pull live data for a specific instrument." },
    { type: "paragraph", html: "This matters because the two layers have completely different fixes. A plan problem is solved by upgrading your Bookmap subscription. A data-entitlement problem is solved by signing the exchange agreement and paying the exchange fee, or by having your prop firm enable it. Chase the wrong one and you'll spend an afternoon reinstalling software that was never broken. So the first job is figuring out which wall you've hit." },
    { type: "heading", text: "Why Bookmap Blocks a Tradovate Symbol" },
    { type: "heading", text: "1. Your Bookmap tier is crypto-only" },
    { type: "paragraph", html: "This is the big one, and it catches almost everyone who started on a free login. Bookmap's Digital and Digital+ tiers are built for crypto and digital assets. They do not include stocks or futures, period. So if you're on Digital or Digital+ and you type a CME futures symbol like ES or MES, Bookmap has nothing to give you and returns the license message. Real-time CME futures live on the Global and Global+ tiers. Bookmap's own documentation is blunt about it: its futures data package requires a Global or Global+ subscription. If you never consciously picked a paid futures plan, assume you're on a crypto-only tier and this is your problem." },
    { type: "heading", text: "2. You've maxed out the symbols your tier allows" },
    { type: "paragraph", html: "Even on the right tier, every Bookmap plan caps how many instruments you can display at the same time. The crypto tiers hold you to one, or a small handful, at once. Global and Global+ raise that ceiling to a larger set of concurrent symbols. If you're already watching your limit and you add one more, Bookmap can throw the same “license does not permit” wording, not because the market is wrong, but because you're out of slots. Close a chart you're not using and try again; if the symbol loads, you found your answer." },
    { type: "heading", text: "3. The CME data agreement isn't active" },
    { type: "paragraph", html: "Bookmap plans don't include exchange data or brokerage. That's a deliberate split. To see live CME futures, you need the exchange's real-time market-data entitlement, which means a signed non-professional (or professional) data agreement and its monthly exchange fee. You can satisfy that through Tradovate's own feed or through a separate data provider, but the entitlement has to exist somewhere. If it's never been signed or it lapsed, the symbol stays locked even on a Global plan. Exchange fees and agreement terms change over time, so treat any number you read as a starting point and confirm the current rate." },
    { type: "heading", text: "4. You're asking for a market the “free” deal never covered" },
    { type: "paragraph", html: "There's a well-known offer that pairs a Tradovate account with Bookmap at no market-data or subscription cost. The catch people miss: that deal is for a specific set of Coinbase Derivatives (FairX) crypto futures, like nano bitcoin. Those contracts sit on the digital-asset side, which is exactly why a free Digital-tier login can see them. The instant you type a CME product like ES or MES, you've stepped outside the offer into a market that requires the paid Global tier and a CME entitlement. Same platform, same connection, completely different license." },
    { type: "heading", text: "5. Tradovate is feeding partial-depth data" },
    { type: "paragraph", html: "This one doesn't cause the license error, but it's the related surprise that sends people looking. Tradovate provides <em>partial-depth</em> CME futures data to Bookmap, not the full order book. So even after you clear the license wall, the ladder may look thinner than you expected. If deep order-flow is the whole reason you use Bookmap, plan to pull data from a full-depth provider like dxFeed, Rithmic, or CQG while still routing your orders through Tradovate." },
    { type: "heading", text: "How to Fix It: Step-by-Step" },
    {
      type: "steps",
      items: [
        { title: "Identify your current Bookmap tier", html: "Open your Bookmap account page or the plan section inside the app and read the exact tier name. If it says Digital or Digital+, that's your answer for any futures symbol, those tiers can't show CME data no matter what you do at the connection level. If it says Global or Global+, your plan covers futures and you should move on to the data-entitlement and symbol-count checks. Don't guess this from memory; a lot of people are on a free tier they signed up for months ago and forgot about." },
        { title: "Match the plan to the market you trade", html: "If you're on a crypto-only tier and you need CME futures, upgrade to Global or Global+. Global gets you real-time stock and futures data and multiple concurrent symbols; Global+ adds a higher symbol count, marketplace add-ons, and trading directly from the chart. Compare the current packages on Bookmap's site before you commit, since the tier names, symbol limits, and prices shift over time. Pick the one whose symbol count matches how many charts you actually keep open at once." },
        { title: "Sort out the CME data entitlement", html: "With the right tier in place, make sure the exchange data itself is enabled. Decide whether Tradovate is your data source or just your broker. If Tradovate is feeding data, confirm your Tradovate account carries the CME real-time subscription and that you've signed the non-professional data agreement. If you're using a separate provider for data, sign the CME agreement on that provider's side instead. Either path needs the entitlement active before the symbol will resolve." },
        { title: "Re-subscribe to the symbol correctly", html: "Back in Bookmap, open the add-instrument dialog, choose the Tradovate platform, and enter the symbol. Use a valid, active contract, a real front-month like the current ES or MES contract, not a stale or expired month. Then hit subscribe. If the plan, entitlement, and symbol are all correct, the heatmap loads. If you still get the license message on the correct tier, you're almost certainly hitting a symbol-count cap or a missing data agreement, so revisit steps 2 and 3." },
        { title: "If it's a prop or evaluation account, involve the firm", html: "On a funded or evaluation Tradovate account, you don't control the market-data entitlements, the prop firm does. You can still upgrade your own Bookmap tier, but if the CME feed isn't switched on for the account, only the firm can enable it. Rules and available data vary by firm and account size, so check your firm's current policy and open a ticket with them if the symbol stays locked after your Bookmap plan is sorted." },
        { title: "Escalate to Bookmap support with specifics", html: "If you've confirmed a Global tier, an active CME agreement, and you're under the symbol cap and it <em>still</em> won't load, stop guessing and open a ticket. Give Bookmap support your exact plan name, the precise symbol and contract month, the full error text, and whether Tradovate is your data source, your broker, or both. Ask two flat questions: does my tier cover this market, and is the exchange data entitlement active on this account. Those two answers resolve nearly every case." },
      ],
    },
    { type: "heading", text: "Troubleshooting Table" },
    {
      type: "table",
      headers: ["Symptom", "Likely cause", "Fix"],
      rows: [
        ["Crypto symbols load, but ES/MES returns “license does not permit”", "On a Digital / Digital+ (crypto-only) tier", "Upgrade to Bookmap Global or Global+ for futures data"],
        ["Some futures load, but adding one more fails", "Hit the concurrent-symbol cap for your tier", "Close an unused chart, or move up a tier with a higher symbol count"],
        ["Right tier, but the symbol still won't resolve", "CME real-time data agreement not signed or lapsed", "Sign the non-professional data agreement and confirm the CME subscription"],
        ["The “free” Bookmap + Tradovate deal only shows crypto contracts", "Offer covers Coinbase (FairX) futures, not CME", "Add a paid Global tier and CME entitlement for CME products"],
        ["Symbol loads but the order book looks shallow", "Tradovate provides partial-depth CME data", "Use a full-depth data provider (dxFeed / Rithmic / CQG) for data, Tradovate for orders"],
        ["Prop account symbol stays locked after upgrading Bookmap", "Firm-controlled data entitlement not enabled", "Contact the prop firm to enable market data on the account"],
      ],
    },
    { type: "heading", text: "When the Data License Keeps Getting in the Way" },
    { type: "paragraph", html: "Here's the honest read: Bookmap is a fantastic order-flow tool, but its layered plan-and-entitlement model is a lot of overhead if your real goal is to <em>automate</em> a strategy on Tradovate rather than eyeball a heatmap. If you're mostly running a rules-based system, you don't necessarily need to buy a Global tier and stack a CME data license on top just to fire trades. That's the gap PickMyTrade fills." },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Automate straight from your charts.</strong> Build your logic in a platform like TradingView, fire a webhook, and PickMyTrade routes the order to your Tradovate account, no dependence on Bookmap's futures data tier to place a trade.",
        "<strong class='text-white'>Skip the heavy data-license overhead for execution.</strong> Your entry and exit logic lives in your charting tool, so automating orders doesn't hinge on a full-depth CME feed inside Bookmap.",
        "<strong class='text-white'>Mirror across accounts.</strong> The same signal can drive several evaluation or funded Tradovate accounts at once, which manual charting simply can't keep up with.",
        "<strong class='text-white'>Rate-limit-safe routing.</strong> Order flow is spaced to stay inside Tradovate's limits, so you avoid the retry storms that create their own lockouts.",
      ],
    },
    { type: "paragraph", html: "Keep Bookmap for what it's best at, reading liquidity when you want eyes on the tape, and let an automation bridge handle the execution that shouldn't depend on a data license at all." },
  ], de: [
    { type: "paragraph", html: "Sie verknüpfen Ihr Tradovate-Konto mit Bookmap, geben ein Symbol ein, das Sie täglich handeln, ES, MES, was auch immer, klicken auf Abonnieren, und statt einer Heatmap erhalten Sie nur eine knappe Meldung: <em>Ihre Lizenz erlaubt dies nicht</em>. Kein Chart, keine Daten, kein offensichtlicher Grund. Die Verbindung sieht in Ordnung aus, Ihr Tradovate-Login hat funktioniert, und trotzdem zeigt Ihnen die Plattform nicht das eine Instrument, für das Sie gekommen sind. Frustrierend, aber fast nie ein Fehler in der Software. Es handelt sich um eine Lizenz- und Datenberechtigungssperre, und sobald Sie die zwei dahinterliegenden Ebenen verstehen, ist die Lösung meist schnell gefunden. Schauen wir uns genau an, was diese Meldung bedeutet, warum sie besonders bei CME-Futures auftritt und wie Sie sie beheben." },
    {
      type: "checklist",
      heading: "Kurz-Checkliste, bevor Sie tiefer einsteigen",
      items: [
        "<strong class='text-white'>Prüfen Sie Ihre Bookmap-Planstufe.</strong> Digital und Digital+ sind reine Krypto-Tarife. CME-Futures wie ES und MES benötigen Global oder Global+.",
        "<strong class='text-white'>Zählen Sie Ihre Symbole.</strong> Jede Stufe begrenzt, wie viele Instrumente Sie gleichzeitig beobachten können. Überschreiten Sie das Limit, erhalten Sie dieselbe Lizenzmeldung.",
        "<strong class='text-white'>Bestätigen Sie die CME-Datenberechtigung.</strong> Echtzeit-Futures-Daten erfordern eine unterzeichnete Börsenvereinbarung mit eigener Gebühr, unabhängig vom Bookmap-Tarif.",
        "<strong class='text-white'>Wissen Sie, welchen Markt Sie eigentlich anfragen.</strong> Das &ldquo;kostenlose&rdquo; Tradovate-plus-Bookmap-Angebot deckt bestimmte Coinbase-(FairX)-Krypto-Futures ab, nicht die gesamte CME-Palette.",
        "<strong class='text-white'>Prüfen Sie Ihren Verbindungsmodus.</strong> Tradovate kann sowohl Daten als auch Ausführung liefern oder nur Orders weiterleiten, während ein anderer Anbieter die Daten liefert.",
        "<strong class='text-white'>Bei einem Prop-Konto beziehen Sie die Firma mit ein.</strong> Evaluierungs- und finanzierte Konten haben Datenberechtigungen, die die Firma kontrolliert, nicht Sie.",
      ],
    },
    { type: "heading", text: "Was &ldquo;Lizenz erlaubt dies nicht&rdquo; wirklich bedeutet" },
    { type: "paragraph", html: "Bookmap trennt zwei Dinge, die Trader gerne vermischen: den <strong class='text-white'>Tarif</strong>, den Sie bei Bookmap bezahlen, und die <strong class='text-white'>Marktdaten</strong>, zu deren Bezug Sie von einer Börse berechtigt sind. Die Meldung &ldquo;Lizenz erlaubt dies nicht&rdquo; teilt Ihnen mit, dass eines dieser beiden Dinge für das angeforderte Symbol fehlt. Entweder deckt Ihre Bookmap-Stufe diesen Markt nicht ab, oder die Börsendatenlizenz hinter dem Feed ist auf Ihrem Konto nicht aktiv. Die Tradovate-Verbindung selbst funktioniert, deshalb ist Ihr Login durchgegangen und die Plattform hat Ihre Zugangsdaten akzeptiert. Fehlgeschlagen ist die Berechtigungsprüfung, die genau in dem Moment läuft, in dem Sie versuchen, Live-Daten für ein bestimmtes Instrument abzurufen." },
    { type: "paragraph", html: "Das ist wichtig, weil die beiden Ebenen völlig unterschiedliche Lösungen haben. Ein Tarifproblem lösen Sie durch ein Upgrade Ihres Bookmap-Abonnements. Ein Datenberechtigungsproblem lösen Sie, indem Sie die Börsenvereinbarung unterzeichnen und die Börsengebühr zahlen, oder indem Ihre Prop-Firma es freischaltet. Verfolgen Sie die falsche Spur, verbringen Sie einen ganzen Nachmittag damit, eine Software neu zu installieren, die nie kaputt war. Die erste Aufgabe besteht also darin, herauszufinden, an welcher Sperre Sie hängen." },
    { type: "heading", text: "Warum Bookmap ein Tradovate-Symbol blockiert" },
    { type: "heading", text: "1. Ihre Bookmap-Stufe ist reines Krypto" },
    { type: "paragraph", html: "Das ist der Hauptgrund, und er erwischt fast jeden, der mit einem kostenlosen Login gestartet ist. Bookmaps Digital- und Digital+-Stufen sind für Krypto und digitale Assets gebaut. Sie beinhalten weder Aktien noch Futures, Punkt. Wenn Sie also auf Digital oder Digital+ sind und ein CME-Futures-Symbol wie ES oder MES eingeben, hat Bookmap nichts, was es Ihnen geben könnte, und gibt die Lizenzmeldung zurück. Echtzeit-CME-Futures gibt es auf den Stufen Global und Global+. Bookmaps eigene Dokumentation ist da unmissverständlich: Das Futures-Datenpaket erfordert ein Global- oder Global+-Abonnement. Wenn Sie nie bewusst einen bezahlten Futures-Tarif gewählt haben, gehen Sie davon aus, dass Sie auf einer reinen Krypto-Stufe sind, und das ist Ihr Problem." },
    { type: "heading", text: "2. Sie haben die Symbolgrenze Ihrer Stufe ausgeschöpft" },
    { type: "paragraph", html: "Selbst auf der richtigen Stufe begrenzt jeder Bookmap-Tarif, wie viele Instrumente Sie gleichzeitig anzeigen können. Die Krypto-Stufen erlauben Ihnen nur eines oder eine kleine Handvoll gleichzeitig. Global und Global+ heben diese Grenze auf eine größere Anzahl gleichzeitiger Symbole an. Wenn Sie bereits Ihr Limit ausgeschöpft haben und ein weiteres hinzufügen, kann Bookmap denselben &ldquo;Lizenz erlaubt dies nicht&rdquo;-Wortlaut ausgeben, nicht weil der Markt falsch ist, sondern weil Ihnen die Plätze ausgegangen sind. Schließen Sie einen Chart, den Sie nicht nutzen, und versuchen Sie es erneut; lädt das Symbol dann, haben Sie Ihre Antwort gefunden." },
    { type: "heading", text: "3. Die CME-Datenvereinbarung ist nicht aktiv" },
    { type: "paragraph", html: "Bookmap-Tarife beinhalten weder Börsendaten noch eine Brokerage. Das ist eine bewusste Trennung. Um Live-CME-Futures zu sehen, benötigen Sie die Echtzeit-Marktdatenberechtigung der Börse, was eine unterzeichnete Non-Professional-(oder Professional-)Datenvereinbarung sowie deren monatliche Börsengebühr bedeutet. Sie können das über Tradovates eigenen Feed oder über einen separaten Datenanbieter erfüllen, aber die Berechtigung muss irgendwo existieren. Wurde sie nie unterzeichnet oder ist sie abgelaufen, bleibt das Symbol selbst bei einem Global-Tarif gesperrt. Börsengebühren und Vereinbarungsbedingungen ändern sich mit der Zeit, behandeln Sie also jede Zahl, die Sie lesen, als Ausgangspunkt und bestätigen Sie den aktuellen Satz." },
    { type: "heading", text: "4. Sie fragen einen Markt an, den das &ldquo;kostenlose&rdquo; Angebot nie abgedeckt hat" },
    { type: "paragraph", html: "Es gibt ein bekanntes Angebot, das ein Tradovate-Konto ohne Marktdaten- oder Abonnementkosten mit Bookmap kombiniert. Der Haken, den viele übersehen: Dieses Angebot gilt für eine bestimmte Gruppe von Coinbase-Derivatives-(FairX)-Krypto-Futures, wie zum Beispiel Nano-Bitcoin. Diese Kontrakte gehören zur Digital-Asset-Seite, weshalb ein kostenloses Digital-Stufen-Login sie überhaupt anzeigen kann. In dem Moment, in dem Sie ein CME-Produkt wie ES oder MES eingeben, verlassen Sie das Angebot und betreten einen Markt, der die bezahlte Global-Stufe und eine CME-Berechtigung erfordert. Gleiche Plattform, gleiche Verbindung, völlig andere Lizenz." },
    { type: "heading", text: "5. Tradovate liefert Daten mit reduzierter Tiefe" },
    { type: "paragraph", html: "Das löst nicht den Lizenzfehler aus, ist aber die verwandte Überraschung, die Trader zum Nachforschen bringt. Tradovate liefert Bookmap <em>Partial-Depth</em>-CME-Futures-Daten, nicht das vollständige Orderbuch. Selbst nachdem Sie die Lizenzsperre überwunden haben, kann die Ladder also dünner aussehen als erwartet. Wenn tiefe Order-Flow-Daten der ganze Grund sind, warum Sie Bookmap nutzen, planen Sie, Daten von einem Full-Depth-Anbieter wie dxFeed, Rithmic oder CQG zu beziehen, während Sie Ihre Orders weiterhin über Tradovate routen." },
    { type: "heading", text: "So beheben Sie es: Schritt für Schritt" },
    {
      type: "steps",
      items: [
        { title: "Ermitteln Sie Ihre aktuelle Bookmap-Stufe", html: "Öffnen Sie Ihre Bookmap-Kontoseite oder den Tarifbereich in der App und lesen Sie die genaue Stufenbezeichnung. Steht dort Digital oder Digital+, ist das Ihre Antwort für jedes Futures-Symbol, diese Stufen können unabhängig von der Verbindungsebene keine CME-Daten anzeigen. Steht dort Global oder Global+, deckt Ihr Tarif Futures ab, und Sie sollten mit den Prüfungen zu Datenberechtigung und Symbolanzahl fortfahren. Verlassen Sie sich hier nicht auf Ihr Gedächtnis; viele Nutzer haben vor Monaten eine kostenlose Stufe abgeschlossen und es vergessen." },
        { title: "Passen Sie den Tarif an den gehandelten Markt an", html: "Sind Sie auf einer reinen Krypto-Stufe und benötigen CME-Futures, upgraden Sie auf Global oder Global+. Global liefert Ihnen Echtzeit-Aktien- und Futures-Daten sowie mehrere gleichzeitige Symbole; Global+ erhöht die Symbolanzahl weiter und ergänzt Marketplace-Add-ons sowie Trading direkt aus dem Chart. Vergleichen Sie die aktuellen Pakete auf der Bookmap-Website, bevor Sie sich festlegen, da sich Stufennamen, Symbolgrenzen und Preise im Laufe der Zeit ändern. Wählen Sie die Stufe, deren Symbolanzahl zu den Charts passt, die Sie tatsächlich gleichzeitig geöffnet haben." },
        { title: "Klären Sie die CME-Datenberechtigung", html: "Sobald die richtige Stufe steht, stellen Sie sicher, dass die Börsendaten selbst aktiviert sind. Entscheiden Sie, ob Tradovate Ihre Datenquelle oder nur Ihr Broker ist. Liefert Tradovate die Daten, bestätigen Sie, dass Ihr Tradovate-Konto das CME-Echtzeit-Abonnement führt und Sie die Non-Professional-Datenvereinbarung unterzeichnet haben. Nutzen Sie einen separaten Anbieter für Daten, unterzeichnen Sie stattdessen die CME-Vereinbarung auf dessen Seite. In beiden Fällen muss die Berechtigung aktiv sein, bevor sich das Symbol auflösen lässt." },
        { title: "Abonnieren Sie das Symbol erneut korrekt", html: "Öffnen Sie in Bookmap den Dialog zum Hinzufügen eines Instruments, wählen Sie die Tradovate-Plattform und geben Sie das Symbol ein. Verwenden Sie einen gültigen, aktiven Kontrakt, einen echten Front-Month wie den aktuellen ES- oder MES-Kontrakt, keinen veralteten oder abgelaufenen Monat. Klicken Sie dann auf Abonnieren. Sind Tarif, Berechtigung und Symbol korrekt, lädt die Heatmap. Erhalten Sie die Lizenzmeldung weiterhin auf der richtigen Stufe, stoßen Sie fast sicher an ein Symbolanzahl-Limit oder eine fehlende Datenvereinbarung, prüfen Sie also erneut die Schritte 2 und 3." },
        { title: "Bei einem Prop- oder Evaluierungskonto die Firma einbeziehen", html: "Bei einem finanzierten oder Evaluierungs-Tradovate-Konto kontrollieren nicht Sie die Marktdatenberechtigungen, sondern die Prop-Firma. Sie können Ihre eigene Bookmap-Stufe trotzdem upgraden, aber ist der CME-Feed für das Konto nicht freigeschaltet, kann nur die Firma dies aktivieren. Regeln und verfügbare Daten variieren je nach Firma und Kontogröße, prüfen Sie also die aktuelle Richtlinie Ihrer Firma und eröffnen Sie ein Ticket, falls das Symbol nach der Klärung Ihres Bookmap-Tarifs weiterhin gesperrt bleibt." },
        { title: "Eskalieren Sie mit konkreten Angaben an den Bookmap-Support", html: "Haben Sie eine Global-Stufe, eine aktive CME-Vereinbarung und liegen Sie unter dem Symbollimit, lädt aber <em>immer noch</em> nichts, hören Sie auf zu raten und eröffnen Sie ein Ticket. Geben Sie dem Bookmap-Support Ihren genauen Tarifnamen, das präzise Symbol samt Kontraktmonat, den vollständigen Fehlertext und ob Tradovate Ihre Datenquelle, Ihr Broker oder beides ist. Stellen Sie zwei klare Fragen: Deckt meine Stufe diesen Markt ab, und ist die Börsendatenberechtigung für dieses Konto aktiv. Diese beiden Antworten klären fast jeden Fall." },
      ],
    },
    { type: "heading", text: "Fehlerbehebungstabelle" },
    {
      type: "table",
      headers: ["Symptom", "Wahrscheinliche Ursache", "Lösung"],
      rows: [
        ["Krypto-Symbole laden, aber ES/MES gibt &ldquo;Lizenz erlaubt dies nicht&rdquo; zurück", "Auf einer Digital-/Digital+-Stufe (nur Krypto)", "Upgrade auf Bookmap Global oder Global+ für Futures-Daten"],
        ["Einige Futures laden, aber ein weiteres schlägt fehl", "Limit für gleichzeitige Symbole der Stufe erreicht", "Schließen Sie einen ungenutzten Chart oder wechseln Sie zu einer Stufe mit höherem Symbollimit"],
        ["Richtige Stufe, aber das Symbol löst sich weiterhin nicht auf", "CME-Echtzeit-Datenvereinbarung nicht unterzeichnet oder abgelaufen", "Unterzeichnen Sie die Non-Professional-Datenvereinbarung und bestätigen Sie das CME-Abonnement"],
        ["Das &ldquo;kostenlose&rdquo; Bookmap-plus-Tradovate-Angebot zeigt nur Krypto-Kontrakte", "Angebot deckt Coinbase-(FairX)-Futures ab, nicht CME", "Fügen Sie eine bezahlte Global-Stufe und CME-Berechtigung für CME-Produkte hinzu"],
        ["Symbol lädt, aber das Orderbuch wirkt dünn", "Tradovate liefert CME-Daten mit reduzierter Tiefe", "Nutzen Sie einen Full-Depth-Datenanbieter (dxFeed / Rithmic / CQG) für Daten, Tradovate für Orders"],
        ["Prop-Konto-Symbol bleibt nach Bookmap-Upgrade gesperrt", "Firmenkontrollierte Datenberechtigung nicht aktiviert", "Kontaktieren Sie die Prop-Firma, um Marktdaten für das Konto zu aktivieren"],
      ],
    },
    { type: "heading", text: "Wenn die Datenlizenz immer wieder im Weg steht" },
    { type: "paragraph", html: "Ehrlich gesagt: Bookmap ist ein hervorragendes Order-Flow-Tool, aber sein mehrschichtiges Tarif-und-Berechtigungsmodell ist ziemlich viel Aufwand, wenn Ihr eigentliches Ziel darin besteht, eine Strategie auf Tradovate zu <em>automatisieren</em>, statt eine Heatmap im Blick zu behalten. Betreiben Sie überwiegend ein regelbasiertes System, müssen Sie nicht unbedingt eine Global-Stufe kaufen und eine CME-Datenlizenz obendrauf stapeln, nur um Trades auszulösen. Genau diese Lücke schließt PickMyTrade." },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Automatisieren Sie direkt aus Ihren Charts.</strong> Bauen Sie Ihre Logik in einer Plattform wie TradingView, lösen Sie einen Webhook aus, und PickMyTrade leitet die Order an Ihr Tradovate-Konto weiter, ohne Abhängigkeit von Bookmaps Futures-Datenstufe, um einen Trade zu platzieren.",
        "<strong class='text-white'>Sparen Sie sich den schweren Datenlizenz-Aufwand für die Ausführung.</strong> Ihre Ein- und Ausstiegslogik lebt in Ihrem Charting-Tool, sodass die Automatisierung von Orders nicht von einem Full-Depth-CME-Feed innerhalb von Bookmap abhängt.",
        "<strong class='text-white'>Spiegeln Sie über mehrere Konten hinweg.</strong> Dasselbe Signal kann mehrere Evaluierungs- oder finanzierte Tradovate-Konten gleichzeitig steuern, womit manuelles Charting schlicht nicht mithalten kann.",
        "<strong class='text-white'>Ratenlimit-sicheres Routing.</strong> Der Orderfluss wird so getaktet, dass er innerhalb der Tradovate-Limits bleibt, sodass Sie die Retry-Stürme vermeiden, die eigene Sperren auslösen.",
      ],
    },
    { type: "paragraph", html: "Nutzen Sie Bookmap weiterhin für das, was es am besten kann, Liquidität lesen, wenn Sie einen Blick auf das Tape werfen wollen, und überlassen Sie die Ausführung, die nicht von einer Datenlizenz abhängen sollte, einer Automatisierungsbrücke." },
  ], es: [
    { type: "paragraph", html: "Vincula su cuenta de Tradovate con Bookmap, escribe un símbolo que opera todos los días, ES, MES, lo que sea, hace clic en suscribirse y, en lugar de un mapa de calor, recibe un mensaje escueto: <em>su licencia no lo permite</em>. Sin gráfico, sin datos, sin motivo evidente. La conexión parece correcta, su inicio de sesión en Tradovate funcionó, y aun así la plataforma no le muestra el único instrumento que buscaba. Frustrante, pero casi nunca es un error del software. Es una barrera de licencia y de permisos de datos, y una vez que entiende las dos capas que hay detrás, la solución suele ser rápida. Veamos exactamente qué significa ese mensaje, por qué aparece sobre todo en los futuros de CME y cómo resolverlo." },
    {
      type: "checklist",
      heading: "Lista rápida antes de profundizar",
      items: [
        "<strong class='text-white'>Revise su nivel de plan de Bookmap.</strong> Digital y Digital+ son solo para cripto. Los futuros de CME como ES y MES requieren Global o Global+.",
        "<strong class='text-white'>Cuente sus símbolos.</strong> Cada nivel limita cuántos instrumentos puede vigilar a la vez. Si supera ese límite, obtiene el mismo mensaje de licencia.",
        "<strong class='text-white'>Confirme el permiso de datos de CME.</strong> Los datos de futuros en tiempo real requieren un acuerdo firmado con la bolsa y su tarifa aparte, independiente del plan de Bookmap.",
        "<strong class='text-white'>Sepa qué mercado está solicitando en realidad.</strong> La oferta &ldquo;gratuita&rdquo; de Tradovate más Bookmap cubre futuros cripto específicos de Coinbase (FairX), no toda la gama de CME.",
        "<strong class='text-white'>Revise su modo de conexión.</strong> Tradovate puede suministrar datos y ejecución, o solo enrutar órdenes mientras otro proveedor aporta los datos.",
        "<strong class='text-white'>Si tiene una cuenta prop, involucre a la firma.</strong> Las cuentas de evaluación y financiadas tienen permisos de datos que controla la firma, no usted.",
      ],
    },
    { type: "heading", text: "Qué significa realmente &ldquo;la licencia no lo permite&rdquo;" },
    { type: "paragraph", html: "Bookmap mantiene separadas dos cosas que los traders suelen mezclar: el <strong class='text-white'>plan</strong> que paga a Bookmap y los <strong class='text-white'>datos de mercado</strong> a los que tiene derecho por parte de una bolsa. El mensaje &ldquo;la licencia no lo permite&rdquo; es la forma en que Bookmap le indica que falta uno de esos dos elementos para el símbolo solicitado. O bien su nivel de Bookmap no incluye ese mercado, o la licencia de datos de la bolsa detrás del feed no está activa en su cuenta. La conexión con Tradovate en sí funciona, por eso su inicio de sesión se completó y la plataforma aceptó sus credenciales. Lo que falló es la verificación de permisos que se ejecuta en el instante en que intenta obtener datos en vivo de un instrumento específico." },
    { type: "paragraph", html: "Esto importa porque las dos capas tienen soluciones completamente distintas. Un problema de plan se resuelve actualizando su suscripción de Bookmap. Un problema de permiso de datos se resuelve firmando el acuerdo con la bolsa y pagando su tarifa, o haciendo que su firma prop lo habilite. Si persigue la causa equivocada, pasará toda una tarde reinstalando un software que nunca estuvo roto. Así que la primera tarea es averiguar contra qué barrera ha chocado." },
    { type: "heading", text: "Por qué Bookmap bloquea un símbolo de Tradovate" },
    { type: "heading", text: "1. Su nivel de Bookmap es solo para cripto" },
    { type: "paragraph", html: "Este es el motivo más frecuente, y atrapa a casi todos los que empezaron con un inicio de sesión gratuito. Los niveles Digital y Digital+ de Bookmap están diseñados para cripto y activos digitales. No incluyen acciones ni futuros, punto. Así que si está en Digital o Digital+ y escribe un símbolo de futuros de CME como ES o MES, Bookmap no tiene nada que darle y devuelve el mensaje de licencia. Los futuros de CME en tiempo real viven en los niveles Global y Global+. La propia documentación de Bookmap lo dice sin rodeos: su paquete de datos de futuros requiere una suscripción Global o Global+. Si nunca eligió de forma consciente un plan de futuros de pago, asuma que está en un nivel exclusivo de cripto y que ese es su problema." },
    { type: "heading", text: "2. Ha agotado los símbolos que permite su nivel" },
    { type: "paragraph", html: "Incluso en el nivel correcto, cada plan de Bookmap limita cuántos instrumentos puede mostrar a la vez. Los niveles cripto lo limitan a uno, o a un puñado, a la vez. Global y Global+ elevan ese límite a un conjunto mayor de símbolos simultáneos. Si ya está viendo el máximo permitido y añade uno más, Bookmap puede mostrar el mismo mensaje de &ldquo;la licencia no lo permite&rdquo;, no porque el mercado sea incorrecto, sino porque se quedó sin espacios. Cierre un gráfico que no esté usando y vuelva a intentarlo; si el símbolo carga, ha encontrado la respuesta." },
    { type: "heading", text: "3. El acuerdo de datos de CME no está activo" },
    { type: "paragraph", html: "Los planes de Bookmap no incluyen datos de la bolsa ni intermediación. Es una separación deliberada. Para ver futuros de CME en vivo, necesita el permiso de datos de mercado en tiempo real de la bolsa, lo que implica un acuerdo de datos no profesional (o profesional) firmado y su tarifa mensual de la bolsa. Puede cubrir eso a través del propio feed de Tradovate o de un proveedor de datos independiente, pero el permiso tiene que existir en algún lugar. Si nunca se firmó o venció, el símbolo permanece bloqueado incluso con un plan Global. Las tarifas y condiciones de los acuerdos con la bolsa cambian con el tiempo, así que trate cualquier cifra que lea como un punto de partida y confirme la tarifa vigente." },
    { type: "heading", text: "4. Está solicitando un mercado que la oferta &ldquo;gratuita&rdquo; nunca cubrió" },
    { type: "paragraph", html: "Existe una oferta bien conocida que combina una cuenta de Tradovate con Bookmap sin costo de datos de mercado ni de suscripción. La trampa que muchos pasan por alto: esa oferta corresponde a un conjunto específico de futuros cripto de Coinbase Derivatives (FairX), como el nano bitcoin. Esos contratos están del lado de los activos digitales, y por eso un inicio de sesión gratuito de nivel Digital puede verlos. En el momento en que escribe un producto de CME como ES o MES, sale de esa oferta y entra en un mercado que requiere el nivel Global de pago y un permiso de CME. Misma plataforma, misma conexión, licencia completamente distinta." },
    { type: "heading", text: "5. Tradovate suministra datos de profundidad parcial" },
    { type: "paragraph", html: "Esto no provoca el error de licencia, pero es la sorpresa relacionada que hace que la gente busque respuestas. Tradovate suministra a Bookmap datos de futuros de CME de <em>profundidad parcial</em>, no el libro de órdenes completo. Así que, incluso después de resolver la barrera de licencia, la escalera puede verse más delgada de lo esperado. Si el flujo de órdenes profundo es la razón principal por la que usa Bookmap, planee obtener los datos de un proveedor de profundidad completa como dxFeed, Rithmic o CQG mientras sigue enrutando sus órdenes a través de Tradovate." },
    { type: "heading", text: "Cómo solucionarlo: paso a paso" },
    {
      type: "steps",
      items: [
        { title: "Identifique su nivel actual de Bookmap", html: "Abra la página de su cuenta de Bookmap o la sección de planes dentro de la app y lea el nombre exacto del nivel. Si dice Digital o Digital+, esa es su respuesta para cualquier símbolo de futuros, esos niveles no pueden mostrar datos de CME sin importar lo que haga a nivel de conexión. Si dice Global o Global+, su plan cubre futuros y debe pasar a las comprobaciones de permiso de datos y cantidad de símbolos. No lo suponga de memoria; muchas personas están en un nivel gratuito que contrataron hace meses y olvidaron." },
        { title: "Ajuste el plan al mercado que opera", html: "Si está en un nivel exclusivo de cripto y necesita futuros de CME, actualice a Global o Global+. Global le da datos de acciones y futuros en tiempo real y varios símbolos simultáneos; Global+ añade una cantidad de símbolos mayor, complementos del marketplace y operar directamente desde el gráfico. Compare los paquetes actuales en el sitio de Bookmap antes de decidirse, ya que los nombres de nivel, los límites de símbolos y los precios cambian con el tiempo. Elija el que tenga una cantidad de símbolos acorde a cuántos gráficos mantiene realmente abiertos a la vez." },
        { title: "Resuelva el permiso de datos de CME", html: "Con el nivel correcto en su lugar, asegúrese de que los datos de la bolsa estén habilitados. Decida si Tradovate es su fuente de datos o solo su bróker. Si Tradovate suministra los datos, confirme que su cuenta de Tradovate tiene la suscripción en tiempo real de CME y que firmó el acuerdo de datos no profesional. Si usa un proveedor independiente para los datos, firme el acuerdo de CME del lado de ese proveedor. Cualquiera de los dos caminos necesita el permiso activo antes de que el símbolo se resuelva." },
        { title: "Vuelva a suscribirse al símbolo correctamente", html: "De vuelta en Bookmap, abra el cuadro de añadir instrumento, elija la plataforma Tradovate e introduzca el símbolo. Use un contrato válido y activo, un mes frontal real como el contrato ES o MES vigente, no un mes vencido o caducado. Luego pulse suscribirse. Si el plan, el permiso y el símbolo son correctos, el mapa de calor carga. Si sigue recibiendo el mensaje de licencia en el nivel correcto, casi con seguridad está topando con un límite de cantidad de símbolos o un acuerdo de datos faltante, así que revise de nuevo los pasos 2 y 3." },
        { title: "Si es una cuenta prop o de evaluación, involucre a la firma", html: "En una cuenta de Tradovate financiada o de evaluación, usted no controla los permisos de datos de mercado, la firma prop sí. Aun puede actualizar su propio nivel de Bookmap, pero si el feed de CME no está activado para la cuenta, solo la firma puede habilitarlo. Las reglas y los datos disponibles varían según la firma y el tamaño de la cuenta, así que revise la política actual de su firma y abra un ticket con ellos si el símbolo sigue bloqueado después de resolver su plan de Bookmap." },
        { title: "Escale al soporte de Bookmap con detalles específicos", html: "Si ya confirmó un nivel Global, un acuerdo de CME activo, está por debajo del límite de símbolos y <em>aun así</em> no carga, deje de adivinar y abra un ticket. Facilite al soporte de Bookmap el nombre exacto de su plan, el símbolo y mes de contrato precisos, el texto completo del error y si Tradovate es su fuente de datos, su bróker o ambos. Haga dos preguntas directas: ¿mi nivel cubre este mercado?, y ¿el permiso de datos de la bolsa está activo en esta cuenta? Esas dos respuestas resuelven casi todos los casos." },
      ],
    },
    { type: "heading", text: "Tabla de solución de problemas" },
    {
      type: "table",
      headers: ["Síntoma", "Causa probable", "Solución"],
      rows: [
        ["Los símbolos cripto cargan, pero ES/MES devuelve &ldquo;la licencia no lo permite&rdquo;", "Está en un nivel Digital / Digital+ (solo cripto)", "Actualice a Bookmap Global o Global+ para datos de futuros"],
        ["Algunos futuros cargan, pero al añadir uno más falla", "Alcanzó el límite de símbolos simultáneos de su nivel", "Cierre un gráfico sin usar, o suba a un nivel con mayor límite de símbolos"],
        ["Nivel correcto, pero el símbolo sigue sin resolverse", "El acuerdo de datos en tiempo real de CME no está firmado o venció", "Firme el acuerdo de datos no profesional y confirme la suscripción de CME"],
        ["La oferta &ldquo;gratuita&rdquo; de Bookmap más Tradovate solo muestra contratos cripto", "La oferta cubre futuros de Coinbase (FairX), no CME", "Añada un nivel Global de pago y el permiso de CME para productos de CME"],
        ["El símbolo carga pero el libro de órdenes se ve superficial", "Tradovate suministra datos de CME de profundidad parcial", "Use un proveedor de datos de profundidad completa (dxFeed / Rithmic / CQG) para los datos, y Tradovate para las órdenes"],
        ["El símbolo de la cuenta prop sigue bloqueado tras actualizar Bookmap", "Permiso de datos controlado por la firma no habilitado", "Contacte a la firma prop para habilitar los datos de mercado en la cuenta"],
      ],
    },
    { type: "heading", text: "Cuando la licencia de datos sigue estorbando" },
    { type: "paragraph", html: "Seamos francos: Bookmap es una herramienta de flujo de órdenes fantástica, pero su modelo de plan y permisos por capas supone mucho esfuerzo si su verdadero objetivo es <em>automatizar</em> una estrategia en Tradovate en lugar de vigilar un mapa de calor. Si opera sobre todo un sistema basado en reglas, no necesariamente necesita comprar un nivel Global y sumarle una licencia de datos de CME solo para disparar operaciones. Ahí es donde PickMyTrade cubre esa brecha." },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Automatice directamente desde sus gráficos.</strong> Construya su lógica en una plataforma como TradingView, dispare un webhook, y PickMyTrade enruta la orden a su cuenta de Tradovate, sin depender del nivel de datos de futuros de Bookmap para colocar una operación.",
        "<strong class='text-white'>Evite la pesada sobrecarga de licencias de datos para la ejecución.</strong> Su lógica de entrada y salida vive en su herramienta de gráficos, así que automatizar órdenes no depende de un feed de CME de profundidad completa dentro de Bookmap.",
        "<strong class='text-white'>Replique en varias cuentas.</strong> La misma señal puede impulsar a la vez varias cuentas de Tradovate de evaluación o financiadas, algo que el trading manual con gráficos simplemente no puede igualar.",
        "<strong class='text-white'>Enrutamiento seguro para los límites de tasa.</strong> El flujo de órdenes se espacia para mantenerse dentro de los límites de Tradovate, así evita las tormentas de reintentos que provocan sus propios bloqueos.",
      ],
    },
    { type: "paragraph", html: "Conserve Bookmap para lo que mejor hace, leer la liquidez cuando quiere tener el ojo puesto en el tape, y deje que un puente de automatización se encargue de la ejecución que no debería depender de una licencia de datos." },
  ], fr: [
    { type: "paragraph", html: "Vous reliez votre compte Tradovate à Bookmap, vous saisissez un symbole que vous tradez tous les jours, ES, MES, peu importe, vous cliquez sur s'abonner, et au lieu d'une heatmap, vous obtenez un simple message : <em>votre licence ne le permet pas</em>. Pas de graphique, pas de données, aucune raison évidente. La connexion semble correcte, votre connexion Tradovate a fonctionné, et pourtant la plateforme refuse de vous afficher le seul instrument que vous cherchiez. Frustrant, mais ce n'est presque jamais un bug. C'est un blocage lié à la licence et aux droits d'accès aux données, et une fois que vous comprenez les deux niveaux en jeu, la solution est généralement rapide. Voyons précisément ce que signifie ce message, pourquoi il touche en particulier les futures CME, et comment le résoudre." },
    {
      type: "checklist",
      heading: "Liste de vérification rapide avant d'aller plus loin",
      items: [
        "<strong class='text-white'>Vérifiez votre niveau d'abonnement Bookmap.</strong> Digital et Digital+ sont réservés aux cryptomonnaies. Les futures CME comme ES et MES nécessitent Global ou Global+.",
        "<strong class='text-white'>Comptez vos symboles.</strong> Chaque niveau plafonne le nombre d'instruments que vous pouvez surveiller à la fois. Dépassez ce plafond et vous obtenez le même message de licence.",
        "<strong class='text-white'>Confirmez le droit d'accès aux données CME.</strong> Les données de futures en temps réel nécessitent un accord signé avec la bourse et son propre tarif, indépendamment de l'abonnement Bookmap.",
        "<strong class='text-white'>Sachez quel marché vous demandez réellement.</strong> L'offre « gratuite » Tradovate plus Bookmap couvre des futures crypto spécifiques de Coinbase (FairX), pas l'ensemble de l'offre CME.",
        "<strong class='text-white'>Vérifiez votre mode de connexion.</strong> Tradovate peut fournir à la fois les données et l'exécution, ou simplement acheminer les ordres pendant qu'un autre fournisseur alimente les données.",
        "<strong class='text-white'>Sur un compte prop, impliquez la société.</strong> Les comptes d'évaluation et financés ont des droits d'accès aux données contrôlés par la société, pas par vous.",
      ],
    },
    { type: "heading", text: "Ce que signifie vraiment « la licence ne le permet pas »" },
    { type: "paragraph", html: "Bookmap distingue deux choses que les traders ont tendance à confondre : l'<strong class='text-white'>abonnement</strong> que vous payez à Bookmap, et les <strong class='text-white'>données de marché</strong> auxquelles vous avez droit de la part d'une bourse. Le message « la licence ne le permet pas » indique que l'un de ces deux éléments manque pour le symbole demandé. Soit votre niveau Bookmap ne couvre pas ce marché, soit la licence de données de la bourse derrière le flux n'est pas active sur votre compte. La connexion Tradovate elle-même fonctionne, c'est pourquoi votre connexion a abouti et la plateforme a accepté vos identifiants. Ce qui a échoué, c'est la vérification des droits qui s'exécute à l'instant où vous tentez de récupérer des données en direct pour un instrument précis." },
    { type: "paragraph", html: "C'est important car les deux niveaux ont des solutions totalement différentes. Un problème d'abonnement se règle en mettant à niveau votre abonnement Bookmap. Un problème de droits d'accès aux données se règle en signant l'accord avec la bourse et en payant son tarif, ou en demandant à votre société de prop trading de l'activer. Si vous vous trompez de piste, vous passerez tout un après-midi à réinstaller un logiciel qui n'a jamais été défaillant. La première étape consiste donc à déterminer contre quel blocage vous butez." },
    { type: "heading", text: "Pourquoi Bookmap bloque un symbole Tradovate" },
    { type: "heading", text: "1. Votre niveau Bookmap est réservé aux cryptomonnaies" },
    { type: "paragraph", html: "C'est la cause la plus fréquente, et elle piège presque tous ceux qui ont commencé avec une connexion gratuite. Les niveaux Digital et Digital+ de Bookmap sont conçus pour les cryptomonnaies et les actifs numériques. Ils n'incluent ni actions ni futures, un point c'est tout. Donc si vous êtes sur Digital ou Digital+ et que vous saisissez un symbole de futures CME comme ES ou MES, Bookmap n'a rien à vous offrir et renvoie le message de licence. Les futures CME en temps réel sont réservés aux niveaux Global et Global+. La documentation de Bookmap elle-même est claire à ce sujet : son offre de données de futures nécessite un abonnement Global ou Global+. Si vous n'avez jamais consciemment choisi un abonnement futures payant, partez du principe que vous êtes sur un niveau réservé aux cryptomonnaies et que c'est votre problème." },
    { type: "heading", text: "2. Vous avez atteint le nombre maximal de symboles autorisés par votre niveau" },
    { type: "paragraph", html: "Même sur le bon niveau, chaque abonnement Bookmap plafonne le nombre d'instruments que vous pouvez afficher simultanément. Les niveaux crypto vous limitent à un seul, ou à une petite poignée, à la fois. Global et Global+ relèvent ce plafond à un ensemble plus large de symboles simultanés. Si vous atteignez déjà votre limite et que vous en ajoutez un de plus, Bookmap peut afficher le même message « la licence ne le permet pas », non pas parce que le marché est incorrect, mais parce que vous n'avez plus de place disponible. Fermez un graphique que vous n'utilisez pas et réessayez ; si le symbole se charge, vous avez trouvé votre réponse." },
    { type: "heading", text: "3. L'accord de données CME n'est pas actif" },
    { type: "paragraph", html: "Les abonnements Bookmap n'incluent ni les données de la bourse ni le courtage. C'est une séparation délibérée. Pour voir les futures CME en direct, vous avez besoin du droit d'accès aux données de marché en temps réel de la bourse, ce qui implique un accord de données non professionnel (ou professionnel) signé et son tarif mensuel auprès de la bourse. Vous pouvez satisfaire cette exigence via le flux propre de Tradovate ou via un fournisseur de données distinct, mais le droit d'accès doit exister quelque part. S'il n'a jamais été signé ou s'il a expiré, le symbole reste bloqué même avec un abonnement Global. Les tarifs et les conditions d'accord de la bourse changent avec le temps, considérez donc tout chiffre lu comme un point de départ et vérifiez le tarif actuel." },
    { type: "heading", text: "4. Vous demandez un marché que l'offre « gratuite » n'a jamais couvert" },
    { type: "paragraph", html: "Il existe une offre bien connue qui associe un compte Tradovate à Bookmap sans frais de données de marché ni d'abonnement. Le piège que beaucoup ratent : cette offre concerne un ensemble spécifique de futures crypto Coinbase Derivatives (FairX), comme le nano bitcoin. Ces contrats se situent du côté des actifs numériques, ce qui explique justement pourquoi une connexion gratuite de niveau Digital peut les afficher. Dès que vous saisissez un produit CME comme ES ou MES, vous sortez de cette offre pour entrer dans un marché qui exige le niveau Global payant et un droit d'accès CME. Même plateforme, même connexion, licence totalement différente." },
    { type: "heading", text: "5. Tradovate fournit des données à profondeur partielle" },
    { type: "paragraph", html: "Cela ne provoque pas l'erreur de licence, mais c'est la surprise connexe qui pousse les traders à chercher des réponses. Tradovate fournit à Bookmap des données de futures CME à <em>profondeur partielle</em>, et non le carnet d'ordres complet. Ainsi, même après avoir levé le blocage de licence, l'échelle de prix peut sembler plus fine que prévu. Si l'analyse approfondie du flux d'ordres est la raison principale pour laquelle vous utilisez Bookmap, prévoyez de récupérer les données auprès d'un fournisseur à profondeur complète comme dxFeed, Rithmic ou CQG, tout en continuant à acheminer vos ordres via Tradovate." },
    { type: "heading", text: "Comment le résoudre : étape par étape" },
    {
      type: "steps",
      items: [
        { title: "Identifiez votre niveau Bookmap actuel", html: "Ouvrez la page de votre compte Bookmap ou la section abonnement dans l'application et relevez le nom exact du niveau. S'il indique Digital ou Digital+, voilà votre réponse pour tout symbole de futures, ces niveaux ne peuvent afficher aucune donnée CME, quoi que vous fassiez au niveau de la connexion. S'il indique Global ou Global+, votre abonnement couvre les futures et vous devez passer aux vérifications de droits d'accès aux données et de nombre de symboles. Ne vous fiez pas à votre mémoire ; beaucoup de personnes ont un niveau gratuit souscrit il y a des mois et oublié depuis." },
        { title: "Faites correspondre l'abonnement au marché que vous tradez", html: "Si vous êtes sur un niveau réservé aux cryptomonnaies et que vous avez besoin des futures CME, passez à Global ou Global+. Global vous donne des données d'actions et de futures en temps réel ainsi que plusieurs symboles simultanés ; Global+ ajoute un nombre de symboles plus élevé, des modules complémentaires du marketplace et le trading directement depuis le graphique. Comparez les offres actuelles sur le site de Bookmap avant de vous engager, car les noms de niveaux, les limites de symboles et les prix évoluent avec le temps. Choisissez celui dont le nombre de symboles correspond au nombre de graphiques que vous gardez réellement ouverts en même temps." },
        { title: "Réglez le droit d'accès aux données CME", html: "Une fois le bon niveau en place, assurez-vous que les données de la bourse elles-mêmes sont activées. Déterminez si Tradovate est votre source de données ou seulement votre courtier. Si Tradovate fournit les données, vérifiez que votre compte Tradovate dispose de l'abonnement CME en temps réel et que vous avez signé l'accord de données non professionnel. Si vous utilisez un fournisseur distinct pour les données, signez plutôt l'accord CME auprès de ce fournisseur. Dans les deux cas, le droit d'accès doit être actif avant que le symbole ne se résolve." },
        { title: "Réabonnez-vous correctement au symbole", html: "De retour dans Bookmap, ouvrez la boîte de dialogue d'ajout d'instrument, choisissez la plateforme Tradovate et saisissez le symbole. Utilisez un contrat valide et actif, une véritable échéance rapprochée comme le contrat ES ou MES en cours, pas un mois obsolète ou expiré. Cliquez ensuite sur s'abonner. Si l'abonnement, le droit d'accès et le symbole sont tous corrects, la heatmap se charge. Si vous obtenez toujours le message de licence sur le bon niveau, vous butez presque certainement sur un plafond de nombre de symboles ou un accord de données manquant, revoyez donc les étapes 2 et 3." },
        { title: "S'il s'agit d'un compte prop ou d'évaluation, impliquez la société", html: "Sur un compte Tradovate financé ou en évaluation, vous ne contrôlez pas les droits d'accès aux données de marché, c'est la société de prop trading qui les contrôle. Vous pouvez toujours mettre à niveau votre propre abonnement Bookmap, mais si le flux CME n'est pas activé pour le compte, seule la société peut l'activer. Les règles et les données disponibles varient selon la société et la taille du compte, vérifiez donc la politique actuelle de votre société et ouvrez un ticket auprès d'elle si le symbole reste bloqué après avoir réglé votre abonnement Bookmap." },
        { title: "Contactez le support Bookmap avec des informations précises", html: "Si vous avez confirmé un niveau Global, un accord CME actif, que vous êtes en dessous du plafond de symboles et que cela ne se charge <em>toujours</em> pas, arrêtez de deviner et ouvrez un ticket. Fournissez au support Bookmap le nom exact de votre abonnement, le symbole précis et l'échéance du contrat, le texte complet de l'erreur, et si Tradovate est votre source de données, votre courtier, ou les deux. Posez deux questions directes : mon niveau couvre-t-il ce marché, et le droit d'accès aux données de la bourse est-il actif sur ce compte. Ces deux réponses résolvent presque tous les cas." },
      ],
    },
    { type: "heading", text: "Tableau de dépannage" },
    {
      type: "table",
      headers: ["Symptôme", "Cause probable", "Solution"],
      rows: [
        ["Les symboles crypto se chargent, mais ES/MES renvoie « la licence ne le permet pas »", "Vous êtes sur un niveau Digital / Digital+ (crypto uniquement)", "Passez à Bookmap Global ou Global+ pour les données de futures"],
        ["Certains futures se chargent, mais l'ajout d'un de plus échoue", "Plafond de symboles simultanés de votre niveau atteint", "Fermez un graphique inutilisé, ou passez à un niveau avec un plafond de symboles plus élevé"],
        ["Bon niveau, mais le symbole ne se résout toujours pas", "Accord de données en temps réel CME non signé ou expiré", "Signez l'accord de données non professionnel et confirmez l'abonnement CME"],
        ["L'offre « gratuite » Bookmap plus Tradovate n'affiche que des contrats crypto", "L'offre couvre les futures Coinbase (FairX), pas CME", "Ajoutez un niveau Global payant et le droit d'accès CME pour les produits CME"],
        ["Le symbole se charge mais le carnet d'ordres paraît peu profond", "Tradovate fournit des données CME à profondeur partielle", "Utilisez un fournisseur de données à profondeur complète (dxFeed / Rithmic / CQG) pour les données, Tradovate pour les ordres"],
        ["Le symbole d'un compte prop reste bloqué après la mise à niveau Bookmap", "Droit d'accès aux données contrôlé par la société non activé", "Contactez la société de prop trading pour activer les données de marché sur le compte"],
      ],
    },
    { type: "heading", text: "Quand la licence de données continue de vous gêner" },
    { type: "paragraph", html: "Soyons honnêtes : Bookmap est un excellent outil d'analyse du flux d'ordres, mais son modèle en couches d'abonnement et de droits d'accès représente beaucoup d'efforts si votre véritable objectif est d'<em>automatiser</em> une stratégie sur Tradovate plutôt que de surveiller une heatmap. Si vous exploitez surtout un système basé sur des règles, vous n'avez pas nécessairement besoin d'acheter un niveau Global et d'y ajouter une licence de données CME juste pour déclencher des trades. C'est exactement le vide que comble PickMyTrade." },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Automatisez directement depuis vos graphiques.</strong> Construisez votre logique dans une plateforme comme TradingView, déclenchez un webhook, et PickMyTrade achemine l'ordre vers votre compte Tradovate, sans dépendre du niveau de données futures de Bookmap pour placer un trade.",
        "<strong class='text-white'>Évitez la lourde surcharge de licence de données pour l'exécution.</strong> Votre logique d'entrée et de sortie réside dans votre outil de graphiques, si bien que l'automatisation des ordres ne dépend pas d'un flux CME à profondeur complète au sein de Bookmap.",
        "<strong class='text-white'>Répliquez sur plusieurs comptes.</strong> Le même signal peut piloter simultanément plusieurs comptes Tradovate d'évaluation ou financés, ce que le suivi manuel de graphiques ne peut tout simplement pas suivre.",
        "<strong class='text-white'>Acheminement sécurisé pour les limites de fréquence.</strong> Le flux d'ordres est espacé pour rester dans les limites de Tradovate, ce qui vous évite les rafales de nouvelles tentatives qui provoquent leurs propres blocages.",
      ],
    },
    { type: "paragraph", html: "Conservez Bookmap pour ce qu'il fait de mieux, lire la liquidité quand vous voulez garder un œil sur le tape, et laissez un pont d'automatisation gérer l'exécution qui ne devrait pas dépendre d'une licence de données." },
  ], it: [
    { type: "paragraph", html: "Colleghi il suo account Tradovate a Bookmap, digita un simbolo che opera ogni giorno, ES, MES, quel che sia, clicca su sottoscrivi, e invece di una heatmap ottiene un messaggio secco: <em>la sua licenza non lo consente</em>. Nessun grafico, nessun dato, nessun motivo evidente. La connessione sembra funzionare, il login su Tradovate è andato a buon fine, eppure la piattaforma non mostra proprio lo strumento che cercava. Frustrante, ma quasi mai si tratta di un bug. È un blocco legato a licenza e autorizzazione ai dati, e una volta compresi i due livelli che lo determinano, la soluzione è di solito rapida. Vediamo esattamente cosa significa questo messaggio, perché colpisce in particolare i future CME e come risolverlo." },
    {
      type: "checklist",
      heading: "Checklist rapida prima di approfondire",
      items: [
        "<strong class='text-white'>Controlli il livello del suo piano Bookmap.</strong> Digital e Digital+ sono solo per le criptovalute. I future CME come ES e MES richiedono Global o Global+.",
        "<strong class='text-white'>Conti i suoi simboli.</strong> Ogni livello limita quanti strumenti può monitorare contemporaneamente. Se supera il limite, riceve lo stesso messaggio di licenza.",
        "<strong class='text-white'>Confermi l'autorizzazione ai dati CME.</strong> I dati sui future in tempo reale richiedono un accordo firmato con la borsa e una tariffa separata, indipendente dal piano Bookmap.",
        "<strong class='text-white'>Sappia esattamente quale mercato sta richiedendo.</strong> L'offerta &ldquo;gratuita&rdquo; Tradovate più Bookmap copre specifici future crypto Coinbase (FairX), non l'intera gamma CME.",
        "<strong class='text-white'>Controlli la modalità di connessione.</strong> Tradovate può fornire sia i dati sia l'esecuzione, oppure limitarsi a instradare gli ordini mentre un altro fornitore alimenta i dati.",
        "<strong class='text-white'>Su un account prop, coinvolga la società.</strong> Gli account in valutazione e finanziati hanno autorizzazioni ai dati controllate dalla società, non da lei.",
      ],
    },
    { type: "heading", text: "Cosa significa davvero &ldquo;la licenza non lo consente&rdquo;" },
    { type: "paragraph", html: "Bookmap tiene separate due cose che i trader tendono a confondere: il <strong class='text-white'>piano</strong> che paga a Bookmap e i <strong class='text-white'>dati di mercato</strong> a cui ha diritto da parte di una borsa. Il messaggio &ldquo;la licenza non lo consente&rdquo; è il modo in cui Bookmap le comunica che uno di questi due elementi manca per il simbolo richiesto. O il suo livello Bookmap non include quel mercato, oppure la licenza dati della borsa dietro il feed non è attiva sul suo account. La connessione Tradovate in sé funziona, per questo il login è andato a buon fine e la piattaforma ha accettato le sue credenziali. Ciò che è fallito è il controllo dell'autorizzazione che scatta nell'istante in cui prova a richiedere dati in tempo reale per uno strumento specifico." },
    { type: "paragraph", html: "Questo conta perché i due livelli hanno soluzioni completamente diverse. Un problema di piano si risolve aggiornando il suo abbonamento Bookmap. Un problema di autorizzazione ai dati si risolve firmando l'accordo con la borsa e pagandone la tariffa, oppure facendolo attivare dalla sua prop firm. Se insegue la pista sbagliata, passerà un intero pomeriggio a reinstallare un software che non si è mai rotto. Quindi il primo compito è capire contro quale blocco ha sbattuto." },
    { type: "heading", text: "Perché Bookmap blocca un simbolo Tradovate" },
    { type: "heading", text: "1. Il suo livello Bookmap è solo criptovalute" },
    { type: "paragraph", html: "Questo è il motivo principale, e coglie quasi tutti quelli che hanno iniziato con un login gratuito. I livelli Digital e Digital+ di Bookmap sono pensati per le criptovalute e gli asset digitali. Non includono né azioni né future, punto. Quindi se è su Digital o Digital+ e digita un simbolo di future CME come ES o MES, Bookmap non ha nulla da offrirle e restituisce il messaggio di licenza. I future CME in tempo reale vivono sui livelli Global e Global+. La documentazione stessa di Bookmap è chiara al riguardo: il suo pacchetto dati sui future richiede un abbonamento Global o Global+. Se non ha mai scelto consapevolmente un piano future a pagamento, presuma di essere su un livello solo criptovalute, ed è questo il suo problema." },
    { type: "heading", text: "2. Ha esaurito i simboli consentiti dal suo livello" },
    { type: "paragraph", html: "Anche sul livello giusto, ogni piano Bookmap limita quanti strumenti può visualizzare contemporaneamente. I livelli crypto la limitano a uno, o a una manciata, alla volta. Global e Global+ innalzano quel limite a un numero maggiore di simboli simultanei. Se ha già raggiunto il suo limite e ne aggiunge un altro, Bookmap può restituire lo stesso messaggio &ldquo;la licenza non lo consente&rdquo;, non perché il mercato sia sbagliato, ma perché ha esaurito gli spazi disponibili. Chiuda un grafico che non sta usando e riprovi; se il simbolo si carica, ha trovato la risposta." },
    { type: "heading", text: "3. L'accordo dati CME non è attivo" },
    { type: "paragraph", html: "I piani Bookmap non includono dati della borsa né intermediazione. È una separazione voluta. Per vedere i future CME in diretta, serve l'autorizzazione ai dati di mercato in tempo reale della borsa, il che significa un accordo dati non professionale (o professionale) firmato e la relativa tariffa mensile della borsa. Può soddisfare questo requisito tramite il feed proprio di Tradovate oppure tramite un fornitore di dati separato, ma l'autorizzazione deve esistere da qualche parte. Se non è mai stata firmata o è scaduta, il simbolo resta bloccato anche con un piano Global. Le tariffe e i termini degli accordi con la borsa cambiano nel tempo, quindi consideri qualsiasi cifra letta come un punto di partenza e verifichi la tariffa attuale." },
    { type: "heading", text: "4. Sta richiedendo un mercato che l'offerta &ldquo;gratuita&rdquo; non ha mai coperto" },
    { type: "paragraph", html: "Esiste un'offerta ben nota che abbina un account Tradovate a Bookmap senza costi di dati di mercato o di abbonamento. Il tranello che molti si perdono: quell'offerta riguarda un insieme specifico di future crypto Coinbase Derivatives (FairX), come il nano bitcoin. Questi contratti si collocano sul lato degli asset digitali, ed è esattamente per questo che un login gratuito di livello Digital può vederli. Nel momento in cui digita un prodotto CME come ES o MES, esce da quell'offerta ed entra in un mercato che richiede il livello Global a pagamento e un'autorizzazione CME. Stessa piattaforma, stessa connessione, licenza completamente diversa." },
    { type: "heading", text: "5. Tradovate fornisce dati a profondità parziale" },
    { type: "paragraph", html: "Questo non provoca l'errore di licenza, ma è la sorpresa correlata che spinge le persone a cercare risposte. Tradovate fornisce a Bookmap dati sui future CME a <em>profondità parziale</em>, non il book completo. Quindi anche dopo aver superato il blocco di licenza, la ladder può apparire più sottile del previsto. Se il flusso di ordini approfondito è l'intero motivo per cui usa Bookmap, pianifichi di ricavare i dati da un fornitore a profondità completa come dxFeed, Rithmic o CQG, continuando comunque a instradare gli ordini tramite Tradovate." },
    { type: "heading", text: "Come risolverlo: passo dopo passo" },
    {
      type: "steps",
      items: [
        { title: "Identifichi il suo livello Bookmap attuale", html: "Apra la pagina del suo account Bookmap o la sezione piano all'interno dell'app e legga il nome esatto del livello. Se indica Digital o Digital+, ecco la risposta per qualsiasi simbolo di future, quei livelli non possono mostrare dati CME indipendentemente da cosa faccia a livello di connessione. Se indica Global o Global+, il suo piano copre i future e deve passare ai controlli su autorizzazione dati e numero di simboli. Non lo dia per scontato dalla memoria; molte persone hanno un livello gratuito sottoscritto mesi fa e poi dimenticato." },
        { title: "Faccia corrispondere il piano al mercato che tratta", html: "Se è su un livello solo criptovalute e le servono i future CME, esegua l'upgrade a Global o Global+. Global le offre dati in tempo reale su azioni e future e più simboli simultanei; Global+ aumenta ulteriormente il numero di simboli e aggiunge componenti aggiuntivi del marketplace e il trading direttamente dal grafico. Confronti i pacchetti attuali sul sito di Bookmap prima di decidere, poiché i nomi dei livelli, i limiti di simboli e i prezzi cambiano nel tempo. Scelga quello il cui numero di simboli corrisponde a quanti grafici tiene realmente aperti contemporaneamente." },
        { title: "Risolva l'autorizzazione ai dati CME", html: "Con il livello giusto in atto, si assicuri che i dati della borsa siano effettivamente abilitati. Decida se Tradovate è la sua fonte dati o solo il suo broker. Se Tradovate fornisce i dati, confermi che il suo account Tradovate ha l'abbonamento CME in tempo reale e che ha firmato l'accordo dati non professionale. Se usa un fornitore separato per i dati, firmi invece l'accordo CME presso quel fornitore. In entrambi i casi l'autorizzazione deve essere attiva prima che il simbolo si risolva." },
        { title: "Sottoscriva di nuovo correttamente il simbolo", html: "Torni in Bookmap, apra la finestra di aggiunta strumento, scelga la piattaforma Tradovate e inserisca il simbolo. Usi un contratto valido e attivo, una scadenza reale come l'attuale contratto ES o MES, non un mese vecchio o scaduto. Poi clicchi su sottoscrivi. Se piano, autorizzazione e simbolo sono tutti corretti, la heatmap si carica. Se continua a ricevere il messaggio di licenza sul livello corretto, sta quasi certamente incontrando un limite sul numero di simboli o un accordo dati mancante, quindi riveda i passaggi 2 e 3." },
        { title: "Se si tratta di un account prop o in valutazione, coinvolga la società", html: "Su un account Tradovate finanziato o in valutazione, non è lei a controllare le autorizzazioni ai dati di mercato, ma la prop firm. Può comunque aggiornare il proprio livello Bookmap, ma se il feed CME non è attivato per l'account, solo la società può abilitarlo. Le regole e i dati disponibili variano da società a società e in base alla dimensione dell'account, quindi verifichi la policy attuale della sua società e apra un ticket con loro se il simbolo resta bloccato dopo aver sistemato il suo piano Bookmap." },
        { title: "Passi al supporto Bookmap con dettagli specifici", html: "Se ha confermato un livello Global, un accordo CME attivo, si trova sotto il limite di simboli e <em>ancora</em> non si carica, smetta di indovinare e apra un ticket. Fornisca al supporto Bookmap il nome esatto del suo piano, il simbolo preciso e la scadenza del contratto, il testo completo dell'errore e se Tradovate è la sua fonte dati, il suo broker, o entrambi. Faccia due domande dirette: il mio livello copre questo mercato, e l'autorizzazione ai dati della borsa è attiva su questo account. Queste due risposte risolvono quasi ogni caso." },
      ],
    },
