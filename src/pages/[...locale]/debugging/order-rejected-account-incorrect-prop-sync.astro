---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "order-rejected-account-incorrect-prop-sync";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/debugging/${SLUG}`;

const META_TITLE = "Tradovate 'Account Incorrect' Rejection After Sync";
const META_DESCRIPTION =
  "'Account Incorrect' order rejection after a prop account sync? Log out and back in, clear cache, and re-link your firm keys to place trades again fast.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Tradovate: Ablehnung „Account Incorrect“ nach der Synchronisierung", es: "Tradovate: rechazo «Account Incorrect» tras la sincronización", fr: "Tradovate : rejet « Account Incorrect » après la synchronisation", it: "Tradovate: rifiuto «Account Incorrect» dopo la sincronizzazione" },
  dek: { en: "Every order bounces with an \"Account Incorrect\" rejection right after an evaluation reset or firm sync. It's a login mismatch, not a risk problem, here's the fix.", de: "Jede Order wird direkt nach einem Evaluierungs-Reset oder einer Firmen-Synchronisierung mit „Account Incorrect“ abgelehnt. Es ist ein Login-Konflikt, kein Risikoproblem – hier ist die Lösung.", es: "Todas las órdenes rebotan con un rechazo «Account Incorrect» justo después de un reinicio de evaluación o una sincronización con la firma. Es un desajuste de inicio de sesión, no un problema de riesgo; aquí está la solución.", fr: "Chaque ordre est refusé avec un rejet « Account Incorrect » juste après une réinitialisation d'évaluation ou une synchronisation avec la firme. C'est un décalage de connexion, pas un problème de risque : voici la solution.", it: "Ogni ordine viene respinto con un rifiuto «Account Incorrect» subito dopo un reset della valutazione o una sincronizzazione con la società. È un disallineamento di login, non un problema di rischio: ecco la soluzione." },
  readTime: { en: "7 min read", de: "7 Min. Lesezeit", es: "Lectura de 7 min", fr: "Lecture : 7 min", it: "Lettura di 7 min" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "You just reset your evaluation, or your firm pushed through a sync, and now every order you send bounces back with an &ldquo;Account Incorrect&rdquo; rejection. Nothing about your size or your stop is wrong. The platform simply won't let the order through. It's one of the more confusing rejections to hit because it doesn't point at anything you're actually doing with the trade." },
    { type: "paragraph", html: "Here's the short version: this is a login and sync mismatch, not a risk or margin problem. Your active session is pointing at a version of the account that no longer matches what the broker expects. The fix is almost always the same short sequence: log fully out, clear your cache or drop into an incognito window, log back in, and re-link your prop firm keys so the connection resyncs. Nine times out of ten the order goes straight through after that." },
    { type: "heading", text: "What \"Account Incorrect\" Actually Means" },
    { type: "paragraph", html: "When you place an order, Tradovate has to match your logged-in session to the exact account the order should route to, then hand it off to the exchange. &ldquo;Account Incorrect&rdquo; is what you get when that match fails. The order never reaches the matching engine. It's rejected at the identity layer, before risk checks, before margin, before anything to do with the contract." },
    { type: "paragraph", html: "That's why the usual order-rejection advice doesn't help here. Lowering your quantity won't fix it. Signing a data agreement won't fix it. The account your session <em>thinks</em> it's trading and the account the system wants to route against have drifted apart, and you need to force them back into agreement. That's the whole job." },
    { type: "heading", text: "Why It Shows Up Right After a Sync or Reset" },
    { type: "paragraph", html: "This rejection clusters around a handful of moments, and every one of them involves your session holding stale information:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>You reset an evaluation.</strong> The firm spins up a fresh account behind the same login, but your open session is still referencing the old one.",
        "<strong class='text-white'>Credentials changed on the firm side.</strong> A password reset, a new account provisioned, or a plan change can leave your current session out of date.",
        "<strong class='text-white'>Platform maintenance or an outage.</strong> After Tradovate-side downtime, sessions that were open through the maintenance window often come back half-synced and reject re-entries until you re-authenticate.",
        "<strong class='text-white'>You're logged in on too many devices.</strong> Tradovate caps you at two active sessions. When web, desktop, mobile, and a TradingView link are all fighting over the same account, the wrong session can win and route incorrectly.",
        "<strong class='text-white'>A bridge or third-party tool re-authenticated.</strong> When your automation reconnects, it re-establishes the account link, and a stale browser session can fall out of step with it.",
      ],
    },
    { type: "paragraph", html: "The common thread is a cached, out-of-date view of the account. Everything below is about clearing that cache and rebuilding the connection from scratch." },
    { type: "heading", text: "First, Confirm the Rejection Reason" },
    { type: "paragraph", html: "Before you start clearing anything, read the actual rejection text. Two rejections can look almost identical in the little pop-up, and you don't want to spend ten minutes re-linking keys when the real problem was a risk limit or an expired contract." },
    { type: "paragraph", html: "The quickest way is straight from the Orders module: find the rejected order in the list, click it (or right-click and choose Order Details), and read the rejection message in the details panel. You can also pull it from the Reports module by choosing Order Details, entering the order number, and running the report. Tradovate spells out the reason in plain language, so let the message tell you what you're dealing with instead of guessing." },
    { type: "paragraph", html: "If the message is genuinely about the account or sync, keep going. If it names a risk limit, a quote, or a contract, you're on the wrong page, and a different order-rejection guide will get you there faster." },
    { type: "heading", text: "The Fix, Step by Step" },
    {
      type: "steps",
      items: [
        { title: "Log fully out of every session", html: "Don't just close the tab. Actually sign out from the account menu so the session is torn down on the server, not just hidden on your screen. Then check anywhere else you might be signed in: the desktop app, the mobile app, a second browser, and any TradingView connection tied to the same account. Because Tradovate only allows two live sessions, a forgotten login on your phone can keep re-asserting the stale account." },
        { title: "Clear your cache or use an incognito window", html: "Once you're out, get rid of the stored session data. The fast route is a private or incognito window, which starts with an empty cache and no extensions in the way. If you'd rather stay in your normal browser, clear the cached files and cookies for the site instead. Either way, the point is the same: force the next login to fetch a clean copy of your account rather than reusing the stale one that caused the rejection." },
        { title: "Log back in and pick the right account", html: "Sign in fresh and pay attention to which account you land on. If you trade several evaluations or run a personal account alongside a funded one, make sure the account selector is set to the exact account you're trying to trade. Landing on the wrong one is its own flavor of &ldquo;account incorrect,&rdquo; and it's an easy thing to miss when the platform reopens on whatever it opened on last." },
        { title: "Re-link your prop firm keys", html: "If the rejection came right after a reset or a firm-side change, a clean login sometimes isn't enough on its own. The connection between your firm dashboard and Tradovate needs to be rebuilt so both sides agree on the current account. Head into your prop firm's dashboard, find where it manages the Tradovate connection, and re-link or reconnect the credentials. The exact wording differs by firm, but you're looking for the option that re-establishes or refreshes the Tradovate link rather than the one that creates a brand-new account. While you're in there, watch for a second, conflicting authentication prompt, since two competing two-factor steps can leave the link half-formed." },
        { title: "Send a small test order", html: "Don't assume it's fixed. Put through a single micro contract, or a limit order parked well away from the market, and confirm it's accepted and working. If it fills or rests without a rejection, you're back in business and can trade normally. If it bounces again with the same message, keep troubleshooting." },
      ],
    },
    { type: "quote", html: "Browser extensions, especially ad blockers and privacy tools, can interfere with the login and account handshake. An incognito window sidesteps all of them at once, which is why it's usually faster than hunting through settings." },
    { type: "heading", text: "If It Still Rejects" },
    { type: "paragraph", html: "A stubborn &ldquo;Account Incorrect&rdquo; that survives a full re-login usually has one of these behind it:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Your system clock is off.</strong> Tradovate's login and sync are time-sensitive. On Windows, right-click the taskbar clock, open the date and time settings, and hit sync now so your machine matches real time. A clock that's drifted by even a minute can break the handshake.",
        "<strong class='text-white'>The firm hasn't finished provisioning.</strong> Right after a purchase or reset, an account can take a while to be fully set up on the firm's side. If everything on your end is clean, give it time and try again before assuming something is broken.",
        "<strong class='text-white'>The link in the firm dashboard didn't take.</strong> Go back into the dashboard and confirm the Tradovate connection actually shows as linked, not pending or errored. Re-link once more if it looks stuck.",
        "<strong class='text-white'>It's genuinely a firm-side issue.</strong> Because the prop firm owns and controls the account, some sync problems can only be cleared by them. If re-login and re-linking both fail, open a ticket with the firm and describe exactly when the rejection started, ideally right after which reset or maintenance window.",
      ],
    },
    { type: "heading", text: "Keep It From Happening Again" },
    { type: "paragraph", html: "You can cut these rejections down to almost never with a few habits. Trade from a single session instead of leaving yourself logged in across three devices. After every evaluation reset or firm-side change, re-link the connection before you place your first order rather than finding out mid-trade. And when Tradovate posts maintenance, expect the first login afterward to need a clean re-authentication, so plan to log out and back in before the session reopens." },
    { type: "paragraph", html: "If you route orders through automation, this matters even more, because a stale connection can silently reject a signal you never see land. Building a reliable link once and letting a bridge manage the reconnects keeps a bad session from quietly eating your entries." },
  ], de: [
    { type: "paragraph",html: "Sie haben gerade Ihre Evaluierung zurückgesetzt oder Ihre Firma hat eine Synchronisierung durchgeführt, und nun wird jede Order, die Sie senden, mit der Ablehnung &ldquo;Account Incorrect&rdquo; zurückgewiesen. An Ihrer Positionsgröße oder Ihrem Stop ist nichts falsch. Die Plattform lässt die Order einfach nicht durch. Es ist eine der verwirrenderen Ablehnungen, weil sie auf nichts hinweist, was Sie mit dem Trade tatsächlich tun." },
    { type: "paragraph",html: "Die Kurzfassung: Dies ist ein Login- und Synchronisierungskonflikt, kein Risiko- oder Margin-Problem. Ihre aktive Sitzung zeigt auf eine Version des Kontos, die nicht mehr dem entspricht, was der Broker erwartet. Die Lösung ist fast immer dieselbe kurze Abfolge: vollständig ausloggen, den Cache leeren oder in ein Inkognito-Fenster wechseln, sich wieder einloggen und die Schlüssel Ihres Prop-Firms neu verknüpfen, damit sich die Verbindung neu synchronisiert. In neun von zehn Fällen geht die Order danach sofort durch." },
    { type: "heading",text: "Was „Account Incorrect“ tatsächlich bedeutet" },
    { type: "paragraph",html: "Wenn Sie eine Order aufgeben, muss Tradovate Ihre angemeldete Sitzung dem exakten Konto zuordnen, an das die Order gehen soll, und sie dann an die Börse weitergeben. &ldquo;Account Incorrect&rdquo; erhalten Sie, wenn diese Zuordnung fehlschlägt. Die Order erreicht die Matching-Engine nie. Sie wird auf der Identitätsebene abgelehnt, vor den Risikoprüfungen, vor der Margin, vor allem, was mit dem Kontrakt zu tun hat." },
    { type: "paragraph",html: "Deshalb helfen die üblichen Ratschläge bei Order-Ablehnungen hier nicht. Eine geringere Stückzahl behebt es nicht. Das Unterzeichnen einer Datenvereinbarung behebt es nicht. Das Konto, das Ihre Sitzung zu handeln <em>glaubt</em>, und das Konto, gegen das das System routen will, sind auseinandergedriftet, und Sie müssen beide wieder in Einklang bringen. Das ist die ganze Aufgabe." },
    { type: "heading",text: "Warum es direkt nach einer Synchronisierung oder einem Reset auftritt" },
    { type: "paragraph",html: "Diese Ablehnung häuft sich um einige wenige Momente, und bei allen hält Ihre Sitzung veraltete Informationen:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Sie haben eine Evaluierung zurückgesetzt.</strong> Die Firma richtet hinter demselben Login ein neues Konto ein, aber Ihre geöffnete Sitzung verweist noch auf das alte.",
        "<strong class='text-white'>Zugangsdaten wurden auf Seiten der Firma geändert.</strong> Ein Passwort-Reset, ein neu bereitgestelltes Konto oder ein Planwechsel kann Ihre aktuelle Sitzung veralten lassen.",
        "<strong class='text-white'>Plattformwartung oder ein Ausfall.</strong> Nach Ausfallzeiten auf Tradovate-Seite kommen Sitzungen, die während des Wartungsfensters geöffnet waren, oft nur halb synchronisiert zurück und lehnen Neueinstiege ab, bis Sie sich erneut authentifizieren.",
        "<strong class='text-white'>Sie sind auf zu vielen Geräten eingeloggt.</strong> Tradovate erlaubt Ihnen höchstens zwei aktive Sitzungen. Wenn Web, Desktop, Mobil und eine TradingView-Verbindung um dasselbe Konto konkurrieren, kann die falsche Sitzung gewinnen und falsch routen.",
        "<strong class='text-white'>Eine Bridge oder ein Drittanbieter-Tool hat sich neu authentifiziert.</strong> Wenn Ihre Automatisierung die Verbindung wiederherstellt, wird auch die Kontoverknüpfung neu aufgebaut, und eine veraltete Browsersitzung kann dabei aus dem Takt geraten.",
      ],
    },
    { type: "paragraph",html: "Der gemeinsame Nenner ist eine zwischengespeicherte, veraltete Sicht auf das Konto. Alles Folgende dreht sich darum, diesen Cache zu leeren und die Verbindung von Grund auf neu aufzubauen." },
    { type: "heading",text: "Zuerst: Den Ablehnungsgrund bestätigen" },
    { type: "paragraph",html: "Bevor Sie etwas löschen, lesen Sie den tatsächlichen Ablehnungstext. Zwei Ablehnungen können im kleinen Pop-up fast identisch aussehen, und Sie wollen nicht zehn Minuten damit verbringen, Schlüssel neu zu verknüpfen, wenn das eigentliche Problem ein Risikolimit oder ein abgelaufener Kontrakt war." },
    { type: "paragraph",html: "Am schnellsten geht es direkt im Modul Orders: Suchen Sie die abgelehnte Order in der Liste, klicken Sie darauf (oder klicken Sie mit der rechten Maustaste und wählen Sie Order Details) und lesen Sie die Ablehnungsmeldung im Detailfenster. Sie können sie auch im Modul Reports abrufen, indem Sie Order Details wählen, die Ordernummer eingeben und den Bericht ausführen. Tradovate nennt den Grund in klarer Sprache, lassen Sie sich also von der Meldung sagen, womit Sie es zu tun haben, statt zu raten." },
    { type: "paragraph",html: "Wenn die Meldung tatsächlich das Konto oder die Synchronisierung betrifft, machen Sie weiter. Wenn sie ein Risikolimit, einen Kurs oder einen Kontrakt nennt, sind Sie auf der falschen Seite, und eine andere Anleitung zu Order-Ablehnungen bringt Sie schneller ans Ziel." },
    { type: "heading",text: "Die Lösung, Schritt für Schritt" },
    {
      type: "steps",
      items: [
        { title: "Melden Sie sich vollständig von allen Sitzungen ab", html: "Schließen Sie nicht einfach den Tab. Melden Sie sich im Kontomenü wirklich ab, damit die Sitzung auf dem Server beendet und nicht nur auf Ihrem Bildschirm ausgeblendet wird. Prüfen Sie dann alle anderen Stellen, an denen Sie angemeldet sein könnten: die Desktop-App, die Mobil-App, einen zweiten Browser und jede mit demselben Konto verbundene TradingView-Verbindung. Da Tradovate nur zwei aktive Sitzungen erlaubt, kann ein vergessenes Login auf Ihrem Handy das veraltete Konto immer wieder durchsetzen." },
        { title: "Cache leeren oder ein Inkognito-Fenster verwenden", html: "Sobald Sie abgemeldet sind, entfernen Sie die gespeicherten Sitzungsdaten. Am schnellsten geht es mit einem privaten bzw. Inkognito-Fenster, das mit leerem Cache und ohne störende Erweiterungen startet. Wenn Sie lieber in Ihrem normalen Browser bleiben, leeren Sie stattdessen die zwischengespeicherten Dateien und Cookies für die Seite. In beiden Fällen ist das Ziel dasselbe: Das nächste Login soll eine saubere Kopie Ihres Kontos abrufen, statt die veraltete wiederzuverwenden, die die Ablehnung verursacht hat." },
        { title: "Wieder einloggen und das richtige Konto wählen", html: "Melden Sie sich neu an und achten Sie darauf, auf welchem Konto Sie landen. Wenn Sie mehrere Evaluierungen handeln oder ein privates Konto neben einem finanzierten betreiben, stellen Sie sicher, dass die Kontoauswahl auf genau das Konto gesetzt ist, das Sie handeln wollen. Auf dem falschen Konto zu landen ist eine eigene Variante von &ldquo;Account Incorrect&rdquo;, und man übersieht es leicht, wenn die Plattform mit dem zuletzt geöffneten Konto startet." },
        { title: "Die Schlüssel Ihres Prop-Firms neu verknüpfen", html: "Wenn die Ablehnung direkt nach einem Reset oder einer Änderung auf Firmenseite auftrat, reicht ein sauberes Login manchmal nicht aus. Die Verbindung zwischen Ihrem Firmen-Dashboard und Tradovate muss neu aufgebaut werden, damit beide Seiten das aktuelle Konto übereinstimmend kennen. Rufen Sie das Dashboard Ihres Prop-Firms auf, suchen Sie die Stelle, an der die Tradovate-Verbindung verwaltet wird, und verknüpfen Sie die Zugangsdaten neu bzw. verbinden Sie sie erneut. Die genaue Bezeichnung unterscheidet sich je nach Firma, Sie suchen aber die Option, die die Tradovate-Verknüpfung wiederherstellt oder aktualisiert, nicht die, die ein ganz neues Konto erstellt. Achten Sie dabei auf eine zweite, widersprüchliche Authentifizierungsabfrage, denn zwei konkurrierende Zwei-Faktor-Schritte können die Verknüpfung nur halb zustande kommen lassen." },
        { title: "Eine kleine Testorder senden", html: "Gehen Sie nicht davon aus, dass es behoben ist. Senden Sie einen einzelnen Micro-Kontrakt oder eine Limit-Order weit weg vom Markt und prüfen Sie, ob sie angenommen wird und aktiv ist. Wenn sie ausgeführt wird oder ruht, ohne abgelehnt zu werden, sind Sie wieder im Geschäft und können normal handeln. Wenn sie mit derselben Meldung erneut abgewiesen wird, suchen Sie weiter nach der Ursache." },
      ],
    },
    { type: "quote",html: "Browser-Erweiterungen, insbesondere Werbeblocker und Datenschutz-Tools, können den Login und den Konto-Handshake stören. Ein Inkognito-Fenster umgeht sie alle auf einmal, weshalb es meist schneller ist, als durch die Einstellungen zu suchen." },
    { type: "heading",text: "Wenn es weiterhin abgelehnt wird" },
    { type: "paragraph",html: "Ein hartnäckiges &ldquo;Account Incorrect&rdquo;, das ein komplettes erneutes Einloggen übersteht, hat in der Regel eine dieser Ursachen:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Ihre Systemuhr geht falsch.</strong> Login und Synchronisierung von Tradovate sind zeitkritisch. Klicken Sie unter Windows mit der rechten Maustaste auf die Uhr in der Taskleiste, öffnen Sie die Datums- und Uhrzeiteinstellungen und klicken Sie auf „Jetzt synchronisieren“, damit Ihr Rechner mit der realen Zeit übereinstimmt. Eine um nur eine Minute abweichende Uhr kann den Handshake brechen.",
        "<strong class='text-white'>Die Firma hat die Bereitstellung noch nicht abgeschlossen.</strong> Direkt nach einem Kauf oder Reset kann es dauern, bis ein Konto auf Firmenseite vollständig eingerichtet ist. Wenn bei Ihnen alles sauber ist, geben Sie ihm Zeit und versuchen Sie es erneut, bevor Sie annehmen, dass etwas defekt ist.",
        "<strong class='text-white'>Die Verknüpfung im Firmen-Dashboard hat nicht gegriffen.</strong> Gehen Sie zurück ins Dashboard und prüfen Sie, ob die Tradovate-Verbindung tatsächlich als verknüpft angezeigt wird, nicht als ausstehend oder fehlerhaft. Verknüpfen Sie sie erneut, falls sie hängt.",
        "<strong class='text-white'>Es ist tatsächlich ein Problem auf Firmenseite.</strong> Da das Prop-Firm das Konto besitzt und kontrolliert, lassen sich manche Synchronisierungsprobleme nur dort beheben. Wenn erneutes Einloggen und erneutes Verknüpfen scheitern, eröffnen Sie ein Ticket bei der Firma und beschreiben Sie genau, wann die Ablehnung begann, idealerweise direkt nach welchem Reset oder Wartungsfenster.",
      ],
    },
    { type: "heading",text: "Verhindern, dass es erneut passiert" },
    { type: "paragraph",html: "Mit ein paar Gewohnheiten lassen sich diese Ablehnungen fast ganz vermeiden. Handeln Sie aus einer einzigen Sitzung, statt auf drei Geräten eingeloggt zu bleiben. Verknüpfen Sie nach jedem Evaluierungs-Reset oder jeder Änderung auf Firmenseite die Verbindung neu, bevor Sie Ihre erste Order aufgeben, statt es mitten im Trade herauszufinden. Und wenn Tradovate eine Wartung ankündigt, rechnen Sie damit, dass das erste Login danach eine saubere erneute Authentifizierung braucht; planen Sie also ein, sich aus- und wieder einzuloggen, bevor die Sitzung öffnet." },
    { type: "paragraph",html: "Wenn Sie Orders über eine Automatisierung routen, ist das noch wichtiger, denn eine veraltete Verbindung kann ein Signal stillschweigend ablehnen, ohne dass Sie je sehen, dass es ankommt. Eine zuverlässige Verbindung einmal aufzubauen und eine Bridge die Wiederverbindungen verwalten zu lassen, verhindert, dass eine schlechte Sitzung unbemerkt Ihre Einstiege auffrisst." },
  ], es: [
    { type: "paragraph",html: "Acaba de reiniciar su evaluación, o su firma ha aplicado una sincronización, y ahora cada orden que envía rebota con un rechazo &ldquo;Account Incorrect&rdquo;. No hay nada incorrecto en su tamaño ni en su stop. La plataforma simplemente no deja pasar la orden. Es uno de los rechazos más confusos porque no señala nada de lo que realmente está haciendo con la operación." },
    { type: "paragraph",html: "La versión corta: se trata de un desajuste de inicio de sesión y sincronización, no de un problema de riesgo o de margen. Su sesión activa apunta a una versión de la cuenta que ya no coincide con lo que espera el broker. La solución es casi siempre la misma secuencia breve: cerrar sesión por completo, vaciar la caché o abrir una ventana de incógnito, volver a iniciar sesión y volver a vincular las claves de su prop firm para que la conexión se resincronice. Nueve de cada diez veces la orden pasa directamente después." },
    { type: "heading",text: "Qué significa realmente «Account Incorrect»" },
    { type: "paragraph",html: "Cuando envía una orden, Tradovate tiene que hacer coincidir su sesión iniciada con la cuenta exacta a la que debe enrutarse la orden y luego pasarla al mercado. &ldquo;Account Incorrect&rdquo; es lo que recibe cuando esa coincidencia falla. La orden nunca llega al motor de casamiento. Se rechaza en la capa de identidad, antes de las comprobaciones de riesgo, antes del margen, antes de cualquier cosa relacionada con el contrato." },
    { type: "paragraph",html: "Por eso los consejos habituales para rechazos de órdenes no ayudan aquí. Reducir la cantidad no lo soluciona. Firmar un acuerdo de datos no lo soluciona. La cuenta que su sesión <em>cree</em> estar operando y la cuenta contra la que el sistema quiere enrutar se han desalineado, y hay que volver a ponerlas de acuerdo. Ese es todo el trabajo." },
    { type: "heading",text: "Por qué aparece justo después de una sincronización o un reinicio" },
    { type: "paragraph",html: "Este rechazo se concentra en un puñado de momentos, y en todos ellos su sesión conserva información obsoleta:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Reinició una evaluación.</strong> La firma crea una cuenta nueva detrás del mismo inicio de sesión, pero su sesión abierta sigue haciendo referencia a la anterior.",
        "<strong class='text-white'>Cambiaron las credenciales en la firma.</strong> Un restablecimiento de contraseña, una cuenta nueva aprovisionada o un cambio de plan pueden dejar su sesión actual desactualizada.",
        "<strong class='text-white'>Mantenimiento de la plataforma o una caída.</strong> Tras una interrupción del lado de Tradovate, las sesiones que estaban abiertas durante la ventana de mantenimiento suelen volver a medio sincronizar y rechazan nuevas entradas hasta que se vuelve a autenticar.",
        "<strong class='text-white'>Tiene sesión iniciada en demasiados dispositivos.</strong> Tradovate le limita a dos sesiones activas. Cuando la web, el escritorio, el móvil y un enlace de TradingView compiten por la misma cuenta, puede ganar la sesión equivocada y enrutar de forma incorrecta.",
        "<strong class='text-white'>Un bridge o una herramienta de terceros se volvió a autenticar.</strong> Cuando su automatización se reconecta, restablece el vínculo con la cuenta, y una sesión de navegador obsoleta puede quedar desfasada respecto a él.",
      ],
    },
    { type: "paragraph",html: "El hilo común es una vista de la cuenta en caché y desactualizada. Todo lo que sigue consiste en borrar esa caché y reconstruir la conexión desde cero." },
    { type: "heading",text: "Primero, confirme el motivo del rechazo" },
    { type: "paragraph",html: "Antes de empezar a borrar nada, lea el texto real del rechazo. Dos rechazos pueden parecer casi idénticos en la pequeña ventana emergente, y no conviene perder diez minutos volviendo a vincular claves cuando el problema real era un límite de riesgo o un contrato vencido." },
    { type: "paragraph",html: "La forma más rápida es directamente desde el módulo Orders: busque la orden rechazada en la lista, haga clic en ella (o clic derecho y elija Order Details) y lea el mensaje de rechazo en el panel de detalles. También puede obtenerlo en el módulo Reports eligiendo Order Details, introduciendo el número de orden y ejecutando el informe. Tradovate explica el motivo en lenguaje claro, así que deje que el mensaje le diga a qué se enfrenta en lugar de adivinar." },
    { type: "paragraph",html: "Si el mensaje trata realmente de la cuenta o de la sincronización, continúe. Si menciona un límite de riesgo, una cotización o un contrato, está en la página equivocada, y otra guía sobre rechazos de órdenes le llevará allí más rápido." },
    { type: "heading",text: "La solución, paso a paso" },
    {
      type: "steps",
      items: [
        { title: "Cierre sesión por completo en todas las sesiones", html: "No se limite a cerrar la pestaña. Cierre sesión de verdad desde el menú de la cuenta para que la sesión se destruya en el servidor y no solo quede oculta en su pantalla. Después revise cualquier otro lugar donde pueda tener la sesión iniciada: la aplicación de escritorio, la aplicación móvil, un segundo navegador y cualquier conexión de TradingView vinculada a la misma cuenta. Como Tradovate solo permite dos sesiones activas, un inicio de sesión olvidado en su teléfono puede seguir imponiendo la cuenta obsoleta." },
        { title: "Borre la caché o use una ventana de incógnito", html: "Una vez fuera, elimine los datos de sesión almacenados. La vía rápida es una ventana privada o de incógnito, que arranca con la caché vacía y sin extensiones de por medio. Si prefiere seguir en su navegador habitual, borre en su lugar los archivos en caché y las cookies del sitio. En cualquier caso, el objetivo es el mismo: obligar a que el siguiente inicio de sesión obtenga una copia limpia de su cuenta en lugar de reutilizar la obsoleta que causó el rechazo." },
        { title: "Vuelva a iniciar sesión y elija la cuenta correcta", html: "Inicie sesión de nuevo y preste atención a qué cuenta aparece. Si opera varias evaluaciones o tiene una cuenta personal junto a una financiada, asegúrese de que el selector de cuenta esté fijado en la cuenta exacta que quiere operar. Caer en la cuenta equivocada es otra variante de &ldquo;Account Incorrect&rdquo;, y es fácil pasarlo por alto cuando la plataforma se reabre en la última que tenía abierta." },
        { title: "Vuelva a vincular las claves de su prop firm", html: "Si el rechazo llegó justo después de un reinicio o de un cambio por parte de la firma, a veces un inicio de sesión limpio no basta por sí solo. La conexión entre el panel de su firma y Tradovate debe reconstruirse para que ambas partes coincidan en la cuenta actual. Entre en el panel de su prop firm, busque dónde gestiona la conexión con Tradovate y vuelva a vincular o reconectar las credenciales. La redacción exacta varía según la firma, pero busque la opción que restablece o actualiza el vínculo con Tradovate, no la que crea una cuenta completamente nueva. Mientras está ahí, esté atento a un segundo aviso de autenticación en conflicto, ya que dos pasos de doble factor enfrentados pueden dejar el vínculo a medio formar." },
        { title: "Envíe una pequeña orden de prueba", html: "No dé por hecho que está arreglado. Envíe un solo contrato micro, o una orden limit situada bien lejos del mercado, y confirme que se acepta y queda activa. Si se ejecuta o queda en espera sin rechazo, vuelve a estar operativo y puede operar con normalidad. Si rebota de nuevo con el mismo mensaje, siga investigando." },
      ],
    },
    { type: "quote",html: "Las extensiones del navegador, en especial los bloqueadores de anuncios y las herramientas de privacidad, pueden interferir con el inicio de sesión y el handshake de la cuenta. Una ventana de incógnito las evita todas a la vez, por lo que suele ser más rápido que buscar entre los ajustes." },
    { type: "heading",text: "Si sigue rechazándose" },
    { type: "paragraph",html: "Un &ldquo;Account Incorrect&rdquo; persistente que sobrevive a un nuevo inicio de sesión completo suele tener una de estas causas:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>El reloj de su sistema está desajustado.</strong> El inicio de sesión y la sincronización de Tradovate dependen de la hora. En Windows, haga clic derecho en el reloj de la barra de tareas, abra la configuración de fecha y hora y pulse sincronizar ahora para que su equipo coincida con la hora real. Un reloj desviado incluso un minuto puede romper el handshake.",
        "<strong class='text-white'>La firma no ha terminado de aprovisionar la cuenta.</strong> Justo después de una compra o un reinicio, una cuenta puede tardar en quedar totalmente configurada en el lado de la firma. Si todo está limpio por su parte, dele tiempo e inténtelo de nuevo antes de suponer que algo está roto.",
        "<strong class='text-white'>El vínculo en el panel de la firma no se aplicó.</strong> Vuelva al panel y confirme que la conexión con Tradovate aparece realmente como vinculada, no como pendiente o con error. Vuelva a vincularla una vez más si parece atascada.",
        "<strong class='text-white'>Es realmente un problema de la firma.</strong> Como la prop firm es propietaria de la cuenta y la controla, algunos problemas de sincronización solo ella puede resolverlos. Si fallan tanto el nuevo inicio de sesión como la revinculación, abra un ticket con la firma y describa exactamente cuándo empezó el rechazo, idealmente justo después de qué reinicio o ventana de mantenimiento.",
      ],
    },
    { type: "heading",text: "Cómo evitar que vuelva a ocurrir" },
    { type: "paragraph",html: "Con unos pocos hábitos puede reducir estos rechazos a casi nunca. Opere desde una sola sesión en lugar de dejar la sesión abierta en tres dispositivos. Después de cada reinicio de evaluación o cambio en la firma, vuelva a vincular la conexión antes de enviar su primera orden, en lugar de descubrirlo en plena operación. Y cuando Tradovate anuncie mantenimiento, cuente con que el primer inicio de sesión posterior necesitará una reautenticación limpia, así que planee cerrar sesión y volver a entrar antes de que se reabra la sesión de mercado." },
    { type: "paragraph",html: "Si enruta órdenes mediante automatización, esto importa todavía más, porque una conexión obsoleta puede rechazar en silencio una señal sin que usted vea nunca que llegó. Construir una vinculación fiable una vez y dejar que un bridge gestione las reconexiones evita que una mala sesión se coma sus entradas sin que se note." },
  ], fr: [
    { type: "paragraph",html: "Vous venez de réinitialiser votre évaluation, ou votre firme a effectué une synchronisation, et maintenant chaque ordre que vous envoyez est refusé avec un rejet &ldquo;Account Incorrect&rdquo;. Rien n'est faux dans votre taille ni dans votre stop. La plateforme refuse simplement de laisser passer l'ordre. C'est l'un des rejets les plus déroutants, car il ne pointe vers rien de ce que vous faites réellement avec le trade." },
    { type: "paragraph",html: "La version courte : il s'agit d'un décalage de connexion et de synchronisation, pas d'un problème de risque ou de marge. Votre session active pointe vers une version du compte qui ne correspond plus à ce qu'attend le broker. La solution est presque toujours la même courte séquence : vous déconnecter complètement, vider votre cache ou ouvrir une fenêtre de navigation privée, vous reconnecter et re-lier les clés de votre prop firm pour que la connexion se resynchronise. Neuf fois sur dix, l'ordre passe directement ensuite." },
    { type: "heading",text: "Ce que signifie réellement « Account Incorrect »" },
    { type: "paragraph",html: "Lorsque vous passez un ordre, Tradovate doit faire correspondre votre session connectée au compte exact vers lequel l'ordre doit être acheminé, puis le transmettre à la bourse. &ldquo;Account Incorrect&rdquo; est ce que vous obtenez lorsque cette correspondance échoue. L'ordre n'atteint jamais le moteur d'appariement. Il est rejeté au niveau de l'identité, avant les contrôles de risque, avant la marge, avant tout ce qui concerne le contrat." },
    { type: "paragraph",html: "C'est pourquoi les conseils habituels sur les rejets d'ordres n'aident pas ici. Réduire votre quantité ne le règle pas. Signer un accord de données ne le règle pas. Le compte que votre session <em>pense</em> négocier et le compte vers lequel le système veut acheminer se sont écartés l'un de l'autre, et vous devez les remettre d'accord. C'est tout le travail." },
    { type: "heading",text: "Pourquoi cela apparaît juste après une synchronisation ou une réinitialisation" },
    { type: "paragraph",html: "Ce rejet se concentre autour de quelques moments, et dans chacun d'eux votre session détient des informations périmées :" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Vous avez réinitialisé une évaluation.</strong> La firme crée un nouveau compte derrière la même connexion, mais votre session ouverte référence toujours l'ancien.",
        "<strong class='text-white'>Les identifiants ont changé côté firme.</strong> Une réinitialisation de mot de passe, un nouveau compte provisionné ou un changement de formule peuvent rendre votre session actuelle obsolète.",
        "<strong class='text-white'>Maintenance de la plateforme ou panne.</strong> Après une interruption côté Tradovate, les sessions restées ouvertes pendant la fenêtre de maintenance reviennent souvent à moitié synchronisées et rejettent les nouvelles entrées jusqu'à ce que vous vous réauthentifiiez.",
        "<strong class='text-white'>Vous êtes connecté sur trop d'appareils.</strong> Tradovate vous limite à deux sessions actives. Lorsque le web, le bureau, le mobile et une connexion TradingView se disputent le même compte, la mauvaise session peut l'emporter et acheminer de façon incorrecte.",
        "<strong class='text-white'>Un bridge ou un outil tiers s'est réauthentifié.</strong> Lorsque votre automatisation se reconnecte, elle rétablit le lien avec le compte, et une session de navigateur périmée peut se retrouver désynchronisée par rapport à lui.",
      ],
    },
    { type: "paragraph",html: "Le point commun est une vue du compte mise en cache et obsolète. Tout ce qui suit consiste à vider ce cache et à reconstruire la connexion de zéro." },
    { type: "heading",text: "D'abord, confirmez le motif du rejet" },
    { type: "paragraph",html: "Avant de commencer à effacer quoi que ce soit, lisez le texte réel du rejet. Deux rejets peuvent paraître presque identiques dans la petite fenêtre contextuelle, et vous ne voulez pas passer dix minutes à re-lier des clés alors que le vrai problème était une limite de risque ou un contrat expiré." },
    { type: "paragraph",html: "Le plus rapide est de passer directement par le module Orders : trouvez l'ordre rejeté dans la liste, cliquez dessus (ou faites un clic droit et choisissez Order Details) et lisez le message de rejet dans le panneau de détails. Vous pouvez aussi le récupérer dans le module Reports en choisissant Order Details, en saisissant le numéro d'ordre et en lançant le rapport. Tradovate explique la raison en langage clair : laissez donc le message vous dire à quoi vous avez affaire plutôt que de deviner." },
    { type: "paragraph",html: "Si le message concerne réellement le compte ou la synchronisation, poursuivez. S'il mentionne une limite de risque, une cotation ou un contrat, vous n'êtes pas sur la bonne page, et un autre guide sur les rejets d'ordres vous y mènera plus vite." },
    { type: "heading",text: "La solution, étape par étape" },
    {
      type: "steps",
      items: [
        { title: "Déconnectez-vous complètement de toutes les sessions", html: "Ne vous contentez pas de fermer l'onglet. Déconnectez-vous réellement depuis le menu du compte afin que la session soit supprimée sur le serveur, et pas seulement masquée à l'écran. Vérifiez ensuite tous les autres endroits où vous pourriez être connecté : l'application de bureau, l'application mobile, un second navigateur et toute connexion TradingView liée au même compte. Comme Tradovate n'autorise que deux sessions actives, une connexion oubliée sur votre téléphone peut continuer à imposer le compte périmé." },
        { title: "Videz votre cache ou utilisez une fenêtre de navigation privée", html: "Une fois déconnecté, débarrassez-vous des données de session stockées. La voie rapide est une fenêtre privée, qui démarre avec un cache vide et sans extensions. Si vous préférez rester dans votre navigateur habituel, videz plutôt les fichiers en cache et les cookies du site. Dans les deux cas, le but est le même : forcer la prochaine connexion à récupérer une copie propre de votre compte plutôt que de réutiliser celle, périmée, qui a causé le rejet." },
        { title: "Reconnectez-vous et choisissez le bon compte", html: "Reconnectez-vous et faites attention au compte sur lequel vous arrivez. Si vous tradez plusieurs évaluations ou gérez un compte personnel à côté d'un compte financé, assurez-vous que le sélecteur de compte est réglé sur le compte exact que vous voulez trader. Arriver sur le mauvais compte est une variante à part de &ldquo;Account Incorrect&rdquo;, et c'est facile à manquer quand la plateforme se rouvre sur le dernier compte ouvert." },
        { title: "Re-liez les clés de votre prop firm", html: "Si le rejet est survenu juste après une réinitialisation ou un changement côté firme, une connexion propre ne suffit parfois pas à elle seule. La liaison entre le tableau de bord de votre firme et Tradovate doit être reconstruite pour que les deux côtés s'accordent sur le compte actuel. Rendez-vous dans le tableau de bord de votre prop firm, trouvez l'endroit où elle gère la connexion Tradovate et re-liez ou reconnectez les identifiants. La formulation exacte varie selon la firme, mais vous cherchez l'option qui rétablit ou actualise le lien Tradovate, pas celle qui crée un tout nouveau compte. Pendant que vous y êtes, surveillez une seconde invite d'authentification contradictoire, car deux étapes d'authentification à deux facteurs concurrentes peuvent laisser le lien à moitié formé." },
        { title: "Envoyez un petit ordre de test", html: "Ne présumez pas que c'est réglé. Passez un seul contrat micro, ou un ordre à cours limité placé bien à distance du marché, et vérifiez qu'il est accepté et actif. S'il est exécuté ou reste en attente sans rejet, vous êtes de nouveau opérationnel et pouvez trader normalement. S'il est de nouveau rejeté avec le même message, poursuivez le dépannage." },
      ],
    },
    { type: "quote",html: "Les extensions de navigateur, en particulier les bloqueurs de publicités et les outils de confidentialité, peuvent perturber la connexion et le handshake du compte. Une fenêtre de navigation privée les contourne toutes d'un coup, ce qui est généralement plus rapide que de fouiller dans les paramètres." },
    { type: "heading",text: "Si le rejet persiste" },
    { type: "paragraph",html: "Un &ldquo;Account Incorrect&rdquo; tenace qui survit à une reconnexion complète a généralement l'une de ces causes :" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>L'horloge de votre système est décalée.</strong> La connexion et la synchronisation de Tradovate sont sensibles à l'heure. Sous Windows, faites un clic droit sur l'horloge de la barre des tâches, ouvrez les paramètres de date et d'heure et cliquez sur synchroniser maintenant pour que votre machine soit à l'heure réelle. Une horloge qui dérive ne serait-ce que d'une minute peut casser le handshake.",
        "<strong class='text-white'>La firme n'a pas fini le provisionnement.</strong> Juste après un achat ou une réinitialisation, un compte peut mettre du temps à être entièrement configuré côté firme. Si tout est propre de votre côté, laissez-lui du temps et réessayez avant de supposer que quelque chose est cassé.",
        "<strong class='text-white'>Le lien dans le tableau de bord de la firme n'a pas pris.</strong> Retournez dans le tableau de bord et vérifiez que la connexion Tradovate apparaît bien comme liée, et non en attente ou en erreur. Re-liez-la une fois de plus si elle semble bloquée.",
        "<strong class='text-white'>C'est réellement un problème côté firme.</strong> Comme la prop firm possède et contrôle le compte, certains problèmes de synchronisation ne peuvent être réglés que par elle. Si la reconnexion et la re-liaison échouent toutes deux, ouvrez un ticket auprès de la firme et décrivez précisément quand le rejet a commencé, idéalement juste après quelle réinitialisation ou fenêtre de maintenance.",
      ],
    },
    { type: "heading",text: "Éviter que cela se reproduise" },
    { type: "paragraph",html: "Quelques habitudes permettent de réduire ces rejets à presque zéro. Tradez depuis une seule session au lieu de rester connecté sur trois appareils. Après chaque réinitialisation d'évaluation ou changement côté firme, re-liez la connexion avant de passer votre premier ordre plutôt que de le découvrir en plein trade. Et lorsque Tradovate annonce une maintenance, attendez-vous à ce que la première connexion qui suit nécessite une réauthentification propre : prévoyez donc de vous déconnecter puis de vous reconnecter avant la réouverture de la session." },
    { type: "paragraph",html: "Si vous acheminez vos ordres par automatisation, c'est encore plus important, car une connexion périmée peut rejeter silencieusement un signal sans que vous voyiez jamais qu'il est arrivé. Construire une liaison fiable une fois pour toutes et laisser un bridge gérer les reconnexions évite qu'une mauvaise session engloutisse discrètement vos entrées." },
  ], it: [
    { type: "paragraph",html: "Ha appena resettato la Sua valutazione, oppure la Sua società ha eseguito una sincronizzazione, e ora ogni ordine che invia viene respinto con un rifiuto &ldquo;Account Incorrect&rdquo;. Non c'è nulla di sbagliato nella Sua dimensione né nel Suo stop. La piattaforma semplicemente non lascia passare l'ordine. È uno dei rifiuti più confusi perché non indica nulla di ciò che sta effettivamente facendo con il trade." },
    { type: "paragraph",html: "La versione breve: si tratta di un disallineamento di login e sincronizzazione, non di un problema di rischio o di margine. La Sua sessione attiva punta a una versione del conto che non corrisponde più a quella che il broker si aspetta. La soluzione è quasi sempre la stessa breve sequenza: disconnettersi completamente, svuotare la cache o aprire una finestra di navigazione in incognito, riaccedere e ricollegare le chiavi della Sua prop firm in modo che la connessione si risincronizzi. Nove volte su dieci l'ordine passa subito dopo." },
    { type: "heading",text: "Che cosa significa davvero «Account Incorrect»" },
    { type: "paragraph",html: "Quando invia un ordine, Tradovate deve far corrispondere la Sua sessione attiva all'esatto conto verso cui l'ordine deve essere instradato, e poi passarlo alla borsa. &ldquo;Account Incorrect&rdquo; è ciò che ottiene quando questa corrispondenza fallisce. L'ordine non raggiunge mai il motore di matching. Viene respinto a livello di identità, prima dei controlli di rischio, prima del margine, prima di qualsiasi cosa riguardi il contratto." },
    { type: "paragraph",html: "Ecco perché i consigli abituali sui rifiuti degli ordini qui non aiutano. Ridurre la quantità non lo risolve. Firmare un accordo sui dati non lo risolve. Il conto che la Sua sessione <em>crede</em> di negoziare e il conto verso cui il sistema vuole instradare si sono allontanati, e occorre riallinearli. Questo è tutto il lavoro." },
    { type: "heading",text: "Perché compare subito dopo una sincronizzazione o un reset" },
    { type: "paragraph",html: "Questo rifiuto si concentra attorno a pochi momenti, e in ciascuno di essi la Sua sessione conserva informazioni obsolete:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Ha resettato una valutazione.</strong> La società crea un nuovo conto dietro lo stesso login, ma la Sua sessione aperta fa ancora riferimento al vecchio.",
        "<strong class='text-white'>Le credenziali sono cambiate lato società.</strong> Un reset della password, un nuovo conto predisposto o un cambio di piano possono rendere obsoleta la Sua sessione corrente.",
        "<strong class='text-white'>Manutenzione della piattaforma o interruzione.</strong> Dopo un fermo lato Tradovate, le sessioni rimaste aperte durante la finestra di manutenzione tornano spesso sincronizzate solo a metà e respingono le nuove entrate finché non si riautentica.",
        "<strong class='text-white'>È connesso su troppi dispositivi.</strong> Tradovate Le consente al massimo due sessioni attive. Quando web, desktop, mobile e un collegamento TradingView si contendono lo stesso conto, può prevalere la sessione sbagliata e instradare in modo errato.",
        "<strong class='text-white'>Un bridge o uno strumento di terze parti si è riautenticato.</strong> Quando la Sua automazione si riconnette, ristabilisce il collegamento al conto, e una sessione del browser obsoleta può andare fuori sincrono rispetto ad esso.",
      ],
    },
    { type: "paragraph",html: "Il filo comune è una vista del conto memorizzata in cache e non aggiornata. Tutto ciò che segue riguarda lo svuotamento di quella cache e la ricostruzione della connessione da zero." },
    { type: "heading",text: "Per prima cosa, confermi il motivo del rifiuto" },
    { type: "paragraph",html: "Prima di iniziare a cancellare qualsiasi cosa, legga il testo effettivo del rifiuto. Due rifiuti possono sembrare quasi identici nel piccolo pop-up, e non vuole perdere dieci minuti a ricollegare chiavi quando il vero problema era un limite di rischio o un contratto scaduto." },
    { type: "paragraph",html: "Il modo più rapido è direttamente dal modulo Orders: trovi l'ordine respinto nell'elenco, vi clicchi sopra (oppure clic destro e scelga Order Details) e legga il messaggio di rifiuto nel pannello dei dettagli. Può anche recuperarlo dal modulo Reports scegliendo Order Details, inserendo il numero dell'ordine ed eseguendo il report. Tradovate indica il motivo in linguaggio chiaro, quindi lasci che sia il messaggio a dirLe con che cosa ha a che fare, invece di tirare a indovinare." },
    { type: "paragraph",html: "Se il messaggio riguarda davvero il conto o la sincronizzazione, prosegua. Se cita un limite di rischio, una quotazione o un contratto, è nella pagina sbagliata, e un'altra guida sui rifiuti degli ordini La porterà lì più in fretta." },
    { type: "heading",text: "La soluzione, passo dopo passo" },
    {
      type: "steps",
      items: [
        { title: "Si disconnetta completamente da ogni sessione", html: "Non si limiti a chiudere la scheda. Esca davvero dal menu del conto, in modo che la sessione venga eliminata sul server e non solo nascosta sullo schermo. Poi controlli ogni altro posto in cui potrebbe essere connesso: l'app desktop, l'app mobile, un secondo browser e qualsiasi collegamento TradingView legato allo stesso conto. Poiché Tradovate consente solo due sessioni attive, un login dimenticato sul telefono può continuare a riaffermare il conto obsoleto." },
        { title: "Svuoti la cache o usi una finestra in incognito", html: "Una volta fuori, elimini i dati di sessione memorizzati. La via rapida è una finestra privata o in incognito, che parte con la cache vuota e senza estensioni di mezzo. Se preferisce restare nel Suo browser abituale, svuoti invece i file in cache e i cookie del sito. In entrambi i casi lo scopo è lo stesso: costringere il prossimo login a recuperare una copia pulita del conto invece di riutilizzare quella obsoleta che ha causato il rifiuto." },
        { title: "Riaccede e sceglie il conto giusto", html: "Acceda di nuovo e faccia attenzione a quale conto si apre. Se negozia più valutazioni o gestisce un conto personale accanto a uno finanziato, si assicuri che il selettore del conto sia impostato esattamente sul conto che intende negoziare. Finire sul conto sbagliato è una variante a sé di &ldquo;Account Incorrect&rdquo;, ed è facile non accorgersene quando la piattaforma si riapre sull'ultimo conto utilizzato." },
        { title: "Ricolleghi le chiavi della Sua prop firm", html: "Se il rifiuto è comparso subito dopo un reset o una modifica lato società, a volte un login pulito da solo non basta. Il collegamento tra la dashboard della società e Tradovate deve essere ricostruito affinché entrambe le parti concordino sul conto corrente. Vada nella dashboard della Sua prop firm, trovi dove gestisce la connessione a Tradovate e ricolleghi o riconnetta le credenziali. La dicitura esatta varia da società a società, ma cerchi l'opzione che ristabilisce o aggiorna il collegamento a Tradovate, non quella che crea un conto completamente nuovo. Già che c'è, faccia attenzione a una seconda richiesta di autenticazione in conflitto, perché due passaggi di autenticazione a due fattori concorrenti possono lasciare il collegamento formato solo a metà." },
        { title: "Invii un piccolo ordine di prova", html: "Non dia per scontato che sia risolto. Invii un singolo contratto micro, oppure un ordine limit posizionato ben lontano dal mercato, e verifichi che venga accettato e risulti attivo. Se viene eseguito o resta in attesa senza rifiuto, è di nuovo operativo e può negoziare normalmente. Se viene respinto di nuovo con lo stesso messaggio, continui la risoluzione dei problemi." },
      ],
    },
    { type: "quote",html: "Le estensioni del browser, in particolare gli ad blocker e gli strumenti per la privacy, possono interferire con il login e con l'handshake del conto. Una finestra in incognito le aggira tutte in una volta, ed è per questo che di solito è più rapida che cercare tra le impostazioni." },
    { type: "heading",text: "Se continua a essere respinto" },
    { type: "paragraph",html: "Un &ldquo;Account Incorrect&rdquo; ostinato che sopravvive a un login completo ha di solito una di queste cause:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>L'orologio del Suo sistema è sballato.</strong> Il login e la sincronizzazione di Tradovate sono sensibili all'ora. Su Windows, clicchi con il tasto destro sull'orologio nella barra delle applicazioni, apra le impostazioni di data e ora e faccia clic su sincronizza ora in modo che il Suo computer corrisponda all'ora reale. Un orologio sfasato anche solo di un minuto può far fallire l'handshake.",
        "<strong class='text-white'>La società non ha ancora terminato la predisposizione.</strong> Subito dopo un acquisto o un reset, un conto può richiedere tempo per essere completamente configurato lato società. Se da parte Sua è tutto a posto, gli dia tempo e riprovi prima di supporre che qualcosa sia rotto.",
        "<strong class='text-white'>Il collegamento nella dashboard della società non ha avuto effetto.</strong> Torni nella dashboard e verifichi che la connessione a Tradovate risulti effettivamente collegata, non in sospeso o in errore. Ricolleghi ancora una volta se sembra bloccata.",
        "<strong class='text-white'>È davvero un problema lato società.</strong> Poiché la prop firm possiede e controlla il conto, alcuni problemi di sincronizzazione possono essere risolti solo da essa. Se sia il nuovo login sia il ricollegamento falliscono, apra un ticket con la società e descriva esattamente quando è iniziato il rifiuto, idealmente subito dopo quale reset o finestra di manutenzione.",
      ],
    },
    { type: "heading",text: "Come evitare che si ripeta" },
    { type: "paragraph",html: "Con poche abitudini può ridurre questi rifiuti quasi a zero. Operi da una sola sessione invece di restare connesso su tre dispositivi. Dopo ogni reset della valutazione o modifica lato società, ricolleghi la connessione prima di inviare il primo ordine invece di scoprirlo a metà trade. E quando Tradovate annuncia una manutenzione, si aspetti che il primo login successivo richieda una riautenticazione pulita, quindi preveda di disconnettersi e riaccedere prima della riapertura della sessione." },
    { type: "paragraph",html: "Se instrada gli ordini tramite automazione, questo conta ancora di più, perché una connessione obsoleta può respingere in silenzio un segnale senza che Lei veda mai che è arrivato. Costruire una volta un collegamento affidabile e lasciare che un bridge gestisca le riconnessioni evita che una sessione difettosa si mangi di nascosto le Sue entrate." },
  ] },
  ctaHeading: { en: "Stop Babysitting Logins and Re-Syncs", de: "Schluss mit dem Babysitting von Logins und Re-Syncs", es: "Deje de vigilar inicios de sesión y resincronizaciones", fr: "Arrêtez de surveiller vos connexions et vos resynchronisations", it: "Smetta di sorvegliare login e risincronizzazioni" },
  ctaText: { en: "PickMyTrade routes your TradingView alerts to Tradovate and prop accounts automatically, so a stale session doesn't cost you the trade.", de: "PickMyTrade leitet Ihre TradingView-Alerts automatisch an Tradovate und Prop-Konten weiter, sodass eine veraltete Sitzung Sie nicht den Trade kostet.", es: "PickMyTrade enruta sus alertas de TradingView a Tradovate y a las cuentas de prop firms automáticamente, para que una sesión obsoleta no le cueste la operación.", fr: "PickMyTrade achemine automatiquement vos alertes TradingView vers Tradovate et vos comptes prop, afin qu'une session périmée ne vous fasse pas manquer le trade.", it: "PickMyTrade instrada automaticamente i Suoi alert di TradingView verso Tradovate e i conti prop, così una sessione obsoleta non Le fa perdere il trade." },
  ctaButtonText: { en: "Start Your Free 7-Day Trial", de: "Starten Sie Ihre kostenlose 7-Tage-Testphase", es: "Comience su prueba gratuita de 7 días", fr: "Commencez votre essai gratuit de 7 jours", it: "Inizi la prova gratuita di 7 giorni" },
  ctaUrl: "https://app.pickmytrade.trade/?register=true&utm_source=content&utm_medium=debugging",
  faqHeading: { en: "Frequently Asked Questions", de: "Häufig gestellte Fragen", es: "Preguntas frecuentes", fr: "Questions fréquentes", it: "Domande frequenti" },
  faqs: { en: [
    { q: "What does the \"Account Incorrect\" rejection mean in Tradovate?", a: "It means your live session and the account the order is being routed to don't line up, so the order is bounced before it reaches the exchange. It's an identity and sync problem, not a margin, risk, or contract problem. Re-authenticating so the platform reloads the correct account almost always clears it." },
    { q: "Why does it happen right after a prop firm reset or sync?", a: "After an evaluation reset, a credential change on the firm side, or platform maintenance, your open browser session can still be holding a stale reference to the old account state. The order routes against outdated information and gets rejected. Logging out and back in forces a fresh handshake that pulls the current account details." },
    { q: "Will logging out and back in lose my open positions?", a: "No. Positions and working orders live on the broker and firm side, not inside your browser tab, so they survive a logout. That said, if you are flat and the session is misbehaving during fast conditions, confirm your exposure on another device before you lean on a fresh login." },
    { q: "Do I contact Tradovate or my prop firm to fix it?", a: "For a funded or evaluation account, the firm owns and provisions the account, so start with the firm. If a clean re-login, a cache clear, and re-linking the keys in the firm dashboard don't resolve it, open a ticket with the prop firm first and let them escalate to Tradovate if needed." },
    { q: "How do I confirm the rejection was actually \"Account Incorrect\"?", a: "Open the rejected order in the Orders module and read the exact rejection text in the order details, or pull it from the Reports module under Order Details. Read the message before you act, because a similar-looking rejection can actually be a risk-limit or contract issue that needs a completely different fix." },
  ], de: [
    { q: "Was bedeutet die Ablehnung „Account Incorrect“ in Tradovate?", a: "Sie bedeutet, dass Ihre aktive Sitzung und das Konto, an das die Order geleitet wird, nicht zusammenpassen, sodass die Order abgewiesen wird, bevor sie die Börse erreicht. Es ist ein Identitäts- und Synchronisierungsproblem, kein Margin-, Risiko- oder Kontraktproblem. Eine erneute Authentifizierung, bei der die Plattform das richtige Konto neu lädt, behebt es fast immer." },
    { q: "Warum tritt es direkt nach einem Reset oder einer Synchronisierung beim Prop-Firm auf?", a: "Nach einem Evaluierungs-Reset, einer Änderung der Zugangsdaten auf Seiten der Firma oder einer Plattformwartung kann Ihre geöffnete Browsersitzung noch einen veralteten Verweis auf den alten Kontostatus enthalten. Die Order wird anhand überholter Informationen geroutet und abgelehnt. Durch Aus- und erneutes Einloggen erzwingen Sie einen frischen Handshake, der die aktuellen Kontodaten abruft." },
    { q: "Gehen meine offenen Positionen verloren, wenn ich mich aus- und wieder einlogge?", a: "Nein. Positionen und aktive Orders liegen beim Broker bzw. der Firma und nicht in Ihrem Browser-Tab, daher bleiben sie nach einem Logout erhalten. Wenn Sie jedoch flat sind und die Sitzung in schnellen Marktphasen Probleme macht, prüfen Sie Ihr Exposure auf einem anderen Gerät, bevor Sie sich auf ein frisches Login verlassen." },
    { q: "Muss ich mich an Tradovate oder mein Prop-Firm wenden?", a: "Bei einem finanzierten oder Evaluierungs-Konto besitzt und stellt die Firma das Konto bereit, beginnen Sie also dort. Wenn ein sauberes erneutes Einloggen, das Leeren des Caches und das erneute Verknüpfen der Schlüssel im Firmen-Dashboard das Problem nicht lösen, eröffnen Sie zuerst ein Ticket beim Prop-Firm und lassen Sie es bei Bedarf an Tradovate eskalieren." },
    { q: "Wie bestätige ich, dass die Ablehnung tatsächlich „Account Incorrect“ war?", a: "Öffnen Sie die abgelehnte Order im Modul Orders und lesen Sie den genauen Ablehnungstext in den Order-Details, oder rufen Sie ihn im Modul Reports unter Order Details ab. Lesen Sie die Meldung, bevor Sie handeln, denn eine ähnlich aussehende Ablehnung kann in Wirklichkeit ein Risikolimit- oder Kontraktproblem sein, das eine völlig andere Lösung erfordert." },
  ], es: [
    { q: "¿Qué significa el rechazo «Account Incorrect» en Tradovate?", a: "Significa que su sesión activa y la cuenta a la que se enruta la orden no coinciden, por lo que la orden rebota antes de llegar al mercado. Es un problema de identidad y sincronización, no de margen, riesgo o contrato. Volver a autenticarse para que la plataforma recargue la cuenta correcta lo resuelve casi siempre." },
    { q: "¿Por qué ocurre justo después de un reinicio o una sincronización con la prop firm?", a: "Tras un reinicio de evaluación, un cambio de credenciales en la firma o un mantenimiento de la plataforma, su sesión abierta en el navegador puede seguir manteniendo una referencia obsoleta al estado anterior de la cuenta. La orden se enruta con información desactualizada y es rechazada. Cerrar sesión y volver a entrar fuerza un nuevo handshake que obtiene los datos actuales de la cuenta." },
    { q: "¿Perderé mis posiciones abiertas si cierro sesión y vuelvo a entrar?", a: "No. Las posiciones y las órdenes activas residen en el broker y en la firma, no en la pestaña de su navegador, por lo que sobreviven al cierre de sesión. Dicho esto, si está en plano y la sesión falla en condiciones de mercado rápidas, confirme su exposición en otro dispositivo antes de fiarse de un inicio de sesión nuevo." },
    { q: "¿Debo contactar con Tradovate o con mi prop firm para solucionarlo?", a: "En una cuenta financiada o de evaluación, la firma es propietaria de la cuenta y la aprovisiona, así que empiece por ella. Si un nuevo inicio de sesión limpio, vaciar la caché y volver a vincular las claves en el panel de la firma no lo resuelven, abra primero un ticket con la prop firm y deje que ella lo escale a Tradovate si hace falta." },
    { q: "¿Cómo confirmo que el rechazo fue realmente «Account Incorrect»?", a: "Abra la orden rechazada en el módulo Orders y lea el texto exacto del rechazo en los detalles de la orden, u obténgalo en el módulo Reports, en Order Details. Lea el mensaje antes de actuar, porque un rechazo de aspecto similar puede ser en realidad un problema de límite de riesgo o de contrato que requiere una solución completamente distinta." },
  ], fr: [
    { q: "Que signifie le rejet « Account Incorrect » dans Tradovate ?", a: "Cela signifie que votre session active et le compte vers lequel l'ordre est acheminé ne correspondent pas, de sorte que l'ordre est renvoyé avant d'atteindre la bourse. C'est un problème d'identité et de synchronisation, pas un problème de marge, de risque ou de contrat. Se réauthentifier pour que la plateforme recharge le bon compte le règle presque toujours." },
    { q: "Pourquoi cela survient-il juste après une réinitialisation ou une synchronisation avec la prop firm ?", a: "Après une réinitialisation d'évaluation, un changement d'identifiants côté firme ou une maintenance de la plateforme, votre session de navigateur ouverte peut encore contenir une référence périmée à l'ancien état du compte. L'ordre est acheminé avec des informations obsolètes et il est rejeté. Se déconnecter puis se reconnecter force un nouveau handshake qui récupère les informations actuelles du compte." },
    { q: "Me déconnecter puis me reconnecter me fera-t-il perdre mes positions ouvertes ?", a: "Non. Les positions et les ordres actifs se trouvent chez le broker et la firme, pas dans l'onglet de votre navigateur, ils survivent donc à une déconnexion. Cela dit, si vous êtes à plat et que la session se comporte mal en marché rapide, vérifiez votre exposition sur un autre appareil avant de vous fier à une nouvelle connexion." },
    { q: "Dois-je contacter Tradovate ou ma prop firm pour le résoudre ?", a: "Pour un compte financé ou d'évaluation, c'est la firme qui possède et provisionne le compte : commencez donc par elle. Si une reconnexion propre, un vidage du cache et la re-liaison des clés dans le tableau de bord de la firme ne règlent pas le problème, ouvrez d'abord un ticket auprès de la prop firm et laissez-la escalader vers Tradovate si nécessaire." },
    { q: "Comment confirmer que le rejet était bien « Account Incorrect » ?", a: "Ouvrez l'ordre rejeté dans le module Orders et lisez le texte exact du rejet dans les détails de l'ordre, ou récupérez-le dans le module Reports sous Order Details. Lisez le message avant d'agir, car un rejet d'apparence similaire peut en réalité être un problème de limite de risque ou de contrat qui exige une tout autre solution." },
  ], it: [
    { q: "Che cosa significa il rifiuto «Account Incorrect» in Tradovate?", a: "Significa che la Sua sessione attiva e il conto verso cui viene instradato l'ordine non corrispondono, quindi l'ordine viene respinto prima di raggiungere la borsa. È un problema di identità e sincronizzazione, non di margine, rischio o contratto. Autenticarsi di nuovo, in modo che la piattaforma ricarichi il conto corretto, lo risolve quasi sempre." },
    { q: "Perché si verifica subito dopo un reset o una sincronizzazione con la prop firm?", a: "Dopo un reset della valutazione, una modifica delle credenziali lato società o una manutenzione della piattaforma, la Sua sessione aperta nel browser può ancora contenere un riferimento obsoleto al vecchio stato del conto. L'ordine viene instradato con informazioni superate e viene respinto. Disconnettersi e riaccedere forza un nuovo handshake che recupera i dati correnti del conto." },
    { q: "Disconnettermi e riaccedere farà perdere le mie posizioni aperte?", a: "No. Le posizioni e gli ordini attivi risiedono presso il broker e la società, non nella scheda del Suo browser, quindi sopravvivono a un logout. Detto questo, se è flat e la sessione dà problemi in condizioni di mercato veloci, verifichi la Sua esposizione su un altro dispositivo prima di fare affidamento su un nuovo login." },
    { q: "Devo contattare Tradovate o la mia prop firm per risolverlo?", a: "Per un conto finanziato o di valutazione, la società possiede e predispone il conto, quindi inizi da essa. Se un nuovo login pulito, lo svuotamento della cache e il ricollegamento delle chiavi nella dashboard della società non risolvono il problema, apra prima un ticket con la prop firm e lasci che lo inoltri a Tradovate se necessario." },
    { q: "Come confermo che il rifiuto fosse davvero «Account Incorrect»?", a: "Apra l'ordine respinto nel modulo Orders e legga il testo esatto del rifiuto nei dettagli dell'ordine, oppure lo recuperi dal modulo Reports sotto Order Details. Legga il messaggio prima di agire, perché un rifiuto dall'aspetto simile può in realtà essere un problema di limite di rischio o di contratto che richiede una soluzione completamente diversa." },
  ] },
  relatedHeading: { en: "Related Guides", de: "Ähnliche Anleitungen", es: "Guías relacionadas", fr: "Guides associés", it: "Guide correlate" },
  disclosureText: { en: "This guide is for educational and informational purposes only and is not financial, investment, or trading advice. Trading futures and other leveraged products carries a substantial risk of loss and is not suitable for every investor. PickMyTrade is an independent third-party automation platform and is not affiliated with, endorsed by, or sponsored by Tradovate, Inc. All related names, logos, and trademarks are the property of their respective owners. Platform features and steps change over time, so always confirm the current process in the official platform documentation before acting.", de: "Diese Anleitung dient ausschließlich Bildungs- und Informationszwecken und stellt keine Finanz-, Anlage- oder Handelsberatung dar. Der Handel mit Futures und anderen gehebelten Produkten birgt ein erhebliches Verlustrisiko und ist nicht für jeden Anleger geeignet. PickMyTrade ist eine unabhängige Automatisierungsplattform eines Drittanbieters und steht in keiner Verbindung zu Tradovate, Inc., wird weder von dieser Gesellschaft unterstützt noch gesponsert. Alle genannten Namen, Logos und Marken sind Eigentum ihrer jeweiligen Inhaber. Funktionen und Schritte der Plattform ändern sich im Laufe der Zeit. Bestätigen Sie daher stets den aktuellen Ablauf in der offiziellen Dokumentation der Plattform, bevor Sie handeln.", es: "Esta guía tiene fines exclusivamente educativos e informativos y no constituye asesoramiento financiero, de inversión ni de trading. Operar con futuros y otros productos apalancados conlleva un riesgo sustancial de pérdida y no es adecuado para todos los inversores. PickMyTrade es una plataforma de automatización independiente de terceros y no está afiliada, respaldada ni patrocinada por Tradovate, Inc. Todos los nombres, logotipos y marcas relacionados son propiedad de sus respectivos titulares. Las funciones y los pasos de la plataforma cambian con el tiempo, por lo que debe confirmar siempre el proceso vigente en la documentación oficial de la plataforma antes de actuar.", fr: "Ce guide est fourni à des fins strictement éducatives et informatives et ne constitue pas un conseil financier, d'investissement ou de trading. Le trading de contrats à terme et d'autres produits à effet de levier comporte un risque de perte important et ne convient pas à tous les investisseurs. PickMyTrade est une plateforme d'automatisation tierce indépendante, non affiliée à Tradovate, Inc., ni approuvée ou parrainée par celle-ci. Tous les noms, logos et marques associés sont la propriété de leurs détenteurs respectifs. Les fonctionnalités et les étapes de la plateforme évoluent avec le temps ; vérifiez donc toujours la procédure en vigueur dans la documentation officielle de la plateforme avant d'agir.", it: "Questa guida ha esclusivamente finalità educative e informative e non costituisce consulenza finanziaria, di investimento o di trading. Il trading di futures e di altri prodotti a leva comporta un rischio sostanziale di perdita e non è adatto a tutti gli investitori. PickMyTrade è una piattaforma di automazione indipendente di terze parti e non è affiliata, approvata né sponsorizzata da Tradovate, Inc. Tutti i nomi, i loghi e i marchi correlati sono di proprietà dei rispettivi titolari. Le funzionalità e i passaggi della piattaforma cambiano nel tempo, quindi verifichi sempre la procedura attuale nella documentazione ufficiale della piattaforma prima di agire." },
};
