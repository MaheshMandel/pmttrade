---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "market-replay-only-last-price";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/debugging/${SLUG}`;

const META_TITLE = "Tradovate Market Replay Shows Only Last Price";
const META_DESCRIPTION =
  "Market Replay stuck showing only the last price with no bid or ask, and replay orders erroring out? Here's why it breaks and the fastest workarounds.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Tradovate Market Replay zeigt nur den letzten Preis", es: "Tradovate Market Replay muestra solo el último precio", fr: "Tradovate Market Replay n'affiche que le dernier prix", it: "Tradovate Market Replay mostra solo l'ultimo prezzo" },
  dek: { en: "The replay clock is ticking, but the DOM is dead: only a last-traded price, no bid, no ask, and every order you try errors out. Here's why this is a server-side data breakage, not something on your machine, and what actually keeps you practicing.", de: "Die Replay-Uhr läuft, aber das DOM ist tot: nur ein letzter Handelspreis, kein Bid, kein Ask, und jede Order, die Sie versuchen, endet mit einem Fehler. Hier erfahren Sie, warum es sich um einen serverseitigen Datenfehler handelt und nicht um ein Problem auf Ihrem Rechner, und was Ihnen tatsächlich weiterhilft, damit Sie üben können.", es: "El reloj del replay avanza, pero el DOM está muerto: solo un último precio negociado, sin bid, sin ask, y cada orden que intenta termina en error. Aquí le explicamos por qué se trata de una avería de datos del lado del servidor y no de algo en su equipo, y qué le permite seguir practicando de verdad.", fr: "L'horloge du replay tourne, mais le DOM est mort : seulement un dernier prix échangé, ni bid ni ask, et chaque ordre que vous tentez se solde par une erreur. Voici pourquoi il s'agit d'une panne de données côté serveur et non d'un problème sur votre machine, et ce qui vous permet réellement de continuer à vous entraîner.", it: "L'orologio del replay scorre, ma il DOM è morto: solo un ultimo prezzo negoziato, nessun bid, nessun ask, e ogni ordine che tenta genera un errore. Ecco perché si tratta di un guasto dei dati lato server e non di un problema sul suo computer, e che cosa le permette davvero di continuare a esercitarsi." },
  readTime: { en: "8 min read", de: "8 Min. Lesezeit", es: "Lectura de 8 min", fr: "Lecture : 8 min", it: "Lettura di 8 min" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "You load up Market Replay to rehearse a session, hit play, and the clock starts ticking through the day like it should. But the ladder is dead. Every contract shows nothing but the last traded price, the bid and ask columns are blank, and the moment you try to buy or sell, the order errors out instead of filling. Nothing you click brings the quotes back. If that's what you're staring at, you didn't misconfigure anything. This is a data-delivery breakage in Tradovate's replay stream, it's recurred across several platform versions, and it isn't something you fix from your side with a setting. What you can do is confirm it's the known problem, get yourself a working practice environment in the meantime, and report the session so it gets patched. Here's the whole picture." },
    {
      type: "checklist",
      heading: "What to Do Right Now",
      items: [
        "<strong class='text-white'>Restart the replay session and reload the app:</strong> occasionally the stream reconnects with the bid/ask intact.",
        "<strong class='text-white'>Re-pick the date, time, and product:</strong> start a fresh session rather than resuming the broken one.",
        "<strong class='text-white'>Confirm the Market Replay add-on is still active:</strong> check under Application Settings so you can rule out a lapsed subscription.",
        "<strong class='text-white'>Switch to live Simulated Trading:</strong> a sim account on the real-time feed gives you a working bid/ask so you can keep practicing.",
        "<strong class='text-white'>Report it with the date, time, and product:</strong> that's what lets Tradovate reproduce and escalate the defect.",
      ],
    },
    { type: "heading", text: "What \"Only the Last Price\" Actually Looks Like" },
    { type: "paragraph", html: "When replay is healthy, you get the full order book playing back in fast-forward: a bid ladder and an ask ladder moving tick by tick, volume printing at each level, and simulated fills that behave like the real session did. That's the whole point of replay, and it's why the add-on advertises full depth of market for volume analysis." },
    { type: "paragraph", html: "When this bug hits, the depth is gone. The chart still progresses, so time is clearly advancing, but the DOM only ever shows one number per contract: the last print. No inside bid. No inside ask. No ladder. It's the same on every symbol you load, which is a tell in itself. Then the second half of the problem shows up: you try to place an order into that empty ladder and it doesn't fill, it throws an error. A buy that should have lifted the ask has no ask to lift, so the replay engine rejects it." },
    { type: "paragraph", html: "This isn't a brand-new glitch either. The same family of symptoms keeps resurfacing under different labels: bid/ask that freezes partway through a session, replay that runs for five or ten seconds and then stalls, replay that simply won't start on the web client, and this exact last-price-only state. Different wrappers, same underlying issue: the replay data stream isn't delivering quotes." },
    { type: "heading", text: "Why Replay Breaks This Way" },
    { type: "paragraph", html: "Market Replay works by streaming a recorded historical session straight from Tradovate's servers, quotes and depth included, and replaying it into a simulated account so your orders fill against what the book actually did. You're not downloading a file or running a local simulation. Every bid, ask, and print you see is being pushed from the server in the correct sequence." },
    { type: "paragraph", html: "That design is exactly why this failure looks the way it does. When the stream drops its quote layer and keeps sending only last-trade prints, your client faithfully renders what it receives, which is a moving chart with an empty book. There's no local cache of the missing quotes to fall back on and no toggle that rebuilds them, because they were never delivered. This is why refreshing, re-adding the DOM, or fiddling with chart settings changes nothing." },
    { type: "paragraph", html: "The order errors follow directly from the same gap. A simulated fill in replay needs a counter-price: something on the bid for your sell, something on the ask for your buy. Strip out the bid and ask and a marketable order has no reference price to execute against, so instead of filling it returns a rejection. That's why the missing quotes and the failed orders always travel together during this outage. They're one defect, not two." },
    { type: "paragraph", html: "Because the break is on the delivery side, it tends to hit everyone on the affected build at once and clear only when Tradovate ships a fix. That's frustrating, but it also means you can stop hunting through your own settings for a cause that isn't there." },
    { type: "heading", text: "How to Get Unstuck: Step by Step" },
    { type: "paragraph", html: "Work these in order. The first step occasionally clears a one-off connection hiccup; the later steps are about keeping your practice going and getting the real defect on the record." },
    { type: "heading", text: "1. Restart the Session and Reload the Platform" },
    {
      type: "steps",
      items: [
        { title: "Stop the current session", html: "Stop the current replay session rather than letting it run in the broken state." },
        { title: "Fully reload the platform", html: "Fully reload the platform: press <strong class='text-white'>F5</strong> on the web client, or close and reopen the desktop app." },
        { title: "Start a brand-new session", html: "Start a brand-new replay session and re-select the <strong class='text-white'>start date and time</strong>, the <strong class='text-white'>replay rate</strong>, your <strong class='text-white'>initial balance</strong>, and the <strong class='text-white'>account</strong>, then start it again." },
        { title: "Test with a single product first", html: "Load a single common product first (something like ES or NQ) and watch whether the bid/ask ladder populates before you build out a full workspace." },
      ],
    },
    { type: "paragraph", html: "If the ladder fills in and orders execute, you hit a transient reconnect and you're back in business. If it comes back empty on a fresh session, the stream is genuinely down and no amount of restarting will conjure the quotes. Move on rather than burning time on repeat reloads." },
    { type: "heading", text: "2. Confirm the Market Replay Add-On Is Still Active" },
    { type: "paragraph", html: "Before you assume it's an outage, rule out a lapsed subscription, because an expired replay add-on can also cut you off. Open <strong class='text-white'>Application Settings</strong>, go to the <strong class='text-white'>Add-Ons</strong> tab, and find the <strong class='text-white'>Market Replay</strong> panel. Check that it shows as active (or that your trial hasn't run out). Note the difference in symptom, though: a lapsed add-on usually blocks replay from starting at all, whereas this bug lets replay start and run but with the book stripped out. If your add-on is active and you still get last-price-only, you've confirmed it's the defect and not a billing lapse." },
    { type: "heading", text: "3. Switch to Live Simulated Trading So You Can Keep Practicing" },
    { type: "paragraph", html: "This is the workaround that actually keeps you productive. Tradovate's free simulated trading account trades the live real-time feed with virtual money, so it has a real, moving bid and ask. Switch your active account to the simulated one and place orders there. You lose the ability to rewind and drill a specific historical moment, but you get a fully working execution sandbox: real quotes, real fills, no last-price-only wall." },
    { type: "paragraph", html: "For most day-to-day rehearsal (order entry, bracket placement, stop management, getting your clicks fast), live sim covers you completely while replay is broken. Save the historical-session work for after the fix lands. If your live-sim data itself looks delayed or the symbol name shows orange, that's a separate market-data subscription matter." },
    { type: "heading", text: "4. Report the Session to Tradovate Support" },
    { type: "paragraph", html: "This is the step that gets it fixed for real. Contact Tradovate support and hand them two specifics: the <strong class='text-white'>date and time</strong> of the replay session, and the <strong class='text-white'>product</strong> you were replaying. Those details let their team reproduce your exact session and escalate it to the developers who own the replay stream. Vague &ldquo;replay is broken&rdquo; reports stall; a dated, product-specific report is what moves. Once it's escalated, resolution generally comes with a platform update rather than anything you do locally, so after you've reported it, lean on live sim and check back after the next release." },
    { type: "heading", text: "Quick Reference" },
    {
      type: "table",
      headers: ["What you see", "What it means", "What to do"],
      rows: [
        ["Only last price, empty bid/ask, chart still moving", "Replay stream dropped its quote layer", "Restart once; if still empty, switch to live sim and report it"],
        ["Orders error out instead of filling", "No bid/ask for the fill to match against", "Same root cause as the empty book; don't keep retrying orders"],
        ["Replay won't start at all", "Often a lapsed add-on or subscription", "Check Application Settings &gt; Add-Ons &gt; Market Replay"],
        ["Replay runs a few seconds then stalls", "Same family of replay-stream defects", "Report with date/time and product; use live sim meanwhile"],
        ["Broken identically on web, desktop, and mobile", "Server-side outage, not your machine", "Wait for the fix; no local change will help"],
      ],
    },
    { type: "paragraph", html: "One note on subscriptions and trials: replay add-on terms, trial length, and any prop-firm access rules change over time and vary by firm and account type, so confirm your current terms in the platform rather than assuming. The behavior above is about the data breakage, which is independent of what plan you're on." },
    { type: "heading", text: "Keep Testing While Replay Is Down" },
    { type: "paragraph", html: "Market Replay is a great rehearsal tool, but it's a fragile one, and when the stream drops its quotes there's nothing on your end to fix. If your real goal is validating how a strategy behaves before it goes live, you don't want that blocked by a broken replay feed. That's where routing your signals through automation keeps you moving." },
    { type: "paragraph", html: "PickMyTrade takes your TradingView alerts and fires them straight into your Tradovate account, so you can forward-test the exact logic you plan to trade against real, live market data, on a simulated account, without depending on replay at all." },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Forward-test on live data:</strong> run your alerts into a Tradovate sim account with a real bid/ask, so a broken replay stream never stops your validation.",
        "<strong class='text-white'>Server-side execution:</strong> orders route from the alert to your account directly, not through a chart you have to babysit.",
        "<strong class='text-white'>Multi-account sync:</strong> mirror the same test across connected accounts to compare behavior side by side.",
        "<strong class='text-white'>Alert logging:</strong> every signal is recorded, so you can review exactly what your strategy did and when.",
      ],
    },
  ], de: [
    { type: "paragraph",html: "Sie laden Market Replay, um eine Sitzung zu üben, drücken Play, und die Uhr läuft wie vorgesehen durch den Handelstag. Aber die Ladder ist tot. Jeder Kontrakt zeigt nur den zuletzt gehandelten Preis, die Bid- und Ask-Spalten sind leer, und sobald Sie kaufen oder verkaufen wollen, bricht die Order mit einem Fehler ab, statt ausgeführt zu werden. Nichts, was Sie anklicken, bringt die Kurse zurück. Wenn Sie genau das vor sich sehen, haben Sie nichts falsch konfiguriert. Es handelt sich um einen Datenzustellungsfehler im Replay-Stream von Tradovate, der über mehrere Plattformversionen hinweg wieder aufgetreten ist und sich nicht von Ihrer Seite per Einstellung beheben lässt. Was Sie tun können: bestätigen, dass es das bekannte Problem ist, sich in der Zwischenzeit eine funktionierende Übungsumgebung einrichten und die Sitzung melden, damit der Fehler behoben wird. Hier das ganze Bild." },
    {
      type: "checklist",
      heading: "Was Sie jetzt tun sollten",
      items: [
        "<strong class='text-white'>Replay-Sitzung neu starten und die App neu laden:</strong> gelegentlich verbindet sich der Stream mit intaktem Bid/Ask wieder.",
        "<strong class='text-white'>Datum, Uhrzeit und Produkt neu auswählen:</strong> starten Sie eine frische Sitzung, statt die defekte fortzusetzen.",
        "<strong class='text-white'>Prüfen, ob das Market-Replay-Add-on noch aktiv ist:</strong> kontrollieren Sie es unter Application Settings, um ein abgelaufenes Abonnement auszuschließen.",
        "<strong class='text-white'>Zu Live-Simulated-Trading wechseln:</strong> ein Sim-Konto am Echtzeit-Feed liefert ein funktionierendes Bid/Ask, sodass Sie weiter üben können.",
        "<strong class='text-white'>Mit Datum, Uhrzeit und Produkt melden:</strong> nur so kann Tradovate den Fehler reproduzieren und eskalieren.",
      ],
    },
    { type: "heading",text: "Wie „nur der letzte Preis“ tatsächlich aussieht" },
    { type: "paragraph",html: "Läuft Replay einwandfrei, sehen Sie das komplette Orderbuch im Schnelldurchlauf: eine Bid-Ladder und eine Ask-Ladder, die sich Tick für Tick bewegen, Volumen, das auf jedem Level gedruckt wird, und simulierte Ausführungen, die sich so verhalten wie die echte Sitzung. Genau das ist der Sinn von Replay, und deshalb bewirbt das Add-on die volle Markttiefe für die Volumenanalyse." },
    { type: "paragraph",html: "Tritt dieser Fehler auf, ist die Tiefe weg. Der Chart schreitet weiter voran, die Zeit läuft also eindeutig, aber das DOM zeigt pro Kontrakt nur eine einzige Zahl: den letzten Print. Kein Inside-Bid. Kein Inside-Ask. Keine Ladder. Bei jedem geladenen Symbol ist es dasselbe, was für sich schon ein Hinweis ist. Dann kommt die zweite Hälfte des Problems: Sie versuchen, eine Order in diese leere Ladder zu legen, und sie wird nicht ausgeführt, sondern löst einen Fehler aus. Ein Kauf, der das Ask hätte aufnehmen sollen, findet kein Ask, und die Replay-Engine lehnt ihn ab." },
    { type: "paragraph",html: "Auch ist das kein brandneuer Fehler. Dieselbe Symptomfamilie taucht immer wieder unter anderen Bezeichnungen auf: Bid/Ask, die mitten in der Sitzung einfrieren, Replay, das fünf oder zehn Sekunden läuft und dann stehen bleibt, Replay, das im Web-Client gar nicht erst startet, und genau dieser Zustand mit nur dem letzten Preis. Andere Verpackung, dasselbe Grundproblem: Der Replay-Datenstrom liefert keine Kurse." },
    { type: "heading",text: "Warum Replay auf diese Weise ausfällt" },
    { type: "paragraph",html: "Market Replay streamt eine aufgezeichnete historische Sitzung direkt von den Servern von Tradovate, samt Kursen und Markttiefe, und spielt sie in ein simuliertes Konto ein, sodass Ihre Orders gegen das ausgeführt werden, was das Orderbuch tatsächlich getan hat. Sie laden keine Datei herunter und führen keine lokale Simulation aus. Jedes Bid, jedes Ask und jeder Print, den Sie sehen, wird in der richtigen Reihenfolge vom Server gesendet." },
    { type: "paragraph",html: "Genau dieses Design erklärt, warum der Fehler so aussieht. Wenn der Stream die Kursebene verliert und nur noch Last-Trade-Prints sendet, stellt Ihr Client getreu dar, was er empfängt: einen laufenden Chart mit leerem Orderbuch. Es gibt keinen lokalen Cache der fehlenden Kurse, auf den man zurückgreifen könnte, und keinen Schalter, der sie neu aufbaut, denn sie wurden nie geliefert. Deshalb ändern Aktualisieren, erneutes Hinzufügen des DOM oder Herumspielen an den Chart-Einstellungen nichts." },
    { type: "paragraph",html: "Die Order-Fehler folgen direkt aus derselben Lücke. Eine simulierte Ausführung im Replay braucht einen Gegenpreis: etwas auf dem Bid für Ihren Verkauf, etwas auf dem Ask für Ihren Kauf. Entfernt man Bid und Ask, hat eine marktfähige Order keinen Referenzpreis, gegen den sie ausgeführt werden könnte, und statt einer Ausführung kommt eine Ablehnung zurück. Deshalb treten fehlende Kurse und fehlgeschlagene Orders bei dieser Störung immer gemeinsam auf. Es ist ein Fehler, nicht zwei." },
    { type: "paragraph",html: "Da der Fehler auf der Zustellungsseite liegt, trifft er in der Regel alle Nutzer der betroffenen Version gleichzeitig und verschwindet erst, wenn Tradovate einen Fix ausliefert. Das ist ärgerlich, bedeutet aber auch, dass Sie in Ihren eigenen Einstellungen nicht mehr nach einer Ursache suchen müssen, die dort nicht existiert." },
    { type: "heading",text: "So kommen Sie weiter: Schritt für Schritt" },
    { type: "paragraph",html: "Arbeiten Sie diese Schritte der Reihe nach ab. Der erste Schritt behebt gelegentlich einen einmaligen Verbindungsaussetzer; die späteren Schritte sorgen dafür, dass Sie weiter üben können und der eigentliche Fehler dokumentiert wird." },
    { type: "heading",text: "1. Sitzung neu starten und die Plattform neu laden" },
    {
      type: "steps",
      items: [
        { title: "Aktuelle Sitzung beenden", html: "Beenden Sie die aktuelle Replay-Sitzung, statt sie im defekten Zustand weiterlaufen zu lassen." },
        { title: "Plattform vollständig neu laden", html: "Laden Sie die Plattform vollständig neu: Drücken Sie im Web-Client <strong class='text-white'>F5</strong> oder schließen und öffnen Sie die Desktop-App erneut." },
        { title: "Eine völlig neue Sitzung starten", html: "Starten Sie eine völlig neue Replay-Sitzung und wählen Sie <strong class='text-white'>Startdatum und Uhrzeit</strong>, die <strong class='text-white'>Replay-Geschwindigkeit</strong>, Ihr <strong class='text-white'>Anfangsguthaben</strong> und das <strong class='text-white'>Konto</strong> erneut aus, und starten Sie sie dann noch einmal." },
        { title: "Zuerst mit einem einzelnen Produkt testen", html: "Laden Sie zuerst ein einzelnes gängiges Produkt (etwa ES oder NQ) und prüfen Sie, ob sich die Bid/Ask-Ladder füllt, bevor Sie einen kompletten Arbeitsbereich aufbauen." },
      ],
    },
    { type: "paragraph",html: "Füllt sich die Ladder und werden Orders ausgeführt, hatten Sie einen vorübergehenden Verbindungsfehler und können weiterarbeiten. Kommt sie in einer frischen Sitzung leer zurück, ist der Stream tatsächlich ausgefallen, und kein Neustart bringt die Kurse zurück. Machen Sie weiter, statt Zeit mit wiederholtem Neuladen zu verlieren." },
    { type: "heading",text: "2. Prüfen, ob das Market-Replay-Add-on noch aktiv ist" },
    { type: "paragraph",html: "Bevor Sie von einem Ausfall ausgehen, schließen Sie ein abgelaufenes Abonnement aus, denn auch ein abgelaufenes Replay-Add-on kann Sie aussperren. Öffnen Sie <strong class='text-white'>Application Settings</strong>, gehen Sie zum Tab <strong class='text-white'>Add-Ons</strong> und suchen Sie das Panel <strong class='text-white'>Market Replay</strong>. Prüfen Sie, ob es als aktiv angezeigt wird (oder ob Ihre Testphase nicht abgelaufen ist). Beachten Sie aber den Unterschied im Symptom: Ein abgelaufenes Add-on verhindert meist, dass Replay überhaupt startet, während dieser Fehler Replay starten und laufen lässt, jedoch ohne Orderbuch. Ist Ihr Add-on aktiv und Sie sehen trotzdem nur den letzten Preis, haben Sie bestätigt, dass es der Fehler ist und kein Abrechnungsproblem." },
    { type: "heading",text: "3. Zu Live-Simulated-Trading wechseln, um weiter zu üben" },
    { type: "paragraph",html: "Das ist der Workaround, mit dem Sie tatsächlich produktiv bleiben. Das kostenlose Simulated-Trading-Konto von Tradovate handelt den Live-Echtzeit-Feed mit virtuellem Geld und hat daher ein echtes, sich bewegendes Bid und Ask. Wechseln Sie Ihr aktives Konto zum simulierten Konto und platzieren Sie dort Orders. Sie können keinen bestimmten historischen Moment zurückspulen und gezielt üben, erhalten aber eine voll funktionsfähige Ausführungs-Sandbox: echte Kurse, echte Ausführungen, keine Last-Price-Only-Wand." },
    { type: "paragraph",html: "Für den Großteil der täglichen Übung (Ordereingabe, Bracket-Platzierung, Stop-Management, schnelle Klicks) deckt Live-Sim Sie vollständig ab, solange Replay defekt ist. Heben Sie sich die Arbeit mit historischen Sitzungen für die Zeit nach dem Fix auf. Wirken Ihre Live-Sim-Daten selbst verzögert oder erscheint der Symbolname orange, ist das eine separate Angelegenheit des Marktdaten-Abonnements." },
    { type: "heading",text: "4. Die Sitzung dem Tradovate-Support melden" },
    { type: "paragraph",html: "Dieser Schritt sorgt dafür, dass der Fehler wirklich behoben wird. Kontaktieren Sie den Tradovate-Support und nennen Sie zwei konkrete Angaben: <strong class='text-white'>Datum und Uhrzeit</strong> der Replay-Sitzung und das <strong class='text-white'>Produkt</strong>, das Sie abgespielt haben. Mit diesen Angaben kann das Team Ihre genaue Sitzung reproduzieren und an die Entwickler eskalieren, die den Replay-Stream betreuen. Vage Meldungen wie &ldquo;Replay ist kaputt&rdquo; versanden; eine Meldung mit Datum und Produkt bringt etwas in Bewegung. Nach der Eskalation kommt die Lösung in der Regel mit einem Plattform-Update und nicht durch etwas, das Sie lokal tun. Verlassen Sie sich nach Ihrer Meldung also auf Live-Sim und schauen Sie nach dem nächsten Release wieder nach." },
    { type: "heading",text: "Kurzübersicht" },
    { type: "table", headers: ["Was Sie sehen","Was es bedeutet","Was zu tun ist"], rows: [
      ["Nur letzter Preis, leeres Bid/Ask, Chart läuft weiter","Replay-Stream hat seine Kursebene verloren","Einmal neu starten; bleibt es leer, zu Live-Sim wechseln und melden"],
      ["Orders brechen mit Fehler ab, statt ausgeführt zu werden","Kein Bid/Ask, gegen das die Ausführung gematcht werden könnte","Gleiche Ursache wie das leere Orderbuch; Orders nicht ständig wiederholen"],
      ["Replay startet gar nicht","Oft ein abgelaufenes Add-on oder Abonnement","Application Settings &gt; Add-Ons &gt; Market Replay prüfen"],
      ["Replay läuft einige Sekunden und bleibt dann stehen","Dieselbe Familie von Replay-Stream-Fehlern","Mit Datum/Uhrzeit und Produkt melden; in der Zwischenzeit Live-Sim nutzen"],
      ["Identisch defekt im Web, Desktop und Mobile","Serverseitiger Ausfall, nicht Ihr Rechner","Auf den Fix warten; keine lokale Änderung hilft"],
    ] },
    { type: "paragraph",html: "Ein Hinweis zu Abonnements und Testphasen: Konditionen des Replay-Add-ons, Länge der Testphase und Zugangsregeln von Prop-Firmen ändern sich im Laufe der Zeit und variieren je nach Firma und Kontotyp. Prüfen Sie Ihre aktuellen Konditionen daher in der Plattform, statt sie vorauszusetzen. Das oben beschriebene Verhalten betrifft den Datenfehler, der unabhängig von Ihrem Tarif auftritt." },
    { type: "heading",text: "Weiter testen, während Replay ausgefallen ist" },
    { type: "paragraph",html: "Market Replay ist ein hervorragendes Übungswerkzeug, aber ein empfindliches, und wenn der Stream seine Kurse verliert, können Sie auf Ihrer Seite nichts beheben. Wenn Ihr eigentliches Ziel darin besteht, das Verhalten einer Strategie vor dem Live-Gang zu validieren, soll das nicht von einem defekten Replay-Feed blockiert werden. Hier hilft es, Ihre Signale über eine Automatisierung zu leiten, damit Sie handlungsfähig bleiben." },
    { type: "paragraph",html: "PickMyTrade nimmt Ihre TradingView-Alerts und sendet sie direkt an Ihr Tradovate-Konto, sodass Sie genau die Logik, die Sie handeln möchten, gegen echte Live-Marktdaten auf einem simulierten Konto forward-testen können, ganz ohne Abhängigkeit von Replay." },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Forward-Test mit Live-Daten:</strong> leiten Sie Ihre Alerts in ein Tradovate-Sim-Konto mit echtem Bid/Ask, sodass ein defekter Replay-Stream Ihre Validierung nie stoppt.",
        "<strong class='text-white'>Serverseitige Ausführung:</strong> Orders werden direkt vom Alert an Ihr Konto geleitet, nicht über einen Chart, den Sie beaufsichtigen müssen.",
        "<strong class='text-white'>Multi-Account-Synchronisierung:</strong> spiegeln Sie denselben Test auf verbundene Konten, um das Verhalten nebeneinander zu vergleichen.",
        "<strong class='text-white'>Alert-Protokollierung:</strong> jedes Signal wird aufgezeichnet, sodass Sie genau nachvollziehen können, was Ihre Strategie wann getan hat.",
      ],
    },
  ], es: [
    { type: "paragraph",html: "Usted carga Market Replay para ensayar una sesión, pulsa play y el reloj empieza a recorrer el día como debe. Pero la escalera está muerta. Cada contrato muestra solo el último precio negociado, las columnas de bid y ask están en blanco y, en cuanto intenta comprar o vender, la orden da error en lugar de ejecutarse. Nada de lo que pulse devuelve las cotizaciones. Si es lo que está viendo, usted no ha configurado nada mal. Se trata de una avería de entrega de datos en el flujo de replay de Tradovate, que se ha repetido en varias versiones de la plataforma y que no se arregla desde su lado con un ajuste. Lo que sí puede hacer es confirmar que es el problema conocido, conseguir mientras tanto un entorno de práctica que funcione e informar de la sesión para que se corrija. Aquí tiene el panorama completo." },
    {
      type: "checklist",
      heading: "Qué hacer ahora mismo",
      items: [
        "<strong class='text-white'>Reinicie la sesión de replay y recargue la aplicación:</strong> de vez en cuando el flujo se reconecta con el bid/ask intacto.",
        "<strong class='text-white'>Vuelva a elegir la fecha, la hora y el producto:</strong> inicie una sesión nueva en lugar de reanudar la averiada.",
        "<strong class='text-white'>Confirme que el complemento Market Replay sigue activo:</strong> compruébelo en Application Settings para descartar una suscripción vencida.",
        "<strong class='text-white'>Cambie a Simulated Trading en vivo:</strong> una cuenta sim con el feed en tiempo real le da un bid/ask que funciona para que pueda seguir practicando.",
        "<strong class='text-white'>Infórmelo con la fecha, la hora y el producto:</strong> eso es lo que permite a Tradovate reproducir y escalar el defecto.",
      ],
    },
    { type: "heading",text: "Cómo se ve realmente &ldquo;solo el último precio&rdquo;" },
    { type: "paragraph",html: "Cuando replay funciona bien, obtiene el libro de órdenes completo reproducido en avance rápido: una escalera de bid y otra de ask moviéndose tick a tick, volumen imprimiéndose en cada nivel y ejecuciones simuladas que se comportan como lo hizo la sesión real. Ese es todo el sentido de replay, y por eso el complemento anuncia la profundidad de mercado completa para el análisis de volumen." },
    { type: "paragraph",html: "Cuando aparece este error, la profundidad desaparece. El gráfico sigue avanzando, así que el tiempo claramente corre, pero el DOM solo muestra un número por contrato: el último print. Sin bid inside. Sin ask inside. Sin escalera. Es igual en cada símbolo que cargue, lo cual ya es una pista en sí mismo. Entonces aparece la segunda mitad del problema: intenta colocar una orden en esa escalera vacía y no se ejecuta, sino que lanza un error. Una compra que debía tomar el ask no tiene ask que tomar, y el motor de replay la rechaza." },
    { type: "paragraph",html: "Tampoco es un fallo nuevo. La misma familia de síntomas reaparece con distintas etiquetas: bid/ask que se congela a mitad de sesión, replay que corre cinco o diez segundos y luego se detiene, replay que simplemente no arranca en el cliente web y este estado exacto de solo último precio. Distintas envolturas, el mismo problema de fondo: el flujo de datos de replay no entrega cotizaciones." },
    { type: "heading",text: "Por qué replay se rompe de esta manera" },
    { type: "paragraph",html: "Market Replay funciona transmitiendo una sesión histórica grabada directamente desde los servidores de Tradovate, con cotizaciones y profundidad incluidas, y reproduciéndola en una cuenta simulada para que sus órdenes se ejecuten contra lo que el libro realmente hizo. No descarga un archivo ni ejecuta una simulación local. Cada bid, ask y print que ve se envía desde el servidor en la secuencia correcta." },
    { type: "paragraph",html: "Ese diseño es precisamente la razón por la que el fallo tiene este aspecto. Cuando el flujo pierde su capa de cotizaciones y solo envía prints del último precio, su cliente representa fielmente lo que recibe: un gráfico en movimiento con un libro vacío. No hay una caché local de las cotizaciones ausentes a la que recurrir ni ningún interruptor que las reconstruya, porque nunca se entregaron. Por eso refrescar, volver a añadir el DOM o toquetear los ajustes del gráfico no cambia nada." },
    { type: "paragraph",html: "Los errores de orden se derivan directamente de la misma carencia. Una ejecución simulada en replay necesita un precio contrario: algo en el bid para su venta, algo en el ask para su compra. Si se eliminan el bid y el ask, una orden ejecutable no tiene un precio de referencia contra el cual ejecutarse, así que en lugar de ejecutarse devuelve un rechazo. Por eso las cotizaciones ausentes y las órdenes fallidas siempre van juntas durante esta avería. Es un solo defecto, no dos." },
    { type: "paragraph",html: "Como la avería está en el lado de la entrega, tiende a afectar a todos los usuarios de la versión afectada a la vez y solo desaparece cuando Tradovate publica una corrección. Es frustrante, pero también significa que puede dejar de buscar en sus propios ajustes una causa que no está ahí." },
    { type: "heading",text: "Cómo salir del bloqueo: paso a paso" },
    { type: "paragraph",html: "Siga estos pasos en orden. El primero soluciona de vez en cuando un fallo puntual de conexión; los siguientes sirven para que pueda seguir practicando y para dejar constancia del defecto real." },
    { type: "heading",text: "1. Reinicie la sesión y recargue la plataforma" },
    {
      type: "steps",
      items: [
        { title: "Detenga la sesión actual", html: "Detenga la sesión de replay actual en lugar de dejarla correr en estado averiado." },
        { title: "Recargue la plataforma por completo", html: "Recargue la plataforma por completo: pulse <strong class='text-white'>F5</strong> en el cliente web, o cierre y vuelva a abrir la aplicación de escritorio." },
        { title: "Inicie una sesión completamente nueva", html: "Inicie una sesión de replay completamente nueva y vuelva a seleccionar la <strong class='text-white'>fecha y hora de inicio</strong>, la <strong class='text-white'>velocidad de replay</strong>, su <strong class='text-white'>saldo inicial</strong> y la <strong class='text-white'>cuenta</strong>; luego iníciela de nuevo." },
        { title: "Pruebe primero con un solo producto", html: "Cargue primero un único producto habitual (como ES o NQ) y observe si la escalera de bid/ask se llena antes de montar un espacio de trabajo completo." },
      ],
    },
    { type: "paragraph",html: "Si la escalera se llena y las órdenes se ejecutan, fue una reconexión transitoria y ya puede seguir. Si vuelve vacía en una sesión nueva, el flujo está realmente caído y ningún reinicio hará aparecer las cotizaciones. Siga adelante en lugar de perder tiempo con recargas repetidas." },
    { type: "heading",text: "2. Confirme que el complemento Market Replay sigue activo" },
    { type: "paragraph",html: "Antes de dar por hecho que es una caída, descarte una suscripción vencida, porque un complemento de replay caducado también puede dejarle fuera. Abra <strong class='text-white'>Application Settings</strong>, vaya a la pestaña <strong class='text-white'>Add-Ons</strong> y localice el panel <strong class='text-white'>Market Replay</strong>. Compruebe que figura como activo (o que su prueba no ha terminado). Fíjese, no obstante, en la diferencia de síntoma: un complemento vencido suele impedir que replay arranque, mientras que este error deja que replay arranque y corra, pero con el libro eliminado. Si su complemento está activo y aun así solo ve el último precio, ha confirmado que es el defecto y no un problema de facturación." },
    { type: "heading",text: "3. Cambie a Simulated Trading en vivo para poder seguir practicando" },
    { type: "paragraph",html: "Esta es la solución alternativa que de verdad le mantiene productivo. La cuenta gratuita de simulated trading de Tradovate opera con el feed en tiempo real usando dinero virtual, por lo que tiene un bid y un ask reales y en movimiento. Cambie su cuenta activa a la simulada y coloque allí las órdenes. Pierde la posibilidad de rebobinar y practicar un momento histórico concreto, pero obtiene un entorno de ejecución plenamente funcional: cotizaciones reales, ejecuciones reales, sin el muro de solo último precio." },
    { type: "paragraph",html: "Para la mayor parte del ensayo diario (entrada de órdenes, colocación de brackets, gestión de stops, ganar rapidez con los clics), el sim en vivo le cubre por completo mientras replay está averiado. Deje el trabajo con sesiones históricas para cuando llegue la corrección. Si los datos de su sim en vivo parecen retrasados o el nombre del símbolo aparece en naranja, es un asunto distinto de la suscripción de datos de mercado." },
    { type: "heading",text: "4. Informe de la sesión al soporte de Tradovate" },
    { type: "paragraph",html: "Este es el paso que consigue que se arregle de verdad. Contacte con el soporte de Tradovate y facilite dos datos concretos: la <strong class='text-white'>fecha y hora</strong> de la sesión de replay y el <strong class='text-white'>producto</strong> que estaba reproduciendo. Esos detalles permiten a su equipo reproducir su sesión exacta y escalarla a los desarrolladores responsables del flujo de replay. Los informes vagos del tipo &ldquo;replay no funciona&rdquo; se estancan; un informe con fecha y producto es lo que mueve las cosas. Una vez escalado, la resolución suele llegar con una actualización de la plataforma y no con algo que usted haga localmente, así que después de informarlo, apóyese en el sim en vivo y vuelva a comprobarlo tras la siguiente versión." },
    { type: "heading",text: "Referencia rápida" },
    { type: "table", headers: ["Lo que ve","Lo que significa","Qué hacer"], rows: [
      ["Solo último precio, bid/ask vacíos, el gráfico sigue moviéndose","El flujo de replay perdió su capa de cotizaciones","Reinicie una vez; si sigue vacío, cambie al sim en vivo e infórmelo"],
      ["Las órdenes dan error en lugar de ejecutarse","No hay bid/ask contra el que cruzar la ejecución","Misma causa raíz que el libro vacío; no siga reintentando órdenes"],
      ["Replay no arranca en absoluto","A menudo un complemento o suscripción vencidos","Revise Application Settings &gt; Add-Ons &gt; Market Replay"],
      ["Replay corre unos segundos y luego se detiene","Misma familia de defectos del flujo de replay","Infórmelo con fecha/hora y producto; use el sim en vivo mientras tanto"],
      ["Falla igual en web, escritorio y móvil","Caída del lado del servidor, no de su equipo","Espere la corrección; ningún cambio local ayudará"],
    ] },
    { type: "paragraph",html: "Una nota sobre suscripciones y pruebas: las condiciones del complemento de replay, la duración de la prueba y cualquier regla de acceso de las prop firms cambian con el tiempo y varían según la firma y el tipo de cuenta, así que confirme sus condiciones actuales en la plataforma en lugar de darlas por supuestas. El comportamiento descrito se refiere a la avería de datos, que es independiente del plan que tenga." },
    { type: "heading",text: "Siga probando mientras Replay no funciona" },
    { type: "paragraph",html: "Market Replay es una gran herramienta de ensayo, pero frágil, y cuando el flujo pierde sus cotizaciones no hay nada que usted pueda arreglar. Si su objetivo real es validar cómo se comporta una estrategia antes de pasar a real, no querrá que un feed de replay averiado se lo impida. Ahí es donde enrutar sus señales mediante automatización le mantiene en marcha." },
    { type: "paragraph",html: "PickMyTrade toma sus alertas de TradingView y las envía directamente a su cuenta de Tradovate, de modo que puede hacer forward-testing de la lógica exacta que piensa operar contra datos de mercado reales y en vivo, en una cuenta simulada, sin depender en absoluto de replay." },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Forward-testing con datos en vivo:</strong> envíe sus alertas a una cuenta sim de Tradovate con bid/ask real, de modo que un flujo de replay averiado nunca detenga su validación.",
        "<strong class='text-white'>Ejecución en el servidor:</strong> las órdenes se enrutan desde la alerta directamente a su cuenta, no a través de un gráfico que tenga que vigilar.",
        "<strong class='text-white'>Sincronización multicuenta:</strong> replique la misma prueba en las cuentas conectadas para comparar el comportamiento lado a lado.",
        "<strong class='text-white'>Registro de alertas:</strong> cada señal queda registrada, de modo que puede revisar exactamente qué hizo su estrategia y cuándo.",
      ],
    },
  ], fr: [
    { type: "paragraph",html: "Vous chargez Market Replay pour répéter une séance, vous lancez la lecture, et l'horloge se met à parcourir la journée comme prévu. Mais l'échelle est morte. Chaque contrat n'affiche que le dernier prix échangé, les colonnes bid et ask sont vides, et dès que vous tentez d'acheter ou de vendre, l'ordre renvoie une erreur au lieu d'être exécuté. Rien de ce que vous cliquez ne ramène les cotations. Si c'est ce que vous avez sous les yeux, vous n'avez rien mal configuré. Il s'agit d'une panne de livraison des données dans le flux de replay de Tradovate, qui s'est reproduite sur plusieurs versions de la plateforme et ne se corrige pas de votre côté par un réglage. Ce que vous pouvez faire : confirmer qu'il s'agit du problème connu, vous procurer entre-temps un environnement d'entraînement fonctionnel, et signaler la séance pour qu'elle soit corrigée. Voici le tableau complet." },
    {
      type: "checklist",
      heading: "Que faire tout de suite",
      items: [
        "<strong class='text-white'>Redémarrez la session de replay et rechargez l'application :</strong> il arrive que le flux se reconnecte avec le bid/ask intact.",
        "<strong class='text-white'>Sélectionnez à nouveau la date, l'heure et le produit :</strong> démarrez une session neuve plutôt que de reprendre celle qui est défaillante.",
        "<strong class='text-white'>Vérifiez que le module Market Replay est toujours actif :</strong> contrôlez-le dans Application Settings pour écarter un abonnement échu.",
        "<strong class='text-white'>Passez au Simulated Trading en direct :</strong> un compte sim sur le flux temps réel vous donne un bid/ask fonctionnel pour continuer à vous entraîner.",
        "<strong class='text-white'>Signalez-le avec la date, l'heure et le produit :</strong> c'est ce qui permet à Tradovate de reproduire et de faire remonter le défaut.",
      ],
    },
    { type: "heading",text: "À quoi ressemble réellement « seulement le dernier prix »" },
    { type: "paragraph",html: "Lorsque le replay est sain, vous obtenez le carnet d'ordres complet rejoué en accéléré : une échelle de bid et une échelle d'ask qui bougent tick par tick, du volume qui s'imprime à chaque niveau, et des exécutions simulées qui se comportent comme la séance réelle. C'est tout l'intérêt du replay, et c'est pourquoi le module annonce la profondeur de marché complète pour l'analyse du volume." },
    { type: "paragraph",html: "Lorsque ce bug survient, la profondeur disparaît. Le graphique progresse toujours, le temps avance donc clairement, mais le DOM n'affiche qu'un seul chiffre par contrat : le dernier print. Pas de bid inside. Pas d'ask inside. Pas d'échelle. C'est la même chose sur chaque symbole chargé, ce qui est déjà un indice en soi. Puis la seconde moitié du problème apparaît : vous tentez de passer un ordre dans cette échelle vide et il n'est pas exécuté, il renvoie une erreur. Un achat censé prendre l'ask n'a pas d'ask à prendre, et le moteur de replay le rejette." },
    { type: "paragraph",html: "Ce n'est pas non plus un incident inédit. La même famille de symptômes refait surface sous différentes appellations : bid/ask qui se fige en milieu de séance, replay qui tourne cinq ou dix secondes puis se bloque, replay qui ne démarre tout simplement pas sur le client web, et cet état précis du dernier prix seul. Emballages différents, même problème de fond : le flux de données du replay ne délivre pas de cotations." },
    { type: "heading",text: "Pourquoi le replay se casse de cette façon" },
    { type: "paragraph",html: "Market Replay fonctionne en diffusant une séance historique enregistrée directement depuis les serveurs de Tradovate, cotations et profondeur comprises, et en la rejouant dans un compte simulé afin que vos ordres soient exécutés contre ce que le carnet a réellement fait. Vous ne téléchargez pas de fichier et n'exécutez pas de simulation locale. Chaque bid, ask et print que vous voyez est poussé depuis le serveur dans le bon ordre." },
    { type: "paragraph",html: "Cette conception explique précisément l'aspect de la panne. Lorsque le flux perd sa couche de cotations et n'envoie plus que des prints de dernier prix, votre client affiche fidèlement ce qu'il reçoit : un graphique en mouvement avec un carnet vide. Il n'existe aucun cache local des cotations manquantes sur lequel s'appuyer, ni bouton qui les reconstruise, car elles n'ont jamais été livrées. C'est pourquoi actualiser, rajouter le DOM ou bricoler les réglages du graphique ne change rien." },
    { type: "paragraph",html: "Les erreurs d'ordre découlent directement de la même lacune. Une exécution simulée dans le replay a besoin d'un prix de contrepartie : quelque chose au bid pour votre vente, quelque chose à l'ask pour votre achat. Retirez le bid et l'ask, et un ordre exécutable n'a aucun prix de référence contre lequel s'exécuter ; au lieu d'être exécuté, il renvoie un rejet. C'est pourquoi les cotations manquantes et les ordres en échec vont toujours de pair pendant cette panne. C'est un seul défaut, pas deux." },
    { type: "paragraph",html: "Comme la panne se situe côté livraison, elle touche en général tous les utilisateurs de la version concernée en même temps et ne disparaît que lorsque Tradovate publie un correctif. C'est frustrant, mais cela signifie aussi que vous pouvez cesser de fouiller vos propres réglages à la recherche d'une cause qui n'y est pas." },
    { type: "heading",text: "Comment vous débloquer : pas à pas" },
    { type: "paragraph",html: "Suivez ces étapes dans l'ordre. La première règle parfois un simple incident de connexion ; les suivantes servent à maintenir votre entraînement et à faire enregistrer le véritable défaut." },
    { type: "heading",text: "1. Redémarrer la session et recharger la plateforme" },
    {
      type: "steps",
      items: [
        { title: "Arrêter la session en cours", html: "Arrêtez la session de replay en cours plutôt que de la laisser tourner dans cet état défaillant." },
        { title: "Recharger entièrement la plateforme", html: "Rechargez entièrement la plateforme : appuyez sur <strong class='text-white'>F5</strong> sur le client web, ou fermez puis rouvrez l'application de bureau." },
        { title: "Démarrer une toute nouvelle session", html: "Démarrez une toute nouvelle session de replay et sélectionnez à nouveau la <strong class='text-white'>date et l'heure de début</strong>, la <strong class='text-white'>vitesse de replay</strong>, votre <strong class='text-white'>solde initial</strong> et le <strong class='text-white'>compte</strong>, puis relancez-la." },
        { title: "Tester d'abord avec un seul produit", html: "Chargez d'abord un seul produit courant (par exemple ES ou NQ) et vérifiez si l'échelle bid/ask se remplit avant de construire un espace de travail complet." },
      ],
    },
    { type: "paragraph",html: "Si l'échelle se remplit et que les ordres sont exécutés, il s'agissait d'une reconnexion passagère et vous pouvez reprendre. Si elle revient vide sur une session neuve, le flux est réellement en panne et aucun redémarrage ne fera apparaître les cotations. Passez à la suite plutôt que de perdre du temps en rechargements répétés." },
    { type: "heading",text: "2. Vérifier que le module Market Replay est toujours actif" },
    { type: "paragraph",html: "Avant de conclure à une panne, écartez un abonnement échu, car un module de replay expiré peut aussi vous couper l'accès. Ouvrez <strong class='text-white'>Application Settings</strong>, allez dans l'onglet <strong class='text-white'>Add-Ons</strong> et repérez le panneau <strong class='text-white'>Market Replay</strong>. Vérifiez qu'il apparaît comme actif (ou que votre essai n'est pas terminé). Notez toutefois la différence de symptôme : un module échu empêche généralement le replay de démarrer, alors que ce bug laisse le replay démarrer et tourner mais avec le carnet vidé. Si votre module est actif et que vous n'obtenez toujours que le dernier prix, vous avez confirmé qu'il s'agit du défaut et non d'un problème de facturation." },
    { type: "heading",text: "3. Passer au Simulated Trading en direct pour continuer à vous entraîner" },
    { type: "paragraph",html: "C'est la solution de contournement qui vous garde réellement productif. Le compte gratuit de simulated trading de Tradovate négocie sur le flux temps réel avec de l'argent virtuel ; il dispose donc d'un vrai bid et d'un vrai ask en mouvement. Basculez votre compte actif vers le compte simulé et passez vos ordres là. Vous perdez la possibilité de rembobiner et de travailler un moment historique précis, mais vous obtenez un bac à sable d'exécution pleinement fonctionnel : vraies cotations, vraies exécutions, pas de mur du dernier prix seul." },
    { type: "paragraph",html: "Pour l'essentiel de la répétition quotidienne (saisie d'ordres, pose de brackets, gestion des stops, rapidité des clics), le sim en direct vous couvre entièrement tant que le replay est en panne. Gardez le travail sur séances historiques pour après le correctif. Si les données de votre sim en direct semblent différées ou si le nom du symbole s'affiche en orange, il s'agit d'une question distincte d'abonnement aux données de marché." },
    { type: "heading",text: "4. Signaler la session au support Tradovate" },
    { type: "paragraph",html: "C'est l'étape qui permet réellement de faire corriger le problème. Contactez le support Tradovate et fournissez deux précisions : la <strong class='text-white'>date et l'heure</strong> de la session de replay et le <strong class='text-white'>produit</strong> que vous rejouiez. Ces détails permettent à leur équipe de reproduire votre session exacte et de la faire remonter aux développeurs responsables du flux de replay. Les signalements vagues du type &ldquo;le replay est cassé&rdquo; restent sans suite ; un signalement daté et précisant le produit fait avancer les choses. Une fois escaladé, la résolution arrive généralement avec une mise à jour de la plateforme plutôt que par une action locale ; après votre signalement, appuyez-vous donc sur le sim en direct et revérifiez après la prochaine version." },
    { type: "heading",text: "Référence rapide" },
    { type: "table", headers: ["Ce que vous voyez","Ce que cela signifie","Que faire"], rows: [
      ["Seulement le dernier prix, bid/ask vides, le graphique continue de bouger","Le flux de replay a perdu sa couche de cotations","Redémarrez une fois ; s'il reste vide, passez au sim en direct et signalez-le"],
      ["Les ordres renvoient une erreur au lieu d'être exécutés","Aucun bid/ask contre lequel apparier l'exécution","Même cause racine que le carnet vide ; ne réessayez pas les ordres en boucle"],
      ["Le replay ne démarre pas du tout","Souvent un module ou un abonnement échu","Vérifiez Application Settings &gt; Add-Ons &gt; Market Replay"],
      ["Le replay tourne quelques secondes puis se bloque","Même famille de défauts du flux de replay","Signalez avec date/heure et produit ; utilisez le sim en direct en attendant"],
      ["Défaillance identique sur web, bureau et mobile","Panne côté serveur, pas votre machine","Attendez le correctif ; aucune modification locale n'aidera"],
    ] },
    { type: "paragraph",html: "Une remarque sur les abonnements et les essais : les conditions du module de replay, la durée de l'essai et les éventuelles règles d'accès des prop firms évoluent avec le temps et varient selon la firme et le type de compte ; vérifiez donc vos conditions actuelles dans la plateforme plutôt que de les supposer. Le comportement décrit ci-dessus concerne la panne de données, indépendante de votre formule." },
    { type: "heading",text: "Continuez à tester pendant que le Replay est en panne" },
    { type: "paragraph",html: "Market Replay est un excellent outil de répétition, mais un outil fragile, et lorsque le flux perd ses cotations, il n'y a rien à réparer de votre côté. Si votre véritable objectif est de valider le comportement d'une stratégie avant sa mise en réel, vous ne voulez pas qu'un flux de replay défaillant vous bloque. C'est là que l'acheminement de vos signaux par l'automatisation vous permet d'avancer." },
    { type: "paragraph",html: "PickMyTrade prend vos alertes TradingView et les envoie directement vers votre compte Tradovate, ce qui vous permet de tester en conditions réelles la logique exacte que vous comptez trader sur des données de marché réelles et en direct, sur un compte simulé, sans dépendre du replay." },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Test en conditions réelles sur données live :</strong> faites passer vos alertes vers un compte sim Tradovate avec un vrai bid/ask, de sorte qu'un flux de replay défaillant n'interrompt jamais votre validation.",
        "<strong class='text-white'>Exécution côté serveur :</strong> les ordres sont acheminés de l'alerte directement vers votre compte, et non via un graphique que vous devez surveiller.",
        "<strong class='text-white'>Synchronisation multi-comptes :</strong> reproduisez le même test sur les comptes connectés pour comparer les comportements côte à côte.",
        "<strong class='text-white'>Journalisation des alertes :</strong> chaque signal est enregistré, ce qui vous permet de revoir exactement ce qu'a fait votre stratégie et quand.",
      ],
    },
  ], it: [
    { type: "paragraph",html: "Lei carica Market Replay per esercitarsi su una sessione, preme play e l'orologio inizia a scorrere la giornata come dovrebbe. Ma la ladder è morta. Ogni contratto mostra soltanto l'ultimo prezzo negoziato, le colonne di bid e ask sono vuote e, nel momento in cui prova a comprare o vendere, l'ordine genera un errore invece di essere eseguito. Niente di ciò che clicca riporta le quotazioni. Se è ciò che sta vedendo, non ha configurato nulla in modo errato. Si tratta di un guasto nella consegna dei dati del flusso di replay di Tradovate, ricomparso in diverse versioni della piattaforma, e non si risolve dal suo lato con un'impostazione. Ciò che può fare è confermare che si tratti del problema noto, procurarsi nel frattempo un ambiente di pratica funzionante e segnalare la sessione perché venga corretto. Ecco il quadro completo." },
    {
      type: "checklist",
      heading: "Che cosa fare subito",
      items: [
        "<strong class='text-white'>Riavvii la sessione di replay e ricarichi l'app:</strong> di tanto in tanto il flusso si riconnette con il bid/ask integro.",
        "<strong class='text-white'>Riselezioni data, ora e prodotto:</strong> avvii una sessione nuova invece di riprendere quella guasta.",
        "<strong class='text-white'>Verifichi che il componente Market Replay sia ancora attivo:</strong> lo controlli in Application Settings per escludere un abbonamento scaduto.",
        "<strong class='text-white'>Passi al Simulated Trading live:</strong> un conto sim sul feed in tempo reale le offre un bid/ask funzionante per continuare a esercitarsi.",
        "<strong class='text-white'>Lo segnali con data, ora e prodotto:</strong> è ciò che consente a Tradovate di riprodurre e far escalare il difetto.",
      ],
    },
    { type: "heading",text: "Come appare davvero &ldquo;solo l'ultimo prezzo&rdquo;" },
    { type: "paragraph",html: "Quando il replay funziona, ottiene l'intero order book riprodotto in avanzamento rapido: una ladder di bid e una di ask che si muovono tick dopo tick, volume che si stampa a ogni livello ed esecuzioni simulate che si comportano come la sessione reale. È questo il senso del replay, ed è il motivo per cui il componente pubblicizza la profondità di mercato completa per l'analisi del volume." },
    { type: "paragraph",html: "Quando si manifesta questo bug, la profondità sparisce. Il grafico avanza ancora, quindi il tempo scorre chiaramente, ma il DOM mostra un solo numero per contratto: l'ultimo print. Nessun bid inside. Nessun ask inside. Nessuna ladder. È così su ogni simbolo che carica, il che è già di per sé un indizio. Poi emerge la seconda metà del problema: prova a piazzare un ordine in quella ladder vuota e non viene eseguito, genera un errore. Un acquisto che avrebbe dovuto prendere l'ask non ha alcun ask da prendere, e il motore di replay lo rifiuta." },
    { type: "paragraph",html: "Non è nemmeno un problema nuovo. La stessa famiglia di sintomi continua a riemergere con etichette diverse: bid/ask che si congela a metà sessione, replay che gira per cinque o dieci secondi e poi si blocca, replay che semplicemente non parte sul client web, e questo esatto stato di solo ultimo prezzo. Involucri diversi, stesso problema di fondo: il flusso di dati del replay non consegna quotazioni." },
    { type: "heading",text: "Perché il replay si rompe in questo modo" },
    { type: "paragraph",html: "Market Replay funziona trasmettendo una sessione storica registrata direttamente dai server di Tradovate, quotazioni e profondità incluse, e riproducendola in un conto simulato, in modo che i suoi ordini vengano eseguiti contro ciò che il book ha realmente fatto. Non scarica un file né esegue una simulazione locale. Ogni bid, ask e print che vede viene inviato dal server nella sequenza corretta." },
    { type: "paragraph",html: "Proprio questo design spiega l'aspetto del guasto. Quando il flusso perde il livello delle quotazioni e continua a inviare solo print dell'ultimo prezzo, il suo client mostra fedelmente ciò che riceve: un grafico in movimento con un book vuoto. Non esiste una cache locale delle quotazioni mancanti a cui ripiegare, né un interruttore che le ricostruisca, perché non sono mai state consegnate. Ecco perché aggiornare, riaggiungere il DOM o armeggiare con le impostazioni del grafico non cambia nulla." },
    { type: "paragraph",html: "Gli errori sugli ordini derivano direttamente dalla stessa lacuna. Un'esecuzione simulata nel replay richiede un prezzo di controparte: qualcosa sul bid per la sua vendita, qualcosa sull'ask per il suo acquisto. Eliminando bid e ask, un ordine eseguibile non ha alcun prezzo di riferimento contro cui eseguirsi, quindi invece di un'esecuzione restituisce un rifiuto. Per questo le quotazioni mancanti e gli ordini falliti vanno sempre insieme durante questo guasto. È un unico difetto, non due." },
    { type: "paragraph",html: "Poiché il guasto è lato consegna, tende a colpire contemporaneamente tutti gli utenti della versione interessata e si risolve solo quando Tradovate rilascia una correzione. È frustrante, ma significa anche che può smettere di cercare tra le proprie impostazioni una causa che non c'è." },
    { type: "heading",text: "Come uscire dallo stallo: passo dopo passo" },
    { type: "paragraph",html: "Segua questi passaggi in ordine. Il primo risolve occasionalmente un singolo problema di connessione; i successivi servono a mantenere attiva la sua pratica e a mettere a verbale il vero difetto." },
    { type: "heading",text: "1. Riavviare la sessione e ricaricare la piattaforma" },
    {
      type: "steps",
      items: [
        { title: "Interrompere la sessione corrente", html: "Interrompa la sessione di replay corrente invece di lasciarla girare nello stato guasto." },
        { title: "Ricaricare completamente la piattaforma", html: "Ricarichi completamente la piattaforma: prema <strong class='text-white'>F5</strong> sul client web oppure chiuda e riapra l'app desktop." },
        { title: "Avviare una sessione completamente nuova", html: "Avvii una sessione di replay completamente nuova e riselezioni la <strong class='text-white'>data e ora di inizio</strong>, la <strong class='text-white'>velocità di replay</strong>, il <strong class='text-white'>saldo iniziale</strong> e il <strong class='text-white'>conto</strong>, quindi la avvii di nuovo." },
        { title: "Provare prima con un solo prodotto", html: "Carichi prima un solo prodotto comune (come ES o NQ) e verifichi se la ladder bid/ask si popola prima di costruire un'area di lavoro completa." },
      ],
    },
    { type: "paragraph",html: "Se la ladder si riempie e gli ordini vengono eseguiti, si è trattato di una riconnessione transitoria e può riprendere. Se torna vuota su una sessione nuova, il flusso è davvero inattivo e nessun riavvio farà comparire le quotazioni. Prosegua invece di perdere tempo in ricaricamenti ripetuti." },
    { type: "heading",text: "2. Verificare che il componente Market Replay sia ancora attivo" },
    { type: "paragraph",html: "Prima di ipotizzare un'interruzione, escluda un abbonamento scaduto, perché anche un componente di replay scaduto può tagliarla fuori. Apra <strong class='text-white'>Application Settings</strong>, vada alla scheda <strong class='text-white'>Add-Ons</strong> e individui il pannello <strong class='text-white'>Market Replay</strong>. Verifichi che risulti attivo (o che la prova non sia terminata). Noti però la differenza di sintomo: un componente scaduto di solito impedisce al replay di partire del tutto, mentre questo bug lascia partire e girare il replay ma con il book svuotato. Se il suo componente è attivo e continua a vedere solo l'ultimo prezzo, ha confermato che si tratta del difetto e non di un problema di fatturazione." },
    { type: "heading",text: "3. Passare al Simulated Trading live per continuare a esercitarsi" },
    { type: "paragraph",html: "È la soluzione alternativa che la mantiene davvero produttivo. Il conto gratuito di simulated trading di Tradovate opera sul feed in tempo reale con denaro virtuale, quindi ha un bid e un ask reali e in movimento. Porti il suo conto attivo su quello simulato e piazzi lì gli ordini. Perde la possibilità di riavvolgere ed esercitarsi su uno specifico momento storico, ma ottiene un ambiente di esecuzione pienamente funzionante: quotazioni reali, esecuzioni reali, nessun muro del solo ultimo prezzo." },
    { type: "paragraph",html: "Per la maggior parte delle prove quotidiane (inserimento ordini, posizionamento dei bracket, gestione degli stop, velocità nei clic), il sim live la copre completamente finché il replay è guasto. Lasci il lavoro sulle sessioni storiche a dopo la correzione. Se i dati del suo sim live risultano ritardati o il nome del simbolo appare arancione, si tratta di una questione separata relativa all'abbonamento ai dati di mercato." },
    { type: "heading",text: "4. Segnalare la sessione al supporto Tradovate" },
    { type: "paragraph",html: "È il passaggio che porta davvero alla correzione. Contatti il supporto Tradovate e fornisca due dettagli: la <strong class='text-white'>data e l'ora</strong> della sessione di replay e il <strong class='text-white'>prodotto</strong> che stava riproducendo. Questi dettagli consentono al loro team di riprodurre la sua esatta sessione e di farla escalare agli sviluppatori responsabili del flusso di replay. Le segnalazioni vaghe del tipo &ldquo;il replay è rotto&rdquo; si arenano; una segnalazione con data e prodotto è ciò che fa muovere le cose. Una volta fatta l'escalation, la risoluzione arriva in genere con un aggiornamento della piattaforma e non con qualcosa che lei fa in locale, quindi dopo la segnalazione si affidi al sim live e ricontrolli dopo il prossimo rilascio." },
    { type: "heading",text: "Riferimento rapido" },
    { type: "table", headers: ["Che cosa vede","Che cosa significa","Che cosa fare"], rows: [
      ["Solo ultimo prezzo, bid/ask vuoti, il grafico continua a muoversi","Il flusso di replay ha perso il livello delle quotazioni","Riavvii una volta; se resta vuoto, passi al sim live e lo segnali"],
      ["Gli ordini generano un errore invece di essere eseguiti","Nessun bid/ask con cui abbinare l'esecuzione","Stessa causa del book vuoto; non continui a ritentare gli ordini"],
      ["Il replay non parte affatto","Spesso un componente o un abbonamento scaduto","Controlli Application Settings &gt; Add-Ons &gt; Market Replay"],
      ["Il replay gira per qualche secondo e poi si blocca","Stessa famiglia di difetti del flusso di replay","Segnali con data/ora e prodotto; nel frattempo usi il sim live"],
      ["Guasto identico su web, desktop e mobile","Interruzione lato server, non il suo computer","Attenda la correzione; nessuna modifica locale servirà"],
    ] },
    { type: "paragraph",html: "Una nota su abbonamenti e prove: i termini del componente di replay, la durata della prova e le eventuali regole di accesso delle prop firm cambiano nel tempo e variano in base alla società e al tipo di conto, quindi verifichi i suoi termini attuali nella piattaforma anziché darli per scontati. Il comportamento descritto riguarda il guasto dei dati, che è indipendente dal piano in uso." },
    { type: "heading",text: "Continui a testare mentre il Replay non funziona" },
    { type: "paragraph",html: "Market Replay è un ottimo strumento di prova, ma è fragile, e quando il flusso perde le quotazioni non c'è nulla da sistemare dal suo lato. Se il suo vero obiettivo è validare il comportamento di una strategia prima di passare al live, non vuole che un feed di replay guasto la blocchi. È qui che instradare i segnali tramite automazione la mantiene in movimento." },
    { type: "paragraph",html: "PickMyTrade prende i suoi alert di TradingView e li invia direttamente al suo conto Tradovate, così può fare il forward test della logica esatta che intende tradare su dati di mercato reali e live, su un conto simulato, senza dipendere affatto dal replay." },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Forward test su dati live:</strong> indirizzi i suoi alert a un conto sim Tradovate con bid/ask reali, così un flusso di replay guasto non interrompe mai la sua validazione.",
        "<strong class='text-white'>Esecuzione lato server:</strong> gli ordini vengono instradati dall'alert direttamente al suo conto, non attraverso un grafico da sorvegliare.",
        "<strong class='text-white'>Sincronizzazione multi-conto:</strong> replichi lo stesso test sui conti collegati per confrontare il comportamento fianco a fianco.",
        "<strong class='text-white'>Registro degli alert:</strong> ogni segnale viene registrato, così può rivedere esattamente che cosa ha fatto la sua strategia e quando.",
      ],
    },
  ] },
  ctaHeading: { en: "Forward-Test on Live Data, No Replay Required", de: "Forward-Test mit Live-Daten, ganz ohne Replay", es: "Haga forward-testing con datos en vivo, sin necesidad de Replay", fr: "Testez en conditions réelles avec des données live, sans Replay", it: "Forward test su dati live, senza bisogno del Replay" },
  ctaText: { en: "PickMyTrade fires your TradingView alerts into a Tradovate sim account with a real bid/ask, so a broken replay stream never stops your validation.", de: "PickMyTrade sendet Ihre TradingView-Alerts an ein Tradovate-Sim-Konto mit echtem Bid/Ask, sodass ein defekter Replay-Stream Ihre Validierung nie stoppt.", es: "PickMyTrade envía sus alertas de TradingView a una cuenta sim de Tradovate con bid/ask real, de modo que un flujo de replay averiado nunca detenga su validación.", fr: "PickMyTrade envoie vos alertes TradingView vers un compte sim Tradovate avec un vrai bid/ask, de sorte qu'un flux de replay défaillant n'interrompt jamais votre validation.", it: "PickMyTrade invia i suoi alert di TradingView a un conto sim Tradovate con bid/ask reali, così un flusso di replay guasto non interrompe mai la sua validazione." },
  ctaButtonText: { en: "Start Your Free 7-Day Trial", de: "Starten Sie Ihre kostenlose 7-Tage-Testphase", es: "Comience su prueba gratuita de 7 días", fr: "Commencez votre essai gratuit de 7 jours", it: "Inizi la prova gratuita di 7 giorni" },
  ctaUrl: "https://app.pickmytrade.trade/?register=true&utm_source=content&utm_medium=debugging",
  faqHeading: { en: "Frequently Asked Questions", de: "Häufig gestellte Fragen", es: "Preguntas frecuentes", fr: "Questions fréquentes", it: "Domande frequenti" },
  faqs: { en: [
    { q: "Why does Tradovate Market Replay show only the last price with no bid or ask?", a: "It's a data-delivery defect in the replay stream, not your machine. Replay normally sends full depth of market, but during this breakage the feed delivers only the last-traded price on every contract while the clock keeps advancing. The bid and ask columns stay empty because those quotes never arrive. There's no client-side setting that puts them back." },
    { q: "Why can't I place trades in Market Replay when this happens?", a: "A simulated fill needs a resting bid to sell into or an ask to buy from. With the bid/ask missing, a market or marketable-limit order has nothing to match against, so the replay engine returns an error instead of a fill. The empty quotes and the order rejection are the same problem, not two separate ones." },
    { q: "Did I break Market Replay with a wrong setting?", a: "Almost certainly not. This shows up across the web, desktop, and mobile clients at the same time and has recurred through multiple platform versions. When the same symptom hits everyone at once and no setting changes it, the cause is on Tradovate's side, not in your configuration." },
    { q: "How do I fix Market Replay when it only shows the last price?", a: "There's no reliable client fix because the quotes are missing upstream. Restart the replay session and reload the app first, in case the stream reconnects cleanly. If it comes back empty, switch to live Simulated Trading so you can keep practicing on real-time bid/ask, and report the exact date, time, and product to Tradovate support so they can escalate a patch." },
    { q: "Can I keep practicing while Market Replay is down?", a: "Yes. Switch to a live Simulated Trading account, which trades the live real-time feed with virtual money. Because it uses the live market data feed, you get a working bid and ask and can place orders normally. You lose the ability to rewind a specific historical session, but you keep a full execution sandbox while replay is broken." },
    { q: "Does restarting the app or clearing cache fix the last-price bug?", a: "Sometimes a restart, a re-login, or re-picking the date and product reconnects the replay stream with quotes intact, so it's worth a quick try. But when the defect is server-side, no amount of cache clearing or reinstalling restores the bid/ask, and you'll need to wait for a fix or move to live sim." },
    { q: "Is my Market Replay subscription wasted while it's broken?", a: "No. First confirm the add-on is still active under Application Settings, since an expired trial or lapsed subscription can also stop replay (though that usually blocks it from starting rather than showing last-price-only). If the add-on is active and replay still breaks, report it to support with the session details so they can look into a credit or fix." },
  ], de: [
    { q: "Warum zeigt Tradovate Market Replay nur den letzten Preis ohne Bid oder Ask?", a: "Es ist ein Zustellungsfehler im Replay-Stream und kein Problem Ihres Rechners. Replay liefert normalerweise die volle Markttiefe, doch während dieser Störung sendet der Feed bei jedem Kontrakt nur den zuletzt gehandelten Preis, während die Uhr weiterläuft. Die Bid- und Ask-Spalten bleiben leer, weil diese Kurse nie ankommen. Es gibt keine clientseitige Einstellung, die sie zurückbringt." },
    { q: "Warum kann ich im Market Replay keine Trades platzieren, wenn das passiert?", a: "Für eine simulierte Ausführung braucht es ein ruhendes Bid zum Verkaufen oder ein Ask zum Kaufen. Fehlen Bid/Ask, hat eine Market- oder marktfähige Limit-Order nichts, womit sie gematcht werden kann, und die Replay-Engine gibt einen Fehler statt einer Ausführung zurück. Die leeren Kurse und die Order-Ablehnung sind dasselbe Problem, nicht zwei getrennte." },
    { q: "Habe ich Market Replay mit einer falschen Einstellung kaputt gemacht?", a: "Mit ziemlicher Sicherheit nicht. Das Problem tritt gleichzeitig im Web-, Desktop- und Mobile-Client auf und ist über mehrere Plattformversionen hinweg wiederholt aufgetreten. Wenn dasselbe Symptom alle gleichzeitig betrifft und keine Einstellung etwas ändert, liegt die Ursache auf Seiten von Tradovate und nicht in Ihrer Konfiguration." },
    { q: "Wie behebe ich Market Replay, wenn nur der letzte Preis angezeigt wird?", a: "Es gibt keine verlässliche Lösung auf Client-Seite, weil die Kurse bereits upstream fehlen. Starten Sie zuerst die Replay-Sitzung neu und laden Sie die App neu, falls sich der Stream sauber wieder verbindet. Bleibt er leer, wechseln Sie zum Live-Simulated-Trading, damit Sie weiter mit Echtzeit-Bid/Ask üben können, und melden Sie Datum, Uhrzeit und Produkt an den Tradovate-Support, damit dieser einen Patch eskalieren kann." },
    { q: "Kann ich weiter üben, während Market Replay ausgefallen ist?", a: "Ja. Wechseln Sie zu einem Live-Simulated-Trading-Konto, das mit virtuellem Geld den Live-Echtzeit-Feed handelt. Da es den Live-Marktdatenfeed nutzt, haben Sie ein funktionierendes Bid und Ask und können Orders normal platzieren. Sie können keine bestimmte historische Sitzung zurückspulen, behalten aber eine vollständige Ausführungs-Sandbox, solange Replay defekt ist." },
    { q: "Behebt ein Neustart der App oder das Leeren des Caches den Last-Price-Fehler?", a: "Manchmal stellt ein Neustart, eine erneute Anmeldung oder die erneute Auswahl von Datum und Produkt den Replay-Stream mit intakten Kursen wieder her, ein kurzer Versuch lohnt sich also. Liegt der Fehler jedoch serverseitig, stellt kein Cache-Leeren und keine Neuinstallation das Bid/Ask wieder her, und Sie müssen auf einen Fix warten oder zum Live-Sim wechseln." },
    { q: "Ist mein Market-Replay-Abonnement verschwendet, solange es defekt ist?", a: "Nein. Bestätigen Sie zunächst unter Application Settings, dass das Add-on noch aktiv ist, denn auch eine abgelaufene Testphase oder ein beendetes Abonnement kann Replay stoppen (das verhindert jedoch meist den Start, statt nur den letzten Preis anzuzeigen). Ist das Add-on aktiv und Replay bleibt defekt, melden Sie es dem Support mit den Sitzungsdetails, damit dieser eine Gutschrift oder einen Fix prüfen kann." },
  ], es: [
    { q: "¿Por qué Tradovate Market Replay muestra solo el último precio sin bid ni ask?", a: "Es un defecto de entrega de datos en el flujo de replay, no de su equipo. Replay normalmente envía la profundidad de mercado completa, pero durante esta avería el feed entrega solo el último precio negociado en cada contrato mientras el reloj sigue avanzando. Las columnas de bid y ask permanecen vacías porque esas cotizaciones nunca llegan. No hay ningún ajuste del lado del cliente que las devuelva." },
    { q: "¿Por qué no puedo colocar operaciones en Market Replay cuando ocurre esto?", a: "Una ejecución simulada necesita un bid en reposo al que vender o un ask al que comprar. Sin bid/ask, una orden de mercado o una limitada ejecutable no tiene contra qué cruzarse, por lo que el motor de replay devuelve un error en lugar de una ejecución. Las cotizaciones vacías y el rechazo de la orden son el mismo problema, no dos distintos." },
    { q: "¿He roto Market Replay con un ajuste incorrecto?", a: "Casi con seguridad no. Esto aparece al mismo tiempo en los clientes web, de escritorio y móvil, y se ha repetido a lo largo de varias versiones de la plataforma. Cuando el mismo síntoma afecta a todos a la vez y ningún ajuste lo cambia, la causa está en Tradovate y no en su configuración." },
    { q: "¿Cómo soluciono Market Replay cuando solo muestra el último precio?", a: "No existe una solución fiable del lado del cliente porque las cotizaciones faltan en origen. Primero reinicie la sesión de replay y recargue la aplicación, por si el flujo se reconecta correctamente. Si vuelve vacío, cambie a Simulated Trading en vivo para seguir practicando con bid/ask en tiempo real, e informe al soporte de Tradovate de la fecha, la hora y el producto exactos para que puedan escalar un parche." },
    { q: "¿Puedo seguir practicando mientras Market Replay no funciona?", a: "Sí. Cambie a una cuenta de Simulated Trading en vivo, que opera con el feed en tiempo real usando dinero virtual. Como utiliza el feed de datos de mercado en vivo, dispone de un bid y un ask que funcionan y puede colocar órdenes con normalidad. Pierde la posibilidad de rebobinar una sesión histórica concreta, pero conserva un entorno de ejecución completo mientras replay está averiado." },
    { q: "¿Reiniciar la aplicación o borrar la caché soluciona el error del último precio?", a: "A veces un reinicio, un nuevo inicio de sesión o volver a elegir la fecha y el producto reconecta el flujo de replay con las cotizaciones intactas, así que vale la pena intentarlo. Pero cuando el defecto está en el servidor, ninguna limpieza de caché ni reinstalación restablece el bid/ask, y deberá esperar una corrección o pasar al sim en vivo." },
    { q: "¿Se desperdicia mi suscripción a Market Replay mientras está averiado?", a: "No. Primero confirme en Application Settings que el complemento sigue activo, ya que una prueba caducada o una suscripción vencida también puede detener replay (aunque eso suele impedir que arranque, en lugar de mostrar solo el último precio). Si el complemento está activo y replay sigue fallando, infórmelo al soporte con los detalles de la sesión para que puedan estudiar un crédito o una corrección." },
  ], fr: [
    { q: "Pourquoi Tradovate Market Replay n'affiche-t-il que le dernier prix, sans bid ni ask ?", a: "C'est un défaut de livraison des données dans le flux de replay, pas un problème de votre machine. Replay envoie normalement la profondeur de marché complète, mais pendant cette panne le flux ne délivre que le dernier prix échangé sur chaque contrat tandis que l'horloge continue d'avancer. Les colonnes bid et ask restent vides parce que ces cotations n'arrivent jamais. Aucun réglage côté client ne les rétablit." },
    { q: "Pourquoi ne puis-je pas passer d'ordres dans Market Replay quand cela se produit ?", a: "Une exécution simulée nécessite un bid en attente pour vendre ou un ask pour acheter. Sans bid/ask, un ordre au marché ou une limite exécutable n'a rien contre quoi s'apparier, et le moteur de replay renvoie une erreur au lieu d'une exécution. Les cotations vides et le rejet de l'ordre constituent le même problème, non deux problèmes distincts." },
    { q: "Ai-je cassé Market Replay avec un mauvais réglage ?", a: "Presque certainement pas. Ce problème apparaît simultanément sur les clients web, bureau et mobile, et s'est reproduit sur plusieurs versions de la plateforme. Lorsque le même symptôme touche tout le monde en même temps et qu'aucun réglage n'y change rien, la cause se trouve chez Tradovate et non dans votre configuration." },
    { q: "Comment corriger Market Replay lorsqu'il n'affiche que le dernier prix ?", a: "Il n'existe pas de correctif fiable côté client, car les cotations manquent en amont. Redémarrez d'abord la session de replay et rechargez l'application, au cas où le flux se reconnecterait correctement. Si elle revient vide, passez au Simulated Trading en direct pour continuer à vous entraîner avec un bid/ask en temps réel, et signalez la date, l'heure et le produit exacts au support Tradovate afin qu'il puisse faire remonter un correctif." },
