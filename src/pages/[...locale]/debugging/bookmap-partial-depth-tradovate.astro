---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "bookmap-partial-depth-tradovate";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/debugging/${SLUG}`;

const META_TITLE = "Bookmap Gets Only Partial-Depth Tradovate Data";
const META_DESCRIPTION =
  "Tradovate sends Bookmap only partial order-book depth. Keep it for order routing and add a full-depth feed (dxFeed, Rithmic, CQG) for a complete heatmap.";

// Short SEO title (<=60 chars) for locales where the shared h1 is too long for a SERP title.
const TITLE_OVERRIDE: Partial<Record<Locale, string>> = { es: "Bookmap solo recibe profundidad parcial de Tradovate", fr: "Bookmap : profondeur partielle seulement depuis Tradovate" };

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Bookmap erhält von Tradovate nur Partial-Depth-Daten", es: "Bookmap solo obtiene datos de profundidad parcial de Tradovate", fr: "Bookmap ne reçoit que des données de profondeur partielle de Tradovate", it: "Bookmap riceve solo dati Tradovate a profondità parziale" },
  dek: { en: "Your Bookmap heatmap looks thin and empty on Tradovate, and there's no setting to fix it. Here's why, and how to add full depth without dropping Tradovate.", de: "Ihre Bookmap-Heatmap wirkt bei Tradovate dünn und leer, und es gibt keine Einstellung, die das behebt. Hier erfahren Sie, warum das so ist und wie Sie volle Markttiefe hinzufügen, ohne Tradovate aufzugeben.", es: "Su mapa de calor de Bookmap se ve escaso y vacío en Tradovate, y no hay ninguna configuración para solucionarlo. Esto es por qué sucede y cómo agregar profundidad completa sin abandonar Tradovate.", fr: "Votre carte thermique Bookmap semble clairsemée et vide sur Tradovate, et aucun paramètre ne permet de corriger cela. Voici pourquoi, et comment ajouter une profondeur complète sans abandonner Tradovate.", it: "La heatmap di Bookmap appare sottile e vuota con Tradovate, e non esiste un'impostazione per risolverlo. Ecco perché succede e come aggiungere la profondità completa senza abbandonare Tradovate." },
  readTime: { en: "6 min read", de: "6 Minuten Lesezeit", es: "Lectura de 6 minutos", fr: "Lecture de 6 minutes", it: "Lettura di 6 minuti" },
  lastUpdated: "2026-07-08",
  heroImage: { src: `${IMG}/bookmap-partial-depth-tradovate-1.png`, alt: { en: "Bookmap heatmap connected to Tradovate showing only a thin band of liquidity near the inside market", de: "Bookmap-Heatmap verbunden mit Tradovate, die nur ein schmales Liquiditätsband nahe dem Inside Market zeigt", es: "Mapa de calor de Bookmap conectado a Tradovate que muestra solo una franja delgada de liquidez cerca del mercado interno", fr: "Carte thermique Bookmap connectée à Tradovate affichant seulement une fine bande de liquidité près du marché intérieur", it: "Heatmap di Bookmap collegata a Tradovate che mostra solo una sottile fascia di liquidità vicino al mercato interno" } },
  blocks: { en: [
    { type: "paragraph", html: "You connected Tradovate to Bookmap, loaded ES or NQ, and the heatmap looks wrong. Instead of the deep, layered liquidity map Bookmap is famous for, you get a thin ribbon of color hugging the best bid and offer and almost nothing above or below it. Your first instinct is to blame Bookmap, or hunt through Tradovate's settings for a &ldquo;full depth&rdquo; switch. Don't. Nothing's broken, and there's no switch to flip." },
    { type: "paragraph", html: "<strong class='text-white'>Tradovate only sends Bookmap partial-depth market data.</strong> That's a property of the feed itself, not a misconfiguration on your end. Bookmap's heatmap needs the whole order book to do its job, and a partial feed can only paint the slice it's given. The clean fix is to keep Tradovate for what it's good at, order routing, and bring in a separate full-depth data feed for the visualization. Here's exactly why this happens and how to set it up." },
    {
      type: "checklist",
      heading: "Quick Checklist",
      items: [
        "<strong class='text-white'>Confirm the heatmap is sparse, not frozen.</strong> If you see live trades and a narrow band of liquidity around the spread, that's partial depth, not a dead feed.",
        "<strong class='text-white'>Accept that Tradovate = partial depth to Bookmap.</strong> It sends a limited part of the book, not the full ladder.",
        "<strong class='text-white'>Stop looking for a Tradovate &ldquo;full depth&rdquo; setting.</strong> There isn't one to enable for this.",
        "<strong class='text-white'>Keep Tradovate as your trading connection.</strong> Order routing through it is fine.",
        "<strong class='text-white'>Add a full-depth data feed:</strong> dxFeed, Rithmic, or CQG.",
        "<strong class='text-white'>Budget for depth-data fees.</strong> Full-depth CME data carries exchange and provider costs that change over time.",
        "<strong class='text-white'>On a prop or eval account, check your firm's rules first.</strong> Some restrict outside data feeds.",
      ],
    },
    { type: "heading", text: "What “Partial-Depth Data” Actually Means" },
    { type: "paragraph", html: "Bookmap's heatmap isn't a normal chart. It records every resting limit order sitting in the book, at every price level, and replays how that liquidity builds, pulls, and gets absorbed over time. Bright bands mark price levels stacked with resting orders; dark areas mark thin liquidity. To draw that picture honestly, Bookmap needs the full depth of market, the entire ladder of bids and offers, not just the top rungs." },
    { type: "paragraph", html: "Tradovate's feed to Bookmap doesn't carry the full ladder. It carries partial depth, essentially a window near the best bid and best offer. So when Bookmap tries to render the heatmap, it only has data for that narrow window. Everything further out in the book is simply missing, which is why the map looks empty a few ticks away from price. You're not looking at a rendering glitch. You're looking at all the data Tradovate handed over." },
    { type: "paragraph", html: "That distinction matters because the value of order-flow trading lives in the deeper book, the large resting walls, the liquidity that appears and vanishes several ticks out, the absorption that happens before price even gets there. Cut that off and the heatmap loses most of its edge. The tool is only as good as the feed behind it." },
    { type: "heading", text: "Why Tradovate Only Gives Partial Depth" },
    { type: "paragraph", html: "This trips people up because Tradovate's own platform feels complete. You've got a DOM, you've got charts, everything looks live. But the data Tradovate exposes to an outside application like Bookmap is a different, more limited stream than what you might expect from a dedicated depth feed. For Bookmap's purposes, that stream is partial depth." },
    { type: "paragraph", html: "It's not a bug, a tier you forgot to buy, or a permission you can grant yourself. There's no hidden &ldquo;send full depth to Bookmap&rdquo; option buried in Tradovate's menus, so combing through settings is wasted time. The realistic path forward isn't to fix Tradovate, it's to pair it with a feed that was built to stream the full order book." },
    { type: "image", src: `${IMG}/bookmap-partial-depth-tradovate-2.png`, alt: "Bookmap connections screen listing Tradovate as a connection with a partial-depth data note" },
    { type: "heading", text: "The Fix: Split Data and Order Routing" },
    { type: "paragraph", html: "Bookmap keeps two things separate: where your market data comes from, and where your orders go. Its packages don't bundle data or brokerage, so you're expected to attach those yourself, and you can attach them from different providers. That separation is exactly what solves this. You keep Tradovate as the connection that routes and fills your orders, and you add a full-depth provider as the connection that feeds the heatmap." },
    {
      type: "steps",
      items: [
        { title: "Keep Tradovate as your trading connection", html: "There's no reason to drop Tradovate. If you like its fills, fees, or it's the account your prop firm gave you, leave it in place as your order-routing connection in Bookmap. Everything about how you enter and exit stays the same. This step is really just a decision: Tradovate handles execution, not the heatmap." },
        { title: "Add a full-depth market-data feed", html: "Add one of the full-depth futures data providers Bookmap supports for the visualization: <strong class='text-white'>dxFeed</strong> (full-depth market data), <strong class='text-white'>Rithmic</strong> (full depth, plus market-by-order data showing individual orders rather than just aggregated size), or <strong class='text-white'>CQG</strong> (CQG Continuum, full-depth market data). All three give Bookmap the complete ladder it needs; pick based on price, latency, instrument coverage, and what your platform or firm already supports." },
        { title: "Load the instrument on the full-depth feed", html: "Open your futures instrument using the new full-depth data connection so the heatmap is built from the complete order book. Give it a minute to populate. Instead of a thin band around the spread, you should now see liquidity rendered several ticks, or many ticks, out on both sides, with the resting walls and pulls that make the heatmap worth watching." },
        { title: "Confirm orders still route through Tradovate", html: "With two connections active, make sure Bookmap is set to send orders through Tradovate while it draws data from the full-depth feed. Place a small test order (or check a simulated one) and confirm it lands in your Tradovate account. Verify the exact toggles and labels for choosing the trading connection in your current Bookmap build, since they get updated over time." },
      ],
    },
    { type: "image", src: `${IMG}/bookmap-partial-depth-tradovate-3.png`, alt: "Adding a full-depth data provider such as Rithmic, dxFeed, or CQG as a connection in Bookmap" },
    { type: "image", src: `${IMG}/bookmap-partial-depth-tradovate-4.png`, alt: "Bookmap heatmap showing full order-book depth from an added feed while orders still route through Tradovate" },
    { type: "quote", html: "Full-depth CME data isn't free. Expect exchange fees plus a provider charge, and the totals shift depending on the exchange, the provider, and whether you're classified as a non-professional or professional user. Confirm the current rates before you subscribe, and if you're on a prop or evaluation account, check whether your firm even allows an outside data feed first, that varies by firm and account type." },
    { type: "heading", text: "Troubleshooting Table" },
    {
      type: "table",
      headers: ["What you see", "What it means", "Fix"],
      rows: [
        ["Thin band of liquidity around the spread, empty elsewhere", "Tradovate is only sending partial depth to Bookmap", "Add a full-depth feed (dxFeed, Rithmic, or CQG) for the heatmap"],
        ["Heatmap shows live trades but no deep resting liquidity", "Trades come through, but the full order book doesn't", "Switch the data connection to a full-depth provider"],
        ["Can't find a &ldquo;full depth&rdquo; option in Tradovate", "There isn't one for Bookmap; it's a feed limitation", "Stop configuring Tradovate; change the data source in Bookmap"],
        ["You want to keep Tradovate fills and fees", "Trading and data are separate in Bookmap", "Keep Tradovate for routing, add a separate data feed"],
        ["Full-depth feed added but orders won't place", "Trading connection isn't pointed at Tradovate", "Set Tradovate as the order-routing connection in Bookmap"],
        ["Depth data blocked on a prop/eval account", "Firm controls market data on that account", "Ask your firm which feeds are allowed before subscribing"],
      ],
    },
    { type: "heading", text: "Where PickMyTrade Fits" },
    { type: "paragraph", html: "Splitting data and execution is smart, but it also means your order flow to Tradovate has to be rock-solid on its own, separate from whatever you're using to read the tape. That's the layer PickMyTrade handles. It automates and routes your trades to Tradovate from your signals, so your execution stays reliable while you use Bookmap plus a full-depth feed purely for analysis." },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Signal-to-Tradovate automation</strong> turns your TradingView (or other) alerts into live Tradovate orders, so execution doesn't depend on the charting tool you're watching.",
        "<strong class='text-white'>Prop-firm risk filters</strong> keep automated orders inside the caps and rules of firm-managed evaluation accounts.",
        "<strong class='text-white'>Rate-limit-safe routing</strong> spaces order flow so nothing bounces off Tradovate's request limits.",
        "<strong class='text-white'>Multi-account sync</strong> mirrors the same order across every connected account at once.",
      ],
    },
  ], de: [
    { type: "paragraph", html: "Sie haben Tradovate mit Bookmap verbunden, ES oder NQ geladen, und die Heatmap sieht falsch aus. Statt der tiefen, mehrschichtigen Liquiditätskarte, für die Bookmap bekannt ist, sehen Sie nur ein schmales Farbband dicht am besten Geld- und Briefkurs, darüber oder darunter fast nichts. Der erste Impuls ist, Bookmap die Schuld zu geben oder in den Einstellungen von Tradovate nach einem &ldquo;Full Depth&rdquo;-Schalter zu suchen. Tun Sie das nicht. Nichts ist kaputt, und es gibt keinen Schalter zum Umlegen." },
    { type: "paragraph", html: "<strong class='text-white'>Tradovate sendet an Bookmap nur Partial-Depth-Marktdaten.</strong> Das liegt am Feed selbst, nicht an einer Fehlkonfiguration Ihrerseits. Bookmaps Heatmap benötigt das gesamte Orderbuch, um ihre Aufgabe zu erfüllen, und ein partieller Feed kann nur den Ausschnitt zeichnen, den er erhält. Die saubere Lösung besteht darin, Tradovate für das einzusetzen, worin es gut ist, das Order-Routing, und für die Visualisierung einen separaten Full-Depth-Datenfeed hinzuzufügen. Hier erfahren Sie genau, warum das passiert und wie Sie es einrichten." },
    {
      type: "checklist",
      heading: "Kurz-Checkliste",
      items: [
        "<strong class='text-white'>Bestätigen Sie, dass die Heatmap spärlich ist, nicht eingefroren.</strong> Wenn Sie Live-Trades und ein schmales Liquiditätsband um den Spread sehen, ist das Partial Depth, kein toter Feed.",
        "<strong class='text-white'>Akzeptieren Sie: Tradovate = Partial Depth für Bookmap.</strong> Es sendet nur einen begrenzten Teil des Orderbuchs, nicht die vollständige Leiter.",
        "<strong class='text-white'>Suchen Sie nicht länger nach einer &ldquo;Full Depth&rdquo;-Einstellung in Tradovate.</strong> Es gibt hierfür keine zu aktivieren.",
        "<strong class='text-white'>Behalten Sie Tradovate als Handelsverbindung.</strong> Das Order-Routing darüber funktioniert einwandfrei.",
        "<strong class='text-white'>Fügen Sie einen Full-Depth-Datenfeed hinzu:</strong> dxFeed, Rithmic oder CQG.",
        "<strong class='text-white'>Planen Sie Kosten für Depth-Daten ein.</strong> Full-Depth-CME-Daten sind mit Börsen- und Anbietergebühren verbunden, die sich im Laufe der Zeit ändern.",
        "<strong class='text-white'>Bei einem Prop- oder Eval-Account prüfen Sie zuerst die Regeln Ihrer Firma.</strong> Manche schränken externe Datenfeeds ein.",
      ],
    },
    { type: "heading", text: "Was „Partial-Depth-Daten“ wirklich bedeutet" },
    { type: "paragraph", html: "Bookmaps Heatmap ist kein gewöhnliches Chart. Sie erfasst jede im Orderbuch liegende Limit-Order auf jedem Preisniveau und zeigt im Zeitverlauf, wie sich diese Liquidität aufbaut, zurückzieht und absorbiert wird. Helle Bänder markieren Preisniveaus mit vielen liegenden Orders; dunkle Bereiche markieren dünne Liquidität. Um dieses Bild wahrheitsgetreu zu zeichnen, benötigt Bookmap die volle Markttiefe, die gesamte Leiter aus Geld- und Briefkursen, nicht nur die obersten Stufen." },
    { type: "paragraph", html: "Der Feed von Tradovate zu Bookmap überträgt nicht die vollständige Leiter. Er überträgt Partial Depth, im Grunde ein Fenster nahe dem besten Geld- und Briefkurs. Wenn Bookmap versucht, die Heatmap zu rendern, stehen also nur Daten für dieses schmale Fenster zur Verfügung. Alles, was weiter im Orderbuch liegt, fehlt schlicht, weshalb die Karte wenige Ticks vom Kurs entfernt leer aussieht. Sie sehen keinen Darstellungsfehler. Sie sehen sämtliche Daten, die Tradovate übergeben hat." },
    { type: "paragraph", html: "Dieser Unterschied ist wichtig, denn der Wert des Order-Flow-Tradings liegt im tieferen Orderbuch: den großen liegenden Wänden, der Liquidität, die mehrere Ticks entfernt erscheint und wieder verschwindet, der Absorption, die stattfindet, bevor der Kurs dort überhaupt ankommt. Schneidet man das ab, verliert die Heatmap den Großteil ihres Nutzens. Das Werkzeug ist nur so gut wie der Feed dahinter." },
    { type: "heading", text: "Warum Tradovate nur Partial Depth liefert" },
    { type: "paragraph", html: "Das verwirrt viele, weil sich Tradovates eigene Plattform vollständig anfühlt. Sie haben ein DOM, Sie haben Charts, alles wirkt live. Doch die Daten, die Tradovate einer externen Anwendung wie Bookmap zur Verfügung stellt, sind ein anderer, stärker eingeschränkter Stream, als man es von einem dedizierten Depth-Feed erwarten würde. Für Bookmaps Zwecke ist dieser Stream Partial Depth." },
    { type: "paragraph", html: "Es handelt sich nicht um einen Fehler, ein vergessenes Upgrade oder eine Berechtigung, die Sie sich selbst erteilen können. Es gibt keine versteckte Option &ldquo;Full Depth an Bookmap senden&rdquo;, die in Tradovates Menüs verborgen wäre, daher ist das Durchsuchen der Einstellungen verlorene Zeit. Der realistische Weg besteht nicht darin, Tradovate zu reparieren, sondern es mit einem Feed zu kombinieren, der dafür gebaut wurde, das vollständige Orderbuch zu streamen." },
    { type: "image", src: `${IMG}/bookmap-partial-depth-tradovate-2.png`, alt: "Bookmap-Verbindungsbildschirm mit Tradovate als Verbindung und einem Hinweis auf Partial-Depth-Daten" },
    { type: "heading", text: "Die Lösung: Daten und Order-Routing trennen" },
    { type: "paragraph", html: "Bookmap trennt zwei Dinge strikt: woher Ihre Marktdaten kommen und wohin Ihre Orders gehen. Die Pakete bündeln weder Daten noch Brokerage, Sie sollen diese selbst verbinden, und Sie können sie von unterschiedlichen Anbietern beziehen. Genau diese Trennung löst das Problem. Sie behalten Tradovate als Verbindung, die Ihre Orders routet und ausführt, und fügen einen Full-Depth-Anbieter als Verbindung hinzu, die die Heatmap speist." },
    {
      type: "steps",
      items: [
        { title: "Tradovate als Handelsverbindung behalten", html: "Es gibt keinen Grund, Tradovate aufzugeben. Wenn Ihnen die Fills, die Gebühren gefallen, oder es das Konto ist, das Ihre Prop-Firma Ihnen gegeben hat, lassen Sie es als Order-Routing-Verbindung in Bookmap bestehen. An der Art, wie Sie ein- und aussteigen, ändert sich nichts. Dieser Schritt ist eigentlich nur eine Entscheidung: Tradovate übernimmt die Ausführung, nicht die Heatmap." },
        { title: "Einen Full-Depth-Marktdatenfeed hinzufügen", html: "Fügen Sie für die Visualisierung einen der Full-Depth-Futures-Datenanbieter hinzu, die Bookmap unterstützt: <strong class='text-white'>dxFeed</strong> (Full-Depth-Marktdaten), <strong class='text-white'>Rithmic</strong> (Full Depth, zusätzlich Market-by-Order-Daten, die einzelne Orders statt nur aggregierter Größe zeigen), oder <strong class='text-white'>CQG</strong> (CQG Continuum, Full-Depth-Marktdaten). Alle drei liefern Bookmap die vollständige Leiter, die es braucht; wählen Sie basierend auf Preis, Latenz, Instrumentenabdeckung und dem, was Ihre Plattform oder Firma bereits unterstützt." },
        { title: "Das Instrument auf dem Full-Depth-Feed laden", html: "Öffnen Sie Ihr Futures-Instrument über die neue Full-Depth-Datenverbindung, damit die Heatmap aus dem vollständigen Orderbuch aufgebaut wird. Geben Sie ihr eine Minute Zeit, sich zu füllen. Statt eines schmalen Bands um den Spread sollten Sie nun Liquidität sehen, die sich mehrere Ticks, oder viele Ticks, auf beiden Seiten erstreckt, mit den liegenden Wänden und Rückzügen, die die Heatmap sehenswert machen." },
        { title: "Bestätigen, dass Orders weiterhin über Tradovate laufen", html: "Stellen Sie bei zwei aktiven Verbindungen sicher, dass Bookmap so eingestellt ist, dass Orders über Tradovate gesendet werden, während die Daten vom Full-Depth-Feed bezogen werden. Platzieren Sie eine kleine Testorder (oder prüfen Sie eine simulierte) und bestätigen Sie, dass sie in Ihrem Tradovate-Konto ankommt. Prüfen Sie die genauen Schalter und Bezeichnungen zur Auswahl der Handelsverbindung in Ihrer aktuellen Bookmap-Version, da diese sich im Laufe der Zeit ändern." },
      ],
    },
    { type: "image", src: `${IMG}/bookmap-partial-depth-tradovate-3.png`, alt: "Hinzufügen eines Full-Depth-Datenanbieters wie Rithmic, dxFeed oder CQG als Verbindung in Bookmap" },
    { type: "image", src: `${IMG}/bookmap-partial-depth-tradovate-4.png`, alt: "Bookmap-Heatmap mit voller Orderbuchtiefe aus einem hinzugefügten Feed, während Orders weiterhin über Tradovate laufen" },
    { type: "quote", html: "Full-Depth-CME-Daten sind nicht kostenlos. Rechnen Sie mit Börsengebühren plus einer Anbietergebühr, wobei sich die Summen je nach Börse, Anbieter und Ihrem Status als nicht-professioneller oder professioneller Nutzer unterscheiden. Bestätigen Sie die aktuellen Tarife, bevor Sie abonnieren, und prüfen Sie bei einem Prop- oder Evaluation-Account zunächst, ob Ihre Firma einen externen Datenfeed überhaupt erlaubt, das variiert je nach Firma und Kontotyp." },
    { type: "heading", text: "Fehlerbehebungstabelle" },
    {
      type: "table",
      headers: ["Was Sie sehen", "Was es bedeutet", "Lösung"],
      rows: [
        ["Schmales Liquiditätsband um den Spread, sonst leer", "Tradovate sendet an Bookmap nur Partial Depth", "Einen Full-Depth-Feed (dxFeed, Rithmic oder CQG) für die Heatmap hinzufügen"],
        ["Heatmap zeigt Live-Trades, aber keine tiefe liegende Liquidität", "Trades kommen durch, das vollständige Orderbuch jedoch nicht", "Die Datenverbindung auf einen Full-Depth-Anbieter umstellen"],
        ["Keine &ldquo;Full Depth&rdquo;-Option in Tradovate zu finden", "Es gibt keine für Bookmap; es ist eine Feed-Beschränkung", "Nicht länger Tradovate konfigurieren; die Datenquelle in Bookmap ändern"],
        ["Sie möchten Tradovates Fills und Gebühren behalten", "Handel und Daten sind in Bookmap getrennt", "Tradovate für das Routing behalten, separaten Datenfeed hinzufügen"],
        ["Full-Depth-Feed hinzugefügt, aber Orders werden nicht platziert", "Die Handelsverbindung zeigt nicht auf Tradovate", "Tradovate als Order-Routing-Verbindung in Bookmap festlegen"],
        ["Depth-Daten auf einem Prop-/Eval-Account blockiert", "Die Firma kontrolliert die Marktdaten auf diesem Konto", "Vor dem Abonnieren bei Ihrer Firma erfragen, welche Feeds erlaubt sind"],
      ],
    },
    { type: "heading", text: "Wo PickMyTrade ins Bild passt" },
    { type: "paragraph", html: "Daten und Ausführung zu trennen ist klug, bedeutet aber auch, dass Ihr Orderfluss zu Tradovate für sich genommen absolut zuverlässig sein muss, unabhängig davon, womit Sie das Tape lesen. Genau diese Ebene übernimmt PickMyTrade. Es automatisiert Ihre Trades und routet sie anhand Ihrer Signale zu Tradovate, sodass Ihre Ausführung zuverlässig bleibt, während Sie Bookmap plus einen Full-Depth-Feed rein zur Analyse nutzen." },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Signal-zu-Tradovate-Automatisierung</strong> verwandelt Ihre TradingView- (oder andere) Alerts in live Tradovate-Orders, sodass die Ausführung nicht vom Charting-Tool abhängt, das Sie gerade betrachten.",
        "<strong class='text-white'>Risikofilter für Prop-Firmen</strong> halten automatisierte Orders innerhalb der Obergrenzen und Regeln firmenverwalteter Evaluation-Accounts.",
        "<strong class='text-white'>Rate-Limit-sicheres Routing</strong> staffelt den Orderfluss so, dass nichts an Tradovates Anfragelimits abprallt.",
        "<strong class='text-white'>Multi-Account-Synchronisierung</strong> spiegelt dieselbe Order gleichzeitig auf jedem verbundenen Konto.",
      ],
    },
  ], es: [
    { type: "paragraph", html: "Conectó Tradovate a Bookmap, cargó ES o NQ, y el mapa de calor se ve mal. En lugar del mapa de liquidez profundo y en capas por el que Bookmap es famoso, obtiene una franja delgada de color pegada a la mejor oferta de compra y venta y casi nada por encima o por debajo. Su primer instinto es culpar a Bookmap, o buscar en la configuración de Tradovate un interruptor de &ldquo;profundidad completa&rdquo;. No lo haga. Nada está roto, y no hay ningún interruptor que activar." },
    { type: "paragraph", html: "<strong class='text-white'>Tradovate solo envía a Bookmap datos de mercado de profundidad parcial.</strong> Eso es una característica del feed en sí, no un error de configuración de su parte. El mapa de calor de Bookmap necesita todo el libro de órdenes para cumplir su función, y un feed parcial solo puede pintar la porción que recibe. La solución limpia es mantener Tradovate para lo que hace bien, el enrutamiento de órdenes, e incorporar un feed de datos de profundidad completa independiente para la visualización. Esto es exactamente por qué ocurre esto y cómo configurarlo." },
    {
      type: "checklist",
      heading: "Lista de Verificación Rápida",
      items: [
        "<strong class='text-white'>Confirme que el mapa de calor está disperso, no congelado.</strong> Si ve operaciones en vivo y una banda estrecha de liquidez alrededor del spread, eso es profundidad parcial, no un feed inactivo.",
        "<strong class='text-white'>Acepte que Tradovate = profundidad parcial para Bookmap.</strong> Envía una parte limitada del libro, no la escalera completa.",
        "<strong class='text-white'>Deje de buscar una configuración de &ldquo;profundidad completa&rdquo; en Tradovate.</strong> No existe ninguna que pueda activar para esto.",
        "<strong class='text-white'>Mantenga Tradovate como su conexión de trading.</strong> El enrutamiento de órdenes a través de él funciona perfectamente.",
        "<strong class='text-white'>Agregue un feed de datos de profundidad completa:</strong> dxFeed, Rithmic o CQG.",
        "<strong class='text-white'>Presupueste las tarifas de datos de profundidad.</strong> Los datos de profundidad completa de CME conllevan costos de bolsa y de proveedor que cambian con el tiempo.",
        "<strong class='text-white'>En una cuenta prop o de evaluación, verifique primero las reglas de su firma.</strong> Algunas restringen los feeds de datos externos.",
      ],
    },
    { type: "heading", text: "Qué Significa Realmente los “Datos de Profundidad Parcial”" },
    { type: "paragraph", html: "El mapa de calor de Bookmap no es un gráfico normal. Registra cada orden límite en espera dentro del libro, en cada nivel de precio, y reproduce cómo esa liquidez se acumula, se retira y se absorbe con el tiempo. Las bandas brillantes marcan niveles de precio apilados con órdenes en espera; las áreas oscuras marcan liquidez escasa. Para dibujar esa imagen con fidelidad, Bookmap necesita la profundidad completa del mercado, toda la escalera de ofertas de compra y venta, no solo los primeros escalones." },
    { type: "paragraph", html: "El feed de Tradovate hacia Bookmap no transporta la escalera completa. Transporta profundidad parcial, esencialmente una ventana cerca de la mejor oferta de compra y venta. Entonces, cuando Bookmap intenta renderizar el mapa de calor, solo tiene datos para esa ventana estrecha. Todo lo que está más allá en el libro simplemente falta, por eso el mapa se ve vacío a pocos ticks del precio. No está viendo un fallo de renderizado. Está viendo todos los datos que Tradovate entregó." },
    { type: "paragraph", html: "Esa distinción importa porque el valor del trading por flujo de órdenes reside en el libro más profundo, los grandes muros de órdenes en espera, la liquidez que aparece y desaparece varios ticks más allá, la absorción que ocurre antes de que el precio siquiera llegue ahí. Elimine eso y el mapa de calor pierde la mayor parte de su ventaja. La herramienta es tan buena como el feed que la respalda." },
    { type: "heading", text: "Por Qué Tradovate Solo Ofrece Profundidad Parcial" },
    { type: "paragraph", html: "Esto confunde a la gente porque la propia plataforma de Tradovate se siente completa. Tiene un DOM, tiene gráficos, todo parece en vivo. Pero los datos que Tradovate expone a una aplicación externa como Bookmap son un flujo diferente y más limitado de lo que podría esperar de un feed de profundidad dedicado. Para los fines de Bookmap, ese flujo es profundidad parcial." },
    { type: "paragraph", html: "No es un error, un nivel que olvidó comprar, ni un permiso que pueda otorgarse usted mismo. No hay ninguna opción oculta de &ldquo;enviar profundidad completa a Bookmap&rdquo; escondida en los menús de Tradovate, así que revisar la configuración es tiempo perdido. El camino realista a seguir no es arreglar Tradovate, sino combinarlo con un feed diseñado para transmitir el libro de órdenes completo." },
    { type: "image", src: `${IMG}/bookmap-partial-depth-tradovate-2.png`, alt: "Pantalla de conexiones de Bookmap donde se muestra Tradovate como conexión con una nota de datos de profundidad parcial" },
    { type: "heading", text: "La Solución: Separar los Datos y el Enrutamiento de Órdenes" },
    { type: "paragraph", html: "Bookmap mantiene dos cosas separadas: de dónde provienen sus datos de mercado y adónde van sus órdenes. Sus paquetes no incluyen datos ni brokeraje, por lo que se espera que usted mismo los conecte, y puede conectarlos desde proveedores diferentes. Esa separación es exactamente lo que resuelve esto. Usted mantiene Tradovate como la conexión que enruta y ejecuta sus órdenes, y agrega un proveedor de profundidad completa como la conexión que alimenta el mapa de calor." },
    {
      type: "steps",
      items: [
        { title: "Mantenga Tradovate como su conexión de trading", html: "No hay ninguna razón para abandonar Tradovate. Si le gustan sus ejecuciones, sus comisiones, o si es la cuenta que le dio su firma prop, déjela en su lugar como su conexión de enrutamiento de órdenes en Bookmap. Todo lo relacionado con cómo entra y sale se mantiene igual. Este paso es en realidad solo una decisión: Tradovate se encarga de la ejecución, no del mapa de calor." },
        { title: "Agregue un feed de datos de mercado de profundidad completa", html: "Agregue uno de los proveedores de datos de futuros de profundidad completa que admite Bookmap para la visualización: <strong class='text-white'>dxFeed</strong> (datos de mercado de profundidad completa), <strong class='text-white'>Rithmic</strong> (profundidad completa, además de datos market-by-order que muestran órdenes individuales en lugar de solo el tamaño agregado), o <strong class='text-white'>CQG</strong> (CQG Continuum, datos de mercado de profundidad completa). Los tres le dan a Bookmap la escalera completa que necesita; elija según el precio, la latencia, la cobertura de instrumentos y lo que ya admita su plataforma o firma." },
        { title: "Cargue el instrumento en el feed de profundidad completa", html: "Abra su instrumento de futuros usando la nueva conexión de datos de profundidad completa para que el mapa de calor se construya a partir del libro de órdenes completo. Déle un minuto para que se cargue. En lugar de una banda delgada alrededor del spread, ahora debería ver liquidez renderizada varios ticks, o muchos ticks, hacia ambos lados, con los muros de órdenes en espera y los retiros que hacen que valga la pena observar el mapa de calor." },
        { title: "Confirme que las órdenes sigan enrutándose por Tradovate", html: "Con dos conexiones activas, asegúrese de que Bookmap esté configurado para enviar órdenes a través de Tradovate mientras obtiene los datos del feed de profundidad completa. Coloque una pequeña orden de prueba (o revise una simulada) y confirme que llegue a su cuenta de Tradovate. Verifique los interruptores y etiquetas exactos para elegir la conexión de trading en su versión actual de Bookmap, ya que se actualizan con el tiempo." },
      ],
    },
    { type: "image", src: `${IMG}/bookmap-partial-depth-tradovate-3.png`, alt: "Agregar un proveedor de datos de profundidad completa como Rithmic, dxFeed o CQG como conexión en Bookmap" },
    { type: "image", src: `${IMG}/bookmap-partial-depth-tradovate-4.png`, alt: "Mapa de calor de Bookmap que muestra la profundidad completa del libro de órdenes de un feed agregado mientras las órdenes siguen enrutándose por Tradovate" },
    { type: "quote", html: "Los datos de profundidad completa de CME no son gratuitos. Espere tarifas de bolsa más un cargo del proveedor, y los totales varían según la bolsa, el proveedor, y si está clasificado como usuario profesional o no profesional. Confirme las tarifas vigentes antes de suscribirse, y si está en una cuenta prop o de evaluación, verifique primero si su firma siquiera permite un feed de datos externo, eso varía según la firma y el tipo de cuenta." },
    { type: "heading", text: "Tabla de Solución de Problemas" },
    {
      type: "table",
      headers: ["Lo que ve", "Lo que significa", "Solución"],
      rows: [
        ["Banda delgada de liquidez alrededor del spread, vacío en el resto", "Tradovate solo está enviando profundidad parcial a Bookmap", "Agregue un feed de profundidad completa (dxFeed, Rithmic o CQG) para el mapa de calor"],
        ["El mapa de calor muestra operaciones en vivo pero sin liquidez profunda en espera", "Las operaciones llegan, pero el libro de órdenes completo no", "Cambie la conexión de datos a un proveedor de profundidad completa"],
        ["No encuentra una opción de &ldquo;profundidad completa&rdquo; en Tradovate", "No existe ninguna para Bookmap; es una limitación del feed", "Deje de configurar Tradovate; cambie la fuente de datos en Bookmap"],
        ["Quiere mantener las ejecuciones y comisiones de Tradovate", "El trading y los datos están separados en Bookmap", "Mantenga Tradovate para el enrutamiento, agregue un feed de datos separado"],
        ["Feed de profundidad completa agregado pero las órdenes no se colocan", "La conexión de trading no apunta a Tradovate", "Configure Tradovate como la conexión de enrutamiento de órdenes en Bookmap"],
