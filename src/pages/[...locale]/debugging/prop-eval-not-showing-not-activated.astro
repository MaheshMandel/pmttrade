---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "prop-eval-not-showing-not-activated";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/debugging/${SLUG}`;

const META_TITLE = "Tradovate Prop Eval Not Showing After Purchase";
const META_DESCRIPTION =
  "Tradovate prop account not showing after purchase? Wait out provisioning, log back in, and have your prop firm activate the account and data.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Tradovate-Prop-Evaluierung nach dem Kauf nicht sichtbar", es: "Evaluación prop de Tradovate sin aparecer tras la compra", fr: "Évaluation prop Tradovate absente après l'achat", it: "Valutazione prop Tradovate non visibile dopo l'acquisto" },
  dek: { en: "You just paid for a fresh evaluation, log into Tradovate, and the account simply isn't there. Don't panic, in the overwhelming majority of cases it's being built in the background and is minutes away, not lost.", de: "Sie haben gerade eine frische Evaluierung bezahlt, melden sich bei Tradovate an, und das Konto ist einfach nicht da. Keine Panik: In den allermeisten Fällen wird es im Hintergrund aufgebaut und ist nur Minuten entfernt, nicht verloren.", es: "Acaba de pagar una evaluación nueva, inicia sesión en Tradovate y la cuenta simplemente no está. No entre en pánico: en la gran mayoría de los casos se está creando en segundo plano y está a minutos de aparecer, no perdida.", fr: "Vous venez de payer une évaluation toute neuve, vous vous connectez à Tradovate, et le compte n'est tout simplement pas là. Pas de panique : dans la grande majorité des cas, il est en cours de création en arrière-plan et n'est qu'à quelques minutes, pas perdu.", it: "Ha appena pagato una valutazione nuova, accede a Tradovate e il conto semplicemente non c'è. Niente panico: nella stragrande maggioranza dei casi viene creato in background ed è a pochi minuti di distanza, non perso." },
  readTime: { en: "7 min read", de: "7 Min. Lesezeit", es: "Lectura de 7 min", fr: "Lecture : 7 min", it: "Lettura di 7 min" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "You just paid for a fresh evaluation, you're ready to trade, and you log into Tradovate, but the account simply isn't there. No balance, nothing in the account selector, or worse, a screen nagging you to fund an account you already bought. Don't panic, and don't fire off a support ticket yet. In the overwhelming majority of cases the account is being built in the background and is minutes away, not lost. Your prop firm creates a brand-new eval account and pushes it to Tradovate on a delay, so an account that's missing right after checkout is almost always a timing, credentials, or agreement-signing issue, not a broken purchase." },
    { type: "paragraph", html: "Below, walk through every reason a freshly bought Tradovate evaluation fails to appear or activate, in the order you should actually check them, plus how to tell when the problem is genuinely on your prop firm's side. And if you plan to automate that account the second it goes live, a bridge like PickMyTrade lets you stage your TradingView alerts in advance so nothing fires against an account that isn't fully switched on yet." },
    {
      type: "checklist",
      heading: "Quick Checklist for a Missing Tradovate Eval",
      items: [
        "<strong class='text-white'>Give it time to provision.</strong> New eval accounts aren't instant. Let the full activation window pass before you assume anything's wrong, it varies by firm, so check your firm's current rules.",
        "<strong class='text-white'>Sign the user agreement.</strong> On your first login, Tradovate asks you to review and e-sign an agreement. The account won't show in your tradable list until you do.",
        "<strong class='text-white'>Use the prop firm's credentials, not a personal Tradovate login.</strong> Signing into an old personal account will never surface your new evaluation.",
        "<strong class='text-white'>Log fully out and back in.</strong> A stale session often just needs a clean re-login, or a browser or app refresh, to pull the newly created account.",
        "<strong class='text-white'>Check the account dropdown.</strong> If you own several evaluations, the new one may be sitting in the selector rather than missing.",
        "<strong class='text-white'>Contact your prop firm if it still won't show.</strong> Tradovate doesn't own evaluation accounts and can't create, enable, or fix them.",
      ],
    },
    { type: "heading", text: "What “Account Not Showing / Not Activated” Means" },
    { type: "paragraph", html: "There's no single, universal error string for this, which is half of why it's so confusing. Instead you hit one of a few symptoms: you log in fine but the account is absent from the selector, the platform shows nothing available to trade, or you get a prompt to fund or open an account even though you already paid for an evaluation. All three point to the same underlying state, Tradovate has authenticated you, but the specific eval account hasn't been created, linked, or fully activated against your login yet." },
    { type: "paragraph", html: "The mental model that clears this up is ownership. When you buy an evaluation, your prop firm, not Tradovate, creates the account on Tradovate's infrastructure and grants it to your username. Tradovate is the platform; the firm is the account owner. That handoff takes time and depends entirely on the firm's provisioning queue. Until the firm's system finishes building the account and you've completed any required agreement, there's literally nothing for Tradovate to display." },
    { type: "paragraph", html: "“Not activated” usually stacks a second problem on top. Even once the account appears, live market data on a prop or evaluation account can only be switched on by the account provider. An account that shows up but streams delayed or missing quotes isn't broken, it's waiting on the firm to enable data, which is a separate step from the account itself going live." },
    { type: "heading", text: "Top Causes of a Tradovate Prop Account Not Showing" },
    { type: "heading", text: "1. It's still provisioning (by far the most common cause)" },
    { type: "paragraph", html: "New evaluation accounts are created on a delay after purchase. A new eval account typically takes somewhere between 10 and 90 minutes to set up once the required agreements are signed, and during busy periods some firms tell buyers to allow several hours before opening a ticket. The exact wait varies by firm and account size, so check your firm's current rules, but the pattern never changes: the purchase completes instantly, the account does not. If you just paid and immediately logged in, a blank account list is expected, not a bug." },
    { type: "heading", text: "2. You haven't signed the first-login user agreement" },
    { type: "paragraph", html: "On your first login to a new evaluation, Tradovate prompts you to review and electronically sign a user agreement. Skip it or dismiss it and the account won't be listed as tradable. This one trips people up constantly, you close the modal, land on an empty platform, and conclude the account never arrived, when it's simply gated behind an unsigned agreement." },
    { type: "heading", text: "3. You're logging into the wrong account" },
    { type: "paragraph", html: "Your evaluation uses the credentials issued in your prop firm's dashboard, not any personal Tradovate account you set up earlier. Logging into an old personal login (or a demo you started directly with Tradovate) authenticates just fine and shows none of your firm's accounts, because they're attached to a completely different username. Always sign in with the exact credentials the firm gave you." },
    { type: "heading", text: "4. The account is there, you just haven't selected it" },
    { type: "paragraph", html: "If you've bought more than one evaluation, the new account may be present but not the one currently selected. Tradovate groups accounts in a selector, usually the account dropdown near the top of the platform. A “missing” account is often just an unselected one hiding behind your other evaluations." },
    { type: "heading", text: "5. The firm hasn't activated the account or its market data" },
    { type: "paragraph", html: "Even after the account appears, two firm-controlled switches can leave it unusable. The account itself may not be fully enabled yet, and live market data on a prop or evaluation account can only be turned on by the account provider. Tradovate can't enable data on an account it doesn't own, so an account that loads with delayed or blank quotes is waiting on the firm, not on you." },
    { type: "heading", text: "How to Fix a Tradovate Eval That Won't Show: Step-by-Step" },
    { type: "heading", text: "Fixing provisioning delays (wait, then refresh)" },
    {
      type: "steps",
      items: [
        { title: "Note when you purchased", html: "Note the time you completed your purchase and signed any firm-side agreements." },
        { title: "Wait out your firm's activation window", html: "Wait out your firm's stated activation window before you touch anything else, this varies by firm, so check the confirmation email or the firm's help center for the current number." },
        { title: "Log out fully and back in", html: "Once the window has passed, fully log out of Tradovate (don't just refresh), then log back in with your prop firm credentials." },
        { title: "Relaunch or hard-refresh", html: "On the desktop or mobile app, close it completely and relaunch; on web, hard-refresh the page." },
      ],
    },
    { type: "heading", text: "Fixing an unsigned agreement" },
    {
      type: "steps",
      items: [
        { title: "Log in with prop firm credentials", html: "Log in with the credentials from your prop firm." },
        { title: "Sign the agreement", html: "When Tradovate presents the user agreement on first login, read it and electronically sign it, don't close the prompt." },
        { title: "Check the account selector", html: "After signing, check the account selector; the evaluation should now be listed as tradable." },
      ],
    },
    { type: "paragraph", html: "The exact label and placement of the agreement prompt can shift between Tradovate releases, so trust the wording on your own first-login screen rather than any fixed button name you read somewhere." },
    { type: "heading", text: "Fixing wrong-credentials and wrong-account-selected issues" },
    {
      type: "steps",
      items: [
        { title: "Copy the exact issued username", html: "Open your prop firm's member dashboard and copy the exact Tradovate username the firm issued for this evaluation." },
        { title: "Log in with firm-issued credentials only", html: "Log out of any personal Tradovate session, then log in with those firm-issued credentials only." },
        { title: "Pick the new account in the selector", html: "Open the account selector (the account dropdown near the top of the platform) and pick the new evaluation from the list. If you own several, confirm you're on the correct account number." },
      ],
    },
    { type: "heading", text: "Fixing “account still won't show” or “data not live” (contact the firm)" },
    {
      type: "steps",
      items: [
        { title: "Stop troubleshooting on the Tradovate side", html: "If the account is still missing after you've waited the full window, signed the agreement, and re-logged in, stop troubleshooting on the Tradovate side." },
        { title: "Contact your prop firm directly", html: "Contact your prop firm, the evaluation service provider, directly. They own the account and are the only ones who can create, enable, or reset it. Tradovate can help set up the initial connection but can't resolve account-specific issues on accounts it doesn't own." },
        { title: "Ask the firm to enable data", html: "For a live-data problem, ask the firm to enable market data on the account. Don't try to self-subscribe to market data on a prop or evaluation account, that path is for personally-owned Tradovate accounts, and it won't work on an eval." },
      ],
    },
    { type: "heading", text: "Troubleshooting Table" },
    {
      type: "table",
      headers: ["Symptom", "What it means", "Fix"],
      rows: [
        ["Account list empty right after purchase", "Account is still provisioning on the firm's side", "Wait out your firm's activation window, then log out and back in"],
        ["Logged in, but nothing shows to trade", "First-login user agreement not signed", "Sign the agreement Tradovate prompts on first login"],
        ["Old balances show, new eval missing", "Signed into a personal Tradovate account", "Log in with the firm-issued evaluation credentials only"],
        ["Some accounts show, the new one does not", "Wrong account selected in the dropdown", "Pick the new evaluation from the account selector"],
        ["Prompt to fund/open an account you bought", "Account not yet created or linked", "Wait for provisioning; if it persists, contact the prop firm"],
        ["Account shows but quotes are delayed/blank", "Live data not enabled by the provider", "Ask your prop firm to activate market data, do not self-subscribe"],
        ["Nothing works after the full wait", "Account-level issue only the owner can fix", "Contact your prop firm's support directly"],
      ],
    },
    { type: "heading", text: "Prevent This with PickMyTrade" },
    { type: "paragraph", html: "Once your evaluation is finally live, the last thing you want is your automation misfiring against a half-activated account. PickMyTrade sits between TradingView and Tradovate and adds guardrails that keep a fresh eval safe:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Account &amp; symbol validation</strong>, routes alerts only to the account and contract you intend, so orders never land on the wrong evaluation.",
        "<strong class='text-white'>Entitlement- and data-aware routing</strong>, respects the account's activation and data-agreement state instead of blasting orders at an account that isn't ready.",
        "<strong class='text-white'>Rate-limit-safe order flow</strong>, spaces out requests so a burst of alerts on a new account doesn't trip Tradovate's limits.",
        "<strong class='text-white'>Multi-account sync</strong>, mirror the same strategy across several evaluations once they're all provisioned, without re-wiring each one by hand.",
      ],
    },
  ], de: [
    { type: "paragraph",html: "Sie haben gerade eine frische Evaluierung bezahlt, sind startklar und melden sich bei Tradovate an, aber das Konto ist einfach nicht da. Kein Guthaben, nichts in der Kontoauswahl oder, schlimmer, ein Bildschirm, der Sie auffordert, ein Konto zu finanzieren, das Sie bereits gekauft haben. Keine Panik, und eröffnen Sie noch kein Support-Ticket. In den allermeisten Fällen wird das Konto im Hintergrund aufgebaut und ist nur Minuten entfernt, nicht verloren. Ihre Prop-Firma legt ein brandneues Evaluierungskonto an und überträgt es mit Verzögerung an Tradovate, sodass ein Konto, das direkt nach dem Checkout fehlt, fast immer ein Problem von Timing, Zugangsdaten oder Vereinbarungsunterzeichnung ist, kein defekter Kauf." },
    { type: "paragraph",html: "Im Folgenden gehen wir jeden Grund durch, warum eine frisch gekaufte Tradovate-Evaluierung nicht erscheint oder nicht aktiviert wird, in der Reihenfolge, in der Sie sie tatsächlich prüfen sollten, und zeigen, woran Sie erkennen, dass das Problem wirklich bei Ihrer Prop-Firma liegt. Und wenn Sie das Konto in der Sekunde automatisieren möchten, in der es live geht, können Sie mit einer Bridge wie PickMyTrade Ihre TradingView-Alerts im Voraus vorbereiten, damit nichts gegen ein Konto feuert, das noch nicht vollständig freigeschaltet ist." },
    {
      type: "checklist",
      heading: "Kurze Checkliste für eine fehlende Tradovate-Evaluierung",
      items: [
        "<strong class='text-white'>Geben Sie ihr Zeit zur Bereitstellung.</strong> Neue Evaluierungskonten sind nicht sofort da. Lassen Sie das gesamte Aktivierungsfenster verstreichen, bevor Sie annehmen, dass etwas nicht stimmt, es variiert je nach Firma, prüfen Sie also die aktuellen Regeln Ihrer Firma.",
        "<strong class='text-white'>Unterzeichnen Sie die Nutzervereinbarung.</strong> Beim ersten Login fordert Tradovate Sie auf, eine Vereinbarung zu prüfen und elektronisch zu unterzeichnen. Das Konto erscheint erst in Ihrer handelbaren Liste, wenn Sie es getan haben.",
        "<strong class='text-white'>Verwenden Sie die Zugangsdaten der Prop-Firma, nicht einen persönlichen Tradovate-Login.</strong> Die Anmeldung bei einem alten persönlichen Konto lässt Ihre neue Evaluierung nie erscheinen.",
        "<strong class='text-white'>Melden Sie sich vollständig ab und wieder an.</strong> Eine veraltete Sitzung braucht oft nur einen sauberen Neu-Login oder eine Browser- bzw. App-Aktualisierung, um das neu angelegte Konto abzurufen.",
        "<strong class='text-white'>Prüfen Sie das Konto-Dropdown.</strong> Besitzen Sie mehrere Evaluierungen, steht die neue möglicherweise in der Auswahl, statt zu fehlen.",
        "<strong class='text-white'>Kontaktieren Sie Ihre Prop-Firma, wenn es immer noch nicht erscheint.</strong> Tradovate besitzt keine Evaluierungskonten und kann sie weder anlegen, aktivieren noch reparieren.",
      ],
    },
    { type: "heading",text: "Was „Konto wird nicht angezeigt / nicht aktiviert“ bedeutet" },
    { type: "paragraph",html: "Es gibt keine einzige, universelle Fehlermeldung dafür, was die Verwirrung zur Hälfte erklärt. Stattdessen begegnen Sie einem von wenigen Symptomen: Sie melden sich problemlos an, aber das Konto fehlt in der Auswahl, die Plattform zeigt nichts zum Handeln an, oder Sie erhalten eine Aufforderung, ein Konto zu finanzieren oder zu eröffnen, obwohl Sie die Evaluierung bereits bezahlt haben. Alle drei deuten auf denselben Zustand hin: Tradovate hat Sie authentifiziert, aber das konkrete Evaluierungskonto wurde noch nicht angelegt, verknüpft oder vollständig für Ihren Login aktiviert." },
    { type: "paragraph",html: "Das mentale Modell, das dies klärt, ist Eigentum. Wenn Sie eine Evaluierung kaufen, legt Ihre Prop-Firma, nicht Tradovate, das Konto auf der Infrastruktur von Tradovate an und weist es Ihrem Benutzernamen zu. Tradovate ist die Plattform; die Firma ist der Kontoinhaber. Diese Übergabe braucht Zeit und hängt vollständig von der Bereitstellungswarteschlange der Firma ab. Bis das System der Firma den Aufbau des Kontos abgeschlossen hat und Sie jede erforderliche Vereinbarung erledigt haben, gibt es für Tradovate buchstäblich nichts anzuzeigen." },
    { type: "paragraph",html: "„Nicht aktiviert“ stapelt meist ein zweites Problem obendrauf. Selbst wenn das Konto erscheint, kann Live-Marktdaten bei einem Prop- oder Evaluierungskonto nur der Kontoanbieter einschalten. Ein Konto, das erscheint, aber verzögerte oder fehlende Kurse streamt, ist nicht defekt, es wartet darauf, dass die Firma Daten aktiviert, was ein separater Schritt von der Freischaltung des Kontos selbst ist." },
    { type: "heading",text: "Die häufigsten Ursachen für ein nicht angezeigtes Tradovate-Prop-Konto" },
    { type: "heading",text: "1. Es wird noch bereitgestellt (mit Abstand die häufigste Ursache)" },
    { type: "paragraph",html: "Neue Evaluierungskonten werden nach dem Kauf mit Verzögerung angelegt. Ein neues Evaluierungskonto braucht typischerweise zwischen 10 und 90 Minuten bis zur Einrichtung, sobald die erforderlichen Vereinbarungen unterzeichnet sind, und in stark frequentierten Zeiten bitten manche Firmen Käufer, mehrere Stunden einzuplanen, bevor sie ein Ticket eröffnen. Die genaue Wartezeit variiert je nach Firma und Kontogröße, prüfen Sie also die aktuellen Regeln Ihrer Firma, aber das Muster bleibt gleich: Der Kauf ist sofort abgeschlossen, das Konto nicht. Wenn Sie gerade bezahlt haben und sich sofort anmelden, ist eine leere Kontoliste zu erwarten, kein Fehler." },
    { type: "heading",text: "2. Sie haben die Nutzervereinbarung beim ersten Login nicht unterzeichnet" },
    { type: "paragraph",html: "Beim ersten Login in eine neue Evaluierung fordert Tradovate Sie auf, eine Nutzervereinbarung zu prüfen und elektronisch zu unterzeichnen. Überspringen oder schließen Sie sie, wird das Konto nicht als handelbar aufgeführt. Das bringt Leute ständig aus dem Konzept, Sie schließen das Fenster, landen auf einer leeren Plattform und schließen daraus, dass das Konto nie angekommen ist, obwohl es lediglich hinter einer nicht unterzeichneten Vereinbarung verschlossen ist." },
    { type: "heading",text: "3. Sie melden sich beim falschen Konto an" },
    { type: "paragraph",html: "Ihre Evaluierung verwendet die Zugangsdaten aus dem Dashboard Ihrer Prop-Firma, nicht ein persönliches Tradovate-Konto, das Sie früher eingerichtet haben. Die Anmeldung bei einem alten persönlichen Login (oder einer Demo, die Sie direkt bei Tradovate gestartet haben) authentifiziert problemlos und zeigt keines der Konten Ihrer Firma, weil sie an einen völlig anderen Benutzernamen gebunden sind. Melden Sie sich immer mit genau den Zugangsdaten an, die die Firma Ihnen gegeben hat." },
    { type: "heading",text: "4. Das Konto ist da, Sie haben es nur nicht ausgewählt" },
    { type: "paragraph",html: "Wenn Sie mehr als eine Evaluierung gekauft haben, ist das neue Konto möglicherweise vorhanden, aber nicht das aktuell ausgewählte. Tradovate gruppiert Konten in einer Auswahl, meist dem Konto-Dropdown oben in der Plattform. Ein „fehlendes“ Konto ist oft einfach ein nicht ausgewähltes, das sich hinter Ihren anderen Evaluierungen versteckt." },
    { type: "heading",text: "5. Die Firma hat das Konto oder seine Marktdaten nicht aktiviert" },
    { type: "paragraph",html: "Selbst nachdem das Konto erscheint, können zwei von der Firma kontrollierte Schalter es unbrauchbar lassen. Das Konto selbst ist möglicherweise noch nicht vollständig aktiviert, und Live-Marktdaten bei einem Prop- oder Evaluierungskonto kann nur der Kontoanbieter einschalten. Tradovate kann bei einem Konto, das ihm nicht gehört, keine Daten aktivieren, ein Konto, das mit verzögerten oder leeren Kursen lädt, wartet also auf die Firma, nicht auf Sie." },
    { type: "heading",text: "Eine Tradovate-Evaluierung beheben, die nicht erscheint: Schritt für Schritt" },
    { type: "heading",text: "Bereitstellungsverzögerungen beheben (warten, dann aktualisieren)" },
    {
      type: "steps",
      items: [
        { title: "Kaufzeitpunkt notieren", html: "Notieren Sie den Zeitpunkt, zu dem Sie Ihren Kauf abgeschlossen und alle firmenseitigen Vereinbarungen unterzeichnet haben." },
        { title: "Das Aktivierungsfenster Ihrer Firma abwarten", html: "Warten Sie das genannte Aktivierungsfenster Ihrer Firma ab, bevor Sie irgendetwas anderes anfassen, es variiert je nach Firma, prüfen Sie also die Bestätigungs-E-Mail oder das Help Center der Firma auf die aktuelle Angabe." },
        { title: "Vollständig ab- und wieder anmelden", html: "Sobald das Fenster verstrichen ist, melden Sie sich vollständig von Tradovate ab (nicht nur aktualisieren) und dann mit den Zugangsdaten Ihrer Prop-Firma wieder an." },
        { title: "Neu starten oder hart aktualisieren", html: "Schließen Sie bei der Desktop- oder Mobil-App diese vollständig und starten Sie sie neu; aktualisieren Sie im Web die Seite hart." },
      ],
    },
    { type: "heading",text: "Eine nicht unterzeichnete Vereinbarung beheben" },
    {
      type: "steps",
      items: [
        { title: "Mit Prop-Firmen-Zugangsdaten anmelden", html: "Melden Sie sich mit den Zugangsdaten Ihrer Prop-Firma an." },
        { title: "Die Vereinbarung unterzeichnen", html: "Wenn Tradovate beim ersten Login die Nutzervereinbarung anzeigt, lesen Sie sie und unterzeichnen Sie sie elektronisch, schließen Sie die Aufforderung nicht." },
        { title: "Die Kontoauswahl prüfen", html: "Prüfen Sie nach der Unterzeichnung die Kontoauswahl; die Evaluierung sollte nun als handelbar aufgeführt sein." },
      ],
    },
    { type: "paragraph",html: "Die genaue Bezeichnung und Platzierung der Vereinbarungsaufforderung kann sich zwischen Tradovate-Versionen ändern. Vertrauen Sie also dem Wortlaut auf Ihrem eigenen Erst-Login-Bildschirm statt einem festen Button-Namen, den Sie irgendwo gelesen haben." },
    { type: "heading",text: "Falsche Zugangsdaten und falsch ausgewähltes Konto beheben" },
    {
      type: "steps",
      items: [
        { title: "Den exakten ausgestellten Benutzernamen kopieren", html: "Öffnen Sie das Mitglieder-Dashboard Ihrer Prop-Firma und kopieren Sie den exakten Tradovate-Benutzernamen, den die Firma für diese Evaluierung ausgestellt hat." },
        { title: "Nur mit von der Firma ausgestellten Zugangsdaten anmelden", html: "Melden Sie sich von jeder persönlichen Tradovate-Sitzung ab und dann ausschließlich mit diesen von der Firma ausgestellten Zugangsdaten an." },
        { title: "Das neue Konto in der Auswahl wählen", html: "Öffnen Sie die Kontoauswahl (das Konto-Dropdown oben in der Plattform) und wählen Sie die neue Evaluierung aus der Liste. Besitzen Sie mehrere, bestätigen Sie, dass Sie auf der richtigen Kontonummer sind." },
      ],
    },
    { type: "heading",text: "„Konto erscheint immer noch nicht“ oder „Daten nicht live“ beheben (Firma kontaktieren)" },
    {
      type: "steps",
      items: [
        { title: "Die Fehlersuche auf Tradovate-Seite beenden", html: "Ist das Konto auch nach Abwarten des gesamten Fensters, Unterzeichnung der Vereinbarung und erneuter Anmeldung noch nicht da, beenden Sie die Fehlersuche auf Tradovate-Seite." },
        { title: "Die Prop-Firma direkt kontaktieren", html: "Kontaktieren Sie direkt Ihre Prop-Firma, den Evaluierungsdienstleister. Sie besitzt das Konto und kann es als Einzige anlegen, aktivieren oder zurücksetzen. Tradovate kann bei der ersten Verbindung helfen, aber keine kontospezifischen Probleme bei Konten lösen, die ihm nicht gehören." },
        { title: "Die Firma bitten, Daten zu aktivieren", html: "Bei einem Live-Daten-Problem bitten Sie die Firma, Marktdaten auf dem Konto zu aktivieren. Versuchen Sie nicht, bei einem Prop- oder Evaluierungskonto Marktdaten selbst zu abonnieren, dieser Weg ist für persönlich geführte Tradovate-Konten gedacht und funktioniert bei einer Evaluierung nicht." },
      ],
    },
    { type: "heading",text: "Tabelle zur Fehlerbehebung" },
    { type: "table", headers: ["Symptom","Bedeutung","Lösung"], rows: [
      ["Kontoliste direkt nach dem Kauf leer","Das Konto wird auf Seiten der Firma noch bereitgestellt","Aktivierungsfenster der Firma abwarten, dann ab- und wieder anmelden"],
      ["Angemeldet, aber nichts zum Handeln sichtbar","Nutzervereinbarung beim ersten Login nicht unterzeichnet","Die von Tradovate beim ersten Login angezeigte Vereinbarung unterzeichnen"],
      ["Alte Salden werden angezeigt, die neue Evaluierung fehlt","Bei einem persönlichen Tradovate-Konto angemeldet","Nur mit den von der Firma ausgestellten Evaluierungs-Zugangsdaten anmelden"],
      ["Einige Konten erscheinen, das neue nicht","Falsches Konto im Dropdown ausgewählt","Die neue Evaluierung in der Kontoauswahl wählen"],
      ["Aufforderung, ein gekauftes Konto zu finanzieren/zu eröffnen","Konto noch nicht angelegt oder verknüpft","Auf die Bereitstellung warten; besteht das Problem weiter, die Prop-Firma kontaktieren"],
      ["Konto erscheint, aber Kurse sind verzögert/leer","Live-Daten vom Anbieter nicht aktiviert","Ihre Prop-Firma bitten, Marktdaten zu aktivieren, nicht selbst abonnieren"],
      ["Nach der gesamten Wartezeit funktioniert nichts","Ein Problem auf Kontoebene, das nur der Inhaber beheben kann","Den Support Ihrer Prop-Firma direkt kontaktieren"],
    ] },
    { type: "heading",text: "Vorbeugen mit PickMyTrade" },
    { type: "paragraph",html: "Sobald Ihre Evaluierung endlich live ist, wollen Sie am wenigsten, dass Ihre Automatisierung gegen ein halb aktiviertes Konto fehlzündet. PickMyTrade sitzt zwischen TradingView und Tradovate und fügt Leitplanken hinzu, die eine frische Evaluierung schützen:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Konto- &amp; Symbolvalidierung</strong>, routet Alerts nur an das Konto und den Kontrakt, die Sie beabsichtigen, damit Orders nie auf der falschen Evaluierung landen.",
        "<strong class='text-white'>Berechtigungs- und datenbewusstes Routing</strong>, respektiert den Aktivierungs- und Datenvereinbarungsstatus des Kontos, statt Orders auf ein Konto abzufeuern, das noch nicht bereit ist.",
        "<strong class='text-white'>Ratenlimit-sicherer Orderfluss</strong>, verteilt Anfragen, damit ein Schwall an Alerts auf einem neuen Konto nicht die Limits von Tradovate auslöst.",
        "<strong class='text-white'>Multi-Account-Sync</strong>, spiegeln Sie dieselbe Strategie auf mehrere Evaluierungen, sobald alle bereitgestellt sind, ohne jede von Hand neu zu verdrahten.",
      ],
    },
  ], es: [
    { type: "paragraph",html: "Acaba de pagar una evaluación nueva, está listo para operar e inicia sesión en Tradovate, pero la cuenta simplemente no está. Sin saldo, nada en el selector de cuentas o, peor aún, una pantalla que le insiste en financiar una cuenta que ya compró. No entre en pánico y no envíe todavía un ticket de soporte. En la gran mayoría de los casos la cuenta se está creando en segundo plano y está a minutos de aparecer, no perdida. Su firma prop crea una cuenta de evaluación nueva y la envía a Tradovate con retraso, así que una cuenta que falta justo después del pago casi siempre es un problema de tiempo, credenciales o firma del acuerdo, no una compra fallida." },
    { type: "paragraph",html: "A continuación repasamos todas las razones por las que una evaluación de Tradovate recién comprada no aparece o no se activa, en el orden en que realmente debe comprobarlas, además de cómo saber cuándo el problema está de verdad en el lado de su firma prop. Y si planea automatizar esa cuenta en el segundo en que se active, un puente como PickMyTrade le permite preparar sus alertas de TradingView con antelación para que nada se dispare contra una cuenta que aún no está totalmente activada." },
    {
      type: "checklist",
      heading: "Lista rápida para una evaluación de Tradovate que no aparece",
      items: [
        "<strong class='text-white'>Dele tiempo para aprovisionarse.</strong> Las cuentas de evaluación nuevas no son instantáneas. Deje pasar toda la ventana de activación antes de asumir que algo va mal, varía según la firma, así que consulte las reglas vigentes de la suya.",
        "<strong class='text-white'>Firme el acuerdo de usuario.</strong> En su primer acceso, Tradovate le pide que revise y firme electrónicamente un acuerdo. La cuenta no aparecerá en su lista operable hasta que lo haga.",
        "<strong class='text-white'>Use las credenciales de la firma prop, no un acceso personal de Tradovate.</strong> Iniciar sesión en una cuenta personal antigua nunca hará aparecer su nueva evaluación.",
        "<strong class='text-white'>Cierre sesión por completo y vuelva a entrar.</strong> Una sesión obsoleta a menudo solo necesita un nuevo inicio de sesión limpio, o una actualización del navegador o de la app, para cargar la cuenta recién creada.",
        "<strong class='text-white'>Revise el desplegable de cuentas.</strong> Si tiene varias evaluaciones, la nueva puede estar en el selector en lugar de faltar.",
        "<strong class='text-white'>Contacte con su firma prop si sigue sin aparecer.</strong> Tradovate no es dueña de las cuentas de evaluación y no puede crearlas, habilitarlas ni repararlas.",
      ],
    },
    { type: "heading",text: "Qué significa “Cuenta sin aparecer / sin activar”" },
    { type: "paragraph",html: "No existe una única cadena de error universal para esto, lo que explica la mitad de la confusión. En su lugar se topa con uno de unos pocos síntomas: inicia sesión sin problema pero la cuenta no está en el selector, la plataforma no muestra nada para operar, o recibe un aviso para financiar o abrir una cuenta aunque ya pagó una evaluación. Los tres apuntan al mismo estado subyacente: Tradovate lo ha autenticado, pero la cuenta de evaluación concreta aún no se ha creado, vinculado ni activado por completo con su acceso." },
    { type: "paragraph",html: "El modelo mental que lo aclara es la propiedad. Cuando compra una evaluación, su firma prop, no Tradovate, crea la cuenta en la infraestructura de Tradovate y se la concede a su usuario. Tradovate es la plataforma; la firma es la titular de la cuenta. Ese traspaso lleva tiempo y depende por completo de la cola de aprovisionamiento de la firma. Hasta que el sistema de la firma termine de construir la cuenta y usted haya completado cualquier acuerdo requerido, literalmente no hay nada que Tradovate pueda mostrar." },
    { type: "paragraph",html: "“Sin activar” suele añadir un segundo problema encima. Incluso cuando la cuenta aparece, los datos de mercado en vivo en una cuenta prop o de evaluación solo puede activarlos el proveedor de la cuenta. Una cuenta que aparece pero transmite cotizaciones retrasadas o ausentes no está rota, está esperando a que la firma active los datos, un paso distinto de que la propia cuenta se active." },
    { type: "heading",text: "Principales causas de que una cuenta prop de Tradovate no aparezca" },
    { type: "heading",text: "1. Aún se está aprovisionando (con diferencia la causa más común)" },
    { type: "paragraph",html: "Las cuentas de evaluación nuevas se crean con retraso tras la compra. Una cuenta de evaluación nueva suele tardar entre 10 y 90 minutos en configurarse una vez firmados los acuerdos necesarios y, en periodos de mucha carga, algunas firmas piden a los compradores que esperen varias horas antes de abrir un ticket. La espera exacta varía según la firma y el tamaño de la cuenta, así que consulte las reglas vigentes de la suya, pero el patrón no cambia: la compra se completa al instante, la cuenta no. Si acaba de pagar e inicia sesión de inmediato, una lista de cuentas en blanco es lo esperado, no un error." },
    { type: "heading",text: "2. No ha firmado el acuerdo de usuario del primer acceso" },
    { type: "paragraph",html: "En el primer acceso a una evaluación nueva, Tradovate le pide que revise y firme electrónicamente un acuerdo de usuario. Si lo omite o lo descarta, la cuenta no figurará como operable. Esto confunde constantemente a la gente: cierra la ventana, aterriza en una plataforma vacía y concluye que la cuenta nunca llegó, cuando simplemente está bloqueada tras un acuerdo sin firmar." },
    { type: "heading",text: "3. Está iniciando sesión en la cuenta equivocada" },
    { type: "paragraph",html: "Su evaluación usa las credenciales emitidas en el panel de su firma prop, no ninguna cuenta personal de Tradovate que configurara antes. Iniciar sesión en un acceso personal antiguo (o en una demo que abrió directamente con Tradovate) se autentica sin problema y no muestra ninguna de las cuentas de su firma, porque están asociadas a un usuario completamente distinto. Inicie siempre sesión con las credenciales exactas que le dio la firma." },
    { type: "heading",text: "4. La cuenta está ahí, solo que no la ha seleccionado" },
    { type: "paragraph",html: "Si ha comprado más de una evaluación, la nueva puede estar presente pero no ser la seleccionada actualmente. Tradovate agrupa las cuentas en un selector, normalmente el desplegable de cuentas en la parte superior de la plataforma. Una cuenta “perdida” suele ser simplemente una cuenta sin seleccionar escondida tras sus otras evaluaciones." },
    { type: "heading",text: "5. La firma no ha activado la cuenta ni sus datos de mercado" },
    { type: "paragraph",html: "Incluso después de que la cuenta aparezca, dos interruptores controlados por la firma pueden dejarla inutilizable. Puede que la propia cuenta aún no esté totalmente habilitada, y los datos de mercado en vivo en una cuenta prop o de evaluación solo puede activarlos el proveedor de la cuenta. Tradovate no puede habilitar datos en una cuenta que no le pertenece, así que una cuenta que carga con cotizaciones retrasadas o en blanco está esperando a la firma, no a usted." },
    { type: "heading",text: "Cómo corregir una evaluación de Tradovate que no aparece: paso a paso" },
    { type: "heading",text: "Corregir retrasos de aprovisionamiento (esperar y luego actualizar)" },
    {
      type: "steps",
      items: [
        { title: "Anote cuándo compró", html: "Anote la hora en que completó su compra y firmó cualquier acuerdo del lado de la firma." },
        { title: "Espere la ventana de activación de su firma", html: "Espere la ventana de activación indicada por su firma antes de tocar nada más, varía según la firma, así que consulte el correo de confirmación o el centro de ayuda de la firma para la cifra vigente." },
        { title: "Cierre sesión por completo y vuelva a entrar", html: "Una vez pasada la ventana, cierre sesión por completo en Tradovate (no se limite a actualizar) y vuelva a iniciar sesión con las credenciales de su firma prop." },
        { title: "Reinicie o actualice de forma forzada", html: "En la app de escritorio o móvil, ciérrela por completo y reinícielo; en la web, actualice la página de forma forzada." },
      ],
    },
    { type: "heading",text: "Corregir un acuerdo sin firmar" },
    {
      type: "steps",
      items: [
        { title: "Inicie sesión con las credenciales de la firma prop", html: "Inicie sesión con las credenciales de su firma prop." },
        { title: "Firme el acuerdo", html: "Cuando Tradovate presente el acuerdo de usuario en el primer acceso, léalo y fírmelo electrónicamente, no cierre el aviso." },
        { title: "Revise el selector de cuentas", html: "Tras firmar, revise el selector de cuentas; la evaluación debería figurar ahora como operable." },
      ],
    },
    { type: "paragraph",html: "La etiqueta y la ubicación exactas del aviso del acuerdo pueden cambiar entre versiones de Tradovate, así que fíese del texto de su propia pantalla de primer acceso y no de un nombre de botón fijo que haya leído en otro sitio." },
    { type: "heading",text: "Corregir problemas de credenciales equivocadas y cuenta equivocada seleccionada" },
    {
      type: "steps",
      items: [
        { title: "Copie el usuario exacto emitido", html: "Abra el panel de miembros de su firma prop y copie el usuario de Tradovate exacto que la firma emitió para esta evaluación." },
        { title: "Inicie sesión solo con las credenciales emitidas por la firma", html: "Cierre sesión de cualquier sesión personal de Tradovate y luego inicie sesión únicamente con esas credenciales emitidas por la firma." },
        { title: "Elija la cuenta nueva en el selector", html: "Abra el selector de cuentas (el desplegable de cuentas en la parte superior de la plataforma) y elija la nueva evaluación de la lista. Si tiene varias, confirme que está en el número de cuenta correcto." },
      ],
    },
    { type: "heading",text: "Corregir “la cuenta sigue sin aparecer” o “datos no en vivo” (contacte con la firma)" },
    {
      type: "steps",
      items: [
        { title: "Deje de resolver problemas en el lado de Tradovate", html: "Si la cuenta sigue sin aparecer después de esperar toda la ventana, firmar el acuerdo y volver a iniciar sesión, deje de resolver problemas en el lado de Tradovate." },
        { title: "Contacte directamente con su firma prop", html: "Contacte directamente con su firma prop, el proveedor del servicio de evaluación. Es dueña de la cuenta y la única que puede crearla, habilitarla o restablecerla. Tradovate puede ayudar a configurar la conexión inicial, pero no puede resolver problemas específicos de cuentas que no le pertenecen." },
        { title: "Pida a la firma que active los datos", html: "Para un problema de datos en vivo, pida a la firma que active los datos de mercado en la cuenta. No intente suscribirse por su cuenta a datos de mercado en una cuenta prop o de evaluación, esa vía es para cuentas de Tradovate de titularidad personal y no funcionará en una evaluación." },
      ],
    },
    { type: "heading",text: "Tabla de resolución de problemas" },
    { type: "table", headers: ["Síntoma","Qué significa","Solución"], rows: [
      ["Lista de cuentas vacía justo después de la compra","La cuenta aún se está aprovisionando en el lado de la firma","Espere la ventana de activación de la firma y luego cierre sesión y vuelva a entrar"],
      ["Ha iniciado sesión, pero no hay nada para operar","Acuerdo de usuario del primer acceso sin firmar","Firme el acuerdo que Tradovate presenta en el primer acceso"],
      ["Aparecen saldos antiguos, falta la nueva evaluación","Ha iniciado sesión en una cuenta personal de Tradovate","Inicie sesión solo con las credenciales de evaluación emitidas por la firma"],
      ["Aparecen algunas cuentas, la nueva no","Cuenta equivocada seleccionada en el desplegable","Elija la nueva evaluación en el selector de cuentas"],
      ["Aviso para financiar/abrir una cuenta que ya compró","Cuenta aún no creada o vinculada","Espere al aprovisionamiento; si persiste, contacte con la firma prop"],
      ["La cuenta aparece pero las cotizaciones están retrasadas/en blanco","Datos en vivo no activados por el proveedor","Pida a su firma prop que active los datos de mercado, no se suscriba por su cuenta"],
      ["Nada funciona tras la espera completa","Problema a nivel de cuenta que solo el titular puede resolver","Contacte directamente con el soporte de su firma prop"],
    ] },
    { type: "heading",text: "Prevéngalo con PickMyTrade" },
    { type: "paragraph",html: "Cuando su evaluación por fin está activa, lo último que quiere es que su automatización falle contra una cuenta a medio activar. PickMyTrade se sitúa entre TradingView y Tradovate y añade salvaguardas que mantienen segura una evaluación recién activada:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Validación de cuenta &amp; símbolo</strong>, enruta las alertas solo a la cuenta y al contrato que pretende, para que las órdenes nunca aterricen en la evaluación equivocada.",
        "<strong class='text-white'>Enrutamiento consciente de autorizaciones y datos</strong>, respeta el estado de activación y de acuerdo de datos de la cuenta en lugar de disparar órdenes contra una cuenta que no está lista.",
        "<strong class='text-white'>Flujo de órdenes seguro frente a límites de tasa</strong>, espacia las peticiones para que una ráfaga de alertas en una cuenta nueva no active los límites de Tradovate.",
        "<strong class='text-white'>Sincronización multicuenta</strong>, replique la misma estrategia en varias evaluaciones cuando todas estén aprovisionadas, sin reconfigurar cada una a mano.",
      ],
    },
  ], fr: [
    { type: "paragraph",html: "Vous venez de payer une évaluation toute neuve, vous êtes prêt à trader et vous vous connectez à Tradovate, mais le compte n'est tout simplement pas là. Pas de solde, rien dans le sélecteur de comptes, ou pire, un écran qui vous presse de financer un compte que vous avez déjà acheté. Pas de panique, et n'ouvrez pas encore de ticket de support. Dans la grande majorité des cas, le compte est en cours de création en arrière-plan et n'est qu'à quelques minutes, pas perdu. Votre firme prop crée un compte d'évaluation tout neuf et le transmet à Tradovate avec un délai : un compte absent juste après le paiement relève donc presque toujours d'un problème de délai, d'identifiants ou de signature d'accord, et non d'un achat défaillant." },
    { type: "paragraph",html: "Ci-dessous, nous passons en revue toutes les raisons pour lesquelles une évaluation Tradovate fraîchement achetée n'apparaît pas ou ne s'active pas, dans l'ordre où vous devriez réellement les vérifier, ainsi que la façon de savoir quand le problème se situe véritablement du côté de votre firme prop. Et si vous prévoyez d'automatiser ce compte à la seconde où il passe en direct, un pont comme PickMyTrade vous permet de préparer vos alertes TradingView à l'avance pour que rien ne se déclenche sur un compte qui n'est pas encore entièrement activé." },
    {
      type: "checklist",
      heading: "Liste de contrôle rapide pour une évaluation Tradovate manquante",
      items: [
        "<strong class='text-white'>Laissez-lui le temps d'être provisionnée.</strong> Les nouveaux comptes d'évaluation ne sont pas instantanés. Laissez s'écouler toute la fenêtre d'activation avant de supposer que quelque chose ne va pas ; elle varie selon la firme, vérifiez donc les règles en vigueur de la vôtre.",
        "<strong class='text-white'>Signez l'accord utilisateur.</strong> À votre première connexion, Tradovate vous demande de lire et de signer électroniquement un accord. Le compte n'apparaîtra pas dans votre liste négociable tant que vous ne l'aurez pas fait.",
        "<strong class='text-white'>Utilisez les identifiants de la firme prop, pas une connexion Tradovate personnelle.</strong> Se connecter à un ancien compte personnel ne fera jamais apparaître votre nouvelle évaluation.",
        "<strong class='text-white'>Déconnectez-vous complètement puis reconnectez-vous.</strong> Une session périmée a souvent juste besoin d'une reconnexion propre, ou d'une actualisation du navigateur ou de l'application, pour récupérer le compte nouvellement créé.",
        "<strong class='text-white'>Vérifiez la liste déroulante des comptes.</strong> Si vous possédez plusieurs évaluations, la nouvelle est peut-être dans le sélecteur plutôt qu'absente.",
        "<strong class='text-white'>Contactez votre firme prop si elle n'apparaît toujours pas.</strong> Tradovate ne possède pas les comptes d'évaluation et ne peut ni les créer, ni les activer, ni les réparer.",
      ],
    },
    { type: "heading",text: "Ce que signifie « Compte absent / non activé »" },
    { type: "paragraph",html: "Il n'existe pas de message d'erreur unique et universel pour cela, ce qui explique la moitié de la confusion. Vous rencontrez plutôt l'un de quelques symptômes : vous vous connectez sans problème mais le compte est absent du sélecteur, la plateforme n'affiche rien à trader, ou vous recevez une invite à financer ou à ouvrir un compte alors que vous avez déjà payé une évaluation. Les trois renvoient au même état sous-jacent : Tradovate vous a authentifié, mais le compte d'évaluation précis n'a pas encore été créé, lié ou entièrement activé pour votre connexion." },
    { type: "paragraph",html: "Le modèle mental qui éclaircit tout cela est la propriété. Lorsque vous achetez une évaluation, c'est votre firme prop, et non Tradovate, qui crée le compte sur l'infrastructure de Tradovate et l'attribue à votre identifiant. Tradovate est la plateforme ; la firme est le propriétaire du compte. Ce transfert prend du temps et dépend entièrement de la file de provisionnement de la firme. Tant que le système de la firme n'a pas fini de construire le compte et que vous n'avez pas finalisé l'accord requis, il n'y a littéralement rien que Tradovate puisse afficher." },
    { type: "paragraph",html: "« Non activé » superpose généralement un second problème. Même une fois le compte apparu, les données de marché en direct sur un compte prop ou d'évaluation ne peuvent être activées que par le fournisseur du compte. Un compte qui apparaît mais diffuse des cotations retardées ou absentes n'est pas cassé : il attend que la firme active les données, une étape distincte de la mise en service du compte lui-même." },
    { type: "heading",text: "Principales causes d'un compte prop Tradovate qui n'apparaît pas" },
    { type: "heading",text: "1. Il est encore en cours de provisionnement (de loin la cause la plus fréquente)" },
    { type: "paragraph",html: "Les nouveaux comptes d'évaluation sont créés avec un délai après l'achat. Un nouveau compte d'évaluation met généralement entre 10 et 90 minutes à être configuré une fois les accords requis signés, et lors des périodes chargées, certaines firmes demandent aux acheteurs de patienter plusieurs heures avant d'ouvrir un ticket. L'attente exacte varie selon la firme et la taille du compte ; vérifiez donc les règles en vigueur de la vôtre, mais le schéma ne change jamais : l'achat se termine instantanément, le compte non. Si vous venez de payer et vous êtes connecté immédiatement, une liste de comptes vide est normale, pas un bug." },
    { type: "heading",text: "2. Vous n'avez pas signé l'accord utilisateur de première connexion" },
    { type: "paragraph",html: "À votre première connexion à une nouvelle évaluation, Tradovate vous invite à lire et à signer électroniquement un accord utilisateur. Si vous l'ignorez ou le fermez, le compte ne sera pas répertorié comme négociable. Cela piège constamment les gens : vous fermez la fenêtre, arrivez sur une plateforme vide et concluez que le compte n'est jamais arrivé, alors qu'il est simplement bloqué derrière un accord non signé." },
    { type: "heading",text: "3. Vous vous connectez au mauvais compte" },
    { type: "paragraph",html: "Votre évaluation utilise les identifiants émis dans le tableau de bord de votre firme prop, pas un compte Tradovate personnel que vous auriez créé auparavant. Se connecter à une ancienne connexion personnelle (ou à une démo démarrée directement chez Tradovate) s'authentifie très bien et n'affiche aucun des comptes de votre firme, car ils sont rattachés à un identifiant complètement différent. Connectez-vous toujours avec les identifiants exacts que la firme vous a donnés." },
    { type: "heading",text: "4. Le compte est là, vous ne l'avez simplement pas sélectionné" },
    { type: "paragraph",html: "Si vous avez acheté plus d'une évaluation, le nouveau compte peut être présent sans être celui actuellement sélectionné. Tradovate regroupe les comptes dans un sélecteur, généralement la liste déroulante des comptes en haut de la plateforme. Un compte « manquant » est souvent simplement un compte non sélectionné caché derrière vos autres évaluations." },
    { type: "heading",text: "5. La firme n'a pas activé le compte ni ses données de marché" },
    { type: "paragraph",html: "Même une fois le compte apparu, deux interrupteurs contrôlés par la firme peuvent le laisser inutilisable. Le compte lui-même peut ne pas être encore entièrement activé, et les données de marché en direct sur un compte prop ou d'évaluation ne peuvent être activées que par le fournisseur du compte. Tradovate ne peut pas activer les données sur un compte qui ne lui appartient pas : un compte qui se charge avec des cotations retardées ou vides attend donc la firme, pas vous." },
    { type: "heading",text: "Comment corriger une évaluation Tradovate qui n'apparaît pas : pas à pas" },
    { type: "heading",text: "Corriger les délais de provisionnement (attendre, puis actualiser)" },
    {
      type: "steps",
      items: [
        { title: "Notez le moment de l'achat", html: "Notez l'heure à laquelle vous avez finalisé votre achat et signé les éventuels accords côté firme." },
        { title: "Attendez la fenêtre d'activation de votre firme", html: "Attendez la fenêtre d'activation annoncée par votre firme avant de toucher à quoi que ce soit d'autre ; elle varie selon la firme, consultez donc l'e-mail de confirmation ou le centre d'aide de la firme pour le chiffre en vigueur." },
        { title: "Déconnectez-vous complètement puis reconnectez-vous", html: "Une fois la fenêtre écoulée, déconnectez-vous complètement de Tradovate (ne vous contentez pas d'actualiser), puis reconnectez-vous avec les identifiants de votre firme prop." },
        { title: "Relancez ou actualisez de force", html: "Sur l'application de bureau ou mobile, fermez-la complètement et relancez-la ; sur le web, actualisez la page de force." },
      ],
    },
    { type: "heading",text: "Corriger un accord non signé" },
    {
      type: "steps",
      items: [
        { title: "Connectez-vous avec les identifiants de la firme prop", html: "Connectez-vous avec les identifiants de votre firme prop." },
        { title: "Signez l'accord", html: "Lorsque Tradovate présente l'accord utilisateur à la première connexion, lisez-le et signez-le électroniquement, ne fermez pas l'invite." },
        { title: "Vérifiez le sélecteur de comptes", html: "Après la signature, vérifiez le sélecteur de comptes ; l'évaluation devrait désormais être répertoriée comme négociable." },
      ],
    },
    { type: "paragraph",html: "Le libellé exact et l'emplacement de l'invite d'accord peuvent changer d'une version de Tradovate à l'autre : fiez-vous donc au texte de votre propre écran de première connexion plutôt qu'à un nom de bouton fixe lu ailleurs." },
    { type: "heading",text: "Corriger les problèmes d'identifiants erronés et de compte mal sélectionné" },
    {
      type: "steps",
      items: [
        { title: "Copiez l'identifiant exact émis", html: "Ouvrez l'espace membre de votre firme prop et copiez l'identifiant Tradovate exact que la firme a émis pour cette évaluation." },
        { title: "Connectez-vous uniquement avec les identifiants émis par la firme", html: "Déconnectez-vous de toute session Tradovate personnelle, puis connectez-vous uniquement avec ces identifiants émis par la firme." },
        { title: "Choisissez le nouveau compte dans le sélecteur", html: "Ouvrez le sélecteur de comptes (la liste déroulante des comptes en haut de la plateforme) et choisissez la nouvelle évaluation dans la liste. Si vous en possédez plusieurs, vérifiez que vous êtes sur le bon numéro de compte." },
      ],
    },
    { type: "heading",text: "Corriger « le compte n'apparaît toujours pas » ou « données non en direct » (contactez la firme)" },
    {
      type: "steps",
      items: [
        { title: "Cessez le dépannage côté Tradovate", html: "Si le compte est toujours absent après avoir attendu toute la fenêtre, signé l'accord et vous être reconnecté, cessez le dépannage côté Tradovate." },
        { title: "Contactez directement votre firme prop", html: "Contactez directement votre firme prop, le prestataire du service d'évaluation. Elle possède le compte et est la seule à pouvoir le créer, l'activer ou le réinitialiser. Tradovate peut aider à établir la connexion initiale, mais ne peut pas résoudre les problèmes propres à un compte qui ne lui appartient pas." },
        { title: "Demandez à la firme d'activer les données", html: "Pour un problème de données en direct, demandez à la firme d'activer les données de marché sur le compte. N'essayez pas de souscrire vous-même aux données de marché sur un compte prop ou d'évaluation : cette voie est réservée aux comptes Tradovate détenus personnellement et ne fonctionnera pas sur une évaluation." },
      ],
    },
    { type: "heading",text: "Tableau de dépannage" },
    { type: "table", headers: ["Symptôme","Signification","Solution"], rows: [
      ["Liste de comptes vide juste après l'achat","Le compte est encore en cours de provisionnement côté firme","Attendez la fenêtre d'activation de la firme, puis déconnectez-vous et reconnectez-vous"],
      ["Connecté, mais rien à trader","Accord utilisateur de première connexion non signé","Signez l'accord que Tradovate présente à la première connexion"],
      ["Anciens soldes affichés, nouvelle évaluation absente","Connecté à un compte Tradovate personnel","Connectez-vous uniquement avec les identifiants d'évaluation émis par la firme"],
      ["Certains comptes s'affichent, pas le nouveau","Mauvais compte sélectionné dans la liste déroulante","Choisissez la nouvelle évaluation dans le sélecteur de comptes"],
      ["Invite à financer/ouvrir un compte déjà acheté","Compte pas encore créé ou lié","Attendez le provisionnement ; si cela persiste, contactez la firme prop"],
      ["Le compte s'affiche mais les cotations sont retardées/vides","Données en direct non activées par le fournisseur","Demandez à votre firme prop d'activer les données de marché, ne souscrivez pas vous-même"],
      ["Rien ne fonctionne après toute l'attente","Problème au niveau du compte que seul le propriétaire peut corriger","Contactez directement le support de votre firme prop"],
    ] },
    { type: "heading",text: "Évitez cela avec PickMyTrade" },
    { type: "paragraph",html: "Une fois votre évaluation enfin active, la dernière chose que vous voulez, c'est que votre automatisation se déclenche à tort sur un compte à moitié activé. PickMyTrade se place entre TradingView et Tradovate et ajoute des garde-fous qui protègent une évaluation toute neuve :" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Validation du compte &amp; du symbole</strong>, route les alertes uniquement vers le compte et le contrat visés, pour que les ordres n'atterrissent jamais sur la mauvaise évaluation.",
        "<strong class='text-white'>Routage conscient des droits d'accès et des données</strong>, respecte l'état d'activation et d'accord de données du compte au lieu de lancer des ordres sur un compte qui n'est pas prêt.",
        "<strong class='text-white'>Flux d'ordres compatible avec les limites de débit</strong>, espace les requêtes pour qu'une rafale d'alertes sur un nouveau compte ne déclenche pas les limites de Tradovate.",
        "<strong class='text-white'>Synchronisation multi-comptes</strong>, reproduisez la même stratégie sur plusieurs évaluations une fois qu'elles sont toutes provisionnées, sans tout recâbler à la main.",
      ],
    },
  ], it: [
    { type: "paragraph",html: "Ha appena pagato una valutazione nuova, è pronto a operare e accede a Tradovate, ma il conto semplicemente non c'è. Nessun saldo, niente nel selettore dei conti o, peggio, una schermata che la sollecita a finanziare un conto che ha già acquistato. Niente panico, e non apra ancora un ticket di supporto. Nella stragrande maggioranza dei casi il conto viene creato in background ed è a pochi minuti di distanza, non perso. La sua società prop crea un conto di valutazione nuovo e lo trasmette a Tradovate con un ritardo, quindi un conto che manca subito dopo il checkout è quasi sempre un problema di tempistica, credenziali o firma dell'accordo, non un acquisto fallito." },
    { type: "paragraph",html: "Di seguito esaminiamo ogni motivo per cui una valutazione Tradovate appena acquistata non compare o non si attiva, nell'ordine in cui dovrebbe effettivamente controllarli, oltre a come capire quando il problema è davvero lato società prop. E se intende automatizzare quel conto nell'istante in cui va live, un bridge come PickMyTrade le consente di preparare in anticipo i suoi alert TradingView così che nulla parta contro un conto non ancora completamente attivato." },
    {
      type: "checklist",
      heading: "Checklist rapida per una valutazione Tradovate che non compare",
      items: [
        "<strong class='text-white'>Le dia il tempo di essere configurata.</strong> I nuovi conti di valutazione non sono istantanei. Lasci trascorrere l'intera finestra di attivazione prima di presumere che qualcosa non vada; varia da società a società, quindi verifichi le regole attuali della sua.",
        "<strong class='text-white'>Firmi l'accordo utente.</strong> Al primo accesso, Tradovate le chiede di rivedere e firmare elettronicamente un accordo. Il conto non comparirà nel suo elenco operativo finché non lo avrà fatto.",
        "<strong class='text-white'>Usi le credenziali della società prop, non un login Tradovate personale.</strong> Accedere a un vecchio conto personale non farà mai comparire la sua nuova valutazione.",
        "<strong class='text-white'>Esca completamente e rientri.</strong> Una sessione obsoleta spesso richiede solo un nuovo accesso pulito, o un aggiornamento del browser o dell'app, per recuperare il conto appena creato.",
        "<strong class='text-white'>Controlli il menu a tendina dei conti.</strong> Se possiede più valutazioni, la nuova potrebbe trovarsi nel selettore invece di mancare.",
        "<strong class='text-white'>Contatti la sua società prop se continua a non comparire.</strong> Tradovate non possiede i conti di valutazione e non può né crearli, né abilitarli, né ripararli.",
      ],
    },
    { type: "heading",text: "Che cosa significa “Conto non visibile / non attivato”" },
    { type: "paragraph",html: "Non esiste un'unica stringa di errore universale per questo, il che spiega metà della confusione. Si incappa invece in uno di pochi sintomi: accede senza problemi ma il conto è assente dal selettore, la piattaforma non mostra nulla da operare, oppure riceve un messaggio per finanziare o aprire un conto anche se ha già pagato una valutazione. Tutti e tre indicano lo stesso stato sottostante: Tradovate l'ha autenticata, ma lo specifico conto di valutazione non è ancora stato creato, collegato o completamente attivato per il suo login." },
    { type: "paragraph",html: "Il modello mentale che chiarisce la questione è la proprietà. Quando acquista una valutazione, è la sua società prop, non Tradovate, a creare il conto sull'infrastruttura di Tradovate e ad assegnarlo al suo nome utente. Tradovate è la piattaforma; la società è la titolare del conto. Questo passaggio richiede tempo e dipende interamente dalla coda di provisioning della società. Finché il sistema della società non ha finito di costruire il conto e lei non ha completato ogni accordo richiesto, non c'è letteralmente nulla che Tradovate possa mostrare." },
    { type: "paragraph",html: "“Non attivato” di solito aggiunge un secondo problema. Anche una volta comparso il conto, i dati di mercato in tempo reale su un conto prop o di valutazione possono essere attivati solo dal fornitore del conto. Un conto che compare ma trasmette quotazioni ritardate o assenti non è guasto: attende che la società attivi i dati, un passaggio distinto dall'attivazione del conto stesso." },
    { type: "heading",text: "Principali cause di un conto prop Tradovate non visibile" },
    { type: "heading",text: "1. È ancora in fase di provisioning (di gran lunga la causa più comune)" },
    { type: "paragraph",html: "I nuovi conti di valutazione vengono creati con un ritardo dopo l'acquisto. Un nuovo conto di valutazione richiede in genere tra 10 e 90 minuti per essere configurato una volta firmati gli accordi richiesti e, nei periodi di punta, alcune società dicono agli acquirenti di attendere diverse ore prima di aprire un ticket. L'attesa esatta varia per società e dimensione del conto, quindi verifichi le regole attuali della sua, ma lo schema non cambia mai: l'acquisto si completa all'istante, il conto no. Se ha appena pagato e ha effettuato subito l'accesso, un elenco di conti vuoto è previsto, non è un bug." },
    { type: "heading",text: "2. Non ha firmato l'accordo utente del primo accesso" },
    { type: "paragraph",html: "Al primo accesso a una nuova valutazione, Tradovate le chiede di rivedere e firmare elettronicamente un accordo utente. Se lo salta o lo chiude, il conto non verrà elencato come operativo. Questo fa inciampare continuamente le persone: chiude la finestra, si ritrova su una piattaforma vuota e conclude che il conto non è mai arrivato, quando è semplicemente bloccato dietro un accordo non firmato." },
    { type: "heading",text: "3. Sta accedendo al conto sbagliato" },
    { type: "paragraph",html: "La sua valutazione usa le credenziali emesse nella dashboard della società prop, non un conto Tradovate personale che ha configurato in precedenza. Accedere a un vecchio login personale (o a una demo avviata direttamente con Tradovate) si autentica senza problemi e non mostra nessuno dei conti della società, perché sono associati a un nome utente completamente diverso. Acceda sempre con le credenziali esatte che la società le ha fornito." },
    { type: "heading",text: "4. Il conto c'è, semplicemente non l'ha selezionato" },
    { type: "paragraph",html: "Se ha acquistato più di una valutazione, il nuovo conto può essere presente ma non essere quello attualmente selezionato. Tradovate raggruppa i conti in un selettore, di solito il menu a tendina dei conti in alto nella piattaforma. Un conto “mancante” è spesso semplicemente un conto non selezionato nascosto dietro le altre valutazioni." },
    { type: "heading",text: "5. La società non ha attivato il conto o i suoi dati di mercato" },
    { type: "paragraph",html: "Anche dopo che il conto compare, due interruttori controllati dalla società possono lasciarlo inutilizzabile. Il conto stesso può non essere ancora completamente abilitato, e i dati di mercato in tempo reale su un conto prop o di valutazione possono essere attivati solo dal fornitore del conto. Tradovate non può abilitare i dati su un conto che non possiede, quindi un conto che si carica con quotazioni ritardate o vuote sta aspettando la società, non lei." },
    { type: "heading",text: "Come risolvere una valutazione Tradovate che non compare: passo dopo passo" },
    { type: "heading",text: "Risolvere i ritardi di provisioning (attendere, poi aggiornare)" },
    {
      type: "steps",
      items: [
        { title: "Annoti quando ha acquistato", html: "Annoti l'ora in cui ha completato l'acquisto e firmato eventuali accordi lato società." },
        { title: "Attenda la finestra di attivazione della sua società", html: "Attenda la finestra di attivazione indicata dalla sua società prima di toccare qualsiasi altra cosa; varia da società a società, quindi controlli l'email di conferma o il centro assistenza della società per il dato attuale." },
        { title: "Esca completamente e rientri", html: "Una volta trascorsa la finestra, esca completamente da Tradovate (non si limiti ad aggiornare), poi rientri con le credenziali della sua società prop." },
        { title: "Riavvii o aggiorni forzatamente", html: "Sull'app desktop o mobile, la chiuda completamente e la riavvii; sul web, aggiorni forzatamente la pagina." },
      ],
    },
    { type: "heading",text: "Risolvere un accordo non firmato" },
    {
      type: "steps",
      items: [
        { title: "Acceda con le credenziali della società prop", html: "Acceda con le credenziali della sua società prop." },
        { title: "Firmi l'accordo", html: "Quando Tradovate presenta l'accordo utente al primo accesso, lo legga e lo firmi elettronicamente, non chiuda la richiesta." },
        { title: "Controlli il selettore dei conti", html: "Dopo la firma, controlli il selettore dei conti; la valutazione dovrebbe ora essere elencata come operativa." },
      ],
    },
    { type: "paragraph",html: "L'etichetta esatta e la posizione della richiesta di accordo possono cambiare tra le versioni di Tradovate, quindi si fidi della dicitura sulla sua schermata di primo accesso anziché di un nome di pulsante fisso letto altrove." },
    { type: "heading",text: "Risolvere i problemi di credenziali errate e di conto sbagliato selezionato" },
    {
      type: "steps",
      items: [
        { title: "Copi il nome utente esatto emesso", html: "Apra la dashboard membri della sua società prop e copi il nome utente Tradovate esatto che la società ha emesso per questa valutazione." },
        { title: "Acceda solo con le credenziali emesse dalla società", html: "Esca da qualsiasi sessione Tradovate personale, quindi acceda solo con quelle credenziali emesse dalla società." },
        { title: "Scelga il nuovo conto nel selettore", html: "Apra il selettore dei conti (il menu a tendina dei conti in alto nella piattaforma) e scelga la nuova valutazione dall'elenco. Se ne possiede diverse, confermi di essere sul numero di conto corretto." },
      ],
    },
    { type: "heading",text: "Risolvere “il conto continua a non comparire” o “dati non in tempo reale” (contatti la società)" },
    {
      type: "steps",
      items: [
        { title: "Smetta la risoluzione dei problemi lato Tradovate", html: "Se il conto continua a mancare dopo aver atteso l'intera finestra, firmato l'accordo ed effettuato di nuovo l'accesso, smetta di risolvere i problemi lato Tradovate." },
        { title: "Contatti direttamente la sua società prop", html: "Contatti direttamente la sua società prop, il fornitore del servizio di valutazione. Possiede il conto ed è la sola che può crearlo, abilitarlo o reimpostarlo. Tradovate può aiutare a configurare la connessione iniziale, ma non può risolvere problemi specifici di conti che non possiede." },
        { title: "Chieda alla società di attivare i dati", html: "Per un problema di dati in tempo reale, chieda alla società di attivare i dati di mercato sul conto. Non provi ad abbonarsi da solo ai dati di mercato su un conto prop o di valutazione, quella strada è per i conti Tradovate di proprietà personale e non funzionerà su una valutazione." },
      ],
    },
    { type: "heading",text: "Tabella di risoluzione dei problemi" },
    { type: "table", headers: ["Sintomo","Che cosa significa","Soluzione"], rows: [
      ["Elenco conti vuoto subito dopo l'acquisto","Il conto è ancora in fase di provisioning lato società","Attenda la finestra di attivazione della società, poi esca e rientri"],
      ["Accesso effettuato, ma nulla da operare","Accordo utente del primo accesso non firmato","Firmi l'accordo che Tradovate richiede al primo accesso"],
      ["Compaiono vecchi saldi, la nuova valutazione manca","Accesso effettuato a un conto Tradovate personale","Acceda solo con le credenziali di valutazione emesse dalla società"],
      ["Alcuni conti compaiono, il nuovo no","Conto sbagliato selezionato nel menu a tendina","Scelga la nuova valutazione nel selettore dei conti"],
      ["Richiesta di finanziare/aprire un conto che ha acquistato","Conto non ancora creato o collegato","Attenda il provisioning; se persiste, contatti la società prop"],
      ["Il conto compare ma le quotazioni sono ritardate/vuote","Dati in tempo reale non attivati dal fornitore","Chieda alla sua società prop di attivare i dati di mercato, non si abboni da solo"],
      ["Nulla funziona dopo l'intera attesa","Problema a livello di conto che solo il titolare può risolvere","Contatti direttamente il supporto della sua società prop"],
    ] },
    { type: "heading",text: "Prevenga il problema con PickMyTrade" },
    { type: "paragraph",html: "Una volta che la sua valutazione è finalmente live, l'ultima cosa che vuole è che la sua automazione parta a vuoto contro un conto attivato a metà. PickMyTrade si colloca tra TradingView e Tradovate e aggiunge protezioni che mantengono al sicuro una valutazione appena attivata:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Validazione di conto &amp; simbolo</strong>, instrada gli alert solo al conto e al contratto che intende, così gli ordini non finiscono mai sulla valutazione sbagliata.",
        "<strong class='text-white'>Instradamento consapevole di abilitazioni e dati</strong>, rispetta lo stato di attivazione e di accordo sui dati del conto invece di scaricare ordini su un conto non pronto.",
        "<strong class='text-white'>Flusso di ordini sicuro rispetto ai limiti di frequenza</strong>, distanzia le richieste in modo che una raffica di alert su un nuovo conto non faccia scattare i limiti di Tradovate.",
        "<strong class='text-white'>Sincronizzazione multi-account</strong>, replichi la stessa strategia su più valutazioni una volta che sono tutte configurate, senza ricablare ciascuna a mano.",
      ],
    },
  ] },
  ctaHeading: { en: "Connect the Moment Your Eval Goes Live", de: "Verbinden Sie sich, sobald Ihre Evaluierung live geht", es: "Conéctese en el momento en que su evaluación se active", fr: "Connectez-vous dès que votre évaluation est active", it: "Si colleghi nel momento in cui la valutazione va live" },
  ctaText: { en: "Stage your alerts ahead of time so nothing fires against an account that isn't fully switched on yet.", de: "Bereiten Sie Ihre Alerts im Voraus vor, damit nichts gegen ein Konto feuert, das noch nicht vollständig freigeschaltet ist.", es: "Prepare sus alertas con antelación para que nada se dispare contra una cuenta que aún no está totalmente activada.", fr: "Préparez vos alertes à l'avance pour que rien ne se déclenche sur un compte qui n'est pas encore entièrement activé.", it: "Prepari i suoi alert in anticipo, così che nulla parta contro un conto non ancora completamente attivato." },
  ctaButtonText: { en: "Start Your Free 7-Day Trial", de: "Starten Sie Ihre kostenlose 7-Tage-Testphase", es: "Comience su prueba gratuita de 7 días", fr: "Commencez votre essai gratuit de 7 jours", it: "Inizi la prova gratuita di 7 giorni" },
  ctaUrl: "https://app.pickmytrade.trade/?register=true&utm_source=content&utm_medium=debugging",
  faqHeading: { en: "Frequently Asked Questions", de: "Häufig gestellte Fragen", es: "Preguntas frecuentes", fr: "Questions fréquentes", it: "Domande frequenti" },
  faqs: { en: [
    { q: "How long should a Tradovate evaluation take to show up after I buy it?", a: "It varies by firm. A new evaluation account typically takes roughly 10 to 90 minutes to set up after the required agreements are signed, and some firms ask you to allow several hours before opening a ticket. Check your firm's current rules for the exact number." },
    { q: "I paid but the account still is not there after the wait, who do I contact?", a: "Your prop firm, not Tradovate. The firm owns and creates the account; Tradovate only displays it. Tradovate can help with the initial connection but cannot resolve account-specific issues on accounts it does not own." },
    { q: "Why does the platform ask me to fund an account I already purchased?", a: "That prompt usually means Tradovate authenticated your login but the specific evaluation is not yet created, linked, or selected. Wait out provisioning, confirm you signed the agreement, and check the account dropdown; if it persists, contact your firm." },
    { q: "My account finally appeared but the data is delayed or missing. Is it broken?", a: "No. Live market data on a prop or evaluation account can only be enabled by the account provider. Ask your firm to turn on data, do not try to subscribe to market data yourself on an eval account." },
    { q: "Do I use my own Tradovate login or the one my firm gave me?", a: "Use the credentials issued in your prop firm's dashboard. Logging into a personal Tradovate account will never show your firm-issued evaluation, because they are attached to different usernames." },
    { q: "I signed in but there is no user agreement prompt and still no account. What now?", a: "If you have already waited the full window, re-logged in, and confirmed you are using the firm's credentials, the account is likely still provisioning or needs firm-side activation. Reach out to your prop firm's support to confirm the account is created and enabled." },
    { q: "Will logging out and back in actually help?", a: "Often, yes. A clean logout-and-login (or an app relaunch or hard browser refresh) forces Tradovate to re-pull your account list, which is what you need once provisioning finishes. It will not, however, conjure an account the firm has not created yet." },
    { q: "Can I start automating the moment the account appears?", a: "Wait until the account is fully activated and streaming live data first, firing automated orders at a half-activated eval invites rejections. A bridge like PickMyTrade lets you stage your alerts ahead of time so you can go live cleanly once the firm flips everything on." },
  ], de: [
    { q: "Wie lange sollte es dauern, bis eine Tradovate-Evaluierung nach dem Kauf erscheint?", a: "Das hängt von der Firma ab. Ein neues Evaluierungskonto braucht nach Unterzeichnung der erforderlichen Vereinbarungen typischerweise etwa 10 bis 90 Minuten bis zur Einrichtung, und manche Firmen bitten Sie, mehrere Stunden einzuplanen, bevor Sie ein Ticket eröffnen. Prüfen Sie die aktuellen Regeln Ihrer Firma für die genaue Zeit." },
    { q: "Ich habe bezahlt, aber das Konto ist nach der Wartezeit immer noch nicht da. Wen kontaktiere ich?", a: "Ihre Prop-Firma, nicht Tradovate. Die Firma besitzt das Konto und legt es an; Tradovate zeigt es nur an. Tradovate kann bei der ersten Verbindung helfen, aber keine kontospezifischen Probleme bei Konten lösen, die ihm nicht gehören." },
    { q: "Warum fordert mich die Plattform auf, ein Konto zu finanzieren, das ich bereits gekauft habe?", a: "Diese Aufforderung bedeutet meist, dass Tradovate Ihren Login authentifiziert hat, die konkrete Evaluierung aber noch nicht angelegt, verknüpft oder ausgewählt ist. Warten Sie die Bereitstellung ab, vergewissern Sie sich, dass Sie die Vereinbarung unterzeichnet haben, und prüfen Sie das Konto-Dropdown; besteht das Problem weiter, kontaktieren Sie Ihre Firma." },
    { q: "Mein Konto ist endlich erschienen, aber die Daten sind verzögert oder fehlen. Ist es defekt?", a: "Nein. Live-Marktdaten bei einem Prop- oder Evaluierungskonto kann nur der Kontoanbieter aktivieren. Bitten Sie Ihre Firma, die Daten einzuschalten, und versuchen Sie nicht, bei einem Evaluierungskonto Marktdaten selbst zu abonnieren." },
    { q: "Nutze ich meinen eigenen Tradovate-Login oder den, den meine Firma mir gegeben hat?", a: "Verwenden Sie die Zugangsdaten aus dem Dashboard Ihrer Prop-Firma. Der Login in ein persönliches Tradovate-Konto zeigt Ihre von der Firma ausgestellte Evaluierung niemals an, weil sie an unterschiedliche Benutzernamen gebunden sind." },
    { q: "Ich habe mich angemeldet, aber es gibt keine Aufforderung zur Nutzervereinbarung und immer noch kein Konto. Was nun?", a: "Haben Sie bereits das gesamte Zeitfenster abgewartet, sich neu angemeldet und bestätigt, dass Sie die Zugangsdaten der Firma verwenden, wird das Konto wahrscheinlich noch bereitgestellt oder braucht eine Aktivierung auf Seiten der Firma. Wenden Sie sich an den Support Ihrer Prop-Firma, um bestätigen zu lassen, dass das Konto angelegt und aktiviert ist." },
    { q: "Hilft es tatsächlich, mich ab- und wieder anzumelden?", a: "Oft ja. Ein sauberes Ab- und Anmelden (oder ein Neustart der App bzw. eine harte Browser-Aktualisierung) zwingt Tradovate, Ihre Kontoliste neu abzurufen, was Sie nach Abschluss der Bereitstellung brauchen. Es zaubert allerdings kein Konto herbei, das die Firma noch nicht angelegt hat." },
    { q: "Kann ich mit der Automatisierung beginnen, sobald das Konto erscheint?", a: "Warten Sie zuerst, bis das Konto vollständig aktiviert ist und Live-Daten streamt; automatisierte Orders auf eine halb aktivierte Evaluierung zu feuern, lädt zu Ablehnungen ein. Mit einer Bridge wie PickMyTrade können Sie Ihre Alerts im Voraus vorbereiten und sauber live gehen, sobald die Firma alles freischaltet." },
  ], es: [
    { q: "¿Cuánto debería tardar en aparecer una evaluación de Tradovate tras comprarla?", a: "Depende de la firma. Una cuenta de evaluación nueva suele tardar aproximadamente entre 10 y 90 minutos en configurarse una vez firmados los acuerdos necesarios, y algunas firmas piden que espere varias horas antes de abrir un ticket. Consulte las reglas vigentes de su firma para saber la cifra exacta." },
    { q: "Pagué pero la cuenta sigue sin aparecer tras la espera, ¿a quién contacto?", a: "A su firma prop, no a Tradovate. La firma es dueña y crea la cuenta; Tradovate solo la muestra. Tradovate puede ayudar con la conexión inicial, pero no puede resolver problemas específicos de cuentas que no le pertenecen." },
    { q: "¿Por qué la plataforma me pide financiar una cuenta que ya compré?", a: "Ese aviso suele significar que Tradovate autenticó su acceso pero la evaluación concreta aún no está creada, vinculada o seleccionada. Espere a que termine el aprovisionamiento, confirme que firmó el acuerdo y revise el desplegable de cuentas; si persiste, contacte con su firma." },
    { q: "Mi cuenta por fin apareció pero los datos están retrasados o ausentes. ¿Está rota?", a: "No. Los datos de mercado en vivo en una cuenta prop o de evaluación solo puede activarlos el proveedor de la cuenta. Pida a su firma que active los datos; no intente suscribirse usted mismo a datos de mercado en una cuenta de evaluación." },
    { q: "¿Uso mi propio acceso de Tradovate o el que me dio mi firma?", a: "Use las credenciales emitidas en el panel de su firma prop. Iniciar sesión en una cuenta personal de Tradovate nunca mostrará su evaluación emitida por la firma, porque están asociadas a nombres de usuario distintos." },
    { q: "Inicié sesión pero no hay aviso de acuerdo de usuario y sigo sin cuenta. ¿Y ahora?", a: "Si ya esperó toda la ventana, volvió a iniciar sesión y confirmó que usa las credenciales de la firma, es probable que la cuenta siga aprovisionándose o que necesite activación por parte de la firma. Contacte con el soporte de su firma prop para confirmar que la cuenta está creada y habilitada." },
    { q: "¿Ayuda realmente cerrar sesión y volver a entrar?", a: "A menudo sí. Un cierre y reinicio de sesión limpios (o un reinicio de la app o una actualización forzada del navegador) obliga a Tradovate a volver a cargar su lista de cuentas, que es lo que necesita cuando termina el aprovisionamiento. Eso sí, no hará aparecer una cuenta que la firma aún no ha creado." },
    { q: "¿Puedo empezar a automatizar en cuanto aparezca la cuenta?", a: "Espere primero a que la cuenta esté totalmente activada y transmitiendo datos en vivo; disparar órdenes automatizadas contra una evaluación a medio activar invita a los rechazos. Un puente como PickMyTrade le permite preparar sus alertas con antelación para poder pasar a vivo sin problemas cuando la firma active todo." },
