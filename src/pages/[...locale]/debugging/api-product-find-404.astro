---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "api-product-find-404";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/debugging/${SLUG}`;

const META_TITLE = "Tradovate API /product/find Returns 404";
const META_DESCRIPTION =
  "Tradovate product/find returning 404? Learn why the endpoint fails and how to use GET query strings with contract/find to look up symbols fast.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate API", de: "Tradovate API", es: "Tradovate API", fr: "Tradovate API", it: "Tradovate API" },
  h1: { en: META_TITLE, de: "Tradovate-API /product/find gibt 404 zurück", es: "La API de Tradovate /product/find devuelve 404", fr: "L'API Tradovate /product/find renvoie une 404", it: "L'API Tradovate /product/find restituisce 404" },
  dek: { en: "You fired a request at product/find and got a flat 404 back. The endpoint isn't missing, the request is shaped wrong, here's the exact GET and query-string fix.", de: "Sie haben eine Anfrage an product/find gesendet und nur ein nacktes 404 zurückbekommen. Der Endpunkt fehlt nicht, die Anfrage ist falsch aufgebaut, hier ist die genaue Lösung mit GET und Query-String.", es: "Envió una solicitud a product/find y recibió un 404 seco. El endpoint no falta, la solicitud tiene el formato incorrecto; aquí está la solución exacta con GET y cadena de consulta.", fr: "Vous avez envoyé une requête à product/find et reçu une 404 sèche. L'endpoint n'est pas manquant, la requête est mal formée ; voici la correction exacte avec GET et chaîne de requête.", it: "Ha inviato una richiesta a product/find e ha ricevuto un secco 404. L'endpoint non manca, la richiesta è strutturata male; ecco la correzione esatta con GET e stringa di query." },
  readTime: { en: "7 min read", de: "7 Minuten Lesezeit", es: "Lectura de 7 minutos", fr: "Lecture de 7 minutes", it: "Lettura di 7 minuti" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "You fired a request at <code>product/find</code>, and instead of a tidy JSON payload the server threw back a flat 404. Nothing here, it says. But the endpoint isn't missing. In practice that 404 almost always means the request is shaped wrong, not that the route doesn't exist. Nine times out of ten it comes down to one of two mistakes: you sent your parameters in a JSON body instead of the URL, or you're pointing at the wrong host or path. Fix the shape of the call and <code>product/find</code> (plus its close cousin <code>contract/find</code>) start handing you data again." },
    { type: "paragraph", html: "Here's the short version, then the why and the how." },
    { type: "quote", html: "<strong class='text-white'>Quick fix:</strong> Call <code>product/find</code> as a <strong class='text-white'>GET</strong> with the symbol in the <strong class='text-white'>query string</strong>, <code>GET https://demo.tradovateapi.com/v1/product/find?name=ES</code>, not a POST with a JSON body. To get the actual tradable contract, use <code>contract/find?name=ESU6</code>. Both take the same parameters." },
    { type: "heading", text: "Why the 404 happens" },
    { type: "paragraph", html: "A 404 on this call is misleading because we're trained to read it as &ldquo;this URL doesn't exist.&rdquo; On the Tradovate REST API, though, the same status shows up when the router can't match the request you actually sent to a real operation. A handful of specific mistakes cause it." },
    { type: "paragraph", html: "<strong class='text-white'>You sent a JSON body instead of a query string.</strong> This is the big one. <code>product/find</code> is a read operation, and Tradovate expects read operations to be GET requests with parameters tacked onto the URL. If you POST something like <code>{\"name\":\"es\",\"isAutomated\":true}</code> as a JSON body, the request never resolves to the find operation and you get a 404. Two things are wrong there at once: the body-versus-query-string shape, and the extra <code>isAutomated</code> field that <code>find</code> doesn't accept in the first place. Strip both." },
    { type: "paragraph", html: "<strong class='text-white'>You dropped the version prefix or mistyped the host.</strong> Every REST call lives under <code>/v1/</code>. The base is <code>https://demo.tradovateapi.com/v1</code> for simulation and <code>https://live.tradovateapi.com/v1</code> for live. Leave out the <code>/v1</code>, hit <code>api.tradovate.com</code> (that's the documentation site, not the API), or fat-finger the subdomain, and there's no matching route, 404." },
    { type: "paragraph", html: "<strong class='text-white'>You changed the casing or spelling of the path.</strong> The path is two parts: an entity and an operation, joined by a slash, like <code>product/find</code> or <code>contract/find</code>. Write <code>Product/Find</code>, <code>products/find</code>, or <code>product/search</code> and none of them resolve." },
    { type: "paragraph", html: "<strong class='text-white'>You're calling an operation that isn't implemented on that transport.</strong> Some operations exist over the WebSocket but not the plain REST route, and vice versa. If you copy a call meant for one and fire it at the other, you'll see a 404 with a body that literally names the missing operation, such as <code>\"Not found: md/getChart\"</code>. That's your clue that the route is fine but the transport is wrong." },
    { type: "paragraph", html: "One thing a 404 is <em>not</em>: an authentication problem. If your access token is missing or expired, you get a 401, not a 404. So if you're staring at a 404, don't burn time regenerating tokens, look at the request shape and the URL first." },
    { type: "heading", text: "The fix: GET with a query string" },
    { type: "paragraph", html: "Rebuild the call as a GET and move the symbol into the query string. That single change resolves the overwhelming majority of these 404s." },
    { type: "quote", html: "GET https://demo.tradovateapi.com/v1/product/find?name=ES<br>Authorization: Bearer &lt;your-access-token&gt;<br>Accept: application/json" },
    { type: "paragraph", html: "Swap <code>ES</code> for whatever product root you're after, <code>MES</code>, <code>NQ</code>, <code>MNQ</code>, <code>CL</code>, and so on. The response is the product record for that instrument: its id, name, product type, exchange, tick size, and value-per-point. Notice there's no request body at all. Nothing to serialize, nothing to get wrong." },
    { type: "paragraph", html: "If you were using a client library or a bridge that builds the request for you and you're still seeing 404s, check what it's actually sending on the wire. A surprising number of &ldquo;the API is broken&rdquo; moments turn out to be a helper quietly wrapping your parameters in a POST body. Point it at GET, and the same symbol lookup that failed a second ago comes back clean." },
    { type: "heading", text: "Get the tradable contract with contract/find" },
    { type: "paragraph", html: "<code>product/find</code> tells you about the instrument family. It won't tell you which contract to actually route an order to, because a product doesn't expire, a contract does. For that, reach for <code>contract/find</code>, which takes the exact same query parameters:" },
    { type: "quote", html: "GET https://demo.tradovateapi.com/v1/contract/find?name=ESU6" },
    { type: "paragraph", html: "The <code>name</code> here is the full contract symbol, not just the root. Tradovate builds it from three pieces with no spaces: the product root, a single month code, and the last digit of the year. So <code>ESU6</code> is the E-mini S&amp;P 500 for <strong class='text-white'>U</strong> (September) <strong class='text-white'>6</strong> (2026). Change the month letter and year digit as contracts roll, the quarterly equity index months are H, M, U, and Z (March, June, September, December). The front month rotates through the year, so confirm the current active contract rather than hard-coding one that's about to expire." },
    { type: "paragraph", html: "Feed <code>contract/find</code> a symbol that doesn't exist or has already expired and you may get an empty result rather than a clean contract, another reason to resolve the live front month first instead of guessing. Once you have the contract id back, that's the value you hand to order placement, position lookups, and market-data subscriptions." },
    { type: "heading", text: "When you don't know the exact symbol" },
    { type: "paragraph", html: "What if you don't have the precise contract code and you just want to search? First, adjust your expectations: there is no public &ldquo;give me every symbol&rdquo; endpoint. The API is built around targeted lookups, and it expects you to cache what you fetch rather than pull a giant list on every run." },
    { type: "paragraph", html: "Two practical routes:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Type-ahead suggest.</strong> Tradovate has a contract suggestion endpoint that behaves like the search box in the platform, you pass a partial text string and a result limit, and it returns matching contracts. It's the cleanest way to turn &ldquo;the user typed <code>MNQ</code>&rdquo; into a real, current contract. Confirm the exact parameter names in the current API reference before wiring it in, since the suggest endpoints use short single-letter keys.",
        "<strong class='text-white'>Product first, then contract.</strong> Look up the product with <code>product/find?name=NQ</code>, then resolve the active contract for it. This two-step keeps you working with documented, stable operations.",
      ],
    },
    { type: "paragraph", html: "You may run across a <code>contract/list</code> route in the wild. It exists, but it's undocumented and not recommended, it isn't a supported &ldquo;list everything&rdquo; call, and building on it invites breakage. Stick to <code>contract/find</code> and the suggest endpoint, cache the results, and refresh your cache around each contract roll." },
    { type: "heading", text: "A 90-second checklist" },
    { type: "paragraph", html: "Before you file a bug report, walk this list. It clears nearly every <code>product/find</code> 404." },
    {
      type: "table",
      headers: ["Check", "What \"good\" looks like"],
      rows: [
        ["HTTP method", "GET, not POST"],
        ["Parameters", "In the query string (?name=ES), not a JSON body"],
        ["Extra fields", "No isAutomated or other order-only fields on a find call"],
        ["Base URL", "demo.tradovateapi.com/v1 or live.tradovateapi.com/v1, with the /v1"],
        ["Path spelling", "Exactly product/find / contract/find, lowercase"],
        ["Host", "Not api.tradovate.com (that's the docs site)"],
        ["Transport", "REST route over HTTPS, not a WebSocket-only operation"],
      ],
    },
    { type: "paragraph", html: "If everything above checks out and you still get a 404 specifically on <code>product/find</code> while other GET calls work, capture the raw request and response and take it to Tradovate's API support, but that's rare. Almost every time, the problem is one of the rows above." },
    { type: "paragraph", html: "Worth knowing which errors are <em>not</em> this one: a 401 means your token is stale or missing (renew it before it expires), and a &ldquo;symbol is inaccessible&rdquo; or 403 on a quote request means a market-data entitlement issue, not a lookup problem. Contract and product lookups themselves only need a valid token, no data subscription required." },
    { type: "heading", text: "Want the symbol lookup handled for you?" },
    { type: "paragraph", html: "Wiring up token renewal, front-month resolution, and per-symbol contract lookups is the kind of plumbing that eats a weekend and then breaks on the next contract roll. If your real goal is to fire a TradingView alert and have it land as a live Tradovate order, without babysitting the REST layer, you can skip the raw API entirely and let a bridge map symbols and route orders for you." },
    { type: "paragraph", html: "Automate your Tradovate orders from TradingView without touching the raw API and let PickMyTrade handle symbol lookup and order routing for you." },
  ], de: [
    { type: "paragraph", html: "Sie haben eine Anfrage an <code>product/find</code> gesendet, und statt eines sauberen JSON-Payloads hat der Server ein nacktes 404 zurückgeworfen. Hier ist nichts, heißt es. Doch der Endpunkt fehlt nicht. In der Praxis bedeutet dieses 404 fast immer, dass die Anfrage falsch aufgebaut ist, nicht dass die Route nicht existiert. In neun von zehn Fällen liegt es an einem von zwei Fehlern: Sie haben Ihre Parameter in einem JSON-Body statt in der URL gesendet, oder Sie zeigen auf den falschen Host oder Pfad. Korrigieren Sie den Aufbau des Aufrufs, und <code>product/find</code> (sowie sein enger Verwandter <code>contract/find</code>) liefert wieder Daten." },
    { type: "paragraph", html: "Hier die Kurzfassung, danach das Warum und das Wie." },
    { type: "quote", html: "<strong class='text-white'>Schnelle Lösung:</strong> Rufen Sie <code>product/find</code> als <strong class='text-white'>GET</strong> mit dem Symbol im <strong class='text-white'>Query-String</strong> auf, <code>GET https://demo.tradovateapi.com/v1/product/find?name=ES</code>, nicht als POST mit einem JSON-Body. Um den tatsächlich handelbaren Kontrakt zu erhalten, verwenden Sie <code>contract/find?name=ESU6</code>. Beide nehmen dieselben Parameter entgegen." },
    { type: "heading", text: "Warum das 404 auftritt" },
    { type: "paragraph", html: "Ein 404 bei diesem Aufruf ist irreführend, weil wir darauf trainiert sind, es als &ldquo;diese URL existiert nicht&rdquo; zu lesen. Bei der Tradovate-REST-API taucht derselbe Status jedoch auch dann auf, wenn der Router die tatsächlich gesendete Anfrage keiner echten Operation zuordnen kann. Eine Handvoll konkreter Fehler verursacht das." },
    { type: "paragraph", html: "<strong class='text-white'>Sie haben einen JSON-Body statt eines Query-Strings gesendet.</strong> Das ist der Hauptfehler. <code>product/find</code> ist eine Leseoperation, und Tradovate erwartet, dass Leseoperationen als GET-Anfragen mit Parametern in der URL erfolgen. Wenn Sie etwas wie <code>{\"name\":\"es\",\"isAutomated\":true}</code> als JSON-Body per POST senden, wird die Anfrage nie der find-Operation zugeordnet und Sie erhalten ein 404. Dabei sind gleich zwei Dinge falsch: der Aufbau als Body statt Query-String, und das zusätzliche Feld <code>isAutomated</code>, das <code>find</code> von vornherein nicht akzeptiert. Entfernen Sie beides." },
    { type: "paragraph", html: "<strong class='text-white'>Sie haben das Versionspräfix weggelassen oder den Host falsch geschrieben.</strong> Jeder REST-Aufruf liegt unter <code>/v1/</code>. Die Basis ist <code>https://demo.tradovateapi.com/v1</code> für die Simulation und <code>https://live.tradovateapi.com/v1</code> für Live. Lassen Sie das <code>/v1</code> weg, rufen Sie <code>api.tradovate.com</code> auf (das ist die Dokumentationsseite, nicht die API) oder vertippen Sie sich bei der Subdomain, gibt es keine passende Route, 404." },
    { type: "paragraph", html: "<strong class='text-white'>Sie haben Groß-/Kleinschreibung oder Schreibweise des Pfads geändert.</strong> Der Pfad besteht aus zwei Teilen: einer Entität und einer Operation, getrennt durch einen Schrägstrich, wie <code>product/find</code> oder <code>contract/find</code>. Schreiben Sie <code>Product/Find</code>, <code>products/find</code> oder <code>product/search</code>, löst keine davon auf." },
    { type: "paragraph", html: "<strong class='text-white'>Sie rufen eine Operation auf, die auf diesem Transportweg nicht implementiert ist.</strong> Manche Operationen existieren über WebSocket, aber nicht über die reine REST-Route, und umgekehrt. Wenn Sie einen Aufruf kopieren, der für den einen gedacht war, und ihn an den anderen senden, erhalten Sie ein 404 mit einem Body, der die fehlende Operation wörtlich benennt, etwa <code>\"Not found: md/getChart\"</code>. Das ist Ihr Hinweis, dass die Route stimmt, aber der Transportweg falsch ist." },
    { type: "paragraph", html: "Eines ist ein 404 <em>nicht</em>: ein Authentifizierungsproblem. Fehlt Ihr Zugriffstoken oder ist es abgelaufen, erhalten Sie ein 401, kein 404. Wenn Sie also vor einem 404 stehen, verschwenden Sie keine Zeit mit dem Erneuern von Tokens, sondern prüfen Sie zuerst den Aufbau der Anfrage und die URL." },
    { type: "heading", text: "Die Lösung: GET mit Query-String" },
    { type: "paragraph", html: "Bauen Sie den Aufruf als GET neu auf und verschieben Sie das Symbol in den Query-String. Diese eine Änderung löst die überwältigende Mehrheit dieser 404-Fehler." },
    { type: "quote", html: "GET https://demo.tradovateapi.com/v1/product/find?name=ES<br>Authorization: Bearer &lt;your-access-token&gt;<br>Accept: application/json" },
    { type: "paragraph", html: "Tauschen Sie <code>ES</code> gegen die gewünschte Produktwurzel aus, <code>MES</code>, <code>NQ</code>, <code>MNQ</code>, <code>CL</code> und so weiter. Die Antwort ist der Produktdatensatz für dieses Instrument: seine ID, seinen Namen, den Produkttyp, die Börse, die Tickgröße und den Wert pro Punkt. Beachten Sie, dass es überhaupt keinen Request-Body gibt. Nichts zu serialisieren, nichts, was schiefgehen kann." },
    { type: "paragraph", html: "Wenn Sie eine Client-Bibliothek oder eine Bridge verwenden, die die Anfrage für Sie erstellt, und weiterhin 404-Fehler sehen, prüfen Sie, was sie tatsächlich auf der Leitung sendet. Erstaunlich viele &ldquo;die API ist kaputt&rdquo;-Momente stellen sich als Helfer heraus, der Ihre Parameter stillschweigend in einen POST-Body verpackt. Stellen Sie es auf GET um, und dieselbe Symbolsuche, die eben noch fehlschlug, funktioniert wieder einwandfrei." },
    { type: "heading", text: "Den handelbaren Kontrakt mit contract/find erhalten" },
    { type: "paragraph", html: "<code>product/find</code> gibt Ihnen Auskunft über die Instrumentenfamilie. Es sagt Ihnen nicht, an welchen Kontrakt Sie eine Order tatsächlich routen sollen, denn ein Produkt läuft nicht ab, ein Kontrakt schon. Dafür greifen Sie zu <code>contract/find</code>, das genau dieselben Query-Parameter entgegennimmt:" },
    { type: "quote", html: "GET https://demo.tradovateapi.com/v1/contract/find?name=ESU6" },
    { type: "paragraph", html: "Das <code>name</code> hier ist das vollständige Kontraktsymbol, nicht nur die Wurzel. Tradovate setzt es aus drei Teilen ohne Leerzeichen zusammen: der Produktwurzel, einem einzelnen Monatscode und der letzten Ziffer des Jahres. Also ist <code>ESU6</code> der E-mini S&amp;P 500 für <strong class='text-white'>U</strong> (September) <strong class='text-white'>6</strong> (2026). Ändern Sie den Monatsbuchstaben und die Jahresziffer, wenn Kontrakte rollen, die vierteljährlichen Aktienindex-Monate sind H, M, U und Z (März, Juni, September, Dezember). Der Frontmonat wechselt im Laufe des Jahres, bestätigen Sie also den aktuell aktiven Kontrakt, statt einen fest einzucodieren, der bald ausläuft." },
    { type: "paragraph", html: "Füttern Sie <code>contract/find</code> mit einem Symbol, das nicht existiert oder bereits abgelaufen ist, erhalten Sie möglicherweise ein leeres Ergebnis statt eines sauberen Kontrakts, ein weiterer Grund, zuerst den aktiven Frontmonat zu ermitteln, statt zu raten. Sobald Sie die Kontrakt-ID haben, ist das der Wert, den Sie an Orderaufgabe, Positionsabfragen und Marktdaten-Abonnements übergeben." },
    { type: "heading", text: "Wenn Sie das genaue Symbol nicht kennen" },
    { type: "paragraph", html: "Was, wenn Sie den genauen Kontraktcode nicht haben und einfach nur suchen möchten? Passen Sie zunächst Ihre Erwartungen an: Es gibt keinen öffentlichen &ldquo;gib mir jedes Symbol&rdquo;-Endpunkt. Die API ist auf gezielte Abfragen ausgelegt und erwartet, dass Sie das Abgerufene zwischenspeichern, statt bei jedem Lauf eine riesige Liste zu holen." },
    { type: "paragraph", html: "Zwei praktikable Wege:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Type-Ahead-Vorschläge.</strong> Tradovate hat einen Kontraktvorschlags-Endpunkt, der sich wie das Suchfeld in der Plattform verhält, Sie übergeben eine Teilzeichenkette und ein Ergebnislimit, und er liefert passende Kontrakte zurück. Das ist der sauberste Weg, um aus &ldquo;der Nutzer hat <code>MNQ</code> eingegeben&rdquo; einen echten, aktuellen Kontrakt zu machen. Bestätigen Sie die genauen Parameternamen in der aktuellen API-Referenz, bevor Sie es einbinden, da die Vorschlags-Endpunkte kurze Einzelbuchstaben-Schlüssel verwenden.",
        "<strong class='text-white'>Erst Produkt, dann Kontrakt.</strong> Suchen Sie das Produkt mit <code>product/find?name=NQ</code>, und lösen Sie dann den aktiven Kontrakt dafür auf. Dieser zweistufige Weg hält Sie bei dokumentierten, stabilen Operationen.",
      ],
    },
    { type: "paragraph", html: "Möglicherweise stoßen Sie in freier Wildbahn auf eine Route <code>contract/list</code>. Sie existiert, ist aber undokumentiert und nicht empfohlen, sie ist kein unterstützter &ldquo;alles auflisten&rdquo;-Aufruf, und darauf zu bauen lädt zu Problemen ein. Bleiben Sie bei <code>contract/find</code> und dem Vorschlags-Endpunkt, cachen Sie die Ergebnisse und aktualisieren Sie Ihren Cache bei jedem Kontraktrollover." },
    { type: "heading", text: "Eine 90-Sekunden-Checkliste" },
    { type: "paragraph", html: "Bevor Sie einen Bug-Report einreichen, gehen Sie diese Liste durch. Sie klärt fast jedes <code>product/find</code>-404." },
    {
      type: "table",
      headers: ["Prüfpunkt", "Wie es &ldquo;richtig&rdquo; aussieht"],
      rows: [
        ["HTTP-Methode", "GET, nicht POST"],
        ["Parameter", "Im Query-String (?name=ES), nicht in einem JSON-Body"],
        ["Zusätzliche Felder", "Kein isAutomated oder andere reine Order-Felder bei einem find-Aufruf"],
        ["Basis-URL", "demo.tradovateapi.com/v1 oder live.tradovateapi.com/v1, mit dem /v1"],
        ["Pfadschreibweise", "Genau product/find / contract/find, kleingeschrieben"],
        ["Host", "Nicht api.tradovate.com (das ist die Dokumentationsseite)"],
        ["Transportweg", "REST-Route über HTTPS, keine reine WebSocket-Operation"],
      ],
    },
    { type: "paragraph", html: "Wenn alles oben stimmt und Sie trotzdem speziell bei <code>product/find</code> ein 404 erhalten, während andere GET-Aufrufe funktionieren, erfassen Sie die rohe Anfrage und Antwort und wenden Sie sich an den API-Support von Tradovate, aber das ist selten. Fast immer liegt das Problem bei einer der obigen Zeilen." },
    { type: "paragraph", html: "Gut zu wissen, welche Fehler <em>nicht</em> dieser hier sind: Ein 401 bedeutet, dass Ihr Token veraltet oder fehlt (erneuern Sie es, bevor es abläuft), und ein &ldquo;symbol is inaccessible&rdquo; oder 403 bei einer Quote-Anfrage bedeutet ein Marktdaten-Berechtigungsproblem, kein Suchproblem. Kontrakt- und Produktabfragen selbst benötigen nur ein gültiges Token, kein Datenabonnement." },
    { type: "heading", text: "Möchten Sie die Symbolsuche für sich erledigen lassen?" },
    { type: "paragraph", html: "Token-Erneuerung, Frontmonat-Auflösung und Kontraktabfragen pro Symbol einzurichten ist die Art von Detailarbeit, die ein Wochenende verschlingt und beim nächsten Kontraktrollover wieder ausfällt. Wenn Ihr eigentliches Ziel ist, einen TradingView-Alert auszulösen und ihn als Live-Order bei Tradovate landen zu lassen, ohne die REST-Ebene zu betreuen, können Sie die rohe API komplett überspringen und eine Bridge Symbole zuordnen und Orders für Sie routen lassen." },
    { type: "paragraph", html: "Automatisieren Sie Ihre Tradovate-Orders von TradingView aus, ohne die rohe API zu berühren, und lassen Sie PickMyTrade die Symbolsuche und das Order-Routing für Sie übernehmen." },
  ], es: [
    { type: "paragraph", html: "Envió una solicitud a <code>product/find</code>, y en lugar de un JSON ordenado, el servidor devolvió un 404 seco. Aquí no hay nada, dice. Pero el endpoint no falta. En la práctica, ese 404 casi siempre significa que la solicitud tiene un formato incorrecto, no que la ruta no exista. Nueve de cada diez veces se reduce a uno de dos errores: envió sus parámetros en un cuerpo JSON en lugar de en la URL, o está apuntando al host o la ruta incorrectos. Corrija el formato de la llamada y <code>product/find</code> (junto con su primo cercano <code>contract/find</code>) volverá a entregar datos." },
    { type: "paragraph", html: "Aquí va la versión corta, después el porqué y el cómo." },
    { type: "quote", html: "<strong class='text-white'>Solución rápida:</strong> llame a <code>product/find</code> como <strong class='text-white'>GET</strong> con el símbolo en la <strong class='text-white'>cadena de consulta</strong>, <code>GET https://demo.tradovateapi.com/v1/product/find?name=ES</code>, no como POST con un cuerpo JSON. Para obtener el contrato realmente negociable, use <code>contract/find?name=ESU6</code>. Ambos aceptan los mismos parámetros." },
    { type: "heading", text: "Por qué ocurre el 404" },
    { type: "paragraph", html: "Un 404 en esta llamada es engañoso porque estamos entrenados para leerlo como &ldquo;esta URL no existe&rdquo;. Sin embargo, en la API REST de Tradovate, el mismo estado aparece cuando el enrutador no puede hacer coincidir la solicitud que realmente envió con una operación real. Un puñado de errores concretos lo provoca." },
    { type: "paragraph", html: "<strong class='text-white'>Envió un cuerpo JSON en lugar de una cadena de consulta.</strong> Este es el gran error. <code>product/find</code> es una operación de lectura, y Tradovate espera que las operaciones de lectura sean solicitudes GET con parámetros añadidos a la URL. Si envía algo como <code>{\"name\":\"es\",\"isAutomated\":true}</code> como cuerpo JSON mediante POST, la solicitud nunca se resuelve como la operación find y obtiene un 404. Ahí hay dos cosas incorrectas a la vez: el formato de cuerpo frente a cadena de consulta, y el campo adicional <code>isAutomated</code> que <code>find</code> no acepta en primer lugar. Elimine ambos." },
    { type: "paragraph", html: "<strong class='text-white'>Omitió el prefijo de versión o escribió mal el host.</strong> Toda llamada REST vive bajo <code>/v1/</code>. La base es <code>https://demo.tradovateapi.com/v1</code> para simulación y <code>https://live.tradovateapi.com/v1</code> para real. Si omite el <code>/v1</code>, apunta a <code>api.tradovate.com</code> (ese es el sitio de documentación, no la API) o se equivoca al escribir el subdominio, no hay una ruta coincidente, 404." },
    { type: "paragraph", html: "<strong class='text-white'>Cambió las mayúsculas/minúsculas o la ortografía de la ruta.</strong> La ruta tiene dos partes: una entidad y una operación, unidas por una barra, como <code>product/find</code> o <code>contract/find</code>. Escriba <code>Product/Find</code>, <code>products/find</code> o <code>product/search</code> y ninguna se resolverá." },
    { type: "paragraph", html: "<strong class='text-white'>Está llamando a una operación que no está implementada en ese transporte.</strong> Algunas operaciones existen a través de WebSocket pero no en la ruta REST simple, y viceversa. Si copia una llamada pensada para una y la envía a la otra, verá un 404 con un cuerpo que nombra literalmente la operación faltante, como <code>\"Not found: md/getChart\"</code>. Esa es su pista de que la ruta está bien, pero el transporte es incorrecto." },
    { type: "paragraph", html: "Una cosa que un 404 <em>no</em> es: un problema de autenticación. Si su token de acceso falta o expiró, obtiene un 401, no un 404. Así que si está viendo un 404, no pierda tiempo regenerando tokens; revise primero el formato de la solicitud y la URL." },
    { type: "heading", text: "La solución: GET con cadena de consulta" },
    { type: "paragraph", html: "Reconstruya la llamada como GET y mueva el símbolo a la cadena de consulta. Ese único cambio resuelve la abrumadora mayoría de estos 404." },
    { type: "quote", html: "GET https://demo.tradovateapi.com/v1/product/find?name=ES<br>Authorization: Bearer &lt;your-access-token&gt;<br>Accept: application/json" },
    { type: "paragraph", html: "Sustituya <code>ES</code> por la raíz de producto que busque, <code>MES</code>, <code>NQ</code>, <code>MNQ</code>, <code>CL</code>, y así sucesivamente. La respuesta es el registro del producto para ese instrumento: su id, nombre, tipo de producto, bolsa, tamaño de tick y valor por punto. Note que no hay cuerpo de solicitud alguno. Nada que serializar, nada que salga mal." },
    { type: "paragraph", html: "Si estaba usando una librería cliente o un puente que construye la solicitud por usted y sigue viendo 404, revise qué está enviando realmente en la conexión. Sorprendentemente, muchos momentos de &ldquo;la API está rota&rdquo; resultan ser un asistente que envuelve silenciosamente sus parámetros en un cuerpo POST. Apúntelo a GET, y la misma búsqueda de símbolo que fallaba hace un momento vuelve a funcionar sin problemas." },
    { type: "heading", text: "Obtenga el contrato negociable con contract/find" },
    { type: "paragraph", html: "<code>product/find</code> le informa sobre la familia de instrumentos. No le dice a qué contrato enrutar realmente una orden, porque un producto no expira, un contrato sí. Para eso, recurra a <code>contract/find</code>, que toma exactamente los mismos parámetros de consulta:" },
    { type: "quote", html: "GET https://demo.tradovateapi.com/v1/contract/find?name=ESU6" },
    { type: "paragraph", html: "El <code>name</code> aquí es el símbolo de contrato completo, no solo la raíz. Tradovate lo construye a partir de tres piezas sin espacios: la raíz del producto, un único código de mes y el último dígito del año. Así, <code>ESU6</code> es el E-mini S&amp;P 500 para <strong class='text-white'>U</strong> (septiembre) <strong class='text-white'>6</strong> (2026). Cambie la letra del mes y el dígito del año a medida que los contratos rotan; los meses trimestrales de índices bursátiles son H, M, U y Z (marzo, junio, septiembre, diciembre). El mes frontal rota a lo largo del año, así que confirme el contrato activo actual en lugar de fijar uno que está a punto de expirar." },
    { type: "paragraph", html: "Si alimenta <code>contract/find</code> con un símbolo que no existe o que ya expiró, puede obtener un resultado vacío en lugar de un contrato limpio, otra razón para resolver primero el mes frontal en vivo en lugar de adivinar. Una vez que tenga de vuelta el id del contrato, ese es el valor que entrega a la colocación de órdenes, las consultas de posiciones y las suscripciones de datos de mercado." },
    { type: "heading", text: "Cuando no conoce el símbolo exacto" },
    { type: "paragraph", html: "¿Qué pasa si no tiene el código de contrato preciso y solo quiere buscar? Primero, ajuste sus expectativas: no existe un endpoint público de &ldquo;deme cada símbolo&rdquo;. La API está construida en torno a búsquedas específicas y espera que almacene en caché lo que obtiene en lugar de traer una lista enorme en cada ejecución." },
    { type: "paragraph", html: "Dos rutas prácticas:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Sugerencias tipo autocompletar.</strong> Tradovate tiene un endpoint de sugerencia de contratos que se comporta como el cuadro de búsqueda de la plataforma; usted envía una cadena de texto parcial y un límite de resultados, y devuelve contratos coincidentes. Es la forma más limpia de convertir &ldquo;el usuario escribió <code>MNQ</code>&rdquo; en un contrato real y actual. Confirme los nombres exactos de los parámetros en la referencia actual de la API antes de integrarlo, ya que los endpoints de sugerencia usan claves cortas de una sola letra.",
        "<strong class='text-white'>Primero el producto, luego el contrato.</strong> Busque el producto con <code>product/find?name=NQ</code>, y luego resuelva el contrato activo correspondiente. Este proceso de dos pasos le mantiene trabajando con operaciones documentadas y estables.",
      ],
    },
    { type: "paragraph", html: "Puede encontrarse con una ruta <code>contract/list</code> en el mundo real. Existe, pero no está documentada ni se recomienda; no es una llamada compatible de &ldquo;listar todo&rdquo;, y construir sobre ella invita a fallos. Utilice <code>contract/find</code> y el endpoint de sugerencia, guarde los resultados en caché y actualícela en cada rotación de contrato." },
    { type: "heading", text: "Una lista de verificación de 90 segundos" },
    { type: "paragraph", html: "Antes de presentar un informe de error, recorra esta lista. Resuelve casi todos los 404 de <code>product/find</code>." },
    {
      type: "table",
      headers: ["Verificación", "Cómo se ve &ldquo;correcto&rdquo;"],
      rows: [
        ["Método HTTP", "GET, no POST"],
        ["Parámetros", "En la cadena de consulta (?name=ES), no en un cuerpo JSON"],
        ["Campos adicionales", "Sin isAutomated ni otros campos exclusivos de órdenes en una llamada find"],
        ["URL base", "demo.tradovateapi.com/v1 o live.tradovateapi.com/v1, con el /v1"],
        ["Ortografía de la ruta", "Exactamente product/find / contract/find, en minúsculas"],
        ["Host", "No api.tradovate.com (ese es el sitio de documentación)"],
        ["Transporte", "Ruta REST sobre HTTPS, no una operación exclusiva de WebSocket"],
      ],
    },
    { type: "paragraph", html: "Si todo lo anterior está correcto y aun así obtiene un 404 específicamente en <code>product/find</code> mientras otras llamadas GET funcionan, capture la solicitud y la respuesta en bruto y llévelas al soporte de la API de Tradovate, pero eso es poco frecuente. Casi siempre, el problema es una de las filas anteriores." },
    { type: "paragraph", html: "Vale la pena saber qué errores <em>no</em> son este: un 401 significa que su token está caducado o falta (renuévelo antes de que expire), y un &ldquo;symbol is inaccessible&rdquo; o 403 en una solicitud de cotización significa un problema de derechos de datos de mercado, no un problema de búsqueda. Las propias búsquedas de contratos y productos solo necesitan un token válido, sin suscripción de datos requerida." },
    { type: "heading", text: "¿Quiere que le resuelvan la búsqueda de símbolos?" },
    { type: "paragraph", html: "Configurar la renovación de tokens, la resolución del mes frontal y las búsquedas de contratos por símbolo es el tipo de trabajo de fontanería que consume un fin de semana y luego se rompe en la siguiente rotación de contrato. Si su objetivo real es disparar una alerta de TradingView y que se convierta en una orden real en Tradovate, sin tener que vigilar la capa REST, puede saltarse la API en bruto por completo y dejar que un puente mapee símbolos y enrute órdenes por usted." },
    { type: "paragraph", html: "Automatice sus órdenes de Tradovate desde TradingView sin tocar la API en bruto y deje que PickMyTrade se encargue de la búsqueda de símbolos y el enrutamiento de órdenes por usted." },
  ], fr: [
    { type: "paragraph", html: "Vous avez envoyé une requête à <code>product/find</code>, et au lieu d'une charge utile JSON bien formée, le serveur a renvoyé une 404 sèche. Rien ici, dit-il. Mais l'endpoint n'est pas manquant. En pratique, cette 404 signifie presque toujours que la requête est mal formée, pas que la route n'existe pas. Neuf fois sur dix, cela se résume à l'une de ces deux erreurs : vous avez envoyé vos paramètres dans un corps JSON au lieu de l'URL, ou vous visez le mauvais hôte ou le mauvais chemin. Corrigez la forme de l'appel, et <code>product/find</code> (ainsi que son proche cousin <code>contract/find</code>) recommence à vous fournir des données." },
    { type: "paragraph", html: "Voici la version courte, puis le pourquoi et le comment." },
    { type: "quote", html: "<strong class='text-white'>Correctif rapide :</strong> appelez <code>product/find</code> en <strong class='text-white'>GET</strong> avec le symbole dans la <strong class='text-white'>chaîne de requête</strong>, <code>GET https://demo.tradovateapi.com/v1/product/find?name=ES</code>, pas en POST avec un corps JSON. Pour obtenir le contrat réellement négociable, utilisez <code>contract/find?name=ESU6</code>. Les deux prennent les mêmes paramètres." },
    { type: "heading", text: "Pourquoi la 404 se produit" },
    { type: "paragraph", html: "Une 404 sur cet appel est trompeuse, car nous sommes formés à la lire comme &laquo;cette URL n'existe pas&raquo;. Sur l'API REST de Tradovate, pourtant, le même statut apparaît lorsque le routeur ne parvient pas à faire correspondre la requête réellement envoyée à une opération réelle. Une poignée d'erreurs précises en est la cause." },
    { type: "paragraph", html: "<strong class='text-white'>Vous avez envoyé un corps JSON au lieu d'une chaîne de requête.</strong> C'est l'erreur la plus courante. <code>product/find</code> est une opération de lecture, et Tradovate attend que les opérations de lecture soient des requêtes GET avec des paramètres ajoutés à l'URL. Si vous envoyez en POST quelque chose comme <code>{\"name\":\"es\",\"isAutomated\":true}</code> comme corps JSON, la requête ne se résout jamais en opération find et vous obtenez une 404. Deux choses sont fausses à la fois : la forme corps contre chaîne de requête, et le champ supplémentaire <code>isAutomated</code> que <code>find</code> n'accepte pas du tout. Retirez les deux." },
    { type: "paragraph", html: "<strong class='text-white'>Vous avez omis le préfixe de version ou mal orthographié l'hôte.</strong> Tout appel REST se trouve sous <code>/v1/</code>. La base est <code>https://demo.tradovateapi.com/v1</code> pour la simulation et <code>https://live.tradovateapi.com/v1</code> pour le réel. Omettez le <code>/v1</code>, visez <code>api.tradovate.com</code> (c'est le site de documentation, pas l'API), ou faites une faute de frappe dans le sous-domaine, et il n'y a aucune route correspondante, 404." },
    { type: "paragraph", html: "<strong class='text-white'>Vous avez modifié la casse ou l'orthographe du chemin.</strong> Le chemin comporte deux parties : une entité et une opération, jointes par une barre oblique, comme <code>product/find</code> ou <code>contract/find</code>. Écrivez <code>Product/Find</code>, <code>products/find</code> ou <code>product/search</code>, et aucun ne se résout." },
    { type: "paragraph", html: "<strong class='text-white'>Vous appelez une opération non implémentée sur ce transport.</strong> Certaines opérations existent via WebSocket mais pas sur la route REST simple, et inversement. Si vous copiez un appel destiné à l'un et l'envoyez à l'autre, vous verrez une 404 avec un corps qui nomme littéralement l'opération manquante, comme <code>\"Not found: md/getChart\"</code>. C'est votre indice que la route est correcte, mais que le transport est erroné." },
    { type: "paragraph", html: "Une chose qu'une 404 n'est <em>pas</em> : un problème d'authentification. Si votre jeton d'accès est manquant ou expiré, vous obtenez une 401, pas une 404. Donc si vous êtes face à une 404, ne perdez pas de temps à régénérer des jetons, examinez d'abord la forme de la requête et l'URL." },
    { type: "heading", text: "La correction : GET avec une chaîne de requête" },
    { type: "paragraph", html: "Reconstruisez l'appel en GET et déplacez le symbole dans la chaîne de requête. Ce seul changement résout l'écrasante majorité de ces 404." },
    { type: "quote", html: "GET https://demo.tradovateapi.com/v1/product/find?name=ES<br>Authorization: Bearer &lt;your-access-token&gt;<br>Accept: application/json" },
    { type: "paragraph", html: "Remplacez <code>ES</code> par la racine de produit recherchée, <code>MES</code>, <code>NQ</code>, <code>MNQ</code>, <code>CL</code>, et ainsi de suite. La réponse est l'enregistrement produit de cet instrument : son id, son nom, son type de produit, sa bourse, la taille de tick et la valeur par point. Notez qu'il n'y a aucun corps de requête. Rien à sérialiser, rien à mal faire." },
    { type: "paragraph", html: "Si vous utilisiez une bibliothèque cliente ou un pont qui construit la requête pour vous et que vous voyez toujours des 404, vérifiez ce qu'il envoie réellement sur le réseau. Un nombre surprenant de moments &laquo;l'API est cassée&raquo; se révèlent être un assistant qui enveloppe silencieusement vos paramètres dans un corps POST. Pointez-le vers GET, et la même recherche de symbole qui échouait il y a un instant fonctionne à nouveau proprement." },
    { type: "heading", text: "Obtenir le contrat négociable avec contract/find" },
    { type: "paragraph", html: "<code>product/find</code> vous renseigne sur la famille d'instruments. Il ne vous dit pas vers quel contrat router réellement un ordre, car un produit n'expire pas, un contrat oui. Pour cela, utilisez <code>contract/find</code>, qui prend exactement les mêmes paramètres de requête :" },
    { type: "quote", html: "GET https://demo.tradovateapi.com/v1/contract/find?name=ESU6" },
    { type: "paragraph", html: "Le <code>name</code> ici est le symbole de contrat complet, pas seulement la racine. Tradovate le construit à partir de trois éléments sans espaces : la racine du produit, un code de mois unique, et le dernier chiffre de l'année. Ainsi, <code>ESU6</code> est l'E-mini S&amp;P 500 pour <strong class='text-white'>U</strong> (septembre) <strong class='text-white'>6</strong> (2026). Changez la lettre du mois et le chiffre de l'année à mesure que les contrats roulent ; les mois trimestriels des indices actions sont H, M, U et Z (mars, juin, septembre, décembre). Le mois avant tourne au fil de l'année, confirmez donc le contrat actif actuel plutôt que de coder en dur un contrat sur le point d'expirer." },
    { type: "paragraph", html: "Fournissez à <code>contract/find</code> un symbole qui n'existe pas ou qui a déjà expiré, et vous pourriez obtenir un résultat vide plutôt qu'un contrat propre, une raison de plus de résoudre d'abord le mois avant en direct plutôt que de deviner. Une fois que vous avez récupéré l'id du contrat, c'est la valeur que vous transmettez au passage d'ordres, aux consultations de positions et aux abonnements de données de marché." },
    { type: "heading", text: "Quand vous ne connaissez pas le symbole exact" },
    { type: "paragraph", html: "Que faire si vous n'avez pas le code de contrat précis et voulez simplement chercher ? D'abord, ajustez vos attentes : il n'existe aucun endpoint public &laquo;donnez-moi chaque symbole&raquo;. L'API est conçue autour de recherches ciblées, et elle attend que vous mettiez en cache ce que vous récupérez plutôt que de récupérer une liste géante à chaque exécution." },
    { type: "paragraph", html: "Deux pistes pratiques :" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Suggestion de saisie semi-automatique.</strong> Tradovate dispose d'un endpoint de suggestion de contrats qui se comporte comme le champ de recherche de la plateforme, vous transmettez une chaîne de texte partielle et une limite de résultats, et il renvoie les contrats correspondants. C'est le moyen le plus propre de transformer &laquo;l'utilisateur a tapé <code>MNQ</code>&raquo; en un contrat réel et actuel. Confirmez les noms exacts des paramètres dans la référence API actuelle avant de l'intégrer, car les endpoints de suggestion utilisent des clés courtes à une lettre.",
        "<strong class='text-white'>D'abord le produit, puis le contrat.</strong> Recherchez le produit avec <code>product/find?name=NQ</code>, puis résolvez le contrat actif correspondant. Cette approche en deux étapes vous maintient sur des opérations documentées et stables.",
      ],
    },
    { type: "paragraph", html: "Vous pourriez rencontrer une route <code>contract/list</code> sur le terrain. Elle existe, mais n'est pas documentée et n'est pas recommandée, ce n'est pas un appel &laquo;tout lister&raquo; pris en charge, et s'appuyer dessus invite à des problèmes. Restez sur <code>contract/find</code> et l'endpoint de suggestion, mettez les résultats en cache et actualisez votre cache à chaque roulement de contrat." },
    { type: "heading", text: "Une checklist de 90 secondes" },
    { type: "paragraph", html: "Avant de déposer un rapport de bug, parcourez cette liste. Elle résout presque toutes les 404 de <code>product/find</code>." },
    {
      type: "table",
      headers: ["Vérification", "À quoi ressemble &laquo;correct&raquo;"],
      rows: [
        ["Méthode HTTP", "GET, pas POST"],
        ["Paramètres", "Dans la chaîne de requête (?name=ES), pas dans un corps JSON"],
        ["Champs supplémentaires", "Pas de isAutomated ni d'autres champs réservés aux ordres sur un appel find"],
        ["URL de base", "demo.tradovateapi.com/v1 ou live.tradovateapi.com/v1, avec le /v1"],
        ["Orthographe du chemin", "Exactement product/find / contract/find, en minuscules"],
        ["Hôte", "Pas api.tradovate.com (c'est le site de documentation)"],
        ["Transport", "Route REST via HTTPS, pas une opération réservée au WebSocket"],
      ],
    },
    { type: "paragraph", html: "Si tout ce qui précède est vérifié et que vous obtenez toujours une 404 spécifiquement sur <code>product/find</code> alors que d'autres appels GET fonctionnent, capturez la requête et la réponse brutes et adressez-vous au support API de Tradovate, mais c'est rare. Presque à chaque fois, le problème est l'une des lignes ci-dessus." },
    { type: "paragraph", html: "Il est utile de savoir quelles erreurs ne sont <em>pas</em> celle-ci : une 401 signifie que votre jeton est périmé ou manquant (renouvelez-le avant qu'il n'expire), et un &laquo;symbol is inaccessible&raquo; ou une 403 sur une requête de cotation signifie un problème de droits sur les données de marché, pas un problème de recherche. Les recherches de contrats et de produits elles-mêmes n'ont besoin que d'un jeton valide, aucun abonnement aux données requis." },
    { type: "heading", text: "Vous voulez que la recherche de symbole soit gérée pour vous ?" },
    { type: "paragraph", html: "Mettre en place le renouvellement de jeton, la résolution du mois avant et les recherches de contrat par symbole est le genre de plomberie qui engloutit un week-end puis se casse au roulement de contrat suivant. Si votre véritable objectif est de déclencher une alerte TradingView et de la voir aboutir à un ordre réel chez Tradovate, sans surveiller la couche REST, vous pouvez complètement ignorer l'API brute et laisser un pont associer les symboles et router les ordres pour vous." },
    { type: "paragraph", html: "Automatisez vos ordres Tradovate depuis TradingView sans toucher à l'API brute et laissez PickMyTrade gérer pour vous la recherche de symboles et le routage des ordres." },
  ], it: [
    { type: "paragraph", html: "Ha inviato una richiesta a <code>product/find</code>, e invece di un payload JSON ordinato, il server ha restituito un secco 404. Qui non c'è nulla, dice. Ma l'endpoint non manca. In pratica, quel 404 significa quasi sempre che la richiesta è strutturata male, non che la route non esista. Nove volte su dieci si tratta di uno di due errori: ha inviato i parametri in un corpo JSON invece che nell'URL, oppure sta puntando all'host o al percorso sbagliato. Corregga la forma della chiamata e <code>product/find</code> (insieme al suo stretto parente <code>contract/find</code>) tornerà a fornirle dati." },
    { type: "paragraph", html: "Ecco la versione breve, poi il perché e il come." },
    { type: "quote", html: "<strong class='text-white'>Soluzione rapida:</strong> chiami <code>product/find</code> come <strong class='text-white'>GET</strong> con il simbolo nella <strong class='text-white'>stringa di query</strong>, <code>GET https://demo.tradovateapi.com/v1/product/find?name=ES</code>, non come POST con un corpo JSON. Per ottenere il contratto effettivamente negoziabile, usi <code>contract/find?name=ESU6</code>. Entrambi accettano gli stessi parametri." },
    { type: "heading", text: "Perché si verifica il 404" },
    { type: "paragraph", html: "Un 404 su questa chiamata è fuorviante perché siamo abituati a leggerlo come &ldquo;questo URL non esiste&rdquo;. Sull'API REST di Tradovate, però, lo stesso stato compare anche quando il router non riesce ad abbinare la richiesta effettivamente inviata a un'operazione reale. Sono alcuni errori specifici a causarlo." },
    { type: "paragraph", html: "<strong class='text-white'>Ha inviato un corpo JSON invece di una stringa di query.</strong> Questo è l'errore principale. <code>product/find</code> è un'operazione di lettura, e Tradovate si aspetta che le operazioni di lettura siano richieste GET con parametri aggiunti all'URL. Se invia con POST qualcosa come <code>{\"name\":\"es\",\"isAutomated\":true}</code> come corpo JSON, la richiesta non si risolve mai nell'operazione find e riceve un 404. Ci sono due errori contemporaneamente: la forma corpo contro stringa di query, e il campo aggiuntivo <code>isAutomated</code> che <code>find</code> non accetta comunque. Elimini entrambi." },
    { type: "paragraph", html: "<strong class='text-white'>Ha omesso il prefisso di versione o ha sbagliato l'host.</strong> Ogni chiamata REST si trova sotto <code>/v1/</code>. La base è <code>https://demo.tradovateapi.com/v1</code> per la simulazione e <code>https://live.tradovateapi.com/v1</code> per il live. Se omette <code>/v1</code>, punta a <code>api.tradovate.com</code> (quello è il sito di documentazione, non l'API), o sbaglia a digitare il sottodominio, non c'è alcuna route corrispondente, 404." },
    { type: "paragraph", html: "<strong class='text-white'>Ha cambiato maiuscole/minuscole o l'ortografia del percorso.</strong> Il percorso è composto da due parti: un'entità e un'operazione, unite da una barra, come <code>product/find</code> o <code>contract/find</code>. Scriva <code>Product/Find</code>, <code>products/find</code> o <code>product/search</code> e nessuna si risolverà." },
    { type: "paragraph", html: "<strong class='text-white'>Sta chiamando un'operazione non implementata su quel trasporto.</strong> Alcune operazioni esistono via WebSocket ma non sulla route REST semplice, e viceversa. Se copia una chiamata pensata per l'una e la invia all'altra, vedrà un 404 con un corpo che nomina letteralmente l'operazione mancante, come <code>\"Not found: md/getChart\"</code>. Questo è l'indizio che la route è corretta, ma il trasporto è sbagliato." },
    { type: "paragraph", html: "Una cosa che un 404 <em>non</em> è: un problema di autenticazione. Se il suo token di accesso manca o è scaduto, riceve un 401, non un 404. Quindi, se si trova davanti a un 404, non perda tempo a rigenerare token, controlli prima la forma della richiesta e l'URL." },
    { type: "heading", text: "La soluzione: GET con una stringa di query" },
    { type: "paragraph", html: "Ricostruisca la chiamata come GET e sposti il simbolo nella stringa di query. Questo singolo cambiamento risolve la stragrande maggioranza di questi 404." },
    { type: "quote", html: "GET https://demo.tradovateapi.com/v1/product/find?name=ES<br>Authorization: Bearer &lt;your-access-token&gt;<br>Accept: application/json" },
    { type: "paragraph", html: "Sostituisca <code>ES</code> con la radice di prodotto desiderata, <code>MES</code>, <code>NQ</code>, <code>MNQ</code>, <code>CL</code>, e così via. La risposta è il record del prodotto per quello strumento: il suo id, nome, tipo di prodotto, borsa, tick size e valore per punto. Noti che non c'è alcun corpo di richiesta. Nulla da serializzare, nulla che possa andare storto." },
    { type: "paragraph", html: "Se stava usando una libreria client o un bridge che costruisce la richiesta per lei e continua a vedere 404, controlli cosa sta effettivamente inviando sulla rete. Un numero sorprendente di momenti &ldquo;l'API è rotta&rdquo; si rivela essere un helper che silenziosamente avvolge i suoi parametri in un corpo POST. Lo punti su GET, e la stessa ricerca di simbolo che falliva un attimo fa torna a funzionare pulita." },
    { type: "heading", text: "Ottenere il contratto negoziabile con contract/find" },
    { type: "paragraph", html: "<code>product/find</code> le dà informazioni sulla famiglia di strumenti. Non le dice a quale contratto instradare effettivamente un ordine, perché un prodotto non scade, un contratto sì. Per questo, ricorra a <code>contract/find</code>, che accetta esattamente gli stessi parametri di query:" },
    { type: "quote", html: "GET https://demo.tradovateapi.com/v1/contract/find?name=ESU6" },
    { type: "paragraph", html: "Il <code>name</code> qui è il simbolo completo del contratto, non solo la radice. Tradovate lo costruisce da tre parti senza spazi: la radice del prodotto, un singolo codice mese e l'ultima cifra dell'anno. Quindi <code>ESU6</code> è l'E-mini S&amp;P 500 per <strong class='text-white'>U</strong> (settembre) <strong class='text-white'>6</strong> (2026). Cambi la lettera del mese e la cifra dell'anno man mano che i contratti ruotano; i mesi trimestrali degli indici azionari sono H, M, U e Z (marzo, giugno, settembre, dicembre). Il mese frontale ruota nel corso dell'anno, quindi confermi il contratto attivo attuale invece di codificarne uno che sta per scadere." },
    { type: "paragraph", html: "Se fornisce a <code>contract/find</code> un simbolo che non esiste o è già scaduto, potrebbe ottenere un risultato vuoto invece di un contratto pulito, un altro motivo per risolvere prima il mese frontale in tempo reale invece di indovinare. Una volta ottenuto l'id del contratto, quello è il valore che passa al piazzamento degli ordini, alle consultazioni delle posizioni e agli abbonamenti ai dati di mercato." },
    { type: "heading", text: "Quando non conosce il simbolo esatto" },
    { type: "paragraph", html: "E se non ha il codice di contratto preciso e vuole solo cercare? Prima di tutto, ridimensioni le sue aspettative: non esiste un endpoint pubblico &ldquo;mi dia ogni simbolo&rdquo;. L'API è costruita attorno a ricerche mirate e si aspetta che lei metta in cache ciò che recupera invece di prelevare un elenco enorme a ogni esecuzione." },
    { type: "paragraph", html: "Due percorsi pratici:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Suggerimento a completamento automatico.</strong> Tradovate ha un endpoint di suggerimento contratti che si comporta come il campo di ricerca della piattaforma, lei passa una stringa di testo parziale e un limite di risultati, e restituisce i contratti corrispondenti. È il modo più pulito per trasformare &ldquo;l'utente ha digitato <code>MNQ</code>&rdquo; in un contratto reale e attuale. Confermi i nomi esatti dei parametri nel riferimento API attuale prima di integrarlo, poiché gli endpoint di suggerimento usano chiavi brevi a una sola lettera.",
        "<strong class='text-white'>Prima il prodotto, poi il contratto.</strong> Cerchi il prodotto con <code>product/find?name=NQ</code>, poi risolva il contratto attivo corrispondente. Questo processo in due passaggi la mantiene su operazioni documentate e stabili.",
      ],
    },
    { type: "paragraph", html: "Potrebbe imbattersi in una route <code>contract/list</code> in giro. Esiste, ma non è documentata e non è consigliata, non è una chiamata supportata di &ldquo;elenca tutto&rdquo;, e costruirci sopra invita a problemi. Si attenga a <code>contract/find</code> e all'endpoint di suggerimento, metta in cache i risultati e aggiorni la cache a ogni rollover di contratto." },
    { type: "heading", text: "Una checklist di 90 secondi" },
    { type: "paragraph", html: "Prima di presentare una segnalazione di bug, scorra questo elenco. Risolve quasi ogni 404 di <code>product/find</code>." },
    {
      type: "table",
      headers: ["Controllo", "Come appare &ldquo;corretto&rdquo;"],
      rows: [
        ["Metodo HTTP", "GET, non POST"],
        ["Parametri", "Nella stringa di query (?name=ES), non in un corpo JSON"],
        ["Campi extra", "Nessun isAutomated o altri campi solo per ordini in una chiamata find"],
        ["URL di base", "demo.tradovateapi.com/v1 o live.tradovateapi.com/v1, con il /v1"],
        ["Ortografia del percorso", "Esattamente product/find / contract/find, minuscolo"],
        ["Host", "Non api.tradovate.com (quello è il sito di documentazione)"],
        ["Trasporto", "Route REST su HTTPS, non un'operazione solo WebSocket"],
      ],
    },
    { type: "paragraph", html: "Se tutto quanto sopra è verificato e riceve comunque un 404 specificamente su <code>product/find</code> mentre altre chiamate GET funzionano, catturi la richiesta e la risposta grezze e si rivolga al supporto API di Tradovate, ma questo è raro. Quasi sempre, il problema è una delle righe sopra." },
    { type: "paragraph", html: "Vale la pena sapere quali errori <em>non</em> sono questo: un 401 significa che il suo token è scaduto o mancante (lo rinnovi prima che scada), e un &ldquo;symbol is inaccessible&rdquo; o 403 su una richiesta di quotazione significa un problema di diritti sui dati di mercato, non un problema di ricerca. Le ricerche di contratti e prodotti in sé richiedono solo un token valido, nessun abbonamento ai dati necessario." },
    { type: "heading", text: "Vuole che la ricerca dei simboli venga gestita per lei?" },
    { type: "paragraph", html: "Configurare il rinnovo del token, la risoluzione del mese frontale e le ricerche di contratto per simbolo è il tipo di lavoro idraulico che divora un weekend e poi si rompe al rollover di contratto successivo. Se il suo vero obiettivo è far scattare un avviso TradingView e vederlo tradursi in un ordine live su Tradovate, senza dover sorvegliare il livello REST, può saltare completamente l'API grezza e lasciare che un bridge mappi i simboli e instradi gli ordini per lei." },
    { type: "paragraph", html: "Automatizzi i suoi ordini Tradovate da TradingView senza toccare l'API grezza e lasci che PickMyTrade gestisca per lei la ricerca dei simboli e l'instradamento degli ordini." },
  ] },
  ctaHeading: { en: "Skip the Raw API", de: "Die rohe API überspringen", es: "Evite la API en bruto", fr: "Passez outre l'API brute", it: "Salti l'API grezza" },
  ctaText: { en: "Automate your Tradovate orders from TradingView without touching the raw API. PickMyTrade handles symbol lookup and order routing for you.", de: "Automatisieren Sie Ihre Tradovate-Orders von TradingView aus, ohne die rohe API zu berühren. PickMyTrade übernimmt die Symbolsuche und das Order-Routing für Sie.", es: "Automatice sus órdenes de Tradovate desde TradingView sin tocar la API en bruto. PickMyTrade se encarga de la búsqueda de símbolos y el enrutamiento de órdenes por usted.", fr: "Automatisez vos ordres Tradovate depuis TradingView sans toucher à l'API brute. PickMyTrade gère pour vous la recherche de symboles et le routage des ordres.", it: "Automatizzi i suoi ordini Tradovate da TradingView senza toccare l'API grezza. PickMyTrade gestisce per lei la ricerca dei simboli e l'instradamento degli ordini." },
  ctaButtonText: { en: "Start Your Free 7-Day Trial", de: "Starten Sie Ihre kostenlose 5-Tage-Testphase", es: "Inicie su prueba gratuita de 5 días", fr: "Démarrez votre essai gratuit de 5 jours", it: "Inizi la sua prova gratuita di 5 giorni" },
  ctaUrl: "https://app.pickmytrade.trade/?register=true&utm_source=content&utm_medium=debugging",
  faqHeading: { en: "Frequently Asked Questions", de: "Häufig gestellte Fragen", es: "Preguntas frecuentes", fr: "Questions fréquentes", it: "Domande frequenti" },
  faqs: { en: [
    { q: "Why does Tradovate's product/find return 404?", a: "Almost always because the request is shaped wrong, not because the route is missing. The most common trigger is sending your symbol in a JSON body instead of the URL query string, or adding fields the endpoint doesn't accept. It's a GET call, so pass the symbol as a query string: GET /v1/product/find?name=ES. A missing /v1/ prefix, the wrong host, or a typo in the path will also produce a 404." },
    { q: "What's the difference between product/find and contract/find?", a: "product/find returns the product, the instrument family, like ES for the E-mini S&P 500. contract/find returns a specific tradable contract with an expiration, like ESU6 for September 2026. They take the same query parameters. Use product/find to look up the instrument, then contract/find to get the exact contract you'll trade or subscribe to." },
    { q: "Is there an endpoint to list every Tradovate symbol?", a: "No. There's no public list-all-symbols endpoint. The API expects you to look up what you need with contract/find or the type-ahead suggest endpoint and cache the results. A contract/list route exists but is undocumented and not recommended, so build your workflow around targeted lookups instead." },
    { q: "Does looking up a contract require a market-data subscription?", a: "No. contract/find and product/find return reference data and work with just a valid access token. A market-data subscription only matters when you subscribe to live quotes. If a lookup succeeds but a quote request fails, that's a data-entitlement issue, not a contract-search problem." },
  ], de: [
    { q: "Warum gibt Tradovates product/find ein 404 zurück?", a: "Fast immer, weil die Anfrage falsch aufgebaut ist, nicht weil die Route fehlt. Der häufigste Auslöser ist, das Symbol in einem JSON-Body statt im URL-Query-String zu senden oder Felder hinzuzufügen, die der Endpunkt nicht akzeptiert. Es ist ein GET-Aufruf, übergeben Sie das Symbol also als Query-String: GET /v1/product/find?name=ES. Ein fehlendes /v1/-Präfix, der falsche Host oder ein Tippfehler im Pfad führen ebenfalls zu einem 404." },
    { q: "Was ist der Unterschied zwischen product/find und contract/find?", a: "product/find liefert das Produkt, die Instrumentenfamilie, wie ES für den E-mini S&P 500. contract/find liefert einen konkreten handelbaren Kontrakt mit Verfallsdatum, wie ESU6 für September 2026. Beide nehmen dieselben Query-Parameter entgegen. Verwenden Sie product/find, um das Instrument nachzuschlagen, und dann contract/find, um den genauen Kontrakt zu erhalten, den Sie handeln oder abonnieren." },
    { q: "Gibt es einen Endpunkt, der jedes Tradovate-Symbol auflistet?", a: "Nein. Es gibt keinen öffentlichen Endpunkt, der alle Symbole auflistet. Die API erwartet, dass Sie das Benötigte mit contract/find oder dem Type-Ahead-Vorschlags-Endpunkt nachschlagen und die Ergebnisse zwischenspeichern. Eine Route contract/list existiert, ist aber undokumentiert und nicht empfohlen, richten Sie Ihren Workflow also stattdessen an gezielten Abfragen aus." },
    { q: "Erfordert die Kontraktabfrage ein Marktdaten-Abonnement?", a: "Nein. contract/find und product/find liefern Referenzdaten und funktionieren mit nur einem gültigen Zugriffstoken. Ein Marktdaten-Abonnement ist erst relevant, wenn Sie Live-Kurse abonnieren. Gelingt eine Abfrage, schlägt aber eine Kursanfrage fehl, ist das ein Berechtigungsproblem bei den Daten, kein Suchproblem." },
  ], es: [
    { q: "¿Por qué product/find de Tradovate devuelve 404?", a: "Casi siempre porque la solicitud tiene un formato incorrecto, no porque falte la ruta. El desencadenante más común es enviar su símbolo en un cuerpo JSON en lugar de en la cadena de consulta de la URL, o añadir campos que el endpoint no acepta. Es una llamada GET, así que pase el símbolo como cadena de consulta: GET /v1/product/find?name=ES. Un prefijo /v1/ faltante, el host incorrecto o un error tipográfico en la ruta también producirán un 404." },
    { q: "¿Cuál es la diferencia entre product/find y contract/find?", a: "product/find devuelve el producto, la familia de instrumentos, como ES para el E-mini S&P 500. contract/find devuelve un contrato negociable específico con vencimiento, como ESU6 para septiembre de 2026. Ambos aceptan los mismos parámetros de consulta. Use product/find para buscar el instrumento y luego contract/find para obtener el contrato exacto que negociará o al que se suscribirá." },
    { q: "¿Existe un endpoint para listar todos los símbolos de Tradovate?", a: "No. No existe un endpoint público que liste todos los símbolos. La API espera que busque lo que necesita con contract/find o el endpoint de sugerencia tipo autocompletar y guarde los resultados en caché. Existe una ruta contract/list, pero no está documentada ni se recomienda, así que construya su flujo de trabajo en torno a búsquedas específicas en su lugar." },
    { q: "¿Consultar un contrato requiere una suscripción de datos de mercado?", a: "No. contract/find y product/find devuelven datos de referencia y funcionan con solo un token de acceso válido. Una suscripción de datos de mercado solo importa cuando se suscribe a cotizaciones en vivo. Si una búsqueda funciona pero una solicitud de cotización falla, eso es un problema de derechos de datos, no un problema de búsqueda de contratos." },
  ], fr: [
    { q: "Pourquoi product/find de Tradovate renvoie-t-il une 404 ?", a: "Presque toujours parce que la requête est mal formée, pas parce que la route est manquante. Le déclencheur le plus courant est l'envoi du symbole dans un corps JSON au lieu de la chaîne de requête de l'URL, ou l'ajout de champs que l'endpoint n'accepte pas. C'est un appel GET, transmettez donc le symbole en chaîne de requête : GET /v1/product/find?name=ES. Un préfixe /v1/ manquant, le mauvais hôte, ou une faute de frappe dans le chemin produiront aussi une 404." },
    { q: "Quelle est la différence entre product/find et contract/find ?", a: "product/find renvoie le produit, la famille d'instruments, comme ES pour l'E-mini S&P 500. contract/find renvoie un contrat négociable spécifique avec une échéance, comme ESU6 pour septembre 2026. Ils prennent les mêmes paramètres de requête. Utilisez product/find pour rechercher l'instrument, puis contract/find pour obtenir le contrat exact que vous négocierez ou auquel vous vous abonnerez." },
    { q: "Existe-t-il un endpoint pour lister tous les symboles Tradovate ?", a: "Non. Il n'existe pas d'endpoint public listant tous les symboles. L'API attend que vous recherchiez ce dont vous avez besoin avec contract/find ou l'endpoint de suggestion, et que vous mettiez les résultats en cache. Une route contract/list existe, mais elle n'est pas documentée ni recommandée, construisez donc plutôt votre flux de travail autour de recherches ciblées." },
    { q: "La recherche d'un contrat nécessite-t-elle un abonnement aux données de marché ?", a: "Non. contract/find et product/find renvoient des données de référence et fonctionnent avec simplement un jeton d'accès valide. Un abonnement aux données de marché n'importe que lorsque vous vous abonnez aux cotations en direct. Si une recherche réussit mais qu'une requête de cotation échoue, c'est un problème de droits sur les données, pas un problème de recherche de contrat." },
  ], it: [
    { q: "Perché product/find di Tradovate restituisce 404?", a: "Quasi sempre perché la richiesta è strutturata male, non perché la route manchi. Il fattore scatenante più comune è inviare il simbolo in un corpo JSON invece che nella stringa di query dell'URL, oppure aggiungere campi che l'endpoint non accetta. È una chiamata GET, quindi passi il simbolo come stringa di query: GET /v1/product/find?name=ES. Anche un prefisso /v1/ mancante, l'host sbagliato o un errore di battitura nel percorso produrranno un 404." },
    { q: "Qual è la differenza tra product/find e contract/find?", a: "product/find restituisce il prodotto, la famiglia di strumenti, come ES per l'E-mini S&P 500. contract/find restituisce uno specifico contratto negoziabile con una scadenza, come ESU6 per settembre 2026. Accettano gli stessi parametri di query. Usi product/find per cercare lo strumento, poi contract/find per ottenere il contratto esatto che negozierà o a cui si abbonerà." },
    { q: "Esiste un endpoint per elencare tutti i simboli Tradovate?", a: "No. Non esiste un endpoint pubblico che elenchi tutti i simboli. L'API si aspetta che lei cerchi ciò di cui ha bisogno con contract/find o l'endpoint di suggerimento a completamento automatico e metta in cache i risultati. Esiste una route contract/list, ma non è documentata né consigliata, quindi costruisca il suo flusso di lavoro attorno a ricerche mirate." },
    { q: "La ricerca di un contratto richiede un abbonamento ai dati di mercato?", a: "No. contract/find e product/find restituiscono dati di riferimento e funzionano con un semplice token di accesso valido. Un abbonamento ai dati di mercato conta solo quando si abbona a quotazioni in tempo reale. Se una ricerca va a buon fine ma una richiesta di quotazione fallisce, si tratta di un problema di diritti sui dati, non di ricerca contratti." },
  ] },
  relatedHeading: { en: "Related Guides", de: "Verwandte Anleitungen", es: "Guías relacionadas", fr: "Guides associés", it: "Guide correlate" },
  disclosureText: { en: "This guide is for educational and informational purposes only and is not financial, investment, or trading advice. Trading futures and other leveraged products carries a substantial risk of loss and is not suitable for every investor. PickMyTrade is an independent third-party automation platform and is not affiliated with, endorsed by, or sponsored by Tradovate, Inc. or Bookmap. All related names, logos, and trademarks are the property of their respective owners. Platform features and steps change over time, so always confirm the current process in the official platform documentation before acting.", de: "Dieser Leitfaden dient ausschließlich Bildungs- und Informationszwecken und stellt keine Finanz-, Anlage- oder Handelsberatung dar. Der Handel mit Futures und anderen gehebelten Produkten birgt ein erhebliches Verlustrisiko und ist nicht für jeden Anleger geeignet. PickMyTrade ist eine unabhängige Drittanbieter-Automatisierungsplattform und steht in keiner Verbindung zu Tradovate, Inc. oder Bookmap und wird von diesen weder unterstützt noch gesponsert. Alle zugehörigen Namen, Logos und Marken sind Eigentum ihrer jeweiligen Inhaber. Plattformfunktionen und -schritte ändern sich im Laufe der Zeit, bestätigen Sie den aktuellen Ablauf daher immer in der offiziellen Plattformdokumentation, bevor Sie handeln.", es: "Esta guía tiene fines educativos e informativos únicamente y no constituye asesoramiento financiero, de inversión o de trading. Operar con futuros y otros productos apalancados conlleva un riesgo sustancial de pérdida y no es adecuado para todos los inversores. PickMyTrade es una plataforma de automatización independiente de terceros y no está afiliada, respaldada ni patrocinada por Tradovate, Inc. o Bookmap. Todos los nombres, logotipos y marcas relacionados son propiedad de sus respectivos dueños. Las funciones y los pasos de la plataforma cambian con el tiempo, así que confirme siempre el proceso actual en la documentación oficial de la plataforma antes de actuar.", fr: "Ce guide est fourni à des fins éducatives et informatives uniquement et ne constitue pas un conseil financier, d'investissement ou de trading. Le trading de contrats à terme et d'autres produits à effet de levier comporte un risque substantiel de perte et ne convient pas à tous les investisseurs. PickMyTrade est une plateforme d'automatisation tierce indépendante et n'est ni affiliée à, ni approuvée ou parrainée par Tradovate, Inc. ou Bookmap. Tous les noms, logos et marques associés sont la propriété de leurs détenteurs respectifs. Les fonctionnalités et les étapes de la plateforme évoluent avec le temps, confirmez donc toujours le processus actuel dans la documentation officielle de la plateforme avant d'agir.", it: "Questa guida ha scopi puramente educativi e informativi e non costituisce consulenza finanziaria, di investimento o di trading. Il trading di futures e altri prodotti a leva comporta un rischio sostanziale di perdita e non è adatto a tutti gli investitori. PickMyTrade è una piattaforma di automazione di terze parti indipendente e non è affiliata, sponsorizzata o approvata da Tradovate, Inc. o Bookmap. Tutti i nomi, i loghi e i marchi correlati sono di proprietà dei rispettivi titolari. Le funzionalità e i passaggi della piattaforma cambiano nel tempo, quindi confermi sempre il processo attuale nella documentazione ufficiale della piattaforma prima di agire." },
};
