export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "ninjatrader-tradovate-stop-not-updating";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/debugging/${SLUG}`;

const META_TITLE = "NinjaTrader-Tradovate Stop Not Updating to Breakeven";
const META_DESCRIPTION =
  "NinjaTrader stop not updating to breakeven on Tradovate? Learn why the change never reaches the broker and how to keep trailing stops in sync.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "NinjaTrader-Tradovate-Stop wird nicht auf Breakeven aktualisiert", es: "El stop de NinjaTrader-Tradovate no se actualiza a breakeven", fr: "Le stop NinjaTrader-Tradovate ne se met pas à jour au breakeven", it: "Lo stop NinjaTrader-Tradovate non si aggiorna al breakeven" },
  dek: { en: "NinjaTrader shows your stop moved to breakeven, price traded straight back through that level, and you ate the full loss anyway. The Tradovate Orders report tells a different story than your screen. Here's why, and how to close the gap.", de: "NinjaTrader zeigt Ihren Stop auf Breakeven verschoben, der Kurs läuft direkt durch dieses Niveau zurück, und Sie tragen trotzdem den vollen Verlust. Der Orders-Bericht von Tradovate erzählt eine andere Geschichte als Ihr Bildschirm. Hier erfahren Sie, warum, und wie Sie die Lücke schließen.", es: "NinjaTrader muestra su stop movido a breakeven, el precio atraviesa ese nivel de vuelta y aun así asume la pérdida completa. El informe Orders de Tradovate cuenta una historia distinta a la de su pantalla. Aquí le explicamos por qué y cómo cerrar la brecha.", fr: "NinjaTrader affiche votre stop déplacé au breakeven, le prix retraverse ce niveau et vous encaissez quand même la perte complète. Le rapport Orders de Tradovate raconte une autre histoire que votre écran. Voici pourquoi, et comment combler l'écart.", it: "NinjaTrader mostra il Suo stop spostato al breakeven, il prezzo riattraversa quel livello e Lei incassa comunque l'intera perdita. Il report Orders di Tradovate racconta una storia diversa dal Suo schermo. Ecco perché, e come colmare il divario." },
  readTime: { en: "8 min read", de: "8 Min. Lesezeit", es: "Lectura de 8 min", fr: "Lecture : 8 min", it: "Lettura di 8 min" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "You watched NinjaTrader slide your stop up to breakeven, price traded straight back through that level, and instead of a scratch you ate the full 20-point loss. Then you opened the Tradovate Orders report and there it was: the stop still parked at your original entry-stop price. That gap is the whole problem. Your strategy shows the new price on your screen, but the modification never landed on the broker's live order. It wears a few different disguises, a stop that never budges from its starting price, a trailing stop reading several ticks off from what your code told it to do, or a change that “just stays orange” and never confirms. Routing your risk through a bridge like PickMyTrade takes out the fragile hop where these silent failures happen, but first you need to understand where the update actually disappears." },
    {
      type: "checklist",
      heading: "Quick Checklist for a Stop That Won't Move to Breakeven",
      items: [
        "<strong class='text-white'>Check the Tradovate Orders report first.</strong> The broker's working order price is your only source of truth, NinjaTrader's display can lag or diverge.",
        "<strong class='text-white'>Confirm the modification wasn't rejected.</strong> A stop moved to the wrong side of a fast market gets rejected, and the old order stays live.",
        "<strong class='text-white'>Validate the new stop price</strong> is below the bid (long) or above the ask (short) before every <code>ChangeOrder()</code> call.",
        "<strong class='text-white'>Refresh your order reference with <code>GetRealtimeOrder()</code></strong> when the strategy flips from historical to real-time.",
        "<strong class='text-white'>Throttle rapid modifications.</strong> A high-volume trailing loop can outrun the broker's acceptance and drop updates on the floor.",
        "<strong class='text-white'>Add error handling around your stop-update method</strong> so a failed change shows up in the log instead of vanishing.",
      ],
    },
    { type: "heading", text: "What “Stop Not Updating to Breakeven” Actually Means" },
    { type: "paragraph", html: "NinjaTrader and Tradovate keep two separate pictures of your order. NinjaTrader holds a local order object that your strategy reads and writes. Tradovate holds the actual working order the exchange will fill. A <code>ChangeOrder()</code>, or a drag on the chart or DOM, is a <em>request</em> sent across the connection asking Tradovate to amend that live order. Until Tradovate accepts it and returns a confirmation, the broker's order sits exactly where it was." },
    { type: "paragraph", html: "Here's the trap: NinjaTrader can happily show the new breakeven price while Tradovate never accepted a thing. Picture an unmanaged strategy that sets a 20-point stop, moves it to breakeven at a profit trigger, then trails it. During a high-volume morning open, the stop reads as moved inside NinjaTrader, but the Tradovate Orders report shows it never left the original price. Price runs back through the “breakeven” and the position closes at the original stop, because that's where Tradovate's order actually was the whole time." },
    { type: "paragraph", html: "That's why the Orders report matters more than the chart. When the broker's working price and your strategy's intended price disagree, believe the broker. Everything below is about closing that gap." },
    { type: "heading", text: "Top Causes of a NinjaTrader Stop Not Updating on Tradovate" },
    { type: "heading", text: "1. The modification hit the wrong side of the market and was rejected" },
    { type: "paragraph", html: "This is the number-one cause during fast moves. A protective sell stop for a long has to sit <em>below</em> the market; a buy stop covering a short has to sit <em>above</em> it. Try to move a stop to breakeven after price has already traded through that level, and the amendment is an invalid order, the broker rejects it with something like <em>“Sell stop or sell stop limit orders can't be placed above the market.”</em> NinjaTrader may have already updated its local object, but since the change was rejected, Tradovate keeps the previous stop working at its original price." },
    { type: "paragraph", html: "In fast conditions this isn't a bug, it's the exchange refusing an order it can't honor. The fix is defensive pricing, covered below." },
    { type: "heading", text: "2. Your code modified a stale order reference" },
    { type: "paragraph", html: "NinjaTrader runs your strategy over historical bars first, then transitions to real-time. If you saved an order object to a variable during the historical state and keep calling <code>ChangeOrder()</code> on that reference after the strategy goes live, you're amending a dead object, the live Tradovate order never sees the change. NinjaTrader's own documentation is explicit here: when historical order references transition to real-time, you have to update the reference with the <code>GetRealtimeOrder()</code> helper, or the change fails." },
    { type: "paragraph", html: "There's a close cousin to this, a modification that fires the instant after placement with a rounded or stale price. A strategy can command a stop at 19802 while the Tradovate order shows 19805.75, and the cause is the strategy's own logic amending the stop right after submission, not any broker fault. The lesson is simple: if the number on Tradovate is close but wrong, suspect your code path, not the connection." },
    { type: "heading", text: "3. High-volume order-modification throttling" },
    { type: "paragraph", html: "Tradovate throttles how fast it will accept order actions, and those limits vary by account and shift over time, check Tradovate's current API rate limits rather than assuming a fixed number. A trailing routine that fires a <code>ChangeOrder()</code> on every tick or every bar can generate modifications faster than the broker will take them. When that happens, some amendments get dropped or rejected while NinjaTrader's local state keeps marching forward, and the two pictures drift apart. That's the classic “worked in the sim, failed at the open” pattern during high volume." },
    { type: "heading", text: "4. NinjaTrader shows the change locally, but the broker never confirmed it" },
    { type: "paragraph", html: "Even with clean code, the connection can leave a modification hanging. Move a stop or take-profit and the order “just stays orange”, it never confirms, and disconnecting, reconnecting, and restarting NinjaTrader doesn't clear it. In that state, assume the broker still holds the <em>old</em> order. The right move for a hung live order is to contact your broker or evaluation provider to confirm and manage the live order directly, then submit your logs and trace files so it can be investigated." },
    { type: "heading", text: "5. Managed order not live-until-cancelled, or tick rounding" },
    { type: "paragraph", html: "In the managed approach, an order has to be marked live-until-cancelled to stay modifiable across bars. Skip that and the framework may treat it as no longer changeable, so your amendment quietly does nothing. Price rounding compounds it, if your computed breakeven isn't snapped to the instrument's tick size, the broker can reject or nudge it, leaving the working order off from what you expected." },
    { type: "heading", text: "How to Fix a NinjaTrader-Tradovate Stop That Won't Update" },
    { type: "heading", text: "Fixing wrong-side-of-market rejections" },
    { type: "paragraph", html: "<ol><li>Before every stop modification, read the current market. For a long's protective sell stop, if your new price is at or above the bid, clamp it to one tick below the bid (<code>newPrice = GetCurrentBid() - TickSize</code>); mirror this for shorts against the ask.</li><li>Only advance the stop toward breakeven once price has cleared it by a buffer. Don't command breakeven the instant profit equals the stop distance.</li><li>Round the final price to the instrument's tick size so the broker never has to nudge it.</li></ol>" },
    { type: "heading", text: "Fixing stale order references" },
    { type: "paragraph", html: "<ol><li>In <code>OnStateChange()</code>, when the strategy transitions to real-time, re-fetch every order object you intend to modify using <code>GetRealtimeOrder()</code>.</li><li>Confirm the returned reference isn't null before calling <code>ChangeOrder()</code>. A null means the order is already filled, cancelled, or rejected, there's nothing live to amend.</li><li>In the managed approach, keep protective orders live-until-cancelled so they stay modifiable across bars.</li></ol>" },
    { type: "heading", text: "Throttling and adding error handling" },
    { type: "paragraph", html: "<ol><li>Only submit a modification when the target price has actually changed by at least one tick. Skip the redundant <code>ChangeOrder()</code> calls.</li><li>Wrap your stop-update method in error handling that logs the order ID, timestamp, and rejection reason, so a silent failure turns into a visible log line. Adding better error handling to a method like <code>UpdateStopLoss</code> is often the single change that finally captures the next failure.</li><li>During news and the cash open, widen the interval between trailing updates to stay under the broker's acceptance rate.</li></ol>" },
    { type: "heading", text: "Reconciling NinjaTrader against Tradovate" },
    { type: "paragraph", html: "<ol><li>Keep the Tradovate Orders report (or Order History) open beside NinjaTrader while a live stop is trailing.</li><li>After each modification, confirm the working price on Tradovate matches your intended price. If it doesn't, the change didn't land.</li><li>If an order is stuck unconfirmed, flatten or manage it directly from Tradovate rather than trusting NinjaTrader's local display.</li></ol>" },
    { type: "heading", text: "Troubleshooting Table" },
    {
      type: "table",
      headers: ["Symptom / Error", "What it means", "Fix"],
      rows: [
        ["Stop shows breakeven in NinjaTrader, original price in Tradovate", "The amendment never reached or was rejected by the broker", "Trust the Tradovate Orders report; validate price side and re-check the reference"],
        ["“Sell stop ... can't be placed above the market” (or buy-stop equivalent)", "New stop was on the wrong side of a fast market", "Clamp new price one tick past the bid/ask before submitting"],
        ["Tradovate stop price a few ticks off from strategy", "Code amends the stop with a stale/rounded price after placement", "Round to tick size; stop re-amending immediately after entry"],
        ["Modification “just stays orange” / never confirms", "Live order hung on the connection", "Manage the order directly on Tradovate; submit NinjaTrader logs/trace"],
        ["Trailing stop drops updates during high volume", "Modifications outran the broker's acceptance rate", "Throttle updates; only send on a real tick-size change"],
        ["ChangeOrder() silently does nothing after real-time start", "Modifying a stale historical order object", "Re-fetch with GetRealtimeOrder(); keep orders live-until-cancelled"],
      ],
    },
    { type: "heading", text: "Prevent This with PickMyTrade" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Broker-Confirmed Order State</strong>, routing goes straight to Tradovate and tracks the broker's actual working order, so your stop reflects what the exchange holds, not a stale local copy.",
        "<strong class='text-white'>Qty / Symbol Validation</strong>, blocks malformed or wrong-side modifications before they're sent, cutting down on silent rejections.",
        "<strong class='text-white'>Rate-Limit-Safe Routing</strong>, spaces out order flow so rapid trailing updates don't outrun the broker's acceptance and vanish.",
        "<strong class='text-white'>Multi-Account Sync</strong>, mirrors the corrected stop across every connected account instead of leaving one account's order behind.",
      ],
    },
  ], de: [
    { type: "paragraph",html: "Sie haben zugesehen, wie NinjaTrader Ihren Stop auf Breakeven nachzog, der Kurs lief direkt durch dieses Niveau zurück, und statt eines Nullergebnisses nahmen Sie den vollen Verlust von 20 Punkten mit. Dann öffneten Sie den Orders-Bericht von Tradovate, und da war es: Der Stop stand noch immer auf Ihrem ursprünglichen Einstiegs-Stop-Preis. Diese Lücke ist das ganze Problem. Ihre Strategie zeigt auf Ihrem Bildschirm den neuen Preis, aber die Änderung hat die Live-Order des Brokers nie erreicht. Es tritt in verschiedenen Verkleidungen auf: ein Stop, der sich nie von seinem Startpreis bewegt, ein Trailing-Stop, der einige Ticks von dem abweicht, was Ihr Code vorgegeben hat, oder eine Änderung, die „einfach orange bleibt“ und nie bestätigt wird. Wenn Sie Ihr Risiko über eine Bridge wie PickMyTrade leiten, entfällt der fragile Übergang, an dem diese stillen Fehler passieren, aber zuerst müssen Sie verstehen, wo das Update tatsächlich verschwindet." },
    {
      type: "checklist",
      heading: "Kurze Checkliste für einen Stop, der nicht auf Breakeven wandert",
      items: [
        "<strong class='text-white'>Prüfen Sie zuerst den Orders-Bericht von Tradovate.</strong> Der Preis der aktiven Order beim Broker ist Ihre einzige Wahrheitsquelle, die Anzeige von NinjaTrader kann hinterherhinken oder abweichen.",
        "<strong class='text-white'>Bestätigen Sie, dass die Änderung nicht abgelehnt wurde.</strong> Ein Stop, der in einem schnellen Markt auf die falsche Seite verschoben wird, wird abgelehnt, und die alte Order bleibt aktiv.",
        "<strong class='text-white'>Prüfen Sie den neuen Stop-Preis</strong>: Er muss vor jedem <code>ChangeOrder()</code>-Aufruf unter dem Bid (Long) oder über dem Ask (Short) liegen.",
        "<strong class='text-white'>Aktualisieren Sie Ihre Order-Referenz mit <code>GetRealtimeOrder()</code></strong>, wenn die Strategie von historisch zu Echtzeit wechselt.",
        "<strong class='text-white'>Drosseln Sie schnelle Änderungen.</strong> Eine Trailing-Schleife bei hohem Volumen kann die Annahme des Brokers überholen und Updates auf den Boden fallen lassen.",
        "<strong class='text-white'>Fügen Sie Ihrer Stop-Update-Methode eine Fehlerbehandlung hinzu</strong>, damit eine fehlgeschlagene Änderung im Log erscheint, statt zu verschwinden.",
      ],
    },
    { type: "heading",text: "Was „Stop wird nicht auf Breakeven aktualisiert“ tatsächlich bedeutet" },
    { type: "paragraph",html: "NinjaTrader und Tradovate führen zwei getrennte Bilder Ihrer Order. NinjaTrader hält ein lokales Order-Objekt, das Ihre Strategie liest und schreibt. Tradovate hält die tatsächliche aktive Order, die die Börse ausführen wird. Ein <code>ChangeOrder()</code> oder ein Ziehen im Chart oder DOM ist eine <em>Anfrage</em>, die über die Verbindung gesendet wird und Tradovate bittet, diese Live-Order zu ändern. Bis Tradovate sie akzeptiert und eine Bestätigung zurücksendet, bleibt die Order des Brokers genau dort, wo sie war." },
    { type: "paragraph",html: "Hier liegt die Falle: NinjaTrader kann den neuen Breakeven-Preis bereitwillig anzeigen, während Tradovate nichts akzeptiert hat. Stellen Sie sich eine nicht verwaltete Strategie vor, die einen Stop von 20 Punkten setzt, ihn bei einem Gewinn-Trigger auf Breakeven verschiebt und ihn dann nachzieht. Bei einer volumenstarken Morgeneröffnung wird der Stop in NinjaTrader als verschoben angezeigt, doch der Orders-Bericht von Tradovate zeigt, dass er den ursprünglichen Preis nie verlassen hat. Der Kurs läuft durch den „Breakeven“ zurück, und die Position schließt am ursprünglichen Stop, weil die Order von Tradovate die ganze Zeit dort lag." },
    { type: "paragraph",html: "Deshalb ist der Orders-Bericht wichtiger als der Chart. Wenn der aktive Preis des Brokers und der beabsichtigte Preis Ihrer Strategie nicht übereinstimmen, glauben Sie dem Broker. Alles Folgende dient dazu, diese Lücke zu schließen." },
    { type: "heading",text: "Die häufigsten Ursachen für einen NinjaTrader-Stop, der bei Tradovate nicht aktualisiert wird" },
    { type: "heading",text: "1. Die Änderung traf die falsche Marktseite und wurde abgelehnt" },
    { type: "paragraph",html: "Das ist die Ursache Nummer eins bei schnellen Bewegungen. Ein schützender Verkaufs-Stop für eine Long-Position muss <em>unter</em> dem Markt liegen, ein Kauf-Stop zur Absicherung einer Short-Position <em>darüber</em>. Versuchen Sie, einen Stop auf Breakeven zu verschieben, nachdem der Kurs dieses Niveau bereits durchlaufen hat, ist die Änderung eine ungültige Order, und der Broker lehnt sie mit etwas wie <em>„Sell stop or sell stop limit orders can't be placed above the market.“</em> ab. NinjaTrader hat sein lokales Objekt möglicherweise schon aktualisiert, doch weil die Änderung abgelehnt wurde, behält Tradovate den vorherigen Stop zum ursprünglichen Preis aktiv." },
    { type: "paragraph",html: "Unter schnellen Bedingungen ist das kein Bug, sondern die Börse, die eine Order verweigert, die sie nicht erfüllen kann. Die Lösung ist defensive Preisgestaltung, wie unten beschrieben." },
    { type: "heading",text: "2. Ihr Code hat eine veraltete Order-Referenz geändert" },
    { type: "paragraph",html: "NinjaTrader führt Ihre Strategie zuerst über historische Balken aus und wechselt dann in Echtzeit. Wenn Sie ein Order-Objekt im historischen Zustand in einer Variablen gespeichert haben und nach dem Live-Gang der Strategie weiter <code>ChangeOrder()</code> auf diese Referenz aufrufen, ändern Sie ein totes Objekt, und die Live-Order bei Tradovate sieht die Änderung nie. Die Dokumentation von NinjaTrader ist hier eindeutig: Wenn historische Order-Referenzen in Echtzeit übergehen, müssen Sie die Referenz mit dem Helfer <code>GetRealtimeOrder()</code> aktualisieren, sonst schlägt die Änderung fehl." },
    { type: "paragraph",html: "Ein enger Verwandter davon ist eine Änderung, die unmittelbar nach der Platzierung mit einem gerundeten oder veralteten Preis ausgelöst wird. Eine Strategie kann einen Stop bei 19802 anordnen, während die Tradovate-Order 19805.75 zeigt, und die Ursache ist die eigene Logik der Strategie, die den Stop direkt nach der Übermittlung ändert, nicht ein Broker-Fehler. Die Lehre ist einfach: Liegt die Zahl bei Tradovate nah dran, aber falsch, verdächtigen Sie Ihren Codepfad, nicht die Verbindung." },
    { type: "heading",text: "3. Drosselung bei hohem Volumen von Order-Änderungen" },
    { type: "paragraph",html: "Tradovate drosselt, wie schnell es Order-Aktionen annimmt, und diese Limits variieren je nach Konto und ändern sich im Laufe der Zeit. Prüfen Sie die aktuellen API-Rate-Limits von Tradovate, statt von einer festen Zahl auszugehen. Eine Trailing-Routine, die bei jedem Tick oder jedem Balken ein <code>ChangeOrder()</code> auslöst, kann Änderungen schneller erzeugen, als der Broker sie annimmt. Dann werden einige Änderungen verworfen oder abgelehnt, während der lokale Zustand von NinjaTrader weitermarschiert und die beiden Bilder auseinanderdriften. Das ist das klassische Muster „in der Sim funktioniert, bei der Eröffnung fehlgeschlagen“ bei hohem Volumen." },
    { type: "heading",text: "4. NinjaTrader zeigt die Änderung lokal, aber der Broker hat sie nie bestätigt" },
    { type: "paragraph",html: "Selbst bei sauberem Code kann die Verbindung eine Änderung in der Schwebe lassen. Sie verschieben einen Stop oder Take-Profit, und die Order „bleibt einfach orange“, wird nie bestätigt, und Trennen, Neuverbinden und Neustarten von NinjaTrader löst es nicht. In diesem Zustand gehen Sie davon aus, dass der Broker noch die <em>alte</em> Order hält. Bei einer hängenden Live-Order ist es richtig, Ihren Broker oder Evaluationsanbieter zu kontaktieren, um die Live-Order zu bestätigen und direkt zu verwalten, und dann Ihre Log- und Trace-Dateien einzureichen, damit es untersucht werden kann." },
    { type: "heading",text: "5. Verwaltete Order nicht live-until-cancelled, oder Tick-Rundung" },
    { type: "paragraph",html: "Beim verwalteten Ansatz muss eine Order als live-until-cancelled markiert sein, damit sie über Balken hinweg änderbar bleibt. Wird das übersprungen, behandelt das Framework sie möglicherweise als nicht mehr änderbar, sodass Ihre Änderung stillschweigend nichts bewirkt. Die Preisrundung verschärft es: Wenn Ihr berechneter Breakeven nicht auf die Tickgröße des Instruments gerundet ist, kann der Broker ihn ablehnen oder verschieben, sodass die aktive Order von Ihrer Erwartung abweicht." },
    { type: "heading",text: "So beheben Sie einen NinjaTrader-Tradovate-Stop, der nicht aktualisiert wird" },
    { type: "heading",text: "Ablehnungen wegen der falschen Marktseite beheben" },
    { type: "paragraph",html: "<ol><li>Lesen Sie vor jeder Stop-Änderung den aktuellen Markt. Liegt Ihr neuer Preis beim schützenden Verkaufs-Stop einer Long-Position auf oder über dem Bid, begrenzen Sie ihn auf einen Tick unter dem Bid (<code>newPrice = GetCurrentBid() - TickSize</code>); spiegeln Sie dies für Shorts gegen den Ask.</li><li>Rücken Sie den Stop erst dann Richtung Breakeven vor, wenn der Kurs ihn um einen Puffer überschritten hat. Ordnen Sie Breakeven nicht in dem Moment an, in dem der Gewinn dem Stop-Abstand entspricht.</li><li>Runden Sie den Endpreis auf die Tickgröße des Instruments, damit der Broker ihn nie verschieben muss.</li></ol>" },
    { type: "heading",text: "Veraltete Order-Referenzen beheben" },
    { type: "paragraph",html: "<ol><li>Holen Sie in <code>OnStateChange()</code>, wenn die Strategie in Echtzeit übergeht, jedes Order-Objekt, das Sie ändern wollen, mit <code>GetRealtimeOrder()</code> erneut.</li><li>Bestätigen Sie, dass die zurückgegebene Referenz nicht null ist, bevor Sie <code>ChangeOrder()</code> aufrufen. Null bedeutet, dass die Order bereits ausgeführt, storniert oder abgelehnt ist und nichts Aktives mehr zu ändern ist.</li><li>Halten Sie schützende Orders im verwalteten Ansatz live-until-cancelled, damit sie über Balken hinweg änderbar bleiben.</li></ol>" },
    { type: "heading",text: "Drosselung und Fehlerbehandlung hinzufügen" },
    { type: "paragraph",html: "<ol><li>Senden Sie eine Änderung nur, wenn sich der Zielpreis tatsächlich um mindestens einen Tick geändert hat. Überspringen Sie die überflüssigen <code>ChangeOrder()</code>-Aufrufe.</li><li>Umhüllen Sie Ihre Stop-Update-Methode mit einer Fehlerbehandlung, die Order-ID, Zeitstempel und Ablehnungsgrund protokolliert, damit aus einem stillen Fehler eine sichtbare Logzeile wird. Eine bessere Fehlerbehandlung für eine Methode wie <code>UpdateStopLoss</code> ist oft die eine Änderung, die endlich den nächsten Fehler erfasst.</li><li>Vergrößern Sie bei Nachrichten und der Cash-Eröffnung das Intervall zwischen Trailing-Updates, um unter der Annahmerate des Brokers zu bleiben.</li></ol>" },
    { type: "heading",text: "NinjaTrader mit Tradovate abgleichen" },
    { type: "paragraph",html: "<ol><li>Halten Sie den Orders-Bericht (oder die Order History) von Tradovate neben NinjaTrader geöffnet, solange ein Live-Stop nachgezogen wird.</li><li>Bestätigen Sie nach jeder Änderung, dass der aktive Preis bei Tradovate Ihrem beabsichtigten Preis entspricht. Wenn nicht, ist die Änderung nicht angekommen.</li><li>Steckt eine Order unbestätigt fest, schließen oder verwalten Sie sie direkt bei Tradovate, statt der lokalen Anzeige von NinjaTrader zu vertrauen.</li></ol>" },
    { type: "heading",text: "Tabelle zur Fehlersuche" },
    { type: "table", headers: ["Symptom / Fehler","Was es bedeutet","Lösung"], rows: [
      ["Stop zeigt in NinjaTrader Breakeven, in Tradovate den ursprünglichen Preis","Die Änderung erreichte den Broker nie oder wurde von ihm abgelehnt","Dem Orders-Bericht von Tradovate vertrauen; Preisseite prüfen und Referenz erneut kontrollieren"],
      ["Meldung „Sell stop ... can't be placed above the market“ (oder das Gegenstück beim Buy-Stop)","Der neue Stop lag auf der falschen Seite eines schnellen Marktes","Neuen Preis vor dem Absenden einen Tick jenseits von Bid/Ask begrenzen"],
      ["Tradovate-Stop-Preis weicht um einige Ticks von der Strategie ab","Der Code ändert den Stop nach der Platzierung mit einem veralteten/gerundeten Preis","Auf Tickgröße runden; sofortige erneute Änderung nach dem Einstieg unterlassen"],
      ["Änderung „bleibt einfach orange“ / wird nie bestätigt","Live-Order hängt in der Verbindung","Order direkt bei Tradovate verwalten; NinjaTrader-Logs/Trace einreichen"],
      ["Trailing-Stop verliert Updates bei hohem Volumen","Änderungen überholten die Annahmerate des Brokers","Updates drosseln; nur bei einer echten Änderung um eine Tickgröße senden"],
      ["ChangeOrder() bewirkt nach dem Echtzeitstart stillschweigend nichts","Änderung eines veralteten historischen Order-Objekts","Mit GetRealtimeOrder() neu holen; Orders live-until-cancelled halten"],
    ] },
    { type: "heading",text: "Verhindern Sie das mit PickMyTrade" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Vom Broker bestätigter Order-Zustand</strong>, das Routing geht direkt zu Tradovate und verfolgt die tatsächlich aktive Order des Brokers, sodass Ihr Stop das widerspiegelt, was die Börse hält, und nicht eine veraltete lokale Kopie.",
        "<strong class='text-white'>Prüfung von Menge und Symbol</strong>, blockiert fehlerhafte oder seitenfalsche Änderungen, bevor sie gesendet werden, und reduziert stille Ablehnungen.",
        "<strong class='text-white'>Rate-Limit-sicheres Routing</strong>, verteilt den Orderfluss zeitlich, damit schnelle Trailing-Updates die Annahme des Brokers nicht überholen und verschwinden.",
        "<strong class='text-white'>Multi-Konto-Synchronisierung</strong>, spiegelt den korrigierten Stop über jedes verbundene Konto, statt die Order eines Kontos zurückzulassen.",
      ],
    },
  ], es: [
    { type: "paragraph",html: "Vio cómo NinjaTrader subía su stop a breakeven, el precio atravesó ese nivel de vuelta y, en lugar de salir a cero, asumió la pérdida completa de 20 puntos. Entonces abrió el informe Orders de Tradovate y ahí estaba: el stop seguía parado en el precio original de su stop de entrada. Esa brecha es todo el problema. Su estrategia muestra el nuevo precio en su pantalla, pero la modificación nunca llegó a la orden activa del bróker. Se presenta con varios disfraces: un stop que nunca se mueve de su precio inicial, un trailing stop que marca varios ticks de diferencia respecto a lo que su código ordenó, o un cambio que «se queda en naranja» y nunca se confirma. Enrutar su riesgo a través de un puente como PickMyTrade elimina el salto frágil en el que ocurren estos fallos silenciosos, pero primero necesita entender dónde desaparece realmente la actualización." },
    {
      type: "checklist",
      heading: "Lista de verificación rápida para un stop que no se mueve a breakeven",
      items: [
        "<strong class='text-white'>Revise primero el informe Orders de Tradovate.</strong> El precio de la orden activa del bróker es su única fuente de verdad; la pantalla de NinjaTrader puede ir con retraso o divergir.",
        "<strong class='text-white'>Confirme que la modificación no fue rechazada.</strong> Un stop movido al lado equivocado de un mercado rápido es rechazado y la orden antigua sigue activa.",
        "<strong class='text-white'>Valide el nuevo precio del stop</strong>: debe estar por debajo del bid (largo) o por encima del ask (corto) antes de cada llamada a <code>ChangeOrder()</code>.",
        "<strong class='text-white'>Actualice su referencia de orden con <code>GetRealtimeOrder()</code></strong> cuando la estrategia pase de histórico a tiempo real.",
        "<strong class='text-white'>Limite las modificaciones rápidas.</strong> Un bucle de trailing con volumen alto puede superar la aceptación del bróker y dejar caer actualizaciones.",
        "<strong class='text-white'>Añada gestión de errores alrededor de su método de actualización de stop</strong> para que un cambio fallido aparezca en el log en lugar de desvanecerse.",
      ],
    },
    { type: "heading",text: "Qué significa realmente «el stop no se actualiza a breakeven»" },
    { type: "paragraph",html: "NinjaTrader y Tradovate mantienen dos imágenes separadas de su orden. NinjaTrader mantiene un objeto de orden local que su estrategia lee y escribe. Tradovate mantiene la orden activa real que el mercado ejecutará. Un <code>ChangeOrder()</code>, o un arrastre en el gráfico o en el DOM, es una <em>solicitud</em> enviada por la conexión pidiendo a Tradovate que modifique esa orden activa. Hasta que Tradovate la acepta y devuelve una confirmación, la orden del bróker permanece exactamente donde estaba." },
    { type: "paragraph",html: "Aquí está la trampa: NinjaTrader puede mostrar tranquilamente el nuevo precio de breakeven mientras Tradovate no aceptó nada. Imagine una estrategia no gestionada que fija un stop de 20 puntos, lo mueve a breakeven en un disparador de beneficio y luego lo arrastra. Durante una apertura matutina de volumen alto, el stop aparece movido dentro de NinjaTrader, pero el informe Orders de Tradovate muestra que nunca salió del precio original. El precio retrocede a través del «breakeven» y la posición se cierra en el stop original, porque ahí estuvo la orden de Tradovate todo el tiempo." },
    { type: "paragraph",html: "Por eso el informe Orders importa más que el gráfico. Cuando el precio activo del bróker y el precio previsto por su estrategia discrepan, crea al bróker. Todo lo que sigue trata de cerrar esa brecha." },
    { type: "heading",text: "Principales causas de un stop de NinjaTrader que no se actualiza en Tradovate" },
    { type: "heading",text: "1. La modificación cayó en el lado equivocado del mercado y fue rechazada" },
    { type: "paragraph",html: "Esta es la causa número uno durante los movimientos rápidos. Un stop de venta protector para una posición larga debe estar <em>por debajo</em> del mercado; un stop de compra que cubre una posición corta debe estar <em>por encima</em>. Si intenta mover un stop a breakeven después de que el precio ya haya atravesado ese nivel, la modificación es una orden no válida y el bróker la rechaza con algo como <em>«Sell stop or sell stop limit orders can't be placed above the market.»</em> Es posible que NinjaTrader ya haya actualizado su objeto local, pero como el cambio fue rechazado, Tradovate mantiene activo el stop anterior en su precio original." },
    { type: "paragraph",html: "En condiciones rápidas esto no es un error, es el mercado rechazando una orden que no puede cumplir. La solución es una fijación de precios defensiva, que se explica a continuación." },
    { type: "heading",text: "2. Su código modificó una referencia de orden obsoleta" },
    { type: "paragraph",html: "NinjaTrader ejecuta su estrategia primero sobre barras históricas y luego pasa a tiempo real. Si guardó un objeto de orden en una variable durante el estado histórico y sigue llamando a <code>ChangeOrder()</code> sobre esa referencia después de que la estrategia pasa a vivo, está modificando un objeto muerto y la orden activa de Tradovate nunca ve el cambio. La propia documentación de NinjaTrader es explícita: cuando las referencias de órdenes históricas pasan a tiempo real, debe actualizar la referencia con el ayudante <code>GetRealtimeOrder()</code>, o el cambio falla." },
    { type: "paragraph",html: "Hay un primo cercano de este problema: una modificación que se dispara justo después de la colocación con un precio redondeado u obsoleto. Una estrategia puede ordenar un stop en 19802 mientras la orden de Tradovate muestra 19805.75, y la causa es la propia lógica de la estrategia modificando el stop justo después del envío, no un fallo del bróker. La lección es simple: si el número en Tradovate está cerca pero equivocado, sospeche de la ruta de su código, no de la conexión." },
    { type: "heading",text: "3. Limitación de modificaciones de órdenes con volumen alto" },
    { type: "paragraph",html: "Tradovate limita la velocidad a la que acepta acciones sobre órdenes, y esos límites varían según la cuenta y cambian con el tiempo; consulte los límites de tasa de la API actuales de Tradovate en lugar de asumir un número fijo. Una rutina de trailing que dispara un <code>ChangeOrder()</code> en cada tick o en cada barra puede generar modificaciones más rápido de lo que el bróker las admite. Cuando eso ocurre, algunas modificaciones se descartan o se rechazan mientras el estado local de NinjaTrader sigue avanzando, y las dos imágenes se separan. Es el clásico patrón «funcionó en el simulador, falló en la apertura» con volumen alto." },
    { type: "heading",text: "4. NinjaTrader muestra el cambio localmente, pero el bróker nunca lo confirmó" },
    { type: "paragraph",html: "Incluso con código limpio, la conexión puede dejar una modificación colgada. Mueve un stop o un take-profit y la orden «se queda en naranja», nunca se confirma, y desconectar, volver a conectar y reiniciar NinjaTrader no lo resuelve. En ese estado, asuma que el bróker aún tiene la orden <em>antigua</em>. Lo correcto con una orden activa colgada es contactar con su bróker o proveedor de evaluación para confirmar y gestionar la orden activa directamente, y luego enviar sus archivos de log y trace para que se investigue." },
    { type: "heading",text: "5. Orden gestionada sin live-until-cancelled, o redondeo de tick" },
    { type: "paragraph",html: "En el enfoque gestionado, una orden debe marcarse como live-until-cancelled para seguir siendo modificable a lo largo de las barras. Si lo omite, el framework puede tratarla como ya no modificable, de modo que su modificación no hace nada en silencio. El redondeo de precios lo agrava: si su breakeven calculado no se ajusta al tamaño de tick del instrumento, el bróker puede rechazarlo o desplazarlo, dejando la orden activa distinta de lo que esperaba." },
    { type: "heading",text: "Cómo corregir un stop de NinjaTrader-Tradovate que no se actualiza" },
    { type: "heading",text: "Corregir rechazos por lado equivocado del mercado" },
    { type: "paragraph",html: "<ol><li>Antes de cada modificación de stop, lea el mercado actual. Para el stop de venta protector de una posición larga, si su nuevo precio está en el bid o por encima, límitelo a un tick por debajo del bid (<code>newPrice = GetCurrentBid() - TickSize</code>); haga lo mismo en espejo para posiciones cortas frente al ask.</li><li>Avance el stop hacia breakeven solo cuando el precio lo haya superado con un margen. No ordene breakeven en el instante en que el beneficio iguala la distancia del stop.</li><li>Redondee el precio final al tamaño de tick del instrumento para que el bróker nunca tenga que desplazarlo.</li></ol>" },
    { type: "heading",text: "Corregir referencias de orden obsoletas" },
    { type: "paragraph",html: "<ol><li>En <code>OnStateChange()</code>, cuando la estrategia pase a tiempo real, vuelva a obtener cada objeto de orden que piense modificar usando <code>GetRealtimeOrder()</code>.</li><li>Confirme que la referencia devuelta no es null antes de llamar a <code>ChangeOrder()</code>. Un null significa que la orden ya fue ejecutada, cancelada o rechazada, y no hay nada activo que modificar.</li><li>En el enfoque gestionado, mantenga las órdenes protectoras live-until-cancelled para que sigan siendo modificables a lo largo de las barras.</li></ol>" },
    { type: "heading",text: "Limitar la frecuencia y añadir gestión de errores" },
    { type: "paragraph",html: "<ol><li>Envíe una modificación solo cuando el precio objetivo haya cambiado realmente al menos un tick. Omita las llamadas redundantes a <code>ChangeOrder()</code>.</li><li>Envuelva su método de actualización de stop en una gestión de errores que registre el ID de la orden, la marca de tiempo y el motivo del rechazo, de modo que un fallo silencioso se convierta en una línea de log visible. Añadir una mejor gestión de errores a un método como <code>UpdateStopLoss</code> suele ser el único cambio que por fin captura el siguiente fallo.</li><li>Durante las noticias y la apertura del mercado al contado, amplíe el intervalo entre actualizaciones de trailing para mantenerse por debajo de la tasa de aceptación del bróker.</li></ol>" },
    { type: "heading",text: "Conciliar NinjaTrader con Tradovate" },
    { type: "paragraph",html: "<ol><li>Mantenga abierto el informe Orders (o el Order History) de Tradovate junto a NinjaTrader mientras un stop en vivo se está arrastrando.</li><li>Después de cada modificación, confirme que el precio activo en Tradovate coincide con el precio previsto. Si no es así, el cambio no llegó.</li><li>Si una orden queda atascada sin confirmar, ciérrela o gestiónela directamente desde Tradovate en lugar de confiar en la pantalla local de NinjaTrader.</li></ol>" },
    { type: "heading",text: "Tabla de resolución de problemas" },
    { type: "table", headers: ["Síntoma / Error","Qué significa","Solución"], rows: [
      ["El stop muestra breakeven en NinjaTrader y el precio original en Tradovate","La modificación nunca llegó al bróker o fue rechazada por este","Confiar en el informe Orders de Tradovate; validar el lado del precio y volver a comprobar la referencia"],
      ["Mensaje «Sell stop ... can't be placed above the market» (o el equivalente de buy stop)","El nuevo stop estaba en el lado equivocado de un mercado rápido","Limitar el nuevo precio un tick más allá del bid/ask antes de enviarlo"],
      ["El precio del stop en Tradovate difiere unos ticks de la estrategia","El código modifica el stop con un precio obsoleto/redondeado tras la colocación","Redondear al tamaño de tick; dejar de volver a modificar inmediatamente después de la entrada"],
      ["La modificación «se queda en naranja» / nunca se confirma","Orden activa colgada en la conexión","Gestionar la orden directamente en Tradovate; enviar logs/trace de NinjaTrader"],
      ["El trailing stop pierde actualizaciones con volumen alto","Las modificaciones superaron la tasa de aceptación del bróker","Limitar las actualizaciones; enviar solo ante un cambio real de tamaño de tick"],
      ["ChangeOrder() no hace nada en silencio tras el inicio en tiempo real","Modificación de un objeto de orden histórico obsoleto","Volver a obtener con GetRealtimeOrder(); mantener las órdenes live-until-cancelled"],
    ] },
    { type: "heading",text: "Evítelo con PickMyTrade" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Estado de orden confirmado por el bróker</strong>, el enrutamiento va directamente a Tradovate y sigue la orden activa real del bróker, de modo que su stop refleja lo que el mercado tiene, no una copia local obsoleta.",
        "<strong class='text-white'>Validación de cantidad y símbolo</strong>, bloquea las modificaciones mal formadas o del lado equivocado antes de enviarlas, reduciendo los rechazos silenciosos.",
        "<strong class='text-white'>Enrutamiento seguro frente a límites de tasa</strong>, espacia el flujo de órdenes para que las actualizaciones rápidas de trailing no superen la aceptación del bróker y desaparezcan.",
        "<strong class='text-white'>Sincronización multicuenta</strong>, replica el stop corregido en todas las cuentas conectadas en lugar de dejar atrás la orden de una cuenta.",
      ],
    },
  ], fr: [
    { type: "paragraph",html: "Vous avez vu NinjaTrader remonter votre stop au breakeven, le prix retraverser ce niveau et, au lieu d'un résultat nul, vous avez encaissé la perte complète de 20 points. Puis vous avez ouvert le rapport Orders de Tradovate et voilà : le stop était toujours garé à votre prix de stop d'entrée d'origine. Cet écart est tout le problème. Votre stratégie affiche le nouveau prix sur votre écran, mais la modification n'a jamais atteint l'ordre actif du courtier. Il prend plusieurs déguisements : un stop qui ne bouge jamais de son prix de départ, un trailing stop qui affiche plusieurs ticks d'écart par rapport à ce que votre code a ordonné, ou un changement qui « reste orange » et ne se confirme jamais. Acheminer votre risque via une passerelle comme PickMyTrade supprime le maillon fragile où ces échecs silencieux se produisent, mais vous devez d'abord comprendre où la mise à jour disparaît réellement." },
    {
      type: "checklist",
      heading: "Liste de vérification rapide pour un stop qui ne passe pas au breakeven",
      items: [
        "<strong class='text-white'>Vérifiez d'abord le rapport Orders de Tradovate.</strong> Le prix de l'ordre actif du courtier est votre seule source de vérité ; l'affichage de NinjaTrader peut accuser du retard ou diverger.",
        "<strong class='text-white'>Confirmez que la modification n'a pas été rejetée.</strong> Un stop déplacé du mauvais côté d'un marché rapide est rejeté, et l'ancien ordre reste actif.",
        "<strong class='text-white'>Validez le nouveau prix du stop</strong> : il doit être sous le bid (long) ou au-dessus de l'ask (short) avant chaque appel à <code>ChangeOrder()</code>.",
        "<strong class='text-white'>Actualisez votre référence d'ordre avec <code>GetRealtimeOrder()</code></strong> lorsque la stratégie passe de l'historique au temps réel.",
        "<strong class='text-white'>Limitez les modifications rapides.</strong> Une boucle de trailing à fort volume peut dépasser l'acceptation du courtier et laisser tomber des mises à jour.",
        "<strong class='text-white'>Ajoutez une gestion d'erreurs autour de votre méthode de mise à jour du stop</strong> afin qu'un changement échoué apparaisse dans le log au lieu de disparaître.",
      ],
    },
    { type: "heading",text: "Ce que signifie réellement « le stop ne se met pas à jour au breakeven »" },
    { type: "paragraph",html: "NinjaTrader et Tradovate conservent deux images distinctes de votre ordre. NinjaTrader détient un objet d'ordre local que votre stratégie lit et écrit. Tradovate détient l'ordre actif réel que la bourse exécutera. Un <code>ChangeOrder()</code>, ou un glissement sur le graphique ou le DOM, est une <em>requête</em> envoyée via la connexion demandant à Tradovate de modifier cet ordre actif. Tant que Tradovate ne l'a pas acceptée et renvoyé une confirmation, l'ordre du courtier reste exactement où il était." },
    { type: "paragraph",html: "Voici le piège : NinjaTrader peut afficher tranquillement le nouveau prix de breakeven alors que Tradovate n'a rien accepté. Imaginez une stratégie non gérée qui place un stop de 20 points, le déplace au breakeven à un déclencheur de profit, puis le suit. Pendant une ouverture matinale à fort volume, le stop apparaît déplacé dans NinjaTrader, mais le rapport Orders de Tradovate montre qu'il n'a jamais quitté le prix d'origine. Le prix retraverse le « breakeven » et la position se ferme au stop d'origine, parce que c'est là que se trouvait l'ordre de Tradovate depuis le début." },
    { type: "paragraph",html: "C'est pourquoi le rapport Orders compte davantage que le graphique. Lorsque le prix actif du courtier et le prix visé par votre stratégie divergent, croyez le courtier. Tout ce qui suit vise à combler cet écart." },
    { type: "heading",text: "Principales causes d'un stop NinjaTrader qui ne se met pas à jour sur Tradovate" },
    { type: "heading",text: "1. La modification a touché le mauvais côté du marché et a été rejetée" },
    { type: "paragraph",html: "C'est la cause numéro un lors des mouvements rapides. Un stop de vente protecteur pour une position longue doit se trouver <em>sous</em> le marché ; un stop d'achat couvrant une position courte doit se trouver <em>au-dessus</em>. Essayez de déplacer un stop au breakeven alors que le prix a déjà traversé ce niveau, et la modification est un ordre invalide ; le courtier la rejette avec quelque chose comme <em>« Sell stop or sell stop limit orders can't be placed above the market. »</em> NinjaTrader a peut-être déjà mis à jour son objet local, mais comme le changement a été rejeté, Tradovate conserve le stop précédent actif à son prix d'origine." },
    { type: "paragraph",html: "Dans des conditions rapides, ce n'est pas un bug : c'est la bourse qui refuse un ordre qu'elle ne peut pas honorer. La solution est une tarification défensive, décrite ci-dessous." },
    { type: "heading",text: "2. Votre code a modifié une référence d'ordre périmée" },
    { type: "paragraph",html: "NinjaTrader exécute d'abord votre stratégie sur des barres historiques, puis passe en temps réel. Si vous avez enregistré un objet d'ordre dans une variable pendant l'état historique et continuez d'appeler <code>ChangeOrder()</code> sur cette référence après le passage de la stratégie en direct, vous modifiez un objet mort, et l'ordre actif de Tradovate ne voit jamais le changement. La documentation de NinjaTrader est explicite à ce sujet : lorsque les références d'ordres historiques passent en temps réel, vous devez mettre à jour la référence avec l'assistant <code>GetRealtimeOrder()</code>, sinon le changement échoue." },
    { type: "paragraph",html: "Il existe un proche cousin de ce problème : une modification déclenchée juste après le placement avec un prix arrondi ou périmé. Une stratégie peut ordonner un stop à 19802 alors que l'ordre Tradovate affiche 19805.75, et la cause est la propre logique de la stratégie qui modifie le stop juste après la soumission, et non une défaillance du courtier. La leçon est simple : si le nombre sur Tradovate est proche mais faux, soupçonnez le chemin de votre code, pas la connexion." },
    { type: "heading",text: "3. Limitation des modifications d'ordres à fort volume" },
    { type: "paragraph",html: "Tradovate limite la vitesse à laquelle il accepte les actions sur ordres, et ces limites varient selon le compte et évoluent avec le temps ; consultez les limites de débit actuelles de l'API de Tradovate plutôt que de supposer un nombre fixe. Une routine de trailing qui déclenche un <code>ChangeOrder()</code> à chaque tick ou à chaque barre peut générer des modifications plus vite que le courtier ne les prend. Dans ce cas, certaines modifications sont abandonnées ou rejetées pendant que l'état local de NinjaTrader continue d'avancer, et les deux images divergent. C'est le schéma classique « a fonctionné en simulation, a échoué à l'ouverture » en cas de fort volume." },
    { type: "heading",text: "4. NinjaTrader affiche le changement localement, mais le courtier ne l'a jamais confirmé" },
    { type: "paragraph",html: "Même avec un code propre, la connexion peut laisser une modification en suspens. Vous déplacez un stop ou un take-profit et l'ordre « reste orange », ne se confirme jamais, et se déconnecter, se reconnecter et redémarrer NinjaTrader ne règle rien. Dans cet état, considérez que le courtier détient toujours l'<em>ancien</em> ordre. La bonne démarche pour un ordre actif suspendu est de contacter votre courtier ou fournisseur d'évaluation pour confirmer et gérer directement l'ordre actif, puis de soumettre vos fichiers de log et de trace pour investigation." },
    { type: "heading",text: "5. Ordre géré non live-until-cancelled, ou arrondi au tick" },
    { type: "paragraph",html: "Dans l'approche gérée, un ordre doit être marqué live-until-cancelled pour rester modifiable d'une barre à l'autre. Si vous l'omettez, le framework peut le traiter comme n'étant plus modifiable, si bien que votre modification ne fait silencieusement rien. L'arrondi des prix aggrave le problème : si votre breakeven calculé n'est pas aligné sur la taille de tick de l'instrument, le courtier peut le rejeter ou le décaler, laissant l'ordre actif différent de ce que vous attendiez." },
    { type: "heading",text: "Comment corriger un stop NinjaTrader-Tradovate qui ne se met pas à jour" },
    { type: "heading",text: "Corriger les rejets du mauvais côté du marché" },
    { type: "paragraph",html: "<ol><li>Avant chaque modification de stop, lisez le marché actuel. Pour le stop de vente protecteur d'une position longue, si votre nouveau prix est égal ou supérieur au bid, limitez-le à un tick sous le bid (<code>newPrice = GetCurrentBid() - TickSize</code>) ; faites de même en miroir pour les positions courtes par rapport à l'ask.</li><li>N'avancez le stop vers le breakeven qu'une fois que le prix l'a dépassé d'une marge. N'ordonnez pas le breakeven à l'instant où le profit égale la distance du stop.</li><li>Arrondissez le prix final à la taille de tick de l'instrument afin que le courtier n'ait jamais à le décaler.</li></ol>" },
    { type: "heading",text: "Corriger les références d'ordres périmées" },
    { type: "paragraph",html: "<ol><li>Dans <code>OnStateChange()</code>, lorsque la stratégie passe en temps réel, récupérez de nouveau chaque objet d'ordre que vous comptez modifier avec <code>GetRealtimeOrder()</code>.</li><li>Confirmez que la référence renvoyée n'est pas null avant d'appeler <code>ChangeOrder()</code>. Un null signifie que l'ordre est déjà exécuté, annulé ou rejeté, et qu'il n'y a plus rien d'actif à modifier.</li><li>Dans l'approche gérée, gardez les ordres protecteurs live-until-cancelled afin qu'ils restent modifiables d'une barre à l'autre.</li></ol>" },
    { type: "heading",text: "Limiter la cadence et ajouter la gestion d'erreurs" },
    { type: "paragraph",html: "<ol><li>N'envoyez une modification que lorsque le prix cible a réellement changé d'au moins un tick. Ignorez les appels redondants à <code>ChangeOrder()</code>.</li><li>Enveloppez votre méthode de mise à jour du stop dans une gestion d'erreurs qui journalise l'ID de l'ordre, l'horodatage et le motif du rejet, afin qu'un échec silencieux devienne une ligne de log visible. Ajouter une meilleure gestion d'erreurs à une méthode comme <code>UpdateStopLoss</code> est souvent le seul changement qui capture enfin le prochain échec.</li><li>Pendant les annonces et l'ouverture du marché au comptant, élargissez l'intervalle entre les mises à jour de trailing pour rester sous la cadence d'acceptation du courtier.</li></ol>" },
    { type: "heading",text: "Réconcilier NinjaTrader avec Tradovate" },
    { type: "paragraph",html: "<ol><li>Gardez le rapport Orders (ou l'Order History) de Tradovate ouvert à côté de NinjaTrader pendant qu'un stop en direct est suivi.</li><li>Après chaque modification, confirmez que le prix actif sur Tradovate correspond à votre prix visé. Sinon, le changement n'a pas abouti.</li><li>Si un ordre est bloqué sans confirmation, clôturez-le ou gérez-le directement depuis Tradovate plutôt que de faire confiance à l'affichage local de NinjaTrader.</li></ol>" },
