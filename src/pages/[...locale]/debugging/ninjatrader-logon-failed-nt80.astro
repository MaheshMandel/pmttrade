---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "ninjatrader-logon-failed-nt80";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/debugging/${SLUG}`;

const META_TITLE = "NinjaTrader 'Logon Failed' With Tradovate (NT8.0)";
const META_DESCRIPTION =
  "NinjaTrader 'Logon failed' with Tradovate means version 8.0 can't connect. Update to build 8.1.2.1 or later to fix the invalid user or password error.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "NinjaTrader „Logon Failed“ mit Tradovate (NT8.0)", es: "NinjaTrader: error «Logon Failed» con Tradovate (NT8.0)", fr: "NinjaTrader « Logon Failed » avec Tradovate (NT8.0)", it: "NinjaTrader: errore «Logon Failed» con Tradovate (NT8.0)" },
  dek: { en: "The exact Tradovate username and password that log you into the web platform without a hitch still get rejected the second you try to connect in NinjaTrader. Your credentials aren't the problem, an outdated build almost always is.", de: "Genau die Tradovate-Zugangsdaten, mit denen Sie sich problemlos an der Webplattform anmelden, werden abgelehnt, sobald Sie in NinjaTrader die Verbindung herstellen. Ihre Zugangsdaten sind nicht das Problem, fast immer ist es eine veraltete Version.", es: "El nombre de usuario y la contraseña exactos de Tradovate que le permiten entrar sin problemas en la plataforma web son rechazados en cuanto intenta conectarse en NinjaTrader. Sus credenciales no son el problema; casi siempre lo es una versión desactualizada.", fr: "Le nom d'utilisateur et le mot de passe Tradovate exacts qui vous connectent sans problème à la plateforme web sont rejetés dès que vous tentez de vous connecter dans NinjaTrader. Vos identifiants ne sont pas le problème ; presque toujours, c'est une version obsolète.", it: "Il nome utente e la password Tradovate esatti che Le permettono di accedere senza problemi alla piattaforma web vengono rifiutati nel momento in cui prova a connettersi in NinjaTrader. Le Sue credenziali non sono il problema; quasi sempre lo è una versione obsoleta." },
  readTime: { en: "7 min read", de: "7 Min. Lesezeit", es: "Lectura de 7 min", fr: "Lecture : 7 min", it: "Lettura di 7 min" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "You type in the exact Tradovate username and password that log you into the Tradovate web platform without a hitch, and NinjaTrader still throws back a blunt <strong class='text-white'>“Invalid user or password (Logon failed)”</strong> the second you try to connect. Here's the thing: your credentials aren't the problem. The most common cause of this error in 2026 is almost embarrassingly simple, you're still running <strong class='text-white'>NinjaTrader 8.0</strong>, and 8.0 was never built to authenticate against Tradovate. The connection layer changed with the 8.1 release, so an 8.0 install will reject a perfectly valid Tradovate login every single time. Below, I'll walk you through what the error actually means, why it happens, the related “Logon failed” variants you might run into, and how to clear it for good, plus how automating your order flow keeps a stale desktop build from ever getting between your alerts and your fills." },
    {
      type: "checklist",
      heading: "Quick Checklist for the Tradovate Logon Failure",
      items: [
        "<strong class='text-white'>Check your NinjaTrader version first</strong>, open Help &gt; About and confirm you're on build 8.1.2.1 or later, not 8.0.",
        "<strong class='text-white'>Update NinjaTrader</strong> if you're on 8.0, then restart the platform before you retry the connection.",
        "<strong class='text-white'>Use platform (trading) credentials</strong>, not your Tradovate dashboard email and password, when the two differ.",
        "<strong class='text-white'>Strip stray spaces</strong> from before or after the username and password in the connection setup.",
        "<strong class='text-white'>Pick the correct environment</strong>, Live vs Simulation/Demo, to match the account you're actually trading.",
        "<strong class='text-white'>Stop hammering the login</strong> after a few failures, or you'll trip a temporary “too many incorrect login attempts” lockout on top of the original error.",
      ],
    },
    { type: "heading", text: "What “Invalid User or Password (Logon Failed)” Means" },
    { type: "paragraph", html: "Despite the wording, this error is almost never about a genuinely wrong password. It means NinjaTrader handed your credentials to Tradovate's authentication service and the handshake got rejected before a session could be established. When those same credentials log you straight into the Tradovate web or desktop app, they're fine, the failure is happening inside NinjaTrader's connection adapter, not at Tradovate." },
    { type: "paragraph", html: "The single biggest reason for that rejection is a version mismatch. Tradovate connectivity was added and reworked in the NinjaTrader 8.1 line. <strong class='text-white'>NinjaTrader 8.0 will not connect to a Tradovate account</strong>, you have to be on build 8.1.2.1 or later. If you installed NinjaTrader a while back, opened it, and never ran an update, odds are good you're still on an 8.0 build that simply can't speak to Tradovate, no matter how many times you re-type your login." },
    { type: "heading", text: "Top Causes of the NinjaTrader Tradovate Logon Failed Error" },
    { type: "heading", text: "1. You're Running NinjaTrader 8.0 (The Main Cause)" },
    { type: "paragraph", html: "This is the headline fix. NinjaTrader 8.0 predates full Tradovate support and will reject the connection with “Invalid user or password (Logon failed)” even with a valid account. You need build <strong class='text-white'>8.1.2.1 or later</strong>. Open Help &gt; About inside the Control Center and read the version string, if it starts with 8.0, there's your problem." },
    { type: "heading", text: "2. Wrong Credential Type (Dashboard vs. Platform Login)" },
    { type: "paragraph", html: "Plenty of Tradovate and prop-firm accounts issue two different sets of credentials: the dashboard or portal login (usually your email) and the platform trading login that connected software uses. Type your dashboard email where NinjaTrader expects the trading credentials and authentication fails. Prop-firm platform logins in particular often look nothing like the email you signed up with, so confirm which set your firm told you to use for third-party platforms." },
    { type: "heading", text: "3. Stray Spaces or a Copy-Paste Slip" },
    { type: "paragraph", html: "Copying a username or password out of an email or password manager can drag along a leading or trailing space, or a hidden character. Tradovate reads that as a different credential and rejects it. Re-type both fields by hand once to rule this out." },
    { type: "heading", text: "4. Wrong Environment Selected (Live vs. Simulation)" },
    { type: "paragraph", html: "NinjaTrader asks you to choose a connection environment. Pick the wrong one for your account, say, Live for an evaluation account that lives in the simulation environment, or the other way around, and it can surface as a logon failure. Prop-firm evaluation and funded-simulated accounts frequently need the Simulation/Demo environment even when real payouts are attached." },
    { type: "heading", text: "5. Too Many Retries Triggered a Lockout" },
    { type: "paragraph", html: "Keep re-submitting a failing login and Tradovate can temporarily lock the account, at which point you may see <strong class='text-white'>“Too many incorrect login attempts.”</strong> stacked on top of the original error. That's a separate, self-inflicted layer, the fix is to stop retrying, wait, and only try again once you've corrected the real cause (usually the version)." },
    { type: "heading", text: "How to Fix the NinjaTrader Tradovate Logon Failure in 2026: Step-by-Step" },
    { type: "heading", text: "Fixing an Outdated NinjaTrader 8.0 Install" },
    {
      type: "steps",
      items: [
        { title: "Check the version under Help > About", html: "Open the NinjaTrader <strong class='text-white'>Control Center</strong>, go to <strong class='text-white'>Help &gt; About</strong>, and read the version number. If it begins with <strong class='text-white'>8.0</strong>, keep going below." },
        { title: "Download the latest NinjaTrader 8 installer", html: "Download the latest NinjaTrader 8 installer from the official NinjaTrader website (or use the platform's built-in update prompt if one appears on launch)." },
        { title: "Close NinjaTrader before running the installer", html: "Fully close NinjaTrader before you run the installer so files aren't locked mid-update." },
        { title: "Run the installer to upgrade the build", html: "Run the installer to upgrade to <strong class='text-white'>build 8.1.2.1 or later</strong>, always take the newest available NinjaTrader 8 build, since the minimum floor only moves forward over time." },
        { title: "Confirm the version and reconnect", html: "Reopen NinjaTrader, confirm the new version under Help &gt; About, then set up the Tradovate connection again." },
      ],
    },
    { type: "heading", text: "Fixing Credential, Space, and Environment Problems" },
    { type: "paragraph", html: "Open <strong class='text-white'>Control Center &gt; Connections</strong> and edit (or recreate) your Tradovate connection: <ol><li>Choose <strong class='text-white'>Tradovate</strong> as the connection provider.</li><li>Enter the <strong class='text-white'>platform trading credentials</strong> your account or prop firm issued for third-party software, not your dashboard email, if the two differ.</li><li>Re-type the username and password by hand to knock out hidden spaces or stray characters from copy-paste.</li><li>Select the <strong class='text-white'>correct environment</strong> (Live vs. Simulation/Demo) for the account you're trading. When in doubt for a prop or evaluation account, ask your firm which environment to use.</li><li>Save and connect. A healthy connection turns green in the Control Center and populates your accounts.</li></ol>" },
    { type: "heading", text: "If It Still Fails After Updating" },
    { type: "paragraph", html: "If you're on 8.1.2.1 or later with the right credentials and environment and the logon still fails, the issue is account- or backend-specific and needs NinjaTrader's team. Send your log and trace files (found in the Documents &gt; NinjaTrader 8 folder) to NinjaTrader support, or use <strong class='text-white'>Control Center &gt; Help &gt; Email Support</strong> and select the platform technical support option so they can inspect your account directly. Avoid rapid retry loops in the meantime so you don't trigger a lockout." },
    { type: "heading", text: "Troubleshooting Table" },
    {
      type: "table",
      headers: ["Error", "Meaning", "Fix"],
      rows: [
        ["Invalid user or password (Logon failed)", "NinjaTrader can't authenticate the Tradovate account, usually a version mismatch", "Update to build 8.1.2.1 or later; NinjaTrader 8.0 cannot connect"],
        ["Username or password is incorrect. (Logon failed)", "Credentials rejected, often wrong login type or stray spaces", "Use platform (not dashboard) credentials; re-type to remove spaces"],
        ["Too many incorrect login attempts.", "Account temporarily locked after repeated failed logins", "Stop retrying, wait, and fix the underlying cause before trying again"],
        ["Connection lost / cannot reach Tradovate", "Network, system-clock drift, or a Tradovate-side outage", "Sync your system clock, use a stable connection, check Tradovate status"],
        ["Delayed 10 minutes / orange symbols", "Real-time data not entitled, separate from login", "Sign the non-professional data agreement and enable real-time data"],
      ],
    },
    { type: "heading", text: "Prevent This With PickMyTrade" },
    { type: "paragraph", html: "A stale desktop build shouldn't be the thing standing between your strategy and the market. PickMyTrade links your TradingView alerts straight through to Tradovate, so your order flow doesn't hinge on one manually maintained NinjaTrader install staying current:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Direct Alert-to-Tradovate Routing</strong>, orders reach your Tradovate account without riding through a separate desktop platform that can quietly fall behind on updates.",
        "<strong class='text-white'>Connection Health Awareness</strong>, a managed bridge means fewer surprise “logon failed” moments mid-session from an out-of-date client.",
        "<strong class='text-white'>Environment &amp; Account Mapping</strong>, route each strategy to the correct account and environment so live vs. simulation mix-ups don't cost you fills.",
        "<strong class='text-white'>Multi-Account Sync</strong>, mirror the same corrected order across accounts, so one working connection covers everything at once.",
      ],
    },
  ], de: [
    { type: "paragraph",html: "Sie geben genau den Tradovate-Benutzernamen und das Passwort ein, mit denen Sie sich problemlos an der Tradovate-Webplattform anmelden, und NinjaTrader meldet trotzdem schroff <strong class='text-white'>„Invalid user or password (Logon failed)“</strong>, sobald Sie die Verbindung herstellen. Die Sache ist die: Ihre Zugangsdaten sind nicht das Problem. Die häufigste Ursache dieses Fehlers im Jahr 2026 ist fast schon peinlich einfach: Sie verwenden noch <strong class='text-white'>NinjaTrader 8.0</strong>, und 8.0 wurde nie dafür gebaut, sich bei Tradovate zu authentifizieren. Die Verbindungsschicht wurde mit dem Release 8.1 geändert, daher lehnt eine 8.0-Installation einen völlig gültigen Tradovate-Login jedes Mal ab. Im Folgenden erkläre ich, was der Fehler tatsächlich bedeutet, warum er auftritt, welche verwandten „Logon failed“-Varianten Ihnen begegnen können und wie Sie ihn dauerhaft beseitigen, außerdem, wie die Automatisierung Ihres Orderflusses verhindert, dass ein veralteter Desktop-Build jemals zwischen Ihre Alerts und Ihre Ausführungen gerät." },
    {
      type: "checklist",
      heading: "Kurze Checkliste für den Tradovate-Logon-Fehler",
      items: [
        "<strong class='text-white'>Prüfen Sie zuerst Ihre NinjaTrader-Version</strong>: Öffnen Sie Help &gt; About und bestätigen Sie, dass Sie Build 8.1.2.1 oder höher verwenden, nicht 8.0.",
        "<strong class='text-white'>Aktualisieren Sie NinjaTrader</strong>, wenn Sie 8.0 verwenden, und starten Sie die Plattform neu, bevor Sie die Verbindung erneut versuchen.",
        "<strong class='text-white'>Verwenden Sie Plattform-(Handels-)Zugangsdaten</strong>, nicht die E-Mail-Adresse und das Passwort Ihres Tradovate-Dashboards, wenn beide voneinander abweichen.",
        "<strong class='text-white'>Entfernen Sie überflüssige Leerzeichen</strong> vor oder nach Benutzername und Passwort in der Verbindungseinrichtung.",
        "<strong class='text-white'>Wählen Sie die richtige Umgebung</strong>, Live oder Simulation/Demo, passend zu dem Konto, mit dem Sie tatsächlich handeln.",
        "<strong class='text-white'>Hören Sie auf, den Login zu bombardieren</strong>, nachdem er einige Male fehlgeschlagen ist, sonst lösen Sie zusätzlich zum ursprünglichen Fehler eine vorübergehende Sperre „too many incorrect login attempts“ aus.",
      ],
    },
    { type: "heading",text: "Was „Invalid User or Password (Logon Failed)“ bedeutet" },
    { type: "paragraph",html: "Trotz des Wortlauts geht es bei diesem Fehler fast nie um ein tatsächlich falsches Passwort. Er bedeutet, dass NinjaTrader Ihre Zugangsdaten an den Authentifizierungsdienst von Tradovate übergeben hat und der Handshake abgelehnt wurde, bevor eine Sitzung zustande kommen konnte. Wenn dieselben Zugangsdaten Sie direkt in die Tradovate-Web- oder Desktop-App einloggen, sind sie in Ordnung. Der Fehler tritt im Verbindungsadapter von NinjaTrader auf, nicht bei Tradovate." },
    { type: "paragraph",html: "Der mit Abstand größte Grund für diese Ablehnung ist eine Versionsabweichung. Die Tradovate-Anbindung wurde in der NinjaTrader-Linie 8.1 hinzugefügt und überarbeitet. <strong class='text-white'>NinjaTrader 8.0 verbindet sich nicht mit einem Tradovate-Konto</strong>, Sie benötigen Build 8.1.2.1 oder höher. Wenn Sie NinjaTrader vor einiger Zeit installiert, geöffnet und nie ein Update ausgeführt haben, ist die Wahrscheinlichkeit hoch, dass Sie noch einen 8.0-Build verwenden, der schlicht nicht mit Tradovate kommunizieren kann, egal wie oft Sie Ihren Login neu eintippen." },
    { type: "heading",text: "Die häufigsten Ursachen für den NinjaTrader-Tradovate-Fehler „Logon Failed“" },
    { type: "heading",text: "1. Sie verwenden NinjaTrader 8.0 (die Hauptursache)" },
    { type: "paragraph",html: "Das ist die entscheidende Lösung. NinjaTrader 8.0 stammt aus der Zeit vor der vollständigen Tradovate-Unterstützung und lehnt die Verbindung selbst bei einem gültigen Konto mit „Invalid user or password (Logon failed)“ ab. Sie benötigen Build <strong class='text-white'>8.1.2.1 oder höher</strong>. Öffnen Sie Help &gt; About im Control Center und lesen Sie die Versionsnummer ab. Beginnt sie mit 8.0, haben Sie Ihr Problem gefunden." },
    { type: "heading",text: "2. Falsche Art von Zugangsdaten (Dashboard- vs. Plattform-Login)" },
    { type: "paragraph",html: "Viele Tradovate- und Prop-Firma-Konten stellen zwei verschiedene Sätze von Zugangsdaten aus: den Dashboard- oder Portal-Login (meist Ihre E-Mail-Adresse) und den Plattform-Handelslogin, den verbundene Software verwendet. Geben Sie Ihre Dashboard-E-Mail dort ein, wo NinjaTrader die Handelszugangsdaten erwartet, schlägt die Authentifizierung fehl. Plattform-Logins von Prop-Firmen sehen oft völlig anders aus als die E-Mail, mit der Sie sich registriert haben. Klären Sie daher, welche Daten Ihre Firma für Drittanbieter-Plattformen vorgesehen hat." },
    { type: "heading",text: "3. Überflüssige Leerzeichen oder ein Copy-Paste-Fehler" },
    { type: "paragraph",html: "Beim Kopieren eines Benutzernamens oder Passworts aus einer E-Mail oder einem Passwortmanager kann ein führendes oder nachfolgendes Leerzeichen oder ein verstecktes Zeichen mitkommen. Tradovate liest das als andere Zugangsdaten und lehnt sie ab. Tippen Sie beide Felder einmal von Hand neu ein, um das auszuschließen." },
    { type: "heading",text: "4. Falsche Umgebung gewählt (Live vs. Simulation)" },
    { type: "paragraph",html: "NinjaTrader fordert Sie auf, eine Verbindungsumgebung zu wählen. Wählen Sie die falsche für Ihr Konto, etwa Live für ein Evaluationskonto, das in der Simulationsumgebung liegt, oder umgekehrt, kann sich das als Logon-Fehler äußern. Evaluations- und Funded-Simulated-Konten von Prop-Firmen benötigen häufig die Umgebung Simulation/Demo, selbst wenn echte Auszahlungen daran hängen." },
    { type: "heading",text: "5. Zu viele Wiederholungen haben eine Sperre ausgelöst" },
    { type: "paragraph",html: "Wenn Sie einen fehlschlagenden Login immer wieder absenden, kann Tradovate das Konto vorübergehend sperren, woraufhin Sie zusätzlich zum ursprünglichen Fehler <strong class='text-white'>„Too many incorrect login attempts.“</strong> sehen können. Das ist eine separate, selbst verursachte Ebene. Die Lösung besteht darin, keine weiteren Versuche zu unternehmen, zu warten und es erst wieder zu versuchen, wenn Sie die eigentliche Ursache (meist die Version) behoben haben." },
    { type: "heading",text: "So beheben Sie den NinjaTrader-Tradovate-Logon-Fehler 2026: Schritt für Schritt" },
    { type: "heading",text: "Eine veraltete NinjaTrader-8.0-Installation beheben" },
    {
      type: "steps",
      items: [
        { title: "Prüfen Sie die Version unter Help > About", html: "Öffnen Sie das NinjaTrader-<strong class='text-white'>Control Center</strong>, gehen Sie zu <strong class='text-white'>Help &gt; About</strong> und lesen Sie die Versionsnummer ab. Beginnt sie mit <strong class='text-white'>8.0</strong>, fahren Sie unten fort." },
        { title: "Laden Sie das neueste NinjaTrader-8-Installationsprogramm herunter", html: "Laden Sie das neueste NinjaTrader-8-Installationsprogramm von der offiziellen NinjaTrader-Website herunter (oder nutzen Sie die integrierte Update-Aufforderung der Plattform, falls beim Start eine erscheint)." },
        { title: "Schließen Sie NinjaTrader, bevor Sie das Installationsprogramm ausführen", html: "Schließen Sie NinjaTrader vollständig, bevor Sie das Installationsprogramm ausführen, damit Dateien während des Updates nicht gesperrt sind." },
        { title: "Führen Sie das Installationsprogramm aus, um den Build zu aktualisieren", html: "Führen Sie das Installationsprogramm aus, um auf <strong class='text-white'>Build 8.1.2.1 oder höher</strong> zu aktualisieren. Nehmen Sie immer den neuesten verfügbaren NinjaTrader-8-Build, da sich die Mindestgrenze mit der Zeit nur nach oben verschiebt." },
        { title: "Bestätigen Sie die Version und verbinden Sie sich erneut", html: "Öffnen Sie NinjaTrader erneut, bestätigen Sie die neue Version unter Help &gt; About und richten Sie die Tradovate-Verbindung dann noch einmal ein." },
      ],
    },
    { type: "heading",text: "Probleme mit Zugangsdaten, Leerzeichen und Umgebung beheben" },
    { type: "paragraph",html: "Öffnen Sie <strong class='text-white'>Control Center &gt; Connections</strong> und bearbeiten (oder erstellen Sie neu) Ihre Tradovate-Verbindung: <ol><li>Wählen Sie <strong class='text-white'>Tradovate</strong> als Verbindungsanbieter.</li><li>Geben Sie die <strong class='text-white'>Plattform-Handelszugangsdaten</strong> ein, die Ihr Konto oder Ihre Prop-Firma für Drittanbieter-Software ausgestellt hat, nicht Ihre Dashboard-E-Mail, wenn beide abweichen.</li><li>Tippen Sie Benutzernamen und Passwort von Hand neu ein, um versteckte Leerzeichen oder Fremdzeichen aus dem Copy-Paste zu beseitigen.</li><li>Wählen Sie die <strong class='text-white'>richtige Umgebung</strong> (Live oder Simulation/Demo) für das Konto, mit dem Sie handeln. Fragen Sie im Zweifel bei einem Prop- oder Evaluationskonto Ihre Firma, welche Umgebung zu verwenden ist.</li><li>Speichern und verbinden. Eine gesunde Verbindung wird im Control Center grün und füllt Ihre Konten.</li></ol>" },
    { type: "heading",text: "Wenn es nach dem Update weiterhin fehlschlägt" },
    { type: "paragraph",html: "Wenn Sie 8.1.2.1 oder höher mit den richtigen Zugangsdaten und der richtigen Umgebung verwenden und der Logon trotzdem fehlschlägt, ist das Problem konto- oder backend-spezifisch und erfordert das Team von NinjaTrader. Senden Sie Ihre Log- und Trace-Dateien (zu finden im Ordner Documents &gt; NinjaTrader 8) an den NinjaTrader-Support oder nutzen Sie <strong class='text-white'>Control Center &gt; Help &gt; Email Support</strong> und wählen Sie die Option für den technischen Plattform-Support, damit man Ihr Konto direkt prüfen kann. Vermeiden Sie in der Zwischenzeit schnelle Wiederholungsschleifen, um keine Sperre auszulösen." },
    { type: "heading",text: "Tabelle zur Fehlersuche" },
    { type: "table", headers: ["Fehler","Bedeutung","Lösung"], rows: [
      ["Meldung „Invalid user or password (Logon failed)“","NinjaTrader kann das Tradovate-Konto nicht authentifizieren, meist eine Versionsabweichung","Auf Build 8.1.2.1 oder höher aktualisieren; NinjaTrader 8.0 kann sich nicht verbinden"],
      ["Meldung „Username or password is incorrect. (Logon failed)“","Zugangsdaten abgelehnt, häufig falscher Login-Typ oder überflüssige Leerzeichen","Plattform-Zugangsdaten (nicht Dashboard) verwenden; zum Entfernen von Leerzeichen neu eintippen"],
      ["Meldung „Too many incorrect login attempts.“","Konto nach wiederholten fehlgeschlagenen Logins vorübergehend gesperrt","Keine weiteren Versuche, warten und die zugrunde liegende Ursache beheben, bevor Sie es erneut versuchen"],
      ["Verbindung verloren / Tradovate nicht erreichbar","Netzwerk, Abweichung der Systemuhr oder ein Ausfall auf Seiten von Tradovate","Systemuhr synchronisieren, stabile Verbindung nutzen, Tradovate-Status prüfen"],
      ["10 Minuten verzögert / orange Symbole","Echtzeitdaten nicht freigeschaltet, unabhängig vom Login","Die Vereinbarung für nichtprofessionelle Daten unterzeichnen und Echtzeitdaten aktivieren"],
    ] },
    { type: "heading",text: "Verhindern Sie das mit PickMyTrade" },
    { type: "paragraph",html: "Ein veralteter Desktop-Build sollte nicht das sein, was zwischen Ihrer Strategie und dem Markt steht. PickMyTrade leitet Ihre TradingView-Alerts direkt an Tradovate weiter, sodass Ihr Orderfluss nicht davon abhängt, dass eine manuell gepflegte NinjaTrader-Installation aktuell bleibt:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Direktes Routing von Alert zu Tradovate</strong>, Orders erreichen Ihr Tradovate-Konto, ohne über eine separate Desktop-Plattform zu laufen, die bei Updates unbemerkt zurückfallen kann.",
        "<strong class='text-white'>Bewusstsein für den Verbindungszustand</strong>, eine verwaltete Brücke bedeutet weniger überraschende „Logon failed“-Momente mitten in der Sitzung durch einen veralteten Client.",
        "<strong class='text-white'>Umgebungs- &amp; Kontozuordnung</strong>, leiten Sie jede Strategie an das richtige Konto und die richtige Umgebung, damit Verwechslungen von Live und Simulation Sie keine Ausführungen kosten.",
        "<strong class='text-white'>Multi-Konto-Synchronisierung</strong>, spiegeln Sie dieselbe korrigierte Order über Konten hinweg, sodass eine funktionierende Verbindung alles auf einmal abdeckt.",
      ],
    },
  ], es: [
    { type: "paragraph",html: "Escribe el nombre de usuario y la contraseña exactos de Tradovate con los que entra sin problemas en la plataforma web de Tradovate, y NinjaTrader aun así devuelve un seco <strong class='text-white'>«Invalid user or password (Logon failed)»</strong> en cuanto intenta conectarse. Lo cierto es que sus credenciales no son el problema. La causa más común de este error en 2026 es casi vergonzosamente simple: sigue ejecutando <strong class='text-white'>NinjaTrader 8.0</strong>, y 8.0 nunca fue diseñado para autenticarse contra Tradovate. La capa de conexión cambió con la versión 8.1, así que una instalación 8.0 rechaza un inicio de sesión de Tradovate perfectamente válido cada vez. A continuación le explicaré qué significa realmente el error, por qué ocurre, las variantes relacionadas de «Logon failed» que puede encontrar y cómo eliminarlo definitivamente, además de cómo automatizar su flujo de órdenes evita que una compilación de escritorio obsoleta se interponga entre sus alertas y sus ejecuciones." },
    {
      type: "checklist",
      heading: "Lista de verificación rápida para el fallo de inicio de sesión de Tradovate",
      items: [
        "<strong class='text-white'>Compruebe primero su versión de NinjaTrader</strong>: abra Help &gt; About y confirme que tiene la compilación 8.1.2.1 o posterior, no la 8.0.",
        "<strong class='text-white'>Actualice NinjaTrader</strong> si está en 8.0 y reinicie la plataforma antes de reintentar la conexión.",
        "<strong class='text-white'>Utilice las credenciales de la plataforma (de trading)</strong>, no el correo y la contraseña de su panel de Tradovate, cuando ambos difieran.",
        "<strong class='text-white'>Elimine los espacios sobrantes</strong> antes o después del nombre de usuario y la contraseña en la configuración de la conexión.",
        "<strong class='text-white'>Elija el entorno correcto</strong>, Live o Simulation/Demo, acorde con la cuenta con la que realmente opera.",
        "<strong class='text-white'>Deje de bombardear el inicio de sesión</strong> tras unos cuantos fallos, o provocará un bloqueo temporal «too many incorrect login attempts» además del error original.",
      ],
    },
    { type: "heading",text: "Qué significa «Invalid User or Password (Logon Failed)»" },
    { type: "paragraph",html: "A pesar de la redacción, este error casi nunca tiene que ver con una contraseña realmente incorrecta. Significa que NinjaTrader entregó sus credenciales al servicio de autenticación de Tradovate y el handshake fue rechazado antes de que pudiera establecerse una sesión. Cuando esas mismas credenciales le permiten entrar directamente en la app web o de escritorio de Tradovate, están bien; el fallo ocurre dentro del adaptador de conexión de NinjaTrader, no en Tradovate." },
    { type: "paragraph",html: "La mayor razón de ese rechazo es una discrepancia de versión. La conectividad con Tradovate se añadió y se reelaboró en la línea 8.1 de NinjaTrader. <strong class='text-white'>NinjaTrader 8.0 no se conectará a una cuenta de Tradovate</strong>; necesita la compilación 8.1.2.1 o posterior. Si instaló NinjaTrader hace tiempo, lo abrió y nunca ejecutó una actualización, es muy probable que siga en una compilación 8.0 que simplemente no puede comunicarse con Tradovate, por muchas veces que vuelva a escribir su acceso." },
    { type: "heading",text: "Principales causas del error «Logon Failed» de NinjaTrader con Tradovate" },
    { type: "heading",text: "1. Está ejecutando NinjaTrader 8.0 (la causa principal)" },
    { type: "paragraph",html: "Esta es la solución principal. NinjaTrader 8.0 es anterior al soporte completo de Tradovate y rechazará la conexión con «Invalid user or password (Logon failed)» incluso con una cuenta válida. Necesita la compilación <strong class='text-white'>8.1.2.1 o posterior</strong>. Abra Help &gt; About dentro del Control Center y lea la cadena de versión; si empieza por 8.0, ahí está su problema." },
    { type: "heading",text: "2. Tipo de credencial incorrecto (acceso al panel frente a acceso a la plataforma)" },
    { type: "paragraph",html: "Muchas cuentas de Tradovate y de firmas de prop trading emiten dos conjuntos distintos de credenciales: el acceso al panel o portal (normalmente su correo) y el acceso de trading de la plataforma que utiliza el software conectado. Si escribe su correo del panel donde NinjaTrader espera las credenciales de trading, la autenticación falla. Los accesos de plataforma de las firmas de prop trading, en particular, a menudo no se parecen en nada al correo con el que se registró, así que confirme qué conjunto le indicó su firma para plataformas de terceros." },
    { type: "heading",text: "3. Espacios sobrantes o un descuido al copiar y pegar" },
    { type: "paragraph",html: "Copiar un nombre de usuario o una contraseña de un correo o de un gestor de contraseñas puede arrastrar un espacio inicial o final, o un carácter oculto. Tradovate lo interpreta como una credencial distinta y la rechaza. Vuelva a escribir ambos campos a mano una vez para descartarlo." },
    { type: "heading",text: "4. Entorno equivocado seleccionado (Live frente a Simulation)" },
    { type: "paragraph",html: "NinjaTrader le pide que elija un entorno de conexión. Si elige el equivocado para su cuenta, por ejemplo Live para una cuenta de evaluación que vive en el entorno de simulación, o al revés, puede manifestarse como un fallo de inicio de sesión. Las cuentas de evaluación y las cuentas fondeadas simuladas de las firmas de prop trading suelen necesitar el entorno Simulation/Demo incluso cuando llevan asociados pagos reales." },
    { type: "heading",text: "5. Demasiados reintentos provocaron un bloqueo" },
    { type: "paragraph",html: "Si sigue reenviando un inicio de sesión que falla, Tradovate puede bloquear temporalmente la cuenta, momento en el que puede ver <strong class='text-white'>«Too many incorrect login attempts.»</strong> sumado al error original. Es una capa distinta, provocada por usted mismo; la solución es dejar de reintentar, esperar y volver a intentarlo solo cuando haya corregido la causa real (normalmente la versión)." },
    { type: "heading",text: "Cómo solucionar el fallo de inicio de sesión de NinjaTrader con Tradovate en 2026: paso a paso" },
    { type: "heading",text: "Corregir una instalación obsoleta de NinjaTrader 8.0" },
    {
      type: "steps",
      items: [
        { title: "Compruebe la versión en Help > About", html: "Abra el <strong class='text-white'>Control Center</strong> de NinjaTrader, vaya a <strong class='text-white'>Help &gt; About</strong> y lea el número de versión. Si empieza por <strong class='text-white'>8.0</strong>, continúe a continuación." },
        { title: "Descargue el instalador más reciente de NinjaTrader 8", html: "Descargue el instalador más reciente de NinjaTrader 8 desde el sitio web oficial de NinjaTrader (o use el aviso de actualización integrado de la plataforma si aparece al iniciar)." },
        { title: "Cierre NinjaTrader antes de ejecutar el instalador", html: "Cierre NinjaTrader por completo antes de ejecutar el instalador para que los archivos no queden bloqueados a mitad de la actualización." },
        { title: "Ejecute el instalador para actualizar la compilación", html: "Ejecute el instalador para actualizar a la <strong class='text-white'>compilación 8.1.2.1 o posterior</strong>; instale siempre la compilación más reciente de NinjaTrader 8, ya que el mínimo requerido solo avanza con el tiempo." },
        { title: "Confirme la versión y vuelva a conectarse", html: "Vuelva a abrir NinjaTrader, confirme la nueva versión en Help &gt; About y luego configure de nuevo la conexión de Tradovate." },
      ],
    },
    { type: "heading",text: "Corregir problemas de credenciales, espacios y entorno" },
    { type: "paragraph",html: "Abra <strong class='text-white'>Control Center &gt; Connections</strong> y edite (o vuelva a crear) su conexión de Tradovate: <ol><li>Elija <strong class='text-white'>Tradovate</strong> como proveedor de conexión.</li><li>Introduzca las <strong class='text-white'>credenciales de trading de la plataforma</strong> que su cuenta o su firma de prop trading emitió para software de terceros, no el correo de su panel, si ambos difieren.</li><li>Vuelva a escribir a mano el nombre de usuario y la contraseña para eliminar espacios ocultos o caracteres sobrantes del copiar y pegar.</li><li>Seleccione el <strong class='text-white'>entorno correcto</strong> (Live o Simulation/Demo) para la cuenta con la que opera. En caso de duda con una cuenta de prop trading o de evaluación, pregunte a su firma qué entorno utilizar.</li><li>Guarde y conecte. Una conexión sana se pone en verde en el Control Center y carga sus cuentas.</li></ol>" },
    { type: "heading",text: "Si sigue fallando después de actualizar" },
    { type: "paragraph",html: "Si está en 8.1.2.1 o posterior con las credenciales y el entorno correctos y el inicio de sesión sigue fallando, el problema es específico de la cuenta o del backend y requiere al equipo de NinjaTrader. Envíe sus archivos de log y trace (en la carpeta Documents &gt; NinjaTrader 8) al soporte de NinjaTrader, o use <strong class='text-white'>Control Center &gt; Help &gt; Email Support</strong> y seleccione la opción de soporte técnico de la plataforma para que puedan inspeccionar su cuenta directamente. Mientras tanto, evite los bucles de reintento rápido para no provocar un bloqueo." },
    { type: "heading",text: "Tabla de resolución de problemas" },
    { type: "table", headers: ["Error","Significado","Solución"], rows: [
      ["Mensaje «Invalid user or password (Logon failed)»","NinjaTrader no puede autenticar la cuenta de Tradovate, normalmente una discrepancia de versión","Actualice a la compilación 8.1.2.1 o posterior; NinjaTrader 8.0 no puede conectarse"],
      ["Mensaje «Username or password is incorrect. (Logon failed)»","Credenciales rechazadas, a menudo por un tipo de acceso incorrecto o espacios sobrantes","Use credenciales de plataforma (no del panel); vuelva a escribirlas para eliminar espacios"],
      ["Mensaje «Too many incorrect login attempts.»","Cuenta bloqueada temporalmente tras inicios de sesión fallidos repetidos","Deje de reintentar, espere y corrija la causa subyacente antes de volver a intentarlo"],
      ["Conexión perdida / no se puede acceder a Tradovate","Red, desfase del reloj del sistema o una caída del lado de Tradovate","Sincronice el reloj del sistema, use una conexión estable y consulte el estado de Tradovate"],
      ["Retraso de 10 minutos / símbolos naranjas","Datos en tiempo real sin derecho, independiente del inicio de sesión","Firme el acuerdo de datos para no profesionales y active los datos en tiempo real"],
    ] },
    { type: "heading",text: "Evítelo con PickMyTrade" },
    { type: "paragraph",html: "Una compilación de escritorio obsoleta no debería ser lo que se interponga entre su estrategia y el mercado. PickMyTrade conecta sus alertas de TradingView directamente con Tradovate, de modo que su flujo de órdenes no depende de que una única instalación de NinjaTrader mantenida manualmente esté al día:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Enrutamiento directo de alerta a Tradovate</strong>, las órdenes llegan a su cuenta de Tradovate sin pasar por una plataforma de escritorio independiente que puede quedarse atrás en las actualizaciones sin que lo note.",
        "<strong class='text-white'>Conciencia del estado de la conexión</strong>, un puente gestionado supone menos momentos sorpresa de «logon failed» a mitad de sesión por un cliente desactualizado.",
        "<strong class='text-white'>Asignación de entorno y cuenta</strong>, dirija cada estrategia a la cuenta y el entorno correctos para que las confusiones entre Live y simulación no le cuesten ejecuciones.",
        "<strong class='text-white'>Sincronización multicuenta</strong>, replique la misma orden corregida en varias cuentas, de modo que una sola conexión operativa lo cubra todo a la vez.",
      ],
    },
  ], fr: [
    { type: "paragraph",html: "Vous saisissez exactement le nom d'utilisateur et le mot de passe Tradovate qui vous connectent sans accroc à la plateforme web Tradovate, et NinjaTrader vous renvoie quand même un sec <strong class='text-white'>« Invalid user or password (Logon failed) »</strong> dès que vous tentez de vous connecter. Le fait est que vos identifiants ne sont pas le problème. La cause la plus courante de cette erreur en 2026 est presque embarrassante de simplicité : vous utilisez encore <strong class='text-white'>NinjaTrader 8.0</strong>, et la 8.0 n'a jamais été conçue pour s'authentifier auprès de Tradovate. La couche de connexion a changé avec la version 8.1, si bien qu'une installation 8.0 rejette à chaque fois une connexion Tradovate parfaitement valide. Ci-dessous, je vous explique ce que l'erreur signifie réellement, pourquoi elle se produit, les variantes « Logon failed » associées que vous pourriez rencontrer et comment la faire disparaître pour de bon, ainsi que la manière dont l'automatisation de votre flux d'ordres évite qu'une build de bureau obsolète ne s'interpose entre vos alertes et vos exécutions." },
    {
      type: "checklist",
      heading: "Liste de vérification rapide pour l'échec de connexion Tradovate",
      items: [
        "<strong class='text-white'>Vérifiez d'abord votre version de NinjaTrader</strong> : ouvrez Help &gt; About et confirmez que vous utilisez la build 8.1.2.1 ou ultérieure, et non la 8.0.",
        "<strong class='text-white'>Mettez à jour NinjaTrader</strong> si vous êtes en 8.0, puis redémarrez la plateforme avant de réessayer la connexion.",
        "<strong class='text-white'>Utilisez les identifiants de la plateforme (de trading)</strong>, et non l'e-mail et le mot de passe de votre tableau de bord Tradovate, lorsque les deux diffèrent.",
        "<strong class='text-white'>Supprimez les espaces parasites</strong> avant ou après le nom d'utilisateur et le mot de passe dans la configuration de la connexion.",
        "<strong class='text-white'>Choisissez le bon environnement</strong>, Live ou Simulation/Demo, correspondant au compte sur lequel vous tradez réellement.",
        "<strong class='text-white'>Cessez de marteler la connexion</strong> après quelques échecs, sinon vous déclencherez un verrouillage temporaire « too many incorrect login attempts » en plus de l'erreur d'origine.",
      ],
    },
    { type: "heading",text: "Ce que signifie « Invalid User or Password (Logon Failed) »" },
    { type: "paragraph",html: "Malgré la formulation, cette erreur n'a presque jamais pour cause un mot de passe réellement erroné. Elle signifie que NinjaTrader a transmis vos identifiants au service d'authentification de Tradovate et que la négociation a été rejetée avant qu'une session puisse être établie. Lorsque ces mêmes identifiants vous connectent directement à l'application web ou de bureau Tradovate, ils sont bons ; l'échec se produit dans l'adaptateur de connexion de NinjaTrader, pas chez Tradovate." },
    { type: "paragraph",html: "La principale raison de ce rejet est une incompatibilité de version. La connectivité Tradovate a été ajoutée et retravaillée dans la branche NinjaTrader 8.1. <strong class='text-white'>NinjaTrader 8.0 ne se connectera pas à un compte Tradovate</strong> : il vous faut la build 8.1.2.1 ou ultérieure. Si vous avez installé NinjaTrader il y a un moment, l'avez ouvert et n'avez jamais lancé de mise à jour, il y a de fortes chances que vous soyez encore sur une build 8.0 qui ne peut tout simplement pas dialoguer avec Tradovate, peu importe combien de fois vous retapez vos identifiants." },
    { type: "heading",text: "Principales causes de l'erreur « Logon Failed » de NinjaTrader avec Tradovate" },
    { type: "heading",text: "1. Vous utilisez NinjaTrader 8.0 (la cause principale)" },
    { type: "paragraph",html: "C'est la correction principale. NinjaTrader 8.0 est antérieur à la prise en charge complète de Tradovate et rejettera la connexion avec « Invalid user or password (Logon failed) » même avec un compte valide. Il vous faut la build <strong class='text-white'>8.1.2.1 ou ultérieure</strong>. Ouvrez Help &gt; About dans le Control Center et lisez la chaîne de version ; si elle commence par 8.0, voilà votre problème." },
    { type: "heading",text: "2. Mauvais type d'identifiants (tableau de bord ou connexion à la plateforme)" },
    { type: "paragraph",html: "De nombreux comptes Tradovate et de prop firms émettent deux jeux d'identifiants distincts : la connexion au tableau de bord ou au portail (généralement votre e-mail) et la connexion de trading de la plateforme que les logiciels connectés utilisent. Saisissez votre e-mail de tableau de bord là où NinjaTrader attend les identifiants de trading et l'authentification échoue. Les connexions de plateforme des prop firms, en particulier, ressemblent souvent peu à l'e-mail avec lequel vous vous êtes inscrit ; confirmez donc quel jeu votre firme vous a indiqué d'utiliser pour les plateformes tierces." },
    { type: "heading",text: "3. Espaces parasites ou erreur de copier-coller" },
    { type: "paragraph",html: "Copier un nom d'utilisateur ou un mot de passe depuis un e-mail ou un gestionnaire de mots de passe peut entraîner un espace en début ou en fin, ou un caractère caché. Tradovate y lit un identifiant différent et le rejette. Retapez une fois les deux champs à la main pour écarter cette possibilité." },
    { type: "heading",text: "4. Mauvais environnement sélectionné (Live ou Simulation)" },
    { type: "paragraph",html: "NinjaTrader vous demande de choisir un environnement de connexion. Si vous choisissez le mauvais pour votre compte, par exemple Live pour un compte d'évaluation qui se trouve dans l'environnement de simulation, ou l'inverse, cela peut se manifester par un échec de connexion. Les comptes d'évaluation et les comptes financés simulés des prop firms nécessitent fréquemment l'environnement Simulation/Demo, même lorsque des retraits réels y sont associés." },
    { type: "heading",text: "5. Trop de nouvelles tentatives ont déclenché un verrouillage" },
    { type: "paragraph",html: "Si vous continuez à soumettre une connexion qui échoue, Tradovate peut verrouiller temporairement le compte, auquel cas vous pouvez voir <strong class='text-white'>« Too many incorrect login attempts. »</strong> s'ajouter à l'erreur d'origine. Il s'agit d'une couche distincte, que vous provoquez vous-même ; la solution est de cesser de réessayer, d'attendre et de ne retenter qu'une fois la vraie cause (généralement la version) corrigée." },
    { type: "heading",text: "Comment corriger l'échec de connexion NinjaTrader avec Tradovate en 2026 : étape par étape" },
    { type: "heading",text: "Corriger une installation NinjaTrader 8.0 obsolète" },
    {
      type: "steps",
      items: [
        { title: "Vérifiez la version sous Help > About", html: "Ouvrez le <strong class='text-white'>Control Center</strong> de NinjaTrader, allez dans <strong class='text-white'>Help &gt; About</strong> et lisez le numéro de version. S'il commence par <strong class='text-white'>8.0</strong>, poursuivez ci-dessous." },
        { title: "Téléchargez le dernier programme d'installation de NinjaTrader 8", html: "Téléchargez le dernier programme d'installation de NinjaTrader 8 depuis le site officiel de NinjaTrader (ou utilisez l'invite de mise à jour intégrée de la plateforme si elle apparaît au lancement)." },
        { title: "Fermez NinjaTrader avant d'exécuter le programme d'installation", html: "Fermez complètement NinjaTrader avant d'exécuter le programme d'installation afin que les fichiers ne soient pas verrouillés en cours de mise à jour." },
        { title: "Exécutez le programme d'installation pour mettre à niveau la build", html: "Exécutez le programme d'installation pour passer à la <strong class='text-white'>build 8.1.2.1 ou ultérieure</strong> ; prenez toujours la build la plus récente de NinjaTrader 8, car le seuil minimum ne fait qu'avancer avec le temps." },
        { title: "Confirmez la version et reconnectez-vous", html: "Rouvrez NinjaTrader, confirmez la nouvelle version sous Help &gt; About, puis configurez de nouveau la connexion Tradovate." },
      ],
    },
    { type: "heading",text: "Corriger les problèmes d'identifiants, d'espaces et d'environnement" },
    { type: "paragraph",html: "Ouvrez <strong class='text-white'>Control Center &gt; Connections</strong> et modifiez (ou recréez) votre connexion Tradovate : <ol><li>Choisissez <strong class='text-white'>Tradovate</strong> comme fournisseur de connexion.</li><li>Saisissez les <strong class='text-white'>identifiants de trading de la plateforme</strong> que votre compte ou votre prop firm a émis pour les logiciels tiers, et non l'e-mail de votre tableau de bord, si les deux diffèrent.</li><li>Retapez à la main le nom d'utilisateur et le mot de passe pour éliminer les espaces cachés ou les caractères parasites du copier-coller.</li><li>Sélectionnez le <strong class='text-white'>bon environnement</strong> (Live ou Simulation/Demo) pour le compte sur lequel vous tradez. En cas de doute pour un compte de prop firm ou d'évaluation, demandez à votre firme quel environnement utiliser.</li><li>Enregistrez et connectez-vous. Une connexion saine passe au vert dans le Control Center et remplit vos comptes.</li></ol>" },
    { type: "heading",text: "Si cela échoue toujours après la mise à jour" },
    { type: "paragraph",html: "Si vous êtes en 8.1.2.1 ou ultérieure avec les bons identifiants et le bon environnement et que la connexion échoue toujours, le problème est propre au compte ou au backend et nécessite l'équipe de NinjaTrader. Envoyez vos fichiers de log et de trace (dans le dossier Documents &gt; NinjaTrader 8) au support NinjaTrader, ou utilisez <strong class='text-white'>Control Center &gt; Help &gt; Email Support</strong> et sélectionnez l'option de support technique de la plateforme afin qu'ils puissent inspecter directement votre compte. Entre-temps, évitez les boucles de nouvelles tentatives rapides pour ne pas déclencher de verrouillage." },
    { type: "heading",text: "Tableau de dépannage" },
    { type: "table", headers: ["Erreur","Signification","Solution"], rows: [
      ["Message « Invalid user or password (Logon failed) »","NinjaTrader ne peut pas authentifier le compte Tradovate, généralement une incompatibilité de version","Mettre à jour vers la build 8.1.2.1 ou ultérieure ; NinjaTrader 8.0 ne peut pas se connecter"],
      ["Message « Username or password is incorrect. (Logon failed) »","Identifiants rejetés, souvent un mauvais type de connexion ou des espaces parasites","Utiliser les identifiants de la plateforme (pas du tableau de bord) ; retaper pour supprimer les espaces"],
      ["Message « Too many incorrect login attempts. »","Compte temporairement verrouillé après des connexions échouées répétées","Cesser de réessayer, patienter et corriger la cause sous-jacente avant de réessayer"],
      ["Connexion perdue / Tradovate injoignable","Réseau, dérive de l'horloge système ou panne côté Tradovate","Synchroniser l'horloge système, utiliser une connexion stable, vérifier le statut de Tradovate"],
      ["Retard de 10 minutes / symboles orange","Données en temps réel non autorisées, indépendant de la connexion","Signer l'accord de données pour non-professionnels et activer les données en temps réel"],
    ] },
    { type: "heading",text: "Évitez cela avec PickMyTrade" },
    { type: "paragraph",html: "Une build de bureau obsolète ne devrait pas être ce qui se dresse entre votre stratégie et le marché. PickMyTrade relie vos alertes TradingView directement à Tradovate, de sorte que votre flux d'ordres ne dépend pas du maintien à jour d'une seule installation NinjaTrader entretenue manuellement :" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Routage direct de l'alerte vers Tradovate</strong>, les ordres atteignent votre compte Tradovate sans transiter par une plateforme de bureau distincte qui peut discrètement prendre du retard sur les mises à jour.",
        "<strong class='text-white'>Suivi de l'état de la connexion</strong>, un pont géré signifie moins de mauvaises surprises « logon failed » en pleine session à cause d'un client obsolète.",
        "<strong class='text-white'>Association environnement et compte</strong>, dirigez chaque stratégie vers le bon compte et le bon environnement pour que les confusions entre live et simulation ne vous coûtent pas d'exécutions.",
        "<strong class='text-white'>Synchronisation multi-comptes</strong>, répliquez le même ordre corrigé sur plusieurs comptes, de sorte qu'une seule connexion fonctionnelle couvre tout à la fois.",
      ],
    },
  ], it: [
    { type: "paragraph",html: "Digita il nome utente e la password Tradovate esatti con cui accede senza problemi alla piattaforma web di Tradovate, e NinjaTrader Le restituisce comunque un secco <strong class='text-white'>«Invalid user or password (Logon failed)»</strong> nel momento in cui tenta di connettersi. Il punto è questo: le Sue credenziali non sono il problema. La causa più comune di questo errore nel 2026 è quasi imbarazzantemente semplice: sta ancora eseguendo <strong class='text-white'>NinjaTrader 8.0</strong>, e la 8.0 non è mai stata progettata per autenticarsi con Tradovate. Il livello di connessione è cambiato con il rilascio 8.1, quindi un'installazione 8.0 rifiuta ogni volta un login Tradovate perfettamente valido. Di seguito Le spiego cosa significa davvero l'errore, perché si verifica, le varianti correlate di «Logon failed» in cui potrebbe imbattersi e come eliminarlo definitivamente, oltre a come l'automazione del Suo flusso di ordini impedisca a una build desktop obsoleta di mettersi tra i Suoi alert e le Sue esecuzioni." },
    {
      type: "checklist",
      heading: "Checklist rapida per l'errore di accesso a Tradovate",
      items: [
        "<strong class='text-white'>Controlli prima la versione di NinjaTrader</strong>: apra Help &gt; About e confermi di essere sulla build 8.1.2.1 o successiva, non sulla 8.0.",
        "<strong class='text-white'>Aggiorni NinjaTrader</strong> se è sulla 8.0, poi riavvii la piattaforma prima di riprovare la connessione.",
        "<strong class='text-white'>Usi le credenziali della piattaforma (di trading)</strong>, non l'e-mail e la password della dashboard Tradovate, quando le due differiscono.",
        "<strong class='text-white'>Elimini gli spazi superflui</strong> prima o dopo il nome utente e la password nella configurazione della connessione.",
        "<strong class='text-white'>Scelga l'ambiente corretto</strong>, Live o Simulation/Demo, in base al conto su cui opera realmente.",
        "<strong class='text-white'>Smetta di martellare il login</strong> dopo alcuni errori, altrimenti oltre all'errore originale scatenerà un blocco temporaneo «too many incorrect login attempts».",
      ],
    },
    { type: "heading",text: "Cosa significa «Invalid User or Password (Logon Failed)»" },
    { type: "paragraph",html: "Nonostante la formulazione, questo errore non riguarda quasi mai una password davvero sbagliata. Significa che NinjaTrader ha consegnato le Sue credenziali al servizio di autenticazione di Tradovate e l'handshake è stato rifiutato prima che si potesse stabilire una sessione. Quando le stesse credenziali La fanno accedere direttamente all'app web o desktop di Tradovate, sono corrette; l'errore avviene all'interno dell'adattatore di connessione di NinjaTrader, non presso Tradovate." },
    { type: "paragraph",html: "Il motivo principale di quel rifiuto è una discrepanza di versione. La connettività Tradovate è stata aggiunta e rielaborata nella linea NinjaTrader 8.1. <strong class='text-white'>NinjaTrader 8.0 non si connetterà a un account Tradovate</strong>: serve la build 8.1.2.1 o successiva. Se ha installato NinjaTrader tempo fa, l'ha aperto e non ha mai eseguito un aggiornamento, è molto probabile che sia ancora su una build 8.0 che semplicemente non può comunicare con Tradovate, per quante volte digiti di nuovo il Suo login." },
    { type: "heading",text: "Cause principali dell'errore «Logon Failed» di NinjaTrader con Tradovate" },
    { type: "heading",text: "1. Sta eseguendo NinjaTrader 8.0 (la causa principale)" },
    { type: "paragraph",html: "Questa è la correzione principale. NinjaTrader 8.0 è precedente al supporto completo di Tradovate e rifiuterà la connessione con «Invalid user or password (Logon failed)» anche con un account valido. Serve la build <strong class='text-white'>8.1.2.1 o successiva</strong>. Apra Help &gt; About all'interno del Control Center e legga la stringa della versione; se inizia con 8.0, ecco il Suo problema." },
    { type: "heading",text: "2. Tipo di credenziale errato (login della dashboard o della piattaforma)" },
    { type: "paragraph",html: "Molti account Tradovate e di prop firm emettono due diversi set di credenziali: il login della dashboard o del portale (di solito la Sua e-mail) e il login di trading della piattaforma usato dal software collegato. Se digita l'e-mail della dashboard dove NinjaTrader si aspetta le credenziali di trading, l'autenticazione fallisce. I login di piattaforma delle prop firm, in particolare, spesso non assomigliano affatto all'e-mail con cui si è registrato, quindi confermi quale set la Sua azienda Le ha indicato per le piattaforme di terze parti." },
    { type: "heading",text: "3. Spazi superflui o una svista nel copia-incolla" },
    { type: "paragraph",html: "Copiare un nome utente o una password da un'e-mail o da un gestore di password può portare con sé uno spazio iniziale o finale, oppure un carattere nascosto. Tradovate lo legge come una credenziale diversa e la rifiuta. Digiti a mano entrambi i campi una volta per escluderlo." },
    { type: "heading",text: "4. Ambiente sbagliato selezionato (Live o Simulation)" },
    { type: "paragraph",html: "NinjaTrader Le chiede di scegliere un ambiente di connessione. Se sceglie quello sbagliato per il Suo conto, per esempio Live per un conto di valutazione che risiede nell'ambiente di simulazione, o viceversa, può manifestarsi come errore di accesso. I conti di valutazione e i conti finanziati simulati delle prop firm richiedono spesso l'ambiente Simulation/Demo anche quando sono associati a veri pagamenti." },
    { type: "heading",text: "5. Troppi nuovi tentativi hanno causato un blocco" },
    { type: "paragraph",html: "Se continua a reinviare un login che fallisce, Tradovate può bloccare temporaneamente l'account, nel qual caso potrebbe vedere <strong class='text-white'>«Too many incorrect login attempts.»</strong> sovrapposto all'errore originale. È un livello separato, causato da Lei stesso; la soluzione è smettere di riprovare, attendere e ritentare solo dopo aver corretto la vera causa (di solito la versione)." },
    { type: "heading",text: "Come risolvere l'errore di accesso NinjaTrader con Tradovate nel 2026: passo dopo passo" },
    { type: "heading",text: "Correggere un'installazione obsoleta di NinjaTrader 8.0" },
    {
      type: "steps",
      items: [
        { title: "Controlli la versione in Help > About", html: "Apra il <strong class='text-white'>Control Center</strong> di NinjaTrader, vada su <strong class='text-white'>Help &gt; About</strong> e legga il numero di versione. Se inizia con <strong class='text-white'>8.0</strong>, prosegua di seguito." },
        { title: "Scarichi l'ultimo installer di NinjaTrader 8", html: "Scarichi l'ultimo installer di NinjaTrader 8 dal sito ufficiale di NinjaTrader (oppure usi la richiesta di aggiornamento integrata della piattaforma, se compare all'avvio)." },
        { title: "Chiuda NinjaTrader prima di eseguire l'installer", html: "Chiuda completamente NinjaTrader prima di eseguire l'installer, in modo che i file non risultino bloccati durante l'aggiornamento." },
        { title: "Esegua l'installer per aggiornare la build", html: "Esegua l'installer per aggiornare alla <strong class='text-white'>build 8.1.2.1 o successiva</strong>; prenda sempre la build più recente disponibile di NinjaTrader 8, poiché la soglia minima si sposta solo in avanti nel tempo." },
        { title: "Confermi la versione e si riconnetta", html: "Riapra NinjaTrader, confermi la nuova versione in Help &gt; About, quindi configuri di nuovo la connessione Tradovate." },
      ],
    },
    { type: "heading",text: "Risolvere problemi di credenziali, spazi e ambiente" },
    { type: "paragraph",html: "Apra <strong class='text-white'>Control Center &gt; Connections</strong> e modifichi (o ricrei) la Sua connessione Tradovate: <ol><li>Scelga <strong class='text-white'>Tradovate</strong> come provider di connessione.</li><li>Inserisca le <strong class='text-white'>credenziali di trading della piattaforma</strong> che il Suo account o la Sua prop firm ha emesso per software di terze parti, non l'e-mail della dashboard, se le due differiscono.</li><li>Digiti di nuovo a mano nome utente e password per eliminare spazi nascosti o caratteri superflui dovuti al copia-incolla.</li><li>Selezioni l'<strong class='text-white'>ambiente corretto</strong> (Live o Simulation/Demo) per il conto su cui opera. In caso di dubbio con un conto prop o di valutazione, chieda alla Sua azienda quale ambiente usare.</li><li>Salvi e si connetta. Una connessione sana diventa verde nel Control Center e popola i Suoi conti.</li></ol>" },
    { type: "heading",text: "Se continua a fallire dopo l'aggiornamento" },
    { type: "paragraph",html: "Se è sulla 8.1.2.1 o successiva con le credenziali e l'ambiente corretti e l'accesso continua a fallire, il problema è specifico dell'account o del backend e richiede il team di NinjaTrader. Invii i file di log e di trace (nella cartella Documents &gt; NinjaTrader 8) al supporto NinjaTrader, oppure usi <strong class='text-white'>Control Center &gt; Help &gt; Email Support</strong> e selezioni l'opzione di supporto tecnico della piattaforma, così che possano ispezionare direttamente il Suo account. Nel frattempo eviti cicli di tentativi rapidi per non provocare un blocco." },
    { type: "heading",text: "Tabella di risoluzione dei problemi" },
    { type: "table", headers: ["Errore","Significato","Soluzione"], rows: [
      ["Messaggio «Invalid user or password (Logon failed)»","NinjaTrader non riesce ad autenticare l'account Tradovate, di solito una discrepanza di versione","Aggiornare alla build 8.1.2.1 o successiva; NinjaTrader 8.0 non può connettersi"],
      ["Messaggio «Username or password is incorrect. (Logon failed)»","Credenziali rifiutate, spesso tipo di login errato o spazi superflui","Usare le credenziali della piattaforma (non della dashboard); digitarle di nuovo per eliminare gli spazi"],
      ["Messaggio «Too many incorrect login attempts.»","Account temporaneamente bloccato dopo ripetuti accessi falliti","Smettere di riprovare, attendere e correggere la causa di fondo prima di riprovare"],
      ["Connessione persa / Tradovate non raggiungibile","Rete, scostamento dell'orologio di sistema o interruzione lato Tradovate","Sincronizzare l'orologio di sistema, usare una connessione stabile, controllare lo stato di Tradovate"],
      ["Ritardo di 10 minuti / simboli arancioni","Dati in tempo reale non abilitati, indipendente dal login","Firmare l'accordo sui dati per non professionisti e abilitare i dati in tempo reale"],
    ] },
    { type: "heading",text: "Lo eviti con PickMyTrade" },
    { type: "paragraph",html: "Una build desktop obsoleta non dovrebbe essere ciò che si frappone tra la Sua strategia e il mercato. PickMyTrade collega i Suoi alert TradingView direttamente a Tradovate, così il Suo flusso di ordini non dipende dal mantenere aggiornata una singola installazione NinjaTrader gestita manualmente:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Instradamento diretto da alert a Tradovate</strong>, gli ordini raggiungono il Suo conto Tradovate senza passare per una piattaforma desktop separata che può restare indietro con gli aggiornamenti senza che se ne accorga.",
        "<strong class='text-white'>Consapevolezza dello stato della connessione</strong>, un ponte gestito significa meno sorprese di «logon failed» a metà sessione dovute a un client non aggiornato.",
        "<strong class='text-white'>Associazione di ambiente e conto</strong>, instradi ogni strategia verso il conto e l'ambiente corretti, così gli scambi tra live e simulazione non Le costano esecuzioni.",
        "<strong class='text-white'>Sincronizzazione multi-conto</strong>, replichi lo stesso ordine corretto su più conti, così un'unica connessione funzionante copre tutto in una volta.",
      ],
    },
  ] },
  ctaHeading: { en: "Trade Rejection-Free", de: "Handeln ohne Ablehnungen", es: "Opere sin rechazos", fr: "Tradez sans rejet", it: "Operi senza rifiuti" },
  ctaText: { en: "Link your alerts today so a stale NinjaTrader build never stands between your strategy and a fill on Tradovate.", de: "Verknüpfen Sie Ihre Alerts noch heute, damit eine veraltete NinjaTrader-Version nie zwischen Ihrer Strategie und einer Ausführung bei Tradovate steht.", es: "Vincule sus alertas hoy para que una versión obsoleta de NinjaTrader nunca se interponga entre su estrategia y una ejecución en Tradovate.", fr: "Liez vos alertes dès aujourd'hui pour qu'une version obsolète de NinjaTrader ne se dresse jamais entre votre stratégie et une exécution sur Tradovate.", it: "Colleghi i Suoi alert oggi stesso, così una versione obsoleta di NinjaTrader non si frapporrà mai tra la Sua strategia e un'esecuzione su Tradovate." },
  ctaButtonText: { en: "Start Your Free 7-Day Trial", de: "Starten Sie Ihre kostenlose 7-Tage-Testphase", es: "Comience su prueba gratuita de 7 días", fr: "Commencez votre essai gratuit de 7 jours", it: "Inizi la prova gratuita di 7 giorni" },
