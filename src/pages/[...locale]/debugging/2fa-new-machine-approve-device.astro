---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "2fa-new-machine-approve-device";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/debugging/${SLUG}`;

const META_TITLE = "Tradovate '2FA Enabled, Log In From New Machine'";
const META_DESCRIPTION =
  "Tradovate 2FA new machine error? Open the device-approval email, approve the machine, and restore login and order routing in minutes.";

// Short SEO title (<=60 chars) for locales where the shared h1 is too long for a SERP title.
const TITLE_OVERRIDE: Partial<Record<Locale, string>> = { es: "Tradovate: error «2FA Enabled, Log In From New Machine»", fr: "Tradovate : « 2FA Enabled, Log In From New Machine »", it: "Tradovate: errore «2FA Enabled, Log In From New Machine»" };

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Tradovate &ldquo;2FA Enabled, Log In From New Machine&rdquo;", es: "Tradovate: error «2FA Enabled, Log In From New Machine»", fr: "Tradovate : &ldquo;2FA Enabled, Log In From New Machine&rdquo;", it: "Tradovate: errore «2FA Enabled, Log In From New Machine»" },
  dek: { en: "Tradovate paused your login because two-factor authentication is on and it doesn't recognize this device yet. Here's how to approve the machine from the emailed link or the My Devices panel and get back to trading.", de: "Tradovate hat Ihre Anmeldung pausiert, weil die Zwei-Faktor-Authentifizierung aktiviert ist und dieses Gerät noch nicht erkannt wird. Hier erfahren Sie, wie Sie das Gerät über den Link in der E-Mail oder das My-Devices-Panel genehmigen und wieder handeln können.", es: "Tradovate pausó su inicio de sesión porque la autenticación en dos pasos está activada y aún no reconoce este dispositivo. Aquí le explicamos cómo aprobar el dispositivo desde el enlace del correo o el panel My Devices para volver a operar.", fr: "Tradovate a mis votre connexion en pause car la double authentification est activée et cet appareil n'est pas encore reconnu. Voici comment approuver l'appareil via le lien reçu par e-mail ou le panneau My Devices pour reprendre le trading.", it: "Tradovate ha messo in pausa il Suo accesso perché l'autenticazione a due fattori è attiva e questo dispositivo non è ancora riconosciuto. Ecco come approvare il dispositivo dal link ricevuto via e-mail o dal pannello My Devices per tornare a operare." },
  readTime: { en: "7 min read", de: "7 Minuten Lesezeit", es: "Lectura de 7 minutos", fr: "Lecture de 7 minutes", it: "Lettura di 7 minuti" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "You sit down at a new laptop, open a fresh browser, or connect through TradingView, and instead of your charts you hit a wall: <strong class='text-white'>&ldquo;You have 2FA enabled and log in from a new machine.&rdquo;</strong> It's one of the most common Tradovate login stops in 2026, and it isn't a bug, it's two-factor authentication doing exactly what it's supposed to. The problem is that until you approve the new device, the session stays locked and nothing can route, which is the last thing you want while you're managing a live position. The same root cause can also surface as an <strong class='text-white'>&ldquo;Access is denied&rdquo;</strong> rejection when an API or third-party connection reaches for a live account. The fix is almost always a single click inside an email Tradovate already sent you. Below is how to approve the device, work the <strong class='text-white'>My Devices</strong> panel, and set up automation like PickMyTrade so an approved, stable connection keeps routing your trades without re-triggering this prompt every time you log in." },
    {
      type: "checklist",
      heading: "Quick Checklist for the 2FA New-Machine Error",
      items: [
        "<strong class='text-white'>Open your email.</strong> Look in the inbox tied to your Tradovate account for a device-login notification and click <strong class='text-white'>Approve</strong>.",
        "<strong class='text-white'>Check spam/junk.</strong> Approval emails land in spam or Promotions constantly; search for &ldquo;Tradovate&rdquo; if it isn't in your inbox.",
        "<strong class='text-white'>Use the right address.</strong> Approve from the exact email address on your Tradovate account, not a forwarded or alternate one.",
        "<strong class='text-white'>No email? Use My Devices.</strong> In Tradovate web, open <strong class='text-white'>Application Settings &gt; My Devices</strong>, find the <strong class='text-white'>Pending</strong> device, and click <strong class='text-white'>Forget</strong> to trigger a fresh approve/deny email.",
        "<strong class='text-white'>Remember: live is strict.</strong> Live accounts won't let a new device log in until it's approved; demo accounts are usually lenient.",
        "<strong class='text-white'>Still blocked?</strong> Contact Tradovate support to approve the device manually, then retry the login.",
      ],
    },
    { type: "heading", text: "What “You Have 2FA Enabled and Log In From a New Machine” Means" },
    { type: "paragraph", html: "The message means two things are true at once: two-factor authentication is switched on for your Tradovate account, <strong class='text-white'>and</strong> you're signing in from a device Tradovate doesn't yet recognize. &ldquo;New machine&rdquo; is broader than most traders assume, a new computer, a different browser, a reinstalled desktop app, cleared cookies, a new IP, or a VPN can all read as an unrecognized device, because the stored device identifier no longer matches." },
    { type: "paragraph", html: "When Tradovate sees an unrecognized device on a 2FA-protected account, it pauses the login and fires an approval email to the address on file. That email lets you <strong class='text-white'>Approve</strong> or <strong class='text-white'>Deny</strong> access from the device, and until you approve it, the session stays blocked. Live accounts enforce this hard, Tradovate won't let a new device log in, even with limited functionality, until the device is approved. Demo and simulation accounts are generally more forgiving, which is exactly why a setup that works in demo falls over the instant you aim it at a live account." },
    { type: "paragraph", html: "Connect through TradingView and the error shows up on TradingView's side as &ldquo;You have 2FA enabled and log in from a new machine,&rdquo; because TradingView's connection to your account hasn't been approved yet. Connect through the API or a bridge and the same unapproved-device condition usually reads as <strong class='text-white'>&ldquo;Access is denied&rdquo;</strong> on live order placement. Different wording, identical fix: approve the device." },
    { type: "heading", text: "Top Causes of the 2FA New-Machine Block" },
    { type: "heading", text: "1. You logged in from a genuinely new or changed device" },
    { type: "paragraph", html: "A new PC, phone, tablet, or a freshly installed Tradovate desktop app has no stored device approval, so 2FA challenges it the first time it connects." },
    { type: "heading", text: "2. Your device “changed” without you realizing" },
    { type: "paragraph", html: "Switching browsers, updating or reinstalling the app, clearing cookies, or connecting through a new network or VPN can invalidate the previously stored device identifier. Tradovate then treats a familiar computer as brand new." },
    { type: "heading", text: "3. The approval email was never actioned" },
    { type: "paragraph", html: "The email went out, but it's sitting unopened in spam, got deleted, or landed at an address you no longer check. No approval click means the device stays blocked." },
    { type: "heading", text: "4. You're on a live account, which enforces approval strictly" },
    { type: "paragraph", html: "Live accounts hard-block unapproved devices. If your code, TradingView layout, or platform runs fine in demo but fails on live, this device-approval requirement is the usual culprit." },
    { type: "heading", text: "5. The device shows “Pending” and was never approved" },
    { type: "paragraph", html: "In <strong class='text-white'>Application Settings &gt; My Devices</strong>, a device that attempted access but was never approved shows a <strong class='text-white'>Pending</strong> status. Until it's approved, that machine can't complete login." },
    { type: "heading", text: "How to Fix the 2FA New-Machine Error: Step-by-Step" },
    { type: "heading", text: "Fixing It via the Approval Email (Fastest Path)" },
    {
      type: "steps",
      items: [
        { title: "Open the right inbox", html: "Open the inbox for the address tied to your Tradovate account." },
        { title: "Find the device-login notification", html: "Find the device-login notification from Tradovate. If it isn't in your inbox, check <strong class='text-white'>Spam/Junk</strong> and any <strong class='text-white'>Promotions</strong> tab, and search for &ldquo;Tradovate.&rdquo;" },
        { title: "Click Approve, not Deny", html: "Open the email and click <strong class='text-white'>Approve</strong>, do not click Deny, since that permanently blocks the device for this attempt." },
        { title: "Log in again", html: "Go back to TradingView, the desktop app, or the web trader and log in again. The session should now complete." },
      ],
    },
    { type: "heading", text: "Fixing It From Application Settings > My Devices" },
    { type: "paragraph", html: "If no email arrived, or you'd rather manage devices directly, work the <strong class='text-white'>My Devices</strong> panel from a machine that already logs in cleanly:" },
    {
      type: "steps",
      items: [
        { title: "Log in on an approved device", html: "Log in to Tradovate web (or the trader app) on a device that's already approved." },
        { title: "Open My Devices", html: "Open <strong class='text-white'>Application Settings</strong> and select <strong class='text-white'>My Devices</strong>. Each device lists its <strong class='text-white'>Device</strong> name, <strong class='text-white'>IP Address</strong>, <strong class='text-white'>Last location</strong>, <strong class='text-white'>Last Login Time</strong>, and <strong class='text-white'>Last App</strong>." },
        { title: "Forget the pending device", html: "Find the new machine showing a <strong class='text-white'>Pending</strong> status and click <strong class='text-white'>Forget</strong>. Forgetting a pending device generates a fresh <strong class='text-white'>Approve</strong> / <strong class='text-white'>Deny</strong> email the next time that device attempts a login." },
        { title: "Approve the fresh email", html: "Trigger the login again from the new device, then open the new email and click <strong class='text-white'>Approve</strong>." },
      ],
    },
    { type: "heading", text: "If No Email Ever Arrives or the Device Stays Denied" },
    {
      type: "steps",
      items: [
        { title: "Confirm the account email", html: "Confirm the email address on your Tradovate account is correct and one you can actually open. A wrong or outdated address is the most common reason the approval email &ldquo;never comes.&rdquo;" },
        { title: "Allow-list Tradovate as a sender", html: "Add Tradovate as a trusted sender and allow-list it so future approval emails don't get filtered." },
        { title: "Ask support to approve manually", html: "Contact Tradovate customer support and ask them to approve the device on their side, this is the recommended fallback when you simply can't receive the approval email." },
        { title: "Send a persistent device ID (API/bridge)", html: "For API or bridge connections hitting a live account, make sure your integration sends a <strong class='text-white'>persistent device ID</strong>, a stable identifier that doesn't change on every request. Approve the device once and it sticks; a device ID that rotates each call keeps re-triggering the challenge. Confirm the exact requirement in the current Tradovate API documentation, since API behavior evolves." },
      ],
    },
    { type: "paragraph", html: "Once a device is approved, <strong class='text-white'>My Devices</strong> lists it as approved with a <strong class='text-white'>Remove Access</strong> option, use that later to revoke a device you no longer trust, such as a shared or public computer." },
    { type: "heading", text: "Troubleshooting Table" },
    {
      type: "table",
      headers: ["Error / State", "What it means", "Fix"],
      rows: [
        ["You have 2FA enabled and log in from a new machine", "2FA is on and this device isn't approved yet", "Open the emailed device notice and click Approve, then log in again"],
        ["Access is denied (live API/bridge)", "Unapproved device on a live account", "Approve the emailed device ID; supply a persistent device ID from your integration"],
        ["Works in demo, fails on live", "Live enforces device approval strictly; demo is lenient", "Approve the new device for the live account specifically"],
        ["No approval email received", "Email in spam, filtered, or sent to the wrong address", "Check spam, verify the account email, then contact support to approve manually"],
        ["Device shows &ldquo;Pending&rdquo; in My Devices", "Device attempted access but was never approved", "Click Forget to regenerate the email, then Approve"],
        ["Prompt returns on every login", "Device identifier keeps changing (new browser, cleared cookies, rotating device ID)", "Log in from a consistent device/connection or send a stable device ID"],
      ],
    },
    { type: "heading", text: "Prevent This with PickMyTrade" },
    { type: "paragraph", html: "When you're automating from TradingView, part of what makes the new-machine prompt so disruptive is that alerts fire from wherever you happen to be, a new browser, a phone, a fresh VPS, and each new origin can re-trigger 2FA. PickMyTrade routes your TradingView alerts to Tradovate over a single, consistent connection, so once your account is linked you're not re-approving a &ldquo;new machine&rdquo; every time you switch laptops or networks." },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Stable, consistent routing</strong>, alerts flow through one steady PickMyTrade connection instead of a rotating set of devices, so you approve your setup once and keep trading.",
        "<strong class='text-white'>Set-once connection</strong>, link your Tradovate account a single time; there's no browser session to babysit on every device you own.",
        "<strong class='text-white'>Live and demo aware</strong>, route to the exact account you intend, live or demo, which matters because live is where device approval is enforced hardest.",
        "<strong class='text-white'>Multi-account sync</strong>, mirror the same alert across multiple Tradovate accounts from one place, without logging each one in from a new machine.",
      ],
    },
  ], de: [
    { type: "paragraph", html: "Sie setzen sich an einen neuen Laptop, öffnen einen frischen Browser oder verbinden sich über TradingView, und statt Ihrer Charts stoßen Sie auf eine Wand: <strong class='text-white'>&ldquo;You have 2FA enabled and log in from a new machine.&rdquo;</strong> Das ist einer der häufigsten Anmelde-Stopps bei Tradovate im Jahr 2026, und es ist kein Fehler, sondern die Zwei-Faktor-Authentifizierung, die genau das tut, was sie soll. Das Problem: Bis Sie das neue Gerät genehmigen, bleibt die Sitzung gesperrt, und nichts kann geroutet werden, das Letzte, was Sie wollen, während Sie eine Live-Position verwalten. Dieselbe Ursache kann sich auch als Ablehnung <strong class='text-white'>&ldquo;Access is denied&rdquo;</strong> zeigen, wenn eine API- oder Drittanbieter-Verbindung auf ein Live-Konto zugreift. Die Lösung besteht fast immer aus einem einzigen Klick in einer E-Mail, die Tradovate Ihnen bereits geschickt hat. Im Folgenden erfahren Sie, wie Sie das Gerät genehmigen, das Panel <strong class='text-white'>My Devices</strong> nutzen, und wie Sie eine Automatisierung wie PickMyTrade einrichten, damit eine genehmigte, stabile Verbindung Ihre Trades weiterhin routet, ohne diese Abfrage bei jeder Anmeldung erneut auszulösen." },
    {
      type: "checklist",
      heading: "Kurz-Checkliste für den 2FA-Fehler bei neuem Gerät",
      items: [
        "<strong class='text-white'>Öffnen Sie Ihre E-Mails.</strong> Suchen Sie im Postfach, das mit Ihrem Tradovate-Konto verknüpft ist, nach einer Geräte-Anmeldemeldung und klicken Sie auf <strong class='text-white'>Approve</strong>.",
        "<strong class='text-white'>Prüfen Sie Spam/Junk.</strong> Genehmigungs-E-Mails landen ständig im Spam oder unter Werbung; suchen Sie nach &ldquo;Tradovate&rdquo;, falls sie nicht im Posteingang liegt.",
        "<strong class='text-white'>Nutzen Sie die richtige Adresse.</strong> Genehmigen Sie von der exakten E-Mail-Adresse Ihres Tradovate-Kontos aus, nicht von einer weitergeleiteten oder alternativen.",
        "<strong class='text-white'>Keine E-Mail? Nutzen Sie My Devices.</strong> Öffnen Sie in Tradovate Web <strong class='text-white'>Application Settings &gt; My Devices</strong>, finden Sie das Gerät mit Status <strong class='text-white'>Pending</strong> und klicken Sie auf <strong class='text-white'>Forget</strong>, um eine neue Genehmigungs-E-Mail auszulösen.",
        "<strong class='text-white'>Denken Sie daran: Live ist streng.</strong> Live-Konten lassen ein neues Gerät erst nach Genehmigung zu; Demo-Konten sind in der Regel nachsichtiger.",
        "<strong class='text-white'>Immer noch blockiert?</strong> Kontaktieren Sie den Tradovate-Support, damit das Gerät manuell genehmigt wird, und versuchen Sie die Anmeldung dann erneut.",
      ],
    },
    { type: "heading", text: "Was &ldquo;You Have 2FA Enabled and Log In From a New Machine&rdquo; bedeutet" },
    { type: "paragraph", html: "Die Meldung bedeutet, dass zwei Dinge gleichzeitig zutreffen: Die Zwei-Faktor-Authentifizierung ist für Ihr Tradovate-Konto aktiviert, <strong class='text-white'>und</strong> Sie melden sich von einem Gerät an, das Tradovate noch nicht kennt. &ldquo;Neues Gerät&rdquo; ist weiter gefasst, als die meisten Trader annehmen, ein neuer Computer, ein anderer Browser, eine neu installierte Desktop-App, gelöschte Cookies, eine neue IP-Adresse oder ein VPN können alle als nicht erkanntes Gerät gelten, weil die gespeicherte Gerätekennung nicht mehr übereinstimmt." },
    { type: "paragraph", html: "Erkennt Tradovate ein nicht erkanntes Gerät bei einem 2FA-geschützten Konto, pausiert es die Anmeldung und sendet eine Genehmigungs-E-Mail an die hinterlegte Adresse. Diese E-Mail erlaubt Ihnen, den Zugriff des Geräts mit <strong class='text-white'>Approve</strong> oder <strong class='text-white'>Deny</strong> zu bestätigen oder abzulehnen, und bis Sie genehmigen, bleibt die Sitzung blockiert. Live-Konten setzen das strikt durch, Tradovate lässt ein neues Gerät nicht anmelden, selbst mit eingeschränkter Funktion nicht, bis es genehmigt ist. Demo- und Simulationskonten sind meist nachsichtiger, weshalb ein Setup, das in Demo funktioniert, sofort scheitert, sobald Sie es auf ein Live-Konto richten." },
    { type: "paragraph", html: "Verbinden Sie sich über TradingView, erscheint der Fehler auf Seiten von TradingView als &ldquo;You have 2FA enabled and log in from a new machine,&rdquo; weil die Verbindung von TradingView zu Ihrem Konto noch nicht genehmigt wurde. Verbinden Sie sich über die API oder eine Bridge, zeigt sich derselbe Zustand eines nicht genehmigten Geräts meist als <strong class='text-white'>&ldquo;Access is denied&rdquo;</strong> bei der Live-Orderaufgabe. Andere Formulierung, identische Lösung: das Gerät genehmigen." },
    { type: "heading", text: "Die häufigsten Ursachen für die 2FA-Sperre bei neuem Gerät" },
    { type: "heading", text: "1. Sie haben sich von einem wirklich neuen oder geänderten Gerät angemeldet" },
    { type: "paragraph", html: "Ein neuer PC, ein Telefon, ein Tablet oder eine frisch installierte Tradovate-Desktop-App besitzt keine gespeicherte Geräte-Genehmigung, weshalb 2FA sie beim ersten Verbindungsversuch herausfordert." },
    { type: "heading", text: "2. Ihr Gerät hat sich &ldquo;geändert&rdquo;, ohne dass Sie es bemerkt haben" },
    { type: "paragraph", html: "Ein Browserwechsel, ein Update oder eine Neuinstallation der App, gelöschte Cookies oder eine Verbindung über ein neues Netzwerk oder VPN können die zuvor gespeicherte Gerätekennung ungültig machen. Tradovate behandelt einen vertrauten Computer dann wie einen völlig neuen." },
    { type: "heading", text: "3. Die Genehmigungs-E-Mail wurde nie bearbeitet" },
    { type: "paragraph", html: "Die E-Mail wurde verschickt, liegt aber ungeöffnet im Spam, wurde gelöscht oder landete bei einer Adresse, die Sie nicht mehr prüfen. Ohne Klick auf Genehmigen bleibt das Gerät blockiert." },
    { type: "heading", text: "4. Sie nutzen ein Live-Konto, das die Genehmigung streng durchsetzt" },
    { type: "paragraph", html: "Live-Konten blockieren nicht genehmigte Geräte vollständig. Läuft Ihr Code, Ihr TradingView-Layout oder Ihre Plattform in Demo einwandfrei, scheitert aber bei Live, ist diese Geräte-Genehmigungspflicht meist der Übeltäter." },
    { type: "heading", text: "5. Das Gerät zeigt &ldquo;Pending&rdquo; und wurde nie genehmigt" },
    { type: "paragraph", html: "In <strong class='text-white'>Application Settings &gt; My Devices</strong> zeigt ein Gerät, das einen Zugriffsversuch unternommen hat, aber nie genehmigt wurde, den Status <strong class='text-white'>Pending</strong>. Bis es genehmigt ist, kann dieses Gerät die Anmeldung nicht abschließen." },
    { type: "heading", text: "So beheben Sie den 2FA-Fehler bei neuem Gerät: Schritt für Schritt" },
    { type: "heading", text: "Lösung über die Genehmigungs-E-Mail (schnellster Weg)" },
    {
      type: "steps",
      items: [
        { title: "Öffnen Sie das richtige Postfach", html: "Öffnen Sie das Postfach der Adresse, die mit Ihrem Tradovate-Konto verknüpft ist." },
        { title: "Finden Sie die Geräte-Anmeldemeldung", html: "Suchen Sie die Geräte-Anmeldemeldung von Tradovate. Liegt sie nicht im Posteingang, prüfen Sie <strong class='text-white'>Spam/Junk</strong> und einen eventuellen <strong class='text-white'>Promotions</strong>-Tab, und suchen Sie nach &ldquo;Tradovate.&rdquo;" },
        { title: "Klicken Sie auf Approve, nicht auf Deny", html: "Öffnen Sie die E-Mail und klicken Sie auf <strong class='text-white'>Approve</strong>, klicken Sie nicht auf Deny, da dies das Gerät für diesen Versuch dauerhaft blockiert." },
        { title: "Melden Sie sich erneut an", html: "Gehen Sie zurück zu TradingView, der Desktop-App oder dem Web-Trader und melden Sie sich erneut an. Die Sitzung sollte nun abgeschlossen werden." },
      ],
    },
    { type: "heading", text: "Lösung über Application Settings > My Devices" },
    { type: "paragraph", html: "Ist keine E-Mail angekommen, oder möchten Sie Geräte lieber direkt verwalten, arbeiten Sie das Panel <strong class='text-white'>My Devices</strong> von einem Gerät aus durch, das sich bereits sauber anmeldet:" },
    {
      type: "steps",
      items: [
        { title: "Melden Sie sich auf einem genehmigten Gerät an", html: "Melden Sie sich bei Tradovate Web (oder der Trader-App) auf einem bereits genehmigten Gerät an." },
        { title: "Öffnen Sie My Devices", html: "Öffnen Sie <strong class='text-white'>Application Settings</strong> und wählen Sie <strong class='text-white'>My Devices</strong>. Jedes Gerät zeigt seinen <strong class='text-white'>Device</strong>-Namen, die <strong class='text-white'>IP Address</strong>, den <strong class='text-white'>Last location</strong>, die <strong class='text-white'>Last Login Time</strong> und die <strong class='text-white'>Last App</strong>." },
        { title: "Vergessen Sie das ausstehende Gerät", html: "Finden Sie das neue Gerät mit dem Status <strong class='text-white'>Pending</strong> und klicken Sie auf <strong class='text-white'>Forget</strong>. Das Vergessen eines ausstehenden Geräts erzeugt beim nächsten Anmeldeversuch dieses Geräts eine neue <strong class='text-white'>Approve</strong>/<strong class='text-white'>Deny</strong>-E-Mail." },
        { title: "Genehmigen Sie die neue E-Mail", html: "Lösen Sie die Anmeldung erneut vom neuen Gerät aus, öffnen Sie dann die neue E-Mail und klicken Sie auf <strong class='text-white'>Approve</strong>." },
      ],
    },
    { type: "heading", text: "Wenn nie eine E-Mail ankommt oder das Gerät weiterhin abgelehnt wird" },
    {
      type: "steps",
      items: [
        { title: "Bestätigen Sie die Konto-E-Mail", html: "Bestätigen Sie, dass die E-Mail-Adresse Ihres Tradovate-Kontos korrekt ist und dass Sie sie tatsächlich öffnen können. Eine falsche oder veraltete Adresse ist der häufigste Grund, warum die Genehmigungs-E-Mail &ldquo;nie ankommt.&rdquo;" },
        { title: "Setzen Sie Tradovate als vertrauenswürdigen Absender", html: "Fügen Sie Tradovate als vertrauenswürdigen Absender hinzu und setzen Sie ihn auf die Positivliste, damit künftige Genehmigungs-E-Mails nicht gefiltert werden." },
        { title: "Bitten Sie den Support um manuelle Genehmigung", html: "Kontaktieren Sie den Tradovate-Kundensupport und bitten Sie ihn, das Gerät von seiner Seite aus zu genehmigen, das ist die empfohlene Rückfalllösung, wenn Sie die Genehmigungs-E-Mail schlicht nicht erhalten können." },
        { title: "Senden Sie eine dauerhafte Geräte-ID (API/Bridge)", html: "Stellen Sie bei API- oder Bridge-Verbindungen zu einem Live-Konto sicher, dass Ihre Integration eine <strong class='text-white'>dauerhafte Geräte-ID</strong> sendet, eine stabile Kennung, die sich nicht bei jeder Anfrage ändert. Genehmigen Sie das Gerät einmal, und es bleibt bestehen; eine Geräte-ID, die sich bei jedem Aufruf ändert, löst die Prüfung immer wieder aus. Bestätigen Sie die genaue Anforderung in der aktuellen Tradovate-API-Dokumentation, da sich das API-Verhalten weiterentwickelt." },
      ],
    },
    { type: "paragraph", html: "Sobald ein Gerät genehmigt ist, listet <strong class='text-white'>My Devices</strong> es als genehmigt mit einer Option <strong class='text-white'>Remove Access</strong>, nutzen Sie diese später, um einem Gerät, dem Sie nicht mehr vertrauen, etwa einem gemeinsam genutzten oder öffentlichen Computer, den Zugriff zu entziehen." },
    { type: "heading", text: "Fehlerbehebungstabelle" },
    {
      type: "table",
      headers: ["Fehler / Zustand", "Was es bedeutet", "Lösung"],
      rows: [
        ["You have 2FA enabled and log in from a new machine", "2FA ist aktiv und dieses Gerät ist noch nicht genehmigt", "Öffnen Sie die per E-Mail zugestellte Gerätemeldung, klicken Sie auf Approve und melden Sie sich erneut an"],
        ["Access is denied (live API/bridge)", "Nicht genehmigtes Gerät bei einem Live-Konto", "Genehmigen Sie die per E-Mail zugestellte Geräte-ID; übermitteln Sie eine dauerhafte Geräte-ID aus Ihrer Integration"],
        ["Funktioniert in Demo, scheitert bei Live", "Live setzt die Geräte-Genehmigung streng durch; Demo ist nachsichtig", "Genehmigen Sie das neue Gerät speziell für das Live-Konto"],
        ["Keine Genehmigungs-E-Mail erhalten", "E-Mail im Spam, gefiltert oder an die falsche Adresse gesendet", "Prüfen Sie Spam, verifizieren Sie die Konto-E-Mail, kontaktieren Sie dann den Support zur manuellen Genehmigung"],
        ["Gerät zeigt &ldquo;Pending&rdquo; in My Devices", "Gerät hat einen Zugriffsversuch unternommen, wurde aber nie genehmigt", "Klicken Sie auf Forget, um die E-Mail neu zu erzeugen, dann auf Approve"],
        ["Abfrage erscheint bei jeder Anmeldung erneut", "Die Gerätekennung ändert sich ständig (neuer Browser, gelöschte Cookies, rotierende Geräte-ID)", "Melden Sie sich von einem konsistenten Gerät/einer konsistenten Verbindung an oder senden Sie eine stabile Geräte-ID"],
      ],
    },
    { type: "heading", text: "So vermeiden Sie das mit PickMyTrade" },
    { type: "paragraph", html: "Wenn Sie von TradingView aus automatisieren, macht es die Abfrage bei neuem Gerät unter anderem deshalb so störend, dass Alerts von überall auslösen, wo Sie sich gerade befinden, ein neuer Browser, ein Telefon, ein frischer VPS, und jeder neue Ursprung kann 2FA erneut auslösen. PickMyTrade leitet Ihre TradingView-Alerts über eine einzige, konsistente Verbindung an Tradovate weiter, sodass Sie, sobald Ihr Konto verknüpft ist, nicht bei jedem Laptop- oder Netzwerkwechsel ein &ldquo;neues Gerät&rdquo; erneut genehmigen müssen." },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Stabiles, konsistentes Routing</strong>, Alerts laufen über eine einzige, durchgängige PickMyTrade-Verbindung statt über einen wechselnden Satz von Geräten, sodass Sie Ihr Setup einmal genehmigen und weiterhandeln.",
        "<strong class='text-white'>Einmalige Verbindung</strong>, verknüpfen Sie Ihr Tradovate-Konto ein einziges Mal; es gibt keine Browsersitzung, die Sie auf jedem Ihrer Geräte im Blick behalten müssen.",
        "<strong class='text-white'>Live- und Demo-bewusst</strong>, routen Sie genau zum beabsichtigten Konto, live oder Demo, was wichtig ist, weil die Geräte-Genehmigung bei Live am strengsten durchgesetzt wird.",
        "<strong class='text-white'>Synchronisation mehrerer Konten</strong>, spiegeln Sie denselben Alert über mehrere Tradovate-Konten von einer Stelle aus, ohne sich bei jedem einzeln von einem neuen Gerät aus anzumelden.",
      ],
    },
  ], es: [
    { type: "paragraph", html: "Se sienta en un portátil nuevo, abre un navegador recién instalado, o se conecta a través de TradingView, y en lugar de sus gráficos se encuentra con un muro: <strong class='text-white'>&ldquo;You have 2FA enabled and log in from a new machine.&rdquo;</strong> Es uno de los bloqueos de inicio de sesión más comunes en Tradovate en 2026, y no es un error, es la autenticación en dos pasos haciendo exactamente lo que debe hacer. El problema es que hasta que apruebe el dispositivo nuevo, la sesión permanece bloqueada y nada puede enrutarse, lo último que desea mientras gestiona una posición real. La misma causa raíz también puede aparecer como un rechazo <strong class='text-white'>&ldquo;Access is denied&rdquo;</strong> cuando una API o una conexión de terceros intenta acceder a una cuenta real. La solución casi siempre consiste en un solo clic dentro de un correo que Tradovate ya le envió. A continuación explicamos cómo aprobar el dispositivo, trabajar con el panel <strong class='text-white'>My Devices</strong>, y configurar una automatización como PickMyTrade para que una conexión aprobada y estable siga enrutando sus operaciones sin volver a activar este aviso cada vez que inicia sesión." },
    {
      type: "checklist",
      heading: "Lista rápida para el error de 2FA por dispositivo nuevo",
      items: [
        "<strong class='text-white'>Abra su correo.</strong> Busque en la bandeja de entrada vinculada a su cuenta de Tradovate una notificación de inicio de sesión de dispositivo y haga clic en <strong class='text-white'>Approve</strong>.",
        "<strong class='text-white'>Revise spam/correo no deseado.</strong> Los correos de aprobación caen constantemente en spam o Promociones; busque &ldquo;Tradovate&rdquo; si no está en su bandeja de entrada.",
        "<strong class='text-white'>Use la dirección correcta.</strong> Apruebe desde la dirección de correo exacta de su cuenta de Tradovate, no desde una reenviada o alternativa.",
        "<strong class='text-white'>¿Sin correo? Use My Devices.</strong> En Tradovate web, abra <strong class='text-white'>Application Settings &gt; My Devices</strong>, busque el dispositivo <strong class='text-white'>Pending</strong> y haga clic en <strong class='text-white'>Forget</strong> para generar un nuevo correo de aprobar/rechazar.",
        "<strong class='text-white'>Recuerde: real es estricto.</strong> Las cuentas reales no dejan iniciar sesión a un dispositivo nuevo hasta que esté aprobado; las cuentas demo suelen ser más flexibles.",
        "<strong class='text-white'>¿Sigue bloqueado?</strong> Contacte al soporte de Tradovate para que aprueben el dispositivo manualmente y luego reintente el inicio de sesión.",
      ],
    },
    { type: "heading", text: "Qué significa &ldquo;You Have 2FA Enabled and Log In From a New Machine&rdquo;" },
    { type: "paragraph", html: "El mensaje significa que dos cosas son ciertas a la vez: la autenticación en dos pasos está activada en su cuenta de Tradovate, <strong class='text-white'>y</strong> usted inicia sesión desde un dispositivo que Tradovate aún no reconoce. &ldquo;Dispositivo nuevo&rdquo; es más amplio de lo que la mayoría de los traders supone: una computadora nueva, un navegador diferente, una app de escritorio reinstalada, cookies borradas, una IP nueva o una VPN pueden leerse todos como un dispositivo no reconocido, porque el identificador de dispositivo almacenado ya no coincide." },
    { type: "paragraph", html: "Cuando Tradovate detecta un dispositivo no reconocido en una cuenta protegida con 2FA, pausa el inicio de sesión y envía un correo de aprobación a la dirección registrada. Ese correo le permite <strong class='text-white'>Approve</strong> o <strong class='text-white'>Deny</strong> el acceso desde el dispositivo, y hasta que lo apruebe, la sesión permanece bloqueada. Las cuentas reales aplican esto estrictamente, Tradovate no deja iniciar sesión a un dispositivo nuevo, ni siquiera con funcionalidad limitada, hasta que esté aprobado. Las cuentas demo y de simulación suelen ser más indulgentes, precisamente por eso una configuración que funciona en demo falla en cuanto la apunta a una cuenta real." },
    { type: "paragraph", html: "Si se conecta a través de TradingView, el error aparece del lado de TradingView como &ldquo;You have 2FA enabled and log in from a new machine,&rdquo; porque la conexión de TradingView con su cuenta aún no ha sido aprobada. Si se conecta a través de la API o un bridge, la misma condición de dispositivo no aprobado suele leerse como <strong class='text-white'>&ldquo;Access is denied&rdquo;</strong> al colocar órdenes en real. Redacción distinta, misma solución: aprobar el dispositivo." },
    { type: "heading", text: "Principales causas del bloqueo de 2FA por dispositivo nuevo" },
    { type: "heading", text: "1. Inició sesión desde un dispositivo genuinamente nuevo o modificado" },
    { type: "paragraph", html: "Una PC, teléfono o tableta nuevos, o una app de escritorio de Tradovate recién instalada, no tienen ninguna aprobación de dispositivo almacenada, por lo que la 2FA los desafía la primera vez que se conectan." },
    { type: "heading", text: "2. Su dispositivo &ldquo;cambió&rdquo; sin que usted lo notara" },
    { type: "paragraph", html: "Cambiar de navegador, actualizar o reinstalar la app, borrar cookies, o conectarse a través de una red o VPN nueva puede invalidar el identificador de dispositivo almacenado previamente. Tradovate entonces trata a una computadora conocida como si fuera completamente nueva." },
    { type: "heading", text: "3. El correo de aprobación nunca se gestionó" },
    { type: "paragraph", html: "El correo se envió, pero permanece sin abrir en spam, fue eliminado, o llegó a una dirección que usted ya no revisa. Sin hacer clic en aprobar, el dispositivo sigue bloqueado." },
    { type: "heading", text: "4. Está en una cuenta real, que aplica la aprobación estrictamente" },
    { type: "paragraph", html: "Las cuentas reales bloquean por completo los dispositivos no aprobados. Si su código, su diseño de TradingView o su plataforma funcionan bien en demo pero fallan en real, este requisito de aprobación de dispositivo suele ser el culpable habitual." },
    { type: "heading", text: "5. El dispositivo muestra &ldquo;Pending&rdquo; y nunca fue aprobado" },
    { type: "paragraph", html: "En <strong class='text-white'>Application Settings &gt; My Devices</strong>, un dispositivo que intentó acceder pero nunca fue aprobado muestra el estado <strong class='text-white'>Pending</strong>. Hasta que esté aprobado, ese dispositivo no puede completar el inicio de sesión." },
    { type: "heading", text: "Cómo solucionar el error de 2FA por dispositivo nuevo: paso a paso" },
    { type: "heading", text: "Solución a través del correo de aprobación (la vía más rápida)" },
    {
      type: "steps",
      items: [
        { title: "Abra la bandeja de entrada correcta", html: "Abra la bandeja de entrada de la dirección vinculada a su cuenta de Tradovate." },
        { title: "Encuentre la notificación de inicio de sesión de dispositivo", html: "Busque la notificación de inicio de sesión de dispositivo de Tradovate. Si no está en su bandeja de entrada, revise <strong class='text-white'>Spam/Junk</strong> y cualquier pestaña <strong class='text-white'>Promotions</strong>, y busque &ldquo;Tradovate.&rdquo;" },
        { title: "Haga clic en Approve, no en Deny", html: "Abra el correo y haga clic en <strong class='text-white'>Approve</strong>, no haga clic en Deny, ya que eso bloquea el dispositivo de forma permanente para este intento." },
        { title: "Inicie sesión de nuevo", html: "Vuelva a TradingView, la app de escritorio o el web trader e inicie sesión de nuevo. La sesión debería completarse ahora." },
      ],
    },
    { type: "heading", text: "Solución desde Application Settings > My Devices" },
    { type: "paragraph", html: "Si no llegó ningún correo, o prefiere gestionar los dispositivos directamente, trabaje con el panel <strong class='text-white'>My Devices</strong> desde un dispositivo que ya inicie sesión sin problemas:" },
    {
      type: "steps",
      items: [
        { title: "Inicie sesión en un dispositivo aprobado", html: "Inicie sesión en Tradovate web (o en la app trader) en un dispositivo que ya esté aprobado." },
        { title: "Abra My Devices", html: "Abra <strong class='text-white'>Application Settings</strong> y seleccione <strong class='text-white'>My Devices</strong>. Cada dispositivo muestra su nombre de <strong class='text-white'>Device</strong>, la <strong class='text-white'>IP Address</strong>, la <strong class='text-white'>Last location</strong>, la <strong class='text-white'>Last Login Time</strong> y la <strong class='text-white'>Last App</strong>." },
        { title: "Olvide el dispositivo pendiente", html: "Busque el dispositivo nuevo con estado <strong class='text-white'>Pending</strong> y haga clic en <strong class='text-white'>Forget</strong>. Olvidar un dispositivo pendiente genera un nuevo correo de <strong class='text-white'>Approve</strong>/<strong class='text-white'>Deny</strong> la próxima vez que ese dispositivo intente iniciar sesión." },
        { title: "Apruebe el correo nuevo", html: "Vuelva a iniciar sesión desde el dispositivo nuevo, luego abra el nuevo correo y haga clic en <strong class='text-white'>Approve</strong>." },
      ],
    },
    { type: "heading", text: "Si nunca llega ningún correo o el dispositivo sigue rechazado" },
    {
      type: "steps",
      items: [
        { title: "Confirme el correo de la cuenta", html: "Confirme que la dirección de correo de su cuenta de Tradovate es correcta y que realmente puede abrirla. Una dirección incorrecta o desactualizada es la razón más común por la que el correo de aprobación &ldquo;nunca llega.&rdquo;" },
        { title: "Añada a Tradovate como remitente de confianza", html: "Añada a Tradovate como remitente de confianza y agréguelo a la lista blanca para que los futuros correos de aprobación no se filtren." },
        { title: "Pida al soporte que apruebe manualmente", html: "Contacte al soporte al cliente de Tradovate y pídales que aprueben el dispositivo desde su lado, esta es la solución alternativa recomendada cuando simplemente no puede recibir el correo de aprobación." },
        { title: "Envíe un ID de dispositivo persistente (API/bridge)", html: "En conexiones de API o bridge hacia una cuenta real, asegúrese de que su integración envíe un <strong class='text-white'>ID de dispositivo persistente</strong>, un identificador estable que no cambie en cada solicitud. Apruebe el dispositivo una vez y quedará registrado; un ID de dispositivo que rota en cada llamada seguirá activando el desafío. Confirme el requisito exacto en la documentación actual de la API de Tradovate, ya que el comportamiento de la API evoluciona." },
      ],
    },
    { type: "paragraph", html: "Una vez que un dispositivo está aprobado, <strong class='text-white'>My Devices</strong> lo lista como aprobado con una opción <strong class='text-white'>Remove Access</strong>, úsela más adelante para revocar un dispositivo en el que ya no confíe, como una computadora compartida o pública." },
    { type: "heading", text: "Tabla de solución de problemas" },
    {
      type: "table",
      headers: ["Error / Estado", "Qué significa", "Solución"],
      rows: [
        ["You have 2FA enabled and log in from a new machine", "La 2FA está activa y este dispositivo aún no está aprobado", "Abra el aviso de dispositivo enviado por correo y haga clic en Approve, luego inicie sesión de nuevo"],
        ["Access is denied (live API/bridge)", "Dispositivo no aprobado en una cuenta real", "Apruebe el ID de dispositivo enviado por correo; proporcione un ID de dispositivo persistente desde su integración"],
        ["Funciona en demo, falla en real", "Real aplica la aprobación de dispositivo estrictamente; demo es indulgente", "Apruebe el dispositivo nuevo específicamente para la cuenta real"],
        ["No se recibió el correo de aprobación", "Correo en spam, filtrado, o enviado a la dirección equivocada", "Revise spam, verifique el correo de la cuenta, luego contacte al soporte para aprobar manualmente"],
        ["El dispositivo muestra &ldquo;Pending&rdquo; en My Devices", "El dispositivo intentó acceder pero nunca fue aprobado", "Haga clic en Forget para regenerar el correo, luego en Approve"],
        ["El aviso reaparece en cada inicio de sesión", "El identificador de dispositivo cambia constantemente (nuevo navegador, cookies borradas, ID de dispositivo rotativo)", "Inicie sesión desde un dispositivo/conexión consistente o envíe un ID de dispositivo estable"],
      ],
    },
    { type: "heading", text: "Evítelo con PickMyTrade" },
    { type: "paragraph", html: "Cuando automatiza desde TradingView, parte de lo que hace tan disruptivo el aviso de dispositivo nuevo es que las alertas se disparan desde donde sea que usted esté, un navegador nuevo, un teléfono, un VPS recién creado, y cada origen nuevo puede volver a activar la 2FA. PickMyTrade enruta sus alertas de TradingView hacia Tradovate a través de una única conexión consistente, para que, una vez vinculada su cuenta, no tenga que volver a aprobar un &ldquo;dispositivo nuevo&rdquo; cada vez que cambie de portátil o de red." },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Enrutamiento estable y consistente</strong>, las alertas fluyen a través de una única conexión constante de PickMyTrade en lugar de un conjunto rotativo de dispositivos, por lo que aprueba su configuración una vez y sigue operando.",
        "<strong class='text-white'>Conexión de configuración única</strong>, vincule su cuenta de Tradovate una sola vez; no hay una sesión de navegador que vigilar en cada dispositivo que posea.",
        "<strong class='text-white'>Consciente de real y demo</strong>, enrute exactamente a la cuenta que desea, real o demo, lo cual importa porque en real es donde la aprobación de dispositivo se aplica con más fuerza.",
        "<strong class='text-white'>Sincronización multicuenta</strong>, replique la misma alerta en varias cuentas de Tradovate desde un solo lugar, sin iniciar sesión en cada una desde un dispositivo nuevo.",
      ],
    },
  ], fr: [
    { type: "paragraph", html: "Vous vous installez sur un nouvel ordinateur portable, ouvrez un navigateur inédit, ou vous connectez via TradingView, et au lieu de vos graphiques, vous vous heurtez à un mur : <strong class='text-white'>&ldquo;You have 2FA enabled and log in from a new machine.&rdquo;</strong> C'est l'un des blocages de connexion les plus courants chez Tradovate en 2026, et ce n'est pas un bug, c'est la double authentification qui fait exactement ce qu'elle est censée faire. Le problème, c'est que tant que vous n'approuvez pas le nouvel appareil, la session reste verrouillée et rien ne peut s'acheminer, la dernière chose que vous souhaitez pendant que vous gérez une position réelle. La même cause peut aussi se manifester par un refus <strong class='text-white'>&ldquo;Access is denied&rdquo;</strong> lorsqu'une API ou une connexion tierce sollicite un compte réel. La solution tient presque toujours en un seul clic dans un e-mail que Tradovate vous a déjà envoyé. Voici comment approuver l'appareil, utiliser le panneau <strong class='text-white'>My Devices</strong>, et mettre en place une automatisation comme PickMyTrade afin qu'une connexion approuvée et stable continue d'acheminer vos trades sans redéclencher cette invite à chaque connexion." },
    {
      type: "checklist",
      heading: "Check-list rapide pour l'erreur 2FA de nouvel appareil",
      items: [
        "<strong class='text-white'>Ouvrez votre e-mail.</strong> Recherchez dans la boîte de réception associée à votre compte Tradovate une notification de connexion d'appareil et cliquez sur <strong class='text-white'>Approve</strong>.",
        "<strong class='text-white'>Vérifiez les spams/indésirables.</strong> Les e-mails d'approbation atterrissent constamment dans les spams ou Promotions ; recherchez &ldquo;Tradovate&rdquo; s'il n'est pas dans votre boîte de réception.",
        "<strong class='text-white'>Utilisez la bonne adresse.</strong> Approuvez depuis l'adresse e-mail exacte de votre compte Tradovate, pas depuis une adresse transférée ou alternative.",
        "<strong class='text-white'>Pas d'e-mail ? Utilisez My Devices.</strong> Dans Tradovate web, ouvrez <strong class='text-white'>Application Settings &gt; My Devices</strong>, trouvez l'appareil <strong class='text-white'>Pending</strong>, et cliquez sur <strong class='text-white'>Forget</strong> pour déclencher un nouvel e-mail d'approbation/refus.",
        "<strong class='text-white'>Rappel : le réel est strict.</strong> Les comptes réels ne laissent pas un nouvel appareil se connecter tant qu'il n'est pas approuvé ; les comptes démo sont généralement plus souples.",
        "<strong class='text-white'>Toujours bloqué ?</strong> Contactez le support Tradovate pour faire approuver l'appareil manuellement, puis réessayez de vous connecter.",
      ],
    },
    { type: "heading", text: "Ce que signifie &ldquo;You Have 2FA Enabled and Log In From a New Machine&rdquo;" },
    { type: "paragraph", html: "Ce message signifie que deux choses sont vraies en même temps : la double authentification est activée sur votre compte Tradovate, <strong class='text-white'>et</strong> vous vous connectez depuis un appareil que Tradovate ne reconnaît pas encore. &ldquo;Nouvel appareil&rdquo; est une notion plus large que ce que la plupart des traders imaginent, un nouvel ordinateur, un navigateur différent, une application de bureau réinstallée, des cookies effacés, une nouvelle IP ou un VPN peuvent tous être perçus comme un appareil non reconnu, car l'identifiant d'appareil enregistré ne correspond plus." },
    { type: "paragraph", html: "Lorsque Tradovate détecte un appareil non reconnu sur un compte protégé par 2FA, il met la connexion en pause et envoie un e-mail d'approbation à l'adresse enregistrée. Cet e-mail vous permet d'<strong class='text-white'>Approve</strong> ou de <strong class='text-white'>Deny</strong> l'accès depuis l'appareil, et tant que vous n'approuvez pas, la session reste bloquée. Les comptes réels appliquent cette règle strictement, Tradovate ne laisse pas un nouvel appareil se connecter, même avec une fonctionnalité limitée, tant qu'il n'est pas approuvé. Les comptes démo et de simulation sont généralement plus indulgents, ce qui explique pourquoi une configuration qui fonctionne en démo échoue dès que vous la pointez vers un compte réel." },
    { type: "paragraph", html: "Si vous vous connectez via TradingView, l'erreur apparaît côté TradingView sous la forme &ldquo;You have 2FA enabled and log in from a new machine,&rdquo; car la connexion de TradingView à votre compte n'a pas encore été approuvée. Si vous vous connectez via l'API ou un bridge, la même situation d'appareil non approuvé se lit généralement comme <strong class='text-white'>&ldquo;Access is denied&rdquo;</strong> lors du passage d'un ordre en réel. Formulation différente, solution identique : approuver l'appareil." },
    { type: "heading", text: "Principales causes du blocage 2FA pour nouvel appareil" },
    { type: "heading", text: "1. Vous vous êtes connecté depuis un appareil réellement nouveau ou modifié" },
    { type: "paragraph", html: "Un nouveau PC, un téléphone, une tablette, ou une application de bureau Tradovate fraîchement installée ne possède aucune approbation d'appareil enregistrée, la 2FA la met donc au défi dès la première connexion." },
    { type: "heading", text: "2. Votre appareil a &ldquo;changé&rdquo; sans que vous vous en rendiez compte" },
    { type: "paragraph", html: "Changer de navigateur, mettre à jour ou réinstaller l'application, effacer les cookies, ou se connecter via un nouveau réseau ou VPN peut invalider l'identifiant d'appareil précédemment enregistré. Tradovate traite alors un ordinateur familier comme totalement nouveau." },
    { type: "heading", text: "3. L'e-mail d'approbation n'a jamais été traité" },
    { type: "paragraph", html: "L'e-mail a bien été envoyé, mais il reste non lu dans les spams, a été supprimé, ou est arrivé à une adresse que vous ne consultez plus. Sans clic d'approbation, l'appareil reste bloqué." },
    { type: "heading", text: "4. Vous êtes sur un compte réel, qui applique l'approbation strictement" },
    { type: "paragraph", html: "Les comptes réels bloquent totalement les appareils non approuvés. Si votre code, votre disposition TradingView ou votre plateforme fonctionne bien en démo mais échoue en réel, cette exigence d'approbation d'appareil est généralement en cause." },
    { type: "heading", text: "5. L'appareil affiche &ldquo;Pending&rdquo; et n'a jamais été approuvé" },
    { type: "paragraph", html: "Dans <strong class='text-white'>Application Settings &gt; My Devices</strong>, un appareil qui a tenté d'accéder mais n'a jamais été approuvé affiche le statut <strong class='text-white'>Pending</strong>. Tant qu'il n'est pas approuvé, cet appareil ne peut pas terminer la connexion." },
    { type: "heading", text: "Comment résoudre l'erreur 2FA de nouvel appareil : étape par étape" },
    { type: "heading", text: "Résolution via l'e-mail d'approbation (la voie la plus rapide)" },
    {
      type: "steps",
      items: [
        { title: "Ouvrez la bonne boîte de réception", html: "Ouvrez la boîte de réception de l'adresse associée à votre compte Tradovate." },
        { title: "Trouvez la notification de connexion d'appareil", html: "Trouvez la notification de connexion d'appareil de Tradovate. Si elle n'est pas dans votre boîte de réception, vérifiez <strong class='text-white'>Spam/Junk</strong> et un éventuel onglet <strong class='text-white'>Promotions</strong>, et recherchez &ldquo;Tradovate.&rdquo;" },
        { title: "Cliquez sur Approve, pas sur Deny", html: "Ouvrez l'e-mail et cliquez sur <strong class='text-white'>Approve</strong>, ne cliquez pas sur Deny, car cela bloque définitivement l'appareil pour cette tentative." },
        { title: "Reconnectez-vous", html: "Retournez sur TradingView, l'application de bureau ou le web trader et reconnectez-vous. La session devrait maintenant se terminer normalement." },
      ],
    },
    { type: "heading", text: "Résolution depuis Application Settings > My Devices" },
    { type: "paragraph", html: "Si aucun e-mail n'est arrivé, ou si vous préférez gérer les appareils directement, utilisez le panneau <strong class='text-white'>My Devices</strong> depuis un appareil qui se connecte déjà normalement :" },
    {
      type: "steps",
      items: [
        { title: "Connectez-vous sur un appareil approuvé", html: "Connectez-vous à Tradovate web (ou à l'application trader) sur un appareil déjà approuvé." },
        { title: "Ouvrez My Devices", html: "Ouvrez <strong class='text-white'>Application Settings</strong> et sélectionnez <strong class='text-white'>My Devices</strong>. Chaque appareil affiche son nom <strong class='text-white'>Device</strong>, son <strong class='text-white'>IP Address</strong>, sa <strong class='text-white'>Last location</strong>, sa <strong class='text-white'>Last Login Time</strong>, et sa <strong class='text-white'>Last App</strong>." },
        { title: "Oubliez l'appareil en attente", html: "Trouvez le nouvel appareil affichant le statut <strong class='text-white'>Pending</strong> et cliquez sur <strong class='text-white'>Forget</strong>. Oublier un appareil en attente génère un nouvel e-mail <strong class='text-white'>Approve</strong>/<strong class='text-white'>Deny</strong> lors de la prochaine tentative de connexion de cet appareil." },
        { title: "Approuvez le nouvel e-mail", html: "Relancez la connexion depuis le nouvel appareil, puis ouvrez le nouvel e-mail et cliquez sur <strong class='text-white'>Approve</strong>." },
      ],
    },
    { type: "heading", text: "Si aucun e-mail n'arrive jamais ou si l'appareil reste refusé" },
    {
      type: "steps",
      items: [
        { title: "Confirmez l'e-mail du compte", html: "Confirmez que l'adresse e-mail de votre compte Tradovate est correcte et que vous pouvez réellement l'ouvrir. Une adresse erronée ou obsolète est la raison la plus courante pour laquelle l'e-mail d'approbation &ldquo;n'arrive jamais.&rdquo;" },
        { title: "Ajoutez Tradovate comme expéditeur de confiance", html: "Ajoutez Tradovate comme expéditeur de confiance et mettez-le sur liste blanche afin que les futurs e-mails d'approbation ne soient pas filtrés." },
        { title: "Demandez au support d'approuver manuellement", html: "Contactez le support client de Tradovate et demandez-lui d'approuver l'appareil de son côté, c'est la solution de repli recommandée lorsque vous ne pouvez tout simplement pas recevoir l'e-mail d'approbation." },
        { title: "Envoyez un identifiant d'appareil persistant (API/bridge)", html: "Pour les connexions API ou bridge vers un compte réel, assurez-vous que votre intégration envoie un <strong class='text-white'>identifiant d'appareil persistant</strong>, un identifiant stable qui ne change pas à chaque requête. Approuvez l'appareil une fois et cela reste valable ; un identifiant d'appareil qui change à chaque appel continuera de redéclencher le défi. Confirmez l'exigence exacte dans la documentation actuelle de l'API Tradovate, car le comportement de l'API évolue." },
      ],
    },
    { type: "paragraph", html: "Une fois qu'un appareil est approuvé, <strong class='text-white'>My Devices</strong> le liste comme approuvé avec une option <strong class='text-white'>Remove Access</strong>, utilisez-la plus tard pour révoquer un appareil auquel vous ne faites plus confiance, comme un ordinateur partagé ou public." },
    { type: "heading", text: "Tableau de dépannage" },
    {
      type: "table",
      headers: ["Erreur / État", "Ce que cela signifie", "Solution"],
      rows: [
        ["You have 2FA enabled and log in from a new machine", "La 2FA est active et cet appareil n'est pas encore approuvé", "Ouvrez l'avis d'appareil reçu par e-mail et cliquez sur Approve, puis reconnectez-vous"],
        ["Access is denied (live API/bridge)", "Appareil non approuvé sur un compte réel", "Approuvez l'identifiant d'appareil envoyé par e-mail ; fournissez un identifiant d'appareil persistant depuis votre intégration"],
        ["Fonctionne en démo, échoue en réel", "Le réel applique l'approbation d'appareil strictement ; la démo est indulgente", "Approuvez le nouvel appareil spécifiquement pour le compte réel"],
        ["Aucun e-mail d'approbation reçu", "E-mail dans les spams, filtré, ou envoyé à la mauvaise adresse", "Vérifiez les spams, vérifiez l'e-mail du compte, puis contactez le support pour approuver manuellement"],
        ["L'appareil affiche &ldquo;Pending&rdquo; dans My Devices", "L'appareil a tenté d'accéder mais n'a jamais été approuvé", "Cliquez sur Forget pour régénérer l'e-mail, puis sur Approve"],
        ["L'invite revient à chaque connexion", "L'identifiant d'appareil change constamment (nouveau navigateur, cookies effacés, identifiant d'appareil rotatif)", "Connectez-vous depuis un appareil/une connexion cohérente ou envoyez un identifiant d'appareil stable"],
