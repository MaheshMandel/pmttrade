  ctaHeading: { en: "Trade Hands-Off, No Login Window Required", de: "Hands-off handeln, ganz ohne Anmeldefenster", es: "Opere sin intervención manual, sin ventana de inicio de sesión", fr: "Tradez en mode automatique, sans fenêtre de connexion", it: "Operate senza intervento manuale, senza finestra di accesso" },
  ctaText: { en: "Link your Tradovate account once and let PickMyTrade route your TradingView alerts, so a broken Google button never stalls your strategy.", de: "Verknüpfen Sie Ihr Tradovate-Konto einmalig und lassen Sie PickMyTrade Ihre TradingView-Alerts weiterleiten, damit ein defekter Google-Button Ihre Strategie nie ausbremst.", es: "Vincule su cuenta de Tradovate una sola vez y deje que PickMyTrade enrute sus alertas de TradingView, para que un botón de Google roto nunca detenga su estrategia.", fr: "Reliez votre compte Tradovate une seule fois et laissez PickMyTrade acheminer vos alertes TradingView, afin qu'un bouton Google défaillant ne bloque jamais votre stratégie.", it: "Collegate il vostro account Tradovate una sola volta e lasciate che PickMyTrade instradi i vostri alert di TradingView, così un pulsante Google rotto non blocca mai la vostra strategia." },
  ctaButtonText: { en: "Start Your Free 7-Day Trial", de: "Starten Sie Ihre kostenlose 5-tägige Testversion", es: "Inicie su prueba gratuita de 5 días", fr: "Démarrez votre essai gratuit de 5 jours", it: "Avviate la vostra prova gratuita di 5 giorni" },
