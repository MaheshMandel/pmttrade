---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "google-signin-fails-desktop-app";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/debugging/${SLUG}`;

const META_TITLE = "Tradovate 'Sign in With Google' Fails on Desktop";
const META_DESCRIPTION =
  "Tradovate 'Sign in with Google' failing on desktop? Learn why the embedded login breaks and how to sign in from the web platform in minutes.";

// Short SEO title (<=60 chars) for locales where the shared h1 is too long for a SERP title.
const TITLE_OVERRIDE: Partial<Record<Locale, string>> = { es: "Tradovate: falla el inicio de sesión con Google (escritorio)" };

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Tradovate: Anmeldung mit Google schlägt auf dem Desktop fehl", es: "Tradovate: el inicio de sesión con Google falla en el escritorio", fr: "Tradovate : la connexion avec Google échoue sur le bureau", it: "Tradovate: l'accesso con Google non funziona su desktop" },
  dek: { en: "You click Sign in with Google in the Tradovate desktop app and hit an error instead of your charts. Here's why Google blocks the embedded login window and how to get back in fast.", de: "Sie klicken in der Tradovate-Desktop-App auf Mit Google anmelden und erhalten statt Ihrer Charts eine Fehlermeldung. Hier erfahren Sie, warum Google das eingebettete Anmeldefenster blockiert und wie Sie schnell wieder Zugriff bekommen.", es: "Usted hace clic en Iniciar sesión con Google en la aplicación de escritorio de Tradovate y, en lugar de sus gráficos, aparece un error. Descubra por qué Google bloquea la ventana de inicio de sesión integrada y cómo recuperar el acceso en minutos.", fr: "Vous cliquez sur Se connecter avec Google dans l'application de bureau Tradovate et obtenez une erreur au lieu de vos graphiques. Voici pourquoi Google bloque la fenêtre de connexion intégrée et comment vous reconnecter rapidement.", it: "Fate clic su Accedi con Google nell'app desktop di Tradovate e, invece dei vostri grafici, compare un errore. Ecco perché Google blocca la finestra di accesso integrata e come tornare operativi in pochi minuti." },
  readTime: { en: "6 min read", de: "6 Minuten Lesezeit", es: "Lectura de 6 minutos", fr: "Lecture de 6 minutes", it: "Lettura di 6 minuti" },
  lastUpdated: "2026-07-09",
  blocks: { en: [
    { type: "paragraph", html: "You open the Tradovate desktop app, click <strong class='text-white'>Sign in with Google</strong>, pick your account, and instead of your charts you get an error. Maybe it's a flat &ldquo;this browser or app may not be secure,&rdquo; maybe a code like <strong class='text-white'>disallowed_useragent</strong>, maybe just a login window that closes and dumps you back where you started. The frustrating part is that the exact same Google account logs in fine in Chrome, and it even works on the Tradovate website. So what's actually broken? Nothing on your side. This is Google refusing to run its sign-in flow inside the app's built-in login window, and once you know that, the fix takes about a minute. Below is why it happens, how to get logged in right now from the web platform or with your username and password, and how to make sure it never stalls your automated trading." },
    {
      type: "checklist",
      heading: "Quick Checklist to Get Logged In Now",
      items: [
        "<strong class='text-white'>Sign in on the web platform.</strong> Open the Tradovate web trader in Chrome, Edge, or Safari and use Sign in with Google there. It runs in your real browser, which Google trusts, so it goes through.",
        "<strong class='text-white'>Or use username and password.</strong> On the desktop app, ignore the Google button and log in with your Tradovate username and password instead. Direct login works on desktop, web, and mobile.",
        "<strong class='text-white'>No password set?</strong> If you only ever used the Google button, click Reset Password, enter your account email, and set a password so you can log in directly from anywhere.",
        "<strong class='text-white'>Don't reinstall in a panic.</strong> Reinstalling the desktop app won't fix it, because the block is Google's policy, not a corrupted install.",
        "<strong class='text-white'>Keep automation off this button.</strong> If you route TradingView alerts to Tradovate, your orders shouldn't depend on the desktop app's Google login at all.",
      ],
    },
    { type: "heading", text: "What's Actually Happening When Google Sign-In Fails on Desktop" },
    { type: "paragraph", html: "When you click <strong class='text-white'>Sign in with Google</strong> in a desktop app, the app has to show you Google's login page somehow. The Tradovate desktop app does it by opening an <em>embedded</em> browser window, a small web view baked into the app rather than your normal Chrome, Edge, or Safari. That embedded window is where the trouble starts." },
    { type: "paragraph", html: "Google has spent years tightening its rules on where OAuth sign-in is allowed to run. Embedded browser components let the surrounding app potentially read what you type, inject scripts, or grab session cookies, so Google decided they can't be trusted for account logins. Over a series of enforcement waves, Google moved to block sign-in attempts coming from these embedded web views entirely. Try to log in from one now and Google returns an error rather than a password prompt, commonly worded as &ldquo;this browser or app may not be secure,&rdquo; or surfaced as the error code <strong class='text-white'>disallowed_useragent</strong>. If you click the Learn More link on that error, it explains that the embedded browser Google detected doesn't meet its requirements for signing in." },
    { type: "paragraph", html: "That's the whole story. The desktop app's login window is an embedded web view, Google won't run its sign-in inside embedded web views, so the Google button in the app hits a wall. Your Tradovate account is untouched, your Google password is fine, and your funding and permissions are unaffected. The proof is that the identical Google account signs in without a hiccup on the Tradovate website, because a real browser is exactly the kind of trusted, full browser Google wants the flow to run in." },
    { type: "paragraph", html: "This isn't a Windows-only or Mac-only quirk either. The embedded-web-view restriction lives on Google's side and applies to the embedded browser components used on both operating systems, so you can hit the same error in the desktop app whether you're on Windows or macOS. The workaround is identical on both." },
    { type: "heading", text: "Why This Started and Why Reinstalling Won't Help" },
    { type: "paragraph", html: "A lot of traders' first instinct is to uninstall the app, clear everything, and reinstall, assuming the download went bad. Save yourself the time. A fresh install gives you the same embedded login window, which Google will reject in exactly the same way. Clearing cookies, switching your default browser, or updating the app to the newest version doesn't change the outcome either, because none of those touch the actual cause: Google won't authenticate inside an embedded web view, full stop." },
    { type: "paragraph", html: "It also explains why this can appear to &ldquo;suddenly&rdquo; break on a setup that worked before. Google rolled its embedded-web-view block out in stages rather than all at once. An app login flow that slipped through an earlier phase can stop working after a later enforcement wave, with no change on your end. So if the Google button worked in the app months ago and quietly stopped, you didn't do anything wrong, the goalposts moved." },
    { type: "heading", text: "How to Fix It: Sign In From the Web Platform" },
    { type: "paragraph", html: "The cleanest fix is to log in where Google's flow is happy to run: a real browser." },
    {
      type: "steps",
      items: [
        { title: "Open a normal browser", html: "Chrome, Edge, Safari, or Firefox all work." },
        { title: "Go to the Tradovate web trader login page", html: "Use the same account you use in the desktop app." },
        { title: "Click Sign in with Google on the web page", html: "Because this is a full browser and not an embedded window, Google shows you the normal account picker and password prompt." },
        { title: "Pick your Google account and approve if prompted", html: "You're in. Same charts, same DOM, same account." },
      ],
    },
    { type: "paragraph", html: "The web trader isn't a stripped-down version of the platform. You get the full charting, order ticket, SuperDOM, ATM strategies, and account tools, and many traders run on the web platform full time. If you're only reaching for the desktop app out of habit, the web login gets you trading immediately with zero setup." },
    { type: "heading", text: "How to Fix It: Use Username and Password on the Desktop App" },
    { type: "paragraph", html: "If you specifically want the desktop app, for its detachable windows or multi-monitor layout, you don't have to use the Google button at all. Tradovate accepts a direct username and password login on the desktop app, and that path has nothing to do with Google's embedded-web-view rule." },
    {
      type: "steps",
      items: [
        { title: "Open the desktop app to the login screen", html: "Nothing else to prepare first." },
        { title: "Type your Tradovate username and password", html: "Instead of clicking Sign in with Google, type your credentials into the fields." },
        { title: "Choose the account mode and log in", html: "Pick simulation or live, then log in." },
      ],
    },
    { type: "heading", text: "What If You Signed Up With Google and Never Made a Password?" },
    { type: "paragraph", html: "Plenty of traders created their Tradovate account by clicking the Google button on day one and never set a separate password. If that's you, the username-and-password path looks impossible, but it's a two-minute fix:" },
    {
      type: "list",
      items: [
        "On the login screen, click <strong class='text-white'>Reset Password</strong> (or the equivalent &ldquo;forgot password&rdquo; link).",
        "Enter the username or the email address tied to your Tradovate account, use the same email as your Google account, since that's what's on file.",
        "Open the reset email Tradovate sends and follow the link to set a password.",
        "Go back to the desktop app and log in with your username and that new password. You now have a login that doesn't depend on the Google button at all.",
      ],
    },
    { type: "quote", html: "If you connect to Tradovate through a prop firm, your login may not use the Google button in the first place. Many firms hand you a dedicated Tradovate username and password when you pass or purchase an evaluation. If yours did, use those credentials directly and skip the Google flow entirely." },
    { type: "heading", text: "Troubleshooting Table" },
    {
      type: "table",
      headers: ["What you see", "What it means", "Fix"],
      rows: [
        ["Google error in the desktop app (&ldquo;browser or app may not be secure&rdquo; / disallowed_useragent)", "Google won't run sign-in inside the app's embedded login window", "Sign in on the web platform in a real browser, or use username and password on desktop"],
        ["Google login works in Chrome but not in the app", "A full browser is trusted; the app's embedded web view is not", "Use the web trader, or switch the desktop app to username/password login"],
        ["Reinstalling the app didn't help", "The block is Google's policy, not a bad install", "Stop reinstalling; use one of the two login paths above"],
        ["You only ever used the Google button and have no password", "No direct credentials are set on the account yet", "Use Reset Password with your account email, set a password, then log in directly"],
        ["Login worked in the app months ago, now it doesn't", "Google tightened embedded-web-view enforcement over time", "Move to the web platform or username/password; nothing on your account changed"],
        ["Prop-firm account won't take the Google button", "Firm accounts often use dedicated Tradovate credentials", "Log in with the username and password your firm issued"],
      ],
    },
    { type: "heading", text: "Keep Your Automated Trading Running With PickMyTrade" },
    { type: "paragraph", html: "Here's the bigger point: if your trading depends on you being logged into the desktop app to fire orders, a broken button on one device can freeze your whole day. That's a fragile way to trade. PickMyTrade links your Tradovate account a single time and routes your TradingView alerts to it over its own connection, so your strategy keeps executing no matter which app or login screen is misbehaving on your laptop." },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Link once, trade hands-off.</strong> Connect your Tradovate account a single time; there's no desktop login window to babysit before every session.",
        "<strong class='text-white'>Orders fire on their own connection.</strong> Your TradingView alerts route straight to Tradovate, so a stuck Google button on the desktop app never blocks a fill.",
        "<strong class='text-white'>Live and demo aware.</strong> Point alerts at exactly the account you mean, whether it's a live account or a simulated one.",
        "<strong class='text-white'>Multi-account sync.</strong> Mirror the same alert across several Tradovate accounts from one place, without logging each one in separately.",
      ],
    },
  ], de: [
    { type: "paragraph", html: "Sie öffnen die Tradovate-Desktop-App, klicken auf <strong class='text-white'>Mit Google anmelden</strong>, wählen Ihr Konto aus, und statt Ihrer Charts erscheint eine Fehlermeldung. Mal ist es schlicht &ldquo;this browser or app may not be secure,&rdquo; mal ein Code wie <strong class='text-white'>disallowed_useragent</strong>, mal schließt sich nur das Anmeldefenster und Sie landen wieder am Ausgangspunkt. Das Frustrierende daran: Genau dasselbe Google-Konto meldet sich in Chrome problemlos an, und es funktioniert sogar auf der Tradovate-Website. Was ist also wirklich kaputt? Nichts auf Ihrer Seite. Google weigert sich, seinen Anmeldevorgang im integrierten Anmeldefenster der App auszuführen, und sobald Sie das wissen, dauert die Lösung etwa eine Minute. Im Folgenden erfahren Sie, warum das passiert, wie Sie sich jetzt sofort über die Web-Plattform oder mit Benutzername und Passwort anmelden können, und wie Sie sicherstellen, dass es Ihren automatisierten Handel nie ausbremst." },
    {
      type: "checklist",
      heading: "Schnell-Checkliste: Jetzt anmelden",
      items: [
        "<strong class='text-white'>Melden Sie sich auf der Web-Plattform an.</strong> Öffnen Sie den Tradovate Web Trader in Chrome, Edge oder Safari und nutzen Sie dort Mit Google anmelden. Es läuft in Ihrem echten Browser, dem Google vertraut, also funktioniert es.",
        "<strong class='text-white'>Oder Benutzername und Passwort verwenden.</strong> Ignorieren Sie in der Desktop-App den Google-Button und melden Sie sich stattdessen mit Ihrem Tradovate-Benutzernamen und -Passwort an. Die direkte Anmeldung funktioniert auf Desktop, Web und Mobilgeräten.",
        "<strong class='text-white'>Kein Passwort eingerichtet?</strong> Wenn Sie bisher nur den Google-Button verwendet haben, klicken Sie auf Passwort zurücksetzen, geben Sie Ihre Konto-E-Mail-Adresse ein und legen Sie ein Passwort fest, damit Sie sich von überall direkt anmelden können.",
        "<strong class='text-white'>Nicht in Panik neu installieren.</strong> Eine Neuinstallation der Desktop-App behebt das Problem nicht, denn die Blockade ist eine Google-Richtlinie und keine defekte Installation.",
        "<strong class='text-white'>Automatisierung nicht von diesem Button abhängig machen.</strong> Wenn Sie TradingView-Alerts an Tradovate weiterleiten, sollten Ihre Orders keinesfalls von der Google-Anmeldung der Desktop-App abhängen.",
      ],
    },
    { type: "heading", text: "Was tatsächlich passiert, wenn die Google-Anmeldung auf dem Desktop fehlschlägt" },
    { type: "paragraph", html: "Wenn Sie in einer Desktop-App auf <strong class='text-white'>Mit Google anmelden</strong> klicken, muss die App Ihnen irgendwie die Google-Anmeldeseite anzeigen. Die Tradovate-Desktop-App tut dies, indem sie ein <em>eingebettetes</em> Browserfenster öffnet, eine kleine Web-Ansicht, die fest in die App integriert ist, statt Ihres gewohnten Chrome, Edge oder Safari. Genau in diesem eingebetteten Fenster beginnt das Problem." },
    { type: "paragraph", html: "Google verschärft seit Jahren die Regeln dafür, wo OAuth-Anmeldungen ablaufen dürfen. Eingebettete Browserkomponenten ermöglichen es der umgebenden App potenziell, mitzulesen, was Sie eingeben, Skripte einzuschleusen oder Sitzungscookies abzugreifen, weshalb Google entschieden hat, dass ihnen für Kontoanmeldungen nicht vertraut werden kann. Über mehrere Durchsetzungswellen hinweg hat Google begonnen, Anmeldeversuche aus solchen eingebetteten Web-Ansichten komplett zu blockieren. Versuchen Sie jetzt, sich von dort aus anzumelden, gibt Google statt einer Passwortabfrage einen Fehler zurück, häufig formuliert als &ldquo;this browser or app may not be secure,&rdquo; oder als Fehlercode <strong class='text-white'>disallowed_useragent</strong> angezeigt. Wenn Sie bei diesem Fehler auf den Link Learn More klicken, wird erklärt, dass der von Google erkannte eingebettete Browser dessen Anforderungen für die Anmeldung nicht erfüllt." },
    { type: "paragraph", html: "Das ist die ganze Geschichte. Das Anmeldefenster der Desktop-App ist eine eingebettete Web-Ansicht, Google führt seine Anmeldung in eingebetteten Web-Ansichten nicht aus, also stößt der Google-Button in der App an eine Wand. Ihr Tradovate-Konto bleibt unangetastet, Ihr Google-Passwort ist in Ordnung, und Ihre Einzahlungen und Berechtigungen sind nicht betroffen. Der Beweis: Dasselbe Google-Konto meldet sich auf der Tradovate-Website ohne Probleme an, weil ein echter Browser genau die Art von vertrauenswürdigem, vollwertigem Browser ist, in dem Google den Ablauf ausführen möchte." },
    { type: "paragraph", html: "Das ist auch keine Eigenheit, die nur unter Windows oder nur unter Mac auftritt. Die Einschränkung für eingebettete Web-Ansichten liegt auf Googles Seite und gilt für die eingebetteten Browserkomponenten, die auf beiden Betriebssystemen verwendet werden, sodass derselbe Fehler in der Desktop-App sowohl unter Windows als auch unter macOS auftreten kann. Die Lösung ist auf beiden identisch." },
    { type: "heading", text: "Warum das begann und warum eine Neuinstallation nicht hilft" },
    { type: "paragraph", html: "Der erste Instinkt vieler Trader ist es, die App zu deinstallieren, alles zu löschen und neu zu installieren, in der Annahme, der Download sei fehlerhaft gewesen. Sparen Sie sich die Zeit. Eine frische Installation liefert Ihnen dasselbe eingebettete Anmeldefenster, das Google auf genau dieselbe Weise ablehnen wird. Auch das Löschen von Cookies, das Wechseln des Standardbrowsers oder das Aktualisieren der App auf die neueste Version ändert nichts am Ergebnis, denn keine dieser Maßnahmen berührt die eigentliche Ursache: Google authentifiziert grundsätzlich nicht innerhalb einer eingebetteten Web-Ansicht." },
    { type: "paragraph", html: "Das erklärt auch, warum das Problem bei einem zuvor funktionierenden Setup scheinbar &ldquo;plötzlich&rdquo; auftaucht. Google hat die Blockade für eingebettete Web-Ansichten in Etappen ausgerollt statt auf einmal. Ein App-Anmeldeablauf, der eine frühere Phase überstanden hat, kann nach einer späteren Durchsetzungswelle aufhören zu funktionieren, ohne dass sich auf Ihrer Seite etwas geändert hätte. Wenn der Google-Button in der App also vor Monaten funktioniert hat und dann stillschweigend aufgehört hat, haben Sie nichts falsch gemacht, die Regeln haben sich verändert." },
    { type: "heading", text: "So beheben Sie es: Anmeldung über die Web-Plattform" },
    { type: "paragraph", html: "Die sauberste Lösung ist, sich dort anzumelden, wo Googles Ablauf reibungslos funktioniert: in einem echten Browser." },
    {
      type: "steps",
      items: [
        { title: "Einen normalen Browser öffnen", html: "Chrome, Edge, Safari oder Firefox funktionieren alle." },
        { title: "Zur Anmeldeseite des Tradovate Web Traders gehen", html: "Verwenden Sie dasselbe Konto wie in der Desktop-App." },
        { title: "Auf der Webseite auf Mit Google anmelden klicken", html: "Da es sich um einen vollwertigen Browser und kein eingebettetes Fenster handelt, zeigt Google Ihnen die normale Kontoauswahl und Passwortabfrage." },
        { title: "Google-Konto auswählen und bei Bedarf bestätigen", html: "Sie sind drin. Gleiche Charts, gleiches DOM, gleiches Konto." },
      ],
    },
    { type: "paragraph", html: "Der Web Trader ist keine abgespeckte Version der Plattform. Sie erhalten das vollständige Charting, das Order-Ticket, SuperDOM, ATM-Strategien und die Kontowerkzeuge, und viele Trader nutzen dauerhaft ausschließlich die Web-Plattform. Wenn Sie nur aus Gewohnheit zur Desktop-App greifen, bringt Sie die Web-Anmeldung ohne jede Einrichtung sofort ins Trading." },
    { type: "heading", text: "So beheben Sie es: Benutzername und Passwort in der Desktop-App verwenden" },
    { type: "paragraph", html: "Wenn Sie speziell die Desktop-App nutzen möchten, wegen ihrer abtrennbaren Fenster oder des Multi-Monitor-Layouts, müssen Sie den Google-Button überhaupt nicht verwenden. Tradovate akzeptiert in der Desktop-App eine direkte Anmeldung mit Benutzername und Passwort, und dieser Weg hat nichts mit Googles Regel zu eingebetteten Web-Ansichten zu tun." },
    {
      type: "steps",
      items: [
        { title: "Die Desktop-App bis zum Anmeldebildschirm öffnen", html: "Es ist nichts weiter vorzubereiten." },
        { title: "Tradovate-Benutzernamen und -Passwort eingeben", html: "Geben Sie statt eines Klicks auf Mit Google anmelden Ihre Zugangsdaten in die Felder ein." },
        { title: "Kontomodus wählen und anmelden", html: "Wählen Sie Simulation oder Live und melden Sie sich an." },
      ],
    },
    { type: "heading", text: "Was, wenn Sie sich mit Google registriert und nie ein Passwort festgelegt haben?" },
    { type: "paragraph", html: "Viele Trader haben ihr Tradovate-Konto erstellt, indem sie am ersten Tag auf den Google-Button geklickt haben, und nie ein separates Passwort festgelegt. Wenn das auf Sie zutrifft, wirkt der Weg über Benutzername und Passwort unmöglich, ist aber in zwei Minuten erledigt:" },
    {
      type: "list",
      items: [
        "Klicken Sie auf dem Anmeldebildschirm auf <strong class='text-white'>Passwort zurücksetzen</strong> (oder den entsprechenden Link &ldquo;forgot password&rdquo;).",
        "Geben Sie den Benutzernamen oder die E-Mail-Adresse ein, die mit Ihrem Tradovate-Konto verknüpft ist, verwenden Sie dieselbe E-Mail-Adresse wie bei Ihrem Google-Konto, da diese hinterlegt ist.",
        "Öffnen Sie die von Tradovate gesendete Reset-E-Mail und folgen Sie dem Link, um ein Passwort festzulegen.",
        "Kehren Sie zur Desktop-App zurück und melden Sie sich mit Ihrem Benutzernamen und dem neuen Passwort an. Sie verfügen nun über eine Anmeldung, die überhaupt nicht vom Google-Button abhängt.",
      ],
    },
    { type: "quote", html: "Wenn Sie sich über eine Prop-Firm mit Tradovate verbinden, nutzt Ihre Anmeldung den Google-Button möglicherweise von vornherein gar nicht. Viele Firmen stellen Ihnen einen eigenen Tradovate-Benutzernamen und ein Passwort zur Verfügung, sobald Sie eine Evaluierung bestehen oder kaufen. Falls das bei Ihnen der Fall ist, verwenden Sie diese Zugangsdaten direkt und überspringen Sie den Google-Ablauf komplett." },
    { type: "heading", text: "Fehlerbehebungstabelle" },
    {
      type: "table",
      headers: ["Was Sie sehen", "Was es bedeutet", "Lösung"],
      rows: [
        ["Google-Fehler in der Desktop-App (&ldquo;browser or app may not be secure&rdquo; / disallowed_useragent)", "Google führt die Anmeldung nicht im eingebetteten Anmeldefenster der App aus", "Auf der Web-Plattform in einem echten Browser anmelden oder auf dem Desktop Benutzername und Passwort verwenden"],
        ["Google-Anmeldung funktioniert in Chrome, aber nicht in der App", "Ein vollwertiger Browser wird vertraut; die eingebettete Web-Ansicht der App nicht", "Den Web Trader verwenden oder die Desktop-App auf Benutzername/Passwort umstellen"],
        ["Neuinstallation der App hat nicht geholfen", "Die Blockade ist eine Google-Richtlinie, keine fehlerhafte Installation", "Nicht mehr neu installieren; einen der beiden oben genannten Anmeldewege nutzen"],
        ["Sie haben nur je den Google-Button genutzt und kein Passwort", "Für das Konto sind noch keine direkten Zugangsdaten festgelegt", "Passwort zurücksetzen mit Ihrer Konto-E-Mail nutzen, ein Passwort festlegen und sich dann direkt anmelden"],
        ["Anmeldung in der App hat vor Monaten funktioniert, jetzt nicht mehr", "Google hat die Durchsetzung für eingebettete Web-Ansichten mit der Zeit verschärft", "Zur Web-Plattform oder zu Benutzername/Passwort wechseln; an Ihrem Konto hat sich nichts geändert"],
        ["Prop-Firm-Konto akzeptiert den Google-Button nicht", "Firmenkonten nutzen oft eigene Tradovate-Zugangsdaten", "Mit dem von Ihrer Firma vergebenen Benutzernamen und Passwort anmelden"],
      ],
    },
    { type: "heading", text: "So läuft Ihr automatisierter Handel weiter mit PickMyTrade" },
    { type: "paragraph", html: "Der wichtigere Punkt: Wenn Ihr Trading davon abhängt, dass Sie in der Desktop-App angemeldet sind, um Orders auszulösen, kann ein defekter Button auf einem Gerät Ihren gesamten Handelstag lahmlegen. Das ist eine fragile Art zu handeln. PickMyTrade verknüpft Ihr Tradovate-Konto einmalig und leitet Ihre TradingView-Alerts über eine eigene Verbindung dorthin, sodass Ihre Strategie weiter ausgeführt wird, egal welche App oder welcher Anmeldebildschirm auf Ihrem Laptop gerade Probleme macht." },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Einmal verknüpfen, hands-off handeln.</strong> Verbinden Sie Ihr Tradovate-Konto ein einziges Mal; es gibt kein Desktop-Anmeldefenster, das Sie vor jeder Sitzung im Auge behalten müssen.",
        "<strong class='text-white'>Orders laufen über eine eigene Verbindung.</strong> Ihre TradingView-Alerts werden direkt an Tradovate weitergeleitet, sodass ein hängender Google-Button in der Desktop-App nie eine Ausführung blockiert.",
        "<strong class='text-white'>Live- und Demo-fähig.</strong> Richten Sie Alerts genau auf das gewünschte Konto, egal ob Live-Konto oder simuliertes Konto.",
        "<strong class='text-white'>Multi-Konto-Synchronisierung.</strong> Spiegeln Sie denselben Alert über mehrere Tradovate-Konten von einer Stelle aus, ohne sich bei jedem einzeln anmelden zu müssen.",
      ],
    },
  ], es: [
    { type: "paragraph", html: "Usted hace clic en <strong class='text-white'>Iniciar sesión con Google</strong> en la aplicación de escritorio de Tradovate, selecciona su cuenta, y en lugar de sus gráficos aparece un error. A veces es un simple &ldquo;this browser or app may not be secure,&rdquo; a veces un código como <strong class='text-white'>disallowed_useragent</strong>, a veces solo una ventana de inicio de sesión que se cierra y lo devuelve al punto de partida. Lo frustrante es que esa misma cuenta de Google inicia sesión sin problemas en Chrome, e incluso funciona en el sitio web de Tradovate. Entonces, ¿qué está realmente fallando? Nada de su lado. Google se niega a ejecutar su flujo de inicio de sesión dentro de la ventana de inicio de sesión integrada de la aplicación, y una vez que lo sabe, la solución toma alrededor de un minuto. A continuación se explica por qué ocurre, cómo iniciar sesión ahora mismo desde la plataforma web o con su nombre de usuario y contraseña, y cómo asegurarse de que nunca detenga su trading automatizado." },
    {
      type: "checklist",
      heading: "Lista rápida para iniciar sesión ahora",
      items: [
        "<strong class='text-white'>Inicie sesión en la plataforma web.</strong> Abra el Tradovate Web Trader en Chrome, Edge o Safari y use ahí Iniciar sesión con Google. Se ejecuta en su navegador real, en el que Google confía, así que funciona.",
        "<strong class='text-white'>O use nombre de usuario y contraseña.</strong> En la aplicación de escritorio, ignore el botón de Google e inicie sesión con su nombre de usuario y contraseña de Tradovate. El inicio de sesión directo funciona en escritorio, web y móvil.",
        "<strong class='text-white'>¿No tiene contraseña configurada?</strong> Si solo ha usado el botón de Google, haga clic en Restablecer contraseña, ingrese el correo electrónico de su cuenta y establezca una contraseña para poder iniciar sesión directamente desde cualquier lugar.",
        "<strong class='text-white'>No reinstale por pánico.</strong> Reinstalar la aplicación de escritorio no soluciona el problema, porque el bloqueo es una política de Google, no una instalación dañada.",
        "<strong class='text-white'>Mantenga la automatización al margen de este botón.</strong> Si envía alertas de TradingView a Tradovate, sus órdenes no deberían depender en absoluto del inicio de sesión con Google de la aplicación de escritorio.",
      ],
    },
    { type: "heading", text: "Qué está pasando realmente cuando falla el inicio de sesión con Google en el escritorio" },
    { type: "paragraph", html: "Cuando hace clic en <strong class='text-white'>Iniciar sesión con Google</strong> en una aplicación de escritorio, la aplicación debe mostrarle de alguna manera la página de inicio de sesión de Google. La aplicación de escritorio de Tradovate lo hace abriendo una ventana de navegador <em>integrada</em>, una pequeña vista web incorporada en la aplicación en lugar de su Chrome, Edge o Safari habitual. Ahí es donde empieza el problema." },
    { type: "paragraph", html: "Google lleva años endureciendo sus reglas sobre dónde se permite ejecutar el inicio de sesión OAuth. Los componentes de navegador integrados permiten que la aplicación que los rodea potencialmente lea lo que usted escribe, inyecte scripts o capture cookies de sesión, por lo que Google decidió que no se puede confiar en ellos para iniciar sesión en cuentas. A lo largo de varias oleadas de aplicación de la norma, Google pasó a bloquear por completo los intentos de inicio de sesión provenientes de estas vistas web integradas. Si intenta iniciar sesión ahora desde una de ellas, Google devuelve un error en lugar de una solicitud de contraseña, formulado habitualmente como &ldquo;this browser or app may not be secure,&rdquo; o mostrado como el código de error <strong class='text-white'>disallowed_useragent</strong>. Si hace clic en el enlace Learn More de ese error, se explica que el navegador integrado detectado por Google no cumple sus requisitos para iniciar sesión." },
    { type: "paragraph", html: "Esa es toda la historia. La ventana de inicio de sesión de la aplicación de escritorio es una vista web integrada, Google no ejecuta su inicio de sesión dentro de vistas web integradas, así que el botón de Google en la aplicación choca con un muro. Su cuenta de Tradovate no se ve afectada, su contraseña de Google está bien, y su financiación y permisos no se ven afectados. La prueba es que la misma cuenta de Google inicia sesión sin contratiempos en el sitio web de Tradovate, porque un navegador real es exactamente el tipo de navegador completo y confiable en el que Google quiere que se ejecute el flujo." },
    { type: "paragraph", html: "Tampoco es una peculiaridad exclusiva de Windows o de Mac. La restricción de vista web integrada está del lado de Google y se aplica a los componentes de navegador integrados usados en ambos sistemas operativos, por lo que puede encontrar el mismo error en la aplicación de escritorio tanto en Windows como en macOS. La solución es idéntica en ambos casos." },
    { type: "heading", text: "Por qué empezó esto y por qué reinstalar no ayuda" },
    { type: "paragraph", html: "El primer instinto de muchos traders es desinstalar la aplicación, borrar todo y reinstalar, asumiendo que la descarga salió mal. Ahórrese el tiempo. Una instalación nueva le da la misma ventana de inicio de sesión integrada, que Google rechazará exactamente de la misma manera. Borrar cookies, cambiar de navegador predeterminado o actualizar la aplicación a la versión más reciente tampoco cambia el resultado, porque nada de eso toca la causa real: Google no autentica dentro de una vista web integrada, punto." },
    { type: "paragraph", html: "Esto también explica por qué puede parecer que se rompe &ldquo;de repente&rdquo; en una configuración que antes funcionaba. Google implementó el bloqueo de vistas web integradas por etapas, no de una sola vez. Un flujo de inicio de sesión de aplicación que pasó desapercibido en una fase anterior puede dejar de funcionar tras una ola de aplicación posterior, sin ningún cambio de su parte. Así que si el botón de Google funcionaba en la aplicación hace meses y dejó de hacerlo silenciosamente, usted no hizo nada mal, las reglas cambiaron." },
    { type: "heading", text: "Cómo solucionarlo: iniciar sesión desde la plataforma web" },
    { type: "paragraph", html: "La solución más limpia es iniciar sesión donde el flujo de Google funciona sin problemas: un navegador real." },
    {
      type: "steps",
      items: [
        { title: "Abrir un navegador normal", html: "Chrome, Edge, Safari o Firefox funcionan todos." },
        { title: "Ir a la página de inicio de sesión del Tradovate web trader", html: "Use la misma cuenta que usa en la aplicación de escritorio." },
        { title: "Hacer clic en Iniciar sesión con Google en la página web", html: "Como se trata de un navegador completo y no de una ventana integrada, Google le muestra el selector de cuenta y la solicitud de contraseña normales." },
        { title: "Elegir su cuenta de Google y aprobar si se solicita", html: "Ya está dentro. Los mismos gráficos, el mismo DOM, la misma cuenta." },
      ],
    },
    { type: "paragraph", html: "El web trader no es una versión reducida de la plataforma. Obtiene los gráficos completos, el ticket de órdenes, el SuperDOM, las estrategias ATM y las herramientas de cuenta, y muchos traders operan por completo en la plataforma web. Si solo recurre a la aplicación de escritorio por costumbre, el inicio de sesión web lo pone a operar de inmediato sin ninguna configuración." },
    { type: "heading", text: "Cómo solucionarlo: usar nombre de usuario y contraseña en la aplicación de escritorio" },
    { type: "paragraph", html: "Si quiere específicamente la aplicación de escritorio, por sus ventanas independientes o su diseño multipantalla, no tiene que usar el botón de Google en absoluto. Tradovate acepta un inicio de sesión directo con nombre de usuario y contraseña en la aplicación de escritorio, y ese camino no tiene nada que ver con la regla de vista web integrada de Google." },
    {
      type: "steps",
      items: [
        { title: "Abrir la aplicación de escritorio hasta la pantalla de inicio de sesión", html: "No hay nada más que preparar antes." },
        { title: "Escribir su nombre de usuario y contraseña de Tradovate", html: "En lugar de hacer clic en Iniciar sesión con Google, escriba sus credenciales en los campos." },
        { title: "Elegir el modo de cuenta e iniciar sesión", html: "Elija simulación o real, y luego inicie sesión." },
      ],
    },
    { type: "heading", text: "¿Qué pasa si se registró con Google y nunca creó una contraseña?" },
    { type: "paragraph", html: "Muchos traders crearon su cuenta de Tradovate haciendo clic en el botón de Google el primer día y nunca establecieron una contraseña aparte. Si es su caso, el camino de nombre de usuario y contraseña parece imposible, pero se soluciona en dos minutos:" },
    {
      type: "list",
      items: [
        "En la pantalla de inicio de sesión, haga clic en <strong class='text-white'>Restablecer contraseña</strong> (o el enlace equivalente &ldquo;forgot password&rdquo;).",
        "Ingrese el nombre de usuario o el correo electrónico vinculado a su cuenta de Tradovate, use el mismo correo que su cuenta de Google, ya que es el que está registrado.",
        "Abra el correo de restablecimiento que envía Tradovate y siga el enlace para establecer una contraseña.",
        "Vuelva a la aplicación de escritorio e inicie sesión con su nombre de usuario y la nueva contraseña. Ahora tiene un inicio de sesión que no depende en absoluto del botón de Google.",
      ],
    },
    { type: "quote", html: "Si se conecta a Tradovate a través de una prop firm, es posible que su inicio de sesión ni siquiera use el botón de Google. Muchas firmas le entregan un nombre de usuario y contraseña de Tradovate exclusivos cuando aprueba o compra una evaluación. Si es su caso, use esas credenciales directamente y omita por completo el flujo de Google." },
    { type: "heading", text: "Tabla de solución de problemas" },
    {
      type: "table",
      headers: ["Lo que ve", "Lo que significa", "Solución"],
      rows: [
        ["Error de Google en la aplicación de escritorio (&ldquo;browser or app may not be secure&rdquo; / disallowed_useragent)", "Google no ejecuta el inicio de sesión dentro de la ventana de inicio de sesión integrada de la aplicación", "Inicie sesión en la plataforma web con un navegador real, o use nombre de usuario y contraseña en el escritorio"],
        ["El inicio de sesión con Google funciona en Chrome pero no en la aplicación", "Se confía en un navegador completo; en la vista web integrada de la aplicación no", "Use el web trader, o cambie la aplicación de escritorio al inicio de sesión con usuario/contraseña"],
