---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "ten-minute-delayed-data-orange-symbols";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/debugging/${SLUG}`;

const META_TITLE = "Tradovate 10-Minute Delayed Data & Orange Symbols";
const META_DESCRIPTION =
  "Tradovate 10-minute delayed data? Orange symbols mean your feed isn't live. Subscribe to CME data, sign the agreement, then log out and back in.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Tradovate: 10 Minuten verzögerte Daten und orange Symbole", es: "Tradovate: datos retrasados 10 minutos y símbolos naranjas", fr: "Tradovate : données différées de 10 minutes et symboles orange", it: "Tradovate: dati ritardati di 10 minuti e simboli arancioni" },
  dek: { en: "If your Tradovate symbol names show up orange instead of white, the platform is telling you the feed is running on the free ten-minute delay, not live market data. Here's how to fix it in three moves.", de: "Wenn Ihre Tradovate-Symbolnamen orange statt weiß angezeigt werden, meldet die Plattform, dass der Feed mit der kostenlosen zehnminütigen Verzögerung läuft und nicht mit Live-Marktdaten. So beheben Sie das in drei Schritten.", es: "Si los nombres de sus símbolos de Tradovate aparecen en naranja en lugar de blanco, la plataforma le está indicando que el feed funciona con el retraso gratuito de diez minutos, no con datos de mercado en vivo. Así lo soluciona en tres pasos.", fr: "Si les noms de vos symboles Tradovate s'affichent en orange au lieu de blanc, la plateforme vous indique que le flux fonctionne avec le différé gratuit de dix minutes, et non avec des données de marché en direct. Voici comment y remédier en trois étapes.", it: "Se i nomi dei suoi simboli Tradovate appaiono arancioni invece che bianchi, la piattaforma le sta dicendo che il feed funziona con il ritardo gratuito di dieci minuti, non con dati di mercato in tempo reale. Ecco come risolvere in tre mosse." },
  readTime: { en: "7 min read", de: "7 Min. Lesezeit", es: "Lectura de 7 min", fr: "Lecture : 7 min", it: "Lettura di 7 min" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "When you're trading something fast like ES or NQ, a ten-minute-old quote is worse than no quote at all. It quietly puts you on the wrong side of every entry, stop, and target while the chart still looks alive. If your Tradovate symbol names show up <strong class='text-white'>orange</strong> instead of white, that's the platform telling you the feed is running on the free ten-minute delay, not live market data. Any username without a live data subscription gets quotes delayed by a full ten minutes, so the numbers you're reading are stale even though the chart keeps moving." },
    { type: "paragraph", html: "You might also see this described as &ldquo;delayed 10 minutes,&rdquo; a &ldquo;no live account&rdquo; warning on the subscription screen, or a prompt to sign a &ldquo;non-professional data agreement.&rdquo; The fix is almost always the same three moves: subscribe to live CME market data on a live, funded account, sign the required agreement, then log out and back in. Automating entries only makes sense once your data is confirmed live, a delayed feed can trigger bad fills and rejected orders, so let's get the orange gone first." },
    {
      type: "checklist",
      heading: "Quick Checklist for Delayed Data & Orange Symbols",
      items: [
        "<strong class='text-white'>Orange symbol name = delayed feed.</strong> White means live; orange means you're stuck on the ten-minute delay.",
        "<strong class='text-white'>On a personal Tradovate account:</strong> open Application Settings, add the live CME market-data subscription, and accept the terms.",
        "<strong class='text-white'>You need a live, funded account.</strong> A live market-data subscription requires one, or you buy CME data to keep trading the sim in real time.",
        "<strong class='text-white'>Sign the Non-Professional Data Agreement.</strong> Orange usually means this agreement is still unsigned.",
        "<strong class='text-white'>Log out and log back in.</strong> Live data only shows up on a fresh session; give activation 10–90 minutes.",
        "<strong class='text-white'>On a prop-firm or evaluation account:</strong> only your firm can enable data. Tradovate can't fix accounts it doesn't own.",
      ],
    },
    { type: "heading", text: "What Orange Symbols and “Delayed 10 Minutes” Mean" },
    { type: "paragraph", html: "Tradovate uses the color of the symbol name as a live-data status light. If your instruments appear orange, your data is delayed and not yet live. A white symbol name means live data is active. So the orange text isn't a theme or a cosmetic quirk, it's a warning that every price you see on that instrument is running on the free delayed feed." },
    { type: "paragraph", html: "The reason is simple. When a Tradovate username doesn't have a live data subscription, its data is delayed by ten minutes. Real-time CME Group data is a paid, agreement-gated exchange entitlement. Until you subscribe and sign the non-professional agreement, you get a ten-minute-delayed version of the same market, fine for looking at charts and practicing, but not something you should trade decisions off of." },
    { type: "paragraph", html: "Here's why that bites: the platform won't stop you from clicking Buy or Sell on a delayed symbol. You can fire an order against a price that's ten minutes old, catch an unexpected fill, or watch the order get rejected because there's no quote the engine trusts. Treat orange as a hard stop. Confirm the feed is live, white, before you place a single trade." },
    { type: "heading", text: "Top Causes of Tradovate Delayed Data" },
    { type: "heading", text: "1. No live market-data subscription on the account" },
    { type: "paragraph", html: "This is the default state. A brand-new or free-plan Tradovate username has no CME entitlement, so every instrument shows orange and every quote sits ten minutes behind. Nothing is broken here, you just haven't turned live data on yet." },
    { type: "heading", text: "2. The Non-Professional Data Agreement isn't signed" },
    { type: "paragraph", html: "Even after you request the subscription, the exchange makes you accept a data agreement (typically the Non-Professional agreement) plus the terms and conditions. Skip or dismiss that prompt and the entitlement never finalizes, so your symbols stay orange." },
    { type: "heading", text: "3. No live, funded account behind the subscription" },
    { type: "paragraph", html: "A live CME market-data subscription is tied to a live account. If all you've got is a simulation or paper username with no funded live account, the subscription screen tells you there's no live account. From there you either apply for one or buy CME data to keep trading the sim in real time." },
    { type: "heading", text: "4. You subscribed but never re-logged in" },
    { type: "paragraph", html: "Live data activates on a fresh session. If you signed everything but never logged out and back in, the running session is still on the delayed feed and the symbols stay orange until you reconnect." },
    { type: "heading", text: "5. It's a prop-firm or evaluation account" },
    { type: "paragraph", html: "On a funded-evaluation or prop account, you're not the account owner, so the market-data entitlement is controlled by the firm, not by you. Tradovate can't assist with market-data issues on prop-firm or evaluation accounts because it doesn't own them. Self-subscribing won't do anything; the firm has to enable it." },
    { type: "heading", text: "How to Fix Delayed Data & Orange Symbols: Step-by-Step" },
    { type: "heading", text: "Fixing a personal account (subscribe to live CME data)" },
    {
      type: "steps",
      items: [
        { title: "Log in to the web trader", html: "Log in to the Tradovate web trader at trader.tradovate.com on a desktop browser." },
        { title: "Open the Market Data section", html: "Open <strong class='text-white'>Application Settings</strong> (top-right of the screen) and go to the <strong class='text-white'>Market Data</strong> subscription section." },
        { title: "Select the live CME subscription", html: "Select the live CME Group Level I data subscription. On a live account plan this Level I CME data is included at no extra cost; on a simulation-only username you'll be prompted to apply for a live account or buy CME data. Plan inclusions and any data fees vary by account type and change over time, so check your current plan terms." },
        { title: "Submit the request", html: "Click <strong class='text-white'>Update Subscriptions</strong> (or the equivalent confirm button) to submit the request." },
      ],
    },
    { type: "heading", text: "Signing the data agreement" },
    {
      type: "steps",
      items: [
        { title: "Accept the terms and agreement", html: "When prompted, review and accept the <strong class='text-white'>Terms and Conditions</strong> and the <strong class='text-white'>Non-Professional Data Agreement</strong>. This step is mandatory, orange symbols usually mean this agreement is still unsigned." },
        { title: "Allow activation time", html: "Confirm the request goes through. Activation can take anywhere from <strong class='text-white'>10 to 90 minutes</strong> after signing, depending on exchange demand, so don't panic if the feed isn't instant." },
      ],
    },
    { type: "heading", text: "Log out, log back in, and confirm white" },
    {
      type: "steps",
      items: [
        { title: "Log out and back in everywhere", html: "Fully <strong class='text-white'>log out</strong> of Tradovate (and any linked platform such as TradingView or NinjaTrader), then <strong class='text-white'>log back in</strong>. Live data only appears on a fresh session." },
        { title: "Confirm the symbol turns white", html: "Check the symbol name color. It should now be <strong class='text-white'>white</strong>, confirming the live real-time feed. If it's still orange after 90 minutes, the subscription or agreement didn't finalize, go back into Application Settings and recheck." },
      ],
    },
    { type: "heading", text: "Fixing a prop-firm or evaluation account" },
    {
      type: "steps",
      items: [
        { title: "Don't self-subscribe", html: "Don't try to self-subscribe, the entitlement belongs to the firm." },
        { title: "Contact the firm's support", html: "Contact your prop firm's support (Apex, Topstep, and the like) and ask them to confirm or enable real-time market data on your evaluation or funded account." },
        { title: "Re-login once enabled", html: "Once the firm enables it, log out and back in to pick up the live feed. Provisioning windows and rules vary by firm and account size, so check your firm's current instructions." },
      ],
    },
    { type: "heading", text: "Troubleshooting Table" },
    {
      type: "table",
      headers: ["Symptom / message", "What it means", "Fix"],
      rows: [
        ["Orange symbol name", "Feed is delayed, not live", "Subscribe to live CME data, sign the agreement, re-login"],
        ["&ldquo;Delayed 10 minutes&rdquo; / stale quotes", "No live data subscription on the username", "Add the live market-data subscription in Application Settings"],
        ["&ldquo;No live account&rdquo; on subscription screen", "Subscription needs a live, funded account", "Apply for a live account, or buy CME data to trade the sim live"],
        ["Non-Professional agreement prompt", "Data agreement not yet accepted", "Review and accept the Terms and the Non-Professional agreement"],
        ["Still orange after subscribing", "Session never refreshed", "Log out of all platforms and log back in; allow 10–90 min"],
        ["Orange on a prop/eval account", "Only the firm can enable data", "Contact your prop firm; Tradovate can't fix firm-owned accounts"],
      ],
    },
    { type: "heading", text: "Prevent This with PickMyTrade" },
    { type: "paragraph", html: "PickMyTrade routes your TradingView alerts straight to Tradovate, and it's built so a bad or delayed feed doesn't turn into a bad fill:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Entitlement &amp; data-state awareness</strong>, designed to respect your account's data-agreement and entitlement state, so automation runs on live conditions rather than a stale delayed feed.",
        "<strong class='text-white'>Qty / symbol validation</strong>, checks the symbol and quantity before an order goes out, so a mistyped or non-tradable contract doesn't slip through.",
        "<strong class='text-white'>Rate-limit-safe routing</strong>, spaces out order flow so re-logins and reconnects don't trip &ldquo;too many requests&rdquo; lockouts.",
        "<strong class='text-white'>Multi-account sync</strong>, mirrors the same corrected order across your accounts once your data is confirmed live.",
      ],
    },
  ], de: [
    { type: "paragraph",html: "Wenn Sie etwas Schnelles wie ES oder NQ handeln, ist ein zehn Minuten alter Kurs schlimmer als gar kein Kurs. Er bringt Sie unbemerkt bei jedem Einstieg, Stop und Ziel auf die falsche Seite, während der Chart weiter lebendig aussieht. Wenn Ihre Tradovate-Symbolnamen <strong class='text-white'>orange</strong> statt weiß angezeigt werden, meldet Ihnen die Plattform, dass der Feed mit der kostenlosen zehnminütigen Verzögerung läuft und nicht mit Live-Marktdaten. Jeder Benutzername ohne Live-Daten-Abonnement erhält um volle zehn Minuten verzögerte Kurse, sodass die Zahlen, die Sie lesen, veraltet sind, obwohl der Chart sich weiterbewegt." },
    { type: "paragraph",html: "Sie finden das vielleicht auch als &ldquo;delayed 10 minutes&rdquo; beschrieben, als Warnung &ldquo;no live account&rdquo; auf dem Abonnement-Bildschirm oder als Aufforderung, ein &ldquo;non-professional data agreement&rdquo; zu unterzeichnen. Die Lösung besteht fast immer aus denselben drei Schritten: Live-CME-Marktdaten auf einem finanzierten Live-Konto abonnieren, die erforderliche Vereinbarung unterzeichnen und sich dann ab- und wieder anmelden. Automatisierte Einstiege ergeben erst Sinn, wenn Ihre Daten als live bestätigt sind; ein verzögerter Feed kann schlechte Ausführungen und abgelehnte Orders verursachen. Lassen Sie uns also zuerst das Orange loswerden." },
    {
      type: "checklist",
      heading: "Kurz-Checkliste bei verzögerten Daten und orangen Symbolen",
      items: [
        "<strong class='text-white'>Oranger Symbolname = verzögerter Feed.</strong> Weiß bedeutet live; orange bedeutet, dass Sie in der zehnminütigen Verzögerung festhängen.",
        "<strong class='text-white'>Bei einem privaten Tradovate-Konto:</strong> Application Settings öffnen, das Live-CME-Marktdaten-Abonnement hinzufügen und die Bedingungen akzeptieren.",
        "<strong class='text-white'>Sie brauchen ein finanziertes Live-Konto.</strong> Ein Live-Marktdaten-Abonnement setzt eines voraus, oder Sie kaufen CME-Daten, um die Simulation in Echtzeit weiter zu handeln.",
        "<strong class='text-white'>Unterzeichnen Sie das Non-Professional Data Agreement.</strong> Orange bedeutet meist, dass diese Vereinbarung noch nicht unterzeichnet ist.",
        "<strong class='text-white'>Melden Sie sich ab und wieder an.</strong> Live-Daten erscheinen nur in einer neuen Sitzung; planen Sie 10 bis 90 Minuten für die Aktivierung ein.",
        "<strong class='text-white'>Bei einem Prop-Firma- oder Evaluierungskonto:</strong> Nur Ihre Firma kann Daten freischalten. Tradovate kann Konten, die ihm nicht gehören, nicht reparieren.",
      ],
    },
    { type: "heading",text: "Was orange Symbole und „Delayed 10 Minutes“ bedeuten" },
    { type: "paragraph",html: "Tradovate nutzt die Farbe des Symbolnamens als Statusleuchte für Live-Daten. Erscheinen Ihre Instrumente orange, sind Ihre Daten verzögert und noch nicht live. Ein weißer Symbolname bedeutet, dass Live-Daten aktiv sind. Der orange Text ist also weder ein Design noch eine optische Eigenheit, sondern eine Warnung, dass jeder Kurs, den Sie bei diesem Instrument sehen, über den kostenlosen verzögerten Feed läuft." },
    { type: "paragraph",html: "Der Grund ist einfach. Hat ein Tradovate-Benutzername kein Live-Daten-Abonnement, werden seine Daten um zehn Minuten verzögert. Echtzeitdaten der CME Group sind eine kostenpflichtige, an Vereinbarungen gebundene Börsenberechtigung. Bis Sie abonnieren und die Non-Professional-Vereinbarung unterzeichnen, erhalten Sie eine um zehn Minuten verzögerte Version desselben Marktes, in Ordnung, um Charts anzusehen und zu üben, aber keine Grundlage für Handelsentscheidungen." },
    { type: "paragraph",html: "Hier liegt die Gefahr: Die Plattform hindert Sie nicht daran, bei einem verzögerten Symbol auf Buy oder Sell zu klicken. Sie können eine Order gegen einen zehn Minuten alten Kurs absetzen, eine unerwartete Ausführung erhalten oder zusehen, wie die Order abgelehnt wird, weil es keinen Kurs gibt, dem die Engine vertraut. Behandeln Sie Orange als harten Stopp. Bestätigen Sie, dass der Feed live, also weiß, ist, bevor Sie einen einzigen Trade platzieren." },
    { type: "heading",text: "Die häufigsten Ursachen für verzögerte Tradovate-Daten" },
    { type: "heading",text: "1. Kein Live-Marktdaten-Abonnement auf dem Konto" },
    { type: "paragraph",html: "Das ist der Standardzustand. Ein brandneuer oder kostenloser Tradovate-Benutzername hat keine CME-Berechtigung, daher erscheint jedes Instrument orange und jeder Kurs hinkt zehn Minuten hinterher. Hier ist nichts kaputt, Sie haben Live-Daten nur noch nicht eingeschaltet." },
    { type: "heading",text: "2. Das Non-Professional Data Agreement ist nicht unterzeichnet" },
    { type: "paragraph",html: "Auch nachdem Sie das Abonnement angefordert haben, verlangt die Börse, dass Sie eine Datenvereinbarung (in der Regel die Non-Professional-Vereinbarung) sowie die Allgemeinen Geschäftsbedingungen akzeptieren. Überspringen oder schließen Sie diese Aufforderung, wird die Berechtigung nie abgeschlossen, und Ihre Symbole bleiben orange." },
    { type: "heading",text: "3. Kein finanziertes Live-Konto hinter dem Abonnement" },
    { type: "paragraph",html: "Ein Live-CME-Marktdaten-Abonnement ist an ein Live-Konto gebunden. Haben Sie nur einen Simulations- oder Paper-Benutzernamen ohne finanziertes Live-Konto, meldet der Abonnement-Bildschirm, dass es kein Live-Konto gibt. Dann beantragen Sie entweder eines oder kaufen CME-Daten, um die Simulation weiter in Echtzeit zu handeln." },
    { type: "heading",text: "4. Sie haben abonniert, sich aber nie neu angemeldet" },
    { type: "paragraph",html: "Live-Daten werden in einer neuen Sitzung aktiviert. Haben Sie alles unterzeichnet, sich aber nie ab- und wieder angemeldet, läuft die aktuelle Sitzung weiterhin auf dem verzögerten Feed, und die Symbole bleiben orange, bis Sie sich neu verbinden." },
    { type: "heading",text: "5. Es ist ein Prop-Firma- oder Evaluierungskonto" },
    { type: "paragraph",html: "Bei einem finanzierten Evaluierungs- oder Prop-Konto sind Sie nicht der Kontoinhaber, daher wird die Marktdaten-Berechtigung von der Firma kontrolliert, nicht von Ihnen. Tradovate kann bei Marktdaten-Problemen auf Prop-Firma- oder Evaluierungskonten nicht helfen, weil sie ihm nicht gehören. Ein eigenes Abonnement bewirkt nichts; die Firma muss es freischalten." },
    { type: "heading",text: "So beheben Sie verzögerte Daten und orange Symbole: Schritt für Schritt" },
    { type: "heading",text: "Privates Konto beheben (Live-CME-Daten abonnieren)" },
    {
      type: "steps",
      items: [
        { title: "Beim Web Trader anmelden", html: "Melden Sie sich in einem Desktop-Browser beim Tradovate Web Trader unter trader.tradovate.com an." },
        { title: "Bereich Market Data öffnen", html: "Öffnen Sie <strong class='text-white'>Application Settings</strong> (oben rechts auf dem Bildschirm) und gehen Sie zum Abonnementbereich <strong class='text-white'>Market Data</strong>." },
        { title: "Das Live-CME-Abonnement auswählen", html: "Wählen Sie das Live-Datenabonnement CME Group Level I. Bei einem Live-Konto-Tarif ist dieses CME-Level-I-Datenpaket ohne Zusatzkosten enthalten; bei einem reinen Simulations-Benutzernamen werden Sie aufgefordert, ein Live-Konto zu beantragen oder CME-Daten zu kaufen. Enthaltene Leistungen und eventuelle Datengebühren hängen vom Kontotyp ab und ändern sich im Laufe der Zeit; prüfen Sie daher die aktuellen Bedingungen Ihres Tarifs." },
        { title: "Anfrage absenden", html: "Klicken Sie auf <strong class='text-white'>Update Subscriptions</strong> (oder die entsprechende Bestätigungsschaltfläche), um die Anfrage abzusenden." },
      ],
    },
    { type: "heading",text: "Die Datenvereinbarung unterzeichnen" },
    {
      type: "steps",
      items: [
        { title: "Bedingungen und Vereinbarung akzeptieren", html: "Prüfen und akzeptieren Sie auf Aufforderung die <strong class='text-white'>Terms and Conditions</strong> und das <strong class='text-white'>Non-Professional Data Agreement</strong>. Dieser Schritt ist zwingend; orange Symbole bedeuten meist, dass diese Vereinbarung noch nicht unterzeichnet ist." },
        { title: "Aktivierungszeit einplanen", html: "Bestätigen Sie, dass die Anfrage durchgeht. Die Aktivierung kann nach der Unterzeichnung je nach Börsenauslastung <strong class='text-white'>10 bis 90 Minuten</strong> dauern; geraten Sie also nicht in Panik, wenn der Feed nicht sofort da ist." },
      ],
    },
    { type: "heading",text: "Abmelden, wieder anmelden und Weiß bestätigen" },
    {
      type: "steps",
      items: [
        { title: "Überall abmelden und wieder anmelden", html: "Vollständig von Tradovate (und jeder verknüpften Plattform wie TradingView oder NinjaTrader) <strong class='text-white'>abmelden</strong> und dann wieder <strong class='text-white'>anmelden</strong>. Live-Daten erscheinen nur in einer neuen Sitzung." },
        { title: "Bestätigen, dass das Symbol weiß wird", html: "Prüfen Sie die Farbe des Symbolnamens. Sie sollte jetzt <strong class='text-white'>weiß</strong> sein und damit den Live-Echtzeit-Feed bestätigen. Ist sie nach 90 Minuten noch orange, wurde das Abonnement oder die Vereinbarung nicht abgeschlossen; gehen Sie zurück in die Application Settings und prüfen Sie erneut." },
      ],
    },
    { type: "heading",text: "Prop-Firma- oder Evaluierungskonto beheben" },
    {
      type: "steps",
      items: [
        { title: "Nicht selbst abonnieren", html: "Versuchen Sie nicht, selbst zu abonnieren, die Berechtigung gehört der Firma." },
        { title: "Den Support der Firma kontaktieren", html: "Wenden Sie sich an den Support Ihrer Prop-Firma (Apex, Topstep und ähnliche) und bitten Sie darum, Echtzeit-Marktdaten für Ihr Evaluierungs- oder finanziertes Konto zu bestätigen oder freizuschalten." },
        { title: "Nach der Freischaltung neu anmelden", html: "Sobald die Firma es freigeschaltet hat, melden Sie sich ab und wieder an, um den Live-Feed zu übernehmen. Bereitstellungsfenster und Regeln unterscheiden sich je nach Firma und Kontogröße; prüfen Sie daher die aktuellen Anweisungen Ihrer Firma." },
      ],
    },
    { type: "heading",text: "Tabelle zur Fehlerbehebung" },
    { type: "table", headers: ["Symptom / Meldung","Bedeutung","Lösung"], rows: [
      ["Oranger Symbolname","Feed ist verzögert, nicht live","Live-CME-Daten abonnieren, Vereinbarung unterzeichnen, neu anmelden"],
      ["&ldquo;Delayed 10 minutes&rdquo; / veraltete Kurse","Kein Live-Daten-Abonnement für den Benutzernamen","Das Live-Marktdaten-Abonnement in den Application Settings hinzufügen"],
      ["&ldquo;No live account&rdquo; auf dem Abonnement-Bildschirm","Das Abonnement braucht ein finanziertes Live-Konto","Live-Konto beantragen oder CME-Daten kaufen, um die Simulation live zu handeln"],
      ["Aufforderung zum Non-Professional-Agreement","Datenvereinbarung noch nicht akzeptiert","Terms und Non-Professional-Agreement prüfen und akzeptieren"],
      ["Nach dem Abonnieren weiterhin orange","Sitzung wurde nie aktualisiert","Auf allen Plattformen abmelden und wieder anmelden; 10 bis 90 Min. einplanen"],
      ["Orange bei einem Prop-/Evaluierungskonto","Nur die Firma kann Daten freischalten","Prop-Firma kontaktieren; Tradovate kann firmeneigene Konten nicht reparieren"],
    ] },
    { type: "heading",text: "Vorbeugen mit PickMyTrade" },
    { type: "paragraph",html: "PickMyTrade leitet Ihre TradingView-Alerts direkt an Tradovate weiter und ist so aufgebaut, dass ein fehlerhafter oder verzögerter Feed nicht zu einer schlechten Ausführung wird:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Berechtigungs- und Datenstatus-Bewusstsein</strong>, darauf ausgelegt, den Datenvereinbarungs- und Berechtigungsstatus Ihres Kontos zu berücksichtigen, damit die Automatisierung unter Live-Bedingungen läuft statt auf einem veralteten verzögerten Feed.",
        "<strong class='text-white'>Mengen-/Symbolvalidierung</strong>, prüft Symbol und Menge, bevor eine Order rausgeht, damit ein falsch getippter oder nicht handelbarer Kontrakt nicht durchrutscht.",
        "<strong class='text-white'>Ratenlimit-sicheres Routing</strong>, verteilt den Order-Fluss zeitlich, damit erneute Anmeldungen und Verbindungen keine Sperren wegen &ldquo;too many requests&rdquo; auslösen.",
        "<strong class='text-white'>Multi-Konto-Synchronisierung</strong>, spiegelt dieselbe korrigierte Order auf Ihre Konten, sobald Ihre Daten als live bestätigt sind.",
      ],
    },
  ], es: [
    { type: "paragraph",html: "Cuando opera algo rápido como ES o NQ, una cotización de hace diez minutos es peor que no tener ninguna. Le sitúa en silencio en el lado equivocado de cada entrada, stop y objetivo mientras el gráfico sigue pareciendo vivo. Si los nombres de sus símbolos de Tradovate aparecen en <strong class='text-white'>naranja</strong> en lugar de blanco, es la plataforma indicándole que el feed funciona con el retraso gratuito de diez minutos, no con datos de mercado en vivo. Cualquier usuario sin suscripción de datos en vivo recibe cotizaciones retrasadas diez minutos completos, así que las cifras que lee están obsoletas aunque el gráfico siga moviéndose." },
    { type: "paragraph",html: "También puede ver esto descrito como &ldquo;delayed 10 minutes&rdquo;, una advertencia &ldquo;no live account&rdquo; en la pantalla de suscripción o una petición de firmar un &ldquo;non-professional data agreement&rdquo;. La solución casi siempre son los mismos tres pasos: suscribirse a los datos de mercado de CME en vivo en una cuenta real con fondos, firmar el acuerdo requerido y luego cerrar sesión y volver a entrar. Automatizar las entradas solo tiene sentido cuando sus datos están confirmados en vivo; un feed retrasado puede provocar malas ejecuciones y órdenes rechazadas, así que quitemos primero el naranja." },
    {
      type: "checklist",
      heading: "Lista rápida para datos retrasados y símbolos naranjas",
      items: [
        "<strong class='text-white'>Nombre de símbolo naranja = feed retrasado.</strong> Blanco significa en vivo; naranja significa que está atascado en el retraso de diez minutos.",
        "<strong class='text-white'>En una cuenta personal de Tradovate:</strong> abra Application Settings, añada la suscripción de datos de mercado de CME en vivo y acepte los términos.",
        "<strong class='text-white'>Necesita una cuenta real con fondos.</strong> Una suscripción de datos de mercado en vivo la requiere, o bien compre datos de CME para seguir operando la simulación en tiempo real.",
        "<strong class='text-white'>Firme el Non-Professional Data Agreement.</strong> Naranja normalmente significa que este acuerdo sigue sin firmar.",
        "<strong class='text-white'>Cierre sesión y vuelva a entrar.</strong> Los datos en vivo solo aparecen en una sesión nueva; deje de 10 a 90 minutos para la activación.",
        "<strong class='text-white'>En una cuenta de prop firm o de evaluación:</strong> solo su firma puede activar los datos. Tradovate no puede arreglar cuentas que no le pertenecen.",
      ],
    },
    { type: "heading",text: "Qué significan los símbolos naranjas y “Delayed 10 Minutes”" },
    { type: "paragraph",html: "Tradovate usa el color del nombre del símbolo como luz de estado de los datos en vivo. Si sus instrumentos aparecen en naranja, sus datos están retrasados y todavía no son en vivo. Un nombre de símbolo en blanco significa que los datos en vivo están activos. Así que el texto naranja no es un tema ni una rareza estética: es una advertencia de que cada precio que ve en ese instrumento procede del feed gratuito retrasado." },
    { type: "paragraph",html: "La razón es sencilla. Cuando un usuario de Tradovate no tiene una suscripción de datos en vivo, sus datos se retrasan diez minutos. Los datos en tiempo real de CME Group son un permiso de bolsa de pago y condicionado a la firma de acuerdos. Hasta que se suscriba y firme el acuerdo non-professional, obtiene una versión del mismo mercado retrasada diez minutos, válida para ver gráficos y practicar, pero no algo sobre lo que deba basar decisiones de trading." },
    { type: "paragraph",html: "Y aquí está el problema: la plataforma no le impedirá hacer clic en Buy o Sell sobre un símbolo retrasado. Puede lanzar una orden contra un precio de hace diez minutos, recibir una ejecución inesperada o ver cómo la orden es rechazada porque no hay una cotización en la que el motor confíe. Trate el naranja como una parada obligatoria. Confirme que el feed es en vivo, blanco, antes de realizar una sola operación." },
    { type: "heading",text: "Principales causas de los datos retrasados en Tradovate" },
    { type: "heading",text: "1. No hay suscripción de datos de mercado en vivo en la cuenta" },
    { type: "paragraph",html: "Este es el estado por defecto. Un usuario de Tradovate recién creado o de plan gratuito no tiene permiso de CME, así que todos los instrumentos aparecen en naranja y cada cotización va diez minutos por detrás. Nada está roto aquí, simplemente aún no ha activado los datos en vivo." },
    { type: "heading",text: "2. El Non-Professional Data Agreement no está firmado" },
    { type: "paragraph",html: "Incluso después de solicitar la suscripción, la bolsa le obliga a aceptar un acuerdo de datos (normalmente el acuerdo Non-Professional) además de los términos y condiciones. Si omite o descarta esa solicitud, el permiso nunca se completa y sus símbolos siguen en naranja." },
    { type: "heading",text: "3. No hay una cuenta real con fondos detrás de la suscripción" },
    { type: "paragraph",html: "Una suscripción de datos de mercado de CME en vivo está vinculada a una cuenta real. Si solo tiene un usuario de simulación o paper sin cuenta real con fondos, la pantalla de suscripción le indica que no hay cuenta real. A partir de ahí, o solicita una o compra datos de CME para seguir operando la simulación en tiempo real." },
    { type: "heading",text: "4. Se suscribió pero nunca volvió a iniciar sesión" },
    { type: "paragraph",html: "Los datos en vivo se activan en una sesión nueva. Si firmó todo pero nunca cerró sesión y volvió a entrar, la sesión en curso sigue en el feed retrasado y los símbolos se mantienen en naranja hasta que se reconecte." },
    { type: "heading",text: "5. Es una cuenta de prop firm o de evaluación" },
    { type: "paragraph",html: "En una cuenta de evaluación financiada o de prop firm, usted no es el titular de la cuenta, por lo que el permiso de datos de mercado lo controla la firma, no usted. Tradovate no puede ayudar con problemas de datos de mercado en cuentas de prop firm o de evaluación porque no le pertenecen. Suscribirse por su cuenta no servirá de nada; la firma tiene que activarlo." },
    { type: "heading",text: "Cómo solucionar los datos retrasados y los símbolos naranjas: paso a paso" },
    { type: "heading",text: "Solucionar una cuenta personal (suscribirse a datos de CME en vivo)" },
    {
      type: "steps",
      items: [
        { title: "Inicie sesión en el web trader", html: "Inicie sesión en el web trader de Tradovate en trader.tradovate.com desde un navegador de escritorio." },
        { title: "Abra la sección Market Data", html: "Abra <strong class='text-white'>Application Settings</strong> (arriba a la derecha de la pantalla) y vaya a la sección de suscripción <strong class='text-white'>Market Data</strong>." },
        { title: "Seleccione la suscripción de CME en vivo", html: "Seleccione la suscripción de datos CME Group Level I en vivo. En un plan de cuenta real estos datos CME Level I están incluidos sin coste adicional; con un usuario solo de simulación se le pedirá que solicite una cuenta real o compre datos de CME. Lo que incluye cada plan y las posibles tarifas de datos varían según el tipo de cuenta y cambian con el tiempo, así que revise las condiciones vigentes de su plan." },
        { title: "Envíe la solicitud", html: "Haga clic en <strong class='text-white'>Update Subscriptions</strong> (o el botón de confirmación equivalente) para enviar la solicitud." },
      ],
    },
    { type: "heading",text: "Firmar el acuerdo de datos" },
    {
      type: "steps",
      items: [
        { title: "Acepte los términos y el acuerdo", html: "Cuando se le solicite, revise y acepte los <strong class='text-white'>Terms and Conditions</strong> y el <strong class='text-white'>Non-Professional Data Agreement</strong>. Este paso es obligatorio; los símbolos naranjas normalmente significan que este acuerdo sigue sin firmar." },
        { title: "Deje tiempo para la activación", html: "Confirme que la solicitud se tramita. La activación puede tardar entre <strong class='text-white'>10 y 90 minutos</strong> tras la firma, según la demanda de la bolsa, así que no se alarme si el feed no es inmediato." },
      ],
    },
    { type: "heading",text: "Cerrar sesión, volver a entrar y confirmar el blanco" },
    {
      type: "steps",
      items: [
        { title: "Cierre sesión y vuelva a entrar en todas partes", html: "<strong class='text-white'>Cierre sesión</strong> por completo en Tradovate (y en cualquier plataforma vinculada como TradingView o NinjaTrader) y luego <strong class='text-white'>vuelva a entrar</strong>. Los datos en vivo solo aparecen en una sesión nueva." },
        { title: "Confirme que el símbolo se pone en blanco", html: "Compruebe el color del nombre del símbolo. Ahora debería estar en <strong class='text-white'>blanco</strong>, lo que confirma el feed en tiempo real. Si sigue en naranja pasados 90 minutos, la suscripción o el acuerdo no se completó; vuelva a Application Settings y revise de nuevo." },
      ],
    },
    { type: "heading",text: "Solucionar una cuenta de prop firm o de evaluación" },
    {
      type: "steps",
      items: [
        { title: "No se suscriba por su cuenta", html: "No intente suscribirse por su cuenta, el permiso pertenece a la firma." },
        { title: "Contacte con el soporte de la firma", html: "Contacte con el soporte de su prop firm (Apex, Topstep y similares) y pídales que confirmen o activen los datos de mercado en tiempo real en su cuenta de evaluación o financiada." },
        { title: "Vuelva a iniciar sesión una vez activado", html: "Cuando la firma lo active, cierre sesión y vuelva a entrar para recibir el feed en vivo. Los plazos de aprovisionamiento y las reglas varían según la firma y el tamaño de la cuenta, así que consulte las instrucciones vigentes de su firma." },
      ],
    },
    { type: "heading",text: "Tabla de solución de problemas" },
    { type: "table", headers: ["Síntoma / mensaje","Qué significa","Solución"], rows: [
      ["Nombre de símbolo naranja","El feed está retrasado, no en vivo","Suscribirse a datos de CME en vivo, firmar el acuerdo, volver a iniciar sesión"],
      ["&ldquo;Delayed 10 minutes&rdquo; / cotizaciones obsoletas","No hay suscripción de datos en vivo para el usuario","Añadir la suscripción de datos de mercado en vivo en Application Settings"],
      ["&ldquo;No live account&rdquo; en la pantalla de suscripción","La suscripción necesita una cuenta real con fondos","Solicitar una cuenta real o comprar datos de CME para operar la simulación en vivo"],
      ["Solicitud del acuerdo Non-Professional","El acuerdo de datos aún no se ha aceptado","Revisar y aceptar los Terms y el acuerdo Non-Professional"],
      ["Sigue en naranja tras suscribirse","La sesión nunca se actualizó","Cerrar sesión en todas las plataformas y volver a entrar; esperar de 10 a 90 min"],
      ["Naranja en una cuenta de prop firm/evaluación","Solo la firma puede activar los datos","Contactar con su prop firm; Tradovate no puede arreglar cuentas de la firma"],
    ] },
    { type: "heading",text: "Prevéngalo con PickMyTrade" },
    { type: "paragraph",html: "PickMyTrade enruta sus alertas de TradingView directamente a Tradovate y está diseñado para que un feed defectuoso o retrasado no se convierta en una mala ejecución:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Conciencia de permisos y estado de los datos</strong>, diseñada para respetar el acuerdo de datos y el estado de permisos de su cuenta, de modo que la automatización funcione con condiciones en vivo y no con un feed retrasado y obsoleto.",
        "<strong class='text-white'>Validación de cantidad y símbolo</strong>, comprueba el símbolo y la cantidad antes de enviar una orden, para que un contrato mal escrito o no negociable no se cuele.",
        "<strong class='text-white'>Enrutamiento seguro frente a límites de frecuencia</strong>, espacia el flujo de órdenes para que los reinicios de sesión y las reconexiones no provoquen bloqueos por &ldquo;too many requests&rdquo;.",
        "<strong class='text-white'>Sincronización multicuenta</strong>, replica la misma orden corregida en sus cuentas una vez que sus datos estén confirmados en vivo.",
      ],
    },
  ], fr: [
    { type: "paragraph",html: "Quand vous tradez une valeur rapide comme ES ou NQ, une cotation vieille de dix minutes est pire que pas de cotation du tout. Elle vous place discrètement du mauvais côté de chaque entrée, stop et objectif, alors que le graphique a toujours l'air vivant. Si les noms de vos symboles Tradovate s'affichent en <strong class='text-white'>orange</strong> au lieu de blanc, c'est la plateforme qui vous indique que le flux fonctionne avec le différé gratuit de dix minutes, et non avec des données de marché en direct. Tout identifiant sans abonnement aux données en direct reçoit des cotations différées de dix minutes pleines ; les chiffres que vous lisez sont donc périmés alors même que le graphique continue de bouger." },
    { type: "paragraph",html: "Vous pouvez aussi voir cela décrit comme &ldquo;delayed 10 minutes&rdquo;, un avertissement &ldquo;no live account&rdquo; sur l'écran d'abonnement ou une invite à signer un &ldquo;non-professional data agreement&rdquo;. La solution tient presque toujours en trois étapes : vous abonner aux données de marché CME en direct sur un compte réel financé, signer l'accord requis, puis vous déconnecter et vous reconnecter. Automatiser les entrées n'a de sens qu'une fois vos données confirmées en direct ; un flux différé peut provoquer de mauvaises exécutions et des ordres rejetés. Commençons donc par faire disparaître l'orange." },
    {
      type: "checklist",
      heading: "Liste de contrôle rapide pour données différées et symboles orange",
      items: [
        "<strong class='text-white'>Nom de symbole orange = flux différé.</strong> Le blanc signifie direct ; l'orange signifie que vous êtes bloqué sur le différé de dix minutes.",
        "<strong class='text-white'>Sur un compte Tradovate personnel :</strong> ouvrez Application Settings, ajoutez l'abonnement aux données de marché CME en direct et acceptez les conditions.",
        "<strong class='text-white'>Il vous faut un compte réel financé.</strong> Un abonnement aux données de marché en direct l'exige, ou bien vous achetez des données CME pour continuer à trader la simulation en temps réel.",
        "<strong class='text-white'>Signez le Non-Professional Data Agreement.</strong> L'orange signifie généralement que cet accord n'est toujours pas signé.",
        "<strong class='text-white'>Déconnectez-vous puis reconnectez-vous.</strong> Les données en direct n'apparaissent que sur une nouvelle session ; prévoyez de 10 à 90 minutes d'activation.",
        "<strong class='text-white'>Sur un compte de prop firm ou d'évaluation :</strong> seule votre société peut activer les données. Tradovate ne peut pas réparer des comptes qui ne lui appartiennent pas.",
      ],
    },
    { type: "heading",text: "Ce que signifient les symboles orange et « Delayed 10 Minutes »" },
    { type: "paragraph",html: "Tradovate utilise la couleur du nom du symbole comme voyant d'état des données en direct. Si vos instruments apparaissent en orange, vos données sont différées et pas encore en direct. Un nom de symbole en blanc signifie que les données en direct sont actives. Le texte orange n'est donc ni un thème ni une particularité esthétique : c'est un avertissement que chaque prix affiché sur cet instrument provient du flux différé gratuit." },
    { type: "paragraph",html: "La raison est simple. Lorsqu'un identifiant Tradovate n'a pas d'abonnement aux données en direct, ses données sont différées de dix minutes. Les données CME Group en temps réel constituent un droit d'accès boursier payant et soumis à des accords. Tant que vous ne vous abonnez pas et ne signez pas l'accord non-professional, vous obtenez une version du même marché différée de dix minutes, acceptable pour regarder des graphiques et s'entraîner, mais pas pour fonder des décisions de trading." },
    { type: "paragraph",html: "Voici ce qui pose problème : la plateforme ne vous empêchera pas de cliquer sur Buy ou Sell sur un symbole différé. Vous pouvez envoyer un ordre sur un prix vieux de dix minutes, obtenir une exécution inattendue ou voir l'ordre rejeté faute de cotation à laquelle le moteur fasse confiance. Considérez l'orange comme un arrêt absolu. Confirmez que le flux est en direct, en blanc, avant de passer le moindre trade." },
    { type: "heading",text: "Principales causes des données différées sur Tradovate" },
    { type: "heading",text: "1. Aucun abonnement aux données de marché en direct sur le compte" },
    { type: "paragraph",html: "C'est l'état par défaut. Un identifiant Tradovate tout neuf ou de formule gratuite n'a aucun droit d'accès CME ; chaque instrument apparaît donc en orange et chaque cotation accuse dix minutes de retard. Rien n'est cassé ici, vous n'avez simplement pas encore activé les données en direct." },
    { type: "heading",text: "2. Le Non-Professional Data Agreement n'est pas signé" },
    { type: "paragraph",html: "Même après avoir demandé l'abonnement, la bourse vous oblige à accepter un accord de données (généralement l'accord Non-Professional) ainsi que les conditions générales. Si vous ignorez ou fermez cette invite, le droit d'accès n'est jamais finalisé et vos symboles restent orange." },
    { type: "heading",text: "3. Aucun compte réel financé derrière l'abonnement" },
    { type: "paragraph",html: "Un abonnement aux données de marché CME en direct est lié à un compte réel. Si vous n'avez qu'un identifiant de simulation ou de paper trading sans compte réel financé, l'écran d'abonnement vous indique qu'il n'y a pas de compte réel. Vous devez alors en demander un ou acheter des données CME pour continuer à trader la simulation en temps réel." },
    { type: "heading",text: "4. Vous vous êtes abonné mais ne vous êtes jamais reconnecté" },
    { type: "paragraph",html: "Les données en direct s'activent sur une nouvelle session. Si vous avez tout signé sans jamais vous déconnecter puis reconnecter, la session en cours reste sur le flux différé et les symboles restent orange jusqu'à ce que vous vous reconnectiez." },
    { type: "heading",text: "5. C'est un compte de prop firm ou d'évaluation" },
    { type: "paragraph",html: "Sur un compte d'évaluation financé ou de prop firm, vous n'êtes pas le titulaire du compte ; le droit d'accès aux données de marché est donc contrôlé par la société, et non par vous. Tradovate ne peut pas aider sur les problèmes de données de marché des comptes de prop firm ou d'évaluation, car il ne les possède pas. S'abonner soi-même ne servira à rien ; la société doit l'activer." },
    { type: "heading",text: "Comment corriger les données différées et les symboles orange : pas à pas" },
    { type: "heading",text: "Corriger un compte personnel (s'abonner aux données CME en direct)" },
    {
      type: "steps",
      items: [
        { title: "Connectez-vous au web trader", html: "Connectez-vous au web trader Tradovate sur trader.tradovate.com depuis un navigateur de bureau." },
        { title: "Ouvrez la section Market Data", html: "Ouvrez <strong class='text-white'>Application Settings</strong> (en haut à droite de l'écran) et accédez à la section d'abonnement <strong class='text-white'>Market Data</strong>." },
        { title: "Sélectionnez l'abonnement CME en direct", html: "Sélectionnez l'abonnement aux données CME Group Level I en direct. Sur une formule de compte réel, ces données CME Level I sont incluses sans frais supplémentaires ; avec un identifiant de simulation uniquement, il vous sera proposé de demander un compte réel ou d'acheter des données CME. Les inclusions des formules et les éventuels frais de données varient selon le type de compte et évoluent avec le temps ; consultez donc les conditions actuelles de votre formule." },
        { title: "Envoyez la demande", html: "Cliquez sur <strong class='text-white'>Update Subscriptions</strong> (ou le bouton de confirmation équivalent) pour envoyer la demande." },
      ],
    },
    { type: "heading",text: "Signer l'accord de données" },
    {
      type: "steps",
      items: [
        { title: "Acceptez les conditions et l'accord", html: "À l'invite, lisez et acceptez les <strong class='text-white'>Terms and Conditions</strong> et le <strong class='text-white'>Non-Professional Data Agreement</strong>. Cette étape est obligatoire ; des symboles orange signifient généralement que cet accord n'est toujours pas signé." },
        { title: "Prévoyez le délai d'activation", html: "Confirmez que la demande aboutit. L'activation peut prendre de <strong class='text-white'>10 à 90 minutes</strong> après la signature, selon la demande de la bourse ; ne paniquez donc pas si le flux n'est pas instantané." },
      ],
    },
    { type: "heading",text: "Se déconnecter, se reconnecter et confirmer le blanc" },
    {
      type: "steps",
      items: [
        { title: "Déconnectez-vous puis reconnectez-vous partout", html: "<strong class='text-white'>Déconnectez-vous</strong> complètement de Tradovate (et de toute plateforme liée comme TradingView ou NinjaTrader), puis <strong class='text-white'>reconnectez-vous</strong>. Les données en direct n'apparaissent que sur une nouvelle session." },
        { title: "Confirmez que le symbole devient blanc", html: "Vérifiez la couleur du nom du symbole. Elle doit maintenant être <strong class='text-white'>blanche</strong>, ce qui confirme le flux en temps réel. S'il est toujours orange après 90 minutes, l'abonnement ou l'accord n'a pas été finalisé ; retournez dans Application Settings et vérifiez à nouveau." },
      ],
    },
    { type: "heading",text: "Corriger un compte de prop firm ou d'évaluation" },
    {
      type: "steps",
      items: [
        { title: "Ne vous abonnez pas vous-même", html: "N'essayez pas de vous abonner vous-même, le droit d'accès appartient à la société." },
        { title: "Contactez le support de la société", html: "Contactez le support de votre prop firm (Apex, Topstep et autres) et demandez-lui de confirmer ou d'activer les données de marché en temps réel sur votre compte d'évaluation ou financé." },
        { title: "Reconnectez-vous une fois activé", html: "Une fois que la société l'a activé, déconnectez-vous puis reconnectez-vous pour récupérer le flux en direct. Les délais de mise en service et les règles varient selon la société et la taille du compte ; consultez donc les instructions actuelles de votre société." },
      ],
    },
    { type: "heading",text: "Tableau de dépannage" },
    { type: "table", headers: ["Symptôme / message","Signification","Solution"], rows: [
      ["Nom de symbole orange","Le flux est différé, pas en direct","S'abonner aux données CME en direct, signer l'accord, se reconnecter"],
      ["&ldquo;Delayed 10 minutes&rdquo; / cotations périmées","Aucun abonnement aux données en direct sur l'identifiant","Ajouter l'abonnement aux données de marché en direct dans Application Settings"],
      ["&ldquo;No live account&rdquo; sur l'écran d'abonnement","L'abonnement nécessite un compte réel financé","Demander un compte réel ou acheter des données CME pour trader la simulation en direct"],
      ["Invite de l'accord Non-Professional","Accord de données pas encore accepté","Lire et accepter les Terms et l'accord Non-Professional"],
      ["Toujours orange après abonnement","La session ne s'est jamais rafraîchie","Se déconnecter de toutes les plateformes et se reconnecter ; prévoir 10 à 90 min"],
      ["Orange sur un compte de prop firm/évaluation","Seule la société peut activer les données","Contacter votre prop firm ; Tradovate ne peut pas réparer les comptes appartenant à la société"],
    ] },
    { type: "heading",text: "Prévenez cela avec PickMyTrade" },
    { type: "paragraph",html: "PickMyTrade achemine vos alertes TradingView directement vers Tradovate et est conçu pour qu'un flux défectueux ou différé ne se transforme pas en mauvaise exécution :" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Prise en compte des droits d'accès et de l'état des données</strong>, conçue pour respecter l'accord de données et l'état des droits d'accès de votre compte, afin que l'automatisation fonctionne en conditions réelles plutôt que sur un flux différé périmé.",
        "<strong class='text-white'>Validation de la quantité et du symbole</strong>, vérifie le symbole et la quantité avant l'envoi d'un ordre, pour qu'un contrat mal saisi ou non négociable ne passe pas au travers.",
        "<strong class='text-white'>Routage respectueux des limites de débit</strong>, espace le flux d'ordres afin que les reconnexions ne déclenchent pas de blocages &ldquo;too many requests&rdquo;.",
        "<strong class='text-white'>Synchronisation multi-comptes</strong>, reproduit le même ordre corrigé sur vos comptes une fois vos données confirmées en direct.",
      ],
    },
  ], it: [
    { type: "paragraph",html: "Quando opera su qualcosa di veloce come ES o NQ, una quotazione vecchia di dieci minuti è peggio di nessuna quotazione. La mette silenziosamente dalla parte sbagliata di ogni ingresso, stop e target mentre il grafico sembra ancora vivo. Se i nomi dei suoi simboli Tradovate appaiono <strong class='text-white'>arancioni</strong> invece che bianchi, è la piattaforma che le dice che il feed funziona con il ritardo gratuito di dieci minuti, non con dati di mercato in tempo reale. Qualsiasi nome utente senza abbonamento ai dati in tempo reale riceve quotazioni ritardate di dieci minuti pieni, quindi i numeri che legge sono obsoleti anche se il grafico continua a muoversi." },
    { type: "paragraph",html: "Potrebbe vedere questo problema descritto anche come &ldquo;delayed 10 minutes&rdquo;, un avviso &ldquo;no live account&rdquo; nella schermata di abbonamento o un invito a firmare un &ldquo;non-professional data agreement&rdquo;. La soluzione è quasi sempre la stessa in tre mosse: abbonarsi ai dati di mercato CME in tempo reale su un conto reale finanziato, firmare l'accordo richiesto, poi uscire e rientrare. Automatizzare gli ingressi ha senso solo dopo aver confermato che i dati sono in tempo reale; un feed ritardato può causare esecuzioni errate e ordini respinti, quindi eliminiamo prima l'arancione." },
    {
      type: "checklist",
      heading: "Checklist rapida per dati ritardati e simboli arancioni",
      items: [
        "<strong class='text-white'>Nome del simbolo arancione = feed ritardato.</strong> Il bianco significa tempo reale; l'arancione significa che è bloccato sul ritardo di dieci minuti.",
        "<strong class='text-white'>Su un conto Tradovate personale:</strong> apra Application Settings, aggiunga l'abbonamento ai dati di mercato CME in tempo reale e accetti i termini.",
        "<strong class='text-white'>Le serve un conto reale finanziato.</strong> Un abbonamento ai dati di mercato in tempo reale lo richiede, oppure acquisti dati CME per continuare a operare in simulazione in tempo reale.",
        "<strong class='text-white'>Firmi il Non-Professional Data Agreement.</strong> L'arancione di solito significa che questo accordo non è ancora firmato.",
        "<strong class='text-white'>Esca e rientri.</strong> I dati in tempo reale compaiono solo su una sessione nuova; preveda da 10 a 90 minuti per l'attivazione.",
        "<strong class='text-white'>Su un conto di prop firm o di valutazione:</strong> solo la sua società può abilitare i dati. Tradovate non può sistemare conti che non possiede.",
      ],
    },
    { type: "heading",text: "Cosa significano i simboli arancioni e “Delayed 10 Minutes”" },
    { type: "paragraph",html: "Tradovate usa il colore del nome del simbolo come spia di stato dei dati in tempo reale. Se i suoi strumenti appaiono arancioni, i suoi dati sono ritardati e non ancora in tempo reale. Un nome di simbolo bianco significa che i dati in tempo reale sono attivi. Quindi il testo arancione non è un tema né una stranezza estetica: è un avviso che ogni prezzo che vede su quello strumento proviene dal feed gratuito ritardato." },
    { type: "paragraph",html: "Il motivo è semplice. Quando un nome utente Tradovate non ha un abbonamento ai dati in tempo reale, i suoi dati sono ritardati di dieci minuti. I dati in tempo reale di CME Group sono un'abilitazione di borsa a pagamento e subordinata alla firma di accordi. Finché non si abbona e non firma l'accordo non-professional, ottiene una versione dello stesso mercato ritardata di dieci minuti, adatta per guardare i grafici e fare pratica, ma non per prendere decisioni di trading." },
    { type: "paragraph",html: "Ecco perché è pericoloso: la piattaforma non le impedirà di fare clic su Buy o Sell su un simbolo ritardato. Può inviare un ordine contro un prezzo vecchio di dieci minuti, ottenere un'esecuzione inattesa o vedere l'ordine respinto perché non c'è una quotazione di cui il motore si fidi. Consideri l'arancione un arresto obbligatorio. Confermi che il feed sia in tempo reale, bianco, prima di inserire un solo trade." },
    { type: "heading",text: "Principali cause dei dati ritardati di Tradovate" },
    { type: "heading",text: "1. Nessun abbonamento ai dati di mercato in tempo reale sul conto" },
    { type: "paragraph",html: "È lo stato predefinito. Un nome utente Tradovate nuovo di zecca o con piano gratuito non ha abilitazione CME, quindi ogni strumento appare arancione e ogni quotazione è in ritardo di dieci minuti. Qui nulla è rotto, semplicemente non ha ancora attivato i dati in tempo reale." },
    { type: "heading",text: "2. Il Non-Professional Data Agreement non è firmato" },
    { type: "paragraph",html: "Anche dopo aver richiesto l'abbonamento, la borsa le fa accettare un accordo sui dati (di solito l'accordo Non-Professional) oltre ai termini e alle condizioni. Se salta o chiude quella richiesta, l'abilitazione non viene mai finalizzata e i suoi simboli restano arancioni." },
    { type: "heading",text: "3. Nessun conto reale finanziato dietro l'abbonamento" },
    { type: "paragraph",html: "Un abbonamento ai dati di mercato CME in tempo reale è legato a un conto reale. Se ha solo un nome utente di simulazione o paper senza un conto reale finanziato, la schermata di abbonamento le segnala che non c'è un conto reale. Da lì può richiederne uno oppure acquistare dati CME per continuare a operare in simulazione in tempo reale." },
    { type: "heading",text: "4. Si è abbonato ma non ha mai rifatto il login" },
    { type: "paragraph",html: "I dati in tempo reale si attivano su una sessione nuova. Se ha firmato tutto ma non è mai uscito e rientrato, la sessione in corso è ancora sul feed ritardato e i simboli restano arancioni finché non si riconnette." },
    { type: "heading",text: "5. È un conto di prop firm o di valutazione" },
    { type: "paragraph",html: "Su un conto di valutazione finanziato o di prop firm, lei non è il titolare del conto, quindi l'abilitazione ai dati di mercato è controllata dalla società, non da lei. Tradovate non può assistere con problemi di dati di mercato su conti di prop firm o di valutazione perché non gli appartengono. Abbonarsi da soli non servirà a nulla; la società deve abilitarlo." },
    { type: "heading",text: "Come risolvere dati ritardati e simboli arancioni: passo dopo passo" },
    { type: "heading",text: "Risolvere un conto personale (abbonarsi ai dati CME in tempo reale)" },
    {
      type: "steps",
      items: [
        { title: "Acceda al web trader", html: "Acceda al web trader di Tradovate su trader.tradovate.com da un browser desktop." },
        { title: "Apra la sezione Market Data", html: "Apra <strong class='text-white'>Application Settings</strong> (in alto a destra nello schermo) e vada alla sezione di abbonamento <strong class='text-white'>Market Data</strong>." },
        { title: "Selezioni l'abbonamento CME in tempo reale", html: "Selezioni l'abbonamento ai dati CME Group Level I in tempo reale. Su un piano di conto reale questi dati CME Level I sono inclusi senza costi aggiuntivi; con un nome utente solo di simulazione le verrà chiesto di richiedere un conto reale o di acquistare dati CME. Le inclusioni dei piani ed eventuali costi dei dati variano in base al tipo di conto e cambiano nel tempo, quindi controlli i termini attuali del suo piano." },
        { title: "Invii la richiesta", html: "Faccia clic su <strong class='text-white'>Update Subscriptions</strong> (o sul pulsante di conferma equivalente) per inviare la richiesta." },
      ],
    },
    { type: "heading",text: "Firmare l'accordo sui dati" },
    {
      type: "steps",
      items: [
        { title: "Accetti i termini e l'accordo", html: "Quando richiesto, esamini e accetti i <strong class='text-white'>Terms and Conditions</strong> e il <strong class='text-white'>Non-Professional Data Agreement</strong>. Questo passaggio è obbligatorio; i simboli arancioni di solito significano che questo accordo non è ancora firmato." },
        { title: "Lasci il tempo per l'attivazione", html: "Confermi che la richiesta vada a buon fine. L'attivazione può richiedere da <strong class='text-white'>10 a 90 minuti</strong> dopo la firma, in base alla richiesta della borsa, quindi non si preoccupi se il feed non è immediato." },
      ],
    },
    { type: "heading",text: "Uscire, rientrare e confermare il bianco" },
    {
      type: "steps",
      items: [
        { title: "Esca e rientri ovunque", html: "<strong class='text-white'>Esca</strong> completamente da Tradovate (e da qualsiasi piattaforma collegata come TradingView o NinjaTrader), poi <strong class='text-white'>rientri</strong>. I dati in tempo reale compaiono solo su una sessione nuova." },
        { title: "Confermi che il simbolo diventa bianco", html: "Controlli il colore del nome del simbolo. Ora dovrebbe essere <strong class='text-white'>bianco</strong>, a conferma del feed in tempo reale. Se dopo 90 minuti è ancora arancione, l'abbonamento o l'accordo non è stato finalizzato; torni in Application Settings e ricontrolli." },
      ],
    },
    { type: "heading",text: "Risolvere un conto di prop firm o di valutazione" },
    {
      type: "steps",
      items: [
        { title: "Non si abboni da solo", html: "Non provi ad abbonarsi da solo, l'abilitazione appartiene alla società." },
        { title: "Contatti il supporto della società", html: "Contatti il supporto della sua prop firm (Apex, Topstep e simili) e chieda di confermare o abilitare i dati di mercato in tempo reale sul suo conto di valutazione o finanziato." },
        { title: "Rifaccia il login una volta abilitato", html: "Una volta che la società lo ha abilitato, esca e rientri per ricevere il feed in tempo reale. Tempi di provisioning e regole variano a seconda della società e delle dimensioni del conto, quindi controlli le istruzioni attuali della sua società." },
      ],
    },
    { type: "heading",text: "Tabella di risoluzione dei problemi" },
    { type: "table", headers: ["Sintomo / messaggio","Cosa significa","Soluzione"], rows: [
      ["Nome del simbolo arancione","Il feed è ritardato, non in tempo reale","Abbonarsi ai dati CME in tempo reale, firmare l'accordo, rifare il login"],
      ["&ldquo;Delayed 10 minutes&rdquo; / quotazioni obsolete","Nessun abbonamento ai dati in tempo reale sul nome utente","Aggiungere l'abbonamento ai dati di mercato in tempo reale in Application Settings"],
      ["&ldquo;No live account&rdquo; nella schermata di abbonamento","L'abbonamento richiede un conto reale finanziato","Richiedere un conto reale o acquistare dati CME per operare in simulazione in tempo reale"],
      ["Richiesta dell'accordo Non-Professional","Accordo sui dati non ancora accettato","Esaminare e accettare i Terms e l'accordo Non-Professional"],
      ["Ancora arancione dopo l'abbonamento","La sessione non si è mai aggiornata","Uscire da tutte le piattaforme e rientrare; attendere 10–90 min"],
      ["Arancione su un conto prop/di valutazione","Solo la società può abilitare i dati","Contattare la prop firm; Tradovate non può sistemare conti della società"],
    ] },
    { type: "heading",text: "Prevenga tutto questo con PickMyTrade" },
    { type: "paragraph",html: "PickMyTrade instrada i suoi alert di TradingView direttamente a Tradovate ed è progettato in modo che un feed errato o ritardato non diventi un'esecuzione errata:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Consapevolezza di abilitazioni e stato dei dati</strong>, progettata per rispettare l'accordo sui dati e lo stato delle abilitazioni del suo conto, così l'automazione funziona in condizioni reali e non su un feed ritardato e obsoleto.",
        "<strong class='text-white'>Validazione di quantità e simbolo</strong>, controlla simbolo e quantità prima che un ordine parta, così un contratto digitato male o non negoziabile non passa.",
        "<strong class='text-white'>Instradamento a prova di limiti di frequenza</strong>, distanzia il flusso di ordini in modo che nuovi login e riconnessioni non facciano scattare blocchi per &ldquo;too many requests&rdquo;.",
        "<strong class='text-white'>Sincronizzazione multi-conto</strong>, replica lo stesso ordine corretto sui suoi conti una volta confermato che i dati sono in tempo reale.",
      ],
    },
  ] },
  ctaHeading: { en: "Trade Rejection-Free", de: "Handeln Sie ohne Order-Ablehnungen", es: "Opere sin rechazos de órdenes", fr: "Tradez sans rejet d'ordres", it: "Operi senza rifiuti di ordini" },
  ctaText: { en: "Start your free 7-day trial, link your alerts today and trade rejection-free once your data is confirmed live.", de: "Starten Sie Ihre kostenlose 7-Tage-Testphase, verbinden Sie noch heute Ihre Alerts und handeln Sie ohne Ablehnungen, sobald Ihre Daten als live bestätigt sind.", es: "Comience su prueba gratuita de 7 días, vincule sus alertas hoy y opere sin rechazos una vez que sus datos estén confirmados en vivo.", fr: "Commencez votre essai gratuit de 7 jours, reliez vos alertes dès aujourd'hui et tradez sans rejet dès que vos données sont confirmées en direct.", it: "Inizi la prova gratuita di 7 giorni, colleghi gli alert oggi stesso e operi senza rifiuti una volta confermato che i suoi dati sono in tempo reale." },
  ctaButtonText: { en: "Start Your Free 7-Day Trial", de: "Starten Sie Ihre kostenlose 7-Tage-Testphase", es: "Comience su prueba gratuita de 7 días", fr: "Commencez votre essai gratuit de 7 jours", it: "Inizi la prova gratuita di 7 giorni" },
  ctaUrl: "https://app.pickmytrade.trade/?register=true&utm_source=content&utm_medium=debugging",
  faqHeading: { en: "Frequently Asked Questions", de: "Häufig gestellte Fragen", es: "Preguntas frecuentes", fr: "Questions fréquentes", it: "Domande frequenti" },
  faqs: { en: [
    { q: "What do orange symbol names mean in Tradovate?", a: "Orange means the instrument is on the free ten-minute delayed feed, not live data. A white symbol name means live real-time data is active." },
    { q: "Why is my Tradovate data delayed by 10 minutes?", a: "Your username has no live market-data subscription. Tradovate delays quotes by ten minutes for any account without a live CME data entitlement." },
    { q: "How do I turn on live data in Tradovate?", a: "On a personal account, open Application Settings, add the live CME Level I market-data subscription, accept the Terms and the Non-Professional Data Agreement, then log out and back in." },
    { q: "Do I need a funded live account to get real-time data?", a: "A live market-data subscription is tied to a live account. If you only have a simulation username, you'll be prompted to apply for a live account or buy CME data to trade the sim in real time." },
    { q: "How long does it take for live data to activate?", a: "Usually 10 to 90 minutes after you sign the agreements, depending on exchange demand. Log out and back in once it's active." },
    { q: "I subscribed but my symbols are still orange, what's wrong?", a: "Usually the session hasn't refreshed or the Non-Professional agreement wasn't accepted. Confirm the agreement is signed, then fully log out and log back in." },
    { q: "My account is with a prop firm, why can't I subscribe?", a: "On a prop or evaluation account you're not the account owner, so only the firm can enable market data. Contact your prop firm; Tradovate can't change data on accounts it doesn't own." },
    { q: "Is it safe to trade while symbols are orange?", a: "No. Prices are ten minutes old, which can cause bad fills and rejected orders. Wait until symbols turn white before placing any trade." },
  ], de: [
    { q: "Was bedeuten orange Symbolnamen in Tradovate?", a: "Orange bedeutet, dass das Instrument über den kostenlosen, um zehn Minuten verzögerten Feed läuft und nicht über Live-Daten. Ein weißer Symbolname bedeutet, dass Live-Echtzeitdaten aktiv sind." },
    { q: "Warum sind meine Tradovate-Daten um 10 Minuten verzögert?", a: "Ihr Benutzername hat kein Live-Marktdaten-Abonnement. Tradovate verzögert Kurse um zehn Minuten für jedes Konto ohne Live-CME-Datenberechtigung." },
    { q: "Wie schalte ich Live-Daten in Tradovate ein?", a: "Öffnen Sie bei einem privaten Konto die Application Settings, fügen Sie das Live-CME-Level-I-Marktdaten-Abonnement hinzu, akzeptieren Sie die Terms und das Non-Professional Data Agreement und melden Sie sich anschließend ab und wieder an." },
    { q: "Brauche ich ein finanziertes Live-Konto, um Echtzeitdaten zu erhalten?", a: "Ein Live-Marktdaten-Abonnement ist an ein Live-Konto gebunden. Wenn Sie nur einen Simulations-Benutzernamen haben, werden Sie aufgefordert, ein Live-Konto zu beantragen oder CME-Daten zu kaufen, um die Simulation in Echtzeit zu handeln." },
    { q: "Wie lange dauert es, bis Live-Daten aktiviert sind?", a: "In der Regel 10 bis 90 Minuten nach der Unterzeichnung der Vereinbarungen, abhängig von der Börsenauslastung. Melden Sie sich ab und wieder an, sobald es aktiv ist." },
    { q: "Ich habe abonniert, aber meine Symbole sind weiterhin orange, was stimmt nicht?", a: "Meist wurde die Sitzung nicht aktualisiert oder die Non-Professional-Vereinbarung wurde nicht akzeptiert. Prüfen Sie, ob die Vereinbarung unterzeichnet ist, und melden Sie sich dann vollständig ab und wieder an." },
    { q: "Mein Konto gehört zu einer Prop-Firma, warum kann ich nicht abonnieren?", a: "Bei einem Prop- oder Evaluierungskonto sind Sie nicht der Kontoinhaber, daher kann nur die Firma Marktdaten freischalten. Wenden Sie sich an Ihre Prop-Firma; Tradovate kann keine Daten für Konten ändern, die ihm nicht gehören." },
    { q: "Ist es sicher zu handeln, solange Symbole orange sind?", a: "Nein. Die Kurse sind zehn Minuten alt, was zu schlechten Ausführungen und abgelehnten Orders führen kann. Warten Sie, bis die Symbole weiß werden, bevor Sie einen Trade platzieren." },
  ], es: [
    { q: "¿Qué significan los nombres de símbolos en naranja en Tradovate?", a: "Naranja significa que el instrumento está en el feed gratuito retrasado diez minutos, no en datos en vivo. Un nombre de símbolo en blanco significa que los datos en tiempo real están activos." },
    { q: "¿Por qué mis datos de Tradovate van retrasados 10 minutos?", a: "Su nombre de usuario no tiene una suscripción de datos de mercado en vivo. Tradovate retrasa las cotizaciones diez minutos en cualquier cuenta sin un permiso de datos de CME en vivo." },
    { q: "¿Cómo activo los datos en vivo en Tradovate?", a: "En una cuenta personal, abra Application Settings, añada la suscripción de datos de mercado CME Level I en vivo, acepte los Terms y el Non-Professional Data Agreement y luego cierre sesión y vuelva a entrar." },
    { q: "¿Necesito una cuenta real con fondos para obtener datos en tiempo real?", a: "Una suscripción de datos de mercado en vivo está vinculada a una cuenta real. Si solo tiene un nombre de usuario de simulación, se le pedirá que solicite una cuenta real o compre datos de CME para operar la simulación en tiempo real." },
    { q: "¿Cuánto tarda en activarse el dato en vivo?", a: "Normalmente entre 10 y 90 minutos después de firmar los acuerdos, según la demanda de la bolsa. Cierre sesión y vuelva a entrar cuando esté activo." },
    { q: "Me suscribí pero mis símbolos siguen en naranja, ¿qué falla?", a: "Normalmente la sesión no se ha actualizado o no se aceptó el acuerdo Non-Professional. Confirme que el acuerdo está firmado y luego cierre sesión por completo y vuelva a iniciarla." },
    { q: "Mi cuenta es de una prop firm, ¿por qué no puedo suscribirme?", a: "En una cuenta de prop firm o de evaluación usted no es el titular de la cuenta, por lo que solo la firma puede activar los datos de mercado. Contacte con su prop firm; Tradovate no puede cambiar los datos de cuentas que no le pertenecen." },
    { q: "¿Es seguro operar mientras los símbolos están en naranja?", a: "No. Los precios tienen diez minutos de antigüedad, lo que puede causar malas ejecuciones y órdenes rechazadas. Espere a que los símbolos se pongan en blanco antes de realizar cualquier operación." },
  ], fr: [
    { q: "Que signifient les noms de symboles en orange dans Tradovate ?", a: "L'orange signifie que l'instrument est sur le flux différé gratuit de dix minutes, et non sur des données en direct. Un nom de symbole en blanc signifie que les données en temps réel sont actives." },
    { q: "Pourquoi mes données Tradovate sont-elles différées de 10 minutes ?", a: "Votre identifiant n'a pas d'abonnement aux données de marché en direct. Tradovate retarde les cotations de dix minutes pour tout compte sans droit d'accès aux données CME en direct." },
    { q: "Comment activer les données en direct dans Tradovate ?", a: "Sur un compte personnel, ouvrez Application Settings, ajoutez l'abonnement aux données de marché CME Level I en direct, acceptez les Terms et le Non-Professional Data Agreement, puis déconnectez-vous et reconnectez-vous." },
    { q: "Ai-je besoin d'un compte réel financé pour obtenir des données en temps réel ?", a: "Un abonnement aux données de marché en direct est lié à un compte réel. Si vous n'avez qu'un identifiant de simulation, il vous sera proposé de demander un compte réel ou d'acheter des données CME pour trader la simulation en temps réel." },
    { q: "Combien de temps faut-il pour que les données en direct soient activées ?", a: "Généralement de 10 à 90 minutes après la signature des accords, selon la demande de la bourse. Déconnectez-vous et reconnectez-vous une fois l'activation effective." },
    { q: "Je me suis abonné mais mes symboles sont toujours orange, que se passe-t-il ?", a: "En général, la session ne s'est pas rafraîchie ou l'accord Non-Professional n'a pas été accepté. Confirmez que l'accord est signé, puis déconnectez-vous complètement et reconnectez-vous." },
    { q: "Mon compte est chez une prop firm, pourquoi ne puis-je pas m'abonner ?", a: "Sur un compte de prop firm ou d'évaluation, vous n'êtes pas le titulaire du compte ; seule la société peut donc activer les données de marché. Contactez votre prop firm ; Tradovate ne peut pas modifier les données de comptes qui ne lui appartiennent pas." },
    { q: "Est-il prudent de trader tant que les symboles sont orange ?", a: "Non. Les prix ont dix minutes de retard, ce qui peut entraîner de mauvaises exécutions et des ordres rejetés. Attendez que les symboles deviennent blancs avant de passer le moindre trade." },
  ], it: [
    { q: "Cosa significano i nomi dei simboli arancioni in Tradovate?", a: "L'arancione significa che lo strumento è sul feed gratuito ritardato di dieci minuti, non su dati in tempo reale. Un nome di simbolo bianco significa che i dati in tempo reale sono attivi." },
    { q: "Perché i miei dati di Tradovate sono ritardati di 10 minuti?", a: "Il suo nome utente non ha un abbonamento ai dati di mercato in tempo reale. Tradovate ritarda le quotazioni di dieci minuti per qualsiasi conto privo di un'abilitazione ai dati CME in tempo reale." },
    { q: "Come attivo i dati in tempo reale in Tradovate?", a: "Su un conto personale, apra Application Settings, aggiunga l'abbonamento ai dati di mercato CME Level I in tempo reale, accetti i Terms e il Non-Professional Data Agreement, poi esca e rientri." },
    { q: "Ho bisogno di un conto reale finanziato per ottenere dati in tempo reale?", a: "Un abbonamento ai dati di mercato in tempo reale è legato a un conto reale. Se ha solo un nome utente di simulazione, le verrà chiesto di richiedere un conto reale o di acquistare dati CME per operare in simulazione in tempo reale." },
    { q: "Quanto tempo serve perché i dati in tempo reale si attivino?", a: "Di solito da 10 a 90 minuti dopo la firma degli accordi, in base alla richiesta della borsa. Esca e rientri una volta attivo." },
    { q: "Mi sono abbonato ma i miei simboli sono ancora arancioni, cosa non va?", a: "Di solito la sessione non si è aggiornata oppure l'accordo Non-Professional non è stato accettato. Confermi che l'accordo sia firmato, poi esca completamente e rientri." },
    { q: "Il mio conto è con una prop firm, perché non posso abbonarmi?", a: "Su un conto prop o di valutazione lei non è il titolare del conto, quindi solo la società può abilitare i dati di mercato. Contatti la sua prop firm; Tradovate non può modificare i dati di conti che non possiede." },
    { q: "È sicuro operare mentre i simboli sono arancioni?", a: "No. I prezzi hanno dieci minuti di ritardo, il che può causare esecuzioni errate e ordini respinti. Attenda che i simboli diventino bianchi prima di inserire qualsiasi trade." },
  ] },
  relatedHeading: { en: "Related Guides", de: "Verwandte Anleitungen", es: "Guías relacionadas", fr: "Guides associés", it: "Guide correlate" },
