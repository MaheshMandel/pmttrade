---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "exchange-clearing-fees-not-waived";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/debugging/${SLUG}`;

const META_TITLE = "Tradovate Exchange & Clearing Fees Never Waived";
const META_DESCRIPTION =
  "Exchange, clearing and NFA fees hit every futures trade and no plan tier waives them. Budget about $0.50–$1.50 per round turn to know your true cost.";

// Short SEO title (<=60 chars) for locales where the shared h1 is too long for a SERP title.
const TITLE_OVERRIDE: Partial<Record<Locale, string>> = { es: "Tradovate: no se eliminan las comisiones de bolsa/clearing", fr: "Tradovate : frais de bourse et de compensation jamais levés", it: "Tradovate: tariffe di borsa e clearing mai eliminate" };

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Tradovate Börsen- und Clearing-Gebühren werden nie erlassen", es: "Las comisiones de bolsa y compensación de Tradovate nunca se eliminan", fr: "Les frais de bourse et de compensation de Tradovate ne sont jamais supprimés", it: "Le tariffe di borsa e di clearing di Tradovate non vengono mai eliminate" },
  dek: { en: "Your commission dropped but the statement still bills you every trade. Here's why exchange, clearing and NFA fees never go away, no matter which plan you pick.", de: "Ihre Provision ist gesunken, doch die Abrechnung belastet Sie weiterhin bei jedem Trade. Hier erfahren Sie, warum Börsen-, Clearing- und NFA-Gebühren nie verschwinden, egal welchen Plan Sie wählen.", es: "Su comisión bajó, pero el extracto le sigue cobrando en cada operación. Esto explica por qué las tarifas de bolsa, compensación y de la NFA nunca desaparecen, sin importar el plan que elija.", fr: "Votre commission a baissé, mais le relevé continue de vous facturer à chaque trade. Voici pourquoi les frais de bourse, de compensation et de la NFA ne disparaissent jamais, quel que soit le forfait choisi.", it: "La sua commissione è scesa, ma l'estratto conto continua ad addebitarle ogni operazione. Ecco perché le tariffe di borsa, di clearing e della NFA non spariscono mai, indipendentemente dal piano scelto." },
  readTime: { en: "7 min read", de: "7 Minuten Lesezeit", es: "Lectura de 7 minutos", fr: "Lecture de 7 minutes", it: "Lettura di 7 minuti" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "You upgraded to the Lifetime plan for the cheap commissions, ran a busy session of micros, and the statement still shows a fee stack you didn't expect. Here's the thing nobody spells out clearly when you sign up: the plan tiers only discount the <em>broker commission</em>. Exchange, clearing and NFA fees sit on top of every fill, and no membership tier, Free, Monthly or Lifetime, waives them. The official pricing even says so in small print: exchange, clearing and NFA fees apply. So when your &ldquo;commission-free&rdquo; or ultra-low-commission plan still costs money per trade, nothing is broken. You're paying the part of a futures trade that never goes away. Budget roughly $0.50 to $1.50 per round turn for it, and the surprise disappears." },
    {
      type: "checklist",
      heading: "Quick Answer: What You Actually Pay Per Trade",
      items: [
        "<strong class='text-white'>Commission</strong>, the broker's cut. This is the only piece the Free / Monthly / Lifetime plans change.",
        "<strong class='text-white'>Exchange fee</strong>, paid to the exchange (CME, CBOT, NYMEX, COMEX). Set by the exchange, not the broker.",
        "<strong class='text-white'>Clearing fee</strong>, paid to the clearing firm that settles the trade.",
        "<strong class='text-white'>NFA fee</strong>, a small regulatory assessment, charged per side on every contract.",
        "<strong class='text-white'>The rule:</strong> the last three are pass-through charges. No plan tier can waive them, and they apply the moment an order fills.",
      ],
    },
    { type: "heading", text: "Why “Commission-Free” Still Costs Money" },
    { type: "paragraph", html: "Marketing loves the phrase &ldquo;commission-free,&rdquo; and it's technically true on some tiers, but it only describes the broker's own charge. A futures trade has more than one party with a hand out. The exchange charges a fee to match your order. The clearing firm charges a fee to settle and guarantee it. The NFA levies a per-side assessment on the whole industry. Your broker collects those on the exchange's behalf and passes them through at cost. That's why the fine print on the pricing page reads &ldquo;exchange, clearing, and NFA fees apply&rdquo; no matter which plan you're on." },
    { type: "paragraph", html: "Think of it like a concert ticket. The plan tier is the discount on the face price of the ticket. The exchange and clearing fees are the venue and processing charges bolted on at checkout, you can't shop those away by picking a different ticket tier. The commission drops from about $1.29 per side on the Free plan to well under a dollar on Lifetime, and that's a real saving if you trade size. But the exchange and clearing layer underneath doesn't move." },
    { type: "heading", text: "What Each Fee Is and Who Charges It" },
    { type: "heading", text: "The Exchange Fee" },
    { type: "paragraph", html: "This goes to the exchange that lists the contract, CME for the equity index futures most retail traders touch (ES, NQ and their micros), plus CBOT, NYMEX and COMEX for rates, energy and metals. The exchange sets the number, publishes it, and updates it periodically. Non-members (that's you, trading through a broker) pay a higher rate than exchange members. It's charged per side, so you pay it going in and again coming out." },
    { type: "heading", text: "The Clearing Fee" },
    { type: "paragraph", html: "Every futures trade is guaranteed by a clearing house, and the clearing firm that stands behind your account charges a fee for that. It's often small and sometimes bundled into how the broker quotes fees, but it exists on every contract and it's not part of the commission you're discounting with a plan." },
    { type: "heading", text: "The NFA Fee" },
    { type: "paragraph", html: "The National Futures Association charges a per-side assessment on futures transactions, a fraction of a cent to a couple of cents per side, depending on the current schedule. Tiny on its own, but it's on every contract, both sides, forever. It has moved over the years, so treat any specific figure as a snapshot and check the current rate if you're building a precise cost model." },
    { type: "heading", text: "How Much to Budget: The Numbers That Matter" },
    { type: "paragraph", html: "Across the products a day trader actually uses, plan on roughly <strong class='text-white'>$0.50 to $1.50 per round turn</strong> in exchange, clearing and NFA fees combined, on top of commission. Where you land in that band depends entirely on the contract:" },
    {
      type: "table",
      headers: ["Contract type", "Examples", "Exchange + clearing + NFA (per round turn)"],
      rows: [
        ["Micro futures", "MES, MNQ, MGC, MCL", "Low end of the band, cheapest to churn"],
        ["Standard E-minis", "ES, NQ", "Around $1.25 per round turn"],
        ["Other minis", "CL, GC, and similar", "Varies by product, check the exact contract"],
      ],
    },
    { type: "paragraph", html: "Two things trip people up here. First, these fees are quoted <strong class='text-white'>per side</strong> in most schedules, so a round turn is double the per-side figure, always confirm which one you're reading. Second, the exact exchange fee changes when the exchange revises its schedule (CME has adjusted rates as recently as this year). The safest habit: look up your specific contract in the CME Non-Member Fee Finder, add the clearing and NFA pieces, and double it for a round turn. That's your real floor cost before commission." },
    { type: "heading", text: "How to Find Your True Per-Trade Cost, Step by Step" },
    { type: "heading", text: "Read the Actual Fee on a Completed Trade" },
    {
      type: "list",
      items: [
        "Open your account statement or the reports/activity view and pull a day where you took a few trades.",
        "Find the fee columns tied to each fill. You want the <strong class='text-white'>commission</strong> line and the <strong class='text-white'>exchange/clearing/NFA</strong> line separately, they're distinct charges.",
        "Add both per contract, then multiply by two for a full round turn. That number is what you actually pay to open and close one contract, and it's the figure your strategy has to beat.",
      ],
    },
    { type: "heading", text: "Look Up the Exchange Fee Before You Trade a New Contract" },
    {
      type: "list",
      items: [
        "Go to the CME Non-Member Fee Finder and search your product (for example MNQ or ES).",
        "Note the non-member exchange fee per side. Add the clearing fee and the current NFA per-side assessment.",
        "Double it for the round turn and add your plan's commission. Now you know the all-in cost before you ever place an order.",
      ],
    },
    { type: "heading", text: "Decide Whether a Plan Upgrade Actually Pays Off" },
    {
      type: "list",
      items: [
        "Estimate your monthly round turns honestly.",
        "Multiply the commission saving per side by your expected volume and compare it to the plan's monthly or one-time cost.",
        "Remember the exchange and clearing layer is constant across plans, it never enters this math. Only the commission does. If you don't trade enough size, a pricier plan can cost more than it saves.",
      ],
    },
    { type: "heading", text: "Common Fee Surprises and What They Really Are" },
    {
      type: "table",
      headers: ["What you see", "What it actually is", "What to do"],
      rows: [
        ["&ldquo;Commission-free&rdquo; plan still charges per trade", "Exchange + clearing + NFA fees, which no plan waives", "Budget ~$0.50–$1.50 per round turn"],
        ["Lifetime plan didn't zero out my costs", "Only the commission dropped; pass-through fees stayed", "Compare commission saving vs plan cost"],
        ["Fee looks doubled vs the schedule", "Schedule quotes per side; you traded a round turn", "Multiply per-side rate by two"],
        ["Net P&amp;L lower than gross on export", "Fees subtracted from gross; export often omits them", "Reconcile gross to gross, not gross to net"],
        ["Micros cost far less than minis", "Micro exchange fees are a fraction of full-size", "Expected, size your churn accordingly"],
        ["Fee changed month to month", "Exchange revised its published fee schedule", "Re-check the current rate in the Fee Finder"],
      ],
    },
    { type: "heading", text: "Where Automation Actually Helps With Fee Drag" },
    { type: "paragraph", html: "You can't waive exchange and clearing fees, so the only lever left is not paying them on trades you didn't mean to take. Fee drag is death by a thousand cuts: a doubled entry from a fat finger, a duplicate order from a jittery alert, an oversized position that racks up per-contract fees you never intended. That's where a disciplined order layer earns its keep. PickMyTrade sits between your TradingView alerts and Tradovate and keeps the flow clean:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Qty / Symbol Validation</strong>, stops oversized or wrong-symbol orders before they fill and bill you fees per contract.",
        "<strong class='text-white'>Duplicate-Alert Filtering</strong>, one intended signal fires one order, so you don't pay round-turn fees twice for the same idea.",
        "<strong class='text-white'>Multi-Account Sync</strong>, mirrors correctly sized orders across accounts at once, instead of hand-entering (and mis-entering) each one.",
        "<strong class='text-white'>Rate-Limit-Safe Routing</strong>, spaces order flow so exits land cleanly, keeping you out of the messy re-tries that pile on fills.",
      ],
    },
    { type: "paragraph", html: "It won't shrink the exchange's cut. It will make sure every fill you pay for is one you actually wanted." },
  ], de: [
    { type: "paragraph", html: "Sie sind wegen der günstigen Provisionen auf den Lifetime-Plan umgestiegen, haben eine geschäftige Session mit Micros gehandelt, und die Abrechnung zeigt trotzdem einen Gebührenstapel, mit dem Sie nicht gerechnet haben. Das wird bei der Anmeldung nirgends klar gesagt: Die Plan-Stufen reduzieren nur die <em>Broker-Provision</em>. Börsen-, Clearing- und NFA-Gebühren kommen bei jeder Ausführung obendrauf, und keine Mitgliedschaftsstufe, Free, Monthly oder Lifetime, erlässt sie. Die offizielle Preisseite sagt es sogar im Kleingedruckten: Börsen-, Clearing- und NFA-Gebühren fallen zusätzlich an. Wenn Ihr &ldquo;provisionsfreier&rdquo; oder besonders günstiger Plan also trotzdem pro Trade Geld kostet, ist nichts kaputt. Sie zahlen den Teil eines Futures-Trades, der nie verschwindet. Kalkulieren Sie dafür etwa 0,50 bis 1,50 US-Dollar pro Round Turn ein, dann verschwindet die Überraschung." },
    {
      type: "checklist",
      heading: "Kurzantwort: Was Sie tatsächlich pro Trade zahlen",
      items: [
        "<strong class='text-white'>Provision</strong>, der Anteil des Brokers. Das ist der einzige Posten, den die Pläne Free / Monthly / Lifetime verändern.",
        "<strong class='text-white'>Börsengebühr</strong>, an die Börse gezahlt (CME, CBOT, NYMEX, COMEX). Wird von der Börse festgelegt, nicht vom Broker.",
        "<strong class='text-white'>Clearing-Gebühr</strong>, an die Clearingstelle gezahlt, die den Trade abwickelt.",
        "<strong class='text-white'>NFA-Gebühr</strong>, eine kleine regulatorische Abgabe, die pro Seite auf jeden Kontrakt erhoben wird.",
        "<strong class='text-white'>Die Regel:</strong> Die letzten drei sind durchgereichte Gebühren. Keine Plan-Stufe kann sie erlassen, und sie fallen in dem Moment an, in dem eine Order ausgeführt wird.",
      ],
    },
    { type: "heading", text: "Warum &ldquo;provisionsfrei&rdquo; trotzdem Geld kostet" },
    { type: "paragraph", html: "Das Marketing liebt den Ausdruck &ldquo;provisionsfrei&rdquo;, und in manchen Stufen stimmt er sogar technisch, doch er beschreibt nur die eigene Gebühr des Brokers. An einem Futures-Trade sind mehrere Parteien mit ausgestreckter Hand beteiligt. Die Börse berechnet eine Gebühr für das Matching Ihrer Order. Die Clearingstelle berechnet eine Gebühr für die Abwicklung und Garantie. Die NFA erhebt eine Abgabe pro Seite auf die gesamte Branche. Ihr Broker zieht diese im Namen der Börse ein und reicht sie zum Selbstkostenpreis durch. Deshalb steht im Kleingedruckten der Preisseite unabhängig vom gewählten Plan: &ldquo;Börsen-, Clearing- und NFA-Gebühren fallen zusätzlich an.&rdquo;" },
    { type: "paragraph", html: "Stellen Sie es sich wie ein Konzertticket vor. Die Plan-Stufe ist der Rabatt auf den Nennpreis des Tickets. Die Börsen- und Clearing-Gebühren sind die Veranstaltungs- und Bearbeitungsgebühren, die an der Kasse dazukommen, die können Sie sich nicht durch eine andere Ticketstufe wegsparen. Die Provision sinkt von etwa 1,29 US-Dollar pro Seite im Free-Plan auf deutlich unter einen Dollar im Lifetime-Plan, und das ist eine echte Ersparnis, wenn Sie mit Größe handeln. Aber die darunterliegende Börsen- und Clearing-Ebene bewegt sich nicht." },
    { type: "heading", text: "Was jede Gebühr ist und wer sie erhebt" },
    { type: "heading", text: "Die Börsengebühr" },
    { type: "paragraph", html: "Diese fließt an die Börse, die den Kontrakt listet, CME für die Aktienindex-Futures, mit denen die meisten Privatanleger zu tun haben (ES, NQ und ihre Micros), sowie CBOT, NYMEX und COMEX für Zinsen, Energie und Metalle. Die Börse legt den Betrag fest, veröffentlicht ihn und aktualisiert ihn regelmäßig. Nicht-Mitglieder (also Sie, die über einen Broker handeln) zahlen einen höheren Satz als Börsenmitglieder. Sie wird pro Seite erhoben, Sie zahlen sie also beim Einstieg und noch einmal beim Ausstieg." },
    { type: "heading", text: "Die Clearing-Gebühr" },
    { type: "paragraph", html: "Jeder Futures-Trade wird von einer Clearingstelle garantiert, und die Clearingfirma, die für Ihr Konto einsteht, berechnet dafür eine Gebühr. Sie ist oft klein und manchmal in die Art und Weise eingerechnet, wie der Broker Gebühren ausweist, aber sie fällt auf jeden Kontrakt an und ist nicht Teil der Provision, die durch einen Plan rabattiert wird." },
    { type: "heading", text: "Die NFA-Gebühr" },
    { type: "paragraph", html: "Die National Futures Association erhebt eine Abgabe pro Seite auf Futures-Transaktionen, je nach aktuellem Tarif einen Bruchteil eines Cents bis ein paar Cent pro Seite. Für sich genommen winzig, aber sie fällt auf jeden Kontrakt an, auf beiden Seiten, immer wieder. Der Satz hat sich über die Jahre verändert, betrachten Sie eine konkrete Zahl also als Momentaufnahme und prüfen Sie den aktuellen Satz, wenn Sie ein präzises Kostenmodell erstellen." },
    { type: "heading", text: "Wie viel Sie einplanen sollten: Die Zahlen, auf die es ankommt" },
    { type: "paragraph", html: "Bei den Produkten, die ein Daytrader tatsächlich nutzt, sollten Sie mit etwa <strong class='text-white'>0,50 bis 1,50 US-Dollar pro Round Turn</strong> an Börsen-, Clearing- und NFA-Gebühren zusammen rechnen, zusätzlich zur Provision. Wo Sie in dieser Spanne landen, hängt vollständig vom Kontrakt ab:" },
    {
      type: "table",
      headers: ["Kontrakttyp", "Beispiele", "Börse + Clearing + NFA (pro Round Turn)"],
      rows: [
        ["Micro-Futures", "MES, MNQ, MGC, MCL", "Unteres Ende der Spanne, am günstigsten zu handeln"],
        ["Standard-E-minis", "ES, NQ", "Rund 1,25 US-Dollar pro Round Turn"],
        ["Andere Minis", "CL, GC und ähnliche", "Variiert je nach Produkt, prüfen Sie den genauen Kontrakt"],
      ],
    },
    { type: "paragraph", html: "Zwei Dinge stolpern hier häufig Trader. Erstens werden diese Gebühren in den meisten Tarifen <strong class='text-white'>pro Seite</strong> angegeben, ein Round Turn ist also das Doppelte des Pro-Seite-Betrags, prüfen Sie immer, welchen Wert Sie gerade lesen. Zweitens ändert sich die genaue Börsengebühr, wenn die Börse ihren Tarif überarbeitet (die CME hat die Sätze erst dieses Jahr wieder angepasst). Die sicherste Gewohnheit: Suchen Sie Ihren konkreten Kontrakt im CME Non-Member Fee Finder nach, addieren Sie den Clearing- und NFA-Anteil und verdoppeln Sie das Ergebnis für einen Round Turn. Das ist Ihre tatsächliche Kostenuntergrenze vor der Provision." },
    { type: "heading", text: "So finden Sie Ihre wahren Kosten pro Trade, Schritt für Schritt" },
    { type: "heading", text: "Lesen Sie die tatsächliche Gebühr bei einem abgeschlossenen Trade ab" },
    {
      type: "list",
      items: [
        "Öffnen Sie Ihren Kontoauszug oder die Berichte-/Aktivitätsansicht und wählen Sie einen Tag mit ein paar Trades aus.",
        "Suchen Sie die Gebührenspalten zu jeder Ausführung. Sie wollen die Zeile <strong class='text-white'>Provision</strong> und die Zeile <strong class='text-white'>Börse/Clearing/NFA</strong> getrennt sehen, es handelt sich um unterschiedliche Posten.",
        "Addieren Sie beide pro Kontrakt und verdoppeln Sie das Ergebnis für einen vollständigen Round Turn. Diese Zahl zahlen Sie tatsächlich, um einen Kontrakt zu eröffnen und zu schließen, und sie ist der Wert, den Ihre Strategie schlagen muss.",
      ],
    },
    { type: "heading", text: "Prüfen Sie die Börsengebühr, bevor Sie einen neuen Kontrakt handeln" },
    {
      type: "list",
      items: [
        "Gehen Sie zum CME Non-Member Fee Finder und suchen Sie Ihr Produkt (zum Beispiel MNQ oder ES).",
        "Notieren Sie sich die Nicht-Mitglieder-Börsengebühr pro Seite. Addieren Sie die Clearing-Gebühr und die aktuelle NFA-Abgabe pro Seite.",
        "Verdoppeln Sie das Ergebnis für den Round Turn und addieren Sie die Provision Ihres Plans. Jetzt kennen Sie die Gesamtkosten, bevor Sie überhaupt eine Order platzieren.",
      ],
    },
    { type: "heading", text: "Entscheiden Sie, ob sich ein Plan-Upgrade tatsächlich lohnt" },
    {
      type: "list",
      items: [
        "Schätzen Sie Ihre monatlichen Round Turns ehrlich ein.",
        "Multiplizieren Sie die Provisionsersparnis pro Seite mit Ihrem erwarteten Volumen und vergleichen Sie das Ergebnis mit den monatlichen oder einmaligen Kosten des Plans.",
        "Denken Sie daran, dass die Börsen- und Clearing-Ebene über alle Pläne hinweg konstant bleibt, sie fließt nie in diese Rechnung ein. Nur die Provision tut das. Wenn Sie nicht genug Volumen handeln, kann ein teurerer Plan mehr kosten, als er einspart.",
      ],
    },
    { type: "heading", text: "Häufige Gebühren-Überraschungen und was wirklich dahintersteckt" },
    {
      type: "table",
      headers: ["Was Sie sehen", "Was es tatsächlich ist", "Was Sie tun sollten"],
      rows: [
        ["&ldquo;Provisionsfreier&rdquo; Plan berechnet trotzdem pro Trade", "Börsen- + Clearing- + NFA-Gebühren, die kein Plan erlässt", "Rechnen Sie mit ~0,50–1,50 US-Dollar pro Round Turn"],
        ["Lifetime-Plan hat meine Kosten nicht auf null gesenkt", "Nur die Provision ist gesunken; die durchgereichten Gebühren sind geblieben", "Provisionsersparnis mit den Plankosten vergleichen"],
        ["Gebühr wirkt gegenüber dem Tarif verdoppelt", "Der Tarif gibt Gebühren pro Seite an; Sie haben einen Round Turn gehandelt", "Pro-Seite-Satz mit zwei multiplizieren"],
        ["Netto-G&amp;V beim Export niedriger als brutto", "Gebühren werden vom Brutto abgezogen; der Export lässt sie oft weg", "Brutto mit Brutto abgleichen, nicht Brutto mit Netto"],
        ["Micros kosten deutlich weniger als Minis", "Die Micro-Börsengebühren sind ein Bruchteil der Vollgröße", "Erwartbar, richten Sie Ihr Handelsvolumen entsprechend aus"],
        ["Gebühr hat sich von Monat zu Monat geändert", "Die Börse hat ihren veröffentlichten Gebührentarif überarbeitet", "Prüfen Sie den aktuellen Satz erneut im Fee Finder"],
      ],
    },
    { type: "heading", text: "Wo Automatisierung wirklich gegen Gebührenverluste hilft" },
    { type: "paragraph", html: "Börsen- und Clearing-Gebühren können Sie nicht erlassen, der einzige verbliebene Hebel ist also, sie nicht für Trades zu zahlen, die Sie gar nicht machen wollten. Gebührenverlust ist der Tod durch tausend Schnitte: eine doppelt ausgeführte Order durch einen Tippfehler, eine Duplikat-Order durch einen fehlerhaften Alert, eine überdimensionierte Position, die Gebühren pro Kontrakt anhäuft, die Sie nie beabsichtigt haben. Genau hier zahlt sich eine disziplinierte Order-Ebene aus. PickMyTrade sitzt zwischen Ihren TradingView-Alerts und Tradovate und hält den Ablauf sauber:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Qty-/Symbol-Validierung</strong>, stoppt überdimensionierte Orders oder Orders mit falschem Symbol, bevor sie ausgeführt werden und Ihnen Gebühren pro Kontrakt berechnen.",
        "<strong class='text-white'>Duplikat-Alert-Filterung</strong>, ein beabsichtigtes Signal löst eine Order aus, sodass Sie nicht zweimal Round-Turn-Gebühren für dieselbe Idee zahlen.",
        "<strong class='text-white'>Multi-Konto-Synchronisierung</strong>, spiegelt korrekt dimensionierte Orders gleichzeitig über mehrere Konten, anstatt jede einzeln (und fehleranfällig) von Hand einzugeben.",
        "<strong class='text-white'>Ratenlimit-sicheres Routing</strong>, staffelt den Orderfluss, damit Exits sauber ankommen, und hält Sie aus den chaotischen Wiederholungsversuchen heraus, die Ausführungen anhäufen.",
      ],
    },
    { type: "paragraph", html: "Am Anteil der Börse ändert das nichts. Aber es sorgt dafür, dass jede Ausführung, für die Sie zahlen, auch wirklich gewollt war." },
  ], es: [
    { type: "paragraph", html: "Usted pasó al plan Lifetime por las comisiones bajas, tuvo una sesión intensa con micros, y el extracto sigue mostrando un conjunto de tarifas que no esperaba. Esto es lo que nadie explica con claridad al registrarse: los niveles de plan solo descuentan la <em>comisión del bróker</em>. Las tarifas de bolsa, compensación y de la NFA se suman a cada ejecución, y ningún nivel de membresía, Free, Monthly o Lifetime, las elimina. La página oficial de precios incluso lo indica en letra pequeña: se aplican tarifas de bolsa, compensación y de la NFA. Así que cuando su plan &ldquo;sin comisión&rdquo; o de comisión ultrabaja sigue costando dinero por operación, nada está fallando. Usted está pagando la parte de una operación de futuros que nunca desaparece. Presupueste entre 0,50 y 1,50 USD por round turn para ese concepto, y la sorpresa desaparece." },
    {
      type: "checklist",
      heading: "Respuesta rápida: lo que realmente paga por operación",
      items: [
        "<strong class='text-white'>Comisión</strong>, la parte del bróker. Es el único componente que cambian los planes Free / Monthly / Lifetime.",
        "<strong class='text-white'>Tarifa de bolsa</strong>, pagada a la bolsa (CME, CBOT, NYMEX, COMEX). La fija la bolsa, no el bróker.",
        "<strong class='text-white'>Tarifa de compensación</strong>, pagada a la firma de compensación que liquida la operación.",
        "<strong class='text-white'>Tarifa de la NFA</strong>, una pequeña evaluación regulatoria, cobrada por lado en cada contrato.",
        "<strong class='text-white'>La regla:</strong> las últimas tres son cargos que se trasladan directamente. Ningún nivel de plan puede eliminarlas, y se aplican en el momento en que se ejecuta una orden.",
      ],
    },
    { type: "heading", text: "Por qué un plan &ldquo;sin comisión&rdquo; sigue costando dinero" },
    { type: "paragraph", html: "Al marketing le encanta la frase &ldquo;sin comisión&rdquo;, y técnicamente es cierta en algunos niveles, pero solo describe el cargo propio del bróker. En una operación de futuros hay más de una parte con la mano extendida. La bolsa cobra una tarifa por emparejar su orden. La firma de compensación cobra una tarifa por liquidarla y garantizarla. La NFA impone una evaluación por lado a toda la industria. Su bróker las recauda en nombre de la bolsa y las traslada al costo. Por eso la letra pequeña de la página de precios dice &ldquo;se aplican tarifas de bolsa, compensación y de la NFA&rdquo; sin importar el plan que tenga." },
    { type: "paragraph", html: "Piénselo como una entrada de concierto. El nivel de plan es el descuento sobre el precio nominal de la entrada. Las tarifas de bolsa y compensación son los cargos del recinto y de procesamiento que se suman al pagar, y no puede evitarlos eligiendo otro nivel de entrada. La comisión baja de unos 1,29 USD por lado en el plan Free a bastante menos de un dólar en Lifetime, y eso es un ahorro real si opera con volumen. Pero la capa de bolsa y compensación que hay debajo no se mueve." },
    { type: "heading", text: "Qué es cada tarifa y quién la cobra" },
    { type: "heading", text: "La tarifa de bolsa" },
    { type: "paragraph", html: "Esta va a la bolsa que lista el contrato, CME para los futuros de índices bursátiles que más operan los traders minoristas (ES, NQ y sus micros), además de CBOT, NYMEX y COMEX para tasas, energía y metales. La bolsa fija el importe, lo publica y lo actualiza periódicamente. Los no miembros (es decir, usted, que opera a través de un bróker) pagan una tarifa más alta que los miembros de la bolsa. Se cobra por lado, así que la paga al entrar y otra vez al salir." },
    { type: "heading", text: "La tarifa de compensación" },
    { type: "paragraph", html: "Toda operación de futuros está garantizada por una cámara de compensación, y la firma de compensación que respalda su cuenta cobra una tarifa por ello. Suele ser pequeña y a veces está integrada en cómo el bróker presenta sus tarifas, pero existe en cada contrato y no forma parte de la comisión que se descuenta con un plan." },
    { type: "heading", text: "La tarifa de la NFA" },
    { type: "paragraph", html: "La National Futures Association cobra una evaluación por lado en las transacciones de futuros, entre una fracción de centavo y un par de centavos por lado, según el esquema vigente. Es diminuta por sí sola, pero se aplica en cada contrato, en ambos lados, siempre. Ha cambiado con los años, así que trate cualquier cifra concreta como una instantánea y verifique la tasa actual si está construyendo un modelo de costos preciso." },
    { type: "heading", text: "Cuánto presupuestar: las cifras que importan" },
    { type: "paragraph", html: "En los productos que realmente usa un day trader, presupueste alrededor de <strong class='text-white'>0,50 a 1,50 USD por round turn</strong> en tarifas de bolsa, compensación y de la NFA combinadas, además de la comisión. Dónde caiga dentro de esa banda depende por completo del contrato:" },
    {
      type: "table",
      headers: ["Tipo de contrato", "Ejemplos", "Bolsa + compensación + NFA (por round turn)"],
      rows: [
        ["Micro futuros", "MES, MNQ, MGC, MCL", "Extremo inferior de la banda, los más económicos para operar con frecuencia"],
        ["E-minis estándar", "ES, NQ", "Alrededor de 1,25 USD por round turn"],
        ["Otros minis", "CL, GC y similares", "Varía según el producto, verifique el contrato exacto"],
      ],
    },
    { type: "paragraph", html: "Dos cosas suelen confundir a la gente aquí. Primero, estas tarifas se cotizan <strong class='text-white'>por lado</strong> en la mayoría de los esquemas, así que un round turn es el doble de la cifra por lado, confirme siempre cuál de las dos está leyendo. Segundo, la tarifa de bolsa exacta cambia cuando la bolsa revisa su esquema (la CME ha ajustado tarifas recientemente este mismo año). El hábito más seguro: busque su contrato específico en el CME Non-Member Fee Finder, sume las partes de compensación y NFA, y duplique el resultado para obtener un round turn. Ese es su costo mínimo real antes de la comisión." },
    { type: "heading", text: "Cómo encontrar su costo real por operación, paso a paso" },
    { type: "heading", text: "Lea la tarifa real de una operación completada" },
