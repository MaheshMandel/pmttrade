---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "overcharts-no-tradovate-connection";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/debugging/${SLUG}`;

const META_TITLE = "Overcharts Has No Direct Tradovate Connection";
const META_DESCRIPTION =
  "No direct Tradovate option in Overcharts? Here's why the connection is missing and how to chart the same CME futures through a Rithmic feed instead.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Overcharts hat keine direkte Tradovate-Verbindung", es: "Overcharts no tiene conexión directa con Tradovate", fr: "Overcharts n'a pas de connexion directe à Tradovate", it: "Overcharts non ha una connessione diretta a Tradovate" },
  dek: { en: "You've scrolled the Overcharts connection list looking for Tradovate and it isn't there. Here's why, and the exact way to wire up a Rithmic connection so your charts fill with live futures data.", de: "Sie haben die Verbindungsliste von Overcharts nach Tradovate durchsucht, und es ist nicht da. Hier erfahren Sie, warum, und wie Sie eine Rithmic-Verbindung einrichten, damit Ihre Charts mit Live-Futures-Daten gefüllt werden.", es: "Ha recorrido la lista de conexiones de Overcharts buscando Tradovate y no está. Aquí le explicamos por qué y cómo configurar una conexión Rithmic para que sus gráficos se llenen con datos de futuros en vivo.", fr: "Vous avez parcouru la liste des connexions d'Overcharts à la recherche de Tradovate et il n'y figure pas. Voici pourquoi, et la marche exacte pour configurer une connexion Rithmic afin que vos graphiques se remplissent de données de contrats à terme en direct.", it: "Ha scorso l'elenco delle connessioni di Overcharts cercando Tradovate e non c'è. Ecco perché, e il modo esatto per configurare una connessione Rithmic in modo che i suoi grafici si riempiano di dati futures in tempo reale." },
  readTime: { en: "7 min read", de: "7 Min. Lesezeit", es: "Lectura de 7 min", fr: "Lecture : 7 min", it: "Lettura di 7 min" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "You've built your footprint and volume analysis in Overcharts, you've got a funded or personal Tradovate account for the actual trading, and now you're scrolling the Overcharts connection list looking for Tradovate. It isn't there. No Tradovate broker, no Tradovate data feed, no field to type your Tradovate login into. Here's the short version so you don't burn an afternoon on it: <strong class='text-white'>Overcharts has no direct Tradovate connection, and it never has.</strong> The fix isn't a buried setting or a plan upgrade. It's to feed Overcharts through Rithmic, the universal bridge Overcharts uses for brokers it doesn't name. Below is why the Tradovate option is missing, how to tell whether your account can even reach Overcharts, and the exact way to wire up a Rithmic connection so your charts fill with live futures data." },
    {
      type: "checklist",
      heading: "Quick Checklist for the Overcharts + Tradovate Problem",
      items: [
        "<strong class='text-white'>Stop searching for Tradovate in Overcharts.</strong> It's not listed as a broker or a data feed, and it isn't hidden behind a setting.",
        "<strong class='text-white'>Route through Rithmic instead.</strong> Overcharts connects to unlisted brokers through Rithmic, as long as your account can supply a Rithmic connection.",
        "<strong class='text-white'>Ask your broker or prop firm for Rithmic credentials</strong> (a separate username, password, and gateway). Availability varies by firm and account size, so confirm your firm's current options.",
        "<strong class='text-white'>The data feed is a separate subscription</strong> from Overcharts. Your broker or a data vendor supplies the Rithmic feed and its exchange fees; Overcharts is just the chart.",
        "<strong class='text-white'>Tradovate-only account with no Rithmic option?</strong> You can't route that account into Overcharts. Use Tradovate's own advanced charts, or add a standalone Rithmic feed for the charting side.",
        "<strong class='text-white'>You can still execute on Tradovate</strong> while you analyze in Overcharts. The charting connection and the order routing don't have to be the same account.",
      ],
    },
    { type: "heading", text: "What “No Direct Connection” Actually Means Here" },
    { type: "paragraph", html: "“No direct connection” doesn't mean something broke or you missed a checkbox. It means Overcharts was simply never built to talk to Tradovate. Overcharts reaches each broker or data vendor through a specific, named connection: CQG/StoneX, Rithmic, dxFeed, Interactive Brokers, TradeStation, Directa, Binance, Oanda, and a few others. Tradovate is not one of them. There's no adapter, no login screen, no data-feed entry waiting for your Tradovate details." },
    { type: "paragraph", html: "This isn't a version you can update past, either. A public request to add Tradovate has been sitting on Overcharts' own tracker since 2020 with no build behind it, so treating this as a “maybe the next release fixes it” situation will just cost you time. Tradovate support is not part of the platform today, full stop." },
    { type: "paragraph", html: "Here's the part that actually gets you charting: Overcharts openly supports any broker that offers a Rithmic connection, even one it doesn't list by name. Tradovate the platform won't hand you a Rithmic feed on its own, and the long-standing requests to add Rithmic data inside Tradovate itself have never shipped. But the brokerage or prop firm behind your account often can give you Rithmic access, because Rithmic and Tradovate are two separate connectivity layers that many futures firms run side by side." },
    { type: "heading", text: "Why the Tradovate Option Is Missing" },
    { type: "heading", text: "1. Overcharts Has No Tradovate Adapter" },
    { type: "paragraph", html: "This is the whole story in one line. Every connection in Overcharts is a purpose-built integration, and nobody built one for Tradovate. There's no “log in with Tradovate” mode because that code path doesn't exist. If you want your futures account in Overcharts, you connect it through one of the feeds Overcharts does support, and for a Tradovate-linked account that means Rithmic." },
    { type: "heading", text: "2. Rithmic and Tradovate Are Separate Layers" },
    { type: "paragraph", html: "A lot of people assume that because their account “runs on Tradovate,” any Rithmic option must flow through Tradovate too. It doesn't. Rithmic is its own low-latency futures connectivity provider, and Tradovate is a separate platform and brokerage stack. A firm can offer you one, the other, or both. Tradovate does not expose a Rithmic feed of its own, so the Rithmic credentials you need come from your broker or prop firm's back office, not from inside the Tradovate app." },
    { type: "heading", text: "3. Your Tradovate Login Won't Authenticate" },
    { type: "paragraph", html: "Even if you tried to force it, your Tradovate username and password have nowhere to go in Overcharts. There's no field that expects Tradovate credentials, so pasting them into the Rithmic dialog won't work. Rithmic connections use Rithmic-issued credentials, which are a different set of details entirely from your Tradovate platform login." },
    { type: "heading", text: "4. Your Firm Might Be Tradovate-Only" },
    { type: "paragraph", html: "Some brokers and prop firms provision only a Tradovate connection and never issue Rithmic access. If that's your situation, there is no combination of settings that routes that exact account into Overcharts, because neither side offers the bridge. Whether Rithmic is available depends on the firm and often the account size or plan, so it's worth asking rather than guessing." },
    { type: "heading", text: "5. The Data Feed Is Its Own Cost" },
    { type: "paragraph", html: "Overcharts is the charting software; the live market data is separate. Your Rithmic feed and its exchange fees come from your broker or a data vendor, not bundled into the Overcharts subscription. If your charts stay empty after you connect, an unpaid or unsigned data subscription is a common reason, not a connection bug." },
    { type: "heading", text: "How to Fix the Overcharts + Tradovate Setup in 2026: Step-by-Step" },
    { type: "heading", text: "Option A: Get Rithmic Credentials for Your Account (Recommended)" },
    { type: "paragraph", html: "This is the clean path when you want your futures account inside Overcharts. You're not connecting Tradovate; you're getting a Rithmic connection for the same trading account." },
    {
      type: "steps",
      items: [
        { title: "Ask your broker or prop firm about Rithmic access", html: "Ask whether they offer <strong class='text-white'>Rithmic access</strong> alongside Tradovate. Many futures brokers and some prop firms do, but it varies by firm and account size, so confirm your firm's current rules." },
        { title: "Request your Rithmic credentials", html: "Get the username, the password, and the gateway or system name they want you to connect to. Remember that Rithmic does not sell directly to end users, so these always come from your broker or a data vendor." },
        { title: "Sign any required market-data agreements", html: "Typically the CME non-professional or professional forms. Unsigned agreements are a frequent reason a fresh Rithmic login connects but shows no quotes." },
        { title: "Decide demo or live", html: "Decide whether you need a <strong class='text-white'>demo</strong> feed for testing or a <strong class='text-white'>live</strong> feed for real charts, and get the matching credentials, since paper and live use different gateways." },
      ],
    },
    { type: "heading", text: "Option B: Connect Rithmic Inside Overcharts" },
    { type: "paragraph", html: "Once you have the credentials, the setup itself takes a couple of minutes." },
    {
      type: "steps",
      items: [
        { title: "Open the Connections tab", html: "Open Overcharts and go to the <strong class='text-white'>Connections</strong> tab in the main window." },
        { title: "Edit the Rithmic connection", html: "Select the <strong class='text-white'>Rithmic</strong> connection, right-click it, and choose <strong class='text-white'>Edit</strong> to open the configuration window." },
        { title: "Enter your Rithmic credentials", html: "Enter the <strong class='text-white'>username and password you got from your broker or data feed</strong>, not your Overcharts login. Watch for capitalization and stray spaces, which quietly break the login." },
        { title: "Choose the right gateway", html: "Choose the connection point that matches your account: the <strong class='text-white'>demo gateway</strong> (labeled along the lines of “Rithmic Paper Trading”) for a paper account, or the <strong class='text-white'>live gateway</strong> (labeled along the lines of “Rithmic 01”) for a funded account. Confirm the exact label with your broker, since the recommended server can differ by region." },
        { title: "Save and connect", html: "Save with <strong class='text-white'>OK</strong>, then start the feed by pressing <strong class='text-white'>Connect</strong> or double-clicking the connection. When the status indicators turn green, your data is live and you can drop a futures symbol onto a chart." },
      ],
    },
    { type: "heading", text: "Option C: If Your Firm Is Tradovate-Only" },
    { type: "paragraph", html: "When your account genuinely has no Rithmic path, you have two honest options instead of fighting a connection that doesn't exist." },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Chart that account in Tradovate's own advanced charts.</strong> It won't give you Overcharts' footprint tooling, but it keeps your data and orders on one connection with no extra feed to buy.",
        "<strong class='text-white'>Subscribe to a separate Rithmic data feed just for Overcharts.</strong> You'd pay for a standalone Rithmic feed purely to power the charts, then keep executing on your Tradovate account through its own route. The symbols line up because they're the same CME futures; only the plumbing differs.",
      ],
    },
    { type: "heading", text: "Troubleshooting Table" },
    {
      type: "table",
      headers: ["What you see", "What it means", "Fix"],
      rows: [
        ["No Tradovate entry anywhere in Overcharts' connections", "Overcharts has no Tradovate adapter, and it isn't hidden", "Connect through Rithmic instead; get Rithmic credentials for your account"],
        ["Your Tradovate username and password are rejected", "Overcharts has no field for Tradovate logins; Rithmic uses different credentials", "Use the Rithmic username and password issued by your broker, not your Tradovate login"],
        ["Your firm can't give you Rithmic access", "The account is Tradovate-only, so there's no bridge to Overcharts", "Chart in Tradovate's own charts, or add a standalone Rithmic data feed for Overcharts"],
        ["Rithmic connects but no quotes appear", "Data-feed subscription or exchange agreement isn't active", "Sign the CME market-data agreements and confirm the feed is paid and enabled"],
        ["Login fails with the right-looking credentials", "Capitalization, extra spaces, or the wrong gateway (demo vs live)", "Retype the credentials carefully and select the connection point that matches your account type"],
        ["Charts load but you want automated Tradovate execution", "Overcharts charts your data; it isn't an order-routing bridge to Tradovate", "Keep Overcharts for analysis and automate Tradovate orders from TradingView alerts"],
      ],
    },
    { type: "heading", text: "Keep Analysis and Execution Cleanly Separated With PickMyTrade" },
    { type: "paragraph", html: "The reason this trips people up is that they're trying to make one app do two jobs: chart the market and get orders onto Tradovate. Those don't have to live on the same connection. Read your order flow and footprint in Overcharts through Rithmic, and let a dedicated bridge handle the execution so your fills never hinge on which charting app you happen to be using:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Alerts Straight to Tradovate</strong>, PickMyTrade takes your TradingView alerts and routes them to your Tradovate account, no charting app in the order path.",
        "<strong class='text-white'>Chart Where You Like</strong>, keep Overcharts for the analysis it's good at while your entries and exits fire automatically through a purpose-built bridge.",
        "<strong class='text-white'>Environment and Account Mapping</strong>, point each strategy at the correct Tradovate account and environment so live and simulation don't get crossed.",
        "<strong class='text-white'>Multi-Account Sync</strong>, mirror the same order across several Tradovate accounts at once without extra desktop plumbing.",
      ],
    },
  ], de: [
    { type: "paragraph",html: "Sie haben Ihre Footprint- und Volumenanalyse in Overcharts aufgebaut, Sie haben ein finanziertes oder persönliches Tradovate-Konto für den eigentlichen Handel, und nun durchsuchen Sie die Verbindungsliste von Overcharts nach Tradovate. Es ist nicht da. Kein Tradovate-Broker, kein Tradovate-Datenfeed, kein Feld, in das Sie Ihr Tradovate-Login eintragen könnten. Hier die Kurzfassung, damit Sie keinen Nachmittag damit verschwenden: <strong class='text-white'>Overcharts hat keine direkte Tradovate-Verbindung und hatte nie eine.</strong> Die Lösung ist keine versteckte Einstellung und kein Plan-Upgrade. Sie besteht darin, Overcharts über Rithmic zu speisen, die universelle Brücke, die Overcharts für Broker nutzt, die es nicht namentlich nennt. Unten finden Sie, warum die Tradovate-Option fehlt, woran Sie erkennen, ob Ihr Konto Overcharts überhaupt erreichen kann, und wie Sie eine Rithmic-Verbindung genau einrichten, damit Ihre Charts mit Live-Futures-Daten gefüllt werden." },
    {
      type: "checklist",
      heading: "Kurz-Checkliste für das Problem Overcharts + Tradovate",
      items: [
        "<strong class='text-white'>Hören Sie auf, in Overcharts nach Tradovate zu suchen.</strong> Es ist weder als Broker noch als Datenfeed aufgeführt und auch nicht hinter einer Einstellung versteckt.",
        "<strong class='text-white'>Leiten Sie stattdessen über Rithmic.</strong> Overcharts verbindet sich mit nicht aufgeführten Brokern über Rithmic, solange Ihr Konto eine Rithmic-Verbindung bereitstellen kann.",
        "<strong class='text-white'>Fragen Sie Ihren Broker oder Ihre Prop-Firma nach Rithmic-Zugangsdaten</strong> (ein separater Benutzername, ein Passwort und ein Gateway). Die Verfügbarkeit variiert je nach Firma und Kontogröße; bestätigen Sie daher die aktuellen Optionen Ihrer Firma.",
        "<strong class='text-white'>Der Datenfeed ist ein separates Abonnement</strong> neben Overcharts. Ihr Broker oder ein Datenanbieter liefert den Rithmic-Feed und dessen Börsengebühren; Overcharts ist nur der Chart.",
        "<strong class='text-white'>Nur-Tradovate-Konto ohne Rithmic-Option?</strong> Dann können Sie dieses Konto nicht in Overcharts leiten. Nutzen Sie die erweiterten Charts von Tradovate selbst oder fügen Sie für die Chart-Seite einen eigenständigen Rithmic-Feed hinzu.",
        "<strong class='text-white'>Sie können weiterhin über Tradovate ausführen</strong>, während Sie in Overcharts analysieren. Chart-Verbindung und Order-Routing müssen nicht dasselbe Konto sein.",
      ],
    },
    { type: "heading",text: "Was „keine direkte Verbindung“ hier tatsächlich bedeutet" },
    { type: "paragraph",html: "„Keine direkte Verbindung“ bedeutet nicht, dass etwas kaputtgegangen ist oder Sie ein Häkchen übersehen haben. Es bedeutet, dass Overcharts schlicht nie dafür gebaut wurde, mit Tradovate zu kommunizieren. Overcharts erreicht jeden Broker oder Datenanbieter über eine bestimmte, benannte Verbindung: CQG/StoneX, Rithmic, dxFeed, Interactive Brokers, TradeStation, Directa, Binance, Oanda und einige weitere. Tradovate gehört nicht dazu. Es gibt keinen Adapter, keinen Login-Bildschirm und keinen Datenfeed-Eintrag, der auf Ihre Tradovate-Daten wartet." },
    { type: "paragraph",html: "Auch das ist keine Version, die Sie mit einem Update überholen könnten. Eine öffentliche Anfrage, Tradovate hinzuzufügen, liegt seit 2020 im eigenen Tracker von Overcharts, ohne dass etwas gebaut wurde; wenn Sie das als „vielleicht behebt es das nächste Release“ betrachten, kostet Sie das nur Zeit. Tradovate-Unterstützung ist heute nicht Teil der Plattform, Punkt." },
    { type: "paragraph",html: "Und hier der Teil, der Sie tatsächlich zum Charting bringt: Overcharts unterstützt offen jeden Broker, der eine Rithmic-Verbindung anbietet, auch wenn es ihn nicht namentlich aufführt. Die Tradovate-Plattform selbst liefert Ihnen von sich aus keinen Rithmic-Feed, und die seit Langem bestehenden Anfragen, Rithmic-Daten in Tradovate selbst anzubieten, sind nie umgesetzt worden. Aber der Broker oder die Prop-Firma hinter Ihrem Konto kann Ihnen oft Rithmic-Zugang geben, weil Rithmic und Tradovate zwei getrennte Konnektivitätsschichten sind, die viele Futures-Firmen nebeneinander betreiben." },
    { type: "heading",text: "Warum die Tradovate-Option fehlt" },
    { type: "heading",text: "1. Overcharts hat keinen Tradovate-Adapter" },
    { type: "paragraph",html: "Das ist die ganze Geschichte in einer Zeile. Jede Verbindung in Overcharts ist eine eigens gebaute Integration, und für Tradovate hat niemand eine gebaut. Es gibt keinen Modus „Mit Tradovate anmelden“, weil dieser Codepfad nicht existiert. Wenn Sie Ihr Futures-Konto in Overcharts haben möchten, verbinden Sie es über einen der von Overcharts unterstützten Feeds, und für ein mit Tradovate verknüpftes Konto bedeutet das Rithmic." },
    { type: "heading",text: "2. Rithmic und Tradovate sind getrennte Schichten" },
    { type: "paragraph",html: "Viele nehmen an, dass jede Rithmic-Option über Tradovate laufen müsse, nur weil ihr Konto „auf Tradovate läuft“. Das tut sie nicht. Rithmic ist ein eigener Konnektivitätsanbieter für Futures mit niedriger Latenz, und Tradovate ist eine separate Plattform mit eigenem Brokerage-Stack. Eine Firma kann Ihnen das eine, das andere oder beides anbieten. Tradovate stellt keinen eigenen Rithmic-Feed bereit, die benötigten Rithmic-Zugangsdaten kommen daher aus dem Back-Office Ihres Brokers oder Ihrer Prop-Firma, nicht aus der Tradovate-App." },
    { type: "heading",text: "3. Ihr Tradovate-Login wird nicht authentifiziert" },
    { type: "paragraph",html: "Selbst wenn Sie es erzwingen wollten, haben Ihr Tradovate-Benutzername und -Passwort in Overcharts keinen Ort, an dem sie hinkönnten. Es gibt kein Feld, das Tradovate-Zugangsdaten erwartet, daher funktioniert es nicht, sie in den Rithmic-Dialog einzufügen. Rithmic-Verbindungen verwenden von Rithmic ausgestellte Zugangsdaten, die ein völlig anderer Satz von Angaben sind als Ihr Tradovate-Plattform-Login." },
    { type: "heading",text: "4. Ihre Firma ist möglicherweise ausschließlich auf Tradovate ausgerichtet" },
    { type: "paragraph",html: "Manche Broker und Prop-Firmen stellen nur eine Tradovate-Verbindung bereit und geben nie Rithmic-Zugang aus. Ist das bei Ihnen der Fall, gibt es keine Kombination von Einstellungen, die genau dieses Konto in Overcharts leitet, weil keine Seite die Brücke anbietet. Ob Rithmic verfügbar ist, hängt von der Firma und oft von Kontogröße oder Plan ab; fragen Sie also nach, statt zu raten." },
    { type: "heading",text: "5. Der Datenfeed hat eigene Kosten" },
    { type: "paragraph",html: "Overcharts ist die Charting-Software; die Live-Marktdaten sind separat. Ihr Rithmic-Feed und dessen Börsengebühren kommen von Ihrem Broker oder einem Datenanbieter und sind nicht im Overcharts-Abonnement enthalten. Bleiben Ihre Charts nach dem Verbinden leer, ist ein nicht bezahltes oder nicht unterzeichnetes Datenabonnement ein häufiger Grund, kein Verbindungsfehler." },
    { type: "heading",text: "So beheben Sie das Setup Overcharts + Tradovate 2026: Schritt für Schritt" },
    { type: "heading",text: "Option A: Rithmic-Zugangsdaten für Ihr Konto besorgen (empfohlen)" },
    { type: "paragraph",html: "Das ist der saubere Weg, wenn Sie Ihr Futures-Konto in Overcharts haben möchten. Sie verbinden nicht Tradovate, sondern besorgen sich eine Rithmic-Verbindung für dasselbe Handelskonto." },
    {
      type: "steps",
      items: [
        { title: "Fragen Sie Ihren Broker oder Ihre Prop-Firma nach Rithmic-Zugang", html: "Fragen Sie, ob neben Tradovate auch <strong class='text-white'>Rithmic-Zugang</strong> angeboten wird. Viele Futures-Broker und einige Prop-Firmen tun das, es variiert jedoch je nach Firma und Kontogröße; bestätigen Sie daher die aktuellen Regeln Ihrer Firma." },
        { title: "Fordern Sie Ihre Rithmic-Zugangsdaten an", html: "Besorgen Sie sich den Benutzernamen, das Passwort und den Gateway- oder Systemnamen, mit dem Sie sich verbinden sollen. Denken Sie daran, dass Rithmic nicht direkt an Endnutzer verkauft; diese Angaben kommen also immer von Ihrem Broker oder einem Datenanbieter." },
        { title: "Unterzeichnen Sie erforderliche Marktdatenvereinbarungen", html: "In der Regel die CME-Formulare für nicht-professionelle oder professionelle Nutzer. Nicht unterzeichnete Vereinbarungen sind ein häufiger Grund, warum sich ein frisches Rithmic-Login verbindet, aber keine Kurse anzeigt." },
        { title: "Entscheiden Sie sich für Demo oder Live", html: "Entscheiden Sie, ob Sie einen <strong class='text-white'>Demo</strong>-Feed zum Testen oder einen <strong class='text-white'>Live</strong>-Feed für echte Charts benötigen, und besorgen Sie die passenden Zugangsdaten, da Paper- und Live-Konten unterschiedliche Gateways verwenden." },
      ],
    },
    { type: "heading",text: "Option B: Rithmic in Overcharts verbinden" },
    { type: "paragraph",html: "Sobald Sie die Zugangsdaten haben, dauert die Einrichtung selbst nur ein paar Minuten." },
    {
      type: "steps",
      items: [
        { title: "Öffnen Sie den Reiter Connections", html: "Öffnen Sie Overcharts und wechseln Sie im Hauptfenster zum Reiter <strong class='text-white'>Connections</strong>." },
        { title: "Bearbeiten Sie die Rithmic-Verbindung", html: "Wählen Sie die Verbindung <strong class='text-white'>Rithmic</strong> aus, klicken Sie mit der rechten Maustaste darauf und wählen Sie <strong class='text-white'>Edit</strong>, um das Konfigurationsfenster zu öffnen." },
        { title: "Geben Sie Ihre Rithmic-Zugangsdaten ein", html: "Geben Sie den <strong class='text-white'>Benutzernamen und das Passwort ein, die Sie von Ihrem Broker oder Datenfeed erhalten haben</strong>, nicht Ihr Overcharts-Login. Achten Sie auf Groß- und Kleinschreibung sowie überzählige Leerzeichen, die das Login stillschweigend zum Scheitern bringen." },
        { title: "Wählen Sie das richtige Gateway", html: "Wählen Sie den zu Ihrem Konto passenden Verbindungspunkt: das <strong class='text-white'>Demo-Gateway</strong> (etwa mit der Bezeichnung „Rithmic Paper Trading“) für ein Paper-Konto oder das <strong class='text-white'>Live-Gateway</strong> (etwa mit der Bezeichnung „Rithmic 01“) für ein finanziertes Konto. Lassen Sie sich die genaue Bezeichnung von Ihrem Broker bestätigen, da der empfohlene Server je nach Region abweichen kann." },
        { title: "Speichern und verbinden", html: "Speichern Sie mit <strong class='text-white'>OK</strong> und starten Sie dann den Feed, indem Sie auf <strong class='text-white'>Connect</strong> klicken oder die Verbindung doppelklicken. Wenn die Statusanzeigen grün werden, sind Ihre Daten live, und Sie können ein Futures-Symbol auf einen Chart ziehen." },
      ],
    },
    { type: "heading",text: "Option C: Wenn Ihre Firma ausschließlich auf Tradovate ausgerichtet ist" },
    { type: "paragraph",html: "Hat Ihr Konto tatsächlich keinen Rithmic-Pfad, haben Sie zwei ehrliche Optionen, statt gegen eine Verbindung zu kämpfen, die es nicht gibt." },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Charten Sie dieses Konto in den erweiterten Charts von Tradovate selbst.</strong> Sie erhalten dort nicht die Footprint-Werkzeuge von Overcharts, aber Daten und Orders bleiben auf einer Verbindung, ohne dass ein zusätzlicher Feed gekauft werden muss.",
        "<strong class='text-white'>Abonnieren Sie einen separaten Rithmic-Datenfeed nur für Overcharts.</strong> Sie würden für einen eigenständigen Rithmic-Feed ausschließlich zur Versorgung der Charts zahlen und weiterhin über Ihr Tradovate-Konto auf dessen eigenem Weg ausführen. Die Symbole passen zusammen, weil es dieselben CME-Futures sind; nur die Leitungen unterscheiden sich.",
      ],
    },
    { type: "heading",text: "Fehlerbehebungstabelle" },
    { type: "table", headers: ["Was Sie sehen","Was es bedeutet","Lösung"], rows: [
      ["Kein Tradovate-Eintrag in den Verbindungen von Overcharts","Overcharts hat keinen Tradovate-Adapter, und er ist nicht versteckt","Über Rithmic verbinden; Rithmic-Zugangsdaten für Ihr Konto besorgen"],
      ["Ihr Tradovate-Benutzername und -Passwort werden abgelehnt","Overcharts hat kein Feld für Tradovate-Logins; Rithmic verwendet andere Zugangsdaten","Verwenden Sie den von Ihrem Broker ausgestellten Rithmic-Benutzernamen und das Rithmic-Passwort, nicht Ihr Tradovate-Login"],
      ["Ihre Firma kann Ihnen keinen Rithmic-Zugang geben","Das Konto ist ausschließlich auf Tradovate ausgerichtet, daher gibt es keine Brücke zu Overcharts","In den Charts von Tradovate selbst charten oder einen eigenständigen Rithmic-Datenfeed für Overcharts hinzufügen"],
      ["Rithmic verbindet sich, aber es erscheinen keine Kurse","Datenfeed-Abonnement oder Börsenvereinbarung ist nicht aktiv","CME-Marktdatenvereinbarungen unterzeichnen und bestätigen, dass der Feed bezahlt und aktiviert ist"],
      ["Login schlägt mit scheinbar richtigen Zugangsdaten fehl","Groß-/Kleinschreibung, überzählige Leerzeichen oder falsches Gateway (Demo vs. Live)","Zugangsdaten sorgfältig neu eingeben und den zu Ihrem Kontotyp passenden Verbindungspunkt wählen"],
      ["Charts laden, aber Sie möchten automatisierte Tradovate-Ausführung","Overcharts chartet Ihre Daten; es ist keine Order-Routing-Brücke zu Tradovate","Overcharts für die Analyse behalten und Tradovate-Orders aus TradingView-Alerts automatisieren"],
    ] },
    { type: "heading",text: "Analyse und Ausführung sauber trennen mit PickMyTrade" },
    { type: "paragraph",html: "Der Grund, warum das so viele stolpern lässt, ist, dass sie versuchen, eine App zwei Aufgaben erledigen zu lassen: den Markt zu charten und Orders an Tradovate zu bringen. Diese müssen nicht auf derselben Verbindung leben. Lesen Sie Ihren Orderflow und Ihren Footprint in Overcharts über Rithmic und überlassen Sie die Ausführung einer dedizierten Brücke, damit Ihre Ausführungen nie davon abhängen, welche Chart-App Sie gerade nutzen:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Alerts direkt an Tradovate</strong>, PickMyTrade nimmt Ihre TradingView-Alerts und leitet sie an Ihr Tradovate-Konto, ohne Chart-App im Order-Pfad.",
        "<strong class='text-white'>Chart dort, wo Sie möchten</strong>, behalten Sie Overcharts für die Analyse, für die es gut ist, während Ihre Einstiege und Ausstiege automatisch über eine eigens dafür gebaute Brücke ausgelöst werden.",
        "<strong class='text-white'>Umgebungs- und Kontozuordnung</strong>, weisen Sie jede Strategie dem richtigen Tradovate-Konto und der richtigen Umgebung zu, damit Live und Simulation nicht vermischt werden.",
        "<strong class='text-white'>Multi-Account-Synchronisierung</strong>, spiegeln Sie dieselbe Order auf mehrere Tradovate-Konten gleichzeitig, ohne zusätzliche Desktop-Installation.",
      ],
    },
  ], es: [
    { type: "paragraph",html: "Ha construido su análisis de footprint y volumen en Overcharts, tiene una cuenta de Tradovate fondeada o personal para operar de verdad, y ahora recorre la lista de conexiones de Overcharts buscando Tradovate. No está. Ni broker de Tradovate, ni feed de datos de Tradovate, ni un campo donde escribir su inicio de sesión de Tradovate. Aquí va la versión corta para que no pierda una tarde con esto: <strong class='text-white'>Overcharts no tiene conexión directa con Tradovate y nunca la ha tenido.</strong> La solución no es un ajuste escondido ni una mejora de plan. Es alimentar Overcharts a través de Rithmic, el puente universal que Overcharts usa para los brokers que no nombra. A continuación verá por qué falta la opción de Tradovate, cómo saber si su cuenta puede siquiera llegar a Overcharts y la forma exacta de configurar una conexión Rithmic para que sus gráficos se llenen con datos de futuros en vivo." },
    {
      type: "checklist",
      heading: "Lista rápida para el problema de Overcharts + Tradovate",
      items: [
        "<strong class='text-white'>Deje de buscar Tradovate en Overcharts.</strong> No figura como broker ni como feed de datos, y no está oculto tras ningún ajuste.",
        "<strong class='text-white'>Enrute a través de Rithmic.</strong> Overcharts se conecta a brokers no listados mediante Rithmic, siempre que su cuenta pueda aportar una conexión Rithmic.",
        "<strong class='text-white'>Pida a su broker o prop firm las credenciales de Rithmic</strong> (un usuario, una contraseña y un gateway aparte). La disponibilidad varía según la firma y el tamaño de la cuenta, así que confirme las opciones vigentes de su firma.",
        "<strong class='text-white'>El feed de datos es una suscripción aparte</strong> de Overcharts. Su broker o un proveedor de datos suministra el feed de Rithmic y sus tarifas de bolsa; Overcharts es solo el gráfico.",
        "<strong class='text-white'>¿Cuenta solo Tradovate sin opción de Rithmic?</strong> No puede enrutar esa cuenta a Overcharts. Use los gráficos avanzados de la propia Tradovate o añada un feed de Rithmic independiente para la parte de gráficos.",
        "<strong class='text-white'>Aún puede ejecutar en Tradovate</strong> mientras analiza en Overcharts. La conexión de gráficos y el enrutamiento de órdenes no tienen que ser la misma cuenta.",
      ],
    },
    { type: "heading",text: "Qué significa realmente aquí «sin conexión directa»" },
    { type: "paragraph",html: "«Sin conexión directa» no significa que algo se haya roto ni que se le haya pasado una casilla. Significa que Overcharts simplemente nunca se construyó para comunicarse con Tradovate. Overcharts llega a cada broker o proveedor de datos mediante una conexión específica y con nombre: CQG/StoneX, Rithmic, dxFeed, Interactive Brokers, TradeStation, Directa, Binance, Oanda y algunas más. Tradovate no es una de ellas. No hay adaptador, ni pantalla de inicio de sesión, ni entrada de feed de datos esperando sus datos de Tradovate." },
    { type: "paragraph",html: "Tampoco es una versión que pueda superar actualizando. Una solicitud pública para añadir Tradovate lleva en el propio rastreador de Overcharts desde 2020 sin que nadie la haya desarrollado, de modo que tratarlo como un «quizá lo arregle la próxima versión» solo le hará perder tiempo. La compatibilidad con Tradovate no forma parte de la plataforma hoy, y punto." },
    { type: "paragraph",html: "Y esta es la parte que de verdad le permite graficar: Overcharts admite abiertamente cualquier broker que ofrezca una conexión Rithmic, aunque no lo nombre en la lista. La plataforma Tradovate no le dará por sí sola un feed de Rithmic, y las solicitudes de larga data para añadir datos de Rithmic dentro de la propia Tradovate nunca se han materializado. Pero el bróker o la prop firm detrás de su cuenta a menudo sí puede darle acceso a Rithmic, porque Rithmic y Tradovate son dos capas de conectividad independientes que muchas firmas de futuros operan en paralelo." },
    { type: "heading",text: "Por qué falta la opción de Tradovate" },
    { type: "heading",text: "1. Overcharts no tiene adaptador de Tradovate" },
    { type: "paragraph",html: "Esta es toda la historia en una línea. Cada conexión de Overcharts es una integración construida a propósito, y nadie construyó una para Tradovate. No existe un modo «iniciar sesión con Tradovate» porque esa ruta de código no existe. Si quiere su cuenta de futuros en Overcharts, la conecta a través de uno de los feeds que Overcharts sí admite, y para una cuenta vinculada a Tradovate eso significa Rithmic." },
    { type: "heading",text: "2. Rithmic y Tradovate son capas independientes" },
    { type: "paragraph",html: "Mucha gente supone que, como su cuenta «funciona sobre Tradovate», cualquier opción de Rithmic debe pasar también por Tradovate. No es así. Rithmic es un proveedor propio de conectividad de futuros de baja latencia, y Tradovate es una plataforma y una pila de corretaje independientes. Una firma puede ofrecerle una, la otra o ambas. Tradovate no expone un feed de Rithmic propio, por lo que las credenciales de Rithmic que necesita provienen del back office de su broker o prop firm, no de dentro de la aplicación de Tradovate." },
    { type: "heading",text: "3. Su inicio de sesión de Tradovate no se autenticará" },
    { type: "paragraph",html: "Aunque intentara forzarlo, su usuario y contraseña de Tradovate no tienen dónde ir en Overcharts. No hay ningún campo que espere credenciales de Tradovate, así que pegarlas en el cuadro de diálogo de Rithmic no funcionará. Las conexiones Rithmic usan credenciales emitidas por Rithmic, que son un conjunto de datos totalmente distinto de su inicio de sesión en la plataforma Tradovate." },
    { type: "heading",text: "4. Su firma podría ser solo Tradovate" },
    { type: "paragraph",html: "Algunos brokers y prop firms solo aprovisionan una conexión Tradovate y nunca emiten acceso a Rithmic. Si es su caso, no existe ninguna combinación de ajustes que enrute esa cuenta exacta a Overcharts, porque ninguna de las partes ofrece el puente. Que Rithmic esté disponible depende de la firma y a menudo del tamaño de la cuenta o del plan, así que conviene preguntar en lugar de suponer." },
    { type: "heading",text: "5. El feed de datos tiene su propio coste" },
    { type: "paragraph",html: "Overcharts es el software de gráficos; los datos de mercado en vivo son aparte. Su feed de Rithmic y sus tarifas de bolsa proceden de su broker o de un proveedor de datos, y no vienen incluidos en la suscripción a Overcharts. Si sus gráficos siguen vacíos tras conectar, una suscripción de datos sin pagar o sin firmar es una razón común, no un error de conexión." },
    { type: "heading",text: "Cómo arreglar la configuración de Overcharts + Tradovate en 2026: paso a paso" },
    { type: "heading",text: "Opción A: obtenga credenciales de Rithmic para su cuenta (recomendada)" },
    { type: "paragraph",html: "Este es el camino limpio cuando quiere su cuenta de futuros dentro de Overcharts. No está conectando Tradovate; está obteniendo una conexión Rithmic para la misma cuenta de trading." },
    {
      type: "steps",
      items: [
        { title: "Pregunte a su broker o prop firm por el acceso a Rithmic", html: "Pregunte si ofrecen <strong class='text-white'>acceso a Rithmic</strong> además de Tradovate. Muchos brokers de futuros y algunas prop firms lo hacen, pero varía según la firma y el tamaño de la cuenta, así que confirme las reglas vigentes de su firma." },
        { title: "Solicite sus credenciales de Rithmic", html: "Obtenga el usuario, la contraseña y el nombre del gateway o sistema al que quieren que se conecte. Recuerde que Rithmic no vende directamente a usuarios finales, por lo que estas credenciales siempre provienen de su broker o de un proveedor de datos." },
        { title: "Firme los acuerdos de datos de mercado necesarios", html: "Normalmente los formularios de CME para no profesionales o profesionales. Los acuerdos sin firmar son una razón frecuente de que un inicio de sesión nuevo de Rithmic se conecte pero no muestre cotizaciones." },
        { title: "Decida entre demo o live", html: "Decida si necesita un feed <strong class='text-white'>demo</strong> para pruebas o un feed <strong class='text-white'>live</strong> para gráficos reales, y obtenga las credenciales correspondientes, ya que simulación y real usan gateways distintos." },
      ],
    },
    { type: "heading",text: "Opción B: conecte Rithmic dentro de Overcharts" },
    { type: "paragraph",html: "Una vez que tenga las credenciales, la configuración en sí lleva un par de minutos." },
    {
      type: "steps",
      items: [
        { title: "Abra la pestaña Connections", html: "Abra Overcharts y vaya a la pestaña <strong class='text-white'>Connections</strong> de la ventana principal." },
        { title: "Edite la conexión Rithmic", html: "Seleccione la conexión <strong class='text-white'>Rithmic</strong>, haga clic derecho sobre ella y elija <strong class='text-white'>Edit</strong> para abrir la ventana de configuración." },
        { title: "Introduzca sus credenciales de Rithmic", html: "Introduzca el <strong class='text-white'>usuario y la contraseña que obtuvo de su broker o del feed de datos</strong>, no su inicio de sesión de Overcharts. Cuidado con las mayúsculas y los espacios sobrantes, que rompen el inicio de sesión sin avisar." },
        { title: "Elija el gateway correcto", html: "Elija el punto de conexión que corresponda a su cuenta: el <strong class='text-white'>gateway demo</strong> (con una etiqueta del estilo «Rithmic Paper Trading») para una cuenta de simulación, o el <strong class='text-white'>gateway live</strong> (con una etiqueta del estilo «Rithmic 01») para una cuenta fondeada. Confirme la etiqueta exacta con su broker, ya que el servidor recomendado puede variar según la región." },
        { title: "Guarde y conecte", html: "Guarde con <strong class='text-white'>OK</strong> y luego inicie el feed pulsando <strong class='text-white'>Connect</strong> o haciendo doble clic en la conexión. Cuando los indicadores de estado se pongan en verde, sus datos están activos y puede arrastrar un símbolo de futuros a un gráfico." },
      ],
    },
    { type: "heading",text: "Opción C: si su firma es solo Tradovate" },
    { type: "paragraph",html: "Cuando su cuenta realmente no tiene vía a Rithmic, tiene dos opciones honestas en lugar de pelear con una conexión que no existe." },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Grafique esa cuenta en los gráficos avanzados de la propia Tradovate.</strong> No le dará las herramientas de footprint de Overcharts, pero mantiene sus datos y órdenes en una sola conexión sin ningún feed adicional que comprar.",
        "<strong class='text-white'>Suscríbase a un feed de datos de Rithmic independiente solo para Overcharts.</strong> Pagaría un feed de Rithmic autónomo únicamente para alimentar los gráficos y seguiría ejecutando en su cuenta de Tradovate por su propia vía. Los símbolos coinciden porque son los mismos futuros de CME; solo cambia la instalación.",
      ],
    },
    { type: "heading",text: "Tabla de solución de problemas" },
    { type: "table", headers: ["Lo que ve","Qué significa","Solución"], rows: [
      ["Ninguna entrada de Tradovate en las conexiones de Overcharts","Overcharts no tiene adaptador de Tradovate, y no está oculto","Conecte a través de Rithmic; obtenga credenciales de Rithmic para su cuenta"],
      ["Se rechazan su usuario y contraseña de Tradovate","Overcharts no tiene campo para inicios de sesión de Tradovate; Rithmic usa otras credenciales","Use el usuario y la contraseña de Rithmic emitidos por su broker, no su inicio de sesión de Tradovate"],
      ["Su firma no puede darle acceso a Rithmic","La cuenta es solo Tradovate, por lo que no hay puente a Overcharts","Grafique en los gráficos de la propia Tradovate o añada un feed de datos de Rithmic independiente para Overcharts"],
      ["Rithmic se conecta pero no aparecen cotizaciones","La suscripción al feed de datos o el acuerdo con la bolsa no está activo","Firme los acuerdos de datos de mercado de CME y confirme que el feed está pagado y habilitado"],
      ["El inicio de sesión falla con credenciales aparentemente correctas","Mayúsculas, espacios sobrantes o gateway equivocado (demo frente a live)","Vuelva a escribir las credenciales con cuidado y seleccione el punto de conexión que corresponda a su tipo de cuenta"],
      ["Los gráficos cargan pero quiere ejecución automatizada en Tradovate","Overcharts grafica sus datos; no es un puente de enrutamiento de órdenes a Tradovate","Conserve Overcharts para el análisis y automatice las órdenes de Tradovate desde alertas de TradingView"],
    ] },
    { type: "heading",text: "Mantenga análisis y ejecución claramente separados con PickMyTrade" },
    { type: "paragraph",html: "La razón por la que esto desconcierta a tanta gente es que intentan que una sola aplicación haga dos trabajos: graficar el mercado y llevar órdenes a Tradovate. No tienen por qué vivir en la misma conexión. Lea su flujo de órdenes y su footprint en Overcharts a través de Rithmic y deje que un puente dedicado se encargue de la ejecución, de modo que sus ejecuciones nunca dependan de qué aplicación de gráficos esté usando:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Alertas directas a Tradovate</strong>, PickMyTrade toma sus alertas de TradingView y las enruta a su cuenta de Tradovate, sin ninguna aplicación de gráficos en la ruta de las órdenes.",
        "<strong class='text-white'>Grafique donde prefiera</strong>, conserve Overcharts para el análisis en el que destaca mientras sus entradas y salidas se disparan automáticamente mediante un puente creado para ello.",
        "<strong class='text-white'>Asignación de entorno y cuenta</strong>, dirija cada estrategia a la cuenta y el entorno correctos de Tradovate para que real y simulación no se mezclen.",
        "<strong class='text-white'>Sincronización multicuenta</strong>, replique la misma orden en varias cuentas de Tradovate a la vez sin instalaciones de escritorio adicionales.",
      ],
    },
  ], fr: [
    { type: "paragraph",html: "Vous avez construit votre analyse de footprint et de volume dans Overcharts, vous disposez d'un compte Tradovate financé ou personnel pour trader réellement, et vous parcourez maintenant la liste des connexions d'Overcharts à la recherche de Tradovate. Il n'y est pas. Pas de broker Tradovate, pas de flux de données Tradovate, pas de champ où saisir votre identifiant Tradovate. Voici la version courte pour ne pas perdre un après-midi : <strong class='text-white'>Overcharts n'a pas de connexion directe à Tradovate, et n'en a jamais eu.</strong> La solution n'est ni un réglage caché ni une mise à niveau de forfait. Elle consiste à alimenter Overcharts via Rithmic, le pont universel qu'Overcharts utilise pour les brokers qu'il ne nomme pas. Vous trouverez ci-dessous pourquoi l'option Tradovate est absente, comment savoir si votre compte peut même atteindre Overcharts, et la façon exacte de configurer une connexion Rithmic pour que vos graphiques se remplissent de données de contrats à terme en direct." },
    {
      type: "checklist",
      heading: "Liste de contrôle rapide pour le problème Overcharts + Tradovate",
      items: [
        "<strong class='text-white'>Cessez de chercher Tradovate dans Overcharts.</strong> Il n'est répertorié ni comme broker ni comme flux de données, et il n'est caché derrière aucun réglage.",
        "<strong class='text-white'>Passez plutôt par Rithmic.</strong> Overcharts se connecte aux brokers non répertoriés via Rithmic, pourvu que votre compte puisse fournir une connexion Rithmic.",
        "<strong class='text-white'>Demandez à votre broker ou prop firm des identifiants Rithmic</strong> (nom d'utilisateur, mot de passe et passerelle distincts). La disponibilité varie selon la firme et la taille du compte ; confirmez donc les options actuelles de votre firme.",
        "<strong class='text-white'>Le flux de données est un abonnement distinct</strong> d'Overcharts. Votre broker ou un fournisseur de données fournit le flux Rithmic et ses frais de bourse ; Overcharts n'est que le graphique.",
        "<strong class='text-white'>Compte Tradovate uniquement, sans option Rithmic ?</strong> Vous ne pouvez pas acheminer ce compte vers Overcharts. Utilisez les graphiques avancés de Tradovate lui-même ou ajoutez un flux Rithmic autonome pour la partie graphiques.",
        "<strong class='text-white'>Vous pouvez toujours exécuter sur Tradovate</strong> tout en analysant dans Overcharts. La connexion de graphiques et l'acheminement des ordres n'ont pas à passer par le même compte.",
      ],
    },
    { type: "heading",text: "Ce que signifie réellement « aucune connexion directe » ici" },
    { type: "paragraph",html: "« Aucune connexion directe » ne signifie pas que quelque chose est cassé ni que vous avez oublié une case à cocher. Cela signifie qu'Overcharts n'a tout simplement jamais été conçu pour dialoguer avec Tradovate. Overcharts atteint chaque broker ou fournisseur de données via une connexion précise et nommée : CQG/StoneX, Rithmic, dxFeed, Interactive Brokers, TradeStation, Directa, Binance, Oanda et quelques autres. Tradovate n'en fait pas partie. Il n'y a ni adaptateur, ni écran de connexion, ni entrée de flux de données qui attende vos informations Tradovate." },
    { type: "paragraph",html: "Ce n'est pas non plus une version qu'une mise à jour permettrait de dépasser. Une demande publique d'ajout de Tradovate figure sur le suivi d'Overcharts depuis 2020 sans aucun développement derrière ; traiter cela comme un « la prochaine version règlera peut-être ça » ne vous fera que perdre du temps. La prise en charge de Tradovate ne fait pas partie de la plateforme aujourd'hui, point final." },
    { type: "paragraph",html: "Voici la partie qui vous permet réellement d'afficher des graphiques : Overcharts prend ouvertement en charge tout broker qui propose une connexion Rithmic, même s'il ne le nomme pas. La plateforme Tradovate ne vous fournira pas de flux Rithmic d'elle-même, et les demandes anciennes d'ajout de données Rithmic dans Tradovate n'ont jamais abouti. Mais la maison de courtage ou la prop firm derrière votre compte peut souvent vous donner un accès Rithmic, car Rithmic et Tradovate sont deux couches de connectivité distinctes que de nombreuses firmes de contrats à terme exploitent côte à côte." },
    { type: "heading",text: "Pourquoi l'option Tradovate est absente" },
    { type: "heading",text: "1. Overcharts n'a pas d'adaptateur Tradovate" },
    { type: "paragraph",html: "C'est toute l'histoire en une ligne. Chaque connexion d'Overcharts est une intégration développée sur mesure, et personne n'en a développé une pour Tradovate. Il n'existe pas de mode « se connecter avec Tradovate » car ce chemin de code n'existe pas. Si vous voulez votre compte de contrats à terme dans Overcharts, vous le connectez via l'un des flux qu'Overcharts prend en charge, et pour un compte lié à Tradovate, cela signifie Rithmic." },
    { type: "heading",text: "2. Rithmic et Tradovate sont des couches distinctes" },
    { type: "paragraph",html: "Beaucoup supposent que, parce que leur compte « tourne sur Tradovate », toute option Rithmic doit aussi passer par Tradovate. Ce n'est pas le cas. Rithmic est un fournisseur de connectivité à faible latence pour contrats à terme, et Tradovate est une plateforme et une pile de courtage distinctes. Une firme peut vous proposer l'une, l'autre ou les deux. Tradovate n'expose pas de flux Rithmic propre, donc les identifiants Rithmic dont vous avez besoin proviennent du back-office de votre broker ou de votre prop firm, pas de l'application Tradovate." },
    { type: "heading",text: "3. Votre identifiant Tradovate ne s'authentifiera pas" },
    { type: "paragraph",html: "Même en essayant de forcer les choses, votre nom d'utilisateur et votre mot de passe Tradovate n'ont nulle part où aller dans Overcharts. Aucun champ n'attend des identifiants Tradovate, de sorte que les coller dans la boîte de dialogue Rithmic ne fonctionnera pas. Les connexions Rithmic utilisent des identifiants délivrés par Rithmic, qui sont un ensemble d'informations entièrement différent de votre connexion à la plateforme Tradovate." },
    { type: "heading",text: "4. Votre firme ne propose peut-être que Tradovate" },
    { type: "paragraph",html: "Certains brokers et prop firms ne provisionnent qu'une connexion Tradovate et ne délivrent jamais d'accès Rithmic. Si c'est votre cas, aucune combinaison de réglages n'acheminera ce compte précis vers Overcharts, car aucun des deux côtés ne propose le pont. La disponibilité de Rithmic dépend de la firme et souvent de la taille du compte ou du forfait ; mieux vaut donc poser la question que deviner." },
    { type: "heading",text: "5. Le flux de données a son propre coût" },
    { type: "paragraph",html: "Overcharts est le logiciel de graphiques ; les données de marché en direct sont distinctes. Votre flux Rithmic et ses frais de bourse proviennent de votre broker ou d'un fournisseur de données, et ne sont pas inclus dans l'abonnement Overcharts. Si vos graphiques restent vides après la connexion, un abonnement de données impayé ou non signé est une raison fréquente, et non un bogue de connexion." },
    { type: "heading",text: "Comment corriger la configuration Overcharts + Tradovate en 2026 : pas à pas" },
    { type: "heading",text: "Option A : obtenir des identifiants Rithmic pour votre compte (recommandé)" },
    { type: "paragraph",html: "C'est la voie propre lorsque vous voulez votre compte de contrats à terme dans Overcharts. Vous ne connectez pas Tradovate ; vous obtenez une connexion Rithmic pour le même compte de trading." },
    {
      type: "steps",
      items: [
        { title: "Interrogez votre broker ou prop firm sur l'accès Rithmic", html: "Demandez s'ils proposent un <strong class='text-white'>accès Rithmic</strong> en plus de Tradovate. De nombreux brokers de contrats à terme et certaines prop firms le font, mais cela varie selon la firme et la taille du compte ; confirmez donc les règles actuelles de votre firme." },
        { title: "Demandez vos identifiants Rithmic", html: "Obtenez le nom d'utilisateur, le mot de passe et le nom de la passerelle ou du système auquel ils veulent que vous vous connectiez. Rappelez-vous que Rithmic ne vend pas directement aux utilisateurs finaux ; ces informations proviennent donc toujours de votre broker ou d'un fournisseur de données." },
        { title: "Signez les accords de données de marché requis", html: "Généralement les formulaires CME pour non-professionnels ou professionnels. Des accords non signés sont une raison fréquente pour laquelle une nouvelle connexion Rithmic aboutit mais n'affiche aucune cotation." },
        { title: "Choisissez demo ou live", html: "Déterminez si vous avez besoin d'un flux <strong class='text-white'>demo</strong> pour tester ou d'un flux <strong class='text-white'>live</strong> pour de vrais graphiques, et obtenez les identifiants correspondants, car les comptes papier et réels utilisent des passerelles différentes." },
