---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "one-withdrawal-per-24-hours";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/debugging/${SLUG}`;

const META_TITLE = "Tradovate: One Withdrawal Per 24 Hours Limit";
const META_DESCRIPTION =
  "Hit the one-withdrawal-per-24-hours limit on Tradovate? See why it happens, how long to wait, and how to request your next transfer cleanly.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Tradovate: Limit von einer Auszahlung pro 24 Stunden", es: "Tradovate: límite de una retirada por cada 24 horas", fr: "Tradovate : limite d'un retrait par 24 heures", it: "Tradovate: limite di un prelievo ogni 24 ore" },
  dek: { en: "A second withdrawal request just bounced. Here's why Tradovate only allows one per 24 hours, and how to plan your transfers so you're not stuck waiting.", de: "Ihre zweite Auszahlungsanfrage wurde abgelehnt. Hier erfahren Sie, warum Tradovate nur eine pro 24 Stunden erlaubt und wie Sie Ihre Überweisungen so planen, dass Sie nicht warten müssen.", es: "Su segunda solicitud de retirada fue rechazada. Aquí le explicamos por qué Tradovate solo permite una cada 24 horas y cómo planificar sus transferencias para no quedarse esperando.", fr: "Votre deuxième demande de retrait vient d'être refusée. Voici pourquoi Tradovate n'en autorise qu'un par 24 heures et comment planifier vos virements pour ne pas rester bloqué à attendre.", it: "La Sua seconda richiesta di prelievo è stata respinta. Ecco perché Tradovate ne consente solo uno ogni 24 ore e come pianificare i trasferimenti per non restare in attesa." },
  readTime: { en: "6 min read", de: "6 Min. Lesezeit", es: "Lectura de 6 min", fr: "Lecture : 6 min", it: "Lettura di 6 min" },
  lastUpdated: "2026-07-10",
  blocks: { en: [
    { type: "paragraph", html: "You cashed out some profit, then went to move a bit more, and the second request bounced. Nothing is broken. Tradovate lets you request only <strong class='text-white'>one withdrawal per 24-hour period</strong> from a live brokerage account, and if a withdrawal is already in progress, a new one gets denied until the first has completed. The fix is almost always the same: wait for that first transfer to finish, then submit your next request. This guide breaks down exactly what the 24-hour limit is, the handful of reasons a withdrawal gets rejected, and how to plan your transfers so you're not stuck waiting on a payout you needed today." },
    {
      type: "checklist",
      heading: "Quick Answer",
      items: [
        "<strong class='text-white'>One withdrawal per 24 hours.</strong> Tradovate allows a single withdrawal request in any rolling 24-hour window from a live account.",
        "<strong class='text-white'>Let the first one finish.</strong> If a withdrawal is still processing, a second request is denied until it clears. This is the number-one cause of a rejected second withdrawal.",
        "<strong class='text-white'>Batch it.</strong> Since you only get one shot per day, request the full amount you need in a single transfer instead of splitting it.",
        "<strong class='text-white'>Mind the minimum.</strong> The floor is $50 (or 50 units of the currency). Anything smaller won't go through.",
        "<strong class='text-white'>Big withdrawals need SMS approval.</strong> Requests over roughly $5,000 trigger a text-message confirmation to the phone on your account.",
        "<strong class='text-white'>Prop accounts are different.</strong> Evaluation and funded payouts run through your firm's payout system, not this screen, and follow the firm's own rules.",
      ],
    },
    { type: "heading", text: "What the \"One Withdrawal Per 24 Hours\" Limit Actually Means" },
    { type: "paragraph", html: "This is a control on the money-out rail, not a platform glitch. Tradovate processes withdrawals from your live brokerage account to a linked bank account by ACH (for U.S. residents) or by wire, and it caps you at one request per 24-hour period. The reason is practical: each withdrawal has to clear through a banking and clearing-firm process, and letting a stack of overlapping requests pile up would make that reconciliation messy and slow. So the platform holds you to one at a time." },
    { type: "paragraph", html: "In day-to-day terms, that means once you submit a withdrawal, that's your request for the window. Try to fire off another before the first is done and you'll be blocked. It's not a penalty, and it doesn't touch the money already on its way. It just means the next transfer waits its turn. Once your first withdrawal has completed and the 24-hour clock has rolled past, you're free to request again." },
    { type: "heading", text: "Why Your Withdrawal Got Denied" },
    { type: "heading", text: "1. Your First Withdrawal Is Still Processing" },
    { type: "paragraph", html: "This is the usual culprit. You requested a withdrawal an hour ago, it's still moving through ACH or the wire pipeline, and now a second request won't take. The platform sees an active withdrawal and refuses to queue another. There's nothing to fix here beyond patience, wait for the in-progress transfer to land, and your next request will go through." },
    { type: "heading", text: "2. You Already Used Your Window" },
    { type: "paragraph", html: "Even if the first withdrawal cleared quickly, the 24-hour clock started when you submitted it, not when it settled. If you got paid out this morning and want more this afternoon, you may still be inside the same window. The counter resets on a rolling basis, so line up your next request for after the full 24 hours have passed." },
    { type: "heading", text: "3. You're Below the Minimum" },
    { type: "paragraph", html: "Tradovate's minimum withdrawal is $50, or 50 units of the requested currency for non-USD accounts. Ask for less than that and the request simply won't process. If a small withdrawal keeps failing and you've ruled out the 24-hour rule, check the amount, this floor catches people who are trying to sweep out an odd remaining balance." },
    { type: "heading", text: "4. A Large Withdrawal Is Waiting on SMS Confirmation" },
    { type: "paragraph", html: "Withdrawals above roughly $5,000 require an extra step: Tradovate texts a confirmation code to the phone number attached to your account, and the request isn't complete until you approve it. If your big withdrawal seems to stall, it may be sitting on that unconfirmed text, especially if the number on file is out of date." },
    { type: "heading", text: "5. It's a Prop Firm or Evaluation Account" },
    { type: "paragraph", html: "If you're trading a funded or evaluation account through a prop firm, the withdrawal screen you're looking at may not be the one that pays you. Prop payouts flow through the firm's own payout system, with the firm's schedule, minimum payout, and frequency rules, which vary by firm and account size. A &ldquo;withdrawal&rdquo; that won't process on a prop account is often a case of using the wrong path entirely. Check your firm's current payout policy before assuming it's a Tradovate limit." },
    { type: "heading", text: "How to Handle the 24-Hour Limit: Step by Step" },
    { type: "heading", text: "Wait for the First Withdrawal to Complete" },
    {
      type: "steps",
      items: [
        { title: "Open Transfers & Payments", html: "Open <strong class='text-white'>Application Settings &rsaquo; Transfers &amp; Payments</strong> in the Tradovate web app and look at the status of your existing withdrawal. Confirm the exact tab label in your current build, wording shifts over time." },
        { title: "Check whether it's still in progress", html: "If the transfer is pending or processing, that's why a new request is blocked." },
        { title: "Let it land", html: "ACH withdrawals requested before the midday Central Time cutoff generally process the same business day and arrive in about one business day. Give it that window before trying again." },
        { title: "Submit your next withdrawal", html: "Do this once the first has cleared and the 24-hour mark has passed." },
      ],
    },
    { type: "heading", text: "Request the Full Amount in One Transfer" },
    {
      type: "steps",
      items: [
        { title: "Plan the total you need", html: "Do this before you start. Because you get one request per day, splitting a payout into several small transfers just burns your single daily slot on the first one." },
        { title: "Enter the full figure", html: "Enter it in the withdrawal amount field, keeping it at or above the $50 minimum and within your available (settled) balance." },
        { title: "Pick the right destination account", html: "Choose from your linked bank accounts, and double-check it's the one you intend to use." },
        { title: "Submit once", html: "One clean request for the whole amount beats fighting the 24-hour rule with a handful of partial ones." },
      ],
    },
    { type: "heading", text: "Confirm Large Withdrawals by SMS" },
    {
      type: "steps",
      items: [
        { title: "Verify the phone number on your account", html: "Do this before you request a big transfer, since the confirmation text goes there." },
        { title: "Watch for the code", html: "It arrives after you submit a withdrawal above the roughly $5,000 threshold." },
        { title: "Approve it promptly", html: "So the request completes. An unconfirmed code can leave a large withdrawal looking stuck." },
      ],
    },
    { type: "heading", text: "Choose the Right Rail and Timing" },
    {
      type: "steps",
      items: [
        { title: "Use ACH for U.S. bank accounts", html: "It's free from Tradovate's side and typically lands in about a business day when requested before the midday Central cutoff." },
        { title: "Use a wire for speed or non-ACH situations", html: "Wires often move within a few hours to a working day (longer for international), but your bank may charge a wire fee even though Tradovate doesn't." },
        { title: "Time your request around the cutoff", html: "Submitting just after the daily cutoff pushes processing to the next business day, which also delays when your one-per-24-hours clock effectively frees up." },
      ],
    },
    { type: "heading", text: "Troubleshooting Table" },
    {
      type: "table",
      headers: ["Symptom", "Likely cause", "What to do"],
      rows: [
        ["Second withdrawal request denied", "First withdrawal is still processing", "Wait for the in-progress transfer to complete, then request again"],
        ["Can't withdraw again the same day", "You already used your request inside the 24-hour window", "Wait for the rolling 24 hours since the first request to pass"],
        ["Small withdrawal won't process", "Below the $50 (or 50-unit) minimum", "Increase the amount to at least the minimum"],
        ["Large withdrawal seems stuck", "Unconfirmed SMS code for a request over ~$5,000", "Check the phone on file and approve the text confirmation"],
        ["Withdrawal option missing on a prop account", "Payouts run through the firm, not this screen", "Use your prop firm's payout process and rules"],
        ["Withdrawal delayed a full day", "Requested after the daily processing cutoff", "Submit before the midday Central cutoff for same-day processing"],
      ],
    },
    { type: "heading", text: "A Note on Prop Firm and Evaluation Payouts" },
    { type: "paragraph", html: "A lot of confusion around Tradovate withdrawals comes from prop traders expecting the brokerage withdrawal screen to pay out their funded profits. It usually won't. When you trade a firm's evaluation or funded account, the capital isn't yours to pull directly, the firm owns the account and runs payouts on its own terms. That means the one-per-24-hours brokerage limit doesn't even apply to you; your firm's payout frequency, minimum payout, and any consistency or holding rules do instead. Those numbers vary widely from firm to firm and by account size, so the only reliable source is your firm's current payout policy. If a payout isn't showing up where you expect, that's the first place to look, not the Tradovate withdrawal tab." },
    { type: "heading", text: "Where Automation Fits" },
    { type: "paragraph", html: "Worth being straight about this: the 24-hour withdrawal limit is a banking rule, and no third-party tool changes it. What <strong class='text-white'>PickMyTrade</strong> does is on the trading side, it routes your TradingView alerts to Tradovate through one stable connection so your entries and exits fire consistently and your balance ends up where your strategy intended. It keeps a single persistent session, renews its access token automatically, and spaces out order traffic to stay within Tradovate's rate limits, so the execution that builds the balance you're withdrawing runs cleanly. It just can't (and won't) touch the withdrawal rail itself, that part is always between you, Tradovate, and your bank." },
  ], de: [
    { type: "paragraph",html: "Sie haben etwas Gewinn ausgezahlt, wollten dann noch etwas überweisen, und die zweite Anfrage wurde abgelehnt. Nichts ist kaputt. Tradovate erlaubt von einem Live-Brokerage-Konto nur <strong class='text-white'>eine Auszahlung pro 24-Stunden-Zeitraum</strong>, und wenn bereits eine Auszahlung läuft, wird eine neue abgelehnt, bis die erste abgeschlossen ist. Die Lösung ist fast immer dieselbe: Warten Sie, bis die erste Überweisung abgeschlossen ist, und reichen Sie dann Ihre nächste Anfrage ein. Diese Anleitung erklärt genau, was das 24-Stunden-Limit ist, welche Gründe es für eine abgelehnte Auszahlung gibt und wie Sie Ihre Überweisungen so planen, dass Sie nicht auf eine Auszahlung warten müssen, die Sie heute gebraucht hätten." },
    {
      type: "checklist",
      heading: "Kurze Antwort",
      items: [
        "<strong class='text-white'>Eine Auszahlung pro 24 Stunden.</strong> Tradovate erlaubt von einem Live-Konto eine einzige Auszahlungsanfrage in einem beliebigen gleitenden 24-Stunden-Fenster.",
        "<strong class='text-white'>Lassen Sie die erste abschließen.</strong> Wenn eine Auszahlung noch verarbeitet wird, wird eine zweite Anfrage abgelehnt, bis sie abgeschlossen ist. Das ist die häufigste Ursache für eine abgelehnte zweite Auszahlung.",
        "<strong class='text-white'>Bündeln Sie.</strong> Da Sie pro Tag nur einen Versuch haben, fordern Sie den gesamten benötigten Betrag in einer einzigen Überweisung an, statt ihn aufzuteilen.",
        "<strong class='text-white'>Beachten Sie das Minimum.</strong> Die Untergrenze liegt bei 50 $ (oder 50 Einheiten der Währung). Kleinere Beträge werden nicht ausgeführt.",
        "<strong class='text-white'>Große Auszahlungen erfordern eine SMS-Freigabe.</strong> Anfragen über etwa 5,000 $ lösen eine Textnachricht-Bestätigung an das Telefon in Ihrem Konto aus.",
        "<strong class='text-white'>Prop-Konten sind anders.</strong> Auszahlungen von Evaluierungs- und finanzierten Konten laufen über das Auszahlungssystem Ihrer Firma, nicht über diesen Bildschirm, und folgen den eigenen Regeln der Firma.",
      ],
    },
    { type: "heading",text: "Was das Limit „Eine Auszahlung pro 24 Stunden“ tatsächlich bedeutet" },
    { type: "paragraph",html: "Das ist eine Kontrolle auf dem Weg des Geldabflusses, keine Störung der Plattform. Tradovate verarbeitet Auszahlungen von Ihrem Live-Brokerage-Konto auf ein verknüpftes Bankkonto per ACH (für Einwohner der USA) oder per Wire und begrenzt Sie auf eine Anfrage pro 24-Stunden-Zeitraum. Der Grund ist praktisch: Jede Auszahlung muss einen Bank- und Clearing-Prozess durchlaufen, und sich überlappende Anfragen würden den Abgleich unübersichtlich und langsam machen. Deshalb erlaubt Ihnen die Plattform nur eine zur Zeit." },
    { type: "paragraph",html: "Im Alltag bedeutet das: Sobald Sie eine Auszahlung einreichen, ist das Ihre Anfrage für das Zeitfenster. Wenn Sie versuchen, eine weitere abzusenden, bevor die erste fertig ist, werden Sie blockiert. Das ist keine Strafe und betrifft das bereits unterwegs befindliche Geld nicht. Es bedeutet nur, dass die nächste Überweisung warten muss. Sobald Ihre erste Auszahlung abgeschlossen ist und die 24-Stunden-Uhr abgelaufen ist, können Sie erneut anfragen." },
    { type: "heading",text: "Warum Ihre Auszahlung abgelehnt wurde" },
    { type: "heading",text: "1. Ihre erste Auszahlung wird noch verarbeitet" },
    { type: "paragraph",html: "Das ist der übliche Verursacher. Sie haben vor einer Stunde eine Auszahlung beauftragt, sie läuft noch durch die ACH- oder Wire-Pipeline, und nun wird eine zweite Anfrage nicht angenommen. Die Plattform sieht eine aktive Auszahlung und weigert sich, eine weitere einzureihen. Hier ist nichts zu beheben außer Geduld: Warten Sie, bis die laufende Überweisung angekommen ist, dann wird Ihre nächste Anfrage akzeptiert." },
    { type: "heading",text: "2. Sie haben Ihr Zeitfenster bereits genutzt" },
    { type: "paragraph",html: "Selbst wenn die erste Auszahlung schnell abgeschlossen wurde, begann die 24-Stunden-Uhr mit dem Absenden, nicht mit der Gutschrift. Wenn Sie heute Morgen ausgezahlt wurden und heute Nachmittag mehr möchten, befinden Sie sich möglicherweise noch im selben Fenster. Der Zähler wird fortlaufend zurückgesetzt. Planen Sie Ihre nächste Anfrage daher für den Zeitpunkt nach Ablauf der vollen 24 Stunden." },
    { type: "heading",text: "3. Sie liegen unter dem Minimum" },
    { type: "paragraph",html: "Die Mindestauszahlung bei Tradovate beträgt 50 $ bzw. 50 Einheiten der angeforderten Währung bei Nicht-USD-Konten. Fordern Sie weniger an, wird die Anfrage schlicht nicht verarbeitet. Wenn eine kleine Auszahlung immer wieder scheitert und Sie die 24-Stunden-Regel ausgeschlossen haben, prüfen Sie den Betrag. Diese Untergrenze trifft Personen, die ein krummes Restguthaben abräumen möchten." },
    { type: "heading",text: "4. Eine große Auszahlung wartet auf die SMS-Bestätigung" },
    { type: "paragraph",html: "Auszahlungen über etwa 5,000 $ erfordern einen zusätzlichen Schritt: Tradovate sendet einen Bestätigungscode an die mit Ihrem Konto verknüpfte Telefonnummer, und die Anfrage ist erst abgeschlossen, wenn Sie sie freigeben. Wenn Ihre große Auszahlung zu hängen scheint, wartet sie möglicherweise auf diese unbestätigte Textnachricht, vor allem wenn die hinterlegte Nummer veraltet ist." },
    { type: "heading",text: "5. Es ist ein Prop-Firm- oder Evaluierungskonto" },
    { type: "paragraph",html: "Wenn Sie ein finanziertes oder Evaluierungskonto über eine Prop Firm handeln, ist der Auszahlungsbildschirm, den Sie sehen, möglicherweise nicht derjenige, der Sie bezahlt. Prop-Auszahlungen laufen über das eigene Auszahlungssystem der Firma mit deren Zeitplan, Mindestauszahlung und Häufigkeitsregeln, die je nach Firma und Kontogröße variieren. Eine &ldquo;Auszahlung&rdquo;, die auf einem Prop-Konto nicht verarbeitet wird, liegt oft schlicht daran, dass der falsche Weg verwendet wurde. Prüfen Sie die aktuelle Auszahlungsrichtlinie Ihrer Firma, bevor Sie annehmen, dass es ein Tradovate-Limit ist." },
    { type: "heading",text: "So gehen Sie mit dem 24-Stunden-Limit um: Schritt für Schritt" },
    { type: "heading",text: "Warten, bis die erste Auszahlung abgeschlossen ist" },
    {
      type: "steps",
      items: [
        { title: "Transfers &amp; Payments öffnen", html: "Öffnen Sie in der Tradovate-Web-App <strong class='text-white'>Application Settings &rsaquo; Transfers &amp; Payments</strong> und prüfen Sie den Status Ihrer bestehenden Auszahlung. Bestätigen Sie die genaue Bezeichnung des Tabs in Ihrer aktuellen Version, die Formulierung ändert sich mit der Zeit." },
        { title: "Prüfen, ob sie noch in Bearbeitung ist", html: "Wenn die Überweisung ausstehend ist oder verarbeitet wird, ist das der Grund, warum eine neue Anfrage blockiert wird." },
        { title: "Sie ankommen lassen", html: "ACH-Auszahlungen, die vor der Mittags-Cutoff-Zeit (Central Time) beauftragt werden, werden in der Regel am selben Geschäftstag verarbeitet und kommen etwa einen Geschäftstag später an. Geben Sie ihr dieses Zeitfenster, bevor Sie es erneut versuchen." },
        { title: "Ihre nächste Auszahlung einreichen", html: "Tun Sie dies, sobald die erste abgeschlossen ist und die 24-Stunden-Marke überschritten wurde." },
      ],
    },
    { type: "heading",text: "Den vollen Betrag in einer Überweisung anfordern" },
    {
      type: "steps",
      items: [
        { title: "Planen Sie den benötigten Gesamtbetrag", html: "Tun Sie das, bevor Sie beginnen. Da Sie pro Tag eine Anfrage haben, verbraucht das Aufteilen einer Auszahlung in mehrere kleine Überweisungen Ihren einzigen Tagesplatz schon mit der ersten." },
        { title: "Den vollen Betrag eingeben", html: "Geben Sie ihn in das Feld für den Auszahlungsbetrag ein, wobei er mindestens dem Minimum von 50 $ entsprechen und innerhalb Ihres verfügbaren (abgerechneten) Guthabens liegen muss." },
        { title: "Das richtige Zielkonto wählen", html: "Wählen Sie aus Ihren verknüpften Bankkonten und prüfen Sie doppelt, dass es das Konto ist, das Sie verwenden möchten." },
        { title: "Einmal einreichen", html: "Eine saubere Anfrage für den Gesamtbetrag ist besser, als mit mehreren Teilanfragen gegen die 24-Stunden-Regel anzukämpfen." },
      ],
    },
    { type: "heading",text: "Große Auszahlungen per SMS bestätigen" },
    {
      type: "steps",
      items: [
        { title: "Die Telefonnummer in Ihrem Konto überprüfen", html: "Tun Sie dies, bevor Sie eine große Überweisung beantragen, da die Bestätigungsnachricht dorthin gesendet wird." },
        { title: "Auf den Code achten", html: "Er trifft ein, nachdem Sie eine Auszahlung über der Schwelle von etwa 5,000 $ eingereicht haben." },
        { title: "Umgehend freigeben", html: "Damit die Anfrage abgeschlossen wird. Ein unbestätigter Code kann eine große Auszahlung scheinbar hängen lassen." },
      ],
    },
    { type: "heading",text: "Den richtigen Weg und den richtigen Zeitpunkt wählen" },
    {
      type: "steps",
      items: [
        { title: "ACH für US-Bankkonten verwenden", html: "Es ist von Seiten Tradovates kostenlos und kommt in der Regel etwa einen Geschäftstag später an, wenn es vor der Mittags-Cutoff-Zeit (Central Time) beauftragt wird." },
        { title: "Wire für Geschwindigkeit oder Nicht-ACH-Fälle verwenden", html: "Wires laufen oft innerhalb weniger Stunden bis zu einem Arbeitstag (international länger), aber Ihre Bank erhebt möglicherweise eine Wire-Gebühr, auch wenn Tradovate keine erhebt." },
        { title: "Ihre Anfrage rund um die Cutoff-Zeit timen", html: "Wenn Sie knapp nach der täglichen Cutoff-Zeit einreichen, verschiebt sich die Verarbeitung auf den nächsten Geschäftstag, wodurch sich auch verzögert, wann Ihre Uhr für die Begrenzung auf eine Auszahlung pro 24 Stunden tatsächlich frei wird." },
      ],
    },
    { type: "heading",text: "Tabelle zur Fehlerbehebung" },
    { type: "table", headers: ["Symptom","Wahrscheinliche Ursache","Was zu tun ist"], rows: [
      ["Zweite Auszahlungsanfrage abgelehnt","Erste Auszahlung wird noch verarbeitet","Warten Sie, bis die laufende Überweisung abgeschlossen ist, und fordern Sie dann erneut an"],
      ["Am selben Tag keine weitere Auszahlung möglich","Sie haben Ihre Anfrage innerhalb des 24-Stunden-Fensters bereits genutzt","Warten Sie, bis die gleitenden 24 Stunden seit der ersten Anfrage vergangen sind"],
      ["Kleine Auszahlung wird nicht verarbeitet","Unter dem Minimum von 50 $ (oder 50 Einheiten)","Erhöhen Sie den Betrag auf mindestens das Minimum"],
      ["Große Auszahlung scheint festzuhängen","Unbestätigter SMS-Code bei einer Anfrage über ~5,000 $","Prüfen Sie das hinterlegte Telefon und bestätigen Sie die Textnachricht"],
      ["Auszahlungsoption fehlt bei einem Prop-Konto","Auszahlungen laufen über die Firma, nicht über diesen Bildschirm","Nutzen Sie den Auszahlungsprozess und die Regeln Ihrer Prop Firm"],
      ["Auszahlung um einen ganzen Tag verzögert","Nach der täglichen Verarbeitungs-Cutoff-Zeit beauftragt","Reichen Sie vor der Mittags-Cutoff-Zeit (Central Time) ein, damit sie am selben Tag verarbeitet wird"],
    ] },
    { type: "heading",text: "Ein Hinweis zu Prop-Firm- und Evaluierungsauszahlungen" },
    { type: "paragraph",html: "Viel Verwirrung rund um Tradovate-Auszahlungen entsteht, weil Prop-Trader erwarten, dass der Brokerage-Auszahlungsbildschirm ihre finanzierten Gewinne auszahlt. Das tut er in der Regel nicht. Wenn Sie ein Evaluierungs- oder finanziertes Konto einer Firma handeln, gehört das Kapital nicht Ihnen zur direkten Entnahme, die Firma besitzt das Konto und führt Auszahlungen zu ihren eigenen Bedingungen durch. Das heißt, das Brokerage-Limit von einer Auszahlung pro 24 Stunden gilt für Sie gar nicht; stattdessen gelten die Auszahlungshäufigkeit, die Mindestauszahlung und etwaige Konsistenz- oder Haltedauerregeln Ihrer Firma. Diese Werte unterscheiden sich stark von Firma zu Firma und je nach Kontogröße, daher ist die aktuelle Auszahlungsrichtlinie Ihrer Firma die einzige verlässliche Quelle. Wenn eine Auszahlung nicht dort erscheint, wo Sie sie erwarten, ist das die erste Stelle zum Nachsehen, nicht der Auszahlungs-Tab von Tradovate." },
    { type: "heading",text: "Wo Automatisierung ins Spiel kommt" },
    { type: "paragraph",html: "Man sollte ehrlich sein: Das 24-Stunden-Auszahlungslimit ist eine Bankregel, und kein Drittanbieter-Tool ändert daran etwas. Was <strong class='text-white'>PickMyTrade</strong> leistet, betrifft die Handelsseite: Es leitet Ihre TradingView-Alerts über eine stabile Verbindung an Tradovate weiter, sodass Ihre Einstiege und Ausstiege konsistent ausgelöst werden und Ihr Guthaben dort ankommt, wo Ihre Strategie es vorgesehen hat. Es hält eine einzige dauerhafte Sitzung aufrecht, erneuert sein Zugriffstoken automatisch und taktet den Orderverkehr so, dass die Ratenlimits von Tradovate eingehalten werden, damit die Ausführung, die das auszuzahlende Guthaben aufbaut, sauber läuft. Es kann (und wird) den Auszahlungsweg selbst nicht berühren, dieser Teil liegt immer zwischen Ihnen, Tradovate und Ihrer Bank." },
  ], es: [
    { type: "paragraph",html: "Retiró parte de sus beneficios, fue a mover un poco más y la segunda solicitud fue rechazada. No hay nada roto. Tradovate le permite solicitar solo <strong class='text-white'>una retirada por período de 24 horas</strong> desde una cuenta de corretaje en vivo y, si ya hay una retirada en curso, una nueva se deniega hasta que la primera se complete. La solución casi siempre es la misma: espere a que termine esa primera transferencia y luego envíe su siguiente solicitud. Esta guía desglosa exactamente en qué consiste el límite de 24 horas, los pocos motivos por los que se rechaza una retirada y cómo planificar sus transferencias para no quedarse esperando un pago que necesitaba hoy." },
    {
      type: "checklist",
      heading: "Respuesta rápida",
      items: [
        "<strong class='text-white'>Una retirada cada 24 horas.</strong> Tradovate permite una única solicitud de retirada en cualquier ventana móvil de 24 horas desde una cuenta en vivo.",
        "<strong class='text-white'>Deje que la primera termine.</strong> Si una retirada aún se está procesando, una segunda solicitud se deniega hasta que se complete. Esta es la causa número uno de una segunda retirada rechazada.",
        "<strong class='text-white'>Agrúpelas.</strong> Como solo tiene una oportunidad al día, solicite el importe completo que necesita en una única transferencia en lugar de dividirlo.",
        "<strong class='text-white'>Tenga en cuenta el mínimo.</strong> El límite inferior es de 50 $ (o 50 unidades de la moneda). Cualquier importe menor no se procesará.",
        "<strong class='text-white'>Las retiradas grandes requieren aprobación por SMS.</strong> Las solicitudes superiores a unos 5,000 $ activan una confirmación por mensaje de texto al teléfono de su cuenta.",
        "<strong class='text-white'>Las cuentas prop son diferentes.</strong> Los pagos de cuentas de evaluación y fondeadas se tramitan por el sistema de pagos de su firma, no por esta pantalla, y siguen las reglas propias de la firma.",
      ],
    },
    { type: "heading",text: "Qué significa realmente el límite de «una retirada por 24 horas»" },
    { type: "paragraph",html: "Es un control sobre el canal de salida del dinero, no un fallo de la plataforma. Tradovate procesa las retiradas de su cuenta de corretaje en vivo a una cuenta bancaria vinculada mediante ACH (para residentes de EE. UU.) o por wire, y le limita a una solicitud por período de 24 horas. El motivo es práctico: cada retirada tiene que pasar por un proceso bancario y de compensación, y permitir que se acumulen solicitudes superpuestas haría esa conciliación desordenada y lenta. Por eso la plataforma le limita a una a la vez." },
    { type: "paragraph",html: "En la práctica, eso significa que una vez que envía una retirada, esa es su solicitud para la ventana. Si intenta enviar otra antes de que la primera termine, se le bloqueará. No es una penalización y no afecta al dinero que ya está en camino. Simplemente significa que la siguiente transferencia espera su turno. Una vez que su primera retirada se haya completado y el reloj de 24 horas haya avanzado, puede volver a solicitar." },
    { type: "heading",text: "Por qué se denegó su retirada" },
    { type: "heading",text: "1. Su primera retirada sigue en proceso" },
    { type: "paragraph",html: "Este es el culpable habitual. Solicitó una retirada hace una hora, sigue avanzando por el canal de ACH o wire y ahora una segunda solicitud no se acepta. La plataforma ve una retirada activa y se niega a poner otra en cola. No hay nada que arreglar salvo tener paciencia: espere a que la transferencia en curso llegue y su siguiente solicitud se aceptará." },
    { type: "heading",text: "2. Ya usó su ventana" },
    { type: "paragraph",html: "Aunque la primera retirada se completara rápido, el reloj de 24 horas empezó cuando la envió, no cuando se liquidó. Si le pagaron esta mañana y quiere más esta tarde, es posible que siga dentro de la misma ventana. El contador se reinicia de forma móvil, así que programe su siguiente solicitud para después de que hayan pasado las 24 horas completas." },
    { type: "heading",text: "3. Está por debajo del mínimo" },
    { type: "paragraph",html: "La retirada mínima de Tradovate es de 50 $, o 50 unidades de la moneda solicitada en cuentas que no son en USD. Si pide menos que eso, la solicitud simplemente no se procesa. Si una retirada pequeña sigue fallando y ya descartó la regla de 24 horas, revise el importe: este límite afecta a quienes intentan retirar un saldo restante con un importe irregular." },
    { type: "heading",text: "4. Una retirada grande está esperando la confirmación por SMS" },
    { type: "paragraph",html: "Las retiradas superiores a unos 5,000 $ requieren un paso adicional: Tradovate envía un código de confirmación por mensaje de texto al número de teléfono asociado a su cuenta, y la solicitud no se completa hasta que lo apruebe. Si su retirada grande parece atascada, puede estar esperando ese mensaje sin confirmar, especialmente si el número registrado está desactualizado." },
    { type: "heading",text: "5. Es una cuenta de prop firm o de evaluación" },
    { type: "paragraph",html: "Si opera una cuenta fondeada o de evaluación a través de una prop firm, la pantalla de retirada que está viendo puede no ser la que le paga. Los pagos prop fluyen por el propio sistema de pagos de la firma, con el calendario, el pago mínimo y las reglas de frecuencia de la firma, que varían según la firma y el tamaño de la cuenta. Una &ldquo;retirada&rdquo; que no se procesa en una cuenta prop suele ser un caso de usar la vía equivocada. Consulte la política de pagos vigente de su firma antes de asumir que es un límite de Tradovate." },
    { type: "heading",text: "Cómo gestionar el límite de 24 horas: paso a paso" },
    { type: "heading",text: "Esperar a que se complete la primera retirada" },
    {
      type: "steps",
      items: [
        { title: "Abrir Transfers &amp; Payments", html: "Abra <strong class='text-white'>Application Settings &rsaquo; Transfers &amp; Payments</strong> en la aplicación web de Tradovate y revise el estado de su retirada existente. Confirme el nombre exacto de la pestaña en su versión actual, la redacción cambia con el tiempo." },
        { title: "Comprobar si sigue en curso", html: "Si la transferencia está pendiente o en proceso, por eso se bloquea una nueva solicitud." },
        { title: "Dejar que llegue", html: "Las retiradas por ACH solicitadas antes del cierre de mediodía (hora central) generalmente se procesan el mismo día hábil y llegan en aproximadamente un día hábil. Deje pasar esa ventana antes de volver a intentarlo." },
        { title: "Enviar su siguiente retirada", html: "Hágalo una vez que la primera se haya completado y haya pasado la marca de 24 horas." },
      ],
    },
    { type: "heading",text: "Solicitar el importe completo en una sola transferencia" },
    {
      type: "steps",
      items: [
        { title: "Planificar el total que necesita", html: "Hágalo antes de empezar. Como tiene una solicitud al día, dividir un pago en varias transferencias pequeñas solo gasta su único cupo diario en la primera." },
        { title: "Introducir la cifra completa", html: "Introdúzcala en el campo del importe de retirada, manteniéndola igual o superior al mínimo de 50 $ y dentro de su saldo disponible (liquidado)." },
        { title: "Elegir la cuenta de destino correcta", html: "Elija entre sus cuentas bancarias vinculadas y compruebe dos veces que es la que desea usar." },
        { title: "Enviar una sola vez", html: "Una única solicitud limpia por el importe completo es mejor que pelear con la regla de 24 horas mediante varias solicitudes parciales." },
      ],
    },
    { type: "heading",text: "Confirmar las retiradas grandes por SMS" },
    {
      type: "steps",
      items: [
        { title: "Verificar el número de teléfono de su cuenta", html: "Hágalo antes de solicitar una transferencia grande, ya que el mensaje de confirmación se envía allí." },
        { title: "Estar atento al código", html: "Llega después de enviar una retirada por encima del umbral de unos 5,000 $." },
        { title: "Aprobarlo con prontitud", html: "Para que la solicitud se complete. Un código sin confirmar puede hacer que una retirada grande parezca atascada." },
      ],
    },
    { type: "heading",text: "Elegir el canal y el momento adecuados" },
    {
      type: "steps",
      items: [
        { title: "Usar ACH para cuentas bancarias de EE. UU.", html: "Es gratuito por parte de Tradovate y normalmente llega en aproximadamente un día hábil cuando se solicita antes del cierre de mediodía (hora central)." },
        { title: "Usar un wire por rapidez o en situaciones sin ACH", html: "Los wires suelen tardar de unas pocas horas a un día laborable (más en el caso internacional), pero su banco puede cobrar una comisión por wire aunque Tradovate no lo haga." },
        { title: "Calcular el momento de su solicitud en torno al cierre", html: "Enviar justo después del cierre diario traslada el procesamiento al siguiente día hábil, lo que también retrasa el momento en que su reloj de una por 24 horas se libera de forma efectiva." },
      ],
    },
    { type: "heading",text: "Tabla de solución de problemas" },
    { type: "table", headers: ["Síntoma","Causa probable","Qué hacer"], rows: [
      ["Segunda solicitud de retirada denegada","La primera retirada sigue en proceso","Espere a que se complete la transferencia en curso y luego solicite de nuevo"],
      ["No puede retirar de nuevo el mismo día","Ya usó su solicitud dentro de la ventana de 24 horas","Espere a que pasen las 24 horas móviles desde la primera solicitud"],
      ["Una retirada pequeña no se procesa","Por debajo del mínimo de 50 $ (o 50 unidades)","Aumente el importe al menos hasta el mínimo"],
      ["Una retirada grande parece atascada","Código SMS sin confirmar en una solicitud superior a ~5,000 $","Revise el teléfono registrado y apruebe la confirmación por mensaje de texto"],
      ["Falta la opción de retirada en una cuenta prop","Los pagos se tramitan por la firma, no por esta pantalla","Use el proceso de pago y las reglas de su prop firm"],
      ["Retirada retrasada un día completo","Solicitada después del cierre diario de procesamiento","Envíe antes del cierre de mediodía (hora central) para un procesamiento el mismo día"],
    ] },
    { type: "heading",text: "Una nota sobre los pagos de prop firms y cuentas de evaluación" },
    { type: "paragraph",html: "Gran parte de la confusión en torno a las retiradas de Tradovate viene de traders prop que esperan que la pantalla de retiradas de corretaje les pague sus beneficios fondeados. Normalmente no lo hará. Cuando opera una cuenta de evaluación o fondeada de una firma, el capital no es suyo para retirarlo directamente, la firma es propietaria de la cuenta y gestiona los pagos en sus propios términos. Eso significa que el límite de corretaje de una retirada por 24 horas ni siquiera se aplica a usted; en su lugar, se aplican la frecuencia de pago de su firma, el pago mínimo y cualquier regla de consistencia o de mantenimiento. Esas cifras varían mucho de una firma a otra y según el tamaño de la cuenta, por lo que la única fuente fiable es la política de pagos vigente de su firma. Si un pago no aparece donde lo espera, ese es el primer lugar donde mirar, no la pestaña de retiradas de Tradovate." },
    { type: "heading",text: "Dónde encaja la automatización" },
    { type: "paragraph",html: "Conviene ser claros: el límite de retirada de 24 horas es una norma bancaria y ninguna herramienta de terceros lo cambia. Lo que hace <strong class='text-white'>PickMyTrade</strong> es del lado del trading: dirige sus alertas de TradingView a Tradovate mediante una conexión estable para que sus entradas y salidas se disparen de forma consistente y su saldo termine donde su estrategia pretendía. Mantiene una única sesión persistente, renueva su token de acceso automáticamente y espacía el tráfico de órdenes para mantenerse dentro de los límites de frecuencia de Tradovate, de modo que la ejecución que genera el saldo que retira funcione sin problemas. Lo que no puede (ni va a) hacer es tocar el canal de retirada en sí; esa parte siempre queda entre usted, Tradovate y su banco." },
  ], fr: [
    { type: "paragraph",html: "Vous avez encaissé une partie de vos gains, puis vous avez voulu en transférer un peu plus, et la deuxième demande a été refusée. Rien n'est cassé. Tradovate ne vous permet de demander qu'<strong class='text-white'>un retrait par période de 24 heures</strong> depuis un compte de courtage en réel, et si un retrait est déjà en cours, un nouveau est refusé tant que le premier n'est pas terminé. La solution est presque toujours la même : attendez que ce premier virement se termine, puis soumettez votre demande suivante. Ce guide détaille ce qu'est exactement la limite de 24 heures, la poignée de raisons pour lesquelles un retrait est rejeté et comment planifier vos virements pour ne pas rester à attendre un paiement dont vous aviez besoin aujourd'hui." },
    {
      type: "checklist",
      heading: "Réponse rapide",
      items: [
        "<strong class='text-white'>Un retrait par 24 heures.</strong> Tradovate autorise une seule demande de retrait sur toute fenêtre glissante de 24 heures depuis un compte réel.",
        "<strong class='text-white'>Laissez le premier se terminer.</strong> Si un retrait est encore en cours de traitement, une seconde demande est refusée jusqu'à ce qu'il soit terminé. C'est la première cause d'un deuxième retrait rejeté.",
        "<strong class='text-white'>Regroupez.</strong> Comme vous n'avez qu'une seule demande par jour, demandez le montant complet dont vous avez besoin en un seul virement plutôt que de le fractionner.",
        "<strong class='text-white'>Respectez le minimum.</strong> Le plancher est de 50 $ (ou 50 unités de la devise). Tout montant inférieur n'aboutira pas.",
        "<strong class='text-white'>Les retraits importants nécessitent une approbation par SMS.</strong> Les demandes supérieures à environ 5,000 $ déclenchent une confirmation par SMS au téléphone de votre compte.",
        "<strong class='text-white'>Les comptes prop sont différents.</strong> Les paiements des comptes d'évaluation et financés passent par le système de paiement de votre firme, et non par cet écran, et suivent les règles propres à la firme.",
      ],
    },
    { type: "heading",text: "Ce que signifie réellement la limite « un retrait par 24 heures »" },
    { type: "paragraph",html: "Il s'agit d'un contrôle sur le canal de sortie des fonds, pas d'un dysfonctionnement de la plateforme. Tradovate traite les retraits de votre compte de courtage réel vers un compte bancaire lié par ACH (pour les résidents des États-Unis) ou par wire, et vous limite à une demande par période de 24 heures. La raison est pratique : chaque retrait doit transiter par un processus bancaire et de compensation, et laisser s'empiler des demandes qui se chevauchent rendrait ce rapprochement confus et lent. La plateforme vous limite donc à une demande à la fois." },
    { type: "paragraph",html: "Concrètement, cela signifie qu'une fois que vous avez soumis un retrait, c'est votre demande pour la fenêtre. Si vous essayez d'en envoyer une autre avant que la première soit terminée, vous serez bloqué. Ce n'est pas une pénalité et cela n'affecte pas l'argent déjà en route. Cela signifie simplement que le virement suivant attend son tour. Une fois votre premier retrait terminé et l'horloge de 24 heures écoulée, vous pouvez faire une nouvelle demande." },
    { type: "heading",text: "Pourquoi votre retrait a été refusé" },
    { type: "heading",text: "1. Votre premier retrait est encore en cours de traitement" },
    { type: "paragraph",html: "C'est le coupable habituel. Vous avez demandé un retrait il y a une heure, il circule toujours dans le circuit ACH ou wire, et maintenant une deuxième demande n'est pas acceptée. La plateforme voit un retrait actif et refuse d'en mettre un autre en file d'attente. Il n'y a rien à corriger hormis la patience : attendez que le virement en cours arrive, et votre demande suivante passera." },
    { type: "heading",text: "2. Vous avez déjà utilisé votre fenêtre" },
    { type: "paragraph",html: "Même si le premier retrait a été finalisé rapidement, l'horloge de 24 heures a démarré au moment où vous l'avez soumis, pas au moment de son règlement. Si vous avez été payé ce matin et que vous en voulez davantage cet après-midi, vous pouvez encore être dans la même fenêtre. Le compteur se réinitialise de façon glissante ; programmez donc votre prochaine demande après l'écoulement des 24 heures complètes." },
    { type: "heading",text: "3. Vous êtes en dessous du minimum" },
    { type: "paragraph",html: "Le retrait minimum de Tradovate est de 50 $, ou 50 unités de la devise demandée pour les comptes non USD. Demandez moins et la demande ne sera tout simplement pas traitée. Si un petit retrait échoue sans cesse et que vous avez écarté la règle des 24 heures, vérifiez le montant : ce plancher piège les personnes qui essaient de vider un solde restant de montant irrégulier." },
    { type: "heading",text: "4. Un retrait important attend la confirmation par SMS" },
    { type: "paragraph",html: "Les retraits supérieurs à environ 5,000 $ exigent une étape supplémentaire : Tradovate envoie un code de confirmation par SMS au numéro de téléphone associé à votre compte, et la demande n'est pas finalisée tant que vous ne l'avez pas approuvée. Si votre retrait important semble bloqué, il peut attendre ce SMS non confirmé, surtout si le numéro enregistré est obsolète." },
    { type: "heading",text: "5. C'est un compte de prop firm ou d'évaluation" },
    { type: "paragraph",html: "Si vous tradez un compte financé ou d'évaluation via une prop firm, l'écran de retrait que vous regardez n'est peut-être pas celui qui vous paie. Les paiements prop transitent par le propre système de paiement de la firme, avec son calendrier, son paiement minimum et ses règles de fréquence, qui varient selon la firme et la taille du compte. Un &ldquo;retrait&rdquo; qui ne passe pas sur un compte prop est souvent le signe qu'on utilise tout simplement le mauvais chemin. Vérifiez la politique de paiement actuelle de votre firme avant de supposer qu'il s'agit d'une limite Tradovate." },
    { type: "heading",text: "Comment gérer la limite de 24 heures : étape par étape" },
    { type: "heading",text: "Attendre la fin du premier retrait" },
    {
      type: "steps",
      items: [
        { title: "Ouvrir Transfers &amp; Payments", html: "Ouvrez <strong class='text-white'>Application Settings &rsaquo; Transfers &amp; Payments</strong> dans l'application web Tradovate et consultez le statut de votre retrait existant. Confirmez le libellé exact de l'onglet dans votre version actuelle, la formulation évolue avec le temps." },
        { title: "Vérifier s'il est toujours en cours", html: "Si le virement est en attente ou en cours de traitement, c'est la raison pour laquelle une nouvelle demande est bloquée." },
        { title: "Le laisser arriver", html: "Les retraits ACH demandés avant l'heure limite de midi (heure centrale) sont généralement traités le jour ouvré même et arrivent en environ un jour ouvré. Laissez passer ce délai avant de réessayer." },
        { title: "Soumettre votre retrait suivant", html: "Faites-le une fois que le premier est terminé et que la marque des 24 heures est dépassée." },
      ],
    },
    { type: "heading",text: "Demander le montant complet en un seul virement" },
    {
      type: "steps",
      items: [
        { title: "Planifier le total dont vous avez besoin", html: "Faites-le avant de commencer. Comme vous avez une demande par jour, fractionner un paiement en plusieurs petits virements ne fait que consommer votre unique créneau quotidien dès le premier." },
        { title: "Saisir le montant complet", html: "Saisissez-le dans le champ du montant de retrait, en le maintenant à un niveau égal ou supérieur au minimum de 50 $ et dans les limites de votre solde disponible (réglé)." },
        { title: "Choisir le bon compte de destination", html: "Choisissez parmi vos comptes bancaires liés et vérifiez à deux fois que c'est bien celui que vous souhaitez utiliser." },
        { title: "Soumettre une seule fois", html: "Une seule demande propre pour le montant total vaut mieux que de lutter contre la règle des 24 heures avec une série de demandes partielles." },
      ],
    },
    { type: "heading",text: "Confirmer les retraits importants par SMS" },
    {
      type: "steps",
      items: [
        { title: "Vérifier le numéro de téléphone de votre compte", html: "Faites-le avant de demander un virement important, car le SMS de confirmation y est envoyé." },
        { title: "Surveiller le code", html: "Il arrive après que vous avez soumis un retrait supérieur au seuil d'environ 5,000 $." },
        { title: "L'approuver rapidement", html: "Afin que la demande soit finalisée. Un code non confirmé peut donner l'impression qu'un retrait important est bloqué." },
      ],
    },
    { type: "heading",text: "Choisir le bon canal et le bon moment" },
    {
      type: "steps",
      items: [
        { title: "Utiliser l'ACH pour les comptes bancaires américains", html: "C'est gratuit du côté de Tradovate et cela arrive généralement en environ un jour ouvré lorsqu'il est demandé avant l'heure limite de midi (heure centrale)." },
        { title: "Utiliser un wire pour la rapidité ou hors ACH", html: "Les wires prennent souvent de quelques heures à un jour ouvrable (davantage à l'international), mais votre banque peut facturer des frais de wire même si Tradovate n'en facture pas." },
        { title: "Caler votre demande autour de l'heure limite", html: "Soumettre juste après l'heure limite quotidienne reporte le traitement au jour ouvré suivant, ce qui retarde aussi le moment où votre horloge « un retrait par 24 heures » se libère effectivement." },
      ],
    },
    { type: "heading",text: "Tableau de dépannage" },
    { type: "table", headers: ["Symptôme","Cause probable","Que faire"], rows: [
      ["Deuxième demande de retrait refusée","Le premier retrait est encore en cours de traitement","Attendez que le virement en cours soit terminé, puis refaites la demande"],
      ["Impossible de retirer à nouveau le même jour","Vous avez déjà utilisé votre demande dans la fenêtre de 24 heures","Attendez l'écoulement des 24 heures glissantes depuis la première demande"],
      ["Un petit retrait ne passe pas","En dessous du minimum de 50 $ (ou 50 unités)","Augmentez le montant au moins jusqu'au minimum"],
      ["Un retrait important semble bloqué","Code SMS non confirmé pour une demande supérieure à ~5,000 $","Vérifiez le téléphone enregistré et approuvez le SMS de confirmation"],
      ["Option de retrait absente sur un compte prop","Les paiements passent par la firme, pas par cet écran","Utilisez le processus de paiement et les règles de votre prop firm"],
      ["Retrait retardé d'une journée entière","Demandé après l'heure limite quotidienne de traitement","Soumettez avant l'heure limite de midi (heure centrale) pour un traitement le jour même"],
    ] },
    { type: "heading",text: "Une remarque sur les paiements des prop firms et des comptes d'évaluation" },
    { type: "paragraph",html: "Une grande partie de la confusion autour des retraits Tradovate vient de traders prop qui s'attendent à ce que l'écran de retrait de courtage leur verse leurs profits financés. En général, ce n'est pas le cas. Lorsque vous tradez un compte d'évaluation ou financé d'une firme, le capital ne vous appartient pas pour un retrait direct, la firme possède le compte et gère les paiements selon ses propres conditions. Cela signifie que la limite de courtage d'un retrait par 24 heures ne s'applique même pas à vous ; ce sont la fréquence de paiement de votre firme, son paiement minimum et d'éventuelles règles de régularité ou de détention qui s'appliquent. Ces chiffres varient largement d'une firme à l'autre et selon la taille du compte, la seule source fiable est donc la politique de paiement actuelle de votre firme. Si un paiement n'apparaît pas là où vous l'attendez, c'est le premier endroit où regarder, pas l'onglet de retrait de Tradovate." },
    { type: "heading",text: "Où l'automatisation intervient" },
    { type: "paragraph",html: "Soyons clairs : la limite de retrait de 24 heures est une règle bancaire, et aucun outil tiers ne la modifie. Ce que fait <strong class='text-white'>PickMyTrade</strong> se situe du côté du trading : il achemine vos alertes TradingView vers Tradovate via une connexion stable afin que vos entrées et sorties se déclenchent de manière cohérente et que votre solde finisse là où votre stratégie le prévoyait. Il maintient une seule session persistante, renouvelle automatiquement son jeton d'accès et espace le trafic d'ordres pour rester dans les limites de débit de Tradovate, de sorte que l'exécution qui construit le solde que vous retirez se déroule proprement. Il ne peut pas (et ne va pas) toucher au canal de retrait lui-même, cette partie reste toujours entre vous, Tradovate et votre banque." },
  ], it: [
    { type: "paragraph",html: "Ha incassato un po' di profitto, poi ha provato a spostarne ancora un po', e la seconda richiesta è stata respinta. Non è rotto nulla. Tradovate Le consente di richiedere soltanto <strong class='text-white'>un prelievo per periodo di 24 ore</strong> da un conto di brokeraggio live, e se un prelievo è già in corso, uno nuovo viene negato finché il primo non si è concluso. La soluzione è quasi sempre la stessa: attenda che quel primo trasferimento termini, poi invii la richiesta successiva. Questa guida spiega esattamente cos'è il limite di 24 ore, i pochi motivi per cui un prelievo viene respinto e come pianificare i trasferimenti per non restare in attesa di un pagamento che Le serviva oggi." },
    {
      type: "checklist",
      heading: "Risposta rapida",
      items: [
        "<strong class='text-white'>Un prelievo ogni 24 ore.</strong> Tradovate consente una sola richiesta di prelievo in qualsiasi finestra mobile di 24 ore da un conto live.",
        "<strong class='text-white'>Lasci concludere il primo.</strong> Se un prelievo è ancora in elaborazione, una seconda richiesta viene negata finché non si conclude. Questa è la causa numero uno di un secondo prelievo respinto.",
        "<strong class='text-white'>Li accorpi.</strong> Poiché ha un solo tentativo al giorno, richieda l'intero importo necessario in un unico trasferimento invece di frazionarlo.",
        "<strong class='text-white'>Tenga conto del minimo.</strong> La soglia è di 50 $ (o 50 unità della valuta). Qualsiasi importo inferiore non andrà a buon fine.",
        "<strong class='text-white'>I prelievi elevati richiedono l'approvazione via SMS.</strong> Le richieste superiori a circa 5,000 $ attivano una conferma tramite messaggio di testo al telefono del Suo conto.",
        "<strong class='text-white'>I conti prop sono diversi.</strong> I pagamenti dei conti di valutazione e finanziati passano dal sistema di pagamento della Sua firm, non da questa schermata, e seguono le regole proprie della firm.",
      ],
    },
    { type: "heading",text: "Cosa significa davvero il limite «un prelievo ogni 24 ore»" },
    { type: "paragraph",html: "È un controllo sul canale di uscita del denaro, non un difetto della piattaforma. Tradovate elabora i prelievi dal Suo conto di brokeraggio live verso un conto bancario collegato tramite ACH (per i residenti negli Stati Uniti) o tramite wire, e La limita a una richiesta per periodo di 24 ore. Il motivo è pratico: ogni prelievo deve passare attraverso un processo bancario e di compensazione, e lasciar accumulare richieste sovrapposte renderebbe quella riconciliazione confusa e lenta. Per questo la piattaforma Le consente una richiesta alla volta." },
    { type: "paragraph",html: "Nella pratica quotidiana, questo significa che una volta inviato un prelievo, quella è la Sua richiesta per la finestra. Se prova a inviarne un'altra prima che la prima sia conclusa, verrà bloccato. Non è una penale e non tocca il denaro già in viaggio. Significa solo che il trasferimento successivo attende il suo turno. Una volta concluso il primo prelievo e trascorso l'orologio delle 24 ore, può richiederne un altro." },
    { type: "heading",text: "Perché il Suo prelievo è stato negato" },
    { type: "heading",text: "1. Il Suo primo prelievo è ancora in elaborazione" },
    { type: "paragraph",html: "È il colpevole abituale. Ha richiesto un prelievo un'ora fa, sta ancora attraversando la pipeline ACH o wire, e ora una seconda richiesta non viene accettata. La piattaforma vede un prelievo attivo e rifiuta di metterne in coda un altro. Non c'è nulla da correggere se non la pazienza: attenda che il trasferimento in corso arrivi e la richiesta successiva andrà a buon fine." },
    { type: "heading",text: "2. Ha già usato la Sua finestra" },
    { type: "paragraph",html: "Anche se il primo prelievo si è concluso rapidamente, l'orologio delle 24 ore è partito quando lo ha inviato, non quando è stato regolato. Se è stato pagato questa mattina e vuole di più nel pomeriggio, potrebbe essere ancora nella stessa finestra. Il contatore si azzera in modo mobile, quindi programmi la richiesta successiva per dopo che sono trascorse le 24 ore complete." },
    { type: "heading",text: "3. È sotto il minimo" },
    { type: "paragraph",html: "Il prelievo minimo di Tradovate è di 50 $, ovvero 50 unità della valuta richiesta per i conti non in USD. Se chiede meno di questo, la richiesta semplicemente non viene elaborata. Se un piccolo prelievo continua a fallire e ha escluso la regola delle 24 ore, controlli l'importo: questa soglia coglie chi cerca di ritirare un saldo residuo di importo irregolare." },
    { type: "heading",text: "4. Un prelievo elevato è in attesa della conferma via SMS" },
    { type: "paragraph",html: "I prelievi superiori a circa 5,000 $ richiedono un passaggio aggiuntivo: Tradovate invia un codice di conferma via SMS al numero di telefono associato al Suo conto, e la richiesta non è completa finché non lo approva. Se il Suo prelievo elevato sembra bloccato, potrebbe essere in attesa di quel messaggio non confermato, soprattutto se il numero registrato non è aggiornato." },
    { type: "heading",text: "5. È un conto prop firm o di valutazione" },
    { type: "paragraph",html: "Se opera con un conto finanziato o di valutazione tramite una prop firm, la schermata di prelievo che sta guardando potrebbe non essere quella che La paga. I pagamenti prop passano attraverso il sistema di pagamento della firm, con il suo calendario, il pagamento minimo e le regole di frequenza, che variano in base alla firm e alla dimensione del conto. Un &ldquo;prelievo&rdquo; che non va a buon fine su un conto prop è spesso semplicemente il caso di un percorso sbagliato. Verifichi la politica di pagamento attuale della Sua firm prima di presumere che si tratti di un limite di Tradovate." },
    { type: "heading",text: "Come gestire il limite di 24 ore: passo dopo passo" },
    { type: "heading",text: "Attendere il completamento del primo prelievo" },
    {
      type: "steps",
      items: [
        { title: "Aprire Transfers &amp; Payments", html: "Apra <strong class='text-white'>Application Settings &rsaquo; Transfers &amp; Payments</strong> nell'app web di Tradovate e controlli lo stato del Suo prelievo esistente. Confermi l'etichetta esatta della scheda nella Sua build attuale, la dicitura cambia nel tempo." },
        { title: "Verificare se è ancora in corso", html: "Se il trasferimento è in sospeso o in elaborazione, è per questo che una nuova richiesta viene bloccata." },
        { title: "Lasciarlo arrivare", html: "I prelievi ACH richiesti prima dell'orario limite di mezzogiorno (ora centrale) vengono in genere elaborati lo stesso giorno lavorativo e arrivano in circa un giorno lavorativo. Attenda quella finestra prima di riprovare." },
        { title: "Inviare il prelievo successivo", html: "Lo faccia quando il primo si è concluso ed è trascorso il limite delle 24 ore." },
      ],
    },
    { type: "heading",text: "Richiedere l'intero importo in un unico trasferimento" },
    {
      type: "steps",
      items: [
        { title: "Pianificare il totale necessario", html: "Lo faccia prima di iniziare. Poiché ha una richiesta al giorno, frazionare un pagamento in più piccoli trasferimenti consuma il Suo unico slot giornaliero già con il primo." },
        { title: "Inserire l'importo completo", html: "Lo inserisca nel campo dell'importo di prelievo, mantenendolo pari o superiore al minimo di 50 $ e entro il Suo saldo disponibile (regolato)." },
        { title: "Scegliere il conto di destinazione corretto", html: "Scelga tra i Suoi conti bancari collegati e ricontrolli che sia quello che intende usare." },
        { title: "Inviare una sola volta", html: "Un'unica richiesta pulita per l'intero importo è meglio che combattere la regola delle 24 ore con una serie di richieste parziali." },
      ],
    },
    { type: "heading",text: "Confermare i prelievi elevati via SMS" },
    {
      type: "steps",
      items: [
        { title: "Verificare il numero di telefono del Suo conto", html: "Lo faccia prima di richiedere un trasferimento importante, poiché il messaggio di conferma viene inviato lì." },
        { title: "Attendere il codice", html: "Arriva dopo che ha inviato un prelievo superiore alla soglia di circa 5,000 $." },
        { title: "Approvarlo tempestivamente", html: "Così che la richiesta si completi. Un codice non confermato può far sembrare bloccato un prelievo elevato." },
      ],
    },
    { type: "heading",text: "Scegliere il canale e i tempi giusti" },
    {
      type: "steps",
      items: [
        { title: "Usare l'ACH per i conti bancari statunitensi", html: "È gratuito dal lato di Tradovate e in genere arriva in circa un giorno lavorativo se richiesto prima dell'orario limite di mezzogiorno (ora centrale)." },
        { title: "Usare un wire per la velocità o per situazioni non ACH", html: "I wire spesso richiedono da poche ore a un giorno lavorativo (di più per l'estero), ma la Sua banca potrebbe addebitare una commissione per il wire anche se Tradovate non lo fa." },
        { title: "Calibrare la richiesta attorno all'orario limite", html: "Inviare subito dopo l'orario limite giornaliero sposta l'elaborazione al giorno lavorativo successivo, il che ritarda anche il momento in cui il Suo orologio di un prelievo ogni 24 ore si libera effettivamente." },
      ],
    },
    { type: "heading",text: "Tabella di risoluzione dei problemi" },
    { type: "table", headers: ["Sintomo","Causa probabile","Cosa fare"], rows: [
      ["Seconda richiesta di prelievo negata","Il primo prelievo è ancora in elaborazione","Attenda che il trasferimento in corso si concluda, poi richieda di nuovo"],
      ["Impossibile prelevare di nuovo lo stesso giorno","Ha già usato la Sua richiesta nella finestra di 24 ore","Attenda che trascorrano le 24 ore mobili dalla prima richiesta"],
      ["Un piccolo prelievo non va a buon fine","Sotto il minimo di 50 $ (o 50 unità)","Aumenti l'importo almeno fino al minimo"],
      ["Un prelievo elevato sembra bloccato","Codice SMS non confermato per una richiesta superiore a ~5,000 $","Controlli il telefono registrato e approvi la conferma via messaggio di testo"],
      ["Opzione di prelievo mancante su un conto prop","I pagamenti passano dalla firm, non da questa schermata","Usi il processo di pagamento e le regole della Sua prop firm"],
      ["Prelievo ritardato di un giorno intero","Richiesto dopo l'orario limite giornaliero di elaborazione","Invii prima dell'orario limite di mezzogiorno (ora centrale) per l'elaborazione lo stesso giorno"],
    ] },
    { type: "heading",text: "Una nota sui pagamenti delle prop firm e dei conti di valutazione" },
    { type: "paragraph",html: "Molta confusione sui prelievi Tradovate nasce dai trader prop che si aspettano che la schermata dei prelievi di brokeraggio paghi i loro profitti finanziati. Di solito non lo fa. Quando opera con un conto di valutazione o finanziato di una firm, il capitale non è Suo da prelevare direttamente, la firm possiede il conto e gestisce i pagamenti secondo le proprie condizioni. Ciò significa che il limite di brokeraggio di un prelievo ogni 24 ore non si applica nemmeno a Lei; si applicano invece la frequenza di pagamento della Sua firm, il pagamento minimo ed eventuali regole di coerenza o di detenzione. Quei numeri variano molto da firm a firm e in base alla dimensione del conto, quindi l'unica fonte affidabile è la politica di pagamento attuale della Sua firm. Se un pagamento non compare dove se lo aspetta, quello è il primo posto in cui guardare, non la scheda dei prelievi di Tradovate." },
    { type: "heading",text: "Dove si inserisce l'automazione" },
    { type: "paragraph",html: "Vale la pena essere sinceri: il limite di prelievo di 24 ore è una regola bancaria e nessuno strumento di terze parti la cambia. Ciò che fa <strong class='text-white'>PickMyTrade</strong> riguarda il lato trading: instrada i Suoi alert di TradingView verso Tradovate tramite un'unica connessione stabile, in modo che ingressi e uscite scattino in modo coerente e il Suo saldo finisca dove la Sua strategia intendeva. Mantiene un'unica sessione persistente, rinnova automaticamente il proprio token di accesso e distanzia il traffico degli ordini per restare entro i limiti di frequenza di Tradovate, così l'esecuzione che costruisce il saldo che sta prelevando procede senza intoppi. Non può (e non vuole) toccare il canale di prelievo stesso, quella parte è sempre tra Lei, Tradovate e la Sua banca." },
  ] },
  ctaHeading: { en: "Automate the Trading Side", de: "Automatisieren Sie die Handelsseite", es: "Automatice el lado del trading", fr: "Automatisez le côté trading", it: "Automatizzi il lato trading" },
  ctaText: { en: "Automate your Tradovate entries and exits from TradingView with one reliable connection, so the balance you're withdrawing gets there cleanly.", de: "Automatisieren Sie Ihre Tradovate-Einstiege und -Ausstiege aus TradingView mit einer zuverlässigen Verbindung, damit das Guthaben, das Sie auszahlen, sauber dort ankommt.", es: "Automatice sus entradas y salidas de Tradovate desde TradingView con una conexión fiable, para que el saldo que está retirando llegue sin problemas.", fr: "Automatisez vos entrées et sorties Tradovate depuis TradingView avec une seule connexion fiable, afin que le solde que vous retirez arrive proprement.", it: "Automatizzi gli ingressi e le uscite di Tradovate da TradingView con un'unica connessione affidabile, così il saldo che sta prelevando arriva correttamente." },
  ctaButtonText: { en: "Start Your Free 7-Day Trial", de: "Starten Sie Ihre kostenlose 7-Tage-Testphase", es: "Comience su prueba gratuita de 7 días", fr: "Commencez votre essai gratuit de 7 jours", it: "Inizi la prova gratuita di 7 giorni" },
  ctaUrl: "https://app.pickmytrade.trade/?register=true&utm_source=content&utm_medium=debugging",
  faqHeading: { en: "Frequently Asked Questions", de: "Häufig gestellte Fragen", es: "Preguntas frecuentes", fr: "Questions fréquentes", it: "Domande frequenti" },
  faqs: { en: [
    { q: "Why can I only make one withdrawal per 24 hours on Tradovate?", a: "Tradovate caps live brokerage withdrawals to one request per 24-hour period. It's a banking control on the transfer rail, not a bug. If a withdrawal is already in progress, a second request is denied until the first one clears, so the fix is simply to wait." },
    { q: "How long do I have to wait before I can withdraw again?", a: "Wait until your first withdrawal finishes processing, and until the 24-hour window since that request has passed. ACH requested before the midday Central cutoff usually processes the same business day and lands in about one business day. Wires typically move within a few hours to a working day, longer for international." },
    { q: "Why was my second withdrawal request denied?", a: "The most common reason is that your first withdrawal is still in progress, so the platform blocks a new one until it completes. You may also have already used your one request inside the current 24-hour window, dropped below the minimum withdrawal amount, or not yet confirmed a large withdrawal by SMS." },
    { q: "Does the one-per-24-hours limit apply to prop firm payouts?", a: "Prop firm and evaluation account payouts run through the firm's own payout system, not Tradovate's brokerage withdrawal screen, so the firm's payout schedule, minimums, and frequency rules apply instead. These vary by firm and account size, so check your firm's current payout policy rather than assuming Tradovate's brokerage limit." },
    { q: "Why does my withdrawal ask for an SMS code?", a: "Larger withdrawals, generally those above $5,000, require confirmation through a text message sent to the phone number on your account. Approving that code is part of completing the request, so make sure the number on file is current before you submit a big transfer." },
    { q: "What is the minimum I can withdraw from Tradovate?", a: "The minimum withdrawal is $50, or 50 units of the requested currency if you're not withdrawing in USD. Requests below that floor won't go through, which can look like a rejected withdrawal even when nothing else is wrong." },
  ], de: [
    { q: "Warum kann ich bei Tradovate nur eine Auszahlung pro 24 Stunden vornehmen?", a: "Tradovate begrenzt Auszahlungen von Live-Brokerage-Konten auf eine Anfrage pro 24-Stunden-Zeitraum. Das ist eine Bankenkontrolle auf dem Überweisungsweg, kein Fehler. Läuft bereits eine Auszahlung, wird eine zweite Anfrage abgelehnt, bis die erste abgeschlossen ist. Die Lösung besteht also schlicht im Abwarten." },
    { q: "Wie lange muss ich warten, bis ich erneut auszahlen kann?", a: "Warten Sie, bis Ihre erste Auszahlung vollständig verarbeitet ist und das 24-Stunden-Fenster seit dieser Anfrage abgelaufen ist. ACH-Überweisungen, die vor der Mittags-Cutoff-Zeit (Central Time) beauftragt werden, werden in der Regel am selben Geschäftstag verarbeitet und kommen etwa einen Geschäftstag später an. Überweisungen per Wire laufen typischerweise innerhalb weniger Stunden bis zu einem Arbeitstag, international länger." },
    { q: "Warum wurde meine zweite Auszahlungsanfrage abgelehnt?", a: "Der häufigste Grund ist, dass Ihre erste Auszahlung noch in Bearbeitung ist, sodass die Plattform eine neue blockiert, bis sie abgeschlossen ist. Möglicherweise haben Sie auch bereits Ihre eine Anfrage im aktuellen 24-Stunden-Fenster genutzt, den Mindestauszahlungsbetrag unterschritten oder eine große Auszahlung noch nicht per SMS bestätigt." },
    { q: "Gilt das Limit von einer Auszahlung pro 24 Stunden auch für Prop-Firm-Auszahlungen?", a: "Auszahlungen von Prop-Firm- und Evaluierungskonten laufen über das eigene Auszahlungssystem der Firma, nicht über den Brokerage-Auszahlungsbildschirm von Tradovate. Es gelten daher der Auszahlungsplan, die Mindestbeträge und die Häufigkeitsregeln der Firma. Diese unterscheiden sich je nach Firma und Kontogröße. Prüfen Sie daher die aktuelle Auszahlungsrichtlinie Ihrer Firma, statt das Brokerage-Limit von Tradovate anzunehmen." },
    { q: "Warum verlangt meine Auszahlung einen SMS-Code?", a: "Größere Auszahlungen, in der Regel über 5,000 $, erfordern eine Bestätigung per Textnachricht an die Telefonnummer in Ihrem Konto. Die Freigabe dieses Codes gehört zum Abschluss der Anfrage. Stellen Sie daher sicher, dass die hinterlegte Nummer aktuell ist, bevor Sie eine große Überweisung einreichen." },
    { q: "Was ist der Mindestbetrag für eine Auszahlung bei Tradovate?", a: "Die Mindestauszahlung beträgt 50 $ bzw. 50 Einheiten der angeforderten Währung, wenn Sie nicht in USD auszahlen. Anfragen unterhalb dieser Untergrenze werden nicht ausgeführt, was wie eine abgelehnte Auszahlung aussehen kann, obwohl sonst nichts falsch ist." },
  ], es: [
    { q: "¿Por qué solo puedo hacer una retirada cada 24 horas en Tradovate?", a: "Tradovate limita las retiradas de cuentas de corretaje en vivo a una solicitud por período de 24 horas. Es un control bancario sobre el canal de transferencia, no un error. Si ya hay una retirada en curso, una segunda solicitud se deniega hasta que la primera se complete, así que la solución es simplemente esperar." },
    { q: "¿Cuánto tengo que esperar antes de poder retirar de nuevo?", a: "Espere a que su primera retirada termine de procesarse y a que haya pasado la ventana de 24 horas desde esa solicitud. Un ACH solicitado antes del cierre de mediodía (hora central) suele procesarse el mismo día hábil y llegar en aproximadamente un día hábil. Las transferencias por wire suelen tardar de unas pocas horas a un día laborable, más en el caso internacional." },
    { q: "¿Por qué se denegó mi segunda solicitud de retirada?", a: "El motivo más común es que su primera retirada sigue en curso, por lo que la plataforma bloquea una nueva hasta que se complete. También es posible que ya haya usado su única solicitud dentro de la ventana actual de 24 horas, que haya quedado por debajo del importe mínimo de retirada o que aún no haya confirmado por SMS una retirada grande." },
    { q: "¿El límite de una retirada por 24 horas se aplica a los pagos de las prop firms?", a: "Los pagos de cuentas de prop firms y de evaluación se tramitan por el propio sistema de pagos de la firma, no por la pantalla de retiradas de corretaje de Tradovate, por lo que se aplican el calendario de pagos, los mínimos y las reglas de frecuencia de la firma. Estos varían según la firma y el tamaño de la cuenta, así que consulte la política de pagos vigente de su firma en lugar de asumir el límite de corretaje de Tradovate." },
    { q: "¿Por qué mi retirada solicita un código por SMS?", a: "Las retiradas más grandes, en general las superiores a 5,000 $, requieren confirmación mediante un mensaje de texto enviado al número de teléfono de su cuenta. Aprobar ese código forma parte de completar la solicitud, así que asegúrese de que el número registrado esté actualizado antes de enviar una transferencia grande." },
    { q: "¿Cuál es el mínimo que puedo retirar de Tradovate?", a: "La retirada mínima es de 50 $, o 50 unidades de la moneda solicitada si no retira en USD. Las solicitudes por debajo de ese límite no se procesan, lo que puede parecer una retirada rechazada aunque no haya ningún otro problema." },
  ], fr: [
    { q: "Pourquoi ne puis-je effectuer qu'un seul retrait par 24 heures sur Tradovate ?", a: "Tradovate limite les retraits des comptes de courtage en réel à une demande par période de 24 heures. C'est un contrôle bancaire sur le canal de virement, pas un bug. Si un retrait est déjà en cours, une seconde demande est refusée jusqu'à ce que le premier soit terminé ; la solution consiste donc simplement à attendre." },
    { q: "Combien de temps dois-je attendre avant de pouvoir retirer à nouveau ?", a: "Attendez que votre premier retrait ait fini d'être traité et que la fenêtre de 24 heures depuis cette demande soit écoulée. Un ACH demandé avant l'heure limite de midi (heure centrale) est généralement traité le jour ouvré même et arrive en environ un jour ouvré. Les virements par wire prennent en général de quelques heures à un jour ouvrable, davantage à l'international." },
    { q: "Pourquoi ma deuxième demande de retrait a-t-elle été refusée ?", a: "La raison la plus fréquente est que votre premier retrait est toujours en cours, de sorte que la plateforme en bloque un nouveau tant qu'il n'est pas terminé. Il se peut aussi que vous ayez déjà utilisé votre unique demande dans la fenêtre de 24 heures en cours, que vous soyez passé sous le montant minimum de retrait ou que vous n'ayez pas encore confirmé par SMS un retrait important." },
    { q: "La limite d'un retrait par 24 heures s'applique-t-elle aux paiements des prop firms ?", a: "Les paiements des comptes de prop firms et d'évaluation passent par le propre système de paiement de la firme, et non par l'écran de retrait de courtage de Tradovate ; ce sont donc le calendrier de paiement, les minimums et les règles de fréquence de la firme qui s'appliquent. Ils varient selon la firme et la taille du compte ; consultez donc la politique de paiement actuelle de votre firme plutôt que de supposer la limite de courtage de Tradovate." },
