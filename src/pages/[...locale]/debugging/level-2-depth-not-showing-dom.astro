---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "level-2-depth-not-showing-dom";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/debugging/${SLUG}`;

const META_TITLE = "Tradovate Level 2 Depth Not Showing in DOM";
const META_DESCRIPTION =
  "Tradovate DOM stuck on one level of depth? Re-add the ladder, confirm your Level 2 add-on and monthly renewal, and learn when to report it to support.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Tradovate Level-2-Tiefe wird im DOM nicht angezeigt", es: "La profundidad Level 2 de Tradovate no aparece en el DOM", fr: "La profondeur Level 2 de Tradovate ne s'affiche pas dans le DOM", it: "La profondità Level 2 di Tradovate non compare nel DOM" },
  dek: { en: "Your Tradovate DOM shows a single bid and ask instead of a stacked ladder, and nothing you click brings the depth back. Here's why Level 2 collapses to one level and how to restore it in a few minutes.", de: "Ihr Tradovate-DOM zeigt nur ein einziges Bid und Ask statt einer gestaffelten Leiter, und kein Klick bringt die Tiefe zurück. Hier erfahren Sie, warum Level 2 auf eine Ebene zusammenfällt und wie Sie es in wenigen Minuten wiederherstellen.", es: "Su DOM de Tradovate muestra un único bid y ask en lugar de una escalera apilada, y nada de lo que pulsa devuelve la profundidad. Le explicamos por qué Level 2 se reduce a un solo nivel y cómo restaurarlo en pocos minutos.", fr: "Votre DOM Tradovate affiche un seul bid et un seul ask au lieu d'une échelle empilée, et rien de ce que vous cliquez ne ramène la profondeur. Voici pourquoi Level 2 se réduit à un seul niveau et comment le rétablir en quelques minutes.", it: "Il Suo DOM di Tradovate mostra un solo bid e un solo ask invece di una ladder impilata, e nulla di ciò che clicca riporta la profondità. Ecco perché Level 2 si riduce a un solo livello e come ripristinarlo in pochi minuti." },
  readTime: { en: "7 min read", de: "7 Min. Lesezeit", es: "Lectura de 7 min", fr: "Lecture : 7 min", it: "Lettura di 7 min" },
  lastUpdated: "2026-07-10",
  blocks: { en: [
    { type: "paragraph", html: "You open the DOM to read order flow, and instead of the stacked ladder you're used to, there's a single bid and a single ask staring back at you. No depth, no queue sizes building up above and below the market, just best bid, best ask, and nothing else. On a contract like ES that normally shows a full column of resting orders, that's jarring, especially if you're paying for Level 2 and nothing on your end has changed. The good news is that most cases trace back to one of a few predictable causes, and you can clear them in a couple of minutes. This guide walks the fastest path: confirm the Level 2 add-on, force it to activate, re-add the ladder, and, if it's still collapsed to one level with everything correct, hand it to support, because that last case is on the platform, not you." },
    {
      type: "checklist",
      heading: "Quick Checklist for Missing DOM Depth",
      items: [
        "<strong class='text-white'>Confirm your Level 2 subscription is active for this month.</strong> Depth data is billed per calendar month and expires on the last day, so a lapse on the 1st is the number-one cause.",
        "<strong class='text-white'>Log out and log back in.</strong> A freshly renewed subscription often doesn't kick in until you restart the session.",
        "<strong class='text-white'>Remove the DOM panel and add a new one.</strong> A stale panel can keep showing a single level even after the feed is back.",
        "<strong class='text-white'>Load a liquid front-month contract.</strong> Continuous or expired symbols and thin back-months look empty even with depth working.",
        "<strong class='text-white'>Remember the ceiling is about 10 levels.</strong> More than roughly 10 above and below isn't available from the data feed, but far fewer than 10 means something's wrong.",
        "<strong class='text-white'>On a prop/evaluation account, contact the firm.</strong> They control your market data, so they have to enable or fix Level 2.",
        "<strong class='text-white'>Still one level with everything correct? Report it to support.</strong> That's a platform-side glitch, not a setting you can change.",
      ],
    },
    { type: "heading", text: "What Level 2 Depth in the DOM Actually Is" },
    { type: "paragraph", html: "It helps to be precise about what's missing. Level 1 data is the top of the book: the best bid, the best ask, and the last traded price. That's enough to place and fill orders, and it's what a lot of quote windows and charts run on. Level 2, market depth, is the rest of the book: the stack of resting bids below the market and resting asks above it, with the size sitting at each price. The DOM (also called the ladder or SuperDOM) is the one place that depth actually renders. If you're only looking at a chart or a quote board, you'd never notice Level 2 was gone. On the ladder, it's obvious the moment it drops." },
    { type: "paragraph", html: "So &ldquo;Level 2 not showing in the DOM&rdquo; almost always means the ladder has fallen back to Level 1. It's still showing you the best bid and ask, that top-of-book quote never needs the depth add-on, but the columns of resting size that make the DOM useful have collapsed to a single row each way." },
    { type: "paragraph", html: "One thing to get straight before you start troubleshooting: the DOM isn't designed to show unlimited depth. It typically renders about 10 price levels above and below the current price, and that number is set by the upstream market-data provider, not by a slider in your settings. A handful of the most liquid contracts can show deeper than 10, while micro contracts are generally capped right at 10. That matters here because the fix is different depending on what you're seeing. If you've got roughly 10 levels and want 30, that's a data-feed limit you can't change. If you had 10 and now you have one, that's a broken subscription or a stale panel, and that's what the rest of this guide fixes." },
    { type: "heading", text: "Top Causes of Missing DOM Depth in 2026" },
    { type: "heading", text: "1. The Level 2 subscription lapsed at month-end" },
    { type: "paragraph", html: "This is the first thing to check because it's the most common, and it's sneaky. Market depth is a paid add-on, and exchange data feeds are billed by the calendar month. When you buy Level 2 mid-month, you're buying it for that month only, it expires on the last day, and the charge renews on the 1st of the next month. Feeds aren't prorated, so the full cost hits at the start of each month regardless of when you first subscribed. If that renewal payment doesn't clear, or the subscription simply wasn't set to continue, the depth feed drops overnight and your DOM wakes up on the 1st showing one level each way. Nothing on your machine changed, which is exactly why it's confusing." },
    { type: "heading", text: "2. The subscription is active but the session hasn't picked it up" },
    { type: "paragraph", html: "Even when the subscription is genuinely active, the live session you're sitting in may have connected before the depth feed switched on. Market data activation isn't always instant inside an open session, a renewal or a fresh purchase frequently needs a full logout and login before the DOM starts receiving the depth stream. If you just resubscribed and the ladder is still flat, you probably haven't restarted the session yet." },
    { type: "heading", text: "3. The DOM panel is in a stale state" },
    { type: "paragraph", html: "Panels hold onto their own state. A DOM that was open when the feed dropped can keep displaying its last, single-level picture even after depth is flowing again. Removing that panel and dropping in a fresh one forces the ladder to rebuild against the current feed. This is the step that gets skipped most often, and it's why a subscription that's clearly active can still look broken." },
    { type: "heading", text: "4. Wrong, expired, or thin contract loaded" },
    { type: "paragraph", html: "Sometimes the depth is fine and the symbol is the problem. A continuous chart symbol, an expired month, or an illiquid back-month contract can show almost nothing in the ladder simply because there aren't many resting orders, or because that symbol doesn't carry tradable depth. If depth looks empty, load the current, actively traded front-month contract for a liquid instrument and check again before you assume the feed is broken." },
    { type: "heading", text: "5. It's a prop or evaluation account" },
    { type: "paragraph", html: "On a prop firm or evaluation account, you don't own the market-data relationship, the firm does. That means you usually can't self-subscribe to Level 2 from inside the platform the way a retail account holder can, and if depth isn't turned on, only the firm can enable it. Whether Level 2 is even included varies by firm and account type, so check your firm's current rules and reach out to their support rather than hunting for a subscribe button that isn't there for you." },
    { type: "heading", text: "6. A genuine platform-side glitch" },
    { type: "paragraph", html: "Then there's the case that started this whole guide: the subscription is confirmed active, you've restarted the session, you've re-added the DOM, and you've loaded a liquid front-month, and the ladder still shows exactly one level each way. When every common cause is ruled out, you're looking at something on the platform's side. That's not a setting you can fix, and the right move is to report it to support with specifics." },
    { type: "heading", text: "How to Fix Missing DOM Depth: Step-by-Step" },
    { type: "heading", text: "Confirm and renew your Level 2 subscription" },
    {
      type: "steps",
      items: [
        { title: "Open Application Settings", html: "Open <strong class='text-white'>Application Settings</strong> from the top of the Tradovate web platform." },
        { title: "Find the Market Data section", html: "Go to the <strong class='text-white'>Subscriptions</strong> tab and find the <strong class='text-white'>Market Data</strong> section. (Older builds surface market data feeds under an <strong class='text-white'>Add-Ons</strong> area instead, confirm the exact label in your current version.)" },
        { title: "Check and resubscribe if lapsed", html: "Check whether the <strong class='text-white'>Level 2</strong> feed for your exchange is listed as active for the current month. If it lapsed, click <strong class='text-white'>Subscribe</strong>, pick the exchange(s) you trade, review the monthly cost, and submit, then accept the terms to complete it." },
        { title: "Confirm the renewal continues", html: "Keep in mind the feed is monthly and renews on the 1st, so if this keeps happening at month-end, make sure the renewal is set to continue." },
      ],
    },
    { type: "heading", text: "Log out and log back in to activate it" },
    { type: "paragraph", html: "A new or renewed feed usually needs a fresh session before the DOM starts receiving depth." },
    {
      type: "steps",
      items: [
        { title: "Fully log out", html: "Fully <strong class='text-white'>log out</strong> of the platform, don't just refresh a tab." },
        { title: "Sign back in", html: "Sign back in and give the connection a moment to establish." },
        { title: "Recheck the DOM", html: "Open a DOM and check whether the ladder is now populating with depth on both sides." },
      ],
    },
    { type: "heading", text: "Re-add the DOM and load a liquid contract" },
    { type: "paragraph", html: "Clear any stale panel state and point it at a symbol that actually carries depth." },
    {
      type: "steps",
      items: [
        { title: "Remove the existing DOM panel", html: "<strong class='text-white'>Remove the existing DOM panel</strong> from your workspace." },
        { title: "Add a fresh DOM panel", html: "<strong class='text-white'>Add a fresh Depth of Market / SuperDOM panel</strong> so it rebuilds against the live feed." },
        { title: "Load a liquid front-month contract", html: "Load the <strong class='text-white'>current front-month contract</strong> for a liquid instrument (for example, the active ES or NQ month) rather than a continuous or expired symbol." },
        { title: "Confirm depth populates", html: "Watch whether the stacked bids and asks fill in, you should see up to roughly 10 levels each way." },
      ],
    },
    { type: "heading", text: "For prop accounts, contact your firm" },
    { type: "paragraph", html: "If you're on an evaluation or funded prop account, skip the self-subscribe steps." },
    {
      type: "steps",
      items: [
        { title: "Confirm with your firm", html: "Confirm with your firm whether Level 2 depth is included on your account type, this varies by firm and account size, so check their current rules." },
        { title: "Ask the firm to enable the feed", html: "Ask the firm's support to <strong class='text-white'>enable or fix the market depth feed</strong> on your account." },
        { title: "Log out and re-add the DOM", html: "Once they confirm it's on, log out and back in and re-add the DOM as above." },
      ],
    },
    { type: "heading", text: "Report a persistent single-level glitch to support" },
    { type: "paragraph", html: "When you've done everything and the ladder is still flat, escalate." },
    {
      type: "steps",
      items: [
        { title: "Double-check the basics", html: "Double-check the subscription shows active for the current month and that you've restarted the session and re-added the DOM." },
        { title: "Contact support", html: "<strong class='text-white'>Contact Tradovate support</strong> (or your prop firm, for evaluation accounts) and describe the exact symptom: full depth expected, only one level each way showing." },
        { title: "Include symbol, time, and a screenshot", html: "Include the <strong class='text-white'>symbol, the time, and a screenshot</strong> of the collapsed DOM so they can trace it on their side." },
      ],
    },
    { type: "heading", text: "Troubleshooting Table" },
    {
      type: "table",
      headers: ["Symptom", "What it means", "Fix"],
      rows: [
        ["Depth vanished on the 1st of the month", "Level 2 subscription lapsed at month-end", "Resubscribe under Settings &gt; Subscriptions &gt; Market Data; confirm it renews monthly"],
        ["Just resubscribed, still one level", "Session connected before the feed switched on", "Log out fully and log back in to activate the depth stream"],
        ["Subscription active but DOM stays flat", "Stale DOM panel state", "Remove the DOM and add a fresh one so it rebuilds"],
        ["Ladder looks empty on one symbol", "Continuous, expired, or thin contract", "Load the current liquid front-month contract"],
        ["No subscribe option on a prop account", "The firm controls market data", "Ask the prop firm to enable Level 2 on your account"],
        ["Only about 10 levels ever show", "Data-provider depth ceiling, not a bug", "Nothing to fix; more than ~10 levels isn't available"],
        ["One level with everything correct", "Platform-side glitch", "Report to support with symbol, time, and a screenshot"],
      ],
    },
    { type: "heading", text: "Don't Let a Blank Ladder Cost You the Trade" },
    { type: "paragraph", html: "A collapsed DOM is worst at exactly the wrong moment, you're waiting on depth to time an entry and the ladder gives you nothing to read. If your strategy has a clear, rule-based trigger, you don't have to sit hostage to whether the depth feed is cooperating. PickMyTrade routes your entries and exits from the signal itself, so a flat ladder or a lapsed data feed doesn't strand you:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Signal-based execution</strong>, orders fire from your TradingView strategy the moment your condition triggers, whether or not the DOM is rendering depth.",
        "<strong class='text-white'>Server-side routing</strong>, alerts route to Tradovate from PickMyTrade's servers, independent of what your local platform panels are doing.",
        "<strong class='text-white'>Multi-account sync</strong>, the same entry and exit mirror across several Tradovate accounts at once, no per-ladder clicking.",
        "<strong class='text-white'>Rate-limit-safe order flow</strong>, orders are spaced so nothing bounces off Tradovate's request limits.",
      ],
    },
  ], de: [
    { type: "paragraph",html: "Sie öffnen das DOM, um den Orderfluss zu lesen, und statt der gewohnten gestaffelten Leiter starrt Sie ein einzelnes Bid und ein einzelnes Ask an. Keine Tiefe, keine Warteschlangengrößen, die sich oberhalb und unterhalb des Marktes aufbauen, nur bestes Bid, bestes Ask und sonst nichts. Bei einem Kontrakt wie ES, der normalerweise eine volle Spalte stehender Orders zeigt, ist das irritierend, besonders wenn Sie für Level 2 bezahlen und sich bei Ihnen nichts geändert hat. Die gute Nachricht: Die meisten Fälle gehen auf eine von wenigen vorhersehbaren Ursachen zurück, und Sie können sie in ein paar Minuten beheben. Diese Anleitung führt Sie auf dem schnellsten Weg: das Level-2-Add-on bestätigen, die Aktivierung erzwingen, die Leiter neu hinzufügen und, falls sie trotz korrekter Einstellungen weiter auf eine Ebene zusammengefallen ist, den Fall an den Support übergeben, denn dieser letzte Fall liegt bei der Plattform, nicht bei Ihnen." },
    {
      type: "checklist",
      heading: "Kurze Checkliste bei fehlender DOM-Tiefe",
      items: [
        "<strong class='text-white'>Bestätigen Sie, dass Ihr Level-2-Abonnement für diesen Monat aktiv ist.</strong> Tiefendaten werden pro Kalendermonat abgerechnet und laufen am letzten Tag ab, ein Ablauf am 1. ist daher die häufigste Ursache.",
        "<strong class='text-white'>Melden Sie sich ab und wieder an.</strong> Ein frisch erneuertes Abonnement greift oft erst, wenn Sie die Sitzung neu starten.",
        "<strong class='text-white'>Entfernen Sie das DOM-Panel und fügen Sie ein neues hinzu.</strong> Ein veraltetes Panel kann weiterhin eine einzelne Ebene zeigen, selbst wenn der Feed wieder da ist.",
        "<strong class='text-white'>Laden Sie einen liquiden Front-Month-Kontrakt.</strong> Fortlaufende oder abgelaufene Symbole und dünne Back-Months wirken leer, selbst wenn die Tiefe funktioniert.",
        "<strong class='text-white'>Denken Sie daran, dass die Obergrenze bei etwa 10 Ebenen liegt.</strong> Mehr als etwa 10 oberhalb und unterhalb liefert der Daten-Feed nicht, deutlich weniger als 10 bedeutet jedoch, dass etwas nicht stimmt.",
        "<strong class='text-white'>Bei einem Prop-/Evaluierungskonto wenden Sie sich an die Firma.</strong> Sie kontrolliert Ihre Marktdaten und muss daher Level 2 aktivieren oder reparieren.",
        "<strong class='text-white'>Immer noch eine Ebene trotz korrekter Einstellungen? Melden Sie es dem Support.</strong> Das ist ein plattformseitiger Fehler und keine Einstellung, die Sie ändern können.",
      ],
    },
    { type: "heading",text: "Was Level-2-Tiefe im DOM tatsächlich ist" },
    { type: "paragraph",html: "Es hilft, genau zu benennen, was fehlt. Level-1-Daten sind die Spitze des Orderbuchs: das beste Bid, das beste Ask und der letzte gehandelte Preis. Das genügt, um Orders zu platzieren und auszuführen, und darauf laufen viele Kursfenster und Charts. Level 2, die Marktdaten-Tiefe, ist der Rest des Orderbuchs: der Stapel stehender Bids unterhalb des Marktes und stehender Asks oberhalb davon, mit der jeweiligen Größe auf jedem Preis. Das DOM (auch Leiter oder SuperDOM genannt) ist der eine Ort, an dem diese Tiefe tatsächlich dargestellt wird. Wenn Sie nur auf einen Chart oder eine Kurstafel schauen, würden Sie nie bemerken, dass Level 2 fehlt. Auf der Leiter fällt es sofort auf, sobald es wegfällt." },
    { type: "paragraph",html: "&ldquo;Level 2 wird im DOM nicht angezeigt&rdquo; bedeutet also fast immer, dass die Leiter auf Level 1 zurückgefallen ist. Sie zeigt Ihnen weiterhin das beste Bid und Ask, diese Spitzenkursnotierung braucht das Tiefen-Add-on nie, doch die Spalten mit stehender Größe, die das DOM nützlich machen, sind auf eine einzige Zeile pro Seite zusammengefallen." },
    { type: "paragraph",html: "Eines sollten Sie klarstellen, bevor Sie mit der Fehlersuche beginnen: Das DOM ist nicht dafür ausgelegt, unbegrenzte Tiefe anzuzeigen. Es stellt typischerweise etwa 10 Preisebenen oberhalb und unterhalb des aktuellen Preises dar, und diese Zahl wird vom vorgelagerten Marktdatenanbieter bestimmt, nicht von einem Regler in Ihren Einstellungen. Einige der liquidesten Kontrakte können tiefer als 10 anzeigen, während Micro-Kontrakte im Allgemeinen genau bei 10 gedeckelt sind. Das ist hier wichtig, weil die Lösung davon abhängt, was Sie sehen. Haben Sie etwa 10 Ebenen und wünschen sich 30, ist das eine Grenze des Daten-Feeds, die Sie nicht ändern können. Hatten Sie 10 und haben jetzt eine, ist das ein defektes Abonnement oder ein veraltetes Panel, und genau das behebt der Rest dieser Anleitung." },
    { type: "heading",text: "Die häufigsten Ursachen für fehlende DOM-Tiefe im Jahr 2026" },
    { type: "heading",text: "1. Das Level-2-Abonnement ist zum Monatsende ausgelaufen" },
    { type: "paragraph",html: "Das ist das Erste, was Sie prüfen sollten, weil es am häufigsten und am heimtückischsten ist. Marktdaten-Tiefe ist ein kostenpflichtiges Add-on, und Börsendaten-Feeds werden nach Kalendermonat abgerechnet. Kaufen Sie Level 2 mitten im Monat, kaufen Sie es nur für diesen Monat, es läuft am letzten Tag ab, und die Gebühr wird am 1. des nächsten Monats erneuert. Feeds werden nicht anteilig berechnet, sodass die vollen Kosten zu Beginn jedes Monats anfallen, unabhängig davon, wann Sie erstmals abonniert haben. Wird diese Verlängerungszahlung nicht verbucht oder war das Abonnement schlicht nicht auf Fortsetzung eingestellt, fällt der Tiefen-Feed über Nacht weg und Ihr DOM zeigt am 1. nur eine Ebene pro Seite. Auf Ihrem Rechner hat sich nichts geändert, genau deshalb ist es verwirrend." },
    { type: "heading",text: "2. Das Abonnement ist aktiv, aber die Sitzung hat es nicht übernommen" },
    { type: "paragraph",html: "Selbst wenn das Abonnement tatsächlich aktiv ist, kann die laufende Sitzung, in der Sie sich befinden, verbunden worden sein, bevor der Tiefen-Feed eingeschaltet wurde. Die Aktivierung von Marktdaten erfolgt innerhalb einer offenen Sitzung nicht immer sofort, eine Verlängerung oder ein Neukauf erfordert häufig eine vollständige Ab- und Anmeldung, bevor das DOM den Tiefenstrom empfängt. Haben Sie gerade neu abonniert und die Leiter ist weiterhin flach, haben Sie die Sitzung wahrscheinlich noch nicht neu gestartet." },
    { type: "heading",text: "3. Das DOM-Panel befindet sich in einem veralteten Zustand" },
    { type: "paragraph",html: "Panels behalten ihren eigenen Zustand. Ein DOM, das offen war, als der Feed wegfiel, kann sein letztes Ein-Ebenen-Bild weiter anzeigen, selbst wenn die Tiefe wieder fließt. Das Entfernen dieses Panels und das Einfügen eines frischen zwingt die Leiter, sich gegen den aktuellen Feed neu aufzubauen. Das ist der Schritt, der am häufigsten übersprungen wird, und der Grund, warum ein eindeutig aktives Abonnement dennoch defekt aussehen kann." },
    { type: "heading",text: "4. Falscher, abgelaufener oder dünner Kontrakt geladen" },
    { type: "paragraph",html: "Manchmal ist die Tiefe in Ordnung und das Symbol das Problem. Ein fortlaufendes Chart-Symbol, ein abgelaufener Monat oder ein illiquider Back-Month-Kontrakt kann in der Leiter fast nichts zeigen, weil es einfach wenige stehende Orders gibt oder weil dieses Symbol keine handelbare Tiefe führt. Sieht die Tiefe leer aus, laden Sie den aktuellen, aktiv gehandelten Front-Month-Kontrakt eines liquiden Instruments und prüfen Sie erneut, bevor Sie annehmen, der Feed sei defekt." },
    { type: "heading",text: "5. Es ist ein Prop- oder Evaluierungskonto" },
    { type: "paragraph",html: "Bei einer Prop Firm oder einem Evaluierungskonto besitzen nicht Sie die Marktdaten-Beziehung, sondern die Firma. Das heißt, Sie können Level 2 in der Regel nicht selbst in der Plattform abonnieren, wie es ein Privatkunde kann, und wenn die Tiefe nicht eingeschaltet ist, kann nur die Firma sie aktivieren. Ob Level 2 überhaupt enthalten ist, hängt von Firma und Kontotyp ab. Prüfen Sie daher die aktuellen Regeln Ihrer Firma und wenden Sie sich an deren Support, statt nach einer Abonnieren-Schaltfläche zu suchen, die es für Sie nicht gibt." },
    { type: "heading",text: "6. Ein echter plattformseitiger Fehler" },
    { type: "paragraph",html: "Dann gibt es den Fall, der diese ganze Anleitung ausgelöst hat: Das Abonnement ist bestätigt aktiv, Sie haben die Sitzung neu gestartet, das DOM neu hinzugefügt und einen liquiden Front-Month geladen, und die Leiter zeigt dennoch genau eine Ebene pro Seite. Sind alle üblichen Ursachen ausgeschlossen, haben Sie es mit etwas auf Seiten der Plattform zu tun. Das ist keine Einstellung, die Sie beheben können, und der richtige Schritt ist, es dem Support mit konkreten Angaben zu melden." },
    { type: "heading",text: "So beheben Sie fehlende DOM-Tiefe: Schritt für Schritt" },
    { type: "heading",text: "Level-2-Abonnement bestätigen und verlängern" },
    {
      type: "steps",
      items: [
        { title: "Application Settings öffnen", html: "Öffnen Sie <strong class='text-white'>Application Settings</strong> am oberen Rand der Tradovate-Webplattform." },
        { title: "Den Bereich Market Data finden", html: "Wechseln Sie zum Reiter <strong class='text-white'>Subscriptions</strong> und suchen Sie den Bereich <strong class='text-white'>Market Data</strong>. (Ältere Builds zeigen Marktdaten-Feeds stattdessen unter einem Bereich <strong class='text-white'>Add-Ons</strong> an, prüfen Sie die genaue Bezeichnung in Ihrer aktuellen Version.)" },
        { title: "Prüfen und bei Ablauf neu abonnieren", html: "Prüfen Sie, ob der <strong class='text-white'>Level 2</strong>-Feed für Ihre Börse für den laufenden Monat als aktiv aufgeführt ist. Ist er abgelaufen, klicken Sie auf <strong class='text-white'>Subscribe</strong>, wählen Sie die Börse(n), die Sie handeln, prüfen Sie die monatlichen Kosten und senden Sie ab, akzeptieren Sie dann die Bedingungen, um den Vorgang abzuschließen." },
        { title: "Bestätigen, dass die Verlängerung fortgesetzt wird", html: "Bedenken Sie, dass der Feed monatlich läuft und am 1. erneuert wird. Passiert das also immer wieder zum Monatsende, stellen Sie sicher, dass die Verlängerung auf Fortsetzung eingestellt ist." },
      ],
    },
    { type: "heading",text: "Ab- und wieder anmelden, um es zu aktivieren" },
    { type: "paragraph",html: "Ein neuer oder erneuerter Feed braucht meist eine frische Sitzung, bevor das DOM Tiefe empfängt." },
    {
      type: "steps",
      items: [
        { title: "Vollständig abmelden", html: "<strong class='text-white'>Melden Sie sich vollständig ab</strong>, aktualisieren Sie nicht nur einen Tab." },
        { title: "Wieder anmelden", html: "Melden Sie sich wieder an und geben Sie der Verbindung einen Moment, sich aufzubauen." },
        { title: "DOM erneut prüfen", html: "Öffnen Sie ein DOM und prüfen Sie, ob sich die Leiter jetzt auf beiden Seiten mit Tiefe füllt." },
