---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "notification-sounds-too-loud";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/debugging/${SLUG}`;

const META_TITLE = "Tradovate Notification Sounds Too Loud, No Control";
const META_DESCRIPTION =
  "Tradovate notification sounds too loud with no volume slider? Lower or mute the alerts with your OS volume mixer and the in-app sound settings.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Tradovate-Benachrichtigungstöne zu laut, keine Lautstärkeregelung", es: "Sonidos de notificación de Tradovate demasiado altos, sin control", fr: "Sons de notification Tradovate trop forts, aucun contrôle", it: "Suoni di notifica Tradovate troppo forti, nessun controllo" },
  dek: { en: "An order fill nearly blows your headset off, and there's no volume slider anywhere in Tradovate to tame it. The real fix lives outside the app, in your operating system's sound controls.", de: "Eine Orderausführung sprengt fast Ihr Headset, und nirgendwo in Tradovate gibt es einen Lautstärkeregler, um das zu bändigen. Die eigentliche Lösung liegt außerhalb der App, in den Soundeinstellungen Ihres Betriebssystems.", es: "Una ejecución de orden casi le revienta los auriculares, y no hay ningún control de volumen en Tradovate para atenuarlo. La solución real está fuera de la aplicación, en los controles de sonido de su sistema operativo.", fr: "Une exécution d'ordre manque de vous exploser le casque, et il n'existe aucun curseur de volume dans Tradovate pour l'atténuer. La vraie solution se trouve en dehors de l'application, dans les commandes de son de votre système d'exploitation.", it: "L'esecuzione di un ordine Le fa quasi esplodere le cuffie, e in Tradovate non c'è alcun cursore del volume per attenuarla. La vera soluzione si trova fuori dall'app, nei controlli audio del Suo sistema operativo." },
  readTime: { en: "6 min read", de: "6 Min. Lesezeit", es: "Lectura de 6 min", fr: "Lecture : 6 min", it: "Lettura di 6 min" },
  lastUpdated: "2026-07-10",
  blocks: { en: [
    { type: "paragraph", html: "You get an order fill and the alert nearly blows your headset off. It's one of the most common gripes about Tradovate, and it's been the same story for years: the default notification sounds are loud, and there's no volume slider anywhere in the platform to tame them. You can change <em>which</em> sound plays and you can switch individual alerts off, but you can't set a level like “half volume.” So if the fill chime keeps making you flinch on every trade, the real fix lives outside the app, in your operating system's sound controls. Here's exactly how to get it down to a sane level without going deaf or trading blind." },
    {
      type: "checklist",
      heading: "Quick Fixes for Loud Tradovate Alerts",
      items: [
        "<strong class='text-white'>Cap the volume per app.</strong> Use the Windows Volume Mixer to pull Tradovate (or your browser) down to a level you can live with, leaving everything else alone.",
        "<strong class='text-white'>Swap to a quieter sound.</strong> Tradovate ships a library of notification sounds. Pick a softer one for the alerts that fire most often.",
        "<strong class='text-white'>Silence the noisy ones.</strong> Toggle off audio for the specific order statuses you don't need announced, and keep only the ones that matter.",
        "<strong class='text-white'>Drop your system volume.</strong> A blunt but instant fix when you just need it quiet right now.",
        "<strong class='text-white'>On mobile, use your phone's volume.</strong> The alert follows your notification/ringer volume, not an in-app setting.",
        "<strong class='text-white'>File a feature request.</strong> A built-in volume slider and custom-sound upload are still on the wish list, the more requests, the better the odds it ships.",
      ],
    },
    { type: "heading", text: "Why There's No Volume Control (and What You Can Actually Change)" },
    { type: "paragraph", html: "Let's be clear about the limitation up front, because it saves you from hunting for a setting that doesn't exist. As of 2026, Tradovate has <strong class='text-white'>no in-app volume control for notification sounds</strong>. There is no slider, no percentage, no “soft/medium/loud” option. What the platform <em>does</em> give you are two levers:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Sound selection.</strong> Each order-status notification can play a different sound, and you choose it from a built-in library of sounds. Some are noticeably gentler than others, so this alone can take a lot of the sting out.",
        "<strong class='text-white'>On/off toggles.</strong> You can turn notifications on or off globally, and you can toggle audio for each order status individually, order filled, order rejected, order cancelled, and so on.",
      ],
    },
    { type: "paragraph", html: "What you <strong class='text-white'>can't</strong> do is set a volume level, and you can't upload your own audio file. Both of those have been open feature requests for a long stretch, and neither has shipped. So the honest answer to “how do I turn the volume down in Tradovate” is: you don't, at least not from inside Tradovate. You do it in your operating system, where per-app volume control has existed for years." },
    { type: "heading", text: "Fix 1: Cap Tradovate's Volume in the Windows Mixer" },
    { type: "paragraph", html: "This is the fix that actually solves the “too loud” problem, because it lowers Tradovate's sound without dragging down your music, your calls, or anything else. Windows lets you set a separate volume for every app that's making noise." },
    { type: "paragraph", html: "<ol><li><strong class='text-white'>Right-click the speaker icon</strong> in the bottom-right corner of your taskbar and choose <strong class='text-white'>Open Volume Mixer</strong>. (You can also reach it via Settings → System → Sound → Volume Mixer.)</li><li>Make sure Tradovate is running and has just played a sound, so it shows up in the list. Look for the <strong class='text-white'>Tradovate desktop app</strong>, or your <strong class='text-white'>browser</strong> (Chrome, Edge) if you run the web platform.</li><li><strong class='text-white'>Drag that app's slider down</strong> to somewhere around 20–40%. Changes apply instantly, trigger a test notification and adjust until the fill chime is a nudge, not a jump-scare.</li></ol>" },
    { type: "paragraph", html: "The setting is relative to your master volume and it sticks between sessions, so you set it once and forget it. On a Mac, the operating system doesn't offer native per-app volume the way Windows does, you'd lower the overall system volume or use a third-party audio utility to isolate the browser or app. Confirm what's available on your macOS version before relying on it." },
    { type: "heading", text: "Fix 2: Pick a Quieter Sound From the Library" },
    { type: "paragraph", html: "Since you can't change the volume in-app, the next best thing is choosing a sound that isn't as harsh to begin with. Tradovate keeps a library of notification sounds, and you can preview and assign one per order status." },
    { type: "paragraph", html: "<ol><li>Open your <strong class='text-white'>notification settings</strong>. In the web trader this lives under the settings menu, look for a <strong class='text-white'>Notifications</strong> section with an <strong class='text-white'>Audio Notifications</strong> list. (Depending on your build, you may reach it through Preferences or Application Settings; confirm the exact path in your current version.)</li><li>Find the audio notification you want to change, say, <strong class='text-white'>Order Filled</strong>, and click the blue link that shows the current sound.</li><li>The <strong class='text-white'>sound library</strong> opens. Play each option, pick the softest one that still catches your ear, and assign it.</li><li>Repeat for the statuses that fire most often. A gentle “filled” sound plus a distinct “rejected” sound is usually all you need.</li></ol>" },
    { type: "paragraph", html: "Pairing a soft library sound with the per-app volume cap from the first fix gets you most of the way to a calm setup, a sound you can hear without one that makes you wince." },
    { type: "heading", text: "Fix 3: Turn Off the Alerts You Don't Need" },
    { type: "paragraph", html: "A lot of the noise comes from statuses you don't actually care to hear. Every working-order update, cancellation, and modification can carry its own chime, and it adds up fast on an active account. Trim the list down to what matters." },
    { type: "paragraph", html: "<ol><li>In the same <strong class='text-white'>Notifications</strong> settings, open the <strong class='text-white'>advanced</strong> or per-status configuration where each order status is listed separately.</li><li><strong class='text-white'>Toggle off the audio</strong> for the statuses you don't need announced out loud. Many traders keep only “filled” and “rejected” and mute the rest.</li><li>You can usually silence just the <strong class='text-white'>sound</strong> while keeping the on-screen popup, so you still see the event without hearing it. If you want a status gone entirely, turn the whole notification off.</li><li>Labels and layout shift between platform updates, so confirm the exact toggles in your current build before you count on them.</li></ol>" },
    { type: "paragraph", html: "If you're on a call or sharing your screen and just need silence right now, you can switch <strong class='text-white'>all</strong> notifications off from the same panel and flip them back on afterward." },
    { type: "heading", text: "What About Mobile?" },
    { type: "paragraph", html: "On the Tradovate mobile app there's no in-app volume for alerts either, and the loudness rides on your phone's notification and ringer volume. If the app is too loud on your phone, lower the notification volume in your phone's settings, or go into your phone's app-notification controls and mute or remove Tradovate's notifications. That's the same principle as the desktop fix, the control lives in the operating system, not in Tradovate." },
    { type: "heading", text: "Troubleshooting Table" },
    {
      type: "table",
      headers: ["What you want", "Can you do it in Tradovate?", "How to get it"],
      rows: [
        ["Set notification sounds to a specific volume level", "No, no in-app slider exists", "Use the Windows Volume Mixer to set a per-app level"],
        ["Make one app quieter without lowering everything", "No", "Per-app slider in Volume Mixer (Windows); third-party tool on Mac"],
        ["Change which sound plays", "Yes", "Notifications → Audio Notifications → pick from the sound library"],
        ["Silence a specific alert (e.g. order filled)", "Yes", "Toggle off audio for that status in the advanced config"],
        ["Keep the popup but kill the sound", "Yes", "Turn off the audio toggle, leave the notification on"],
        ["Upload your own custom sound file", "No", "Not supported; file a feature request"],
        ["Turn everything off temporarily", "Yes", "Disable notifications globally in settings, re-enable later"],
        ["Quieter alerts on the phone app", "No in-app control", "Lower notification volume in your phone settings"],
      ],
    },
    { type: "heading", text: "Stop Babysitting Alerts Altogether" },
    { type: "paragraph", html: "Here's the deeper issue behind loud notification sounds: if you're relying on an audible chime to tell you a fill happened or an order got rejected, you're chained to the screen and reacting after the fact. When your strategy is automated, the platform doesn't need to shout at you, the execution already happened on your rules. PickMyTrade takes the alert out of the loop:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Signal-based execution</strong>, your TradingView strategy fires the order automatically the moment your condition triggers, so you're not sitting there waiting for a sound to react to.",
        "<strong class='text-white'>Server-side routing</strong>, alerts route to Tradovate from PickMyTrade's servers, so entries and exits don't depend on you being at the desk with the volume up.",
        "<strong class='text-white'>Multi-account sync</strong>, the same automated entry and exit mirror across several Tradovate accounts at once, with no per-account clicking or listening.",
        "<strong class='text-white'>Its own trade log</strong>, you get a clean record of what fired and when, so you check results on your terms instead of jumping at every chime.",
      ],
    },
  ], de: [
    { type: "paragraph",html: "Sie erhalten eine Orderausführung und der Alarm sprengt fast Ihr Headset. Es ist eine der häufigsten Beschwerden über Tradovate, und es ist seit Jahren dieselbe Geschichte: Die Standard-Benachrichtigungstöne sind laut, und nirgendwo in der Plattform gibt es einen Lautstärkeregler, um sie zu bändigen. Sie können ändern, <em>welcher</em> Ton abgespielt wird, und einzelne Alarme ausschalten, aber Sie können keinen Pegel wie „halbe Lautstärke“ einstellen. Wenn Sie also bei jedem Trade wegen des Ausführungstons zusammenzucken, liegt die eigentliche Lösung außerhalb der App, in den Soundeinstellungen Ihres Betriebssystems. So bringen Sie ihn auf ein vernünftiges Maß, ohne taub zu werden oder blind zu handeln." },
    {
      type: "checklist",
      heading: "Schnelle Lösungen für laute Tradovate-Alarme",
      items: [
        "<strong class='text-white'>Lautstärke pro App begrenzen.</strong> Ziehen Sie Tradovate (oder Ihren Browser) im Windows Volume Mixer auf ein erträgliches Niveau und lassen Sie alles andere unberührt.",
        "<strong class='text-white'>Zu einem leiseren Ton wechseln.</strong> Tradovate bringt eine Bibliothek mit Benachrichtigungstönen mit. Wählen Sie einen sanfteren für die am häufigsten ausgelösten Alarme.",
        "<strong class='text-white'>Die lauten stummschalten.</strong> Schalten Sie den Ton für die Orderstatus aus, die Sie nicht angesagt bekommen müssen, und behalten Sie nur die wichtigen.",
        "<strong class='text-white'>Systemlautstärke senken.</strong> Eine grobe, aber sofortige Lösung, wenn es gerade jetzt leise sein muss.",
        "<strong class='text-white'>Auf dem Smartphone die Telefonlautstärke nutzen.</strong> Der Alarm folgt Ihrer Benachrichtigungs-/Klingeltonlautstärke, nicht einer In-App-Einstellung.",
        "<strong class='text-white'>Einen Funktionswunsch einreichen.</strong> Ein integrierter Lautstärkeregler und der Upload eigener Töne stehen weiterhin auf der Wunschliste, je mehr Anfragen, desto größer die Chance, dass es umgesetzt wird.",
      ],
    },
    { type: "heading",text: "Warum es keine Lautstärkeregelung gibt (und was Sie tatsächlich ändern können)" },
    { type: "paragraph",html: "Seien wir von Anfang an klar über die Einschränkung, denn das erspart Ihnen die Suche nach einer Einstellung, die nicht existiert. Stand 2026 hat Tradovate <strong class='text-white'>keine In-App-Lautstärkeregelung für Benachrichtigungstöne</strong>. Es gibt keinen Regler, keine Prozentangabe, keine Option „leise/mittel/laut“. Was die Plattform Ihnen <em>tatsächlich</em> bietet, sind zwei Hebel:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Soundauswahl.</strong> Jede Orderstatus-Benachrichtigung kann einen anderen Ton abspielen, den Sie aus einer integrierten Soundbibliothek wählen. Manche sind deutlich sanfter als andere, allein das kann viel Schärfe nehmen.",
        "<strong class='text-white'>Ein-/Aus-Schalter.</strong> Sie können Benachrichtigungen global ein- oder ausschalten und den Ton für jeden Orderstatus einzeln umschalten, Order ausgeführt, Order abgelehnt, Order storniert und so weiter.",
      ],
    },
    { type: "paragraph",html: "Was Sie <strong class='text-white'>nicht</strong> können, ist, einen Lautstärkepegel einzustellen oder eine eigene Audiodatei hochzuladen. Beides sind seit langer Zeit offene Funktionswünsche, und keiner wurde umgesetzt. Die ehrliche Antwort auf „wie stelle ich die Lautstärke in Tradovate leiser“ lautet also: gar nicht, zumindest nicht innerhalb von Tradovate. Sie tun es in Ihrem Betriebssystem, wo die Lautstärkeregelung pro App seit Jahren existiert." },
    { type: "heading",text: "Lösung 1: Die Lautstärke von Tradovate im Windows Mixer begrenzen" },
    { type: "paragraph",html: "Dies ist die Lösung, die das Problem „zu laut“ tatsächlich behebt, denn sie senkt den Ton von Tradovate, ohne Musik, Anrufe oder irgendetwas anderes mit herunterzuziehen. Windows erlaubt es, für jede App, die Geräusche erzeugt, eine eigene Lautstärke festzulegen." },
    { type: "paragraph",html: "<ol><li><strong class='text-white'>Klicken Sie mit der rechten Maustaste auf das Lautsprechersymbol</strong> unten rechts in Ihrer Taskleiste und wählen Sie <strong class='text-white'>Open Volume Mixer</strong>. (Sie erreichen ihn auch über Settings → System → Sound → Volume Mixer.)</li><li>Stellen Sie sicher, dass Tradovate läuft und gerade einen Ton abgespielt hat, damit es in der Liste erscheint. Suchen Sie nach der <strong class='text-white'>Tradovate-Desktop-App</strong> oder Ihrem <strong class='text-white'>Browser</strong> (Chrome, Edge), wenn Sie die Webplattform nutzen.</li><li><strong class='text-white'>Ziehen Sie den Regler dieser App nach unten</strong> auf etwa 20-40 %. Änderungen werden sofort wirksam, lösen Sie eine Testbenachrichtigung aus und passen Sie an, bis der Ausführungston ein Anstupsen ist und kein Schreckmoment.</li></ol>" },
    { type: "paragraph",html: "Die Einstellung ist relativ zu Ihrer Master-Lautstärke und bleibt zwischen Sitzungen erhalten, Sie stellen sie also einmal ein und vergessen sie. Auf einem Mac bietet das Betriebssystem keine native Lautstärke pro App wie Windows, Sie müssten die gesamte Systemlautstärke senken oder ein Audio-Dienstprogramm eines Drittanbieters nutzen, um den Browser oder die App zu isolieren. Prüfen Sie, was in Ihrer macOS-Version verfügbar ist, bevor Sie sich darauf verlassen." },
    { type: "heading",text: "Lösung 2: Einen leiseren Ton aus der Bibliothek wählen" },
    { type: "paragraph",html: "Da Sie die Lautstärke nicht in der App ändern können, ist das Nächstbeste, einen Ton zu wählen, der von vornherein nicht so schroff ist. Tradovate führt eine Bibliothek mit Benachrichtigungstönen, und Sie können pro Orderstatus einen anhören und zuweisen." },
    { type: "paragraph",html: "<ol><li>Öffnen Sie Ihre <strong class='text-white'>Benachrichtigungseinstellungen</strong>. Im Web-Trader finden Sie sie im Einstellungsmenü, suchen Sie einen Abschnitt <strong class='text-white'>Notifications</strong> mit einer Liste <strong class='text-white'>Audio Notifications</strong>. (Je nach Version erreichen Sie sie über Preferences oder Application Settings; bestätigen Sie den genauen Pfad in Ihrer aktuellen Version.)</li><li>Suchen Sie die Audio-Benachrichtigung, die Sie ändern möchten, etwa <strong class='text-white'>Order Filled</strong>, und klicken Sie auf den blauen Link, der den aktuellen Ton anzeigt.</li><li>Die <strong class='text-white'>Soundbibliothek</strong> öffnet sich. Spielen Sie jede Option ab, wählen Sie den leisesten, der Ihr Ohr noch erreicht, und weisen Sie ihn zu.</li><li>Wiederholen Sie das für die Status, die am häufigsten auftreten. Ein sanfter „Ausgeführt“-Ton plus ein deutlicher „Abgelehnt“-Ton genügen meist.</li></ol>" },
    { type: "paragraph",html: "Ein sanfter Bibliothekston in Kombination mit der Lautstärkebegrenzung pro App aus der ersten Lösung bringt Sie dem ruhigen Setup schon sehr nahe, ein Ton, den Sie hören können, ohne zusammenzuzucken." },
    { type: "heading",text: "Lösung 3: Die nicht benötigten Alarme ausschalten" },
    { type: "paragraph",html: "Ein großer Teil des Lärms stammt von Status, die Sie gar nicht hören müssen. Jedes Update einer aktiven Order, jede Stornierung und Änderung kann einen eigenen Signalton haben, und bei einem aktiven Konto summiert sich das schnell. Kürzen Sie die Liste auf das Wesentliche." },
    { type: "paragraph",html: "<ol><li>Öffnen Sie in denselben <strong class='text-white'>Notifications</strong>-Einstellungen die <strong class='text-white'>erweiterte</strong> bzw. statusbezogene Konfiguration, in der jeder Orderstatus einzeln aufgeführt ist.</li><li><strong class='text-white'>Schalten Sie den Ton aus</strong> für die Status, die nicht laut angesagt werden müssen. Viele Trader behalten nur „Ausgeführt“ und „Abgelehnt“ und schalten den Rest stumm.</li><li>Meist lässt sich nur der <strong class='text-white'>Ton</strong> stummschalten, während das Popup auf dem Bildschirm bleibt, sodass Sie das Ereignis sehen, ohne es zu hören. Soll ein Status ganz verschwinden, schalten Sie die gesamte Benachrichtigung aus.</li><li>Bezeichnungen und Layout ändern sich zwischen Plattform-Updates, bestätigen Sie daher die genauen Schalter in Ihrer aktuellen Version, bevor Sie sich darauf verlassen.</li></ol>" },
    { type: "paragraph",html: "Wenn Sie in einem Anruf sind oder Ihren Bildschirm teilen und gerade einfach Ruhe brauchen, können Sie <strong class='text-white'>alle</strong> Benachrichtigungen im selben Bereich ausschalten und danach wieder einschalten." },
    { type: "heading",text: "Und mobil?" },
    { type: "paragraph",html: "Auch in der mobilen Tradovate-App gibt es keine In-App-Lautstärke für Alarme, die Lautstärke richtet sich nach der Benachrichtigungs- und Klingeltonlautstärke Ihres Telefons. Wenn die App auf Ihrem Telefon zu laut ist, senken Sie die Benachrichtigungslautstärke in den Telefoneinstellungen oder schalten Sie in den App-Benachrichtigungseinstellungen Ihres Telefons die Benachrichtigungen von Tradovate stumm oder entfernen Sie sie. Das ist dasselbe Prinzip wie bei der Desktop-Lösung, die Steuerung liegt im Betriebssystem, nicht in Tradovate." },
    { type: "heading",text: "Tabelle zur Fehlerbehebung" },
    { type: "table", headers: ["Was Sie möchten","Geht das in Tradovate?","So erreichen Sie es"], rows: [
      ["Benachrichtigungstöne auf eine bestimmte Lautstärke einstellen","Nein, es gibt keinen In-App-Regler","Im Windows Volume Mixer einen Pegel pro App festlegen"],
      ["Eine App leiser machen, ohne alles zu senken","Nein","Regler pro App im Volume Mixer (Windows); Drittanbieter-Tool auf dem Mac"],
      ["Ändern, welcher Ton abgespielt wird","Ja","Notifications → Audio Notifications → aus der Soundbibliothek wählen"],
      ["Einen bestimmten Alarm stummschalten (z. B. Order ausgeführt)","Ja","Ton für diesen Status in der erweiterten Konfiguration ausschalten"],
      ["Popup behalten, aber Ton abschalten","Ja","Audio-Schalter ausschalten, Benachrichtigung eingeschaltet lassen"],
      ["Eigene Sounddatei hochladen","Nein","Nicht unterstützt; einen Funktionswunsch einreichen"],
      ["Alles vorübergehend ausschalten","Ja","Benachrichtigungen in den Einstellungen global deaktivieren, später wieder aktivieren"],
      ["Leisere Alarme in der Telefon-App","Keine In-App-Steuerung","Benachrichtigungslautstärke in den Telefoneinstellungen senken"],
    ] },
    { type: "heading",text: "Hören Sie ganz auf, Alarme zu hüten" },
    { type: "paragraph",html: "Hier das tiefere Problem hinter lauten Benachrichtigungstönen: Wenn Sie sich auf einen hörbaren Signalton verlassen, der Ihnen sagt, dass eine Ausführung stattgefunden hat oder eine Order abgelehnt wurde, sind Sie an den Bildschirm gefesselt und reagieren erst im Nachhinein. Ist Ihre Strategie automatisiert, muss die Plattform Sie nicht anschreien, die Ausführung ist bereits nach Ihren Regeln erfolgt. PickMyTrade nimmt den Alarm aus der Schleife:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Signalbasierte Ausführung</strong>, Ihre TradingView-Strategie löst die Order automatisch aus, sobald Ihre Bedingung eintritt, Sie müssen also nicht warten, bis ein Ton Ihnen eine Reaktion abverlangt.",
        "<strong class='text-white'>Serverseitiges Routing</strong>, Alarme werden von den Servern von PickMyTrade an Tradovate geleitet, Ein- und Ausstiege hängen also nicht davon ab, dass Sie mit aufgedrehter Lautstärke am Schreibtisch sitzen.",
        "<strong class='text-white'>Multi-Konto-Synchronisierung</strong>, derselbe automatisierte Einstieg und Ausstieg wird auf mehrere Tradovate-Konten gleichzeitig gespiegelt, ohne Klicken oder Hinhören pro Konto.",
        "<strong class='text-white'>Ein eigenes Trade-Protokoll</strong>, Sie erhalten ein sauberes Protokoll, was wann ausgelöst wurde, sodass Sie Ergebnisse nach Ihren Bedingungen prüfen, statt bei jedem Signalton aufzuschrecken.",
      ],
    },
  ], es: [
    { type: "paragraph",html: "Se ejecuta una orden y la alerta casi le revienta los auriculares. Es una de las quejas más comunes sobre Tradovate y es la misma historia desde hace años: los sonidos de notificación predeterminados son fuertes y no hay ningún control de volumen en la plataforma para atenuarlos. Puede cambiar <em>qué</em> sonido se reproduce y puede desactivar alertas individuales, pero no puede fijar un nivel como “mitad de volumen”. Así que, si el aviso de ejecución le sobresalta en cada operación, la solución real está fuera de la aplicación, en los controles de sonido de su sistema operativo. Aquí tiene exactamente cómo bajarlo a un nivel razonable sin quedarse sordo ni operar a ciegas." },
    {
      type: "checklist",
      heading: "Soluciones rápidas para alertas de Tradovate demasiado fuertes",
      items: [
        "<strong class='text-white'>Limite el volumen por aplicación.</strong> Use el Volume Mixer de Windows para bajar Tradovate (o su navegador) a un nivel tolerable, sin tocar nada más.",
        "<strong class='text-white'>Cambie a un sonido más suave.</strong> Tradovate incluye una biblioteca de sonidos de notificación. Elija uno más suave para las alertas que más se disparan.",
        "<strong class='text-white'>Silencie las ruidosas.</strong> Desactive el audio de los estados de orden que no necesita que le anuncien, y conserve solo los que importan.",
        "<strong class='text-white'>Baje el volumen del sistema.</strong> Una solución burda pero instantánea cuando necesita silencio ahora mismo.",
        "<strong class='text-white'>En el móvil, use el volumen del teléfono.</strong> La alerta sigue al volumen de notificaciones/tono, no a un ajuste de la aplicación.",
        "<strong class='text-white'>Presente una solicitud de función.</strong> Un control de volumen integrado y la subida de sonidos personalizados siguen en la lista de deseos, cuantas más solicitudes, mejores son las probabilidades de que se implemente.",
      ],
    },
    { type: "heading",text: "Por qué no hay control de volumen (y qué puede cambiar realmente)" },
    { type: "paragraph",html: "Seamos claros con la limitación desde el principio, porque le ahorra buscar un ajuste que no existe. A 2026, Tradovate <strong class='text-white'>no tiene control de volumen dentro de la aplicación para los sonidos de notificación</strong>. No hay control deslizante, ni porcentaje, ni opción “suave/medio/fuerte”. Lo que la plataforma <em>sí</em> le da son dos palancas:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Selección de sonido.</strong> Cada notificación de estado de orden puede reproducir un sonido distinto, que elige de una biblioteca de sonidos integrada. Algunos son notablemente más suaves que otros, así que solo esto ya puede quitar mucho de la estridencia.",
        "<strong class='text-white'>Interruptores de activación/desactivación.</strong> Puede activar o desactivar las notificaciones globalmente y alternar el audio de cada estado de orden individualmente, orden ejecutada, orden rechazada, orden cancelada, etc.",
      ],
    },
    { type: "paragraph",html: "Lo que <strong class='text-white'>no</strong> puede hacer es fijar un nivel de volumen ni subir su propio archivo de audio. Ambas son solicitudes de función abiertas desde hace mucho tiempo, y ninguna se ha implementado. Así que la respuesta honesta a “cómo bajo el volumen en Tradovate” es: no lo hace, al menos no desde dentro de Tradovate. Lo hace en su sistema operativo, donde el control de volumen por aplicación existe desde hace años." },
    { type: "heading",text: "Solución 1: Limitar el volumen de Tradovate en el mezclador de Windows" },
    { type: "paragraph",html: "Esta es la solución que realmente resuelve el problema de “demasiado fuerte”, porque baja el sonido de Tradovate sin arrastrar su música, sus llamadas ni nada más. Windows le permite fijar un volumen independiente para cada aplicación que emite sonido." },
    { type: "paragraph",html: "<ol><li><strong class='text-white'>Haga clic con el botón derecho en el icono del altavoz</strong> en la esquina inferior derecha de su barra de tareas y elija <strong class='text-white'>Open Volume Mixer</strong>. (También puede llegar mediante Settings → System → Sound → Volume Mixer.)</li><li>Asegúrese de que Tradovate esté en ejecución y acabe de reproducir un sonido, para que aparezca en la lista. Busque la <strong class='text-white'>aplicación de escritorio de Tradovate</strong>, o su <strong class='text-white'>navegador</strong> (Chrome, Edge) si usa la plataforma web.</li><li><strong class='text-white'>Arrastre el control deslizante de esa aplicación hacia abajo</strong> hasta alrededor del 20-40 %. Los cambios se aplican al instante, dispare una notificación de prueba y ajuste hasta que el aviso de ejecución sea un toque suave y no un sobresalto.</li></ol>" },
    { type: "paragraph",html: "El ajuste es relativo a su volumen maestro y se mantiene entre sesiones, así que lo configura una vez y se olvida. En un Mac, el sistema operativo no ofrece volumen nativo por aplicación como Windows, tendría que bajar el volumen general del sistema o usar una utilidad de audio de terceros para aislar el navegador o la aplicación. Confirme qué hay disponible en su versión de macOS antes de confiar en ello." },
    { type: "heading",text: "Solución 2: Elegir un sonido más suave de la biblioteca" },
    { type: "paragraph",html: "Como no puede cambiar el volumen dentro de la aplicación, lo mejor que sigue es elegir un sonido que no sea tan áspero de entrada. Tradovate mantiene una biblioteca de sonidos de notificación, y puede escuchar y asignar uno por cada estado de orden." },
    { type: "paragraph",html: "<ol><li>Abra sus <strong class='text-white'>ajustes de notificaciones</strong>. En el web trader están en el menú de ajustes, busque una sección <strong class='text-white'>Notifications</strong> con una lista <strong class='text-white'>Audio Notifications</strong>. (Según su versión, puede llegar mediante Preferences o Application Settings; confirme la ruta exacta en su versión actual.)</li><li>Busque la notificación de audio que quiere cambiar, por ejemplo <strong class='text-white'>Order Filled</strong>, y haga clic en el enlace azul que muestra el sonido actual.</li><li>Se abre la <strong class='text-white'>biblioteca de sonidos</strong>. Reproduzca cada opción, elija la más suave que aún capte su atención y asígnela.</li><li>Repita para los estados que se disparan con más frecuencia. Un sonido suave de “ejecutada” más un sonido distinto de “rechazada” suele ser todo lo que necesita.</li></ol>" },
    { type: "paragraph",html: "Combinar un sonido suave de la biblioteca con el límite de volumen por aplicación de la primera solución le lleva casi hasta una configuración tranquila, un sonido que puede oír sin que le haga encogerse." },
    { type: "heading",text: "Solución 3: Desactivar las alertas que no necesita" },
    { type: "paragraph",html: "Gran parte del ruido procede de estados que en realidad no le interesa oír. Cada actualización de orden activa, cancelación y modificación puede llevar su propio aviso, y en una cuenta activa se acumula rápido. Reduzca la lista a lo que importa." },
    { type: "paragraph",html: "<ol><li>En los mismos ajustes de <strong class='text-white'>Notifications</strong>, abra la configuración <strong class='text-white'>avanzada</strong> o por estado, donde cada estado de orden aparece por separado.</li><li><strong class='text-white'>Desactive el audio</strong> de los estados que no necesita que se anuncien en voz alta. Muchos traders conservan solo “ejecutada” y “rechazada” y silencian el resto.</li><li>Normalmente puede silenciar solo el <strong class='text-white'>sonido</strong> manteniendo la ventana emergente en pantalla, de modo que sigue viendo el evento sin oírlo. Si quiere eliminar un estado por completo, desactive toda la notificación.</li><li>Las etiquetas y la disposición cambian entre actualizaciones de la plataforma, así que confirme los interruptores exactos en su versión actual antes de contar con ellos.</li></ol>" },
    { type: "paragraph",html: "Si está en una llamada o compartiendo pantalla y solo necesita silencio ahora mismo, puede desactivar <strong class='text-white'>todas</strong> las notificaciones desde el mismo panel y volver a activarlas después." },
    { type: "heading",text: "¿Y en el móvil?" },
    { type: "paragraph",html: "En la aplicación móvil de Tradovate tampoco hay volumen interno para las alertas, y el volumen depende del volumen de notificaciones y de tono de llamada de su teléfono. Si la aplicación suena demasiado fuerte en su teléfono, baje el volumen de notificaciones en los ajustes del teléfono, o entre en los controles de notificaciones de aplicaciones del teléfono y silencie o elimine las notificaciones de Tradovate. Es el mismo principio que en la solución de escritorio, el control está en el sistema operativo, no en Tradovate." },
    { type: "heading",text: "Tabla de solución de problemas" },
    { type: "table", headers: ["Lo que quiere","¿Se puede hacer en Tradovate?","Cómo conseguirlo"], rows: [
      ["Fijar los sonidos de notificación a un nivel de volumen concreto","No, no existe un control deslizante en la aplicación","Use el Volume Mixer de Windows para fijar un nivel por aplicación"],
      ["Bajar una aplicación sin reducir todo lo demás","No","Control deslizante por aplicación en el Volume Mixer (Windows); herramienta de terceros en Mac"],
      ["Cambiar qué sonido se reproduce","Sí","Notifications → Audio Notifications → elegir de la biblioteca de sonidos"],
      ["Silenciar una alerta concreta (p. ej., orden ejecutada)","Sí","Desactivar el audio de ese estado en la configuración avanzada"],
      ["Mantener la ventana emergente pero eliminar el sonido","Sí","Desactivar el interruptor de audio y dejar la notificación activada"],
      ["Subir su propio archivo de sonido","No","No es compatible; presente una solicitud de función"],
      ["Desactivar todo temporalmente","Sí","Desactivar las notificaciones globalmente en los ajustes y reactivarlas después"],
      ["Alertas más suaves en la aplicación del teléfono","Sin control dentro de la aplicación","Bajar el volumen de notificaciones en los ajustes del teléfono"],
    ] },
    { type: "heading",text: "Deje de vigilar alertas de una vez por todas" },
    { type: "paragraph",html: "Este es el problema de fondo detrás de los sonidos de notificación fuertes: si depende de un aviso sonoro para saber que se ejecutó una orden o que una orden fue rechazada, está atado a la pantalla y reaccionando después del hecho. Cuando su estrategia está automatizada, la plataforma no necesita gritarle, la ejecución ya ocurrió según sus reglas. PickMyTrade saca la alerta del circuito:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Ejecución basada en señales</strong>, su estrategia de TradingView dispara la orden automáticamente en cuanto se cumple su condición, así que no tiene que esperar a que un sonido le haga reaccionar.",
        "<strong class='text-white'>Enrutamiento en el servidor</strong>, las alertas se enrutan a Tradovate desde los servidores de PickMyTrade, de modo que las entradas y salidas no dependen de que esté en el escritorio con el volumen alto.",
        "<strong class='text-white'>Sincronización multicuenta</strong>, la misma entrada y salida automatizada se replica en varias cuentas de Tradovate a la vez, sin clics ni escucha por cuenta.",
        "<strong class='text-white'>Su propio registro de operaciones</strong>, obtiene un registro limpio de qué se disparó y cuándo, para que revise los resultados a su ritmo en lugar de sobresaltarse con cada aviso.",
      ],
    },
  ], fr: [
    { type: "paragraph",html: "Un ordre est exécuté et l'alerte manque de vous exploser le casque. C'est l'une des doléances les plus courantes à propos de Tradovate, et c'est la même histoire depuis des années : les sons de notification par défaut sont forts, et il n'y a aucun curseur de volume dans la plateforme pour les atténuer. Vous pouvez changer <em>quel</em> son est joué et désactiver des alertes individuelles, mais vous ne pouvez pas régler un niveau comme « moitié volume ». Donc, si le signal d'exécution vous fait sursauter à chaque trade, la vraie solution se trouve en dehors de l'application, dans les commandes de son de votre système d'exploitation. Voici précisément comment le ramener à un niveau raisonnable sans devenir sourd ni trader à l'aveugle." },
    {
      type: "checklist",
      heading: "Solutions rapides pour les alertes Tradovate trop fortes",
      items: [
        "<strong class='text-white'>Plafonnez le volume par application.</strong> Utilisez le Volume Mixer de Windows pour abaisser Tradovate (ou votre navigateur) à un niveau supportable, sans toucher au reste.",
        "<strong class='text-white'>Passez à un son plus doux.</strong> Tradovate fournit une bibliothèque de sons de notification. Choisissez-en un plus doux pour les alertes qui se déclenchent le plus souvent.",
        "<strong class='text-white'>Faites taire les plus bruyantes.</strong> Désactivez l'audio des statuts d'ordre dont vous n'avez pas besoin d'être averti, et ne conservez que ceux qui comptent.",
        "<strong class='text-white'>Baissez le volume du système.</strong> Une solution grossière mais instantanée quand vous avez besoin de silence tout de suite.",
        "<strong class='text-white'>Sur mobile, utilisez le volume du téléphone.</strong> L'alerte suit le volume des notifications/de la sonnerie, et non un réglage de l'application.",
        "<strong class='text-white'>Déposez une demande de fonctionnalité.</strong> Un curseur de volume intégré et l'importation de sons personnalisés figurent toujours sur la liste de souhaits, plus il y a de demandes, meilleures sont les chances qu'elle soit livrée.",
      ],
    },
    { type: "heading",text: "Pourquoi il n'y a pas de contrôle du volume (et ce que vous pouvez réellement changer)" },
    { type: "paragraph",html: "Soyons clairs d'emblée sur cette limitation, car cela vous évite de chercher un réglage qui n'existe pas. En 2026, Tradovate n'a <strong class='text-white'>aucun contrôle de volume intégré à l'application pour les sons de notification</strong>. Pas de curseur, pas de pourcentage, pas d'option « doux/moyen/fort ». Ce que la plateforme vous donne <em>effectivement</em>, ce sont deux leviers :" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Choix du son.</strong> Chaque notification de statut d'ordre peut jouer un son différent, que vous choisissez dans une bibliothèque de sons intégrée. Certains sont nettement plus doux que d'autres, ce qui peut déjà atténuer beaucoup l'agressivité.",
        "<strong class='text-white'>Interrupteurs activé/désactivé.</strong> Vous pouvez activer ou désactiver les notifications globalement, et basculer l'audio de chaque statut d'ordre individuellement, ordre exécuté, ordre rejeté, ordre annulé, etc.",
      ],
    },
    { type: "paragraph",html: "Ce que vous <strong class='text-white'>ne pouvez pas</strong> faire, c'est régler un niveau de volume, ni importer votre propre fichier audio. Ce sont deux demandes de fonctionnalité ouvertes depuis longtemps, et aucune n'a été livrée. La réponse honnête à « comment baisser le volume dans Tradovate » est donc : vous ne le faites pas, du moins pas depuis Tradovate. Vous le faites dans votre système d'exploitation, où le contrôle du volume par application existe depuis des années." },
    { type: "heading",text: "Solution 1 : plafonner le volume de Tradovate dans le mélangeur Windows" },
    { type: "paragraph",html: "C'est la solution qui règle réellement le problème du « trop fort », car elle abaisse le son de Tradovate sans entraîner votre musique, vos appels ni quoi que ce soit d'autre. Windows vous permet de définir un volume distinct pour chaque application qui émet du son." },
    { type: "paragraph",html: "<ol><li><strong class='text-white'>Faites un clic droit sur l'icône du haut-parleur</strong> dans le coin inférieur droit de votre barre des tâches et choisissez <strong class='text-white'>Open Volume Mixer</strong>. (Vous pouvez aussi y accéder via Settings → System → Sound → Volume Mixer.)</li><li>Assurez-vous que Tradovate est en cours d'exécution et vient de jouer un son, afin qu'il apparaisse dans la liste. Cherchez l'<strong class='text-white'>application de bureau Tradovate</strong>, ou votre <strong class='text-white'>navigateur</strong> (Chrome, Edge) si vous utilisez la plateforme web.</li><li><strong class='text-white'>Faites glisser le curseur de cette application vers le bas</strong>, autour de 20 à 40 %. Les changements s'appliquent immédiatement, déclenchez une notification de test et ajustez jusqu'à ce que le signal d'exécution soit un petit coup de coude et non un sursaut.</li></ol>" },
    { type: "paragraph",html: "Le réglage est relatif à votre volume principal et persiste d'une session à l'autre ; vous le réglez une fois et vous l'oubliez. Sur Mac, le système d'exploitation n'offre pas de volume natif par application comme Windows, vous devriez baisser le volume général du système ou utiliser un utilitaire audio tiers pour isoler le navigateur ou l'application. Vérifiez ce qui est disponible sur votre version de macOS avant de compter dessus." },
    { type: "heading",text: "Solution 2 : choisir un son plus doux dans la bibliothèque" },
    { type: "paragraph",html: "Puisque vous ne pouvez pas changer le volume dans l'application, la meilleure option suivante consiste à choisir un son moins dur d'emblée. Tradovate tient une bibliothèque de sons de notification, et vous pouvez en écouter et en attribuer un par statut d'ordre." },
    { type: "paragraph",html: "<ol><li>Ouvrez vos <strong class='text-white'>paramètres de notification</strong>. Dans le web trader, ils se trouvent dans le menu des paramètres, cherchez une section <strong class='text-white'>Notifications</strong> avec une liste <strong class='text-white'>Audio Notifications</strong>. (Selon votre version, vous y accédez peut-être via Preferences ou Application Settings ; vérifiez le chemin exact dans votre version actuelle.)</li><li>Trouvez la notification audio que vous souhaitez modifier, par exemple <strong class='text-white'>Order Filled</strong>, et cliquez sur le lien bleu qui affiche le son actuel.</li><li>La <strong class='text-white'>bibliothèque de sons</strong> s'ouvre. Écoutez chaque option, choisissez le son le plus doux qui attire encore votre oreille, et attribuez-le.</li><li>Répétez l'opération pour les statuts qui se déclenchent le plus souvent. Un son « exécuté » doux plus un son « rejeté » distinct suffisent généralement.</li></ol>" },
    { type: "paragraph",html: "Associer un son doux de la bibliothèque au plafonnement du volume par application de la première solution vous mène presque à une configuration paisible, un son que vous entendez sans qu'il vous fasse grimacer." },
    { type: "heading",text: "Solution 3 : désactiver les alertes dont vous n'avez pas besoin" },
    { type: "paragraph",html: "Une grande partie du bruit provient de statuts que vous n'avez pas vraiment envie d'entendre. Chaque mise à jour d'ordre en attente, annulation et modification peut avoir son propre signal sonore, et cela s'accumule vite sur un compte actif. Réduisez la liste à l'essentiel." },
    { type: "paragraph",html: "<ol><li>Dans les mêmes paramètres <strong class='text-white'>Notifications</strong>, ouvrez la configuration <strong class='text-white'>avancée</strong> ou par statut, où chaque statut d'ordre est listé séparément.</li><li><strong class='text-white'>Désactivez l'audio</strong> des statuts que vous n'avez pas besoin d'entendre à voix haute. Beaucoup de traders ne gardent que « exécuté » et « rejeté » et coupent le reste.</li><li>Vous pouvez généralement couper uniquement le <strong class='text-white'>son</strong> tout en gardant la fenêtre contextuelle à l'écran, de sorte que vous voyez toujours l'événement sans l'entendre. Si vous voulez supprimer complètement un statut, désactivez toute la notification.</li><li>Les libellés et la disposition changent d'une mise à jour de la plateforme à l'autre ; vérifiez donc les interrupteurs exacts dans votre version actuelle avant de compter dessus.</li></ol>" },
    { type: "paragraph",html: "Si vous êtes en appel ou en partage d'écran et avez simplement besoin de silence tout de suite, vous pouvez désactiver <strong class='text-white'>toutes</strong> les notifications depuis le même panneau puis les réactiver ensuite." },
    { type: "heading",text: "Et sur mobile ?" },
    { type: "paragraph",html: "Sur l'application mobile Tradovate, il n'y a pas non plus de volume intégré pour les alertes, et l'intensité dépend du volume des notifications et de la sonnerie de votre téléphone. Si l'application est trop forte sur votre téléphone, baissez le volume des notifications dans les paramètres du téléphone, ou rendez-vous dans les commandes de notification des applications de votre téléphone et coupez ou supprimez les notifications de Tradovate. C'est le même principe que pour la solution de bureau, le contrôle se trouve dans le système d'exploitation, pas dans Tradovate." },
    { type: "heading",text: "Tableau de dépannage" },
    { type: "table", headers: ["Ce que vous voulez","Est-ce possible dans Tradovate ?","Comment y parvenir"], rows: [
      ["Régler les sons de notification à un niveau de volume précis","Non, aucun curseur n'existe dans l'application","Utiliser le Volume Mixer de Windows pour définir un niveau par application"],
      ["Baisser une application sans tout réduire","Non","Curseur par application dans le Volume Mixer (Windows) ; outil tiers sur Mac"],
      ["Changer le son joué","Oui","Notifications → Audio Notifications → choisir dans la bibliothèque de sons"],
      ["Faire taire une alerte précise (p. ex. ordre exécuté)","Oui","Désactiver l'audio de ce statut dans la configuration avancée"],
      ["Garder la fenêtre contextuelle mais supprimer le son","Oui","Désactiver l'interrupteur audio, laisser la notification activée"],
      ["Importer votre propre fichier son","Non","Non pris en charge ; déposer une demande de fonctionnalité"],
      ["Tout désactiver temporairement","Oui","Désactiver les notifications globalement dans les paramètres, les réactiver plus tard"],
      ["Alertes plus discrètes sur l'application du téléphone","Aucun contrôle dans l'application","Baisser le volume des notifications dans les paramètres du téléphone"],
    ] },
    { type: "heading",text: "Cessez complètement de surveiller les alertes" },
    { type: "paragraph",html: "Voici le problème de fond derrière les sons de notification trop forts : si vous comptez sur un signal sonore pour savoir qu'une exécution a eu lieu ou qu'un ordre a été rejeté, vous êtes enchaîné à l'écran et vous réagissez après coup. Lorsque votre stratégie est automatisée, la plateforme n'a pas besoin de vous crier dessus, l'exécution a déjà eu lieu selon vos règles. PickMyTrade sort l'alerte de la boucle :" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Exécution basée sur des signaux</strong>, votre stratégie TradingView déclenche l'ordre automatiquement dès que votre condition se réalise, vous n'avez donc pas à attendre un son pour réagir.",
        "<strong class='text-white'>Routage côté serveur</strong>, les alertes sont acheminées vers Tradovate depuis les serveurs de PickMyTrade ; vos entrées et sorties ne dépendent donc pas de votre présence au bureau, volume à fond.",
        "<strong class='text-white'>Synchronisation multi-comptes</strong>, la même entrée et la même sortie automatisées sont répliquées sur plusieurs comptes Tradovate à la fois, sans clic ni écoute par compte.",
        "<strong class='text-white'>Son propre journal de trades</strong>, vous obtenez un historique clair de ce qui s'est déclenché et quand, pour consulter les résultats à votre rythme au lieu de sursauter à chaque signal sonore.",
      ],
    },
  ], it: [
    { type: "paragraph",html: "Riceve l'esecuzione di un ordine e l'avviso Le fa quasi esplodere le cuffie. È una delle lamentele più comuni su Tradovate, ed è la stessa storia da anni: i suoni di notifica predefiniti sono forti e in tutta la piattaforma non c'è alcun cursore del volume per attenuarli. Può cambiare <em>quale</em> suono viene riprodotto e può disattivare singoli avvisi, ma non può impostare un livello come “metà volume”. Quindi, se il segnale di esecuzione Le fa sobbalzare a ogni trade, la vera soluzione si trova fuori dall'app, nei controlli audio del Suo sistema operativo. Ecco esattamente come portarlo a un livello sensato senza diventare sordo né operare alla cieca." },
    {
      type: "checklist",
      heading: "Soluzioni rapide per gli avvisi Tradovate troppo forti",
      items: [
        "<strong class='text-white'>Limiti il volume per app.</strong> Usi il Volume Mixer di Windows per abbassare Tradovate (o il browser) a un livello sopportabile, lasciando intatto tutto il resto.",
        "<strong class='text-white'>Passi a un suono più silenzioso.</strong> Tradovate include una libreria di suoni di notifica. Ne scelga uno più morbido per gli avvisi che scattano più spesso.",
        "<strong class='text-white'>Silenzi quelli rumorosi.</strong> Disattivi l'audio per gli stati dell'ordine che non Le serve sentire annunciati e tenga solo quelli che contano.",
        "<strong class='text-white'>Abbassi il volume di sistema.</strong> Una soluzione grossolana ma istantanea quando ha bisogno di silenzio subito.",
        "<strong class='text-white'>Su mobile, usi il volume del telefono.</strong> L'avviso segue il volume delle notifiche/suoneria, non un'impostazione dell'app.",
        "<strong class='text-white'>Inoltri una richiesta di funzionalità.</strong> Un cursore del volume integrato e il caricamento di suoni personalizzati sono ancora nella lista dei desideri, più richieste ci sono, maggiori sono le possibilità che venga rilasciato.",
      ],
    },
    { type: "heading",text: "Perché non c'è un controllo del volume (e che cosa può davvero cambiare)" },
    { type: "paragraph",html: "Chiariamo subito la limitazione, perché Le evita di cercare un'impostazione che non esiste. Nel 2026 Tradovate <strong class='text-white'>non ha alcun controllo del volume nell'app per i suoni di notifica</strong>. Non c'è un cursore, né una percentuale, né un'opzione “basso/medio/alto”. Ciò che la piattaforma <em>effettivamente</em> Le offre sono due leve:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Selezione del suono.</strong> Ogni notifica di stato dell'ordine può riprodurre un suono diverso, che sceglie da una libreria di suoni integrata. Alcuni sono nettamente più delicati di altri, quindi già questo può togliere molta asprezza.",
        "<strong class='text-white'>Interruttori on/off.</strong> Può attivare o disattivare le notifiche globalmente e attivare o disattivare l'audio per ciascuno stato dell'ordine singolarmente, ordine eseguito, ordine rifiutato, ordine annullato e così via.",
      ],
    },
    { type: "paragraph",html: "Ciò che <strong class='text-white'>non</strong> può fare è impostare un livello di volume né caricare un proprio file audio. Entrambe sono richieste di funzionalità aperte da molto tempo, e nessuna è stata rilasciata. Quindi la risposta onesta a “come abbasso il volume in Tradovate” è: non lo fa, almeno non da dentro Tradovate. Lo fa nel Suo sistema operativo, dove il controllo del volume per app esiste da anni." },
    { type: "heading",text: "Soluzione 1: limitare il volume di Tradovate nel mixer di Windows" },
    { type: "paragraph",html: "Questa è la soluzione che risolve davvero il problema del “troppo forte”, perché abbassa il suono di Tradovate senza trascinare con sé musica, chiamate o altro. Windows consente di impostare un volume separato per ogni app che emette suoni." },
    { type: "paragraph",html: "<ol><li><strong class='text-white'>Faccia clic con il tasto destro sull'icona dell'altoparlante</strong> nell'angolo in basso a destra della barra delle applicazioni e scelga <strong class='text-white'>Open Volume Mixer</strong>. (Può raggiungerlo anche tramite Settings → System → Sound → Volume Mixer.)</li><li>Si assicuri che Tradovate sia in esecuzione e abbia appena riprodotto un suono, così da comparire nell'elenco. Cerchi l'<strong class='text-white'>app desktop di Tradovate</strong>, oppure il Suo <strong class='text-white'>browser</strong> (Chrome, Edge) se usa la piattaforma web.</li><li><strong class='text-white'>Trascini verso il basso il cursore di quell'app</strong> intorno al 20-40 %. Le modifiche si applicano all'istante, attivi una notifica di prova e regoli finché il segnale di esecuzione non è un colpetto e non uno spavento.</li></ol>" },
    { type: "paragraph",html: "L'impostazione è relativa al volume principale e persiste tra le sessioni, quindi la imposta una volta e se ne dimentica. Su Mac il sistema operativo non offre un volume nativo per app come Windows, dovrebbe abbassare il volume generale del sistema o usare un'utilità audio di terze parti per isolare il browser o l'app. Verifichi che cosa è disponibile sulla Sua versione di macOS prima di farvi affidamento." },
    { type: "heading",text: "Soluzione 2: scegliere un suono più silenzioso dalla libreria" },
    { type: "paragraph",html: "Poiché non può cambiare il volume nell'app, la migliore alternativa è scegliere un suono che non sia così aspro in partenza. Tradovate mantiene una libreria di suoni di notifica, e può ascoltarne e assegnarne uno per ciascuno stato dell'ordine." },
    { type: "paragraph",html: "<ol><li>Apra le Sue <strong class='text-white'>impostazioni delle notifiche</strong>. Nel web trader si trovano nel menu delle impostazioni, cerchi una sezione <strong class='text-white'>Notifications</strong> con un elenco <strong class='text-white'>Audio Notifications</strong>. (A seconda della versione, può raggiungerle tramite Preferences o Application Settings; verifichi il percorso esatto nella Sua versione attuale.)</li><li>Trovi la notifica audio che vuole cambiare, per esempio <strong class='text-white'>Order Filled</strong>, e faccia clic sul link blu che mostra il suono attuale.</li><li>Si apre la <strong class='text-white'>libreria dei suoni</strong>. Riproduca ogni opzione, scelga la più morbida che attiri comunque la Sua attenzione e la assegni.</li><li>Ripeta per gli stati che scattano più spesso. Di solito bastano un suono delicato per “eseguito” e un suono distinto per “rifiutato”.</li></ol>" },
    { type: "paragraph",html: "Abbinare un suono delicato della libreria al limite di volume per app della prima soluzione La porta quasi a una configurazione tranquilla, un suono che riesce a sentire senza sussultare." },
    { type: "heading",text: "Soluzione 3: disattivare gli avvisi che non Le servono" },
    { type: "paragraph",html: "Gran parte del rumore deriva da stati che in realtà non Le interessa sentire. Ogni aggiornamento di ordine in lavorazione, annullamento e modifica può avere il proprio segnale, e su un account attivo si accumula in fretta. Riduca l'elenco a ciò che conta." },
    { type: "paragraph",html: "<ol><li>Nelle stesse impostazioni <strong class='text-white'>Notifications</strong>, apra la configurazione <strong class='text-white'>avanzata</strong> o per singolo stato, dove ogni stato dell'ordine è elencato separatamente.</li><li><strong class='text-white'>Disattivi l'audio</strong> per gli stati che non Le serve sentire annunciati ad alta voce. Molti trader tengono solo “eseguito” e “rifiutato” e silenziano il resto.</li><li>Di solito può silenziare solo il <strong class='text-white'>suono</strong> mantenendo il popup sullo schermo, così vede comunque l'evento senza sentirlo. Se vuole eliminare del tutto uno stato, disattivi l'intera notifica.</li><li>Etichette e layout cambiano tra gli aggiornamenti della piattaforma, quindi verifichi gli interruttori esatti nella Sua versione attuale prima di farvi affidamento.</li></ol>" },
    { type: "paragraph",html: "Se è in una chiamata o sta condividendo lo schermo e ha semplicemente bisogno di silenzio subito, può disattivare <strong class='text-white'>tutte</strong> le notifiche dallo stesso pannello e riattivarle in seguito." },
    { type: "heading",text: "E su mobile?" },
    { type: "paragraph",html: "Anche sull'app mobile di Tradovate non c'è un volume integrato per gli avvisi, e l'intensità dipende dal volume delle notifiche e della suoneria del telefono. Se l'app è troppo forte sul telefono, abbassi il volume delle notifiche nelle impostazioni del telefono, oppure entri nei controlli delle notifiche delle app del telefono e silenzi o rimuova le notifiche di Tradovate. È lo stesso principio della soluzione desktop, il controllo si trova nel sistema operativo, non in Tradovate." },
    { type: "heading",text: "Tabella di risoluzione dei problemi" },
    { type: "table", headers: ["Che cosa vuole","Si può fare in Tradovate?","Come ottenerlo"], rows: [
      ["Impostare i suoni di notifica a un livello di volume specifico","No, non esiste un cursore nell'app","Usare il Volume Mixer di Windows per impostare un livello per app"],
      ["Abbassare un'app senza ridurre tutto il resto","No","Cursore per app nel Volume Mixer (Windows); strumento di terze parti su Mac"],
      ["Cambiare quale suono viene riprodotto","Sì","Notifications → Audio Notifications → scegliere dalla libreria dei suoni"],
      ["Silenziare un avviso specifico (p. es. ordine eseguito)","Sì","Disattivare l'audio per quello stato nella configurazione avanzata"],
      ["Mantenere il popup ma eliminare il suono","Sì","Disattivare l'interruttore audio, lasciare attiva la notifica"],
      ["Caricare un proprio file audio","No","Non supportato; inoltrare una richiesta di funzionalità"],
      ["Disattivare tutto temporaneamente","Sì","Disattivare le notifiche globalmente nelle impostazioni, riattivarle in seguito"],
      ["Avvisi più silenziosi sull'app del telefono","Nessun controllo nell'app","Abbassare il volume delle notifiche nelle impostazioni del telefono"],
    ] },
    { type: "heading",text: "Smetta del tutto di sorvegliare gli avvisi" },
    { type: "paragraph",html: "Ecco il problema di fondo dietro i suoni di notifica troppo forti: se si affida a un segnale acustico per sapere che un'esecuzione è avvenuta o che un ordine è stato rifiutato, è incatenato allo schermo e reagisce a cose già accadute. Quando la Sua strategia è automatizzata, la piattaforma non ha bisogno di urlarLe contro, l'esecuzione è già avvenuta secondo le Sue regole. PickMyTrade toglie l'avviso dal ciclo:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Esecuzione basata su segnali</strong>, la Sua strategia TradingView invia l'ordine automaticamente nel momento in cui la Sua condizione si attiva, quindi non deve restare ad aspettare un suono a cui reagire.",
        "<strong class='text-white'>Instradamento lato server</strong>, gli avvisi vengono instradati a Tradovate dai server di PickMyTrade, quindi ingressi e uscite non dipendono dalla Sua presenza alla scrivania con il volume alzato.",
        "<strong class='text-white'>Sincronizzazione multi-account</strong>, lo stesso ingresso e la stessa uscita automatizzati vengono replicati su più account Tradovate contemporaneamente, senza clic né ascolto per ogni account.",
        "<strong class='text-white'>Un proprio registro dei trade</strong>, ottiene un registro pulito di che cosa è scattato e quando, così controlla i risultati alle Sue condizioni invece di sobbalzare a ogni segnale acustico.",
      ],
    },
  ] },
  ctaHeading: { en: "Stop Chasing Every Chime", de: "Hören Sie auf, jedem Signalton hinterherzulaufen", es: "Deje de perseguir cada aviso sonoro", fr: "Cessez de courir après chaque signal sonore", it: "Smetta di inseguire ogni segnale acustico" },
  ctaText: { en: "Automate your Tradovate entries so a loud alert never runs your trading day.", de: "Automatisieren Sie Ihre Tradovate-Einstiege, damit ein lauter Alarm nie Ihren Handelstag bestimmt.", es: "Automatice sus entradas en Tradovate para que una alerta fuerte nunca dirija su jornada de trading.", fr: "Automatisez vos entrées Tradovate pour qu'une alerte bruyante ne dicte jamais votre journée de trading.", it: "Automatizzi i Suoi ingressi su Tradovate così che un avviso rumoroso non guidi mai la Sua giornata di trading." },
  ctaButtonText: { en: "Start Your Free 7-Day Trial", de: "Starten Sie Ihre kostenlose 7-Tage-Testphase", es: "Comience su prueba gratuita de 7 días", fr: "Commencez votre essai gratuit de 7 jours", it: "Inizi la prova gratuita di 7 giorni" },
  ctaUrl: "https://app.pickmytrade.trade/?register=true&utm_source=content&utm_medium=debugging",
  faqHeading: { en: "Frequently Asked Questions", de: "Häufig gestellte Fragen", es: "Preguntas frecuentes", fr: "Questions fréquentes", it: "Domande frequenti" },
  faqs: { en: [
    { q: "Can I turn down the volume of Tradovate's notification sounds?", a: "Not inside the platform. As of 2026 there's no volume slider for notification sounds in Tradovate. You control loudness at the operating-system level instead, lower the app's channel in the Windows Volume Mixer, drop your overall system volume, or pick a quieter sound and switch off the notifications you don't need." },
    { q: "How do I make Tradovate alerts quieter without muting them completely?", a: "Use per-app volume. On Windows, right-click the speaker icon, open Volume Mixer, and pull the slider for Tradovate (or your browser) down to a comfortable level while everything else stays put. Then choose a softer sound from the built-in sound library and turn off the noisier status alerts you don't care about." },
    { q: "Can I upload my own custom notification sound to Tradovate?", a: "No. There's no option to upload a custom audio file. You can only pick from Tradovate's built-in sound library for each order status. Uploading your own sound is a long-standing feature request that hasn't shipped, so file one to add your voice to it." },
    { q: "How do I turn off Tradovate order-filled sounds entirely?", a: "Open your notification settings, find the audio notifications list, and toggle off the sound for the status you want silenced, order filled, order rejected, and so on. You can silence the audio while keeping the on-screen popup, or turn the whole notification off. Confirm the exact toggle labels in your current build, as they shift between updates." },
    { q: "Why are Tradovate's default notification sounds so loud?", a: "The default alerts are mixed to be attention-grabbing so you don't miss a fill or a rejection, and there's no in-app volume control to soften them. That combination is why they feel jarring, especially on a headset. The fix is to cap the volume at the OS level and swap to a gentler sound from the library." },
    { q: "Does lowering my computer volume affect only Tradovate?", a: "Only if you use the per-app mixer. The Windows Volume Mixer gives each running app its own slider, so you can quiet Tradovate or your browser without touching music, calls, or other alerts. Dropping the master system volume lowers everything at once, which is a blunter fix." },
    { q: "Can I control notification sound volume on the Tradovate mobile app?", a: "On mobile the alert loudness follows your phone's notification and ringer volume rather than an in-app slider. Lower the notification volume in your phone's settings, or mute or remove Tradovate's notifications through the phone's app-notification controls." },
  ], de: [
    { q: "Kann ich die Lautstärke der Tradovate-Benachrichtigungstöne verringern?", a: "Nicht innerhalb der Plattform. Stand 2026 gibt es in Tradovate keinen Lautstärkeregler für Benachrichtigungstöne. Die Lautstärke steuern Sie stattdessen auf Betriebssystemebene: Verringern Sie den Kanal der App im Windows Volume Mixer, senken Sie Ihre gesamte Systemlautstärke oder wählen Sie einen leiseren Ton und schalten Sie die Benachrichtigungen aus, die Sie nicht benötigen." },
    { q: "Wie mache ich Tradovate-Alarme leiser, ohne sie ganz stummzuschalten?", a: "Nutzen Sie die Lautstärke pro App. Klicken Sie unter Windows mit der rechten Maustaste auf das Lautsprechersymbol, öffnen Sie den Volume Mixer und ziehen Sie den Regler für Tradovate (oder Ihren Browser) auf ein angenehmes Niveau, während alles andere unverändert bleibt. Wählen Sie dann einen sanfteren Ton aus der integrierten Soundbibliothek und schalten Sie die lauteren Statusalarme aus, die Sie nicht interessieren." },
    { q: "Kann ich einen eigenen Benachrichtigungston in Tradovate hochladen?", a: "Nein. Es gibt keine Möglichkeit, eine eigene Audiodatei hochzuladen. Sie können für jeden Orderstatus nur aus der integrierten Soundbibliothek von Tradovate wählen. Das Hochladen eines eigenen Tons ist ein lange bestehender Funktionswunsch, der nicht umgesetzt wurde. Reichen Sie also einen ein, um Ihre Stimme hinzuzufügen." },
    { q: "Wie schalte ich die Tradovate-Töne für ausgeführte Orders vollständig aus?", a: "Öffnen Sie Ihre Benachrichtigungseinstellungen, suchen Sie die Liste der Audio-Benachrichtigungen und schalten Sie den Ton für den gewünschten Status aus, Order ausgeführt, Order abgelehnt und so weiter. Sie können den Ton stummschalten und das Popup auf dem Bildschirm behalten oder die gesamte Benachrichtigung ausschalten. Bestätigen Sie die genauen Bezeichnungen der Schalter in Ihrer aktuellen Version, da sie sich zwischen Updates ändern." },
    { q: "Warum sind die Standard-Benachrichtigungstöne von Tradovate so laut?", a: "Die Standardalarme sind so abgemischt, dass sie Aufmerksamkeit erregen, damit Sie keine Ausführung und keine Ablehnung verpassen, und es gibt keine In-App-Lautstärkeregelung, um sie abzumildern. Diese Kombination macht sie so schroff, besonders mit einem Headset. Die Lösung besteht darin, die Lautstärke auf Betriebssystemebene zu begrenzen und zu einem sanfteren Ton aus der Bibliothek zu wechseln." },
    { q: "Beeinflusst das Senken meiner Computerlautstärke nur Tradovate?", a: "Nur wenn Sie den Mixer pro App verwenden. Der Windows Volume Mixer gibt jeder laufenden App einen eigenen Regler, sodass Sie Tradovate oder Ihren Browser leiser stellen können, ohne Musik, Anrufe oder andere Alarme zu verändern. Das Absenken der Master-Systemlautstärke senkt alles auf einmal, was eine gröbere Lösung ist." },
    { q: "Kann ich die Lautstärke der Benachrichtigungen in der mobilen Tradovate-App steuern?", a: "Auf dem Smartphone folgt die Lautstärke der Alarme der Benachrichtigungs- und Klingeltonlautstärke Ihres Telefons und nicht einem In-App-Regler. Senken Sie die Benachrichtigungslautstärke in den Telefoneinstellungen oder schalten Sie die Benachrichtigungen von Tradovate über die App-Benachrichtigungseinstellungen des Telefons stumm oder entfernen Sie sie." },
  ], es: [
    { q: "¿Puedo bajar el volumen de los sonidos de notificación de Tradovate?", a: "No dentro de la plataforma. A 2026, Tradovate no tiene un control de volumen para los sonidos de notificación. Controla el volumen a nivel del sistema operativo: baje el canal de la aplicación en el Volume Mixer de Windows, reduzca el volumen general del sistema o elija un sonido más suave y desactive las notificaciones que no necesita." },
    { q: "¿Cómo hago que las alertas de Tradovate suenen más bajo sin silenciarlas por completo?", a: "Use el volumen por aplicación. En Windows, haga clic con el botón derecho en el icono del altavoz, abra el Volume Mixer y baje el control deslizante de Tradovate (o de su navegador) a un nivel cómodo mientras todo lo demás se mantiene igual. Luego elija un sonido más suave de la biblioteca de sonidos integrada y desactive las alertas de estado más ruidosas que no le interesen." },
    { q: "¿Puedo subir mi propio sonido de notificación personalizado a Tradovate?", a: "No. No hay opción para subir un archivo de audio personalizado. Solo puede elegir de la biblioteca de sonidos integrada de Tradovate para cada estado de orden. Subir su propio sonido es una solicitud de función de larga data que no se ha implementado, así que presente una para sumar su voz." },
    { q: "¿Cómo desactivo por completo los sonidos de orden ejecutada de Tradovate?", a: "Abra los ajustes de notificaciones, busque la lista de notificaciones de audio y desactive el sonido del estado que quiere silenciar, orden ejecutada, orden rechazada, etc. Puede silenciar el audio manteniendo la ventana emergente en pantalla, o desactivar toda la notificación. Confirme las etiquetas exactas de los interruptores en su versión actual, ya que cambian entre actualizaciones." },
    { q: "¿Por qué los sonidos de notificación predeterminados de Tradovate son tan fuertes?", a: "Las alertas predeterminadas están mezcladas para llamar la atención y que no se pierda una ejecución ni un rechazo, y no hay control de volumen dentro de la aplicación para suavizarlas. Esa combinación las hace estridentes, sobre todo con auriculares. La solución es limitar el volumen a nivel del sistema operativo y cambiar a un sonido más suave de la biblioteca." },
    { q: "¿Bajar el volumen de mi ordenador afecta solo a Tradovate?", a: "Solo si usa el mezclador por aplicación. El Volume Mixer de Windows da a cada aplicación en ejecución su propio control deslizante, así que puede silenciar Tradovate o su navegador sin tocar música, llamadas u otras alertas. Bajar el volumen maestro del sistema reduce todo a la vez, lo cual es una solución más burda." },
    { q: "¿Puedo controlar el volumen de las notificaciones en la aplicación móvil de Tradovate?", a: "En el móvil, el volumen de la alerta sigue al volumen de notificaciones y de tono de llamada del teléfono, no a un control dentro de la aplicación. Baje el volumen de notificaciones en los ajustes del teléfono, o silencie o elimine las notificaciones de Tradovate mediante los controles de notificaciones de aplicaciones del teléfono." },
  ], fr: [
    { q: "Puis-je baisser le volume des sons de notification de Tradovate ?", a: "Pas à l'intérieur de la plateforme. En 2026, Tradovate n'offre aucun curseur de volume pour les sons de notification. Vous contrôlez le volume au niveau du système d'exploitation : baissez le canal de l'application dans le Volume Mixer de Windows, réduisez le volume général du système, ou choisissez un son plus doux et désactivez les notifications dont vous n'avez pas besoin." },
    { q: "Comment rendre les alertes Tradovate plus discrètes sans les couper complètement ?", a: "Utilisez le volume par application. Sous Windows, faites un clic droit sur l'icône du haut-parleur, ouvrez le Volume Mixer et abaissez le curseur de Tradovate (ou de votre navigateur) à un niveau confortable pendant que tout le reste demeure inchangé. Choisissez ensuite un son plus doux dans la bibliothèque de sons intégrée et désactivez les alertes d'état trop bruyantes qui ne vous intéressent pas." },
    { q: "Puis-je importer mon propre son de notification personnalisé dans Tradovate ?", a: "Non. Il n'existe aucune option pour importer un fichier audio personnalisé. Vous ne pouvez choisir que parmi la bibliothèque de sons intégrée de Tradovate pour chaque statut d'ordre. L'importation de votre propre son est une demande de fonctionnalité de longue date qui n'a pas été livrée ; déposez-en une pour ajouter votre voix." },
    { q: "Comment désactiver complètement les sons d'ordre exécuté de Tradovate ?", a: "Ouvrez vos paramètres de notification, trouvez la liste des notifications audio et désactivez le son du statut que vous voulez faire taire, ordre exécuté, ordre rejeté, etc. Vous pouvez couper le son tout en conservant la fenêtre contextuelle à l'écran, ou désactiver toute la notification. Vérifiez les libellés exacts des interrupteurs dans votre version actuelle, car ils changent d'une mise à jour à l'autre." },
    { q: "Pourquoi les sons de notification par défaut de Tradovate sont-ils si forts ?", a: "Les alertes par défaut sont mixées pour attirer l'attention afin que vous ne manquiez ni une exécution ni un rejet, et aucun contrôle de volume intégré à l'application ne permet de les adoucir. Cette combinaison les rend agressives, surtout au casque. La solution consiste à plafonner le volume au niveau du système d'exploitation et à passer à un son plus doux de la bibliothèque." },
    { q: "Baisser le volume de mon ordinateur n'affecte-t-il que Tradovate ?", a: "Seulement si vous utilisez le mélangeur par application. Le Volume Mixer de Windows donne à chaque application en cours d'exécution son propre curseur, ce qui vous permet de baisser Tradovate ou votre navigateur sans toucher à la musique, aux appels ou aux autres alertes. Baisser le volume principal du système réduit tout à la fois, ce qui est une solution plus grossière." },
    { q: "Puis-je contrôler le volume des notifications dans l'application mobile Tradovate ?", a: "Sur mobile, le volume de l'alerte suit le volume des notifications et de la sonnerie de votre téléphone plutôt qu'un curseur dans l'application. Baissez le volume des notifications dans les paramètres de votre téléphone, ou coupez ou supprimez les notifications de Tradovate via les commandes de notification des applications du téléphone." },
  ], it: [
    { q: "Posso abbassare il volume dei suoni di notifica di Tradovate?", a: "Non all'interno della piattaforma. Nel 2026 non esiste un cursore del volume per i suoni di notifica in Tradovate. Il volume si controlla invece a livello di sistema operativo: abbassi il canale dell'app nel Volume Mixer di Windows, riduca il volume generale del sistema oppure scelga un suono più delicato e disattivi le notifiche che non Le servono." },
    { q: "Come rendo gli avvisi di Tradovate più silenziosi senza disattivarli completamente?", a: "Usi il volume per app. In Windows, faccia clic con il tasto destro sull'icona dell'altoparlante, apra il Volume Mixer e abbassi il cursore di Tradovate (o del Suo browser) a un livello confortevole lasciando invariato tutto il resto. Poi scelga un suono più morbido dalla libreria di suoni integrata e disattivi gli avvisi di stato più rumorosi che non Le interessano." },
    { q: "Posso caricare un mio suono di notifica personalizzato su Tradovate?", a: "No. Non c'è alcuna opzione per caricare un file audio personalizzato. Può solo scegliere dalla libreria di suoni integrata di Tradovate per ciascuno stato dell'ordine. Caricare il proprio suono è una richiesta di funzionalità di lunga data che non è stata rilasciata, quindi ne inoltri una per aggiungere la Sua voce." },
    { q: "Come disattivo completamente i suoni di ordine eseguito di Tradovate?", a: "Apra le impostazioni delle notifiche, trovi l'elenco delle notifiche audio e disattivi il suono per lo stato che vuole silenziare, ordine eseguito, ordine rifiutato e così via. Può silenziare l'audio mantenendo il popup sullo schermo, oppure disattivare l'intera notifica. Verifichi le etichette esatte degli interruttori nella Sua versione attuale, poiché cambiano tra un aggiornamento e l'altro." },
    { q: "Perché i suoni di notifica predefiniti di Tradovate sono così forti?", a: "Gli avvisi predefiniti sono mixati per attirare l'attenzione così da non perdere un'esecuzione o un rifiuto, e non esiste un controllo del volume nell'app per attenuarli. Questa combinazione li rende fastidiosi, soprattutto con le cuffie. La soluzione è limitare il volume a livello di sistema operativo e passare a un suono più delicato della libreria." },
    { q: "Abbassare il volume del mio computer influisce solo su Tradovate?", a: "Solo se usa il mixer per app. Il Volume Mixer di Windows assegna a ogni app in esecuzione un proprio cursore, così può abbassare Tradovate o il browser senza toccare musica, chiamate o altri avvisi. Abbassare il volume principale del sistema riduce tutto insieme, una soluzione più grossolana." },
    { q: "Posso controllare il volume delle notifiche nell'app mobile di Tradovate?", a: "Su mobile il volume dell'avviso segue il volume delle notifiche e della suoneria del telefono anziché un cursore nell'app. Abbassi il volume delle notifiche nelle impostazioni del telefono, oppure silenzi o rimuova le notifiche di Tradovate tramite i controlli delle notifiche delle app del telefono." },
  ] },
