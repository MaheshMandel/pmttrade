---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "triggered-alerts-easy-to-miss";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/debugging/${SLUG}`;

const META_TITLE = "Tradovate Triggered Alerts Easy to Miss";
const META_DESCRIPTION =
  "Tradovate alerts are easy to miss when the native cue is weak. Turn on sound, popups and mobile push, plus external backups, so you never miss a level.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Ausgelöste Tradovate-Alerts sind leicht zu übersehen", es: "Las alertas activadas de Tradovate son fáciles de pasar por alto", fr: "Les alertes Tradovate déclenchées passent facilement inaperçues", it: "Gli alert Tradovate attivati passano facilmente inosservati" },
  dek: { en: "Tradovate's native alert is one quiet chime and a small red dot. Here's why that's so easy to miss during a fast session, and how to layer sound, popups, mobile push, and an external backup so a level never slips past you.", de: "Der native Alert von Tradovate besteht aus einem leisen Signalton und einem kleinen roten Punkt. Warum man ihn in einer schnellen Sitzung so leicht übersieht und wie Sie Ton, Popups, mobile Push-Nachrichten und ein externes Backup kombinieren, damit Ihnen nie wieder ein Level entgeht.", es: "La alerta nativa de Tradovate es un tono discreto y un pequeño punto rojo. Por qué es tan fácil pasarla por alto en una sesión rápida y cómo combinar sonido, ventanas emergentes, notificaciones push móviles y una copia de seguridad externa para que un nivel nunca se le escape.", fr: "L'alerte native de Tradovate se résume à un carillon discret et à un petit point rouge. Pourquoi on la rate si facilement pendant une séance rapide, et comment superposer son, popups, notifications push mobiles et sauvegarde externe pour qu'un niveau ne vous échappe jamais.", it: "L'alert nativo di Tradovate è un tenue segnale acustico e un piccolo punto rosso. Perché è così facile non notarlo durante una sessione veloce e come sovrapporre audio, popup, notifiche push su mobile e un backup esterno affinché un livello non Le sfugga mai." },
  readTime: { en: "6 min read", de: "6 Min. Lesezeit", es: "Lectura de 6 min", fr: "Lecture : 6 min", it: "Lettura di 6 min" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "You set an alert at a key level, went back to watching the ladder on your other monitor, and price ran right through it. Nothing beeped. Or something beeped, once, and by the time you glanced over the move was gone. Here is the frustrating part: the alert didn't fail. It fired exactly when it should have. You just didn't notice." },
    { type: "paragraph", html: "Tradovate's native trigger is deliberately understated. When an alert hits, the browser plays a short sound and a small red dot appears on the bell-shaped Alerts icon near the top-left of your workspace. That's it. No flashing tab, no color change on the chart, no second reminder if you miss the first one. In a quiet room with the tab in focus, that's enough. In the middle of a fast session with your volume down and three instruments open, it's basically invisible." },
    { type: "paragraph", html: "The fix isn't one setting. It's layering. Turn on every native cue Tradovate gives you, add a push to your phone, and keep an external backup channel running so a single quiet chime is never the only thing standing between you and the trade you were waiting for." },
    { type: "heading", text: "What “Easy to Miss” Actually Looks Like" },
    { type: "paragraph", html: "Before you change anything, it helps to recognize the pattern, because it's almost always the same handful of situations:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Your volume is low or muted.</strong> The alert sound is brief and not loud. If your system volume is turned down for a call or music, the chime never registers.",
        "<strong class='text-white'>The tab is in the background.</strong> You're on TradingView, a spreadsheet, or another browser tab. Tradovate's red dot is on a tab you can't see, and a background tab's sound is easy to tune out.",
        "<strong class='text-white'>You're watching a different module.</strong> Eyes on the SuperDOM or a chart on a second screen, the bell icon sits quietly in the corner where you're not looking.",
        "<strong class='text-white'>Multiple instruments are open.</strong> One dot on one shared bell icon doesn't tell you <em>which</em> alert fired, so even when you catch it you lose seconds figuring out what happened.",
        "<strong class='text-white'>You stepped away.</strong> Grabbed coffee, took a call. A browser-only alert has zero reach once you leave the desk.",
      ],
    },
    { type: "paragraph", html: "If any of those describe your setup, the alert working correctly and you missing it are completely compatible. That's the whole problem this guide solves." },
    { type: "heading", text: "Why the Native Alert Is So Quiet" },
    { type: "paragraph", html: "Tradovate's alert design leans minimal on purpose. A triggered alert produces two things: an audible chime through your browser and a red badge on the Alerts bell. Both are one-shot. The sound plays once and stops. The dot sits there until you open the Alerts panel, but it doesn't pulse, grow, or move to grab your eye. There's no default behavior that flashes the instrument tab or repaints the chart's alert marker to scream &ldquo;look here.&rdquo;" },
    { type: "paragraph", html: "That's a reasonable default for someone with a single chart, tab focused, headphones on. It's a poor default for an active trader juggling several symbols and other apps. The signal exists; its intensity just doesn't match how much a missed level can cost you. So the job is to crank up the intensity yourself, on every channel available." },
    { type: "heading", text: "Fix 1: Switch on Every Cue When You Build the Alert" },
    { type: "paragraph", html: "Start at the source. When you create an alert, Tradovate lets you choose the notification type, and most people accept whatever default is checked and move on. Don't. Turn on both the sound and the popup so the same trigger fires two cues at once." },
    { type: "paragraph", html: "To create the alert, click the bell-shaped Alerts icon near the top-left of the workspace to open the New Alert menu, or right-click a price level directly on a chart or the DOM ladder and choose the add-alert option. Set your condition (Price Crosses, Price Touches, and similar), enter the exact price, and before you confirm, make sure the notification options include <strong class='text-white'>Sound</strong> and <strong class='text-white'>Popup</strong> rather than just one of them." },
    { type: "paragraph", html: "While you're in there, decide whether the alert should be one-time or recurring. A one-time alert that fires and quietly clears itself is easy to miss <em>and</em> gone for good, so for a level you truly care about, a recurring or persistent trigger buys you a second chance if you blink on the first. Just don't stack so many recurring alerts that they blur into background noise. If you set a range of levels, keep them meaningful." },
    { type: "heading", text: "Fix 2: Let the Popup Actually Pop" },
    { type: "paragraph", html: "Checking the Popup box does nothing on its own if your browser or the desktop app was never granted permission to show notifications. The first time an app wants to raise a system popup, the browser asks once. Click away or hit block, and every popup after that is silently suppressed. You'll swear you enabled popups, and technically you did, but the operating system is throwing them in the trash." },
    { type: "paragraph", html: "Open your browser's site settings for the Tradovate web app (or your operating system's notification settings for the desktop app) and confirm notifications are set to <strong class='text-white'>Allow</strong>. On Windows, also check that Focus Assist or Do Not Disturb isn't quietly holding banners back. On a Mac, check the notification settings for your browser under System Settings. Once permission is granted, that popup banner becomes one of your loudest, hardest-to-ignore cues because it appears over whatever you're doing." },
    { type: "heading", text: "Fix 3: Put an Alert on Your Phone" },
    { type: "paragraph", html: "The browser can only reach you at the desk. A push notification follows you to the kitchen. Install the Tradovate mobile app, sign in with the same account, and allow push notifications when prompted. Now a triggered price alert can buzz your pocket, which is a completely different sensory channel from a chime you might not hear." },
    { type: "paragraph", html: "Push is also your safety net for the situations a browser can't cover: you closed the laptop lid, the machine went to sleep, your internet dropped for a moment. A phone with its own connection and its own vibration is redundancy that costs nothing to set up." },
    { type: "heading", text: "Fix 4: Keep an External Backup Channel" },
    { type: "paragraph", html: "Layering native cues gets you most of the way. But the strongest setup treats Tradovate's alert as one signal among several, and routes the <em>same</em> condition through a channel you control. That way a level you care about can notify you louder, on a device of your choice, or even act on the signal for you instead of just pinging. Two common approaches:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Mirror the condition in TradingView.</strong> If you already chart on TradingView, set the identical price or indicator alert there. TradingView's alert system is loud, configurable, and can push to its own mobile app, email, and popups independently of Tradovate. If one channel is quiet, the other still reaches you.",
        "<strong class='text-white'>Turn the alert into an action.</strong> The real reason most levels matter is that you plan to <em>do</em> something when price gets there. Instead of relying on a notification you might miss, route a TradingView alert through an automation bridge so the signal fires the order for you. A missed chime stops costing you a fill because the fill no longer depends on you seeing the chime.",
      ],
    },
    { type: "heading", text: "Quick Wins, Matched to Why You Missed It" },
    { type: "paragraph", html: "If you want the short version, find the reason your alert slipped past and apply the matching fix:" },
    {
      type: "table",
      headers: ["Why it was easy to miss", "What to change"],
      rows: [
        ["System or browser volume was low", "Raise OS and browser volume; pick a notification sound you'll actually notice"],
        ["Only a sound, no popup", "Enable both Sound and Popup on the alert, and grant browser notification permission"],
        ["Tradovate tab was in the background", "Add a mobile push and an external TradingView alert so a hidden tab isn't the only channel"],
        ["You stepped away from the desk", "Turn on Tradovate mobile push notifications"],
        ["One dot for many instruments", "Give critical levels their own external alert with a labeled message so you know which one fired"],
        ["Missing the level costs a real fill", "Automate the action so you don't depend on noticing the alert at all"],
      ],
    },
    { type: "heading", text: "When It's Genuinely Not Your Setup" },
    { type: "paragraph", html: "Almost every &ldquo;my alert didn't work&rdquo; turns out to be a missed cue rather than a broken alert. But rule out the real failures too. Confirm the alert is still active and wasn't a one-time trigger that already fired and cleared. Check that the symbol on the alert matches the contract you're actually watching, since an alert set on an expired or wrong-month contract won't track the price you're staring at. And if you left the platform idle long enough to be logged out, a browser that's no longer connected can't chime at all, which is another reason the phone push and an external channel matter." },
    { type: "paragraph", html: "If the alert is active, on the right contract, on a connected session, and it still never produces a sound or a red dot when price clearly crossed the level, that's worth reporting to Tradovate support with the alert details and a timestamp. That's rare, though. Nine times out of ten, the answer is that a quiet, single-shot cue lost a race against a moving market, and the cure is more cues, on more channels, plus automation for the levels where a miss actually hurts." },
  ], de: [
    { type: "paragraph",html: "Sie haben einen Alert auf einem wichtigen Level gesetzt, sind zurück zur Beobachtung der Leiter auf Ihrem anderen Monitor gewechselt, und der Kurs ist einfach durchgelaufen. Nichts hat gepiept. Oder es hat einmal gepiept, und als Sie hinsahen, war die Bewegung vorbei. Das Frustrierende daran: Der Alert hat nicht versagt. Er wurde genau dann ausgelöst, wann er sollte. Sie haben ihn nur nicht bemerkt." },
    { type: "paragraph",html: "Der native Auslöser von Tradovate ist bewusst zurückhaltend. Wenn ein Alert greift, spielt der Browser einen kurzen Ton ab, und ein kleiner roter Punkt erscheint auf dem glockenförmigen Alerts-Symbol oben links in Ihrem Workspace. Das war es. Kein blinkender Tab, kein Farbwechsel im Chart, keine zweite Erinnerung, wenn Sie die erste verpassen. In einem ruhigen Raum mit fokussiertem Tab reicht das. Mitten in einer schnellen Sitzung mit niedriger Lautstärke und drei geöffneten Instrumenten ist es praktisch unsichtbar." },
    { type: "paragraph",html: "Die Lösung ist nicht eine einzelne Einstellung. Es ist das Schichten mehrerer Signale. Schalten Sie jedes native Signal ein, das Tradovate bietet, fügen Sie eine Push-Nachricht auf Ihr Smartphone hinzu und halten Sie einen externen Backup-Kanal am Laufen, damit ein einzelner leiser Signalton nie das Einzige ist, was zwischen Ihnen und dem Trade steht, auf den Sie gewartet haben." },
    { type: "heading",text: "Wie „leicht zu übersehen“ tatsächlich aussieht" },
    { type: "paragraph",html: "Bevor Sie etwas ändern, hilft es, das Muster zu erkennen, denn es sind fast immer dieselben wenigen Situationen:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Ihre Lautstärke ist niedrig oder stummgeschaltet.</strong> Der Alert-Ton ist kurz und nicht laut. Wenn Ihre Systemlautstärke wegen eines Anrufs oder Musik heruntergedreht ist, kommt der Signalton nie an.",
        "<strong class='text-white'>Der Tab ist im Hintergrund.</strong> Sie sind in TradingView, einer Tabelle oder einem anderen Browser-Tab. Der rote Punkt von Tradovate sitzt auf einem Tab, den Sie nicht sehen, und der Ton eines Hintergrund-Tabs wird leicht ausgeblendet.",
        "<strong class='text-white'>Sie beobachten ein anderes Modul.</strong> Die Augen sind auf dem SuperDOM oder einem Chart auf einem zweiten Bildschirm, und das Glockensymbol sitzt still in der Ecke, in die Sie nicht schauen.",
        "<strong class='text-white'>Mehrere Instrumente sind geöffnet.</strong> Ein Punkt auf einem gemeinsamen Glockensymbol sagt Ihnen nicht, <em>welcher</em> Alert ausgelöst wurde, sodass Sie selbst dann, wenn Sie ihn bemerken, Sekunden verlieren, um herauszufinden, was passiert ist.",
        "<strong class='text-white'>Sie haben sich entfernt.</strong> Kaffee geholt, ein Telefonat geführt. Ein reiner Browser-Alert hat keine Reichweite mehr, sobald Sie den Schreibtisch verlassen.",
      ],
    },
    { type: "paragraph",html: "Wenn eine dieser Situationen Ihr Setup beschreibt, schließen sich ein korrekt funktionierender Alert und Ihr Verpassen nicht aus. Genau das ist das Problem, das dieser Leitfaden löst." },
    { type: "heading",text: "Warum der native Alert so leise ist" },
    { type: "paragraph",html: "Das Alert-Design von Tradovate ist absichtlich minimalistisch. Ein ausgelöster Alert erzeugt zwei Dinge: einen hörbaren Signalton über Ihren Browser und ein rotes Badge auf der Alerts-Glocke. Beides geschieht einmalig. Der Ton wird einmal abgespielt und endet. Der Punkt bleibt, bis Sie das Alerts-Panel öffnen, pulsiert, wächst oder bewegt sich aber nicht, um Ihren Blick einzufangen. Es gibt kein Standardverhalten, das den Instrumenten-Tab blinken lässt oder die Alert-Markierung im Chart neu einfärbt, um &ldquo;schau hierher&rdquo; zu schreien." },
    { type: "paragraph",html: "Das ist ein vernünftiger Standard für jemanden mit einem einzigen Chart, fokussiertem Tab und Kopfhörern. Für einen aktiven Trader, der mehrere Symbole und andere Apps jongliert, ist es ein schlechter Standard. Das Signal existiert; seine Intensität passt nur nicht dazu, wie viel ein verpasstes Level kosten kann. Ihre Aufgabe ist es also, die Intensität selbst hochzudrehen, auf jedem verfügbaren Kanal." },
    { type: "heading",text: "Lösung 1: Aktivieren Sie beim Erstellen des Alerts jedes Signal" },
    { type: "paragraph",html: "Beginnen Sie an der Quelle. Beim Erstellen eines Alerts lässt Tradovate Sie den Benachrichtigungstyp wählen, und die meisten akzeptieren die voreingestellte Auswahl und machen weiter. Tun Sie das nicht. Schalten Sie sowohl den Ton als auch das Popup ein, damit derselbe Auslöser zwei Signale gleichzeitig feuert." },
    { type: "paragraph",html: "Um den Alert zu erstellen, klicken Sie auf das glockenförmige Alerts-Symbol oben links im Workspace, um das Menü New Alert zu öffnen, oder klicken Sie mit der rechten Maustaste direkt auf ein Preisniveau im Chart oder in der DOM-Leiter und wählen Sie die Option zum Hinzufügen eines Alerts. Legen Sie Ihre Bedingung fest (Price Crosses, Price Touches und ähnliche), geben Sie den genauen Preis ein und stellen Sie vor dem Bestätigen sicher, dass die Benachrichtigungsoptionen <strong class='text-white'>Sound</strong> und <strong class='text-white'>Popup</strong> enthalten und nicht nur eine davon." },
    { type: "paragraph",html: "Entscheiden Sie dabei auch, ob der Alert einmalig oder wiederkehrend sein soll. Ein einmaliger Alert, der feuert und sich still selbst löscht, ist leicht zu übersehen <em>und</em> für immer weg. Bei einem Level, das Ihnen wirklich wichtig ist, gibt Ihnen ein wiederkehrender oder persistenter Auslöser eine zweite Chance, falls Sie beim ersten Mal blinzeln. Stapeln Sie nur nicht so viele wiederkehrende Alerts, dass sie zu Hintergrundrauschen verschwimmen. Wenn Sie eine Reihe von Levels setzen, halten Sie sie aussagekräftig." },
    { type: "heading",text: "Lösung 2: Lassen Sie das Popup auch wirklich aufpoppen" },
    { type: "paragraph",html: "Das Aktivieren des Kontrollkästchens Popup bewirkt von sich aus nichts, wenn Ihrem Browser oder der Desktop-App nie die Berechtigung zum Anzeigen von Benachrichtigungen erteilt wurde. Wenn eine App zum ersten Mal ein System-Popup auslösen möchte, fragt der Browser einmal nach. Klicken Sie weg oder auf Blockieren, wird jedes weitere Popup stillschweigend unterdrückt. Sie werden schwören, Popups aktiviert zu haben, und technisch haben Sie das auch, aber das Betriebssystem wirft sie in den Papierkorb." },
    { type: "paragraph",html: "Öffnen Sie die Website-Einstellungen Ihres Browsers für die Tradovate-Web-App (oder die Benachrichtigungseinstellungen Ihres Betriebssystems für die Desktop-App) und bestätigen Sie, dass Benachrichtigungen auf <strong class='text-white'>Allow</strong> stehen. Prüfen Sie unter Windows außerdem, dass Focus Assist oder „Nicht stören“ keine Banner zurückhält. Prüfen Sie auf einem Mac die Benachrichtigungseinstellungen Ihres Browsers in den Systemeinstellungen. Sobald die Berechtigung erteilt ist, wird dieses Popup-Banner zu einem Ihrer lautesten, am schwersten zu ignorierenden Signale, weil es über allem erscheint, was Sie gerade tun." },
    { type: "heading",text: "Lösung 3: Legen Sie einen Alert auf Ihr Smartphone" },
    { type: "paragraph",html: "Der Browser erreicht Sie nur am Schreibtisch. Eine Push-Nachricht folgt Ihnen in die Küche. Installieren Sie die mobile Tradovate-App, melden Sie sich mit demselben Konto an und erlauben Sie Push-Benachrichtigungen, wenn Sie dazu aufgefordert werden. Nun kann ein ausgelöster Preisalarm in Ihrer Tasche vibrieren, ein völlig anderer Sinneskanal als ein Signalton, den Sie vielleicht nicht hören." },
    { type: "paragraph",html: "Push ist außerdem Ihr Sicherheitsnetz für Situationen, die ein Browser nicht abdecken kann: Sie haben den Laptop zugeklappt, der Rechner ist in den Ruhezustand gegangen, Ihr Internet ist kurz ausgefallen. Ein Smartphone mit eigener Verbindung und eigener Vibration ist Redundanz, deren Einrichtung nichts kostet." },
    { type: "heading",text: "Lösung 4: Halten Sie einen externen Backup-Kanal bereit" },
    { type: "paragraph",html: "Das Schichten nativer Signale bringt Sie ein gutes Stück weit. Das stärkste Setup behandelt den Alert von Tradovate jedoch als ein Signal unter mehreren und leitet <em>dieselbe</em> Bedingung über einen Kanal, den Sie selbst kontrollieren. So kann Sie ein Level, das Ihnen wichtig ist, lauter, auf einem Gerät Ihrer Wahl benachrichtigen oder sogar für Sie auf das Signal reagieren, statt nur zu pingen. Zwei gängige Ansätze:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Spiegeln Sie die Bedingung in TradingView.</strong> Wenn Sie ohnehin in TradingView charten, setzen Sie dort den identischen Preis- oder Indikator-Alert. Das Alert-System von TradingView ist laut, konfigurierbar und kann unabhängig von Tradovate an die eigene mobile App, per E-Mail und per Popup pushen. Ist ein Kanal leise, erreicht Sie der andere trotzdem.",
        "<strong class='text-white'>Machen Sie aus dem Alert eine Aktion.</strong> Der eigentliche Grund, warum die meisten Levels wichtig sind, ist, dass Sie etwas <em>tun</em> wollen, wenn der Kurs dort ankommt. Statt sich auf eine Benachrichtigung zu verlassen, die Sie verpassen könnten, leiten Sie einen TradingView-Alert über eine Automatisierungsbrücke, sodass das Signal die Order für Sie auslöst. Ein verpasster Signalton kostet Sie keinen Fill mehr, weil der Fill nicht mehr davon abhängt, dass Sie den Signalton bemerken.",
      ],
    },
    { type: "heading",text: "Schnelle Erfolge, passend zum Grund, warum Sie ihn verpasst haben" },
    { type: "paragraph",html: "Wenn Sie die Kurzfassung möchten, finden Sie den Grund, warum Ihr Alert an Ihnen vorbeigegangen ist, und wenden Sie die passende Lösung an:" },
    { type: "table", headers: ["Warum er leicht zu übersehen war","Was zu ändern ist"], rows: [
      ["System- oder Browser-Lautstärke war niedrig","Lautstärke von Betriebssystem und Browser erhöhen; einen Benachrichtigungston wählen, den Sie tatsächlich bemerken"],
      ["Nur ein Ton, kein Popup","Sound und Popup am Alert aktivieren und die Benachrichtigungsberechtigung des Browsers erteilen"],
      ["Der Tradovate-Tab war im Hintergrund","Mobile Push und einen externen TradingView-Alert hinzufügen, damit ein verdeckter Tab nicht der einzige Kanal ist"],
      ["Sie haben sich vom Schreibtisch entfernt","Mobile Push-Benachrichtigungen von Tradovate einschalten"],
      ["Ein Punkt für viele Instrumente","Kritischen Levels einen eigenen externen Alert mit beschrifteter Nachricht geben, damit Sie wissen, welcher ausgelöst wurde"],
      ["Das verpasste Level kostet einen echten Fill","Die Aktion automatisieren, damit Sie nicht davon abhängen, den Alert zu bemerken"],
    ] },
    { type: "heading",text: "Wenn es wirklich nicht an Ihrem Setup liegt" },
    { type: "paragraph",html: "Fast jedes &ldquo;mein Alert hat nicht funktioniert&rdquo; entpuppt sich als verpasstes Signal und nicht als defekter Alert. Schließen Sie aber auch die echten Fehler aus. Prüfen Sie, ob der Alert noch aktiv ist und nicht ein einmaliger Auslöser war, der bereits gefeuert hat und gelöscht wurde. Prüfen Sie, ob das Symbol am Alert zum Kontrakt passt, den Sie tatsächlich beobachten, denn ein Alert auf einem abgelaufenen oder falschen Monatskontrakt verfolgt nicht den Kurs, auf den Sie starren. Und wenn Sie die Plattform lange genug im Leerlauf gelassen haben, um abgemeldet zu werden, kann ein Browser ohne Verbindung überhaupt keinen Signalton abspielen, ein weiterer Grund, warum Push auf dem Smartphone und ein externer Kanal wichtig sind." },
    { type: "paragraph",html: "Wenn der Alert aktiv ist, auf dem richtigen Kontrakt liegt, in einer verbundenen Sitzung läuft und trotzdem weder Ton noch roten Punkt erzeugt, obwohl der Kurs das Level eindeutig durchquert hat, lohnt sich eine Meldung an den Tradovate-Support mit den Alert-Details und einem Zeitstempel. Das ist jedoch selten. In neun von zehn Fällen verlor ein leises, einmaliges Signal das Rennen gegen einen sich bewegenden Markt, und das Mittel dagegen sind mehr Signale auf mehr Kanälen, plus Automatisierung für die Levels, bei denen ein Verpassen wirklich wehtut." },
  ], es: [
    { type: "paragraph",html: "Colocó una alerta en un nivel clave, volvió a mirar la escalera en su otro monitor y el precio lo atravesó sin más. No sonó nada. O sonó algo, una sola vez, y cuando miró el movimiento ya había pasado. Esto es lo frustrante: la alerta no falló. Se disparó exactamente cuando debía. Simplemente usted no se dio cuenta." },
    { type: "paragraph",html: "El disparador nativo de Tradovate es deliberadamente discreto. Cuando salta una alerta, el navegador reproduce un sonido breve y aparece un pequeño punto rojo en el icono de campana de Alerts, en la parte superior izquierda de su espacio de trabajo. Eso es todo. Ninguna pestaña parpadeante, ningún cambio de color en el gráfico, ningún segundo recordatorio si se pierde el primero. En una habitación tranquila con la pestaña en primer plano, eso basta. En mitad de una sesión rápida, con el volumen bajo y tres instrumentos abiertos, es prácticamente invisible." },
    { type: "paragraph",html: "La solución no es un único ajuste. Es la superposición de capas. Active todas las señales nativas que ofrece Tradovate, añada una notificación push en su teléfono y mantenga un canal externo de respaldo funcionando para que un único tono discreto nunca sea lo único que se interpone entre usted y la operación que estaba esperando." },
    { type: "heading",text: "Cómo es en realidad “fácil de pasar por alto”" },
    { type: "paragraph",html: "Antes de cambiar nada, conviene reconocer el patrón, porque casi siempre son las mismas pocas situaciones:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Su volumen está bajo o silenciado.</strong> El sonido de la alerta es breve y no muy fuerte. Si el volumen del sistema está bajado por una llamada o por música, el tono nunca se registra.",
        "<strong class='text-white'>La pestaña está en segundo plano.</strong> Está en TradingView, en una hoja de cálculo o en otra pestaña del navegador. El punto rojo de Tradovate está en una pestaña que no ve, y el sonido de una pestaña en segundo plano es fácil de ignorar.",
        "<strong class='text-white'>Está mirando otro módulo.</strong> Con los ojos en el SuperDOM o en un gráfico de una segunda pantalla, el icono de campana queda en silencio en la esquina donde no está mirando.",
        "<strong class='text-white'>Hay varios instrumentos abiertos.</strong> Un punto en un icono de campana compartido no le dice <em>cuál</em> alerta se disparó, así que incluso cuando se da cuenta pierde segundos averiguando qué ocurrió.",
        "<strong class='text-white'>Se alejó.</strong> Fue a por un café o atendió una llamada. Una alerta solo de navegador no tiene alcance alguno una vez que deja el escritorio.",
      ],
    },
    { type: "paragraph",html: "Si alguna de esas situaciones describe su configuración, que la alerta funcione correctamente y que usted se la pierda son cosas perfectamente compatibles. Ese es todo el problema que resuelve esta guía." },
    { type: "heading",text: "Por qué la alerta nativa es tan discreta" },
    { type: "paragraph",html: "El diseño de las alertas de Tradovate es minimalista a propósito. Una alerta activada produce dos cosas: un tono audible a través de su navegador y una insignia roja en la campana de Alerts. Ambas son de un solo disparo. El sonido se reproduce una vez y se detiene. El punto permanece hasta que abre el panel de Alerts, pero no pulsa, ni crece, ni se mueve para captar su atención. No hay ningún comportamiento predeterminado que haga parpadear la pestaña del instrumento o redibuje el marcador de la alerta en el gráfico para gritar &ldquo;mire aquí&rdquo;." },
    { type: "paragraph",html: "Es un valor predeterminado razonable para alguien con un solo gráfico, la pestaña en primer plano y auriculares puestos. Es un mal valor predeterminado para un trader activo que malabarea varios símbolos y otras aplicaciones. La señal existe; simplemente su intensidad no se corresponde con lo que puede costarle un nivel perdido. Así que su trabajo es subir usted mismo la intensidad, en todos los canales disponibles." },
    { type: "heading",text: "Solución 1: active todas las señales al crear la alerta" },
    { type: "paragraph",html: "Empiece por el origen. Al crear una alerta, Tradovate le deja elegir el tipo de notificación, y la mayoría acepta lo que viene marcado por defecto y sigue adelante. No lo haga. Active tanto el sonido como la ventana emergente para que el mismo disparador lance dos señales a la vez." },
    { type: "paragraph",html: "Para crear la alerta, haga clic en el icono de campana de Alerts situado en la parte superior izquierda del espacio de trabajo para abrir el menú New Alert, o haga clic derecho sobre un nivel de precio directamente en un gráfico o en la escalera del DOM y elija la opción de añadir alerta. Establezca su condición (Price Crosses, Price Touches y similares), introduzca el precio exacto y, antes de confirmar, asegúrese de que las opciones de notificación incluyan <strong class='text-white'>Sound</strong> y <strong class='text-white'>Popup</strong> y no solo una de ellas." },
    { type: "paragraph",html: "Mientras está ahí, decida si la alerta debe ser única o recurrente. Una alerta única que se dispara y se borra en silencio es fácil de pasar por alto <em>y</em> desaparece para siempre, así que para un nivel que realmente le importa, un disparador recurrente o persistente le da una segunda oportunidad si parpadea en la primera. Eso sí, no acumule tantas alertas recurrentes que se confundan con el ruido de fondo. Si establece una serie de niveles, mantenga que sean significativos." },
    { type: "heading",text: "Solución 2: haga que la ventana emergente realmente aparezca" },
    { type: "paragraph",html: "Marcar la casilla Popup no hace nada por sí solo si nunca se concedió permiso a su navegador o a la aplicación de escritorio para mostrar notificaciones. La primera vez que una aplicación quiere mostrar una ventana emergente del sistema, el navegador pregunta una sola vez. Si pulsa fuera o elige bloquear, todas las ventanas emergentes posteriores se suprimen en silencio. Jurará que las activó, y técnicamente lo hizo, pero el sistema operativo las tira a la basura." },
    { type: "paragraph",html: "Abra la configuración del sitio de su navegador para la aplicación web de Tradovate (o la configuración de notificaciones de su sistema operativo para la aplicación de escritorio) y confirme que las notificaciones están en <strong class='text-white'>Allow</strong>. En Windows, compruebe también que la Asistencia de concentración o No molestar no esté reteniendo discretamente los avisos. En un Mac, revise la configuración de notificaciones de su navegador en Ajustes del Sistema. Una vez concedido el permiso, ese aviso emergente pasa a ser una de sus señales más fuertes y difíciles de ignorar, porque aparece sobre lo que esté haciendo." },
    { type: "heading",text: "Solución 3: ponga una alerta en su teléfono" },
    { type: "paragraph",html: "El navegador solo puede alcanzarle en el escritorio. Una notificación push le sigue hasta la cocina. Instale la aplicación móvil de Tradovate, inicie sesión con la misma cuenta y permita las notificaciones push cuando se le solicite. Ahora una alerta de precio activada puede hacer vibrar su bolsillo, un canal sensorial completamente distinto de un tono que quizá no oiga." },
    { type: "paragraph",html: "El push es también su red de seguridad para las situaciones que un navegador no puede cubrir: cerró la tapa del portátil, el equipo se suspendió, su internet se cortó un instante. Un teléfono con su propia conexión y su propia vibración es una redundancia que no cuesta nada configurar." },
    { type: "heading",text: "Solución 4: mantenga un canal externo de respaldo" },
    { type: "paragraph",html: "Superponer señales nativas le lleva la mayor parte del camino. Pero la configuración más sólida trata la alerta de Tradovate como una señal entre varias y enruta la <em>misma</em> condición a través de un canal que usted controla. Así, un nivel que le importa puede avisarle con más fuerza, en un dispositivo de su elección, o incluso actuar por usted ante la señal en lugar de limitarse a avisar. Dos enfoques habituales:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Replique la condición en TradingView.</strong> Si ya hace sus gráficos en TradingView, configure allí la misma alerta de precio o de indicador. El sistema de alertas de TradingView es potente, configurable y puede enviar notificaciones a su propia aplicación móvil, por correo electrónico y en ventanas emergentes con independencia de Tradovate. Si un canal está en silencio, el otro sigue llegándole.",
        "<strong class='text-white'>Convierta la alerta en una acción.</strong> La verdadera razón por la que la mayoría de los niveles importan es que piensa <em>hacer</em> algo cuando el precio llegue. En lugar de depender de una notificación que podría perderse, enrute una alerta de TradingView a través de un puente de automatización para que la señal ejecute la orden por usted. Un tono perdido deja de costarle una ejecución porque la ejecución ya no depende de que usted oiga el tono.",
      ],
    },
    { type: "heading",text: "Soluciones rápidas según por qué se la perdió" },
    { type: "paragraph",html: "Si quiere la versión corta, encuentre la razón por la que su alerta se le escapó y aplique la solución correspondiente:" },
    { type: "table", headers: ["Por qué fue fácil de pasar por alto","Qué cambiar"], rows: [
      ["El volumen del sistema o del navegador estaba bajo","Suba el volumen del sistema operativo y del navegador; elija un sonido de notificación que realmente note"],
      ["Solo sonido, sin ventana emergente","Active Sound y Popup en la alerta y conceda el permiso de notificaciones del navegador"],
      ["La pestaña de Tradovate estaba en segundo plano","Añada una notificación push móvil y una alerta externa de TradingView para que una pestaña oculta no sea el único canal"],
      ["Se alejó del escritorio","Active las notificaciones push móviles de Tradovate"],
      ["Un punto para muchos instrumentos","Dé a los niveles críticos su propia alerta externa con un mensaje etiquetado para saber cuál se disparó"],
      ["Perder el nivel cuesta una ejecución real","Automatice la acción para no depender en absoluto de notar la alerta"],
    ] },
    { type: "heading",text: "Cuando realmente no es su configuración" },
    { type: "paragraph",html: "Casi todos los &ldquo;mi alerta no funcionó&rdquo; resultan ser una señal pasada por alto y no una alerta rota. Pero descarte también los fallos reales. Confirme que la alerta sigue activa y que no era un disparador único que ya se disparó y se borró. Compruebe que el símbolo de la alerta coincide con el contrato que realmente está mirando, ya que una alerta fijada en un contrato vencido o de un mes equivocado no seguirá el precio que tiene delante. Y si dejó la plataforma inactiva el tiempo suficiente para que le cerrara la sesión, un navegador que ya no está conectado no puede emitir ningún tono, otra razón por la que importan el push del teléfono y un canal externo." },
    { type: "paragraph",html: "Si la alerta está activa, en el contrato correcto y en una sesión conectada, y aun así nunca produce un sonido ni un punto rojo cuando el precio claramente cruzó el nivel, vale la pena informar al soporte de Tradovate con los detalles de la alerta y una marca de tiempo. Pero eso es raro. Nueve de cada diez veces, la respuesta es que una señal discreta y de un solo disparo perdió una carrera contra un mercado en movimiento, y la cura son más señales, en más canales, además de automatización para los niveles donde perder el aviso realmente duele." },
  ], fr: [
    { type: "paragraph",html: "Vous avez placé une alerte sur un niveau clé, êtes retourné surveiller l'échelle sur votre autre écran, et le prix a tout simplement traversé le niveau. Rien n'a sonné. Ou quelque chose a sonné, une seule fois, et quand vous avez jeté un œil, le mouvement était terminé. Voici le plus frustrant : l'alerte n'a pas échoué. Elle s'est déclenchée exactement quand elle le devait. Vous ne l'avez simplement pas remarquée." },
    { type: "paragraph",html: "Le déclencheur natif de Tradovate est volontairement discret. Lorsqu'une alerte est atteinte, le navigateur joue un bref son et un petit point rouge apparaît sur l'icône de cloche d'Alerts, en haut à gauche de votre espace de travail. C'est tout. Aucun onglet clignotant, aucun changement de couleur sur le graphique, aucun second rappel si vous manquez le premier. Dans une pièce calme, avec l'onglet au premier plan, cela suffit. Au milieu d'une séance rapide, volume baissé et trois instruments ouverts, c'est pratiquement invisible." },
    { type: "paragraph",html: "La solution n'est pas un réglage unique. C'est la superposition. Activez tous les signaux natifs que Tradovate vous offre, ajoutez un push sur votre téléphone et gardez un canal de secours externe en fonctionnement, afin qu'un simple carillon discret ne soit jamais la seule chose entre vous et le trade que vous attendiez." },
    { type: "heading",text: "À quoi ressemble concrètement « facile à manquer »" },
    { type: "paragraph",html: "Avant de modifier quoi que ce soit, il est utile de reconnaître le schéma, car ce sont presque toujours les mêmes quelques situations :" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Votre volume est bas ou coupé.</strong> Le son de l'alerte est bref et peu fort. Si le volume de votre système est baissé pour un appel ou de la musique, le carillon ne s'enregistre jamais.",
        "<strong class='text-white'>L'onglet est en arrière-plan.</strong> Vous êtes sur TradingView, un tableur ou un autre onglet du navigateur. Le point rouge de Tradovate se trouve sur un onglet que vous ne voyez pas, et le son d'un onglet en arrière-plan est facile à ignorer.",
        "<strong class='text-white'>Vous regardez un autre module.</strong> Les yeux sur le SuperDOM ou sur un graphique d'un second écran, l'icône de cloche reste tranquille dans le coin où vous ne regardez pas.",
        "<strong class='text-white'>Plusieurs instruments sont ouverts.</strong> Un point sur une cloche partagée ne vous dit pas <em>quelle</em> alerte s'est déclenchée ; même lorsque vous la remarquez, vous perdez des secondes à comprendre ce qui s'est passé.",
        "<strong class='text-white'>Vous vous êtes éloigné.</strong> Un café, un appel. Une alerte réservée au navigateur n'a aucune portée dès que vous quittez le bureau.",
      ],
    },
    { type: "paragraph",html: "Si l'une de ces situations décrit votre configuration, que l'alerte fonctionne correctement et que vous la manquiez sont parfaitement compatibles. C'est tout le problème que ce guide résout." },
    { type: "heading",text: "Pourquoi l'alerte native est si discrète" },
    { type: "paragraph",html: "La conception des alertes de Tradovate est volontairement minimale. Une alerte déclenchée produit deux choses : un carillon audible via votre navigateur et un badge rouge sur la cloche d'Alerts. Les deux sont ponctuels. Le son est joué une fois, puis s'arrête. Le point reste jusqu'à ce que vous ouvriez le panneau Alerts, mais il ne pulse pas, ne grossit pas et ne bouge pas pour attirer votre regard. Aucun comportement par défaut ne fait clignoter l'onglet de l'instrument ni ne redessine le marqueur d'alerte du graphique pour crier &ldquo;regardez ici&rdquo;." },
    { type: "paragraph",html: "C'est un réglage par défaut raisonnable pour quelqu'un qui a un seul graphique, l'onglet au premier plan et un casque sur les oreilles. C'est un mauvais réglage par défaut pour un trader actif qui jongle entre plusieurs symboles et d'autres applications. Le signal existe ; c'est simplement que son intensité ne correspond pas à ce qu'un niveau manqué peut vous coûter. Votre travail consiste donc à augmenter vous-même l'intensité, sur tous les canaux disponibles." },
    { type: "heading",text: "Solution 1 : activez tous les signaux lors de la création de l'alerte" },
    { type: "paragraph",html: "Commencez à la source. Lorsque vous créez une alerte, Tradovate vous laisse choisir le type de notification, et la plupart des gens acceptent ce qui est coché par défaut et passent à autre chose. Ne le faites pas. Activez à la fois le son et la popup afin que le même déclencheur lance deux signaux à la fois." },
    { type: "paragraph",html: "Pour créer l'alerte, cliquez sur l'icône de cloche d'Alerts en haut à gauche de l'espace de travail pour ouvrir le menu New Alert, ou faites un clic droit sur un niveau de prix directement sur un graphique ou sur l'échelle DOM et choisissez l'option d'ajout d'alerte. Définissez votre condition (Price Crosses, Price Touches et similaires), saisissez le prix exact et, avant de confirmer, assurez-vous que les options de notification incluent <strong class='text-white'>Sound</strong> et <strong class='text-white'>Popup</strong>, et pas seulement l'une des deux." },
    { type: "paragraph",html: "Pendant que vous y êtes, décidez si l'alerte doit être unique ou récurrente. Une alerte unique qui se déclenche et s'efface discrètement est facile à manquer <em>et</em> disparue pour de bon ; pour un niveau qui compte vraiment, un déclencheur récurrent ou persistant vous offre une seconde chance si vous cillez la première fois. N'empilez simplement pas tant d'alertes récurrentes qu'elles se fondent dans le bruit de fond. Si vous définissez une série de niveaux, gardez-les pertinents." },
    { type: "heading",text: "Solution 2 : faites réellement apparaître la popup" },
    { type: "paragraph",html: "Cocher la case Popup ne fait rien à elle seule si votre navigateur ou l'application de bureau n'a jamais reçu l'autorisation d'afficher des notifications. La première fois qu'une application veut déclencher une popup système, le navigateur pose la question une seule fois. Si vous cliquez ailleurs ou sur bloquer, chaque popup suivante est supprimée en silence. Vous jurerez avoir activé les popups, et techniquement c'est vrai, mais le système d'exploitation les jette à la corbeille." },
    { type: "paragraph",html: "Ouvrez les paramètres du site de votre navigateur pour l'application web Tradovate (ou les paramètres de notification de votre système d'exploitation pour l'application de bureau) et confirmez que les notifications sont sur <strong class='text-white'>Allow</strong>. Sous Windows, vérifiez aussi que l'Assistant de concentration ou Ne pas déranger ne retient pas discrètement les bannières. Sur un Mac, vérifiez les paramètres de notification de votre navigateur dans Réglages Système. Une fois l'autorisation accordée, cette bannière popup devient l'un de vos signaux les plus forts et les plus difficiles à ignorer, car elle apparaît par-dessus ce que vous faites." },
    { type: "heading",text: "Solution 3 : placez une alerte sur votre téléphone" },
    { type: "paragraph",html: "Le navigateur ne peut vous joindre qu'au bureau. Une notification push vous suit jusqu'à la cuisine. Installez l'application mobile Tradovate, connectez-vous avec le même compte et autorisez les notifications push lorsque vous y êtes invité. Désormais, une alerte de prix déclenchée peut faire vibrer votre poche, un canal sensoriel complètement différent d'un carillon que vous n'entendrez peut-être pas." },
    { type: "paragraph",html: "Le push est aussi votre filet de sécurité pour les situations qu'un navigateur ne peut pas couvrir : vous avez fermé le capot de l'ordinateur portable, la machine s'est mise en veille, votre connexion internet a sauté un instant. Un téléphone avec sa propre connexion et sa propre vibration est une redondance qui ne coûte rien à mettre en place." },
    { type: "heading",text: "Solution 4 : gardez un canal de secours externe" },
    { type: "paragraph",html: "Superposer les signaux natifs vous mène déjà loin. Mais la configuration la plus solide traite l'alerte de Tradovate comme un signal parmi d'autres et fait passer la <em>même</em> condition par un canal que vous contrôlez. Ainsi, un niveau qui compte pour vous peut vous prévenir plus fort, sur l'appareil de votre choix, ou même agir à votre place sur le signal au lieu de simplement vous notifier. Deux approches courantes :" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Reproduisez la condition dans TradingView.</strong> Si vous utilisez déjà TradingView pour vos graphiques, définissez-y la même alerte de prix ou d'indicateur. Le système d'alertes de TradingView est sonore, configurable et peut envoyer des notifications à sa propre application mobile, par e-mail et par popups, indépendamment de Tradovate. Si un canal est silencieux, l'autre vous atteint quand même.",
        "<strong class='text-white'>Transformez l'alerte en action.</strong> La vraie raison pour laquelle la plupart des niveaux comptent, c'est que vous comptez <em>faire</em> quelque chose lorsque le prix y arrive. Au lieu de dépendre d'une notification que vous pourriez manquer, faites passer une alerte TradingView par un pont d'automatisation afin que le signal passe l'ordre à votre place. Un carillon manqué cesse de vous coûter une exécution, car l'exécution ne dépend plus du fait que vous l'entendiez.",
      ],
    },
    { type: "heading",text: "Gains rapides, selon la raison pour laquelle vous l'avez manquée" },
    { type: "paragraph",html: "Si vous voulez la version courte, trouvez la raison pour laquelle votre alerte vous a échappé et appliquez la solution correspondante :" },
    { type: "table", headers: ["Pourquoi elle était facile à manquer","Ce qu'il faut changer"], rows: [
      ["Le volume du système ou du navigateur était bas","Augmentez le volume du système d'exploitation et du navigateur ; choisissez un son de notification que vous remarquerez réellement"],
      ["Un son seulement, pas de popup","Activez Sound et Popup sur l'alerte et accordez l'autorisation de notification du navigateur"],
      ["L'onglet Tradovate était en arrière-plan","Ajoutez un push mobile et une alerte TradingView externe pour qu'un onglet masqué ne soit pas le seul canal"],
      ["Vous vous êtes éloigné du bureau","Activez les notifications push mobiles de Tradovate"],
      ["Un seul point pour de nombreux instruments","Donnez aux niveaux critiques leur propre alerte externe avec un message étiqueté pour savoir laquelle s'est déclenchée"],
      ["Manquer le niveau coûte une exécution réelle","Automatisez l'action pour ne plus dépendre du fait de remarquer l'alerte"],
    ] },
    { type: "heading",text: "Quand ce n'est vraiment pas votre configuration" },
    { type: "paragraph",html: "Presque tous les &ldquo;mon alerte n'a pas fonctionné&rdquo; se révèlent être un signal manqué plutôt qu'une alerte défaillante. Mais écartez aussi les vraies pannes. Confirmez que l'alerte est toujours active et n'était pas un déclencheur unique déjà déclenché puis effacé. Vérifiez que le symbole de l'alerte correspond au contrat que vous regardez réellement, car une alerte posée sur un contrat expiré ou du mauvais mois ne suivra pas le prix que vous fixez. Et si vous avez laissé la plateforme inactive assez longtemps pour être déconnecté, un navigateur qui n'est plus connecté ne peut émettre aucun carillon, ce qui est une raison de plus pour laquelle le push sur téléphone et un canal externe comptent." },
    { type: "paragraph",html: "Si l'alerte est active, sur le bon contrat, sur une session connectée, et ne produit toujours ni son ni point rouge alors que le prix a clairement franchi le niveau, cela vaut la peine d'être signalé au support Tradovate avec les détails de l'alerte et un horodatage. C'est toutefois rare. Neuf fois sur dix, la réponse est qu'un signal discret et ponctuel a perdu la course face à un marché en mouvement, et le remède consiste en davantage de signaux, sur davantage de canaux, plus l'automatisation pour les niveaux où un oubli fait réellement mal." },
  ], it: [
    { type: "paragraph",html: "Ha impostato un alert su un livello chiave, è tornato a guardare la ladder sull'altro monitor e il prezzo l'ha attraversato senza fermarsi. Nulla ha suonato. Oppure qualcosa ha suonato, una volta sola, e quando ha dato un'occhiata il movimento era già finito. Ecco la parte frustrante: l'alert non ha fallito. È scattato esattamente quando doveva. Semplicemente Lei non se n'è accorto." },
    { type: "paragraph",html: "Il trigger nativo di Tradovate è volutamente sobrio. Quando un alert scatta, il browser riproduce un breve suono e un piccolo punto rosso compare sull'icona a campana di Alerts in alto a sinistra nel Suo workspace. Tutto qui. Nessuna scheda lampeggiante, nessun cambio di colore sul grafico, nessun secondo promemoria se perde il primo. In una stanza silenziosa con la scheda in primo piano, basta. Nel pieno di una sessione veloce, con il volume basso e tre strumenti aperti, è praticamente invisibile." },
    { type: "paragraph",html: "La soluzione non è un'unica impostazione. È la stratificazione. Attivi ogni segnale nativo che Tradovate Le offre, aggiunga una notifica push sul telefono e mantenga attivo un canale di backup esterno, in modo che un singolo debole suono non sia mai l'unica cosa tra Lei e il trade che stava aspettando." },
    { type: "heading",text: "Come appare in realtà “facile da non notare”" },
    { type: "paragraph",html: "Prima di cambiare qualsiasi cosa, è utile riconoscere lo schema, perché quasi sempre si tratta delle stesse poche situazioni:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Il volume è basso o disattivato.</strong> Il suono dell'alert è breve e non forte. Se il volume del sistema è abbassato per una chiamata o per la musica, il segnale non si registra mai.",
        "<strong class='text-white'>La scheda è in background.</strong> È su TradingView, su un foglio di calcolo o su un'altra scheda del browser. Il punto rosso di Tradovate si trova su una scheda che non vede, e il suono di una scheda in background è facile da ignorare.",
        "<strong class='text-white'>Sta guardando un altro modulo.</strong> Con gli occhi sul SuperDOM o su un grafico su un secondo schermo, l'icona a campana resta silenziosa nell'angolo in cui non sta guardando.",
        "<strong class='text-white'>Sono aperti più strumenti.</strong> Un punto su un'unica campana condivisa non Le dice <em>quale</em> alert è scattato, quindi anche quando se ne accorge perde secondi per capire cosa è successo.",
        "<strong class='text-white'>Si è allontanato.</strong> Un caffè, una telefonata. Un alert solo da browser non ha alcuna portata una volta che lascia la scrivania.",
      ],
    },
    { type: "paragraph",html: "Se una di queste situazioni descrive la Sua configurazione, il fatto che l'alert funzioni correttamente e che Lei lo perda sono perfettamente compatibili. È proprio il problema che questa guida risolve." },
    { type: "heading",text: "Perché l'alert nativo è così discreto" },
    { type: "paragraph",html: "Il design degli alert di Tradovate è minimale di proposito. Un alert attivato produce due cose: un segnale udibile attraverso il browser e un badge rosso sulla campana di Alerts. Entrambi sono singoli. Il suono viene riprodotto una volta e si ferma. Il punto resta finché non apre il pannello Alerts, ma non pulsa, non cresce né si muove per catturare il Suo sguardo. Non c'è alcun comportamento predefinito che faccia lampeggiare la scheda dello strumento o ridisegni il marcatore dell'alert sul grafico per gridare &ldquo;guardi qui&rdquo;." },
    { type: "paragraph",html: "È un'impostazione predefinita ragionevole per chi ha un solo grafico, la scheda in primo piano e le cuffie. È un'impostazione scadente per un trader attivo che jongla tra più simboli e altre app. Il segnale esiste; è solo che la sua intensità non è proporzionata a quanto può costarLe un livello mancato. Il compito è quindi alzare l'intensità da sé, su ogni canale disponibile." },
    { type: "heading",text: "Soluzione 1: attivi ogni segnale quando crea l'alert" },
    { type: "paragraph",html: "Parta dall'origine. Quando crea un alert, Tradovate Le permette di scegliere il tipo di notifica, e la maggior parte delle persone accetta ciò che è spuntato di default e va avanti. Non lo faccia. Attivi sia il suono sia il popup, in modo che lo stesso trigger lanci due segnali contemporaneamente." },
    { type: "paragraph",html: "Per creare l'alert, faccia clic sull'icona a campana di Alerts in alto a sinistra nel workspace per aprire il menu New Alert, oppure faccia clic con il pulsante destro su un livello di prezzo direttamente su un grafico o sulla ladder del DOM e scelga l'opzione per aggiungere un alert. Imposti la Sua condizione (Price Crosses, Price Touches e simili), inserisca il prezzo esatto e, prima di confermare, si assicuri che le opzioni di notifica includano <strong class='text-white'>Sound</strong> e <strong class='text-white'>Popup</strong> e non soltanto una delle due." },
    { type: "paragraph",html: "Già che c'è, decida se l'alert debba essere singolo o ricorrente. Un alert singolo che scatta e si cancella in silenzio è facile da non notare <em>ed</em> è sparito per sempre, quindi per un livello a cui tiene davvero, un trigger ricorrente o persistente Le dà una seconda possibilità se batte le palpebre la prima volta. Solo, non accumuli così tanti alert ricorrenti da farli confondere con il rumore di fondo. Se imposta una serie di livelli, li mantenga significativi." },
    { type: "heading",text: "Soluzione 2: faccia comparire davvero il popup" },
    { type: "paragraph",html: "Spuntare la casella Popup non fa nulla da sola se al browser o all'app desktop non è mai stata concessa l'autorizzazione a mostrare le notifiche. La prima volta che un'app vuole far comparire un popup di sistema, il browser lo chiede una sola volta. Se clicca altrove o preme blocca, ogni popup successivo viene soppresso in silenzio. Giurerà di aver abilitato i popup, e tecnicamente l'ha fatto, ma il sistema operativo li getta nel cestino." },
    { type: "paragraph",html: "Apra le impostazioni del sito del browser per l'app web di Tradovate (o le impostazioni delle notifiche del sistema operativo per l'app desktop) e confermi che le notifiche siano su <strong class='text-white'>Allow</strong>. Su Windows, verifichi anche che Assistente alla concentrazione o Non disturbare non stia trattenendo silenziosamente i banner. Su un Mac, controlli le impostazioni delle notifiche del browser in Impostazioni di Sistema. Una volta concessa l'autorizzazione, quel banner popup diventa uno dei Suoi segnali più forti e difficili da ignorare, perché compare sopra qualunque cosa stia facendo." },
    { type: "heading",text: "Soluzione 3: metta un alert sul Suo telefono" },
    { type: "paragraph",html: "Il browser può raggiungerLa solo alla scrivania. Una notifica push La segue fino in cucina. Installi l'app mobile di Tradovate, acceda con lo stesso account e consenta le notifiche push quando richiesto. Ora un alert di prezzo attivato può far vibrare la Sua tasca, un canale sensoriale completamente diverso da un suono che potrebbe non sentire." },
    { type: "paragraph",html: "Il push è anche la Sua rete di sicurezza per le situazioni che un browser non può coprire: ha chiuso il coperchio del portatile, la macchina è andata in sospensione, la Sua connessione internet è caduta per un momento. Un telefono con la propria connessione e la propria vibrazione è una ridondanza che non costa nulla configurare." },
    { type: "heading",text: "Soluzione 4: mantenga un canale di backup esterno" },
    { type: "paragraph",html: "Stratificare i segnali nativi La porta a buon punto. Ma la configurazione più solida tratta l'alert di Tradovate come un segnale tra tanti e instrada la <em>stessa</em> condizione attraverso un canale che controlla Lei. In questo modo un livello a cui tiene può avvisarLa più forte, su un dispositivo di Sua scelta, o persino agire sul segnale al Suo posto invece di limitarsi a un ping. Due approcci comuni:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Rispecchi la condizione in TradingView.</strong> Se già usa TradingView per i grafici, imposti lì lo stesso alert di prezzo o di indicatore. Il sistema di alert di TradingView è rumoroso, configurabile e può inviare notifiche alla propria app mobile, via e-mail e tramite popup, indipendentemente da Tradovate. Se un canale è silenzioso, l'altro La raggiunge comunque.",
        "<strong class='text-white'>Trasformi l'alert in un'azione.</strong> Il vero motivo per cui la maggior parte dei livelli conta è che intende <em>fare</em> qualcosa quando il prezzo ci arriva. Invece di affidarsi a una notifica che potrebbe perdere, instradi un alert di TradingView attraverso un ponte di automazione in modo che il segnale invii l'ordine al Suo posto. Un segnale acustico mancato smette di costarLe un'esecuzione perché l'esecuzione non dipende più dal fatto che Lei lo senta.",
      ],
    },
    { type: "heading",text: "Rimedi rapidi, abbinati al motivo per cui non l'ha notato" },
    { type: "paragraph",html: "Se vuole la versione breve, individui il motivo per cui il Suo alert Le è sfuggito e applichi la soluzione corrispondente:" },
    { type: "table", headers: ["Perché era facile non notarlo","Cosa cambiare"], rows: [
      ["Il volume del sistema o del browser era basso","Alzi il volume del sistema operativo e del browser; scelga un suono di notifica che noterà davvero"],
      ["Solo suono, nessun popup","Abiliti Sound e Popup sull'alert e conceda l'autorizzazione alle notifiche del browser"],
      ["La scheda di Tradovate era in background","Aggiunga una notifica push su mobile e un alert esterno di TradingView, così una scheda nascosta non sarà l'unico canale"],
      ["Si è allontanato dalla scrivania","Attivi le notifiche push mobile di Tradovate"],
      ["Un solo punto per molti strumenti","Dia ai livelli critici un proprio alert esterno con un messaggio etichettato, così saprà quale è scattato"],
      ["Perdere il livello costa un'esecuzione reale","Automatizzi l'azione, così non dipenderà affatto dal notare l'alert"],
    ] },
    { type: "heading",text: "Quando davvero non dipende dalla Sua configurazione" },
    { type: "paragraph",html: "Quasi ogni &ldquo;il mio alert non ha funzionato&rdquo; si rivela un segnale mancato e non un alert rotto. Ma escluda anche i veri guasti. Confermi che l'alert sia ancora attivo e non fosse un trigger singolo già scattato e cancellato. Verifichi che il simbolo dell'alert corrisponda al contratto che sta effettivamente guardando, poiché un alert impostato su un contratto scaduto o del mese sbagliato non seguirà il prezzo che sta fissando. E se ha lasciato la piattaforma inattiva abbastanza a lungo da essere disconnesso, un browser non più connesso non può emettere alcun suono, un altro motivo per cui contano il push sul telefono e un canale esterno." },
    { type: "paragraph",html: "Se l'alert è attivo, sul contratto giusto, su una sessione connessa e continua a non produrre alcun suono né punto rosso quando il prezzo ha chiaramente attraversato il livello, vale la pena segnalarlo al supporto Tradovate con i dettagli dell'alert e un timestamp. È però raro. Nove volte su dieci, la risposta è che un segnale discreto e singolo ha perso una gara contro un mercato in movimento, e la cura è più segnali, su più canali, più l'automazione per i livelli in cui un'occasione mancata fa davvero male." },
  ] },
  ctaHeading: { en: "Never Depend on Noticing the Chime", de: "Verlassen Sie sich nie darauf, den Signalton zu bemerken", es: "No dependa nunca de oír el tono", fr: "Ne dépendez jamais de l'écoute du carillon", it: "Non dipenda mai dal notare il segnale acustico" },
  ctaText: { en: "PickMyTrade turns your TradingView alerts into real Tradovate orders automatically, so the trade happens the instant your level hits, whether you're watching or not.", de: "PickMyTrade wandelt Ihre TradingView-Alerts automatisch in echte Tradovate-Orders um, sodass der Trade in dem Moment stattfindet, in dem Ihr Level erreicht wird, ob Sie zusehen oder nicht.", es: "PickMyTrade convierte automáticamente sus alertas de TradingView en órdenes reales de Tradovate, de modo que la operación se ejecuta en el instante en que su nivel se toca, esté usted mirando o no.", fr: "PickMyTrade transforme automatiquement vos alertes TradingView en véritables ordres Tradovate, de sorte que le trade se déclenche à l'instant où votre niveau est touché, que vous regardiez ou non.", it: "PickMyTrade trasforma automaticamente i Suoi alert di TradingView in veri ordini Tradovate, così il trade avviene nell'istante in cui il Suo livello viene toccato, che Lei stia guardando o no." },
  ctaButtonText: { en: "Start Your Free 7-Day Trial", de: "Starten Sie Ihre kostenlose 7-Tage-Testphase", es: "Comience su prueba gratuita de 7 días", fr: "Commencez votre essai gratuit de 7 jours", it: "Inizi la prova gratuita di 7 giorni" },
  ctaUrl: "https://app.pickmytrade.trade/?register=true&utm_source=content&utm_medium=debugging",
  faqHeading: { en: "Frequently Asked Questions", de: "Häufig gestellte Fragen", es: "Preguntas frecuentes", fr: "Questions fréquentes", it: "Domande frequenti" },
  faqs: { en: [
    { q: "Why do I keep missing my Tradovate price alerts?", a: "The alert almost certainly fired. Tradovate signals a triggered alert with a short browser sound and a small red dot on the bell-shaped Alerts icon. If your system volume is low, the browser tab is in the background, or you are watching the DOM on another monitor, that quiet cue slips right past you. Layer more cues so a single chime is never the only signal." },
    { q: "Can I make Tradovate alerts louder or change the sound?", a: "You can pick a notification sound from the built-in options and raise your operating system and browser volume so the chime is not swallowed by everything else. There is no built-in volume slider that makes one alert dramatically louder than the rest, so the practical fix is a louder system volume plus a second channel such as a mobile push or an external alert." },
    { q: "Do Tradovate alerts show a desktop popup?", a: "They can, but a desktop popup only appears if you enabled the Popup notification type on the alert and granted notification permission to your browser or the desktop app. If you blocked or ignored that permission prompt, the popup silently does nothing and you are left with just the sound and the red dot." },
    { q: "How do I get Tradovate alerts on my phone?", a: "Install the Tradovate mobile app, sign in with the same account, and allow push notifications. Price alerts and account notifications can then reach your phone as a push, which is far harder to miss than a browser chime when you have stepped away from your desk." },
    { q: "Should I rely only on Tradovate's built-in alerts?", a: "No. Treat the native alert as one layer, not the whole system. Turn on sound and popup, add mobile push, and route the same condition through an external channel so it can notify you louder or act on the signal for you. Redundancy is the whole point when a missed level costs real money." },
  ], de: [
    { q: "Warum verpasse ich ständig meine Tradovate-Preisalarme?", a: "Der Alert wurde mit ziemlicher Sicherheit ausgelöst. Tradovate signalisiert einen ausgelösten Alert mit einem kurzen Browser-Ton und einem kleinen roten Punkt auf dem glockenförmigen Alerts-Symbol. Ist Ihre Systemlautstärke niedrig, befindet sich der Browser-Tab im Hintergrund oder beobachten Sie das DOM auf einem anderen Monitor, geht dieses leise Signal einfach an Ihnen vorbei. Kombinieren Sie mehrere Signale, damit ein einzelner Signalton nie das einzige Signal ist." },
    { q: "Kann ich Tradovate-Alerts lauter machen oder den Ton ändern?", a: "Sie können einen Benachrichtigungston aus den integrierten Optionen wählen und die Lautstärke von Betriebssystem und Browser erhöhen, damit der Signalton nicht von allem anderen verschluckt wird. Es gibt keinen integrierten Lautstärkeregler, der einen Alert deutlich lauter als die übrigen macht. Praktisch hilft daher eine höhere Systemlautstärke plus ein zweiter Kanal wie eine mobile Push-Nachricht oder ein externer Alert." },
    { q: "Zeigen Tradovate-Alerts ein Desktop-Popup an?", a: "Das können sie, doch ein Desktop-Popup erscheint nur, wenn Sie am Alert den Benachrichtigungstyp Popup aktiviert und Ihrem Browser oder der Desktop-App die Benachrichtigungsberechtigung erteilt haben. Haben Sie diese Berechtigungsabfrage blockiert oder ignoriert, passiert beim Popup stillschweigend nichts, und Ihnen bleiben nur der Ton und der rote Punkt." },
    { q: "Wie erhalte ich Tradovate-Alerts auf meinem Smartphone?", a: "Installieren Sie die mobile Tradovate-App, melden Sie sich mit demselben Konto an und erlauben Sie Push-Benachrichtigungen. Preisalarme und Kontobenachrichtigungen erreichen Ihr Smartphone dann als Push-Nachricht, die sehr viel schwerer zu übersehen ist als ein Browser-Signalton, wenn Sie Ihren Schreibtisch verlassen haben." },
    { q: "Sollte ich mich nur auf die integrierten Alerts von Tradovate verlassen?", a: "Nein. Betrachten Sie den nativen Alert als eine Ebene, nicht als das gesamte System. Aktivieren Sie Ton und Popup, fügen Sie mobile Push-Nachrichten hinzu und leiten Sie dieselbe Bedingung über einen externen Kanal, damit er Sie lauter benachrichtigen oder das Signal für Sie ausführen kann. Redundanz ist der ganze Sinn, wenn ein verpasstes Level echtes Geld kostet." },
  ], es: [
    { q: "¿Por qué sigo perdiéndome mis alertas de precio de Tradovate?", a: "Casi con seguridad la alerta se disparó. Tradovate señala una alerta activada con un breve sonido del navegador y un pequeño punto rojo en el icono de campana de Alerts. Si el volumen de su sistema es bajo, la pestaña del navegador está en segundo plano o está mirando el DOM en otro monitor, esa señal discreta pasa desapercibida. Combine más señales para que un único tono nunca sea la única advertencia." },
    { q: "¿Puedo hacer que las alertas de Tradovate suenen más fuerte o cambiar el sonido?", a: "Puede elegir un sonido de notificación entre las opciones integradas y subir el volumen del sistema operativo y del navegador para que el tono no quede ahogado por todo lo demás. No hay un control de volumen integrado que haga que una alerta suene mucho más fuerte que las demás, así que la solución práctica es un volumen de sistema más alto más un segundo canal, como una notificación push móvil o una alerta externa." },
    { q: "¿Las alertas de Tradovate muestran una ventana emergente de escritorio?", a: "Pueden hacerlo, pero la ventana emergente de escritorio solo aparece si activó el tipo de notificación Popup en la alerta y concedió permiso de notificaciones a su navegador o a la aplicación de escritorio. Si bloqueó o ignoró ese aviso de permiso, la ventana emergente no hace nada en silencio y solo le quedan el sonido y el punto rojo." },
    { q: "¿Cómo recibo las alertas de Tradovate en mi teléfono?", a: "Instale la aplicación móvil de Tradovate, inicie sesión con la misma cuenta y permita las notificaciones push. Las alertas de precio y las notificaciones de la cuenta pueden llegarle entonces al teléfono como una notificación push, mucho más difícil de pasar por alto que un tono del navegador cuando se ha alejado del escritorio." },
    { q: "¿Debo depender solo de las alertas integradas de Tradovate?", a: "No. Trate la alerta nativa como una capa, no como todo el sistema. Active sonido y ventana emergente, añada notificaciones push móviles y envíe la misma condición por un canal externo para que pueda avisarle con más fuerza o actuar por usted ante la señal. La redundancia es todo el sentido cuando perder un nivel cuesta dinero real." },
  ], fr: [
    { q: "Pourquoi est-ce que je rate sans cesse mes alertes de prix Tradovate ?", a: "L'alerte s'est presque certainement déclenchée. Tradovate signale une alerte déclenchée par un bref son du navigateur et un petit point rouge sur l'icône de cloche d'Alerts. Si le volume de votre système est bas, si l'onglet du navigateur est en arrière-plan ou si vous regardez le DOM sur un autre écran, ce signal discret vous échappe. Superposez davantage de signaux pour qu'un simple carillon ne soit jamais le seul avertissement." },
    { q: "Puis-je rendre les alertes Tradovate plus fortes ou changer le son ?", a: "Vous pouvez choisir un son de notification parmi les options intégrées et augmenter le volume de votre système d'exploitation et de votre navigateur pour que le carillon ne soit pas noyé par tout le reste. Il n'existe pas de curseur de volume intégré qui rende une alerte nettement plus forte que les autres ; la solution pratique est donc un volume système plus élevé associé à un second canal, comme une notification push mobile ou une alerte externe." },
    { q: "Les alertes Tradovate affichent-elles une popup sur le bureau ?", a: "Elles le peuvent, mais une popup de bureau n'apparaît que si vous avez activé le type de notification Popup sur l'alerte et accordé l'autorisation de notification à votre navigateur ou à l'application de bureau. Si vous avez bloqué ou ignoré cette demande d'autorisation, la popup ne fait rien en silence et il ne vous reste que le son et le point rouge." },
    { q: "Comment recevoir les alertes Tradovate sur mon téléphone ?", a: "Installez l'application mobile Tradovate, connectez-vous avec le même compte et autorisez les notifications push. Les alertes de prix et les notifications de compte peuvent alors vous parvenir sur votre téléphone sous forme de push, bien plus difficile à manquer qu'un carillon de navigateur lorsque vous vous êtes éloigné de votre bureau." },
    { q: "Dois-je me fier uniquement aux alertes intégrées de Tradovate ?", a: "Non. Considérez l'alerte native comme une couche, pas comme tout le système. Activez le son et la popup, ajoutez le push mobile et faites passer la même condition par un canal externe afin qu'il puisse vous prévenir plus fort ou agir à votre place sur le signal. La redondance est tout l'enjeu lorsqu'un niveau manqué coûte de l'argent réel." },
  ], it: [
    { q: "Perché continuo a perdere i miei alert di prezzo Tradovate?", a: "Quasi certamente l'alert è scattato. Tradovate segnala un alert attivato con un breve suono del browser e un piccolo punto rosso sull'icona a campana di Alerts. Se il volume del Suo sistema è basso, la scheda del browser è in background o sta osservando il DOM su un altro monitor, quel segnale discreto Le sfugge. Sovrapponga più segnali, così un singolo suono non sarà mai l'unico avviso." },
    { q: "Posso rendere gli alert di Tradovate più forti o cambiare il suono?", a: "Può scegliere un suono di notifica tra le opzioni integrate e alzare il volume del sistema operativo e del browser, così il segnale non viene sommerso da tutto il resto. Non esiste un cursore del volume integrato che renda un alert molto più forte degli altri, quindi la soluzione pratica è un volume di sistema più alto più un secondo canale, come una notifica push su mobile o un alert esterno." },
    { q: "Gli alert di Tradovate mostrano un popup sul desktop?", a: "Possono farlo, ma un popup sul desktop compare solo se ha abilitato il tipo di notifica Popup sull'alert e concesso l'autorizzazione alle notifiche al browser o all'app desktop. Se ha bloccato o ignorato quella richiesta di autorizzazione, il popup non fa nulla in silenzio e Le restano solo il suono e il punto rosso." },
    { q: "Come ricevo gli alert di Tradovate sul mio telefono?", a: "Installi l'app mobile di Tradovate, acceda con lo stesso account e consenta le notifiche push. Gli alert di prezzo e le notifiche dell'account possono così raggiungere il Suo telefono come push, molto più difficili da non notare rispetto a un suono del browser quando si è allontanato dalla scrivania." },
    { q: "Devo fare affidamento solo sugli alert integrati di Tradovate?", a: "No. Consideri l'alert nativo come un livello, non come l'intero sistema. Attivi suono e popup, aggiunga le notifiche push su mobile e instradi la stessa condizione attraverso un canale esterno, in modo che possa avvisarLa con più forza o agire al Suo posto sul segnale. La ridondanza è tutto il punto quando un livello mancato costa denaro reale." },
  ] },
