---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "chart-empty-gaps-slow-load";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/debugging/${SLUG}`;

const META_TITLE = "Tradovate Charts Load With Empty Gaps on Login";
const META_DESCRIPTION =
  "Tradovate charts loading with empty gaps? Scroll to pull history, raise Minimum Bars to Load, or restart the app to force the missing bars to fill in fast.";

// Short SEO title (<=60 chars) for locales where the shared h1 is too long for a SERP title.
const TITLE_OVERRIDE: Partial<Record<Locale, string>> = { es: "Tradovate: gráficos con huecos vacíos al iniciar sesión", fr: "Tradovate : graphiques avec espaces vides à la connexion" };

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Tradovate-Charts laden beim Anmelden mit leeren Lücken", es: "Los gráficos de Tradovate se cargan con huecos vacíos al iniciar sesión", fr: "Les graphiques Tradovate se chargent avec des espaces vides à la connexion", it: "I grafici Tradovate si caricano con spazi vuoti all'accesso" },
  dek: { en: "You log in, open your ES or NQ chart, and half of it is blank. Here's why Tradovate leaves empty gaps on the chart, and the moves that force the missing bars to load in seconds instead of an hour.", de: "Sie melden sich an, öffnen Ihren ES- oder NQ-Chart, und die Hälfte davon ist leer. Hier erfahren Sie, warum Tradovate leere Lücken im Chart hinterlässt, und mit welchen Handgriffen Sie die fehlenden Kerzen in Sekunden statt einer Stunde laden.", es: "Inicia sesión, abre su gráfico de ES o NQ, y la mitad está en blanco. Aquí le explicamos por qué Tradovate deja huecos vacíos en el gráfico, y las acciones que obligan a las barras faltantes a cargarse en segundos en lugar de una hora.", fr: "Vous vous connectez, ouvrez votre graphique ES ou NQ, et la moitié est vide. Voici pourquoi Tradovate laisse des espaces vides sur le graphique, et les actions qui forcent les barres manquantes à se charger en quelques secondes au lieu d'une heure.", it: "Accede, apre il proprio grafico ES o NQ, e metà è vuota. Ecco perché Tradovate lascia vuoti nel grafico, e le azioni che costringono le barre mancanti a caricarsi in pochi secondi invece che in un'ora." },
  readTime: { en: "6 min read", de: "6 Minuten Lesezeit", es: "Lectura de 6 minutos", fr: "Lecture de 6 minutes", it: "Lettura di 6 minuti" },
  lastUpdated: "2026-07-08",
  heroImage: { src: `${IMG}/chart-empty-gaps-slow-load-1.png`, alt: { en: "Tradovate chart showing an empty gap in the price area where candles have not yet loaded", de: "Tradovate-Chart mit einer leeren Lücke im Preisbereich, in dem Kerzen noch nicht geladen wurden", es: "Gráfico de Tradovate que muestra un hueco vacío en la zona de precios donde las velas aún no se han cargado", fr: "Graphique Tradovate montrant un espace vide dans la zone des prix où les bougies ne se sont pas encore chargées", it: "Grafico Tradovate che mostra un vuoto nell'area dei prezzi dove le candele non sono ancora state caricate" } },
  blocks: { en: [
    { type: "paragraph", html: "You log in to Tradovate, open your ES or NQ chart, and half of it is blank, clean stretches of white where candles should be. It's one of the platform's most common display bugs, and it usually looks worse than it is. Those gaps can sit empty for close to an hour before the bars finally stream in on their own. You don't have to wait that long. Tradovate still loads history <em>on demand</em> rather than all at once, so a few deliberate moves force the missing data to fill in within seconds." },
    { type: "paragraph", html: "The symptom shows up in a few variants: an empty gap in the middle of an otherwise-loaded chart, a chart that's slow or blank for the first minute after login, missing bars when you scroll back in time, or indicators like the 50 EMA and VWAP that visibly jump as older bars finally arrive. They all trace back to the same root cause, bars that weren't requested yet, and they're all fixable from the chart itself." },
    { type: "paragraph", html: "If you automate your entries, this bug matters less than it looks. PickMyTrade routes orders from your TradingView alerts straight to Tradovate, so a chart that's still painting candles never blocks or delays an automated fill. But when you're reading price by hand, an empty gap can hide the exact structure you're trading, so let's clear it." },
    {
      type: "checklist",
      heading: "Quick Checklist for Empty Chart Gaps",
      items: [
        "<strong class='text-white'>Scroll left across the gap</strong>, dragging the chart into the empty range forces Tradovate to request the missing bars.",
        "<strong class='text-white'>Restart or refresh</strong>, close and reopen the desktop app, or refresh the browser tab on Tradovate Web, to reload the full data feed.",
        "<strong class='text-white'>Raise &ldquo;Minimum Bars to Load&rdquo;</strong>, bump the value in the chart's settings so more history preloads the moment the chart opens.",
        "<strong class='text-white'>Save a base template</strong>, new chart tabs reset to a low default bar count, so a saved template keeps your preferred setting.",
        "<strong class='text-white'>Confirm live market data</strong>, a delayed or missing subscription (orange symbol name) paints sparse or empty bars.",
        "<strong class='text-white'>Trim the load</strong>, fewer open tabs and indicators mean the startup data pull finishes faster.",
      ],
    },
    { type: "heading", text: "What Empty Chart Gaps in Tradovate Actually Mean" },
    { type: "paragraph", html: "An empty gap isn't corrupted data or a lost position, it's simply a range of bars Tradovate hasn't fetched yet. The charting engine loads only the candles it needs to fill the visible window, then requests more as you scroll or zoom. When the data server is busy (a login rush at the cash open is the classic trigger), those follow-up requests queue up, and the chart shows blank space until they return." },
    { type: "paragraph", html: "That's why the gap often heals itself if you leave it alone, the request eventually completes, sometimes an hour later. The fixes below just force that request to fire now instead of whenever the queue clears." },
    { type: "paragraph", html: "The related complaint, indicators recalculating and shifting when you scroll back, is the same problem wearing a different hat. Charts draw their indicators from whatever bars are currently loaded, so a moving average calculated on 100 preloaded bars looks different once 2,000 bars arrive. Load enough history up front and the jumping stops." },
    { type: "heading", text: "Top Causes of Tradovate Chart Gaps" },
    { type: "heading", text: "1. History loads on demand, not all at once" },
    { type: "paragraph", html: "Tradovate requests bars for the visible window and fetches more only when you scroll or zoom out. Jump straight to a zoomed-out or far-back view and you'll see empty space until the fetch completes." },
    { type: "heading", text: "2. New chart tabs default to a low minimum bar count" },
    { type: "paragraph", html: "Every fresh chart tab opens with only a small number of bars preloaded. Add an indicator with a long lookback, or scroll back immediately, and you outrun the loaded data, which produces gaps and recalculating indicators." },
    { type: "heading", text: "3. A congested data feed right after login" },
    { type: "paragraph", html: "At the open, everyone's platform is requesting data at once. Charts that load fine mid-session can crawl or stall during that burst, leaving temporary gaps until the feed catches up." },
    { type: "heading", text: "4. Delayed or missing market-data subscription" },
    { type: "paragraph", html: "If your symbol name shows in orange, you're on delayed or no live data. A feed that isn't streaming can't paint current bars, which reads as sparse candles or a stalled right edge." },
    { type: "heading", text: "5. Tick and volume charts hit a history limit" },
    { type: "paragraph", html: "Tick, volume, and range charts pull only a limited window of history by default, roughly two weeks, with an optional add-on entitlement for extended tick data (up to a year). Scroll past that window and the chart simply stops loading. Entitlements and limits change over time, so check what your account currently covers." },
    { type: "heading", text: "How to Fix Empty Chart Gaps: Step-by-Step" },
    { type: "heading", text: "Fix 1: Scroll across the gap to pull the missing bars" },
    { type: "paragraph", html: "Click and drag the chart to the left, moving your view into the empty range. This is the fastest fix, and it works because Tradovate's loading is built exactly this way, dragging into unloaded territory triggers a fresh request for those bars, and they fill in within a second or two on a healthy feed." },
    { type: "image", src: `${IMG}/chart-empty-gaps-slow-load-2.png`, alt: "Tradovate chart with previously empty bars filling in after scrolling left through history" },
    { type: "heading", text: "Fix 2: Restart or refresh to reload the whole feed" },
    { type: "paragraph", html: "If scrolling doesn't clear it, reload the data connection:" },
    {
      type: "steps",
      items: [
        { title: "Tradovate Web", html: "Refresh the browser tab (F5 / Ctrl+R) to reconnect and re-request the chart data." },
        { title: "Desktop app", html: "Close and reopen the application, then sign back in." },
        { title: "Mobile", html: "Force-close and relaunch the app." },
      ],
    },
    { type: "paragraph", html: "There's no dedicated one-click &ldquo;refresh chart only&rdquo; button. The reliable way to force a full reload is a restart or browser refresh, which re-establishes the data feed from scratch." },
    { type: "heading", text: "Fix 3: Raise the &ldquo;Minimum Bars to Load&rdquo; setting" },
    { type: "paragraph", html: "Preload more history so gaps never appear on open in the first place:" },
    {
      type: "steps",
      items: [
        { title: "Open the chart settings", html: "Open the chart's settings (the chart editor / settings panel)." },
        { title: "Find Minimum Bars to Load", html: "Find the <strong class='text-white'>Minimum Bars to Load</strong> field. Some builds label it &ldquo;Minimum Number of Bars to Load,&rdquo; but it's the same setting." },
        { title: "Raise the value", html: "Raise it well above the default. The field accepts several thousand bars, so set it high enough to cover your longest indicator lookback plus room to scroll." },
      ],
    },
    { type: "image", src: `${IMG}/chart-empty-gaps-slow-load-3.png`, alt: "Tradovate chart editor panel with the Minimum Bars to Load field set to a higher value" },
    { type: "heading", text: "Fix 4: Save a base chart template so new tabs keep the setting" },
    { type: "paragraph", html: "New chart tabs reset to the low default minimum, which undoes Fix 3 every time you open a chart. Lock it in with a template:" },
    {
      type: "steps",
      items: [
        { title: "Configure your preferred chart", html: "Configure one chart with your preferred <strong class='text-white'>Minimum Bars to Load</strong>, interval, and layout." },
        { title: "Save it as a template", html: "Save it as a template (for example, &ldquo;base 2000 bars&rdquo;)." },
        { title: "Apply it to new charts first", html: "Apply that template when you open new charts, <em>then</em> add your indicators." },
      ],
    },
    { type: "image", src: `${IMG}/chart-empty-gaps-slow-load-4.png`, alt: "Tradovate save-as-template dialog naming a chart preset with a higher bar count" },
    { type: "heading", text: "Fix 5: Confirm your market-data subscription is live" },
    { type: "paragraph", html: "If the symbol name is orange or bars look stale, your feed is delayed or off. Enable or subscribe to real-time market data (data entitlements vary by account type and prop firm, so check your firm's current rules), then sign out and back in so the live feed attaches. For the full walkthrough, see our guide on <a href='https://pickmytrade.trade/debugging/ten-minute-delayed-data-orange-symbols/'>Tradovate 10-Minute Delayed Data &amp; Orange Symbols</a>." },
    { type: "heading", text: "Troubleshooting Table" },
    {
      type: "table",
      headers: ["Symptom", "Meaning", "Fix"],
      rows: [
        ["Empty gap in the middle of the chart", "Bars in that range weren't requested yet", "Scroll left across the gap to trigger a fetch"],
        ["Chart slow or blank right after login", "Data feed still catching up on the startup burst", "Wait a beat, then refresh (web) or restart (desktop)"],
        ["Bars won't load when scrolling far back", "Zoomed past the preloaded / tick-history window", "Raise Minimum Bars to Load; check tick-data add-on"],
        ["Indicators (EMA/VWAP) jump as you scroll", "Not enough history was preloaded to calculate them", "Raise Minimum Bars to Load and save as a template"],
        ["New tab loads far fewer bars than expected", "Tabs reset to the low default minimum", "Apply your saved base template before adding indicators"],
        ["Orange symbol name, sparse or stalled bars", "Delayed or missing real-time market data", "Subscribe to / enable live data, then re-login"],
      ],
    },
    { type: "heading", text: "Where PickMyTrade Fits" },
    { type: "paragraph", html: "Empty chart gaps are a display problem, but they become a <em>trading</em> problem when a stalled chart hides your entry or you second-guess a fill you can't see plotted. PickMyTrade takes the chart out of the critical path for execution:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Alert-driven execution</strong>, orders fire from your TradingView alerts, not from Tradovate's chart render, so a lagging or gappy chart never delays a fill.",
        "<strong class='text-white'>Qty / symbol validation</strong>, every order is checked against the active contract and your size caps before it's sent, so a mis-read chart doesn't turn into a bad order.",
        "<strong class='text-white'>Rate-limit-safe routing</strong>, order flow is spaced out so nothing bounces during the same login-rush congestion that stalls your charts.",
        "<strong class='text-white'>Multi-account sync</strong>, the correct order mirrors across every linked account at once, with no manual re-entry while you wait for candles to paint.",
      ],
    },
  ], de: [
    { type: "paragraph", html: "Sie melden sich bei Tradovate an, öffnen Ihren ES- oder NQ-Chart, und die Hälfte davon ist leer, saubere weiße Flächen, wo eigentlich Kerzen sein sollten. Das ist einer der häufigsten Darstellungsfehler der Plattform und sieht meist schlimmer aus, als es ist. Diese Lücken können fast eine Stunde lang leer bleiben, bevor die Kerzen von selbst nachladen. So lange müssen Sie nicht warten. Tradovate lädt Historie weiterhin <em>bei Bedarf</em> statt auf einmal, daher zwingen ein paar gezielte Schritte die fehlenden Daten dazu, innerhalb von Sekunden nachzuladen." },
    { type: "paragraph", html: "Das Symptom zeigt sich in mehreren Varianten: eine leere Lücke mitten in einem ansonsten geladenen Chart, ein Chart, das in der ersten Minute nach dem Login langsam oder leer ist, fehlende Kerzen beim Zurückscrollen in der Zeit, oder Indikatoren wie der 50 EMA und VWAP, die sichtbar springen, sobald ältere Kerzen endlich eintreffen. Sie alle haben dieselbe Ursache, Kerzen, die noch nicht angefordert wurden, und sie lassen sich alle direkt im Chart beheben." },
    { type: "paragraph", html: "Wenn Sie Ihre Einstiege automatisieren, spielt dieser Fehler eine geringere Rolle, als es scheint. PickMyTrade leitet Orders direkt von Ihren TradingView-Alerts an Tradovate weiter, sodass ein Chart, der noch Kerzen zeichnet, eine automatisierte Ausführung nie blockiert oder verzögert. Wenn Sie den Preis jedoch manuell ablesen, kann eine leere Lücke genau die Struktur verbergen, die Sie handeln, also klären wir das." },
    {
      type: "checklist",
      heading: "Kurz-Checkliste für leere Chart-Lücken",
      items: [
        "<strong class='text-white'>Über die Lücke scrollen</strong>, das Ziehen des Charts in den leeren Bereich zwingt Tradovate, die fehlenden Kerzen anzufordern.",
        "<strong class='text-white'>Neu starten oder aktualisieren</strong>, schließen und öffnen Sie die Desktop-App erneut oder aktualisieren Sie den Browser-Tab bei Tradovate Web, um den gesamten Datenfeed neu zu laden.",
        "<strong class='text-white'>&ldquo;Minimum Bars to Load&rdquo; erhöhen</strong>, erhöhen Sie den Wert in den Chart-Einstellungen, damit mehr Historie sofort beim Öffnen des Charts vorgeladen wird.",
        "<strong class='text-white'>Basis-Vorlage speichern</strong>, neue Chart-Tabs setzen auf eine niedrige Standard-Kerzenzahl zurück, eine gespeicherte Vorlage behält daher Ihre bevorzugte Einstellung bei.",
        "<strong class='text-white'>Live-Marktdaten bestätigen</strong>, ein verzögertes oder fehlendes Abonnement (orangefarbener Symbolname) zeichnet spärliche oder leere Kerzen.",
        "<strong class='text-white'>Last reduzieren</strong>, weniger offene Tabs und Indikatoren bedeuten, dass der Datenabruf beim Start schneller abgeschlossen ist.",
      ],
    },
    { type: "heading", text: "Was leere Chart-Lücken bei Tradovate wirklich bedeuten" },
    { type: "paragraph", html: "Eine leere Lücke bedeutet nicht, dass Daten beschädigt sind oder eine Position verloren ging, es ist schlicht ein Bereich von Kerzen, den Tradovate noch nicht abgerufen hat. Die Chart-Engine lädt nur die Kerzen, die zum Füllen des sichtbaren Fensters nötig sind, und fordert beim Scrollen oder Zoomen weitere an. Wenn der Datenserver ausgelastet ist (ein Login-Ansturm zur Handelseröffnung ist der klassische Auslöser), stauen sich diese Folgeanfragen, und der Chart zeigt leeren Raum, bis sie beantwortet werden." },
    { type: "paragraph", html: "Deshalb heilt sich die Lücke oft von selbst, wenn Sie sie in Ruhe lassen, die Anfrage wird irgendwann abgeschlossen, manchmal erst nach einer Stunde. Die folgenden Lösungen zwingen diese Anfrage lediglich dazu, sofort auszulösen, statt zu warten, bis die Warteschlange sich leert." },
    { type: "paragraph", html: "Die verwandte Beschwerde, dass Indikatoren beim Zurückscrollen neu berechnet werden und sich verschieben, ist dasselbe Problem in anderem Gewand. Charts berechnen ihre Indikatoren aus den aktuell geladenen Kerzen, sodass ein gleitender Durchschnitt, der auf 100 vorgeladenen Kerzen berechnet wurde, anders aussieht, sobald 2.000 Kerzen eintreffen. Laden Sie ausreichend Historie im Voraus, hört das Springen auf." },
    { type: "heading", text: "Hauptursachen für Chart-Lücken bei Tradovate" },
    { type: "heading", text: "1. Historie lädt bei Bedarf, nicht auf einmal" },
    { type: "paragraph", html: "Tradovate fordert Kerzen für das sichtbare Fenster an und lädt erst mehr nach, wenn Sie scrollen oder herauszoomen. Springen Sie direkt zu einer herausgezoomten oder weit zurückliegenden Ansicht, sehen Sie leeren Raum, bis der Abruf abgeschlossen ist." },
    { type: "heading", text: "2. Neue Chart-Tabs starten standardmäßig mit einer niedrigen Mindest-Kerzenzahl" },
    { type: "paragraph", html: "Jeder neue Chart-Tab öffnet mit nur einer kleinen Anzahl vorgeladener Kerzen. Fügen Sie einen Indikator mit langem Rückblickzeitraum hinzu oder scrollen Sie sofort zurück, überholen Sie die geladenen Daten, was zu Lücken und neu berechnenden Indikatoren führt." },
    { type: "heading", text: "3. Ein überlasteter Datenfeed direkt nach dem Login" },
    { type: "paragraph", html: "Zur Handelseröffnung fordern alle Plattformen gleichzeitig Daten an. Charts, die mitten in der Sitzung problemlos laden, können während dieses Ansturms stocken oder hängen bleiben, was vorübergehende Lücken hinterlässt, bis der Feed aufholt." },
    { type: "heading", text: "4. Verzögertes oder fehlendes Marktdaten-Abonnement" },
    { type: "paragraph", html: "Wird Ihr Symbolname orange angezeigt, haben Sie verzögerte oder keine Live-Daten. Ein Feed, der nicht streamt, kann keine aktuellen Kerzen zeichnen, was sich als spärliche Kerzen oder eine stockende rechte Kante zeigt." },
    { type: "heading", text: "5. Tick- und Volumen-Charts stoßen an ein Historie-Limit" },
    { type: "paragraph", html: "Tick-, Volumen- und Range-Charts rufen standardmäßig nur ein begrenztes Historie-Fenster ab, etwa zwei Wochen, mit einer optionalen Zusatzberechtigung für erweiterte Tick-Daten (bis zu einem Jahr). Scrollen Sie über dieses Fenster hinaus, stoppt der Chart einfach das Laden. Berechtigungen und Limits ändern sich mit der Zeit, prüfen Sie also, was Ihr Konto aktuell abdeckt." },
    { type: "heading", text: "So beheben Sie leere Chart-Lücken: Schritt für Schritt" },
    { type: "heading", text: "Lösung 1: Über die Lücke scrollen, um die fehlenden Kerzen zu laden" },
    { type: "paragraph", html: "Klicken und ziehen Sie den Chart nach links, um Ihre Ansicht in den leeren Bereich zu bewegen. Das ist die schnellste Lösung, und sie funktioniert, weil Tradovates Ladeverhalten genau so aufgebaut ist, das Ziehen in ungeladenes Gebiet löst eine neue Anfrage für diese Kerzen aus, und sie laden bei einem stabilen Feed innerhalb von ein bis zwei Sekunden nach." },
    { type: "image", src: `${IMG}/chart-empty-gaps-slow-load-2.png`, alt: "Tradovate-Chart, bei dem zuvor leere Kerzen nach dem Zurückscrollen in der Historie nachladen" },
    { type: "heading", text: "Lösung 2: Neu starten oder aktualisieren, um den gesamten Feed neu zu laden" },
    { type: "paragraph", html: "Falls Scrollen die Lücke nicht beseitigt, laden Sie die Datenverbindung neu:" },
    {
      type: "steps",
      items: [
        { title: "Tradovate Web", html: "Aktualisieren Sie den Browser-Tab (F5 / Strg+R), um die Verbindung neu herzustellen und die Chart-Daten erneut anzufordern." },
        { title: "Desktop-App", html: "Schließen und öffnen Sie die Anwendung erneut und melden Sie sich wieder an." },
        { title: "Mobil", html: "Erzwingen Sie das Schließen und starten Sie die App neu." },
      ],
    },
    { type: "paragraph", html: "Es gibt keine eigene Ein-Klick-Schaltfläche &ldquo;nur Chart aktualisieren&rdquo;. Der zuverlässige Weg, ein vollständiges Neuladen zu erzwingen, ist ein Neustart oder Browser-Refresh, der den Datenfeed von Grund auf neu aufbaut." },
    { type: "heading", text: "Lösung 3: Die Einstellung &ldquo;Minimum Bars to Load&rdquo; erhöhen" },
    { type: "paragraph", html: "Laden Sie mehr Historie vor, damit Lücken beim Öffnen erst gar nicht auftreten:" },
    {
      type: "steps",
      items: [
        { title: "Chart-Einstellungen öffnen", html: "Öffnen Sie die Einstellungen des Charts (den Chart-Editor / das Einstellungsfenster)." },
        { title: "Minimum Bars to Load finden", html: "Suchen Sie das Feld <strong class='text-white'>Minimum Bars to Load</strong>. Manche Versionen nennen es &ldquo;Minimum Number of Bars to Load&rdquo;, es ist dieselbe Einstellung." },
        { title: "Wert erhöhen", html: "Erhöhen Sie ihn deutlich über den Standardwert. Das Feld akzeptiert mehrere Tausend Kerzen, setzen Sie den Wert also hoch genug, um Ihren längsten Indikator-Rückblick plus Spielraum zum Scrollen abzudecken." },
      ],
    },
    { type: "image", src: `${IMG}/chart-empty-gaps-slow-load-3.png`, alt: "Tradovate-Chart-Editor-Panel mit dem auf einen höheren Wert gesetzten Feld Minimum Bars to Load" },
    { type: "heading", text: "Lösung 4: Eine Basis-Chart-Vorlage speichern, damit neue Tabs die Einstellung behalten" },
    { type: "paragraph", html: "Neue Chart-Tabs setzen auf das niedrige Standardminimum zurück, was Lösung 3 bei jedem Öffnen eines Charts rückgängig macht. Legen Sie es mit einer Vorlage fest:" },
    {
      type: "steps",
      items: [
        { title: "Ihren bevorzugten Chart konfigurieren", html: "Konfigurieren Sie einen Chart mit Ihrem bevorzugten <strong class='text-white'>Minimum Bars to Load</strong>, Intervall und Layout." },
        { title: "Als Vorlage speichern", html: "Speichern Sie ihn als Vorlage (zum Beispiel &ldquo;base 2000 bars&rdquo;)." },
        { title: "Zuerst auf neue Charts anwenden", html: "Wenden Sie diese Vorlage an, wenn Sie neue Charts öffnen, <em>und fügen Sie erst danach</em> Ihre Indikatoren hinzu." },
      ],
    },
    { type: "image", src: `${IMG}/chart-empty-gaps-slow-load-4.png`, alt: "Tradovate-Dialog zum Speichern als Vorlage mit einem Chart-Preset mit höherer Kerzenzahl" },
    { type: "heading", text: "Lösung 5: Bestätigen Sie, dass Ihr Marktdaten-Abonnement live ist" },
    { type: "paragraph", html: "Ist der Symbolname orange oder wirken die Kerzen veraltet, ist Ihr Feed verzögert oder inaktiv. Aktivieren oder abonnieren Sie Echtzeit-Marktdaten (Datenberechtigungen variieren je nach Kontotyp und Prop-Firma, prüfen Sie also die aktuellen Regeln Ihrer Firma), melden Sie sich dann ab und wieder an, damit der Live-Feed sich verbindet. Die vollständige Anleitung finden Sie in unserem Guide zu <a href='https://pickmytrade.trade/debugging/ten-minute-delayed-data-orange-symbols/'>Tradovate 10-Minute Delayed Data &amp; Orange Symbols</a>." },
    { type: "heading", text: "Fehlerbehebungstabelle" },
    {
      type: "table",
      headers: ["Symptom", "Bedeutung", "Lösung"],
      rows: [
        ["Leere Lücke mitten im Chart", "Kerzen in diesem Bereich wurden noch nicht angefordert", "Über die Lücke nach links scrollen, um einen Abruf auszulösen"],
        ["Chart direkt nach dem Login langsam oder leer", "Datenfeed holt den Start-Ansturm noch auf", "Kurz warten, dann aktualisieren (Web) oder neu starten (Desktop)"],
        ["Kerzen laden nicht beim weiten Zurückscrollen", "Über das vorgeladene / Tick-Historie-Fenster hinaus gezoomt", "Minimum Bars to Load erhöhen; Tick-Daten-Zusatz prüfen"],
        ["Indikatoren (EMA/VWAP) springen beim Scrollen", "Nicht genug Historie wurde vorgeladen, um sie zu berechnen", "Minimum Bars to Load erhöhen und als Vorlage speichern"],
        ["Neuer Tab lädt deutlich weniger Kerzen als erwartet", "Tabs setzen auf das niedrige Standardminimum zurück", "Ihre gespeicherte Basis-Vorlage vor dem Hinzufügen von Indikatoren anwenden"],
        ["Orangefarbener Symbolname, spärliche oder stockende Kerzen", "Verzögerte oder fehlende Echtzeit-Marktdaten", "Live-Daten abonnieren / aktivieren, dann neu anmelden"],
      ],
    },
    { type: "heading", text: "Wo PickMyTrade ins Spiel kommt" },
    { type: "paragraph", html: "Leere Chart-Lücken sind ein Darstellungsproblem, werden aber zu einem <em>Handelsproblem</em>, wenn ein stockender Chart Ihren Einstieg verbirgt oder Sie an einer Ausführung zweifeln, die Sie nicht abgebildet sehen. PickMyTrade nimmt den Chart aus dem kritischen Pfad der Ausführung:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Alert-gesteuerte Ausführung</strong>, Orders werden von Ihren TradingView-Alerts ausgelöst, nicht vom Chart-Rendering von Tradovate, sodass ein hängender oder lückenhafter Chart eine Ausführung nie verzögert.",
        "<strong class='text-white'>Menge-/Symbolprüfung</strong>, jede Order wird gegen den aktiven Kontrakt und Ihre Größenlimits geprüft, bevor sie gesendet wird, sodass ein falsch gelesener Chart nicht zu einer fehlerhaften Order wird.",
        "<strong class='text-white'>Ratenlimit-sichere Weiterleitung</strong>, der Orderfluss wird zeitlich gestreckt, damit nichts während desselben Login-Ansturms abgelehnt wird, der Ihre Charts stocken lässt.",
        "<strong class='text-white'>Multi-Konto-Synchronisierung</strong>, die korrekte Order spiegelt sich sofort auf jedem verknüpften Konto, ohne manuelle Neueingabe, während Sie darauf warten, dass Kerzen sich aufbauen.",
      ],
    },
  ], es: [
    { type: "paragraph", html: "Inicia sesión en Tradovate, abre su gráfico de ES o NQ, y la mitad está en blanco, tramos limpios y blancos donde deberían estar las velas. Es uno de los errores de visualización más comunes de la plataforma, y suele parecer peor de lo que es. Esos huecos pueden permanecer vacíos durante casi una hora antes de que las barras finalmente se carguen por sí solas. No tiene que esperar tanto. Tradovate sigue cargando el historial <em>bajo demanda</em> en lugar de todo de una vez, así que unos pocos movimientos deliberados obligan a los datos faltantes a completarse en segundos." },
    { type: "paragraph", html: "El síntoma aparece en varias variantes: un hueco vacío en medio de un gráfico por lo demás cargado, un gráfico lento o en blanco durante el primer minuto tras iniciar sesión, barras faltantes al retroceder en el tiempo, o indicadores como la EMA de 50 y el VWAP que saltan visiblemente cuando las barras más antiguas finalmente llegan. Todos se remontan a la misma causa raíz, barras que aún no se solicitaron, y todos se pueden solucionar desde el propio gráfico." },
    { type: "paragraph", html: "Si automatiza sus entradas, este error importa menos de lo que parece. PickMyTrade envía las órdenes desde sus alertas de TradingView directamente a Tradovate, así que un gráfico que todavía está dibujando velas nunca bloquea ni retrasa una ejecución automatizada. Pero cuando lee el precio manualmente, un hueco vacío puede ocultar exactamente la estructura que está operando, así que vamos a aclararlo." },
    {
      type: "checklist",
      heading: "Lista rápida para huecos vacíos en el gráfico",
      items: [
        "<strong class='text-white'>Desplácese hacia la izquierda por el hueco</strong>, arrastrar el gráfico hacia el rango vacío obliga a Tradovate a solicitar las barras faltantes.",
        "<strong class='text-white'>Reinicie o actualice</strong>, cierre y vuelva a abrir la aplicación de escritorio, o actualice la pestaña del navegador en Tradovate Web, para recargar todo el flujo de datos.",
        "<strong class='text-white'>Aumente &ldquo;Minimum Bars to Load&rdquo;</strong>, suba el valor en la configuración del gráfico para que se precargue más historial en el momento en que se abre el gráfico.",
        "<strong class='text-white'>Guarde una plantilla base</strong>, las nuevas pestañas de gráfico vuelven a un número de barras predeterminado bajo, así que una plantilla guardada conserva su configuración preferida.",
        "<strong class='text-white'>Confirme los datos de mercado en vivo</strong>, una suscripción retrasada o inexistente (nombre de símbolo en naranja) dibuja velas escasas o vacías.",
        "<strong class='text-white'>Reduzca la carga</strong>, menos pestañas e indicadores abiertos significan que la carga de datos al inicio termina más rápido.",
      ],
    },
    { type: "heading", text: "Qué significan realmente los huecos vacíos en el gráfico de Tradovate" },
    { type: "paragraph", html: "Un hueco vacío no es un dato corrupto ni una posición perdida, es simplemente un rango de barras que Tradovate aún no ha obtenido. El motor de gráficos solo carga las velas necesarias para llenar la ventana visible, y solicita más a medida que se desplaza o hace zoom. Cuando el servidor de datos está saturado (una avalancha de inicios de sesión en la apertura del mercado es el desencadenante clásico), esas solicitudes adicionales se acumulan en cola, y el gráfico muestra espacio en blanco hasta que se completan." },
    { type: "paragraph", html: "Por eso el hueco a menudo se corrige solo si lo deja tranquilo, la solicitud finalmente se completa, a veces una hora después. Las soluciones siguientes simplemente obligan a que esa solicitud se dispare ahora en lugar de esperar a que la cola se despeje." },
    { type: "paragraph", html: "La queja relacionada, indicadores que se recalculan y se desplazan al retroceder, es el mismo problema con otra cara. Los gráficos calculan sus indicadores a partir de las barras actualmente cargadas, así que una media móvil calculada sobre 100 barras precargadas se ve distinta una vez que llegan 2000 barras. Cargue suficiente historial de antemano y el salto se detiene." },
    { type: "heading", text: "Principales causas de los huecos en el gráfico de Tradovate" },
    { type: "heading", text: "1. El historial se carga bajo demanda, no de una vez" },
    { type: "paragraph", html: "Tradovate solicita barras para la ventana visible y solo obtiene más cuando se desplaza o aleja el zoom. Salte directamente a una vista alejada o muy anterior y verá espacio vacío hasta que se complete la solicitud." },
    { type: "heading", text: "2. Las nuevas pestañas de gráfico se abren con un número mínimo de barras bajo por defecto" },
    { type: "paragraph", html: "Cada pestaña de gráfico nueva se abre con solo una pequeña cantidad de barras precargadas. Añada un indicador con un período de referencia largo, o retroceda de inmediato, y superará los datos cargados, lo que produce huecos e indicadores que se recalculan." },
    { type: "heading", text: "3. Un flujo de datos congestionado justo después de iniciar sesión" },
    { type: "paragraph", html: "En la apertura, todas las plataformas solicitan datos a la vez. Los gráficos que cargan bien a mitad de sesión pueden ir lentos o detenerse durante esa ráfaga, dejando huecos temporales hasta que el flujo se pone al día." },
    { type: "heading", text: "4. Suscripción de datos de mercado retrasada o inexistente" },
    { type: "paragraph", html: "Si el nombre de su símbolo aparece en naranja, tiene datos retrasados o ninguno en vivo. Un flujo que no transmite no puede dibujar las barras actuales, lo que se ve como velas escasas o un borde derecho estancado." },
    { type: "heading", text: "5. Los gráficos de ticks y volumen alcanzan un límite de historial" },
    { type: "paragraph", html: "Los gráficos de ticks, volumen y rango solo obtienen una ventana limitada de historial por defecto, alrededor de dos semanas, con un complemento opcional para datos de ticks extendidos (hasta un año). Al desplazarse más allá de esa ventana, el gráfico simplemente deja de cargar. Los derechos y límites cambian con el tiempo, así que verifique lo que cubre actualmente su cuenta." },
    { type: "heading", text: "Cómo solucionar los huecos vacíos en el gráfico: paso a paso" },
    { type: "heading", text: "Solución 1: desplácese por el hueco para cargar las barras faltantes" },
    { type: "paragraph", html: "Haga clic y arrastre el gráfico hacia la izquierda, moviendo su vista hacia el rango vacío. Esta es la solución más rápida, y funciona porque la carga de Tradovate está diseñada exactamente así, arrastrar hacia territorio no cargado desencadena una nueva solicitud de esas barras, que se completan en uno o dos segundos con un flujo de datos saludable." },
    { type: "image", src: `${IMG}/chart-empty-gaps-slow-load-2.png`, alt: "Gráfico de Tradovate con barras antes vacías que se cargan tras desplazarse hacia la izquierda en el historial" },
    { type: "heading", text: "Solución 2: reinicie o actualice para recargar todo el flujo" },
    { type: "paragraph", html: "Si desplazarse no lo soluciona, recargue la conexión de datos:" },
    {
      type: "steps",
      items: [
        { title: "Tradovate Web", html: "Actualice la pestaña del navegador (F5 / Ctrl+R) para reconectar y volver a solicitar los datos del gráfico." },
        { title: "Aplicación de escritorio", html: "Cierre y vuelva a abrir la aplicación, luego inicie sesión de nuevo." },
        { title: "Móvil", html: "Cierre la aplicación por completo y vuelva a abrirla." },
      ],
    },
    { type: "paragraph", html: "No hay un botón dedicado de un clic para &ldquo;actualizar solo el gráfico&rdquo;. La forma fiable de forzar una recarga completa es reiniciar o actualizar el navegador, lo que restablece el flujo de datos desde cero." },
    { type: "heading", text: "Solución 3: aumente el ajuste &ldquo;Minimum Bars to Load&rdquo;" },
    { type: "paragraph", html: "Precargue más historial para que los huecos nunca aparezcan al abrir el gráfico:" },
    {
      type: "steps",
      items: [
        { title: "Abra la configuración del gráfico", html: "Abra la configuración del gráfico (el editor de gráfico / panel de configuración)." },
        { title: "Encuentre Minimum Bars to Load", html: "Encuentre el campo <strong class='text-white'>Minimum Bars to Load</strong>. Algunas versiones lo llaman &ldquo;Minimum Number of Bars to Load&rdquo;, pero es el mismo ajuste." },
        { title: "Aumente el valor", html: "Suba el valor bien por encima del predeterminado. El campo acepta varios miles de barras, así que fíjelo lo bastante alto para cubrir el período de referencia de su indicador más largo, más margen para desplazarse." },
      ],
    },
    { type: "image", src: `${IMG}/chart-empty-gaps-slow-load-3.png`, alt: "Panel del editor de gráfico de Tradovate con el campo Minimum Bars to Load ajustado a un valor más alto" },
    { type: "heading", text: "Solución 4: guarde una plantilla base de gráfico para que las nuevas pestañas conserven el ajuste" },
    { type: "paragraph", html: "Las nuevas pestañas de gráfico vuelven al mínimo predeterminado bajo, lo que anula la solución 3 cada vez que abre un gráfico. Fíjelo con una plantilla:" },
    {
      type: "steps",
      items: [
        { title: "Configure su gráfico preferido", html: "Configure un gráfico con su <strong class='text-white'>Minimum Bars to Load</strong>, intervalo y diseño preferidos." },
        { title: "Guárdelo como plantilla", html: "Guárdelo como plantilla (por ejemplo, &ldquo;base 2000 bars&rdquo;)." },
        { title: "Aplíquela primero a los gráficos nuevos", html: "Aplique esa plantilla al abrir gráficos nuevos, <em>y solo después</em> añada sus indicadores." },
      ],
    },
    { type: "image", src: `${IMG}/chart-empty-gaps-slow-load-4.png`, alt: "Cuadro de diálogo de Tradovate para guardar como plantilla, nombrando un preset de gráfico con un número mayor de barras" },
    { type: "heading", text: "Solución 5: confirme que su suscripción de datos de mercado está activa" },
    { type: "paragraph", html: "Si el nombre del símbolo está en naranja o las barras se ven desactualizadas, su flujo está retrasado o desactivado. Active o suscríbase a datos de mercado en tiempo real (los derechos de datos varían según el tipo de cuenta y la prop firm, así que verifique las reglas vigentes de su firma), y luego cierre sesión y vuelva a iniciarla para que se conecte el flujo en vivo. Para la guía completa, consulte nuestro artículo sobre <a href='https://pickmytrade.trade/debugging/ten-minute-delayed-data-orange-symbols/'>Tradovate 10-Minute Delayed Data &amp; Orange Symbols</a>." },
    { type: "heading", text: "Tabla de solución de problemas" },
    {
      type: "table",
      headers: ["Síntoma", "Significado", "Solución"],
      rows: [
        ["Hueco vacío en medio del gráfico", "Las barras de ese rango aún no se solicitaron", "Desplácese hacia la izquierda por el hueco para activar una solicitud"],
        ["Gráfico lento o en blanco justo tras iniciar sesión", "El flujo de datos aún se pone al día tras la ráfaga inicial", "Espere un momento y actualice (web) o reinicie (escritorio)"],
        ["Las barras no cargan al desplazarse muy atrás", "Se pasó de la ventana precargada / de historial de ticks", "Aumente Minimum Bars to Load; verifique el complemento de datos de ticks"],
        ["Los indicadores (EMA/VWAP) saltan al desplazarse", "No se precargó suficiente historial para calcularlos", "Aumente Minimum Bars to Load y guárdelo como plantilla"],
        ["Una pestaña nueva carga muchas menos barras de lo esperado", "Las pestañas vuelven al mínimo predeterminado bajo", "Aplique su plantilla base guardada antes de añadir indicadores"],
        ["Nombre de símbolo en naranja, barras escasas o estancadas", "Datos de mercado en tiempo real retrasados o ausentes", "Suscríbase o active los datos en vivo y vuelva a iniciar sesión"],
      ],
    },
    { type: "heading", text: "Dónde encaja PickMyTrade" },
    { type: "paragraph", html: "Los huecos vacíos en el gráfico son un problema de visualización, pero se convierten en un problema de <em>trading</em> cuando un gráfico estancado oculta su entrada o duda de una ejecución que no puede ver reflejada. PickMyTrade saca el gráfico de la ruta crítica de la ejecución:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Ejecución impulsada por alertas</strong>, las órdenes se disparan desde sus alertas de TradingView, no desde el renderizado del gráfico de Tradovate, así que un gráfico lento o con huecos nunca retrasa una ejecución.",
        "<strong class='text-white'>Validación de cantidad/símbolo</strong>, cada orden se verifica contra el contrato activo y sus límites de tamaño antes de enviarse, así que un gráfico mal leído no se convierte en una orden errónea.",
        "<strong class='text-white'>Enrutamiento seguro ante límites de tasa</strong>, el flujo de órdenes se distribuye en el tiempo para que nada rebote durante la misma congestión por avalancha de inicios de sesión que estanca sus gráficos.",
        "<strong class='text-white'>Sincronización multicuenta</strong>, la orden correcta se refleja en cada cuenta vinculada al instante, sin reingreso manual mientras espera a que se dibujen las velas.",
      ],
    },
  ], fr: [
    { type: "paragraph", html: "Vous vous connectez à Tradovate, ouvrez votre graphique ES ou NQ, et la moitié est vide, de longues plages blanches là où des bougies devraient apparaître. C'est l'un des bugs d'affichage les plus courants de la plateforme, et il paraît généralement pire qu'il ne l'est. Ces espaces peuvent rester vides pendant près d'une heure avant que les barres ne finissent par arriver d'elles-mêmes. Vous n'avez pas besoin d'attendre aussi longtemps. Tradovate charge toujours l'historique <em>à la demande</em> plutôt que d'un coup, donc quelques actions ciblées forcent les données manquantes à se charger en quelques secondes." },
    { type: "paragraph", html: "Le symptôme se présente sous plusieurs formes : un espace vide au milieu d'un graphique par ailleurs chargé, un graphique lent ou vide pendant la première minute après la connexion, des barres manquantes lorsque vous reculez dans le temps, ou des indicateurs comme l'EMA 50 et le VWAP qui sautent visiblement à l'arrivée des barres plus anciennes. Ils remontent tous à la même cause racine, des barres qui n'ont pas encore été demandées, et ils se corrigent tous depuis le graphique lui-même." },
    { type: "paragraph", html: "Si vous automatisez vos entrées, ce bug compte moins qu'il n'y paraît. PickMyTrade achemine les ordres de vos alertes TradingView directement vers Tradovate, donc un graphique qui dessine encore ses bougies ne bloque ni ne retarde jamais une exécution automatisée. Mais lorsque vous lisez le prix manuellement, un espace vide peut cacher exactement la structure que vous tradez, alors éclaircissons ce point." },
    {
      type: "checklist",
      heading: "Liste de vérification rapide pour les espaces vides sur le graphique",
      items: [
        "<strong class='text-white'>Faites défiler vers la gauche à travers l'espace vide</strong>, glisser le graphique dans la plage vide force Tradovate à demander les barres manquantes.",
        "<strong class='text-white'>Redémarrez ou actualisez</strong>, fermez et rouvrez l'application de bureau, ou actualisez l'onglet du navigateur sur Tradovate Web, pour recharger tout le flux de données.",
        "<strong class='text-white'>Augmentez &ldquo;Minimum Bars to Load&rdquo;</strong>, augmentez la valeur dans les paramètres du graphique afin que davantage d'historique se précharge dès l'ouverture du graphique.",
        "<strong class='text-white'>Enregistrez un modèle de base</strong>, les nouveaux onglets de graphique reviennent à un nombre de barres par défaut faible, un modèle enregistré conserve donc votre réglage préféré.",
        "<strong class='text-white'>Vérifiez les données de marché en direct</strong>, un abonnement retardé ou manquant (nom du symbole en orange) affiche des bougies éparses ou vides.",
        "<strong class='text-white'>Réduisez la charge</strong>, moins d'onglets et d'indicateurs ouverts signifie que le chargement des données au démarrage se termine plus vite.",
      ],
    },
    { type: "heading", text: "Ce que signifient réellement les espaces vides sur les graphiques Tradovate" },
    { type: "paragraph", html: "Un espace vide n'est ni une donnée corrompue ni une position perdue, c'est simplement une plage de barres que Tradovate n'a pas encore récupérée. Le moteur graphique ne charge que les bougies nécessaires pour remplir la fenêtre visible, puis en demande davantage lorsque vous faites défiler ou zoomez. Lorsque le serveur de données est surchargé (une ruée de connexions à l'ouverture du marché en est le déclencheur classique), ces requêtes supplémentaires s'accumulent, et le graphique affiche un espace vide jusqu'à leur retour." },
    { type: "paragraph", html: "C'est pourquoi l'espace se comble souvent de lui-même si vous le laissez tranquille, la requête finit par aboutir, parfois une heure plus tard. Les solutions ci-dessous forcent simplement cette requête à se déclencher immédiatement plutôt que d'attendre que la file d'attente se vide." },
    { type: "paragraph", html: "La plainte connexe, des indicateurs qui se recalculent et se décalent lorsque vous reculez, est le même problème sous un autre angle. Les graphiques calculent leurs indicateurs à partir des barres actuellement chargées, donc une moyenne mobile calculée sur 100 barres préchargées paraît différente une fois que 2 000 barres arrivent. Chargez suffisamment d'historique en amont, et les sauts s'arrêtent." },
    { type: "heading", text: "Principales causes des espaces vides sur les graphiques Tradovate" },
    { type: "heading", text: "1. L'historique se charge à la demande, pas d'un coup" },
    { type: "paragraph", html: "Tradovate demande les barres pour la fenêtre visible et n'en récupère davantage que lorsque vous faites défiler ou dézoomez. Sautez directement vers une vue dézoomée ou très ancienne, et vous verrez un espace vide jusqu'à la fin de la récupération." },
    { type: "heading", text: "2. Les nouveaux onglets de graphique s'ouvrent par défaut avec un nombre minimal de barres faible" },
    { type: "paragraph", html: "Chaque nouvel onglet de graphique s'ouvre avec seulement un petit nombre de barres préchargées. Ajoutez un indicateur avec une période d'observation longue, ou reculez immédiatement, et vous dépassez les données chargées, ce qui produit des espaces vides et des indicateurs qui se recalculent." },
    { type: "heading", text: "3. Un flux de données saturé juste après la connexion" },
    { type: "paragraph", html: "À l'ouverture, toutes les plateformes demandent des données en même temps. Des graphiques qui se chargent bien en cours de séance peuvent ramer ou se bloquer pendant cette ruée, laissant des espaces temporaires jusqu'à ce que le flux rattrape son retard." },
    { type: "heading", text: "4. Abonnement aux données de marché retardé ou manquant" },
    { type: "paragraph", html: "Si le nom de votre symbole apparaît en orange, vous êtes en données retardées ou sans données en direct. Un flux qui ne diffuse pas ne peut pas dessiner les barres actuelles, ce qui se traduit par des bougies éparses ou un bord droit figé." },
    { type: "heading", text: "5. Les graphiques en ticks et en volume atteignent une limite d'historique" },
    { type: "paragraph", html: "Les graphiques en ticks, en volume et en range ne récupèrent par défaut qu'une fenêtre d'historique limitée, environ deux semaines, avec un module complémentaire optionnel pour des données de ticks étendues (jusqu'à un an). Au-delà de cette fenêtre, le graphique arrête simplement de charger. Les droits et limites évoluent avec le temps, vérifiez donc ce que couvre actuellement votre compte." },
    { type: "heading", text: "Comment corriger les espaces vides sur le graphique : étape par étape" },
    { type: "heading", text: "Solution 1 : faites défiler à travers l'espace vide pour récupérer les barres manquantes" },
    { type: "paragraph", html: "Cliquez et faites glisser le graphique vers la gauche, en déplaçant votre vue dans la plage vide. C'est la solution la plus rapide, et elle fonctionne parce que le chargement de Tradovate est conçu exactement ainsi, glisser vers un territoire non chargé déclenche une nouvelle demande pour ces barres, qui se chargent en une ou deux secondes sur un flux en bon état." },
    { type: "image", src: `${IMG}/chart-empty-gaps-slow-load-2.png`, alt: "Graphique Tradovate dont les barres auparavant vides se chargent après un défilement vers la gauche dans l'historique" },
    { type: "heading", text: "Solution 2 : redémarrez ou actualisez pour recharger tout le flux" },
    { type: "paragraph", html: "Si le défilement ne règle pas le problème, rechargez la connexion de données :" },
    {
      type: "steps",
      items: [
        { title: "Tradovate Web", html: "Actualisez l'onglet du navigateur (F5 / Ctrl+R) pour vous reconnecter et redemander les données du graphique." },
        { title: "Application de bureau", html: "Fermez et rouvrez l'application, puis reconnectez-vous." },
        { title: "Mobile", html: "Forcez la fermeture puis relancez l'application." },
      ],
    },
    { type: "paragraph", html: "Il n'existe pas de bouton dédié en un clic pour &ldquo;actualiser uniquement le graphique&rdquo;. Le moyen fiable de forcer un rechargement complet est un redémarrage ou une actualisation du navigateur, qui rétablit le flux de données depuis zéro." },
    { type: "heading", text: "Solution 3 : augmentez le paramètre &ldquo;Minimum Bars to Load&rdquo;" },
    { type: "paragraph", html: "Préchargez davantage d'historique pour que les espaces vides n'apparaissent jamais à l'ouverture :" },
    {
      type: "steps",
      items: [
        { title: "Ouvrez les paramètres du graphique", html: "Ouvrez les paramètres du graphique (l'éditeur de graphique / le panneau de paramètres)." },
        { title: "Trouvez Minimum Bars to Load", html: "Trouvez le champ <strong class='text-white'>Minimum Bars to Load</strong>. Certaines versions l'appellent &ldquo;Minimum Number of Bars to Load&rdquo;, mais c'est le même paramètre." },
        { title: "Augmentez la valeur", html: "Augmentez-la bien au-delà de la valeur par défaut. Le champ accepte plusieurs milliers de barres, réglez-le donc assez haut pour couvrir la période d'observation de votre indicateur le plus long, plus une marge pour défiler." },
      ],
    },
    { type: "image", src: `${IMG}/chart-empty-gaps-slow-load-3.png`, alt: "Panneau de l'éditeur de graphique Tradovate avec le champ Minimum Bars to Load réglé sur une valeur plus élevée" },
    { type: "heading", text: "Solution 4 : enregistrez un modèle de graphique de base pour que les nouveaux onglets conservent le paramètre" },
    { type: "paragraph", html: "Les nouveaux onglets de graphique reviennent au minimum par défaut faible, ce qui annule la solution 3 à chaque ouverture d'un graphique. Verrouillez-le avec un modèle :" },
    {
      type: "steps",
      items: [
        { title: "Configurez votre graphique préféré", html: "Configurez un graphique avec votre <strong class='text-white'>Minimum Bars to Load</strong>, votre intervalle et votre mise en page préférés." },
        { title: "Enregistrez-le comme modèle", html: "Enregistrez-le comme modèle (par exemple, &ldquo;base 2000 bars&rdquo;)." },
        { title: "Appliquez-le d'abord aux nouveaux graphiques", html: "Appliquez ce modèle lorsque vous ouvrez de nouveaux graphiques, <em>puis</em> ajoutez vos indicateurs." },
      ],
    },
    { type: "image", src: `${IMG}/chart-empty-gaps-slow-load-4.png`, alt: "Boîte de dialogue Tradovate d'enregistrement en tant que modèle nommant un préréglage de graphique avec un nombre de barres plus élevé" },
    { type: "heading", text: "Solution 5 : vérifiez que votre abonnement aux données de marché est actif" },
    { type: "paragraph", html: "Si le nom du symbole est orange ou si les barres semblent obsolètes, votre flux est retardé ou coupé. Activez ou abonnez-vous aux données de marché en temps réel (les droits sur les données varient selon le type de compte et la prop firm, vérifiez donc les règles actuelles de votre société), puis déconnectez-vous et reconnectez-vous pour que le flux en direct se rattache. Pour le guide complet, consultez notre article sur <a href='https://pickmytrade.trade/debugging/ten-minute-delayed-data-orange-symbols/'>Tradovate 10-Minute Delayed Data &amp; Orange Symbols</a>." },
    { type: "heading", text: "Tableau de dépannage" },
    {
      type: "table",
      headers: ["Symptôme", "Signification", "Solution"],
      rows: [
        ["Espace vide au milieu du graphique", "Les barres de cette plage n'ont pas encore été demandées", "Faites défiler vers la gauche à travers l'espace pour déclencher une récupération"],
        ["Graphique lent ou vide juste après la connexion", "Le flux de données rattrape encore la ruée du démarrage", "Patientez un instant, puis actualisez (web) ou redémarrez (bureau)"],
        ["Les barres ne se chargent pas en reculant loin", "Vous avez dépassé la fenêtre préchargée / d'historique en ticks", "Augmentez Minimum Bars to Load ; vérifiez le module de données en ticks"],
        ["Les indicateurs (EMA/VWAP) sautent lors du défilement", "Pas assez d'historique préchargé pour les calculer", "Augmentez Minimum Bars to Load et enregistrez comme modèle"],
        ["Un nouvel onglet charge bien moins de barres que prévu", "Les onglets reviennent au minimum par défaut faible", "Appliquez votre modèle de base enregistré avant d'ajouter des indicateurs"],
        ["Nom de symbole en orange, bougies éparses ou figées", "Données de marché en temps réel retardées ou manquantes", "Abonnez-vous ou activez les données en direct, puis reconnectez-vous"],
      ],
    },
    { type: "heading", text: "La place de PickMyTrade" },
    { type: "paragraph", html: "Les espaces vides sur le graphique sont un problème d'affichage, mais ils deviennent un problème de <em>trading</em> lorsqu'un graphique figé cache votre entrée ou vous fait douter d'une exécution que vous ne voyez pas s'afficher. PickMyTrade sort le graphique du chemin critique de l'exécution :" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Exécution pilotée par les alertes</strong>, les ordres se déclenchent depuis vos alertes TradingView, pas depuis le rendu du graphique de Tradovate, donc un graphique lent ou lacunaire ne retarde jamais une exécution.",
        "<strong class='text-white'>Validation de la quantité / du symbole</strong>, chaque ordre est vérifié par rapport au contrat actif et à vos plafonds de taille avant d'être envoyé, donc un graphique mal lu ne se transforme jamais en ordre erroné.",
        "<strong class='text-white'>Acheminement sécurisé contre les limites de débit</strong>, le flux d'ordres est espacé pour que rien ne soit rejeté pendant cette même congestion due à la ruée de connexions qui bloque vos graphiques.",
        "<strong class='text-white'>Synchronisation multi-comptes</strong>, l'ordre correct se répercute instantanément sur chaque compte lié, sans ressaisie manuelle pendant que vous attendez que les bougies se dessinent.",
      ],
    },
  ], it: [
    { type: "paragraph", html: "Accede a Tradovate, apre il proprio grafico ES o NQ, e metà è vuoto, ampi tratti bianchi dove dovrebbero esserci le candele. È uno dei bug di visualizzazione più comuni della piattaforma, e di solito sembra peggiore di quanto sia in realtà. Questi vuoti possono restare tali per quasi un'ora prima che le barre finiscano per caricarsi da sole. Non deve aspettare così a lungo. Tradovate carica ancora la cronologia <em>su richiesta</em> anziché tutta insieme, quindi alcune mosse mirate costringono i dati mancanti a caricarsi in pochi secondi." },
    { type: "paragraph", html: "Il sintomo si presenta in diverse varianti: un vuoto in mezzo a un grafico altrimenti caricato, un grafico lento o vuoto nel primo minuto dopo l'accesso, barre mancanti quando si torna indietro nel tempo, oppure indicatori come l'EMA a 50 periodi e il VWAP che saltano visibilmente quando le barre più vecchie arrivano finalmente. Tutti riconducono alla stessa causa di fondo, barre non ancora richieste, e tutti si risolvono direttamente dal grafico." },
    { type: "paragraph", html: "Se automatizza i propri ingressi, questo bug conta meno di quanto sembri. PickMyTrade instrada gli ordini dai suoi alert di TradingView direttamente a Tradovate, quindi un grafico che sta ancora disegnando le candele non blocca né ritarda mai un'esecuzione automatizzata. Ma quando legge il prezzo manualmente, un vuoto può nascondere esattamente la struttura che sta tradando, quindi chiariamo la questione." },
    {
      type: "checklist",
      heading: "Checklist rapida per i vuoti nel grafico",
      items: [
        "<strong class='text-white'>Scorra a sinistra oltre il vuoto</strong>, trascinare il grafico nell'intervallo vuoto costringe Tradovate a richiedere le barre mancanti.",
        "<strong class='text-white'>Riavvii o aggiorni</strong>, chiuda e riapra l'app desktop, oppure aggiorni la scheda del browser su Tradovate Web, per ricaricare l'intero flusso di dati.",
        "<strong class='text-white'>Aumenti &ldquo;Minimum Bars to Load&rdquo;</strong>, alzi il valore nelle impostazioni del grafico affinché venga precaricata più cronologia nel momento in cui il grafico si apre.",
        "<strong class='text-white'>Salvi un template di base</strong>, le nuove schede grafico tornano a un numero di barre predefinito basso, quindi un template salvato mantiene la sua impostazione preferita.",
        "<strong class='text-white'>Confermi i dati di mercato in tempo reale</strong>, un abbonamento ritardato o mancante (nome del simbolo arancione) disegna candele scarse o vuote.",
        "<strong class='text-white'>Riduca il carico</strong>, meno schede e indicatori aperti significano che il caricamento dei dati all'avvio termina più in fretta.",
      ],
    },
    { type: "heading", text: "Cosa significano davvero i vuoti nel grafico di Tradovate" },
    { type: "paragraph", html: "Un vuoto non è un dato corrotto né una posizione persa, è semplicemente un intervallo di barre che Tradovate non ha ancora recuperato. Il motore di rendering carica solo le candele necessarie a riempire la finestra visibile, poi ne richiede altre man mano che si scorre o si esegue lo zoom. Quando il server dati è sovraccarico (un'ondata di accessi all'apertura del mercato è il classico innesco), queste richieste successive si accodano, e il grafico mostra spazio vuoto finché non vengono evase." },
    { type: "paragraph", html: "Ecco perché il vuoto spesso si sana da solo se lo si lascia stare, la richiesta alla fine si completa, a volte dopo un'ora. Le soluzioni seguenti costringono semplicemente quella richiesta a partire subito invece di aspettare che la coda si svuoti." },
    { type: "paragraph", html: "Il reclamo correlato, gli indicatori che si ricalcolano e si spostano quando si torna indietro, è lo stesso problema sotto un'altra veste. I grafici calcolano i loro indicatori sulle barre attualmente caricate, quindi una media mobile calcolata su 100 barre precaricate appare diversa una volta arrivate 2.000 barre. Caricando abbastanza cronologia in anticipo, i salti si fermano." },
    { type: "heading", text: "Le principali cause dei vuoti nel grafico di Tradovate" },
    { type: "heading", text: "1. La cronologia si carica su richiesta, non tutta insieme" },
    { type: "paragraph", html: "Tradovate richiede le barre per la finestra visibile e ne recupera altre solo quando si scorre o si riduce lo zoom. Se salta direttamente a una vista molto rimpicciolita o lontana nel tempo, vedrà spazio vuoto finché il recupero non si completa." },
    { type: "heading", text: "2. Le nuove schede grafico partono di default con un numero minimo di barre basso" },
    { type: "paragraph", html: "Ogni nuova scheda grafico si apre con solo un piccolo numero di barre precaricate. Aggiunga un indicatore con un lookback lungo, o torni indietro subito, e supererà i dati caricati, il che produce vuoti e indicatori che si ricalcolano." },
    { type: "heading", text: "3. Un flusso di dati congestionato subito dopo l'accesso" },
    { type: "paragraph", html: "All'apertura, tutte le piattaforme richiedono dati contemporaneamente. Grafici che si caricano bene a metà sessione possono rallentare o bloccarsi durante quell'ondata, lasciando vuoti temporanei finché il flusso non recupera." },
    { type: "heading", text: "4. Abbonamento ai dati di mercato ritardato o mancante" },
    { type: "paragraph", html: "Se il nome del suo simbolo appare in arancione, ha dati ritardati o assenti in tempo reale. Un flusso che non trasmette non può disegnare le barre attuali, il che si traduce in candele scarse o in un bordo destro bloccato." },
    { type: "heading", text: "5. I grafici a tick e a volume raggiungono un limite di cronologia" },
    { type: "paragraph", html: "I grafici a tick, a volume e a range recuperano per default solo una finestra di cronologia limitata, circa due settimane, con un componente aggiuntivo opzionale per dati tick estesi (fino a un anno). Superata quella finestra, il grafico smette semplicemente di caricare. I diritti e i limiti cambiano nel tempo, quindi verifichi cosa copre attualmente il suo account." },
    { type: "heading", text: "Come risolvere i vuoti nel grafico: passo dopo passo" },
    { type: "heading", text: "Soluzione 1: scorra oltre il vuoto per recuperare le barre mancanti" },
    { type: "paragraph", html: "Clicchi e trascini il grafico verso sinistra, spostando la visuale nell'intervallo vuoto. È la soluzione più rapida, e funziona perché il caricamento di Tradovate è costruito esattamente così, trascinarsi in territorio non caricato attiva una nuova richiesta per quelle barre, che si riempiono in uno o due secondi con un flusso dati sano." },
    { type: "image", src: `${IMG}/chart-empty-gaps-slow-load-2.png`, alt: "Grafico Tradovate con barre in precedenza vuote che si caricano dopo aver scorso a sinistra nella cronologia" },
    { type: "heading", text: "Soluzione 2: riavvii o aggiorni per ricaricare l'intero flusso" },
    { type: "paragraph", html: "Se scorrere non risolve il problema, ricarichi la connessione dati:" },
    {
      type: "steps",
      items: [
        { title: "Tradovate Web", html: "Aggiorni la scheda del browser (F5 / Ctrl+R) per riconnettersi e richiedere di nuovo i dati del grafico." },
        { title: "App desktop", html: "Chiuda e riapra l'applicazione, quindi effettui di nuovo l'accesso." },
        { title: "Mobile", html: "Forzi la chiusura e riavvii l'app." },
      ],
    },
    { type: "paragraph", html: "Non esiste un pulsante dedicato a un clic per &ldquo;aggiornare solo il grafico&rdquo;. Il modo affidabile per forzare un ricaricamento completo è un riavvio o un aggiornamento del browser, che ristabilisce il flusso di dati da zero." },
    { type: "heading", text: "Soluzione 3: aumenti l'impostazione &ldquo;Minimum Bars to Load&rdquo;" },
    { type: "paragraph", html: "Precarichi più cronologia in modo che i vuoti non compaiano mai all'apertura:" },
    {
      type: "steps",
      items: [
        { title: "Apra le impostazioni del grafico", html: "Apra le impostazioni del grafico (l'editor del grafico / il pannello delle impostazioni)." },
        { title: "Trovi Minimum Bars to Load", html: "Trovi il campo <strong class='text-white'>Minimum Bars to Load</strong>. Alcune versioni lo chiamano &ldquo;Minimum Number of Bars to Load&rdquo;, ma è la stessa impostazione." },
        { title: "Alzi il valore", html: "Lo alzi ben oltre il valore predefinito. Il campo accetta diverse migliaia di barre, quindi lo imposti abbastanza alto da coprire il lookback del suo indicatore più lungo più un margine per scorrere." },
      ],
    },
    { type: "image", src: `${IMG}/chart-empty-gaps-slow-load-3.png`, alt: "Pannello dell'editor del grafico Tradovate con il campo Minimum Bars to Load impostato su un valore più alto" },
    { type: "heading", text: "Soluzione 4: salvi un template di grafico di base così le nuove schede mantengono l'impostazione" },
    { type: "paragraph", html: "Le nuove schede grafico tornano al minimo predefinito basso, il che annulla la Soluzione 3 ogni volta che apre un grafico. Lo blocchi con un template:" },
    {
      type: "steps",
      items: [
        { title: "Configuri il grafico preferito", html: "Configuri un grafico con il suo <strong class='text-white'>Minimum Bars to Load</strong>, intervallo e layout preferiti." },
        { title: "Lo salvi come template", html: "Lo salvi come template (ad esempio, &ldquo;base 2000 bars&rdquo;)." },
        { title: "Lo applichi prima ai nuovi grafici", html: "Applichi quel template quando apre nuovi grafici, <em>e solo dopo</em> aggiunga i suoi indicatori." },
      ],
    },
    { type: "image", src: `${IMG}/chart-empty-gaps-slow-load-4.png`, alt: "Finestra di dialogo Tradovate per salvare come template, che nomina un preset di grafico con un numero di barre più alto" },
    { type: "heading", text: "Soluzione 5: confermi che il suo abbonamento ai dati di mercato sia attivo" },
    { type: "paragraph", html: "Se il nome del simbolo è arancione o le barre appaiono non aggiornate, il suo flusso è ritardato o disattivato. Attivi o si abboni ai dati di mercato in tempo reale (i diritti sui dati variano in base al tipo di account e alla prop firm, quindi verifichi le regole attuali della sua società), quindi esca e rientri per far riagganciare il flusso live. Per la guida completa, consulti il nostro articolo su <a href='https://pickmytrade.trade/debugging/ten-minute-delayed-data-orange-symbols/'>Tradovate 10-Minute Delayed Data &amp; Orange Symbols</a>." },
    { type: "heading", text: "Tabella di risoluzione dei problemi" },
    {
      type: "table",
      headers: ["Sintomo", "Significato", "Soluzione"],
      rows: [
        ["Vuoto in mezzo al grafico", "Le barre in quell'intervallo non erano ancora state richieste", "Scorra a sinistra oltre il vuoto per attivare un recupero"],
        ["Grafico lento o vuoto subito dopo l'accesso", "Il flusso di dati sta ancora recuperando l'ondata iniziale", "Attenda un momento, poi aggiorni (web) o riavvii (desktop)"],
        ["Le barre non si caricano scorrendo molto indietro", "Ha superato la finestra precaricata / di cronologia tick", "Aumenti Minimum Bars to Load; verifichi il componente dati tick aggiuntivo"],
        ["Gli indicatori (EMA/VWAP) saltano mentre scorre", "Non è stata precaricata abbastanza cronologia per calcolarli", "Aumenti Minimum Bars to Load e salvi come template"],
        ["Una nuova scheda carica molte meno barre del previsto", "Le schede tornano al minimo predefinito basso", "Applichi il suo template di base salvato prima di aggiungere indicatori"],
        ["Nome simbolo arancione, candele scarse o bloccate", "Dati di mercato in tempo reale ritardati o mancanti", "Si abboni o attivi i dati live, quindi rientri"],
      ],
    },
    { type: "heading", text: "Dove si inserisce PickMyTrade" },
    { type: "paragraph", html: "I vuoti nel grafico sono un problema di visualizzazione, ma diventano un problema di <em>trading</em> quando un grafico bloccato nasconde il suo ingresso o la fa dubitare di un'esecuzione che non riesce a vedere rappresentata. PickMyTrade toglie il grafico dal percorso critico dell'esecuzione:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Esecuzione guidata dagli alert</strong>, gli ordini partono dai suoi alert di TradingView, non dal rendering del grafico di Tradovate, quindi un grafico lento o con vuoti non ritarda mai un'esecuzione.",
        "<strong class='text-white'>Convalida di quantità/simbolo</strong>, ogni ordine viene verificato rispetto al contratto attivo e ai suoi limiti di size prima di essere inviato, quindi un grafico letto male non si trasforma in un ordine sbagliato.",
        "<strong class='text-white'>Instradamento sicuro dai rate limit</strong>, il flusso degli ordini viene distribuito nel tempo così nulla rimbalza durante la stessa congestione da ondata di accessi che blocca i suoi grafici.",
        "<strong class='text-white'>Sincronizzazione multi-account</strong>, l'ordine corretto si riflette istantaneamente su ogni account collegato, senza reinserimento manuale mentre attende che le candele si disegnino.",
      ],
    },
  ] },
  ctaHeading: { en: "Automate Your Tradovate Execution", de: "Automatisieren Sie Ihre Tradovate-Ausführung", es: "Automatice su ejecución en Tradovate", fr: "Automatisez votre exécution sur Tradovate", it: "Automatizzi la sua esecuzione su Tradovate" },
  ctaText: { en: "Stop waiting on the chart to confirm a fill. Let PickMyTrade route your TradingView alerts straight to Tradovate, gaps or no gaps.", de: "Warten Sie nicht länger darauf, dass der Chart eine Ausführung bestätigt. Lassen Sie PickMyTrade Ihre TradingView-Alerts direkt an Tradovate weiterleiten, mit oder ohne Lücken.", es: "Deje de esperar a que el gráfico confirme una ejecución. Deje que PickMyTrade envíe sus alertas de TradingView directamente a Tradovate, con o sin huecos.", fr: "Arrêtez d'attendre que le graphique confirme une exécution. Laissez PickMyTrade acheminer vos alertes TradingView directement vers Tradovate, avec ou sans espaces vides.", it: "Smetta di aspettare che il grafico confermi un'esecuzione. Lasci che PickMyTrade instradi i suoi alert di TradingView direttamente a Tradovate, con o senza vuoti." },
  ctaButtonText: { en: "Start Your Free 7-Day Trial", de: "Starten Sie Ihre kostenlose 5-Tage-Testversion", es: "Comience su prueba gratuita de 5 días", fr: "Démarrez votre essai gratuit de 5 jours", it: "Inizi la sua prova gratuita di 5 giorni" },
  ctaUrl: "https://app.pickmytrade.trade/?register=true&utm_source=content&utm_medium=debugging",
  faqHeading: { en: "Frequently Asked Questions", de: "Häufig gestellte Fragen", es: "Preguntas frecuentes", fr: "Questions fréquentes", it: "Domande frequenti" },
  faqs: { en: [
    { q: "Why do my Tradovate charts load with empty gaps?", a: "Tradovate loads chart history on demand, it fetches only the bars needed for the visible window, then requests more as you scroll. When the data server is busy (typically right after login), those requests queue and the chart shows blank space until they return." },
    { q: "How do I force a Tradovate chart to reload without waiting?", a: "Drag the chart left into the empty range to trigger an immediate request for the missing bars. If that doesn't clear it, refresh the browser tab on Tradovate Web or restart the desktop app to reload the entire data feed." },
    { q: "Is there a dedicated refresh button for Tradovate charts?", a: "There's no dedicated one-click \"refresh this chart\" control. The reliable ways to force a full reload are scrolling across the gap, refreshing the browser on Tradovate Web, or restarting the app on desktop and mobile." },
    { q: "Why do my indicators move when I scroll back in time?", a: "Indicators are calculated on the bars currently loaded. If only a small number of bars preloaded, a moving average or VWAP recalculates and shifts as more history arrives. Raising the Minimum Bars to Load setting so enough history loads up front stops the jumping." },
    { q: "How many bars can a Tradovate chart load?", a: "The Minimum Bars to Load field accepts several thousand bars, and you can set it high enough to cover long indicator lookbacks. Exact caps change between builds, so confirm the current maximum in your chart settings." },
    { q: "Why do my new chart tabs load fewer bars than my main chart?", a: "New tabs default back to a low minimum bar count regardless of your previous setting. Configure one chart the way you like it, save it as a template, and apply that template to new tabs to keep the higher count." },
    { q: "My tick chart won't scroll back very far, is that the same bug?", a: "Not quite. Tick, volume, and range charts pull only a limited history window by default, with an optional add-on for extended tick data. For deep history, use a time-based interval or check your current data entitlements." },
    { q: "Do empty gaps mean my orders or positions are affected?", a: "No. Gaps are purely a chart-display issue, your positions, orders, and fills are unaffected. If you automate through PickMyTrade, execution runs off your alerts, so a gappy chart never touches your order flow." },
  ], de: [
    { q: "Warum laden meine Tradovate-Charts mit leeren Lücken?", a: "Tradovate lädt die Chart-Historie bei Bedarf, es ruft nur die Kerzen ab, die für das sichtbare Fenster nötig sind, und fordert beim Scrollen weitere an. Wenn der Datenserver ausgelastet ist (typischerweise direkt nach dem Login), stauen sich diese Anfragen, und der Chart zeigt leeren Raum, bis sie beantwortet werden." },
    { q: "Wie erzwinge ich ein Neuladen eines Tradovate-Charts, ohne zu warten?", a: "Ziehen Sie den Chart nach links in den leeren Bereich, um sofort eine Anfrage für die fehlenden Kerzen auszulösen. Falls das die Lücke nicht behebt, aktualisieren Sie den Browser-Tab bei Tradovate Web oder starten Sie die Desktop-App neu, um den gesamten Datenfeed neu zu laden." },
    { q: "Gibt es eine eigene Aktualisieren-Schaltfläche für Tradovate-Charts?", a: "Es gibt keine eigene Ein-Klick-Steuerung zum &ldquo;nur diesen Chart aktualisieren&rdquo;. Die zuverlässigen Wege für ein vollständiges Neuladen sind: über die Lücke scrollen, den Browser bei Tradovate Web aktualisieren oder die App auf Desktop und Mobilgeräten neu starten." },
    { q: "Warum bewegen sich meine Indikatoren, wenn ich in der Zeit zurückscrolle?", a: "Indikatoren werden anhand der aktuell geladenen Kerzen berechnet. Wenn nur eine kleine Anzahl Kerzen vorgeladen ist, berechnet sich ein gleitender Durchschnitt oder VWAP neu und verschiebt sich, sobald mehr Historie eintrifft. Das Erhöhen von Minimum Bars to Load, damit genügend Historie im Voraus lädt, stoppt das Springen." },
    { q: "Wie viele Kerzen kann ein Tradovate-Chart laden?", a: "Das Feld Minimum Bars to Load akzeptiert mehrere Tausend Kerzen, und Sie können es hoch genug einstellen, um lange Indikator-Rückblickzeiträume abzudecken. Die genauen Obergrenzen ändern sich zwischen den Versionen, bestätigen Sie also das aktuelle Maximum in Ihren Chart-Einstellungen." },
    { q: "Warum laden meine neuen Chart-Tabs weniger Kerzen als mein Hauptchart?", a: "Neue Tabs setzen unabhängig von Ihrer vorherigen Einstellung auf eine niedrige Mindest-Kerzenzahl zurück. Konfigurieren Sie einen Chart wie gewünscht, speichern Sie ihn als Vorlage, und wenden Sie diese Vorlage auf neue Tabs an, um die höhere Zahl beizubehalten." },
    { q: "Mein Tick-Chart scrollt nicht weit zurück, ist das derselbe Fehler?", a: "Nicht ganz. Tick-, Volumen- und Range-Charts rufen standardmäßig nur ein begrenztes Historie-Fenster ab, mit einer optionalen Zusatzberechtigung für erweiterte Tick-Daten. Nutzen Sie für tiefere Historie ein zeitbasiertes Intervall, oder prüfen Sie Ihre aktuellen Datenberechtigungen." },
    { q: "Bedeuten leere Lücken, dass meine Orders oder Positionen betroffen sind?", a: "Nein. Lücken sind rein ein Darstellungsproblem, Ihre Positionen, Orders und Ausführungen sind nicht betroffen. Wenn Sie über PickMyTrade automatisieren, läuft die Ausführung über Ihre Alerts, sodass ein lückenhafter Chart Ihren Orderfluss nie berührt." },
  ], es: [
    { q: "¿Por qué mis gráficos de Tradovate se cargan con huecos vacíos?", a: "Tradovate carga el historial del gráfico bajo demanda, solo obtiene las barras necesarias para la ventana visible y solicita más a medida que se desplaza. Cuando el servidor de datos está saturado (normalmente justo después de iniciar sesión), esas solicitudes se acumulan en cola y el gráfico muestra espacio en blanco hasta que se completan." },
    { q: "¿Cómo fuerzo la recarga de un gráfico de Tradovate sin esperar?", a: "Arrastre el gráfico hacia la izquierda dentro del rango vacío para activar de inmediato una solicitud de las barras faltantes. Si eso no lo soluciona, actualice la pestaña del navegador en Tradovate Web o reinicie la aplicación de escritorio para recargar todo el flujo de datos." },
    { q: "¿Existe un botón dedicado para actualizar los gráficos de Tradovate?", a: "No existe un control de un clic dedicado para &ldquo;actualizar solo este gráfico&rdquo;. Las formas fiables de forzar una recarga completa son desplazarse por el hueco, actualizar el navegador en Tradovate Web, o reiniciar la aplicación en escritorio y móvil." },
    { q: "¿Por qué se mueven mis indicadores cuando retrocedo en el tiempo?", a: "Los indicadores se calculan a partir de las barras actualmente cargadas. Si solo se precargó una pequeña cantidad de barras, una media móvil o el VWAP se recalcula y se desplaza a medida que llega más historial. Aumentar el ajuste Minimum Bars to Load para que se cargue suficiente historial de antemano detiene el salto." },
    { q: "¿Cuántas barras puede cargar un gráfico de Tradovate?", a: "El campo Minimum Bars to Load acepta varios miles de barras, y puede fijarlo lo bastante alto para cubrir períodos de referencia largos de los indicadores. Los límites exactos cambian entre versiones, así que confirme el máximo actual en la configuración de su gráfico." },
    { q: "¿Por qué mis nuevas pestañas de gráfico cargan menos barras que mi gráfico principal?", a: "Las pestañas nuevas vuelven a un número mínimo de barras bajo, sin importar su configuración anterior. Configure un gráfico como prefiera, guárdelo como plantilla y aplique esa plantilla a las pestañas nuevas para conservar el número más alto." },
    { q: "Mi gráfico de ticks no se desplaza muy atrás, ¿es el mismo error?", a: "No exactamente. Los gráficos de ticks, volumen y rango obtienen por defecto solo una ventana limitada de historial, con un complemento opcional para datos de ticks extendidos. Para un historial más profundo, use un intervalo basado en tiempo o verifique sus derechos de datos actuales." },
    { q: "¿Los huecos vacíos afectan a mis órdenes o posiciones?", a: "No. Los huecos son solo un problema de visualización del gráfico, sus posiciones, órdenes y ejecuciones no se ven afectadas. Si automatiza a través de PickMyTrade, la ejecución se basa en sus alertas, así que un gráfico con huecos nunca afecta a su flujo de órdenes." },
