---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "withdrawal-hold-5-10-days";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/debugging/${SLUG}`;

const META_TITLE = "Tradovate Withdrawal Hold: 5-10 Days on Deposits";
const META_DESCRIPTION =
  "Tradovate withdrawal hold explained: deposited funds are locked 5 days for ACH and 10 for wire. Learn how to time your withdrawal and avoid delays.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Tradovate-Auszahlungssperre: 5-10 Tage nach Einzahlungen", es: "Retención de retiros en Tradovate: 5-10 días tras los depósitos", fr: "Blocage des retraits Tradovate : 5 à 10 jours après les dépôts", it: "Blocco dei prelievi Tradovate: 5-10 giorni sui depositi" },
  dek: { en: "Your deposit is fully tradable, but Tradovate still won't let you withdraw it. That's a separate clock: 5 calendar days for an ACH payout, 10 for a wire, both counted from the day the deposit clears.", de: "Ihre Einzahlung ist voll handelbar, aber Tradovate lässt Sie sie trotzdem nicht auszahlen. Das ist eine separate Uhr: 5 Kalendertage für eine ACH-Auszahlung, 10 für eine Überweisung (Wire), beide ab dem Tag gezählt, an dem die Einzahlung verbucht wird.", es: "Su depósito es totalmente operable, pero Tradovate aún no le deja retirarlo. Es un reloj aparte: 5 días naturales para un pago por ACH, 10 para una transferencia bancaria (wire), ambos contados desde el día en que el depósito se acredita.", fr: "Votre dépôt est pleinement négociable, mais Tradovate ne vous laisse toujours pas le retirer. C'est une horloge distincte : 5 jours calendaires pour un paiement ACH, 10 pour un virement (wire), tous deux comptés à partir du jour où le dépôt est validé.", it: "Il suo deposito è pienamente negoziabile, ma Tradovate non le permette comunque di prelevarlo. È un orologio separato: 5 giorni di calendario per un pagamento ACH, 10 per un bonifico (wire), entrambi contati dal giorno in cui il deposito viene accreditato." },
  readTime: { en: "7 min read", de: "7 Min. Lesezeit", es: "Lectura de 7 min", fr: "Lecture : 7 min", it: "Lettura di 7 min" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "You funded your Tradovate account, the cash shows up in your balance, you placed a few trades with it, and now you try to pull money back out and Tradovate won't let you. The withdrawable figure sits lower than your balance, or the request just gets refused. This isn't a bug, and it isn't your bank dragging its feet. In 2026, Tradovate applies a <strong class='text-white'>withdrawal hold on deposited funds</strong>: cash you put in by ACH transfer or debit card is held for a set number of days <em>from the day it clears</em> before it's allowed to leave the account again. How long you wait depends on how you take the money out. ACH is the short hold; a wire is the long one. And this clock has nothing to do with the one-to-three days it took your deposit to clear for trading. Figure out which clock you're on and the whole thing becomes easy to plan around." },
    {
      type: "checklist",
      heading: "Quick Checklist for a Tradovate Withdrawal Hold",
      items: [
        "<strong class='text-white'>Check when the funds cleared, not when you deposited them.</strong> The hold counts from the clearing date, which is usually one to three business days after you sent the deposit.",
        "<strong class='text-white'>Choose ACH to get paid sooner.</strong> Deposited funds free up for an ACH withdrawal well before they free up for a wire.",
        "<strong class='text-white'>Only wiring out? Expect the longer wait.</strong> Wire withdrawals of recently deposited funds carry the longer hold.",
        "<strong class='text-white'>Don't confuse &ldquo;cleared for trading&rdquo; with &ldquo;cleared for withdrawal.&rdquo;</strong> Money can be fully tradable and still be inside its withdrawal hold.",
        "<strong class='text-white'>Watch the separate ACH deposit lock too.</strong> A fresh ACH deposit can also be locked for a few business days before it's even tradable, that's a different mechanism.",
        "<strong class='text-white'>One withdrawal request per 24 hours.</strong> Plan the timing. You can't fire off repeated attempts to &ldquo;test&rdquo; it.",
      ],
    },
    { type: "heading", text: "What the 5-10 Day Withdrawal Hold Means" },
    { type: "paragraph", html: "When you deposit by ACH transfer or debit card, Tradovate won't let that same money bounce straight back out. Per Tradovate's published policy, <strong class='text-white'>funds deposited by ACH transfer or debit card are held for five (5) calendar days from the day they clear before they can be withdrawn by ACH transfer</strong>, and <strong class='text-white'>held for ten (10) calendar days from the day they clear before they can be withdrawn by wire transfer</strong>. So the &ldquo;5-10 days&rdquo; in the headline is really two separate holds on the same deposit: a shorter one if you take the money out the way most people put it in (ACH), and a longer one if you insist on a wire." },
    { type: "paragraph", html: "The reason is fraud and reversal protection. ACH and debit deposits can be pulled back or bounced by the sending bank after the fact, whether that's an NSF reversal or a disputed charge. If Tradovate let you deposit and immediately wire the cash out, a reversed deposit would leave the account holding a negative balance. The hold gives the original deposit time to become irreversible before the money can leave by a faster, harder-to-claw-back route like a wire, which is exactly why the wire hold is the longer of the two." },
    { type: "paragraph", html: "The single most important thing to get straight is <em>when the clock starts</em>. The hold does <strong class='text-white'>not</strong> start when you click &ldquo;deposit.&rdquo; It starts the day the deposit <strong class='text-white'>clears</strong>. Tradovate's guidance is that deposited funds typically clear for trading within one to three business days of processing, and only once they clear does the 5-day (ACH) or 10-day (wire) withdrawal hold begin counting. So your real end-to-end wait is <em>clearing time plus the hold</em>, not the hold alone. These day counts are Tradovate's current stated policy; a broker can revise funding rules, so confirm the current figures in your account before you plan around a specific date." },
    { type: "heading", text: "Two Different Clocks: Trading Clearance vs Withdrawal Hold" },
    { type: "paragraph", html: "Almost every &ldquo;why can't I withdraw?&rdquo; headache comes from collapsing two separate waiting periods into one. They aren't the same:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Trading clearance</strong>, the one-to-three business days after processing before a deposit is usable to place trades. Once this passes, the money trades normally.",
        "<strong class='text-white'>Withdrawal hold</strong>, the 5 calendar days (ACH) or 10 calendar days (wire) <em>after clearing</em> before that same money can be sent back to your bank.",
      ],
    },
    { type: "paragraph", html: "Because trading clearance finishes first, you'll often have funds that are live and tradable but still frozen for withdrawal. That's expected behavior, not an error. Plan your funding around the <em>withdrawal</em> clock, not the <em>trading</em> clock." },
    { type: "heading", text: "Top Causes of a Blocked Tradovate Withdrawal in 2026" },
    { type: "heading", text: "1. The deposited funds simply haven't sat the full hold yet" },
    { type: "paragraph", html: "The most common cause is the plain one: you're inside the 5-day (ACH) or 10-day (wire) window measured from the clearing date. Nothing is broken. The money just isn't eligible to leave yet. Count forward from when the deposit cleared, not from when you sent it." },
    { type: "heading", text: "2. You're trying to wire out recently deposited money" },
    { type: "paragraph", html: "If your withdrawal gets refused for a wire but the funds would be available for an ACH withdrawal, you've hit the longer hold. A wire carries the 10-calendar-day hold on deposited funds; switching the payout to ACH can release the money noticeably sooner." },
    { type: "heading", text: "3. \"Cleared for trading\" fooled you into thinking it's withdrawable" },
    { type: "paragraph", html: "You traded with the cash, so you assumed it was fully yours to move. Trading clearance and withdrawal eligibility are different gates. Being tradable tells you nothing about whether the withdrawal hold has expired." },
    { type: "heading", text: "4. A fresh ACH deposit is still in its own deposit lock" },
    { type: "paragraph", html: "Separate from the withdrawal hold, a newly submitted ACH deposit can be <strong class='text-white'>locked</strong> for a few business days before it's even available. Tradovate holds new ACH deposits to guard against NSF clawbacks. If your deposit is brand new, you may be behind <em>two</em> gates: the deposit lock, then the withdrawal hold." },
    { type: "heading", text: "5. You hit a request limit or minimum, not a hold" },
    { type: "paragraph", html: "Not every refusal is the deposit hold. Tradovate allows one withdrawal request per 24-hour period, enforces a minimum withdrawal amount, and doesn't allow withdrawals from the mobile app at all. If your funds are past their hold but the request still won't go through, confirm you're on web or desktop, above the minimum, and haven't already requested a withdrawal today." },
    { type: "heading", text: "How to Work Around a Tradovate Withdrawal Hold: Step-by-Step" },
    { type: "heading", text: "Fix A, Pin Down the Exact Date Your Funds Clear" },
    {
      type: "steps",
      items: [
        { title: "Open the funding area", html: "Open Tradovate on web or desktop (not mobile) and go to your funding area. In current builds this lives under <strong class='text-white'>Application Settings &rsaquo; Transfers &amp; Payments</strong>." },
        { title: "Find the deposit in Transfer History", html: "Open <strong class='text-white'>Transfer History</strong> and find the deposit in question." },
        { title: "Note the clearing date", html: "Note the <strong class='text-white'>clearing date</strong>, the date the deposit became available, typically one to three business days after you sent it." },
        { title: "Add the hold to that date", html: "Add the hold to that clearing date: 5 calendar days for an ACH payout, 10 calendar days for a wire. That sum is the earliest you can withdraw." },
      ],
    },
    { type: "quote", html: "<strong class='text-white'>Heads up on labels:</strong> Tradovate's funding controls have shown up under names like <em>Transfers &amp; Payments</em> and <em>Fund Transfers</em> across versions, with the status view under <em>Transfer History</em>. The exact menu wording, and where the clearing date is displayed, can differ by platform version and by whether your account is prop-managed. Confirm the labels on your own screen before you start counting days." },
    { type: "heading", text: "Fix B, Withdraw by ACH Instead of Wire to Release Funds Sooner" },
    { type: "paragraph", html: "If you were planning to wire the money out, switching the payout method to ACH moves you from the longer hold to the shorter one on the same deposit. Unless you specifically need a same-day wire, taking the money out by ACH is the faster route for recently deposited funds." },
    { type: "heading", text: "Fix C, Request the Withdrawal Correctly Once the Hold Clears" },
    {
      type: "steps",
      items: [
        { title: "Click the Withdrawal button", html: "In <strong class='text-white'>Application Settings &rsaquo; Transfers &amp; Payments</strong>, click the <strong class='text-white'>Withdrawal</strong> button." },
        { title: "Select the account", html: "Select the Tradovate account to withdraw from (if you have more than one)." },
        { title: "Choose the destination", html: "Choose the destination, your linked bank for ACH, or your wire instructions." },
        { title: "Enter the amount and confirm", html: "Enter an amount at or above the minimum withdrawal, then click <strong class='text-white'>Confirm and Transfer</strong>." },
        { title: "Track it in Transfer History", html: "Track it under <strong class='text-white'>Transfer History</strong>, and remember you get one withdrawal request per 24 hours." },
      ],
    },
    { type: "heading", text: "Fix D, If the Money Is a Prop Payout, Go Through the Firm" },
    { type: "paragraph", html: "On an evaluation or funded prop account, payouts follow the firm's payout schedule and processor, not Tradovate's deposit-hold rule. Withdrawal timing, minimums, and eligibility all vary by firm and account size. Check your firm's current rules and request the payout through their dashboard rather than withdrawing directly in Tradovate." },
    { type: "heading", text: "Troubleshooting Table" },
    {
      type: "table",
      headers: ["What you see", "What it means", "Fix"],
      rows: [
        ["Withdrawable amount is lower than your cash balance", "Part of your balance is inside its withdrawal hold", "Wait out the 5-day (ACH) / 10-day (wire) hold from the clearing date"],
        ["Funds trade fine but won't withdraw", "Trading clearance passed; withdrawal hold has not", "Count the hold from the clearing date, not the deposit date"],
        ["Wire withdrawal refused, ACH would work", "You hit the longer 10-day wire hold", "Withdraw by ACH, or wait for the wire hold to expire"],
        ["Brand-new ACH deposit unavailable entirely", "Separate ACH deposit lock (a few business days)", "Wait out the deposit lock first, then the withdrawal hold"],
        ["\"One withdrawal per 24 hours\" style block", "You already requested a withdrawal today", "Wait 24 hours from the last request"],
        ["Can't find a withdrawal option on your phone", "Withdrawals can't be initiated from the mobile app", "Use the web or desktop app"],
        ["Amount rejected as too small", "Below Tradovate's minimum withdrawal", "Request at or above the current minimum (check your account)"],
      ],
    },
    { type: "heading", text: "Prevent This With PickMyTrade" },
    { type: "paragraph", html: "A withdrawal hold is a funding-timing rule, not something any tool removes. But most traders get burned by cash-flow whiplash: depositing, trading, and trying to pull money back out inside the same few days. PickMyTrade keeps your <em>trading</em> side running cleanly while you plan funding around the hold:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Reliable TradingView-to-Tradovate routing</strong>, your strategy fires on schedule, so performance doesn't hinge on last-minute deposits you'll want back immediately.",
        "<strong class='text-white'>Fixed and scaled sizing</strong>, trade the size your funded balance supports, so you're not over-depositing capital you'll need to withdraw right away.",
        "<strong class='text-white'>Multi-account sync</strong>, mirror one alert across accounts and manage capital deliberately instead of reactively.",
        "<strong class='text-white'>Hands-off execution</strong>, automation runs whether or not you're moving money that day, decoupling trading from your banking timeline.",
      ],
    },
    { type: "paragraph", html: "Plan deposits and withdrawals around the hold, let PickMyTrade handle the order flow, and the 5-to-10-day wait stops being a problem you even notice." },
  ], de: [
    { type: "paragraph",html: "Sie haben Ihr Tradovate-Konto finanziert, das Geld erscheint in Ihrem Kontostand, Sie haben damit ein paar Trades platziert, und jetzt versuchen Sie, Geld zurückzuholen, und Tradovate lässt es nicht zu. Der auszahlbare Betrag liegt unter Ihrem Kontostand, oder die Anfrage wird einfach abgelehnt. Das ist kein Fehler, und es liegt nicht an Ihrer trödelnden Bank. 2026 wendet Tradovate eine <strong class='text-white'>Auszahlungssperre auf eingezahlte Gelder</strong> an: Bargeld, das Sie per ACH-Überweisung oder Debitkarte einzahlen, wird eine bestimmte Anzahl von Tagen <em>ab dem Tag der Verbuchung</em> gehalten, bevor es das Konto wieder verlassen darf. Wie lange Sie warten, hängt davon ab, wie Sie das Geld abheben. ACH ist die kurze Sperre, ein Wire die lange. Und diese Uhr hat nichts mit den ein bis drei Tagen zu tun, die Ihre Einzahlung für die Handelsfreigabe brauchte. Wenn Sie wissen, auf welcher Uhr Sie sind, wird alles leicht planbar." },
    {
      type: "checklist",
      heading: "Kurz-Checkliste bei einer Tradovate-Auszahlungssperre",
      items: [
        "<strong class='text-white'>Prüfen Sie, wann die Gelder verbucht wurden, nicht wann Sie sie eingezahlt haben.</strong> Die Sperre zählt ab dem Verbuchungsdatum, das in der Regel ein bis drei Geschäftstage nach dem Absenden der Einzahlung liegt.",
        "<strong class='text-white'>Wählen Sie ACH, um früher ausgezahlt zu werden.</strong> Eingezahlte Gelder werden für eine ACH-Auszahlung deutlich früher frei als für einen Wire.",
        "<strong class='text-white'>Nur per Wire auszahlen? Rechnen Sie mit der längeren Wartezeit.</strong> Wire-Auszahlungen kürzlich eingezahlter Gelder unterliegen der längeren Sperre.",
        "<strong class='text-white'>Verwechseln Sie nicht &ldquo;für den Handel freigegeben&rdquo; mit &ldquo;für die Auszahlung freigegeben&rdquo;.</strong> Geld kann voll handelbar sein und trotzdem in seiner Auszahlungssperre liegen.",
        "<strong class='text-white'>Beachten Sie auch die separate ACH-Einzahlungssperre.</strong> Eine neue ACH-Einzahlung kann zusätzlich einige Geschäftstage gesperrt sein, bevor sie überhaupt handelbar ist, das ist ein anderer Mechanismus.",
        "<strong class='text-white'>Eine Auszahlungsanfrage pro 24 Stunden.</strong> Planen Sie das Timing. Sie können nicht wiederholt Versuche abfeuern, um es zu &ldquo;testen&rdquo;.",
      ],
    },
    { type: "heading",text: "Was die Auszahlungssperre von 5-10 Tagen bedeutet" },
    { type: "paragraph",html: "Wenn Sie per ACH-Überweisung oder Debitkarte einzahlen, lässt Tradovate dasselbe Geld nicht sofort wieder hinausfließen. Laut veröffentlichter Richtlinie von Tradovate werden <strong class='text-white'>per ACH-Überweisung oder Debitkarte eingezahlte Gelder ab dem Tag ihrer Verbuchung fünf (5) Kalendertage lang gehalten, bevor sie per ACH-Überweisung ausgezahlt werden können</strong>, und <strong class='text-white'>zehn (10) Kalendertage ab dem Tag ihrer Verbuchung gehalten, bevor sie per Wire-Überweisung ausgezahlt werden können</strong>. Die &ldquo;5-10 Tage&rdquo; in der Überschrift sind also in Wahrheit zwei getrennte Sperren auf dieselbe Einzahlung: eine kürzere, wenn Sie das Geld so abheben, wie die meisten es einzahlen (ACH), und eine längere, wenn Sie auf einem Wire bestehen." },
    { type: "paragraph",html: "Der Grund ist Betrugs- und Rückbuchungsschutz. ACH- und Debit-Einzahlungen können von der sendenden Bank nachträglich zurückgeholt oder zurückgebucht werden, sei es durch eine NSF-Rückbuchung oder eine bestrittene Belastung. Würde Tradovate Sie einzahlen und das Geld sofort per Wire abheben lassen, hätte das Konto bei einer rückgängig gemachten Einzahlung einen negativen Saldo. Die Sperre gibt der ursprünglichen Einzahlung Zeit, unumkehrbar zu werden, bevor das Geld über einen schnelleren, schwerer zurückholbaren Weg wie einen Wire abfließen kann, und genau deshalb ist die Wire-Sperre die längere der beiden." },
    { type: "paragraph",html: "Das Wichtigste ist, <em>wann die Uhr startet</em>. Die Sperre beginnt <strong class='text-white'>nicht</strong>, wenn Sie auf &ldquo;Einzahlen&rdquo; klicken. Sie beginnt an dem Tag, an dem die Einzahlung <strong class='text-white'>verbucht</strong> wird. Laut Tradovate werden Einzahlungen in der Regel innerhalb von ein bis drei Geschäftstagen nach der Verarbeitung für den Handel freigegeben, und erst dann beginnt die Auszahlungssperre von 5 Tagen (ACH) oder 10 Tagen (Wire) zu laufen. Ihre tatsächliche Gesamtwartezeit ist also <em>Verbuchungszeit plus Sperre</em>, nicht die Sperre allein. Diese Tageszahlen sind die aktuell angegebene Richtlinie von Tradovate, ein Broker kann Finanzierungsregeln ändern, bestätigen Sie daher die aktuellen Zahlen in Ihrem Konto, bevor Sie um ein bestimmtes Datum planen." },
    { type: "heading",text: "Zwei verschiedene Uhren: Handelsfreigabe vs. Auszahlungssperre" },
    { type: "paragraph",html: "Fast jedes &ldquo;Warum kann ich nicht auszahlen?&rdquo;-Problem entsteht dadurch, dass zwei getrennte Wartezeiten zu einer verschmolzen werden. Sie sind nicht dasselbe:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Handelsfreigabe</strong>, die ein bis drei Geschäftstage nach der Verarbeitung, bevor eine Einzahlung für Trades nutzbar ist. Danach wird das Geld normal gehandelt.",
        "<strong class='text-white'>Auszahlungssperre</strong>, die 5 Kalendertage (ACH) oder 10 Kalendertage (Wire) <em>nach der Verbuchung</em>, bevor dasselbe Geld an Ihre Bank zurückgesendet werden kann.",
      ],
    },
    { type: "paragraph",html: "Weil die Handelsfreigabe zuerst abgeschlossen ist, haben Sie oft Gelder, die live und handelbar, aber für die Auszahlung noch gesperrt sind. Das ist erwartetes Verhalten, kein Fehler. Planen Sie Ihre Finanzierung nach der <em>Auszahlungs</em>-Uhr, nicht nach der <em>Handels</em>-Uhr." },
    { type: "heading",text: "Häufigste Ursachen einer blockierten Tradovate-Auszahlung 2026" },
    { type: "heading",text: "1. Die eingezahlten Gelder haben die volle Sperre schlicht noch nicht durchlaufen" },
    { type: "paragraph",html: "Die häufigste Ursache ist die einfache: Sie befinden sich innerhalb des Fensters von 5 Tagen (ACH) oder 10 Tagen (Wire), gemessen ab dem Verbuchungsdatum. Nichts ist kaputt. Das Geld ist einfach noch nicht berechtigt, das Konto zu verlassen. Zählen Sie ab dem Zeitpunkt der Verbuchung der Einzahlung vorwärts, nicht ab dem Absenden." },
    { type: "heading",text: "2. Sie versuchen, kürzlich eingezahltes Geld per Wire auszuzahlen" },
    { type: "paragraph",html: "Wird Ihre Auszahlung per Wire abgelehnt, die Gelder wären aber für eine ACH-Auszahlung verfügbar, sind Sie auf die längere Sperre gestoßen. Ein Wire unterliegt der Sperre von 10 Kalendertagen auf eingezahlte Gelder, ein Wechsel der Auszahlung auf ACH kann das Geld spürbar früher freigeben." },
    { type: "heading",text: "3. \"Für den Handel freigegeben\" hat Sie glauben lassen, es sei auszahlbar" },
    { type: "paragraph",html: "Sie haben mit dem Geld gehandelt und angenommen, es gehöre Ihnen uneingeschränkt zur Verfügung. Handelsfreigabe und Auszahlungsberechtigung sind verschiedene Hürden. Dass etwas handelbar ist, sagt nichts darüber aus, ob die Auszahlungssperre abgelaufen ist." },
    { type: "heading",text: "4. Eine neue ACH-Einzahlung befindet sich noch in ihrer eigenen Einzahlungssperre" },
    { type: "paragraph",html: "Getrennt von der Auszahlungssperre kann eine neu übermittelte ACH-Einzahlung einige Geschäftstage lang <strong class='text-white'>gesperrt</strong> sein, bevor sie überhaupt verfügbar ist. Tradovate hält neue ACH-Einzahlungen zurück, um sich vor NSF-Rückforderungen zu schützen. Ist Ihre Einzahlung brandneu, stehen Sie möglicherweise hinter <em>zwei</em> Hürden: der Einzahlungssperre, dann der Auszahlungssperre." },
    { type: "heading",text: "5. Sie haben ein Anfragelimit oder einen Mindestbetrag erreicht, keine Sperre" },
    { type: "paragraph",html: "Nicht jede Ablehnung ist die Einzahlungssperre. Tradovate erlaubt eine Auszahlungsanfrage pro 24-Stunden-Zeitraum, erzwingt einen Mindestauszahlungsbetrag und erlaubt Auszahlungen über die mobile App überhaupt nicht. Sind Ihre Gelder über ihre Sperre hinaus, die Anfrage geht aber trotzdem nicht durch, prüfen Sie, ob Sie in der Web- oder Desktop-App sind, über dem Minimum liegen und heute nicht bereits eine Auszahlung beantragt haben." },
    { type: "heading",text: "So umgehen Sie eine Tradovate-Auszahlungssperre: Schritt für Schritt" },
    { type: "heading",text: "Lösung A: Das genaue Datum bestimmen, an dem Ihre Gelder verbucht werden" },
    {
      type: "steps",
      items: [
        { title: "Den Finanzierungsbereich öffnen", html: "Öffnen Sie Tradovate im Web oder auf dem Desktop (nicht mobil) und gehen Sie zu Ihrem Finanzierungsbereich. In aktuellen Versionen befindet er sich unter <strong class='text-white'>Application Settings &rsaquo; Transfers &amp; Payments</strong>." },
        { title: "Die Einzahlung im Transfer History finden", html: "Öffnen Sie <strong class='text-white'>Transfer History</strong> und suchen Sie die betreffende Einzahlung." },
        { title: "Das Verbuchungsdatum notieren", html: "Notieren Sie das <strong class='text-white'>Verbuchungsdatum</strong>, das Datum, an dem die Einzahlung verfügbar wurde, in der Regel ein bis drei Geschäftstage nach dem Absenden." },
        { title: "Die Sperre zu diesem Datum addieren", html: "Addieren Sie die Sperre zu diesem Verbuchungsdatum: 5 Kalendertage für eine ACH-Auszahlung, 10 Kalendertage für einen Wire. Diese Summe ist der früheste Zeitpunkt, zu dem Sie auszahlen können." },
      ],
    },
    { type: "quote",html: "<strong class='text-white'>Hinweis zu den Bezeichnungen:</strong> Die Finanzierungssteuerung von Tradovate erschien je nach Version unter Namen wie <em>Transfers &amp; Payments</em> und <em>Fund Transfers</em>, mit der Statusansicht unter <em>Transfer History</em>. Die genaue Menüformulierung und der Ort, an dem das Verbuchungsdatum angezeigt wird, können je nach Plattformversion und danach variieren, ob Ihr Konto von einer Prop Firm verwaltet wird. Bestätigen Sie die Bezeichnungen auf Ihrem eigenen Bildschirm, bevor Sie Tage zu zählen beginnen." },
    { type: "heading",text: "Lösung B: Per ACH statt per Wire auszahlen, um Gelder früher freizugeben" },
    { type: "paragraph",html: "Wenn Sie das Geld per Wire abheben wollten, versetzt Sie der Wechsel der Auszahlungsmethode auf ACH bei derselben Einzahlung von der längeren zur kürzeren Sperre. Sofern Sie nicht ausdrücklich einen Wire am selben Tag benötigen, ist die Auszahlung per ACH der schnellere Weg für kürzlich eingezahlte Gelder." },
    { type: "heading",text: "Lösung C: Die Auszahlung korrekt beantragen, sobald die Sperre abgelaufen ist" },
    {
      type: "steps",
      items: [
        { title: "Auf die Schaltfläche Withdrawal klicken", html: "Klicken Sie unter <strong class='text-white'>Application Settings &rsaquo; Transfers &amp; Payments</strong> auf die Schaltfläche <strong class='text-white'>Withdrawal</strong>." },
        { title: "Das Konto auswählen", html: "Wählen Sie das Tradovate-Konto, von dem Sie auszahlen möchten (falls Sie mehr als eines haben)." },
        { title: "Das Ziel wählen", html: "Wählen Sie das Ziel, Ihre verknüpfte Bank für ACH oder Ihre Wire-Anweisungen." },
        { title: "Den Betrag eingeben und bestätigen", html: "Geben Sie einen Betrag in Höhe des Mindestauszahlungsbetrags oder darüber ein und klicken Sie dann auf <strong class='text-white'>Confirm and Transfer</strong>." },
        { title: "Im Transfer History verfolgen", html: "Verfolgen Sie es unter <strong class='text-white'>Transfer History</strong> und denken Sie daran, dass Sie eine Auszahlungsanfrage pro 24 Stunden haben." },
      ],
    },
    { type: "heading",text: "Lösung D: Handelt es sich um eine Prop-Auszahlung, gehen Sie über die Firma" },
    { type: "paragraph",html: "Bei einem Evaluierungs- oder Funded-Prop-Konto folgen Auszahlungen dem Auszahlungsplan und dem Zahlungsabwickler der Firma, nicht der Einzahlungssperre von Tradovate. Auszahlungszeitpunkt, Mindestbeträge und Berechtigung variieren je nach Firma und Kontogröße. Prüfen Sie die aktuellen Regeln Ihrer Firma und beantragen Sie die Auszahlung über deren Dashboard, statt direkt in Tradovate auszuzahlen." },
    { type: "heading",text: "Tabelle zur Fehlerbehebung" },
    { type: "table", headers: ["Was Sie sehen","Was es bedeutet","Lösung"], rows: [
      ["Auszahlbarer Betrag liegt unter Ihrem Kontostand","Ein Teil Ihres Guthabens liegt in der Auszahlungssperre","Die Sperre von 5 Tagen (ACH) / 10 Tagen (Wire) ab dem Verbuchungsdatum abwarten"],
      ["Gelder sind handelbar, lassen sich aber nicht auszahlen","Handelsfreigabe erfolgt; Auszahlungssperre noch nicht","Die Sperre ab dem Verbuchungsdatum zählen, nicht ab dem Einzahlungsdatum"],
      ["Wire-Auszahlung abgelehnt, ACH würde funktionieren","Sie haben die längere 10-Tage-Wire-Sperre erreicht","Per ACH auszahlen oder den Ablauf der Wire-Sperre abwarten"],
      ["Brandneue ACH-Einzahlung überhaupt nicht verfügbar","Separate ACH-Einzahlungssperre (einige Geschäftstage)","Zuerst die Einzahlungssperre abwarten, dann die Auszahlungssperre"],
      ["Blockade im Stil von \"Eine Auszahlung pro 24 Stunden\"","Sie haben heute bereits eine Auszahlung beantragt","24 Stunden ab der letzten Anfrage warten"],
      ["Keine Auszahlungsoption auf Ihrem Handy zu finden","Auszahlungen können nicht über die mobile App veranlasst werden","Die Web- oder Desktop-App verwenden"],
      ["Betrag als zu klein abgelehnt","Unter dem Mindestauszahlungsbetrag von Tradovate","In Höhe des aktuellen Minimums oder darüber beantragen (in Ihrem Konto prüfen)"],
    ] },
    { type: "heading",text: "Vermeiden Sie das mit PickMyTrade" },
    { type: "paragraph",html: "Eine Auszahlungssperre ist eine Regel zum Finanzierungszeitpunkt, die kein Tool aufheben kann. Aber die meisten Trader werden von Cashflow-Schwankungen erwischt: Einzahlen, Handeln und innerhalb weniger Tage versuchen, Geld zurückzuholen. PickMyTrade hält Ihre <em>Handels</em>-Seite sauber am Laufen, während Sie Ihre Finanzierung um die Sperre herum planen:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Zuverlässiges Routing von TradingView zu Tradovate</strong>, Ihre Strategie feuert planmäßig, sodass die Performance nicht von kurzfristigen Einzahlungen abhängt, die Sie sofort zurückhaben möchten.",
        "<strong class='text-white'>Feste und skalierte Positionsgrößen</strong>, handeln Sie die Größe, die Ihr finanzierter Kontostand trägt, damit Sie nicht zu viel Kapital einzahlen, das Sie sofort wieder auszahlen müssen.",
        "<strong class='text-white'>Multi-Account-Synchronisierung</strong>, spiegeln Sie einen Alert über mehrere Konten und steuern Sie Kapital bewusst statt reaktiv.",
        "<strong class='text-white'>Hands-off-Ausführung</strong>, die Automatisierung läuft, ob Sie an diesem Tag Geld bewegen oder nicht, und entkoppelt den Handel von Ihrem Bankzeitplan.",
      ],
    },
    { type: "paragraph",html: "Planen Sie Einzahlungen und Auszahlungen um die Sperre herum, überlassen Sie PickMyTrade den Orderfluss, und die Wartezeit von 5 bis 10 Tagen ist kein Problem mehr, das Sie überhaupt bemerken." },
  ], es: [
    { type: "paragraph",html: "Usted financió su cuenta de Tradovate, el efectivo aparece en su saldo, realizó unas cuantas operaciones con él y ahora intenta sacar dinero y Tradovate no se lo permite. La cifra retirable queda por debajo de su saldo, o la solicitud simplemente se rechaza. Esto no es un error, ni su banco retrasándose. En 2026, Tradovate aplica una <strong class='text-white'>retención de retiro sobre los fondos depositados</strong>: el efectivo que ingresa por transferencia ACH o tarjeta de débito se retiene durante un número determinado de días <em>desde el día en que se acredita</em> antes de poder salir de nuevo de la cuenta. Cuánto espera depende de cómo retire el dinero. ACH es la retención corta; un wire es la larga. Y este reloj no tiene nada que ver con los uno a tres días que tardó su depósito en acreditarse para operar. Una vez que sepa en qué reloj está, todo resulta fácil de planificar." },
    {
      type: "checklist",
      heading: "Lista de verificación rápida para una retención de retiro de Tradovate",
      items: [
        "<strong class='text-white'>Compruebe cuándo se acreditaron los fondos, no cuándo los depositó.</strong> La retención cuenta desde la fecha de acreditación, que suele ser uno a tres días hábiles después de enviar el depósito.",
        "<strong class='text-white'>Elija ACH para cobrar antes.</strong> Los fondos depositados se liberan para un retiro por ACH mucho antes que para un wire.",
        "<strong class='text-white'>¿Solo retira por wire? Espere la espera más larga.</strong> Los retiros por wire de fondos depositados recientemente conllevan la retención más larga.",
        "<strong class='text-white'>No confunda &ldquo;autorizado para operar&rdquo; con &ldquo;autorizado para retirar&rdquo;.</strong> El dinero puede ser totalmente operable y seguir dentro de su retención de retiro.",
        "<strong class='text-white'>Vigile también el bloqueo aparte de los depósitos ACH.</strong> Un depósito ACH reciente también puede estar bloqueado unos días hábiles antes de ser siquiera operable, es un mecanismo distinto.",
        "<strong class='text-white'>Una solicitud de retiro cada 24 horas.</strong> Planifique el momento. No puede lanzar intentos repetidos para &ldquo;probarlo&rdquo;.",
      ],
    },
    { type: "heading",text: "Qué significa la retención de retiro de 5-10 días" },
    { type: "paragraph",html: "Cuando deposita por transferencia ACH o tarjeta de débito, Tradovate no deja que ese mismo dinero rebote directamente hacia fuera. Según la política publicada de Tradovate, <strong class='text-white'>los fondos depositados por transferencia ACH o tarjeta de débito se retienen cinco (5) días naturales desde el día en que se acreditan antes de poder retirarse por transferencia ACH</strong>, y <strong class='text-white'>se retienen diez (10) días naturales desde el día en que se acreditan antes de poder retirarse por transferencia wire</strong>. Así que los &ldquo;5-10 días&rdquo; del titular son en realidad dos retenciones distintas sobre el mismo depósito: una más corta si saca el dinero como la mayoría lo ingresa (ACH) y una más larga si insiste en un wire." },
    { type: "paragraph",html: "El motivo es la protección contra fraude y reversiones. Los depósitos ACH y con débito pueden ser reclamados o devueltos por el banco emisor a posteriori, ya sea por una reversión NSF o un cargo disputado. Si Tradovate le dejara depositar y retirar de inmediato el efectivo por wire, un depósito revertido dejaría la cuenta con saldo negativo. La retención da al depósito original tiempo para volverse irreversible antes de que el dinero pueda salir por una vía más rápida y más difícil de recuperar como un wire, y precisamente por eso la retención por wire es la más larga de las dos." },
    { type: "paragraph",html: "Lo más importante es tener claro <em>cuándo empieza el reloj</em>. La retención <strong class='text-white'>no</strong> empieza cuando hace clic en &ldquo;depositar&rdquo;. Empieza el día en que el depósito se <strong class='text-white'>acredita</strong>. La orientación de Tradovate es que los fondos depositados suelen acreditarse para operar en uno a tres días hábiles tras su procesamiento, y solo cuando se acreditan empieza a contar la retención de retiro de 5 días (ACH) o 10 días (wire). Así que su espera real de principio a fin es <em>el tiempo de acreditación más la retención</em>, no solo la retención. Estos plazos en días son la política vigente declarada de Tradovate; un bróker puede modificar las reglas de financiación, así que confirme las cifras actuales en su cuenta antes de planificar en torno a una fecha concreta." },
    { type: "heading",text: "Dos relojes distintos: autorización para operar frente a retención de retiro" },
    { type: "paragraph",html: "Casi todos los quebraderos de cabeza del tipo &ldquo;¿por qué no puedo retirar?&rdquo; vienen de fundir dos periodos de espera distintos en uno. No son lo mismo:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Autorización para operar</strong>, los uno a tres días hábiles tras el procesamiento antes de que un depósito sea utilizable para operar. Una vez pasado, el dinero se opera con normalidad.",
        "<strong class='text-white'>Retención de retiro</strong>, los 5 días naturales (ACH) o 10 días naturales (wire) <em>tras la acreditación</em> antes de que ese mismo dinero pueda enviarse de vuelta a su banco.",
      ],
    },
    { type: "paragraph",html: "Como la autorización para operar termina primero, a menudo tendrá fondos activos y operables pero aún congelados para el retiro. Es un comportamiento esperado, no un error. Planifique su financiación en torno al reloj de <em>retiro</em>, no al de <em>operativa</em>." },
    { type: "heading",text: "Principales causas de un retiro bloqueado en Tradovate en 2026" },
    { type: "heading",text: "1. Los fondos depositados simplemente aún no han cumplido la retención completa" },
    { type: "paragraph",html: "La causa más común es la más simple: está dentro de la ventana de 5 días (ACH) o 10 días (wire) medida desde la fecha de acreditación. No hay nada roto. El dinero simplemente aún no es elegible para salir. Cuente hacia delante desde que el depósito se acreditó, no desde que lo envió." },
    { type: "heading",text: "2. Intenta retirar por wire dinero depositado recientemente" },
    { type: "paragraph",html: "Si su retiro es rechazado para un wire pero los fondos estarían disponibles para un retiro por ACH, ha topado con la retención más larga. Un wire conlleva la retención de 10 días naturales sobre fondos depositados; cambiar el pago a ACH puede liberar el dinero notablemente antes." },
    { type: "heading",text: "3. \"Autorizado para operar\" le hizo pensar que era retirable" },
    { type: "paragraph",html: "Operó con el efectivo, así que supuso que era totalmente suyo para moverlo. La autorización para operar y la elegibilidad para retirar son compuertas distintas. Que sea operable no dice nada sobre si la retención de retiro ha vencido." },
    { type: "heading",text: "4. Un depósito ACH reciente aún está en su propio bloqueo de depósito" },
    { type: "paragraph",html: "Aparte de la retención de retiro, un depósito ACH recién enviado puede estar <strong class='text-white'>bloqueado</strong> unos días hábiles antes de estar siquiera disponible. Tradovate retiene los nuevos depósitos ACH para protegerse de devoluciones NSF. Si su depósito es muy reciente, puede estar detrás de <em>dos</em> compuertas: el bloqueo de depósito y luego la retención de retiro." },
    { type: "heading",text: "5. Alcanzó un límite de solicitudes o un mínimo, no una retención" },
    { type: "paragraph",html: "No todo rechazo es la retención de depósito. Tradovate permite una solicitud de retiro por periodo de 24 horas, aplica un importe mínimo de retiro y no permite retiros desde la app móvil en absoluto. Si sus fondos han superado su retención pero la solicitud sigue sin prosperar, confirme que está en la web o el escritorio, por encima del mínimo y que no ha solicitado ya un retiro hoy." },
    { type: "heading",text: "Cómo gestionar una retención de retiro de Tradovate: paso a paso" },
    { type: "heading",text: "Solución A: determine la fecha exacta en que se acreditan sus fondos" },
    {
      type: "steps",
      items: [
        { title: "Abra el área de financiación", html: "Abra Tradovate en la web o el escritorio (no en el móvil) y vaya a su área de financiación. En las versiones actuales está en <strong class='text-white'>Application Settings &rsaquo; Transfers &amp; Payments</strong>." },
        { title: "Localice el depósito en Transfer History", html: "Abra <strong class='text-white'>Transfer History</strong> y localice el depósito en cuestión." },
        { title: "Anote la fecha de acreditación", html: "Anote la <strong class='text-white'>fecha de acreditación</strong>, la fecha en que el depósito quedó disponible, normalmente uno a tres días hábiles después de enviarlo." },
        { title: "Sume la retención a esa fecha", html: "Sume la retención a esa fecha de acreditación: 5 días naturales para un pago por ACH, 10 días naturales para un wire. Esa suma es lo más pronto que puede retirar." },
      ],
    },
    { type: "quote",html: "<strong class='text-white'>Aviso sobre las etiquetas:</strong> los controles de financiación de Tradovate han aparecido con nombres como <em>Transfers &amp; Payments</em> y <em>Fund Transfers</em> según la versión, con la vista de estado en <em>Transfer History</em>. La redacción exacta del menú y el lugar donde se muestra la fecha de acreditación pueden diferir según la versión de la plataforma y según si su cuenta está gestionada por una prop firm. Confirme las etiquetas en su propia pantalla antes de empezar a contar días." },
    { type: "heading",text: "Solución B: retire por ACH en lugar de wire para liberar fondos antes" },
    { type: "paragraph",html: "Si planeaba retirar el dinero por wire, cambiar el método de pago a ACH le pasa de la retención más larga a la más corta sobre el mismo depósito. A menos que necesite específicamente un wire el mismo día, retirar por ACH es la vía más rápida para fondos depositados recientemente." },
    { type: "heading",text: "Solución C: solicite el retiro correctamente una vez vencida la retención" },
    {
      type: "steps",
      items: [
        { title: "Haga clic en el botón Withdrawal", html: "En <strong class='text-white'>Application Settings &rsaquo; Transfers &amp; Payments</strong>, haga clic en el botón <strong class='text-white'>Withdrawal</strong>." },
        { title: "Seleccione la cuenta", html: "Seleccione la cuenta de Tradovate desde la que retirar (si tiene más de una)." },
        { title: "Elija el destino", html: "Elija el destino, su banco vinculado para ACH o sus instrucciones de wire." },
        { title: "Introduzca el importe y confirme", html: "Introduzca un importe igual o superior al retiro mínimo y luego haga clic en <strong class='text-white'>Confirm and Transfer</strong>." },
        { title: "Haga el seguimiento en Transfer History", html: "Haga el seguimiento en <strong class='text-white'>Transfer History</strong> y recuerde que tiene una solicitud de retiro cada 24 horas." },
      ],
    },
    { type: "heading",text: "Solución D: si el dinero es un pago de prop firm, pase por la firma" },
    { type: "paragraph",html: "En una cuenta prop de evaluación o fondeada, los pagos siguen el calendario de pagos y el procesador de la firma, no la regla de retención de depósitos de Tradovate. El momento del retiro, los mínimos y la elegibilidad varían según la firma y el tamaño de la cuenta. Consulte las reglas vigentes de su firma y solicite el pago a través de su panel en lugar de retirar directamente en Tradovate." },
    { type: "heading",text: "Tabla de solución de problemas" },
    { type: "table", headers: ["Lo que ve","Qué significa","Solución"], rows: [
      ["El importe retirable es menor que su saldo en efectivo","Parte de su saldo está dentro de su retención de retiro","Espere la retención de 5 días (ACH) / 10 días (wire) desde la fecha de acreditación"],
      ["Los fondos se operan bien pero no se pueden retirar","La autorización para operar pasó; la retención de retiro no","Cuente la retención desde la fecha de acreditación, no desde la fecha del depósito"],
      ["Retiro por wire rechazado, ACH funcionaría","Ha topado con la retención de wire más larga de 10 días","Retire por ACH, o espere a que venza la retención del wire"],
      ["Un depósito ACH recién enviado no está disponible en absoluto","Bloqueo aparte de depósito ACH (unos días hábiles)","Espere primero el bloqueo de depósito y luego la retención de retiro"],
      ["Bloqueo del estilo \"un retiro cada 24 horas\"","Ya solicitó un retiro hoy","Espere 24 horas desde la última solicitud"],
      ["No encuentra una opción de retiro en el teléfono","Los retiros no pueden iniciarse desde la app móvil","Use la aplicación web o de escritorio"],
      ["Importe rechazado por demasiado pequeño","Por debajo del retiro mínimo de Tradovate","Solicite un importe igual o superior al mínimo actual (compruébelo en su cuenta)"],
    ] },
    { type: "heading",text: "Evítelo con PickMyTrade" },
    { type: "paragraph",html: "Una retención de retiro es una regla de plazos de financiación, no algo que ninguna herramienta elimine. Pero a la mayoría de los traders les perjudica el vaivén del flujo de caja: depositar, operar e intentar sacar el dinero en el mismo puñado de días. PickMyTrade mantiene su lado <em>operativo</em> funcionando limpiamente mientras usted planifica la financiación en torno a la retención:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Enrutamiento fiable de TradingView a Tradovate</strong>, su estrategia se dispara según lo previsto, de modo que el rendimiento no depende de depósitos de última hora que querrá recuperar de inmediato.",
        "<strong class='text-white'>Tamaño fijo y escalado</strong>, opere el tamaño que respalda su saldo financiado, para no sobredepositar capital que necesitará retirar enseguida.",
        "<strong class='text-white'>Sincronización multicuenta</strong>, replique una alerta en varias cuentas y gestione el capital de forma deliberada en lugar de reactiva.",
        "<strong class='text-white'>Ejecución sin intervención</strong>, la automatización funciona se mueva o no dinero ese día, desacoplando la operativa de su calendario bancario.",
      ],
    },
    { type: "paragraph",html: "Planifique depósitos y retiros en torno a la retención, deje que PickMyTrade gestione el flujo de órdenes y la espera de 5 a 10 días dejará de ser un problema que ni siquiera note." },
  ], fr: [
    { type: "paragraph",html: "Vous avez approvisionné votre compte Tradovate, l'argent apparaît dans votre solde, vous avez passé quelques trades avec, et maintenant vous essayez de retirer de l'argent et Tradovate ne vous le permet pas. Le montant retirable est inférieur à votre solde, ou la demande est simplement refusée. Ce n'est pas un bug, et ce n'est pas votre banque qui traîne. En 2026, Tradovate applique un <strong class='text-white'>blocage de retrait sur les fonds déposés</strong> : l'argent que vous versez par virement ACH ou carte de débit est retenu pendant un nombre de jours déterminé <em>à partir du jour de sa validation</em> avant d'être autorisé à quitter de nouveau le compte. La durée d'attente dépend de la façon dont vous retirez l'argent. L'ACH est le blocage court ; un wire est le long. Et cette horloge n'a rien à voir avec les un à trois jours qu'a pris votre dépôt pour être validé pour le trading. Une fois que vous savez sur quelle horloge vous êtes, tout devient facile à planifier." },
    {
      type: "checklist",
      heading: "Liste de contrôle rapide pour un blocage de retrait Tradovate",
      items: [
        "<strong class='text-white'>Vérifiez quand les fonds ont été validés, pas quand vous les avez déposés.</strong> Le blocage se compte à partir de la date de validation, généralement un à trois jours ouvrés après l'envoi du dépôt.",
        "<strong class='text-white'>Choisissez l'ACH pour être payé plus tôt.</strong> Les fonds déposés sont libérés pour un retrait ACH bien avant de l'être pour un wire.",
        "<strong class='text-white'>Vous ne retirez que par wire ? Attendez-vous à l'attente la plus longue.</strong> Les retraits par wire de fonds récemment déposés sont soumis au blocage le plus long.",
        "<strong class='text-white'>Ne confondez pas &ldquo;validé pour le trading&rdquo; avec &ldquo;validé pour le retrait&rdquo;.</strong> L'argent peut être pleinement négociable et se trouver encore dans son blocage de retrait.",
        "<strong class='text-white'>Surveillez aussi le verrouillage distinct des dépôts ACH.</strong> Un dépôt ACH récent peut aussi être verrouillé quelques jours ouvrés avant même d'être négociable, c'est un mécanisme différent.",
        "<strong class='text-white'>Une demande de retrait par tranche de 24 heures.</strong> Planifiez le timing. Vous ne pouvez pas lancer des tentatives répétées pour &ldquo;tester&rdquo;.",
      ],
    },
    { type: "heading",text: "Ce que signifie le blocage de retrait de 5 à 10 jours" },
    { type: "paragraph",html: "Lorsque vous déposez par virement ACH ou carte de débit, Tradovate ne laisse pas ce même argent ressortir aussitôt. Selon la politique publiée de Tradovate, <strong class='text-white'>les fonds déposés par virement ACH ou carte de débit sont bloqués cinq (5) jours calendaires à partir du jour de leur validation avant de pouvoir être retirés par virement ACH</strong>, et <strong class='text-white'>bloqués dix (10) jours calendaires à partir du jour de leur validation avant de pouvoir être retirés par virement wire</strong>. Les &ldquo;5 à 10 jours&rdquo; du titre sont donc en réalité deux blocages distincts sur le même dépôt : un plus court si vous retirez l'argent comme la plupart des gens le versent (ACH), et un plus long si vous insistez pour un wire." },
    { type: "paragraph",html: "La raison est la protection contre la fraude et les annulations. Les dépôts ACH et par carte de débit peuvent être repris ou rejetés par la banque émettrice après coup, qu'il s'agisse d'une annulation NSF ou d'un débit contesté. Si Tradovate vous laissait déposer puis virer immédiatement l'argent par wire, un dépôt annulé laisserait le compte avec un solde négatif. Le blocage laisse au dépôt initial le temps de devenir irréversible avant que l'argent puisse sortir par une voie plus rapide et plus difficile à récupérer comme un wire, et c'est précisément pourquoi le blocage wire est le plus long des deux." },
    { type: "paragraph",html: "Le plus important est de bien saisir <em>quand l'horloge démarre</em>. Le blocage ne démarre <strong class='text-white'>pas</strong> quand vous cliquez sur &ldquo;déposer&rdquo;. Il démarre le jour où le dépôt est <strong class='text-white'>validé</strong>. La ligne de Tradovate est que les fonds déposés sont généralement validés pour le trading dans un délai d'un à trois jours ouvrés après le traitement, et ce n'est qu'une fois validés que le blocage de retrait de 5 jours (ACH) ou 10 jours (wire) commence à compter. Votre attente réelle de bout en bout est donc <em>le délai de validation plus le blocage</em>, pas le blocage seul. Ces nombres de jours correspondent à la politique actuelle déclarée de Tradovate ; un courtier peut réviser ses règles de financement, confirmez donc les chiffres actuels dans votre compte avant de planifier autour d'une date précise." },
    { type: "heading",text: "Deux horloges différentes : autorisation de trading et blocage de retrait" },
    { type: "paragraph",html: "Presque tous les casse-têtes du type &ldquo;pourquoi ne puis-je pas retirer ?&rdquo; viennent du fait de fondre deux délais d'attente distincts en un seul. Ils ne sont pas identiques :" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Autorisation de trading</strong>, les un à trois jours ouvrés après le traitement avant qu'un dépôt soit utilisable pour passer des trades. Une fois ce délai écoulé, l'argent se négocie normalement.",
        "<strong class='text-white'>Blocage de retrait</strong>, les 5 jours calendaires (ACH) ou 10 jours calendaires (wire) <em>après la validation</em> avant que ce même argent puisse être renvoyé vers votre banque.",
      ],
    },
    { type: "paragraph",html: "Comme l'autorisation de trading se termine en premier, vous aurez souvent des fonds actifs et négociables mais encore gelés pour le retrait. C'est un comportement attendu, pas une erreur. Planifiez votre financement autour de l'horloge de <em>retrait</em>, pas de celle du <em>trading</em>." },
    { type: "heading",text: "Principales causes d'un retrait Tradovate bloqué en 2026" },
    { type: "heading",text: "1. Les fonds déposés n'ont tout simplement pas encore purgé le blocage complet" },
    { type: "paragraph",html: "La cause la plus courante est la plus simple : vous êtes dans la fenêtre de 5 jours (ACH) ou 10 jours (wire) mesurée à partir de la date de validation. Rien n'est cassé. L'argent n'est simplement pas encore éligible à sortir. Comptez à partir du moment où le dépôt a été validé, pas de celui où vous l'avez envoyé." },
    { type: "heading",text: "2. Vous essayez de retirer par wire de l'argent récemment déposé" },
    { type: "paragraph",html: "Si votre retrait est refusé pour un wire alors que les fonds seraient disponibles pour un retrait ACH, vous avez atteint le blocage le plus long. Un wire est soumis au blocage de 10 jours calendaires sur les fonds déposés ; passer le paiement en ACH peut libérer l'argent nettement plus tôt." },
    { type: "heading",text: "3. \"Validé pour le trading\" vous a fait croire que c'était retirable" },
    { type: "paragraph",html: "Vous avez tradé avec l'argent, vous avez donc supposé qu'il était entièrement à vous pour le déplacer. L'autorisation de trading et l'éligibilité au retrait sont deux barrières différentes. Être négociable ne vous dit rien sur l'expiration du blocage de retrait." },
    { type: "heading",text: "4. Un dépôt ACH récent est encore dans son propre verrouillage de dépôt" },
    { type: "paragraph",html: "Indépendamment du blocage de retrait, un dépôt ACH tout juste soumis peut être <strong class='text-white'>verrouillé</strong> quelques jours ouvrés avant même d'être disponible. Tradovate retient les nouveaux dépôts ACH pour se prémunir des reprises NSF. Si votre dépôt est tout neuf, vous pouvez être derrière <em>deux</em> barrières : le verrouillage de dépôt, puis le blocage de retrait." },
    { type: "heading",text: "5. Vous avez atteint une limite de demandes ou un minimum, pas un blocage" },
    { type: "paragraph",html: "Tous les refus ne sont pas le blocage de dépôt. Tradovate autorise une demande de retrait par période de 24 heures, impose un montant minimum de retrait et n'autorise pas du tout les retraits depuis l'application mobile. Si vos fonds ont dépassé leur blocage mais que la demande n'aboutit toujours pas, vérifiez que vous êtes sur le web ou le bureau, au-dessus du minimum, et que vous n'avez pas déjà demandé un retrait aujourd'hui." },
    { type: "heading",text: "Comment contourner un blocage de retrait Tradovate : pas à pas" },
    { type: "heading",text: "Correctif A : déterminer la date exacte de validation de vos fonds" },
    {
      type: "steps",
      items: [
        { title: "Ouvrez la zone de financement", html: "Ouvrez Tradovate sur le web ou le bureau (pas le mobile) et accédez à votre zone de financement. Dans les versions actuelles, elle se trouve sous <strong class='text-white'>Application Settings &rsaquo; Transfers &amp; Payments</strong>." },
        { title: "Retrouvez le dépôt dans Transfer History", html: "Ouvrez <strong class='text-white'>Transfer History</strong> et retrouvez le dépôt en question." },
        { title: "Notez la date de validation", html: "Notez la <strong class='text-white'>date de validation</strong>, la date à laquelle le dépôt est devenu disponible, généralement un à trois jours ouvrés après son envoi." },
        { title: "Ajoutez le blocage à cette date", html: "Ajoutez le blocage à cette date de validation : 5 jours calendaires pour un paiement ACH, 10 jours calendaires pour un wire. Cette somme est la date la plus proche à laquelle vous pouvez retirer." },
      ],
    },
    { type: "quote",html: "<strong class='text-white'>Attention aux libellés :</strong> les commandes de financement de Tradovate sont apparues sous des noms comme <em>Transfers &amp; Payments</em> et <em>Fund Transfers</em> selon les versions, avec la vue de statut sous <em>Transfer History</em>. Le libellé exact du menu et l'endroit où la date de validation est affichée peuvent différer selon la version de la plateforme et selon que votre compte est géré par une prop firm ou non. Confirmez les libellés sur votre propre écran avant de commencer à compter les jours." },
    { type: "heading",text: "Correctif B : retirer par ACH plutôt que par wire pour libérer les fonds plus tôt" },
    { type: "paragraph",html: "Si vous comptiez retirer l'argent par wire, passer le mode de paiement en ACH vous fait passer du blocage le plus long au plus court sur le même dépôt. Sauf si vous avez précisément besoin d'un wire le jour même, retirer par ACH est la voie la plus rapide pour des fonds récemment déposés." },
    { type: "heading",text: "Correctif C : demander correctement le retrait une fois le blocage levé" },
    {
      type: "steps",
      items: [
        { title: "Cliquez sur le bouton Withdrawal", html: "Dans <strong class='text-white'>Application Settings &rsaquo; Transfers &amp; Payments</strong>, cliquez sur le bouton <strong class='text-white'>Withdrawal</strong>." },
        { title: "Sélectionnez le compte", html: "Sélectionnez le compte Tradovate depuis lequel retirer (si vous en avez plusieurs)." },
        { title: "Choisissez la destination", html: "Choisissez la destination, votre banque liée pour l'ACH, ou vos instructions de wire." },
        { title: "Saisissez le montant et confirmez", html: "Saisissez un montant égal ou supérieur au retrait minimum, puis cliquez sur <strong class='text-white'>Confirm and Transfer</strong>." },
        { title: "Suivez-le dans Transfer History", html: "Suivez-le sous <strong class='text-white'>Transfer History</strong>, et rappelez-vous que vous disposez d'une demande de retrait par tranche de 24 heures." },
      ],
    },
    { type: "heading",text: "Correctif D : si l'argent est un paiement de prop firm, passez par la société" },
    { type: "paragraph",html: "Sur un compte prop d'évaluation ou financé, les paiements suivent le calendrier de paiement et le processeur de la société, pas la règle de blocage de dépôt de Tradovate. Le délai de retrait, les minimums et l'éligibilité varient selon la société et la taille du compte. Consultez les règles actuelles de votre société et demandez le paiement via son tableau de bord plutôt que de retirer directement dans Tradovate." },
    { type: "heading",text: "Tableau de dépannage" },
    { type: "table", headers: ["Ce que vous voyez","Ce que cela signifie","Correctif"], rows: [
      ["Le montant retirable est inférieur à votre solde en espèces","Une partie de votre solde est dans son blocage de retrait","Attendre le blocage de 5 jours (ACH) / 10 jours (wire) à partir de la date de validation"],
      ["Les fonds se négocient bien mais ne se retirent pas","L'autorisation de trading est passée ; le blocage de retrait non","Compter le blocage à partir de la date de validation, pas de la date de dépôt"],
      ["Retrait par wire refusé, l'ACH fonctionnerait","Vous avez atteint le blocage wire plus long de 10 jours","Retirer par ACH, ou attendre l'expiration du blocage wire"],
      ["Dépôt ACH tout neuf entièrement indisponible","Verrouillage distinct de dépôt ACH (quelques jours ouvrés)","Attendre d'abord le verrouillage de dépôt, puis le blocage de retrait"],
      ["Blocage de type \"un retrait par 24 heures\"","Vous avez déjà demandé un retrait aujourd'hui","Attendre 24 heures après la dernière demande"],
      ["Impossible de trouver une option de retrait sur votre téléphone","Les retraits ne peuvent pas être initiés depuis l'application mobile","Utiliser l'application web ou de bureau"],
      ["Montant rejeté car trop faible","En dessous du retrait minimum de Tradovate","Demander un montant égal ou supérieur au minimum actuel (vérifiez dans votre compte)"],
    ] },
    { type: "heading",text: "Évitez cela avec PickMyTrade" },
    { type: "paragraph",html: "Un blocage de retrait est une règle de calendrier de financement, pas quelque chose qu'un outil supprime. Mais la plupart des traders se font piéger par les à-coups de trésorerie : déposer, trader et essayer de retirer l'argent dans les mêmes quelques jours. PickMyTrade fait tourner proprement votre côté <em>trading</em> pendant que vous planifiez le financement autour du blocage :" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Routage fiable de TradingView vers Tradovate</strong>, votre stratégie se déclenche comme prévu, de sorte que la performance ne dépend pas de dépôts de dernière minute que vous voudrez récupérer aussitôt.",
        "<strong class='text-white'>Taille fixe et échelonnée</strong>, tradez la taille que supporte votre solde financé, afin de ne pas surdéposer un capital que vous devrez retirer tout de suite.",
        "<strong class='text-white'>Synchronisation multi-comptes</strong>, répliquez une alerte sur plusieurs comptes et gérez le capital de façon délibérée plutôt que réactive.",
        "<strong class='text-white'>Exécution sans intervention</strong>, l'automatisation tourne que vous déplaciez ou non de l'argent ce jour-là, découplant le trading de votre calendrier bancaire.",
      ],
    },
    { type: "paragraph",html: "Planifiez dépôts et retraits autour du blocage, laissez PickMyTrade gérer le flux d'ordres, et l'attente de 5 à 10 jours cesse d'être un problème que vous remarquez même." },
  ], it: [
    { type: "paragraph",html: "Ha finanziato il suo account Tradovate, il denaro compare nel suo saldo, ha piazzato qualche trade e ora prova a ritirare denaro e Tradovate non glielo permette. L'importo prelevabile è inferiore al saldo, oppure la richiesta viene semplicemente rifiutata. Non è un bug, e non è la sua banca che tergiversa. Nel 2026 Tradovate applica un <strong class='text-white'>blocco dei prelievi sui fondi depositati</strong>: il denaro che versa tramite bonifico ACH o carta di debito viene trattenuto per un determinato numero di giorni <em>dal giorno in cui viene accreditato</em> prima di poter uscire di nuovo dall'account. Quanto attende dipende da come preleva il denaro. L'ACH è il blocco breve; un wire è quello lungo. E questo orologio non ha nulla a che fare con l'uno-tre giorni che il suo deposito ha impiegato per essere accreditato per il trading. Una volta capito su quale orologio si trova, tutto diventa facile da pianificare." },
    {
      type: "checklist",
      heading: "Checklist rapida per un blocco dei prelievi Tradovate",
      items: [
        "<strong class='text-white'>Controlli quando i fondi sono stati accreditati, non quando li ha depositati.</strong> Il blocco decorre dalla data di accredito, che di solito è uno-tre giorni lavorativi dopo l'invio del deposito.",
        "<strong class='text-white'>Scelga l'ACH per essere pagato prima.</strong> I fondi depositati si liberano per un prelievo ACH ben prima che per un wire.",
        "<strong class='text-white'>Preleva solo tramite wire? Si aspetti l'attesa più lunga.</strong> I prelievi wire di fondi depositati di recente sono soggetti al blocco più lungo.",
        "<strong class='text-white'>Non confonda &ldquo;accreditato per il trading&rdquo; con &ldquo;accreditato per il prelievo&rdquo;.</strong> Il denaro può essere pienamente negoziabile e trovarsi comunque nel suo blocco del prelievo.",
        "<strong class='text-white'>Tenga d'occhio anche il blocco separato dei depositi ACH.</strong> Un deposito ACH recente può anche essere bloccato per alcuni giorni lavorativi prima di essere negoziabile, è un meccanismo diverso.",
        "<strong class='text-white'>Una richiesta di prelievo ogni 24 ore.</strong> Pianifichi i tempi. Non può lanciare tentativi ripetuti per &ldquo;testarlo&rdquo;.",
      ],
    },
    { type: "heading",text: "Cosa significa il blocco dei prelievi di 5-10 giorni" },
    { type: "paragraph",html: "Quando deposita tramite bonifico ACH o carta di debito, Tradovate non lascia che lo stesso denaro rimbalzi subito fuori. Secondo la politica pubblicata da Tradovate, <strong class='text-white'>i fondi depositati tramite bonifico ACH o carta di debito vengono trattenuti per cinque (5) giorni di calendario dal giorno in cui vengono accreditati prima di poter essere prelevati tramite bonifico ACH</strong>, e <strong class='text-white'>trattenuti per dieci (10) giorni di calendario dal giorno in cui vengono accreditati prima di poter essere prelevati tramite bonifico wire</strong>. I &ldquo;5-10 giorni&rdquo; del titolo sono quindi in realtà due blocchi separati sullo stesso deposito: uno più breve se preleva il denaro come la maggior parte lo versa (ACH) e uno più lungo se insiste per un wire." },
    { type: "paragraph",html: "Il motivo è la protezione da frodi e storni. I depositi ACH e con carta di debito possono essere ritirati o stornati a posteriori dalla banca mittente, che si tratti di uno storno NSF o di un addebito contestato. Se Tradovate le permettesse di depositare e immediatamente inviare il denaro via wire, un deposito stornato lascerebbe l'account con un saldo negativo. Il blocco dà al deposito originale il tempo di diventare irreversibile prima che il denaro possa uscire per una via più rapida e più difficile da recuperare come un wire, ed è esattamente per questo che il blocco wire è il più lungo dei due." },
    { type: "paragraph",html: "La cosa più importante da chiarire è <em>quando parte l'orologio</em>. Il blocco <strong class='text-white'>non</strong> parte quando clicca su &ldquo;deposita&rdquo;. Parte il giorno in cui il deposito viene <strong class='text-white'>accreditato</strong>. L'indicazione di Tradovate è che i fondi depositati vengono in genere accreditati per il trading entro uno-tre giorni lavorativi dall'elaborazione, e solo una volta accreditati inizia a decorrere il blocco del prelievo di 5 giorni (ACH) o 10 giorni (wire). Quindi la sua attesa reale complessiva è <em>il tempo di accredito più il blocco</em>, non il solo blocco. Questi conteggi di giorni sono la politica attuale dichiarata da Tradovate; un broker può rivedere le regole di finanziamento, quindi confermi le cifre attuali nel suo account prima di pianificare attorno a una data specifica." },
    { type: "heading",text: "Due orologi diversi: autorizzazione al trading vs blocco del prelievo" },
    { type: "paragraph",html: "Quasi ogni mal di testa del tipo &ldquo;perché non posso prelevare?&rdquo; nasce dal fondere due periodi di attesa separati in uno. Non sono la stessa cosa:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Autorizzazione al trading</strong>, l'uno-tre giorni lavorativi dopo l'elaborazione prima che un deposito sia utilizzabile per piazzare trade. Superato questo, il denaro si negozia normalmente.",
        "<strong class='text-white'>Blocco del prelievo</strong>, i 5 giorni di calendario (ACH) o 10 giorni di calendario (wire) <em>dopo l'accredito</em> prima che quello stesso denaro possa essere rinviato alla sua banca.",
      ],
    },
    { type: "paragraph",html: "Poiché l'autorizzazione al trading termina per prima, avrà spesso fondi attivi e negoziabili ma ancora congelati per il prelievo. È un comportamento atteso, non un errore. Pianifichi il finanziamento attorno all'orologio del <em>prelievo</em>, non a quello del <em>trading</em>." },
    { type: "heading",text: "Principali cause di un prelievo Tradovate bloccato nel 2026" },
    { type: "heading",text: "1. I fondi depositati non hanno semplicemente ancora scontato l'intero blocco" },
    { type: "paragraph",html: "La causa più comune è la più semplice: si trova all'interno della finestra di 5 giorni (ACH) o 10 giorni (wire) misurata dalla data di accredito. Non c'è nulla di rotto. Il denaro semplicemente non è ancora idoneo a uscire. Conti in avanti da quando il deposito è stato accreditato, non da quando l'ha inviato." },
    { type: "heading",text: "2. Sta cercando di prelevare via wire denaro depositato di recente" },
    { type: "paragraph",html: "Se il suo prelievo viene rifiutato per un wire ma i fondi sarebbero disponibili per un prelievo ACH, ha incontrato il blocco più lungo. Un wire comporta il blocco di 10 giorni di calendario sui fondi depositati; passare il pagamento ad ACH può liberare il denaro notevolmente prima." },
    { type: "heading",text: "3. \"Accreditato per il trading\" le ha fatto credere che fosse prelevabile" },
    { type: "paragraph",html: "Ha operato con il denaro, quindi ha dato per scontato che fosse interamente suo da muovere. Autorizzazione al trading e idoneità al prelievo sono barriere diverse. Essere negoziabile non dice nulla sul fatto che il blocco del prelievo sia scaduto." },
    { type: "heading",text: "4. Un deposito ACH recente è ancora nel suo blocco di deposito" },
    { type: "paragraph",html: "Separatamente dal blocco del prelievo, un deposito ACH appena inviato può essere <strong class='text-white'>bloccato</strong> per alcuni giorni lavorativi prima di essere disponibile. Tradovate trattiene i nuovi depositi ACH per proteggersi da recuperi NSF. Se il suo deposito è nuovissimo, potrebbe trovarsi dietro <em>due</em> barriere: il blocco del deposito, poi il blocco del prelievo." },
    { type: "heading",text: "5. Ha raggiunto un limite di richieste o un minimo, non un blocco" },
    { type: "paragraph",html: "Non ogni rifiuto è il blocco del deposito. Tradovate consente una richiesta di prelievo per periodo di 24 ore, applica un importo minimo di prelievo e non consente affatto prelievi dall'app mobile. Se i suoi fondi hanno superato il blocco ma la richiesta non va comunque a buon fine, verifichi di essere sul web o sul desktop, al di sopra del minimo e di non aver già richiesto un prelievo oggi." },
    { type: "heading",text: "Come aggirare un blocco dei prelievi Tradovate: passo dopo passo" },
    { type: "heading",text: "Correzione A: individuare la data esatta in cui i suoi fondi vengono accreditati" },
    {
      type: "steps",
      items: [
        { title: "Apra l'area di finanziamento", html: "Apra Tradovate sul web o sul desktop (non su mobile) e vada alla sua area di finanziamento. Nelle build attuali si trova in <strong class='text-white'>Application Settings &rsaquo; Transfers &amp; Payments</strong>." },
        { title: "Trovi il deposito in Transfer History", html: "Apra <strong class='text-white'>Transfer History</strong> e trovi il deposito in questione." },
        { title: "Annoti la data di accredito", html: "Annoti la <strong class='text-white'>data di accredito</strong>, la data in cui il deposito è diventato disponibile, in genere uno-tre giorni lavorativi dopo l'invio." },
        { title: "Aggiunga il blocco a quella data", html: "Aggiunga il blocco a quella data di accredito: 5 giorni di calendario per un pagamento ACH, 10 giorni di calendario per un wire. Quella somma è il momento più vicino in cui può prelevare." },
      ],
    },
    { type: "quote",html: "<strong class='text-white'>Attenzione alle etichette:</strong> i controlli di finanziamento di Tradovate sono apparsi con nomi come <em>Transfers &amp; Payments</em> e <em>Fund Transfers</em> a seconda delle versioni, con la vista di stato sotto <em>Transfer History</em>. La formulazione esatta del menu e il punto in cui viene mostrata la data di accredito possono differire a seconda della versione della piattaforma e del fatto che il suo account sia gestito da una prop firm. Confermi le etichette sul suo schermo prima di iniziare a contare i giorni." },
    { type: "heading",text: "Correzione B: prelevare tramite ACH anziché wire per liberare i fondi prima" },
    { type: "paragraph",html: "Se aveva intenzione di inviare il denaro via wire, passare il metodo di pagamento ad ACH la sposta dal blocco più lungo a quello più breve sullo stesso deposito. A meno che non abbia specificamente bisogno di un wire in giornata, prelevare tramite ACH è la via più rapida per fondi depositati di recente." },
    { type: "heading",text: "Correzione C: richiedere correttamente il prelievo una volta scaduto il blocco" },
    {
      type: "steps",
      items: [
        { title: "Clicchi sul pulsante Withdrawal", html: "In <strong class='text-white'>Application Settings &rsaquo; Transfers &amp; Payments</strong>, clicchi sul pulsante <strong class='text-white'>Withdrawal</strong>." },
        { title: "Selezioni l'account", html: "Selezioni l'account Tradovate da cui prelevare (se ne ha più di uno)." },
        { title: "Scelga la destinazione", html: "Scelga la destinazione, la sua banca collegata per l'ACH o le sue istruzioni wire." },
        { title: "Inserisca l'importo e confermi", html: "Inserisca un importo pari o superiore al prelievo minimo, poi clicchi su <strong class='text-white'>Confirm and Transfer</strong>." },
        { title: "Lo monitori in Transfer History", html: "Lo monitori in <strong class='text-white'>Transfer History</strong> e ricordi che ha una richiesta di prelievo ogni 24 ore." },
      ],
    },
    { type: "heading",text: "Correzione D: se il denaro è un payout prop, passi attraverso la società" },
    { type: "paragraph",html: "Su un account prop di valutazione o finanziato, i payout seguono il calendario dei pagamenti e il processore della società, non la regola di blocco dei depositi di Tradovate. Tempistica del prelievo, minimi e idoneità variano tutti a seconda della società e della dimensione dell'account. Controlli le regole attuali della sua società e richieda il payout tramite la loro dashboard anziché prelevare direttamente in Tradovate." },
    { type: "heading",text: "Tabella di risoluzione dei problemi" },
    { type: "table", headers: ["Cosa vede","Cosa significa","Correzione"], rows: [
      ["L'importo prelevabile è inferiore al saldo in contanti","Parte del suo saldo è all'interno del blocco del prelievo","Attendere il blocco di 5 giorni (ACH) / 10 giorni (wire) dalla data di accredito"],
