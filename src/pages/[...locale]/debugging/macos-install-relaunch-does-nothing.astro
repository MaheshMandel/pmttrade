---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "macos-install-relaunch-does-nothing";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/debugging/${SLUG}`;

const META_TITLE = "Tradovate Mac 'Install and Relaunch' Does Nothing";
const META_DESCRIPTION =
  "Mac update button does nothing when you click Install and Relaunch? Here's why the in-app updater stalls and how to install the latest build fast.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Tradovate auf dem Mac: „Install and Relaunch“ tut nichts", es: "«Install and Relaunch» de Tradovate en Mac no hace nada", fr: "« Install and Relaunch » de Tradovate sur Mac ne fait rien", it: "«Install and Relaunch» di Tradovate su Mac non fa nulla" },
  dek: { en: "Click Install and Relaunch on the Mac desktop app and nothing happens, no progress bar, no restart, no error. Here's why the in-app updater goes quiet on macOS and the manual install that always works.", de: "Sie klicken in der Mac-Desktop-App auf Install and Relaunch, und nichts passiert, keine Fortschrittsanzeige, kein Neustart, kein Fehler. Hier erfahren Sie, warum der In-App-Updater unter macOS verstummt, und welche manuelle Installation immer funktioniert.", es: "Hace clic en Install and Relaunch en la app de escritorio para Mac y no pasa nada: ni barra de progreso, ni reinicio, ni error. Aquí le explicamos por qué el actualizador integrado se queda en silencio en macOS y la instalación manual que siempre funciona.", fr: "Vous cliquez sur Install and Relaunch dans l'application de bureau Mac et rien ne se passe : ni barre de progression, ni redémarrage, ni erreur. Voici pourquoi le programme de mise à jour intégré reste muet sous macOS, et l'installation manuelle qui fonctionne toujours.", it: "Fa clic su Install and Relaunch nell'app desktop per Mac e non succede nulla: nessuna barra di avanzamento, nessun riavvio, nessun errore. Ecco perché l'updater integrato resta muto su macOS e l'installazione manuale che funziona sempre." },
  readTime: { en: "7 min read", de: "7 Min. Lesezeit", es: "Lectura de 7 min", fr: "Lecture : 7 min", it: "Lettura di 7 min" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "The Tradovate desktop app pops up a little banner telling you a new version is ready, with a friendly <strong class='text-white'>Install and Relaunch</strong> button. You click it, expecting the app to swap itself for the update and restart. Instead, nothing happens. No progress bar, no restart, no error. The banner might vanish for a second and come right back on the next launch, still nagging you to install a version that never actually installs. On macOS specifically, that button can be completely inert." },
    { type: "paragraph", html: "Good news: this is a cosmetic dead end, not a broken account or a corrupted install. The updater is failing quietly for reasons that are well understood on the Mac, and the workaround is simple and reliable. <strong class='text-white'>Skip the in-app button entirely, download the current desktop build straight from Tradovate's site, and drop it into your Applications folder.</strong> Below is the exact sequence, why the button stalls, and the one setting that makes future updates actually stick." },
    {
      type: "checklist",
      heading: "Quick checklist to get on the latest version",
      items: [
        "<strong class='text-white'>Don't fight the button.</strong> If Install and Relaunch does nothing once, it'll keep doing nothing. Move on to a manual install.",
        "<strong class='text-white'>Download the current Mac build</strong> from the official devices page at tradovate.com/devices (the &ldquo;Download Mac&rdquo; link).",
        "<strong class='text-white'>Quit the app fully</strong> with Command-Q before you replace it. A running copy can't overwrite itself.",
        "<strong class='text-white'>Drag Tradovate into Applications</strong>, replacing the old copy when macOS prompts.",
        "<strong class='text-white'>Launch it from Applications</strong>, not from the disk image or Downloads. This is what lets future updates work.",
        "<strong class='text-white'>Approve it in Gatekeeper</strong> if macOS flags a newly downloaded app: right-click, Open, confirm once.",
        "<strong class='text-white'>Manage open trades from the web platform or mobile</strong> while the desktop app is closed. Your orders stay live on Tradovate's servers.",
      ],
    },
    { type: "heading", text: "What's Actually Happening When the Button Dies" },
    { type: "paragraph", html: "The Tradovate desktop app ships with an auto-updater, the same kind of built-in mechanism most cross-platform desktop apps use. When a new version lands, the updater downloads the package in the background and then offers to install it and relaunch. On Windows that quiet in-place swap usually goes off without a hitch. On macOS it's fussier, and there are a few common reasons the click lands on a dead button." },
    { type: "paragraph", html: "The big one is <strong class='text-white'>where the app is running from</strong>. macOS auto-updaters generally can only rewrite an app that lives in the <strong class='text-white'>Applications</strong> folder. If you ever opened Tradovate straight out of the mounted disk image, or left it sitting in Downloads or on the Desktop and ran it from there, the updater has no writable home to install into, so it silently gives up. No permission prompt, no error dialog, just a button that does nothing." },
    { type: "paragraph", html: "The second is <strong class='text-white'>Gatekeeper and the quarantine flag</strong>. Anything you download gets tagged with a quarantine attribute that macOS uses to gate what's allowed to run, and that flag, along with the app's code signature and folder permissions, can block the updater from quietly replacing files. A third, more mundane cause: the update package didn't finish downloading cleanly, so there's nothing valid to install even though the button is showing." },
    { type: "paragraph", html: "None of this touches your trading. The desktop app is just a window into an account that lives entirely on Tradovate's servers, so wiping the old app and dropping in a fresh one is completely safe." },
    { type: "quote", html: "The fastest route past this is to stop treating the in-app updater as the only way to update. A manual download from the official site is the same version the button was trying to fetch, just installed by hand in a way macOS is happy with." },
    { type: "heading", text: "Fix It: Download the Build and Install It by Hand" },
    {
      type: "steps",
      items: [
        { title: "Download the current Mac build", html: "Open a browser and go to <strong class='text-white'>tradovate.com/devices</strong>. That page lists every way to run the platform: web, Windows, Mac, and the mobile apps. Click <strong class='text-white'>Download Mac</strong> to pull the current desktop build. Grab it from Tradovate's own site rather than a third-party download mirror, so you know it's a current, untampered installer. The file comes down as a disk image (a <code>.dmg</code>) in your Downloads folder." },
        { title: "Quit the old app completely", html: "Before you replace anything, fully quit the running copy of Tradovate. Clicking the red close button on the window isn't enough; the app is often still alive in the background. Use <strong class='text-white'>Command-Q</strong> with Tradovate focused, or right-click its icon in the Dock and choose <strong class='text-white'>Quit</strong>. A copy that's still running can't be overwritten, and trying to replace it while it's open is a common reason the swap fails halfway." },
        { title: "Drag the new app into Applications", html: "Double-click the downloaded <code>.dmg</code> to mount it. A window opens showing the <strong class='text-white'>Tradovate</strong> app icon, usually next to a shortcut to your <strong class='text-white'>Applications</strong> folder. Drag the Tradovate icon onto the Applications folder. When macOS asks whether you want to replace the existing item, choose <strong class='text-white'>Replace</strong> so the new build overwrites the old one. This is the single most important detail on the whole page: install it <em>into Applications</em>, and run it from there." },
        { title: "Open it from Applications and sign in", html: "Open your <strong class='text-white'>Applications</strong> folder and launch Tradovate from there. Sign in with your Tradovate or prop-firm credentials, and your accounts, layouts, and positions sync straight back down from the server. That's the whole fix. You're on the current build, and because the app now lives in the right place, the next update it offers has a real chance of installing on its own." },
      ],
    },
    { type: "paragraph", html: "That same devices page also links the streaming web platform, which always runs the newest version in your browser with nothing to download, a solid fallback if the updater keeps giving you trouble." },
    { type: "paragraph", html: "When the copy finishes, eject the disk image (drag it to the Trash or click the eject arrow next to it in Finder), and delete the <code>.dmg</code> from Downloads so you don't accidentally run the app out of a mounted image again later." },
    { type: "heading", text: "If macOS Blocks the New App" },
    { type: "paragraph", html: "Because you just downloaded it, macOS may throw up a Gatekeeper warning the first time you open it, something like &ldquo;Tradovate can't be opened because it is from an unidentified developer&rdquo; or &ldquo;macOS cannot verify the developer.&rdquo; That's expected for a freshly downloaded app and it's a one-time approval, not a sign anything's wrong." },
    { type: "paragraph", html: "To clear it, <strong class='text-white'>right-click (or Control-click) the Tradovate app in Applications and choose Open</strong>, then confirm <strong class='text-white'>Open</strong> in the dialog. Opening it this way tells macOS you trust it, and you won't be asked again. If the standard double-click still refuses to launch, go to <strong class='text-white'>System Settings &rarr; Privacy &amp; Security</strong>, scroll to the Security section, and look for an <strong class='text-white'>Open Anyway</strong> button tied to Tradovate. Click that, and it'll launch. The exact wording of these prompts shifts between macOS releases, so if a label reads a little differently on your version, look for the closest equivalent that lets you approve the app." },
    { type: "heading", text: "Why the In-App Updater Keeps Failing (and How to Stop It)" },
    { type: "paragraph", html: "If you've been fighting a dead Install and Relaunch button for a while, the odds are very good the old app was never in Applications to begin with. Plenty of people run a Mac app for months straight out of the disk image or the Downloads folder without realizing it, and everything works fine right up until the day an update needs to install. From a read-only or non-standard location, the updater simply can't rewrite the app, so every future update quietly no-ops." },
    { type: "paragraph", html: "Moving the app into Applications once, as in the steps above, fixes that going forward. From its proper home, the updater has somewhere writable to install into, and the flow starts behaving. If it ever stalls again, you know the escape hatch: quit, download the current build, and drop it in." },
    { type: "heading", text: "Manage Your Risk While the App Is Closed" },
    { type: "paragraph", html: "Quitting the desktop app to swap it does not cancel a single order. Every stop and target you've placed is resting on Tradovate's servers and keeps working no matter what's open on your Mac. If you're in a live position when you go to update, don't leave yourself blind: open the <strong class='text-white'>Tradovate web platform</strong> in a browser or the <strong class='text-white'>mobile app</strong> on your phone, and you'll see the identical account with full control to modify or flatten. Treat the desktop app as one of several windows into your account, never the only door in." },
    { type: "heading", text: "Troubleshooting Table" },
    {
      type: "table",
      headers: ["Symptom", "Likely cause", "Fix"],
      rows: [
        ["Install and Relaunch does nothing, no error", "App isn't in Applications, so the updater can't write", "Download the current build from tradovate.com/devices and drag it into Applications"],
        ["Update banner returns on every launch", "Update never actually installed", "Quit fully with Command-Q, then do a clean manual install"],
        ["&ldquo;Can't be opened / unidentified developer&rdquo;", "Gatekeeper flagging a freshly downloaded app", "Right-click the app &rarr; Open &rarr; confirm, or use Privacy &amp; Security &rarr; Open Anyway"],
        ["Replace step fails or hangs", "Old copy still running in the background", "Command-Q or Dock &rarr; Quit before replacing, then retry"],
        ["Every future update fails the same way", "App is being run from the disk image or Downloads", "Install into Applications and always launch it from there"],
        ["App won't run at all after the update", "Unsupported or outdated macOS version", "Confirm your macOS meets the current minimum and update the OS if needed"],
      ],
    },
    { type: "heading", text: "Keep Trading Even When the Desktop App Won't Cooperate" },
    { type: "paragraph", html: "If a stuck updater has ever left you second-guessing whether a trade went through, the answer is to stop leaning on any one client staying open. PickMyTrade links your TradingView alerts straight to Tradovate and runs the execution on our servers, so your strategy fires whether or not the desktop app is open, updated, or even installed:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Server-side execution</strong>, alerts route from TradingView to Tradovate through our infrastructure, so a closed or mid-update desktop app never stops an entry or an exit from going through.",
        "<strong class='text-white'>Device independence</strong>, nothing hinges on the Mac app being on the latest build. Your trades fire from the alert, not from whichever client happens to be running.",
        "<strong class='text-white'>Stops and targets that stick</strong>, SL/TP defined in the alert are placed on Tradovate no matter what app you have open, so protection doesn't depend on a working updater.",
        "<strong class='text-white'>Multi-account sync</strong>, mirror the same orders across every connected account at once, so no account sits unmanaged while you reinstall a desktop app.",
      ],
    },
  ], de: [
    { type: "paragraph",html: "Die Tradovate-Desktop-App blendet ein kleines Banner ein, das Ihnen mitteilt, dass eine neue Version bereitsteht, mit einer freundlichen Schaltfläche <strong class='text-white'>Install and Relaunch</strong>. Sie klicken darauf und erwarten, dass sich die App durch das Update ersetzt und neu startet. Stattdessen passiert nichts. Keine Fortschrittsanzeige, kein Neustart, kein Fehler. Das Banner verschwindet vielleicht für eine Sekunde und kommt beim nächsten Start sofort wieder und drängt Sie weiter, eine Version zu installieren, die sich nie wirklich installiert. Speziell unter macOS kann diese Schaltfläche völlig wirkungslos sein." },
    { type: "paragraph",html: "Die gute Nachricht: Das ist eine kosmetische Sackgasse, kein defektes Konto und keine beschädigte Installation. Der Updater scheitert lautlos aus Gründen, die auf dem Mac gut bekannt sind, und die Umgehung ist einfach und zuverlässig. <strong class='text-white'>Überspringen Sie die In-App-Schaltfläche komplett, laden Sie den aktuellen Desktop-Build direkt von der Tradovate-Website herunter und legen Sie ihn in Ihren Ordner Applications.</strong> Unten finden Sie die genaue Abfolge, warum die Schaltfläche hängt, und die eine Einstellung, mit der künftige Updates tatsächlich haften bleiben." },
    {
      type: "checklist",
      heading: "Kurze Checkliste für die neueste Version",
      items: [
        "<strong class='text-white'>Kämpfen Sie nicht gegen die Schaltfläche.</strong> Wenn Install and Relaunch einmal nichts tut, wird es weiter nichts tun. Gehen Sie zur manuellen Installation über.",
        "<strong class='text-white'>Laden Sie den aktuellen Mac-Build herunter</strong> von der offiziellen Geräteseite unter tradovate.com/devices (der Link &ldquo;Download Mac&rdquo;).",
        "<strong class='text-white'>Beenden Sie die App vollständig</strong> mit Command-Q, bevor Sie sie ersetzen. Eine laufende Kopie kann sich nicht selbst überschreiben.",
        "<strong class='text-white'>Ziehen Sie Tradovate in Applications</strong> und ersetzen Sie die alte Kopie, wenn macOS fragt.",
        "<strong class='text-white'>Starten Sie sie aus Applications</strong>, nicht aus dem Disk-Image oder aus Downloads. Nur so funktionieren künftige Updates.",
        "<strong class='text-white'>Geben Sie sie in Gatekeeper frei</strong>, wenn macOS eine neu heruntergeladene App markiert: Rechtsklick, Open, einmal bestätigen.",
        "<strong class='text-white'>Verwalten Sie offene Trades über die Webplattform oder mobil</strong>, solange die Desktop-App geschlossen ist. Ihre Orders bleiben auf den Servern von Tradovate aktiv.",
      ],
    },
    { type: "heading",text: "Was tatsächlich passiert, wenn die Schaltfläche tot ist" },
    { type: "paragraph",html: "Die Tradovate-Desktop-App wird mit einem Auto-Updater ausgeliefert, derselben Art eingebauten Mechanismus, den die meisten plattformübergreifenden Desktop-Apps verwenden. Wenn eine neue Version erscheint, lädt der Updater das Paket im Hintergrund herunter und bietet dann an, es zu installieren und neu zu starten. Unter Windows läuft dieser stille Austausch meist reibungslos. Unter macOS ist er heikler, und es gibt einige häufige Gründe, warum der Klick auf einer toten Schaltfläche landet." },
    { type: "paragraph",html: "Der wichtigste ist, <strong class='text-white'>von wo die App läuft</strong>. Auto-Updater unter macOS können im Allgemeinen nur eine App überschreiben, die im Ordner <strong class='text-white'>Applications</strong> liegt. Wenn Sie Tradovate je direkt aus dem eingehängten Disk-Image geöffnet oder in Downloads oder auf dem Schreibtisch liegen gelassen und von dort gestartet haben, hat der Updater kein beschreibbares Zuhause für die Installation und gibt lautlos auf. Keine Berechtigungsabfrage, kein Fehlerdialog, nur eine Schaltfläche, die nichts tut." },
    { type: "paragraph",html: "Der zweite ist <strong class='text-white'>Gatekeeper und das Quarantäne-Flag</strong>. Alles, was Sie herunterladen, erhält ein Quarantäne-Attribut, mit dem macOS steuert, was ausgeführt werden darf, und dieses Flag kann zusammen mit der Code-Signatur der App und den Ordnerberechtigungen den Updater daran hindern, Dateien stillschweigend zu ersetzen. Eine dritte, banalere Ursache: Das Update-Paket wurde nicht sauber fertig heruntergeladen, sodass nichts Gültiges zu installieren ist, obwohl die Schaltfläche angezeigt wird." },
    { type: "paragraph",html: "Nichts davon berührt Ihr Trading. Die Desktop-App ist nur ein Fenster in ein Konto, das vollständig auf den Servern von Tradovate liegt, daher ist es völlig sicher, die alte App zu löschen und eine frische einzuspielen." },
    { type: "quote",html: "Der schnellste Weg daran vorbei ist, den In-App-Updater nicht länger als einzige Möglichkeit zum Aktualisieren zu betrachten. Ein manueller Download von der offiziellen Website ist dieselbe Version, die die Schaltfläche zu holen versuchte, nur von Hand so installiert, dass macOS damit zufrieden ist." },
    { type: "heading",text: "Die Lösung: Build herunterladen und von Hand installieren" },
    {
      type: "steps",
      items: [
        { title: "Den aktuellen Mac-Build herunterladen", html: "Öffnen Sie einen Browser und gehen Sie zu <strong class='text-white'>tradovate.com/devices</strong>. Diese Seite listet jede Möglichkeit auf, die Plattform zu nutzen: Web, Windows, Mac und die mobilen Apps. Klicken Sie auf <strong class='text-white'>Download Mac</strong>, um den aktuellen Desktop-Build zu laden. Beziehen Sie ihn von der eigenen Website von Tradovate statt von einem Drittanbieter-Spiegel, damit Sie wissen, dass es ein aktueller, unveränderter Installer ist. Die Datei wird als Disk-Image (eine <code>.dmg</code>) in Ihrem Ordner Downloads gespeichert." },
        { title: "Die alte App vollständig beenden", html: "Beenden Sie vor dem Ersetzen die laufende Kopie von Tradovate vollständig. Ein Klick auf die rote Schließen-Schaltfläche des Fensters genügt nicht, die App läuft oft im Hintergrund weiter. Nutzen Sie <strong class='text-white'>Command-Q</strong>, während Tradovate im Fokus ist, oder klicken Sie mit der rechten Maustaste auf das Symbol im Dock und wählen Sie <strong class='text-white'>Quit</strong>. Eine noch laufende Kopie kann nicht überschrieben werden, und der Versuch, sie im geöffneten Zustand zu ersetzen, ist ein häufiger Grund dafür, dass der Austausch auf halbem Weg scheitert." },
        { title: "Die neue App nach Applications ziehen", html: "Doppelklicken Sie auf die heruntergeladene <code>.dmg</code>, um sie einzuhängen. Ein Fenster öffnet sich mit dem App-Symbol <strong class='text-white'>Tradovate</strong>, meist neben einer Verknüpfung zu Ihrem Ordner <strong class='text-white'>Applications</strong>. Ziehen Sie das Tradovate-Symbol auf den Ordner Applications. Wenn macOS fragt, ob Sie das vorhandene Objekt ersetzen möchten, wählen Sie <strong class='text-white'>Replace</strong>, damit der neue Build den alten überschreibt. Das ist das wichtigste Detail der gesamten Seite: Installieren Sie sie <em>in Applications</em> und starten Sie sie von dort." },
        { title: "Aus Applications öffnen und anmelden", html: "Öffnen Sie Ihren Ordner <strong class='text-white'>Applications</strong> und starten Sie Tradovate von dort. Melden Sie sich mit Ihren Tradovate- oder Prop-Firm-Zugangsdaten an, und Ihre Konten, Layouts und Positionen werden direkt vom Server wieder synchronisiert. Das ist die ganze Lösung. Sie sind auf dem aktuellen Build, und weil die App jetzt am richtigen Ort liegt, hat das nächste angebotene Update eine echte Chance, sich selbst zu installieren." },
      ],
    },
    { type: "paragraph",html: "Dieselbe Geräteseite verlinkt auch die Streaming-Webplattform, die in Ihrem Browser immer die neueste Version ausführt, ohne dass etwas heruntergeladen werden muss, ein solider Ausweg, wenn der Updater Ihnen weiter Probleme macht." },
    { type: "paragraph",html: "Wenn der Kopiervorgang fertig ist, werfen Sie das Disk-Image aus (ziehen Sie es in den Papierkorb oder klicken Sie im Finder auf den Auswerfen-Pfeil daneben) und löschen Sie die <code>.dmg</code> aus Downloads, damit Sie die App später nicht versehentlich wieder aus einem eingehängten Image starten." },
    { type: "heading",text: "Wenn macOS die neue App blockiert" },
    { type: "paragraph",html: "Weil Sie sie gerade heruntergeladen haben, zeigt macOS beim ersten Öffnen möglicherweise eine Gatekeeper-Warnung an, etwa &ldquo;Tradovate can't be opened because it is from an unidentified developer&rdquo; oder &ldquo;macOS cannot verify the developer.&rdquo; Das ist bei einer frisch heruntergeladenen App zu erwarten und eine einmalige Freigabe, kein Zeichen dafür, dass etwas nicht stimmt." },
    { type: "paragraph",html: "Um das zu beheben, <strong class='text-white'>klicken Sie mit der rechten Maustaste (oder Control-Klick) auf die Tradovate-App in Applications und wählen Sie Open</strong>, und bestätigen Sie dann <strong class='text-white'>Open</strong> im Dialog. Auf diese Weise geöffnet, signalisiert es macOS, dass Sie der App vertrauen, und Sie werden nicht erneut gefragt. Verweigert der normale Doppelklick weiterhin den Start, gehen Sie zu <strong class='text-white'>System Settings &rarr; Privacy &amp; Security</strong>, scrollen Sie zum Abschnitt Security und suchen Sie eine Schaltfläche <strong class='text-white'>Open Anyway</strong> für Tradovate. Klicken Sie darauf, und sie startet. Der genaue Wortlaut dieser Abfragen ändert sich zwischen macOS-Versionen. Wenn eine Bezeichnung in Ihrer Version etwas anders lautet, suchen Sie das nächstliegende Äquivalent, mit dem Sie die App freigeben können." },
    { type: "heading",text: "Warum der In-App-Updater immer wieder scheitert (und wie Sie das beenden)" },
    { type: "paragraph",html: "Wenn Sie schon länger mit einer toten Schaltfläche Install and Relaunch kämpfen, ist die Wahrscheinlichkeit sehr hoch, dass die alte App nie in Applications lag. Viele nutzen eine Mac-App monatelang direkt aus dem Disk-Image oder dem Ordner Downloads, ohne es zu merken, und alles funktioniert bestens bis zu dem Tag, an dem ein Update installiert werden muss. Von einem schreibgeschützten oder nicht standardmäßigen Ort aus kann der Updater die App schlicht nicht überschreiben, sodass jedes künftige Update lautlos ins Leere läuft." },
    { type: "paragraph",html: "Die App einmal nach Applications zu verschieben, wie in den obigen Schritten, behebt das für die Zukunft. An ihrem richtigen Platz hat der Updater einen beschreibbaren Ort für die Installation, und der Ablauf funktioniert wieder. Sollte es je wieder hängen, kennen Sie den Notausgang: beenden, aktuellen Build herunterladen und einspielen." },
    { type: "heading",text: "Verwalten Sie Ihr Risiko, während die App geschlossen ist" },
    { type: "paragraph",html: "Das Beenden der Desktop-App zum Austauschen storniert keine einzige Order. Jeder Stop und jedes Ziel, das Sie platziert haben, liegt auf den Servern von Tradovate und funktioniert weiter, egal was auf Ihrem Mac geöffnet ist. Wenn Sie beim Update in einer laufenden Position sind, bleiben Sie nicht blind: Öffnen Sie die <strong class='text-white'>Tradovate-Webplattform</strong> im Browser oder die <strong class='text-white'>mobile App</strong> auf Ihrem Handy, und Sie sehen dasselbe Konto mit voller Kontrolle zum Ändern oder Glattstellen. Betrachten Sie die Desktop-App als eines von mehreren Fenstern in Ihr Konto, niemals als die einzige Tür." },
    { type: "heading",text: "Tabelle zur Fehlersuche" },
    { type: "table", headers: ["Symptom","Wahrscheinliche Ursache","Lösung"], rows: [
      ["Install and Relaunch tut nichts, kein Fehler","App liegt nicht in Applications, daher kann der Updater nicht schreiben","Aktuellen Build von tradovate.com/devices herunterladen und nach Applications ziehen"],
      ["Update-Banner kehrt bei jedem Start zurück","Update wurde nie tatsächlich installiert","Vollständig mit Command-Q beenden, dann saubere manuelle Installation durchführen"],
      ["&ldquo;Kann nicht geöffnet werden / nicht identifizierter Entwickler&rdquo;","Gatekeeper markiert eine frisch heruntergeladene App","Rechtsklick auf die App &rarr; Open &rarr; bestätigen, oder Privacy &amp; Security &rarr; Open Anyway nutzen"],
      ["Ersetzen schlägt fehl oder hängt","Alte Kopie läuft noch im Hintergrund","Vor dem Ersetzen Command-Q oder Dock &rarr; Quit nutzen, dann erneut versuchen"],
      ["Jedes künftige Update scheitert auf dieselbe Weise","App wird aus dem Disk-Image oder aus Downloads ausgeführt","In Applications installieren und immer von dort starten"],
      ["App läuft nach dem Update gar nicht mehr","Nicht unterstützte oder veraltete macOS-Version","Prüfen, ob Ihr macOS das aktuelle Minimum erfüllt, und bei Bedarf das Betriebssystem aktualisieren"],
    ] },
    { type: "heading",text: "Handeln Sie weiter, auch wenn die Desktop-App nicht mitspielt" },
    { type: "paragraph",html: "Wenn ein hängender Updater Sie je daran zweifeln ließ, ob ein Trade durchgegangen ist, lautet die Antwort: Verlassen Sie sich nicht darauf, dass ein einzelner Client geöffnet bleibt. PickMyTrade verbindet Ihre TradingView-Alerts direkt mit Tradovate und führt die Ausführung auf unseren Servern aus, sodass Ihre Strategie feuert, egal ob die Desktop-App geöffnet, aktualisiert oder überhaupt installiert ist:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Serverseitige Ausführung</strong>, Alerts laufen von TradingView über unsere Infrastruktur zu Tradovate, sodass eine geschlossene oder gerade aktualisierte Desktop-App nie verhindert, dass ein Einstieg oder Ausstieg durchgeht.",
        "<strong class='text-white'>Geräteunabhängigkeit</strong>, nichts hängt davon ab, dass die Mac-App auf dem neuesten Build ist. Ihre Trades feuern vom Alert aus, nicht von dem Client, der gerade zufällig läuft.",
        "<strong class='text-white'>Stops und Ziele, die halten</strong>, im Alert definierte SL/TP werden bei Tradovate platziert, egal welche App Sie geöffnet haben, sodass der Schutz nicht von einem funktionierenden Updater abhängt.",
        "<strong class='text-white'>Multi-Konto-Synchronisierung</strong>, spiegeln Sie dieselben Orders gleichzeitig über alle verbundenen Konten, sodass kein Konto unbeaufsichtigt bleibt, während Sie eine Desktop-App neu installieren.",
      ],
    },
  ], es: [
    { type: "paragraph",html: "La app de escritorio de Tradovate muestra un pequeño banner que le avisa de que hay una nueva versión lista, con un amistoso botón <strong class='text-white'>Install and Relaunch</strong>. Hace clic esperando que la app se sustituya por la actualización y se reinicie. En su lugar, no pasa nada. Ni barra de progreso, ni reinicio, ni error. El banner puede desaparecer un segundo y volver en el siguiente arranque, insistiéndole en instalar una versión que en realidad nunca se instala. En macOS en concreto, ese botón puede quedar totalmente inerte." },
    { type: "paragraph",html: "Buenas noticias: es un callejón sin salida cosmético, no una cuenta rota ni una instalación corrupta. El actualizador falla en silencio por motivos bien conocidos en Mac, y la solución alternativa es sencilla y fiable. <strong class='text-white'>Omita por completo el botón de la app, descargue la versión de escritorio actual directamente del sitio de Tradovate y colóquela en su carpeta Applications.</strong> A continuación encontrará la secuencia exacta, por qué el botón se atasca y el único ajuste que hace que las futuras actualizaciones funcionen de verdad." },
    {
      type: "checklist",
      heading: "Lista rápida para tener la última versión",
      items: [
        "<strong class='text-white'>No luche contra el botón.</strong> Si Install and Relaunch no hace nada una vez, seguirá sin hacer nada. Pase a una instalación manual.",
        "<strong class='text-white'>Descargue la versión actual para Mac</strong> desde la página oficial de dispositivos en tradovate.com/devices (el enlace &ldquo;Download Mac&rdquo;).",
        "<strong class='text-white'>Cierre la app por completo</strong> con Command-Q antes de reemplazarla. Una copia en ejecución no puede sobrescribirse a sí misma.",
        "<strong class='text-white'>Arrastre Tradovate a Applications</strong>, reemplazando la copia antigua cuando macOS se lo pida.",
        "<strong class='text-white'>Ábrala desde Applications</strong>, no desde la imagen de disco ni desde Downloads. Esto es lo que permite que las futuras actualizaciones funcionen.",
        "<strong class='text-white'>Apruébela en Gatekeeper</strong> si macOS marca una app recién descargada: clic derecho, Open, confirmar una vez.",
        "<strong class='text-white'>Gestione las operaciones abiertas desde la plataforma web o el móvil</strong> mientras la app de escritorio esté cerrada. Sus órdenes siguen activas en los servidores de Tradovate.",
      ],
    },
    { type: "heading",text: "Qué ocurre realmente cuando el botón muere" },
    { type: "paragraph",html: "La app de escritorio de Tradovate incluye un actualizador automático, el mismo tipo de mecanismo integrado que usan la mayoría de las apps de escritorio multiplataforma. Cuando llega una nueva versión, el actualizador descarga el paquete en segundo plano y luego ofrece instalarlo y reiniciar. En Windows, ese cambio silencioso suele ir sin problemas. En macOS es más delicado y hay algunos motivos habituales por los que el clic cae en un botón muerto." },
    { type: "paragraph",html: "El principal es <strong class='text-white'>desde dónde se ejecuta la app</strong>. Los actualizadores automáticos de macOS generalmente solo pueden reescribir una app que está en la carpeta <strong class='text-white'>Applications</strong>. Si alguna vez abrió Tradovate directamente desde la imagen de disco montada, o la dejó en Downloads o en el escritorio y la ejecutó desde ahí, el actualizador no tiene un lugar con permiso de escritura donde instalarse y se rinde en silencio. Sin solicitud de permiso, sin cuadro de error, solo un botón que no hace nada." },
    { type: "paragraph",html: "El segundo es <strong class='text-white'>Gatekeeper y el indicador de cuarentena</strong>. Todo lo que descarga recibe un atributo de cuarentena que macOS usa para controlar lo que puede ejecutarse, y ese indicador, junto con la firma de código de la app y los permisos de carpeta, puede impedir que el actualizador reemplace archivos en silencio. Una tercera causa, más mundana: el paquete de actualización no terminó de descargarse correctamente, así que no hay nada válido que instalar aunque el botón se muestre." },
    { type: "paragraph",html: "Nada de esto afecta a su trading. La app de escritorio es solo una ventana a una cuenta que reside por completo en los servidores de Tradovate, así que borrar la app antigua y colocar una nueva es totalmente seguro." },
    { type: "quote",html: "La ruta más rápida es dejar de tratar el actualizador de la app como la única forma de actualizar. Una descarga manual desde el sitio oficial es la misma versión que el botón intentaba obtener, solo que instalada a mano de una forma con la que macOS está conforme." },
    { type: "heading",text: "La solución: descargue la versión e instálela a mano" },
    {
      type: "steps",
      items: [
        { title: "Descargue la versión actual para Mac", html: "Abra un navegador y vaya a <strong class='text-white'>tradovate.com/devices</strong>. Esa página lista todas las formas de ejecutar la plataforma: web, Windows, Mac y las apps móviles. Haga clic en <strong class='text-white'>Download Mac</strong> para obtener la versión de escritorio actual. Descárguela del sitio propio de Tradovate y no de un espejo de descargas de terceros, para saber que es un instalador actual y sin manipular. El archivo llega como una imagen de disco (un <code>.dmg</code>) en su carpeta Downloads." },
        { title: "Cierre por completo la app antigua", html: "Antes de reemplazar nada, cierre por completo la copia en ejecución de Tradovate. Hacer clic en el botón rojo de cerrar de la ventana no basta; la app suele seguir activa en segundo plano. Use <strong class='text-white'>Command-Q</strong> con Tradovate en primer plano, o haga clic derecho en su icono del Dock y elija <strong class='text-white'>Quit</strong>. Una copia que sigue en ejecución no puede sobrescribirse, e intentar reemplazarla mientras está abierta es un motivo común de que el cambio falle a medias." },
        { title: "Arrastre la nueva app a Applications", html: "Haga doble clic en el <code>.dmg</code> descargado para montarlo. Se abre una ventana con el icono de la app <strong class='text-white'>Tradovate</strong>, normalmente junto a un acceso directo a su carpeta <strong class='text-white'>Applications</strong>. Arrastre el icono de Tradovate a la carpeta Applications. Cuando macOS pregunte si desea reemplazar el elemento existente, elija <strong class='text-white'>Replace</strong> para que la nueva versión sobrescriba la antigua. Este es el detalle más importante de toda la página: instálela <em>en Applications</em> y ejecútela desde allí." },
        { title: "Ábrala desde Applications e inicie sesión", html: "Abra su carpeta <strong class='text-white'>Applications</strong> y ejecute Tradovate desde allí. Inicie sesión con sus credenciales de Tradovate o de su prop firm y sus cuentas, diseños y posiciones se sincronizan de nuevo desde el servidor. Esa es toda la solución. Ya está en la versión actual y, como la app ahora está en el lugar correcto, la próxima actualización que ofrezca tiene posibilidades reales de instalarse sola." },
      ],
    },
    { type: "paragraph",html: "Esa misma página de dispositivos también enlaza la plataforma web con streaming, que siempre ejecuta la versión más reciente en su navegador sin nada que descargar, una alternativa sólida si el actualizador sigue dándole problemas." },
    { type: "paragraph",html: "Cuando termine la copia, expulse la imagen de disco (arrástrela a la Papelera o haga clic en la flecha de expulsión junto a ella en Finder) y elimine el <code>.dmg</code> de Downloads para no ejecutar por accidente la app desde una imagen montada más adelante." },
    { type: "heading",text: "Si macOS bloquea la nueva app" },
    { type: "paragraph",html: "Como acaba de descargarla, macOS puede mostrar una advertencia de Gatekeeper la primera vez que la abra, algo como &ldquo;Tradovate can't be opened because it is from an unidentified developer&rdquo; o &ldquo;macOS cannot verify the developer.&rdquo; Es lo esperado en una app recién descargada y es una aprobación única, no una señal de que algo vaya mal." },
    { type: "paragraph",html: "Para resolverlo, <strong class='text-white'>haga clic derecho (o Control-clic) en la app de Tradovate en Applications y elija Open</strong>, y luego confirme <strong class='text-white'>Open</strong> en el cuadro de diálogo. Abrirla así le indica a macOS que confía en ella y no se lo volverá a pedir. Si el doble clic habitual sigue sin abrirla, vaya a <strong class='text-white'>System Settings &rarr; Privacy &amp; Security</strong>, desplácese a la sección Security y busque un botón <strong class='text-white'>Open Anyway</strong> asociado a Tradovate. Haga clic en él y se abrirá. La redacción exacta de estos mensajes cambia entre versiones de macOS, así que si una etiqueta aparece algo distinta en su versión, busque el equivalente más cercano que le permita aprobar la app." },
    { type: "heading",text: "Por qué sigue fallando el actualizador de la app (y cómo evitarlo)" },
    { type: "paragraph",html: "Si lleva tiempo peleando con un botón Install and Relaunch muerto, es muy probable que la app antigua nunca estuviera en Applications. Mucha gente ejecuta una app de Mac durante meses directamente desde la imagen de disco o la carpeta Downloads sin darse cuenta, y todo funciona bien hasta el día en que una actualización debe instalarse. Desde una ubicación de solo lectura o no estándar, el actualizador simplemente no puede reescribir la app, así que cada futura actualización no hace nada en silencio." },
    { type: "paragraph",html: "Mover la app a Applications una vez, como en los pasos anteriores, lo soluciona de ahora en adelante. Desde su lugar adecuado, el actualizador tiene dónde instalar con permiso de escritura y el flujo vuelve a comportarse. Si alguna vez se atasca de nuevo, ya conoce la salida de emergencia: cerrar, descargar la versión actual y colocarla." },
    { type: "heading",text: "Gestione su riesgo mientras la app está cerrada" },
    { type: "paragraph",html: "Cerrar la app de escritorio para reemplazarla no cancela ni una sola orden. Cada stop y objetivo que haya colocado reside en los servidores de Tradovate y sigue funcionando sin importar qué esté abierto en su Mac. Si está en una posición activa cuando va a actualizar, no se quede a ciegas: abra la <strong class='text-white'>plataforma web de Tradovate</strong> en un navegador o la <strong class='text-white'>app móvil</strong> en su teléfono y verá la misma cuenta con control total para modificar o cerrar. Trate la app de escritorio como una de varias ventanas a su cuenta, nunca como la única puerta de entrada." },
    { type: "heading",text: "Tabla de resolución de problemas" },
    { type: "table", headers: ["Síntoma","Causa probable","Solución"], rows: [
      ["Install and Relaunch no hace nada, sin error","La app no está en Applications, así que el actualizador no puede escribir","Descargue la versión actual desde tradovate.com/devices y arrástrela a Applications"],
      ["El banner de actualización vuelve en cada arranque","La actualización nunca llegó a instalarse","Cierre por completo con Command-Q y haga una instalación manual limpia"],
      ["&ldquo;No se puede abrir / desarrollador no identificado&rdquo;","Gatekeeper marca una app recién descargada","Clic derecho en la app &rarr; Open &rarr; confirmar, o use Privacy &amp; Security &rarr; Open Anyway"],
      ["El paso de reemplazo falla o se cuelga","La copia antigua sigue ejecutándose en segundo plano","Command-Q o Dock &rarr; Quit antes de reemplazar y reintente"],
      ["Todas las futuras actualizaciones fallan igual","La app se ejecuta desde la imagen de disco o desde Downloads","Instale en Applications y ejecútela siempre desde allí"],
      ["La app no se ejecuta en absoluto tras la actualización","Versión de macOS no compatible o desactualizada","Confirme que su macOS cumple el mínimo actual y actualice el sistema si es necesario"],
    ] },
    { type: "heading",text: "Siga operando incluso cuando la app de escritorio no coopera" },
    { type: "paragraph",html: "Si un actualizador atascado alguna vez le ha hecho dudar de si una operación se ejecutó, la respuesta es dejar de depender de que un solo cliente permanezca abierto. PickMyTrade conecta sus alertas de TradingView directamente con Tradovate y ejecuta las órdenes en nuestros servidores, por lo que su estrategia se dispara tanto si la app de escritorio está abierta, actualizada o incluso instalada, como si no:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Ejecución en el servidor</strong>, las alertas se enrutan de TradingView a Tradovate a través de nuestra infraestructura, así que una app de escritorio cerrada o en plena actualización nunca impide que una entrada o una salida se ejecute.",
        "<strong class='text-white'>Independencia del dispositivo</strong>, nada depende de que la app de Mac esté en la última versión. Sus operaciones se disparan desde la alerta, no desde el cliente que casualmente esté en ejecución.",
        "<strong class='text-white'>Stops y objetivos que se mantienen</strong>, el SL/TP definido en la alerta se coloca en Tradovate sin importar qué app tenga abierta, así que la protección no depende de un actualizador que funcione.",
        "<strong class='text-white'>Sincronización multicuenta</strong>, replique las mismas órdenes en todas las cuentas conectadas a la vez, para que ninguna cuenta quede sin gestionar mientras reinstala una app de escritorio.",
      ],
    },
  ], fr: [
    { type: "paragraph",html: "L'application de bureau Tradovate affiche une petite bannière vous indiquant qu'une nouvelle version est prête, avec un bouton engageant <strong class='text-white'>Install and Relaunch</strong>. Vous cliquez en vous attendant à ce que l'application se remplace par la mise à jour et redémarre. À la place, rien ne se passe. Pas de barre de progression, pas de redémarrage, pas d'erreur. La bannière peut disparaître une seconde puis revenir dès le lancement suivant, vous pressant d'installer une version qui ne s'installe jamais vraiment. Sous macOS en particulier, ce bouton peut être totalement inerte." },
    { type: "paragraph",html: "Bonne nouvelle : c'est une impasse cosmétique, pas un compte cassé ni une installation corrompue. Le programme de mise à jour échoue en silence pour des raisons bien connues sur Mac, et la solution de contournement est simple et fiable. <strong class='text-white'>Ignorez complètement le bouton de l'application, téléchargez la version de bureau actuelle directement depuis le site de Tradovate et placez-la dans votre dossier Applications.</strong> Voici la séquence exacte, la raison pour laquelle le bouton cale et le réglage qui fait que les mises à jour futures fonctionnent vraiment." },
    {
      type: "checklist",
      heading: "Liste de contrôle rapide pour passer à la dernière version",
      items: [
        "<strong class='text-white'>Ne vous battez pas avec le bouton.</strong> Si Install and Relaunch ne fait rien une fois, il continuera à ne rien faire. Passez à une installation manuelle.",
        "<strong class='text-white'>Téléchargez la version Mac actuelle</strong> depuis la page officielle des appareils, tradovate.com/devices (le lien &ldquo;Download Mac&rdquo;).",
        "<strong class='text-white'>Quittez complètement l'application</strong> avec Command-Q avant de la remplacer. Une copie en cours d'exécution ne peut pas s'écraser elle-même.",
        "<strong class='text-white'>Faites glisser Tradovate dans Applications</strong>, en remplaçant l'ancienne copie lorsque macOS vous le demande.",
        "<strong class='text-white'>Lancez-la depuis Applications</strong>, et non depuis l'image disque ou Downloads. C'est ce qui permet aux mises à jour futures de fonctionner.",
        "<strong class='text-white'>Approuvez-la dans Gatekeeper</strong> si macOS signale une application fraîchement téléchargée : clic droit, Open, confirmer une fois.",
        "<strong class='text-white'>Gérez vos trades ouverts depuis la plateforme web ou le mobile</strong> pendant que l'application de bureau est fermée. Vos ordres restent actifs sur les serveurs de Tradovate.",
      ],
    },
    { type: "heading",text: "Ce qui se passe réellement quand le bouton meurt" },
    { type: "paragraph",html: "L'application de bureau Tradovate est livrée avec un programme de mise à jour automatique, le même type de mécanisme intégré que la plupart des applications de bureau multiplateformes. Quand une nouvelle version arrive, il télécharge le paquet en arrière-plan puis propose de l'installer et de redémarrer. Sous Windows, ce remplacement silencieux se passe généralement sans accroc. Sous macOS, c'est plus capricieux, et il y a quelques raisons courantes pour lesquelles le clic tombe sur un bouton mort." },
    { type: "paragraph",html: "La principale est <strong class='text-white'>l'emplacement d'où s'exécute l'application</strong>. Les programmes de mise à jour de macOS ne peuvent généralement réécrire qu'une application située dans le dossier <strong class='text-white'>Applications</strong>. Si vous avez déjà ouvert Tradovate directement depuis l'image disque montée, ou l'avez laissé dans Downloads ou sur le Bureau en l'exécutant de là, le programme de mise à jour n'a aucun emplacement inscriptible où s'installer, et il abandonne en silence. Pas d'invite d'autorisation, pas de boîte d'erreur, juste un bouton qui ne fait rien." },
    { type: "paragraph",html: "La seconde est <strong class='text-white'>Gatekeeper et l'indicateur de quarantaine</strong>. Tout ce que vous téléchargez reçoit un attribut de quarantaine que macOS utilise pour contrôler ce qui peut s'exécuter, et cet indicateur, avec la signature de code de l'application et les autorisations du dossier, peut empêcher le programme de mise à jour de remplacer discrètement des fichiers. Une troisième cause, plus banale : le paquet de mise à jour ne s'est pas téléchargé entièrement, il n'y a donc rien de valide à installer même si le bouton s'affiche." },
    { type: "paragraph",html: "Rien de tout cela n'affecte votre trading. L'application de bureau n'est qu'une fenêtre sur un compte qui vit entièrement sur les serveurs de Tradovate ; supprimer l'ancienne application et en déposer une neuve est donc totalement sans risque." },
    { type: "quote",html: "Le plus rapide est de cesser de considérer le programme de mise à jour intégré comme la seule façon de mettre à jour. Un téléchargement manuel depuis le site officiel est la même version que celle que le bouton essayait de récupérer, simplement installée à la main d'une manière que macOS accepte." },
    { type: "heading",text: "La solution : télécharger la version et l'installer à la main" },
    {
      type: "steps",
      items: [
        { title: "Téléchargez la version Mac actuelle", html: "Ouvrez un navigateur et rendez-vous sur <strong class='text-white'>tradovate.com/devices</strong>. Cette page répertorie toutes les façons d'utiliser la plateforme : web, Windows, Mac et applications mobiles. Cliquez sur <strong class='text-white'>Download Mac</strong> pour récupérer la version de bureau actuelle. Prenez-la sur le site de Tradovate lui-même plutôt que sur un miroir de téléchargement tiers, afin d'être sûr qu'il s'agit d'un installateur actuel et non altéré. Le fichier arrive sous forme d'image disque (un <code>.dmg</code>) dans votre dossier Downloads." },
        { title: "Quittez complètement l'ancienne application", html: "Avant de remplacer quoi que ce soit, quittez complètement la copie de Tradovate en cours d'exécution. Cliquer sur le bouton rouge de fermeture de la fenêtre ne suffit pas ; l'application reste souvent active en arrière-plan. Utilisez <strong class='text-white'>Command-Q</strong> avec Tradovate au premier plan, ou faites un clic droit sur son icône dans le Dock et choisissez <strong class='text-white'>Quit</strong>. Une copie encore en cours d'exécution ne peut pas être écrasée, et tenter de la remplacer pendant qu'elle est ouverte est une cause fréquente d'échec du remplacement en cours de route." },
        { title: "Faites glisser la nouvelle application dans Applications", html: "Double-cliquez sur le <code>.dmg</code> téléchargé pour le monter. Une fenêtre s'ouvre, affichant l'icône de l'application <strong class='text-white'>Tradovate</strong>, généralement à côté d'un raccourci vers votre dossier <strong class='text-white'>Applications</strong>. Faites glisser l'icône Tradovate sur le dossier Applications. Lorsque macOS demande si vous souhaitez remplacer l'élément existant, choisissez <strong class='text-white'>Replace</strong> pour que la nouvelle version écrase l'ancienne. C'est le détail le plus important de toute la page : installez-la <em>dans Applications</em> et lancez-la de là." },
        { title: "Ouvrez-la depuis Applications et connectez-vous", html: "Ouvrez votre dossier <strong class='text-white'>Applications</strong> et lancez Tradovate à partir de là. Connectez-vous avec vos identifiants Tradovate ou de prop firm, et vos comptes, dispositions et positions se resynchronisent depuis le serveur. C'est toute la solution. Vous êtes sur la version actuelle et, comme l'application se trouve désormais au bon endroit, la prochaine mise à jour proposée a de réelles chances de s'installer toute seule." },
      ],
    },
    { type: "paragraph",html: "Cette même page des appareils renvoie aussi vers la plateforme web en streaming, qui exécute toujours la version la plus récente dans votre navigateur sans rien à télécharger, une solution de repli solide si le programme de mise à jour continue de vous poser problème." },
    { type: "paragraph",html: "Une fois la copie terminée, éjectez l'image disque (faites-la glisser vers la Corbeille ou cliquez sur la flèche d'éjection à côté dans le Finder) et supprimez le <code>.dmg</code> de Downloads afin de ne pas exécuter par erreur l'application depuis une image montée plus tard." },
    { type: "heading",text: "Si macOS bloque la nouvelle application" },
    { type: "paragraph",html: "Comme vous venez de la télécharger, macOS peut afficher un avertissement Gatekeeper lors de la première ouverture, du genre &ldquo;Tradovate can't be opened because it is from an unidentified developer&rdquo; ou &ldquo;macOS cannot verify the developer.&rdquo; C'est normal pour une application fraîchement téléchargée et il s'agit d'une approbation unique, pas d'un signe que quelque chose ne va pas." },
    { type: "paragraph",html: "Pour le lever, <strong class='text-white'>faites un clic droit (ou Control-clic) sur l'application Tradovate dans Applications et choisissez Open</strong>, puis confirmez <strong class='text-white'>Open</strong> dans la boîte de dialogue. L'ouvrir ainsi indique à macOS que vous lui faites confiance, et on ne vous le redemandera pas. Si le double-clic habituel refuse toujours de la lancer, allez dans <strong class='text-white'>System Settings &rarr; Privacy &amp; Security</strong>, faites défiler jusqu'à la section Security et cherchez un bouton <strong class='text-white'>Open Anyway</strong> associé à Tradovate. Cliquez dessus et elle se lancera. Le libellé exact de ces invites change d'une version de macOS à l'autre ; si un libellé diffère un peu dans votre version, cherchez l'équivalent le plus proche qui vous permet d'approuver l'application." },
    { type: "heading",text: "Pourquoi le programme de mise à jour échoue sans cesse (et comment y mettre fin)" },
    { type: "paragraph",html: "Si vous luttez depuis un moment contre un bouton Install and Relaunch mort, il y a de fortes chances que l'ancienne application n'ait jamais été dans Applications. Beaucoup de gens utilisent une application Mac pendant des mois directement depuis l'image disque ou le dossier Downloads sans s'en rendre compte, et tout fonctionne très bien jusqu'au jour où une mise à jour doit s'installer. Depuis un emplacement en lecture seule ou non standard, le programme de mise à jour ne peut tout simplement pas réécrire l'application, et chaque mise à jour future ne fait donc rien en silence." },
    { type: "paragraph",html: "Déplacer l'application dans Applications une fois, comme dans les étapes ci-dessus, règle cela pour l'avenir. Depuis son emplacement légitime, le programme de mise à jour dispose d'un endroit inscriptible où s'installer, et le processus se remet à fonctionner. S'il cale à nouveau, vous connaissez la porte de sortie : quitter, télécharger la version actuelle et la déposer." },
    { type: "heading",text: "Gérez votre risque pendant que l'application est fermée" },
    { type: "paragraph",html: "Quitter l'application de bureau pour la remplacer n'annule pas un seul ordre. Chaque stop et chaque objectif que vous avez placés reste en place sur les serveurs de Tradovate et continue de fonctionner quoi qu'il y ait d'ouvert sur votre Mac. Si vous êtes en position ouverte au moment de la mise à jour, ne restez pas aveugle : ouvrez la <strong class='text-white'>plateforme web Tradovate</strong> dans un navigateur ou l'<strong class='text-white'>application mobile</strong> sur votre téléphone, et vous verrez le même compte avec un contrôle total pour modifier ou clôturer. Considérez l'application de bureau comme l'une de plusieurs fenêtres sur votre compte, jamais comme la seule porte d'entrée." },
    { type: "heading",text: "Tableau de dépannage" },
    { type: "table", headers: ["Symptôme","Cause probable","Solution"], rows: [
      ["Install and Relaunch ne fait rien, aucune erreur","L'application n'est pas dans Applications, le programme de mise à jour ne peut donc pas écrire","Téléchargez la version actuelle depuis tradovate.com/devices et faites-la glisser dans Applications"],
      ["La bannière de mise à jour revient à chaque lancement","La mise à jour ne s'est jamais réellement installée","Quittez complètement avec Command-Q, puis effectuez une installation manuelle propre"],
      ["&ldquo;Ne peut pas être ouverte / développeur non identifié&rdquo;","Gatekeeper signale une application fraîchement téléchargée","Clic droit sur l'application &rarr; Open &rarr; confirmer, ou utilisez Privacy &amp; Security &rarr; Open Anyway"],
      ["L'étape de remplacement échoue ou se fige","L'ancienne copie tourne encore en arrière-plan","Command-Q ou Dock &rarr; Quit avant de remplacer, puis réessayez"],
      ["Chaque mise à jour future échoue de la même façon","L'application s'exécute depuis l'image disque ou Downloads","Installez-la dans Applications et lancez-la toujours de là"],
      ["L'application ne démarre plus du tout après la mise à jour","Version de macOS non prise en charge ou obsolète","Vérifiez que votre macOS respecte le minimum actuel et mettez à jour le système si nécessaire"],
    ] },
    { type: "heading",text: "Continuez à trader même quand l'application de bureau ne coopère pas" },
    { type: "paragraph",html: "Si un programme de mise à jour bloqué vous a déjà fait douter qu'un trade soit passé, la réponse est de cesser de dépendre d'un seul client resté ouvert. PickMyTrade relie vos alertes TradingView directement à Tradovate et exécute les ordres sur nos serveurs, de sorte que votre stratégie se déclenche que l'application de bureau soit ouverte, à jour ou même installée :" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Exécution côté serveur</strong>, les alertes passent de TradingView à Tradovate via notre infrastructure ; une application de bureau fermée ou en pleine mise à jour n'empêche donc jamais une entrée ou une sortie de passer.",
        "<strong class='text-white'>Indépendance vis-à-vis de l'appareil</strong>, rien ne dépend du fait que l'application Mac soit à la dernière version. Vos trades se déclenchent depuis l'alerte, pas depuis le client qui se trouve être en cours d'exécution.",
        "<strong class='text-white'>Des stops et objectifs qui tiennent</strong>, le SL/TP défini dans l'alerte est placé sur Tradovate quelle que soit l'application ouverte ; la protection ne dépend donc pas d'un programme de mise à jour fonctionnel.",
        "<strong class='text-white'>Synchronisation multi-comptes</strong>, répliquez les mêmes ordres sur tous les comptes connectés en même temps, afin qu'aucun compte ne reste sans gestion pendant que vous réinstallez une application de bureau.",
      ],
    },
  ], it: [
    { type: "paragraph",html: "L'app desktop di Tradovate mostra un piccolo banner che le segnala che è pronta una nuova versione, con un amichevole pulsante <strong class='text-white'>Install and Relaunch</strong>. Lei fa clic aspettandosi che l'app si sostituisca con l'aggiornamento e si riavvii. Invece non succede nulla. Nessuna barra di avanzamento, nessun riavvio, nessun errore. Il banner potrebbe sparire per un secondo e tornare al lancio successivo, continuando a sollecitarla a installare una versione che in realtà non si installa mai. Su macOS in particolare, quel pulsante può essere completamente inerte." },
    { type: "paragraph",html: "Buone notizie: è un vicolo cieco estetico, non un account rotto né un'installazione corrotta. L'updater fallisce in silenzio per motivi ben noti su Mac e la soluzione alternativa è semplice e affidabile. <strong class='text-white'>Salti del tutto il pulsante nell'app, scarichi la versione desktop attuale direttamente dal sito di Tradovate e la inserisca nella cartella Applications.</strong> Di seguito trova la sequenza esatta, perché il pulsante si blocca e l'unica impostazione che fa funzionare davvero gli aggiornamenti futuri." },
    {
      type: "checklist",
      heading: "Checklist rapida per passare all'ultima versione",
      items: [
        "<strong class='text-white'>Non combatta con il pulsante.</strong> Se Install and Relaunch non fa nulla una volta, continuerà a non fare nulla. Passi a un'installazione manuale.",
        "<strong class='text-white'>Scarichi la versione Mac attuale</strong> dalla pagina ufficiale dei dispositivi su tradovate.com/devices (il link &ldquo;Download Mac&rdquo;).",
        "<strong class='text-white'>Chiuda completamente l'app</strong> con Command-Q prima di sostituirla. Una copia in esecuzione non può sovrascrivere se stessa.",
        "<strong class='text-white'>Trascini Tradovate in Applications</strong>, sostituendo la vecchia copia quando macOS lo chiede.",
        "<strong class='text-white'>La avvii da Applications</strong>, non dall'immagine disco o da Downloads. È questo che permette agli aggiornamenti futuri di funzionare.",
        "<strong class='text-white'>La approvi in Gatekeeper</strong> se macOS segnala un'app appena scaricata: clic destro, Open, conferma una volta.",
        "<strong class='text-white'>Gestisca i trade aperti dalla piattaforma web o dal mobile</strong> mentre l'app desktop è chiusa. I suoi ordini restano attivi sui server di Tradovate.",
      ],
    },
    { type: "heading",text: "Cosa succede davvero quando il pulsante muore" },
    { type: "paragraph",html: "L'app desktop di Tradovate include un auto-updater, lo stesso tipo di meccanismo integrato usato dalla maggior parte delle app desktop multipiattaforma. Quando arriva una nuova versione, l'updater scarica il pacchetto in background e poi offre di installarlo e riavviare. Su Windows questa sostituzione silenziosa di solito va a buon fine senza intoppi. Su macOS è più delicata e ci sono alcuni motivi comuni per cui il clic cade su un pulsante morto." },
    { type: "paragraph",html: "Il principale è <strong class='text-white'>da dove viene eseguita l'app</strong>. Gli auto-updater di macOS in genere possono riscrivere solo un'app che si trova nella cartella <strong class='text-white'>Applications</strong>. Se ha mai aperto Tradovate direttamente dall'immagine disco montata, o l'ha lasciato in Downloads o sulla Scrivania eseguendolo da lì, l'updater non ha un posto scrivibile in cui installarsi e rinuncia in silenzio. Nessuna richiesta di autorizzazione, nessuna finestra di errore, solo un pulsante che non fa nulla." },
    { type: "paragraph",html: "Il secondo è <strong class='text-white'>Gatekeeper e il flag di quarantena</strong>. Tutto ciò che scarica riceve un attributo di quarantena che macOS usa per controllare cosa può essere eseguito, e quel flag, insieme alla firma del codice dell'app e ai permessi della cartella, può impedire all'updater di sostituire silenziosamente i file. Una terza causa, più banale: il pacchetto di aggiornamento non è stato scaricato completamente, quindi non c'è nulla di valido da installare anche se il pulsante è visibile." },
    { type: "paragraph",html: "Nulla di tutto questo tocca il suo trading. L'app desktop è solo una finestra su un account che vive interamente sui server di Tradovate, quindi eliminare la vecchia app e inserirne una nuova è completamente sicuro." },
    { type: "quote",html: "La via più rapida è smettere di considerare l'updater nell'app come l'unico modo per aggiornare. Un download manuale dal sito ufficiale è la stessa versione che il pulsante cercava di ottenere, solo installata a mano in un modo che macOS gradisce." },
    { type: "heading",text: "La soluzione: scarichi la versione e la installi a mano" },
    {
      type: "steps",
      items: [
        { title: "Scarichi la versione Mac attuale", html: "Apra un browser e vada su <strong class='text-white'>tradovate.com/devices</strong>. Quella pagina elenca tutti i modi per usare la piattaforma: web, Windows, Mac e app mobili. Faccia clic su <strong class='text-white'>Download Mac</strong> per scaricare la versione desktop attuale. La prenda dal sito di Tradovate e non da un mirror di terze parti, così sa che è un installer aggiornato e non manomesso. Il file arriva come immagine disco (un <code>.dmg</code>) nella cartella Downloads." },
        { title: "Chiuda completamente la vecchia app", html: "Prima di sostituire qualsiasi cosa, chiuda completamente la copia di Tradovate in esecuzione. Fare clic sul pulsante rosso di chiusura della finestra non basta; l'app è spesso ancora attiva in background. Usi <strong class='text-white'>Command-Q</strong> con Tradovate in primo piano, oppure faccia clic con il tasto destro sulla sua icona nel Dock e scelga <strong class='text-white'>Quit</strong>. Una copia ancora in esecuzione non può essere sovrascritta e tentare di sostituirla mentre è aperta è un motivo comune per cui la sostituzione fallisce a metà." },
        { title: "Trascini la nuova app in Applications", html: "Faccia doppio clic sul <code>.dmg</code> scaricato per montarlo. Si apre una finestra con l'icona dell'app <strong class='text-white'>Tradovate</strong>, di solito accanto a un collegamento alla cartella <strong class='text-white'>Applications</strong>. Trascini l'icona di Tradovate sulla cartella Applications. Quando macOS chiede se vuole sostituire l'elemento esistente, scelga <strong class='text-white'>Replace</strong> così la nuova versione sovrascrive la vecchia. È il dettaglio più importante dell'intera pagina: la installi <em>in Applications</em> e la esegua da lì." },
        { title: "La apra da Applications e acceda", html: "Apra la cartella <strong class='text-white'>Applications</strong> e avvii Tradovate da lì. Acceda con le sue credenziali Tradovate o della prop firm e i suoi account, layout e posizioni si risincronizzano dal server. Questa è tutta la soluzione. È sulla versione attuale e, poiché l'app ora si trova nel posto giusto, il prossimo aggiornamento proposto ha reali possibilità di installarsi da solo." },
      ],
    },
    { type: "paragraph",html: "Quella stessa pagina dei dispositivi rimanda anche alla piattaforma web in streaming, che esegue sempre la versione più recente nel browser senza nulla da scaricare, un valido ripiego se l'updater continua a darle problemi." },
    { type: "paragraph",html: "Quando la copia è terminata, espella l'immagine disco (la trascini nel Cestino o faccia clic sulla freccia di espulsione accanto ad essa nel Finder) ed elimini il <code>.dmg</code> da Downloads per non eseguire accidentalmente di nuovo l'app da un'immagine montata più avanti." },
    { type: "heading",text: "Se macOS blocca la nuova app" },
    { type: "paragraph",html: "Poiché l'ha appena scaricata, macOS potrebbe mostrare un avviso di Gatekeeper alla prima apertura, qualcosa come &ldquo;Tradovate can't be opened because it is from an unidentified developer&rdquo; oppure &ldquo;macOS cannot verify the developer.&rdquo; È normale per un'app appena scaricata ed è un'approvazione una tantum, non un segno che qualcosa non va." },
    { type: "paragraph",html: "Per rimuoverlo, <strong class='text-white'>faccia clic con il tasto destro (o Control-clic) sull'app Tradovate in Applications e scelga Open</strong>, poi confermi <strong class='text-white'>Open</strong> nella finestra di dialogo. Aprirla in questo modo dice a macOS che ne ha fiducia e non le verrà chiesto di nuovo. Se il consueto doppio clic continua a rifiutarsi di avviarla, vada in <strong class='text-white'>System Settings &rarr; Privacy &amp; Security</strong>, scorra fino alla sezione Security e cerchi un pulsante <strong class='text-white'>Open Anyway</strong> associato a Tradovate. Faccia clic su di esso e si avvierà. La formulazione esatta di questi messaggi cambia tra le versioni di macOS, quindi se un'etichetta nella sua versione è leggermente diversa, cerchi l'equivalente più vicino che le permetta di approvare l'app." },
    { type: "heading",text: "Perché l'updater nell'app continua a fallire (e come fermarlo)" },
    { type: "paragraph",html: "Se combatte da un po' con un pulsante Install and Relaunch morto, le probabilità sono molto alte che la vecchia app non fosse mai stata in Applications. Molte persone usano un'app Mac per mesi direttamente dall'immagine disco o dalla cartella Downloads senza accorgersene, e tutto funziona benissimo fino al giorno in cui un aggiornamento deve installarsi. Da una posizione di sola lettura o non standard, l'updater semplicemente non può riscrivere l'app, quindi ogni aggiornamento futuro non fa nulla in silenzio." },
    { type: "paragraph",html: "Spostare l'app in Applications una volta, come nei passaggi sopra, risolve il problema per il futuro. Dalla sua sede corretta, l'updater ha un posto scrivibile in cui installare e il flusso torna a funzionare. Se dovesse bloccarsi di nuovo, conosce la via di fuga: chiudere, scaricare la versione attuale e inserirla." },
    { type: "heading",text: "Gestisca il suo rischio mentre l'app è chiusa" },
    { type: "paragraph",html: "Chiudere l'app desktop per sostituirla non annulla nemmeno un ordine. Ogni stop e target che ha inserito resta sui server di Tradovate e continua a funzionare qualunque cosa sia aperta sul suo Mac. Se è in una posizione attiva quando va ad aggiornare, non resti cieco: apra la <strong class='text-white'>piattaforma web di Tradovate</strong> in un browser o l'<strong class='text-white'>app mobile</strong> sul telefono e vedrà lo stesso account con pieno controllo per modificare o chiudere. Consideri l'app desktop come una delle tante finestre sul suo account, mai come l'unica porta d'ingresso." },
    { type: "heading",text: "Tabella di risoluzione dei problemi" },
    { type: "table", headers: ["Sintomo","Causa probabile","Soluzione"], rows: [
      ["Install and Relaunch non fa nulla, nessun errore","L'app non è in Applications, quindi l'updater non può scrivere","Scarichi la versione attuale da tradovate.com/devices e la trascini in Applications"],
      ["Il banner di aggiornamento ritorna a ogni avvio","L'aggiornamento non è mai stato realmente installato","Chiuda completamente con Command-Q, poi esegua un'installazione manuale pulita"],
      ["&ldquo;Non può essere aperta / sviluppatore non identificato&rdquo;","Gatekeeper segnala un'app appena scaricata","Clic destro sull'app &rarr; Open &rarr; conferma, oppure usi Privacy &amp; Security &rarr; Open Anyway"],
      ["Il passaggio di sostituzione fallisce o si blocca","La vecchia copia è ancora in esecuzione in background","Command-Q o Dock &rarr; Quit prima di sostituire, poi riprovi"],
      ["Ogni aggiornamento futuro fallisce allo stesso modo","L'app viene eseguita dall'immagine disco o da Downloads","Installi in Applications e la esegua sempre da lì"],
      ["L'app non si avvia affatto dopo l'aggiornamento","Versione di macOS non supportata o obsoleta","Verifichi che il suo macOS soddisfi il minimo attuale e aggiorni il sistema se necessario"],
    ] },
    { type: "heading",text: "Continui a fare trading anche quando l'app desktop non collabora" },
    { type: "paragraph",html: "Se un updater bloccato l'ha mai fatta dubitare che un trade sia andato a buon fine, la risposta è smettere di dipendere dal fatto che un singolo client resti aperto. PickMyTrade collega i suoi alert di TradingView direttamente a Tradovate ed esegue gli ordini sui nostri server, quindi la sua strategia scatta che l'app desktop sia aperta, aggiornata o addirittura installata:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Esecuzione lato server</strong>, gli alert passano da TradingView a Tradovate attraverso la nostra infrastruttura, quindi un'app desktop chiusa o in corso di aggiornamento non impedisce mai a un ingresso o a un'uscita di andare a buon fine.",
        "<strong class='text-white'>Indipendenza dal dispositivo</strong>, nulla dipende dal fatto che l'app Mac sia all'ultima versione. I suoi trade scattano dall'alert, non dal client che sta girando in quel momento.",
        "<strong class='text-white'>Stop e target che tengono</strong>, SL/TP definiti nell'alert vengono inseriti su Tradovate indipendentemente dall'app aperta, quindi la protezione non dipende da un updater funzionante.",
        "<strong class='text-white'>Sincronizzazione multi-account</strong>, replichi gli stessi ordini su tutti gli account collegati contemporaneamente, così nessun account resta senza gestione mentre reinstalla un'app desktop.",
      ],
    },
  ] },
  ctaHeading: { en: "Keep Trading No Matter What Your Desktop App Is Doing", de: "Handeln Sie weiter, egal was Ihre Desktop-App gerade tut", es: "Siga operando pase lo que pase con su app de escritorio", fr: "Continuez à trader quoi que fasse votre application de bureau", it: "Continui a fare trading qualunque cosa faccia la sua app desktop" },
  ctaText: { en: "PickMyTrade runs execution on our servers, so your strategy fires whether or not the Mac desktop app is open, updated, or even installed.", de: "PickMyTrade führt die Ausführung auf unseren Servern aus, sodass Ihre Strategie feuert, egal ob die Mac-Desktop-App geöffnet, aktualisiert oder überhaupt installiert ist.", es: "PickMyTrade ejecuta las órdenes en nuestros servidores, por lo que su estrategia se dispara tanto si la app de escritorio para Mac está abierta, actualizada o incluso instalada, como si no.", fr: "PickMyTrade exécute les ordres sur nos serveurs, de sorte que votre stratégie se déclenche que l'application de bureau Mac soit ouverte, à jour ou même installée.", it: "PickMyTrade esegue gli ordini sui nostri server, quindi la sua strategia scatta che l'app desktop per Mac sia aperta, aggiornata o addirittura installata." },
  ctaButtonText: { en: "Start Your Free 7-Day Trial", de: "Starten Sie Ihre kostenlose 7-Tage-Testphase", es: "Comience su prueba gratuita de 7 días", fr: "Commencez votre essai gratuit de 7 jours", it: "Inizi la prova gratuita di 7 giorni" },
  ctaUrl: "https://app.pickmytrade.trade/?register=true&utm_source=content&utm_medium=debugging",
  faqHeading: { en: "Frequently Asked Questions", de: "Häufig gestellte Fragen", es: "Preguntas frecuentes", fr: "Questions fréquentes", it: "Domande frequenti" },
  faqs: { en: [
    { q: "Why does Install and Relaunch do nothing on the Mac Tradovate app?", a: "The desktop app's built-in auto-updater tries to swap the running app for a newer copy and restart it, but on macOS that quiet in-place swap fails silently when the app isn't running from the Applications folder, when Gatekeeper has the file quarantined, or when the update package didn't download cleanly. Instead of an error, you just get a dead button. The reliable fix is to skip the in-app updater and install the latest build manually from the official download page." },
    { q: "How do I manually update the Tradovate desktop app on Mac?", a: "Go to tradovate.com/devices and click Download Mac to pull the current desktop build. Quit the running app completely with Command-Q, open the downloaded disk image, and drag Tradovate into your Applications folder, replacing the old copy when macOS asks. Launch it from Applications and you're on the latest version, no in-app button required." },
    { q: "Will reinstalling the desktop app delete my account, layouts, or open positions?", a: "No. The desktop app is just a viewer into your account. Your balance, working orders, open positions, and saved workspaces live on Tradovate's servers, not inside the app file on your Mac. Replacing the app and signing back in brings everything down exactly as it was." },
    { q: "Where do I download the latest Tradovate Mac app?", a: "From the official devices page at tradovate.com/devices, which lists a Download Mac link for the macOS desktop build alongside the Windows, web, and mobile options. Always pull the installer from Tradovate's own site rather than a third-party mirror, so you get a current, untampered build." },
    { q: "Why do future updates keep failing on my Mac?", a: "The most common cause is running the app from somewhere other than the Applications folder, like the Downloads folder, the Desktop, or straight out of the mounted disk image. Auto-updaters on macOS generally can't rewrite an app that isn't sitting in Applications, so the update silently no-ops. Move the app into Applications once and future in-app updates have a much better chance of working." },
    { q: "macOS says the app can't be opened or is from an unidentified developer. What do I do?", a: "That's Gatekeeper flagging a freshly downloaded app. Right-click (or Control-click) the Tradovate app in Applications, choose Open, and confirm Open in the dialog. You only have to approve it once. If macOS still blocks it, check System Settings under Privacy and Security for an Open Anyway button tied to the app." },
    { q: "Can I keep trading while I reinstall the desktop app?", a: "Yes. Open the Tradovate web platform in a browser or use the mobile app, and you'll see the same account with full control. Your stops and targets are resting on Tradovate's servers the entire time, so a closed desktop app doesn't leave a position unmanaged while you swap in the new build." },
    { q: "Do I even need the desktop app, or can I just use the web platform?", a: "You can trade the full account from the streaming web platform in any modern browser, so the desktop app is a convenience, not a requirement. If the updater keeps giving you trouble, the browser platform is a perfectly good day-to-day home and it's always on the latest version automatically." },
  ], de: [
    { q: "Warum tut Install and Relaunch in der Tradovate-Mac-App nichts?", a: "Der integrierte Auto-Updater der Desktop-App versucht, die laufende App durch eine neuere Kopie zu ersetzen und neu zu starten. Unter macOS schlägt dieser stille Austausch jedoch lautlos fehl, wenn die App nicht aus dem Ordner Applications läuft, wenn Gatekeeper die Datei unter Quarantäne gestellt hat oder wenn das Update-Paket nicht sauber heruntergeladen wurde. Statt eines Fehlers erhalten Sie nur eine tote Schaltfläche. Die zuverlässige Lösung ist, den In-App-Updater zu überspringen und den neuesten Build manuell von der offiziellen Download-Seite zu installieren." },
    { q: "Wie aktualisiere ich die Tradovate-Desktop-App auf dem Mac manuell?", a: "Gehen Sie zu tradovate.com/devices und klicken Sie auf Download Mac, um den aktuellen Desktop-Build herunterzuladen. Beenden Sie die laufende App vollständig mit Command-Q, öffnen Sie das heruntergeladene Disk-Image und ziehen Sie Tradovate in Ihren Ordner Applications, wobei Sie die alte Kopie ersetzen, wenn macOS fragt. Starten Sie sie aus Applications, und Sie haben die neueste Version, ganz ohne In-App-Schaltfläche." },
    { q: "Löscht eine Neuinstallation der Desktop-App mein Konto, meine Layouts oder offene Positionen?", a: "Nein. Die Desktop-App ist nur ein Sichtfenster in Ihr Konto. Ihr Guthaben, Ihre aktiven Orders, offenen Positionen und gespeicherten Arbeitsbereiche liegen auf den Servern von Tradovate, nicht in der App-Datei auf Ihrem Mac. Wenn Sie die App ersetzen und sich wieder anmelden, wird alles genau so geladen, wie es war." },
    { q: "Wo lade ich die neueste Tradovate-Mac-App herunter?", a: "Auf der offiziellen Geräteseite unter tradovate.com/devices, die einen Link Download Mac für den macOS-Desktop-Build neben den Optionen für Windows, Web und Mobil auflistet. Laden Sie den Installer immer von der eigenen Website von Tradovate und nicht von einem Drittanbieter-Spiegel, damit Sie einen aktuellen, unveränderten Build erhalten." },
    { q: "Warum schlagen künftige Updates auf meinem Mac immer wieder fehl?", a: "Die häufigste Ursache ist, dass die App nicht aus dem Ordner Applications läuft, sondern etwa aus dem Ordner Downloads, vom Schreibtisch oder direkt aus dem eingehängten Disk-Image. Auto-Updater unter macOS können eine App im Allgemeinen nicht überschreiben, wenn sie nicht in Applications liegt, sodass das Update lautlos ins Leere läuft. Verschieben Sie die App einmal nach Applications, und künftige In-App-Updates haben deutlich bessere Chancen zu funktionieren." },
    { q: "macOS meldet, die App könne nicht geöffnet werden oder stamme von einem nicht identifizierten Entwickler. Was tun?", a: "Das ist Gatekeeper, der eine frisch heruntergeladene App markiert. Klicken Sie mit der rechten Maustaste (oder Control-Klick) auf die Tradovate-App in Applications, wählen Sie Open und bestätigen Sie Open im Dialog. Sie müssen sie nur einmal freigeben. Blockiert macOS sie weiterhin, prüfen Sie in System Settings unter Privacy and Security, ob dort eine Schaltfläche Open Anyway für die App erscheint." },
    { q: "Kann ich weiter handeln, während ich die Desktop-App neu installiere?", a: "Ja. Öffnen Sie die Tradovate-Webplattform in einem Browser oder nutzen Sie die mobile App, und Sie sehen dasselbe Konto mit voller Kontrolle. Ihre Stops und Ziele liegen die ganze Zeit auf den Servern von Tradovate, sodass eine geschlossene Desktop-App eine Position nicht unbeaufsichtigt lässt, während Sie den neuen Build einspielen." },
    { q: "Brauche ich die Desktop-App überhaupt, oder kann ich einfach die Webplattform nutzen?", a: "Sie können das gesamte Konto über die Streaming-Webplattform in jedem modernen Browser handeln, die Desktop-App ist also eine Annehmlichkeit, keine Voraussetzung. Wenn der Updater Ihnen ständig Probleme macht, ist die Browser-Plattform ein völlig gutes tägliches Zuhause, und sie ist automatisch immer auf dem neuesten Stand." },
  ], es: [
    { q: "¿Por qué Install and Relaunch no hace nada en la app de Tradovate para Mac?", a: "El actualizador automático integrado de la app de escritorio intenta sustituir la app en ejecución por una copia más reciente y reiniciarla, pero en macOS ese cambio silencioso falla sin avisar cuando la app no se ejecuta desde la carpeta Applications, cuando Gatekeeper tiene el archivo en cuarentena o cuando el paquete de actualización no se descargó correctamente. En lugar de un error, solo obtiene un botón muerto. La solución fiable es omitir el actualizador integrado e instalar manualmente la última versión desde la página oficial de descargas." },
    { q: "¿Cómo actualizo manualmente la app de escritorio de Tradovate en Mac?", a: "Vaya a tradovate.com/devices y haga clic en Download Mac para obtener la versión de escritorio actual. Cierre por completo la app en ejecución con Command-Q, abra la imagen de disco descargada y arrastre Tradovate a su carpeta Applications, reemplazando la copia antigua cuando macOS se lo pida. Ábrala desde Applications y tendrá la última versión, sin necesidad del botón de la app." },
    { q: "¿Reinstalar la app de escritorio borrará mi cuenta, mis diseños o mis posiciones abiertas?", a: "No. La app de escritorio es solo una ventana a su cuenta. Su saldo, órdenes activas, posiciones abiertas y espacios de trabajo guardados residen en los servidores de Tradovate, no en el archivo de la app en su Mac. Al reemplazar la app y volver a iniciar sesión, todo se descarga exactamente como estaba." },
    { q: "¿Dónde descargo la última app de Tradovate para Mac?", a: "Desde la página oficial de dispositivos en tradovate.com/devices, que lista un enlace Download Mac para la versión de escritorio de macOS junto a las opciones de Windows, web y móvil. Descargue siempre el instalador del sitio propio de Tradovate y no de un espejo de terceros, para obtener una versión actual y sin manipular." },
    { q: "¿Por qué siguen fallando las futuras actualizaciones en mi Mac?", a: "La causa más común es ejecutar la app desde un lugar distinto de la carpeta Applications, como la carpeta Downloads, el escritorio o directamente desde la imagen de disco montada. Los actualizadores automáticos de macOS generalmente no pueden reescribir una app que no está en Applications, por lo que la actualización no hace nada en silencio. Mueva la app a Applications una vez y las futuras actualizaciones dentro de la app tendrán muchas más posibilidades de funcionar." },
    { q: "macOS dice que la app no se puede abrir o que es de un desarrollador no identificado. ¿Qué hago?", a: "Es Gatekeeper marcando una app recién descargada. Haga clic derecho (o Control-clic) en la app de Tradovate en Applications, elija Open y confirme Open en el cuadro de diálogo. Solo tiene que aprobarla una vez. Si macOS sigue bloqueándola, revise en System Settings, dentro de Privacy and Security, si aparece un botón Open Anyway asociado a la app." },
    { q: "¿Puedo seguir operando mientras reinstalo la app de escritorio?", a: "Sí. Abra la plataforma web de Tradovate en un navegador o use la app móvil y verá la misma cuenta con control total. Sus stops y objetivos permanecen en los servidores de Tradovate todo el tiempo, por lo que una app de escritorio cerrada no deja una posición sin gestionar mientras instala la nueva versión." },
    { q: "¿Necesito siquiera la app de escritorio, o puedo usar solo la plataforma web?", a: "Puede operar toda la cuenta desde la plataforma web con streaming en cualquier navegador moderno, así que la app de escritorio es una comodidad, no un requisito. Si el actualizador le sigue dando problemas, la plataforma en el navegador es un lugar perfectamente válido para el día a día y siempre está en la última versión automáticamente." },
  ], fr: [
    { q: "Pourquoi Install and Relaunch ne fait-il rien dans l'application Tradovate pour Mac ?", a: "Le programme de mise à jour automatique intégré à l'application de bureau tente de remplacer l'application en cours d'exécution par une copie plus récente puis de la redémarrer, mais sous macOS ce remplacement silencieux échoue sans bruit lorsque l'application ne s'exécute pas depuis le dossier Applications, que Gatekeeper a placé le fichier en quarantaine ou que le paquet de mise à jour ne s'est pas téléchargé correctement. Au lieu d'une erreur, vous obtenez simplement un bouton mort. La solution fiable consiste à ignorer le programme de mise à jour intégré et à installer manuellement la dernière version depuis la page de téléchargement officielle." },
    { q: "Comment mettre à jour manuellement l'application de bureau Tradovate sur Mac ?", a: "Rendez-vous sur tradovate.com/devices et cliquez sur Download Mac pour récupérer la version de bureau actuelle. Quittez complètement l'application en cours avec Command-Q, ouvrez l'image disque téléchargée et faites glisser Tradovate dans votre dossier Applications, en remplaçant l'ancienne copie lorsque macOS vous le demande. Lancez-la depuis Applications et vous avez la dernière version, sans bouton dans l'application." },
    { q: "La réinstallation de l'application de bureau supprimera-t-elle mon compte, mes dispositions ou mes positions ouvertes ?", a: "Non. L'application de bureau n'est qu'une fenêtre sur votre compte. Votre solde, vos ordres en attente, vos positions ouvertes et vos espaces de travail enregistrés se trouvent sur les serveurs de Tradovate, et non dans le fichier de l'application sur votre Mac. Remplacer l'application et vous reconnecter rapatrie tout exactement comme avant." },
    { q: "Où télécharger la dernière application Tradovate pour Mac ?", a: "Depuis la page officielle des appareils, tradovate.com/devices, qui propose un lien Download Mac pour la version de bureau macOS à côté des options Windows, web et mobile. Récupérez toujours l'installateur sur le site de Tradovate lui-même plutôt que sur un miroir tiers, afin d'obtenir une version actuelle et non altérée." },
    { q: "Pourquoi les mises à jour futures échouent-elles sans cesse sur mon Mac ?", a: "La cause la plus fréquente est d'exécuter l'application depuis un autre emplacement que le dossier Applications, comme le dossier Downloads, le Bureau ou directement depuis l'image disque montée. Les programmes de mise à jour automatique de macOS ne peuvent généralement pas réécrire une application qui ne se trouve pas dans Applications, si bien que la mise à jour ne fait silencieusement rien. Déplacez l'application dans Applications une fois, et les futures mises à jour intégrées auront bien plus de chances de fonctionner." },
    { q: "macOS indique que l'application ne peut pas être ouverte ou provient d'un développeur non identifié. Que faire ?", a: "C'est Gatekeeper qui signale une application fraîchement téléchargée. Faites un clic droit (ou Control-clic) sur l'application Tradovate dans Applications, choisissez Open et confirmez Open dans la boîte de dialogue. Vous n'avez à l'approuver qu'une seule fois. Si macOS la bloque toujours, vérifiez dans System Settings sous Privacy and Security s'il existe un bouton Open Anyway associé à l'application." },
    { q: "Puis-je continuer à trader pendant que je réinstalle l'application de bureau ?", a: "Oui. Ouvrez la plateforme web de Tradovate dans un navigateur ou utilisez l'application mobile, et vous verrez le même compte avec un contrôle total. Vos stops et objectifs restent en place sur les serveurs de Tradovate pendant tout ce temps, de sorte qu'une application de bureau fermée ne laisse pas une position sans gestion pendant que vous installez la nouvelle version." },
    { q: "Ai-je vraiment besoin de l'application de bureau, ou puis-je simplement utiliser la plateforme web ?", a: "Vous pouvez trader l'intégralité du compte depuis la plateforme web en streaming dans n'importe quel navigateur moderne ; l'application de bureau est donc un confort, pas une obligation. Si le programme de mise à jour continue de vous poser problème, la plateforme dans le navigateur est un excellent espace de travail au quotidien et elle est toujours automatiquement à la dernière version." },
  ], it: [
    { q: "Perché Install and Relaunch non fa nulla nell'app Tradovate per Mac?", a: "L'auto-updater integrato nell'app desktop cerca di sostituire l'app in esecuzione con una copia più recente e di riavviarla, ma su macOS questa sostituzione silenziosa fallisce senza avvisare quando l'app non è eseguita dalla cartella Applications, quando Gatekeeper ha messo il file in quarantena o quando il pacchetto di aggiornamento non è stato scaricato correttamente. Invece di un errore, ottiene solo un pulsante morto. La soluzione affidabile è saltare l'updater integrato e installare manualmente l'ultima versione dalla pagina di download ufficiale." },
    { q: "Come aggiorno manualmente l'app desktop di Tradovate su Mac?", a: "Vada su tradovate.com/devices e faccia clic su Download Mac per scaricare la versione desktop attuale. Chiuda completamente l'app in esecuzione con Command-Q, apra l'immagine disco scaricata e trascini Tradovate nella cartella Applications, sostituendo la vecchia copia quando macOS lo chiede. La avvii da Applications e avrà l'ultima versione, senza bisogno del pulsante nell'app." },
    { q: "Reinstallare l'app desktop eliminerà il mio account, i layout o le posizioni aperte?", a: "No. L'app desktop è solo una finestra sul suo account. Il suo saldo, gli ordini attivi, le posizioni aperte e gli spazi di lavoro salvati risiedono sui server di Tradovate, non nel file dell'app sul suo Mac. Sostituire l'app e accedere di nuovo riporta tutto esattamente com'era." },
    { q: "Dove scarico l'ultima app Tradovate per Mac?", a: "Dalla pagina ufficiale dei dispositivi su tradovate.com/devices, che elenca un link Download Mac per la versione desktop di macOS accanto alle opzioni per Windows, web e mobile. Scarichi sempre l'installer dal sito di Tradovate e non da un mirror di terze parti, così ottiene una versione aggiornata e non manomessa." },
    { q: "Perché gli aggiornamenti futuri continuano a fallire sul mio Mac?", a: "La causa più comune è eseguire l'app da un posto diverso dalla cartella Applications, come la cartella Downloads, la Scrivania o direttamente dall'immagine disco montata. Gli auto-updater di macOS in genere non possono riscrivere un'app che non si trova in Applications, quindi l'aggiornamento non fa nulla in silenzio. Sposti l'app in Applications una volta e i futuri aggiornamenti nell'app avranno molte più probabilità di funzionare." },
    { q: "macOS dice che l'app non può essere aperta o proviene da uno sviluppatore non identificato. Cosa faccio?", a: "È Gatekeeper che segnala un'app appena scaricata. Faccia clic con il tasto destro (o Control-clic) sull'app Tradovate in Applications, scelga Open e confermi Open nella finestra di dialogo. Deve approvarla una sola volta. Se macOS la blocca ancora, controlli in System Settings, sotto Privacy and Security, se compare un pulsante Open Anyway associato all'app." },
    { q: "Posso continuare a fare trading mentre reinstallo l'app desktop?", a: "Sì. Apra la piattaforma web di Tradovate in un browser o usi l'app mobile e vedrà lo stesso account con pieno controllo. I suoi stop e target restano sui server di Tradovate per tutto il tempo, quindi un'app desktop chiusa non lascia una posizione senza gestione mentre inserisce la nuova versione." },
    { q: "Ho davvero bisogno dell'app desktop, o posso usare solo la piattaforma web?", a: "Può operare sull'intero account dalla piattaforma web in streaming in qualsiasi browser moderno, quindi l'app desktop è una comodità, non un requisito. Se l'updater continua a darle problemi, la piattaforma nel browser è una casa quotidiana perfettamente valida ed è sempre automaticamente all'ultima versione." },
