---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "prop-credentials-spaces-capitalization";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/debugging/${SLUG}`;

const META_TITLE = "Tradovate Prop Login Fails: Spaces / Capitalization";
const META_DESCRIPTION =
  "Tradovate prop login rejected? Remove hidden spaces from your credentials and keep the password's leading capital to fix incorrect-credential errors.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Tradovate-Prop-Login schlägt fehl: Leerzeichen / Groß- und Kleinschreibung", es: "El acceso prop a Tradovate falla: espacios / mayúsculas", fr: "Échec de connexion prop à Tradovate : espaces / majuscules", it: "Login prop Tradovate non riuscito: spazi / maiuscole" },
  dek: { en: "You copy the username and password straight off your prop firm dashboard, paste them into Tradovate, and get bounced with 'Username or password is incorrect.' Almost every time, the culprit is something you can't see.", de: "Sie kopieren Benutzername und Passwort direkt aus dem Dashboard Ihrer Prop-Firma, fügen sie in Tradovate ein und werden mit „Username or password is incorrect“ abgewiesen. Fast immer liegt die Ursache in etwas, das Sie nicht sehen können.", es: "Copia el usuario y la contraseña directamente del panel de su firma prop, los pega en Tradovate y le rebota con “Username or password is incorrect”. Casi siempre, el culpable es algo que no puede ver.", fr: "Vous copiez l'identifiant et le mot de passe depuis le tableau de bord de votre firme prop, les collez dans Tradovate et êtes rejeté avec « Username or password is incorrect ». Presque à chaque fois, le coupable est quelque chose que vous ne pouvez pas voir.", it: "Copia nome utente e password direttamente dalla dashboard della sua società prop, li incolla in Tradovate e viene respinto con “Username or password is incorrect”. Quasi sempre il colpevole è qualcosa che non può vedere." },
  readTime: { en: "7 min read", de: "7 Min. Lesezeit", es: "Lectura de 7 min", fr: "Lecture : 7 min", it: "Lettura di 7 min" },
  lastUpdated: "2026-07-10",
  blocks: { en: [
    { type: "paragraph", html: "You copy the username and password straight off your prop firm dashboard, paste them into Tradovate, hit log in, and get bounced with <strong class='text-white'>“Username or password is incorrect.”</strong> You paste again. Same wall. The credentials look perfect on screen, which is exactly what makes this one so maddening. Almost every time, the culprit is something you can't see: a <strong class='text-white'>stray space</strong> that rode along when you copied, or a <strong class='text-white'>capital letter that got flipped to lowercase</strong> the instant your browser pasted the password. Tradovate treats both the username and password as case-sensitive and space-sensitive, so a single invisible character is enough to reject a login that's otherwise correct. This guide walks through cleaning up the copy-paste, restoring that leading capital, and killing autofill so the login goes through, plus how routing your trades through PickMyTrade means you link the account once instead of re-typing fragile credentials every session." },
    {
      type: "checklist",
      heading: "Quick Checklist for the Spaces / Capitalization Login Error",
      items: [
        "<strong class='text-white'>Use the dashboard copy button.</strong> Copy the username and password with the copy icon next to each field on your prop firm dashboard, not by dragging to select the text.",
        "<strong class='text-white'>Delete stray spaces.</strong> Check for a space at the very start or very end of each field; a leading or trailing space fails the login even when the rest is right.",
        "<strong class='text-white'>Keep the leading capital.</strong> If the password starts with a capital letter, confirm it's still uppercase after pasting; some browsers lowercase the first character.",
        "<strong class='text-white'>Match the exact case.</strong> Username and password are case-sensitive; enter them character for character as shown on the dashboard.",
        "<strong class='text-white'>Turn off autofill.</strong> Don't let a saved personal Tradovate login overwrite your prop credentials; type or paste manually instead.",
        "<strong class='text-white'>Right account, right environment.</strong> Use the credentials from the top of your prop dashboard and select Simulation/Demo (not Live) for an evaluation.",
      ],
    },
    { type: "heading", text: "What “Username or Password Is Incorrect” Really Means on a Prop Account" },
    { type: "paragraph", html: "On a self-funded Tradovate account you set your own login, so when something breaks you can just reset the password. A prop evaluation is different. The firm issues your Tradovate credentials, they live at the top of your prop dashboard, and you generally can't change them, the username often follows a fixed, firm-specific format. That means you're stuck entering an exact string the firm handed you, and Tradovate checks it strictly." },
    { type: "paragraph", html: "Strictly is the key word. Tradovate credentials are <strong class='text-white'>case-sensitive</strong>, so “Apex” and “apex” are not the same, and a password that opens with a capital letter will be rejected if that letter arrives lowercase. Tradovate is also unforgiving about whitespace: a space at the beginning or end of the username or password counts as part of the string, so a credential that reads correctly to your eye still fails because there's an invisible character hanging off the edge. Neither problem shows up on screen, the password field masks its characters, and a trailing space looks exactly like nothing at all, which is why the same “correct” login gets rejected over and over." },
    { type: "heading", text: "Top Causes of the Spaces / Capitalization Login Failure" },
    { type: "heading", text: "1. A stray space rode along when you copied" },
    { type: "paragraph", html: "Selecting credentials by click-dragging across the dashboard text is the classic way to grab an extra space. Highlight one character too far and you pull a trailing space into the clipboard; start a hair early and you get a leading one. Some dashboards also pad the displayed value, so even a careful drag captures whitespace. Tradovate then reads “yourpassword ” as a different string from “yourpassword,” and rejects it." },
    { type: "heading", text: "2. Your browser lowercased the first letter of the password on paste" },
    { type: "paragraph", html: "This one catches people who did everything else right. Some browsers and mobile keyboards apply auto-capitalization to input fields and, on paste, flip the leading character of your password to lowercase. If your password should start with a capital “T” and it lands as “t,” the login fails even though every other character is perfect, and because the field is masked, you never see the swap." },
    { type: "heading", text: "3. Autofill filled the wrong (personal) credentials" },
    { type: "paragraph", html: "If you've ever logged into a personal Tradovate account in the same browser, your password manager or the browser's built-in autofill may quietly drop those saved credentials into the login form. They look legitimate, they fill instantly, and they're completely wrong for a prop evaluation, the personal login simply doesn't exist on the firm's account. The result is the same “incorrect” error, this time because you're submitting an entirely different account's details." },
    { type: "heading", text: "4. You typed it by hand and a case slipped" },
    { type: "paragraph", html: "Prop passwords mix uppercase, lowercase, digits, and symbols. Type one by hand and it's easy to hold Shift a beat too long, miss a capital, or read an uppercase “I” as a lowercase “l.” Each is a case mismatch, and case mismatches fail. Manual entry is a solid fallback for the paste problems above, but only if you match the case exactly." },
    { type: "heading", text: "5. You're using credentials from the wrong place or wrong environment" },
    { type: "paragraph", html: "Two neighbors of the spaces/capitalization problem produce the same rejection. First, pulling the login from anywhere other than the current prop dashboard, an old email, a stale note, last cycle's account, means the credentials no longer match. Second, choosing the wrong environment: an evaluation login lives in Simulation/Demo, so selecting Live fails because those credentials aren't provisioned there. Rule both out once your copy-paste is clean." },
    { type: "heading", text: "How to Fix the Spaces / Capitalization Login Error: Step-by-Step" },
    { type: "heading", text: "Use the dashboard copy button (cleanest path)" },
    { type: "paragraph", html: "The single best habit is to stop hand-selecting credentials and let the dashboard hand them to you clean. Most prop firm dashboards place a small copy icon right next to the Tradovate username and password so you can grab the exact value with no surrounding whitespace." },
    {
      type: "steps",
      items: [
        { title: "Find the credentials block", html: "Log in to your prop firm dashboard and find the Tradovate credentials block, usually near the top of the account page." },
        { title: "Click the copy icon for the username", html: "Click the <strong class='text-white'>copy icon</strong> beside the <strong class='text-white'>username</strong> field, don't click-drag to select the text." },
        { title: "Paste and repeat for the password", html: "Paste it into Tradovate's username field, then repeat with the copy icon beside the <strong class='text-white'>password</strong>." },
        { title: "Submit", html: "Submit. Using the copy button removes the two most common failure points in one move: it grabs the value with no leading or trailing space, and it copies the case exactly as stored." },
      ],
    },
    { type: "heading", text: "Hunt down and delete stray spaces" },
    { type: "paragraph", html: "If your dashboard has no copy button, or you already pasted and it failed, check the fields for whitespace before you try again." },
    {
      type: "steps",
      items: [
        { title: "Check the end of the username field", html: "Click into the <strong class='text-white'>username</strong> field and press <strong class='text-white'>End</strong> (or tap to the far right on mobile) to move the cursor past the last character. If the cursor sits a space beyond the text, backspace once to delete the trailing space." },
        { title: "Check the start of the field", html: "Press <strong class='text-white'>Home</strong> (or tap to the far left) to check the start of the field, and delete any leading space the same way." },
        { title: "Repeat on the password field", html: "Repeat both checks on the <strong class='text-white'>password</strong> field. Since it's masked, use the “show password” eye icon if the login form offers one so you can actually see a stray space." },
        { title: "Or reset and re-paste", html: "As a faster reset, clear both fields completely and re-paste using the copy button, or type the credentials fresh." },
      ],
    },
    { type: "heading", text: "Restore the password's leading capital" },
    { type: "paragraph", html: "When the login fails after a clean paste and there's no stray space, suspect the lowercased first letter." },
    {
      type: "steps",
      items: [
        { title: "Compare the first character", html: "Compare the first character of your password against the exact value on your dashboard. If the dashboard shows a capital and your field shows lowercase, that's your problem." },
        { title: "Correct it and resubmit", html: "Use the “show password” eye icon if available, correct the first character to uppercase, and submit again." },
        { title: "Type by hand if it keeps happening", html: "If your browser keeps flipping it on every paste, skip pasting entirely: <strong class='text-white'>type the password by hand</strong>, holding Shift for the capital, and match the rest of the case character for character." },
        { title: "Disable keyboard auto-capitalization", html: "On mobile, turn off auto-capitalization/auto-correct for the field if your keyboard allows it, then re-enter the password." },
      ],
    },
    { type: "heading", text: "Kill autofill and rule out the wrong account" },
    {
      type: "steps",
      items: [
        { title: "Clear autofilled fields", html: "If the login form pre-populated on its own, clear both fields. Decline any autofill prompt, and if your password manager saved a personal Tradovate login, don't let it fill a prop evaluation." },
        { title: "Re-enter from the current dashboard", html: "Re-enter the credentials from the top of your <strong class='text-white'>current</strong> prop dashboard, using the copy button or careful manual typing." },
        { title: "Select the right environment", html: "At the login screen, select the correct environment, <strong class='text-white'>Simulation/Demo</strong> for an evaluation, not Live, since evaluation credentials only exist in the simulated environment." },
        { title: "Pause if you've failed repeatedly", html: "If you've failed several logins in a row, pause. Repeated failed attempts can trigger a temporary lockout, and hammering the button makes it worse. Wait, confirm the exact credentials, and try once, cleanly." },
      ],
    },
    { type: "quote", html: "Note: prop firms differ on account formats, environment selection, and lockout timing, and those details change, check your firm's current dashboard and help center for its exact process rather than assuming another firm's steps apply." },
    { type: "heading", text: "Troubleshooting Table" },
    {
      type: "table",
      headers: ["What you see", "Likely cause", "Fix"],
      rows: [
        ["“Username or password is incorrect” after a clean-looking paste", "Stray leading/trailing space copied with the credential", "Use the dashboard copy button; press Home/End and delete any space at the start or end of each field"],
        ["Password rejected but every character looks right", "Browser lowercased the first letter on paste", "Reveal the password, capitalize the first character, or type it by hand matching the dashboard case"],
        ["Form fills itself, then fails", "Autofill entered saved personal Tradovate credentials", "Clear the fields, decline autofill, re-enter the prop dashboard credentials manually"],
        ["Login fails even after cleaning the fields", "Wrong environment selected (Live instead of Simulation/Demo)", "Choose Simulation/Demo for an evaluation account and log in again"],
        ["Manual typing keeps getting rejected", "A case mismatch somewhere in the string", "Match uppercase/lowercase exactly; watch for capital I vs lowercase l and 0 vs O"],
        ["Repeated attempts now all fail", "Temporary lockout from too many failed logins", "Stop retrying, wait, confirm the exact credentials, then attempt once cleanly"],
      ],
    },
    { type: "heading", text: "Prevent This with PickMyTrade" },
    { type: "paragraph", html: "Fragile credentials are worst when you re-enter them constantly, a new browser, a phone, a fresh session every morning, because each re-type is another chance to smuggle in a space or drop a capital. PickMyTrade lets you link your Tradovate account once and routes your TradingView alerts to it automatically, so today's painful login isn't one you have to nail again tomorrow." },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Link once, trade hands-off</strong>, Connect the account a single time; there's no login screen to re-type before every session.",
        "<strong class='text-white'>Fewer places to fat-finger a credential</strong>, One clean connection instead of re-pasting the same case-sensitive string into multiple platforms.",
        "<strong class='text-white'>Live and demo aware</strong>, Point alerts at the exact account and environment you intend, so an evaluation routes where it should.",
        "<strong class='text-white'>Multi-account sync</strong>, Mirror one alert across several Tradovate accounts from a single place, without logging each one in by hand.",
      ],
    },
  ], de: [
    { type: "paragraph",html: "Sie kopieren Benutzername und Passwort direkt aus dem Dashboard Ihrer Prop-Firma, fügen sie in Tradovate ein, klicken auf Anmelden und werden mit <strong class='text-white'>„Username or password is incorrect.“</strong> abgewiesen. Sie fügen erneut ein. Gleiche Wand. Die Zugangsdaten sehen auf dem Bildschirm perfekt aus, und genau das macht es so zermürbend. Fast immer liegt die Ursache in etwas, das Sie nicht sehen können: einem <strong class='text-white'>verirrten Leerzeichen</strong>, das beim Kopieren mitgekommen ist, oder einem <strong class='text-white'>Großbuchstaben, der in dem Moment, in dem Ihr Browser das Passwort einfügte, zum Kleinbuchstaben wurde</strong>. Tradovate behandelt sowohl Benutzername als auch Passwort als abhängig von Groß-/Kleinschreibung und Leerzeichen, ein einziges unsichtbares Zeichen genügt also, um einen sonst korrekten Login abzulehnen. Dieser Leitfaden zeigt, wie Sie das Kopieren und Einfügen bereinigen, den führenden Großbuchstaben wiederherstellen und Autofill ausschalten, damit der Login klappt, und wie das Routing Ihrer Trades über PickMyTrade bedeutet, dass Sie das Konto einmal verknüpfen, statt jede Sitzung empfindliche Zugangsdaten neu einzutippen." },
    {
      type: "checklist",
      heading: "Kurze Checkliste für den Fehler mit Leerzeichen / Groß- und Kleinschreibung",
      items: [
        "<strong class='text-white'>Nutzen Sie den Kopieren-Button des Dashboards.</strong> Kopieren Sie Benutzername und Passwort über das Kopier-Symbol neben jedem Feld im Dashboard Ihrer Prop-Firma, nicht durch Markieren des Textes mit der Maus.",
        "<strong class='text-white'>Löschen Sie verirrte Leerzeichen.</strong> Prüfen Sie auf ein Leerzeichen ganz am Anfang oder Ende jedes Feldes; ein führendes oder nachgestelltes Leerzeichen lässt den Login scheitern, auch wenn der Rest stimmt.",
        "<strong class='text-white'>Behalten Sie den führenden Großbuchstaben.</strong> Beginnt das Passwort mit einem Großbuchstaben, vergewissern Sie sich, dass er nach dem Einfügen noch groß ist; manche Browser schreiben das erste Zeichen klein.",
        "<strong class='text-white'>Beachten Sie die exakte Schreibung.</strong> Benutzername und Passwort unterscheiden zwischen Groß- und Kleinschreibung; geben Sie sie Zeichen für Zeichen so ein, wie sie im Dashboard stehen.",
        "<strong class='text-white'>Schalten Sie Autofill aus.</strong> Lassen Sie nicht zu, dass ein gespeicherter persönlicher Tradovate-Login Ihre Prop-Zugangsdaten überschreibt; tippen Sie stattdessen manuell ein oder fügen Sie ein.",
        "<strong class='text-white'>Richtiges Konto, richtige Umgebung.</strong> Verwenden Sie die Zugangsdaten vom oberen Bereich Ihres Prop-Dashboards und wählen Sie für eine Evaluierung Simulation/Demo (nicht Live).",
      ],
    },
    { type: "heading",text: "Was „Username or Password Is Incorrect“ bei einem Prop-Konto wirklich bedeutet" },
    { type: "paragraph",html: "Bei einem selbst finanzierten Tradovate-Konto legen Sie Ihren Login selbst fest, wenn etwas nicht funktioniert, können Sie also einfach das Passwort zurücksetzen. Eine Prop-Evaluierung ist anders. Die Firma stellt Ihre Tradovate-Zugangsdaten aus, sie stehen oben in Ihrem Prop-Dashboard, und Sie können sie in der Regel nicht ändern, der Benutzername folgt oft einem festen, firmenspezifischen Format. Das heißt, Sie müssen eine exakte Zeichenfolge eingeben, die die Firma Ihnen gegeben hat, und Tradovate prüft sie streng." },
    { type: "paragraph",html: "Streng ist das Schlüsselwort. Tradovate-Zugangsdaten unterscheiden <strong class='text-white'>zwischen Groß- und Kleinschreibung</strong>, „Apex“ und „apex“ sind also nicht dasselbe, und ein Passwort, das mit einem Großbuchstaben beginnt, wird abgelehnt, wenn dieser Buchstabe klein ankommt. Tradovate ist auch gnadenlos bei Leerzeichen: Ein Leerzeichen am Anfang oder Ende des Benutzernamens oder Passworts zählt als Teil der Zeichenfolge, sodass eine Zugangsdate, die für Ihr Auge korrekt aussieht, trotzdem scheitert, weil ein unsichtbares Zeichen am Rand hängt. Keines der Probleme ist auf dem Bildschirm sichtbar, das Passwortfeld maskiert seine Zeichen, und ein nachgestelltes Leerzeichen sieht aus wie nichts, weshalb derselbe „korrekte“ Login immer wieder abgelehnt wird." },
    { type: "heading",text: "Die häufigsten Ursachen für den Login-Fehler durch Leerzeichen / Groß- und Kleinschreibung" },
    { type: "heading",text: "1. Beim Kopieren ist ein verirrtes Leerzeichen mitgekommen" },
    { type: "paragraph",html: "Zugangsdaten durch Ziehen mit der Maus über den Dashboard-Text zu markieren ist der klassische Weg, ein überzähliges Leerzeichen zu erwischen. Markieren Sie ein Zeichen zu weit, landet ein nachgestelltes Leerzeichen in der Zwischenablage; beginnen Sie einen Hauch zu früh, ein führendes. Manche Dashboards füllen den angezeigten Wert außerdem auf, sodass selbst ein sorgfältiges Ziehen Leerraum erfasst. Tradovate liest dann „yourpassword “ als eine andere Zeichenfolge als „yourpassword“ und weist sie ab." },
    { type: "heading",text: "2. Ihr Browser hat beim Einfügen den ersten Buchstaben des Passworts kleingeschrieben" },
    { type: "paragraph",html: "Diese Ursache erwischt Leute, die alles andere richtig gemacht haben. Manche Browser und mobile Tastaturen wenden bei Eingabefeldern automatische Großschreibung an und kehren beim Einfügen das erste Zeichen Ihres Passworts in einen Kleinbuchstaben um. Soll Ihr Passwort mit einem großen „T“ beginnen und kommt es als „t“ an, schlägt der Login fehl, obwohl jedes andere Zeichen perfekt ist, und weil das Feld maskiert ist, sehen Sie den Tausch nie." },
    { type: "heading",text: "3. Autofill hat die falschen (persönlichen) Zugangsdaten eingetragen" },
    { type: "paragraph",html: "Wenn Sie sich jemals im selben Browser bei einem persönlichen Tradovate-Konto angemeldet haben, trägt Ihr Passwort-Manager oder das integrierte Autofill des Browsers diese gespeicherten Zugangsdaten möglicherweise unbemerkt in das Login-Formular ein. Sie sehen legitim aus, füllen sich sofort und sind für eine Prop-Evaluierung völlig falsch, der persönliche Login existiert beim Konto der Firma schlicht nicht. Das Ergebnis ist derselbe „incorrect“-Fehler, diesmal weil Sie die Daten eines ganz anderen Kontos senden." },
    { type: "heading",text: "4. Sie haben es von Hand getippt und eine Schreibung ist verrutscht" },
    { type: "paragraph",html: "Prop-Passwörter mischen Groß- und Kleinbuchstaben, Ziffern und Symbole. Von Hand getippt ist es leicht, die Umschalttaste einen Takt zu lange zu halten, einen Großbuchstaben zu verpassen oder ein großes „I“ als kleines „l“ zu lesen. Jedes davon ist eine Abweichung in der Schreibung, und solche Abweichungen scheitern. Manuelle Eingabe ist ein solider Ausweg bei den obigen Einfüge-Problemen, aber nur, wenn Sie die Schreibung exakt treffen." },
    { type: "heading",text: "5. Sie verwenden Zugangsdaten vom falschen Ort oder aus der falschen Umgebung" },
    { type: "paragraph",html: "Zwei Nachbarn des Leerzeichen-/Schreibungsproblems erzeugen dieselbe Ablehnung. Erstens: Wenn Sie den Login von irgendwo anders als aus dem aktuellen Prop-Dashboard nehmen, einer alten E-Mail, einer veralteten Notiz, dem Konto vom letzten Zyklus, stimmen die Zugangsdaten nicht mehr. Zweitens: die falsche Umgebung. Ein Evaluierungs-Login liegt in Simulation/Demo, die Auswahl von Live scheitert daher, weil diese Zugangsdaten dort nicht bereitgestellt sind. Schließen Sie beides aus, sobald Ihr Kopieren und Einfügen sauber ist." },
    { type: "heading",text: "Den Fehler mit Leerzeichen / Groß- und Kleinschreibung beheben: Schritt für Schritt" },
    { type: "heading",text: "Den Kopieren-Button des Dashboards nutzen (sauberster Weg)" },
    { type: "paragraph",html: "Die beste Gewohnheit ist, Zugangsdaten nicht mehr von Hand zu markieren und sie sich vom Dashboard sauber liefern zu lassen. Die meisten Prop-Firmen-Dashboards platzieren ein kleines Kopier-Symbol direkt neben dem Tradovate-Benutzernamen und -Passwort, damit Sie den exakten Wert ohne umgebenden Leerraum erhalten." },
    {
      type: "steps",
      items: [
        { title: "Den Zugangsdatenblock finden", html: "Melden Sie sich im Dashboard Ihrer Prop-Firma an und suchen Sie den Block mit den Tradovate-Zugangsdaten, meist oben auf der Kontoseite." },
        { title: "Das Kopier-Symbol für den Benutzernamen klicken", html: "Klicken Sie auf das <strong class='text-white'>Kopier-Symbol</strong> neben dem Feld <strong class='text-white'>Benutzername</strong>, markieren Sie den Text nicht per Ziehen." },
        { title: "Einfügen und für das Passwort wiederholen", html: "Fügen Sie ihn in das Benutzernamenfeld von Tradovate ein und wiederholen Sie den Vorgang mit dem Kopier-Symbol neben dem <strong class='text-white'>Passwort</strong>." },
        { title: "Absenden", html: "Absenden. Der Kopieren-Button beseitigt die beiden häufigsten Fehlerquellen in einem Zug: Er übernimmt den Wert ohne führendes oder nachgestelltes Leerzeichen und kopiert die Schreibung exakt wie gespeichert." },
      ],
    },
    { type: "heading",text: "Verirrte Leerzeichen aufspüren und löschen" },
    { type: "paragraph",html: "Hat Ihr Dashboard keinen Kopieren-Button oder haben Sie schon eingefügt und es ist fehlgeschlagen, prüfen Sie die Felder auf Leerraum, bevor Sie es erneut versuchen." },
    {
      type: "steps",
      items: [
        { title: "Das Ende des Benutzernamenfeldes prüfen", html: "Klicken Sie in das Feld <strong class='text-white'>Benutzername</strong> und drücken Sie <strong class='text-white'>End</strong> (oder tippen Sie auf Mobilgeräten ganz nach rechts), um den Cursor hinter das letzte Zeichen zu setzen. Steht der Cursor ein Leerzeichen hinter dem Text, löschen Sie mit der Rücktaste einmal das nachgestellte Leerzeichen." },
        { title: "Den Anfang des Feldes prüfen", html: "Drücken Sie <strong class='text-white'>Home</strong> (oder tippen Sie ganz nach links), um den Anfang des Feldes zu prüfen, und löschen Sie ein führendes Leerzeichen auf dieselbe Weise." },
        { title: "Beim Passwortfeld wiederholen", html: "Wiederholen Sie beide Prüfungen beim Feld <strong class='text-white'>Passwort</strong>. Da es maskiert ist, nutzen Sie das Augen-Symbol „Passwort anzeigen“, falls das Login-Formular eines bietet, damit Sie ein verirrtes Leerzeichen tatsächlich sehen." },
        { title: "Oder zurücksetzen und neu einfügen", html: "Als schnellere Rücksetzung leeren Sie beide Felder vollständig und fügen mit dem Kopieren-Button neu ein oder tippen die Zugangsdaten neu." },
      ],
    },
    { type: "heading",text: "Den führenden Großbuchstaben des Passworts wiederherstellen" },
    { type: "paragraph",html: "Schlägt der Login nach sauberem Einfügen und ohne verirrtes Leerzeichen fehl, vermuten Sie den kleingeschriebenen ersten Buchstaben." },
    {
      type: "steps",
      items: [
        { title: "Das erste Zeichen vergleichen", html: "Vergleichen Sie das erste Zeichen Ihres Passworts mit dem exakten Wert in Ihrem Dashboard. Zeigt das Dashboard einen Großbuchstaben und Ihr Feld einen Kleinbuchstaben, ist das Ihr Problem." },
        { title: "Korrigieren und erneut absenden", html: "Nutzen Sie das Augen-Symbol „Passwort anzeigen“, falls vorhanden, korrigieren Sie das erste Zeichen zu einem Großbuchstaben und senden Sie erneut ab." },
        { title: "Von Hand tippen, wenn es immer wieder passiert", html: "Schreibt Ihr Browser es bei jedem Einfügen um, verzichten Sie ganz aufs Einfügen: <strong class='text-white'>Tippen Sie das Passwort von Hand</strong>, halten Sie für den Großbuchstaben die Umschalttaste, und treffen Sie die Schreibung des Rests Zeichen für Zeichen." },
        { title: "Automatische Großschreibung der Tastatur deaktivieren", html: "Schalten Sie auf Mobilgeräten die automatische Großschreibung/Autokorrektur für das Feld aus, falls Ihre Tastatur das erlaubt, und geben Sie das Passwort dann erneut ein." },
      ],
    },
    { type: "heading",text: "Autofill ausschalten und das falsche Konto ausschließen" },
    {
      type: "steps",
      items: [
        { title: "Automatisch ausgefüllte Felder leeren", html: "Hat sich das Login-Formular selbst vorbelegt, leeren Sie beide Felder. Lehnen Sie jede Autofill-Aufforderung ab, und wenn Ihr Passwort-Manager einen persönlichen Tradovate-Login gespeichert hat, lassen Sie ihn keine Prop-Evaluierung ausfüllen." },
        { title: "Aus dem aktuellen Dashboard neu eingeben", html: "Geben Sie die Zugangsdaten vom oberen Bereich Ihres <strong class='text-white'>aktuellen</strong> Prop-Dashboards neu ein, mit dem Kopieren-Button oder sorgfältiger manueller Eingabe." },
        { title: "Die richtige Umgebung wählen", html: "Wählen Sie auf dem Login-Bildschirm die richtige Umgebung, <strong class='text-white'>Simulation/Demo</strong> für eine Evaluierung, nicht Live, da Evaluierungs-Zugangsdaten nur in der simulierten Umgebung existieren." },
        { title: "Bei wiederholten Fehlversuchen pausieren", html: "Haben Sie mehrere Logins hintereinander verfehlt, pausieren Sie. Wiederholte Fehlversuche können eine vorübergehende Sperre auslösen, und das Hämmern auf den Button macht es schlimmer. Warten Sie, bestätigen Sie die exakten Zugangsdaten und versuchen Sie es einmal sauber." },
      ],
    },
    { type: "quote",html: "Hinweis: Prop-Firmen unterscheiden sich bei Kontoformaten, Umgebungsauswahl und Sperrzeiten, und diese Details ändern sich. Prüfen Sie das aktuelle Dashboard und Help Center Ihrer Firma für deren genauen Ablauf, statt anzunehmen, dass die Schritte einer anderen Firma gelten." },
    { type: "heading",text: "Tabelle zur Fehlerbehebung" },
    { type: "table", headers: ["Was Sie sehen","Wahrscheinliche Ursache","Lösung"], rows: [
      ["„Username or password is incorrect“ nach einem sauber aussehenden Einfügen","Verirrtes führendes/nachgestelltes Leerzeichen wurde mitkopiert","Kopieren-Button des Dashboards nutzen; Home/End drücken und jedes Leerzeichen am Anfang oder Ende jedes Feldes löschen"],
      ["Passwort wird abgelehnt, obwohl jedes Zeichen richtig aussieht","Browser hat den ersten Buchstaben beim Einfügen kleingeschrieben","Passwort anzeigen, ersten Buchstaben großschreiben oder von Hand tippen, passend zur Schreibung im Dashboard"],
      ["Formular füllt sich selbst, dann Fehlschlag","Autofill hat gespeicherte persönliche Tradovate-Zugangsdaten eingetragen","Felder leeren, Autofill ablehnen, Prop-Dashboard-Zugangsdaten manuell neu eingeben"],
      ["Login scheitert auch nach Bereinigung der Felder","Falsche Umgebung gewählt (Live statt Simulation/Demo)","Für ein Evaluierungskonto Simulation/Demo wählen und erneut anmelden"],
      ["Manuelles Tippen wird immer wieder abgelehnt","Eine Abweichung in der Schreibung irgendwo in der Zeichenfolge","Groß-/Kleinschreibung exakt treffen; auf großes I gegenüber kleinem l und 0 gegenüber O achten"],
      ["Wiederholte Versuche scheitern jetzt alle","Vorübergehende Sperre wegen zu vieler fehlgeschlagener Logins","Wiederholen stoppen, warten, exakte Zugangsdaten bestätigen, dann einmal sauber versuchen"],
    ] },
    { type: "heading",text: "Vorbeugen mit PickMyTrade" },
    { type: "paragraph",html: "Empfindliche Zugangsdaten sind am schlimmsten, wenn Sie sie ständig neu eingeben, ein neuer Browser, ein Telefon, jeden Morgen eine frische Sitzung, denn jedes erneute Tippen ist eine weitere Chance, ein Leerzeichen einzuschleusen oder einen Großbuchstaben zu verlieren. Mit PickMyTrade verknüpfen Sie Ihr Tradovate-Konto einmal, und Ihre TradingView-Alerts werden automatisch dorthin geroutet, sodass der heutige leidige Login keiner ist, den Sie morgen erneut treffen müssen." },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Einmal verknüpfen, freihändig handeln</strong>, verbinden Sie das Konto ein einziges Mal; vor jeder Sitzung muss kein Login-Bildschirm neu getippt werden.",
        "<strong class='text-white'>Weniger Stellen für Tippfehler bei Zugangsdaten</strong>, eine saubere Verbindung statt dieselbe schreibungsabhängige Zeichenfolge immer wieder in mehrere Plattformen einzufügen.",
        "<strong class='text-white'>Live- und Demo-bewusst</strong>, richten Sie Alerts auf genau das Konto und die Umgebung, die Sie beabsichtigen, damit eine Evaluierung dorthin routet, wo sie soll.",
        "<strong class='text-white'>Multi-Account-Sync</strong>, spiegeln Sie einen Alert von einem Ort aus auf mehrere Tradovate-Konten, ohne jedes von Hand anzumelden.",
      ],
    },
  ], es: [
    { type: "paragraph",html: "Copia el usuario y la contraseña directamente del panel de su firma prop, los pega en Tradovate, pulsa iniciar sesión y le rebota con <strong class='text-white'>“Username or password is incorrect.”</strong> Pega de nuevo. El mismo muro. Las credenciales parecen perfectas en pantalla, y eso es precisamente lo que lo hace tan exasperante. Casi siempre, el culpable es algo que no puede ver: un <strong class='text-white'>espacio suelto</strong> que se coló al copiar, o una <strong class='text-white'>letra mayúscula que se convirtió en minúscula</strong> en el instante en que su navegador pegó la contraseña. Tradovate trata tanto el usuario como la contraseña como sensibles a mayúsculas y a espacios, así que un solo carácter invisible basta para rechazar un acceso por lo demás correcto. Esta guía explica cómo limpiar el copiar y pegar, restaurar esa mayúscula inicial y desactivar el autocompletado para que el acceso funcione, además de cómo, al enrutar sus operaciones a través de PickMyTrade, vincula la cuenta una vez en lugar de reintroducir credenciales frágiles en cada sesión." },
    {
      type: "checklist",
      heading: "Lista rápida para el error de espacios / mayúsculas en el acceso",
      items: [
        "<strong class='text-white'>Use el botón de copiar del panel.</strong> Copie el usuario y la contraseña con el icono de copiar junto a cada campo del panel de su firma prop, no arrastrando para seleccionar el texto.",
        "<strong class='text-white'>Elimine los espacios sueltos.</strong> Compruebe si hay un espacio al principio o al final de cada campo; un espacio inicial o final hace fallar el acceso aunque el resto sea correcto.",
        "<strong class='text-white'>Conserve la mayúscula inicial.</strong> Si la contraseña empieza por mayúscula, confirme que sigue en mayúscula tras pegarla; algunos navegadores ponen en minúscula el primer carácter.",
        "<strong class='text-white'>Respete las mayúsculas y minúsculas exactas.</strong> Usuario y contraseña distinguen mayúsculas de minúsculas; introdúzcalos carácter por carácter tal como aparecen en el panel.",
        "<strong class='text-white'>Desactive el autocompletado.</strong> No permita que un acceso personal de Tradovate guardado sobrescriba sus credenciales prop; escríbalas o péguelas manualmente.",
        "<strong class='text-white'>Cuenta correcta, entorno correcto.</strong> Use las credenciales de la parte superior de su panel prop y seleccione Simulation/Demo (no Live) para una evaluación.",
      ],
    },
    { type: "heading",text: "Qué significa realmente “Username or Password Is Incorrect” en una cuenta prop" },
    { type: "paragraph",html: "En una cuenta de Tradovate autofinanciada usted define su propio acceso, así que cuando algo falla puede simplemente restablecer la contraseña. Una evaluación prop es distinta. La firma emite sus credenciales de Tradovate, están en la parte superior de su panel prop y por lo general no puede cambiarlas, el usuario suele seguir un formato fijo y específico de la firma. Eso significa que debe introducir una cadena exacta que le entregó la firma, y Tradovate la comprueba con rigor." },
    { type: "paragraph",html: "Con rigor es la clave. Las credenciales de Tradovate <strong class='text-white'>distinguen mayúsculas de minúsculas</strong>, así que “Apex” y “apex” no son lo mismo, y una contraseña que empieza por mayúscula se rechazará si esa letra llega en minúscula. Tradovate también es implacable con los espacios en blanco: un espacio al principio o al final del usuario o de la contraseña cuenta como parte de la cadena, de modo que una credencial que a su vista parece correcta falla igualmente porque hay un carácter invisible colgando del borde. Ninguno de los dos problemas se ve en pantalla, el campo de contraseña enmascara sus caracteres y un espacio final se ve exactamente igual que nada, por eso el mismo acceso “correcto” se rechaza una y otra vez." },
    { type: "heading",text: "Principales causas del fallo de acceso por espacios / mayúsculas" },
    { type: "heading",text: "1. Se coló un espacio suelto al copiar" },
    { type: "paragraph",html: "Seleccionar las credenciales arrastrando el ratón por el texto del panel es la forma clásica de capturar un espacio de más. Si resalta un carácter de más, mete un espacio final en el portapapeles; si empieza un poco antes, uno inicial. Algunos paneles además rellenan el valor mostrado, así que incluso un arrastre cuidadoso captura espacios. Tradovate lee entonces “yourpassword ” como una cadena distinta de “yourpassword” y la rechaza." },
    { type: "heading",text: "2. Su navegador puso en minúscula la primera letra de la contraseña al pegar" },
    { type: "paragraph",html: "Este caso afecta a quienes hicieron todo lo demás bien. Algunos navegadores y teclados móviles aplican la capitalización automática a los campos de entrada y, al pegar, cambian a minúscula el carácter inicial de la contraseña. Si su contraseña debe empezar por una “T” mayúscula y llega como “t”, el acceso falla aunque todos los demás caracteres sean perfectos y, como el campo está enmascarado, nunca ve el cambio." },
    { type: "heading",text: "3. El autocompletado introdujo las credenciales equivocadas (personales)" },
    { type: "paragraph",html: "Si alguna vez ha iniciado sesión en una cuenta personal de Tradovate en el mismo navegador, su gestor de contraseñas o el autocompletado integrado del navegador pueden meter en silencio esas credenciales guardadas en el formulario de acceso. Parecen legítimas, se rellenan al instante y son totalmente erróneas para una evaluación prop: el acceso personal simplemente no existe en la cuenta de la firma. El resultado es el mismo error “incorrect”, esta vez porque está enviando los datos de una cuenta completamente distinta." },
    { type: "heading",text: "4. Lo escribió a mano y se le coló una mayúscula" },
    { type: "paragraph",html: "Las contraseñas prop mezclan mayúsculas, minúsculas, dígitos y símbolos. Al teclear una a mano es fácil mantener Shift un instante de más, olvidar una mayúscula o leer una “I” mayúscula como una “l” minúscula. Cada una es una discrepancia de mayúsculas y las discrepancias fallan. La entrada manual es un buen recurso para los problemas de pegado anteriores, pero solo si respeta exactamente las mayúsculas." },
    { type: "heading",text: "5. Está usando credenciales del lugar equivocado o del entorno equivocado" },
    { type: "paragraph",html: "Dos vecinos del problema de espacios/mayúsculas producen el mismo rechazo. Primero, sacar el acceso de cualquier sitio que no sea el panel prop actual, un correo antiguo, una nota obsoleta, la cuenta del ciclo anterior, significa que las credenciales ya no coinciden. Segundo, elegir el entorno equivocado: un acceso de evaluación vive en Simulation/Demo, así que seleccionar Live falla porque esas credenciales no están aprovisionadas allí. Descarte ambos cuando su copiar y pegar esté limpio." },
    { type: "heading",text: "Cómo corregir el error de espacios / mayúsculas en el acceso: paso a paso" },
    { type: "heading",text: "Use el botón de copiar del panel (el camino más limpio)" },
    { type: "paragraph",html: "El mejor hábito es dejar de seleccionar credenciales a mano y dejar que el panel se las entregue limpias. La mayoría de los paneles de firmas prop colocan un pequeño icono de copiar justo al lado del usuario y la contraseña de Tradovate para que obtenga el valor exacto sin espacios alrededor." },
    {
      type: "steps",
      items: [
        { title: "Localice el bloque de credenciales", html: "Inicie sesión en el panel de su firma prop y localice el bloque de credenciales de Tradovate, normalmente cerca de la parte superior de la página de la cuenta." },
        { title: "Haga clic en el icono de copiar del usuario", html: "Haga clic en el <strong class='text-white'>icono de copiar</strong> junto al campo de <strong class='text-white'>usuario</strong>, no arrastre para seleccionar el texto." },
        { title: "Pegue y repita con la contraseña", html: "Péguelo en el campo de usuario de Tradovate y repita con el icono de copiar junto a la <strong class='text-white'>contraseña</strong>." },
        { title: "Envíe", html: "Envíe. Usar el botón de copiar elimina los dos puntos de fallo más comunes de una vez: toma el valor sin espacios iniciales ni finales y copia las mayúsculas exactamente como están almacenadas." },
      ],
    },
    { type: "heading",text: "Localice y borre los espacios sueltos" },
    { type: "paragraph",html: "Si su panel no tiene botón de copiar, o ya pegó y falló, compruebe los campos en busca de espacios antes de volver a intentarlo." },
    {
      type: "steps",
      items: [
        { title: "Compruebe el final del campo de usuario", html: "Haga clic en el campo de <strong class='text-white'>usuario</strong> y pulse <strong class='text-white'>End</strong> (o toque el extremo derecho en el móvil) para mover el cursor más allá del último carácter. Si el cursor queda un espacio más allá del texto, pulse retroceso una vez para borrar el espacio final." },
        { title: "Compruebe el inicio del campo", html: "Pulse <strong class='text-white'>Home</strong> (o toque el extremo izquierdo) para comprobar el inicio del campo y borre cualquier espacio inicial del mismo modo." },
        { title: "Repita en el campo de contraseña", html: "Repita ambas comprobaciones en el campo de <strong class='text-white'>contraseña</strong>. Como está enmascarado, use el icono de ojo de “mostrar contraseña” si el formulario lo ofrece para poder ver realmente un espacio suelto." },
        { title: "O restablezca y vuelva a pegar", html: "Como restablecimiento más rápido, vacíe por completo ambos campos y vuelva a pegar con el botón de copiar, o escriba las credenciales de nuevo." },
      ],
    },
    { type: "heading",text: "Restaure la mayúscula inicial de la contraseña" },
    { type: "paragraph",html: "Cuando el acceso falla tras un pegado limpio y no hay espacio suelto, sospeche de la primera letra en minúscula." },
    {
      type: "steps",
      items: [
        { title: "Compare el primer carácter", html: "Compare el primer carácter de su contraseña con el valor exacto de su panel. Si el panel muestra una mayúscula y su campo muestra una minúscula, ese es su problema." },
        { title: "Corríjalo y vuelva a enviar", html: "Use el icono de ojo de “mostrar contraseña” si está disponible, corrija el primer carácter a mayúscula y vuelva a enviar." },
        { title: "Escriba a mano si sigue ocurriendo", html: "Si su navegador lo cambia en cada pegado, evite pegar por completo: <strong class='text-white'>escriba la contraseña a mano</strong>, manteniendo Shift para la mayúscula, y respete el resto de las mayúsculas carácter por carácter." },
        { title: "Desactive la capitalización automática del teclado", html: "En el móvil, desactive la capitalización automática/autocorrección para el campo si su teclado lo permite y vuelva a introducir la contraseña." },
      ],
    },
    { type: "heading",text: "Elimine el autocompletado y descarte la cuenta equivocada" },
    {
      type: "steps",
      items: [
        { title: "Borre los campos autocompletados", html: "Si el formulario de acceso se rellenó solo, vacíe ambos campos. Rechace cualquier aviso de autocompletado y, si su gestor de contraseñas guardó un acceso personal de Tradovate, no deje que rellene una evaluación prop." },
        { title: "Vuelva a introducirlas desde el panel actual", html: "Vuelva a introducir las credenciales de la parte superior de su panel prop <strong class='text-white'>actual</strong>, con el botón de copiar o con una escritura manual cuidadosa." },
        { title: "Seleccione el entorno correcto", html: "En la pantalla de acceso, seleccione el entorno correcto, <strong class='text-white'>Simulation/Demo</strong> para una evaluación, no Live, ya que las credenciales de evaluación solo existen en el entorno simulado." },
        { title: "Haga una pausa si ha fallado repetidamente", html: "Si ha fallado varios accesos seguidos, haga una pausa. Los intentos fallidos repetidos pueden provocar un bloqueo temporal y machacar el botón empeora las cosas. Espere, confirme las credenciales exactas e inténtelo una sola vez, limpiamente." },
      ],
    },
    { type: "quote",html: "Nota: las firmas prop difieren en formatos de cuenta, selección de entorno y tiempos de bloqueo, y esos detalles cambian; consulte el panel y el centro de ayuda vigentes de su firma para conocer su proceso exacto en lugar de asumir que se aplican los pasos de otra firma." },
    { type: "heading",text: "Tabla de resolución de problemas" },
    { type: "table", headers: ["Lo que ve","Causa probable","Solución"], rows: [
      ["“Username or password is incorrect” tras un pegado de aspecto limpio","Se copió un espacio inicial/final suelto junto con la credencial","Use el botón de copiar del panel; pulse Home/End y borre cualquier espacio al principio o al final de cada campo"],
      ["Contraseña rechazada aunque todos los caracteres parecen correctos","El navegador puso en minúscula la primera letra al pegar","Muestre la contraseña, ponga en mayúscula el primer carácter o escríbala a mano respetando las mayúsculas del panel"],
      ["El formulario se rellena solo y luego falla","El autocompletado introdujo credenciales personales guardadas de Tradovate","Vacíe los campos, rechace el autocompletado y vuelva a introducir manualmente las credenciales del panel prop"],
      ["El acceso falla incluso tras limpiar los campos","Entorno equivocado seleccionado (Live en lugar de Simulation/Demo)","Elija Simulation/Demo para una cuenta de evaluación e inicie sesión de nuevo"],
      ["La escritura manual sigue siendo rechazada","Una discrepancia de mayúsculas en algún punto de la cadena","Respete exactamente mayúsculas/minúsculas; vigile la I mayúscula frente a la l minúscula y el 0 frente a la O"],
      ["Los intentos repetidos ahora fallan todos","Bloqueo temporal por demasiados accesos fallidos","Deje de reintentar, espere, confirme las credenciales exactas e inténtelo una sola vez limpiamente"],
    ] },
    { type: "heading",text: "Prevéngalo con PickMyTrade" },
    { type: "paragraph",html: "Las credenciales frágiles son peores cuando las reintroduce constantemente, un navegador nuevo, un teléfono, una sesión nueva cada mañana, porque cada nueva escritura es otra oportunidad de colar un espacio o perder una mayúscula. PickMyTrade le permite vincular su cuenta de Tradovate una sola vez y enruta sus alertas de TradingView hacia ella automáticamente, de modo que el acceso doloroso de hoy no sea uno que tenga que acertar de nuevo mañana." },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Vincule una vez, opere sin manos</strong>, conecte la cuenta una sola vez; no hay pantalla de acceso que reescribir antes de cada sesión.",
        "<strong class='text-white'>Menos sitios donde equivocarse al teclear una credencial</strong>, una única conexión limpia en lugar de volver a pegar la misma cadena sensible a mayúsculas en varias plataformas.",
        "<strong class='text-white'>Consciente de real y demo</strong>, apunte las alertas a la cuenta y al entorno exactos que pretende, para que una evaluación se enrute donde debe.",
        "<strong class='text-white'>Sincronización multicuenta</strong>, replique una alerta en varias cuentas de Tradovate desde un solo lugar, sin iniciar sesión en cada una a mano.",
      ],
    },
  ], fr: [
    { type: "paragraph",html: "Vous copiez l'identifiant et le mot de passe depuis le tableau de bord de votre firme prop, les collez dans Tradovate, cliquez sur connexion et êtes rejeté avec <strong class='text-white'>« Username or password is incorrect. »</strong> Vous collez à nouveau. Même mur. Les identifiants semblent parfaits à l'écran, et c'est précisément ce qui rend la chose si exaspérante. Presque à chaque fois, le coupable est quelque chose que vous ne pouvez pas voir : une <strong class='text-white'>espace parasite</strong> qui s'est glissée lors de la copie, ou une <strong class='text-white'>majuscule passée en minuscule</strong> à l'instant où votre navigateur a collé le mot de passe. Tradovate traite l'identifiant et le mot de passe comme sensibles à la casse et aux espaces : un seul caractère invisible suffit à rejeter une connexion par ailleurs correcte. Ce guide vous explique comment nettoyer le copier-coller, rétablir cette majuscule initiale et désactiver le remplissage automatique pour que la connexion passe, ainsi que comment, en routant vos trades via PickMyTrade, vous liez le compte une fois au lieu de retaper des identifiants fragiles à chaque session." },
    {
      type: "checklist",
      heading: "Liste de contrôle rapide pour l'erreur d'espaces / de majuscules",
      items: [
        "<strong class='text-white'>Utilisez le bouton de copie du tableau de bord.</strong> Copiez l'identifiant et le mot de passe avec l'icône de copie à côté de chaque champ du tableau de bord de votre firme prop, et non en sélectionnant le texte par glisser.",
        "<strong class='text-white'>Supprimez les espaces parasites.</strong> Vérifiez l'absence d'espace tout au début ou à la toute fin de chaque champ ; une espace initiale ou finale fait échouer la connexion même si le reste est correct.",
        "<strong class='text-white'>Conservez la majuscule initiale.</strong> Si le mot de passe commence par une majuscule, vérifiez qu'elle l'est toujours après le collage ; certains navigateurs mettent le premier caractère en minuscule.",
        "<strong class='text-white'>Respectez la casse exacte.</strong> L'identifiant et le mot de passe sont sensibles à la casse ; saisissez-les caractère par caractère tels qu'affichés sur le tableau de bord.",
        "<strong class='text-white'>Désactivez le remplissage automatique.</strong> Ne laissez pas une connexion Tradovate personnelle enregistrée écraser vos identifiants prop ; tapez ou collez manuellement.",
        "<strong class='text-white'>Bon compte, bon environnement.</strong> Utilisez les identifiants figurant en haut de votre tableau de bord prop et sélectionnez Simulation/Demo (et non Live) pour une évaluation.",
      ],
    },
    { type: "heading",text: "Ce que signifie vraiment « Username or Password Is Incorrect » sur un compte prop" },
    { type: "paragraph",html: "Sur un compte Tradovate autofinancé, vous définissez vous-même votre connexion : en cas de problème, vous pouvez simplement réinitialiser le mot de passe. Une évaluation prop est différente. La firme émet vos identifiants Tradovate, ils se trouvent en haut de votre tableau de bord prop, et vous ne pouvez généralement pas les modifier, l'identifiant suivant souvent un format fixe propre à la firme. Vous devez donc saisir une chaîne exacte que la firme vous a remise, et Tradovate la vérifie strictement." },
    { type: "paragraph",html: "Strictement est le mot clé. Les identifiants Tradovate sont <strong class='text-white'>sensibles à la casse</strong> : « Apex » et « apex » ne sont donc pas la même chose, et un mot de passe qui commence par une majuscule sera rejeté si cette lettre arrive en minuscule. Tradovate est également intransigeant sur les espaces : une espace au début ou à la fin de l'identifiant ou du mot de passe fait partie de la chaîne, si bien qu'un identifiant qui semble correct à l'œil échoue quand même parce qu'un caractère invisible dépasse du bord. Aucun des deux problèmes n'apparaît à l'écran, le champ du mot de passe masque ses caractères, et une espace finale ressemble exactement à rien, ce qui explique que la même connexion « correcte » soit rejetée encore et encore." },
    { type: "heading",text: "Principales causes de l'échec de connexion par espaces / majuscules" },
    { type: "heading",text: "1. Une espace parasite s'est glissée lors de la copie" },
    { type: "paragraph",html: "Sélectionner les identifiants en faisant glisser la souris sur le texte du tableau de bord est la façon classique de capturer une espace en trop. Surlignez un caractère de trop et vous placez une espace finale dans le presse-papiers ; commencez un poil trop tôt et c'est une espace initiale. Certains tableaux de bord complètent aussi la valeur affichée, si bien que même un glissement soigneux capture des espaces. Tradovate lit alors « yourpassword  » comme une chaîne différente de « yourpassword » et la rejette." },
    { type: "heading",text: "2. Votre navigateur a mis la première lettre du mot de passe en minuscule au collage" },
    { type: "paragraph",html: "Celle-ci piège ceux qui ont tout fait correctement par ailleurs. Certains navigateurs et claviers mobiles appliquent la mise en majuscule automatique aux champs de saisie et, au collage, passent en minuscule le caractère initial de votre mot de passe. Si votre mot de passe doit commencer par un « T » majuscule et arrive en « t », la connexion échoue même si tous les autres caractères sont parfaits, et comme le champ est masqué, vous ne voyez jamais le changement." },
    { type: "heading",text: "3. Le remplissage automatique a saisi les mauvais identifiants (personnels)" },
    { type: "paragraph",html: "Si vous vous êtes déjà connecté à un compte Tradovate personnel dans le même navigateur, votre gestionnaire de mots de passe ou le remplissage automatique intégré du navigateur peut déposer discrètement ces identifiants enregistrés dans le formulaire de connexion. Ils semblent légitimes, se remplissent instantanément et sont totalement erronés pour une évaluation prop : la connexion personnelle n'existe tout simplement pas sur le compte de la firme. Le résultat est la même erreur « incorrect », cette fois parce que vous soumettez les informations d'un tout autre compte." },
    { type: "heading",text: "4. Vous l'avez saisi à la main et une casse a glissé" },
    { type: "paragraph",html: "Les mots de passe prop mélangent majuscules, minuscules, chiffres et symboles. En les tapant à la main, il est facile de maintenir Maj un instant de trop, d'oublier une majuscule ou de lire un « I » majuscule comme un « l » minuscule. Chacune est une erreur de casse, et les erreurs de casse échouent. La saisie manuelle est un bon recours contre les problèmes de collage ci-dessus, mais seulement si vous respectez la casse exacte." },
    { type: "heading",text: "5. Vous utilisez des identifiants provenant du mauvais endroit ou du mauvais environnement" },
    { type: "paragraph",html: "Deux voisins du problème d'espaces/de majuscules produisent le même rejet. D'abord, récupérer la connexion ailleurs que sur le tableau de bord prop actuel, un ancien e-mail, une note périmée, le compte du cycle précédent, signifie que les identifiants ne correspondent plus. Ensuite, choisir le mauvais environnement : une connexion d'évaluation vit dans Simulation/Demo, donc sélectionner Live échoue parce que ces identifiants n'y sont pas provisionnés. Écartez les deux une fois votre copier-coller propre." },
    { type: "heading",text: "Comment corriger l'erreur d'espaces / de majuscules à la connexion : pas à pas" },
    { type: "heading",text: "Utilisez le bouton de copie du tableau de bord (la voie la plus propre)" },
    { type: "paragraph",html: "La meilleure habitude consiste à cesser de sélectionner les identifiants à la main et à laisser le tableau de bord vous les remettre proprement. La plupart des tableaux de bord de firmes prop placent une petite icône de copie juste à côté de l'identifiant et du mot de passe Tradovate pour que vous obteniez la valeur exacte sans espace autour." },
    {
      type: "steps",
      items: [
        { title: "Repérez le bloc d'identifiants", html: "Connectez-vous au tableau de bord de votre firme prop et repérez le bloc d'identifiants Tradovate, généralement près du haut de la page du compte." },
        { title: "Cliquez sur l'icône de copie de l'identifiant", html: "Cliquez sur l'<strong class='text-white'>icône de copie</strong> à côté du champ <strong class='text-white'>identifiant</strong>, ne faites pas glisser pour sélectionner le texte." },
        { title: "Collez puis répétez pour le mot de passe", html: "Collez-le dans le champ identifiant de Tradovate, puis répétez avec l'icône de copie à côté du <strong class='text-white'>mot de passe</strong>." },
        { title: "Validez", html: "Validez. Utiliser le bouton de copie élimine d'un coup les deux points de défaillance les plus courants : il récupère la valeur sans espace initiale ni finale et copie la casse exactement telle qu'enregistrée." },
      ],
    },
    { type: "heading",text: "Repérez et supprimez les espaces parasites" },
    { type: "paragraph",html: "Si votre tableau de bord n'a pas de bouton de copie, ou si vous avez déjà collé et que cela a échoué, vérifiez la présence d'espaces dans les champs avant de réessayer." },
    {
      type: "steps",
      items: [
        { title: "Vérifiez la fin du champ identifiant", html: "Cliquez dans le champ <strong class='text-white'>identifiant</strong> et appuyez sur <strong class='text-white'>End</strong> (ou touchez l'extrême droite sur mobile) pour placer le curseur après le dernier caractère. Si le curseur se trouve une espace au-delà du texte, appuyez une fois sur Retour arrière pour supprimer l'espace finale." },
        { title: "Vérifiez le début du champ", html: "Appuyez sur <strong class='text-white'>Home</strong> (ou touchez l'extrême gauche) pour vérifier le début du champ, et supprimez de la même façon toute espace initiale." },
        { title: "Répétez sur le champ mot de passe", html: "Répétez les deux vérifications sur le champ <strong class='text-white'>mot de passe</strong>. Comme il est masqué, utilisez l'icône en forme d'œil « afficher le mot de passe » si le formulaire en propose une, afin de voir réellement une espace parasite." },
        { title: "Ou réinitialisez et recollez", html: "Pour aller plus vite, videz complètement les deux champs et recollez avec le bouton de copie, ou retapez les identifiants." },
      ],
    },
    { type: "heading",text: "Rétablissez la majuscule initiale du mot de passe" },
    { type: "paragraph",html: "Lorsque la connexion échoue après un collage propre et sans espace parasite, suspectez la première lettre passée en minuscule." },
    {
      type: "steps",
      items: [
        { title: "Comparez le premier caractère", html: "Comparez le premier caractère de votre mot de passe à la valeur exacte de votre tableau de bord. Si le tableau de bord affiche une majuscule et votre champ une minuscule, voilà votre problème." },
        { title: "Corrigez et revalidez", html: "Utilisez l'icône en forme d'œil « afficher le mot de passe » si elle est disponible, corrigez le premier caractère en majuscule et validez à nouveau." },
        { title: "Tapez à la main si cela se répète", html: "Si votre navigateur le modifie à chaque collage, évitez le collage : <strong class='text-white'>tapez le mot de passe à la main</strong>, en maintenant Maj pour la majuscule, et respectez le reste de la casse caractère par caractère." },
        { title: "Désactivez la mise en majuscule automatique du clavier", html: "Sur mobile, désactivez la mise en majuscule automatique/la correction automatique pour le champ si votre clavier le permet, puis saisissez à nouveau le mot de passe." },
      ],
    },
    { type: "heading",text: "Neutralisez le remplissage automatique et écartez le mauvais compte" },
    {
      type: "steps",
      items: [
        { title: "Effacez les champs remplis automatiquement", html: "Si le formulaire de connexion s'est prérempli tout seul, videz les deux champs. Refusez toute proposition de remplissage automatique et, si votre gestionnaire de mots de passe a enregistré une connexion Tradovate personnelle, ne le laissez pas remplir une évaluation prop." },
        { title: "Ressaisissez depuis le tableau de bord actuel", html: "Ressaisissez les identifiants figurant en haut de votre tableau de bord prop <strong class='text-white'>actuel</strong>, avec le bouton de copie ou une saisie manuelle soignée." },
        { title: "Sélectionnez le bon environnement", html: "Sur l'écran de connexion, sélectionnez le bon environnement, <strong class='text-white'>Simulation/Demo</strong> pour une évaluation, et non Live, car les identifiants d'évaluation n'existent que dans l'environnement simulé." },
        { title: "Faites une pause après plusieurs échecs", html: "Si vous avez échoué plusieurs connexions de suite, faites une pause. Les tentatives échouées répétées peuvent déclencher un verrouillage temporaire, et marteler le bouton aggrave les choses. Patientez, confirmez les identifiants exacts et essayez une seule fois, proprement." },
      ],
    },
    { type: "quote",html: "Remarque : les firmes prop diffèrent par leurs formats de compte, leur sélection d'environnement et leurs durées de verrouillage, et ces détails évoluent ; consultez le tableau de bord et le centre d'aide actuels de votre firme pour sa procédure exacte plutôt que de supposer que les étapes d'une autre firme s'appliquent." },
    { type: "heading",text: "Tableau de dépannage" },
    { type: "table", headers: ["Ce que vous voyez","Cause probable","Solution"], rows: [
      ["« Username or password is incorrect » après un collage d'apparence propre","Une espace initiale/finale parasite a été copiée avec l'identifiant","Utilisez le bouton de copie du tableau de bord ; appuyez sur Home/End et supprimez toute espace au début ou à la fin de chaque champ"],
      ["Mot de passe rejeté alors que chaque caractère semble correct","Le navigateur a mis la première lettre en minuscule au collage","Affichez le mot de passe, mettez le premier caractère en majuscule ou tapez-le à la main en respectant la casse du tableau de bord"],
      ["Le formulaire se remplit seul, puis échoue","Le remplissage automatique a saisi des identifiants Tradovate personnels enregistrés","Videz les champs, refusez le remplissage automatique, ressaisissez manuellement les identifiants du tableau de bord prop"],
      ["La connexion échoue même après nettoyage des champs","Mauvais environnement sélectionné (Live au lieu de Simulation/Demo)","Choisissez Simulation/Demo pour un compte d'évaluation et reconnectez-vous"],
      ["La saisie manuelle est toujours rejetée","Une erreur de casse quelque part dans la chaîne","Respectez exactement majuscules/minuscules ; attention au I majuscule contre le l minuscule et au 0 contre le O"],
      ["Les tentatives répétées échouent désormais toutes","Verrouillage temporaire dû à trop de connexions échouées","Cessez de réessayer, patientez, confirmez les identifiants exacts, puis tentez une seule fois proprement"],
    ] },
    { type: "heading",text: "Évitez cela avec PickMyTrade" },
    { type: "paragraph",html: "Les identifiants fragiles sont pires lorsque vous les ressaisissez en permanence, un nouveau navigateur, un téléphone, une nouvelle session chaque matin, car chaque retape est une nouvelle occasion de glisser une espace ou de perdre une majuscule. PickMyTrade vous permet de lier votre compte Tradovate une seule fois et route automatiquement vos alertes TradingView vers celui-ci : la connexion pénible d'aujourd'hui n'est pas une connexion que vous devrez réussir à nouveau demain." },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Liez une fois, tradez sans les mains</strong>, connectez le compte une seule fois ; aucun écran de connexion à retaper avant chaque session.",
        "<strong class='text-white'>Moins d'endroits où se tromper en saisissant un identifiant</strong>, une seule connexion propre au lieu de recoller la même chaîne sensible à la casse dans plusieurs plateformes.",
        "<strong class='text-white'>Conscient du réel et de la démo</strong>, dirigez les alertes vers le compte et l'environnement exacts que vous visez, afin qu'une évaluation soit routée là où elle le doit.",
        "<strong class='text-white'>Synchronisation multi-comptes</strong>, reproduisez une alerte sur plusieurs comptes Tradovate depuis un seul endroit, sans vous connecter à chacun à la main.",
      ],
    },
  ], it: [
    { type: "paragraph",html: "Copia nome utente e password direttamente dalla dashboard della sua società prop, li incolla in Tradovate, preme accedi e viene respinto con <strong class='text-white'>“Username or password is incorrect.”</strong> Incolla di nuovo. Stesso muro. Le credenziali sembrano perfette a schermo, ed è esattamente ciò che rende tutto così esasperante. Quasi sempre il colpevole è qualcosa che non può vedere: uno <strong class='text-white'>spazio vagante</strong> che si è infilato durante la copia, oppure una <strong class='text-white'>lettera maiuscola trasformata in minuscola</strong> nel momento in cui il browser ha incollato la password. Tradovate tratta sia il nome utente sia la password come sensibili a maiuscole e spazi, quindi basta un solo carattere invisibile per respingere un login altrimenti corretto. Questa guida illustra come ripulire il copia e incolla, ripristinare quella maiuscola iniziale e disattivare il riempimento automatico perché il login vada a buon fine, oltre a come, instradando i suoi trade tramite PickMyTrade, colleghi il conto una volta sola invece di ridigitare credenziali fragili a ogni sessione." },
    {
      type: "checklist",
      heading: "Checklist rapida per l'errore di spazi / maiuscole nel login",
      items: [
        "<strong class='text-white'>Usi il pulsante di copia della dashboard.</strong> Copi nome utente e password con l'icona di copia accanto a ciascun campo della dashboard della società prop, non selezionando il testo trascinando.",
        "<strong class='text-white'>Elimini gli spazi vaganti.</strong> Controlli se c'è uno spazio proprio all'inizio o alla fine di ogni campo; uno spazio iniziale o finale fa fallire il login anche se il resto è giusto.",
        "<strong class='text-white'>Mantenga la maiuscola iniziale.</strong> Se la password inizia con una maiuscola, verifichi che sia ancora maiuscola dopo l'incolla; alcuni browser trasformano in minuscolo il primo carattere.",
        "<strong class='text-white'>Rispetti le maiuscole e minuscole esatte.</strong> Nome utente e password distinguono tra maiuscole e minuscole; li inserisca carattere per carattere come mostrato nella dashboard.",
        "<strong class='text-white'>Disattivi il riempimento automatico.</strong> Non lasci che un login Tradovate personale salvato sovrascriva le sue credenziali prop; digiti o incolli manualmente.",
        "<strong class='text-white'>Conto giusto, ambiente giusto.</strong> Usi le credenziali dalla parte alta della sua dashboard prop e selezioni Simulation/Demo (non Live) per una valutazione.",
      ],
    },
    { type: "heading",text: "Che cosa significa davvero “Username or Password Is Incorrect” su un conto prop" },
    { type: "paragraph",html: "Su un conto Tradovate autofinanziato è lei a impostare il proprio login, quindi quando qualcosa non va può semplicemente reimpostare la password. Una valutazione prop è diversa. La società emette le sue credenziali Tradovate, si trovano in alto nella sua dashboard prop e in genere non può modificarle, il nome utente segue spesso un formato fisso specifico della società. Questo significa che deve inserire una stringa esatta che la società le ha fornito, e Tradovate la controlla in modo rigoroso." },
    { type: "paragraph",html: "Rigoroso è la parola chiave. Le credenziali Tradovate <strong class='text-white'>distinguono tra maiuscole e minuscole</strong>, quindi “Apex” e “apex” non sono la stessa cosa, e una password che inizia con una maiuscola verrà respinta se quella lettera arriva in minuscolo. Tradovate è inoltre inflessibile con gli spazi: uno spazio all'inizio o alla fine del nome utente o della password conta come parte della stringa, per cui una credenziale che all'occhio sembra corretta fallisce comunque perché c'è un carattere invisibile appeso al bordo. Nessuno dei due problemi si vede a schermo, il campo password maschera i caratteri e uno spazio finale sembra esattamente niente, ed è per questo che lo stesso login “corretto” viene respinto più e più volte." },
    { type: "heading",text: "Principali cause dell'errore di login per spazi / maiuscole" },
    { type: "heading",text: "1. Uno spazio vagante si è infilato durante la copia" },
    { type: "paragraph",html: "Selezionare le credenziali trascinando il mouse sul testo della dashboard è il modo classico per catturare uno spazio in più. Evidenzia un carattere di troppo e porta negli appunti uno spazio finale; inizia un attimo prima e ne porta uno iniziale. Alcune dashboard inoltre riempiono con spazi il valore visualizzato, quindi anche un trascinamento accurato cattura spazi. Tradovate legge allora “yourpassword ” come una stringa diversa da “yourpassword” e la respinge." },
    { type: "heading",text: "2. Il browser ha trasformato in minuscolo la prima lettera della password all'incolla" },
    { type: "paragraph",html: "Questa fa inciampare chi ha fatto tutto il resto giusto. Alcuni browser e tastiere mobili applicano la maiuscola automatica ai campi di input e, all'incolla, trasformano in minuscolo il carattere iniziale della sua password. Se la password deve iniziare con una “T” maiuscola e arriva come “t”, il login fallisce anche se ogni altro carattere è perfetto, e poiché il campo è mascherato non vede mai lo scambio." },
    { type: "heading",text: "3. Il riempimento automatico ha inserito le credenziali sbagliate (personali)" },
    { type: "paragraph",html: "Se ha mai effettuato l'accesso a un conto Tradovate personale nello stesso browser, il suo gestore di password o il riempimento automatico integrato del browser possono inserire silenziosamente quelle credenziali salvate nel modulo di login. Sembrano legittime, si compilano all'istante e sono del tutto sbagliate per una valutazione prop: il login personale semplicemente non esiste sul conto della società. Il risultato è lo stesso errore “incorrect”, questa volta perché sta inviando i dati di un conto completamente diverso." },
    { type: "heading",text: "4. Lo ha digitato a mano e una maiuscola è sfuggita" },
    { type: "paragraph",html: "Le password prop mescolano maiuscole, minuscole, cifre e simboli. Digitandole a mano è facile tenere premuto Shift un attimo di troppo, mancare una maiuscola o leggere una “I” maiuscola come una “l” minuscola. Ciascuna è una discrepanza di maiuscole e minuscole, e le discrepanze falliscono. L'inserimento manuale è un valido ripiego per i problemi di incolla descritti sopra, ma solo se rispetta esattamente le maiuscole." },
    { type: "heading",text: "5. Sta usando credenziali prese dal posto sbagliato o dall'ambiente sbagliato" },
    { type: "paragraph",html: "Due vicini del problema di spazi/maiuscole producono lo stesso rifiuto. Primo, prendere il login da qualsiasi posto che non sia l'attuale dashboard prop, una vecchia email, un appunto obsoleto, il conto del ciclo precedente, significa che le credenziali non corrispondono più. Secondo, scegliere l'ambiente sbagliato: un login di valutazione vive in Simulation/Demo, quindi selezionare Live fallisce perché quelle credenziali non sono configurate lì. Escluda entrambi una volta che il suo copia e incolla è pulito." },
    { type: "heading",text: "Come risolvere l'errore di spazi / maiuscole nel login: passo dopo passo" },
    { type: "heading",text: "Usi il pulsante di copia della dashboard (il percorso più pulito)" },
    { type: "paragraph",html: "La migliore abitudine è smettere di selezionare le credenziali a mano e lasciare che la dashboard gliele consegni pulite. La maggior parte delle dashboard delle società prop colloca una piccola icona di copia accanto al nome utente e alla password Tradovate, così può prendere il valore esatto senza spazi attorno." },
    {
      type: "steps",
      items: [
        { title: "Trovi il blocco delle credenziali", html: "Acceda alla dashboard della sua società prop e trovi il blocco delle credenziali Tradovate, di solito in alto nella pagina del conto." },
        { title: "Clicchi sull'icona di copia del nome utente", html: "Clicchi sull'<strong class='text-white'>icona di copia</strong> accanto al campo <strong class='text-white'>nome utente</strong>, non trascini per selezionare il testo." },
        { title: "Incolli e ripeta per la password", html: "Lo incolli nel campo nome utente di Tradovate, poi ripeta con l'icona di copia accanto alla <strong class='text-white'>password</strong>." },
        { title: "Invii", html: "Invii. Usare il pulsante di copia elimina in un colpo solo i due punti di errore più comuni: prende il valore senza spazi iniziali o finali e copia le maiuscole esattamente come memorizzate." },
      ],
    },
    { type: "heading",text: "Individui ed elimini gli spazi vaganti" },
    { type: "paragraph",html: "Se la sua dashboard non ha un pulsante di copia, o ha già incollato e non ha funzionato, controlli i campi per eventuali spazi prima di riprovare." },
    {
      type: "steps",
      items: [
        { title: "Controlli la fine del campo nome utente", html: "Clicchi nel campo <strong class='text-white'>nome utente</strong> e prema <strong class='text-white'>End</strong> (o tocchi all'estrema destra su mobile) per portare il cursore oltre l'ultimo carattere. Se il cursore si trova uno spazio oltre il testo, prema una volta Backspace per eliminare lo spazio finale." },
        { title: "Controlli l'inizio del campo", html: "Prema <strong class='text-white'>Home</strong> (o tocchi all'estrema sinistra) per controllare l'inizio del campo ed elimini allo stesso modo un eventuale spazio iniziale." },
        { title: "Ripeta sul campo password", html: "Ripeta entrambi i controlli sul campo <strong class='text-white'>password</strong>. Poiché è mascherato, usi l'icona a forma di occhio “mostra password” se il modulo di login ne offre una, così da vedere davvero uno spazio vagante." },
        { title: "Oppure reimposti e incolli di nuovo", html: "Per un ripristino più rapido, svuoti completamente entrambi i campi e incolli di nuovo con il pulsante di copia, oppure digiti le credenziali da zero." },
      ],
    },
    { type: "heading",text: "Ripristini la maiuscola iniziale della password" },
    { type: "paragraph",html: "Quando il login fallisce dopo un'incolla pulita e senza spazi vaganti, sospetti la prima lettera trasformata in minuscolo." },
    {
      type: "steps",
      items: [
        { title: "Confronti il primo carattere", html: "Confronti il primo carattere della sua password con il valore esatto della dashboard. Se la dashboard mostra una maiuscola e il suo campo una minuscola, ecco il problema." },
        { title: "Corregga e invii di nuovo", html: "Usi l'icona a forma di occhio “mostra password” se disponibile, corregga il primo carattere in maiuscolo e invii di nuovo." },
        { title: "Digiti a mano se continua a succedere", html: "Se il browser lo cambia a ogni incolla, eviti del tutto di incollare: <strong class='text-white'>digiti la password a mano</strong>, tenendo premuto Shift per la maiuscola, e rispetti il resto delle maiuscole carattere per carattere." },
        { title: "Disattivi la maiuscola automatica della tastiera", html: "Su mobile, disattivi la maiuscola automatica/correzione automatica per il campo se la tastiera lo consente, quindi reinserisca la password." },
      ],
    },
    { type: "heading",text: "Elimini il riempimento automatico ed escluda il conto sbagliato" },
    {
      type: "steps",
      items: [
        { title: "Svuoti i campi compilati automaticamente", html: "Se il modulo di login si è precompilato da solo, svuoti entrambi i campi. Rifiuti qualsiasi richiesta di riempimento automatico e, se il gestore di password ha salvato un login Tradovate personale, non lo lasci compilare una valutazione prop." },
        { title: "Reinserisca dalla dashboard attuale", html: "Reinserisca le credenziali dalla parte alta della sua dashboard prop <strong class='text-white'>attuale</strong>, usando il pulsante di copia o una digitazione manuale accurata." },
        { title: "Selezioni l'ambiente giusto", html: "Nella schermata di login, selezioni l'ambiente corretto, <strong class='text-white'>Simulation/Demo</strong> per una valutazione, non Live, poiché le credenziali di valutazione esistono solo nell'ambiente simulato." },
        { title: "Faccia una pausa dopo ripetuti fallimenti", html: "Se ha fallito più login di fila, faccia una pausa. I ripetuti tentativi falliti possono innescare un blocco temporaneo, e martellare il pulsante peggiora le cose. Attenda, confermi le credenziali esatte e provi una sola volta, in modo pulito." },
