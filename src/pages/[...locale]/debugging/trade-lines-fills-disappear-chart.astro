---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "trade-lines-fills-disappear-chart";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/debugging/${SLUG}`;

const META_TITLE = "Tradovate Trade Lines & Fills Disappear From Chart";
const META_DESCRIPTION =
  "Tradovate trade lines and fills disappearing from the chart? Switch off the legacy chart to restore order lines and find where past fills go.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Tradovate: Orderlinien und Fills verschwinden aus dem Chart", es: "Tradovate: las líneas de operaciones y ejecuciones desaparecen del gráfico", fr: "Tradovate : les lignes de trades et les exécutions disparaissent du graphique", it: "Tradovate: le linee dei trade e le esecuzioni scompaiono dal grafico" },
  dek: { en: "One session your bracket, entry marker, and last-trade-price line are visible on the chart; the next login they're gone. Here's how to tell a legacy-chart display bug from normal end-of-day fill clearing, and fix each one.", de: "In einer Sitzung sind Ihr Bracket, die Einstiegsmarkierung und die Linie des letzten Handelspreises im Chart sichtbar; beim nächsten Login sind sie weg. So unterscheiden Sie einen Darstellungsfehler des Legacy-Charts von der normalen Bereinigung der Fills am Tagesende und beheben beides.", es: "En una sesión su bracket, la marca de entrada y la línea del último precio operado están visibles en el gráfico; en el siguiente inicio de sesión han desaparecido. Así distingue un fallo de visualización del gráfico heredado de la limpieza normal de ejecuciones al final del día, y cómo arreglar cada uno.", fr: "Lors d'une séance, votre bracket, votre marqueur d'entrée et la ligne du dernier prix sont visibles sur le graphique ; à la connexion suivante, ils ont disparu. Voici comment distinguer un défaut d'affichage du graphique hérité de l'effacement normal des exécutions en fin de journée, et corriger chacun.", it: "In una sessione il suo bracket, il marcatore di ingresso e la linea dell'ultimo prezzo sono visibili sul grafico; al login successivo sono spariti. Ecco come distinguere un difetto di visualizzazione del grafico legacy dalla normale cancellazione delle esecuzioni a fine giornata, e correggere ciascuno." },
  readTime: { en: "7 min read", de: "7 Min. Lesezeit", es: "Lectura de 7 min", fr: "Lecture : 7 min", it: "Lettura di 7 min" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "You're managing a live futures position on ES or NQ, and your working stop and target are supposed to sit right there on the chart as horizontal order lines. Then they vanish. One session your bracket, your entry marker, and the last-trade-price line are all visible; the next login they're gone, and yesterday's fills are nowhere to be found. It feels like data loss. In practice, it almost always traces back to two very different causes that get mixed up with each other: live order lines dropping off the legacy chart, and historical fill markers clearing at the end of the day by design. Figure out which one you're looking at and the fix takes seconds. Better still, when your brackets are managed off-platform by an automation layer like PickMyTrade, a disappearing chart line never puts your risk in doubt." },
    {
      type: "checklist",
      heading: "Quick Checklist for Missing Trade Lines & Fills",
      items: [
        "<strong class='text-white'>You're on the legacy chart</strong>, swap it for the newer standard Chart module. Order lines render reliably there when they won't on legacy.",
        "<strong class='text-white'>&ldquo;Show order lines&rdquo; is toggled off</strong>, open the chart settings and re-enable order / working-order line display.",
        "<strong class='text-white'>Chart trading is disabled</strong>, turn it on so live orders draw on the chart and stay draggable.",
        "<strong class='text-white'>You're hunting for yesterday's fills</strong>, the chart is current-day only. Those markers clear after the trading day, so pull them from the Orders/Fills or account report instead.",
        "<strong class='text-white'>Wrong symbol or account is loaded</strong>, confirm the chart's contract and linked account match the position you expect to see.",
        "<strong class='text-white'>Stale session after a device switch</strong>, refresh, or log out and back in, so the chart re-subscribes to your live order state.",
      ],
    },
    { type: "heading", text: "What “Trade Lines & Fills Disappeared” Means" },
    { type: "paragraph", html: "There's no single error dialog for this. Tradovate doesn't pop a message; the lines and markers just stop appearing. That silence is exactly why it's confusing, so it helps to split the symptom into its two real forms." },
    { type: "paragraph", html: "The first is <strong class='text-white'>live order lines going missing</strong>. Your resting stop, limit, and target orders, plus the last-trade-price line, should draw as horizontal lines on the active chart while they're working. When they disappear even though the orders are still live in the Orders panel, you're looking at a chart-display problem, not an order problem. Your orders are safe on Tradovate's servers; the chart just isn't drawing them." },
    { type: "paragraph", html: "The second is <strong class='text-white'>historical fill markers clearing</strong>. Tradovate plots your entry and exit fills as markers on the chart for the current trading day. Once the day completes, those markers disappear. That's current, expected behavior, not a glitch. The platform doesn't render previous-day trades on the chart, so if you came back the next morning to review yesterday's entries, there's nothing there to find. Telling these two apart is the whole game: one is fixed by changing your chart, the other by changing where you look for the data." },
    { type: "heading", text: "Top Causes of Disappearing Trade Lines & Fills in 2026" },
    { type: "heading", text: "1. You're using the legacy chart" },
    { type: "paragraph", html: "This is the number-one cause of working-order lines vanishing. Tradovate ships both an older <strong class='text-white'>legacy chart</strong> and a newer <strong class='text-white'>standard Chart</strong> module, and the legacy version carries long-standing display defects: order lines fail to render, and even the horizontal last-trade-price line can drop off despite the relevant settings being switched on. You can check every toggle, autofit, &ldquo;order lines,&rdquo; all of it, and see no change, right up until you move off the legacy chart. If your lines won't show no matter what you click, assume the legacy chart first." },
    { type: "heading", text: "2. The order-line toggle or chart trading is switched off" },
    { type: "paragraph", html: "On a healthy standard chart, order lines can still be hidden if the display option for them is turned off, or if chart trading isn't enabled for that chart. Chart trading is what lets orders draw as draggable lines directly on the price axis; with it off, you'll see fewer on-chart order controls. Rule this out before you blame anything deeper." },
    { type: "heading", text: "3. Historical fills clear at end of day (by design)" },
    { type: "paragraph", html: "If the missing items are <em>past</em> trades rather than <em>live</em> orders, nothing is broken. Tradovate only shows order and fill markers for the current trading day; once the day is complete, those markers disappear from the chart. The behavior is consistent every session, markers plot while you're trading and are gone afterward, and retaining previous-day orders and fills on the chart remains an open feature request. To review historical trades, you use the reports, not the chart." },
    { type: "heading", text: "4. Session or state desync after a device switch or data drop" },
    { type: "paragraph", html: "Order lines are tied to your live session's view of working orders. Switch devices, come back hours later, or ride out a brief market-data hiccup, and the chart can fail to re-subscribe to that order state, leaving lines that were there earlier simply not redrawn. A refresh usually forces them back." },
    { type: "heading", text: "How to Fix Disappearing Trade Lines & Fills: Step-by-Step" },
    { type: "heading", text: "Fixing the legacy chart (the main fix)" },
    {
      type: "list",
      items: [
        "Look at the chart module you're trading from and work out whether it's the older legacy chart or the newer standard Chart. The legacy version is a separate module type from the standard Chart.",
        "Open a new <strong class='text-white'>Chart</strong> module (the newer, non-legacy chart) and load the same symbol and account.",
        "Confirm your working orders now draw as horizontal order lines on the new chart. This is the reliable outcome, order lines that refuse to appear on the legacy chart show up correctly on the newer one.",
        "Once the standard chart behaves, make it your default and retire the legacy chart from your workspace so the problem doesn't come back.",
      ],
    },
    { type: "heading", text: "Turning order lines and chart trading back on" },
    {
      type: "list",
      items: [
        "Open the chart's settings (the gear / settings control on the chart).",
        "Enable the option that displays <strong class='text-white'>order lines</strong> / working orders on the chart.",
        "Make sure <strong class='text-white'>chart trading</strong> is enabled for that chart so live orders render and stay draggable.",
        "Place or move a test order in the simulation account and confirm the line appears and tracks the price level. If it only works after you also switch off the legacy chart, that's expected, the toggle alone often isn't enough on legacy.",
      ],
    },
    { type: "heading", text: "Recovering past-day fills from reports" },
    {
      type: "list",
      items: [
        "Because the chart won't show previous days, open your <strong class='text-white'>Orders/Fills</strong> report or the account <strong class='text-white'>reports</strong> section instead.",
        "Filter by the date range you want to review to pull the entries and exits that have cleared from the chart.",
        "Export or note the fills you need for journaling, taxes, or dispute purposes. This is the durable record, whereas the chart markers are only a same-day convenience.",
      ],
    },
    { type: "heading", text: "Refreshing a desynced session" },
    {
      type: "list",
      items: [
        "If lines were showing earlier and dropped after a device switch or a brief data interruption, refresh the platform (or log out and back in).",
        "Re-open the chart and confirm the working-order lines redraw once the session re-subscribes to your live order state.",
        "If you're logged in on more than one device, close the extra sessions. Competing sessions can leave one view out of sync.",
      ],
    },
    { type: "heading", text: "Troubleshooting Table" },
    {
      type: "table",
      headers: ["Symptom", "Meaning", "Fix"],
      rows: [
        ["&ldquo;Order lines no longer showing up&rdquo;", "You're on the legacy chart, which fails to draw them", "Switch to the newer standard Chart module"],
        ["&ldquo;Last trade price line disappeared&rdquo;", "Known legacy-chart display defect", "Move to the standard chart; don't rely on legacy"],
        ["Orders live in the panel but no chart lines", "Display/toggle or chart-trading issue on that chart", "Enable order lines + chart trading, or switch charts"],
        ["&ldquo;Trade entries and exits disappear after some hours&rdquo;", "Current-day-only markers clearing at EOD (by design)", "Review past fills in the Orders/Fills or account report"],
        ["Yesterday's trades missing from chart", "Tradovate doesn't plot previous-day trades", "Use reports for historical review, not the chart"],
        ["Lines gone after switching devices", "Session state desync", "Refresh / re-log; close duplicate sessions"],
      ],
    },
    { type: "heading", text: "Prevent This with PickMyTrade" },
    { type: "paragraph", html: "Chart lines are a convenience, not a safety net, so the real fix is to stop depending on them to know your risk. PickMyTrade links your TradingView alerts straight to Tradovate and manages the orders for you, natively:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Server-Side Bracket Management</strong>, your stop and target live on PickMyTrade's engine, so a chart that stops drawing lines never means you've lost track of your protective orders.",
        "<strong class='text-white'>Automatic Trade Logging</strong>, every entry and exit is recorded off-platform, so an end-of-day chart reset can never erase your trade history.",
        "<strong class='text-white'>TradingView-Native Execution</strong>, alerts fire from the TradingView chart you already watch, independent of which Tradovate chart module you're using.",
        "<strong class='text-white'>Multi-Account Sync</strong>, the same managed orders mirror across every connected account, so you're never reconciling mismatched chart states by hand.",
      ],
    },
  ], de: [
    { type: "paragraph",html: "Sie verwalten eine laufende Futures-Position auf ES oder NQ, und Ihr Working-Stop und Ihr Ziel sollen als horizontale Orderlinien genau dort im Chart stehen. Dann verschwinden sie. In einer Sitzung sind Ihr Bracket, Ihre Einstiegsmarkierung und die Linie des letzten Handelspreises sichtbar; beim nächsten Login sind sie weg, und die Fills von gestern sind nirgends zu finden. Es fühlt sich nach Datenverlust an. In der Praxis lässt es sich fast immer auf zwei sehr unterschiedliche Ursachen zurückführen, die oft verwechselt werden: Live-Orderlinien, die im Legacy-Chart verschwinden, und historische Fill-Markierungen, die am Tagesende planmäßig gelöscht werden. Finden Sie heraus, welchen Fall Sie vor sich haben, und die Lösung dauert Sekunden. Noch besser: Werden Ihre Brackets von einer Automatisierungsschicht wie PickMyTrade außerhalb der Plattform verwaltet, stellt eine verschwindende Chart-Linie Ihr Risiko nie in Frage." },
    {
      type: "checklist",
      heading: "Kurze Checkliste für fehlende Tradelinien und Fills",
      items: [
        "<strong class='text-white'>Sie nutzen den Legacy-Chart</strong>, tauschen Sie ihn gegen das neuere Standard-Chart-Modul. Orderlinien werden dort zuverlässig gezeichnet, wo sie im Legacy-Chart nicht erscheinen.",
        "<strong class='text-white'>&ldquo;Orderlinien anzeigen&rdquo; ist ausgeschaltet</strong>, öffnen Sie die Chart-Einstellungen und aktivieren Sie die Anzeige von Order- bzw. Working-Order-Linien wieder.",
        "<strong class='text-white'>Chart-Trading ist deaktiviert</strong>, schalten Sie es ein, damit Live-Orders im Chart gezeichnet werden und verschiebbar bleiben.",
        "<strong class='text-white'>Sie suchen die Fills von gestern</strong>, der Chart zeigt nur den aktuellen Tag. Diese Markierungen verschwinden nach dem Handelstag; holen Sie sie stattdessen aus dem Orders/Fills- oder Kontobericht.",
        "<strong class='text-white'>Falsches Symbol oder Konto geladen</strong>, prüfen Sie, ob Kontrakt und verknüpftes Konto des Charts zu der Position passen, die Sie erwarten.",
        "<strong class='text-white'>Veraltete Sitzung nach einem Gerätewechsel</strong>, aktualisieren Sie oder melden Sie sich ab und wieder an, damit der Chart Ihren Live-Orderstatus erneut abonniert.",
      ],
    },
    { type: "heading",text: "Was „Tradelinien und Fills verschwunden“ bedeutet" },
    { type: "paragraph",html: "Es gibt keinen einzelnen Fehlerdialog dafür. Tradovate zeigt keine Meldung an; die Linien und Markierungen erscheinen einfach nicht mehr. Genau diese Stille macht es verwirrend, daher hilft es, das Symptom in seine zwei tatsächlichen Formen aufzuteilen." },
    { type: "paragraph",html: "Die erste Form sind <strong class='text-white'>verschwindende Live-Orderlinien</strong>. Ihre stehenden Stop-, Limit- und Zielorders sowie die Linie des letzten Handelspreises sollten als horizontale Linien im aktiven Chart erscheinen, solange sie aktiv sind. Verschwinden sie, obwohl die Orders im Orders-Panel noch live sind, handelt es sich um ein Darstellungsproblem des Charts, nicht um ein Orderproblem. Ihre Orders liegen sicher auf den Servern von Tradovate; der Chart zeichnet sie nur nicht." },
    { type: "paragraph",html: "Die zweite Form sind <strong class='text-white'>gelöschte historische Fill-Markierungen</strong>. Tradovate zeichnet Ihre Einstiegs- und Ausstiegs-Fills als Markierungen im Chart für den aktuellen Handelstag. Sobald der Tag abgeschlossen ist, verschwinden diese Markierungen. Das ist aktuelles, erwartetes Verhalten, keine Störung. Die Plattform stellt Trades des Vortags nicht im Chart dar; wenn Sie am nächsten Morgen die gestrigen Einstiege prüfen wollten, gibt es dort nichts zu finden. Beides auseinanderzuhalten ist das Entscheidende: Das eine behebt man, indem man den Chart ändert, das andere, indem man anders nach den Daten sucht." },
    { type: "heading",text: "Die häufigsten Ursachen für verschwindende Tradelinien und Fills 2026" },
    { type: "heading",text: "1. Sie nutzen den Legacy-Chart" },
    { type: "paragraph",html: "Das ist die Ursache Nummer eins für verschwindende Working-Order-Linien. Tradovate liefert sowohl einen älteren <strong class='text-white'>Legacy-Chart</strong> als auch ein neueres <strong class='text-white'>Standard-Chart</strong>-Modul, und die Legacy-Version weist seit langem bestehende Darstellungsfehler auf: Orderlinien werden nicht gezeichnet, und sogar die horizontale Linie des letzten Handelspreises kann verschwinden, obwohl die entsprechenden Einstellungen aktiviert sind. Sie können jeden Schalter prüfen, Autofit, &ldquo;Orderlinien&rdquo;, alles, und keine Änderung sehen, bis Sie den Legacy-Chart verlassen. Erscheinen Ihre Linien trotz allem nicht, gehen Sie zuerst vom Legacy-Chart aus." },
    { type: "heading",text: "2. Der Orderlinien-Schalter oder das Chart-Trading ist ausgeschaltet" },
    { type: "paragraph",html: "Auch bei einem gesunden Standard-Chart können Orderlinien ausgeblendet sein, wenn die Anzeigeoption dafür ausgeschaltet ist oder das Chart-Trading für diesen Chart nicht aktiviert ist. Chart-Trading ermöglicht es, Orders als verschiebbare Linien direkt auf der Preisachse darzustellen; ist es aus, sehen Sie weniger Order-Steuerelemente im Chart. Schließen Sie das aus, bevor Sie Tieferes vermuten." },
    { type: "heading",text: "3. Historische Fills werden am Tagesende gelöscht (planmäßig)" },
    { type: "paragraph",html: "Handelt es sich bei den fehlenden Elementen um <em>vergangene</em> Trades statt um <em>Live</em>-Orders, ist nichts defekt. Tradovate zeigt Order- und Fill-Markierungen nur für den aktuellen Handelstag; sobald der Tag abgeschlossen ist, verschwinden sie aus dem Chart. Das Verhalten ist in jeder Sitzung gleich, die Markierungen werden gezeichnet, solange Sie handeln, und sind danach weg; das Beibehalten von Orders und Fills des Vortags im Chart bleibt ein offener Funktionswunsch. Um historische Trades zu prüfen, nutzen Sie die Berichte, nicht den Chart." },
    { type: "heading",text: "4. Sitzungs- oder Statusabweichung nach einem Gerätewechsel oder Datenausfall" },
    { type: "paragraph",html: "Orderlinien sind an die Sicht Ihrer Live-Sitzung auf Working-Orders gebunden. Wechseln Sie das Gerät, kehren Sie nach Stunden zurück oder überstehen einen kurzen Marktdatenausfall, kann der Chart diesen Orderstatus möglicherweise nicht erneut abonnieren, sodass früher vorhandene Linien einfach nicht neu gezeichnet werden. Ein Refresh bringt sie in der Regel zurück." },
    { type: "heading",text: "So beheben Sie verschwindende Tradelinien und Fills: Schritt für Schritt" },
    { type: "heading",text: "Den Legacy-Chart beheben (die Hauptlösung)" },
    {
      type: "list",
      items: [
        "Sehen Sie sich das Chart-Modul an, in dem Sie handeln, und stellen Sie fest, ob es der ältere Legacy-Chart oder der neuere Standard-Chart ist. Die Legacy-Version ist ein eigener Modultyp neben dem Standard-Chart.",
        "Öffnen Sie ein neues <strong class='text-white'>Chart</strong>-Modul (den neueren Nicht-Legacy-Chart) und laden Sie dasselbe Symbol und Konto.",
        "Bestätigen Sie, dass Ihre Working-Orders im neuen Chart nun als horizontale Orderlinien gezeichnet werden. Das ist das verlässliche Ergebnis: Orderlinien, die im Legacy-Chart nicht erscheinen, werden im neueren korrekt angezeigt.",
        "Sobald der Standard-Chart funktioniert, machen Sie ihn zu Ihrem Standard und entfernen Sie den Legacy-Chart aus Ihrem Workspace, damit das Problem nicht wiederkehrt.",
      ],
    },
    { type: "heading",text: "Orderlinien und Chart-Trading wieder einschalten" },
    {
      type: "list",
      items: [
        "Öffnen Sie die Chart-Einstellungen (das Zahnrad bzw. Einstellungs-Steuerelement im Chart).",
        "Aktivieren Sie die Option, die <strong class='text-white'>Orderlinien</strong> bzw. Working-Orders im Chart anzeigt.",
        "Stellen Sie sicher, dass <strong class='text-white'>Chart-Trading</strong> für diesen Chart aktiviert ist, damit Live-Orders gezeichnet werden und verschiebbar bleiben.",
        "Platzieren oder verschieben Sie im Simulationskonto eine Test-Order und bestätigen Sie, dass die Linie erscheint und dem Preisniveau folgt. Funktioniert es erst, wenn Sie zusätzlich den Legacy-Chart abschalten, ist das erwartet, der Schalter allein reicht im Legacy-Chart oft nicht aus.",
      ],
    },
    { type: "heading",text: "Vergangene Fills aus Berichten wiederherstellen" },
    {
      type: "list",
      items: [
        "Da der Chart frühere Tage nicht anzeigt, öffnen Sie stattdessen Ihren <strong class='text-white'>Orders/Fills</strong>-Bericht oder den Bereich <strong class='text-white'>Berichte</strong> des Kontos.",
        "Filtern Sie nach dem Datumsbereich, den Sie prüfen möchten, um die Einstiege und Ausstiege abzurufen, die aus dem Chart verschwunden sind.",
        "Exportieren oder notieren Sie die benötigten Fills für Journaling, Steuern oder Streitfälle. Das ist die dauerhafte Aufzeichnung, während die Chart-Markierungen nur eine Komfortfunktion für den gleichen Tag sind.",
      ],
    },
    { type: "heading",text: "Eine abgeglittene Sitzung aktualisieren" },
    {
      type: "list",
      items: [
        "Waren Linien zuvor sichtbar und sind nach einem Gerätewechsel oder einer kurzen Datenunterbrechung verschwunden, aktualisieren Sie die Plattform (oder melden Sie sich ab und wieder an).",
        "Öffnen Sie den Chart erneut und bestätigen Sie, dass die Working-Order-Linien neu gezeichnet werden, sobald die Sitzung Ihren Live-Orderstatus erneut abonniert.",
        "Sind Sie auf mehr als einem Gerät angemeldet, schließen Sie die zusätzlichen Sitzungen. Konkurrierende Sitzungen können eine Ansicht aus dem Takt bringen.",
      ],
    },
    { type: "heading",text: "Tabelle zur Fehlerbehebung" },
    { type: "table", headers: ["Symptom","Bedeutung","Lösung"], rows: [
      ["&ldquo;Orderlinien werden nicht mehr angezeigt&rdquo;","Sie nutzen den Legacy-Chart, der sie nicht zeichnet","Zum neueren Standard-Chart-Modul wechseln"],
      ["&ldquo;Linie des letzten Handelspreises ist verschwunden&rdquo;","Bekannter Darstellungsfehler des Legacy-Charts","Zum Standard-Chart wechseln; sich nicht auf Legacy verlassen"],
      ["Orders im Panel live, aber keine Chart-Linien","Anzeige-/Schalterproblem oder Chart-Trading auf diesem Chart","Orderlinien und Chart-Trading aktivieren oder Chart wechseln"],
      ["&ldquo;Trade-Einstiege und -Ausstiege verschwinden nach einigen Stunden&rdquo;","Markierungen nur für den aktuellen Tag werden am Tagesende gelöscht (planmäßig)","Vergangene Fills im Orders/Fills- oder Kontobericht prüfen"],
      ["Trades von gestern fehlen im Chart","Tradovate zeichnet keine Trades des Vortags","Berichte für die historische Auswertung nutzen, nicht den Chart"],
      ["Linien nach Gerätewechsel verschwunden","Abweichung des Sitzungsstatus","Aktualisieren / neu anmelden; doppelte Sitzungen schließen"],
    ] },
    { type: "heading",text: "Verhindern Sie das mit PickMyTrade" },
    { type: "paragraph",html: "Chart-Linien sind eine Annehmlichkeit, kein Sicherheitsnetz; die eigentliche Lösung ist daher, sich nicht mehr auf sie zu verlassen, um Ihr Risiko zu kennen. PickMyTrade verbindet Ihre TradingView-Alerts direkt mit Tradovate und verwaltet die Orders nativ für Sie:" },
    {
      type: "list",
