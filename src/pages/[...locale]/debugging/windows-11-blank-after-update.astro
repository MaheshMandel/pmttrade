---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "windows-11-blank-after-update";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/debugging/${SLUG}`;

const META_TITLE = "Tradovate Blank Desktop After Windows 11 Update";
const META_DESCRIPTION =
  "Desktop trading app goes blank after a Windows 11 update? Press F5 or Fn+F5 to refresh and reload your full layout in seconds. Fix and fallbacks inside.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Tradovate-Desktop leer nach Windows-11-Update", es: "Tradovate de escritorio en blanco tras actualizar Windows 11", fr: "Tradovate bureau vide après la mise à jour de Windows 11", it: "Tradovate desktop vuoto dopo l'aggiornamento di Windows 11" },
  dek: { en: "Windows finishes an update, the desktop app opens to a flat white or gray window with no charts and no DOM. A quick F5 clears the stuck render in most cases, here's that fix and every fallback if it doesn't stick.", de: "Windows schließt ein Update ab, die Desktop-App öffnet sich als flaches weißes oder graues Fenster ohne Charts und ohne DOM. Ein schnelles F5 behebt das festhängende Rendering in den meisten Fällen, hier ist diese Lösung und jede Ausweichmöglichkeit, falls sie nicht hält.", es: "Windows termina una actualización y la aplicación de escritorio se abre con una ventana plana blanca o gris, sin gráficos ni DOM. Un rápido F5 limpia el renderizado atascado en la mayoría de los casos; aquí está esa solución y cada alternativa si no se mantiene.", fr: "Windows termine une mise à jour, l'application de bureau s'ouvre sur une fenêtre blanche ou grise unie, sans graphiques ni DOM. Un simple F5 règle le rendu bloqué dans la plupart des cas ; voici ce correctif et chaque solution de repli s'il ne tient pas.", it: "Windows termina un aggiornamento, l'app desktop si apre con una finestra piatta bianca o grigia, senza grafici né DOM. Un rapido F5 risolve il rendering bloccato nella maggior parte dei casi; ecco questa correzione e ogni alternativa se non regge." },
  readTime: { en: "6 min read", de: "6 Min. Lesezeit", es: "Lectura de 6 min", fr: "Lecture : 6 min", it: "Lettura di 6 min" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "Windows finishes installing an update, the machine reboots, you open the Tradovate desktop app, and the window comes up blank. No charts, no DOM, no login box. Just a flat white or gray rectangle where your whole trading layout should be. The app is clearly running, the title bar is there, but nothing paints inside it. Open the browser version and it works fine, which tells you the account and servers are healthy and the problem is stuck on your desktop." },
    { type: "paragraph", html: "Here is the fix up front, because it takes two seconds: <strong class='text-white'>click inside the app window and press F5, or Fn+F5 on a laptop, to refresh it.</strong> The desktop app is the same web platform running in its own window, so a reload re-fetches the interface and repaints your layout without a full restart. Below is why the blank screen happens after an update, what to do when a single refresh does not stick, how to bring back a layout that loads empty, and how to keep managing open risk the whole time." },
    {
      type: "checklist",
      heading: "Quick Fix Checklist",
      items: [
        "<strong class='text-white'>Press F5 first.</strong> Click once inside the window to give it focus, then hit F5 (or Fn+F5 if your top row are media keys). The layout should repaint in a second or two.",
        "<strong class='text-white'>Still blank? Close the app fully and reopen it.</strong> A cold restart clears a wedged window that a single refresh missed.",
        "<strong class='text-white'>Layout comes back empty?</strong> Your workspace was reset. Open the New (+) menu top-left and click your saved workspace to reload it.",
        "<strong class='text-white'>Update or reinstall the desktop app</strong> from the Tradovate Devices page so the build matches your freshly updated Windows.",
        "<strong class='text-white'>Use the web version in a browser</strong> to watch and manage your account while you fix the desktop app.",
        "<strong class='text-white'>Keeps crashing to blank after a clean reinstall?</strong> Update your graphics driver and Windows, and report it to Tradovate support with your version numbers.",
      ],
    },
    { type: "heading", text: "Why the Desktop App Goes Blank After an Update" },
    { type: "paragraph", html: "The Tradovate desktop platform carries the same functionality as the web trader. Under the hood it is that web interface wrapped in a standalone window, which is the detail that explains both the symptom and the fix. When a Windows 11 update lands, it typically restarts the machine, and it can swap out or reset your graphics drivers in the process. If the app was left open, or it launched into a half-updated graphics state, the window can come back with a rendered view that never finishes drawing. The connection to Tradovate is fine and the data is flowing, but the visible layer is frozen on an empty frame." },
    { type: "paragraph", html: "That is exactly the kind of stuck view a reload fixes. Pressing F5 tells the app to throw away the current render and rebuild the interface from scratch, the same reload you would trigger in a browser. It re-fetches your account state and repaints the charts, DOM, and order tickets. Nothing about your account changes, because none of it is stored in that window. Your positions, orders, stops, and targets sit on Tradovate's servers, so a repaint just redraws what is already there." },
    { type: "quote", html: "Good to know before you touch anything: a refresh never cancels an order or closes a position. It only redraws the screen. So if you are in a live trade when the window goes blank, F5 is safe to press, and it is the fastest way to get your controls back." },
    { type: "heading", text: "Fix It: Refresh the Desktop App with F5" },
    { type: "heading", text: "Step 1: Press F5 (or Fn+F5)" },
    { type: "paragraph", html: "Click once anywhere inside the blank Tradovate window so it has keyboard focus, then press <strong class='text-white'>F5</strong>. On a lot of laptops the function-key row doubles as brightness and volume controls, and F5 on its own triggers one of those. If nothing happens, hold <strong class='text-white'>Fn</strong> and press <strong class='text-white'>F5</strong> together to send a true F5 keystroke. Give it a second or two. The window should reload and your workspace should snap back into place, charts, DOM, and all." },
    { type: "paragraph", html: "This is the fix that clears the large majority of post-update blank screens, and it is worth making a habit. If a chart or the whole layout ever goes blank mid-session again, a quick F5 usually brings it back faster than closing and reopening the app." },
    { type: "heading", text: "Step 2: Cold Restart If a Refresh Doesn't Hold" },
    { type: "paragraph", html: "If F5 does nothing, or the window flashes and goes blank again, close the app completely rather than just refreshing. Right-click the Tradovate icon in the taskbar and choose Close window, or use Task Manager to end the process if it is unresponsive, so no stale copy is left running. Then launch it fresh and log back in. A cold start rebuilds the window from zero, which handles the cases a single reload cannot." },
    { type: "heading", text: "Step 3: Restore Your Workspace If the Layout Loads Empty" },
    { type: "paragraph", html: "Sometimes the app itself loads fine after a refresh or restart, but the layout is blank: no charts, no panels, just an empty canvas. That is almost always a reset workspace, not lost work. Open the <strong class='text-white'>New (+) menu</strong> in the top-left corner of the platform and look for your saved workspace in the list. Click it to reload your full setup. If you would rather start clean, save your current view as a backup first, then pick <strong class='text-white'>Reset Default Workspace</strong> from that same menu to drop back to a standard layout you can rebuild from." },
    { type: "paragraph", html: "Menu wording shifts between platform versions, so the exact label on your build might read slightly differently. The destination is the same: the workspace menu in the top-left, where you save, load, and reset layouts. If you never saved a workspace, you will need to re-add your charts and modules and then save it, so a future reset is a one-click restore instead of a rebuild." },
    { type: "heading", text: "If It's Still Blank After Refreshing" },
    { type: "heading", text: "Update or Reinstall the Desktop App" },
    { type: "paragraph", html: "A Windows 11 update can leave an older desktop build in a state it does not recover from cleanly. Grab the current version from the official <strong class='text-white'>Tradovate Devices</strong> download page, install it over the top, and relaunch. If the latest version still opens blank, uninstall it completely, restart Windows, then install a fresh copy for a clean build running against your updated system." },
    { type: "heading", text: "Fall Back to the Web Version" },
    { type: "paragraph", html: "You do not have to fix the desktop app before you can trade again. The web platform opens in any modern browser and gives you the exact same account, charts, and order controls. Sign in there to keep working while you troubleshoot the desktop window, and lean on it as your backup any time the installed app acts up after an update." },
    { type: "heading", text: "Clear the App's Local Cache" },
    { type: "paragraph", html: "If refreshes and reinstalls both leave the window blank, stale local data can be the culprit. Sign out fully, close the app, and sign back in to force a clean pull of your session and layout from the server. Paired with a fresh install, that clears any local state the update corrupted." },
    { type: "heading", text: "Contact Support If It Keeps Crashing to Blank" },
    { type: "paragraph", html: "Blank or white-screen crashes that keep coming back, even across clean reinstalls on more than one machine, usually point at something on the system rather than a single bad app file. Update your graphics driver, take any remaining Windows updates, and reboot. If the window still crashes to blank, report it to Tradovate support and include your exact Windows build number and the app version so they can trace it. Keep using the web or mobile client to manage risk while that is in progress." },
    { type: "heading", text: "Manage Your Risk While the Screen Is Blank" },
    { type: "paragraph", html: "A blank desktop window does not cancel a single order. Every stop and target you placed is resting on Tradovate's servers and keeps working no matter what your screen shows. If you are in a live position when the window goes dark, do not click blind. Press F5 to bring the layout back, and if that stalls, open the web platform or the mobile app to see and control the same account. The habit that keeps you safe is simple: never let one client be the only way you can reach your positions." },
    { type: "heading", text: "Troubleshooting Table" },
    {
      type: "table",
      headers: ["Symptom", "Likely cause", "Fix"],
      rows: [
        ["Whole window blank right after a Windows update", "Stuck render after reboot or driver swap", "Click inside the window and press F5 (or Fn+F5) to reload"],
        ["Refresh flashes then goes blank again", "Wedged app process", "Close the app fully and relaunch, then sign back in"],
        ["App loads but the layout is empty", "Workspace was reset", "New (+) menu → click your saved workspace, or Reset Default Workspace"],
        ["Still blank after refresh and restart", "Old build against updated Windows", "Reinstall the latest version from the Tradovate Devices page"],
        ["Blank crashes keep returning on a clean install", "Graphics driver or system-level issue", "Update graphics driver and Windows; report to support with versions"],
        ["You are in a trade and the screen is blank", "Display-only failure on that machine", "Manage the position from the web or mobile platform; orders stay live"],
      ],
    },
    { type: "heading", text: "Keep Trading Even When the Desktop App Won't Render" },
    { type: "paragraph", html: "If a blank window after an update has ever made you miss a fill, the real fix is to stop depending on any one screen being up. PickMyTrade links your TradingView alerts straight to Tradovate and runs the execution on our servers, so your strategy keeps firing whether or not the desktop app is painting a layout:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Server-side execution.</strong> Alerts route from TradingView to Tradovate through our infrastructure, so a blank desktop window never stops an entry or an exit from going through.",
        "<strong class='text-white'>Device independence.</strong> Nothing needs the desktop app open. Your trades fire from the alert, not from whichever window happens to be up.",
        "<strong class='text-white'>Stops and targets that stick.</strong> The SL and TP defined in your alert are placed on Tradovate regardless of the machine you are on, so your protection does not hinge on the app rendering.",
        "<strong class='text-white'>Multi-account sync.</strong> Mirror the same orders across every connected account at once, so no account is left unmanaged while you refresh or reinstall a client.",
      ],
    },
  ], de: [
    { type: "paragraph",html: "Windows schließt die Installation eines Updates ab, der Rechner startet neu, Sie öffnen die Tradovate-Desktop-App, und das Fenster erscheint leer. Keine Charts, kein DOM, kein Login-Feld. Nur ein flaches weißes oder graues Rechteck, wo Ihr gesamtes Handelslayout sein sollte. Die App läuft offensichtlich, die Titelleiste ist da, aber in ihrem Inneren wird nichts gezeichnet. Öffnen Sie die Browserversion und sie funktioniert einwandfrei, was Ihnen zeigt, dass Konto und Server gesund sind und das Problem auf Ihrem Desktop festsitzt." },
    { type: "paragraph",html: "Hier ist die Lösung gleich vorweg, weil sie zwei Sekunden dauert: <strong class='text-white'>Klicken Sie in das App-Fenster und drücken Sie F5, oder Fn+F5 auf einem Laptop, um es zu aktualisieren.</strong> Die Desktop-App ist dieselbe Web-Plattform in einem eigenen Fenster, ein Reload ruft also die Oberfläche neu ab und zeichnet Ihr Layout ohne vollständigen Neustart neu. Unten erfahren Sie, warum der leere Bildschirm nach einem Update auftritt, was zu tun ist, wenn eine einzelne Aktualisierung nicht hält, wie Sie ein leer geladenes Layout zurückholen und wie Sie während der ganzen Zeit offenes Risiko weiter steuern." },
    {
      type: "checklist",
      heading: "Checkliste für die schnelle Lösung",
      items: [
        "<strong class='text-white'>Drücken Sie zuerst F5.</strong> Klicken Sie einmal in das Fenster, um ihm den Fokus zu geben, und drücken Sie dann F5 (oder Fn+F5, wenn Ihre obere Tastenreihe Medientasten sind). Das Layout sollte in ein bis zwei Sekunden neu gezeichnet werden.",
        "<strong class='text-white'>Immer noch leer? Schließen Sie die App vollständig und öffnen Sie sie erneut.</strong> Ein Kaltstart behebt ein festgefahrenes Fenster, das eine einzelne Aktualisierung nicht erwischt hat.",
        "<strong class='text-white'>Layout kommt leer zurück?</strong> Ihr Workspace wurde zurückgesetzt. Öffnen Sie das Menü New (+) oben links und klicken Sie Ihren gespeicherten Workspace an, um ihn neu zu laden.",
        "<strong class='text-white'>Aktualisieren oder installieren Sie die Desktop-App neu</strong> über die Seite Tradovate Devices, damit die Version zu Ihrem frisch aktualisierten Windows passt.",
        "<strong class='text-white'>Nutzen Sie die Webversion in einem Browser</strong>, um Ihr Konto zu beobachten und zu steuern, während Sie die Desktop-App reparieren.",
        "<strong class='text-white'>Stürzt nach sauberer Neuinstallation weiter auf leer ab?</strong> Aktualisieren Sie Ihren Grafiktreiber und Windows und melden Sie es dem Tradovate-Support mit Ihren Versionsnummern.",
      ],
    },
    { type: "heading",text: "Warum die Desktop-App nach einem Update leer wird" },
    { type: "paragraph",html: "Die Tradovate-Desktop-Plattform bietet dieselbe Funktionalität wie der Web-Trader. Im Kern ist sie diese Weboberfläche in einem eigenständigen Fenster, was sowohl das Symptom als auch die Lösung erklärt. Wenn ein Windows-11-Update eingespielt wird, startet es in der Regel den Rechner neu und kann dabei Ihre Grafiktreiber austauschen oder zurücksetzen. Wurde die App offen gelassen oder startete sie in einem halb aktualisierten Grafikzustand, kann das Fenster mit einer gerenderten Ansicht zurückkehren, die nie fertig gezeichnet wird. Die Verbindung zu Tradovate ist in Ordnung und die Daten fließen, aber die sichtbare Ebene ist auf einem leeren Bild eingefroren." },
    { type: "paragraph",html: "Genau diese Art festhängender Ansicht behebt ein Reload. Mit F5 weisen Sie die App an, das aktuelle Rendering zu verwerfen und die Oberfläche von Grund auf neu aufzubauen, derselbe Reload, den Sie in einem Browser auslösen würden. Sie ruft Ihren Kontozustand neu ab und zeichnet Charts, DOM und Order-Tickets neu. An Ihrem Konto ändert sich nichts, weil nichts davon in diesem Fenster gespeichert ist. Ihre Positionen, Orders, Stops und Ziele liegen auf den Servern von Tradovate, ein Neuzeichnen stellt also nur dar, was bereits da ist." },
    { type: "quote",html: "Gut zu wissen, bevor Sie irgendetwas anfassen: Eine Aktualisierung storniert nie eine Order und schließt nie eine Position. Sie zeichnet nur den Bildschirm neu. Wenn Sie also in einem laufenden Trade sind und das Fenster leer wird, können Sie F5 bedenkenlos drücken, und es ist der schnellste Weg, Ihre Bedienelemente zurückzubekommen." },
    { type: "heading",text: "Lösung: Die Desktop-App mit F5 aktualisieren" },
    { type: "heading",text: "Schritt 1: F5 (oder Fn+F5) drücken" },
    { type: "paragraph",html: "Klicken Sie einmal irgendwo in das leere Tradovate-Fenster, damit es den Tastaturfokus hat, und drücken Sie dann <strong class='text-white'>F5</strong>. Bei vielen Laptops dient die Funktionstastenreihe auch als Helligkeits- und Lautstärkeregler, und F5 allein löst eine davon aus. Passiert nichts, halten Sie <strong class='text-white'>Fn</strong> gedrückt und drücken Sie gleichzeitig <strong class='text-white'>F5</strong>, um einen echten F5-Tastendruck zu senden. Geben Sie ihm ein bis zwei Sekunden. Das Fenster sollte neu laden und Ihr Workspace wieder an seinen Platz springen, Charts, DOM und alles." },
    { type: "paragraph",html: "Das ist die Lösung, die die große Mehrheit der leeren Bildschirme nach Updates behebt, und es lohnt sich, sie zur Gewohnheit zu machen. Wird ein Chart oder das ganze Layout mitten in der Sitzung wieder leer, bringt ein schnelles F5 es meist schneller zurück als das Schließen und erneute Öffnen der App." },
    { type: "heading",text: "Schritt 2: Kaltstart, wenn eine Aktualisierung nicht hält" },
    { type: "paragraph",html: "Passiert bei F5 nichts oder blitzt das Fenster auf und wird wieder leer, schließen Sie die App vollständig, statt nur zu aktualisieren. Klicken Sie mit der rechten Maustaste auf das Tradovate-Symbol in der Taskleiste und wählen Sie Close window, oder beenden Sie den Prozess im Task-Manager, falls er nicht reagiert, damit keine veraltete Kopie weiterläuft. Starten Sie sie dann neu und melden Sie sich erneut an. Ein Kaltstart baut das Fenster von Null auf, was die Fälle abdeckt, die ein einzelner Reload nicht beheben kann." },
    { type: "heading",text: "Schritt 3: Workspace wiederherstellen, wenn das Layout leer lädt" },
    { type: "paragraph",html: "Manchmal lädt die App selbst nach einer Aktualisierung oder einem Neustart einwandfrei, aber das Layout ist leer: keine Charts, keine Panels, nur eine leere Fläche. Das ist fast immer ein zurückgesetzter Workspace, keine verlorene Arbeit. Öffnen Sie das <strong class='text-white'>Menü New (+)</strong> in der oberen linken Ecke der Plattform und suchen Sie Ihren gespeicherten Workspace in der Liste. Klicken Sie ihn an, um Ihre vollständige Einrichtung neu zu laden. Möchten Sie lieber sauber beginnen, speichern Sie Ihre aktuelle Ansicht zuvor als Backup und wählen Sie dann <strong class='text-white'>Reset Default Workspace</strong> im selben Menü, um zu einem Standardlayout zurückzukehren, aus dem Sie neu aufbauen können." },
    { type: "paragraph",html: "Die Menübezeichnungen ändern sich zwischen Plattformversionen, die genaue Beschriftung in Ihrer Version kann also leicht abweichen. Das Ziel ist dasselbe: das Workspace-Menü oben links, in dem Sie Layouts speichern, laden und zurücksetzen. Haben Sie nie einen Workspace gespeichert, müssen Sie Ihre Charts und Module neu hinzufügen und ihn dann speichern, damit ein künftiges Zurücksetzen eine Wiederherstellung mit einem Klick statt eines Neuaufbaus ist." },
    { type: "heading",text: "Wenn es nach der Aktualisierung weiterhin leer ist" },
    { type: "heading",text: "Die Desktop-App aktualisieren oder neu installieren" },
    { type: "paragraph",html: "Ein Windows-11-Update kann eine ältere Desktop-Version in einem Zustand hinterlassen, von dem sie sich nicht sauber erholt. Laden Sie die aktuelle Version von der offiziellen Download-Seite <strong class='text-white'>Tradovate Devices</strong> herunter, installieren Sie sie über die bestehende und starten Sie neu. Öffnet sich auch die neueste Version leer, deinstallieren Sie sie vollständig, starten Sie Windows neu und installieren Sie dann eine frische Kopie für einen sauberen Stand auf Ihrem aktualisierten System." },
    { type: "heading",text: "Auf die Webversion ausweichen" },
    { type: "paragraph",html: "Sie müssen die Desktop-App nicht reparieren, bevor Sie wieder handeln können. Die Web-Plattform öffnet sich in jedem modernen Browser und bietet Ihnen genau dasselbe Konto, dieselben Charts und Order-Steuerungen. Melden Sie sich dort an, um weiterzuarbeiten, während Sie das Desktop-Fenster beheben, und nutzen Sie sie als Backup, wann immer die installierte App nach einem Update zickt." },
    { type: "heading",text: "Den lokalen Cache der App leeren" },
    { type: "paragraph",html: "Lassen Aktualisierungen und Neuinstallationen das Fenster leer, können veraltete lokale Daten die Ursache sein. Melden Sie sich vollständig ab, schließen Sie die App und melden Sie sich wieder an, um einen sauberen Abruf Ihrer Sitzung und Ihres Layouts vom Server zu erzwingen. Zusammen mit einer frischen Installation beseitigt das jeden lokalen Zustand, den das Update beschädigt hat." },
    { type: "heading",text: "Support kontaktieren, wenn es weiter auf leer abstürzt" },
    { type: "paragraph",html: "Abstürze mit leerem oder weißem Bildschirm, die immer wiederkehren, selbst bei sauberen Neuinstallationen auf mehr als einem Rechner, deuten meist auf etwas im System statt auf eine einzelne fehlerhafte App-Datei hin. Aktualisieren Sie Ihren Grafiktreiber, installieren Sie alle verbleibenden Windows-Updates und starten Sie neu. Stürzt das Fenster weiterhin auf leer ab, melden Sie es dem Tradovate-Support und geben Sie Ihre genaue Windows-Build-Nummer und die App-Version an, damit er es nachverfolgen kann. Nutzen Sie währenddessen den Web- oder Mobil-Client, um Ihr Risiko zu steuern." },
    { type: "heading",text: "Risiko steuern, während der Bildschirm leer ist" },
    { type: "paragraph",html: "Ein leeres Desktop-Fenster storniert keine einzige Order. Jeder Stop und jedes Ziel, das Sie platziert haben, liegt auf den Servern von Tradovate und funktioniert weiter, unabhängig davon, was Ihr Bildschirm zeigt. Wenn Sie in einer laufenden Position sind, wenn das Fenster dunkel wird, klicken Sie nicht blind. Drücken Sie F5, um das Layout zurückzubringen, und wenn das stockt, öffnen Sie die Web-Plattform oder die mobile App, um dasselbe Konto zu sehen und zu steuern. Die Gewohnheit, die Sie schützt, ist einfach: Lassen Sie nie einen einzigen Client Ihren einzigen Zugang zu Ihren Positionen sein." },
    { type: "heading",text: "Tabelle zur Fehlerbehebung" },
    { type: "table", headers: ["Symptom","Wahrscheinliche Ursache","Lösung"], rows: [
      ["Ganzes Fenster leer direkt nach einem Windows-Update","Festhängendes Rendering nach Neustart oder Treibertausch","In das Fenster klicken und F5 (oder Fn+F5) zum Neuladen drücken"],
      ["Aktualisierung blitzt auf und wird wieder leer","Festgefahrener App-Prozess","App vollständig schließen und neu starten, dann wieder anmelden"],
      ["App lädt, aber das Layout ist leer","Workspace wurde zurückgesetzt","Menü New (+) → gespeicherten Workspace anklicken oder Reset Default Workspace"],
      ["Nach Aktualisierung und Neustart weiterhin leer","Alte Version auf aktualisiertem Windows","Neueste Version von der Seite Tradovate Devices neu installieren"],
      ["Leere Abstürze kehren bei sauberer Installation zurück","Grafiktreiber- oder Systemproblem","Grafiktreiber und Windows aktualisieren; mit Versionsangaben dem Support melden"],
      ["Sie sind in einem Trade und der Bildschirm ist leer","Reiner Anzeigefehler auf diesem Rechner","Position über die Web- oder mobile Plattform steuern; Orders bleiben aktiv"],
    ] },
    { type: "heading",text: "Weiterhandeln, auch wenn die Desktop-App nicht rendert" },
    { type: "paragraph",html: "Wenn ein leeres Fenster nach einem Update Sie schon einmal einen Fill gekostet hat, besteht die eigentliche Lösung darin, sich nicht mehr von einem einzelnen Bildschirm abhängig zu machen. PickMyTrade verknüpft Ihre TradingView-Alerts direkt mit Tradovate und führt die Ausführung auf unseren Servern aus, sodass Ihre Strategie weiter feuert, egal ob die Desktop-App ein Layout zeichnet:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Serverseitige Ausführung.</strong> Alerts werden über unsere Infrastruktur von TradingView an Tradovate geleitet, sodass ein leeres Desktop-Fenster nie einen Einstieg oder Ausstieg verhindert.",
        "<strong class='text-white'>Geräteunabhängigkeit.</strong> Nichts erfordert eine geöffnete Desktop-App. Ihre Trades werden vom Alert ausgelöst, nicht von dem Fenster, das gerade offen ist.",
        "<strong class='text-white'>Stops und Ziele, die halten.</strong> SL und TP aus Ihrem Alert werden auf Tradovate platziert, unabhängig vom Rechner, auf dem Sie sich befinden, Ihr Schutz hängt also nicht vom Rendering der App ab.",
        "<strong class='text-white'>Multi-Account-Synchronisierung.</strong> Spiegeln Sie dieselben Orders gleichzeitig auf alle verbundenen Konten, damit kein Konto unbeaufsichtigt bleibt, während Sie einen Client aktualisieren oder neu installieren.",
      ],
    },
  ], es: [
    { type: "paragraph",html: "Windows termina de instalar una actualización, el equipo se reinicia, abre la aplicación de escritorio de Tradovate y la ventana aparece en blanco. Sin gráficos, sin DOM, sin cuadro de inicio de sesión. Solo un rectángulo plano blanco o gris donde debería estar todo su diseño de trading. La app claramente se está ejecutando, la barra de título está ahí, pero nada se dibuja en su interior. Abra la versión del navegador y funciona bien, lo que indica que la cuenta y los servidores están sanos y que el problema está atascado en su escritorio." },
    { type: "paragraph",html: "Aquí está la solución por adelantado, porque lleva dos segundos: <strong class='text-white'>haga clic dentro de la ventana de la app y pulse F5, o Fn+F5 en un portátil, para actualizarla.</strong> La aplicación de escritorio es la misma plataforma web ejecutándose en su propia ventana, así que una recarga vuelve a obtener la interfaz y redibuja su diseño sin reiniciar por completo. A continuación verá por qué ocurre la pantalla en blanco tras una actualización, qué hacer cuando una sola actualización no se mantiene, cómo recuperar un diseño que carga vacío y cómo seguir gestionando el riesgo abierto durante todo el proceso." },
    {
      type: "checklist",
      heading: "Lista de verificación de solución rápida",
      items: [
        "<strong class='text-white'>Pulse F5 primero.</strong> Haga clic una vez dentro de la ventana para darle el foco y luego pulse F5 (o Fn+F5 si su fila superior son teclas multimedia). El diseño debería redibujarse en uno o dos segundos.",
        "<strong class='text-white'>¿Sigue en blanco? Cierre la app por completo y vuelva a abrirla.</strong> Un reinicio en frío limpia una ventana atascada que una sola actualización no resolvió.",
        "<strong class='text-white'>¿El diseño vuelve vacío?</strong> Su espacio de trabajo se restableció. Abra el menú New (+) arriba a la izquierda y haga clic en su espacio de trabajo guardado para recargarlo.",
        "<strong class='text-white'>Actualice o reinstale la aplicación de escritorio</strong> desde la página Tradovate Devices para que la versión coincida con su Windows recién actualizado.",
        "<strong class='text-white'>Use la versión web en un navegador</strong> para vigilar y gestionar su cuenta mientras arregla la aplicación de escritorio.",
        "<strong class='text-white'>¿Sigue fallando en blanco tras una reinstalación limpia?</strong> Actualice su controlador gráfico y Windows, y repórtelo al soporte de Tradovate con sus números de versión.",
      ],
    },
    { type: "heading",text: "Por qué la aplicación de escritorio se queda en blanco tras una actualización" },
    { type: "paragraph",html: "La plataforma de escritorio de Tradovate ofrece la misma funcionalidad que el trader web. Por dentro es esa interfaz web envuelta en una ventana independiente, un detalle que explica tanto el síntoma como la solución. Cuando llega una actualización de Windows 11, normalmente reinicia el equipo y puede cambiar o restablecer sus controladores gráficos en el proceso. Si la app quedó abierta, o se lanzó con un estado gráfico a medio actualizar, la ventana puede volver con una vista renderizada que nunca termina de dibujarse. La conexión con Tradovate está bien y los datos fluyen, pero la capa visible está congelada en un fotograma vacío." },
    { type: "paragraph",html: "Esa es exactamente la clase de vista atascada que arregla una recarga. Pulsar F5 indica a la app que descarte el renderizado actual y reconstruya la interfaz desde cero, la misma recarga que activaría en un navegador. Vuelve a obtener el estado de su cuenta y redibuja los gráficos, el DOM y los tickets de órdenes. Nada de su cuenta cambia, porque nada de eso se almacena en esa ventana. Sus posiciones, órdenes, stops y objetivos están en los servidores de Tradovate, así que un redibujado solo vuelve a pintar lo que ya existe." },
    { type: "quote",html: "Conviene saber antes de tocar nada: una actualización nunca cancela una orden ni cierra una posición. Solo redibuja la pantalla. Así que, si está en una operación en vivo cuando la ventana se queda en blanco, puede pulsar F5 con seguridad, y es la forma más rápida de recuperar sus controles." },
    { type: "heading",text: "Solución: actualizar la aplicación de escritorio con F5" },
    { type: "heading",text: "Paso 1: pulse F5 (o Fn+F5)" },
    { type: "paragraph",html: "Haga clic una vez en cualquier punto de la ventana en blanco de Tradovate para que tenga el foco del teclado y luego pulse <strong class='text-white'>F5</strong>. En muchos portátiles la fila de teclas de función también sirve de control de brillo y volumen, y F5 por sí solo activa uno de ellos. Si no ocurre nada, mantenga pulsada <strong class='text-white'>Fn</strong> y pulse <strong class='text-white'>F5</strong> a la vez para enviar una pulsación real de F5. Dele uno o dos segundos. La ventana debería recargarse y su espacio de trabajo volver a su sitio, gráficos, DOM y todo." },
    { type: "paragraph",html: "Esta es la solución que despeja la gran mayoría de las pantallas en blanco tras una actualización, y merece la pena convertirla en hábito. Si un gráfico o todo el diseño vuelve a quedarse en blanco a mitad de sesión, un rápido F5 suele recuperarlo más rápido que cerrar y volver a abrir la app." },
    { type: "heading",text: "Paso 2: reinicio en frío si la actualización no se mantiene" },
    { type: "paragraph",html: "Si F5 no hace nada, o la ventana parpadea y vuelve a quedarse en blanco, cierre la app por completo en lugar de solo actualizarla. Haga clic con el botón derecho en el icono de Tradovate de la barra de tareas y elija Close window, o use el Administrador de tareas para finalizar el proceso si no responde, de modo que no quede ninguna copia obsoleta en ejecución. Luego ábrala de nuevo e inicie sesión otra vez. Un inicio en frío reconstruye la ventana desde cero, lo que resuelve los casos que una sola recarga no puede." },
    { type: "heading",text: "Paso 3: restaure su espacio de trabajo si el diseño carga vacío" },
    { type: "paragraph",html: "A veces la propia app carga bien tras una actualización o un reinicio, pero el diseño está en blanco: sin gráficos, sin paneles, solo un lienzo vacío. Casi siempre es un espacio de trabajo restablecido, no trabajo perdido. Abra el <strong class='text-white'>menú New (+)</strong> en la esquina superior izquierda de la plataforma y busque su espacio de trabajo guardado en la lista. Haga clic en él para recargar su configuración completa. Si prefiere empezar de cero, guarde primero su vista actual como copia de seguridad y luego elija <strong class='text-white'>Reset Default Workspace</strong> en ese mismo menú para volver a un diseño estándar desde el que reconstruir." },
    { type: "paragraph",html: "La redacción de los menús cambia entre versiones de la plataforma, así que la etiqueta exacta en su versión puede leerse algo distinta. El destino es el mismo: el menú de espacios de trabajo arriba a la izquierda, donde guarda, carga y restablece diseños. Si nunca guardó un espacio de trabajo, tendrá que volver a añadir sus gráficos y módulos y luego guardarlo, de modo que un futuro restablecimiento sea una restauración con un clic en lugar de una reconstrucción." },
    { type: "heading",text: "Si sigue en blanco tras actualizar" },
    { type: "heading",text: "Actualice o reinstale la aplicación de escritorio" },
    { type: "paragraph",html: "Una actualización de Windows 11 puede dejar una versión de escritorio antigua en un estado del que no se recupera limpiamente. Descargue la versión actual desde la página oficial de descargas <strong class='text-white'>Tradovate Devices</strong>, instálela encima y reinicie la app. Si la última versión sigue abriéndose en blanco, desinstálela por completo, reinicie Windows y luego instale una copia nueva para disponer de una versión limpia sobre su sistema actualizado." },
    { type: "heading",text: "Recurra a la versión web" },
    { type: "paragraph",html: "No tiene que arreglar la aplicación de escritorio para poder volver a operar. La plataforma web se abre en cualquier navegador moderno y le da exactamente la misma cuenta, gráficos y controles de órdenes. Inicie sesión allí para seguir trabajando mientras soluciona la ventana de escritorio, y úsela como respaldo siempre que la app instalada falle tras una actualización." },
    { type: "heading",text: "Borre la caché local de la app" },
    { type: "paragraph",html: "Si las actualizaciones y las reinstalaciones dejan la ventana en blanco, los datos locales obsoletos pueden ser la causa. Cierre sesión por completo, cierre la app e inicie sesión de nuevo para forzar una descarga limpia de su sesión y diseño desde el servidor. Junto con una instalación nueva, eso elimina cualquier estado local que la actualización haya dañado." },
    { type: "heading",text: "Contacte con el soporte si sigue fallando en blanco" },
    { type: "paragraph",html: "Los fallos de pantalla en blanco o blanca que siguen volviendo, incluso con reinstalaciones limpias en más de un equipo, suelen apuntar a algo del sistema y no a un único archivo defectuoso de la app. Actualice su controlador gráfico, instale las actualizaciones de Windows restantes y reinicie. Si la ventana sigue fallando en blanco, repórtelo al soporte de Tradovate e incluya el número exacto de compilación de Windows y la versión de la app para que puedan rastrearlo. Siga usando el cliente web o móvil para gestionar el riesgo mientras tanto." },
    { type: "heading",text: "Gestione su riesgo mientras la pantalla está en blanco" },
    { type: "paragraph",html: "Una ventana de escritorio en blanco no cancela ni una sola orden. Cada stop y objetivo que colocó reposa en los servidores de Tradovate y sigue funcionando sin importar lo que muestre su pantalla. Si está en una posición en vivo cuando la ventana se oscurece, no haga clic a ciegas. Pulse F5 para recuperar el diseño y, si se atasca, abra la plataforma web o la app móvil para ver y controlar la misma cuenta. El hábito que le mantiene a salvo es sencillo: nunca deje que un solo cliente sea su única vía de acceso a sus posiciones." },
    { type: "heading",text: "Tabla de solución de problemas" },
    { type: "table", headers: ["Síntoma","Causa probable","Solución"], rows: [
      ["Toda la ventana en blanco justo tras una actualización de Windows","Renderizado atascado tras el reinicio o el cambio de controlador","Haga clic dentro de la ventana y pulse F5 (o Fn+F5) para recargar"],
      ["La actualización parpadea y vuelve a quedarse en blanco","Proceso de la app atascado","Cierre la app por completo y vuelva a abrirla, luego inicie sesión de nuevo"],
      ["La app carga pero el diseño está vacío","El espacio de trabajo se restableció","Menú New (+) → haga clic en su espacio de trabajo guardado, o en Reset Default Workspace"],
      ["Sigue en blanco tras actualizar y reiniciar","Versión antigua sobre un Windows actualizado","Reinstale la última versión desde la página Tradovate Devices"],
      ["Los fallos en blanco vuelven en una instalación limpia","Problema de controlador gráfico o de sistema","Actualice el controlador gráfico y Windows; reporte al soporte con las versiones"],
      ["Está en una operación y la pantalla está en blanco","Fallo solo de visualización en ese equipo","Gestione la posición desde la plataforma web o móvil; las órdenes siguen activas"],
    ] },
    { type: "heading",text: "Siga operando aunque la aplicación de escritorio no se renderice" },
    { type: "paragraph",html: "Si una ventana en blanco tras una actualización le ha hecho perder alguna vez un fill, la verdadera solución es dejar de depender de que una pantalla concreta esté activa. PickMyTrade vincula sus alertas de TradingView directamente con Tradovate y ejecuta en nuestros servidores, de modo que su estrategia sigue disparando tanto si la aplicación de escritorio dibuja un diseño como si no:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Ejecución en el servidor.</strong> Las alertas se enrutan de TradingView a Tradovate a través de nuestra infraestructura, así que una ventana de escritorio en blanco nunca impide que se ejecute una entrada o una salida.",
        "<strong class='text-white'>Independencia del dispositivo.</strong> Nada requiere que la aplicación de escritorio esté abierta. Sus operaciones se disparan desde la alerta, no desde la ventana que esté abierta.",
        "<strong class='text-white'>Stops y objetivos que se mantienen.</strong> El SL y el TP definidos en su alerta se colocan en Tradovate con independencia del equipo en el que esté, así que su protección no depende de que la app se renderice.",
        "<strong class='text-white'>Sincronización multicuenta.</strong> Replique las mismas órdenes en todas las cuentas conectadas a la vez, de modo que ninguna cuenta quede sin gestionar mientras actualiza o reinstala un cliente.",
      ],
    },
  ], fr: [
    { type: "paragraph",html: "Windows termine l'installation d'une mise à jour, la machine redémarre, vous ouvrez l'application de bureau Tradovate et la fenêtre s'affiche vide. Pas de graphiques, pas de DOM, pas de zone de connexion. Juste un rectangle blanc ou gris uni là où toute votre disposition de trading devrait se trouver. L'app tourne clairement, la barre de titre est là, mais rien ne s'affiche à l'intérieur. Ouvrez la version navigateur et elle fonctionne parfaitement, ce qui vous indique que le compte et les serveurs sont sains et que le problème est bloqué sur votre poste." },
    { type: "paragraph",html: "Voici le correctif d'emblée, car il prend deux secondes : <strong class='text-white'>cliquez dans la fenêtre de l'app et appuyez sur F5, ou Fn+F5 sur un portable, pour l'actualiser.</strong> L'application de bureau est la même plateforme web exécutée dans sa propre fenêtre, de sorte qu'un rechargement récupère de nouveau l'interface et redessine votre disposition sans redémarrage complet. Vous verrez ci-dessous pourquoi l'écran vide apparaît après une mise à jour, que faire lorsqu'une seule actualisation ne tient pas, comment récupérer une disposition qui se charge vide et comment continuer à gérer le risque ouvert pendant tout ce temps." },
    {
      type: "checklist",
      heading: "Liste de contrôle de correction rapide",
      items: [
        "<strong class='text-white'>Appuyez d'abord sur F5.</strong> Cliquez une fois dans la fenêtre pour lui donner le focus, puis appuyez sur F5 (ou Fn+F5 si votre rangée du haut correspond aux touches multimédias). La disposition devrait se redessiner en une ou deux secondes.",
        "<strong class='text-white'>Toujours vide ? Fermez complètement l'app et rouvrez-la.</strong> Un redémarrage à froid débloque une fenêtre coincée qu'une simple actualisation n'a pas résolue.",
        "<strong class='text-white'>La disposition revient vide ?</strong> Votre espace de travail a été réinitialisé. Ouvrez le menu New (+) en haut à gauche et cliquez sur votre espace de travail enregistré pour le recharger.",
        "<strong class='text-white'>Mettez à jour ou réinstallez l'application de bureau</strong> depuis la page Tradovate Devices afin que la version corresponde à votre Windows fraîchement mis à jour.",
        "<strong class='text-white'>Utilisez la version web dans un navigateur</strong> pour surveiller et gérer votre compte pendant que vous réparez l'application de bureau.",
        "<strong class='text-white'>Plante toujours à vide après une réinstallation propre ?</strong> Mettez à jour votre pilote graphique et Windows, et signalez-le au support Tradovate avec vos numéros de version.",
      ],
    },
    { type: "heading",text: "Pourquoi l'application de bureau devient vide après une mise à jour" },
    { type: "paragraph",html: "La plateforme de bureau Tradovate offre les mêmes fonctionnalités que le trader web. Sous le capot, c'est cette interface web enveloppée dans une fenêtre autonome, détail qui explique à la fois le symptôme et le correctif. Lorsqu'une mise à jour de Windows 11 arrive, elle redémarre généralement la machine et peut remplacer ou réinitialiser vos pilotes graphiques au passage. Si l'app est restée ouverte, ou si elle s'est lancée dans un état graphique à moitié mis à jour, la fenêtre peut revenir avec une vue rendue qui ne finit jamais de se dessiner. La connexion à Tradovate est correcte et les données circulent, mais la couche visible est figée sur une image vide." },
    { type: "paragraph",html: "C'est exactement le genre de vue bloquée qu'un rechargement corrige. Appuyer sur F5 demande à l'app de jeter le rendu actuel et de reconstruire l'interface de zéro, le même rechargement que vous déclencheriez dans un navigateur. Elle récupère de nouveau l'état de votre compte et redessine les graphiques, le DOM et les tickets d'ordres. Rien ne change dans votre compte, car rien de tout cela n'est stocké dans cette fenêtre. Vos positions, ordres, stops et objectifs se trouvent sur les serveurs de Tradovate ; un redessin ne fait donc que redessiner ce qui est déjà là." },
    { type: "quote",html: "Bon à savoir avant de toucher à quoi que ce soit : une actualisation n'annule jamais un ordre et ne ferme jamais une position. Elle ne fait que redessiner l'écran. Donc si vous êtes dans un trade en cours quand la fenêtre devient vide, vous pouvez appuyer sur F5 sans risque, et c'est le moyen le plus rapide de récupérer vos contrôles." },
    { type: "heading",text: "Correctif : actualiser l'application de bureau avec F5" },
    { type: "heading",text: "Étape 1 : appuyez sur F5 (ou Fn+F5)" },
    { type: "paragraph",html: "Cliquez une fois n'importe où dans la fenêtre Tradovate vide pour lui donner le focus clavier, puis appuyez sur <strong class='text-white'>F5</strong>. Sur beaucoup de portables, la rangée des touches de fonction sert aussi de commandes de luminosité et de volume, et F5 seule en déclenche une. Si rien ne se passe, maintenez <strong class='text-white'>Fn</strong> et appuyez sur <strong class='text-white'>F5</strong> ensemble pour envoyer une vraie frappe F5. Laissez-lui une à deux secondes. La fenêtre devrait se recharger et votre espace de travail se remettre en place, graphiques, DOM et tout le reste." },
    { type: "paragraph",html: "C'est le correctif qui règle la grande majorité des écrans vides après mise à jour, et mieux vaut en faire une habitude. Si un graphique ou toute la disposition redevient vide en cours de session, un F5 rapide la ramène généralement plus vite que fermer et rouvrir l'app." },
    { type: "heading",text: "Étape 2 : redémarrage à froid si l'actualisation ne tient pas" },
    { type: "paragraph",html: "Si F5 ne fait rien, ou si la fenêtre clignote et redevient vide, fermez complètement l'app plutôt que de simplement l'actualiser. Faites un clic droit sur l'icône Tradovate dans la barre des tâches et choisissez Close window, ou utilisez le Gestionnaire des tâches pour terminer le processus s'il ne répond pas, afin qu'aucune copie périmée ne reste en cours d'exécution. Relancez-la ensuite à neuf et reconnectez-vous. Un démarrage à froid reconstruit la fenêtre à partir de zéro, ce qui règle les cas qu'un simple rechargement ne peut pas résoudre." },
    { type: "heading",text: "Étape 3 : restaurer votre espace de travail si la disposition se charge vide" },
    { type: "paragraph",html: "Parfois l'app elle-même se charge bien après une actualisation ou un redémarrage, mais la disposition est vide : pas de graphiques, pas de panneaux, juste une toile vide. C'est presque toujours un espace de travail réinitialisé, pas un travail perdu. Ouvrez le <strong class='text-white'>menu New (+)</strong> dans le coin supérieur gauche de la plateforme et repérez votre espace de travail enregistré dans la liste. Cliquez dessus pour recharger toute votre configuration. Si vous préférez repartir à zéro, enregistrez d'abord votre vue actuelle comme sauvegarde, puis choisissez <strong class='text-white'>Reset Default Workspace</strong> dans ce même menu pour revenir à une disposition standard à partir de laquelle reconstruire." },
    { type: "paragraph",html: "La formulation des menus varie d'une version de la plateforme à l'autre ; le libellé exact de votre version peut donc différer légèrement. La destination est la même : le menu des espaces de travail en haut à gauche, où vous enregistrez, chargez et réinitialisez les dispositions. Si vous n'avez jamais enregistré d'espace de travail, vous devrez rajouter vos graphiques et modules puis l'enregistrer, afin qu'une future réinitialisation soit une restauration en un clic plutôt qu'une reconstruction." },
    { type: "heading",text: "S'il est toujours vide après l'actualisation" },
    { type: "heading",text: "Mettre à jour ou réinstaller l'application de bureau" },
    { type: "paragraph",html: "Une mise à jour de Windows 11 peut laisser une ancienne version de bureau dans un état dont elle ne se remet pas proprement. Récupérez la version actuelle sur la page de téléchargement officielle <strong class='text-white'>Tradovate Devices</strong>, installez-la par-dessus et relancez. Si la dernière version s'ouvre toujours vide, désinstallez-la complètement, redémarrez Windows, puis installez une copie neuve pour obtenir une version propre sur votre système mis à jour." },
    { type: "heading",text: "Se rabattre sur la version web" },
    { type: "paragraph",html: "Vous n'avez pas à réparer l'application de bureau avant de pouvoir trader de nouveau. La plateforme web s'ouvre dans n'importe quel navigateur moderne et vous donne exactement le même compte, les mêmes graphiques et les mêmes contrôles d'ordres. Connectez-vous-y pour continuer à travailler pendant que vous dépannez la fenêtre de bureau, et servez-vous-en comme solution de secours chaque fois que l'app installée fait des siennes après une mise à jour." },
    { type: "heading",text: "Vider le cache local de l'app" },
    { type: "paragraph",html: "Si les actualisations et les réinstallations laissent la fenêtre vide, des données locales périmées peuvent être en cause. Déconnectez-vous complètement, fermez l'app et reconnectez-vous pour forcer une récupération propre de votre session et de votre disposition depuis le serveur. Associé à une installation neuve, cela efface tout état local corrompu par la mise à jour." },
    { type: "heading",text: "Contacter le support si elle continue de planter à vide" },
    { type: "paragraph",html: "Les plantages à écran vide ou blanc qui reviennent, même après des réinstallations propres sur plus d'une machine, pointent généralement vers quelque chose du système plutôt qu'un seul mauvais fichier de l'app. Mettez à jour votre pilote graphique, installez les mises à jour Windows restantes et redémarrez. Si la fenêtre plante toujours à vide, signalez-le au support Tradovate en indiquant votre numéro de build Windows exact et la version de l'app afin qu'il puisse le retracer. Continuez à utiliser le client web ou mobile pour gérer le risque pendant ce temps." },
    { type: "heading",text: "Gérez votre risque pendant que l'écran est vide" },
    { type: "paragraph",html: "Une fenêtre de bureau vide n'annule pas un seul ordre. Chaque stop et chaque objectif que vous avez placés reposent sur les serveurs de Tradovate et continuent de fonctionner quoi qu'affiche votre écran. Si vous êtes dans une position en cours quand la fenêtre s'éteint, ne cliquez pas à l'aveugle. Appuyez sur F5 pour récupérer la disposition et, si cela cale, ouvrez la plateforme web ou l'application mobile pour voir et contrôler le même compte. L'habitude qui vous protège est simple : ne laissez jamais un seul client être votre unique moyen d'accéder à vos positions." },
    { type: "heading",text: "Tableau de dépannage" },
    { type: "table", headers: ["Symptôme","Cause probable","Correctif"], rows: [
      ["Toute la fenêtre est vide juste après une mise à jour de Windows","Rendu bloqué après redémarrage ou changement de pilote","Cliquez dans la fenêtre et appuyez sur F5 (ou Fn+F5) pour recharger"],
      ["L'actualisation clignote puis redevient vide","Processus de l'app bloqué","Fermer complètement l'app et la relancer, puis se reconnecter"],
      ["L'app se charge mais la disposition est vide","L'espace de travail a été réinitialisé","Menu New (+) → cliquez sur votre espace de travail enregistré, ou sur Reset Default Workspace"],
      ["Toujours vide après actualisation et redémarrage","Ancienne version sur Windows mis à jour","Réinstaller la dernière version depuis la page Tradovate Devices"],
      ["Les plantages à vide reviennent sur une installation propre","Problème de pilote graphique ou de niveau système","Mettre à jour le pilote graphique et Windows ; signaler au support avec les versions"],
      ["Vous êtes dans un trade et l'écran est vide","Défaillance d'affichage uniquement sur cette machine","Gérer la position depuis la plateforme web ou mobile ; les ordres restent actifs"],
    ] },
    { type: "heading",text: "Continuez à trader même quand l'application de bureau ne s'affiche pas" },
    { type: "paragraph",html: "Si une fenêtre vide après une mise à jour vous a déjà fait manquer un fill, la vraie solution est de ne plus dépendre d'un écran en particulier. PickMyTrade relie vos alertes TradingView directement à Tradovate et exécute sur nos serveurs, de sorte que votre stratégie continue de se déclencher que l'application de bureau affiche ou non une disposition :" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Exécution côté serveur.</strong> Les alertes sont acheminées de TradingView vers Tradovate via notre infrastructure, de sorte qu'une fenêtre de bureau vide n'empêche jamais une entrée ou une sortie de passer.",
        "<strong class='text-white'>Indépendance vis-à-vis de l'appareil.</strong> Rien n'exige que l'application de bureau soit ouverte. Vos trades se déclenchent depuis l'alerte, pas depuis la fenêtre qui se trouve ouverte.",
        "<strong class='text-white'>Stops et objectifs qui tiennent.</strong> Le SL et le TP définis dans votre alerte sont placés sur Tradovate quelle que soit la machine sur laquelle vous vous trouvez, votre protection ne dépend donc pas du rendu de l'app.",
        "<strong class='text-white'>Synchronisation multi-comptes.</strong> Répliquez les mêmes ordres sur tous les comptes connectés en une fois, afin qu'aucun compte ne reste sans gestion pendant que vous actualisez ou réinstallez un client.",
      ],
    },
  ], it: [
    { type: "paragraph",html: "Windows termina l'installazione di un aggiornamento, la macchina si riavvia, lei apre l'app desktop Tradovate e la finestra compare vuota. Nessun grafico, nessun DOM, nessuna casella di login. Solo un rettangolo piatto bianco o grigio dove dovrebbe esserci tutto il suo layout di trading. L'app è chiaramente in esecuzione, la barra del titolo c'è, ma al suo interno non viene disegnato nulla. Apra la versione browser e funziona perfettamente, il che le dice che account e server sono sani e che il problema è bloccato sul suo desktop." },
    { type: "paragraph",html: "Ecco subito la correzione, perché richiede due secondi: <strong class='text-white'>faccia clic all'interno della finestra dell'app e prema F5, o Fn+F5 su un portatile, per aggiornarla.</strong> L'app desktop è la stessa piattaforma web in esecuzione in una propria finestra, quindi un ricaricamento recupera di nuovo l'interfaccia e ridisegna il suo layout senza riavvio completo. Di seguito trova perché la schermata vuota compare dopo un aggiornamento, cosa fare quando un singolo aggiornamento non regge, come recuperare un layout che si carica vuoto e come continuare a gestire il rischio aperto per tutto il tempo." },
    {
      type: "checklist",
      heading: "Checklist di correzione rapida",
      items: [
        "<strong class='text-white'>Prema prima F5.</strong> Faccia clic una volta all'interno della finestra per darle il focus, poi prema F5 (o Fn+F5 se la sua riga superiore corrisponde ai tasti multimediali). Il layout dovrebbe ridisegnarsi in un paio di secondi.",
        "<strong class='text-white'>Ancora vuota? Chiuda completamente l'app e la riapra.</strong> Un riavvio a freddo risolve una finestra bloccata che un singolo aggiornamento non ha risolto.",
        "<strong class='text-white'>Il layout torna vuoto?</strong> Il suo workspace è stato reimpostato. Apra il menu New (+) in alto a sinistra e clicchi il suo workspace salvato per ricaricarlo.",
        "<strong class='text-white'>Aggiorni o reinstalli l'app desktop</strong> dalla pagina Tradovate Devices in modo che la versione corrisponda al suo Windows appena aggiornato.",
        "<strong class='text-white'>Usi la versione web in un browser</strong> per osservare e gestire il suo account mentre ripara l'app desktop.",
        "<strong class='text-white'>Va ancora in crash a vuoto dopo una reinstallazione pulita?</strong> Aggiorni il driver grafico e Windows, e lo segnali al supporto Tradovate con i suoi numeri di versione.",
      ],
    },
    { type: "heading",text: "Perché l'app desktop diventa vuota dopo un aggiornamento" },
    { type: "paragraph",html: "La piattaforma desktop Tradovate offre le stesse funzionalità del trader web. Sotto il cofano è quell'interfaccia web racchiusa in una finestra autonoma, il dettaglio che spiega sia il sintomo sia la correzione. Quando arriva un aggiornamento di Windows 11, di solito riavvia la macchina e nel processo può sostituire o reimpostare i suoi driver grafici. Se l'app è stata lasciata aperta, oppure si è avviata in uno stato grafico aggiornato a metà, la finestra può tornare con una vista renderizzata che non finisce mai di disegnarsi. La connessione a Tradovate è a posto e i dati fluiscono, ma il livello visibile è congelato su un fotogramma vuoto." },
    { type: "paragraph",html: "È esattamente il tipo di vista bloccata che un ricaricamento risolve. Premere F5 dice all'app di scartare il rendering corrente e ricostruire l'interfaccia da zero, lo stesso ricaricamento che attiverebbe in un browser. Recupera di nuovo lo stato del suo account e ridisegna grafici, DOM e ticket degli ordini. Nulla del suo account cambia, perché niente di tutto ciò è memorizzato in quella finestra. Le sue posizioni, ordini, stop e target sono sui server di Tradovate, quindi un ridisegno ridisegna solo ciò che c'è già." },
    { type: "quote",html: "Bene da sapere prima di toccare qualsiasi cosa: un aggiornamento non annulla mai un ordine né chiude una posizione. Ridisegna solo lo schermo. Quindi, se è in un trade live quando la finestra diventa vuota, può premere F5 in sicurezza, ed è il modo più rapido per riavere i suoi controlli." },
    { type: "heading",text: "Correzione: aggiornare l'app desktop con F5" },
    { type: "heading",text: "Passaggio 1: prema F5 (o Fn+F5)" },
    { type: "paragraph",html: "Faccia clic una volta in un punto qualsiasi della finestra Tradovate vuota in modo che abbia il focus della tastiera, poi prema <strong class='text-white'>F5</strong>. Su molti portatili la riga dei tasti funzione funge anche da controllo di luminosità e volume, e F5 da solo ne attiva uno. Se non succede nulla, tenga premuto <strong class='text-white'>Fn</strong> e prema <strong class='text-white'>F5</strong> insieme per inviare una vera pressione di F5. Gli dia uno o due secondi. La finestra dovrebbe ricaricarsi e il suo workspace tornare al proprio posto, grafici, DOM e tutto il resto." },
    { type: "paragraph",html: "Questa è la correzione che risolve la grande maggioranza delle schermate vuote dopo l'aggiornamento, e vale la pena farne un'abitudine. Se un grafico o l'intero layout torna a essere vuoto a metà sessione, un rapido F5 di solito lo riporta più in fretta che chiudere e riaprire l'app." },
    { type: "heading",text: "Passaggio 2: riavvio a freddo se l'aggiornamento non regge" },
    { type: "paragraph",html: "Se F5 non fa nulla, o la finestra lampeggia e torna vuota, chiuda completamente l'app anziché limitarsi ad aggiornarla. Faccia clic con il tasto destro sull'icona Tradovate nella barra delle applicazioni e scelga Close window, oppure usi Gestione attività per terminare il processo se non risponde, così che non resti in esecuzione alcuna copia obsoleta. Poi la avvii da capo e acceda di nuovo. Un avvio a freddo ricostruisce la finestra da zero, il che risolve i casi che un singolo ricaricamento non può." },
    { type: "heading",text: "Passaggio 3: ripristinare il workspace se il layout si carica vuoto" },
    { type: "paragraph",html: "A volte l'app stessa si carica bene dopo un aggiornamento o un riavvio, ma il layout è vuoto: nessun grafico, nessun pannello, solo una tela vuota. Quasi sempre è un workspace reimpostato, non un lavoro perso. Apra il <strong class='text-white'>menu New (+)</strong> nell'angolo in alto a sinistra della piattaforma e cerchi il suo workspace salvato nell'elenco. Lo clicchi per ricaricare l'intera configurazione. Se preferisce ripartire da zero, salvi prima la sua vista attuale come backup, poi scelga <strong class='text-white'>Reset Default Workspace</strong> dallo stesso menu per tornare a un layout standard da cui ricostruire." },
    { type: "paragraph",html: "La formulazione dei menu cambia tra le versioni della piattaforma, quindi l'etichetta esatta nella sua build può leggersi in modo leggermente diverso. La destinazione è la stessa: il menu dei workspace in alto a sinistra, dove salva, carica e reimposta i layout. Se non ha mai salvato un workspace, dovrà aggiungere di nuovo grafici e moduli e poi salvarlo, così che un futuro ripristino sia un ripristino con un clic anziché una ricostruzione." },
    { type: "heading",text: "Se è ancora vuota dopo l'aggiornamento" },
    { type: "heading",text: "Aggiornare o reinstallare l'app desktop" },
    { type: "paragraph",html: "Un aggiornamento di Windows 11 può lasciare una vecchia build desktop in uno stato da cui non si riprende in modo pulito. Scarichi la versione attuale dalla pagina di download ufficiale <strong class='text-white'>Tradovate Devices</strong>, la installi sopra e la riavvii. Se l'ultima versione si apre ancora vuota, la disinstalli completamente, riavvii Windows, poi installi una copia nuova per avere una build pulita sul suo sistema aggiornato." },
    { type: "heading",text: "Ripiegare sulla versione web" },
    { type: "paragraph",html: "Non deve riparare l'app desktop prima di poter operare di nuovo. La piattaforma web si apre in qualsiasi browser moderno e le offre esattamente lo stesso account, gli stessi grafici e gli stessi controlli degli ordini. Acceda lì per continuare a lavorare mentre risolve il problema della finestra desktop, e la usi come backup ogni volta che l'app installata fa i capricci dopo un aggiornamento." },
    { type: "heading",text: "Svuotare la cache locale dell'app" },
    { type: "paragraph",html: "Se aggiornamenti e reinstallazioni lasciano entrambi la finestra vuota, la colpa può essere di dati locali obsoleti. Esca completamente, chiuda l'app e acceda di nuovo per forzare un recupero pulito della sua sessione e del layout dal server. Insieme a un'installazione nuova, ciò elimina qualsiasi stato locale che l'aggiornamento ha corrotto." },
    { type: "heading",text: "Contattare il supporto se continua ad andare in crash a vuoto" },
    { type: "paragraph",html: "I crash con schermata vuota o bianca che continuano a ripresentarsi, anche con reinstallazioni pulite su più di una macchina, di solito indicano qualcosa del sistema anziché un singolo file dell'app danneggiato. Aggiorni il driver grafico, installi gli aggiornamenti di Windows rimanenti e riavvii. Se la finestra va ancora in crash a vuoto, lo segnali al supporto Tradovate e includa il numero esatto della build di Windows e la versione dell'app così che possano risalire alla causa. Continui a usare il client web o mobile per gestire il rischio mentre ciò è in corso." },
    { type: "heading",text: "Gestisca il suo rischio mentre lo schermo è vuoto" },
    { type: "paragraph",html: "Una finestra desktop vuota non annulla un solo ordine. Ogni stop e target che ha inserito risiede sui server di Tradovate e continua a funzionare a prescindere da cosa mostri il suo schermo. Se è in una posizione live quando la finestra si oscura, non clicchi alla cieca. Prema F5 per riavere il layout e, se si blocca, apra la piattaforma web o l'app mobile per vedere e controllare lo stesso account. L'abitudine che la mantiene al sicuro è semplice: non lasci mai che un solo client sia l'unico modo per raggiungere le sue posizioni." },
    { type: "heading",text: "Tabella di risoluzione dei problemi" },
    { type: "table", headers: ["Sintomo","Causa probabile","Correzione"], rows: [
      ["L'intera finestra è vuota subito dopo un aggiornamento di Windows","Rendering bloccato dopo il riavvio o la sostituzione del driver","Faccia clic nella finestra e prema F5 (o Fn+F5) per ricaricare"],
      ["L'aggiornamento lampeggia e torna vuoto","Processo dell'app bloccato","Chiudere completamente l'app e riavviarla, poi accedere di nuovo"],
      ["L'app si carica ma il layout è vuoto","Il workspace è stato reimpostato","Menu New (+) → clicchi il suo workspace salvato, oppure Reset Default Workspace"],
      ["Ancora vuota dopo aggiornamento e riavvio","Vecchia build su Windows aggiornato","Reinstallare l'ultima versione dalla pagina Tradovate Devices"],
      ["I crash a vuoto ritornano su un'installazione pulita","Problema del driver grafico o a livello di sistema","Aggiornare driver grafico e Windows; segnalare al supporto con le versioni"],
      ["È in un trade e lo schermo è vuoto","Guasto solo di visualizzazione su quella macchina","Gestire la posizione dalla piattaforma web o mobile; gli ordini restano attivi"],
    ] },
    { type: "heading",text: "Continui a operare anche quando l'app desktop non si visualizza" },
    { type: "paragraph",html: "Se una finestra vuota dopo un aggiornamento le ha mai fatto perdere un fill, la vera soluzione è smettere di dipendere dal fatto che un singolo schermo sia attivo. PickMyTrade collega i suoi alert TradingView direttamente a Tradovate ed esegue sui nostri server, quindi la sua strategia continua a scattare che l'app desktop stia disegnando un layout o meno:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Esecuzione lato server.</strong> Gli alert vengono instradati da TradingView a Tradovate attraverso la nostra infrastruttura, quindi una finestra desktop vuota non impedisce mai a un ingresso o a un'uscita di andare a buon fine.",
        "<strong class='text-white'>Indipendenza dal dispositivo.</strong> Nulla richiede che l'app desktop sia aperta. I suoi trade partono dall'alert, non dalla finestra che capita di essere aperta.",
        "<strong class='text-white'>Stop e target che tengono.</strong> SL e TP definiti nel suo alert vengono inseriti su Tradovate indipendentemente dalla macchina su cui si trova, quindi la sua protezione non dipende dal rendering dell'app.",
        "<strong class='text-white'>Sincronizzazione multi-account.</strong> Replichi gli stessi ordini su tutti gli account collegati contemporaneamente, così che nessun account resti non gestito mentre aggiorna o reinstalla un client.",
      ],
    },
  ] },
  ctaHeading: { en: "Keep Trading When the App Won't Load", de: "Weiterhandeln, wenn die App nicht lädt", es: "Siga operando cuando la app no carga", fr: "Continuez à trader quand l'app ne se charge pas", it: "Continui a operare quando l'app non si carica" },
  ctaText: { en: "Link your TradingView alerts to Tradovate with PickMyTrade and keep trading even when the desktop app won't load. Start your free trial.", de: "Verknüpfen Sie Ihre TradingView-Alerts mit Tradovate über PickMyTrade und handeln Sie weiter, auch wenn die Desktop-App nicht lädt. Starten Sie Ihre kostenlose Testphase.", es: "Vincule sus alertas de TradingView con Tradovate mediante PickMyTrade y siga operando incluso cuando la aplicación de escritorio no cargue. Comience su prueba gratuita.", fr: "Reliez vos alertes TradingView à Tradovate avec PickMyTrade et continuez à trader même lorsque l'application de bureau ne se charge pas. Commencez votre essai gratuit.", it: "Colleghi i suoi alert TradingView a Tradovate con PickMyTrade e continui a operare anche quando l'app desktop non si carica. Inizi la prova gratuita." },
  ctaButtonText: { en: "Start Your Free 7-Day Trial", de: "Starten Sie Ihre kostenlose 7-Tage-Testphase", es: "Comience su prueba gratuita de 7 días", fr: "Commencez votre essai gratuit de 7 jours", it: "Inizi la prova gratuita di 7 giorni" },
  ctaUrl: "https://app.pickmytrade.trade/?register=true&utm_source=content&utm_medium=debugging",
  faqHeading: { en: "Frequently Asked Questions", de: "Häufig gestellte Fragen", es: "Preguntas frecuentes", fr: "Questions fréquentes", it: "Domande frequenti" },
  faqs: { en: [
    { q: "Why does my Tradovate desktop app go blank after a Windows 11 update?", a: "A Windows update usually reboots the machine mid-session, swaps graphics drivers, or interrupts the app while it is running. The desktop app is the same web platform wrapped in its own window, and when the update disrupts it, the app can come back with a view that never finishes redrawing. That leaves you staring at a blank or white window instead of your charts and DOM. The rendered layer is stuck, not your account, which is why a simple reload usually clears it." },
    { q: "How do I refresh the Tradovate desktop app when it goes blank?", a: "Click once inside the app window so it has focus, then press F5. On many laptops the top row are media keys by default, so press Fn+F5 to send a real F5 keystroke. The app reloads its interface the same way a browser reload does, and your workspace repaints in a couple of seconds without a full restart." },
    { q: "Does pressing F5 cancel my orders or close my positions?", a: "No. F5 only reloads the on-screen interface. Your balance, working orders, stops, targets, and open positions live on Tradovate's servers, not inside the desktop window. When the app repaints, everything reappears exactly as it was, because the refresh re-fetches that state from the server rather than resetting it." },
    { q: "The app loaded but my layout is empty after the refresh. How do I get my charts back?", a: "That usually means your workspace was reset, not that anything was deleted. Open the New (+) menu in the top-left corner and look for your saved workspace in the list, then click it to reload your full layout. If you want to start from a clean slate, save your current setup first, then choose Reset Default Workspace from that same menu. Confirm the exact labels in your current build, since Tradovate adjusts menu wording over time." },
    { q: "F5 didn't fix the blank screen. What do I try next?", a: "Fully close the app and reopen it. If it is still blank, update or reinstall the desktop app from the Tradovate Devices page so you are running the current build against the updated Windows version. While you sort it out, log in to the web platform in any browser to keep an eye on your account. If the window keeps crashing to blank even after a clean reinstall, contact Tradovate support with your Windows version and app version." },
    { q: "Can I keep trading while the desktop app is blank?", a: "Yes. The blank window is a display problem on that one machine, not an account outage. Open the Tradovate web platform in a browser or the mobile app, sign in, and you will see the exact same account with full control to modify or flatten positions. Treat the desktop app as one window into your account, never the only one." },
    { q: "The desktop app keeps going blank even after a fresh install. What should I do?", a: "Repeated blank or white-screen crashes that survive a clean reinstall point to something on the machine, such as a graphics driver or a Windows rendering issue, rather than a bad app file. Update your graphics driver, take any pending Windows updates, and use the web version in the meantime. If it persists, report it to Tradovate support with your exact Windows build and app version so they can trace it, and keep managing risk from the web or mobile client." },
  ], de: [
    { q: "Warum wird meine Tradovate-Desktop-App nach einem Windows-11-Update leer?", a: "Ein Windows-Update startet den Rechner meist mitten in der Sitzung neu, tauscht Grafiktreiber aus oder unterbricht die App während ihrer Ausführung. Die Desktop-App ist dieselbe Web-Plattform in einem eigenen Fenster, und wenn das Update sie stört, kann die App mit einer Ansicht zurückkehren, die nie fertig neu gezeichnet wird. Dann starren Sie auf ein leeres oder weißes Fenster statt auf Ihre Charts und das DOM. Die Darstellungsebene hängt, nicht Ihr Konto, weshalb ein einfaches Neuladen es meist behebt." },
    { q: "Wie aktualisiere ich die Tradovate-Desktop-App, wenn sie leer wird?", a: "Klicken Sie einmal in das App-Fenster, damit es den Fokus hat, und drücken Sie dann F5. Bei vielen Laptops sind die oberen Tasten standardmäßig Medientasten, drücken Sie dann Fn+F5, um einen echten F5-Tastendruck zu senden. Die App lädt ihre Oberfläche wie ein Browser-Reload neu, und Ihr Workspace wird in wenigen Sekunden ohne vollständigen Neustart neu gezeichnet." },
    { q: "Storniert F5 meine Orders oder schließt meine Positionen?", a: "Nein. F5 lädt nur die Bildschirmoberfläche neu. Ihr Kontostand, aktive Orders, Stops, Ziele und offene Positionen liegen auf den Servern von Tradovate, nicht im Desktop-Fenster. Wenn die App neu zeichnet, erscheint alles genau so wie zuvor, weil die Aktualisierung diesen Zustand vom Server neu abruft, statt ihn zurückzusetzen." },
    { q: "Die App wurde geladen, aber mein Layout ist nach der Aktualisierung leer. Wie bekomme ich meine Charts zurück?", a: "Das bedeutet meist, dass Ihr Workspace zurückgesetzt wurde, nicht dass etwas gelöscht wurde. Öffnen Sie das Menü New (+) in der oberen linken Ecke und suchen Sie Ihren gespeicherten Workspace in der Liste, klicken Sie ihn dann an, um Ihr vollständiges Layout neu zu laden. Wenn Sie mit einer leeren Ausgangsbasis beginnen möchten, speichern Sie zuerst Ihre aktuelle Einrichtung und wählen Sie dann Reset Default Workspace im selben Menü. Prüfen Sie die genauen Bezeichnungen in Ihrer aktuellen Version, da Tradovate die Menüformulierungen im Lauf der Zeit anpasst." },
    { q: "F5 hat den leeren Bildschirm nicht behoben. Was versuche ich als Nächstes?", a: "Schließen Sie die App vollständig und öffnen Sie sie erneut. Ist sie weiterhin leer, aktualisieren oder installieren Sie die Desktop-App über die Seite Tradovate Devices neu, damit die aktuelle Version auf der aktualisierten Windows-Version läuft. Melden Sie sich währenddessen in einem beliebigen Browser an der Web-Plattform an, um Ihr Konto im Blick zu behalten. Stürzt das Fenster selbst nach einer sauberen Neuinstallation weiter auf leer ab, wenden Sie sich mit Ihrer Windows-Version und App-Version an den Tradovate-Support." },
    { q: "Kann ich weiterhandeln, während die Desktop-App leer ist?", a: "Ja. Das leere Fenster ist ein Anzeigeproblem auf diesem einen Rechner, kein Kontoausfall. Öffnen Sie die Tradovate-Web-Plattform in einem Browser oder die mobile App, melden Sie sich an, und Sie sehen genau dasselbe Konto mit voller Kontrolle, um Positionen zu ändern oder zu schließen. Betrachten Sie die Desktop-App als ein Fenster zu Ihrem Konto, nie als das einzige." },
    { q: "Die Desktop-App wird auch nach einer Neuinstallation immer wieder leer. Was soll ich tun?", a: "Wiederholte Abstürze mit leerem oder weißem Bildschirm, die eine saubere Neuinstallation überdauern, deuten auf etwas auf dem Rechner hin, etwa einen Grafiktreiber oder ein Windows-Rendering-Problem, nicht auf eine fehlerhafte App-Datei. Aktualisieren Sie Ihren Grafiktreiber, installieren Sie ausstehende Windows-Updates und nutzen Sie in der Zwischenzeit die Webversion. Besteht das Problem weiter, melden Sie es dem Tradovate-Support mit Ihrer genauen Windows-Build- und App-Version, damit er es nachverfolgen kann, und steuern Sie Ihr Risiko weiter über den Web- oder Mobil-Client." },
  ], es: [
    { q: "¿Por qué mi aplicación de escritorio de Tradovate se queda en blanco tras una actualización de Windows 11?", a: "Una actualización de Windows suele reiniciar el equipo a mitad de sesión, cambiar los controladores gráficos o interrumpir la aplicación mientras se ejecuta. La aplicación de escritorio es la misma plataforma web envuelta en su propia ventana y, cuando la actualización la altera, la app puede volver con una vista que nunca termina de redibujarse. Eso le deja mirando una ventana en blanco o blanca en lugar de sus gráficos y su DOM. La capa de renderizado está atascada, no su cuenta, por eso una simple recarga suele resolverlo." },
    { q: "¿Cómo actualizo la aplicación de escritorio de Tradovate cuando se queda en blanco?", a: "Haga clic una vez dentro de la ventana de la aplicación para que tenga el foco y luego pulse F5. En muchos portátiles la fila superior son teclas multimedia por defecto, así que pulse Fn+F5 para enviar una pulsación real de F5. La aplicación recarga su interfaz igual que una recarga del navegador, y su espacio de trabajo se vuelve a dibujar en un par de segundos sin reiniciar por completo." },
    { q: "¿Pulsar F5 cancela mis órdenes o cierra mis posiciones?", a: "No. F5 solo recarga la interfaz en pantalla. Su saldo, órdenes activas, stops, objetivos y posiciones abiertas residen en los servidores de Tradovate, no dentro de la ventana de escritorio. Cuando la app se vuelve a dibujar, todo reaparece exactamente como estaba, porque la actualización vuelve a obtener ese estado del servidor en lugar de reiniciarlo." },
    { q: "La aplicación cargó pero mi diseño está vacío tras actualizar. ¿Cómo recupero mis gráficos?", a: "Eso suele significar que su espacio de trabajo se restableció, no que se haya borrado nada. Abra el menú New (+) en la esquina superior izquierda y busque su espacio de trabajo guardado en la lista, luego haga clic en él para recargar su diseño completo. Si quiere empezar desde cero, guarde primero su configuración actual y después elija Reset Default Workspace en ese mismo menú. Confirme las etiquetas exactas en su versión actual, ya que Tradovate ajusta la redacción de los menús con el tiempo." },
    { q: "F5 no arregló la pantalla en blanco. ¿Qué pruebo a continuación?", a: "Cierre la aplicación por completo y vuelva a abrirla. Si sigue en blanco, actualice o reinstale la aplicación de escritorio desde la página Tradovate Devices para ejecutar la versión actual sobre la versión actualizada de Windows. Mientras lo resuelve, inicie sesión en la plataforma web desde cualquier navegador para vigilar su cuenta. Si la ventana sigue fallando en blanco incluso tras una reinstalación limpia, contacte con el soporte de Tradovate indicando su versión de Windows y de la aplicación." },
    { q: "¿Puedo seguir operando mientras la aplicación de escritorio está en blanco?", a: "Sí. La ventana en blanco es un problema de visualización de ese equipo, no una caída de la cuenta. Abra la plataforma web de Tradovate en un navegador o la app móvil, inicie sesión y verá exactamente la misma cuenta con control total para modificar o cerrar posiciones. Trate la aplicación de escritorio como una ventana a su cuenta, nunca como la única." },
    { q: "La aplicación de escritorio sigue quedándose en blanco incluso tras una instalación limpia. ¿Qué debo hacer?", a: "Los fallos repetidos de pantalla en blanco o blanca que sobreviven a una reinstalación limpia apuntan a algo del equipo, como un controlador gráfico o un problema de renderizado de Windows, y no a un archivo defectuoso de la app. Actualice su controlador gráfico, instale las actualizaciones pendientes de Windows y use la versión web mientras tanto. Si persiste, repórtelo al soporte de Tradovate con su compilación exacta de Windows y la versión de la app para que puedan rastrearlo, y siga gestionando el riesgo desde el cliente web o móvil." },
  ], fr: [
    { q: "Pourquoi mon application de bureau Tradovate devient-elle vide après une mise à jour de Windows 11 ?", a: "Une mise à jour de Windows redémarre généralement la machine en pleine session, remplace les pilotes graphiques ou interrompt l'application pendant son exécution. L'application de bureau est la même plateforme web enveloppée dans sa propre fenêtre et, lorsque la mise à jour la perturbe, l'app peut revenir avec une vue qui ne finit jamais de se redessiner. Vous vous retrouvez alors devant une fenêtre vide ou blanche au lieu de vos graphiques et de votre DOM. C'est la couche de rendu qui est bloquée, pas votre compte, ce qui explique pourquoi un simple rechargement règle généralement le problème." },
    { q: "Comment actualiser l'application de bureau Tradovate lorsqu'elle devient vide ?", a: "Cliquez une fois dans la fenêtre de l'application pour lui donner le focus, puis appuyez sur F5. Sur de nombreux portables, la rangée du haut correspond par défaut aux touches multimédias ; appuyez donc sur Fn+F5 pour envoyer une vraie frappe F5. L'application recharge son interface comme le ferait un rechargement de navigateur, et votre espace de travail se redessine en quelques secondes sans redémarrage complet." },
    { q: "Appuyer sur F5 annule-t-il mes ordres ou ferme-t-il mes positions ?", a: "Non. F5 ne recharge que l'interface à l'écran. Votre solde, vos ordres actifs, stops, objectifs et positions ouvertes se trouvent sur les serveurs de Tradovate, pas dans la fenêtre de bureau. Lorsque l'app se redessine, tout réapparaît exactement tel quel, car l'actualisation récupère de nouveau cet état depuis le serveur au lieu de le réinitialiser." },
    { q: "L'application s'est chargée mais ma disposition est vide après l'actualisation. Comment récupérer mes graphiques ?", a: "Cela signifie généralement que votre espace de travail a été réinitialisé, pas que quelque chose a été supprimé. Ouvrez le menu New (+) dans le coin supérieur gauche et repérez votre espace de travail enregistré dans la liste, puis cliquez dessus pour recharger toute votre disposition. Si vous voulez repartir d'une page blanche, enregistrez d'abord votre configuration actuelle, puis choisissez Reset Default Workspace dans ce même menu. Confirmez les libellés exacts dans votre version actuelle, car Tradovate ajuste la formulation des menus au fil du temps." },
    { q: "F5 n'a pas réglé l'écran vide. Que tenter ensuite ?", a: "Fermez complètement l'application et rouvrez-la. Si elle est toujours vide, mettez à jour ou réinstallez l'application de bureau depuis la page Tradovate Devices afin d'exécuter la version actuelle sur la version mise à jour de Windows. Pendant ce temps, connectez-vous à la plateforme web dans n'importe quel navigateur pour garder un œil sur votre compte. Si la fenêtre continue de planter à vide même après une réinstallation propre, contactez le support Tradovate en indiquant votre version de Windows et celle de l'application." },
    { q: "Puis-je continuer à trader pendant que l'application de bureau est vide ?", a: "Oui. La fenêtre vide est un problème d'affichage sur cette seule machine, pas une panne du compte. Ouvrez la plateforme web Tradovate dans un navigateur ou l'application mobile, connectez-vous, et vous verrez exactement le même compte avec un contrôle total pour modifier ou clôturer des positions. Considérez l'application de bureau comme une fenêtre sur votre compte, jamais comme la seule." },
    { q: "L'application de bureau redevient vide même après une installation neuve. Que faire ?", a: "Des plantages répétés à écran vide ou blanc qui survivent à une réinstallation propre pointent vers quelque chose sur la machine, comme un pilote graphique ou un problème de rendu de Windows, plutôt qu'un mauvais fichier de l'app. Mettez à jour votre pilote graphique, installez les mises à jour Windows en attente et utilisez la version web en attendant. Si le problème persiste, signalez-le au support Tradovate avec votre build Windows exact et la version de l'app afin qu'il puisse le retracer, et continuez à gérer le risque depuis le client web ou mobile." },
  ], it: [
    { q: "Perché la mia app desktop Tradovate diventa vuota dopo un aggiornamento di Windows 11?", a: "Un aggiornamento di Windows di solito riavvia la macchina a metà sessione, sostituisce i driver grafici o interrompe l'app mentre è in esecuzione. L'app desktop è la stessa piattaforma web racchiusa in una propria finestra e, quando l'aggiornamento la disturba, l'app può tornare con una vista che non finisce mai di ridisegnarsi. Si ritrova così davanti a una finestra vuota o bianca invece dei suoi grafici e del DOM. A essere bloccato è il livello di rendering, non il suo account, ed è per questo che un semplice ricaricamento di solito lo risolve." },
    { q: "Come aggiorno l'app desktop Tradovate quando diventa vuota?", a: "Faccia clic una volta all'interno della finestra dell'app in modo che abbia il focus, poi prema F5. Su molti portatili la riga superiore corrisponde per impostazione predefinita ai tasti multimediali, quindi prema Fn+F5 per inviare una vera pressione di F5. L'app ricarica la sua interfaccia come farebbe un ricaricamento del browser e il suo workspace viene ridisegnato in un paio di secondi senza riavvio completo." },
    { q: "Premere F5 annulla i miei ordini o chiude le mie posizioni?", a: "No. F5 ricarica solo l'interfaccia a schermo. Il suo saldo, gli ordini attivi, gli stop, i target e le posizioni aperte risiedono sui server di Tradovate, non all'interno della finestra desktop. Quando l'app si ridisegna, tutto ricompare esattamente com'era, perché l'aggiornamento recupera di nuovo quello stato dal server anziché reimpostarlo." },
    { q: "L'app si è caricata ma il mio layout è vuoto dopo l'aggiornamento. Come recupero i miei grafici?", a: "Di solito significa che il suo workspace è stato reimpostato, non che qualcosa sia stato eliminato. Apra il menu New (+) nell'angolo in alto a sinistra e cerchi il suo workspace salvato nell'elenco, poi lo clicchi per ricaricare l'intero layout. Se vuole ripartire da zero, salvi prima la sua configurazione attuale, poi scelga Reset Default Workspace dallo stesso menu. Confermi le etichette esatte nella sua versione attuale, poiché Tradovate modifica nel tempo la formulazione dei menu." },
    { q: "F5 non ha risolto la schermata vuota. Cosa provo dopo?", a: "Chiuda completamente l'app e la riapra. Se è ancora vuota, aggiorni o reinstalli l'app desktop dalla pagina Tradovate Devices in modo da eseguire la versione attuale sulla versione aggiornata di Windows. Nel frattempo acceda alla piattaforma web da qualsiasi browser per tenere d'occhio il suo account. Se la finestra continua ad andare in crash a vuoto anche dopo una reinstallazione pulita, contatti il supporto Tradovate indicando la sua versione di Windows e dell'app." },
    { q: "Posso continuare a operare mentre l'app desktop è vuota?", a: "Sì. La finestra vuota è un problema di visualizzazione su quella singola macchina, non un'interruzione dell'account. Apra la piattaforma web di Tradovate in un browser o l'app mobile, acceda e vedrà esattamente lo stesso account con pieno controllo per modificare o chiudere le posizioni. Consideri l'app desktop come una finestra sul suo account, mai l'unica." },
    { q: "L'app desktop continua a diventare vuota anche dopo un'installazione pulita. Cosa devo fare?", a: "Crash ripetuti con schermata vuota o bianca che sopravvivono a una reinstallazione pulita indicano qualcosa sulla macchina, come un driver grafico o un problema di rendering di Windows, anziché un file dell'app danneggiato. Aggiorni il driver grafico, installi gli aggiornamenti di Windows in sospeso e nel frattempo usi la versione web. Se persiste, lo segnali al supporto Tradovate con la sua build esatta di Windows e la versione dell'app così che possano risalire alla causa, e continui a gestire il rischio dal client web o mobile." },
  ] },
