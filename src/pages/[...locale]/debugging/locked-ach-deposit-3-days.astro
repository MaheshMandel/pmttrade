---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "locked-ach-deposit-3-days";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/debugging/${SLUG}`;

const META_TITLE = "Tradovate ACH Deposit Locked 3 Business Days";
const META_DESCRIPTION =
  "Tradovate ACH deposit locked? Funds clear in ~3 business days from 5PM Central. See why the NSF hold happens and how to fund faster next time.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Tradovate ACH-Einzahlung 3 Werktage gesperrt", es: "Depósito ACH de Tradovate bloqueado 3 días hábiles", fr: "Dépôt ACH Tradovate bloqué 3 jours ouvrés", it: "Deposito ACH Tradovate bloccato per 3 giorni lavorativi" },
  dek: { en: "The money already left your bank, but your Tradovate buying power still reads zero. Here's why the ACH hold exists, exactly when it clears, and how to skip it on your next deposit.", de: "Das Geld hat Ihre Bank bereits verlassen, aber Ihre Tradovate-Kaufkraft zeigt immer noch null. Hier erfahren Sie, warum die ACH-Sperre existiert, wann sie genau endet und wie Sie sie bei Ihrer nächsten Einzahlung umgehen.", es: "El dinero ya salió de su banco, pero su poder de compra en Tradovate sigue en cero. Le explicamos por qué existe la retención ACH, exactamente cuándo se libera y cómo evitarla en su próximo depósito.", fr: "L'argent a déjà quitté votre banque, mais votre pouvoir d'achat Tradovate affiche toujours zéro. Voici pourquoi le blocage ACH existe, quand exactement il se lève, et comment l'éviter lors de votre prochain dépôt.", it: "Il denaro ha già lasciato la Sua banca, ma il Suo potere d'acquisto su Tradovate segna ancora zero. Ecco perché esiste il blocco ACH, quando si risolve esattamente e come evitarlo al prossimo deposito." },
  readTime: { en: "7 min read", de: "7 Min. Lesezeit", es: "Lectura de 7 min", fr: "Lecture : 7 min", it: "Lettura di 7 min" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "Few things sting quite like funding your account, watching the money leave your bank, and still staring at zero buying power because your Tradovate ACH deposit is locked. Here's the short version for 2026: most locked ACH deposits clear on their own in roughly <strong class='text-white'>three business days</strong>, and the hold counts down from <strong class='text-white'>5:00 PM Central on the day the transfer is processed</strong>. It's not a bug, and it's not a penalty. It's a reversal-and-fraud safeguard that no account, not yours, not anyone's, can override. Below, you'll get exactly what &ldquo;locked&rdquo; means, why Tradovate applies it, and the fastest legitimate ways to get back to trading." },
    {
      type: "checklist",
      heading: "Quick Checklist for a Locked ACH Deposit",
      items: [
        "<strong class='text-white'>Confirm the status reads &ldquo;Locked,&rdquo; not &ldquo;Failed.&rdquo;</strong> A locked deposit will still clear. A failed one won't.",
        "<strong class='text-white'>Count three business days from 5:00 PM Central</strong> on the processing day, not three calendar days.",
        "<strong class='text-white'>Don't resubmit the same deposit.</strong> A duplicate request can double-debit your bank account.",
        "<strong class='text-white'>Don't open a ticket expecting a rush.</strong> Tradovate can't expedite a locked deposit for any account.",
        "<strong class='text-white'>Need funds now? Use a wire transfer or debit card</strong> instead of waiting out the ACH hold.",
        "<strong class='text-white'>Requested on a weekend or late in the day? Add a day.</strong> Processing rolls to the next business day.",
      ],
    },
    { type: "heading", text: "What \"Locked ACH Deposit\" Means" },
    { type: "paragraph", html: "Tradovate uses a third-party provider called <strong class='text-white'>Plaid</strong> to move money between your bank and your trading account over the ACH network. When Plaid can instantly verify that your bank balance covers the transfer, the deposit posts and your funds turn tradable quickly. When Plaid <strong class='text-white'>can't verify your bank balance at the moment of the deposit</strong>, Tradovate applies a hold and marks the deposit as locked." },
    { type: "paragraph", html: "While a deposit sits locked, the money is usually already <strong class='text-white'>debited from your bank account</strong>, but it won't show up as available balance or buying power in Tradovate until the hold clears. That gap is what blindsides most traders: the cash is gone from checking, yet you still can't place a trade." },
    { type: "paragraph", html: "The reason comes down to how ACH actually works. Unlike a wire, an ACH transfer does <strong class='text-white'>not settle in real time</strong>, and it can be <strong class='text-white'>clawed back by the originating bank</strong> if the account turned out to have insufficient funds, an NSF reversal. By holding funds it couldn't pre-verify, Tradovate keeps you from trading on money that might later get pulled back, which would otherwise leave you with a negative balance and force an unwind of your positions." },
    { type: "heading", text: "Top Causes of a Locked ACH Deposit in 2026" },
    { type: "heading", text: "1. Plaid couldn't verify your bank balance" },
    { type: "paragraph", html: "This is the single most common trigger. If the ACH provider can't confirm, right at the moment of the deposit, that your account holds enough to cover the amount, a balance check has to run before the funds can be released, and a three-business-day trading hold is applied in the meantime. There's no workaround for this step. The verification simply has to complete." },
    { type: "heading", text: "2. ACH is reversible, the NSF clawback risk" },
    { type: "paragraph", html: "Even when your deposit is completely legitimate, ACH transfers can be reversed for several days after they're initiated. Tradovate holds unverified deposits precisely so you can't trade funds that might get reversed for non-sufficient funds. Think of the lock as insurance against a negative-balance blowup, not a judgment on your account." },
    { type: "heading", text: "3. Deposit timing and weekend processing" },
    { type: "paragraph", html: "When you submit the request matters more than people expect. A deposit requested before the daily cutoff on a business day generally processes that same day. A request made on a weekend or after the cutoff gets processed on the <strong class='text-white'>next</strong> business day, and the three-day hold only starts counting from the processing day. So a Friday-evening or Sunday deposit can feel a lot slower than the exact same request placed Monday morning. Keep in mind that daily cutoff times can change and may vary by account and clearing firm, so check your account's current funding rules rather than assuming." },
    { type: "heading", text: "4. Amount, limits, and first-time transfers" },
    { type: "paragraph", html: "Larger or first-time ACH transfers are more likely to trip the balance-verification safeguard, and every account carries ACH deposit maximums. Those limits vary by account type and by your clearing firm (FCM), so confirm your current per-transfer and rolling limits before you assume the amount is the problem rather than a routine verification hold." },
    { type: "heading", text: "How to Fix (or Clear) a Locked ACH Deposit: Step-by-Step" },
    { type: "heading", text: "Step 1: Confirm it's locked, not failed" },
    { type: "paragraph", html: "Open your account's funding or transaction history and check the deposit's status. A <strong class='text-white'>locked</strong> or held deposit is still in progress and will clear once the hold ends. A <strong class='text-white'>failed</strong> or returned deposit won't, and it usually means you'll need to resubmit. Don't resubmit a deposit that's merely locked, you risk a second debit from your bank." },
    { type: "paragraph", html: "Tradovate's exact wording for this status can change over time, so read the label on your own screen and match it to &ldquo;locked/held&rdquo; versus &ldquo;failed/returned&rdquo; before you act." },
    { type: "heading", text: "Step 2: Wait out the three-business-day hold" },
    { type: "paragraph", html: "If the deposit is locked, the honest answer is that you wait. The hold begins at <strong class='text-white'>5:00 PM Central on the processing day</strong> and runs three business days. Here's a worked example:" },
    {
      type: "list",
      items: [
        "You request a deposit <strong class='text-white'>before the cutoff on Monday</strong> &rarr; it processes that same business day.",
        "The three-day hold <strong class='text-white'>starts Tuesday</strong> (the next business day).",
        "<strong class='text-white'>Thursday is Day 3</strong>, and the funds become available around <strong class='text-white'>5:00 PM Central</strong> that day.",
      ],
    },
    { type: "paragraph", html: "Weekends and holidays don't count, so a request that processes on a Thursday or Friday can push availability into the following week. Tradovate <strong class='text-white'>can't expedite the release</strong> of locked funds for any account, so a support ticket won't shorten this timeline." },
    { type: "heading", text: "Step 3: Fund faster next time with a wire or debit card" },
    { type: "paragraph", html: "To skip the ACH hold entirely on future deposits, use a funding method that doesn't lean on ACH balance verification. <strong class='text-white'>Wire transfers</strong> settle far faster because they don't carry the same reversal risk, and a <strong class='text-white'>debit card</strong> deposit is another quick alternative. Both sidestep the Plaid balance check that triggers the lock in the first place." },
    { type: "heading", text: "Troubleshooting Table" },
    {
      type: "table",
      headers: ["Status / message", "What it means", "Fix"],
      rows: [
        ["Deposit shows Locked / Held", "Plaid couldn't verify your bank balance; a 3-business-day trading hold is applied", "Wait it out, clears ~3 business days from 5:00 PM Central on the processing day"],
        ["Money left my bank but no buying power", "Funds are debited but held until the lock clears", "Normal for a locked deposit; do not resubmit"],
        ["Deposit shows Failed / Returned", "The transfer didn't go through (e.g., NSF, bank rejection)", "Fix the underlying bank issue, then resubmit or use another method"],
        ["&ldquo;Can you expedite my deposit?&rdquo;", "No account can be expedited", "Wait out the hold, or fund by wire/debit card next time"],
        ["Weekend or after-cutoff request feels slow", "Processing rolled to the next business day, delaying the hold's start", "Expected, deposit earlier on a business day"],
        ["Repeated ACH deposits get held", "Larger/first-time transfers and account limits raise the odds of a verification hold", "Verify current limits; consider wire funding for large amounts"],
      ],
    },
    { type: "heading", text: "Trade the Moment Funds Unlock with PickMyTrade" },
    { type: "paragraph", html: "Let's be clear: no third-party tool, PickMyTrade included, can unlock a bank-side ACH hold, and you should be skeptical of anything that claims otherwise. What automation <em>can</em> do is make sure a cleared deposit turns into trades without you babysitting the platform:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>TradingView-to-Tradovate automation</strong>, your strategy's alerts route to Tradovate the moment your account is funded and live.",
        "<strong class='text-white'>Set-and-forget execution</strong>, signals fire even if you stepped away right when the hold lifted.",
        "<strong class='text-white'>Quantity &amp; risk controls</strong>, keep automated orders inside your account's position and risk limits.",
        "<strong class='text-white'>Multi-account sync</strong>, mirror the same setup across every account once each one is funded and cleared.",
      ],
    },
  ], de: [
    { type: "paragraph",html: "Nur wenige Dinge ärgern so sehr, wie das Konto zu finanzieren, das Geld die Bank verlassen zu sehen und trotzdem null Kaufkraft anzuzeigen, weil Ihre Tradovate-ACH-Einzahlung gesperrt ist. Die Kurzfassung für 2026: Die meisten gesperrten ACH-Einzahlungen werden in etwa <strong class='text-white'>drei Werktagen</strong> von selbst freigegeben, und die Sperre zählt ab <strong class='text-white'>5:00 PM Central am Tag der Verarbeitung der Überweisung</strong>. Es ist kein Fehler und keine Strafe. Es ist eine Schutzmaßnahme gegen Rückbuchungen und Betrug, die kein Konto aufheben kann, weder Ihres noch das eines anderen. Unten erfahren Sie genau, was &ldquo;gesperrt&rdquo; bedeutet, warum Tradovate sie anwendet und wie Sie am schnellsten auf legitimem Weg wieder handeln können." },
    {
      type: "checklist",
      heading: "Kurze Checkliste bei einer gesperrten ACH-Einzahlung",
      items: [
        "<strong class='text-white'>Prüfen Sie, dass der Status &ldquo;Locked&rdquo; lautet, nicht &ldquo;Failed&rdquo;.</strong> Eine gesperrte Einzahlung wird noch verrechnet. Eine fehlgeschlagene nicht.",
        "<strong class='text-white'>Zählen Sie drei Werktage ab 5:00 PM Central</strong> am Verarbeitungstag, nicht drei Kalendertage.",
        "<strong class='text-white'>Reichen Sie dieselbe Einzahlung nicht erneut ein.</strong> Eine doppelte Anforderung kann Ihr Bankkonto doppelt belasten.",
        "<strong class='text-white'>Eröffnen Sie kein Ticket in der Erwartung einer Beschleunigung.</strong> Tradovate kann eine gesperrte Einzahlung für kein Konto beschleunigen.",
        "<strong class='text-white'>Brauchen Sie die Gelder jetzt? Nutzen Sie eine Überweisung (Wire) oder Debitkarte</strong>, statt die ACH-Sperre abzuwarten.",
        "<strong class='text-white'>Am Wochenende oder spät am Tag beauftragt? Rechnen Sie einen Tag dazu.</strong> Die Verarbeitung rutscht auf den nächsten Werktag.",
      ],
    },
    { type: "heading",text: "Was „gesperrte ACH-Einzahlung“ bedeutet" },
    { type: "paragraph",html: "Tradovate nutzt einen Drittanbieter namens <strong class='text-white'>Plaid</strong>, um Geld über das ACH-Netzwerk zwischen Ihrer Bank und Ihrem Handelskonto zu bewegen. Kann Plaid sofort verifizieren, dass Ihr Kontostand die Überweisung deckt, wird die Einzahlung gebucht und Ihre Gelder werden schnell handelbar. Kann Plaid <strong class='text-white'>Ihren Kontostand im Moment der Einzahlung nicht verifizieren</strong>, wendet Tradovate eine Sperre an und markiert die Einzahlung als gesperrt." },
    { type: "paragraph",html: "Solange eine Einzahlung gesperrt ist, wurde das Geld in der Regel bereits <strong class='text-white'>von Ihrem Bankkonto abgebucht</strong>, erscheint aber erst als verfügbares Guthaben oder Kaufkraft in Tradovate, wenn die Sperre endet. Diese Lücke überrascht die meisten Trader: Das Geld ist vom Girokonto weg, und doch können Sie keinen Trade platzieren." },
    { type: "paragraph",html: "Der Grund liegt in der Funktionsweise von ACH. Anders als ein Wire wird eine ACH-Überweisung <strong class='text-white'>nicht in Echtzeit verbucht</strong> und kann <strong class='text-white'>von der auslösenden Bank zurückgeholt werden</strong>, wenn sich herausstellt, dass das Konto nicht gedeckt war, ein NSF-Reversal. Indem Tradovate Gelder zurückhält, die es nicht vorab verifizieren konnte, verhindert es, dass Sie mit Geld handeln, das später zurückgebucht werden könnte, was Ihnen sonst einen negativen Saldo bescheren und die Auflösung Ihrer Positionen erzwingen würde." },
    { type: "heading",text: "Häufigste Ursachen einer gesperrten ACH-Einzahlung im Jahr 2026" },
    { type: "heading",text: "1. Plaid konnte Ihren Kontostand nicht verifizieren" },
    { type: "paragraph",html: "Das ist der mit Abstand häufigste Auslöser. Kann der ACH-Anbieter im Moment der Einzahlung nicht bestätigen, dass Ihr Konto genug zur Deckung des Betrags enthält, muss eine Kontostandsprüfung laufen, bevor die Gelder freigegeben werden können, und währenddessen gilt eine Handelssperre von drei Werktagen. Für diesen Schritt gibt es keine Umgehung. Die Verifizierung muss einfach abgeschlossen werden." },
    { type: "heading",text: "2. ACH ist umkehrbar, das NSF-Rückbuchungsrisiko" },
    { type: "paragraph",html: "Selbst wenn Ihre Einzahlung völlig legitim ist, können ACH-Überweisungen noch mehrere Tage nach ihrer Auslösung rückgängig gemacht werden. Tradovate hält unverifizierte Einzahlungen genau deshalb zurück, damit Sie nicht mit Geldern handeln, die wegen mangelnder Deckung zurückgebucht werden könnten. Sehen Sie die Sperre als Versicherung gegen einen Negativsaldo-Crash, nicht als Urteil über Ihr Konto." },
    { type: "heading",text: "3. Zeitpunkt der Einzahlung und Wochenendverarbeitung" },
    { type: "paragraph",html: "Der Zeitpunkt Ihrer Anforderung spielt eine größere Rolle, als viele denken. Eine Einzahlung, die vor dem täglichen Cutoff an einem Werktag angefordert wird, wird in der Regel am selben Tag verarbeitet. Eine Anforderung am Wochenende oder nach dem Cutoff wird am <strong class='text-white'>nächsten</strong> Werktag verarbeitet, und die dreitägige Sperre zählt erst ab dem Verarbeitungstag. Eine Einzahlung am Freitagabend oder Sonntag kann sich daher deutlich langsamer anfühlen als dieselbe Anforderung am Montagmorgen. Beachten Sie, dass sich tägliche Cutoff-Zeiten ändern können und je nach Konto und Clearing-Firma variieren, prüfen Sie also die aktuellen Einzahlungsregeln Ihres Kontos, statt Annahmen zu treffen." },
    { type: "heading",text: "4. Betrag, Limits und Erstüberweisungen" },
    { type: "paragraph",html: "Größere oder erstmalige ACH-Überweisungen lösen die Kontostandsprüfung mit höherer Wahrscheinlichkeit aus, und jedes Konto hat ACH-Einzahlungsobergrenzen. Diese Limits variieren je nach Kontotyp und Ihrer Clearing-Firma (FCM). Prüfen Sie daher Ihre aktuellen Limits pro Überweisung und im Zeitverlauf, bevor Sie annehmen, dass der Betrag das Problem ist und nicht eine routinemäßige Verifizierungssperre." },
    { type: "heading",text: "So beheben (oder lösen) Sie eine gesperrte ACH-Einzahlung: Schritt für Schritt" },
    { type: "heading",text: "Schritt 1: Bestätigen Sie, dass sie gesperrt ist, nicht fehlgeschlagen" },
    { type: "paragraph",html: "Öffnen Sie den Einzahlungs- oder Transaktionsverlauf Ihres Kontos und prüfen Sie den Status der Einzahlung. Eine <strong class='text-white'>gesperrte</strong> oder zurückgehaltene Einzahlung ist noch in Bearbeitung und wird nach Ablauf der Sperre freigegeben. Eine <strong class='text-white'>fehlgeschlagene</strong> oder zurückgegebene Einzahlung nicht, und in der Regel müssen Sie sie erneut einreichen. Reichen Sie eine lediglich gesperrte Einzahlung nicht erneut ein, Sie riskieren eine zweite Abbuchung von Ihrer Bank." },
    { type: "paragraph",html: "Die genaue Bezeichnung dieses Status bei Tradovate kann sich mit der Zeit ändern. Lesen Sie daher die Beschriftung auf Ihrem Bildschirm und ordnen Sie sie &ldquo;locked/held&rdquo; oder &ldquo;failed/returned&rdquo; zu, bevor Sie handeln." },
    { type: "heading",text: "Schritt 2: Die dreitägige Sperre abwarten" },
    { type: "paragraph",html: "Ist die Einzahlung gesperrt, lautet die ehrliche Antwort: warten. Die Sperre beginnt am <strong class='text-white'>Verarbeitungstag um 5:00 PM Central</strong> und dauert drei Werktage. Ein durchgerechnetes Beispiel:" },
    {
      type: "list",
      items: [
        "Sie fordern eine Einzahlung <strong class='text-white'>vor dem Cutoff am Montag</strong> an &rarr; sie wird am selben Werktag verarbeitet.",
        "Die dreitägige Sperre <strong class='text-white'>beginnt am Dienstag</strong> (dem nächsten Werktag).",
        "<strong class='text-white'>Donnerstag ist Tag 3</strong>, und die Gelder stehen an diesem Tag gegen <strong class='text-white'>5:00 PM Central</strong> zur Verfügung.",
      ],
    },
    { type: "paragraph",html: "Wochenenden und Feiertage zählen nicht, sodass eine Anforderung, die an einem Donnerstag oder Freitag verarbeitet wird, die Verfügbarkeit in die folgende Woche verschieben kann. Tradovate <strong class='text-white'>kann die Freigabe gesperrter Gelder für kein Konto beschleunigen</strong>, ein Support-Ticket verkürzt diesen Zeitplan also nicht." },
    { type: "heading",text: "Schritt 3: Beim nächsten Mal schneller per Wire oder Debitkarte finanzieren" },
    { type: "paragraph",html: "Um die ACH-Sperre bei künftigen Einzahlungen ganz zu umgehen, nutzen Sie eine Finanzierungsmethode, die nicht auf die ACH-Kontostandsprüfung angewiesen ist. <strong class='text-white'>Wire-Überweisungen</strong> werden deutlich schneller verbucht, weil sie nicht dasselbe Rückbuchungsrisiko tragen, und eine <strong class='text-white'>Debitkarten</strong>-Einzahlung ist eine weitere schnelle Alternative. Beide umgehen die Plaid-Kontostandsprüfung, die die Sperre überhaupt erst auslöst." },
    { type: "heading",text: "Tabelle zur Fehlersuche" },
    { type: "table", headers: ["Status / Meldung","Was es bedeutet","Lösung"], rows: [
      ["Einzahlung zeigt Locked / Held","Plaid konnte Ihren Kontostand nicht verifizieren; eine 3-Werktage-Handelssperre gilt","Abwarten, endet ca. 3 Werktage ab 5:00 PM Central am Verarbeitungstag"],
      ["Geld hat meine Bank verlassen, aber keine Kaufkraft","Gelder sind abgebucht, werden aber bis zum Ende der Sperre zurückgehalten","Normal bei gesperrter Einzahlung; nicht erneut einreichen"],
      ["Einzahlung zeigt Failed / Returned","Die Überweisung ging nicht durch (z. B. NSF, Ablehnung durch die Bank)","Das zugrunde liegende Bankproblem beheben, dann erneut einreichen oder eine andere Methode nutzen"],
      ["&ldquo;Können Sie meine Einzahlung beschleunigen?&rdquo;","Kein Konto kann beschleunigt werden","Sperre abwarten oder beim nächsten Mal per Wire/Debitkarte finanzieren"],
      ["Anforderung am Wochenende oder nach dem Cutoff wirkt langsam","Die Verarbeitung rutschte auf den nächsten Werktag und verzögert den Beginn der Sperre","Erwartetes Verhalten, zahlen Sie früher an einem Werktag ein"],
      ["Wiederholte ACH-Einzahlungen werden zurückgehalten","Größere/erstmalige Überweisungen und Kontolimits erhöhen die Wahrscheinlichkeit einer Verifizierungssperre","Aktuelle Limits prüfen; für große Beträge Wire-Finanzierung erwägen"],
    ] },
    { type: "heading",text: "Handeln Sie mit PickMyTrade, sobald die Gelder freigegeben sind" },
    { type: "paragraph",html: "Eines vorweg: Kein Drittanbieter-Tool, auch PickMyTrade nicht, kann eine bankseitige ACH-Sperre aufheben, und Sie sollten allem gegenüber skeptisch sein, was das Gegenteil behauptet. Was Automatisierung <em>kann</em>, ist sicherzustellen, dass aus einer freigegebenen Einzahlung Trades werden, ohne dass Sie die Plattform beaufsichtigen müssen:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>TradingView-zu-Tradovate-Automatisierung</strong>, die Alarme Ihrer Strategie werden an Tradovate weitergeleitet, sobald Ihr Konto finanziert und aktiv ist.",
        "<strong class='text-white'>Einrichten und vergessen</strong>, Signale lösen aus, selbst wenn Sie gerade in dem Moment weg waren, in dem die Sperre endete.",
        "<strong class='text-white'>Mengen- &amp; Risikokontrollen</strong>, halten automatisierte Orders innerhalb der Positions- und Risikolimits Ihres Kontos.",
        "<strong class='text-white'>Multi-Konto-Synchronisierung</strong>, spiegeln Sie dasselbe Setup auf alle Konten, sobald jedes finanziert und freigegeben ist.",
      ],
    },
  ], es: [
    { type: "paragraph",html: "Pocas cosas duelen tanto como financiar su cuenta, ver cómo el dinero sale de su banco y seguir viendo cero poder de compra porque su depósito ACH de Tradovate está bloqueado. Esta es la versión corta para 2026: la mayoría de los depósitos ACH bloqueados se liberan solos en unos <strong class='text-white'>tres días hábiles</strong>, y la retención se cuenta desde las <strong class='text-white'>5:00 PM hora central del día en que se procesa la transferencia</strong>. No es un fallo ni una sanción. Es una salvaguarda contra reversiones y fraude que ninguna cuenta, ni la suya ni la de nadie, puede anular. A continuación verá exactamente qué significa &ldquo;bloqueado&rdquo;, por qué Tradovate lo aplica y las formas legítimas más rápidas de volver a operar." },
    {
      type: "checklist",
      heading: "Lista rápida para un depósito ACH bloqueado",
      items: [
        "<strong class='text-white'>Confirme que el estado dice &ldquo;Locked&rdquo;, no &ldquo;Failed&rdquo;.</strong> Un depósito bloqueado aún se liquidará. Uno fallido no.",
        "<strong class='text-white'>Cuente tres días hábiles desde las 5:00 PM hora central</strong> del día de procesamiento, no tres días naturales.",
        "<strong class='text-white'>No vuelva a enviar el mismo depósito.</strong> Una solicitud duplicada puede cargar dos veces su cuenta bancaria.",
        "<strong class='text-white'>No abra un ticket esperando una aceleración.</strong> Tradovate no puede agilizar un depósito bloqueado en ninguna cuenta.",
        "<strong class='text-white'>¿Necesita los fondos ya? Use una transferencia bancaria (wire) o una tarjeta de débito</strong> en lugar de esperar la retención ACH.",
        "<strong class='text-white'>¿Lo solicitó en fin de semana o tarde en el día? Añada un día.</strong> El procesamiento pasa al siguiente día hábil.",
      ],
    },
    { type: "heading",text: "Qué significa «depósito ACH bloqueado»" },
    { type: "paragraph",html: "Tradovate utiliza un proveedor externo llamado <strong class='text-white'>Plaid</strong> para mover dinero entre su banco y su cuenta de trading a través de la red ACH. Cuando Plaid puede verificar al instante que el saldo de su banco cubre la transferencia, el depósito se contabiliza y sus fondos pasan a ser operables con rapidez. Cuando Plaid <strong class='text-white'>no puede verificar el saldo de su banco en el momento del depósito</strong>, Tradovate aplica una retención y marca el depósito como bloqueado." },
    { type: "paragraph",html: "Mientras un depósito permanece bloqueado, el dinero suele estar ya <strong class='text-white'>debitado de su cuenta bancaria</strong>, pero no aparecerá como saldo disponible ni poder de compra en Tradovate hasta que termine la retención. Esa brecha es la que desconcierta a la mayoría de los traders: el efectivo ya no está en la cuenta corriente y, aun así, no puede colocar una operación." },
    { type: "paragraph",html: "La razón radica en cómo funciona realmente el ACH. A diferencia de una wire, una transferencia ACH <strong class='text-white'>no se liquida en tiempo real</strong> y el <strong class='text-white'>banco originador puede reclamarla</strong> si resulta que la cuenta no tenía fondos suficientes, una reversión por NSF. Al retener fondos que no pudo verificar de antemano, Tradovate evita que usted opere con dinero que más tarde podría ser retirado, lo que de otro modo le dejaría un saldo negativo y forzaría la liquidación de sus posiciones." },
    { type: "heading",text: "Principales causas de un depósito ACH bloqueado en 2026" },
    { type: "heading",text: "1. Plaid no pudo verificar el saldo de su banco" },
    { type: "paragraph",html: "Esta es la causa más común con diferencia. Si el proveedor de ACH no puede confirmar, justo en el momento del depósito, que su cuenta tiene fondos suficientes para cubrir el importe, debe ejecutarse una comprobación de saldo antes de poder liberar los fondos, y mientras tanto se aplica una retención de operativa de tres días hábiles. No hay ningún atajo para este paso. La verificación simplemente tiene que completarse." },
    { type: "heading",text: "2. El ACH es reversible, el riesgo de reclamación por NSF" },
    { type: "paragraph",html: "Incluso cuando su depósito es completamente legítimo, las transferencias ACH pueden revertirse durante varios días después de iniciarse. Tradovate retiene los depósitos no verificados precisamente para que usted no opere con fondos que podrían revertirse por fondos insuficientes. Piense en el bloqueo como un seguro contra un saldo negativo, no como un juicio sobre su cuenta." },
    { type: "heading",text: "3. El momento del depósito y el procesamiento en fin de semana" },
    { type: "paragraph",html: "El momento en que envía la solicitud importa más de lo que la gente espera. Un depósito solicitado antes de la hora de corte diaria de un día hábil generalmente se procesa ese mismo día. Una solicitud hecha en fin de semana o después de la hora de corte se procesa el <strong class='text-white'>siguiente</strong> día hábil, y la retención de tres días solo empieza a contar desde el día de procesamiento. Así, un depósito el viernes por la tarde o el domingo puede parecer mucho más lento que la misma solicitud hecha el lunes por la mañana. Tenga en cuenta que las horas de corte diarias pueden cambiar y variar según la cuenta y la firma de compensación, así que consulte las reglas de financiación vigentes de su cuenta en lugar de suponerlas." },
    { type: "heading",text: "4. Importe, límites y primeras transferencias" },
    { type: "paragraph",html: "Las transferencias ACH más grandes o las primeras que realiza tienen más probabilidades de activar la salvaguarda de verificación de saldo, y toda cuenta tiene máximos de depósito ACH. Esos límites varían según el tipo de cuenta y su firma de compensación (FCM), así que confirme sus límites vigentes por transferencia y acumulados antes de suponer que el importe es el problema y no una retención de verificación rutinaria." },
    { type: "heading",text: "Cómo solucionar (o liberar) un depósito ACH bloqueado: paso a paso" },
    { type: "heading",text: "Paso 1: Confirme que está bloqueado, no fallido" },
    { type: "paragraph",html: "Abra el historial de financiación o de transacciones de su cuenta y compruebe el estado del depósito. Un depósito <strong class='text-white'>bloqueado</strong> o retenido sigue en curso y se liberará cuando termine la retención. Un depósito <strong class='text-white'>fallido</strong> o devuelto no, y normalmente significa que tendrá que reenviarlo. No reenvíe un depósito que solo está bloqueado, corre el riesgo de que su banco le haga un segundo débito." },
    { type: "paragraph",html: "El texto exacto de Tradovate para este estado puede cambiar con el tiempo, así que lea la etiqueta en su propia pantalla y relaciónela con &ldquo;locked/held&rdquo; frente a &ldquo;failed/returned&rdquo; antes de actuar." },
    { type: "heading",text: "Paso 2: Espere a que pase la retención de tres días hábiles" },
    { type: "paragraph",html: "Si el depósito está bloqueado, la respuesta honesta es que hay que esperar. La retención comienza a las <strong class='text-white'>5:00 PM hora central del día de procesamiento</strong> y dura tres días hábiles. Un ejemplo práctico:" },
    {
      type: "list",
      items: [
        "Solicita un depósito <strong class='text-white'>antes de la hora de corte del lunes</strong> &rarr; se procesa ese mismo día hábil.",
        "La retención de tres días <strong class='text-white'>comienza el martes</strong> (el siguiente día hábil).",
        "<strong class='text-white'>El jueves es el día 3</strong>, y los fondos quedan disponibles hacia las <strong class='text-white'>5:00 PM hora central</strong> de ese día.",
      ],
    },
    { type: "paragraph",html: "Los fines de semana y los festivos no cuentan, así que una solicitud que se procese un jueves o un viernes puede trasladar la disponibilidad a la semana siguiente. Tradovate <strong class='text-white'>no puede acelerar la liberación</strong> de fondos bloqueados en ninguna cuenta, así que un ticket de soporte no acortará este plazo." },
    { type: "heading",text: "Paso 3: Financie más rápido la próxima vez con una wire o una tarjeta de débito" },
    { type: "paragraph",html: "Para evitar por completo la retención ACH en futuros depósitos, use un método de financiación que no dependa de la verificación de saldo del ACH. Las <strong class='text-white'>transferencias bancarias (wire)</strong> se liquidan mucho más rápido porque no tienen el mismo riesgo de reversión, y un depósito con <strong class='text-white'>tarjeta de débito</strong> es otra alternativa rápida. Ambos evitan la comprobación de saldo de Plaid que activa el bloqueo en primer lugar." },
