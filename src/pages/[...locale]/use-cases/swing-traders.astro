---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getLocalePaths, useTranslations, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };
const t = useTranslations(locale);

const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": `${SITE_URL}${withSlash(localizedPath(locale))}` },
    { "@type": "ListItem", "position": 2, "name": "Swing Traders", "item": `${SITE_URL}${withSlash(localizedPath(locale, "use-cases/swing-traders"))}` },
  ],
};
---

<BaseLayout
  locale={locale}
  title={t("use_cases.swing_meta_title")}
  description={t("use_cases.swing_meta_description")}
  ldJson={[breadcrumbSchema]}
>
  <style>
    .electrolize-regular { font-family: 'Electrolize', sans-serif; font-weight: 400; }
    .gradient-text { background: linear-gradient(135deg, #2B77EE, #0F3EC3); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; }
  </style>

  <div class="bg-[#001429]">
    <!-- Hero -->
    <section class="py-16 lg:py-24 border-b border-blue-900/30 bg-gradient-to-b from-[#001429] to-[#002040]">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <span class="electrolize-regular inline-block px-4 py-2 bg-blue-600/20 text-blue-400 rounded-full text-sm font-semibold mb-4 border border-blue-500/30 uppercase">{t("use_cases.swing_hero_badge")}</span>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold text-white mb-6 tracking-tight">{t("use_cases.swing_hero_h1_pre")}<br><span class="gradient-text">{t("use_cases.swing_hero_h1_gradient")}</span></h1>
        <p class="text-xl md:text-2xl text-gray-300 max-w-3xl mx-auto mb-8">{t("use_cases.swing_hero_subtitle")}</p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center mb-8">
          <a href="https://app.pickmytrade.trade/?register=true" class="electrolize-regular inline-flex items-center justify-center gap-2 px-8 py-4 bg-gradient-to-r from-blue-600 to-blue-700 hover:from-blue-700 hover:to-blue-800 text-white rounded-xl font-bold transition-all transform hover:scale-105 shadow-xl"><i class="fas fa-rocket"></i> {t("use_cases.swing_hero_cta_primary")}</a>
          <a href="https://docs.pickmytrade.trade/docs/" class="electrolize-regular inline-flex items-center justify-center gap-2 px-8 py-4 bg-white/10 hover:bg-white/20 text-white rounded-xl font-bold border border-white/20"><i class="fas fa-book"></i> {t("use_cases.swing_hero_cta_secondary")}</a>
        </div>
        <div class="flex flex-wrap justify-center gap-3 text-sm">
          <div class="flex items-center gap-2 bg-white/5 border border-white/10 rounded-full px-4 py-2"><i class="fa-solid fa-clock text-purple-400"></i><span>{t("use_cases.swing_hero_pill_1")}</span></div>
          <div class="flex items-center gap-2 bg-white/5 border border-white/10 rounded-full px-4 py-2"><i class="fa-solid fa-shield-alt text-green-400"></i><span>{t("use_cases.swing_hero_pill_2")}</span></div>
          <div class="flex items-center gap-2 bg-white/5 border border-white/10 rounded-full px-4 py-2"><i class="fa-solid fa-bell text-blue-400"></i><span>{t("use_cases.swing_hero_pill_3")}</span></div>
        </div>
      </div>
    </section>

    <!-- Challenges Section -->
    <section class="py-16 md:py-24 border-b border-blue-900/30 bg-gradient-to-b from-[#002040] to-[#001429]">
      <div class="max-w-7xl mx-auto px-4">
        <div class="text-center mb-12">
          <span class="inline-block px-4 py-2 bg-yellow-600/20 text-yellow-400 rounded-full text-sm font-semibold mb-4 border border-yellow-500/30">{t("use_cases.swing_challenges_badge")}</span>
          <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">{t("use_cases.swing_challenges_h2")}</h2>
          <p class="text-gray-300 text-lg max-w-3xl mx-auto">{t("use_cases.swing_challenges_subtitle")}</p>
        </div>
        <div class="grid md:grid-cols-2 gap-8">
          <div class="bg-gradient-to-br from-gray-800/50 to-gray-900/50 rounded-xl p-6 border border-gray-700/50">
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 bg-red-500/20 rounded-lg flex items-center justify-center flex-shrink-0">
                <i class="fa-solid fa-clock text-red-400 text-xl"></i>
              </div>
              <div>
                <h3 class="text-xl font-bold text-white mb-2">{t("use_cases.swing_challenge_1_title")}</h3>
                <p class="text-gray-400">{t("use_cases.swing_challenge_1_text")}</p>
              </div>
            </div>
          </div>

          <div class="bg-gradient-to-br from-gray-800/50 to-gray-900/50 rounded-xl p-6 border border-gray-700/50">
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 bg-red-500/20 rounded-lg flex items-center justify-center flex-shrink-0">
                <i class="fa-solid fa-chart-line text-red-400 text-xl"></i>
              </div>
              <div>
                <h3 class="text-xl font-bold text-white mb-2">{t("use_cases.swing_challenge_2_title")}</h3>
                <p class="text-gray-400">{t("use_cases.swing_challenge_2_text")}</p>
              </div>
            </div>
          </div>

          <div class="bg-gradient-to-br from-gray-800/50 to-gray-900/50 rounded-xl p-6 border border-gray-700/50">
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 bg-red-500/20 rounded-lg flex items-center justify-center flex-shrink-0">
                <i class="fa-solid fa-mobile-screen text-red-400 text-xl"></i>
              </div>
              <div>
                <h3 class="text-xl font-bold text-white mb-2">{t("use_cases.swing_challenge_3_title")}</h3>
                <p class="text-gray-400">{t("use_cases.swing_challenge_3_text")}</p>
              </div>
            </div>
          </div>

          <div class="bg-gradient-to-br from-gray-800/50 to-gray-900/50 rounded-xl p-6 border border-gray-700/50">
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 bg-red-500/20 rounded-lg flex items-center justify-center flex-shrink-0">
                <i class="fa-solid fa-triangle-exclamation text-red-400 text-xl"></i>
              </div>
              <div>
                <h3 class="text-xl font-bold text-white mb-2">{t("use_cases.swing_challenge_4_title")}</h3>
                <p class="text-gray-400">{t("use_cases.swing_challenge_4_text")}</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- How PickMyTrade Helps -->
    <section class="py-16 md:py-24 border-b border-blue-900/30 bg-gradient-to-b from-[#001429] to-[#002040]">
      <div class="max-w-7xl mx-auto px-4">
        <div class="text-center mb-12">
          <span class="inline-block px-4 py-2 bg-green-600/20 text-green-400 rounded-full text-sm font-semibold mb-4 border border-green-500/30">{t("use_cases.swing_solution_badge")}</span>
          <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">{t("use_cases.swing_solution_h2_pre")} <span class="gradient-text">{t("use_cases.swing_solution_h2_gradient")}</span></h2>
          <p class="text-gray-300 text-lg max-w-3xl mx-auto">{t("use_cases.swing_solution_subtitle")}</p>
        </div>

        <div class="grid md:grid-cols-3 gap-8">
          <div class="bg-gradient-to-br from-[#002040] to-[#001429] border border-blue-500/30 rounded-xl p-6 text-center">
            <div class="w-12 h-12 bg-blue-500/20 rounded-lg flex items-center justify-center mx-auto mb-4">
              <i class="fa-solid fa-check-circle text-blue-400 text-xl"></i>
            </div>
            <h3 class="text-xl font-bold mb-2 text-white">{t("use_cases.swing_solution_1_title")}</h3>
            <p class="text-gray-400">{t("use_cases.swing_solution_1_text")}</p>
          </div>

          <div class="bg-gradient-to-br from-[#002040] to-[#001429] border border-[#2B77EE]/30 rounded-xl p-6 text-center">
            <div class="w-12 h-12 bg-[#2B77EE]/20 rounded-lg flex items-center justify-center mx-auto mb-4">
              <i class="fa-solid fa-arrows-up-down text-[#2B77EE] text-xl"></i>
            </div>
            <h3 class="text-xl font-bold mb-2 text-white">{t("use_cases.swing_solution_2_title")}</h3>
            <p class="text-gray-400">{t("use_cases.swing_solution_2_text")}</p>
          </div>

          <div class="bg-gradient-to-br from-[#002040] to-[#001429] border border-green-500/30 rounded-xl p-6 text-center">
            <div class="w-12 h-12 bg-green-500/20 rounded-lg flex items-center justify-center mx-auto mb-4">
              <i class="fa-solid fa-bell text-green-400 text-xl"></i>
            </div>
            <h3 class="text-xl font-bold mb-2 text-white">{t("use_cases.swing_solution_3_title")}</h3>
            <p class="text-gray-400">{t("use_cases.swing_solution_3_text")}</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Key Features -->
    <section class="py-16 md:py-24 border-b border-blue-900/30 bg-gradient-to-b from-[#002040] to-[#001429]">
      <div class="max-w-7xl mx-auto px-4">
        <h2 class="text-3xl md:text-4xl font-bold text-center mb-12">{t("use_cases.swing_features_h2_pre")} <span class="gradient-text">{t("use_cases.swing_features_h2_gradient")}</span></h2>

        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
          <div class="bg-gradient-to-br from-gray-800/50 to-gray-900/50 border border-white/10 rounded-xl p-6 hover:border-blue-500/50 transition-all">
            <i class="fa-solid fa-chart-line text-blue-400 text-3xl mb-4"></i>
            <h3 class="text-lg font-bold mb-2 text-white">{t("use_cases.swing_feature_1_title")}</h3>
            <p class="text-gray-400 text-sm">{t("use_cases.swing_feature_1_text")}</p>
          </div>

          <div class="bg-gradient-to-br from-gray-800/50 to-gray-900/50 border border-white/10 rounded-xl p-6 hover:border-blue-500/50 transition-all">
            <i class="fa-solid fa-arrows-up-down text-[#2B77EE] text-3xl mb-4"></i>
            <h3 class="text-lg font-bold mb-2 text-white">{t("use_cases.swing_feature_2_title")}</h3>
            <p class="text-gray-400 text-sm">{t("use_cases.swing_feature_2_text")}</p>
          </div>

          <div class="bg-gradient-to-br from-gray-800/50 to-gray-900/50 border border-white/10 rounded-xl p-6 hover:border-blue-500/50 transition-all">
            <i class="fa-solid fa-bullseye text-green-400 text-3xl mb-4"></i>
            <h3 class="text-lg font-bold mb-2 text-white">{t("use_cases.swing_feature_3_title")}</h3>
            <p class="text-gray-400 text-sm">{t("use_cases.swing_feature_3_text")}</p>
          </div>

          <div class="bg-gradient-to-br from-gray-800/50 to-gray-900/50 border border-white/10 rounded-xl p-6 hover:border-blue-500/50 transition-all">
            <i class="fa-solid fa-bell text-purple-400 text-3xl mb-4"></i>
            <h3 class="text-lg font-bold mb-2 text-white">{t("use_cases.swing_feature_4_title")}</h3>
            <p class="text-gray-400 text-sm">{t("use_cases.swing_feature_4_text")}</p>
          </div>

          <div class="bg-gradient-to-br from-gray-800/50 to-gray-900/50 border border-white/10 rounded-xl p-6 hover:border-blue-500/50 transition-all">
            <i class="fa-solid fa-clock text-yellow-400 text-3xl mb-4"></i>
            <h3 class="text-lg font-bold mb-2 text-white">{t("use_cases.swing_feature_5_title")}</h3>
            <p class="text-gray-400 text-sm">{t("use_cases.swing_feature_5_text")}</p>
          </div>

          <div class="bg-gradient-to-br from-gray-800/50 to-gray-900/50 border border-white/10 rounded-xl p-6 hover:border-blue-500/50 transition-all">
            <i class="fa-solid fa-layer-group text-cyan-400 text-3xl mb-4"></i>
            <h3 class="text-lg font-bold mb-2 text-white">{t("use_cases.swing_feature_6_title")}</h3>
            <p class="text-gray-400 text-sm">{t("use_cases.swing_feature_6_text")}</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Recommended Setup -->
    <section class="py-16 md:py-24 border-b border-blue-900/30 bg-gradient-to-b from-[#001429] to-[#002040]">
      <div class="max-w-7xl mx-auto px-4">
        <h2 class="text-3xl md:text-4xl font-bold text-center mb-12">{t("use_cases.swing_setup_h2_pre")} <span class="gradient-text">{t("use_cases.swing_setup_h2_gradient")}</span></h2>

        <div class="grid md:grid-cols-3 gap-8">
          <div class="bg-gradient-to-br from-[#002040] to-[#001429] border border-blue-500/30 rounded-xl p-8 text-center">
            <div class="w-16 h-16 bg-blue-500/20 rounded-full flex items-center justify-center mx-auto mb-6">
              <i class="fa-solid fa-building-columns text-blue-400 text-2xl"></i>
            </div>
            <h3 class="text-xl font-bold mb-4 text-white">{t("use_cases.swing_setup_1_title")}</h3>
            <p class="text-gray-400">{t("use_cases.swing_setup_1_text")}</p>
          </div>

          <div class="bg-gradient-to-br from-[#002040] to-[#001429] border border-[#2B77EE]/30 rounded-xl p-8 text-center">
            <div class="w-16 h-16 bg-[#2B77EE]/20 rounded-full flex items-center justify-center mx-auto mb-6">
              <i class="fa-solid fa-chart-line text-[#2B77EE] text-2xl"></i>
            </div>
            <h3 class="text-xl font-bold mb-4 text-white">{t("use_cases.swing_setup_2_title")}</h3>
            <p class="text-gray-400">{t("use_cases.swing_setup_2_text")}</p>
          </div>

          <div class="bg-gradient-to-br from-[#002040] to-[#001429] border border-green-500/30 rounded-xl p-8 text-center">
            <div class="w-16 h-16 bg-green-500/20 rounded-full flex items-center justify-center mx-auto mb-6">
              <i class="fa-solid fa-shield-halved text-green-400 text-2xl"></i>
            </div>
            <h3 class="text-xl font-bold mb-4 text-white">{t("use_cases.swing_setup_3_title")}</h3>
            <p class="text-gray-400">{t("use_cases.swing_setup_3_text")}</p>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="py-16 md:py-24 bg-gradient-to-b from-[#002040] to-[#001429]">
      <div class="max-w-7xl mx-auto px-4">
        <div class="grid lg:grid-cols-2 gap-12 lg:gap-16">
          <div>
            <h2 class="text-3xl md:text-4xl font-bold mb-6 text-white">
              {t("use_cases.swing_faq_h2")}
            </h2>
            <p class="text-gray-400 text-lg">
              {t("use_cases.swing_faq_subtitle_pre")}
              <a href={localizedPath(locale, "pages/contact-us")} class="text-blue-400 hover:text-blue-300 underline">{t("use_cases.swing_faq_subtitle_link")}</a> {t("use_cases.swing_faq_subtitle_post")}
            </p>
          </div>

          <div class="space-y-10">
            <div>
              <h3 class="text-xl font-bold text-white mb-3">{t("use_cases.swing_faq_1_q")}</h3>
              <p class="text-gray-400 leading-relaxed">{t("use_cases.swing_faq_1_a")}</p>
            </div>

            <div>
              <h3 class="text-xl font-bold text-white mb-3">{t("use_cases.swing_faq_2_q")}</h3>
              <p class="text-gray-400 leading-relaxed">{t("use_cases.swing_faq_2_a")}</p>
            </div>

            <div>
              <h3 class="text-xl font-bold text-white mb-3">{t("use_cases.swing_faq_3_q")}</h3>
              <p class="text-gray-400 leading-relaxed">{t("use_cases.swing_faq_3_a")}</p>
            </div>

            <div>
              <h3 class="text-xl font-bold text-white mb-3">{t("use_cases.swing_faq_4_q")}</h3>
              <p class="text-gray-400 leading-relaxed">{t("use_cases.swing_faq_4_a")}</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Final CTA -->
    <section class="bg-gradient-to-r from-blue-600 to-blue-700 py-16">
      <div class="max-w-4xl mx-auto px-4 text-center">
        <h2 class="text-3xl sm:text-4xl font-bold mb-6 text-white">
          {t("use_cases.swing_cta_h2")}
        </h2>
        <p class="text-xl text-blue-100 mb-8">
          {t("use_cases.swing_cta_text")}
        </p>
        <a href="https://app.pickmytrade.trade/?register=true"
          class="electrolize-regular inline-block px-8 py-4 bg-white text-blue-700 rounded-xl font-semibold shadow-xl hover:shadow-2xl transform hover:-translate-y-1 transition-all duration-300">
          {t("use_cases.swing_cta_button")}
        </a>
      </div>
    </section>
  </div>

  <!-- Risk Disclaimer -->
  <section style="border-top:1px solid rgba(255,255,255,0.06);background:rgba(0,32,64,0.5);padding:2.5rem 1rem;" aria-label="Risk disclaimer">
    <div style="max-width:56rem;margin:0 auto">
      <p style="font-size:0.75rem;color:rgba(255,255,255,0.4);line-height:1.6"><strong style="color:rgba(255,255,255,0.6)">{t("use_cases.swing_risk_label")}</strong> {t("use_cases.swing_risk_text")}</p>
    </div>
  </section>
</BaseLayout>
