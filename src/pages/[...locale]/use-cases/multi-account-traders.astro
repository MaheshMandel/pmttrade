---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import FaqItem from "../../../components/FaqItem.astro";
import { getLocalePaths, useTranslations, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { subscriptionOfferExtras } from "../../../lib/schema";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };
const t = useTranslations(locale);

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": Array.from({ length: 11 }, (_, i) => i + 1).map((n) => ({
    "@type": "Question",
    "name": t(`use_cases.multi_account_faq_${n}_q` as any),
    "acceptedAnswer": { "@type": "Answer", "text": t(`use_cases.multi_account_faq_${n}_a` as any) },
  })),
};

const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": `${SITE_URL}${withSlash(localizedPath(locale))}` },
    { "@type": "ListItem", "position": 2, "name": "Multi-Account Traders", "item": `${SITE_URL}${withSlash(localizedPath(locale, "use-cases/multi-account-traders"))}` },
  ],
};

const supportedBrokers = ["Tradovate", "Rithmic", "Interactive Brokers", "TradeStation", "TradeLocker", "ProjectX", "Match-Trader", "Tradier (Beta)", "cTrader (Beta)", "Ironbeam (Beta)"];

const pageUrl = `${SITE_URL}${withSlash(localizedPath(locale, "use-cases/multi-account-traders"))}`;

const webPageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": t("use_cases.multi_account_meta_title"),
  "description": t("use_cases.multi_account_meta_description"),
  "url": pageUrl,
  "inLanguage": "en-US",
  "isPartOf": { "@type": "WebSite", "name": "PickMyTrade", "url": SITE_URL },
  "primaryImageOfPage": { "@type": "ImageObject", "url": `${SITE_URL}/assets/logo.png` },
};


const productSchema = {
  "@context": "https://schema.org",
  "@type": "Product",
  "name": "PickMyTrade Multi-Account Trade Copier",
  "description": "Copy one TradingView signal or one manual trade to unlimited Tradovate accounts under a single subscription, with per-account position sizing and 24/7 cloud execution.",
  "image": `${SITE_URL}/assets/logo.png`,
  "brand": { "@type": "Brand", "name": "PickMyTrade" },
  "offers": {
    "@type": "Offer",
    "price": "50.00",
    "priceCurrency": "USD",
    "priceValidUntil": "2026-12-31",
    "availability": "https://schema.org/InStock",
    "url": pageUrl,
    "description": "$50 per month or $500 per year. 7-day free trial, no credit card required. One subscription covers unlimited accounts under a single broker login.",
    ...subscriptionOfferExtras,
  },
};
---

<BaseLayout
  locale={locale}
  title={t("use_cases.multi_account_meta_title")}
  description={t("use_cases.multi_account_meta_description")}
  ldJson={[faqSchema, breadcrumbSchema, webPageSchema, productSchema]}
>
  <style>
    .electrolize-regular { font-family: 'Electrolize', sans-serif; font-weight: 400; }
    .gradient-text { background: linear-gradient(135deg, #2B77EE, #0F3EC3); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; }
  </style>

  <div class="bg-[#001429]">
    <!-- Hero -->
    <section class="py-16 lg:py-24 border-b border-blue-900/30 bg-gradient-to-b from-[#001429] to-[#002040]">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <span class="electrolize-regular inline-block px-4 py-2 bg-blue-600/20 text-blue-400 rounded-full text-sm font-semibold mb-4 border border-blue-500/30 uppercase">{t("use_cases.multi_account_hero_badge")}</span>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold text-white mb-6 tracking-tight">{t("use_cases.multi_account_hero_h1_pre")}<br><span class="gradient-text">{t("use_cases.multi_account_hero_h1_gradient")}</span></h1>
        <p class="text-xl md:text-2xl text-gray-300 max-w-3xl mx-auto mb-8">{t("use_cases.multi_account_hero_subtitle")}</p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center mb-8">
          <a href="https://app.pickmytrade.trade/?register=true" class="electrolize-regular inline-flex items-center justify-center gap-2 px-8 py-4 bg-gradient-to-r from-blue-600 to-blue-700 hover:from-blue-700 hover:to-blue-800 text-white rounded-xl font-bold transition-all transform hover:scale-105 shadow-xl"><i class="fas fa-rocket"></i> {t("use_cases.multi_account_hero_cta_primary")}</a>
          <a href="https://docs.pickmytrade.trade/docs/tradingview-to-tradovate-trade-copier/" class="electrolize-regular inline-flex items-center justify-center gap-2 px-8 py-4 bg-white/10 hover:bg-white/20 text-white rounded-xl font-bold border border-white/20"><i class="fas fa-book"></i> {t("use_cases.multi_account_hero_cta_secondary")}</a>
        </div>
        <div class="flex flex-wrap justify-center gap-3 text-sm">
          <div class="flex items-center gap-2 bg-white/5 border border-white/10 rounded-full px-4 py-2"><i class="fa-solid fa-infinity text-green-400"></i><span>{t("use_cases.multi_account_hero_pill_1")}</span></div>
          <div class="flex items-center gap-2 bg-white/5 border border-white/10 rounded-full px-4 py-2"><i class="fa-solid fa-sync text-yellow-400"></i><span>{t("use_cases.multi_account_hero_pill_2")}</span></div>
          <div class="flex items-center gap-2 bg-white/5 border border-white/10 rounded-full px-4 py-2"><i class="fa-solid fa-sliders-h text-purple-400"></i><span>{t("use_cases.multi_account_hero_pill_3")}</span></div>
        </div>
      </div>
    </section>

    <!-- Who Benefits -->
    <section class="py-16 md:py-24 border-b border-blue-900/30 bg-gradient-to-b from-[#002040] to-[#001429]">
      <div class="max-w-7xl mx-auto px-4">
        <div class="text-center mb-12">
          <span class="inline-block px-4 py-2 bg-orange-600/20 text-orange-400 rounded-full text-sm font-semibold mb-4 border border-orange-500/30">{t("use_cases.multi_account_who_badge")}</span>
          <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">{t("use_cases.multi_account_who_h2")}</h2>
        </div>
        <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
          <div class="group bg-gradient-to-br from-gray-800/50 to-gray-900/50 rounded-xl p-6 border border-gray-700/50 hover:border-orange-500/50 transition-all">
            <div class="w-14 h-14 bg-orange-500/20 rounded-xl flex items-center justify-center mb-4"><i class="fas fa-building text-orange-400 text-2xl"></i></div>
            <h3 class="text-xl font-bold text-white mb-2">{t("use_cases.multi_account_who_1_title")}</h3>
            <p class="text-gray-400 text-sm">{t("use_cases.multi_account_who_1_text")}</p>
          </div>
          <div class="group bg-gradient-to-br from-gray-800/50 to-gray-900/50 rounded-xl p-6 border border-gray-700/50 hover:border-green-500/50 transition-all">
            <div class="w-14 h-14 bg-green-500/20 rounded-xl flex items-center justify-center mb-4"><i class="fas fa-hand-holding-usd text-green-400 text-2xl"></i></div>
            <h3 class="text-xl font-bold text-white mb-2">{t("use_cases.multi_account_who_2_title")}</h3>
            <p class="text-gray-400 text-sm">{t("use_cases.multi_account_who_2_text")}</p>
          </div>
          <div class="group bg-gradient-to-br from-gray-800/50 to-gray-900/50 rounded-xl p-6 border border-gray-700/50 hover:border-blue-500/50 transition-all">
            <div class="w-14 h-14 bg-blue-500/20 rounded-xl flex items-center justify-center mb-4"><i class="fas fa-users text-blue-400 text-2xl"></i></div>
            <h3 class="text-xl font-bold text-white mb-2">{t("use_cases.multi_account_who_3_title")}</h3>
            <p class="text-gray-400 text-sm">{t("use_cases.multi_account_who_3_text")}</p>
          </div>
          <div class="group bg-gradient-to-br from-gray-800/50 to-gray-900/50 rounded-xl p-6 border border-gray-700/50 hover:border-purple-500/50 transition-all">
            <div class="w-14 h-14 bg-purple-500/20 rounded-xl flex items-center justify-center mb-4"><i class="fas fa-user-tie text-purple-400 text-2xl"></i></div>
            <h3 class="text-xl font-bold text-white mb-2">{t("use_cases.multi_account_who_4_title")}</h3>
            <p class="text-gray-400 text-sm">{t("use_cases.multi_account_who_4_text")}</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Manual Trade Copier -->
    <section class="py-16 md:py-24 border-b border-gray-800">
      <div class="max-w-7xl mx-auto px-4">
        <div class="text-center mb-12">
          <span class="inline-block px-4 py-2 bg-blue-600/20 text-blue-400 rounded-full text-sm font-semibold mb-4 border border-blue-500/30">{t("use_cases.multi_account_copier_badge")}</span>
          <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">{t("use_cases.multi_account_copier_h2")}</h2>
          <p class="text-gray-300 text-lg max-w-3xl mx-auto">{t("use_cases.multi_account_copier_subtitle")}</p>
        </div>
        <div class="grid lg:grid-cols-2 gap-12 items-center">
          <div class="space-y-6">
            <div class="flex gap-4">
              <div class="w-10 h-10 bg-blue-500 rounded-full flex items-center justify-center text-white font-bold flex-shrink-0">1</div>
              <div>
                <h4 class="text-lg font-semibold text-white mb-1">{t("use_cases.multi_account_copier_step_1_title")}</h4>
                <p class="text-gray-400">{t("use_cases.multi_account_copier_step_1_text")}</p>
              </div>
            </div>
            <div class="flex gap-4">
              <div class="w-10 h-10 bg-blue-500 rounded-full flex items-center justify-center text-white font-bold flex-shrink-0">2</div>
              <div>
                <h4 class="text-lg font-semibold text-white mb-1">{t("use_cases.multi_account_copier_step_2_title")}</h4>
                <p class="text-gray-400">{t("use_cases.multi_account_copier_step_2_text")}</p>
              </div>
            </div>
            <div class="flex gap-4">
              <div class="w-10 h-10 bg-blue-500 rounded-full flex items-center justify-center text-white font-bold flex-shrink-0">3</div>
              <div>
                <h4 class="text-lg font-semibold text-white mb-1">{t("use_cases.multi_account_copier_step_3_title")}</h4>
                <p class="text-gray-400">{t("use_cases.multi_account_copier_step_3_text")}</p>
              </div>
            </div>
            <div class="flex gap-4">
              <div class="w-10 h-10 bg-green-500 rounded-full flex items-center justify-center text-white font-bold flex-shrink-0">4</div>
              <div>
                <h4 class="text-lg font-semibold text-white mb-1">{t("use_cases.multi_account_copier_step_4_title")}</h4>
                <p class="text-gray-400">{t("use_cases.multi_account_copier_step_4_text")}</p>
              </div>
            </div>
          </div>
          <div class="bg-gray-900/80 rounded-2xl p-6 border border-gray-700">
            <h4 class="text-lg font-bold text-white mb-4 text-center">{t("use_cases.multi_account_copier_panel_title")}</h4>
            <div class="space-y-3">
              <div class="flex justify-between items-center p-4 bg-blue-900/30 rounded-lg border border-blue-700/50">
                <div class="flex items-center gap-3">
                  <div class="w-3 h-3 bg-blue-500 rounded-full animate-pulse"></div>
                  <span class="text-white font-medium">{t("use_cases.multi_account_copier_master_label")}</span>
                </div>
                <span class="text-blue-400 text-sm">{t("use_cases.multi_account_copier_master_badge")}</span>
              </div>
              <div class="flex items-center justify-center text-gray-500"><i class="fas fa-arrow-down"></i> {t("use_cases.multi_account_copier_copying_to")}</div>
              <div class="flex justify-between items-center p-3 bg-gray-800/50 rounded-lg border border-gray-700">
                <div>
                  <span class="text-gray-300 block">{t("use_cases.multi_account_copier_account_1_name")}</span>
                  <span class="text-gray-500 text-xs">{t("use_cases.multi_account_copier_account_1_type")}</span>
                </div>
                <span class="text-green-400 font-mono text-sm">1.0x</span>
              </div>
              <div class="flex justify-between items-center p-3 bg-gray-800/50 rounded-lg border border-gray-700">
                <div>
                  <span class="text-gray-300 block">{t("use_cases.multi_account_copier_account_2_name")}</span>
                  <span class="text-gray-500 text-xs">{t("use_cases.multi_account_copier_account_2_type")}</span>
                </div>
                <span class="text-green-400 font-mono text-sm">0.5x</span>
              </div>
              <div class="flex justify-between items-center p-3 bg-gray-800/50 rounded-lg border border-gray-700">
                <div>
                  <span class="text-gray-300 block">{t("use_cases.multi_account_copier_account_3_name")}</span>
                  <span class="text-gray-500 text-xs">{t("use_cases.multi_account_copier_account_3_type")}</span>
                </div>
                <span class="text-yellow-400 font-mono text-sm">1.5x</span>
              </div>
              <div class="flex justify-between items-center p-3 bg-gray-800/50 rounded-lg border border-gray-700">
                <div>
                  <span class="text-gray-300 block">{t("use_cases.multi_account_copier_account_4_name")}</span>
                  <span class="text-gray-500 text-xs">{t("use_cases.multi_account_copier_account_4_type")}</span>
                </div>
                <span class="text-purple-400 font-mono text-sm">0.25x</span>
              </div>
              <button class="w-full py-3 bg-red-600 text-white font-bold rounded-lg mt-4">{t("use_cases.multi_account_copier_stop_btn")}</button>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Quantity Multiplier Deep Dive -->
    <section class="py-16 md:py-24 border-b border-blue-900/30 bg-gradient-to-b from-[#001429] to-[#002040]">
      <div class="max-w-7xl mx-auto px-4">
        <div class="text-center mb-12">
          <span class="inline-block px-4 py-2 bg-green-600/20 text-green-400 rounded-full text-sm font-semibold mb-4 border border-green-500/30">{t("use_cases.multi_account_qty_badge")}</span>
          <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">{t("use_cases.multi_account_qty_h2")}</h2>
          <p class="text-gray-300 text-lg max-w-3xl mx-auto">{t("use_cases.multi_account_qty_subtitle")}</p>
        </div>
        <div class="grid lg:grid-cols-2 gap-12">
          <div>
            <h3 class="text-xl font-bold text-white mb-6">{t("use_cases.multi_account_qty_how_title")}</h3>
            <div class="bg-gray-800/50 rounded-xl p-6 border border-gray-700 mb-6">
              <p class="text-gray-300 mb-4">{t("use_cases.multi_account_qty_formula")}</p>
              <div class="space-y-3">
                <div class="flex justify-between items-center p-3 bg-gray-900/50 rounded-lg">
                  <span class="text-gray-400">{t("use_cases.multi_account_qty_example_1_master")}</span>
                  <span class="text-green-400">&times; 1.0</span>
                  <span class="text-white font-medium">{t("use_cases.multi_account_qty_example_1_result")}</span>
                </div>
                <div class="flex justify-between items-center p-3 bg-gray-900/50 rounded-lg">
                  <span class="text-gray-400">{t("use_cases.multi_account_qty_example_2_master")}</span>
                  <span class="text-blue-400">&times; 2.0</span>
                  <span class="text-white font-medium">{t("use_cases.multi_account_qty_example_2_result")}</span>
                </div>
                <div class="flex justify-between items-center p-3 bg-gray-900/50 rounded-lg">
                  <span class="text-gray-400">{t("use_cases.multi_account_qty_example_3_master")}</span>
                  <span class="text-purple-400">&times; 3.0</span>
                  <span class="text-white font-medium">{t("use_cases.multi_account_qty_example_3_result")}</span>
                </div>
              </div>
            </div>
          </div>
          <div>
            <h3 class="text-xl font-bold text-white mb-6">{t("use_cases.multi_account_qty_use_cases_title")}</h3>
            <div class="space-y-4">
              <div class="bg-gradient-to-br from-gray-800/50 to-gray-900/50 rounded-xl p-5 border border-gray-700/50">
                <h4 class="text-white font-semibold mb-2"><i class="fas fa-chart-bar text-yellow-400 mr-2"></i>{t("use_cases.multi_account_qty_use_1_title")}</h4>
                <p class="text-gray-400 text-sm">{t("use_cases.multi_account_qty_use_1_text")}</p>
              </div>
              <div class="bg-gradient-to-br from-gray-800/50 to-gray-900/50 rounded-xl p-5 border border-gray-700/50">
                <h4 class="text-white font-semibold mb-2"><i class="fas fa-rocket text-blue-400 mr-2"></i>{t("use_cases.multi_account_qty_use_2_title")}</h4>
                <p class="text-gray-400 text-sm">{t("use_cases.multi_account_qty_use_2_text")}</p>
              </div>
              <div class="bg-gradient-to-br from-gray-800/50 to-gray-900/50 rounded-xl p-5 border border-gray-700/50">
                <h4 class="text-white font-semibold mb-2"><i class="fas fa-shield-alt text-green-400 mr-2"></i>{t("use_cases.multi_account_qty_use_3_title")}</h4>
                <p class="text-gray-400 text-sm">{t("use_cases.multi_account_qty_use_3_text")}</p>
              </div>
              <div class="bg-gradient-to-br from-gray-800/50 to-gray-900/50 rounded-xl p-5 border border-gray-700/50">
                <h4 class="text-white font-semibold mb-2"><i class="fas fa-users text-purple-400 mr-2"></i>{t("use_cases.multi_account_qty_use_4_title")}</h4>
                <p class="text-gray-400 text-sm">{t("use_cases.multi_account_qty_use_4_text")}</p>
              </div>
            </div>
          </div>
        </div>
        <div class="mt-8 p-6 bg-yellow-900/20 rounded-xl border border-yellow-700/50">
          <h4 class="text-yellow-400 font-semibold mb-2"><i class="fas fa-exclamation-triangle mr-2"></i>{t("use_cases.multi_account_qty_note_title")}</h4>
          <ul class="text-gray-300 text-sm space-y-2">
            <li>&bull; <strong>{t("use_cases.multi_account_qty_note_1_label")}</strong> {t("use_cases.multi_account_qty_note_1_text")}</li>
            <li>&bull; <strong>{t("use_cases.multi_account_qty_note_2_label")}</strong> {t("use_cases.multi_account_qty_note_2_text")}</li>
            <li>&bull; <strong>{t("use_cases.multi_account_qty_note_3_label")}</strong> {t("use_cases.multi_account_qty_note_3_text")}</li>
          </ul>
        </div>
      </div>
    </section>

    <!-- Account Management -->
    <section class="py-16 md:py-24 border-b border-gray-800">
      <div class="max-w-7xl mx-auto px-4">
        <div class="text-center mb-12">
          <span class="inline-block px-4 py-2 bg-purple-600/20 text-purple-400 rounded-full text-sm font-semibold mb-4 border border-purple-500/30">{t("use_cases.multi_account_acct_badge")}</span>
          <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">{t("use_cases.multi_account_acct_h2")}</h2>
          <p class="text-gray-300 text-lg max-w-3xl mx-auto">{t("use_cases.multi_account_acct_subtitle")}</p>
        </div>
        <div class="grid md:grid-cols-2 gap-8">
          <div class="bg-gradient-to-br from-gray-800/50 to-gray-900/50 rounded-xl p-8 border border-gray-700/50">
            <h3 class="text-xl font-bold text-white mb-6"><i class="fas fa-link text-blue-400 mr-2"></i>{t("use_cases.multi_account_link_h3")}</h3>
            <div class="space-y-4">
              <div class="flex gap-4">
                <div class="w-8 h-8 bg-blue-500/20 rounded-full flex items-center justify-center text-blue-400 font-bold flex-shrink-0">1</div>
                <p class="text-gray-300 text-sm">{t("use_cases.multi_account_link_step_1")}</p>
              </div>
              <div class="flex gap-4">
                <div class="w-8 h-8 bg-blue-500/20 rounded-full flex items-center justify-center text-blue-400 font-bold flex-shrink-0">2</div>
                <p class="text-gray-300 text-sm">{t("use_cases.multi_account_link_step_2")}</p>
              </div>
              <div class="flex gap-4">
                <div class="w-8 h-8 bg-blue-500/20 rounded-full flex items-center justify-center text-blue-400 font-bold flex-shrink-0">3</div>
                <p class="text-gray-300 text-sm">{t("use_cases.multi_account_link_step_3")}</p>
              </div>
              <div class="flex gap-4">
                <div class="w-8 h-8 bg-green-500/20 rounded-full flex items-center justify-center text-green-400 font-bold flex-shrink-0">4</div>
                <p class="text-gray-300 text-sm">{t("use_cases.multi_account_link_step_4")}</p>
              </div>
            </div>
          </div>
          <div class="bg-gradient-to-br from-gray-800/50 to-gray-900/50 rounded-xl p-8 border border-gray-700/50">
            <h3 class="text-xl font-bold text-white mb-6"><i class="fas fa-plus text-green-400 mr-2"></i>{t("use_cases.multi_account_create_h3")}</h3>
            <div class="space-y-4">
              <div class="flex gap-4">
                <div class="w-8 h-8 bg-green-500/20 rounded-full flex items-center justify-center text-green-400 font-bold flex-shrink-0">1</div>
                <p class="text-gray-300 text-sm">{t("use_cases.multi_account_create_step_1")}</p>
              </div>
              <div class="flex gap-4">
                <div class="w-8 h-8 bg-green-500/20 rounded-full flex items-center justify-center text-green-400 font-bold flex-shrink-0">2</div>
                <p class="text-gray-300 text-sm">{t("use_cases.multi_account_create_step_2")}</p>
              </div>
              <div class="flex gap-4">
                <div class="w-8 h-8 bg-green-500/20 rounded-full flex items-center justify-center text-green-400 font-bold flex-shrink-0">3</div>
                <p class="text-gray-300 text-sm">{t("use_cases.multi_account_create_step_3")}</p>
              </div>
              <div class="flex gap-4">
                <div class="w-8 h-8 bg-green-500/20 rounded-full flex items-center justify-center text-green-400 font-bold flex-shrink-0">4</div>
