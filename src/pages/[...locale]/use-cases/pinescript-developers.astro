---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getLocalePaths, useTranslations, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };
const t = useTranslations(locale);

const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": `${SITE_URL}${withSlash(localizedPath(locale))}` },
    { "@type": "ListItem", "position": 2, "name": "Pine Script Developers", "item": `${SITE_URL}${withSlash(localizedPath(locale, "use-cases/pinescript-developers"))}` },
  ],
};
---

<BaseLayout
  locale={locale}
  title={t("use_cases.pinescript_meta_title")}
  description={t("use_cases.pinescript_meta_description")}
  ldJson={[breadcrumbSchema]}
>
  <style>
    .electrolize-regular {
      font-family: 'Electrolize', sans-serif;
      font-weight: 400;
    }

    .gradient-text {
      background: linear-gradient(135deg, #2B77EE, #0F3EC3);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }
  </style>

  <div class="bg-[#001429]">
    <!-- Hero -->
    <section class="py-16 lg:py-24 border-b border-blue-900/30 bg-gradient-to-b from-[#001429] to-[#002040]">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <span
          class="electrolize-regular inline-block px-4 py-2 bg-blue-600/20 text-blue-400 rounded-full text-sm font-semibold mb-4 border border-blue-500/30 uppercase">{t("use_cases.pinescript_hero_badge")}</span>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold text-white mb-6 tracking-tight">{t("use_cases.pinescript_hero_h1_pre")}
          <br><span class="gradient-text">{t("use_cases.pinescript_hero_h1_gradient")}</span></h1>
        <p class="text-xl md:text-2xl text-gray-300 max-w-3xl mx-auto mb-8">{t("use_cases.pinescript_hero_subtitle")}</p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center mb-8">
          <a href="https://app.pickmytrade.trade/?register=true"
            class="electrolize-regular inline-flex items-center justify-center gap-2 px-8 py-4 bg-gradient-to-r from-blue-600 to-blue-700 hover:from-blue-700 hover:to-blue-800 text-white rounded-xl font-bold transition-all transform hover:scale-105 shadow-xl"><i
              class="fas fa-rocket"></i> {t("use_cases.pinescript_hero_cta_primary")}</a>
        </div>
        <div class="flex flex-wrap justify-center gap-3 text-sm">
          <div class="flex items-center gap-2 bg-white/5 border border-white/10 rounded-full px-4 py-2"><i
              class="fa-solid fa-code text-green-400"></i><span>{t("use_cases.pinescript_hero_pill_1")}</span></div>
          <div class="flex items-center gap-2 bg-white/5 border border-white/10 rounded-full px-4 py-2"><i
              class="fa-solid fa-plug text-yellow-400"></i><span>{t("use_cases.pinescript_hero_pill_2")}</span></div>
          <div class="flex items-center gap-2 bg-white/5 border border-white/10 rounded-full px-4 py-2"><i
              class="fa-solid fa-chart-line text-purple-400"></i><span>{t("use_cases.pinescript_hero_pill_3")}</span></div>
        </div>
      </div>
    </section>

    <!-- From Backtest to Live -->
    <section class="py-16 md:py-24 border-b border-blue-900/30 bg-gradient-to-b from-[#002040] to-[#001429]">
      <div class="max-w-7xl mx-auto px-4">
        <div class="text-center mb-12">
          <span
            class="inline-block px-4 py-2 bg-green-600/20 text-green-400 rounded-full text-sm font-semibold mb-4 border border-green-500/30">{t("use_cases.pinescript_deploy_badge")}</span>
          <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">{t("use_cases.pinescript_deploy_h2")}</h2>
          <p class="text-gray-300 text-lg max-w-3xl mx-auto">{t("use_cases.pinescript_deploy_subtitle")}</p>
        </div>
        <div class="grid md:grid-cols-4 gap-6">
          <div class="text-center">
            <div
              class="w-16 h-16 bg-gradient-to-br from-blue-500 to-blue-600 rounded-full flex items-center justify-center mx-auto mb-4 text-white font-bold text-2xl">
              1</div>
            <h3 class="text-lg font-bold text-white mb-2">{t("use_cases.pinescript_deploy_step_1_title")}</h3>
            <p class="text-gray-400 text-sm">{t("use_cases.pinescript_deploy_step_1_text")}</p>
          </div>
          <div class="text-center">
            <div
              class="w-16 h-16 bg-gradient-to-br from-blue-500 to-blue-600 rounded-full flex items-center justify-center mx-auto mb-4 text-white font-bold text-2xl">
              2</div>
            <h3 class="text-lg font-bold text-white mb-2">{t("use_cases.pinescript_deploy_step_2_title")}</h3>
            <p class="text-gray-400 text-sm">{t("use_cases.pinescript_deploy_step_2_text")}</p>
          </div>
          <div class="text-center">
            <div
              class="w-16 h-16 bg-gradient-to-br from-blue-500 to-blue-600 rounded-full flex items-center justify-center mx-auto mb-4 text-white font-bold text-2xl">
              3</div>
            <h3 class="text-lg font-bold text-white mb-2">{t("use_cases.pinescript_deploy_step_3_title")}</h3>
            <p class="text-gray-400 text-sm">{t("use_cases.pinescript_deploy_step_3_text")}</p>
          </div>
          <div class="text-center">
            <div
              class="w-16 h-16 bg-gradient-to-br from-green-500 to-green-600 rounded-full flex items-center justify-center mx-auto mb-4 text-white font-bold text-2xl">
              4</div>
            <h3 class="text-lg font-bold text-white mb-2">{t("use_cases.pinescript_deploy_step_4_title")}</h3>
            <p class="text-gray-400 text-sm">{t("use_cases.pinescript_deploy_step_4_text")}</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Strategy vs Indicator -->
    <section class="py-16 md:py-24 border-b border-gray-800">
      <div class="max-w-7xl mx-auto px-4">
        <div class="text-center mb-12">
          <span
            class="inline-block px-4 py-2 bg-blue-600/20 text-blue-400 rounded-full text-sm font-semibold mb-4 border border-blue-500/30">{t("use_cases.pinescript_compat_badge")}</span>
          <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">{t("use_cases.pinescript_compat_h2")}</h2>
          <p class="text-gray-300 text-lg max-w-3xl mx-auto">{t("use_cases.pinescript_compat_subtitle")}</p>
        </div>
        <div class="grid md:grid-cols-2 gap-8">
          <div class="bg-gradient-to-br from-green-900/20 to-gray-900/50 rounded-xl p-8 border border-green-700/50">
            <div class="flex items-center gap-3 mb-4">
              <div class="w-12 h-12 bg-green-500/20 rounded-xl flex items-center justify-center"><i
                  class="fas fa-check-circle text-green-400 text-2xl"></i></div>
              <h3 class="text-xl font-bold text-white">{t("use_cases.pinescript_strategy_h3")}</h3>
            </div>
            <p class="text-gray-300 mb-4">{t("use_cases.pinescript_strategy_desc")}</p>
            <ul class="text-gray-400 text-sm space-y-3">
              <li class="flex items-start gap-2"><i class="fas fa-check text-green-400 mt-1"></i>{t("use_cases.pinescript_strategy_feat_1")}</li>
              <li class="flex items-start gap-2"><i class="fas fa-check text-green-400 mt-1"></i>{t("use_cases.pinescript_strategy_feat_2")}</li>
              <li class="flex items-start gap-2"><i class="fas fa-check text-green-400 mt-1"></i>{t("use_cases.pinescript_strategy_feat_3")}</li>
            </ul>
            <div class="mt-4 px-4 py-2 bg-green-500/10 rounded-lg border border-green-500/30">
              <p class="text-green-400 text-sm font-medium">{t("use_cases.pinescript_strategy_recommended")}</p>
            </div>
          </div>
          <div class="bg-gradient-to-br from-yellow-900/20 to-gray-900/50 rounded-xl p-8 border border-yellow-700/50">
            <div class="flex items-center gap-3 mb-4">
              <div class="w-12 h-12 bg-yellow-500/20 rounded-xl flex items-center justify-center"><i
                  class="fas fa-exclamation-triangle text-yellow-400 text-2xl"></i></div>
              <h3 class="text-xl font-bold text-white">{t("use_cases.pinescript_indicator_h3")}</h3>
            </div>
            <p class="text-gray-300 mb-4">{t("use_cases.pinescript_indicator_desc")}</p>
            <ul class="text-gray-400 text-sm space-y-3">
              <li class="flex items-start gap-2"><i class="fas fa-exclamation text-yellow-400 mt-1"></i>{t("use_cases.pinescript_indicator_feat_1")}</li>
              <li class="flex items-start gap-2"><i class="fas fa-exclamation text-yellow-400 mt-1"></i>{t("use_cases.pinescript_indicator_feat_2")}</li>
              <li class="flex items-start gap-2"><i class="fas fa-exclamation text-yellow-400 mt-1"></i>{t("use_cases.pinescript_indicator_feat_3")}</li>
            </ul>
            <div class="mt-4 px-4 py-2 bg-yellow-500/10 rounded-lg border border-yellow-500/30">
              <p class="text-yellow-400 text-sm font-medium">{t("use_cases.pinescript_indicator_note")}</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- JSON Configuration -->
    <section class="py-16 md:py-24 border-b border-blue-900/30 bg-gradient-to-b from-[#001429] to-[#002040]">
      <div class="max-w-7xl mx-auto px-4">
        <div class="text-center mb-12">
          <span
            class="inline-block px-4 py-2 bg-purple-600/20 text-purple-400 rounded-full text-sm font-semibold mb-4 border border-purple-500/30">{t("use_cases.pinescript_json_badge")}</span>
          <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">{t("use_cases.pinescript_json_h2")}</h2>
          <p class="text-gray-300 text-lg max-w-3xl mx-auto">{t("use_cases.pinescript_json_subtitle")}</p>
        </div>
        <div class="grid lg:grid-cols-2 gap-8">
          <div>
            <h3 class="text-xl font-bold text-white mb-6">{t("use_cases.pinescript_json_params_h3")}</h3>
            <div class="space-y-4">
              <div class="bg-gray-800/50 rounded-lg p-4 border border-gray-700">
                <div class="flex justify-between items-center mb-2">
                  <span class="text-blue-400 font-mono text-sm">ticker</span>
                  <span class="text-gray-500 text-xs">{t("use_cases.pinescript_json_param_ticker_label")}</span>
                </div>
                <p class="text-gray-400 text-sm">{t("use_cases.pinescript_json_param_ticker_desc")}</p>
              </div>
              <div class="bg-gray-800/50 rounded-lg p-4 border border-gray-700">
                <div class="flex justify-between items-center mb-2">
                  <span class="text-green-400 font-mono text-sm">action</span>
                  <span class="text-gray-500 text-xs">{t("use_cases.pinescript_json_param_action_label")}</span>
                </div>
                <p class="text-gray-400 text-sm">{t("use_cases.pinescript_json_param_action_desc")}</p>
              </div>
              <div class="bg-gray-800/50 rounded-lg p-4 border border-gray-700">
                <div class="flex justify-between items-center mb-2">
                  <span class="text-yellow-400 font-mono text-sm">quantity</span>
                  <span class="text-gray-500 text-xs">{t("use_cases.pinescript_json_param_quantity_label")}</span>
                </div>
                <p class="text-gray-400 text-sm">{t("use_cases.pinescript_json_param_quantity_desc")}</p>
              </div>
              <div class="bg-gray-800/50 rounded-lg p-4 border border-gray-700">
                <div class="flex justify-between items-center mb-2">
                  <span class="text-purple-400 font-mono text-sm">sl / dollar_sl / percentage_sl</span>
                  <span class="text-gray-500 text-xs">{t("use_cases.pinescript_json_param_sl_label")}</span>
                </div>
                <p class="text-gray-400 text-sm">{t("use_cases.pinescript_json_param_sl_desc")}</p>
              </div>
              <div class="bg-gray-800/50 rounded-lg p-4 border border-gray-700">
                <div class="flex justify-between items-center mb-2">
                  <span class="text-orange-400 font-mono text-sm">tp / dollar_tp / percentage_tp</span>
                  <span class="text-gray-500 text-xs">{t("use_cases.pinescript_json_param_tp_label")}</span>
                </div>
                <p class="text-gray-400 text-sm">{t("use_cases.pinescript_json_param_tp_desc")}</p>
              </div>
            </div>
          </div>
          <div>
            <h3 class="text-xl font-bold text-white mb-6">{t("use_cases.pinescript_json_example_h3")}</h3>
            <div class="bg-gray-900/80 rounded-2xl p-6 border border-gray-700">
              <div class="flex items-center gap-2 mb-4">
                <div class="w-3 h-3 bg-red-500 rounded-full"></div>
                <div class="w-3 h-3 bg-yellow-500 rounded-full"></div>
                <div class="w-3 h-3 bg-green-500 rounded-full"></div>
                <span class="text-gray-400 text-sm ml-2">{t("use_cases.pinescript_json_example_generated")}</span>
              </div>
              <pre class="text-sm overflow-x-auto"><code class="text-green-400">{`{
	"symbol": "NQ1!",
	"date": "{{timenow}}",
	"data": "buy",
	"quantity": 2,
	"risk_percentage": 0,
	"price": "{{close}}",
	"gtd_in_second": 0,
	"stp_limit_stp_price": 0,
	"dollar_tp": 0,
	"percentage_tp": 0,
	"tp": 0,
	"dollar_sl": 0,
	"percentage_sl": 0,
	"sl": 0,
	"trail": 0,
	"trail_stop": 0,
	"trail_trigger": 0,
	"trail_freq": 0,
	"update_tp": false,
	"update_sl": false,
	"breakeven": 0,
	"breakeven_offset": 0,
	"token": "At8tLtTtYtEt8t8tHtWtPtOtR",
	"pyramid": false,
	"same_direction_ignore": false,
	"reverse_order_close": true,
	"order_type": "MKT",
	"multiple_accounts": [
		{
			"token": "UnyTGjYrtvhSW65-Iuds",
			"account_id": "DEMO2001",
			"risk_percentage": 0,
			"quantity_multiplier": 1
		}
	]
}`}</code></pre>
            </div>
            <div class="mt-6 p-4 bg-red-900/20 rounded-lg border border-red-700/50">
              <p class="text-red-400 text-sm"><strong>{t("use_cases.pinescript_json_critical")}</strong> {t("use_cases.pinescript_json_critical_text")}</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Dynamic Plot Values -->
    <section class="py-16 md:py-24 border-b border-gray-800">
      <div class="max-w-7xl mx-auto px-4">
        <div class="text-center mb-12">
          <span
            class="inline-block px-4 py-2 bg-green-600/20 text-green-400 rounded-full text-sm font-semibold mb-4 border border-green-500/30">{t("use_cases.pinescript_dynamic_badge")}</span>
          <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">{t("use_cases.pinescript_dynamic_h2")}</h2>
          <p class="text-gray-300 text-lg max-w-3xl mx-auto">{t("use_cases.pinescript_dynamic_subtitle")}</p>
        </div>
        <div class="grid lg:grid-cols-2 gap-8 items-start">
          <div class="space-y-6">
            <div class="bg-gradient-to-br from-gray-800/50 to-gray-900/50 rounded-xl p-6 border border-gray-700/50">
              <h4 class="text-lg font-bold text-white mb-3">{t("use_cases.pinescript_dynamic_step_1_title")}</h4>
              <p class="text-gray-400 text-sm mb-3">{t("use_cases.pinescript_dynamic_step_1_text")}</p>
              <div class="bg-gray-900 rounded-lg p-4">
                <code class="text-green-400 text-sm">plot(atr_sl, title="ATR_SL", display=display.none)</code>
              </div>
            </div>
            <div class="bg-gradient-to-br from-gray-800/50 to-gray-900/50 rounded-xl p-6 border border-gray-700/50">
              <h4 class="text-lg font-bold text-white mb-3">{t("use_cases.pinescript_dynamic_step_2_title")}</h4>
              <p class="text-gray-400 text-sm mb-3">{t("use_cases.pinescript_dynamic_step_2_text")}</p>
              <ul class="text-gray-500 text-sm space-y-1">
                <li>&bull; {t("use_cases.pinescript_dynamic_step_2_note_1")}</li>
                <li>&bull; {`{{plot("ATR_SL")}}`} (by title)</li>
              </ul>
            </div>
            <div class="bg-gradient-to-br from-gray-800/50 to-gray-900/50 rounded-xl p-6 border border-gray-700/50">
              <h4 class="text-lg font-bold text-white mb-3">{t("use_cases.pinescript_dynamic_step_3_title")}</h4>
              <p class="text-gray-400 text-sm mb-3">{t("use_cases.pinescript_dynamic_step_3_text")}</p>
              <div class="bg-gray-900 rounded-lg p-4">
                <code class="text-green-400 text-sm">"sl": {`{{plot("ATR_SL")}}`}</code>
              </div>
            </div>
          </div>
          <div class="bg-gray-900/80 rounded-2xl p-6 border border-gray-700">
            <h4 class="text-lg font-bold text-white mb-4">{t("use_cases.pinescript_dynamic_example_h3")}</h4>
            <pre class="text-sm overflow-x-auto"><code class="text-green-400">{`//@version=5
strategy("My Algo", overlay=true)

// Entry logic
longCond = ta.crossover(ta.sma(close, 20), ta.sma(close, 50))
shortCond = ta.crossunder(ta.sma(close, 20), ta.sma(close, 50))

// Dynamic calculations
atr = ta.atr(14)
long_sl = close - (atr * 2)
long_tp = close + (atr * 3)
short_sl = close + (atr * 2)
short_tp = close - (atr * 3)

// Plot for alert access
plot(long_sl, "Long_SL", display=display.none)
plot(long_tp, "Long_TP", display=display.none)
plot(short_sl, "Short_SL", display=display.none)
plot(short_tp, "Short_TP", display=display.none)

// Entries
if longCond
    strategy.entry("Long", strategy.long)
if shortCond
    strategy.entry("Short", strategy.short)

// In PickMyTrade alert (for long):
// "sl": {{plot("Long_SL")}}
// "tp": {{plot("Long_TP")}}`}</code></pre>
          </div>
        </div>
      </div>
    </section>

    <!-- Common Errors -->
    <section class="py-16 md:py-24 border-b border-blue-900/30 bg-gradient-to-b from-[#002040] to-[#001429]">
      <div class="max-w-7xl mx-auto px-4">
        <div class="text-center mb-12">
          <span
            class="inline-block px-4 py-2 bg-red-600/20 text-red-400 rounded-full text-sm font-semibold mb-4 border border-red-500/30">{t("use_cases.pinescript_errors_badge")}</span>
          <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">{t("use_cases.pinescript_errors_h2")}</h2>
        </div>
        <div class="grid md:grid-cols-2 gap-6">
          <div class="bg-gradient-to-br from-gray-800/50 to-gray-900/50 rounded-xl p-6 border border-gray-700/50">
            <div class="text-red-400 font-mono text-sm mb-3">Contact to administrator, could not convert string to float: "{`{{plot('Short SL')}}`}"'</div>
            <p class="text-gray-300 mb-3">{t("use_cases.pinescript_error_1_text")}</p>
          </div>
          <div class="bg-gradient-to-br from-gray-800/50 to-gray-900/50 rounded-xl p-6 border border-gray-700/50">
            <div class="text-red-400 font-mono text-sm mb-3">Wrong Price, we support digit, you are sending {`{{close}}`}</div>
            <p class="text-gray-300 mb-3">{t("use_cases.pinescript_error_2_text")}</p>
          </div>
          <div class="bg-gradient-to-br from-gray-800/50 to-gray-900/50 rounded-xl p-6 border border-gray-700/50">
            <div class="text-red-400 font-mono text-sm mb-3">{`{"failureReason":"UnknownReason","failureText":"Access is denied"}`}</div>
            <p class="text-gray-300 mb-3">{t("use_cases.pinescript_error_3_text")}</p>
          </div>
          <div class="bg-gradient-to-br from-gray-800/50 to-gray-900/50 rounded-xl p-6 border border-gray-700/50">
            <div class="text-red-400 font-mono text-sm mb-3">Can not Send, Manual SL is Zero in</div>
            <p class="text-gray-300 mb-3">{t("use_cases.pinescript_error_4_text")}</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Saved Alerts Feature -->
    <section class="py-16 md:py-24 border-b border-gray-800">
      <div class="max-w-7xl mx-auto px-4">
        <div class="grid md:grid-cols-2 gap-12 items-center">
          <div>
            <span
              class="inline-block px-4 py-2 bg-blue-600/20 text-blue-400 rounded-full text-sm font-semibold mb-4 border border-blue-500/30">{t("use_cases.pinescript_saved_badge")}</span>
            <h2 class="text-3xl md:text-4xl font-bold text-white mb-6">{t("use_cases.pinescript_saved_h2")}</h2>
            <p class="text-gray-300 text-lg mb-6">{t("use_cases.pinescript_saved_subtitle")}</p>
            <ul class="space-y-4">
              <li class="flex items-start gap-3">
                <div class="w-8 h-8 bg-blue-500/20 rounded-lg flex items-center justify-center flex-shrink-0 mt-1"><i
                    class="fas fa-save text-blue-400"></i></div>
                <div>
                  <h4 class="text-white font-medium">{t("use_cases.pinescript_saved_feat_1_title")}</h4>
                  <p class="text-gray-400 text-sm">{t("use_cases.pinescript_saved_feat_1_text")}</p>
                </div>
              </li>
              <li class="flex items-start gap-3">
                <div class="w-8 h-8 bg-green-500/20 rounded-lg flex items-center justify-center flex-shrink-0 mt-1"><i
                    class="fas fa-sync text-green-400"></i></div>
                <div>
                  <h4 class="text-white font-medium">{t("use_cases.pinescript_saved_feat_2_title")}</h4>
                  <p class="text-gray-400 text-sm">{t("use_cases.pinescript_saved_feat_2_text")}</p>
                </div>
              </li>
              <li class="flex items-start gap-3">
                <div class="w-8 h-8 bg-purple-500/20 rounded-lg flex items-center justify-center flex-shrink-0 mt-1"><i
