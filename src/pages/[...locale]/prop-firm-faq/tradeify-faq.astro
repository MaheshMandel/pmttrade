---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import AuthorByline from "../../../components/AuthorByline.astro";
import { getLocalePaths, useTranslations, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import '../../../styles/prop-firm-faq.css';

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };
const t = useTranslations(locale);

const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const PAGE_URL = `${SITE_URL}${withSlash(localizedPath(locale, "prop-firm-faq/tradeify-faq"))}`;
const LAST_UPDATED = "2026-10-06";

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": `${SITE_URL}${withSlash(localizedPath(locale))}` },
    { "@type": "ListItem", "position": 2, "name": "Prop Firm FAQ Hub", "item": `${SITE_URL}${withSlash(localizedPath(locale, "prop-firm-faq"))}` },
    { "@type": "ListItem", "position": 3, "name": "Tradeify FAQ", "item": PAGE_URL },
  ],
};

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: t("prop_firm_faq.tradeify_hero_title"),
  description: t("prop_firm_faq.tradeify_meta_description"),
  publisher: { "@type": "Organization", name: "PickMyTrade", logo: { "@type": "ImageObject", url: `${SITE_URL}/assets/logo.png` } },
  datePublished: "2026-07-08",
  dateModified: LAST_UPDATED,
  mainEntityOfPage: { "@type": "WebPage", "@id": PAGE_URL },
};
---

<BaseLayout
  locale={locale}
  title={t("prop_firm_faq.tradeify_meta_title")}
  description={t("prop_firm_faq.tradeify_meta_description")}
  ogType="article"
  ldJson={[breadcrumbSchema, articleSchema]}
>
<script type="application/ld+json" is:inline>
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is Tradeify and how does it work?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Tradeify is a US futures prop firm offering Select / Growth / Lightning evaluation paths. Pay a one-time fee, hit profit targets, graduate to sim-funded, eventually graduate to Elite Live (real capital) at $80K cumulative payouts. Won \"Highest Rated,\" \"Best Payout Process,\" and \"Most User Friendly\" PropFirmMatch awards in 2025."
      }
    },
    {
      "@type": "Question",
      "name": "Is Tradeify a legit prop firm or a scam?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Legit. 4.6-4.8 Trustpilot across 2,000+ reviews, $50M+ in verified trader payouts, 80,000+ Discord members (March 2026), and multiple 2025 PropFirmMatch industry awards. The Tradeify 3.0 update in March 2026 modernized the model with one-time fees and no activation costs."
      }
    },
    {
      "@type": "Question",
      "name": "Who owns Tradeify and where is the company based?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Tradeify is operated by Tradeify FX LLC, headquartered in Boca Raton, Florida. The firm was co-founded by Brett Simberkoff (CEO) and Vinan Mistry. Privately held and US-based."
      }
    },
    {
      "@type": "Question",
      "name": "When was Tradeify founded?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Tradeify was founded in June 2024 by Brett Simberkoff and Vinan Mistry under entity Tradeify FX LLC (Boca Raton, FL). The firm grew rapidly through 2024-2026, surpassing $50M in verified payouts and reaching 80,000+ Discord members by March 2026."
      }
    },
    {
      "@type": "Question",
      "name": "Is Tradeify regulated?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No - operates as a tech / contractor firm, not a broker-dealer. Standard for retail prop firms."
      }
    },
    {
      "@type": "Question",
      "name": "How does Tradeify make money if traders keep 90%?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Evaluation fees from the ~85-93% of traders who don't reach payout. Growth and Lightning give 100% on the first $5K cumulative profit then 90/10; Select runs 90/10 from dollar one; Elite Live runs 80/20 on profits. The math works because most traders never collect."
      }
    },
    {
      "@type": "Question",
      "name": "Is Tradeify the same as Tradify or Tradeify Crypto?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. \"Tradify\" with one E is a different unrelated company. \"Tradeify Crypto\" doesn't exist as a separate product. Tradeify (with two E's) is the futures prop firm at tradeify.co."
      }
    },
    {
      "@type": "Question",
      "name": "What is Tradeify's Trustpilot rating in 2026?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "4.6-4.8 across 2,000+ reviews. Reviews skew toward fast payouts, supportive community, and clear rules."
      }
    },
    {
      "@type": "Question",
      "name": "What awards has Tradeify won recently?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "PropFirmMatch 2025 awards: Highest Rated, Best Payout Process, Most User Friendly."
      }
    },
    {
      "@type": "Question",
      "name": "Is Tradeify still worth it after the 3.0 update?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes for most traders - 3.0 eliminated subscriptions in favor of one-time fees, which lowers total cost vs Topstep's monthly model. The Lightning instant funding option remains unique. Only caveat is some affiliates publicly stopped promoting; the underlying product is competitive."
      }
    },
    {
      "@type": "Question",
      "name": "What account types does Tradeify offer in 2026?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Select (basic eval, 3-day minimum, 40% consistency), Growth (eval with growth path, 5+ days, 35% consistency on sim-funded), Lightning Funded (instant funded, no eval, tiered 20/25/30% consistency), Sim Funded (post-pass simulated), and Elite Live (real-money tier - $80K cumulative is the threshold for consideration, not automatic transition)."
      }
    },
    {
      "@type": "Question",
      "name": "What's the difference between Select, Growth, and Lightning?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Select = entry-level eval, EOD trailing drawdown. Growth = eval plus growth path with higher contract limits over time. Lightning = instant funded (no eval) at higher upfront cost."
      }
    },
    {
      "@type": "Question",
      "name": "Should I pick Select Daily or Select Flex after passing?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Select Daily allows daily payouts after meeting eligibility; Select Flex pays out after 5 winning days but allows more flexibility on rules. Pick Daily for fast cash flow, Flex for stability."
      }
    },
    {
      "@type": "Question",
      "name": "Can I switch from Growth to Select after buying?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No - plan choice is at purchase. Switching requires buying a new plan."
      }
    },
    {
      "@type": "Question",
      "name": "What's a Sim Funded vs Live Funded account?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Sim Funded = a simulated account that pays real cash from Tradeify's payout pool after you pass an eval (or buy Lightning). Elite Live (Tradeify's \"Live Funded\") = real exchange capital with real CME fills via NinjaTrader Brokerage. Elite Live qualification requires at minimum $80K cumulative payouts plus holistic Tradeify approval."
      }
    },
    {
      "@type": "Question",
      "name": "What is Tradeify Elite Live?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Elite Live is Tradeify's real-money tier introduced with the 3.0 update. $80K cumulative payouts is the minimum threshold for CONSIDERATION - Tradeify evaluates each trader holistically rather than auto-promoting. Elite Live features: no DLL, fixed/static drawdown, 80/20 profit split, real CME fills via NinjaTrader Brokerage, and a $2K-$8K Performance Reward Pool bonus."
      }
    },
    {
      "@type": "Question",
      "name": "Does Tradeify still offer the Advanced Challenge plan?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No - Advanced Challenge was retired December 2025. Existing legacy holders are grandfathered."
      }
    },
    {
      "@type": "Question",
      "name": "Is Lightning Funded really \"instant funding\" with no eval?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes - pay the higher Lightning fee and get a sim-funded account immediately. Stricter rules in exchange (intraday DLL, tighter consistency tiers, smaller drawdown buffers)."
      }
    },
    {
      "@type": "Question",
      "name": "Which Tradeify plan is easiest to pass?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Select with EOD drawdown. Lightning skips the eval entirely but has stricter funded-phase rules - different easy."
      }
    },
    {
      "@type": "Question",
      "name": "Which plan is best for swing traders?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "None ideal - Tradeify auto-flattens at 4:59 PM ET daily, no overnight holds on any plan. Swing traders need to find a different firm."
      }
    },
    {
      "@type": "Question",
      "name": "Which plan is best for scalpers?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Select Daily or Lightning for fast payouts. Watch the microscalping rule (>50% of trades and profit must hold ≥10 sec)."
      }
    },
    {
      "@type": "Question",
      "name": "What is the Straight-to-Sim (S2F) account?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "S2F is Tradeify's term for instant-funded accounts (Lightning) that bypass the evaluation phase."
      }
    },
    {
      "@type": "Question",
      "name": "What account sizes does Tradeify offer?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "$25K (Select/Lightning), $50K, $00K, $50K. The $25K is Select/Lightning only - Growth starts at $50K."
      }
    },
    {
      "@type": "Question",
      "name": "How much does the Growth evaluation cost?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "$11 for $50K, $81 for $00K, $251 for $50K (one-time, with discount codes). Verify on tradeify.co."
      }
    },
    {
      "@type": "Question",
      "name": "How much does the Select evaluation cost?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Comparable to Growth, slightly different pricing - verify per size on tradeify.co."
      }
    },
    {
      "@type": "Question",
      "name": "How much does Lightning Funded cost?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "$49 for Lightning $25K, $549 for $50K (often discounted to $329 with code). Higher than eval-based plans because it skips the evaluation phase."
      }
    },
    {
      "@type": "Question",
      "name": "Why is the 25K plan only available for Select and Lightning?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Growth's growth-path mechanics need a larger starting balance to be meaningful. Select and Lightning offer $25K for budget-conscious traders."
      }
    },
    {
      "@type": "Question",
      "name": "Are there activation fees on Tradeify accounts?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. Tradeify 3.0 (March 2026 update) eliminated activation fees entirely across Select, Growth, and Lightning. Pay the one-time eval or Lightning fee at purchase and that is it - no activation charge when you reach the sim-funded stage."
      }
    },
    {
      "@type": "Question",
      "name": "Do funded accounts have monthly/recurring fees?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. Tradeify 3.0 went fully one-time. No recurring subscriptions."
      }
    },
    {
      "@type": "Question",
      "name": "Are Tradeify discount codes legit?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes - affiliates run codes, Tradeify expects them. Discounts typically 20-50%, deeper during seasonal sales (Black Friday, Memorial Day, anniversary)."
      }
    },
    {
      "@type": "Question",
      "name": "What's the biggest active Tradeify discount?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Up to ~70% off during major promos. Verify current code on tradeify.co or affiliate aggregators."
      }
    },
    {
      "@type": "Question",
      "name": "Do promo codes work on resets and refreshes?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. Promo and discount codes do not apply to resets - resets are a flat $95 across Growth and Select. Lightning has no reset option at all (you must purchase a new Lightning account if it fails). Codes apply only to new eval and new Lightning purchases."
      }
    },
    {
      "@type": "Question",
      "name": "What's the profit target for Growth $50K?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "$3,000 net profit on Growth $50K eval. Standard 6% target."
      }
    },
    {
      "@type": "Question",
      "name": "What's the profit target for Growth $00K and $50K?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "$6,000 on $00K, $9,000 on $50K. Verify exact targets on the help center."
      }
    },
    {
      "@type": "Question",
      "name": "What's the profit target for Select $25K / $50K / $00K / $50K?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Roughly $,500 / $3,000 / $6,000 / $9,000. Same as Growth pattern, verify on tradeify.co."
      }
    },
    {
      "@type": "Question",
      "name": "Does Lightning Funded have a profit target?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No eval phase target - Lightning is instant funded. The profit thresholds apply to payout eligibility on the funded side instead."
      }
    },
    {
      "@type": "Question",
      "name": "What's the minimum number of trading days to pass Select?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Select Evaluation requires a minimum of 3 trading days to pass - the lowest minimum across Tradeify plan families. Growth requires 5 or more trading days. Lightning has no evaluation phase at all (instant funded), so the trading-day minimum applies only to payout eligibility on the funded side."
      }
    },
    {
      "@type": "Question",
      "name": "Can I pass the Growth eval in one day?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No - minimum trading days requirement enforces multi-day pass even if you hit target on day 1."
      }
    },
    {
      "@type": "Question",
      "name": "Is there a time limit to pass the Tradeify evaluation?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Tradeify 3.0 evals have time windows; verify exact day count for your plan. Lightning has no eval, no time limit."
      }
    },
    {
      "@type": "Question",
      "name": "Do weekends or holidays count as trading days?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No - only days with executed trades and CME open count."
      }
    },
    {
      "@type": "Question",
      "name": "What counts as a \"trading day\"?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "A day with executed trades. Token 1-tick trades may not count toward minimum-day requirements."
      }
    },
    {
      "@type": "Question",
      "name": "What happens the moment I hit my profit target?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Eval passes once you've also met minimum trading days. The dashboard shows \"Passed\" status; you can request the funded account."
      }
    },
    {
      "@type": "Question",
      "name": "Does Tradeify use trailing or static drawdown?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Trailing during eval, static after lock. EOD-based across all plans (Select, Growth, Lightning, Builder, Flex)."
      }
    },
    {
      "@type": "Question",
      "name": "How does Tradeify EOD trailing drawdown work?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "At each day's close, the floor moves up by the day's net profit (if positive). Locks at starting balance + drawdown + $00 buffer. Once locked, becomes static."
      }
    },
    {
      "@type": "Question",
      "name": "When does my Tradeify drawdown lock and become static?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "When trailing reaches starting balance + $00. After lock, the floor stays put regardless of further profit. Significantly easier to trade post-lock."
      }
    },
    {
      "@type": "Question",
      "name": "What is the $00 buffer rule for drawdown locking?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Lock threshold = starting balance + drawdown + $00. Once you exceed this peak balance, the floor freezes."
      }
    },
    {
      "@type": "Question",
      "name": "What is the max drawdown on Growth $50K / $00K / $50K?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "$2,000 on Growth $50K, $3,500 on Growth $00K, and $5,000 on Growth $50K. Growth does not offer a $25K size - the family starts at $50K. EOD trailing drawdown locks at starting balance + drawdown + $00 buffer, then becomes static."
      }
    },
    {
      "@type": "Question",
      "name": "What is the max drawdown on Select $25K / $50K / $00K / $50K?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "$,000 on Select $25K, $2,000 on Select $50K, $3,000 on Select $00K, and $4,500 on Select $50K. EOD trailing during the evaluation phase, then locks static at starting balance + drawdown + $00 buffer once you hit peak."
      }
    },
    {
      "@type": "Question",
      "name": "What is the max drawdown on Lightning $25K / $50K / $00K / $50K?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Lightning runs tight EOD trailing drawdowns: $,250 on $25K, $2,500 on $50K, $3,750 on $00K, and $5,250 on $50K (Tradeify 3.0 figures). The daily loss limit (DLL) matches the same $,250 / $2,500 / $3,750 figures at the smaller sizes."
      }
    },
    {
      "@type": "Question",
      "name": "What happens if I hit the trailing drawdown?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Account fails immediately. Open positions auto-close. Use a free reset credit if available; otherwise pay for a reset or buy a new eval."
      }
    },
    {
      "@type": "Question",
      "name": "Does open-position P&L affect the drawdown?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No on EOD plans - only closing balance counts toward floor movement and breach."
      }
    },
    {
      "@type": "Question",
      "name": "Does Tradeify have a daily loss limit (DLL)?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Growth and Lightning have DLLs; Select doesn't on the eval phase. Verify per plan."
      }
    },
    {
      "@type": "Question",
      "name": "What are the DLL amounts for Growth accounts?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Verify on tradeify.co - typical for Growth ranges $,500-$5,000 by account size."
      }
    },
    {
      "@type": "Question",
      "name": "What are the DLL amounts for Lightning accounts?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "$,250 / $2,500 / $3,750 across $25K / $50K / $00K Lightning accounts, scaling to $5,250 on $50K. The DLL mirrors the trailing drawdown on the smaller sizes, making Lightning the tightest plan family for intraday risk."
      }
    },
    {
      "@type": "Question",
      "name": "Does Select have a daily loss limit during evaluation?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No DLL during Select eval - the trailing drawdown is the only risk gate."
      }
    },
    {
      "@type": "Question",
      "name": "Does Select have a DLL once funded?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Verify on the help center - Select Daily and Select Flex differ on DLL mechanics."
      }
    },
    {
      "@type": "Question",
      "name": "Is the DLL a soft breach or a hard fail?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Soft - hitting the DLL pauses the day, doesn't fail the account. Same as most prop firms."
      }
    },
    {
      "@type": "Question",
      "name": "When does my DLL increase to match the drawdown?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "On Lightning, after 6% profit milestone the DLL relaxes to match the drawdown amount. Post-lock, effectively a static cushion."
      }
    },
    {
      "@type": "Question",
      "name": "What is the Tradeify consistency rule?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Your best day cannot exceed a defined percentage of total profit at payout time. Growth Sim Funded uses 35%. Select Evaluation uses 40% (NONE on the Select funded side). Lightning uses graduating tiers (20% - 25% - 30% by payout count) post-September 12, 2025; older Lightning accounts remain at a flat 20%."
      }
    },
    {
      "@type": "Question",
      "name": "Is consistency 35%, 40%, or 20% - which applies?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Growth Sim Funded: 35%. Select Evaluation: 40% (no consistency rule on Select once funded). Lightning post-Sept 2025: graduating 20% / 25% / 30% by payout count. Lightning pre-Sept 2025: flat 20%. Different families use materially different rules - don't conflate them."
      }
    },
    {
      "@type": "Question",
      "name": "Did the Lightning consistency rule change in September 2025?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes - accounts purchased after September 12, 2025 use the graduating 20%/25%/30% rule. Older accounts stay at flat 20%."
      }
    },
    {
      "@type": "Question",
      "name": "Does Growth funded have a consistency rule?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes - Growth Sim Funded enforces a 35% consistency rule: your best day cannot exceed 35% of total cumulative profit at payout time. This is looser than Lightning's tiered 20/25/30% but still requires balanced trading rather than one big winning day."
      }
    },
    {
      "@type": "Question",
      "name": "What is Tradeify's profit split?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Profit split depends on the plan. Growth and Lightning: 100% to the trader on the first $5,000 cumulative profit, then 90/10 (trader/Tradeify) thereafter. Select: 90/10 from dollar one - NO 100% intro period. Elite Live: 80/20 on profits, plus 90% on starting-balance withdrawals."
      }
    },
    {
      "@type": "Question",
      "name": "How fast does Tradeify pay out?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Tradeify processes payouts 7 days a week (post-3.0) via Rise (primary) and Plane (backup). Once approved, funds typically arrive within 1-3 business days. Crypto/USDC via Rise tends to land fastest. The process is fast but variable - there is no fixed delivery guarantee."
      }
    },
    {
      "@type": "Question",
      "name": "Does Tradeify really do ultra-fast same-hour payouts?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Same-hour delivery claims are not part of official Tradeify documentation. Tradeify describes its payouts as fast processing - 7-day-a-week submissions, Rise/Plane disbursement, 1-3 business days to receipt after approval. Specific timing depends on KYC status and payout rail."
      }
    },
    {
      "@type": "Question",
      "name": "What is the minimum payout amount on Lightning?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The minimum payout is $,000 across all Tradeify plans, including Lightning. On the Lightning $25K, the minimum and maximum payout are both fixed at exactly $,000 - there is no flex on that size."
      }
    },
    {
      "@type": "Question",
      "name": "What is the minimum payout amount on Select Flex?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "$,000 minimum payout on Select Flex (the same $,000 floor applies across every Tradeify plan family). Select Flex caps each payout at 50% of the current account balance, up to $,250 per period."
      }
    },
    {
      "@type": "Question",
      "name": "What are Select Daily payout caps by account size?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Select Daily caps daily payouts at 2x net daily profit, up to a maximum of $600 per payout. The $,000 minimum payout threshold applies on top - verify exact tier behavior per account size at help.tradeify.co before relying on the cap."
      }
    },
    {
      "@type": "Question",
      "name": "What are Select Flex payout caps?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Per-cycle caps based on account size; verify on tradeify.co."
      }
    },
    {
      "@type": "Question",
      "name": "What is the Growth funded buffer for first payout?",
