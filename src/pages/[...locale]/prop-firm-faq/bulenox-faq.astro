---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import AuthorByline from "../../../components/AuthorByline.astro";
import { getLocalePaths, useTranslations, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import '../../../styles/prop-firm-faq.css';

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };
const t = useTranslations(locale);

const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const PAGE_URL = `${SITE_URL}${withSlash(localizedPath(locale, "prop-firm-faq/bulenox-faq"))}`;
const LAST_UPDATED = "2026-09-16";

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": `${SITE_URL}${withSlash(localizedPath(locale))}` },
    { "@type": "ListItem", "position": 2, "name": "Prop Firm FAQ Hub", "item": `${SITE_URL}${withSlash(localizedPath(locale, "prop-firm-faq"))}` },
    { "@type": "ListItem", "position": 3, "name": "Bulenox FAQ", "item": PAGE_URL },
  ],
};

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: t("prop_firm_faq.bulenox_hero_title"),
  description: t("prop_firm_faq.bulenox_meta_description"),
  publisher: { "@type": "Organization", name: "PickMyTrade", logo: { "@type": "ImageObject", url: `${SITE_URL}/assets/logo.png` } },
  datePublished: "2026-07-08",
  dateModified: LAST_UPDATED,
  mainEntityOfPage: { "@type": "WebPage", "@id": PAGE_URL },
};
---

<BaseLayout
  locale={locale}
  title={t("prop_firm_faq.bulenox_meta_title")}
  description={t("prop_firm_faq.bulenox_meta_description")}
  ogType="article"
  ldJson={[breadcrumbSchema, articleSchema]}
>
<div class="bg-[#001429]">
<script type="application/ld+json" is:inline>
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is Bulenox and how does it work?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Bulenox is a US-based futures prop firm running a 1-step evaluation. You pay a monthly evaluation fee, hit the profit target without breaching the EOD trailing drawdown (and a daily loss limit on Option 2), then graduate to a funded \"Master Account\" paying 100% of the first $0,000 of lifetime Master profits and 90/10 after that. Account sizes range $0K to $250K with two rule formats - Option 1 (EOD trailing, no DLL) and Option 2 (EOD trailing plus DLL). No phase 2, no consistency rule on the evaluation itself."
      }
    },
    {
      "@type": "Question",
      "name": "Who owns Bulenox and where is it based?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Bulenox LLC was registered in 2020 in Delaware, USA. Beyond the LLC filing, ownership and parent-company structure are not publicly confirmed - claims linking Bulenox to specific holding groups are unverified and should be treated as rumor until Bulenox publishes a public corporate tree. The firm positions itself as a US-domiciled alternative to offshore props. Verify the exact corporate structure on bulenox.com."
      }
    },
    {
      "@type": "Question",
      "name": "When was Bulenox founded?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Bulenox LLC was registered in Delaware in 2020 and grew its trader base through 2023-2024 with aggressive monthly promo discounts and a generous payout structure (100% on the first $0,000 of lifetime Master profits, then 90/10). By 2026 it is one of the more visible US futures props in trader forums and Trustpilot, frequently cited alongside Apex, Topstep, MFFU, and Tradeify."
      }
    },
    {
      "@type": "Question",
      "name": "Is Bulenox legit or a scam?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Legit. Trustpilot scores hover around 4.4–4.6 across 2,800+ reviews. prop firm forums and futures trader forums regularly post payout proofs. Common complaints focus on the trailing-drawdown mechanic and occasional payout delays during high-volume weeks, not on missing payouts or rugpull behavior."
      }
    },
    {
      "@type": "Question",
      "name": "Is Bulenox regulated?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No - Bulenox is a proprietary trading firm, not a regulated broker-dealer. It operates simulated funded accounts with discretionary payouts. This is the standard structure across the entire retail futures prop industry (Apex, Topstep, MFFU, Tradeify, Earn2Trade are also unregulated in the broker-dealer sense)."
      }
    },
    {
      "@type": "Question",
      "name": "What asset classes does Bulenox cover?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "CME futures only - equity index (ES, NQ, RTY, YM and their micros MES, MNQ, M2K, MYM), energies (CL, NG and micros), metals (GC, SI and micros), agriculturals, FX futures, Treasuries. No spot forex, no crypto, no equities. CME, CBOT, NYMEX, and COMEX products are tradable."
      }
    },
    {
      "@type": "Question",
      "name": "Does Bulenox accept US traders?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Bulenox is one of the few prop firms that explicitly markets itself as US-friendly across all 50 states. No KYC-blocking on US residents, full Rithmic R|Trader and NinjaTrader 8 platform access, and US-tax-form support for funded payouts."
      }
    },
    {
      "@type": "Question",
      "name": "What countries does Bulenox restrict?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Standard US-sanctions list: Iran, North Korea, Syria, Cuba, Russia, Belarus, Crimea, Venezuela. Most of Asia, Europe, LATAM, and Africa are accepted. Verify your country at the Bulenox checkout - the list updates with OFAC changes."
      }
    },
    {
      "@type": "Question",
      "name": "How many traders does Bulenox have?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Bulenox does not publish a registered-trader count. Estimates from Discord activity, Trustpilot review velocity, and prop firm forums payout-proof volume put the active funded base in the low five-figures and overall registered users in the 50K-100K range as of 2026."
      }
    },
    {
      "@type": "Question",
      "name": "Does Bulenox use simulated or real money?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Sim-funded. Both the evaluation and the funded \"Master Account\" are simulated accounts that fill against real-time CME quotes. Payouts are real cash drawn from the firm's working capital, paid based on simulated PnL. This is the universal model for futures prop firms."
      }
    },
    {
      "@type": "Question",
      "name": "What is Bulenox Option 1?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Option 1 is the \"no scaling\" Bulenox evaluation. It uses an end-of-day (EOD) trailing drawdown only - there is NO daily loss limit. The trailing line only locks in once per day at the daily settle, so intraday MFE swings do not move it. Many algo and swing-style traders pick Option 1 because the absence of a DLL gives more day-to-day flexibility, with risk capped only by the EOD trail."
      }
    },
    {
      "@type": "Question",
      "name": "What is Bulenox Option 2?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Option 2 uses the same end-of-day (EOD) trailing drawdown as Option 1 but ADDS a per-day daily loss limit ($400 on $0K, $500 on $25K, $,100 on $50K, $2,200 on $00K, $3,300 on $50K, $4,500 on $250K). The DLL caps how much realized loss you can take in a single session - once hit, trading is paused for the day. Option 2 is the structured-risk choice for traders who want a hard guardrail beneath the EOD trail."
      }
    },
    {
      "@type": "Question",
      "name": "Option 1 vs Option 2 - which is easier to pass?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Option 1 is generally easier to pass because it has no daily loss limit - only the EOD trailing drawdown gates the account. Option 2 adds a hard DLL on top of the same EOD trail, so a single rough session can pause trading even if you would have recovered later in the day. Traders who run wider intraday excursions usually prefer Option 1; traders who want a same-day kill-switch prefer Option 2."
      }
    },
    {
      "@type": "Question",
      "name": "Does Option 2 have a daily loss limit?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes - that is the defining feature of Option 2. The DLL is sized per account: $400 ($0K), $500 ($25K), $,100 ($50K), $2,200 ($00K), $3,300 ($50K), $4,500 ($250K). Option 1, by contrast, has no daily loss limit at all. If a same-day risk cap matters to you, choose Option 2; if you want maximum intraday flexibility, choose Option 1."
      }
    },
    {
      "@type": "Question",
      "name": "Which option do most traders recommend?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Prop firm forum threads in 2025-2026 lean toward Option 1 for traders who want maximum flexibility because Option 1 has no daily loss limit - only the EOD trailing drawdown can fail you. Option 2 wins for traders who want a hard same-day guardrail via its DLL. Both options share the same payout structure: 100% on the first $0,000 of lifetime Master profits, then 90/10."
      }
    },
    {
      "@type": "Question",
      "name": "Are Option 1 and Option 2 priced the same?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Pricing is approximately the same with periodic Option 2 surcharges of $5-$5/month at certain sizes. Both run on the same monthly recurring billing model. Most discount codes apply to both options. Always compare evaluation fees side-by-side at checkout because Bulenox occasionally tweaks the spread."
      }
    },
    {
      "@type": "Question",
      "name": "Can I switch from Option 1 to Option 2 mid-evaluation?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. The option is locked at purchase. To change, you must either let the current evaluation expire or buy a new one under the desired option. Funded accounts inherit the option chosen during the evaluation; you cannot toggle Option 1↔Option 2 on a Master Account."
      }
    },
    {
      "@type": "Question",
      "name": "Does Option 2 have a higher profit target?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No - both options share the same profit targets: $750 ($0K), $,500 ($25K), $3,000 ($50K), $6,000 ($00K), $9,000 ($50K), $5,000 ($250K). The trade-off is only in the risk mechanic: Option 1 is EOD trailing alone, Option 2 is EOD trailing plus a daily loss limit."
      }
    },
    {
      "@type": "Question",
      "name": "Which option works better with bots and TradingView automation?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Option 1 is the strong default for automated and TradingView-routed strategies because both options share the same EOD trailing forgiveness on intraday swings, but Option 1 has no daily loss limit. Bots that occasionally take a rough session benefit from Option 1's lack of a same-day kill-switch. PickMyTrade users running TradingView alerts to Bulenox via Rithmic frequently pick Option 1 for that reason."
      }
    },
    {
      "@type": "Question",
      "name": "Does Option 2 require longer hold times?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. Both options work for scalping, day trading, and swing trading equally - the EOD trailing in both options locks once per day at session close, regardless of holding period. You can scalp 50 trades in a day on Option 2 just like on Option 1; the only practical difference is Option 2's daily loss limit that can pause you mid-day."
      }
    },
    {
      "@type": "Question",
      "name": "Option 1 vs Option 2 - which has better payouts?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Identical. Both pay 100% on the first $0,000 of lifetime Master profits then 90/10, both honor the $,000 minimum payout, both require a 10-trading-day minimum on the Master Account before the first payout, and both pay weekly on Wednesdays. Payout methods (Wise/Deel/wire/crypto) are identical. The choice is risk-style only, not paycheck-size."
      }
    },
    {
      "@type": "Question",
      "name": "Can I run multiple Option 1 and Option 2 accounts simultaneously?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Bulenox allows up to 20 concurrent evaluation accounts per trader and you may mix Option 1 and Option 2 freely. PickMyTrade is built for this - one TradingView alert can broadcast to a stack of Option 1 and Option 2 accounts in parallel for $50/month per broker connection across all of them."
      }
    },
    {
      "@type": "Question",
      "name": "What account sizes does Bulenox offer?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Six sizes: $0K, $25K, $50K, $00K, $50K, and $250K. Each size has its own profit target, EOD trailing drawdown buffer, daily loss limit (Option 2 only), and contract-size cap. The smaller sizes are great for testing strategies; the $00K and $50K are the sweet spot for income-focused funded traders."
      }
    },
    {
      "@type": "Question",
      "name": "What is the profit target on the $0K account?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "$750 profit target on the $0K account, with a $750 EOD trailing drawdown. Option 1 has no daily loss limit; Option 2 adds a $400 DLL. Smallest entry point - popular for traders testing Bulenox rules before scaling up."
      }
    },
    {
      "@type": "Question",
      "name": "What is the profit target on the $25K account?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "$,500 profit target on the $25K account. EOD trailing drawdown $,500. Option 1 has no daily loss limit; Option 2 adds a $500 DLL. Often the best value-per-dollar Bulenox plan once you factor in periodic 80% off promo pricing."
      }
    },
    {
      "@type": "Question",
      "name": "What is the profit target on the $50K account?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "$3,000 profit target on the $50K account. EOD trailing drawdown $2,500. Option 1 has no daily loss limit; Option 2 adds a $,100 DLL. Contract size cap typically 10 minis / 100 micros. Mid-range plan that balances size, fee, and target."
      }
    },
    {
      "@type": "Question",
      "name": "What is the profit target on the $00K account?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "$6,000 profit target on the $00K account. EOD trailing drawdown $3,000. Option 1 has no daily loss limit; Option 2 adds a $2,200 DLL. Contract size cap typically 12-15 minis. The most popular size on prop firm forums Bulenox payout posts in 2026."
      }
    },
    {
      "@type": "Question",
      "name": "What is the profit target on the $50K account?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "$9,000 profit target on the $50K account. EOD trailing drawdown $4,500. Option 1 has no daily loss limit; Option 2 adds a $3,300 DLL. Larger contract caps (around 15 minis). Better fee-to-buying-power ratio than $250K for most traders."
      }
    },
    {
      "@type": "Question",
      "name": "What is the profit target on the $250K account?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "$5,000 profit target on the $250K account. EOD trailing drawdown $5,500. Option 1 has no daily loss limit; Option 2 adds a $4,500 DLL. Highest evaluation fee but unlocks the largest contract caps. Best for established traders who already have a proven scaling-friendly edge."
      }
    },
    {
      "@type": "Question",
      "name": "Can I run multiple sizes at once?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Up to 20 evaluation accounts per trader, mixing sizes freely. PickMyTrade lets one TradingView alert hit, say, three $50Ks plus two $00Ks plus one $250K simultaneously through a single TradingView signal - at the same $50/month per broker connection PMT subscription."
      }
    },
    {
      "@type": "Question",
      "name": "Which size has the best math?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "For most traders, $50K and $00K offer the best target-to-fee ratio. The $25K is fine for testing but pays out slowly; $250K has the highest absolute payouts but the steepest fee. Run the math at promo pricing - Bulenox's recurring 80% off codes flip the answer toward the smaller sizes."
      }
    },
    {
      "@type": "Question",
      "name": "Are there any plans larger than $250K?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No - $250K is the largest single Bulenox account. To scale beyond, traders run multiple Master Accounts in parallel (up to 20) which effectively gives a $5M+ aggregate buying power footprint. Bulenox does not currently offer a $500K or $M single-account product."
      }
    },
    {
      "@type": "Question",
      "name": "How is Bulenox billed - one-time or monthly?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Monthly recurring. The evaluation runs on a monthly subscription that auto-renews until you pass, fail, or cancel. Once funded, the Master Account itself has no monthly fee - only the underlying Rithmic data fees may apply (free retail non-pro; ~$30/mo for pro)."
      }
    },
    {
      "@type": "Question",
      "name": "What does a Bulenox $50K cost at full price?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Approximately $15-$35 per month at list price (Option 1 vs Option 2 differ slightly). Bulenox almost never sells at full retail - promo codes typically take effective monthly pricing into the $25-$45 range for the same size."
      }
    },
    {
      "@type": "Question",
      "name": "Are there discount codes for Bulenox?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Bulenox runs near-continuous monthly promotions on its Discord, Twitter, and affiliate network. Typical structure is 80% off the first month or 80% off recurring for the life of the evaluation. Codes rotate; check prop firm forums \"deals\" threads or the Bulenox Discord on the 1st of each month."
      }
    },
    {
      "@type": "Question",
      "name": "Does Bulenox offer recurring discounts (life of subscription)?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes - recurring 80% off codes are a Bulenox signature offer. They lock the discounted rate as long as you keep the same evaluation active. Recurring codes are more valuable than first-month-only codes for traders expecting a 2-3 month evaluation period."
      }
    },
    {
      "@type": "Question",
      "name": "Is there an activation or upgrade fee on the Master Account?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes - the activation fee is tiered by account size: roughly $98 ($0K), $30 ($25K), $220 ($50K), $300 ($00K), $400 ($50K), and $490 ($250K). It is paid once per evaluation when upgrading to the Master Account and unlocks live payout eligibility. The fee is not refundable on Master Account close."
      }
    },
    {
      "@type": "Question",
      "name": "Are there hidden fees beyond the evaluation cost?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Three known costs: (1) the monthly evaluation subscription, (2) the one-time tiered activation fee on the Master Account (~$98 on $0K up to ~$490 on $250K), (3) optional CME live data fees if your platform requires non-bundled data. Reset fees apply if you want to restart a failed evaluation without buying a new one."
      }
    },
    {
      "@type": "Question",
      "name": "Can I pay with crypto?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes - Bulenox accepts crypto via NOWPayments alongside Visa/Mastercard. BTC, ETH, USDT (TRC20/ERC20), and USDC are commonly supported. Crypto sometimes unlocks additional 5% off codes during promo windows."
      }
    },
    {
      "@type": "Question",
      "name": "Are evaluation refunds offered?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Bulenox follows the standard prop firm \"no refund after first trade\" policy. If you have placed a single trade on the evaluation, refunds are not given. Pre-trade cancellations within a short window (verify the exact term in TOS) may be honored on a discretionary basis."
      }
    },
    {
      "@type": "Question",
      "name": "Does Bulenox tax-document funded traders?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "For US-resident funded traders, Bulenox issues 1099-NEC forms when annual payouts cross $600. Non-US traders receive payout records but are responsible for self-reporting under their local tax regime. Consult a tax professional - payout characterization (self-employment vs. trading income) varies by jurisdiction."
      }
    },
    {
      "@type": "Question",
      "name": "Can I stack multiple promo codes?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No - Bulenox checkout accepts only one code per purchase. Always compare available active codes (recurring 80% off vs. first-month-90% off vs. crypto-bonus 5%) and pick the highest cumulative value over your expected evaluation duration."
      }
    },
    {
      "@type": "Question",
      "name": "How does Option 1 trailing drawdown work?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Option 1 uses an end-of-day (EOD) trailing drawdown. The trail locks in once per day at the daily settle based on settled balance, not on intraday ticks. As the settled balance hits new daily highs, the drawdown line moves up. Once your EOD balance reaches the initial-balance level, the trail locks at the initial balance. No daily loss limit applies on Option 1."
      }
    },
    {
      "@type": "Question",
      "name": "What are Option 1 trailing drawdown values per size?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Option 1 EOD trailing values: $0K - $750, $25K - $,500, $50K - $2,500, $00K - $3,000, $50K - $4,500, $250K - $5,500. The $00K and $50K accounts share an unusually similar dollar buffer - the $50K offers more contracts at a similar trailing cap. These values are identical to Option 2; the only difference between the options is the presence of the DLL on Option 2."
      }
    },
    {
      "@type": "Question",
      "name": "When does the Option 1 trailing drawdown stop trailing?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "It locks once your EOD settled balance hits the initial-balance level. From that point forward, the drawdown line is fixed at the original starting balance, giving you a permanent buffer of [profit target + trailing amount] above breach. This is the moment of \"drawdown lock\" that Bulenox traders celebrate."
      }
    },
    {
      "@type": "Question",
      "name": "Does Option 1 trail on closed or unrealized PnL?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Closed/settled - Option 1 measures the trail at the EOD settle. If you go up $,200 unrealized intraday then come back to flat by close, the trailing line did not move because only the settled end-of-day balance is used. This is why Option 1 is forgiving on intraday MFE giveback compared with intraday-tracking firms like Apex."
      }
    },
    {
      "@type": "Question",
      "name": "What happens if I breach the Option 1 trailing drawdown?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Account is failed immediately. On the evaluation, you can buy a reset (or a new evaluation) and try again. On the funded Master Account, breach is terminal - the Master Account closes and you must re-evaluate from scratch to regain funded status."
      }
    },
    {
      "@type": "Question",
      "name": "Does Option 2 daily loss limit reset overnight?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Option 1 has no daily loss limit at all. On Option 2, the DLL resets at the daily session boundary (typically 5pm CT US futures close). A bad day caps your loss at the DLL - overnight, the limit refreshes to the full DLL amount the next day. The EOD trailing drawdown does NOT reset; it persists across days on both options."
      }
    },
    {
      "@type": "Question",
      "name": "How do I monitor my live trailing drawdown level?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The Bulenox dashboard shows current trailing line, daily loss buffer (on Option 2), and live equity. Rithmic R|Trader and NinjaTrader 8 risk panels also display live PnL distance from the EOD trailing line. Many traders run a TradingView Pine alert to ping when daily PnL approaches the trail."
      }
    },
    {
      "@type": "Question",
      "name": "Is Option 1 better for tight-stop scalpers?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Option 1 works well for any style - tight scalping, day trading, or swing entries - because its EOD trailing forgives intraday MFE giveback and there is no DLL to interrupt your day. Tight-stop scalpers may actually prefer Option 2 because the DLL provides a hard kill-switch if a losing streak compounds."
      }
    },
    {
      "@type": "Question",
      "name": "Does Option 1 have a profit lock-in cushion after passing?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Once the trailing locks at initial balance, your buffer = [profit target + trailing amount]. So a $50K Option 1 with $3,000 target + $2,500 trail provides a $5,500 buffer above breach once locked. The drawdown will never trail higher than the initial balance - that is the cushion."
      }
    },
    {
      "@type": "Question",
      "name": "Does PMT have an Option 1 trailing-aware feature?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "For daily and weekly profit/loss limits on Bulenox prop firm accounts, set these directly in your broker or Rithmic settings where available. PMT's own daily/weekly limit settings work only on personal/demo Tradovate accounts, not prop firm accounts. As a best practice, always use TP and SL on every trade as your primary risk control."
      }
    },
    {
      "@type": "Question",
      "name": "How does the Option 2 EOD trailing drawdown work?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Option 2 uses the same EOD trailing drawdown as Option 1 - the trail locks once per day at session close based on settled end-of-day balance, not intraday ticks. The distinction from Option 1 is that Option 2 ALSO enforces a daily loss limit per session. Intraday MFE swings do not move the trailing line on either option; only the daily settle matters for the trail."
      }
    },
    {
