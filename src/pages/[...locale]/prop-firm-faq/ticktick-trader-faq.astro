---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import AuthorByline from "../../../components/AuthorByline.astro";
import { getLocalePaths, useTranslations, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import '../../../styles/prop-firm-faq.css';

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };
const t = useTranslations(locale);

const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const PAGE_URL = `${SITE_URL}${withSlash(localizedPath(locale, "prop-firm-faq/ticktick-trader-faq"))}`;
const LAST_UPDATED = "2026-09-16";

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": `${SITE_URL}${withSlash(localizedPath(locale))}` },
    { "@type": "ListItem", "position": 2, "name": "Prop Firm FAQ Hub", "item": `${SITE_URL}${withSlash(localizedPath(locale, "prop-firm-faq"))}` },
    { "@type": "ListItem", "position": 3, "name": "TickTick Trader FAQ", "item": PAGE_URL },
  ],
};

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: t("prop_firm_faq.ticktick_hero_title"),
  description: t("prop_firm_faq.ticktick_trader_meta_description"),
  publisher: { "@type": "Organization", name: "PickMyTrade", logo: { "@type": "ImageObject", url: `${SITE_URL}/assets/logo.png` } },
  datePublished: "2026-07-08",
  dateModified: LAST_UPDATED,
  mainEntityOfPage: { "@type": "WebPage", "@id": PAGE_URL },
};
---

<BaseLayout
  locale={locale}
  title={t("prop_firm_faq.ticktick_trader_meta_title")}
  description={t("prop_firm_faq.ticktick_trader_meta_description")}
  ogType="article"
  ldJson={[breadcrumbSchema, articleSchema]}
>
<script type="application/ld+json" id="faq-schema">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {"@type":"Question","name":"What is TickTickTrader and how does it work?","acceptedAnswer":{"@type":"Answer","text":"TickTickTrader (TTT) is a futures-only prop firm launched in early 2022. You either pass a one-step evaluation (TTTPerformance) or buy a Direct (instant-funded) account (TTTDirect / S2F+). Hit profit targets and follow rules to earn payouts. After 6 successful payouts in the SIM phase, qualified traders transition to a live funded account."}},
    {"@type":"Question","name":"Is TickTickTrader legit or a scam in 2026?","acceptedAnswer":{"@type":"Answer","text":"Legit. TTT carries a ~4.7-4.8/5 Trustpilot rating across 6,000-6,300+ reviews (May 2026), has been operating since February 2022, pays through Rise, and now runs exclusively on Rithmic-based platforms (NinjaTrader, Quantower, Sierra Chart, R|Trader Pro) after losing Tradovate (Nov 2025 migration to ProjectX) and ProjectX (Feb 2026 Topstep exclusivity). Some commentary suggests TTT is in operational difficulty post-platform-loss - verify current status on tickticktrader.com before funding."}},
    {"@type":"Question","name":"Who owns TickTickTrader and where is it based?","acceptedAnswer":{"@type":"Answer","text":"Gerardo Tolivia Mariscal is publicly identified as CEO/Founder of TickTickTrader. The operating entity is UAB TickTickTrader, registered in Lithuania. The TTT group also maintains a corporate presence in Romania (Bucharest) and Douglas, Isle of Man. The firm is privately held."}},
    {"@type":"Question","name":"What's the difference between TTTPerformance and TTTDirect?","acceptedAnswer":{"@type":"Answer","text":"TTTPerformance = evaluation path (you pass a one-step eval, then graduate to a sim-funded performance account). TTTDirect = instant-funding (you skip the eval, pay a one-time fee, start trading toward payouts immediately). Different consistency rules, different splits, different drawdown logic."}},
    {"@type":"Question","name":"What is S2F+?","acceptedAnswer":{"@type":"Answer","text":"S2F+ is TTT's instant-funding model launched July 23, 2025 (originally on Tradovate and ProjectX). After TTT lost Tradovate (Nov 2025) and ProjectX (Feb 2026), S2F+ now runs on Rithmic-based platforms only. No consistency rule. Uses a Profit Score (PS) system: 1 point per day with PnL ≥ 0.5% of account size, payout at PS≥10 first, then PS≥7 thereafter. Payout split: 50% cash + 40% live wallet + 10% commission."}},
    {"@type":"Question","name":"What kind of drawdown does TTT use?","acceptedAnswer":{"@type":"Answer","text":"Two types depending on plan. Evaluation accounts use a tick-based trailing drawdown that locks (becomes static) once you reach breakeven plus the buffer. TTTDirect uses an end-of-day trailing drawdown - only realized closing balances move it."}},
    {"@type":"Question","name":"What is the consistency rule on TTTPerformance accounts?","acceptedAnswer":{"@type":"Answer","text":"30% rule. Your largest single profit day cannot exceed 30% of total accumulated profits when you request a payout. Designed to prevent one-shot lottery wins."}},
    {"@type":"Question","name":"What is the consistency rule on TTTDirect accounts?","acceptedAnswer":{"@type":"Answer","text":"20% rule. Stricter than Performance. Your biggest day cannot exceed 20% of total profits at payout request."}},
    {"@type":"Question","name":"What platforms does TTT support?","acceptedAnswer":{"@type":"Answer","text":"Rithmic-based platforms only (May 2026): NinjaTrader, Quantower, Sierra Chart, R|Trader Pro, MultiCharts, Jigsaw DayTradr, Bookmap, Photon Trader, and CQG. TTT lost Tradovate access in November 2025 and ProjectX in February 2026."}},
    {"@type":"Question","name":"Can I automate TradingView alerts to a TTT (Rithmic) account via PickMyTrade?","acceptedAnswer":{"@type":"Answer","text":"Yes. PickMyTrade routes TradingView alerts to your TTT Rithmic account via a webhook bridge. TTT generally allows automation via webhook bridges (the firm-wide bans target HFT/sub-second algos and cross-trader copy services, not all automation). Best practice: confirm your specific automation pattern with TTT support before deploying."}}
  ]
}
</script>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {"@type": "ListItem", "position": 1, "name": "Home", "item": "https://pickmytrade.trade/"},
    {"@type": "ListItem", "position": 2, "name": "Prop Firm FAQ Hub", "item": "https://pickmytrade.trade/prop-firm-faq/"},
    {"@type": "ListItem", "position": 3, "name": "TickTickTrader FAQ", "item": "https://pickmytrade.trade/prop-firm-faq/ticktick-trader-faq/"}
  ]
}
</script>

