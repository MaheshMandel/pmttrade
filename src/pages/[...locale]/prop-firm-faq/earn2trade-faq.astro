---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import AuthorByline from "../../../components/AuthorByline.astro";
import { getLocalePaths, useTranslations, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import '../../../styles/prop-firm-faq.css';

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };
const t = useTranslations(locale);

const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const PAGE_URL = `${SITE_URL}${withSlash(localizedPath(locale, "prop-firm-faq/earn2trade-faq"))}`;
const LAST_UPDATED = "2026-09-16";

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": `${SITE_URL}${withSlash(localizedPath(locale))}` },
    { "@type": "ListItem", "position": 2, "name": "Prop Firm FAQ Hub", "item": `${SITE_URL}${withSlash(localizedPath(locale, "prop-firm-faq"))}` },
    { "@type": "ListItem", "position": 3, "name": "Earn2Trade FAQ", "item": PAGE_URL },
  ],
};

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: t("prop_firm_faq.earn2trade_hero_title"),
  description: t("prop_firm_faq.earn2trade_meta_description"),
  publisher: { "@type": "Organization", name: "PickMyTrade", logo: { "@type": "ImageObject", url: `${SITE_URL}/assets/logo.png` } },
  datePublished: "2026-07-08",
  dateModified: LAST_UPDATED,
  mainEntityOfPage: { "@type": "WebPage", "@id": PAGE_URL },
};
---

<BaseLayout
  locale={locale}
  title={t("prop_firm_faq.earn2trade_meta_title")}
  description={t("prop_firm_faq.earn2trade_meta_description")}
  ogType="article"
  ldJson={[breadcrumbSchema, articleSchema]}
>
<script type="application/ld+json" is:inline>
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is Earn2Trade and how does the funded futures program work?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Earn2Trade is a US futures prop firm and trading education company founded in 2016. You pay a monthly subscription, take either the Gauntlet Mini (one-step) or the Trader Career Path (with built-in scaling), hit a 6% profit target with at least 10 trading days while respecting the EOD drawdown and consistency rule, then receive a guaranteed funding offer from one of two prop trading partners (Helios Trading Partners in the US, Appius Trading Limited in the UK). 80/20 profit split in your favor."
      }
    },
    {
      "@type": "Question",
      "name": "When was Earn2Trade founded and how long has it been operating?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Founded 2016 by Ryan Masten and David Lojko. Roughly a decade of operation as of 2026 - one of the older retail futures prop firms, predating most of the 2020-2024 wave."
      }
    },
    {
      "@type": "Question",
      "name": "Where is Earn2Trade headquartered?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Sheridan, Wyoming, USA. The funded prop trading is handled through partner firms - Helios Trading Partners (US) and Appius Trading Limited (UK)."
      }
    },
    {
      "@type": "Question",
      "name": "Who runs Earn2Trade today?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "David Lojko, who has managed the company since April 2019. Co-founder Ryan Masten departed in July 2020."
      }
    },
    {
      "@type": "Question",
      "name": "Is Earn2Trade legit or a scam?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Legit. ~4.7/5 on Trustpilot from roughly 4,700+ reviews. Withdrawals process weekly via Rise (with ACH, Wise, or local bank rails underneath) or direct crypto. Earn2Trade itself does not publish a public pass-rate statistic - older third-party numbers are not officially confirmed. Largest complaints in 2026 are about the 80/20 split being lower than Apex's 90% and the consistency rule feeling restrictive - not about payout integrity."
      }
    },
    {
      "@type": "Question",
      "name": "Who is Helios Trading Partners?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Helios Trading Partners LLC is the US-based proprietary trading firm that funds traders who pass Earn2Trade's evaluations. Helios was established in 2016 by the same owners as Earn2Trade - they are affiliated entities under shared ownership, not arms-length partners. Your funded contract is signed with Helios (or Appius for some non-US traders), not directly with Earn2Trade."
      }
    },
    {
      "@type": "Question",
      "name": "Who is Appius Trading Limited?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "UK-based prop trading firm that's the second funding partner alongside Helios. Some non-US traders are routed to Appius depending on geography and regulatory fit."
      }
    },
    {
      "@type": "Question",
      "name": "Is Earn2Trade regulated?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Earn2Trade is an education and evaluation company - not a regulated broker. Its prop trading partners (Helios, Appius) operate as proprietary trading firms, which in the US sit outside the retail-broker regulatory perimeter (no SIPC, no FINRA broker-dealer status). Standard for the prop firm industry."
      }
    },
    {
      "@type": "Question",
      "name": "What's Earn2Trade's Trustpilot rating?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "~4.7 out of 5 from roughly 4,700+ reviews as of 2026 (some snapshots show 4.6) - among the highest of any major futures prop firm. Reviews consistently praise customer support (specific names like Ikbal, Ayush, Ysmarlin appear repeatedly) and payout reliability."
      }
    },
    {
      "@type": "Question",
      "name": "Does Earn2Trade publish pass-rate statistics?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Earn2Trade does not publish pass-rate statistics for the TCP or Gauntlet Mini. Older third-party blog posts cite specific percentages (such as 8.89% or 10.42%), but those numbers do not appear in current Earn2Trade help center articles or official communications - treat them as unverified. The firm's own messaging focuses on the funded-trader experience rather than pass-rate marketing."
      }
    },
    {
      "@type": "Question",
      "name": "What is the Trader Career Path (TCP)?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The Trader Career Path is Earn2Trade's signature evaluation with a built-in scaling plan. You pass once, then grow your account through defined stages by hitting profit targets at each level - up to a maximum $200K (TCP25) or $400K (TCP50/TCP100) without taking another evaluation. Free monthly resets included with active subscription."
      }
    },
    {
      "@type": "Question",
      "name": "What is the Gauntlet Mini?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The Gauntlet Mini is Earn2Trade's one-step intraday futures evaluation. 6% profit target, 10-day minimum, EOD drawdown. Pass and you're funded - but unlike TCP there's no built-in scaling plan, just immediate access to a single funded account size."
      }
    },
    {
      "@type": "Question",
      "name": "What is the original Gauntlet (not Mini)?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The original Gauntlet is the multi-stage evaluation tied to the Bootcamp education program - a 4-month structured course with weekly mentorship and webinars culminating in a longer Gauntlet examination. Most active retail traders today take the Gauntlet Mini or TCP because they're faster and don't bundle education they may not need."
      }
    },
    {
      "@type": "Question",
      "name": "Is the original Gauntlet still available?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "It exists as part of the Bootcamp bundle (~$2,499 one-time). Standalone Gauntlet purchases are rare today - Earn2Trade actively promotes TCP and Gauntlet Mini as the primary funding paths for traders who don't need the full education curriculum."
      }
    },
    {
      "@type": "Question",
      "name": "TCP vs Gauntlet Mini - which should I choose?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Choose TCP if you want a long-term scaling path to $400K with the same plan. Choose Gauntlet Mini if you want the largest single-account size right out of the gate (up to $200K) without a scaling commitment. Both share rules; the difference is structural - TCP grows you incrementally, Gauntlet Mini hands you the size up front."
      }
    },
    {
      "@type": "Question",
      "name": "Can I switch between TCP and Gauntlet Mini?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "You can cancel one and start the other, but you can't directly migrate active progress. Each evaluation is its own subscription. Most traders pick one and stick with it."
      }
    },
    {
      "@type": "Question",
      "name": "Can I run multiple Earn2Trade accounts?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes - multiple subscriptions are allowed. But Earn2Trade's prohibited-conduct rules ban coordinating accounts to manipulate or hedge across them. Each account must be independently traded."
      }
    },
    {
      "@type": "Question",
      "name": "Is the Gauntlet Mini a one-step or two-step evaluation?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "One-step. Hit 6% profit, do 10+ trading days, follow the rules - and you're done. No second-stage verification phase like FTMO-style forex props."
      }
    },
    {
      "@type": "Question",
      "name": "Is the TCP also one-step?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes - the TCP evaluation is one-step. The \"career path\" multi-stage structure kicks in after you pass and become funded, where you scale up by hitting profit targets at each tier and withdrawing your share."
      }
    },
    {
      "@type": "Question",
      "name": "Is there a time limit on the evaluation?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No fixed deadline. Your subscription renews monthly until you pass, fail beyond reset, or cancel. Take as long as you need - though longer means more monthly fees."
      }
    },
    {
      "@type": "Question",
      "name": "What happens if I pass the evaluation?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "You get a funding offer email from the prop firm partner (Helios or Appius). You sign their funded trader agreement, choose between a Live or LiveSim account, complete KYC, and start trading. Setup is ~2 business days for LiveSim, up to 10 days for Live."
      }
    },
    {
      "@type": "Question",
      "name": "What happens if I fail the evaluation?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Use your free monthly reset (one included per billing cycle) and start over. Or buy a paid reset (price varies by account size - see the Fees section). Or cancel and start a new evaluation later."
      }
    },
    {
      "@type": "Question",
      "name": "What account sizes does the Trader Career Path offer?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "TCP25 ($25,000), TCP50 ($50,000), and TCP100 ($00,000) starting capital - named after the starting size in thousands."
      }
    },
    {
      "@type": "Question",
      "name": "What account sizes does the Gauntlet Mini offer?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "GAU25 ($25,000), GAU50 ($50,000), GAU100 ($00,000), GAU150 ($50,000), and GAU200 ($200,000) - five sizes in total. The Gauntlet Mini matches TCP at the lower end and extends past TCP entry sizes at the top. TCP starts smaller but grows further via scaling."
      }
    },
    {
      "@type": "Question",
      "name": "What's the profit target on each account?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "6% of starting capital, applied uniformly across both TCP and Gauntlet Mini. TCP25 / GAU25 = $,500, TCP50 / GAU50 = $3,000, TCP100 / GAU100 = $6,000, GAU150 = $9,000, GAU200 = $2,000."
      }
    },
    {
      "@type": "Question",
      "name": "Is the profit target a flat 6% or does it vary?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Flat 6% across all TCP and Gauntlet Mini account sizes - same percentage applied to whatever starting balance you choose. TCP scaling stages also hit 6% at the $200K rung ($2,000 target). The $400K stage uses a fixed-drawdown structure with its own documented target - verify the current number on help.earn2trade.com before assuming, as it has shifted across plan revisions."
      }
    },
    {
      "@type": "Question",
      "name": "What's the maximum account size with TCP25?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "$200,000. TCP25 scaling: $25K - $50K - $00K - $200K. The TCP25 plan does not access the $400K tier - only TCP50 and TCP100 do."
      }
    },
    {
      "@type": "Question",
      "name": "What's the maximum account size with TCP50?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "$400,000. TCP50 scaling: $50K - $00K - $200K - $400K."
      }
    },
    {
      "@type": "Question",
      "name": "What's the maximum account size with TCP100?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "$400,000. TCP100 scaling: $00K - $50K - $200K - $400K. Same $400K cap as TCP50, but TCP100 starts higher and progresses through different intermediate stages."
      }
    },
    {
      "@type": "Question",
      "name": "What's the largest funded account I can ever get on Earn2Trade?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "$400,000 - reachable only through TCP50 or TCP100 scaling. The Gauntlet Mini caps at $200K because it has no built-in scaling structure. To go above $200K via Earn2Trade you must be on the TCP path."
      }
    },
    {
      "@type": "Question",
      "name": "What's the profit target at higher TCP scaling stages?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "$50K stage = $9,000 (6%). $200K stage = $2,000 (6%). $400K stage = a fixed-drawdown stage with its own documented target - refer to help.earn2trade.com for the current value, as Earn2Trade has revised it across plan iterations."
      }
    },
    {
      "@type": "Question",
      "name": "Is there a starter account smaller than $25K?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. $25K (TCP25) is the smallest evaluation account at Earn2Trade. Apex offers a $25K account too; Topstep starts at $50K."
      }
    },
    {
      "@type": "Question",
      "name": "What types of drawdown does Earn2Trade use?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "End-of-Day (EOD) drawdown across the board - evaluation, LiveSim, and Live funded accounts all use the same EOD model. The top TCP scaling stage uses a fixed-drawdown variant where the floor stops trailing once the account reaches its maximum size. Earn2Trade does not run an intraday trailing drawdown like Apex or Topstep - that is one of the firm's headline differentiators."
      }
    },
    {
      "@type": "Question",
      "name": "What is EOD drawdown?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "End-of-Day drawdown calculates your minimum balance based on closed positions at the end of each trading day. Intraday dips don't count - only your closed-trade end-of-day balance does. Big advantage: you can ride out wide MAE on a winning trade without busting drawdown, as long as you close the day above the floor."
      }
    },
    {
      "@type": "Question",
      "name": "Does Earn2Trade use a trailing (intraday) drawdown?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. Earn2Trade does not apply an intraday trailing drawdown on any account type - evaluation, LiveSim, and Live all use End-of-Day drawdown. Intraday equity dips never count against you while a position is open. This is a key contrast versus Apex or Topstep, where trailing drawdowns follow peak intraday equity tick-by-tick."
      }
    },
    {
      "@type": "Question",
      "name": "What is fixed drawdown on Earn2Trade?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Fixed drawdown means the EOD drawdown floor stops trailing your high-water mark and locks in place once you reach the top scaling tier. It's used on the largest TCP scaling stage so the floor doesn't keep ratcheting up as you continue compounding. Earn2Trade documents the exact dollar floor in help.earn2trade.com - verify the current value there before sizing, as it has changed across plan revisions."
      }
    },
    {
      "@type": "Question",
      "name": "What's the EOD drawdown amount on each account?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "TCP25 / GAU25: $,500. TCP50 / GAU50: $2,000. TCP100 / GAU100: $3,500 (same on both programs). GAU150: $4,500. GAU200: $6,000. These amounts apply consistently across evaluation, LiveSim, and Live accounts at the corresponding size."
      }
    },
    {
      "@type": "Question",
      "name": "What's the daily loss limit?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "TCP25: $550. TCP50/GAU50: $,100. TCP100/GAU100: $2,200. GAU150: $3,300. GAU200: $4,400. $50K scaled stage: $3,300. $200K scaled stage: $4,400. $400K scaled stage: $8,800. Hit or exceed the daily loss in a single trading day and the account fails for that day's session (rules vary by stage)."
      }
    },
    {
      "@type": "Question",
      "name": "Does the EOD drawdown ratchet up as I profit?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. EOD drawdown trails your highest end-of-day account balance - as the EOD balance climbs, the floor climbs with it (drawdown amount stays constant; floor moves up). Once the floor exceeds your starting balance, you're effectively locked above breakeven."
      }
    },
    {
      "@type": "Question",
      "name": "Does Earn2Trade's drawdown stop trailing once I'm profitable?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Earn2Trade's drawdown is EOD-only, so there is no intraday trailing to stop. The end-of-day floor ratchets up with your best closed-day balance (drawdown distance stays constant; floor rises). It locks in place permanently when you reach the top TCP scaling stage, which uses the fixed-drawdown variant."
      }
    },
    {
      "@type": "Question",
      "name": "What happens when I hit the daily loss limit?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Account is locked from trading for the rest of that day. On evaluation, this resets at next trading day's open. On funded accounts, repeated DLL breaches can trigger account closure depending on Helios/Appius's funded trader agreement."
      }
    },
    {
      "@type": "Question",
      "name": "What happens when I bust the EOD drawdown?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Account fails. On evaluation, you can use your free monthly reset (or buy a paid reset) to start over. On a funded LiveSim/Live account, busting drawdown closes the account and you'd need to take a new evaluation."
      }
    },
    {
      "@type": "Question",
      "name": "Why is Earn2Trade's EOD drawdown friendlier than competitors' trailing models?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "EOD only counts your end-of-day closed balance. Intraday dips on a winning trade don't matter. At firms with trailing drawdown (Apex, Topstep), every tick of give-back can erode your floor - drop $500 of unrealized profit and the floor drops $500. EOD lets you hold runners through pullbacks; trailing punishes you for it."
      }
    },
    {
      "@type": "Question",
      "name": "Does open equity matter for EOD drawdown?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes - open equity matters for the daily loss limit and intraday account-termination logic, but not for the EOD drawdown calculation itself. Open equity at end-of-day is rolled into the next day's starting balance after positions close (which can't happen on evaluation accounts because overnight is banned)."
      }
    },
    {
      "@type": "Question",
      "name": "Does Earn2Trade have trailing drawdown on any account type?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. Earn2Trade applies End-of-Day drawdown to evaluation, LiveSim, and Live accounts at every size. There is no intraday trailing model anywhere in the product line. Older third-party blog posts that describe Earn2Trade as having a trailing-drawdown variant are out of date - confirm against help.earn2trade.com if in doubt."
      }
    },
    {
      "@type": "Question",
      "name": "Is the drawdown the same in evaluation and on the funded LiveSim account?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes - both evaluation and LiveSim use EOD drawdown with the same dollar amount as the corresponding evaluation tier. This is by design, so the rules don't change when you cross from \"evaluating\" to \"funded LiveSim.\""
      }
    },
    {
      "@type": "Question",
      "name": "What is the Maintain Consistency rule?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No single trading day can account for 30% or more of your total cumulative PnL during the evaluation. Designed to prevent passing on a single lucky session. Applies to TCP and Gauntlet Mini evaluations only - not to LiveSim or Live funded accounts."
      }
    },
    {
      "@type": "Question",
      "name": "What happens if I break the consistency rule?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "You don't fail. You just need to keep trading and add more profit until that big day represents less than 30% of your cumulative profits. Example: a $,200 single-day profit means you need at least $4,000 total profit before you can pass ($,200 ÷ 0.30 = $4,000)."
      }
    },
    {
      "@type": "Question",
      "name": "Does the consistency rule apply to losing days too?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes - daily PnL counts both directions toward the 30% rule. A massive losing day that's 30%+ of your absolute PnL counts. Most traders only encounter the rule via outsized winning days."
      }
    },
    {
      "@type": "Question",
      "name": "Is the consistency rule the same as the 50% rule on other firms?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No - Earn2Trade's threshold is tighter at 30%, vs Topstep's payout-time consistency check. Apex doesn't have a hard consistency rule on evaluation. Earn2Trade's rule is one of the stricter consistency requirements in the futures-prop industry."
      }
    },
    {
      "@type": "Question",
      "name": "Does the consistency rule apply once I'm funded?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. LiveSim and Live funded accounts have no consistency rule. The rule is purely an evaluation gate."
      }
    },
    {
      "@type": "Question",
      "name": "What is the Progression Ladder?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "A self-regulation rule that limits the number of contracts you can open based on your current account balance / profit level. The idea: you \"earn\" the right to size up by being green. Encourages disciplined sizing rather than maxing out from day one."
      }
    },
    {
      "@type": "Question",
      "name": "How does the Progression Ladder work on a $50K account?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "On a $50,000 account: 2 contracts at start. Above $,500-$2,000 in profits: 4 contracts. Above $2,000 in profits: 6 contracts (the max for the $50K tier)."
      }
    },
    {
      "@type": "Question",
      "name": "What's the maximum contract count on each tier?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "TCP25: 3 contracts max. TCP50/GAU50: 6. TCP100/GAU100: 12. GAU150: 15. GAU200: 16. Higher TCP scaling stages have proportionally larger max sizing."
      }
    },
    {
      "@type": "Question",
      "name": "How are micro contracts counted toward the Progression Ladder?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Up to 10 micros count as 1 ladder contract. Eligible micros include MES, MNQ, MYM, M2K, MGC, MCL, M6E, MHG, M6B. Example: if your ladder allows 3 contracts you could trade 3 ES, or 2 ES + 10 MES, or 1 ES + 20 MES, or 30 MES."
      }
    },
    {
      "@type": "Question",
      "name": "What happens if I exceed the Progression Ladder?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Account is blocked from trading for the rest of that day. The block is automatically lifted at next market close - you don't have to reset, you just can't trade for the remainder of the day. Continue normally next session."
      }
    },
    {
      "@type": "Question",
      "name": "Are EAs / automated bots allowed?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Always check Earn2Trade's official website for their current compliance guidelines on automated trading. Many PickMyTrade customers use automation on their Earn2Trade accounts — a small amount of risk is involved."
      }
    },
    {
      "@type": "Question",
      "name": "Is copy trading allowed across multiple accounts?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Always check Earn2Trade's official website for their current compliance guidelines on copy trading and multi-account setups. PickMyTrade supports one alert firing to multiple connected accounts simultaneously with per-account quantity multipliers."
      }
    },
    {
      "@type": "Question",
      "name": "What other conduct is prohibited?",
      "acceptedAnswer": {
        "@type": "Answer",
