---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import AuthorByline from "../../../components/AuthorByline.astro";
import { getLocalePaths, useTranslations, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import '../../../styles/prop-firm-faq.css';

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };
const t = useTranslations(locale);

const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const PAGE_URL = `${SITE_URL}${withSlash(localizedPath(locale, "prop-firm-faq/myfundedfutures-faq"))}`;
const LAST_UPDATED = "2026-10-06";

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": `${SITE_URL}${withSlash(localizedPath(locale))}` },
    { "@type": "ListItem", "position": 2, "name": "Prop Firm FAQ Hub", "item": `${SITE_URL}${withSlash(localizedPath(locale, "prop-firm-faq"))}` },
    { "@type": "ListItem", "position": 3, "name": "MyFundedFutures FAQ", "item": PAGE_URL },
  ],
};

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: t("prop_firm_faq.myfundedfutures_hero_title"),
  description: t("prop_firm_faq.myfundedfutures_meta_description"),
  publisher: { "@type": "Organization", name: "PickMyTrade", logo: { "@type": "ImageObject", url: `${SITE_URL}/assets/logo.png` } },
  datePublished: "2026-07-08",
  dateModified: LAST_UPDATED,
  mainEntityOfPage: { "@type": "WebPage", "@id": PAGE_URL },
};
---

<BaseLayout
  locale={locale}
  title={t("prop_firm_faq.myfundedfutures_meta_title")}
  description={t("prop_firm_faq.myfundedfutures_meta_description")}
  ogType="article"
  ldJson={[breadcrumbSchema, articleSchema]}
>
<script type="application/ld+json" is:inline>
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is MyFundedFutures (MFFU)?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "MFFU is a US futures prop firm offering eval-to-funded accounts on Tradovate and Rithmic, with support for Tradovate, NinjaTrader 8, Quantower, ATAS, Volumetrica/VolSys, R|Trader Pro, and TradingView charts. Three current plan tiers - Core, Rapid, Pro - plus Builder and Flex options. Founded June 2023 by Matt Leech in Texas. Known for explicitly permitted automation and copy trading, free monthly reset credits, and a 4.9 Trustpilot rating across ~17,000-18,000 reviews."
      }
    },
    {
      "@type": "Question",
      "name": "Is MyFundedFutures a legitimate prop firm?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Established US futures prop firm with thousands of paid-out traders, transparent rule documentation, active support, and one of the highest sustained Trustpilot ratings in the industry. Survived the 2024-2025 prop firm collapse wave intact."
      }
    },
    {
      "@type": "Question",
      "name": "Who owns MFFU and when was it founded?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Founded June 2023, headquartered in Texas. Founder and CEO is Matthew (Matt) Leech, publicly known. MFFU is part of the broader Funded Futures Family group/branding, though the FFF help center positions FFF and MFFU as separate companies - MFFU operates as a distinct product within that group."
      }
    },
    {
      "@type": "Question",
      "name": "What countries does MFFU accept traders from?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Most countries except OFAC-sanctioned and a small list of high-fraud jurisdictions. International payouts via Rise, PayPal (limited), and bank wire. Verify your country on the MFFU help center."
      }
    },
    {
      "@type": "Question",
      "name": "Is MFFU sim-funded or live capital?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Sim-funded for evaluation and most of the funded phase. Pays real cash from sim performance. Live transition is a separate stage triggered by the Risk Manager after consistent payouts. The $00K cumulative sim-funded payout cap is applied per-plan, per-account-tier rather than a single per-trader figure across everything. Rapid additionally uses a $0K single-day net trigger as its live-transition threshold."
      }
    },
    {
      "@type": "Question",
      "name": "How many active traders does MFFU have?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "MFFU doesn't publicly disclose count. Based on Trustpilot review volume (~17,000-18,000 reviews as of May 2026) and Discord community size, the active trader base is in the tens of thousands."
      }
    },
    {
      "@type": "Question",
      "name": "What is MFFU's Trustpilot rating in 2026?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "4.9/5 across roughly 17,000-18,000 reviews as of May 2026 - among the highest sustained ratings in the futures prop firm industry. Reviews skew toward smooth payouts, automation friendliness, and customer support quality."
      }
    },
    {
      "@type": "Question",
      "name": "Is MFFU regulated?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No - operates as a tech / contractor firm, not a broker-dealer. Standard for retail prop firms. Relationship governed by the MFFU funded trader agreement."
      }
    },
    {
      "@type": "Question",
      "name": "What's the minimum age?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "18 years old. Standard for retail prop firms."
      }
    },
    {
      "@type": "Question",
      "name": "Can I have multiple MFFU accounts under the same name?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes, up to 5 funded accounts (combinations of small-tier plans like Core $50K, Rapid $25K/$50K, Flex $25K/$50K); the limit is typically 3 for $00K and $50K plans on Rapid and Pro. Plus you can run separate eval accounts working toward funded."
      }
    },
    {
      "@type": "Question",
      "name": "What are the differences between MFFU Core, Rapid, and Pro plans?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Core: $50K only, 3% EOD trailing drawdown ($2,000), 80/20 split, $5,000 per-cycle payout cap, 40% funded consistency, payouts every 5 winning days. Rapid: $25K/$50K/$00K/$50K, 4% intraday trailing, 90/10 split, $1,250 per-cycle cap, no funded consistency rule, payouts every 5 winning days. Pro: $50K/$00K/$50K, 3% EOD trailing, 80/20 split, no per-cycle payout cap, no funded consistency, payouts every 14 calendar days. Pick based on capital, style, and payout needs."
      }
    },
    {
      "@type": "Question",
      "name": "Which MFFU plan is best for beginners?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Core $50K - the only Core account size offered, with EOD trailing drawdown that's forgiving for new traders and simple one-step rules. Free monthly reset credits cover early breaches. Builder is also a fair starter for traders confident they can hit a $3K target in one day."
      }
    },
    {
      "@type": "Question",
      "name": "Which MFFU plan is best for scalpers / high-frequency traders?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Pro plan - no per-cycle payout cap means high-volume scalpers can pull large payouts. Watch the <200 trades/day HFT cap."
      }
    },
    {
      "@type": "Question",
      "name": "Which MFFU plan is best for swing or news traders?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Core or Pro for EOD drawdown. MFFU has news trading restrictions (T1 events have flat windows) - confirm specific event policy. Overnight holding is not permitted on any plan."
      }
    },
    {
      "@type": "Question",
      "name": "What's the cheapest MFFU plan?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Rapid $25K or Flex $25K are the cheapest entry points (Core does not have a $25K tier - Core starts at $50K). Builder $25K with 1-day pass capability is comparable. Pricing varies with promos - verify on myfundedfutures.com."
      }
    },
    {
      "@type": "Question",
      "name": "Why did MFFU restructure its plans in July 2025?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "To simplify the lineup and align with industry trends - eliminated the legacy $49 Starter activation fee, raised the small-account funded count to 5, and replaced the older single-tier Starter plan with the Core / Rapid / Pro three-plan structure for clarity."
      }
    },
    {
      "@type": "Question",
      "name": "What happened to the old Starter plan?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The legacy single-tier \"Starter\" plan (which carried a $49 activation fee on funded transition) was discontinued in July 2025. Existing Starter accounts were grandfathered into their original rules. New traders see only Core / Rapid / Pro / Builder / Flex. \"Expert\" and \"Milestone\" were never standard MFFU plan names."
      }
    },
    {
      "@type": "Question",
      "name": "What is the MFFU Builder plan?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Builder allows a 1-day pass on $3,000 profit target with no consistency rule during evaluation. Aimed at confident traders who want fast funding without the standard min-day grind."
      }
    },
    {
      "@type": "Question",
      "name": "What is the MFFU Flex plan?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Flex offers a 7-day Sim Funded reset window and entry pricing around $84-$07. Trade-off: tighter rules in exchange for faster reset access."
      }
    },
    {
      "@type": "Question",
      "name": "What is the MFFU One Day Pass?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "A Builder plan feature - hit the $3,000 target in a single trading day and the eval passes immediately. Available on Builder; not available on Core/Rapid/Pro which have multi-day minimums."
      }
    },
    {
      "@type": "Question",
      "name": "Is the Core plan one-step or two-step?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "One-step. Hit the profit target without breaching MLL, you graduate to sim-funded."
      }
    },
    {
      "@type": "Question",
      "name": "Is the Rapid plan one-step or two-step?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "One-step. Designed for fast progression to funded phase."
      }
    },
    {
      "@type": "Question",
      "name": "Is the Pro plan one-step or two-step?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "One-step. The Pro plan is intentionally streamlined; pay the higher upfront, hit the target, go funded with the loosest funded-phase rules of the lineup."
      }
    },
    {
      "@type": "Question",
      "name": "Can I switch between Core, Rapid, and Pro after purchase?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No - each plan is purchased separately. To switch, you'd need to abandon the current eval and buy the new plan. Pick carefully at purchase time."
      }
    },
    {
      "@type": "Question",
      "name": "What account sizes does MFFU offer?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Sizes vary by plan and are NOT uniform across the lineup. Core: $50K only. Rapid: $25K / $50K / $00K / $50K. Pro: $50K / $00K / $50K. Flex: $25K / $50K. Builder uses its own sizing. Verify current sizes on the pricing page."
      }
    },
    {
      "@type": "Question",
      "name": "How much does the $25K MFFU account cost?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "$25K is offered on Rapid and Flex (NOT Core). Pricing is typically in the ~$77-$07/mo range with promos depending on plan. Promo pricing fluctuates; verify on myfundedfutures.com at purchase time."
      }
    },
    {
      "@type": "Question",
      "name": "How much does the $50K account cost?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Core $50K runs ~$77/mo promo (the cheapest Core option). Rapid $50K and Pro $50K are higher. Promo pricing fluctuates; verify on myfundedfutures.com at purchase time."
      }
    },
    {
      "@type": "Question",
      "name": "How much does the $00K account cost?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "$00K is offered on Rapid and Pro (NOT Core - Core is $50K only). Promo pricing typically scales up from the $50K tier; verify current pricing on myfundedfutures.com."
      }
    },
    {
      "@type": "Question",
      "name": "How much does the $50K account cost?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "$50K is offered on Rapid and Pro only (NOT Core). It's the largest available account size. Promo pricing scales up from $00K; verify current pricing on myfundedfutures.com."
      }
    },
    {
      "@type": "Question",
      "name": "Are MFFU evaluation fees one-time or monthly?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Monthly subscription on Core / Rapid / Pro evals. Stops when you pass and graduate to sim-funded. Builder and Flex have different one-time pricing models."
      }
    },
    {
      "@type": "Question",
      "name": "Does MFFU still charge an activation fee in 2026?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No - activation fees were eliminated July 2025 across all plans. Pass the eval, graduate to funded with zero additional cost."
      }
    },
    {
      "@type": "Question",
      "name": "Is the monthly fee waived once I'm funded?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes - sim-funded accounts have no recurring subscription. The monthly fee was eval-only."
      }
    },
    {
      "@type": "Question",
      "name": "Why is the multi-account cap 5 for small accounts but 3 for $00K/$50K?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Risk management - total simulated capital exposure is similar at 5 × $50K vs 3 × $50K. The cap is on total exposure, not raw account count."
      }
    },
    {
      "@type": "Question",
      "name": "What is the profit target for the $25K account?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "$,500 net profit on Rapid $25K (Core does NOT have a $25K tier). Flex $25K uses similar sizing. Verify the exact target on the help center."
      }
    },
    {
      "@type": "Question",
      "name": "What is the profit target for the $50K account?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "$3,000 net profit on Core $50K (Core's only account size). Rapid $50K and Pro $50K use similar targets. Verify exact target on the help center."
      }
    },
    {
      "@type": "Question",
      "name": "What is the profit target for the $00K account?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "$6,000 net profit on Core $00K."
      }
    },
    {
      "@type": "Question",
      "name": "What is the profit target for the $50K account?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "$9,000 net profit on Core $50K."
      }
    },
    {
      "@type": "Question",
      "name": "What is the minimum number of trading days at MFFU?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Builder: 1-day pass possible. Core/Rapid/Pro: typically 5+ minimum trading days. Verify per plan on the parameters page."
      }
    },
    {
      "@type": "Question",
      "name": "Does the 1-day minimum apply to all plans?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No - only Builder. Core / Rapid / Pro require multi-day minimums (typically 5)."
      }
    },
    {
      "@type": "Question",
      "name": "Do trading days need to be consecutive?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No - non-consecutive is fine. Take days off as needed; the minimum count just needs to be reached."
      }
    },
    {
      "@type": "Question",
      "name": "Does a single 1-tick trade count as a trading day?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "MFFU has tightened this - token trades typically don't count. Verify the specific definition; \"meaningful activity\" is the standard."
      }
    },
    {
      "@type": "Question",
      "name": "What counts as a \"winning day\" for payout calculations?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "A trading day with positive net P&L (typically also above a minimum threshold). Used in payout-eligibility math on Rapid and other plans."
      }
    },
    {
      "@type": "Question",
      "name": "Can I pass evaluation in a single day?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "On Builder, yes - hit $3K target day 1, eval passes. On Core / Rapid / Pro, no - must meet the multi-day minimum."
      }
    },
    {
      "@type": "Question",
      "name": "What is MFFU's maximum drawdown?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Trailing drawdown that ratchets up with peak. Core/Pro use a 3% EOD trailing drawdown; Rapid uses a 4% intraday trailing drawdown. By account size: $50K = $2,000 DD, $00K = $3,000 DD, $50K = $4,500 DD. Rapid $25K uses a 4% intraday DD. Verify exact figures on the help center."
      }
    },
    {
      "@type": "Question",
      "name": "Is MFFU's drawdown EOD or intraday?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Depends on plan. Core: EOD. Rapid: intraday. Pro: EOD. Builder: EOD. The Rapid intraday is faster path to funded but more risky."
      }
    },
    {
      "@type": "Question",
      "name": "Which MFFU plans use EOD trailing drawdown?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Core, Pro, Builder, and Flex use EOD trailing. The trail only updates at each day's close - much friendlier than intraday."
      }
    },
    {
      "@type": "Question",
      "name": "Which MFFU plans use intraday trailing drawdown?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Rapid uses intraday trailing - every tick of unrealized profit raises the floor. Designed for fast-passing scalpers comfortable with tight risk."
      }
    },
    {
      "@type": "Question",
      "name": "How is the trailing drawdown calculated on the Rapid plan?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Tick-by-tick equity-based. Open position unrealized profit moves the floor up; touching the floor breaches the account."
      }
    },
    {
      "@type": "Question",
      "name": "Does the trailing drawdown ever stop trailing?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes - locks once you reach starting balance + drawdown + $00 buffer. After that the floor stays static."
      }
    },
    {
      "@type": "Question",
      "name": "What is the $00 buffer above the starting balance?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Trail freezes at starting balance + drawdown + $00. Standard mechanism across MFFU plans. After freeze, it's effectively a static drawdown."
      }
    },
    {
      "@type": "Question",
      "name": "Is there a daily loss limit on Core, Rapid, or Pro?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Generally no daily loss limit on MFFU eval - the trailing drawdown is the primary risk gate. Verify per plan."
      }
    },
    {
      "@type": "Question",
      "name": "What is MFFU's 2% price limit rule?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "A rule limiting how far from market the entry/exit prices can deviate, to prevent abuse of simulator slippage. Standard prop firm risk control."
      }
    },
    {
      "@type": "Question",
      "name": "What happens if my balance touches the drawdown floor intraday on Core?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Core uses EOD drawdown - intraday touches don't breach. Only the closing balance matters. Hold through wicks and survive as long as the close is above the floor."
      }
    },
    {
      "@type": "Question",
      "name": "Does unrealized P&L count toward the drawdown on Rapid?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes - Rapid is intraday, so unrealized profit moves the floor up tick by tick. Manage position size accordingly."
      }
    },
    {
      "@type": "Question",
      "name": "How does drawdown reset when I take a payout?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Drawdown floor stays at the locked level. Payouts don't move the floor up. Your buffer above the floor shrinks by the payout amount."
      }
    },
    {
      "@type": "Question",
      "name": "What is MFFU's consistency rule?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Best single day cannot exceed 50% of total cumulative profit at payout time. Standard prop firm consistency mechanism."
      }
    },
    {
      "@type": "Question",
      "name": "Is the consistency rule 50% across all plans?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Evaluation: 50% best-day rule on all plans. Funded phase: Core has a 40% consistency rule; Rapid and Pro have NO consistency rule once funded. Builder eval has no consistency rule, but Builder funded payout cycles enforce a 50% single-day cap (one day cannot exceed 50% of cycle profits). Verify on the help center for your specific plan."
      }
    },
    {
      "@type": "Question",
      "name": "Does the Pro plan have a consistency rule once funded?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. Pro funded phase has no consistency rule - one of Pro's main differentiators vs Core."
      }
    },
    {
      "@type": "Question",
      "name": "Does the Builder plan have a consistency rule?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Eval: no consistency rule - Builder allows the 1-day pass. BUT during funded payout cycles, Builder DOES enforce a 50% single-day consistency cap: any one day cannot exceed 50% of that cycle's profits. Builder payouts are capped at a flat $2,000 each, with up to 5 sim payouts at 80/20 split."
      }
    },
    {
      "@type": "Question",
      "name": "What happens if I violate the consistency rule during evaluation?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Eval pass is delayed until you log additional smaller days that dilute the percentage below 50%. The account isn't killed - just delayed."
      }
    },
    {
      "@type": "Question",
      "name": "How is the consistency percentage calculated?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Best day net P&L / total cumulative net P&L × 100. To stay under 50%, total profit must be at least 2x the best day."
      }
    },
    {
      "@type": "Question",
      "name": "How do I fix a consistency breach without breaking the rules?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Log additional smaller-profit days to grow the total denominator until the best-day percentage drops below 50%. Patience over panic."
      }
    },
    {
      "@type": "Question",
      "name": "What happens after I pass the MFFU evaluation?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "You move to the sim-funded phase - same simulated environment, but the monthly subscription stops, the trailing drawdown locks, and you can request payouts after meeting first-payout criteria."
      }
    },
    {
      "@type": "Question",
      "name": "Is the sim-funded stage trading real money?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No - orders fill against simulated quotes. But MFFU pays REAL CASH from sim performance. The sim/live distinction is about order routing, not payout legitimacy."
      }
    },
    {
      "@type": "Question",
      "name": "How long do I stay in the sim-funded stage?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Until you trigger MFFU's live-transition criteria, which are applied per-plan, per-account-tier rather than as a single $00K per-trader figure. The $00K cumulative payout figure is the common benchmark on Core/Pro, while Rapid uses a separate $0K single-day net trigger. The Risk Manager evaluates each tier independently. Most traders never reach the threshold."
      }
    },
    {
      "@type": "Question",
      "name": "Who is the MFFU Risk Manager?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The MFFU team that evaluates traders for live capital allocation. They review track record, trade behavior, and rule compliance before moving you to live."
      }
    },
    {
      "@type": "Question",
      "name": "What criteria does MFFU look for to invite me to live?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Consistent multi-month payout track record, no rule violations, low volatility, demonstrated risk management. The exact criteria aren't publicly documented; the Risk Manager has discretion."
      }
    },
    {
      "@type": "Question",
      "name": "Can I keep multiple live accounts?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Live capital allocation is per-trader, not per-account. Most live transitions consolidate into one or a small number of live accounts."
      }
