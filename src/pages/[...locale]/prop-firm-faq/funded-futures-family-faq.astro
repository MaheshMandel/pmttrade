---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import AuthorByline from "../../../components/AuthorByline.astro";
import { getLocalePaths, useTranslations, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import '../../../styles/prop-firm-faq.css';

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };
const t = useTranslations(locale);

const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const PAGE_URL = `${SITE_URL}${withSlash(localizedPath(locale, "prop-firm-faq/funded-futures-family-faq"))}`;
const LAST_UPDATED = "2026-09-16";

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": `${SITE_URL}${withSlash(localizedPath(locale))}` },
    { "@type": "ListItem", "position": 2, "name": "Prop Firm FAQ Hub", "item": `${SITE_URL}${withSlash(localizedPath(locale, "prop-firm-faq"))}` },
    { "@type": "ListItem", "position": 3, "name": "Funded Futures Family FAQ", "item": PAGE_URL },
  ],
};

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: t("prop_firm_faq.funded_futures_family_hero_title"),
  description: t("prop_firm_faq.funded_futures_family_meta_description"),
  publisher: { "@type": "Organization", name: "PickMyTrade", logo: { "@type": "ImageObject", url: `${SITE_URL}/assets/logo.png` } },
  datePublished: "2026-07-08",
  dateModified: LAST_UPDATED,
  mainEntityOfPage: { "@type": "WebPage", "@id": PAGE_URL },
};
---

<BaseLayout
  locale={locale}
  title={t("prop_firm_faq.funded_futures_family_meta_title")}
  description={t("prop_firm_faq.funded_futures_family_meta_description")}
  ogType="article"
  ldJson={[breadcrumbSchema, articleSchema]}
>
<script type="application/ld+json" is:inline>
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is Funded Futures Family (FFF)?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Funded Futures Family (FFF) is a US-based futures prop firm founded and run by CEO Manuel Meraz. The \"Family\" in FFF's name refers to its trader community, not corporate ownership. FFF offers six distinct programs (Classic, Elite, Premiere, Straight-to-Funded, Velocity, Evaluation-to-Live) across $25K, $50K, $00K, and $50K simulated account sizes. Pay an evaluation fee, hit the profit target without breaching the trailing drawdown, then trade a sim-funded account on a flat 90/10 split (100% on your first $0K in profits)."
      }
    },
    {
      "@type": "Question",
      "name": "Who owns Funded Futures Family?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "FFF was founded by Manuel Meraz, who serves as CEO (per his LinkedIn profile). There is no authoritative public source confirming any broader \"family-owned\" corporate structure - \"Family\" in the brand name refers to the FFF trader community, not corporate ownership. Manuel and the FFF team are visible in YouTube content and Discord AMAs."
      }
    },
    {
      "@type": "Question",
      "name": "When was Funded Futures Family founded?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "FFF launched in 2024 as a futures-only entrant in the US prop firm space, founded by Manuel Meraz. It is younger than Apex (2021) and Topstep (2012) but has rapidly built published payout proofs, an active Discord community, and a 4.7-4.8/5 Trustpilot rating from 1,300+ reviews."
      }
    },
    {
      "@type": "Question",
      "name": "Where is FFF headquartered?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "FFF is US-based. The official website is fundedfuturesfamily.com and customer-facing help is hosted at intercom.help/funded-futures-family. As a privately-held company, FFF does not publish a corporate office address publicly; support runs through email, the intercom help center, and Discord ticketing."
      }
    },
    {
      "@type": "Question",
      "name": "Is FFF the same as MyFundedFutures (MFFU)?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No - these are two completely separate companies. Funded Futures Family (FFF) was founded by Manuel Meraz; \"Family\" in its name refers to the trader community. MyFundedFutures (MFFU) is operated by My Funded Futures LLC, a different company, with different rules and a permissive automation policy. The naming similarity causes constant confusion in trader forums. Verify the URL: fundedfuturesfamily.com vs myfundedfutures.com."
      }
    },
    {
      "@type": "Question",
      "name": "Is FFF regulated?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "FFF is a proprietary trading firm, not a regulated broker-dealer. Its product is structured as an educational simulation/assessment program with discretionary payouts. This is the standard structure for the entire US futures prop firm industry (Apex, Topstep, MFFU, Bulenox all operate the same way)."
      }
    },
    {
      "@type": "Question",
      "name": "Is FFF legit or a scam?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Legit. FFF maintains a Trustpilot rating in the 4.7-4.8/5 range from 1,300+ reviews, posts payout proofs on its YouTube and Discord channels, and has paid out documented winning traders. Many PickMyTrade customers successfully use automation at various futures prop firms including FFF. Always check FFF's official website for their current compliance guidelines."
      }
    },
    {
      "@type": "Question",
      "name": "What asset classes can I trade on FFF?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "CME-listed futures only. ES, NQ, MES, MNQ, RTY, M2K, YM, MYM, CL, MCL, GC, MGC, NG, ZB, ZN, 6E, 6B, and other CME/CBOT/NYMEX/COMEX products are tradeable. No forex, no crypto spot, no equities, no options. Pure futures."
      }
    },
    {
      "@type": "Question",
      "name": "Does FFF accept US-based traders?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes - FFF accepts US traders, which is its primary market. International traders from most countries are also accepted, with the standard restricted list (Iran, North Korea, Syria, Cuba, sanctioned jurisdictions). KYC is required at first payout."
      }
    },
    {
      "@type": "Question",
      "name": "Does FFF accept India / Pakistan / Nigeria?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "India and Nigeria - generally yes for evaluation purchase. Pakistan and Bangladesh - verify in checkout, as these are commonly restricted. KYC at payout requires government ID; some jurisdictions only accept payouts via Rise (crypto) rather than ACH/wire."
      }
    },
    {
      "@type": "Question",
      "name": "Does FFF trade real money or simulated capital?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Sim-funded. Orders fill against simulated CME quotes mirroring real-time market data; the firm's profit comes from evaluation fees plus a percentage of in-house performance. Payouts are real cash from the firm's revenue, paid out of sim PnL. This is the standard prop firm model across the entire US futures prop industry."
      }
    },
    {
      "@type": "Question",
      "name": "How is FFF different from a traditional broker?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "A traditional broker (NinjaTrader Brokerage, AMP Futures, Tradovate) holds your real cash, charges commissions, and gives you back 100% of your PnL. FFF is a sim assessment firm - you pay an eval fee, never deposit margin, and split profits 90/10 on simulated capital that the firm allocates after you pass (100% on the first $0K, then 90/10 thereafter on sim-funded; 80/20 only applies at the Professional/Live stage)."
      }
    },
    {
      "@type": "Question",
      "name": "Why do people confuse FFF and MFFU?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Both names contain \"Funded\" and \"Futures\" and both target US futures traders. Funded Futures Family (FFF) and MyFundedFutures (MFFU) are constantly mixed up in trader forums, Discord, and Trustpilot. They are different companies, different owners, different rules. Always verify which firm is being discussed before trusting a trader forums comment."
      }
    },
    {
      "@type": "Question",
      "name": "What is the biggest rule difference between FFF and MFFU?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "MFFU explicitly permits webhook-triggered execution via PickMyTrade. Always check FFF's official website for their current compliance guidelines on automation before deploying any automation tools. Many PickMyTrade customers successfully use automation at various futures prop firms."
      }
    },
    {
      "@type": "Question",
      "name": "Is FFF owned by the same company as MFFU?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. FFF was founded by CEO Manuel Meraz (Funded Futures Family). MFFU is operated by My Funded Futures LLC, a separate corporate entity with different leadership. There is no parent-subsidiary relationship between the two firms."
      }
    },
    {
      "@type": "Question",
      "name": "Do FFF and MFFU have the same plans and pricing?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. FFF runs six distinct programs - Classic, Elite, Premiere, Straight-to-Funded, Velocity, and Evaluation-to-Live - across $25K-$50K sizes with a flat 90/10 split (100% on the first $0K). MFFU runs Core, Rapid, and Pro plans (plus Builder and Flex options) with $25K-$50K sizes and its own profit-split tiers. Drawdown styles, daily loss rules, minimum-day requirements, and payout cadences all differ."
      }
    },
    {
      "@type": "Question",
      "name": "Can I run FFF and MFFU accounts at the same time?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes - they are separate firms with separate KYC, separate sim accounts, and separate rules. Many traders run both. Always check FFF's official website for their current compliance guidelines on multi-account trading."
      }
    },
    {
      "@type": "Question",
      "name": "Can I use PickMyTrade automation with FFF or MFFU?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "PickMyTrade (pickmytrade.trade / pickmytrade.io) supports automation for futures prop firms including FFF and MFFU accounts. MFFU explicitly permits webhook-driven execution. For FFF, always check FFF's official website for their current compliance guidelines before using automation. Many PickMyTrade customers successfully use automation at various futures prop firms — a small amount of risk is always involved."
      }
    },
    {
      "@type": "Question",
      "name": "What plans does FFF offer in 2026?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "FFF runs six distinct programs: Classic (2-day-pass minimum, EOD trailing), Elite (1-day-pass minimum, intraday trailing), Premiere (EOD trailing, 1-day-pass minimum), Straight-to-Funded, Velocity (intraday trailing), and Evaluation-to-Live (the Professional/Live stage). Each program is available across $25K, $50K, $00K, and $50K virtual buying power. Note: \"1-day\" and \"2-day\" refer to minimum trading-day pass speed, not phase count."
      }
    },
    {
      "@type": "Question",
      "name": "What is the FFF Classic plan?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Classic is FFF's flagship evaluation program. It uses an end-of-day (EOD) trailing drawdown (gentler - intraday spikes don't count) and requires a minimum of 2 trading days to pass. Classic has no daily loss limit - only the trailing drawdown governs the account. Pass the profit target across at least 2 trading days and you graduate to a sim-funded account."
      }
    },
    {
      "@type": "Question",
      "name": "What is the FFF Elite plan?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Elite is FFF's fastest evaluation - pass with as little as 1 minimum trading day. The trade-off: Elite uses an intraday trailing drawdown (tick-by-tick), which is stricter than the Classic/Premiere EOD style. Good for high-conviction discretionary scalpers who want the quickest route to funding."
      }
    },
    {
      "@type": "Question",
      "name": "What is the FFF Premiere plan?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Premiere uses an EOD trailing drawdown (like Classic) but with a 1-day-pass minimum (like Elite). It also has no daily loss limit. Premiere is the \"best of both worlds\" option: gentle EOD drawdown plus fast pass speed. Often the priciest tier of the three core eval programs."
      }
    },
    {
      "@type": "Question",
      "name": "What is the FFF Straight-to-Funded program?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Straight-to-Funded skips the evaluation phase - you pay a higher upfront fee and start directly on a sim-funded account. The trailing drawdown, contract limits, and consistency rules still apply. Closest analog to Apex's Static / instant-funding tier, but priced as a one-time setup rather than a recurring subscription."
      }
    },
    {
      "@type": "Question",
      "name": "What is the FFF Velocity plan?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Velocity is an aggressive evaluation product using an intraday trailing drawdown (like Elite). It's tuned for fast-paced scalpers willing to trade a tighter intraday floor in exchange for accelerated pass speed and lower upfront price. Verify exact targets and trail values on fundedfuturesfamily.com at purchase."
      }
    },
    {
      "@type": "Question",
      "name": "What is the Evaluation-to-Live (Professional/Live) stage?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Evaluation-to-Live is FFF's Professional/Live stage - the graduation tier above sim-funded. Top sim-funded traders with a documented payout track record can progress to Live, where real-money capital is allocated. The profit split flips to 80/20 on Live (FFF's only 80/20 product); sim-funded stays at the flat 90/10 (100% first $0K)."
      }
    },
    {
      "@type": "Question",
      "name": "Which FFF program is fastest to pass?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Elite, Premiere, and Velocity all allow a 1-day-minimum pass. Classic requires 2 days minimum. Hitting the profit target on day 1 is enough on Elite/Premiere/Velocity; on Classic you must trade at least one additional day before you can graduate. Verify the active minimum-day rule on your dashboard."
      }
    },
    {
      "@type": "Question",
      "name": "Can I switch FFF programs mid-evaluation?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. Once purchased, the program type (Classic, Elite, Premiere, Velocity, etc.) is locked to that account. To switch programs you must buy a new evaluation. Refunds on the unfinished program are not standard; FFF support reviews case-by-case."
      }
    },
    {
      "@type": "Question",
      "name": "Can I buy multiple FFF evaluations at once?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes - multiple evaluations per trader are permitted, and you can mix programs (e.g. Classic $50K + Elite $00K). FFF caps total funded buying power per trader. Always check FFF's official website for their current compliance guidelines on cross-account trading."
      }
    },
    {
      "@type": "Question",
      "name": "Which program is best for beginners?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Classic at $25K or $50K. EOD trailing drawdown is gentler than Velocity/Elite's intraday tick-by-tick trail, no daily loss limit removes one source of accidental wash-out, and the 2-day pass minimum forces a small pause before graduating. The cheapest entry to learn FFF's rule set."
      }
    },
    {
      "@type": "Question",
      "name": "Which program is best for experienced day traders?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Elite or Premiere at $00K-$50K. Both allow a 1-day pass for fast funding. Premiere's EOD trail is more forgiving of intraday volatility; Elite's intraday trail rewards tight risk control. Pick Premiere if you want forgiveness, Elite if you want speed plus a slightly cheaper price."
      }
    },
    {
      "@type": "Question",
      "name": "What account sizes does FFF offer?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "$25K, $50K, $00K, and $50K virtual buying power. No $250K or $300K tier as of 2026. The $50K is the largest single-account size; scaling to higher buying power happens via the Pro program rather than an upfront purchase."
      }
    },
    {
      "@type": "Question",
      "name": "How much does the FFF $25K evaluation cost?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "List price varies by program. Classic $25K is typically the cheapest entry; Elite, Premiere, and Velocity sit slightly higher. Straight-to-Funded $25K commands the highest one-time fee since the eval phase is skipped. Promo codes regularly bring prices down 30-50%. Verify exact figures on fundedfuturesfamily.com - pricing fluctuates with active promotions."
      }
    },
    {
      "@type": "Question",
      "name": "How much does the FFF $50K evaluation cost?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "List price varies by program: Classic $50K is the most accessible; Elite/Premiere/Velocity carry a premium for faster pass speed; Straight-to-Funded $50K is highest. With a 30-50% promo, $50K Classic often lands under $00. The $50K tier is popular in trader forums because the trailing drawdown is large enough to survive choppy ES sessions."
      }
    },
    {
      "@type": "Question",
      "name": "How much does the FFF $00K evaluation cost?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "List price varies by program. Classic $00K is typically the cheapest; Elite, Premiere, and Velocity at $00K command a higher fee for 1-day pass speed or intraday trail. With a Black Friday or anniversary promo, $00K Classic can drop into the $40-$80 range. $00K is the most balanced size - meaningful funded buying power without the steepest fee."
      }
    },
    {
      "@type": "Question",
      "name": "How much does the FFF $50K evaluation cost?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "List price varies by program. Classic $50K is the most accessible; Elite/Premiere/Velocity $50K are mid-tier; Straight-to-Funded $50K is the highest one-time fee in FFF's catalog. Promos push the eval programs lower. $50K is the largest single-tier purchase before progressing to the Live/Professional stage."
      }
    },
    {
      "@type": "Question",
      "name": "Are there monthly fees on funded FFF accounts?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No recurring monthly fee on funded sim accounts. Evaluation is a one-time purchase; the funded account is free to maintain as long as it's active. Apex and Topstep similarly drop monthly fees once funded. (MFFU also no monthly fee on funded.)"
      }
    },
    {
      "@type": "Question",
      "name": "Is there a separate platform / data fee?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "During evaluation, FFF includes Rithmic data and the platform login at no extra charge for most plans. On funded accounts, CME real-time data fees ($85/mo for non-pro, more if you're classified as a professional) may be passed through depending on broker routing. Verify in your funded account onboarding email."
      }
    },
    {
      "@type": "Question",
      "name": "Is the FFF evaluation fee refundable after funding?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "FFF does not advertise a \"fee back on first payout\" refund policy as of 2026. This is a difference from Apex (which does refund eval fees on first payout). Always check the current terms page before purchasing."
      }
    },
    {
      "@type": "Question",
      "name": "Does FFF charge for resets?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes - resets are paid. Typical reset fee runs $79-$99+ depending on plan size and program (Classic, Elite, Premiere, Velocity all carry different reset fees). Still cheaper than buying a new evaluation. FFF often runs reset-discount promotions during Black Friday and major retail moments."
      }
    },
    {
      "@type": "Question",
      "name": "Are there hidden charges I should know about?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No firm-side hidden fees on payouts. Rise (crypto rails) has standard network fees; ACH/wire processing may be deducted by the bank. The only \"gotcha\" is the CME pro/non-pro data classification once funded - clarify with FFF support before going live."
      }
    },
    {
      "@type": "Question",
      "name": "What is the trailing drawdown on FFF programs?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "FFF uses a trailing drawdown that follows your highest closed (or end-of-day) balance until you cross a threshold equal to the starting balance plus the trailing buffer. Classic, Premiere, and Prime use end-of-day (EOD) trailing; Elite and Velocity use intraday trailing (tick-by-tick). Once \"locked,\" the trail freezes at the initial balance plus profit-target offset."
      }
    },
    {
      "@type": "Question",
      "name": "Is FFF's drawdown intraday or end-of-day?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "It depends on the program. Classic, Premiere, and Prime use EOD trailing - the trail recalculates after the daily close, so unrealized intraday drawdown does not count (gentler than Apex's intraday trail). Elite and Velocity use intraday trailing - the trail moves tick-by-tick, similar to Apex Eval. Pick the program that matches your risk tolerance."
      }
    },
    {
      "@type": "Question",
      "name": "Does FFF offer a static drawdown option?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No - FFF does not offer a static-drawdown product as of 2026. All FFF programs use trailing drawdown (EOD on Classic/Premiere/Prime, intraday on Elite/Velocity). If you specifically want a static (fixed floor) drawdown, look at Apex's Static plans or other firms - FFF only sells trailing variants."
      }
    },
    {
      "@type": "Question",
      "name": "When does the trailing drawdown stop trailing?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Once you've locked in the trailing buffer plus the starting balance - typically when end-of-day balance reaches initial balance + trail amount. After lock, the floor freezes at the starting balance and never moves below. This is similar to MFFU's lock mechanic and gentler than Apex's perpetual trail on Eval accounts."
      }
    },
    {
      "@type": "Question",
      "name": "Does the drawdown reset when I graduate to a sim-funded account?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes - the sim-funded account starts with a fresh trailing buffer based on the funded starting balance. Profit accumulated during the evaluation phase doesn't roll forward. This applies across Classic, Elite, Premiere, and Velocity. Verify your starting balance and trail floor in the dashboard before placing the first trade."
      }
    },
    {
      "@type": "Question",
      "name": "Is unrealized PnL counted in the drawdown?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Depends on the program. On Classic, Premiere, and Prime (EOD trailing), unrealized PnL only counts at the daily close - intraday spikes that revert don't move the trail. On Elite and Velocity (intraday trailing), unrealized PnL counts tick-by-tick; floating drawdown can lock the trail at a worse level even if the day closes green."
      }
    },
    {
      "@type": "Question",
      "name": "What is the profit target on each FFF account size?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Targets are single-stage (FFF programs are not phase-based) and scale with size. Typical figures across Classic / Elite / Premiere / Velocity: roughly $,500-$2,000 on $25K, $3,000 on $50K, $6,000-$8,000 on $00K, and $9,000-$2,000 on $50K depending on the program. Verify exact dollar targets on the active product page - FFF tweaks targets during promos."
      }
    },
    {
      "@type": "Question",
      "name": "Is there a profit target on the funded phase?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No recurring target on the funded sim. After passing, your goal becomes meeting the payout-eligibility gate (minimum profit days plus the threshold balance) rather than a fresh percentage target each cycle."
      }
    },
    {
      "@type": "Question",
      "name": "What is the minimum balance to request a payout?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Funded accounts must be above the threshold (initial balance + buffer) at the time of request. Typical minimum withdrawal balance: $,500 above start on $25K, $2,500 on $50K, $5,000 on $00K, and $7,500 on $50K. Below that, payouts are deferred."
      }
    },
    {
      "@type": "Question",
      "name": "Can I see my drawdown level on the platform?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "FFF's dashboard shows your current drawdown floor and remaining buffer. NinjaTrader, Tradovate, and Rithmic platforms also display real-time PnL - track this against your dashboard floor to avoid an end-of-day breach."
      }
    },
    {
      "@type": "Question",
      "name": "Does FFF use balance-based or equity-based drawdown?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Both, depending on the program. Classic, Premiere, and Prime use closed-balance EOD drawdown - gentle, similar to MFFU. Elite and Velocity use equity-based intraday tick trail - strict, similar to Apex Eval. FFF deliberately offers both styles so traders can pick their tolerance."
      }
    },
    {
      "@type": "Question",
      "name": "Does the drawdown reset to start when funded?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes - funded accounts begin with a fresh trailing drawdown based on the funded starting balance. Profit you accumulated during the evaluation phase doesn't carry over into the funded balance."
      }
    },
    {
      "@type": "Question",
      "name": "What is the daily loss limit on FFF?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "It depends on the program. Classic, Premiere, and Prime have NO daily loss limit - only the trailing drawdown governs the account. Elite, Velocity, and Straight-to-Funded may apply daily loss limits per the active terms. Always verify the DLL (or its absence) on your chosen program's product page before purchase. Don't assume a DLL exists on FFF."
