<section id="basics" class="cat-section">
  <div class="cat-header"><div class="cat-icon"><i class="fa-solid fa-circle-info"></i></div><h2 class="cat-title">{t("prop_firm_faq.funded_futures_family_faq_basics_heading")}</h2><span class="cat-count">{t("prop_firm_faq.funded_futures_family_faq_basics_count")}</span></div>
