<details class="gfaq-item"><summary class="gfaq-summary"><span class="gfaq-question">{t("prop_firm_faq.funded_futures_family_faq_1_q")}</span><span class="gfaq-toggle" aria-hidden="true">+</span></summary><div class="gfaq-answer">{t("prop_firm_faq.funded_futures_family_faq_1_a")}</div></details>
