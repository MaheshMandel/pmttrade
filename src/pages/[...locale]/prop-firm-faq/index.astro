---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getLocalePaths, useTranslations, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };
const t = useTranslations(locale);
---

<BaseLayout
  locale={locale}
  title={t("prop_firm_faq.hub_meta_title")}
  description={t("prop_firm_faq.hub_meta_description")}
>
<style>
  .bg-brand-blue { background-color:#2B77EE; }
  .bg-brand-blue:hover { background-color:#1d63d6; }
  .bg-brand-blue-10 { background-color: rgba(43,119,238,0.10); }
  .border-brand-blue-40 { border-color: rgba(43,119,238,0.40); }
  .bg-deep-navy { background-color:#000a15; }
  .hero-faq-bg {
    background-image: linear-gradient(to bottom, #001429 0%, #001f3f 45%, #002040 100%);
    padding-top: 8rem;
    padding-bottom: 10rem;
  }
  .browse-pad { padding-top: 7rem; padding-bottom: 5rem; }
  .shadow-brand-blue { box-shadow: 0 10px 25px -5px rgba(43,119,238,0.35), 0 8px 10px -6px rgba(43,119,238,0.25); }
</style>

<!-- CollectionPage Schema -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "Prop Firm FAQ Hub — Nine Major Futures Prop Firms",
  "url": "https://pickmytrade.trade/prop-firm-faq/",
  "description": "Independent prop firm FAQ hub covering nine major US futures prop firms — Apex Trader Funding, Topstep/TopstepX, MyFundedFutures, Take Profit Trader, Tradeify, Bulenox, Earn2Trade, TickTickTrader, and Funded Futures Family. Each guide covers rules, drawdown, payouts, platforms, and TradingView automation.",
  "datePublished": "2026-05-14",
  "dateModified": "2026-05-25",
  "inLanguage": "en-US",
  "isPartOf": {
    "@type": "WebSite",
    "name": "PickMyTrade",
    "url": "https://pickmytrade.trade"
  },
  "publisher": { "@id": "https://pickmytrade.trade/#organization" },
  "hasPart": [
    {"@type": "FAQPage", "name": "Apex Trader Funding FAQ", "url": "https://pickmytrade.trade/prop-firm-faq/apex-trader-funding-faq/"},
    {"@type": "FAQPage", "name": "MyFundedFutures (MFFU) FAQ", "url": "https://pickmytrade.trade/prop-firm-faq/myfundedfutures-faq/"},
    {"@type": "FAQPage", "name": "Take Profit Trader (TPT) FAQ", "url": "https://pickmytrade.trade/prop-firm-faq/take-profit-trader-faq/"},
    {"@type": "FAQPage", "name": "Tradeify FAQ", "url": "https://pickmytrade.trade/prop-firm-faq/tradeify-faq/"},
    {"@type": "FAQPage", "name": "Alpha Futures FAQ", "url": "https://pickmytrade.trade/prop-firm-faq/alpha-futures-faq/"},
    {"@type": "FAQPage", "name": "Trading Psychology FAQ", "url": "https://pickmytrade.trade/trading-psychology-faq/"},
    {"@type": "FAQPage", "name": "TradingView Indicators FAQ", "url": "https://pickmytrade.trade/tradingview-indicators-faq/"},
    {"@type": "FAQPage", "name": "Topstep FAQ", "url": "https://pickmytrade.trade/prop-firm-faq/topstep-faq/"},
    {"@type": "FAQPage", "name": "FundedNext FAQ", "url": "https://pickmytrade.trade/prop-firm-faq/fundednext-faq/"},
    {"@type": "FAQPage", "name": "FundingPips FAQ", "url": "https://pickmytrade.trade/prop-firm-faq/fundingpips-faq/"},
    {"@type": "FAQPage", "name": "Goat Funded Trader FAQ", "url": "https://pickmytrade.trade/prop-firm-faq/goat-funded-trader-faq/"},
    {"@type": "FAQPage", "name": "Lucid Trading FAQ", "url": "https://pickmytrade.trade/prop-firm-faq/lucid-trading-faq/"},
    {"@type": "FAQPage", "name": "RebelsFunding FAQ", "url": "https://pickmytrade.trade/prop-firm-faq/rebelsfunding-faq/"},
    {"@type": "FAQPage", "name": "TradingView Webhooks FAQ", "url": "https://pickmytrade.trade/tradingview-webhooks-faq/"},
    {"@type": "FAQPage", "name": "Bulenox FAQ", "url": "https://pickmytrade.trade/prop-firm-faq/bulenox-faq/"},
    {"@type": "FAQPage", "name": "Earn2Trade FAQ", "url": "https://pickmytrade.trade/prop-firm-faq/earn2trade-faq/"},
    {"@type": "FAQPage", "name": "TickTickTrader (TTT) FAQ", "url": "https://pickmytrade.trade/prop-firm-faq/ticktick-trader-faq/"},
    {"@type": "FAQPage", "name": "Funded Futures Family (FFF) FAQ", "url": "https://pickmytrade.trade/prop-firm-faq/funded-futures-family-faq/"}
  ]
}
</script>

<!-- BreadcrumbList Schema -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {"@type": "ListItem", "position": 1, "name": "Home", "item": "https://pickmytrade.trade/"},
    {"@type": "ListItem", "position": 2, "name": "Prop Firm FAQ Hub", "item": "https://pickmytrade.trade/prop-firm-faq/"}
  ]
}
</script>

<main id="main-content" role="main">

    <!-- Hero -->
    <section class="relative overflow-hidden hero-faq-bg">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 text-center relative">
        <nav aria-label="Breadcrumb" class="flex justify-center mb-8">
          <ol class="flex items-center gap-3 text-sm text-gray-400">
            <li><a href={localizedPath(locale)} class="hover:text-[#2B77EE] transition-colors">{t("prop_firm_faq.hub_breadcrumb_home")}</a></li>
            <li><i class="fa-solid fa-chevron-right text-[10px] text-gray-600"></i></li>
            <li class="text-[#2B77EE]">{t("prop_firm_faq.hub_breadcrumb_current")}</li>
          </ol>
        </nav>
        <h1 class="text-4xl md:text-6xl font-extrabold mb-6 leading-[1.1] text-white tracking-tight">
          {t("prop_firm_faq.hub_hero_h1_pre")}<span class="text-[#2B77EE]">{t("prop_firm_faq.hub_hero_h1_accent")}</span><br class="hidden md:block">
          {t("prop_firm_faq.hub_hero_h1_post")}
        </h1>
        <p class="text-gray-300 text-base md:text-lg max-w-3xl mx-auto mb-4 leading-relaxed">
          {t("prop_firm_faq.hub_hero_p")}
        </p>
        <p class="text-xs text-white/50 mb-8"><i class="far fa-clock mr-1"></i>{t("prop_firm_faq.hub_hero_updated_label")}<time datetime="2026-05-25">{t("prop_firm_faq.hub_hero_updated_date")}</time></p>
        <div class="flex flex-wrap gap-4 justify-center">
          <a href="https://app.pickmytrade.trade/?register=true" class="px-8 py-3 bg-brand-blue text-white font-semibold rounded-xl transition-all duration-300 shadow-brand-blue inline-flex items-center gap-2">
            {t("prop_firm_faq.hub_hero_cta_trial")} <i class="fa-solid fa-arrow-right"></i>
          </a>
          <a href="#browse" class="px-8 py-3 border border-white/20 hover:border-[#2B77EE]/50 text-white font-semibold rounded-xl transition-all duration-300 hover:bg-white/5 inline-flex items-center gap-2">
            {t("prop_firm_faq.hub_hero_cta_browse")} <i class="fa-solid fa-chevron-down text-sm"></i>
          </a>
        </div>
      </div>
    </section>

    <!-- Browse Prop Firms -->
    <section id="browse" class="bg-deep-navy browse-pad px-4">
      <div class="max-w-7xl mx-auto text-center mb-16">
        <span class="inline-flex items-center gap-2 px-5 py-2 rounded-full border border-brand-blue-40 bg-brand-blue-10 text-[#2B77EE] text-[11px] font-semibold uppercase tracking-[0.18em] mb-6">
          <i class="fa-solid fa-arrow-down text-[10px]"></i> {t("prop_firm_faq.hub_browse_badge")}
        </span>
        <h2 class="text-3xl md:text-4xl font-bold text-white mb-4 tracking-tight">{t("prop_firm_faq.hub_browse_h2")}</h2>
        <p class="text-gray-400 text-base md:text-lg max-w-3xl mx-auto leading-relaxed">
          {t("prop_firm_faq.hub_browse_p")}
        </p>
      </div>
      <div class="max-w-7xl mx-auto">

      <!-- Tier 1: The Big Three -->
      <div class="mb-12">
        <h2 class="text-2xl md:text-3xl font-bold mb-6 pb-3 border-b-2 border-[#2B77EE] flex items-center gap-3">
          <i class="fa-solid fa-trophy text-[#2B77EE]" aria-hidden="true"></i>{t("prop_firm_faq.hub_tier1_heading")}
          <span class="ml-auto text-xs text-gray-500 font-normal">{t("prop_firm_faq.hub_tier1_count")}</span>
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">

        <a href={localizedPath(locale, "prop-firm-faq/apex-trader-funding-faq")} class="bg-[#001429] border border-white/10 rounded-xl p-5 hover:border-[#2B77EE]/50 hover:bg-[#001f3f] transition-all group">
          <div class="flex items-start gap-4">
            <div class="w-12 h-12 bg-[#2B77EE]/20 rounded-lg flex items-center justify-center text-[#2B77EE] text-xl flex-shrink-0">
              <i class="fa-solid fa-bolt" aria-hidden="true"></i>
            </div>
            <div class="flex-1 min-w-0">
              <h3 class="text-white font-bold text-lg electrolize group-hover:text-[#2B77EE] transition-colors truncate mb-1">{t("prop_firm_faq.hub_card_apex_title")}</h3>
              <p class="text-gray-400 text-sm mb-3">{t("prop_firm_faq.hub_card_apex_text")}</p>
              <span class="text-[#2B77EE] text-xs font-semibold inline-flex items-center gap-1 group-hover:gap-2 transition-all">{t("prop_firm_faq.hub_read_faq")} <i class="fa-solid fa-arrow-right text-[10px]"></i></span>
            </div>
          </div>
        </a>

        <a href={localizedPath(locale, "prop-firm-faq/myfundedfutures-faq")} class="bg-[#001429] border border-white/10 rounded-xl p-5 hover:border-[#2B77EE]/50 hover:bg-[#001f3f] transition-all group">
          <div class="flex items-start gap-4">
            <div class="w-12 h-12 bg-[#2B77EE]/20 rounded-lg flex items-center justify-center text-[#2B77EE] text-xl flex-shrink-0">
              <i class="fa-solid fa-mountain" aria-hidden="true"></i>
            </div>
            <div class="flex-1 min-w-0">
              <h3 class="text-white font-bold text-lg electrolize group-hover:text-[#2B77EE] transition-colors truncate mb-1">{t("prop_firm_faq.hub_card_mffu_title")}</h3>
              <p class="text-gray-400 text-sm mb-3">{t("prop_firm_faq.hub_card_mffu_text")}</p>
              <span class="text-[#2B77EE] text-xs font-semibold inline-flex items-center gap-1 group-hover:gap-2 transition-all">{t("prop_firm_faq.hub_read_faq")} <i class="fa-solid fa-arrow-right text-[10px]"></i></span>
            </div>
          </div>
        </a>

        </div>
      </div>

      <!-- Tier 2: Established Firms -->
      <div class="mb-12">
        <h2 class="text-2xl md:text-3xl font-bold mb-6 pb-3 border-b-2 border-[#2B77EE] flex items-center gap-3">
          <i class="fa-solid fa-building-columns text-[#2B77EE]" aria-hidden="true"></i>{t("prop_firm_faq.hub_tier2_heading")}
          <span class="ml-auto text-xs text-gray-500 font-normal">{t("prop_firm_faq.hub_tier2_count")}</span>
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">

        <a href={localizedPath(locale, "prop-firm-faq/take-profit-trader-faq")} class="bg-[#001429] border border-white/10 rounded-xl p-5 hover:border-[#2B77EE]/50 hover:bg-[#001f3f] transition-all group">
          <div class="flex items-start gap-4">
            <div class="w-12 h-12 bg-[#2B77EE]/20 rounded-lg flex items-center justify-center text-[#2B77EE] text-xl flex-shrink-0">
              <i class="fa-solid fa-arrow-trend-up" aria-hidden="true"></i>
            </div>
            <div class="flex-1 min-w-0">
              <h3 class="text-white font-bold text-lg electrolize group-hover:text-[#2B77EE] transition-colors truncate mb-1">{t("prop_firm_faq.hub_card_tpt_title")}</h3>
              <p class="text-gray-400 text-sm mb-3">{t("prop_firm_faq.hub_card_tpt_text")}</p>
              <span class="text-[#2B77EE] text-xs font-semibold inline-flex items-center gap-1 group-hover:gap-2 transition-all">{t("prop_firm_faq.hub_read_faq")} <i class="fa-solid fa-arrow-right text-[10px]"></i></span>
            </div>
          </div>
        </a>

        <a href={localizedPath(locale, "prop-firm-faq/tradeify-faq")} class="bg-[#001429] border border-white/10 rounded-xl p-5 hover:border-[#2B77EE]/50 hover:bg-[#001f3f] transition-all group">
          <div class="flex items-start gap-4">
            <div class="w-12 h-12 bg-[#2B77EE]/20 rounded-lg flex items-center justify-center text-[#2B77EE] text-xl flex-shrink-0">
              <i class="fa-solid fa-bullseye" aria-hidden="true"></i>
            </div>
            <div class="flex-1 min-w-0">
              <h3 class="text-white font-bold text-lg electrolize group-hover:text-[#2B77EE] transition-colors truncate mb-1">{t("prop_firm_faq.hub_card_tradeify_title")}</h3>
              <p class="text-gray-400 text-sm mb-3">{t("prop_firm_faq.hub_card_tradeify_text")}</p>
              <span class="text-[#2B77EE] text-xs font-semibold inline-flex items-center gap-1 group-hover:gap-2 transition-all">{t("prop_firm_faq.hub_read_faq")} <i class="fa-solid fa-arrow-right text-[10px]"></i></span>
            </div>
          </div>
        </a>

        <a href={localizedPath(locale, "prop-firm-faq/alpha-futures-faq")} class="bg-[#001429] border border-white/10 rounded-xl p-5 hover:border-[#2B77EE]/50 hover:bg-[#001f3f] transition-all group">
          <div class="flex items-start gap-4">
            <div class="w-12 h-12 bg-[#2B77EE]/20 rounded-lg flex items-center justify-center text-[#2B77EE] text-xl flex-shrink-0">
              <i class="fa-solid fa-bolt" aria-hidden="true"></i>
            </div>
            <div class="flex-1 min-w-0">
              <h3 class="text-white font-bold text-lg electrolize group-hover:text-[#2B77EE] transition-colors truncate mb-1">{t("prop_firm_faq.hub_card_alpha_title")}</h3>
              <p class="text-gray-400 text-sm mb-3">{t("prop_firm_faq.hub_card_alpha_text")}</p>
              <span class="text-[#2B77EE] text-xs font-semibold inline-flex items-center gap-1 group-hover:gap-2 transition-all">{t("prop_firm_faq.hub_read_faq")} <i class="fa-solid fa-arrow-right text-[10px]"></i></span>
            </div>
          </div>
        </a>

        <a href={localizedPath(locale, "trading-psychology-faq")} class="bg-[#001429] border border-white/10 rounded-xl p-5 hover:border-[#2B77EE]/50 hover:bg-[#001f3f] transition-all group">
          <div class="flex items-start gap-4">
            <div class="w-12 h-12 bg-[#2B77EE]/20 rounded-lg flex items-center justify-center text-[#2B77EE] text-xl flex-shrink-0">
              <i class="fa-solid fa-brain" aria-hidden="true"></i>
            </div>
            <div class="flex-1 min-w-0">
              <h3 class="text-white font-bold text-lg electrolize group-hover:text-[#2B77EE] transition-colors truncate mb-1">{t("prop_firm_faq.hub_card_psych_title")}</h3>
              <p class="text-gray-400 text-sm mb-3">{t("prop_firm_faq.hub_card_psych_text")}</p>
              <span class="text-[#2B77EE] text-xs font-semibold inline-flex items-center gap-1 group-hover:gap-2 transition-all">{t("prop_firm_faq.hub_read_faq")} <i class="fa-solid fa-arrow-right text-[10px]"></i></span>
            </div>
          </div>
        </a>

        <a href={localizedPath(locale, "tradingview-indicators-faq")} class="bg-[#001429] border border-white/10 rounded-xl p-5 hover:border-[#2B77EE]/50 hover:bg-[#001f3f] transition-all group">
          <div class="flex items-start gap-4">
            <div class="w-12 h-12 bg-[#2B77EE]/20 rounded-lg flex items-center justify-center text-[#2B77EE] text-xl flex-shrink-0">
              <i class="fa-solid fa-chart-line" aria-hidden="true"></i>
            </div>
            <div class="flex-1 min-w-0">
              <h3 class="text-white font-bold text-lg electrolize group-hover:text-[#2B77EE] transition-colors truncate mb-1">{t("prop_firm_faq.hub_card_indicators_title")}</h3>
              <p class="text-gray-400 text-sm mb-3">{t("prop_firm_faq.hub_card_indicators_text")}</p>
              <span class="text-[#2B77EE] text-xs font-semibold inline-flex items-center gap-1 group-hover:gap-2 transition-all">{t("prop_firm_faq.hub_read_faq")} <i class="fa-solid fa-arrow-right text-[10px]"></i></span>
            </div>
          </div>
        </a>

        <a href={localizedPath(locale, "prop-firm-faq/topstep-faq")} class="bg-[#001429] border border-white/10 rounded-xl p-5 hover:border-[#2B77EE]/50 hover:bg-[#001f3f] transition-all group">
          <div class="flex items-start gap-4">
            <div class="w-12 h-12 bg-[#2B77EE]/20 rounded-lg flex items-center justify-center text-[#2B77EE] text-xl flex-shrink-0">
              <i class="fa-solid fa-chart-line" aria-hidden="true"></i>
            </div>
            <div class="flex-1 min-w-0">
              <h3 class="text-white font-bold text-lg electrolize group-hover:text-[#2B77EE] transition-colors truncate mb-1">{t("prop_firm_faq.hub_card_topstepfaq_title")}</h3>
              <p class="text-gray-400 text-sm mb-3">{t("prop_firm_faq.hub_card_topstepfaq_text")}</p>
              <span class="text-[#2B77EE] text-xs font-semibold inline-flex items-center gap-1 group-hover:gap-2 transition-all">{t("prop_firm_faq.hub_read_faq")} <i class="fa-solid fa-arrow-right text-[10px]"></i></span>
            </div>
          </div>
        </a>

        <a href={localizedPath(locale, "prop-firm-faq/fundednext-faq")} class="bg-[#001429] border border-white/10 rounded-xl p-5 hover:border-[#2B77EE]/50 hover:bg-[#001f3f] transition-all group">
          <div class="flex items-start gap-4">
            <div class="w-12 h-12 bg-[#2B77EE]/20 rounded-lg flex items-center justify-center text-[#2B77EE] text-xl flex-shrink-0">
              <i class="fa-solid fa-rocket" aria-hidden="true"></i>
            </div>
            <div class="flex-1 min-w-0">
              <h3 class="text-white font-bold text-lg electrolize group-hover:text-[#2B77EE] transition-colors truncate mb-1">{t("prop_firm_faq.hub_card_fundednext_title")}</h3>
              <p class="text-gray-400 text-sm mb-3">{t("prop_firm_faq.hub_card_fundednext_text")}</p>
              <span class="text-[#2B77EE] text-xs font-semibold inline-flex items-center gap-1 group-hover:gap-2 transition-all">{t("prop_firm_faq.hub_read_faq")} <i class="fa-solid fa-arrow-right text-[10px]"></i></span>
            </div>
          </div>
        </a>

        <a href={localizedPath(locale, "prop-firm-faq/fundingpips-faq")} class="bg-[#001429] border border-white/10 rounded-xl p-5 hover:border-[#2B77EE]/50 hover:bg-[#001f3f] transition-all group">
          <div class="flex items-start gap-4">
            <div class="w-12 h-12 bg-[#2B77EE]/20 rounded-lg flex items-center justify-center text-[#2B77EE] text-xl flex-shrink-0">
              <i class="fa-solid fa-coins" aria-hidden="true"></i>
            </div>
            <div class="flex-1 min-w-0">
              <h3 class="text-white font-bold text-lg electrolize group-hover:text-[#2B77EE] transition-colors truncate mb-1">{t("prop_firm_faq.hub_card_fundingpips_title")}</h3>
              <p class="text-gray-400 text-sm mb-3">{t("prop_firm_faq.hub_card_fundingpips_text")}</p>
              <span class="text-[#2B77EE] text-xs font-semibold inline-flex items-center gap-1 group-hover:gap-2 transition-all">{t("prop_firm_faq.hub_read_faq")} <i class="fa-solid fa-arrow-right text-[10px]"></i></span>
            </div>
          </div>
        </a>

        <a href={localizedPath(locale, "prop-firm-faq/goat-funded-trader-faq")} class="bg-[#001429] border border-white/10 rounded-xl p-5 hover:border-[#2B77EE]/50 hover:bg-[#001f3f] transition-all group">
          <div class="flex items-start gap-4">
            <div class="w-12 h-12 bg-[#2B77EE]/20 rounded-lg flex items-center justify-center text-[#2B77EE] text-xl flex-shrink-0">
              <i class="fa-solid fa-trophy" aria-hidden="true"></i>
            </div>
            <div class="flex-1 min-w-0">
              <h3 class="text-white font-bold text-lg electrolize group-hover:text-[#2B77EE] transition-colors truncate mb-1">{t("prop_firm_faq.hub_card_goat_title")}</h3>
              <p class="text-gray-400 text-sm mb-3">{t("prop_firm_faq.hub_card_goat_text")}</p>
              <span class="text-[#2B77EE] text-xs font-semibold inline-flex items-center gap-1 group-hover:gap-2 transition-all">{t("prop_firm_faq.hub_read_faq")} <i class="fa-solid fa-arrow-right text-[10px]"></i></span>
