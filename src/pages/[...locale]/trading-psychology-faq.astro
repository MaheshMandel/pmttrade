---
import BaseLayout from "../../layouts/BaseLayout.astro";
import AuthorByline from "../../components/AuthorByline.astro";
import { getLocalePaths, useTranslations, localizedPath } from "../../i18n/utils";
import type { Locale } from "../../i18n/config";
import '../../styles/prop-firm-faq.css';

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };
const t = useTranslations(locale);

const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const PAGE_URL = `${SITE_URL}${withSlash(localizedPath(locale, "trading-psychology-faq"))}`;
const LAST_UPDATED = "2026-10-06";

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": `${SITE_URL}${withSlash(localizedPath(locale))}` },
    { "@type": "ListItem", "position": 2, "name": "Trading Psychology FAQ", "item": PAGE_URL },
  ],
};

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: t("prop_firm_faq.psych_hero_title"),
  description: t("prop_firm_faq.psych_meta_description"),
  publisher: { "@type": "Organization", name: "PickMyTrade", logo: { "@type": "ImageObject", url: `${SITE_URL}/assets/logo.png` } },
  datePublished: "2026-10-06",
  dateModified: LAST_UPDATED,
  mainEntityOfPage: { "@type": "WebPage", "@id": PAGE_URL },
};
const stripHtml = (s: string) =>
  s.replace(/<[^>]+>/g, "").replace(/&#x27;|&#39;/g, "'").replace(/&quot;/g, '"').replace(/&lt;/g, "<").replace(/&gt;/g, ">").replace(/&amp;/g, "&").trim();

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": Array.from({ length: 16 }, (_, i) => ({
    "@type": "Question",
    name: t(`prop_firm_faq.psych_faq_${i + 1}_q`),
    acceptedAnswer: { "@type": "Answer", text: stripHtml(t(`prop_firm_faq.psych_faq_${i + 1}_a`)) },
  })),
};
---

<BaseLayout
  locale={locale}
  title={t("prop_firm_faq.psych_meta_title")}
  description={t("prop_firm_faq.psych_meta_description")}
  ogType="article"
  ldJson={[breadcrumbSchema, articleSchema, faqSchema]}
>
<div class="bg-[#001429]">
<div class="ambient-glow-1" aria-hidden="true"></div>
<div class="ambient-glow-2" aria-hidden="true"></div>

<div class="page-content">

<section class="hero-section">
  <div class="hero-glow" aria-hidden="true"></div>
  <div class="hero-inner">
    <span class="hero-eyebrow"><i class="fa-solid fa-brain" aria-hidden="true"></i> {t("prop_firm_faq.psych_hero_eyebrow")}</span>
    <h1 class="hero-title">{t("prop_firm_faq.psych_hero_title")}</h1>
    <p class="hero-description">{t("prop_firm_faq.psych_hero_description")}</p>
    <div class="flex justify-center mb-2">
      <AuthorByline locale={locale} lastUpdated={LAST_UPDATED} />
    </div>
  </div>
</section>

<section class="search-section">
  <div class="search-wrap">
    <label for="faq-search" class="search-label"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i> {t("prop_firm_faq.psych_search_label")}</label>
    <div class="search-input-wrap">
      <i class="fa-solid fa-search search-icon" aria-hidden="true"></i>
      <input type="text" id="faq-search" class="search-input" placeholder={t("prop_firm_faq.psych_search_placeholder")} autocomplete="off" aria-controls="faq-content" />
      <span class="search-shortcut" aria-hidden="true">/</span>
    </div>
    <div class="search-info" id="search-info" role="status" aria-live="polite"></div>
  </div>
</section>

<main class="faq-main" id="faq-content">
  <div class="faq-main-inner">
<section id="faq" class="cat-section">
  <div class="cat-header"><div class="cat-icon"><i class="fa-solid fa-brain"></i></div><h2 class="cat-title">{t("prop_firm_faq.psych_cat_title")}</h2><span class="cat-count">{t("prop_firm_faq.psych_cat_count")}</span></div>
  <div class="faq-group">
<details class="gfaq-item"><summary class="gfaq-summary"><span class="gfaq-question">{t("prop_firm_faq.psych_faq_1_q")}</span><span class="gfaq-toggle" aria-hidden="true">+</span></summary><div class="gfaq-answer" set:html={t("prop_firm_faq.psych_faq_1_a")}></div></details>
<details class="gfaq-item"><summary class="gfaq-summary"><span class="gfaq-question">{t("prop_firm_faq.psych_faq_2_q")}</span><span class="gfaq-toggle" aria-hidden="true">+</span></summary><div class="gfaq-answer" set:html={t("prop_firm_faq.psych_faq_2_a")}></div></details>
<details class="gfaq-item"><summary class="gfaq-summary"><span class="gfaq-question">{t("prop_firm_faq.psych_faq_3_q")}</span><span class="gfaq-toggle" aria-hidden="true">+</span></summary><div class="gfaq-answer" set:html={t("prop_firm_faq.psych_faq_3_a")}></div></details>
<details class="gfaq-item"><summary class="gfaq-summary"><span class="gfaq-question">{t("prop_firm_faq.psych_faq_4_q")}</span><span class="gfaq-toggle" aria-hidden="true">+</span></summary><div class="gfaq-answer" set:html={t("prop_firm_faq.psych_faq_4_a")}></div></details>
<details class="gfaq-item"><summary class="gfaq-summary"><span class="gfaq-question">{t("prop_firm_faq.psych_faq_5_q")}</span><span class="gfaq-toggle" aria-hidden="true">+</span></summary><div class="gfaq-answer" set:html={t("prop_firm_faq.psych_faq_5_a")}></div></details>
<details class="gfaq-item"><summary class="gfaq-summary"><span class="gfaq-question">{t("prop_firm_faq.psych_faq_6_q")}</span><span class="gfaq-toggle" aria-hidden="true">+</span></summary><div class="gfaq-answer" set:html={t("prop_firm_faq.psych_faq_6_a")}></div></details>
<details class="gfaq-item"><summary class="gfaq-summary"><span class="gfaq-question">{t("prop_firm_faq.psych_faq_7_q")}</span><span class="gfaq-toggle" aria-hidden="true">+</span></summary><div class="gfaq-answer" set:html={t("prop_firm_faq.psych_faq_7_a")}></div></details>
<details class="gfaq-item"><summary class="gfaq-summary"><span class="gfaq-question">{t("prop_firm_faq.psych_faq_8_q")}</span><span class="gfaq-toggle" aria-hidden="true">+</span></summary><div class="gfaq-answer" set:html={t("prop_firm_faq.psych_faq_8_a")}></div></details>
<details class="gfaq-item"><summary class="gfaq-summary"><span class="gfaq-question">{t("prop_firm_faq.psych_faq_9_q")}</span><span class="gfaq-toggle" aria-hidden="true">+</span></summary><div class="gfaq-answer" set:html={t("prop_firm_faq.psych_faq_9_a")}></div></details>
<details class="gfaq-item"><summary class="gfaq-summary"><span class="gfaq-question">{t("prop_firm_faq.psych_faq_10_q")}</span><span class="gfaq-toggle" aria-hidden="true">+</span></summary><div class="gfaq-answer" set:html={t("prop_firm_faq.psych_faq_10_a")}></div></details>
<details class="gfaq-item"><summary class="gfaq-summary"><span class="gfaq-question">{t("prop_firm_faq.psych_faq_11_q")}</span><span class="gfaq-toggle" aria-hidden="true">+</span></summary><div class="gfaq-answer" set:html={t("prop_firm_faq.psych_faq_11_a")}></div></details>
<details class="gfaq-item"><summary class="gfaq-summary"><span class="gfaq-question">{t("prop_firm_faq.psych_faq_12_q")}</span><span class="gfaq-toggle" aria-hidden="true">+</span></summary><div class="gfaq-answer" set:html={t("prop_firm_faq.psych_faq_12_a")}></div></details>
<details class="gfaq-item"><summary class="gfaq-summary"><span class="gfaq-question">{t("prop_firm_faq.psych_faq_13_q")}</span><span class="gfaq-toggle" aria-hidden="true">+</span></summary><div class="gfaq-answer" set:html={t("prop_firm_faq.psych_faq_13_a")}></div></details>
<details class="gfaq-item"><summary class="gfaq-summary"><span class="gfaq-question">{t("prop_firm_faq.psych_faq_14_q")}</span><span class="gfaq-toggle" aria-hidden="true">+</span></summary><div class="gfaq-answer" set:html={t("prop_firm_faq.psych_faq_14_a")}></div></details>
<details class="gfaq-item"><summary class="gfaq-summary"><span class="gfaq-question">{t("prop_firm_faq.psych_faq_15_q")}</span><span class="gfaq-toggle" aria-hidden="true">+</span></summary><div class="gfaq-answer" set:html={t("prop_firm_faq.psych_faq_15_a")}></div></details>
<details class="gfaq-item"><summary class="gfaq-summary"><span class="gfaq-question">{t("prop_firm_faq.psych_faq_16_q")}</span><span class="gfaq-toggle" aria-hidden="true">+</span></summary><div class="gfaq-answer" set:html={t("prop_firm_faq.psych_faq_16_a")}></div></details>
  </div>
</section>
  </div>
</main>

<section class="toc-section">
  <div class="toc-section-inner">
    <h2 class="toc-heading">{t("prop_firm_faq.psych_related_heading")}</h2>
    <div class="toc-grid">
      <a href={localizedPath(locale, "prop-firm-faq")} class="toc-card"><div class="toc-icon"><i class="fa-solid fa-arrow-right"></i></div><div class="toc-card-body"><div class="toc-cat-name">{t("prop_firm_faq.psych_related_1")}</div></div></a>
      <a href={localizedPath(locale, "tradingview-indicators-faq")} class="toc-card"><div class="toc-icon"><i class="fa-solid fa-arrow-right"></i></div><div class="toc-card-body"><div class="toc-cat-name">{t("prop_firm_faq.psych_related_2")}</div></div></a>
    </div>
  </div>
</section>

</div>
</div>
<script src="/scripts/faq.js" defer is:inline></script>
</BaseLayout>
