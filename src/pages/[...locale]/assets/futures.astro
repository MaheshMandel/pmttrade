---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getLocalePaths, useTranslations, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };
const t = useTranslations(locale);
---

<BaseLayout
  locale={locale}
  title={t("assets.futures_meta_title")}
  description={t("assets.futures_meta_description")}
  ogType="article"
>
  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": "Futures Trading Automation for Tradovate | TradingView Integration",
    "description": "Automate futures trading on Tradovate from TradingView. Support for ES, NQ, CL, GC and all major contracts. Ultra-low latency execution. Start free trial.",
    "url": "https://pickmytrade.trade/assets/futures/",
    "author": { "@id": "https://pickmytrade.trade/#organization" }
  }
  </script>

  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "What Futures instruments can I automate on Tradovate?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "You can automate any Futures instruments supported by Tradovate, including ES, NQ, YM, RTY, CL, GC, SI, and all CME/CBOT futures contracts. PickMyTrade works seamlessly with all TradingView alerts for Futures trading on Tradovate."
        }
      },
      {
        "@type": "Question",
        "name": "Do I need coding skills to automate Tradovate?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "No coding required! PickMyTrade is a no-code solution. Simply connect your Tradovate account, copy the webhook URL, and paste it into TradingView. Setup takes under 5 minutes."
        }
      },
      {
        "@type": "Question",
        "name": "How fast are Futures trades executed on Tradovate?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "PickMyTrade executes Futures trades on Tradovate within seconds of receiving the TradingView webhook. Our ultra-low latency infrastructure ensures minimal slippage for optimal fills."
        }
      },
      {
        "@type": "Question",
        "name": "Can I trade Futures on multiple Tradovate accounts?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes! PickMyTrade supports multi-account automation. Execute the same Futures strategy across multiple Tradovate accounts simultaneously with individual risk settings for each account."
        }
      },
      {
        "@type": "Question",
        "name": "Is there a free trial for Tradovate automation?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes! PickMyTrade offers a 7-day free trial with full access to all Futures automation features for Tradovate. No credit card required to start."
        }
      }
    ]
  }
  </script>

  <script type="application/ld+json" is:inline>
  {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://pickmytrade.trade"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Asset Classes",
      "item": "https://pickmytrade.trade/assets/"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": "Futures Trading Automation",
      "item": "https://pickmytrade.trade/assets/futures/"
    }
  ]
}
  </script>

  <style>
    .electrolize-regular { font-family: 'Electrolize', sans-serif; font-weight: 400; }
    .gradient-text { background: linear-gradient(135deg, #2B77EE, #0F3EC3); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; }
  </style>

  <!-- Breadcrumb -->
  <nav aria-label="Breadcrumb" class="bg-[#001429] pt-20 pb-4">
    <div class="max-w-7xl mx-auto px-4">
      <ol class="flex items-center gap-2 text-sm text-gray-400">
        <li><a href={localizedPath(locale)} class="hover:text-blue-400">{t("assets.futures_breadcrumb_home")}</a></li>
        <li>/</li>
        <li><a href={`${localizedPath(locale)}#assets`} class="hover:text-blue-400">{t("assets.futures_breadcrumb_asset_classes")}</a></li>
        <li>/</li>
        <li class="text-white font-semibold">{t("assets.futures_breadcrumb_current")}</li>
      </ol>
    </div>
  </nav>

  <!-- Hero Section -->
  <header class="relative overflow-hidden bg-gradient-to-b from-[#001429] via-[#001f3f] to-[#002040] py-16 sm:py-24">
    <div class="absolute inset-0 opacity-10">
      <div class="absolute top-20 left-1/4 w-96 h-96 bg-[#2B77EE] rounded-full blur-3xl"></div>
      <div class="absolute bottom-10 right-1/4 w-80 h-80 bg-blue-500 rounded-full blur-3xl"></div>
    </div>

    <div class="relative z-10 max-w-7xl mx-auto px-4 text-center">
      <div class="inline-flex items-center gap-2 mb-6 bg-[#2B77EE]/20 border border-[#2B77EE]/30 rounded-full px-5 py-2">
        <i class="fa-solid fa-chart-line text-[#2B77EE]"></i>
        <span class="text-sm font-semibold text-[#2B77EE] uppercase tracking-wider electrolize-regular">{t("assets.futures_hero_badge")}</span>
      </div>

      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold mb-6">
        <span class="text-white">{t("assets.futures_hero_h1_pre")}</span><br>
        <span class="gradient-text electrolize-regular">{t("assets.futures_hero_h1_gradient")}</span>
      </h1>

      <p class="text-lg sm:text-xl text-gray-300 max-w-3xl mx-auto mb-8 leading-relaxed">
        {t("assets.futures_hero_subtitle")}
      </p>

      <div class="flex flex-col sm:flex-row gap-4 justify-center mb-10">
        <a href="https://app.pickmytrade.trade/?register=true"
          class="electrolize-regular px-8 py-4 bg-gradient-to-r from-[#2B77EE] to-blue-700 rounded-xl font-semibold text-white shadow-lg hover:shadow-blue-500/50 transition-all duration-300 transform hover:scale-105">
          {t("assets.futures_hero_cta_primary")}
        </a>
        <a href="https://docs.pickmytrade.trade/docs/"
          class="electrolize-regular px-8 py-4 bg-white/10 backdrop-blur-sm border border-white/20 rounded-xl font-semibold text-white hover:bg-white/20 transition-all duration-300">
          {t("assets.futures_hero_cta_secondary")}
        </a>
      </div>

      <div class="flex flex-wrap items-center justify-center gap-6 text-sm">
        <div class="flex items-center gap-2 bg-white/5 border border-white/10 rounded-full px-4 py-2">
          <i class="fa-solid fa-check-circle text-green-400"></i>
          <span class="text-gray-300">{t("assets.futures_hero_pill_1")}</span>
        </div>
        <div class="flex items-center gap-2 bg-white/5 border border-white/10 rounded-full px-4 py-2">
          <i class="fa-solid fa-credit-card text-green-400"></i>
          <span class="text-gray-300">{t("assets.futures_hero_pill_2")}</span>
        </div>
        <div class="flex items-center gap-2 bg-white/5 border border-white/10 rounded-full px-4 py-2">
          <i class="fa-solid fa-bolt text-yellow-400"></i>
          <span class="text-gray-300">{t("assets.futures_hero_pill_3")}</span>
        </div>
      </div>
    </div>
  </header>

  <!-- Why Automate Section -->
  <section class="bg-[#002040] py-16 border-b border-blue-900/30">
    <div class="max-w-7xl mx-auto px-4">
      <h2 class="text-3xl sm:text-4xl font-bold text-center mb-12">
        {t("assets.futures_why_h2_pre")} <span class="gradient-text">{t("assets.futures_why_h2_gradient")}</span>
      </h2>

      <div class="grid md:grid-cols-3 gap-8">
        <div class="bg-[#001429] border border-[#2B77EE]/30 rounded-xl p-6">
          <div class="w-12 h-12 bg-[#2B77EE]/20 rounded-lg flex items-center justify-center mb-4">
            <i class="fa-solid fa-clock text-[#2B77EE] text-xl"></i>
          </div>
          <h3 class="text-xl font-bold mb-2">{t("assets.futures_why_1_title")}</h3>
          <p class="text-gray-400">{t("assets.futures_why_1_text")}</p>
        </div>

        <div class="bg-[#001429] border border-blue-500/30 rounded-xl p-6">
          <div class="w-12 h-12 bg-blue-500/20 rounded-lg flex items-center justify-center mb-4">
            <i class="fa-solid fa-bolt text-blue-400 text-xl"></i>
          </div>
          <h3 class="text-xl font-bold mb-2">{t("assets.futures_why_2_title")}</h3>
          <p class="text-gray-400">{t("assets.futures_why_2_text")}</p>
        </div>

        <div class="bg-[#001429] border border-green-500/30 rounded-xl p-6">
          <div class="w-12 h-12 bg-green-500/20 rounded-lg flex items-center justify-center mb-4">
            <i class="fa-solid fa-shield-halved text-green-400 text-xl"></i>
          </div>
          <h3 class="text-xl font-bold mb-2">{t("assets.futures_why_3_title")}</h3>
          <p class="text-gray-400">{t("assets.futures_why_3_text")}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Supported Contracts -->
  <section class="bg-[#001429] py-16 border-b border-blue-900/30">
    <div class="max-w-7xl mx-auto px-4">
      <h2 class="text-3xl sm:text-4xl font-bold text-center mb-12">
        {t("assets.futures_contracts_h2_pre")} <span class="gradient-text">{t("assets.futures_contracts_h2_gradient")}</span>
      </h2>

      <div class="text-center">
        <p class="text-gray-400 mb-8 text-lg">{t("assets.futures_contracts_subtitle")}</p>

        <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
          <div class="px-6 py-4 bg-gradient-to-br from-[#002040] to-[#001429] border border-[#2B77EE]/30 rounded-xl">
            <div class="text-[#2B77EE] text-2xl font-bold mb-2">ES</div>
            <p class="text-gray-300">{t("assets.futures_contract_es")}</p>
          </div>
          <div class="px-6 py-4 bg-gradient-to-br from-[#002040] to-[#001429] border border-[#2B77EE]/30 rounded-xl">
            <div class="text-[#2B77EE] text-2xl font-bold mb-2">NQ</div>
            <p class="text-gray-300">{t("assets.futures_contract_nq")}</p>
          </div>
          <div class="px-6 py-4 bg-gradient-to-br from-[#002040] to-[#001429] border border-[#2B77EE]/30 rounded-xl">
            <div class="text-[#2B77EE] text-2xl font-bold mb-2">CL</div>
            <p class="text-gray-300">{t("assets.futures_contract_cl")}</p>
          </div>
          <div class="px-6 py-4 bg-gradient-to-br from-[#002040] to-[#001429] border border-[#2B77EE]/30 rounded-xl">
            <div class="text-[#2B77EE] text-2xl font-bold mb-2">GC</div>
            <p class="text-gray-300">{t("assets.futures_contract_gc")}</p>
          </div>
          <div class="px-6 py-4 bg-gradient-to-br from-[#002040] to-[#001429] border border-[#2B77EE]/30 rounded-xl">
            <div class="text-[#2B77EE] text-2xl font-bold mb-2">YM</div>
            <p class="text-gray-300">{t("assets.futures_contract_ym")}</p>
          </div>
          <div class="px-6 py-4 bg-gradient-to-br from-[#002040] to-[#001429] border border-[#2B77EE]/30 rounded-xl">
            <div class="text-[#2B77EE] text-2xl font-bold mb-2">RTY</div>
            <p class="text-gray-300">{t("assets.futures_contract_rty")}</p>
          </div>
          <div class="px-6 py-4 bg-gradient-to-br from-[#002040] to-[#001429] border border-[#2B77EE]/30 rounded-xl">
            <div class="text-[#2B77EE] text-2xl font-bold mb-2">SI</div>
            <p class="text-gray-300">{t("assets.futures_contract_si")}</p>
          </div>
          <div class="px-6 py-4 bg-gradient-to-br from-[#002040] to-[#001429] border border-[#2B77EE]/30 rounded-xl">
            <div class="text-[#2B77EE] text-2xl font-bold mb-2">ALL</div>
            <p class="text-gray-300">{t("assets.futures_contract_all")}</p>
          </div>
        </div>

        <a href="https://docs.pickmytrade.trade/docs/" class="inline-block px-6 py-3 bg-[#2B77EE]/20 border border-[#2B77EE]/40 rounded-xl text-[#2B77EE] hover:bg-[#2B77EE]/30 font-semibold transition-all electrolize-regular">
          {t("assets.futures_contracts_view_full")} <i class="fa-solid fa-arrow-right ml-1"></i>
        </a>
      </div>
    </div>
  </section>

  <!-- How It Works -->
  <section class="bg-[#002040] py-16 border-b border-blue-900/30">
    <div class="max-w-7xl mx-auto px-4">
      <h2 class="text-3xl sm:text-4xl font-bold text-center mb-12">
        {t("assets.futures_how_h2_pre")} <span class="gradient-text">{t("assets.futures_how_h2_gradient")}</span>
      </h2>

      <div class="grid md:grid-cols-3 gap-8">
        <div class="text-center">
          <div class="w-16 h-16 bg-gradient-to-r from-[#2B77EE] to-blue-600 rounded-full flex items-center justify-center mx-auto mb-6 text-2xl font-bold electrolize-regular">1</div>
          <h3 class="text-xl font-bold mb-3">{t("assets.futures_how_1_title")}</h3>
          <p class="text-gray-400">{t("assets.futures_how_1_text")}</p>
        </div>

        <div class="text-center">
          <div class="w-16 h-16 bg-gradient-to-r from-[#2B77EE] to-blue-600 rounded-full flex items-center justify-center mx-auto mb-6 text-2xl font-bold electrolize-regular">2</div>
          <h3 class="text-xl font-bold mb-3">{t("assets.futures_how_2_title")}</h3>
          <p class="text-gray-400">{t("assets.futures_how_2_text")}</p>
        </div>

        <div class="text-center">
          <div class="w-16 h-16 bg-gradient-to-r from-[#2B77EE] to-blue-600 rounded-full flex items-center justify-center mx-auto mb-6 text-2xl font-bold electrolize-regular">3</div>
          <h3 class="text-xl font-bold mb-3">{t("assets.futures_how_3_title")}</h3>
          <p class="text-gray-400">{t("assets.futures_how_3_text")}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="bg-[#001429] py-16">
    <div class="max-w-7xl mx-auto px-4">
      <div class="grid lg:grid-cols-[400px,1fr] gap-12 lg:gap-16">
        <!-- Left Column: Heading -->
        <div>
          <h2 class="text-3xl sm:text-4xl font-bold mb-6">
            {t("assets.futures_faq_h2")}
          </h2>
          <p class="text-gray-400 text-lg">
            {t("assets.futures_faq_subtitle_pre")}
            <a href={localizedPath(locale, "pages/contact-us")} class="text-blue-400 hover:text-blue-300 underline">{t("assets.futures_faq_subtitle_link")}</a> {t("assets.futures_faq_subtitle_post")}
          </p>
        </div>

        <!-- Right Column: Q&A -->
        <div class="space-y-10">
          <div>
            <h3 class="text-xl font-bold text-white mb-3">{t("assets.futures_faq_1_q")}</h3>
            <p class="text-gray-400 leading-relaxed">
              {t("assets.futures_faq_1_a")}
            </p>
          </div>

          <div>
            <h3 class="text-xl font-bold text-white mb-3">{t("assets.futures_faq_2_q")}</h3>
            <p class="text-gray-400 leading-relaxed">
              {t("assets.futures_faq_2_a")}
            </p>
          </div>

          <div>
            <h3 class="text-xl font-bold text-white mb-3">{t("assets.futures_faq_3_q")}</h3>
            <p class="text-gray-400 leading-relaxed">
              {t("assets.futures_faq_3_a")}
            </p>
          </div>

          <div>
            <h3 class="text-xl font-bold text-white mb-3">{t("assets.futures_faq_4_q")}</h3>
            <p class="text-gray-400 leading-relaxed">
              {t("assets.futures_faq_4_a")}
            </p>
          </div>

          <div>
            <h3 class="text-xl font-bold text-white mb-3">{t("assets.futures_faq_5_q")}</h3>
            <p class="text-gray-400 leading-relaxed">
              {t("assets.futures_faq_5_a")}
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="bg-gradient-to-r from-blue-600 to-blue-700 py-16">
    <div class="max-w-4xl mx-auto px-4 text-center">
      <h2 class="text-3xl sm:text-4xl font-bold mb-6">
        {t("assets.futures_cta_h2")}
      </h2>
      <p class="text-xl text-blue-100 mb-8">
        {t("assets.futures_cta_text")}
      </p>
      <a href="https://app.pickmytrade.trade/?register=true"
        class="electrolize-regular inline-block px-8 py-4 bg-white text-blue-700 rounded-xl font-semibold shadow-xl hover:shadow-2xl transform hover:-translate-y-1 transition-all duration-300">
        {t("assets.futures_cta_button")}
      </a>
    </div>
  </section>
</BaseLayout>
