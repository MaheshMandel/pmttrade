---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getLocalePaths, useTranslations, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };
const t = useTranslations(locale);
---

<BaseLayout
  locale={locale}
  title={t("assets.options_meta_title")}
  description={t("assets.options_meta_description")}
  ogType="article"
>
  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": "Options Trading Automation | TradingView Integration",
    "description": "Automate options trading from TradingView. Execute calls, puts, and spreads automatically.",
    "url": "https://pickmytrade.trade/assets/options/",
    "author": { "@id": "https://pickmytrade.trade/#organization" }
  }
  </script>

  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "What options brokers are supported?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "PickMyTrade supports major options brokers including Interactive Brokers, TradeStation, and more. Connect your broker and start automating options trades from TradingView."
        }
      },
      {
        "@type": "Question",
        "name": "Can I automate complex options strategies?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes, you can automate calls, puts, spreads, straddles, strangles, and other complex options strategies supported by your broker."
        }
      },
      {
        "@type": "Question",
        "name": "Do I need coding skills?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "No coding required! PickMyTrade is a no-code solution. Simply connect your broker, copy the webhook URL, and paste it into TradingView."
        }
      },
      {
        "@type": "Question",
        "name": "Is there a free trial?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes! PickMyTrade offers a 7-day free trial with full access to all options automation features. No credit card required."
        }
      }
    ]
  }
  </script>

  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://pickmytrade.trade"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Asset Classes",
        "item": "https://pickmytrade.trade/assets/"
      },
      {
        "@type": "ListItem",
        "position": 3,
        "name": "Options Trading Automation",
        "item": "https://pickmytrade.trade/assets/options/"
      }
    ]
  }
  </script>

  <style>
    .electrolize-regular { font-family: 'Electrolize', sans-serif; font-weight: 400; }
    .gradient-text { background: linear-gradient(135deg, #2B77EE, #0F3EC3); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; }
  </style>

  <!-- Breadcrumb -->
  <nav aria-label="Breadcrumb" class="bg-[#001429] pt-20 pb-4">
    <div class="max-w-7xl mx-auto px-4">
      <ol class="flex items-center gap-2 text-sm text-gray-400">
        <li><a href={localizedPath(locale)} class="hover:text-blue-400">{t("assets.options_breadcrumb_home")}</a></li>
        <li>/</li>
        <li><a href={`${localizedPath(locale)}#assets`} class="hover:text-blue-400">{t("assets.options_breadcrumb_asset_classes")}</a></li>
        <li>/</li>
        <li class="text-white font-semibold">{t("assets.options_breadcrumb_current")}</li>
      </ol>
    </div>
  </nav>

  <!-- Hero Section -->
  <header class="relative overflow-hidden bg-gradient-to-b from-[#001429] via-[#001f3f] to-[#002040] py-16 sm:py-24">
    <div class="absolute inset-0 opacity-10">
      <div class="absolute top-20 left-1/4 w-96 h-96 bg-[#2B77EE] rounded-full blur-3xl"></div>
      <div class="absolute bottom-10 right-1/4 w-80 h-80 bg-blue-500 rounded-full blur-3xl"></div>
    </div>

    <div class="relative z-10 max-w-7xl mx-auto px-4 text-center">
      <div class="inline-flex items-center gap-2 mb-6 bg-[#2B77EE]/20 border border-[#2B77EE]/30 rounded-full px-5 py-2">
        <i class="fa-solid fa-arrow-trend-up text-[#2B77EE]"></i>
        <span class="text-sm font-semibold text-[#2B77EE] uppercase tracking-wider electrolize-regular">{t("assets.options_hero_badge")}</span>
      </div>

      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold mb-6">
        <span class="text-white">{t("assets.options_hero_h1_pre")}</span><br>
        <span class="gradient-text electrolize-regular">{t("assets.options_hero_h1_gradient")}</span>
      </h1>

      <p class="text-lg sm:text-xl text-gray-300 max-w-3xl mx-auto mb-8 leading-relaxed">
        {t("assets.options_hero_subtitle")}
      </p>

      <div class="flex flex-col sm:flex-row gap-4 justify-center mb-10">
        <a href="https://app.pickmytrade.trade/?register=true"
          class="electrolize-regular px-8 py-4 bg-gradient-to-r from-[#2B77EE] to-blue-700 rounded-xl font-semibold text-white shadow-lg hover:shadow-blue-500/50 transition-all duration-300 transform hover:scale-105">
          {t("assets.options_hero_cta_primary")}
        </a>
        <a href="https://docs.pickmytrade.trade/docs/"
          class="electrolize-regular px-8 py-4 bg-white/10 backdrop-blur-sm border border-white/20 rounded-xl font-semibold text-white hover:bg-white/20 transition-all duration-300">
          {t("assets.options_hero_cta_secondary")}
        </a>
      </div>

      <div class="flex flex-wrap items-center justify-center gap-6 text-sm">
        <div class="flex items-center gap-2 bg-white/5 border border-white/10 rounded-full px-4 py-2">
          <i class="fa-solid fa-check-circle text-green-400"></i>
          <span class="text-gray-300">{t("assets.options_hero_pill_1")}</span>
        </div>
        <div class="flex items-center gap-2 bg-white/5 border border-white/10 rounded-full px-4 py-2">
          <i class="fa-solid fa-credit-card text-green-400"></i>
          <span class="text-gray-300">{t("assets.options_hero_pill_2")}</span>
        </div>
        <div class="flex items-center gap-2 bg-white/5 border border-white/10 rounded-full px-4 py-2">
          <i class="fa-solid fa-bolt text-yellow-400"></i>
          <span class="text-gray-300">{t("assets.options_hero_pill_3")}</span>
        </div>
      </div>
    </div>
  </header>

  <!-- Why Automate Section -->
  <section class="bg-[#002040] py-16 border-b border-blue-900/30">
    <div class="max-w-7xl mx-auto px-4">
      <h2 class="text-3xl sm:text-4xl font-bold text-center mb-12">
        {t("assets.options_why_h2_pre")} <span class="gradient-text">{t("assets.options_why_h2_gradient")}</span>
      </h2>

      <div class="grid md:grid-cols-3 gap-8">
        <div class="bg-[#001429] border border-[#2B77EE]/30 rounded-xl p-6">
          <div class="w-12 h-12 bg-[#2B77EE]/20 rounded-lg flex items-center justify-center mb-4">
            <i class="fa-solid fa-clock text-[#2B77EE] text-xl"></i>
          </div>
          <h3 class="text-xl font-bold mb-2">{t("assets.options_why_1_title")}</h3>
          <p class="text-gray-400">{t("assets.options_why_1_text")}</p>
        </div>

        <div class="bg-[#001429] border border-blue-500/30 rounded-xl p-6">
          <div class="w-12 h-12 bg-blue-500/20 rounded-lg flex items-center justify-center mb-4">
            <i class="fa-solid fa-layer-group text-blue-400 text-xl"></i>
          </div>
          <h3 class="text-xl font-bold mb-2">{t("assets.options_why_2_title")}</h3>
          <p class="text-gray-400">{t("assets.options_why_2_text")}</p>
        </div>

        <div class="bg-[#001429] border border-green-500/30 rounded-xl p-6">
          <div class="w-12 h-12 bg-green-500/20 rounded-lg flex items-center justify-center mb-4">
            <i class="fa-solid fa-chart-line text-green-400 text-xl"></i>
          </div>
          <h3 class="text-xl font-bold mb-2">{t("assets.options_why_3_title")}</h3>
          <p class="text-gray-400">{t("assets.options_why_3_text")}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Supported Brokers -->
  <section class="bg-[#001429] py-16 border-b border-blue-900/30">
    <div class="max-w-6xl mx-auto px-4">
      <h2 class="text-3xl sm:text-4xl font-bold text-center mb-12">
        {t("assets.options_brokers_h2_pre")} <span class="gradient-text">{t("assets.options_brokers_h2_gradient")}</span>
      </h2>

      <div class="text-center">
        <p class="text-gray-400 mb-8 text-lg">{t("assets.options_brokers_subtitle")}</p>

        <div class="flex flex-wrap justify-center gap-4 mb-8">
          <span class="px-6 py-3 bg-gradient-to-br from-[#002040] to-[#001429] border border-[#2B77EE]/30 rounded-xl text-white font-semibold">Interactive Brokers</span>
          <span class="px-6 py-3 bg-gradient-to-br from-[#002040] to-[#001429] border border-[#2B77EE]/30 rounded-xl text-white font-semibold">TradeStation</span>
          <span class="px-6 py-3 bg-gradient-to-br from-[#002040] to-[#001429] border border-[#2B77EE]/30 rounded-xl text-white font-semibold">Tastytrade</span>
          <span class="px-6 py-3 bg-gradient-to-br from-[#002040] to-[#001429] border border-[#2B77EE]/30 rounded-xl text-white font-semibold">{t("assets.options_brokers_and_more")}</span>
        </div>

        <a href="https://docs.pickmytrade.trade/docs/" class="inline-block px-6 py-3 bg-[#2B77EE]/20 border border-[#2B77EE]/40 rounded-xl text-[#2B77EE] hover:bg-[#2B77EE]/30 font-semibold transition-all electrolize-regular">
          {t("assets.options_brokers_view_all")} <i class="fa-solid fa-arrow-right ml-1"></i>
        </a>
      </div>
    </div>
  </section>

  <!-- Supported Strategies -->
  <section class="bg-[#002040] py-16 border-b border-blue-900/30">
    <div class="max-w-7xl mx-auto px-4">
      <h2 class="text-3xl sm:text-4xl font-bold text-center mb-12">
        {t("assets.options_strategies_h2_pre")} <span class="gradient-text">{t("assets.options_strategies_h2_gradient")}</span>
      </h2>

      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-4">
        <div class="px-6 py-4 bg-[#001429] border border-[#2B77EE]/30 rounded-xl text-center">
          <div class="text-[#2B77EE] text-xl font-bold mb-2"><i class="fa-solid fa-arrow-up"></i> {t("assets.options_strategy_calls_title")}</div>
          <p class="text-gray-300 text-sm">{t("assets.options_strategy_calls_text")}</p>
        </div>
        <div class="px-6 py-4 bg-[#001429] border border-[#2B77EE]/30 rounded-xl text-center">
          <div class="text-[#2B77EE] text-xl font-bold mb-2"><i class="fa-solid fa-arrow-down"></i> {t("assets.options_strategy_puts_title")}</div>
          <p class="text-gray-300 text-sm">{t("assets.options_strategy_puts_text")}</p>
        </div>
        <div class="px-6 py-4 bg-[#001429] border border-[#2B77EE]/30 rounded-xl text-center">
          <div class="text-[#2B77EE] text-xl font-bold mb-2"><i class="fa-solid fa-arrows-left-right"></i> {t("assets.options_strategy_spreads_title")}</div>
          <p class="text-gray-300 text-sm">{t("assets.options_strategy_spreads_text")}</p>
        </div>
        <div class="px-6 py-4 bg-[#001429] border border-[#2B77EE]/30 rounded-xl text-center">
          <div class="text-[#2B77EE] text-xl font-bold mb-2"><i class="fa-solid fa-layer-group"></i> {t("assets.options_strategy_complex_title")}</div>
          <p class="text-gray-300 text-sm">{t("assets.options_strategy_complex_text")}</p>
        </div>
      </div>

      <div class="text-center mt-8">
        <p class="text-gray-400">{t("assets.options_strategies_custom_note")}</p>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="bg-[#001429] py-16">
    <div class="max-w-7xl mx-auto px-4">
      <div class="grid lg:grid-cols-[400px,1fr] gap-12 lg:gap-16">
        <div>
          <h2 class="text-3xl sm:text-4xl font-bold mb-6">
            {t("assets.options_faq_h2")}
          </h2>
          <p class="text-gray-400 text-lg">
            {t("assets.options_faq_subtitle_pre")}
            <a href={localizedPath(locale, "pages/contact-us")} class="text-blue-400 hover:text-blue-300 underline">{t("assets.options_faq_subtitle_link")}</a> {t("assets.options_faq_subtitle_post")}
          </p>
        </div>

        <div class="space-y-10">
          <div>
            <h3 class="text-xl font-bold text-white mb-3">{t("assets.options_faq_1_q")}</h3>
            <p class="text-gray-400 leading-relaxed">
              {t("assets.options_faq_1_a")}
            </p>
          </div>

          <div>
            <h3 class="text-xl font-bold text-white mb-3">{t("assets.options_faq_2_q")}</h3>
            <p class="text-gray-400 leading-relaxed">
              {t("assets.options_faq_2_a")}
            </p>
          </div>

          <div>
            <h3 class="text-xl font-bold text-white mb-3">{t("assets.options_faq_3_q")}</h3>
            <p class="text-gray-400 leading-relaxed">
              {t("assets.options_faq_3_a")}
            </p>
          </div>

          <div>
            <h3 class="text-xl font-bold text-white mb-3">{t("assets.options_faq_4_q")}</h3>
            <p class="text-gray-400 leading-relaxed">
              {t("assets.options_faq_4_a")}
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="bg-gradient-to-r from-blue-600 to-blue-700 py-16">
    <div class="max-w-4xl mx-auto px-4 text-center">
      <h2 class="text-3xl sm:text-4xl font-bold mb-6">
        {t("assets.options_cta_h2")}
      </h2>
      <p class="text-xl text-blue-100 mb-8">
        {t("assets.options_cta_text")}
      </p>
      <a href="https://app.pickmytrade.trade/?register=true"
        class="electrolize-regular inline-block px-8 py-4 bg-white text-blue-700 rounded-xl font-semibold shadow-xl hover:shadow-2xl transform hover:-translate-y-1 transition-all duration-300">
        {t("assets.options_cta_button")}
      </a>
    </div>
  </section>
</BaseLayout>
