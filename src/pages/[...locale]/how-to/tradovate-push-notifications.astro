---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "tradovate-push-notifications";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/how-to/${SLUG}`;

const META_TITLE = "Set Up Push Notifications on Tradovate Mobile";
const META_DESCRIPTION =
  "Turn on mobile push alerts for filled, rejected, and working futures orders so you never miss a fill while you're away from your trading screen.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Push-Benachrichtigungen in der Tradovate-Mobile-App einrichten", es: "Configure las notificaciones push en Tradovate Mobile", fr: "Configurer les notifications push sur Tradovate Mobile", it: "Configurare le notifiche push su Tradovate Mobile" },
  dek: { en: "You step away for a coffee, an order fills or gets rejected, and you don't find out until you're back at the desk. Push notifications close that gap, here's how to turn them on.", de: "Sie holen sich kurz einen Kaffee, eine Order wird ausgeführt oder abgelehnt, und Sie erfahren es erst, wenn Sie wieder am Schreibtisch sitzen. Push-Benachrichtigungen schließen diese Lücke, so schalten Sie sie ein.", es: "Se aleja un momento a tomar un café, una orden se ejecuta o es rechazada, y usted no se entera hasta que vuelve al escritorio. Las notificaciones push cierran esa brecha; aquí le explicamos cómo activarlas.", fr: "Vous vous éloignez le temps d'un café, un ordre est exécuté ou rejeté, et vous ne l'apprenez qu'en revenant à votre bureau. Les notifications push comblent ce vide ; voici comment les activer.", it: "Si allontana per un caffè, un ordine viene eseguito o rifiutato, e lo scopre solo quando torna alla scrivania. Le notifiche push colmano questo vuoto; ecco come attivarle." },
  readTime: { en: "6 min read", de: "6 Min. Lesezeit", es: "Lectura de 6 min", fr: "Lecture : 6 min", it: "Lettura di 6 min" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "Here's the scenario every futures trader knows. You step away from the screen for a coffee, an order fills or gets rejected, and you don't find out until you're back at the desk twenty minutes later. Push notifications on the Tradovate mobile app close that gap. Once they're on, your phone buzzes the moment an order changes state, so you can react whether you're on the platform or not." },
    { type: "paragraph", html: "The whole setup takes about two minutes. You turn it on in two places: your phone has to allow the app to send notifications, and the app itself has to know which order statuses you actually care about. Here's how to do both." },
    { type: "heading", text: "Before You Start" },
    {
      type: "list",
      items: [
        "Install the Tradovate mobile app (search \"Tradovate\" on the App Store or Google Play) and make sure it's updated to the latest version.",
        "Sign in with the same account you trade on. If you're on a prop-firm or evaluation account, the steps are identical, though your firm may control some account settings, so check your firm's current rules if anything looks locked.",
        "Have a couple of minutes and your phone unlocked. That's it.",
      ],
    },
    { type: "heading", text: "Turn On Push Notifications, Step by Step" },
    {
      type: "steps",
      items: [
        { title: "Install or Update the App", html: "Push alerts only fire from the mobile app, so it needs to be installed and current. Grab it from the App Store or Google Play, or open your app store and tap Update if you already have it. Older builds sometimes miss the notification settings entirely, so don't skip this. Sign in once it's up to date." },
        { title: "Allow Notifications on Your Phone", html: "The first time you open the app, your phone asks whether Tradovate can send you notifications. Tap <strong class='text-white'>Allow</strong>. This is the device-level permission, and if you tapped \"Don't Allow\" earlier, the app can't reach you no matter what you switch on inside it. You can fix that later in your phone's own Settings under Notifications, then find the Tradovate app and turn notifications back on." },
        { title: "Open the Menu and Scroll to Settings", html: "Inside the app, tap the menu icon in the top-left corner to open the side drawer. Scroll down until you reach <strong class='text-white'>Settings</strong>. This is where all the app-side preferences live, including the notification controls." },
        { title: "Tap Push Notifications", html: "In Settings, look for <strong class='text-white'>Push Notifications</strong> and tap it. This opens the list of order statuses you can subscribe to. Worth knowing: push notifications are the ones that pop up outside the app on your lock screen. They're separate from the internal alerts you see inside the app while it's open, so turning these on is what actually reaches you when the app is closed." },
        { title: "Choose Which Statuses to Receive", html: "Now toggle on the order statuses you want a push for. You don't have to enable all of them. Most traders keep <strong class='text-white'>Filled</strong> and <strong class='text-white'>Rejected</strong> on at minimum, since those are the two events you can't afford to miss. Flip on anything else that matters to your workflow and back out; the choices save as you go." },
      ],
    },
    { type: "heading", text: "Which Statuses Should You Turn On?" },
    { type: "paragraph", html: "You can get a push for every state an order can move through. Here's what each one means so you can decide what's signal and what's noise." },
    {
      type: "table",
      headers: ["Status", "What it tells you"],
      rows: [
        ["Working", "Your order is live and resting at the exchange."],
        ["Filled", "The order executed. Turn this on."],
        ["Partial Fill", "Only part of your quantity filled; the rest is still working."],
        ["Stop Fill", "A stop order triggered and filled."],
        ["Canceled", "The order was canceled and is no longer working."],
        ["Rejected", "The order was rejected and never reached the market. Turn this on."],
        ["Suspended", "The order is waiting on a condition (common with OCO/OSO legs and GTC orders between sessions) before it goes working."],
        ["Expired", "The order expired at the exchange without filling."],
        ["Modification Rejected", "An edit to a working order was refused, so the original order stands."],
      ],
    },
    { type: "paragraph", html: "If you're trading automated strategies, the Rejected and Modification Rejected alerts are the ones that save you. They tell you instantly when the platform didn't do what your system expected." },
    { type: "heading", text: "Not Getting Notifications?" },
    { type: "paragraph", html: "If the alerts aren't coming through, run down this short list:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Check the phone permission.</strong> Open your device Settings, go to Notifications, find the Tradovate app, and confirm notifications are allowed. This is the single most common cause.",
        "<strong class='text-white'>Turn off Do Not Disturb / Focus.</strong> A silenced phone will hold every alert back.",
        "<strong class='text-white'>Confirm the in-app toggles are on.</strong> Device permission and the app's own Push Notifications list are two separate switches. Both have to be on.",
        "<strong class='text-white'>Update the app.</strong> An out-of-date build can hide or break the settings.",
      ],
    },
    { type: "heading", text: "Automate This with PickMyTrade" },
    { type: "paragraph", html: "Want your orders to fire automatically instead of just getting pinged after the fact? <strong class='text-white'>PickMyTrade turns your TradingView alerts into live Tradovate orders</strong> so the entries, stops, and targets place themselves while you watch the notifications roll in." },
  ], de: [
    { type: "paragraph",html: "Das Szenario kennt jeder Futures-Trader: Sie gehen für einen Kaffee kurz vom Bildschirm weg, eine Order wird ausgeführt oder abgelehnt, und Sie erfahren es erst zwanzig Minuten später am Schreibtisch. Push-Benachrichtigungen in der Tradovate-Mobile-App schließen diese Lücke. Sind sie aktiviert, vibriert Ihr Handy in dem Moment, in dem eine Order ihren Status ändert, sodass Sie reagieren können, egal ob Sie an der Plattform sind oder nicht." },
    { type: "paragraph",html: "Die Einrichtung dauert etwa zwei Minuten. Sie aktivieren sie an zwei Stellen: Ihr Telefon muss der App das Senden von Benachrichtigungen erlauben, und die App selbst muss wissen, welche Order-Status Sie tatsächlich interessieren. So gehen Sie bei beidem vor." },
    { type: "heading",text: "Bevor Sie beginnen" },
    {
      type: "list",
      items: [
        "Installieren Sie die Tradovate-Mobile-App (suchen Sie im App Store oder bei Google Play nach „Tradovate“) und stellen Sie sicher, dass sie auf dem neuesten Stand ist.",
        "Melden Sie sich mit demselben Konto an, auf dem Sie handeln. Bei einem Prop-Firm- oder Evaluierungskonto sind die Schritte identisch, allerdings kann Ihre Firma einige Kontoeinstellungen steuern. Prüfen Sie daher die aktuellen Regeln Ihrer Firma, falls etwas gesperrt aussieht.",
        "Nehmen Sie sich ein paar Minuten Zeit und entsperren Sie Ihr Handy. Mehr brauchen Sie nicht.",
      ],
    },
    { type: "heading",text: "Push-Benachrichtigungen aktivieren, Schritt für Schritt" },
    {
      type: "steps",
      items: [
        { title: "App installieren oder aktualisieren", html: "Push-Alerts werden nur von der Mobile-App ausgelöst, daher muss sie installiert und aktuell sein. Laden Sie sie aus dem App Store oder von Google Play herunter oder öffnen Sie Ihren App Store und tippen Sie auf „Aktualisieren“, falls Sie sie bereits haben. Ältere Versionen enthalten die Benachrichtigungseinstellungen manchmal gar nicht, überspringen Sie diesen Schritt also nicht. Melden Sie sich an, sobald die App aktuell ist." },
        { title: "Benachrichtigungen auf Ihrem Telefon erlauben", html: "Beim ersten Öffnen der App fragt Ihr Telefon, ob Tradovate Ihnen Benachrichtigungen senden darf. Tippen Sie auf <strong class='text-white'>Allow</strong>. Dies ist die Berechtigung auf Geräteebene: Haben Sie zuvor „Nicht erlauben“ gewählt, kann die App Sie nicht erreichen, egal was Sie in ihr einschalten. Sie können das später in den Einstellungen Ihres Telefons unter „Benachrichtigungen“ korrigieren, indem Sie die Tradovate-App suchen und die Benachrichtigungen wieder aktivieren." },
        { title: "Menü öffnen und zu Settings scrollen", html: "Tippen Sie in der App oben links auf das Menüsymbol, um die Seitenleiste zu öffnen. Scrollen Sie nach unten bis zu <strong class='text-white'>Settings</strong>. Hier befinden sich alle App-Einstellungen, einschließlich der Benachrichtigungssteuerung." },
        { title: "Auf Push Notifications tippen", html: "Suchen Sie in den Settings nach <strong class='text-white'>Push Notifications</strong> und tippen Sie darauf. Es öffnet sich die Liste der Order-Status, die Sie abonnieren können. Gut zu wissen: Push-Benachrichtigungen sind die, die außerhalb der App auf Ihrem Sperrbildschirm erscheinen. Sie sind getrennt von den internen Hinweisen, die Sie in der geöffneten App sehen. Erst mit diesen Einstellungen erreicht Sie eine Meldung, wenn die App geschlossen ist." },
        { title: "Auswählen, welche Status Sie erhalten möchten", html: "Aktivieren Sie nun die Order-Status, für die Sie eine Push-Meldung möchten. Sie müssen nicht alle einschalten. Die meisten Trader lassen mindestens <strong class='text-white'>Filled</strong> und <strong class='text-white'>Rejected</strong> aktiv, denn diese beiden Ereignisse dürfen Sie nicht verpassen. Aktivieren Sie alles, was für Ihren Ablauf wichtig ist, und gehen Sie zurück; die Auswahl wird automatisch gespeichert." },
      ],
    },
    { type: "heading",text: "Welche Status sollten Sie aktivieren?" },
    { type: "paragraph",html: "Sie können für jeden Zustand, den eine Order durchlaufen kann, eine Push-Meldung erhalten. Hier sehen Sie, was jeder Status bedeutet, damit Sie entscheiden können, was Signal und was Rauschen ist." },
    { type: "table", headers: ["Status","Was er Ihnen mitteilt"], rows: [
      ["Working","Ihre Order ist aktiv und liegt an der Börse."],
      ["Filled","Die Order wurde ausgeführt. Aktivieren Sie diesen Status."],
      ["Partial Fill","Nur ein Teil Ihrer Menge wurde ausgeführt; der Rest ist weiterhin aktiv."],
      ["Stop Fill","Eine Stop-Order wurde ausgelöst und ausgeführt."],
      ["Canceled","Die Order wurde storniert und ist nicht mehr aktiv."],
      ["Rejected","Die Order wurde abgelehnt und hat den Markt nie erreicht. Aktivieren Sie diesen Status."],
      ["Suspended","Die Order wartet auf eine Bedingung (häufig bei OCO/OSO-Legs und GTC-Orders zwischen den Sitzungen), bevor sie aktiv wird."],
      ["Expired","Die Order ist an der Börse abgelaufen, ohne ausgeführt zu werden."],
      ["Modification Rejected","Eine Änderung an einer aktiven Order wurde abgelehnt, daher bleibt die ursprüngliche Order bestehen."],
    ] },
    { type: "paragraph",html: "Wenn Sie automatisierte Strategien handeln, sind die Meldungen Rejected und Modification Rejected diejenigen, die Ihnen helfen. Sie zeigen Ihnen sofort, wenn die Plattform nicht das getan hat, was Ihr System erwartet hat." },
    { type: "heading",text: "Keine Benachrichtigungen erhalten?" },
    { type: "paragraph",html: "Wenn die Meldungen nicht ankommen, gehen Sie diese kurze Liste durch:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Prüfen Sie die Berechtigung auf dem Telefon.</strong> Öffnen Sie die Geräteeinstellungen, gehen Sie zu „Benachrichtigungen“, suchen Sie die Tradovate-App und vergewissern Sie sich, dass Benachrichtigungen erlaubt sind. Das ist mit Abstand die häufigste Ursache.",
        "<strong class='text-white'>Deaktivieren Sie „Nicht stören“ / Fokus.</strong> Ein stummgeschaltetes Telefon hält jede Meldung zurück.",
        "<strong class='text-white'>Bestätigen Sie, dass die Schalter in der App aktiv sind.</strong> Die Geräteberechtigung und die Push-Notifications-Liste der App sind zwei getrennte Schalter. Beide müssen eingeschaltet sein.",
        "<strong class='text-white'>Aktualisieren Sie die App.</strong> Eine veraltete Version kann die Einstellungen ausblenden oder beeinträchtigen.",
      ],
    },
    { type: "heading",text: "Automatisieren Sie dies mit PickMyTrade" },
    { type: "paragraph",html: "Möchten Sie, dass Ihre Orders automatisch ausgelöst werden, statt nur im Nachhinein eine Meldung zu bekommen? <strong class='text-white'>PickMyTrade verwandelt Ihre TradingView-Alerts in echte Tradovate-Orders</strong>, sodass Einstiege, Stopps und Ziele sich von selbst platzieren, während Sie die Benachrichtigungen eintreffen sehen." },
  ], es: [
    { type: "paragraph",html: "Este es el escenario que conoce todo trader de futuros. Se aleja de la pantalla para tomar un café, una orden se ejecuta o es rechazada, y no lo descubre hasta que vuelve al escritorio veinte minutos después. Las notificaciones push de la app móvil de Tradovate cierran esa brecha. Una vez activadas, su teléfono vibra en el momento en que una orden cambia de estado, así que puede reaccionar esté o no en la plataforma." },
    { type: "paragraph",html: "La configuración tarda unos dos minutos. Se activa en dos lugares: su teléfono debe permitir que la app envíe notificaciones, y la propia app debe saber qué estados de órdenes le interesan realmente. Así se hace en ambos casos." },
    { type: "heading",text: "Antes de empezar" },
    {
      type: "list",
      items: [
        "Instale la app móvil de Tradovate (busque \"Tradovate\" en el App Store o en Google Play) y asegúrese de que esté actualizada a la última versión.",
        "Inicie sesión con la misma cuenta en la que opera. Si usa una cuenta de prop firm o de evaluación, los pasos son idénticos, aunque su firma puede controlar algunos ajustes de la cuenta, así que consulte las reglas vigentes de su firma si algo aparece bloqueado.",
        "Tenga un par de minutos y su teléfono desbloqueado. Eso es todo.",
      ],
    },
    { type: "heading",text: "Active las notificaciones push, paso a paso" },
    {
      type: "steps",
      items: [
        { title: "Instale o actualice la app", html: "Las alertas push solo se envían desde la app móvil, por lo que debe estar instalada y actualizada. Descárguela desde el App Store o Google Play, o abra su tienda de aplicaciones y toque Actualizar si ya la tiene. Las versiones antiguas a veces carecen por completo de los ajustes de notificaciones, así que no omita este paso. Inicie sesión una vez que esté actualizada." },
        { title: "Permita las notificaciones en su teléfono", html: "La primera vez que abre la app, su teléfono le pregunta si Tradovate puede enviarle notificaciones. Toque <strong class='text-white'>Allow</strong>. Este es el permiso a nivel de dispositivo: si tocó \"No permitir\" antes, la app no podrá comunicarse con usted por mucho que active dentro de ella. Puede corregirlo más tarde en los Ajustes de su teléfono, en Notificaciones, buscando la app de Tradovate y volviendo a activar las notificaciones." },
        { title: "Abra el menú y desplácese hasta Settings", html: "Dentro de la app, toque el icono de menú en la esquina superior izquierda para abrir el panel lateral. Desplácese hacia abajo hasta llegar a <strong class='text-white'>Settings</strong>. Aquí se encuentran todas las preferencias de la app, incluidos los controles de notificaciones." },
        { title: "Toque Push Notifications", html: "En Settings, busque <strong class='text-white'>Push Notifications</strong> y tóquelo. Se abre la lista de estados de órdenes a los que puede suscribirse. Conviene saber que las notificaciones push son las que aparecen fuera de la app, en la pantalla de bloqueo. Son independientes de las alertas internas que ve dentro de la app mientras está abierta, por lo que activarlas es lo que realmente le llega cuando la app está cerrada." },
        { title: "Elija qué estados desea recibir", html: "Ahora active los estados de órdenes de los que desea recibir una notificación. No es necesario activarlos todos. La mayoría de los traders mantienen activados al menos <strong class='text-white'>Filled</strong> y <strong class='text-white'>Rejected</strong>, ya que son los dos eventos que no puede permitirse perder. Active cualquier otro que sea importante para su forma de operar y salga; las opciones se guardan automáticamente." },
      ],
    },
    { type: "heading",text: "¿Qué estados debería activar?" },
    { type: "paragraph",html: "Puede recibir una notificación por cada estado por el que puede pasar una orden. Esto es lo que significa cada uno, para que decida qué es señal y qué es ruido." },
    { type: "table", headers: ["Estado","Qué le indica"], rows: [
      ["Working","Su orden está activa y en espera en el mercado."],
      ["Filled","La orden se ejecutó. Active este estado."],
      ["Partial Fill","Solo se ejecutó una parte de su cantidad; el resto sigue activo."],
      ["Stop Fill","Una orden stop se activó y se ejecutó."],
      ["Canceled","La orden se canceló y ya no está activa."],
      ["Rejected","La orden fue rechazada y nunca llegó al mercado. Active este estado."],
      ["Suspended","La orden espera una condición (habitual en patas OCO/OSO y órdenes GTC entre sesiones) antes de pasar a activa."],
      ["Expired","La orden expiró en el mercado sin ejecutarse."],
      ["Modification Rejected","Se rechazó una modificación de una orden activa, por lo que la orden original se mantiene."],
    ] },
    { type: "paragraph",html: "Si opera estrategias automatizadas, las alertas Rejected y Modification Rejected son las que le salvan. Le avisan al instante cuando la plataforma no hizo lo que su sistema esperaba." },
    { type: "heading",text: "¿No recibe notificaciones?" },
    { type: "paragraph",html: "Si las alertas no llegan, repase esta breve lista:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Compruebe el permiso del teléfono.</strong> Abra los Ajustes del dispositivo, vaya a Notificaciones, busque la app de Tradovate y confirme que las notificaciones están permitidas. Es, con diferencia, la causa más común.",
        "<strong class='text-white'>Desactive No molestar / Concentración.</strong> Un teléfono silenciado retiene todas las alertas.",
        "<strong class='text-white'>Confirme que los interruptores de la app están activados.</strong> El permiso del dispositivo y la lista de Push Notifications de la app son dos interruptores distintos. Ambos deben estar activados.",
        "<strong class='text-white'>Actualice la app.</strong> Una versión desactualizada puede ocultar o romper los ajustes.",
      ],
    },
    { type: "heading",text: "Automatice esto con PickMyTrade" },
    { type: "paragraph",html: "¿Quiere que sus órdenes se envíen automáticamente en lugar de recibir un aviso después? <strong class='text-white'>PickMyTrade convierte sus alertas de TradingView en órdenes reales de Tradovate</strong>, de modo que las entradas, los stops y los objetivos se colocan solos mientras usted ve llegar las notificaciones." },
  ], fr: [
    { type: "paragraph",html: "Voici un scénario que tout trader de futures connaît. Vous vous éloignez de l'écran pour un café, un ordre est exécuté ou rejeté, et vous ne l'apprenez qu'une fois revenu à votre bureau, vingt minutes plus tard. Les notifications push de l'application mobile Tradovate comblent ce vide. Une fois activées, votre téléphone vibre dès qu'un ordre change d'état, ce qui vous permet de réagir que vous soyez sur la plateforme ou non." },
    { type: "paragraph",html: "La configuration prend environ deux minutes. Vous l'activez à deux endroits : votre téléphone doit autoriser l'application à envoyer des notifications, et l'application elle-même doit savoir quels statuts d'ordre vous intéressent réellement. Voici comment faire les deux." },
    { type: "heading",text: "Avant de commencer" },
    {
      type: "list",
      items: [
        "Installez l'application mobile Tradovate (recherchez « Tradovate » sur l'App Store ou Google Play) et assurez-vous qu'elle est à jour.",
        "Connectez-vous avec le même compte que celui sur lequel vous tradez. Si vous utilisez un compte de prop firm ou d'évaluation, les étapes sont identiques, mais votre firme peut contrôler certains paramètres du compte ; vérifiez donc les règles en vigueur de votre firme si quelque chose semble verrouillé.",
        "Prévoyez quelques minutes et déverrouillez votre téléphone. C'est tout.",
      ],
    },
    { type: "heading",text: "Activer les notifications push, étape par étape" },
    {
      type: "steps",
      items: [
        { title: "Installer ou mettre à jour l'application", html: "Les alertes push ne partent que de l'application mobile, qui doit donc être installée et à jour. Téléchargez-la depuis l'App Store ou Google Play, ou ouvrez votre boutique d'applications et appuyez sur Mettre à jour si vous l'avez déjà. Les anciennes versions n'ont parfois pas du tout les paramètres de notification, ne sautez donc pas cette étape. Connectez-vous une fois l'application à jour." },
        { title: "Autoriser les notifications sur votre téléphone", html: "À la première ouverture de l'application, votre téléphone vous demande si Tradovate peut vous envoyer des notifications. Appuyez sur <strong class='text-white'>Allow</strong>. Il s'agit de l'autorisation au niveau de l'appareil : si vous avez appuyé sur « Ne pas autoriser » auparavant, l'application ne peut pas vous joindre, quoi que vous activiez à l'intérieur. Vous pouvez corriger cela plus tard dans les Réglages de votre téléphone, sous Notifications, en retrouvant l'application Tradovate et en réactivant les notifications." },
        { title: "Ouvrir le menu et faire défiler jusqu'à Settings", html: "Dans l'application, appuyez sur l'icône de menu en haut à gauche pour ouvrir le tiroir latéral. Faites défiler vers le bas jusqu'à <strong class='text-white'>Settings</strong>. C'est là que se trouvent toutes les préférences de l'application, y compris les commandes de notification." },
        { title: "Appuyer sur Push Notifications", html: "Dans Settings, repérez <strong class='text-white'>Push Notifications</strong> et appuyez dessus. La liste des statuts d'ordre auxquels vous pouvez vous abonner s'ouvre. À savoir : les notifications push sont celles qui s'affichent en dehors de l'application, sur votre écran verrouillé. Elles sont distinctes des alertes internes que vous voyez dans l'application lorsqu'elle est ouverte ; ce sont donc elles qui vous atteignent lorsque l'application est fermée." },
        { title: "Choisir les statuts à recevoir", html: "Activez maintenant les statuts d'ordre pour lesquels vous souhaitez une notification. Inutile de tous les activer. La plupart des traders gardent au minimum <strong class='text-white'>Filled</strong> et <strong class='text-white'>Rejected</strong>, car ce sont les deux événements que vous ne pouvez pas vous permettre de manquer. Activez tout ce qui compte dans votre façon de trader puis quittez ; vos choix sont enregistrés au fur et à mesure." },
      ],
    },
    { type: "heading",text: "Quels statuts devriez-vous activer ?" },
    { type: "paragraph",html: "Vous pouvez recevoir une notification push pour chaque état par lequel un ordre peut passer. Voici ce que signifie chacun d'eux, afin de décider ce qui est un signal et ce qui est du bruit." },
    { type: "table", headers: ["Statut","Ce qu'il vous indique"], rows: [
      ["Working","Votre ordre est actif et en attente sur le marché."],
      ["Filled","L'ordre a été exécuté. Activez ce statut."],
