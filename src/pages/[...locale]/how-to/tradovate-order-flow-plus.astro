---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "tradovate-order-flow-plus";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/how-to/${SLUG}`;

const META_TITLE = "Subscribe to the Tradovate Order Flow+ Add-On";
const META_DESCRIPTION =
  "Order Flow+ is now free on Tradovate, turn on the add-on and add Volume Profile, VWAP, and Cumulative Delta to your futures charts.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Das Tradovate Order Flow+ Add-on abonnieren", es: "Suscribirse al complemento Order Flow+ de Tradovate", fr: "S'abonner au module complémentaire Order Flow+ de Tradovate", it: "Abbonarsi al componente aggiuntivo Order Flow+ di Tradovate" },
  dek: { en: "Order Flow+ used to be a paid monthly add-on. On Tradovate's current account plans it's included at no extra cost, so subscribing now mostly means switching it on and dropping the tools onto a chart.", de: "Order Flow+ war früher ein kostenpflichtiges monatliches Add-on. In den aktuellen Kontotarifen von Tradovate ist es ohne Aufpreis enthalten. „Abonnieren“ bedeutet heute also meist, es einzuschalten und die Tools auf einen Chart zu legen.", es: "Order Flow+ solía ser un complemento mensual de pago. En los planes de cuenta actuales de Tradovate está incluido sin coste adicional, así que «suscribirse» ahora consiste sobre todo en activarlo y colocar las herramientas en un gráfico.", fr: "Order Flow+ était autrefois un module complémentaire mensuel payant. Dans les formules de compte actuelles de Tradovate, il est inclus sans frais supplémentaires : « s'abonner » revient donc surtout à l'activer et à placer les outils sur un graphique.", it: "Order Flow+ era un componente aggiuntivo mensile a pagamento. Nei piani di conto attuali di Tradovate è incluso senza costi extra, quindi «abbonarsi» significa ormai soprattutto attivarlo e applicare gli strumenti a un grafico." },
  readTime: { en: "5 min read", de: "5 Min. Lesezeit", es: "Lectura de 5 min", fr: "Lecture : 5 min", it: "Lettura di 5 min" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "Order Flow+ is Tradovate's built-in set of order flow tools, Volume Profile, footprint bars, Cumulative Delta, VWAP, and Market Profile (TPO). It used to be a paid monthly add-on. On Tradovate's current account plans it's included at no extra cost, so for most traders \"subscribing\" now means switching it on and dropping the tools onto a chart. Here's how to do both, and what to check if your account still shows it as a paid line item." },
    { type: "heading", text: "What Is Order Flow+ in Tradovate?" },
    { type: "paragraph", html: "Order Flow+ takes you past a plain candlestick chart and shows you <em>who</em> is trading at each price, how much volume traded, whether buyers or sellers leaned on the tape, and where the market keeps coming back to do business. It's the read footprint and profile traders pay third-party platforms for, wired into Tradovate's charts." },
    {
      type: "table",
      headers: ["Tool", "What it shows you"],
      rows: [
        ["Volume Profile", "A horizontal histogram of how much volume traded at each price, so you can spot high-volume nodes and low-volume gaps."],
        ["Volumetric (footprint) bars", "Bid vs ask volume printed inside every candle, exposing absorption and imbalance at the tick level."],
        ["Cumulative Delta", "Running net of aggressive buying minus selling, so you can see pressure building or fading."],
        ["VWAP", "The session's volume-weighted average price, a magnet and fair-value reference many desks trade around."],
        ["Market Profile (TPO)", "A time-at-price map showing where the market spent the most time and where value is forming."],
      ],
    },
    { type: "paragraph", html: "Heads up on cost: Order Flow+ is now bundled with Tradovate's account plans, so there's usually nothing extra to pay. If you're on a prop-firm evaluation account instead of a personal brokerage account, the tools are typically already switched on for you, but availability and any fees vary by firm and account size, so check your firm's current rules if you don't see them. And Order Flow+ is far more useful on a live real-time market data feed; on delayed data the numbers lag the market." },
    { type: "heading", text: "How to Subscribe to Order Flow+ in Tradovate: Step-by-Step" },
    {
      type: "steps",
      items: [
        { title: "Open Application Settings in Tradovate Web", html: "Log in to the web platform at <strong class='text-white'>trader.tradovate.com</strong>. Open the <strong class='text-white'>settings menu in the upper-right corner</strong> of the window and choose <strong class='text-white'>Application Settings</strong>. This is the hub for account tools, risk settings, and the add-on catalog.", image: { src: `${IMG}/tradovate-order-flow-plus-1.png`, alt: "Tradovate web platform with the upper-right settings menu open and Application Settings highlighted" } },
        { title: "Open the Add-ons Tab and Find Order Flow+", html: "Inside Application Settings, click the <strong class='text-white'>Add-ons</strong> tab. Scroll down until you reach the <strong class='text-white'>Order Flow+</strong> entry. Alongside it you'll see its current status, either an option to turn it on, or a note that it's already included with your plan. This same panel is where market data and other add-ons live, so you'll pass a few neighbors on the way down.", image: { src: `${IMG}/tradovate-order-flow-plus-2.png`, alt: "Tradovate Application Settings Add-ons tab scrolled to the Order Flow+ entry" } },
        { title: "Activate Order Flow+", html: "If Order Flow+ shows a <strong class='text-white'>Subscribe</strong>, <strong class='text-white'>Buy</strong>, or <strong class='text-white'>Activate</strong> button, click it to switch the add-on on. On Tradovate's current account plans this is included, so you shouldn't be charged a separate monthly fee for it, but always read the confirmation screen before you accept, since plan terms change. If the entry already reads as active or included, you're done here and can jump straight to the charts.", image: { src: `${IMG}/tradovate-order-flow-plus-3.png`, alt: "Tradovate Order Flow+ add-on activation confirmation showing it is included with the account plan" } },
        { title: "Add the Order Flow+ Tools to a Chart", html: "Turning the add-on on doesn't paint anything by itself, you add each tool to a chart. Open a chart, click the <strong class='text-white'>Indicators</strong> icon on the chart toolbar, and add <strong class='text-white'>Volume Profile</strong>, <strong class='text-white'>VWAP</strong>, and <strong class='text-white'>Cumulative Delta</strong>. For footprint data, change the <strong class='text-white'>chart style to volumetric (footprint) bars</strong> so bid and ask volume print inside every candle. Then tweak each tool's settings until the read matches how you trade.", image: { src: `${IMG}/tradovate-order-flow-plus-4.png`, alt: "Tradovate chart with Order Flow+ tools applied: Volume Profile, VWAP, Cumulative Delta, and volumetric footprint bars" } },
      ],
    },
    { type: "heading", text: "Why You'd Need This" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>See intent, not just price</strong>, footprint and delta show whether a move has real buying behind it or is running on fumes.",
        "<strong class='text-white'>Find better levels</strong> with Volume Profile nodes instead of eyeballing round numbers.",
        "<strong class='text-white'>Time entries around VWAP</strong>, the reference big desks lean on all session.",
        "<strong class='text-white'>Skip the third-party bill</strong> now that the suite ships with your Tradovate plan.",
        "<strong class='text-white'>Confirm your automated signals</strong> by checking order flow before or after a bot fires.",
      ],
    },
    { type: "heading", text: "Automate This with PickMyTrade" },
    { type: "paragraph", html: "Reading order flow is only half the job, you still have to click. <strong class='text-white'>PickMyTrade wires your TradingView alerts straight into your Tradovate account</strong> and fires the order for you, bracket and all, the instant your signal triggers." },
  ], de: [
    { type: "paragraph",html: "Order Flow+ ist das integrierte Set an Order-Flow-Tools von Tradovate: Volume Profile, Footprint-Balken, Cumulative Delta, VWAP und Market Profile (TPO). Früher war es ein kostenpflichtiges monatliches Add-on. In den aktuellen Kontotarifen von Tradovate ist es ohne Aufpreis enthalten, sodass „Abonnieren“ für die meisten Trader heute bedeutet, es einzuschalten und die Tools auf einen Chart zu legen. Hier erfahren Sie, wie beides geht und was Sie prüfen sollten, falls Ihr Konto es noch als kostenpflichtige Position ausweist." },
    { type: "heading",text: "Was ist Order Flow+ in Tradovate?" },
    { type: "paragraph",html: "Order Flow+ bringt Sie über einen einfachen Candlestick-Chart hinaus und zeigt Ihnen, <em>wer</em> zu welchem Preis handelt, wie viel Volumen gehandelt wurde, ob Käufer oder Verkäufer das Tape dominierten und wohin der Markt immer wieder zurückkehrt, um Geschäfte zu machen. Es ist der Einblick, für den Footprint- und Profil-Trader Drittplattformen bezahlen, direkt in die Charts von Tradovate integriert." },
    { type: "table", headers: ["Tool","Was es Ihnen zeigt"], rows: [
      ["Volume Profile","Ein horizontales Histogramm darüber, wie viel Volumen zu welchem Preis gehandelt wurde, damit Sie Volumenknoten mit hohem Volumen und Lücken mit niedrigem Volumen erkennen."],
      ["Volumetrische (Footprint-)Balken","Bid- und Ask-Volumen, innerhalb jeder Kerze gedruckt, das Absorption und Ungleichgewicht auf Tick-Ebene sichtbar macht."],
      ["Cumulative Delta","Der laufende Saldo aus aggressivem Kaufen minus Verkaufen, sodass Sie sehen, wie Druck aufgebaut wird oder nachlässt."],
      ["VWAP","Der volumengewichtete Durchschnittspreis der Sitzung, ein Magnet und eine Referenz für den fairen Wert, an der sich viele Handelstische orientieren."],
      ["Market Profile (TPO)","Eine Zeit-Preis-Karte, die zeigt, wo der Markt die meiste Zeit verbracht hat und wo sich Wert bildet."],
    ] },
    { type: "paragraph",html: "Hinweis zu den Kosten: Order Flow+ ist jetzt in den Kontotarifen von Tradovate gebündelt, daher fällt normalerweise nichts extra an. Wenn Sie ein Evaluierungskonto einer Prop Firm statt eines persönlichen Brokerage-Kontos nutzen, sind die Tools in der Regel bereits für Sie eingeschaltet, doch Verfügbarkeit und eventuelle Gebühren unterscheiden sich je nach Firma und Kontogröße. Prüfen Sie daher die aktuellen Regeln Ihrer Firma, falls Sie sie nicht sehen. Außerdem ist Order Flow+ mit einem Echtzeit-Marktdatenfeed weitaus nützlicher; bei verzögerten Daten hinken die Zahlen dem Markt hinterher." },
    { type: "heading",text: "Order Flow+ in Tradovate abonnieren: Schritt für Schritt" },
    {
      type: "steps",
      items: [
        { title: "Application Settings in Tradovate Web öffnen", html: "Melden Sie sich bei der Webplattform unter <strong class='text-white'>trader.tradovate.com</strong> an. Öffnen Sie das <strong class='text-white'>Einstellungsmenü oben rechts</strong> im Fenster und wählen Sie <strong class='text-white'>Application Settings</strong>. Hier befinden sich Kontotools, Risikoeinstellungen und der Add-on-Katalog.", image: {"src":`${IMG}/tradovate-order-flow-plus-1.png`,"alt":"Tradovate-Webplattform mit geöffnetem Einstellungsmenü oben rechts und hervorgehobenen Application Settings"} },
        { title: "Den Tab Add-ons öffnen und Order Flow+ finden", html: "Klicken Sie in den Application Settings auf den Tab <strong class='text-white'>Add-ons</strong>. Scrollen Sie nach unten, bis Sie den Eintrag <strong class='text-white'>Order Flow+</strong> erreichen. Daneben sehen Sie den aktuellen Status, entweder eine Option zum Einschalten oder einen Hinweis, dass es bereits in Ihrem Tarif enthalten ist. In diesem Bereich befinden sich auch Marktdaten und weitere Add-ons, Sie kommen auf dem Weg nach unten also an einigen Nachbarn vorbei.", image: {"src":`${IMG}/tradovate-order-flow-plus-2.png`,"alt":"Tradovate-Application-Settings, Tab Add-ons, nach unten gescrollt zum Eintrag Order Flow+"} },
        { title: "Order Flow+ aktivieren", html: "Wenn Order Flow+ eine Schaltfläche <strong class='text-white'>Subscribe</strong>, <strong class='text-white'>Buy</strong> oder <strong class='text-white'>Activate</strong> zeigt, klicken Sie darauf, um das Add-on einzuschalten. In den aktuellen Kontotarifen von Tradovate ist es enthalten, Sie sollten dafür also keine separate monatliche Gebühr zahlen. Lesen Sie dennoch immer den Bestätigungsbildschirm, bevor Sie zustimmen, da sich Tarifbedingungen ändern. Wenn der Eintrag bereits als aktiv oder enthalten angezeigt wird, sind Sie hier fertig und können direkt zu den Charts wechseln.", image: {"src":`${IMG}/tradovate-order-flow-plus-3.png`,"alt":"Aktivierungsbestätigung des Tradovate-Add-ons Order Flow+, die zeigt, dass es im Kontotarif enthalten ist"} },
        { title: "Die Order-Flow+-Tools zu einem Chart hinzufügen", html: "Das Einschalten des Add-ons zeichnet nichts von selbst, Sie fügen jedes Tool einem Chart hinzu. Öffnen Sie einen Chart, klicken Sie in der Chart-Symbolleiste auf das Symbol <strong class='text-white'>Indicators</strong> und fügen Sie <strong class='text-white'>Volume Profile</strong>, <strong class='text-white'>VWAP</strong> und <strong class='text-white'>Cumulative Delta</strong> hinzu. Für Footprint-Daten stellen Sie den <strong class='text-white'>Chartstil auf volumetrische (Footprint-)Balken</strong> um, damit Bid- und Ask-Volumen in jeder Kerze erscheinen. Passen Sie anschließend die Einstellungen jedes Tools an, bis die Darstellung zu Ihrer Handelsweise passt.", image: {"src":`${IMG}/tradovate-order-flow-plus-4.png`,"alt":"Tradovate-Chart mit angewendeten Order-Flow+-Tools: Volume Profile, VWAP, Cumulative Delta und volumetrische Footprint-Balken"} },
      ],
    },
    { type: "heading",text: "Warum Sie das brauchen" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Absicht sehen, nicht nur den Preis</strong>, Footprint und Delta zeigen, ob hinter einer Bewegung echtes Kaufinteresse steht oder ob ihr die Luft ausgeht.",
        "<strong class='text-white'>Bessere Level finden</strong> mit Volume-Profile-Knoten statt runde Zahlen nach Augenmaß zu bestimmen.",
        "<strong class='text-white'>Einstiege um den VWAP herum timen</strong>, die Referenz, an der sich große Handelstische die ganze Sitzung orientieren.",
        "<strong class='text-white'>Die Rechnung des Drittanbieters sparen</strong>, da die Suite jetzt in Ihrem Tradovate-Tarif enthalten ist.",
        "<strong class='text-white'>Ihre automatisierten Signale bestätigen</strong>, indem Sie den Order Flow prüfen, bevor oder nachdem ein Bot auslöst.",
      ],
    },
    { type: "heading",text: "Automatisieren Sie das mit PickMyTrade" },
    { type: "paragraph",html: "Order Flow zu lesen ist nur die halbe Arbeit, Sie müssen trotzdem klicken. <strong class='text-white'>PickMyTrade verbindet Ihre TradingView-Alerts direkt mit Ihrem Tradovate-Konto</strong> und löst die Order für Sie aus, samt Bracket, in dem Moment, in dem Ihr Signal auslöst." },
  ], es: [
    { type: "paragraph",html: "Order Flow+ es el conjunto integrado de herramientas de order flow de Tradovate: Volume Profile, barras footprint, Cumulative Delta, VWAP y Market Profile (TPO). Solía ser un complemento mensual de pago. En los planes de cuenta actuales de Tradovate está incluido sin coste adicional, por lo que para la mayoría de los traders «suscribirse» ahora significa activarlo y colocar las herramientas en un gráfico. Aquí tiene cómo hacer ambas cosas y qué revisar si su cuenta todavía lo muestra como un cargo de pago." },
    { type: "heading",text: "¿Qué es Order Flow+ en Tradovate?" },
    { type: "paragraph",html: "Order Flow+ le lleva más allá de un simple gráfico de velas y le muestra <em>quién</em> opera a cada precio, cuánto volumen se negoció, si los compradores o los vendedores se apoyaron en la cinta y dónde vuelve el mercado una y otra vez a hacer negocio. Es la lectura por la que los traders de footprint y de perfil pagan a plataformas de terceros, integrada en los gráficos de Tradovate." },
    { type: "table", headers: ["Herramienta","Qué le muestra"], rows: [
      ["Volume Profile","Un histograma horizontal de cuánto volumen se negoció en cada precio, para detectar nodos de alto volumen y huecos de bajo volumen."],
      ["Barras volumétricas (footprint)","El volumen bid frente al ask impreso dentro de cada vela, que revela absorción y desequilibrio a nivel de tick."],
      ["Cumulative Delta","El neto acumulado de compras agresivas menos ventas, para ver cómo se acumula o se debilita la presión."],
      ["VWAP","El precio promedio ponderado por volumen de la sesión, un imán y una referencia de valor justo en torno a la cual operan muchas mesas."],
      ["Market Profile (TPO)","Un mapa de tiempo por precio que muestra dónde pasó más tiempo el mercado y dónde se está formando el valor."],
    ] },
    { type: "paragraph",html: "Aviso sobre el coste: Order Flow+ está ahora incluido en los planes de cuenta de Tradovate, así que normalmente no hay nada extra que pagar. Si usa una cuenta de evaluación de una prop firm en lugar de una cuenta personal de brokerage, las herramientas suelen estar ya activadas, pero la disponibilidad y las posibles tarifas varían según la firma y el tamaño de la cuenta, así que consulte las reglas vigentes de su firma si no las ve. Además, Order Flow+ resulta mucho más útil con un feed de datos de mercado en tiempo real; con datos retrasados, las cifras van por detrás del mercado." },
    { type: "heading",text: "Cómo suscribirse a Order Flow+ en Tradovate: paso a paso" },
    {
      type: "steps",
      items: [
        { title: "Abra Application Settings en Tradovate Web", html: "Inicie sesión en la plataforma web en <strong class='text-white'>trader.tradovate.com</strong>. Abra el <strong class='text-white'>menú de configuración en la esquina superior derecha</strong> de la ventana y elija <strong class='text-white'>Application Settings</strong>. Es el centro de las herramientas de cuenta, la configuración de riesgo y el catálogo de complementos.", image: {"src":`${IMG}/tradovate-order-flow-plus-1.png`,"alt":"Plataforma web de Tradovate con el menú de configuración superior derecho abierto y Application Settings resaltado"} },
        { title: "Abra la pestaña Add-ons y encuentre Order Flow+", html: "Dentro de Application Settings, haga clic en la pestaña <strong class='text-white'>Add-ons</strong>. Desplácese hacia abajo hasta llegar a la entrada <strong class='text-white'>Order Flow+</strong>. Junto a ella verá su estado actual: una opción para activarlo o una nota de que ya está incluido en su plan. Este mismo panel es donde se encuentran los datos de mercado y otros complementos, así que pasará por algunos vecinos en el camino.", image: {"src":`${IMG}/tradovate-order-flow-plus-2.png`,"alt":"Pestaña Add-ons de Application Settings de Tradovate desplazada hasta la entrada Order Flow+"} },
        { title: "Active Order Flow+", html: "Si Order Flow+ muestra un botón <strong class='text-white'>Subscribe</strong>, <strong class='text-white'>Buy</strong> o <strong class='text-white'>Activate</strong>, haga clic en él para activar el complemento. En los planes de cuenta actuales de Tradovate está incluido, por lo que no debería cobrársele una tarifa mensual aparte, pero lea siempre la pantalla de confirmación antes de aceptar, porque las condiciones del plan cambian. Si la entrada ya figura como activa o incluida, ha terminado aquí y puede pasar directamente a los gráficos.", image: {"src":`${IMG}/tradovate-order-flow-plus-3.png`,"alt":"Confirmación de activación del complemento Order Flow+ de Tradovate indicando que está incluido en el plan de la cuenta"} },
        { title: "Añada las herramientas de Order Flow+ a un gráfico", html: "Activar el complemento no dibuja nada por sí solo, usted añade cada herramienta a un gráfico. Abra un gráfico, haga clic en el icono <strong class='text-white'>Indicators</strong> de la barra de herramientas del gráfico y añada <strong class='text-white'>Volume Profile</strong>, <strong class='text-white'>VWAP</strong> y <strong class='text-white'>Cumulative Delta</strong>. Para datos footprint, cambie el <strong class='text-white'>estilo del gráfico a barras volumétricas (footprint)</strong> para que el volumen bid y ask se imprima dentro de cada vela. Después ajuste la configuración de cada herramienta hasta que la lectura se adapte a su forma de operar.", image: {"src":`${IMG}/tradovate-order-flow-plus-4.png`,"alt":"Gráfico de Tradovate con herramientas de Order Flow+ aplicadas: Volume Profile, VWAP, Cumulative Delta y barras volumétricas footprint"} },
      ],
    },
    { type: "heading",text: "Por qué lo necesitaría" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Ver la intención, no solo el precio</strong>, el footprint y el delta muestran si un movimiento tiene compras reales detrás o se está quedando sin fuerza.",
        "<strong class='text-white'>Encontrar mejores niveles</strong> con los nodos de Volume Profile en lugar de calcular a ojo los números redondos.",
        "<strong class='text-white'>Cronometrar entradas en torno al VWAP</strong>, la referencia en la que se apoyan las grandes mesas durante toda la sesión.",
        "<strong class='text-white'>Ahorrarse la factura de terceros</strong> ahora que la suite viene con su plan de Tradovate.",
        "<strong class='text-white'>Confirmar sus señales automatizadas</strong> revisando el order flow antes o después de que un bot dispare.",
      ],
    },
    { type: "heading",text: "Automatice esto con PickMyTrade" },
    { type: "paragraph",html: "Leer el order flow es solo la mitad del trabajo, todavía tiene que hacer clic. <strong class='text-white'>PickMyTrade conecta sus alertas de TradingView directamente con su cuenta de Tradovate</strong> y dispara la orden por usted, bracket incluido, en el instante en que se activa su señal." },
  ], fr: [
    { type: "paragraph",html: "Order Flow+ est l'ensemble intégré d'outils d'order flow de Tradovate : Volume Profile, barres footprint, Cumulative Delta, VWAP et Market Profile (TPO). C'était auparavant un module complémentaire mensuel payant. Dans les formules de compte actuelles de Tradovate, il est inclus sans frais supplémentaires : pour la plupart des traders, « s'abonner » revient donc à l'activer et à placer les outils sur un graphique. Voici comment faire les deux, et ce qu'il faut vérifier si votre compte l'affiche encore comme une ligne payante." },
    { type: "heading",text: "Qu'est-ce qu'Order Flow+ dans Tradovate ?" },
    { type: "paragraph",html: "Order Flow+ vous emmène au-delà d'un simple graphique en chandeliers et vous montre <em>qui</em> trade à chaque prix, quel volume a été échangé, si les acheteurs ou les vendeurs ont pesé sur le tape, et où le marché revient sans cesse faire des affaires. C'est la lecture pour laquelle les traders footprint et profil paient des plateformes tierces, intégrée aux graphiques de Tradovate." },
    { type: "table", headers: ["Outil","Ce qu'il vous montre"], rows: [
      ["Volume Profile","Un histogramme horizontal du volume échangé à chaque prix, pour repérer les nœuds à fort volume et les vides à faible volume."],
      ["Barres volumétriques (footprint)","Le volume bid et ask imprimé à l'intérieur de chaque bougie, révélant l'absorption et le déséquilibre au niveau du tick."],
      ["Cumulative Delta","Le net cumulé des achats agressifs moins les ventes, pour voir la pression se construire ou s'estomper."],
      ["VWAP","Le prix moyen pondéré par le volume de la séance, un aimant et une référence de juste valeur autour de laquelle de nombreuses salles tradent."],
      ["Market Profile (TPO)","Une carte du temps par prix montrant où le marché a passé le plus de temps et où la valeur se forme."],
    ] },
    { type: "paragraph",html: "Précision sur le coût : Order Flow+ est désormais inclus dans les formules de compte de Tradovate, il n'y a donc généralement rien de plus à payer. Si vous utilisez un compte d'évaluation de prop firm plutôt qu'un compte de courtage personnel, les outils sont en principe déjà activés pour vous, mais la disponibilité et les éventuels frais varient selon la firme et la taille du compte : vérifiez donc les règles en vigueur de votre firme si vous ne les voyez pas. Enfin, Order Flow+ est bien plus utile avec un flux de données de marché en temps réel ; avec des données différées, les chiffres sont en retard sur le marché." },
    { type: "heading",text: "Comment s'abonner à Order Flow+ dans Tradovate : pas à pas" },
    {
      type: "steps",
      items: [
        { title: "Ouvrir Application Settings dans Tradovate Web", html: "Connectez-vous à la plateforme web sur <strong class='text-white'>trader.tradovate.com</strong>. Ouvrez le <strong class='text-white'>menu des paramètres en haut à droite</strong> de la fenêtre et choisissez <strong class='text-white'>Application Settings</strong>. C'est le point central pour les outils de compte, les paramètres de risque et le catalogue des modules complémentaires.", image: {"src":`${IMG}/tradovate-order-flow-plus-1.png`,"alt":"Plateforme web Tradovate avec le menu des paramètres en haut à droite ouvert et Application Settings mis en évidence"} },
        { title: "Ouvrir l'onglet Add-ons et trouver Order Flow+", html: "Dans Application Settings, cliquez sur l'onglet <strong class='text-white'>Add-ons</strong>. Faites défiler jusqu'à l'entrée <strong class='text-white'>Order Flow+</strong>. À côté, vous verrez son statut actuel : soit une option pour l'activer, soit une note indiquant qu'il est déjà inclus dans votre formule. C'est dans ce même panneau que se trouvent les données de marché et d'autres modules, vous croiserez donc quelques voisins en descendant.", image: {"src":`${IMG}/tradovate-order-flow-plus-2.png`,"alt":"Onglet Add-ons des Application Settings de Tradovate, défilé jusqu'à l'entrée Order Flow+"} },
        { title: "Activer Order Flow+", html: "Si Order Flow+ affiche un bouton <strong class='text-white'>Subscribe</strong>, <strong class='text-white'>Buy</strong> ou <strong class='text-white'>Activate</strong>, cliquez dessus pour activer le module. Dans les formules de compte actuelles de Tradovate, il est inclus : aucuns frais mensuels distincts ne devraient donc vous être facturés, mais lisez toujours l'écran de confirmation avant d'accepter, car les conditions des formules changent. Si l'entrée est déjà indiquée comme active ou incluse, vous avez terminé et pouvez passer directement aux graphiques.", image: {"src":`${IMG}/tradovate-order-flow-plus-3.png`,"alt":"Confirmation d'activation du module Order Flow+ de Tradovate indiquant qu'il est inclus dans la formule du compte"} },
        { title: "Ajouter les outils Order Flow+ à un graphique", html: "Activer le module ne dessine rien par lui-même, vous ajoutez chaque outil à un graphique. Ouvrez un graphique, cliquez sur l'icône <strong class='text-white'>Indicators</strong> de la barre d'outils du graphique et ajoutez <strong class='text-white'>Volume Profile</strong>, <strong class='text-white'>VWAP</strong> et <strong class='text-white'>Cumulative Delta</strong>. Pour les données footprint, passez le <strong class='text-white'>style du graphique en barres volumétriques (footprint)</strong> afin que le volume bid et ask s'imprime dans chaque bougie. Ajustez ensuite les paramètres de chaque outil jusqu'à ce que la lecture corresponde à votre façon de trader.", image: {"src":`${IMG}/tradovate-order-flow-plus-4.png`,"alt":"Graphique Tradovate avec les outils Order Flow+ appliqués : Volume Profile, VWAP, Cumulative Delta et barres volumétriques footprint"} },
      ],
    },
    { type: "heading",text: "Pourquoi vous en auriez besoin" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Voir l'intention, pas seulement le prix</strong>, le footprint et le delta montrent si un mouvement s'appuie sur de vrais achats ou s'il tourne à vide.",
        "<strong class='text-white'>Trouver de meilleurs niveaux</strong> avec les nœuds du Volume Profile plutôt que d'estimer les chiffres ronds à l'œil.",
        "<strong class='text-white'>Caler vos entrées autour du VWAP</strong>, la référence sur laquelle s'appuient les grandes salles toute la séance.",
        "<strong class='text-white'>Éviter la facture d'un tiers</strong> maintenant que la suite est livrée avec votre formule Tradovate.",
        "<strong class='text-white'>Confirmer vos signaux automatisés</strong> en vérifiant l'order flow avant ou après le déclenchement d'un bot.",
