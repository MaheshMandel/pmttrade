---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "tradovate-2fa";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/how-to/${SLUG}`;

const META_TITLE = "Enable or Disable 2FA in Tradovate";
const META_DESCRIPTION =
  "Tradovate 2FA setup made simple: enable or disable two-factor authentication from the Security page and secure every new-device login.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Aktivieren oder Deaktivieren der 2FA in Tradovate", es: "Activar o desactivar la 2FA en Tradovate", fr: "Activer ou désactiver la 2FA dans Tradovate", it: "Attivare o disattivare la 2FA in Tradovate" },
  dek: { en: "Need to turn 2FA on or off in Tradovate? Here's exactly how to enable and disable two-factor authentication from the Security page, step by step.", de: "Möchten Sie die 2FA in Tradovate aktivieren oder deaktivieren? Hier erfahren Sie genau, wie Sie die Zwei-Faktor-Authentifizierung auf der Security-Seite Schritt für Schritt aktivieren und deaktivieren.", es: "¿Necesita activar o desactivar la 2FA en Tradovate? A continuación le explicamos exactamente cómo habilitar y deshabilitar la autenticación de dos factores desde la página de Seguridad, paso a paso.", fr: "Besoin d'activer ou de désactiver la 2FA dans Tradovate ? Voici exactement comment activer et désactiver l'authentification à deux facteurs depuis la page Security, étape par étape.", it: "Deve attivare o disattivare la 2FA in Tradovate? Ecco esattamente come abilitare e disabilitare l'autenticazione a due fattori dalla pagina Security, passo dopo passo." },
  readTime: { en: "4 min read", de: "4 Minuten Lesezeit", es: "Lectura de 4 minutos", fr: "Lecture de 4 minutes", it: "Lettura di 4 minuti" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "Need to turn 2FA on or off in Tradovate? Maybe you're locking down a funded account, tightening things up before you connect automation like PickMyTrade, or trying to clear a login prompt that won't go away. Either way, here's exactly how to enable and disable two-factor authentication, step by step." },
    { type: "heading", text: "What Is 2FA in Tradovate?" },
    { type: "paragraph", html: "Two-factor authentication puts a second check on top of your username and password, so a stolen password alone won't get anyone into your account. In Tradovate, 2FA fires when you sign in from a new device or browser: the platform sends a verification you have to confirm before the login goes through. By default that's an approval sent to your email, but you can also back it with an authenticator app or SMS. Everything is managed from one spot, the <strong class='text-white'>Security</strong> page inside your Application Settings." },
    { type: "heading", text: "Enable or Disable 2FA in Tradovate: Step-by-Step" },
    {
      type: "steps",
      items: [
        { title: "Open the Security Page in Application Settings", html: "Sign in to the Tradovate web trader, then open your <strong class='text-white'>Application Settings</strong>, that's the settings menu, usually a gear icon, and head to the <strong class='text-white'>Security</strong> section. This is the single place where 2FA and the rest of your account-security options live.", image: { src: `${IMG}/tradovate-2fa-1.png`, alt: "Tradovate Application Settings showing the Security section" } },
        { title: "Turn On the 2FA Toggle", html: "On the Security page, find the <strong class='text-white'>2FA</strong> toggle and switch it on. From then on, Tradovate asks for verification any time you log in from a device or browser it doesn't recognize, the default method emails you an approval link so you can confirm the new machine.", image: { src: `${IMG}/tradovate-2fa-2.png`, alt: "Tradovate Security page showing the 2FA toggle switched on" } },
        { title: "Add an Authenticator App or SMS Method (Optional)", html: "Want something stronger than email? Scroll below the 2FA toggle to the additional methods. You can add an <strong class='text-white'>authenticator app</strong> that generates a time-based one-time code, TOTP apps like Google Authenticator on Android or iPhone, or <strong class='text-white'>SMS</strong> codes sent to your phone. When you turn one of these on, Tradovate has you set a <strong class='text-white'>backup method</strong> too, so you're not locked out if one method stops working. Just follow the on-screen prompts to scan the QR code or confirm your phone number.", image: { src: `${IMG}/tradovate-2fa-3.png`, alt: "Tradovate Security page showing authenticator app and SMS options with a backup method prompt" } },
        { title: "Disable 2FA When You Need To", html: "To turn 2FA off, go back to that same <strong class='text-white'>Security</strong> page and flip the <strong class='text-white'>2FA</strong> toggle off, Tradovate may ask you to re-verify first. That removes the extra login prompt, which is handy when you're consolidating devices. One caution: leave 2FA on for any account holding real capital or a funded evaluation.", image: { src: `${IMG}/tradovate-2fa-4.png`, alt: "Tradovate Security page showing the 2FA toggle switched off" } },
      ],
    },
    { type: "heading", text: "Why You'd Need This" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Securing a funded account</strong>, keep a prop-firm evaluation or live account out of the wrong hands.",
        "<strong class='text-white'>New-device logins</strong>, understand why Tradovate emails an approval when you sign in on a new computer or phone.",
        "<strong class='text-white'>Adding an authenticator app</strong>, move past email to a TOTP app or SMS for tighter verification.",
        "<strong class='text-white'>Troubleshooting</strong>, knowing where the toggle lives lets you clear a stuck 2FA login prompt fast.",
        "<strong class='text-white'>Prepping automation</strong>, lock down your security setup before linking TradingView or a tool like PickMyTrade.",
      ],
    },
    { type: "heading", text: "Automate This with PickMyTrade" },
    { type: "paragraph", html: "Once your account security is set, <strong class='text-white'>PickMyTrade wires your TradingView alerts straight to your Tradovate account</strong>. Entries, exits, and brackets fire on their own, no manual clicks, no staring at the screen waiting for a signal. Your 2FA and login settings stay entirely in your hands while the strategy runs hands-free." },
  ], de: [
    { type: "paragraph", html: "Möchten Sie die 2FA in Tradovate aktivieren oder deaktivieren? Vielleicht sichern Sie ein Funded-Konto ab, ziehen Ihre Sicherheitseinstellungen an, bevor Sie eine Automatisierung wie PickMyTrade verbinden, oder versuchen, eine hartnäckige Login-Aufforderung loszuwerden. So oder so: Hier erfahren Sie genau, wie Sie die Zwei-Faktor-Authentifizierung Schritt für Schritt aktivieren und deaktivieren." },
    { type: "heading", text: "Was ist 2FA in Tradovate?" },
    { type: "paragraph", html: "Die Zwei-Faktor-Authentifizierung fügt Ihrem Benutzernamen und Passwort eine zweite Prüfung hinzu, sodass ein gestohlenes Passwort allein niemandem Zugriff auf Ihr Konto verschafft. In Tradovate greift die 2FA, wenn Sie sich von einem neuen Gerät oder Browser aus anmelden: Die Plattform sendet eine Verifizierung, die Sie bestätigen müssen, bevor die Anmeldung abgeschlossen wird. Standardmäßig ist das eine Genehmigung per E-Mail, Sie können sie aber auch mit einer Authenticator-App oder SMS absichern. Alles wird an einer Stelle verwaltet, der <strong class='text-white'>Security</strong>-Seite in Ihren Application Settings." },
    { type: "heading", text: "2FA in Tradovate aktivieren oder deaktivieren: Schritt für Schritt" },
    {
      type: "steps",
      items: [
        { title: "Öffnen Sie die Security-Seite in den Application Settings", html: "Melden Sie sich beim Tradovate Web Trader an, öffnen Sie dann Ihre <strong class='text-white'>Application Settings</strong>, also das Einstellungsmenü, meist ein Zahnrad-Symbol, und wechseln Sie zum Bereich <strong class='text-white'>Security</strong>. Dies ist die zentrale Stelle, an der sich die 2FA und die übrigen Sicherheitsoptionen Ihres Kontos befinden.", image: { src: `${IMG}/tradovate-2fa-1.png`, alt: "Tradovate Application Settings mit der Security-Sektion" } },
        { title: "Aktivieren Sie den 2FA-Schalter", html: "Suchen Sie auf der Security-Seite den <strong class='text-white'>2FA</strong>-Schalter und aktivieren Sie ihn. Ab diesem Zeitpunkt fordert Tradovate bei jeder Anmeldung von einem unbekannten Gerät oder Browser eine Verifizierung an; die Standardmethode sendet Ihnen einen Genehmigungslink per E-Mail, mit dem Sie das neue Gerät bestätigen können.", image: { src: `${IMG}/tradovate-2fa-2.png`, alt: "Tradovate Security-Seite mit aktiviertem 2FA-Schalter" } },
        { title: "Authenticator-App oder SMS-Methode hinzufügen (optional)", html: "Möchten Sie etwas Stärkeres als E-Mail? Scrollen Sie unter dem 2FA-Schalter zu den zusätzlichen Methoden. Sie können eine <strong class='text-white'>authenticator app</strong> hinzufügen, die einen zeitbasierten Einmalcode generiert, TOTP-Apps wie Google Authenticator auf Android oder iPhone, oder <strong class='text-white'>SMS</strong>-Codes, die an Ihr Telefon gesendet werden. Wenn Sie eine dieser Methoden aktivieren, lässt Tradovate Sie zusätzlich eine <strong class='text-white'>backup method</strong> festlegen, damit Sie nicht ausgesperrt werden, falls eine Methode nicht mehr funktioniert. Folgen Sie einfach den Anweisungen auf dem Bildschirm, um den QR-Code zu scannen oder Ihre Telefonnummer zu bestätigen.", image: { src: `${IMG}/tradovate-2fa-3.png`, alt: "Tradovate Security-Seite mit Optionen für Authenticator-App und SMS sowie einer Aufforderung zur Backup-Methode" } },
        { title: "Deaktivieren Sie die 2FA bei Bedarf", html: "Um die 2FA zu deaktivieren, gehen Sie zurück auf dieselbe <strong class='text-white'>Security</strong>-Seite und schalten Sie den <strong class='text-white'>2FA</strong>-Schalter aus; Tradovate bittet Sie möglicherweise zunächst um eine erneute Verifizierung. Dadurch entfällt die zusätzliche Login-Aufforderung, was praktisch ist, wenn Sie Geräte konsolidieren. Ein Hinweis: Lassen Sie die 2FA für jedes Konto aktiviert, das echtes Kapital oder eine Funded-Evaluation enthält.", image: { src: `${IMG}/tradovate-2fa-4.png`, alt: "Tradovate Security-Seite mit deaktiviertem 2FA-Schalter" } },
      ],
    },
    { type: "heading", text: "Warum Sie das brauchen könnten" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Funded-Konto absichern</strong>, sorgen Sie dafür, dass eine Prop-Firm-Evaluation oder ein Live-Konto nicht in falsche Hände gerät.",
        "<strong class='text-white'>Logins von neuen Geräten</strong>, verstehen Sie, warum Tradovate eine Genehmigung per E-Mail sendet, wenn Sie sich auf einem neuen Computer oder Telefon anmelden.",
        "<strong class='text-white'>Authenticator-App hinzufügen</strong>, gehen Sie über E-Mail hinaus zu einer TOTP-App oder SMS für eine strengere Verifizierung.",
        "<strong class='text-white'>Fehlerbehebung</strong>, wenn Sie wissen, wo sich der Schalter befindet, können Sie eine hängende 2FA-Login-Aufforderung schnell beheben.",
        "<strong class='text-white'>Automatisierung vorbereiten</strong>, sichern Sie Ihre Sicherheitseinstellungen ab, bevor Sie TradingView oder ein Tool wie PickMyTrade verbinden.",
      ],
    },
    { type: "heading", text: "Automatisieren Sie dies mit PickMyTrade" },
    { type: "paragraph", html: "Sobald die Sicherheit Ihres Kontos eingerichtet ist, <strong class='text-white'>verbindet PickMyTrade Ihre TradingView-Alerts direkt mit Ihrem Tradovate-Konto</strong>. Einstiege, Ausstiege und Brackets werden automatisch ausgelöst, ganz ohne manuelle Klicks und ohne dass Sie auf den Bildschirm starren und auf ein Signal warten. Ihre 2FA- und Login-Einstellungen bleiben vollständig in Ihrer Hand, während die Strategie eigenständig läuft." },
  ], es: [
    { type: "paragraph", html: "¿Necesita activar o desactivar la 2FA en Tradovate? Quizás esté protegiendo una cuenta fondeada, reforzando la seguridad antes de conectar una automatización como PickMyTrade, o tratando de eliminar un aviso de inicio de sesión que no desaparece. Sea cual sea el motivo, a continuación le explicamos exactamente cómo habilitar y deshabilitar la autenticación de dos factores, paso a paso." },
    { type: "heading", text: "¿Qué es la 2FA en Tradovate?" },
    { type: "paragraph", html: "La autenticación de dos factores añade una segunda verificación además de su nombre de usuario y contraseña, de modo que una contraseña robada por sí sola no bastará para que alguien acceda a su cuenta. En Tradovate, la 2FA se activa cuando inicia sesión desde un dispositivo o navegador nuevo: la plataforma envía una verificación que debe confirmar antes de que se complete el inicio de sesión. De forma predeterminada, se trata de una aprobación enviada a su correo electrónico, pero también puede respaldarla con una aplicación de autenticación o SMS. Todo se gestiona desde un mismo lugar, la página de <strong class='text-white'>Security</strong> dentro de la Application Settings." },
    { type: "heading", text: "Activar o desactivar la 2FA en Tradovate: paso a paso" },
    {
      type: "steps",
      items: [
        { title: "Abra la página Security en Application Settings", html: "Inicie sesión en el trader web de Tradovate, luego abra su <strong class='text-white'>Application Settings</strong>, es decir, el menú de configuración, normalmente un icono de engranaje, y diríjase a la sección <strong class='text-white'>Security</strong>. Este es el único lugar donde se encuentran la 2FA y el resto de las opciones de seguridad de su cuenta.", image: { src: `${IMG}/tradovate-2fa-1.png`, alt: "Configuración de la aplicación de Tradovate mostrando la sección de Seguridad" } },
        { title: "Active el interruptor de 2FA", html: "En la página Security, busque el interruptor de <strong class='text-white'>2FA</strong> y actívelo. A partir de ese momento, Tradovate solicitará verificación cada vez que inicie sesión desde un dispositivo o navegador que no reconozca; el método predeterminado le envía por correo electrónico un enlace de aprobación para que confirme el nuevo equipo.", image: { src: `${IMG}/tradovate-2fa-2.png`, alt: "Tradovate Security page showing the 2FA toggle switched on" } },
        { title: "Añada una aplicación de autenticación o un método por SMS (opcional)", html: "¿Desea algo más robusto que el correo electrónico? Desplácese debajo del interruptor de 2FA hasta los métodos adicionales. Puede añadir una <strong class='text-white'>authenticator app</strong> que genera un código de un solo uso basado en tiempo, aplicaciones TOTP como Google Authenticator en Android o iPhone, o códigos por <strong class='text-white'>SMS</strong> enviados a su teléfono. Al activar cualquiera de estas opciones, Tradovate le pedirá que configure también un <strong class='text-white'>método de respaldo</strong>, para que no quede bloqueado si uno de los métodos deja de funcionar. Solo tiene que seguir las indicaciones en pantalla para escanear el código QR o confirmar su número de teléfono.", image: { src: `${IMG}/tradovate-2fa-3.png`, alt: "Tradovate Security page showing authenticator app and SMS options with a backup method prompt" } },
        { title: "Desactive la 2FA cuando lo necesite", html: "Para desactivar la 2FA, vuelva a esa misma página <strong class='text-white'>Security</strong> y apague el interruptor de <strong class='text-white'>2FA</strong>; es posible que Tradovate le pida volver a verificar su identidad primero. Esto elimina el aviso de inicio de sesión adicional, algo útil cuando está consolidando dispositivos. Una advertencia: mantenga la 2FA activada en cualquier cuenta que contenga capital real o una evaluación fondeada.", image: { src: `${IMG}/tradovate-2fa-4.png`, alt: "Tradovate Security page showing the 2FA toggle switched off" } },
      ],
    },
    { type: "heading", text: "Por qué podría necesitar esto" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Proteger una cuenta fondeada</strong>, evite que una evaluación de una prop firm o una cuenta en vivo caiga en manos equivocadas.",
        "<strong class='text-white'>Inicios de sesión desde un dispositivo nuevo</strong>, entienda por qué Tradovate le envía una aprobación por correo electrónico cuando inicia sesión en un equipo o teléfono nuevo.",
        "<strong class='text-white'>Añadir una aplicación de autenticación</strong>, vaya más allá del correo electrónico con una aplicación TOTP o SMS para una verificación más estricta.",
        "<strong class='text-white'>Solución de problemas</strong>, saber dónde está el interruptor le permite resolver rápidamente un aviso de inicio de sesión de 2FA atascado.",
        "<strong class='text-white'>Preparar la automatización</strong>, refuerce su configuración de seguridad antes de conectar TradingView o una herramienta como PickMyTrade.",
      ],
    },
    { type: "heading", text: "Automatice esto con PickMyTrade" },
    { type: "paragraph", html: "Una vez configurada la seguridad de su cuenta, <strong class='text-white'>PickMyTrade conecta sus alertas de TradingView directamente con su cuenta de Tradovate</strong>. Las entradas, salidas y brackets se ejecutan por sí solos, sin clics manuales, sin tener que mirar la pantalla esperando una señal. Su 2FA y su configuración de inicio de sesión permanecen totalmente bajo su control mientras la estrategia se ejecuta de forma automática." },
  ], fr: [
    { type: "paragraph", html: "Besoin d'activer ou de désactiver la 2FA dans Tradovate ? Peut-être sécurisez-vous un compte financé, renforcez-vous votre configuration avant de connecter une automatisation comme PickMyTrade, ou cherchez-vous à faire disparaître une invite de connexion qui ne veut pas partir. Dans tous les cas, voici exactement comment activer et désactiver l'authentification à deux facteurs, étape par étape." },
    { type: "heading", text: "Qu'est-ce que la 2FA dans Tradovate ?" },
    { type: "paragraph", html: "L'authentification à deux facteurs ajoute une seconde vérification en plus de votre nom d'utilisateur et de votre mot de passe, de sorte qu'un mot de passe volé ne suffit pas à lui seul pour accéder à votre compte. Dans Tradovate, la 2FA se déclenche lorsque vous vous connectez depuis un nouvel appareil ou un nouveau navigateur : la plateforme envoie une vérification que vous devez confirmer avant que la connexion n'aboutisse. Par défaut, il s'agit d'une approbation envoyée par e-mail, mais vous pouvez aussi la renforcer avec une application d'authentification ou un SMS. Tout se gère depuis un seul endroit, la page <strong class='text-white'>Security</strong> dans vos Application Settings." },
    { type: "heading", text: "Activer ou désactiver la 2FA dans Tradovate : étape par étape" },
    {
      type: "steps",
      items: [
        { title: "Ouvrir la page Security dans Application Settings", html: "Connectez-vous au Tradovate web trader, puis ouvrez vos <strong class='text-white'>Application Settings</strong>, le menu des paramètres, généralement représenté par une icône d'engrenage, et rendez-vous dans la section <strong class='text-white'>Security</strong>. C'est l'endroit unique où se trouvent la 2FA et le reste des options de sécurité de votre compte.", image: { src: `${IMG}/tradovate-2fa-1.png`, alt: "Application Settings de Tradovate affichant la section Security" } },
        { title: "Activer le bouton 2FA", html: "Sur la page Security, trouvez le bouton <strong class='text-white'>2FA</strong> et activez-le. À partir de là, Tradovate demande une vérification chaque fois que vous vous connectez depuis un appareil ou un navigateur qu'il ne reconnaît pas ; la méthode par défaut vous envoie un lien d'approbation par e-mail pour confirmer la nouvelle machine.", image: { src: `${IMG}/tradovate-2fa-2.png`, alt: "Page Security de Tradovate montrant le bouton 2FA activé" } },
        { title: "Ajouter une application d'authentification ou une méthode SMS (facultatif)", html: "Vous voulez quelque chose de plus solide que l'e-mail ? Faites défiler sous le bouton 2FA jusqu'aux méthodes supplémentaires. Vous pouvez ajouter une <strong class='text-white'>application d'authentification</strong> qui génère un code à usage unique basé sur le temps, des applications TOTP comme Google Authenticator sur Android ou iPhone, ou des codes <strong class='text-white'>SMS</strong> envoyés sur votre téléphone. Lorsque vous activez l'une de ces méthodes, Tradovate vous demande également de définir une <strong class='text-white'>méthode de secours</strong>, afin de ne pas vous retrouver bloqué si une méthode cesse de fonctionner. Il vous suffit de suivre les instructions à l'écran pour scanner le code QR ou confirmer votre numéro de téléphone.", image: { src: `${IMG}/tradovate-2fa-3.png`, alt: "Page Security de Tradovate montrant les options d'application d'authentification et de SMS avec une invite de méthode de secours" } },
        { title: "Désactiver la 2FA quand vous en avez besoin", html: "Pour désactiver la 2FA, retournez sur cette même page <strong class='text-white'>Security</strong> et désactivez le bouton <strong class='text-white'>2FA</strong>, Tradovate peut d'abord vous demander de vous revérifier. Cela supprime l'invite de connexion supplémentaire, ce qui est pratique lorsque vous consolidez vos appareils. Une mise en garde : laissez la 2FA activée pour tout compte détenant du capital réel ou une évaluation financée.", image: { src: `${IMG}/tradovate-2fa-4.png`, alt: "Page Security de Tradovate montrant le bouton 2FA désactivé" } },
      ],
    },
    { type: "heading", text: "Pourquoi vous en auriez besoin" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Sécuriser un compte financé</strong>, empêchez qu'une évaluation prop firm ou un compte réel ne tombe entre de mauvaises mains.",
        "<strong class='text-white'>Connexions depuis un nouvel appareil</strong>, comprenez pourquoi Tradovate vous envoie une approbation par e-mail lorsque vous vous connectez sur un nouvel ordinateur ou téléphone.",
        "<strong class='text-white'>Ajouter une application d'authentification</strong>, passez de l'e-mail à une application TOTP ou au SMS pour une vérification plus stricte.",
        "<strong class='text-white'>Dépannage</strong>, savoir où se trouve le bouton vous permet de résoudre rapidement une invite de connexion 2FA bloquée.",
        "<strong class='text-white'>Préparer l'automatisation</strong>, verrouillez votre configuration de sécurité avant de connecter TradingView ou un outil comme PickMyTrade.",
      ],
    },
    { type: "heading", text: "Automatiser cela avec PickMyTrade" },
    { type: "paragraph", html: "Une fois la sécurité de votre compte configurée, <strong class='text-white'>PickMyTrade relie directement vos alertes TradingView à votre compte Tradovate</strong>. Les entrées, sorties et brackets se déclenchent automatiquement, sans clic manuel, sans devoir rester rivé à l'écran en attendant un signal. Vos paramètres de 2FA et de connexion restent entièrement entre vos mains pendant que la stratégie tourne en mode automatique." },
  ], it: [
    { type: "paragraph", html: "Deve attivare o disattivare la 2FA in Tradovate? Forse sta proteggendo un conto finanziato, sta rafforzando la sicurezza prima di collegare un'automazione come PickMyTrade, oppure sta cercando di eliminare una richiesta di accesso che non scompare. In ogni caso, ecco esattamente come abilitare e disabilitare l'autenticazione a due fattori, passo dopo passo." },
    { type: "heading", text: "Che cos'è la 2FA in Tradovate?" },
    { type: "paragraph", html: "L'autenticazione a due fattori aggiunge un secondo controllo oltre al nome utente e alla password, così una password rubata da sola non basterà a chiunque per accedere al suo conto. In Tradovate, la 2FA si attiva quando accede da un nuovo dispositivo o browser: la piattaforma invia una verifica che deve confermare prima che l'accesso vada a buon fine. Per impostazione predefinita si tratta di un'approvazione inviata alla sua email, ma può anche rafforzarla con un'app di autenticazione o un SMS. Tutto viene gestito da un unico punto, la pagina <strong class='text-white'>Security</strong> all'interno delle Application Settings." },
    { type: "heading", text: "Attivare o disattivare la 2FA in Tradovate: passo dopo passo" },
    {
      type: "steps",
      items: [
        { title: "Apra la pagina Security in Application Settings", html: "Acceda al Tradovate web trader, quindi apra le sue <strong class='text-white'>Application Settings</strong>, ovvero il menu delle impostazioni, di solito un'icona a forma di ingranaggio, e vada alla sezione <strong class='text-white'>Security</strong>. Questo è l'unico punto in cui si trovano la 2FA e il resto delle opzioni di sicurezza del conto.", image: { src: `${IMG}/tradovate-2fa-1.png`, alt: "Application Settings di Tradovate che mostra la sezione Security" } },
        { title: "Attivi l'interruttore della 2FA", html: "Nella pagina Security, trovi l'interruttore <strong class='text-white'>2FA</strong> e lo attivi. Da quel momento in poi, Tradovate richiederà una verifica ogni volta che accede da un dispositivo o browser che non riconosce; il metodo predefinito le invia via email un link di approvazione per confermare il nuovo dispositivo.", image: { src: `${IMG}/tradovate-2fa-2.png`, alt: "Pagina Security di Tradovate che mostra l'interruttore 2FA attivato" } },
        { title: "Aggiunga un'app di autenticazione o un metodo SMS (opzionale)", html: "Desidera qualcosa di più solido dell'email? Scorra sotto l'interruttore 2FA fino ai metodi aggiuntivi. Può aggiungere un'<strong class='text-white'>app di autenticazione</strong> che genera un codice monouso basato sul tempo, app TOTP come Google Authenticator su Android o iPhone, oppure codici <strong class='text-white'>SMS</strong> inviati al suo telefono. Quando attiva uno di questi metodi, Tradovate le chiederà di impostare anche un <strong class='text-white'>metodo di backup</strong>, così non resterà bloccato fuori se un metodo smette di funzionare. Basta seguire le indicazioni a schermo per scansionare il codice QR o confermare il numero di telefono.", image: { src: `${IMG}/tradovate-2fa-3.png`, alt: "Pagina Security di Tradovate che mostra le opzioni per app di autenticazione e SMS con la richiesta di un metodo di backup" } },
        { title: "Disattivi la 2FA quando necessario", html: "Per disattivare la 2FA, torni sulla stessa pagina <strong class='text-white'>Security</strong> e disattivi l'interruttore <strong class='text-white'>2FA</strong>; Tradovate potrebbe chiederle prima di riverificare la sua identità. Questo rimuove la richiesta di accesso aggiuntiva, il che è comodo quando sta consolidando i dispositivi. Un'avvertenza: lasci la 2FA attiva per qualsiasi conto che detiene capitale reale o una valutazione finanziata.", image: { src: `${IMG}/tradovate-2fa-4.png`, alt: "Pagina Security di Tradovate che mostra l'interruttore 2FA disattivato" } },
      ],
    },
    { type: "heading", text: "Perché potrebbe servirle" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Proteggere un conto finanziato</strong>, per evitare che una valutazione prop firm o un conto live finiscano nelle mani sbagliate.",
        "<strong class='text-white'>Accessi da nuovo dispositivo</strong>, per capire perché Tradovate invia un'email di approvazione quando accede da un nuovo computer o telefono.",
        "<strong class='text-white'>Aggiungere un'app di autenticazione</strong>, per passare dall'email a un'app TOTP o all'SMS per una verifica più rigorosa.",
        "<strong class='text-white'>Risoluzione dei problemi</strong>, sapere dove si trova l'interruttore le consente di eliminare rapidamente una richiesta di accesso 2FA bloccata.",
        "<strong class='text-white'>Prepararsi all'automazione</strong>, blindi la configurazione di sicurezza prima di collegare TradingView o uno strumento come PickMyTrade.",
