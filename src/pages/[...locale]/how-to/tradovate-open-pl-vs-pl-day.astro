---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "tradovate-open-pl-vs-pl-day";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/how-to/${SLUG}`;

const META_TITLE = "Open P/L vs P/L Day in Tradovate Explained";
const META_DESCRIPTION =
  "Open P/L is your live unrealized profit on an open position; P/L Day is your full session total. See the difference and where to check net P/L.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Open P/L vs. P/L Day in Tradovate erklärt", es: "Open P/L frente a P/L Day en Tradovate, explicado", fr: "Open P/L ou P/L Day dans Tradovate : explications", it: "Open P/L vs P/L Day in Tradovate: la spiegazione" },
  dek: { en: "Open P/L is the live, unrealized gain or loss on the position you're holding right now. P/L Day is your total for the whole trading session, closed trades and open float combined. Here's the clean version.", de: "Open P/L ist der aktuelle, nicht realisierte Gewinn oder Verlust der Position, die Sie gerade halten. P/L Day ist Ihre Gesamtsumme für die gesamte Handelssitzung, geschlossene Trades und offene Schwankung zusammen. Hier die klare Erklärung.", es: "Open P/L es la ganancia o pérdida no realizada, en tiempo real, de la posición que mantiene en este momento. P/L Day es su total de toda la sesión de trading, operaciones cerradas y flotante abierto combinados. Aquí tiene la explicación clara.", fr: "Open P/L est le gain ou la perte latent(e), en temps réel, de la position que vous détenez actuellement. P/L Day est votre total pour toute la séance de trading, trades clôturés et flottant ouvert confondus. Voici la version claire.", it: "Open P/L è il guadagno o la perdita non realizzato, in tempo reale, della posizione che sta detenendo in questo momento. P/L Day è il Suo totale dell'intera sessione di trading, operazioni chiuse e flottante aperto insieme. Ecco la versione chiara." },
  readTime: { en: "5 min read", de: "5 Min. Lesezeit", es: "Lectura de 5 min", fr: "Lecture : 5 min", it: "Lettura di 5 min" },
  lastUpdated: "2026-07-10",
  blocks: { en: [
    { type: "paragraph", html: "Two P/L numbers sit on your Tradovate screen and they rarely match. <strong class='text-white'>Open P/L</strong> is the live, unrealized gain or loss on the position you're holding right this second. <strong class='text-white'>P/L Day</strong> is your total for the whole trading session, closed trades and open float combined. Mix them up and you'll misread your day. Here's the clean version." },
    { type: "heading", text: "The Short Answer" },
    {
      type: "table",
      headers: ["", "Open P/L", "P/L Day"],
      rows: [
        ["What it measures", "Unrealized gain/loss on your current open position", "Total session P/L: closed trades plus open float"],
        ["Reference point", "Your average entry price", "Where you stood at the session start"],
        ["Reads zero when", "You're flat, nothing open", "A fresh session with no trades yet"],
        ["Updates", "Every tick while the position is open", "Every tick, and each time you close a trade"],
        ["Resets", "The moment you close the position", "At the 5:00 PM Central session boundary"],
      ],
    },
    { type: "heading", text: "Open P/L: the Money in the Trade You're In" },
    { type: "paragraph", html: "Open P/L (you'll also see it written as P/L Open) is unrealized. Tradovate measures it from your volume-weighted average entry price to the current market price, then multiplies by your position size and the instrument's tick value. It re-prices on every tick, so it breathes up and down with the market. The instant you close the position, Open P/L is done: it drops to zero and whatever you made or lost rolls into your realized total for the day." },
    { type: "paragraph", html: 'Think of it as "what would happen if I got out right now." It says nothing about the three trades you already closed this morning.' },
    { type: "heading", text: "P/L Day: the Whole Session in One Number" },
    { type: "paragraph", html: "P/L Day is the running total for the entire session: every trade you've already closed plus whatever's still floating on an open position. The catch is the session clock: it doesn't reset at midnight. Tradovate's trading session starts at <strong class='text-white'>5:00 PM Central Time</strong> and runs to 3:45 PM CT the next day, Sunday through Friday. So if you trade at 4 PM CT, that fill already belongs to the next session's P/L Day." },
    { type: "paragraph", html: "Scalp three quick trades and go flat, and the two numbers split cleanly: Open P/L reads zero because you hold nothing, while P/L Day still shows the sum of those three closed trades." },
    { type: "heading", text: "Find Them Both: Step by Step" },
    {
      type: "steps",
      items: [
        { title: "Open the Positions Module", html: "Open the <strong class='text-white'>Positions</strong> tab, or drop the Positions module into your workspace if it isn't already there. It lists each open position with the instrument, net quantity, average price, and the two P/L figures sitting side by side. Don't see both columns? Right-click the column header (or open the module's view/column settings) and switch them on.", image: { src: `${IMG}/tradovate-open-pl-vs-pl-day-1.png`, alt: "Tradovate Positions module showing instrument, quantity, average price, and the Open P/L and P/L Day columns" } },
        { title: "Read the Open P/L Column", html: "Find the column with your live floating result, usually labeled <strong class='text-white'>Open P/L</strong> or <strong class='text-white'>P/L Open</strong>. Green means the open position is in profit, red means it's underwater, and it ticks up and down in real time. Close the position and this cell goes back to zero.", image: { src: `${IMG}/tradovate-open-pl-vs-pl-day-2.png`, alt: "Tradovate Positions module with the live Open P/L column highlighted on an open futures position" } },
        { title: "Read the P/L Day Column", html: "Right beside it is <strong class='text-white'>P/L Day</strong>, your session total. This is the figure that folds in closed winners and losers alongside the open float. When Open P/L and P/L Day disagree, this is why: P/L Day remembers the trades you already booked, and Open P/L doesn't.", image: { src: `${IMG}/tradovate-open-pl-vs-pl-day-3.png`, alt: "Tradovate Positions module with the P/L Day session-total column highlighted next to Open P/L" } },
        { title: "Cross-Check Net P/L in Account Reports", html: "Both columns on the Positions grid are <strong class='text-white'>gross</strong>, commissions and fees aren't subtracted there. For the number that actually hits your balance, open the <strong class='text-white'>Performance</strong> report under Account Reports, which nets out your trading costs. If your on-screen P/L Day never quite squares with your account net, this gap is almost always the reason.", image: { src: `${IMG}/tradovate-open-pl-vs-pl-day-4.png`, alt: "Tradovate Performance report under Account Reports showing net P/L after commissions and fees" } },
      ],
    },
    { type: "heading", text: "Why the Difference Matters" },
    { type: "paragraph", html: "If you trade a funded or evaluation account, your daily loss limit is measured against the session net, realized plus open, from that same 5:00 PM CT reset. A big Open P/L on a runner still counts against the limit in real time, so a trade that looks fine on the float can quietly push your P/L Day toward a breach. Watch P/L Day, not just the float, when you're managing risk. Exact limits and trailing-drawdown rules vary by firm and account size, so check your firm's current rules." },
    { type: "heading", text: "Automate This with PickMyTrade" },
    { type: "paragraph", html: "Staring at two P/L columns to decide when to bail is exactly the kind of judgment that falls apart when the market moves fast. <strong class='text-white'>PickMyTrade routes your TradingView alerts straight into Tradovate</strong>, so your stops and targets fire on the rules you set, whether or not you're watching the numbers." },
  ], de: [
    { type: "paragraph",html: "Auf Ihrem Tradovate-Bildschirm stehen zwei P/L-Zahlen, und sie stimmen selten überein. <strong class='text-white'>Open P/L</strong> ist der aktuelle, nicht realisierte Gewinn oder Verlust der Position, die Sie in diesem Moment halten. <strong class='text-white'>P/L Day</strong> ist Ihre Gesamtsumme für die gesamte Handelssitzung, geschlossene Trades und offene Schwankung zusammen. Wer sie verwechselt, liest seinen Tag falsch. Hier die klare Erklärung." },
    { type: "heading",text: "Die kurze Antwort" },
    { type: "table", headers: ["","Open P/L","P/L Day"], rows: [
      ["Was gemessen wird","Nicht realisierter Gewinn/Verlust Ihrer aktuellen offenen Position","Gesamt-P/L der Sitzung: geschlossene Trades plus offene Schwankung"],
      ["Bezugspunkt","Ihr durchschnittlicher Einstiegspreis","Ihr Stand zu Sitzungsbeginn"],
      ["Zeigt null, wenn","Sie flat sind und nichts offen ist","Eine neue Sitzung noch ohne Trades beginnt"],
      ["Aktualisiert sich","Bei jedem Tick, solange die Position offen ist","Bei jedem Tick und jedes Mal, wenn Sie einen Trade schließen"],
      ["Wird zurückgesetzt","Sobald Sie die Position schließen","An der Sitzungsgrenze um 17:00 Uhr Central Time"],
    ] },
    { type: "heading",text: "Open P/L: das Geld in dem Trade, in dem Sie stecken" },
    { type: "paragraph",html: "Open P/L (auch als P/L Open geschrieben) ist nicht realisiert. Tradovate misst ihn vom volumengewichteten durchschnittlichen Einstiegspreis bis zum aktuellen Marktpreis und multipliziert mit Ihrer Positionsgröße und dem Tick-Wert des Instruments. Er wird bei jedem Tick neu berechnet und schwankt daher mit dem Markt auf und ab. In dem Moment, in dem Sie die Position schließen, ist Open P/L erledigt: Er fällt auf null, und was Sie gewonnen oder verloren haben, fließt in Ihre realisierte Tagessumme." },
    { type: "paragraph",html: "Sehen Sie ihn als „Was würde passieren, wenn ich jetzt aussteige“. Er sagt nichts über die drei Trades aus, die Sie heute Morgen bereits geschlossen haben." },
    { type: "heading",text: "P/L Day: die ganze Sitzung in einer Zahl" },
    { type: "paragraph",html: "P/L Day ist die laufende Gesamtsumme der gesamten Sitzung: jeder bereits geschlossene Trade plus alles, was noch auf einer offenen Position schwankt. Der Haken ist die Sitzungsuhr: Sie wird nicht um Mitternacht zurückgesetzt. Die Handelssitzung von Tradovate beginnt um <strong class='text-white'>17:00 Uhr Central Time</strong> und läuft von Sonntag bis Freitag bis 15:45 Uhr CT am nächsten Tag. Wenn Sie also um 16 Uhr CT handeln, gehört diese Ausführung bereits zum P/L Day der nächsten Sitzung." },
    { type: "paragraph",html: "Wenn Sie drei schnelle Trades scalpen und flat gehen, trennen sich die beiden Zahlen sauber: Open P/L zeigt null, weil Sie nichts halten, während P/L Day weiterhin die Summe dieser drei geschlossenen Trades anzeigt." },
    { type: "heading",text: "Beide finden: Schritt für Schritt" },
    {
      type: "steps",
      items: [
        { title: "Das Positions-Modul öffnen", html: "Öffnen Sie den Tab <strong class='text-white'>Positions</strong> oder fügen Sie das Positions-Modul Ihrem Arbeitsbereich hinzu, falls es noch nicht vorhanden ist. Es listet jede offene Position mit Instrument, Nettomenge, Durchschnittspreis und den beiden P/L-Werten nebeneinander auf. Sehen Sie nicht beide Spalten? Klicken Sie mit der rechten Maustaste auf die Spaltenüberschrift (oder öffnen Sie die Ansichts- bzw. Spalteneinstellungen des Moduls) und aktivieren Sie sie.", image: {"src":`${IMG}/tradovate-open-pl-vs-pl-day-1.png`,"alt":"Tradovate-Positions-Modul mit Instrument, Menge, Durchschnittspreis sowie den Spalten Open P/L und P/L Day"} },
        { title: "Die Spalte Open P/L lesen", html: "Suchen Sie die Spalte mit Ihrem aktuellen schwankenden Ergebnis, meist mit <strong class='text-white'>Open P/L</strong> oder <strong class='text-white'>P/L Open</strong> beschriftet. Grün bedeutet, dass die offene Position im Gewinn liegt, Rot, dass sie im Minus ist, und der Wert tickt in Echtzeit auf und ab. Schließen Sie die Position, springt diese Zelle zurück auf null.", image: {"src":`${IMG}/tradovate-open-pl-vs-pl-day-2.png`,"alt":"Tradovate-Positions-Modul mit hervorgehobener Live-Spalte Open P/L bei einer offenen Futures-Position"} },
        { title: "Die Spalte P/L Day lesen", html: "Direkt daneben steht <strong class='text-white'>P/L Day</strong>, Ihre Sitzungssumme. Diese Zahl fasst geschlossene Gewinner und Verlierer zusammen mit der offenen Schwankung. Wenn Open P/L und P/L Day voneinander abweichen, ist das der Grund: P/L Day erinnert sich an die Trades, die Sie bereits verbucht haben, Open P/L nicht.", image: {"src":`${IMG}/tradovate-open-pl-vs-pl-day-3.png`,"alt":"Tradovate-Positions-Modul mit hervorgehobener Sitzungssummen-Spalte P/L Day neben Open P/L"} },
        { title: "Netto-P/L in den Account Reports gegenprüfen", html: "Beide Spalten im Positions-Raster sind <strong class='text-white'>brutto</strong>, Provisionen und Gebühren werden dort nicht abgezogen. Für die Zahl, die tatsächlich Ihr Guthaben erreicht, öffnen Sie den <strong class='text-white'>Performance</strong>-Bericht unter Account Reports, der Ihre Handelskosten abzieht. Wenn Ihr P/L Day auf dem Bildschirm nie ganz mit Ihrem Konto-Netto übereinstimmt, ist diese Lücke fast immer der Grund.", image: {"src":`${IMG}/tradovate-open-pl-vs-pl-day-4.png`,"alt":"Tradovate-Performance-Bericht unter Account Reports mit Netto-P/L nach Provisionen und Gebühren"} },
      ],
    },
    { type: "heading",text: "Warum der Unterschied wichtig ist" },
    { type: "paragraph",html: "Wenn Sie ein finanziertes Konto oder ein Evaluierungskonto handeln, wird Ihr tägliches Verlustlimit am Sitzungsnetto gemessen, realisiert plus offen, ab demselben Reset um 17:00 Uhr CT. Ein großer Open P/L bei einem laufenden Trade zählt in Echtzeit gegen das Limit, sodass ein Trade, der auf der Schwankung gut aussieht, Ihren P/L Day unbemerkt auf einen Verstoß zutreiben kann. Beobachten Sie bei der Risikosteuerung P/L Day und nicht nur die Schwankung. Genaue Limits und Trailing-Drawdown-Regeln unterscheiden sich je nach Firma und Kontogröße, prüfen Sie daher die aktuellen Regeln Ihrer Firma." },
    { type: "heading",text: "Automatisieren Sie das mit PickMyTrade" },
    { type: "paragraph",html: "Zwei P/L-Spalten anzustarren, um zu entscheiden, wann man aussteigt, ist genau die Art von Urteil, die zerfällt, wenn der Markt sich schnell bewegt. <strong class='text-white'>PickMyTrade leitet Ihre TradingView-Alerts direkt an Tradovate weiter</strong>, sodass Ihre Stops und Ziele nach den von Ihnen festgelegten Regeln ausgelöst werden, ob Sie die Zahlen im Blick haben oder nicht." },
  ], es: [
    { type: "paragraph",html: "En su pantalla de Tradovate hay dos cifras de P/L y rara vez coinciden. <strong class='text-white'>Open P/L</strong> es la ganancia o pérdida no realizada, en tiempo real, de la posición que mantiene en este preciso instante. <strong class='text-white'>P/L Day</strong> es su total de toda la sesión de trading, operaciones cerradas y flotante abierto combinados. Si las confunde, interpretará mal su día. Aquí tiene la explicación clara." },
    { type: "heading",text: "La respuesta corta" },
    { type: "table", headers: ["","Open P/L","P/L Day"], rows: [
      ["Qué mide","Ganancia/pérdida no realizada de su posición abierta actual","P/L total de la sesión: operaciones cerradas más flotante abierto"],
      ["Punto de referencia","Su precio promedio de entrada","Dónde estaba al inicio de la sesión"],
      ["Marca cero cuando","Está plano, sin nada abierto","Empieza una sesión nueva sin operaciones todavía"],
      ["Se actualiza","En cada tick mientras la posición está abierta","En cada tick y cada vez que cierra una operación"],
      ["Se reinicia","En el momento en que cierra la posición","En el límite de sesión de las 5:00 PM hora central"],
    ] },
    { type: "heading",text: "Open P/L: el dinero de la operación en la que está" },
    { type: "paragraph",html: "Open P/L (también lo verá escrito como P/L Open) no está realizado. Tradovate lo mide desde su precio promedio de entrada ponderado por volumen hasta el precio de mercado actual, y lo multiplica por el tamaño de su posición y el valor del tick del instrumento. Se recalcula en cada tick, por lo que sube y baja con el mercado. En cuanto cierra la posición, Open P/L termina: baja a cero y lo que ganó o perdió pasa a su total realizado del día." },
    { type: "paragraph",html: "Piense en él como «qué pasaría si saliera ahora mismo». No dice nada de las tres operaciones que ya cerró esta mañana." },
    { type: "heading",text: "P/L Day: toda la sesión en una sola cifra" },
    { type: "paragraph",html: "P/L Day es el total acumulado de toda la sesión: cada operación que ya cerró más lo que siga flotando en una posición abierta. La trampa es el reloj de la sesión: no se reinicia a medianoche. La sesión de trading de Tradovate comienza a las <strong class='text-white'>5:00 PM hora central (Central Time)</strong> y se extiende hasta las 3:45 PM CT del día siguiente, de domingo a viernes. Así que si opera a las 4 PM CT, esa ejecución ya pertenece al P/L Day de la sesión siguiente." },
    { type: "paragraph",html: "Si hace tres scalps rápidos y queda plano, las dos cifras se separan con claridad: Open P/L marca cero porque no mantiene nada, mientras que P/L Day sigue mostrando la suma de esas tres operaciones cerradas." },
    { type: "heading",text: "Cómo encontrar ambas: paso a paso" },
    {
      type: "steps",
      items: [
        { title: "Abra el módulo Positions", html: "Abra la pestaña <strong class='text-white'>Positions</strong> o añada el módulo Positions a su espacio de trabajo si todavía no está. Enumera cada posición abierta con el instrumento, la cantidad neta, el precio promedio y las dos cifras de P/L una junto a la otra. ¿No ve ambas columnas? Haga clic derecho en el encabezado de columna (o abra la configuración de vista o de columnas del módulo) y actívelas.", image: {"src":`${IMG}/tradovate-open-pl-vs-pl-day-1.png`,"alt":"Módulo Positions de Tradovate mostrando instrumento, cantidad, precio promedio y las columnas Open P/L y P/L Day"} },
        { title: "Lea la columna Open P/L", html: "Busque la columna con su resultado flotante en tiempo real, normalmente rotulada <strong class='text-white'>Open P/L</strong> o <strong class='text-white'>P/L Open</strong>. Verde significa que la posición abierta está en ganancia, rojo que está en pérdida, y sube y baja en tiempo real. Si cierra la posición, esta celda vuelve a cero.", image: {"src":`${IMG}/tradovate-open-pl-vs-pl-day-2.png`,"alt":"Módulo Positions de Tradovate con la columna Open P/L en tiempo real resaltada en una posición abierta de futuros"} },
        { title: "Lea la columna P/L Day", html: "Justo al lado está <strong class='text-white'>P/L Day</strong>, el total de su sesión. Es la cifra que incorpora las ganadoras y perdedoras cerradas junto con el flotante abierto. Cuando Open P/L y P/L Day no coinciden, este es el motivo: P/L Day recuerda las operaciones que ya registró, y Open P/L no.", image: {"src":`${IMG}/tradovate-open-pl-vs-pl-day-3.png`,"alt":"Módulo Positions de Tradovate con la columna de total de sesión P/L Day resaltada junto a Open P/L"} },
        { title: "Contraste el P/L neto en Account Reports", html: "Ambas columnas de la cuadrícula Positions son <strong class='text-white'>brutas</strong>: allí no se restan comisiones ni tarifas. Para la cifra que realmente llega a su saldo, abra el informe <strong class='text-white'>Performance</strong> en Account Reports, que descuenta sus costes de trading. Si su P/L Day en pantalla nunca cuadra del todo con el neto de su cuenta, esta diferencia es casi siempre la razón.", image: {"src":`${IMG}/tradovate-open-pl-vs-pl-day-4.png`,"alt":"Informe Performance de Tradovate en Account Reports mostrando el P/L neto tras comisiones y tarifas"} },
      ],
    },
    { type: "heading",text: "Por qué importa la diferencia" },
    { type: "paragraph",html: "Si opera una cuenta fondeada o de evaluación, su límite de pérdida diaria se mide contra el neto de la sesión, realizado más abierto, desde ese mismo reinicio de las 5:00 PM CT. Un Open P/L grande en una operación en curso cuenta en tiempo real contra el límite, así que una operación que parece bien en el flotante puede empujar silenciosamente su P/L Day hacia una infracción. Vigile P/L Day, no solo el flotante, cuando gestione el riesgo. Los límites exactos y las reglas de trailing drawdown varían según la firma y el tamaño de la cuenta, así que consulte las reglas vigentes de su firma." },
    { type: "heading",text: "Automatice esto con PickMyTrade" },
    { type: "paragraph",html: "Quedarse mirando dos columnas de P/L para decidir cuándo salir es justo el tipo de criterio que se desmorona cuando el mercado se mueve rápido. <strong class='text-white'>PickMyTrade envía sus alertas de TradingView directamente a Tradovate</strong>, de modo que sus stops y objetivos se ejecutan según las reglas que usted definió, esté o no pendiente de los números." },
  ], fr: [
    { type: "paragraph",html: "Deux chiffres de P/L figurent sur votre écran Tradovate, et ils coïncident rarement. <strong class='text-white'>Open P/L</strong> est le gain ou la perte latent(e), en temps réel, de la position que vous détenez à cet instant précis. <strong class='text-white'>P/L Day</strong> est votre total pour toute la séance de trading, trades clôturés et flottant ouvert confondus. Si vous les confondez, vous lirez mal votre journée. Voici la version claire." },
    { type: "heading",text: "La réponse courte" },
    { type: "table", headers: ["","Open P/L","P/L Day"], rows: [
      ["Ce qu'il mesure","Le gain/la perte latent(e) de votre position ouverte actuelle","Le P/L total de la séance : trades clôturés plus flottant ouvert"],
      ["Point de référence","Votre prix d'entrée moyen","Votre situation au début de la séance"],
      ["Affiche zéro quand","Vous êtes à plat, rien d'ouvert","Une nouvelle séance démarre sans aucun trade"],
      ["Mise à jour","À chaque tick tant que la position est ouverte","À chaque tick, et à chaque clôture de trade"],
      ["Réinitialisation","Dès que vous clôturez la position","À la limite de séance de 17h00 heure centrale"],
    ] },
    { type: "heading",text: "Open P/L : l'argent du trade dans lequel vous êtes" },
    { type: "paragraph",html: "Open P/L (vous le verrez aussi écrit P/L Open) est latent. Tradovate le mesure depuis votre prix d'entrée moyen pondéré par le volume jusqu'au prix de marché actuel, puis le multiplie par la taille de votre position et la valeur du tick de l'instrument. Il est recalculé à chaque tick, il monte et descend donc avec le marché. Dès que vous clôturez la position, Open P/L est terminé : il retombe à zéro et ce que vous avez gagné ou perdu rejoint votre total réalisé du jour." },
    { type: "paragraph",html: "Voyez-le comme « que se passerait-il si je sortais maintenant ». Il ne dit rien des trois trades que vous avez déjà clôturés ce matin." },
    { type: "heading",text: "P/L Day : toute la séance en un seul chiffre" },
    { type: "paragraph",html: "P/L Day est le total cumulé de la séance entière : chaque trade déjà clôturé plus ce qui flotte encore sur une position ouverte. Le piège, c'est l'horloge de la séance : elle ne se réinitialise pas à minuit. La séance de trading de Tradovate démarre à <strong class='text-white'>17h00 heure centrale (Central Time)</strong> et court jusqu'à 15h45 CT le lendemain, du dimanche au vendredi. Donc si vous tradez à 16h CT, cette exécution appartient déjà au P/L Day de la séance suivante." },
    { type: "paragraph",html: "Si vous enchaînez trois scalps rapides puis revenez à plat, les deux chiffres se séparent nettement : Open P/L affiche zéro puisque vous ne détenez plus rien, tandis que P/L Day affiche toujours la somme de ces trois trades clôturés." },
    { type: "heading",text: "Les trouver tous les deux : pas à pas" },
    {
      type: "steps",
      items: [
        { title: "Ouvrir le module Positions", html: "Ouvrez l'onglet <strong class='text-white'>Positions</strong>, ou ajoutez le module Positions à votre espace de travail s'il n'y est pas encore. Il liste chaque position ouverte avec l'instrument, la quantité nette, le prix moyen et les deux chiffres de P/L côte à côte. Vous ne voyez pas les deux colonnes ? Faites un clic droit sur l'en-tête de colonne (ou ouvrez les paramètres d'affichage ou de colonnes du module) et activez-les.", image: {"src":`${IMG}/tradovate-open-pl-vs-pl-day-1.png`,"alt":"Module Positions de Tradovate affichant l'instrument, la quantité, le prix moyen et les colonnes Open P/L et P/L Day"} },
        { title: "Lire la colonne Open P/L", html: "Repérez la colonne qui affiche votre résultat flottant en temps réel, généralement intitulée <strong class='text-white'>Open P/L</strong> ou <strong class='text-white'>P/L Open</strong>. Le vert signifie que la position ouverte est en gain, le rouge qu'elle est en perte, et la valeur monte et descend en temps réel. Clôturez la position et cette cellule revient à zéro.", image: {"src":`${IMG}/tradovate-open-pl-vs-pl-day-2.png`,"alt":"Module Positions de Tradovate avec la colonne Open P/L en temps réel mise en évidence sur une position ouverte sur contrats à terme"} },
        { title: "Lire la colonne P/L Day", html: "Juste à côté se trouve <strong class='text-white'>P/L Day</strong>, le total de votre séance. C'est le chiffre qui intègre les gains et pertes clôturés en plus du flottant ouvert. Quand Open P/L et P/L Day divergent, c'est pour cette raison : P/L Day se souvient des trades que vous avez déjà enregistrés, pas Open P/L.", image: {"src":`${IMG}/tradovate-open-pl-vs-pl-day-3.png`,"alt":"Module Positions de Tradovate avec la colonne de total de séance P/L Day mise en évidence à côté d'Open P/L"} },
        { title: "Recouper le P/L net dans Account Reports", html: "Les deux colonnes de la grille Positions sont <strong class='text-white'>brutes</strong> : commissions et frais n'y sont pas déduits. Pour le chiffre qui affecte réellement votre solde, ouvrez le rapport <strong class='text-white'>Performance</strong> dans Account Reports, qui déduit vos coûts de trading. Si votre P/L Day à l'écran ne colle jamais tout à fait avec le net de votre compte, cet écart en est presque toujours la raison.", image: {"src":`${IMG}/tradovate-open-pl-vs-pl-day-4.png`,"alt":"Rapport Performance de Tradovate dans Account Reports affichant le P/L net après commissions et frais"} },
      ],
    },
    { type: "heading",text: "Pourquoi la différence compte" },
    { type: "paragraph",html: "Si vous tradez un compte financé ou d'évaluation, votre limite de perte quotidienne se mesure sur le net de la séance, réalisé plus ouvert, à partir de la même réinitialisation de 17h00 CT. Un Open P/L important sur un trade en cours compte en temps réel dans la limite : un trade qui semble correct sur le flottant peut ainsi pousser discrètement votre P/L Day vers une violation. Surveillez P/L Day, pas seulement le flottant, quand vous gérez le risque. Les limites exactes et les règles de trailing drawdown varient selon la firme et la taille du compte, vérifiez donc les règles en vigueur de votre firme." },
    { type: "heading",text: "Automatisez cela avec PickMyTrade" },
    { type: "paragraph",html: "Fixer deux colonnes de P/L pour décider quand sortir est exactement le genre de jugement qui s'effondre quand le marché s'emballe. <strong class='text-white'>PickMyTrade achemine vos alertes TradingView directement vers Tradovate</strong>, de sorte que vos stops et vos objectifs se déclenchent selon les règles que vous avez définies, que vous surveilliez ou non les chiffres." },
  ], it: [
    { type: "paragraph",html: "Sullo schermo di Tradovate compaiono due numeri di P/L e raramente coincidono. <strong class='text-white'>Open P/L</strong> è il guadagno o la perdita non realizzato, in tempo reale, della posizione che sta detenendo in questo istante. <strong class='text-white'>P/L Day</strong> è il Suo totale dell'intera sessione di trading, operazioni chiuse e flottante aperto insieme. Se li confonde, leggerà male la Sua giornata. Ecco la versione chiara." },
    { type: "heading",text: "La risposta breve" },
    { type: "table", headers: ["","Open P/L","P/L Day"], rows: [
      ["Che cosa misura","Guadagno/perdita non realizzato della Sua posizione aperta attuale","P/L totale della sessione: operazioni chiuse più flottante aperto"],
      ["Punto di riferimento","Il Suo prezzo medio di ingresso","Dove si trovava all'inizio della sessione"],
      ["Mostra zero quando","È flat, nulla di aperto","Inizia una nuova sessione senza ancora operazioni"],
      ["Si aggiorna","A ogni tick finché la posizione è aperta","A ogni tick e ogni volta che chiude un'operazione"],
      ["Si azzera","Nel momento in cui chiude la posizione","Al confine di sessione delle 17:00 ora centrale"],
    ] },
    { type: "heading",text: "Open P/L: il denaro dell'operazione in cui si trova" },
    { type: "paragraph",html: "Open P/L (lo troverà scritto anche come P/L Open) è non realizzato. Tradovate lo misura dal Suo prezzo medio di ingresso ponderato per il volume fino al prezzo di mercato attuale, poi lo moltiplica per la dimensione della posizione e per il valore del tick dello strumento. Si ricalcola a ogni tick, quindi sale e scende con il mercato. Nell'istante in cui chiude la posizione, Open P/L è concluso: scende a zero e ciò che ha guadagnato o perso confluisce nel Suo totale realizzato della giornata." },
    { type: "paragraph",html: "Lo consideri come «che cosa succederebbe se uscissi adesso». Non dice nulla sulle tre operazioni che ha già chiuso stamattina." },
    { type: "heading",text: "P/L Day: l'intera sessione in un solo numero" },
    { type: "paragraph",html: "P/L Day è il totale progressivo dell'intera sessione: ogni operazione già chiusa più ciò che ancora fluttua su una posizione aperta. Il punto delicato è l'orologio della sessione: non si azzera a mezzanotte. La sessione di trading di Tradovate inizia alle <strong class='text-white'>17:00 ora centrale (Central Time)</strong> e prosegue fino alle 15:45 CT del giorno successivo, da domenica a venerdì. Quindi se opera alle 16:00 CT, quell'esecuzione appartiene già al P/L Day della sessione successiva." },
    { type: "paragraph",html: "Se fa tre rapidi scalp e torna flat, i due numeri si separano nettamente: Open P/L mostra zero perché non detiene nulla, mentre P/L Day continua a mostrare la somma di quelle tre operazioni chiuse." },
    { type: "heading",text: "Trovarli entrambi: passo per passo" },
    {
      type: "steps",
      items: [
        { title: "Aprire il modulo Positions", html: "Apra la scheda <strong class='text-white'>Positions</strong>, oppure inserisca il modulo Positions nel Suo spazio di lavoro se non è già presente. Elenca ogni posizione aperta con strumento, quantità netta, prezzo medio e i due valori di P/L affiancati. Non vede entrambe le colonne? Faccia clic destro sull'intestazione della colonna (oppure apra le impostazioni di visualizzazione o delle colonne del modulo) e le attivi.", image: {"src":`${IMG}/tradovate-open-pl-vs-pl-day-1.png`,"alt":"Modulo Positions di Tradovate che mostra strumento, quantità, prezzo medio e le colonne Open P/L e P/L Day"} },
        { title: "Leggere la colonna Open P/L", html: "Trovi la colonna con il Suo risultato flottante in tempo reale, di solito etichettata <strong class='text-white'>Open P/L</strong> o <strong class='text-white'>P/L Open</strong>. Il verde significa che la posizione aperta è in profitto, il rosso che è in perdita, e il valore sale e scende in tempo reale. Chiuda la posizione e questa cella torna a zero.", image: {"src":`${IMG}/tradovate-open-pl-vs-pl-day-2.png`,"alt":"Modulo Positions di Tradovate con la colonna Open P/L in tempo reale evidenziata su una posizione aperta sui futures"} },
        { title: "Leggere la colonna P/L Day", html: "Subito accanto c'è <strong class='text-white'>P/L Day</strong>, il totale della Sua sessione. È il valore che include vincite e perdite chiuse insieme al flottante aperto. Quando Open P/L e P/L Day non coincidono, ecco perché: P/L Day ricorda le operazioni che ha già registrato, Open P/L no.", image: {"src":`${IMG}/tradovate-open-pl-vs-pl-day-3.png`,"alt":"Modulo Positions di Tradovate con la colonna del totale di sessione P/L Day evidenziata accanto a Open P/L"} },
        { title: "Verificare il P/L netto in Account Reports", html: "Entrambe le colonne nella griglia Positions sono <strong class='text-white'>lorde</strong>: commissioni e spese non vengono sottratte. Per il numero che incide davvero sul Suo saldo, apra il report <strong class='text-white'>Performance</strong> in Account Reports, che detrae i costi di trading. Se il P/L Day a schermo non quadra mai del tutto con il netto del Suo conto, questa differenza è quasi sempre il motivo.", image: {"src":`${IMG}/tradovate-open-pl-vs-pl-day-4.png`,"alt":"Report Performance di Tradovate in Account Reports che mostra il P/L netto dopo commissioni e spese"} },
      ],
    },
    { type: "heading",text: "Perché la differenza conta" },
    { type: "paragraph",html: "Se opera con un conto finanziato o di valutazione, il Suo limite di perdita giornaliera viene misurato sul netto della sessione, realizzato più aperto, a partire dallo stesso azzeramento delle 17:00 CT. Un Open P/L elevato su un'operazione in corso conta in tempo reale contro il limite, quindi un'operazione che sembra a posto sul flottante può spingere silenziosamente il Suo P/L Day verso una violazione. Tenga d'occhio P/L Day, non solo il flottante, quando gestisce il rischio. I limiti esatti e le regole di trailing drawdown variano in base alla società e alla dimensione del conto, quindi verifichi le regole attuali della Sua società." },
    { type: "heading",text: "Automatizzi tutto questo con PickMyTrade" },
    { type: "paragraph",html: "Fissare due colonne di P/L per decidere quando uscire è esattamente il tipo di giudizio che crolla quando il mercato si muove in fretta. <strong class='text-white'>PickMyTrade instrada i Suoi alert di TradingView direttamente su Tradovate</strong>, così stop e target scattano secondo le regole che ha impostato, che stia guardando i numeri o meno." },
  ] },
  ctaHeading: { en: "Let Your Rules Manage the Risk", de: "Lassen Sie Ihre Regeln das Risiko steuern", es: "Deje que sus reglas gestionen el riesgo", fr: "Laissez vos règles gérer le risque", it: "Lasci che siano le Sue regole a gestire il rischio" },
  ctaText: { en: "PickMyTrade routes your TradingView alerts straight into Tradovate, so your stops and targets fire on the rules you set, whether or not you're watching the numbers.", de: "PickMyTrade leitet Ihre TradingView-Alerts direkt an Tradovate weiter, sodass Ihre Stops und Ziele nach den von Ihnen festgelegten Regeln ausgelöst werden, ob Sie die Zahlen im Blick haben oder nicht.", es: "PickMyTrade envía sus alertas de TradingView directamente a Tradovate, de modo que sus stops y objetivos se ejecutan según las reglas que usted definió, esté o no pendiente de los números.", fr: "PickMyTrade achemine vos alertes TradingView directement vers Tradovate, de sorte que vos stops et vos objectifs se déclenchent selon les règles que vous avez définies, que vous surveilliez ou non les chiffres.", it: "PickMyTrade instrada i Suoi alert di TradingView direttamente su Tradovate, così stop e target scattano secondo le regole che ha impostato, che stia guardando i numeri o meno." },
  ctaButtonText: { en: "Start Your Free 7-Day Trial", de: "Starten Sie Ihre kostenlose 7-Tage-Testphase", es: "Comience su prueba gratuita de 7 días", fr: "Commencez votre essai gratuit de 7 jours", it: "Inizi la prova gratuita di 7 giorni" },
  ctaUrl: "https://app.pickmytrade.trade/?register=true&utm_source=content&utm_medium=how-to",
  faqHeading: { en: "Frequently Asked Questions", de: "Häufig gestellte Fragen", es: "Preguntas frecuentes", fr: "Foire aux questions", it: "Domande frequenti" },
  faqs: { en: [
    { q: "Does Open P/L include trades I already closed today?", a: "No. Open P/L is only the unrealized float on the position you're holding right now. Once you close a trade, that amount leaves Open P/L and lands in P/L Day." },
    { q: "Why isn't my P/L Day zero at the start of my morning?", a: "The session resets at 5:00 PM Central Time, not at midnight. Anything you traded after 5 PM the previous evening already belongs to the current session's P/L Day." },
    { q: "Do these two numbers include commissions?", a: "No. The Positions grid shows gross figures. For net P/L after commissions and fees, check the Performance report in Account Reports." },
  ], de: [
    { q: "Enthält Open P/L auch Trades, die ich heute bereits geschlossen habe?", a: "Nein. Open P/L ist nur die nicht realisierte Schwankung der Position, die Sie gerade halten. Sobald Sie einen Trade schließen, verlässt dieser Betrag Open P/L und landet in P/L Day." },
    { q: "Warum ist mein P/L Day am Morgen nicht null?", a: "Die Sitzung wird um 17:00 Uhr Central Time zurückgesetzt, nicht um Mitternacht. Alles, was Sie nach 17 Uhr am Vorabend gehandelt haben, gehört bereits zum P/L Day der aktuellen Sitzung." },
    { q: "Enthalten diese beiden Zahlen Provisionen?", a: "Nein. Das Positions-Raster zeigt Bruttowerte. Den Netto-P/L nach Provisionen und Gebühren finden Sie im Performance-Bericht unter Account Reports." },
  ], es: [
    { q: "¿Open P/L incluye las operaciones que ya cerré hoy?", a: "No. Open P/L es solo el flotante no realizado de la posición que mantiene en este momento. Cuando cierra una operación, ese importe sale de Open P/L y pasa a P/L Day." },
    { q: "¿Por qué mi P/L Day no es cero al empezar la mañana?", a: "La sesión se reinicia a las 5:00 PM hora central (Central Time), no a medianoche. Todo lo que operó después de las 5 PM de la tarde anterior ya pertenece al P/L Day de la sesión actual." },
    { q: "¿Estas dos cifras incluyen comisiones?", a: "No. La cuadrícula Positions muestra cifras brutas. Para el P/L neto después de comisiones y tarifas, consulte el informe Performance en Account Reports." },
  ], fr: [
    { q: "Open P/L inclut-il les trades que j'ai déjà clôturés aujourd'hui ?", a: "Non. Open P/L correspond uniquement au flottant latent de la position que vous détenez actuellement. Dès que vous clôturez un trade, ce montant quitte Open P/L et passe dans P/L Day." },
    { q: "Pourquoi mon P/L Day n'est-il pas à zéro en début de matinée ?", a: "La séance se réinitialise à 17h00 heure centrale (Central Time), pas à minuit. Tout ce que vous avez tradé après 17h la veille au soir appartient déjà au P/L Day de la séance en cours." },
    { q: "Ces deux chiffres incluent-ils les commissions ?", a: "Non. La grille Positions affiche des chiffres bruts. Pour le P/L net après commissions et frais, consultez le rapport Performance dans Account Reports." },
  ], it: [
    { q: "Open P/L include le operazioni che ho già chiuso oggi?", a: "No. Open P/L è solo il flottante non realizzato della posizione che sta detenendo in questo momento. Una volta chiusa un'operazione, quell'importo esce da Open P/L e finisce in P/L Day." },
    { q: "Perché il mio P/L Day non è zero all'inizio della mattinata?", a: "La sessione si azzera alle 17:00 ora centrale (Central Time), non a mezzanotte. Tutto ciò che ha operato dopo le 17 della sera precedente appartiene già al P/L Day della sessione corrente." },
    { q: "Questi due numeri includono le commissioni?", a: "No. La griglia Positions mostra valori lordi. Per il P/L netto dopo commissioni e spese, consulti il report Performance in Account Reports." },
  ] },
  relatedHeading: { en: "Related Guides", de: "Verwandte Leitfäden", es: "Guías relacionadas", fr: "Guides associés", it: "Guide correlate" },
  disclosureText: { en: `This guide is for educational and informational purposes only and is not financial, investment, or trading advice. Trading futures and other leveraged products carries a substantial risk of loss and is not suitable for every investor. PickMyTrade is an independent third-party automation platform and is not affiliated with, endorsed by, or sponsored by Tradovate, Inc. "Tradovate" and all related names, logos, and trademarks are the property of their respective owners. Platform features and steps change over time, so always confirm the current process in the official Tradovate platform and documentation before acting.`, de: "Dieser Leitfaden dient ausschließlich Bildungs- und Informationszwecken und stellt keine Finanz-, Anlage- oder Handelsberatung dar. Der Handel mit Futures und anderen gehebelten Produkten birgt ein erhebliches Verlustrisiko und ist nicht für jeden Anleger geeignet. PickMyTrade ist eine unabhängige Automatisierungsplattform eines Drittanbieters und ist weder mit Tradovate, Inc. verbunden noch von Tradovate, Inc. unterstützt oder gesponsert. „Tradovate“ und alle zugehörigen Namen, Logos und Marken sind Eigentum ihrer jeweiligen Inhaber. Plattformfunktionen und Schritte ändern sich im Laufe der Zeit. Bestätigen Sie daher stets den aktuellen Ablauf in der offiziellen Tradovate-Plattform und -Dokumentation, bevor Sie handeln.", es: "Esta guía tiene fines exclusivamente educativos e informativos y no constituye asesoramiento financiero, de inversión ni de trading. Operar con futuros y otros productos apalancados conlleva un riesgo sustancial de pérdida y no es adecuado para todos los inversores. PickMyTrade es una plataforma de automatización independiente de terceros y no está afiliada, respaldada ni patrocinada por Tradovate, Inc. «Tradovate» y todos los nombres, logotipos y marcas relacionados son propiedad de sus respectivos titulares. Las funciones y los pasos de la plataforma cambian con el tiempo, por lo que debe confirmar siempre el proceso actual en la plataforma y la documentación oficiales de Tradovate antes de actuar.", fr: "Ce guide est fourni à des fins éducatives et informatives uniquement et ne constitue pas un conseil financier, d'investissement ou de trading. La négociation de contrats à terme et d'autres produits à effet de levier comporte un risque de perte important et ne convient pas à tous les investisseurs. PickMyTrade est une plateforme d'automatisation tierce indépendante, non affiliée à Tradovate, Inc., ni approuvée ou parrainée par cette dernière. « Tradovate » ainsi que tous les noms, logos et marques associés sont la propriété de leurs détenteurs respectifs. Les fonctionnalités et les étapes de la plateforme évoluent avec le temps : vérifiez toujours la procédure en vigueur dans la plateforme et la documentation officielles de Tradovate avant d'agir.", it: "Questa guida ha esclusivamente scopo didattico e informativo e non costituisce consulenza finanziaria, di investimento o di trading. Il trading di futures e di altri prodotti a leva comporta un rischio di perdita sostanziale e non è adatto a tutti gli investitori. PickMyTrade è una piattaforma di automazione indipendente di terze parti e non è affiliata, approvata né sponsorizzata da Tradovate, Inc. «Tradovate» e tutti i nomi, loghi e marchi correlati sono di proprietà dei rispettivi titolari. Le funzionalità e i passaggi della piattaforma cambiano nel tempo, quindi confermi sempre la procedura attuale nella piattaforma e nella documentazione ufficiali di Tradovate prima di agire." },
};
