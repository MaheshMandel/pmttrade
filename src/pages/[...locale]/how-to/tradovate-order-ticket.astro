---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "tradovate-order-ticket";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/how-to/${SLUG}`;

const META_TITLE = "Use the Tradovate Order Ticket to Place Orders";
const META_DESCRIPTION =
  "Place market, limit, and stop futures orders straight from the order ticket: pick an account, set quantity and price, choose time-in-force, and hit send.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Mit dem Tradovate-Order-Ticket Orders platzieren", es: "Usar el ticket de órdenes de Tradovate para colocar órdenes", fr: "Utiliser le ticket d’ordre Tradovate pour passer des ordres", it: "Usare l’Order Ticket di Tradovate per inserire ordini" },
  dek: { en: "The Order Ticket is the most direct way to put an order into the market in Tradovate. No dragging on a chart, no clicking a price on the ladder, you type exactly what you want and send it.", de: "Das Order Ticket ist der direkteste Weg, in Tradovate eine Order an den Markt zu bringen. Kein Ziehen im Chart, kein Klicken auf einen Preis in der Leiter: Sie geben genau ein, was Sie wollen, und senden es ab.", es: "El Order Ticket es la forma más directa de enviar una orden al mercado en Tradovate. Sin arrastrar en un gráfico ni hacer clic en un precio de la escalera: usted escribe exactamente lo que quiere y lo envía.", fr: "L’Order Ticket est le moyen le plus direct de placer un ordre sur le marché dans Tradovate. Pas de glisser-déposer sur un graphique, pas de clic sur un prix de l’échelle : vous saisissez exactement ce que vous voulez et vous l’envoyez.", it: "L’Order Ticket è il modo più diretto per inviare un ordine al mercato in Tradovate. Niente trascinamenti su un grafico, niente clic su un prezzo della scala: Lei digita esattamente ciò che vuole e lo invia." },
  readTime: { en: "6 min read", de: "6 Min. Lesezeit", es: "Lectura de 6 min", fr: "Lecture : 6 min", it: "Lettura di 6 min" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "The Order Ticket is the most direct way to put an order into the market in Tradovate. No dragging on a chart, no clicking a price on the ladder, you type exactly what you want and send it. It's a small panel, but every field matters: get the direction, quantity, order type, or price wrong and you can end up in a position you didn't intend. This guide walks through placing a market, limit, or stop order from the ticket, plus what to check before you hit Send." },
    { type: "paragraph", html: "If you'd rather click price levels directly, the SuperDOM ladder is the other common way to enter orders. The Order Ticket is the better fit when you know your price and want to type it in cleanly." },
    {
      type: "steps",
      items: [
        { title: "Add the Order Ticket to Your Workspace", html: "Open the <strong class='text-white'>New +</strong> menu at the top of the platform and drag the <strong class='text-white'>Order Ticket</strong> module onto your workspace. It docks like any other panel, so you can size it and park it next to your chart or DOM. On mobile, the equivalent is the order entry screen you reach after selecting a contract.", image: { src: `${IMG}/tradovate-order-ticket-1.png`, alt: "Tradovate New Plus menu open with the Order Ticket module being dragged onto the workspace" } },
        { title: "Pick the Account and Contract", html: "Before anything else, confirm which account the ticket is pointed at. If you run a personal account and one or more evaluation accounts, the ticket trades whatever account is selected, an easy thing to overlook when you're moving fast. Then click the instrument name in the top-left of the module tab and type a symbol (for example <strong class='text-white'>MNQ</strong>, <strong class='text-white'>ES</strong>, or <strong class='text-white'>CL</strong>). A dropdown lists the available contracts; pick the current front-month unless you're deliberately trading a later expiration.", image: { src: `${IMG}/tradovate-order-ticket-2.png`, alt: "Tradovate Order Ticket with the account selector and instrument search dropdown showing a futures contract" } },
        { title: "Set Direction and Quantity", html: "Choose <strong class='text-white'>Buy</strong> or <strong class='text-white'>Sell</strong>, then enter the <strong class='text-white'>Quantity</strong>, the number of contracts. Keep an eye on your risk limits here. If you're on a funded or evaluation account, the maximum contracts you can hold is capped, and that ceiling varies by firm and account size, so check your firm's current rules before sizing up. Overshoot it and the order comes back rejected.", image: { src: `${IMG}/tradovate-order-ticket-3.png`, alt: "Tradovate Order Ticket showing Buy and Sell buttons with the quantity field set to a contract count" } },
        { title: "Choose the Order Type and Price", html: "Open the order type selector and pick how you want the order to fill. Tradovate also offers a <strong class='text-white'>Stop Limit</strong> (a stop that becomes a limit instead of a market order) and other advanced types, but market, limit, and stop cover most day-to-day entries and exits. Type your price carefully, a mistyped limit or stop is one of the fastest ways to get a fill you didn't want.", image: { src: `${IMG}/tradovate-order-ticket-4.png`, alt: "Tradovate Order Ticket order type dropdown expanded showing Market, Limit, and Stop with a price field" } },
        { title: "Set Time-in-Force and Send", html: "Pick a <strong class='text-white'>time-in-force</strong> so the platform knows how long the order should live: <strong class='text-white'>Day</strong> expires at the end of the session if it hasn't filled, <strong class='text-white'>GTC</strong> (Good-Til-Canceled) stays working across sessions until it fills or you cancel it, and <strong class='text-white'>GTD</strong> (Good-Til-Date) works until a date you set. A market order fills right away, so time-in-force matters most for limit and stop orders that may sit in the book. Do a last read of the whole ticket, account, contract, Buy/Sell, quantity, type, price, then click <strong class='text-white'>Send</strong>. That single review habit catches the mistakes that hurt most. Want stop-loss and take-profit to attach automatically when your entry fills? Flip the ticket from Simple to Advanced View and build a bracket.", image: { src: `${IMG}/tradovate-order-ticket-5.png`, alt: "Tradovate Order Ticket with the time-in-force selector set to Day and the Send button highlighted" } },
        { title: "Track, Modify, or Cancel the Order", html: "Once you Send, a market order should fill in a moment and show up as a position. A limit or stop order sits as a working order in the <strong class='text-white'>Orders</strong> module. From there you can change the price if the market moved past you, adjust quantity, or cancel it outright. If an order won't modify or cancel during a platform hiccup, flattening the position manually is the safe fallback.", image: { src: `${IMG}/tradovate-order-ticket-6.png`, alt: "Tradovate Orders module listing a working order with modify and cancel controls" } },
      ],
    },
    {
      type: "table",
      headers: ["Order type", "What it does", "Price you enter"],
      rows: [
        ["Market", "Fills immediately at the best available price. Fast, but the fill can slip in a fast market.", "None"],
        ["Limit", "Fills only at your price or better. A buy limit sits below the market; a sell limit sits above.", "Your limit price"],
        ["Stop", "Rests until the market trades through your trigger, then fires as a market order. Common for stop-losses and breakout entries.", "Your stop (trigger) price"],
      ],
    },
    { type: "heading", text: "A Few Things Worth Remembering" },
    { type: "paragraph", html: "Double-check the account selector every session, sending to the wrong account is the classic order-ticket mistake. If a market order rejects, it's usually risk limits, margin, or a data agreement rather than the ticket itself. And if you place a lot of the same setups, save an ATM profile so your quantity, type, and protective orders are one click away instead of five fields to fill each time." },
    { type: "heading", text: "Automate This with PickMyTrade" },
    { type: "paragraph", html: "Trading the same signals by hand gets old fast. <strong class='text-white'>PickMyTrade auto-fires your Tradovate orders straight from TradingView alerts</strong>, so every entry and exit goes in exactly as planned." },
  ], de: [
    { type: "paragraph",html: "Das Order Ticket ist der direkteste Weg, in Tradovate eine Order an den Markt zu bringen. Kein Ziehen im Chart, kein Klicken auf einen Preis in der Leiter: Sie geben genau ein, was Sie wollen, und senden es ab. Es ist ein kleines Panel, aber jedes Feld zählt: Wenn Richtung, Menge, Ordertyp oder Preis falsch sind, landen Sie womöglich in einer Position, die Sie nicht beabsichtigt haben. Diese Anleitung zeigt, wie Sie vom Ticket aus eine Market-, Limit- oder Stop-Order platzieren, und was Sie prüfen sollten, bevor Sie auf Senden klicken." },
    { type: "paragraph",html: "Wenn Sie lieber direkt auf Preisniveaus klicken, ist die SuperDOM-Leiter die andere gängige Möglichkeit, Orders zu platzieren. Das Order Ticket passt besser, wenn Sie Ihren Preis kennen und ihn sauber eintippen möchten." },
    {
      type: "steps",
      items: [
        { title: "Order Ticket zu Ihrem Workspace hinzufügen", html: "Öffnen Sie oben in der Plattform das Menü <strong class='text-white'>New +</strong> und ziehen Sie das Modul <strong class='text-white'>Order Ticket</strong> auf Ihren Workspace. Es dockt wie jedes andere Panel an, sodass Sie es in der Größe anpassen und neben Ihrem Chart oder DOM platzieren können. In der mobilen App entspricht dem der Orderbildschirm, den Sie nach der Auswahl eines Kontrakts erreichen.", image: {"src":`${IMG}/tradovate-order-ticket-1.png`,"alt":"Tradovate-Menü New Plus geöffnet, das Modul Order Ticket wird auf den Workspace gezogen"} },
        { title: "Konto und Kontrakt auswählen", html: "Prüfen Sie zuerst, auf welches Konto das Ticket zeigt. Wenn Sie ein persönliches Konto und ein oder mehrere Evaluierungskonten betreiben, handelt das Ticket mit dem gerade ausgewählten Konto, was man in der Hektik leicht übersieht. Klicken Sie dann oben links im Modul-Tab auf den Instrumentnamen und geben Sie ein Symbol ein (zum Beispiel <strong class='text-white'>MNQ</strong>, <strong class='text-white'>ES</strong> oder <strong class='text-white'>CL</strong>). Ein Dropdown listet die verfügbaren Kontrakte auf; wählen Sie den aktuellen Frontmonat, sofern Sie nicht bewusst einen späteren Verfall handeln.", image: {"src":`${IMG}/tradovate-order-ticket-2.png`,"alt":"Tradovate Order Ticket mit Kontoauswahl und Instrumentensuche, die einen Futures-Kontrakt anzeigt"} },
        { title: "Richtung und Menge festlegen", html: "Wählen Sie <strong class='text-white'>Buy</strong> oder <strong class='text-white'>Sell</strong> und geben Sie dann die <strong class='text-white'>Quantity</strong> ein, also die Anzahl der Kontrakte. Behalten Sie hier Ihre Risikolimits im Blick. Bei einem finanzierten Konto oder Evaluierungskonto ist die maximale Anzahl haltbarer Kontrakte begrenzt, und diese Obergrenze variiert je nach Firma und Kontogröße. Prüfen Sie daher die aktuellen Regeln Ihrer Firma, bevor Sie die Größe erhöhen. Überschreiten Sie sie, wird die Order abgelehnt.", image: {"src":`${IMG}/tradovate-order-ticket-3.png`,"alt":"Tradovate Order Ticket mit Buy- und Sell-Schaltflächen und einer auf eine Kontraktanzahl gesetzten Menge"} },
        { title: "Ordertyp und Preis wählen", html: "Öffnen Sie die Ordertyp-Auswahl und wählen Sie, wie die Order ausgeführt werden soll. Tradovate bietet außerdem <strong class='text-white'>Stop Limit</strong> (ein Stop, der zu einer Limit- statt zu einer Market-Order wird) und weitere erweiterte Typen an, aber Market, Limit und Stop decken die meisten alltäglichen Ein- und Ausstiege ab. Geben Sie Ihren Preis sorgfältig ein: Ein vertipptes Limit oder ein vertippter Stop ist eine der schnellsten Möglichkeiten, eine ungewollte Ausführung zu bekommen.", image: {"src":`${IMG}/tradovate-order-ticket-4.png`,"alt":"Aufgeklapptes Ordertyp-Dropdown im Tradovate Order Ticket mit Market, Limit und Stop sowie einem Preisfeld"} },
        { title: "Gültigkeitsdauer festlegen und senden", html: "Wählen Sie eine <strong class='text-white'>Time-in-Force</strong>, damit die Plattform weiß, wie lange die Order gültig sein soll: <strong class='text-white'>Day</strong> läuft am Ende der Sitzung ab, wenn sie nicht ausgeführt wurde, <strong class='text-white'>GTC</strong> (Good-Til-Canceled) bleibt über Sitzungen hinweg aktiv, bis sie ausgeführt oder von Ihnen storniert wird, und <strong class='text-white'>GTD</strong> (Good-Til-Date) bleibt bis zu einem von Ihnen festgelegten Datum aktiv. Eine Market-Order wird sofort ausgeführt, daher ist die Time-in-Force vor allem bei Limit- und Stop-Orders wichtig, die im Orderbuch liegen können. Lesen Sie das gesamte Ticket zum Schluss noch einmal durch, also Konto, Kontrakt, Buy/Sell, Menge, Typ, Preis, und klicken Sie dann auf <strong class='text-white'>Send</strong>. Allein diese Kontrollgewohnheit fängt die Fehler ab, die am meisten wehtun. Sollen Stop-Loss und Take-Profit automatisch angehängt werden, wenn Ihr Einstieg ausgeführt wird? Schalten Sie das Ticket von Simple auf Advanced View um und bauen Sie ein Bracket.", image: {"src":`${IMG}/tradovate-order-ticket-5.png`,"alt":"Tradovate Order Ticket mit auf Day gesetzter Time-in-Force und hervorgehobener Send-Schaltfläche"} },
        { title: "Order verfolgen, ändern oder stornieren", html: "Nach dem Senden sollte eine Market-Order sofort ausgeführt werden und als Position erscheinen. Eine Limit- oder Stop-Order bleibt als aktive Order im Modul <strong class='text-white'>Orders</strong> stehen. Dort können Sie den Preis ändern, falls der Markt an Ihnen vorbeigelaufen ist, die Menge anpassen oder die Order ganz stornieren. Lässt sich eine Order bei einer Plattformstörung nicht ändern oder stornieren, ist das manuelle Glattstellen der Position der sichere Ausweg.", image: {"src":`${IMG}/tradovate-order-ticket-6.png`,"alt":"Tradovate-Modul Orders mit einer aktiven Order und Steuerelementen zum Ändern und Stornieren"} },
      ],
    },
    { type: "table", headers: ["Ordertyp","Was sie bewirkt","Einzugebender Preis"], rows: [
      ["Market-Order","Wird sofort zum bestmöglichen verfügbaren Preis ausgeführt. Schnell, aber die Ausführung kann in einem schnellen Markt abweichen (Slippage).","Keiner"],
      ["Limit-Order","Wird nur zu Ihrem Preis oder besser ausgeführt. Ein Buy Limit liegt unter dem Markt, ein Sell Limit darüber.","Ihr Limitpreis"],
      ["Stop-Order","Wartet, bis der Markt Ihren Auslösepreis durchhandelt, und wird dann als Market-Order ausgelöst. Üblich für Stop-Losses und Breakout-Einstiege.","Ihr Stop-Preis (Auslösepreis)"],
    ] },
    { type: "heading",text: "Einige Dinge, die man sich merken sollte" },
    { type: "paragraph",html: "Prüfen Sie in jeder Sitzung die Kontoauswahl, denn das Senden an das falsche Konto ist der klassische Fehler beim Order Ticket. Wird eine Market-Order abgelehnt, liegt das meist an Risikolimits, Margin oder einer Datenvereinbarung und nicht am Ticket selbst. Und wenn Sie viele gleiche Setups platzieren, speichern Sie ein ATM-Profil, damit Menge, Typ und Schutzorders mit einem Klick bereitstehen, statt jedes Mal fünf Felder auszufüllen." },
    { type: "heading",text: "Automatisieren Sie dies mit PickMyTrade" },
    { type: "paragraph",html: "Dieselben Signale von Hand zu handeln, wird schnell lästig. <strong class='text-white'>PickMyTrade löst Ihre Tradovate-Orders direkt aus TradingView-Alerts automatisch aus</strong>, sodass jeder Einstieg und Ausstieg genau wie geplant erfolgt." },
  ], es: [
    { type: "paragraph",html: "El Order Ticket es la forma más directa de enviar una orden al mercado en Tradovate. Sin arrastrar en un gráfico ni hacer clic en un precio de la escalera: usted escribe exactamente lo que quiere y lo envía. Es un panel pequeño, pero cada campo importa: si se equivoca en la dirección, la cantidad, el tipo de orden o el precio, puede acabar en una posición que no pretendía. Esta guía explica cómo colocar una orden de mercado, límite o stop desde el ticket, además de qué revisar antes de pulsar Enviar." },
    { type: "paragraph",html: "Si prefiere hacer clic directamente en los niveles de precio, la escalera SuperDOM es la otra forma habitual de introducir órdenes. El Order Ticket es la mejor opción cuando usted conoce su precio y quiere escribirlo con limpieza." },
    {
      type: "steps",
      items: [
        { title: "Añada el Order Ticket a su espacio de trabajo", html: "Abra el menú <strong class='text-white'>New +</strong> en la parte superior de la plataforma y arrastre el módulo <strong class='text-white'>Order Ticket</strong> a su espacio de trabajo. Se acopla como cualquier otro panel, de modo que puede cambiar su tamaño y colocarlo junto a su gráfico o DOM. En el móvil, el equivalente es la pantalla de entrada de órdenes a la que accede tras seleccionar un contrato.", image: {"src":`${IMG}/tradovate-order-ticket-1.png`,"alt":"Menú New Plus de Tradovate abierto mientras se arrastra el módulo Order Ticket al espacio de trabajo"} },
        { title: "Elija la cuenta y el contrato", html: "Antes que nada, confirme a qué cuenta apunta el ticket. Si usted tiene una cuenta personal y una o más cuentas de evaluación, el ticket opera con la cuenta que esté seleccionada, algo fácil de pasar por alto cuando va con prisa. Después haga clic en el nombre del instrumento en la parte superior izquierda de la pestaña del módulo y escriba un símbolo (por ejemplo <strong class='text-white'>MNQ</strong>, <strong class='text-white'>ES</strong> o <strong class='text-white'>CL</strong>). Un desplegable muestra los contratos disponibles; elija el contrato del mes más próximo, a menos que quiera operar deliberadamente un vencimiento posterior.", image: {"src":`${IMG}/tradovate-order-ticket-2.png`,"alt":"Order Ticket de Tradovate con el selector de cuenta y el desplegable de búsqueda de instrumentos mostrando un contrato de futuros"} },
        { title: "Defina la dirección y la cantidad", html: "Elija <strong class='text-white'>Buy</strong> o <strong class='text-white'>Sell</strong> y luego introduzca la <strong class='text-white'>Quantity</strong>, es decir, el número de contratos. Vigile aquí sus límites de riesgo. Si usted opera una cuenta fondeada o de evaluación, el máximo de contratos que puede mantener tiene un tope, y ese tope varía según la firma y el tamaño de la cuenta, así que consulte las reglas vigentes de su firma antes de aumentar el tamaño. Si lo supera, la orden será rechazada.", image: {"src":`${IMG}/tradovate-order-ticket-3.png`,"alt":"Order Ticket de Tradovate con los botones Buy y Sell y el campo de cantidad establecido en un número de contratos"} },
        { title: "Elija el tipo de orden y el precio", html: "Abra el selector de tipo de orden y elija cómo quiere que se ejecute. Tradovate también ofrece <strong class='text-white'>Stop Limit</strong> (un stop que se convierte en orden límite en lugar de orden de mercado) y otros tipos avanzados, pero mercado, límite y stop cubren la mayoría de las entradas y salidas del día a día. Escriba su precio con cuidado: un límite o un stop mal tecleado es una de las formas más rápidas de obtener una ejecución no deseada.", image: {"src":`${IMG}/tradovate-order-ticket-4.png`,"alt":"Desplegable de tipo de orden del Order Ticket de Tradovate con Market, Limit y Stop y un campo de precio"} },
        { title: "Defina la vigencia y envíe", html: "Elija una <strong class='text-white'>time-in-force</strong> para que la plataforma sepa cuánto tiempo debe vivir la orden: <strong class='text-white'>Day</strong> caduca al final de la sesión si no se ha ejecutado, <strong class='text-white'>GTC</strong> (Good-Til-Canceled) sigue activa entre sesiones hasta que se ejecute o usted la cancele, y <strong class='text-white'>GTD</strong> (Good-Til-Date) funciona hasta una fecha que usted establezca. Una orden de mercado se ejecuta de inmediato, por lo que la time-in-force importa sobre todo en órdenes límite y stop que pueden quedar en el libro. Haga una última lectura de todo el ticket, cuenta, contrato, Buy/Sell, cantidad, tipo, precio, y luego haga clic en <strong class='text-white'>Send</strong>. Ese único hábito de revisión detecta los errores que más duelen. ¿Quiere que el stop-loss y el take-profit se adjunten automáticamente cuando se ejecute su entrada? Cambie el ticket de Simple a Advanced View y construya un bracket.", image: {"src":`${IMG}/tradovate-order-ticket-5.png`,"alt":"Order Ticket de Tradovate con la time-in-force establecida en Day y el botón Send resaltado"} },
        { title: "Siga, modifique o cancele la orden", html: "Una vez que pulsa Send, una orden de mercado debería ejecutarse en un instante y aparecer como posición. Una orden límite o stop queda como orden activa en el módulo <strong class='text-white'>Orders</strong>. Desde allí puede cambiar el precio si el mercado se le adelantó, ajustar la cantidad o cancelarla por completo. Si una orden no se deja modificar o cancelar durante una incidencia de la plataforma, cerrar la posición manualmente es la alternativa segura.", image: {"src":`${IMG}/tradovate-order-ticket-6.png`,"alt":"Módulo Orders de Tradovate con una orden activa y controles para modificar y cancelar"} },
      ],
    },
    { type: "table", headers: ["Tipo de orden","Qué hace","Precio que introduce"], rows: [
      ["Mercado (Market)","Se ejecuta de inmediato al mejor precio disponible. Es rápida, pero la ejecución puede deslizarse en un mercado rápido.","Ninguno"],
      ["Límite (Limit)","Se ejecuta solo a su precio o mejor. Un límite de compra se sitúa por debajo del mercado; uno de venta, por encima.","Su precio límite"],
      ["Stop","Espera hasta que el mercado cruce su precio de activación y entonces se lanza como orden de mercado. Habitual para stop-loss y entradas en rupturas.","Su precio stop (de activación)"],
    ] },
    { type: "heading",text: "Algunas cosas que conviene recordar" },
    { type: "paragraph",html: "Compruebe el selector de cuenta en cada sesión: enviar a la cuenta equivocada es el error clásico del order ticket. Si una orden de mercado es rechazada, normalmente se debe a límites de riesgo, margen o un acuerdo de datos, y no al ticket en sí. Y si coloca muchas veces las mismas configuraciones, guarde un perfil ATM para tener la cantidad, el tipo y las órdenes de protección a un clic en lugar de rellenar cinco campos cada vez." },
    { type: "heading",text: "Automatice esto con PickMyTrade" },
    { type: "paragraph",html: "Operar a mano las mismas señales cansa rápido. <strong class='text-white'>PickMyTrade lanza automáticamente sus órdenes de Tradovate directamente desde las alertas de TradingView</strong>, de modo que cada entrada y salida se ejecuta exactamente como lo planeó." },
  ], fr: [
    { type: "paragraph",html: "L’Order Ticket est le moyen le plus direct de placer un ordre sur le marché dans Tradovate. Pas de glisser-déposer sur un graphique, pas de clic sur un prix de l’échelle : vous saisissez exactement ce que vous voulez et vous l’envoyez. C’est un petit panneau, mais chaque champ compte : si vous vous trompez de sens, de quantité, de type d’ordre ou de prix, vous pouvez vous retrouver dans une position que vous ne souhaitiez pas. Ce guide explique comment passer un ordre au marché, à cours limité ou stop depuis le ticket, ainsi que ce qu’il faut vérifier avant de cliquer sur Envoyer." },
    { type: "paragraph",html: "Si vous préférez cliquer directement sur les niveaux de prix, l’échelle SuperDOM est l’autre moyen courant de passer des ordres. L’Order Ticket convient mieux lorsque vous connaissez votre prix et souhaitez le saisir proprement." },
    {
      type: "steps",
      items: [
        { title: "Ajoutez l’Order Ticket à votre espace de travail", html: "Ouvrez le menu <strong class='text-white'>New +</strong> en haut de la plateforme et faites glisser le module <strong class='text-white'>Order Ticket</strong> dans votre espace de travail. Il s’ancre comme n’importe quel autre panneau : vous pouvez donc le redimensionner et le placer à côté de votre graphique ou de votre DOM. Sur mobile, l’équivalent est l’écran de saisie d’ordre auquel vous accédez après avoir sélectionné un contrat.", image: {"src":`${IMG}/tradovate-order-ticket-1.png`,"alt":"Menu New Plus de Tradovate ouvert avec le module Order Ticket glissé dans l’espace de travail"} },
        { title: "Choisissez le compte et le contrat", html: "Avant tout, vérifiez sur quel compte le ticket est pointé. Si vous avez un compte personnel et un ou plusieurs comptes d’évaluation, le ticket négocie sur le compte sélectionné, un détail facile à négliger quand on va vite. Cliquez ensuite sur le nom de l’instrument en haut à gauche de l’onglet du module et saisissez un symbole (par exemple <strong class='text-white'>MNQ</strong>, <strong class='text-white'>ES</strong> ou <strong class='text-white'>CL</strong>). Une liste déroulante affiche les contrats disponibles ; choisissez le contrat du mois en cours, sauf si vous négociez délibérément une échéance ultérieure.", image: {"src":`${IMG}/tradovate-order-ticket-2.png`,"alt":"Order Ticket Tradovate avec le sélecteur de compte et la liste déroulante de recherche d’instrument affichant un contrat à terme"} },
        { title: "Définissez le sens et la quantité", html: "Choisissez <strong class='text-white'>Buy</strong> ou <strong class='text-white'>Sell</strong>, puis saisissez la <strong class='text-white'>Quantity</strong>, c’est-à-dire le nombre de contrats. Gardez un œil sur vos limites de risque. Si vous êtes sur un compte financé ou d’évaluation, le nombre maximal de contrats que vous pouvez détenir est plafonné, et ce plafond varie selon la société et la taille du compte ; vérifiez donc les règles en vigueur de votre société avant d’augmenter la taille. Si vous le dépassez, l’ordre est rejeté.", image: {"src":`${IMG}/tradovate-order-ticket-3.png`,"alt":"Order Ticket Tradovate affichant les boutons Buy et Sell avec le champ de quantité réglé sur un nombre de contrats"} },
        { title: "Choisissez le type d’ordre et le prix", html: "Ouvrez le sélecteur de type d’ordre et choisissez la façon dont vous voulez que l’ordre soit exécuté. Tradovate propose aussi le <strong class='text-white'>Stop Limit</strong> (un stop qui devient un ordre à cours limité plutôt qu’un ordre au marché) et d’autres types avancés, mais le marché, le limité et le stop couvrent la plupart des entrées et sorties courantes. Saisissez votre prix avec soin : un limite ou un stop mal saisi est l’un des moyens les plus rapides d’obtenir une exécution non souhaitée.", image: {"src":`${IMG}/tradovate-order-ticket-4.png`,"alt":"Liste déroulante du type d’ordre de l’Order Ticket Tradovate affichant Market, Limit et Stop avec un champ de prix"} },
        { title: "Définissez la durée de validité et envoyez", html: "Choisissez une <strong class='text-white'>time-in-force</strong> pour que la plateforme sache combien de temps l’ordre doit rester actif : <strong class='text-white'>Day</strong> expire à la fin de la séance s’il n’a pas été exécuté, <strong class='text-white'>GTC</strong> (Good-Til-Canceled) reste actif d’une séance à l’autre jusqu’à exécution ou annulation de votre part, et <strong class='text-white'>GTD</strong> (Good-Til-Date) reste actif jusqu’à une date que vous définissez. Un ordre au marché est exécuté immédiatement ; la time-in-force importe donc surtout pour les ordres limités et stop qui peuvent rester dans le carnet. Relisez une dernière fois l’ensemble du ticket, compte, contrat, Buy/Sell, quantité, type, prix, puis cliquez sur <strong class='text-white'>Send</strong>. Cette seule habitude de vérification évite les erreurs qui coûtent le plus cher. Vous voulez que le stop-loss et le take-profit se joignent automatiquement lorsque votre entrée est exécutée ? Faites passer le ticket de Simple à Advanced View et construisez un bracket.", image: {"src":`${IMG}/tradovate-order-ticket-5.png`,"alt":"Order Ticket Tradovate avec la time-in-force réglée sur Day et le bouton Send mis en évidence"} },
        { title: "Suivez, modifiez ou annulez l’ordre", html: "Une fois l’ordre envoyé, un ordre au marché devrait être exécuté en un instant et apparaître comme position. Un ordre limité ou stop reste en attente comme ordre actif dans le module <strong class='text-white'>Orders</strong>. De là, vous pouvez modifier le prix si le marché est passé devant vous, ajuster la quantité ou l’annuler purement et simplement. Si un ordre ne peut être ni modifié ni annulé lors d’un incident de plateforme, clôturer manuellement la position est la solution de repli la plus sûre.", image: {"src":`${IMG}/tradovate-order-ticket-6.png`,"alt":"Module Orders de Tradovate listant un ordre actif avec des commandes de modification et d’annulation"} },
      ],
    },
    { type: "table", headers: ["Type d’ordre","Ce qu’il fait","Prix à saisir"], rows: [
      ["Au marché (Market)","S’exécute immédiatement au meilleur prix disponible. Rapide, mais l’exécution peut déraper sur un marché rapide.","Aucun"],
      ["Limité (Limit)","S’exécute uniquement à votre prix ou mieux. Un achat limité se place sous le marché ; une vente limitée, au-dessus.","Votre prix limite"],
      ["Stop","Reste en attente jusqu’à ce que le marché traverse votre prix de déclenchement, puis part comme ordre au marché. Courant pour les stop-loss et les entrées sur cassure.","Votre prix stop (de déclenchement)"],
    ] },
    { type: "heading",text: "Quelques points à retenir" },
    { type: "paragraph",html: "Vérifiez le sélecteur de compte à chaque séance : envoyer sur le mauvais compte est l’erreur classique de l’order ticket. Si un ordre au marché est rejeté, la cause est généralement les limites de risque, la marge ou un accord de données, plutôt que le ticket lui-même. Et si vous passez souvent les mêmes configurations, enregistrez un profil ATM pour que la quantité, le type et les ordres de protection soient à un clic au lieu de cinq champs à remplir à chaque fois." },
    { type: "heading",text: "Automatisez cela avec PickMyTrade" },
    { type: "paragraph",html: "Négocier à la main les mêmes signaux devient vite lassant. <strong class='text-white'>PickMyTrade déclenche automatiquement vos ordres Tradovate directement à partir des alertes TradingView</strong>, de sorte que chaque entrée et chaque sortie s’exécute exactement comme prévu." },
  ], it: [
    { type: "paragraph",html: "L’Order Ticket è il modo più diretto per inviare un ordine al mercato in Tradovate. Niente trascinamenti su un grafico, niente clic su un prezzo della scala: Lei digita esattamente ciò che vuole e lo invia. È un pannello piccolo, ma ogni campo conta: se sbaglia direzione, quantità, tipo di ordine o prezzo, può ritrovarsi in una posizione che non intendeva aprire. Questa guida spiega come inserire un ordine a mercato, limite o stop dal ticket, oltre a cosa controllare prima di premere Invia." },
    { type: "paragraph",html: "Se preferisce fare clic direttamente sui livelli di prezzo, la scala SuperDOM è l’altro modo comune di inserire ordini. L’Order Ticket è la scelta migliore quando conosce il Suo prezzo e vuole digitarlo in modo pulito." },
    {
      type: "steps",
      items: [
        { title: "Aggiunga l’Order Ticket al Suo workspace", html: "Apra il menu <strong class='text-white'>New +</strong> nella parte superiore della piattaforma e trascini il modulo <strong class='text-white'>Order Ticket</strong> sul Suo workspace. Si aggancia come qualsiasi altro pannello, quindi può ridimensionarlo e posizionarlo accanto al grafico o al DOM. Su mobile, l’equivalente è la schermata di inserimento ordini a cui si accede dopo aver selezionato un contratto.", image: {"src":`${IMG}/tradovate-order-ticket-1.png`,"alt":"Menu New Plus di Tradovate aperto con il modulo Order Ticket trascinato sul workspace"} },
        { title: "Scelga il conto e il contratto", html: "Prima di tutto, verifichi a quale conto è collegato il ticket. Se utilizza un conto personale e uno o più conti di valutazione, il ticket opera sul conto selezionato, cosa facile da trascurare quando si va di fretta. Poi faccia clic sul nome dello strumento in alto a sinistra nella scheda del modulo e digiti un simbolo (per esempio <strong class='text-white'>MNQ</strong>, <strong class='text-white'>ES</strong> o <strong class='text-white'>CL</strong>). Un menu a tendina elenca i contratti disponibili; scelga il contratto del mese più vicino, a meno che non voglia operare deliberatamente una scadenza successiva.", image: {"src":`${IMG}/tradovate-order-ticket-2.png`,"alt":"Order Ticket di Tradovate con il selettore del conto e il menu di ricerca dello strumento che mostra un contratto future"} },
        { title: "Imposti direzione e quantità", html: "Scelga <strong class='text-white'>Buy</strong> o <strong class='text-white'>Sell</strong>, poi inserisca la <strong class='text-white'>Quantity</strong>, cioè il numero di contratti. Tenga d’occhio qui i Suoi limiti di rischio. Se opera su un conto finanziato o di valutazione, il numero massimo di contratti che può detenere ha un tetto, e tale tetto varia in base alla società e alla dimensione del conto, quindi verifichi le regole attuali della Sua società prima di aumentare la size. Se lo supera, l’ordine viene rifiutato.", image: {"src":`${IMG}/tradovate-order-ticket-3.png`,"alt":"Order Ticket di Tradovate con i pulsanti Buy e Sell e il campo quantità impostato su un numero di contratti"} },
        { title: "Scelga il tipo di ordine e il prezzo", html: "Apra il selettore del tipo di ordine e scelga come vuole che l’ordine venga eseguito. Tradovate offre anche lo <strong class='text-white'>Stop Limit</strong> (uno stop che diventa un ordine limite anziché a mercato) e altri tipi avanzati, ma mercato, limite e stop coprono la maggior parte degli ingressi e delle uscite quotidiani. Digiti il prezzo con attenzione: un limite o uno stop digitato male è uno dei modi più rapidi per ottenere un’esecuzione indesiderata.", image: {"src":`${IMG}/tradovate-order-ticket-4.png`,"alt":"Menu a tendina del tipo di ordine nell’Order Ticket di Tradovate con Market, Limit e Stop e un campo prezzo"} },
        { title: "Imposti la validità e invii", html: "Scelga una <strong class='text-white'>time-in-force</strong> affinché la piattaforma sappia quanto a lungo l’ordine deve restare attivo: <strong class='text-white'>Day</strong> scade a fine sessione se non è stato eseguito, <strong class='text-white'>GTC</strong> (Good-Til-Canceled) resta attivo tra le sessioni finché non viene eseguito o annullato da Lei, e <strong class='text-white'>GTD</strong> (Good-Til-Date) resta attivo fino a una data da Lei impostata. Un ordine a mercato viene eseguito subito, quindi la time-in-force conta soprattutto per gli ordini limite e stop che possono rimanere nel book. Dia un’ultima lettura all’intero ticket, conto, contratto, Buy/Sell, quantità, tipo, prezzo, poi faccia clic su <strong class='text-white'>Send</strong>. Questa sola abitudine di controllo intercetta gli errori che fanno più male. Vuole che stop-loss e take-profit si colleghino automaticamente quando il Suo ingresso viene eseguito? Passi il ticket da Simple ad Advanced View e costruisca un bracket.", image: {"src":`${IMG}/tradovate-order-ticket-5.png`,"alt":"Order Ticket di Tradovate con la time-in-force impostata su Day e il pulsante Send evidenziato"} },
        { title: "Monitori, modifichi o annulli l’ordine", html: "Dopo l’invio, un ordine a mercato dovrebbe essere eseguito in un istante e comparire come posizione. Un ordine limite o stop resta come ordine attivo nel modulo <strong class='text-white'>Orders</strong>. Da lì può cambiare il prezzo se il mercato Le è sfuggito, regolare la quantità o annullarlo del tutto. Se un ordine non si lascia modificare o annullare durante un problema della piattaforma, chiudere manualmente la posizione è l’alternativa sicura.", image: {"src":`${IMG}/tradovate-order-ticket-6.png`,"alt":"Modulo Orders di Tradovate con un ordine attivo e i controlli per modificare e annullare"} },
      ],
    },
    { type: "table", headers: ["Tipo di ordine","Cosa fa","Prezzo da inserire"], rows: [
      ["A mercato (Market)","Viene eseguito immediatamente al miglior prezzo disponibile. Veloce, ma l’esecuzione può subire slippage in un mercato rapido.","Nessuno"],
      ["Limite (Limit)","Viene eseguito solo al Suo prezzo o migliore. Un limite in acquisto si trova sotto il mercato; uno in vendita, sopra.","Il Suo prezzo limite"],
      ["Stop","Resta in attesa finché il mercato non attraversa il Suo prezzo di attivazione, poi parte come ordine a mercato. Comune per stop-loss e ingressi su breakout.","Il Suo prezzo stop (di attivazione)"],
    ] },
    { type: "heading",text: "Alcune cose da ricordare" },
    { type: "paragraph",html: "Controlli il selettore del conto a ogni sessione: inviare al conto sbagliato è l’errore classico dell’Order Ticket. Se un ordine a mercato viene rifiutato, di solito dipende da limiti di rischio, margine o da un accordo sui dati, non dal ticket in sé. E se inserisce spesso gli stessi setup, salvi un profilo ATM così quantità, tipo e ordini di protezione sono a un clic invece di cinque campi da compilare ogni volta." },
    { type: "heading",text: "Automatizzi tutto questo con PickMyTrade" },
    { type: "paragraph",html: "Operare a mano gli stessi segnali stanca presto. <strong class='text-white'>PickMyTrade invia automaticamente i Suoi ordini Tradovate direttamente dagli alert di TradingView</strong>, così ogni ingresso e ogni uscita viene eseguito esattamente come pianificato." },
  ] },
  ctaHeading: { en: "Stop Typing the Same Ticket Twice", de: "Schluss mit dem doppelten Tippen", es: "Deje de teclear el mismo ticket dos veces", fr: "Cessez de saisir deux fois le même ticket", it: "Smetta di digitare due volte lo stesso ticket" },
  ctaText: { en: "PickMyTrade auto-fires your Tradovate orders straight from TradingView alerts, so every entry and exit goes in exactly as planned.", de: "PickMyTrade löst Ihre Tradovate-Orders direkt aus TradingView-Alerts automatisch aus, sodass jeder Einstieg und Ausstieg genau wie geplant erfolgt.", es: "PickMyTrade lanza automáticamente sus órdenes de Tradovate directamente desde las alertas de TradingView, de modo que cada entrada y salida se ejecuta exactamente como lo planeó.", fr: "PickMyTrade déclenche automatiquement vos ordres Tradovate directement à partir des alertes TradingView, de sorte que chaque entrée et chaque sortie s’exécute exactement comme prévu.", it: "PickMyTrade invia automaticamente i Suoi ordini Tradovate direttamente dagli alert di TradingView, così ogni ingresso e ogni uscita viene eseguito esattamente come pianificato." },
