---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "tradovate-copy-trading";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/how-to/${SLUG}`;

const META_TITLE = "Copy Trades Across Tradovate & Prop Accounts";
const META_DESCRIPTION =
  "Copy trades across multiple Tradovate and prop firm accounts, native Group Trade vs. a third-party copier, sizing, and firm rule checks.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Trades über Tradovate- und Prop-Konten kopieren", es: "Copie operaciones entre cuentas de Tradovate y de prop firms", fr: "Copier vos trades entre comptes Tradovate et comptes de prop firms", it: "Copiare i trade tra conti Tradovate e conti prop" },
  dek: { en: "Running several Tradovate or prop firm accounts and tired of punching the same order into each one? Here's how to fire one trade and land it on all of them at once.", de: "Sie betreiben mehrere Tradovate- oder Prop-Firm-Konten und haben es satt, dieselbe Order in jedes einzeln einzugeben? So senden Sie einen Trade ab und platzieren ihn auf allen Konten gleichzeitig.", es: "¿Gestiona varias cuentas de Tradovate o de prop firms y está harto de introducir la misma orden en cada una? Le explicamos cómo lanzar una operación y que se ejecute en todas a la vez.", fr: "Vous gérez plusieurs comptes Tradovate ou de prop firms et vous en avez assez de saisir le même ordre dans chacun ? Voici comment envoyer un trade et le faire apparaître sur tous les comptes en même temps.", it: "Gestisce più conti Tradovate o di prop firm e Le pesa inserire lo stesso ordine in ciascuno? Ecco come inviare un trade e farlo comparire su tutti i conti contemporaneamente." },
  readTime: { en: "6 min read", de: "6 Min. Lesezeit", es: "Lectura de 6 min", fr: "Lecture : 6 min", it: "Lettura di 6 min" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "Running several Tradovate or prop firm accounts and tired of punching the same order into each one? Here's how to fire one trade and land it on all of them at once." },
    { type: "heading", text: "What Is Tradovate Copy Trading?" },
    { type: "paragraph", html: "Copy trading means one account acts as the source, and every trade you take there, entry, stop, target, exit, gets mirrored onto one or more follower accounts. Tradovate has a native version called Group Trade for accounts under a single login, but it can't reach across separate logins or different prop firms. For that, you route your accounts through a third-party trade copier." },
    { type: "heading", text: "Copy Trading in Tradovate: Step-by-Step" },
    {
      type: "steps",
      items: [
        { title: "Check Your Firm's Rules and Pick Your Method", html: "Before you connect anything, read your prop firm's rules on copy trading. Most firms let you copy between accounts you own but ban copying external signal services, and nearly all forbid cross-account hedging, every account has to sit on the same side of a trade at the same time. How many accounts one trader can run varies by firm and account size, so confirm the current policy. If all your accounts sit under one Tradovate login and one brokerage, the native Group Trade add-on may be enough: turn it on in Application Settings under Add-Ons, log out and back in, then open the account dropdown and use Manage Groups to build your group. But Group Trade can't tie a personal account to a prop account or combine two different firms, that's where a third-party copier comes in." },
        { title: "Turn on API Access in Tradovate", html: "A copier needs permission to read your source account and place orders on the followers. In each Tradovate account, open the settings and enable API Access, then generate an API key and secret. Some copiers use an OAuth sign-in instead, which skips the manual key entirely. Copy those credentials somewhere safe, you'll paste them into the copier next." },
        { title: "Add Your Leader and Follower Accounts", html: "In the copier's dashboard, connect each account using the credentials (or OAuth) from the last step. Mark one account as the leader, the one you actually trade on, and add the rest as followers. Because every account connects with its own token, you can mix different logins and different prop firms in the same group, which native Group Trade can't do." },
        { title: "Set Position Sizing and Per-Account Risk", html: "Your accounts probably aren't the same size, so tell the copier how to scale. Most let you copy at a fixed multiplier, a ratio, or a percentage of the leader's size, a 50K account shouldn't blindly mirror a 150K account contract-for-contract. Add per-account guardrails too: daily loss limits, a max-contract cap, and instrument filters so a follower only takes the products it's cleared for." },
        { title: "Test with One Contract, Then Go Live", html: "Don't trust it blind. Place a single-contract trade on the leader and watch it replicate, check that the entry, stop, and target show up on every follower and that the sizing is right. Expect tiny differences in fill price between accounts; that's normal when orders route separately. Once a test round looks clean, turn on copying and trade the leader as usual." },
      ],
    },
    { type: "heading", text: "Why You'd Need This" },
    {
      type: "list",
      items: [
        "Scale one strategy across several evaluations or funded accounts without retyping orders.",
        "Keep size and risk consistent across accounts of different sizes, all from one screen.",
        "Spread across prop firms so one firm's outage doesn't sink your whole day.",
      ],
    },
    { type: "heading", text: "Automate This with PickMyTrade" },
    { type: "paragraph", html: "If your entries come from a TradingView strategy or indicator, <strong class='text-white'>PickMyTrade pushes those alerts straight to your Tradovate and prop firm accounts</strong>, one signal, every account. Set the sizing per account once and it handles the rest." },
  ], de: [
    { type: "paragraph",html: "Sie betreiben mehrere Tradovate- oder Prop-Firm-Konten und haben es satt, dieselbe Order in jedes einzeln einzugeben? So senden Sie einen Trade ab und platzieren ihn auf allen Konten gleichzeitig." },
    { type: "heading",text: "Was ist Copy Trading bei Tradovate?" },
    { type: "paragraph",html: "Beim Copy Trading fungiert ein Konto als Quelle, und jeder Trade, den Sie dort ausführen, also Einstieg, Stopp, Ziel und Ausstieg, wird auf ein oder mehrere Follower-Konten gespiegelt. Tradovate hat dafür eine native Lösung namens Group Trade für Konten unter einem einzigen Login, die jedoch nicht über getrennte Logins oder verschiedene Prop-Firmen hinweg funktioniert. Dafür leiten Sie Ihre Konten über einen Trade Copier eines Drittanbieters." },
    { type: "heading",text: "Copy Trading in Tradovate: Schritt für Schritt" },
    {
      type: "steps",
      items: [
        { title: "Regeln Ihrer Firma prüfen und Methode wählen", html: "Lesen Sie, bevor Sie etwas verbinden, die Regeln Ihrer Prop-Firma zum Copy Trading. Die meisten Firmen erlauben das Kopieren zwischen Konten, die Ihnen gehören, verbieten aber das Kopieren externer Signaldienste, und nahezu alle untersagen kontenübergreifendes Hedging: Alle Konten müssen gleichzeitig auf derselben Seite eines Trades stehen. Wie viele Konten ein Trader betreiben darf, variiert je nach Firma und Kontogröße, prüfen Sie daher die aktuelle Richtlinie. Liegen alle Ihre Konten unter einem Tradovate-Login und einem Broker, kann das native Add-on Group Trade ausreichen: Aktivieren Sie es in Application Settings unter Add-Ons, melden Sie sich ab und wieder an, öffnen Sie dann das Konto-Dropdown und erstellen Sie Ihre Gruppe mit Manage Groups. Group Trade kann jedoch kein privates Konto mit einem Prop-Konto verbinden oder zwei verschiedene Firmen kombinieren, hier kommt ein Trade Copier eines Drittanbieters ins Spiel." },
        { title: "API-Zugriff in Tradovate aktivieren", html: "Ein Copier braucht die Berechtigung, Ihr Quellkonto zu lesen und Orders auf den Follower-Konten zu platzieren. Öffnen Sie in jedem Tradovate-Konto die Einstellungen, aktivieren Sie API Access und erzeugen Sie dann einen API-Key samt Secret. Manche Copier nutzen stattdessen eine OAuth-Anmeldung, die den manuellen Key ganz überflüssig macht. Speichern Sie diese Zugangsdaten an einem sicheren Ort, denn Sie fügen sie als Nächstes in den Copier ein." },
        { title: "Leader- und Follower-Konten hinzufügen", html: "Verbinden Sie im Dashboard des Copiers jedes Konto mit den Zugangsdaten (oder per OAuth) aus dem vorherigen Schritt. Markieren Sie ein Konto als Leader, also das Konto, auf dem Sie tatsächlich handeln, und fügen Sie die übrigen als Follower hinzu. Da jedes Konto mit einem eigenen Token verbunden ist, können Sie in derselben Gruppe verschiedene Logins und verschiedene Prop-Firmen mischen, was mit dem nativen Group Trade nicht möglich ist." },
        { title: "Positionsgröße und Risiko pro Konto festlegen", html: "Ihre Konten sind vermutlich nicht gleich groß, also teilen Sie dem Copier mit, wie er skalieren soll. Die meisten erlauben das Kopieren mit einem festen Multiplikator, einem Verhältnis oder einem Prozentsatz der Größe des Leaders: Ein 50K-Konto sollte ein 150K-Konto nicht blind Kontrakt für Kontrakt spiegeln. Ergänzen Sie außerdem Schutzmechanismen pro Konto: tägliche Verlustlimits, eine Obergrenze für die maximale Kontraktzahl und Instrumentfilter, damit ein Follower nur die Produkte handelt, für die er freigegeben ist." },
        { title: "Mit einem Kontrakt testen, dann live gehen", html: "Vertrauen Sie dem Ganzen nicht blind. Platzieren Sie einen Trade mit einem einzelnen Kontrakt auf dem Leader und beobachten Sie, wie er repliziert wird. Prüfen Sie, ob Einstieg, Stopp und Ziel auf jedem Follower erscheinen und die Größe stimmt. Rechnen Sie mit winzigen Unterschieden beim Fill-Preis zwischen den Konten; das ist normal, wenn Orders separat geroutet werden. Sobald ein Testdurchlauf sauber aussieht, aktivieren Sie das Kopieren und handeln den Leader wie gewohnt." },
      ],
    },
    { type: "heading",text: "Wofür Sie das brauchen" },
    {
      type: "list",
      items: [
        "Skalieren Sie eine Strategie über mehrere Evaluierungs- oder Funded-Konten, ohne Orders neu einzutippen.",
        "Halten Sie Größe und Risiko über Konten unterschiedlicher Größe konsistent, alles von einem Bildschirm aus.",
        "Verteilen Sie sich auf mehrere Prop-Firmen, damit der Ausfall einer Firma nicht Ihren ganzen Tag ruiniert.",
      ],
    },
    { type: "heading",text: "Automatisieren mit PickMyTrade" },
    { type: "paragraph",html: "Wenn Ihre Einstiege aus einer TradingView-Strategie oder einem Indikator stammen, <strong class='text-white'>leitet PickMyTrade diese Alerts direkt an Ihre Tradovate- und Prop-Firm-Konten weiter</strong>: ein Signal, jedes Konto. Legen Sie die Positionsgröße pro Konto einmal fest, den Rest erledigt PickMyTrade." },
  ], es: [
    { type: "paragraph",html: "¿Gestiona varias cuentas de Tradovate o de prop firms y está harto de introducir la misma orden en cada una? Le explicamos cómo lanzar una operación y que se ejecute en todas a la vez." },
    { type: "heading",text: "¿Qué es el copy trading en Tradovate?" },
    { type: "paragraph",html: "El copy trading significa que una cuenta actúa como origen y cada operación que realiza allí, entrada, stop, objetivo y salida, se replica en una o más cuentas seguidoras. Tradovate tiene una versión nativa llamada Group Trade para cuentas bajo un único inicio de sesión, pero no puede abarcar inicios de sesión separados ni distintas prop firms. Para eso, debe enrutar sus cuentas a través de un copiador de operaciones de terceros." },
    { type: "heading",text: "Copy trading en Tradovate: paso a paso" },
    {
      type: "steps",
      items: [
        { title: "Revise las reglas de su firma y elija el método", html: "Antes de conectar nada, lea las reglas de su prop firm sobre el copy trading. La mayoría de las firmas permiten copiar entre cuentas de su propiedad, pero prohíben copiar servicios de señales externos, y casi todas prohíben la cobertura entre cuentas: todas las cuentas deben estar en el mismo lado de una operación al mismo tiempo. El número de cuentas que un trader puede gestionar varía según la firma y el tamaño de la cuenta, así que confirme la política vigente. Si todas sus cuentas están bajo un mismo inicio de sesión de Tradovate y un mismo bróker, puede bastar el complemento nativo Group Trade: actívelo en Application Settings, en Add-Ons, cierre sesión y vuelva a iniciarla, y abra después el menú desplegable de cuentas y use Manage Groups para crear su grupo. Pero Group Trade no puede vincular una cuenta personal con una cuenta de prop firm ni combinar dos firmas distintas; ahí es donde entra un copiador de terceros." },
        { title: "Active el acceso a la API en Tradovate", html: "Un copiador necesita permiso para leer su cuenta de origen y colocar órdenes en las seguidoras. En cada cuenta de Tradovate, abra los ajustes y active API Access; después genere una clave y un secreto de API. Algunos copiadores usan en su lugar un inicio de sesión con OAuth, que evita por completo la clave manual. Guarde esas credenciales en un lugar seguro, porque las pegará a continuación en el copiador." },
        { title: "Añada sus cuentas líder y seguidoras", html: "En el panel del copiador, conecte cada cuenta con las credenciales (u OAuth) del paso anterior. Marque una cuenta como líder, aquella en la que realmente opera, y añada las demás como seguidoras. Como cada cuenta se conecta con su propio token, puede combinar distintos inicios de sesión y distintas prop firms en el mismo grupo, algo que Group Trade nativo no puede hacer." },
        { title: "Configure el tamaño de posición y el riesgo por cuenta", html: "Es probable que sus cuentas no tengan el mismo tamaño, así que indique al copiador cómo escalar. La mayoría permite copiar con un multiplicador fijo, una proporción o un porcentaje del tamaño del líder: una cuenta de 50K no debería replicar a ciegas una cuenta de 150K contrato por contrato. Añada también salvaguardas por cuenta: límites de pérdida diaria, un tope máximo de contratos y filtros de instrumentos para que una seguidora opere solo los productos para los que está autorizada." },
        { title: "Pruebe con un contrato y después pase a real", html: "No confíe a ciegas. Realice una operación de un solo contrato en la cuenta líder y observe cómo se replica; compruebe que la entrada, el stop y el objetivo aparecen en cada seguidora y que el tamaño es correcto. Espere diferencias mínimas en el precio de ejecución entre cuentas; es normal cuando las órdenes se enrutan por separado. Cuando una ronda de prueba salga limpia, active la copia y opere la cuenta líder como de costumbre." },
      ],
    },
    { type: "heading",text: "Por qué lo necesitaría" },
    {
      type: "list",
      items: [
        "Escale una estrategia en varias evaluaciones o cuentas financiadas sin volver a teclear las órdenes.",
        "Mantenga un tamaño y un riesgo coherentes en cuentas de distintos tamaños, todo desde una sola pantalla.",
        "Repártase entre varias prop firms para que la caída de una no arruine toda su jornada.",
      ],
    },
    { type: "heading",text: "Automatice esto con PickMyTrade" },
    { type: "paragraph",html: "Si sus entradas proceden de una estrategia o un indicador de TradingView, <strong class='text-white'>PickMyTrade envía esas alertas directamente a sus cuentas de Tradovate y de prop firms</strong>: una señal, todas las cuentas. Configure el tamaño por cuenta una sola vez y él se encarga del resto." },
  ], fr: [
    { type: "paragraph",html: "Vous gérez plusieurs comptes Tradovate ou de prop firms et vous en avez assez de saisir le même ordre dans chacun ? Voici comment envoyer un trade et le faire apparaître sur tous les comptes en même temps." },
    { type: "heading",text: "Qu'est-ce que le copy trading sur Tradovate ?" },
    { type: "paragraph",html: "Le copy trading signifie qu'un compte joue le rôle de source et que chaque trade pris sur ce compte, entrée, stop, objectif, sortie, est reproduit sur un ou plusieurs comptes suiveurs. Tradovate propose une version native appelée Group Trade pour les comptes rattachés à un seul identifiant de connexion, mais elle ne peut pas couvrir des identifiants distincts ni des prop firms différentes. Pour cela, vous acheminez vos comptes via un copieur de trades tiers." },
    { type: "heading",text: "Copy trading sur Tradovate : étape par étape" },
    {
      type: "steps",
      items: [
        { title: "Vérifiez les règles de votre firme et choisissez votre méthode", html: "Avant de connecter quoi que ce soit, lisez les règles de votre prop firm sur le copy trading. La plupart des firmes autorisent la copie entre des comptes qui vous appartiennent, mais interdisent de copier des services de signaux externes, et presque toutes interdisent le hedging entre comptes : tous les comptes doivent être du même côté d'un trade au même moment. Le nombre de comptes qu'un trader peut gérer varie selon la firme et la taille du compte ; confirmez donc la politique en vigueur. Si tous vos comptes dépendent d'un même identifiant Tradovate et d'un même courtier, le module natif Group Trade peut suffire : activez-le dans Application Settings sous Add-Ons, déconnectez-vous puis reconnectez-vous, ouvrez ensuite le menu déroulant des comptes et utilisez Manage Groups pour créer votre groupe. Mais Group Trade ne peut pas relier un compte personnel à un compte de prop firm ni combiner deux firmes différentes ; c'est là qu'intervient un copieur tiers." },
        { title: "Activez l'accès API dans Tradovate", html: "Un copieur a besoin de l'autorisation de lire votre compte source et de passer des ordres sur les comptes suiveurs. Dans chaque compte Tradovate, ouvrez les paramètres et activez API Access, puis générez une clé API et un secret. Certains copieurs utilisent à la place une connexion OAuth, qui évite entièrement la clé manuelle. Conservez ces identifiants en lieu sûr : vous allez les coller dans le copieur à l'étape suivante." },
        { title: "Ajoutez vos comptes leader et suiveurs", html: "Dans le tableau de bord du copieur, connectez chaque compte à l'aide des identifiants (ou d'OAuth) de l'étape précédente. Désignez un compte comme leader, celui sur lequel vous tradez réellement, et ajoutez les autres comme suiveurs. Comme chaque compte se connecte avec son propre jeton, vous pouvez mélanger différents identifiants et différentes prop firms dans le même groupe, ce que le Group Trade natif ne permet pas." },
        { title: "Définissez la taille de position et le risque par compte", html: "Vos comptes n'ont probablement pas tous la même taille ; indiquez donc au copieur comment adapter l'échelle. La plupart permettent de copier avec un multiplicateur fixe, un ratio ou un pourcentage de la taille du leader : un compte de 50K ne devrait pas reproduire aveuglément un compte de 150K contrat pour contrat. Ajoutez aussi des garde-fous par compte : limites de perte quotidienne, plafond maximal de contrats et filtres d'instruments afin qu'un suiveur ne prenne que les produits pour lesquels il est autorisé." },
        { title: "Testez avec un contrat, puis passez en réel", html: "Ne lui faites pas une confiance aveugle. Passez un trade d'un seul contrat sur le leader et observez sa réplication ; vérifiez que l'entrée, le stop et l'objectif apparaissent sur chaque suiveur et que la taille est correcte. Attendez-vous à de minimes écarts de prix d'exécution entre les comptes ; c'est normal lorsque les ordres sont acheminés séparément. Une fois qu'un test s'avère propre, activez la copie et tradez le leader comme d'habitude." },
      ],
    },
    { type: "heading",text: "Pourquoi en avoir besoin" },
    {
      type: "list",
      items: [
        "Déployez une même stratégie sur plusieurs évaluations ou comptes financés sans ressaisir les ordres.",
        "Gardez une taille et un risque cohérents sur des comptes de tailles différentes, depuis un seul écran.",
        "Répartissez-vous entre plusieurs prop firms pour qu'une panne chez l'une d'elles ne ruine pas toute votre journée.",
      ],
    },
    { type: "heading",text: "Automatisez avec PickMyTrade" },
    { type: "paragraph",html: "Si vos entrées proviennent d'une stratégie ou d'un indicateur TradingView, <strong class='text-white'>PickMyTrade envoie ces alertes directement vers vos comptes Tradovate et de prop firms</strong> : un signal, tous les comptes. Réglez une fois la taille par compte, et il s'occupe du reste." },
  ], it: [
    { type: "paragraph",html: "Gestisce più conti Tradovate o di prop firm e Le pesa inserire lo stesso ordine in ciascuno? Ecco come inviare un trade e farlo comparire su tutti i conti contemporaneamente." },
    { type: "heading",text: "Che cos'è il copy trading su Tradovate?" },
    { type: "paragraph",html: "Copy trading significa che un conto funge da sorgente e ogni trade che esegue lì, entrata, stop, target, uscita, viene replicato su uno o più conti follower. Tradovate ha una versione nativa chiamata Group Trade per i conti sotto un unico login, ma non può operare tra login separati o tra prop firm diverse. Per questo, instrada i Suoi conti attraverso un copiatore di trade di terze parti." },
    { type: "heading",text: "Copy trading su Tradovate: passo dopo passo" },
    {
      type: "steps",
      items: [
        { title: "Controlli le regole della Sua firma e scelga il metodo", html: "Prima di collegare qualsiasi cosa, legga le regole della Sua prop firm sul copy trading. La maggior parte delle firme consente di copiare tra conti di Sua proprietà ma vieta di copiare servizi di segnali esterni, e quasi tutte vietano l'hedging tra conti: tutti i conti devono trovarsi dallo stesso lato di un trade nello stesso momento. Quanti conti può gestire un trader varia in base alla firma e alla dimensione del conto, quindi confermi la politica attuale. Se tutti i Suoi conti sono sotto un solo login Tradovate e un solo broker, l'add-on nativo Group Trade potrebbe bastare: lo attivi in Application Settings sotto Add-Ons, esca e rientri, poi apra il menu a tendina dei conti e usi Manage Groups per creare il Suo gruppo. Ma Group Trade non può collegare un conto personale a un conto prop né combinare due firme diverse: è qui che entra in gioco un copiatore di terze parti." },
        { title: "Attivi l'accesso API in Tradovate", html: "Un copiatore ha bisogno dell'autorizzazione per leggere il Suo conto sorgente e inserire ordini sui follower. In ogni conto Tradovate apra le impostazioni, attivi API Access e generi una chiave e un secret API. Alcuni copiatori usano invece un accesso OAuth, che evita del tutto la chiave manuale. Conservi queste credenziali in un luogo sicuro: le incollerà subito dopo nel copiatore." },
        { title: "Aggiunga i conti leader e follower", html: "Nella dashboard del copiatore, colleghi ogni conto con le credenziali (o con OAuth) del passo precedente. Contrassegni un conto come leader, quello su cui opera effettivamente, e aggiunga gli altri come follower. Poiché ogni conto si collega con un proprio token, può mescolare login diversi e prop firm diverse nello stesso gruppo, cosa che il Group Trade nativo non consente." },
        { title: "Imposti dimensione della posizione e rischio per conto", html: "È probabile che i Suoi conti non abbiano la stessa dimensione, quindi indichi al copiatore come scalare. La maggior parte consente di copiare con un moltiplicatore fisso, un rapporto o una percentuale della dimensione del leader: un conto da 50K non dovrebbe replicare alla cieca un conto da 150K contratto per contratto. Aggiunga anche protezioni per singolo conto: limiti di perdita giornaliera, un tetto massimo di contratti e filtri sugli strumenti, così che un follower operi solo i prodotti per cui è abilitato." },
        { title: "Provi con un contratto, poi passi al live", html: "Non si fidi alla cieca. Esegua un trade da un solo contratto sul leader e osservi come viene replicato: verifichi che entrata, stop e target compaiano su ogni follower e che la dimensione sia corretta. Si aspetti minime differenze nel prezzo di fill tra i conti; è normale quando gli ordini vengono instradati separatamente. Quando un giro di prova risulta pulito, attivi la copia e operi sul leader come di consueto." },
      ],
    },
    { type: "heading",text: "Perché Le servirebbe" },
    {
      type: "list",
      items: [
        "Scali una strategia su più valutazioni o conti finanziati senza reinserire gli ordini.",
        "Mantenga dimensione e rischio coerenti su conti di dimensioni diverse, tutto da una sola schermata.",
        "Si distribuisca tra più prop firm, così che il disservizio di una non comprometta l'intera giornata.",
      ],
    },
    { type: "heading",text: "Automatizzi tutto con PickMyTrade" },
    { type: "paragraph",html: "Se le Sue entrate provengono da una strategia o da un indicatore di TradingView, <strong class='text-white'>PickMyTrade invia questi alert direttamente ai Suoi conti Tradovate e di prop firm</strong>: un segnale, tutti i conti. Imposti una volta sola la dimensione per conto e al resto pensa PickMyTrade." },
  ] },
