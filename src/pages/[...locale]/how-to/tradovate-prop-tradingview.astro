---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "tradovate-prop-tradingview";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/how-to/${SLUG}`;

const META_TITLE = "Connect a Prop Tradovate Account to TradingView";
const META_DESCRIPTION =
  "Connect a prop or evaluation Tradovate account to TradingView without buying the add-on, activate it free, pick the Demo tab, and place your first order.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Ein Prop-Tradovate-Konto mit TradingView verbinden", es: "Conectar una cuenta prop de Tradovate a TradingView", fr: "Connecter un compte Tradovate prop à TradingView", it: "Collegare un conto prop Tradovate a TradingView" },
  dek: { en: "If you're trading a prop firm or evaluation account that runs on Tradovate, you almost certainly do not need to pay for the standalone TradingView add-on. Here's the exact path.", de: "Wenn Sie ein Prop-Firm- oder Evaluierungskonto handeln, das auf Tradovate läuft, brauchen Sie mit ziemlicher Sicherheit nicht das eigenständige TradingView-Add-on zu bezahlen. Hier ist der genaue Weg.", es: "Si opera una cuenta de prop firm o de evaluación que funciona sobre Tradovate, casi con seguridad no necesita pagar el complemento independiente de TradingView. Este es el camino exacto.", fr: "Si vous tradez un compte de prop firm ou d'évaluation qui fonctionne sur Tradovate, vous n'avez presque certainement pas besoin de payer le module complémentaire TradingView autonome. Voici le chemin exact.", it: "Se opera su un conto di prop firm o di valutazione che gira su Tradovate, quasi certamente non ha bisogno di pagare il componente aggiuntivo TradingView autonomo. Ecco il percorso esatto." },
  readTime: { en: "6 min read", de: "6 Min. Lesezeit", es: "Lectura de 6 min", fr: "Lecture : 6 min", it: "Lettura di 6 min" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "Here's the short version: if you're trading a prop firm or evaluation account that runs on Tradovate, you almost certainly do <strong class='text-white'>not</strong> need to pay for the standalone TradingView add-on. That paid add-on exists for direct retail brokerage accounts. Prop and evaluation accounts get TradingView access as part of the firm's Tradovate integration, so you activate it for free and connect through the Demo tab. The whole thing takes about five minutes." },
    { type: "paragraph", html: "Below is the exact path. The one detail that trips people up sits in Step 4, so read that one twice." },
    { type: "heading", text: "Before You Start" },
    { type: "paragraph", html: "You'll need three things: your prop firm dashboard login, your Tradovate account credentials (many firms hand you a username that starts with <code>TRAD</code> followed by numbers), and a free TradingView account. If your firm hasn't switched TradingView on for your account yet, a quick message to their support gets it enabled, that's faster than fighting an entitlement error later." },
    { type: "heading", text: "Connect a Prop Tradovate Account to TradingView: Step-by-Step" },
    {
      type: "steps",
      items: [
        { title: "Confirm Your Firm Includes TradingView", html: "Don't reach for your credit card. The standalone TradingView add-on that Tradovate sells (a small recurring monthly fee, check the current price on Tradovate's pricing page) is for people trading their own funded brokerage account. Evaluation and funded-sim accounts from a prop firm already carry TradingView entitlement through the firm. Log in to your prop firm dashboard and confirm TradingView is listed as available on your plan, or ask their support to enable it." },
        { title: "Activate the Free Add-On Inside Tradovate", html: "Open the Tradovate Web Trader and sign in with your prop firm credentials. Click the settings icon in the top-right and open <strong class='text-white'>Application Settings</strong>, then select the <strong class='text-white'>Add-ons</strong> tab. Find TradingView in the list and click <strong class='text-white'>Activate</strong>. It's free on a prop account, though the activation renews monthly, so if TradingView suddenly stops connecting weeks later, this is the first place to check." },
        { title: "Open the Trading Panel in TradingView", html: "Head to TradingView and log in. Open any futures chart, the E-mini S&amp;P (ES) or Nasdaq (NQ) is a good test symbol, then open the trading panel that runs along the bottom of the chart. You'll see a row of supported brokers. This is where the connection starts." },
        { title: "Pick Tradovate, Then Choose the Demo Tab", html: "Select <strong class='text-white'>Tradovate</strong> from the broker list. Now the part everyone gets wrong: choose the <strong class='text-white'>Demo</strong> tab, not Live. Prop evaluation accounts and funded-sim accounts both run inside Tradovate's simulation environment, even though your payouts are real. If you pick Live, the login either fails or connects you to nothing. Demo is correct for the vast majority of prop setups, but firms differ, so if Demo doesn't take your login, check your firm's own instructions before assuming something's broken." },
        { title: "Enter Your Credentials and Connect", html: "Type in the Tradovate username and password from your prop firm dashboard and click <strong class='text-white'>Connect</strong>. You may get bounced to a Tradovate sign-in page to confirm, that's normal. Once you're in, TradingView shows your evaluation account and its balance. Pick the right account from the dropdown if your firm gave you more than one, and you're live on the charts." },
      ],
    },
    { type: "heading", text: "If the Connection Won't Take" },
    { type: "paragraph", html: "A few snags show up again and again:" },
    {
      type: "table",
      headers: ["What you see", "What to do"],
      rows: [
        ["\"TradingView has not been entitled to access your account\"", "The add-on isn't active. Re-run Step 2, or ask your firm to enable TradingView on your account."],
        ["Login fails only on the Live tab", "Switch to the Demo tab. Prop and eval accounts almost never use Live."],
        ["\"Non-tradable symbol\" when you try to trade", "You're on a delayed feed or a rolled-off contract. Add market data and use the front-month symbol."],
        ["Charts freeze or you get disconnected", "You may be over the session limit. Log out of the Tradovate web, desktop, and mobile apps so TradingView holds the only session."],
      ],
    },
    { type: "heading", text: "Automate This with PickMyTrade" },
    { type: "paragraph", html: "Want your TradingView alerts to fire trades on your prop Tradovate account automatically, no API fee, no CME license, no watching the screen? <strong class='text-white'>PickMyTrade automates your Tradovate execution</strong>." },
    { type: "paragraph", html: "That's it. Activate the free add-on, connect on Demo, and your prop account trades straight from the TradingView chart, no add-on purchase required." },
  ], de: [
    { type: "paragraph",html: "Hier die Kurzfassung: Wenn Sie ein Prop-Firm- oder Evaluierungskonto handeln, das auf Tradovate läuft, müssen Sie mit ziemlicher Sicherheit <strong class='text-white'>nicht</strong> für das eigenständige TradingView-Add-on bezahlen. Dieses kostenpflichtige Add-on gibt es für direkte Retail-Brokerage-Konten. Prop- und Evaluierungskonten erhalten den TradingView-Zugang als Teil der Tradovate-Integration der Firma, sodass Sie ihn kostenlos aktivieren und über den Demo-Tab verbinden. Das Ganze dauert etwa fünf Minuten." },
    { type: "paragraph",html: "Unten finden Sie den genauen Weg. Das eine Detail, an dem viele scheitern, steckt in Schritt 4, lesen Sie ihn also zweimal." },
    { type: "heading",text: "Bevor Sie beginnen" },
    { type: "paragraph",html: "Sie benötigen drei Dinge: Ihren Login für das Dashboard der Prop Firm, Ihre Tradovate-Zugangsdaten (viele Firmen vergeben einen Benutzernamen, der mit <code>TRAD</code> gefolgt von Ziffern beginnt) und ein kostenloses TradingView-Konto. Falls Ihre Firma TradingView für Ihr Konto noch nicht freigeschaltet hat, genügt eine kurze Nachricht an deren Support, damit es aktiviert wird. Das geht schneller, als sich später mit einem Berechtigungsfehler herumzuschlagen." },
    { type: "heading",text: "Ein Prop-Tradovate-Konto mit TradingView verbinden: Schritt für Schritt" },
    {
      type: "steps",
      items: [
        { title: "Prüfen, ob Ihre Firma TradingView enthält", html: "Zücken Sie nicht gleich die Kreditkarte. Das eigenständige TradingView-Add-on, das Tradovate verkauft (eine kleine wiederkehrende Monatsgebühr, den aktuellen Preis finden Sie auf der Preisseite von Tradovate), ist für Personen gedacht, die ihr eigenes finanziertes Brokerage-Konto handeln. Evaluierungs- und finanzierte Sim-Konten einer Prop Firm tragen die TradingView-Berechtigung bereits über die Firma. Melden Sie sich im Dashboard Ihrer Prop Firm an und prüfen Sie, ob TradingView in Ihrem Plan als verfügbar aufgeführt ist, oder bitten Sie den Support, es zu aktivieren." },
        { title: "Das kostenlose Add-on in Tradovate aktivieren", html: "Öffnen Sie den Tradovate Web Trader und melden Sie sich mit den Zugangsdaten Ihrer Prop Firm an. Klicken Sie oben rechts auf das Einstellungssymbol, öffnen Sie <strong class='text-white'>Application Settings</strong> und wählen Sie dann den Tab <strong class='text-white'>Add-ons</strong>. Suchen Sie TradingView in der Liste und klicken Sie auf <strong class='text-white'>Activate</strong>. Auf einem Prop-Konto ist es kostenlos, die Aktivierung wird jedoch monatlich erneuert. Wenn TradingView Wochen später plötzlich keine Verbindung mehr herstellt, ist dies die erste Stelle zum Nachsehen." },
        { title: "Das Trading-Panel in TradingView öffnen", html: "Rufen Sie TradingView auf und melden Sie sich an. Öffnen Sie einen beliebigen Futures-Chart, der E-mini S&amp;P (ES) oder Nasdaq (NQ) eignet sich gut als Testsymbol, und öffnen Sie dann das Trading-Panel am unteren Rand des Charts. Dort sehen Sie eine Reihe unterstützter Broker. Hier beginnt die Verbindung." },
        { title: "Tradovate auswählen, dann den Demo-Tab wählen", html: "Wählen Sie <strong class='text-white'>Tradovate</strong> aus der Broker-Liste. Nun kommt der Teil, den alle falsch machen: Wählen Sie den Tab <strong class='text-white'>Demo</strong>, nicht Live. Prop-Evaluierungskonten und finanzierte Sim-Konten laufen beide in der Simulationsumgebung von Tradovate, auch wenn Ihre Auszahlungen real sind. Wenn Sie Live wählen, schlägt die Anmeldung entweder fehl oder verbindet Sie mit nichts. Demo ist bei der überwiegenden Mehrheit der Prop-Setups richtig, doch Firmen unterscheiden sich. Wenn Demo Ihre Anmeldung nicht annimmt, prüfen Sie daher die Anleitung Ihrer Firma, bevor Sie annehmen, dass etwas defekt ist." },
        { title: "Zugangsdaten eingeben und verbinden", html: "Geben Sie den Tradovate-Benutzernamen und das Passwort aus dem Dashboard Ihrer Prop Firm ein und klicken Sie auf <strong class='text-white'>Connect</strong>. Möglicherweise werden Sie zur Bestätigung auf eine Tradovate-Anmeldeseite weitergeleitet, das ist normal. Sobald Sie angemeldet sind, zeigt TradingView Ihr Evaluierungskonto und dessen Kontostand an. Wählen Sie im Dropdown das richtige Konto aus, falls Ihre Firma Ihnen mehrere gegeben hat, und schon sind Sie live auf den Charts." },
      ],
    },
    { type: "heading",text: "Wenn die Verbindung nicht zustande kommt" },
    { type: "paragraph",html: "Ein paar Probleme tauchen immer wieder auf:" },
    { type: "table", headers: ["Was Sie sehen","Was zu tun ist"], rows: [
      ["Meldung „TradingView has not been entitled to access your account“","Das Add-on ist nicht aktiv. Wiederholen Sie Schritt 2 oder bitten Sie Ihre Firma, TradingView für Ihr Konto freizuschalten."],
      ["Die Anmeldung schlägt nur im Live-Tab fehl","Wechseln Sie zum Demo-Tab. Prop- und Evaluierungskonten nutzen Live fast nie."],
      ["Meldung „Non-tradable symbol“, wenn Sie handeln möchten","Sie befinden sich auf einem verzögerten Feed oder einem ausgelaufenen Kontrakt. Fügen Sie Marktdaten hinzu und verwenden Sie das Frontmonat-Symbol."],
      ["Charts frieren ein oder die Verbindung bricht ab","Möglicherweise haben Sie das Sitzungslimit überschritten. Melden Sie sich in der Tradovate-Web-, Desktop- und Mobile-App ab, damit TradingView die einzige Sitzung hält."],
    ] },
    { type: "heading",text: "Mit PickMyTrade automatisieren" },
    { type: "paragraph",html: "Möchten Sie, dass Ihre TradingView-Alerts Trades auf Ihrem Prop-Tradovate-Konto automatisch auslösen, ohne API-Gebühr, ohne CME-Lizenz und ohne den Bildschirm zu beobachten? <strong class='text-white'>PickMyTrade automatisiert Ihre Tradovate-Ausführung</strong>." },
    { type: "paragraph",html: "Das war's. Aktivieren Sie das kostenlose Add-on, verbinden Sie sich über Demo, und Ihr Prop-Konto handelt direkt aus dem TradingView-Chart, ohne dass Sie ein Add-on kaufen müssen." },
  ], es: [
    { type: "paragraph",html: "La versión corta: si opera una cuenta de prop firm o de evaluación que funciona sobre Tradovate, casi con seguridad <strong class='text-white'>no</strong> necesita pagar el complemento independiente de TradingView. Ese complemento de pago existe para las cuentas de brokerage minorista directas. Las cuentas prop y de evaluación obtienen acceso a TradingView como parte de la integración de Tradovate de la firma, así que lo activa gratis y se conecta a través de la pestaña Demo. Todo el proceso lleva unos cinco minutos." },
    { type: "paragraph",html: "A continuación está el camino exacto. El detalle que más tropieza a la gente está en el paso 4, así que léalo dos veces." },
    { type: "heading",text: "Antes de empezar" },
    { type: "paragraph",html: "Necesitará tres cosas: su acceso al panel de la prop firm, sus credenciales de Tradovate (muchas firmas entregan un nombre de usuario que empieza por <code>TRAD</code> seguido de números) y una cuenta gratuita de TradingView. Si su firma aún no ha activado TradingView en su cuenta, un breve mensaje a su soporte lo habilita; es más rápido que pelear después con un error de autorización." },
    { type: "heading",text: "Conectar una cuenta prop de Tradovate a TradingView: paso a paso" },
    {
      type: "steps",
      items: [
        { title: "Confirme que su firma incluye TradingView", html: "No saque la tarjeta de crédito. El complemento independiente de TradingView que vende Tradovate (una pequeña cuota mensual recurrente; consulte el precio actual en la página de precios de Tradovate) es para quienes operan su propia cuenta de brokerage fondeada. Las cuentas de evaluación y las cuentas sim fondeadas de una prop firm ya cuentan con la autorización de TradingView a través de la firma. Inicie sesión en el panel de su prop firm y confirme que TradingView figura como disponible en su plan, o pida a su soporte que lo active." },
        { title: "Active el complemento gratuito dentro de Tradovate", html: "Abra Tradovate Web Trader e inicie sesión con las credenciales de su prop firm. Haga clic en el icono de ajustes de la esquina superior derecha, abra <strong class='text-white'>Application Settings</strong> y seleccione la pestaña <strong class='text-white'>Add-ons</strong>. Busque TradingView en la lista y haga clic en <strong class='text-white'>Activate</strong>. Es gratis en una cuenta prop, aunque la activación se renueva cada mes, así que si TradingView deja de conectarse de repente semanas después, este es el primer lugar donde mirar." },
        { title: "Abra el panel de trading en TradingView", html: "Vaya a TradingView e inicie sesión. Abra cualquier gráfico de futuros, el E-mini S&amp;P (ES) o el Nasdaq (NQ) sirven bien como símbolo de prueba, y luego abra el panel de trading que recorre la parte inferior del gráfico. Verá una fila de brokers compatibles. Aquí es donde empieza la conexión." },
        { title: "Elija Tradovate y luego la pestaña Demo", html: "Seleccione <strong class='text-white'>Tradovate</strong> en la lista de brokers. Ahora viene la parte que todos hacen mal: elija la pestaña <strong class='text-white'>Demo</strong>, no Live. Las cuentas prop de evaluación y las cuentas sim fondeadas funcionan ambas dentro del entorno de simulación de Tradovate, aunque sus pagos sean reales. Si elige Live, el inicio de sesión falla o le conecta a nada. Demo es lo correcto en la gran mayoría de configuraciones prop, pero las firmas difieren; si Demo no acepta su inicio de sesión, consulte las instrucciones de su propia firma antes de suponer que algo está roto." },
        { title: "Introduzca sus credenciales y conecte", html: "Escriba el nombre de usuario y la contraseña de Tradovate del panel de su prop firm y haga clic en <strong class='text-white'>Connect</strong>. Puede que le redirijan a una página de inicio de sesión de Tradovate para confirmar; es normal. Una vez dentro, TradingView muestra su cuenta de evaluación y su saldo. Elija la cuenta correcta en el desplegable si su firma le dio más de una, y ya está en vivo en los gráficos." },
      ],
    },
    { type: "heading",text: "Si la conexión no se establece" },
    { type: "paragraph",html: "Unos cuantos tropiezos aparecen una y otra vez:" },
    { type: "table", headers: ["Lo que ve","Qué hacer"], rows: [
      ["Mensaje «TradingView has not been entitled to access your account»","El complemento no está activo. Repita el paso 2 o pida a su firma que habilite TradingView en su cuenta."],
      ["El inicio de sesión falla solo en la pestaña Live","Cambie a la pestaña Demo. Las cuentas prop y de evaluación casi nunca usan Live."],
      ["Mensaje «Non-tradable symbol» al intentar operar","Está en un feed con retraso o en un contrato vencido. Añada datos de mercado y use el símbolo del mes frontal."],
      ["Los gráficos se congelan o se desconecta","Puede que haya superado el límite de sesiones. Cierre sesión en las aplicaciones web, de escritorio y móvil de Tradovate para que TradingView mantenga la única sesión."],
    ] },
    { type: "heading",text: "Automatice esto con PickMyTrade" },
    { type: "paragraph",html: "¿Quiere que sus alertas de TradingView ejecuten operaciones automáticamente en su cuenta prop de Tradovate, sin tarifa de API, sin licencia de CME y sin vigilar la pantalla? <strong class='text-white'>PickMyTrade automatiza su ejecución en Tradovate</strong>." },
    { type: "paragraph",html: "Eso es todo. Active el complemento gratuito, conéctese en Demo y su cuenta prop operará directamente desde el gráfico de TradingView, sin necesidad de comprar ningún complemento." },
  ], fr: [
    { type: "paragraph",html: "La version courte : si vous tradez un compte de prop firm ou d'évaluation qui fonctionne sur Tradovate, vous n'avez presque certainement <strong class='text-white'>pas</strong> besoin de payer le module complémentaire TradingView autonome. Ce module payant existe pour les comptes de courtage particuliers directs. Les comptes prop et d'évaluation obtiennent l'accès à TradingView dans le cadre de l'intégration Tradovate de la société ; vous l'activez donc gratuitement et vous vous connectez via l'onglet Demo. L'ensemble prend environ cinq minutes." },
    { type: "paragraph",html: "Voici le chemin exact. Le détail qui piège le plus de monde se trouve à l'étape 4 : lisez-la donc deux fois." },
    { type: "heading",text: "Avant de commencer" },
    { type: "paragraph",html: "Il vous faut trois choses : vos identifiants du tableau de bord de la prop firm, vos identifiants Tradovate (de nombreuses sociétés fournissent un nom d'utilisateur commençant par <code>TRAD</code> suivi de chiffres) et un compte TradingView gratuit. Si votre société n'a pas encore activé TradingView sur votre compte, un bref message à son support suffit à le faire ; c'est plus rapide que de lutter ensuite contre une erreur d'autorisation." },
    { type: "heading",text: "Connecter un compte Tradovate prop à TradingView : pas à pas" },
    {
      type: "steps",
      items: [
        { title: "Vérifiez que votre société inclut TradingView", html: "Ne sortez pas votre carte bancaire. Le module complémentaire TradingView autonome que Tradovate vend (un petit abonnement mensuel récurrent ; consultez le tarif actuel sur la page de tarification de Tradovate) s'adresse à ceux qui tradent leur propre compte de courtage financé. Les comptes d'évaluation et les comptes sim financés d'une prop firm disposent déjà de l'autorisation TradingView via la société. Connectez-vous au tableau de bord de votre prop firm et vérifiez que TradingView figure comme disponible dans votre formule, ou demandez à son support de l'activer." },
        { title: "Activez le module complémentaire gratuit dans Tradovate", html: "Ouvrez le Web Trader Tradovate et connectez-vous avec les identifiants de votre prop firm. Cliquez sur l'icône des paramètres en haut à droite, ouvrez <strong class='text-white'>Application Settings</strong>, puis sélectionnez l'onglet <strong class='text-white'>Add-ons</strong>. Trouvez TradingView dans la liste et cliquez sur <strong class='text-white'>Activate</strong>. C'est gratuit sur un compte prop, mais l'activation se renouvelle chaque mois ; si TradingView cesse soudainement de se connecter des semaines plus tard, c'est le premier endroit à vérifier." },
        { title: "Ouvrez le panneau de trading dans TradingView", html: "Rendez-vous sur TradingView et connectez-vous. Ouvrez n'importe quel graphique de contrats à terme, l'E-mini S&amp;P (ES) ou le Nasdaq (NQ) conviennent bien comme symbole de test, puis ouvrez le panneau de trading qui court le long du bas du graphique. Vous verrez une rangée de courtiers pris en charge. C'est ici que la connexion commence." },
        { title: "Choisissez Tradovate, puis l'onglet Demo", html: "Sélectionnez <strong class='text-white'>Tradovate</strong> dans la liste des courtiers. Vient maintenant la partie que tout le monde rate : choisissez l'onglet <strong class='text-white'>Demo</strong>, pas Live. Les comptes prop d'évaluation et les comptes sim financés fonctionnent tous deux dans l'environnement de simulation de Tradovate, même si vos paiements sont réels. Si vous choisissez Live, la connexion échoue ou ne vous connecte à rien. Demo est correct pour la grande majorité des configurations prop, mais les sociétés diffèrent ; si Demo n'accepte pas votre connexion, consultez les instructions de votre société avant de conclure que quelque chose est cassé." },
        { title: "Saisissez vos identifiants et connectez-vous", html: "Saisissez le nom d'utilisateur et le mot de passe Tradovate du tableau de bord de votre prop firm, puis cliquez sur <strong class='text-white'>Connect</strong>. Vous pouvez être redirigé vers une page de connexion Tradovate pour confirmer ; c'est normal. Une fois connecté, TradingView affiche votre compte d'évaluation et son solde. Choisissez le bon compte dans la liste déroulante si votre société vous en a attribué plusieurs, et vous voilà en direct sur les graphiques." },
      ],
    },
    { type: "heading",text: "Si la connexion ne s'établit pas" },
    { type: "paragraph",html: "Quelques écueils reviennent sans cesse :" },
    { type: "table", headers: ["Ce que vous voyez","Que faire"], rows: [
      ["Message « TradingView has not been entitled to access your account »","Le module complémentaire n'est pas actif. Refaites l'étape 2 ou demandez à votre société d'activer TradingView sur votre compte."],
      ["La connexion échoue uniquement sur l'onglet Live","Passez à l'onglet Demo. Les comptes prop et d'évaluation n'utilisent presque jamais Live."],
      ["Message « Non-tradable symbol » lorsque vous essayez de trader","Vous êtes sur un flux différé ou sur un contrat arrivé à échéance. Ajoutez des données de marché et utilisez le symbole du mois rapproché."],
      ["Les graphiques se figent ou vous êtes déconnecté","Vous avez peut-être dépassé la limite de sessions. Déconnectez-vous des applications web, de bureau et mobile de Tradovate afin que TradingView détienne la seule session."],
    ] },
    { type: "heading",text: "Automatisez avec PickMyTrade" },
    { type: "paragraph",html: "Vous voulez que vos alertes TradingView déclenchent automatiquement des trades sur votre compte Tradovate prop, sans frais d'API, sans licence CME et sans surveiller l'écran ? <strong class='text-white'>PickMyTrade automatise votre exécution Tradovate</strong>." },
    { type: "paragraph",html: "Voilà. Activez le module complémentaire gratuit, connectez-vous sur Demo, et votre compte prop trade directement depuis le graphique TradingView, sans aucun achat de module complémentaire." },
  ], it: [
    { type: "paragraph",html: "La versione breve: se opera su un conto di prop firm o di valutazione che gira su Tradovate, quasi certamente <strong class='text-white'>non</strong> ha bisogno di pagare il componente aggiuntivo TradingView autonomo. Quel componente a pagamento esiste per i conti brokerage retail diretti. I conti prop e di valutazione ottengono l'accesso a TradingView come parte dell'integrazione Tradovate della società, quindi lo attiva gratuitamente e si collega tramite la scheda Demo. L'intera operazione richiede circa cinque minuti." },
    { type: "paragraph",html: "Di seguito il percorso esatto. Il dettaglio su cui inciampano in molti si trova al passaggio 4, quindi lo legga due volte." },
    { type: "heading",text: "Prima di iniziare" },
    { type: "paragraph",html: "Le servono tre cose: il login alla dashboard della sua prop firm, le credenziali Tradovate (molte società forniscono un nome utente che inizia con <code>TRAD</code> seguito da numeri) e un account TradingView gratuito. Se la sua società non ha ancora attivato TradingView sul suo conto, basta un breve messaggio al loro supporto per abilitarlo; è più rapido che lottare in seguito con un errore di autorizzazione." },
    { type: "heading",text: "Collegare un conto prop Tradovate a TradingView: passo dopo passo" },
    {
      type: "steps",
      items: [
        { title: "Verifichi che la sua società includa TradingView", html: "Non tiri fuori la carta di credito. Il componente aggiuntivo TradingView autonomo venduto da Tradovate (un piccolo canone mensile ricorrente; verifichi il prezzo attuale nella pagina dei prezzi di Tradovate) è per chi opera sul proprio conto brokerage finanziato. I conti di valutazione e i conti sim finanziati di una prop firm hanno già l'autorizzazione TradingView tramite la società. Acceda alla dashboard della sua prop firm e verifichi che TradingView sia indicato come disponibile nel suo piano, oppure chieda al loro supporto di abilitarlo." },
        { title: "Attivi il componente aggiuntivo gratuito in Tradovate", html: "Apra il Web Trader di Tradovate e acceda con le credenziali della sua prop firm. Clicchi sull'icona delle impostazioni in alto a destra, apra <strong class='text-white'>Application Settings</strong> e selezioni la scheda <strong class='text-white'>Add-ons</strong>. Trovi TradingView nell'elenco e clicchi su <strong class='text-white'>Activate</strong>. È gratuito su un conto prop, anche se l'attivazione si rinnova ogni mese, quindi se TradingView smette improvvisamente di connettersi dopo settimane, questo è il primo posto da controllare." },
        { title: "Apra il pannello di trading in TradingView", html: "Vada su TradingView e acceda. Apra un qualsiasi grafico di futures, l'E-mini S&amp;P (ES) o il Nasdaq (NQ) vanno bene come simbolo di prova, quindi apra il pannello di trading che corre lungo la parte inferiore del grafico. Vedrà una riga di broker supportati. È da qui che inizia la connessione." },
        { title: "Scelga Tradovate, poi la scheda Demo", html: "Selezioni <strong class='text-white'>Tradovate</strong> dall'elenco dei broker. Ora arriva la parte che tutti sbagliano: scelga la scheda <strong class='text-white'>Demo</strong>, non Live. I conti prop di valutazione e i conti sim finanziati girano entrambi nell'ambiente di simulazione di Tradovate, anche se i suoi pagamenti sono reali. Se sceglie Live, l'accesso fallisce oppure non la collega a nulla. Demo è corretto per la grande maggioranza delle configurazioni prop, ma le società differiscono; se Demo non accetta il suo accesso, verifichi le istruzioni della sua società prima di supporre che qualcosa non funzioni." },
        { title: "Inserisca le credenziali e si colleghi", html: "Inserisca il nome utente e la password Tradovate della dashboard della sua prop firm e clicchi su <strong class='text-white'>Connect</strong>. Potrebbe essere reindirizzato a una pagina di accesso di Tradovate per confermare; è normale. Una volta dentro, TradingView mostra il suo conto di valutazione e il relativo saldo. Scelga il conto giusto dal menu a discesa se la società gliene ha assegnato più di uno, e sarà operativo sui grafici." },
      ],
    },
    { type: "heading",text: "Se la connessione non va a buon fine" },
    { type: "paragraph",html: "Alcuni intoppi si ripresentano ripetutamente:" },
    { type: "table", headers: ["Cosa vede","Cosa fare"], rows: [
      ["Messaggio «TradingView has not been entitled to access your account»","Il componente aggiuntivo non è attivo. Ripeta il passaggio 2 oppure chieda alla sua società di abilitare TradingView sul suo conto."],
      ["L'accesso fallisce solo nella scheda Live","Passi alla scheda Demo. I conti prop e di valutazione non usano quasi mai Live."],
      ["Messaggio «Non-tradable symbol» quando prova a operare","È su un feed ritardato o su un contratto scaduto. Aggiunga i dati di mercato e usi il simbolo del mese corrente."],
      ["I grafici si bloccano o viene disconnesso","Potrebbe aver superato il limite di sessioni. Esca dalle app web, desktop e mobile di Tradovate in modo che TradingView mantenga l'unica sessione."],
    ] },
    { type: "heading",text: "Automatizzi tutto con PickMyTrade" },
    { type: "paragraph",html: "Desidera che i suoi alert di TradingView eseguano automaticamente i trade sul suo conto prop Tradovate, senza commissioni API, senza licenza CME e senza fissare lo schermo? <strong class='text-white'>PickMyTrade automatizza la sua esecuzione su Tradovate</strong>." },
    { type: "paragraph",html: "Tutto qui. Attivi il componente aggiuntivo gratuito, si colleghi su Demo e il suo conto prop opererà direttamente dal grafico di TradingView, senza bisogno di acquistare alcun componente aggiuntivo." },
  ] },
  ctaHeading: { en: "Automate Your Prop Account From TradingView", de: "Automatisieren Sie Ihr Prop-Konto von TradingView aus", es: "Automatice su cuenta prop desde TradingView", fr: "Automatisez votre compte prop depuis TradingView", it: "Automatizzi il suo conto prop da TradingView" },
  ctaText: { en: "No API fee, no CME license, no watching the screen. PickMyTrade automates your Tradovate execution straight from your TradingView alerts.", de: "Keine API-Gebühr, keine CME-Lizenz, kein Starren auf den Bildschirm. PickMyTrade automatisiert Ihre Tradovate-Ausführung direkt aus Ihren TradingView-Alerts.", es: "Sin tarifa de API, sin licencia de CME, sin vigilar la pantalla. PickMyTrade automatiza su ejecución en Tradovate directamente desde sus alertas de TradingView.", fr: "Pas de frais d'API, pas de licence CME, pas besoin de surveiller l'écran. PickMyTrade automatise votre exécution Tradovate directement à partir de vos alertes TradingView.", it: "Nessuna commissione API, nessuna licenza CME, nessuna necessità di fissare lo schermo. PickMyTrade automatizza la sua esecuzione su Tradovate direttamente dai suoi alert di TradingView." },
