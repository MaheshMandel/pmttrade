---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "tradovate-stop-loss-take-profit";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/how-to/${SLUG}`;

const META_TITLE = "Set & Manage Stop Loss and Take Profit in Tradovate";
const META_DESCRIPTION =
  "Tradovate stop loss and take profit: set an ATM bracket, drag SL/TP lines on the chart, and manage every trade's risk and target in seconds.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Stop Loss und Take Profit in Tradovate setzen und verwalten", es: "Configure y gestione el stop loss y el take profit en Tradovate", fr: "Définir et gérer le stop loss et le take profit dans Tradovate", it: "Impostare e gestire stop loss e take profit in Tradovate" },
  dek: { en: "Every trade you take in Tradovate should have a stop loss and a take profit attached before you look away from the screen. Here's how to attach both, confirm them, drag them, and bracket a position you've already opened.", de: "Jeder Trade in Tradovate sollte einen Stop Loss und einen Take Profit haben, bevor Sie den Blick vom Bildschirm abwenden. So hängen Sie beide an, bestätigen sie, ziehen sie und versehen eine bereits eröffnete Position mit einem Bracket.", es: "Cada operación que realice en Tradovate debería tener un stop loss y un take profit adjuntos antes de apartar la vista de la pantalla. Así puede adjuntar ambos, confirmarlos, arrastrarlos y añadir un bracket a una posición ya abierta.", fr: "Chaque trade que vous prenez dans Tradovate devrait avoir un stop loss et un take profit attachés avant que vous ne quittiez l'écran des yeux. Voici comment attacher les deux, les confirmer, les déplacer et poser un bracket sur une position déjà ouverte.", it: "Ogni trade che esegue in Tradovate dovrebbe avere uno stop loss e un take profit associati prima di distogliere lo sguardo dallo schermo. Ecco come collegarli entrambi, confermarli, trascinarli e applicare un bracket a una posizione già aperta." },
  readTime: { en: "5 min read", de: "5 Min. Lesezeit", es: "Lectura de 5 min", fr: "Lecture : 5 min", it: "Lettura di 5 min" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "Every trade you take in Tradovate should have a stop loss and a take profit attached before you look away from the screen. Whether you're scalping ES, holding NQ for a swing, or running your entries through automation, this guide shows you how to attach both levels, confirm them on the chart, drag them around, and bolt a bracket onto a position you've already opened." },
    { type: "heading", text: "What Is a Stop Loss and Take Profit in Tradovate?" },
    { type: "paragraph", html: "A <strong class='text-white'>stop loss (SL)</strong> is a resting order that closes your position if price runs against you past a level you set, so a bad move caps out instead of running open. A <strong class='text-white'>take profit (TP)</strong> is the mirror image: a resting order that closes the position the moment price reaches your target and banks the gain." },
    { type: "paragraph", html: "The cleanest way to attach both at once in Tradovate is an <strong class='text-white'>ATM Strategy</strong>, a saved bracket preset that drops your SL and TP in as a linked <strong class='text-white'>OCO (One-Cancels-the-Other)</strong> pair the instant your entry fills. Set it up once, and every trade you take with that strategy comes pre-wrapped in risk and target." },
    { type: "heading", text: "Setting Stop Loss and Take Profit in Tradovate: Step-by-Step" },
    {
      type: "steps",
      items: [
        { title: "Configure an ATM Strategy", html: "Pull up a chart or the SuperDOM and find the <strong class='text-white'>ATM</strong> dropdown in the order-entry panel. Click the <strong class='text-white'>gear icon</strong> beside it, then hit the <strong class='text-white'>plus (+)</strong> to spin up a new strategy. Name it something you'll actually recognize mid-session, \"SL-TP Scalp\" does the job, then enter your <strong class='text-white'>Stop Loss</strong> and <strong class='text-white'>Profit Target</strong>. Both fields are measured in <strong class='text-white'>ticks</strong> by default, so a 40-tick stop on ES works out to 10 points. Choose your stop order type (Stop Market or Trailing Stop) and click <strong class='text-white'>Save</strong>." },
        { title: "Apply the Strategy and Enter the Trade", html: "Pick your saved strategy from the <strong class='text-white'>ATM dropdown</strong>, then fire the entry with Buy or Sell on the chart or DOM. The moment the entry order fills, Tradovate drops your <strong class='text-white'>stop loss and take profit in as an OCO bracket</strong>, you don't touch anything else. And because it's OCO, whichever order fills first cancels the other on the spot." },
        { title: "Confirm the SL/TP Lines on Your Open Position", html: "Once you're filled, Tradovate paints your <strong class='text-white'>stop loss and take profit as horizontal lines</strong> right on the chart at their price levels, and the working orders show up in the DOM and the Orders tab as well. Spend two seconds confirming the stop sits on your risk side and the target on the profit side before you step away. It's a cheap habit that saves ugly surprises." },
        { title: "Drag a Line to Move Your SL or TP", html: "Need to move a level? Grab the SL or TP line on the chart and <strong class='text-white'>drag it to a new price</strong>, Tradovate rewrites the resting order in place, no re-entry required. This is how you trail a stop up to breakeven once the trade's in profit, or give a runner more room by pushing the target higher as the move keeps working in your favor." },
        { title: "Attach SL/TP to an Existing Position (No ATM)", html: "Already long or short with no bracket attached? Open the <strong class='text-white'>DOM</strong> and click <strong class='text-white'>OCO</strong> to switch into OCO mode. Click <strong class='text-white'>above</strong> the market to stage a limit take profit and <strong class='text-white'>below</strong> it to stage a stop loss, flip that for a short. Click <strong class='text-white'>OCO</strong> once more to send the pair as one linked order. From there you can modify or cancel either side from the <strong class='text-white'>Positions/Orders</strong> panel." },
      ],
    },
    { type: "heading", text: "Why You'd Need This" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Cap risk on every trade</strong> so one bad tick can't blow up your day.",
        "<strong class='text-white'>Lock in targets automatically</strong> instead of babysitting the screen for an exit.",
        "<strong class='text-white'>Adjust on the fly</strong>, drag to breakeven or extend a runner in a single motion.",
        "<strong class='text-white'>Stay prop-firm compliant</strong> by keeping a hard stop on every position you hold.",
        "<strong class='text-white'>Feed clean SL/TP levels</strong> into your automated strategies and trade journal.",
      ],
    },
    { type: "heading", text: "Automate This with PickMyTrade" },
    { type: "paragraph", html: "Setting brackets by hand is fine until an alert fires while you're away from the desk. PickMyTrade wires your TradingView alerts straight into your Tradovate account and attaches the stop loss and take profit for you, every signal enters with a full bracket, zero manual clicks." },
  ], de: [
    { type: "paragraph",html: "Jeder Trade in Tradovate sollte einen Stop Loss und einen Take Profit haben, bevor Sie den Blick vom Bildschirm abwenden. Ob Sie ES scalpen, NQ als Swing halten oder Ihre Einstiege automatisieren: Diese Anleitung zeigt Ihnen, wie Sie beide Level anhängen, im Chart bestätigen, verschieben und ein Bracket an eine bereits eröffnete Position anfügen." },
    { type: "heading",text: "Was sind Stop Loss und Take Profit in Tradovate?" },
    { type: "paragraph",html: "Ein <strong class='text-white'>Stop Loss (SL)</strong> ist eine ruhende Order, die Ihre Position schließt, wenn der Kurs über ein von Ihnen gesetztes Level hinaus gegen Sie läuft, sodass ein schlechter Move begrenzt wird, statt offen weiterzulaufen. Ein <strong class='text-white'>Take Profit (TP)</strong> ist das Spiegelbild: eine ruhende Order, die die Position schließt, sobald der Kurs Ihr Ziel erreicht, und den Gewinn sichert." },
    { type: "paragraph",html: "Der sauberste Weg, beides in Tradovate gleichzeitig anzuhängen, ist eine <strong class='text-white'>ATM Strategy</strong>, eine gespeicherte Bracket-Vorlage, die Ihren SL und TP als verknüpftes <strong class='text-white'>OCO-Paar (One-Cancels-the-Other)</strong> setzt, sobald Ihre Einstiegsorder ausgeführt wird. Richten Sie sie einmal ein, und jeder Trade mit dieser Strategie ist von Anfang an mit Risiko und Ziel versehen." },
    { type: "heading",text: "Stop Loss und Take Profit in Tradovate setzen: Schritt für Schritt" },
    {
      type: "steps",
      items: [
        { title: "Eine ATM Strategy konfigurieren", html: "Öffnen Sie einen Chart oder das SuperDOM und suchen Sie im Order-Eingabebereich das <strong class='text-white'>ATM</strong>-Dropdown. Klicken Sie auf das <strong class='text-white'>Zahnrad-Symbol</strong> daneben und dann auf das <strong class='text-white'>Plus (+)</strong>, um eine neue Strategie anzulegen. Geben Sie ihr einen Namen, den Sie mitten in der Sitzung wiedererkennen, „SL-TP Scalp“ reicht völlig, und tragen Sie dann Ihren <strong class='text-white'>Stop Loss</strong> und Ihr <strong class='text-white'>Profit Target</strong> ein. Beide Felder werden standardmäßig in <strong class='text-white'>Ticks</strong> gemessen, ein Stop von 40 Ticks bei ES entspricht also 10 Punkten. Wählen Sie Ihren Stop-Ordertyp (Stop Market oder Trailing Stop) und klicken Sie auf <strong class='text-white'>Save</strong>." },
        { title: "Die Strategie anwenden und den Trade eingehen", html: "Wählen Sie Ihre gespeicherte Strategie im <strong class='text-white'>ATM-Dropdown</strong> aus und lösen Sie dann den Einstieg mit Buy oder Sell im Chart oder DOM aus. Sobald die Einstiegsorder ausgeführt wird, setzt Tradovate Ihren <strong class='text-white'>Stop Loss und Take Profit als OCO-Bracket</strong>, Sie müssen nichts weiter anfassen. Und weil es OCO ist, storniert die zuerst ausgeführte Order die andere sofort." },
        { title: "Die SL/TP-Linien an Ihrer offenen Position bestätigen", html: "Sobald Sie ausgeführt sind, zeichnet Tradovate Ihren <strong class='text-white'>Stop Loss und Take Profit als horizontale Linien</strong> direkt im Chart auf den jeweiligen Preisniveaus ein, und die aktiven Orders erscheinen auch im DOM und im Orders-Tab. Prüfen Sie zwei Sekunden lang, ob der Stop auf der Risikoseite und das Ziel auf der Gewinnseite liegt, bevor Sie sich entfernen. Es ist eine günstige Gewohnheit, die böse Überraschungen erspart." },
        { title: "Eine Linie ziehen, um SL oder TP zu verschieben", html: "Müssen Sie ein Level verschieben? Greifen Sie die SL- oder TP-Linie im Chart und <strong class='text-white'>ziehen Sie sie auf einen neuen Preis</strong>, Tradovate schreibt die ruhende Order direkt um, ohne dass ein erneuter Einstieg nötig ist. So ziehen Sie einen Stop auf Breakeven nach, sobald der Trade im Gewinn ist, oder geben einem Runner mehr Luft, indem Sie das Ziel höher setzen, solange die Bewegung zu Ihren Gunsten weiterläuft." },
        { title: "SL/TP an eine bestehende Position anhängen (ohne ATM)", html: "Sie sind bereits Long oder Short, ohne dass ein Bracket angehängt ist? Öffnen Sie das <strong class='text-white'>DOM</strong> und klicken Sie auf <strong class='text-white'>OCO</strong>, um in den OCO-Modus zu wechseln. Klicken Sie <strong class='text-white'>über</strong> den Markt, um einen Limit-Take-Profit vorzubereiten, und <strong class='text-white'>darunter</strong>, um einen Stop Loss vorzubereiten, bei Short-Positionen umgekehrt. Klicken Sie noch einmal auf <strong class='text-white'>OCO</strong>, um das Paar als eine verknüpfte Order zu senden. Von dort aus können Sie beide Seiten im Panel <strong class='text-white'>Positions/Orders</strong> ändern oder stornieren." },
      ],
    },
    { type: "heading",text: "Warum Sie das brauchen" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Begrenzen Sie das Risiko bei jedem Trade</strong>, damit ein einziger schlechter Tick nicht Ihren ganzen Tag ruiniert.",
        "<strong class='text-white'>Sichern Sie Ziele automatisch</strong>, statt den Bildschirm für einen Ausstieg zu bewachen.",
        "<strong class='text-white'>Passen Sie spontan an</strong>, ziehen Sie auf Breakeven oder verlängern Sie einen Runner in einer einzigen Bewegung.",
        "<strong class='text-white'>Bleiben Sie Prop-Firm-konform</strong>, indem Sie jede gehaltene Position mit einem harten Stop absichern.",
        "<strong class='text-white'>Liefern Sie saubere SL/TP-Level</strong> in Ihre automatisierten Strategien und Ihr Trading-Journal.",
      ],
    },
    { type: "heading",text: "Automatisieren Sie dies mit PickMyTrade" },
    { type: "paragraph",html: "Brackets von Hand zu setzen ist in Ordnung, bis ein Alert auslöst, während Sie nicht am Schreibtisch sind. PickMyTrade verbindet Ihre TradingView-Alerts direkt mit Ihrem Tradovate-Konto und hängt Stop Loss und Take Profit für Sie an, jedes Signal wird mit vollständigem Bracket eröffnet, ganz ohne manuelle Klicks." },
  ], es: [
    { type: "paragraph",html: "Cada operación que realice en Tradovate debería tener un stop loss y un take profit adjuntos antes de apartar la vista de la pantalla. Tanto si hace scalping en ES, mantiene NQ en swing o ejecuta sus entradas con automatización, esta guía le muestra cómo adjuntar ambos niveles, confirmarlos en el gráfico, arrastrarlos y añadir un bracket a una posición ya abierta." },
    { type: "heading",text: "¿Qué son el stop loss y el take profit en Tradovate?" },
    { type: "paragraph",html: "Un <strong class='text-white'>stop loss (SL)</strong> es una orden en espera que cierra su posición si el precio va en su contra más allá de un nivel que usted fija, de modo que un mal movimiento queda limitado en lugar de seguir abierto. Un <strong class='text-white'>take profit (TP)</strong> es la imagen especular: una orden en espera que cierra la posición en el momento en que el precio alcanza su objetivo y asegura la ganancia." },
    { type: "paragraph",html: "La forma más limpia de adjuntar ambos a la vez en Tradovate es una <strong class='text-white'>ATM Strategy</strong>, un preajuste de bracket guardado que coloca su SL y TP como un par <strong class='text-white'>OCO (One-Cancels-the-Other)</strong> vinculado en cuanto se ejecuta su entrada. Configúrela una vez y cada operación que realice con esa estrategia vendrá ya envuelta en riesgo y objetivo." },
    { type: "heading",text: "Configurar el stop loss y el take profit en Tradovate: paso a paso" },
    {
      type: "steps",
      items: [
        { title: "Configure una ATM Strategy", html: "Abra un gráfico o el SuperDOM y busque el desplegable <strong class='text-white'>ATM</strong> en el panel de introducción de órdenes. Haga clic en el <strong class='text-white'>icono de engranaje</strong> junto a él y luego en el <strong class='text-white'>signo más (+)</strong> para crear una nueva estrategia. Póngale un nombre que reconozca en plena sesión, «SL-TP Scalp» sirve perfectamente, y a continuación introduzca su <strong class='text-white'>Stop Loss</strong> y su <strong class='text-white'>Profit Target</strong>. Ambos campos se miden en <strong class='text-white'>ticks</strong> por defecto, así que un stop de 40 ticks en ES equivale a 10 puntos. Elija su tipo de orden stop (Stop Market o Trailing Stop) y haga clic en <strong class='text-white'>Save</strong>." },
        { title: "Aplique la estrategia y entre en la operación", html: "Elija su estrategia guardada en el <strong class='text-white'>desplegable ATM</strong> y luego lance la entrada con Buy o Sell en el gráfico o en el DOM. En el momento en que se ejecuta la orden de entrada, Tradovate coloca su <strong class='text-white'>stop loss y take profit como un bracket OCO</strong>, sin que usted tenga que tocar nada más. Y como es OCO, la orden que se ejecute primero cancela a la otra al instante." },
        { title: "Confirme las líneas de SL/TP en su posición abierta", html: "Una vez ejecutada la entrada, Tradovate dibuja su <strong class='text-white'>stop loss y take profit como líneas horizontales</strong> directamente en el gráfico, en sus niveles de precio, y las órdenes activas también aparecen en el DOM y en la pestaña Orders. Dedique dos segundos a confirmar que el stop está en el lado del riesgo y el objetivo en el lado del beneficio antes de alejarse. Es un hábito barato que evita sorpresas desagradables." },
        { title: "Arrastre una línea para mover su SL o TP", html: "¿Necesita mover un nivel? Agarre la línea de SL o TP en el gráfico y <strong class='text-white'>arrástrela a un nuevo precio</strong>; Tradovate reescribe la orden en espera sobre la marcha, sin necesidad de volver a entrar. Así es como sube un stop hasta el punto de equilibrio una vez que la operación está en beneficio, o da más margen a un runner empujando el objetivo más arriba mientras el movimiento sigue a su favor." },
        { title: "Adjunte SL/TP a una posición existente (sin ATM)", html: "¿Ya está en largo o en corto sin ningún bracket adjunto? Abra el <strong class='text-white'>DOM</strong> y haga clic en <strong class='text-white'>OCO</strong> para pasar al modo OCO. Haga clic <strong class='text-white'>por encima</strong> del mercado para preparar un take profit limitado y <strong class='text-white'>por debajo</strong> para preparar un stop loss; al revés en un corto. Haga clic en <strong class='text-white'>OCO</strong> una vez más para enviar el par como una única orden vinculada. A partir de ahí puede modificar o cancelar cualquiera de los dos lados desde el panel <strong class='text-white'>Positions/Orders</strong>." },
      ],
    },
    { type: "heading",text: "Por qué lo necesitaría" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Limite el riesgo en cada operación</strong> para que un mal tick no arruine su día.",
        "<strong class='text-white'>Asegure objetivos automáticamente</strong> en lugar de vigilar la pantalla esperando una salida.",
        "<strong class='text-white'>Ajuste sobre la marcha</strong>, arrastre hasta el punto de equilibrio o amplíe un runner con un solo movimiento.",
        "<strong class='text-white'>Cumpla con las normas de las prop firms</strong> manteniendo un stop firme en cada posición que mantenga.",
        "<strong class='text-white'>Aporte niveles de SL/TP limpios</strong> a sus estrategias automatizadas y a su diario de trading.",
      ],
    },
    { type: "heading",text: "Automatice esto con PickMyTrade" },
    { type: "paragraph",html: "Colocar los brackets a mano está bien hasta que salta una alerta mientras usted no está en el escritorio. PickMyTrade conecta sus alertas de TradingView directamente con su cuenta de Tradovate y adjunta el stop loss y el take profit por usted: cada señal entra con un bracket completo, sin ningún clic manual." },
  ], fr: [
    { type: "paragraph",html: "Chaque trade que vous prenez dans Tradovate devrait avoir un stop loss et un take profit attachés avant que vous ne quittiez l'écran des yeux. Que vous fassiez du scalping sur ES, que vous teniez NQ en swing ou que vous automatisiez vos entrées, ce guide vous montre comment attacher les deux niveaux, les confirmer sur le graphique, les déplacer et poser un bracket sur une position déjà ouverte." },
    { type: "heading",text: "Qu'est-ce qu'un stop loss et un take profit dans Tradovate ?" },
    { type: "paragraph",html: "Un <strong class='text-white'>stop loss (SL)</strong> est un ordre en attente qui clôture votre position si le prix évolue contre vous au-delà d'un niveau que vous définissez, de sorte qu'un mauvais mouvement soit plafonné au lieu de rester ouvert. Un <strong class='text-white'>take profit (TP)</strong> en est le miroir : un ordre en attente qui clôture la position dès que le prix atteint votre objectif et encaisse le gain." },
    { type: "paragraph",html: "La façon la plus propre d'attacher les deux en même temps dans Tradovate est une <strong class='text-white'>ATM Strategy</strong>, un préréglage de bracket enregistré qui place votre SL et votre TP sous forme de paire <strong class='text-white'>OCO (One-Cancels-the-Other)</strong> liée dès que votre entrée est exécutée. Configurez-la une fois, et chaque trade pris avec cette stratégie arrive déjà enveloppé de son risque et de son objectif." },
    { type: "heading",text: "Définir le stop loss et le take profit dans Tradovate : étape par étape" },
    {
      type: "steps",
      items: [
        { title: "Configurer une ATM Strategy", html: "Ouvrez un graphique ou le SuperDOM et repérez la liste déroulante <strong class='text-white'>ATM</strong> dans le panneau de saisie des ordres. Cliquez sur l'<strong class='text-white'>icône d'engrenage</strong> à côté, puis sur le <strong class='text-white'>plus (+)</strong> pour créer une nouvelle stratégie. Donnez-lui un nom que vous reconnaîtrez en pleine séance, « SL-TP Scalp » fait très bien l'affaire, puis saisissez votre <strong class='text-white'>Stop Loss</strong> et votre <strong class='text-white'>Profit Target</strong>. Les deux champs sont exprimés en <strong class='text-white'>ticks</strong> par défaut : un stop de 40 ticks sur ES équivaut donc à 10 points. Choisissez votre type d'ordre stop (Stop Market ou Trailing Stop) et cliquez sur <strong class='text-white'>Save</strong>." },
        { title: "Appliquer la stratégie et entrer en position", html: "Sélectionnez votre stratégie enregistrée dans la <strong class='text-white'>liste déroulante ATM</strong>, puis déclenchez l'entrée avec Buy ou Sell sur le graphique ou le DOM. Dès que l'ordre d'entrée est exécuté, Tradovate place votre <strong class='text-white'>stop loss et take profit sous forme de bracket OCO</strong>, sans que vous ayez rien d'autre à toucher. Et comme il s'agit d'un OCO, l'ordre exécuté en premier annule l'autre sur-le-champ." },
        { title: "Confirmer les lignes SL/TP sur votre position ouverte", html: "Une fois exécuté, Tradovate affiche votre <strong class='text-white'>stop loss et take profit sous forme de lignes horizontales</strong> directement sur le graphique à leurs niveaux de prix, et les ordres actifs apparaissent aussi dans le DOM et dans l'onglet Orders. Prenez deux secondes pour vérifier que le stop se trouve du côté du risque et l'objectif du côté du gain avant de vous éloigner. C'est une habitude peu coûteuse qui évite de mauvaises surprises." },
        { title: "Faire glisser une ligne pour déplacer votre SL ou TP", html: "Besoin de déplacer un niveau ? Saisissez la ligne SL ou TP sur le graphique et <strong class='text-white'>faites-la glisser vers un nouveau prix</strong> ; Tradovate réécrit l'ordre en attente sur place, sans nouvelle entrée. C'est ainsi que vous remontez un stop au point mort une fois le trade en gain, ou que vous laissez plus d'espace à un runner en repoussant l'objectif plus haut tant que le mouvement continue en votre faveur." },
        { title: "Attacher un SL/TP à une position existante (sans ATM)", html: "Déjà long ou short sans aucun bracket attaché ? Ouvrez le <strong class='text-white'>DOM</strong> et cliquez sur <strong class='text-white'>OCO</strong> pour passer en mode OCO. Cliquez <strong class='text-white'>au-dessus</strong> du marché pour préparer un take profit limite et <strong class='text-white'>en dessous</strong> pour préparer un stop loss ; l'inverse pour un short. Cliquez à nouveau sur <strong class='text-white'>OCO</strong> pour envoyer la paire comme un ordre lié unique. Vous pouvez ensuite modifier ou annuler l'un ou l'autre côté depuis le panneau <strong class='text-white'>Positions/Orders</strong>." },
      ],
    },
    { type: "heading",text: "Pourquoi vous en avez besoin" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Plafonnez le risque sur chaque trade</strong> pour qu'un mauvais tick ne ruine pas toute votre journée.",
        "<strong class='text-white'>Verrouillez vos objectifs automatiquement</strong> au lieu de surveiller l'écran en attendant une sortie.",
        "<strong class='text-white'>Ajustez à la volée</strong>, faites glisser jusqu'au point mort ou étendez un runner d'un seul geste.",
        "<strong class='text-white'>Restez conforme aux règles des prop firms</strong> en gardant un stop ferme sur chaque position détenue.",
        "<strong class='text-white'>Alimentez vos stratégies automatisées et votre journal de trading</strong> avec des niveaux SL/TP propres.",
      ],
    },
    { type: "heading",text: "Automatisez tout cela avec PickMyTrade" },
    { type: "paragraph",html: "Placer les brackets à la main convient jusqu'à ce qu'une alerte se déclenche pendant que vous êtes loin du bureau. PickMyTrade relie directement vos alertes TradingView à votre compte Tradovate et attache le stop loss et le take profit pour vous : chaque signal entre avec un bracket complet, sans aucun clic manuel." },
  ], it: [
    { type: "paragraph",html: "Ogni trade che esegue in Tradovate dovrebbe avere uno stop loss e un take profit associati prima di distogliere lo sguardo dallo schermo. Che faccia scalping su ES, tenga NQ in swing o esegua le sue entrate tramite automazione, questa guida le mostra come collegare entrambi i livelli, confermarli sul grafico, trascinarli e applicare un bracket a una posizione già aperta." },
    { type: "heading",text: "Che cosa sono stop loss e take profit in Tradovate?" },
    { type: "paragraph",html: "Uno <strong class='text-white'>stop loss (SL)</strong> è un ordine in attesa che chiude la sua posizione se il prezzo va contro di lei oltre un livello da lei impostato, così che un movimento sfavorevole venga limitato invece di restare aperto. Un <strong class='text-white'>take profit (TP)</strong> è l'immagine speculare: un ordine in attesa che chiude la posizione nel momento in cui il prezzo raggiunge il suo obiettivo e incassa il guadagno." },
    { type: "paragraph",html: "Il modo più pulito per collegare entrambi contemporaneamente in Tradovate è una <strong class='text-white'>ATM Strategy</strong>, un preset di bracket salvato che inserisce SL e TP come coppia <strong class='text-white'>OCO (One-Cancels-the-Other)</strong> collegata nell'istante in cui la sua entrata viene eseguita. La imposti una volta, e ogni trade eseguito con quella strategia nasce già avvolto da rischio e obiettivo." },
    { type: "heading",text: "Impostare stop loss e take profit in Tradovate: passo dopo passo" },
