---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "tradovate-news-notifications";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/how-to/${SLUG}`;

const META_TITLE = "Enable or Disable News Notifications in Tradovate";
const META_DESCRIPTION =
  "Learn how to enable or disable Tradovate news notifications and the notification ticker so popups stop covering your DOM and order buttons.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Nachrichtenbenachrichtigungen in Tradovate aktivieren oder deaktivieren", es: "Activar o desactivar las notificaciones de noticias en Tradovate", fr: "Activer ou désactiver les notifications d'actualités dans Tradovate", it: "Attivare o disattivare le notifiche delle notizie in Tradovate" },
  dek: { en: "Learn how to enable or disable Tradovate news notifications and the notification ticker so popups stop covering your DOM and order buttons.", de: "So aktivieren oder deaktivieren Sie die Nachrichtenbenachrichtigungen und den Notification Ticker in Tradovate, damit keine Popups mehr Ihr DOM und Ihre Order-Schaltflächen verdecken.", es: "Aprenda a activar o desactivar las notificaciones de noticias de Tradovate y el Notification Ticker para que las ventanas emergentes dejen de tapar su DOM y los botones de órdenes.", fr: "Découvrez comment activer ou désactiver les notifications d'actualités de Tradovate et le Notification Ticker pour que les fenêtres contextuelles cessent de masquer votre DOM et vos boutons d'ordre.", it: "Scopra come attivare o disattivare le notifiche delle notizie di Tradovate e il Notification Ticker, in modo che i popup non coprano più il Suo DOM e i pulsanti degli ordini." },
  readTime: { en: "5 min read", de: "5 Min. Lesezeit", es: "Lectura de 5 min", fr: "Lecture : 5 min", it: "Lettura di 5 min" },
  lastUpdated: "2026-07-10",
  blocks: { en: [
    { type: "paragraph", html: "Those news popups have a bad habit of showing up at the worst possible moment, sliding over your DOM right as you're about to click. The good news: you don't have to live with them. Tradovate lets you switch news notifications off entirely, and you can fine-tune the rest of the notification bar while you're in there. Here's exactly where the toggle lives and how to flip it." },
    { type: "heading", text: "What \"News Notifications\" Actually Means in Tradovate" },
    { type: "paragraph", html: "Tradovate shows two different things people lump together as \"news.\" There's the little red notification badge, which most traders are fine with, and then there's the news popup that pushes into the workspace and can cover trading buttons or the ladder. Tradovate added a dedicated setting to turn the news notifications off so the popups stop interrupting you, without stripping out your order alerts. That control has lived in the Notifications area of your preferences since the 1.210319.0 platform release." },
    { type: "paragraph", html: "Separately, there's the <strong class='text-white'>Notification Ticker</strong>, the slim bar at the top of the web app that shows a clock and scrolls your order-status messages. That's its own toggle, so you can keep news off but leave order alerts running, or hide the whole ticker if you want a cleaner top edge." },
    { type: "heading", text: "How to Turn Tradovate News Notifications On or Off" },
    {
      type: "steps",
      items: [
        { title: "Open Application Settings", html: "Log in to the Tradovate web app and click the <strong class='text-white'>Application Settings</strong> button in the top-right corner of the screen. That's your gateway to every platform preference, not just notifications.", image: { src: `${IMG}/tradovate-news-notifications-1.png`, alt: "Tradovate web app top-right corner with the Application Settings button highlighted" } },
        { title: "Open the Preferences Tab and Find Notifications", html: "Select the <strong class='text-white'>Preferences</strong> tab at the top of the settings page, then scroll down to the <strong class='text-white'>Notifications</strong> section. Everything you need, the news toggle, order notifications, and the ticker control, is grouped together here.", image: { src: `${IMG}/tradovate-news-notifications-2.png`, alt: "Tradovate Preferences tab scrolled to the Notifications section" } },
        { title: "Toggle News Notifications On or Off", html: "In the Notifications section, find the news notifications toggle and switch it <strong class='text-white'>off</strong> to stop the popups, or <strong class='text-white'>on</strong> if you want them back. The change takes effect right away, so you can head back to your charts without restarting anything.", image: { src: `${IMG}/tradovate-news-notifications-3.png`, alt: "Tradovate Notifications section showing the news notifications toggle switched off" } },
        { title: "Fine-Tune the Ticker and Order Alerts", html: "While you're here, it's worth setting the rest to taste. Toggle the <strong class='text-white'>Notification Ticker</strong> to hide or show the top bar with the clock and scrolling messages. Toggle <strong class='text-white'>Order Notifications</strong> if you want to silence fills and rejections too. And open <strong class='text-white'>Advanced Configuration</strong> to go deeper, you can switch alerts on or off for each individual order status, control push notifications, and pick from a library of audio sounds you can test before you commit.", image: { src: `${IMG}/tradovate-news-notifications-4.png`, alt: "Tradovate notification settings showing the ticker toggle, order notifications, and Advanced Configuration button" } },
      ],
    },
    { type: "heading", text: "Quick Reference: Which Toggle Does What" },
    {
      type: "table",
      headers: ["Setting", "What it controls"],
      rows: [
        ["News notifications", "Turns the news popups on or off across the platform. This is the one that stops news from covering your DOM."],
        ["Notification Ticker", "Shows or hides the top bar with the clock and scrolling status messages."],
        ["Order Notifications", "Enables or disables alerts for order events like fills, working orders, and rejections."],
        ["Advanced Configuration", "Per-status control, push notifications, and audio sounds you can test and customize."],
      ],
    },
    { type: "heading", text: "A Couple of Things to Keep in Mind" },
    { type: "paragraph", html: "Labels and layout shift between platform updates, so if a toggle isn't exactly where this guide puts it, check the current Notifications section in your build, the grouping is the same even when wording changes. On mobile, notification controls live in the app's own settings rather than in the web Preferences page, so handle phone alerts there. And if you trade a prop-firm or evaluation account, some notification behavior can be set by the firm rather than by you, check your firm's current rules if a toggle doesn't stick." },
    { type: "heading", text: "Keep Your Automation Running While Alerts Stay Quiet" },
    { type: "paragraph", html: "Turning off news popups cleans up the screen, but it doesn't place your trades for you. That's where PickMyTrade comes in: it wires your TradingView alerts straight to your Tradovate account so orders fire automatically, whether or not a single notification is on. Quiet workspace, no missed entries." },
  ], de: [
    { type: "paragraph",html: "Diese Nachrichten-Popups erscheinen gern im denkbar ungünstigsten Moment und schieben sich über Ihr DOM, genau wenn Sie klicken wollen. Die gute Nachricht: Sie müssen sich das nicht gefallen lassen. Tradovate erlaubt es, Nachrichtenbenachrichtigungen komplett auszuschalten, und Sie können gleich den Rest der Benachrichtigungsleiste anpassen. Hier erfahren Sie genau, wo der Schalter liegt und wie Sie ihn umlegen." },
    { type: "heading",text: "Was „News Notifications“ in Tradovate eigentlich bedeutet" },
    { type: "paragraph",html: "Tradovate zeigt zwei verschiedene Dinge, die oft unter „News“ zusammengefasst werden. Da ist das kleine rote Benachrichtigungs-Badge, mit dem die meisten Trader gut leben können, und dann ist da das Nachrichten-Popup, das in den Arbeitsbereich schiebt und Handelsschaltflächen oder die Leiter verdecken kann. Tradovate hat eine eigene Einstellung ergänzt, um die Nachrichtenbenachrichtigungen auszuschalten, damit die Popups Sie nicht mehr unterbrechen, ohne dass Ihre Order-Alerts verloren gehen. Dieses Steuerelement befindet sich seit dem Plattform-Release 1.210319.0 im Bereich Notifications Ihrer Einstellungen." },
    { type: "paragraph",html: "Davon getrennt gibt es den <strong class='text-white'>Notification Ticker</strong>, die schmale Leiste oben in der Web-App, die eine Uhr anzeigt und Ihre Order-Statusmeldungen durchlaufen lässt. Dafür gibt es einen eigenen Schalter: Sie können die Nachrichten ausschalten und die Order-Alerts weiterlaufen lassen oder die gesamte Leiste ausblenden, wenn Sie einen aufgeräumteren oberen Rand wünschen." },
    { type: "heading",text: "So schalten Sie die Nachrichtenbenachrichtigungen in Tradovate ein oder aus" },
    {
      type: "steps",
      items: [
        { title: "Application Settings öffnen", html: "Melden Sie sich in der Tradovate-Web-App an und klicken Sie in der oberen rechten Ecke des Bildschirms auf die Schaltfläche <strong class='text-white'>Application Settings</strong>. Sie ist Ihr Zugang zu allen Plattformeinstellungen, nicht nur zu den Benachrichtigungen.", image: {"src":`${IMG}/tradovate-news-notifications-1.png`,"alt":"Obere rechte Ecke der Tradovate-Web-App mit hervorgehobener Schaltfläche Application Settings"} },
        { title: "Tab Preferences öffnen und Notifications finden", html: "Wählen Sie oben auf der Einstellungsseite den Tab <strong class='text-white'>Preferences</strong> und scrollen Sie dann nach unten zum Abschnitt <strong class='text-white'>Notifications</strong>. Alles, was Sie brauchen, nämlich der Nachrichten-Schalter, die Order Notifications und die Ticker-Steuerung, ist hier gebündelt.", image: {"src":`${IMG}/tradovate-news-notifications-2.png`,"alt":"Tab Preferences in Tradovate, gescrollt bis zum Abschnitt Notifications"} },
        { title: "Nachrichtenbenachrichtigungen ein- oder ausschalten", html: "Suchen Sie im Abschnitt Notifications den Schalter für Nachrichtenbenachrichtigungen und stellen Sie ihn auf <strong class='text-white'>aus</strong>, um die Popups zu stoppen, oder auf <strong class='text-white'>ein</strong>, wenn Sie sie wieder haben möchten. Die Änderung gilt sofort, sodass Sie ohne Neustart zu Ihren Charts zurückkehren können.", image: {"src":`${IMG}/tradovate-news-notifications-3.png`,"alt":"Abschnitt Notifications in Tradovate mit ausgeschaltetem Schalter für Nachrichtenbenachrichtigungen"} },
        { title: "Ticker und Order-Alerts feinabstimmen", html: "Wenn Sie schon einmal hier sind, lohnt es sich, den Rest nach Ihrem Geschmack einzustellen. Schalten Sie den <strong class='text-white'>Notification Ticker</strong> um, um die obere Leiste mit Uhr und durchlaufenden Meldungen aus- oder einzublenden. Schalten Sie <strong class='text-white'>Order Notifications</strong> um, wenn Sie auch Ausführungen und Ablehnungen stummschalten möchten. Und öffnen Sie <strong class='text-white'>Advanced Configuration</strong>, um tiefer einzusteigen: Sie können Alerts für jeden einzelnen Order-Status ein- oder ausschalten, Push-Benachrichtigungen steuern und aus einer Bibliothek von Audiosounds wählen, die Sie vorab testen können.", image: {"src":`${IMG}/tradovate-news-notifications-4.png`,"alt":"Tradovate-Benachrichtigungseinstellungen mit Ticker-Schalter, Order Notifications und der Schaltfläche Advanced Configuration"} },
      ],
    },
    { type: "heading",text: "Kurzübersicht: Welcher Schalter macht was" },
    { type: "table", headers: ["Einstellung","Was sie steuert"], rows: [
      ["Nachrichtenbenachrichtigungen","Schaltet die Nachrichten-Popups plattformweit ein oder aus. Dies ist der Schalter, der verhindert, dass Nachrichten Ihr DOM verdecken."],
      ["Notification Ticker","Zeigt die obere Leiste mit Uhr und durchlaufenden Statusmeldungen an oder blendet sie aus."],
      ["Order Notifications","Aktiviert oder deaktiviert Alerts für Order-Ereignisse wie Ausführungen, aktive Orders und Ablehnungen."],
      ["Advanced Configuration","Steuerung pro Status, Push-Benachrichtigungen und Audiosounds, die Sie testen und anpassen können."],
    ] },
    { type: "heading",text: "Ein paar Dinge, die Sie beachten sollten" },
    { type: "paragraph",html: "Bezeichnungen und Layout ändern sich zwischen Plattform-Updates. Wenn ein Schalter nicht genau dort liegt, wo diese Anleitung ihn beschreibt, prüfen Sie den aktuellen Abschnitt Notifications in Ihrer Version; die Gruppierung bleibt gleich, auch wenn sich der Wortlaut ändert. Auf dem Smartphone befinden sich die Benachrichtigungssteuerungen in den eigenen Einstellungen der App und nicht auf der Web-Seite Preferences, verwalten Sie Handy-Alerts also dort. Und wenn Sie ein Prop-Firm- oder Evaluierungskonto handeln, kann ein Teil des Benachrichtigungsverhaltens von der Firma statt von Ihnen festgelegt sein. Prüfen Sie die aktuellen Regeln Ihrer Firma, falls ein Schalter nicht dauerhaft gespeichert wird." },
    { type: "heading",text: "Automatisierung am Laufen halten, während die Alerts ruhig bleiben" },
    { type: "paragraph",html: "Das Abschalten der Nachrichten-Popups räumt den Bildschirm auf, platziert aber keine Trades für Sie. Hier kommt PickMyTrade ins Spiel: Es verbindet Ihre TradingView-Alerts direkt mit Ihrem Tradovate-Konto, sodass Orders automatisch ausgelöst werden, ganz gleich, ob eine einzige Benachrichtigung aktiv ist. Ein ruhiger Arbeitsbereich und keine verpassten Einstiege." },
  ], es: [
    { type: "paragraph",html: "Esas ventanas emergentes de noticias tienen la mala costumbre de aparecer en el peor momento posible, deslizándose sobre su DOM justo cuando va a hacer clic. La buena noticia es que no tiene por qué soportarlas. Tradovate le permite desactivar por completo las notificaciones de noticias, y mientras está ahí puede ajustar el resto de la barra de notificaciones. Aquí le explicamos exactamente dónde está el interruptor y cómo cambiarlo." },
    { type: "heading",text: "Qué significan realmente las «News Notifications» en Tradovate" },
    { type: "paragraph",html: "Tradovate muestra dos cosas distintas que mucha gente agrupa bajo «noticias». Está la pequeña insignia roja de notificación, con la que la mayoría de los traders no tiene problema, y luego está la ventana emergente de noticias que se desliza por el espacio de trabajo y puede tapar botones de trading o la escalera. Tradovate añadió un ajuste específico para desactivar las notificaciones de noticias de modo que las ventanas dejen de interrumpirle, sin quitar sus alertas de órdenes. Ese control está en el área Notifications de sus preferencias desde la versión de plataforma 1.210319.0." },
    { type: "paragraph",html: "Por separado, existe el <strong class='text-white'>Notification Ticker</strong>, la barra delgada en la parte superior de la aplicación web que muestra un reloj y desplaza los mensajes de estado de sus órdenes. Es un interruptor independiente, así que puede mantener las noticias desactivadas y dejar activas las alertas de órdenes, o bien ocultar todo el ticker si prefiere un borde superior más limpio." },
    { type: "heading",text: "Cómo activar o desactivar las notificaciones de noticias de Tradovate" },
    {
      type: "steps",
      items: [
        { title: "Abra Application Settings", html: "Inicie sesión en la aplicación web de Tradovate y haga clic en el botón <strong class='text-white'>Application Settings</strong> situado en la esquina superior derecha de la pantalla. Es la puerta de entrada a todas las preferencias de la plataforma, no solo a las notificaciones.", image: {"src":`${IMG}/tradovate-news-notifications-1.png`,"alt":"Esquina superior derecha de la aplicación web de Tradovate con el botón Application Settings resaltado"} },
        { title: "Abra la pestaña Preferences y busque Notifications", html: "Seleccione la pestaña <strong class='text-white'>Preferences</strong> en la parte superior de la página de ajustes y desplácese hacia abajo hasta la sección <strong class='text-white'>Notifications</strong>. Todo lo que necesita, el interruptor de noticias, las order notifications y el control del ticker, está agrupado aquí.", image: {"src":`${IMG}/tradovate-news-notifications-2.png`,"alt":"Pestaña Preferences de Tradovate desplazada hasta la sección Notifications"} },
        { title: "Active o desactive las notificaciones de noticias", html: "En la sección Notifications, busque el interruptor de notificaciones de noticias y póngalo en <strong class='text-white'>off</strong> para detener las ventanas emergentes, o en <strong class='text-white'>on</strong> si quiere recuperarlas. El cambio surte efecto de inmediato, por lo que puede volver a sus gráficos sin reiniciar nada.", image: {"src":`${IMG}/tradovate-news-notifications-3.png`,"alt":"Sección Notifications de Tradovate con el interruptor de notificaciones de noticias desactivado"} },
        { title: "Ajuste el ticker y las alertas de órdenes", html: "Ya que está aquí, conviene configurar el resto a su gusto. Cambie el <strong class='text-white'>Notification Ticker</strong> para ocultar o mostrar la barra superior con el reloj y los mensajes desplazables. Cambie <strong class='text-white'>Order Notifications</strong> si desea silenciar también las ejecuciones y los rechazos. Y abra <strong class='text-white'>Advanced Configuration</strong> para profundizar: puede activar o desactivar alertas para cada estado de orden individual, controlar las notificaciones push y elegir entre una biblioteca de sonidos de audio que puede probar antes de decidirse.", image: {"src":`${IMG}/tradovate-news-notifications-4.png`,"alt":"Ajustes de notificaciones de Tradovate con el interruptor del ticker, order notifications y el botón Advanced Configuration"} },
      ],
    },
    { type: "heading",text: "Referencia rápida: qué hace cada interruptor" },
    { type: "table", headers: ["Ajuste","Qué controla"], rows: [
      ["Notificaciones de noticias","Activa o desactiva las ventanas emergentes de noticias en toda la plataforma. Es el que evita que las noticias tapen su DOM."],
      ["Notification Ticker","Muestra u oculta la barra superior con el reloj y los mensajes de estado desplazables."],
      ["Order Notifications","Activa o desactiva las alertas de eventos de órdenes como ejecuciones, órdenes activas y rechazos."],
      ["Advanced Configuration","Control por estado, notificaciones push y sonidos de audio que puede probar y personalizar."],
    ] },
    { type: "heading",text: "Un par de cosas a tener en cuenta" },
    { type: "paragraph",html: "Las etiquetas y el diseño cambian entre actualizaciones de la plataforma, así que si un interruptor no está exactamente donde lo indica esta guía, revise la sección Notifications actual en su versión; la agrupación es la misma aunque cambie el texto. En el móvil, los controles de notificaciones están en los ajustes propios de la aplicación y no en la página web de Preferences, por lo que debe gestionar allí las alertas del teléfono. Y si opera una cuenta de prop firm o de evaluación, parte del comportamiento de las notificaciones puede estar definido por la firma y no por usted; consulte las reglas vigentes de su firma si un interruptor no se mantiene." },
    { type: "heading",text: "Mantenga su automatización en marcha mientras las alertas siguen en silencio" },
    { type: "paragraph",html: "Desactivar las ventanas emergentes de noticias deja la pantalla más limpia, pero no ejecuta sus operaciones por usted. Ahí es donde entra PickMyTrade: conecta sus alertas de TradingView directamente con su cuenta de Tradovate para que las órdenes se disparen automáticamente, haya o no alguna notificación activa. Un espacio de trabajo tranquilo y ninguna entrada perdida." },
  ], fr: [
    { type: "paragraph",html: "Ces fenêtres d'actualités ont la fâcheuse habitude d'apparaître au pire moment, en glissant par-dessus votre DOM juste au moment où vous allez cliquer. La bonne nouvelle : vous n'avez pas à les subir. Tradovate permet de désactiver complètement les notifications d'actualités, et vous pouvez en profiter pour affiner le reste de la barre de notifications. Voici exactement où se trouve l'interrupteur et comment le basculer." },
    { type: "heading",text: "Ce que signifient réellement les « News Notifications » dans Tradovate" },
    { type: "paragraph",html: "Tradovate affiche deux éléments différents que l'on regroupe souvent sous le terme « actualités ». Il y a le petit badge de notification rouge, dont la plupart des traders s'accommodent, puis il y a la fenêtre d'actualités qui s'invite dans l'espace de travail et peut masquer des boutons de trading ou l'échelle. Tradovate a ajouté un paramètre dédié pour désactiver les notifications d'actualités afin que ces fenêtres cessent de vous interrompre, sans supprimer vos alertes d'ordres. Ce contrôle se trouve dans la zone Notifications de vos préférences depuis la version de plateforme 1.210319.0." },
    { type: "paragraph",html: "Par ailleurs, il existe le <strong class='text-white'>Notification Ticker</strong>, la fine barre en haut de l'application web qui affiche une horloge et fait défiler les messages d'état de vos ordres. C'est un interrupteur à part : vous pouvez donc désactiver les actualités tout en conservant les alertes d'ordres, ou masquer entièrement le ticker pour un bord supérieur plus épuré." },
    { type: "heading",text: "Comment activer ou désactiver les notifications d'actualités de Tradovate" },
    {
      type: "steps",
      items: [
        { title: "Ouvrir Application Settings", html: "Connectez-vous à l'application web Tradovate et cliquez sur le bouton <strong class='text-white'>Application Settings</strong> dans le coin supérieur droit de l'écran. C'est la porte d'entrée vers toutes les préférences de la plateforme, pas seulement les notifications.", image: {"src":`${IMG}/tradovate-news-notifications-1.png`,"alt":"Coin supérieur droit de l'application web Tradovate avec le bouton Application Settings mis en évidence"} },
        { title: "Ouvrir l'onglet Preferences et trouver Notifications", html: "Sélectionnez l'onglet <strong class='text-white'>Preferences</strong> en haut de la page de paramètres, puis faites défiler jusqu'à la section <strong class='text-white'>Notifications</strong>. Tout ce dont vous avez besoin, l'interrupteur des actualités, les order notifications et la commande du ticker, y est regroupé.", image: {"src":`${IMG}/tradovate-news-notifications-2.png`,"alt":"Onglet Preferences de Tradovate défilé jusqu'à la section Notifications"} },
        { title: "Activer ou désactiver les notifications d'actualités", html: "Dans la section Notifications, repérez l'interrupteur des notifications d'actualités et placez-le sur <strong class='text-white'>off</strong> pour arrêter les fenêtres, ou sur <strong class='text-white'>on</strong> si vous souhaitez les retrouver. La modification prend effet immédiatement ; vous pouvez donc retourner à vos graphiques sans rien redémarrer.", image: {"src":`${IMG}/tradovate-news-notifications-3.png`,"alt":"Section Notifications de Tradovate avec l'interrupteur des notifications d'actualités désactivé"} },
        { title: "Affiner le ticker et les alertes d'ordres", html: "Pendant que vous y êtes, autant régler le reste selon vos goûts. Basculez le <strong class='text-white'>Notification Ticker</strong> pour masquer ou afficher la barre supérieure avec l'horloge et les messages défilants. Basculez <strong class='text-white'>Order Notifications</strong> si vous voulez aussi faire taire les exécutions et les rejets. Et ouvrez <strong class='text-white'>Advanced Configuration</strong> pour aller plus loin : vous pouvez activer ou désactiver les alertes pour chaque statut d'ordre, gérer les notifications push et choisir parmi une bibliothèque de sons audio que vous pouvez tester avant de vous engager.", image: {"src":`${IMG}/tradovate-news-notifications-4.png`,"alt":"Paramètres de notification Tradovate montrant l'interrupteur du ticker, les order notifications et le bouton Advanced Configuration"} },
      ],
    },
    { type: "heading",text: "Référence rapide : quel interrupteur fait quoi" },
    { type: "table", headers: ["Paramètre","Ce qu'il contrôle"], rows: [
      ["Notifications d'actualités","Active ou désactive les fenêtres d'actualités sur l'ensemble de la plateforme. C'est celui qui empêche les actualités de masquer votre DOM."],
      ["Notification Ticker","Affiche ou masque la barre supérieure avec l'horloge et les messages d'état défilants."],
      ["Order Notifications","Active ou désactive les alertes pour les événements d'ordre comme les exécutions, les ordres en attente et les rejets."],
      ["Advanced Configuration","Contrôle par statut, notifications push et sons audio que vous pouvez tester et personnaliser."],
    ] },
    { type: "heading",text: "Quelques points à garder à l'esprit" },
    { type: "paragraph",html: "Les libellés et la disposition évoluent d'une mise à jour de la plateforme à l'autre ; si un interrupteur ne se trouve pas exactement là où ce guide l'indique, consultez la section Notifications actuelle de votre version, le regroupement reste le même même si la formulation change. Sur mobile, les commandes de notification se trouvent dans les paramètres propres à l'application plutôt que dans la page web Preferences ; gérez donc vos alertes de téléphone à cet endroit. Et si vous tradez un compte de prop firm ou d'évaluation, une partie du comportement des notifications peut être définie par la société plutôt que par vous ; consultez les règles actuelles de votre société si un interrupteur ne reste pas en place." },
    { type: "heading",text: "Gardez votre automatisation active tandis que les alertes restent silencieuses" },
    { type: "paragraph",html: "Désactiver les fenêtres d'actualités désencombre l'écran, mais cela ne passe pas vos trades à votre place. C'est là que PickMyTrade intervient : il relie vos alertes TradingView directement à votre compte Tradovate pour que les ordres se déclenchent automatiquement, qu'une seule notification soit active ou non. Un espace de travail silencieux, aucune entrée manquée." },
  ], it: [
    { type: "paragraph",html: "Quei popup delle notizie hanno la brutta abitudine di comparire nel momento peggiore, scivolando sul Suo DOM proprio quando sta per cliccare. La buona notizia è che non deve sopportarli. Tradovate permette di disattivare completamente le notifiche delle notizie e, già che c'è, può regolare con precisione il resto della barra delle notifiche. Ecco esattamente dove si trova l'interruttore e come cambiarlo." },
    { type: "heading",text: "Che cosa significano davvero le «News Notifications» in Tradovate" },
    { type: "paragraph",html: "Tradovate mostra due elementi diversi che molti raggruppano sotto la voce «notizie». C'è il piccolo badge rosso di notifica, con cui la maggior parte dei trader non ha problemi, e poi c'è il popup delle notizie che si insinua nello spazio di lavoro e può coprire i pulsanti di trading o la ladder. Tradovate ha aggiunto un'impostazione dedicata per disattivare le notifiche delle notizie, così che i popup non La interrompano più, senza eliminare i Suoi alert degli ordini. Questo controllo si trova nell'area Notifications delle preferenze a partire dal rilascio della piattaforma 1.210319.0." },
    { type: "paragraph",html: "Separatamente, esiste il <strong class='text-white'>Notification Ticker</strong>, la sottile barra in alto nell'app web che mostra un orologio e fa scorrere i messaggi di stato dei Suoi ordini. È un interruttore a sé: può quindi tenere disattivate le notizie e lasciare attivi gli alert degli ordini, oppure nascondere l'intero ticker per un bordo superiore più pulito." },
    { type: "heading",text: "Come attivare o disattivare le notifiche delle notizie di Tradovate" },
    {
      type: "steps",
      items: [
        { title: "Apra Application Settings", html: "Acceda all'app web di Tradovate e faccia clic sul pulsante <strong class='text-white'>Application Settings</strong> nell'angolo in alto a destra dello schermo. È la porta d'ingresso a tutte le preferenze della piattaforma, non solo alle notifiche.", image: {"src":`${IMG}/tradovate-news-notifications-1.png`,"alt":"Angolo in alto a destra dell'app web di Tradovate con il pulsante Application Settings evidenziato"} },
        { title: "Apra la scheda Preferences e trovi Notifications", html: "Selezioni la scheda <strong class='text-white'>Preferences</strong> nella parte superiore della pagina delle impostazioni, quindi scorra fino alla sezione <strong class='text-white'>Notifications</strong>. Tutto ciò che Le serve, l'interruttore delle notizie, le order notifications e il controllo del ticker, è raggruppato qui.", image: {"src":`${IMG}/tradovate-news-notifications-2.png`,"alt":"Scheda Preferences di Tradovate scorsa fino alla sezione Notifications"} },
        { title: "Attivi o disattivi le notifiche delle notizie", html: "Nella sezione Notifications, trovi l'interruttore delle notifiche delle notizie e lo porti su <strong class='text-white'>off</strong> per fermare i popup, oppure su <strong class='text-white'>on</strong> se desidera riaverli. La modifica ha effetto subito, quindi può tornare ai Suoi grafici senza riavviare nulla.", image: {"src":`${IMG}/tradovate-news-notifications-3.png`,"alt":"Sezione Notifications di Tradovate con l'interruttore delle notifiche delle notizie disattivato"} },
        { title: "Regoli il ticker e gli alert degli ordini", html: "Già che è qui, vale la pena impostare il resto a proprio gusto. Attivi o disattivi il <strong class='text-white'>Notification Ticker</strong> per nascondere o mostrare la barra superiore con l'orologio e i messaggi scorrevoli. Agisca su <strong class='text-white'>Order Notifications</strong> se desidera silenziare anche esecuzioni e rifiuti. E apra <strong class='text-white'>Advanced Configuration</strong> per andare più a fondo: può attivare o disattivare gli alert per ogni singolo stato dell'ordine, gestire le notifiche push e scegliere da una libreria di suoni audio che può provare prima di confermare.", image: {"src":`${IMG}/tradovate-news-notifications-4.png`,"alt":"Impostazioni di notifica di Tradovate con l'interruttore del ticker, le order notifications e il pulsante Advanced Configuration"} },
      ],
    },
    { type: "heading",text: "Riferimento rapido: quale interruttore fa cosa" },
    { type: "table", headers: ["Impostazione","Che cosa controlla"], rows: [
      ["Notifiche delle notizie","Attiva o disattiva i popup delle notizie su tutta la piattaforma. È quello che impedisce alle notizie di coprire il Suo DOM."],
      ["Notification Ticker","Mostra o nasconde la barra superiore con l'orologio e i messaggi di stato scorrevoli."],
      ["Order Notifications","Abilita o disabilita gli alert per gli eventi degli ordini come esecuzioni, ordini in lavorazione e rifiuti."],
      ["Advanced Configuration","Controllo per singolo stato, notifiche push e suoni audio che può provare e personalizzare."],
    ] },
    { type: "heading",text: "Un paio di cose da tenere presenti" },
    { type: "paragraph",html: "Etichette e layout cambiano tra un aggiornamento e l'altro della piattaforma: se un interruttore non si trova esattamente dove lo indica questa guida, controlli la sezione Notifications attuale nella Sua versione; il raggruppamento resta lo stesso anche quando cambia la dicitura. Su mobile, i controlli delle notifiche si trovano nelle impostazioni dell'app stessa e non nella pagina web Preferences, quindi gestisca lì gli alert del telefono. E se opera con un conto prop firm o di valutazione, parte del comportamento delle notifiche può essere definita dalla società e non da Lei: consulti le regole attuali della Sua società se un interruttore non resta impostato." },
    { type: "heading",text: "Mantenga attiva l'automazione mentre gli alert restano silenziosi" },
    { type: "paragraph",html: "Disattivare i popup delle notizie rende lo schermo più pulito, ma non esegue i trade al posto Suo. È qui che entra in gioco PickMyTrade: collega i Suoi alert di TradingView direttamente al Suo conto Tradovate, così gli ordini partono automaticamente, con o senza notifiche attive. Spazio di lavoro silenzioso, nessun ingresso perso." },
  ] },
  ctaHeading: { en: "Automate Your Tradovate Trades", de: "Automatisieren Sie Ihre Tradovate-Trades", es: "Automatice sus operaciones en Tradovate", fr: "Automatisez vos trades Tradovate", it: "Automatizzi i Suoi trade su Tradovate" },
  ctaText: { en: "Keep the workspace quiet and let PickMyTrade wire your TradingView alerts straight to your Tradovate account.", de: "Halten Sie Ihren Arbeitsbereich ruhig und lassen Sie PickMyTrade Ihre TradingView-Alerts direkt mit Ihrem Tradovate-Konto verbinden.", es: "Mantenga su espacio de trabajo tranquilo y deje que PickMyTrade conecte sus alertas de TradingView directamente con su cuenta de Tradovate.", fr: "Gardez votre espace de travail silencieux et laissez PickMyTrade relier vos alertes TradingView directement à votre compte Tradovate.", it: "Mantenga silenzioso il Suo spazio di lavoro e lasci che PickMyTrade colleghi i Suoi alert di TradingView direttamente al Suo conto Tradovate." },
