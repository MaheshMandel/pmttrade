---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "tradovate-tpo-market-profile";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/how-to/${SLUG}`;

const META_TITLE = "Set Up TPO Market Profile Charts in Tradovate";
const META_DESCRIPTION =
  "Enable Tradovate's TPO market profile chart type and set up profiles, point of control, value area, session times, and autofit the right way.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "TPO-Market-Profile-Charts in Tradovate einrichten", es: "Configure gráficos TPO Market Profile en Tradovate", fr: "Configurer des graphiques TPO Market Profile dans Tradovate", it: "Configurare i grafici TPO Market Profile in Tradovate" },
  dek: { en: "A TPO chart shows you where price spent its time, not only where it went. Tradovate builds this straight into its charts, so there's nothing to buy or license separately.", de: "Ein TPO-Chart zeigt Ihnen, wo der Kurs seine Zeit verbracht hat, nicht nur, wohin er gelaufen ist. Tradovate bringt das direkt in seine Charts mit, sodass nichts separat gekauft oder lizenziert werden muss.", es: "Un gráfico TPO le muestra dónde pasó el precio su tiempo, no solo adónde fue. Tradovate lo integra directamente en sus gráficos, así que no hay que comprar ni licenciar nada por separado.", fr: "Un graphique TPO vous montre où le prix a passé son temps, et pas seulement où il est allé. Tradovate l'intègre directement à ses graphiques : rien à acheter ni à licencier séparément.", it: "Un grafico TPO Le mostra dove il prezzo ha trascorso il suo tempo, non solo dove è andato. Tradovate lo integra direttamente nei suoi grafici, quindi non c'è nulla da acquistare o da licenziare separatamente." },
  readTime: { en: "6 min read", de: "6 Min. Lesezeit", es: "Lectura de 6 min", fr: "Lecture : 6 min", it: "Lettura di 6 min" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "A TPO chart, Time Price Opportunity, what most people just call a market profile, shows you where price spent its time, not only where it went. If you trade auction theory, the point of control and the value area are the levels you actually watch. Tradovate builds this straight into its charts, so there's no add-on to buy and nothing to license separately. Here's how to flip a chart over to a profile and get it reading the way you want." },
    { type: "paragraph", html: "Quick note: labels and icon positions shift a little between platform updates, so if a menu name below looks slightly different on your screen, grab the closest match rather than assuming the feature moved." },
    { type: "heading", text: "Set Up TPO Market Profile Charts: Step-by-Step" },
    {
      type: "steps",
      items: [
        { title: "Open a Chart and Load Your Symbol", html: "Add a fresh chart to your workspace, use the new-module (plus) icon or the module list, and type in the futures contract you want to study. Stick to the active front-month contract (ES, NQ, CL, GC, whatever you trade). Profiles are only as useful as the data behind them, so you want a liquid, currently-trading symbol." },
        { title: "Switch the Chart Type to TPO", html: "On the chart toolbar, open the chart-type control, it's the icon that shows the current style (candlesticks by default), and choose the TPO / Market Profile option. You can reach the same setting through the chart's gear/settings menu under the price-action style. As soon as it flips, each vertical column of letters or blocks becomes one profile of trading activity." },
        { title: "Choose Letters or Blocks and Set the Size", html: "In the TPO settings, decide how each period draws. Letters (A, B, C&hellip;) each mark a 30-minute slice of the session, which is handy when you want to see <em>when</em> a level printed. Blocks are cleaner if you only care about the shape. Set the TPO size to <strong class='text-white'>Auto</strong> so the profile rescales as you zoom instead of clipping. There's a master color control for the whole profile, and a per-letter-box option if you want each period tinted separately, useful, but you'll be recoloring letters by hand once you turn it on." },
        { title: "Set Up Your Sessions", html: "By default the profile can lump the overnight and regular session into one blob, which hides the story. Split them. Create a regular-hours session and a separate overnight/after-hours session, and give each its own start and stop time plus a starting letter, lowercase letters for the overnight session is an easy visual tell. The start times are fully configurable, so match them to the exchange session for the product you're trading rather than copying someone else's clock. Session hours vary by contract, so confirm them for your instrument." },
        { title: "Turn On Point of Control and the Value Area", html: "This is the part that earns the chart its keep. The <strong class='text-white'>Point of Control (POC)</strong> is the price the market traded at most during the session. Enable it, pick a color, and decide whether it should extend to the right, an untouched POC dragged into the future makes a clean support/resistance line. The <strong class='text-white'>Value Area</strong> is the band around the POC where most of the session's activity happened (the classic market-profile convention is about 70% of it). Set its distance/width, its color, and whether it draws as a shaded highlight or as a bar alongside the profile. If you want the full auction picture, you can layer the Volume Profile on top so time and volume sit on the same chart." },
        { title: "Set Autofit and Save a Template", html: "Profiles get tall fast, so autofit keeps them in frame. Open the chart <strong class='text-white'>Settings</strong> menu and set <strong class='text-white'>Auto-Fit</strong> to <strong class='text-white'>On</strong> (fits the bars and indicators as you zoom and scroll) or <strong class='text-white'>Bars Only</strong> (fits the bars but lets indicators run off-screen); leave it <strong class='text-white'>Off</strong> if you prefer to scale by hand. Either way, you can double-click the price axis anytime to snap the chart back to fit. Once it all looks right, save the whole layout as a template so every new profile chart opens the same way, sessions, colors, POC and all." },
      ],
    },
    { type: "paragraph", html: "That's the whole setup. Give it a session or two of screen time first, profiles read differently from candles, and the edge is in watching how price accepts or rejects the POC and value-area edges." },
    { type: "heading", text: "Automate What Happens at Your Levels" },
    { type: "paragraph", html: "Once your levels are drawn, you don't have to babysit every entry. PickMyTrade can fire your Tradovate orders automatically from TradingView alerts, so when price hits the POC or the edge of value, your trade is already placed." },
  ], de: [
    { type: "paragraph",html: "Ein TPO-Chart, Time Price Opportunity, von den meisten schlicht Market Profile genannt, zeigt Ihnen, wo der Kurs seine Zeit verbracht hat, nicht nur, wohin er gelaufen ist. Wenn Sie nach der Auktionstheorie handeln, sind der Point of Control und die Value Area die Niveaus, die Sie tatsächlich beobachten. Tradovate bringt das direkt in seine Charts mit, es gibt also kein Add-on zu kaufen und nichts separat zu lizenzieren. So stellen Sie einen Chart auf ein Profil um und bringen ihn dazu, so zu lesen, wie Sie es möchten." },
    { type: "paragraph",html: "Kurzer Hinweis: Beschriftungen und Symbolpositionen verschieben sich zwischen Plattform-Updates ein wenig. Wenn ein Menüname unten auf Ihrem Bildschirm leicht anders aussieht, nehmen Sie die ähnlichste Entsprechung, statt anzunehmen, dass die Funktion verschwunden ist." },
    { type: "heading",text: "TPO-Market-Profile-Charts einrichten: Schritt für Schritt" },
    {
      type: "steps",
      items: [
        { title: "Chart öffnen und Ihr Symbol laden", html: "Fügen Sie Ihrem Workspace einen neuen Chart hinzu, über das Symbol für neue Module (Plus) oder die Modulliste, und geben Sie den Futures-Kontrakt ein, den Sie untersuchen möchten. Bleiben Sie beim aktiven Front-Month-Kontrakt (ES, NQ, CL, GC, was immer Sie handeln). Profile sind nur so nützlich wie die Daten dahinter, daher brauchen Sie ein liquides, aktuell gehandeltes Symbol." },
        { title: "Den Charttyp auf TPO umstellen", html: "Öffnen Sie in der Chart-Symbolleiste die Charttyp-Steuerung, das Symbol, das den aktuellen Stil zeigt (standardmäßig Kerzen), und wählen Sie die Option TPO / Market Profile. Dieselbe Einstellung erreichen Sie auch über das Zahnrad-/Einstellungsmenü des Charts unter dem Preisaktions-Stil. Sobald er umspringt, wird jede vertikale Spalte aus Buchstaben oder Blöcken zu einem Profil der Handelsaktivität." },
        { title: "Buchstaben oder Blöcke wählen und die Größe festlegen", html: "Entscheiden Sie in den TPO-Einstellungen, wie jede Periode gezeichnet wird. Buchstaben (A, B, C&hellip;) markieren jeweils einen 30-Minuten-Abschnitt der Session, praktisch, wenn Sie sehen möchten, <em>wann</em> ein Niveau entstanden ist. Blöcke sind klarer, wenn es Ihnen nur um die Form geht. Stellen Sie die TPO-Größe auf <strong class='text-white'>Auto</strong>, damit das Profil beim Zoomen neu skaliert, statt abgeschnitten zu werden. Es gibt eine Hauptfarbsteuerung für das gesamte Profil und eine Option pro Buchstabenfeld, wenn Sie jede Periode separat einfärben möchten. Das ist nützlich, aber Sie werden die Buchstaben von Hand umfärben müssen, sobald Sie sie einschalten." },
        { title: "Ihre Sessions einrichten", html: "Standardmäßig kann das Profil die Overnight- und die reguläre Session zu einem Klumpen zusammenfassen, was die Geschichte verdeckt. Trennen Sie sie. Legen Sie eine Session für die regulären Handelszeiten und eine separate Overnight-/Nachbörsen-Session an und geben Sie jeder eine eigene Start- und Endzeit sowie einen Anfangsbuchstaben; Kleinbuchstaben für die Overnight-Session sind ein einfaches visuelles Erkennungsmerkmal. Die Startzeiten sind frei konfigurierbar, passen Sie sie also an die Börsensession des Produkts an, das Sie handeln, statt die Uhrzeiten eines anderen zu übernehmen. Die Sessionzeiten variieren je nach Kontrakt, prüfen Sie sie daher für Ihr Instrument." },
        { title: "Point of Control und Value Area einschalten", html: "Das ist der Teil, der den Chart seinen Wert verdienen lässt. Der <strong class='text-white'>Point of Control (POC)</strong> ist der Preis, zu dem der Markt während der Session am meisten gehandelt hat. Aktivieren Sie ihn, wählen Sie eine Farbe und entscheiden Sie, ob er nach rechts verlängert werden soll; ein unberührter POC, in die Zukunft gezogen, ergibt eine saubere Unterstützungs-/Widerstandslinie. Die <strong class='text-white'>Value Area</strong> ist das Band um den POC, in dem der Großteil der Sessionaktivität stattfand (die klassische Market-Profile-Konvention liegt bei etwa 70% davon). Legen Sie ihren Abstand bzw. ihre Breite, ihre Farbe fest und ob sie als schattierte Hervorhebung oder als Balken neben dem Profil gezeichnet wird. Wenn Sie das vollständige Auktionsbild möchten, können Sie das Volume Profile darüberlegen, sodass Zeit und Volumen im selben Chart stehen." },
        { title: "Autofit einstellen und eine Vorlage speichern", html: "Profile werden schnell hoch, daher hält Autofit sie im Bild. Öffnen Sie das <strong class='text-white'>Settings</strong>-Menü des Charts und stellen Sie <strong class='text-white'>Auto-Fit</strong> auf <strong class='text-white'>On</strong> (passt die Balken und Indikatoren beim Zoomen und Scrollen an) oder <strong class='text-white'>Bars Only</strong> (passt die Balken an, lässt Indikatoren aber aus dem Bild laufen); lassen Sie es auf <strong class='text-white'>Off</strong>, wenn Sie lieber von Hand skalieren. In jedem Fall können Sie jederzeit auf die Preisachse doppelklicken, um den Chart wieder einzupassen. Wenn alles passt, speichern Sie das gesamte Layout als Vorlage, damit jeder neue Profil-Chart genauso geöffnet wird, mit Sessions, Farben, POC und allem." },
      ],
    },
    { type: "paragraph",html: "Das ist die ganze Einrichtung. Gönnen Sie sich zunächst ein bis zwei Sessions Bildschirmzeit, denn Profile lesen sich anders als Kerzen, und der Vorteil liegt darin, zu beobachten, wie der Kurs den POC und die Ränder der Value Area annimmt oder ablehnt." },
    { type: "heading",text: "Automatisieren Sie, was an Ihren Niveaus passiert" },
    { type: "paragraph",html: "Sobald Ihre Niveaus eingezeichnet sind, müssen Sie nicht jeden Einstieg überwachen. PickMyTrade kann Ihre Tradovate-Orders automatisch aus TradingView-Alerts auslösen, sodass Ihr Trade bereits platziert ist, wenn der Kurs den POC oder den Rand der Value Area erreicht." },
  ], es: [
    { type: "paragraph",html: "Un gráfico TPO, Time Price Opportunity, lo que la mayoría llama simplemente market profile, le muestra dónde pasó el precio su tiempo, no solo adónde fue. Si opera con teoría de la subasta, el punto de control y el área de valor son los niveles que realmente vigila. Tradovate lo integra directamente en sus gráficos, así que no hay ningún complemento que comprar ni nada que licenciar por separado. Así puede convertir un gráfico en un perfil y hacer que se lea como usted quiere." },
    { type: "paragraph",html: "Una nota rápida: las etiquetas y las posiciones de los iconos cambian un poco entre actualizaciones de la plataforma, así que si el nombre de un menú que aparece abajo se ve ligeramente distinto en su pantalla, elija la opción más parecida en lugar de suponer que la función se ha movido." },
    { type: "heading",text: "Configure gráficos TPO Market Profile: paso a paso" },
    {
      type: "steps",
      items: [
        { title: "Abra un gráfico y cargue su símbolo", html: "Añada un gráfico nuevo a su espacio de trabajo, con el icono de nuevo módulo (más) o la lista de módulos, e introduzca el contrato de futuros que quiere estudiar. Quédese con el contrato activo del mes frontal (ES, NQ, CL, GC, el que opere). Los perfiles son tan útiles como los datos que hay detrás, así que necesita un símbolo líquido y que se esté negociando actualmente." },
        { title: "Cambie el tipo de gráfico a TPO", html: "En la barra de herramientas del gráfico, abra el control de tipo de gráfico, el icono que muestra el estilo actual (velas japonesas por defecto), y elija la opción TPO / Market Profile. Puede llegar al mismo ajuste desde el menú de engranaje/ajustes del gráfico, en el estilo de acción del precio. En cuanto cambia, cada columna vertical de letras o bloques se convierte en un perfil de la actividad de negociación." },
        { title: "Elija letras o bloques y establezca el tamaño", html: "En los ajustes de TPO, decida cómo se dibuja cada periodo. Las letras (A, B, C&hellip;) marcan cada una un tramo de 30 minutos de la sesión, útil si quiere ver <em>cuándo</em> se imprimió un nivel. Los bloques son más limpios si solo le importa la forma. Establezca el tamaño TPO en <strong class='text-white'>Auto</strong> para que el perfil se reescale al hacer zoom en lugar de recortarse. Hay un control de color maestro para todo el perfil y una opción por cuadro de letra si quiere teñir cada periodo por separado; es útil, pero tendrá que recolorear las letras a mano una vez que la active." },
        { title: "Configure sus sesiones", html: "Por defecto, el perfil puede juntar la sesión nocturna y la sesión regular en una sola mancha, lo que oculta la historia. Sepárelas. Cree una sesión de horario regular y una sesión nocturna/fuera de horario aparte, y dé a cada una su propia hora de inicio y fin y una letra inicial; las letras minúsculas para la sesión nocturna son una pista visual fácil. Las horas de inicio son totalmente configurables, así que ajústelas a la sesión del mercado del producto que opera en lugar de copiar el horario de otra persona. Los horarios de sesión varían según el contrato, así que confírmelos para su instrumento." },
        { title: "Active el punto de control y el área de valor", html: "Esta es la parte que justifica el gráfico. El <strong class='text-white'>Point of Control (POC)</strong> es el precio al que más negoció el mercado durante la sesión. Actívelo, elija un color y decida si debe extenderse a la derecha; un POC sin tocar prolongado hacia el futuro crea una línea limpia de soporte/resistencia. El <strong class='text-white'>Value Area</strong> es la banda alrededor del POC donde ocurrió la mayor parte de la actividad de la sesión (la convención clásica del market profile es aproximadamente el 70% de ella). Establezca su distancia/anchura, su color y si se dibuja como un resaltado sombreado o como una barra junto al perfil. Si quiere la imagen completa de la subasta, puede superponer el Volume Profile para que tiempo y volumen convivan en el mismo gráfico." },
        { title: "Configure el autoajuste y guarde una plantilla", html: "Los perfiles crecen rápido en altura, así que el autoajuste los mantiene a la vista. Abra el menú <strong class='text-white'>Settings</strong> del gráfico y establezca <strong class='text-white'>Auto-Fit</strong> en <strong class='text-white'>On</strong> (ajusta las barras y los indicadores al hacer zoom y desplazarse) o <strong class='text-white'>Bars Only</strong> (ajusta las barras pero deja que los indicadores salgan de la pantalla); déjelo en <strong class='text-white'>Off</strong> si prefiere escalar a mano. En cualquier caso, puede hacer doble clic en el eje de precios en cualquier momento para reajustar el gráfico. Cuando todo se vea bien, guarde todo el diseño como plantilla para que cada nuevo gráfico de perfil se abra igual, con sesiones, colores, POC y todo." },
      ],
    },
    { type: "paragraph",html: "Eso es toda la configuración. Dedíquele primero una o dos sesiones de pantalla: los perfiles se leen de forma distinta a las velas, y la ventaja está en observar cómo el precio acepta o rechaza el POC y los bordes del área de valor." },
    { type: "heading",text: "Automatice lo que ocurre en sus niveles" },
    { type: "paragraph",html: "Una vez dibujados sus niveles, no tiene que vigilar cada entrada. PickMyTrade puede disparar sus órdenes de Tradovate automáticamente desde alertas de TradingView, de modo que cuando el precio llegue al POC o al borde del valor, su operación ya esté colocada." },
  ], fr: [
    { type: "paragraph",html: "Un graphique TPO, Time Price Opportunity, que la plupart appellent simplement market profile, vous montre où le prix a passé son temps, et pas seulement où il est allé. Si vous tradez selon la théorie des enchères, le point de contrôle et la zone de valeur sont les niveaux que vous surveillez réellement. Tradovate l'intègre directement à ses graphiques : il n'y a aucun module complémentaire à acheter ni rien à licencier séparément. Voici comment basculer un graphique en profil et lui faire afficher les données comme vous le souhaitez." },
    { type: "paragraph",html: "Petite précision : les libellés et la position des icônes changent un peu d'une mise à jour de la plateforme à l'autre ; si le nom d'un menu ci-dessous semble légèrement différent sur votre écran, choisissez l'équivalent le plus proche plutôt que de supposer que la fonction a disparu." },
    { type: "heading",text: "Configurer des graphiques TPO Market Profile : pas à pas" },
    {
      type: "steps",
      items: [
        { title: "Ouvrez un graphique et chargez votre symbole", html: "Ajoutez un nouveau graphique à votre espace de travail, avec l'icône de nouveau module (plus) ou la liste des modules, et saisissez le contrat à terme que vous voulez étudier. Restez sur le contrat actif du mois en cours (ES, NQ, CL, GC, ce que vous tradez). Les profils ne valent que par les données qui les alimentent : il vous faut donc un symbole liquide et actuellement négocié." },
        { title: "Basculez le type de graphique sur TPO", html: "Dans la barre d'outils du graphique, ouvrez la commande de type de graphique, l'icône qui affiche le style actuel (chandeliers par défaut), et choisissez l'option TPO / Market Profile. Vous pouvez atteindre le même réglage via le menu engrenage/paramètres du graphique, sous le style d'action des prix. Dès qu'il bascule, chaque colonne verticale de lettres ou de blocs devient un profil de l'activité de trading." },
        { title: "Choisissez lettres ou blocs et réglez la taille", html: "Dans les paramètres TPO, décidez comment chaque période est dessinée. Les lettres (A, B, C&hellip;) marquent chacune une tranche de 30 minutes de la séance, pratique si vous voulez voir <em>quand</em> un niveau s'est formé. Les blocs sont plus nets si seule la forme vous intéresse. Réglez la taille TPO sur <strong class='text-white'>Auto</strong> pour que le profil se redimensionne quand vous zoomez au lieu d'être tronqué. Il existe une commande de couleur principale pour l'ensemble du profil et une option par case de lettre si vous voulez teinter chaque période séparément ; c'est utile, mais vous devrez recolorer les lettres à la main une fois l'option activée." },
        { title: "Configurez vos séances", html: "Par défaut, le profil peut fusionner la séance nocturne et la séance régulière en un seul bloc, ce qui masque l'histoire. Séparez-les. Créez une séance en heures régulières et une séance nocturne/hors séance distincte, et donnez à chacune ses propres heures de début et de fin ainsi qu'une lettre de départ ; des lettres minuscules pour la séance nocturne constituent un repère visuel facile. Les heures de début sont entièrement configurables : alignez-les sur la séance de l'exchange du produit que vous tradez plutôt que de copier l'horloge de quelqu'un d'autre. Les horaires de séance varient selon le contrat ; vérifiez-les donc pour votre instrument." },
        { title: "Activez le point de contrôle et la zone de valeur", html: "C'est la partie qui justifie le graphique. Le <strong class='text-white'>Point of Control (POC)</strong> est le prix auquel le marché a le plus négocié pendant la séance. Activez-le, choisissez une couleur et décidez s'il doit se prolonger vers la droite ; un POC non touché prolongé dans le futur forme une ligne de support/résistance nette. La <strong class='text-white'>Value Area</strong> est la bande autour du POC où s'est concentrée l'essentiel de l'activité de la séance (la convention classique du market profile est d'environ 70% de celle-ci). Réglez sa distance/largeur, sa couleur et si elle s'affiche en surbrillance ombrée ou en barre le long du profil. Si vous voulez l'image complète des enchères, vous pouvez superposer le Volume Profile afin que le temps et le volume figurent sur le même graphique." },
        { title: "Réglez l'ajustement automatique et enregistrez un modèle", html: "Les profils deviennent vite hauts ; l'ajustement automatique les garde donc dans le cadre. Ouvrez le menu <strong class='text-white'>Settings</strong> du graphique et réglez <strong class='text-white'>Auto-Fit</strong> sur <strong class='text-white'>On</strong> (ajuste les barres et les indicateurs quand vous zoomez et faites défiler) ou <strong class='text-white'>Bars Only</strong> (ajuste les barres mais laisse les indicateurs sortir de l'écran) ; laissez-le sur <strong class='text-white'>Off</strong> si vous préférez mettre à l'échelle à la main. Dans tous les cas, vous pouvez double-cliquer sur l'axe des prix à tout moment pour réajuster le graphique. Une fois que tout vous convient, enregistrez l'ensemble de la mise en page comme modèle afin que chaque nouveau graphique de profil s'ouvre de la même façon, avec séances, couleurs, POC et le reste." },
      ],
    },
    { type: "paragraph",html: "C'est toute la configuration. Passez d'abord une séance ou deux devant l'écran : les profils se lisent différemment des chandeliers, et l'avantage se trouve dans l'observation de la façon dont le prix accepte ou rejette le POC et les bords de la zone de valeur." },
    { type: "heading",text: "Automatisez ce qui se passe à vos niveaux" },
    { type: "paragraph",html: "Une fois vos niveaux tracés, vous n'avez pas à surveiller chaque entrée. PickMyTrade peut déclencher automatiquement vos ordres Tradovate à partir des alertes TradingView : lorsque le prix atteint le POC ou le bord de la valeur, votre trade est déjà placé." },
  ], it: [
    { type: "paragraph",html: "Un grafico TPO, Time Price Opportunity, quello che la maggior parte chiama semplicemente market profile, Le mostra dove il prezzo ha trascorso il suo tempo, non solo dove è andato. Se opera secondo la teoria dell'asta, il punto di controllo e l'area di valore sono i livelli che osserva davvero. Tradovate lo integra direttamente nei suoi grafici, quindi non c'è alcun componente aggiuntivo da acquistare e nulla da licenziare separatamente. Ecco come trasformare un grafico in un profilo e fargli leggere i dati come desidera." },
    { type: "paragraph",html: "Una nota veloce: le etichette e la posizione delle icone cambiano leggermente tra un aggiornamento e l'altro della piattaforma, quindi se il nome di un menu qui sotto Le sembra un po' diverso sullo schermo, scelga la voce più simile invece di pensare che la funzione sia stata spostata." },
    { type: "heading",text: "Configurare i grafici TPO Market Profile: passo dopo passo" },
    {
      type: "steps",
      items: [
        { title: "Apra un grafico e carichi il simbolo", html: "Aggiunga un nuovo grafico al Suo workspace, con l'icona del nuovo modulo (più) o l'elenco dei moduli, e digiti il contratto future che desidera studiare. Si attenga al contratto attivo front-month (ES, NQ, CL, GC, ciò che opera). I profili sono utili quanto i dati che hanno alle spalle, quindi Le serve un simbolo liquido e attualmente negoziato." },
        { title: "Cambi il tipo di grafico in TPO", html: "Nella barra degli strumenti del grafico, apra il controllo del tipo di grafico, l'icona che mostra lo stile corrente (candele per impostazione predefinita), e scelga l'opzione TPO / Market Profile. Può raggiungere la stessa impostazione dal menu a ingranaggio/impostazioni del grafico, sotto lo stile dell'azione di prezzo. Non appena cambia, ogni colonna verticale di lettere o blocchi diventa un profilo dell'attività di trading." },
        { title: "Scelga lettere o blocchi e imposti la dimensione", html: "Nelle impostazioni TPO, decida come viene disegnato ogni periodo. Le lettere (A, B, C&hellip;) segnano ciascuna una fetta di 30 minuti della sessione, utile se vuole vedere <em>quando</em> si è formato un livello. I blocchi sono più puliti se Le interessa solo la forma. Imposti la dimensione TPO su <strong class='text-white'>Auto</strong> in modo che il profilo si riscali durante lo zoom invece di essere tagliato. C'è un controllo del colore principale per l'intero profilo e un'opzione per ogni riquadro di lettera se desidera colorare ogni periodo separatamente; è utile, ma dovrà ricolorare le lettere a mano una volta attivata." },
        { title: "Configuri le sessioni", html: "Per impostazione predefinita, il profilo può fondere la sessione notturna e quella regolare in un unico blocco, il che nasconde la storia. Le separi. Crei una sessione in orario regolare e una sessione notturna/after-hours distinta, e assegni a ciascuna il proprio orario di inizio e fine più una lettera iniziale; le lettere minuscole per la sessione notturna sono un facile indicatore visivo. Gli orari di inizio sono completamente configurabili, quindi li faccia corrispondere alla sessione di borsa del prodotto che opera invece di copiare l'orario di qualcun altro. Gli orari di sessione variano in base al contratto, quindi li verifichi per il Suo strumento." },
        { title: "Attivi il Point of Control e l'area di valore", html: "Questa è la parte che giustifica il grafico. Il <strong class='text-white'>Point of Control (POC)</strong> è il prezzo al quale il mercato ha scambiato di più durante la sessione. Lo attivi, scelga un colore e decida se debba estendersi a destra; un POC non toccato prolungato nel futuro crea una pulita linea di supporto/resistenza. La <strong class='text-white'>Value Area</strong> è la fascia attorno al POC in cui si è concentrata la maggior parte dell'attività della sessione (la convenzione classica del market profile è circa il 70% di essa). Imposti la distanza/larghezza, il colore e se venga disegnata come evidenziazione ombreggiata o come barra accanto al profilo. Se desidera il quadro completo dell'asta, può sovrapporre il Volume Profile in modo che tempo e volume convivano sullo stesso grafico." },
        { title: "Imposti l'adattamento automatico e salvi un template", html: "I profili diventano alti in fretta, quindi l'adattamento automatico li mantiene in vista. Apra il menu <strong class='text-white'>Settings</strong> del grafico e imposti <strong class='text-white'>Auto-Fit</strong> su <strong class='text-white'>On</strong> (adatta le barre e gli indicatori mentre fa zoom e scorre) oppure <strong class='text-white'>Bars Only</strong> (adatta le barre ma lascia che gli indicatori escano dallo schermo); lo lasci su <strong class='text-white'>Off</strong> se preferisce scalare a mano. In ogni caso, può fare doppio clic sull'asse dei prezzi in qualsiasi momento per riportare il grafico in vista. Quando tutto Le sembra giusto, salvi l'intero layout come template, così ogni nuovo grafico di profilo si apre allo stesso modo, con sessioni, colori, POC e tutto il resto." },
      ],
    },
    { type: "paragraph",html: "Questa è tutta la configurazione. Si conceda prima una o due sessioni di tempo davanti allo schermo: i profili si leggono in modo diverso dalle candele, e il vantaggio sta nell'osservare come il prezzo accetta o rifiuta il POC e i bordi dell'area di valore." },
    { type: "heading",text: "Automatizzi ciò che accade ai Suoi livelli" },
    { type: "paragraph",html: "Una volta tracciati i Suoi livelli, non deve sorvegliare ogni ingresso. PickMyTrade può inviare automaticamente i Suoi ordini Tradovate dagli alert di TradingView, così quando il prezzo raggiunge il POC o il bordo del valore, il Suo trade è già stato inserito." },
  ] },
  ctaHeading: { en: "Trade Your Levels Automatically", de: "Handeln Sie Ihre Niveaus automatisch", es: "Opere sus niveles automáticamente", fr: "Tradez vos niveaux automatiquement", it: "Operi sui Suoi livelli in automatico" },
  ctaText: { en: "Once your POC and value-area levels are drawn, let PickMyTrade fire your Tradovate orders automatically from TradingView alerts.", de: "Sobald Ihre POC- und Value-Area-Niveaus eingezeichnet sind, lassen Sie PickMyTrade Ihre Tradovate-Orders automatisch aus TradingView-Alerts auslösen.", es: "Una vez dibujados sus niveles de POC y de área de valor, deje que PickMyTrade dispare sus órdenes de Tradovate automáticamente desde alertas de TradingView.", fr: "Une fois vos niveaux de POC et de zone de valeur tracés, laissez PickMyTrade déclencher automatiquement vos ordres Tradovate à partir des alertes TradingView.", it: "Una volta tracciati i Suoi livelli di POC e di area di valore, lasci che PickMyTrade invii automaticamente i Suoi ordini Tradovate dagli alert di TradingView." },
  ctaButtonText: { en: "Start Your Free 7-Day Trial", de: "Starten Sie Ihre kostenlose 7-Tage-Testphase", es: "Comience su prueba gratuita de 7 días", fr: "Commencez votre essai gratuit de 7 jours", it: "Inizi la prova gratuita di 7 giorni" },
  ctaUrl: "https://app.pickmytrade.trade/?register=true&utm_source=content&utm_medium=how-to",
  faqHeading: { en: "Frequently Asked Questions", de: "Häufig gestellte Fragen", es: "Preguntas frecuentes", fr: "Questions fréquentes", it: "Domande frequenti" },
  faqs: { en: [], de: [], es: [], fr: [], it: [] },
  relatedHeading: { en: "Related Guides", de: "Verwandte Anleitungen", es: "Guías relacionadas", fr: "Guides associés", it: "Guide correlate" },
  disclosureText: { en: `This guide is for educational and informational purposes only and is not financial, investment, or trading advice. Trading futures and other leveraged products carries a substantial risk of loss and is not suitable for every investor. PickMyTrade is an independent third-party automation platform and is not affiliated with, endorsed by, or sponsored by Tradovate, Inc. "Tradovate" and all related names, logos, and trademarks are the property of their respective owners. Platform features and steps change over time, so always confirm the current process in the official Tradovate platform and documentation before acting.`, de: "Diese Anleitung dient ausschließlich Bildungs- und Informationszwecken und stellt keine Finanz-, Anlage- oder Handelsberatung dar. Der Handel mit Futures und anderen gehebelten Produkten birgt ein erhebliches Verlustrisiko und ist nicht für jeden Anleger geeignet. PickMyTrade ist eine unabhängige Automatisierungsplattform eines Drittanbieters und steht in keiner Verbindung zu Tradovate, Inc., wird weder von dieser unterstützt noch gesponsert. „Tradovate“ und alle zugehörigen Namen, Logos und Marken sind Eigentum ihrer jeweiligen Inhaber. Plattformfunktionen und Schritte ändern sich im Laufe der Zeit; bestätigen Sie daher stets den aktuellen Ablauf in der offiziellen Tradovate-Plattform und -Dokumentation, bevor Sie handeln.", es: "Esta guía tiene fines exclusivamente educativos e informativos y no constituye asesoramiento financiero, de inversión ni de trading. Operar con futuros y otros productos apalancados conlleva un riesgo sustancial de pérdida y no es adecuado para todos los inversores. PickMyTrade es una plataforma de automatización independiente de terceros y no está afiliada, respaldada ni patrocinada por Tradovate, Inc. «Tradovate» y todos los nombres, logotipos y marcas relacionados son propiedad de sus respectivos titulares. Las funciones y los pasos de la plataforma cambian con el tiempo, así que confirme siempre el proceso vigente en la plataforma oficial de Tradovate y en su documentación antes de actuar.", fr: "Ce guide est fourni à des fins strictement éducatives et informatives et ne constitue ni un conseil financier, ni un conseil en investissement, ni un conseil de trading. Le trading de contrats à terme et d'autres produits à effet de levier comporte un risque de perte important et ne convient pas à tous les investisseurs. PickMyTrade est une plateforme d'automatisation tierce indépendante, non affiliée à Tradovate, Inc., ni approuvée ou parrainée par cette dernière. « Tradovate » ainsi que tous les noms, logos et marques associés sont la propriété de leurs détenteurs respectifs. Les fonctionnalités et les étapes de la plateforme évoluent avec le temps ; vérifiez donc toujours la procédure en vigueur dans la plateforme officielle Tradovate et dans sa documentation avant d'agir.", it: "Questa guida ha esclusivamente scopo educativo e informativo e non costituisce consulenza finanziaria, di investimento o di trading. Il trading di futures e di altri prodotti a leva comporta un rischio di perdita sostanziale e non è adatto a tutti gli investitori. PickMyTrade è una piattaforma di automazione indipendente di terze parti e non è affiliata, approvata né sponsorizzata da Tradovate, Inc. «Tradovate» e tutti i nomi, loghi e marchi correlati sono di proprietà dei rispettivi titolari. Le funzionalità e i passaggi della piattaforma cambiano nel tempo, quindi verifichi sempre la procedura attuale nella piattaforma ufficiale Tradovate e nella relativa documentazione prima di agire." },
