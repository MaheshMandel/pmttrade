  ctaUrl: "https://app.pickmytrade.trade/?register=true&utm_source=content&utm_medium=how-to",
  faqHeading: { en: "Frequently Asked Questions", de: "Häufig gestellte Fragen", es: "Preguntas frecuentes", fr: "Questions fréquentes", it: "Domande frequenti" },
  faqs: { en: [
    { q: "Do I need a separate account to test on the Tradovate demo API?", a: "No. Your simulation account is enough. Point your requests at the demo host and sign in with your normal Tradovate credentials, the demo environment fills everything with paper money." },
    { q: "Will a demo access token work on the live host?", a: "No. A token is only valid on the environment that issued it. Request one from the demo host for simulation and a fresh one from the live host for a funded account." },
    { q: "What actually changes when I go from demo to live?", a: "Mostly the hostname, demo.tradovateapi.com becomes live.tradovateapi.com, plus a re-authentication against live. Live also enforces device approval and, of course, real fills and margin, so test thoroughly before you switch." },
  ], de: [
    { q: "Brauche ich ein separates Konto, um die Tradovate-Demo-API zu testen?", a: "Nein. Ihr Simulationskonto genügt. Richten Sie Ihre Anfragen an den Demo-Host und melden Sie sich mit Ihren normalen Tradovate-Zugangsdaten an; die Demo-Umgebung wickelt alles mit Spielgeld ab." },
    { q: "Funktioniert ein Demo-Access-Token auch auf dem Live-Host?", a: "Nein. Ein Token ist nur in der Umgebung gültig, die es ausgestellt hat. Fordern Sie für die Simulation eines vom Demo-Host an und für ein Echtgeldkonto ein neues vom Live-Host." },
    { q: "Was ändert sich konkret beim Wechsel von Demo zu Live?", a: "Hauptsächlich der Hostname: Aus demo.tradovateapi.com wird live.tradovateapi.com, dazu kommt eine erneute Authentifizierung am Live-Host. Live erzwingt zudem die Geräte-Freigabe und bringt natürlich echte Fills und Margin mit, testen Sie daher gründlich, bevor Sie umschalten." },
  ], es: [
    { q: "¿Necesito una cuenta aparte para probar la API demo de Tradovate?", a: "No. Su cuenta de simulación es suficiente. Dirija sus solicitudes al host demo e inicie sesión con sus credenciales habituales de Tradovate; el entorno demo lo ejecuta todo con dinero virtual." },
    { q: "¿Funciona un token de acceso demo en el host real?", a: "No. Un token solo es válido en el entorno que lo emitió. Solicite uno al host demo para simulación y uno nuevo al host real para una cuenta con fondos." },
    { q: "¿Qué cambia realmente al pasar de demo a real?", a: "Sobre todo el nombre de host: demo.tradovateapi.com pasa a ser live.tradovateapi.com, además de una nueva autenticación en el entorno real. El entorno real también exige la aprobación del dispositivo y, por supuesto, implica ejecuciones y margen reales, así que pruebe a fondo antes de cambiar." },
