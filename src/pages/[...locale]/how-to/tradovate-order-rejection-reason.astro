---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "tradovate-order-rejection-reason";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/how-to/${SLUG}`;

const META_TITLE = "Find Why a Tradovate Order Was Rejected";
const META_DESCRIPTION =
  "Find the exact reason a futures order was rejected in seconds, then match that message to the right fix so you can place the trade again.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "So finden Sie heraus, warum eine Tradovate-Order abgelehnt wurde", es: "Cómo saber por qué se rechazó una orden en Tradovate", fr: "Comment savoir pourquoi un ordre Tradovate a été rejeté", it: "Come scoprire perché un ordine Tradovate è stato rifiutato" },
  dek: { en: "An order flashes red, nothing fills, and you're left guessing. Don't guess. Tradovate almost always tells you exactly why it bounced an order, you just have to open the right panel to read it.", de: "Eine Order blinkt rot, nichts wird ausgeführt, und Sie rätseln. Raten Sie nicht. Tradovate nennt Ihnen fast immer genau, warum eine Order abgewiesen wurde – Sie müssen nur das richtige Panel öffnen, um es zu lesen.", es: "Una orden parpadea en rojo, nada se ejecuta y usted se queda adivinando. No adivine. Tradovate casi siempre le indica exactamente por qué rechazó una orden; solo tiene que abrir el panel correcto para leerlo.", fr: "Un ordre clignote en rouge, rien n'est exécuté et vous êtes réduit à deviner. Ne devinez pas. Tradovate vous indique presque toujours exactement pourquoi il a rejeté un ordre ; il suffit d'ouvrir le bon panneau pour le lire.", it: "Un ordine lampeggia in rosso, nulla viene eseguito e Lei resta a indovinare. Non indovini. Tradovate quasi sempre Le dice esattamente perché ha rifiutato un ordine; basta aprire il pannello giusto per leggerlo." },
  readTime: { en: "5 min read", de: "5 Min. Lesezeit", es: "Lectura de 5 min", fr: "Lecture : 5 min", it: "Lettura di 5 min" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "An order flashes red, nothing fills, and you're left guessing. Don't guess. Tradovate almost always tells you exactly why it bounced an order, you just have to open the right panel to read it. Here's where that message lives and how to pull it up in seconds, so you fix the real cause instead of firing the same order again." },
    { type: "heading", text: "Where the Rejection Reason Actually Lives" },
    { type: "paragraph", html: "Every order you send lands in the <strong class='text-white'>Orders</strong> module (some accounts label it Order History) with a status next to it: Working, Filled, Canceled, Rejected, and a few others. When something gets knocked back, the status reads <strong class='text-white'>Rejected</strong>, and the plain-English reason is one click away in that order's detail. That's the whole trick. The platform writes the reason for you; most people just never open the order to see it." },
    { type: "heading", text: "Find the Rejection Reason: Step by Step" },
    {
      type: "steps",
      items: [
        { title: "Open the Orders Module", html: "Log in to Tradovate and open the <strong class='text-white'>Orders</strong> module. If it isn't already on your screen, add it from the platform's module or widget menu. This is the running list of every order for the session, each with a status beside it.", image: { src: `${IMG}/tradovate-order-rejection-reason-1.png`, alt: "Tradovate Orders module listing orders with a Status column" } },
        { title: "Find the Rejected Order", html: "Look down the <strong class='text-white'>Status</strong> column for the order marked <strong class='text-white'>Rejected</strong>. If your list is long, open the <strong class='text-white'>View Settings</strong> menu (the cogwheel icon, usually top-right of the module) and turn on <strong class='text-white'>Show Filters</strong>. Then filter by status so only rejected orders show. Match the timestamp and symbol to the trade you were trying to place.", image: { src: `${IMG}/tradovate-order-rejection-reason-2.png`, alt: "Tradovate Orders module filtered to show orders with a Rejected status" } },
        { title: "Open the Order to Read the Reason", html: "Click the rejected order, on the desktop app, double-click it. A detail window pops up, and the rejection reason is written right there. You'll see something concrete like <em>Liquidation Only</em>, <em>Maximum order quantity has been reached</em>, or <em>Contract is about to be expired</em>. That exact wording is your fix list: it names the rule you tripped.", image: { src: `${IMG}/tradovate-order-rejection-reason-3.png`, alt: "Tradovate order detail window showing the specific rejection reason text" } },
        { title: "Can't Find the Order? Use Reports", html: "Cleared the module or logged out already? Open <strong class='text-white'>Reports</strong>, choose <strong class='text-white'>Order Details</strong>, type in the <strong class='text-white'>Order Number</strong>, and hit <strong class='text-white'>Go</strong>. Same rejection reason, pulled from your history instead of the live list. This is also the cleaner way to document a rejection if you need to raise it with your broker or prop firm.", image: { src: `${IMG}/tradovate-order-rejection-reason-4.png`, alt: "Tradovate Reports Order Details lookup with an Order Number field and Go button" } },
      ],
    },
    { type: "heading", text: "Common Reasons and How to Fix Them" },
    { type: "paragraph", html: "Once you've read the message, match it to the cause. These are the ones you'll run into most:" },
    {
      type: "table",
      headers: ["What the message says", "What it means & the fix"],
      rows: [
        ["Liquidation Only", "Your account can only close positions, not open new ones, usually after a daily or max loss limit was hit, or a risk setting flipped. Check your risk settings and, on a funded account, your firm's rules."],
        ["Maximum order quantity has been reached", "The order size is above your account's contract limit. Trade a smaller quantity or raise the position limit. On evaluation and funded accounts the cap varies by firm and account size, check your firm's current rules."],
        ["Liquidation Only. Contract is about to be expired", "You're trying to open on an expiring or continuous symbol (like NQ1!). Roll to the current front-month contract and re-send."],
        ["Market closed / outside trading hours", "The instrument isn't in an active session. Confirm the contract's trading hours and holiday schedule before you order."],
        ["Insufficient margin / not enough money", "Your available margin doesn't cover the order. Reduce size or add funds so free margin meets the requirement."],
        ["Risk parameters / no quote available", "A risk limit is blocking the order, or there's no live price to fill against. Confirm an active market-data feed and review your account risk limits."],
      ],
    },
    { type: "paragraph", html: "If the message names something not on this list, read it literally, Tradovate is specific on purpose. When it points to a firm-level rule, your broker or prop firm is the one who can change it." },
    { type: "heading", text: "Stop Chasing Manual Rejections" },
    { type: "paragraph", html: "Rejections sting most when you're clicking by hand under pressure and the reason scrolls past before you can read it. <strong class='text-white'>PickMyTrade routes your TradingView alerts straight into Tradovate</strong> and reports back the status for each order, so a rejection surfaces clearly instead of vanishing into a busy DOM." },
  ], de: [
    { type: "paragraph",html: "Eine Order blinkt rot, nichts wird ausgeführt, und Sie rätseln. Raten Sie nicht. Tradovate nennt Ihnen fast immer genau, warum eine Order abgewiesen wurde – Sie müssen nur das richtige Panel öffnen, um es zu lesen. Hier erfahren Sie, wo diese Meldung steht und wie Sie sie in Sekunden aufrufen, damit Sie die eigentliche Ursache beheben, statt dieselbe Order erneut abzusenden." },
    { type: "heading",text: "Wo der Ablehnungsgrund tatsächlich steht" },
    { type: "paragraph",html: "Jede Order, die Sie senden, landet im <strong class='text-white'>Orders</strong>-Modul (bei manchen Konten heißt es Order History) mit einem Status daneben: Working, Filled, Canceled, Rejected und einige weitere. Wird eine Order zurückgewiesen, lautet der Status <strong class='text-white'>Rejected</strong>, und der Grund im Klartext ist in den Details dieser Order nur einen Klick entfernt. Das ist der ganze Trick. Die Plattform schreibt Ihnen den Grund auf; die meisten öffnen die Order nur nie, um ihn zu lesen." },
    { type: "heading",text: "Den Ablehnungsgrund finden: Schritt für Schritt" },
    {
      type: "steps",
      items: [
        { title: "Öffnen Sie das Orders-Modul", html: "Melden Sie sich bei Tradovate an und öffnen Sie das Modul <strong class='text-white'>Orders</strong>. Wenn es noch nicht auf Ihrem Bildschirm ist, fügen Sie es über das Modul- oder Widget-Menü der Plattform hinzu. Dies ist die laufende Liste aller Orders der Sitzung, jeweils mit einem Status daneben.", image: {"src":`${IMG}/tradovate-order-rejection-reason-1.png`,"alt":"Tradovate-Orders-Modul mit einer Liste von Orders und einer Status-Spalte"} },
        { title: "Die abgelehnte Order finden", html: "Suchen Sie in der Spalte <strong class='text-white'>Status</strong> nach der Order mit dem Status <strong class='text-white'>Rejected</strong>. Ist Ihre Liste lang, öffnen Sie das Menü <strong class='text-white'>View Settings</strong> (das Zahnrad-Symbol, meist oben rechts im Modul) und aktivieren Sie <strong class='text-white'>Show Filters</strong>. Filtern Sie dann nach Status, damit nur abgelehnte Orders angezeigt werden. Gleichen Sie Zeitstempel und Symbol mit dem Trade ab, den Sie platzieren wollten.", image: {"src":`${IMG}/tradovate-order-rejection-reason-2.png`,"alt":"Tradovate-Orders-Modul, gefiltert auf Orders mit dem Status Rejected"} },
        { title: "Die Order öffnen, um den Grund zu lesen", html: "Klicken Sie auf die abgelehnte Order; in der Desktop-App doppelklicken Sie darauf. Ein Detailfenster erscheint, und der Ablehnungsgrund steht direkt dort. Sie sehen etwas Konkretes wie <em>Liquidation Only</em>, <em>Maximum order quantity has been reached</em> oder <em>Contract is about to be expired</em>. Genau dieser Wortlaut ist Ihre Fehlerliste: Er nennt die Regel, die Sie verletzt haben.", image: {"src":`${IMG}/tradovate-order-rejection-reason-3.png`,"alt":"Tradovate-Order-Detailfenster mit dem konkreten Text des Ablehnungsgrunds"} },
        { title: "Order nicht auffindbar? Nutzen Sie Reports", html: "Haben Sie das Modul schon geleert oder sich abgemeldet? Öffnen Sie <strong class='text-white'>Reports</strong>, wählen Sie <strong class='text-white'>Order Details</strong>, geben Sie die <strong class='text-white'>Order Number</strong> ein und klicken Sie auf <strong class='text-white'>Go</strong>. Sie erhalten denselben Ablehnungsgrund, nur aus Ihrem Verlauf statt aus der Live-Liste. So dokumentieren Sie eine Ablehnung auch sauberer, falls Sie sie bei Ihrem Broker oder Ihrer Prop-Firma melden müssen.", image: {"src":`${IMG}/tradovate-order-rejection-reason-4.png`,"alt":"Tradovate-Reports-Abfrage Order Details mit Feld für die Order Number und Go-Schaltfläche"} },
      ],
    },
    { type: "heading",text: "Häufige Gründe und ihre Lösung" },
    { type: "paragraph",html: "Haben Sie die Meldung gelesen, ordnen Sie sie der Ursache zu. Diese begegnen Ihnen am häufigsten:" },
    { type: "table", headers: ["Was die Meldung sagt","Was sie bedeutet und wie Sie sie beheben"], rows: [
      ["Liquidation Only","Ihr Konto darf nur Positionen schließen, keine neuen eröffnen, meist weil ein tägliches oder maximales Verlustlimit erreicht wurde oder eine Risikoeinstellung umgeschaltet hat. Prüfen Sie Ihre Risikoeinstellungen und bei einem Funded-Konto die Regeln Ihrer Firma."],
      ["Maximum order quantity has been reached","Die Ordergröße liegt über dem Kontraktlimit Ihres Kontos. Handeln Sie eine kleinere Menge oder erhöhen Sie das Positionslimit. Bei Evaluierungs- und Funded-Konten variiert die Obergrenze je nach Firma und Kontogröße; prüfen Sie die aktuellen Regeln Ihrer Firma."],
      ["Liquidation Only. Contract is about to be expired","Sie versuchen, in einem auslaufenden oder fortlaufenden Symbol (wie NQ1!) zu eröffnen. Wechseln Sie auf den aktuellen Front-Month-Kontrakt und senden Sie die Order erneut."],
      ["Markt geschlossen / außerhalb der Handelszeiten","Das Instrument befindet sich nicht in einer aktiven Sitzung. Prüfen Sie vor der Order die Handelszeiten und den Feiertagskalender des Kontrakts."],
      ["Unzureichende Margin / nicht genug Guthaben","Ihre verfügbare Margin deckt die Order nicht ab. Verringern Sie die Größe oder zahlen Sie Geld ein, damit die freie Margin die Anforderung erfüllt."],
      ["Risikoparameter / kein Kurs verfügbar","Ein Risikolimit blockiert die Order, oder es gibt keinen Live-Preis, gegen den ausgeführt werden könnte. Bestätigen Sie einen aktiven Marktdatenfeed und prüfen Sie die Risikolimits Ihres Kontos."],
    ] },
    { type: "paragraph",html: "Nennt die Meldung etwas, das nicht in dieser Liste steht, lesen Sie sie wörtlich – Tradovate ist absichtlich präzise. Verweist sie auf eine Regel der Firma, kann nur Ihr Broker oder Ihre Prop-Firma sie ändern." },
    { type: "heading",text: "Schluss mit der Jagd nach manuellen Ablehnungen" },
    { type: "paragraph",html: "Ablehnungen ärgern am meisten, wenn Sie unter Druck von Hand klicken und der Grund vorbeiscrollt, bevor Sie ihn lesen können. <strong class='text-white'>PickMyTrade leitet Ihre TradingView-Alerts direkt an Tradovate weiter</strong> und meldet den Status jeder Order zurück, sodass eine Ablehnung deutlich sichtbar wird, statt in einem unübersichtlichen DOM zu verschwinden." },
  ], es: [
    { type: "paragraph",html: "Una orden parpadea en rojo, nada se ejecuta y usted se queda adivinando. No adivine. Tradovate casi siempre le indica exactamente por qué rechazó una orden; solo tiene que abrir el panel correcto para leerlo. Aquí le mostramos dónde está ese mensaje y cómo abrirlo en segundos, para que corrija la causa real en lugar de volver a enviar la misma orden." },
    { type: "heading",text: "Dónde está realmente el motivo del rechazo" },
    { type: "paragraph",html: "Cada orden que envía aparece en el módulo <strong class='text-white'>Orders</strong> (algunas cuentas lo llaman Order History) con un estado al lado: Working, Filled, Canceled, Rejected y algunos más. Cuando algo es rechazado, el estado muestra <strong class='text-white'>Rejected</strong> y el motivo en lenguaje claro está a un clic, en el detalle de esa orden. Ese es todo el truco. La plataforma escribe el motivo por usted; la mayoría simplemente nunca abre la orden para verlo." },
    { type: "heading",text: "Cómo encontrar el motivo del rechazo, paso a paso" },
    {
      type: "steps",
      items: [
        { title: "Abra el módulo Orders", html: "Inicie sesión en Tradovate y abra el módulo <strong class='text-white'>Orders</strong>. Si todavía no está en su pantalla, añádalo desde el menú de módulos o widgets de la plataforma. Es la lista continua de todas las órdenes de la sesión, cada una con su estado al lado.", image: {"src":`${IMG}/tradovate-order-rejection-reason-1.png`,"alt":"Módulo Orders de Tradovate con una lista de órdenes y una columna Status"} },
        { title: "Localice la orden rechazada", html: "Recorra la columna <strong class='text-white'>Status</strong> hasta la orden marcada como <strong class='text-white'>Rejected</strong>. Si su lista es larga, abra el menú <strong class='text-white'>View Settings</strong> (el icono de engranaje, normalmente arriba a la derecha del módulo) y active <strong class='text-white'>Show Filters</strong>. Después filtre por estado para que solo se muestren las órdenes rechazadas. Haga coincidir la hora y el símbolo con la operación que intentaba realizar.", image: {"src":`${IMG}/tradovate-order-rejection-reason-2.png`,"alt":"Módulo Orders de Tradovate filtrado para mostrar las órdenes con estado Rejected"} },
        { title: "Abra la orden para leer el motivo", html: "Haga clic en la orden rechazada; en la aplicación de escritorio, haga doble clic. Aparece una ventana de detalle y el motivo del rechazo está escrito allí mismo. Verá algo concreto como <em>Liquidation Only</em>, <em>Maximum order quantity has been reached</em> o <em>Contract is about to be expired</em>. Esa redacción exacta es su lista de correcciones: nombra la regla que infringió.", image: {"src":`${IMG}/tradovate-order-rejection-reason-3.png`,"alt":"Ventana de detalle de una orden de Tradovate con el texto concreto del motivo del rechazo"} },
        { title: "¿No encuentra la orden? Use Reports", html: "¿Ya vació el módulo o cerró sesión? Abra <strong class='text-white'>Reports</strong>, elija <strong class='text-white'>Order Details</strong>, escriba el <strong class='text-white'>Order Number</strong> y pulse <strong class='text-white'>Go</strong>. Verá el mismo motivo de rechazo, extraído de su historial en lugar de la lista en vivo. Es también la forma más limpia de documentar un rechazo si necesita plantearlo a su bróker o a su firma de fondeo.", image: {"src":`${IMG}/tradovate-order-rejection-reason-4.png`,"alt":"Consulta Order Details de Reports de Tradovate con un campo Order Number y el botón Go"} },
      ],
    },
    { type: "heading",text: "Motivos habituales y cómo solucionarlos" },
    { type: "paragraph",html: "Una vez que haya leído el mensaje, relaciónelo con la causa. Estos son los que encontrará con más frecuencia:" },
    { type: "table", headers: ["Qué dice el mensaje","Qué significa y cómo solucionarlo"], rows: [
      ["Liquidation Only","Su cuenta solo puede cerrar posiciones, no abrir nuevas, normalmente porque se alcanzó un límite de pérdida diario o máximo, o cambió un ajuste de riesgo. Revise sus ajustes de riesgo y, en una cuenta fondeada, las reglas de su firma."],
      ["Maximum order quantity has been reached","El tamaño de la orden supera el límite de contratos de su cuenta. Opere una cantidad menor o aumente el límite de posición. En cuentas de evaluación y fondeadas el tope varía según la firma y el tamaño de la cuenta; revise las reglas vigentes de su firma."],
      ["Liquidation Only. Contract is about to be expired","Está intentando abrir en un símbolo a punto de vencer o continuo (como NQ1!). Pase al contrato vigente del mes más próximo y vuelva a enviar."],
      ["Mercado cerrado / fuera del horario de negociación","El instrumento no está en una sesión activa. Confirme el horario de negociación y el calendario de festivos del contrato antes de enviar la orden."],
      ["Margen insuficiente / fondos insuficientes","Su margen disponible no cubre la orden. Reduzca el tamaño o añada fondos para que el margen libre cumpla el requisito."],
      ["Parámetros de riesgo / sin cotización disponible","Un límite de riesgo está bloqueando la orden, o no hay un precio en vivo contra el que ejecutarla. Confirme que haya un feed de datos de mercado activo y revise los límites de riesgo de su cuenta."],
    ] },
    { type: "paragraph",html: "Si el mensaje nombra algo que no está en esta lista, léalo literalmente: Tradovate es específico a propósito. Cuando apunta a una regla de la firma, su bróker o su firma de fondeo es quien puede cambiarla." },
    { type: "heading",text: "Deje de perseguir rechazos manuales" },
    { type: "paragraph",html: "Los rechazos duelen más cuando hace clic a mano bajo presión y el motivo desaparece antes de que pueda leerlo. <strong class='text-white'>PickMyTrade envía sus alertas de TradingView directamente a Tradovate</strong> e informa del estado de cada orden, de modo que un rechazo aparece con claridad en lugar de perderse en un DOM saturado." },
  ], fr: [
    { type: "paragraph",html: "Un ordre clignote en rouge, rien n'est exécuté et vous êtes réduit à deviner. Ne devinez pas. Tradovate vous indique presque toujours exactement pourquoi il a rejeté un ordre ; il suffit d'ouvrir le bon panneau pour le lire. Voici où se trouve ce message et comment l'afficher en quelques secondes, afin de corriger la vraie cause au lieu de renvoyer le même ordre." },
    { type: "heading",text: "Où se trouve réellement la raison du rejet" },
    { type: "paragraph",html: "Chaque ordre que vous envoyez apparaît dans le module <strong class='text-white'>Orders</strong> (certains comptes l'appellent Order History) avec un statut à côté : Working, Filled, Canceled, Rejected et quelques autres. Lorsqu'un ordre est refusé, le statut indique <strong class='text-white'>Rejected</strong> et la raison en langage clair est à un clic, dans le détail de cet ordre. C'est tout le secret. La plateforme écrit la raison pour vous ; la plupart des gens n'ouvrent simplement jamais l'ordre pour la voir." },
    { type: "heading",text: "Trouver la raison du rejet : étape par étape" },
    {
      type: "steps",
      items: [
        { title: "Ouvrez le module Orders", html: "Connectez-vous à Tradovate et ouvrez le module <strong class='text-white'>Orders</strong>. S'il n'est pas déjà à l'écran, ajoutez-le depuis le menu des modules ou des widgets de la plateforme. C'est la liste continue de tous les ordres de la session, chacun avec son statut.", image: {"src":`${IMG}/tradovate-order-rejection-reason-1.png`,"alt":"Module Orders de Tradovate affichant une liste d'ordres avec une colonne Status"} },
        { title: "Repérez l'ordre rejeté", html: "Parcourez la colonne <strong class='text-white'>Status</strong> jusqu'à l'ordre marqué <strong class='text-white'>Rejected</strong>. Si votre liste est longue, ouvrez le menu <strong class='text-white'>View Settings</strong> (l'icône d'engrenage, généralement en haut à droite du module) et activez <strong class='text-white'>Show Filters</strong>. Filtrez ensuite par statut pour n'afficher que les ordres rejetés. Faites correspondre l'horodatage et le symbole au trade que vous tentiez de passer.", image: {"src":`${IMG}/tradovate-order-rejection-reason-2.png`,"alt":"Module Orders de Tradovate filtré pour n'afficher que les ordres au statut Rejected"} },
        { title: "Ouvrez l'ordre pour lire la raison", html: "Cliquez sur l'ordre rejeté ; dans l'application de bureau, double-cliquez dessus. Une fenêtre de détail s'ouvre et la raison du rejet y est écrite. Vous verrez quelque chose de concret comme <em>Liquidation Only</em>, <em>Maximum order quantity has been reached</em> ou <em>Contract is about to be expired</em>. Cette formulation exacte est votre liste de corrections : elle nomme la règle que vous avez enfreinte.", image: {"src":`${IMG}/tradovate-order-rejection-reason-3.png`,"alt":"Fenêtre de détail d'un ordre Tradovate affichant le texte précis de la raison du rejet"} },
        { title: "Ordre introuvable ? Utilisez Reports", html: "Vous avez déjà vidé le module ou vous êtes déconnecté ? Ouvrez <strong class='text-white'>Reports</strong>, choisissez <strong class='text-white'>Order Details</strong>, saisissez l'<strong class='text-white'>Order Number</strong> et cliquez sur <strong class='text-white'>Go</strong>. Vous obtenez la même raison de rejet, tirée de votre historique plutôt que de la liste en direct. C'est aussi le moyen le plus propre de documenter un rejet si vous devez le signaler à votre courtier ou à votre société de prop trading.", image: {"src":`${IMG}/tradovate-order-rejection-reason-4.png`,"alt":"Recherche Order Details dans Reports de Tradovate avec un champ Order Number et un bouton Go"} },
      ],
    },
    { type: "heading",text: "Raisons courantes et comment les corriger" },
    { type: "paragraph",html: "Une fois le message lu, rattachez-le à sa cause. Voici celles que vous rencontrerez le plus souvent :" },
    { type: "table", headers: ["Ce que dit le message","Ce que cela signifie et comment corriger"], rows: [
      ["Liquidation Only","Votre compte ne peut que clôturer des positions, pas en ouvrir de nouvelles, généralement parce qu'une limite de perte quotidienne ou maximale a été atteinte, ou qu'un paramètre de risque a basculé. Vérifiez vos paramètres de risque et, sur un compte financé, les règles de votre société."],
      ["Maximum order quantity has been reached","La taille de l'ordre dépasse la limite de contrats de votre compte. Négociez une quantité plus petite ou relevez la limite de position. Sur les comptes d'évaluation et financés, le plafond varie selon la société et la taille du compte ; vérifiez les règles en vigueur de votre société."],
      ["Liquidation Only. Contract is about to be expired","Vous essayez d'ouvrir sur un symbole proche de l'expiration ou continu (comme NQ1!). Passez au contrat du mois en cours (front-month) et renvoyez l'ordre."],
      ["Marché fermé / hors horaires de négociation","L'instrument n'est pas dans une session active. Confirmez les horaires de négociation et le calendrier des jours fériés du contrat avant de passer l'ordre."],
      ["Marge insuffisante / fonds insuffisants","Votre marge disponible ne couvre pas l'ordre. Réduisez la taille ou alimentez le compte pour que la marge libre atteigne le niveau requis."],
      ["Paramètres de risque / aucune cotation disponible","Une limite de risque bloque l'ordre, ou il n'y a pas de prix en direct sur lequel exécuter. Vérifiez qu'un flux de données de marché est actif et passez en revue les limites de risque de votre compte."],
    ] },
    { type: "paragraph",html: "Si le message nomme quelque chose qui ne figure pas dans cette liste, lisez-le littéralement : Tradovate est précis à dessein. Lorsqu'il renvoie à une règle propre à la société, c'est votre courtier ou votre société de prop trading qui peut la modifier." },
    { type: "heading",text: "Cessez de courir après les rejets manuels" },
    { type: "paragraph",html: "Les rejets agacent le plus lorsque vous cliquez à la main sous pression et que la raison défile avant que vous puissiez la lire. <strong class='text-white'>PickMyTrade achemine vos alertes TradingView directement vers Tradovate</strong> et remonte le statut de chaque ordre, de sorte qu'un rejet apparaît clairement au lieu de se perdre dans un DOM chargé." },
  ], it: [
    { type: "paragraph",html: "Un ordine lampeggia in rosso, nulla viene eseguito e Lei resta a indovinare. Non indovini. Tradovate quasi sempre Le dice esattamente perché ha rifiutato un ordine; basta aprire il pannello giusto per leggerlo. Ecco dove si trova quel messaggio e come richiamarlo in pochi secondi, così correggerà la causa reale invece di reinviare lo stesso ordine." },
    { type: "heading",text: "Dove si trova davvero il motivo del rifiuto" },
    { type: "paragraph",html: "Ogni ordine che invia finisce nel modulo <strong class='text-white'>Orders</strong> (alcuni conti lo chiamano Order History) con uno stato accanto: Working, Filled, Canceled, Rejected e pochi altri. Quando un ordine viene respinto, lo stato riporta <strong class='text-white'>Rejected</strong> e il motivo in linguaggio chiaro è a un clic, nel dettaglio di quell'ordine. Tutto il trucco è qui. La piattaforma scrive il motivo per Lei; la maggior parte delle persone semplicemente non apre mai l'ordine per vederlo." },
    { type: "heading",text: "Trovare il motivo del rifiuto: passo dopo passo" },
    {
      type: "steps",
      items: [
        { title: "Apra il modulo Orders", html: "Acceda a Tradovate e apra il modulo <strong class='text-white'>Orders</strong>. Se non è già sullo schermo, lo aggiunga dal menu dei moduli o dei widget della piattaforma. È l'elenco continuo di tutti gli ordini della sessione, ciascuno con il proprio stato accanto.", image: {"src":`${IMG}/tradovate-order-rejection-reason-1.png`,"alt":"Modulo Orders di Tradovate con un elenco di ordini e una colonna Status"} },
        { title: "Individui l'ordine rifiutato", html: "Scorra la colonna <strong class='text-white'>Status</strong> fino all'ordine contrassegnato come <strong class='text-white'>Rejected</strong>. Se l'elenco è lungo, apra il menu <strong class='text-white'>View Settings</strong> (l'icona a ingranaggio, di solito in alto a destra nel modulo) e attivi <strong class='text-white'>Show Filters</strong>. Poi filtri per stato in modo che vengano mostrati solo gli ordini rifiutati. Faccia corrispondere orario e simbolo al trade che stava cercando di piazzare.", image: {"src":`${IMG}/tradovate-order-rejection-reason-2.png`,"alt":"Modulo Orders di Tradovate filtrato per mostrare gli ordini con stato Rejected"} },
        { title: "Apra l'ordine per leggere il motivo", html: "Clicchi sull'ordine rifiutato; nell'app desktop, faccia doppio clic. Si apre una finestra di dettaglio e il motivo del rifiuto è scritto proprio lì. Vedrà qualcosa di concreto come <em>Liquidation Only</em>, <em>Maximum order quantity has been reached</em> o <em>Contract is about to be expired</em>. Quella formulazione esatta è il Suo elenco di correzioni: indica la regola che ha violato.", image: {"src":`${IMG}/tradovate-order-rejection-reason-3.png`,"alt":"Finestra di dettaglio di un ordine Tradovate con il testo specifico del motivo del rifiuto"} },
        { title: "Non trova l'ordine? Usi Reports", html: "Ha già svuotato il modulo o si è disconnesso? Apra <strong class='text-white'>Reports</strong>, scelga <strong class='text-white'>Order Details</strong>, inserisca l'<strong class='text-white'>Order Number</strong> e prema <strong class='text-white'>Go</strong>. Otterrà lo stesso motivo di rifiuto, ricavato dalla cronologia anziché dall'elenco in tempo reale. È anche il modo più pulito per documentare un rifiuto se deve segnalarlo al Suo broker o alla Sua prop firm.", image: {"src":`${IMG}/tradovate-order-rejection-reason-4.png`,"alt":"Ricerca Order Details in Reports di Tradovate con un campo Order Number e un pulsante Go"} },
      ],
    },
    { type: "heading",text: "Motivi comuni e come risolverli" },
    { type: "paragraph",html: "Dopo aver letto il messaggio, lo abbini alla causa. Questi sono i casi che incontrerà più spesso:" },
    { type: "table", headers: ["Cosa dice il messaggio","Cosa significa e come risolvere"], rows: [
      ["Liquidation Only","Il Suo conto può solo chiudere posizioni, non aprirne di nuove, di solito perché è stato raggiunto un limite di perdita giornaliero o massimo, oppure è cambiata un'impostazione di rischio. Controlli le impostazioni di rischio e, su un conto finanziato, le regole della Sua società."],
      ["Maximum order quantity has been reached","La dimensione dell'ordine supera il limite di contratti del Suo conto. Operi con una quantità minore o aumenti il limite di posizione. Sui conti di valutazione e finanziati il tetto varia in base alla società e alle dimensioni del conto; controlli le regole attuali della Sua società."],
      ["Liquidation Only. Contract is about to be expired","Sta cercando di aprire su un simbolo in scadenza o continuo (come NQ1!). Passi all'attuale contratto front-month e reinvii l'ordine."],
      ["Mercato chiuso / fuori dall'orario di negoziazione","Lo strumento non è in una sessione attiva. Verifichi gli orari di negoziazione e il calendario delle festività del contratto prima di inviare l'ordine."],
      ["Margine insufficiente / fondi non sufficienti","Il margine disponibile non copre l'ordine. Riduca la dimensione o aggiunga fondi in modo che il margine libero soddisfi il requisito."],
      ["Parametri di rischio / nessuna quotazione disponibile","Un limite di rischio sta bloccando l'ordine, oppure non c'è un prezzo in tempo reale con cui eseguirlo. Verifichi che ci sia un feed di dati di mercato attivo e riveda i limiti di rischio del Suo conto."],
    ] },
    { type: "paragraph",html: "Se il messaggio indica qualcosa che non è in questo elenco, lo legga alla lettera: Tradovate è specifico di proposito. Quando rimanda a una regola della società, è il Suo broker o la Sua prop firm a poterla modificare." },
    { type: "heading",text: "Smetta di inseguire i rifiuti manuali" },
    { type: "paragraph",html: "I rifiuti pesano di più quando clicca a mano sotto pressione e il motivo scorre via prima che possa leggerlo. <strong class='text-white'>PickMyTrade instrada i Suoi alert di TradingView direttamente su Tradovate</strong> e riporta lo stato di ogni ordine, così un rifiuto emerge con chiarezza invece di perdersi in un DOM affollato." },
  ] },
  ctaHeading: { en: "See Every Order Status Clearly", de: "Behalten Sie jeden Order-Status klar im Blick", es: "Vea claramente el estado de cada orden", fr: "Voyez clairement le statut de chaque ordre", it: "Veda chiaramente lo stato di ogni ordine" },
  ctaText: { en: "PickMyTrade routes your TradingView alerts straight into Tradovate and reports back the status for each order, so a rejection surfaces clearly instead of vanishing into a busy DOM.", de: "PickMyTrade leitet Ihre TradingView-Alerts direkt an Tradovate weiter und meldet den Status jeder Order zurück, sodass eine Ablehnung deutlich sichtbar wird, statt in einem unübersichtlichen DOM zu verschwinden.", es: "PickMyTrade envía sus alertas de TradingView directamente a Tradovate e informa del estado de cada orden, de modo que un rechazo aparece con claridad en lugar de perderse en un DOM saturado.", fr: "PickMyTrade achemine vos alertes TradingView directement vers Tradovate et remonte le statut de chaque ordre, de sorte qu'un rejet apparaît clairement au lieu de se perdre dans un DOM chargé.", it: "PickMyTrade instrada i Suoi alert di TradingView direttamente su Tradovate e riporta lo stato di ogni ordine, così un rifiuto emerge con chiarezza invece di perdersi in un DOM affollato." },
