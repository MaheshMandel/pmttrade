---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "tradovate-fund-account";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/how-to/${SLUG}`;

const META_TITLE = "4 Ways to Fund Your Tradovate Account";
const META_DESCRIPTION =
  "Fund your Tradovate account fast: compare ACH, wire, debit card, and digital wallet deposits by speed and limits so your capital lands when you trade.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "4 Wege, Ihr Tradovate-Konto zu finanzieren", es: "4 formas de fondear su cuenta de Tradovate", fr: "4 façons d’approvisionner votre compte Tradovate", it: "4 modi per finanziare il Suo conto Tradovate" },
  dek: { en: "Need capital in your account before the next session? Here's how each of Tradovate's four deposit methods works, and how they stack up on speed and limits.", de: "Brauchen Sie Kapital auf Ihrem Konto, bevor die nächste Sitzung beginnt? So funktionieren die vier Einzahlungsmethoden von Tradovate und so schneiden sie bei Geschwindigkeit und Limits ab.", es: "¿Necesita capital en su cuenta antes de la próxima sesión? Así funcionan los cuatro métodos de depósito de Tradovate y cómo se comparan en velocidad y límites.", fr: "Besoin de capital sur votre compte avant la prochaine séance ? Voici comment fonctionnent les quatre méthodes de dépôt de Tradovate et comment elles se comparent en matière de rapidité et de plafonds.", it: "Ha bisogno di capitale sul conto prima della prossima sessione? Ecco come funzionano i quattro metodi di deposito di Tradovate e come si confrontano per velocità e limiti." },
  readTime: { en: "5 min read", de: "5 Min. Lesezeit", es: "Lectura de 5 min", fr: "Lecture : 5 min", it: "Lettura di 5 min" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "Need capital in your account before the next session? Maybe you're topping up a live futures account, keeping deposit records clean for tax season, or getting set up to automate with PickMyTrade. Either way, Tradovate gives you four ways to move money in. Here's how each one works, and how they stack up on speed and limits so your funds land when you actually need them." },
    { type: "heading", text: "What Funding a Tradovate Account Means" },
    { type: "paragraph", html: "Funding just means moving money from your bank, card, or digital wallet into your Tradovate brokerage account so you've got the margin to place futures trades. Tradovate supports four deposit methods: ACH bank transfer, wire transfer, debit card, and digital wallet (Apple Pay or Google Pay). Each one has its own processing time and per-transaction limit." },
    { type: "paragraph", html: "One quick note before you start: prop-firm evaluation accounts are handled by your firm and don't use any of these methods. This guide is strictly for a self-funded Tradovate brokerage account." },
    { type: "heading", text: "Fund Your Tradovate Account: Step-by-Step" },
    {
      type: "steps",
      items: [
        { title: "Open the Fund Account Screen", html: "Log in to the Tradovate web or desktop app and open <strong class='text-white'>Application Settings</strong> in the top-right. From there, head to the Accounts / Transfers area and choose <strong class='text-white'>Fund Account</strong>. Every deposit method lives on this one screen, so this is your jumping-off point no matter which option you're after." },
        { title: "Deposit by ACH Bank Transfer", html: "ACH links a US bank account directly to Tradovate. Choose <strong class='text-white'>ACH</strong>, connect or select your bank, enter the amount, and confirm. ACH deposits are capped at a set per-transaction limit and usually post in about one business day when you submit before the daily cutoff. The exact caps and cutoff times do change, so check Tradovate's current funding page before you send." },
        { title: "Deposit by Wire Transfer", html: "A wire is your best bet for larger deposits because it carries no deposit limit at all. Select <strong class='text-white'>Wire Transfer</strong> to pull up Tradovate's banking instructions, then send the wire from your bank using those exact details. Funds typically post within a few hours to the next business day once they're received. Tradovate doesn't charge an inbound wire fee, though your sending bank may charge its own." },
        { title: "Deposit by Debit Card", html: "A debit card gives you a quick deposit without leaving the platform. Select <strong class='text-white'>Debit Card</strong>, agree to the disclosure, then enter your card details and the amount. One thing to watch: the name on the card has to match the name on your Tradovate account. Debit deposits are limited to a set amount per transaction and generally clear in about one business day." },
        { title: "Deposit by Digital Wallet (Apple Pay / Google Pay)", html: "Don't feel like typing card numbers? Tradovate also takes <strong class='text-white'>Apple Pay</strong> and <strong class='text-white'>Google Pay</strong>, both funded by a debit card. Pick the digital wallet option, authenticate with your device, and confirm the amount. Like the card and ACH methods, wallet deposits carry a per-transaction cap and post in roughly one business day." },
      ],
    },
    { type: "heading", text: "Why You'd Need This" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Add margin before a live session</strong> so orders don't get rejected for insufficient funds.",
        "<strong class='text-white'>Top up fast</strong> with a card or wallet when a bank transfer would be too slow.",
        "<strong class='text-white'>Move a larger balance by wire</strong> when you're past the card or ACH per-transaction limit.",
        "<strong class='text-white'>Keep clean deposit records</strong> for taxes, audits, and reconciling your trading journal.",
      ],
    },
    { type: "heading", text: "Automate This with PickMyTrade" },
    { type: "paragraph", html: "Once your account is funded, PickMyTrade wires your TradingView alerts straight into Tradovate so entries, stops, and targets fire automatically. No manual clicks while you're funding an account, watching charts, or away from your desk." },
  ], de: [
    { type: "paragraph",html: "Brauchen Sie Kapital auf Ihrem Konto, bevor die nächste Sitzung beginnt? Vielleicht füllen Sie ein Live-Futures-Konto auf, führen Ihre Einzahlungsbelege für die Steuererklärung sauber oder bereiten die Automatisierung mit PickMyTrade vor. In jedem Fall bietet Tradovate Ihnen vier Wege, Geld einzuzahlen. Hier sehen Sie, wie jeder funktioniert und wie sie bei Geschwindigkeit und Limits abschneiden, damit Ihr Geld dann ankommt, wenn Sie es tatsächlich brauchen." },
    { type: "heading",text: "Was die Finanzierung eines Tradovate-Kontos bedeutet" },
    { type: "paragraph",html: "Finanzieren bedeutet einfach, Geld von Ihrer Bank, Karte oder digitalen Wallet auf Ihr Tradovate-Brokerage-Konto zu übertragen, damit Sie die Margin für Futures-Trades haben. Tradovate unterstützt vier Einzahlungsmethoden: ACH-Banküberweisung, Wire-Überweisung, Debitkarte und digitale Wallet (Apple Pay oder Google Pay). Jede hat ihre eigene Bearbeitungszeit und ihr eigenes Limit pro Transaktion." },
    { type: "paragraph",html: "Ein kurzer Hinweis, bevor Sie beginnen: Evaluierungskonten von Prop Firms werden von Ihrer Firma verwaltet und nutzen keine dieser Methoden. Dieser Leitfaden gilt ausschließlich für ein selbst finanziertes Tradovate-Brokerage-Konto." },
    { type: "heading",text: "Ihr Tradovate-Konto finanzieren: Schritt für Schritt" },
    {
      type: "steps",
      items: [
        { title: "Den Bildschirm „Fund Account“ öffnen", html: "Melden Sie sich in der Tradovate-Web- oder Desktop-App an und öffnen Sie oben rechts <strong class='text-white'>Application Settings</strong>. Gehen Sie von dort zum Bereich Accounts / Transfers und wählen Sie <strong class='text-white'>Fund Account</strong>. Alle Einzahlungsmethoden befinden sich auf diesem einen Bildschirm, daher ist dies Ihr Ausgangspunkt, egal welche Option Sie nutzen möchten." },
        { title: "Per ACH-Banküberweisung einzahlen", html: "ACH verknüpft ein US-Bankkonto direkt mit Tradovate. Wählen Sie <strong class='text-white'>ACH</strong>, verbinden oder wählen Sie Ihre Bank, geben Sie den Betrag ein und bestätigen Sie. ACH-Einzahlungen sind auf ein festes Limit pro Transaktion begrenzt und werden meist in etwa einem Geschäftstag gutgeschrieben, wenn Sie sie vor dem täglichen Annahmeschluss einreichen. Die genauen Obergrenzen und Annahmeschlusszeiten ändern sich, prüfen Sie daher die aktuelle Finanzierungsseite von Tradovate, bevor Sie senden." },
        { title: "Per Wire-Überweisung einzahlen", html: "Eine Wire-Überweisung ist Ihre beste Wahl für größere Einzahlungen, da es dafür überhaupt kein Einzahlungslimit gibt. Wählen Sie <strong class='text-white'>Wire Transfer</strong>, um die Bankinstruktionen von Tradovate aufzurufen, und senden Sie die Überweisung dann mit genau diesen Angaben von Ihrer Bank aus. Die Gelder werden nach Eingang in der Regel innerhalb weniger Stunden bis zum nächsten Geschäftstag gutgeschrieben. Tradovate erhebt keine Gebühr für eingehende Wire-Überweisungen, Ihre sendende Bank kann jedoch eigene Gebühren berechnen." },
        { title: "Per Debitkarte einzahlen", html: "Mit einer Debitkarte zahlen Sie schnell ein, ohne die Plattform zu verlassen. Wählen Sie <strong class='text-white'>Debit Card</strong>, stimmen Sie dem Hinweis zu und geben Sie dann Ihre Kartendaten und den Betrag ein. Eines sollten Sie beachten: Der Name auf der Karte muss mit dem Namen auf Ihrem Tradovate-Konto übereinstimmen. Debitkarten-Einzahlungen sind pro Transaktion auf einen festen Betrag begrenzt und werden in der Regel innerhalb von etwa einem Geschäftstag verbucht." },
        { title: "Per digitaler Wallet einzahlen (Apple Pay / Google Pay)", html: "Keine Lust, Kartennummern einzutippen? Tradovate akzeptiert auch <strong class='text-white'>Apple Pay</strong> und <strong class='text-white'>Google Pay</strong>, beide mit einer Debitkarte hinterlegt. Wählen Sie die Option für die digitale Wallet, authentifizieren Sie sich mit Ihrem Gerät und bestätigen Sie den Betrag. Wie bei Karte und ACH gilt auch für Wallet-Einzahlungen ein Limit pro Transaktion, und sie werden in etwa einem Geschäftstag gutgeschrieben." },
      ],
    },
    { type: "heading",text: "Wann Sie das brauchen" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Margin vor einer Live-Sitzung aufstocken</strong>, damit Orders nicht wegen unzureichender Mittel abgelehnt werden.",
        "<strong class='text-white'>Schnell aufladen</strong> per Karte oder Wallet, wenn eine Banküberweisung zu langsam wäre.",
        "<strong class='text-white'>Einen größeren Betrag per Wire bewegen</strong>, wenn Sie über dem Limit pro Transaktion für Karte oder ACH liegen.",
        "<strong class='text-white'>Einzahlungsbelege sauber führen</strong> für Steuern, Prüfungen und den Abgleich Ihres Trading-Journals.",
      ],
    },
    { type: "heading",text: "Automatisieren Sie das mit PickMyTrade" },
    { type: "paragraph",html: "Sobald Ihr Konto finanziert ist, verbindet PickMyTrade Ihre TradingView-Alerts direkt mit Tradovate, sodass Einstiege, Stops und Ziele automatisch ausgelöst werden. Kein manuelles Klicken, während Sie ein Konto finanzieren, Charts beobachten oder nicht am Schreibtisch sind." },
  ], es: [
    { type: "paragraph",html: "¿Necesita capital en su cuenta antes de la próxima sesión? Quizá esté recargando una cuenta de futuros real, manteniendo ordenados sus registros de depósitos para la declaración de impuestos o preparándose para automatizar con PickMyTrade. En cualquier caso, Tradovate le ofrece cuatro formas de ingresar dinero. Aquí le explicamos cómo funciona cada una y cómo se comparan en velocidad y límites, para que sus fondos lleguen cuando realmente los necesita." },
    { type: "heading",text: "Qué significa fondear una cuenta de Tradovate" },
    { type: "paragraph",html: "Fondear simplemente significa transferir dinero desde su banco, tarjeta o billetera digital a su cuenta de corretaje de Tradovate para disponer del margen necesario para operar futuros. Tradovate admite cuatro métodos de depósito: transferencia bancaria ACH, transferencia wire, tarjeta de débito y billetera digital (Apple Pay o Google Pay). Cada uno tiene su propio tiempo de procesamiento y su propio límite por transacción." },
    { type: "paragraph",html: "Una nota rápida antes de empezar: las cuentas de evaluación de prop firms las gestiona su firma y no utilizan ninguno de estos métodos. Esta guía es estrictamente para una cuenta de corretaje de Tradovate fondeada por usted mismo." },
    { type: "heading",text: "Fondee su cuenta de Tradovate: paso a paso" },
    {
      type: "steps",
      items: [
        { title: "Abra la pantalla Fund Account", html: "Inicie sesión en la aplicación web o de escritorio de Tradovate y abra <strong class='text-white'>Application Settings</strong> en la esquina superior derecha. Desde allí, vaya al área Accounts / Transfers y elija <strong class='text-white'>Fund Account</strong>. Todos los métodos de depósito están en esta misma pantalla, así que es su punto de partida sea cual sea la opción que busque." },
        { title: "Deposite por transferencia bancaria ACH", html: "ACH vincula una cuenta bancaria de EE. UU. directamente con Tradovate. Elija <strong class='text-white'>ACH</strong>, conecte o seleccione su banco, introduzca el monto y confirme. Los depósitos por ACH tienen un límite fijo por transacción y normalmente se acreditan en aproximadamente un día hábil si los envía antes de la hora de corte diaria. Los topes exactos y las horas de corte cambian, así que consulte la página de fondeo vigente de Tradovate antes de enviar." },
        { title: "Deposite por transferencia wire", html: "Una transferencia wire es su mejor opción para depósitos mayores porque no tiene ningún límite de depósito. Seleccione <strong class='text-white'>Wire Transfer</strong> para ver las instrucciones bancarias de Tradovate y envíe la transferencia desde su banco con esos datos exactos. Los fondos suelen acreditarse entre unas pocas horas y el siguiente día hábil una vez recibidos. Tradovate no cobra comisión por transferencias wire entrantes, aunque su banco emisor puede cobrar la suya." },
        { title: "Deposite con tarjeta de débito", html: "Una tarjeta de débito le permite depositar rápidamente sin salir de la plataforma. Seleccione <strong class='text-white'>Debit Card</strong>, acepte el aviso y luego introduzca los datos de su tarjeta y el monto. Un detalle importante: el nombre en la tarjeta debe coincidir con el nombre de su cuenta de Tradovate. Los depósitos con débito tienen un límite por transacción y suelen acreditarse en aproximadamente un día hábil." },
        { title: "Deposite con billetera digital (Apple Pay / Google Pay)", html: "¿No quiere escribir números de tarjeta? Tradovate también acepta <strong class='text-white'>Apple Pay</strong> y <strong class='text-white'>Google Pay</strong>, ambos respaldados por una tarjeta de débito. Elija la opción de billetera digital, autentíquese con su dispositivo y confirme el monto. Al igual que con la tarjeta y ACH, los depósitos con billetera tienen un tope por transacción y se acreditan en aproximadamente un día hábil." },
      ],
    },
    { type: "heading",text: "Por qué lo necesitaría" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Añadir margen antes de una sesión en vivo</strong> para que no rechacen órdenes por fondos insuficientes.",
        "<strong class='text-white'>Recargar rápido</strong> con tarjeta o billetera cuando una transferencia bancaria sería demasiado lenta.",
        "<strong class='text-white'>Mover un saldo mayor por wire</strong> cuando supera el límite por transacción de la tarjeta o de ACH.",
        "<strong class='text-white'>Mantener registros de depósitos ordenados</strong> para impuestos, auditorías y para conciliar su diario de trading.",
      ],
    },
    { type: "heading",text: "Automatice esto con PickMyTrade" },
    { type: "paragraph",html: "Una vez fondeada su cuenta, PickMyTrade conecta sus alertas de TradingView directamente con Tradovate para que las entradas, los stops y los objetivos se ejecuten automáticamente. Sin clics manuales mientras fondea una cuenta, mira gráficos o está lejos de su escritorio." },
  ], fr: [
    { type: "paragraph",html: "Besoin de capital sur votre compte avant la prochaine séance ? Peut-être rechargez-vous un compte de futures réel, tenez-vous proprement vos relevés de dépôts pour la déclaration d’impôts ou vous préparez-vous à automatiser avec PickMyTrade. Dans tous les cas, Tradovate vous propose quatre façons d’y déposer de l’argent. Voici comment chacune fonctionne et comment elles se comparent en rapidité et en plafonds, afin que vos fonds arrivent quand vous en avez réellement besoin." },
    { type: "heading",text: "Ce que signifie approvisionner un compte Tradovate" },
    { type: "paragraph",html: "Approvisionner signifie simplement transférer de l’argent depuis votre banque, votre carte ou votre portefeuille numérique vers votre compte de courtage Tradovate afin de disposer de la marge nécessaire pour passer des trades sur futures. Tradovate prend en charge quatre méthodes de dépôt : virement bancaire ACH, virement wire, carte de débit et portefeuille numérique (Apple Pay ou Google Pay). Chacune a son propre délai de traitement et son propre plafond par transaction." },
    { type: "paragraph",html: "Une petite précision avant de commencer : les comptes d’évaluation de prop firm sont gérés par votre société et n’utilisent aucune de ces méthodes. Ce guide concerne strictement un compte de courtage Tradovate approvisionné par vos soins." },
    { type: "heading",text: "Approvisionner votre compte Tradovate : pas à pas" },
    {
      type: "steps",
      items: [
        { title: "Ouvrir l’écran Fund Account", html: "Connectez-vous à l’application web ou de bureau Tradovate et ouvrez <strong class='text-white'>Application Settings</strong> en haut à droite. De là, rendez-vous dans la zone Accounts / Transfers et choisissez <strong class='text-white'>Fund Account</strong>. Toutes les méthodes de dépôt se trouvent sur cet écran unique ; c’est donc votre point de départ, quelle que soit l’option que vous visez." },
        { title: "Déposer par virement bancaire ACH", html: "L’ACH relie un compte bancaire américain directement à Tradovate. Choisissez <strong class='text-white'>ACH</strong>, connectez ou sélectionnez votre banque, saisissez le montant et confirmez. Les dépôts ACH sont plafonnés à une limite fixe par transaction et sont généralement crédités en un jour ouvré environ si vous les soumettez avant l’heure limite quotidienne. Les plafonds exacts et les heures limites changent ; vérifiez donc la page de financement actuelle de Tradovate avant d’envoyer." },
        { title: "Déposer par virement wire", html: "Le virement wire est votre meilleure option pour les dépôts importants, car il n’y a aucune limite de dépôt. Sélectionnez <strong class='text-white'>Wire Transfer</strong> pour afficher les instructions bancaires de Tradovate, puis envoyez le virement depuis votre banque avec ces coordonnées exactes. Les fonds sont généralement crédités entre quelques heures et le jour ouvré suivant une fois reçus. Tradovate ne facture pas de frais pour les virements wire entrants, même si votre banque émettrice peut appliquer les siens." },
        { title: "Déposer par carte de débit", html: "Une carte de débit permet un dépôt rapide sans quitter la plateforme. Sélectionnez <strong class='text-white'>Debit Card</strong>, acceptez l’avis, puis saisissez les informations de votre carte et le montant. Un point d’attention : le nom figurant sur la carte doit correspondre au nom de votre compte Tradovate. Les dépôts par carte de débit sont limités à un montant fixe par transaction et sont généralement crédités en un jour ouvré environ." },
        { title: "Déposer par portefeuille numérique (Apple Pay / Google Pay)", html: "Pas envie de saisir des numéros de carte ? Tradovate accepte aussi <strong class='text-white'>Apple Pay</strong> et <strong class='text-white'>Google Pay</strong>, tous deux alimentés par une carte de débit. Choisissez l’option de portefeuille numérique, authentifiez-vous avec votre appareil et confirmez le montant. Comme pour la carte et l’ACH, les dépôts par portefeuille sont soumis à un plafond par transaction et sont crédités en un jour ouvré environ." },
      ],
    },
    { type: "heading",text: "Pourquoi en avoir besoin" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Ajouter de la marge avant une séance en direct</strong> pour que les ordres ne soient pas rejetés faute de fonds suffisants.",
        "<strong class='text-white'>Recharger rapidement</strong> par carte ou portefeuille quand un virement bancaire serait trop lent.",
        "<strong class='text-white'>Déplacer un solde plus important par wire</strong> lorsque vous dépassez le plafond par transaction de la carte ou de l’ACH.",
        "<strong class='text-white'>Tenir des relevés de dépôts propres</strong> pour les impôts, les audits et le rapprochement de votre journal de trading.",
      ],
    },
    { type: "heading",text: "Automatisez cela avec PickMyTrade" },
    { type: "paragraph",html: "Une fois votre compte approvisionné, PickMyTrade relie vos alertes TradingView directement à Tradovate afin que les entrées, les stops et les objectifs se déclenchent automatiquement. Aucun clic manuel pendant que vous approvisionnez un compte, surveillez des graphiques ou êtes loin de votre bureau." },
  ], it: [
    { type: "paragraph",html: "Ha bisogno di capitale sul conto prima della prossima sessione? Magari sta ricaricando un conto futures reale, tenendo in ordine le registrazioni dei depositi per la dichiarazione dei redditi o preparandosi ad automatizzare con PickMyTrade. In ogni caso, Tradovate Le offre quattro modi per versare denaro. Ecco come funziona ciascuno e come si confrontano per velocità e limiti, così i Suoi fondi arrivano quando Le servono davvero." },
    { type: "heading",text: "Cosa significa finanziare un conto Tradovate" },
    { type: "paragraph",html: "Finanziare significa semplicemente trasferire denaro dalla Sua banca, carta o wallet digitale al Suo conto di brokerage Tradovate, così da avere il margine per effettuare trade sui futures. Tradovate supporta quattro metodi di deposito: bonifico bancario ACH, bonifico wire, carta di debito e wallet digitale (Apple Pay o Google Pay). Ciascuno ha i propri tempi di elaborazione e il proprio limite per transazione." },
    { type: "paragraph",html: "Una breve nota prima di iniziare: i conti di valutazione delle prop firm sono gestiti dalla Sua società e non usano nessuno di questi metodi. Questa guida riguarda esclusivamente un conto di brokerage Tradovate finanziato in proprio." },
    { type: "heading",text: "Finanziare il Suo conto Tradovate: passo dopo passo" },
    {
      type: "steps",
      items: [
        { title: "Aprire la schermata Fund Account", html: "Acceda all’app web o desktop di Tradovate e apra <strong class='text-white'>Application Settings</strong> in alto a destra. Da lì vada all’area Accounts / Transfers e scelga <strong class='text-white'>Fund Account</strong>. Tutti i metodi di deposito si trovano su questa unica schermata, quindi è il Suo punto di partenza qualunque opzione scelga." },
        { title: "Depositare con bonifico bancario ACH", html: "L’ACH collega direttamente un conto bancario statunitense a Tradovate. Scelga <strong class='text-white'>ACH</strong>, colleghi o selezioni la Sua banca, inserisca l’importo e confermi. I depositi ACH hanno un limite fisso per transazione e di solito vengono accreditati in circa un giorno lavorativo se li invia prima dell’orario limite giornaliero. I massimali esatti e gli orari limite cambiano, perciò controlli la pagina di finanziamento attuale di Tradovate prima di inviare." },
        { title: "Depositare con bonifico wire", html: "Il bonifico wire è la scelta migliore per depositi più grandi perché non prevede alcun limite di deposito. Selezioni <strong class='text-white'>Wire Transfer</strong> per visualizzare le istruzioni bancarie di Tradovate, poi invii il bonifico dalla Sua banca usando esattamente quei dati. I fondi vengono in genere accreditati da poche ore fino al giorno lavorativo successivo alla ricezione. Tradovate non applica commissioni per i wire in entrata, anche se la Sua banca mittente potrebbe applicare le proprie." },
        { title: "Depositare con carta di debito", html: "Una carta di debito Le consente un deposito rapido senza lasciare la piattaforma. Selezioni <strong class='text-white'>Debit Card</strong>, accetti l’informativa, poi inserisca i dati della carta e l’importo. Una cosa a cui prestare attenzione: il nome sulla carta deve corrispondere al nome sul Suo conto Tradovate. I depositi con carta di debito sono limitati a un importo fisso per transazione e in genere vengono accreditati in circa un giorno lavorativo." },
