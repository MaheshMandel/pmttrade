---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "tradovate-previous-day-trades";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/how-to/${SLUG}`;

const META_TITLE = "Find Previous-Day Trades in Tradovate Reports";
const META_DESCRIPTION =
  "Prior-day trades disappear from Tradovate charts at end of day. Use Reports or Market Replay to review, filter by date, and export archived fills.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Trades des Vortags in den Tradovate-Reports finden", es: "Cómo encontrar las operaciones del día anterior en los informes de Tradovate", fr: "Retrouver les trades de la veille dans les rapports Tradovate", it: "Come trovare i trade del giorno precedente nei report di Tradovate" },
  dek: { en: "You close out a solid session, come back the next morning, and the fills are gone from the chart. Nothing's broken, here's where Tradovate actually keeps them.", de: "Sie beenden eine gelungene Session, kommen am nächsten Morgen zurück, und die Fills sind aus dem Chart verschwunden. Nichts ist defekt – hier speichert Tradovate sie tatsächlich.", es: "Cierra una buena sesión, vuelve a la mañana siguiente y las ejecuciones ya no están en el gráfico. No se ha roto nada: aquí es donde Tradovate las guarda realmente.", fr: "Vous terminez une bonne séance, revenez le lendemain matin, et les exécutions ont disparu du graphique. Rien n’est cassé : voici où Tradovate les conserve réellement.", it: "Chiude una buona sessione, torna la mattina dopo e le esecuzioni non sono più sul grafico. Non si è rotto nulla: ecco dove Tradovate le conserva davvero." },
  readTime: { en: "5 min read", de: "5 Min. Lesezeit", es: "Lectura de 5 min", fr: "Lecture : 5 min", it: "Lettura di 5 min" },
  lastUpdated: "2026-07-10",
  blocks: { en: [
    { type: "paragraph", html: "Here's the thing that trips up a lot of Tradovate users: you close out a solid session, come back the next morning to review your entries, and the fills are just gone from the chart. Nothing's broken. Tradovate archives each day's orders, positions, and fills shortly after the session closes, so <strong class='text-white'>Show Fills</strong> on the chart only ever paints the current day. Your trades aren't lost, just stored somewhere else." },
    { type: "quote", html: "<strong>Quick answer:</strong> You can't keep prior-day fills pinned to a live chart. To review yesterday's (or any past day's) trades, open <strong>Reports</strong> and pull the Performance, Orders, or Fills report for the date you want. To actually watch the trades play back on a chart, use <strong>Market Replay</strong> with the option to play your own trades." },
    { type: "heading", text: "Why Yesterday's Trades Vanish From the Chart" },
    { type: "paragraph", html: "Once a session ends, Tradovate clears that day's orders and fills off the chart and archives them on the server. That's why toggling <strong class='text-white'>Show Orders</strong> or <strong class='text-white'>Show Fills</strong> in chart settings never brings back yesterday's markers, no matter how far you scroll. Keeping prior-day fills on the chart has been a long-standing feature request, but it isn't how the platform works today. The data is still there, and Reports is built to pull it back." },
    { type: "heading", text: "Review Your Trades in Reports (Step by Step)" },
    {
      type: "steps",
      items: [
        { title: "Open the Reports Window", html: "Look for the <strong class='text-white'>Reports</strong> icon on the toolbar. On the web platform it sits on the right-hand side, and you can also reach the same view by clicking the margin/balance area in the top header or from the account drop-down. Any of those opens the Account Reports page, where every report type lives.", image: { src: `${IMG}/tradovate-previous-day-trades-1.png`, alt: "Tradovate web platform with the Reports icon highlighted on the toolbar" } },
        { title: "Pick the Report and Set the Date Range", html: "At the top you'll choose which report you want. <strong class='text-white'>Performance</strong> is the one most traders reach for when they want a trade-by-trade review, but you've also got <strong class='text-white'>Orders</strong>, <strong class='text-white'>Fills</strong>, <strong class='text-white'>Position History</strong>, and <strong class='text-white'>Cash History</strong> if you need the raw records. Set the window with a preset like <strong class='text-white'>Today</strong>, <strong class='text-white'>This Week</strong>, or <strong class='text-white'>This Month</strong>, or switch to <strong class='text-white'>Custom</strong> and type your own <strong class='text-white'>From</strong> and <strong class='text-white'>To</strong> dates. Click <strong class='text-white'>Go</strong> to generate it. To pull just one past day, set both From and To to that date.", image: { src: `${IMG}/tradovate-previous-day-trades-2.png`, alt: "Tradovate Account Reports page with report tabs and a custom From and To date range selector" } },
        { title: "Read the Trade History and Export It", html: "The Performance report leads with the summary: net P&amp;L, number of trades, win rate, run-up, and drawdown, plus profit/loss charts. Scroll down for the trade-by-trade list with entry, exit, and P&amp;L on each one. Want it in your journal? Use the download option to export as <strong class='text-white'>CSV</strong> or <strong class='text-white'>PDF</strong>. One heads-up: the trade export runs on gross numbers, so if the total looks off against your balance, pull the <strong class='text-white'>Cash History</strong> report for the same dates and reconcile the commissions and fees.", image: { src: `${IMG}/tradovate-previous-day-trades-3.png`, alt: "Tradovate Performance report showing P&L summary and a scrollable trade-by-trade history" } },
        { title: "Replay the Trades on a Chart with Market Replay", html: "Reports give you the numbers, but if you want to see the trades on the chart the way they unfolded, use <strong class='text-white'>Market Replay</strong>. Set the start date and time to the session you're reviewing, pick your account, and start the replay; there's an option to play back your own trades so your entries and exits appear as the bars move. One caveat: Replay availability depends on your plan, and on some prop or evaluation accounts the account selector can be limited, so Reports stays the reliable fallback.", image: { src: `${IMG}/tradovate-previous-day-trades-4.png`, alt: "Tradovate Market Replay setup with start date, account selector, and the option to play your own trades" } },
      ],
    },
    { type: "heading", text: "A Couple of Things Worth Knowing" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Prop and evaluation accounts</strong>, your trade data still lives in Reports even when Replay is restricted, so use the Performance and Fills reports for review.",
        "<strong class='text-white'>Pull the day before it clears</strong>, if you want fills on the live chart, screenshot them before the session closes, since the chart won't hold them overnight.",
        "<strong class='text-white'>Firm rules vary</strong>, daily loss limits, drawdown, and what shows up on an evaluation account differ by firm and account size, so check your firm's current rules.",
      ],
    },
    { type: "heading", text: "Skip the End-of-Day Detective Work" },
    { type: "paragraph", html: "Reconstructing what your strategy did after the fact gets old fast. Automate the execution instead: <strong class='text-white'>PickMyTrade routes your TradingView signals straight to Tradovate</strong> and keeps a clean record of every order it fires, so your reports stay complete without the manual bookkeeping." },
  ], de: [
    { type: "paragraph",html: "Das bringt viele Tradovate-Nutzer ins Stolpern: Sie beenden eine gelungene Session, kommen am nächsten Morgen zurück, um Ihre Einstiege zu prüfen, und die Fills sind einfach aus dem Chart verschwunden. Nichts ist defekt. Tradovate archiviert die Orders, Positionen und Fills eines Tages kurz nach Sessionende, sodass <strong class='text-white'>Show Fills</strong> im Chart immer nur den aktuellen Tag anzeigt. Ihre Trades sind nicht verloren, sondern lediglich an anderer Stelle gespeichert." },
    { type: "quote",html: "<strong>Kurzantwort:</strong> Fills vom Vortag lassen sich nicht an einen Live-Chart heften. Um die Trades von gestern (oder eines beliebigen früheren Tages) zu prüfen, öffnen Sie <strong>Reports</strong> und rufen den Report Performance, Orders oder Fills für das gewünschte Datum auf. Um die Trades tatsächlich im Chart ablaufen zu sehen, nutzen Sie <strong>Market Replay</strong> mit der Option, Ihre eigenen Trades abzuspielen." },
    { type: "heading",text: "Warum die Trades von gestern aus dem Chart verschwinden" },
    { type: "paragraph",html: "Sobald eine Session endet, entfernt Tradovate die Orders und Fills dieses Tages aus dem Chart und archiviert sie auf dem Server. Deshalb bringt das Umschalten von <strong class='text-white'>Show Orders</strong> oder <strong class='text-white'>Show Fills</strong> in den Chart-Einstellungen die Markierungen von gestern nie zurück, egal wie weit Sie scrollen. Fills des Vortags im Chart zu behalten, ist ein lange gewünschtes Feature, entspricht aber nicht der heutigen Funktionsweise der Plattform. Die Daten sind weiterhin vorhanden, und Reports dient genau dazu, sie abzurufen." },
    { type: "heading",text: "Trades in Reports prüfen (Schritt für Schritt)" },
    {
      type: "steps",
      items: [
        { title: "Das Fenster Reports öffnen", html: "Suchen Sie in der Symbolleiste das Symbol <strong class='text-white'>Reports</strong>. In der Web-Plattform befindet es sich auf der rechten Seite; dieselbe Ansicht erreichen Sie auch über den Margin-/Kontostand-Bereich in der oberen Kopfzeile oder über das Konto-Dropdown. Jeder dieser Wege öffnet die Seite „Account Reports“, auf der alle Report-Typen zu finden sind.", image: {"src":`${IMG}/tradovate-previous-day-trades-1.png`,"alt":"Tradovate-Webplattform mit hervorgehobenem Reports-Symbol in der Symbolleiste"} },
        { title: "Report auswählen und Datumsbereich festlegen", html: "Oben wählen Sie den gewünschten Report. <strong class='text-white'>Performance</strong> ist der Report, zu dem die meisten Trader für eine Trade-für-Trade-Analyse greifen, doch für die Rohdaten stehen auch <strong class='text-white'>Orders</strong>, <strong class='text-white'>Fills</strong>, <strong class='text-white'>Position History</strong> und <strong class='text-white'>Cash History</strong> bereit. Legen Sie den Zeitraum mit einer Voreinstellung wie <strong class='text-white'>Today</strong>, <strong class='text-white'>This Week</strong> oder <strong class='text-white'>This Month</strong> fest oder wechseln Sie zu <strong class='text-white'>Custom</strong> und geben Sie Ihre eigenen Daten bei <strong class='text-white'>From</strong> und <strong class='text-white'>To</strong> ein. Klicken Sie auf <strong class='text-white'>Go</strong>, um den Report zu erzeugen. Um nur einen vergangenen Tag abzurufen, setzen Sie From und To auf dasselbe Datum.", image: {"src":`${IMG}/tradovate-previous-day-trades-2.png`,"alt":"Tradovate-Seite „Account Reports“ mit Report-Tabs und einer benutzerdefinierten Auswahl für Von- und Bis-Datum"} },
        { title: "Trade-Verlauf lesen und exportieren", html: "Der Performance-Report beginnt mit der Zusammenfassung: Netto-P&amp;L, Anzahl der Trades, Gewinnquote, Run-up und Drawdown sowie Gewinn-/Verlust-Diagramme. Weiter unten finden Sie die Trade-für-Trade-Liste mit Einstieg, Ausstieg und P&amp;L jedes Trades. Für Ihr Journal nutzen Sie die Download-Option, um als <strong class='text-white'>CSV</strong> oder <strong class='text-white'>PDF</strong> zu exportieren. Ein Hinweis: Der Trade-Export arbeitet mit Bruttozahlen. Wirkt die Summe im Vergleich zu Ihrem Kontostand falsch, rufen Sie für denselben Zeitraum den Report <strong class='text-white'>Cash History</strong> auf und gleichen Sie Provisionen und Gebühren ab.", image: {"src":`${IMG}/tradovate-previous-day-trades-3.png`,"alt":"Tradovate-Performance-Report mit P&L-Zusammenfassung und scrollbarem Trade-für-Trade-Verlauf"} },
        { title: "Trades mit Market Replay im Chart abspielen", html: "Reports liefern die Zahlen, doch wenn Sie die Trades so im Chart sehen möchten, wie sie sich entwickelt haben, nutzen Sie <strong class='text-white'>Market Replay</strong>. Legen Sie Startdatum und -zeit auf die Session fest, die Sie prüfen, wählen Sie Ihr Konto und starten Sie den Replay. Mit der Option, Ihre eigenen Trades abzuspielen, erscheinen Ihre Einstiege und Ausstiege, während sich die Kerzen bewegen. Eine Einschränkung: Die Verfügbarkeit von Replay hängt von Ihrem Plan ab, und bei manchen Prop- oder Evaluierungskonten kann die Kontoauswahl eingeschränkt sein, sodass Reports die verlässliche Alternative bleibt.", image: {"src":`${IMG}/tradovate-previous-day-trades-4.png`,"alt":"Tradovate-Market-Replay-Einrichtung mit Startdatum, Kontoauswahl und der Option, eigene Trades abzuspielen"} },
      ],
    },
    { type: "heading",text: "Ein paar wissenswerte Punkte" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Prop- und Evaluierungskonten</strong>: Ihre Trade-Daten bleiben in Reports verfügbar, auch wenn Replay eingeschränkt ist; nutzen Sie daher die Reports Performance und Fills zur Auswertung.",
        "<strong class='text-white'>Vor der Archivierung sichern</strong>: Wenn Sie Fills im Live-Chart behalten möchten, erstellen Sie vor Sessionende einen Screenshot, da der Chart sie über Nacht nicht hält.",
        "<strong class='text-white'>Regeln der Firmen variieren</strong>: Tagesverlustlimits, Drawdown und was auf einem Evaluierungskonto angezeigt wird, unterscheiden sich je nach Firma und Kontogröße. Prüfen Sie daher die aktuellen Regeln Ihrer Firma.",
      ],
    },
    { type: "heading",text: "Schluss mit der Detektivarbeit am Tagesende" },
    { type: "paragraph",html: "Im Nachhinein zu rekonstruieren, was Ihre Strategie getan hat, wird schnell lästig. Automatisieren Sie stattdessen die Ausführung: <strong class='text-white'>PickMyTrade leitet Ihre TradingView-Signale direkt an Tradovate weiter</strong> und führt ein sauberes Protokoll jeder ausgelösten Order, damit Ihre Reports ohne manuelle Buchführung vollständig bleiben." },
  ], es: [
    { type: "paragraph",html: "Esto es lo que desconcierta a muchos usuarios de Tradovate: cierra una buena sesión, vuelve a la mañana siguiente para revisar sus entradas y las ejecuciones simplemente ya no están en el gráfico. No se ha roto nada. Tradovate archiva las órdenes, posiciones y ejecuciones de cada día poco después del cierre de la sesión, por lo que <strong class='text-white'>Show Fills</strong> en el gráfico solo muestra el día actual. Sus operaciones no se han perdido, simplemente están guardadas en otro lugar." },
    { type: "quote",html: "<strong>Respuesta rápida:</strong> no es posible mantener las ejecuciones del día anterior fijadas en un gráfico en vivo. Para revisar las operaciones de ayer (o de cualquier día pasado), abra <strong>Reports</strong> y obtenga el informe Performance, Orders o Fills de la fecha que desee. Para ver realmente las operaciones reproducidas en un gráfico, use <strong>Market Replay</strong> con la opción de reproducir sus propias operaciones." },
    { type: "heading",text: "Por qué las operaciones de ayer desaparecen del gráfico" },
    { type: "paragraph",html: "Cuando termina una sesión, Tradovate borra del gráfico las órdenes y ejecuciones de ese día y las archiva en el servidor. Por eso, activar <strong class='text-white'>Show Orders</strong> o <strong class='text-white'>Show Fills</strong> en la configuración del gráfico nunca recupera las marcas de ayer, por mucho que se desplace hacia atrás. Mantener en el gráfico las ejecuciones del día anterior es una función solicitada desde hace tiempo, pero no es como funciona la plataforma hoy. Los datos siguen ahí, y Reports está diseñado para recuperarlos." },
    { type: "heading",text: "Revise sus operaciones en Reports (paso a paso)" },
    {
      type: "steps",
      items: [
        { title: "Abra la ventana Reports", html: "Busque el icono <strong class='text-white'>Reports</strong> en la barra de herramientas. En la plataforma web se encuentra en el lado derecho, y también puede llegar a la misma vista haciendo clic en el área de margen/saldo de la cabecera superior o desde el menú desplegable de la cuenta. Cualquiera de estas opciones abre la página Account Reports, donde están todos los tipos de informe.", image: {"src":`${IMG}/tradovate-previous-day-trades-1.png`,"alt":"Plataforma web de Tradovate con el icono Reports resaltado en la barra de herramientas"} },
        { title: "Elija el informe y establezca el rango de fechas", html: "En la parte superior elegirá el informe que desea. <strong class='text-white'>Performance</strong> es el que la mayoría de los traders usa para revisar operación por operación, pero también dispone de <strong class='text-white'>Orders</strong>, <strong class='text-white'>Fills</strong>, <strong class='text-white'>Position History</strong> y <strong class='text-white'>Cash History</strong> si necesita los registros sin procesar. Defina el periodo con un ajuste predefinido como <strong class='text-white'>Today</strong>, <strong class='text-white'>This Week</strong> o <strong class='text-white'>This Month</strong>, o cambie a <strong class='text-white'>Custom</strong> e introduzca sus propias fechas en <strong class='text-white'>From</strong> y <strong class='text-white'>To</strong>. Haga clic en <strong class='text-white'>Go</strong> para generarlo. Para obtener solo un día pasado, establezca From y To en esa misma fecha.", image: {"src":`${IMG}/tradovate-previous-day-trades-2.png`,"alt":"Página Account Reports de Tradovate con pestañas de informes y un selector de rango de fechas personalizado con From y To"} },
        { title: "Lea el historial de operaciones y expórtelo", html: "El informe Performance comienza con el resumen: P&amp;L neto, número de operaciones, porcentaje de aciertos, run-up y drawdown, además de gráficos de ganancias y pérdidas. Desplácese hacia abajo para ver la lista operación por operación con la entrada, la salida y el P&amp;L de cada una. ¿Quiere llevarlo a su diario? Use la opción de descarga para exportar como <strong class='text-white'>CSV</strong> o <strong class='text-white'>PDF</strong>. Una advertencia: la exportación de operaciones utiliza cifras brutas, así que si el total no coincide con su saldo, obtenga el informe <strong class='text-white'>Cash History</strong> de las mismas fechas y concilie las comisiones y tarifas.", image: {"src":`${IMG}/tradovate-previous-day-trades-3.png`,"alt":"Informe Performance de Tradovate con resumen de P&L y un historial desplazable de operación por operación"} },
        { title: "Reproduzca las operaciones en un gráfico con Market Replay", html: "Los informes le dan los números, pero si quiere ver las operaciones en el gráfico tal como se desarrollaron, use <strong class='text-white'>Market Replay</strong>. Establezca la fecha y hora de inicio en la sesión que está revisando, elija su cuenta e inicie la reproducción; hay una opción para reproducir sus propias operaciones, de modo que sus entradas y salidas aparecen a medida que se mueven las velas. Una salvedad: la disponibilidad de Replay depende de su plan y, en algunas cuentas de fondeo o de evaluación, el selector de cuenta puede estar limitado, por lo que Reports sigue siendo la alternativa fiable.", image: {"src":`${IMG}/tradovate-previous-day-trades-4.png`,"alt":"Configuración de Market Replay de Tradovate con fecha de inicio, selector de cuenta y la opción de reproducir sus propias operaciones"} },
      ],
    },
    { type: "heading",text: "Un par de cosas que conviene saber" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Cuentas de fondeo y de evaluación</strong>: sus datos de operaciones siguen en Reports aunque Replay esté restringido, así que use los informes Performance y Fills para la revisión.",
        "<strong class='text-white'>Guárdelas antes de que se borren</strong>: si quiere conservar las ejecuciones en el gráfico en vivo, haga una captura de pantalla antes del cierre de la sesión, ya que el gráfico no las mantiene durante la noche.",
        "<strong class='text-white'>Las reglas de cada firma varían</strong>: los límites de pérdida diaria, el drawdown y lo que aparece en una cuenta de evaluación difieren según la firma y el tamaño de la cuenta, así que consulte las reglas vigentes de su firma.",
      ],
    },
    { type: "heading",text: "Olvídese del trabajo de detective al final del día" },
    { type: "paragraph",html: "Reconstruir lo que hizo su estrategia después de los hechos agota rápidamente. Automatice la ejecución en su lugar: <strong class='text-white'>PickMyTrade envía sus señales de TradingView directamente a Tradovate</strong> y mantiene un registro limpio de cada orden que dispara, de modo que sus informes permanecen completos sin llevar la contabilidad a mano." },
  ], fr: [
    { type: "paragraph",html: "Voici ce qui déconcerte beaucoup d’utilisateurs de Tradovate : vous terminez une bonne séance, revenez le lendemain matin pour analyser vos entrées, et les exécutions ont tout simplement disparu du graphique. Rien n’est cassé. Tradovate archive les ordres, les positions et les exécutions de chaque journée peu après la clôture de la séance, de sorte que <strong class='text-white'>Show Fills</strong> sur le graphique n’affiche que le jour en cours. Vos trades ne sont pas perdus, simplement stockés ailleurs." },
    { type: "quote",html: "<strong>Réponse rapide :</strong> il n’est pas possible de conserver les exécutions de la veille sur un graphique en direct. Pour consulter les trades d’hier (ou de n’importe quel jour passé), ouvrez <strong>Reports</strong> et générez le rapport Performance, Orders ou Fills pour la date souhaitée. Pour voir réellement les trades se rejouer sur un graphique, utilisez <strong>Market Replay</strong> avec l’option de rejouer vos propres trades." },
    { type: "heading",text: "Pourquoi les trades d’hier disparaissent du graphique" },
    { type: "paragraph",html: "Une fois la séance terminée, Tradovate retire du graphique les ordres et les exécutions de cette journée et les archive sur le serveur. C’est pourquoi activer <strong class='text-white'>Show Orders</strong> ou <strong class='text-white'>Show Fills</strong> dans les paramètres du graphique ne ramène jamais les repères d’hier, peu importe jusqu’où vous faites défiler. Conserver les exécutions de la veille sur le graphique est une demande de fonctionnalité de longue date, mais ce n’est pas le fonctionnement actuel de la plateforme. Les données sont toujours là, et Reports est conçu pour les récupérer." },
    { type: "heading",text: "Consulter vos trades dans Reports (pas à pas)" },
    {
      type: "steps",
      items: [
        { title: "Ouvrir la fenêtre Reports", html: "Repérez l’icône <strong class='text-white'>Reports</strong> dans la barre d’outils. Sur la plateforme web, elle se trouve sur le côté droit, et vous pouvez aussi accéder à la même vue en cliquant sur la zone de marge/solde dans l’en-tête supérieur ou depuis le menu déroulant du compte. L’un ou l’autre ouvre la page Account Reports, où se trouvent tous les types de rapports.", image: {"src":`${IMG}/tradovate-previous-day-trades-1.png`,"alt":"Plateforme web Tradovate avec l’icône Reports mise en évidence dans la barre d’outils"} },
        { title: "Choisir le rapport et définir la plage de dates", html: "En haut, vous choisissez le rapport souhaité. <strong class='text-white'>Performance</strong> est celui que la plupart des traders utilisent pour une analyse trade par trade, mais vous disposez aussi de <strong class='text-white'>Orders</strong>, <strong class='text-white'>Fills</strong>, <strong class='text-white'>Position History</strong> et <strong class='text-white'>Cash History</strong> si vous avez besoin des enregistrements bruts. Définissez la période avec un préréglage comme <strong class='text-white'>Today</strong>, <strong class='text-white'>This Week</strong> ou <strong class='text-white'>This Month</strong>, ou passez à <strong class='text-white'>Custom</strong> et saisissez vos propres dates dans <strong class='text-white'>From</strong> et <strong class='text-white'>To</strong>. Cliquez sur <strong class='text-white'>Go</strong> pour générer le rapport. Pour n’obtenir qu’un seul jour passé, réglez From et To sur cette même date.", image: {"src":`${IMG}/tradovate-previous-day-trades-2.png`,"alt":"Page Account Reports de Tradovate avec les onglets de rapports et un sélecteur de plage de dates personnalisée From et To"} },
        { title: "Lire l’historique des trades et l’exporter", html: "Le rapport Performance s’ouvre sur le résumé : P&amp;L net, nombre de trades, taux de réussite, run-up et drawdown, ainsi que des graphiques de gains et pertes. Faites défiler pour voir la liste trade par trade avec l’entrée, la sortie et le P&amp;L de chacun. Vous souhaitez l’intégrer à votre journal ? Utilisez l’option de téléchargement pour exporter en <strong class='text-white'>CSV</strong> ou en <strong class='text-white'>PDF</strong>. Un point d’attention : l’export des trades repose sur des chiffres bruts ; si le total semble différer de votre solde, générez le rapport <strong class='text-white'>Cash History</strong> pour les mêmes dates et rapprochez les commissions et frais.", image: {"src":`${IMG}/tradovate-previous-day-trades-3.png`,"alt":"Rapport Performance de Tradovate affichant le résumé du P&L et un historique des trades défilant trade par trade"} },
        { title: "Rejouer les trades sur un graphique avec Market Replay", html: "Les rapports vous donnent les chiffres, mais pour voir les trades sur le graphique tels qu’ils se sont déroulés, utilisez <strong class='text-white'>Market Replay</strong>. Définissez la date et l’heure de début sur la séance que vous analysez, choisissez votre compte et lancez le replay ; une option permet de rejouer vos propres trades afin que vos entrées et sorties apparaissent au fil des bougies. Une réserve : la disponibilité de Replay dépend de votre formule et, sur certains comptes prop ou d’évaluation, le sélecteur de compte peut être limité ; Reports reste donc l’alternative fiable.", image: {"src":`${IMG}/tradovate-previous-day-trades-4.png`,"alt":"Configuration de Market Replay de Tradovate avec date de début, sélecteur de compte et option de rejouer ses propres trades"} },
      ],
    },
    { type: "heading",text: "Quelques points à connaître" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Comptes prop et d’évaluation</strong> : vos données de trades restent disponibles dans Reports même lorsque Replay est restreint ; utilisez donc les rapports Performance et Fills pour l’analyse.",
        "<strong class='text-white'>Capturez avant l’archivage</strong> : si vous voulez conserver les exécutions sur le graphique en direct, faites une capture d’écran avant la clôture de la séance, car le graphique ne les conserve pas pendant la nuit.",
        "<strong class='text-white'>Les règles des sociétés varient</strong> : les limites de perte quotidienne, le drawdown et ce qui s’affiche sur un compte d’évaluation diffèrent selon la société et la taille du compte ; vérifiez donc les règles en vigueur de votre société.",
      ],
    },
    { type: "heading",text: "Fini le travail de détective en fin de journée" },
    { type: "paragraph",html: "Reconstituer après coup ce qu’a fait votre stratégie devient vite pénible. Automatisez plutôt l’exécution : <strong class='text-white'>PickMyTrade achemine vos signaux TradingView directement vers Tradovate</strong> et conserve un historique clair de chaque ordre déclenché, afin que vos rapports restent complets sans comptabilité manuelle." },
  ], it: [
    { type: "paragraph",html: "Ecco cosa mette in difficoltà molti utenti di Tradovate: chiude una buona sessione, torna la mattina dopo per rivedere le sue entrate e le esecuzioni sono semplicemente sparite dal grafico. Non si è rotto nulla. Tradovate archivia gli ordini, le posizioni e le esecuzioni di ogni giorno subito dopo la chiusura della sessione, quindi <strong class='text-white'>Show Fills</strong> sul grafico mostra soltanto il giorno corrente. I suoi trade non sono persi, sono solo conservati altrove." },
    { type: "quote",html: "<strong>Risposta rapida:</strong> non è possibile mantenere le esecuzioni del giorno precedente fissate su un grafico live. Per rivedere i trade di ieri (o di qualsiasi giorno passato), apra <strong>Reports</strong> ed estragga il report Performance, Orders o Fills per la data desiderata. Per vedere davvero i trade riprodotti su un grafico, utilizzi <strong>Market Replay</strong> con l’opzione per riprodurre i suoi trade." },
    { type: "heading",text: "Perché i trade di ieri scompaiono dal grafico" },
    { type: "paragraph",html: "Al termine di una sessione, Tradovate rimuove dal grafico gli ordini e le esecuzioni di quel giorno e li archivia sul server. Per questo attivare <strong class='text-white'>Show Orders</strong> o <strong class='text-white'>Show Fills</strong> nelle impostazioni del grafico non riporta mai i segnalini di ieri, per quanto indietro scorra. Mantenere sul grafico le esecuzioni del giorno precedente è una richiesta di funzionalità di lunga data, ma non è il modo in cui la piattaforma funziona oggi. I dati sono ancora lì, e Reports è fatto per recuperarli." },
    { type: "heading",text: "Rivedere i trade in Reports (passo dopo passo)" },
    {
      type: "steps",
      items: [
        { title: "Aprire la finestra Reports", html: "Cerchi l’icona <strong class='text-white'>Reports</strong> nella barra degli strumenti. Sulla piattaforma web si trova sul lato destro, e può raggiungere la stessa vista anche cliccando sull’area di margine/saldo nell’intestazione superiore o dal menu a discesa del conto. Qualsiasi di queste opzioni apre la pagina Account Reports, dove si trovano tutti i tipi di report.", image: {"src":`${IMG}/tradovate-previous-day-trades-1.png`,"alt":"Piattaforma web di Tradovate con l’icona Reports evidenziata nella barra degli strumenti"} },
        { title: "Scegliere il report e impostare l’intervallo di date", html: "In alto sceglierà il report desiderato. <strong class='text-white'>Performance</strong> è quello che la maggior parte dei trader usa per una revisione trade per trade, ma sono disponibili anche <strong class='text-white'>Orders</strong>, <strong class='text-white'>Fills</strong>, <strong class='text-white'>Position History</strong> e <strong class='text-white'>Cash History</strong> se ha bisogno dei registri grezzi. Imposti il periodo con un preset come <strong class='text-white'>Today</strong>, <strong class='text-white'>This Week</strong> o <strong class='text-white'>This Month</strong>, oppure passi a <strong class='text-white'>Custom</strong> e inserisca le sue date in <strong class='text-white'>From</strong> e <strong class='text-white'>To</strong>. Clicchi su <strong class='text-white'>Go</strong> per generarlo. Per estrarre un solo giorno passato, imposti From e To sulla stessa data.", image: {"src":`${IMG}/tradovate-previous-day-trades-2.png`,"alt":"Pagina Account Reports di Tradovate con schede dei report e selettore dell’intervallo di date personalizzato From e To"} },
        { title: "Leggere lo storico dei trade ed esportarlo", html: "Il report Performance si apre con il riepilogo: P&amp;L netto, numero di trade, percentuale di successo, run-up e drawdown, oltre ai grafici di profitti e perdite. Scorra verso il basso per l’elenco trade per trade con entrata, uscita e P&amp;L di ciascuno. Vuole inserirlo nel suo journal? Usi l’opzione di download per esportare in <strong class='text-white'>CSV</strong> o <strong class='text-white'>PDF</strong>. Un avviso: l’esportazione dei trade si basa su cifre lorde, quindi se il totale non coincide con il suo saldo, estragga il report <strong class='text-white'>Cash History</strong> per le stesse date e riconcili commissioni e spese.", image: {"src":`${IMG}/tradovate-previous-day-trades-3.png`,"alt":"Report Performance di Tradovate con riepilogo del P&L e storico dei trade scorrevole trade per trade"} },
        { title: "Riprodurre i trade sul grafico con Market Replay", html: "I report forniscono i numeri, ma se vuole vedere i trade sul grafico così come si sono svolti, utilizzi <strong class='text-white'>Market Replay</strong>. Imposti data e ora di inizio sulla sessione che sta rivedendo, scelga il suo conto e avvii la riproduzione; c’è un’opzione per riprodurre i suoi trade, così le sue entrate e uscite compaiono mentre le candele si muovono. Un’avvertenza: la disponibilità di Replay dipende dal suo piano e, su alcuni conti prop o di valutazione, il selettore del conto può essere limitato, quindi Reports resta l’alternativa affidabile.", image: {"src":`${IMG}/tradovate-previous-day-trades-4.png`,"alt":"Configurazione di Market Replay di Tradovate con data di inizio, selettore del conto e opzione per riprodurre i propri trade"} },
      ],
    },
    { type: "heading",text: "Un paio di cose utili da sapere" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Conti prop e di valutazione</strong>: i dati dei suoi trade restano in Reports anche quando Replay è limitato, quindi usi i report Performance e Fills per la revisione.",
        "<strong class='text-white'>Li estragga prima che vengano archiviati</strong>: se vuole le esecuzioni sul grafico live, faccia uno screenshot prima della chiusura della sessione, poiché il grafico non le conserva durante la notte.",
        "<strong class='text-white'>Le regole delle società variano</strong>: i limiti di perdita giornaliera, il drawdown e ciò che compare su un conto di valutazione differiscono in base alla società e alla dimensione del conto, quindi controlli le regole attuali della sua società.",
      ],
    },
    { type: "heading",text: "Basta con il lavoro da detective a fine giornata" },
    { type: "paragraph",html: "Ricostruire a posteriori ciò che ha fatto la sua strategia stanca in fretta. Automatizzi invece l’esecuzione: <strong class='text-white'>PickMyTrade instrada i suoi segnali di TradingView direttamente su Tradovate</strong> e conserva un registro ordinato di ogni ordine inviato, così i suoi report restano completi senza contabilità manuale." },
  ] },
  ctaHeading: { en: "Skip the End-of-Day Detective Work", de: "Schluss mit der Detektivarbeit am Tagesende", es: "Olvídese del trabajo de detective al final del día", fr: "Fini le travail de détective en fin de journée", it: "Basta con il lavoro da detective a fine giornata" },
  ctaText: { en: "Let PickMyTrade route your TradingView signals straight to Tradovate and keep a clean record of every order it fires.", de: "Lassen Sie PickMyTrade Ihre TradingView-Signale direkt an Tradovate weiterleiten und ein sauberes Protokoll jeder ausgelösten Order führen.", es: "Deje que PickMyTrade envíe sus señales de TradingView directamente a Tradovate y mantenga un registro limpio de cada orden que dispare.", fr: "Laissez PickMyTrade acheminer vos signaux TradingView directement vers Tradovate et conserver un historique clair de chaque ordre déclenché.", it: "Lasci che PickMyTrade instradi i suoi segnali di TradingView direttamente su Tradovate e conservi un registro ordinato di ogni ordine inviato." },
  ctaButtonText: { en: "Start Your Free 7-Day Trial", de: "Starten Sie Ihre kostenlose 7-Tage-Testphase", es: "Comience su prueba gratuita de 7 días", fr: "Commencez votre essai gratuit de 7 jours", it: "Inizi la prova gratuita di 7 giorni" },
  ctaUrl: "https://app.pickmytrade.trade/?register=true&utm_source=content&utm_medium=how-to",
  faqHeading: { en: "Frequently Asked Questions", de: "Häufig gestellte Fragen", es: "Preguntas frecuentes", fr: "Questions fréquentes", it: "Domande frequenti" },
  faqs: { en: [
    { q: "Why did my trades disappear from the Tradovate chart?", a: "Tradovate archives each day's orders and fills shortly after the session ends, so the chart only shows the current day. The trades aren't deleted; open Reports to review them by date." },
    { q: "Where can I see yesterday's Tradovate trades?", a: "Open the Reports window and run the Performance, Orders, or Fills report with the date range set to yesterday. You'll get the full trade list plus P&L, and you can export it as CSV or PDF." },
    { q: "Can I see my old trades back on a chart?", a: "Yes, through Market Replay. Set the start date to the session you want, choose your account, and enable the option to play back your own trades. Availability depends on your plan and account type." },
  ], de: [
    { q: "Warum sind meine Trades aus dem Tradovate-Chart verschwunden?", a: "Tradovate archiviert die Orders und Fills eines Tages kurz nach Sessionende, daher zeigt der Chart nur den aktuellen Tag. Die Trades werden nicht gelöscht; öffnen Sie Reports, um sie nach Datum einzusehen." },
    { q: "Wo kann ich die Tradovate-Trades von gestern sehen?", a: "Öffnen Sie das Fenster Reports und führen Sie den Report Performance, Orders oder Fills mit dem Datumsbereich „gestern“ aus. Sie erhalten die vollständige Tradeliste samt P&L und können sie als CSV oder PDF exportieren." },
    { q: "Kann ich meine alten Trades wieder in einem Chart sehen?", a: "Ja, über Market Replay. Legen Sie das Startdatum auf die gewünschte Session, wählen Sie Ihr Konto und aktivieren Sie die Option, Ihre eigenen Trades abzuspielen. Die Verfügbarkeit hängt von Ihrem Plan und Kontotyp ab." },
  ], es: [
    { q: "¿Por qué desaparecieron mis operaciones del gráfico de Tradovate?", a: "Tradovate archiva las órdenes y ejecuciones de cada día poco después de terminar la sesión, por lo que el gráfico solo muestra el día actual. Las operaciones no se eliminan; abra Reports para revisarlas por fecha." },
    { q: "¿Dónde puedo ver las operaciones de ayer en Tradovate?", a: "Abra la ventana Reports y ejecute el informe Performance, Orders o Fills con el rango de fechas establecido en ayer. Obtendrá la lista completa de operaciones con el P&L, y podrá exportarla como CSV o PDF." },
    { q: "¿Puedo volver a ver mis operaciones antiguas en un gráfico?", a: "Sí, mediante Market Replay. Establezca la fecha de inicio en la sesión que desee, elija su cuenta y active la opción para reproducir sus propias operaciones. La disponibilidad depende de su plan y tipo de cuenta." },
  ], fr: [
    { q: "Pourquoi mes trades ont-ils disparu du graphique Tradovate ?", a: "Tradovate archive les ordres et les exécutions de chaque journée peu après la fin de la séance, c’est pourquoi le graphique n’affiche que le jour en cours. Les trades ne sont pas supprimés ; ouvrez Reports pour les consulter par date." },
    { q: "Où puis-je voir les trades d’hier sur Tradovate ?", a: "Ouvrez la fenêtre Reports et lancez le rapport Performance, Orders ou Fills avec la plage de dates réglée sur hier. Vous obtiendrez la liste complète des trades ainsi que le P&L, et vous pourrez l’exporter en CSV ou en PDF." },
    { q: "Puis-je revoir mes anciens trades sur un graphique ?", a: "Oui, via Market Replay. Définissez la date de début sur la séance souhaitée, choisissez votre compte et activez l’option permettant de rejouer vos propres trades. La disponibilité dépend de votre formule et de votre type de compte." },
  ], it: [
    { q: "Perché i miei trade sono scomparsi dal grafico di Tradovate?", a: "Tradovate archivia gli ordini e le esecuzioni di ogni giorno subito dopo la fine della sessione, quindi il grafico mostra solo il giorno corrente. I trade non vengono eliminati; apra Reports per consultarli per data." },
    { q: "Dove posso vedere i trade di ieri su Tradovate?", a: "Apra la finestra Reports ed esegua il report Performance, Orders o Fills con l’intervallo di date impostato su ieri. Otterrà l’elenco completo dei trade insieme al P&L e potrà esportarlo in CSV o PDF." },
    { q: "Posso rivedere i miei vecchi trade su un grafico?", a: "Sì, tramite Market Replay. Imposti la data di inizio sulla sessione desiderata, scelga il suo conto e attivi l’opzione per riprodurre i suoi trade. La disponibilità dipende dal suo piano e dal tipo di conto." },
  ] },
  relatedHeading: { en: "Related Guides", de: "Verwandte Leitfäden", es: "Guías relacionadas", fr: "Guides associés", it: "Guide correlate" },
  disclosureText: { en: `This guide is for educational and informational purposes only and is not financial, investment, or trading advice. Trading futures and other leveraged products carries a substantial risk of loss and is not suitable for every investor. PickMyTrade is an independent third-party automation platform and is not affiliated with, endorsed by, or sponsored by Tradovate, Inc. "Tradovate" and all related names, logos, and trademarks are the property of their respective owners. Platform features and steps change over time, so always confirm the current process in the official Tradovate platform and documentation before acting.`, de: "Dieser Leitfaden dient ausschließlich Bildungs- und Informationszwecken und stellt keine Finanz-, Anlage- oder Handelsberatung dar. Der Handel mit Futures und anderen gehebelten Produkten birgt ein erhebliches Verlustrisiko und ist nicht für jeden Anleger geeignet. PickMyTrade ist eine unabhängige Automatisierungsplattform eines Drittanbieters und steht in keiner Verbindung zu Tradovate, Inc., wird von dieser weder unterstützt noch gesponsert. „Tradovate“ und alle zugehörigen Namen, Logos und Marken sind Eigentum ihrer jeweiligen Inhaber. Funktionen und Schritte der Plattform ändern sich im Laufe der Zeit; bestätigen Sie daher vor jeder Handlung stets den aktuellen Ablauf in der offiziellen Tradovate-Plattform und -Dokumentation.", es: "Esta guía tiene fines exclusivamente educativos e informativos y no constituye asesoramiento financiero, de inversión ni de trading. Operar con futuros y otros productos apalancados conlleva un riesgo sustancial de pérdida y no es adecuado para todos los inversores. PickMyTrade es una plataforma de automatización independiente de terceros y no está afiliada, respaldada ni patrocinada por Tradovate, Inc. «Tradovate» y todos los nombres, logotipos y marcas relacionados son propiedad de sus respectivos titulares. Las funciones y los pasos de la plataforma cambian con el tiempo, así que confirme siempre el proceso vigente en la plataforma y la documentación oficiales de Tradovate antes de actuar.", fr: "Ce guide est fourni à des fins strictement éducatives et informatives et ne constitue pas un conseil financier, d’investissement ou de trading. Le trading de contrats à terme et d’autres produits à effet de levier comporte un risque de perte important et ne convient pas à tous les investisseurs. PickMyTrade est une plateforme d’automatisation tierce indépendante et n’est ni affiliée à Tradovate, Inc., ni approuvée ou parrainée par celle-ci. « Tradovate » ainsi que tous les noms, logos et marques associés sont la propriété de leurs détenteurs respectifs. Les fonctionnalités et les étapes de la plateforme évoluent avec le temps ; vérifiez donc toujours la procédure en vigueur dans la plateforme et la documentation officielles de Tradovate avant d’agir.", it: "Questa guida ha esclusivamente scopo educativo e informativo e non costituisce consulenza finanziaria, di investimento o di trading. Il trading di futures e di altri prodotti a leva comporta un rischio di perdita significativo e non è adatto a tutti gli investitori. PickMyTrade è una piattaforma di automazione indipendente di terze parti e non è affiliata a Tradovate, Inc., né approvata o sponsorizzata da essa. “Tradovate” e tutti i nomi, loghi e marchi correlati sono di proprietà dei rispettivi titolari. Le funzionalità e i passaggi della piattaforma cambiano nel tempo, perciò verifichi sempre la procedura attuale nella piattaforma e nella documentazione ufficiali di Tradovate prima di agire." },
};
const data: GuideArticleData = resolveGuideContent(content, locale, related);

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: data.faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: `${SITE_URL}${withSlash(localizedPath(locale))}` },
    { "@type": "ListItem", position: 2, name: "How-To", item: `${SITE_URL}${withSlash(localizedPath(locale, "how-to"))}` },
    { "@type": "ListItem", position: 3, name: content.h1[locale], item: `${SITE_URL}${withSlash(localizedPath(locale, `how-to/${SLUG}`))}` },
  ],
};

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: content.h1[locale],
  description: content.dek[locale],
  image: `${SITE_URL}${IMG}/tradovate-previous-day-trades-1.png`,
  publisher: { "@type": "Organization", name: "PickMyTrade", logo: { "@type": "ImageObject", url: `${SITE_URL}/assets/logo.png` } },
  datePublished: "2026-07-10",
  dateModified: "2026-07-10",
  mainEntityOfPage: { "@type": "WebPage", "@id": `${SITE_URL}${withSlash(localizedPath(locale, `how-to/${SLUG}`))}` },
};
---

<BaseLayout
  locale={locale}
