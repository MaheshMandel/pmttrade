---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "tradovate-service-status";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/how-to/${SLUG}`;

const META_TITLE = "Check Tradovate Service Status When It Won't Load";
const META_DESCRIPTION =
  "Tradovate won't load? Check the service status page first to see if the servers are down before you troubleshoot or reinstall your own setup.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Tradovate-Servicestatus prüfen, wenn die Plattform nicht lädt", es: "Compruebe el estado del servicio de Tradovate cuando no carga", fr: "Vérifier l'état du service Tradovate quand la plateforme ne se charge pas", it: "Controllare lo stato del servizio Tradovate quando non si carica" },
  dek: { en: "Login screen spinning and nothing comes up? Check Tradovate's status page first, it takes thirty seconds to rule out a platform-wide outage.", de: "Der Login-Bildschirm dreht sich und nichts erscheint? Prüfen Sie zuerst die Statusseite von Tradovate. In dreißig Sekunden wissen Sie, ob ein plattformweiter Ausfall vorliegt.", es: "¿La pantalla de inicio de sesión da vueltas y no aparece nada? Revise primero la página de estado de Tradovate: en treinta segundos descarta una caída de toda la plataforma.", fr: "L'écran de connexion tourne dans le vide ? Consultez d'abord la page d'état de Tradovate : en trente secondes, vous saurez s'il s'agit d'une panne générale de la plateforme.", it: "La schermata di accesso gira a vuoto e non compare nulla? Controlli prima la pagina di stato di Tradovate: in trenta secondi esclude un'interruzione dell'intera piattaforma." },
  readTime: { en: "5 min read", de: "5 Min. Lesezeit", es: "Lectura de 5 min", fr: "Lecture : 5 min", it: "Lettura di 5 min" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "You click the shortcut, the login screen spins, and nothing comes up. Before you reinstall the app or start blaming your machine, find out whether Tradovate's own servers are up. There's a status page built for exactly this, and it takes about thirty seconds to rule out a platform-wide outage. If the servers are down, no amount of local troubleshooting will help, you wait. If they're green, the problem's on your end, and now you know where to look." },
    { type: "heading", text: "Where Tradovate's Status Page Lives" },
    { type: "paragraph", html: "Two places show you the same thing from different angles." },
    { type: "paragraph", html: "The main one sits at <strong class='text-white'>status.tradovate.com</strong>. It's a public dashboard headed <em>Current System Status</em>, and it lists roughly thirty services: live and demo frontend access, order execution, risk and routing, market data, notifications, funding and payments, plus a row for each funding partner. You don't need to be logged in to see it, which is the whole point when the login is what's broken." },
    { type: "paragraph", html: "There's also a <strong class='text-white'>service status</strong> link on the Tradovate login screen itself, usually near the bottom. If you log in through a prop firm, your platform runs on a branded address, something like <code>topstep.tradovate.com</code> or <code>axia.tradovate.com</code>, and each one carries its own <code>/service-status</code> page. Open the one that matches the URL you actually sign in through." },
    { type: "heading", text: "Check the Status Page: Step-by-Step" },
    {
      type: "steps",
      items: [
        { title: "Open the Status Page", html: "Type <strong class='text-white'>status.tradovate.com</strong> into your browser, or click the service status link at the bottom of the login screen. Do this in a regular browser tab, not inside the desktop app. If the app won't open, you need a route that doesn't depend on it." },
        { title: "Read the Indicators and Find Your Service", html: "A <strong class='text-white'>green dot</strong> means that service is up and healthy. Scan for the rows that actually matter to you: live frontend access (that's the platform loading), execution, and market data. If your row is green, Tradovate is saying that piece is running normally. If it's flagged, that's your answer, you're looking at an outage, not a broken install." },
        { title: "Check Your Prop Firm's Status", html: "Trading a funded or evaluation account? Look at the funding-partner section, or open your firm's own branded status page. A firm-side connection can be down even when Tradovate's core services are green, and that part is on the firm to fix, not you. Confirm the outage first so you're not chasing a problem that isn't yours." },
        { title: "If Everything's Green, Fix It Locally", html: "When every relevant service shows up and healthy, the problem is on your side. The quick things that clear most local load failures:<br><br><strong class='text-white'>Use a current browser</strong> &mdash; Chrome, Firefox, or Safari, fully updated. Skip Internet Explorer entirely.<br><strong class='text-white'>Check your connection</strong> &mdash; and switch to a wired link if your Wi-Fi is flaky.<br><strong class='text-white'>Sync your computer's clock.</strong> A wrong system time is a classic reason the platform refuses to load, set the correct time zone and turn on automatic time.<br><strong class='text-white'>Reinstall the desktop app</strong> if it's corrupted, or just fall back to the web or mobile version so you can keep trading while you sort it out." },
      ],
    },
    { type: "heading", text: "What the Status Page Is Telling You" },
    {
      type: "table",
      headers: ["What you see", "What it means", "What to do"],
      rows: [
        ["Green dot on your service", "Servers are running normally", "Troubleshoot locally, browser, clock, connection"],
        ["A core service flagged or down", "Platform-side outage", "Wait it out; watch open positions from another device"],
        ["Your prop firm's row flagged", "Firm-side connection issue", "Contact your prop firm, Tradovate can't fix it"],
      ],
    },
    { type: "heading", text: "Automate This with PickMyTrade" },
    { type: "paragraph", html: "Once the platform's stable again, you shouldn't have to babysit the screen to catch a signal. <strong class='text-white'>PickMyTrade fires your TradingView alerts straight into Tradovate</strong>, so a slow-loading chart never turns into a missed entry." },
    { type: "paragraph", html: "If the status page confirms an outage, our walkthroughs on a platform that freezes mid-trade and a login stuck on loading cover what to do next. Not sure which app to fall back on while you wait? Compare the web, desktop, and mobile options." },
  ], de: [
    { type: "paragraph",html: "Sie klicken auf die Verknüpfung, der Login-Bildschirm dreht sich, und nichts kommt. Bevor Sie die App neu installieren oder Ihrem Rechner die Schuld geben, finden Sie heraus, ob die Server von Tradovate selbst laufen. Dafür gibt es eine Statusseite, und es dauert etwa dreißig Sekunden, einen plattformweiten Ausfall auszuschließen. Sind die Server down, hilft keine lokale Fehlersuche, Sie warten. Sind sie grün, liegt das Problem bei Ihnen, und Sie wissen, wo Sie suchen müssen." },
    { type: "heading",text: "Wo sich die Statusseite von Tradovate befindet" },
    { type: "paragraph",html: "Zwei Stellen zeigen Ihnen dasselbe aus unterschiedlichen Blickwinkeln." },
    { type: "paragraph",html: "Die wichtigste befindet sich unter <strong class='text-white'>status.tradovate.com</strong>. Es ist ein öffentliches Dashboard mit der Überschrift <em>Current System Status</em>, das rund dreißig Dienste auflistet: Live- und Demo-Frontend-Zugang, Orderausführung, Risiko und Routing, Marktdaten, Benachrichtigungen, Finanzierung und Zahlungen sowie eine Zeile für jeden Finanzierungspartner. Sie müssen nicht angemeldet sein, um es zu sehen. Genau das ist der Punkt, wenn der Login das Problem ist." },
    { type: "paragraph",html: "Außerdem gibt es auf dem Tradovate-Login-Bildschirm selbst einen Link <strong class='text-white'>service status</strong>, meist weiter unten. Wenn Sie sich über eine Prop-Firma anmelden, läuft Ihre Plattform unter einer eigenen Adresse, etwa <code>topstep.tradovate.com</code> oder <code>axia.tradovate.com</code>, und jede davon hat ihre eigene <code>/service-status</code>-Seite. Öffnen Sie die Seite, die zu der URL passt, über die Sie sich tatsächlich anmelden." },
    { type: "heading",text: "Statusseite prüfen: Schritt für Schritt" },
    {
      type: "steps",
      items: [
        { title: "Statusseite öffnen", html: "Geben Sie <strong class='text-white'>status.tradovate.com</strong> in Ihren Browser ein oder klicken Sie unten im Login-Bildschirm auf den Link service status. Tun Sie dies in einem normalen Browser-Tab und nicht in der Desktop-App. Wenn sich die App nicht öffnet, brauchen Sie einen Weg, der nicht von ihr abhängt." },
        { title: "Indikatoren lesen und Ihren Dienst finden", html: "Ein <strong class='text-white'>grüner Punkt</strong> bedeutet, dass der Dienst läuft und in Ordnung ist. Suchen Sie die Zeilen, die für Sie wirklich wichtig sind: Live-Frontend-Zugang (das ist das Laden der Plattform), Ausführung und Marktdaten. Ist Ihre Zeile grün, meldet Tradovate, dass dieser Teil normal läuft. Ist sie markiert, haben Sie Ihre Antwort: Es handelt sich um einen Ausfall und nicht um eine defekte Installation." },
        { title: "Status Ihrer Prop-Firma prüfen", html: "Handeln Sie ein finanziertes Konto oder ein Evaluierungskonto? Sehen Sie sich den Abschnitt der Finanzierungspartner an oder öffnen Sie die eigene Statusseite Ihrer Firma. Eine firmenseitige Verbindung kann ausfallen, obwohl die Kerndienste von Tradovate grün sind, und das muss die Firma beheben, nicht Sie. Bestätigen Sie zuerst den Ausfall, damit Sie kein Problem jagen, das nicht Ihres ist." },
        { title: "Wenn alles grün ist, lokal beheben", html: "Wenn alle relevanten Dienste verfügbar und in Ordnung sind, liegt das Problem bei Ihnen. Diese schnellen Maßnahmen beheben die meisten lokalen Ladefehler:<br><br><strong class='text-white'>Aktuellen Browser verwenden</strong> &mdash; Chrome, Firefox oder Safari, vollständig aktualisiert. Den Internet Explorer lassen Sie komplett weg.<br><strong class='text-white'>Verbindung prüfen</strong> &mdash; und wechseln Sie auf eine Kabelverbindung, wenn Ihr WLAN unzuverlässig ist.<br><strong class='text-white'>Uhr Ihres Computers synchronisieren.</strong> Eine falsche Systemzeit ist ein klassischer Grund dafür, dass die Plattform nicht lädt. Stellen Sie die richtige Zeitzone ein und aktivieren Sie die automatische Zeit.<br><strong class='text-white'>Desktop-App neu installieren</strong>, wenn sie beschädigt ist, oder weichen Sie einfach auf die Web- oder Mobilversion aus, damit Sie weiterhandeln können, während Sie das Problem lösen." },
      ],
    },
    { type: "heading",text: "Was Ihnen die Statusseite sagt" },
    { type: "table", headers: ["Was Sie sehen","Was es bedeutet","Was zu tun ist"], rows: [
      ["Grüner Punkt bei Ihrem Dienst","Die Server laufen normal","Lokal Fehler suchen: Browser, Uhr, Verbindung"],
      ["Ein Kerndienst ist markiert oder ausgefallen","Ausfall auf Plattformseite","Abwarten; offene Positionen von einem anderen Gerät aus beobachten"],
      ["Die Zeile Ihrer Prop-Firma ist markiert","Verbindungsproblem auf Firmenseite","Wenden Sie sich an Ihre Prop-Firma, Tradovate kann das nicht beheben"],
    ] },
    { type: "heading",text: "Mit PickMyTrade automatisieren" },
    { type: "paragraph",html: "Sobald die Plattform wieder stabil läuft, sollten Sie nicht mehr den Bildschirm überwachen müssen, um ein Signal zu erwischen. <strong class='text-white'>PickMyTrade leitet Ihre TradingView-Alerts direkt an Tradovate weiter</strong>, sodass aus einem langsam ladenden Chart nie ein verpasster Einstieg wird." },
    { type: "paragraph",html: "Wenn die Statusseite einen Ausfall bestätigt, zeigen unsere Anleitungen zu einer Plattform, die mitten im Trade einfriert, und zu einem Login, der beim Laden hängen bleibt, was Sie als Nächstes tun können. Sie wissen nicht, auf welche App Sie während der Wartezeit ausweichen sollen? Vergleichen Sie die Web-, Desktop- und Mobiloptionen." },
  ], es: [
    { type: "paragraph",html: "Hace clic en el acceso directo, la pantalla de inicio de sesión da vueltas y no aparece nada. Antes de reinstalar la aplicación o culpar a su equipo, averigüe si los propios servidores de Tradovate están operativos. Existe una página de estado hecha justo para esto, y le lleva unos treinta segundos descartar una caída de toda la plataforma. Si los servidores están caídos, ninguna solución local ayudará: toca esperar. Si están en verde, el problema está de su lado y ya sabe dónde buscar." },
    { type: "heading",text: "Dónde está la página de estado de Tradovate" },
    { type: "paragraph",html: "Dos lugares le muestran lo mismo desde ángulos distintos." },
    { type: "paragraph",html: "La principal está en <strong class='text-white'>status.tradovate.com</strong>. Es un panel público titulado <em>Current System Status</em> que enumera unos treinta servicios: acceso al frontend en vivo y demo, ejecución de órdenes, riesgo y enrutamiento, datos de mercado, notificaciones, fondeo y pagos, además de una fila por cada socio de fondeo. No necesita haber iniciado sesión para verlo, que es precisamente lo importante cuando lo que falla es el inicio de sesión." },
    { type: "paragraph",html: "También hay un enlace <strong class='text-white'>service status</strong> en la propia pantalla de inicio de sesión de Tradovate, normalmente cerca de la parte inferior. Si accede a través de una prop firm, su plataforma funciona en una dirección con su marca, como <code>topstep.tradovate.com</code> o <code>axia.tradovate.com</code>, y cada una tiene su propia página <code>/service-status</code>. Abra la que coincida con la URL por la que realmente inicia sesión." },
    { type: "heading",text: "Consulte la página de estado: paso a paso" },
    {
      type: "steps",
      items: [
        { title: "Abra la página de estado", html: "Escriba <strong class='text-white'>status.tradovate.com</strong> en el navegador o haga clic en el enlace service status al pie de la pantalla de inicio de sesión. Hágalo en una pestaña normal del navegador, no dentro de la aplicación de escritorio. Si la aplicación no abre, necesita una vía que no dependa de ella." },
        { title: "Lea los indicadores y localice su servicio", html: "Un <strong class='text-white'>punto verde</strong> significa que ese servicio está activo y en buen estado. Busque las filas que realmente le importan: acceso al frontend en vivo (es decir, la carga de la plataforma), ejecución y datos de mercado. Si su fila está en verde, Tradovate indica que esa parte funciona con normalidad. Si aparece marcada, ya tiene su respuesta: se trata de una caída, no de una instalación dañada." },
        { title: "Compruebe el estado de su prop firm", html: "¿Opera una cuenta fondeada o de evaluación? Mire la sección de socios de fondeo o abra la página de estado propia de su firma. Puede haber una conexión caída del lado de la firma aunque los servicios principales de Tradovate estén en verde, y eso lo debe resolver la firma, no usted. Confirme primero la caída para no perseguir un problema que no es suyo." },
        { title: "Si todo está en verde, resuélvalo localmente", html: "Cuando todos los servicios relevantes aparecen operativos y en buen estado, el problema está de su lado. Estas medidas rápidas resuelven la mayoría de los fallos de carga locales:<br><br><strong class='text-white'>Use un navegador actual</strong> &mdash; Chrome, Firefox o Safari, totalmente actualizado. Descarte por completo Internet Explorer.<br><strong class='text-white'>Revise su conexión</strong> &mdash; y cambie a una conexión por cable si su Wi-Fi es inestable.<br><strong class='text-white'>Sincronice el reloj de su equipo.</strong> Una hora de sistema incorrecta es un motivo clásico de que la plataforma no cargue: configure la zona horaria correcta y active la hora automática.<br><strong class='text-white'>Reinstale la aplicación de escritorio</strong> si está dañada, o recurra a la versión web o móvil para poder seguir operando mientras lo resuelve." },
      ],
    },
    { type: "heading",text: "Qué le indica la página de estado" },
    { type: "table", headers: ["Lo que ve","Qué significa","Qué hacer"], rows: [
      ["Punto verde en su servicio","Los servidores funcionan con normalidad","Solucione localmente: navegador, reloj, conexión"],
      ["Un servicio principal marcado o caído","Caída del lado de la plataforma","Espere; vigile las posiciones abiertas desde otro dispositivo"],
      ["La fila de su prop firm aparece marcada","Problema de conexión del lado de la firma","Contacte con su prop firm, Tradovate no puede solucionarlo"],
    ] },
    { type: "heading",text: "Automatice esto con PickMyTrade" },
    { type: "paragraph",html: "Una vez que la plataforma vuelva a ser estable, no debería tener que vigilar la pantalla para captar una señal. <strong class='text-white'>PickMyTrade envía sus alertas de TradingView directamente a Tradovate</strong>, de modo que un gráfico que carga despacio nunca se convierta en una entrada perdida." },
    { type: "paragraph",html: "Si la página de estado confirma una caída, nuestras guías sobre una plataforma que se congela en mitad de una operación y sobre un inicio de sesión atascado en la carga explican qué hacer a continuación. ¿No sabe qué aplicación usar mientras espera? Compare las opciones web, de escritorio y móvil." },
  ], fr: [
    { type: "paragraph",html: "Vous cliquez sur le raccourci, l'écran de connexion tourne et rien ne s'affiche. Avant de réinstaller l'application ou d'accuser votre machine, vérifiez si les serveurs de Tradovate sont bien en ligne. Une page d'état existe précisément pour cela, et il suffit d'environ trente secondes pour écarter une panne générale de la plateforme. Si les serveurs sont hors service, aucun dépannage local n'y changera rien : il faut attendre. S'ils sont au vert, le problème vient de votre côté, et vous savez maintenant où chercher." },
    { type: "heading",text: "Où se trouve la page d'état de Tradovate" },
    { type: "paragraph",html: "Deux endroits vous montrent la même chose sous des angles différents." },
    { type: "paragraph",html: "La principale se trouve à l'adresse <strong class='text-white'>status.tradovate.com</strong>. C'est un tableau de bord public intitulé <em>Current System Status</em>, qui liste environ trente services : accès frontend réel et démo, exécution des ordres, risque et routage, données de marché, notifications, financement et paiements, ainsi qu'une ligne pour chaque partenaire de financement. Vous n'avez pas besoin d'être connecté pour la consulter, ce qui est tout l'intérêt lorsque c'est la connexion qui est en panne." },
    { type: "paragraph",html: "Il existe aussi un lien <strong class='text-white'>service status</strong> sur l'écran de connexion de Tradovate lui-même, généralement vers le bas. Si vous vous connectez via une prop firm, votre plateforme tourne sur une adresse à ses couleurs, du type <code>topstep.tradovate.com</code> ou <code>axia.tradovate.com</code>, et chacune possède sa propre page <code>/service-status</code>. Ouvrez celle qui correspond à l'URL par laquelle vous vous connectez réellement." },
    { type: "heading",text: "Consulter la page d'état : étape par étape" },
    {
      type: "steps",
      items: [
        { title: "Ouvrir la page d'état", html: "Saisissez <strong class='text-white'>status.tradovate.com</strong> dans votre navigateur ou cliquez sur le lien service status en bas de l'écran de connexion. Faites-le dans un onglet de navigateur classique, pas dans l'application de bureau. Si l'application ne s'ouvre pas, il vous faut un chemin qui n'en dépend pas." },
        { title: "Lire les indicateurs et repérer votre service", html: "Un <strong class='text-white'>point vert</strong> signifie que ce service est en ligne et en bon état. Repérez les lignes qui comptent vraiment pour vous : accès frontend réel (c'est le chargement de la plateforme), exécution et données de marché. Si votre ligne est verte, Tradovate indique que cet élément fonctionne normalement. Si elle est signalée, vous avez votre réponse : il s'agit d'une panne, pas d'une installation défaillante." },
        { title: "Vérifier l'état de votre prop firm", html: "Vous tradez un compte financé ou d'évaluation ? Consultez la section des partenaires de financement ou ouvrez la page d'état propre à votre firme. Une connexion côté firme peut être coupée alors que les services principaux de Tradovate sont au vert, et c'est à la firme de la rétablir, pas à vous. Confirmez d'abord la panne pour ne pas courir après un problème qui n'est pas le vôtre." },
        { title: "Si tout est au vert, corriger en local", html: "Quand tous les services concernés apparaissent en ligne et en bon état, le problème vient de votre côté. Voici les gestes rapides qui règlent la plupart des échecs de chargement locaux :<br><br><strong class='text-white'>Utilisez un navigateur récent</strong> &mdash; Chrome, Firefox ou Safari, entièrement à jour. Oubliez complètement Internet Explorer.<br><strong class='text-white'>Vérifiez votre connexion</strong> &mdash; et passez à une liaison filaire si votre Wi-Fi est instable.<br><strong class='text-white'>Synchronisez l'horloge de votre ordinateur.</strong> Une heure système erronée est une cause classique de refus de chargement de la plateforme : réglez le bon fuseau horaire et activez l'heure automatique.<br><strong class='text-white'>Réinstallez l'application de bureau</strong> si elle est corrompue, ou basculez simplement sur la version web ou mobile pour continuer à trader pendant que vous réglez le problème." },
      ],
    },
    { type: "heading",text: "Ce que vous dit la page d'état" },
    { type: "table", headers: ["Ce que vous voyez","Ce que cela signifie","Que faire"], rows: [
      ["Point vert sur votre service","Les serveurs fonctionnent normalement","Dépannez en local : navigateur, horloge, connexion"],
      ["Un service principal signalé ou hors service","Panne côté plateforme","Patientez ; surveillez vos positions ouvertes depuis un autre appareil"],
      ["La ligne de votre prop firm est signalée","Problème de connexion côté firme","Contactez votre prop firm, Tradovate ne peut pas le résoudre"],
    ] },
    { type: "heading",text: "Automatisez cela avec PickMyTrade" },
    { type: "paragraph",html: "Une fois la plateforme à nouveau stable, vous ne devriez pas avoir à surveiller l'écran pour capter un signal. <strong class='text-white'>PickMyTrade envoie vos alertes TradingView directement dans Tradovate</strong>, de sorte qu'un graphique lent à charger ne se transforme jamais en entrée manquée." },
    { type: "paragraph",html: "Si la page d'état confirme une panne, nos guides sur une plateforme qui se fige en plein trade et sur une connexion bloquée au chargement expliquent quoi faire ensuite. Vous ne savez pas quelle application utiliser en attendant ? Comparez les options web, bureau et mobile." },
  ], it: [
    { type: "paragraph",html: "Fa clic sul collegamento, la schermata di accesso gira a vuoto e non compare nulla. Prima di reinstallare l'app o dare la colpa al computer, verifichi se i server di Tradovate sono attivi. Esiste una pagina di stato pensata proprio per questo e servono circa trenta secondi per escludere un'interruzione dell'intera piattaforma. Se i server sono giù, nessuna verifica locale servirà: si attende. Se sono verdi, il problema è dalla Sua parte e ora sa dove cercare." },
    { type: "heading",text: "Dove si trova la pagina di stato di Tradovate" },
    { type: "paragraph",html: "Due posti Le mostrano la stessa cosa da angolazioni diverse." },
    { type: "paragraph",html: "La principale si trova su <strong class='text-white'>status.tradovate.com</strong>. È una dashboard pubblica intitolata <em>Current System Status</em> che elenca circa trenta servizi: accesso al frontend live e demo, esecuzione degli ordini, rischio e routing, dati di mercato, notifiche, finanziamento e pagamenti, oltre a una riga per ogni partner di finanziamento. Non occorre aver effettuato l'accesso per vederla, ed è proprio questo il punto quando a non funzionare è il login." },
    { type: "paragraph",html: "C'è anche un link <strong class='text-white'>service status</strong> sulla schermata di accesso di Tradovate stessa, di solito in basso. Se accede tramite una prop firm, la Sua piattaforma funziona su un indirizzo con il marchio della società, come <code>topstep.tradovate.com</code> o <code>axia.tradovate.com</code>, e ognuno ha la propria pagina <code>/service-status</code>. Apra quella che corrisponde all'URL attraverso cui effettua realmente l'accesso." },
    { type: "heading",text: "Controllare la pagina di stato: passo dopo passo" },
    {
      type: "steps",
      items: [
