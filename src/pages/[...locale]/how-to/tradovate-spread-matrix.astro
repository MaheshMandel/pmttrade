---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "tradovate-spread-matrix";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/how-to/${SLUG}`;

const META_TITLE = "Trade Futures Spreads With Tradovate Spread Matrix";
const META_DESCRIPTION =
  "Read the Spread Matrix grid, trade calendar and futures spreads in one click, and see how the Leg 1 and Leg 2 axes build every contract combination.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Futures-Spreads mit der Tradovate Spread Matrix handeln", es: "Opere spreads de futuros con la Spread Matrix de Tradovate", fr: "Tradez des spreads de futures avec la Spread Matrix de Tradovate", it: "Operare sugli spread futures con la Spread Matrix di Tradovate" },
  dek: { en: "Instead of legging into two separate orders and hoping both fill, the Spread Matrix lets you read a grid, click one cell, and trade the spread as a single instrument.", de: "Statt zwei separate Orders einzeln aufzubauen und zu hoffen, dass beide ausgeführt werden, lesen Sie mit der Spread Matrix ein Raster, klicken eine Zelle an und handeln den Spread als ein einziges Instrument.", es: "En lugar de entrar en dos órdenes separadas y esperar que ambas se ejecuten, la Spread Matrix le permite leer una cuadrícula, hacer clic en una celda y operar el spread como un único instrumento.", fr: "Au lieu de placer deux ordres séparés en espérant que les deux soient exécutés, la Spread Matrix vous permet de lire une grille, de cliquer sur une cellule et de trader le spread comme un seul instrument.", it: "Invece di entrare con due ordini separati sperando che vengano eseguiti entrambi, la Spread Matrix Le permette di leggere una griglia, fare clic su una cella e operare sullo spread come un unico strumento." },
  readTime: { en: "5 min read", de: "5 Min. Lesezeit", es: "Lectura de 5 min", fr: "Lecture : 5 min", it: "Lettura di 5 min" },
  lastUpdated: "2026-07-10",
  blocks: { en: [
    { type: "paragraph", html: "If you trade the roll, hedge one contract month against another, or just want to see every calendar spread on a product at a glance, the Spread Matrix is the tool built for it. Instead of legging into two separate orders and hoping both fill, you read a grid, click one cell, and trade the spread as a single instrument. Here's how to open it, set it up, and place a spread trade." },
    { type: "heading", text: "What Is a Futures Spread?" },
    { type: "paragraph", html: "A <strong class='text-white'>futures spread</strong> is a position built from two related contracts traded together as one. The most common kind is a <strong class='text-white'>calendar spread</strong>: you buy one expiration and sell another expiration of the same product, so the two legs differ only by contract month. Because it's an exchange-listed instrument, you get a single price for the whole spread and one fill for both legs, which cuts the leg-risk of chasing two orders yourself." },
    { type: "paragraph", html: "Tradovate lists these as named spread types per product. Search a symbol like ES and you'll see options such as the <strong class='text-white'>E-Mini S&amp;P Reverse Calendar Spread</strong> (a reverse calendar buys the nearer month and sells the further-out one, the mirror of a standard calendar). The Spread Matrix lays out every valid month-pair for that spread type in one grid so you can pick the combination you want." },
    { type: "heading", text: "How to Use the Tradovate Spread Matrix: Step-by-Step" },
    {
      type: "steps",
      items: [
        { title: "Open the Spread Matrix Module", html: "Add a new module to your workspace. Click the large <strong class='text-white'>plus (+)</strong> to open the module selector, find <strong class='text-white'>Spread Matrix</strong> in the list, and drag it onto your screen. It opens empty, waiting for you to load a product.", image: { src: `${IMG}/tradovate-spread-matrix-1.png`, alt: "Tradovate module selector with the Spread Matrix module highlighted before being added to the workspace" } },
        { title: "Search and Load a Product Spread", html: "Click the search field at the top of the module and type a product symbol, for example <strong class='text-white'>ES</strong>. Tradovate suggests the spread types listed for that product, like the <strong class='text-white'>E-Mini S&amp;P Reverse Calendar Spread</strong>. Select one, and the top row of the grid fills in with the spread's legs and the display options you'll set next.", image: { src: `${IMG}/tradovate-spread-matrix-2.png`, alt: "Tradovate Spread Matrix search showing an ES calendar spread suggestion being selected to load the grid" } },
        { title: "Set the Legs and the Axes", html: "Now tell the matrix which contracts to plot. If you want a specific expiration, pick it from the <strong class='text-white'>contract selector</strong> dropdown. Then decide the layout: put <strong class='text-white'>Leg 1</strong> on one axis and <strong class='text-white'>Leg 2</strong> on the other. The grid takes the contracts on each axis and builds the spread for every combination where they cross, so a wider selection means a bigger matrix of month-pairs to choose from.", image: { src: `${IMG}/tradovate-spread-matrix-3.png`, alt: "Tradovate Spread Matrix configuration assigning Leg 1 and Leg 2 to the horizontal and vertical axes" } },
        { title: "Read the Grid", html: "Once configured, the grid populates. One set of contract months runs across the top, another runs down the side, and each <strong class='text-white'>intersecting cell</strong> is the tradable spread for that exact pair of expirations, showing its current price. Reading it is simple: find the front-month contract on one axis, the back-month on the other, and the cell where they meet is your spread.", image: { src: `${IMG}/tradovate-spread-matrix-4.png`, alt: "Populated Tradovate Spread Matrix grid with contract months on both axes and spread prices in the intersecting cells" } },
        { title: "Buy or Sell From a Cell", html: "Hover over the spread cell you want to trade and two buttons appear: <strong class='text-white'>Buy Mkt</strong> and <strong class='text-white'>Sell Mkt</strong>. Hovering each one shows a tooltip spelling out exactly what the order will do, so you can confirm the direction before you commit. Click the side you want, and Tradovate sends a market order for that spread as one instrument. You can check the working order and the resulting position in your Orders and Positions panels like any other trade.", image: { src: `${IMG}/tradovate-spread-matrix-5.png`, alt: "Tradovate Spread Matrix cell hover showing Buy Mkt and Sell Mkt buttons to place a spread market order" } },
      ],
    },
    { type: "heading", text: "Why You'd Use the Spread Matrix" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Trade the roll cleanly</strong> as one order instead of legging out of the front month and into the next.",
        "<strong class='text-white'>See every month-pair at once</strong> so you can spot the spread you actually want to trade.",
        "<strong class='text-white'>Cut leg risk</strong> since the exchange fills both legs together at a single spread price.",
        "<strong class='text-white'>Hedge or arbitrage</strong> calendar relationships without babysitting two separate tickets.",
      ],
    },
    { type: "quote", html: "Live spread prices need a real-time data subscription for the product. If the cells look blank or stale, confirm your market data before you trade." },
    { type: "heading", text: "Automate Your Entries with PickMyTrade" },
    { type: "paragraph", html: "Spreads are great for structured positions, but when your edge is a signal, you don't want to be clicking a grid at the exact moment it fires. PickMyTrade routes your TradingView alerts straight into your Tradovate account and places the trade for you, brackets and all." },
  ], de: [
    { type: "paragraph",html: "Wenn Sie den Roll handeln, einen Kontraktmonat gegen einen anderen absichern oder einfach jeden Calendar Spread eines Produkts auf einen Blick sehen möchten, ist die Spread Matrix das passende Werkzeug. Statt zwei separate Orders einzeln aufzubauen und zu hoffen, dass beide ausgeführt werden, lesen Sie ein Raster, klicken eine Zelle an und handeln den Spread als ein einziges Instrument. So öffnen Sie sie, richten sie ein und platzieren einen Spread-Trade." },
    { type: "heading",text: "Was ist ein Futures-Spread?" },
    { type: "paragraph",html: "Ein <strong class='text-white'>Futures-Spread</strong> ist eine Position aus zwei verwandten Kontrakten, die gemeinsam als einer gehandelt werden. Die häufigste Art ist der <strong class='text-white'>Calendar Spread</strong>: Sie kaufen einen Verfall und verkaufen einen anderen Verfall desselben Produkts, sodass sich die beiden Legs nur durch den Kontraktmonat unterscheiden. Da es sich um ein börsengelistetes Instrument handelt, erhalten Sie einen einzigen Preis für den gesamten Spread und eine Ausführung für beide Legs, was das Leg-Risiko verringert, das entsteht, wenn Sie zwei Orders selbst hinterherjagen." },
    { type: "paragraph",html: "Tradovate listet diese als benannte Spread-Typen pro Produkt. Wenn Sie ein Symbol wie ES suchen, sehen Sie Optionen wie den <strong class='text-white'>E-Mini S&amp;P Reverse Calendar Spread</strong> (ein Reverse Calendar kauft den näheren Monat und verkauft den weiter entfernten, das Spiegelbild eines normalen Calendar). Die Spread Matrix zeigt alle gültigen Monatspaare für diesen Spread-Typ in einem Raster, damit Sie die gewünschte Kombination auswählen können." },
    { type: "heading",text: "So verwenden Sie die Tradovate Spread Matrix: Schritt für Schritt" },
    {
      type: "steps",
      items: [
        { title: "Das Spread-Matrix-Modul öffnen", html: "Fügen Sie Ihrem Workspace ein neues Modul hinzu. Klicken Sie auf das große <strong class='text-white'>Plus (+)</strong>, um die Modulauswahl zu öffnen, suchen Sie <strong class='text-white'>Spread Matrix</strong> in der Liste und ziehen Sie es auf Ihren Bildschirm. Es öffnet sich leer und wartet darauf, dass Sie ein Produkt laden.", image: {"src":`${IMG}/tradovate-spread-matrix-1.png`,"alt":"Tradovate-Modulauswahl mit hervorgehobenem Spread-Matrix-Modul, bevor es dem Workspace hinzugefügt wird"} },
        { title: "Ein Produkt-Spread suchen und laden", html: "Klicken Sie oben im Modul auf das Suchfeld und geben Sie ein Produktsymbol ein, zum Beispiel <strong class='text-white'>ES</strong>. Tradovate schlägt die für dieses Produkt gelisteten Spread-Typen vor, etwa den <strong class='text-white'>E-Mini S&amp;P Reverse Calendar Spread</strong>. Wählen Sie einen aus, und die oberste Zeile des Rasters füllt sich mit den Legs des Spreads und den Anzeigeoptionen, die Sie als Nächstes festlegen.", image: {"src":`${IMG}/tradovate-spread-matrix-2.png`,"alt":"Tradovate-Spread-Matrix-Suche mit einem ES-Calendar-Spread-Vorschlag, der zum Laden des Rasters ausgewählt wird"} },
        { title: "Legs und Achsen festlegen", html: "Teilen Sie der Matrix nun mit, welche Kontrakte dargestellt werden sollen. Wenn Sie einen bestimmten Verfall möchten, wählen Sie ihn im Dropdown <strong class='text-white'>Kontraktauswahl</strong>. Legen Sie dann das Layout fest: Platzieren Sie <strong class='text-white'>Leg 1</strong> auf der einen Achse und <strong class='text-white'>Leg 2</strong> auf der anderen. Das Raster nimmt die Kontrakte auf jeder Achse und baut den Spread für jede Kombination, in der sie sich kreuzen. Eine breitere Auswahl ergibt also eine größere Matrix an Monatspaaren.", image: {"src":`${IMG}/tradovate-spread-matrix-3.png`,"alt":"Tradovate-Spread-Matrix-Konfiguration, bei der Leg 1 und Leg 2 der horizontalen und vertikalen Achse zugewiesen werden"} },
        { title: "Das Raster lesen", html: "Nach der Konfiguration füllt sich das Raster. Eine Gruppe von Kontraktmonaten verläuft oben, eine andere an der Seite, und jede <strong class='text-white'>Schnittzelle</strong> ist der handelbare Spread für genau dieses Verfallspaar und zeigt seinen aktuellen Preis. Das Lesen ist einfach: Suchen Sie den Frontmonat-Kontrakt auf der einen Achse, den hinteren Monat auf der anderen, und die Zelle, in der sie sich treffen, ist Ihr Spread.", image: {"src":`${IMG}/tradovate-spread-matrix-4.png`,"alt":"Gefülltes Tradovate-Spread-Matrix-Raster mit Kontraktmonaten auf beiden Achsen und Spread-Preisen in den Schnittzellen"} },
        { title: "Aus einer Zelle kaufen oder verkaufen", html: "Fahren Sie mit der Maus über die Spread-Zelle, die Sie handeln möchten, und es erscheinen zwei Schaltflächen: <strong class='text-white'>Buy Mkt</strong> und <strong class='text-white'>Sell Mkt</strong>. Beim Darüberfahren zeigt jede einen Tooltip, der genau beschreibt, was die Order bewirkt, sodass Sie die Richtung bestätigen können, bevor Sie sich festlegen. Klicken Sie auf die gewünschte Seite, und Tradovate sendet eine Market-Order für diesen Spread als ein Instrument. Die aktive Order und die entstandene Position sehen Sie wie bei jedem anderen Trade in Ihren Orders- und Positions-Panels.", image: {"src":`${IMG}/tradovate-spread-matrix-5.png`,"alt":"Tradovate-Spread-Matrix-Zelle mit den Schaltflächen Buy Mkt und Sell Mkt zum Platzieren einer Spread-Market-Order beim Darüberfahren"} },
      ],
    },
    { type: "heading",text: "Warum Sie die Spread Matrix nutzen sollten" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Den Roll sauber handeln</strong> als eine Order, statt aus dem Frontmonat auszusteigen und in den nächsten einzusteigen.",
        "<strong class='text-white'>Alle Monatspaare auf einmal sehen</strong>, damit Sie den Spread erkennen, den Sie tatsächlich handeln möchten.",
        "<strong class='text-white'>Leg-Risiko senken</strong>, da die Börse beide Legs gemeinsam zu einem einzigen Spread-Preis ausführt.",
        "<strong class='text-white'>Absichern oder Arbitrage betreiben</strong> mit Calendar-Beziehungen, ohne zwei separate Tickets zu überwachen.",
      ],
    },
    { type: "quote",html: "Live-Spread-Preise erfordern ein Echtzeitdaten-Abonnement für das Produkt. Wirken die Zellen leer oder veraltet, prüfen Sie Ihre Marktdaten, bevor Sie handeln." },
    { type: "heading",text: "Automatisieren Sie Ihre Einstiege mit PickMyTrade" },
    { type: "paragraph",html: "Spreads eignen sich hervorragend für strukturierte Positionen, aber wenn Ihr Vorteil in einem Signal liegt, möchten Sie nicht genau dann ein Raster anklicken, wenn es auslöst. PickMyTrade leitet Ihre TradingView-Alerts direkt an Ihr Tradovate-Konto weiter und platziert den Trade für Sie, inklusive Brackets." },
  ], es: [
    { type: "paragraph",html: "Si opera el roll, cubre un mes de contrato frente a otro o simplemente quiere ver de un vistazo todos los calendar spreads de un producto, la Spread Matrix es la herramienta pensada para ello. En lugar de entrar en dos órdenes separadas y esperar que ambas se ejecuten, usted lee una cuadrícula, hace clic en una celda y opera el spread como un único instrumento. Así se abre, se configura y se coloca una operación de spread." },
    { type: "heading",text: "¿Qué es un spread de futuros?" },
    { type: "paragraph",html: "Un <strong class='text-white'>spread de futuros</strong> es una posición construida con dos contratos relacionados operados conjuntamente como uno solo. El tipo más común es el <strong class='text-white'>calendar spread</strong>: usted compra un vencimiento y vende otro vencimiento del mismo producto, de modo que las dos patas solo difieren en el mes del contrato. Como es un instrumento cotizado en bolsa, obtiene un único precio para todo el spread y una sola ejecución para ambas patas, lo que reduce el riesgo de pata de perseguir usted mismo dos órdenes." },
    { type: "paragraph",html: "Tradovate los lista como tipos de spread con nombre por producto. Si busca un símbolo como ES, verá opciones como el <strong class='text-white'>E-Mini S&amp;P Reverse Calendar Spread</strong> (un reverse calendar compra el mes más cercano y vende el más lejano, el reflejo de un calendar estándar). La Spread Matrix muestra todos los pares de meses válidos para ese tipo de spread en una sola cuadrícula para que pueda elegir la combinación que desea." },
    { type: "heading",text: "Cómo usar la Spread Matrix de Tradovate: paso a paso" },
    {
      type: "steps",
      items: [
        { title: "Abra el módulo Spread Matrix", html: "Añada un nuevo módulo a su espacio de trabajo. Haga clic en el gran <strong class='text-white'>signo más (+)</strong> para abrir el selector de módulos, busque <strong class='text-white'>Spread Matrix</strong> en la lista y arrástrelo a su pantalla. Se abre vacío, a la espera de que cargue un producto.", image: {"src":`${IMG}/tradovate-spread-matrix-1.png`,"alt":"Selector de módulos de Tradovate con el módulo Spread Matrix resaltado antes de añadirlo al espacio de trabajo"} },
        { title: "Busque y cargue el spread de un producto", html: "Haga clic en el campo de búsqueda de la parte superior del módulo y escriba el símbolo de un producto, por ejemplo <strong class='text-white'>ES</strong>. Tradovate sugiere los tipos de spread listados para ese producto, como el <strong class='text-white'>E-Mini S&amp;P Reverse Calendar Spread</strong>. Seleccione uno y la fila superior de la cuadrícula se rellena con las patas del spread y las opciones de visualización que configurará a continuación.", image: {"src":`${IMG}/tradovate-spread-matrix-2.png`,"alt":"Búsqueda de la Spread Matrix de Tradovate mostrando la sugerencia de un calendar spread de ES que se selecciona para cargar la cuadrícula"} },
        { title: "Defina las patas y los ejes", html: "Ahora indique a la matriz qué contratos representar. Si desea un vencimiento concreto, elíjalo en el desplegable del <strong class='text-white'>selector de contrato</strong>. Después decida el diseño: coloque <strong class='text-white'>Leg 1</strong> en un eje y <strong class='text-white'>Leg 2</strong> en el otro. La cuadrícula toma los contratos de cada eje y construye el spread para cada combinación en la que se cruzan, de modo que una selección más amplia genera una matriz mayor de pares de meses entre los que elegir.", image: {"src":`${IMG}/tradovate-spread-matrix-3.png`,"alt":"Configuración de la Spread Matrix de Tradovate asignando Leg 1 y Leg 2 a los ejes horizontal y vertical"} },
        { title: "Lea la cuadrícula", html: "Una vez configurada, la cuadrícula se rellena. Un conjunto de meses de contrato recorre la parte superior, otro el lateral, y cada <strong class='text-white'>celda de intersección</strong> es el spread operable para ese par exacto de vencimientos, con su precio actual. Leerla es sencillo: busque el contrato del mes frontal en un eje, el del mes posterior en el otro, y la celda donde se encuentran es su spread.", image: {"src":`${IMG}/tradovate-spread-matrix-4.png`,"alt":"Cuadrícula de la Spread Matrix de Tradovate con meses de contrato en ambos ejes y precios de spread en las celdas de intersección"} },
        { title: "Compre o venda desde una celda", html: "Pase el cursor sobre la celda del spread que desea operar y aparecen dos botones: <strong class='text-white'>Buy Mkt</strong> y <strong class='text-white'>Sell Mkt</strong>. Al pasar el cursor sobre cada uno se muestra una información emergente que explica exactamente qué hará la orden, para que pueda confirmar la dirección antes de comprometerse. Haga clic en el lado que desee y Tradovate envía una orden de mercado para ese spread como un único instrumento. Puede comprobar la orden activa y la posición resultante en sus paneles Orders y Positions como en cualquier otra operación.", image: {"src":`${IMG}/tradovate-spread-matrix-5.png`,"alt":"Celda de la Spread Matrix de Tradovate al pasar el cursor, con los botones Buy Mkt y Sell Mkt para colocar una orden de mercado de spread"} },
      ],
    },
    { type: "heading",text: "Por qué usar la Spread Matrix" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Opere el roll de forma limpia</strong> como una sola orden en lugar de salir del mes frontal y entrar en el siguiente.",
        "<strong class='text-white'>Vea todos los pares de meses a la vez</strong> para detectar el spread que realmente desea operar.",
        "<strong class='text-white'>Reduzca el riesgo de pata</strong> ya que la bolsa ejecuta ambas patas juntas a un único precio de spread.",
        "<strong class='text-white'>Cubra o haga arbitraje</strong> de relaciones calendar sin vigilar dos tickets separados.",
      ],
    },
    { type: "quote",html: "Los precios de spread en vivo requieren una suscripción de datos en tiempo real para el producto. Si las celdas aparecen en blanco o desactualizadas, confirme sus datos de mercado antes de operar." },
    { type: "heading",text: "Automatice sus entradas con PickMyTrade" },
    { type: "paragraph",html: "Los spreads son ideales para posiciones estructuradas, pero cuando su ventaja es una señal, no querrá estar haciendo clic en una cuadrícula en el momento exacto en que se dispara. PickMyTrade envía sus alertas de TradingView directamente a su cuenta de Tradovate y coloca la operación por usted, con sus brackets incluidos." },
  ], fr: [
    { type: "paragraph",html: "Si vous tradez le roll, couvrez une échéance contre une autre ou souhaitez simplement voir d’un coup d’œil tous les calendar spreads d’un produit, la Spread Matrix est l’outil conçu pour cela. Au lieu de placer deux ordres séparés en espérant que les deux soient exécutés, vous lisez une grille, cliquez sur une cellule et tradez le spread comme un seul instrument. Voici comment l’ouvrir, la configurer et passer un trade de spread." },
    { type: "heading",text: "Qu’est-ce qu’un spread de futures ?" },
    { type: "paragraph",html: "Un <strong class='text-white'>spread de futures</strong> est une position construite à partir de deux contrats liés tradés ensemble comme un seul. Le type le plus courant est le <strong class='text-white'>calendar spread</strong> : vous achetez une échéance et vendez une autre échéance du même produit, de sorte que les deux jambes ne diffèrent que par le mois du contrat. Comme il s’agit d’un instrument coté en bourse, vous obtenez un prix unique pour l’ensemble du spread et une seule exécution pour les deux jambes, ce qui réduit le risque de jambe lié au fait de courir après deux ordres vous-même." },
    { type: "paragraph",html: "Tradovate les répertorie sous forme de types de spread nommés par produit. Recherchez un symbole comme ES et vous verrez des options telles que l’<strong class='text-white'>E-Mini S&amp;P Reverse Calendar Spread</strong> (un reverse calendar achète l’échéance la plus proche et vend la plus éloignée, l’inverse d’un calendar standard). La Spread Matrix présente toutes les paires d’échéances valides pour ce type de spread dans une seule grille afin que vous puissiez choisir la combinaison souhaitée." },
    { type: "heading",text: "Utiliser la Spread Matrix de Tradovate : pas à pas" },
    {
      type: "steps",
      items: [
        { title: "Ouvrir le module Spread Matrix", html: "Ajoutez un nouveau module à votre espace de travail. Cliquez sur le grand <strong class='text-white'>plus (+)</strong> pour ouvrir le sélecteur de modules, trouvez <strong class='text-white'>Spread Matrix</strong> dans la liste et faites-le glisser sur votre écran. Il s’ouvre vide, en attente du chargement d’un produit.", image: {"src":`${IMG}/tradovate-spread-matrix-1.png`,"alt":"Sélecteur de modules de Tradovate avec le module Spread Matrix mis en évidence avant son ajout à l’espace de travail"} },
        { title: "Rechercher et charger le spread d’un produit", html: "Cliquez sur le champ de recherche en haut du module et saisissez le symbole d’un produit, par exemple <strong class='text-white'>ES</strong>. Tradovate suggère les types de spread répertoriés pour ce produit, comme l’<strong class='text-white'>E-Mini S&amp;P Reverse Calendar Spread</strong>. Sélectionnez-en un et la ligne du haut de la grille se remplit avec les jambes du spread et les options d’affichage que vous allez définir ensuite.", image: {"src":`${IMG}/tradovate-spread-matrix-2.png`,"alt":"Recherche dans la Spread Matrix de Tradovate montrant une suggestion de calendar spread ES sélectionnée pour charger la grille"} },
        { title: "Définir les jambes et les axes", html: "Indiquez maintenant à la matrice quels contrats afficher. Si vous voulez une échéance précise, choisissez-la dans la liste déroulante du <strong class='text-white'>sélecteur de contrat</strong>. Décidez ensuite de la disposition : placez <strong class='text-white'>Leg 1</strong> sur un axe et <strong class='text-white'>Leg 2</strong> sur l’autre. La grille prend les contrats de chaque axe et construit le spread pour chaque combinaison où ils se croisent ; une sélection plus large donne donc une matrice plus grande de paires d’échéances.", image: {"src":`${IMG}/tradovate-spread-matrix-3.png`,"alt":"Configuration de la Spread Matrix de Tradovate attribuant Leg 1 et Leg 2 aux axes horizontal et vertical"} },
        { title: "Lire la grille", html: "Une fois configurée, la grille se remplit. Un ensemble d’échéances court en haut, un autre sur le côté, et chaque <strong class='text-white'>cellule d’intersection</strong> est le spread négociable pour cette paire exacte d’échéances, avec son prix actuel. La lecture est simple : trouvez l’échéance rapprochée sur un axe, l’échéance éloignée sur l’autre, et la cellule où elles se rencontrent est votre spread.", image: {"src":`${IMG}/tradovate-spread-matrix-4.png`,"alt":"Grille de la Spread Matrix de Tradovate remplie, avec les échéances sur les deux axes et les prix des spreads dans les cellules d’intersection"} },
        { title: "Acheter ou vendre depuis une cellule", html: "Survolez la cellule du spread que vous souhaitez trader et deux boutons apparaissent : <strong class='text-white'>Buy Mkt</strong> et <strong class='text-white'>Sell Mkt</strong>. Le survol de chacun affiche une infobulle précisant exactement ce que fera l’ordre, afin que vous puissiez confirmer la direction avant de vous engager. Cliquez sur le côté souhaité et Tradovate envoie un ordre au marché pour ce spread en tant qu’instrument unique. Vous pouvez vérifier l’ordre actif et la position qui en résulte dans vos panneaux Orders et Positions, comme pour n’importe quel autre trade.", image: {"src":`${IMG}/tradovate-spread-matrix-5.png`,"alt":"Cellule de la Spread Matrix de Tradovate survolée affichant les boutons Buy Mkt et Sell Mkt pour passer un ordre au marché sur un spread"} },
      ],
    },
    { type: "heading",text: "Pourquoi utiliser la Spread Matrix" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Tradez le roll proprement</strong> en un seul ordre au lieu de sortir de l’échéance rapprochée pour entrer dans la suivante.",
        "<strong class='text-white'>Voyez toutes les paires d’échéances d’un coup</strong> pour repérer le spread que vous voulez réellement trader.",
        "<strong class='text-white'>Réduisez le risque de jambe</strong> puisque la bourse exécute les deux jambes ensemble à un prix de spread unique.",
        "<strong class='text-white'>Couvrez ou faites de l’arbitrage</strong> sur les relations calendaires sans surveiller deux tickets séparés.",
      ],
    },
    { type: "quote",html: "Les prix de spread en direct nécessitent un abonnement aux données en temps réel pour le produit. Si les cellules semblent vides ou périmées, vérifiez vos données de marché avant de trader." },
    { type: "heading",text: "Automatisez vos entrées avec PickMyTrade" },
    { type: "paragraph",html: "Les spreads sont idéaux pour les positions structurées, mais lorsque votre avantage repose sur un signal, vous ne voulez pas cliquer sur une grille au moment précis où il se déclenche. PickMyTrade achemine vos alertes TradingView directement vers votre compte Tradovate et place le trade pour vous, brackets compris." },
  ], it: [
    { type: "paragraph",html: "Se opera sul roll, copre un mese di contratto contro un altro o desidera semplicemente vedere a colpo d’occhio tutti i calendar spread di un prodotto, la Spread Matrix è lo strumento pensato per questo. Invece di entrare con due ordini separati sperando che vengano eseguiti entrambi, legge una griglia, fa clic su una cella e opera sullo spread come un unico strumento. Ecco come aprirla, configurarla e piazzare un’operazione su spread." },
    { type: "heading",text: "Che cos’è uno spread futures?" },
    { type: "paragraph",html: "Uno <strong class='text-white'>spread futures</strong> è una posizione costruita con due contratti correlati negoziati insieme come uno solo. Il tipo più comune è il <strong class='text-white'>calendar spread</strong>: si acquista una scadenza e se ne vende un’altra dello stesso prodotto, così le due gambe differiscono solo per il mese del contratto. Poiché è uno strumento quotato in borsa, si ottiene un unico prezzo per l’intero spread e una sola esecuzione per entrambe le gambe, il che riduce il rischio di gamba legato all’inseguire due ordini da soli." },
    { type: "paragraph",html: "Tradovate li elenca come tipi di spread con nome per ciascun prodotto. Cercando un simbolo come ES vedrà opzioni quali l’<strong class='text-white'>E-Mini S&amp;P Reverse Calendar Spread</strong> (un reverse calendar acquista il mese più vicino e vende quello più lontano, l’opposto di un calendar standard). La Spread Matrix dispone tutte le coppie di mesi valide per quel tipo di spread in un’unica griglia, così può scegliere la combinazione desiderata." },
    { type: "heading",text: "Come usare la Spread Matrix di Tradovate: passo dopo passo" },
    {
      type: "steps",
      items: [
        { title: "Aprire il modulo Spread Matrix", html: "Aggiunga un nuovo modulo al Suo spazio di lavoro. Faccia clic sul grande <strong class='text-white'>più (+)</strong> per aprire il selettore dei moduli, trovi <strong class='text-white'>Spread Matrix</strong> nell’elenco e lo trascini sullo schermo. Si apre vuoto, in attesa che carichi un prodotto.", image: {"src":`${IMG}/tradovate-spread-matrix-1.png`,"alt":"Selettore dei moduli di Tradovate con il modulo Spread Matrix evidenziato prima dell’aggiunta allo spazio di lavoro"} },
        { title: "Cercare e caricare lo spread di un prodotto", html: "Faccia clic sul campo di ricerca in alto nel modulo e digiti il simbolo di un prodotto, ad esempio <strong class='text-white'>ES</strong>. Tradovate suggerisce i tipi di spread elencati per quel prodotto, come l’<strong class='text-white'>E-Mini S&amp;P Reverse Calendar Spread</strong>. Ne selezioni uno e la riga superiore della griglia si riempie con le gambe dello spread e le opzioni di visualizzazione che imposterà subito dopo.", image: {"src":`${IMG}/tradovate-spread-matrix-2.png`,"alt":"Ricerca nella Spread Matrix di Tradovate con un suggerimento di calendar spread ES selezionato per caricare la griglia"} },
        { title: "Impostare le gambe e gli assi", html: "Ora indichi alla matrice quali contratti rappresentare. Se desidera una scadenza specifica, la scelga dal menu a discesa del <strong class='text-white'>selettore del contratto</strong>. Poi decida il layout: posizioni <strong class='text-white'>Leg 1</strong> su un asse e <strong class='text-white'>Leg 2</strong> sull’altro. La griglia prende i contratti su ciascun asse e costruisce lo spread per ogni combinazione in cui si incrociano, quindi una selezione più ampia produce una matrice più grande di coppie di mesi tra cui scegliere.", image: {"src":`${IMG}/tradovate-spread-matrix-3.png`,"alt":"Configurazione della Spread Matrix di Tradovate con Leg 1 e Leg 2 assegnate agli assi orizzontale e verticale"} },
        { title: "Leggere la griglia", html: "Una volta configurata, la griglia si popola. Un insieme di mesi di contratto corre in alto, un altro lungo il lato, e ogni <strong class='text-white'>cella di intersezione</strong> è lo spread negoziabile per quella esatta coppia di scadenze, con il suo prezzo attuale. Leggerla è semplice: trovi il contratto del mese frontale su un asse, quello del mese successivo sull’altro, e la cella in cui si incontrano è il Suo spread.", image: {"src":`${IMG}/tradovate-spread-matrix-4.png`,"alt":"Griglia della Spread Matrix di Tradovate popolata, con i mesi di contratto su entrambi gli assi e i prezzi degli spread nelle celle di intersezione"} },
        { title: "Comprare o vendere da una cella", html: "Passi il cursore sulla cella dello spread che desidera operare e compaiono due pulsanti: <strong class='text-white'>Buy Mkt</strong> e <strong class='text-white'>Sell Mkt</strong>. Passando sopra ciascuno compare un suggerimento che spiega esattamente cosa farà l’ordine, così può confermare la direzione prima di impegnarsi. Faccia clic sul lato desiderato e Tradovate invia un ordine a mercato per quello spread come un unico strumento. Può controllare l’ordine attivo e la posizione risultante nei pannelli Orders e Positions come per qualsiasi altra operazione.", image: {"src":`${IMG}/tradovate-spread-matrix-5.png`,"alt":"Cella della Spread Matrix di Tradovate con cursore sopra, che mostra i pulsanti Buy Mkt e Sell Mkt per piazzare un ordine a mercato su uno spread"} },
      ],
    },
    { type: "heading",text: "Perché usare la Spread Matrix" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Operare sul roll in modo pulito</strong> con un solo ordine invece di uscire dal mese frontale ed entrare nel successivo.",
        "<strong class='text-white'>Vedere tutte le coppie di mesi in una volta</strong> per individuare lo spread che vuole davvero operare.",
        "<strong class='text-white'>Ridurre il rischio di gamba</strong> poiché la borsa esegue entrambe le gambe insieme a un unico prezzo di spread.",
        "<strong class='text-white'>Coprirsi o fare arbitraggio</strong> sulle relazioni calendar senza dover seguire due ticket separati.",
      ],
    },
    { type: "quote",html: "I prezzi degli spread in tempo reale richiedono un abbonamento ai dati in tempo reale per il prodotto. Se le celle appaiono vuote o non aggiornate, verifichi i Suoi dati di mercato prima di operare." },
    { type: "heading",text: "Automatizzi i Suoi ingressi con PickMyTrade" },
    { type: "paragraph",html: "Gli spread sono ottimi per le posizioni strutturate, ma quando il Suo vantaggio è un segnale, non vorrà fare clic su una griglia nel momento esatto in cui scatta. PickMyTrade instrada i Suoi alert di TradingView direttamente al Suo conto Tradovate e piazza l’operazione per Lei, bracket inclusi." },
  ] },
  ctaHeading: { en: "Automate Your Spread Entries", de: "Automatisieren Sie Ihre Spread-Einstiege", es: "Automatice sus entradas en spreads", fr: "Automatisez vos entrées sur spreads", it: "Automatizzi i Suoi ingressi sugli spread" },
  ctaText: { en: "Spreads are great for structured positions, but you don't want to be clicking a grid at the exact moment your signal fires. Let PickMyTrade place the trade for you, brackets and all.", de: "Spreads eignen sich hervorragend für strukturierte Positionen, aber Sie möchten nicht in genau dem Moment, in dem Ihr Signal auslöst, ein Raster anklicken. Lassen Sie PickMyTrade den Trade für Sie platzieren, inklusive Brackets.", es: "Los spreads son ideales para posiciones estructuradas, pero no querrá estar haciendo clic en una cuadrícula en el momento exacto en que se dispara su señal. Deje que PickMyTrade coloque la operación por usted, con sus brackets incluidos.", fr: "Les spreads sont idéaux pour les positions structurées, mais vous ne voulez pas cliquer sur une grille au moment précis où votre signal se déclenche. Laissez PickMyTrade placer le trade pour vous, brackets compris.", it: "Gli spread sono ottimi per le posizioni strutturate, ma non vorrà fare clic su una griglia nel momento esatto in cui scatta il Suo segnale. Lasci che PickMyTrade piazzi l’operazione per Lei, bracket inclusi." },
  ctaButtonText: { en: "Start Your Free 7-Day Trial", de: "Starten Sie Ihre kostenlose 7-Tage-Testphase", es: "Comience su prueba gratuita de 7 días", fr: "Commencez votre essai gratuit de 7 jours", it: "Inizi la prova gratuita di 7 giorni" },
  ctaUrl: "https://app.pickmytrade.trade/?register=true&utm_source=content&utm_medium=how-to",
  faqHeading: { en: "Frequently Asked Questions", de: "Häufig gestellte Fragen", es: "Preguntas frecuentes", fr: "Questions fréquentes", it: "Domande frequenti" },
  faqs: { en: [
    { q: "Is a Spread Matrix trade one order or two?", a: "One. An exchange-listed spread is a single instrument, so Buy Mkt or Sell Mkt sends one market order and the exchange fills both legs together at the spread price." },
    { q: "What's the difference between a calendar spread and a reverse calendar spread?", a: "A calendar spread sells the nearer month and buys the further-out one. A reverse calendar spread does the opposite, buying the nearer month and selling the further-out month. Tradovate names the spread type when you load it, so check the label before you trade." },
    { q: "Why are the cells in my Spread Matrix empty?", a: "Usually a missing or delayed market-data subscription for that product, or a leg configuration that leaves no valid intersections. Confirm your real-time data and check that both legs point at contracts that actually pair up." },
  ], de: [
    { q: "Ist ein Spread-Matrix-Trade eine Order oder zwei?", a: "Eine. Ein an der Börse gelisteter Spread ist ein einziges Instrument, daher sendet Buy Mkt oder Sell Mkt eine einzige Market-Order, und die Börse führt beide Legs gemeinsam zum Spread-Preis aus." },
    { q: "Was ist der Unterschied zwischen einem Calendar Spread und einem Reverse Calendar Spread?", a: "Ein Calendar Spread verkauft den näheren Monat und kauft den weiter entfernten. Ein Reverse Calendar Spread macht das Gegenteil: Er kauft den näheren Monat und verkauft den weiter entfernten Monat. Tradovate nennt beim Laden den Spread-Typ, prüfen Sie also die Bezeichnung, bevor Sie handeln." },
    { q: "Warum sind die Zellen in meiner Spread Matrix leer?", a: "Meist fehlt ein Marktdaten-Abonnement für das Produkt oder es ist verzögert, oder eine Leg-Konfiguration ergibt keine gültigen Schnittpunkte. Prüfen Sie Ihre Echtzeitdaten und stellen Sie sicher, dass beide Legs auf Kontrakte verweisen, die tatsächlich zusammenpassen." },
  ], es: [
    { q: "¿Una operación de Spread Matrix es una orden o dos?", a: "Una. Un spread cotizado en bolsa es un único instrumento, por lo que Buy Mkt o Sell Mkt envía una sola orden de mercado y la bolsa ejecuta ambas patas juntas al precio del spread." },
    { q: "¿Cuál es la diferencia entre un calendar spread y un reverse calendar spread?", a: "Un calendar spread vende el mes más cercano y compra el más lejano. Un reverse calendar spread hace lo contrario: compra el mes más cercano y vende el mes más lejano. Tradovate indica el tipo de spread al cargarlo, así que revise la etiqueta antes de operar." },
    { q: "¿Por qué están vacías las celdas de mi Spread Matrix?", a: "Normalmente se debe a una suscripción de datos de mercado ausente o retrasada para ese producto, o a una configuración de patas que no deja intersecciones válidas. Confirme sus datos en tiempo real y compruebe que ambas patas apunten a contratos que realmente formen pareja." },
  ], fr: [
    { q: "Un trade de Spread Matrix est-il un ordre ou deux ?", a: "Un seul. Un spread coté en bourse est un instrument unique ; Buy Mkt ou Sell Mkt envoie donc un seul ordre au marché et la bourse exécute les deux jambes ensemble au prix du spread." },
    { q: "Quelle est la différence entre un calendar spread et un reverse calendar spread ?", a: "Un calendar spread vend l’échéance la plus proche et achète la plus éloignée. Un reverse calendar spread fait l’inverse : il achète l’échéance la plus proche et vend la plus éloignée. Tradovate indique le type de spread lors du chargement, vérifiez donc l’intitulé avant de trader." },
    { q: "Pourquoi les cellules de ma Spread Matrix sont-elles vides ?", a: "Généralement à cause d’un abonnement aux données de marché manquant ou différé pour ce produit, ou d’une configuration de jambes qui ne laisse aucune intersection valide. Vérifiez vos données en temps réel et assurez-vous que les deux jambes pointent vers des contrats qui peuvent réellement être appariés." },
  ], it: [
    { q: "Un’operazione con la Spread Matrix è un ordine o due?", a: "Uno. Uno spread quotato in borsa è un unico strumento, quindi Buy Mkt o Sell Mkt invia un solo ordine a mercato e la borsa esegue entrambe le gambe insieme al prezzo dello spread." },
    { q: "Qual è la differenza tra un calendar spread e un reverse calendar spread?", a: "Un calendar spread vende il mese più vicino e acquista quello più lontano. Un reverse calendar spread fa l’opposto: acquista il mese più vicino e vende il mese più lontano. Tradovate indica il tipo di spread al momento del caricamento, quindi controlli l’etichetta prima di operare." },
    { q: "Perché le celle della mia Spread Matrix sono vuote?", a: "Di solito per un abbonamento ai dati di mercato mancante o in ritardo per quel prodotto, oppure per una configurazione delle gambe che non lascia intersezioni valide. Verifichi i Suoi dati in tempo reale e controlli che entrambe le gambe puntino a contratti che si abbinano davvero." },
  ] },
  relatedHeading: { en: "Related Guides", de: "Verwandte Anleitungen", es: "Guías relacionadas", fr: "Guides associés", it: "Guide correlate" },
  disclosureText: { en: `This guide is for educational and informational purposes only and is not financial, investment, or trading advice. Trading futures and other leveraged products carries a substantial risk of loss and is not suitable for every investor. PickMyTrade is an independent third-party automation platform and is not affiliated with, endorsed by, or sponsored by Tradovate, Inc. "Tradovate" and all related names, logos, and trademarks are the property of their respective owners. Platform features and steps change over time, so always confirm the current process in the official Tradovate platform and documentation before acting.`, de: "Diese Anleitung dient ausschließlich Bildungs- und Informationszwecken und stellt keine Finanz-, Anlage- oder Handelsberatung dar. Der Handel mit Futures und anderen gehebelten Produkten birgt ein erhebliches Verlustrisiko und ist nicht für jeden Anleger geeignet. PickMyTrade ist eine unabhängige Automatisierungsplattform eines Drittanbieters und steht in keiner Verbindung zu Tradovate, Inc., wird weder von Tradovate, Inc. unterstützt noch gesponsert. „Tradovate“ und alle zugehörigen Namen, Logos und Marken sind Eigentum ihrer jeweiligen Inhaber. Funktionen und Schritte der Plattform ändern sich im Laufe der Zeit. Bestätigen Sie daher stets den aktuellen Ablauf in der offiziellen Tradovate-Plattform und -Dokumentation, bevor Sie handeln.", es: "Esta guía tiene fines exclusivamente educativos e informativos y no constituye asesoramiento financiero, de inversión ni de trading. Operar con futuros y otros productos apalancados conlleva un riesgo sustancial de pérdida y no es adecuado para todos los inversores. PickMyTrade es una plataforma de automatización independiente de terceros y no está afiliada, respaldada ni patrocinada por Tradovate, Inc. «Tradovate» y todos los nombres, logotipos y marcas relacionados son propiedad de sus respectivos titulares. Las funciones y los pasos de la plataforma cambian con el tiempo, por lo que debe confirmar siempre el proceso vigente en la plataforma y la documentación oficiales de Tradovate antes de actuar.", fr: "Ce guide est fourni à titre purement éducatif et informatif et ne constitue pas un conseil financier, d’investissement ou de trading. Le trading de contrats à terme et d’autres produits à effet de levier comporte un risque de perte important et ne convient pas à tous les investisseurs. PickMyTrade est une plateforme d’automatisation tierce indépendante et n’est ni affiliée à Tradovate, Inc., ni approuvée ou parrainée par celle-ci. « Tradovate » ainsi que tous les noms, logos et marques associés sont la propriété de leurs détenteurs respectifs. Les fonctionnalités et les étapes de la plateforme évoluent avec le temps ; vérifiez donc toujours la procédure en vigueur dans la plateforme et la documentation officielles de Tradovate avant d’agir.", it: "Questa guida ha scopo esclusivamente educativo e informativo e non costituisce consulenza finanziaria, di investimento o di trading. Il trading di futures e di altri prodotti a leva comporta un rischio sostanziale di perdita e non è adatto a tutti gli investitori. PickMyTrade è una piattaforma di automazione indipendente di terze parti e non è affiliata, approvata né sponsorizzata da Tradovate, Inc. «Tradovate» e tutti i nomi, loghi e marchi correlati sono di proprietà dei rispettivi titolari. Le funzionalità e i passaggi della piattaforma cambiano nel tempo, quindi verifichi sempre la procedura attuale nella piattaforma e nella documentazione ufficiali di Tradovate prima di agire." },
};
