---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "tradovate-account-statements";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/how-to/${SLUG}`;

const META_TITLE = "Access Daily & Monthly Statements in Tradovate";
const META_DESCRIPTION =
  "Tradovate account statements made simple: open Reports, click Client Statements, filter by date, and download daily or monthly PDFs fast.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Tägliche und monatliche Kontoauszüge in Tradovate abrufen", es: "Cómo acceder a los extractos diarios y mensuales en Tradovate", fr: "Accéder aux relevés quotidiens et mensuels dans Tradovate", it: "Come accedere agli estratti conto giornalieri e mensili in Tradovate" },
  dek: { en: "Need to pull your daily or monthly account statements in Tradovate? Here's exactly where the statements live and how to find, filter, and download the official PDFs in about a minute.", de: "Sie möchten Ihre täglichen oder monatlichen Kontoauszüge in Tradovate abrufen? So finden, filtern und laden Sie die offiziellen PDFs in etwa einer Minute herunter.", es: "¿Necesita obtener sus extractos de cuenta diarios o mensuales en Tradovate? Aquí le explicamos dónde están y cómo encontrar, filtrar y descargar los PDF oficiales en aproximadamente un minuto.", fr: "Vous avez besoin de vos relevés de compte quotidiens ou mensuels dans Tradovate ? Voici où ils se trouvent et comment trouver, filtrer et télécharger les PDF officiels en environ une minute.", it: "Ha bisogno dei suoi estratti conto giornalieri o mensili in Tradovate? Ecco dove si trovano e come individuare, filtrare e scaricare i PDF ufficiali in circa un minuto." },
  readTime: { en: "4 min read", de: "4 Min. Lesezeit", es: "Lectura de 4 min", fr: "Lecture : 4 min", it: "Lettura di 4 min" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "Need to pull your daily or monthly account statements in Tradovate? Maybe you're auditing fills, filing taxes, or reconciling a funded account. Whatever the reason, here's exactly where the statements live and how to find, filter, and download the official PDFs in about a minute." },
    { type: "heading", text: "What Are Tradovate Account Statements?" },
    { type: "paragraph", html: "Your account statements are the official end-of-day and end-of-month records of everything that happened in your account: fills, realized profit and loss, fees, and closing balances. Tradovate emails you the daily statement every night, but you don't have to wait on your inbox. Both daily and monthly statements sit inside the platform's reporting area, ready to pull up any time you want to look back." },
    { type: "heading", text: "Downloading Account Statements in Tradovate: Step-by-Step" },
    {
      type: "steps",
      items: [
        { title: "Open the Reports Panel", html: "Fire up the Tradovate web or desktop platform and open the Reports view. There are two ways in: click the <strong class='text-white'>margin bars</strong> at the top of the platform, or click the <strong class='text-white'>Reports icon</strong> in the sidebar. Either one opens the Reports modal, where all of your account documents live.", image: { src: `${IMG}/tradovate-account-statements-1.png`, alt: "Tradovate platform showing the Reports icon and margin bars used to open account statements" } },
        { title: "Select Client Statements", html: "Once the Reports modal is open, pick <strong class='text-white'>Client Statements</strong>. That's the section holding your daily and monthly account statements, and it's kept separate from the trade-performance reports, so don't confuse the two.", image: { src: `${IMG}/tradovate-account-statements-2.png`, alt: "Tradovate Reports modal showing the Client Statements option" } },
        { title: "Filter by Date", html: "Now narrow things down with the date filter. Pick a single trading day and you'll get that day's statement; select a month and you'll get the monthly summary instead. The list refreshes to show whatever matches your selection.", image: { src: `${IMG}/tradovate-account-statements-3.png`, alt: "Tradovate Client Statements report with a date filter for daily and monthly statements" } },
        { title: "Download the PDF", html: "Click the statement link in the list. Tradovate builds the document and downloads it straight to your computer as a PDF, ready to save, print, or forward to your accountant.", image: { src: `${IMG}/tradovate-account-statements-4.png`, alt: "Tradovate account statement link downloading as a PDF file" } },
      ],
    },
    { type: "heading", text: "Why You'd Need This" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Tax filing</strong>, hand your accountant clean, broker-issued PDFs of realized P&L and fees instead of a messy spreadsheet.",
        "<strong class='text-white'>Auditing fills</strong>, confirm exactly what filled, at what price, and when.",
        "<strong class='text-white'>Reconciling a funded or prop account</strong>, match your statement against your firm's dashboard. Statement availability can vary by firm and account type, so check your firm's current rules.",
        "<strong class='text-white'>Record-keeping</strong>, build an archive of monthly summaries for your own performance review.",
        "<strong class='text-white'>Disputes</strong>, back up any question about a fill, fee, or balance with the official document.",
      ],
    },
    { type: "heading", text: "Automate This with PickMyTrade" },
    { type: "paragraph", html: "Statements are the paper trail; your entries and exits are the story behind them. <strong class='text-white'>PickMyTrade wires your TradingView alerts straight into your Tradovate account</strong>, so trades fire on their own with no manual clicking. The upshot: the fills that land on tomorrow's statement match your strategy exactly, every single time." },
  ], de: [
    { type: "paragraph",html: "Sie möchten Ihre täglichen oder monatlichen Kontoauszüge in Tradovate abrufen? Vielleicht prüfen Sie Fills, bereiten Ihre Steuererklärung vor oder gleichen ein Funded-Konto ab. Was auch immer der Grund ist: So finden, filtern und laden Sie die offiziellen PDFs in etwa einer Minute herunter." },
    { type: "heading",text: "Was sind Tradovate-Kontoauszüge?" },
    { type: "paragraph",html: "Ihre Kontoauszüge sind die offiziellen Tages- und Monatsabschlüsse von allem, was in Ihrem Konto passiert ist: Fills, realisierter Gewinn und Verlust, Gebühren und Schlussstände. Tradovate schickt Ihnen den Tagesauszug jede Nacht per E-Mail, doch Sie müssen nicht auf Ihren Posteingang warten. Sowohl Tages- als auch Monatsauszüge befinden sich im Berichtsbereich der Plattform und stehen jederzeit zum Nachschlagen bereit." },
    { type: "heading",text: "Kontoauszüge in Tradovate herunterladen: Schritt für Schritt" },
    {
      type: "steps",
      items: [
        { title: "Das Reports-Panel öffnen", html: "Starten Sie die Tradovate-Web- oder Desktop-Plattform und öffnen Sie die Ansicht Reports. Es gibt zwei Wege: Klicken Sie oben in der Plattform auf die <strong class='text-white'>Margin-Balken</strong> oder in der Seitenleiste auf das <strong class='text-white'>Reports-Symbol</strong>. Beide öffnen das Reports-Fenster, in dem alle Ihre Kontodokumente liegen.", image: {"src":`${IMG}/tradovate-account-statements-1.png`,"alt":"Tradovate-Plattform mit dem Reports-Symbol und den Margin-Balken zum Öffnen der Kontoauszüge"} },
        { title: "Client Statements auswählen", html: "Sobald das Reports-Fenster geöffnet ist, wählen Sie <strong class='text-white'>Client Statements</strong>. Dieser Bereich enthält Ihre täglichen und monatlichen Kontoauszüge und ist von den Trade-Performance-Berichten getrennt, verwechseln Sie die beiden also nicht.", image: {"src":`${IMG}/tradovate-account-statements-2.png`,"alt":"Tradovate-Reports-Fenster mit der Option Client Statements"} },
        { title: "Nach Datum filtern", html: "Grenzen Sie die Anzeige nun mit dem Datumsfilter ein. Wählen Sie einen einzelnen Handelstag, erhalten Sie den Auszug dieses Tages; wählen Sie einen Monat, erhalten Sie stattdessen die Monatsübersicht. Die Liste wird aktualisiert und zeigt, was zu Ihrer Auswahl passt.", image: {"src":`${IMG}/tradovate-account-statements-3.png`,"alt":"Tradovate-Bericht Client Statements mit Datumsfilter für tägliche und monatliche Kontoauszüge"} },
        { title: "Das PDF herunterladen", html: "Klicken Sie in der Liste auf den Auszugs-Link. Tradovate erstellt das Dokument und lädt es direkt als PDF auf Ihren Computer herunter, bereit zum Speichern, Drucken oder Weiterleiten an Ihren Steuerberater.", image: {"src":`${IMG}/tradovate-account-statements-4.png`,"alt":"Tradovate-Kontoauszugs-Link, der als PDF-Datei heruntergeladen wird"} },
      ],
    },
    { type: "heading",text: "Wofür Sie das brauchen" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Steuererklärung</strong>, übergeben Sie Ihrem Steuerberater saubere, vom Broker ausgestellte PDFs mit realisiertem GuV und Gebühren statt einer unübersichtlichen Tabelle.",
        "<strong class='text-white'>Prüfung von Fills</strong>, bestätigen Sie genau, was zu welchem Preis und wann ausgeführt wurde.",
        "<strong class='text-white'>Abgleich eines Funded- oder Prop-Kontos</strong>, gleichen Sie Ihren Auszug mit dem Dashboard Ihrer Firma ab. Die Verfügbarkeit von Auszügen kann je nach Firma und Kontotyp variieren, prüfen Sie daher die aktuellen Regeln Ihrer Firma.",
        "<strong class='text-white'>Archivierung</strong>, bauen Sie ein Archiv monatlicher Zusammenfassungen für Ihre eigene Performance-Auswertung auf.",
        "<strong class='text-white'>Streitfälle</strong>, belegen Sie jede Frage zu einem Fill, einer Gebühr oder einem Kontostand mit dem offiziellen Dokument.",
      ],
    },
    { type: "heading",text: "Automatisieren Sie das mit PickMyTrade" },
    { type: "paragraph",html: "Kontoauszüge sind die Belege; Ihre Einstiege und Ausstiege sind die Geschichte dahinter. <strong class='text-white'>PickMyTrade verbindet Ihre TradingView-Alerts direkt mit Ihrem Tradovate-Konto</strong>, sodass Trades von selbst ausgelöst werden, ganz ohne manuelles Klicken. Das Ergebnis: Die Fills, die auf dem Auszug von morgen erscheinen, entsprechen jedes Mal exakt Ihrer Strategie." },
  ], es: [
    { type: "paragraph",html: "¿Necesita obtener sus extractos de cuenta diarios o mensuales en Tradovate? Quizá esté revisando ejecuciones, preparando su declaración de impuestos o conciliando una cuenta fondeada. Sea cual sea el motivo, aquí le explicamos dónde están y cómo encontrar, filtrar y descargar los PDF oficiales en aproximadamente un minuto." },
    { type: "heading",text: "¿Qué son los extractos de cuenta de Tradovate?" },
    { type: "paragraph",html: "Sus extractos de cuenta son los registros oficiales de cierre diario y mensual de todo lo ocurrido en su cuenta: ejecuciones, pérdidas y ganancias realizadas, comisiones y saldos finales. Tradovate le envía por correo el extracto diario cada noche, pero no tiene que esperar a su bandeja de entrada. Tanto los extractos diarios como los mensuales están en el área de informes de la plataforma, listos para consultarlos cuando quiera mirar atrás." },
    { type: "heading",text: "Cómo descargar los extractos de cuenta en Tradovate: paso a paso" },
    {
      type: "steps",
      items: [
        { title: "Abra el panel Reports", html: "Inicie la plataforma web o de escritorio de Tradovate y abra la vista Reports. Hay dos formas de entrar: haga clic en las <strong class='text-white'>barras de margen</strong> situadas en la parte superior de la plataforma o en el <strong class='text-white'>icono Reports</strong> de la barra lateral. Cualquiera de ellas abre la ventana Reports, donde se encuentran todos los documentos de su cuenta.", image: {"src":`${IMG}/tradovate-account-statements-1.png`,"alt":"Plataforma Tradovate con el icono Reports y las barras de margen para abrir los extractos de cuenta"} },
        { title: "Seleccione Client Statements", html: "Con la ventana Reports abierta, elija <strong class='text-white'>Client Statements</strong>. Es la sección que contiene sus extractos diarios y mensuales, y está separada de los informes de rendimiento de operaciones, así que no los confunda.", image: {"src":`${IMG}/tradovate-account-statements-2.png`,"alt":"Ventana Reports de Tradovate con la opción Client Statements"} },
        { title: "Filtre por fecha", html: "Ahora acote la búsqueda con el filtro de fecha. Si elige un único día de trading, obtendrá el extracto de ese día; si selecciona un mes, obtendrá el resumen mensual. La lista se actualiza para mostrar lo que coincide con su selección.", image: {"src":`${IMG}/tradovate-account-statements-3.png`,"alt":"Informe Client Statements de Tradovate con un filtro de fecha para extractos diarios y mensuales"} },
        { title: "Descargue el PDF", html: "Haga clic en el enlace del extracto de la lista. Tradovate genera el documento y lo descarga directamente en su ordenador como PDF, listo para guardarlo, imprimirlo o enviarlo a su contable.", image: {"src":`${IMG}/tradovate-account-statements-4.png`,"alt":"Enlace de extracto de cuenta de Tradovate descargándose como archivo PDF"} },
      ],
    },
    { type: "heading",text: "Para qué lo necesitará" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Declaración de impuestos</strong>, entregue a su contable PDF limpios emitidos por el bróker con el P&L realizado y las comisiones, en lugar de una hoja de cálculo desordenada.",
        "<strong class='text-white'>Auditoría de ejecuciones</strong>, confirme exactamente qué se ejecutó, a qué precio y cuándo.",
        "<strong class='text-white'>Conciliación de una cuenta fondeada o de prop firm</strong>, contraste su extracto con el panel de su firma. La disponibilidad de extractos puede variar según la firma y el tipo de cuenta, así que consulte las reglas vigentes de su firma.",
        "<strong class='text-white'>Conservación de registros</strong>, cree un archivo de resúmenes mensuales para su propia revisión del rendimiento.",
        "<strong class='text-white'>Disputas</strong>, respalde cualquier duda sobre una ejecución, una comisión o un saldo con el documento oficial.",
      ],
    },
    { type: "heading",text: "Automatice esto con PickMyTrade" },
    { type: "paragraph",html: "Los extractos son el rastro documental; sus entradas y salidas son la historia que hay detrás. <strong class='text-white'>PickMyTrade conecta sus alertas de TradingView directamente con su cuenta de Tradovate</strong>, de modo que las operaciones se ejecutan solas, sin clics manuales. El resultado: las ejecuciones que aparezcan en el extracto de mañana coincidirán exactamente con su estrategia, siempre." },
  ], fr: [
    { type: "paragraph",html: "Vous avez besoin de vos relevés de compte quotidiens ou mensuels dans Tradovate ? Peut-être vérifiez-vous des exécutions, préparez-vous votre déclaration fiscale ou rapprochez-vous un compte financé. Quelle que soit la raison, voici où se trouvent les relevés et comment trouver, filtrer et télécharger les PDF officiels en environ une minute." },
    { type: "heading",text: "Que sont les relevés de compte Tradovate ?" },
    { type: "paragraph",html: "Vos relevés de compte sont les documents officiels de fin de journée et de fin de mois retraçant tout ce qui s'est passé sur votre compte : exécutions, profits et pertes réalisés, frais et soldes de clôture. Tradovate vous envoie le relevé quotidien par e-mail chaque nuit, mais vous n'avez pas à attendre votre boîte de réception. Les relevés quotidiens comme mensuels se trouvent dans la zone de rapports de la plateforme, prêts à être consultés dès que vous voulez revenir en arrière." },
    { type: "heading",text: "Télécharger les relevés de compte dans Tradovate : étape par étape" },
    {
      type: "steps",
      items: [
        { title: "Ouvrir le panneau Reports", html: "Lancez la plateforme web ou de bureau Tradovate et ouvrez la vue Reports. Il y a deux façons d'y accéder : cliquez sur les <strong class='text-white'>barres de marge</strong> en haut de la plateforme, ou sur l'<strong class='text-white'>icône Reports</strong> dans la barre latérale. Les deux ouvrent la fenêtre Reports, où se trouvent tous vos documents de compte.", image: {"src":`${IMG}/tradovate-account-statements-1.png`,"alt":"Plateforme Tradovate avec l'icône Reports et les barres de marge servant à ouvrir les relevés de compte"} },
        { title: "Sélectionner Client Statements", html: "Une fois la fenêtre Reports ouverte, choisissez <strong class='text-white'>Client Statements</strong>. C'est la section qui contient vos relevés de compte quotidiens et mensuels ; elle est distincte des rapports de performance des trades, ne les confondez donc pas.", image: {"src":`${IMG}/tradovate-account-statements-2.png`,"alt":"Fenêtre Reports de Tradovate avec l'option Client Statements"} },
        { title: "Filtrer par date", html: "Affinez maintenant avec le filtre de date. Choisissez un seul jour de trading et vous obtiendrez le relevé de ce jour ; sélectionnez un mois et vous obtiendrez le récapitulatif mensuel. La liste se met à jour pour afficher ce qui correspond à votre sélection.", image: {"src":`${IMG}/tradovate-account-statements-3.png`,"alt":"Rapport Client Statements de Tradovate avec un filtre de date pour les relevés quotidiens et mensuels"} },
        { title: "Télécharger le PDF", html: "Cliquez sur le lien du relevé dans la liste. Tradovate génère le document et le télécharge directement sur votre ordinateur au format PDF, prêt à être enregistré, imprimé ou transmis à votre comptable.", image: {"src":`${IMG}/tradovate-account-statements-4.png`,"alt":"Lien d'un relevé de compte Tradovate téléchargé sous forme de fichier PDF"} },
      ],
    },
    { type: "heading",text: "Pourquoi vous en avez besoin" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Déclaration fiscale</strong>, remettez à votre comptable des PDF propres, émis par le courtier, du P&L réalisé et des frais plutôt qu'un tableur brouillon.",
        "<strong class='text-white'>Vérification des exécutions</strong>, confirmez exactement ce qui a été exécuté, à quel prix et à quel moment.",
        "<strong class='text-white'>Rapprochement d'un compte financé ou prop firm</strong>, comparez votre relevé au tableau de bord de votre société. La disponibilité des relevés peut varier selon la société et le type de compte ; consultez donc les règles actuelles de votre société.",
        "<strong class='text-white'>Tenue de registres</strong>, constituez une archive de récapitulatifs mensuels pour votre propre analyse de performance.",
        "<strong class='text-white'>Litiges</strong>, appuyez toute question sur une exécution, des frais ou un solde par le document officiel.",
      ],
    },
    { type: "heading",text: "Automatisez tout cela avec PickMyTrade" },
    { type: "paragraph",html: "Les relevés sont la trace écrite ; vos entrées et sorties sont l'histoire qui se cache derrière. <strong class='text-white'>PickMyTrade relie vos alertes TradingView directement à votre compte Tradovate</strong>, de sorte que les trades se déclenchent d'eux-mêmes, sans aucun clic manuel. Résultat : les exécutions qui figureront sur le relevé de demain correspondent exactement à votre stratégie, à chaque fois." },
  ], it: [
    { type: "paragraph",html: "Ha bisogno dei suoi estratti conto giornalieri o mensili in Tradovate? Magari sta verificando le esecuzioni, preparando la dichiarazione dei redditi o riconciliando un conto finanziato. Qualunque sia il motivo, ecco dove si trovano gli estratti conto e come individuare, filtrare e scaricare i PDF ufficiali in circa un minuto." },
    { type: "heading",text: "Cosa sono gli estratti conto di Tradovate?" },
    { type: "paragraph",html: "I suoi estratti conto sono i documenti ufficiali di fine giornata e fine mese di tutto ciò che è accaduto nel conto: esecuzioni, profitti e perdite realizzati, commissioni e saldi di chiusura. Tradovate le invia l'estratto conto giornaliero via e-mail ogni notte, ma non deve aspettare la posta in arrivo. Sia gli estratti giornalieri sia quelli mensili si trovano nell'area dei report della piattaforma, pronti da consultare ogni volta che vuole guardare indietro." },
    { type: "heading",text: "Scaricare gli estratti conto in Tradovate: passo dopo passo" },
    {
      type: "steps",
      items: [
        { title: "Aprire il pannello Reports", html: "Avvii la piattaforma web o desktop di Tradovate e apra la vista Reports. Ci sono due modi per accedervi: clicchi sulle <strong class='text-white'>barre del margine</strong> nella parte superiore della piattaforma oppure sull'<strong class='text-white'>icona Reports</strong> nella barra laterale. Entrambe aprono la finestra Reports, dove si trovano tutti i documenti del suo conto.", image: {"src":`${IMG}/tradovate-account-statements-1.png`,"alt":"Piattaforma Tradovate con l'icona Reports e le barre del margine per aprire gli estratti conto"} },
        { title: "Selezionare Client Statements", html: "Una volta aperta la finestra Reports, scelga <strong class='text-white'>Client Statements</strong>. È la sezione che contiene i suoi estratti conto giornalieri e mensili ed è separata dai report di performance dei trade, quindi non li confonda.", image: {"src":`${IMG}/tradovate-account-statements-2.png`,"alt":"Finestra Reports di Tradovate con l'opzione Client Statements"} },
        { title: "Filtrare per data", html: "Ora restringa la ricerca con il filtro per data. Scegliendo un singolo giorno di trading otterrà l'estratto di quel giorno; selezionando un mese otterrà invece il riepilogo mensile. L'elenco si aggiorna e mostra ciò che corrisponde alla sua selezione.", image: {"src":`${IMG}/tradovate-account-statements-3.png`,"alt":"Report Client Statements di Tradovate con filtro per data per gli estratti conto giornalieri e mensili"} },
        { title: "Scaricare il PDF", html: "Clicchi sul link dell'estratto conto nell'elenco. Tradovate genera il documento e lo scarica direttamente sul suo computer come PDF, pronto da salvare, stampare o inoltrare al suo commercialista.", image: {"src":`${IMG}/tradovate-account-statements-4.png`,"alt":"Link dell'estratto conto Tradovate che viene scaricato come file PDF"} },
      ],
    },
    { type: "heading",text: "Perché Le serve" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Dichiarazione dei redditi</strong>, consegni al suo commercialista PDF puliti, emessi dal broker, con P&L realizzato e commissioni, invece di un foglio di calcolo disordinato.",
        "<strong class='text-white'>Verifica delle esecuzioni</strong>, confermi esattamente cosa è stato eseguito, a quale prezzo e quando.",
        "<strong class='text-white'>Riconciliazione di un conto finanziato o prop</strong>, confronti il suo estratto con la dashboard della sua società. La disponibilità degli estratti può variare in base alla società e al tipo di conto, quindi verifichi le regole attuali della sua società.",
        "<strong class='text-white'>Conservazione dei documenti</strong>, costruisca un archivio di riepiloghi mensili per la sua analisi della performance.",
        "<strong class='text-white'>Contestazioni</strong>, supporti qualsiasi dubbio su un'esecuzione, una commissione o un saldo con il documento ufficiale.",
      ],
    },
    { type: "heading",text: "Automatizzi tutto con PickMyTrade" },
    { type: "paragraph",html: "Gli estratti conto sono la traccia documentale; i suoi ingressi e le sue uscite sono la storia che c'è dietro. <strong class='text-white'>PickMyTrade collega i suoi alert di TradingView direttamente al suo conto Tradovate</strong>, così i trade partono da soli, senza clic manuali. Il risultato: le esecuzioni che compariranno sull'estratto di domani corrispondono esattamente alla sua strategia, ogni singola volta." },
  ] },
  ctaHeading: { en: "Automate Your Tradovate Trades", de: "Automatisieren Sie Ihre Tradovate-Trades", es: "Automatice sus operaciones en Tradovate", fr: "Automatisez vos trades sur Tradovate", it: "Automatizzi i suoi trade su Tradovate" },
