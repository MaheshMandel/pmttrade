---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "tradovate-bookmap";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/how-to/${SLUG}`;

const META_TITLE = "Connect Tradovate to Bookmap (Adapter Setup)";
const META_DESCRIPTION =
  "Connect Tradovate to Bookmap: install the adapter, log in, and stream CME futures data while routing orders from a live or demo account.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Tradovate mit Bookmap verbinden (Adapter-Einrichtung)", es: "Conecte Tradovate a Bookmap (configuración del adaptador)", fr: "Connecter Tradovate à Bookmap (configuration de l’adaptateur)", it: "Collegare Tradovate a Bookmap (configurazione dell’adapter)" },
  dek: { en: "Bookmap's order-flow heatmap is one of the cleaner ways to read CME futures, and you can drive it straight off your Tradovate account. Install the Tradovate adapter and get data plus live order routing in one window.", de: "Die Order-Flow-Heatmap von Bookmap ist eine der übersichtlichsten Möglichkeiten, CME-Futures zu lesen, und Sie können sie direkt über Ihr Tradovate-Konto betreiben. Installieren Sie den Tradovate-Adapter und erhalten Sie Daten und Live-Orderrouting in einem Fenster.", es: "El mapa de calor de order flow de Bookmap es una de las formas más claras de leer los futuros del CME, y puede manejarlo directamente desde su cuenta de Tradovate. Instale el adaptador de Tradovate y obtenga datos y enrutamiento de órdenes en vivo en una sola ventana.", fr: "La heatmap d’order flow de Bookmap est l’un des moyens les plus lisibles de suivre les contrats à terme du CME, et vous pouvez la piloter directement depuis votre compte Tradovate. Installez l’adaptateur Tradovate et obtenez les données et le routage d’ordres en direct dans une seule fenêtre.", it: "La heatmap dell’order flow di Bookmap è uno dei modi più chiari per leggere i futures CME, e Lei può pilotarla direttamente dal Suo conto Tradovate. Installi l’adapter Tradovate e ottenga dati e instradamento degli ordini in tempo reale in un’unica finestra." },
  readTime: { en: "6 min read", de: "6 Min. Lesezeit", es: "Lectura de 6 min", fr: "Lecture : 6 min", it: "Lettura di 6 min" },
  lastUpdated: "2026-07-10",
  blocks: { en: [
    { type: "paragraph", html: "Bookmap's order-flow heatmap is one of the cleaner ways to read CME futures, and you can drive it straight off your Tradovate account. Install the Tradovate adapter and you get the data feed and live order routing in one window, read the tape, then click to trade. Here's the exact setup, start to finish." },
    { type: "heading", text: "What the Tradovate Adapter Does" },
    { type: "paragraph", html: "Bookmap connects to brokers and feeds through small plugins called adapters. The <strong class='text-white'>tradovate-adapter</strong> lets Bookmap pull CME futures data from Tradovate and send orders back to your account. You can run it two ways: use Tradovate for <strong class='text-white'>both data and trading</strong>, or <strong class='text-white'>only for order routing</strong> while a third-party feed (such as dxFeed) supplies the data. Worth knowing up front, Tradovate delivers <strong class='text-white'>partial-depth</strong> CME data to Bookmap, not the full order book, so for every level of depth you'll pair Tradovate execution with a fuller feed." },
    { type: "heading", text: "What You'll Need First" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>A Bookmap plan that supports the Tradovate adapter</strong>, real-time connectivity isn't part of every tier, so confirm your current Bookmap subscription covers live data and trading.",
        "<strong class='text-white'>A Tradovate account</strong>, live, demo, or a prop-firm evaluation account works.",
        "<strong class='text-white'>An active real-time CME market-data subscription</strong> for live quotes, without it you'll see delayed data. Costs and availability vary by account and prop firm, so check your firm's current rules.",
      ],
    },
    { type: "heading", text: "Connect Tradovate to Bookmap: Step-by-Step" },
    {
      type: "steps",
      items: [
        { title: "Install the tradovate-adapter", html: "Open Bookmap, go to the <strong class='text-white'>Settings</strong> menu, and open the plugins/connections manager (the option that lists installable adapters). Find <strong class='text-white'>tradovate-adapter</strong> in the list, if it shows as available to install, click <strong class='text-white'>Install</strong>, then <strong class='text-white'>restart Bookmap</strong> so the adapter loads. If Tradovate already appears in your connections list, it's installed and you can skip ahead." },
        { title: "Add Tradovate in the Connectivity Configuration", html: "Open the <strong class='text-white'>Connections</strong> menu and choose <strong class='text-white'>Configure</strong> to bring up the <strong class='text-white'>Connectivity Configuration</strong> window. Select <strong class='text-white'>Tradovate</strong> from the platform list. If you're linking a simulated account, tick the <strong class='text-white'>demo account</strong> checkbox so Bookmap points at the right environment. Then click <strong class='text-white'>Add Connection</strong> to save it." },
        { title: "Sign In Through the Tradovate Login Popup", html: "Back in the <strong class='text-white'>Connections</strong> panel, enable (check) the Tradovate connection. A <strong class='text-white'>Tradovate login window opens in your browser</strong>, enter your Tradovate or prop-firm <strong class='text-white'>username and password</strong>, or use the social login option if that's how your account is set up. Bookmap uses these credentials only to authenticate you with Tradovate. Once it connects, the status turns to connected." },
        { title: "Subscribe to a Futures Instrument", html: "With Tradovate connected, add a new instrument and subscribe to a <strong class='text-white'>front-month CME futures contract</strong>, ES, NQ, CL, or whatever you trade. Use the current active contract, not a continuous symbol. The heatmap fills in as soon as real-time data flows; a blank or delayed chart usually means the market-data subscription isn't active yet." },
        { title: "Enable Trading and Route Orders", html: "To trade, turn on <strong class='text-white'>trading mode</strong> and confirm <strong class='text-white'>Tradovate</strong> is the selected trading connection for that instrument. Open the <strong class='text-white'>Trade Control Panel</strong> and you're set, place, drag, and cancel Tradovate orders right on the Bookmap chart, with fills reflected back in your account. Do a small test order on a demo account first to confirm everything routes cleanly." },
      ],
    },
    { type: "heading", text: "Why Traders Pair Bookmap With Tradovate" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Read order flow and execute in one place</strong>, the heatmap and your order routing share a single window.",
        "<strong class='text-white'>Trade the contracts Tradovate supports</strong>, ES, NQ, CL, GC, and the micros, live or in sim.",
        "<strong class='text-white'>Keep your data flexible</strong>, run Tradovate for both feed and fills, or route orders through Tradovate while a fuller feed powers the map.",
      ],
    },
    { type: "heading", text: "Automate Tradovate With PickMyTrade" },
    { type: "paragraph", html: "Bookmap is built for reading the tape and clicking your own trades. If you'd rather have a strategy pull the trigger, PickMyTrade turns your <strong class='text-white'>TradingView alerts into real Tradovate orders automatically</strong>, entries, stops, and targets execute the moment your signal prints. Watch the flow in Bookmap, let your alerts handle the execution." },
  ], de: [
    { type: "paragraph",html: "Die Order-Flow-Heatmap von Bookmap ist eine der übersichtlichsten Möglichkeiten, CME-Futures zu lesen, und Sie können sie direkt über Ihr Tradovate-Konto betreiben. Mit dem Tradovate-Adapter erhalten Sie den Datenfeed und das Live-Orderrouting in einem Fenster: Lesen Sie das Tape und klicken Sie dann, um zu handeln. Hier ist die genaue Einrichtung, von Anfang bis Ende." },
    { type: "heading",text: "Was der Tradovate-Adapter leistet" },
    { type: "paragraph",html: "Bookmap verbindet sich über kleine Plugins, sogenannte Adapter, mit Brokern und Datenfeeds. Der <strong class='text-white'>tradovate-adapter</strong> ermöglicht es Bookmap, CME-Futures-Daten von Tradovate abzurufen und Orders an Ihr Konto zu senden. Sie können ihn auf zwei Arten nutzen: Tradovate für <strong class='text-white'>Daten und Handel</strong> oder <strong class='text-white'>nur für das Orderrouting</strong>, während ein Drittanbieter-Feed (z. B. dxFeed) die Daten liefert. Wichtig vorab: Tradovate liefert <strong class='text-white'>Partial-Depth</strong>-CME-Daten an Bookmap, nicht das vollständige Orderbuch. Für jede Tiefenebene kombinieren Sie die Tradovate-Ausführung daher mit einem umfassenderen Feed." },
    { type: "heading",text: "Was Sie zuerst benötigen" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Einen Bookmap-Tarif, der den Tradovate-Adapter unterstützt</strong>, Echtzeit-Konnektivität ist nicht in jeder Stufe enthalten. Prüfen Sie daher, ob Ihr aktuelles Bookmap-Abonnement Live-Daten und Handel abdeckt.",
        "<strong class='text-white'>Ein Tradovate-Konto</strong>, ein Live-, Demo- oder Prop-Firm-Evaluierungskonto funktioniert.",
        "<strong class='text-white'>Ein aktives Echtzeit-CME-Marktdatenabonnement</strong> für Live-Kurse, ohne dieses sehen Sie verzögerte Daten. Kosten und Verfügbarkeit variieren je nach Konto und Prop Firm, prüfen Sie daher die aktuellen Regeln Ihrer Firma.",
      ],
    },
    { type: "heading",text: "Tradovate mit Bookmap verbinden: Schritt für Schritt" },
    {
      type: "steps",
      items: [
        { title: "Den tradovate-adapter installieren", html: "Öffnen Sie Bookmap, gehen Sie zum Menü <strong class='text-white'>Settings</strong> und öffnen Sie den Plugin-/Verbindungsmanager (die Option, die installierbare Adapter auflistet). Suchen Sie <strong class='text-white'>tradovate-adapter</strong> in der Liste. Wenn er als installierbar angezeigt wird, klicken Sie auf <strong class='text-white'>Install</strong> und <strong class='text-white'>starten Sie Bookmap neu</strong>, damit der Adapter geladen wird. Wenn Tradovate bereits in Ihrer Verbindungsliste erscheint, ist er installiert und Sie können diesen Schritt überspringen." },
        { title: "Tradovate in der Connectivity Configuration hinzufügen", html: "Öffnen Sie das Menü <strong class='text-white'>Connections</strong> und wählen Sie <strong class='text-white'>Configure</strong>, um das Fenster <strong class='text-white'>Connectivity Configuration</strong> aufzurufen. Wählen Sie <strong class='text-white'>Tradovate</strong> aus der Plattformliste. Wenn Sie ein simuliertes Konto verknüpfen, aktivieren Sie das Kontrollkästchen <strong class='text-white'>demo account</strong>, damit Bookmap auf die richtige Umgebung zeigt. Klicken Sie dann auf <strong class='text-white'>Add Connection</strong>, um sie zu speichern." },
        { title: "Über das Tradovate-Login-Popup anmelden", html: "Aktivieren Sie im Bereich <strong class='text-white'>Connections</strong> die Tradovate-Verbindung (Häkchen setzen). Ein <strong class='text-white'>Tradovate-Anmeldefenster öffnet sich in Ihrem Browser</strong>. Geben Sie Ihren Tradovate- oder Prop-Firm-<strong class='text-white'>Benutzernamen und Ihr Passwort</strong> ein oder nutzen Sie die Social-Login-Option, falls Ihr Konto so eingerichtet ist. Bookmap verwendet diese Zugangsdaten nur, um Sie bei Tradovate zu authentifizieren. Sobald die Verbindung steht, wechselt der Status auf verbunden." },
        { title: "Ein Futures-Instrument abonnieren", html: "Fügen Sie bei verbundenem Tradovate ein neues Instrument hinzu und abonnieren Sie einen <strong class='text-white'>CME-Futures-Kontrakt des Frontmonats</strong>, ES, NQ, CL oder was auch immer Sie handeln. Verwenden Sie den aktuell aktiven Kontrakt, kein fortlaufendes Symbol. Die Heatmap füllt sich, sobald Echtzeitdaten fließen. Ein leerer oder verzögerter Chart bedeutet meist, dass das Marktdatenabonnement noch nicht aktiv ist." },
        { title: "Handel aktivieren und Orders routen", html: "Um zu handeln, aktivieren Sie den <strong class='text-white'>Trading-Modus</strong> und bestätigen Sie, dass <strong class='text-white'>Tradovate</strong> die ausgewählte Handelsverbindung für dieses Instrument ist. Öffnen Sie das <strong class='text-white'>Trade Control Panel</strong> und Sie sind startklar: Platzieren, verschieben und stornieren Sie Tradovate-Orders direkt im Bookmap-Chart, die Ausführungen werden in Ihrem Konto widergespiegelt. Machen Sie zuerst eine kleine Testorder auf einem Demo-Konto, um zu bestätigen, dass alles sauber geroutet wird." },
      ],
    },
    { type: "heading",text: "Warum Trader Bookmap mit Tradovate kombinieren" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Order Flow lesen und an einem Ort ausführen</strong>, Heatmap und Orderrouting teilen sich ein Fenster.",
        "<strong class='text-white'>Die von Tradovate unterstützten Kontrakte handeln</strong>, ES, NQ, CL, GC und die Micros, live oder in der Simulation.",
        "<strong class='text-white'>Flexible Datenquellen</strong>, nutzen Sie Tradovate für Feed und Ausführung oder routen Sie Orders über Tradovate, während ein umfassenderer Feed die Karte speist.",
      ],
    },
    { type: "heading",text: "Tradovate mit PickMyTrade automatisieren" },
    { type: "paragraph",html: "Bookmap ist darauf ausgelegt, das Tape zu lesen und Ihre eigenen Trades per Klick zu platzieren. Wenn Sie lieber eine Strategie abdrücken lassen möchten, wandelt PickMyTrade Ihre <strong class='text-white'>TradingView-Alarme automatisch in echte Tradovate-Orders</strong> um, Einstiege, Stopps und Ziele werden ausgeführt, sobald Ihr Signal erscheint. Beobachten Sie den Flow in Bookmap und überlassen Sie die Ausführung Ihren Alarmen." },
  ], es: [
    { type: "paragraph",html: "El mapa de calor de order flow de Bookmap es una de las formas más claras de leer los futuros del CME, y puede manejarlo directamente desde su cuenta de Tradovate. Con el adaptador de Tradovate obtiene el feed de datos y el enrutamiento de órdenes en vivo en una sola ventana: lea la cinta y luego haga clic para operar. Esta es la configuración exacta, de principio a fin." },
    { type: "heading",text: "Qué hace el adaptador de Tradovate" },
    { type: "paragraph",html: "Bookmap se conecta a brókers y feeds mediante pequeños plugins llamados adaptadores. El <strong class='text-white'>tradovate-adapter</strong> permite que Bookmap obtenga datos de futuros del CME desde Tradovate y envíe órdenes a su cuenta. Puede usarlo de dos maneras: Tradovate para <strong class='text-white'>datos y operativa</strong>, o <strong class='text-white'>solo para el enrutamiento de órdenes</strong> mientras un feed de terceros (como dxFeed) aporta los datos. Conviene saberlo de antemano: Tradovate entrega a Bookmap datos del CME de <strong class='text-white'>profundidad parcial</strong>, no el libro de órdenes completo, así que para ver todos los niveles de profundidad combinará la ejecución de Tradovate con un feed más completo." },
    { type: "heading",text: "Qué necesita primero" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Un plan de Bookmap compatible con el adaptador de Tradovate</strong>, la conectividad en tiempo real no está incluida en todos los niveles, así que confirme que su suscripción actual de Bookmap cubre datos en vivo y operativa.",
        "<strong class='text-white'>Una cuenta de Tradovate</strong>, sirve una cuenta real, demo o de evaluación de una prop firm.",
        "<strong class='text-white'>Una suscripción activa de datos de mercado CME en tiempo real</strong> para cotizaciones en vivo; sin ella verá datos con retraso. Los costes y la disponibilidad varían según la cuenta y la prop firm, así que consulte las reglas vigentes de su firma.",
      ],
    },
    { type: "heading",text: "Conectar Tradovate a Bookmap: paso a paso" },
    {
      type: "steps",
      items: [
        { title: "Instale el tradovate-adapter", html: "Abra Bookmap, vaya al menú <strong class='text-white'>Settings</strong> y abra el administrador de plugins/conexiones (la opción que lista los adaptadores instalables). Busque <strong class='text-white'>tradovate-adapter</strong> en la lista; si aparece como disponible para instalar, haga clic en <strong class='text-white'>Install</strong> y después <strong class='text-white'>reinicie Bookmap</strong> para que se cargue el adaptador. Si Tradovate ya aparece en su lista de conexiones, está instalado y puede saltar al siguiente paso." },
        { title: "Añada Tradovate en la Connectivity Configuration", html: "Abra el menú <strong class='text-white'>Connections</strong> y elija <strong class='text-white'>Configure</strong> para abrir la ventana <strong class='text-white'>Connectivity Configuration</strong>. Seleccione <strong class='text-white'>Tradovate</strong> en la lista de plataformas. Si va a vincular una cuenta simulada, marque la casilla <strong class='text-white'>demo account</strong> para que Bookmap apunte al entorno correcto. Después haga clic en <strong class='text-white'>Add Connection</strong> para guardarla." },
        { title: "Inicie sesión desde la ventana emergente de Tradovate", html: "De vuelta en el panel <strong class='text-white'>Connections</strong>, active (marque) la conexión de Tradovate. Se abre una <strong class='text-white'>ventana de inicio de sesión de Tradovate en su navegador</strong>: introduzca su <strong class='text-white'>nombre de usuario y contraseña</strong> de Tradovate o de la prop firm, o use la opción de inicio de sesión social si su cuenta está configurada así. Bookmap usa estas credenciales únicamente para autenticarle con Tradovate. Una vez que se conecta, el estado cambia a conectado." },
        { title: "Suscríbase a un instrumento de futuros", html: "Con Tradovate conectado, añada un nuevo instrumento y suscríbase a un <strong class='text-white'>contrato de futuros del CME del mes frontal</strong>, ES, NQ, CL o el que opere. Use el contrato activo actual, no un símbolo continuo. El mapa de calor se llena en cuanto fluyen los datos en tiempo real; un gráfico en blanco o con retraso suele significar que la suscripción de datos de mercado aún no está activa." },
        { title: "Active la operativa y enrute las órdenes", html: "Para operar, active el <strong class='text-white'>modo de trading</strong> y confirme que <strong class='text-white'>Tradovate</strong> es la conexión de trading seleccionada para ese instrumento. Abra el <strong class='text-white'>Trade Control Panel</strong> y estará listo: coloque, arrastre y cancele órdenes de Tradovate directamente en el gráfico de Bookmap, y las ejecuciones se reflejan en su cuenta. Haga primero una pequeña orden de prueba en una cuenta demo para confirmar que todo se enruta correctamente." },
      ],
    },
    { type: "heading",text: "Por qué los traders combinan Bookmap con Tradovate" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Lea el order flow y ejecute en un solo lugar</strong>, el mapa de calor y el enrutamiento de órdenes comparten una sola ventana.",
        "<strong class='text-white'>Opere los contratos que admite Tradovate</strong>, ES, NQ, CL, GC y los micros, en vivo o en simulación.",
        "<strong class='text-white'>Mantenga flexibles sus datos</strong>, use Tradovate tanto para el feed como para las ejecuciones, o enrute órdenes por Tradovate mientras un feed más completo alimenta el mapa.",
      ],
    },
    { type: "heading",text: "Automatice Tradovate con PickMyTrade" },
    { type: "paragraph",html: "Bookmap está pensado para leer la cinta y hacer clic en sus propias operaciones. Si prefiere que una estrategia apriete el gatillo, PickMyTrade convierte sus <strong class='text-white'>alertas de TradingView en órdenes reales de Tradovate de forma automática</strong>: las entradas, los stops y los objetivos se ejecutan en el momento en que aparece su señal. Observe el flujo en Bookmap y deje que sus alertas se encarguen de la ejecución." },
  ], fr: [
    { type: "paragraph",html: "La heatmap d’order flow de Bookmap est l’un des moyens les plus lisibles de suivre les contrats à terme du CME, et vous pouvez la piloter directement depuis votre compte Tradovate. Avec l’adaptateur Tradovate, vous obtenez le flux de données et le routage d’ordres en direct dans une seule fenêtre : lisez le tape, puis cliquez pour trader. Voici la configuration exacte, du début à la fin." },
    { type: "heading",text: "Ce que fait l’adaptateur Tradovate" },
    { type: "paragraph",html: "Bookmap se connecte aux courtiers et aux flux de données via de petits plugins appelés adaptateurs. Le <strong class='text-white'>tradovate-adapter</strong> permet à Bookmap de récupérer les données des contrats à terme du CME depuis Tradovate et d’envoyer des ordres à votre compte. Vous pouvez l’utiliser de deux façons : Tradovate pour <strong class='text-white'>les données et le trading</strong>, ou <strong class='text-white'>uniquement pour le routage d’ordres</strong> pendant qu’un flux tiers (comme dxFeed) fournit les données. À savoir d’emblée : Tradovate fournit à Bookmap des données CME en <strong class='text-white'>profondeur partielle</strong>, et non le carnet d’ordres complet ; pour obtenir tous les niveaux de profondeur, vous associerez donc l’exécution Tradovate à un flux plus complet." },
    { type: "heading",text: "Ce dont vous avez besoin au préalable" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Une offre Bookmap compatible avec l’adaptateur Tradovate</strong>, la connectivité en temps réel n’est pas incluse dans tous les niveaux ; vérifiez donc que votre abonnement Bookmap actuel couvre les données en direct et le trading.",
        "<strong class='text-white'>Un compte Tradovate</strong>, un compte réel, démo ou d’évaluation de prop firm convient.",
        "<strong class='text-white'>Un abonnement actif aux données de marché CME en temps réel</strong> pour les cotations en direct, sans lui vous verrez des données différées. Les coûts et la disponibilité varient selon le compte et la prop firm ; vérifiez donc les règles actuelles de votre société.",
      ],
    },
    { type: "heading",text: "Connecter Tradovate à Bookmap : pas à pas" },
    {
      type: "steps",
      items: [
        { title: "Installer le tradovate-adapter", html: "Ouvrez Bookmap, allez dans le menu <strong class='text-white'>Settings</strong> et ouvrez le gestionnaire de plugins/connexions (l’option qui liste les adaptateurs installables). Trouvez <strong class='text-white'>tradovate-adapter</strong> dans la liste ; s’il est disponible à l’installation, cliquez sur <strong class='text-white'>Install</strong>, puis <strong class='text-white'>redémarrez Bookmap</strong> pour que l’adaptateur se charge. Si Tradovate apparaît déjà dans votre liste de connexions, il est installé et vous pouvez passer à l’étape suivante." },
        { title: "Ajouter Tradovate dans la Connectivity Configuration", html: "Ouvrez le menu <strong class='text-white'>Connections</strong> et choisissez <strong class='text-white'>Configure</strong> pour afficher la fenêtre <strong class='text-white'>Connectivity Configuration</strong>. Sélectionnez <strong class='text-white'>Tradovate</strong> dans la liste des plateformes. Si vous liez un compte simulé, cochez la case <strong class='text-white'>demo account</strong> afin que Bookmap pointe vers le bon environnement. Cliquez ensuite sur <strong class='text-white'>Add Connection</strong> pour l’enregistrer." },
        { title: "Se connecter via la fenêtre de connexion Tradovate", html: "De retour dans le panneau <strong class='text-white'>Connections</strong>, activez (cochez) la connexion Tradovate. Une <strong class='text-white'>fenêtre de connexion Tradovate s’ouvre dans votre navigateur</strong> : saisissez votre <strong class='text-white'>nom d’utilisateur et mot de passe</strong> Tradovate ou de prop firm, ou utilisez la connexion via un réseau social si votre compte est configuré ainsi. Bookmap utilise ces identifiants uniquement pour vous authentifier auprès de Tradovate. Une fois connecté, le statut passe à connecté." },
        { title: "S’abonner à un instrument à terme", html: "Une fois Tradovate connecté, ajoutez un nouvel instrument et abonnez-vous à un <strong class='text-white'>contrat à terme CME du mois en cours</strong>, ES, NQ, CL ou celui que vous tradez. Utilisez le contrat actif actuel, pas un symbole continu. La heatmap se remplit dès que les données en temps réel arrivent ; un graphique vide ou différé signifie généralement que l’abonnement aux données de marché n’est pas encore actif." },
        { title: "Activer le trading et router les ordres", html: "Pour trader, activez le <strong class='text-white'>mode trading</strong> et vérifiez que <strong class='text-white'>Tradovate</strong> est la connexion de trading sélectionnée pour cet instrument. Ouvrez le <strong class='text-white'>Trade Control Panel</strong> et c’est prêt : placez, déplacez et annulez des ordres Tradovate directement sur le graphique Bookmap, les exécutions étant reflétées dans votre compte. Faites d’abord un petit ordre de test sur un compte démo pour confirmer que tout est routé correctement." },
      ],
    },
    { type: "heading",text: "Pourquoi les traders associent Bookmap à Tradovate" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Lire l’order flow et exécuter au même endroit</strong>, la heatmap et le routage de vos ordres partagent une seule fenêtre.",
        "<strong class='text-white'>Trader les contrats pris en charge par Tradovate</strong>, ES, NQ, CL, GC et les micros, en réel ou en simulation.",
        "<strong class='text-white'>Garder des données flexibles</strong>, utilisez Tradovate pour le flux et les exécutions, ou routez les ordres via Tradovate pendant qu’un flux plus complet alimente la carte.",
      ],
    },
    { type: "heading",text: "Automatiser Tradovate avec PickMyTrade" },
    { type: "paragraph",html: "Bookmap est conçu pour lire le tape et cliquer sur vos propres trades. Si vous préférez qu’une stratégie appuie sur la détente, PickMyTrade transforme vos <strong class='text-white'>alertes TradingView en véritables ordres Tradovate automatiquement</strong> : entrées, stops et objectifs s’exécutent dès que votre signal apparaît. Surveillez le flux dans Bookmap et laissez vos alertes gérer l’exécution." },
  ], it: [
    { type: "paragraph",html: "La heatmap dell’order flow di Bookmap è uno dei modi più chiari per leggere i futures CME, e Lei può pilotarla direttamente dal Suo conto Tradovate. Con l’adapter Tradovate ottiene il feed dati e l’instradamento degli ordini in tempo reale in un’unica finestra: legga il tape, poi clicchi per operare. Ecco la configurazione esatta, dall’inizio alla fine." },
    { type: "heading",text: "Cosa fa l’adapter Tradovate" },
    { type: "paragraph",html: "Bookmap si collega a broker e feed tramite piccoli plugin chiamati adapter. Il <strong class='text-white'>tradovate-adapter</strong> consente a Bookmap di ricevere i dati dei futures CME da Tradovate e di inviare ordini al Suo conto. Può usarlo in due modi: Tradovate per <strong class='text-white'>dati e trading</strong>, oppure <strong class='text-white'>solo per l’instradamento degli ordini</strong> mentre un feed di terze parti (come dxFeed) fornisce i dati. Da sapere subito: Tradovate fornisce a Bookmap dati CME a <strong class='text-white'>profondità parziale</strong>, non il book completo, quindi per ogni livello di profondità abbinerà l’esecuzione Tradovate a un feed più completo." },
    { type: "heading",text: "Di cosa ha bisogno prima" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Un piano Bookmap che supporti l’adapter Tradovate</strong>, la connettività in tempo reale non è inclusa in ogni livello, quindi verifichi che il Suo abbonamento Bookmap attuale copra dati live e trading.",
        "<strong class='text-white'>Un conto Tradovate</strong>, va bene un conto reale, demo o di valutazione di una prop firm.",
        "<strong class='text-white'>Un abbonamento attivo ai dati di mercato CME in tempo reale</strong> per le quotazioni live, senza di esso vedrà dati ritardati. Costi e disponibilità variano in base al conto e alla prop firm, quindi verifichi le regole attuali della Sua società.",
      ],
    },
    { type: "heading",text: "Collegare Tradovate a Bookmap: passo dopo passo" },
    {
      type: "steps",
      items: [
        { title: "Installi il tradovate-adapter", html: "Apra Bookmap, vada al menu <strong class='text-white'>Settings</strong> e apra il gestore di plugin/connessioni (l’opzione che elenca gli adapter installabili). Trovi <strong class='text-white'>tradovate-adapter</strong> nell’elenco; se risulta disponibile per l’installazione, clicchi su <strong class='text-white'>Install</strong>, quindi <strong class='text-white'>riavvii Bookmap</strong> affinché l’adapter venga caricato. Se Tradovate compare già nell’elenco delle connessioni, è installato e può passare al punto successivo." },
        { title: "Aggiunga Tradovate nella Connectivity Configuration", html: "Apra il menu <strong class='text-white'>Connections</strong> e scelga <strong class='text-white'>Configure</strong> per aprire la finestra <strong class='text-white'>Connectivity Configuration</strong>. Selezioni <strong class='text-white'>Tradovate</strong> dall’elenco delle piattaforme. Se sta collegando un conto simulato, spunti la casella <strong class='text-white'>demo account</strong> in modo che Bookmap punti all’ambiente corretto. Poi clicchi su <strong class='text-white'>Add Connection</strong> per salvarla." },
        { title: "Acceda tramite il popup di login di Tradovate", html: "Tornato nel pannello <strong class='text-white'>Connections</strong>, attivi (spunti) la connessione Tradovate. Si apre una <strong class='text-white'>finestra di login di Tradovate nel Suo browser</strong>: inserisca il Suo <strong class='text-white'>nome utente e password</strong> di Tradovate o della prop firm, oppure usi il login social se il Suo conto è configurato così. Bookmap usa queste credenziali solo per autenticarLa presso Tradovate. Una volta stabilita la connessione, lo stato passa a connesso." },
        { title: "Si abboni a uno strumento future", html: "Con Tradovate connesso, aggiunga un nuovo strumento e si abboni a un <strong class='text-white'>contratto future CME del mese front</strong>, ES, NQ, CL o quello che opera. Usi il contratto attivo corrente, non un simbolo continuo. La heatmap si popola non appena arrivano i dati in tempo reale; un grafico vuoto o ritardato di solito significa che l’abbonamento ai dati di mercato non è ancora attivo." },
        { title: "Abiliti il trading e instradi gli ordini", html: "Per operare, attivi la <strong class='text-white'>modalità trading</strong> e verifichi che <strong class='text-white'>Tradovate</strong> sia la connessione di trading selezionata per quello strumento. Apra il <strong class='text-white'>Trade Control Panel</strong> e sarà pronto: piazzi, trascini e annulli gli ordini Tradovate direttamente sul grafico di Bookmap, con le esecuzioni riflesse nel Suo conto. Faccia prima un piccolo ordine di prova su un conto demo per confermare che tutto venga instradato correttamente." },
      ],
    },
    { type: "heading",text: "Perché i trader abbinano Bookmap a Tradovate" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Leggere l’order flow ed eseguire in un unico posto</strong>, heatmap e instradamento degli ordini condividono una sola finestra.",
        "<strong class='text-white'>Operare i contratti supportati da Tradovate</strong>, ES, NQ, CL, GC e i micro, in reale o in simulazione.",
        "<strong class='text-white'>Mantenere flessibili i dati</strong>, usi Tradovate per feed ed esecuzioni, oppure instradi gli ordini tramite Tradovate mentre un feed più completo alimenta la mappa.",
      ],
    },
    { type: "heading",text: "Automatizzare Tradovate con PickMyTrade" },
    { type: "paragraph",html: "Bookmap è pensato per leggere il tape e cliccare sui propri trade. Se preferisce che sia una strategia a premere il grilletto, PickMyTrade trasforma i Suoi <strong class='text-white'>alert di TradingView in veri ordini Tradovate in modo automatico</strong>: ingressi, stop e target vengono eseguiti nel momento in cui compare il Suo segnale. Osservi il flusso in Bookmap e lasci che siano i Suoi alert a occuparsi dell’esecuzione." },
  ] },
  ctaHeading: { en: "Let Your Strategy Place the Trades", de: "Lassen Sie Ihre Strategie die Trades platzieren", es: "Deje que su estrategia coloque las operaciones", fr: "Laissez votre stratégie passer les trades", it: "Lasci che la Sua strategia piazzi i trade" },
  ctaText: { en: "Watch the order flow in Bookmap, let PickMyTrade turn your TradingView alerts into real Tradovate orders automatically, entries, stops, and targets execute the moment your signal prints.", de: "Beobachten Sie den Order Flow in Bookmap und lassen Sie PickMyTrade Ihre TradingView-Alarme automatisch in echte Tradovate-Orders umwandeln – Einstiege, Stopps und Ziele werden ausgeführt, sobald Ihr Signal erscheint.", es: "Observe el order flow en Bookmap y deje que PickMyTrade convierta automáticamente sus alertas de TradingView en órdenes reales de Tradovate: las entradas, los stops y los objetivos se ejecutan en el momento en que aparece su señal.", fr: "Observez l’order flow dans Bookmap et laissez PickMyTrade transformer automatiquement vos alertes TradingView en véritables ordres Tradovate : entrées, stops et objectifs s’exécutent dès que votre signal apparaît.", it: "Osservi l’order flow in Bookmap e lasci che PickMyTrade trasformi automaticamente i Suoi alert di TradingView in veri ordini Tradovate: ingressi, stop e target vengono eseguiti nel momento in cui compare il Suo segnale." },
  ctaButtonText: { en: "Start Your Free 7-Day Trial", de: "Starten Sie Ihre kostenlose 7-Tage-Testphase", es: "Comience su prueba gratuita de 7 días", fr: "Commencez votre essai gratuit de 7 jours", it: "Inizi la prova gratuita di 7 giorni" },
  ctaUrl: "https://app.pickmytrade.trade/?register=true&utm_source=content&utm_medium=how-to",
  faqHeading: { en: "Frequently Asked Questions", de: "Häufig gestellte Fragen", es: "Preguntas frecuentes", fr: "Questions fréquentes", it: "Domande frequenti" },
  faqs: { en: [
    { q: "Why isn't Tradovate showing up in my Bookmap connections?", a: "The adapter probably isn't installed yet. Open the Settings plugins/connections manager, install tradovate-adapter, and restart Bookmap. Tradovate then appears in the Connectivity Configuration list." },
    { q: "Do I need a market-data subscription for Bookmap and Tradovate?", a: "For live quotes, yes, you need an active real-time CME data subscription on your Tradovate account. Without it you'll get delayed data or a blank map. On prop-firm and evaluation accounts the firm often controls data, so check your firm's current rules." },
    { q: "My connection keeps dropping when I open Tradovate elsewhere. Why?", a: "Tradovate caps how many active sessions you can run at once. Bookmap plus the Tradovate web or desktop app (or TradingView) at the same time can trip that limit and force disconnects." },
    { q: "Can I use a demo or prop account with the Bookmap adapter?", a: "Yes. Tick the demo checkbox when you add the connection to link a simulated account. Prop-firm accounts generally work too, but whether a firm allows third-party platforms like Bookmap depends on its rules, confirm before you rely on it." },
  ], de: [
    { q: "Warum erscheint Tradovate nicht in meinen Bookmap-Verbindungen?", a: "Der Adapter ist wahrscheinlich noch nicht installiert. Öffnen Sie im Menü Settings den Plugin-/Verbindungsmanager, installieren Sie tradovate-adapter und starten Sie Bookmap neu. Tradovate erscheint dann in der Liste der Connectivity Configuration." },
    { q: "Benötige ich ein Marktdaten-Abonnement für Bookmap und Tradovate?", a: "Für Live-Kurse ja, Sie benötigen ein aktives Echtzeit-CME-Datenabonnement für Ihr Tradovate-Konto. Ohne dieses erhalten Sie verzögerte Daten oder eine leere Karte. Bei Prop-Firm- und Evaluierungskonten steuert oft die Firma die Daten, prüfen Sie daher die aktuellen Regeln Ihrer Firma." },
    { q: "Meine Verbindung bricht ab, wenn ich Tradovate an anderer Stelle öffne. Warum?", a: "Tradovate begrenzt, wie viele aktive Sitzungen Sie gleichzeitig betreiben können. Bookmap zusammen mit der Tradovate-Web- oder Desktop-App (oder TradingView) kann dieses Limit auslösen und Verbindungsabbrüche erzwingen." },
    { q: "Kann ich ein Demo- oder Prop-Konto mit dem Bookmap-Adapter verwenden?", a: "Ja. Aktivieren Sie beim Hinzufügen der Verbindung das Demo-Kontrollkästchen, um ein simuliertes Konto zu verknüpfen. Prop-Firm-Konten funktionieren in der Regel ebenfalls, ob eine Firma Drittplattformen wie Bookmap erlaubt, hängt jedoch von deren Regeln ab. Klären Sie dies ab, bevor Sie sich darauf verlassen." },
  ], es: [
    { q: "¿Por qué Tradovate no aparece en mis conexiones de Bookmap?", a: "Probablemente el adaptador aún no está instalado. Abra el administrador de plugins/conexiones en Settings, instale tradovate-adapter y reinicie Bookmap. Tradovate aparecerá entonces en la lista de Connectivity Configuration." },
    { q: "¿Necesito una suscripción de datos de mercado para Bookmap y Tradovate?", a: "Para cotizaciones en vivo, sí: necesita una suscripción activa de datos CME en tiempo real en su cuenta de Tradovate. Sin ella obtendrá datos con retraso o un mapa en blanco. En cuentas de prop firms y de evaluación, la firma suele controlar los datos, así que consulte las reglas vigentes de su firma." },
    { q: "Mi conexión se cae cuando abro Tradovate en otro lugar. ¿Por qué?", a: "Tradovate limita cuántas sesiones activas puede tener a la vez. Bookmap junto con la aplicación web o de escritorio de Tradovate (o TradingView) al mismo tiempo puede alcanzar ese límite y forzar desconexiones." },
    { q: "¿Puedo usar una cuenta demo o de prop firm con el adaptador de Bookmap?", a: "Sí. Marque la casilla demo al añadir la conexión para vincular una cuenta simulada. Las cuentas de prop firms suelen funcionar también, pero que una firma permita plataformas de terceros como Bookmap depende de sus reglas; confírmelo antes de depender de ello." },
  ], fr: [
    { q: "Pourquoi Tradovate n’apparaît-il pas dans mes connexions Bookmap ?", a: "L’adaptateur n’est probablement pas encore installé. Ouvrez le gestionnaire de plugins/connexions dans Settings, installez tradovate-adapter et redémarrez Bookmap. Tradovate apparaît alors dans la liste Connectivity Configuration." },
    { q: "Ai-je besoin d’un abonnement de données de marché pour Bookmap et Tradovate ?", a: "Pour les cotations en direct, oui : vous avez besoin d’un abonnement actif aux données CME en temps réel sur votre compte Tradovate. Sans lui, vous obtiendrez des données différées ou une carte vide. Sur les comptes de prop firm et d’évaluation, la société contrôle souvent les données ; vérifiez donc les règles actuelles de votre société." },
    { q: "Ma connexion se coupe quand j’ouvre Tradovate ailleurs. Pourquoi ?", a: "Tradovate limite le nombre de sessions actives simultanées. Bookmap en même temps que l’application web ou de bureau Tradovate (ou TradingView) peut atteindre cette limite et provoquer des déconnexions." },
    { q: "Puis-je utiliser un compte démo ou de prop firm avec l’adaptateur Bookmap ?", a: "Oui. Cochez la case démo lorsque vous ajoutez la connexion pour lier un compte simulé. Les comptes de prop firm fonctionnent généralement aussi, mais l’autorisation de plateformes tierces comme Bookmap dépend des règles de la société ; vérifiez-le avant de vous y fier." },
  ], it: [
    { q: "Perché Tradovate non compare tra le mie connessioni Bookmap?", a: "Probabilmente l’adapter non è ancora installato. Apra il gestore di plugin/connessioni in Settings, installi tradovate-adapter e riavvii Bookmap. Tradovate comparirà quindi nell’elenco della Connectivity Configuration." },
    { q: "Ho bisogno di un abbonamento ai dati di mercato per Bookmap e Tradovate?", a: "Per le quotazioni in tempo reale sì: serve un abbonamento attivo ai dati CME in tempo reale sul Suo conto Tradovate. Senza di esso otterrà dati ritardati o una mappa vuota. Sui conti prop firm e di valutazione i dati sono spesso gestiti dalla società, quindi verifichi le regole attuali della Sua società." },
    { q: "La mia connessione cade quando apro Tradovate altrove. Perché?", a: "Tradovate limita il numero di sessioni attive che può avere contemporaneamente. Bookmap insieme all’app web o desktop di Tradovate (o a TradingView) può far scattare questo limite e provocare disconnessioni." },
    { q: "Posso usare un conto demo o prop con l’adapter di Bookmap?", a: "Sì. Selezioni la casella demo quando aggiunge la connessione per collegare un conto simulato. In genere funzionano anche i conti prop firm, ma il fatto che una società consenta piattaforme di terze parti come Bookmap dipende dalle sue regole: lo verifichi prima di farvi affidamento." },
  ] },
  relatedHeading: { en: "Related Guides", de: "Ähnliche Anleitungen", es: "Guías relacionadas", fr: "Guides associés", it: "Guide correlate" },
  disclosureText: { en: `This guide is for educational and informational purposes only and is not financial, investment, or trading advice. Trading futures and other leveraged products carries a substantial risk of loss and is not suitable for every investor. PickMyTrade is an independent third-party automation platform and is not affiliated with, endorsed by, or sponsored by Tradovate, Inc. "Tradovate" and all related names, logos, and trademarks are the property of their respective owners. Platform features and steps change over time, so always confirm the current process in the official Tradovate platform and documentation before acting.`, de: "Dieser Leitfaden dient ausschließlich Bildungs- und Informationszwecken und stellt keine Finanz-, Anlage- oder Handelsberatung dar. Der Handel mit Futures und anderen gehebelten Produkten birgt ein erhebliches Verlustrisiko und ist nicht für jeden Anleger geeignet. PickMyTrade ist eine unabhängige Automatisierungsplattform eines Drittanbieters und steht in keiner Verbindung zu Tradovate, Inc., wird nicht von Tradovate, Inc. unterstützt oder gesponsert. „Tradovate“ und alle zugehörigen Namen, Logos und Marken sind Eigentum ihrer jeweiligen Inhaber. Funktionen und Schritte der Plattform ändern sich im Laufe der Zeit. Prüfen Sie daher stets den aktuellen Ablauf in der offiziellen Tradovate-Plattform und -Dokumentation, bevor Sie handeln.", es: "Esta guía tiene fines exclusivamente educativos e informativos y no constituye asesoramiento financiero, de inversión ni de trading. Operar con futuros y otros productos apalancados conlleva un riesgo sustancial de pérdida y no es adecuado para todos los inversores. PickMyTrade es una plataforma de automatización independiente de terceros y no está afiliada, respaldada ni patrocinada por Tradovate, Inc. «Tradovate» y todos los nombres, logotipos y marcas relacionados son propiedad de sus respectivos titulares. Las funciones y los pasos de la plataforma cambian con el tiempo, por lo que debe confirmar siempre el proceso actual en la plataforma y la documentación oficiales de Tradovate antes de actuar.", fr: "Ce guide est fourni à des fins strictement éducatives et informatives et ne constitue pas un conseil financier, d’investissement ou de trading. Le trading de contrats à terme et d’autres produits à effet de levier comporte un risque de perte important et ne convient pas à tous les investisseurs. PickMyTrade est une plateforme d’automatisation tierce indépendante, qui n’est ni affiliée à Tradovate, Inc., ni approuvée ou parrainée par celle-ci. « Tradovate » ainsi que tous les noms, logos et marques associés sont la propriété de leurs détenteurs respectifs. Les fonctionnalités et les étapes de la plateforme évoluent avec le temps ; vérifiez donc toujours la procédure actuelle sur la plateforme et dans la documentation officielles de Tradovate avant d’agir.", it: "Questa guida ha esclusivamente scopo educativo e informativo e non costituisce consulenza finanziaria, di investimento o di trading. Il trading di futures e di altri prodotti a leva comporta un rischio di perdita sostanziale e non è adatto a tutti gli investitori. PickMyTrade è una piattaforma di automazione indipendente di terze parti e non è affiliata, approvata né sponsorizzata da Tradovate, Inc. «Tradovate» e tutti i nomi, loghi e marchi correlati sono di proprietà dei rispettivi titolari. Le funzionalità e i passaggi della piattaforma cambiano nel tempo, quindi verifichi sempre la procedura attuale nella piattaforma e nella documentazione ufficiali di Tradovate prima di agire." },
};
const data: GuideArticleData = resolveGuideContent(content, locale, related);

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: data.faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: `${SITE_URL}${withSlash(localizedPath(locale))}` },
    { "@type": "ListItem", position: 2, name: "How-To", item: `${SITE_URL}${withSlash(localizedPath(locale, "how-to"))}` },
    { "@type": "ListItem", position: 3, name: content.h1[locale], item: `${SITE_URL}${withSlash(localizedPath(locale, `how-to/${SLUG}`))}` },
  ],
};

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: content.h1[locale],
  description: content.dek[locale],
  image: `${SITE_URL}/assets/og-default.webp`,
  publisher: { "@type": "Organization", name: "PickMyTrade", logo: { "@type": "ImageObject", url: `${SITE_URL}/assets/logo.png` } },
  datePublished: "2026-07-10",
  dateModified: "2026-07-10",
  mainEntityOfPage: { "@type": "WebPage", "@id": `${SITE_URL}${withSlash(localizedPath(locale, `how-to/${SLUG}`))}` },
};
---

<BaseLayout
  locale={locale}
  title={`${content.h1[locale]} | PickMyTrade`}
  description={content.dek[locale]}
  ogType="article"
  ogImage="/assets/og-default.webp"
  ldJson={[breadcrumbSchema, faqSchema, articleSchema]}
>
  <GuideArticle locale={locale} data={data} sectionPath="how-to" />
</BaseLayout>
