---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "tradovate-price-levels";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/how-to/${SLUG}`;

const META_TITLE = "Add Price Levels to Tradovate Charts";
const META_DESCRIPTION =
  "Show Open, High, Low and Middle price lines on your futures charts, mark your own custom levels, and turn any level into an alert you can't miss.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Preisniveaus in Tradovate-Charts hinzufügen", es: "Cómo añadir niveles de precio a los gráficos de Tradovate", fr: "Ajouter des niveaux de prix aux graphiques Tradovate", it: "Aggiungere livelli di prezzo ai grafici di Tradovate" },
  dek: { en: "Price levels are the horizontal reference lines that keep you honest about where the market actually is. Here's how to switch them on, style them, and wire any level up to an alert.", de: "Preisniveaus sind die horizontalen Referenzlinien, die Ihnen zeigen, wo der Markt tatsächlich steht. So schalten Sie sie ein, gestalten sie und verknüpfen jedes Niveau mit einem Alarm.", es: "Los niveles de precio son las líneas horizontales de referencia que le mantienen honesto sobre dónde está realmente el mercado. Aquí se explica cómo activarlos, darles estilo y conectar cualquier nivel a una alerta.", fr: "Les niveaux de prix sont les lignes de référence horizontales qui vous gardent honnête sur l’endroit où se trouve réellement le marché. Voici comment les activer, les styliser et relier n’importe quel niveau à une alerte.", it: "I livelli di prezzo sono le linee orizzontali di riferimento che la tengono onesta su dove si trova davvero il mercato. Ecco come attivarli, personalizzarli e collegare qualsiasi livello a un avviso." },
  readTime: { en: "6 min read", de: "6 Min. Lesezeit", es: "Lectura de 6 min", fr: "Lecture : 6 min", it: "Lettura di 6 min" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "Price levels are the horizontal reference lines that keep you honest about where the market actually is. Tradovate builds a set of them straight from the session data (the open, the high, the low, and a midpoint you can tune), and you can stack your own lines on top for the prices your strategy actually cares about. Here's how to switch them on, style them so they read at a glance, and wire any level up to an alert so you're not glued to the screen waiting for a touch." },
    { type: "paragraph", html: "Two things get called \"price levels\" in Tradovate, and it's worth keeping them straight. The <strong class='text-white'>Price Levels</strong> menu draws data-driven lines automatically (open, high, low, middle). A <strong class='text-white'>Horizontal Line</strong> from the drawing tools is one you place by hand. Both show up as clean horizontal lines, and both can trigger an alert." },
    { type: "heading", text: "Add Price Levels to Tradovate Charts: Step-by-Step" },
    {
      type: "steps",
      items: [
        { title: "Open the Price Levels Menu", html: "Hover your mouse over the chart so the toolbars appear, then click the Chart Settings icon at the top of the Chart module. In the dropdown that opens, choose <strong class='text-white'>Price Levels</strong>. That's the panel that controls every built-in line.", image: { src: `${IMG}/tradovate-price-levels-1.png`, alt: "Tradovate Chart Settings dropdown open with the Price Levels option highlighted" } },
        { title: "Switch On the Levels You Want", html: "Inside the Price Levels panel, flip on the lines you use. <strong class='text-white'>Open</strong>, <strong class='text-white'>High</strong>, <strong class='text-white'>Low</strong> and <strong class='text-white'>Middle</strong> each toggle on their own, so you can run just the session open and skip the rest if that's your style. When you want to reset fast, <strong class='text-white'>Show All</strong> drops every line onto the chart and <strong class='text-white'>Hide All</strong> clears them in one click.", image: { src: `${IMG}/tradovate-price-levels-2.png`, alt: "Price Levels panel showing Open, High, Low and Middle toggles with Show All and Hide All buttons" } },
        { title: "Set the Colors and the Midpoint", html: "Default line colors blend into a busy chart, so click <strong class='text-white'>Settings</strong> inside the Price Levels dropdown to recolor the Open, High, Low and Middle lines. Pick shades you can read in a half-second, since the whole point is a glance. While you're in there, the <strong class='text-white'>Percents (From High to Low)</strong> field decides where the Middle line plots. Set it to 50% and the line sits exactly halfway between the session high and low; change the number to weight it wherever you want. There's also a <strong class='text-white'>Show P&amp;L On Priceline</strong> toggle that rides your open-position P&amp;L along the current price line as it moves.", image: { src: `${IMG}/tradovate-price-levels-3.png`, alt: "Price Levels settings with color pickers for each line and the Percents From High to Low field" } },
        { title: "Draw Your Own Custom Level", html: "The auto lines won't cover a prior swing, a round number, or a supply zone you've mapped by hand. For those, hover the chart to bring up the toolbar, open the <strong class='text-white'>Drawing Tools</strong>, and pick the <strong class='text-white'>Horizontal Line</strong>. Click once at the price you want and the line snaps across the whole chart. Double-click it later to change its color or thickness, and hold <strong class='text-white'>Shift</strong> while placing it if you want the exact price to show as you drag.", image: { src: `${IMG}/tradovate-price-levels-4.png`, alt: "Horizontal Line drawing tool placing a custom price level line across a Tradovate chart" } },
        { title: "Turn a Level Into a Price Alert", html: "A line on the chart is only half the job. To get pinged when price reaches it, single left-click the <strong class='text-white'>price axis</strong> at that level (on newer charts, click toward the far-left edge of the axis) and the alert dialog opens with the market and price pre-filled. You can also right-click the chart and choose <strong class='text-white'>Add Alert</strong>. Pick the condition, choose whether you want a sound, a popup, or both, and save it. A small <strong class='text-white'>bell icon</strong> parks on the chart at that price; left-click the bell to clear the alert once you're done with it. The same click works on the DOM ladder.", image: { src: `${IMG}/tradovate-price-levels-5.png`, alt: "Alert dialog opened from clicking the price axis, with a bell icon marking the level on the chart" } },
      ],
    },
    { type: "heading", text: "A Few Things Worth Knowing" },
    { type: "paragraph", html: "Chart drawings in Tradovate don't always survive a restart or follow you across devices, so if a hand-drawn level vanishes, scroll back to the date you first placed it and it usually reloads. The built-in Price Levels lines don't have that problem because they're recalculated from session data every time. And if you're trading a prop or evaluation account, remember your alerts and lines are just visual aids; they don't change your firm's risk rules, which vary by firm and account size, so check your firm's current limits before you lean on any level." },
    { type: "heading", text: "Automate This with PickMyTrade" },
    { type: "paragraph", html: "Want a level to <em>do</em> something instead of just ping you? You can wire your TradingView setups to fire real orders into Tradovate automatically." },
  ], de: [
    { type: "paragraph",html: "Preisniveaus sind die horizontalen Referenzlinien, die Ihnen zeigen, wo der Markt tatsächlich steht. Tradovate erzeugt direkt aus den Sessiondaten einen Satz davon (Eröffnung, Hoch, Tief und einen anpassbaren Mittelpunkt), und Sie können eigene Linien für die Preise darüberlegen, die für Ihre Strategie wirklich zählen. So schalten Sie sie ein, gestalten sie so, dass sie auf einen Blick lesbar sind, und verknüpfen jedes Niveau mit einem Alarm, damit Sie nicht am Bildschirm auf eine Berührung warten müssen." },
    { type: "paragraph",html: "In Tradovate werden zwei Dinge „Preisniveaus“ genannt, und es lohnt sich, sie auseinanderzuhalten. Das Menü <strong class='text-white'>Price Levels</strong> zeichnet datengesteuerte Linien automatisch (Open, High, Low, Middle). Eine <strong class='text-white'>Horizontal Line</strong> aus den Zeichenwerkzeugen platzieren Sie dagegen von Hand. Beide erscheinen als saubere horizontale Linien, und beide können einen Alarm auslösen." },
    { type: "heading",text: "Preisniveaus in Tradovate-Charts hinzufügen: Schritt für Schritt" },
    {
      type: "steps",
      items: [
        { title: "Das Menü Price Levels öffnen", html: "Fahren Sie mit der Maus über den Chart, damit die Symbolleisten erscheinen, und klicken Sie oben im Chart-Modul auf das Symbol Chart Settings. Wählen Sie im sich öffnenden Dropdown <strong class='text-white'>Price Levels</strong>. Dieses Panel steuert alle integrierten Linien.", image: {"src":`${IMG}/tradovate-price-levels-1.png`,"alt":"Geöffnetes Tradovate-Dropdown Chart Settings mit hervorgehobener Option Price Levels"} },
        { title: "Die gewünschten Niveaus einschalten", html: "Schalten Sie im Panel „Price Levels“ die Linien ein, die Sie nutzen. <strong class='text-white'>Open</strong>, <strong class='text-white'>High</strong>, <strong class='text-white'>Low</strong> und <strong class='text-white'>Middle</strong> lassen sich jeweils einzeln umschalten, sodass Sie auch nur die Session-Eröffnung verwenden und den Rest weglassen können, wenn das Ihrem Stil entspricht. Zum schnellen Zurücksetzen legt <strong class='text-white'>Show All</strong> alle Linien auf den Chart, und <strong class='text-white'>Hide All</strong> entfernt sie mit einem Klick.", image: {"src":`${IMG}/tradovate-price-levels-2.png`,"alt":"Panel Price Levels mit den Schaltern Open, High, Low und Middle sowie den Schaltflächen Show All und Hide All"} },
        { title: "Farben und Mittelpunkt festlegen", html: "Die Standardfarben gehen in einem vollen Chart unter. Klicken Sie daher im Dropdown „Price Levels“ auf <strong class='text-white'>Settings</strong>, um die Linien Open, High, Low und Middle umzufärben. Wählen Sie Farben, die Sie in einer halben Sekunde erkennen, denn der Sinn ist der schnelle Blick. Dort bestimmt auch das Feld <strong class='text-white'>Percents (From High to Low)</strong>, wo die Middle-Linie gezeichnet wird. Bei 50 % liegt die Linie genau in der Mitte zwischen Session-Hoch und -Tief; mit einer anderen Zahl gewichten Sie sie beliebig. Außerdem gibt es den Schalter <strong class='text-white'>Show P&amp;L On Priceline</strong>, der den P&amp;L Ihrer offenen Position entlang der aktuellen Preislinie mitlaufen lässt.", image: {"src":`${IMG}/tradovate-price-levels-3.png`,"alt":"Einstellungen von Price Levels mit Farbauswahl für jede Linie und dem Feld Percents From High to Low"} },
        { title: "Ein eigenes Niveau zeichnen", html: "Die automatischen Linien decken weder ein früheres Swing-Niveau noch eine runde Zahl oder eine von Hand eingezeichnete Angebotszone ab. Fahren Sie dafür mit der Maus über den Chart, um die Symbolleiste einzublenden, öffnen Sie die <strong class='text-white'>Drawing Tools</strong> und wählen Sie die <strong class='text-white'>Horizontal Line</strong>. Klicken Sie einmal auf den gewünschten Preis, und die Linie spannt sich über den gesamten Chart. Per Doppelklick ändern Sie später Farbe oder Linienstärke, und halten Sie beim Platzieren die Taste <strong class='text-white'>Shift</strong> gedrückt, wenn der exakte Preis beim Ziehen angezeigt werden soll.", image: {"src":`${IMG}/tradovate-price-levels-4.png`,"alt":"Zeichenwerkzeug Horizontal Line, das ein eigenes Preisniveau als Linie über einen Tradovate-Chart legt"} },
        { title: "Ein Niveau in einen Preisalarm verwandeln", html: "Eine Linie im Chart ist nur die halbe Arbeit. Um benachrichtigt zu werden, wenn der Kurs sie erreicht, klicken Sie einmal mit der linken Maustaste auf die <strong class='text-white'>Preisachse</strong> auf dieser Höhe (bei neueren Charts klicken Sie in Richtung des linken Rands der Achse), und der Alarmdialog öffnet sich mit vorausgefülltem Markt und Preis. Sie können auch mit der rechten Maustaste in den Chart klicken und <strong class='text-white'>Add Alert</strong> wählen. Wählen Sie die Bedingung, entscheiden Sie, ob Sie einen Ton, ein Popup oder beides möchten, und speichern Sie. Ein kleines <strong class='text-white'>Glockensymbol</strong> erscheint im Chart auf diesem Preis; klicken Sie mit links auf die Glocke, um den Alarm zu löschen, sobald Sie ihn nicht mehr brauchen. Dasselbe Klicken funktioniert auf der DOM-Preisleiter.", image: {"src":`${IMG}/tradovate-price-levels-5.png`,"alt":"Alarmdialog, geöffnet per Klick auf die Preisachse, mit einem Glockensymbol, das das Niveau im Chart markiert"} },
      ],
    },
    { type: "heading",text: "Ein paar Dinge, die Sie wissen sollten" },
    { type: "paragraph",html: "Chart-Zeichnungen in Tradovate überstehen einen Neustart nicht immer und folgen Ihnen nicht immer auf andere Geräte. Verschwindet ein von Hand gezeichnetes Niveau, scrollen Sie daher zu dem Datum zurück, an dem Sie es zuerst gesetzt haben; meist wird es dann neu geladen. Die integrierten Price-Levels-Linien haben dieses Problem nicht, da sie bei jedem Aufruf aus den Sessiondaten neu berechnet werden. Und wenn Sie ein Prop- oder Evaluierungskonto handeln, denken Sie daran, dass Ihre Alarme und Linien nur visuelle Hilfen sind; sie ändern nichts an den Risikoregeln Ihrer Firma, die je nach Firma und Kontogröße variieren. Prüfen Sie daher die aktuellen Limits Ihrer Firma, bevor Sie sich auf ein Niveau verlassen." },
    { type: "heading",text: "Automatisieren Sie dies mit PickMyTrade" },
    { type: "paragraph",html: "Möchten Sie, dass ein Niveau etwas <em>tut</em>, statt Sie nur zu benachrichtigen? Sie können Ihre TradingView-Setups so verbinden, dass sie echte Orders automatisch in Tradovate auslösen." },
  ], es: [
    { type: "paragraph",html: "Los niveles de precio son las líneas horizontales de referencia que le mantienen honesto sobre dónde está realmente el mercado. Tradovate genera un conjunto de ellas directamente a partir de los datos de la sesión (la apertura, el máximo, el mínimo y un punto medio que puede ajustar), y usted puede añadir sus propias líneas encima para los precios que realmente importan a su estrategia. Aquí se explica cómo activarlas, darles un estilo que se lea de un vistazo y conectar cualquier nivel a una alerta para no estar pegado a la pantalla esperando un toque." },
    { type: "paragraph",html: "En Tradovate se llama «niveles de precio» a dos cosas distintas, y conviene no confundirlas. El menú <strong class='text-white'>Price Levels</strong> dibuja líneas basadas en datos de forma automática (Open, High, Low, Middle). Una <strong class='text-white'>Horizontal Line</strong> de las herramientas de dibujo es una que usted coloca a mano. Ambas aparecen como líneas horizontales limpias y ambas pueden activar una alerta." },
    { type: "heading",text: "Cómo añadir niveles de precio a los gráficos de Tradovate: paso a paso" },
    {
      type: "steps",
      items: [
        { title: "Abra el menú Price Levels", html: "Pase el ratón sobre el gráfico para que aparezcan las barras de herramientas y haga clic en el icono Chart Settings situado en la parte superior del módulo del gráfico. En el menú desplegable que se abre, elija <strong class='text-white'>Price Levels</strong>. Ese es el panel que controla todas las líneas integradas.", image: {"src":`${IMG}/tradovate-price-levels-1.png`,"alt":"Menú desplegable Chart Settings de Tradovate abierto con la opción Price Levels resaltada"} },
        { title: "Active los niveles que desee", html: "Dentro del panel Price Levels, active las líneas que utiliza. <strong class='text-white'>Open</strong>, <strong class='text-white'>High</strong>, <strong class='text-white'>Low</strong> y <strong class='text-white'>Middle</strong> se activan cada una por separado, así que puede usar solo la apertura de la sesión y omitir el resto si ese es su estilo. Cuando quiera restablecer rápido, <strong class='text-white'>Show All</strong> coloca todas las líneas en el gráfico y <strong class='text-white'>Hide All</strong> las elimina con un clic.", image: {"src":`${IMG}/tradovate-price-levels-2.png`,"alt":"Panel Price Levels con los interruptores Open, High, Low y Middle y los botones Show All y Hide All"} },
        { title: "Defina los colores y el punto medio", html: "Los colores de línea predeterminados se confunden en un gráfico cargado, así que haga clic en <strong class='text-white'>Settings</strong> dentro del menú Price Levels para cambiar el color de las líneas Open, High, Low y Middle. Elija tonos que pueda leer en medio segundo, ya que la idea es verlas de un vistazo. Mientras está ahí, el campo <strong class='text-white'>Percents (From High to Low)</strong> decide dónde se traza la línea Middle. Si lo fija en 50 %, la línea queda exactamente a mitad de camino entre el máximo y el mínimo de la sesión; cambie el número para ponderarla donde quiera. También hay un interruptor <strong class='text-white'>Show P&amp;L On Priceline</strong> que acompaña con el P&amp;L de su posición abierta a la línea del precio actual mientras se mueve.", image: {"src":`${IMG}/tradovate-price-levels-3.png`,"alt":"Configuración de Price Levels con selectores de color para cada línea y el campo Percents From High to Low"} },
        { title: "Dibuje un nivel personalizado", html: "Las líneas automáticas no cubrirán un swing anterior, un número redondo ni una zona de oferta que haya marcado a mano. Para esos casos, pase el ratón sobre el gráfico para mostrar la barra de herramientas, abra las <strong class='text-white'>Drawing Tools</strong> y elija la <strong class='text-white'>Horizontal Line</strong>. Haga clic una vez en el precio deseado y la línea se extiende por todo el gráfico. Haga doble clic en ella más tarde para cambiar su color o grosor, y mantenga pulsada la tecla <strong class='text-white'>Shift</strong> mientras la coloca si quiere que se muestre el precio exacto al arrastrar.", image: {"src":`${IMG}/tradovate-price-levels-4.png`,"alt":"Herramienta de dibujo Horizontal Line colocando una línea de nivel de precio personalizada en un gráfico de Tradovate"} },
        { title: "Convierta un nivel en una alerta de precio", html: "Una línea en el gráfico es solo la mitad del trabajo. Para recibir un aviso cuando el precio la alcance, haga un solo clic izquierdo en el <strong class='text-white'>eje de precios</strong> a ese nivel (en los gráficos más recientes, haga clic hacia el borde izquierdo del eje) y se abrirá el cuadro de diálogo de la alerta con el mercado y el precio ya completados. También puede hacer clic derecho en el gráfico y elegir <strong class='text-white'>Add Alert</strong>. Elija la condición, decida si quiere un sonido, una ventana emergente o ambos, y guárdela. Un pequeño <strong class='text-white'>icono de campana</strong> se coloca en el gráfico a ese precio; haga clic izquierdo en la campana para borrar la alerta cuando ya no la necesite. El mismo clic funciona en la escalera del DOM.", image: {"src":`${IMG}/tradovate-price-levels-5.png`,"alt":"Cuadro de diálogo de alerta abierto al hacer clic en el eje de precios, con un icono de campana que marca el nivel en el gráfico"} },
      ],
    },
    { type: "heading",text: "Algunas cosas que conviene saber" },
    { type: "paragraph",html: "Los dibujos de los gráficos de Tradovate no siempre sobreviven a un reinicio ni le siguen entre dispositivos, así que si un nivel dibujado a mano desaparece, retroceda hasta la fecha en que lo colocó por primera vez y normalmente se vuelve a cargar. Las líneas integradas de Price Levels no tienen ese problema porque se recalculan a partir de los datos de la sesión cada vez. Y si opera una cuenta de fondeo o de evaluación, recuerde que sus alertas y líneas son solo ayudas visuales; no modifican las reglas de riesgo de su firma, que varían según la firma y el tamaño de la cuenta, así que consulte los límites vigentes de su firma antes de apoyarse en cualquier nivel." },
    { type: "heading",text: "Automatice esto con PickMyTrade" },
    { type: "paragraph",html: "¿Quiere que un nivel <em>haga</em> algo en lugar de limitarse a avisarle? Puede conectar sus configuraciones de TradingView para enviar órdenes reales a Tradovate automáticamente." },
  ], fr: [
    { type: "paragraph",html: "Les niveaux de prix sont les lignes de référence horizontales qui vous gardent honnête sur l’endroit où se trouve réellement le marché. Tradovate en génère un ensemble directement à partir des données de séance (l’ouverture, le plus haut, le plus bas et un point médian réglable), et vous pouvez superposer vos propres lignes pour les prix qui comptent vraiment pour votre stratégie. Voici comment les activer, les styliser pour qu’elles se lisent d’un coup d’œil et relier n’importe quel niveau à une alerte afin de ne pas rester rivé à l’écran à attendre un contact." },
    { type: "paragraph",html: "Deux choses sont appelées « niveaux de prix » dans Tradovate, et mieux vaut ne pas les confondre. Le menu <strong class='text-white'>Price Levels</strong> trace automatiquement des lignes basées sur les données (Open, High, Low, Middle). Une <strong class='text-white'>Horizontal Line</strong> issue des outils de dessin est une ligne que vous placez à la main. Les deux apparaissent comme des lignes horizontales nettes, et les deux peuvent déclencher une alerte." },
    { type: "heading",text: "Ajouter des niveaux de prix aux graphiques Tradovate : pas à pas" },
    {
      type: "steps",
      items: [
        { title: "Ouvrir le menu Price Levels", html: "Survolez le graphique avec la souris pour faire apparaître les barres d’outils, puis cliquez sur l’icône Chart Settings en haut du module Chart. Dans le menu déroulant qui s’ouvre, choisissez <strong class='text-white'>Price Levels</strong>. C’est le panneau qui contrôle toutes les lignes intégrées.", image: {"src":`${IMG}/tradovate-price-levels-1.png`,"alt":"Menu déroulant Chart Settings de Tradovate ouvert avec l’option Price Levels mise en évidence"} },
        { title: "Activer les niveaux souhaités", html: "Dans le panneau Price Levels, activez les lignes que vous utilisez. <strong class='text-white'>Open</strong>, <strong class='text-white'>High</strong>, <strong class='text-white'>Low</strong> et <strong class='text-white'>Middle</strong> s’activent chacune séparément, vous pouvez donc n’utiliser que l’ouverture de séance et ignorer le reste si c’est votre style. Pour tout réinitialiser rapidement, <strong class='text-white'>Show All</strong> place toutes les lignes sur le graphique et <strong class='text-white'>Hide All</strong> les efface en un clic.", image: {"src":`${IMG}/tradovate-price-levels-2.png`,"alt":"Panneau Price Levels affichant les interrupteurs Open, High, Low et Middle avec les boutons Show All et Hide All"} },
        { title: "Définir les couleurs et le point médian", html: "Les couleurs par défaut se fondent dans un graphique chargé ; cliquez donc sur <strong class='text-white'>Settings</strong> dans le menu déroulant Price Levels pour recolorer les lignes Open, High, Low et Middle. Choisissez des teintes que vous lisez en une demi-seconde, car tout l’intérêt est le coup d’œil. Pendant que vous y êtes, le champ <strong class='text-white'>Percents (From High to Low)</strong> détermine où la ligne Middle est tracée. À 50 %, la ligne se situe exactement à mi-chemin entre le plus haut et le plus bas de la séance ; modifiez la valeur pour la pondérer où vous voulez. Il existe aussi un interrupteur <strong class='text-white'>Show P&amp;L On Priceline</strong> qui fait suivre le P&amp;L de votre position ouverte le long de la ligne du prix actuel à mesure qu’il évolue.", image: {"src":`${IMG}/tradovate-price-levels-3.png`,"alt":"Paramètres de Price Levels avec sélecteurs de couleur pour chaque ligne et le champ Percents From High to Low"} },
        { title: "Tracer votre propre niveau", html: "Les lignes automatiques ne couvriront ni un swing précédent, ni un chiffre rond, ni une zone d’offre que vous avez repérée à la main. Pour ceux-là, survolez le graphique pour faire apparaître la barre d’outils, ouvrez les <strong class='text-white'>Drawing Tools</strong> et choisissez la <strong class='text-white'>Horizontal Line</strong>. Cliquez une fois au prix voulu et la ligne s’étend sur tout le graphique. Double-cliquez dessus plus tard pour changer sa couleur ou son épaisseur, et maintenez la touche <strong class='text-white'>Shift</strong> enfoncée pendant le placement si vous voulez voir s’afficher le prix exact pendant le glissement.", image: {"src":`${IMG}/tradovate-price-levels-4.png`,"alt":"Outil de dessin Horizontal Line plaçant une ligne de niveau de prix personnalisée sur un graphique Tradovate"} },
        { title: "Transformer un niveau en alerte de prix", html: "Une ligne sur le graphique ne fait que la moitié du travail. Pour être averti lorsque le prix l’atteint, faites un simple clic gauche sur l’<strong class='text-white'>axe des prix</strong> à ce niveau (sur les graphiques plus récents, cliquez vers le bord gauche de l’axe) et la boîte de dialogue d’alerte s’ouvre avec le marché et le prix préremplis. Vous pouvez aussi faire un clic droit sur le graphique et choisir <strong class='text-white'>Add Alert</strong>. Choisissez la condition, indiquez si vous voulez un son, une fenêtre contextuelle ou les deux, puis enregistrez. Une petite <strong class='text-white'>icône de cloche</strong> se pose sur le graphique à ce prix ; faites un clic gauche sur la cloche pour supprimer l’alerte lorsque vous n’en avez plus besoin. Le même clic fonctionne sur l’échelle du DOM.", image: {"src":`${IMG}/tradovate-price-levels-5.png`,"alt":"Boîte de dialogue d’alerte ouverte en cliquant sur l’axe des prix, avec une icône de cloche marquant le niveau sur le graphique"} },
      ],
    },
    { type: "heading",text: "Quelques points à connaître" },
    { type: "paragraph",html: "Les dessins des graphiques Tradovate ne survivent pas toujours à un redémarrage et ne vous suivent pas toujours d’un appareil à l’autre ; si un niveau tracé à la main disparaît, remontez jusqu’à la date où vous l’avez placé pour la première fois, et il se recharge généralement. Les lignes intégrées de Price Levels n’ont pas ce problème, car elles sont recalculées à partir des données de séance à chaque fois. Et si vous tradez un compte prop ou d’évaluation, souvenez-vous que vos alertes et lignes ne sont que des aides visuelles ; elles ne modifient pas les règles de risque de votre société, qui varient selon la société et la taille du compte. Vérifiez donc les limites en vigueur de votre société avant de vous appuyer sur un niveau." },
    { type: "heading",text: "Automatisez cela avec PickMyTrade" },
    { type: "paragraph",html: "Vous voulez qu’un niveau <em>fasse</em> quelque chose au lieu de simplement vous prévenir ? Vous pouvez relier vos configurations TradingView pour envoyer de vrais ordres dans Tradovate automatiquement." },
  ], it: [
    { type: "paragraph",html: "I livelli di prezzo sono le linee orizzontali di riferimento che la tengono onesta su dove si trova davvero il mercato. Tradovate ne genera un set direttamente dai dati di sessione (l’apertura, il massimo, il minimo e un punto medio regolabile), e lei può aggiungere le sue linee personali per i prezzi che contano davvero per la sua strategia. Ecco come attivarli, personalizzarli perché si leggano a colpo d’occhio e collegare qualsiasi livello a un avviso, così non deve restare incollato allo schermo ad aspettare un tocco." },
    { type: "paragraph",html: "In Tradovate due cose vengono chiamate «livelli di prezzo», ed è utile non confonderle. Il menu <strong class='text-white'>Price Levels</strong> disegna automaticamente linee basate sui dati (Open, High, Low, Middle). Una <strong class='text-white'>Horizontal Line</strong> degli strumenti di disegno è invece una linea che posiziona lei a mano. Entrambe appaiono come linee orizzontali pulite ed entrambe possono far scattare un avviso." },
    { type: "heading",text: "Aggiungere livelli di prezzo ai grafici di Tradovate: passo dopo passo" },
    {
      type: "steps",
      items: [
        { title: "Aprire il menu Price Levels", html: "Passi il mouse sul grafico per far comparire le barre degli strumenti, quindi clicchi sull’icona Chart Settings nella parte superiore del modulo Chart. Nel menu a discesa che si apre, scelga <strong class='text-white'>Price Levels</strong>. È il pannello che controlla tutte le linee integrate.", image: {"src":`${IMG}/tradovate-price-levels-1.png`,"alt":"Menu a discesa Chart Settings di Tradovate aperto con l’opzione Price Levels evidenziata"} },
        { title: "Attivare i livelli desiderati", html: "All’interno del pannello Price Levels, attivi le linee che utilizza. <strong class='text-white'>Open</strong>, <strong class='text-white'>High</strong>, <strong class='text-white'>Low</strong> e <strong class='text-white'>Middle</strong> si attivano ciascuna separatamente, quindi può usare solo l’apertura di sessione e saltare il resto, se è il suo stile. Per ripartire in fretta, <strong class='text-white'>Show All</strong> inserisce tutte le linee sul grafico e <strong class='text-white'>Hide All</strong> le rimuove con un clic.", image: {"src":`${IMG}/tradovate-price-levels-2.png`,"alt":"Pannello Price Levels con gli interruttori Open, High, Low e Middle e i pulsanti Show All e Hide All"} },
        { title: "Impostare i colori e il punto medio", html: "I colori predefiniti si confondono in un grafico affollato, quindi clicchi su <strong class='text-white'>Settings</strong> nel menu a discesa Price Levels per ricolorare le linee Open, High, Low e Middle. Scelga tonalità che riesce a leggere in mezzo secondo, perché lo scopo è il colpo d’occhio. Già che c’è, il campo <strong class='text-white'>Percents (From High to Low)</strong> decide dove viene tracciata la linea Middle. Impostandolo al 50 %, la linea si colloca esattamente a metà tra il massimo e il minimo della sessione; cambi il numero per ponderarla dove preferisce. C’è anche un interruttore <strong class='text-white'>Show P&amp;L On Priceline</strong> che fa scorrere il P&amp;L della sua posizione aperta lungo la linea del prezzo corrente mentre si muove.", image: {"src":`${IMG}/tradovate-price-levels-3.png`,"alt":"Impostazioni di Price Levels con selettori di colore per ogni linea e il campo Percents From High to Low"} },
        { title: "Disegnare un livello personalizzato", html: "Le linee automatiche non coprono uno swing precedente, un numero tondo o una zona di offerta che ha individuato a mano. Per questi casi, passi il mouse sul grafico per far apparire la barra degli strumenti, apra i <strong class='text-white'>Drawing Tools</strong> e scelga la <strong class='text-white'>Horizontal Line</strong>. Clicchi una volta sul prezzo desiderato e la linea si estende su tutto il grafico. Faccia doppio clic su di essa in seguito per cambiarne il colore o lo spessore, e tenga premuto <strong class='text-white'>Shift</strong> mentre la posiziona se vuole che il prezzo esatto venga mostrato durante il trascinamento.", image: {"src":`${IMG}/tradovate-price-levels-4.png`,"alt":"Strumento di disegno Horizontal Line che posiziona una linea di livello di prezzo personalizzata su un grafico di Tradovate"} },
        { title: "Trasformare un livello in un avviso di prezzo", html: "Una linea sul grafico è solo metà del lavoro. Per essere avvisato quando il prezzo la raggiunge, faccia un singolo clic sinistro sull’<strong class='text-white'>asse dei prezzi</strong> a quel livello (sui grafici più recenti, clicchi verso il bordo sinistro dell’asse) e si apre la finestra dell’avviso con mercato e prezzo già inseriti. Può anche fare clic destro sul grafico e scegliere <strong class='text-white'>Add Alert</strong>. Scelga la condizione, decida se vuole un suono, un popup o entrambi, e salvi. Una piccola <strong class='text-white'>icona a campana</strong> si posiziona sul grafico a quel prezzo; clicchi con il tasto sinistro sulla campana per eliminare l’avviso quando non le serve più. Lo stesso clic funziona sulla scala del DOM.", image: {"src":`${IMG}/tradovate-price-levels-5.png`,"alt":"Finestra dell’avviso aperta cliccando sull’asse dei prezzi, con un’icona a campana che segna il livello sul grafico"} },
      ],
    },
    { type: "heading",text: "Alcune cose utili da sapere" },
    { type: "paragraph",html: "I disegni sui grafici di Tradovate non sempre sopravvivono a un riavvio né la seguono tra i dispositivi, quindi se un livello disegnato a mano scompare, torni indietro alla data in cui lo ha inserito per la prima volta e di solito si ricarica. Le linee integrate di Price Levels non hanno questo problema perché vengono ricalcolate ogni volta dai dati di sessione. E se opera su un conto prop o di valutazione, ricordi che i suoi avvisi e le sue linee sono solo ausili visivi; non modificano le regole di rischio della sua società, che variano in base alla società e alla dimensione del conto, quindi controlli i limiti attuali della sua società prima di fare affidamento su un livello." },
    { type: "heading",text: "Automatizzi tutto questo con PickMyTrade" },
    { type: "paragraph",html: "Vuole che un livello <em>faccia</em> qualcosa invece di limitarsi ad avvisarla? Può collegare i suoi setup di TradingView per inviare ordini reali a Tradovate automaticamente." },
  ] },
  ctaHeading: { en: "Turn a Level Into an Automatic Order", de: "Machen Sie aus einem Niveau eine automatische Order", es: "Convierta un nivel en una orden automática", fr: "Transformez un niveau en ordre automatique", it: "Trasformi un livello in un ordine automatico" },
  ctaText: { en: "Wire your TradingView setups to PickMyTrade and fire real orders into Tradovate automatically the moment a level prints.", de: "Verbinden Sie Ihre TradingView-Setups mit PickMyTrade und lösen Sie echte Orders automatisch in Tradovate aus, sobald ein Niveau erreicht wird.", es: "Conecte sus configuraciones de TradingView con PickMyTrade y envíe órdenes reales a Tradovate automáticamente en cuanto se alcance un nivel.", fr: "Reliez vos configurations TradingView à PickMyTrade et envoyez de vrais ordres dans Tradovate automatiquement dès qu’un niveau est atteint.", it: "Colleghi i suoi setup di TradingView a PickMyTrade e invii ordini reali a Tradovate automaticamente nel momento in cui un livello viene raggiunto." },
