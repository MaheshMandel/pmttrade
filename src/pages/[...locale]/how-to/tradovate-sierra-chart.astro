---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "tradovate-sierra-chart";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/how-to/${SLUG}`;

const META_TITLE = "Connect Tradovate Data to Sierra Chart via CQG";
const META_DESCRIPTION =
  "No direct Tradovate link to Sierra Chart? Learn the indirect CQG and Denali data route, the credentials you need, and the exact setup steps.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Tradovate-Daten über CQG mit Sierra Chart verbinden", es: "Conecte los datos de Tradovate a Sierra Chart mediante CQG", fr: "Connecter les données Tradovate à Sierra Chart via CQG", it: "Collegare i dati di Tradovate a Sierra Chart tramite CQG" },
  dek: { en: "There's no direct Tradovate connection in Sierra Chart. Here's the indirect CQG order-routing and Denali data route, the credentials you need, and the exact setup steps.", de: "In Sierra Chart gibt es keine direkte Tradovate-Verbindung. Hier finden Sie den indirekten Weg über CQG-Orderrouting und Denali-Daten, die benötigten Zugangsdaten und die genauen Einrichtungsschritte.", es: "Sierra Chart no tiene una conexión directa con Tradovate. Aquí encontrará la ruta indirecta de enrutamiento de órdenes de CQG y datos de Denali, las credenciales que necesita y los pasos exactos de configuración.", fr: "Sierra Chart ne propose pas de connexion directe à Tradovate. Voici la voie indirecte via le routage d'ordres CQG et les données Denali, les identifiants nécessaires et les étapes exactes de configuration.", it: "In Sierra Chart non esiste una connessione diretta a Tradovate. Ecco il percorso indiretto tramite instradamento ordini CQG e dati Denali, le credenziali necessarie e i passaggi esatti di configurazione." },
  readTime: { en: "7 min read", de: "7 Min. Lesezeit", es: "Lectura de 7 min", fr: "Lecture : 7 min", it: "Lettura di 7 min" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "If you've tried to add your Tradovate account to Sierra Chart and hit a wall, you're not imagining it. There is no direct connection. Tradovate made a business decision not to set up account connectivity with Sierra Chart, so you can't just type in your Tradovate username and password and go. A handful of older accounts are grandfathered in, but for anyone setting this up today, that front door is closed." },
    { type: "paragraph", html: "The way around it is indirect. Tradovate runs on CQG's infrastructure, so you connect Sierra Chart to CQG for order routing and pull your CME market data through Sierra Chart's own Denali feed. It works, but it has moving parts and real costs, and whether you can do it at all comes down to your broker or prop firm handing you CQG credentials. Here's the full picture before you spend a dollar on a service package." },
    {
      type: "table",
      headers: ["What you need", "Direct Tradovate", "The CQG + Denali route"],
      rows: [
        ["Order routing", "Not available", "CQG Web API (live account only)"],
        ["CME / EUREX data", "Not served over CQG", "Denali Exchange Data Feed"],
        ["Sierra Chart plan", "-", "Service Package 10 or higher"],
      ],
    },
    { type: "heading", text: "Connect Sierra Chart to Tradovate Data: Step-by-Step" },
    {
      type: "steps",
      items: [
        { title: "Get CQG Credentials from Your Broker or Firm", html: "This is the step that decides whether you can do this at all. Your Tradovate login won't work in Sierra Chart. You need a separate CQG username and password, and only your broker or prop firm can issue them. Ask them directly whether they'll set up a CQG account for you. Plenty of firms won't, because they route through Tradovate on purpose, so confirm it before you pay for anything else. And CQG demo accounts aren't supported here, only live, funded accounts." },
        { title: "Check Your Sierra Chart Service Package", html: "CQG needs Sierra Chart Service Package 10 or higher. If you're on a lower tier, upgrade in your Sierra Chart account control panel first. It's a cheap step to overlook, and the CQG service simply won't appear the way you expect until the package is right." },
        { title: "Point Sierra Chart at the CQG Web API Service", html: "In Sierra Chart, open <strong class='text-white'>Global Settings &rsaquo; Data/Trade Service Settings</strong>. Set the Current Selected Service to <strong class='text-white'>CQG Web API</strong>. In the username and password boxes, enter the CQG credentials your broker gave you, not your Sierra Chart account name and password. These are case sensitive, so type them exactly as they were provided. One wrong character and the connection just fails silently." },
        { title: "Turn on the Denali Feed for CME Data", html: "Here's the part that trips people up. When you route through CQG, Sierra Chart does not serve CME Group or EUREX data over the CQG connection. You get that data through Sierra Chart's own Denali Exchange Data Feed instead. In Data/Trade Service Settings, open <strong class='text-white'>Common Settings</strong> and set <strong class='text-white'>Allow Support for Sierra Chart Data Feeds</strong> to Yes, then activate the exchanges you need (CME, CBOT, NYMEX, COMEX, EUREX) from the Denali activation page in your account control panel." },
        { title: "Connect a Live Funded Account to Unlock Non-Professional Data", html: "For the reduced non-professional CME rate, Sierra Chart has to verify you hold a live, funded futures account. Connect Sierra Chart to that live account at least once a month so the check passes. Miss it and your CME data can drop out mid-session. Exchange data fees stack on top of your Sierra Chart plan, and the exact amounts vary by exchange and by whether you qualify as non-professional, so check the current rates before you commit." },
      ],
    },
    { type: "heading", text: "If Your Firm Won't Hand Over CQG Credentials" },
    { type: "paragraph", html: "Plenty of Tradovate and prop-firm accounts never get CQG access, so keep two backups in mind. Sierra Chart's own Teton order routing is a zero-cost futures routing service that pairs with the same Denali data feed and skips the broker-connectivity problem entirely. Rithmic is the other common route, and it's handy if you run several prop accounts since you can link them through a single Rithmic connection, though its historical data is thinner. Both still lean on Denali for CME data, so that piece doesn't change either way. Any prop-firm rules on connections and data are set by the firm, so confirm what your plan and account size actually allow before you build a workflow around it." },
    { type: "heading", text: "Automate This with PickMyTrade" },
    { type: "paragraph", html: "If your real goal is automating Tradovate orders rather than charting inside Sierra Chart, you don't need any of this. <strong class='text-white'>PickMyTrade routes your TradingView signals straight to Tradovate</strong>, with no CQG credentials or extra data package to wrangle." },
    { type: "paragraph", html: "A lot of traders skip the Sierra Chart route altogether and connect Tradovate to TradingView for charting, then automate the orders with webhooks. If charting in Sierra Chart isn't the hard requirement, that path is far less fragile than chasing CQG credentials." },
  ], de: [
    { type: "paragraph",html: "Wenn Sie versucht haben, Ihr Tradovate-Konto in Sierra Chart einzubinden, und nicht weiterkamen, bilden Sie sich das nicht ein. Es gibt keine direkte Verbindung. Tradovate hat sich geschäftlich dagegen entschieden, eine Kontoanbindung an Sierra Chart einzurichten, daher können Sie nicht einfach Ihren Tradovate-Benutzernamen und Ihr Passwort eingeben und loslegen. Einige ältere Konten genießen Bestandsschutz, aber für alle, die heute neu einrichten, ist diese Tür verschlossen." },
    { type: "paragraph",html: "Der Weg darum herum ist indirekt. Tradovate läuft auf der Infrastruktur von CQG. Sie verbinden Sierra Chart also für das Orderrouting mit CQG und beziehen Ihre CME-Marktdaten über den eigenen Denali-Feed von Sierra Chart. Das funktioniert, hat aber mehrere bewegliche Teile und reale Kosten, und ob es überhaupt möglich ist, hängt davon ab, ob Ihr Broker oder Prop-Firm Ihnen CQG-Zugangsdaten zur Verfügung stellt. Hier ist das vollständige Bild, bevor Sie einen Cent für ein Servicepaket ausgeben." },
    { type: "table", headers: ["Was Sie benötigen","Direkt über Tradovate","Die Route CQG + Denali"], rows: [
      ["Orderrouting","Nicht verfügbar","CQG Web API (nur Live-Konto)"],
      ["CME- / EUREX-Daten","Werden nicht über CQG bereitgestellt","Denali Exchange Data Feed"],
      ["Sierra-Chart-Tarif","-","Service Package 10 oder höher"],
    ] },
    { type: "heading",text: "Sierra Chart mit Tradovate-Daten verbinden: Schritt für Schritt" },
    {
      type: "steps",
      items: [
        { title: "CQG-Zugangsdaten von Ihrem Broker oder Ihrer Firma erhalten", html: "Dieser Schritt entscheidet darüber, ob Sie das Ganze überhaupt umsetzen können. Ihr Tradovate-Login funktioniert in Sierra Chart nicht. Sie benötigen einen separaten CQG-Benutzernamen und ein separates Passwort, und nur Ihr Broker oder Ihre Prop-Firm kann diese ausstellen. Fragen Sie dort direkt nach, ob ein CQG-Konto für Sie eingerichtet wird. Viele Firmen tun das nicht, weil sie bewusst über Tradovate routen. Klären Sie das also, bevor Sie für irgendetwas anderes bezahlen. Zudem werden CQG-Demokonten hier nicht unterstützt, nur echte, finanzierte Live-Konten." },
        { title: "Ihr Sierra-Chart-Servicepaket prüfen", html: "CQG erfordert Sierra Chart Service Package 10 oder höher. Falls Sie in einer niedrigeren Stufe sind, führen Sie zuerst ein Upgrade in Ihrem Sierra-Chart-Kontrollpanel durch. Dieser Schritt wird leicht übersehen, ist aber günstig, und der CQG-Dienst erscheint schlicht nicht wie erwartet, solange das Paket nicht stimmt." },
        { title: "Sierra Chart auf den CQG-Web-API-Dienst ausrichten", html: "Öffnen Sie in Sierra Chart <strong class='text-white'>Global Settings &rsaquo; Data/Trade Service Settings</strong>. Setzen Sie den Current Selected Service auf <strong class='text-white'>CQG Web API</strong>. Geben Sie in die Felder für Benutzername und Passwort die CQG-Zugangsdaten ein, die Ihr Broker Ihnen gegeben hat, nicht Ihren Sierra-Chart-Kontonamen und das zugehörige Passwort. Sie unterscheiden zwischen Groß- und Kleinschreibung, geben Sie sie also genau so ein, wie sie Ihnen mitgeteilt wurden. Ein falsches Zeichen, und die Verbindung scheitert stillschweigend." },
        { title: "Denali-Feed für CME-Daten aktivieren", html: "Hier stolpern viele. Wenn Sie über CQG routen, liefert Sierra Chart keine CME-Group- oder EUREX-Daten über die CQG-Verbindung. Diese Daten erhalten Sie stattdessen über den eigenen Denali Exchange Data Feed von Sierra Chart. Öffnen Sie in den Data/Trade Service Settings die <strong class='text-white'>Common Settings</strong> und setzen Sie <strong class='text-white'>Allow Support for Sierra Chart Data Feeds</strong> auf Yes. Aktivieren Sie anschließend die benötigten Börsen (CME, CBOT, NYMEX, COMEX, EUREX) auf der Denali-Aktivierungsseite in Ihrem Kontrollpanel." },
        { title: "Ein finanziertes Live-Konto verbinden, um Non-Professional-Daten freizuschalten", html: "Für den ermäßigten CME-Tarif für Nicht-Profis muss Sierra Chart prüfen, dass Sie ein finanziertes Live-Futures-Konto besitzen. Verbinden Sie Sierra Chart mindestens einmal im Monat mit diesem Live-Konto, damit die Prüfung bestanden wird. Andernfalls können Ihre CME-Daten mitten in der Sitzung ausfallen. Börsendatengebühren kommen zusätzlich zu Ihrem Sierra-Chart-Tarif hinzu, und die genauen Beträge variieren je nach Börse und danach, ob Sie als Nicht-Profi gelten. Prüfen Sie die aktuellen Preise, bevor Sie sich festlegen." },
      ],
    },
    { type: "heading",text: "Wenn Ihre Firma keine CQG-Zugangsdaten herausgibt" },
    { type: "paragraph",html: "Viele Tradovate- und Prop-Firm-Konten erhalten nie CQG-Zugang, merken Sie sich daher zwei Alternativen. Das eigene Teton-Orderrouting von Sierra Chart ist ein kostenloser Futures-Routingdienst, der mit demselben Denali-Datenfeed zusammenarbeitet und das Problem der Broker-Anbindung ganz umgeht. Rithmic ist der andere gängige Weg und praktisch, wenn Sie mehrere Prop-Konten betreiben, da Sie diese über eine einzige Rithmic-Verbindung verknüpfen können, wenn auch mit dünnerer Datenhistorie. Beide stützen sich für CME-Daten weiterhin auf Denali, daher ändert sich dieser Teil in keinem Fall. Regeln der Prop-Firm zu Verbindungen und Daten legt die Firma fest. Prüfen Sie also, was Ihr Plan und Ihre Kontogröße tatsächlich erlauben, bevor Sie einen Workflow darauf aufbauen." },
    { type: "heading",text: "Automatisieren Sie dies mit PickMyTrade" },
    { type: "paragraph",html: "Wenn Ihr eigentliches Ziel die Automatisierung von Tradovate-Orders ist und nicht das Charting in Sierra Chart, brauchen Sie das alles nicht. <strong class='text-white'>PickMyTrade leitet Ihre TradingView-Signale direkt an Tradovate weiter</strong> – ohne CQG-Zugangsdaten und ohne zusätzliches Datenpaket." },
    { type: "paragraph",html: "Viele Trader umgehen die Sierra-Chart-Route ganz, verbinden Tradovate mit TradingView für das Charting und automatisieren die Orders per Webhooks. Wenn Charting in Sierra Chart keine zwingende Anforderung ist, ist dieser Weg weit weniger anfällig, als CQG-Zugangsdaten hinterherzujagen." },
  ], es: [
    { type: "paragraph",html: "Si ha intentado añadir su cuenta de Tradovate a Sierra Chart y se ha topado con un muro, no son imaginaciones suyas. No existe una conexión directa. Tradovate tomó la decisión comercial de no establecer conectividad de cuentas con Sierra Chart, así que no basta con escribir su usuario y contraseña de Tradovate y seguir adelante. Unas pocas cuentas antiguas conservan esa posibilidad, pero para quien configura esto hoy, esa puerta está cerrada." },
    { type: "paragraph",html: "El camino alternativo es indirecto. Tradovate funciona sobre la infraestructura de CQG, así que usted conecta Sierra Chart a CQG para el enrutamiento de órdenes y obtiene sus datos de mercado de CME mediante el propio feed Denali de Sierra Chart. Funciona, pero tiene varias piezas móviles y costes reales, y que pueda hacerlo o no depende de que su broker o prop firm le proporcione credenciales de CQG. Aquí tiene el panorama completo antes de gastar un dólar en un paquete de servicio." },
    { type: "table", headers: ["Lo que necesita","Tradovate directo","La ruta CQG + Denali"], rows: [
      ["Enrutamiento de órdenes","No disponible","CQG Web API (solo cuenta real)"],
      ["Datos de CME / EUREX","No se sirven a través de CQG","Denali Exchange Data Feed"],
      ["Plan de Sierra Chart","-","Service Package 10 o superior"],
    ] },
    { type: "heading",text: "Conectar Sierra Chart a los datos de Tradovate: paso a paso" },
    {
      type: "steps",
      items: [
        { title: "Obtenga las credenciales de CQG de su broker o firma", html: "Este es el paso que decide si podrá hacerlo o no. Su inicio de sesión de Tradovate no funcionará en Sierra Chart. Necesita un usuario y una contraseña de CQG distintos, y solo su broker o prop firm puede emitirlos. Pregúnteles directamente si le configurarán una cuenta de CQG. Muchas firmas no lo hacen porque enrutan a través de Tradovate a propósito, así que confírmelo antes de pagar por cualquier otra cosa. Además, las cuentas demo de CQG no son compatibles aquí, solo cuentas reales y fondeadas." },
        { title: "Compruebe su paquete de servicio de Sierra Chart", html: "CQG requiere Sierra Chart Service Package 10 o superior. Si está en un nivel inferior, actualice primero desde el panel de control de su cuenta de Sierra Chart. Es un paso barato que se pasa por alto con facilidad, y el servicio CQG simplemente no aparecerá como espera hasta que el paquete sea el correcto." },
        { title: "Apunte Sierra Chart al servicio CQG Web API", html: "En Sierra Chart, abra <strong class='text-white'>Global Settings &rsaquo; Data/Trade Service Settings</strong>. Establezca el Current Selected Service en <strong class='text-white'>CQG Web API</strong>. En los campos de usuario y contraseña, introduzca las credenciales de CQG que le dio su broker, no el nombre y la contraseña de su cuenta de Sierra Chart. Distinguen mayúsculas y minúsculas, así que escríbalas exactamente como se las entregaron. Un solo carácter incorrecto y la conexión falla en silencio." },
        { title: "Active el feed Denali para los datos de CME", html: "Esta es la parte que confunde a la gente. Cuando enruta a través de CQG, Sierra Chart no sirve datos de CME Group ni de EUREX por la conexión de CQG. Esos datos los obtiene mediante el propio Denali Exchange Data Feed de Sierra Chart. En Data/Trade Service Settings, abra <strong class='text-white'>Common Settings</strong> y establezca <strong class='text-white'>Allow Support for Sierra Chart Data Feeds</strong> en Yes; después active los mercados que necesite (CME, CBOT, NYMEX, COMEX, EUREX) desde la página de activación de Denali en el panel de control de su cuenta." },
        { title: "Conecte una cuenta real fondeada para desbloquear los datos de no profesional", html: "Para obtener la tarifa reducida de CME para no profesionales, Sierra Chart debe verificar que usted tiene una cuenta de futuros real y fondeada. Conecte Sierra Chart a esa cuenta real al menos una vez al mes para que la verificación se supere. Si no lo hace, sus datos de CME pueden cortarse en plena sesión. Las tarifas de datos de los mercados se suman a su plan de Sierra Chart, y los importes exactos varían según el mercado y según califique como no profesional, así que consulte las tarifas vigentes antes de comprometerse." },
      ],
    },
    { type: "heading",text: "Si su firma no le entrega credenciales de CQG" },
    { type: "paragraph",html: "Muchas cuentas de Tradovate y de prop firms nunca obtienen acceso a CQG, así que tenga presentes dos alternativas. El enrutamiento de órdenes Teton de Sierra Chart es un servicio de enrutamiento de futuros sin coste que se combina con el mismo feed de datos Denali y evita por completo el problema de conectividad con el broker. Rithmic es la otra vía habitual y resulta práctica si opera varias cuentas de prop firm, ya que puede enlazarlas mediante una única conexión Rithmic, aunque su historial de datos es más limitado. Ambas siguen apoyándose en Denali para los datos de CME, por lo que esa parte no cambia en ningún caso. Las reglas de las prop firms sobre conexiones y datos las fija la propia firma, así que confirme lo que su plan y el tamaño de su cuenta permiten realmente antes de construir un flujo de trabajo sobre ello." },
    { type: "heading",text: "Automatice esto con PickMyTrade" },
    { type: "paragraph",html: "Si su objetivo real es automatizar órdenes de Tradovate y no graficar dentro de Sierra Chart, nada de esto es necesario. <strong class='text-white'>PickMyTrade envía sus señales de TradingView directamente a Tradovate</strong>, sin credenciales de CQG ni paquetes de datos adicionales de los que preocuparse." },
    { type: "paragraph",html: "Muchos traders se saltan por completo la ruta de Sierra Chart: conectan Tradovate a TradingView para graficar y automatizan las órdenes con webhooks. Si graficar en Sierra Chart no es un requisito imprescindible, ese camino es mucho menos frágil que perseguir credenciales de CQG." },
  ], fr: [
    { type: "paragraph",html: "Si vous avez essayé d'ajouter votre compte Tradovate à Sierra Chart et que vous avez buté sur un mur, vous ne rêvez pas. Il n'existe aucune connexion directe. Tradovate a pris la décision commerciale de ne pas mettre en place de connectivité de compte avec Sierra Chart ; vous ne pouvez donc pas simplement saisir votre nom d'utilisateur et votre mot de passe Tradovate pour démarrer. Quelques anciens comptes bénéficient d'une exception, mais pour toute personne qui configure cela aujourd'hui, cette porte est fermée." },
    { type: "paragraph",html: "Le contournement est indirect. Tradovate repose sur l'infrastructure de CQG : vous connectez donc Sierra Chart à CQG pour le routage des ordres et vous récupérez vos données de marché CME via le flux Denali propre à Sierra Chart. Cela fonctionne, mais comporte plusieurs éléments mobiles et des coûts réels, et la possibilité de le faire dépend entièrement de la remise d'identifiants CQG par votre courtier ou votre prop firm. Voici le tableau complet avant de dépenser un centime pour un forfait de service." },
    { type: "table", headers: ["Ce dont vous avez besoin","Tradovate en direct","La voie CQG + Denali"], rows: [
      ["Routage des ordres","Non disponible","CQG Web API (compte réel uniquement)"],
      ["Données CME / EUREX","Non fournies via CQG","Denali Exchange Data Feed"],
      ["Formule Sierra Chart","-","Service Package 10 ou supérieur"],
    ] },
    { type: "heading",text: "Connecter Sierra Chart aux données Tradovate : étape par étape" },
    {
      type: "steps",
      items: [
        { title: "Obtenir les identifiants CQG auprès de votre courtier ou de votre firme", html: "C'est l'étape qui détermine si vous pouvez le faire ou non. Votre identifiant Tradovate ne fonctionnera pas dans Sierra Chart. Vous avez besoin d'un nom d'utilisateur et d'un mot de passe CQG distincts, que seuls votre courtier ou votre prop firm peuvent délivrer. Demandez-leur directement s'ils ouvriront un compte CQG pour vous. De nombreuses firmes refusent, car elles routent volontairement via Tradovate ; confirmez donc ce point avant de payer quoi que ce soit d'autre. De plus, les comptes de démonstration CQG ne sont pas pris en charge ici, uniquement les comptes réels et financés." },
        { title: "Vérifier votre forfait de service Sierra Chart", html: "CQG exige Sierra Chart Service Package 10 ou supérieur. Si vous avez un niveau inférieur, passez d'abord à un niveau supérieur dans le panneau de contrôle de votre compte Sierra Chart. C'est une étape peu coûteuse que l'on oublie facilement, et le service CQG n'apparaîtra tout simplement pas comme prévu tant que le forfait n'est pas le bon." },
        { title: "Pointer Sierra Chart vers le service CQG Web API", html: "Dans Sierra Chart, ouvrez <strong class='text-white'>Global Settings &rsaquo; Data/Trade Service Settings</strong>. Définissez le Current Selected Service sur <strong class='text-white'>CQG Web API</strong>. Dans les champs de nom d'utilisateur et de mot de passe, saisissez les identifiants CQG fournis par votre courtier, et non le nom et le mot de passe de votre compte Sierra Chart. Ils sont sensibles à la casse ; saisissez-les donc exactement tels qu'ils vous ont été remis. Un seul caractère erroné et la connexion échoue silencieusement." },
        { title: "Activer le flux Denali pour les données CME", html: "C'est là que beaucoup butent. Lorsque vous routez via CQG, Sierra Chart ne fournit pas les données CME Group ni EUREX sur la connexion CQG. Vous obtenez ces données via le Denali Exchange Data Feed propre à Sierra Chart. Dans Data/Trade Service Settings, ouvrez <strong class='text-white'>Common Settings</strong> et réglez <strong class='text-white'>Allow Support for Sierra Chart Data Feeds</strong> sur Yes, puis activez les places de marché dont vous avez besoin (CME, CBOT, NYMEX, COMEX, EUREX) depuis la page d'activation Denali du panneau de contrôle de votre compte." },
        { title: "Connecter un compte réel financé pour débloquer les données non professionnelles", html: "Pour bénéficier du tarif CME réduit non professionnel, Sierra Chart doit vérifier que vous détenez un compte de contrats à terme réel et financé. Connectez Sierra Chart à ce compte réel au moins une fois par mois afin que la vérification soit validée. Sinon, vos données CME peuvent disparaître en pleine séance. Les frais de données de marché s'ajoutent à votre formule Sierra Chart, et les montants exacts varient selon la place de marché et selon que vous remplissez ou non les conditions du statut non professionnel ; vérifiez donc les tarifs en vigueur avant de vous engager." },
      ],
    },
    { type: "heading",text: "Si votre firme ne vous remet pas d'identifiants CQG" },
    { type: "paragraph",html: "De nombreux comptes Tradovate et de prop firms n'obtiennent jamais d'accès CQG ; gardez donc deux solutions de repli en tête. Le routage d'ordres Teton de Sierra Chart est un service de routage de contrats à terme sans frais qui fonctionne avec le même flux de données Denali et contourne entièrement le problème de connectivité avec le courtier. Rithmic est l'autre voie courante, pratique si vous gérez plusieurs comptes de prop firm puisque vous pouvez les relier via une seule connexion Rithmic, même si son historique de données est plus limité. Les deux s'appuient toujours sur Denali pour les données CME, cet élément ne change donc pas. Les règles des prop firms sur les connexions et les données sont fixées par la firme ; vérifiez donc ce que votre formule et la taille de votre compte autorisent réellement avant de bâtir un flux de travail dessus." },
    { type: "heading",text: "Automatisez tout cela avec PickMyTrade" },
    { type: "paragraph",html: "Si votre objectif réel est d'automatiser les ordres Tradovate plutôt que de faire des graphiques dans Sierra Chart, vous n'avez besoin de rien de tout cela. <strong class='text-white'>PickMyTrade achemine vos signaux TradingView directement vers Tradovate</strong>, sans identifiants CQG ni forfait de données supplémentaire à gérer." },
    { type: "paragraph",html: "Beaucoup de traders contournent complètement la voie Sierra Chart : ils connectent Tradovate à TradingView pour les graphiques, puis automatisent les ordres avec des webhooks. Si les graphiques dans Sierra Chart ne sont pas une exigence stricte, cette approche est bien moins fragile que de courir après des identifiants CQG." },
  ], it: [
    { type: "paragraph",html: "Se ha provato ad aggiungere il suo conto Tradovate a Sierra Chart e si è scontrato con un muro, non è un'impressione. Non esiste una connessione diretta. Tradovate ha preso la decisione commerciale di non attivare la connettività dei conti con Sierra Chart, quindi non può semplicemente inserire nome utente e password di Tradovate e procedere. Alcuni conti più vecchi sono mantenuti per eccezione, ma per chi configura oggi quella porta è chiusa." },
    { type: "paragraph",html: "L'aggiramento è indiretto. Tradovate funziona sull'infrastruttura di CQG, quindi collega Sierra Chart a CQG per l'instradamento degli ordini e ottiene i dati di mercato CME tramite il feed Denali di Sierra Chart. Funziona, ma ha diverse parti in movimento e costi reali, e la possibilità di farlo dipende dal fatto che il suo broker o la sua prop firm le consegni le credenziali CQG. Ecco il quadro completo prima di spendere un dollaro per un pacchetto di servizio." },
    { type: "table", headers: ["Ciò di cui ha bisogno","Tradovate diretto","Il percorso CQG + Denali"], rows: [
      ["Instradamento ordini","Non disponibile","CQG Web API (solo conto reale)"],
      ["Dati CME / EUREX","Non forniti tramite CQG","Denali Exchange Data Feed"],
      ["Piano Sierra Chart","-","Service Package 10 o superiore"],
    ] },
    { type: "heading",text: "Collegare Sierra Chart ai dati di Tradovate: passo dopo passo" },
    {
      type: "steps",
      items: [
        { title: "Ottenga le credenziali CQG dal suo broker o dalla sua società", html: "Questo è il passaggio che decide se può farlo o meno. Il suo login di Tradovate non funzionerà in Sierra Chart. Le servono un nome utente e una password CQG separati, che solo il suo broker o la sua prop firm possono rilasciare. Chieda loro direttamente se configureranno un conto CQG per lei. Molte società non lo fanno, perché instradano intenzionalmente tramite Tradovate, quindi lo confermi prima di pagare qualsiasi altra cosa. Inoltre, i conti demo CQG non sono supportati qui, solo conti reali e finanziati." },
        { title: "Verifichi il suo pacchetto di servizio Sierra Chart", html: "CQG richiede Sierra Chart Service Package 10 o superiore. Se ha un livello inferiore, effettui prima l'upgrade dal pannello di controllo del suo account Sierra Chart. È un passaggio economico che si dimentica facilmente, e il servizio CQG semplicemente non apparirà come previsto finché il pacchetto non è corretto." },
        { title: "Indirizzi Sierra Chart al servizio CQG Web API", html: "In Sierra Chart, apra <strong class='text-white'>Global Settings &rsaquo; Data/Trade Service Settings</strong>. Imposti il Current Selected Service su <strong class='text-white'>CQG Web API</strong>. Nei campi nome utente e password inserisca le credenziali CQG fornite dal suo broker, non il nome e la password del suo account Sierra Chart. Distinguono tra maiuscole e minuscole, quindi le digiti esattamente come le sono state fornite. Basta un carattere sbagliato e la connessione fallisce in silenzio." },
        { title: "Attivi il feed Denali per i dati CME", html: "Questa è la parte che mette in difficoltà molti. Quando instrada tramite CQG, Sierra Chart non fornisce dati CME Group o EUREX sulla connessione CQG. Ottiene quei dati tramite il Denali Exchange Data Feed di Sierra Chart. In Data/Trade Service Settings apra <strong class='text-white'>Common Settings</strong> e imposti <strong class='text-white'>Allow Support for Sierra Chart Data Feeds</strong> su Yes, quindi attivi le borse di cui ha bisogno (CME, CBOT, NYMEX, COMEX, EUREX) dalla pagina di attivazione Denali nel pannello di controllo del suo account." },
        { title: "Colleghi un conto reale finanziato per sbloccare i dati non professionali", html: "Per ottenere la tariffa CME ridotta per non professionisti, Sierra Chart deve verificare che lei abbia un conto futures reale e finanziato. Colleghi Sierra Chart a quel conto reale almeno una volta al mese in modo che la verifica vada a buon fine. In caso contrario, i suoi dati CME possono interrompersi a metà sessione. Le commissioni sui dati di borsa si sommano al suo piano Sierra Chart e gli importi esatti variano in base alla borsa e al fatto che lei si qualifichi come non professionista, quindi controlli le tariffe attuali prima di impegnarsi." },
      ],
    },
    { type: "heading",text: "Se la sua società non fornisce le credenziali CQG" },
    { type: "paragraph",html: "Molti conti Tradovate e di prop firm non ottengono mai l'accesso a CQG, quindi tenga a mente due alternative. L'instradamento ordini Teton di Sierra Chart è un servizio di instradamento futures a costo zero che si abbina allo stesso feed dati Denali ed elimina del tutto il problema della connettività con il broker. Rithmic è l'altra strada comune ed è comoda se gestisce più conti prop, perché può collegarli tramite un'unica connessione Rithmic, anche se i suoi dati storici sono più limitati. Entrambe si appoggiano comunque a Denali per i dati CME, quindi quella parte non cambia in nessun caso. Le regole delle prop firm su connessioni e dati sono stabilite dalla società, quindi verifichi che cosa consentono realmente il suo piano e la dimensione del suo conto prima di costruirci sopra un flusso di lavoro." },
    { type: "heading",text: "Automatizzi tutto questo con PickMyTrade" },
    { type: "paragraph",html: "Se il suo obiettivo reale è automatizzare gli ordini Tradovate e non fare charting in Sierra Chart, non le serve nulla di tutto questo. <strong class='text-white'>PickMyTrade instrada i suoi segnali di TradingView direttamente a Tradovate</strong>, senza credenziali CQG né pacchetti dati aggiuntivi da gestire." },
    { type: "paragraph",html: "Molti trader saltano del tutto il percorso Sierra Chart: collegano Tradovate a TradingView per il charting e poi automatizzano gli ordini con i webhook. Se il charting in Sierra Chart non è un requisito imprescindibile, quella strada è molto meno fragile che inseguire le credenziali CQG." },
  ] },
  ctaHeading: { en: "Skip the CQG Credentials Entirely", de: "Ganz ohne CQG-Zugangsdaten", es: "Olvídese por completo de las credenciales de CQG", fr: "Oubliez complètement les identifiants CQG", it: "Rinunci del tutto alle credenziali CQG" },
  ctaText: { en: "If your real goal is automating Tradovate orders rather than charting inside Sierra Chart, PickMyTrade routes your TradingView signals straight to Tradovate, no CQG credentials or extra data package to wrangle.", de: "Wenn Ihr eigentliches Ziel die Automatisierung von Tradovate-Orders ist und nicht das Charting in Sierra Chart, leitet PickMyTrade Ihre TradingView-Signale direkt an Tradovate weiter – ohne CQG-Zugangsdaten und ohne zusätzliches Datenpaket.", es: "Si su objetivo real es automatizar órdenes de Tradovate y no graficar dentro de Sierra Chart, PickMyTrade envía sus señales de TradingView directamente a Tradovate, sin credenciales de CQG ni paquetes de datos adicionales de los que preocuparse.", fr: "Si votre objectif réel est d'automatiser les ordres Tradovate plutôt que de faire des graphiques dans Sierra Chart, PickMyTrade achemine vos signaux TradingView directement vers Tradovate, sans identifiants CQG ni forfait de données supplémentaire à gérer.", it: "Se il suo obiettivo reale è automatizzare gli ordini Tradovate e non fare charting in Sierra Chart, PickMyTrade instrada i suoi segnali di TradingView direttamente a Tradovate, senza credenziali CQG né pacchetti dati aggiuntivi da gestire." },
  ctaButtonText: { en: "Start Your Free 7-Day Trial", de: "Starten Sie Ihre kostenlose 7-Tage-Testphase", es: "Comience su prueba gratuita de 7 días", fr: "Commencez votre essai gratuit de 7 jours", it: "Inizi la prova gratuita di 7 giorni" },
  ctaUrl: "https://app.pickmytrade.trade/?register=true&utm_source=content&utm_medium=how-to",
  faqHeading: { en: "Frequently Asked Questions", de: "Häufig gestellte Fragen", es: "Preguntas frecuentes", fr: "Questions fréquentes", it: "Domande frequenti" },
  faqs: { en: [], de: [], es: [], fr: [], it: [] },
  relatedHeading: { en: "Related Guides", de: "Verwandte Anleitungen", es: "Guías relacionadas", fr: "Guides associés", it: "Guide correlate" },
  disclosureText: { en: `This guide is for educational and informational purposes only and is not financial, investment, or trading advice. Trading futures and other leveraged products carries a substantial risk of loss and is not suitable for every investor. PickMyTrade is an independent third-party automation platform and is not affiliated with, endorsed by, or sponsored by Tradovate, Inc. "Tradovate" and all related names, logos, and trademarks are the property of their respective owners. Platform features and steps change over time, so always confirm the current process in the official Tradovate platform and documentation before acting.`, de: "Diese Anleitung dient ausschließlich Bildungs- und Informationszwecken und stellt keine Finanz-, Anlage- oder Handelsberatung dar. Der Handel mit Futures und anderen gehebelten Produkten birgt ein erhebliches Verlustrisiko und ist nicht für jeden Anleger geeignet. PickMyTrade ist eine unabhängige Automatisierungsplattform eines Drittanbieters und steht in keiner Verbindung zu Tradovate, Inc., wird von dieser weder unterstützt noch gesponsert. „Tradovate“ sowie alle zugehörigen Namen, Logos und Marken sind Eigentum ihrer jeweiligen Inhaber. Funktionen und Schritte der Plattform ändern sich im Laufe der Zeit. Bestätigen Sie daher stets den aktuellen Ablauf in der offiziellen Tradovate-Plattform und -Dokumentation, bevor Sie handeln.", es: "Esta guía tiene fines exclusivamente educativos e informativos y no constituye asesoramiento financiero, de inversión ni de trading. Operar con futuros y otros productos apalancados conlleva un riesgo sustancial de pérdida y no es adecuado para todos los inversores. PickMyTrade es una plataforma de automatización independiente de terceros y no está afiliada, respaldada ni patrocinada por Tradovate, Inc. «Tradovate» y todos los nombres, logotipos y marcas relacionados son propiedad de sus respectivos titulares. Las funciones y los pasos de la plataforma cambian con el tiempo, por lo que debe confirmar siempre el proceso vigente en la plataforma y la documentación oficiales de Tradovate antes de actuar.", fr: "Ce guide est fourni à des fins éducatives et informatives uniquement et ne constitue pas un conseil financier, d'investissement ou de trading. Le trading de contrats à terme et d'autres produits à effet de levier comporte un risque de perte important et ne convient pas à tous les investisseurs. PickMyTrade est une plateforme d'automatisation tierce indépendante et n'est ni affiliée à Tradovate, Inc., ni approuvée ou parrainée par cette dernière. « Tradovate » ainsi que tous les noms, logos et marques associés sont la propriété de leurs détenteurs respectifs. Les fonctionnalités et les étapes de la plateforme évoluent avec le temps ; vérifiez donc toujours la procédure actuelle dans la plateforme et la documentation officielles de Tradovate avant d'agir.", it: "Questa guida ha esclusivamente scopo educativo e informativo e non costituisce consulenza finanziaria, di investimento o di trading. Il trading di futures e di altri prodotti a leva comporta un rischio sostanziale di perdita e non è adatto a tutti gli investitori. PickMyTrade è una piattaforma di automazione indipendente di terze parti e non è affiliata, approvata né sponsorizzata da Tradovate, Inc. «Tradovate» e tutti i nomi, loghi e marchi correlati sono di proprietà dei rispettivi titolari. Le funzionalità e i passaggi della piattaforma cambiano nel tempo, pertanto verifichi sempre la procedura attuale nella piattaforma e nella documentazione ufficiali di Tradovate prima di agire." },
