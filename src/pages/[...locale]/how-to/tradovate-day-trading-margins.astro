---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "tradovate-day-trading-margins";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/how-to/${SLUG}`;

const META_TITLE = "Tradovate Intraday Margins by Contract Type";
const META_DESCRIPTION =
  "Day trading margins by futures contract type, standard E-minis, micros, smalls and nanos, plus how reduced intraday margins and hours actually work.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Tradovate-Intraday-Margins nach Kontrakttyp", es: "Márgenes intradía de Tradovate por tipo de contrato", fr: "Marges intraday Tradovate par type de contrat", it: "Margini intraday di Tradovate per tipo di contratto" },
  dek: { en: "Tradovate runs two margin figures on every contract: a reduced day (intraday) margin while the session is open, and a higher initial margin near the close and overnight. Here's how those break down by contract type, and how to pull the exact number for your symbol.", de: "Tradovate führt für jeden Kontrakt zwei Margin-Werte: eine reduzierte Day-(Intraday-)Margin, solange die Sitzung offen ist, und eine höhere Initial Margin kurz vor dem Handelsschluss und über Nacht. So gliedern sie sich nach Kontrakttyp, und so rufen Sie den genauen Wert für Ihr Symbol ab.", es: "Tradovate maneja dos cifras de margen en cada contrato: un margen diario (intradía) reducido mientras la sesión está abierta y un margen inicial más alto cerca del cierre y durante la noche. Así se desglosan por tipo de contrato y así puede obtener la cifra exacta de su símbolo.", fr: "Tradovate applique deux chiffres de marge à chaque contrat : une marge day (intraday) réduite pendant que la session est ouverte et une marge initiale plus élevée près de la clôture et pendant la nuit. Voici comment elles se répartissent par type de contrat, et comment obtenir le chiffre exact pour votre symbole.", it: "Tradovate applica due valori di margine a ogni contratto: un margine day (intraday) ridotto mentre la sessione è aperta e un margine iniziale più alto in prossimità della chiusura e durante la notte. Ecco come si ripartiscono per tipo di contratto e come ottenere il valore esatto per il Suo simbolo." },
  readTime: { en: "5 min read", de: "5 Min. Lesezeit", es: "Lectura de 5 min", fr: "Lecture : 5 min", it: "Lettura di 5 min" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "Margin is the cash your broker parks against an open futures position. The smaller that number, the more contracts your account can carry, which is exactly why day traders pay attention to it. Tradovate runs two margin figures on every contract: a reduced <strong class='text-white'>day (intraday) margin</strong> while the session is open, and a higher <strong class='text-white'>initial margin</strong> near the close and for anything you hold overnight. Here's how those break down by contract type, and how to pull the exact number for the symbol you actually trade." },
    { type: "heading", text: "Day Margin vs Initial Margin" },
    { type: "paragraph", html: "Two numbers, two situations." },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Day (intraday) margin</strong> is the reduced amount required while you trade inside the session. It's what gives micros and smalls their appeal, you can scale in and out without tying up much capital.",
        "<strong class='text-white'>Initial margin</strong> is the full requirement. It applies around the daily close and to any position you carry overnight.",
      ],
    },
    { type: "paragraph", html: "Reduced day margins run roughly 6:00 PM ET to 4:45 PM ET. From 4:45 PM to 5:00 PM ET, and any time you're holding into the close, the account is held to the higher initial margin instead. Plan for that jump if you swing past the session. Getting caught short of initial margin at the close is a fast way to <a href='https://pickmytrade.trade/debugging/position-auto-closed-5pm-overnight-margin/'>have a position closed on you automatically</a>." },
    { type: "heading", text: "Intraday Margins by Contract Type" },
    { type: "paragraph", html: "These are the starting day-trading margins Tradovate advertises. Treat them as a floor, the exact figure depends on the specific contract and can move (more on that below)." },
    { type: "table", headers: ["Contract type", "Example symbols", "Day trading margin (from)"], rows: [
      ["Standard futures", "ES, NQ, YM, RTY, CL, GC", "~$500"],
      ["Micro E-minis", "MES, MNQ, MYM, M2K", "~$50"],
      ["Smalls", "Select small-sized contracts", "~$25"],
      ["Nano", "Nano-sized contracts", "from ~$10"],
    ] },
    { type: "paragraph", html: "So a standard E-mini S&amp;P (ES) needs around $500 to day-trade one contract, while its micro cousin (MES) needs roughly $50. The micro is one-tenth the size, and the margin scales down with it, same trade idea, a tenth of the capital tied up per contract. When you're weighing which size to trade, margin is only half the math; pair it with the <a href='https://pickmytrade.trade/how-to/tradovate-commission-rates/'>commission difference between micros and minis</a> to see the real cost per trade." },
    { type: "heading", text: "How to Check the Exact Day Margin for Any Contract" },
    { type: "paragraph", html: "Advertised numbers are a starting point. The live figure for your contract sits in Tradovate's margins list, which shows a <strong class='text-white'>Day</strong> column and an <strong class='text-white'>Initial</strong> column side by side for every symbol." },
    {
      type: "steps",
      items: [
        { title: "Open the Margins List", html: "Head to Tradovate's margins page, or the margin/product info panel inside the platform. You'll see a table with a row per contract and columns for the symbol, exchange, day margin, and initial margin." },
        { title: "Find Your Contract's Symbol", html: "Search or scroll to the exact symbol you trade, MNQ for the Micro Nasdaq, ES for the standard S&amp;P, and so on. Match the specific contract month, not a generic root, so the number you read is the one that'll actually apply to your order." },
        { title: "Read Day Against Initial", html: "The Day column is your reduced intraday requirement. The Initial column is what you'll owe near the close and overnight. The gap between the two is exactly what changes the moment you decide to hold rather than flatten. If an entry gets knocked back, that gap is often the reason, see how to clear an <a href='https://pickmytrade.trade/debugging/order-rejected-insufficient-margin/'>insufficient margin rejection</a>." },
        { title: "Check for Margin-Change Notices", html: "Around major economic releases, Tradovate can raise margins temporarily. Before you hold through news or into the close, confirm the current figure rather than trusting what it was yesterday. A margin that doubles right as a report drops can flip a comfortable position into a shortfall in seconds." },
      ],
    },
    { type: "heading", text: "Prop-Firm Accounts Work Differently" },
    { type: "paragraph", html: "If you're trading a funded or evaluation account through a prop firm, these broker margins aren't the whole story. Your firm layers its own margin, max-position, and risk rules on top of the platform, and those vary by firm and account size. Check your firm's current rules before you size a trade, because the number in the margins table may not be the limit that actually stops you out." },
    { type: "heading", text: "Automate This with PickMyTrade" },
    { type: "paragraph", html: "Running a strategy that fires orders faster than you can size them by hand? <strong class='text-white'>PickMyTrade routes your TradingView alerts straight to Tradovate</strong>, so your automation places trades on the buying power you'd manage manually." },
  ], de: [
    { type: "paragraph",html: "Die Margin ist das Guthaben, das Ihr Broker gegen eine offene Futures-Position zurückhält. Je kleiner dieser Betrag, desto mehr Kontrakte kann Ihr Konto halten, weshalb Daytrader genau darauf achten. Tradovate führt für jeden Kontrakt zwei Margin-Werte: eine reduzierte <strong class='text-white'>Day-(Intraday-)Margin</strong>, solange die Sitzung offen ist, und eine höhere <strong class='text-white'>Initial Margin</strong> kurz vor dem Handelsschluss und für alles, was Sie über Nacht halten. So gliedern sie sich nach Kontrakttyp, und so rufen Sie den genauen Wert für das Symbol ab, das Sie tatsächlich handeln." },
    { type: "heading",text: "Day Margin vs. Initial Margin" },
    { type: "paragraph",html: "Zwei Werte, zwei Situationen." },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Die Day-(Intraday-)Margin</strong> ist der reduzierte Betrag, der erforderlich ist, solange Sie innerhalb der Sitzung handeln. Sie macht Micros und Smalls so attraktiv, denn Sie können ein- und aussteigen, ohne viel Kapital zu binden.",
        "<strong class='text-white'>Die Initial Margin</strong> ist die volle Anforderung. Sie gilt rund um den Handelsschluss und für jede Position, die Sie über Nacht halten.",
      ],
    },
    { type: "paragraph",html: "Die reduzierten Day-Margins gelten ungefähr von 6:00 PM ET bis 4:45 PM ET. Von 4:45 PM bis 5:00 PM ET und immer dann, wenn Sie in den Handelsschluss hinein halten, gilt für das Konto stattdessen die höhere Initial Margin. Planen Sie diesen Sprung ein, wenn Sie über die Sitzung hinaus halten. Wer beim Handelsschluss die Initial Margin nicht erfüllt, riskiert schnell, dass <a href='https://pickmytrade.trade/debugging/position-auto-closed-5pm-overnight-margin/'>eine Position automatisch geschlossen wird</a>." },
    { type: "heading",text: "Intraday-Margins nach Kontrakttyp" },
    { type: "paragraph",html: "Dies sind die Day-Trading-Margins, mit denen Tradovate Einstiegswerte bewirbt. Betrachten Sie sie als Untergrenze, der genaue Wert hängt vom jeweiligen Kontrakt ab und kann sich ändern (dazu unten mehr)." },
    { type: "table", headers: ["Kontrakttyp","Beispielsymbole","Day-Trading-Margin (ab)"], rows: [
      ["Standard-Futures","ES, NQ, YM, RTY, CL, GC","~$500"],
      ["Micro E-minis","MES, MNQ, MYM, M2K","~$50"],
      ["Smalls","Ausgewählte kleine Kontrakte","~$25"],
      ["Nano","Nano-Kontrakte","ab ~$10"],
    ] },
    { type: "paragraph",html: "Ein Standard-E-mini-S&amp;P (ES) benötigt also etwa $500, um einen Kontrakt im Daytrading zu handeln, während sein Micro-Gegenstück (MES) etwa $50 braucht. Der Micro ist ein Zehntel so groß, und die Margin skaliert entsprechend nach unten: dieselbe Trade-Idee, ein Zehntel des pro Kontrakt gebundenen Kapitals. Wenn Sie abwägen, welche Größe Sie handeln, ist die Margin nur die halbe Rechnung. Ergänzen Sie sie um den <a href='https://pickmytrade.trade/how-to/tradovate-commission-rates/'>Provisionsunterschied zwischen Micros und Minis</a>, um die tatsächlichen Kosten pro Trade zu sehen." },
    { type: "heading",text: "So prüfen Sie die genaue Day Margin für jeden Kontrakt" },
    { type: "paragraph",html: "Die angegebenen Zahlen sind ein Ausgangspunkt. Der aktuelle Wert für Ihren Kontrakt steht in der Margin-Liste von Tradovate, die für jedes Symbol eine Spalte <strong class='text-white'>Day</strong> und eine Spalte <strong class='text-white'>Initial</strong> nebeneinander zeigt." },
    {
      type: "steps",
      items: [
        { title: "Margin-Liste öffnen", html: "Rufen Sie die Margin-Seite von Tradovate oder das Margin-/Produktinfo-Fenster in der Plattform auf. Sie sehen eine Tabelle mit einer Zeile pro Kontrakt und Spalten für Symbol, Börse, Day Margin und Initial Margin." },
        { title: "Symbol Ihres Kontrakts finden", html: "Suchen oder scrollen Sie zum genauen Symbol, das Sie handeln, MNQ für den Micro Nasdaq, ES für den Standard-S&amp;P und so weiter. Wählen Sie den konkreten Kontraktmonat, nicht das allgemeine Stammsymbol, damit die gelesene Zahl diejenige ist, die tatsächlich für Ihre Order gilt." },
        { title: "Day und Initial vergleichen", html: "Die Spalte Day ist Ihre reduzierte Intraday-Anforderung. Die Spalte Initial ist das, was Sie kurz vor dem Handelsschluss und über Nacht schulden. Die Differenz zwischen beiden ändert sich genau in dem Moment, in dem Sie sich entscheiden, zu halten statt glattzustellen. Wird ein Einstieg abgelehnt, ist diese Differenz oft der Grund. Lesen Sie, wie Sie eine <a href='https://pickmytrade.trade/debugging/order-rejected-insufficient-margin/'>Ablehnung wegen unzureichender Margin</a> beheben." },
        { title: "Auf Margin-Änderungshinweise achten", html: "Rund um wichtige Wirtschaftsdaten kann Tradovate die Margins vorübergehend erhöhen. Bevor Sie über Nachrichten oder in den Handelsschluss hinein halten, prüfen Sie den aktuellen Wert, statt sich auf den von gestern zu verlassen. Eine Margin, die sich genau dann verdoppelt, wenn ein Bericht erscheint, kann eine komfortable Position in Sekunden in eine Unterdeckung verwandeln." },
      ],
    },
    { type: "heading",text: "Prop-Firm-Konten funktionieren anders" },
    { type: "paragraph",html: "Wenn Sie ein finanziertes oder Evaluierungskonto über eine Prop Firm handeln, sind diese Broker-Margins nicht die ganze Geschichte. Ihre Firma legt eigene Margin-, Maximalpositions- und Risikoregeln über die Plattform, und diese variieren je nach Firma und Kontogröße. Prüfen Sie die aktuellen Regeln Ihrer Firma, bevor Sie einen Trade dimensionieren, denn die Zahl in der Margin-Tabelle ist möglicherweise nicht das Limit, das Sie tatsächlich ausstoppt." },
    { type: "heading",text: "Automatisieren Sie dies mit PickMyTrade" },
    { type: "paragraph",html: "Sie führen eine Strategie aus, die Orders schneller auslöst, als Sie sie von Hand dimensionieren können? <strong class='text-white'>PickMyTrade leitet Ihre TradingView-Alerts direkt an Tradovate weiter</strong>, sodass Ihre Automatisierung Trades mit der Kaufkraft platziert, die Sie sonst manuell verwalten würden." },
  ], es: [
    { type: "paragraph",html: "El margen es el efectivo que su bróker retiene frente a una posición abierta de futuros. Cuanto menor es esa cifra, más contratos puede mantener su cuenta, y por eso los day traders le prestan atención. Tradovate maneja dos cifras de margen en cada contrato: un <strong class='text-white'>margen diario (intradía)</strong> reducido mientras la sesión está abierta y un <strong class='text-white'>margen inicial</strong> más alto cerca del cierre y para todo lo que mantenga durante la noche. Así se desglosan por tipo de contrato y así puede obtener la cifra exacta del símbolo que realmente opera." },
    { type: "heading",text: "Margen diario frente a margen inicial" },
    { type: "paragraph",html: "Dos cifras, dos situaciones." },
    {
      type: "list",
      items: [
        "<strong class='text-white'>El margen diario (intradía)</strong> es el importe reducido que se exige mientras opera dentro de la sesión. Es lo que hace atractivos a los micros y los smalls: puede entrar y salir sin inmovilizar mucho capital.",
        "<strong class='text-white'>El margen inicial</strong> es el requisito completo. Se aplica alrededor del cierre diario y a cualquier posición que mantenga durante la noche.",
      ],
    },
    { type: "paragraph",html: "Los márgenes diarios reducidos rigen aproximadamente de 6:00 PM ET a 4:45 PM ET. De 4:45 PM a 5:00 PM ET, y siempre que mantenga posiciones hacia el cierre, la cuenta queda sujeta al margen inicial más alto. Cuente con ese salto si mantiene posiciones más allá de la sesión. Quedarse corto del margen inicial al cierre es una forma rápida de que <a href='https://pickmytrade.trade/debugging/position-auto-closed-5pm-overnight-margin/'>le cierren una posición automáticamente</a>." },
    { type: "heading",text: "Márgenes intradía por tipo de contrato" },
    { type: "paragraph",html: "Estos son los márgenes iniciales de day trading que anuncia Tradovate. Considérelos un mínimo: la cifra exacta depende del contrato concreto y puede variar (más sobre esto abajo)." },
    { type: "table", headers: ["Tipo de contrato","Símbolos de ejemplo","Margen de day trading (desde)"], rows: [
      ["Futuros estándar","ES, NQ, YM, RTY, CL, GC","~$500"],
      ["Micro E-minis","MES, MNQ, MYM, M2K","~$50"],
      ["Smalls","Contratos de tamaño pequeño seleccionados","~$25"],
      ["Nano","Contratos de tamaño nano","desde ~$10"],
    ] },
    { type: "paragraph",html: "Así, un E-mini S&amp;P estándar (ES) necesita alrededor de $500 para operar un contrato en day trading, mientras que su primo micro (MES) necesita aproximadamente $50. El micro es una décima parte del tamaño y el margen se reduce en proporción: la misma idea de trade, una décima parte del capital inmovilizado por contrato. Al decidir qué tamaño operar, el margen es solo la mitad de la cuenta; combínelo con la <a href='https://pickmytrade.trade/how-to/tradovate-commission-rates/'>diferencia de comisiones entre micros y minis</a> para ver el coste real por operación." },
    { type: "heading",text: "Cómo consultar el margen diario exacto de cualquier contrato" },
    { type: "paragraph",html: "Las cifras anunciadas son un punto de partida. La cifra real de su contrato está en la lista de márgenes de Tradovate, que muestra una columna <strong class='text-white'>Day</strong> y una columna <strong class='text-white'>Initial</strong> una junto a la otra para cada símbolo." },
    {
      type: "steps",
      items: [
        { title: "Abra la lista de márgenes", html: "Vaya a la página de márgenes de Tradovate o al panel de información de márgenes/productos dentro de la plataforma. Verá una tabla con una fila por contrato y columnas para el símbolo, el mercado, el margen diario y el margen inicial." },
        { title: "Encuentre el símbolo de su contrato", html: "Busque o desplácese hasta el símbolo exacto que opera, MNQ para el Micro Nasdaq, ES para el S&amp;P estándar, etc. Elija el mes de contrato concreto, no una raíz genérica, para que la cifra que lea sea la que realmente se aplicará a su orden." },
        { title: "Compare Day con Initial", html: "La columna Day es su requisito intradía reducido. La columna Initial es lo que deberá cerca del cierre y durante la noche. La diferencia entre ambas es justo lo que cambia en el momento en que decide mantener en lugar de cerrar. Si una entrada es rechazada, esa diferencia suele ser el motivo; vea cómo resolver un <a href='https://pickmytrade.trade/debugging/order-rejected-insufficient-margin/'>rechazo por margen insuficiente</a>." },
        { title: "Compruebe los avisos de cambio de margen", html: "Alrededor de publicaciones económicas importantes, Tradovate puede subir los márgenes temporalmente. Antes de mantener posiciones durante noticias o hasta el cierre, confirme la cifra actual en lugar de fiarse de la de ayer. Un margen que se duplica justo cuando sale un informe puede convertir una posición holgada en un déficit en cuestión de segundos." },
      ],
    },
    { type: "heading",text: "Las cuentas de prop firm funcionan de otra manera" },
    { type: "paragraph",html: "Si opera una cuenta financiada o de evaluación a través de una prop firm, estos márgenes del bróker no son toda la historia. Su firma añade sus propias reglas de margen, posición máxima y riesgo por encima de la plataforma, y estas varían según la firma y el tamaño de la cuenta. Consulte las reglas vigentes de su firma antes de dimensionar una operación, porque la cifra de la tabla de márgenes puede no ser el límite que realmente le saque del mercado." },
    { type: "heading",text: "Automatice esto con PickMyTrade" },
    { type: "paragraph",html: "¿Ejecuta una estrategia que lanza órdenes más rápido de lo que puede dimensionarlas a mano? <strong class='text-white'>PickMyTrade envía sus alertas de TradingView directamente a Tradovate</strong>, de modo que su automatización coloca operaciones con el poder de compra que usted gestionaría manualmente." },
  ], fr: [
    { type: "paragraph",html: "La marge est la somme que votre courtier immobilise en regard d'une position ouverte sur futures. Plus ce montant est faible, plus votre compte peut porter de contrats, ce qui explique pourquoi les day traders y prêtent attention. Tradovate applique deux chiffres de marge à chaque contrat : une <strong class='text-white'>marge day (intraday)</strong> réduite pendant que la session est ouverte et une <strong class='text-white'>marge initiale</strong> plus élevée près de la clôture et pour tout ce que vous conservez pendant la nuit. Voici comment elles se répartissent par type de contrat, et comment obtenir le chiffre exact pour le symbole que vous tradez réellement." },
    { type: "heading",text: "Marge day et marge initiale" },
    { type: "paragraph",html: "Deux chiffres, deux situations." },
    {
      type: "list",
      items: [
        "<strong class='text-white'>La marge day (intraday)</strong> est le montant réduit exigé lorsque vous tradez pendant la session. C'est ce qui fait l'attrait des micros et des smalls : vous pouvez entrer et sortir sans immobiliser beaucoup de capital.",
        "<strong class='text-white'>La marge initiale</strong> est l'exigence complète. Elle s'applique autour de la clôture quotidienne et à toute position conservée pendant la nuit.",
      ],
    },
    { type: "paragraph",html: "Les marges day réduites s'appliquent environ de 6:00 PM ET à 4:45 PM ET. De 4:45 PM à 5:00 PM ET, et chaque fois que vous conservez une position jusqu'à la clôture, le compte est soumis à la marge initiale plus élevée. Anticipez ce saut si vous conservez vos positions au-delà de la session. Manquer de marge initiale à la clôture est un moyen rapide de <a href='https://pickmytrade.trade/debugging/position-auto-closed-5pm-overnight-margin/'>voir une position fermée automatiquement</a>." },
    { type: "heading",text: "Marges intraday par type de contrat" },
    { type: "paragraph",html: "Voici les marges de day trading de départ affichées par Tradovate. Considérez-les comme un plancher : le chiffre exact dépend du contrat concerné et peut évoluer (plus d'informations ci-dessous)." },
    { type: "table", headers: ["Type de contrat","Symboles d'exemple","Marge de day trading (à partir de)"], rows: [
      ["Futures standard","ES, NQ, YM, RTY, CL, GC","~$500"],
      ["Micro E-minis","MES, MNQ, MYM, M2K","~$50"],
      ["Smalls","Certains contrats de petite taille","~$25"],
      ["Nano","Contrats de taille nano","à partir de ~$10"],
    ] },
    { type: "paragraph",html: "Ainsi, un E-mini S&amp;P standard (ES) nécessite environ $500 pour trader un contrat en day trading, tandis que son cousin micro (MES) en demande environ $50. Le micro est dix fois plus petit et la marge diminue en proportion : même idée de trade, un dixième du capital immobilisé par contrat. Lorsque vous choisissez la taille à trader, la marge ne représente que la moitié du calcul ; associez-la à la <a href='https://pickmytrade.trade/how-to/tradovate-commission-rates/'>différence de commissions entre micros et minis</a> pour connaître le coût réel par trade." },
    { type: "heading",text: "Comment vérifier la marge day exacte de n'importe quel contrat" },
    { type: "paragraph",html: "Les chiffres affichés ne sont qu'un point de départ. Le chiffre en vigueur pour votre contrat figure dans la liste des marges de Tradovate, qui présente côte à côte une colonne <strong class='text-white'>Day</strong> et une colonne <strong class='text-white'>Initial</strong> pour chaque symbole." },
    {
      type: "steps",
      items: [
        { title: "Ouvrir la liste des marges", html: "Rendez-vous sur la page des marges de Tradovate, ou sur le panneau d'informations marges/produits dans la plateforme. Vous verrez un tableau avec une ligne par contrat et des colonnes pour le symbole, la bourse, la marge day et la marge initiale." },
        { title: "Trouver le symbole de votre contrat", html: "Recherchez ou faites défiler jusqu'au symbole exact que vous tradez, MNQ pour le Micro Nasdaq, ES pour le S&amp;P standard, etc. Sélectionnez le mois de contrat précis, et non une racine générique, afin que le chiffre lu soit celui qui s'appliquera réellement à votre ordre." },
        { title: "Comparer Day et Initial", html: "La colonne Day correspond à votre exigence intraday réduite. La colonne Initial correspond à ce que vous devrez près de la clôture et pendant la nuit. L'écart entre les deux est précisément ce qui change dès que vous décidez de conserver plutôt que de solder. Si une entrée est rejetée, cet écart en est souvent la raison ; voyez comment résoudre un <a href='https://pickmytrade.trade/debugging/order-rejected-insufficient-margin/'>rejet pour marge insuffisante</a>." },
        { title: "Vérifier les avis de changement de marge", html: "Autour des grandes publications économiques, Tradovate peut relever temporairement les marges. Avant de conserver une position pendant des annonces ou jusqu'à la clôture, confirmez le chiffre actuel plutôt que de vous fier à celui d'hier. Une marge qui double au moment même où un rapport est publié peut transformer une position confortable en insuffisance en quelques secondes." },
      ],
    },
    { type: "heading",text: "Les comptes de prop firm fonctionnent différemment" },
    { type: "paragraph",html: "Si vous tradez un compte financé ou d'évaluation via une prop firm, ces marges du courtier ne disent pas tout. Votre société superpose ses propres règles de marge, de position maximale et de risque à la plateforme, et celles-ci varient selon la société et la taille du compte. Vérifiez les règles en vigueur de votre société avant de dimensionner un trade, car le chiffre du tableau des marges n'est peut-être pas la limite qui vous arrêtera réellement." },
    { type: "heading",text: "Automatisez cela avec PickMyTrade" },
    { type: "paragraph",html: "Vous exécutez une stratégie qui envoie des ordres plus vite que vous ne pouvez les dimensionner à la main ? <strong class='text-white'>PickMyTrade achemine vos alertes TradingView directement vers Tradovate</strong>, de sorte que votre automatisation place des trades avec le pouvoir d'achat que vous géreriez manuellement." },
  ], it: [
    { type: "paragraph",html: "Il margine è il denaro che il Suo broker accantona a fronte di una posizione aperta sui futures. Più è basso, più contratti il Suo conto può sostenere, ed è per questo che i day trader vi prestano attenzione. Tradovate applica due valori di margine a ogni contratto: un <strong class='text-white'>margine day (intraday)</strong> ridotto mentre la sessione è aperta e un <strong class='text-white'>margine iniziale</strong> più alto in prossimità della chiusura e per tutto ciò che mantiene durante la notte. Ecco come si ripartiscono per tipo di contratto e come ottenere il valore esatto per il simbolo che negozia davvero." },
    { type: "heading",text: "Margine day vs margine iniziale" },
    { type: "paragraph",html: "Due valori, due situazioni." },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Il margine day (intraday)</strong> è l'importo ridotto richiesto mentre negozia all'interno della sessione. È ciò che rende attraenti micro e small: può entrare e uscire senza immobilizzare molto capitale.",
        "<strong class='text-white'>Il margine iniziale</strong> è il requisito pieno. Si applica intorno alla chiusura giornaliera e a qualsiasi posizione mantenuta durante la notte.",
      ],
    },
    { type: "paragraph",html: "I margini day ridotti valgono all'incirca dalle 6:00 PM ET alle 4:45 PM ET. Dalle 4:45 PM alle 5:00 PM ET, e ogni volta che mantiene posizioni fino alla chiusura, il conto è soggetto al margine iniziale più alto. Metta in conto questo salto se mantiene posizioni oltre la sessione. Non avere abbastanza margine iniziale alla chiusura è un modo rapido per <a href='https://pickmytrade.trade/debugging/position-auto-closed-5pm-overnight-margin/'>vedersi chiudere una posizione automaticamente</a>." },
    { type: "heading",text: "Margini intraday per tipo di contratto" },
    { type: "paragraph",html: "Questi sono i margini di day trading di partenza pubblicizzati da Tradovate. Li consideri un minimo: il valore esatto dipende dallo specifico contratto e può cambiare (ne parliamo sotto)." },
    { type: "table", headers: ["Tipo di contratto","Simboli di esempio","Margine di day trading (da)"], rows: [
      ["Futures standard","ES, NQ, YM, RTY, CL, GC","~$500"],
      ["Micro E-minis","MES, MNQ, MYM, M2K","~$50"],
      ["Smalls","Alcuni contratti di dimensione ridotta","~$25"],
      ["Nano","Contratti di dimensione nano","da ~$10"],
    ] },
    { type: "paragraph",html: "Quindi un E-mini S&amp;P standard (ES) richiede circa $500 per fare day trading su un contratto, mentre il suo cugino micro (MES) ne richiede circa $50. Il micro è un decimo della dimensione e il margine scala di conseguenza: stessa idea di trade, un decimo del capitale immobilizzato per contratto. Quando valuta quale dimensione negoziare, il margine è solo metà del calcolo; lo abbini alla <a href='https://pickmytrade.trade/how-to/tradovate-commission-rates/'>differenza di commissioni tra micro e mini</a> per vedere il costo reale per trade." },
    { type: "heading",text: "Come verificare il margine day esatto per qualsiasi contratto" },
    { type: "paragraph",html: "I valori pubblicizzati sono un punto di partenza. Il valore reale del Suo contratto si trova nell'elenco dei margini di Tradovate, che mostra affiancate una colonna <strong class='text-white'>Day</strong> e una colonna <strong class='text-white'>Initial</strong> per ogni simbolo." },
    {
      type: "steps",
      items: [
        { title: "Aprire l'elenco dei margini", html: "Vada alla pagina dei margini di Tradovate o al pannello informazioni margini/prodotti all'interno della piattaforma. Vedrà una tabella con una riga per contratto e colonne per simbolo, borsa, margine day e margine iniziale." },
        { title: "Trovare il simbolo del Suo contratto", html: "Cerchi o scorra fino al simbolo esatto che negozia, MNQ per il Micro Nasdaq, ES per lo S&amp;P standard e così via. Selezioni lo specifico mese di scadenza, non una radice generica, così il valore che legge è quello che si applicherà davvero al Suo ordine." },
        { title: "Confrontare Day e Initial", html: "La colonna Day è il Suo requisito intraday ridotto. La colonna Initial è ciò che dovrà in prossimità della chiusura e durante la notte. La differenza tra le due è esattamente ciò che cambia nel momento in cui decide di mantenere la posizione anziché chiuderla. Se un'entrata viene respinta, spesso il motivo è proprio questa differenza; veda come risolvere un <a href='https://pickmytrade.trade/debugging/order-rejected-insufficient-margin/'>rifiuto per margine insufficiente</a>." },
        { title: "Controllare gli avvisi di variazione del margine", html: "In occasione di importanti pubblicazioni economiche, Tradovate può alzare temporaneamente i margini. Prima di mantenere posizioni durante le notizie o fino alla chiusura, confermi il valore attuale anziché fidarsi di quello di ieri. Un margine che raddoppia proprio quando esce un report può trasformare una posizione comoda in un ammanco nel giro di pochi secondi." },
      ],
    },
    { type: "heading",text: "I conti prop firm funzionano in modo diverso" },
    { type: "paragraph",html: "Se negozia un conto finanziato o di valutazione tramite una prop firm, questi margini del broker non sono tutta la storia. La Sua società aggiunge le proprie regole di margine, posizione massima e rischio sopra la piattaforma, e queste variano in base alla società e alla dimensione del conto. Verifichi le regole attuali della Sua società prima di dimensionare un trade, perché il numero nella tabella dei margini potrebbe non essere il limite che La fermerà davvero." },
    { type: "heading",text: "Automatizzi tutto questo con PickMyTrade" },
    { type: "paragraph",html: "Esegue una strategia che invia ordini più velocemente di quanto riesca a dimensionarli a mano? <strong class='text-white'>PickMyTrade instrada i Suoi alert di TradingView direttamente a Tradovate</strong>, così la Sua automazione piazza i trade con il potere d'acquisto che gestirebbe manualmente." },
  ] },
  ctaHeading: { en: "Automate Your Tradovate Trades", de: "Automatisieren Sie Ihre Tradovate-Trades", es: "Automatice sus operaciones en Tradovate", fr: "Automatisez vos trades Tradovate", it: "Automatizzi i Suoi trade su Tradovate" },
