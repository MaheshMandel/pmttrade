---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "tradovate-nfa-fee";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/how-to/${SLUG}`;

const META_TITLE = "Tradovate NFA Assessment Fee Per Side";
const META_DESCRIPTION =
  "The NFA assessment fee applies per side to every futures trade. Learn the current per-side rate, why micros pay the same as minis, and how it adds up.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Tradovate NFA-Bearbeitungsgebühr pro Seite", es: "Tarifa de evaluación NFA de Tradovate por lado", fr: "Frais d'évaluation NFA de Tradovate par côté", it: "Commissione di valutazione NFA di Tradovate per lato" },
  dek: { en: "The NFA assessment fee applies per side to every futures trade. Learn the current per-side rate, why micros pay the same as minis, and how it adds up.", de: "Die NFA-Gebühr fällt pro Seite bei jedem Futures-Trade an. Erfahren Sie den aktuellen Satz pro Seite, warum Micros dasselbe zahlen wie Minis und wie sich die Gebühr summiert.", es: "La tarifa de evaluación de la NFA se aplica por lado a cada operación de futuros. Conozca la tarifa vigente por lado, por qué los micros pagan lo mismo que los minis y cómo se acumula.", fr: "Les frais d'évaluation de la NFA s'appliquent par côté à chaque trade de futures. Découvrez le taux actuel par côté, pourquoi les micros paient autant que les minis et comment ces frais s'additionnent.", it: "La commissione di valutazione NFA si applica per lato a ogni trade sui futures. Scopra la tariffa attuale per lato, perché i micro pagano come i mini e come si accumula." },
  readTime: { en: "5 min read", de: "5 Min. Lesezeit", es: "Lectura de 5 min", fr: "Lecture : 5 min", it: "Lettura di 5 min" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "Every futures contract you trade carries a small pass-through charge called the NFA assessment fee. As of 2026 it's <strong class='text-white'>$0.01 per side</strong>, billed by the National Futures Association to your broker, who then passes it on to you. The words \"per side\" are what trip people up: you pay it when you open a position and again when you close, so a single round-turn contract costs $0.02 total. It's nothing on one trade. Scalp micros a hundred times a day and it starts to matter." },
    { type: "heading", text: "What the NFA Assessment Fee Actually Is" },
    { type: "paragraph", html: "The NFA funds part of its operations through this assessment on every futures and options-on-futures transaction that its member firms clear. Your broker, the FCM, doesn't keep a cent of it. It collects the fee and forwards it to the NFA. That's why it shows up as its own line, separate from commission, exchange fees, and clearing fees. It has nothing to do with which plan you're on or how sharp a rate you negotiated. Everyone pays the same NFA fee, from a first-week beginner to a firm trading thousands of lots." },
    { type: "heading", text: "How Much It Costs in 2026" },
    { type: "paragraph", html: "Here's the current schedule. Treat the numbers as a snapshot, because the NFA adjusts the rate every so often based on its budget." },
    {
      type: "table",
      headers: ["Item", "Cost"],
      rows: [
        ["Per side (futures)", "$0.01"],
        ["Round turn, 1 contract (2 sides)", "$0.02"],
        ["Options on futures", "$0.01 per side"],
        ["Scheduled change", "Rises to $0.02 per side on July 1, 2027"],
      ],
    },
    { type: "paragraph", html: "Before you bake any figure into a cost model, confirm the live number on the NFA's published fee schedule. Rates that look permanent have a way of moving." },
    { type: "heading", text: "Micros Pay the Same as Minis" },
    { type: "paragraph", html: "This is the catch that surprises new micro traders. The NFA fee is a flat amount per contract, and it does not scale with contract size. A Micro E-mini like MES or MNQ is charged the same $0.01 per side as its full-size cousin, ES or NQ. On a standard contract that's a rounding error against your commission and exchange costs. On a micro, where your entire edge might be a couple of ticks, a flat fee weighs proportionally much heavier. Round-turn ten micros and that's twenty sides, or $0.20 in NFA fees alone, before commission and exchange charges even enter the picture." },
    { type: "heading", text: "Where to Find the NFA Fee in Tradovate" },
    { type: "paragraph", html: "The NFA fee is usually rolled into the total fees shown on your fills, and itemized on your statement. Here's how to pull it apart." },
    {
      type: "steps",
      items: [
        { title: "Open Your Account Report", html: "From the platform, open the reports or statements area and pull the account report or daily statement for the date range you want to check. This is the same report you'd use to reconcile any trading cost." },
        { title: "Find the NFA Fee in the Fee Breakdown", html: "Fees are itemized in the report. Look for the NFA line sitting alongside the exchange and clearing fees. If your current view only shows one combined \"Fees\" total, open a single fill or order detail to see the split. The NFA fee stacks with the other exchange and clearing fees and with your broker commission, so make sure you're reading the NFA line on its own and not the combined number." },
        { title: "Multiply Your Sides by the Per-Side Rate", html: "Count sides, not trades. Every fill is one side. Multiply your total sides by the current per-side rate and you have your NFA cost for the period. Say you traded 50 round turns of NQ in a day: that's 100 sides, or $1.00 in NFA fees. It's small next to commission, but it's real, and it's the same math whether you trade a full contract or a micro." },
      ],
    },
    { type: "paragraph", html: "The NFA fee is only one slice of your true cost per trade. Your broker commission is the bigger piece, and it does change with your plan, so compare the Tradovate commission rates for micros and minis when you're working out what a strategy really costs to run." },
    { type: "heading", text: "The Short Version" },
    { type: "paragraph", html: "The NFA assessment fee is a flat, per-side, pass-through charge on every futures trade. In 2026 it's $0.01 a side, doubling to $0.02 on July 1, 2027. It doesn't care about contract size, so micros carry the same fee as full-size contracts. Multiply your fills by the current rate, and always confirm the number against the NFA's live schedule before you rely on it." },
    { type: "heading", text: "Automate This with PickMyTrade" },
    { type: "paragraph", html: "Trading a busy strategy from TradingView? Every entry and exit is another side, and those per-side charges add up fast across the day. <strong class='text-white'>PickMyTrade automates your Tradovate orders</strong> and keeps your cost per round turn predictable." },
  ], de: [
    { type: "paragraph",html: "Jeder Futures-Kontrakt, den Sie handeln, ist mit einer kleinen Durchlaufgebühr verbunden, der NFA-Gebühr (NFA assessment fee). Stand 2026 beträgt sie <strong class='text-white'>$0.01 pro Seite</strong>; die National Futures Association stellt sie Ihrem Broker in Rechnung, der sie an Sie weitergibt. Der Begriff „pro Seite“ sorgt häufig für Verwirrung: Sie zahlen die Gebühr beim Eröffnen einer Position und noch einmal beim Schließen, sodass ein einzelner Round-Turn-Kontrakt insgesamt $0.02 kostet. Bei einem einzelnen Trade ist das nichts. Wer jedoch hundertmal am Tag Micros scalpt, spürt es." },
    { type: "heading",text: "Was die NFA-Gebühr eigentlich ist" },
    { type: "paragraph",html: "Die NFA finanziert einen Teil ihres Betriebs über diese Gebühr auf jede Futures- und Optionen-auf-Futures-Transaktion, die ihre Mitgliedsfirmen abwickeln. Ihr Broker, der FCM, behält davon keinen Cent. Er zieht die Gebühr ein und leitet sie an die NFA weiter. Deshalb erscheint sie als eigene Position, getrennt von Provision, Börsengebühren und Clearing-Gebühren. Sie hat nichts damit zu tun, welchen Tarif Sie haben oder wie gut Ihr ausgehandelter Satz ist. Alle zahlen dieselbe NFA-Gebühr, vom Anfänger in der ersten Woche bis zur Firma, die Tausende Lots handelt." },
    { type: "heading",text: "Was sie 2026 kostet" },
    { type: "paragraph",html: "Hier ist der aktuelle Gebührenplan. Betrachten Sie die Zahlen als Momentaufnahme, denn die NFA passt den Satz von Zeit zu Zeit anhand ihres Budgets an." },
    { type: "table", headers: ["Position","Kosten"], rows: [
      ["Pro Seite (Futures)","$0.01"],
      ["Round Turn, 1 Kontrakt (2 Seiten)","$0.02"],
      ["Optionen auf Futures","$0.01 pro Seite"],
      ["Geplante Änderung","Steigt am 1. Juli 2027 auf $0.02 pro Seite"],
    ] },
    { type: "paragraph",html: "Bevor Sie eine Zahl in ein Kostenmodell übernehmen, prüfen Sie den aktuellen Wert im veröffentlichten Gebührenplan der NFA. Sätze, die dauerhaft wirken, ändern sich erfahrungsgemäß gern." },
    { type: "heading",text: "Micros zahlen dasselbe wie Minis" },
    { type: "paragraph",html: "Das überrascht neue Micro-Trader am meisten. Die NFA-Gebühr ist ein fester Betrag pro Kontrakt und skaliert nicht mit der Kontraktgröße. Ein Micro E-mini wie MES oder MNQ zahlt dieselben $0.01 pro Seite wie sein großer Verwandter ES oder NQ. Bei einem Standardkontrakt ist das gegenüber Provision und Börsengebühren eine Rundungsdifferenz. Bei einem Micro, wo Ihr gesamter Vorteil vielleicht nur ein paar Ticks beträgt, wiegt eine feste Gebühr proportional deutlich schwerer. Bei zehn Micros im Round Turn sind das zwanzig Seiten, also allein $0.20 an NFA-Gebühren, noch bevor Provision und Börsengebühren ins Spiel kommen." },
    { type: "heading",text: "Wo Sie die NFA-Gebühr in Tradovate finden" },
    { type: "paragraph",html: "Die NFA-Gebühr ist meist in den Gesamtgebühren Ihrer Ausführungen enthalten und wird in Ihrem Kontoauszug einzeln aufgeführt. So schlüsseln Sie sie auf." },
    {
      type: "steps",
      items: [
        { title: "Kontobericht öffnen", html: "Öffnen Sie in der Plattform den Bereich für Berichte oder Kontoauszüge und rufen Sie den Kontobericht oder den Tagesauszug für den gewünschten Zeitraum ab. Es ist derselbe Bericht, den Sie für den Abgleich jeder Handelskostenposition verwenden würden." },
        { title: "NFA-Gebühr in der Gebührenaufschlüsselung finden", html: "Die Gebühren sind im Bericht einzeln aufgeführt. Suchen Sie die NFA-Zeile neben den Börsen- und Clearing-Gebühren. Wenn Ihre aktuelle Ansicht nur eine zusammengefasste Summe „Fees“ zeigt, öffnen Sie die Details einer einzelnen Ausführung oder Order, um die Aufteilung zu sehen. Die NFA-Gebühr kommt zu den übrigen Börsen- und Clearing-Gebühren und zu Ihrer Broker-Provision hinzu; achten Sie also darauf, die NFA-Zeile für sich zu lesen und nicht die kombinierte Zahl." },
        { title: "Seiten mit dem Satz pro Seite multiplizieren", html: "Zählen Sie Seiten, nicht Trades. Jede Ausführung ist eine Seite. Multiplizieren Sie Ihre Gesamtzahl an Seiten mit dem aktuellen Satz pro Seite, und Sie haben Ihre NFA-Kosten für den Zeitraum. Angenommen, Sie haben an einem Tag 50 Round Turns NQ gehandelt: Das sind 100 Seiten oder $1.00 an NFA-Gebühren. Gegenüber der Provision ist das wenig, aber es ist real, und die Rechnung ist dieselbe, ob Sie einen vollen Kontrakt oder einen Micro handeln." },
      ],
    },
    { type: "paragraph",html: "Die NFA-Gebühr ist nur ein Teil Ihrer tatsächlichen Kosten pro Trade. Ihre Broker-Provision ist der größere Posten und ändert sich mit Ihrem Tarif. Vergleichen Sie daher die Tradovate-Provisionssätze für Micros und Minis, wenn Sie ermitteln, was eine Strategie wirklich kostet." },
    { type: "heading",text: "Die Kurzfassung" },
    { type: "paragraph",html: "Die NFA-Gebühr ist eine feste, durchlaufende Gebühr pro Seite auf jeden Futures-Trade. 2026 beträgt sie $0.01 pro Seite und verdoppelt sich am 1. Juli 2027 auf $0.02. Die Kontraktgröße spielt keine Rolle, daher tragen Micros dieselbe Gebühr wie Kontrakte voller Größe. Multiplizieren Sie Ihre Ausführungen mit dem aktuellen Satz und prüfen Sie die Zahl stets anhand des aktuellen Gebührenplans der NFA, bevor Sie sich darauf verlassen." },
    { type: "heading",text: "Automatisieren Sie dies mit PickMyTrade" },
    { type: "paragraph",html: "Handeln Sie eine aktive Strategie aus TradingView? Jeder Einstieg und Ausstieg ist eine weitere Seite, und diese Gebühren pro Seite summieren sich über den Tag schnell. <strong class='text-white'>PickMyTrade automatisiert Ihre Tradovate-Orders</strong> und hält Ihre Kosten pro Round Turn planbar." },
  ], es: [
    { type: "paragraph",html: "Cada contrato de futuros que opera lleva un pequeño cargo de traspaso llamado tarifa de evaluación de la NFA. En 2026 es de <strong class='text-white'>$0.01 por lado</strong>; la National Futures Association se la factura a su bróker, quien se la traslada a usted. La expresión «por lado» es lo que confunde a la gente: se paga al abrir una posición y de nuevo al cerrarla, de modo que un contrato de ida y vuelta cuesta $0.02 en total. En una operación no es nada. Si hace scalping con micros cien veces al día, empieza a importar." },
    { type: "heading",text: "Qué es realmente la tarifa de evaluación de la NFA" },
    { type: "paragraph",html: "La NFA financia parte de sus operaciones mediante esta evaluación sobre cada transacción de futuros y de opciones sobre futuros que compensan sus firmas miembro. Su bróker, el FCM, no se queda con ni un centavo. Cobra la tarifa y la reenvía a la NFA. Por eso aparece como una línea propia, separada de la comisión, las tarifas del mercado y las tarifas de compensación. No tiene nada que ver con el plan que tenga ni con lo buena que sea la tarifa que negoció. Todos pagan la misma tarifa NFA, desde un principiante en su primera semana hasta una firma que opera miles de lotes." },
    { type: "heading",text: "Cuánto cuesta en 2026" },
    { type: "paragraph",html: "Este es el esquema vigente. Tome las cifras como una instantánea, porque la NFA ajusta la tarifa cada cierto tiempo según su presupuesto." },
    { type: "table", headers: ["Concepto","Costo"], rows: [
      ["Por lado (futuros)","$0.01"],
      ["Ida y vuelta, 1 contrato (2 lados)","$0.02"],
      ["Opciones sobre futuros","$0.01 por lado"],
      ["Cambio programado","Sube a $0.02 por lado el 1 de julio de 2027"],
    ] },
    { type: "paragraph",html: "Antes de incorporar cualquier cifra a un modelo de costos, confirme el valor vigente en el esquema de tarifas publicado por la NFA. Las tarifas que parecen permanentes tienden a cambiar." },
    { type: "heading",text: "Los micros pagan lo mismo que los minis" },
    { type: "paragraph",html: "Este es el detalle que sorprende a los nuevos traders de micros. La tarifa NFA es un importe fijo por contrato y no escala con el tamaño del contrato. Un Micro E-mini como MES o MNQ paga los mismos $0.01 por lado que su versión de tamaño completo, ES o NQ. En un contrato estándar es un error de redondeo frente a su comisión y las tarifas del mercado. En un micro, donde toda su ventaja puede ser un par de ticks, una tarifa fija pesa proporcionalmente mucho más. Si hace una operación completa con diez micros, son veinte lados, es decir, $0.20 solo en tarifas NFA, antes de que entren en juego la comisión y los cargos del mercado." },
    { type: "heading",text: "Dónde encontrar la tarifa NFA en Tradovate" },
    { type: "paragraph",html: "La tarifa NFA suele estar incluida en el total de tarifas que se muestra en sus ejecuciones y aparece detallada en su estado de cuenta. Así se desglosa." },
    {
      type: "steps",
      items: [
        { title: "Abra el informe de su cuenta", html: "Desde la plataforma, abra el área de informes o estados de cuenta y obtenga el informe de cuenta o el estado diario del rango de fechas que quiere revisar. Es el mismo informe que usaría para conciliar cualquier costo de trading." },
        { title: "Encuentre la tarifa NFA en el desglose de tarifas", html: "Las tarifas aparecen detalladas en el informe. Busque la línea NFA junto a las tarifas del mercado y de compensación. Si su vista actual solo muestra un total combinado de «Fees», abra el detalle de una ejecución u orden para ver el desglose. La tarifa NFA se suma a las demás tarifas del mercado y de compensación y a la comisión de su bróker, así que asegúrese de leer la línea NFA por separado y no la cifra combinada." },
        { title: "Multiplique sus lados por la tarifa por lado", html: "Cuente lados, no operaciones. Cada ejecución es un lado. Multiplique su total de lados por la tarifa vigente por lado y tendrá su costo NFA del periodo. Supongamos que operó 50 operaciones completas de NQ en un día: son 100 lados, o $1.00 en tarifas NFA. Es poco frente a la comisión, pero es real, y el cálculo es el mismo ya opere un contrato completo o un micro." },
      ],
    },
    { type: "paragraph",html: "La tarifa NFA es solo una parte de su costo real por operación. La comisión de su bróker es la parte mayor y sí cambia según su plan, así que compare las comisiones de Tradovate para micros y minis cuando calcule lo que realmente cuesta ejecutar una estrategia." },
    { type: "heading",text: "La versión corta" },
    { type: "paragraph",html: "La tarifa de evaluación de la NFA es un cargo fijo, por lado y de traspaso sobre cada operación de futuros. En 2026 es de $0.01 por lado y se duplica a $0.02 el 1 de julio de 2027. No depende del tamaño del contrato, por lo que los micros llevan la misma tarifa que los contratos de tamaño completo. Multiplique sus ejecuciones por la tarifa vigente y confirme siempre la cifra en el esquema actualizado de la NFA antes de confiar en ella." },
    { type: "heading",text: "Automatice esto con PickMyTrade" },
    { type: "paragraph",html: "¿Opera una estrategia activa desde TradingView? Cada entrada y salida es un lado más, y esos cargos por lado se acumulan rápido a lo largo del día. <strong class='text-white'>PickMyTrade automatiza sus órdenes de Tradovate</strong> y mantiene predecible su costo por operación completa." },
  ], fr: [
    { type: "paragraph",html: "Chaque contrat à terme que vous négociez comporte de petits frais répercutés, les frais d'évaluation de la NFA. En 2026, ils s'élèvent à <strong class='text-white'>$0.01 par côté</strong>, facturés par la National Futures Association à votre courtier, qui vous les répercute. C'est la mention « par côté » qui prête à confusion : vous les payez à l'ouverture d'une position, puis de nouveau à la clôture, de sorte qu'un contrat en aller-retour coûte $0.02 au total. Sur un seul trade, ce n'est rien. Si vous scalpez des micros cent fois par jour, cela commence à compter." },
    { type: "heading",text: "Ce que sont réellement les frais d'évaluation de la NFA" },
    { type: "paragraph",html: "La NFA finance une partie de ses activités grâce à cette contribution prélevée sur chaque transaction de futures et d'options sur futures compensée par ses sociétés membres. Votre courtier, le FCM, n'en garde pas un centime. Il perçoit les frais et les reverse à la NFA. C'est pourquoi ils apparaissent sur une ligne distincte, séparée de la commission, des frais de bourse et des frais de compensation. Ils n'ont rien à voir avec votre formule ni avec le taux que vous avez négocié. Tout le monde paie les mêmes frais NFA, du débutant de la première semaine à la société qui négocie des milliers de lots." },
    { type: "heading",text: "Combien ils coûtent en 2026" },
    { type: "paragraph",html: "Voici le barème actuel. Considérez ces chiffres comme un instantané, car la NFA ajuste le taux de temps à autre en fonction de son budget." },
    { type: "table", headers: ["Élément","Coût"], rows: [
      ["Par côté (futures)","$0.01"],
      ["Aller-retour, 1 contrat (2 côtés)","$0.02"],
      ["Options sur futures","$0.01 par côté"],
      ["Changement prévu","Passe à $0.02 par côté le 1er juillet 2027"],
    ] },
    { type: "paragraph",html: "Avant d'intégrer un chiffre dans un modèle de coûts, confirmez la valeur en vigueur dans le barème publié par la NFA. Les taux qui semblent permanents ont tendance à bouger." },
    { type: "heading",text: "Les micros paient autant que les minis" },
    { type: "paragraph",html: "C'est le piège qui surprend les nouveaux traders de micros. Les frais NFA sont un montant fixe par contrat et ne varient pas avec la taille du contrat. Un Micro E-mini comme MES ou MNQ paie les mêmes $0.01 par côté que son équivalent de taille standard, ES ou NQ. Sur un contrat standard, c'est un arrondi à côté de votre commission et des frais de bourse. Sur un micro, où tout votre avantage peut tenir en quelques ticks, des frais fixes pèsent proportionnellement bien plus lourd. Dix micros en aller-retour représentent vingt côtés, soit $0.20 de frais NFA à eux seuls, avant même que la commission et les frais de bourse n'entrent en jeu." },
    { type: "heading",text: "Où trouver les frais NFA dans Tradovate" },
    { type: "paragraph",html: "Les frais NFA sont généralement inclus dans le total des frais affiché sur vos exécutions et détaillés sur votre relevé. Voici comment les isoler." },
    {
      type: "steps",
      items: [
        { title: "Ouvrez le rapport de votre compte", html: "Depuis la plateforme, ouvrez la section des rapports ou des relevés et obtenez le rapport de compte ou le relevé quotidien pour la période à vérifier. C'est le même rapport que vous utiliseriez pour rapprocher n'importe quel coût de trading." },
        { title: "Repérez les frais NFA dans le détail des frais", html: "Les frais sont détaillés dans le rapport. Cherchez la ligne NFA à côté des frais de bourse et de compensation. Si votre vue actuelle n'affiche qu'un total combiné « Fees », ouvrez le détail d'une exécution ou d'un ordre pour voir la répartition. Les frais NFA s'ajoutent aux autres frais de bourse et de compensation ainsi qu'à la commission de votre courtier ; veillez donc à lire la ligne NFA séparément et non le total combiné." },
        { title: "Multipliez vos côtés par le taux par côté", html: "Comptez les côtés, pas les trades. Chaque exécution est un côté. Multipliez votre total de côtés par le taux actuel par côté et vous obtenez votre coût NFA pour la période. Supposons que vous ayez négocié 50 aller-retour de NQ dans la journée : cela fait 100 côtés, soit $1.00 de frais NFA. C'est peu à côté de la commission, mais c'est réel, et le calcul est le même que vous tradiez un contrat standard ou un micro." },
      ],
    },
    { type: "paragraph",html: "Les frais NFA ne sont qu'une part de votre coût réel par trade. La commission de votre courtier en est la plus grosse part et varie selon votre formule ; comparez donc les commissions Tradovate pour les micros et les minis lorsque vous calculez ce que coûte réellement une stratégie." },
    { type: "heading",text: "En bref" },
    { type: "paragraph",html: "Les frais d'évaluation de la NFA sont des frais fixes, par côté et répercutés, sur chaque trade de futures. En 2026, ils sont de $0.01 par côté et doublent à $0.02 le 1er juillet 2027. Ils ne dépendent pas de la taille du contrat ; les micros supportent donc les mêmes frais que les contrats de taille standard. Multipliez vos exécutions par le taux actuel et vérifiez toujours le chiffre dans le barème en vigueur de la NFA avant de vous y fier." },
    { type: "heading",text: "Automatisez cela avec PickMyTrade" },
    { type: "paragraph",html: "Vous tradez une stratégie très active depuis TradingView ? Chaque entrée et sortie est un côté de plus, et ces frais par côté s'accumulent vite au fil de la journée. <strong class='text-white'>PickMyTrade automatise vos ordres Tradovate</strong> et garde votre coût par aller-retour prévisible." },
  ], it: [
    { type: "paragraph",html: "Ogni contratto future che negozia comporta un piccolo costo passante chiamato commissione di valutazione NFA. Nel 2026 è di <strong class='text-white'>$0.01 per lato</strong>, addebitata dalla National Futures Association al Suo broker, che la ribalta su di Lei. L'espressione «per lato» è ciò che confonde: la paga quando apre una posizione e di nuovo quando la chiude, quindi un singolo contratto round turn costa $0.02 in totale. Su un solo trade non è nulla. Se fa scalping con i micro cento volte al giorno, inizia a contare." },
    { type: "heading",text: "Che cos'è davvero la commissione di valutazione NFA" },
    { type: "paragraph",html: "La NFA finanzia parte delle proprie attività tramite questa valutazione su ogni transazione in futures e in opzioni su futures compensata dalle società associate. Il Suo broker, l'FCM, non trattiene un centesimo. Incassa la commissione e la inoltra alla NFA. Per questo compare come voce separata, distinta da commissione, costi di borsa e costi di clearing. Non ha nulla a che vedere con il piano che ha o con quanto sia vantaggiosa la tariffa negoziata. Tutti pagano la stessa commissione NFA, dal principiante della prima settimana alla società che negozia migliaia di lotti." },
    { type: "heading",text: "Quanto costa nel 2026" },
    { type: "paragraph",html: "Ecco il prospetto attuale. Consideri i numeri un'istantanea, perché la NFA modifica la tariffa di tanto in tanto in base al proprio budget." },
    { type: "table", headers: ["Voce","Costo"], rows: [
      ["Per lato (futures)","$0.01"],
      ["Round turn, 1 contratto (2 lati)","$0.02"],
      ["Opzioni su futures","$0.01 per lato"],
      ["Modifica programmata","Sale a $0.02 per lato dal 1° luglio 2027"],
    ] },
    { type: "paragraph",html: "Prima di inserire una cifra in un modello di costi, verifichi il valore aggiornato nel prospetto tariffario pubblicato dalla NFA. Le tariffe che sembrano permanenti hanno l'abitudine di cambiare." },
    { type: "heading",text: "I micro pagano come i mini" },
    { type: "paragraph",html: "È il dettaglio che sorprende i nuovi trader di micro. La commissione NFA è un importo fisso per contratto e non varia con le dimensioni del contratto. Un Micro E-mini come MES o MNQ paga gli stessi $0.01 per lato del suo equivalente di dimensioni standard, ES o NQ. Su un contratto standard è un arrotondamento rispetto a commissione e costi di borsa. Su un micro, dove tutto il Suo vantaggio può essere di un paio di tick, una commissione fissa pesa proporzionalmente molto di più. Dieci micro in round turn sono venti lati, ovvero $0.20 di sola commissione NFA, prima ancora che entrino in gioco commissione e costi di borsa." },
    { type: "heading",text: "Dove trovare la commissione NFA in Tradovate" },
    { type: "paragraph",html: "La commissione NFA è di solito inclusa nel totale delle commissioni mostrato sulle Sue esecuzioni e dettagliata nell'estratto conto. Ecco come scomporla." },
    {
      type: "steps",
      items: [
        { title: "Apra il report del conto", html: "Dalla piattaforma, apra l'area dei report o degli estratti conto e scarichi il report del conto o l'estratto giornaliero per il periodo che desidera verificare. È lo stesso report che userebbe per riconciliare qualsiasi costo di trading." },
        { title: "Trovi la commissione NFA nel dettaglio delle commissioni", html: "Le commissioni sono dettagliate nel report. Cerchi la riga NFA accanto ai costi di borsa e di clearing. Se la Sua vista attuale mostra solo un totale combinato «Fees», apra il dettaglio di una singola esecuzione o di un ordine per vedere la suddivisione. La commissione NFA si somma agli altri costi di borsa e di clearing e alla commissione del Suo broker, perciò si assicuri di leggere la riga NFA da sola e non il totale combinato." },
        { title: "Moltiplichi i Suoi lati per la tariffa per lato", html: "Conti i lati, non i trade. Ogni esecuzione è un lato. Moltiplichi il totale dei lati per la tariffa attuale per lato e otterrà il Suo costo NFA per il periodo. Poniamo che abbia fatto 50 round turn di NQ in un giorno: sono 100 lati, ovvero $1.00 di commissioni NFA. È poco rispetto alla commissione, ma è reale, e il calcolo è lo stesso sia che negozi un contratto intero sia un micro." },
      ],
    },
    { type: "paragraph",html: "La commissione NFA è solo una parte del Suo costo reale per trade. La commissione del broker è la parte maggiore e cambia in base al piano, quindi confronti le commissioni Tradovate per micro e mini quando calcola quanto costa davvero far girare una strategia." },
    { type: "heading",text: "In sintesi" },
    { type: "paragraph",html: "La commissione di valutazione NFA è un costo passante fisso, per lato, su ogni trade sui futures. Nel 2026 è di $0.01 per lato e raddoppia a $0.02 dal 1° luglio 2027. Non dipende dalle dimensioni del contratto, quindi i micro pagano la stessa commissione dei contratti di dimensioni standard. Moltiplichi le Sue esecuzioni per la tariffa attuale e verifichi sempre la cifra nel prospetto aggiornato della NFA prima di fare affidamento su di essa." },
    { type: "heading",text: "Automatizzi tutto con PickMyTrade" },
    { type: "paragraph",html: "Negozia una strategia molto attiva da TradingView? Ogni ingresso e uscita è un lato in più, e queste commissioni per lato si accumulano in fretta nell'arco della giornata. <strong class='text-white'>PickMyTrade automatizza i Suoi ordini Tradovate</strong> e mantiene prevedibile il Suo costo per round turn." },
  ] },
