---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "tradovate-motivewave";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/how-to/${SLUG}`;

const META_TITLE = "Connect Tradovate to MotiveWave";
const META_DESCRIPTION =
  "Link a Tradovate futures account to MotiveWave for advanced charting: pick the right gateway, log in, choose live or demo, and start trading.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Tradovate mit MotiveWave verbinden", es: "Conectar Tradovate a MotiveWave", fr: "Connecter Tradovate à MotiveWave", it: "Collegare Tradovate a MotiveWave" },
  dek: { en: "MotiveWave doesn't hold your money, it pulls data and routes orders through a broker connection you set up once. Here's how to get your Tradovate account into it: pick the right connection type, then log in with credentials that match.", de: "MotiveWave verwahrt Ihr Geld nicht, sondern bezieht Daten und leitet Orders über eine Broker-Verbindung, die Sie einmal einrichten. So bringen Sie Ihr Tradovate-Konto hinein: Wählen Sie den richtigen Verbindungstyp und melden Sie sich dann mit passenden Zugangsdaten an.", es: "MotiveWave no guarda su dinero: obtiene datos y enruta órdenes a través de una conexión con el bróker que configura una sola vez. Así se integra su cuenta de Tradovate: elija el tipo de conexión correcto y luego inicie sesión con credenciales que coincidan.", fr: "MotiveWave ne détient pas votre argent : il récupère les données et achemine les ordres via une connexion broker que vous configurez une seule fois. Voici comment y intégrer votre compte Tradovate : choisissez le bon type de connexion, puis connectez-vous avec des identifiants correspondants.", it: "MotiveWave non custodisce il suo denaro: riceve i dati e instrada gli ordini tramite una connessione al broker che configura una sola volta. Ecco come inserire il suo conto Tradovate: scelga il tipo di connessione giusto, poi acceda con credenziali corrispondenti." },
  readTime: { en: "6 min read", de: "6 Min. Lesezeit", es: "Lectura de 6 min", fr: "Lecture : 6 min", it: "Lettura di 6 min" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "MotiveWave is a serious charting and analysis platform, with Elliott Wave tools, order flow, and deep drawing sets, but it doesn't hold your money. It pulls data and routes orders through a broker connection you set up once. So getting your Tradovate account into MotiveWave really comes down to two things: picking the right connection type, then logging in with credentials that match it." },
    { type: "paragraph", html: "Here's the part that trips people up. Tradovate isn't a one-click entry sitting at the top of MotiveWave's provider list. MotiveWave is broker-neutral and reaches futures accounts through gateway connectors, mainly CQG and Rithmic, plus its own growing list of direct integrations. Which route your Tradovate account uses depends on how the account was created and, if you're a prop trader, on your firm. Sort that out first and the rest is a short wizard." },
    { type: "heading", text: "What You'll Need" },
    {
      type: "list",
      items: [
        "MotiveWave installed and up to date (the connection wizard changes between versions).",
        "The login that matches your route: the <strong class='text-white'>username and password your broker or prop firm issued</strong> for CQG or Rithmic, or a direct Tradovate login if your account and MotiveWave version support one.",
        "Written confirmation from your broker or firm of <strong class='text-white'>which gateway your Tradovate account connects through</strong>.",
        "Any exchange and market-data agreements already accepted on the broker side, so quotes aren't blocked once you're in.",
      ],
    },
    { type: "heading", text: "Connect Tradovate to MotiveWave: Step by Step" },
    {
      type: "steps",
      items: [
        { title: "Confirm How Your Tradovate Account Connects", html: "Don't guess this one. A Tradovate-hosted account can reach MotiveWave through different connectors, and using the wrong one is the single biggest reason a login fails. Message your broker or prop firm and ask, plainly, which connection you should use in MotiveWave and what credentials go with it. Many futures and prop accounts route through <strong class='text-white'>CQG</strong> or <strong class='text-white'>Rithmic</strong>, and the login for that gateway is often different from your everyday Tradovate web password. Write down the exact username, password, and, for Rithmic, the server or system name they give you." },
        { title: "Install MotiveWave and Start a New Connection", html: "Open MotiveWave. On a fresh install it walks you through a short setup: give the <strong class='text-white'>workspace</strong> a name, then it prompts you to add a connection. Already using MotiveWave? Open the connections manager instead, and look for <strong class='text-white'>Configure Connections</strong> (or the equivalent connection settings in your version) and start a <strong class='text-white'>New Connection</strong>. Either path lands you on the same provider-selection screen." },
        { title: "Choose Your Service Provider", html: "Now pick the provider that matches what you confirmed in Step 1. If your MotiveWave version lists a direct <strong class='text-white'>Tradovate</strong> option and your account supports it, choose that. If it doesn't, select the gateway your Tradovate account routes through, either <strong class='text-white'>CQG</strong> or <strong class='text-white'>Rithmic</strong>. Provider names and menu labels shift between MotiveWave releases, so match your account's route rather than hunting for a specific word. If nothing on the list fits, that's your cue to go back to your broker before you waste time typing credentials that can't connect." },
        { title: "Enter Your Login and Choose Live or Demo", html: "Type the <strong class='text-white'>username and password</strong> for the provider you selected, the ones tied to that route, not necessarily your Tradovate web login. Then set the environment: <strong class='text-white'>Live</strong> for a funded, real-money account, or <strong class='text-white'>Demo</strong> / <strong class='text-white'>Simulated</strong> for an evaluation or practice account. Pick the wrong side and you'll either connect to an empty account or get turned away at login. If the screen asks for a server or gateway (common with Rithmic), select the exact one your firm named. Double-check for stray spaces or wrong capitalization before you continue. That's a quiet, frequent cause of failed logins." },
        { title: "Finish, Connect, and Place a Test Order", html: "Click <strong class='text-white'>Finish</strong>. Your new connection now shows on the MotiveWave login screen every time you launch it. Select it and <strong class='text-white'>Continue</strong> (or Connect) to log in. Give it a few seconds to handshake. Once it's connected, open a chart, load your instrument, and confirm your account shows up in the order-entry or accounts panel. Send a <strong class='text-white'>small test order</strong> on a demo or a single contract to prove the round trip: order out, fill back, position visible. If a market-data or agreement popup blocks you right after the account links, that's a known snag, so clear the outstanding data subscription or agreement on the broker side." },
      ],
    },
    { type: "heading", text: "Trading a Prop or Evaluation Account?" },
    { type: "paragraph", html: "Prop accounts add a wrinkle. The connector you're allowed to use, the platforms permitted, and the risk rules all vary by firm and account size, so check your firm's current rules before you set anything up. Some firms hand you Rithmic or CQG credentials specifically for third-party platforms like MotiveWave; others restrict which tools can touch an evaluation. If your firm blocks the route you need, no amount of retyping will fix it." },
    { type: "heading", text: "Automate This with PickMyTrade" },
    { type: "paragraph", html: "Don't want a charting app open on a home PC just to catch every signal? <strong class='text-white'>PickMyTrade sends your TradingView strategy alerts straight to Tradovate</strong>. Cloud-side execution, no desktop platform left running to fill your orders." },
  ], de: [
    { type: "paragraph",html: "MotiveWave ist eine leistungsstarke Chart- und Analyseplattform mit Elliott-Wave-Werkzeugen, Orderflow und umfangreichen Zeichenwerkzeugen, verwahrt aber Ihr Geld nicht. Es bezieht Daten und leitet Orders über eine Broker-Verbindung, die Sie einmal einrichten. Ihr Tradovate-Konto in MotiveWave einzubinden, läuft daher auf zwei Dinge hinaus: den richtigen Verbindungstyp wählen und sich dann mit dazu passenden Zugangsdaten anmelden." },
    { type: "paragraph",html: "Hier stolpern die meisten. Tradovate steht nicht als Ein-Klick-Eintrag ganz oben in der Anbieterliste von MotiveWave. MotiveWave ist brokerneutral und erreicht Futures-Konten über Gateway-Konnektoren, vor allem CQG und Rithmic, sowie über eine wachsende Liste eigener direkter Integrationen. Welchen Weg Ihr Tradovate-Konto nutzt, hängt davon ab, wie das Konto erstellt wurde und, wenn Sie Prop-Trader sind, von Ihrer Firma. Klären Sie das zuerst, dann ist der Rest ein kurzer Assistent." },
    { type: "heading",text: "Was Sie benötigen" },
    {
      type: "list",
      items: [
        "MotiveWave, installiert und auf dem neuesten Stand (der Verbindungsassistent ändert sich zwischen den Versionen).",
        "Die zu Ihrem Weg passenden Zugangsdaten: der <strong class='text-white'>Benutzername und das Passwort, die Ihr Broker oder Ihre Prop-Firma ausgestellt hat</strong>, für CQG oder Rithmic, oder ein direkter Tradovate-Login, falls Ihr Konto und Ihre MotiveWave-Version dies unterstützen.",
        "Eine schriftliche Bestätigung Ihres Brokers oder Ihrer Firma, <strong class='text-white'>über welches Gateway Ihr Tradovate-Konto verbunden wird</strong>.",
        "Alle bereits Broker-seitig akzeptierten Börsen- und Marktdatenvereinbarungen, damit Kurse nach dem Login nicht blockiert werden.",
      ],
    },
    { type: "heading",text: "Tradovate mit MotiveWave verbinden: Schritt für Schritt" },
    {
      type: "steps",
      items: [
        { title: "Bestätigen Sie, wie Ihr Tradovate-Konto verbunden wird", html: "Raten Sie hier nicht. Ein bei Tradovate gehostetes Konto kann MotiveWave über unterschiedliche Konnektoren erreichen, und der falsche Konnektor ist der häufigste Grund für einen fehlgeschlagenen Login. Schreiben Sie Ihrem Broker oder Ihrer Prop-Firma und fragen Sie klar, welche Verbindung Sie in MotiveWave verwenden sollen und welche Zugangsdaten dazugehören. Viele Futures- und Prop-Konten laufen über <strong class='text-white'>CQG</strong> oder <strong class='text-white'>Rithmic</strong>, und der Login für dieses Gateway unterscheidet sich oft von Ihrem gewohnten Tradovate-Web-Passwort. Notieren Sie sich den genauen Benutzernamen, das Passwort und, bei Rithmic, den Server- oder Systemnamen, den man Ihnen nennt." },
        { title: "Installieren Sie MotiveWave und starten Sie eine neue Verbindung", html: "Öffnen Sie MotiveWave. Bei einer Neuinstallation führt es Sie durch eine kurze Einrichtung: Geben Sie dem <strong class='text-white'>Workspace</strong> einen Namen, danach werden Sie aufgefordert, eine Verbindung hinzuzufügen. Nutzen Sie MotiveWave bereits? Öffnen Sie stattdessen den Verbindungsmanager, suchen Sie <strong class='text-white'>Configure Connections</strong> (oder die entsprechenden Verbindungseinstellungen Ihrer Version) und starten Sie eine <strong class='text-white'>New Connection</strong>. Beide Wege führen Sie zum selben Bildschirm zur Anbieterauswahl." },
        { title: "Wählen Sie Ihren Dienstanbieter", html: "Wählen Sie nun den Anbieter, der zu dem passt, was Sie in Schritt 1 bestätigt haben. Falls Ihre MotiveWave-Version eine direkte <strong class='text-white'>Tradovate</strong>-Option auflistet und Ihr Konto sie unterstützt, wählen Sie diese. Andernfalls wählen Sie das Gateway, über das Ihr Tradovate-Konto läuft, entweder <strong class='text-white'>CQG</strong> oder <strong class='text-white'>Rithmic</strong>. Anbieternamen und Menübezeichnungen ändern sich zwischen MotiveWave-Versionen. Richten Sie sich daher nach dem Weg Ihres Kontos und nicht nach einem bestimmten Wort. Passt nichts in der Liste, wenden Sie sich zuerst an Ihren Broker, bevor Sie Zeit mit Zugangsdaten verschwenden, die sich nicht verbinden können." },
        { title: "Geben Sie Ihre Zugangsdaten ein und wählen Sie Live oder Demo", html: "Geben Sie <strong class='text-white'>Benutzername und Passwort</strong> für den gewählten Anbieter ein, also die zu diesem Weg gehörenden, nicht zwingend Ihr Tradovate-Web-Login. Legen Sie dann die Umgebung fest: <strong class='text-white'>Live</strong> für ein finanziertes Echtgeldkonto oder <strong class='text-white'>Demo</strong> / <strong class='text-white'>Simulated</strong> für ein Evaluierungs- oder Übungskonto. Wählen Sie die falsche Seite, verbinden Sie sich entweder mit einem leeren Konto oder werden beim Login abgewiesen. Verlangt der Bildschirm einen Server oder ein Gateway (üblich bei Rithmic), wählen Sie genau das, das Ihre Firma genannt hat. Prüfen Sie vor dem Fortfahren auf überflüssige Leerzeichen oder falsche Groß- und Kleinschreibung. Das ist eine unscheinbare, aber häufige Ursache fehlgeschlagener Logins." },
        { title: "Abschließen, verbinden und eine Testorder platzieren", html: "Klicken Sie auf <strong class='text-white'>Finish</strong>. Ihre neue Verbindung erscheint nun bei jedem Start auf dem MotiveWave-Anmeldebildschirm. Wählen Sie sie aus und klicken Sie auf <strong class='text-white'>Continue</strong> (oder Connect), um sich anzumelden. Geben Sie dem Handshake einige Sekunden. Sobald die Verbindung steht, öffnen Sie einen Chart, laden Ihr Instrument und prüfen, ob Ihr Konto im Orderentry- oder Konten-Bereich erscheint. Senden Sie eine <strong class='text-white'>kleine Testorder</strong> auf einem Demo-Konto oder mit einem einzelnen Kontrakt, um den gesamten Ablauf zu prüfen: Order raus, Fill zurück, Position sichtbar. Blockiert Sie kurz nach der Kontoverknüpfung ein Marktdaten- oder Vereinbarungs-Popup, ist das ein bekannter Stolperstein. Beheben Sie das ausstehende Datenabonnement oder die ausstehende Vereinbarung auf Broker-Seite." },
      ],
    },
    { type: "heading",text: "Handeln Sie ein Prop- oder Evaluierungskonto?" },
    { type: "paragraph",html: "Prop-Konten bringen eine Besonderheit mit sich. Der Konnektor, den Sie nutzen dürfen, die zulässigen Plattformen und die Risikoregeln variieren je nach Firma und Kontogröße. Prüfen Sie daher die aktuellen Regeln Ihrer Firma, bevor Sie etwas einrichten. Manche Firmen geben Ihnen Rithmic- oder CQG-Zugangsdaten gezielt für Drittplattformen wie MotiveWave, andere beschränken, welche Tools auf eine Evaluierung zugreifen dürfen. Blockiert Ihre Firma den benötigten Weg, hilft kein noch so häufiges Neueingeben." },
    { type: "heading",text: "Automatisieren Sie dies mit PickMyTrade" },
    { type: "paragraph",html: "Sie möchten keine Chart-App auf einem Heim-PC geöffnet lassen, nur um jedes Signal zu erfassen? <strong class='text-white'>PickMyTrade sendet Ihre TradingView-Strategie-Alerts direkt an Tradovate</strong>. Ausführung in der Cloud, ohne eine laufende Desktop-Plattform, die Ihre Orders ausführt." },
  ], es: [
    { type: "paragraph",html: "MotiveWave es una plataforma seria de gráficos y análisis, con herramientas de ondas de Elliott, order flow y amplios conjuntos de dibujo, pero no guarda su dinero. Obtiene datos y enruta órdenes a través de una conexión con el bróker que configura una sola vez. Por eso, integrar su cuenta de Tradovate en MotiveWave se reduce a dos cosas: elegir el tipo de conexión correcto y luego iniciar sesión con credenciales que coincidan." },
    { type: "paragraph",html: "Aquí es donde tropieza la gente. Tradovate no es una entrada de un clic en lo más alto de la lista de proveedores de MotiveWave. MotiveWave es neutral respecto al bróker y llega a las cuentas de futuros mediante conectores de gateway, principalmente CQG y Rithmic, además de su propia lista creciente de integraciones directas. La ruta que usa su cuenta de Tradovate depende de cómo se creó la cuenta y, si es trader de prop firm, de su firma. Resuelva eso primero y el resto es un asistente breve." },
    { type: "heading",text: "Qué necesitará" },
    {
      type: "list",
      items: [
        "MotiveWave instalado y actualizado (el asistente de conexión cambia entre versiones).",
        "Las credenciales que correspondan a su ruta: el <strong class='text-white'>usuario y la contraseña que su bróker o prop firm le emitió</strong> para CQG o Rithmic, o un inicio de sesión directo de Tradovate si su cuenta y su versión de MotiveWave lo admiten.",
        "Confirmación por escrito de su bróker o firma sobre <strong class='text-white'>qué gateway usa su cuenta de Tradovate para conectarse</strong>.",
        "Cualquier acuerdo de bolsa y de datos de mercado ya aceptado en el lado del bróker, para que las cotizaciones no queden bloqueadas una vez dentro.",
      ],
    },
    { type: "heading",text: "Conectar Tradovate a MotiveWave: paso a paso" },
    {
      type: "steps",
      items: [
        { title: "Confirme cómo se conecta su cuenta de Tradovate", html: "No lo adivine. Una cuenta alojada en Tradovate puede llegar a MotiveWave mediante distintos conectores, y usar el incorrecto es la mayor causa de fallos de inicio de sesión. Escriba a su bróker o prop firm y pregunte claramente qué conexión debe usar en MotiveWave y qué credenciales le corresponden. Muchas cuentas de futuros y de prop firms se enrutan a través de <strong class='text-white'>CQG</strong> o <strong class='text-white'>Rithmic</strong>, y el inicio de sesión de ese gateway suele ser distinto de su contraseña web habitual de Tradovate. Anote el usuario y la contraseña exactos y, en Rithmic, el nombre del servidor o sistema que le indiquen." },
        { title: "Instale MotiveWave e inicie una nueva conexión", html: "Abra MotiveWave. En una instalación nueva, le guía por una breve configuración: asigne un nombre al <strong class='text-white'>workspace</strong> y luego le pedirá añadir una conexión. ¿Ya usa MotiveWave? Abra en su lugar el gestor de conexiones, busque <strong class='text-white'>Configure Connections</strong> (o los ajustes de conexión equivalentes en su versión) e inicie una <strong class='text-white'>New Connection</strong>. Ambos caminos llevan a la misma pantalla de selección de proveedor." },
        { title: "Elija su proveedor de servicio", html: "Ahora elija el proveedor que coincida con lo que confirmó en el paso 1. Si su versión de MotiveWave lista una opción directa de <strong class='text-white'>Tradovate</strong> y su cuenta la admite, elíjala. Si no, seleccione el gateway por el que se enruta su cuenta de Tradovate, ya sea <strong class='text-white'>CQG</strong> o <strong class='text-white'>Rithmic</strong>. Los nombres de proveedor y las etiquetas de menú cambian entre versiones de MotiveWave, así que guíese por la ruta de su cuenta y no busque una palabra concreta. Si nada de la lista encaja, es la señal para volver a su bróker antes de perder tiempo escribiendo credenciales que no pueden conectarse." },
        { title: "Introduzca su inicio de sesión y elija Live o Demo", html: "Escriba el <strong class='text-white'>usuario y la contraseña</strong> del proveedor que seleccionó, los asociados a esa ruta, no necesariamente su inicio de sesión web de Tradovate. Luego defina el entorno: <strong class='text-white'>Live</strong> para una cuenta financiada con dinero real, o <strong class='text-white'>Demo</strong> / <strong class='text-white'>Simulated</strong> para una cuenta de evaluación o de práctica. Si elige el lado equivocado, se conectará a una cuenta vacía o le rechazarán al iniciar sesión. Si la pantalla pide un servidor o gateway (habitual con Rithmic), seleccione exactamente el que le indicó su firma. Revise que no haya espacios sobrantes ni mayúsculas incorrectas antes de continuar. Es una causa silenciosa y frecuente de inicios de sesión fallidos." },
        { title: "Finalice, conéctese y envíe una orden de prueba", html: "Haga clic en <strong class='text-white'>Finish</strong>. Su nueva conexión aparecerá en la pantalla de inicio de sesión de MotiveWave cada vez que lo abra. Selecciónela y pulse <strong class='text-white'>Continue</strong> (o Connect) para iniciar sesión. Dé unos segundos al handshake. Una vez conectado, abra un gráfico, cargue su instrumento y confirme que su cuenta aparece en el panel de entrada de órdenes o de cuentas. Envíe una <strong class='text-white'>pequeña orden de prueba</strong> en demo o con un solo contrato para comprobar el recorrido completo: orden enviada, ejecución recibida, posición visible. Si un aviso de datos de mercado o de acuerdos le bloquea justo después de vincular la cuenta, es un problema conocido: resuelva la suscripción de datos o el acuerdo pendiente en el lado del bróker." },
      ],
    },
    { type: "heading",text: "¿Opera una cuenta de prop firm o de evaluación?" },
    { type: "paragraph",html: "Las cuentas de prop firm añaden una complicación. El conector que puede usar, las plataformas permitidas y las reglas de riesgo varían según la firma y el tamaño de la cuenta, así que revise las reglas vigentes de su firma antes de configurar nada. Algunas firmas le entregan credenciales de Rithmic o CQG específicamente para plataformas de terceros como MotiveWave; otras restringen qué herramientas pueden tocar una evaluación. Si su firma bloquea la ruta que necesita, ningún reintento de escritura lo arreglará." },
    { type: "heading",text: "Automatice esto con PickMyTrade" },
    { type: "paragraph",html: "¿No quiere tener una app de gráficos abierta en un PC doméstico solo para captar cada señal? <strong class='text-white'>PickMyTrade envía las alertas de su estrategia de TradingView directamente a Tradovate</strong>. Ejecución en la nube, sin una plataforma de escritorio en marcha para rellenar sus órdenes." },
  ], fr: [
    { type: "paragraph",html: "MotiveWave est une plateforme de graphiques et d’analyse sérieuse, dotée d’outils Elliott Wave, d’order flow et d’ensembles de dessin très complets, mais elle ne détient pas votre argent. Elle récupère les données et achemine les ordres via une connexion broker que vous configurez une seule fois. Intégrer votre compte Tradovate à MotiveWave revient donc à deux choses : choisir le bon type de connexion, puis vous connecter avec des identifiants correspondants." },
    { type: "paragraph",html: "Voici ce qui fait trébucher la plupart des gens. Tradovate n’est pas une entrée en un clic tout en haut de la liste des fournisseurs de MotiveWave. MotiveWave est neutre vis-à-vis des brokers et accède aux comptes de futures via des connecteurs de passerelle, principalement CQG et Rithmic, ainsi que sa propre liste croissante d’intégrations directes. La voie utilisée par votre compte Tradovate dépend de la façon dont le compte a été créé et, si vous êtes trader prop, de votre société. Réglez cela d’abord, et le reste n’est qu’un court assistant." },
    { type: "heading",text: "Ce dont vous aurez besoin" },
    {
      type: "list",
      items: [
        "MotiveWave installé et à jour (l’assistant de connexion change d’une version à l’autre).",
        "Les identifiants correspondant à votre voie : le <strong class='text-white'>nom d’utilisateur et le mot de passe fournis par votre broker ou votre prop firm</strong> pour CQG ou Rithmic, ou une connexion Tradovate directe si votre compte et votre version de MotiveWave la prennent en charge.",
        "Une confirmation écrite de votre broker ou de votre société indiquant <strong class='text-white'>par quelle passerelle votre compte Tradovate se connecte</strong>.",
        "Tous les accords de bourse et de données de marché déjà acceptés côté broker, afin que les cotations ne soient pas bloquées une fois connecté.",
      ],
    },
    { type: "heading",text: "Connecter Tradovate à MotiveWave : pas à pas" },
    {
      type: "steps",
      items: [
        { title: "Confirmez comment votre compte Tradovate se connecte", html: "Ne devinez pas. Un compte hébergé par Tradovate peut atteindre MotiveWave via différents connecteurs, et utiliser le mauvais est la principale cause d’échec de connexion. Écrivez à votre broker ou à votre prop firm et demandez clairement quelle connexion utiliser dans MotiveWave et quels identifiants l’accompagnent. De nombreux comptes de futures et de prop firms passent par <strong class='text-white'>CQG</strong> ou <strong class='text-white'>Rithmic</strong>, et l’identifiant de cette passerelle diffère souvent de votre mot de passe web Tradovate habituel. Notez le nom d’utilisateur et le mot de passe exacts et, pour Rithmic, le nom du serveur ou du système qu’on vous communique." },
        { title: "Installez MotiveWave et démarrez une nouvelle connexion", html: "Ouvrez MotiveWave. Sur une nouvelle installation, il vous guide à travers une courte configuration : donnez un nom au <strong class='text-white'>workspace</strong>, puis il vous invite à ajouter une connexion. Vous utilisez déjà MotiveWave ? Ouvrez plutôt le gestionnaire de connexions, repérez <strong class='text-white'>Configure Connections</strong> (ou les paramètres de connexion équivalents dans votre version) et lancez une <strong class='text-white'>New Connection</strong>. Les deux chemins mènent au même écran de sélection du fournisseur." },
        { title: "Choisissez votre fournisseur de service", html: "Choisissez maintenant le fournisseur qui correspond à ce que vous avez confirmé à l’étape 1. Si votre version de MotiveWave propose une option <strong class='text-white'>Tradovate</strong> directe et que votre compte la prend en charge, sélectionnez-la. Sinon, choisissez la passerelle par laquelle transite votre compte Tradovate, soit <strong class='text-white'>CQG</strong>, soit <strong class='text-white'>Rithmic</strong>. Les noms de fournisseurs et les libellés de menu changent d’une version de MotiveWave à l’autre ; guidez-vous donc sur la voie de votre compte plutôt que de chercher un mot précis. Si rien dans la liste ne convient, c’est le signal de retourner voir votre broker avant de perdre du temps à saisir des identifiants qui ne pourront pas se connecter." },
        { title: "Saisissez vos identifiants et choisissez Live ou Demo", html: "Saisissez le <strong class='text-white'>nom d’utilisateur et le mot de passe</strong> du fournisseur sélectionné, ceux liés à cette voie, pas nécessairement votre connexion web Tradovate. Définissez ensuite l’environnement : <strong class='text-white'>Live</strong> pour un compte financé en argent réel, ou <strong class='text-white'>Demo</strong> / <strong class='text-white'>Simulated</strong> pour un compte d’évaluation ou d’entraînement. Si vous choisissez le mauvais côté, vous vous connecterez à un compte vide ou serez refusé à la connexion. Si l’écran demande un serveur ou une passerelle (courant avec Rithmic), sélectionnez exactement celui que votre société vous a indiqué. Vérifiez l’absence d’espaces parasites ou de majuscules erronées avant de continuer. C’est une cause discrète et fréquente d’échec de connexion." },
        { title: "Terminez, connectez-vous et passez un ordre de test", html: "Cliquez sur <strong class='text-white'>Finish</strong>. Votre nouvelle connexion apparaît désormais sur l’écran de connexion de MotiveWave à chaque lancement. Sélectionnez-la et cliquez sur <strong class='text-white'>Continue</strong> (ou Connect) pour vous connecter. Laissez quelques secondes au handshake. Une fois connecté, ouvrez un graphique, chargez votre instrument et vérifiez que votre compte apparaît dans le panneau de saisie d’ordres ou de comptes. Envoyez un <strong class='text-white'>petit ordre de test</strong> sur une démo ou avec un seul contrat pour valider l’aller-retour : ordre envoyé, exécution reçue, position visible. Si une fenêtre de données de marché ou d’accord vous bloque juste après la liaison du compte, c’est un écueil connu : réglez l’abonnement de données ou l’accord en attente côté broker." },
      ],
    },
    { type: "heading",text: "Vous tradez un compte prop ou d’évaluation ?" },
    { type: "paragraph",html: "Les comptes prop ajoutent une subtilité. Le connecteur que vous êtes autorisé à utiliser, les plateformes permises et les règles de risque varient selon la société et la taille du compte ; vérifiez donc les règles en vigueur de votre société avant de configurer quoi que ce soit. Certaines sociétés vous remettent des identifiants Rithmic ou CQG spécifiquement pour des plateformes tierces comme MotiveWave ; d’autres restreignent les outils pouvant toucher une évaluation. Si votre société bloque la voie dont vous avez besoin, aucune ressaisie n’y changera rien." },
    { type: "heading",text: "Automatisez cela avec PickMyTrade" },
    { type: "paragraph",html: "Vous ne voulez pas laisser une application de graphiques ouverte sur un PC à domicile juste pour capter chaque signal ? <strong class='text-white'>PickMyTrade envoie les alertes de votre stratégie TradingView directement vers Tradovate</strong>. Exécution dans le cloud, sans plateforme de bureau à laisser tourner pour exécuter vos ordres." },
  ], it: [
    { type: "paragraph",html: "MotiveWave è una piattaforma seria di grafici e analisi, con strumenti Elliott Wave, order flow e ampi set di disegno, ma non custodisce il suo denaro. Riceve i dati e instrada gli ordini tramite una connessione al broker che configura una sola volta. Portare il suo conto Tradovate in MotiveWave si riduce quindi a due cose: scegliere il tipo di connessione giusto e poi accedere con credenziali corrispondenti." },
    { type: "paragraph",html: "Ecco il punto in cui si inciampa. Tradovate non è una voce a un clic in cima all’elenco dei provider di MotiveWave. MotiveWave è neutrale rispetto ai broker e raggiunge i conti futures tramite connettori gateway, principalmente CQG e Rithmic, oltre a una propria lista crescente di integrazioni dirette. Il percorso usato dal suo conto Tradovate dipende da come è stato creato il conto e, se è un prop trader, dalla sua società. Chiarisca prima questo aspetto e il resto è una breve procedura guidata." },
    { type: "heading",text: "Cosa le serve" },
    {
      type: "list",
      items: [
        "MotiveWave installato e aggiornato (la procedura guidata di connessione cambia tra le versioni).",
        "Le credenziali corrispondenti al suo percorso: <strong class='text-white'>nome utente e password rilasciati dal suo broker o dalla sua prop firm</strong> per CQG o Rithmic, oppure un login Tradovate diretto se il suo conto e la sua versione di MotiveWave lo supportano.",
        "Conferma scritta del suo broker o della sua società su <strong class='text-white'>quale gateway usa il suo conto Tradovate per connettersi</strong>.",
        "Tutti gli accordi di borsa e di dati di mercato già accettati lato broker, in modo che le quotazioni non risultino bloccate una volta dentro.",
      ],
    },
    { type: "heading",text: "Collegare Tradovate a MotiveWave: passo dopo passo" },
    {
      type: "steps",
      items: [
        { title: "Confermi come si connette il suo conto Tradovate", html: "Non vada a intuito. Un conto ospitato da Tradovate può raggiungere MotiveWave tramite connettori diversi, e usare quello sbagliato è la principale causa di login falliti. Scriva al suo broker o alla sua prop firm e chieda chiaramente quale connessione usare in MotiveWave e quali credenziali la accompagnano. Molti conti futures e prop passano da <strong class='text-white'>CQG</strong> o <strong class='text-white'>Rithmic</strong>, e il login di quel gateway è spesso diverso dalla sua password web abituale di Tradovate. Annoti nome utente e password esatti e, per Rithmic, il nome del server o del sistema che le indicano." },
        { title: "Installi MotiveWave e avvii una nuova connessione", html: "Apra MotiveWave. Su un’installazione nuova la guida attraverso una breve configurazione: assegni un nome al <strong class='text-white'>workspace</strong>, poi le viene chiesto di aggiungere una connessione. Usa già MotiveWave? Apra invece il gestore delle connessioni, cerchi <strong class='text-white'>Configure Connections</strong> (o le impostazioni di connessione equivalenti nella sua versione) e avvii una <strong class='text-white'>New Connection</strong>. Entrambi i percorsi portano alla stessa schermata di selezione del provider." },
        { title: "Scelga il suo provider di servizio", html: "Ora scelga il provider che corrisponde a quanto confermato al punto 1. Se la sua versione di MotiveWave elenca un’opzione <strong class='text-white'>Tradovate</strong> diretta e il suo conto la supporta, la selezioni. In caso contrario, scelga il gateway attraverso cui passa il suo conto Tradovate, <strong class='text-white'>CQG</strong> oppure <strong class='text-white'>Rithmic</strong>. I nomi dei provider e le etichette dei menu cambiano tra le versioni di MotiveWave, quindi si basi sul percorso del suo conto anziché cercare una parola precisa. Se nulla nell’elenco corrisponde, è il segnale di tornare dal suo broker prima di sprecare tempo a digitare credenziali che non possono connettersi." },
        { title: "Inserisca il login e scelga Live o Demo", html: "Digiti <strong class='text-white'>nome utente e password</strong> del provider selezionato, quelli legati a quel percorso, non necessariamente il suo login web di Tradovate. Poi imposti l’ambiente: <strong class='text-white'>Live</strong> per un conto finanziato con denaro reale, oppure <strong class='text-white'>Demo</strong> / <strong class='text-white'>Simulated</strong> per un conto di valutazione o di pratica. Scegliendo il lato sbagliato si collegherà a un conto vuoto o verrà respinto al login. Se la schermata chiede un server o un gateway (comune con Rithmic), selezioni esattamente quello indicato dalla sua società. Controlli che non ci siano spazi in più o maiuscole errate prima di continuare. È una causa silenziosa e frequente di login falliti." },
        { title: "Concluda, si connetta e invii un ordine di prova", html: "Clicchi su <strong class='text-white'>Finish</strong>. La sua nuova connessione comparirà nella schermata di accesso di MotiveWave a ogni avvio. La selezioni e prema <strong class='text-white'>Continue</strong> (o Connect) per accedere. Conceda alcuni secondi all’handshake. Una volta connesso, apra un grafico, carichi lo strumento e verifichi che il suo conto compaia nel pannello di inserimento ordini o dei conti. Invii un <strong class='text-white'>piccolo ordine di prova</strong> su una demo o con un solo contratto per verificare l’intero percorso: ordine inviato, fill ricevuto, posizione visibile. Se un popup sui dati di mercato o sugli accordi la blocca subito dopo il collegamento del conto, è un problema noto: risolva l’abbonamento ai dati o l’accordo in sospeso lato broker." },
      ],
    },
    { type: "heading",text: "Opera con un conto prop o di valutazione?" },
    { type: "paragraph",html: "I conti prop aggiungono una complicazione. Il connettore che le è consentito usare, le piattaforme permesse e le regole di rischio variano in base alla società e alla dimensione del conto, quindi controlli le regole attuali della sua società prima di configurare qualsiasi cosa. Alcune società le forniscono credenziali Rithmic o CQG specificamente per piattaforme di terze parti come MotiveWave; altre limitano quali strumenti possono toccare una valutazione. Se la sua società blocca il percorso di cui ha bisogno, nessun nuovo tentativo di digitazione risolverà il problema." },
    { type: "heading",text: "Automatizzi tutto questo con PickMyTrade" },
    { type: "paragraph",html: "Non vuole lasciare un’app di grafici aperta su un PC di casa solo per catturare ogni segnale? <strong class='text-white'>PickMyTrade invia gli alert della sua strategia TradingView direttamente a Tradovate</strong>. Esecuzione nel cloud, senza una piattaforma desktop in funzione per eseguire i suoi ordini." },
  ] },
