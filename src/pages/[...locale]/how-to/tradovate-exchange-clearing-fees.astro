  ctaButtonText: { en: "Start Your Free 7-Day Trial", de: "Starten Sie Ihre kostenlose 7-Tage-Testphase", es: "Comience su prueba gratuita de 7 días", fr: "Commencez votre essai gratuit de 7 jours", it: "Inizi la prova gratuita di 7 giorni" },
  ctaUrl: "https://app.pickmytrade.trade/?register=true&utm_source=content&utm_medium=how-to",
  faqHeading: { en: "Frequently Asked Questions", de: "Häufig gestellte Fragen", es: "Preguntas frecuentes", fr: "Questions fréquentes", it: "Domande frequenti" },
  faqs: { en: [
    { q: "Can I avoid exchange, clearing, and NFA fees on Tradovate?", a: "No. They're set by the exchange, the clearing house, and the regulator, and passed through at cost. Upgrading your plan lowers commission only, these fees apply on Free, Monthly, and Lifetime the same way." },
    { q: "How much is the NFA fee per contract?", a: "It's $0.01 per side on futures through June 30, 2027, which works out to about $0.02 on a round turn. It's scheduled to increase to $0.02 per side on July 1, 2027." },
    { q: "Why is my micro contract's fee bigger than expected?", a: "The NFA fee is flat per side no matter the contract size, so on a low-cost micro it's a larger slice of the total. The exchange and clearing portion still scales down, but that fixed regulatory piece doesn't." },
