---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "tradovate-exchange-clearing-fees";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/how-to/${SLUG}`;

const META_TITLE = "Tradovate Exchange, Clearing & NFA Fees Explained";
const META_DESCRIPTION =
  "Exchange, clearing, and NFA fees get added to every futures trade on top of commissions. Learn what each pass-through fee is and why no plan waives them.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Tradovate Börsen-, Clearing- und NFA-Gebühren erklärt", es: "Tarifas de bolsa, compensación y NFA de Tradovate explicadas", fr: "Frais de bourse, de compensation et de la NFA chez Tradovate expliqués", it: "Commissioni di borsa, di clearing e NFA di Tradovate spiegate" },
  dek: { en: "Wondering why your Tradovate statement shows a bigger number than your plan's commission? Here's what exchange, clearing, and NFA fees actually are, and how to work out your true cost per trade.", de: "Sie fragen sich, warum Ihre Tradovate-Abrechnung einen höheren Betrag ausweist als die Provision Ihres Tarifs? Hier erfahren Sie, was Börsen-, Clearing- und NFA-Gebühren tatsächlich sind und wie Sie Ihre wahren Kosten pro Trade berechnen.", es: "¿Se pregunta por qué su estado de cuenta de Tradovate muestra una cifra mayor que la comisión de su plan? Aquí le explicamos qué son realmente las tarifas de bolsa, compensación y NFA, y cómo calcular su costo real por operación.", fr: "Vous vous demandez pourquoi votre relevé Tradovate affiche un montant supérieur à la commission de votre forfait ? Voici ce que sont réellement les frais de bourse, de compensation et de la NFA, et comment calculer votre coût réel par trade.", it: "Si chiede perché il suo estratto conto Tradovate mostra una cifra superiore alla commissione del suo piano? Ecco cosa sono davvero le commissioni di borsa, di clearing e NFA e come calcolare il suo costo reale per trade." },
  readTime: { en: "6 min read", de: "6 Min. Lesezeit", es: "Lectura de 6 min", fr: "Lecture : 6 min", it: "Lettura di 6 min" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "You picked a Tradovate plan, memorized the per-side commission, and then your statement showed a bigger number than you expected. That gap is exchange, clearing, and NFA fees, pass-through charges that ride along with every futures contract you trade. They aren't commission, and no membership tier makes them go away. Here's what each one is and how to work out your true cost per trade." },
    { type: "heading", text: "What Are Exchange, Clearing & NFA Fees?" },
    { type: "paragraph", html: "Commission is what your broker charges to route your order. These three fees are different, they're collected by outside parties and simply passed through to you at cost:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Exchange fee</strong>, charged by the exchange that lists the contract (CME, CBOT, NYMEX, or COMEX) for matching your trade.",
        "<strong class='text-white'>Clearing fee</strong>, charged for guaranteeing and settling the trade so both sides get paid.",
        "<strong class='text-white'>NFA fee</strong>, a small regulatory assessment the National Futures Association levies on every futures trade in the U.S.",
      ],
    },
    { type: "paragraph", html: "Because Tradovate collects these on behalf of the exchange, the clearing house, and the regulator, they show up on every plan, Free, Monthly, and Lifetime alike. Lowering your commission by moving up a tier does nothing to them." },
    { type: "heading", text: "Working Out Your Real Trade Cost: Step-by-Step" },
    {
      type: "steps",
      items: [
        { title: "Start With the Exchange Fee", html: "The exchange sets this one, not Tradovate, and it changes by product. Standard index e-minis like ES and NQ carry a meaningfully higher exchange fee than their micro cousins (MES, MNQ). As a rough guide, a standard index e-mini runs a little over a dollar per side in combined exchange-and-clearing cost, while a micro is a small fraction of that. Exchanges revise these schedules periodically, CME adjusted its transaction fees in April 2026, so pull the current number for your contract." },
        { title: "Add the Clearing Fee", html: "Clearing is the plumbing that stands behind your trade and makes sure it settles. The clearing fee is charged per contract and is usually small, often just a few cents, but it's there on every side. Tradovate publishes its <strong class='text-white'>All-In Commission Rates</strong> schedule that lays the exchange and clearing components out contract by contract, so you can see the exact pass-through cost next to the commission. That schedule is the cleanest place to confirm the real all-in number for whatever you trade." },
        { title: "Add the NFA Regulatory Fee", html: "This is the smallest and most predictable piece. The NFA assessment fee is a flat <strong class='text-white'>$0.01 per side</strong> on futures contracts through June 30, 2027, so about two cents on a full round turn. It's scheduled to rise to <strong class='text-white'>$0.02 per side</strong> on July 1, 2027. It applies to every futures trade regardless of contract size, which is why it barely registers on a standard e-mini but is proportionally more noticeable on a cheap micro." },
        { title: "Confirm the Total on Your Statement", html: "Add the three pieces to your per-side commission and you've got your true cost for one side; double it for a round turn. Then check it against reality. Open your Tradovate account statement or the Reports module and look at the itemized fee lines for a filled trade, commission, exchange, clearing, and regulatory fees usually break out separately. If your math matches the statement, you know your real cost per trade going forward." },
      ],
    },
    { type: "heading", text: "A Quick Worked Example" },
    { type: "paragraph", html: "Say you trade one standard index e-mini round turn (one contract in, one contract out). Your cost stacks up like this, treat the fee figures as approximate and confirm the live numbers first:" },
    {
      type: "table",
      headers: ["Cost component", "Per side", "Round turn (in + out)"],
      rows: [
        ["Commission (varies by plan)", "your plan's rate", "&times; 2"],
        ["Exchange + clearing fee", "~$1.10&ndash;$1.40", "~$2.20&ndash;$2.80"],
        ["NFA regulatory fee", "$0.01", "$0.02"],
      ],
    },
    { type: "paragraph", html: "Swap in a micro and the exchange and clearing portion drops to a fraction of the standard figure, while that $0.01 NFA charge stays exactly the same. That's why micros feel cheap per contract but the fixed fees eat a larger share of each trade." },
    { type: "heading", text: "Why This Matters" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>No surprises on your statement</strong>, you'll know the real number before you click buy, not after.",
        "<strong class='text-white'>Fair plan and broker comparisons</strong>, compare all-in cost, since commission alone hides these pass-throughs.",
        "<strong class='text-white'>Smarter scalping math</strong>, small-target trading lives or dies on total per-trade cost, fees included.",
        "<strong class='text-white'>Prop and evaluation accounts differ</strong>, some firms handle these fees their own way, and it varies by firm and account size, so check your firm's current rules.",
      ],
    },
    { type: "heading", text: "Automate This with PickMyTrade" },
    { type: "paragraph", html: "Once you know your true cost per trade, <strong class='text-white'>PickMyTrade sends your TradingView alerts straight to your Tradovate account</strong> so the strategy executes on its own, no manual clicks, no missed fills, whatever fees and commission tier apply." },
  ], de: [
    { type: "paragraph",html: "Sie haben einen Tradovate-Tarif gewählt, sich die Provision pro Seite eingeprägt, und dann zeigte Ihre Abrechnung einen höheren Betrag als erwartet. Diese Differenz sind Börsen-, Clearing- und NFA-Gebühren, durchgereichte Kosten, die jeden gehandelten Futures-Kontrakt begleiten. Sie sind keine Provision, und keine Mitgliedsstufe lässt sie verschwinden. Hier erfahren Sie, was die einzelnen Gebühren sind und wie Sie Ihre wahren Kosten pro Trade berechnen." },
    { type: "heading",text: "Was sind Börsen-, Clearing- und NFA-Gebühren?" },
    { type: "paragraph",html: "Die Provision ist das, was Ihr Broker für die Weiterleitung Ihrer Order berechnet. Diese drei Gebühren sind etwas anderes: Sie werden von externen Stellen erhoben und einfach zum Selbstkostenpreis an Sie weitergegeben:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Börsengebühr</strong>, erhoben von der Börse, an der der Kontrakt gelistet ist (CME, CBOT, NYMEX oder COMEX), für das Matching Ihres Trades.",
        "<strong class='text-white'>Clearing-Gebühr</strong>, erhoben für die Garantie und Abwicklung des Trades, damit beide Seiten bezahlt werden.",
        "<strong class='text-white'>NFA-Gebühr</strong>, eine geringe regulatorische Abgabe, die die National Futures Association auf jeden Futures-Trade in den USA erhebt.",
      ],
    },
    { type: "paragraph",html: "Da Tradovate diese Gebühren im Auftrag der Börse, des Clearinghauses und der Aufsichtsbehörde einzieht, erscheinen sie bei jedem Tarif, ob Free, Monthly oder Lifetime. Eine niedrigere Provision durch den Wechsel in eine höhere Stufe ändert daran nichts." },
    { type: "heading",text: "Ihre tatsächlichen Handelskosten berechnen: Schritt für Schritt" },
    {
      type: "steps",
      items: [
        { title: "Beginnen Sie mit der Börsengebühr", html: "Diese Gebühr legt die Börse fest, nicht Tradovate, und sie variiert je nach Produkt. Standard-Index-E-Minis wie ES und NQ haben eine deutlich höhere Börsengebühr als ihre Micro-Verwandten (MES, MNQ). Als grobe Orientierung: Ein Standard-Index-E-Mini kostet bei Börsen- und Clearing-Gebühren zusammen etwas mehr als einen Dollar pro Seite, ein Micro nur einen Bruchteil davon. Börsen überarbeiten diese Gebührenordnungen regelmäßig; die CME hat ihre Transaktionsgebühren im April 2026 angepasst, rufen Sie daher den aktuellen Wert für Ihren Kontrakt ab." },
        { title: "Fügen Sie die Clearing-Gebühr hinzu", html: "Das Clearing ist die Infrastruktur, die hinter Ihrem Trade steht und dafür sorgt, dass er abgewickelt wird. Die Clearing-Gebühr wird pro Kontrakt erhoben und ist meist gering, oft nur wenige Cent, fällt aber auf jeder Seite an. Tradovate veröffentlicht seine Preisliste <strong class='text-white'>All-In Commission Rates</strong>, die Börsen- und Clearing-Anteile Kontrakt für Kontrakt aufschlüsselt, sodass Sie die genauen durchgereichten Kosten neben der Provision sehen können. Diese Übersicht ist der sauberste Ort, um die tatsächlichen Gesamtkosten für das zu prüfen, was Sie handeln." },
        { title: "Fügen Sie die regulatorische NFA-Gebühr hinzu", html: "Dies ist der kleinste und am besten vorhersehbare Posten. Die NFA-Abgabe beträgt bis zum 30. Juni 2027 pauschal <strong class='text-white'>$0.01 pro Seite</strong> auf Futures-Kontrakte, also etwa zwei Cent für einen vollständigen Round Turn. Am 1. Juli 2027 soll sie auf <strong class='text-white'>$0.02 pro Seite</strong> steigen. Sie gilt für jeden Futures-Trade unabhängig von der Kontraktgröße, weshalb sie bei einem Standard-E-Mini kaum auffällt, bei einem günstigen Micro aber verhältnismäßig stärker ins Gewicht fällt." },
        { title: "Bestätigen Sie die Summe auf Ihrer Abrechnung", html: "Addieren Sie die drei Posten zu Ihrer Provision pro Seite, und Sie haben Ihre wahren Kosten für eine Seite; verdoppeln Sie sie für einen Round Turn. Prüfen Sie das Ergebnis anschließend an der Realität. Öffnen Sie Ihre Tradovate-Kontoabrechnung oder das Modul Reports und sehen Sie sich die einzeln aufgeführten Gebührenzeilen eines ausgeführten Trades an; Provision, Börsen-, Clearing- und regulatorische Gebühren werden in der Regel getrennt ausgewiesen. Wenn Ihre Rechnung mit der Abrechnung übereinstimmt, kennen Sie Ihre tatsächlichen Kosten pro Trade für die Zukunft." },
      ],
    },
    { type: "heading",text: "Ein kurzes Rechenbeispiel" },
    { type: "paragraph",html: "Angenommen, Sie handeln einen Round Turn in einem Standard-Index-E-Mini (ein Kontrakt rein, ein Kontrakt raus). Ihre Kosten setzen sich wie folgt zusammen; betrachten Sie die Gebührenwerte als ungefähre Angaben und bestätigen Sie zuerst die aktuellen Zahlen:" },
    { type: "table", headers: ["Kostenposition","Pro Seite","Round Turn (rein + raus)"], rows: [
      ["Provision (je nach Tarif)","der Satz Ihres Tarifs","&times; 2"],
      ["Börsen- + Clearing-Gebühr","~$1.10&ndash;$1.40","~$2.20&ndash;$2.80"],
      ["Regulatorische NFA-Gebühr","$0.01","$0.02"],
    ] },
    { type: "paragraph",html: "Wechseln Sie zu einem Micro, sinkt der Börsen- und Clearing-Anteil auf einen Bruchteil des Standardwerts, während die NFA-Gebühr von $0.01 exakt gleich bleibt. Deshalb wirken Micros pro Kontrakt günstig, während die festen Gebühren einen größeren Anteil jedes Trades auffressen." },
    { type: "heading",text: "Warum das wichtig ist" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Keine Überraschungen auf Ihrer Abrechnung</strong>, Sie kennen den tatsächlichen Betrag, bevor Sie auf Kaufen klicken, nicht erst danach.",
        "<strong class='text-white'>Faire Tarif- und Broker-Vergleiche</strong>, vergleichen Sie die Gesamtkosten, denn die Provision allein verbirgt diese durchgereichten Gebühren.",
        "<strong class='text-white'>Bessere Scalping-Rechnung</strong>, Handel mit kleinen Zielen steht und fällt mit den gesamten Kosten pro Trade, Gebühren eingeschlossen.",
        "<strong class='text-white'>Prop- und Evaluierungskonten unterscheiden sich</strong>, manche Firmen handhaben diese Gebühren auf eigene Weise, abhängig von Firma und Kontogröße; prüfen Sie daher die aktuellen Regeln Ihrer Firma.",
      ],
    },
    { type: "heading",text: "Automatisieren Sie dies mit PickMyTrade" },
    { type: "paragraph",html: "Sobald Sie Ihre wahren Kosten pro Trade kennen, <strong class='text-white'>sendet PickMyTrade Ihre TradingView-Alerts direkt an Ihr Tradovate-Konto</strong>, damit die Strategie von selbst ausgeführt wird, ohne manuelle Klicks und ohne verpasste Ausführungen, unabhängig davon, welche Gebühren und Provisionsstufe gelten." },
  ], es: [
    { type: "paragraph",html: "Eligió un plan de Tradovate, memorizó la comisión por lado y luego su estado de cuenta mostró una cifra mayor de la esperada. Esa diferencia son las tarifas de bolsa, compensación y NFA, cargos trasladados que acompañan a cada contrato de futuros que opera. No son comisión, y ningún nivel de membresía las elimina. Aquí le explicamos qué es cada una y cómo calcular su costo real por operación." },
    { type: "heading",text: "¿Qué son las tarifas de bolsa, compensación y NFA?" },
    { type: "paragraph",html: "La comisión es lo que su bróker cobra por enrutar su orden. Estas tres tarifas son diferentes: las cobran terceros y simplemente se le trasladan al costo:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Tarifa de bolsa</strong>, cobrada por la bolsa que lista el contrato (CME, CBOT, NYMEX o COMEX) por casar su operación.",
        "<strong class='text-white'>Tarifa de compensación</strong>, cobrada por garantizar y liquidar la operación para que ambas partes cobren.",
        "<strong class='text-white'>Tarifa de la NFA</strong>, una pequeña cuota regulatoria que la National Futures Association aplica a cada operación de futuros en EE. UU.",
      ],
    },
    { type: "paragraph",html: "Como Tradovate las cobra en nombre de la bolsa, la cámara de compensación y el regulador, aparecen en todos los planes: Free, Monthly y Lifetime por igual. Reducir su comisión al subir de nivel no las afecta en absoluto." },
    { type: "heading",text: "Cómo calcular el costo real de su operación: paso a paso" },
    {
      type: "steps",
      items: [
        { title: "Comience con la tarifa de bolsa", html: "La fija la bolsa, no Tradovate, y cambia según el producto. Los e-minis de índices estándar como ES y NQ tienen una tarifa de bolsa notablemente mayor que sus primos micro (MES, MNQ). Como guía aproximada, un e-mini de índice estándar cuesta algo más de un dólar por lado entre bolsa y compensación combinadas, mientras que un micro es una pequeña fracción de eso. Las bolsas revisan estos cuadros de tarifas periódicamente; CME ajustó sus tarifas de transacción en abril de 2026, así que consulte la cifra vigente de su contrato." },
        { title: "Sume la tarifa de compensación", html: "La compensación es la infraestructura que respalda su operación y garantiza que se liquide. La tarifa de compensación se cobra por contrato y suele ser pequeña, a menudo solo unos centavos, pero está presente en cada lado. Tradovate publica su cuadro <strong class='text-white'>All-In Commission Rates</strong>, que detalla los componentes de bolsa y compensación contrato por contrato, de modo que puede ver el costo trasladado exacto junto a la comisión. Ese cuadro es el lugar más claro para confirmar la cifra total real de lo que usted opera." },
        { title: "Sume la tarifa regulatoria de la NFA", html: "Es la pieza más pequeña y más predecible. La cuota de evaluación de la NFA es fija: <strong class='text-white'>$0.01 por lado</strong> en contratos de futuros hasta el 30 de junio de 2027, es decir, unos dos centavos en un round turn completo. Está previsto que suba a <strong class='text-white'>$0.02 por lado</strong> el 1 de julio de 2027. Se aplica a toda operación de futuros sin importar el tamaño del contrato, por lo que apenas se nota en un e-mini estándar, pero resulta proporcionalmente más visible en un micro barato." },
        { title: "Confirme el total en su estado de cuenta", html: "Sume las tres piezas a su comisión por lado y obtendrá su costo real de un lado; duplíquelo para un round turn. Luego compárelo con la realidad. Abra su estado de cuenta de Tradovate o el módulo Reports y revise las líneas de tarifas detalladas de una operación ejecutada; la comisión y las tarifas de bolsa, compensación y regulatorias suelen aparecer por separado. Si sus cálculos coinciden con el estado de cuenta, ya sabe cuál será su costo real por operación en adelante." },
      ],
    },
    { type: "heading",text: "Un ejemplo práctico rápido" },
    { type: "paragraph",html: "Supongamos que opera un round turn de un e-mini de índice estándar (un contrato de entrada, uno de salida). Su costo se compone así; trate las cifras de tarifas como aproximadas y confirme primero los valores vigentes:" },
    { type: "table", headers: ["Componente del costo","Por lado","Round turn (entrada + salida)"], rows: [
      ["Comisión (varía según el plan)","la tarifa de su plan","&times; 2"],
      ["Tarifa de bolsa + compensación","~$1.10&ndash;$1.40","~$2.20&ndash;$2.80"],
      ["Tarifa regulatoria de la NFA","$0.01","$0.02"],
    ] },
    { type: "paragraph",html: "Si cambia a un micro, la parte de bolsa y compensación baja a una fracción de la cifra estándar, mientras que el cargo de $0.01 de la NFA se mantiene exactamente igual. Por eso los micros parecen baratos por contrato, pero las tarifas fijas se llevan una porción mayor de cada operación." },
    { type: "heading",text: "Por qué es importante" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Sin sorpresas en su estado de cuenta</strong>, conocerá la cifra real antes de hacer clic en comprar, no después.",
        "<strong class='text-white'>Comparaciones justas de planes y brókeres</strong>, compare el costo total, ya que la comisión por sí sola oculta estos cargos trasladados.",
        "<strong class='text-white'>Mejores cálculos de scalping</strong>, el trading de objetivos pequeños depende del costo total por operación, tarifas incluidas.",
        "<strong class='text-white'>Las cuentas prop y de evaluación difieren</strong>, algunas firmas manejan estas tarifas a su manera, según la firma y el tamaño de la cuenta, así que consulte las reglas vigentes de su firma.",
      ],
    },
    { type: "heading",text: "Automatice esto con PickMyTrade" },
    { type: "paragraph",html: "Una vez que conozca su costo real por operación, <strong class='text-white'>PickMyTrade envía sus alertas de TradingView directamente a su cuenta de Tradovate</strong> para que la estrategia se ejecute sola, sin clics manuales y sin ejecuciones perdidas, sean cuales sean las tarifas y el nivel de comisión que apliquen." },
  ], fr: [
    { type: "paragraph",html: "Vous avez choisi un forfait Tradovate, mémorisé la commission par côté, puis votre relevé a affiché un montant supérieur à celui attendu. Cet écart correspond aux frais de bourse, de compensation et de la NFA, des frais répercutés qui accompagnent chaque contrat à terme que vous négociez. Ce ne sont pas des commissions, et aucun niveau d'abonnement ne les fait disparaître. Voici ce que représente chacun d'eux et comment calculer votre coût réel par trade." },
    { type: "heading",text: "Que sont les frais de bourse, de compensation et de la NFA ?" },
    { type: "paragraph",html: "La commission est ce que votre courtier facture pour acheminer votre ordre. Ces trois frais sont différents : ils sont perçus par des tiers et simplement répercutés au prix coûtant :" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Frais de bourse</strong>, facturés par la bourse qui cote le contrat (CME, CBOT, NYMEX ou COMEX) pour l'appariement de votre trade.",
        "<strong class='text-white'>Frais de compensation</strong>, facturés pour garantir et régler le trade afin que les deux parties soient payées.",
        "<strong class='text-white'>Frais de la NFA</strong>, une petite redevance réglementaire que la National Futures Association prélève sur chaque trade de contrats à terme aux États-Unis.",
      ],
    },
    { type: "paragraph",html: "Comme Tradovate les perçoit pour le compte de la bourse, de la chambre de compensation et du régulateur, ils apparaissent sur tous les forfaits, Free, Monthly et Lifetime confondus. Réduire votre commission en passant à un niveau supérieur n'y change rien." },
    { type: "heading",text: "Calculer votre coût réel par trade : étape par étape" },
    {
      type: "steps",
      items: [
        { title: "Commencez par les frais de bourse", html: "C'est la bourse qui les fixe, pas Tradovate, et ils varient selon le produit. Les e-minis d'indices standard comme ES et NQ supportent des frais de bourse nettement plus élevés que leurs cousins micro (MES, MNQ). À titre indicatif, un e-mini d'indice standard coûte un peu plus d'un dollar par côté en frais de bourse et de compensation combinés, tandis qu'un micro n'en représente qu'une petite fraction. Les bourses révisent régulièrement ces barèmes ; le CME a ajusté ses frais de transaction en avril 2026, consultez donc le montant en vigueur pour votre contrat." },
        { title: "Ajoutez les frais de compensation", html: "La compensation est le mécanisme qui soutient votre trade et garantit son règlement. Les frais de compensation sont facturés par contrat et restent généralement faibles, souvent quelques centimes seulement, mais ils s'appliquent à chaque côté. Tradovate publie son barème <strong class='text-white'>All-In Commission Rates</strong>, qui détaille les composantes bourse et compensation contrat par contrat, ce qui vous permet de voir le coût répercuté exact à côté de la commission. Ce barème est l'endroit le plus clair pour confirmer le montant tout compris réel de ce que vous négociez." },
        { title: "Ajoutez les frais réglementaires de la NFA", html: "C'est l'élément le plus petit et le plus prévisible. La redevance d'évaluation de la NFA est fixe : <strong class='text-white'>$0.01 par côté</strong> sur les contrats à terme jusqu'au 30 juin 2027, soit environ deux cents pour un aller-retour complet. Elle doit passer à <strong class='text-white'>$0.02 par côté</strong> le 1er juillet 2027. Elle s'applique à chaque trade de contrats à terme quelle que soit la taille du contrat, ce qui explique qu'elle passe presque inaperçue sur un e-mini standard, mais pèse proportionnellement davantage sur un micro bon marché." },
        { title: "Vérifiez le total sur votre relevé", html: "Ajoutez les trois éléments à votre commission par côté pour obtenir votre coût réel d'un côté ; doublez-le pour un aller-retour. Confrontez ensuite ce calcul à la réalité. Ouvrez votre relevé de compte Tradovate ou le module Reports et consultez les lignes de frais détaillées d'un trade exécuté ; la commission ainsi que les frais de bourse, de compensation et réglementaires sont en général indiqués séparément. Si votre calcul correspond au relevé, vous connaissez votre coût réel par trade pour la suite." },
      ],
    },
    { type: "heading",text: "Un exemple chiffré rapide" },
    { type: "paragraph",html: "Imaginons que vous négociez un aller-retour sur un e-mini d'indice standard (un contrat à l'entrée, un contrat à la sortie). Votre coût se décompose ainsi ; considérez les montants des frais comme approximatifs et vérifiez d'abord les chiffres en vigueur :" },
    { type: "table", headers: ["Composante du coût","Par côté","Aller-retour (entrée + sortie)"], rows: [
      ["Commission (variable selon le forfait)","le tarif de votre forfait","&times; 2"],
      ["Frais de bourse + de compensation","~$1.10&ndash;$1.40","~$2.20&ndash;$2.80"],
      ["Frais réglementaires de la NFA","$0.01","$0.02"],
    ] },
    { type: "paragraph",html: "Avec un micro, la part bourse et compensation tombe à une fraction du montant standard, alors que les $0.01 de la NFA restent exactement les mêmes. C'est pourquoi les micros paraissent peu coûteux par contrat, alors que les frais fixes absorbent une part plus importante de chaque trade." },
    { type: "heading",text: "Pourquoi c'est important" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Aucune surprise sur votre relevé</strong>, vous connaîtrez le montant réel avant de cliquer sur acheter, et non après.",
        "<strong class='text-white'>Des comparaisons équitables entre forfaits et courtiers</strong>, comparez le coût tout compris, car la commission seule masque ces frais répercutés.",
        "<strong class='text-white'>Un calcul de scalping plus juste</strong>, le trading à petits objectifs se joue sur le coût total par trade, frais compris.",
        "<strong class='text-white'>Les comptes prop et d'évaluation diffèrent</strong>, certaines sociétés traitent ces frais à leur manière, selon la société et la taille du compte ; vérifiez donc les règles en vigueur de votre société.",
      ],
    },
    { type: "heading",text: "Automatisez tout cela avec PickMyTrade" },
    { type: "paragraph",html: "Une fois votre coût réel par trade connu, <strong class='text-white'>PickMyTrade envoie vos alertes TradingView directement vers votre compte Tradovate</strong> afin que la stratégie s'exécute toute seule, sans clics manuels et sans exécutions manquées, quels que soient les frais et le niveau de commission applicables." },
  ], it: [
    { type: "paragraph",html: "Ha scelto un piano Tradovate, ha memorizzato la commissione per lato e poi il suo estratto conto ha mostrato una cifra superiore al previsto. Quella differenza sono le commissioni di borsa, di clearing e NFA, oneri trasferiti che accompagnano ogni contratto future che negozia. Non sono commissioni del broker e nessun livello di abbonamento le fa sparire. Ecco cos'è ciascuna e come calcolare il suo costo reale per trade." },
    { type: "heading",text: "Cosa sono le commissioni di borsa, di clearing e NFA?" },
    { type: "paragraph",html: "La commissione è ciò che il suo broker addebita per instradare il suo ordine. Queste tre voci sono diverse: sono riscosse da soggetti esterni e semplicemente trasferite a lei a costo:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Commissione di borsa</strong>, addebitata dalla borsa che quota il contratto (CME, CBOT, NYMEX o COMEX) per l'abbinamento del suo trade.",
        "<strong class='text-white'>Commissione di clearing</strong>, addebitata per garantire e regolare il trade in modo che entrambe le parti vengano pagate.",
        "<strong class='text-white'>Commissione NFA</strong>, un piccolo contributo regolamentare che la National Futures Association applica a ogni trade di futures negli Stati Uniti.",
      ],
    },
    { type: "paragraph",html: "Poiché Tradovate le riscuote per conto della borsa, della stanza di compensazione e del regolatore, compaiono su ogni piano, Free, Monthly e Lifetime allo stesso modo. Ridurre la commissione passando a un livello superiore non le modifica in alcun modo." },
    { type: "heading",text: "Calcolare il suo costo reale per trade: passo dopo passo" },
    {
      type: "steps",
      items: [
        { title: "Parta dalla commissione di borsa", html: "La stabilisce la borsa, non Tradovate, e cambia a seconda del prodotto. Gli e-mini sugli indici standard come ES e NQ hanno una commissione di borsa sensibilmente più alta rispetto ai loro cugini micro (MES, MNQ). Come indicazione di massima, un e-mini su indice standard costa poco più di un dollaro per lato tra borsa e clearing combinati, mentre un micro ne è solo una piccola frazione. Le borse rivedono periodicamente questi tariffari; il CME ha modificato le proprie commissioni di transazione nell'aprile 2026, quindi verifichi il valore aggiornato per il suo contratto." },
        { title: "Aggiunga la commissione di clearing", html: "Il clearing è l'infrastruttura che sta dietro al suo trade e ne garantisce il regolamento. La commissione di clearing è addebitata per contratto ed è di solito modesta, spesso solo pochi centesimi, ma è presente su ogni lato. Tradovate pubblica il proprio tariffario <strong class='text-white'>All-In Commission Rates</strong>, che espone le componenti di borsa e di clearing contratto per contratto, così può vedere l'esatto costo trasferito accanto alla commissione. Quel tariffario è il posto più chiaro per confermare il valore complessivo reale di ciò che negozia." },
        { title: "Aggiunga la commissione regolamentare NFA", html: "Questa è la voce più piccola e più prevedibile. Il contributo NFA è fisso: <strong class='text-white'>$0.01 per lato</strong> sui contratti futures fino al 30 giugno 2027, cioè circa due centesimi su un round turn completo. È previsto un aumento a <strong class='text-white'>$0.02 per lato</strong> il 1° luglio 2027. Si applica a ogni trade di futures indipendentemente dalle dimensioni del contratto, motivo per cui incide pochissimo su un e-mini standard ma è proporzionalmente più evidente su un micro economico." },
        { title: "Confermi il totale sul suo estratto conto", html: "Sommi le tre voci alla sua commissione per lato e otterrà il suo costo reale per un lato; lo raddoppi per un round turn. Poi lo confronti con la realtà. Apra il suo estratto conto Tradovate o il modulo Reports e guardi le righe di spesa dettagliate di un trade eseguito; commissione, spese di borsa, di clearing e regolamentari sono in genere indicate separatamente. Se i suoi calcoli coincidono con l'estratto conto, conosce il suo costo reale per trade da qui in avanti." },
      ],
    },
    { type: "heading",text: "Un rapido esempio pratico" },
    { type: "paragraph",html: "Supponiamo che lei negozi un round turn su un e-mini su indice standard (un contratto in entrata, uno in uscita). Il suo costo si compone così; consideri le cifre delle commissioni come approssimative e confermi prima i valori aggiornati:" },
    { type: "table", headers: ["Componente di costo","Per lato","Round turn (entrata + uscita)"], rows: [
      ["Commissione (varia in base al piano)","la tariffa del suo piano","&times; 2"],
      ["Commissione di borsa + clearing","~$1.10&ndash;$1.40","~$2.20&ndash;$2.80"],
      ["Commissione regolamentare NFA","$0.01","$0.02"],
    ] },
    { type: "paragraph",html: "Se passa a un micro, la parte di borsa e clearing scende a una frazione del valore standard, mentre l'addebito NFA di $0.01 resta esattamente uguale. Ecco perché i micro sembrano economici per contratto, ma le commissioni fisse incidono maggiormente su ogni trade." },
    { type: "heading",text: "Perché è importante" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Nessuna sorpresa sul suo estratto conto</strong>, conoscerà la cifra reale prima di cliccare su compra, non dopo.",
        "<strong class='text-white'>Confronti equi tra piani e broker</strong>, confronti il costo complessivo, perché la sola commissione nasconde questi oneri trasferiti.",
        "<strong class='text-white'>Calcoli di scalping più accurati</strong>, il trading con obiettivi piccoli dipende dal costo totale per trade, commissioni incluse.",
        "<strong class='text-white'>I conti prop e di valutazione differiscono</strong>, alcune società gestiscono queste commissioni a modo proprio, in base alla società e alle dimensioni del conto, perciò verifichi le regole attuali della sua società.",
      ],
    },
    { type: "heading",text: "Automatizzi tutto questo con PickMyTrade" },
    { type: "paragraph",html: "Una volta noto il suo costo reale per trade, <strong class='text-white'>PickMyTrade invia i suoi alert di TradingView direttamente al suo conto Tradovate</strong> così la strategia si esegue da sola, senza clic manuali e senza esecuzioni perse, indipendentemente dalle commissioni e dal livello di commissione applicati." },
  ] },
  ctaHeading: { en: "Know Your Costs, Then Automate the Rest", de: "Kennen Sie Ihre Kosten und automatisieren Sie den Rest", es: "Conozca sus costos y automatice el resto", fr: "Connaissez vos coûts, puis automatisez le reste", it: "Conosca i suoi costi, poi automatizzi il resto" },
