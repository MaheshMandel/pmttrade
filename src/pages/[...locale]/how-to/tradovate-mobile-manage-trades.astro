---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "tradovate-mobile-manage-trades";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/how-to/${SLUG}`;

const META_TITLE = "Set Stops & Close Trades on Tradovate Mobile";
const META_DESCRIPTION =
  "Set a stop-loss and close any futures position from the Tradovate mobile app. Add a protective stop and exit a trade in just a few taps.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Stopps setzen und Trades schließen in der Tradovate-Mobile-App", es: "Colocar stops y cerrar operaciones en Tradovate Mobile", fr: "Placer des stops et clôturer des trades sur Tradovate Mobile", it: "Impostare stop e chiudere trade su Tradovate Mobile" },
  dek: { en: "A news spike hits while you're grabbing lunch, and you need to drop a stop or flatten a position in a handful of taps. Here's how to attach a protective stop and close a trade from the Tradovate mobile app.", de: "Während Ihrer Mittagspause schlägt eine Nachrichtenspitze zu, und Sie müssen mit wenigen Fingertipps einen Stopp setzen oder eine Position glattstellen. So hängen Sie in der Tradovate-Mobile-App einen Schutz-Stopp an und schließen einen Trade.", es: "Una noticia dispara el mercado mientras almuerza y necesita colocar un stop o cerrar una posición con unos pocos toques. Así se adjunta un stop de protección y se cierra una operación desde la app móvil de Tradovate.", fr: "Une annonce fait bondir le marché pendant votre déjeuner et vous devez poser un stop ou clôturer une position en quelques pressions. Voici comment attacher un stop de protection et clôturer un trade depuis l’application mobile Tradovate.", it: "Una notizia scuote il mercato mentre è a pranzo e deve piazzare uno stop o chiudere una posizione con pochi tocchi. Ecco come allegare uno stop di protezione e chiudere un trade dall’app mobile di Tradovate." },
  readTime: { en: "5 min read", de: "5 Min. Lesezeit", es: "Lectura de 5 min", fr: "Lecture : 5 min", it: "Lettura di 5 min" },
  lastUpdated: "2026-07-10",
  blocks: { en: [
    { type: "paragraph", html: "The phone app is where you manage risk when you're nowhere near your desk. A news spike hits while you're grabbing lunch, and you need to drop a stop or flatten a position in a handful of taps. This guide covers both jobs on the Tradovate mobile app: attaching a protective stop to a trade, and closing a position when you want out." },
    { type: "heading", text: "What You Can Do From the Mobile Order Ticket" },
    { type: "paragraph", html: "The mobile app gives you the same core controls as the web platform, just laid out for a small screen. From the order ticket you can fire an entry, switch the order type to a <strong class='text-white'>Stop</strong>, <strong class='text-white'>Stop Limit</strong>, or <strong class='text-white'>Trailing Stop</strong>, and send it as protection on an open trade. The <strong class='text-white'>My Positions</strong> panel is where you watch what's live and exit it. Get comfortable with these two screens and you can run a full trade from your phone without ever touching a laptop." },
    { type: "heading", text: "Set a Stop and Close a Trade on Tradovate Mobile: Step-by-Step" },
    {
      type: "steps",
      items: [
        { title: "Open the Order Ticket", html: "Tap the <strong class='text-white'>menu icon (&#9776;)</strong> in the top-left corner and choose <strong class='text-white'>Trade</strong>. If you'd rather pick from a list, tap the menu, open <strong class='text-white'>Markets</strong>, select your instrument, then tap <strong class='text-white'>Trade</strong> on its detail screen. Either path lands you on the order ticket, where you set the contract, choose <strong class='text-white'>Buy</strong> or <strong class='text-white'>Sell</strong>, and set your quantity." },
        { title: "Pick a Stop Order Type", html: "On the order ticket, open the <strong class='text-white'>order-type selector</strong> near the top of the screen. By default you're on a Market or Limit order, so switch it to <strong class='text-white'>Stop</strong> (a stop market), <strong class='text-white'>Stop Limit</strong>, or <strong class='text-white'>Trailing Stop</strong> depending on how you want the exit to behave. A plain Stop guarantees you're out once price trades through your level; a Trailing Stop follows the market tick-for-tick as it moves your way and holds when it turns against you." },
        { title: "Set the Stop Level and Send It", html: "Enter the <strong class='text-white'>trigger price</strong> for a stop, or the <strong class='text-white'>trail distance</strong> for a trailing stop, double-check the side and quantity, then tap <strong class='text-white'>Send</strong>. The stop now sits in your account as a working order, ready to close the position if price hits it. If you're on a prop-firm evaluation, a hard stop on every trade is usually non-negotiable, and the required distance or max risk varies by firm and account size, so check your firm's current rules before you size up." },
        { title: "Move or Cancel a Stop on an Open Position", html: "Markets move, and your stop should move with your plan. Open your <strong class='text-white'>working orders</strong> from the position or Orders view and tap the resting stop to change its price, or grab the <strong class='text-white'>stop line on the mobile chart</strong> and drag it to a new level to trail up to breakeven. Want out of the stop entirely? Cancel it the same way. Give the app a second to confirm the change landed before you look away." },
        { title: "Close the Position", html: "To exit, tap the menu, open <strong class='text-white'>Markets</strong>, and scroll across to the <strong class='text-white'>My Positions</strong> panel. Tap <strong class='text-white'>CANCEL ALL &amp; EXIT ALL</strong> and the app flattens your position at market and clears any working orders tied to it in a single move. That one button is your emergency exit when a trade goes sideways and you just need to be flat. If you're only closing one of several contracts or positions, use the per-position close control instead so you don't wipe out the rest." },
      ],
    },
    { type: "heading", text: "Why Manage Trades From Your Phone" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>React anywhere</strong> so a fast move against you doesn't sit unmanaged while you're away from the desk.",
        "<strong class='text-white'>Keep a hard stop on every trade</strong>, which most prop firms require and every risk plan should.",
        "<strong class='text-white'>Flatten in one tap</strong> with CANCEL ALL &amp; EXIT ALL when you need to be out right now.",
        "<strong class='text-white'>Trail your stop on the go</strong> by dragging the line up to breakeven as the trade works.",
        "<strong class='text-white'>Stay in sync</strong> with your desktop, since it's the same account on every device.",
      ],
    },
    { type: "heading", text: "Let PickMyTrade Handle the Exit for You" },
    { type: "paragraph", html: "Reacting on your phone works, but you still have to see the move and tap in time. <strong class='text-white'>PickMyTrade fires your TradingView alerts straight into your Tradovate account</strong> and attaches the stop and target automatically, so every signal enters and exits with a full bracket even when your phone is in your pocket." },
  ], de: [
    { type: "paragraph",html: "Die Handy-App ist der Ort, an dem Sie Ihr Risiko steuern, wenn Sie weit weg vom Schreibtisch sind. Während Ihrer Mittagspause schlägt eine Nachrichtenspitze zu, und Sie müssen mit wenigen Fingertipps einen Stopp setzen oder eine Position glattstellen. Dieser Leitfaden behandelt beide Aufgaben in der Tradovate-Mobile-App: einen Schutz-Stopp an einen Trade anhängen und eine Position schließen, wenn Sie aussteigen möchten." },
    { type: "heading",text: "Was Sie im mobilen Order-Ticket tun können" },
    { type: "paragraph",html: "Die Mobile-App bietet Ihnen dieselben Kernfunktionen wie die Web-Plattform, nur für einen kleinen Bildschirm aufbereitet. Im Order-Ticket können Sie einen Einstieg auslösen, den Ordertyp auf <strong class='text-white'>Stop</strong>, <strong class='text-white'>Stop Limit</strong> oder <strong class='text-white'>Trailing Stop</strong> umstellen und ihn als Schutz für einen offenen Trade senden. Im Bereich <strong class='text-white'>My Positions</strong> sehen Sie, was aktuell läuft, und können es beenden. Wenn Sie mit diesen beiden Ansichten vertraut sind, können Sie einen kompletten Trade vom Handy aus führen, ohne je einen Laptop anzufassen." },
    { type: "heading",text: "Stopp setzen und Trade schließen in Tradovate Mobile: Schritt für Schritt" },
    {
      type: "steps",
      items: [
        { title: "Öffnen Sie das Order-Ticket", html: "Tippen Sie oben links auf das <strong class='text-white'>Menüsymbol (&#9776;)</strong> und wählen Sie <strong class='text-white'>Trade</strong>. Wenn Sie lieber aus einer Liste auswählen, tippen Sie auf das Menü, öffnen <strong class='text-white'>Markets</strong>, wählen Ihr Instrument und tippen dann auf dem Detailbildschirm auf <strong class='text-white'>Trade</strong>. Beide Wege führen Sie zum Order-Ticket, wo Sie den Kontrakt festlegen, <strong class='text-white'>Buy</strong> oder <strong class='text-white'>Sell</strong> wählen und Ihre Stückzahl einstellen." },
        { title: "Wählen Sie einen Stop-Ordertyp", html: "Öffnen Sie im Order-Ticket die <strong class='text-white'>Ordertyp-Auswahl</strong> oben auf dem Bildschirm. Standardmäßig ist eine Market- oder Limit-Order eingestellt. Wechseln Sie daher je nach gewünschtem Ausstiegsverhalten zu <strong class='text-white'>Stop</strong> (Stop-Market), <strong class='text-white'>Stop Limit</strong> oder <strong class='text-white'>Trailing Stop</strong>. Ein einfacher Stop garantiert den Ausstieg, sobald der Kurs Ihr Niveau durchläuft; ein Trailing Stop folgt dem Markt Tick für Tick, wenn er in Ihre Richtung läuft, und bleibt stehen, wenn er sich dreht." },
        { title: "Stopp-Niveau festlegen und senden", html: "Geben Sie den <strong class='text-white'>Auslösepreis</strong> für einen Stopp oder den <strong class='text-white'>Trailing-Abstand</strong> für einen Trailing Stop ein, prüfen Sie Seite und Stückzahl noch einmal und tippen Sie dann auf <strong class='text-white'>Send</strong>. Der Stopp liegt nun als aktive Order in Ihrem Konto und schließt die Position, sobald der Kurs ihn erreicht. Wenn Sie sich in einer Prop-Firm-Evaluierung befinden, ist ein fester Stopp bei jedem Trade in der Regel Pflicht; der erforderliche Abstand oder das maximale Risiko variiert je nach Firma und Kontogröße. Prüfen Sie daher die aktuellen Regeln Ihrer Firma, bevor Sie Ihre Positionsgröße erhöhen." },
        { title: "Stopp bei offener Position verschieben oder stornieren", html: "Märkte bewegen sich, und Ihr Stopp sollte sich mit Ihrem Plan bewegen. Öffnen Sie Ihre <strong class='text-white'>aktiven Orders</strong> in der Positions- oder Orders-Ansicht und tippen Sie auf den bestehenden Stopp, um den Preis zu ändern, oder ziehen Sie die <strong class='text-white'>Stopp-Linie im mobilen Chart</strong> auf ein neues Niveau, um ihn auf Breakeven nachzuziehen. Möchten Sie den Stopp ganz entfernen? Stornieren Sie ihn auf dieselbe Weise. Geben Sie der App eine Sekunde, um die Änderung zu bestätigen, bevor Sie wegschauen." },
        { title: "Position schließen", html: "Zum Ausstieg tippen Sie auf das Menü, öffnen <strong class='text-white'>Markets</strong> und scrollen seitlich zum Bereich <strong class='text-white'>My Positions</strong>. Tippen Sie auf <strong class='text-white'>CANCEL ALL &amp; EXIT ALL</strong>, und die App stellt Ihre Position zum Marktpreis glatt und löscht in einem Zug alle damit verbundenen aktiven Orders. Diese eine Schaltfläche ist Ihr Notausgang, wenn ein Trade aus dem Ruder läuft und Sie einfach flat sein müssen. Wenn Sie nur einen von mehreren Kontrakten oder Positionen schließen, verwenden Sie stattdessen die Schließen-Funktion der jeweiligen Position, damit Sie nicht alles andere mit auflösen." },
      ],
    },
    { type: "heading",text: "Warum Sie Trades vom Handy aus verwalten sollten" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Überall reagieren</strong>, damit eine schnelle Bewegung gegen Sie nicht unbeaufsichtigt bleibt, während Sie nicht am Schreibtisch sind.",
        "<strong class='text-white'>Bei jedem Trade einen festen Stopp halten</strong>, was die meisten Prop-Firmen verlangen und jeder Risikoplan enthalten sollte.",
        "<strong class='text-white'>Mit einem Tipp glattstellen</strong> per CANCEL ALL &amp; EXIT ALL, wenn Sie sofort raus müssen.",
        "<strong class='text-white'>Ihren Stopp unterwegs nachziehen</strong>, indem Sie die Linie auf Breakeven ziehen, während der Trade läuft.",
        "<strong class='text-white'>Synchron bleiben</strong> mit Ihrem Desktop, denn es ist auf jedem Gerät dasselbe Konto.",
      ],
    },
    { type: "heading",text: "Lassen Sie PickMyTrade den Ausstieg für Sie übernehmen" },
    { type: "paragraph",html: "Auf dem Handy zu reagieren funktioniert, aber Sie müssen die Bewegung trotzdem sehen und rechtzeitig tippen. <strong class='text-white'>PickMyTrade leitet Ihre TradingView-Alerts direkt in Ihr Tradovate-Konto weiter</strong> und hängt Stopp und Kursziel automatisch an, sodass jedes Signal mit einem vollständigen Bracket ein- und aussteigt, auch wenn Ihr Handy in der Tasche steckt." },
  ], es: [
    { type: "paragraph",html: "La app del teléfono es donde gestiona el riesgo cuando está lejos de su escritorio. Una noticia dispara el mercado mientras almuerza y necesita colocar un stop o cerrar una posición con unos pocos toques. Esta guía cubre ambas tareas en la app móvil de Tradovate: adjuntar un stop de protección a una operación y cerrar una posición cuando quiera salir." },
    { type: "heading",text: "Qué puede hacer desde el ticket de orden móvil" },
    { type: "paragraph",html: "La app móvil le ofrece los mismos controles básicos que la plataforma web, solo que adaptados a una pantalla pequeña. Desde el ticket de orden puede lanzar una entrada, cambiar el tipo de orden a <strong class='text-white'>Stop</strong>, <strong class='text-white'>Stop Limit</strong> o <strong class='text-white'>Trailing Stop</strong> y enviarla como protección de una operación abierta. El panel <strong class='text-white'>My Positions</strong> es donde ve lo que está activo y lo cierra. Si se familiariza con estas dos pantallas, podrá gestionar una operación completa desde el teléfono sin tocar nunca un portátil." },
    { type: "heading",text: "Colocar un stop y cerrar una operación en Tradovate Mobile: paso a paso" },
    {
      type: "steps",
      items: [
        { title: "Abra el ticket de orden", html: "Toque el <strong class='text-white'>icono de menú (&#9776;)</strong> en la esquina superior izquierda y elija <strong class='text-white'>Trade</strong>. Si prefiere elegir de una lista, toque el menú, abra <strong class='text-white'>Markets</strong>, seleccione su instrumento y toque <strong class='text-white'>Trade</strong> en su pantalla de detalle. Ambos caminos le llevan al ticket de orden, donde define el contrato, elige <strong class='text-white'>Buy</strong> o <strong class='text-white'>Sell</strong> y establece la cantidad." },
        { title: "Elija un tipo de orden stop", html: "En el ticket de orden, abra el <strong class='text-white'>selector de tipo de orden</strong> en la parte superior de la pantalla. Por defecto está en una orden Market o Limit, así que cámbiela a <strong class='text-white'>Stop</strong> (stop a mercado), <strong class='text-white'>Stop Limit</strong> o <strong class='text-white'>Trailing Stop</strong> según cómo quiera que se comporte la salida. Un Stop simple garantiza que saldrá cuando el precio cruce su nivel; un Trailing Stop sigue al mercado tick a tick cuando se mueve a su favor y se mantiene cuando gira en contra." },
        { title: "Defina el nivel del stop y envíelo", html: "Introduzca el <strong class='text-white'>precio de activación</strong> para un stop, o la <strong class='text-white'>distancia de seguimiento</strong> para un trailing stop, verifique de nuevo el lado y la cantidad y toque <strong class='text-white'>Send</strong>. El stop queda ahora en su cuenta como orden activa, listo para cerrar la posición si el precio lo alcanza. Si está en una evaluación de una prop firm, un stop fijo en cada operación suele ser obligatorio, y la distancia exigida o el riesgo máximo varían según la firma y el tamaño de la cuenta, así que revise las reglas vigentes de su firma antes de aumentar el tamaño." },
        { title: "Mueva o cancele un stop en una posición abierta", html: "Los mercados se mueven y su stop debe moverse con su plan. Abra sus <strong class='text-white'>órdenes activas</strong> desde la vista de posición o de órdenes y toque el stop pendiente para cambiar su precio, o tome la <strong class='text-white'>línea del stop en el gráfico móvil</strong> y arrástrela a un nuevo nivel para llevarla a breakeven. ¿Quiere eliminar el stop por completo? Cancélelo de la misma manera. Dé a la app un segundo para confirmar que el cambio se aplicó antes de apartar la vista." },
        { title: "Cierre la posición", html: "Para salir, toque el menú, abra <strong class='text-white'>Markets</strong> y desplácese hasta el panel <strong class='text-white'>My Positions</strong>. Toque <strong class='text-white'>CANCEL ALL &amp; EXIT ALL</strong> y la app cierra su posición a mercado y elimina de una sola vez todas las órdenes activas asociadas. Ese único botón es su salida de emergencia cuando una operación va mal y simplemente necesita estar fuera. Si solo cierra uno de varios contratos o posiciones, use en su lugar el control de cierre de cada posición para no borrar el resto." },
      ],
    },
    { type: "heading",text: "Por qué gestionar sus operaciones desde el teléfono" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Reaccione desde cualquier lugar</strong> para que un movimiento rápido en su contra no quede sin gestionar mientras está lejos del escritorio.",
        "<strong class='text-white'>Mantenga un stop fijo en cada operación</strong>, algo que exigen la mayoría de las prop firms y que todo plan de riesgo debería incluir.",
        "<strong class='text-white'>Cierre todo con un toque</strong> con CANCEL ALL &amp; EXIT ALL cuando necesite salir ahora mismo.",
        "<strong class='text-white'>Ajuste su stop sobre la marcha</strong> arrastrando la línea hasta breakeven a medida que la operación avanza.",
        "<strong class='text-white'>Manténgase sincronizado</strong> con su escritorio, ya que es la misma cuenta en todos los dispositivos.",
      ],
    },
    { type: "heading",text: "Deje que PickMyTrade gestione la salida por usted" },
    { type: "paragraph",html: "Reaccionar desde el teléfono funciona, pero aun así debe ver el movimiento y tocar a tiempo. <strong class='text-white'>PickMyTrade envía sus alertas de TradingView directamente a su cuenta de Tradovate</strong> y adjunta el stop y el objetivo automáticamente, de modo que cada señal entra y sale con un bracket completo incluso con el teléfono en el bolsillo." },
  ], fr: [
    { type: "paragraph",html: "L’application du téléphone est l’endroit où vous gérez votre risque lorsque vous êtes loin de votre bureau. Une annonce fait bondir le marché pendant votre déjeuner et vous devez poser un stop ou clôturer une position en quelques pressions. Ce guide couvre les deux tâches sur l’application mobile Tradovate : attacher un stop de protection à un trade et clôturer une position lorsque vous voulez sortir." },
    { type: "heading",text: "Ce que vous pouvez faire depuis le ticket d’ordre mobile" },
    { type: "paragraph",html: "L’application mobile vous donne les mêmes commandes essentielles que la plateforme web, simplement agencées pour un petit écran. Depuis le ticket d’ordre, vous pouvez déclencher une entrée, passer le type d’ordre sur <strong class='text-white'>Stop</strong>, <strong class='text-white'>Stop Limit</strong> ou <strong class='text-white'>Trailing Stop</strong> et l’envoyer comme protection d’un trade ouvert. Le panneau <strong class='text-white'>My Positions</strong> est l’endroit où vous suivez ce qui est actif et où vous le clôturez. Une fois ces deux écrans maîtrisés, vous pouvez gérer un trade complet depuis votre téléphone sans jamais toucher un ordinateur portable." },
    { type: "heading",text: "Placer un stop et clôturer un trade sur Tradovate Mobile : pas à pas" },
    {
      type: "steps",
      items: [
        { title: "Ouvrez le ticket d’ordre", html: "Appuyez sur l’<strong class='text-white'>icône de menu (&#9776;)</strong> dans le coin supérieur gauche et choisissez <strong class='text-white'>Trade</strong>. Si vous préférez choisir dans une liste, appuyez sur le menu, ouvrez <strong class='text-white'>Markets</strong>, sélectionnez votre instrument, puis appuyez sur <strong class='text-white'>Trade</strong> sur son écran de détail. Les deux chemins vous mènent au ticket d’ordre, où vous définissez le contrat, choisissez <strong class='text-white'>Buy</strong> ou <strong class='text-white'>Sell</strong> et réglez votre quantité." },
        { title: "Choisissez un type d’ordre stop", html: "Sur le ticket d’ordre, ouvrez le <strong class='text-white'>sélecteur de type d’ordre</strong> en haut de l’écran. Par défaut, vous êtes sur un ordre Market ou Limit ; passez donc sur <strong class='text-white'>Stop</strong> (stop au marché), <strong class='text-white'>Stop Limit</strong> ou <strong class='text-white'>Trailing Stop</strong> selon le comportement de sortie souhaité. Un Stop simple garantit votre sortie dès que le prix franchit votre niveau ; un Trailing Stop suit le marché tick par tick quand il évolue en votre faveur et reste en place lorsqu’il se retourne." },
        { title: "Définissez le niveau du stop et envoyez-le", html: "Saisissez le <strong class='text-white'>prix de déclenchement</strong> pour un stop, ou la <strong class='text-white'>distance de suivi</strong> pour un trailing stop, vérifiez à nouveau le sens et la quantité, puis appuyez sur <strong class='text-white'>Send</strong>. Le stop se trouve désormais dans votre compte comme ordre actif, prêt à clôturer la position si le prix l’atteint. Si vous êtes en évaluation prop firm, un stop strict sur chaque trade est généralement obligatoire, et la distance exigée ou le risque maximal varie selon la société et la taille du compte ; vérifiez donc les règles en vigueur de votre société avant d’augmenter votre taille." },
        { title: "Déplacez ou annulez un stop sur une position ouverte", html: "Les marchés bougent, et votre stop doit suivre votre plan. Ouvrez vos <strong class='text-white'>ordres actifs</strong> depuis la vue Position ou Orders et appuyez sur le stop en attente pour modifier son prix, ou saisissez la <strong class='text-white'>ligne du stop sur le graphique mobile</strong> et faites-la glisser vers un nouveau niveau pour la remonter à breakeven. Vous voulez supprimer le stop complètement ? Annulez-le de la même façon. Laissez une seconde à l’application pour confirmer la modification avant de détourner le regard." },
        { title: "Clôturez la position", html: "Pour sortir, appuyez sur le menu, ouvrez <strong class='text-white'>Markets</strong> et faites défiler jusqu’au panneau <strong class='text-white'>My Positions</strong>. Appuyez sur <strong class='text-white'>CANCEL ALL &amp; EXIT ALL</strong> et l’application clôture votre position au marché et supprime en une seule opération tous les ordres actifs associés. Ce bouton unique est votre sortie de secours lorsqu’un trade tourne mal et que vous devez simplement être à plat. Si vous ne clôturez qu’un seul contrat ou une seule position parmi plusieurs, utilisez plutôt la commande de clôture propre à chaque position afin de ne pas effacer le reste." },
      ],
    },
    { type: "heading",text: "Pourquoi gérer ses trades depuis son téléphone" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Réagissez où que vous soyez</strong> afin qu’un mouvement rapide contre vous ne reste pas sans gestion pendant que vous êtes loin du bureau.",
        "<strong class='text-white'>Gardez un stop strict sur chaque trade</strong>, ce que la plupart des prop firms exigent et que tout plan de risque devrait inclure.",
        "<strong class='text-white'>Clôturez tout en un seul appui</strong> avec CANCEL ALL &amp; EXIT ALL lorsque vous devez sortir immédiatement.",
        "<strong class='text-white'>Remontez votre stop en déplacement</strong> en faisant glisser la ligne jusqu’à breakeven à mesure que le trade progresse.",
        "<strong class='text-white'>Restez synchronisé</strong> avec votre ordinateur de bureau, puisque c’est le même compte sur chaque appareil.",
      ],
    },
    { type: "heading",text: "Laissez PickMyTrade gérer la sortie à votre place" },
    { type: "paragraph",html: "Réagir sur votre téléphone fonctionne, mais vous devez encore voir le mouvement et appuyer à temps. <strong class='text-white'>PickMyTrade envoie vos alertes TradingView directement vers votre compte Tradovate</strong> et attache automatiquement le stop et l’objectif, de sorte que chaque signal entre et sort avec un bracket complet, même lorsque votre téléphone reste dans votre poche." },
  ], it: [
    { type: "paragraph",html: "L’app sul telefono è il luogo in cui gestisce il rischio quando è lontano dalla scrivania. Una notizia scuote il mercato mentre è a pranzo e deve piazzare uno stop o chiudere una posizione con pochi tocchi. Questa guida copre entrambe le operazioni sull’app mobile di Tradovate: allegare uno stop di protezione a un trade e chiudere una posizione quando vuole uscire." },
    { type: "heading",text: "Cosa può fare dal ticket dell’ordine mobile" },
    { type: "paragraph",html: "L’app mobile le offre gli stessi controlli di base della piattaforma web, solo organizzati per uno schermo piccolo. Dal ticket dell’ordine può inviare un ingresso, cambiare il tipo di ordine in <strong class='text-white'>Stop</strong>, <strong class='text-white'>Stop Limit</strong> o <strong class='text-white'>Trailing Stop</strong> e inviarlo come protezione su un trade aperto. Il pannello <strong class='text-white'>My Positions</strong> è il punto in cui controlla ciò che è attivo e lo chiude. Una volta presa confidenza con queste due schermate, può gestire un trade completo dal telefono senza mai toccare un laptop." },
    { type: "heading",text: "Impostare uno stop e chiudere un trade su Tradovate Mobile: passo dopo passo" },
    {
      type: "steps",
      items: [
        { title: "Apra il ticket dell’ordine", html: "Tocchi l’<strong class='text-white'>icona del menu (&#9776;)</strong> in alto a sinistra e scelga <strong class='text-white'>Trade</strong>. Se preferisce selezionare da un elenco, tocchi il menu, apra <strong class='text-white'>Markets</strong>, selezioni lo strumento e tocchi <strong class='text-white'>Trade</strong> nella schermata di dettaglio. Entrambi i percorsi la portano al ticket dell’ordine, dove imposta il contratto, sceglie <strong class='text-white'>Buy</strong> o <strong class='text-white'>Sell</strong> e definisce la quantità." },
        { title: "Scelga un tipo di ordine stop", html: "Nel ticket dell’ordine, apra il <strong class='text-white'>selettore del tipo di ordine</strong> nella parte superiore dello schermo. Di default si trova su un ordine Market o Limit, quindi lo cambi in <strong class='text-white'>Stop</strong> (stop a mercato), <strong class='text-white'>Stop Limit</strong> o <strong class='text-white'>Trailing Stop</strong> a seconda di come vuole che si comporti l’uscita. Uno Stop semplice garantisce l’uscita non appena il prezzo attraversa il suo livello; un Trailing Stop segue il mercato tick dopo tick quando si muove a suo favore e resta fermo quando si gira contro di lei." },
        { title: "Imposti il livello dello stop e lo invii", html: "Inserisca il <strong class='text-white'>prezzo di attivazione</strong> per uno stop, o la <strong class='text-white'>distanza di trailing</strong> per un trailing stop, ricontrolli lato e quantità e tocchi <strong class='text-white'>Send</strong>. Lo stop è ora nel suo conto come ordine attivo, pronto a chiudere la posizione se il prezzo lo raggiunge. Se è in una valutazione con una prop firm, uno stop fisso su ogni trade è di solito obbligatorio, e la distanza richiesta o il rischio massimo variano in base alla società e alla dimensione del conto, quindi controlli le regole attuali della sua società prima di aumentare la size." },
        { title: "Sposti o cancelli uno stop su una posizione aperta", html: "I mercati si muovono, e il suo stop dovrebbe muoversi con il suo piano. Apra i suoi <strong class='text-white'>ordini attivi</strong> dalla vista Posizione o Ordini e tocchi lo stop in attesa per cambiarne il prezzo, oppure afferri la <strong class='text-white'>linea dello stop sul grafico mobile</strong> e la trascini a un nuovo livello per portarla a breakeven. Vuole eliminare del tutto lo stop? Lo cancelli allo stesso modo. Dia all’app un secondo per confermare la modifica prima di distogliere lo sguardo." },
        { title: "Chiuda la posizione", html: "Per uscire, tocchi il menu, apra <strong class='text-white'>Markets</strong> e scorra fino al pannello <strong class='text-white'>My Positions</strong>. Tocchi <strong class='text-white'>CANCEL ALL &amp; EXIT ALL</strong> e l’app chiude la sua posizione a mercato e cancella in un’unica mossa tutti gli ordini attivi collegati. Quel singolo pulsante è la sua uscita di emergenza quando un trade va storto e deve semplicemente essere flat. Se chiude solo uno tra più contratti o posizioni, usi invece il comando di chiusura della singola posizione, così da non eliminare anche il resto." },
      ],
    },
    { type: "heading",text: "Perché gestire i trade dal telefono" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Reagisca ovunque</strong> così che un movimento rapido contro di lei non resti non gestito mentre è lontano dalla scrivania.",
        "<strong class='text-white'>Mantenga uno stop fisso su ogni trade</strong>, cosa che la maggior parte delle prop firm richiede e che ogni piano di rischio dovrebbe prevedere.",
        "<strong class='text-white'>Chiuda tutto con un tocco</strong> con CANCEL ALL &amp; EXIT ALL quando deve uscire subito.",
