---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "tradovate-instrument-selector";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/how-to/${SLUG}`;

const META_TITLE = "Find Contracts With the Tradovate Instrument Selector";
const META_DESCRIPTION =
  "Search any futures symbol and pick the right contract month fast with the Tradovate Instrument Selector, then load it into charts, the DOM, or orders.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Kontrakte finden mit dem Tradovate Instrument Selector", es: "Encuentre contratos con el Instrument Selector de Tradovate", fr: "Trouver des contrats avec l'Instrument Selector de Tradovate", it: "Trovare i contratti con l'Instrument Selector di Tradovate" },
  dek: { en: "Every chart, DOM, and order ticket in Tradovate starts with the same question: which contract are you trading? Here's how the Instrument Selector answers it.", de: "Jeder Chart, jedes DOM und jedes Order-Ticket in Tradovate beginnt mit derselben Frage: Welchen Kontrakt handeln Sie? So beantwortet der Instrument Selector sie.", es: "Cada gráfico, DOM y ticket de orden en Tradovate empieza con la misma pregunta: ¿qué contrato está operando? Así la responde el Instrument Selector.", fr: "Chaque graphique, DOM et ticket d'ordre dans Tradovate commence par la même question : quel contrat tradez-vous ? Voici comment l'Instrument Selector y répond.", it: "Ogni grafico, DOM e ticket d'ordine in Tradovate parte dalla stessa domanda: quale contratto sta negoziando? Ecco come risponde l'Instrument Selector." },
  readTime: { en: "6 min read", de: "6 Min. Lesezeit", es: "Lectura de 6 min", fr: "Lecture : 6 min", it: "Lettura di 6 min" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "Every chart, DOM, and order ticket in Tradovate starts with the same question: which contract are you trading? The Instrument Selector is how you answer it. It's the combined search bar and dropdown that finds any futures contract in Tradovate's database and drops it into whatever module you're working in." },
    { type: "heading", text: "What Is the Tradovate Instrument Selector?" },
    { type: "paragraph", html: "The Instrument Selector is a combined dropdown menu and search bar that sets the instrument shown across every market-data and order-entry module in the Tradovate web app. Search by symbol, by keyword, or by a specific contract month, then send the result to a chart, a SuperDOM, an order ticket, or a plain quote window. One tool feeds the whole workspace, so you're never retyping the same symbol in five places." },
    { type: "heading", text: "Finding Contracts: Step-by-Step" },
    {
      type: "steps",
      items: [
        { title: "Open the Instrument Selector", html: "Look for the search bar running across the top of the Tradovate web app, near the clock and notification ticker. Click it once and it wakes up before you've typed a thing, showing your <strong class='text-white'>Recent Searches</strong> and a list of <strong class='text-white'>Popular Instruments</strong>. If you trade the same handful of contracts every day, your symbol is often one click away right there.", image: { src: `${IMG}/tradovate-instrument-selector-1.png`, alt: "Tradovate web app search bar open at the top of the screen showing Recent Searches and Popular Instruments" } },
        { title: "Search by Symbol, Keyword, or Contract Month", html: "Start typing and the list filters live. You've got three ways in: <strong class='text-white'>Symbol</strong>, type a root like <code>ES</code>, <code>NQ</code>, <code>CL</code>, or <code>GC</code>, or a micro like <code>MES</code> and <code>MNQ</code>. <strong class='text-white'>Keyword</strong>, type a name like \"crude\" or \"gold\" when you can't remember the root. <strong class='text-white'>Contract month</strong>, type a full code like <code>ESZ5</code> to jump straight to one expiration.", image: { src: `${IMG}/tradovate-instrument-selector-2.png`, alt: "Tradovate Instrument Selector dropdown filtering live as a symbol is typed into the search bar" } },
        { title: "Pick the Right Contract Month", html: "Futures aren't a single symbol. They're a ladder of monthly contracts, and Tradovate names each one the same way: the root symbol, then a one-letter month code, then the last digit of the year, no spaces. So the December 2025 E-mini S&amp;P is <code>ESZ5</code>. Stick with the <strong class='text-white'>front-month</strong> contract, the nearest expiration, where the volume and liquidity sit, unless you have a real reason to trade a later month. Loading a thin back-month or a contract that's about to expire is a fast way to get poor fills or a rejected order. When a contract nears its expiry, roll to the next active month.", image: { src: `${IMG}/tradovate-instrument-selector-3.png`, alt: "Tradovate search results listing multiple contract months for the same futures root symbol" } },
        { title: "Load the Contract Into a Module", html: "Once you've found the contract, you decide where it lands: <strong class='text-white'>Left-click</strong> a result to open it in a <strong class='text-white'>Quote Info</strong> window. <strong class='text-white'>Hover</strong> over a result to get a small launch menu, send it straight to a new <strong class='text-white'>Quote Info</strong>, <strong class='text-white'>Alerts</strong>, or <strong class='text-white'>Trade</strong> module. <strong class='text-white'>Click and drag</strong> the contract onto the workspace to spin up a new <strong class='text-white'>SuperDOM</strong>, <strong class='text-white'>Chart</strong>, <strong class='text-white'>Market Analyzer</strong>, or <strong class='text-white'>Time &amp; Sales</strong>. Drag-and-drop is the fast path once your layout is set. If quotes come up delayed or a symbol won't load, that's almost always a market-data subscription issue rather than the selector itself.", image: { src: `${IMG}/tradovate-instrument-selector-4.png`, alt: "Trader dragging a Tradovate contract from search results onto the workspace to open a new chart module" } },
        { title: "Swap the Instrument Inside an Open Module", html: "Don't rebuild your chart every time you change contracts. Left-click the <strong class='text-white'>instrument name in the tab at the top-left</strong> of any module and the same search dropdown appears right there. Pick the new contract and the module reloads around it, your indicators, timeframe, and layout all stay put.", image: { src: `${IMG}/tradovate-instrument-selector-5.png`, alt: "Tradovate chart module with the instrument name tab clicked, showing the search dropdown to swap contracts" } },
      ],
    },
    { type: "heading", text: "Contract Month Codes" },
    {
      type: "table",
      headers: ["Month", "Code", "Month", "Code"],
      rows: [
        ["January", "F", "July", "N"],
        ["February", "G", "August", "Q"],
        ["March", "H", "September", "U"],
        ["April", "J", "October", "V"],
        ["May", "K", "November", "X"],
        ["June", "M", "December", "Z"],
      ],
    },
    { type: "heading", text: "Why You'd Need This" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Trade the active contract</strong>, picking the correct front-month symbol keeps you in the liquid market and off dead back-months.",
        "<strong class='text-white'>Set up faster</strong>, one search feeds every chart, DOM, and order ticket, so your workspace comes together in seconds.",
        "<strong class='text-white'>Avoid rejections</strong>, loading a valid, non-expired contract heads off a whole class of order errors.",
        "<strong class='text-white'>Line up automation</strong>, the exact symbol you select here is the symbol your bots and alerts need to route orders to, and prop-firm contract rules vary by firm and account size, so check your firm's current rules too.",
      ],
    },
    { type: "heading", text: "Automate This with PickMyTrade" },
    { type: "paragraph", html: "Once you know which Tradovate contract you're trading, PickMyTrade keeps your automation pointed at it. It maps your TradingView alerts to the right contract and routes orders into Tradovate on its own, no manual clicks, no fat-fingered symbols, no missed fills." },
  ], de: [
    { type: "paragraph",html: "Jeder Chart, jedes DOM und jedes Order-Ticket in Tradovate beginnt mit derselben Frage: Welchen Kontrakt handeln Sie? Der Instrument Selector beantwortet sie. Er ist die kombinierte Suchleiste mit Dropdown, die jeden Futures-Kontrakt in der Datenbank von Tradovate findet und in das Modul legt, in dem Sie gerade arbeiten." },
    { type: "heading",text: "Was ist der Tradovate Instrument Selector?" },
    { type: "paragraph",html: "Der Instrument Selector ist ein kombiniertes Dropdown-Menü mit Suchleiste, das das Instrument für alle Marktdaten- und Ordereingabe-Module der Tradovate-Web-App festlegt. Suchen Sie nach Symbol, nach Stichwort oder nach einem bestimmten Kontraktmonat und senden Sie das Ergebnis an einen Chart, ein SuperDOM, ein Order-Ticket oder ein einfaches Kursfenster. Ein Werkzeug versorgt den gesamten Arbeitsbereich, sodass Sie dasselbe Symbol nie an fünf Stellen erneut eingeben müssen." },
    { type: "heading",text: "Kontrakte finden: Schritt für Schritt" },
    {
      type: "steps",
      items: [
        { title: "Instrument Selector öffnen", html: "Suchen Sie die Suchleiste am oberen Rand der Tradovate-Web-App, in der Nähe von Uhr und Benachrichtigungsticker. Ein Klick genügt, und sie reagiert schon vor der ersten Eingabe: Sie zeigt Ihre <strong class='text-white'>Recent Searches</strong> und eine Liste mit <strong class='text-white'>Popular Instruments</strong>. Wenn Sie täglich dieselben wenigen Kontrakte handeln, ist Ihr Symbol dort oft nur einen Klick entfernt.", image: {"src":`${IMG}/tradovate-instrument-selector-1.png`,"alt":"Geöffnete Suchleiste der Tradovate-Web-App am oberen Bildschirmrand mit Recent Searches und Popular Instruments"} },
        { title: "Nach Symbol, Stichwort oder Kontraktmonat suchen", html: "Beginnen Sie zu tippen, und die Liste filtert live. Es gibt drei Wege: <strong class='text-white'>Symbol</strong>, geben Sie ein Root wie <code>ES</code>, <code>NQ</code>, <code>CL</code> oder <code>GC</code> ein, oder einen Micro wie <code>MES</code> und <code>MNQ</code>. <strong class='text-white'>Stichwort</strong>, geben Sie einen Namen wie „crude“ oder „gold“ ein, wenn Ihnen das Root nicht einfällt. <strong class='text-white'>Kontraktmonat</strong>, geben Sie einen vollständigen Code wie <code>ESZ5</code> ein, um direkt zu einem Verfall zu springen.", image: {"src":`${IMG}/tradovate-instrument-selector-2.png`,"alt":"Dropdown des Tradovate Instrument Selector, das beim Eintippen eines Symbols in die Suchleiste live filtert"} },
        { title: "Den richtigen Kontraktmonat wählen", html: "Futures sind nicht ein einzelnes Symbol. Sie bilden eine Leiter aus Monatskontrakten, und Tradovate benennt jeden auf die gleiche Weise: das Root-Symbol, dann ein Buchstabe als Monatscode, dann die letzte Ziffer des Jahres, ohne Leerzeichen. Der E-mini S&amp;P vom Dezember 2025 heißt also <code>ESZ5</code>. Bleiben Sie beim <strong class='text-white'>Front-Month</strong>-Kontrakt, dem nächsten Verfall, wo Volumen und Liquidität liegen, es sei denn, Sie haben einen echten Grund, einen späteren Monat zu handeln. Wer einen dünn gehandelten Back-Month oder einen kurz vor Verfall stehenden Kontrakt lädt, riskiert schnell schlechte Ausführungen oder eine abgelehnte Order. Wenn ein Kontrakt sich dem Verfall nähert, rollen Sie in den nächsten aktiven Monat.", image: {"src":`${IMG}/tradovate-instrument-selector-3.png`,"alt":"Tradovate-Suchergebnisse mit mehreren Kontraktmonaten für dasselbe Futures-Root-Symbol"} },
        { title: "Den Kontrakt in ein Modul laden", html: "Sobald Sie den Kontrakt gefunden haben, entscheiden Sie, wo er landet: <strong class='text-white'>Linksklick</strong> auf ein Ergebnis öffnet es in einem Fenster <strong class='text-white'>Quote Info</strong>. Mit <strong class='text-white'>Hover</strong> über einem Ergebnis erscheint ein kleines Startmenü, über das Sie es direkt an ein neues Modul <strong class='text-white'>Quote Info</strong>, <strong class='text-white'>Alerts</strong> oder <strong class='text-white'>Trade</strong> senden. Mit <strong class='text-white'>Klicken und Ziehen</strong> legen Sie den Kontrakt auf den Arbeitsbereich und erzeugen so ein neues <strong class='text-white'>SuperDOM</strong>, <strong class='text-white'>Chart</strong>, <strong class='text-white'>Market Analyzer</strong> oder <strong class='text-white'>Time &amp; Sales</strong>. Drag-and-drop ist der schnelle Weg, sobald Ihr Layout steht. Wenn Kurse verzögert erscheinen oder ein Symbol nicht lädt, liegt das fast immer an einem Marktdaten-Abonnement und nicht am Selector selbst.", image: {"src":`${IMG}/tradovate-instrument-selector-4.png`,"alt":"Trader zieht einen Tradovate-Kontrakt aus den Suchergebnissen auf den Arbeitsbereich, um ein neues Chart-Modul zu öffnen"} },
        { title: "Das Instrument in einem geöffneten Modul austauschen", html: "Bauen Sie Ihren Chart nicht bei jedem Kontraktwechsel neu auf. Klicken Sie mit links auf den <strong class='text-white'>Instrumentennamen im Tab oben links</strong> eines beliebigen Moduls, und dasselbe Such-Dropdown erscheint direkt dort. Wählen Sie den neuen Kontrakt, und das Modul lädt sich darum neu, Ihre Indikatoren, Ihr Zeitrahmen und Ihr Layout bleiben erhalten.", image: {"src":`${IMG}/tradovate-instrument-selector-5.png`,"alt":"Tradovate-Chart-Modul mit angeklicktem Instrumenten-Tab und Such-Dropdown zum Wechseln des Kontrakts"} },
      ],
    },
    { type: "heading",text: "Monatscodes der Kontrakte" },
    { type: "table", headers: ["Monat","Code","Monat","Code"], rows: [
      ["Januar","F","Juli","N"],
      ["Februar","G","August","Q"],
      ["März","H","September","U"],
      ["April","J","Oktober","V"],
      ["Mai","K","November","X"],
      ["Juni","M","Dezember","Z"],
    ] },
    { type: "heading",text: "Wofür Sie das brauchen" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Den aktiven Kontrakt handeln</strong>, mit dem richtigen Front-Month-Symbol bleiben Sie im liquiden Markt und weg von toten Back-Months.",
        "<strong class='text-white'>Schneller einrichten</strong>, eine Suche versorgt jeden Chart, jedes DOM und jedes Order-Ticket, sodass Ihr Arbeitsbereich in Sekunden steht.",
        "<strong class='text-white'>Ablehnungen vermeiden</strong>, das Laden eines gültigen, nicht abgelaufenen Kontrakts beugt einer ganzen Klasse von Orderfehlern vor.",
        "<strong class='text-white'>Automatisierung abstimmen</strong>, genau das hier gewählte Symbol ist das Symbol, an das Ihre Bots und Alerts Orders weiterleiten müssen; die Kontraktregeln von Prop-Firmen unterscheiden sich je nach Firma und Kontogröße, prüfen Sie daher auch die aktuellen Regeln Ihrer Firma.",
      ],
    },
    { type: "heading",text: "Automatisieren Sie das mit PickMyTrade" },
    { type: "paragraph",html: "Sobald Sie wissen, welchen Tradovate-Kontrakt Sie handeln, hält PickMyTrade Ihre Automatisierung darauf ausgerichtet. Es ordnet Ihre TradingView-Alerts dem richtigen Kontrakt zu und leitet Orders ganz von selbst an Tradovate weiter, ohne manuelle Klicks, ohne vertippte Symbole und ohne verpasste Ausführungen." },
  ], es: [
    { type: "paragraph",html: "Cada gráfico, DOM y ticket de orden en Tradovate empieza con la misma pregunta: ¿qué contrato está operando? El Instrument Selector es la forma de responderla. Es la barra de búsqueda con menú desplegable que encuentra cualquier contrato de futuros de la base de datos de Tradovate y lo coloca en el módulo con el que esté trabajando." },
    { type: "heading",text: "¿Qué es el Instrument Selector de Tradovate?" },
    { type: "paragraph",html: "El Instrument Selector es un menú desplegable con barra de búsqueda que establece el instrumento mostrado en todos los módulos de datos de mercado y de introducción de órdenes de la aplicación web de Tradovate. Busque por símbolo, por palabra clave o por un mes de contrato concreto y envíe el resultado a un gráfico, un SuperDOM, un ticket de orden o una simple ventana de cotizaciones. Una sola herramienta alimenta todo el espacio de trabajo, por lo que nunca tendrá que volver a escribir el mismo símbolo en cinco lugares." },
    { type: "heading",text: "Cómo encontrar contratos: paso a paso" },
    {
      type: "steps",
      items: [
        { title: "Abra el Instrument Selector", html: "Busque la barra de búsqueda que recorre la parte superior de la aplicación web de Tradovate, cerca del reloj y del teletipo de notificaciones. Haga clic una vez y se activa antes de que escriba nada, mostrando sus <strong class='text-white'>Recent Searches</strong> y una lista de <strong class='text-white'>Popular Instruments</strong>. Si opera cada día los mismos pocos contratos, su símbolo suele estar a un clic de distancia.", image: {"src":`${IMG}/tradovate-instrument-selector-1.png`,"alt":"Barra de búsqueda de la aplicación web de Tradovate abierta en la parte superior de la pantalla con Recent Searches y Popular Instruments"} },
        { title: "Busque por símbolo, palabra clave o mes de contrato", html: "Empiece a escribir y la lista se filtra en directo. Dispone de tres vías de acceso: <strong class='text-white'>Símbolo</strong>, escriba una raíz como <code>ES</code>, <code>NQ</code>, <code>CL</code> o <code>GC</code>, o un micro como <code>MES</code> y <code>MNQ</code>. <strong class='text-white'>Palabra clave</strong>, escriba un nombre como «crude» o «gold» cuando no recuerde la raíz. <strong class='text-white'>Mes de contrato</strong>, escriba un código completo como <code>ESZ5</code> para ir directamente a un vencimiento.", image: {"src":`${IMG}/tradovate-instrument-selector-2.png`,"alt":"Menú desplegable del Instrument Selector de Tradovate filtrando en directo mientras se escribe un símbolo en la barra de búsqueda"} },
        { title: "Elija el mes de contrato correcto", html: "Los futuros no son un único símbolo. Son una escalera de contratos mensuales, y Tradovate nombra cada uno de la misma manera: el símbolo raíz, luego un código de mes de una letra y después el último dígito del año, sin espacios. Así, el E-mini S&amp;P de diciembre de 2025 es <code>ESZ5</code>. Quédese con el contrato <strong class='text-white'>front-month</strong>, el de vencimiento más cercano, donde se concentran el volumen y la liquidez, salvo que tenga una razón real para operar un mes posterior. Cargar un mes lejano con poca liquidez o un contrato a punto de vencer es una forma rápida de obtener malas ejecuciones o una orden rechazada. Cuando un contrato se acerque a su vencimiento, pase al siguiente mes activo.", image: {"src":`${IMG}/tradovate-instrument-selector-3.png`,"alt":"Resultados de búsqueda de Tradovate con varios meses de contrato para el mismo símbolo raíz de futuros"} },
        { title: "Cargue el contrato en un módulo", html: "Una vez que haya encontrado el contrato, usted decide dónde aterriza: <strong class='text-white'>Clic izquierdo</strong> en un resultado para abrirlo en una ventana <strong class='text-white'>Quote Info</strong>. <strong class='text-white'>Pase el cursor</strong> sobre un resultado para ver un pequeño menú de lanzamiento y enviarlo directamente a un nuevo módulo <strong class='text-white'>Quote Info</strong>, <strong class='text-white'>Alerts</strong> o <strong class='text-white'>Trade</strong>. <strong class='text-white'>Haga clic y arrastre</strong> el contrato al espacio de trabajo para crear un nuevo <strong class='text-white'>SuperDOM</strong>, <strong class='text-white'>Chart</strong>, <strong class='text-white'>Market Analyzer</strong> o <strong class='text-white'>Time &amp; Sales</strong>. Arrastrar y soltar es el camino rápido una vez que su diseño está configurado. Si las cotizaciones aparecen con retraso o un símbolo no carga, casi siempre se trata de un problema de suscripción de datos de mercado y no del selector en sí.", image: {"src":`${IMG}/tradovate-instrument-selector-4.png`,"alt":"Trader arrastrando un contrato de Tradovate desde los resultados de búsqueda al espacio de trabajo para abrir un nuevo módulo de gráfico"} },
        { title: "Cambie el instrumento dentro de un módulo abierto", html: "No reconstruya su gráfico cada vez que cambie de contrato. Haga clic izquierdo en el <strong class='text-white'>nombre del instrumento en la pestaña de la parte superior izquierda</strong> de cualquier módulo y el mismo menú de búsqueda aparece allí mismo. Elija el nuevo contrato y el módulo se recarga a su alrededor; sus indicadores, marco temporal y diseño se mantienen.", image: {"src":`${IMG}/tradovate-instrument-selector-5.png`,"alt":"Módulo de gráfico de Tradovate con la pestaña del nombre del instrumento pulsada, mostrando el menú de búsqueda para cambiar de contrato"} },
      ],
    },
    { type: "heading",text: "Códigos de mes de los contratos" },
    { type: "table", headers: ["Mes","Código","Mes","Código"], rows: [
      ["Enero","F","Julio","N"],
      ["Febrero","G","Agosto","Q"],
      ["Marzo","H","Septiembre","U"],
      ["Abril","J","Octubre","V"],
      ["Mayo","K","Noviembre","X"],
      ["Junio","M","Diciembre","Z"],
    ] },
    { type: "heading",text: "Para qué le sirve" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Operar el contrato activo</strong>, elegir el símbolo front-month correcto le mantiene en el mercado líquido y lejos de meses lejanos sin actividad.",
        "<strong class='text-white'>Configurar más rápido</strong>, una sola búsqueda alimenta cada gráfico, DOM y ticket de orden, de modo que su espacio de trabajo queda listo en segundos.",
        "<strong class='text-white'>Evitar rechazos</strong>, cargar un contrato válido y no vencido evita toda una clase de errores de orden.",
        "<strong class='text-white'>Alinear la automatización</strong>, el símbolo exacto que selecciona aquí es el símbolo al que sus bots y alertas deben enviar las órdenes, y las reglas de contratos de las prop firms varían según la firma y el tamaño de la cuenta, así que revise también las reglas vigentes de su firma.",
      ],
    },
    { type: "heading",text: "Automatice esto con PickMyTrade" },
    { type: "paragraph",html: "Una vez que sepa qué contrato de Tradovate está operando, PickMyTrade mantiene su automatización apuntando a él. Asigna sus alertas de TradingView al contrato correcto y envía las órdenes a Tradovate por sí solo, sin clics manuales, sin símbolos mal escritos y sin ejecuciones perdidas." },
  ], fr: [
    { type: "paragraph",html: "Chaque graphique, DOM et ticket d'ordre dans Tradovate commence par la même question : quel contrat tradez-vous ? L'Instrument Selector est la réponse. C'est la barre de recherche à liste déroulante qui trouve n'importe quel contrat à terme dans la base de données de Tradovate et le place dans le module sur lequel vous travaillez." },
    { type: "heading",text: "Qu'est-ce que l'Instrument Selector de Tradovate ?" },
    { type: "paragraph",html: "L'Instrument Selector est un menu déroulant doté d'une barre de recherche qui définit l'instrument affiché dans tous les modules de données de marché et de saisie d'ordres de l'application web Tradovate. Recherchez par symbole, par mot-clé ou par mois de contrat précis, puis envoyez le résultat vers un graphique, un SuperDOM, un ticket d'ordre ou une simple fenêtre de cotations. Un seul outil alimente tout l'espace de travail : vous ne ressaisissez jamais le même symbole à cinq endroits." },
    { type: "heading",text: "Trouver des contrats : pas à pas" },
    {
      type: "steps",
      items: [
        { title: "Ouvrez l'Instrument Selector", html: "Repérez la barre de recherche qui court en haut de l'application web Tradovate, près de l'horloge et du bandeau de notifications. Un clic suffit : elle s'active avant même que vous ayez tapé quoi que ce soit et affiche vos <strong class='text-white'>Recent Searches</strong> ainsi qu'une liste de <strong class='text-white'>Popular Instruments</strong>. Si vous tradez chaque jour les mêmes quelques contrats, votre symbole est souvent à un clic de là.", image: {"src":`${IMG}/tradovate-instrument-selector-1.png`,"alt":"Barre de recherche de l'application web Tradovate ouverte en haut de l'écran affichant Recent Searches et Popular Instruments"} },
        { title: "Recherchez par symbole, mot-clé ou mois de contrat", html: "Commencez à taper et la liste se filtre en direct. Trois portes d'entrée s'offrent à vous : <strong class='text-white'>Symbole</strong>, saisissez une racine comme <code>ES</code>, <code>NQ</code>, <code>CL</code> ou <code>GC</code>, ou un micro comme <code>MES</code> et <code>MNQ</code>. <strong class='text-white'>Mot-clé</strong>, saisissez un nom comme « crude » ou « gold » lorsque vous ne vous souvenez plus de la racine. <strong class='text-white'>Mois de contrat</strong>, saisissez un code complet comme <code>ESZ5</code> pour accéder directement à une échéance.", image: {"src":`${IMG}/tradovate-instrument-selector-2.png`,"alt":"Liste déroulante de l'Instrument Selector de Tradovate se filtrant en direct lors de la saisie d'un symbole dans la barre de recherche"} },
        { title: "Choisissez le bon mois de contrat", html: "Les contrats à terme ne sont pas un symbole unique. C'est une échelle de contrats mensuels, et Tradovate nomme chacun de la même façon : le symbole racine, puis un code de mois d'une lettre, puis le dernier chiffre de l'année, sans espaces. L'E-mini S&amp;P de décembre 2025 s'écrit donc <code>ESZ5</code>. Restez sur le contrat <strong class='text-white'>front-month</strong>, l'échéance la plus proche, là où se concentrent volume et liquidité, sauf raison valable de trader une échéance plus lointaine. Charger une échéance éloignée peu liquide ou un contrat sur le point d'expirer est un moyen rapide d'obtenir de mauvaises exécutions ou un ordre rejeté. Lorsqu'un contrat approche de son expiration, passez au mois actif suivant.", image: {"src":`${IMG}/tradovate-instrument-selector-3.png`,"alt":"Résultats de recherche Tradovate listant plusieurs mois de contrat pour le même symbole racine de contrat à terme"} },
        { title: "Chargez le contrat dans un module", html: "Une fois le contrat trouvé, c'est vous qui décidez où il atterrit : <strong class='text-white'>Clic gauche</strong> sur un résultat pour l'ouvrir dans une fenêtre <strong class='text-white'>Quote Info</strong>. <strong class='text-white'>Survolez</strong> un résultat pour afficher un petit menu de lancement et l'envoyer directement vers un nouveau module <strong class='text-white'>Quote Info</strong>, <strong class='text-white'>Alerts</strong> ou <strong class='text-white'>Trade</strong>. <strong class='text-white'>Cliquez et faites glisser</strong> le contrat sur l'espace de travail pour créer un nouveau <strong class='text-white'>SuperDOM</strong>, <strong class='text-white'>Chart</strong>, <strong class='text-white'>Market Analyzer</strong> ou <strong class='text-white'>Time &amp; Sales</strong>. Le glisser-déposer est la voie rapide une fois votre disposition en place. Si les cotations arrivent en différé ou si un symbole ne se charge pas, c'est presque toujours un problème d'abonnement aux données de marché plutôt que du sélecteur lui-même.", image: {"src":`${IMG}/tradovate-instrument-selector-4.png`,"alt":"Trader faisant glisser un contrat Tradovate depuis les résultats de recherche vers l'espace de travail pour ouvrir un nouveau module de graphique"} },
        { title: "Changez l'instrument dans un module ouvert", html: "Inutile de reconstruire votre graphique à chaque changement de contrat. Faites un clic gauche sur le <strong class='text-white'>nom de l'instrument dans l'onglet en haut à gauche</strong> de n'importe quel module et la même liste de recherche apparaît juste là. Choisissez le nouveau contrat et le module se recharge autour de lui : vos indicateurs, votre unité de temps et votre disposition restent en place.", image: {"src":`${IMG}/tradovate-instrument-selector-5.png`,"alt":"Module de graphique Tradovate avec l'onglet du nom de l'instrument cliqué, affichant la liste de recherche pour changer de contrat"} },
      ],
