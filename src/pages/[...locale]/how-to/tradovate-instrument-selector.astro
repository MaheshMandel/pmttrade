  ctaHeading: { en: "Keep Automation Pointed at the Right Contract", de: "Halten Sie Ihre Automatisierung auf dem richtigen Kontrakt", es: "Mantenga su automatización apuntando al contrato correcto", fr: "Gardez votre automatisation sur le bon contrat", it: "Mantenga l'automazione puntata sul contratto giusto" },
