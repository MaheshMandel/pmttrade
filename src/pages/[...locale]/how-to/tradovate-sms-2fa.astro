---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "tradovate-sms-2fa";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/how-to/${SLUG}`;

const META_TITLE = "Set Up SMS Text 2FA in Tradovate";
const META_DESCRIPTION =
  "Enable SMS text-message 2FA on your futures trading account to add a six-digit login code and stop strangers from signing in with your password.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "SMS-Textnachricht-2FA in Tradovate einrichten", es: "Configure la autenticación 2FA por mensaje de texto SMS en Tradovate", fr: "Configurer l’authentification 2FA par SMS dans Tradovate", it: "Configurare la 2FA tramite SMS in Tradovate" },
  dek: { en: "A password on its own is a weak lock for an account that can move real money. SMS two-factor authentication closes that gap with a six-digit code sent to your phone.", de: "Ein Passwort allein ist ein schwaches Schloss für ein Konto, über das echtes Geld bewegt werden kann. Die SMS-Zwei-Faktor-Authentifizierung schließt diese Lücke mit einem sechsstelligen Code, der an Ihr Telefon gesendet wird.", es: "Una contraseña por sí sola es una cerradura débil para una cuenta que puede mover dinero real. La autenticación de dos factores por SMS cierra esa brecha con un código de seis dígitos enviado a su teléfono.", fr: "Un mot de passe seul est une serrure fragile pour un compte capable de déplacer de l’argent réel. L’authentification à deux facteurs par SMS comble cette faille grâce à un code à six chiffres envoyé sur votre téléphone.", it: "Una password da sola è una serratura debole per un conto che può muovere denaro reale. L’autenticazione a due fattori tramite SMS colma questa lacuna con un codice di sei cifre inviato al Suo telefono." },
  readTime: { en: "4 min read", de: "4 Min. Lesezeit", es: "Lectura de 4 min", fr: "Lecture : 4 min", it: "Lettura di 4 min" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "A password on its own is a weak lock for an account that can move real money. If someone guesses it, phishes it, or grabs it from a reused login somewhere else, they're in. SMS two-factor authentication closes that gap. After you type your password, a six-digit code lands on your phone by text, and without that code the login goes nowhere." },
    { type: "paragraph", html: "Here's how to switch it on for your live Tradovate account, plus what your logins will look like once it's active. The whole thing takes about two minutes." },
    { type: "heading", text: "Before You Start" },
    { type: "paragraph", html: "You'll need three things:" },
    {
      type: "list",
      items: [
        "A live Tradovate account you can already log into.",
        "A phone that can receive text messages at the number you'll register.",
        "A couple of minutes on the web or desktop platform (the Security settings are easiest to reach there).",
      ],
    },
    { type: "paragraph", html: "One heads-up if you trade a prop-firm or evaluation account: some security options are managed by the firm rather than by you, so check your firm's current rules if a setting is missing or greyed out." },
    { type: "heading", text: "Set Up SMS 2FA in Tradovate: Step-by-Step" },
    {
      type: "steps",
      items: [
        { title: "Open the Security Page", html: "Log in, open <strong class='text-white'>Application Settings</strong> from the main menu, and go to the <strong class='text-white'>Security</strong> page. This is where every login-protection option lives, from the main 2FA switch down to trusted devices at the bottom.", image: { src: `${IMG}/tradovate-sms-2fa-1.png`, alt: "Tradovate Application Settings menu with the Security page selected" } },
        { title: "Turn on 2-Factor Authentication", html: "Find the <strong class='text-white'>2-Factor Authentication</strong> toggle near the top of the Security page and switch it on. This is the base layer. Text-message codes, authenticator apps, and security keys all sit underneath it, so 2FA has to be on before any of them will appear as options. With this enabled, the first time you sign in from a new device Tradovate emails you a link to approve or deny that login. Approve it once and that machine is recognized going forward.", image: { src: `${IMG}/tradovate-sms-2fa-2.png`, alt: "The 2-Factor Authentication toggle switched on at the top of the Tradovate Security page" } },
        { title: "Add Your Phone Number for SMS", html: "Scroll down below the 2FA toggle to the additional security methods. You'll see options for a text-message (SMS) code, an authenticator app, a security key, and trusted devices. Pick the <strong class='text-white'>SMS / text</strong> method and enter the mobile number that should receive your login codes. Double-check the digits and country code before you continue, since a wrong number means the codes go to the wrong place.", image: { src: `${IMG}/tradovate-sms-2fa-3.png`, alt: "Entering a mobile phone number in the SMS text code option on Tradovate's Security page" } },
        { title: "Verify With the Six-Digit Text Code", html: "Tradovate sends a six-digit code by text to the number you entered. Type that code into the confirmation field to prove the phone is really yours. If it doesn't show up in a minute, give it a moment and use the resend option rather than requesting a fresh code over and over. Once the code checks out, SMS is active on your account.", image: { src: `${IMG}/tradovate-sms-2fa-4.png`, alt: "Confirmation field for entering the six-digit SMS verification code sent by Tradovate" } },
        { title: "Set a Backup Method", html: "When you add a verification method, you'll be prompted to choose a backup as well. Do it. Phones get lost, replaced, and reset, and without a second way in you can lock yourself out of your own account. An authenticator app or a security key both make solid backups, and your recognized trusted devices give you another path. Save your changes and you're done.", image: { src: `${IMG}/tradovate-sms-2fa-5.png`, alt: "Selecting a backup authentication method such as an authenticator app or security key in Tradovate" } },
      ],
    },
    { type: "heading", text: "What Your Next Login Looks Like" },
    { type: "paragraph", html: "From now on, signing in from a new machine runs in this order: you enter your username and password, Tradovate emails you to approve or deny the new device, and then you're asked for the six-digit code from the text message. Enter it and you're in. On a device you've already approved, you won't get bounced every single time, which keeps the extra security from becoming a daily nuisance." },
    { type: "heading", text: "If the Code Never Arrives" },
    { type: "paragraph", html: "A missing text usually comes down to a few ordinary things: the number was entered with a typo, your phone has no signal, or carrier filtering is holding the message. Confirm the number on the Security page, check your signal, and wait a beat before resending. If texts still won't come through, your backup method (that authenticator app or security key from the setup above) will get you in while you sort out the phone." },
    { type: "heading", text: "Automate This with PickMyTrade" },
    { type: "paragraph", html: "Running an automated strategy and don't want a login prompt interrupting your fills? PickMyTrade automates your Tradovate order flow so your alerts route to your account hands-free while your security settings stay locked down." },
  ], de: [
    { type: "paragraph",html: "Ein Passwort allein ist ein schwaches Schloss für ein Konto, über das echtes Geld bewegt werden kann. Wenn jemand es errät, per Phishing abgreift oder aus einem anderswo wiederverwendeten Login übernimmt, ist er drin. Die SMS-Zwei-Faktor-Authentifizierung schließt diese Lücke. Nachdem Sie Ihr Passwort eingegeben haben, erhalten Sie per SMS einen sechsstelligen Code auf Ihr Telefon, und ohne diesen Code führt der Login ins Leere." },
    { type: "paragraph",html: "So aktivieren Sie sie für Ihr Live-Tradovate-Konto, und so sehen Ihre Logins aus, sobald sie aktiv ist. Das Ganze dauert etwa zwei Minuten." },
    { type: "heading",text: "Bevor Sie beginnen" },
    { type: "paragraph",html: "Sie benötigen drei Dinge:" },
    {
      type: "list",
      items: [
        "Ein Live-Tradovate-Konto, bei dem Sie sich bereits anmelden können.",
        "Ein Telefon, das unter der Nummer, die Sie registrieren, Textnachrichten empfangen kann.",
        "Ein paar Minuten Zeit in der Web- oder Desktop-Plattform (die Security-Einstellungen sind dort am einfachsten zu erreichen).",
      ],
    },
    { type: "paragraph",html: "Ein Hinweis, falls Sie ein Prop-Firm- oder Evaluierungskonto handeln: Manche Sicherheitsoptionen werden von der Firma verwaltet und nicht von Ihnen. Prüfen Sie daher die aktuellen Regeln Ihrer Firma, wenn eine Einstellung fehlt oder ausgegraut ist." },
    { type: "heading",text: "SMS-2FA in Tradovate einrichten: Schritt für Schritt" },
    {
      type: "steps",
      items: [
        { title: "Die Security-Seite öffnen", html: "Melden Sie sich an, öffnen Sie im Hauptmenü die <strong class='text-white'>Application Settings</strong> und rufen Sie die Seite <strong class='text-white'>Security</strong> auf. Hier finden Sie alle Optionen zum Schutz Ihres Logins, vom Haupt-2FA-Schalter bis zu den vertrauenswürdigen Geräten ganz unten.", image: {"src":`${IMG}/tradovate-sms-2fa-1.png`,"alt":"Das Menü „Application Settings“ in Tradovate mit ausgewählter Seite „Security“"} },
        { title: "2-Factor Authentication aktivieren", html: "Suchen Sie oben auf der Security-Seite den Schalter <strong class='text-white'>2-Factor Authentication</strong> und schalten Sie ihn ein. Das ist die Basisebene. SMS-Codes, Authenticator-Apps und Sicherheitsschlüssel bauen alle darauf auf, 2FA muss also aktiviert sein, bevor eine davon als Option erscheint. Ist sie aktiviert, sendet Tradovate Ihnen bei der ersten Anmeldung von einem neuen Gerät einen Link per E-Mail, mit dem Sie diese Anmeldung genehmigen oder ablehnen können. Genehmigen Sie sie einmal, und dieses Gerät wird künftig wiedererkannt.", image: {"src":`${IMG}/tradovate-sms-2fa-2.png`,"alt":"Der eingeschaltete 2-Factor-Authentication-Schalter oben auf der Tradovate-Security-Seite"} },
        { title: "Telefonnummer für SMS hinzufügen", html: "Scrollen Sie unter dem 2FA-Schalter nach unten zu den zusätzlichen Sicherheitsmethoden. Sie sehen Optionen für einen SMS-Code, eine Authenticator-App, einen Sicherheitsschlüssel und vertrauenswürdige Geräte. Wählen Sie die Methode <strong class='text-white'>SMS / text</strong> und geben Sie die Mobilnummer ein, die Ihre Login-Codes erhalten soll. Prüfen Sie Ziffern und Ländervorwahl sorgfältig, bevor Sie fortfahren, denn bei einer falschen Nummer gehen die Codes an die falsche Adresse.", image: {"src":`${IMG}/tradovate-sms-2fa-3.png`,"alt":"Eingabe einer Mobilnummer bei der SMS-Code-Option auf der Security-Seite von Tradovate"} },
        { title: "Mit dem sechsstelligen SMS-Code verifizieren", html: "Tradovate sendet einen sechsstelligen Code per SMS an die eingegebene Nummer. Geben Sie diesen Code in das Bestätigungsfeld ein, um nachzuweisen, dass das Telefon wirklich Ihnen gehört. Wenn er nach einer Minute nicht ankommt, warten Sie einen Moment und nutzen Sie die Option zum erneuten Senden, statt immer wieder einen neuen Code anzufordern. Sobald der Code bestätigt ist, ist SMS für Ihr Konto aktiv.", image: {"src":`${IMG}/tradovate-sms-2fa-4.png`,"alt":"Bestätigungsfeld zur Eingabe des von Tradovate gesendeten sechsstelligen SMS-Verifizierungscodes"} },
        { title: "Eine Backup-Methode festlegen", html: "Wenn Sie eine Verifizierungsmethode hinzufügen, werden Sie auch aufgefordert, ein Backup zu wählen. Tun Sie das. Telefone gehen verloren, werden ersetzt und zurückgesetzt, und ohne einen zweiten Zugangsweg können Sie sich aus Ihrem eigenen Konto aussperren. Eine Authenticator-App oder ein Sicherheitsschlüssel sind beide solide Backups, und Ihre erkannten vertrauenswürdigen Geräte bieten einen weiteren Weg. Speichern Sie Ihre Änderungen, und Sie sind fertig.", image: {"src":`${IMG}/tradovate-sms-2fa-5.png`,"alt":"Auswahl einer Backup-Authentifizierungsmethode wie Authenticator-App oder Sicherheitsschlüssel in Tradovate"} },
      ],
    },
    { type: "heading",text: "So sieht Ihr nächster Login aus" },
    { type: "paragraph",html: "Ab sofort läuft die Anmeldung von einem neuen Rechner in dieser Reihenfolge ab: Sie geben Benutzernamen und Passwort ein, Tradovate sendet Ihnen eine E-Mail zur Genehmigung oder Ablehnung des neuen Geräts, und danach werden Sie nach dem sechsstelligen Code aus der SMS gefragt. Geben Sie ihn ein, und Sie sind angemeldet. Auf einem bereits genehmigten Gerät werden Sie nicht jedes Mal erneut abgefragt, sodass die zusätzliche Sicherheit nicht zur täglichen Belastung wird." },
    { type: "heading",text: "Wenn der Code nicht ankommt" },
    { type: "paragraph",html: "Eine fehlende SMS hat meist ganz gewöhnliche Ursachen: Die Nummer wurde mit einem Tippfehler eingegeben, Ihr Telefon hat keinen Empfang oder ein Filter des Mobilfunkanbieters hält die Nachricht zurück. Prüfen Sie die Nummer auf der Security-Seite, kontrollieren Sie Ihren Empfang und warten Sie kurz, bevor Sie erneut senden. Kommen die SMS weiterhin nicht an, bringt Sie Ihre Backup-Methode (die Authenticator-App oder der Sicherheitsschlüssel aus der obigen Einrichtung) ins Konto, während Sie das Telefon in Ordnung bringen." },
    { type: "heading",text: "Automatisieren Sie dies mit PickMyTrade" },
    { type: "paragraph",html: "Sie betreiben eine automatisierte Strategie und möchten nicht, dass eine Login-Abfrage Ihre Fills unterbricht? PickMyTrade automatisiert Ihren Tradovate-Orderfluss, sodass Ihre Alerts freihändig an Ihr Konto geleitet werden, während Ihre Sicherheitseinstellungen geschützt bleiben." },
  ], es: [
    { type: "paragraph",html: "Una contraseña por sí sola es una cerradura débil para una cuenta que puede mover dinero real. Si alguien la adivina, la obtiene mediante phishing o la saca de un inicio de sesión reutilizado en otro sitio, entra. La autenticación de dos factores por SMS cierra esa brecha. Después de escribir su contraseña, le llega un código de seis dígitos a su teléfono por mensaje de texto, y sin ese código el inicio de sesión no lleva a ninguna parte." },
    { type: "paragraph",html: "Aquí le explicamos cómo activarla en su cuenta real de Tradovate y cómo serán sus inicios de sesión una vez activa. Todo el proceso lleva unos dos minutos." },
    { type: "heading",text: "Antes de empezar" },
    { type: "paragraph",html: "Necesitará tres cosas:" },
    {
      type: "list",
      items: [
        "Una cuenta real de Tradovate a la que ya pueda acceder.",
        "Un teléfono que pueda recibir mensajes de texto en el número que va a registrar.",
        "Un par de minutos en la plataforma web o de escritorio (la configuración de Security es más fácil de alcanzar allí).",
      ],
    },
    { type: "paragraph",html: "Una advertencia si opera una cuenta de prop firm o de evaluación: algunas opciones de seguridad las gestiona la firma y no usted, así que consulte las reglas vigentes de su firma si falta una opción o aparece atenuada." },
    { type: "heading",text: "Configure la 2FA por SMS en Tradovate: paso a paso" },
    {
      type: "steps",
      items: [
        { title: "Abra la página Security", html: "Inicie sesión, abra <strong class='text-white'>Application Settings</strong> desde el menú principal y vaya a la página <strong class='text-white'>Security</strong>. Aquí se encuentran todas las opciones de protección del inicio de sesión, desde el interruptor principal de 2FA hasta los dispositivos de confianza al final.", image: {"src":`${IMG}/tradovate-sms-2fa-1.png`,"alt":"Menú Application Settings de Tradovate con la página Security seleccionada"} },
        { title: "Active 2-Factor Authentication", html: "Busque el interruptor <strong class='text-white'>2-Factor Authentication</strong> en la parte superior de la página Security y actívelo. Es la capa base. Los códigos por mensaje de texto, las aplicaciones de autenticación y las llaves de seguridad dependen de ella, por lo que la 2FA debe estar activada para que alguna de ellas aparezca como opción. Con esto activado, la primera vez que inicie sesión desde un dispositivo nuevo Tradovate le enviará por correo un enlace para aprobar o denegar ese inicio de sesión. Apruébelo una vez y ese equipo quedará reconocido en adelante.", image: {"src":`${IMG}/tradovate-sms-2fa-2.png`,"alt":"El interruptor 2-Factor Authentication activado en la parte superior de la página Security de Tradovate"} },
        { title: "Agregue su número de teléfono para SMS", html: "Desplácese hacia abajo, debajo del interruptor de 2FA, hasta los métodos de seguridad adicionales. Verá opciones para un código por mensaje de texto (SMS), una aplicación de autenticación, una llave de seguridad y dispositivos de confianza. Elija el método <strong class='text-white'>SMS / text</strong> e introduzca el número de móvil que debe recibir sus códigos de inicio de sesión. Revise bien los dígitos y el prefijo del país antes de continuar, ya que un número incorrecto significa que los códigos llegarán al lugar equivocado.", image: {"src":`${IMG}/tradovate-sms-2fa-3.png`,"alt":"Introducción de un número de teléfono móvil en la opción de código SMS de la página Security de Tradovate"} },
        { title: "Verifique con el código de seis dígitos recibido por mensaje de texto", html: "Tradovate envía un código de seis dígitos por mensaje de texto al número que introdujo. Escriba ese código en el campo de confirmación para demostrar que el teléfono es realmente suyo. Si no aparece en un minuto, espere un momento y utilice la opción de reenvío en lugar de solicitar un código nuevo una y otra vez. Una vez validado el código, el SMS queda activo en su cuenta.", image: {"src":`${IMG}/tradovate-sms-2fa-4.png`,"alt":"Campo de confirmación para introducir el código de verificación SMS de seis dígitos enviado por Tradovate"} },
        { title: "Establezca un método de respaldo", html: "Al añadir un método de verificación, se le pedirá que elija también uno de respaldo. Hágalo. Los teléfonos se pierden, se cambian y se restablecen, y sin una segunda vía de acceso puede quedarse fuera de su propia cuenta. Tanto una aplicación de autenticación como una llave de seguridad son buenos respaldos, y sus dispositivos de confianza reconocidos le ofrecen otra vía. Guarde los cambios y habrá terminado.", image: {"src":`${IMG}/tradovate-sms-2fa-5.png`,"alt":"Selección de un método de autenticación de respaldo, como una aplicación de autenticación o una llave de seguridad, en Tradovate"} },
      ],
    },
    { type: "heading",text: "Cómo será su próximo inicio de sesión" },
    { type: "paragraph",html: "A partir de ahora, iniciar sesión desde un equipo nuevo seguirá este orden: introduce su nombre de usuario y contraseña, Tradovate le envía un correo para aprobar o denegar el nuevo dispositivo y, después, se le pide el código de seis dígitos del mensaje de texto. Introdúzcalo y habrá accedido. En un dispositivo que ya haya aprobado, no se le pedirá cada vez, de modo que la seguridad adicional no se convierte en una molestia diaria." },
    { type: "heading",text: "Si el código no llega" },
    { type: "paragraph",html: "Un mensaje que no llega suele deberse a causas habituales: el número se introdujo con un error tipográfico, su teléfono no tiene señal o el filtrado del operador está reteniendo el mensaje. Confirme el número en la página Security, compruebe su señal y espere un momento antes de reenviar. Si los mensajes siguen sin llegar, su método de respaldo (la aplicación de autenticación o la llave de seguridad de la configuración anterior) le permitirá entrar mientras resuelve el problema del teléfono." },
    { type: "heading",text: "Automatice esto con PickMyTrade" },
    { type: "paragraph",html: "¿Ejecuta una estrategia automatizada y no quiere que una solicitud de inicio de sesión interrumpa sus ejecuciones? PickMyTrade automatiza el flujo de órdenes de su cuenta de Tradovate para que sus alertas lleguen a ella sin intervención manual mientras su configuración de seguridad permanece blindada." },
  ], fr: [
    { type: "paragraph",html: "Un mot de passe seul est une serrure fragile pour un compte capable de déplacer de l’argent réel. Si quelqu’un le devine, le récupère par hameçonnage ou le reprend d’une connexion réutilisée ailleurs, il entre. L’authentification à deux facteurs par SMS comble cette faille. Après avoir saisi votre mot de passe, un code à six chiffres arrive sur votre téléphone par SMS, et sans ce code, la connexion n’aboutit pas." },
    { type: "paragraph",html: "Voici comment l’activer pour votre compte Tradovate réel, et à quoi ressembleront vos connexions une fois qu’elle sera active. L’ensemble prend environ deux minutes." },
    { type: "heading",text: "Avant de commencer" },
    { type: "paragraph",html: "Vous aurez besoin de trois choses :" },
    {
      type: "list",
      items: [
        "Un compte Tradovate réel auquel vous pouvez déjà vous connecter.",
        "Un téléphone capable de recevoir des SMS au numéro que vous allez enregistrer.",
        "Quelques minutes sur la plateforme web ou de bureau (les paramètres Security y sont plus faciles d’accès).",
      ],
    },
    { type: "paragraph",html: "Une précision si vous tradez un compte de prop firm ou d’évaluation : certaines options de sécurité sont gérées par la firme et non par vous ; consultez donc les règles actuelles de votre firme si un paramètre est absent ou grisé." },
    { type: "heading",text: "Configurer la 2FA par SMS dans Tradovate : pas à pas" },
    {
      type: "steps",
      items: [
        { title: "Ouvrir la page Security", html: "Connectez-vous, ouvrez <strong class='text-white'>Application Settings</strong> depuis le menu principal et accédez à la page <strong class='text-white'>Security</strong>. C’est ici que se trouvent toutes les options de protection de la connexion, de l’interrupteur principal de la 2FA jusqu’aux appareils de confiance en bas de page.", image: {"src":`${IMG}/tradovate-sms-2fa-1.png`,"alt":"Menu Application Settings de Tradovate avec la page Security sélectionnée"} },
        { title: "Activer 2-Factor Authentication", html: "Repérez l’interrupteur <strong class='text-white'>2-Factor Authentication</strong> en haut de la page Security et activez-le. C’est la couche de base. Les codes par SMS, les applications d’authentification et les clés de sécurité en dépendent, la 2FA doit donc être activée pour que l’une d’elles apparaisse comme option. Une fois activée, lors de votre première connexion depuis un nouvel appareil, Tradovate vous envoie par e-mail un lien pour approuver ou refuser cette connexion. Approuvez-la une fois et cette machine sera reconnue par la suite.", image: {"src":`${IMG}/tradovate-sms-2fa-2.png`,"alt":"L’interrupteur 2-Factor Authentication activé en haut de la page Security de Tradovate"} },
        { title: "Ajouter votre numéro de téléphone pour le SMS", html: "Faites défiler sous l’interrupteur de la 2FA jusqu’aux méthodes de sécurité supplémentaires. Vous verrez des options pour un code par SMS, une application d’authentification, une clé de sécurité et des appareils de confiance. Choisissez la méthode <strong class='text-white'>SMS / text</strong> et saisissez le numéro de mobile qui doit recevoir vos codes de connexion. Vérifiez bien les chiffres et l’indicatif du pays avant de continuer, car un numéro erroné envoie les codes au mauvais endroit.", image: {"src":`${IMG}/tradovate-sms-2fa-3.png`,"alt":"Saisie d’un numéro de téléphone mobile dans l’option de code SMS de la page Security de Tradovate"} },
        { title: "Vérifier avec le code à six chiffres reçu par SMS", html: "Tradovate envoie par SMS un code à six chiffres au numéro que vous avez saisi. Saisissez ce code dans le champ de confirmation pour prouver que le téléphone est bien le vôtre. S’il n’arrive pas au bout d’une minute, patientez un instant et utilisez l’option de renvoi plutôt que de demander sans cesse un nouveau code. Une fois le code validé, le SMS est actif sur votre compte.", image: {"src":`${IMG}/tradovate-sms-2fa-4.png`,"alt":"Champ de confirmation pour saisir le code de vérification SMS à six chiffres envoyé par Tradovate"} },
        { title: "Définir une méthode de secours", html: "Lorsque vous ajoutez une méthode de vérification, il vous sera demandé de choisir aussi une méthode de secours. Faites-le. Les téléphones se perdent, se remplacent et se réinitialisent, et sans second moyen d’accès, vous pouvez vous retrouver bloqué hors de votre propre compte. Une application d’authentification ou une clé de sécurité constituent toutes deux de bonnes solutions de secours, et vos appareils de confiance reconnus offrent une autre voie. Enregistrez vos modifications et c’est terminé.", image: {"src":`${IMG}/tradovate-sms-2fa-5.png`,"alt":"Sélection d’une méthode d’authentification de secours, comme une application d’authentification ou une clé de sécurité, dans Tradovate"} },
      ],
    },
    { type: "heading",text: "À quoi ressemblera votre prochaine connexion" },
    { type: "paragraph",html: "Désormais, la connexion depuis une nouvelle machine se déroule dans cet ordre : vous saisissez votre nom d’utilisateur et votre mot de passe, Tradovate vous envoie un e-mail pour approuver ou refuser le nouvel appareil, puis le code à six chiffres reçu par SMS vous est demandé. Saisissez-le et vous êtes connecté. Sur un appareil déjà approuvé, vous ne serez pas sollicité à chaque fois, ce qui évite que cette sécurité supplémentaire devienne une contrainte quotidienne." },
    { type: "heading",text: "Si le code n’arrive jamais" },
    { type: "paragraph",html: "Un SMS manquant s’explique généralement par des raisons banales : le numéro a été saisi avec une faute de frappe, votre téléphone n’a pas de réseau ou le filtrage de l’opérateur retient le message. Vérifiez le numéro sur la page Security, contrôlez votre réseau et patientez un instant avant de renvoyer. Si les SMS n’arrivent toujours pas, votre méthode de secours (l’application d’authentification ou la clé de sécurité de la configuration ci-dessus) vous permettra d’entrer pendant que vous réglez le problème du téléphone." },
    { type: "heading",text: "Automatisez tout cela avec PickMyTrade" },
    { type: "paragraph",html: "Vous exécutez une stratégie automatisée et ne voulez pas qu’une invite de connexion interrompe vos exécutions ? PickMyTrade automatise le flux d’ordres de votre compte Tradovate afin que vos alertes y parviennent sans intervention, tandis que vos paramètres de sécurité restent verrouillés." },
  ], it: [
    { type: "paragraph",html: "Una password da sola è una serratura debole per un conto che può muovere denaro reale. Se qualcuno la indovina, la ottiene tramite phishing o la ricava da un accesso riutilizzato altrove, entra. L’autenticazione a due fattori tramite SMS colma questa lacuna. Dopo aver digitato la password, un codice di sei cifre arriva sul Suo telefono tramite SMS, e senza quel codice l’accesso non porta da nessuna parte." },
    { type: "paragraph",html: "Ecco come attivarla sul Suo conto Tradovate reale e come saranno i Suoi accessi una volta attiva. L’intera procedura richiede circa due minuti." },
    { type: "heading",text: "Prima di iniziare" },
    { type: "paragraph",html: "Le serviranno tre cose:" },
    {
      type: "list",
      items: [
        "Un conto Tradovate reale al quale può già accedere.",
        "Un telefono in grado di ricevere SMS al numero che registrerà.",
        "Un paio di minuti sulla piattaforma web o desktop (le impostazioni Security sono più facili da raggiungere da lì).",
      ],
    },
    { type: "paragraph",html: "Un avviso se opera con un conto prop firm o di valutazione: alcune opzioni di sicurezza sono gestite dalla società e non da Lei, quindi controlli le regole attuali della Sua società se un’impostazione manca o appare disattivata." },
    { type: "heading",text: "Configurare la 2FA via SMS in Tradovate: passo dopo passo" },
    {
      type: "steps",
      items: [
        { title: "Aprire la pagina Security", html: "Acceda, apra <strong class='text-white'>Application Settings</strong> dal menu principale e vada alla pagina <strong class='text-white'>Security</strong>. Qui si trovano tutte le opzioni di protezione dell’accesso, dall’interruttore principale della 2FA ai dispositivi attendibili in fondo.", image: {"src":`${IMG}/tradovate-sms-2fa-1.png`,"alt":"Menu Application Settings di Tradovate con la pagina Security selezionata"} },
        { title: "Attivare 2-Factor Authentication", html: "Trovi l’interruttore <strong class='text-white'>2-Factor Authentication</strong> nella parte superiore della pagina Security e lo attivi. È il livello di base. I codici via SMS, le app di autenticazione e le chiavi di sicurezza dipendono tutti da esso, quindi la 2FA deve essere attiva perché una qualsiasi di queste opzioni compaia. Con la 2FA attiva, al primo accesso da un nuovo dispositivo Tradovate Le invia via e-mail un link per approvare o negare quell’accesso. Lo approvi una volta e quella macchina verrà riconosciuta in futuro.", image: {"src":`${IMG}/tradovate-sms-2fa-2.png`,"alt":"L’interruttore 2-Factor Authentication attivato nella parte superiore della pagina Security di Tradovate"} },
        { title: "Aggiungere il numero di telefono per gli SMS", html: "Scorra verso il basso sotto l’interruttore della 2FA fino ai metodi di sicurezza aggiuntivi. Vedrà opzioni per un codice via SMS, un’app di autenticazione, una chiave di sicurezza e i dispositivi attendibili. Scelga il metodo <strong class='text-white'>SMS / text</strong> e inserisca il numero di cellulare che deve ricevere i Suoi codici di accesso. Controlli con attenzione le cifre e il prefisso internazionale prima di proseguire, perché un numero errato significa che i codici arrivano nel posto sbagliato.", image: {"src":`${IMG}/tradovate-sms-2fa-3.png`,"alt":"Inserimento di un numero di cellulare nell’opzione del codice SMS nella pagina Security di Tradovate"} },
        { title: "Verificare con il codice di sei cifre ricevuto via SMS", html: "Tradovate invia un codice di sei cifre via SMS al numero inserito. Digiti quel codice nel campo di conferma per dimostrare che il telefono è davvero Suo. Se non arriva entro un minuto, attenda un momento e usi l’opzione di reinvio invece di richiedere continuamente un nuovo codice. Una volta convalidato il codice, l’SMS è attivo sul Suo conto.", image: {"src":`${IMG}/tradovate-sms-2fa-4.png`,"alt":"Campo di conferma per inserire il codice di verifica SMS di sei cifre inviato da Tradovate"} },
        { title: "Impostare un metodo di riserva", html: "Quando aggiunge un metodo di verifica, Le verrà chiesto di scegliere anche un metodo di riserva. Lo faccia. I telefoni si perdono, si sostituiscono e si ripristinano, e senza un secondo modo per accedere può restare escluso dal Suo stesso conto. Sia un’app di autenticazione sia una chiave di sicurezza sono buone soluzioni di riserva, e i Suoi dispositivi attendibili riconosciuti offrono un’ulteriore via. Salvi le modifiche e ha finito.", image: {"src":`${IMG}/tradovate-sms-2fa-5.png`,"alt":"Selezione di un metodo di autenticazione di riserva, come un’app di autenticazione o una chiave di sicurezza, in Tradovate"} },
      ],
    },
    { type: "heading",text: "Come sarà il Suo prossimo accesso" },
    { type: "paragraph",html: "D’ora in poi, l’accesso da una nuova macchina seguirà quest’ordine: inserisce nome utente e password, Tradovate Le invia un’e-mail per approvare o negare il nuovo dispositivo, e poi Le viene chiesto il codice di sei cifre ricevuto via SMS. Lo inserisca e sarà dentro. Su un dispositivo già approvato non Le verrà richiesto ogni volta, così la sicurezza aggiuntiva non diventa un fastidio quotidiano." },
    { type: "heading",text: "Se il codice non arriva" },
    { type: "paragraph",html: "Un SMS mancante di solito dipende da cause comuni: il numero è stato inserito con un errore di battitura, il telefono non ha segnale oppure il filtraggio dell’operatore trattiene il messaggio. Verifichi il numero nella pagina Security, controlli il segnale e attenda un momento prima di reinviare. Se gli SMS continuano a non arrivare, il Suo metodo di riserva (l’app di autenticazione o la chiave di sicurezza della configurazione sopra) Le permetterà di accedere mentre risolve il problema del telefono." },
    { type: "heading",text: "Automatizzi tutto questo con PickMyTrade" },
    { type: "paragraph",html: "Esegue una strategia automatizzata e non vuole che una richiesta di accesso interrompa le Sue esecuzioni? PickMyTrade automatizza il flusso di ordini del Suo conto Tradovate in modo che i Suoi alert arrivino al conto senza intervento manuale, mentre le Sue impostazioni di sicurezza restano protette." },
  ] },
  ctaHeading: { en: "Keep Your Account Locked Down and Hands-Free", de: "Halten Sie Ihr Konto gesichert und Ihren Handel automatisiert", es: "Mantenga su cuenta protegida y su operativa automatizada", fr: "Gardez votre compte verrouillé et votre trading automatisé", it: "Mantenga il Suo conto protetto e il Suo trading automatizzato" },
