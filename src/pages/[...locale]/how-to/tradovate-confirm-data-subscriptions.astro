---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "tradovate-confirm-data-subscriptions";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/how-to/${SLUG}`;

const META_TITLE = "Confirm Active Market Data Subscriptions in Tradovate";
const META_DESCRIPTION =
  "Check which market data feeds are active on your Tradovate account, tell live from delayed quotes, and clear orange delayed symbols before you trade.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Aktive Marktdaten-Abonnements in Tradovate bestätigen", es: "Confirme las suscripciones activas de datos de mercado en Tradovate", fr: "Confirmer vos abonnements de données de marché actifs dans Tradovate", it: "Confermare gli abbonamenti attivi ai dati di mercato in Tradovate" },
  dek: { en: "Before you risk a single tick, you want to know exactly what data your account is pulling. Here's how to see which market data subscriptions are active, and confirm the feed is live, not delayed.", de: "Bevor Sie auch nur einen Tick riskieren, sollten Sie genau wissen, welche Daten Ihr Konto bezieht. So sehen Sie, welche Marktdaten-Abonnements aktiv sind, und bestätigen, dass der Feed live und nicht verzögert ist.", es: "Antes de arriesgar un solo tick, conviene saber exactamente qué datos recibe su cuenta. Así puede ver qué suscripciones de datos de mercado están activas y confirmar que el feed es en vivo y no diferido.", fr: "Avant de risquer le moindre tick, vous voulez savoir exactement quelles données votre compte reçoit. Voici comment voir quels abonnements de données de marché sont actifs et confirmer que le flux est en direct, et non différé.", it: "Prima di rischiare anche un solo tick, vuole sapere esattamente quali dati sta ricevendo il Suo account. Ecco come vedere quali abbonamenti ai dati di mercato sono attivi e confermare che il feed è live e non ritardato." },
  readTime: { en: "5 min read", de: "5 Min. Lesezeit", es: "Lectura de 5 min", fr: "Lecture : 5 min", it: "Lettura di 5 min" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "Before you risk a single tick, you want to know exactly what data your account is pulling. Are your NQ and ES quotes live, or are you looking at a feed that's ten minutes behind the market? Tradovate keeps the answer in one place, and checking takes under a minute. Here's how to see which market data subscriptions are active, and how to confirm the feed is actually live rather than delayed." },
    { type: "heading", text: "Where Tradovate Lists Your Active Data Subscriptions" },
    { type: "paragraph", html: "Every active feed lives under <strong class='text-white'>Application Settings</strong>, in the <strong class='text-white'>Market Data</strong> section (reachable on its own or through <strong class='text-white'>Subscriptions</strong>). Whatever you're subscribed to shows up in that list with its exchange and status. If the list is empty, no live subscription is attached to the login you're using, and your charts are running on the free delayed feed." },
    { type: "heading", text: "Confirm Your Active Subscriptions: Step by Step" },
    {
      type: "steps",
      items: [
        { title: "Open Application Settings", html: "Log in to Tradovate on the web or desktop app. Open <strong class='text-white'>Application Settings</strong> using the settings icon in the top-right corner of the screen. It's the same menu where you manage risk limits, plans, and your account profile." },
        { title: "Go to the Subscriptions and Market Data Section", html: "Inside Application Settings, open <strong class='text-white'>Subscriptions</strong> and find <strong class='text-white'>Market Data</strong>. On some layouts you can simply scroll down to the <strong class='text-white'>Market Data</strong> section without a separate Subscriptions tab. Either path lands you on the same place: the summary of what data your account is paying for." },
        { title: "Read Your Active Data Subscriptions", html: "This is the part that matters. Each active feed is listed with its exchange, so you can see at a glance whether you're carrying, say, a CME real-time package or nothing at all. From here you'll also see buttons to add, change, or cancel a feed. If you expected live CME futures data and the list is blank, that's your problem right there, and you'll want to <a href='https://pickmytrade.trade/how-to/tradovate-subscribe-market-data/'>subscribe to a real-time market data package</a> before trading." },
        { title: "Cross-Check Live vs Delayed on a Chart", html: "The settings list tells you what you've bought. The chart tells you what's actually flowing. Open a chart or the DOM for a contract and look at the <strong class='text-white'>symbol name</strong>: if it's <strong class='text-white'>orange</strong>, the feed is delayed, not live, even if a subscription appears active. A symbol in its normal color, plus a green connection indicator in the top-right corner, confirms the data is real-time. Don't trade while symbols are orange, since delayed prices can fill you far from where you thought you were." },
      ],
    },
    { type: "heading", text: "Live vs Delayed: A Quick Reference" },
    { type: "table", headers: ["What you see", "What it means"], rows: [
      ["Feed listed under Market Data with a matching exchange", "You hold an active subscription for that exchange"],
      ["Empty Market Data list", "No live subscription on this login; charts run on the delayed feed"],
      ["Symbol name in normal color + green connection dot", "Live, real-time data"],
      ["Orange symbol name", "Roughly 10-minute delayed data; don't trade on it"],
    ] },
    { type: "paragraph", html: "If your symbols stay orange after you've confirmed a subscription, log out and back in to refresh the entitlement. Still delayed? Walk through the <a href='https://pickmytrade.trade/debugging/ten-minute-delayed-data-orange-symbols/'>10-minute delayed data and orange symbols fix</a>, which covers the exact order of operations to flip the feed live." },
    { type: "heading", text: "On a Prop-Firm or Evaluation Account?" },
    { type: "paragraph", html: "This is where a lot of confusion starts. On evaluation and funded prop accounts, market data is controlled by the firm that owns the account, not by you. The Market Data section may look empty or locked, and self-subscribing usually won't stick. If your prop data is delayed or missing, <a href='https://pickmytrade.trade/debugging/prop-account-market-data-provider-only/'>contact your prop firm to enable it</a> rather than buying a feed through Tradovate directly. Data packages, fees, and what's included vary by firm and account size, so check your firm's current rules before assuming anything." },
    { type: "heading", text: "Automate with PickMyTrade" },
    { type: "paragraph", html: "Once you've confirmed your data is live, <strong class='text-white'>PickMyTrade wires your TradingView alerts straight to your Tradovate account</strong>, so every entry, stop, and target fires on its own. Live data on both ends keeps your signals lined up with the real market instead of a lagging feed." },
  ], de: [
    { type: "paragraph",html: "Bevor Sie auch nur einen Tick riskieren, sollten Sie genau wissen, welche Daten Ihr Konto bezieht. Sind Ihre NQ- und ES-Kurse live, oder blicken Sie auf einen Feed, der zehn Minuten hinter dem Markt herhinkt? Tradovate hält die Antwort an einer Stelle bereit, und die Prüfung dauert weniger als eine Minute. So sehen Sie, welche Marktdaten-Abonnements aktiv sind, und bestätigen, dass der Feed tatsächlich live und nicht verzögert ist." },
    { type: "heading",text: "Wo Tradovate Ihre aktiven Datenabonnements auflistet" },
    { type: "paragraph",html: "Jeder aktive Feed befindet sich unter <strong class='text-white'>Application Settings</strong> im Bereich <strong class='text-white'>Market Data</strong> (direkt oder über <strong class='text-white'>Subscriptions</strong> erreichbar). Alles, was Sie abonniert haben, erscheint in dieser Liste mit Börse und Status. Ist die Liste leer, ist an das verwendete Login kein Live-Abonnement geknüpft, und Ihre Charts laufen auf dem kostenlosen verzögerten Feed." },
    { type: "heading",text: "Aktive Abonnements bestätigen: Schritt für Schritt" },
    {
      type: "steps",
      items: [
        { title: "Application Settings öffnen", html: "Melden Sie sich bei Tradovate im Web oder in der Desktop-App an. Öffnen Sie <strong class='text-white'>Application Settings</strong> über das Einstellungssymbol oben rechts auf dem Bildschirm. Es ist dasselbe Menü, in dem Sie Risikolimits, Tarife und Ihr Kontoprofil verwalten." },
        { title: "Zum Bereich Subscriptions und Market Data wechseln", html: "Öffnen Sie in Application Settings den Bereich <strong class='text-white'>Subscriptions</strong> und suchen Sie <strong class='text-white'>Market Data</strong>. In manchen Layouts können Sie einfach zum Abschnitt <strong class='text-white'>Market Data</strong> hinunterscrollen, ohne einen separaten Tab Subscriptions. Beide Wege führen zum selben Ziel: der Übersicht, für welche Daten Ihr Konto bezahlt." },
        { title: "Ihre aktiven Datenabonnements ablesen", html: "Das ist der entscheidende Teil. Jeder aktive Feed wird mit seiner Börse aufgeführt, sodass Sie auf einen Blick sehen, ob Sie zum Beispiel ein CME-Echtzeitpaket haben oder gar nichts. Von hier aus sehen Sie auch Schaltflächen, um einen Feed hinzuzufügen, zu ändern oder zu kündigen. Wenn Sie Live-CME-Futures-Daten erwartet haben und die Liste leer ist, liegt dort Ihr Problem, und Sie sollten vor dem Handel <a href='https://pickmytrade.trade/how-to/tradovate-subscribe-market-data/'>ein Echtzeit-Marktdatenpaket abonnieren</a>." },
        { title: "Live gegenüber verzögert im Chart gegenprüfen", html: "Die Einstellungsliste zeigt, was Sie gekauft haben. Der Chart zeigt, was tatsächlich fließt. Öffnen Sie einen Chart oder das DOM für einen Kontrakt und sehen Sie sich den <strong class='text-white'>Symbolnamen</strong> an: Ist er <strong class='text-white'>orange</strong>, ist der Feed verzögert und nicht live, selbst wenn ein Abonnement aktiv erscheint. Ein Symbol in der normalen Farbe sowie eine grüne Verbindungsanzeige oben rechts bestätigen, dass die Daten in Echtzeit sind. Handeln Sie nicht, solange Symbole orange sind, denn verzögerte Kurse können Sie weit entfernt von dort ausführen, wo Sie dachten." },
      ],
    },
    { type: "heading",text: "Live vs. verzögert: kurze Übersicht" },
    { type: "table", headers: ["Was Sie sehen","Was es bedeutet"], rows: [
      ["Feed unter Market Data mit passender Börse aufgeführt","Sie haben ein aktives Abonnement für diese Börse"],
      ["Leere Market-Data-Liste","Kein Live-Abonnement für dieses Login; Charts laufen auf dem verzögerten Feed"],
      ["Symbolname in normaler Farbe + grüner Verbindungspunkt","Live-Daten in Echtzeit"],
      ["Orangefarbener Symbolname","Etwa 10 Minuten verzögerte Daten; handeln Sie nicht damit"],
    ] },
    { type: "paragraph",html: "Bleiben Ihre Symbole orange, obwohl Sie ein Abonnement bestätigt haben, melden Sie sich ab und wieder an, um die Berechtigung zu aktualisieren. Immer noch verzögert? Gehen Sie die <a href='https://pickmytrade.trade/debugging/ten-minute-delayed-data-orange-symbols/'>Lösung für 10-Minuten-verzögerte Daten und orange Symbole</a> durch, die die genaue Reihenfolge der Schritte beschreibt, mit der der Feed live geschaltet wird." },
    { type: "heading",text: "Bei einem Prop-Firm- oder Evaluierungskonto?" },
    { type: "paragraph",html: "Hier beginnt bei vielen die Verwirrung. Bei Evaluierungs- und Funded-Prop-Konten werden die Marktdaten von der Firma kontrolliert, der das Konto gehört, nicht von Ihnen. Der Bereich Market Data kann leer oder gesperrt wirken, und ein eigenes Abonnement greift in der Regel nicht. Sind Ihre Prop-Daten verzögert oder fehlen, <a href='https://pickmytrade.trade/debugging/prop-account-market-data-provider-only/'>wenden Sie sich an Ihre Prop Firm, damit sie sie freischaltet</a>, statt direkt über Tradovate einen Feed zu kaufen. Datenpakete, Gebühren und Leistungsumfang variieren je nach Firma und Kontogröße. Prüfen Sie daher die aktuellen Regeln Ihrer Firma, bevor Sie etwas annehmen." },
    { type: "heading",text: "Automatisieren mit PickMyTrade" },
    { type: "paragraph",html: "Sobald Sie bestätigt haben, dass Ihre Daten live sind, <strong class='text-white'>verbindet PickMyTrade Ihre TradingView-Alerts direkt mit Ihrem Tradovate-Konto</strong>, sodass jeder Einstieg, Stopp und jedes Ziel von selbst ausgelöst wird. Live-Daten auf beiden Seiten halten Ihre Signale mit dem echten Markt im Einklang statt mit einem hinterherhinkenden Feed." },
  ], es: [
    { type: "paragraph",html: "Antes de arriesgar un solo tick, conviene saber exactamente qué datos recibe su cuenta. ¿Sus cotizaciones de NQ y ES son en vivo o está mirando un feed que va diez minutos por detrás del mercado? Tradovate guarda la respuesta en un solo lugar y comprobarlo lleva menos de un minuto. Así puede ver qué suscripciones de datos de mercado están activas y confirmar que el feed es realmente en vivo y no diferido." },
    { type: "heading",text: "Dónde muestra Tradovate sus suscripciones de datos activas" },
    { type: "paragraph",html: "Cada feed activo se encuentra en <strong class='text-white'>Application Settings</strong>, en la sección <strong class='text-white'>Market Data</strong> (accesible directamente o a través de <strong class='text-white'>Subscriptions</strong>). Todo aquello a lo que esté suscrito aparece en esa lista con su bolsa y estado. Si la lista está vacía, no hay ninguna suscripción en vivo asociada al acceso que está usando, y sus gráficos funcionan con el feed diferido gratuito." },
    { type: "heading",text: "Confirme sus suscripciones activas: paso a paso" },
    {
      type: "steps",
      items: [
        { title: "Abra Application Settings", html: "Inicie sesión en Tradovate en la web o en la aplicación de escritorio. Abra <strong class='text-white'>Application Settings</strong> con el icono de ajustes de la esquina superior derecha de la pantalla. Es el mismo menú donde gestiona los límites de riesgo, los planes y el perfil de su cuenta." },
        { title: "Vaya a la sección Subscriptions y Market Data", html: "Dentro de Application Settings, abra <strong class='text-white'>Subscriptions</strong> y localice <strong class='text-white'>Market Data</strong>. En algunos diseños basta con desplazarse hasta la sección <strong class='text-white'>Market Data</strong> sin una pestaña Subscriptions aparte. Ambos caminos llevan al mismo sitio: el resumen de los datos por los que paga su cuenta." },
        { title: "Lea sus suscripciones de datos activas", html: "Esta es la parte que importa. Cada feed activo aparece con su bolsa, de modo que puede ver de un vistazo si tiene, por ejemplo, un paquete CME en tiempo real o nada en absoluto. Desde aquí también verá botones para añadir, cambiar o cancelar un feed. Si esperaba datos de futuros CME en vivo y la lista está en blanco, ahí está su problema, y antes de operar querrá <a href='https://pickmytrade.trade/how-to/tradovate-subscribe-market-data/'>suscribirse a un paquete de datos de mercado en tiempo real</a>." },
        { title: "Compruebe en un gráfico si es en vivo o diferido", html: "La lista de ajustes le dice lo que ha contratado. El gráfico le dice lo que realmente fluye. Abra un gráfico o el DOM de un contrato y mire el <strong class='text-white'>nombre del símbolo</strong>: si está en <strong class='text-white'>naranja</strong>, el feed es diferido, no en vivo, aunque aparezca una suscripción activa. Un símbolo con su color normal, junto con un indicador de conexión verde en la esquina superior derecha, confirma que los datos son en tiempo real. No opere mientras los símbolos estén en naranja, ya que los precios diferidos pueden ejecutarlo muy lejos de donde creía." },
      ],
    },
    { type: "heading",text: "En vivo vs diferido: referencia rápida" },
    { type: "table", headers: ["Lo que ve","Lo que significa"], rows: [
      ["Feed listado en Market Data con la bolsa correspondiente","Tiene una suscripción activa para esa bolsa"],
      ["Lista de Market Data vacía","No hay suscripción en vivo en este acceso; los gráficos usan el feed diferido"],
      ["Nombre del símbolo en color normal + punto de conexión verde","Datos en vivo, en tiempo real"],
      ["Nombre del símbolo en naranja","Datos con unos 10 minutos de retraso; no opere con ellos"],
    ] },
    { type: "paragraph",html: "Si sus símbolos siguen en naranja después de confirmar una suscripción, cierre sesión y vuelva a entrar para actualizar la autorización. ¿Sigue diferido? Siga la <a href='https://pickmytrade.trade/debugging/ten-minute-delayed-data-orange-symbols/'>solución para datos con 10 minutos de retraso y símbolos naranjas</a>, que detalla el orden exacto de pasos para activar el feed en vivo." },
    { type: "heading",text: "¿En una cuenta de prop firm o de evaluación?" },
    { type: "paragraph",html: "Aquí es donde empieza mucha de la confusión. En las cuentas de prop de evaluación y financiadas, los datos de mercado los controla la firma propietaria de la cuenta, no usted. La sección Market Data puede aparecer vacía o bloqueada, y suscribirse por su cuenta normalmente no funciona. Si sus datos de la prop están diferidos o no aparecen, <a href='https://pickmytrade.trade/debugging/prop-account-market-data-provider-only/'>contacte con su prop firm para que los active</a> en lugar de comprar un feed directamente a través de Tradovate. Los paquetes de datos, las tarifas y lo que incluyen varían según la firma y el tamaño de la cuenta, así que consulte las reglas vigentes de su firma antes de dar nada por supuesto." },
    { type: "heading",text: "Automatice con PickMyTrade" },
    { type: "paragraph",html: "Una vez confirmado que sus datos son en vivo, <strong class='text-white'>PickMyTrade conecta sus alertas de TradingView directamente con su cuenta de Tradovate</strong> para que cada entrada, stop y objetivo se ejecute por sí solo. Los datos en vivo en ambos extremos mantienen sus señales alineadas con el mercado real y no con un feed retrasado." },
  ], fr: [
    { type: "paragraph",html: "Avant de risquer le moindre tick, vous voulez savoir exactement quelles données votre compte reçoit. Vos cotations NQ et ES sont-elles en direct, ou regardez-vous un flux qui a dix minutes de retard sur le marché ? Tradovate conserve la réponse à un seul endroit, et la vérification prend moins d'une minute. Voici comment voir quels abonnements de données de marché sont actifs et comment confirmer que le flux est réellement en direct et non différé." },
    { type: "heading",text: "Où Tradovate liste vos abonnements de données actifs" },
    { type: "paragraph",html: "Chaque flux actif se trouve dans <strong class='text-white'>Application Settings</strong>, dans la section <strong class='text-white'>Market Data</strong> (accessible directement ou via <strong class='text-white'>Subscriptions</strong>). Tout ce à quoi vous êtes abonné apparaît dans cette liste avec sa bourse et son statut. Si la liste est vide, aucun abonnement en direct n'est rattaché à l'identifiant que vous utilisez, et vos graphiques tournent sur le flux différé gratuit." },
    { type: "heading",text: "Confirmer vos abonnements actifs : étape par étape" },
    {
      type: "steps",
      items: [
        { title: "Ouvrez Application Settings", html: "Connectez-vous à Tradovate sur le web ou dans l'application de bureau. Ouvrez <strong class='text-white'>Application Settings</strong> avec l'icône des paramètres en haut à droite de l'écran. C'est le même menu où vous gérez les limites de risque, les forfaits et votre profil de compte." },
        { title: "Accédez à la section Subscriptions et Market Data", html: "Dans Application Settings, ouvrez <strong class='text-white'>Subscriptions</strong> et repérez <strong class='text-white'>Market Data</strong>. Sur certaines interfaces, vous pouvez simplement faire défiler jusqu'à la section <strong class='text-white'>Market Data</strong> sans onglet Subscriptions distinct. Dans les deux cas, vous arrivez au même endroit : le récapitulatif des données que votre compte paie." },
        { title: "Lisez vos abonnements de données actifs", html: "C'est la partie qui compte. Chaque flux actif est listé avec sa bourse, ce qui vous permet de voir d'un coup d'œil si vous disposez, par exemple, d'un forfait CME en temps réel ou de rien du tout. Vous y verrez aussi des boutons pour ajouter, modifier ou annuler un flux. Si vous attendiez des données de contrats à terme CME en direct et que la liste est vide, c'est là que se trouve votre problème, et vous voudrez <a href='https://pickmytrade.trade/how-to/tradovate-subscribe-market-data/'>vous abonner à un forfait de données de marché en temps réel</a> avant de trader." },
        { title: "Vérifiez sur un graphique si les données sont en direct ou différées", html: "La liste des paramètres indique ce que vous avez acheté. Le graphique indique ce qui arrive réellement. Ouvrez un graphique ou le DOM d'un contrat et regardez le <strong class='text-white'>nom du symbole</strong> : s'il est <strong class='text-white'>orange</strong>, le flux est différé, pas en direct, même si un abonnement apparaît actif. Un symbole de couleur normale, accompagné d'un indicateur de connexion vert en haut à droite, confirme que les données sont en temps réel. Ne tradez pas tant que les symboles sont orange, car des cours différés peuvent vous exécuter très loin de l'endroit où vous pensiez." },
      ],
    },
    { type: "heading",text: "En direct vs différé : référence rapide" },
    { type: "table", headers: ["Ce que vous voyez","Ce que cela signifie"], rows: [
      ["Flux listé sous Market Data avec la bourse correspondante","Vous avez un abonnement actif pour cette bourse"],
      ["Liste Market Data vide","Aucun abonnement en direct sur cet identifiant ; les graphiques tournent sur le flux différé"],
      ["Nom du symbole de couleur normale + point de connexion vert","Données en direct, en temps réel"],
      ["Nom du symbole en orange","Données différées d'environ 10 minutes ; ne tradez pas dessus"],
    ] },
    { type: "paragraph",html: "Si vos symboles restent orange après avoir confirmé un abonnement, déconnectez-vous puis reconnectez-vous pour actualiser l'autorisation. Toujours différé ? Suivez la <a href='https://pickmytrade.trade/debugging/ten-minute-delayed-data-orange-symbols/'>solution pour les données différées de 10 minutes et les symboles orange</a>, qui détaille l'ordre exact des opérations pour basculer le flux en direct." },
    { type: "heading",text: "Sur un compte de prop firm ou d'évaluation ?" },
    { type: "paragraph",html: "C'est ici que beaucoup de confusion commence. Sur les comptes de prop d'évaluation et financés, les données de marché sont contrôlées par la firme qui détient le compte, pas par vous. La section Market Data peut sembler vide ou verrouillée, et un abonnement de votre part ne tiendra généralement pas. Si vos données de prop sont différées ou absentes, <a href='https://pickmytrade.trade/debugging/prop-account-market-data-provider-only/'>contactez votre prop firm pour qu'elle les active</a> plutôt que d'acheter un flux directement via Tradovate. Les forfaits de données, les tarifs et ce qui est inclus varient selon la firme et la taille du compte ; vérifiez donc les règles en vigueur de votre firme avant de supposer quoi que ce soit." },
    { type: "heading",text: "Automatisez avec PickMyTrade" },
    { type: "paragraph",html: "Une fois que vous avez confirmé que vos données sont en direct, <strong class='text-white'>PickMyTrade relie vos alertes TradingView directement à votre compte Tradovate</strong> pour que chaque entrée, stop et objectif s'exécute tout seul. Des données en direct des deux côtés maintiennent vos signaux alignés sur le marché réel plutôt que sur un flux en retard." },
  ], it: [
    { type: "paragraph",html: "Prima di rischiare anche un solo tick, vuole sapere esattamente quali dati sta ricevendo il Suo account. Le Sue quotazioni di NQ e ES sono live, o sta guardando un feed in ritardo di dieci minuti rispetto al mercato? Tradovate conserva la risposta in un unico posto, e controllare richiede meno di un minuto. Ecco come vedere quali abbonamenti ai dati di mercato sono attivi e come confermare che il feed sia davvero live e non ritardato." },
    { type: "heading",text: "Dove Tradovate elenca i Suoi abbonamenti ai dati attivi" },
    { type: "paragraph",html: "Ogni feed attivo si trova in <strong class='text-white'>Application Settings</strong>, nella sezione <strong class='text-white'>Market Data</strong> (raggiungibile direttamente o tramite <strong class='text-white'>Subscriptions</strong>). Tutto ciò a cui è abbonato compare in quell'elenco con la sua borsa e il suo stato. Se l'elenco è vuoto, nessun abbonamento live è collegato al login che sta usando e i Suoi grafici funzionano con il feed ritardato gratuito." },
    { type: "heading",text: "Confermi i Suoi abbonamenti attivi: passo dopo passo" },
    {
      type: "steps",
      items: [
        { title: "Apra Application Settings", html: "Acceda a Tradovate dal web o dall'app desktop. Apra <strong class='text-white'>Application Settings</strong> con l'icona delle impostazioni in alto a destra dello schermo. È lo stesso menu in cui gestisce i limiti di rischio, i piani e il profilo del Suo account." },
        { title: "Vada alla sezione Subscriptions e Market Data", html: "All'interno di Application Settings, apra <strong class='text-white'>Subscriptions</strong> e trovi <strong class='text-white'>Market Data</strong>. In alcuni layout può semplicemente scorrere fino alla sezione <strong class='text-white'>Market Data</strong> senza una scheda Subscriptions separata. Entrambi i percorsi portano allo stesso punto: il riepilogo dei dati per cui il Suo account paga." },
        { title: "Legga i Suoi abbonamenti ai dati attivi", html: "Questa è la parte che conta. Ogni feed attivo è elencato con la sua borsa, così può vedere a colpo d'occhio se ha, per esempio, un pacchetto CME in tempo reale o nulla. Da qui vedrà anche i pulsanti per aggiungere, modificare o annullare un feed. Se si aspettava dati live dei futures CME e l'elenco è vuoto, il problema è proprio qui, e prima di operare dovrà <a href='https://pickmytrade.trade/how-to/tradovate-subscribe-market-data/'>abbonarsi a un pacchetto di dati di mercato in tempo reale</a>." },
        { title: "Verifichi su un grafico se i dati sono live o ritardati", html: "L'elenco delle impostazioni Le dice che cosa ha acquistato. Il grafico Le dice che cosa sta effettivamente arrivando. Apra un grafico o il DOM di un contratto e guardi il <strong class='text-white'>nome del simbolo</strong>: se è <strong class='text-white'>arancione</strong>, il feed è ritardato, non live, anche se un abbonamento risulta attivo. Un simbolo di colore normale, insieme a un indicatore di connessione verde in alto a destra, conferma che i dati sono in tempo reale. Non operi finché i simboli sono arancioni, perché i prezzi ritardati possono farLa eseguire molto lontano da dove pensava." },
      ],
    },
    { type: "heading",text: "Live vs ritardato: riferimento rapido" },
    { type: "table", headers: ["Che cosa vede","Che cosa significa"], rows: [
      ["Feed elencato sotto Market Data con la borsa corrispondente","Ha un abbonamento attivo per quella borsa"],
      ["Elenco Market Data vuoto","Nessun abbonamento live su questo login; i grafici usano il feed ritardato"],
      ["Nome del simbolo di colore normale + punto di connessione verde","Dati live, in tempo reale"],
      ["Nome del simbolo arancione","Dati ritardati di circa 10 minuti; non operi su di essi"],
    ] },
    { type: "paragraph",html: "Se i simboli restano arancioni dopo che ha confermato un abbonamento, esca e acceda di nuovo per aggiornare l'autorizzazione. Ancora ritardato? Consulti la <a href='https://pickmytrade.trade/debugging/ten-minute-delayed-data-orange-symbols/'>soluzione per dati ritardati di 10 minuti e simboli arancioni</a>, che illustra l'ordine esatto dei passaggi per portare il feed in modalità live." },
    { type: "heading",text: "Su un account prop firm o di valutazione?" },
    { type: "paragraph",html: "È qui che inizia molta confusione. Sugli account prop di valutazione e finanziati, i dati di mercato sono controllati dalla firm proprietaria dell'account, non da Lei. La sezione Market Data può apparire vuota o bloccata, e abbonarsi in autonomia di solito non funziona. Se i Suoi dati prop sono ritardati o mancanti, <a href='https://pickmytrade.trade/debugging/prop-account-market-data-provider-only/'>contatti la Sua prop firm perché li attivi</a> invece di acquistare un feed direttamente tramite Tradovate. Pacchetti di dati, costi e contenuti inclusi variano in base alla firm e alle dimensioni dell'account, quindi controlli le regole correnti della Sua firm prima di dare qualcosa per scontato." },
    { type: "heading",text: "Automatizzi con PickMyTrade" },
    { type: "paragraph",html: "Una volta confermato che i Suoi dati sono live, <strong class='text-white'>PickMyTrade collega i Suoi alert di TradingView direttamente al Suo account Tradovate</strong>, così ogni ingresso, stop e target scatta da solo. Dati live su entrambi i lati mantengono i Suoi segnali allineati al mercato reale anziché a un feed in ritardo." },
  ] },
  ctaHeading: { en: "Trade on Live Data, Automatically", de: "Handeln Sie automatisch mit Live-Daten", es: "Opere con datos en vivo, de forma automática", fr: "Tradez sur des données en direct, automatiquement", it: "Operi con dati live, in automatico" },
  ctaText: { en: "Once you've confirmed your data is live, let PickMyTrade wire your TradingView alerts straight to your Tradovate account so every entry, stop, and target fires on its own.", de: "Sobald Sie bestätigt haben, dass Ihre Daten live sind, lassen Sie PickMyTrade Ihre TradingView-Alerts direkt mit Ihrem Tradovate-Konto verbinden, sodass jeder Einstieg, Stopp und jedes Ziel von selbst ausgelöst wird.", es: "Una vez confirmado que sus datos son en vivo, deje que PickMyTrade conecte sus alertas de TradingView directamente con su cuenta de Tradovate para que cada entrada, stop y objetivo se ejecute por sí solo.", fr: "Une fois que vous avez confirmé que vos données sont en direct, laissez PickMyTrade relier vos alertes TradingView directement à votre compte Tradovate pour que chaque entrée, stop et objectif s'exécute tout seul.", it: "Una volta confermato che i Suoi dati sono live, lasci che PickMyTrade colleghi i Suoi alert di TradingView direttamente al Suo account Tradovate, così ogni ingresso, stop e target scatta da solo." },
  ctaButtonText: { en: "Start Your Free 7-Day Trial", de: "Starten Sie Ihre kostenlose 7-Tage-Testphase", es: "Comience su prueba gratuita de 7 días", fr: "Commencez votre essai gratuit de 7 jours", it: "Inizi la prova gratuita di 7 giorni" },
  ctaUrl: "https://app.pickmytrade.trade/?register=true&utm_source=content&utm_medium=how-to",
  faqHeading: { en: "Frequently Asked Questions", de: "Häufig gestellte Fragen", es: "Preguntas frecuentes", fr: "Foire aux questions", it: "Domande frequenti" },
  faqs: { en: [
    { q: "How do I know if my Tradovate market data is active?", a: "Open Application Settings, go to the Market Data section, and check the list of subscriptions. Anything active shows up with its exchange. Then confirm the feed is live by checking that the symbol name on your chart is a normal color, not orange." },
    { q: "Why does my subscription show as active but my data is still delayed?", a: "An entitlement can take a few minutes to propagate, or the session may still be on the old feed. Log out and log back in to refresh, then recheck the symbol color. If it's still orange, confirm the agreement tied to that feed is fully signed." },
    { q: "Can I check data subscriptions on a prop-firm account the same way?", a: "You can view the section, but on evaluation and funded accounts the firm controls the feed. If data is missing or delayed there, contact your prop firm to enable it instead of subscribing through Tradovate yourself." },
  ], de: [
    { q: "Woran erkenne ich, ob meine Tradovate-Marktdaten aktiv sind?", a: "Öffnen Sie Application Settings, gehen Sie zum Bereich Market Data und prüfen Sie die Liste der Abonnements. Alles Aktive erscheint mit seiner Börse. Bestätigen Sie dann, dass der Feed live ist, indem Sie prüfen, ob der Symbolname in Ihrem Chart in der normalen Farbe und nicht orange angezeigt wird." },
    { q: "Warum wird mein Abonnement als aktiv angezeigt, meine Daten sind aber trotzdem verzögert?", a: "Eine Berechtigung kann einige Minuten brauchen, bis sie greift, oder die Sitzung läuft noch auf dem alten Feed. Melden Sie sich ab und wieder an, um sie zu aktualisieren, und prüfen Sie dann erneut die Symbolfarbe. Ist sie weiterhin orange, vergewissern Sie sich, dass die zu diesem Feed gehörende Vereinbarung vollständig unterzeichnet ist." },
    { q: "Kann ich Datenabonnements bei einem Prop-Firm-Konto auf dieselbe Weise prüfen?", a: "Sie können den Bereich einsehen, aber bei Evaluierungs- und Funded-Konten kontrolliert die Firma den Feed. Fehlen die Daten dort oder sind sie verzögert, wenden Sie sich an Ihre Prop Firm, damit sie sie freischaltet, statt selbst über Tradovate zu abonnieren." },
  ], es: [
    { q: "¿Cómo sé si mis datos de mercado de Tradovate están activos?", a: "Abra Application Settings, vaya a la sección Market Data y revise la lista de suscripciones. Todo lo activo aparece con su bolsa. Después confirme que el feed es en vivo comprobando que el nombre del símbolo en su gráfico tiene un color normal, no naranja." },
    { q: "¿Por qué mi suscripción aparece como activa pero mis datos siguen diferidos?", a: "Una autorización puede tardar unos minutos en propagarse, o la sesión puede seguir en el feed anterior. Cierre sesión y vuelva a iniciarla para actualizar, y compruebe de nuevo el color del símbolo. Si sigue naranja, confirme que el acuerdo vinculado a ese feed esté completamente firmado." },
    { q: "¿Puedo comprobar las suscripciones de datos de una cuenta de prop firm de la misma manera?", a: "Puede ver la sección, pero en las cuentas de evaluación y financiadas el feed lo controla la firma. Si faltan datos o están diferidos, contacte con su prop firm para que los active en lugar de suscribirse usted mismo a través de Tradovate." },
  ], fr: [
    { q: "Comment savoir si mes données de marché Tradovate sont actives ?", a: "Ouvrez Application Settings, allez dans la section Market Data et consultez la liste des abonnements. Tout ce qui est actif apparaît avec sa bourse. Confirmez ensuite que le flux est en direct en vérifiant que le nom du symbole sur votre graphique est de couleur normale, et non orange." },
    { q: "Pourquoi mon abonnement apparaît-il comme actif alors que mes données sont toujours différées ?", a: "Une autorisation peut mettre quelques minutes à se propager, ou la session peut encore utiliser l'ancien flux. Déconnectez-vous puis reconnectez-vous pour actualiser, puis revérifiez la couleur du symbole. S'il est toujours orange, vérifiez que l'accord associé à ce flux est entièrement signé." },
    { q: "Puis-je vérifier les abonnements de données d'un compte de prop firm de la même façon ?", a: "Vous pouvez consulter la section, mais sur les comptes d'évaluation et financés, c'est la firme qui contrôle le flux. Si les données y sont absentes ou différées, contactez votre prop firm pour qu'elle les active plutôt que de vous abonner vous-même via Tradovate." },
  ], it: [
    { q: "Come faccio a sapere se i miei dati di mercato Tradovate sono attivi?", a: "Apra Application Settings, vada alla sezione Market Data e controlli l'elenco degli abbonamenti. Tutto ciò che è attivo compare con la propria borsa. Poi confermi che il feed è live verificando che il nome del simbolo sul grafico abbia un colore normale e non arancione." },
    { q: "Perché il mio abbonamento risulta attivo ma i dati sono ancora ritardati?", a: "Un'autorizzazione può impiegare qualche minuto a propagarsi, oppure la sessione può essere ancora sul vecchio feed. Esca e acceda di nuovo per aggiornare, poi ricontrolli il colore del simbolo. Se è ancora arancione, verifichi che l'accordo collegato a quel feed sia stato firmato per intero." },
    { q: "Posso controllare gli abbonamenti ai dati su un account prop firm allo stesso modo?", a: "Può vedere la sezione, ma sugli account di valutazione e finanziati il feed è controllato dalla firm. Se lì i dati mancano o sono ritardati, contatti la Sua prop firm perché li attivi, invece di abbonarsi da solo tramite Tradovate." },
  ] },
  relatedHeading: { en: "Related Guides", de: "Ähnliche Anleitungen", es: "Guías relacionadas", fr: "Guides associés", it: "Guide correlate" },
  disclosureText: { en: `This guide is for educational and informational purposes only and is not financial, investment, or trading advice. Trading futures and other leveraged products carries a substantial risk of loss and is not suitable for every investor. PickMyTrade is an independent third-party automation platform and is not affiliated with, endorsed by, or sponsored by Tradovate, Inc. "Tradovate" and all related names, logos, and trademarks are the property of their respective owners. Platform features and steps change over time, so always confirm the current process in the official Tradovate platform and documentation before acting.`, de: "Dieser Leitfaden dient ausschließlich Bildungs- und Informationszwecken und stellt keine Finanz-, Anlage- oder Handelsberatung dar. Der Handel mit Futures und anderen gehebelten Produkten birgt ein erhebliches Verlustrisiko und ist nicht für jeden Anleger geeignet. PickMyTrade ist eine unabhängige Automatisierungsplattform eines Drittanbieters und steht in keiner Verbindung zu Tradovate, Inc., wird weder von Tradovate, Inc. unterstützt noch gesponsert. „Tradovate“ und alle zugehörigen Namen, Logos und Marken sind Eigentum ihrer jeweiligen Inhaber. Funktionen und Schritte der Plattform ändern sich im Laufe der Zeit. Bestätigen Sie daher vor dem Handeln stets den aktuellen Ablauf in der offiziellen Tradovate-Plattform und -Dokumentation.", es: "Esta guía tiene fines exclusivamente educativos e informativos y no constituye asesoramiento financiero, de inversión ni de trading. Operar con futuros y otros productos apalancados conlleva un riesgo sustancial de pérdida y no es adecuado para todos los inversores. PickMyTrade es una plataforma de automatización independiente de terceros y no está afiliada, respaldada ni patrocinada por Tradovate, Inc. «Tradovate» y todos los nombres, logotipos y marcas relacionados son propiedad de sus respectivos titulares. Las funciones y los pasos de la plataforma cambian con el tiempo, por lo que debe confirmar siempre el proceso vigente en la plataforma y la documentación oficiales de Tradovate antes de actuar.", fr: "Ce guide est fourni à des fins exclusivement éducatives et informatives et ne constitue pas un conseil financier, d'investissement ou de trading. Le trading de contrats à terme et d'autres produits à effet de levier comporte un risque de perte substantiel et ne convient pas à tous les investisseurs. PickMyTrade est une plateforme d'automatisation tierce indépendante et n'est ni affiliée à Tradovate, Inc., ni approuvée, ni sponsorisée par celle-ci. « Tradovate » et l'ensemble des noms, logos et marques associés sont la propriété de leurs détenteurs respectifs. Les fonctionnalités et les étapes de la plateforme évoluent avec le temps ; vérifiez donc toujours la procédure en vigueur dans la plateforme et la documentation officielles de Tradovate avant d'agir.", it: "Questa guida ha esclusivamente scopo educativo e informativo e non costituisce consulenza finanziaria, di investimento o di trading. Il trading di futures e di altri prodotti a leva comporta un rischio sostanziale di perdita e non è adatto a tutti gli investitori. PickMyTrade è una piattaforma di automazione indipendente di terze parti e non è affiliata, approvata né sponsorizzata da Tradovate, Inc. «Tradovate» e tutti i nomi, loghi e marchi correlati sono di proprietà dei rispettivi titolari. Le funzionalità e i passaggi della piattaforma cambiano nel tempo, quindi confermi sempre la procedura corrente nella piattaforma e nella documentazione ufficiali di Tradovate prima di agire." },
};
const data: GuideArticleData = resolveGuideContent(content, locale, related);

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: data.faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: `${SITE_URL}${withSlash(localizedPath(locale))}` },
    { "@type": "ListItem", position: 2, name: "How-To", item: `${SITE_URL}${withSlash(localizedPath(locale, "how-to"))}` },
    { "@type": "ListItem", position: 3, name: content.h1[locale], item: `${SITE_URL}${withSlash(localizedPath(locale, `how-to/${SLUG}`))}` },
  ],
};

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: content.h1[locale],
  description: content.dek[locale],
  image: `${SITE_URL}/assets/og-default.webp`,
  publisher: { "@type": "Organization", name: "PickMyTrade", logo: { "@type": "ImageObject", url: `${SITE_URL}/assets/logo.png` } },
  datePublished: "2026-07-08",
  dateModified: "2026-07-08",
  mainEntityOfPage: { "@type": "WebPage", "@id": `${SITE_URL}${withSlash(localizedPath(locale, `how-to/${SLUG}`))}` },
};
---

<BaseLayout
  locale={locale}
  title={`${content.h1[locale]} | PickMyTrade`}
  description={content.dek[locale]}
  ogType="article"
  ogImage="/assets/og-default.webp"
  ldJson={[breadcrumbSchema, faqSchema, articleSchema]}
>
  <GuideArticle locale={locale} data={data} sectionPath="how-to" />
</BaseLayout>
