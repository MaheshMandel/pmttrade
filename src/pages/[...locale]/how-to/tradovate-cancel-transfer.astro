---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "tradovate-cancel-transfer";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/how-to/${SLUG}`;

const META_TITLE = "Cancel a Pending Deposit or Withdrawal in Tradovate";
const META_DESCRIPTION =
  "How to cancel a pending Tradovate deposit or withdrawal before it settles, including the cutoff times and the exact team to contact.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Eine ausstehende Einzahlung oder Auszahlung in Tradovate stornieren", es: "Cancelar un depósito o retiro pendiente en Tradovate", fr: "Annuler un dépôt ou un retrait en attente dans Tradovate", it: "Annullare un deposito o un prelievo in sospeso in Tradovate" },
  dek: { en: "Hit the wrong button and fired off a withdrawal you didn't mean to? Tradovate doesn't put a big red Cancel button next to a pending transfer, so the play is to catch it early and get the right team to reverse it.", de: "Auf die falsche Schaltfläche geklickt und eine Auszahlung ausgelöst, die Sie nicht wollten? Tradovate setzt keine große rote Cancel-Schaltfläche neben eine ausstehende Überweisung. Der Weg ist daher, sie früh abzufangen und das richtige Team zur Rückgängigmachung zu bewegen.", es: "¿Pulsó el botón equivocado y lanzó un retiro que no quería? Tradovate no pone un gran botón rojo de Cancel junto a una transferencia pendiente, así que lo que hay que hacer es detectarlo pronto y lograr que el equipo adecuado lo revierta.", fr: "Vous avez cliqué sur le mauvais bouton et lancé un retrait que vous ne souhaitiez pas ? Tradovate ne place pas de gros bouton rouge Cancel à côté d’un transfert en attente ; il faut donc le repérer tôt et obtenir de la bonne équipe qu’elle l’annule.", it: "Ha premuto il pulsante sbagliato e avviato un prelievo che non voleva? Tradovate non mette un grande pulsante rosso Cancel accanto a un trasferimento in sospeso, quindi la strada è individuarlo presto e far sì che il team giusto lo annulli." },
  readTime: { en: "5 min read", de: "5 Min. Lesezeit", es: "Lectura de 5 min", fr: "Lecture : 5 min", it: "Lettura di 5 min" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "Hit the wrong button and fired off a withdrawal you didn't mean to? Or funded the wrong account and want that deposit pulled back before it clears? Tradovate doesn't put a big red Cancel button next to a pending transfer, so the play is to catch it early and get the right team to reverse it. Here's exactly how to stop a deposit or withdrawal that hasn't processed yet, plus what to do if you've already missed the window." },
    { type: "heading", text: "What Cancelling a Transfer Really Means in Tradovate" },
    { type: "paragraph", html: "A deposit or withdrawal request sits in a pending state for a short window before Tradovate's funds team pushes it through. During that window it can still be pulled back. Once the transfer settles, it's locked in, and the only way to undo it is to send the money the other way with a fresh transfer. There's no self-service cancel option inside the platform for a request that's already submitted, so cancelling really means reaching the team that moves the money before they process it. Speed is everything." },
    { type: "heading", text: "How to Cancel a Pending Deposit or Withdrawal: Step-by-Step" },
    {
      type: "steps",
      items: [
        { title: "Confirm the Request Is Still Pending", html: "First, make sure there's actually something to cancel. Log in to the Tradovate web app, open <strong class='text-white'>Application Settings</strong> from the top-right, and go to the <strong class='text-white'>Transfers &amp; Payments</strong> tab. Click <strong class='text-white'>Transfer History</strong> to see every deposit and withdrawal on the account with its current status. If your request still reads pending or requested (not completed or settled), you've got a shot at cancelling it. If it already shows completed, jump to the special cases below." },
        { title: "Check the Cutoff Clock", html: "Cancellations are time-sensitive, and the deadline depends on whether it's a deposit or a withdrawal. Tradovate's funds team works on Central Time, and a request that lands after the daily cutoff usually rolls to the next business day. Use the table below as a rough guide, and confirm the current cutoffs since Tradovate updates them. Miss the cutoff and the request may already be in processing, which usually means it can't be stopped." },
        { title: "Email the Funds Team to Cancel", html: "Send your cancellation request straight to <strong class='text-white'>funds@tradovate.com</strong>. Put the essentials in the email so nobody has to write back for details: your account name and number, the transfer type (deposit or withdrawal), the exact amount, and the date you submitted it. Ask them plainly to cancel the pending request. If you're going through live support instead, say clearly that you want to speak to an agent to cancel a pending transfer. The tighter and faster your request, the better your odds of catching it before it processes." },
        { title: "Confirm the Reversal", html: "Watch your inbox for confirmation, then head back to <strong class='text-white'>Application Settings › Transfers &amp; Payments › Transfer History</strong>. A cancelled request drops off the pending list or flips to a cancelled or returned status. If the money had already left or hit your account, you'll see a matching reversal entry instead. Give it a business day, and follow up with the funds team if the status hasn't moved." },
      ],
    },
    {
      type: "table",
      headers: ["Transfer Type", "Typical Same-Day Cancellation Cutoff (Central Time)", "Who Reverses It"],
      rows: [
        ["ACH deposit", "Around 1:00 PM CT", "Tradovate funds team"],
        ["ACH withdrawal", "Around 12:00 PM (noon) CT", "Tradovate Treasury team"],
        ["Wire deposit", "Before your bank releases the wire", "Your originating bank"],
      ],
    },
    { type: "heading", text: "Special Cases Worth Knowing" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Wire deposits:</strong> once your bank has sent the wire, Tradovate can't claw it back. Call your bank and ask them to recall it.",
        "<strong class='text-white'>Already processed:</strong> if the transfer has settled, cancelling isn't on the table. Just request a new transfer in the opposite direction to move the funds back.",
        "<strong class='text-white'>Prop firm or evaluation accounts:</strong> you don't fund or withdraw these yourself; your firm handles payouts and resets. Rules and timing vary by firm and account size, so check your firm's current rules and contact them directly.",
      ],
    },
    { type: "heading", text: "Automate Your Tradovate Orders With PickMyTrade" },
    { type: "paragraph", html: "Cancelling a transfer is a rare, manual chore. Your trade execution shouldn't be. PickMyTrade routes your TradingView alerts straight to Tradovate, so entries, exits, and bracket orders fire on their own while you stay focused on the strategy." },
  ], de: [
    { type: "paragraph",html: "Auf die falsche Schaltfläche geklickt und eine Auszahlung ausgelöst, die Sie nicht wollten? Oder das falsche Konto aufgeladen und möchten die Einzahlung zurückholen, bevor sie verbucht wird? Tradovate setzt keine große rote Cancel-Schaltfläche neben eine ausstehende Überweisung, der Weg ist daher, sie früh abzufangen und das richtige Team zur Rückgängigmachung zu bewegen. Hier steht genau, wie Sie eine noch nicht bearbeitete Einzahlung oder Auszahlung stoppen, und was zu tun ist, wenn Sie das Zeitfenster bereits verpasst haben." },
    { type: "heading",text: "Was das Stornieren einer Überweisung bei Tradovate wirklich bedeutet" },
    { type: "paragraph",html: "Eine Ein- oder Auszahlungsanfrage befindet sich kurze Zeit im Status „ausstehend“, bevor das Funds-Team von Tradovate sie durchführt. In diesem Zeitfenster kann sie noch zurückgezogen werden. Sobald die Überweisung verbucht ist, ist sie festgeschrieben, und die einzige Möglichkeit, sie rückgängig zu machen, besteht darin, das Geld mit einer neuen Überweisung in die andere Richtung zu senden. Für eine bereits eingereichte Anfrage gibt es in der Plattform keine Selbstbedienungsoption zum Stornieren, Stornieren bedeutet also, das Team zu erreichen, das das Geld bewegt, bevor es die Anfrage bearbeitet. Schnelligkeit ist alles." },
    { type: "heading",text: "Eine ausstehende Einzahlung oder Auszahlung stornieren: Schritt für Schritt" },
    {
      type: "steps",
      items: [
        { title: "Prüfen, ob die Anfrage noch aussteht", html: "Stellen Sie zuerst sicher, dass es überhaupt etwas zu stornieren gibt. Melden Sie sich in der Tradovate-Web-App an, öffnen Sie oben rechts <strong class='text-white'>Application Settings</strong> und gehen Sie zum Tab <strong class='text-white'>Transfers &amp; Payments</strong>. Klicken Sie auf <strong class='text-white'>Transfer History</strong>, um jede Einzahlung und Auszahlung des Kontos mit ihrem aktuellen Status zu sehen. Wenn Ihre Anfrage noch als ausstehend oder angefordert angezeigt wird (nicht abgeschlossen oder verbucht), haben Sie eine Chance, sie zu stornieren. Wenn sie bereits als abgeschlossen angezeigt wird, springen Sie zu den Sonderfällen unten." },
        { title: "Die Annahmeschlusszeit prüfen", html: "Stornierungen sind zeitkritisch, und die Frist hängt davon ab, ob es sich um eine Einzahlung oder eine Auszahlung handelt. Das Funds-Team von Tradovate arbeitet nach Central Time, und eine Anfrage, die nach dem täglichen Annahmeschluss eingeht, rutscht in der Regel auf den nächsten Geschäftstag. Nutzen Sie die Tabelle unten als grobe Orientierung und prüfen Sie die aktuellen Fristen, da Tradovate sie aktualisiert. Wenn Sie den Annahmeschluss verpassen, befindet sich die Anfrage möglicherweise bereits in Bearbeitung, was meist bedeutet, dass sie nicht mehr gestoppt werden kann." },
        { title: "Das Funds-Team per E-Mail um Stornierung bitten", html: "Senden Sie Ihre Stornierungsanfrage direkt an <strong class='text-white'>funds@tradovate.com</strong>. Geben Sie das Wesentliche in der E-Mail an, damit niemand nachfragen muss: Ihren Kontonamen und Ihre Kontonummer, die Art der Überweisung (Einzahlung oder Auszahlung), den genauen Betrag und das Datum, an dem Sie sie eingereicht haben. Bitten Sie klar darum, die ausstehende Anfrage zu stornieren. Wenn Sie stattdessen den Live-Support nutzen, sagen Sie deutlich, dass Sie mit einem Mitarbeiter sprechen möchten, um eine ausstehende Überweisung zu stornieren. Je knapper und schneller Ihre Anfrage, desto besser Ihre Chancen, sie vor der Bearbeitung abzufangen." },
        { title: "Die Rückabwicklung bestätigen", html: "Achten Sie auf die Bestätigung in Ihrem Posteingang und gehen Sie dann zurück zu <strong class='text-white'>Application Settings › Transfers &amp; Payments › Transfer History</strong>. Eine stornierte Anfrage verschwindet aus der Liste der ausstehenden oder wechselt auf den Status storniert oder zurückgebucht. Wenn das Geld bereits abgeflossen oder auf Ihrem Konto eingegangen war, sehen Sie stattdessen einen entsprechenden Rückbuchungseintrag. Geben Sie dem einen Geschäftstag, und haken Sie beim Funds-Team nach, wenn sich der Status nicht geändert hat." },
      ],
    },
    { type: "table", headers: ["Überweisungsart","Typischer Stornierungsschluss am selben Tag (Central Time)","Wer die Rückabwicklung durchführt"], rows: [
      ["ACH-Einzahlung","Etwa 1:00 PM CT","Funds-Team von Tradovate"],
      ["ACH-Auszahlung","Etwa 12:00 PM (mittags) CT","Treasury-Team von Tradovate"],
      ["Wire-Einzahlung","Bevor Ihre Bank die Überweisung freigibt","Ihre Absenderbank"],
    ] },
    { type: "heading",text: "Sonderfälle, die Sie kennen sollten" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Wire-Einzahlungen:</strong> Sobald Ihre Bank die Überweisung gesendet hat, kann Tradovate sie nicht zurückholen. Rufen Sie Ihre Bank an und bitten Sie sie, die Überweisung zurückzurufen.",
        "<strong class='text-white'>Bereits verarbeitet:</strong> Wenn die Überweisung verbucht ist, kommt eine Stornierung nicht mehr in Frage. Beantragen Sie einfach eine neue Überweisung in die entgegengesetzte Richtung, um die Mittel zurückzubewegen.",
        "<strong class='text-white'>Prop-Firm- oder Evaluierungskonten:</strong> Diese Konten laden oder entnehmen Sie nicht selbst; Ihre Firma übernimmt Auszahlungen und Resets. Regeln und Zeitpläne variieren je nach Firma und Kontogröße, prüfen Sie daher die aktuellen Regeln Ihrer Firma und kontaktieren Sie sie direkt.",
      ],
    },
    { type: "heading",text: "Tradovate-Orders mit PickMyTrade automatisieren" },
    { type: "paragraph",html: "Eine Überweisung zu stornieren ist eine seltene manuelle Aufgabe. Ihre Trade-Ausführung sollte es nicht sein. PickMyTrade leitet Ihre TradingView-Alarme direkt an Tradovate weiter, sodass Einstiege, Ausstiege und Bracket-Orders von selbst ausgelöst werden, während Sie sich auf die Strategie konzentrieren." },
  ], es: [
    { type: "paragraph",html: "¿Pulsó el botón equivocado y lanzó un retiro que no quería? ¿O fondeó la cuenta equivocada y quiere retirar ese depósito antes de que se acredite? Tradovate no pone un gran botón rojo de Cancel junto a una transferencia pendiente, así que lo que hay que hacer es detectarlo pronto y lograr que el equipo adecuado lo revierta. Aquí se explica exactamente cómo detener un depósito o retiro que aún no se ha procesado, y qué hacer si ya perdió la ventana." },
    { type: "heading",text: "Qué significa realmente cancelar una transferencia en Tradovate" },
    { type: "paragraph",html: "Una solicitud de depósito o retiro permanece en estado pendiente durante una breve ventana antes de que el equipo de fondos de Tradovate la tramite. Durante esa ventana todavía se puede retirar. Una vez que la transferencia se liquida, queda fijada, y la única forma de deshacerla es enviar el dinero en sentido contrario con una nueva transferencia. No existe una opción de cancelación de autoservicio dentro de la plataforma para una solicitud ya enviada, por lo que cancelar significa en realidad contactar con el equipo que mueve el dinero antes de que lo procese. La rapidez lo es todo." },
    { type: "heading",text: "Cómo cancelar un depósito o retiro pendiente: paso a paso" },
    {
      type: "steps",
      items: [
        { title: "Confirme que la solicitud sigue pendiente", html: "Primero, asegúrese de que realmente hay algo que cancelar. Inicie sesión en la aplicación web de Tradovate, abra <strong class='text-white'>Application Settings</strong> desde la parte superior derecha y vaya a la pestaña <strong class='text-white'>Transfers &amp; Payments</strong>. Haga clic en <strong class='text-white'>Transfer History</strong> para ver cada depósito y retiro de la cuenta con su estado actual. Si su solicitud aún figura como pendiente o solicitada (no completada ni liquidada), tiene posibilidades de cancelarla. Si ya aparece como completada, vaya a los casos especiales de más abajo." },
        { title: "Compruebe el reloj de cierre", html: "Las cancelaciones dependen del tiempo, y el plazo depende de si es un depósito o un retiro. El equipo de fondos de Tradovate trabaja en hora central, y una solicitud que llega después del cierre diario suele pasar al siguiente día hábil. Use la tabla de abajo como guía aproximada y confirme los cierres vigentes, ya que Tradovate los actualiza. Si pierde el cierre, es posible que la solicitud ya esté en proceso, lo que normalmente significa que no se puede detener." },
        { title: "Escriba al equipo de fondos para cancelar", html: "Envíe su solicitud de cancelación directamente a <strong class='text-white'>funds@tradovate.com</strong>. Incluya lo esencial en el correo para que nadie tenga que pedirle detalles: el nombre y número de su cuenta, el tipo de transferencia (depósito o retiro), el importe exacto y la fecha en que la envió. Pídales claramente que cancelen la solicitud pendiente. Si va por el soporte en vivo, diga con claridad que quiere hablar con un agente para cancelar una transferencia pendiente. Cuanto más concisa y rápida sea su solicitud, mejores serán sus opciones de detenerla antes de que se procese." },
        { title: "Confirme la reversión", html: "Esté atento a la confirmación en su bandeja de entrada y luego vuelva a <strong class='text-white'>Application Settings › Transfers &amp; Payments › Transfer History</strong>. Una solicitud cancelada desaparece de la lista de pendientes o cambia a estado cancelada o devuelta. Si el dinero ya había salido o llegado a su cuenta, verá en su lugar una anotación de reversión correspondiente. Dele un día hábil y haga seguimiento con el equipo de fondos si el estado no ha cambiado." },
      ],
    },
    { type: "table", headers: ["Tipo de transferencia","Cierre habitual de cancelación el mismo día (hora central)","Quién la revierte"], rows: [
      ["Depósito ACH","Alrededor de la 1:00 PM CT","Equipo de fondos de Tradovate"],
      ["Retiro ACH","Alrededor de las 12:00 PM (mediodía) CT","Equipo de Treasury de Tradovate"],
      ["Depósito por transferencia bancaria (wire)","Antes de que su banco libere la transferencia","Su banco emisor"],
    ] },
    { type: "heading",text: "Casos especiales que conviene conocer" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Depósitos por wire:</strong> una vez que su banco ha enviado la transferencia, Tradovate no puede recuperarla. Llame a su banco y pídales que la retiren.",
        "<strong class='text-white'>Ya procesado:</strong> si la transferencia se ha liquidado, cancelarla ya no es posible. Basta con solicitar una nueva transferencia en sentido contrario para devolver los fondos.",
        "<strong class='text-white'>Cuentas de prop firm o de evaluación:</strong> estas cuentas no las financia ni retira usted; su firma gestiona los pagos y los reinicios. Las reglas y los plazos varían según la firma y el tamaño de la cuenta, así que consulte las reglas vigentes de su firma y contáctela directamente.",
      ],
    },
    { type: "heading",text: "Automatice sus órdenes de Tradovate con PickMyTrade" },
    { type: "paragraph",html: "Cancelar una transferencia es una tarea manual poco frecuente. La ejecución de sus operaciones no debería serlo. PickMyTrade enruta sus alertas de TradingView directamente a Tradovate, de modo que las entradas, las salidas y las órdenes bracket se ejecutan solas mientras usted se concentra en la estrategia." },
  ], fr: [
    { type: "paragraph",html: "Vous avez cliqué sur le mauvais bouton et lancé un retrait que vous ne souhaitiez pas ? Ou alimenté le mauvais compte et voulez récupérer ce dépôt avant qu’il ne soit crédité ? Tradovate ne place pas de gros bouton rouge Cancel à côté d’un transfert en attente ; il faut donc le repérer tôt et obtenir de la bonne équipe qu’elle l’annule. Voici exactement comment arrêter un dépôt ou un retrait qui n’a pas encore été traité, et que faire si vous avez déjà manqué la fenêtre." },
    { type: "heading",text: "Ce que signifie réellement annuler un transfert dans Tradovate" },
    { type: "paragraph",html: "Une demande de dépôt ou de retrait reste en attente pendant une courte période avant que l’équipe des fonds de Tradovate ne la fasse passer. Durant cette fenêtre, elle peut encore être retirée. Une fois le transfert réglé, il est figé, et le seul moyen de l’annuler est d’envoyer l’argent dans l’autre sens avec un nouveau transfert. Il n’existe pas d’option d’annulation en libre-service dans la plateforme pour une demande déjà soumise ; annuler signifie donc joindre l’équipe qui déplace l’argent avant qu’elle ne le traite. La rapidité est essentielle." },
    { type: "heading",text: "Annuler un dépôt ou un retrait en attente : pas à pas" },
    {
      type: "steps",
      items: [
        { title: "Vérifier que la demande est toujours en attente", html: "Commencez par vous assurer qu’il y a bien quelque chose à annuler. Connectez-vous à l’application web Tradovate, ouvrez <strong class='text-white'>Application Settings</strong> en haut à droite et allez dans l’onglet <strong class='text-white'>Transfers &amp; Payments</strong>. Cliquez sur <strong class='text-white'>Transfer History</strong> pour voir chaque dépôt et retrait du compte avec son statut actuel. Si votre demande est toujours en attente ou demandée (et non terminée ou réglée), vous avez une chance de l’annuler. Si elle apparaît déjà comme terminée, passez aux cas particuliers ci-dessous." },
        { title: "Vérifier l’heure limite", html: "Les annulations sont sensibles au temps, et l’échéance dépend du type de transfert, dépôt ou retrait. L’équipe des fonds de Tradovate travaille en heure centrale, et une demande reçue après l’heure limite quotidienne est généralement reportée au jour ouvré suivant. Utilisez le tableau ci-dessous comme repère approximatif et vérifiez les heures limites actuelles, car Tradovate les met à jour. Si vous manquez l’heure limite, la demande est peut-être déjà en cours de traitement, ce qui signifie généralement qu’elle ne peut plus être arrêtée." },
        { title: "Écrire à l’équipe des fonds pour annuler", html: "Envoyez votre demande d’annulation directement à <strong class='text-white'>funds@tradovate.com</strong>. Indiquez l’essentiel dans l’e-mail pour que personne n’ait à vous demander de précisions : le nom et le numéro de votre compte, le type de transfert (dépôt ou retrait), le montant exact et la date de soumission. Demandez clairement l’annulation de la demande en attente. Si vous passez par le support en direct, dites explicitement que vous souhaitez parler à un agent pour annuler un transfert en attente. Plus votre demande est précise et rapide, meilleures sont vos chances de l’arrêter avant son traitement." },
        { title: "Confirmer l’annulation", html: "Surveillez votre boîte de réception pour la confirmation, puis retournez dans <strong class='text-white'>Application Settings › Transfers &amp; Payments › Transfer History</strong>. Une demande annulée disparaît de la liste des opérations en attente ou passe au statut annulé ou retourné. Si l’argent était déjà parti ou arrivé sur votre compte, vous verrez à la place une écriture d’annulation correspondante. Laissez un jour ouvré et relancez l’équipe des fonds si le statut n’a pas évolué." },
      ],
    },
    { type: "table", headers: ["Type de transfert","Heure limite d’annulation typique le jour même (heure centrale)","Qui l’annule"], rows: [
      ["Dépôt ACH","Vers 1:00 PM CT","Équipe des fonds de Tradovate"],
      ["Retrait ACH","Vers 12:00 PM (midi) CT","Équipe Treasury de Tradovate"],
      ["Dépôt par virement wire","Avant que votre banque n’émette le virement","Votre banque émettrice"],
    ] },
    { type: "heading",text: "Cas particuliers à connaître" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Dépôts par virement wire :</strong> une fois que votre banque a envoyé le virement, Tradovate ne peut pas le récupérer. Appelez votre banque et demandez-lui de le rappeler.",
        "<strong class='text-white'>Déjà traité :</strong> si le transfert est réglé, l’annulation n’est plus possible. Demandez simplement un nouveau transfert dans le sens inverse pour ramener les fonds.",
        "<strong class='text-white'>Comptes de prop firm ou d’évaluation :</strong> vous n’alimentez ni ne retirez ces comptes vous-même ; votre société gère les paiements et les réinitialisations. Les règles et les délais varient selon la société et la taille du compte ; vérifiez donc les règles actuelles de votre société et contactez-la directement.",
      ],
    },
    { type: "heading",text: "Automatiser vos ordres Tradovate avec PickMyTrade" },
    { type: "paragraph",html: "Annuler un transfert est une corvée manuelle rare. L’exécution de vos trades ne devrait pas l’être. PickMyTrade achemine vos alertes TradingView directement vers Tradovate, de sorte que les entrées, les sorties et les ordres bracket se déclenchent d’eux-mêmes pendant que vous restez concentré sur la stratégie." },
  ], it: [
    { type: "paragraph",html: "Ha premuto il pulsante sbagliato e avviato un prelievo che non voleva? Oppure ha finanziato il conto sbagliato e vuole ritirare quel deposito prima che venga accreditato? Tradovate non mette un grande pulsante rosso Cancel accanto a un trasferimento in sospeso, quindi la strada è individuarlo presto e far sì che il team giusto lo annulli. Ecco esattamente come fermare un deposito o un prelievo non ancora elaborato, e cosa fare se ha già perso la finestra utile." },
    { type: "heading",text: "Cosa significa davvero annullare un trasferimento in Tradovate" },
    { type: "paragraph",html: "Una richiesta di deposito o prelievo resta in stato di sospeso per una breve finestra prima che il team fondi di Tradovate la porti a termine. Durante quella finestra può ancora essere ritirata. Una volta che il trasferimento è regolato, è definitivo, e l’unico modo per annullarlo è inviare il denaro nella direzione opposta con un nuovo trasferimento. All’interno della piattaforma non esiste un’opzione di annullamento self-service per una richiesta già inviata, quindi annullare significa in realtà raggiungere il team che movimenta il denaro prima che lo elabori. La velocità è tutto." },
    { type: "heading",text: "Come annullare un deposito o un prelievo in sospeso: passo dopo passo" },
    {
      type: "steps",
      items: [
        { title: "Verifichi che la richiesta sia ancora in sospeso", html: "Per prima cosa, si assicuri che ci sia davvero qualcosa da annullare. Acceda all’app web di Tradovate, apra <strong class='text-white'>Application Settings</strong> in alto a destra e vada alla scheda <strong class='text-white'>Transfers &amp; Payments</strong>. Clicchi su <strong class='text-white'>Transfer History</strong> per vedere ogni deposito e prelievo del conto con il relativo stato attuale. Se la Sua richiesta risulta ancora in sospeso o richiesta (non completata o regolata), ha una possibilità di annullarla. Se risulta già completata, passi ai casi particolari qui sotto." },
        { title: "Controlli l’orario limite", html: "Gli annullamenti sono sensibili al tempo, e la scadenza dipende dal fatto che si tratti di un deposito o di un prelievo. Il team fondi di Tradovate lavora in ora centrale, e una richiesta che arriva dopo l’orario limite giornaliero di solito slitta al giorno lavorativo successivo. Usi la tabella qui sotto come guida approssimativa e verifichi gli orari limite attuali, perché Tradovate li aggiorna. Se perde l’orario limite, la richiesta potrebbe essere già in elaborazione, il che di solito significa che non può più essere fermata." },
        { title: "Scriva al team fondi per annullare", html: "Invii la Sua richiesta di annullamento direttamente a <strong class='text-white'>funds@tradovate.com</strong>. Inserisca nell’e-mail gli elementi essenziali, così nessuno dovrà chiederLe dettagli: il nome e il numero del Suo conto, il tipo di trasferimento (deposito o prelievo), l’importo esatto e la data in cui l’ha inviato. Chieda esplicitamente di annullare la richiesta in sospeso. Se passa invece dal supporto in tempo reale, dica chiaramente che desidera parlare con un operatore per annullare un trasferimento in sospeso. Più la richiesta è precisa e rapida, migliori sono le probabilità di fermarla prima dell’elaborazione." },
        { title: "Confermi l’annullamento", html: "Controlli la posta in arrivo per la conferma, poi torni in <strong class='text-white'>Application Settings › Transfers &amp; Payments › Transfer History</strong>. Una richiesta annullata scompare dall’elenco dei sospesi o passa allo stato annullata o restituita. Se il denaro era già uscito o arrivato sul Suo conto, vedrà invece una registrazione di storno corrispondente. Attenda un giorno lavorativo e solleciti il team fondi se lo stato non è cambiato." },
      ],
    },
    { type: "table", headers: ["Tipo di trasferimento","Orario limite tipico di annullamento nello stesso giorno (ora centrale)","Chi lo annulla"], rows: [
      ["Deposito ACH","Circa 1:00 PM CT","Team fondi di Tradovate"],
      ["Prelievo ACH","Circa 12:00 PM (mezzogiorno) CT","Team Treasury di Tradovate"],
      ["Deposito tramite bonifico wire","Prima che la Sua banca rilasci il bonifico","La Sua banca d’origine"],
    ] },
    { type: "heading",text: "Casi particolari da conoscere" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Depositi tramite wire:</strong> una volta che la Sua banca ha inviato il bonifico, Tradovate non può recuperarlo. Chiami la Sua banca e chieda di richiamarlo.",
        "<strong class='text-white'>Già elaborato:</strong> se il trasferimento è stato regolato, l’annullamento non è più possibile. Richieda semplicemente un nuovo trasferimento nella direzione opposta per riportare indietro i fondi.",
        "<strong class='text-white'>Conti prop firm o di valutazione:</strong> questi conti non li finanzia né preleva Lei; la Sua società gestisce i pagamenti e i reset. Regole e tempistiche variano in base alla società e alla dimensione del conto, quindi verifichi le regole attuali della Sua società e La contatti direttamente.",
      ],
    },
    { type: "heading",text: "Automatizzi i Suoi ordini Tradovate con PickMyTrade" },
    { type: "paragraph",html: "Annullare un trasferimento è un compito manuale raro. L’esecuzione dei Suoi trade non dovrebbe esserlo. PickMyTrade instrada i Suoi alert di TradingView direttamente a Tradovate, così ingressi, uscite e ordini bracket scattano da soli mentre Lei resta concentrato sulla strategia." },
  ] },
  ctaHeading: { en: "Stay Focused on the Strategy", de: "Bleiben Sie bei Ihrer Strategie", es: "Concéntrese en la estrategia", fr: "Restez concentré sur la stratégie", it: "Resti concentrato sulla strategia" },
  ctaText: { en: "Cancelling a transfer is a rare, manual chore. Your trade execution shouldn't be. Let PickMyTrade route your TradingView alerts straight to Tradovate so entries, exits, and bracket orders fire on their own.", de: "Eine Überweisung zu stornieren ist eine seltene manuelle Aufgabe. Ihre Trade-Ausführung sollte es nicht sein. Lassen Sie PickMyTrade Ihre TradingView-Alarme direkt an Tradovate weiterleiten, sodass Einstiege, Ausstiege und Bracket-Orders von selbst ausgelöst werden.", es: "Cancelar una transferencia es una tarea manual poco frecuente. La ejecución de sus operaciones no debería serlo. Deje que PickMyTrade enrute sus alertas de TradingView directamente a Tradovate para que las entradas, las salidas y las órdenes bracket se ejecuten solas.", fr: "Annuler un transfert est une corvée manuelle rare. L’exécution de vos trades ne devrait pas l’être. Laissez PickMyTrade acheminer vos alertes TradingView directement vers Tradovate afin que les entrées, les sorties et les ordres bracket se déclenchent d’eux-mêmes.", it: "Annullare un trasferimento è un compito manuale raro. L’esecuzione dei Suoi trade non dovrebbe esserlo. Lasci che PickMyTrade instradi i Suoi alert di TradingView direttamente a Tradovate, così ingressi, uscite e ordini bracket scattano da soli." },
  ctaButtonText: { en: "Start Your Free 7-Day Trial", de: "Starten Sie Ihre kostenlose 7-Tage-Testphase", es: "Comience su prueba gratuita de 7 días", fr: "Commencez votre essai gratuit de 7 jours", it: "Inizi la prova gratuita di 7 giorni" },
  ctaUrl: "https://app.pickmytrade.trade/?register=true&utm_source=content&utm_medium=how-to",
  faqHeading: { en: "Frequently Asked Questions", de: "Häufig gestellte Fragen", es: "Preguntas frecuentes", fr: "Questions fréquentes", it: "Domande frequenti" },
  faqs: { en: [
    { q: "Can I cancel a Tradovate deposit myself inside the app?", a: "No. There's no self-service cancel button for a request you've already submitted. Email funds@tradovate.com before the daily cutoff and ask them to reverse the pending deposit while it's still processing." },
    { q: "How long do I have to cancel a withdrawal?", a: "Only until it's processed. Withdrawal cancellation requests generally need to reach Tradovate's Treasury team before the midday Central cutoff; anything later may not be handled until the next business day. Confirm the current cutoff before you count on it." },
    { q: "The transfer already completed. Can I still get my money back?", a: "Not by cancelling. Once it settles, you'd request a new transfer in the opposite direction, a withdrawal to undo a deposit, or a deposit to undo a withdrawal." },
