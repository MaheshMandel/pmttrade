---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "tradovate-dom-and-chart";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/how-to/${SLUG}`;

const META_TITLE = "Use the DOM & Chart Together in Tradovate";
const META_DESCRIPTION =
  "Set up the depth-of-market ladder and price chart side by side, link them to one contract, and read order flow while placing precise trades.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "DOM und Chart in Tradovate gemeinsam nutzen", es: "Use el DOM y el gráfico juntos en Tradovate", fr: "Utiliser le DOM et le graphique ensemble dans Tradovate", it: "Usare DOM e grafico insieme in Tradovate" },
  dek: { en: "A chart tells you where price has been and where it's likely headed. The DOM tells you what's happening right now. Run them side by side and you get both halves of the picture, here's how to set them up, link them, and save the layout.", de: "Ein Chart zeigt, wo der Kurs war und wohin er voraussichtlich läuft. Die DOM zeigt, was gerade jetzt passiert. Nutzen Sie beide nebeneinander, erhalten Sie beide Hälften des Bildes, so richten Sie sie ein, verknüpfen sie und speichern das Layout.", es: "Un gráfico le dice dónde ha estado el precio y hacia dónde es probable que vaya. El DOM le dice lo que está pasando ahora mismo. Ejecútelos lado a lado y obtendrá las dos mitades del panorama, así se configuran, se vinculan y se guarda el diseño.", fr: "Un graphique vous montre où le prix est passé et où il se dirige probablement. Le DOM vous montre ce qui se passe maintenant. Utilisez-les côte à côte et vous obtenez les deux moitiés du tableau : voici comment les configurer, les lier et enregistrer la disposition.", it: "Un grafico le dice dove è stato il prezzo e dove è probabile che vada. Il DOM le dice cosa sta succedendo adesso. Li usi affiancati e avrà entrambe le metà del quadro: ecco come configurarli, collegarli e salvare il layout." },
  readTime: { en: "6 min read", de: "6 Min. Lesezeit", es: "Lectura de 6 min", fr: "Lecture : 6 min", it: "Lettura di 6 min" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "A chart tells you where price has been and where it's likely headed. The DOM tells you what's happening right now, the resting bids and offers, and the exact tick your order will land on. Run them side by side and you get both halves of the picture: read the setup on the chart, then click the fill on the ladder." },
    { type: "paragraph", html: "Tradovate keeps the chart and the DOM as separate modules, so there's a little setup to get them working as a pair. Here's how to arrange them, keep them on the same contract, and save the layout so it's ready every morning." },
    { type: "heading", text: "Why Pair the DOM and the Chart?" },
    { type: "paragraph", html: "Each panel is good at a different job. The chart is where you plan; the ladder is where you pull the trigger. Splitting the work like that keeps you from squinting at candles to guess a price when you could just click it." },
    { type: "table", headers: ["Panel", "Best for"], rows: [
      ["Chart", "Trend, support and resistance, indicators, and timing your entry"],
      ["DOM (SuperDOM)", "Live bid/ask depth, exact-tick limit and stop orders, and fast exits"],
    ] },
    { type: "heading", text: "Set Up the DOM and Chart Together: Step by Step" },
    {
      type: "steps",
      items: [
        { title: "Open a Chart and a DOM", html: "Start a fresh workspace and add both modules, a <strong class='text-white'>Chart</strong> and a <strong class='text-white'>DOM</strong>, so they're open at the same time. On the web and desktop apps you add a module from the top-left <strong class='text-white'>New</strong> (<strong class='text-white'>+</strong>) control and drop it into the window. If the ladder is new to you, the <a href='https://pickmytrade.trade/how-to/tradovate-superdom-basics/'>SuperDOM basics guide</a> covers how orders sit on it." },
        { title: "Arrange Them Side by Side", html: "Grab a module by its top bar and drop it next to the other. Most traders put the chart on the left (or give it the larger half) and keep the DOM narrow on the right. Drag the border between the two panels to size each one the way you like." },
        { title: "Put Both on the Same Contract", html: "Click the symbol name at the top of each module and type the contract you want, say, the front-month E-mini S&amp;P 500. Set the chart and the DOM to the <em>exact</em> same contract and month. A mismatched month is the classic slip-up: your chart reads one instrument while your orders route to another." },
        { title: "Link Them With a Color", html: "Right next to the symbol name there's a small colored dot. Click it, pick a color, blue, for example, then set the DOM's dot to that same blue. Matching colors put the modules in one linked group; <strong class='text-white'>gray</strong> means linking is switched off. Tradovate gives you up to six colors, so you can run more than one linked set on a busy layout. One thing to know: symbol changes flow across linked modules most reliably when a linked Market Analyzer drives them. If you switch the contract in one panel and the other doesn't follow, just set it by hand, and confirm the current behavior in your own platform, since Tradovate tweaks this from time to time." },
        { title: "Read on the Chart, Execute on the DOM", html: "This is the whole point of the pairing. Mark your levels on the chart, the trendline, the indicator cross, wherever you want in. When price comes to it, drop your order on the DOM at the precise tick by left- or right-clicking the price ladder. You can see the size stacked at each level, so you know whether there's real depth where you're trying to get filled. Prefer to work off the chart itself? Turn on <a href='https://pickmytrade.trade/how-to/tradovate-chart-trading/'>chart trading</a> and place and drag orders right on the price axis." },
        { title: "Save the Workspace", html: "Once it's laid out the way you like, click the <strong class='text-white'>Tradovate logo</strong> at the top-left, open <strong class='text-white'>Workspaces</strong>, and hit <strong class='text-white'>Save</strong>. Your window positions, DOM settings, and chart layout all come back the next time you load it, no rebuilding the setup every session." },
      ],
    },
    { type: "heading", text: "One Limitation Worth Knowing" },
    { type: "paragraph", html: "Tradovate doesn't dock the ladder onto the chart's price axis the way a few other platforms do. The chart and the DOM stay as separate panels, side by side with a color link is as tight as the pairing gets. For most traders that's plenty: you still plan on one and execute on the other without hunting between windows. If your charts aren't dialed in yet, run through the <a href='https://pickmytrade.trade/how-to/tradovate-charting-basics/'>charting basics</a> first." },
    { type: "heading", text: "Automate the Execution with PickMyTrade" },
    { type: "paragraph", html: "Reading the chart and clicking the ladder is great when you're at the desk. When you're not, <strong class='text-white'>PickMyTrade turns your TradingView alerts into live Tradovate orders automatically</strong>, so the trade fires the moment your setup triggers, no scrambling to the DOM at 3 a.m. Use the pairing to build and test your read, then let the automation handle the clicks." },
  ], de: [
    { type: "paragraph",html: "Ein Chart zeigt, wo der Kurs war und wohin er voraussichtlich läuft. Die DOM zeigt, was gerade jetzt passiert, die ruhenden Gebote und Angebote und den genauen Tick, auf dem Ihre Order landet. Nutzen Sie beide nebeneinander, erhalten Sie beide Hälften des Bildes: das Setup im Chart lesen und den Fill dann auf der Preisleiter anklicken." },
    { type: "paragraph",html: "Tradovate führt Chart und DOM als getrennte Module, daher ist ein wenig Einrichtung nötig, damit sie als Paar funktionieren. So ordnen Sie sie an, halten sie auf demselben Kontrakt und speichern das Layout, damit es jeden Morgen bereitsteht." },
    { type: "heading",text: "Warum DOM und Chart kombinieren?" },
    { type: "paragraph",html: "Jedes Fenster ist für eine andere Aufgabe gut. Im Chart planen Sie; auf der Preisleiter drücken Sie ab. Diese Aufteilung erspart Ihnen, auf Kerzen zu starren, um einen Preis zu schätzen, den Sie einfach anklicken könnten." },
    { type: "table", headers: ["Fenster","Am besten geeignet für"], rows: [
      ["Chart","Trend, Unterstützung und Widerstand, Indikatoren und das Timing Ihres Einstiegs"],
      ["DOM (SuperDOM)","Live-Bid/Ask-Tiefe, Limit- und Stop-Orders auf den exakten Tick und schnelle Ausstiege"],
    ] },
    { type: "heading",text: "DOM und Chart gemeinsam einrichten: Schritt für Schritt" },
    {
      type: "steps",
      items: [
        { title: "Einen Chart und eine DOM öffnen", html: "Beginnen Sie mit einem neuen Workspace und fügen Sie beide Module hinzu, einen <strong class='text-white'>Chart</strong> und eine <strong class='text-white'>DOM</strong>, sodass beide gleichzeitig geöffnet sind. In der Web- und der Desktop-App fügen Sie ein Modul über das <strong class='text-white'>New</strong>-Steuerelement (<strong class='text-white'>+</strong>) oben links hinzu und legen es im Fenster ab. Wenn Ihnen die Preisleiter neu ist, erklärt die <a href='https://pickmytrade.trade/how-to/tradovate-superdom-basics/'>Anleitung zu den SuperDOM-Grundlagen</a>, wie Orders darauf liegen." },
        { title: "Nebeneinander anordnen", html: "Greifen Sie ein Modul an der oberen Leiste und legen Sie es neben dem anderen ab. Die meisten Trader platzieren den Chart links (oder geben ihm die größere Hälfte) und halten die DOM schmal auf der rechten Seite. Ziehen Sie den Rand zwischen den beiden Fenstern, um jedes nach Ihren Wünschen zu dimensionieren." },
        { title: "Beide auf denselben Kontrakt setzen", html: "Klicken Sie oben in jedem Modul auf den Symbolnamen und geben Sie den gewünschten Kontrakt ein, etwa den Frontmonat des E-mini S&amp;P 500. Stellen Sie Chart und DOM auf <em>exakt</em> denselben Kontrakt und Monat ein. Ein abweichender Monat ist der klassische Fehler: Ihr Chart zeigt ein Instrument, während Ihre Orders an ein anderes gehen." },
        { title: "Mit einer Farbe verknüpfen", html: "Direkt neben dem Symbolnamen befindet sich ein kleiner farbiger Punkt. Klicken Sie darauf, wählen Sie eine Farbe, etwa Blau, und setzen Sie dann den Punkt der DOM auf dasselbe Blau. Gleiche Farben fassen die Module in einer verknüpften Gruppe zusammen; <strong class='text-white'>Grau</strong> bedeutet, dass die Verknüpfung ausgeschaltet ist. Tradovate bietet bis zu sechs Farben, sodass Sie in einem vollen Layout mehr als eine verknüpfte Gruppe betreiben können. Eines sollten Sie wissen: Symbolwechsel werden am zuverlässigsten über verknüpfte Module übertragen, wenn ein verknüpfter Market Analyzer sie steuert. Wechseln Sie den Kontrakt in einem Fenster und das andere folgt nicht, stellen Sie ihn einfach von Hand ein, und bestätigen Sie das aktuelle Verhalten in Ihrer eigenen Plattform, da Tradovate dies von Zeit zu Zeit anpasst." },
        { title: "Im Chart lesen, auf der DOM ausführen", html: "Das ist der ganze Sinn der Kombination. Markieren Sie Ihre Niveaus im Chart, die Trendlinie, den Indikator-Cross, wo immer Sie einsteigen möchten. Kommt der Kurs dorthin, setzen Sie Ihre Order auf der DOM exakt auf den Tick, indem Sie mit der linken oder rechten Maustaste auf die Preisleiter klicken. Sie sehen die Größe, die sich auf jedem Niveau stapelt, und wissen damit, ob dort, wo Sie gefüllt werden möchten, echte Tiefe vorhanden ist. Lieber direkt im Chart arbeiten? Aktivieren Sie das <a href='https://pickmytrade.trade/how-to/tradovate-chart-trading/'>Chart-Trading</a> und platzieren und verschieben Sie Orders direkt auf der Preisachse." },
        { title: "Den Workspace speichern", html: "Sobald das Layout Ihren Wünschen entspricht, klicken Sie oben links auf das <strong class='text-white'>Tradovate-Logo</strong>, öffnen Sie <strong class='text-white'>Workspaces</strong> und klicken Sie auf <strong class='text-white'>Save</strong>. Ihre Fensterpositionen, DOM-Einstellungen und das Chart-Layout kehren beim nächsten Laden zurück, Sie müssen das Setup nicht in jeder Sitzung neu aufbauen." },
      ],
    },
    { type: "heading",text: "Eine Einschränkung, die Sie kennen sollten" },
    { type: "paragraph",html: "Tradovate dockt die Preisleiter nicht an die Preisachse des Charts an, wie es einige andere Plattformen tun. Chart und DOM bleiben getrennte Fenster, nebeneinander und per Farbe verknüpft ist die engste Kopplung, die möglich ist. Für die meisten Trader reicht das völlig: Sie planen weiterhin im einen und führen im anderen aus, ohne zwischen Fenstern suchen zu müssen. Sind Ihre Charts noch nicht eingerichtet, gehen Sie zuerst die <a href='https://pickmytrade.trade/how-to/tradovate-charting-basics/'>Charting-Grundlagen</a> durch." },
    { type: "heading",text: "Die Ausführung mit PickMyTrade automatisieren" },
    { type: "paragraph",html: "Den Chart zu lesen und die Preisleiter anzuklicken ist großartig, wenn Sie am Schreibtisch sitzen. Wenn nicht, <strong class='text-white'>macht PickMyTrade Ihre TradingView-Alerts automatisch zu echten Tradovate-Orders</strong>, sodass der Trade in dem Moment ausgelöst wird, in dem Ihr Setup eintritt, ohne dass Sie um 3 Uhr nachts zur DOM hasten müssen. Nutzen Sie die Kombination, um Ihre Einschätzung aufzubauen und zu testen, und überlassen Sie die Klicks dann der Automatisierung." },
  ], es: [
    { type: "paragraph",html: "Un gráfico le dice dónde ha estado el precio y hacia dónde es probable que vaya. El DOM le dice lo que está pasando ahora mismo, las ofertas y demandas en reposo y el tick exacto en el que caerá su orden. Ejecútelos lado a lado y obtendrá las dos mitades del panorama: lea la configuración en el gráfico y luego haga clic en la ejecución en la escalera." },
    { type: "paragraph",html: "Tradovate mantiene el gráfico y el DOM como módulos separados, así que hace falta un poco de configuración para que funcionen como pareja. Así se disponen, se mantienen en el mismo contrato y se guarda el diseño para que esté listo cada mañana." },
    { type: "heading",text: "¿Por qué combinar el DOM y el gráfico?" },
    { type: "paragraph",html: "Cada panel es bueno para una tarea distinta. El gráfico es donde planifica; la escalera es donde aprieta el gatillo. Repartir el trabajo así evita que entrecierre los ojos mirando velas para adivinar un precio que podría simplemente pulsar." },
    { type: "table", headers: ["Panel","Ideal para"], rows: [
      ["Gráfico","Tendencia, soporte y resistencia, indicadores y el momento de su entrada"],
      ["DOM (SuperDOM)","Profundidad de oferta y demanda en vivo, órdenes límite y stop en el tick exacto y salidas rápidas"],
    ] },
    { type: "heading",text: "Configure el DOM y el gráfico juntos: paso a paso" },
    {
      type: "steps",
      items: [
        { title: "Abra un gráfico y un DOM", html: "Empiece con un espacio de trabajo nuevo y añada ambos módulos, un <strong class='text-white'>Chart</strong> y un <strong class='text-white'>DOM</strong>, de modo que estén abiertos a la vez. En las aplicaciones web y de escritorio, añade un módulo desde el control <strong class='text-white'>New</strong> (<strong class='text-white'>+</strong>) de la parte superior izquierda y lo suelta en la ventana. Si la escalera le resulta nueva, la <a href='https://pickmytrade.trade/how-to/tradovate-superdom-basics/'>guía de conceptos básicos del SuperDOM</a> explica cómo se colocan las órdenes en ella." },
        { title: "Colóquelos lado a lado", html: "Agarre un módulo por su barra superior y suéltelo junto al otro. La mayoría de los traders ponen el gráfico a la izquierda (o le dan la mitad más grande) y mantienen el DOM estrecho a la derecha. Arrastre el borde entre los dos paneles para dimensionar cada uno a su gusto." },
        { title: "Ponga ambos en el mismo contrato", html: "Haga clic en el nombre del símbolo en la parte superior de cada módulo y escriba el contrato que desea, por ejemplo, el mes frontal del E-mini S&amp;P 500. Configure el gráfico y el DOM con <em>exactamente</em> el mismo contrato y mes. Un mes distinto es el error clásico: su gráfico lee un instrumento mientras sus órdenes se enrutan a otro." },
        { title: "Vincúlelos con un color", html: "Justo al lado del nombre del símbolo hay un pequeño punto de color. Haga clic en él, elija un color, azul, por ejemplo, y luego ponga el punto del DOM en ese mismo azul. Los colores iguales sitúan los módulos en un grupo vinculado; el <strong class='text-white'>gris</strong> significa que el enlace está desactivado. Tradovate ofrece hasta seis colores, por lo que puede manejar más de un grupo vinculado en un diseño cargado. Algo que conviene saber: los cambios de símbolo fluyen entre módulos vinculados de forma más fiable cuando los controla un Market Analyzer vinculado. Si cambia el contrato en un panel y el otro no lo sigue, simplemente configúrelo a mano, y confirme el comportamiento actual en su propia plataforma, ya que Tradovate lo ajusta de vez en cuando." },
        { title: "Lea en el gráfico, ejecute en el DOM", html: "Este es todo el sentido de la combinación. Marque sus niveles en el gráfico, la línea de tendencia, el cruce del indicador, donde quiera entrar. Cuando el precio llegue, coloque su orden en el DOM en el tick preciso haciendo clic con el botón izquierdo o derecho en la escalera de precios. Ve el tamaño apilado en cada nivel, así que sabe si hay profundidad real donde intenta que se ejecute su orden. ¿Prefiere trabajar directamente desde el gráfico? Active el <a href='https://pickmytrade.trade/how-to/tradovate-chart-trading/'>trading desde el gráfico</a> y coloque y arrastre órdenes directamente sobre el eje de precios." },
        { title: "Guarde el espacio de trabajo", html: "Cuando lo tenga dispuesto a su gusto, haga clic en el <strong class='text-white'>logotipo de Tradovate</strong> de la parte superior izquierda, abra <strong class='text-white'>Workspaces</strong> y pulse <strong class='text-white'>Save</strong>. Las posiciones de sus ventanas, la configuración del DOM y el diseño del gráfico vuelven la próxima vez que lo cargue, sin tener que reconstruir la configuración en cada sesión." },
      ],
    },
    { type: "heading",text: "Una limitación que conviene conocer" },
    { type: "paragraph",html: "Tradovate no acopla la escalera al eje de precios del gráfico como hacen algunas otras plataformas. El gráfico y el DOM siguen siendo paneles separados, lado a lado y vinculados por color es lo más estrecho que llega la combinación. Para la mayoría de los traders es más que suficiente: sigue planificando en uno y ejecutando en el otro sin tener que buscar entre ventanas. Si sus gráficos aún no están a punto, repase primero los <a href='https://pickmytrade.trade/how-to/tradovate-charting-basics/'>conceptos básicos de gráficos</a>." },
    { type: "heading",text: "Automatice la ejecución con PickMyTrade" },
    { type: "paragraph",html: "Leer el gráfico y hacer clic en la escalera es estupendo cuando está en su escritorio. Cuando no lo está, <strong class='text-white'>PickMyTrade convierte sus alertas de TradingView en órdenes reales de Tradovate automáticamente</strong>, de modo que la operación se dispara en el momento en que se activa su configuración, sin correr al DOM a las 3 de la madrugada. Use la combinación para construir y probar su lectura y deje después que la automatización se encargue de los clics." },
  ], fr: [
    { type: "paragraph",html: "Un graphique vous montre où le prix est passé et où il se dirige probablement. Le DOM vous montre ce qui se passe maintenant, les offres et demandes en attente et le tick exact sur lequel votre ordre atterrira. Utilisez-les côte à côte et vous obtenez les deux moitiés du tableau : lisez la configuration sur le graphique, puis cliquez sur l'exécution dans l'échelle." },
    { type: "paragraph",html: "Tradovate conserve le graphique et le DOM comme modules distincts ; il faut donc un peu de configuration pour qu'ils fonctionnent en tandem. Voici comment les disposer, les maintenir sur le même contrat et enregistrer la disposition pour qu'elle soit prête chaque matin." },
    { type: "heading",text: "Pourquoi associer le DOM et le graphique ?" },
    { type: "paragraph",html: "Chaque panneau excelle dans une tâche différente. Le graphique sert à planifier ; l'échelle sert à passer à l'acte. Répartir ainsi le travail vous évite de plisser les yeux sur les bougies pour deviner un prix que vous pourriez simplement cliquer." },
    { type: "table", headers: ["Panneau","Idéal pour"], rows: [
      ["Graphique","Tendance, supports et résistances, indicateurs et timing de votre entrée"],
      ["DOM (SuperDOM)","Profondeur bid/ask en direct, ordres à cours limité et stop au tick exact, et sorties rapides"],
    ] },
    { type: "heading",text: "Configurer le DOM et le graphique ensemble : pas à pas" },
    {
      type: "steps",
      items: [
        { title: "Ouvrir un graphique et un DOM", html: "Commencez avec un nouvel espace de travail et ajoutez les deux modules, un <strong class='text-white'>Chart</strong> et un <strong class='text-white'>DOM</strong>, afin qu'ils soient ouverts en même temps. Dans les applications web et de bureau, vous ajoutez un module depuis le contrôle <strong class='text-white'>New</strong> (<strong class='text-white'>+</strong>) en haut à gauche et le déposez dans la fenêtre. Si l'échelle est nouvelle pour vous, le <a href='https://pickmytrade.trade/how-to/tradovate-superdom-basics/'>guide des bases du SuperDOM</a> explique comment les ordres s'y positionnent." },
        { title: "Les disposer côte à côte", html: "Saisissez un module par sa barre supérieure et déposez-le à côté de l'autre. La plupart des traders placent le graphique à gauche (ou lui donnent la plus grande moitié) et gardent le DOM étroit à droite. Faites glisser la bordure entre les deux panneaux pour dimensionner chacun à votre convenance." },
        { title: "Les mettre sur le même contrat", html: "Cliquez sur le nom du symbole en haut de chaque module et saisissez le contrat souhaité, par exemple l'échéance rapprochée de l'E-mini S&amp;P 500. Réglez le graphique et le DOM sur <em>exactement</em> le même contrat et la même échéance. Une échéance différente est l'erreur classique : votre graphique lit un instrument tandis que vos ordres sont acheminés vers un autre." },
        { title: "Les lier avec une couleur", html: "Juste à côté du nom du symbole se trouve une petite pastille de couleur. Cliquez dessus, choisissez une couleur, le bleu par exemple, puis réglez la pastille du DOM sur ce même bleu. Des couleurs identiques placent les modules dans un même groupe lié ; le <strong class='text-white'>gris</strong> signifie que la liaison est désactivée. Tradovate propose jusqu'à six couleurs, ce qui permet de gérer plusieurs groupes liés sur une disposition chargée. À savoir : les changements de symbole se propagent le plus sûrement entre modules liés lorsqu'un Market Analyzer lié les pilote. Si vous changez de contrat dans un panneau et que l'autre ne suit pas, réglez-le simplement à la main, et vérifiez le comportement actuel dans votre propre plateforme, car Tradovate l'ajuste de temps en temps." },
        { title: "Lire sur le graphique, exécuter sur le DOM", html: "C'est tout l'intérêt de l'association. Marquez vos niveaux sur le graphique, la ligne de tendance, le croisement d'indicateur, là où vous voulez entrer. Quand le prix y arrive, placez votre ordre sur le DOM au tick précis en faisant un clic gauche ou droit sur l'échelle des prix. Vous voyez la taille empilée à chaque niveau, donc vous savez s'il y a une vraie profondeur là où vous cherchez à être exécuté. Vous préférez travailler directement depuis le graphique ? Activez le <a href='https://pickmytrade.trade/how-to/tradovate-chart-trading/'>trading depuis le graphique</a> et placez et déplacez les ordres directement sur l'axe des prix." },
        { title: "Enregistrer l'espace de travail", html: "Une fois la disposition à votre goût, cliquez sur le <strong class='text-white'>logo Tradovate</strong> en haut à gauche, ouvrez <strong class='text-white'>Workspaces</strong> et appuyez sur <strong class='text-white'>Save</strong>. La position de vos fenêtres, les réglages du DOM et la disposition du graphique reviennent au prochain chargement, sans reconstruire la configuration à chaque session." },
      ],
    },
    { type: "heading",text: "Une limite à connaître" },
    { type: "paragraph",html: "Tradovate n'ancre pas l'échelle sur l'axe des prix du graphique comme le font quelques autres plateformes. Le graphique et le DOM restent des panneaux distincts, côte à côte et liés par la couleur, c'est le couplage le plus serré possible. Pour la plupart des traders, c'est largement suffisant : vous planifiez toujours dans l'un et exécutez dans l'autre sans chercher d'une fenêtre à l'autre. Si vos graphiques ne sont pas encore au point, parcourez d'abord les <a href='https://pickmytrade.trade/how-to/tradovate-charting-basics/'>bases des graphiques</a>." },
    { type: "heading",text: "Automatisez l'exécution avec PickMyTrade" },
    { type: "paragraph",html: "Lire le graphique et cliquer sur l'échelle, c'est très bien quand vous êtes à votre bureau. Quand vous n'y êtes pas, <strong class='text-white'>PickMyTrade transforme automatiquement vos alertes TradingView en ordres Tradovate réels</strong>, de sorte que le trade se déclenche à l'instant où votre configuration se réalise, sans courir vers le DOM à 3 h du matin. Utilisez l'association pour construire et tester votre lecture, puis laissez l'automatisation se charger des clics." },
  ], it: [
    { type: "paragraph",html: "Un grafico le dice dove è stato il prezzo e dove è probabile che vada. Il DOM le dice cosa sta succedendo adesso, le proposte in denaro e in lettera in attesa e il tick esatto su cui finirà il suo ordine. Li usi affiancati e avrà entrambe le metà del quadro: legga il setup sul grafico, poi faccia clic sull'esecuzione sulla scala." },
    { type: "paragraph",html: "Tradovate mantiene grafico e DOM come moduli separati, quindi serve un po' di configurazione perché funzionino in coppia. Ecco come disporli, tenerli sullo stesso contratto e salvare il layout in modo che sia pronto ogni mattina." },
    { type: "heading",text: "Perché abbinare DOM e grafico?" },
    { type: "paragraph",html: "Ogni pannello è bravo in un compito diverso. Il grafico è dove pianifica; la scala è dove preme il grilletto. Dividere così il lavoro evita di strizzare gli occhi sulle candele per indovinare un prezzo che potrebbe semplicemente cliccare." },
    { type: "table", headers: ["Pannello","Ideale per"], rows: [
      ["Grafico","Trend, supporti e resistenze, indicatori e tempistica del suo ingresso"],
      ["DOM (SuperDOM)","Profondità bid/ask in tempo reale, ordini limite e stop sul tick esatto e uscite rapide"],
    ] },
    { type: "heading",text: "Configurare DOM e grafico insieme: passo dopo passo" },
    {
      type: "steps",
      items: [
        { title: "Aprire un grafico e un DOM", html: "Inizi con un'area di lavoro nuova e aggiunga entrambi i moduli, un <strong class='text-white'>Chart</strong> e un <strong class='text-white'>DOM</strong>, in modo che siano aperti contemporaneamente. Nelle app web e desktop aggiunge un modulo dal controllo <strong class='text-white'>New</strong> (<strong class='text-white'>+</strong>) in alto a sinistra e lo trascina nella finestra. Se la scala è nuova per lei, la <a href='https://pickmytrade.trade/how-to/tradovate-superdom-basics/'>guida alle basi del SuperDOM</a> spiega come si posizionano gli ordini su di essa." },
        { title: "Disporli affiancati", html: "Afferri un modulo dalla barra superiore e lo rilasci accanto all'altro. La maggior parte dei trader mette il grafico a sinistra (o gli dà la metà più grande) e tiene il DOM stretto sulla destra. Trascini il bordo tra i due pannelli per dimensionare ciascuno a suo piacimento." },
        { title: "Impostare entrambi sullo stesso contratto", html: "Faccia clic sul nome del simbolo in cima a ciascun modulo e digiti il contratto desiderato, ad esempio il mese front dell'E-mini S&amp;P 500. Imposti grafico e DOM sullo <em>stesso identico</em> contratto e mese. Un mese diverso è la classica svista: il suo grafico legge uno strumento mentre i suoi ordini vengono instradati a un altro." },
        { title: "Collegarli con un colore", html: "Proprio accanto al nome del simbolo c'è un piccolo punto colorato. Ci faccia clic, scelga un colore, ad esempio il blu, poi imposti il punto del DOM sullo stesso blu. Colori uguali mettono i moduli in un unico gruppo collegato; il <strong class='text-white'>grigio</strong> significa che il collegamento è disattivato. Tradovate offre fino a sei colori, quindi può gestire più di un gruppo collegato in un layout affollato. Una cosa da sapere: i cambi di simbolo si propagano tra i moduli collegati in modo più affidabile quando li guida un Market Analyzer collegato. Se cambia il contratto in un pannello e l'altro non lo segue, lo imposti a mano e verifichi il comportamento attuale nella sua piattaforma, poiché Tradovate lo modifica di tanto in tanto." },
        { title: "Leggere sul grafico, eseguire sul DOM", html: "È tutto il senso dell'abbinamento. Segni i suoi livelli sul grafico, la linea di tendenza, l'incrocio dell'indicatore, dove vuole entrare. Quando il prezzo arriva, inserisca il suo ordine sul DOM sul tick preciso facendo clic con il tasto sinistro o destro sulla scala dei prezzi. Vede la dimensione accumulata a ciascun livello, quindi sa se c'è vera profondità dove cerca di essere eseguito. Preferisce lavorare direttamente dal grafico? Attivi il <a href='https://pickmytrade.trade/how-to/tradovate-chart-trading/'>trading dal grafico</a> e inserisca e trascini gli ordini direttamente sull'asse dei prezzi." },
        { title: "Salvare l'area di lavoro", html: "Una volta disposto come desidera, faccia clic sul <strong class='text-white'>logo di Tradovate</strong> in alto a sinistra, apra <strong class='text-white'>Workspaces</strong> e prema <strong class='text-white'>Save</strong>. Le posizioni delle finestre, le impostazioni del DOM e il layout del grafico tornano al prossimo caricamento, senza dover ricostruire la configurazione a ogni sessione." },
      ],
    },
    { type: "heading",text: "Una limitazione da conoscere" },
    { type: "paragraph",html: "Tradovate non aggancia la scala all'asse dei prezzi del grafico come fanno alcune altre piattaforme. Grafico e DOM restano pannelli separati, affiancati e collegati tramite colore è il massimo grado di abbinamento possibile. Per la maggior parte dei trader è più che sufficiente: pianifica comunque nell'uno ed esegue nell'altro senza dover cercare tra le finestre. Se i suoi grafici non sono ancora a punto, ripassi prima le <a href='https://pickmytrade.trade/how-to/tradovate-charting-basics/'>basi dei grafici</a>." },
    { type: "heading",text: "Automatizzi l'esecuzione con PickMyTrade" },
    { type: "paragraph",html: "Leggere il grafico e cliccare sulla scala è ottimo quando è alla scrivania. Quando non c'è, <strong class='text-white'>PickMyTrade trasforma automaticamente i suoi alert di TradingView in ordini Tradovate reali</strong>, così il trade parte nel momento in cui scatta il suo setup, senza correre al DOM alle 3 di notte. Usi l'abbinamento per costruire e testare la sua lettura, poi lasci che sia l'automazione a occuparsi dei clic." },
  ] },
  ctaHeading: { en: "Automate Your Tradovate Trades", de: "Automatisieren Sie Ihre Tradovate-Trades", es: "Automatice sus operaciones en Tradovate", fr: "Automatisez vos trades Tradovate", it: "Automatizzi i suoi trade su Tradovate" },
  ctaText: { en: "Use the DOM and chart to build and test your read, then let PickMyTrade turn your TradingView alerts into live Tradovate orders automatically.", de: "Nutzen Sie DOM und Chart, um Ihre Einschätzung aufzubauen und zu testen, und lassen Sie dann PickMyTrade Ihre TradingView-Alerts automatisch in echte Tradovate-Orders umsetzen.", es: "Use el DOM y el gráfico para construir y probar su lectura del mercado, y luego deje que PickMyTrade convierta sus alertas de TradingView en órdenes reales de Tradovate automáticamente.", fr: "Utilisez le DOM et le graphique pour construire et tester votre lecture, puis laissez PickMyTrade transformer automatiquement vos alertes TradingView en ordres Tradovate réels.", it: "Usi DOM e grafico per costruire e testare la sua lettura, poi lasci che PickMyTrade trasformi automaticamente i suoi alert di TradingView in ordini Tradovate reali." },
  ctaButtonText: { en: "Start Your Free 7-Day Trial", de: "Starten Sie Ihre kostenlose 7-Tage-Testphase", es: "Comience su prueba gratuita de 7 días", fr: "Commencez votre essai gratuit de 7 jours", it: "Inizi la prova gratuita di 7 giorni" },
  ctaUrl: "https://app.pickmytrade.trade/?register=true&utm_source=content&utm_medium=how-to",
  faqHeading: { en: "Frequently Asked Questions", de: "Häufig gestellte Fragen", es: "Preguntas frecuentes", fr: "Questions fréquentes", it: "Domande frequenti" },
  faqs: { en: [
    { q: "Can I link the DOM and chart to the same symbol in Tradovate?", a: "Yes. Assign the same link color to both modules using the colored dot next to the symbol name. Matching colors group them; gray turns linking off. Symbol changes propagate most dependably when a linked Market Analyzer drives them, so confirm the behavior in your own platform." },
    { q: "Can I attach the DOM directly onto the chart's price axis?", a: "No. Tradovate keeps the chart and DOM as separate modules rather than docking the ladder onto the chart. Arrange them side by side and link them by color instead." },
    { q: "Will my side-by-side layout stay after I log out?", a: "Yes, if you save it. Click the Tradovate logo, open Workspaces, and click Save. Chart templates only store chart appearance, so save the workspace to keep the DOM and the window layout." },
  ], de: [
    { q: "Kann ich DOM und Chart in Tradovate mit demselben Symbol verknüpfen?", a: "Ja. Weisen Sie beiden Modulen über den farbigen Punkt neben dem Symbolnamen dieselbe Verknüpfungsfarbe zu. Gleiche Farben gruppieren sie; Grau schaltet die Verknüpfung aus. Symbolwechsel werden am zuverlässigsten übertragen, wenn ein verknüpfter Market Analyzer sie steuert, bestätigen Sie das Verhalten daher in Ihrer eigenen Plattform." },
    { q: "Kann ich die DOM direkt an die Preisachse des Charts andocken?", a: "Nein. Tradovate hält Chart und DOM als getrennte Module und dockt die Preisleiter nicht an den Chart an. Ordnen Sie sie nebeneinander an und verknüpfen Sie sie stattdessen über die Farbe." },
    { q: "Bleibt mein Layout nebeneinander nach dem Abmelden erhalten?", a: "Ja, wenn Sie es speichern. Klicken Sie auf das Tradovate-Logo, öffnen Sie Workspaces und klicken Sie auf Save. Chart-Vorlagen speichern nur das Erscheinungsbild des Charts, speichern Sie daher den Workspace, um die DOM und das Fensterlayout zu behalten." },
  ], es: [
    { q: "¿Puedo vincular el DOM y el gráfico al mismo símbolo en Tradovate?", a: "Sí. Asigne el mismo color de enlace a ambos módulos mediante el punto de color junto al nombre del símbolo. Los colores iguales los agrupan; el gris desactiva el enlace. Los cambios de símbolo se propagan de forma más fiable cuando los controla un Market Analyzer vinculado, así que confirme el comportamiento en su propia plataforma." },
    { q: "¿Puedo acoplar el DOM directamente al eje de precios del gráfico?", a: "No. Tradovate mantiene el gráfico y el DOM como módulos separados en lugar de acoplar la escalera al gráfico. Colóquelos lado a lado y vincúlelos por color." },
    { q: "¿Se mantendrá mi diseño lado a lado después de cerrar sesión?", a: "Sí, si lo guarda. Haga clic en el logotipo de Tradovate, abra Workspaces y haga clic en Save. Las plantillas de gráfico solo guardan el aspecto del gráfico, así que guarde el espacio de trabajo para conservar el DOM y la disposición de las ventanas." },
  ], fr: [
    { q: "Puis-je lier le DOM et le graphique au même symbole dans Tradovate ?", a: "Oui. Attribuez la même couleur de lien aux deux modules grâce à la pastille de couleur à côté du nom du symbole. Des couleurs identiques les regroupent ; le gris désactive la liaison. Les changements de symbole se propagent le plus sûrement lorsqu'un Market Analyzer lié les pilote ; vérifiez donc le comportement dans votre propre plateforme." },
    { q: "Puis-je fixer le DOM directement sur l'axe des prix du graphique ?", a: "Non. Tradovate conserve le graphique et le DOM comme modules distincts au lieu d'ancrer l'échelle sur le graphique. Disposez-les côte à côte et liez-les plutôt par la couleur." },
    { q: "Ma disposition côte à côte sera-t-elle conservée après la déconnexion ?", a: "Oui, si vous l'enregistrez. Cliquez sur le logo Tradovate, ouvrez Workspaces et cliquez sur Save. Les modèles de graphique ne mémorisent que l'apparence du graphique ; enregistrez donc l'espace de travail pour conserver le DOM et la disposition des fenêtres." },
  ], it: [
    { q: "Posso collegare DOM e grafico allo stesso simbolo in Tradovate?", a: "Sì. Assegni lo stesso colore di collegamento a entrambi i moduli tramite il punto colorato accanto al nome del simbolo. Colori uguali li raggruppano; il grigio disattiva il collegamento. I cambi di simbolo si propagano in modo più affidabile quando li guida un Market Analyzer collegato, quindi verifichi il comportamento nella sua piattaforma." },
    { q: "Posso agganciare il DOM direttamente all'asse dei prezzi del grafico?", a: "No. Tradovate mantiene grafico e DOM come moduli separati anziché agganciare la scala al grafico. Li disponga affiancati e li colleghi tramite il colore." },
    { q: "Il mio layout affiancato resterà dopo il logout?", a: "Sì, se lo salva. Faccia clic sul logo di Tradovate, apra Workspaces e faccia clic su Save. I modelli di grafico memorizzano solo l'aspetto del grafico, quindi salvi l'area di lavoro per conservare il DOM e la disposizione delle finestre." },
  ] },
  relatedHeading: { en: "Related Guides", de: "Verwandte Anleitungen", es: "Guías relacionadas", fr: "Guides associés", it: "Guide correlate" },
  disclosureText: { en: `This guide is for educational and informational purposes only and is not financial, investment, or trading advice. Trading futures and other leveraged products carries a substantial risk of loss and is not suitable for every investor. PickMyTrade is an independent third-party automation platform and is not affiliated with, endorsed by, or sponsored by Tradovate, Inc. "Tradovate" and all related names, logos, and trademarks are the property of their respective owners. Platform features and steps change over time, so always confirm the current process in the official Tradovate platform and documentation before acting.`, de: "Dieser Leitfaden dient ausschließlich Bildungs- und Informationszwecken und stellt keine Finanz-, Anlage- oder Handelsberatung dar. Der Handel mit Futures und anderen gehebelten Produkten birgt ein erhebliches Verlustrisiko und ist nicht für jeden Anleger geeignet. PickMyTrade ist eine unabhängige Automatisierungsplattform eines Drittanbieters und steht in keiner Verbindung zu Tradovate, Inc., wird weder von Tradovate, Inc. unterstützt noch gesponsert. „Tradovate“ und alle zugehörigen Namen, Logos und Marken sind Eigentum ihrer jeweiligen Inhaber. Funktionen und Schritte der Plattform ändern sich im Laufe der Zeit; prüfen Sie daher stets den aktuellen Ablauf in der offiziellen Tradovate-Plattform und -Dokumentation, bevor Sie handeln.", es: "Esta guía tiene fines exclusivamente educativos e informativos y no constituye asesoramiento financiero, de inversión ni de trading. Operar con futuros y otros productos apalancados conlleva un riesgo sustancial de pérdida y no es adecuado para todos los inversores. PickMyTrade es una plataforma de automatización independiente de terceros y no está afiliada, respaldada ni patrocinada por Tradovate, Inc. «Tradovate» y todos los nombres, logotipos y marcas relacionados son propiedad de sus respectivos titulares. Las funciones y los pasos de la plataforma cambian con el tiempo, por lo que debe confirmar siempre el proceso vigente en la plataforma y la documentación oficiales de Tradovate antes de actuar.", fr: "Ce guide est fourni à des fins exclusivement éducatives et informatives et ne constitue pas un conseil financier, d'investissement ou de trading. Le trading de contrats à terme et d'autres produits à effet de levier comporte un risque de perte important et ne convient pas à tous les investisseurs. PickMyTrade est une plateforme d'automatisation tierce indépendante et n'est ni affiliée à Tradovate, Inc., ni approuvée ou parrainée par elle. « Tradovate » et l'ensemble des noms, logos et marques associés sont la propriété de leurs détenteurs respectifs. Les fonctionnalités et les étapes de la plateforme évoluent avec le temps ; vérifiez donc toujours la procédure en vigueur dans la plateforme et la documentation officielles de Tradovate avant d'agir.", it: "Questa guida ha scopo esclusivamente educativo e informativo e non costituisce consulenza finanziaria, di investimento o di trading. Il trading di futures e di altri prodotti a leva comporta un rischio di perdita sostanziale e non è adatto a tutti gli investitori. PickMyTrade è una piattaforma di automazione indipendente di terze parti e non è affiliata a Tradovate, Inc., né da essa approvata o sponsorizzata. «Tradovate» e tutti i nomi, i loghi e i marchi correlati sono di proprietà dei rispettivi titolari. Le funzionalità e le procedure della piattaforma cambiano nel tempo, perciò verifichi sempre la procedura attuale nella piattaforma e nella documentazione ufficiali di Tradovate prima di agire." },
};
const data: GuideArticleData = resolveGuideContent(content, locale, related);

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: data.faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: `${SITE_URL}${withSlash(localizedPath(locale))}` },
    { "@type": "ListItem", position: 2, name: "How-To", item: `${SITE_URL}${withSlash(localizedPath(locale, "how-to"))}` },
    { "@type": "ListItem", position: 3, name: content.h1[locale], item: `${SITE_URL}${withSlash(localizedPath(locale, `how-to/${SLUG}`))}` },
  ],
};

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: content.h1[locale],
  description: content.dek[locale],
  image: `${SITE_URL}/assets/og-default.webp`,
  publisher: { "@type": "Organization", name: "PickMyTrade", logo: { "@type": "ImageObject", url: `${SITE_URL}/assets/logo.png` } },
  datePublished: "2026-07-08",
  dateModified: "2026-07-08",
  mainEntityOfPage: { "@type": "WebPage", "@id": `${SITE_URL}${withSlash(localizedPath(locale, `how-to/${SLUG}`))}` },
};
---

<BaseLayout
  locale={locale}
