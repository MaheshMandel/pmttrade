---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "tradovate-order-status-notifications";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/how-to/${SLUG}`;

const META_TITLE = "Configure Order Status Notifications in Tradovate";
const META_DESCRIPTION =
  "Turn on order status notifications in Tradovate, set a custom sound for each status, and push filled and rejected order alerts straight to your phone.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Order-Status-Benachrichtigungen in Tradovate konfigurieren", es: "Configure las notificaciones de estado de órdenes en Tradovate", fr: "Configurez les notifications de statut d'ordre dans Tradovate", it: "Configuri le notifiche di stato degli ordini in Tradovate" },
  dek: { en: "Miss a fill or a rejection because your eyes were on the chart, and you can blow through a risk limit fast. Tradovate can tell you the second an order changes state, three ways at once.", de: "Verpassen Sie einen Fill oder eine Ablehnung, weil Ihr Blick auf dem Chart lag, können Sie schnell ein Risikolimit durchbrechen. Tradovate kann Sie in der Sekunde informieren, in der eine Order den Status wechselt, und zwar gleich auf drei Wegen.", es: "Si se le escapa una ejecución o un rechazo porque estaba mirando el gráfico, puede superar un límite de riesgo rápidamente. Tradovate puede avisarle en el instante en que una orden cambia de estado, y de tres formas a la vez.", fr: "Si vous manquez une exécution ou un rejet parce que vous aviez les yeux sur le graphique, vous pouvez franchir une limite de risque très vite. Tradovate peut vous prévenir à la seconde où un ordre change d'état, et ce de trois façons à la fois.", it: "Se Le sfugge un'esecuzione o un rifiuto perché aveva gli occhi sul grafico, può superare in fretta un limite di rischio. Tradovate può avvisarLa nell'istante in cui un ordine cambia stato, in tre modi contemporaneamente." },
  readTime: { en: "5 min read", de: "5 Min. Lesezeit", es: "Lectura de 5 min", fr: "Lecture : 5 min", it: "Lettura di 5 min" },
  lastUpdated: "2026-07-10",
  blocks: { en: [
    { type: "paragraph", html: "Miss a fill or a rejection because your eyes were on the chart, and you can blow through a risk limit fast. Tradovate can tell you the second an order changes state, three ways at once: an on-screen ticker, a sound through your browser, and a push to your phone. Here's how to switch each one on and tune it to the statuses you care about." },
    { type: "heading", text: "Where Order Status Notifications Live" },
    { type: "paragraph", html: "Every notification setting sits in one place. Click the <strong class='text-white'>Application Settings</strong> button in the top-right corner of the web trader, open the <strong class='text-white'>Preferences</strong> tab, and scroll down to the <strong class='text-white'>Notifications</strong> section. That's where you'll find the master toggles for order notifications, the ticker panel, audio, and push. Before you start, here's what each channel does:" },
    {
      type: "table",
      headers: ["Notification type", "What it does", "Where it shows up"],
      rows: [
        ["Order (ticker) notification", "Logs each status change as it happens while you trade", "The on-screen notification ticker (the panel with the clock)"],
        ["Audio notification", "Plays a sound the moment a status changes", "Through your browser or desktop app speakers"],
        ["Push notification", "Sends the alert to your phone, even with the web trader closed", "The Tradovate mobile app"],
      ],
    },
    { type: "heading", text: "Configure Order Status Notifications: Step-by-Step" },
    {
      type: "steps",
      items: [
        { title: "Open the Notifications Settings", html: "Click <strong class='text-white'>Application Settings</strong> in the top-right corner, pick the <strong class='text-white'>Preferences</strong> tab, and scroll to the <strong class='text-white'>Notifications</strong> section. This one panel is the hub for everything below, so you won't need to hunt through other menus.", image: { src: `${IMG}/tradovate-order-status-notifications-1.png`, alt: "Tradovate Application Settings Preferences tab scrolled to the Notifications section" } },
        { title: "Turn Order Notifications On", html: "Flip the <strong class='text-white'>Order Notifications</strong> toggle on. That's what feeds status updates into the notification ticker, the panel with the clock that logs your fills, cancels, and rejections in real time. There's a separate toggle for the ticker panel itself: leave it on if you want that running log visible, or switch it off to reclaim screen space while keeping your sounds and push alerts alive.", image: { src: `${IMG}/tradovate-order-status-notifications-2.png`, alt: "Tradovate Notifications settings showing the Order Notifications and ticker panel toggles" } },
        { title: "Open Advanced Configuration to Pick Your Statuses", html: "Click the <strong class='text-white'>Advanced Configuration</strong> button. This is where the real control lives. Instead of all-or-nothing, you get a row for each order status, filled, rejected, canceled, working, and the rest, and you decide which ones are worth interrupting you. Most traders keep Filled and Rejected loud and quiet the noisier in-between states.", image: { src: `${IMG}/tradovate-order-status-notifications-3.png`, alt: "Tradovate Advanced Configuration panel listing order statuses with per-status toggles" } },
        { title: "Set and Test a Sound for Each Status", html: "Every status gets an audio toggle plus a link to change the sound, and there's a library of built-in clips to pick from. Click the link, preview each one, and assign a distinct sound to the statuses that matter. A sharp tone for Rejected and a softer one for Filled means you'll know what happened without glancing at the screen. Use the test button to hear it before you save.", image: { src: `${IMG}/tradovate-order-status-notifications-4.png`, alt: "Tradovate audio notification options with a sound picker and test button for an order status" } },
        { title: "Push Order Alerts to Your Phone", html: "Want alerts when you're away from the desk? Turn on <strong class='text-white'>Push Notifications</strong> in the same Notifications section, then head back into Advanced Configuration to choose which statuses get pushed. Push only works if the Tradovate mobile app is installed and signed in on your phone, and when the app first asks for permission, tap <strong class='text-white'>Allow</strong>. After that, a rejection or a fill reaches your phone even with the web trader closed.", image: { src: `${IMG}/tradovate-order-status-notifications-5.png`, alt: "Tradovate push notification toggle in web settings alongside the mobile app permission prompt" } },
      ],
    },
    { type: "heading", text: "Which Statuses Should You Actually Turn On?" },
    { type: "paragraph", html: "There's no single right answer, but a clean setup usually looks like this:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Filled:</strong> on. You want to know the instant you're in or out of a position.",
        "<strong class='text-white'>Rejected:</strong> on, with a distinct sound. A silent rejection is how people sit flat thinking they're protected.",
        "<strong class='text-white'>Canceled:</strong> on if you lean on working orders, off if it just adds noise.",
        "<strong class='text-white'>Working / Accepted:</strong> usually off, since you placed the order yourself and already know it went in.",
      ],
    },
    { type: "paragraph", html: "Tune it to how you trade, and mute anything that pulls your attention for no reason." },
    { type: "heading", text: "A Note for Prop and Evaluation Accounts" },
    { type: "paragraph", html: "These notification settings are per-platform, not per-firm, so they behave the same whether you're on a personal account or a prop evaluation. Your risk rules are a different story: loss limits and position caps vary by firm and account size, so check your firm's current rules and never treat a fill sound as your only line of defense." },
    { type: "heading", text: "Automate the Trade, Not Just the Alert" },
    { type: "paragraph", html: "Notifications tell you what already happened. If you'd rather the trade itself fire the moment your signal does, <strong class='text-white'>PickMyTrade routes your TradingView alerts straight to Tradovate</strong>, so entries and exits execute without you clicking a thing." },
  ], de: [
    { type: "paragraph",html: "Verpassen Sie einen Fill oder eine Ablehnung, weil Ihr Blick auf dem Chart lag, können Sie schnell ein Risikolimit durchbrechen. Tradovate kann Sie in der Sekunde informieren, in der eine Order den Status wechselt, und zwar gleich auf drei Wegen: über einen Ticker auf dem Bildschirm, einen Sound im Browser und eine Push-Nachricht aufs Telefon. So schalten Sie jeden Weg ein und stimmen ihn auf die Status ab, die Ihnen wichtig sind." },
    { type: "heading",text: "Wo die Order-Status-Benachrichtigungen liegen" },
    { type: "paragraph",html: "Alle Benachrichtigungseinstellungen befinden sich an einer Stelle. Klicken Sie oben rechts im Web-Trader auf die Schaltfläche <strong class='text-white'>Application Settings</strong>, öffnen Sie den Tab <strong class='text-white'>Preferences</strong> und scrollen Sie zum Abschnitt <strong class='text-white'>Notifications</strong>. Dort finden Sie die Hauptschalter für Order-Benachrichtigungen, das Ticker-Panel, Audio und Push. Bevor Sie beginnen, sehen Sie hier, was jeder Kanal leistet:" },
    { type: "table", headers: ["Art der Benachrichtigung","Was sie bewirkt","Wo sie erscheint"], rows: [
      ["Order-Benachrichtigung (Ticker)","Protokolliert jede Statusänderung, während Sie handeln","Im Benachrichtigungs-Ticker auf dem Bildschirm (das Panel mit der Uhr)"],
      ["Audio-Benachrichtigung","Spielt in dem Moment einen Sound ab, in dem sich ein Status ändert","Über die Lautsprecher Ihres Browsers oder der Desktop-App"],
      ["Push-Benachrichtigung","Sendet den Alert auf Ihr Telefon, auch wenn der Web-Trader geschlossen ist","In der mobilen Tradovate-App"],
    ] },
    { type: "heading",text: "Order-Status-Benachrichtigungen konfigurieren: Schritt für Schritt" },
    {
      type: "steps",
      items: [
        { title: "Öffnen Sie die Benachrichtigungseinstellungen", html: "Klicken Sie oben rechts auf <strong class='text-white'>Application Settings</strong>, wählen Sie den Tab <strong class='text-white'>Preferences</strong> und scrollen Sie zum Abschnitt <strong class='text-white'>Notifications</strong>. Dieses eine Panel ist die zentrale Anlaufstelle für alles Folgende, Sie müssen also nicht in anderen Menüs suchen.", image: {"src":`${IMG}/tradovate-order-status-notifications-1.png`,"alt":"Tradovate-Application-Settings-Tab Preferences, gescrollt zum Abschnitt Notifications"} },
        { title: "Schalten Sie Order-Benachrichtigungen ein", html: "Aktivieren Sie den Schalter <strong class='text-white'>Order Notifications</strong>. Er speist die Statusaktualisierungen in den Benachrichtigungs-Ticker ein, das Panel mit der Uhr, das Ihre Fills, Stornierungen und Ablehnungen in Echtzeit protokolliert. Für das Ticker-Panel selbst gibt es einen eigenen Schalter: Lassen Sie ihn an, wenn Sie das laufende Protokoll sehen möchten, oder schalten Sie ihn aus, um Platz auf dem Bildschirm zu gewinnen, während Sounds und Push-Alerts aktiv bleiben.", image: {"src":`${IMG}/tradovate-order-status-notifications-2.png`,"alt":"Tradovate-Notifications-Einstellungen mit den Schaltern Order Notifications und Ticker-Panel"} },
        { title: "Öffnen Sie Advanced Configuration, um Ihre Status auszuwählen", html: "Klicken Sie auf die Schaltfläche <strong class='text-white'>Advanced Configuration</strong>. Hier liegt die eigentliche Kontrolle. Statt alles oder nichts erhalten Sie eine Zeile pro Order-Status – filled, rejected, canceled, working und die übrigen – und entscheiden, welche es wert sind, Sie zu unterbrechen. Die meisten Trader lassen Filled und Rejected laut und die lauteren Zwischenzustände leise.", image: {"src":`${IMG}/tradovate-order-status-notifications-3.png`,"alt":"Tradovate-Panel Advanced Configuration mit einer Liste von Order-Status und Schaltern pro Status"} },
        { title: "Legen Sie für jeden Status einen Sound fest und testen Sie ihn", html: "Jeder Status erhält einen Audio-Schalter und einen Link zum Ändern des Sounds, und es steht eine Bibliothek integrierter Clips zur Auswahl. Klicken Sie auf den Link, hören Sie jeden Clip an und weisen Sie den wichtigen Status jeweils einen eigenen Sound zu. Ein scharfer Ton für Rejected und ein weicherer für Filled sorgen dafür, dass Sie wissen, was passiert ist, ohne auf den Bildschirm zu schauen. Nutzen Sie die Test-Schaltfläche, um den Sound vor dem Speichern zu hören.", image: {"src":`${IMG}/tradovate-order-status-notifications-4.png`,"alt":"Tradovate-Audio-Benachrichtigungsoptionen mit Soundauswahl und Test-Schaltfläche für einen Order-Status"} },
        { title: "Order-Alerts aufs Telefon senden", html: "Möchten Sie Alerts, wenn Sie nicht am Schreibtisch sind? Aktivieren Sie <strong class='text-white'>Push Notifications</strong> im selben Abschnitt Notifications und wechseln Sie dann zurück in Advanced Configuration, um auszuwählen, welche Status per Push gesendet werden. Push funktioniert nur, wenn die mobile Tradovate-App auf Ihrem Telefon installiert und angemeldet ist, und wenn die App erstmals um Erlaubnis bittet, tippen Sie auf <strong class='text-white'>Allow</strong>. Danach erreicht Sie eine Ablehnung oder ein Fill auf dem Telefon, auch wenn der Web-Trader geschlossen ist.", image: {"src":`${IMG}/tradovate-order-status-notifications-5.png`,"alt":"Tradovate-Push-Benachrichtigungsschalter in den Web-Einstellungen neben der Berechtigungsabfrage der mobilen App"} },
      ],
    },
    { type: "heading",text: "Welche Status sollten Sie tatsächlich einschalten?" },
    { type: "paragraph",html: "Es gibt keine allgemeingültige Antwort, aber ein sauberes Setup sieht meist so aus:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Filled:</strong> an. Sie möchten sofort wissen, wann Sie in einer Position sind oder draußen.",
        "<strong class='text-white'>Rejected:</strong> an, mit eigenem Sound. Eine stille Ablehnung ist der Grund, warum Leute flat dasitzen und sich geschützt glauben.",
        "<strong class='text-white'>Canceled:</strong> an, wenn Sie sich auf Working Orders stützen; aus, wenn es nur Lärm erzeugt.",
        "<strong class='text-white'>Working / Accepted:</strong> meist aus, da Sie die Order selbst platziert haben und bereits wissen, dass sie eingegangen ist.",
      ],
    },
    { type: "paragraph",html: "Stimmen Sie es auf Ihre Handelsweise ab und schalten Sie alles stumm, was Ihre Aufmerksamkeit ohne Grund beansprucht." },
    { type: "heading",text: "Ein Hinweis für Prop- und Evaluierungskonten" },
    { type: "paragraph",html: "Diese Benachrichtigungseinstellungen gelten pro Plattform, nicht pro Firma, und verhalten sich daher auf einem privaten Konto genauso wie in einer Prop-Evaluierung. Ihre Risikoregeln sind etwas anderes: Verlustlimits und Positionsobergrenzen unterscheiden sich je nach Firma und Kontogröße. Prüfen Sie die aktuellen Regeln Ihrer Firma und verlassen Sie sich nie allein auf einen Fill-Sound als Schutz." },
    { type: "heading",text: "Den Trade automatisieren, nicht nur den Alert" },
    { type: "paragraph",html: "Benachrichtigungen sagen Ihnen, was bereits passiert ist. Möchten Sie lieber, dass der Trade in dem Moment ausgeführt wird, in dem Ihr Signal kommt: <strong class='text-white'>PickMyTrade leitet Ihre TradingView-Alerts direkt an Tradovate weiter</strong>, sodass Einstiege und Ausstiege ausgeführt werden, ohne dass Sie etwas anklicken müssen." },
  ], es: [
    { type: "paragraph",html: "Si se le escapa una ejecución o un rechazo porque estaba mirando el gráfico, puede superar un límite de riesgo rápidamente. Tradovate puede avisarle en el instante en que una orden cambia de estado, y de tres formas a la vez: un ticker en pantalla, un sonido en su navegador y una notificación push en su teléfono. Aquí le explicamos cómo activar cada una y ajustarla a los estados que le interesan." },
    { type: "heading",text: "Dónde están las notificaciones de estado de órdenes" },
    { type: "paragraph",html: "Todos los ajustes de notificaciones están en un mismo lugar. Haga clic en el botón <strong class='text-white'>Application Settings</strong> en la esquina superior derecha del web trader, abra la pestaña <strong class='text-white'>Preferences</strong> y desplácese hasta la sección <strong class='text-white'>Notifications</strong>. Allí encontrará los interruptores principales de las notificaciones de órdenes, el panel de ticker, el audio y el push. Antes de empezar, esto es lo que hace cada canal:" },
    { type: "table", headers: ["Tipo de notificación","Qué hace","Dónde aparece"], rows: [
      ["Notificación de órdenes (ticker)","Registra cada cambio de estado a medida que ocurre mientras opera","El ticker de notificaciones en pantalla (el panel con el reloj)"],
      ["Notificación de audio","Reproduce un sonido en el momento en que cambia un estado","A través de los altavoces de su navegador o de la aplicación de escritorio"],
      ["Notificación push","Envía la alerta a su teléfono, incluso con el web trader cerrado","La aplicación móvil de Tradovate"],
    ] },
    { type: "heading",text: "Configure las notificaciones de estado de órdenes: paso a paso" },
    {
      type: "steps",
      items: [
        { title: "Abra los ajustes de notificaciones", html: "Haga clic en <strong class='text-white'>Application Settings</strong> en la esquina superior derecha, elija la pestaña <strong class='text-white'>Preferences</strong> y desplácese hasta la sección <strong class='text-white'>Notifications</strong>. Este único panel es el centro de todo lo que sigue, así que no tendrá que buscar en otros menús.", image: {"src":`${IMG}/tradovate-order-status-notifications-1.png`,"alt":"Pestaña Preferences de Application Settings de Tradovate desplazada hasta la sección Notifications"} },
        { title: "Active las notificaciones de órdenes", html: "Active el interruptor <strong class='text-white'>Order Notifications</strong>. Es lo que envía las actualizaciones de estado al ticker de notificaciones, el panel con el reloj que registra sus ejecuciones, cancelaciones y rechazos en tiempo real. Hay un interruptor aparte para el propio panel de ticker: déjelo activado si quiere ver ese registro continuo, o desactívelo para recuperar espacio en pantalla manteniendo activos los sonidos y las alertas push.", image: {"src":`${IMG}/tradovate-order-status-notifications-2.png`,"alt":"Ajustes de notificaciones de Tradovate con los interruptores Order Notifications y del panel de ticker"} },
        { title: "Abra Advanced Configuration para elegir sus estados", html: "Haga clic en el botón <strong class='text-white'>Advanced Configuration</strong>. Aquí está el verdadero control. En lugar de todo o nada, obtiene una fila para cada estado de orden (filled, rejected, canceled, working y el resto) y usted decide cuáles merecen interrumpirle. La mayoría de los traders mantiene Filled y Rejected con sonido y silencia los estados intermedios, más ruidosos.", image: {"src":`${IMG}/tradovate-order-status-notifications-3.png`,"alt":"Panel Advanced Configuration de Tradovate con una lista de estados de órdenes e interruptores por estado"} },
        { title: "Defina y pruebe un sonido para cada estado", html: "Cada estado tiene un interruptor de audio y un enlace para cambiar el sonido, y hay una biblioteca de clips integrados para elegir. Haga clic en el enlace, escuche cada uno y asigne un sonido distinto a los estados que importan. Un tono agudo para Rejected y uno más suave para Filled significa que sabrá qué pasó sin mirar la pantalla. Use el botón de prueba para oírlo antes de guardar.", image: {"src":`${IMG}/tradovate-order-status-notifications-4.png`,"alt":"Opciones de notificación de audio de Tradovate con selector de sonido y botón de prueba para un estado de orden"} },
        { title: "Envíe las alertas de órdenes a su teléfono", html: "¿Quiere recibir alertas cuando está lejos del escritorio? Active <strong class='text-white'>Push Notifications</strong> en la misma sección Notifications y vuelva a Advanced Configuration para elegir qué estados se envían por push. El push solo funciona si la aplicación móvil de Tradovate está instalada y con la sesión iniciada en su teléfono, y cuando la aplicación le pida permiso por primera vez, toque <strong class='text-white'>Allow</strong>. A partir de entonces, un rechazo o una ejecución llega a su teléfono incluso con el web trader cerrado.", image: {"src":`${IMG}/tradovate-order-status-notifications-5.png`,"alt":"Interruptor de notificaciones push de Tradovate en los ajustes web junto a la solicitud de permiso de la aplicación móvil"} },
      ],
    },
    { type: "heading",text: "¿Qué estados conviene activar realmente?" },
    { type: "paragraph",html: "No hay una única respuesta correcta, pero una configuración limpia suele verse así:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Filled:</strong> activado. Quiere saber al instante cuándo está dentro o fuera de una posición.",
        "<strong class='text-white'>Rejected:</strong> activado, con un sonido distinto. Un rechazo silencioso es la forma en que la gente se queda fuera del mercado creyendo estar protegida.",
        "<strong class='text-white'>Canceled:</strong> activado si depende de órdenes activas, desactivado si solo añade ruido.",
        "<strong class='text-white'>Working / Accepted:</strong> normalmente desactivado, ya que usted mismo colocó la orden y ya sabe que entró.",
      ],
    },
    { type: "paragraph",html: "Ajústelo a su forma de operar y silencie todo lo que reclame su atención sin motivo." },
    { type: "heading",text: "Una nota para cuentas de prop firm y de evaluación" },
    { type: "paragraph",html: "Estos ajustes de notificación son por plataforma, no por firma, por lo que se comportan igual en una cuenta personal que en una evaluación de prop firm. Sus reglas de riesgo son otra historia: los límites de pérdida y los topes de posición varían según la firma y el tamaño de la cuenta, así que revise las reglas vigentes de su firma y nunca trate el sonido de una ejecución como su única línea de defensa." },
    { type: "heading",text: "Automatice la operación, no solo la alerta" },
    { type: "paragraph",html: "Las notificaciones le dicen lo que ya ocurrió. Si prefiere que la operación se ejecute en el momento en que llega su señal, <strong class='text-white'>PickMyTrade envía sus alertas de TradingView directamente a Tradovate</strong>, de modo que las entradas y las salidas se ejecutan sin que usted tenga que hacer clic en nada." },
  ], fr: [
    { type: "paragraph",html: "Si vous manquez une exécution ou un rejet parce que vous aviez les yeux sur le graphique, vous pouvez franchir une limite de risque très vite. Tradovate peut vous prévenir à la seconde où un ordre change d'état, et ce de trois façons à la fois : un ticker à l'écran, un son dans votre navigateur et une notification push sur votre téléphone. Voici comment activer chacune d'elles et les régler sur les statuts qui comptent pour vous." },
    { type: "heading",text: "Où se trouvent les notifications de statut d'ordre" },
    { type: "paragraph",html: "Tous les réglages de notification se trouvent au même endroit. Cliquez sur le bouton <strong class='text-white'>Application Settings</strong> en haut à droite du web trader, ouvrez l'onglet <strong class='text-white'>Preferences</strong> et faites défiler jusqu'à la section <strong class='text-white'>Notifications</strong>. C'est là que se trouvent les commutateurs principaux pour les notifications d'ordre, le panneau ticker, l'audio et le push. Avant de commencer, voici ce que fait chaque canal :" },
    { type: "table", headers: ["Type de notification","Ce qu'elle fait","Où elle apparaît"], rows: [
      ["Notification d'ordre (ticker)","Consigne chaque changement de statut au fur et à mesure que vous tradez","Le ticker de notifications à l'écran (le panneau avec l'horloge)"],
      ["Notification audio","Émet un son dès qu'un statut change","Via les haut-parleurs de votre navigateur ou de l'application de bureau"],
      ["Notification push","Envoie l'alerte sur votre téléphone, même avec le web trader fermé","L'application mobile Tradovate"],
    ] },
    { type: "heading",text: "Configurer les notifications de statut d'ordre : étape par étape" },
    {
      type: "steps",
      items: [
        { title: "Ouvrez les réglages de notifications", html: "Cliquez sur <strong class='text-white'>Application Settings</strong> en haut à droite, choisissez l'onglet <strong class='text-white'>Preferences</strong> et faites défiler jusqu'à la section <strong class='text-white'>Notifications</strong>. Ce panneau unique est le centre de tout ce qui suit ; inutile donc de fouiller dans d'autres menus.", image: {"src":`${IMG}/tradovate-order-status-notifications-1.png`,"alt":"Onglet Preferences d'Application Settings de Tradovate défilé jusqu'à la section Notifications"} },
        { title: "Activez les notifications d'ordre", html: "Activez le commutateur <strong class='text-white'>Order Notifications</strong>. C'est lui qui alimente le ticker de notifications en mises à jour de statut, le panneau avec l'horloge qui consigne vos exécutions, annulations et rejets en temps réel. Un commutateur distinct existe pour le panneau ticker lui-même : laissez-le activé si vous voulez voir ce journal en continu, ou désactivez-le pour récupérer de l'espace à l'écran tout en gardant vos sons et vos alertes push.", image: {"src":`${IMG}/tradovate-order-status-notifications-2.png`,"alt":"Réglages de notifications Tradovate affichant les commutateurs Order Notifications et du panneau ticker"} },
        { title: "Ouvrez Advanced Configuration pour choisir vos statuts", html: "Cliquez sur le bouton <strong class='text-white'>Advanced Configuration</strong>. C'est ici que se trouve le vrai contrôle. Au lieu du tout ou rien, vous obtenez une ligne par statut d'ordre (filled, rejected, canceled, working et les autres) et vous décidez lesquels méritent de vous interrompre. La plupart des traders gardent Filled et Rejected bruyants et rendent silencieux les états intermédiaires, plus fréquents.", image: {"src":`${IMG}/tradovate-order-status-notifications-3.png`,"alt":"Panneau Advanced Configuration de Tradovate listant les statuts d'ordre avec des commutateurs par statut"} },
        { title: "Définissez et testez un son pour chaque statut", html: "Chaque statut dispose d'un commutateur audio et d'un lien pour changer le son, avec une bibliothèque de clips intégrés à choisir. Cliquez sur le lien, écoutez chacun et attribuez un son distinct aux statuts qui comptent. Une tonalité aiguë pour Rejected et une plus douce pour Filled vous permettent de savoir ce qui s'est passé sans regarder l'écran. Utilisez le bouton de test pour l'entendre avant d'enregistrer.", image: {"src":`${IMG}/tradovate-order-status-notifications-4.png`,"alt":"Options de notification audio Tradovate avec sélecteur de son et bouton de test pour un statut d'ordre"} },
        { title: "Envoyez les alertes d'ordre sur votre téléphone", html: "Vous voulez des alertes lorsque vous êtes loin du bureau ? Activez <strong class='text-white'>Push Notifications</strong> dans la même section Notifications, puis retournez dans Advanced Configuration pour choisir les statuts envoyés en push. Le push ne fonctionne que si l'application mobile Tradovate est installée et connectée sur votre téléphone, et lorsque l'application demande l'autorisation pour la première fois, appuyez sur <strong class='text-white'>Allow</strong>. Ensuite, un rejet ou une exécution arrive sur votre téléphone même avec le web trader fermé.", image: {"src":`${IMG}/tradovate-order-status-notifications-5.png`,"alt":"Commutateur de notifications push Tradovate dans les réglages web à côté de la demande d'autorisation de l'application mobile"} },
      ],
    },
    { type: "heading",text: "Quels statuts faut-il vraiment activer ?" },
    { type: "paragraph",html: "Il n'y a pas de réponse unique, mais une configuration propre ressemble généralement à ceci :" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Filled :</strong> activé. Vous voulez savoir à l'instant où vous entrez ou sortez d'une position.",
        "<strong class='text-white'>Rejected :</strong> activé, avec un son distinct. Un rejet silencieux, c'est ainsi que l'on reste à plat en se croyant protégé.",
        "<strong class='text-white'>Canceled :</strong> activé si vous vous appuyez sur des ordres actifs, désactivé si cela ne fait que du bruit.",
        "<strong class='text-white'>Working / Accepted :</strong> généralement désactivé, puisque vous avez passé l'ordre vous-même et savez déjà qu'il est parti.",
      ],
    },
    { type: "paragraph",html: "Réglez cela selon votre façon de trader et mettez en sourdine tout ce qui attire votre attention sans raison." },
    { type: "heading",text: "Une note pour les comptes prop et d'évaluation" },
    { type: "paragraph",html: "Ces réglages de notification sont propres à la plateforme, pas à la société ; ils se comportent donc de la même façon sur un compte personnel que sur une évaluation prop. Vos règles de risque, en revanche, sont une autre affaire : les limites de perte et les plafonds de position varient selon la société et la taille du compte ; vérifiez donc les règles en vigueur de votre société et ne considérez jamais un son d'exécution comme votre seule ligne de défense." },
    { type: "heading",text: "Automatisez le trade, pas seulement l'alerte" },
    { type: "paragraph",html: "Les notifications vous disent ce qui s'est déjà produit. Si vous préférez que le trade se déclenche à l'instant où votre signal arrive, <strong class='text-white'>PickMyTrade achemine vos alertes TradingView directement vers Tradovate</strong>, de sorte que les entrées et les sorties s'exécutent sans que vous ayez à cliquer." },
  ], it: [
    { type: "paragraph",html: "Se Le sfugge un'esecuzione o un rifiuto perché aveva gli occhi sul grafico, può superare in fretta un limite di rischio. Tradovate può avvisarLa nell'istante in cui un ordine cambia stato, in tre modi contemporaneamente: un ticker a schermo, un suono nel browser e una notifica push sul telefono. Ecco come attivare ciascuno e adattarlo agli stati che Le interessano." },
    { type: "heading",text: "Dove si trovano le notifiche di stato degli ordini" },
    { type: "paragraph",html: "Tutte le impostazioni di notifica si trovano in un unico posto. Clicchi sul pulsante <strong class='text-white'>Application Settings</strong> nell'angolo in alto a destra del web trader, apra la scheda <strong class='text-white'>Preferences</strong> e scorra fino alla sezione <strong class='text-white'>Notifications</strong>. Lì trova gli interruttori principali per le notifiche degli ordini, il pannello ticker, l'audio e il push. Prima di iniziare, ecco cosa fa ciascun canale:" },
    { type: "table", headers: ["Tipo di notifica","Cosa fa","Dove compare"], rows: [
      ["Notifica degli ordini (ticker)","Registra ogni cambio di stato man mano che avviene mentre opera","Il ticker delle notifiche a schermo (il pannello con l'orologio)"],
      ["Notifica audio","Riproduce un suono nel momento in cui cambia uno stato","Tramite gli altoparlanti del browser o dell'app desktop"],
      ["Notifica push","Invia l'avviso al telefono, anche con il web trader chiuso","L'app mobile di Tradovate"],
    ] },
    { type: "heading",text: "Configurare le notifiche di stato degli ordini: passo dopo passo" },
    {
      type: "steps",
      items: [
        { title: "Apra le impostazioni delle notifiche", html: "Clicchi su <strong class='text-white'>Application Settings</strong> nell'angolo in alto a destra, scelga la scheda <strong class='text-white'>Preferences</strong> e scorra fino alla sezione <strong class='text-white'>Notifications</strong>. Questo unico pannello è il punto di riferimento per tutto ciò che segue, quindi non dovrà cercare in altri menu.", image: {"src":`${IMG}/tradovate-order-status-notifications-1.png`,"alt":"Scheda Preferences di Application Settings di Tradovate scorsa fino alla sezione Notifications"} },
        { title: "Attivi le notifiche degli ordini", html: "Attivi l'interruttore <strong class='text-white'>Order Notifications</strong>. È ciò che alimenta il ticker delle notifiche con gli aggiornamenti di stato, il pannello con l'orologio che registra in tempo reale esecuzioni, annullamenti e rifiuti. Esiste un interruttore separato per il pannello ticker stesso: lo lasci attivo se vuole vedere quel registro continuo, oppure lo disattivi per recuperare spazio sullo schermo mantenendo attivi suoni e avvisi push.", image: {"src":`${IMG}/tradovate-order-status-notifications-2.png`,"alt":"Impostazioni delle notifiche di Tradovate con gli interruttori Order Notifications e del pannello ticker"} },
        { title: "Apra Advanced Configuration per scegliere gli stati", html: "Clicchi sul pulsante <strong class='text-white'>Advanced Configuration</strong>. È qui che si trova il vero controllo. Invece del tutto o niente, ottiene una riga per ogni stato dell'ordine (filled, rejected, canceled, working e gli altri) e decide quali meritano di interromperLa. La maggior parte dei trader mantiene Filled e Rejected rumorosi e silenzia gli stati intermedi, più frequenti.", image: {"src":`${IMG}/tradovate-order-status-notifications-3.png`,"alt":"Pannello Advanced Configuration di Tradovate con l'elenco degli stati degli ordini e gli interruttori per stato"} },
        { title: "Imposti e provi un suono per ogni stato", html: "Ogni stato ha un interruttore audio e un link per cambiare il suono, con una libreria di clip integrate tra cui scegliere. Clicchi sul link, ascolti ciascuno e assegni un suono distinto agli stati che contano. Un tono secco per Rejected e uno più morbido per Filled Le permette di capire cosa è successo senza guardare lo schermo. Usi il pulsante di prova per ascoltarlo prima di salvare.", image: {"src":`${IMG}/tradovate-order-status-notifications-4.png`,"alt":"Opzioni di notifica audio di Tradovate con selettore del suono e pulsante di prova per uno stato dell'ordine"} },
        { title: "Invii gli avvisi degli ordini al telefono", html: "Vuole ricevere avvisi quando è lontano dalla scrivania? Attivi <strong class='text-white'>Push Notifications</strong> nella stessa sezione Notifications, poi torni in Advanced Configuration per scegliere quali stati inviare in push. Il push funziona solo se l'app mobile di Tradovate è installata e con l'accesso effettuato sul telefono, e quando l'app chiede il permesso la prima volta, tocchi <strong class='text-white'>Allow</strong>. Da quel momento, un rifiuto o un'esecuzione Le arriva sul telefono anche con il web trader chiuso.", image: {"src":`${IMG}/tradovate-order-status-notifications-5.png`,"alt":"Interruttore delle notifiche push di Tradovate nelle impostazioni web accanto alla richiesta di autorizzazione dell'app mobile"} },
      ],
    },
    { type: "heading",text: "Quali stati conviene davvero attivare?" },
    { type: "paragraph",html: "Non esiste un'unica risposta giusta, ma una configurazione pulita di solito è questa:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Filled:</strong> attivo. Vuole sapere nell'istante in cui è dentro o fuori da una posizione.",
        "<strong class='text-white'>Rejected:</strong> attivo, con un suono distinto. Un rifiuto silenzioso è il modo in cui si resta flat credendosi protetti.",
        "<strong class='text-white'>Canceled:</strong> attivo se si affida agli ordini attivi, disattivo se aggiunge solo rumore.",
        "<strong class='text-white'>Working / Accepted:</strong> di solito disattivo, perché ha piazzato l'ordine Lei stesso e sa già che è stato inviato.",
      ],
    },
    { type: "paragraph",html: "Lo adatti al Suo modo di operare e silenzi tutto ciò che attira la Sua attenzione senza motivo." },
    { type: "heading",text: "Una nota per i conti prop e di valutazione" },
    { type: "paragraph",html: "Queste impostazioni di notifica valgono per piattaforma, non per società, quindi si comportano allo stesso modo su un conto personale e su una valutazione prop. Le Sue regole di rischio sono un'altra storia: i limiti di perdita e i tetti di posizione variano in base alla società e alle dimensioni del conto, perciò controlli le regole attuali della Sua società e non consideri mai il suono di un'esecuzione come l'unica linea di difesa." },
    { type: "heading",text: "Automatizzi il trade, non solo l'avviso" },
    { type: "paragraph",html: "Le notifiche Le dicono cosa è già successo. Se preferisce che il trade parta nel momento in cui arriva il Suo segnale, <strong class='text-white'>PickMyTrade instrada i Suoi alert di TradingView direttamente su Tradovate</strong>, così ingressi e uscite vengono eseguiti senza che Lei debba cliccare nulla." },
  ] },
  ctaHeading: { en: "Let the Trade Fire on Its Own", de: "Lassen Sie den Trade von selbst ausführen", es: "Deje que la operación se ejecute sola", fr: "Laissez le trade se déclencher tout seul", it: "Lasci che il trade parta da solo" },
  ctaText: { en: "PickMyTrade routes your TradingView alerts straight to Tradovate, so entries and exits execute without you clicking a thing.", de: "PickMyTrade leitet Ihre TradingView-Alerts direkt an Tradovate weiter, sodass Einstiege und Ausstiege ausgeführt werden, ohne dass Sie etwas anklicken müssen.", es: "PickMyTrade envía sus alertas de TradingView directamente a Tradovate, de modo que las entradas y las salidas se ejecutan sin que usted tenga que hacer clic en nada.", fr: "PickMyTrade achemine vos alertes TradingView directement vers Tradovate, de sorte que les entrées et les sorties s'exécutent sans que vous ayez à cliquer.", it: "PickMyTrade instrada i Suoi alert di TradingView direttamente su Tradovate, così ingressi e uscite vengono eseguiti senza che Lei debba cliccare nulla." },
  ctaButtonText: { en: "Start Your Free 7-Day Trial", de: "Starten Sie Ihre kostenlose 7-Tage-Testphase", es: "Comience su prueba gratuita de 7 días", fr: "Commencez votre essai gratuit de 7 jours", it: "Inizi la prova gratuita di 7 giorni" },
  ctaUrl: "https://app.pickmytrade.trade/?register=true&utm_source=content&utm_medium=how-to",
  faqHeading: { en: "Frequently Asked Questions", de: "Häufig gestellte Fragen", es: "Preguntas frecuentes", fr: "Questions fréquentes", it: "Domande frequenti" },
  faqs: { en: [
    { q: "Why can't I hear any order sounds in Tradovate?", a: "Two usual culprits. Either Order Notifications or the per-status audio toggle is off under Application Settings > Preferences > Notifications, or your browser tab is muted. Check both, then use the test button next to the sound." },
    { q: "Do I need the mobile app for push notifications?", a: "Yes. Push alerts only reach your phone if the Tradovate mobile app is installed, signed in, and allowed to send notifications. The web toggle on its own won't deliver them." },
    { q: "Can I use a different sound for filled versus rejected orders?", a: "Yes. Open Advanced Configuration and set the sound per status from the change-sound link, so you can tell a fill from a rejection without looking." },
  ], de: [
    { q: "Warum höre ich in Tradovate keine Order-Sounds?", a: "Meist gibt es zwei Ursachen. Entweder sind Order Notifications oder der Audio-Schalter pro Status unter Application Settings > Preferences > Notifications ausgeschaltet, oder Ihr Browser-Tab ist stummgeschaltet. Prüfen Sie beides und nutzen Sie dann die Test-Schaltfläche neben dem Sound." },
    { q: "Brauche ich die mobile App für Push-Benachrichtigungen?", a: "Ja. Push-Alerts erreichen Ihr Telefon nur, wenn die mobile Tradovate-App installiert, angemeldet und für Benachrichtigungen freigegeben ist. Der Web-Schalter allein liefert sie nicht aus." },
    { q: "Kann ich für Filled und Rejected unterschiedliche Sounds verwenden?", a: "Ja. Öffnen Sie Advanced Configuration und legen Sie den Sound pro Status über den Link zum Ändern des Sounds fest, damit Sie einen Fill von einer Ablehnung unterscheiden können, ohne hinzusehen." },
  ], es: [
    { q: "¿Por qué no oigo ningún sonido de órdenes en Tradovate?", a: "Hay dos causas habituales. O bien Order Notifications o el interruptor de audio de cada estado están desactivados en Application Settings > Preferences > Notifications, o bien la pestaña de su navegador está silenciada. Revise ambas cosas y después use el botón de prueba junto al sonido." },
    { q: "¿Necesito la aplicación móvil para las notificaciones push?", a: "Sí. Las alertas push solo llegan a su teléfono si la aplicación móvil de Tradovate está instalada, con la sesión iniciada y con permiso para enviar notificaciones. El interruptor web por sí solo no las entrega." },
    { q: "¿Puedo usar un sonido distinto para órdenes ejecutadas y rechazadas?", a: "Sí. Abra Advanced Configuration y defina el sonido de cada estado desde el enlace para cambiar el sonido, de modo que distinga una ejecución de un rechazo sin mirar." },
  ], fr: [
    { q: "Pourquoi n'entends-je aucun son d'ordre dans Tradovate ?", a: "Il y a deux causes habituelles. Soit Order Notifications ou le commutateur audio de chaque statut est désactivé dans Application Settings > Preferences > Notifications, soit l'onglet de votre navigateur est en sourdine. Vérifiez les deux, puis utilisez le bouton de test à côté du son." },
    { q: "Ai-je besoin de l'application mobile pour les notifications push ?", a: "Oui. Les alertes push n'atteignent votre téléphone que si l'application mobile Tradovate est installée, connectée et autorisée à envoyer des notifications. Le commutateur web seul ne les délivre pas." },
    { q: "Puis-je utiliser un son différent pour les ordres exécutés et rejetés ?", a: "Oui. Ouvrez Advanced Configuration et définissez le son par statut via le lien de changement de son, afin de distinguer une exécution d'un rejet sans regarder." },
  ], it: [
    { q: "Perché non sento alcun suono degli ordini in Tradovate?", a: "Di solito le cause sono due. O Order Notifications oppure l'interruttore audio per stato è disattivato in Application Settings > Preferences > Notifications, oppure la scheda del browser è disattivata (muta). Controlli entrambi, poi usi il pulsante di prova accanto al suono." },
    { q: "Mi serve l'app mobile per le notifiche push?", a: "Sì. Gli avvisi push raggiungono il telefono solo se l'app mobile di Tradovate è installata, con l'accesso effettuato e autorizzata a inviare notifiche. L'interruttore web da solo non li recapita." },
    { q: "Posso usare un suono diverso per gli ordini eseguiti e quelli rifiutati?", a: "Sì. Apra Advanced Configuration e imposti il suono per ogni stato dal link per cambiare il suono, così potrà distinguere un'esecuzione da un rifiuto senza guardare." },
  ] },
  relatedHeading: { en: "Related Guides", de: "Verwandte Leitfäden", es: "Guías relacionadas", fr: "Guides associés", it: "Guide correlate" },
  disclosureText: { en: `This guide is for educational and informational purposes only and is not financial, investment, or trading advice. Trading futures and other leveraged products carries a substantial risk of loss and is not suitable for every investor. PickMyTrade is an independent third-party automation platform and is not affiliated with, endorsed by, or sponsored by Tradovate, Inc. "Tradovate" and all related names, logos, and trademarks are the property of their respective owners. Platform features and steps change over time, so always confirm the current process in the official Tradovate platform and documentation before acting.`, de: "Dieser Leitfaden dient ausschließlich Bildungs- und Informationszwecken und stellt keine Finanz-, Anlage- oder Handelsberatung dar. Der Handel mit Futures und anderen gehebelten Produkten birgt ein erhebliches Verlustrisiko und ist nicht für jeden Anleger geeignet. PickMyTrade ist eine unabhängige Automatisierungsplattform eines Drittanbieters und steht in keiner Verbindung zu Tradovate, Inc., wird von diesem weder unterstützt noch gesponsert. \"Tradovate\" und alle zugehörigen Namen, Logos und Marken sind Eigentum ihrer jeweiligen Inhaber. Funktionen und Schritte der Plattform ändern sich im Laufe der Zeit. Bestätigen Sie daher stets den aktuellen Ablauf in der offiziellen Tradovate-Plattform und -Dokumentation, bevor Sie handeln.", es: "Esta guía tiene fines exclusivamente educativos e informativos y no constituye asesoramiento financiero, de inversión ni de trading. Operar con futuros y otros productos apalancados conlleva un riesgo sustancial de pérdida y no es adecuado para todos los inversores. PickMyTrade es una plataforma de automatización independiente de terceros y no está afiliada, respaldada ni patrocinada por Tradovate, Inc. \"Tradovate\" y todos los nombres, logotipos y marcas relacionados son propiedad de sus respectivos titulares. Las funciones y los pasos de la plataforma cambian con el tiempo, por lo que debe confirmar siempre el proceso vigente en la plataforma y la documentación oficiales de Tradovate antes de actuar.", fr: "Ce guide est fourni à des fins strictement éducatives et informatives et ne constitue pas un conseil financier, d'investissement ou de trading. Le trading de contrats à terme et d'autres produits à effet de levier comporte un risque de perte important et ne convient pas à tous les investisseurs. PickMyTrade est une plateforme d'automatisation tierce indépendante et n'est ni affiliée à Tradovate, Inc., ni approuvée ou parrainée par cette dernière. « Tradovate » ainsi que tous les noms, logos et marques associés sont la propriété de leurs détenteurs respectifs. Les fonctionnalités et les étapes de la plateforme évoluent avec le temps ; vérifiez donc toujours la procédure en vigueur dans la plateforme et la documentation officielles de Tradovate avant d'agir.", it: "Questa guida ha esclusivamente scopo educativo e informativo e non costituisce consulenza finanziaria, di investimento o di trading. Il trading di futures e di altri prodotti a leva comporta un rischio di perdita sostanziale e non è adatto a tutti gli investitori. PickMyTrade è una piattaforma di automazione indipendente di terze parti e non è affiliata, approvata né sponsorizzata da Tradovate, Inc. \"Tradovate\" e tutti i nomi, loghi e marchi correlati sono di proprietà dei rispettivi titolari. Le funzionalità e i passaggi della piattaforma cambiano nel tempo, quindi confermi sempre la procedura attuale nella piattaforma e nella documentazione ufficiali di Tradovate prima di agire." },
};
const data: GuideArticleData = resolveGuideContent(content, locale, related);

