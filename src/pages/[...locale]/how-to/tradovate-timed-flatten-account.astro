---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "tradovate-timed-flatten-account";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/how-to/${SLUG}`;

const META_TITLE = "Auto-Flatten Your Account at a Set Time in Tradovate";
const META_DESCRIPTION =
  "Schedule an automatic timed flatten in Tradovate to cancel orders and close open positions at a set time, a hard end-of-day cutoff you can't forget.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Konto in Tradovate zu einer festgelegten Zeit automatisch glätten", es: "Aplane su cuenta automáticamente a una hora fija en Tradovate", fr: "Clôturer automatiquement votre compte à une heure fixe dans Tradovate", it: "Chiudere automaticamente il conto a un orario prestabilito in Tradovate" },
  dek: { en: "Set a clock time and Tradovate cancels your working orders and closes every open position for you, no clicks, no scramble for the panic button. In the app it's labeled Flatten Today.", de: "Legen Sie eine Uhrzeit fest, und Tradovate storniert Ihre aktiven Orders und schließt jede offene Position für Sie, ohne Klicks und ohne Hektik am Panikknopf. In der App heißt die Funktion Flatten Today.", es: "Establezca una hora del reloj y Tradovate cancela sus órdenes activas y cierra todas las posiciones abiertas por usted, sin clics y sin buscar el botón de pánico. En la aplicación se llama Flatten Today.", fr: "Définissez une heure et Tradovate annule vos ordres actifs et clôture chaque position ouverte à votre place, sans clic et sans chercher le bouton panique. Dans l'application, la fonction s'appelle Flatten Today.", it: "Imposti un orario e Tradovate cancella i Suoi ordini attivi e chiude ogni posizione aperta al posto Suo, senza clic e senza correre al pulsante di emergenza. Nell'app si chiama Flatten Today." },
  readTime: { en: "4 min read", de: "4 Min. Lesezeit", es: "Lectura de 4 min", fr: "Lecture : 4 min", it: "Lettura di 4 min" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "Some days you're glued to the charts. Other days you get pulled into a meeting, the kids need something, or you just step away and forget you're still holding two NQ contracts into the close. Tradovate's timed flatten fixes that. Set a clock time, and the platform cancels your working orders and closes every open position for you, no clicks, no scramble for the panic button. In the app it's labeled <strong class='text-white'>Flatten Today</strong>. Here's how to arm it." },
    { type: "heading", text: "What the Timed Flatten Actually Does" },
    { type: "paragraph", html: "<strong class='text-white'>Flatten Today</strong> is a one-shot scheduler. You pick a time for the current trading day, and when the platform's clock hits it, any contract with an open position gets exited at market and every working or suspended order tied to it gets cancelled. Orders resting on positions you're already flat in are left alone. Think of it as a dead man's switch for your account, a hard cutoff that fires whether you're at the desk or not." },
    { type: "heading", text: "How to Set a Timed Flatten in Tradovate" },
    {
      type: "steps",
      items: [
        { title: "Open Your Account Balance Panel", html: "At the top of the Trader, right next to your account number, you'll see your <strong class='text-white'>Cash Balance / Unrealized P&amp;L</strong> readout. Click it. That opens the account-level menu where the flatten controls live. Tradovate has reshuffled the wording on this panel before, so if the labels look a little different, just hunt for the account equity / P&amp;L button sitting beside your account name." },
        { title: "Choose Flatten Today", html: "In the menu that drops down, pick <strong class='text-white'>Flatten Today</strong>. A small pop-up opens with the timer controls. This is the same menu you'd use to flatten everything right now, you're just reaching for the scheduled version instead." },
        { title: "Enable the Timer and Set Your Flatten Time", html: "Switch on the timed flatten and enter the time you want everything closed, say 3:10 PM if you want to be flat well before the equity-index close. One thing that trips people up: the time runs on the platform's <strong class='text-white'>displayed time zone</strong>, so check whether you're looking at Eastern, Central, or your local setting before you lock it in. A time entered against the wrong zone is the difference between a clean exit and a surprise." },
        { title: "Submit and Confirm It's Armed", html: "Hit <strong class='text-white'>Submit</strong>. The <strong class='text-white'>Flatten Today</strong> button turns <strong class='text-white'>green</strong> to show the timer is live; <strong class='text-white'>red</strong> means it's off. When your set time arrives, the platform cancels the orders and flattens the positions on its own, then disables itself. That last bit matters: it's a single-day setting. It won't run again tomorrow unless you set it up again." },
      ],
    },
    { type: "heading", text: "A Few Things Worth Knowing" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>It resets every day.</strong> There's no built-in \"every day, forever\" toggle, once it fires, it switches off. Re-arm it each session if you want a daily cutoff.",
        "<strong class='text-white'>You set it per account.</strong> You arm Flatten Today from a specific account's balance panel, so if you trade more than one account, set it on each one you want covered.",
        "<strong class='text-white'>It only touches open positions.</strong> Contracts you're flat in aren't affected, and their resting orders stay put.",
        "<strong class='text-white'>Prop-firm cutoffs vary.</strong> If your firm bans holding through the close or overnight, use its required flat-by time as your flatten time. That number varies by firm and account size, so check your firm's current rules.",
      ],
    },
    { type: "heading", text: "Why Bother With a Timed Flatten" },
    { type: "paragraph", html: "A hard, automatic cutoff does a few things a mental note can't. It keeps you out of the higher overnight margin that kicks in at session reset. It enforces a no-overnight-positions rule without you watching the clock. And it protects you on the days you walk away from the desk with size on. For anyone trading a funded evaluation with a strict flat-by time, it's a cheap insurance policy against a rule breach." },
    { type: "heading", text: "Want the Exit Fully Hands-Off? Automate It" },
    { type: "paragraph", html: "The timed flatten is great for a fixed daily cutoff. But if you want exits driven by your strategy, close on a signal, reverse on a crossover, bail on a news candle, that's where PickMyTrade comes in. It wires your TradingView alerts straight to your Tradovate account, so a close or reverse alert flattens the position and clears the leftover orders on its own. Set the timed flatten as your safety net, and let automation handle the rest." },
  ], de: [
    { type: "paragraph",html: "An manchen Tagen kleben Sie an den Charts. An anderen werden Sie in ein Meeting gezogen, die Kinder brauchen etwas, oder Sie verlassen einfach den Platz und vergessen, dass Sie noch zwei NQ-Kontrakte über den Handelsschluss halten. Das zeitgesteuerte Glätten von Tradovate behebt das. Legen Sie eine Uhrzeit fest, und die Plattform storniert Ihre aktiven Orders und schließt jede offene Position für Sie, ohne Klicks und ohne Hektik am Panikknopf. In der App heißt es <strong class='text-white'>Flatten Today</strong>. So aktivieren Sie es." },
    { type: "heading",text: "Was das zeitgesteuerte Glätten tatsächlich tut" },
    { type: "paragraph",html: "<strong class='text-white'>Flatten Today</strong> ist ein einmaliger Scheduler. Sie wählen eine Uhrzeit für den aktuellen Handelstag, und wenn die Uhr der Plattform sie erreicht, wird jeder Kontrakt mit einer offenen Position zum Marktpreis geschlossen und jede aktive oder ausgesetzte Order dazu storniert. Orders, die auf Positionen ruhen, in denen Sie bereits flat sind, bleiben unberührt. Betrachten Sie es als Totmannschalter für Ihr Konto, eine harte Grenze, die auslöst, ob Sie am Schreibtisch sind oder nicht." },
    { type: "heading",text: "So legen Sie ein zeitgesteuertes Glätten in Tradovate fest" },
    {
      type: "steps",
      items: [
        { title: "Öffnen Sie Ihr Kontostand-Panel", html: "Oben im Trader, direkt neben Ihrer Kontonummer, sehen Sie die Anzeige <strong class='text-white'>Cash Balance / Unrealized P&amp;L</strong>. Klicken Sie darauf. Damit öffnet sich das Menü auf Kontoebene, in dem die Flatten-Steuerungen liegen. Tradovate hat die Beschriftungen in diesem Panel schon früher umgestellt; wenn die Bezeichnungen etwas anders aussehen, suchen Sie einfach die Schaltfläche für Kontokapital / P&amp;L neben Ihrem Kontonamen." },
        { title: "Flatten Today wählen", html: "Wählen Sie im aufklappenden Menü <strong class='text-white'>Flatten Today</strong>. Ein kleines Pop-up mit den Timer-Steuerungen öffnet sich. Dies ist dasselbe Menü, mit dem Sie sofort alles glätten würden, Sie greifen nur zur geplanten Variante." },
        { title: "Timer aktivieren und Ihre Flatten-Uhrzeit festlegen", html: "Schalten Sie das zeitgesteuerte Glätten ein und geben Sie die Uhrzeit ein, zu der alles geschlossen sein soll, etwa 15:10 Uhr (3:10 PM), wenn Sie lange vor dem Handelsschluss der Aktienindizes flat sein möchten. Eine Sache, über die viele stolpern: Die Zeit richtet sich nach der <strong class='text-white'>angezeigten Zeitzone</strong> der Plattform. Prüfen Sie also, ob Eastern, Central oder Ihre lokale Einstellung angezeigt wird, bevor Sie sie festlegen. Eine gegen die falsche Zone eingegebene Uhrzeit ist der Unterschied zwischen einem sauberen Exit und einer bösen Überraschung." },
        { title: "Absenden und prüfen, ob es aktiviert ist", html: "Klicken Sie auf <strong class='text-white'>Submit</strong>. Die Schaltfläche <strong class='text-white'>Flatten Today</strong> wird <strong class='text-white'>grün</strong>, um anzuzeigen, dass der Timer aktiv ist; <strong class='text-white'>rot</strong> bedeutet, dass er aus ist. Wenn Ihre festgelegte Zeit eintrifft, storniert die Plattform die Orders und glättet die Positionen von selbst und deaktiviert sich anschließend. Dieser letzte Punkt ist wichtig: Es ist eine Einstellung für einen einzigen Tag. Sie läuft morgen nicht erneut, es sei denn, Sie richten sie erneut ein." },
      ],
    },
    { type: "heading",text: "Einige wissenswerte Punkte" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Es wird jeden Tag zurückgesetzt.</strong> Es gibt keinen eingebauten Schalter „jeden Tag, für immer“. Sobald es ausgelöst hat, schaltet es sich ab. Aktivieren Sie es jede Session erneut, wenn Sie einen täglichen Cutoff möchten.",
        "<strong class='text-white'>Sie legen es pro Konto fest.</strong> Sie aktivieren Flatten Today im Kontostand-Panel eines bestimmten Kontos. Wenn Sie mehr als ein Konto handeln, richten Sie es also bei jedem Konto ein, das abgedeckt sein soll.",
        "<strong class='text-white'>Es betrifft nur offene Positionen.</strong> Kontrakte, in denen Sie flat sind, bleiben unberührt, und ihre ruhenden Orders bleiben bestehen.",
        "<strong class='text-white'>Cutoffs von Prop-Firmen unterscheiden sich.</strong> Wenn Ihre Firma das Halten über den Handelsschluss oder über Nacht verbietet, verwenden Sie deren vorgeschriebene Flat-by-Zeit als Ihre Flatten-Uhrzeit. Dieser Wert variiert je nach Firma und Kontogröße, prüfen Sie daher die aktuellen Regeln Ihrer Firma.",
      ],
    },
    { type: "heading",text: "Wozu ein zeitgesteuertes Glätten" },
    { type: "paragraph",html: "Ein harter, automatischer Cutoff leistet einiges, was eine mentale Notiz nicht kann. Er hält Sie aus der höheren Overnight-Margin heraus, die beim Session-Reset greift. Er setzt eine Regel „keine Overnight-Positionen“ durch, ohne dass Sie auf die Uhr schauen müssen. Und er schützt Sie an den Tagen, an denen Sie den Schreibtisch mit offener Größe verlassen. Für alle, die eine finanzierte Evaluation mit strikter Flat-by-Zeit handeln, ist er eine günstige Versicherung gegen einen Regelverstoß." },
    { type: "heading",text: "Sie möchten den Exit vollständig freihändig? Automatisieren Sie ihn" },
    { type: "paragraph",html: "Das zeitgesteuerte Glätten ist ideal für einen festen täglichen Cutoff. Wenn Sie aber Exits wünschen, die von Ihrer Strategie gesteuert werden, also Schließen bei einem Signal, Umkehren bei einem Crossover oder Aussteigen bei einer Nachrichtenkerze, kommt PickMyTrade ins Spiel. Es verbindet Ihre TradingView-Alerts direkt mit Ihrem Tradovate-Konto, sodass ein Close- oder Reverse-Alert die Position glättet und die übrigen Orders von selbst löscht. Richten Sie das zeitgesteuerte Glätten als Ihr Sicherheitsnetz ein und überlassen Sie den Rest der Automatisierung." },
  ], es: [
    { type: "paragraph",html: "Hay días en que está pegado a los gráficos. Otros días lo reclama una reunión, los niños necesitan algo o simplemente se levanta y olvida que aún mantiene dos contratos de NQ hasta el cierre. El aplanado programado de Tradovate lo soluciona. Establezca una hora del reloj y la plataforma cancela sus órdenes activas y cierra todas las posiciones abiertas por usted, sin clics y sin buscar el botón de pánico. En la aplicación se llama <strong class='text-white'>Flatten Today</strong>. Así se activa." },
    { type: "heading",text: "Qué hace realmente el aplanado programado" },
    { type: "paragraph",html: "<strong class='text-white'>Flatten Today</strong> es un programador de un solo disparo. Usted elige una hora para el día de negociación actual y, cuando el reloj de la plataforma la alcanza, cualquier contrato con una posición abierta se cierra a mercado y se cancelan todas las órdenes activas o suspendidas asociadas. Las órdenes en reposo sobre posiciones en las que ya está plano no se tocan. Piense en ello como un interruptor de hombre muerto para su cuenta, un corte duro que se dispara esté o no en su escritorio." },
    { type: "heading",text: "Cómo configurar un aplanado programado en Tradovate" },
    {
      type: "steps",
      items: [
        { title: "Abra el panel de saldo de su cuenta", html: "En la parte superior del Trader, justo al lado de su número de cuenta, verá el indicador <strong class='text-white'>Cash Balance / Unrealized P&amp;L</strong>. Haga clic en él. Se abre el menú a nivel de cuenta donde están los controles de aplanado. Tradovate ya ha cambiado antes la redacción de este panel, así que si las etiquetas se ven un poco distintas, busque el botón de capital de la cuenta / P&amp;L situado junto al nombre de su cuenta." },
        { title: "Elija Flatten Today", html: "En el menú desplegable, elija <strong class='text-white'>Flatten Today</strong>. Se abre una pequeña ventana emergente con los controles del temporizador. Es el mismo menú que usaría para aplanar todo ahora mismo; simplemente recurre a la versión programada." },
        { title: "Active el temporizador y establezca la hora del aplanado", html: "Active el aplanado programado e introduzca la hora a la que quiere todo cerrado, por ejemplo las 3:10 PM si quiere estar plano mucho antes del cierre de los índices bursátiles. Algo con lo que mucha gente tropieza: la hora corre según la <strong class='text-white'>zona horaria mostrada</strong> en la plataforma, así que compruebe si está viendo Eastern, Central o su configuración local antes de fijarla. Una hora introducida en la zona equivocada es la diferencia entre una salida limpia y una sorpresa desagradable." },
        { title: "Envíe y confirme que está armado", html: "Pulse <strong class='text-white'>Submit</strong>. El botón <strong class='text-white'>Flatten Today</strong> se vuelve <strong class='text-white'>verde</strong> para indicar que el temporizador está activo; <strong class='text-white'>rojo</strong> significa que está desactivado. Cuando llega la hora establecida, la plataforma cancela las órdenes y aplana las posiciones por sí sola, y luego se desactiva. Este último punto importa: es un ajuste de un solo día. No volverá a ejecutarse mañana a menos que lo configure de nuevo." },
      ],
    },
    { type: "heading",text: "Algunas cosas que conviene saber" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Se restablece cada día.</strong> No hay un interruptor integrado de «todos los días, para siempre»; una vez que se dispara, se apaga. Vuelva a armarlo cada sesión si quiere un corte diario.",
        "<strong class='text-white'>Se configura por cuenta.</strong> Usted arma Flatten Today desde el panel de saldo de una cuenta concreta, así que si opera más de una cuenta, configúrelo en cada una que quiera cubrir.",
        "<strong class='text-white'>Solo afecta a las posiciones abiertas.</strong> Los contratos en los que está plano no se ven afectados, y sus órdenes en reposo se quedan donde están.",
        "<strong class='text-white'>Los cortes de las prop firms varían.</strong> Si su firma prohíbe mantener posiciones durante el cierre o durante la noche, use la hora límite exigida como su hora de aplanado. Ese valor varía según la firma y el tamaño de la cuenta, así que consulte las reglas vigentes de su firma.",
      ],
    },
    { type: "heading",text: "Por qué molestarse con un aplanado programado" },
    { type: "paragraph",html: "Un corte duro y automático logra varias cosas que una nota mental no puede. Le mantiene fuera del margen nocturno más alto que se activa en el reinicio de sesión. Hace cumplir una regla de no mantener posiciones nocturnas sin que usted vigile el reloj. Y le protege los días en que se aleja del escritorio con tamaño abierto. Para quien opera una evaluación de fondeo con una hora límite estricta, es un seguro barato frente a un incumplimiento de las reglas." },
    { type: "heading",text: "¿Quiere una salida totalmente manos libres? Automatícela" },
    { type: "paragraph",html: "El aplanado programado es ideal para un corte diario fijo. Pero si quiere salidas guiadas por su estrategia, es decir, cerrar con una señal, invertir en un cruce o salirse en una vela de noticias, ahí entra PickMyTrade. Conecta sus alertas de TradingView directamente con su cuenta de Tradovate, de modo que una alerta de cierre o de inversión aplana la posición y limpia por sí sola las órdenes restantes. Configure el aplanado programado como su red de seguridad y deje que la automatización se encargue del resto." },
  ], fr: [
    { type: "paragraph",html: "Certains jours, vous êtes rivé aux graphiques. D'autres jours, une réunion vous happe, les enfants ont besoin de vous, ou vous vous éloignez simplement en oubliant que vous détenez encore deux contrats NQ jusqu'à la clôture. La clôture programmée de Tradovate règle cela. Définissez une heure et la plateforme annule vos ordres actifs et clôture chaque position ouverte à votre place, sans clic et sans chercher le bouton panique. Dans l'application, elle s'appelle <strong class='text-white'>Flatten Today</strong>. Voici comment l'armer." },
    { type: "heading",text: "Ce que fait réellement la clôture programmée" },
    { type: "paragraph",html: "<strong class='text-white'>Flatten Today</strong> est un planificateur à usage unique. Vous choisissez une heure pour la journée de trading en cours et, quand l'horloge de la plateforme l'atteint, tout contrat avec une position ouverte est clôturé au marché et chaque ordre actif ou suspendu qui lui est lié est annulé. Les ordres en attente sur des positions où vous êtes déjà à plat ne sont pas touchés. Voyez-y un interrupteur d'homme mort pour votre compte, une coupure nette qui se déclenche que vous soyez devant votre écran ou non." },
    { type: "heading",text: "Comment définir une clôture programmée dans Tradovate" },
    {
      type: "steps",
      items: [
        { title: "Ouvrez le panneau du solde de votre compte", html: "En haut du Trader, juste à côté de votre numéro de compte, vous verrez l'affichage <strong class='text-white'>Cash Balance / Unrealized P&amp;L</strong>. Cliquez dessus. Cela ouvre le menu au niveau du compte, où se trouvent les commandes de clôture. Tradovate a déjà modifié les libellés de ce panneau par le passé ; si les intitulés vous semblent un peu différents, cherchez simplement le bouton d'équité du compte / P&amp;L situé à côté du nom de votre compte." },
        { title: "Choisissez Flatten Today", html: "Dans le menu déroulant, choisissez <strong class='text-white'>Flatten Today</strong>. Une petite fenêtre s'ouvre avec les commandes du minuteur. C'est le même menu que vous utiliseriez pour tout clôturer immédiatement ; vous choisissez simplement la version programmée." },
        { title: "Activez le minuteur et définissez l'heure de clôture", html: "Activez la clôture programmée et saisissez l'heure à laquelle vous voulez que tout soit fermé, par exemple 15 h 10 (3:10 PM) si vous voulez être à plat bien avant la clôture des indices actions. Un point qui piège beaucoup de monde : l'heure suit le <strong class='text-white'>fuseau horaire affiché</strong> de la plateforme ; vérifiez donc si vous voyez Eastern, Central ou votre réglage local avant de la valider. Une heure saisie dans le mauvais fuseau fait la différence entre une sortie propre et une mauvaise surprise." },
        { title: "Validez et vérifiez que c'est armé", html: "Cliquez sur <strong class='text-white'>Submit</strong>. Le bouton <strong class='text-white'>Flatten Today</strong> devient <strong class='text-white'>vert</strong> pour indiquer que le minuteur est actif ; <strong class='text-white'>rouge</strong> signifie qu'il est désactivé. À l'heure définie, la plateforme annule les ordres et clôture les positions d'elle-même, puis se désactive. Ce dernier point est important : c'est un réglage valable pour une seule journée. Il ne se relancera pas demain à moins que vous ne le reconfiguriez." },
      ],
    },
    { type: "heading",text: "Quelques points à connaître" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Il se réinitialise chaque jour.</strong> Il n'existe pas de bascule intégrée « tous les jours, pour toujours » ; une fois déclenché, il s'éteint. Réarmez-le à chaque séance si vous voulez une coupure quotidienne.",
        "<strong class='text-white'>Il se règle par compte.</strong> Vous armez Flatten Today depuis le panneau de solde d'un compte précis ; si vous tradez plusieurs comptes, réglez-le sur chacun de ceux que vous voulez couvrir.",
        "<strong class='text-white'>Il ne touche que les positions ouvertes.</strong> Les contrats sur lesquels vous êtes à plat ne sont pas affectés, et leurs ordres en attente restent en place.",
        "<strong class='text-white'>Les heures limites des prop firms varient.</strong> Si votre firme interdit de conserver des positions à la clôture ou pendant la nuit, utilisez l'heure de mise à plat qu'elle exige comme heure de clôture. Ce chiffre varie selon la firme et la taille du compte ; vérifiez donc les règles actuelles de votre firme.",
      ],
    },
    { type: "heading",text: "Pourquoi s'embêter avec une clôture programmée" },
    { type: "paragraph",html: "Une coupure nette et automatique fait plusieurs choses qu'un simple pense-bête ne peut pas faire. Elle vous tient à l'écart de la marge nocturne plus élevée qui s'applique à la réinitialisation de la séance. Elle fait respecter une règle d'interdiction de positions nocturnes sans que vous surveilliez l'horloge. Et elle vous protège les jours où vous quittez votre poste avec de la taille ouverte. Pour qui trade une évaluation financée avec une heure de mise à plat stricte, c'est une assurance bon marché contre une violation des règles." },
    { type: "heading",text: "Vous voulez une sortie entièrement mains libres ? Automatisez-la" },
    { type: "paragraph",html: "La clôture programmée est parfaite pour une coupure quotidienne fixe. Mais si vous voulez des sorties pilotées par votre stratégie, clôturer sur un signal, inverser sur un croisement, sortir sur une bougie de news, c'est là que PickMyTrade intervient. Il relie vos alertes TradingView directement à votre compte Tradovate, de sorte qu'une alerte de clôture ou d'inversion met la position à plat et nettoie d'elle-même les ordres restants. Configurez la clôture programmée comme filet de sécurité et laissez l'automatisation s'occuper du reste." },
  ], it: [
    { type: "paragraph",html: "Ci sono giorni in cui è incollato ai grafici. Altri giorni viene assorbito da una riunione, i figli hanno bisogno di qualcosa, oppure si allontana e dimentica di avere ancora due contratti NQ aperti fino alla chiusura. La chiusura programmata di Tradovate risolve il problema. Imposti un orario e la piattaforma cancella i Suoi ordini attivi e chiude ogni posizione aperta al posto Suo, senza clic e senza correre al pulsante di emergenza. Nell'app si chiama <strong class='text-white'>Flatten Today</strong>. Ecco come armarla." },
    { type: "heading",text: "Che cosa fa davvero la chiusura programmata" },
    { type: "paragraph",html: "<strong class='text-white'>Flatten Today</strong> è uno scheduler a colpo singolo. Sceglie un orario per la giornata di trading corrente e, quando l'orologio della piattaforma lo raggiunge, ogni contratto con una posizione aperta viene chiuso a mercato e ogni ordine attivo o sospeso a esso collegato viene cancellato. Gli ordini in attesa su posizioni in cui è già flat non vengono toccati. La consideri un interruttore dell'uomo morto per il Suo conto, un taglio netto che scatta sia che Lei sia alla scrivania sia che non lo sia." },
    { type: "heading",text: "Come impostare una chiusura programmata in Tradovate" },
    {
      type: "steps",
      items: [
        { title: "Apra il pannello del saldo del conto", html: "In alto nel Trader, proprio accanto al numero del Suo conto, vedrà l'indicatore <strong class='text-white'>Cash Balance / Unrealized P&amp;L</strong>. Ci clicchi sopra. Si apre il menu a livello di conto in cui si trovano i controlli di chiusura. Tradovate ha già modificato in passato le diciture di questo pannello, quindi se le etichette Le sembrano leggermente diverse, cerchi semplicemente il pulsante del capitale del conto / P&amp;L accanto al nome del Suo conto." },
        { title: "Scelga Flatten Today", html: "Nel menu a discesa, scelga <strong class='text-white'>Flatten Today</strong>. Si apre un piccolo pop-up con i controlli del timer. È lo stesso menu che userebbe per chiudere tutto subito, solo che sceglie la versione programmata." },
        { title: "Attivi il timer e imposti l'orario di chiusura", html: "Attivi la chiusura programmata e inserisca l'orario in cui vuole che tutto sia chiuso, ad esempio le 3:10 PM se vuole essere flat ben prima della chiusura degli indici azionari. Un punto su cui molti inciampano: l'orario segue il <strong class='text-white'>fuso orario visualizzato</strong> dalla piattaforma, quindi verifichi se sta vedendo Eastern, Central o la Sua impostazione locale prima di confermare. Un orario inserito con il fuso sbagliato fa la differenza tra un'uscita pulita e una brutta sorpresa." },
        { title: "Invii e confermi che sia armata", html: "Clicchi su <strong class='text-white'>Submit</strong>. Il pulsante <strong class='text-white'>Flatten Today</strong> diventa <strong class='text-white'>verde</strong> per indicare che il timer è attivo; <strong class='text-white'>rosso</strong> significa che è disattivato. Quando arriva l'orario impostato, la piattaforma cancella gli ordini e chiude le posizioni da sola, poi si disattiva. Quest'ultimo punto è importante: è un'impostazione valida per un solo giorno. Non verrà eseguita di nuovo domani, a meno che non la imposti ancora." },
      ],
    },
    { type: "heading",text: "Alcune cose da sapere" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Si azzera ogni giorno.</strong> Non esiste un interruttore integrato «ogni giorno, per sempre»; una volta scattata, si spegne. La riarmi a ogni sessione se desidera un taglio giornaliero.",
        "<strong class='text-white'>Si imposta per conto.</strong> Arma Flatten Today dal pannello del saldo di uno specifico conto, quindi se opera su più conti, la imposti su ciascuno di quelli che vuole coprire.",
        "<strong class='text-white'>Tocca solo le posizioni aperte.</strong> I contratti in cui è flat non vengono influenzati e i loro ordini in attesa restano al loro posto.",
        "<strong class='text-white'>Gli orari limite delle prop firm variano.</strong> Se la Sua firm vieta di mantenere posizioni oltre la chiusura o durante la notte, usi l'orario di chiusura obbligatorio come orario di chiusura programmata. Quel valore varia in base alla firm e alla dimensione del conto, quindi controlli le regole attuali della Sua firm.",
      ],
    },
    { type: "heading",text: "Perché usare una chiusura programmata" },
    { type: "paragraph",html: "Un taglio netto e automatico fa alcune cose che un promemoria mentale non può fare. La tiene lontano dal margine notturno più elevato che scatta al reset della sessione. Fa rispettare una regola di divieto di posizioni notturne senza che debba controllare l'orologio. E La protegge nei giorni in cui si allontana dalla scrivania con posizioni aperte. Per chi opera una valutazione finanziata con un orario di chiusura rigoroso, è un'assicurazione economica contro la violazione delle regole." },
    { type: "heading",text: "Vuole un'uscita completamente senza mani? La automatizzi" },
    { type: "paragraph",html: "La chiusura programmata è ottima per un taglio giornaliero fisso. Ma se desidera uscite guidate dalla Sua strategia, chiudere su un segnale, invertire su un incrocio, uscire su una candela di notizie, è qui che entra in gioco PickMyTrade. Collega i Suoi alert di TradingView direttamente al Suo conto Tradovate, così un alert di chiusura o di inversione chiude la posizione e pulisce da solo gli ordini residui. Imposti la chiusura programmata come rete di sicurezza e lasci che l'automazione faccia il resto." },
  ] },
  ctaHeading: { en: "Let Automation Handle the Rest", de: "Überlassen Sie den Rest der Automatisierung", es: "Deje que la automatización se encargue del resto", fr: "Laissez l'automatisation s'occuper du reste", it: "Lasci che l'automazione faccia il resto" },
  ctaText: { en: "Set the timed flatten as your safety net, then let PickMyTrade wire your TradingView alerts straight to your Tradovate account for strategy-driven exits.", de: "Richten Sie das zeitgesteuerte Glätten als Sicherheitsnetz ein und lassen Sie dann PickMyTrade Ihre TradingView-Alerts direkt mit Ihrem Tradovate-Konto verbinden, für strategiegesteuerte Exits.", es: "Configure el aplanado programado como red de seguridad y deje que PickMyTrade conecte sus alertas de TradingView directamente con su cuenta de Tradovate para salidas guiadas por su estrategia.", fr: "Configurez la clôture programmée comme filet de sécurité, puis laissez PickMyTrade relier vos alertes TradingView directement à votre compte Tradovate pour des sorties pilotées par votre stratégie.", it: "Imposti la chiusura programmata come rete di sicurezza, poi lasci che PickMyTrade colleghi i Suoi alert di TradingView direttamente al Suo conto Tradovate per uscite guidate dalla strategia." },
  ctaButtonText: { en: "Start Your Free 7-Day Trial", de: "Starten Sie Ihre kostenlose 7-Tage-Testphase", es: "Comience su prueba gratuita de 7 días", fr: "Commencez votre essai gratuit de 7 jours", it: "Inizi la prova gratuita di 7 giorni" },
  ctaUrl: "https://app.pickmytrade.trade/?register=true&utm_source=content&utm_medium=how-to",
  faqHeading: { en: "Frequently Asked Questions", de: "Häufig gestellte Fragen", es: "Preguntas frecuentes", fr: "Questions fréquentes", it: "Domande frequenti" },
  faqs: { en: [
    { q: "Does Flatten Today run automatically every day?", a: "No. It's a one-time setting for the current trading day. Once it fires, or the day ends, it turns itself off, and you'll need to arm it again for the next session." },
    { q: "What time zone does the flatten time use?", a: "It follows the time zone your platform is set to display. Confirm whether that's Eastern, Central, or your local zone before you set the time, so the flatten fires when you actually mean it to." },
    { q: "Will the timed flatten cancel my stop loss and take profit?", a: "Yes. As it closes each open position, it also cancels the working orders tied to that contract, including resting stop-loss and take-profit orders, so you end up fully out of the market." },
  ], de: [
    { q: "Läuft Flatten Today jeden Tag automatisch?", a: "Nein. Es ist eine einmalige Einstellung für den aktuellen Handelstag. Sobald sie ausgelöst wurde oder der Tag endet, schaltet sie sich selbst ab, und Sie müssen sie für die nächste Session erneut aktivieren." },
    { q: "Welche Zeitzone gilt für die Flatten-Uhrzeit?", a: "Es gilt die Zeitzone, die in Ihrer Plattform angezeigt wird. Prüfen Sie, ob es Eastern, Central oder Ihre lokale Zone ist, bevor Sie die Uhrzeit festlegen, damit das Glätten genau dann auslöst, wann Sie es wirklich wollen." },
    { q: "Storniert das zeitgesteuerte Glätten meinen Stop-Loss und mein Take-Profit?", a: "Ja. Beim Schließen jeder offenen Position storniert es auch die aktiven Orders zu diesem Kontrakt, einschließlich ruhender Stop-Loss- und Take-Profit-Orders, sodass Sie am Ende vollständig aus dem Markt sind." },
  ], es: [
    { q: "¿Flatten Today se ejecuta automáticamente todos los días?", a: "No. Es un ajuste de una sola vez para el día de negociación actual. Cuando se dispara, o cuando termina el día, se desactiva solo, y deberá armarlo de nuevo para la siguiente sesión." },
    { q: "¿Qué zona horaria usa la hora del aplanado?", a: "Sigue la zona horaria que su plataforma está configurada para mostrar. Confirme si es Eastern, Central o su zona local antes de establecer la hora, para que el aplanado se dispare exactamente cuando usted quiere." },
    { q: "¿El aplanado programado cancelará mi stop loss y mi take profit?", a: "Sí. Al cerrar cada posición abierta, también cancela las órdenes activas asociadas a ese contrato, incluidas las órdenes de stop loss y take profit en reposo, de modo que queda completamente fuera del mercado." },
  ], fr: [
    { q: "Flatten Today s'exécute-t-il automatiquement chaque jour ?", a: "Non. C'est un réglage ponctuel pour la journée de trading en cours. Une fois déclenché, ou quand la journée se termine, il se désactive de lui-même et vous devrez le réarmer pour la séance suivante." },
    { q: "Quel fuseau horaire l'heure de clôture utilise-t-elle ?", a: "Elle suit le fuseau horaire que votre plateforme est configurée pour afficher. Vérifiez s'il s'agit d'Eastern, de Central ou de votre fuseau local avant de définir l'heure, afin que la clôture se déclenche exactement quand vous le souhaitez." },
    { q: "La clôture programmée annulera-t-elle mon stop loss et mon take profit ?", a: "Oui. En clôturant chaque position ouverte, elle annule aussi les ordres actifs liés à ce contrat, y compris les ordres de stop loss et de take profit en attente, de sorte que vous vous retrouvez entièrement hors du marché." },
  ], it: [
    { q: "Flatten Today si attiva automaticamente ogni giorno?", a: "No. È un'impostazione una tantum per la giornata di trading corrente. Una volta scattata, o al termine della giornata, si disattiva da sola e dovrà riarmarla per la sessione successiva." },
    { q: "Quale fuso orario usa l'orario di chiusura?", a: "Segue il fuso orario che la Sua piattaforma è impostata per visualizzare. Verifichi se è Eastern, Central o il Suo fuso locale prima di impostare l'orario, così la chiusura scatta esattamente quando intende Lei." },
    { q: "La chiusura programmata cancellerà il mio stop loss e il mio take profit?", a: "Sì. Mentre chiude ogni posizione aperta, cancella anche gli ordini attivi legati a quel contratto, compresi gli ordini di stop loss e take profit in attesa, così si ritrova completamente fuori dal mercato." },
  ] },
  relatedHeading: { en: "Related Guides", de: "Verwandte Anleitungen", es: "Guías relacionadas", fr: "Guides associés", it: "Guide correlate" },
