---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "tradovate-average-entry-price";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/how-to/${SLUG}`;

const META_TITLE = "How Tradovate Calculates Average Entry Price";
const META_DESCRIPTION =
  "See how the volume-weighted average entry price works in the Positions tab, and why it's the one number to trust when you scale into a trade.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "So berechnet Tradovate den durchschnittlichen Einstiegspreis", es: "Cómo calcula Tradovate el precio medio de entrada", fr: "Comment Tradovate calcule le prix d'entrée moyen", it: "Come Tradovate calcola il prezzo medio di ingresso" },
  dek: { en: "Buy the same contract at two different prices and Tradovate folds them into one number: the volume-weighted average entry price. Here's how that figure is built and exactly where to read it in the Positions module.", de: "Kaufen Sie denselben Kontrakt zu zwei verschiedenen Preisen, fasst Tradovate beides in einer Zahl zusammen: dem volumengewichteten durchschnittlichen Einstiegspreis. Hier erfahren Sie, wie dieser Wert entsteht und wo Sie ihn im Positions-Modul ablesen.", es: "Compre el mismo contrato a dos precios distintos y Tradovate los combina en un solo número: el precio medio de entrada ponderado por volumen. Aquí le explicamos cómo se calcula esa cifra y dónde leerla exactamente en el módulo Positions.", fr: "Achetez le même contrat à deux prix différents et Tradovate les fond en un seul chiffre : le prix d'entrée moyen pondéré par le volume. Voici comment ce chiffre est construit et où le lire exactement dans le module Positions.", it: "Acquisti lo stesso contratto a due prezzi diversi e Tradovate li fonde in un unico numero: il prezzo medio di ingresso ponderato per il volume. Ecco come si costruisce questa cifra e dove leggerla esattamente nel modulo Positions." },
  readTime: { en: "5 min read", de: "5 Min. Lesezeit", es: "Lectura de 5 min", fr: "Lecture : 5 min", it: "Lettura di 5 min" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "Buy the same contract at two different prices and Tradovate won't leave you staring at two separate trades. It folds them into one number: the volume-weighted average entry price. That figure sits in the Positions module, and it's the price your open profit and loss gets measured against. Once you know how it's built and where to read it, you'll always know exactly where your position stands." },
    { type: "heading", text: "What \"Average Price\" Really Means Here" },
    { type: "paragraph", html: "The word \"average\" trips people up. Tradovate doesn't take a simple midpoint of your fill prices. It weights each fill by its size, so the more contracts you add at a given price, the harder that price pulls on the average. Two fills of one contract each land you dead in the middle. A big fill and a small fill land you closer to the big one." },
    { type: "paragraph", html: "Here's a quick worked example on ES:" },
    {
      type: "table",
      headers: ["Action", "Contracts", "Fill price"],
      rows: [
        ["Buy", "2", "5200.00"],
        ["Buy", "1", "5190.00"],
        ["Net position", "3 long", "5196.67 avg"],
      ],
    },
    { type: "paragraph", html: "The math is straightforward: multiply each fill by its size, add them up, then divide by total contracts. So (2 × 5200) + (1 × 5190) = 15,590, divided by 3 contracts = 5196.67. If both fills had been a single contract, the average would sit at exactly 5195. Because the first fill carried twice the size, the average leans toward 5200. Every new fill fires an instant recalculation, whether you're scaling into a winner or averaging down a loser." },
    { type: "heading", text: "How to Check Your Average Entry Price in Tradovate: Step-by-Step" },
    {
      type: "steps",
      items: [
        { title: "Open the Positions Module", html: "From the left sidebar in the web or desktop platform, click Positions. This module lists every open position, one row each, and it's where your average price lives." },
        { title: "Find the Average Price Column", html: "Scan the row for the column that shows your average entry, usually labeled Avg Price. No matter how many fills built the position, you'll see a single blended figure, not a stack of individual prices." },
        { title: "Read Your Net Size and Open P/L Beside It", html: "The quantity column shows your net contracts: a positive number means you're long, a negative number means you're short, and zero means you're flat. Right next to it, open P/L updates tick by tick, measuring the current market price against that average. If the average looks off, this is where you'll spot it first." },
        { title: "Add the Column If You Don't See It", html: "If the average price isn't showing, open the module's View Settings gear at the top right, pick Select Columns, and drag the average price field from the available list into the visible list. It'll stick for that workspace." },
        { title: "Treat This Number as Your Source of Truth", html: "When you close out and go flat, the row clears and your average resets for the next trade. Until then, the Positions row is the cleanest read on where you actually got in." },
      ],
    },
    { type: "heading", text: "Why the Positions Tab Beats the Chart" },
    { type: "paragraph", html: "Your chart is honest but noisy. Scale into a position and it drops a marker at every fill, so you end up eyeballing three or four entry lines and guessing your true cost. The Positions module has already done the weighted math for you. When the two disagree, the Positions tab wins, and it's also where you'll flatten the position or cancel working orders when you're done." },
    { type: "paragraph", html: "That average is more than a reference price. It's the anchor for the open P/L your risk rules watch. If you're on a prop or evaluation account, drawdown and loss-limit thresholds are enforced against that live number, and those thresholds vary by firm and account size, so check your firm's current rules before you lean on a scale-in strategy. For a full history of what actually filled, pull your account and performance reports, and if your exported numbers ever look off, it's usually a gross-versus-net P&L gap rather than a bad average." },
    { type: "heading", text: "Automate This with PickMyTrade" },
    { type: "paragraph", html: "Trading the same setups by hand every session? <strong class='text-white'>Automate your Tradovate entries and exits with PickMyTrade</strong> and let your TradingView signals scale in and out for you, with your average price handled automatically." },
  ], de: [
    { type: "paragraph",html: "Kaufen Sie denselben Kontrakt zu zwei verschiedenen Preisen, zeigt Tradovate Ihnen nicht zwei getrennte Trades an. Beide werden zu einer Zahl zusammengefasst: dem volumengewichteten durchschnittlichen Einstiegspreis. Dieser Wert steht im Positions-Modul und ist der Preis, an dem Ihr offener Gewinn und Verlust gemessen wird. Wenn Sie wissen, wie er entsteht und wo Sie ihn ablesen, wissen Sie jederzeit genau, wo Ihre Position steht." },
    { type: "heading",text: "Was „Average Price“ hier wirklich bedeutet" },
    { type: "paragraph",html: "Das Wort „Durchschnitt“ führt oft in die Irre. Tradovate bildet nicht einfach den Mittelwert Ihrer Ausführungspreise. Jede Ausführung wird nach ihrer Größe gewichtet: Je mehr Kontrakte Sie zu einem bestimmten Preis hinzufügen, desto stärker zieht dieser Preis den Durchschnitt. Zwei Ausführungen mit je einem Kontrakt landen genau in der Mitte. Eine große und eine kleine Ausführung liegen näher an der großen." },
    { type: "paragraph",html: "Hier ein kurzes Rechenbeispiel mit ES:" },
    { type: "table", headers: ["Aktion","Kontrakte","Ausführungspreis"], rows: [
      ["Kauf","2","5200.00"],
      ["Kauf","1","5190.00"],
      ["Nettoposition","3 Long","5196.67 Durchschnitt"],
    ] },
    { type: "paragraph",html: "Die Rechnung ist einfach: Multiplizieren Sie jede Ausführung mit ihrer Größe, addieren Sie die Ergebnisse und teilen Sie durch die Gesamtzahl der Kontrakte. Also (2 × 5200) + (1 × 5190) = 15,590, geteilt durch 3 Kontrakte = 5196.67. Wären beide Ausführungen je ein Kontrakt gewesen, läge der Durchschnitt genau bei 5195. Da die erste Ausführung doppelt so groß war, neigt sich der Durchschnitt in Richtung 5200. Jede neue Ausführung löst sofort eine Neuberechnung aus, egal ob Sie in einen Gewinner nachlegen oder einen Verlierer nachkaufen." },
    { type: "heading",text: "So prüfen Sie Ihren durchschnittlichen Einstiegspreis in Tradovate: Schritt für Schritt" },
    {
      type: "steps",
      items: [
        { title: "Positions-Modul öffnen", html: "Klicken Sie in der Seitenleiste links der Web- oder Desktop-Plattform auf Positions. Dieses Modul listet jede offene Position in einer eigenen Zeile auf, und hier steht Ihr Durchschnittspreis." },
        { title: "Die Spalte „Average Price“ finden", html: "Suchen Sie in der Zeile die Spalte, die Ihren durchschnittlichen Einstieg zeigt, meist mit Avg Price beschriftet. Egal, wie viele Ausführungen die Position aufgebaut haben, Sie sehen einen einzigen gemischten Wert statt vieler Einzelpreise." },
        { title: "Nettogröße und offenen G/V daneben ablesen", html: "Die Mengenspalte zeigt Ihre Netto-Kontrakte: Eine positive Zahl bedeutet Long, eine negative Short und null bedeutet flat. Direkt daneben wird der offene P/L Tick für Tick aktualisiert und misst den aktuellen Marktpreis gegen diesen Durchschnitt. Wirkt der Durchschnitt falsch, fällt es Ihnen hier zuerst auf." },
        { title: "Spalte hinzufügen, falls sie fehlt", html: "Wird der Durchschnittspreis nicht angezeigt, öffnen Sie oben rechts im Modul das Zahnrad View Settings, wählen Sie Select Columns und ziehen Sie das Feld für den Durchschnittspreis aus der Liste der verfügbaren Spalten in die Liste der sichtbaren. Die Einstellung bleibt für diesen Workspace erhalten." },
        { title: "Diese Zahl als Ihre maßgebliche Quelle behandeln", html: "Wenn Sie die Position schließen und flat sind, wird die Zeile geleert und Ihr Durchschnitt für den nächsten Trade zurückgesetzt. Bis dahin ist die Zeile im Positions-Modul die sauberste Angabe dazu, wo Sie tatsächlich eingestiegen sind." },
      ],
    },
    { type: "heading",text: "Warum der Positions-Tab dem Chart überlegen ist" },
    { type: "paragraph",html: "Ihr Chart ist ehrlich, aber unübersichtlich. Wenn Sie in eine Position hinein skalieren, setzt er bei jeder Ausführung eine Markierung, und Sie schätzen am Ende drei oder vier Einstiegslinien, um Ihre wahren Kosten zu erraten. Das Positions-Modul hat die gewichtete Rechnung bereits für Sie erledigt. Wenn beide voneinander abweichen, gilt der Positions-Tab. Dort schließen Sie auch die Position oder stornieren offene Orders, wenn Sie fertig sind." },
    { type: "paragraph",html: "Dieser Durchschnitt ist mehr als ein Referenzpreis. Er ist der Anker für den offenen P/L, den Ihre Risikoregeln überwachen. Bei einem Prop- oder Evaluierungskonto werden Drawdown- und Verlustgrenzen gegen diesen Live-Wert durchgesetzt. Diese Grenzen variieren je nach Firma und Kontogröße, prüfen Sie daher die aktuellen Regeln Ihrer Firma, bevor Sie sich auf eine Scale-in-Strategie verlassen. Eine vollständige Historie dessen, was tatsächlich ausgeführt wurde, erhalten Sie über Ihre Konto- und Performance-Berichte. Wirken exportierte Zahlen einmal falsch, liegt es meist an einer Differenz zwischen Brutto- und Netto-G/V und nicht an einem falschen Durchschnitt." },
    { type: "heading",text: "Automatisieren Sie das mit PickMyTrade" },
    { type: "paragraph",html: "Handeln Sie jede Sitzung dieselben Setups von Hand? <strong class='text-white'>Automatisieren Sie Ihre Tradovate-Einstiege und -Ausstiege mit PickMyTrade</strong> und lassen Sie Ihre TradingView-Signale für Sie auf- und abbauen, wobei Ihr Durchschnittspreis automatisch berücksichtigt wird." },
  ], es: [
    { type: "paragraph",html: "Compre el mismo contrato a dos precios distintos y Tradovate no le mostrará dos operaciones separadas. Las combina en un solo número: el precio medio de entrada ponderado por volumen. Esa cifra aparece en el módulo Positions y es el precio frente al cual se mide su ganancia y pérdida abierta. Cuando sepa cómo se calcula y dónde leerla, siempre sabrá exactamente en qué punto se encuentra su posición." },
    { type: "heading",text: "Qué significa realmente «Average Price» aquí" },
    { type: "paragraph",html: "La palabra «promedio» suele confundir. Tradovate no toma un simple punto medio de sus precios de ejecución. Pondera cada ejecución por su tamaño, de modo que cuantos más contratos añada a un precio determinado, más tira ese precio del promedio. Dos ejecuciones de un contrato cada una lo dejan justo en el medio. Una ejecución grande y una pequeña lo acercan más a la grande." },
    { type: "paragraph",html: "Aquí tiene un breve ejemplo práctico con ES:" },
    { type: "table", headers: ["Acción","Contratos","Precio de ejecución"], rows: [
      ["Compra","2","5200.00"],
      ["Compra","1","5190.00"],
      ["Posición neta","3 largos","5196.67 de media"],
    ] },
    { type: "paragraph",html: "La cuenta es sencilla: multiplique cada ejecución por su tamaño, sume los resultados y divida entre el total de contratos. Así, (2 × 5200) + (1 × 5190) = 15,590, dividido entre 3 contratos = 5196.67. Si ambas ejecuciones hubieran sido de un solo contrato, el promedio estaría exactamente en 5195. Como la primera ejecución tenía el doble de tamaño, el promedio se inclina hacia 5200. Cada nueva ejecución dispara un recálculo instantáneo, ya sea que aumente una posición ganadora o promedie a la baja una perdedora." },
    { type: "heading",text: "Cómo comprobar su precio medio de entrada en Tradovate: paso a paso" },
    {
      type: "steps",
      items: [
        { title: "Abra el módulo Positions", html: "En la barra lateral izquierda de la plataforma web o de escritorio, haga clic en Positions. Este módulo enumera cada posición abierta, una fila por posición, y es donde se encuentra su precio medio." },
        { title: "Localice la columna Average Price", html: "Busque en la fila la columna que muestra su entrada media, normalmente rotulada Avg Price. Sin importar cuántas ejecuciones formaron la posición, verá una única cifra combinada, no una pila de precios individuales." },
        { title: "Lea a su lado el tamaño neto y el P/L abierto", html: "La columna de cantidad muestra sus contratos netos: un número positivo significa que está largo, uno negativo que está corto y cero que está fuera del mercado. Justo al lado, el P/L abierto se actualiza tick a tick, midiendo el precio actual de mercado frente a ese promedio. Si el promedio parece incorrecto, aquí es donde lo notará primero." },
        { title: "Añada la columna si no la ve", html: "Si el precio medio no aparece, abra el engranaje View Settings en la parte superior derecha del módulo, elija Select Columns y arrastre el campo del precio medio de la lista disponible a la lista visible. Se mantendrá en ese espacio de trabajo." },
        { title: "Trate este número como su fuente de verdad", html: "Cuando cierre y quede fuera del mercado, la fila se borra y su promedio se reinicia para la siguiente operación. Hasta entonces, la fila de Positions es la lectura más limpia de dónde entró realmente." },
      ],
    },
    { type: "heading",text: "Por qué la pestaña Positions supera al gráfico" },
    { type: "paragraph",html: "Su gráfico es honesto, pero ruidoso. Si escala una posición, coloca un marcador en cada ejecución y acaba calculando a ojo tres o cuatro líneas de entrada para adivinar su coste real. El módulo Positions ya ha hecho el cálculo ponderado por usted. Cuando ambos discrepan, gana la pestaña Positions, que además es donde cerrará la posición o cancelará órdenes pendientes cuando termine." },
    { type: "paragraph",html: "Ese promedio es más que un precio de referencia. Es el ancla del P/L abierto que vigilan sus reglas de riesgo. Si opera en una cuenta prop o de evaluación, los umbrales de drawdown y de límite de pérdida se aplican sobre ese número en vivo, y dichos umbrales varían según la firma y el tamaño de la cuenta, así que consulte las reglas vigentes de su firma antes de apoyarse en una estrategia de escalado. Para ver el historial completo de lo que realmente se ejecutó, obtenga los informes de su cuenta y de rendimiento; y si sus cifras exportadas parecen incorrectas, normalmente se debe a una diferencia entre P&L bruto y neto, no a un promedio erróneo." },
    { type: "heading",text: "Automatice esto con PickMyTrade" },
    { type: "paragraph",html: "¿Opera a mano los mismos setups en cada sesión? <strong class='text-white'>Automatice sus entradas y salidas en Tradovate con PickMyTrade</strong> y deje que sus señales de TradingView escalen posiciones al alza y a la baja por usted, con su precio medio gestionado automáticamente." },
  ], fr: [
    { type: "paragraph",html: "Achetez le même contrat à deux prix différents et Tradovate ne vous laisse pas face à deux trades séparés. Il les fond en un seul chiffre : le prix d'entrée moyen pondéré par le volume. Ce chiffre se trouve dans le module Positions et c'est le prix par rapport auquel votre profit et perte ouvert est mesuré. Une fois que vous savez comment il est construit et où le lire, vous savez toujours exactement où en est votre position." },
    { type: "heading",text: "Ce que signifie vraiment « Average Price » ici" },
    { type: "paragraph",html: "Le mot « moyenne » prête à confusion. Tradovate ne prend pas un simple point médian de vos prix d'exécution. Il pondère chaque exécution par sa taille : plus vous ajoutez de contrats à un prix donné, plus ce prix tire la moyenne. Deux exécutions d'un contrat chacune vous placent pile au milieu. Une grosse et une petite exécution vous rapprochent de la grosse." },
    { type: "paragraph",html: "Voici un exemple chiffré rapide sur ES :" },
    { type: "table", headers: ["Action","Contrats","Prix d'exécution"], rows: [
      ["Achat","2","5200.00"],
      ["Achat","1","5190.00"],
      ["Position nette","3 long","5196.67 en moyenne"],
    ] },
    { type: "paragraph",html: "Le calcul est simple : multipliez chaque exécution par sa taille, additionnez les résultats, puis divisez par le total de contrats. Ainsi (2 × 5200) + (1 × 5190) = 15,590, divisé par 3 contrats = 5196.67. Si les deux exécutions avaient été d'un seul contrat, la moyenne se situerait exactement à 5195. Comme la première exécution était deux fois plus grosse, la moyenne penche vers 5200. Chaque nouvelle exécution déclenche un recalcul instantané, que vous renforciez un trade gagnant ou moyenniez à la baisse un trade perdant." },
    { type: "heading",text: "Comment vérifier votre prix d'entrée moyen dans Tradovate : pas à pas" },
    {
      type: "steps",
      items: [
        { title: "Ouvrez le module Positions", html: "Dans la barre latérale gauche de la plateforme web ou de bureau, cliquez sur Positions. Ce module liste chaque position ouverte, une ligne chacune, et c'est là que se trouve votre prix moyen." },
        { title: "Repérez la colonne Average Price", html: "Parcourez la ligne à la recherche de la colonne qui affiche votre entrée moyenne, généralement intitulée Avg Price. Quel que soit le nombre d'exécutions ayant construit la position, vous voyez un seul chiffre combiné, pas une pile de prix individuels." },
        { title: "Lisez à côté la taille nette et le P/L ouvert", html: "La colonne de quantité affiche vos contrats nets : un nombre positif signifie que vous êtes long, un nombre négatif que vous êtes short, et zéro que vous êtes à plat. Juste à côté, le P/L ouvert se met à jour tick par tick, en mesurant le prix de marché actuel par rapport à cette moyenne. Si la moyenne semble erronée, c'est ici que vous le remarquerez en premier." },
        { title: "Ajoutez la colonne si vous ne la voyez pas", html: "Si le prix moyen ne s'affiche pas, ouvrez l'engrenage View Settings en haut à droite du module, choisissez Select Columns et faites glisser le champ du prix moyen de la liste disponible vers la liste visible. Le réglage sera conservé pour cet espace de travail." },
        { title: "Considérez ce chiffre comme votre source de vérité", html: "Lorsque vous clôturez et revenez à plat, la ligne s'efface et votre moyenne est réinitialisée pour le trade suivant. D'ici là, la ligne de Positions est la lecture la plus claire de l'endroit où vous êtes réellement entré." },
      ],
    },
    { type: "heading",text: "Pourquoi l'onglet Positions l'emporte sur le graphique" },
    { type: "paragraph",html: "Votre graphique est honnête, mais bruyant. Si vous renforcez une position, il dépose un marqueur à chaque exécution et vous finissez par estimer à l'œil trois ou quatre lignes d'entrée pour deviner votre coût réel. Le module Positions a déjà fait le calcul pondéré pour vous. Lorsque les deux divergent, l'onglet Positions l'emporte, et c'est aussi là que vous clôturerez la position ou annulerez les ordres en attente une fois terminé." },
    { type: "paragraph",html: "Cette moyenne est bien plus qu'un prix de référence. C'est l'ancrage du P/L ouvert que surveillent vos règles de risque. Si vous êtes sur un compte prop ou d'évaluation, les seuils de drawdown et de limite de perte sont appliqués par rapport à ce chiffre en direct, et ces seuils varient selon la firme et la taille du compte ; vérifiez donc les règles actuelles de votre firme avant de vous appuyer sur une stratégie de renforcement. Pour un historique complet de ce qui a réellement été exécuté, consultez vos rapports de compte et de performance ; et si vos chiffres exportés semblent erronés, il s'agit généralement d'un écart entre P&L brut et net plutôt que d'une mauvaise moyenne." },
    { type: "heading",text: "Automatisez cela avec PickMyTrade" },
    { type: "paragraph",html: "Vous tradez les mêmes setups à la main à chaque session ? <strong class='text-white'>Automatisez vos entrées et sorties Tradovate avec PickMyTrade</strong> et laissez vos signaux TradingView renforcer et alléger vos positions pour vous, avec votre prix moyen géré automatiquement." },
  ], it: [
    { type: "paragraph",html: "Acquisti lo stesso contratto a due prezzi diversi e Tradovate non Le mostrerà due operazioni separate. Le fonde in un unico numero: il prezzo medio di ingresso ponderato per il volume. Questa cifra si trova nel modulo Positions ed è il prezzo rispetto al quale viene misurato il suo profitto e la sua perdita aperti. Una volta che sa come viene costruito e dove leggerlo, saprà sempre esattamente a che punto è la sua posizione." },
    { type: "heading",text: "Cosa significa davvero «Average Price» qui" },
    { type: "paragraph",html: "La parola «media» può trarre in inganno. Tradovate non calcola un semplice punto medio dei suoi prezzi di esecuzione. Pesa ogni esecuzione in base alla sua dimensione: più contratti aggiunge a un dato prezzo, più quel prezzo tira la media. Due esecuzioni da un contratto ciascuna la portano esattamente a metà. Un'esecuzione grande e una piccola la avvicinano a quella grande." },
    { type: "paragraph",html: "Ecco un rapido esempio pratico su ES:" },
    { type: "table", headers: ["Azione","Contratti","Prezzo di esecuzione"], rows: [
      ["Acquisto","2","5200.00"],
      ["Acquisto","1","5190.00"],
      ["Posizione netta","3 long","5196.67 di media"],
    ] },
    { type: "paragraph",html: "Il calcolo è semplice: moltiplichi ogni esecuzione per la sua dimensione, sommi i risultati e divida per il totale dei contratti. Quindi (2 × 5200) + (1 × 5190) = 15,590, diviso 3 contratti = 5196.67. Se entrambe le esecuzioni fossero state da un solo contratto, la media si troverebbe esattamente a 5195. Poiché la prima esecuzione aveva dimensione doppia, la media tende verso 5200. Ogni nuova esecuzione provoca un ricalcolo immediato, sia che stia aumentando una posizione vincente sia che stia mediando al ribasso una perdente." },
    { type: "heading",text: "Come verificare il prezzo medio di ingresso in Tradovate: passo dopo passo" },
    {
      type: "steps",
      items: [
        { title: "Apra il modulo Positions", html: "Dalla barra laterale sinistra della piattaforma web o desktop, faccia clic su Positions. Questo modulo elenca ogni posizione aperta, una riga ciascuna, ed è qui che si trova il suo prezzo medio." },
        { title: "Trovi la colonna Average Price", html: "Scorra la riga per trovare la colonna che mostra il suo ingresso medio, di solito etichettata Avg Price. Indipendentemente da quante esecuzioni abbiano costruito la posizione, vedrà un'unica cifra combinata, non una pila di prezzi singoli." },
        { title: "Legga accanto la dimensione netta e il P/L aperto", html: "La colonna della quantità mostra i suoi contratti netti: un numero positivo significa che è long, un numero negativo che è short e zero che è flat. Subito accanto, il P/L aperto si aggiorna tick dopo tick, misurando il prezzo di mercato corrente rispetto a quella media. Se la media sembra sbagliata, è qui che lo noterà per primo." },
        { title: "Aggiunga la colonna se non la vede", html: "Se il prezzo medio non è visibile, apra l'ingranaggio View Settings in alto a destra del modulo, scelga Select Columns e trascini il campo del prezzo medio dall'elenco disponibile all'elenco visibile. Rimarrà per quello spazio di lavoro." },
        { title: "Consideri questo numero la sua fonte di verità", html: "Quando chiude e torna flat, la riga si svuota e la media viene azzerata per l'operazione successiva. Fino ad allora, la riga di Positions è la lettura più pulita di dove è effettivamente entrato." },
      ],
    },
    { type: "heading",text: "Perché la scheda Positions batte il grafico" },
    { type: "paragraph",html: "Il suo grafico è onesto, ma rumoroso. Se scala in una posizione, inserisce un marcatore a ogni esecuzione e finisce per stimare a occhio tre o quattro linee di ingresso per indovinare il suo costo reale. Il modulo Positions ha già fatto il calcolo ponderato per Lei. Quando i due divergono, vince la scheda Positions, ed è anche lì che chiuderà la posizione o annullerà gli ordini in attesa quando ha finito." },
    { type: "paragraph",html: "Quella media è più di un prezzo di riferimento. È l'àncora del P/L aperto che le sue regole di rischio monitorano. Se opera su un conto prop o di valutazione, le soglie di drawdown e di limite di perdita vengono applicate rispetto a quel numero in tempo reale, e tali soglie variano in base alla società e alla dimensione del conto, quindi verifichi le regole attuali della sua società prima di affidarsi a una strategia di scalatura. Per uno storico completo di ciò che è stato effettivamente eseguito, consulti i report del conto e delle performance; e se i numeri esportati sembrano sbagliati, di solito si tratta di una differenza tra P&L lordo e netto, non di una media errata." },
    { type: "heading",text: "Automatizzi tutto questo con PickMyTrade" },
    { type: "paragraph",html: "Opera a mano gli stessi setup a ogni sessione? <strong class='text-white'>Automatizzi gli ingressi e le uscite su Tradovate con PickMyTrade</strong> e lasci che i suoi segnali TradingView aumentino e riducano le posizioni per Lei, con il prezzo medio gestito automaticamente." },
  ] },
  ctaHeading: { en: "Let Your Signals Scale In For You", de: "Lassen Sie Ihre Signale für Sie skalieren", es: "Deje que sus señales escalen por usted", fr: "Laissez vos signaux monter en position pour vous", it: "Lasci che i suoi segnali scalino per Lei" },
