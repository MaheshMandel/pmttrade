---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "tradovate-approve-device";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/how-to/${SLUG}`;

const META_TITLE = "Approve a New Device Login in Tradovate";
const META_DESCRIPTION =
  "Locked out on a new computer? Approve a new device login through the emailed approval, clear the new-machine 2FA error, and manage your trusted devices.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Neues Geräte-Login in Tradovate genehmigen", es: "Aprobar el inicio de sesión de un dispositivo nuevo en Tradovate", fr: "Approuver la connexion d'un nouvel appareil dans Tradovate", it: "Approvare l'accesso di un nuovo dispositivo in Tradovate" },
  dek: { en: "Signed in on a new laptop, phone, or browser and got blocked? Here's exactly how to approve the device from the emailed approval and get back to trading.", de: "Auf einem neuen Laptop, Smartphone oder Browser angemeldet und blockiert worden? So genehmigen Sie das Gerät über die Genehmigungs-E-Mail und kommen zurück zum Trading.", es: "¿Ha iniciado sesión en un portátil, teléfono o navegador nuevo y lo han bloqueado? Así se aprueba el dispositivo desde el correo de aprobación para volver a operar.", fr: "Connecté depuis un nouvel ordinateur portable, téléphone ou navigateur et bloqué ? Voici exactement comment approuver l'appareil à partir de l'e-mail d'approbation pour reprendre le trading.", it: "Ha effettuato l'accesso da un nuovo laptop, telefono o browser ed è stato bloccato? Ecco esattamente come approvare il dispositivo dall'e-mail di approvazione e tornare a fare trading." },
  readTime: { en: "5 min read", de: "5 Min. Lesezeit", es: "Lectura de 5 min", fr: "Lecture : 5 min", it: "Lettura di 5 min" },
  lastUpdated: "2026-07-10",
  blocks: { en: [
    { type: "paragraph", html: "Signed in on a new laptop, phone, or browser and got blocked? That's Tradovate's device check doing its job. When two-factor authentication is on, a login from a machine it doesn't recognize won't go through until you approve that device from an email. Here's exactly how to clear it and get back to trading." },
    { type: "heading", text: "Why Tradovate Asks You to Approve a Device" },
    { type: "paragraph", html: "With 2FA enabled, Tradovate ties your account to the specific devices you use. Sign in from a new one and it fires off an approval email (and often a push notification) before it lets that machine in. On a live account this is strict: until you approve the device, the login is denied and orders won't route. You might see a message like <strong class='text-white'>\"You have 2FA enabled and log in from a new machine\"</strong> on TradingView, or a plain <strong class='text-white'>\"access is denied\"</strong> through the API. Simulated and demo accounts don't enforce the check the same way, which is why the same credentials can work in one place and stall in another." },
    { type: "heading", text: "Approve a New Device in Tradovate: Step-by-Step" },
    {
      type: "steps",
      items: [
        { title: "Open the Device-Approval Email", html: "Check the inbox for the email address tied to your Tradovate account. Right after the blocked login, Tradovate sends a device-login notification that names your username and the new device that tried to sign in. If nothing's in the inbox, look in spam and promotions folders before you assume it didn't send." },
        { title: "Click Approve", html: "The email gives you two choices: <strong class='text-white'>Approve</strong> and <strong class='text-white'>Deny</strong>. Click <strong class='text-white'>Approve</strong> to trust the device. That's the whole action for the person at the keyboard, so read the device and location details first and only approve a login you recognize as your own. If you didn't start it, hit <strong class='text-white'>Deny</strong> and change your password." },
        { title: "Log Back In From the New Device", html: "Approving the device doesn't always drop you straight into the platform, so go back to the new computer or browser and sign in again. This time the login clears, and order entry, charts, and any connected platform like TradingView start working normally. If you were mid-setup on an automation tool, reconnect it now that the device is trusted." },
        { title: "Confirm the Device in My Devices", html: "Want to see what's trusted? In the Tradovate web trader, open <strong class='text-white'>Application Settings</strong> and go to <strong class='text-white'>My Devices</strong>. You'll get a list of everything that's touched your account, with columns for the device, IP address, last location, and last login time. A device you just approved shows a <strong class='text-white'>Remove Access</strong> option; one that's still waiting shows <strong class='text-white'>Pending</strong> next to a <strong class='text-white'>Forget</strong> option." },
      ],
    },
    {
      type: "table",
      headers: ["Status in My Devices", "What it means", "Your option"],
      rows: [
        ["Approved", "You confirmed this device and it can log in.", "Remove Access"],
        ["Pending", "It tried to sign in but hasn't been approved yet.", "Forget"],
      ],
    },
    { type: "heading", text: "Didn't Get the Approval Email?" },
    { type: "paragraph", html: "No email, no login, no fun. Work through these before you write it off:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Check spam and promotions.</strong> The notification often lands outside the main inbox.",
        "<strong class='text-white'>Confirm the email on file.</strong> Approvals go to the address attached to the account. On a prop or funded account, that may be the email your firm registered, not your personal one.",
        "<strong class='text-white'>Use Forget to resend.</strong> In <strong class='text-white'>My Devices</strong>, clicking <strong class='text-white'>Forget</strong> on the pending device triggers a fresh Approve/Deny email the next time that machine tries to log in.",
        "<strong class='text-white'>Watch for a push notification.</strong> If you're signed in on the mobile app, the new-device prompt can show up there too.",
        "<strong class='text-white'>Still nothing?</strong> Contact Tradovate support (or your prop firm, if it's a funded account) to confirm the device and check your notification settings.",
      ],
    },
    { type: "heading", text: "Fewer Logins to Babysit with PickMyTrade" },
    { type: "paragraph", html: "Every new machine you sign in on is one more device to approve. When PickMyTrade runs your strategy, your TradingView alerts route to Tradovate through a single connection, so you're not logging your live account in and out across a stack of devices just to keep a strategy running. You approve one setup, and the trades fire on their own." },
  ], de: [
    { type: "paragraph",html: "Auf einem neuen Laptop, Smartphone oder Browser angemeldet und blockiert worden? Das ist die Geräteprüfung von Tradovate bei der Arbeit. Ist die Zwei-Faktor-Authentifizierung aktiv, wird ein Login von einem unbekannten Rechner erst durchgelassen, wenn Sie das Gerät per E-Mail genehmigen. So beheben Sie das genau und kommen zurück zum Trading." },
    { type: "heading",text: "Warum Tradovate die Genehmigung eines Geräts verlangt" },
    { type: "paragraph",html: "Bei aktivierter 2FA bindet Tradovate Ihr Konto an die konkreten Geräte, die Sie nutzen. Melden Sie sich von einem neuen an, sendet es eine Genehmigungs-E-Mail (und oft eine Push-Benachrichtigung), bevor es diesen Rechner zulässt. Auf einem Live-Konto ist das strikt: Solange Sie das Gerät nicht genehmigen, wird der Login abgelehnt und Orders werden nicht geroutet. Möglicherweise sehen Sie in TradingView eine Meldung wie <strong class='text-white'>„You have 2FA enabled and log in from a new machine“</strong> oder über die API ein schlichtes <strong class='text-white'>„access is denied“</strong>. Simulations- und Demo-Konten erzwingen die Prüfung nicht in gleicher Weise, weshalb dieselben Zugangsdaten an einer Stelle funktionieren und an einer anderen hängen bleiben können." },
    { type: "heading",text: "Neues Gerät in Tradovate genehmigen: Schritt für Schritt" },
    {
      type: "steps",
      items: [
        { title: "Die Geräte-Genehmigungs-E-Mail öffnen", html: "Prüfen Sie den Posteingang der E-Mail-Adresse, die mit Ihrem Tradovate-Konto verknüpft ist. Direkt nach dem blockierten Login sendet Tradovate eine Benachrichtigung zum Geräte-Login, die Ihren Benutzernamen und das neue Gerät nennt, das sich anmelden wollte. Ist nichts im Posteingang, sehen Sie in den Spam- und Werbungs-Ordnern nach, bevor Sie annehmen, dass nichts gesendet wurde." },
        { title: "Auf „Approve“ klicken", html: "Die E-Mail bietet zwei Optionen: <strong class='text-white'>Approve</strong> und <strong class='text-white'>Deny</strong>. Klicken Sie auf <strong class='text-white'>Approve</strong>, um dem Gerät zu vertrauen. Das ist die ganze Aktion für die Person an der Tastatur. Lesen Sie daher zuerst die Geräte- und Standortangaben und genehmigen Sie nur einen Login, den Sie als Ihren eigenen erkennen. Haben Sie ihn nicht ausgelöst, klicken Sie auf <strong class='text-white'>Deny</strong> und ändern Sie Ihr Passwort." },
        { title: "Vom neuen Gerät aus erneut anmelden", html: "Die Genehmigung des Geräts führt Sie nicht immer direkt in die Plattform. Gehen Sie daher zurück zum neuen Computer oder Browser und melden Sie sich erneut an. Diesmal wird der Login akzeptiert, und Ordereingabe, Charts und alle verbundenen Plattformen wie TradingView funktionieren normal. Haben Sie gerade ein Automatisierungstool eingerichtet, verbinden Sie es jetzt neu, da das Gerät als vertrauenswürdig gilt." },
        { title: "Das Gerät unter „My Devices“ bestätigen", html: "Möchten Sie sehen, was als vertrauenswürdig gilt? Öffnen Sie im Tradovate Web Trader <strong class='text-white'>Application Settings</strong> und gehen Sie zu <strong class='text-white'>My Devices</strong>. Sie erhalten eine Liste aller Geräte, die Ihr Konto berührt haben, mit Spalten für Gerät, IP-Adresse, letzten Standort und letzte Anmeldezeit. Ein soeben genehmigtes Gerät zeigt die Option <strong class='text-white'>Remove Access</strong>; eines, das noch wartet, zeigt <strong class='text-white'>Pending</strong> neben einer Option <strong class='text-white'>Forget</strong>." },
      ],
    },
    { type: "table", headers: ["Status in My Devices","Bedeutung","Ihre Option"], rows: [
      ["Approved","Sie haben dieses Gerät bestätigt, und es kann sich anmelden.","Remove Access"],
      ["Pending","Es hat versucht sich anzumelden, wurde aber noch nicht genehmigt.","Forget"],
    ] },
    { type: "heading",text: "Keine Genehmigungs-E-Mail erhalten?" },
    { type: "paragraph",html: "Keine E-Mail, kein Login, kein Spaß. Gehen Sie diese Punkte durch, bevor Sie es abschreiben:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Spam und Werbung prüfen.</strong> Die Benachrichtigung landet oft außerhalb des Haupt-Posteingangs.",
        "<strong class='text-white'>Hinterlegte E-Mail bestätigen.</strong> Genehmigungen gehen an die Adresse, die mit dem Konto verknüpft ist. Bei einem Prop- oder finanzierten Konto kann das die von Ihrer Firma registrierte Adresse sein, nicht Ihre private.",
        "<strong class='text-white'>Mit Forget erneut senden.</strong> Wenn Sie in <strong class='text-white'>My Devices</strong> bei dem ausstehenden Gerät auf <strong class='text-white'>Forget</strong> klicken, wird beim nächsten Anmeldeversuch dieses Rechners eine neue Approve/Deny-E-Mail ausgelöst.",
        "<strong class='text-white'>Auf eine Push-Benachrichtigung achten.</strong> Sind Sie in der mobilen App angemeldet, kann die Aufforderung zum neuen Gerät auch dort erscheinen.",
        "<strong class='text-white'>Immer noch nichts?</strong> Wenden Sie sich an den Tradovate-Support (oder an Ihre Prop-Firma, falls es ein finanziertes Konto ist), um das Gerät zu bestätigen und Ihre Benachrichtigungseinstellungen zu prüfen.",
      ],
    },
    { type: "heading",text: "Weniger Logins mit PickMyTrade" },
    { type: "paragraph",html: "Jeder neue Rechner, auf dem Sie sich anmelden, ist ein weiteres Gerät, das genehmigt werden muss. Wenn PickMyTrade Ihre Strategie ausführt, werden Ihre TradingView-Alerts über eine einzige Verbindung an Tradovate geleitet, sodass Sie Ihr Live-Konto nicht auf einem Stapel von Geräten ein- und ausloggen müssen, nur um eine Strategie am Laufen zu halten. Sie genehmigen ein Setup, und die Trades werden von selbst ausgeführt." },
  ], es: [
    { type: "paragraph",html: "¿Ha iniciado sesión en un portátil, teléfono o navegador nuevo y lo han bloqueado? Es la verificación de dispositivos de Tradovate haciendo su trabajo. Con la autenticación de dos factores activada, un inicio de sesión desde un equipo que no reconoce no se completará hasta que apruebe ese dispositivo desde un correo. Así se resuelve exactamente y se vuelve a operar." },
    { type: "heading",text: "Por qué Tradovate le pide aprobar un dispositivo" },
    { type: "paragraph",html: "Con 2FA activado, Tradovate vincula su cuenta a los dispositivos concretos que usa. Si inicia sesión desde uno nuevo, envía un correo de aprobación (y a menudo una notificación push) antes de dejar entrar a ese equipo. En una cuenta real esto es estricto: hasta que apruebe el dispositivo, el inicio de sesión se deniega y las órdenes no se enrutan. Puede ver un mensaje como <strong class='text-white'>«You have 2FA enabled and log in from a new machine»</strong> en TradingView, o un simple <strong class='text-white'>«access is denied»</strong> a través de la API. Las cuentas simuladas y demo no aplican la verificación de la misma manera, por lo que las mismas credenciales pueden funcionar en un sitio y quedarse bloqueadas en otro." },
    { type: "heading",text: "Aprobar un dispositivo nuevo en Tradovate: paso a paso" },
    {
      type: "steps",
      items: [
        { title: "Abra el correo de aprobación del dispositivo", html: "Revise la bandeja de entrada de la dirección de correo asociada a su cuenta de Tradovate. Justo después del inicio de sesión bloqueado, Tradovate envía una notificación de inicio de sesión de dispositivo que indica su nombre de usuario y el nuevo dispositivo que intentó acceder. Si no hay nada en la bandeja de entrada, revise las carpetas de spam y promociones antes de asumir que no se envió." },
        { title: "Haga clic en Approve", html: "El correo le ofrece dos opciones: <strong class='text-white'>Approve</strong> y <strong class='text-white'>Deny</strong>. Haga clic en <strong class='text-white'>Approve</strong> para confiar en el dispositivo. Esa es toda la acción que debe realizar la persona frente al teclado, así que lea primero los detalles del dispositivo y la ubicación y apruebe únicamente un inicio de sesión que reconozca como suyo. Si no fue usted quien lo inició, pulse <strong class='text-white'>Deny</strong> y cambie su contraseña." },
        { title: "Vuelva a iniciar sesión desde el dispositivo nuevo", html: "Aprobar el dispositivo no siempre le lleva directamente a la plataforma, así que vuelva al ordenador o navegador nuevo e inicie sesión de nuevo. Esta vez el acceso se completa y la introducción de órdenes, los gráficos y cualquier plataforma conectada, como TradingView, empiezan a funcionar con normalidad. Si estaba configurando una herramienta de automatización, vuelva a conectarla ahora que el dispositivo es de confianza." },
        { title: "Confirme el dispositivo en My Devices", html: "¿Quiere ver en qué dispositivos se confía? En el Web Trader de Tradovate, abra <strong class='text-white'>Application Settings</strong> y vaya a <strong class='text-white'>My Devices</strong>. Verá una lista de todo lo que ha accedido a su cuenta, con columnas para el dispositivo, la dirección IP, la última ubicación y la hora del último inicio de sesión. Un dispositivo que acaba de aprobar muestra una opción <strong class='text-white'>Remove Access</strong>; uno que sigue esperando muestra <strong class='text-white'>Pending</strong> junto a una opción <strong class='text-white'>Forget</strong>." },
      ],
    },
    { type: "table", headers: ["Estado en My Devices","Qué significa","Su opción"], rows: [
      ["Approved","Usted confirmó este dispositivo y puede iniciar sesión.","Remove Access"],
      ["Pending","Intentó iniciar sesión pero aún no ha sido aprobado.","Forget"],
    ] },
    { type: "heading",text: "¿No recibió el correo de aprobación?" },
    { type: "paragraph",html: "Sin correo no hay acceso, y eso no tiene gracia. Revise estos puntos antes de darlo por perdido:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Revise spam y promociones.</strong> La notificación a menudo llega fuera de la bandeja de entrada principal.",
        "<strong class='text-white'>Confirme el correo registrado.</strong> Las aprobaciones se envían a la dirección asociada a la cuenta. En una cuenta prop o fondeada, puede ser el correo que registró su firma, no el personal.",
        "<strong class='text-white'>Use Forget para reenviar.</strong> En <strong class='text-white'>My Devices</strong>, al hacer clic en <strong class='text-white'>Forget</strong> sobre el dispositivo pendiente se genera un nuevo correo Approve/Deny la próxima vez que ese equipo intente iniciar sesión.",
        "<strong class='text-white'>Esté atento a una notificación push.</strong> Si tiene la sesión iniciada en la aplicación móvil, el aviso del nuevo dispositivo también puede aparecer allí.",
        "<strong class='text-white'>¿Sigue sin nada?</strong> Póngase en contacto con el soporte de Tradovate (o con su prop firm, si es una cuenta fondeada) para confirmar el dispositivo y revisar sus ajustes de notificaciones.",
      ],
    },
    { type: "heading",text: "Menos inicios de sesión que vigilar con PickMyTrade" },
    { type: "paragraph",html: "Cada equipo nuevo en el que inicia sesión es un dispositivo más que aprobar. Cuando PickMyTrade ejecuta su estrategia, sus alertas de TradingView se dirigen a Tradovate mediante una única conexión, por lo que no tiene que entrar y salir de su cuenta real en una pila de dispositivos solo para mantener una estrategia en marcha. Usted aprueba una configuración y las operaciones se ejecutan solas." },
  ], fr: [
    { type: "paragraph",html: "Connecté depuis un nouvel ordinateur portable, téléphone ou navigateur et bloqué ? C'est la vérification d'appareil de Tradovate qui fait son travail. Lorsque l'authentification à deux facteurs est activée, une connexion depuis une machine inconnue n'aboutit que si vous approuvez cet appareil depuis un e-mail. Voici exactement comment la débloquer et reprendre le trading." },
    { type: "heading",text: "Pourquoi Tradovate vous demande d'approuver un appareil" },
    { type: "paragraph",html: "Avec la 2FA activée, Tradovate associe votre compte aux appareils précis que vous utilisez. Si vous vous connectez depuis un nouvel appareil, il envoie un e-mail d'approbation (et souvent une notification push) avant d'autoriser cette machine. Sur un compte réel, c'est strict : tant que vous n'avez pas approuvé l'appareil, la connexion est refusée et les ordres ne sont pas acheminés. Vous pouvez voir un message comme <strong class='text-white'>« You have 2FA enabled and log in from a new machine »</strong> sur TradingView, ou un simple <strong class='text-white'>« access is denied »</strong> via l'API. Les comptes simulés et de démo n'appliquent pas la vérification de la même façon, ce qui explique que les mêmes identifiants puissent fonctionner à un endroit et se bloquer ailleurs." },
    { type: "heading",text: "Approuver un nouvel appareil dans Tradovate : pas à pas" },
    {
      type: "steps",
      items: [
        { title: "Ouvrez l'e-mail d'approbation de l'appareil", html: "Consultez la boîte de réception de l'adresse e-mail associée à votre compte Tradovate. Juste après la connexion bloquée, Tradovate envoie une notification de connexion d'appareil qui mentionne votre nom d'utilisateur et le nouvel appareil qui a tenté de se connecter. S'il n'y a rien dans la boîte de réception, regardez dans les dossiers spam et promotions avant de supposer que rien n'a été envoyé." },
        { title: "Cliquez sur Approve", html: "L'e-mail vous propose deux choix : <strong class='text-white'>Approve</strong> et <strong class='text-white'>Deny</strong>. Cliquez sur <strong class='text-white'>Approve</strong> pour faire confiance à l'appareil. C'est toute l'action à effectuer devant le clavier : lisez donc d'abord les détails de l'appareil et de la localisation, et n'approuvez qu'une connexion que vous reconnaissez comme la vôtre. Si vous ne l'avez pas initiée, cliquez sur <strong class='text-white'>Deny</strong> et changez votre mot de passe." },
        { title: "Reconnectez-vous depuis le nouvel appareil", html: "L'approbation de l'appareil ne vous amène pas toujours directement dans la plateforme : retournez donc sur le nouvel ordinateur ou navigateur et connectez-vous de nouveau. Cette fois, la connexion aboutit, et la saisie d'ordres, les graphiques et toute plateforme connectée comme TradingView fonctionnent normalement. Si vous étiez en pleine configuration d'un outil d'automatisation, reconnectez-le maintenant que l'appareil est approuvé." },
        { title: "Confirmez l'appareil dans My Devices", html: "Vous voulez voir quels appareils sont approuvés ? Dans le Web Trader de Tradovate, ouvrez <strong class='text-white'>Application Settings</strong> et allez dans <strong class='text-white'>My Devices</strong>. Vous obtenez la liste de tout ce qui a accédé à votre compte, avec des colonnes pour l'appareil, l'adresse IP, la dernière localisation et l'heure de la dernière connexion. Un appareil que vous venez d'approuver affiche une option <strong class='text-white'>Remove Access</strong> ; un appareil encore en attente affiche <strong class='text-white'>Pending</strong> à côté d'une option <strong class='text-white'>Forget</strong>." },
      ],
    },
    { type: "table", headers: ["Statut dans My Devices","Signification","Votre option"], rows: [
      ["Approved","Vous avez confirmé cet appareil et il peut se connecter.","Remove Access"],
      ["Pending","Il a tenté de se connecter mais n'a pas encore été approuvé.","Forget"],
    ] },
    { type: "heading",text: "Vous n'avez pas reçu l'e-mail d'approbation ?" },
    { type: "paragraph",html: "Pas d'e-mail, pas de connexion. Passez en revue ces points avant de renoncer :" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Vérifiez les spams et les promotions.</strong> La notification atterrit souvent en dehors de la boîte de réception principale.",
        "<strong class='text-white'>Confirmez l'adresse e-mail enregistrée.</strong> Les approbations sont envoyées à l'adresse associée au compte. Sur un compte prop ou financé, il peut s'agir de l'e-mail enregistré par votre firme, et non du vôtre.",
        "<strong class='text-white'>Utilisez Forget pour renvoyer.</strong> Dans <strong class='text-white'>My Devices</strong>, un clic sur <strong class='text-white'>Forget</strong> pour l'appareil en attente déclenche un nouvel e-mail Approve/Deny la prochaine fois que cette machine tente de se connecter.",
        "<strong class='text-white'>Surveillez une notification push.</strong> Si vous êtes connecté sur l'application mobile, l'invite du nouvel appareil peut aussi s'y afficher.",
        "<strong class='text-white'>Toujours rien ?</strong> Contactez le support Tradovate (ou votre prop firm, s'il s'agit d'un compte financé) pour confirmer l'appareil et vérifier vos paramètres de notification.",
      ],
    },
    { type: "heading",text: "Moins de connexions à surveiller avec PickMyTrade" },
    { type: "paragraph",html: "Chaque nouvelle machine sur laquelle vous vous connectez est un appareil de plus à approuver. Lorsque PickMyTrade exécute votre stratégie, vos alertes TradingView sont acheminées vers Tradovate via une seule connexion : vous n'avez donc pas à connecter et déconnecter votre compte réel sur une pile d'appareils juste pour maintenir une stratégie en marche. Vous approuvez une configuration, et les trades s'exécutent d'eux-mêmes." },
  ], it: [
    { type: "paragraph",html: "Ha effettuato l'accesso da un nuovo laptop, telefono o browser ed è stato bloccato? È il controllo dei dispositivi di Tradovate che fa il suo lavoro. Quando l'autenticazione a due fattori è attiva, un accesso da una macchina non riconosciuta non va a buon fine finché non approva quel dispositivo tramite un'e-mail. Ecco esattamente come risolvere e tornare a fare trading." },
    { type: "heading",text: "Perché Tradovate chiede di approvare un dispositivo" },
    { type: "paragraph",html: "Con la 2FA attiva, Tradovate lega il suo conto ai dispositivi specifici che usa. Se accede da uno nuovo, invia un'e-mail di approvazione (e spesso una notifica push) prima di far entrare quella macchina. Su un conto live questo è rigoroso: finché non approva il dispositivo, l'accesso viene negato e gli ordini non vengono instradati. Potrebbe vedere un messaggio come <strong class='text-white'>«You have 2FA enabled and log in from a new machine»</strong> su TradingView, oppure un semplice <strong class='text-white'>«access is denied»</strong> tramite l'API. I conti simulati e demo non applicano il controllo allo stesso modo, ed è per questo che le stesse credenziali possono funzionare in un posto e bloccarsi in un altro." },
    { type: "heading",text: "Approvare un nuovo dispositivo in Tradovate: guida passo passo" },
    {
      type: "steps",
      items: [
        { title: "Apra l'e-mail di approvazione del dispositivo", html: "Controlli la posta in arrivo dell'indirizzo e-mail associato al suo conto Tradovate. Subito dopo l'accesso bloccato, Tradovate invia una notifica di accesso da dispositivo che riporta il suo nome utente e il nuovo dispositivo che ha tentato di accedere. Se non c'è nulla nella posta in arrivo, controlli le cartelle spam e promozioni prima di presumere che non sia stata inviata." },
        { title: "Clicchi su Approve", html: "L'e-mail offre due scelte: <strong class='text-white'>Approve</strong> e <strong class='text-white'>Deny</strong>. Clicchi su <strong class='text-white'>Approve</strong> per considerare attendibile il dispositivo. È tutta l'azione richiesta alla persona alla tastiera: legga quindi prima i dettagli del dispositivo e della posizione e approvi solo un accesso che riconosce come proprio. Se non l'ha avviato lei, prema <strong class='text-white'>Deny</strong> e cambi la password." },
        { title: "Acceda di nuovo dal nuovo dispositivo", html: "L'approvazione del dispositivo non la porta sempre direttamente nella piattaforma, quindi torni al nuovo computer o browser e acceda di nuovo. Questa volta l'accesso va a buon fine, e l'inserimento ordini, i grafici e qualsiasi piattaforma collegata come TradingView iniziano a funzionare normalmente. Se stava configurando uno strumento di automazione, lo ricolleghi ora che il dispositivo è attendibile." },
        { title: "Confermi il dispositivo in My Devices", html: "Vuole vedere quali dispositivi sono attendibili? Nel Web Trader di Tradovate, apra <strong class='text-white'>Application Settings</strong> e vada in <strong class='text-white'>My Devices</strong>. Otterrà un elenco di tutto ciò che ha toccato il suo conto, con colonne per dispositivo, indirizzo IP, ultima posizione e ora dell'ultimo accesso. Un dispositivo appena approvato mostra un'opzione <strong class='text-white'>Remove Access</strong>; uno ancora in attesa mostra <strong class='text-white'>Pending</strong> accanto a un'opzione <strong class='text-white'>Forget</strong>." },
      ],
    },
    { type: "table", headers: ["Stato in My Devices","Che cosa significa","La sua opzione"], rows: [
      ["Approved","Ha confermato questo dispositivo e può accedere.","Remove Access"],
      ["Pending","Ha tentato di accedere ma non è ancora stato approvato.","Forget"],
    ] },
    { type: "heading",text: "Non ha ricevuto l'e-mail di approvazione?" },
    { type: "paragraph",html: "Niente e-mail, niente accesso. Verifichi questi punti prima di arrendersi:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Controlli spam e promozioni.</strong> La notifica spesso finisce fuori dalla posta in arrivo principale.",
        "<strong class='text-white'>Confermi l'e-mail registrata.</strong> Le approvazioni vengono inviate all'indirizzo associato al conto. Su un conto prop o finanziato, potrebbe essere l'e-mail registrata dalla sua società, non quella personale.",
        "<strong class='text-white'>Usi Forget per reinviare.</strong> In <strong class='text-white'>My Devices</strong>, cliccando su <strong class='text-white'>Forget</strong> sul dispositivo in attesa si genera una nuova e-mail Approve/Deny la prossima volta che quella macchina tenta di accedere.",
        "<strong class='text-white'>Controlli una notifica push.</strong> Se ha effettuato l'accesso all'app mobile, la richiesta per il nuovo dispositivo può comparire anche lì.",
        "<strong class='text-white'>Ancora niente?</strong> Contatti il supporto di Tradovate (o la sua prop firm, se è un conto finanziato) per confermare il dispositivo e verificare le impostazioni delle notifiche.",
      ],
    },
    { type: "heading",text: "Meno accessi da gestire con PickMyTrade" },
    { type: "paragraph",html: "Ogni nuova macchina da cui accede è un dispositivo in più da approvare. Quando PickMyTrade esegue la sua strategia, i suoi alert di TradingView vengono instradati verso Tradovate tramite un'unica connessione, quindi non deve entrare e uscire dal suo conto live su una pila di dispositivi solo per mantenere attiva una strategia. Approva una configurazione e le operazioni partono da sole." },
  ] },
  ctaHeading: { en: "Fewer Devices to Approve", de: "Weniger Geräte zu genehmigen", es: "Menos dispositivos que aprobar", fr: "Moins d'appareils à approuver", it: "Meno dispositivi da approvare" },
  ctaText: { en: "Route your TradingView alerts to Tradovate through a single connection, so you're not logging in and out across a stack of devices.", de: "Leiten Sie Ihre TradingView-Alerts über eine einzige Verbindung an Tradovate weiter, damit Sie sich nicht auf einem Stapel von Geräten an- und abmelden müssen.", es: "Dirija sus alertas de TradingView a Tradovate mediante una única conexión, para no tener que iniciar y cerrar sesión en una pila de dispositivos.", fr: "Acheminez vos alertes TradingView vers Tradovate via une seule connexion, afin de ne pas devoir vous connecter et vous déconnecter sur une pile d'appareils.", it: "Instradi i suoi alert di TradingView verso Tradovate tramite un'unica connessione, così non dovrà entrare e uscire da una pila di dispositivi." },
  ctaButtonText: { en: "Start Your Free 7-Day Trial", de: "Starten Sie Ihre kostenlose 7-Tage-Testphase", es: "Comience su prueba gratuita de 7 días", fr: "Commencez votre essai gratuit de 7 jours", it: "Inizi la prova gratuita di 7 giorni" },
  ctaUrl: "https://app.pickmytrade.trade/?register=true&utm_source=content&utm_medium=how-to",
  faqHeading: { en: "Frequently Asked Questions", de: "Häufig gestellte Fragen", es: "Preguntas frecuentes", fr: "Questions fréquentes", it: "Domande frequenti" },
  faqs: { en: [
    { q: "Do I have to approve a device on a demo account?", a: "Usually not. The device-approval requirement is enforced on live accounts. Simulated and demo accounts generally let a new device in without the email step, which is why live logins can stall when demo ones don't." },
    { q: "Where do I remove a device I no longer use?", a: "Open Application Settings and go to My Devices. Find the approved device and use Remove Access. If it ever signs in again, you'll get a fresh approval email." },
    { q: "Can I skip device approval entirely?", a: "Only by turning off 2FA, which also removes the protection it gives you. For any account holding real capital or a funded evaluation, leave 2FA on and just approve each device once." },
  ], de: [
    { q: "Muss ich auf einem Demo-Konto ein Gerät genehmigen?", a: "In der Regel nicht. Die Geräte-Genehmigung wird auf Live-Konten durchgesetzt. Simulations- und Demo-Konten lassen ein neues Gerät meist ohne den E-Mail-Schritt zu, weshalb Live-Logins ins Stocken geraten können, Demo-Logins aber nicht." },
    { q: "Wo entferne ich ein Gerät, das ich nicht mehr verwende?", a: "Öffnen Sie Application Settings und gehen Sie zu My Devices. Suchen Sie das genehmigte Gerät und verwenden Sie Remove Access. Meldet es sich je wieder an, erhalten Sie eine neue Genehmigungs-E-Mail." },
    { q: "Kann ich die Geräte-Genehmigung ganz überspringen?", a: "Nur, indem Sie 2FA ausschalten – was aber auch den Schutz entfernt, den sie Ihnen bietet. Lassen Sie 2FA für jedes Konto mit echtem Kapital oder einer finanzierten Evaluierung eingeschaltet und genehmigen Sie jedes Gerät einfach einmal." },
  ], es: [
    { q: "¿Tengo que aprobar un dispositivo en una cuenta demo?", a: "Normalmente no. El requisito de aprobación de dispositivos se aplica en las cuentas reales. Las cuentas simuladas y demo suelen dejar entrar a un dispositivo nuevo sin el paso del correo, por eso los inicios de sesión en cuentas reales pueden quedarse bloqueados mientras que los de demo no." },
    { q: "¿Dónde elimino un dispositivo que ya no uso?", a: "Abra Application Settings y vaya a My Devices. Busque el dispositivo aprobado y use Remove Access. Si vuelve a iniciar sesión alguna vez, recibirá un nuevo correo de aprobación." },
    { q: "¿Puedo omitir por completo la aprobación de dispositivos?", a: "Solo desactivando 2FA, lo que también elimina la protección que le ofrece. Para cualquier cuenta con capital real o una evaluación fondeada, deje 2FA activado y apruebe cada dispositivo una sola vez." },
  ], fr: [
    { q: "Dois-je approuver un appareil sur un compte démo ?", a: "En général, non. L'exigence d'approbation des appareils est appliquée sur les comptes réels. Les comptes simulés et de démo laissent généralement entrer un nouvel appareil sans l'étape de l'e-mail, ce qui explique que les connexions réelles puissent se bloquer alors que celles de démo passent." },
    { q: "Où supprimer un appareil que je n'utilise plus ?", a: "Ouvrez Application Settings et allez dans My Devices. Trouvez l'appareil approuvé et utilisez Remove Access. S'il se reconnecte un jour, vous recevrez un nouvel e-mail d'approbation." },
    { q: "Puis-je ignorer complètement l'approbation des appareils ?", a: "Uniquement en désactivant la 2FA, ce qui supprime aussi la protection qu'elle vous apporte. Pour tout compte détenant un capital réel ou une évaluation financée, laissez la 2FA activée et approuvez simplement chaque appareil une fois." },
  ], it: [
    { q: "Devo approvare un dispositivo su un conto demo?", a: "Di solito no. Il requisito di approvazione del dispositivo viene applicato sui conti live. I conti simulati e demo in genere lasciano entrare un nuovo dispositivo senza il passaggio via e-mail, ed è per questo che gli accessi live possono bloccarsi mentre quelli demo no." },
    { q: "Dove rimuovo un dispositivo che non uso più?", a: "Apra Application Settings e vada in My Devices. Trovi il dispositivo approvato e usi Remove Access. Se dovesse accedere di nuovo, riceverà una nuova e-mail di approvazione." },
    { q: "Posso saltare del tutto l'approvazione dei dispositivi?", a: "Solo disattivando la 2FA, il che rimuove anche la protezione che offre. Per qualsiasi conto con capitale reale o una valutazione finanziata, lasci attiva la 2FA e approvi semplicemente ogni dispositivo una volta." },
  ] },
  relatedHeading: { en: "Related Guides", de: "Verwandte Anleitungen", es: "Guías relacionadas", fr: "Guides associés", it: "Guide correlate" },
  disclosureText: { en: `This guide is for educational and informational purposes only and is not financial, investment, or trading advice. Trading futures and other leveraged products carries a substantial risk of loss and is not suitable for every investor. PickMyTrade is an independent third-party automation platform and is not affiliated with, endorsed by, or sponsored by Tradovate, Inc. "Tradovate" and all related names, logos, and trademarks are the property of their respective owners. Platform features and steps change over time, so always confirm the current process in the official Tradovate platform and documentation before acting.`, de: "Dieser Leitfaden dient ausschließlich Bildungs- und Informationszwecken und stellt keine Finanz-, Anlage- oder Handelsberatung dar. Der Handel mit Futures und anderen gehebelten Produkten ist mit einem erheblichen Verlustrisiko verbunden und nicht für jeden Anleger geeignet. PickMyTrade ist eine unabhängige Automatisierungsplattform eines Drittanbieters und steht in keiner Verbindung zu Tradovate, Inc., wird weder von Tradovate, Inc. unterstützt noch gesponsert. „Tradovate“ und alle zugehörigen Namen, Logos und Marken sind Eigentum ihrer jeweiligen Inhaber. Funktionen und Schritte der Plattform ändern sich im Laufe der Zeit; bestätigen Sie daher stets den aktuellen Ablauf in der offiziellen Tradovate-Plattform und -Dokumentation, bevor Sie handeln.", es: "Esta guía tiene fines exclusivamente educativos e informativos y no constituye asesoramiento financiero, de inversión ni de trading. Operar con futuros y otros productos apalancados conlleva un riesgo sustancial de pérdida y no es adecuado para todos los inversores. PickMyTrade es una plataforma de automatización independiente de terceros y no está afiliada, respaldada ni patrocinada por Tradovate, Inc. «Tradovate» y todos los nombres, logotipos y marcas relacionados son propiedad de sus respectivos titulares. Las funciones y los pasos de la plataforma cambian con el tiempo, por lo que siempre debe confirmar el proceso vigente en la plataforma y la documentación oficiales de Tradovate antes de actuar.", fr: "Ce guide est fourni à des fins exclusivement éducatives et informatives et ne constitue pas un conseil financier, d'investissement ou de trading. Le trading de contrats à terme et d'autres produits à effet de levier comporte un risque de perte important et ne convient pas à tous les investisseurs. PickMyTrade est une plateforme d'automatisation tierce indépendante et n'est ni affiliée à Tradovate, Inc., ni approuvée ou parrainée par cette dernière. « Tradovate » ainsi que tous les noms, logos et marques associés sont la propriété de leurs détenteurs respectifs. Les fonctionnalités et les étapes de la plateforme évoluent avec le temps ; vérifiez donc toujours la procédure en vigueur dans la plateforme et la documentation officielles de Tradovate avant d'agir.", it: "Questa guida ha scopo esclusivamente educativo e informativo e non costituisce consulenza finanziaria, di investimento o di trading. Il trading di futures e di altri prodotti a leva comporta un rischio di perdita sostanziale e non è adatto a tutti gli investitori. PickMyTrade è una piattaforma di automazione indipendente di terze parti e non è affiliata, approvata o sponsorizzata da Tradovate, Inc. «Tradovate» e tutti i nomi, loghi e marchi correlati sono di proprietà dei rispettivi titolari. Le funzionalità e i passaggi della piattaforma cambiano nel tempo, quindi confermi sempre la procedura attuale nella piattaforma e nella documentazione ufficiali di Tradovate prima di agire." },
};
const data: GuideArticleData = resolveGuideContent(content, locale, related);

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: data.faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: `${SITE_URL}${withSlash(localizedPath(locale))}` },
    { "@type": "ListItem", position: 2, name: "How-To", item: `${SITE_URL}${withSlash(localizedPath(locale, "how-to"))}` },
    { "@type": "ListItem", position: 3, name: content.h1[locale], item: `${SITE_URL}${withSlash(localizedPath(locale, `how-to/${SLUG}`))}` },
  ],
};

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: content.h1[locale],
  description: content.dek[locale],
  image: `${SITE_URL}/assets/og-default.webp`,
  publisher: { "@type": "Organization", name: "PickMyTrade", logo: { "@type": "ImageObject", url: `${SITE_URL}/assets/logo.png` } },
  datePublished: "2026-07-10",
  dateModified: "2026-07-10",
  mainEntityOfPage: { "@type": "WebPage", "@id": `${SITE_URL}${withSlash(localizedPath(locale, `how-to/${SLUG}`))}` },
