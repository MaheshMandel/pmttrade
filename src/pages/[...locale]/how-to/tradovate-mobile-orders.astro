---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "tradovate-mobile-orders";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/how-to/${SLUG}`;

const META_TITLE = "Place Orders in the Tradovate Mobile App";
const META_DESCRIPTION =
  "Place market, limit, and bracket orders from the Tradovate mobile app's Trade, Markets, and Positions screens, and dodge mismatched order defaults.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Orders in der Tradovate-Mobile-App platzieren", es: "Colocar órdenes en la app móvil de Tradovate", fr: "Passer des ordres dans l’application mobile Tradovate", it: "Inserire ordini nell’app mobile di Tradovate" },
  dek: { en: "You can fire off a market order, rest a limit, wrap the entry in a stop and target, and flatten a position, all from your phone. Here's the full flow, plus the one wrinkle that trips people up.", de: "Sie können eine Market-Order absetzen, eine Limit-Order hinterlegen, den Einstieg mit Stop und Ziel einrahmen und eine Position glattstellen, alles vom Smartphone aus. Hier ist der vollständige Ablauf samt der einen Stolperfalle.", es: "Puede lanzar una orden de mercado, dejar una limit en espera, envolver la entrada con un stop y un objetivo, y cerrar una posición, todo desde el teléfono. Aquí tiene el flujo completo, junto con el detalle que confunde a la gente.", fr: "Vous pouvez envoyer un ordre au marché, poser un ordre limite, encadrer l’entrée d’un stop et d’un objectif, et clôturer une position, le tout depuis votre téléphone. Voici le déroulé complet, ainsi que le point qui piège les utilisateurs.", it: "Può inviare un ordine a mercato, lasciare un limit in attesa, incorniciare l’ingresso con uno stop e un target e chiudere una posizione, tutto dal telefono. Ecco il flusso completo, insieme al dettaglio che mette in difficoltà molti." },
  readTime: { en: "5 min read", de: "5 Min. Lesezeit", es: "Lectura de 5 min", fr: "Lecture : 5 min", it: "Lettura di 5 min" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "The Tradovate mobile app handles most of what the desktop platform does when it's time to get into a trade or out of one. You can fire off a market order, rest a limit, wrap the entry in a stop and target, and flatten a position, all from your phone. The one wrinkle worth knowing: the screen you start from can quietly change what loads into your order ticket, so a quick glance before you send saves headaches. Here's the full flow." },
    { type: "heading", text: "How to Place an Order on Tradovate Mobile: Step-by-Step" },
    {
      type: "steps",
      items: [
        { title: "Open the Order Ticket", html: "There are three ways into the ticket, and they all land you on the same order-entry screen. Tap the <strong class='text-white'>menu icon</strong> at the top-left and pick <strong class='text-white'>Trade</strong> for a fresh ticket. Or open <strong class='text-white'>Markets</strong>, tap the instrument you want, and hit <strong class='text-white'>Trade</strong> on its detail screen. Already holding a contract? Tap it on the <strong class='text-white'>Positions</strong> screen to open a ticket pre-loaded with that symbol.", image: { src: `${IMG}/tradovate-mobile-orders-1.jpg`, alt: "Tradovate mobile app menu open with the Trade option highlighted to open the order ticket" } },
        { title: "Pick Buy or Sell and an Order Type", html: "Set your direction first with the <strong class='text-white'>Buy</strong> or <strong class='text-white'>Sell</strong> control at the top of the ticket. Then choose the order type. The mobile ticket gives you <strong class='text-white'>Market</strong>, <strong class='text-white'>Limit</strong>, <strong class='text-white'>Stop Limit</strong>, and <strong class='text-white'>MIT</strong> (Market If Touched). Use Market when you want in right now and Limit when you'd rather wait for your price. Stop Limit and MIT are your conditional entries that only trigger once price reaches a level you set.", image: { src: `${IMG}/tradovate-mobile-orders-2.jpg`, alt: "Tradovate mobile order ticket showing the Buy and Sell toggle and the order type selector" } },
        { title: "Set Quantity and Price", html: "Enter how many contracts you want in the <strong class='text-white'>quantity</strong> field. For a Limit, Stop Limit, or MIT order, type the <strong class='text-white'>price</strong> you want the order to work at or trigger from; a Market order skips this and takes the best available fill. One thing to watch on a funded or evaluation account: your maximum order size and open-position cap vary by firm and account size, so check your firm's current rules before you size up.", image: { src: `${IMG}/tradovate-mobile-orders-3.jpg`, alt: "Tradovate mobile order ticket with the quantity stepper and limit price field filled in" } },
        { title: "Attach a Bracket for Stop-Loss and Target", html: "You don't have to send a naked entry. Switch on the <strong class='text-white'>bracket</strong> and set a <strong class='text-white'>stop-loss</strong> and a <strong class='text-white'>profit target</strong>, usually in ticks, sometimes as a price. A trailing stop is available here too if you'd rather the stop follow price. When your entry fills, Tradovate posts both legs as a linked <strong class='text-white'>OCO</strong> pair, so whichever one hits cancels the other automatically.", image: { src: `${IMG}/tradovate-mobile-orders-4.jpg`, alt: "Tradovate mobile order ticket with the bracket enabled showing stop-loss and profit target fields" } },
        { title: "Check the Defaults, Then Send", html: "This is the step that trips people up. The ticket doesn't always open with the same settings, open it from Markets and you might see one quantity and bracket, come in from a fresh login or from Positions and the defaults can be different, even though you never touched the sizing screen. Take two seconds to confirm the <strong class='text-white'>quantity</strong> and the <strong class='text-white'>bracket</strong> are what you actually want. Once it reads right, tap <strong class='text-white'>Send</strong> to submit.", image: { src: `${IMG}/tradovate-mobile-orders-5.jpg`, alt: "Tradovate mobile order ticket confirmation view with quantity and bracket settings and the Send button" } },
        { title: "Manage or Close From Positions", html: "Once you're filled, jump to the <strong class='text-white'>Positions</strong> screen to manage the trade. Tap your open contract to modify the resting bracket, or use the exit controls to reverse or flatten. To bail out of everything at once, <strong class='text-white'>Cancel All &amp; Exit All</strong> kills every working order and closes the position in a single tap.", image: { src: `${IMG}/tradovate-mobile-orders-6.jpg`, alt: "Tradovate mobile Positions screen showing an open contract with exit and Cancel All and Exit All controls" } },
      ],
    },
    { type: "heading", text: "Trade the Phone Less, Not More" },
    { type: "paragraph", html: "Placing every order by thumb is fine until a setup fires while you're away from your screen. <strong class='text-white'>PickMyTrade routes your TradingView alerts straight into your Tradovate account</strong>, entry, stop-loss, and target attached, so signals execute whether or not the app is even open." },
  ], de: [
    { type: "paragraph",html: "Die Tradovate-Mobile-App erledigt das meiste von dem, was die Desktop-Plattform beim Ein- oder Ausstieg aus einem Trade leistet. Sie können eine Market-Order absetzen, eine Limit-Order hinterlegen, den Einstieg mit Stop und Ziel einrahmen und eine Position glattstellen, alles vom Smartphone aus. Die eine Besonderheit, die Sie kennen sollten: Der Bildschirm, von dem aus Sie starten, kann unbemerkt verändern, was in Ihr Order-Ticket geladen wird. Ein kurzer Blick vor dem Absenden erspart also Ärger. Hier ist der vollständige Ablauf." },
    { type: "heading",text: "So platzieren Sie eine Order in Tradovate Mobile: Schritt für Schritt" },
    {
      type: "steps",
      items: [
        { title: "Das Order-Ticket öffnen", html: "Es gibt drei Wege zum Ticket, und alle führen zum selben Order-Eingabebildschirm. Tippen Sie oben links auf das <strong class='text-white'>Menüsymbol</strong> und wählen Sie <strong class='text-white'>Trade</strong> für ein neues Ticket. Oder öffnen Sie <strong class='text-white'>Markets</strong>, tippen Sie auf das gewünschte Instrument und dann auf <strong class='text-white'>Trade</strong> in dessen Detailansicht. Halten Sie bereits einen Kontrakt? Tippen Sie ihn im Bildschirm <strong class='text-white'>Positions</strong> an, um ein Ticket zu öffnen, in das dieses Symbol bereits geladen ist.", image: {"src":`${IMG}/tradovate-mobile-orders-1.jpg`,"alt":"Geöffnetes Menü der Tradovate-Mobile-App mit hervorgehobener Option Trade zum Öffnen des Order-Tickets"} },
        { title: "Buy oder Sell und einen Ordertyp wählen", html: "Legen Sie zuerst Ihre Richtung mit dem Steuerelement <strong class='text-white'>Buy</strong> oder <strong class='text-white'>Sell</strong> oben im Ticket fest. Wählen Sie dann den Ordertyp. Das mobile Ticket bietet <strong class='text-white'>Market</strong>, <strong class='text-white'>Limit</strong>, <strong class='text-white'>Stop Limit</strong> und <strong class='text-white'>MIT</strong> (Market If Touched). Nutzen Sie Market, wenn Sie sofort einsteigen möchten, und Limit, wenn Sie lieber auf Ihren Preis warten. Stop Limit und MIT sind Ihre bedingten Einstiege, die erst auslösen, wenn der Kurs ein von Ihnen gesetztes Niveau erreicht.", image: {"src":`${IMG}/tradovate-mobile-orders-2.jpg`,"alt":"Mobiles Tradovate-Order-Ticket mit dem Umschalter Buy und Sell sowie der Ordertyp-Auswahl"} },
        { title: "Menge und Preis festlegen", html: "Geben Sie im Feld <strong class='text-white'>Menge</strong> ein, wie viele Kontrakte Sie möchten. Bei einer Limit-, Stop-Limit- oder MIT-Order geben Sie den <strong class='text-white'>Preis</strong> ein, zu dem die Order arbeiten oder auslösen soll; eine Market-Order überspringt das und erhält den bestmöglichen Fill. Eine Sache ist bei einem Funded- oder Evaluierungskonto zu beachten: Ihre maximale Ordergröße und Ihr Limit für offene Positionen unterscheiden sich je nach Firma und Kontogröße, prüfen Sie daher die aktuellen Regeln Ihrer Firma, bevor Sie die Größe erhöhen.", image: {"src":`${IMG}/tradovate-mobile-orders-3.jpg`,"alt":"Mobiles Tradovate-Order-Ticket mit ausgefülltem Mengen-Stepper und Limit-Preisfeld"} },
        { title: "Ein Bracket für Stop-Loss und Ziel hinzufügen", html: "Sie müssen keinen ungeschützten Einstieg senden. Aktivieren Sie das <strong class='text-white'>Bracket</strong> und legen Sie einen <strong class='text-white'>Stop-Loss</strong> und ein <strong class='text-white'>Gewinnziel</strong> fest, meist in Ticks, manchmal als Preis. Ein Trailing-Stop ist hier ebenfalls verfügbar, wenn der Stop dem Kurs folgen soll. Sobald Ihr Einstieg gefüllt wird, stellt Tradovate beide Seiten als verknüpftes <strong class='text-white'>OCO</strong>-Paar ein, sodass die jeweils andere automatisch storniert wird, wenn eine ausgelöst wird.", image: {"src":`${IMG}/tradovate-mobile-orders-4.jpg`,"alt":"Mobiles Tradovate-Order-Ticket mit aktiviertem Bracket und den Feldern für Stop-Loss und Gewinnziel"} },
        { title: "Standardwerte prüfen, dann senden", html: "Dieser Schritt bringt die Leute ins Stolpern. Das Ticket öffnet sich nicht immer mit denselben Einstellungen: Öffnen Sie es über Markets, sehen Sie vielleicht eine Menge und ein Bracket, kommen Sie nach einem frischen Login oder über Positions, können die Standardwerte abweichen, obwohl Sie den Größenbildschirm nie angefasst haben. Nehmen Sie sich zwei Sekunden, um zu bestätigen, dass <strong class='text-white'>Menge</strong> und <strong class='text-white'>Bracket</strong> dem entsprechen, was Sie tatsächlich wollen. Sobald alles stimmt, tippen Sie auf <strong class='text-white'>Send</strong>, um die Order zu übermitteln.", image: {"src":`${IMG}/tradovate-mobile-orders-5.jpg`,"alt":"Bestätigungsansicht des mobilen Tradovate-Order-Tickets mit Mengen- und Bracket-Einstellungen und der Schaltfläche Send"} },
        { title: "Über Positions verwalten oder schließen", html: "Sobald Sie gefüllt sind, wechseln Sie zum Bildschirm <strong class='text-white'>Positions</strong>, um den Trade zu managen. Tippen Sie auf Ihren offenen Kontrakt, um das hinterlegte Bracket zu ändern, oder nutzen Sie die Ausstiegsoptionen, um die Position umzukehren oder glattzustellen. Um mit einem Tipp alles auf einmal zu beenden, storniert <strong class='text-white'>Cancel All &amp; Exit All</strong> jede aktive Order und schließt die Position.", image: {"src":`${IMG}/tradovate-mobile-orders-6.jpg`,"alt":"Mobiler Tradovate-Bildschirm Positions mit einem offenen Kontrakt und den Steuerelementen für Ausstieg sowie Cancel All und Exit All"} },
      ],
    },
    { type: "heading",text: "Weniger am Smartphone handeln, nicht mehr" },
    { type: "paragraph",html: "Jede Order per Daumen zu platzieren ist in Ordnung, bis ein Setup auslöst, während Sie nicht am Bildschirm sind. <strong class='text-white'>PickMyTrade leitet Ihre TradingView-Alerts direkt an Ihr Tradovate-Konto weiter</strong>, mit angehängtem Einstieg, Stop-Loss und Ziel, sodass Signale ausgeführt werden, ob die App geöffnet ist oder nicht." },
  ], es: [
    { type: "paragraph",html: "La app móvil de Tradovate hace casi todo lo que hace la plataforma de escritorio a la hora de entrar o salir de una operación. Puede lanzar una orden de mercado, dejar una limit en espera, envolver la entrada con un stop y un objetivo, y cerrar una posición, todo desde el teléfono. El único detalle que conviene conocer: la pantalla desde la que empieza puede cambiar sin avisar lo que se carga en su ticket de órdenes, así que un vistazo rápido antes de enviar le ahorra problemas. Aquí tiene el flujo completo." },
    { type: "heading",text: "Cómo colocar una orden en Tradovate móvil: paso a paso" },
    {
      type: "steps",
      items: [
        { title: "Abra el ticket de órdenes", html: "Hay tres formas de llegar al ticket, y todas llevan a la misma pantalla de entrada de órdenes. Toque el <strong class='text-white'>icono de menú</strong> arriba a la izquierda y elija <strong class='text-white'>Trade</strong> para un ticket nuevo. O abra <strong class='text-white'>Markets</strong>, toque el instrumento que quiere y pulse <strong class='text-white'>Trade</strong> en su pantalla de detalle. ¿Ya tiene un contrato? Tóquelo en la pantalla <strong class='text-white'>Positions</strong> para abrir un ticket con ese símbolo ya cargado.", image: {"src":`${IMG}/tradovate-mobile-orders-1.jpg`,"alt":"Menú de la app móvil de Tradovate abierto con la opción Trade resaltada para abrir el ticket de órdenes"} },
        { title: "Elija Buy o Sell y un tipo de orden", html: "Primero fije la dirección con el control <strong class='text-white'>Buy</strong> o <strong class='text-white'>Sell</strong> en la parte superior del ticket. Después elija el tipo de orden. El ticket móvil le ofrece <strong class='text-white'>Market</strong>, <strong class='text-white'>Limit</strong>, <strong class='text-white'>Stop Limit</strong> y <strong class='text-white'>MIT</strong> (Market If Touched). Use Market cuando quiera entrar ya y Limit cuando prefiera esperar su precio. Stop Limit y MIT son sus entradas condicionales, que solo se activan cuando el precio alcanza un nivel que usted fija.", image: {"src":`${IMG}/tradovate-mobile-orders-2.jpg`,"alt":"Ticket de órdenes de Tradovate móvil con el selector Buy y Sell y el selector de tipo de orden"} },
        { title: "Fije la cantidad y el precio", html: "Introduzca cuántos contratos quiere en el campo de <strong class='text-white'>cantidad</strong>. En una orden Limit, Stop Limit o MIT, escriba el <strong class='text-white'>precio</strong> al que quiere que trabaje o se active la orden; una orden Market omite esto y toma el mejor precio disponible. Algo a vigilar en una cuenta fondeada o de evaluación: el tamaño máximo de orden y el límite de posiciones abiertas varían según la firma y el tamaño de la cuenta, así que consulte las reglas vigentes de su firma antes de aumentar el tamaño.", image: {"src":`${IMG}/tradovate-mobile-orders-3.jpg`,"alt":"Ticket de órdenes de Tradovate móvil con el selector de cantidad y el campo de precio limit rellenados"} },
        { title: "Adjunte un bracket de stop-loss y objetivo", html: "No tiene que enviar una entrada desprotegida. Active el <strong class='text-white'>bracket</strong> y fije un <strong class='text-white'>stop-loss</strong> y un <strong class='text-white'>objetivo de beneficio</strong>, normalmente en ticks y a veces como precio. Aquí también hay un stop dinámico (trailing) disponible si prefiere que el stop siga al precio. Cuando se ejecuta su entrada, Tradovate coloca ambas patas como un par <strong class='text-white'>OCO</strong> vinculado, de modo que la que se active cancela automáticamente a la otra.", image: {"src":`${IMG}/tradovate-mobile-orders-4.jpg`,"alt":"Ticket de órdenes de Tradovate móvil con el bracket activado mostrando los campos de stop-loss y objetivo de beneficio"} },
        { title: "Revise los valores predeterminados y envíe", html: "Este es el paso que confunde a la gente. El ticket no siempre se abre con los mismos ajustes: si lo abre desde Markets quizá vea una cantidad y un bracket, y si entra tras un inicio de sesión nuevo o desde Positions los valores predeterminados pueden ser distintos, aunque nunca haya tocado la pantalla de tamaño. Dedique dos segundos a confirmar que la <strong class='text-white'>cantidad</strong> y el <strong class='text-white'>bracket</strong> son los que realmente quiere. Cuando todo esté correcto, toque <strong class='text-white'>Send</strong> para enviar.", image: {"src":`${IMG}/tradovate-mobile-orders-5.jpg`,"alt":"Vista de confirmación del ticket de órdenes de Tradovate móvil con los ajustes de cantidad y bracket y el botón Send"} },
        { title: "Gestione o cierre desde Positions", html: "Una vez ejecutada, vaya a la pantalla <strong class='text-white'>Positions</strong> para gestionar la operación. Toque su contrato abierto para modificar el bracket en espera, o use los controles de salida para invertir o cerrar la posición. Para salir de todo de una vez, <strong class='text-white'>Cancel All &amp; Exit All</strong> elimina todas las órdenes activas y cierra la posición con un solo toque.", image: {"src":`${IMG}/tradovate-mobile-orders-6.jpg`,"alt":"Pantalla Positions de Tradovate móvil con un contrato abierto y los controles de salida y Cancel All y Exit All"} },
      ],
    },
    { type: "heading",text: "Opere menos con el teléfono, no más" },
    { type: "paragraph",html: "Colocar cada orden con el pulgar está bien hasta que salta una señal mientras está lejos de la pantalla. <strong class='text-white'>PickMyTrade envía sus alertas de TradingView directamente a su cuenta de Tradovate</strong>, con la entrada, el stop-loss y el objetivo adjuntos, de modo que las señales se ejecutan aunque la app ni siquiera esté abierta." },
  ], fr: [
    { type: "paragraph",html: "L’application mobile Tradovate gère l’essentiel de ce que fait la plateforme de bureau lorsqu’il s’agit d’entrer dans un trade ou d’en sortir. Vous pouvez envoyer un ordre au marché, poser un ordre limite, encadrer l’entrée d’un stop et d’un objectif, et clôturer une position, le tout depuis votre téléphone. Le seul point à connaître : l’écran depuis lequel vous démarrez peut modifier discrètement ce qui se charge dans votre ticket d’ordre ; un coup d’œil rapide avant d’envoyer vous évite donc bien des ennuis. Voici le déroulé complet." },
    { type: "heading",text: "Comment passer un ordre sur Tradovate mobile : pas à pas" },
    {
      type: "steps",
      items: [
        { title: "Ouvrez le ticket d’ordre", html: "Il existe trois façons d’accéder au ticket, et toutes mènent au même écran de saisie d’ordre. Touchez l’<strong class='text-white'>icône de menu</strong> en haut à gauche et choisissez <strong class='text-white'>Trade</strong> pour un nouveau ticket. Ou ouvrez <strong class='text-white'>Markets</strong>, touchez l’instrument souhaité et appuyez sur <strong class='text-white'>Trade</strong> depuis son écran de détail. Vous détenez déjà un contrat ? Touchez-le sur l’écran <strong class='text-white'>Positions</strong> pour ouvrir un ticket pré-chargé avec ce symbole.", image: {"src":`${IMG}/tradovate-mobile-orders-1.jpg`,"alt":"Menu de l’application mobile Tradovate ouvert avec l’option Trade mise en évidence pour ouvrir le ticket d’ordre"} },
        { title: "Choisissez Buy ou Sell et un type d’ordre", html: "Définissez d’abord votre sens avec la commande <strong class='text-white'>Buy</strong> ou <strong class='text-white'>Sell</strong> en haut du ticket. Choisissez ensuite le type d’ordre. Le ticket mobile propose <strong class='text-white'>Market</strong>, <strong class='text-white'>Limit</strong>, <strong class='text-white'>Stop Limit</strong> et <strong class='text-white'>MIT</strong> (Market If Touched). Utilisez Market pour entrer tout de suite et Limit si vous préférez attendre votre prix. Stop Limit et MIT sont vos entrées conditionnelles, qui ne se déclenchent qu’une fois que le prix atteint un niveau que vous avez fixé.", image: {"src":`${IMG}/tradovate-mobile-orders-2.jpg`,"alt":"Ticket d’ordre Tradovate mobile affichant le bouton Buy et Sell et le sélecteur de type d’ordre"} },
        { title: "Définissez la quantité et le prix", html: "Saisissez le nombre de contrats souhaité dans le champ <strong class='text-white'>quantité</strong>. Pour un ordre Limit, Stop Limit ou MIT, saisissez le <strong class='text-white'>prix</strong> auquel l’ordre doit travailler ou se déclencher ; un ordre Market saute cette étape et prend le meilleur prix disponible. Un point à surveiller sur un compte financé ou d’évaluation : la taille maximale d’ordre et le plafond de positions ouvertes varient selon la firme et la taille du compte ; vérifiez donc les règles actuelles de votre firme avant d’augmenter la taille.", image: {"src":`${IMG}/tradovate-mobile-orders-3.jpg`,"alt":"Ticket d’ordre Tradovate mobile avec le sélecteur de quantité et le champ de prix limite renseignés"} },
        { title: "Attachez un bracket pour le stop-loss et l’objectif", html: "Vous n’avez pas à envoyer une entrée nue. Activez le <strong class='text-white'>bracket</strong> et définissez un <strong class='text-white'>stop-loss</strong> et un <strong class='text-white'>objectif de profit</strong>, généralement en ticks, parfois sous forme de prix. Un stop suiveur (trailing) est également disponible ici si vous préférez que le stop suive le prix. Lorsque votre entrée est exécutée, Tradovate place les deux jambes sous forme de paire <strong class='text-white'>OCO</strong> liée : celle qui est atteinte annule automatiquement l’autre.", image: {"src":`${IMG}/tradovate-mobile-orders-4.jpg`,"alt":"Ticket d’ordre Tradovate mobile avec le bracket activé affichant les champs de stop-loss et d’objectif de profit"} },
        { title: "Vérifiez les valeurs par défaut, puis envoyez", html: "C’est l’étape qui piège les utilisateurs. Le ticket ne s’ouvre pas toujours avec les mêmes réglages : ouvert depuis Markets, vous pouvez voir une quantité et un bracket, et après une nouvelle connexion ou depuis Positions les valeurs par défaut peuvent différer, alors que vous n’avez jamais touché à l’écran de taille. Prenez deux secondes pour confirmer que la <strong class='text-white'>quantité</strong> et le <strong class='text-white'>bracket</strong> sont bien ceux que vous voulez. Une fois que tout est correct, touchez <strong class='text-white'>Send</strong> pour soumettre l’ordre.", image: {"src":`${IMG}/tradovate-mobile-orders-5.jpg`,"alt":"Vue de confirmation du ticket d’ordre Tradovate mobile avec les réglages de quantité et de bracket et le bouton Send"} },
        { title: "Gérez ou clôturez depuis Positions", html: "Une fois exécuté, passez à l’écran <strong class='text-white'>Positions</strong> pour gérer le trade. Touchez votre contrat ouvert pour modifier le bracket en attente, ou utilisez les commandes de sortie pour inverser ou clôturer la position. Pour tout quitter d’un coup, <strong class='text-white'>Cancel All &amp; Exit All</strong> supprime tous les ordres actifs et ferme la position d’une seule pression.", image: {"src":`${IMG}/tradovate-mobile-orders-6.jpg`,"alt":"Écran Positions de Tradovate mobile affichant un contrat ouvert avec les commandes de sortie et Cancel All et Exit All"} },
      ],
    },
    { type: "heading",text: "Tradez moins sur téléphone, pas plus" },
    { type: "paragraph",html: "Passer chaque ordre au pouce convient jusqu’à ce qu’un setup se déclenche pendant que vous êtes loin de votre écran. <strong class='text-white'>PickMyTrade achemine vos alertes TradingView directement vers votre compte Tradovate</strong>, avec l’entrée, le stop-loss et l’objectif attachés, de sorte que les signaux s’exécutent que l’application soit ouverte ou non." },
  ], it: [
    { type: "paragraph",html: "L’app mobile di Tradovate gestisce gran parte di ciò che fa la piattaforma desktop quando è il momento di entrare o uscire da un trade. Può inviare un ordine a mercato, lasciare un limit in attesa, incorniciare l’ingresso con uno stop e un target e chiudere una posizione, tutto dal telefono. L’unico dettaglio da conoscere: la schermata da cui parte può cambiare silenziosamente ciò che si carica nel suo ticket ordini, quindi una rapida occhiata prima di inviare evita problemi. Ecco il flusso completo." },
    { type: "heading",text: "Come inserire un ordine su Tradovate mobile: passo dopo passo" },
    {
      type: "steps",
      items: [
        { title: "Apra il ticket ordini", html: "Ci sono tre modi per accedere al ticket, e tutti portano alla stessa schermata di inserimento ordini. Tocchi l’<strong class='text-white'>icona del menu</strong> in alto a sinistra e scelga <strong class='text-white'>Trade</strong> per un ticket nuovo. Oppure apra <strong class='text-white'>Markets</strong>, tocchi lo strumento desiderato e prema <strong class='text-white'>Trade</strong> nella sua schermata di dettaglio. Ha già un contratto in portafoglio? Lo tocchi nella schermata <strong class='text-white'>Positions</strong> per aprire un ticket precaricato con quel simbolo.", image: {"src":`${IMG}/tradovate-mobile-orders-1.jpg`,"alt":"Menu dell’app mobile di Tradovate aperto con l’opzione Trade evidenziata per aprire il ticket ordini"} },
        { title: "Scelga Buy o Sell e un tipo di ordine", html: "Imposti prima la direzione con il controllo <strong class='text-white'>Buy</strong> o <strong class='text-white'>Sell</strong> nella parte superiore del ticket. Poi scelga il tipo di ordine. Il ticket mobile offre <strong class='text-white'>Market</strong>, <strong class='text-white'>Limit</strong>, <strong class='text-white'>Stop Limit</strong> e <strong class='text-white'>MIT</strong> (Market If Touched). Usi Market quando vuole entrare subito e Limit quando preferisce attendere il suo prezzo. Stop Limit e MIT sono i suoi ingressi condizionali, che scattano solo quando il prezzo raggiunge un livello da lei impostato.", image: {"src":`${IMG}/tradovate-mobile-orders-2.jpg`,"alt":"Ticket ordini di Tradovate mobile con il selettore Buy e Sell e il selettore del tipo di ordine"} },
        { title: "Imposti quantità e prezzo", html: "Inserisca quanti contratti desidera nel campo <strong class='text-white'>quantità</strong>. Per un ordine Limit, Stop Limit o MIT, digiti il <strong class='text-white'>prezzo</strong> al quale l’ordine deve lavorare o attivarsi; un ordine Market salta questo passaggio e prende il miglior prezzo disponibile. Un aspetto da controllare su un conto finanziato o di valutazione: la dimensione massima dell’ordine e il limite di posizioni aperte variano in base alla società e alla dimensione del conto, quindi controlli le regole attuali della sua società prima di aumentare la size.", image: {"src":`${IMG}/tradovate-mobile-orders-3.jpg`,"alt":"Ticket ordini di Tradovate mobile con il selettore di quantità e il campo del prezzo limit compilati"} },
        { title: "Alleghi un bracket per stop-loss e target", html: "Non deve inviare un ingresso scoperto. Attivi il <strong class='text-white'>bracket</strong> e imposti uno <strong class='text-white'>stop-loss</strong> e un <strong class='text-white'>target di profitto</strong>, di solito in tick, a volte come prezzo. Anche qui è disponibile uno stop trailing se preferisce che lo stop segua il prezzo. Quando il suo ingresso viene eseguito, Tradovate inserisce entrambe le gambe come coppia <strong class='text-white'>OCO</strong> collegata, così quella che scatta annulla automaticamente l’altra.", image: {"src":`${IMG}/tradovate-mobile-orders-4.jpg`,"alt":"Ticket ordini di Tradovate mobile con il bracket attivato che mostra i campi di stop-loss e target di profitto"} },
        { title: "Controlli i valori predefiniti, poi invii", html: "Questo è il passaggio che mette in difficoltà molti. Il ticket non si apre sempre con le stesse impostazioni: aprendolo da Markets potrebbe vedere una quantità e un bracket, entrando da un nuovo accesso o da Positions i valori predefiniti possono essere diversi, anche se non ha mai toccato la schermata del dimensionamento. Si prenda due secondi per confermare che <strong class='text-white'>quantità</strong> e <strong class='text-white'>bracket</strong> siano quelli che desidera davvero. Quando tutto è corretto, tocchi <strong class='text-white'>Send</strong> per inviare.", image: {"src":`${IMG}/tradovate-mobile-orders-5.jpg`,"alt":"Vista di conferma del ticket ordini di Tradovate mobile con le impostazioni di quantità e bracket e il pulsante Send"} },
        { title: "Gestisca o chiuda da Positions", html: "Una volta eseguito, passi alla schermata <strong class='text-white'>Positions</strong> per gestire il trade. Tocchi il suo contratto aperto per modificare il bracket in attesa, oppure usi i controlli di uscita per invertire o chiudere la posizione. Per uscire da tutto in una volta, <strong class='text-white'>Cancel All &amp; Exit All</strong> elimina ogni ordine attivo e chiude la posizione con un solo tocco.", image: {"src":`${IMG}/tradovate-mobile-orders-6.jpg`,"alt":"Schermata Positions di Tradovate mobile con un contratto aperto e i controlli di uscita e Cancel All e Exit All"} },
      ],
    },
    { type: "heading",text: "Operi meno dal telefono, non di più" },
    { type: "paragraph",html: "Inserire ogni ordine con il pollice va bene finché un setup non scatta mentre è lontano dallo schermo. <strong class='text-white'>PickMyTrade instrada i suoi alert di TradingView direttamente al suo conto Tradovate</strong>, con ingresso, stop-loss e target allegati, così i segnali vengono eseguiti anche se l’app non è nemmeno aperta." },
  ] },
  ctaHeading: { en: "Let Signals Execute Without the Thumb Work", de: "Signale ausführen lassen, ohne Daumenarbeit", es: "Deje que las señales se ejecuten sin trabajo de pulgar", fr: "Laissez les signaux s’exécuter sans effort du pouce", it: "Lasci che i segnali si eseguano senza fatica del pollice" },
  ctaText: { en: "PickMyTrade routes your TradingView alerts straight into Tradovate with entry, stop-loss, and target attached, whether the app is open or not.", de: "PickMyTrade leitet Ihre TradingView-Alerts mit Einstieg, Stop-Loss und Ziel direkt an Tradovate weiter, egal ob die App geöffnet ist oder nicht.", es: "PickMyTrade envía sus alertas de TradingView directamente a Tradovate con la entrada, el stop-loss y el objetivo adjuntos, esté la app abierta o no.", fr: "PickMyTrade achemine vos alertes TradingView directement vers Tradovate avec l’entrée, le stop-loss et l’objectif attachés, que l’application soit ouverte ou non.", it: "PickMyTrade instrada i suoi alert di TradingView direttamente a Tradovate con ingresso, stop-loss e target allegati, che l’app sia aperta o meno." },
