---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "tradovate-trailing-max-drawdown";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/how-to/${SLUG}`;

const META_TITLE = "Set a Trailing Max Drawdown in Tradovate";
const META_DESCRIPTION =
  "Set a trailing max drawdown in Tradovate to auto-cap losses from your peak balance. Real-time vs end-of-day, plus the exact steps to turn it on.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Ein Trailing Max Drawdown in Tradovate festlegen", es: "Cómo establecer un Trailing Max Drawdown en Tradovate", fr: "Définir un Trailing Max Drawdown dans Tradovate", it: "Impostare un Trailing Max Drawdown in Tradovate" },
  dek: { en: "A trailing max drawdown is a moving floor under your account. It's the same control most prop firms use to police their evaluations, and you can set one on your own Tradovate account in under a minute.", de: "Ein Trailing Max Drawdown ist ein mitwandernder Boden unter Ihrem Konto. Es ist dieselbe Kontrolle, mit der die meisten Prop-Firms ihre Evaluierungen überwachen, und Sie können sie in weniger als einer Minute auch für Ihr eigenes Tradovate-Konto einrichten.", es: "Un trailing max drawdown es un suelo móvil bajo su cuenta. Es el mismo control que usan la mayoría de las prop firms para vigilar sus evaluaciones, y puede configurarlo en su propia cuenta de Tradovate en menos de un minuto.", fr: "Un trailing max drawdown est un plancher mobile sous votre compte. C’est le même contrôle que la plupart des prop firms utilisent pour encadrer leurs évaluations, et vous pouvez en définir un sur votre propre compte Tradovate en moins d’une minute.", it: "Un trailing max drawdown è un pavimento mobile sotto il suo conto. È lo stesso controllo che la maggior parte delle prop firm usa per sorvegliare le proprie valutazioni, e può impostarlo sul suo conto Tradovate in meno di un minuto." },
  readTime: { en: "6 min read", de: "6 Min. Lesezeit", es: "Lectura de 6 min", fr: "Lecture : 6 min", it: "Lettura di 6 min" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "A trailing max drawdown is a moving floor under your account. Instead of a fixed dollar loss limit that never budges, it follows your highest balance up and then locks the account the moment your equity falls back to that trailing line. It's the same control most prop firms use to police their evaluations, and you can set one on your own Tradovate account in under a minute." },
    { type: "paragraph", html: "Here's the math, the two flavors Tradovate offers, and the exact clicks to switch it on." },
    { type: "heading", text: "How the Trailing Limit Is Calculated" },
    { type: "paragraph", html: "The formula is simple: your peak account value minus your trailing max drawdown equals the auto-liquidation threshold. Say you start at $50,000 and set a $3,000 drawdown. Your line begins at $47,000. Push the account up to $55,000 and the line ratchets to $52,000. It never slides back down, once you've banked gains, that cushion is locked in behind you. Fall to the line and Tradovate flattens your positions and drops the account into liquidation-only mode, so this is a hard stop, not a warning." },
    { type: "heading", text: "Real-Time vs End-of-Day: Pick Your Flavor" },
    { type: "paragraph", html: "Tradovate splits the trailing max drawdown into two toggles, and the difference is <em>when the high-water mark updates</em>." },
    {
      type: "table",
      headers: ["", "Real-time", "End-of-day"],
      rows: [
        ["When the peak updates", "Continuously, tick by tick, open (unrealized) profit counts", "Once per session, off your end-of-day balance"],
        ["Feels like", "Tight, intraday leash", "Roomier, swing-friendly"],
        ["Watch out for", "A quick profit spike lifts the line, then a pullback can trap you", "The line lags a fast-moving day, so intraday risk runs looser"],
      ],
    },
    { type: "paragraph", html: "Scalpers and evaluation traders usually want the real-time version because it reacts the instant a trade goes underwater. If you hold longer and don't want a single wick moving your floor, end-of-day is the calmer choice. Each toggle is independent, so run one or the other." },
    { type: "heading", text: "How to Set a Trailing Max Drawdown, Step by Step" },
    {
      type: "steps",
      items: [
        { title: "Open Application Settings", html: "Click the <strong class='text-white'>settings</strong> button in the upper-right corner of the Tradovate platform to open <strong class='text-white'>Application Settings</strong>, then head to the <strong class='text-white'>Accounts</strong> tab. This is where every account-level control lives, so if you run more than one account, make sure you're looking at the right one.", image: { src: `${IMG}/tradovate-trailing-max-drawdown-1.png`, alt: "Tradovate Application Settings open on the Accounts tab from the upper-right settings button" } },
        { title: "Expand Risk Settings", html: "Find the account you want to protect and click <strong class='text-white'>Risk Settings</strong>. The row expands into a detail panel packed with limits, daily loss, weekly loss, max position size, and the trailing max drawdown fields you're after. It's the same panel you'd use to set your daily and weekly loss limits, so everything risk-related is in one place.", image: { src: `${IMG}/tradovate-trailing-max-drawdown-2.png`, alt: "Tradovate Risk Settings panel expanded showing account-level risk limit fields" } },
        { title: "Turn on the Trailing Max Drawdown Toggle", html: "Flip on either <strong class='text-white'>Real-Time Trailing Max Drawdown</strong> or <strong class='text-white'>End-of-Day Trailing Max Drawdown</strong>, then type your dollar amount into the box beside it. Pick a number that matches how much heat you can take on the account before you'd want trading to stop cold, not a round number you grabbed without thinking.", image: { src: `${IMG}/tradovate-trailing-max-drawdown-3.png`, alt: "Trader enabling the Trailing Max Drawdown toggle and entering a dollar value in Tradovate Risk Settings" } },
        { title: "Check the Number Before You Save", html: "This one bites people: <strong class='text-white'>never leave the amount at $0</strong>. A zero trailing max drawdown puts your auto-liquidation line right at your current balance, so Tradovate liquidates open positions on the spot. Confirm the figure gives you a genuine cushion, and glance at your account's equity value so you know where the line sits.", image: { src: `${IMG}/tradovate-trailing-max-drawdown-4.png`, alt: "Tradovate Risk Settings showing a non-zero trailing max drawdown value next to the account equity" } },
        { title: "Scroll Down and Save", html: "Scroll to the bottom of the Risk Settings panel and click <strong class='text-white'>Save</strong>. Nothing takes effect until you do, skip this and your toggle reverts. If you want the setting to stick and stop yourself from loosening it in a bad moment, Tradovate also lets you lock your risk settings so they can't be changed mid-session.", image: { src: `${IMG}/tradovate-trailing-max-drawdown-5.png`, alt: "Save button at the bottom of the Tradovate Risk Settings panel after entering a trailing max drawdown" } },
      ],
    },
    { type: "heading", text: "If You Trade a Funded Account" },
    { type: "paragraph", html: "On a prop or evaluation account, the trailing drawdown is usually set by the firm, not you, and the rules differ from shop to shop. The starting cushion, whether the peak counts unrealized profit, and whether the line freezes once you've built a buffer above your starting balance all vary by firm and account size, check your firm's current rules. If the account already shows a drawdown you didn't set, that's the firm's control, and breaching it typically ends the evaluation." },
    { type: "heading", text: "Automate the Trades, Keep the Guardrail" },
    { type: "paragraph", html: "A trailing max drawdown protects the account, but it can't place your trades when you're away from the desk. PickMyTrade wires your TradingView alerts straight into Tradovate so every signal executes on time, with your risk settings still doing their job in the background." },
  ], de: [
    { type: "paragraph",html: "Ein Trailing Max Drawdown ist ein mitwandernder Boden unter Ihrem Konto. Statt eines festen Dollar-Verlustlimits, das sich nie bewegt, folgt er Ihrem höchsten Kontostand nach oben und sperrt das Konto, sobald Ihr Kapital auf diese mitlaufende Linie zurückfällt. Es ist dieselbe Kontrolle, mit der die meisten Prop-Firms ihre Evaluierungen überwachen, und Sie können sie in weniger als einer Minute auch für Ihr eigenes Tradovate-Konto einrichten." },
    { type: "paragraph",html: "Hier finden Sie die Rechnung, die beiden Varianten, die Tradovate anbietet, und die genauen Klicks zum Aktivieren." },
    { type: "heading",text: "So wird das Trailing-Limit berechnet" },
    { type: "paragraph",html: "Die Formel ist einfach: Ihr Höchststand des Kontowerts minus Ihr Trailing Max Drawdown ergibt die Schwelle für die automatische Liquidation. Angenommen, Sie starten mit $50,000 und legen einen Drawdown von $3,000 fest. Ihre Linie beginnt bei $47,000. Steigt das Konto auf $55,000, rutscht die Linie auf $52,000. Sie sinkt nie wieder, einmal erzielte Gewinne bleiben als Polster hinter Ihnen festgeschrieben. Fällt das Konto auf die Linie, schließt Tradovate Ihre Positionen und versetzt das Konto in den reinen Liquidationsmodus, es handelt sich also um einen harten Stopp und nicht um eine Warnung." },
    { type: "heading",text: "Echtzeit oder Tagesende: Wählen Sie Ihre Variante" },
    { type: "paragraph",html: "Tradovate teilt den Trailing Max Drawdown in zwei Schalter auf, und der Unterschied liegt darin, <em>wann der Höchststand aktualisiert wird</em>." },
    { type: "table", headers: ["","Echtzeit","Tagesende"], rows: [
      ["Wann der Höchststand aktualisiert wird","Fortlaufend, Tick für Tick, offener (nicht realisierter) Gewinn zählt mit","Einmal pro Sitzung, anhand Ihres Kontostands am Tagesende"],
      ["Fühlt sich an wie","Eine enge Leine im Intraday","Mehr Spielraum, swing-tauglich"],
      ["Worauf Sie achten sollten","Eine kurze Gewinnspitze hebt die Linie an, und ein Rücksetzer kann Sie dann in die Falle locken","Die Linie hinkt einem schnellen Handelstag hinterher, daher ist das Intraday-Risiko lockerer"],
    ] },
    { type: "paragraph",html: "Scalper und Evaluierungs-Trader wollen meist die Echtzeit-Variante, weil sie in dem Moment reagiert, in dem ein Trade ins Minus rutscht. Wenn Sie länger halten und nicht möchten, dass ein einzelner Docht Ihren Boden verschiebt, ist Tagesende die ruhigere Wahl. Jeder Schalter ist unabhängig, nutzen Sie also die eine oder die andere Variante." },
    { type: "heading",text: "So legen Sie einen Trailing Max Drawdown fest, Schritt für Schritt" },
    {
      type: "steps",
      items: [
        { title: "Application Settings öffnen", html: "Klicken Sie oben rechts in der Tradovate-Plattform auf die Schaltfläche <strong class='text-white'>settings</strong>, um die <strong class='text-white'>Application Settings</strong> zu öffnen, und wechseln Sie dann zum Tab <strong class='text-white'>Accounts</strong>. Hier befinden sich alle Steuerungen auf Kontoebene. Wenn Sie mehr als ein Konto betreiben, achten Sie also darauf, dass Sie das richtige ansehen.", image: {"src":`${IMG}/tradovate-trailing-max-drawdown-1.png`,"alt":"Tradovate Application Settings im Tab Accounts, geöffnet über die Einstellungen-Schaltfläche oben rechts"} },
        { title: "Risk Settings erweitern", html: "Suchen Sie das Konto, das Sie schützen möchten, und klicken Sie auf <strong class='text-white'>Risk Settings</strong>. Die Zeile klappt zu einem Detailbereich auf, der voller Limits steckt: Tagesverlust, Wochenverlust, maximale Positionsgröße und die gesuchten Felder für den Trailing Max Drawdown. Es ist derselbe Bereich, in dem Sie Ihre Tages- und Wochenverlustlimits festlegen, sodass alles Risikobezogene an einem Ort liegt.", image: {"src":`${IMG}/tradovate-trailing-max-drawdown-2.png`,"alt":"Aufgeklapptes Tradovate-Fenster Risk Settings mit den Risikolimit-Feldern auf Kontoebene"} },
        { title: "Den Trailing-Max-Drawdown-Schalter aktivieren", html: "Aktivieren Sie entweder <strong class='text-white'>Real-Time Trailing Max Drawdown</strong> oder <strong class='text-white'>End-of-Day Trailing Max Drawdown</strong> und tragen Sie dann den Dollarbetrag in das Feld daneben ein. Wählen Sie eine Zahl, die dazu passt, wie viel Gegenwind das Konto aushalten kann, bevor der Handel abrupt enden soll, und keine runde Zahl, die Sie ohne Überlegung gegriffen haben.", image: {"src":`${IMG}/tradovate-trailing-max-drawdown-3.png`,"alt":"Trader aktiviert den Trailing-Max-Drawdown-Schalter und trägt in den Tradovate Risk Settings einen Dollarbetrag ein"} },
        { title: "Prüfen Sie die Zahl, bevor Sie speichern", html: "Hier tappen viele in die Falle: <strong class='text-white'>Lassen Sie den Betrag niemals bei $0</strong>. Ein Trailing Max Drawdown von null legt Ihre Linie für die automatische Liquidation genau auf Ihren aktuellen Kontostand, sodass Tradovate offene Positionen sofort liquidiert. Vergewissern Sie sich, dass der Wert Ihnen ein echtes Polster verschafft, und werfen Sie einen Blick auf den Kapitalwert Ihres Kontos, damit Sie wissen, wo die Linie liegt.", image: {"src":`${IMG}/tradovate-trailing-max-drawdown-4.png`,"alt":"Tradovate Risk Settings mit einem Trailing-Max-Drawdown-Wert ungleich null neben dem Kontokapital"} },
        { title: "Nach unten scrollen und speichern", html: "Scrollen Sie ans Ende des Bereichs Risk Settings und klicken Sie auf <strong class='text-white'>Save</strong>. Ohne Speichern wird nichts wirksam, wenn Sie das überspringen, springt Ihr Schalter zurück. Wenn die Einstellung bestehen bleiben soll und Sie sich nicht in einem schlechten Moment selbst lockern wollen, können Sie Ihre Risikoeinstellungen in Tradovate auch sperren, sodass sie mitten in der Sitzung nicht geändert werden können.", image: {"src":`${IMG}/tradovate-trailing-max-drawdown-5.png`,"alt":"Schaltfläche Save am Ende des Tradovate-Bereichs Risk Settings nach Eingabe eines Trailing Max Drawdown"} },
      ],
    },
    { type: "heading",text: "Wenn Sie ein Funded-Konto handeln" },
    { type: "paragraph",html: "Bei einem Prop- oder Evaluierungskonto wird der Trailing Drawdown meist von der Firma festgelegt, nicht von Ihnen, und die Regeln unterscheiden sich von Firma zu Firma. Das anfängliche Polster, ob der Höchststand nicht realisierte Gewinne einbezieht und ob die Linie einfriert, sobald Sie über Ihrem Startkontostand einen Puffer aufgebaut haben, all das variiert je nach Firma und Kontogröße, prüfen Sie daher die aktuellen Regeln Ihrer Firma. Zeigt das Konto bereits einen Drawdown an, den Sie nicht festgelegt haben, ist das die Kontrolle der Firma, und ein Verstoß beendet in der Regel die Evaluierung." },
    { type: "heading",text: "Automatisieren Sie die Trades, behalten Sie die Leitplanke" },
    { type: "paragraph",html: "Ein Trailing Max Drawdown schützt das Konto, kann aber keine Trades platzieren, wenn Sie nicht am Schreibtisch sind. PickMyTrade leitet Ihre TradingView-Alerts direkt an Tradovate weiter, sodass jedes Signal pünktlich ausgeführt wird, während Ihre Risikoeinstellungen im Hintergrund weiter ihre Arbeit tun." },
  ], es: [
    { type: "paragraph",html: "Un trailing max drawdown es un suelo móvil bajo su cuenta. En lugar de un límite de pérdida fijo en dólares que nunca se mueve, sigue su saldo más alto hacia arriba y bloquea la cuenta en cuanto su capital vuelve a caer hasta esa línea móvil. Es el mismo control que usan la mayoría de las prop firms para vigilar sus evaluaciones, y puede configurarlo en su propia cuenta de Tradovate en menos de un minuto." },
    { type: "paragraph",html: "Aquí tiene el cálculo, las dos variantes que ofrece Tradovate y los clics exactos para activarlo." },
    { type: "heading",text: "Cómo se calcula el límite móvil" },
    { type: "paragraph",html: "La fórmula es sencilla: el valor máximo de su cuenta menos su trailing max drawdown es igual al umbral de liquidación automática. Supongamos que empieza con $50,000 y establece un drawdown de $3,000. Su línea comienza en $47,000. Si lleva la cuenta a $55,000, la línea sube a $52,000. Nunca vuelve a bajar: una vez que ha acumulado ganancias, ese colchón queda fijado a su espalda. Si cae hasta la línea, Tradovate cierra sus posiciones y deja la cuenta en modo solo liquidación, por lo que es un stop duro, no una advertencia." },
    { type: "heading",text: "Tiempo real o fin del día: elija su variante" },
    { type: "paragraph",html: "Tradovate divide el trailing max drawdown en dos interruptores, y la diferencia está en <em>cuándo se actualiza el máximo</em>." },
    { type: "table", headers: ["","Tiempo real","Fin del día"], rows: [
      ["Cuándo se actualiza el máximo","De forma continua, tick a tick; cuenta el beneficio abierto (no realizado)","Una vez por sesión, a partir de su saldo de fin del día"],
      ["Qué sensación da","Una correa corta, intradía","Más holgado, apto para swing"],
      ["A qué debe prestar atención","Un pico rápido de beneficio sube la línea y un retroceso posterior puede dejarle atrapado","La línea va por detrás en un día de movimiento rápido, por lo que el riesgo intradía es más laxo"],
    ] },
    { type: "paragraph",html: "Los scalpers y los traders en evaluación suelen preferir la versión en tiempo real porque reacciona en el instante en que una operación entra en pérdidas. Si mantiene posiciones más tiempo y no quiere que una sola mecha mueva su suelo, el fin del día es la opción más tranquila. Cada interruptor es independiente, así que utilice uno u otro." },
    { type: "heading",text: "Cómo establecer un trailing max drawdown, paso a paso" },
    {
      type: "steps",
      items: [
        { title: "Abra Application Settings", html: "Haga clic en el botón <strong class='text-white'>settings</strong> de la esquina superior derecha de la plataforma Tradovate para abrir <strong class='text-white'>Application Settings</strong> y vaya a la pestaña <strong class='text-white'>Accounts</strong>. Aquí residen todos los controles a nivel de cuenta, así que, si tiene más de una cuenta, asegúrese de estar viendo la correcta.", image: {"src":`${IMG}/tradovate-trailing-max-drawdown-1.png`,"alt":"Application Settings de Tradovate abierto en la pestaña Accounts desde el botón de configuración de la esquina superior derecha"} },
        { title: "Expanda Risk Settings", html: "Busque la cuenta que quiere proteger y haga clic en <strong class='text-white'>Risk Settings</strong>. La fila se expande en un panel de detalle lleno de límites: pérdida diaria, pérdida semanal, tamaño máximo de posición y los campos del trailing max drawdown que busca. Es el mismo panel que usaría para fijar sus límites de pérdida diaria y semanal, de modo que todo lo relacionado con el riesgo está en un solo lugar.", image: {"src":`${IMG}/tradovate-trailing-max-drawdown-2.png`,"alt":"Panel Risk Settings de Tradovate expandido con los campos de límite de riesgo a nivel de cuenta"} },
        { title: "Active el interruptor del Trailing Max Drawdown", html: "Active <strong class='text-white'>Real-Time Trailing Max Drawdown</strong> o <strong class='text-white'>End-of-Day Trailing Max Drawdown</strong> y luego escriba el importe en dólares en el cuadro contiguo. Elija una cifra acorde con cuánta presión puede soportar la cuenta antes de que quiera detener las operaciones en seco, no un número redondo tomado sin pensar.", image: {"src":`${IMG}/tradovate-trailing-max-drawdown-3.png`,"alt":"Trader activando el interruptor Trailing Max Drawdown e introduciendo un valor en dólares en Risk Settings de Tradovate"} },
        { title: "Compruebe la cifra antes de guardar", html: "Aquí es donde mucha gente tropieza: <strong class='text-white'>nunca deje el importe en $0</strong>. Un trailing max drawdown de cero coloca su línea de liquidación automática justo en su saldo actual, por lo que Tradovate liquida las posiciones abiertas al instante. Confirme que la cifra le da un colchón real y eche un vistazo al valor del capital de su cuenta para saber dónde está la línea.", image: {"src":`${IMG}/tradovate-trailing-max-drawdown-4.png`,"alt":"Risk Settings de Tradovate mostrando un valor de trailing max drawdown distinto de cero junto al capital de la cuenta"} },
        { title: "Desplácese hacia abajo y guarde", html: "Desplácese hasta la parte inferior del panel Risk Settings y haga clic en <strong class='text-white'>Save</strong>. Nada surte efecto hasta que lo haga; si lo omite, su interruptor se revierte. Si quiere que el ajuste se mantenga y evitar aflojarlo en un mal momento, Tradovate también le permite bloquear sus ajustes de riesgo para que no puedan cambiarse en mitad de la sesión.", image: {"src":`${IMG}/tradovate-trailing-max-drawdown-5.png`,"alt":"Botón Save en la parte inferior del panel Risk Settings de Tradovate tras introducir un trailing max drawdown"} },
      ],
    },
    { type: "heading",text: "Si opera una cuenta fondeada" },
    { type: "paragraph",html: "En una cuenta de prop firm o de evaluación, el trailing drawdown suele establecerlo la firma, no usted, y las reglas difieren de una a otra. El colchón inicial, si el máximo incluye el beneficio no realizado y si la línea se congela una vez que ha acumulado un margen por encima de su saldo inicial varían según la firma y el tamaño de la cuenta, así que consulte las reglas vigentes de su firma. Si la cuenta ya muestra un drawdown que usted no fijó, es un control de la firma, y vulnerarlo suele poner fin a la evaluación." },
    { type: "heading",text: "Automatice las operaciones, conserve la protección" },
    { type: "paragraph",html: "Un trailing max drawdown protege la cuenta, pero no puede colocar sus operaciones cuando usted está lejos del escritorio. PickMyTrade conecta sus alertas de TradingView directamente con Tradovate para que cada señal se ejecute a tiempo, mientras sus ajustes de riesgo siguen haciendo su trabajo en segundo plano." },
  ], fr: [
    { type: "paragraph",html: "Un trailing max drawdown est un plancher mobile sous votre compte. Au lieu d’une limite de perte fixe en dollars qui ne bouge jamais, il suit votre solde le plus élevé vers le haut, puis verrouille le compte dès que votre capital retombe sur cette ligne mobile. C’est le même contrôle que la plupart des prop firms utilisent pour encadrer leurs évaluations, et vous pouvez en définir un sur votre propre compte Tradovate en moins d’une minute." },
    { type: "paragraph",html: "Voici le calcul, les deux variantes proposées par Tradovate et les clics exacts pour l’activer." },
    { type: "heading",text: "Comment la limite mobile est calculée" },
    { type: "paragraph",html: "La formule est simple : le pic de valeur de votre compte moins votre trailing max drawdown égale le seuil de liquidation automatique. Supposons que vous partiez de $50,000 et définissiez un drawdown de $3,000. Votre ligne commence à $47,000. Si le compte monte à $55,000, la ligne passe à $52,000. Elle ne redescend jamais : une fois les gains engrangés, ce coussin reste verrouillé derrière vous. Si le compte tombe jusqu’à la ligne, Tradovate clôture vos positions et place le compte en mode liquidation seule ; il s’agit donc d’un arrêt strict, pas d’un avertissement." },
    { type: "heading",text: "Temps réel ou fin de journée : choisissez votre variante" },
    { type: "paragraph",html: "Tradovate sépare le trailing max drawdown en deux interrupteurs, et la différence tient à <em>l’instant où le point haut est mis à jour</em>." },
    { type: "table", headers: ["","Temps réel","Fin de journée"], rows: [
      ["Quand le pic est mis à jour","En continu, tick par tick ; le profit ouvert (latent) compte","Une fois par séance, d’après votre solde de fin de journée"],
      ["Impression générale","Une laisse courte, en intraday","Plus de marge, adapté au swing"],
      ["Points de vigilance","Un pic de profit rapide relève la ligne, puis un repli peut vous piéger","La ligne accuse un retard sur une journée rapide, si bien que le risque en intraday est plus lâche"],
    ] },
    { type: "paragraph",html: "Les scalpeurs et les traders en évaluation préfèrent généralement la version en temps réel, car elle réagit à l’instant où un trade passe dans le rouge. Si vous conservez vos positions plus longtemps et ne voulez pas qu’une seule mèche déplace votre plancher, la fin de journée est le choix le plus serein. Chaque interrupteur est indépendant ; utilisez donc l’un ou l’autre." },
    { type: "heading",text: "Comment définir un trailing max drawdown, pas à pas" },
    {
      type: "steps",
      items: [
        { title: "Ouvrez Application Settings", html: "Cliquez sur le bouton <strong class='text-white'>settings</strong> dans le coin supérieur droit de la plateforme Tradovate pour ouvrir <strong class='text-white'>Application Settings</strong>, puis rendez-vous dans l’onglet <strong class='text-white'>Accounts</strong>. C’est ici que se trouvent tous les contrôles au niveau du compte ; si vous gérez plusieurs comptes, assurez-vous donc de consulter le bon.", image: {"src":`${IMG}/tradovate-trailing-max-drawdown-1.png`,"alt":"Application Settings de Tradovate ouvert sur l’onglet Accounts depuis le bouton de paramètres en haut à droite"} },
        { title: "Développez Risk Settings", html: "Repérez le compte que vous souhaitez protéger et cliquez sur <strong class='text-white'>Risk Settings</strong>. La ligne se déploie en un panneau détaillé rempli de limites : perte quotidienne, perte hebdomadaire, taille de position maximale et les champs du trailing max drawdown que vous cherchez. C’est le même panneau que vous utiliseriez pour fixer vos limites de perte quotidienne et hebdomadaire ; tout ce qui touche au risque est donc au même endroit.", image: {"src":`${IMG}/tradovate-trailing-max-drawdown-2.png`,"alt":"Panneau Risk Settings de Tradovate déployé affichant les champs de limites de risque au niveau du compte"} },
        { title: "Activez l’interrupteur Trailing Max Drawdown", html: "Activez soit <strong class='text-white'>Real-Time Trailing Max Drawdown</strong>, soit <strong class='text-white'>End-of-Day Trailing Max Drawdown</strong>, puis saisissez votre montant en dollars dans la case voisine. Choisissez un chiffre qui correspond à la pression que le compte peut encaisser avant que vous ne vouliez stopper net le trading, et non un chiffre rond pris sans réfléchir.", image: {"src":`${IMG}/tradovate-trailing-max-drawdown-3.png`,"alt":"Trader activant l’interrupteur Trailing Max Drawdown et saisissant un montant en dollars dans les Risk Settings de Tradovate"} },
        { title: "Vérifiez le chiffre avant d’enregistrer", html: "C’est ici que beaucoup trébuchent : <strong class='text-white'>ne laissez jamais le montant à $0</strong>. Un trailing max drawdown de zéro place votre ligne de liquidation automatique exactement sur votre solde actuel, si bien que Tradovate liquide immédiatement les positions ouvertes. Vérifiez que le chiffre vous offre un vrai coussin et jetez un œil à la valeur du capital de votre compte pour savoir où se situe la ligne.", image: {"src":`${IMG}/tradovate-trailing-max-drawdown-4.png`,"alt":"Risk Settings de Tradovate affichant une valeur de trailing max drawdown non nulle à côté du capital du compte"} },
        { title: "Faites défiler vers le bas et enregistrez", html: "Faites défiler jusqu’au bas du panneau Risk Settings et cliquez sur <strong class='text-white'>Save</strong>. Rien ne prend effet tant que vous ne l’avez pas fait ; si vous l’oubliez, votre interrupteur revient en arrière. Si vous voulez que le paramètre tienne et éviter de l’assouplir dans un mauvais moment, Tradovate vous permet aussi de verrouiller vos paramètres de risque afin qu’ils ne puissent pas être modifiés en pleine séance.", image: {"src":`${IMG}/tradovate-trailing-max-drawdown-5.png`,"alt":"Bouton Save en bas du panneau Risk Settings de Tradovate après la saisie d’un trailing max drawdown"} },
      ],
    },
    { type: "heading",text: "Si vous tradez un compte financé" },
    { type: "paragraph",html: "Sur un compte de prop firm ou d’évaluation, le trailing drawdown est généralement défini par la firme, pas par vous, et les règles diffèrent d’une structure à l’autre. Le coussin de départ, le fait que le pic inclue ou non le profit latent et le fait que la ligne se fige une fois que vous avez constitué une marge au-dessus de votre solde initial varient selon la firme et la taille du compte ; vérifiez donc les règles actuelles de votre firme. Si le compte affiche déjà un drawdown que vous n’avez pas défini, il s’agit du contrôle de la firme, et le franchir met généralement fin à l’évaluation." },
    { type: "heading",text: "Automatisez les trades, gardez le garde-fou" },
    { type: "paragraph",html: "Un trailing max drawdown protège le compte, mais il ne peut pas passer vos trades lorsque vous êtes loin de votre bureau. PickMyTrade relie vos alertes TradingView directement à Tradovate afin que chaque signal s’exécute à temps, tandis que vos paramètres de risque continuent de faire leur travail en arrière-plan." },
  ], it: [
    { type: "paragraph",html: "Un trailing max drawdown è un pavimento mobile sotto il suo conto. Invece di un limite di perdita fisso in dollari che non si muove mai, segue verso l’alto il suo saldo più alto e blocca il conto nel momento in cui il capitale ricade su quella linea mobile. È lo stesso controllo che la maggior parte delle prop firm usa per sorvegliare le proprie valutazioni, e può impostarlo sul suo conto Tradovate in meno di un minuto." },
    { type: "paragraph",html: "Ecco il calcolo, le due varianti offerte da Tradovate e i clic esatti per attivarlo." },
    { type: "heading",text: "Come viene calcolato il limite mobile" },
    { type: "paragraph",html: "La formula è semplice: il picco del valore del suo conto meno il suo trailing max drawdown dà la soglia di liquidazione automatica. Ipotizziamo che parta da $50,000 e imposti un drawdown di $3,000. La sua linea parte da $47,000. Se porta il conto a $55,000, la linea sale a $52,000. Non scende mai di nuovo: una volta accumulati i guadagni, quel cuscinetto resta bloccato alle sue spalle. Se il conto scende fino alla linea, Tradovate chiude le sue posizioni e porta il conto in modalità di sola liquidazione, quindi si tratta di uno stop rigido, non di un avviso." },
    { type: "heading",text: "Tempo reale o fine giornata: scelga la sua variante" },
    { type: "paragraph",html: "Tradovate divide il trailing max drawdown in due interruttori, e la differenza sta nel <em>momento in cui viene aggiornato il massimo</em>." },
    { type: "table", headers: ["","Tempo reale","Fine giornata"], rows: [
      ["Quando si aggiorna il picco","In continuo, tick per tick; conta il profitto aperto (non realizzato)","Una volta per sessione, in base al suo saldo di fine giornata"],
      ["Che sensazione dà","Un guinzaglio corto, intraday","Più ampio, adatto allo swing"],
      ["A cosa prestare attenzione","Un rapido picco di profitto alza la linea, poi un ritracciamento può intrappolarla","La linea resta indietro in una giornata veloce, quindi il rischio intraday è più lasco"],
    ] },
    { type: "paragraph",html: "Gli scalper e i trader in valutazione di solito preferiscono la versione in tempo reale perché reagisce nell’istante in cui un trade va in perdita. Se mantiene le posizioni più a lungo e non vuole che una singola candela sposti il suo pavimento, la fine giornata è la scelta più tranquilla. Ogni interruttore è indipendente, quindi ne usi uno o l’altro." },
    { type: "heading",text: "Come impostare un trailing max drawdown, passo dopo passo" },
    {
      type: "steps",
      items: [
        { title: "Apra Application Settings", html: "Clicchi sul pulsante <strong class='text-white'>settings</strong> nell’angolo in alto a destra della piattaforma Tradovate per aprire <strong class='text-white'>Application Settings</strong>, poi vada alla scheda <strong class='text-white'>Accounts</strong>. Qui si trovano tutti i controlli a livello di conto, quindi, se gestisce più di un conto, si assicuri di guardare quello giusto.", image: {"src":`${IMG}/tradovate-trailing-max-drawdown-1.png`,"alt":"Application Settings di Tradovate aperto sulla scheda Accounts dal pulsante delle impostazioni in alto a destra"} },
        { title: "Espanda Risk Settings", html: "Trovi il conto che vuole proteggere e clicchi su <strong class='text-white'>Risk Settings</strong>. La riga si espande in un pannello di dettaglio pieno di limiti: perdita giornaliera, perdita settimanale, dimensione massima della posizione e i campi del trailing max drawdown che cerca. È lo stesso pannello che userebbe per impostare i limiti di perdita giornaliera e settimanale, quindi tutto ciò che riguarda il rischio si trova in un unico posto.", image: {"src":`${IMG}/tradovate-trailing-max-drawdown-2.png`,"alt":"Pannello Risk Settings di Tradovate espanso con i campi dei limiti di rischio a livello di conto"} },
        { title: "Attivi l’interruttore del Trailing Max Drawdown", html: "Attivi <strong class='text-white'>Real-Time Trailing Max Drawdown</strong> oppure <strong class='text-white'>End-of-Day Trailing Max Drawdown</strong>, poi digiti l’importo in dollari nella casella accanto. Scelga una cifra in linea con quanta pressione il conto può sopportare prima che voglia fermare di netto l’operatività, non un numero tondo preso senza riflettere.", image: {"src":`${IMG}/tradovate-trailing-max-drawdown-3.png`,"alt":"Trader che attiva l’interruttore Trailing Max Drawdown e inserisce un valore in dollari nei Risk Settings di Tradovate"} },
        { title: "Controlli la cifra prima di salvare", html: "Qui molti inciampano: <strong class='text-white'>non lasci mai l’importo a $0</strong>. Un trailing max drawdown pari a zero colloca la sua linea di liquidazione automatica esattamente sul saldo attuale, quindi Tradovate liquida subito le posizioni aperte. Si assicuri che la cifra le dia un vero margine e dia un’occhiata al valore del capitale del suo conto per sapere dove si trova la linea.", image: {"src":`${IMG}/tradovate-trailing-max-drawdown-4.png`,"alt":"Risk Settings di Tradovate con un valore di trailing max drawdown diverso da zero accanto al capitale del conto"} },
        { title: "Scorra in basso e salvi", html: "Scorra fino in fondo al pannello Risk Settings e clicchi su <strong class='text-white'>Save</strong>. Nulla ha effetto finché non lo fa; se salta questo passaggio, l’interruttore torna indietro. Se vuole che l’impostazione resti e impedirsi di allentarla in un momento sbagliato, Tradovate le permette anche di bloccare le impostazioni di rischio in modo che non possano essere modificate a sessione in corso.", image: {"src":`${IMG}/tradovate-trailing-max-drawdown-5.png`,"alt":"Pulsante Save in fondo al pannello Risk Settings di Tradovate dopo aver inserito un trailing max drawdown"} },
      ],
    },
    { type: "heading",text: "Se opera con un conto finanziato" },
    { type: "paragraph",html: "Su un conto prop o di valutazione, il trailing drawdown è di solito impostato dalla società, non da lei, e le regole differiscono da una all’altra. Il cuscinetto iniziale, il fatto che il picco includa il profitto non realizzato e il fatto che la linea si congeli una volta costruito un margine sopra il saldo iniziale variano in base alla società e alla dimensione del conto, quindi verifichi le regole attuali della sua società. Se il conto mostra già un drawdown che non ha impostato lei, è un controllo della società, e superarlo di norma pone fine alla valutazione." },
    { type: "heading",text: "Automatizzi i trade, mantenga la protezione" },
    { type: "paragraph",html: "Un trailing max drawdown protegge il conto, ma non può inserire i suoi trade quando lei è lontano dalla scrivania. PickMyTrade collega i suoi alert di TradingView direttamente a Tradovate in modo che ogni segnale venga eseguito puntualmente, mentre le sue impostazioni di rischio continuano a lavorare in background." },
  ] },
  ctaHeading: { en: "Automate the Trades, Keep the Guardrail", de: "Automatisieren Sie die Trades, behalten Sie die Leitplanke", es: "Automatice las operaciones, conserve la protección", fr: "Automatisez les trades, gardez le garde-fou", it: "Automatizzi i trade, mantenga la protezione" },
  ctaText: { en: "PickMyTrade wires your TradingView alerts straight into Tradovate so every signal executes on time, with your risk settings still doing their job in the background.", de: "PickMyTrade leitet Ihre TradingView-Alerts direkt an Tradovate weiter, sodass jedes Signal pünktlich ausgeführt wird, während Ihre Risikoeinstellungen im Hintergrund weiter ihre Arbeit tun.", es: "PickMyTrade conecta sus alertas de TradingView directamente con Tradovate para que cada señal se ejecute a tiempo, mientras sus ajustes de riesgo siguen haciendo su trabajo en segundo plano.", fr: "PickMyTrade relie vos alertes TradingView directement à Tradovate afin que chaque signal s’exécute à temps, tandis que vos paramètres de risque continuent de faire leur travail en arrière-plan.", it: "PickMyTrade collega i suoi alert di TradingView direttamente a Tradovate in modo che ogni segnale venga eseguito puntualmente, mentre le sue impostazioni di rischio continuano a lavorare in background." },
  ctaButtonText: { en: "Start Your Free 7-Day Trial", de: "Starten Sie Ihre kostenlose 7-Tage-Testphase", es: "Comience su prueba gratuita de 7 días", fr: "Commencez votre essai gratuit de 7 jours", it: "Inizi la prova gratuita di 7 giorni" },
  ctaUrl: "https://app.pickmytrade.trade/?register=true&utm_source=content&utm_medium=how-to",
  faqHeading: { en: "Frequently Asked Questions", de: "Häufig gestellte Fragen", es: "Preguntas frecuentes", fr: "Questions fréquentes", it: "Domande frequenti" },
  faqs: { en: [
    { q: "Does the trailing max drawdown ever move back down?", a: "No. It only ratchets up with your peak account value and then holds. A later drawdown won't lower it, that locked-in level is exactly what makes it \"trailing.\"" },
    { q: "What's the difference between this and a daily loss limit?", a: "A daily loss limit resets each session and caps a single day's loss. A trailing max drawdown follows your all-time peak balance and never resets, protecting cumulative gains across your whole run." },
    { q: "What happens the moment my equity hits the line?", a: "Tradovate liquidates your open positions and locks the account out of new trades. There's no grace period, so keep a buffer and treat the line as untouchable." },
  ], de: [
    { q: "Bewegt sich der Trailing Max Drawdown jemals wieder nach unten?", a: "Nein. Er steigt nur mit Ihrem Höchststand des Kontowerts und bleibt dann stehen. Ein späterer Drawdown senkt ihn nicht, genau dieses festgeschriebene Niveau macht ihn „trailing“." },
    { q: "Was ist der Unterschied zu einem Tagesverlustlimit?", a: "Ein Tagesverlustlimit wird jede Sitzung zurückgesetzt und begrenzt den Verlust eines einzelnen Tages. Ein Trailing Max Drawdown folgt Ihrem historischen Höchststand des Kontostands und wird nie zurückgesetzt, sodass er kumulierte Gewinne über Ihren gesamten Verlauf schützt." },
    { q: "Was passiert, sobald mein Kapital die Linie erreicht?", a: "Tradovate liquidiert Ihre offenen Positionen und sperrt das Konto für neue Trades. Es gibt keine Nachfrist, halten Sie also einen Puffer und behandeln Sie die Linie als unantastbar." },
  ], es: [
    { q: "¿El trailing max drawdown vuelve a bajar alguna vez?", a: "No. Solo sube con el máximo valor de su cuenta y luego se mantiene. Un drawdown posterior no lo reduce; ese nivel bloqueado es precisamente lo que lo hace «trailing»." },
    { q: "¿Qué diferencia hay con un límite de pérdida diaria?", a: "Un límite de pérdida diaria se reinicia cada sesión y limita la pérdida de un solo día. Un trailing max drawdown sigue su saldo máximo histórico y nunca se reinicia, protegiendo las ganancias acumuladas durante todo su recorrido." },
    { q: "¿Qué ocurre en el momento en que mi capital toca la línea?", a: "Tradovate liquida sus posiciones abiertas y bloquea la cuenta para nuevas operaciones. No hay periodo de gracia, así que mantenga un colchón y trate la línea como intocable." },
  ], fr: [
    { q: "Le trailing max drawdown redescend-il jamais ?", a: "Non. Il ne monte qu’avec le pic de valeur de votre compte, puis reste en place. Un drawdown ultérieur ne l’abaisse pas ; c’est précisément ce niveau verrouillé qui le rend « trailing »." },
    { q: "Quelle est la différence avec une limite de perte quotidienne ?", a: "Une limite de perte quotidienne se réinitialise à chaque séance et plafonne la perte d’une seule journée. Un trailing max drawdown suit votre pic de solde historique et ne se réinitialise jamais, protégeant ainsi les gains cumulés sur l’ensemble de votre parcours." },
    { q: "Que se passe-t-il dès que mon capital touche la ligne ?", a: "Tradovate liquide vos positions ouvertes et verrouille le compte pour tout nouveau trade. Il n’y a pas de délai de grâce ; gardez donc une marge de sécurité et considérez la ligne comme intouchable." },
  ], it: [
    { q: "Il trailing max drawdown scende mai di nuovo?", a: "No. Sale solo con il picco del valore del suo conto e poi resta fermo. Un drawdown successivo non lo abbassa: quel livello bloccato è esattamente ciò che lo rende «trailing»." },
    { q: "Qual è la differenza rispetto a un limite di perdita giornaliera?", a: "Un limite di perdita giornaliera si azzera a ogni sessione e limita la perdita di un singolo giorno. Un trailing max drawdown segue il suo massimo storico del saldo e non si azzera mai, proteggendo i guadagni cumulati lungo tutto il suo percorso." },
    { q: "Che cosa succede nel momento in cui il mio capitale tocca la linea?", a: "Tradovate liquida le sue posizioni aperte e blocca il conto per nuovi trade. Non esiste un periodo di tolleranza, quindi mantenga un margine di sicurezza e consideri la linea intoccabile." },
  ] },
  relatedHeading: { en: "Related Guides", de: "Verwandte Anleitungen", es: "Guías relacionadas", fr: "Guides associés", it: "Guide correlate" },
  disclosureText: { en: `This guide is for educational and informational purposes only and is not financial, investment, or trading advice. Trading futures and other leveraged products carries a substantial risk of loss and is not suitable for every investor. PickMyTrade is an independent third-party automation platform and is not affiliated with, endorsed by, or sponsored by Tradovate, Inc. "Tradovate" and all related names, logos, and trademarks are the property of their respective owners. Platform features and steps change over time, so always confirm the current process in the official Tradovate platform and documentation before acting.`, de: "Dieser Leitfaden dient ausschließlich Bildungs- und Informationszwecken und stellt keine Finanz-, Anlage- oder Handelsberatung dar. Der Handel mit Futures und anderen gehebelten Produkten birgt ein erhebliches Verlustrisiko und ist nicht für jeden Anleger geeignet. PickMyTrade ist eine unabhängige Automatisierungsplattform eines Drittanbieters und steht in keiner Verbindung zu Tradovate, Inc., wird nicht von Tradovate, Inc. unterstützt und nicht von Tradovate, Inc. gesponsert. „Tradovate“ sowie alle zugehörigen Namen, Logos und Marken sind Eigentum ihrer jeweiligen Inhaber. Funktionen und Schritte der Plattform ändern sich im Laufe der Zeit. Bestätigen Sie daher stets den aktuellen Ablauf in der offiziellen Tradovate-Plattform und -Dokumentation, bevor Sie handeln.", es: "Esta guía tiene fines exclusivamente educativos e informativos y no constituye asesoramiento financiero, de inversión ni de trading. Operar con futuros y otros productos apalancados conlleva un riesgo sustancial de pérdida y no es adecuado para todos los inversores. PickMyTrade es una plataforma de automatización independiente de terceros y no está afiliada, respaldada ni patrocinada por Tradovate, Inc. «Tradovate» y todos los nombres, logotipos y marcas relacionados son propiedad de sus respectivos dueños. Las funciones y los pasos de la plataforma cambian con el tiempo, por lo que debe confirmar siempre el proceso vigente en la plataforma y la documentación oficiales de Tradovate antes de actuar.", fr: "Ce guide est fourni à des fins éducatives et informatives uniquement et ne constitue pas un conseil financier, d’investissement ou de trading. Le trading de contrats à terme et d’autres produits à effet de levier comporte un risque de perte substantiel et ne convient pas à tous les investisseurs. PickMyTrade est une plateforme d’automatisation tierce indépendante, non affiliée à Tradovate, Inc., ni approuvée ou parrainée par celle-ci. « Tradovate » ainsi que tous les noms, logos et marques associés sont la propriété de leurs détenteurs respectifs. Les fonctionnalités et les étapes de la plateforme évoluent avec le temps ; vérifiez donc toujours la procédure en vigueur dans la plateforme et la documentation officielles de Tradovate avant d’agir.", it: "Questa guida ha scopo esclusivamente educativo e informativo e non costituisce consulenza finanziaria, di investimento o di trading. Il trading di futures e di altri prodotti a leva comporta un rischio di perdita sostanziale e non è adatto a tutti gli investitori. PickMyTrade è una piattaforma di automazione indipendente di terze parti e non è affiliata, approvata o sponsorizzata da Tradovate, Inc. «Tradovate» e tutti i nomi, loghi e marchi correlati sono di proprietà dei rispettivi titolari. Le funzioni e i passaggi della piattaforma cambiano nel tempo, perciò confermi sempre la procedura attuale nella piattaforma e nella documentazione ufficiali di Tradovate prima di agire." },
};
