---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "tradovate-reverse-position";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/how-to/${SLUG}`;

const META_TITLE = "Reverse an Open Position in Tradovate";
const META_DESCRIPTION =
  "Flip an open futures position from long to short in one click with the Reverse and Cancel button on the DOM. Includes steps and the key brackets caveat.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Eine offene Position in Tradovate umkehren", es: "Invertir una posición abierta en Tradovate", fr: "Inverser une position ouverte dans Tradovate", it: "Invertire una posizione aperta in Tradovate" },
  dek: { en: "Want out of a long and into a short in one click? Here's exactly how Tradovate's Reverse & Cxl button works, and the one thing that catches people out.", de: "Raus aus dem Long und mit einem Klick rein in den Short? So funktioniert die Schaltfläche Reverse & Cxl von Tradovate genau, und das ist die eine Sache, die viele überrascht.", es: "¿Quiere salir de un largo y entrar en un corto con un solo clic? Así funciona exactamente el botón Reverse & Cxl de Tradovate y lo único que suele pillar a la gente por sorpresa.", fr: "Sortir d'un long et passer à découvert en un seul clic ? Voici exactement comment fonctionne le bouton Reverse & Cxl de Tradovate, et le point qui piège souvent les traders.", it: "Vuole uscire da un long ed entrare in uno short con un solo clic? Ecco esattamente come funziona il pulsante Reverse & Cxl di Tradovate e l'unica cosa che coglie di sorpresa molti trader." },
  readTime: { en: "5 min read", de: "5 Min. Lesezeit", es: "Lectura de 5 min", fr: "Lecture : 5 min", it: "Lettura di 5 min" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "You're long two contracts, the trade turns against you, and you don't just want out. You want to be short. Closing the position and then placing a fresh sell order is two actions and a few seconds you might not have. Tradovate folds both into a single click with the <strong class='text-white'>Reverse &amp; Cxl</strong> button. Here's exactly how it behaves and the one thing that catches people out." },
    { type: "image", src: `${IMG}/tradovate-reverse-position-1.png`, alt: "Tradovate SuperDOM open with an active long MNQ position and quantity selector" },
    { type: "heading", text: "What \"Reverse & Cxl\" Actually Does" },
    { type: "paragraph", html: "Reverse &amp; Cxl is short for Reverse and Cancel. Click it and Tradovate exits your current position at market and opens an equal position in the opposite direction, also at market, for whatever instrument is loaded in that module. Any working orders on that instrument are cancelled at the same time." },
    { type: "paragraph", html: "The mechanic is worth understanding before you rely on it. Say you're long 2 MNQ. The button doesn't send a 2-lot sell to flatten. It fires a market order for double your size, 4 contracts. Two of those close the long, the other two open a fresh 2-lot short. You go flat-then-short in one fill, same quantity, opposite direction." },
    { type: "heading", text: "Reverse a Position: Step-by-Step" },
    {
      type: "steps",
      items: [
        { title: "Open the DOM for Your Instrument", html: "Load the SuperDOM ladder, or a chart with trading turned on, for the exact contract you're holding. The Reverse button only touches the instrument loaded in that module, so make sure you're looking at the right one.", image: { src: `${IMG}/tradovate-reverse-position-2.png`, alt: "Open position and working orders shown on the Tradovate DOM before reversing" } },
        { title: "Confirm Your Open Position and Working Orders", html: "Check that you actually have a live position on this contract and take note of any working orders sitting on it. Reversing cancels those orders, so anything you want to keep needs a second thought first." },
        { title: "Set the Action Button to Reverse & Cxl", html: "Tradovate's order-entry panel has a configurable action button in the middle. Use its dropdown to switch it to <strong class='text-white'>Reverse &amp; Cxl</strong> if it's currently set to Exit at Mkt &amp; Cxl. The exact label and placement of this button can shift between platform versions, so confirm it before you're in a live trade.", image: { src: `${IMG}/tradovate-reverse-position-3.png`, alt: "Dropdown on the Tradovate DOM action button set to Reverse and Cancel" } },
        { title: "Click Reverse & Cxl to Flip", html: "One click sends the double-size market order. Your position closes and an equal position opens in the opposite direction, and Tradovate cancels the working orders on that instrument. Watch the fill confirm before you do anything else.", image: { src: `${IMG}/tradovate-reverse-position-4.png`, alt: "Reverse and Cancel button clicked, flipping the position from long to short at market" } },
        { title: "Re-attach Your Stop and Target", html: "This is the part that trips people up. The new opposite position opens naked. Whatever bracket or ATM strategy protected your old position does not carry over. Set your stop-loss and take-profit on the new position right away, before you look at anything else on the screen.", image: { src: `${IMG}/tradovate-reverse-position-5.png`, alt: "New short position on the DOM with a fresh stop-loss and take-profit attached" } },
      ],
    },
    { type: "heading", text: "What to Watch Out For" },
    {
      type: "table",
      headers: ["Watch out for", "What it means"],
      rows: [
        ["Per-instrument scope", "The button only affects the instrument loaded in that DOM. A ladder showing MNQ won't touch an open ES position."],
        ["Brackets don't follow", "If your original position had an attached stop and target, the new position opens without them. Re-attach manually every time."],
        ["Two fills, not one", "You pay commission on the closing contracts and the opening contracts, and you cross the spread twice. Reversing isn't free."],
        ["Prop firm limits", "The double-size market order can push you against a max-position or contract limit, which varies by firm and account size. Check your firm's current rules."],
      ],
    },
    { type: "heading", text: "The Manual Alternative" },
    { type: "paragraph", html: "If you'd rather not fire a double-size market order, do it in two moves instead: flatten the position, then place a new order in the other direction. It's a step slower, but you keep full control of your sizing and can attach a bracket to the new entry from the start rather than scrambling to add one after the fact." },
    { type: "paragraph", html: "One thing Tradovate doesn't do natively is an automatic stop-and-reverse, where a hit stop instantly flips you into the opposite trade. The Reverse &amp; Cxl button is a manual action. You have to click it." },
    { type: "heading", text: "Automate This with PickMyTrade" },
    { type: "paragraph", html: "Reversing by hand every time a signal flips gets old fast. If your entries come from TradingView, <strong class='text-white'>PickMyTrade can open and flip Tradovate positions automatically</strong> the moment your alert fires." },
  ], de: [
    { type: "paragraph",html: "Sie sind mit zwei Kontrakten long, der Trade läuft gegen Sie, und Sie wollen nicht nur raus. Sie wollen short sein. Die Position zu schließen und dann eine neue Verkaufsorder zu platzieren, sind zwei Aktionen und ein paar Sekunden, die Sie vielleicht nicht haben. Tradovate fasst beides mit der Schaltfläche <strong class='text-white'>Reverse &amp; Cxl</strong> in einem einzigen Klick zusammen. Hier sehen Sie genau, wie sie sich verhält und was viele überrascht." },
    { type: "image",src: `${IMG}/tradovate-reverse-position-1.png`,alt: "Tradovate SuperDOM mit einer aktiven Long-MNQ-Position und Mengenauswahl geöffnet" },
    { type: "heading",text: "Was „Reverse & Cxl“ tatsächlich macht" },
    { type: "paragraph",html: "Reverse &amp; Cxl steht für „Reverse and Cancel“ (Umkehren und Stornieren). Wenn Sie klicken, schließt Tradovate Ihre aktuelle Position zum Marktpreis und eröffnet eine gleich große Position in Gegenrichtung, ebenfalls zum Marktpreis, für das Instrument, das in diesem Modul geladen ist. Alle aktiven Orders auf diesem Instrument werden gleichzeitig storniert." },
    { type: "paragraph",html: "Die Mechanik sollten Sie verstehen, bevor Sie sich darauf verlassen. Angenommen, Sie sind 2 MNQ long. Die Schaltfläche sendet keine 2-Lot-Verkaufsorder zum Glattstellen. Sie löst eine Market-Order über die doppelte Größe aus, also 4 Kontrakte. Zwei davon schließen den Long, die anderen zwei eröffnen einen neuen 2-Lot-Short. Sie gehen in einem Fill von Long auf Short, gleiche Menge, entgegengesetzte Richtung." },
    { type: "heading",text: "Eine Position umkehren: Schritt für Schritt" },
    {
      type: "steps",
      items: [
        { title: "Das DOM für Ihr Instrument öffnen", html: "Laden Sie die SuperDOM-Leiter oder einen Chart mit aktiviertem Trading für genau den Kontrakt, den Sie halten. Die Reverse-Schaltfläche wirkt nur auf das Instrument, das in diesem Modul geladen ist, achten Sie also darauf, das richtige zu betrachten.", image: {"src":`${IMG}/tradovate-reverse-position-2.png`,"alt":"Offene Position und aktive Orders im Tradovate-DOM vor dem Umkehren"} },
        { title: "Offene Position und aktive Orders prüfen", html: "Prüfen Sie, ob Sie tatsächlich eine laufende Position in diesem Kontrakt haben, und notieren Sie alle aktiven Orders darauf. Das Umkehren storniert diese Orders, daher sollten Sie vorher gut überlegen, was Sie behalten möchten." },
        { title: "Die Aktionsschaltfläche auf Reverse & Cxl stellen", html: "Das Orderfenster von Tradovate hat in der Mitte eine konfigurierbare Aktionsschaltfläche. Stellen Sie sie über das Dropdown auf <strong class='text-white'>Reverse &amp; Cxl</strong> um, falls sie derzeit auf Exit at Mkt &amp; Cxl steht. Genaue Bezeichnung und Position dieser Schaltfläche können sich zwischen Plattformversionen unterscheiden, prüfen Sie sie daher, bevor Sie in einem Live-Trade sind.", image: {"src":`${IMG}/tradovate-reverse-position-3.png`,"alt":"Dropdown der Aktionsschaltfläche im Tradovate-DOM auf Reverse and Cancel eingestellt"} },
        { title: "Auf Reverse & Cxl klicken, um zu drehen", html: "Ein Klick sendet die Market-Order mit doppelter Größe. Ihre Position wird geschlossen, eine gleich große Position in Gegenrichtung wird eröffnet, und Tradovate storniert die aktiven Orders auf diesem Instrument. Warten Sie die Bestätigung des Fills ab, bevor Sie etwas anderes tun.", image: {"src":`${IMG}/tradovate-reverse-position-4.png`,"alt":"Reverse-and-Cancel-Schaltfläche geklickt, die Position wird zum Marktpreis von Long auf Short gedreht"} },
        { title: "Stop und Target neu setzen", html: "Hier stolpern viele. Die neue Gegenposition wird ohne Schutz eröffnet. Das Bracket oder die ATM-Strategie, die Ihre alte Position abgesichert hat, wird nicht übernommen. Setzen Sie Stop-Loss und Take-Profit sofort auf der neuen Position, bevor Sie sich irgendetwas anderes auf dem Bildschirm ansehen.", image: {"src":`${IMG}/tradovate-reverse-position-5.png`,"alt":"Neue Short-Position im DOM mit frisch gesetztem Stop-Loss und Take-Profit"} },
      ],
    },
    { type: "heading",text: "Worauf Sie achten sollten" },
    { type: "table", headers: ["Darauf achten","Was es bedeutet"], rows: [
      ["Geltung pro Instrument","Die Schaltfläche wirkt nur auf das Instrument, das in diesem DOM geladen ist. Eine Leiter mit MNQ berührt eine offene ES-Position nicht."],
      ["Brackets werden nicht übernommen","Hatte Ihre ursprüngliche Position einen angehängten Stop und ein Target, wird die neue Position ohne sie eröffnet. Hängen Sie sie jedes Mal manuell neu an."],
      ["Zwei Fills, nicht einer","Sie zahlen Kommission für die schließenden und die eröffnenden Kontrakte und überqueren den Spread zweimal. Umkehren ist nicht kostenlos."],
      ["Limits der Prop Firm","Die Market-Order mit doppelter Größe kann Sie an ein Limit für maximale Position oder Kontraktzahl bringen, das je nach Firma und Kontogröße variiert. Prüfen Sie die aktuellen Regeln Ihrer Firma."],
    ] },
    { type: "heading",text: "Die manuelle Alternative" },
    { type: "paragraph",html: "Wenn Sie keine Market-Order mit doppelter Größe auslösen möchten, gehen Sie in zwei Schritten vor: Position glattstellen und dann eine neue Order in die andere Richtung platzieren. Das ist einen Schritt langsamer, aber Sie behalten die volle Kontrolle über Ihre Größe und können dem neuen Einstieg von Anfang an ein Bracket mitgeben, statt hinterher hektisch eines nachzuziehen." },
    { type: "paragraph",html: "Einen automatischen Stop-and-Reverse, bei dem ein ausgelöster Stop Sie sofort in den entgegengesetzten Trade dreht, bietet Tradovate nativ nicht. Die Schaltfläche Reverse &amp; Cxl ist eine manuelle Aktion. Sie müssen sie anklicken." },
    { type: "heading",text: "Automatisieren Sie das mit PickMyTrade" },
    { type: "paragraph",html: "Jedes Mal von Hand umzukehren, wenn ein Signal kippt, nervt schnell. Wenn Ihre Einstiege aus TradingView kommen, kann <strong class='text-white'>PickMyTrade Tradovate-Positionen automatisch eröffnen und umdrehen</strong>, sobald Ihr Alert ausgelöst wird." },
  ], es: [
    { type: "paragraph",html: "Está largo en dos contratos, la operación se vuelve en su contra y no solo quiere salir. Quiere estar corto. Cerrar la posición y luego colocar una nueva orden de venta son dos acciones y unos segundos que quizá no tenga. Tradovate reúne ambas en un solo clic con el botón <strong class='text-white'>Reverse &amp; Cxl</strong>. Veamos exactamente cómo se comporta y lo único que suele sorprender." },
    { type: "image",src: `${IMG}/tradovate-reverse-position-1.png`,alt: "SuperDOM de Tradovate abierto con una posición larga activa en MNQ y el selector de cantidad" },
    { type: "heading",text: "Qué hace realmente «Reverse & Cxl»" },
    { type: "paragraph",html: "Reverse &amp; Cxl es la abreviatura de Reverse and Cancel (invertir y cancelar). Al hacer clic, Tradovate cierra su posición actual a mercado y abre una posición igual en sentido contrario, también a mercado, para el instrumento cargado en ese módulo. Las órdenes activas de ese instrumento se cancelan al mismo tiempo." },
    { type: "paragraph",html: "Conviene entender la mecánica antes de confiar en ella. Supongamos que está largo en 2 MNQ. El botón no envía una venta de 2 lotes para cerrar. Lanza una orden a mercado por el doble de su tamaño, 4 contratos. Dos de ellos cierran el largo y los otros dos abren un nuevo corto de 2 lotes. Pasa de largo a corto en una sola ejecución, misma cantidad, dirección opuesta." },
    { type: "heading",text: "Invertir una posición: paso a paso" },
    {
      type: "steps",
      items: [
        { title: "Abra el DOM de su instrumento", html: "Cargue la escalera SuperDOM, o un gráfico con el trading activado, para el contrato exacto que mantiene. El botón Reverse solo afecta al instrumento cargado en ese módulo, así que asegúrese de estar mirando el correcto.", image: {"src":`${IMG}/tradovate-reverse-position-2.png`,"alt":"Posición abierta y órdenes activas en el DOM de Tradovate antes de invertir"} },
        { title: "Confirme su posición abierta y sus órdenes activas", html: "Compruebe que realmente tiene una posición en vigor en este contrato y anote las órdenes activas que haya sobre él. Invertir cancela esas órdenes, así que conviene pensar dos veces en lo que quiera conservar." },
        { title: "Configure el botón de acción en Reverse & Cxl", html: "El panel de entrada de órdenes de Tradovate tiene un botón de acción configurable en el centro. Use su desplegable para cambiarlo a <strong class='text-white'>Reverse &amp; Cxl</strong> si está configurado como Exit at Mkt &amp; Cxl. La etiqueta exacta y la ubicación de este botón pueden variar entre versiones de la plataforma, así que confírmelo antes de estar en una operación en vivo.", image: {"src":`${IMG}/tradovate-reverse-position-3.png`,"alt":"Desplegable del botón de acción del DOM de Tradovate configurado en Reverse and Cancel"} },
        { title: "Haga clic en Reverse & Cxl para invertir", html: "Un clic envía la orden a mercado de doble tamaño. Su posición se cierra y se abre una posición igual en sentido contrario, y Tradovate cancela las órdenes activas de ese instrumento. Espere a que se confirme la ejecución antes de hacer cualquier otra cosa.", image: {"src":`${IMG}/tradovate-reverse-position-4.png`,"alt":"Botón Reverse and Cancel pulsado, invirtiendo la posición de larga a corta a mercado"} },
        { title: "Vuelva a colocar su stop y su objetivo", html: "Esta es la parte que suele confundir. La nueva posición opuesta se abre desprotegida. El bracket o la estrategia ATM que protegía su posición anterior no se traslada. Coloque su stop-loss y take-profit en la nueva posición de inmediato, antes de mirar cualquier otra cosa de la pantalla.", image: {"src":`${IMG}/tradovate-reverse-position-5.png`,"alt":"Nueva posición corta en el DOM con un stop-loss y un take-profit recién colocados"} },
      ],
    },
    { type: "heading",text: "A qué debe prestar atención" },
    { type: "table", headers: ["A tener en cuenta","Qué significa"], rows: [
      ["Alcance por instrumento","El botón solo afecta al instrumento cargado en ese DOM. Una escalera que muestra MNQ no tocará una posición abierta en ES."],
      ["Los brackets no se trasladan","Si su posición original tenía un stop y un objetivo asociados, la nueva posición se abre sin ellos. Vuelva a asociarlos manualmente cada vez."],
      ["Dos ejecuciones, no una","Paga comisión por los contratos de cierre y por los de apertura, y cruza el spread dos veces. Invertir no es gratis."],
      ["Límites de la prop firm","La orden a mercado de doble tamaño puede acercarle a un límite de posición máxima o de contratos, que varía según la firma y el tamaño de la cuenta. Consulte las reglas vigentes de su firma."],
    ] },
    { type: "heading",text: "La alternativa manual" },
    { type: "paragraph",html: "Si prefiere no lanzar una orden a mercado de doble tamaño, hágalo en dos movimientos: cierre la posición y luego coloque una nueva orden en el otro sentido. Es un paso más lento, pero conserva el control total del tamaño y puede asociar un bracket a la nueva entrada desde el principio en lugar de correr a añadirlo después." },
    { type: "paragraph",html: "Algo que Tradovate no hace de forma nativa es un stop-and-reverse automático, en el que un stop alcanzado le cambia al instante a la operación contraria. El botón Reverse &amp; Cxl es una acción manual. Tiene que hacer clic." },
    { type: "heading",text: "Automatice esto con PickMyTrade" },
    { type: "paragraph",html: "Invertir a mano cada vez que cambia una señal cansa rápido. Si sus entradas provienen de TradingView, <strong class='text-white'>PickMyTrade puede abrir e invertir posiciones de Tradovate automáticamente</strong> en cuanto se dispara su alerta." },
  ], fr: [
    { type: "paragraph",html: "Vous êtes long de deux contrats, le trade tourne contre vous et vous ne voulez pas seulement sortir. Vous voulez être à découvert. Fermer la position puis passer un nouvel ordre de vente représente deux actions et quelques secondes que vous n'avez peut-être pas. Tradovate regroupe les deux en un seul clic avec le bouton <strong class='text-white'>Reverse &amp; Cxl</strong>. Voici exactement comment il se comporte et le point qui piège souvent." },
    { type: "image",src: `${IMG}/tradovate-reverse-position-1.png`,alt: "SuperDOM Tradovate ouvert avec une position longue MNQ active et le sélecteur de quantité" },
    { type: "heading",text: "Ce que fait réellement « Reverse & Cxl »" },
    { type: "paragraph",html: "Reverse &amp; Cxl est l'abréviation de Reverse and Cancel (inverser et annuler). Au clic, Tradovate sort de votre position actuelle au marché et ouvre une position égale dans le sens opposé, également au marché, pour l'instrument chargé dans ce module. Les ordres actifs sur cet instrument sont annulés en même temps." },
    { type: "paragraph",html: "Il vaut la peine de comprendre le mécanisme avant de vous y fier. Supposons que vous soyez long de 2 MNQ. Le bouton n'envoie pas une vente de 2 lots pour solder. Il déclenche un ordre au marché pour le double de votre taille, soit 4 contrats. Deux d'entre eux ferment le long, les deux autres ouvrent un nouveau short de 2 lots. Vous passez de long à short en une seule exécution, même quantité, sens opposé." },
    { type: "heading",text: "Inverser une position : pas à pas" },
    {
      type: "steps",
      items: [
        { title: "Ouvrez le DOM de votre instrument", html: "Chargez l'échelle SuperDOM, ou un graphique avec le trading activé, pour le contrat exact que vous détenez. Le bouton Reverse n'agit que sur l'instrument chargé dans ce module ; vérifiez donc que vous regardez le bon.", image: {"src":`${IMG}/tradovate-reverse-position-2.png`,"alt":"Position ouverte et ordres actifs affichés dans le DOM Tradovate avant l'inversion"} },
        { title: "Confirmez votre position ouverte et vos ordres actifs", html: "Vérifiez que vous avez bien une position en cours sur ce contrat et notez les ordres actifs qui y sont rattachés. L'inversion annule ces ordres ; tout ce que vous souhaitez conserver mérite donc réflexion au préalable." },
        { title: "Réglez le bouton d'action sur Reverse & Cxl", html: "Le panneau de saisie d'ordres de Tradovate comporte un bouton d'action configurable au centre. Utilisez son menu déroulant pour le passer sur <strong class='text-white'>Reverse &amp; Cxl</strong> s'il est actuellement réglé sur Exit at Mkt &amp; Cxl. Le libellé exact et l'emplacement de ce bouton peuvent varier selon les versions de la plateforme ; confirmez-le donc avant d'être dans un trade en direct.", image: {"src":`${IMG}/tradovate-reverse-position-3.png`,"alt":"Menu déroulant du bouton d'action du DOM Tradovate réglé sur Reverse and Cancel"} },
        { title: "Cliquez sur Reverse & Cxl pour inverser", html: "Un clic envoie l'ordre au marché de taille double. Votre position se ferme, une position égale s'ouvre dans le sens opposé et Tradovate annule les ordres actifs sur cet instrument. Attendez la confirmation de l'exécution avant de faire quoi que ce soit d'autre.", image: {"src":`${IMG}/tradovate-reverse-position-4.png`,"alt":"Bouton Reverse and Cancel cliqué, inversant la position de long à short au marché"} },
        { title: "Replacez votre stop et votre objectif", html: "C'est la partie qui piège. La nouvelle position opposée s'ouvre sans protection. Le bracket ou la stratégie ATM qui protégeait votre ancienne position n'est pas reporté. Placez votre stop-loss et votre take-profit sur la nouvelle position immédiatement, avant de regarder quoi que ce soit d'autre à l'écran.", image: {"src":`${IMG}/tradovate-reverse-position-5.png`,"alt":"Nouvelle position short dans le DOM avec un stop-loss et un take-profit tout juste placés"} },
      ],
    },
    { type: "heading",text: "Points de vigilance" },
    { type: "table", headers: ["À surveiller","Ce que cela signifie"], rows: [
      ["Portée par instrument","Le bouton n'affecte que l'instrument chargé dans ce DOM. Une échelle affichant MNQ ne touchera pas une position ES ouverte."],
      ["Les brackets ne suivent pas","Si votre position d'origine avait un stop et un objectif attachés, la nouvelle position s'ouvre sans eux. Rattachez-les manuellement à chaque fois."],
      ["Deux exécutions, pas une","Vous payez la commission sur les contrats de clôture et sur ceux d'ouverture, et vous franchissez le spread deux fois. Inverser n'est pas gratuit."],
      ["Limites des prop firms","L'ordre au marché de taille double peut vous rapprocher d'une limite de position maximale ou de contrats, qui varie selon la firme et la taille du compte. Vérifiez les règles en vigueur de votre firme."],
    ] },
    { type: "heading",text: "L'alternative manuelle" },
    { type: "paragraph",html: "Si vous préférez ne pas envoyer un ordre au marché de taille double, procédez en deux temps : soldez la position, puis passez un nouvel ordre dans l'autre sens. C'est un peu plus lent, mais vous gardez le plein contrôle de votre taille et pouvez attacher un bracket à la nouvelle entrée dès le départ plutôt que de vous précipiter pour en ajouter un après coup." },
    { type: "paragraph",html: "Tradovate ne propose pas nativement de stop-and-reverse automatique, où un stop touché vous bascule instantanément dans le trade opposé. Le bouton Reverse &amp; Cxl est une action manuelle. Vous devez cliquer dessus." },
    { type: "heading",text: "Automatisez cela avec PickMyTrade" },
    { type: "paragraph",html: "Inverser à la main à chaque changement de signal devient vite lassant. Si vos entrées viennent de TradingView, <strong class='text-white'>PickMyTrade peut ouvrir et inverser automatiquement des positions Tradovate</strong> dès que votre alerte se déclenche." },
  ], it: [
    { type: "paragraph",html: "È long di due contratti, il trade si mette contro di Lei e non vuole solo uscire. Vuole essere short. Chiudere la posizione e poi inserire un nuovo ordine di vendita sono due azioni e qualche secondo che potrebbe non avere. Tradovate riunisce entrambe in un solo clic con il pulsante <strong class='text-white'>Reverse &amp; Cxl</strong>. Ecco esattamente come si comporta e l'unica cosa che coglie di sorpresa." },
    { type: "image",src: `${IMG}/tradovate-reverse-position-1.png`,alt: "SuperDOM di Tradovate aperto con una posizione long attiva su MNQ e il selettore della quantità" },
    { type: "heading",text: "Cosa fa davvero «Reverse & Cxl»" },
    { type: "paragraph",html: "Reverse &amp; Cxl è l'abbreviazione di Reverse and Cancel (inverti e annulla). Al clic, Tradovate esce dalla posizione attuale a mercato e apre una posizione uguale nella direzione opposta, sempre a mercato, per lo strumento caricato in quel modulo. Gli ordini attivi su quello strumento vengono annullati contemporaneamente." },
    { type: "paragraph",html: "Vale la pena capire il meccanismo prima di farvi affidamento. Supponiamo che sia long di 2 MNQ. Il pulsante non invia una vendita da 2 lotti per chiudere. Invia un ordine a mercato per il doppio della Sua size, cioè 4 contratti. Due chiudono il long, gli altri due aprono un nuovo short da 2 lotti. Passa da long a short in un solo fill, stessa quantità, direzione opposta." },
    { type: "heading",text: "Invertire una posizione: passo dopo passo" },
    {
      type: "steps",
