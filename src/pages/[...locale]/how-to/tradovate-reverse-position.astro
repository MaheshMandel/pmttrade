  ctaHeading: { en: "Let Your Signals Flip the Trade", de: "Lassen Sie Ihre Signale den Trade umdrehen", es: "Deje que sus señales inviertan la operación", fr: "Laissez vos signaux retourner le trade", it: "Lasci che i Suoi segnali invertano il trade" },
