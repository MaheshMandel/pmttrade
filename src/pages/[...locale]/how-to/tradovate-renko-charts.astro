---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "tradovate-renko-charts";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/how-to/${SLUG}`;

const META_TITLE = "How to Use Renko Charts on Tradovate";
const META_DESCRIPTION =
  "Learn to switch a chart to Renko, set brick size in ticks, and read clean price-based bricks that strip out time and filter market noise.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "So verwenden Sie Renko-Charts bei Tradovate", es: "Cómo usar gráficos Renko en Tradovate", fr: "Utiliser les graphiques Renko sur Tradovate", it: "Come usare i grafici Renko su Tradovate" },
  dek: { en: "Renko drops a new brick only when price moves a set distance, no time axis, no noise. Here's how to switch a Tradovate chart to Renko and size the bricks yourself.", de: "Renko setzt nur dann einen neuen Stein, wenn der Kurs eine festgelegte Distanz zurücklegt: keine Zeitachse, kein Rauschen. So stellen Sie einen Tradovate-Chart auf Renko um und bestimmen die Steingröße selbst.", es: "Renko añade un nuevo ladrillo solo cuando el precio se mueve una distancia fija: sin eje de tiempo, sin ruido. Así se cambia un gráfico de Tradovate a Renko y se define el tamaño de los ladrillos.", fr: "Renko n'ajoute une nouvelle brique que lorsque le prix parcourt une distance donnée : pas d'axe temporel, pas de bruit. Voici comment passer un graphique Tradovate en Renko et définir vous-même la taille des briques.", it: "Renko aggiunge un nuovo mattone solo quando il prezzo si muove di una distanza stabilita: nessun asse temporale, nessun rumore. Ecco come passare un grafico Tradovate a Renko e dimensionare i mattoni da soli." },
  readTime: { en: "6 min read", de: "6 Min. Lesezeit", es: "Lectura de 6 min", fr: "Lecture : 6 min", it: "Lettura di 6 min" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "Renko takes time off the chart. Instead of printing a bar every minute or every 500 ticks, it drops a new brick only when price travels a set distance you choose. Quiet chop gets compressed into a handful of bricks, and a real move stacks brick after brick in one direction. Tradovate builds Renko into its charts, so you can switch to it in two clicks and size the bricks yourself. Here's the exact path." },
    { type: "heading", text: "What a Renko Chart Actually Shows" },
    { type: "paragraph", html: "Each brick is a fixed price move. Once price closes past the top of the last brick by your chosen size, a new up brick prints; drop past the bottom and a down brick prints. Bricks never share a candle's sense of time, so a slow hour and a fast minute can both produce a single brick. That's the whole point: you're filtering out the small back-and-forth and looking at direction only. It suits trend and breakout traders who want less noise on screen." },
    { type: "heading", text: "Before You Start" },
    { type: "paragraph", html: "Any Tradovate account with charting works here, whether it's a simulated account, a funded personal account, or a prop-firm evaluation. Advanced Charting, which includes Renko, Heikin Ashi, and Point &amp; Figure, ships built into the platform now, so there's nothing extra to install. If you're new to the Chart module itself, run through Tradovate charting basics first, then come back here." },
    { type: "heading", text: "Switch a Tradovate Chart to Renko: Step-by-Step" },
    {
      type: "steps",
      items: [
        { title: "Open a Chart for Your Contract", html: "Open the Chart module and load the contract you actually trade, using the current front-month symbol rather than a continuous one. Start on a normal candlestick chart so you know the instrument is streaming data before you change anything.", image: { src: `${IMG}/tradovate-renko-charts-1.png`, alt: "Tradovate Chart module showing a candlestick chart for a futures contract" } },
        { title: "Open the Chart Type Control and Choose Renko", html: "Look at the top-left of the chart for the Chart Type control and click it. You'll see the advanced types: Bid-Ask Volume, Heikin Ashi, Renko, and Point &amp; Figure. Pick Renko. The chart redraws as bricks straight away, using a default size until you set your own. Note that this is a separate control from the plain candlestick/bar/line Chart Style menu, so don't confuse the two.", image: { src: `${IMG}/tradovate-renko-charts-2.png`, alt: "Chart Type menu open on a Tradovate chart with Renko selected" } },
        { title: "Set the Brick Size in Ticks", html: "This is the setting that matters most. Open Configure Chart Elements (the gear icon) and find the Renko brick size field. Tradovate takes this number in ticks, not points, which trips up anyone coming from TradeStation or a points-based platform. So if you want each brick to be three points on the E-mini S&amp;P 500, where one tick is 0.25, you'd enter 12 ticks, not 3. Type your number and the chart rebuilds every brick to that size.", image: { src: `${IMG}/tradovate-renko-charts-3.png`, alt: "Configure Chart Elements panel with the Renko brick size entered in ticks" } },
        { title: "Colour the Bricks and Layer Indicators", html: "From the same settings you can set the up-brick and down-brick colours so direction jumps out. Renko plays nicely with the built-in indicators too, so add a moving average or two if you like a trend filter over the bricks. Keep it light; the reason you're on Renko is to see less, not more.", image: { src: `${IMG}/tradovate-renko-charts-4.png`, alt: "Renko chart on Tradovate with coloured bricks and a moving average overlaid" } },
        { title: "Save the Layout and Read the Bricks", html: "Save the chart into your workspace so the Renko setup reloads next time you sign in instead of resetting to candles. Now read it for what it is: a run of same-colour bricks is a clean trend, and a flip in colour is your first sign momentum has turned by at least one full brick.", image: { src: `${IMG}/tradovate-renko-charts-5.png`, alt: "Finished Tradovate Renko chart showing a stacked trend and a colour flip" } },
      ],
    },
    { type: "heading", text: "Picking a Brick Size That Fits" },
    { type: "paragraph", html: "Brick size is the whole personality of a Renko chart. Too small and you get a wall of tiny bricks that chatter as much as candles; too large and you miss the move entirely. A common starting point is to base it on recent volatility rather than a round number, for example roughly half to one times the daily Average True Range of your instrument, then adjust from there. Whatever you pick, remember the value is in ticks, so check your contract's tick size before you type." },
    { type: "quote", html: "One thing to watch: on very low timeframes some builds of the desktop chart can render Renko bricks with a slight offset or the odd irregular plot. If your bricks look off, bump the timeframe up or size the bricks a little larger, and confirm the current behaviour on your build." },
    { type: "heading", text: "Automate This with PickMyTrade" },
    { type: "paragraph", html: "Trading a Renko setup by hand is fine until you want your TradingView signals to fire the entry for you. <strong class='text-white'>PickMyTrade routes TradingView alerts straight into Tradovate</strong> so your bricks-based strategy executes without you sitting on the mouse." },
    { type: "paragraph", html: "That's the full loop: open a chart, switch the Chart Type to Renko, size the brick in ticks, and save it. Tune the size to how your instrument moves and you'll have a chart that shows trend and ignores the noise." },
  ], de: [
    { type: "paragraph",html: "Renko nimmt die Zeit aus dem Chart. Statt jede Minute oder alle 500 Ticks einen Balken zu zeichnen, setzt es nur dann einen neuen Stein, wenn der Kurs eine von Ihnen gewählte Distanz zurücklegt. Ruhige Seitwärtsphasen werden auf wenige Steine verdichtet, und eine echte Bewegung reiht Stein an Stein in eine Richtung. Tradovate hat Renko in seine Charts integriert, Sie können also mit zwei Klicks umschalten und die Steingröße selbst festlegen. Hier ist der genaue Weg." },
    { type: "heading",text: "Was ein Renko-Chart tatsächlich zeigt" },
    { type: "paragraph",html: "Jeder Stein entspricht einer festen Kursbewegung. Schließt der Kurs um Ihre gewählte Größe über der Oberkante des letzten Steins, entsteht ein neuer Aufwärtsstein; fällt er unter die Unterkante, entsteht ein Abwärtsstein. Steine haben keinen Zeitbezug wie eine Kerze, daher kann sowohl eine ruhige Stunde als auch eine schnelle Minute genau einen Stein erzeugen. Genau das ist der Sinn: Sie filtern das kleine Hin und Her heraus und betrachten nur die Richtung. Es eignet sich für Trend- und Breakout-Trader, die weniger Rauschen auf dem Bildschirm wollen." },
    { type: "heading",text: "Bevor Sie beginnen" },
    { type: "paragraph",html: "Jedes Tradovate-Konto mit Charting funktioniert hier, ob Simulationskonto, finanziertes Privatkonto oder Prop-Firm-Evaluierung. Advanced Charting, das Renko, Heikin Ashi und Point &amp; Figure umfasst, ist inzwischen fest in die Plattform integriert, es muss also nichts zusätzlich installiert werden. Wenn Sie das Chart-Modul selbst noch nicht kennen, gehen Sie zuerst die Grundlagen des Tradovate-Chartings durch und kehren Sie dann hierher zurück." },
    { type: "heading",text: "Einen Tradovate-Chart auf Renko umstellen: Schritt für Schritt" },
    {
      type: "steps",
      items: [
        { title: "Öffnen Sie einen Chart für Ihren Kontrakt", html: "Öffnen Sie das Chart-Modul und laden Sie den Kontrakt, den Sie tatsächlich handeln, und zwar mit dem aktuellen Front-Month-Symbol statt einem fortlaufenden. Beginnen Sie mit einem normalen Candlestick-Chart, damit Sie wissen, dass das Instrument Daten liefert, bevor Sie etwas ändern.", image: {"src":`${IMG}/tradovate-renko-charts-1.png`,"alt":"Tradovate-Chart-Modul mit einem Candlestick-Chart für einen Futures-Kontrakt"} },
        { title: "Öffnen Sie die Chart-Type-Steuerung und wählen Sie Renko", html: "Suchen Sie oben links im Chart die Steuerung Chart Type und klicken Sie darauf. Sie sehen die erweiterten Typen: Bid-Ask Volume, Heikin Ashi, Renko und Point &amp; Figure. Wählen Sie Renko. Der Chart wird sofort als Steine neu gezeichnet, mit einer Standardgröße, bis Sie Ihre eigene festlegen. Beachten Sie, dass dies eine eigene Steuerung ist, getrennt vom einfachen Chart-Style-Menü für Kerzen, Balken und Linien. Verwechseln Sie die beiden nicht.", image: {"src":`${IMG}/tradovate-renko-charts-2.png`,"alt":"Geöffnetes Chart-Type-Menü in einem Tradovate-Chart mit ausgewähltem Renko"} },
        { title: "Legen Sie die Steingröße in Ticks fest", html: "Diese Einstellung ist die wichtigste. Öffnen Sie Configure Chart Elements (das Zahnradsymbol) und suchen Sie das Feld für die Renko-Steingröße. Tradovate erwartet diese Zahl in Ticks, nicht in Punkten, was jeden verwirrt, der von TradeStation oder einer punktbasierten Plattform kommt. Wenn jeder Stein also drei Punkte im E-mini S&amp;P 500 betragen soll, wo ein Tick 0,25 entspricht, geben Sie 12 Ticks ein, nicht 3. Tippen Sie Ihre Zahl ein, und der Chart baut jeden Stein auf diese Größe neu auf.", image: {"src":`${IMG}/tradovate-renko-charts-3.png`,"alt":"Panel Configure Chart Elements mit der in Ticks eingegebenen Renko-Steingröße"} },
        { title: "Färben Sie die Steine und legen Sie Indikatoren darüber", html: "In denselben Einstellungen können Sie die Farben für Aufwärts- und Abwärtssteine festlegen, damit die Richtung sofort ins Auge fällt. Renko harmoniert auch mit den integrierten Indikatoren. Fügen Sie also gern ein oder zwei gleitende Durchschnitte als Trendfilter über den Steinen hinzu. Halten Sie es schlicht, denn Sie nutzen Renko, um weniger zu sehen, nicht mehr.", image: {"src":`${IMG}/tradovate-renko-charts-4.png`,"alt":"Renko-Chart bei Tradovate mit farbigen Steinen und überlagertem gleitendem Durchschnitt"} },
        { title: "Speichern Sie das Layout und lesen Sie die Steine", html: "Speichern Sie den Chart in Ihrem Workspace, damit das Renko-Setup bei der nächsten Anmeldung wieder geladen wird, statt auf Kerzen zurückzuspringen. Lesen Sie ihn nun so, wie er ist: Eine Reihe gleichfarbiger Steine ist ein sauberer Trend, und ein Farbwechsel ist das erste Zeichen, dass das Momentum um mindestens einen vollen Stein gedreht hat.", image: {"src":`${IMG}/tradovate-renko-charts-5.png`,"alt":"Fertiger Tradovate-Renko-Chart mit gestapeltem Trend und einem Farbwechsel"} },
      ],
    },
    { type: "heading",text: "Die passende Steingröße wählen" },
    { type: "paragraph",html: "Die Steingröße bestimmt den ganzen Charakter eines Renko-Charts. Zu klein, und Sie bekommen eine Wand winziger Steine, die genauso hektisch wirkt wie Kerzen; zu groß, und Sie verpassen die Bewegung komplett. Ein üblicher Ausgangspunkt ist, die Größe an der jüngsten Volatilität auszurichten statt an einer runden Zahl, zum Beispiel etwa das 0,5- bis 1-Fache der durchschnittlichen Tagesspanne (Average True Range) Ihres Instruments, und dann von dort anzupassen. Was auch immer Sie wählen: Der Wert gilt in Ticks, prüfen Sie also die Tickgröße Ihres Kontrakts, bevor Sie ihn eintippen." },
    { type: "quote",html: "Ein Hinweis: In sehr niedrigen Zeitrahmen stellen manche Builds des Desktop-Charts Renko-Steine mit leichtem Versatz oder gelegentlich unregelmäßig dar. Wirken Ihre Steine verschoben, erhöhen Sie den Zeitrahmen oder wählen Sie die Steine etwas größer, und prüfen Sie das aktuelle Verhalten in Ihrem Build." },
    { type: "heading",text: "Automatisieren Sie das mit PickMyTrade" },
    { type: "paragraph",html: "Einen Renko-Setup von Hand zu handeln ist in Ordnung, bis Sie möchten, dass Ihre TradingView-Signale den Einstieg für Sie auslösen. <strong class='text-white'>PickMyTrade leitet TradingView-Alerts direkt an Tradovate weiter</strong>, damit Ihre steinbasierte Strategie ausgeführt wird, ohne dass Sie an der Maus sitzen müssen." },
    { type: "paragraph",html: "Das ist der gesamte Ablauf: einen Chart öffnen, den Chart Type auf Renko umstellen, den Stein in Ticks dimensionieren und speichern. Stimmen Sie die Größe auf die Bewegung Ihres Instruments ab, und Sie erhalten einen Chart, der den Trend zeigt und das Rauschen ignoriert." },
  ], es: [
    { type: "paragraph",html: "Renko elimina el tiempo del gráfico. En lugar de dibujar una barra cada minuto o cada 500 ticks, añade un nuevo ladrillo solo cuando el precio recorre una distancia fija que usted elige. La consolidación tranquila se comprime en unos pocos ladrillos, y un movimiento real apila ladrillo tras ladrillo en una dirección. Tradovate incluye Renko en sus gráficos, así que puede cambiar a él con dos clics y definir usted mismo el tamaño de los ladrillos. Este es el camino exacto." },
    { type: "heading",text: "Qué muestra realmente un gráfico Renko" },
    { type: "paragraph",html: "Cada ladrillo es un movimiento de precio fijo. Cuando el precio cierra por encima del techo del último ladrillo en el tamaño que usted eligió, se dibuja un nuevo ladrillo alcista; si cae por debajo de la base, se dibuja uno bajista. Los ladrillos no comparten con las velas la noción de tiempo, así que una hora lenta y un minuto rápido pueden producir un único ladrillo. Ese es el objetivo: filtrar el vaivén pequeño y mirar solo la dirección. Es adecuado para traders de tendencia y de rupturas que quieren menos ruido en pantalla." },
    { type: "heading",text: "Antes de empezar" },
    { type: "paragraph",html: "Aquí funciona cualquier cuenta de Tradovate con gráficos, ya sea una cuenta simulada, una cuenta personal fondeada o una evaluación de prop firm. Advanced Charting, que incluye Renko, Heikin Ashi y Point &amp; Figure, viene ya integrado en la plataforma, por lo que no hay nada extra que instalar. Si es nuevo en el módulo de gráficos, repase primero los fundamentos de los gráficos de Tradovate y luego vuelva aquí." },
    { type: "heading",text: "Cambie un gráfico de Tradovate a Renko: paso a paso" },
    {
      type: "steps",
      items: [
        { title: "Abra un gráfico para su contrato", html: "Abra el módulo Chart y cargue el contrato que realmente opera, usando el símbolo vigente del mes frontal en lugar de uno continuo. Empiece con un gráfico de velas normal para saber que el instrumento recibe datos antes de cambiar nada.", image: {"src":`${IMG}/tradovate-renko-charts-1.png`,"alt":"Módulo Chart de Tradovate mostrando un gráfico de velas de un contrato de futuros"} },
        { title: "Abra el control Chart Type y elija Renko", html: "Mire la parte superior izquierda del gráfico, encuentre el control Chart Type y haga clic en él. Verá los tipos avanzados: Bid-Ask Volume, Heikin Ashi, Renko y Point &amp; Figure. Elija Renko. El gráfico se redibuja de inmediato en ladrillos, con un tamaño predeterminado hasta que fije el suyo. Tenga en cuenta que es un control distinto del menú Chart Style normal de velas, barras y líneas, así que no los confunda.", image: {"src":`${IMG}/tradovate-renko-charts-2.png`,"alt":"Menú Chart Type abierto en un gráfico de Tradovate con Renko seleccionado"} },
        { title: "Defina el tamaño del ladrillo en ticks", html: "Este es el ajuste que más importa. Abra Configure Chart Elements (el icono del engranaje) y busque el campo del tamaño de ladrillo Renko. Tradovate toma este número en ticks, no en puntos, algo que confunde a quien viene de TradeStation o de una plataforma basada en puntos. Así que si quiere que cada ladrillo sea de tres puntos en el E-mini S&amp;P 500, donde un tick es 0,25, debe introducir 12 ticks, no 3. Escriba su número y el gráfico reconstruye todos los ladrillos con ese tamaño.", image: {"src":`${IMG}/tradovate-renko-charts-3.png`,"alt":"Panel Configure Chart Elements con el tamaño de ladrillo Renko introducido en ticks"} },
        { title: "Coloree los ladrillos y añada indicadores", html: "Desde los mismos ajustes puede definir los colores de los ladrillos alcistas y bajistas para que la dirección salte a la vista. Renko funciona bien con los indicadores integrados, así que añada una o dos medias móviles si le gusta un filtro de tendencia sobre los ladrillos. Manténgalo simple: usted usa Renko para ver menos, no más.", image: {"src":`${IMG}/tradovate-renko-charts-4.png`,"alt":"Gráfico Renko en Tradovate con ladrillos coloreados y una media móvil superpuesta"} },
        { title: "Guarde el diseño y lea los ladrillos", html: "Guarde el gráfico en su espacio de trabajo para que la configuración Renko se cargue la próxima vez que inicie sesión en lugar de volver a las velas. Ahora léalo tal como es: una serie de ladrillos del mismo color es una tendencia limpia, y un cambio de color es la primera señal de que el momentum se ha invertido al menos en un ladrillo completo.", image: {"src":`${IMG}/tradovate-renko-charts-5.png`,"alt":"Gráfico Renko de Tradovate terminado, con una tendencia apilada y un cambio de color"} },
      ],
    },
    { type: "heading",text: "Cómo elegir un tamaño de ladrillo adecuado" },
    { type: "paragraph",html: "El tamaño del ladrillo es toda la personalidad de un gráfico Renko. Si es demasiado pequeño, obtendrá un muro de ladrillos diminutos que oscilan tanto como las velas; si es demasiado grande, se perderá el movimiento por completo. Un punto de partida habitual es basarlo en la volatilidad reciente en lugar de en un número redondo, por ejemplo aproximadamente entre la mitad y una vez el rango medio verdadero (Average True Range) diario de su instrumento, y ajustarlo desde ahí. Elija lo que elija, recuerde que el valor está en ticks, así que compruebe el tamaño del tick de su contrato antes de escribirlo." },
    { type: "quote",html: "Una advertencia: en marcos temporales muy bajos, algunas versiones del gráfico de escritorio pueden dibujar los ladrillos Renko con un ligero desfase o con algún trazo irregular. Si sus ladrillos se ven raros, suba el marco temporal o haga los ladrillos algo más grandes, y confirme el comportamiento actual en su versión." },
    { type: "heading",text: "Automatice esto con PickMyTrade" },
    { type: "paragraph",html: "Operar una configuración Renko a mano está bien hasta que quiera que sus señales de TradingView lancen la entrada por usted. <strong class='text-white'>PickMyTrade envía las alertas de TradingView directamente a Tradovate</strong> para que su estrategia basada en ladrillos se ejecute sin que usted tenga que estar pendiente del ratón." },
    { type: "paragraph",html: "Ese es el ciclo completo: abrir un gráfico, cambiar el Chart Type a Renko, dimensionar el ladrillo en ticks y guardarlo. Ajuste el tamaño a cómo se mueve su instrumento y tendrá un gráfico que muestra la tendencia e ignora el ruido." },
  ], fr: [
    { type: "paragraph",html: "Renko retire le temps du graphique. Au lieu d'afficher une barre chaque minute ou tous les 500 ticks, il ajoute une nouvelle brique uniquement lorsque le prix parcourt une distance que vous choisissez. Les phases calmes sont compressées en quelques briques, et un vrai mouvement empile brique après brique dans une même direction. Tradovate intègre Renko dans ses graphiques ; vous pouvez donc y passer en deux clics et définir vous-même la taille des briques. Voici le chemin exact." },
    { type: "heading",text: "Ce que montre réellement un graphique Renko" },
    { type: "paragraph",html: "Chaque brique correspond à un mouvement de prix fixe. Dès que le prix clôture au-delà du haut de la dernière brique de la taille choisie, une nouvelle brique haussière apparaît ; s'il passe sous le bas, une brique baissière apparaît. Les briques n'ont pas la notion de temps d'une bougie : une heure calme et une minute rapide peuvent chacune produire une seule brique. C'est tout l'intérêt : vous filtrez les petits va-et-vient et ne regardez que la direction. Cela convient aux traders de tendance et de cassure qui veulent moins de bruit à l'écran." },
    { type: "heading",text: "Avant de commencer" },
    { type: "paragraph",html: "Tout compte Tradovate avec graphiques convient ici, qu'il s'agisse d'un compte simulé, d'un compte personnel financé ou d'une évaluation de prop firm. Advanced Charting, qui inclut Renko, Heikin Ashi et Point &amp; Figure, est désormais intégré à la plateforme ; il n'y a donc rien de plus à installer. Si le module de graphiques vous est nouveau, parcourez d'abord les bases des graphiques Tradovate, puis revenez ici." },
    { type: "heading",text: "Passer un graphique Tradovate en Renko : pas à pas" },
    {
      type: "steps",
      items: [
        { title: "Ouvrez un graphique pour votre contrat", html: "Ouvrez le module Chart et chargez le contrat que vous tradez réellement, en utilisant le symbole du mois en cours plutôt qu'un symbole continu. Commencez par un graphique en chandeliers classique afin de vérifier que l'instrument reçoit des données avant de rien modifier.", image: {"src":`${IMG}/tradovate-renko-charts-1.png`,"alt":"Module Chart de Tradovate affichant un graphique en chandeliers pour un contrat à terme"} },
        { title: "Ouvrez le contrôle Chart Type et choisissez Renko", html: "Repérez en haut à gauche du graphique le contrôle Chart Type et cliquez dessus. Vous verrez les types avancés : Bid-Ask Volume, Heikin Ashi, Renko et Point &amp; Figure. Choisissez Renko. Le graphique se redessine aussitôt en briques, avec une taille par défaut jusqu'à ce que vous définissiez la vôtre. Notez qu'il s'agit d'un contrôle distinct du menu Chart Style ordinaire (bougies, barres, ligne) ; ne confondez pas les deux.", image: {"src":`${IMG}/tradovate-renko-charts-2.png`,"alt":"Menu Chart Type ouvert sur un graphique Tradovate avec Renko sélectionné"} },
        { title: "Définissez la taille de la brique en ticks", html: "C'est le paramètre le plus important. Ouvrez Configure Chart Elements (l'icône en forme d'engrenage) et trouvez le champ de la taille de brique Renko. Tradovate attend ce nombre en ticks, et non en points, ce qui déroute ceux qui viennent de TradeStation ou d'une plateforme basée sur les points. Ainsi, si vous voulez que chaque brique fasse trois points sur le E-mini S&amp;P 500, où un tick vaut 0,25, vous saisirez 12 ticks, et non 3. Saisissez votre nombre et le graphique reconstruit chaque brique à cette taille.", image: {"src":`${IMG}/tradovate-renko-charts-3.png`,"alt":"Panneau Configure Chart Elements avec la taille de brique Renko saisie en ticks"} },
        { title: "Colorez les briques et ajoutez des indicateurs", html: "Depuis les mêmes paramètres, vous pouvez définir les couleurs des briques haussières et baissières pour que la direction saute aux yeux. Renko fonctionne bien avec les indicateurs intégrés ; ajoutez donc une ou deux moyennes mobiles si vous aimez un filtre de tendance sur les briques. Restez sobre : vous utilisez Renko pour voir moins, pas plus.", image: {"src":`${IMG}/tradovate-renko-charts-4.png`,"alt":"Graphique Renko sur Tradovate avec des briques colorées et une moyenne mobile superposée"} },
        { title: "Enregistrez la disposition et lisez les briques", html: "Enregistrez le graphique dans votre espace de travail afin que la configuration Renko se recharge à votre prochaine connexion au lieu de revenir aux bougies. Lisez-le ensuite pour ce qu'il est : une série de briques de même couleur est une tendance nette, et un changement de couleur est le premier signe que l'élan s'est inversé d'au moins une brique entière.", image: {"src":`${IMG}/tradovate-renko-charts-5.png`,"alt":"Graphique Renko Tradovate terminé montrant une tendance empilée et un changement de couleur"} },
      ],
    },
    { type: "heading",text: "Choisir une taille de brique adaptée" },
    { type: "paragraph",html: "La taille de la brique fait toute la personnalité d'un graphique Renko. Trop petite, vous obtenez un mur de minuscules briques qui s'agitent autant que des bougies ; trop grande, vous manquez complètement le mouvement. Un point de départ courant consiste à se baser sur la volatilité récente plutôt que sur un chiffre rond, par exemple environ une demi-fois à une fois l'Average True Range quotidien de votre instrument, puis à ajuster à partir de là. Quelle que soit votre valeur, rappelez-vous qu'elle est exprimée en ticks ; vérifiez donc la taille du tick de votre contrat avant de la saisir." },
    { type: "quote",html: "Un point d'attention : sur de très petites unités de temps, certaines versions du graphique de bureau peuvent afficher les briques Renko avec un léger décalage ou un tracé irrégulier. Si vos briques paraissent anormales, augmentez l'unité de temps ou agrandissez un peu les briques, et vérifiez le comportement actuel sur votre version." },
    { type: "heading",text: "Automatisez cela avec PickMyTrade" },
    { type: "paragraph",html: "Trader une configuration Renko à la main convient, jusqu'à ce que vous souhaitiez que vos signaux TradingView déclenchent l'entrée à votre place. <strong class='text-white'>PickMyTrade achemine les alertes TradingView directement vers Tradovate</strong> pour que votre stratégie basée sur les briques s'exécute sans que vous soyez rivé à la souris." },
    { type: "paragraph",html: "Voilà la boucle complète : ouvrir un graphique, passer le Chart Type en Renko, dimensionner la brique en ticks et l'enregistrer. Ajustez la taille à la façon dont bouge votre instrument et vous obtiendrez un graphique qui montre la tendance et ignore le bruit." },
  ], it: [
    { type: "paragraph",html: "Renko toglie il tempo dal grafico. Invece di disegnare una barra ogni minuto o ogni 500 tick, aggiunge un nuovo mattone solo quando il prezzo percorre una distanza che Lei sceglie. Il movimento laterale tranquillo viene compresso in pochi mattoni, mentre un movimento reale impila mattone dopo mattone in una sola direzione. Tradovate integra Renko nei suoi grafici, quindi può passarci con due clic e dimensionare i mattoni da sé. Ecco il percorso esatto." },
    { type: "heading",text: "Cosa mostra davvero un grafico Renko" },
    { type: "paragraph",html: "Ogni mattone è un movimento di prezzo fisso. Quando il prezzo chiude oltre la sommità dell'ultimo mattone della dimensione scelta, viene disegnato un nuovo mattone rialzista; se scende sotto la base, ne appare uno ribassista. I mattoni non condividono con le candele la nozione di tempo, quindi un'ora lenta e un minuto veloce possono produrre entrambi un solo mattone. È proprio questo il punto: filtra il piccolo andirivieni e guarda solo la direzione. È adatto a trader di trend e di breakout che vogliono meno rumore sullo schermo." },
    { type: "heading",text: "Prima di iniziare" },
    { type: "paragraph",html: "Qui funziona qualsiasi account Tradovate con grafici, sia esso un account simulato, un account personale finanziato o una valutazione di prop firm. Advanced Charting, che include Renko, Heikin Ashi e Point &amp; Figure, è ormai integrato nella piattaforma, quindi non c'è nulla di extra da installare. Se il modulo dei grafici Le è nuovo, ripassi prima le basi dei grafici Tradovate, poi torni qui." },
    { type: "heading",text: "Passare un grafico Tradovate a Renko: passo dopo passo" },
    {
      type: "steps",
      items: [
        { title: "Apra un grafico per il Suo contratto", html: "Apra il modulo Chart e carichi il contratto che opera davvero, usando il simbolo del mese corrente anziché uno continuo. Inizi con un normale grafico a candele, così sa che lo strumento riceve dati prima di cambiare qualsiasi cosa.", image: {"src":`${IMG}/tradovate-renko-charts-1.png`,"alt":"Modulo Chart di Tradovate che mostra un grafico a candele per un contratto futures"} },
        { title: "Apra il controllo Chart Type e scelga Renko", html: "Guardi in alto a sinistra nel grafico, trovi il controllo Chart Type e ci clicchi. Vedrà i tipi avanzati: Bid-Ask Volume, Heikin Ashi, Renko e Point &amp; Figure. Scelga Renko. Il grafico viene ridisegnato subito a mattoni, con una dimensione predefinita finché non imposta la Sua. Noti che è un controllo distinto dal normale menu Chart Style di candele, barre e linea, quindi non li confonda.", image: {"src":`${IMG}/tradovate-renko-charts-2.png`,"alt":"Menu Chart Type aperto su un grafico Tradovate con Renko selezionato"} },
        { title: "Imposti la dimensione del mattone in tick", html: "Questa è l'impostazione che conta di più. Apra Configure Chart Elements (l'icona a ingranaggio) e trovi il campo della dimensione del mattone Renko. Tradovate accetta questo numero in tick, non in punti, cosa che mette in difficoltà chi proviene da TradeStation o da una piattaforma basata sui punti. Quindi, se vuole che ogni mattone sia di tre punti sull'E-mini S&amp;P 500, dove un tick è 0,25, deve inserire 12 tick, non 3. Digiti il Suo numero e il grafico ricostruisce ogni mattone a quella dimensione.", image: {"src":`${IMG}/tradovate-renko-charts-3.png`,"alt":"Pannello Configure Chart Elements con la dimensione del mattone Renko inserita in tick"} },
        { title: "Colori i mattoni e aggiunga gli indicatori", html: "Dalle stesse impostazioni può definire i colori dei mattoni rialzisti e ribassisti, così la direzione salta all'occhio. Renko si abbina bene agli indicatori integrati, quindi aggiunga una o due medie mobili se preferisce un filtro di trend sopra i mattoni. Resti sobrio: usa Renko per vedere meno, non di più.", image: {"src":`${IMG}/tradovate-renko-charts-4.png`,"alt":"Grafico Renko su Tradovate con mattoni colorati e una media mobile sovrapposta"} },
        { title: "Salvi il layout e legga i mattoni", html: "Salvi il grafico nel Suo workspace in modo che il setup Renko si ricarichi al prossimo accesso invece di tornare alle candele. Ora lo legga per quello che è: una serie di mattoni dello stesso colore è un trend pulito, e un cambio di colore è il primo segnale che il momentum si è invertito di almeno un mattone intero.", image: {"src":`${IMG}/tradovate-renko-charts-5.png`,"alt":"Grafico Renko Tradovate completato con un trend impilato e un cambio di colore"} },
      ],
    },
    { type: "heading",text: "Scegliere una dimensione del mattone adatta" },
    { type: "paragraph",html: "La dimensione del mattone è tutta la personalità di un grafico Renko. Troppo piccola e ottiene un muro di mattoncini minuscoli che oscillano quanto le candele; troppo grande e perde del tutto il movimento. Un punto di partenza comune è basarla sulla volatilità recente anziché su un numero tondo, ad esempio circa da metà a una volta l'Average True Range giornaliero del Suo strumento, per poi regolare da lì. Qualunque valore scelga, ricordi che è espresso in tick, quindi controlli la dimensione del tick del Suo contratto prima di digitarlo." },
    { type: "quote",html: "Una cosa a cui prestare attenzione: su timeframe molto bassi alcune build del grafico desktop possono disegnare i mattoni Renko con un lieve scostamento o con qualche tracciato irregolare. Se i Suoi mattoni sembrano strani, alzi il timeframe o ingrandisca un po' i mattoni, e verifichi il comportamento attuale sulla Sua build." },
    { type: "heading",text: "Automatizzi tutto questo con PickMyTrade" },
    { type: "paragraph",html: "Operare a mano con un setup Renko va bene finché non desidera che i Suoi segnali di TradingView eseguano l'ingresso al posto Suo. <strong class='text-white'>PickMyTrade instrada gli alert di TradingView direttamente a Tradovate</strong> così la Sua strategia basata sui mattoni viene eseguita senza che Lei debba stare sul mouse." },
    { type: "paragraph",html: "Questo è il ciclo completo: aprire un grafico, passare il Chart Type a Renko, dimensionare il mattone in tick e salvarlo. Adatti la dimensione al modo in cui si muove il Suo strumento e avrà un grafico che mostra il trend e ignora il rumore." },
  ] },
  ctaHeading: { en: "Automate Your Renko Strategy", de: "Automatisieren Sie Ihre Renko-Strategie", es: "Automatice su estrategia Renko", fr: "Automatisez votre stratégie Renko", it: "Automatizzi la Sua strategia Renko" },
  ctaText: { en: "Trading a Renko setup by hand is fine until you want your TradingView signals to fire the entry for you. PickMyTrade routes alerts straight into Tradovate so the strategy executes without you sitting on the mouse.", de: "Einen Renko-Setup von Hand zu handeln ist in Ordnung, bis Sie möchten, dass Ihre TradingView-Signale den Einstieg für Sie auslösen. PickMyTrade leitet Alerts direkt an Tradovate weiter, damit die Strategie ausgeführt wird, ohne dass Sie an der Maus sitzen müssen.", es: "Operar una configuración Renko a mano está bien hasta que quiera que sus señales de TradingView lancen la entrada por usted. PickMyTrade envía las alertas directamente a Tradovate para que la estrategia se ejecute sin que usted tenga que estar pendiente del ratón.", fr: "Trader une configuration Renko à la main convient, jusqu'à ce que vous souhaitiez que vos signaux TradingView déclenchent l'entrée à votre place. PickMyTrade achemine les alertes directement vers Tradovate pour que la stratégie s'exécute sans que vous soyez rivé à la souris.", it: "Operare a mano con un setup Renko va bene finché non desidera che i Suoi segnali di TradingView eseguano l'ingresso al posto Suo. PickMyTrade instrada gli alert direttamente a Tradovate così la strategia viene eseguita senza che Lei debba stare sul mouse." },
  ctaButtonText: { en: "Start Your Free 7-Day Trial", de: "Starten Sie Ihre kostenlose 7-Tage-Testphase", es: "Comience su prueba gratuita de 7 días", fr: "Commencez votre essai gratuit de 7 jours", it: "Inizi la prova gratuita di 7 giorni" },
  ctaUrl: "https://app.pickmytrade.trade/?register=true&utm_source=content&utm_medium=how-to",
  faqHeading: { en: "Frequently Asked Questions", de: "Häufig gestellte Fragen", es: "Preguntas frecuentes", fr: "Questions fréquentes", it: "Domande frequenti" },
