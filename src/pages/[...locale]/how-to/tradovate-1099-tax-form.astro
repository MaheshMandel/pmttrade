---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "tradovate-1099-tax-form";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/how-to/${SLUG}`;

const META_TITLE = "Find & Download Your Tradovate 1099 Tax Form";
const META_DESCRIPTION =
  "Tradovate 1099 tax form: switch to Live Trading, open Reports, pick your tax year, and download the 1099-B PDF for filing in minutes.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Ihr Tradovate-1099-Steuerformular finden & herunterladen", es: "Cómo encontrar y descargar su formulario fiscal 1099 de Tradovate", fr: "Trouver et télécharger votre formulaire fiscal 1099 Tradovate", it: "Come trovare e scaricare il suo modulo fiscale 1099 di Tradovate" },
  dek: { en: "Tax season rolls around and suddenly you need one specific document: your Tradovate 1099. Here's exactly how to find and download your 1099-B, step by step.", de: "Die Steuersaison beginnt, und plötzlich brauchen Sie ein bestimmtes Dokument: Ihre Tradovate-1099. Hier erfahren Sie Schritt für Schritt, wie Sie Ihre 1099-B finden und herunterladen.", es: "Llega la temporada de impuestos y de repente necesita un documento concreto: su 1099 de Tradovate. Aquí le explicamos paso a paso cómo encontrar y descargar su 1099-B.", fr: "La saison fiscale arrive et vous avez soudain besoin d'un document précis : votre 1099 Tradovate. Voici, étape par étape, comment trouver et télécharger votre 1099-B.", it: "Arriva la stagione fiscale e all'improvviso le serve un documento preciso: il suo 1099 di Tradovate. Ecco, passo dopo passo, come trovare e scaricare il suo 1099-B." },
  readTime: { en: "4 min read", de: "4 Min. Lesezeit", es: "Lectura de 4 min", fr: "Lecture : 4 min", it: "Lettura di 4 min" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "Tax season rolls around and suddenly you need one specific document: your Tradovate 1099. Maybe you're filing your futures gains yourself, maybe your accountant is asking for the official paperwork, or maybe you just want to reconcile a full year of trades before you sign anything. Whatever the reason, the form lives inside Tradovate's Reports panel, and pulling it takes about two minutes once you know where to click. Here's exactly how to find and download your 1099-B." },
    { type: "heading", text: "What Is a Tradovate 1099?" },
    { type: "paragraph", html: "A 1099 is the year-end tax statement your broker issues so you can report trading income to the IRS. For futures accounts, Tradovate hands you a <strong class='text-white'>1099-B</strong>, which summarizes the realized and unrealized profit and loss on your live brokerage account for the calendar year." },
    { type: "paragraph", html: "Here's the part that trips people up: unlike an equities 1099-B, the futures version doesn't list every single trade. It reports your overall P&L for the year as a single figure. That's normal for futures, not a missing page. Tradovate generally issues these statements in February for U.S.-based traders who placed at least one live trade during the prior year." },
    { type: "heading", text: "Finding Your 1099 in Tradovate: Step-by-Step" },
    {
      type: "steps",
      items: [
        { title: "Log In and Switch to Live Trading", html: "Your 1099 forms are tied to your live brokerage account, so you won't see them in Simulation mode. Log in to the Tradovate web app and confirm you're in <strong class='text-white'>Live Trading</strong> before you go any further. If you're stuck on the sim account, none of the following steps will show a 1099." },
        { title: "Open the Reports Panel", html: "With a live account selected, click the <strong class='text-white'>Reports</strong> button on the right side of the platform. That opens the reporting area where all your account statements live." },
        { title: "Select 1099 Tax Forms", html: "On the Account Reports page, choose the <strong class='text-white'>1099 Tax Forms</strong> option near the top. This narrows the view down to your year-end tax statements instead of burying them under daily or monthly reports." },
        { title: "Choose Your Tax Year", html: "Use the <strong class='text-white'>Tax Year</strong> dropdown in the center of the page to pick the year you need. If a year you expected isn't in the list, it usually means no reportable live trades were placed during that period, so no statement was generated." },
        { title: "Download the PDF", html: "Click the <strong class='text-white'>Download</strong> button next to each available statement to save it as a PDF from your browser. One heads-up: older tax-year PDFs can be password protected. Tradovate's help center lists the exact password format for each account type, so check there if a file won't open." },
      ],
    },
    { type: "heading", text: "Why You'd Need This" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Filing your taxes</strong>, the 1099-B is the document your return references for futures gains and losses.",
        "<strong class='text-white'>Handing paperwork to a CPA</strong>, accountants need the official statement, not a screenshot of your P&L.",
        "<strong class='text-white'>Reconciling your year</strong>, cross-check the reported P&L against your own records before you file.",
        "<strong class='text-white'>Keeping audit-ready records</strong>, download and archive each year's PDF while it's still easy to reach.",
      ],
    },
    { type: "paragraph", html: "Futures usually fall under special tax treatment, so it's worth confirming the specifics with a qualified tax professional. This guide covers where to <em>find</em> the form, not how to file it." },
    { type: "heading", text: "Automate This with PickMyTrade" },
    { type: "paragraph", html: "<strong class='text-white'>PickMyTrade links your TradingView alerts straight to your Tradovate account</strong>, so every signal executes automatically and lands in the same reports you'll pull at tax time. No manual clicks, no missed fills, and a clean, complete trade history waiting for you when your 1099 is generated." },
  ], de: [
    { type: "paragraph",html: "Die Steuersaison beginnt, und plötzlich brauchen Sie ein bestimmtes Dokument: Ihre Tradovate-1099. Vielleicht reichen Sie Ihre Futures-Gewinne selbst ein, vielleicht verlangt Ihr Steuerberater die offiziellen Unterlagen, oder Sie möchten ein ganzes Handelsjahr abgleichen, bevor Sie etwas unterschreiben. Was auch immer der Grund ist: Das Formular befindet sich im Bereich Reports von Tradovate, und es dauert etwa zwei Minuten, es abzurufen, sobald Sie wissen, wo Sie klicken müssen. So finden und laden Sie Ihre 1099-B herunter." },
    { type: "heading",text: "Was ist eine Tradovate-1099?" },
    { type: "paragraph",html: "Eine 1099 ist der Jahressteuerauszug, den Ihr Broker ausstellt, damit Sie Handelseinkünfte beim IRS melden können. Für Futures-Konten stellt Tradovate Ihnen eine <strong class='text-white'>1099-B</strong> aus, die den realisierten und nicht realisierten Gewinn und Verlust Ihres Live-Brokerage-Kontos für das Kalenderjahr zusammenfasst." },
    { type: "paragraph",html: "Das ist der Punkt, an dem viele stolpern: Anders als eine 1099-B für Aktien listet die Futures-Version nicht jeden einzelnen Trade auf. Sie weist Ihren Gesamtgewinn bzw. -verlust für das Jahr als einen einzigen Betrag aus. Das ist bei Futures normal und keine fehlende Seite. Tradovate stellt diese Auszüge in der Regel im Februar für Trader mit Sitz in den USA aus, die im Vorjahr mindestens einen Live-Trade getätigt haben." },
    { type: "heading",text: "Ihre 1099 in Tradovate finden: Schritt für Schritt" },
    {
      type: "steps",
      items: [
        { title: "Anmelden und zu Live Trading wechseln", html: "Ihre 1099-Formulare sind an Ihr Live-Brokerage-Konto gebunden, daher sehen Sie sie im Simulationsmodus nicht. Melden Sie sich in der Tradovate-Web-App an und vergewissern Sie sich, dass Sie sich im <strong class='text-white'>Live Trading</strong> befinden, bevor Sie fortfahren. Wenn Sie im Simulationskonto bleiben, zeigt keiner der folgenden Schritte eine 1099 an." },
        { title: "Das Reports-Panel öffnen", html: "Klicken Sie bei ausgewähltem Live-Konto auf der rechten Seite der Plattform auf die Schaltfläche <strong class='text-white'>Reports</strong>. Damit öffnet sich der Berichtsbereich, in dem alle Ihre Kontoauszüge liegen." },
        { title: "1099 Tax Forms auswählen", html: "Wählen Sie auf der Seite Account Reports oben die Option <strong class='text-white'>1099 Tax Forms</strong>. So sehen Sie nur Ihre Jahressteuerauszüge, statt dass sie unter den täglichen oder monatlichen Berichten untergehen." },
        { title: "Steuerjahr auswählen", html: "Wählen Sie im Dropdown <strong class='text-white'>Tax Year</strong> in der Mitte der Seite das gewünschte Jahr. Erscheint ein erwartetes Jahr nicht in der Liste, bedeutet das in der Regel, dass in diesem Zeitraum keine meldepflichtigen Live-Trades getätigt wurden und daher kein Auszug erstellt wurde." },
        { title: "Die PDF herunterladen", html: "Klicken Sie neben jedem verfügbaren Auszug auf die Schaltfläche <strong class='text-white'>Download</strong>, um ihn als PDF über Ihren Browser zu speichern. Ein Hinweis: PDFs älterer Steuerjahre können passwortgeschützt sein. Das Tradovate-Help-Center nennt das genaue Passwortformat für jeden Kontotyp. Sehen Sie dort nach, falls sich eine Datei nicht öffnen lässt." },
      ],
    },
    { type: "heading",text: "Warum Sie das benötigen" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Steuererklärung abgeben</strong>, die 1099-B ist das Dokument, auf das sich Ihre Steuererklärung für Futures-Gewinne und -Verluste stützt.",
        "<strong class='text-white'>Unterlagen an den Steuerberater übergeben</strong>, Steuerberater benötigen den offiziellen Auszug, keinen Screenshot Ihres P&L.",
        "<strong class='text-white'>Ihr Jahr abgleichen</strong>, vergleichen Sie den gemeldeten Gewinn bzw. Verlust vor der Abgabe mit Ihren eigenen Aufzeichnungen.",
        "<strong class='text-white'>Prüfungsfeste Unterlagen führen</strong>, laden Sie die PDF jedes Jahres herunter und archivieren Sie sie, solange sie leicht erreichbar ist.",
      ],
    },
    { type: "paragraph",html: "Futures unterliegen in der Regel einer besonderen steuerlichen Behandlung, lassen Sie sich die Einzelheiten daher von einer qualifizierten Steuerfachperson bestätigen. Diese Anleitung zeigt, wo Sie das Formular <em>finden</em>, nicht wie Sie es einreichen." },
    { type: "heading",text: "Automatisieren Sie das mit PickMyTrade" },
    { type: "paragraph",html: "<strong class='text-white'>PickMyTrade verbindet Ihre TradingView-Alerts direkt mit Ihrem Tradovate-Konto</strong>, sodass jedes Signal automatisch ausgeführt wird und in denselben Berichten landet, die Sie zur Steuerzeit abrufen. Keine manuellen Klicks, keine verpassten Fills und eine saubere, vollständige Handelshistorie, die auf Sie wartet, wenn Ihre 1099 erstellt wird." },
  ], es: [
    { type: "paragraph",html: "Llega la temporada de impuestos y de repente necesita un documento concreto: su 1099 de Tradovate. Quizá esté declarando usted mismo sus ganancias en futuros, quizá su contador le pide la documentación oficial, o simplemente quiere conciliar un año completo de operaciones antes de firmar nada. Sea cual sea el motivo, el formulario se encuentra en el panel Reports de Tradovate, y obtenerlo lleva unos dos minutos una vez que sabe dónde hacer clic. Así es exactamente cómo encontrar y descargar su 1099-B." },
    { type: "heading",text: "¿Qué es un 1099 de Tradovate?" },
    { type: "paragraph",html: "Un 1099 es el estado fiscal de fin de año que emite su bróker para que pueda declarar sus ingresos de trading al IRS. Para las cuentas de futuros, Tradovate le entrega un <strong class='text-white'>1099-B</strong>, que resume la ganancia y pérdida realizada y no realizada de su cuenta de corretaje real durante el año natural." },
    { type: "paragraph",html: "Esta es la parte que confunde a la gente: a diferencia de un 1099-B de renta variable, la versión de futuros no enumera todas las operaciones. Informa de su resultado total del año como una única cifra. Eso es normal en futuros, no una página que falta. Tradovate suele emitir estos estados en febrero para los traders con sede en EE. UU. que realizaron al menos una operación real durante el año anterior." },
    { type: "heading",text: "Cómo encontrar su 1099 en Tradovate: paso a paso" },
    {
      type: "steps",
      items: [
        { title: "Inicie sesión y cambie a Live Trading", html: "Sus formularios 1099 están vinculados a su cuenta de corretaje real, por lo que no los verá en modo Simulation. Inicie sesión en la aplicación web de Tradovate y confirme que está en <strong class='text-white'>Live Trading</strong> antes de continuar. Si sigue en la cuenta de simulación, ninguno de los pasos siguientes mostrará un 1099." },
        { title: "Abra el panel Reports", html: "Con una cuenta real seleccionada, haga clic en el botón <strong class='text-white'>Reports</strong> en el lado derecho de la plataforma. Se abrirá el área de informes donde se encuentran todos los estados de su cuenta." },
        { title: "Seleccione 1099 Tax Forms", html: "En la página Account Reports, elija la opción <strong class='text-white'>1099 Tax Forms</strong> cerca de la parte superior. Así la vista se limita a sus estados fiscales de fin de año, en lugar de quedar enterrados entre los informes diarios o mensuales." },
        { title: "Elija su año fiscal", html: "Use el desplegable <strong class='text-white'>Tax Year</strong> en el centro de la página para elegir el año que necesita. Si un año que esperaba no aparece en la lista, normalmente significa que no se realizaron operaciones reales declarables durante ese periodo, por lo que no se generó ningún estado." },
        { title: "Descargue el PDF", html: "Haga clic en el botón <strong class='text-white'>Download</strong> junto a cada estado disponible para guardarlo como PDF desde su navegador. Un aviso: los PDF de años fiscales anteriores pueden estar protegidos con contraseña. El centro de ayuda de Tradovate indica el formato exacto de la contraseña para cada tipo de cuenta, así que consúltelo si un archivo no se abre." },
      ],
    },
    { type: "heading",text: "Por qué lo necesitaría" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Presentar sus impuestos</strong>, el 1099-B es el documento al que hace referencia su declaración para las ganancias y pérdidas en futuros.",
        "<strong class='text-white'>Entregar la documentación a un contador</strong>, los contadores necesitan el estado oficial, no una captura de pantalla de su P&L.",
        "<strong class='text-white'>Conciliar su año</strong>, compare el P&L declarado con sus propios registros antes de presentar la declaración.",
        "<strong class='text-white'>Mantener registros listos para una auditoría</strong>, descargue y archive el PDF de cada año mientras todavía es fácil acceder a él.",
      ],
    },
    { type: "paragraph",html: "Los futuros suelen tener un tratamiento fiscal especial, por lo que conviene confirmar los detalles con un profesional fiscal cualificado. Esta guía explica dónde <em>encontrar</em> el formulario, no cómo presentarlo." },
    { type: "heading",text: "Automatice esto con PickMyTrade" },
    { type: "paragraph",html: "<strong class='text-white'>PickMyTrade conecta sus alertas de TradingView directamente con su cuenta de Tradovate</strong>, de modo que cada señal se ejecuta automáticamente y queda en los mismos informes que consultará a la hora de los impuestos. Sin clics manuales, sin ejecuciones perdidas y con un historial de operaciones limpio y completo esperándole cuando se genere su 1099." },
  ], fr: [
    { type: "paragraph",html: "La saison fiscale arrive et vous avez soudain besoin d'un document précis : votre 1099 Tradovate. Peut-être déclarez-vous vous-même vos gains sur futures, peut-être votre comptable réclame-t-il les documents officiels, ou peut-être voulez-vous simplement rapprocher une année complète de trades avant de signer quoi que ce soit. Quelle qu'en soit la raison, le formulaire se trouve dans le panneau Reports de Tradovate, et il suffit d'environ deux minutes pour le récupérer une fois que vous savez où cliquer. Voici exactement comment trouver et télécharger votre 1099-B." },
    { type: "heading",text: "Qu'est-ce qu'un 1099 Tradovate ?" },
    { type: "paragraph",html: "Un 1099 est le relevé fiscal de fin d'année que votre courtier émet afin que vous puissiez déclarer vos revenus de trading à l'IRS. Pour les comptes de futures, Tradovate vous remet un <strong class='text-white'>1099-B</strong>, qui récapitule les gains et pertes réalisés et non réalisés de votre compte de courtage réel pour l'année civile." },
    { type: "paragraph",html: "Voici le point qui déroute : contrairement à un 1099-B sur actions, la version futures ne liste pas chaque trade. Elle indique votre résultat global de l'année sous la forme d'un seul chiffre. C'est normal pour les futures, et non une page manquante. Tradovate émet généralement ces relevés en février pour les traders basés aux États-Unis ayant passé au moins un trade réel au cours de l'année précédente." },
    { type: "heading",text: "Trouver votre 1099 dans Tradovate : étape par étape" },
    {
      type: "steps",
      items: [
        { title: "Connectez-vous et passez en Live Trading", html: "Vos formulaires 1099 sont rattachés à votre compte de courtage réel ; vous ne les verrez donc pas en mode Simulation. Connectez-vous à l'application web Tradovate et vérifiez que vous êtes en <strong class='text-white'>Live Trading</strong> avant d'aller plus loin. Si vous restez sur le compte de simulation, aucune des étapes suivantes n'affichera de 1099." },
        { title: "Ouvrez le panneau Reports", html: "Avec un compte réel sélectionné, cliquez sur le bouton <strong class='text-white'>Reports</strong> sur le côté droit de la plateforme. Cela ouvre la zone de rapports où se trouvent tous les relevés de votre compte." },
        { title: "Sélectionnez 1099 Tax Forms", html: "Sur la page Account Reports, choisissez l'option <strong class='text-white'>1099 Tax Forms</strong> en haut de la page. La vue se limite alors à vos relevés fiscaux de fin d'année, au lieu de les noyer parmi les rapports quotidiens ou mensuels." },
        { title: "Choisissez votre année fiscale", html: "Utilisez la liste déroulante <strong class='text-white'>Tax Year</strong> au centre de la page pour choisir l'année dont vous avez besoin. Si une année attendue ne figure pas dans la liste, cela signifie généralement qu'aucun trade réel déclarable n'a été passé durant cette période et qu'aucun relevé n'a donc été généré." },
        { title: "Téléchargez le PDF", html: "Cliquez sur le bouton <strong class='text-white'>Download</strong> à côté de chaque relevé disponible pour l'enregistrer au format PDF depuis votre navigateur. Une précision : les PDF des années fiscales précédentes peuvent être protégés par mot de passe. Le centre d'aide de Tradovate indique le format exact du mot de passe pour chaque type de compte ; consultez-le si un fichier ne s'ouvre pas." },
      ],
    },
    { type: "heading",text: "Pourquoi vous en auriez besoin" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Déclarer vos impôts</strong>, le 1099-B est le document auquel se réfère votre déclaration pour les gains et pertes sur futures.",
        "<strong class='text-white'>Remettre les documents à un comptable</strong>, les comptables ont besoin du relevé officiel, et non d'une capture d'écran de votre P&L.",
        "<strong class='text-white'>Rapprocher votre année</strong>, comparez le P&L déclaré avec vos propres relevés avant de déposer votre déclaration.",
        "<strong class='text-white'>Conserver des documents prêts pour un contrôle</strong>, téléchargez et archivez le PDF de chaque année tant qu'il est encore facile d'accès.",
      ],
    },
    { type: "paragraph",html: "Les futures bénéficient généralement d'un traitement fiscal particulier ; il est donc judicieux d'en confirmer les modalités auprès d'un professionnel de la fiscalité qualifié. Ce guide explique où <em>trouver</em> le formulaire, et non comment le déposer." },
    { type: "heading",text: "Automatisez cela avec PickMyTrade" },
    { type: "paragraph",html: "<strong class='text-white'>PickMyTrade relie vos alertes TradingView directement à votre compte Tradovate</strong>, de sorte que chaque signal s'exécute automatiquement et apparaît dans les mêmes rapports que vous consulterez au moment de la déclaration. Pas de clics manuels, pas d'exécutions manquées, et un historique de trades propre et complet qui vous attend lorsque votre 1099 est générée." },
  ], it: [
    { type: "paragraph",html: "Arriva la stagione fiscale e all'improvviso le serve un documento preciso: il suo 1099 di Tradovate. Magari sta dichiarando da sé i suoi guadagni sui futures, magari il suo commercialista le chiede la documentazione ufficiale, oppure vuole semplicemente riconciliare un anno intero di trade prima di firmare qualsiasi cosa. Qualunque sia il motivo, il modulo si trova nel pannello Reports di Tradovate e recuperarlo richiede circa due minuti, una volta che sa dove cliccare. Ecco esattamente come trovare e scaricare il suo 1099-B." },
    { type: "heading",text: "Che cos'è un 1099 di Tradovate?" },
    { type: "paragraph",html: "Un 1099 è l'estratto fiscale di fine anno che il suo broker emette affinché lei possa dichiarare i proventi del trading all'IRS. Per i conti futures, Tradovate le fornisce un <strong class='text-white'>1099-B</strong>, che riepiloga il profitto e la perdita realizzati e non realizzati del suo conto di intermediazione live per l'anno solare." },
    { type: "paragraph",html: "Ecco il punto che confonde molti: a differenza di un 1099-B azionario, la versione per i futures non elenca ogni singolo trade. Riporta il suo risultato complessivo dell'anno come un'unica cifra. È normale per i futures, non è una pagina mancante. Tradovate emette di solito questi estratti a febbraio per i trader con sede negli Stati Uniti che hanno effettuato almeno un trade live nell'anno precedente." },
    { type: "heading",text: "Trovare il suo 1099 in Tradovate: passo dopo passo" },
    {
      type: "steps",
      items: [
        { title: "Acceda e passi a Live Trading", html: "I suoi moduli 1099 sono collegati al suo conto di intermediazione live, quindi non li vedrà in modalità Simulation. Acceda all'app web di Tradovate e verifichi di essere in <strong class='text-white'>Live Trading</strong> prima di procedere. Se resta sul conto di simulazione, nessuno dei passaggi seguenti mostrerà un 1099." },
        { title: "Apra il pannello Reports", html: "Con un conto live selezionato, clicchi sul pulsante <strong class='text-white'>Reports</strong> sul lato destro della piattaforma. Si apre l'area dei report in cui si trovano tutti gli estratti del suo conto." },
        { title: "Selezioni 1099 Tax Forms", html: "Nella pagina Account Reports, scelga l'opzione <strong class='text-white'>1099 Tax Forms</strong> in alto. In questo modo la vista si restringe ai suoi estratti fiscali di fine anno, invece di vederli sepolti tra i report giornalieri o mensili." },
        { title: "Scelga l'anno fiscale", html: "Usi il menu a discesa <strong class='text-white'>Tax Year</strong> al centro della pagina per scegliere l'anno che le serve. Se un anno che si aspettava non compare nell'elenco, di solito significa che in quel periodo non sono stati effettuati trade live dichiarabili e quindi non è stato generato alcun estratto." },
        { title: "Scarichi il PDF", html: "Clicchi sul pulsante <strong class='text-white'>Download</strong> accanto a ciascun estratto disponibile per salvarlo come PDF dal suo browser. Un'avvertenza: i PDF degli anni fiscali precedenti possono essere protetti da password. Il centro assistenza di Tradovate indica il formato esatto della password per ogni tipo di conto, quindi lo consulti se un file non si apre." },
      ],
    },
    { type: "heading",text: "Perché le servirebbe" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Presentare la dichiarazione dei redditi</strong>, il 1099-B è il documento a cui fa riferimento la sua dichiarazione per i guadagni e le perdite sui futures.",
        "<strong class='text-white'>Consegnare la documentazione a un commercialista</strong>, i commercialisti hanno bisogno dell'estratto ufficiale, non di uno screenshot del suo P&L.",
        "<strong class='text-white'>Riconciliare il suo anno</strong>, confronti il P&L dichiarato con le sue registrazioni prima di presentare la dichiarazione.",
        "<strong class='text-white'>Conservare registrazioni pronte per un controllo</strong>, scarichi e archivi il PDF di ogni anno finché è ancora facile da raggiungere.",
      ],
    },
