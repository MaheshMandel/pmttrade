---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "tradovate-group-trade";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/how-to/${SLUG}`;

const META_TITLE = "Trade Multiple Accounts With Tradovate Group Trade";
const META_DESCRIPTION =
  "Enable Tradovate Group Trade to fire one order across several accounts at once. Step-by-step setup, the quantity rule, and the limits worth knowing.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Mehrere Konten handeln mit Tradovate Group Trade", es: "Opere varias cuentas con Tradovate Group Trade", fr: "Trader plusieurs comptes avec Tradovate Group Trade", it: "Operare su più conti con Tradovate Group Trade" },
  dek: { en: "Running a stack of Tradovate accounts and tired of clicking the same trade into each one? Here's how to set up Group Trade, plus the rules that trip people up.", de: "Sie führen einen ganzen Stapel Tradovate-Konten und haben es satt, denselben Trade in jedes einzeln zu klicken? So richten Sie Group Trade ein, plus die Regeln, über die viele stolpern.", es: "¿Gestiona un montón de cuentas de Tradovate y está harto de introducir la misma operación en cada una? Así se configura Group Trade, además de las reglas con las que mucha gente tropieza.", fr: "Vous gérez une pile de comptes Tradovate et en avez assez de saisir le même trade dans chacun ? Voici comment configurer Group Trade, ainsi que les règles qui font trébucher beaucoup d’utilisateurs.", it: "Gestisce una serie di conti Tradovate ed è stanco di inserire lo stesso trade in ciascuno? Ecco come configurare Group Trade, più le regole su cui molti inciampano." },
  readTime: { en: "6 min read", de: "6 Min. Lesezeit", es: "Lectura de 6 min", fr: "Lecture : 6 min", it: "Lettura di 6 min" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "Running two, three, or a whole stack of Tradovate accounts and tired of clicking the same trade into each one? Group Trade is Tradovate's built-in answer. Set up a group once, pick it from your account list, and every order you fire gets copied to each account at the size you chose. Here's how to set it up, plus the couple of rules that trip people up." },
    { type: "heading", text: "What Group Trade Does" },
    { type: "paragraph", html: "Group Trade (you'll also see it called a group or trade copier) lets you place a single order and have it sent to several accounts at once. The catch that matters most: every account in the group has to sit under the <strong class='text-white'>same Tradovate login</strong>. If your accounts are spread across different usernames or different prop firms, Tradovate can't group them natively, you'd need a separate copier for that." },
    { type: "heading", text: "Before You Start" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>More than one account on the same login.</strong> The Manage Groups option only shows up once your username has at least two accounts attached.",
        "<strong class='text-white'>Use the web or desktop app.</strong> Group Trade lives in the full Tradovate platform, not the mobile app, and not inside a TradingView chart.",
        "<strong class='text-white'>Know your firm's rules.</strong> If these are prop accounts, whether you're allowed to copy across evaluation and funded accounts varies by firm and account size. Check your firm's current rules before you rely on it.",
      ],
    },
    { type: "heading", text: "How to Set Up a Group in Tradovate: Step-by-Step" },
    {
      type: "steps",
      items: [
        { title: "Open Manage Groups", html: "Click the <strong class='text-white'>account drop-down</strong> at the top of the Tradovate Trader, the same menu where you switch between accounts, and choose <strong class='text-white'>Manage Groups</strong>. Don't see it? Your login only has one account attached, so there's nothing to group yet." },
        { title: "Create and Name Your Group", html: "In the Manage Groups window, click the <strong class='text-white'>+</strong> button to start a new group and give it a name you'll recognize later, something like \"All Apex\" or \"Live + Sim.\" You can build several groups and switch between them, so keep the names clear." },
        { title: "Add Your Accounts to the Group", html: "You'll see your accounts listed on the left and the group on the right. <strong class='text-white'>Click and drag</strong> each account you want to trade together from the left frame into the right frame. Only the accounts you drop into the group get the copied orders, anything you leave on the left is untouched." },
        { title: "Set Each Account's Size and Save", html: "Each account in the group gets its own <strong class='text-white'>Qty</strong>, the number of contracts it trades relative to the others. Move those numbers up or down to set the ratio (say, 1 contract on the smaller account and 2 on the bigger one). When it looks right, click <strong class='text-white'>Save</strong>, confirm the group, and hit <strong class='text-white'>Close</strong>." },
        { title: "Select the Group and Place Your Order", html: "Back on the Trader, open the <strong class='text-white'>account drop-down</strong> again, your new group now sits in the list alongside your individual accounts. Pick it, then place your order like normal. Tradovate copies that order into every account in the group at the sizes you set." },
      ],
    },
    { type: "heading", text: "The Quantity Rule (Read This Before You Trade)" },
    { type: "paragraph", html: "Here's the one that catches people out: your order quantity has to be a <strong class='text-white'>multiple of the group's total quantity</strong>. Add up the Qty across every account, if that total is 3, you can send 3, 6, or 9, but not 4 or 5. A number that isn't a clean multiple can't split evenly across the accounts, so it gets rejected. Keep your ratios simple and this stops being an issue." },
    { type: "heading", text: "Limits Worth Knowing" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>One login only.</strong> Accounts under different usernames or different prop firms can't be grouped inside Tradovate.",
        "<strong class='text-white'>Desktop and web only.</strong> There's no Group Trade on the mobile app, and you can't trigger it from a TradingView chart, grouped orders have to come from the Tradovate platform itself.",
        "<strong class='text-white'>Brackets need care.</strong> Group Trade is built for clean, symmetrical order copying. Auto bracket (ATM) orders don't behave the same way across a group, so if your setup leans on automatic stop and target brackets on every account, test it hard first.",
      ],
    },
    { type: "heading", text: "Copy One Signal to Every Account, Even Across Firms" },
    { type: "paragraph", html: "Group Trade shines when your accounts live under one Tradovate login and you're trading by hand. It falls short the moment they're spread across different logins or prop firms, or you want a TradingView alert to hit all of them automatically. That's the gap PickMyTrade fills: point your TradingView strategy or alert at PickMyTrade and it copies the same signal into every Tradovate account you connect, whatever login they're under." },
  ], de: [
    { type: "paragraph",html: "Sie führen zwei, drei oder einen ganzen Stapel Tradovate-Konten und haben es satt, denselben Trade in jedes einzeln zu klicken? Group Trade ist die eingebaute Antwort von Tradovate. Richten Sie eine Gruppe einmal ein, wählen Sie sie aus Ihrer Kontoliste aus, und jede Order, die Sie abschicken, wird in der von Ihnen gewählten Größe in jedes Konto kopiert. So richten Sie es ein, plus die paar Regeln, über die viele stolpern." },
    { type: "heading",text: "Was Group Trade leistet" },
    { type: "paragraph",html: "Mit Group Trade (auch als Gruppe oder Trade Copier bezeichnet) platzieren Sie eine einzige Order und lassen sie an mehrere Konten gleichzeitig senden. Der entscheidende Haken: Jedes Konto der Gruppe muss unter <strong class='text-white'>demselben Tradovate-Login</strong> liegen. Wenn Ihre Konten auf verschiedene Benutzernamen oder verschiedene Prop Firms verteilt sind, kann Tradovate sie nicht nativ gruppieren, und Sie bräuchten dafür einen separaten Copier." },
    { type: "heading",text: "Bevor Sie beginnen" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Mehr als ein Konto unter demselben Login.</strong> Die Option Manage Groups erscheint erst, wenn Ihrem Benutzernamen mindestens zwei Konten zugeordnet sind.",
        "<strong class='text-white'>Nutzen Sie die Web- oder Desktop-App.</strong> Group Trade befindet sich in der vollständigen Tradovate-Plattform, nicht in der mobilen App und nicht in einem TradingView-Chart.",
        "<strong class='text-white'>Kennen Sie die Regeln Ihrer Firma.</strong> Wenn es sich um Prop-Konten handelt, hängt es von Firma und Kontogröße ab, ob Sie zwischen Evaluierungs- und finanzierten Konten kopieren dürfen. Prüfen Sie die aktuellen Regeln Ihrer Firma, bevor Sie sich darauf verlassen.",
      ],
    },
    { type: "heading",text: "So richten Sie eine Gruppe in Tradovate ein: Schritt für Schritt" },
    {
      type: "steps",
      items: [
        { title: "Manage Groups öffnen", html: "Klicken Sie oben im Tradovate Trader auf das <strong class='text-white'>Konto-Dropdown</strong>, dasselbe Menü, in dem Sie zwischen Konten wechseln, und wählen Sie <strong class='text-white'>Manage Groups</strong>. Sehen Sie es nicht? Dann ist Ihrem Login nur ein Konto zugeordnet, und es gibt noch nichts zu gruppieren." },
        { title: "Die Gruppe erstellen und benennen", html: "Klicken Sie im Fenster Manage Groups auf die Schaltfläche <strong class='text-white'>+</strong>, um eine neue Gruppe anzulegen, und geben Sie ihr einen Namen, den Sie später wiedererkennen, etwa „All Apex“ oder „Live + Sim“. Sie können mehrere Gruppen anlegen und zwischen ihnen wechseln, wählen Sie die Namen also klar." },
        { title: "Ihre Konten zur Gruppe hinzufügen", html: "Links sehen Sie Ihre Konten, rechts die Gruppe. <strong class='text-white'>Klicken und ziehen</strong> Sie jedes Konto, das gemeinsam handeln soll, vom linken in den rechten Bereich. Nur die Konten, die Sie in die Gruppe ziehen, erhalten die kopierten Orders; alles, was links bleibt, wird nicht berührt." },
        { title: "Die Größe jedes Kontos festlegen und speichern", html: "Jedes Konto der Gruppe erhält eine eigene <strong class='text-white'>Qty</strong>, die Anzahl der Kontrakte, die es im Verhältnis zu den anderen handelt. Erhöhen oder verringern Sie diese Zahlen, um das Verhältnis festzulegen (zum Beispiel 1 Kontrakt auf dem kleineren Konto und 2 auf dem größeren). Wenn alles passt, klicken Sie auf <strong class='text-white'>Save</strong>, bestätigen Sie die Gruppe und klicken Sie auf <strong class='text-white'>Close</strong>." },
        { title: "Die Gruppe auswählen und Ihre Order platzieren", html: "Öffnen Sie zurück im Trader erneut das <strong class='text-white'>Konto-Dropdown</strong>; Ihre neue Gruppe steht nun in der Liste neben Ihren einzelnen Konten. Wählen Sie sie aus und platzieren Sie Ihre Order wie gewohnt. Tradovate kopiert diese Order in jedes Konto der Gruppe mit den von Ihnen festgelegten Größen." },
      ],
    },
    { type: "heading",text: "Die Mengenregel (vor dem Handeln lesen)" },
    { type: "paragraph",html: "Das ist die Regel, über die viele stolpern: Ihre Ordermenge muss ein <strong class='text-white'>Vielfaches der Gesamtmenge der Gruppe</strong> sein. Addieren Sie die Qty über alle Konten. Wenn die Summe 3 beträgt, können Sie 3, 6 oder 9 senden, aber nicht 4 oder 5. Eine Zahl, die kein glattes Vielfaches ist, lässt sich nicht gleichmäßig auf die Konten verteilen und wird deshalb abgelehnt. Halten Sie Ihre Verhältnisse einfach, dann ist das kein Problem mehr." },
    { type: "heading",text: "Grenzen, die Sie kennen sollten" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Nur ein Login.</strong> Konten unter verschiedenen Benutzernamen oder verschiedenen Prop Firms lassen sich in Tradovate nicht gruppieren.",
        "<strong class='text-white'>Nur Desktop und Web.</strong> Es gibt kein Group Trade in der mobilen App, und Sie können es nicht aus einem TradingView-Chart auslösen; gruppierte Orders müssen von der Tradovate-Plattform selbst kommen.",
        "<strong class='text-white'>Brackets brauchen Sorgfalt.</strong> Group Trade ist für sauberes, symmetrisches Kopieren von Orders gebaut. Auto-Bracket-Orders (ATM) verhalten sich in einer Gruppe nicht gleich. Wenn Ihr Setup also auf automatische Stop- und Target-Brackets auf jedem Konto setzt, testen Sie es gründlich.",
      ],
    },
    { type: "heading",text: "Ein Signal in jedes Konto kopieren, auch firmenübergreifend" },
    { type: "paragraph",html: "Group Trade glänzt, wenn Ihre Konten unter einem Tradovate-Login liegen und Sie von Hand handeln. Es stößt an Grenzen, sobald die Konten auf verschiedene Logins oder Prop Firms verteilt sind oder ein TradingView-Alert alle automatisch treffen soll. Genau diese Lücke schließt PickMyTrade: Richten Sie Ihre TradingView-Strategie oder Ihren Alert auf PickMyTrade, und es kopiert dasselbe Signal in jedes Tradovate-Konto, das Sie verbinden, egal unter welchem Login es läuft." },
  ], es: [
    { type: "paragraph",html: "¿Gestiona dos, tres o un montón de cuentas de Tradovate y está harto de introducir la misma operación en cada una? Group Trade es la respuesta integrada de Tradovate. Configure un grupo una sola vez, elíjalo en su lista de cuentas y cada orden que envíe se copiará a cada cuenta con el tamaño que haya elegido. Aquí le explicamos cómo configurarlo, además de las pocas reglas con las que mucha gente tropieza." },
    { type: "heading",text: "Qué hace Group Trade" },
    { type: "paragraph",html: "Group Trade (también lo verá llamado grupo o copiador de operaciones) le permite colocar una sola orden y que se envíe a varias cuentas a la vez. La condición más importante: todas las cuentas del grupo deben estar bajo el <strong class='text-white'>mismo inicio de sesión de Tradovate</strong>. Si sus cuentas están repartidas entre distintos nombres de usuario o distintas prop firms, Tradovate no puede agruparlas de forma nativa y necesitaría un copiador aparte para eso." },
    { type: "heading",text: "Antes de empezar" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Más de una cuenta con el mismo inicio de sesión.</strong> La opción Manage Groups solo aparece cuando su nombre de usuario tiene al menos dos cuentas asociadas.",
        "<strong class='text-white'>Utilice la aplicación web o de escritorio.</strong> Group Trade está en la plataforma completa de Tradovate, no en la aplicación móvil ni dentro de un gráfico de TradingView.",
        "<strong class='text-white'>Conozca las reglas de su firma.</strong> Si son cuentas de prop firm, que se permita copiar entre cuentas de evaluación y fondeadas varía según la firma y el tamaño de la cuenta. Consulte las reglas vigentes de su firma antes de contar con ello.",
      ],
    },
    { type: "heading",text: "Cómo configurar un grupo en Tradovate: paso a paso" },
    {
      type: "steps",
      items: [
        { title: "Abra Manage Groups", html: "Haga clic en el <strong class='text-white'>menú desplegable de cuentas</strong> en la parte superior del Tradovate Trader, el mismo menú donde cambia entre cuentas, y elija <strong class='text-white'>Manage Groups</strong>. ¿No lo ve? Su inicio de sesión solo tiene una cuenta asociada, por lo que aún no hay nada que agrupar." },
        { title: "Cree su grupo y póngale nombre", html: "En la ventana Manage Groups, haga clic en el botón <strong class='text-white'>+</strong> para iniciar un nuevo grupo y asígnele un nombre que reconozca más tarde, algo como «All Apex» o «Live + Sim». Puede crear varios grupos y alternar entre ellos, así que use nombres claros." },
        { title: "Añada sus cuentas al grupo", html: "Verá sus cuentas listadas a la izquierda y el grupo a la derecha. <strong class='text-white'>Haga clic y arrastre</strong> cada cuenta que quiera operar en conjunto desde el marco izquierdo al derecho. Solo las cuentas que suelte en el grupo reciben las órdenes copiadas; todo lo que deje a la izquierda no se toca." },
        { title: "Fije el tamaño de cada cuenta y guarde", html: "Cada cuenta del grupo recibe su propia <strong class='text-white'>Qty</strong>, el número de contratos que opera en relación con las demás. Suba o baje esos números para fijar la proporción (por ejemplo, 1 contrato en la cuenta más pequeña y 2 en la más grande). Cuando todo esté bien, haga clic en <strong class='text-white'>Save</strong>, confirme el grupo y pulse <strong class='text-white'>Close</strong>." },
        { title: "Seleccione el grupo y coloque su orden", html: "De vuelta en el Trader, abra de nuevo el <strong class='text-white'>menú desplegable de cuentas</strong>: su nuevo grupo aparece en la lista junto a sus cuentas individuales. Selecciónelo y coloque su orden con normalidad. Tradovate copia esa orden en cada cuenta del grupo con los tamaños que usted fijó." },
      ],
    },
    { type: "heading",text: "La regla de la cantidad (léala antes de operar)" },
    { type: "paragraph",html: "Esta es la regla con la que mucha gente tropieza: la cantidad de su orden debe ser un <strong class='text-white'>múltiplo de la cantidad total del grupo</strong>. Sume la Qty de todas las cuentas; si el total es 3, puede enviar 3, 6 o 9, pero no 4 ni 5. Un número que no es un múltiplo exacto no puede repartirse por igual entre las cuentas, así que se rechaza. Mantenga proporciones sencillas y deja de ser un problema." },
    { type: "heading",text: "Límites que conviene conocer" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Un solo inicio de sesión.</strong> Las cuentas con distintos nombres de usuario o de distintas prop firms no se pueden agrupar dentro de Tradovate.",
        "<strong class='text-white'>Solo escritorio y web.</strong> No hay Group Trade en la aplicación móvil y no puede activarlo desde un gráfico de TradingView; las órdenes agrupadas deben provenir de la propia plataforma de Tradovate.",
        "<strong class='text-white'>Los brackets requieren cuidado.</strong> Group Trade está pensado para copiar órdenes de forma limpia y simétrica. Las órdenes bracket automáticas (ATM) no se comportan igual en un grupo, así que si su configuración depende de brackets automáticos de stop y objetivo en cada cuenta, pruébela a fondo primero.",
      ],
    },
    { type: "heading",text: "Copie una señal a todas las cuentas, incluso entre firmas" },
    { type: "paragraph",html: "Group Trade destaca cuando sus cuentas están bajo un solo inicio de sesión de Tradovate y opera manualmente. Se queda corto en cuanto están repartidas entre distintos inicios de sesión o prop firms, o si quiere que una alerta de TradingView las alcance a todas automáticamente. Ese es el hueco que cubre PickMyTrade: dirija su estrategia o alerta de TradingView a PickMyTrade y copiará la misma señal en cada cuenta de Tradovate que conecte, sea cual sea el inicio de sesión." },
  ], fr: [
    { type: "paragraph",html: "Vous gérez deux, trois comptes Tradovate ou toute une pile, et vous en avez assez de saisir le même trade dans chacun ? Group Trade est la réponse intégrée de Tradovate. Configurez un groupe une seule fois, choisissez-le dans votre liste de comptes, et chaque ordre que vous envoyez est copié dans chaque compte à la taille que vous avez choisie. Voici comment le configurer, ainsi que les quelques règles qui font trébucher beaucoup d’utilisateurs." },
    { type: "heading",text: "Ce que fait Group Trade" },
    { type: "paragraph",html: "Group Trade (vous le verrez aussi appelé groupe ou copieur de trades) vous permet de passer un seul ordre et de l’envoyer à plusieurs comptes à la fois. La condition la plus importante : tous les comptes du groupe doivent relever du <strong class='text-white'>même identifiant Tradovate</strong>. Si vos comptes sont répartis entre plusieurs noms d’utilisateur ou plusieurs prop firms, Tradovate ne peut pas les regrouper nativement ; il vous faudrait alors un copieur distinct." },
    { type: "heading",text: "Avant de commencer" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Plus d’un compte sous le même identifiant.</strong> L’option Manage Groups n’apparaît que lorsque votre nom d’utilisateur est rattaché à au moins deux comptes.",
        "<strong class='text-white'>Utilisez l’application web ou de bureau.</strong> Group Trade se trouve dans la plateforme Tradovate complète, pas dans l’application mobile, ni dans un graphique TradingView.",
        "<strong class='text-white'>Connaissez les règles de votre société.</strong> S’il s’agit de comptes de prop firm, la possibilité de copier entre comptes d’évaluation et approvisionnés varie selon la société et la taille du compte. Vérifiez les règles en vigueur de votre société avant de vous y fier.",
      ],
    },
    { type: "heading",text: "Comment configurer un groupe dans Tradovate : pas à pas" },
    {
      type: "steps",
      items: [
        { title: "Ouvrir Manage Groups", html: "Cliquez sur la <strong class='text-white'>liste déroulante des comptes</strong> en haut du Tradovate Trader, le même menu qui vous permet de passer d’un compte à l’autre, et choisissez <strong class='text-white'>Manage Groups</strong>. Vous ne le voyez pas ? Votre identifiant n’a qu’un seul compte rattaché, il n’y a donc encore rien à regrouper." },
        { title: "Créer et nommer votre groupe", html: "Dans la fenêtre Manage Groups, cliquez sur le bouton <strong class='text-white'>+</strong> pour créer un nouveau groupe et donnez-lui un nom que vous reconnaîtrez plus tard, par exemple « All Apex » ou « Live + Sim ». Vous pouvez créer plusieurs groupes et passer de l’un à l’autre ; choisissez donc des noms clairs." },
        { title: "Ajouter vos comptes au groupe", html: "Vos comptes sont listés à gauche et le groupe à droite. <strong class='text-white'>Cliquez et faites glisser</strong> chaque compte que vous voulez trader ensemble du cadre de gauche vers celui de droite. Seuls les comptes que vous déposez dans le groupe reçoivent les ordres copiés ; tout ce que vous laissez à gauche reste intact." },
        { title: "Définir la taille de chaque compte et enregistrer", html: "Chaque compte du groupe reçoit sa propre <strong class='text-white'>Qty</strong>, le nombre de contrats qu’il trade par rapport aux autres. Augmentez ou diminuez ces nombres pour définir le ratio (par exemple, 1 contrat sur le plus petit compte et 2 sur le plus grand). Quand tout vous convient, cliquez sur <strong class='text-white'>Save</strong>, confirmez le groupe et cliquez sur <strong class='text-white'>Close</strong>." },
        { title: "Sélectionner le groupe et passer votre ordre", html: "De retour sur le Trader, ouvrez à nouveau la <strong class='text-white'>liste déroulante des comptes</strong> : votre nouveau groupe figure désormais dans la liste, à côté de vos comptes individuels. Sélectionnez-le, puis passez votre ordre comme d’habitude. Tradovate copie cet ordre dans chaque compte du groupe aux tailles que vous avez définies." },
      ],
    },
    { type: "heading",text: "La règle de quantité (à lire avant de trader)" },
    { type: "paragraph",html: "Voici la règle qui piège beaucoup d’utilisateurs : la quantité de votre ordre doit être un <strong class='text-white'>multiple de la quantité totale du groupe</strong>. Additionnez la Qty de tous les comptes ; si ce total est 3, vous pouvez envoyer 3, 6 ou 9, mais pas 4 ni 5. Un nombre qui n’est pas un multiple exact ne peut pas être réparti également entre les comptes et est donc rejeté. Gardez des ratios simples et ce ne sera plus un problème." },
    { type: "heading",text: "Limites à connaître" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Un seul identifiant.</strong> Les comptes relevant de noms d’utilisateur différents ou de prop firms différentes ne peuvent pas être regroupés dans Tradovate.",
        "<strong class='text-white'>Bureau et web uniquement.</strong> Il n’y a pas de Group Trade dans l’application mobile, et vous ne pouvez pas le déclencher depuis un graphique TradingView ; les ordres groupés doivent provenir de la plateforme Tradovate elle-même.",
        "<strong class='text-white'>Les brackets demandent de l’attention.</strong> Group Trade est conçu pour une copie d’ordres propre et symétrique. Les ordres bracket automatiques (ATM) ne se comportent pas de la même façon dans un groupe ; si votre configuration repose sur des brackets automatiques de stop et d’objectif sur chaque compte, testez-la rigoureusement au préalable.",
      ],
    },
    { type: "heading",text: "Copier un signal sur chaque compte, même entre sociétés" },
