---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "tradovate-nano-event-commissions";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/how-to/${SLUG}`;

const META_TITLE = "Tradovate Nano & Event Contract Commission Rates";
const META_DESCRIPTION =
  "See per-side commissions for Nano and Event futures contracts by plan tier, plus the exchange fees to add for your true round-turn cost.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Tradovate-Provisionen für Nano- und Event-Kontrakte", es: "Comisiones de Tradovate para contratos Nano y Event", fr: "Commissions Tradovate pour les contrats Nano et Event", it: "Commissioni Tradovate per contratti Nano ed Event" },
  dek: { en: "See per-side commissions for Nano and Event futures contracts by plan tier, plus the exchange fees to add for your true round-turn cost.", de: "Sehen Sie die Provisionen pro Seite für Nano- und Event-Futures-Kontrakte je Tarifstufe, plus die Börsengebühren, die Sie für Ihre tatsächlichen Round-Turn-Kosten hinzurechnen müssen.", es: "Consulte las comisiones por lado de los contratos de futuros Nano y Event según el nivel del plan, además de las tarifas de bolsa que debe sumar para obtener su coste real por operación completa.", fr: "Consultez les commissions par côté des contrats à terme Nano et Event selon le niveau d’abonnement, ainsi que les frais de bourse à ajouter pour obtenir votre coût réel d’un aller-retour.", it: "Consulti le commissioni per lato dei contratti futures Nano ed Event in base al livello del piano, oltre alle tariffe di borsa da aggiungere per ottenere il suo costo reale di un round turn." },
  readTime: { en: "5 min read", de: "5 Min. Lesezeit", es: "Lectura de 5 min", fr: "Lecture : 5 min", it: "Lettura di 5 min" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "Nano and Event contracts are the cheapest things you can trade on Tradovate, and their commission is priced as one line item. Whichever membership plan you're on, you pay the same rate for a Nano contract as you do for an Event contract. Here's what each side costs, and how to work out what a full round turn actually runs you once the exchange takes its cut." },
    { type: "heading", text: "Nano & Event Commission by Plan" },
    { type: "paragraph", html: "These are per-side rates, so you pay them once when you open and again when you close. The plan you pick decides the rate, and the pricier the plan up front, the less you pay per contract after that." },
    {
      type: "table",
      headers: ["Plan", "Plan cost", "Nano & Event (per side)"],
      rows: [
        ["Free", "$0 / month", "$0.20"],
        ["Monthly", "$99 / month", "$0.15"],
        ["Lifetime", "$1,499 one-time", "$0.05"],
      ],
    },
    { type: "paragraph", html: "For context, standard futures run $1.29 / $0.99 / $0.59 per side across the same three plans, and micros run $0.39 / $0.29 / $0.09. Nano and Event sit well below both, which is the whole point of these smaller products." },
    { type: "heading", text: "How to Check and Calculate Your Rate" },
    {
      type: "steps",
      items: [
        { title: "Identify Your Membership Plan", html: "Open the Tradovate pricing page and confirm which tier your account is on: <strong class='text-white'>Free</strong>, <strong class='text-white'>Monthly</strong>, or <strong class='text-white'>Lifetime</strong>. If you're not sure, your plan shows up in your Tradovate account settings under the membership or subscription section." },
        { title: "Read the Nano & Event Rate for Your Plan", html: "Find the Nano & Event Contracts line for your tier. It's $0.20 per side on Free, $0.15 on Monthly, and $0.05 on Lifetime. This single rate covers both product types, so you don't need to look up Nano and Event separately." },
        { title: "Add Exchange, Clearing, and NFA Fees", html: "The Tradovate commission isn't the whole cost. Exchange, clearing, and NFA fees apply on top of every side, and they aren't included in the numbers above. These pass-through fees are set by the exchange and regulators, not by Tradovate, so they're the same no matter which plan you're on. Check the current exchange fee schedule for the specific Nano or Event product you trade, since these change from time to time." },
        { title: "Work Out Your Round-Turn Cost", html: "A round turn is one full trade: open plus close, so two sides. Double the per-side total to get it. On the Lifetime plan, that's $0.05 in and $0.05 out, or $0.10 in commission per contract before exchange fees. On Free, the same round turn is $0.40 in commission. Add the pass-through fees from the previous step to land on your real all-in cost." },
      ],
    },
    { type: "heading", text: "Nano vs Event Contracts" },
    { type: "paragraph", html: "They share a commission rate but they aren't the same instrument. Nano contracts are miniature versions of index futures, sized far smaller than even the micros, so a single tick moves your account by a tiny amount. Event contracts are yes-or-no positions on a daily market outcome, where your risk is capped at what you paid to enter and your max profit is shown up front before you commit. Both are worth a look if you want to size down while you learn a strategy, and both bill at the Nano & Event rate on your plan." },
    { type: "heading", text: "Trading These Through a Prop Firm?" },
    { type: "paragraph", html: "If your Tradovate login comes from a funded or evaluation account, the commission you're charged is set by the prop firm's schedule, not the retail pricing above. Firms bundle their own per-side rate, and it varies by firm and account size, so check your firm's current rate sheet rather than assuming the numbers on Tradovate's pricing page. One thing that stays constant either way: you'll still need to subscribe to real-time market data before quotes and fills behave the way you expect." },
    { type: "heading", text: "Automate This with PickMyTrade" },
    { type: "paragraph", html: "Want to run Nano and Event entries straight from your TradingView alerts without babysitting the platform? <strong class='text-white'>PickMyTrade automates your Tradovate trades</strong> and lets your signals place orders for you." },
  ], de: [
    { type: "paragraph",html: "Nano- und Event-Kontrakte sind das Günstigste, was Sie bei Tradovate handeln können, und ihre Provision ist als eine einzige Position ausgewiesen. Welchen Mitgliedschaftstarif Sie auch haben, für einen Nano-Kontrakt zahlen Sie denselben Satz wie für einen Event-Kontrakt. Hier sehen Sie, was jede Seite kostet und wie Sie berechnen, was ein vollständiger Round Turn tatsächlich kostet, sobald die Börse ihren Anteil nimmt." },
    { type: "heading",text: "Nano- & Event-Provision nach Tarif" },
    { type: "paragraph",html: "Dies sind Sätze pro Seite. Sie zahlen sie einmal beim Eröffnen und noch einmal beim Schließen. Der gewählte Tarif bestimmt den Satz, und je teurer der Tarif im Voraus ist, desto weniger zahlen Sie danach pro Kontrakt." },
    { type: "table", headers: ["Tarif","Tarifkosten","Nano & Event (pro Seite)"], rows: [
      ["Free","$0 / Monat","$0.20"],
      ["Monthly","$99 / Monat","$0.15"],
      ["Lifetime","$1,499 einmalig","$0.05"],
    ] },
    { type: "paragraph",html: "Zum Vergleich: Standard-Futures kosten in denselben drei Tarifen $1.29 / $0.99 / $0.59 pro Seite, Micros $0.39 / $0.29 / $0.09. Nano und Event liegen deutlich unter beiden, und genau das ist der Sinn dieser kleineren Produkte." },
    { type: "heading",text: "So prüfen und berechnen Sie Ihren Satz" },
    {
      type: "steps",
      items: [
        { title: "Ermitteln Sie Ihren Mitgliedschaftstarif", html: "Öffnen Sie die Tradovate-Preisseite und bestätigen Sie, in welcher Stufe Ihr Konto ist: <strong class='text-white'>Free</strong>, <strong class='text-white'>Monthly</strong> oder <strong class='text-white'>Lifetime</strong>. Wenn Sie unsicher sind, finden Sie Ihren Tarif in Ihren Tradovate-Kontoeinstellungen im Bereich Mitgliedschaft oder Abonnement." },
        { title: "Lesen Sie den Nano- & Event-Satz für Ihren Tarif ab", html: "Suchen Sie die Zeile Nano & Event Contracts für Ihre Stufe. Sie beträgt $0.20 pro Seite bei Free, $0.15 bei Monthly und $0.05 bei Lifetime. Dieser einheitliche Satz gilt für beide Produkttypen, Sie müssen Nano und Event also nicht getrennt nachschlagen." },
        { title: "Börsen-, Clearing- und NFA-Gebühren hinzurechnen", html: "Die Tradovate-Provision ist nicht die gesamten Kosten. Börsen-, Clearing- und NFA-Gebühren fallen zusätzlich auf jeder Seite an und sind in den obigen Zahlen nicht enthalten. Diese durchgereichten Gebühren werden von der Börse und den Aufsichtsbehörden festgelegt, nicht von Tradovate, und sind daher unabhängig vom Tarif gleich. Prüfen Sie die aktuelle Börsengebührenordnung für das konkrete Nano- oder Event-Produkt, das Sie handeln, da sich diese von Zeit zu Zeit ändert." },
        { title: "Berechnen Sie Ihre Round-Turn-Kosten", html: "Ein Round Turn ist ein vollständiger Trade: Eröffnen plus Schließen, also zwei Seiten. Verdoppeln Sie die Summe pro Seite, um ihn zu erhalten. Im Lifetime-Tarif sind das $0.05 für den Einstieg und $0.05 für den Ausstieg, also $0.10 Provision pro Kontrakt vor den Börsengebühren. Bei Free kostet derselbe Round Turn $0.40 Provision. Addieren Sie die durchgereichten Gebühren aus dem vorherigen Schritt, um Ihre tatsächlichen Gesamtkosten zu erhalten." },
      ],
    },
    { type: "heading",text: "Nano- vs. Event-Kontrakte" },
    { type: "paragraph",html: "Sie teilen sich einen Provisionssatz, sind aber nicht dasselbe Instrument. Nano-Kontrakte sind Miniaturversionen von Index-Futures, weit kleiner dimensioniert als selbst Micros, sodass ein einzelner Tick Ihr Konto nur geringfügig bewegt. Event-Kontrakte sind Ja-oder-Nein-Positionen auf ein tägliches Marktergebnis, bei denen Ihr Risiko auf den Einsatz begrenzt ist und Ihr maximaler Gewinn vor Ihrer Entscheidung vorab angezeigt wird. Beide sind einen Blick wert, wenn Sie die Positionsgröße verkleinern möchten, während Sie eine Strategie erlernen, und beide werden in Ihrem Tarif zum Nano- & Event-Satz abgerechnet." },
    { type: "heading",text: "Handeln Sie diese über eine Prop-Firma?" },
    { type: "paragraph",html: "Wenn Ihr Tradovate-Login von einem finanzierten oder Evaluierungskonto stammt, richtet sich die berechnete Provision nach dem Gebührenplan der Prop-Firma, nicht nach den obigen Retailpreisen. Firmen bündeln ihren eigenen Satz pro Seite, und er variiert je nach Firma und Kontogröße. Prüfen Sie daher das aktuelle Preisblatt Ihrer Firma, statt die Zahlen auf Tradovates Preisseite anzunehmen. Eines bleibt in beiden Fällen konstant: Sie müssen weiterhin Echtzeit-Marktdaten abonnieren, bevor Kurse und Fills sich so verhalten, wie Sie es erwarten." },
    { type: "heading",text: "Automatisieren Sie dies mit PickMyTrade" },
    { type: "paragraph",html: "Möchten Sie Nano- und Event-Einstiege direkt aus Ihren TradingView-Alerts ausführen, ohne die Plattform ständig zu überwachen? <strong class='text-white'>PickMyTrade automatisiert Ihre Tradovate-Trades</strong> und lässt Ihre Signale die Orders für Sie platzieren." },
  ], es: [
    { type: "paragraph",html: "Los contratos Nano y Event son lo más barato que puede operar en Tradovate, y su comisión se fija como una sola partida. Sea cual sea el plan de membresía que tenga, paga la misma tarifa por un contrato Nano que por un contrato Event. Aquí verá lo que cuesta cada lado y cómo calcular lo que realmente le cuesta una operación completa (round turn) una vez que la bolsa se lleva su parte." },
    { type: "heading",text: "Comisión Nano y Event por plan" },
    { type: "paragraph",html: "Son tarifas por lado, así que las paga una vez al abrir y otra al cerrar. El plan que elija determina la tarifa y, cuanto más caro es el plan de entrada, menos paga por contrato después." },
    { type: "table", headers: ["Plan","Coste del plan","Nano y Event (por lado)"], rows: [
      ["Free","$0 / mes","$0.20"],
      ["Monthly","$99 / mes","$0.15"],
      ["Lifetime","$1,499 pago único","$0.05"],
    ] },
    { type: "paragraph",html: "Como referencia, los futuros estándar cuestan $1.29 / $0.99 / $0.59 por lado en los mismos tres planes, y los micros $0.39 / $0.29 / $0.09. Nano y Event quedan muy por debajo de ambos, que es precisamente el objetivo de estos productos más pequeños." },
    { type: "heading",text: "Cómo comprobar y calcular su tarifa" },
    {
      type: "steps",
      items: [
        { title: "Identifique su plan de membresía", html: "Abra la página de precios de Tradovate y confirme en qué nivel está su cuenta: <strong class='text-white'>Free</strong>, <strong class='text-white'>Monthly</strong> o <strong class='text-white'>Lifetime</strong>. Si no está seguro, su plan aparece en los ajustes de su cuenta de Tradovate, en la sección de membresía o suscripción." },
        { title: "Lea la tarifa Nano y Event de su plan", html: "Busque la línea Nano & Event Contracts de su nivel. Es $0.20 por lado en Free, $0.15 en Monthly y $0.05 en Lifetime. Esta tarifa única cubre ambos tipos de producto, así que no necesita consultar Nano y Event por separado." },
        { title: "Sume tarifas de bolsa, compensación y NFA", html: "La comisión de Tradovate no es el coste total. Las tarifas de bolsa, de compensación y de la NFA se aplican además en cada lado y no están incluidas en las cifras anteriores. Estas tarifas repercutidas las fijan la bolsa y los reguladores, no Tradovate, por lo que son las mismas sea cual sea su plan. Consulte la tabla de tarifas de bolsa vigente del producto Nano o Event concreto que opera, ya que cambian de vez en cuando." },
        { title: "Calcule su coste por operación completa", html: "Un round turn es una operación completa: abrir más cerrar, es decir, dos lados. Duplique el total por lado para obtenerlo. En el plan Lifetime son $0.05 de entrada y $0.05 de salida, o $0.10 de comisión por contrato antes de las tarifas de bolsa. En Free, el mismo round turn son $0.40 de comisión. Sume las tarifas repercutidas del paso anterior para llegar a su coste total real." },
      ],
    },
    { type: "heading",text: "Contratos Nano frente a Event" },
    { type: "paragraph",html: "Comparten la tarifa de comisión, pero no son el mismo instrumento. Los contratos Nano son versiones en miniatura de futuros de índices, de un tamaño mucho menor incluso que los micros, así que un solo tick mueve su cuenta una cantidad mínima. Los contratos Event son posiciones de sí o no sobre un resultado diario del mercado, donde su riesgo queda limitado a lo que pagó por entrar y su ganancia máxima se muestra de antemano antes de comprometerse. Ambos merecen una mirada si quiere reducir el tamaño mientras aprende una estrategia, y ambos se facturan a la tarifa Nano y Event de su plan." },
    { type: "heading",text: "¿Los opera a través de una prop firm?" },
    { type: "paragraph",html: "Si su inicio de sesión de Tradovate procede de una cuenta financiada o de evaluación, la comisión que se le cobra la fija la tabla de la prop firm, no los precios minoristas anteriores. Las firmas incluyen su propia tarifa por lado, y varía según la firma y el tamaño de la cuenta, así que consulte la hoja de tarifas vigente de su firma en lugar de suponer las cifras de la página de precios de Tradovate. Algo que no cambia en ningún caso: seguirá necesitando suscribirse a datos de mercado en tiempo real para que las cotizaciones y las ejecuciones se comporten como espera." },
    { type: "heading",text: "Automatice esto con PickMyTrade" },
    { type: "paragraph",html: "¿Quiere ejecutar entradas Nano y Event directamente desde sus alertas de TradingView sin vigilar la plataforma? <strong class='text-white'>PickMyTrade automatiza sus operaciones en Tradovate</strong> y deja que sus señales coloquen las órdenes por usted." },
  ], fr: [
    { type: "paragraph",html: "Les contrats Nano et Event sont les produits les moins chers que vous pouvez trader sur Tradovate, et leur commission est présentée comme une seule ligne. Quel que soit votre abonnement, vous payez le même tarif pour un contrat Nano que pour un contrat Event. Voici ce que coûte chaque côté, et comment calculer ce que vous coûte réellement un aller-retour complet une fois que la bourse a prélevé sa part." },
    { type: "heading",text: "Commission Nano et Event par abonnement" },
    { type: "paragraph",html: "Ce sont des tarifs par côté : vous les payez une fois à l’ouverture et une autre à la clôture. L’abonnement choisi détermine le tarif, et plus l’abonnement est cher au départ, moins vous payez ensuite par contrat." },
    { type: "table", headers: ["Abonnement","Coût de l’abonnement","Nano et Event (par côté)"], rows: [
      ["Free","$0 / mois","$0.20"],
      ["Monthly","$99 / mois","$0.15"],
      ["Lifetime","$1,499 paiement unique","$0.05"],
    ] },
    { type: "paragraph",html: "À titre de comparaison, les futures standard coûtent $1.29 / $0.99 / $0.59 par côté sur les trois mêmes abonnements, et les micros $0.39 / $0.29 / $0.09. Nano et Event se situent bien en dessous des deux, ce qui est tout l’intérêt de ces produits plus petits." },
    { type: "heading",text: "Comment vérifier et calculer votre tarif" },
    {
      type: "steps",
      items: [
        { title: "Identifiez votre abonnement", html: "Ouvrez la page tarifaire de Tradovate et confirmez le niveau de votre compte : <strong class='text-white'>Free</strong>, <strong class='text-white'>Monthly</strong> ou <strong class='text-white'>Lifetime</strong>. En cas de doute, votre abonnement figure dans les paramètres de votre compte Tradovate, dans la section adhésion ou abonnement." },
        { title: "Lisez le tarif Nano et Event de votre abonnement", html: "Repérez la ligne Nano & Event Contracts de votre niveau. Elle est de $0.20 par côté en Free, $0.15 en Monthly et $0.05 en Lifetime. Ce tarif unique couvre les deux types de produits, vous n’avez donc pas à consulter Nano et Event séparément." },
        { title: "Ajoutez les frais de bourse, de compensation et de la NFA", html: "La commission Tradovate n’est pas le coût total. Les frais de bourse, de compensation et de la NFA s’appliquent en plus sur chaque côté et ne sont pas inclus dans les chiffres ci-dessus. Ces frais répercutés sont fixés par la bourse et les régulateurs, pas par Tradovate, et sont donc identiques quel que soit votre abonnement. Consultez le barème de frais de bourse en vigueur pour le produit Nano ou Event que vous tradez, car ils changent de temps à autre." },
        { title: "Calculez votre coût d’un aller-retour", html: "Un aller-retour est un trade complet : ouverture plus clôture, soit deux côtés. Doublez le total par côté pour l’obtenir. Avec l’abonnement Lifetime, cela donne $0.05 à l’entrée et $0.05 à la sortie, soit $0.10 de commission par contrat avant les frais de bourse. En Free, le même aller-retour coûte $0.40 de commission. Ajoutez les frais répercutés de l’étape précédente pour obtenir votre coût réel tout compris." },
      ],
    },
    { type: "heading",text: "Contrats Nano contre Event" },
    { type: "paragraph",html: "Ils partagent un tarif de commission, mais ce ne sont pas le même instrument. Les contrats Nano sont des versions miniatures de futures sur indices, de taille bien inférieure même aux micros, si bien qu’un seul tick ne fait bouger votre compte que très peu. Les contrats Event sont des positions oui ou non sur un résultat quotidien du marché, où votre risque est plafonné à ce que vous avez payé pour entrer et où votre gain maximal est affiché à l’avance avant de vous engager. Les deux méritent un coup d’œil si vous voulez réduire votre taille pendant que vous apprenez une stratégie, et les deux sont facturés au tarif Nano et Event de votre abonnement." },
    { type: "heading",text: "Vous les tradez via une prop firm ?" },
    { type: "paragraph",html: "Si votre connexion Tradovate provient d’un compte financé ou d’évaluation, la commission facturée est fixée par le barème de la prop firm, et non par les tarifs retail ci-dessus. Les sociétés intègrent leur propre tarif par côté, qui varie selon la société et la taille du compte ; consultez donc la grille tarifaire en vigueur de votre société plutôt que de supposer les chiffres de la page tarifaire de Tradovate. Une chose reste constante dans les deux cas : vous devrez toujours vous abonner aux données de marché en temps réel pour que les cotations et les exécutions se comportent comme prévu." },
    { type: "heading",text: "Automatisez cela avec PickMyTrade" },
    { type: "paragraph",html: "Vous voulez exécuter vos entrées Nano et Event directement depuis vos alertes TradingView sans surveiller la plateforme ? <strong class='text-white'>PickMyTrade automatise vos trades Tradovate</strong> et laisse vos signaux passer les ordres à votre place." },
  ], it: [
    { type: "paragraph",html: "I contratti Nano ed Event sono i prodotti più economici che può operare su Tradovate, e la loro commissione è prezzata come un’unica voce. Qualunque sia il piano di abbonamento, paga la stessa tariffa per un contratto Nano e per un contratto Event. Ecco quanto costa ciascun lato e come calcolare quanto le costa realmente un round turn completo una volta che la borsa ha preso la sua parte." },
    { type: "heading",text: "Commissione Nano ed Event per piano" },
    { type: "paragraph",html: "Queste sono tariffe per lato, quindi le paga una volta all’apertura e un’altra alla chiusura. Il piano scelto determina la tariffa e, più il piano è costoso all’inizio, meno paga per contratto dopo." },
    { type: "table", headers: ["Piano","Costo del piano","Nano ed Event (per lato)"], rows: [
      ["Free","$0 / mese","$0.20"],
      ["Monthly","$99 / mese","$0.15"],
      ["Lifetime","$1,499 una tantum","$0.05"],
    ] },
    { type: "paragraph",html: "Per contesto, i futures standard costano $1.29 / $0.99 / $0.59 per lato sugli stessi tre piani, e i micro $0.39 / $0.29 / $0.09. Nano ed Event si collocano ben al di sotto di entrambi, ed è proprio questo lo scopo di questi prodotti più piccoli." },
    { type: "heading",text: "Come verificare e calcolare la sua tariffa" },
    {
      type: "steps",
      items: [
        { title: "Identifichi il suo piano di abbonamento", html: "Apra la pagina dei prezzi di Tradovate e confermi a quale livello appartiene il suo conto: <strong class='text-white'>Free</strong>, <strong class='text-white'>Monthly</strong> o <strong class='text-white'>Lifetime</strong>. Se non ne è sicuro, il suo piano compare nelle impostazioni del conto Tradovate, nella sezione abbonamento o iscrizione." },
        { title: "Legga la tariffa Nano ed Event del suo piano", html: "Trovi la riga Nano & Event Contracts per il suo livello. È $0.20 per lato su Free, $0.15 su Monthly e $0.05 su Lifetime. Questa tariffa unica copre entrambi i tipi di prodotto, quindi non deve cercare Nano ed Event separatamente." },
        { title: "Aggiunga le tariffe di borsa, di clearing e della NFA", html: "La commissione Tradovate non è il costo totale. Le tariffe di borsa, di clearing e della NFA si applicano in aggiunta su ogni lato e non sono incluse nelle cifre sopra. Queste tariffe pass-through sono stabilite dalla borsa e dalle autorità di regolamentazione, non da Tradovate, quindi sono uguali a prescindere dal piano. Controlli il tariffario di borsa attuale per lo specifico prodotto Nano o Event che opera, poiché cambia di tanto in tanto." },
        { title: "Calcoli il costo del suo round turn", html: "Un round turn è un trade completo: apertura più chiusura, quindi due lati. Raddoppi il totale per lato per ottenerlo. Sul piano Lifetime sono $0.05 in entrata e $0.05 in uscita, ovvero $0.10 di commissione per contratto prima delle tariffe di borsa. Su Free, lo stesso round turn costa $0.40 di commissione. Aggiunga le tariffe pass-through del passaggio precedente per arrivare al suo costo reale complessivo." },
      ],
    },
    { type: "heading",text: "Contratti Nano contro Event" },
    { type: "paragraph",html: "Condividono la tariffa di commissione ma non sono lo stesso strumento. I contratti Nano sono versioni in miniatura dei futures sugli indici, di dimensioni molto inferiori persino ai micro, quindi un singolo tick sposta il suo conto di una cifra minima. I contratti Event sono posizioni sì o no su un esito giornaliero del mercato, in cui il suo rischio è limitato a quanto ha pagato per entrare e il guadagno massimo viene mostrato in anticipo prima di impegnarsi. Entrambi meritano un’occhiata se vuole ridurre la size mentre impara una strategia, ed entrambi vengono addebitati alla tariffa Nano ed Event del suo piano." },
    { type: "heading",text: "Li opera tramite una prop firm?" },
    { type: "paragraph",html: "Se il suo login Tradovate proviene da un conto finanziato o di valutazione, la commissione che le viene addebitata è stabilita dal tariffario della prop firm, non dai prezzi retail sopra indicati. Le società includono una propria tariffa per lato, che varia in base alla società e alla dimensione del conto, quindi controlli il listino attuale della sua società anziché dare per scontate le cifre della pagina dei prezzi di Tradovate. Una cosa resta costante in ogni caso: dovrà comunque abbonarsi ai dati di mercato in tempo reale perché quotazioni ed esecuzioni si comportino come si aspetta." },
    { type: "heading",text: "Automatizzi tutto questo con PickMyTrade" },
    { type: "paragraph",html: "Vuole eseguire ingressi Nano ed Event direttamente dai suoi alert di TradingView senza controllare la piattaforma? <strong class='text-white'>PickMyTrade automatizza i suoi trade su Tradovate</strong> e lascia che siano i suoi segnali a piazzare gli ordini per lei." },
  ] },
