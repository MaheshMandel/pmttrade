---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "tradovate-notification-settings";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/how-to/${SLUG}`;

const META_TITLE = "Find Notification Settings in Tradovate Web";
const META_DESCRIPTION =
  "Find your notification settings, toggle order alerts, and use Advanced Configuration to control push and audio alerts by status type.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Benachrichtigungseinstellungen in Tradovate Web finden", es: "Cómo encontrar los ajustes de notificaciones en Tradovate Web", fr: "Trouver les paramètres de notification dans Tradovate Web", it: "Trovare le impostazioni di notifica in Tradovate Web" },
  dek: { en: "Find your notification settings, toggle order alerts, and use Advanced Configuration to control push and audio alerts by status type.", de: "Finden Sie Ihre Benachrichtigungseinstellungen, schalten Sie Order-Alerts um und steuern Sie über Advanced Configuration Push- und Audio-Alerts nach Statustyp.", es: "Encuentre sus ajustes de notificaciones, active o desactive las alertas de órdenes y use Advanced Configuration para controlar las alertas push y de audio según el tipo de estado.", fr: "Trouvez vos paramètres de notification, activez ou désactivez les alertes d'ordres et utilisez Advanced Configuration pour contrôler les alertes push et audio par type de statut.", it: "Trovi le Sue impostazioni di notifica, attivi o disattivi gli alert degli ordini e utilizzi Advanced Configuration per controllare gli alert push e audio in base al tipo di stato." },
  readTime: { en: "5 min read", de: "5 Min. Lesezeit", es: "Lectura de 5 min", fr: "Lecture : 5 min", it: "Lettura di 5 min" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "If the constant chime after every fill is driving you up the wall, or you want a quiet ping only when a stop gets hit, the controls you need aren't buried in some separate menu. They sit inside Application Settings, and once you know the path you can reshape every alert in under a minute. Here's exactly where to look and what each switch does." },
    { type: "heading", text: "What You Can Control" },
    { type: "paragraph", html: "Tradovate's notification controls cover more than a simple on/off. From one screen you can decide whether order alerts show up at all, thin them down to the specific statuses you care about, turn on push alerts, and pick a sound for each event from a library of more than fifteen. You can also hide the ticker panel entirely if you'd rather not see the running feed at the top of the screen." },
    { type: "heading", text: "Where the Settings Live" },
    { type: "paragraph", html: "Everything below happens in the browser (web) version of the platform. The desktop app follows the same idea, though a label or two can sit in a slightly different spot." },
    {
      type: "steps",
      items: [
        { title: "Open Application Settings", html: "Look at the top-right corner of the Tradovate window and click the <strong class='text-white'>Application Settings</strong> button. It's the gear-style control that holds the platform-wide preferences, not the settings for any single chart or DOM.", image: { src: `${IMG}/tradovate-notification-settings-1.png`, alt: "Application Settings button highlighted in the top-right corner of Tradovate Web" } },
        { title: "Open the Preferences Tab", html: "Inside Application Settings, click the <strong class='text-white'>Preferences</strong> tab across the top. This is where the layout, behavior, and notification options for the whole platform live.", image: { src: `${IMG}/tradovate-notification-settings-2.png`, alt: "Preferences tab selected inside the Tradovate Web Application Settings window" } },
        { title: "Find the Notifications Section", html: "Scroll down the Preferences page until you reach the <strong class='text-white'>Notifications</strong> section. Two switches do the heavy lifting here: <strong class='text-white'>Order Notifications</strong> turns the order status alerts on or off, and the <strong class='text-white'>Notification Ticker</strong> toggle removes the whole panel at the top that shows the clock and the running notification feed. Flip Order Notifications off and the pop-ups stop; flip the ticker off and the panel disappears.", image: { src: `${IMG}/tradovate-notification-settings-3.png`, alt: "Notifications section of the Tradovate Web Preferences page with Order Notifications and Notification Ticker toggles" } },
        { title: "Open Advanced Configuration for Per-Status Control", html: "Most people don't want to mute everything. Click the optional <strong class='text-white'>Advanced Configuration</strong> button and you can switch alerts on or off for each order status on its own. Keep the alert for a rejected or cancelled order, for instance, and quiet the one that fires on every routine fill. This is the setting to reach for when the \"order filled\" ping is the real problem, not notifications as a whole.", image: { src: `${IMG}/tradovate-notification-settings-4.png`, alt: "Advanced Configuration panel showing individual order status notification toggles in Tradovate Web" } },
        { title: "Set Push and Audio Notifications", html: "The same area lets you toggle <strong class='text-white'>push notifications</strong> and manage sound. For audio, you can turn a sound on, play it as a test, and swap it for a different one from the built-in library of more than fifteen files. Set a sharp tone for a stop-out and a softer one for a working order if you want to tell events apart without looking at the screen.", image: { src: `${IMG}/tradovate-notification-settings-5.png`, alt: "Push and audio notification controls with sound options for each order status in Tradovate Web" } },
      ],
    },
    {
      type: "table",
      headers: ["Control", "What it does"],
      rows: [
        ["Order Notifications", "Master switch for all order status alerts"],
        ["Notification Ticker", "Hides or shows the top panel with the clock and alert feed"],
        ["Advanced Configuration", "Turns each order status alert on or off individually"],
        ["Push notifications", "Sends alerts beyond the active window"],
        ["Audio notifications", "On/off, test, and a choice of 15+ sounds per status"],
      ],
    },
    { type: "heading", text: "A Few Things Worth Knowing" },
    { type: "paragraph", html: "On the web version there's no volume slider inside Tradovate itself, so if a sound is too loud, change it for a quieter file or adjust your system volume. The desktop app does let you set the app's level in Windows sound settings. Labels can shift as the platform updates, so if a name here doesn't match what's on your screen, look for the closest equivalent in the same Notifications area before assuming it moved." },
    { type: "paragraph", html: "These order alerts are separate from price and market events. If you're trying to get pinged when a contract reaches a level rather than when an order changes state, that's a separate price-alert setting. And if you're mainly on your phone, the mobile app handles its alerts on its own screen." },
    { type: "heading", text: "Automate This with PickMyTrade" },
    { type: "paragraph", html: "Tired of babysitting fills and manually reacting to every alert? <strong class='text-white'>PickMyTrade automates your Tradovate order execution</strong> and lets your strategy run the trades for you." },
  ], de: [
    { type: "paragraph",html: "Wenn Sie der ständige Signalton nach jeder Ausführung nervt oder Sie nur dann einen leisen Hinweis möchten, wenn ein Stop ausgelöst wird, dann sind die nötigen Einstellungen nicht in einem separaten Menü versteckt. Sie befinden sich in den Application Settings, und sobald Sie den Weg kennen, können Sie jeden Alert in weniger als einer Minute anpassen. Hier sehen Sie genau, wo Sie suchen müssen und was jeder Schalter bewirkt." },
    { type: "heading",text: "Was Sie steuern können" },
    { type: "paragraph",html: "Die Benachrichtigungssteuerungen von Tradovate bieten mehr als ein einfaches Ein/Aus. Auf einem Bildschirm entscheiden Sie, ob Order-Alerts überhaupt erscheinen, reduzieren sie auf die Status, die Ihnen wichtig sind, aktivieren Push-Alerts und wählen für jedes Ereignis einen Sound aus einer Bibliothek mit mehr als fünfzehn Optionen. Außerdem können Sie das Ticker-Panel komplett ausblenden, wenn Sie den laufenden Feed am oberen Bildschirmrand nicht sehen möchten." },
    { type: "heading",text: "Wo sich die Einstellungen befinden" },
    { type: "paragraph",html: "Alles Folgende geschieht in der Browser-Version (Web) der Plattform. Die Desktop-App folgt demselben Prinzip, wobei die eine oder andere Bezeichnung an einer etwas anderen Stelle stehen kann." },
    {
      type: "steps",
      items: [
        { title: "Application Settings öffnen", html: "Blicken Sie auf die obere rechte Ecke des Tradovate-Fensters und klicken Sie auf die Schaltfläche <strong class='text-white'>Application Settings</strong>. Es ist das zahnradartige Steuerelement, das die plattformweiten Einstellungen enthält, nicht die Einstellungen eines einzelnen Charts oder DOMs.", image: {"src":`${IMG}/tradovate-notification-settings-1.png`,"alt":"Hervorgehobene Schaltfläche Application Settings in der oberen rechten Ecke von Tradovate Web"} },
        { title: "Tab Preferences öffnen", html: "Klicken Sie in den Application Settings oben auf den Tab <strong class='text-white'>Preferences</strong>. Hier finden Sie die Optionen für Layout, Verhalten und Benachrichtigungen der gesamten Plattform.", image: {"src":`${IMG}/tradovate-notification-settings-2.png`,"alt":"Ausgewählter Tab Preferences im Fenster Application Settings von Tradovate Web"} },
        { title: "Abschnitt Notifications finden", html: "Scrollen Sie auf der Seite Preferences nach unten, bis Sie den Abschnitt <strong class='text-white'>Notifications</strong> erreichen. Zwei Schalter leisten hier die Hauptarbeit: <strong class='text-white'>Order Notifications</strong> schaltet die Order-Status-Alerts ein oder aus, und der Schalter <strong class='text-white'>Notification Ticker</strong> entfernt das gesamte Panel oben, das die Uhr und den laufenden Benachrichtigungs-Feed zeigt. Schalten Sie Order Notifications aus, und die Pop-ups verschwinden; schalten Sie den Ticker aus, und das Panel verschwindet.", image: {"src":`${IMG}/tradovate-notification-settings-3.png`,"alt":"Abschnitt Notifications der Preferences-Seite von Tradovate Web mit den Schaltern Order Notifications und Notification Ticker"} },
        { title: "Advanced Configuration für Steuerung pro Status öffnen", html: "Die meisten möchten nicht alles stummschalten. Klicken Sie auf die optionale Schaltfläche <strong class='text-white'>Advanced Configuration</strong>, und Sie können Alerts für jeden Order-Status einzeln ein- oder ausschalten. Behalten Sie zum Beispiel den Alert für eine abgelehnte oder stornierte Order bei und schalten Sie den Alert für jede routinemäßige Ausführung leise. Dies ist die Einstellung der Wahl, wenn der „Order filled“-Ping das eigentliche Problem ist und nicht die Benachrichtigungen insgesamt.", image: {"src":`${IMG}/tradovate-notification-settings-4.png`,"alt":"Fenster Advanced Configuration mit einzelnen Schaltern für Order-Status-Benachrichtigungen in Tradovate Web"} },
        { title: "Push- und Audio-Benachrichtigungen festlegen", html: "Im selben Bereich können Sie <strong class='text-white'>Push-Benachrichtigungen</strong> umschalten und den Sound verwalten. Beim Audio können Sie einen Sound aktivieren, zum Test abspielen und gegen einen anderen aus der integrierten Bibliothek mit mehr als fünfzehn Dateien austauschen. Legen Sie einen scharfen Ton für einen Stop-out und einen sanfteren für eine aktive Order fest, wenn Sie Ereignisse unterscheiden möchten, ohne auf den Bildschirm zu blicken.", image: {"src":`${IMG}/tradovate-notification-settings-5.png`,"alt":"Steuerelemente für Push- und Audio-Benachrichtigungen mit Soundoptionen für jeden Order-Status in Tradovate Web"} },
      ],
    },
    { type: "table", headers: ["Steuerelement","Was es bewirkt"], rows: [
      ["Order Notifications","Hauptschalter für alle Order-Status-Alerts"],
      ["Notification Ticker","Blendet das obere Panel mit Uhr und Alert-Feed aus oder ein"],
      ["Advanced Configuration","Schaltet jeden Order-Status-Alert einzeln ein oder aus"],
      ["Push-Benachrichtigungen","Sendet Alerts auch außerhalb des aktiven Fensters"],
      ["Audio-Benachrichtigungen","Ein/Aus, Test und Auswahl aus über 15 Sounds pro Status"],
    ] },
    { type: "heading",text: "Ein paar Dinge, die Sie wissen sollten" },
    { type: "paragraph",html: "In der Web-Version gibt es innerhalb von Tradovate keinen Lautstärkeregler. Ist ein Sound zu laut, wählen Sie daher eine leisere Datei oder passen Sie die Systemlautstärke an. Die Desktop-App erlaubt es, die Lautstärke der App in den Windows-Soundeinstellungen festzulegen. Bezeichnungen können sich mit Plattform-Updates ändern. Wenn ein Name hier nicht mit Ihrem Bildschirm übereinstimmt, suchen Sie im selben Bereich Notifications nach der nächstliegenden Entsprechung, bevor Sie annehmen, dass er verschoben wurde." },
    { type: "paragraph",html: "Diese Order-Alerts sind von Preis- und Marktereignissen getrennt. Wenn Sie benachrichtigt werden möchten, sobald ein Kontrakt ein Niveau erreicht, und nicht, wenn eine Order ihren Status ändert, ist das eine separate Einstellung für Preis-Alerts. Und wenn Sie hauptsächlich mit dem Smartphone arbeiten, verwaltet die mobile App ihre Alerts auf einem eigenen Bildschirm." },
    { type: "heading",text: "Mit PickMyTrade automatisieren" },
    { type: "paragraph",html: "Haben Sie es satt, Ausführungen zu beobachten und manuell auf jeden Alert zu reagieren? <strong class='text-white'>PickMyTrade automatisiert Ihre Tradovate-Orderausführung</strong> und lässt Ihre Strategie die Trades für Sie ausführen." },
  ], es: [
    { type: "paragraph",html: "Si el pitido constante después de cada ejecución le está sacando de quicio, o desea un aviso discreto solo cuando se active un stop, los controles que necesita no están enterrados en un menú aparte. Están dentro de Application Settings y, una vez que conozca la ruta, podrá remodelar cada alerta en menos de un minuto. Aquí le mostramos exactamente dónde buscar y qué hace cada interruptor." },
    { type: "heading",text: "Qué puede controlar" },
    { type: "paragraph",html: "Los controles de notificaciones de Tradovate abarcan más que un simple encendido y apagado. Desde una sola pantalla puede decidir si las alertas de órdenes aparecen o no, reducirlas a los estados que le interesan, activar las alertas push y elegir un sonido para cada evento entre una biblioteca de más de quince. También puede ocultar por completo el panel del ticker si prefiere no ver el feed continuo en la parte superior de la pantalla." },
    { type: "heading",text: "Dónde están los ajustes" },
    { type: "paragraph",html: "Todo lo que sigue ocurre en la versión de navegador (web) de la plataforma. La aplicación de escritorio sigue la misma idea, aunque alguna etiqueta puede estar en un lugar ligeramente distinto." },
    {
      type: "steps",
      items: [
        { title: "Abra Application Settings", html: "Mire la esquina superior derecha de la ventana de Tradovate y haga clic en el botón <strong class='text-white'>Application Settings</strong>. Es el control con forma de engranaje que contiene las preferencias de toda la plataforma, no los ajustes de un gráfico o DOM concreto.", image: {"src":`${IMG}/tradovate-notification-settings-1.png`,"alt":"Botón Application Settings resaltado en la esquina superior derecha de Tradovate Web"} },
        { title: "Abra la pestaña Preferences", html: "Dentro de Application Settings, haga clic en la pestaña <strong class='text-white'>Preferences</strong> de la parte superior. Aquí se encuentran las opciones de diseño, comportamiento y notificaciones de toda la plataforma.", image: {"src":`${IMG}/tradovate-notification-settings-2.png`,"alt":"Pestaña Preferences seleccionada dentro de la ventana Application Settings de Tradovate Web"} },
        { title: "Busque la sección Notifications", html: "Desplácese hacia abajo por la página Preferences hasta llegar a la sección <strong class='text-white'>Notifications</strong>. Dos interruptores hacen el trabajo principal: <strong class='text-white'>Order Notifications</strong> activa o desactiva las alertas de estado de órdenes, y el interruptor <strong class='text-white'>Notification Ticker</strong> elimina todo el panel superior que muestra el reloj y el feed continuo de notificaciones. Desactive Order Notifications y las ventanas emergentes se detienen; desactive el ticker y el panel desaparece.", image: {"src":`${IMG}/tradovate-notification-settings-3.png`,"alt":"Sección Notifications de la página Preferences de Tradovate Web con los interruptores Order Notifications y Notification Ticker"} },
        { title: "Abra Advanced Configuration para el control por estado", html: "La mayoría de la gente no quiere silenciarlo todo. Haga clic en el botón opcional <strong class='text-white'>Advanced Configuration</strong> y podrá activar o desactivar las alertas para cada estado de orden por separado. Conserve, por ejemplo, la alerta de una orden rechazada o cancelada y silencie la que se dispara con cada ejecución rutinaria. Es el ajuste al que recurrir cuando el aviso de «order filled» es el verdadero problema, y no las notificaciones en general.", image: {"src":`${IMG}/tradovate-notification-settings-4.png`,"alt":"Panel Advanced Configuration con interruptores individuales de notificación por estado de orden en Tradovate Web"} },
        { title: "Configure las notificaciones push y de audio", html: "La misma área le permite activar o desactivar las <strong class='text-white'>notificaciones push</strong> y gestionar el sonido. Para el audio, puede activar un sonido, reproducirlo como prueba y cambiarlo por otro de la biblioteca integrada de más de quince archivos. Asigne un tono agudo para un stop-out y uno más suave para una orden activa si desea distinguir los eventos sin mirar la pantalla.", image: {"src":`${IMG}/tradovate-notification-settings-5.png`,"alt":"Controles de notificaciones push y de audio con opciones de sonido para cada estado de orden en Tradovate Web"} },
      ],
    },
    { type: "table", headers: ["Control","Qué hace"], rows: [
      ["Order Notifications","Interruptor principal de todas las alertas de estado de órdenes"],
      ["Notification Ticker","Oculta o muestra el panel superior con el reloj y el feed de alertas"],
      ["Advanced Configuration","Activa o desactiva cada alerta de estado de orden individualmente"],
      ["Notificaciones push","Envía alertas más allá de la ventana activa"],
      ["Notificaciones de audio","Activar/desactivar, probar y elegir entre más de 15 sonidos por estado"],
    ] },
    { type: "heading",text: "Algunas cosas que conviene saber" },
    { type: "paragraph",html: "En la versión web no hay un control de volumen dentro de Tradovate, así que si un sonido es demasiado fuerte, cámbielo por un archivo más suave o ajuste el volumen del sistema. La aplicación de escritorio sí permite fijar el nivel de la aplicación en los ajustes de sonido de Windows. Las etiquetas pueden cambiar con las actualizaciones de la plataforma; si un nombre de aquí no coincide con lo que ve en pantalla, busque el equivalente más cercano en la misma área Notifications antes de suponer que se ha movido." },
    { type: "paragraph",html: "Estas alertas de órdenes son independientes de los eventos de precio y de mercado. Si lo que busca es recibir un aviso cuando un contrato alcanza un nivel, y no cuando una orden cambia de estado, eso corresponde a un ajuste de alertas de precio distinto. Y si usa sobre todo el teléfono, la aplicación móvil gestiona sus alertas en su propia pantalla." },
    { type: "heading",text: "Automatice esto con PickMyTrade" },
    { type: "paragraph",html: "¿Cansado de vigilar las ejecuciones y de reaccionar manualmente a cada alerta? <strong class='text-white'>PickMyTrade automatiza la ejecución de sus órdenes en Tradovate</strong> y deja que su estrategia ejecute las operaciones por usted." },
  ], fr: [
    { type: "paragraph",html: "Si le signal sonore incessant après chaque exécution vous exaspère, ou si vous voulez un discret ping uniquement lorsqu'un stop est touché, les commandes dont vous avez besoin ne sont pas cachées dans un menu séparé. Elles se trouvent dans Application Settings et, une fois le chemin connu, vous pouvez remodeler chaque alerte en moins d'une minute. Voici exactement où chercher et ce que fait chaque interrupteur." },
    { type: "heading",text: "Ce que vous pouvez contrôler" },
    { type: "paragraph",html: "Les commandes de notification de Tradovate vont bien au-delà d'un simple marche/arrêt. Depuis un seul écran, vous décidez si les alertes d'ordres s'affichent ou non, vous les réduisez aux statuts qui vous intéressent, vous activez les alertes push et vous choisissez un son pour chaque événement parmi une bibliothèque de plus de quinze. Vous pouvez aussi masquer entièrement le panneau du ticker si vous préférez ne pas voir le flux continu en haut de l'écran." },
    { type: "heading",text: "Où se trouvent les paramètres" },
    { type: "paragraph",html: "Tout ce qui suit se passe dans la version navigateur (web) de la plateforme. L'application de bureau suit le même principe, même si un libellé ou deux peuvent se situer à un endroit légèrement différent." },
    {
      type: "steps",
      items: [
        { title: "Ouvrir Application Settings", html: "Regardez le coin supérieur droit de la fenêtre Tradovate et cliquez sur le bouton <strong class='text-white'>Application Settings</strong>. C'est la commande en forme d'engrenage qui regroupe les préférences de l'ensemble de la plateforme, et non les paramètres d'un graphique ou d'un DOM en particulier.", image: {"src":`${IMG}/tradovate-notification-settings-1.png`,"alt":"Bouton Application Settings mis en évidence dans le coin supérieur droit de Tradovate Web"} },
        { title: "Ouvrir l'onglet Preferences", html: "Dans Application Settings, cliquez sur l'onglet <strong class='text-white'>Preferences</strong> en haut. C'est ici que se trouvent les options de disposition, de comportement et de notification de toute la plateforme.", image: {"src":`${IMG}/tradovate-notification-settings-2.png`,"alt":"Onglet Preferences sélectionné dans la fenêtre Application Settings de Tradovate Web"} },
        { title: "Trouver la section Notifications", html: "Faites défiler la page Preferences jusqu'à la section <strong class='text-white'>Notifications</strong>. Deux interrupteurs font l'essentiel du travail : <strong class='text-white'>Order Notifications</strong> active ou désactive les alertes de statut d'ordre, et l'interrupteur <strong class='text-white'>Notification Ticker</strong> supprime tout le panneau supérieur qui affiche l'horloge et le flux continu de notifications. Désactivez Order Notifications et les fenêtres contextuelles cessent ; désactivez le ticker et le panneau disparaît.", image: {"src":`${IMG}/tradovate-notification-settings-3.png`,"alt":"Section Notifications de la page Preferences de Tradovate Web avec les interrupteurs Order Notifications et Notification Ticker"} },
        { title: "Ouvrir Advanced Configuration pour un contrôle par statut", html: "La plupart des gens ne veulent pas tout couper. Cliquez sur le bouton facultatif <strong class='text-white'>Advanced Configuration</strong> et vous pouvez activer ou désactiver les alertes pour chaque statut d'ordre séparément. Conservez par exemple l'alerte d'un ordre rejeté ou annulé, et faites taire celle qui se déclenche à chaque exécution de routine. C'est le réglage à utiliser lorsque le ping « order filled » est le vrai problème, et non les notifications en général.", image: {"src":`${IMG}/tradovate-notification-settings-4.png`,"alt":"Panneau Advanced Configuration montrant les interrupteurs de notification par statut d'ordre dans Tradovate Web"} },
        { title: "Définir les notifications push et audio", html: "Cette même zone vous permet d'activer ou de désactiver les <strong class='text-white'>notifications push</strong> et de gérer le son. Pour l'audio, vous pouvez activer un son, le jouer à titre d'essai et le remplacer par un autre de la bibliothèque intégrée de plus de quinze fichiers. Choisissez une tonalité vive pour un stop-out et une plus douce pour un ordre en attente si vous souhaitez distinguer les événements sans regarder l'écran.", image: {"src":`${IMG}/tradovate-notification-settings-5.png`,"alt":"Commandes de notifications push et audio avec options de son pour chaque statut d'ordre dans Tradovate Web"} },
      ],
    },
    { type: "table", headers: ["Commande","Fonction"], rows: [
      ["Order Notifications","Interrupteur principal de toutes les alertes de statut d'ordre"],
      ["Notification Ticker","Masque ou affiche le panneau supérieur avec l'horloge et le flux d'alertes"],
      ["Advanced Configuration","Active ou désactive chaque alerte de statut d'ordre individuellement"],
      ["Notifications push","Envoie des alertes au-delà de la fenêtre active"],
      ["Notifications audio","Activation/désactivation, test et choix parmi plus de 15 sons par statut"],
    ] },
    { type: "heading",text: "Quelques points utiles à savoir" },
    { type: "paragraph",html: "Dans la version web, il n'existe pas de curseur de volume dans Tradovate lui-même ; si un son est trop fort, remplacez-le par un fichier plus doux ou ajustez le volume de votre système. L'application de bureau permet de régler le niveau de l'application dans les paramètres de son de Windows. Les libellés peuvent changer au fil des mises à jour de la plateforme ; si un nom ne correspond pas à ce que vous voyez à l'écran, cherchez l'équivalent le plus proche dans la même zone Notifications avant de supposer qu'il a été déplacé." },
    { type: "paragraph",html: "Ces alertes d'ordres sont distinctes des événements de prix et de marché. Si vous souhaitez être alerté lorsqu'un contrat atteint un niveau plutôt que lorsqu'un ordre change d'état, il s'agit d'un paramètre d'alerte de prix distinct. Et si vous utilisez surtout votre téléphone, l'application mobile gère ses alertes sur son propre écran." },
    { type: "heading",text: "Automatisez cela avec PickMyTrade" },
    { type: "paragraph",html: "Fatigué de surveiller chaque exécution et de réagir manuellement à chaque alerte ? <strong class='text-white'>PickMyTrade automatise l'exécution de vos ordres Tradovate</strong> et laisse votre stratégie passer les trades à votre place." },
  ], it: [
    { type: "paragraph",html: "Se il segnale acustico costante dopo ogni esecuzione La esaspera, oppure desidera un discreto avviso solo quando viene colpito uno stop, i controlli che Le servono non sono nascosti in un menu separato. Si trovano all'interno di Application Settings e, una volta conosciuto il percorso, può rimodellare ogni alert in meno di un minuto. Ecco esattamente dove guardare e che cosa fa ciascun interruttore." },
    { type: "heading",text: "Che cosa può controllare" },
    { type: "paragraph",html: "I controlli di notifica di Tradovate vanno oltre un semplice on/off. Da una sola schermata può decidere se gli alert degli ordini compaiono o meno, ridurli agli stati che Le interessano, attivare gli alert push e scegliere un suono per ogni evento da una libreria di oltre quindici. Può anche nascondere completamente il pannello del ticker se preferisce non vedere il feed continuo in cima allo schermo." },
    { type: "heading",text: "Dove si trovano le impostazioni" },
    { type: "paragraph",html: "Tutto quanto segue avviene nella versione browser (web) della piattaforma. L'app desktop segue la stessa logica, anche se qualche etichetta può trovarsi in una posizione leggermente diversa." },
    {
      type: "steps",
      items: [
        { title: "Apra Application Settings", html: "Guardi l'angolo in alto a destra della finestra di Tradovate e faccia clic sul pulsante <strong class='text-white'>Application Settings</strong>. È il controllo a forma di ingranaggio che contiene le preferenze dell'intera piattaforma, non le impostazioni di un singolo grafico o DOM.", image: {"src":`${IMG}/tradovate-notification-settings-1.png`,"alt":"Pulsante Application Settings evidenziato nell'angolo in alto a destra di Tradovate Web"} },
        { title: "Apra la scheda Preferences", html: "All'interno di Application Settings, faccia clic sulla scheda <strong class='text-white'>Preferences</strong> in alto. È qui che si trovano le opzioni di layout, comportamento e notifica dell'intera piattaforma.", image: {"src":`${IMG}/tradovate-notification-settings-2.png`,"alt":"Scheda Preferences selezionata nella finestra Application Settings di Tradovate Web"} },
        { title: "Trovi la sezione Notifications", html: "Scorra la pagina Preferences verso il basso fino alla sezione <strong class='text-white'>Notifications</strong>. Due interruttori svolgono il lavoro principale: <strong class='text-white'>Order Notifications</strong> attiva o disattiva gli alert sullo stato degli ordini, e l'interruttore <strong class='text-white'>Notification Ticker</strong> rimuove l'intero pannello in alto che mostra l'orologio e il feed continuo delle notifiche. Disattivi Order Notifications e i pop-up si fermano; disattivi il ticker e il pannello scompare.", image: {"src":`${IMG}/tradovate-notification-settings-3.png`,"alt":"Sezione Notifications della pagina Preferences di Tradovate Web con gli interruttori Order Notifications e Notification Ticker"} },
        { title: "Apra Advanced Configuration per il controllo per singolo stato", html: "La maggior parte delle persone non vuole silenziare tutto. Faccia clic sul pulsante opzionale <strong class='text-white'>Advanced Configuration</strong> e potrà attivare o disattivare gli alert per ogni stato dell'ordine singolarmente. Mantenga, per esempio, l'alert per un ordine rifiutato o cancellato e silenzi quello che scatta a ogni esecuzione di routine. È l'impostazione a cui ricorrere quando il ping «order filled» è il vero problema, e non le notifiche in generale.", image: {"src":`${IMG}/tradovate-notification-settings-4.png`,"alt":"Pannello Advanced Configuration con i singoli interruttori di notifica per stato dell'ordine in Tradovate Web"} },
        { title: "Imposti le notifiche push e audio", html: "La stessa area consente di attivare o disattivare le <strong class='text-white'>notifiche push</strong> e di gestire il suono. Per l'audio, può attivare un suono, riprodurlo come prova e sostituirlo con un altro dalla libreria integrata di oltre quindici file. Imposti un tono deciso per uno stop-out e uno più morbido per un ordine in lavorazione se desidera distinguere gli eventi senza guardare lo schermo.", image: {"src":`${IMG}/tradovate-notification-settings-5.png`,"alt":"Controlli delle notifiche push e audio con opzioni sonore per ogni stato dell'ordine in Tradovate Web"} },
      ],
    },
    { type: "table", headers: ["Controllo","Che cosa fa"], rows: [
      ["Order Notifications","Interruttore principale per tutti gli alert sullo stato degli ordini"],
      ["Notification Ticker","Nasconde o mostra il pannello superiore con l'orologio e il feed degli alert"],
      ["Advanced Configuration","Attiva o disattiva ogni alert sullo stato dell'ordine singolarmente"],
      ["Notifiche push","Invia gli alert anche al di fuori della finestra attiva"],
      ["Notifiche audio","On/off, prova e scelta tra oltre 15 suoni per stato"],
    ] },
    { type: "heading",text: "Alcune cose utili da sapere" },
    { type: "paragraph",html: "Nella versione web non esiste un cursore del volume all'interno di Tradovate, quindi se un suono è troppo forte, lo sostituisca con un file più delicato oppure regoli il volume di sistema. L'app desktop permette invece di impostare il livello dell'app nelle impostazioni audio di Windows. Le etichette possono cambiare con gli aggiornamenti della piattaforma: se un nome qui riportato non corrisponde a quanto vede sullo schermo, cerchi l'equivalente più vicino nella stessa area Notifications prima di presumere che sia stato spostato." },
    { type: "paragraph",html: "Questi alert degli ordini sono separati dagli eventi di prezzo e di mercato. Se desidera essere avvisato quando un contratto raggiunge un livello, e non quando un ordine cambia stato, si tratta di un'impostazione separata per gli alert di prezzo. E se utilizza soprattutto il telefono, l'app mobile gestisce i propri alert su una schermata dedicata." },
    { type: "heading",text: "Automatizzi tutto questo con PickMyTrade" },
    { type: "paragraph",html: "Stanco di sorvegliare ogni esecuzione e di reagire manualmente a ogni alert? <strong class='text-white'>PickMyTrade automatizza l'esecuzione dei Suoi ordini su Tradovate</strong> e lascia che la Sua strategia esegua i trade per Lei." },
  ] },
