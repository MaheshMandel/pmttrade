---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "tradovate-risk-settings";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/how-to/${SLUG}`;

const META_TITLE = "Configure Account Risk Settings in Tradovate";
const META_DESCRIPTION =
  "Tradovate risk settings explained: open Application Settings to set daily loss limits, max position size, and profit triggers that protect your account.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Kontorisikoeinstellungen in Tradovate konfigurieren", es: "Configurar los ajustes de riesgo de la cuenta en Tradovate", fr: "Configurer les paramètres de risque du compte dans Tradovate", it: "Configurare le impostazioni di rischio del conto in Tradovate" },
  dek: { en: "Want to keep your risk in check on Tradovate? Here's exactly where the risk settings live and how to configure each limit, step by step.", de: "Sie möchten Ihr Risiko bei Tradovate im Griff behalten? Hier sehen Sie genau, wo die Risikoeinstellungen liegen und wie Sie jedes Limit Schritt für Schritt konfigurieren.", es: "¿Quiere mantener su riesgo bajo control en Tradovate? Aquí tiene exactamente dónde están los ajustes de riesgo y cómo configurar cada límite, paso a paso.", fr: "Vous voulez garder votre risque sous contrôle sur Tradovate ? Voici exactement où se trouvent les paramètres de risque et comment configurer chaque limite, pas à pas.", it: "Vuole tenere sotto controllo il rischio su Tradovate? Ecco esattamente dove si trovano le impostazioni di rischio e come configurare ogni limite, passo dopo passo." },
  readTime: { en: "5 min read", de: "5 Min. Lesezeit", es: "Lectura de 5 min", fr: "Lecture : 5 min", it: "Lettura di 5 min" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "Want to keep your risk in check on Tradovate? Whether you're capping a bad day, protecting a funded balance, or wiring up automation like PickMyTrade, here's exactly where the risk settings live and how to configure each limit, step by step." },
    { type: "heading", text: "What Are Tradovate Risk Settings?" },
    { type: "paragraph", html: "Tradovate risk settings are account-level guardrails. Hit a loss, profit, drawdown, or position threshold you set in advance, and the platform automatically locks trading, closes positions, cancels working orders, and blocks new entries until the next session. You set the rules once, and the platform enforces them, so you're not relying on willpower in the middle of a losing streak. They're a good fit for disciplined day traders and anyone guarding a max-drawdown balance." },
    { type: "heading", text: "Configure Risk Settings in Tradovate: Step-by-Step" },
    {
      type: "steps",
      items: [
        { title: "Open Application Settings", html: "Log in to Tradovate on the web or desktop app, then click the <strong class='text-white'>Application Settings</strong> button in the upper-right corner of the platform.", image: { src: `${IMG}/tradovate-risk-settings-1.png`, alt: "Tradovate platform showing the Application Settings button in the upper-right corner" } },
        { title: "Open the Risk Settings Panel", html: "Inside Application Settings, head to the <strong class='text-white'>Accounts</strong> section and click the <strong class='text-white'>Risk Settings</strong> button. That expands a detail panel listing every configurable limit for the selected account.", image: { src: `${IMG}/tradovate-risk-settings-2.png`, alt: "Tradovate Application Settings showing the Accounts tab and Risk Settings button" } },
        { title: "Enable the Limits You Want", html: "Toggle on the parameters that fit your plan. The controls you'll usually see include:<br><br><strong class='text-white'>Daily Loss Limit</strong> &mdash; caps net loss for the session, calculated on P&amp;L from the 5:00 PM CT session start, fees and commissions included.<br><strong class='text-white'>Weekly Loss Limit</strong> &mdash; caps cumulative loss across the trading week.<br><strong class='text-white'>Daily Profit Trigger / Weekly Profit Trigger</strong> &mdash; locks trading once you bank a target, so you don't hand profits back.<br><strong class='text-white'>Trailing Max Drawdown</strong> &mdash; a loss floor that trails your account's peak balance.<br><strong class='text-white'>Max Position Size</strong> &mdash; the largest total position you can hold across products.<br><strong class='text-white'>Products Permitted</strong> &mdash; restricts trading to specific symbols or contracts.", image: { src: `${IMG}/tradovate-risk-settings-3.png`, alt: "Tradovate Risk Settings panel showing loss limit, profit trigger, and max position toggles" } },
        { title: "Enter Values and Save", html: "For each setting you enable, type your value into the box, then scroll down and click <strong class='text-white'>Save</strong>. Don't leave a field at zero, since zero disables the rule. And if you turn on the option to lock risk settings while trading is locked, you won't be able to loosen them again until the account unlocks at the next session reset. That's the point, really: it stops you from moving the goalposts mid-tilt.", image: { src: `${IMG}/tradovate-risk-settings-4.png`, alt: "Tradovate Risk Settings showing entered limit values and the Save button" } },
      ],
    },
    { type: "heading", text: "Why You'd Need This" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Enforce daily discipline</strong>, walk away automatically after a set loss instead of revenge-trading your way to a bigger hole.",
        "<strong class='text-white'>Protect a funded or drawdown-based balance</strong>, keep a buffer before a trailing threshold gets breached.",
        "<strong class='text-white'>Standardize an automated strategy</strong>, pair a hard account limit with your bot so a runaway script can't blow through your risk budget.",
        "<strong class='text-white'>Lock in a good day</strong>, a profit trigger stops you from giving back what you just made.",
      ],
    },
    { type: "paragraph", html: "One important caveat: Tradovate's built-in Risk Settings apply to <strong class='text-white'>live and demo Tradovate Brokerage accounts</strong>. Trade a prop-firm evaluation or funded account and the firm typically controls those limits on their side. The exact rules, drawdown type, daily loss, contract caps, vary by firm and account size, so check your firm's current rules rather than assuming a number." },
    { type: "heading", text: "Automate This with PickMyTrade" },
    { type: "paragraph", html: "PickMyTrade links your TradingView alerts straight to your Tradovate account, so entries, exits, and position sizing execute automatically, no manual clicks while you watch a limit tick down. It adds its own quantity and symbol validation on top of Tradovate's risk settings, so an oversized or malformed alert gets caught before it ever reaches your account." },
  ], de: [
    { type: "paragraph",html: "Sie möchten Ihr Risiko bei Tradovate im Griff behalten? Ob Sie einen schlechten Tag begrenzen, ein Funded-Guthaben schützen oder eine Automatisierung wie PickMyTrade anbinden: Hier sehen Sie genau, wo die Risikoeinstellungen liegen und wie Sie jedes Limit Schritt für Schritt konfigurieren." },
    { type: "heading",text: "Was sind Tradovate-Risikoeinstellungen?" },
    { type: "paragraph",html: "Tradovate-Risikoeinstellungen sind Leitplanken auf Kontoebene. Erreichen Sie eine vorab festgelegte Schwelle für Verlust, Gewinn, Drawdown oder Positionsgröße, sperrt die Plattform automatisch den Handel, schließt Positionen, storniert aktive Orders und blockiert neue Einstiege bis zur nächsten Session. Sie legen die Regeln einmal fest, und die Plattform setzt sie durch, sodass Sie sich mitten in einer Verlustserie nicht auf Willenskraft verlassen müssen. Sie eignen sich gut für disziplinierte Daytrader und alle, die ein Guthaben mit maximalem Drawdown schützen." },
    { type: "heading",text: "Risikoeinstellungen in Tradovate konfigurieren: Schritt für Schritt" },
    {
      type: "steps",
      items: [
        { title: "Application Settings öffnen", html: "Melden Sie sich bei Tradovate im Web oder in der Desktop-App an und klicken Sie dann oben rechts in der Plattform auf die Schaltfläche <strong class='text-white'>Application Settings</strong>.", image: {"src":`${IMG}/tradovate-risk-settings-1.png`,"alt":"Tradovate-Plattform mit der Schaltfläche Application Settings in der oberen rechten Ecke"} },
        { title: "Das Risk-Settings-Panel öffnen", html: "Gehen Sie in den Application Settings zum Bereich <strong class='text-white'>Accounts</strong> und klicken Sie auf die Schaltfläche <strong class='text-white'>Risk Settings</strong>. Dadurch öffnet sich ein Detailpanel mit allen konfigurierbaren Limits für das ausgewählte Konto.", image: {"src":`${IMG}/tradovate-risk-settings-2.png`,"alt":"Tradovate Application Settings mit dem Reiter Accounts und der Schaltfläche Risk Settings"} },
        { title: "Die gewünschten Limits aktivieren", html: "Schalten Sie die Parameter ein, die zu Ihrem Plan passen. Üblicherweise finden Sie diese Steuerungen:<br><br><strong class='text-white'>Daily Loss Limit</strong> &mdash; begrenzt den Nettoverlust der Session, berechnet auf Basis der P&amp;L ab Sessionbeginn um 5:00 PM CT, einschließlich Gebühren und Kommissionen.<br><strong class='text-white'>Weekly Loss Limit</strong> &mdash; begrenzt den kumulierten Verlust über die Handelswoche.<br><strong class='text-white'>Daily Profit Trigger / Weekly Profit Trigger</strong> &mdash; sperrt den Handel, sobald Sie ein Ziel erreicht haben, damit Sie Gewinne nicht wieder abgeben.<br><strong class='text-white'>Trailing Max Drawdown</strong> &mdash; eine Verlustuntergrenze, die dem Höchststand Ihres Kontos folgt.<br><strong class='text-white'>Max Position Size</strong> &mdash; die größte Gesamtposition, die Sie über alle Produkte hinweg halten dürfen.<br><strong class='text-white'>Products Permitted</strong> &mdash; beschränkt den Handel auf bestimmte Symbole oder Kontrakte.", image: {"src":`${IMG}/tradovate-risk-settings-3.png`,"alt":"Tradovate-Risk-Settings-Panel mit Schaltern für Verlustlimit, Gewinn-Trigger und maximale Position"} },
        { title: "Werte eintragen und speichern", html: "Tragen Sie für jede aktivierte Einstellung Ihren Wert in das Feld ein, scrollen Sie dann nach unten und klicken Sie auf <strong class='text-white'>Save</strong>. Lassen Sie kein Feld auf null, denn null deaktiviert die Regel. Und wenn Sie die Option aktivieren, die Risikoeinstellungen bei gesperrtem Handel zu sperren, können Sie sie erst wieder lockern, wenn das Konto beim nächsten Session-Reset entsperrt wird. Genau darum geht es: Es verhindert, dass Sie mitten im Tilt die Torpfosten verschieben.", image: {"src":`${IMG}/tradovate-risk-settings-4.png`,"alt":"Tradovate Risk Settings mit eingetragenen Limitwerten und der Schaltfläche Save"} },
      ],
    },
    { type: "heading",text: "Wozu Sie das brauchen" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Tägliche Disziplin durchsetzen</strong>, nach einem festgelegten Verlust automatisch aufhören, statt sich per Revenge-Trading in ein noch größeres Loch zu manövrieren.",
        "<strong class='text-white'>Ein Funded- oder Drawdown-basiertes Guthaben schützen</strong>, einen Puffer halten, bevor eine Trailing-Schwelle verletzt wird.",
        "<strong class='text-white'>Eine automatisierte Strategie standardisieren</strong>, ein hartes Kontolimit mit Ihrem Bot kombinieren, damit ein durchgehendes Skript Ihr Risikobudget nicht sprengen kann.",
        "<strong class='text-white'>Einen guten Tag absichern</strong>, ein Profit Trigger verhindert, dass Sie zurückgeben, was Sie gerade verdient haben.",
      ],
    },
    { type: "paragraph",html: "Ein wichtiger Vorbehalt: Die integrierten Risk Settings von Tradovate gelten für <strong class='text-white'>Live- und Demo-Konten von Tradovate Brokerage</strong>. Handeln Sie ein Evaluierungs- oder Funded-Konto einer Prop Firm, kontrolliert die Firma diese Limits in der Regel auf ihrer Seite. Die genauen Regeln, Drawdown-Typ, Tagesverlust, Kontraktobergrenzen, variieren je nach Firma und Kontogröße. Prüfen Sie daher die aktuellen Regeln Ihrer Firma, statt eine Zahl anzunehmen." },
    { type: "heading",text: "Automatisieren Sie das mit PickMyTrade" },
    { type: "paragraph",html: "PickMyTrade verbindet Ihre TradingView-Alerts direkt mit Ihrem Tradovate-Konto, sodass Einstiege, Ausstiege und Positionsgrößen automatisch ausgeführt werden, ohne manuelle Klicks, während Sie zusehen, wie ein Limit abschmilzt. Zusätzlich zu den Risikoeinstellungen von Tradovate bringt es eine eigene Validierung von Menge und Symbol mit, sodass ein überdimensionierter oder fehlerhafter Alert abgefangen wird, bevor er Ihr Konto überhaupt erreicht." },
  ], es: [
    { type: "paragraph",html: "¿Quiere mantener su riesgo bajo control en Tradovate? Ya sea para limitar un mal día, proteger un saldo fondeado o conectar una automatización como PickMyTrade, aquí tiene exactamente dónde están los ajustes de riesgo y cómo configurar cada límite, paso a paso." },
    { type: "heading",text: "¿Qué son los ajustes de riesgo de Tradovate?" },
    { type: "paragraph",html: "Los ajustes de riesgo de Tradovate son barreras de protección a nivel de cuenta. Si alcanza un umbral de pérdida, beneficio, drawdown o posición que haya fijado de antemano, la plataforma bloquea automáticamente el trading, cierra posiciones, cancela órdenes activas y bloquea nuevas entradas hasta la siguiente sesión. Usted fija las reglas una vez y la plataforma las aplica, así que no depende de la fuerza de voluntad en mitad de una racha perdedora. Son ideales para day traders disciplinados y para quien protege un saldo con drawdown máximo." },
    { type: "heading",text: "Configurar los ajustes de riesgo en Tradovate: paso a paso" },
    {
      type: "steps",
      items: [
        { title: "Abra Application Settings", html: "Inicie sesión en Tradovate en la web o en la aplicación de escritorio y haga clic en el botón <strong class='text-white'>Application Settings</strong> de la esquina superior derecha de la plataforma.", image: {"src":`${IMG}/tradovate-risk-settings-1.png`,"alt":"Plataforma Tradovate mostrando el botón Application Settings en la esquina superior derecha"} },
        { title: "Abra el panel Risk Settings", html: "Dentro de Application Settings, vaya a la sección <strong class='text-white'>Accounts</strong> y haga clic en el botón <strong class='text-white'>Risk Settings</strong>. Se despliega un panel de detalle con todos los límites configurables de la cuenta seleccionada.", image: {"src":`${IMG}/tradovate-risk-settings-2.png`,"alt":"Application Settings de Tradovate mostrando la pestaña Accounts y el botón Risk Settings"} },
        { title: "Active los límites que desee", html: "Active los parámetros que encajen con su plan. Los controles que verá normalmente son:<br><br><strong class='text-white'>Daily Loss Limit</strong> &mdash; limita la pérdida neta de la sesión, calculada sobre el P&amp;L desde el inicio de sesión a las 5:00 PM CT, incluidas tarifas y comisiones.<br><strong class='text-white'>Weekly Loss Limit</strong> &mdash; limita la pérdida acumulada durante la semana de trading.<br><strong class='text-white'>Daily Profit Trigger / Weekly Profit Trigger</strong> &mdash; bloquea el trading cuando alcanza un objetivo, para que no devuelva los beneficios.<br><strong class='text-white'>Trailing Max Drawdown</strong> &mdash; un suelo de pérdida que sigue el saldo máximo de su cuenta.<br><strong class='text-white'>Max Position Size</strong> &mdash; la mayor posición total que puede mantener entre productos.<br><strong class='text-white'>Products Permitted</strong> &mdash; restringe el trading a símbolos o contratos concretos.", image: {"src":`${IMG}/tradovate-risk-settings-3.png`,"alt":"Panel Risk Settings de Tradovate con interruptores de límite de pérdida, activador de beneficio y posición máxima"} },
        { title: "Introduzca los valores y guarde", html: "Para cada ajuste que active, escriba su valor en el cuadro, desplácese hacia abajo y haga clic en <strong class='text-white'>Save</strong>. No deje ningún campo en cero, ya que cero desactiva la regla. Y si activa la opción de bloquear los ajustes de riesgo mientras el trading está bloqueado, no podrá relajarlos de nuevo hasta que la cuenta se desbloquee en el siguiente reinicio de sesión. Esa es precisamente la idea: evita que mueva la portería en pleno tilt.", image: {"src":`${IMG}/tradovate-risk-settings-4.png`,"alt":"Risk Settings de Tradovate mostrando los valores de límite introducidos y el botón Save"} },
      ],
    },
    { type: "heading",text: "Por qué lo necesitaría" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Imponer disciplina diaria</strong>, retirarse automáticamente tras una pérdida fijada en lugar de operar por venganza hasta un agujero mayor.",
        "<strong class='text-white'>Proteger un saldo fondeado o basado en drawdown</strong>, mantener un colchón antes de que se supere un umbral dinámico.",
        "<strong class='text-white'>Estandarizar una estrategia automatizada</strong>, combinar un límite de cuenta estricto con su bot para que un script descontrolado no agote su presupuesto de riesgo.",
        "<strong class='text-white'>Asegurar un buen día</strong>, un activador de beneficio evita que devuelva lo que acaba de ganar.",
      ],
    },
    { type: "paragraph",html: "Una advertencia importante: los Risk Settings integrados de Tradovate se aplican a <strong class='text-white'>cuentas reales y demo de Tradovate Brokerage</strong>. Si opera una cuenta de evaluación o fondeada de una prop firm, la firma normalmente controla esos límites por su cuenta. Las reglas exactas, tipo de drawdown, pérdida diaria, límites de contratos, varían según la firma y el tamaño de la cuenta, así que consulte las reglas vigentes de su firma en lugar de dar una cifra por supuesta." },
    { type: "heading",text: "Automatice esto con PickMyTrade" },
    { type: "paragraph",html: "PickMyTrade conecta sus alertas de TradingView directamente con su cuenta de Tradovate, de modo que las entradas, las salidas y el tamaño de posición se ejecutan automáticamente, sin clics manuales mientras ve cómo se agota un límite. Añade su propia validación de cantidad y símbolo sobre los ajustes de riesgo de Tradovate, de modo que una alerta sobredimensionada o mal formada se detecta antes de llegar a su cuenta." },
  ], fr: [
    { type: "paragraph",html: "Vous voulez garder votre risque sous contrôle sur Tradovate ? Que vous plafonniez une mauvaise journée, protégiez un solde financé ou branchiez une automatisation comme PickMyTrade, voici exactement où se trouvent les paramètres de risque et comment configurer chaque limite, pas à pas." },
    { type: "heading",text: "Que sont les paramètres de risque Tradovate ?" },
    { type: "paragraph",html: "Les paramètres de risque Tradovate sont des garde-fous au niveau du compte. Dès que vous atteignez un seuil de perte, de gain, de drawdown ou de position défini à l'avance, la plateforme verrouille automatiquement le trading, ferme les positions, annule les ordres actifs et bloque les nouvelles entrées jusqu'à la session suivante. Vous fixez les règles une fois et la plateforme les applique, sans que vous ayez à compter sur votre volonté au milieu d'une série perdante. Ils conviennent bien aux day traders disciplinés et à toute personne qui protège un solde soumis à un drawdown maximal." },
    { type: "heading",text: "Configurer les paramètres de risque dans Tradovate : pas à pas" },
    {
      type: "steps",
      items: [
        { title: "Ouvrez Application Settings", html: "Connectez-vous à Tradovate sur le web ou dans l'application de bureau, puis cliquez sur le bouton <strong class='text-white'>Application Settings</strong> dans le coin supérieur droit de la plateforme.", image: {"src":`${IMG}/tradovate-risk-settings-1.png`,"alt":"Plateforme Tradovate affichant le bouton Application Settings dans le coin supérieur droit"} },
        { title: "Ouvrez le panneau Risk Settings", html: "Dans Application Settings, rendez-vous dans la section <strong class='text-white'>Accounts</strong> et cliquez sur le bouton <strong class='text-white'>Risk Settings</strong>. Un panneau de détail s'ouvre, listant toutes les limites configurables du compte sélectionné.", image: {"src":`${IMG}/tradovate-risk-settings-2.png`,"alt":"Application Settings de Tradovate affichant l'onglet Accounts et le bouton Risk Settings"} },
        { title: "Activez les limites souhaitées", html: "Activez les paramètres qui correspondent à votre plan. Les contrôles que vous verrez généralement sont :<br><br><strong class='text-white'>Daily Loss Limit</strong> &mdash; plafonne la perte nette de la session, calculée sur le P&amp;L depuis le début de session à 5:00 PM CT, frais et commissions inclus.<br><strong class='text-white'>Weekly Loss Limit</strong> &mdash; plafonne la perte cumulée sur la semaine de trading.<br><strong class='text-white'>Daily Profit Trigger / Weekly Profit Trigger</strong> &mdash; verrouille le trading dès que vous atteignez un objectif, pour ne pas rendre vos gains.<br><strong class='text-white'>Trailing Max Drawdown</strong> &mdash; un plancher de perte qui suit le pic de solde de votre compte.<br><strong class='text-white'>Max Position Size</strong> &mdash; la plus grande position totale que vous pouvez détenir tous produits confondus.<br><strong class='text-white'>Products Permitted</strong> &mdash; limite le trading à des symboles ou contrats précis.", image: {"src":`${IMG}/tradovate-risk-settings-3.png`,"alt":"Panneau Risk Settings de Tradovate avec les options de limite de perte, de seuil de profit et de position maximale"} },
        { title: "Saisissez les valeurs et enregistrez", html: "Pour chaque paramètre activé, saisissez votre valeur dans le champ, puis faites défiler vers le bas et cliquez sur <strong class='text-white'>Save</strong>. Ne laissez aucun champ à zéro, car zéro désactive la règle. Et si vous activez l'option de verrouiller les paramètres de risque lorsque le trading est verrouillé, vous ne pourrez plus les assouplir avant le déverrouillage du compte à la réinitialisation de session suivante. C'est précisément le but : cela vous empêche de changer les règles en plein tilt.", image: {"src":`${IMG}/tradovate-risk-settings-4.png`,"alt":"Risk Settings de Tradovate affichant les valeurs de limite saisies et le bouton Save"} },
      ],
    },
    { type: "heading",text: "Pourquoi en avez-vous besoin" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Imposer une discipline quotidienne</strong>, s'arrêter automatiquement après une perte définie plutôt que de s'enfoncer en revenge trading.",
        "<strong class='text-white'>Protéger un solde financé ou soumis à un drawdown</strong>, garder une marge avant qu'un seuil dynamique ne soit franchi.",
        "<strong class='text-white'>Standardiser une stratégie automatisée</strong>, associer une limite de compte stricte à votre bot pour qu'un script qui s'emballe ne puisse pas épuiser votre budget de risque.",
        "<strong class='text-white'>Sécuriser une bonne journée</strong>, un seuil de profit vous empêche de rendre ce que vous venez de gagner.",
      ],
    },
    { type: "paragraph",html: "Une précision importante : les Risk Settings intégrés de Tradovate s'appliquent aux <strong class='text-white'>comptes réels et démo Tradovate Brokerage</strong>. Si vous tradez un compte d'évaluation ou financé d'une prop firm, la firme contrôle généralement ces limites de son côté. Les règles exactes, type de drawdown, perte quotidienne, plafonds de contrats, varient selon la firme et la taille du compte ; consultez donc les règles en vigueur de votre firme plutôt que de supposer un chiffre." },
    { type: "heading",text: "Automatisez cela avec PickMyTrade" },
    { type: "paragraph",html: "PickMyTrade relie directement vos alertes TradingView à votre compte Tradovate, de sorte que les entrées, les sorties et la taille des positions s'exécutent automatiquement, sans clics manuels pendant que vous regardez une limite se rapprocher. Il ajoute sa propre validation de la quantité et du symbole en plus des paramètres de risque de Tradovate, afin qu'une alerte surdimensionnée ou mal formée soit interceptée avant d'atteindre votre compte." },
  ], it: [
    { type: "paragraph",html: "Vuole tenere sotto controllo il rischio su Tradovate? Che stia limitando una brutta giornata, proteggendo un saldo finanziato o collegando un'automazione come PickMyTrade, ecco esattamente dove si trovano le impostazioni di rischio e come configurare ogni limite, passo dopo passo." },
    { type: "heading",text: "Cosa sono le impostazioni di rischio di Tradovate?" },
    { type: "paragraph",html: "Le impostazioni di rischio di Tradovate sono barriere di protezione a livello di conto. Se raggiunge una soglia di perdita, profitto, drawdown o posizione impostata in anticipo, la piattaforma blocca automaticamente il trading, chiude le posizioni, annulla gli ordini attivi e blocca nuovi ingressi fino alla sessione successiva. Imposta le regole una volta e la piattaforma le applica, così non deve affidarsi alla forza di volontà nel mezzo di una serie negativa. Sono adatte ai day trader disciplinati e a chiunque protegga un saldo con drawdown massimo." },
    { type: "heading",text: "Configurare le impostazioni di rischio in Tradovate: passo dopo passo" },
    {
      type: "steps",
      items: [
        { title: "Apra Application Settings", html: "Acceda a Tradovate dal web o dall'app desktop, poi clicchi sul pulsante <strong class='text-white'>Application Settings</strong> nell'angolo in alto a destra della piattaforma.", image: {"src":`${IMG}/tradovate-risk-settings-1.png`,"alt":"Piattaforma Tradovate che mostra il pulsante Application Settings nell'angolo in alto a destra"} },
        { title: "Apra il pannello Risk Settings", html: "In Application Settings, vada alla sezione <strong class='text-white'>Accounts</strong> e clicchi sul pulsante <strong class='text-white'>Risk Settings</strong>. Si espande un pannello di dettaglio con tutti i limiti configurabili per il conto selezionato.", image: {"src":`${IMG}/tradovate-risk-settings-2.png`,"alt":"Application Settings di Tradovate che mostra la scheda Accounts e il pulsante Risk Settings"} },
        { title: "Attivi i limiti desiderati", html: "Attivi i parametri adatti al Suo piano. I controlli che vedrà di solito sono:<br><br><strong class='text-white'>Daily Loss Limit</strong> &mdash; limita la perdita netta della sessione, calcolata sul P&amp;L dall'inizio sessione alle 5:00 PM CT, incluse commissioni e costi.<br><strong class='text-white'>Weekly Loss Limit</strong> &mdash; limita la perdita cumulata nell'arco della settimana di trading.<br><strong class='text-white'>Daily Profit Trigger / Weekly Profit Trigger</strong> &mdash; blocca il trading una volta raggiunto un obiettivo, così non restituisce i profitti.<br><strong class='text-white'>Trailing Max Drawdown</strong> &mdash; una soglia di perdita che segue il picco di saldo del conto.<br><strong class='text-white'>Max Position Size</strong> &mdash; la posizione totale massima che può detenere tra i vari prodotti.<br><strong class='text-white'>Products Permitted</strong> &mdash; limita il trading a simboli o contratti specifici.", image: {"src":`${IMG}/tradovate-risk-settings-3.png`,"alt":"Pannello Risk Settings di Tradovate con interruttori per limite di perdita, trigger di profitto e posizione massima"} },
        { title: "Inserisca i valori e salvi", html: "Per ogni impostazione attivata, digiti il valore nella casella, poi scorra verso il basso e clicchi su <strong class='text-white'>Save</strong>. Non lasci nessun campo a zero, perché zero disattiva la regola. E se attiva l'opzione per bloccare le impostazioni di rischio mentre il trading è bloccato, non potrà allentarle di nuovo finché il conto non si sblocca al successivo reset di sessione. È proprio questo il punto: Le impedisce di spostare i paletti nel pieno del tilt.", image: {"src":`${IMG}/tradovate-risk-settings-4.png`,"alt":"Risk Settings di Tradovate che mostrano i valori dei limiti inseriti e il pulsante Save"} },
      ],
    },
    { type: "heading",text: "Perché Le serve" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Imporre la disciplina giornaliera</strong>, fermarsi automaticamente dopo una perdita prestabilita invece di fare revenge trading fino a una buca più profonda.",
        "<strong class='text-white'>Proteggere un saldo finanziato o basato su drawdown</strong>, mantenere un margine prima che una soglia dinamica venga violata.",
        "<strong class='text-white'>Standardizzare una strategia automatizzata</strong>, abbinare un limite rigido sul conto al Suo bot, così uno script fuori controllo non può bruciare il budget di rischio.",
        "<strong class='text-white'>Blindare una buona giornata</strong>, un profit trigger Le impedisce di restituire ciò che ha appena guadagnato.",
      ],
    },
    { type: "paragraph",html: "Un'avvertenza importante: i Risk Settings integrati di Tradovate si applicano ai <strong class='text-white'>conti reali e demo di Tradovate Brokerage</strong>. Se opera con un conto di valutazione o finanziato di una prop firm, di norma è la firm a controllare quei limiti dal proprio lato. Le regole esatte, tipo di drawdown, perdita giornaliera, tetti sui contratti, variano a seconda della firm e della dimensione del conto, quindi verifichi le regole attuali della Sua firm invece di dare per scontato un numero." },
    { type: "heading",text: "Automatizzi tutto questo con PickMyTrade" },
    { type: "paragraph",html: "PickMyTrade collega direttamente i Suoi alert di TradingView al Suo conto Tradovate, così ingressi, uscite e dimensione delle posizioni vengono eseguiti automaticamente, senza clic manuali mentre guarda un limite avvicinarsi. Aggiunge una propria validazione di quantità e simbolo oltre alle impostazioni di rischio di Tradovate, così un alert sovradimensionato o malformato viene intercettato prima ancora di raggiungere il Suo conto." },
  ] },
  ctaHeading: { en: "Automate Inside Your Risk Limits", de: "Automatisieren Sie innerhalb Ihrer Risikolimits", es: "Automatice dentro de sus límites de riesgo", fr: "Automatisez dans le respect de vos limites de risque", it: "Automatizzi entro i Suoi limiti di rischio" },
  ctaText: { en: "PickMyTrade links your TradingView alerts straight to your Tradovate account, so entries, exits, and position sizing execute automatically, no manual clicks while you watch a limit tick down.", de: "PickMyTrade verbindet Ihre TradingView-Alerts direkt mit Ihrem Tradovate-Konto, sodass Einstiege, Ausstiege und Positionsgrößen automatisch ausgeführt werden, ohne manuelle Klicks, während Sie zusehen, wie ein Limit abschmilzt.", es: "PickMyTrade conecta sus alertas de TradingView directamente con su cuenta de Tradovate, de modo que las entradas, las salidas y el tamaño de posición se ejecutan automáticamente, sin clics manuales mientras ve cómo se agota un límite.", fr: "PickMyTrade relie directement vos alertes TradingView à votre compte Tradovate, de sorte que les entrées, les sorties et la taille des positions s'exécutent automatiquement, sans clics manuels pendant que vous regardez une limite se rapprocher.", it: "PickMyTrade collega direttamente i Suoi alert di TradingView al Suo conto Tradovate, così ingressi, uscite e dimensione delle posizioni vengono eseguiti automaticamente, senza clic manuali mentre guarda un limite avvicinarsi." },
  ctaButtonText: { en: "Start Your Free 7-Day Trial", de: "Starten Sie Ihre kostenlose 7-Tage-Testphase", es: "Comience su prueba gratuita de 7 días", fr: "Commencez votre essai gratuit de 7 jours", it: "Inizi la prova gratuita di 7 giorni" },
  ctaUrl: "https://app.pickmytrade.trade/?register=true&utm_source=content&utm_medium=how-to",
  faqHeading: { en: "Frequently Asked Questions", de: "Häufig gestellte Fragen", es: "Preguntas frecuentes", fr: "Questions fréquentes", it: "Domande frequenti" },
  faqs: { en: [
    { q: "Where are Risk Settings in Tradovate?", a: "Click Application Settings in the top-right corner, open the Accounts section, and click Risk Settings to expand the panel of configurable limits." },
    { q: "Why can't I change Risk Settings on my prop account?", a: "Built-in Risk Settings work on live and demo Tradovate Brokerage accounts. On evaluation or funded prop accounts, the firm sets and enforces the limits, contact your provider to adjust them." },
    { q: "What happens when I hit a loss limit?", a: "Tradovate closes open positions, cancels working orders, and blocks new entries until the next trading session begins. The daily session resets at 5:00 PM CT." },
  ], de: [
    { q: "Wo finde ich die Risk Settings in Tradovate?", a: "Klicken Sie oben rechts auf Application Settings, öffnen Sie den Bereich Accounts und klicken Sie auf Risk Settings, um das Panel mit den konfigurierbaren Limits zu erweitern." },
    { q: "Warum kann ich die Risk Settings auf meinem Prop-Konto nicht ändern?", a: "Die integrierten Risk Settings funktionieren bei Live- und Demo-Konten von Tradovate Brokerage. Bei Evaluierungs- oder Funded-Prop-Konten legt die Firma die Limits fest und setzt sie durch. Wenden Sie sich an Ihren Anbieter, um sie anzupassen." },
    { q: "Was passiert, wenn ich ein Verlustlimit erreiche?", a: "Tradovate schließt offene Positionen, storniert aktive Orders und blockiert neue Einstiege bis zum Beginn der nächsten Handelssession. Die tägliche Session wird um 5:00 PM CT zurückgesetzt." },
  ], es: [
    { q: "¿Dónde están los Risk Settings en Tradovate?", a: "Haga clic en Application Settings en la esquina superior derecha, abra la sección Accounts y haga clic en Risk Settings para desplegar el panel de límites configurables." },
    { q: "¿Por qué no puedo cambiar los Risk Settings en mi cuenta prop?", a: "Los Risk Settings integrados funcionan en cuentas reales y demo de Tradovate Brokerage. En cuentas de evaluación o fondeadas de prop firms, la firma establece y aplica los límites; contacte con su proveedor para ajustarlos." },
    { q: "¿Qué ocurre cuando alcanzo un límite de pérdida?", a: "Tradovate cierra las posiciones abiertas, cancela las órdenes activas y bloquea nuevas entradas hasta que comience la siguiente sesión de trading. La sesión diaria se reinicia a las 5:00 PM CT." },
  ], fr: [
    { q: "Où se trouvent les Risk Settings dans Tradovate ?", a: "Cliquez sur Application Settings en haut à droite, ouvrez la section Accounts, puis cliquez sur Risk Settings pour déplier le panneau des limites configurables." },
    { q: "Pourquoi ne puis-je pas modifier les Risk Settings sur mon compte prop ?", a: "Les Risk Settings intégrés fonctionnent sur les comptes réels et démo Tradovate Brokerage. Sur les comptes d'évaluation ou financés des prop firms, c'est la firme qui définit et applique les limites ; contactez votre fournisseur pour les ajuster." },
    { q: "Que se passe-t-il lorsque j'atteins une limite de perte ?", a: "Tradovate ferme les positions ouvertes, annule les ordres actifs et bloque les nouvelles entrées jusqu'au début de la prochaine session de trading. La session quotidienne se réinitialise à 5:00 PM CT." },
  ], it: [
    { q: "Dove si trovano i Risk Settings in Tradovate?", a: "Clicchi su Application Settings nell'angolo in alto a destra, apra la sezione Accounts e clicchi su Risk Settings per espandere il pannello dei limiti configurabili." },
    { q: "Perché non posso modificare i Risk Settings sul mio conto prop?", a: "I Risk Settings integrati funzionano sui conti reali e demo di Tradovate Brokerage. Sui conti di valutazione o finanziati delle prop firm, i limiti sono stabiliti e applicati dalla firm; contatti il Suo fornitore per modificarli." },
    { q: "Cosa succede quando raggiungo un limite di perdita?", a: "Tradovate chiude le posizioni aperte, annulla gli ordini attivi e blocca nuovi ingressi fino all'inizio della sessione di trading successiva. La sessione giornaliera si azzera alle 5:00 PM CT." },
  ] },
  relatedHeading: { en: "Related Guides", de: "Verwandte Anleitungen", es: "Guías relacionadas", fr: "Guides associés", it: "Guide correlate" },
