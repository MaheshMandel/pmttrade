---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "tradovate-account-reports";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/how-to/${SLUG}`;

const META_TITLE = "View Account Reports & Trade Performance in Tradovate";
const META_DESCRIPTION =
  "Tradovate account reports made easy: open the Reports panel, filter any date range, review your P&L and win rate, then download a CSV or PDF.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Kontoberichte und Trading-Performance in Tradovate anzeigen", es: "Cómo ver informes de cuenta y rendimiento de trading en Tradovate", fr: "Consulter les rapports de compte et la performance de trading dans Tradovate", it: "Come visualizzare i report del conto e la performance di trading in Tradovate" },
  dek: { en: "Need to pull your Tradovate account reports? Here's exactly how to view and download date-filtered performance reports, step by step.", de: "Sie möchten Ihre Tradovate-Kontoberichte abrufen? So zeigen Sie datumsgefilterte Performance-Berichte an und laden sie herunter, Schritt für Schritt.", es: "¿Necesita obtener sus informes de cuenta de Tradovate? Así se ven y se descargan los informes de rendimiento filtrados por fecha, paso a paso.", fr: "Vous avez besoin de vos rapports de compte Tradovate ? Voici comment afficher et télécharger des rapports de performance filtrés par date, étape par étape.", it: "Ha bisogno dei report del suo conto Tradovate? Ecco come visualizzare e scaricare i report di performance filtrati per data, passo dopo passo." },
  readTime: { en: "5 min read", de: "5 Min. Lesezeit", es: "Lectura de 5 min", fr: "Lecture : 5 min", it: "Lettura di 5 min" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "Need to pull your Tradovate account reports? Maybe you're auditing fills, filing taxes, feeding a trading journal, or wiring up automation like PickMyTrade. Whatever the reason, here's exactly how to view and download date-filtered performance reports, step by step." },
    { type: "heading", text: "What Are Tradovate Account Reports?" },
    { type: "paragraph", html: "Your account reports are the built-in record of everything that happens in the account: every fill, every order, every cash movement, and your overall trading performance. You'll reach for them any time you want to check P&L for a specific stretch, export data for a journal or your accountant, or verify a fill that didn't look quite right." },
    { type: "heading", text: "View Tradovate Account Reports: Step-by-Step" },
    {
      type: "steps",
      items: [
        { title: "Open the Reports Panel", html: "In the Tradovate platform, click the <strong class='text-white'>Reports</strong> icon in the toolbar. You can also get there by clicking the margin/balance bar at the top of the screen. Either way lands you on the Account Reports view, where every report type lives.", image: { src: `${IMG}/tradovate-account-reports-1.png`, alt: "Tradovate toolbar showing the Reports icon to open account reports" } },
        { title: "Choose a Report Type", html: "Pick the report you need from the tabs. The common ones are <strong class='text-white'>Performance</strong>, <strong class='text-white'>Fills</strong>, <strong class='text-white'>Orders</strong>, <strong class='text-white'>Position History</strong>, <strong class='text-white'>Cash History</strong>, and <strong class='text-white'>Account Balance History</strong>. Go with Performance when you want a P&L overview, or Fills when you need trade-by-trade detail with the costs attached.", image: { src: `${IMG}/tradovate-account-reports-2.png`, alt: "Tradovate Account Reports showing report type tabs including Performance and Fills" } },
        { title: "Set Your Date Range", html: "Grab a preset like <strong class='text-white'>Today</strong>, <strong class='text-white'>This Week</strong>, or <strong class='text-white'>This Month</strong>, or pick <strong class='text-white'>Custom</strong> and type in your From and To dates. Click Go and the report generates for that window.", image: { src: `${IMG}/tradovate-account-reports-3.png`, alt: "Tradovate account reports date-range filter with From and To fields and the Go button" } },
        { title: "Review Your Trade Performance", html: "The Performance report lays out your overall P&L, trade count, win rate, drawdown, run-up, and the profit/loss charts for the range you chose. Scroll down and you'll find the detailed list of executed trades, each with its own entry, exit, and P&L.", image: { src: `${IMG}/tradovate-account-reports-4.png`, alt: "Tradovate Performance report showing P&L, win rate, drawdown and trade list" } },
        { title: "Download the Report", html: "Use the download option to export as a <strong class='text-white'>CSV</strong> (best for spreadsheets and trading journals) or a <strong class='text-white'>PDF</strong> (best for records and taxes). One thing worth checking: when you export fills for P&L reconciliation, make sure the commissions and fees columns are included, otherwise your numbers won't match the account net.", image: { src: `${IMG}/tradovate-account-reports-5.png`, alt: "Tradovate account report download options for CSV and PDF export" } },
      ],
    },
    { type: "heading", text: "Why You'd Need This" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Tax records</strong>, hand your accountant a clean, date-filtered P&L or fills export.",
        "<strong class='text-white'>Trading journals</strong>, import a Fills CSV (with the cost columns) into your journaling tool.",
        "<strong class='text-white'>Disputing a fill</strong>, pull the exact order and fill history for a given day.",
        "<strong class='text-white'>Performance review</strong>, track win rate, drawdown, and run-up over any period.",
        "<strong class='text-white'>Prop-firm audits</strong>, evaluation and funded-account rules vary by firm and account size, so keep your own report copies to check against your firm's current rules.",
      ],
    },
    { type: "heading", text: "Automate This with PickMyTrade" },
    { type: "paragraph", html: "Logging every entry and exit by hand gets old fast. <strong class='text-white'>PickMyTrade wires your TradingView alerts straight into your Tradovate account</strong>, so each trade is placed and recorded for you. Your reports stay complete, and your journal fills itself, no manual clicks." },
  ], de: [
    { type: "paragraph",html: "Sie möchten Ihre Tradovate-Kontoberichte abrufen? Vielleicht prüfen Sie Fills, bereiten Ihre Steuererklärung vor, füttern ein Trading-Journal oder richten eine Automatisierung wie PickMyTrade ein. Was auch immer der Grund ist: So zeigen Sie datumsgefilterte Performance-Berichte an und laden sie herunter, Schritt für Schritt." },
    { type: "heading",text: "Was sind Tradovate-Kontoberichte?" },
    { type: "paragraph",html: "Ihre Kontoberichte sind die integrierte Aufzeichnung von allem, was in Ihrem Konto passiert: jeder Fill, jede Order, jede Geldbewegung und Ihre gesamte Trading-Performance. Sie benötigen sie immer dann, wenn Sie den GuV-Wert für einen bestimmten Zeitraum prüfen, Daten für ein Journal oder Ihren Steuerberater exportieren oder einen Fill überprüfen möchten, der nicht ganz stimmig aussah." },
    { type: "heading",text: "Tradovate-Kontoberichte anzeigen: Schritt für Schritt" },
    {
      type: "steps",
      items: [
        { title: "Das Reports-Panel öffnen", html: "Klicken Sie in der Tradovate-Plattform in der Symbolleiste auf das Symbol <strong class='text-white'>Reports</strong>. Alternativ gelangen Sie dorthin, indem Sie oben auf dem Bildschirm auf die Margin-/Kontostandleiste klicken. In beiden Fällen landen Sie in der Ansicht der Kontoberichte, in der alle Berichtstypen zu finden sind.", image: {"src":`${IMG}/tradovate-account-reports-1.png`,"alt":"Tradovate-Symbolleiste mit dem Reports-Symbol zum Öffnen der Kontoberichte"} },
        { title: "Einen Berichtstyp auswählen", html: "Wählen Sie den benötigten Bericht über die Registerkarten aus. Die gängigsten sind <strong class='text-white'>Performance</strong>, <strong class='text-white'>Fills</strong>, <strong class='text-white'>Orders</strong>, <strong class='text-white'>Position History</strong>, <strong class='text-white'>Cash History</strong> und <strong class='text-white'>Account Balance History</strong>. Wählen Sie Performance für einen GuV-Überblick oder Fills, wenn Sie Trade-für-Trade-Details samt Kosten benötigen.", image: {"src":`${IMG}/tradovate-account-reports-2.png`,"alt":"Tradovate-Kontoberichte mit den Registerkarten der Berichtstypen, darunter Performance und Fills"} },
        { title: "Zeitraum festlegen", html: "Wählen Sie eine Voreinstellung wie <strong class='text-white'>Today</strong>, <strong class='text-white'>This Week</strong> oder <strong class='text-white'>This Month</strong>, oder wählen Sie <strong class='text-white'>Custom</strong> und geben Sie Ihre From- und To-Daten ein. Klicken Sie auf Go, und der Bericht wird für diesen Zeitraum erstellt.", image: {"src":`${IMG}/tradovate-account-reports-3.png`,"alt":"Datumsfilter der Tradovate-Kontoberichte mit den Feldern From und To und der Schaltfläche Go"} },
        { title: "Ihre Trading-Performance prüfen", html: "Der Performance-Bericht zeigt Ihren Gesamt-GuV, die Anzahl der Trades, die Gewinnquote, den Drawdown, den Run-up sowie die Gewinn-/Verlust-Diagramme für den gewählten Zeitraum. Scrollen Sie nach unten, finden Sie die detaillierte Liste der ausgeführten Trades mit jeweils eigenem Einstieg, Ausstieg und GuV.", image: {"src":`${IMG}/tradovate-account-reports-4.png`,"alt":"Tradovate-Performance-Bericht mit GuV, Gewinnquote, Drawdown und Trade-Liste"} },
        { title: "Den Bericht herunterladen", html: "Nutzen Sie die Download-Option, um den Bericht als <strong class='text-white'>CSV</strong> (ideal für Tabellen und Trading-Journale) oder als <strong class='text-white'>PDF</strong> (ideal für Unterlagen und Steuern) zu exportieren. Ein Punkt verdient Beachtung: Wenn Sie Fills für den GuV-Abgleich exportieren, stellen Sie sicher, dass die Spalten für Provisionen und Gebühren enthalten sind, sonst stimmen Ihre Zahlen nicht mit dem Netto-Kontostand überein.", image: {"src":`${IMG}/tradovate-account-reports-5.png`,"alt":"Download-Optionen für Tradovate-Kontoberichte im CSV- und PDF-Export"} },
      ],
    },
    { type: "heading",text: "Wofür Sie das brauchen" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Steuerunterlagen</strong>, übergeben Sie Ihrem Steuerberater einen sauberen, datumsgefilterten GuV- oder Fills-Export.",
        "<strong class='text-white'>Trading-Journale</strong>, importieren Sie eine Fills-CSV (mit den Kostenspalten) in Ihr Journal-Tool.",
        "<strong class='text-white'>Anfechtung eines Fills</strong>, rufen Sie den exakten Order- und Fill-Verlauf für einen bestimmten Tag ab.",
        "<strong class='text-white'>Performance-Auswertung</strong>, verfolgen Sie Gewinnquote, Drawdown und Run-up über beliebige Zeiträume.",
        "<strong class='text-white'>Prüfungen durch Prop-Firms</strong>, die Regeln für Evaluierungs- und Funded-Konten unterscheiden sich je nach Firma und Kontogröße. Bewahren Sie daher eigene Kopien Ihrer Berichte auf, um sie mit den aktuellen Regeln Ihrer Firma abzugleichen.",
      ],
    },
    { type: "heading",text: "Automatisieren Sie das mit PickMyTrade" },
    { type: "paragraph",html: "Jeden Einstieg und Ausstieg von Hand zu erfassen, wird schnell lästig. <strong class='text-white'>PickMyTrade verbindet Ihre TradingView-Alerts direkt mit Ihrem Tradovate-Konto</strong>, sodass jeder Trade für Sie platziert und aufgezeichnet wird. Ihre Berichte bleiben vollständig, und Ihr Journal füllt sich von selbst, ganz ohne manuelle Klicks." },
  ], es: [
    { type: "paragraph",html: "¿Necesita obtener sus informes de cuenta de Tradovate? Quizá esté revisando ejecuciones, preparando su declaración de impuestos, alimentando un diario de trading o configurando una automatización como PickMyTrade. Sea cual sea el motivo, así se ven y se descargan los informes de rendimiento filtrados por fecha, paso a paso." },
    { type: "heading",text: "¿Qué son los informes de cuenta de Tradovate?" },
    { type: "paragraph",html: "Sus informes de cuenta son el registro integrado de todo lo que ocurre en la cuenta: cada ejecución, cada orden, cada movimiento de efectivo y su rendimiento general de trading. Los necesitará siempre que quiera comprobar el P&L de un periodo concreto, exportar datos para un diario o para su contable, o verificar una ejecución que no le cuadraba del todo." },
    { type: "heading",text: "Cómo ver los informes de cuenta de Tradovate: paso a paso" },
    {
      type: "steps",
      items: [
        { title: "Abra el panel Reports", html: "En la plataforma Tradovate, haga clic en el icono <strong class='text-white'>Reports</strong> de la barra de herramientas. También puede llegar haciendo clic en la barra de margen/saldo situada en la parte superior de la pantalla. De cualquier forma, accederá a la vista de informes de cuenta, donde se encuentran todos los tipos de informe.", image: {"src":`${IMG}/tradovate-account-reports-1.png`,"alt":"Barra de herramientas de Tradovate con el icono Reports para abrir los informes de cuenta"} },
        { title: "Elija un tipo de informe", html: "Seleccione el informe que necesita en las pestañas. Los más habituales son <strong class='text-white'>Performance</strong>, <strong class='text-white'>Fills</strong>, <strong class='text-white'>Orders</strong>, <strong class='text-white'>Position History</strong>, <strong class='text-white'>Cash History</strong> y <strong class='text-white'>Account Balance History</strong>. Elija Performance si desea un resumen del P&L, o Fills si necesita el detalle operación por operación con los costes incluidos.", image: {"src":`${IMG}/tradovate-account-reports-2.png`,"alt":"Informes de cuenta de Tradovate con las pestañas de tipo de informe, incluidas Performance y Fills"} },
        { title: "Defina su rango de fechas", html: "Elija un ajuste predefinido como <strong class='text-white'>Today</strong>, <strong class='text-white'>This Week</strong> o <strong class='text-white'>This Month</strong>, o seleccione <strong class='text-white'>Custom</strong> e introduzca sus fechas From y To. Haga clic en Go y el informe se genera para ese periodo.", image: {"src":`${IMG}/tradovate-account-reports-3.png`,"alt":"Filtro de rango de fechas de los informes de cuenta de Tradovate con los campos From y To y el botón Go"} },
        { title: "Revise el rendimiento de sus operaciones", html: "El informe Performance muestra su P&L total, el número de operaciones, la tasa de aciertos, el drawdown, el run-up y los gráficos de ganancias/pérdidas del periodo elegido. Si se desplaza hacia abajo, encontrará la lista detallada de operaciones ejecutadas, cada una con su propia entrada, salida y P&L.", image: {"src":`${IMG}/tradovate-account-reports-4.png`,"alt":"Informe Performance de Tradovate con P&L, tasa de aciertos, drawdown y lista de operaciones"} },
        { title: "Descargue el informe", html: "Utilice la opción de descarga para exportar en <strong class='text-white'>CSV</strong> (ideal para hojas de cálculo y diarios de trading) o en <strong class='text-white'>PDF</strong> (ideal para registros e impuestos). Conviene comprobar una cosa: al exportar las ejecuciones para conciliar el P&L, asegúrese de incluir las columnas de comisiones y tarifas; de lo contrario, sus cifras no coincidirán con el neto de la cuenta.", image: {"src":`${IMG}/tradovate-account-reports-5.png`,"alt":"Opciones de descarga de los informes de cuenta de Tradovate para exportar en CSV y PDF"} },
      ],
    },
    { type: "heading",text: "Para qué lo necesitará" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Registros fiscales</strong>, entregue a su contable una exportación limpia de P&L o de ejecuciones filtrada por fechas.",
        "<strong class='text-white'>Diarios de trading</strong>, importe un CSV de Fills (con las columnas de costes) en su herramienta de diario.",
        "<strong class='text-white'>Disputar una ejecución</strong>, obtenga el historial exacto de órdenes y ejecuciones de un día determinado.",
        "<strong class='text-white'>Revisión del rendimiento</strong>, siga la tasa de aciertos, el drawdown y el run-up durante cualquier periodo.",
        "<strong class='text-white'>Auditorías de prop firms</strong>, las reglas de evaluación y de cuentas fondeadas varían según la firma y el tamaño de la cuenta, así que conserve sus propias copias de los informes para contrastarlas con las reglas vigentes de su firma.",
      ],
    },
    { type: "heading",text: "Automatice esto con PickMyTrade" },
    { type: "paragraph",html: "Registrar a mano cada entrada y salida acaba cansando. <strong class='text-white'>PickMyTrade conecta sus alertas de TradingView directamente con su cuenta de Tradovate</strong>, de modo que cada operación se coloca y se registra por usted. Sus informes permanecen completos y su diario se rellena solo, sin clics manuales." },
  ], fr: [
    { type: "paragraph",html: "Vous avez besoin de vos rapports de compte Tradovate ? Peut-être vérifiez-vous des exécutions, préparez-vous votre déclaration fiscale, alimentez-vous un journal de trading ou mettez-vous en place une automatisation comme PickMyTrade. Quelle que soit la raison, voici comment afficher et télécharger des rapports de performance filtrés par date, étape par étape." },
    { type: "heading",text: "Que sont les rapports de compte Tradovate ?" },
    { type: "paragraph",html: "Vos rapports de compte constituent l'historique intégré de tout ce qui se passe sur le compte : chaque exécution, chaque ordre, chaque mouvement de trésorerie et votre performance de trading globale. Vous en aurez besoin chaque fois que vous voudrez vérifier le P&L d'une période précise, exporter des données pour un journal ou pour votre comptable, ou contrôler une exécution qui vous semblait suspecte." },
    { type: "heading",text: "Afficher les rapports de compte Tradovate : étape par étape" },
    {
      type: "steps",
      items: [
        { title: "Ouvrir le panneau Reports", html: "Dans la plateforme Tradovate, cliquez sur l'icône <strong class='text-white'>Reports</strong> de la barre d'outils. Vous pouvez aussi y accéder en cliquant sur la barre de marge/solde en haut de l'écran. Dans les deux cas, vous arrivez sur la vue des rapports de compte, où se trouvent tous les types de rapports.", image: {"src":`${IMG}/tradovate-account-reports-1.png`,"alt":"Barre d'outils Tradovate avec l'icône Reports pour ouvrir les rapports de compte"} },
        { title: "Choisir un type de rapport", html: "Sélectionnez le rapport dont vous avez besoin parmi les onglets. Les plus courants sont <strong class='text-white'>Performance</strong>, <strong class='text-white'>Fills</strong>, <strong class='text-white'>Orders</strong>, <strong class='text-white'>Position History</strong>, <strong class='text-white'>Cash History</strong> et <strong class='text-white'>Account Balance History</strong>. Choisissez Performance pour une vue d'ensemble du P&L, ou Fills lorsque vous avez besoin du détail trade par trade avec les coûts associés.", image: {"src":`${IMG}/tradovate-account-reports-2.png`,"alt":"Rapports de compte Tradovate avec les onglets de types de rapports, dont Performance et Fills"} },
        { title: "Définir votre plage de dates", html: "Choisissez un préréglage tel que <strong class='text-white'>Today</strong>, <strong class='text-white'>This Week</strong> ou <strong class='text-white'>This Month</strong>, ou sélectionnez <strong class='text-white'>Custom</strong> et saisissez vos dates From et To. Cliquez sur Go et le rapport est généré pour cette période.", image: {"src":`${IMG}/tradovate-account-reports-3.png`,"alt":"Filtre de plage de dates des rapports de compte Tradovate avec les champs From et To et le bouton Go"} },
        { title: "Examiner votre performance de trading", html: "Le rapport Performance présente votre P&L global, le nombre de trades, le taux de réussite, le drawdown, le run-up et les graphiques de gains/pertes pour la période choisie. En faisant défiler la page, vous trouverez la liste détaillée des trades exécutés, chacun avec son entrée, sa sortie et son P&L.", image: {"src":`${IMG}/tradovate-account-reports-4.png`,"alt":"Rapport Performance de Tradovate affichant le P&L, le taux de réussite, le drawdown et la liste des trades"} },
        { title: "Télécharger le rapport", html: "Utilisez l'option de téléchargement pour exporter en <strong class='text-white'>CSV</strong> (idéal pour les tableurs et les journaux de trading) ou en <strong class='text-white'>PDF</strong> (idéal pour vos archives et vos impôts). Un point mérite votre attention : lorsque vous exportez les exécutions pour rapprocher le P&L, assurez-vous que les colonnes de commissions et de frais sont incluses, sinon vos chiffres ne correspondront pas au net du compte.", image: {"src":`${IMG}/tradovate-account-reports-5.png`,"alt":"Options de téléchargement des rapports de compte Tradovate pour l'export CSV et PDF"} },
      ],
    },
    { type: "heading",text: "Pourquoi vous en avez besoin" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Documents fiscaux</strong>, remettez à votre comptable un export de P&L ou d'exécutions propre et filtré par date.",
        "<strong class='text-white'>Journaux de trading</strong>, importez un CSV Fills (avec les colonnes de coûts) dans votre outil de journal.",
        "<strong class='text-white'>Contestation d'une exécution</strong>, récupérez l'historique exact des ordres et des exécutions pour un jour donné.",
        "<strong class='text-white'>Analyse de performance</strong>, suivez le taux de réussite, le drawdown et le run-up sur n'importe quelle période.",
        "<strong class='text-white'>Audits des prop firms</strong>, les règles des comptes d'évaluation et financés varient selon la société et la taille du compte ; conservez donc vos propres copies des rapports pour les confronter aux règles actuelles de votre société.",
      ],
    },
    { type: "heading",text: "Automatisez tout cela avec PickMyTrade" },
    { type: "paragraph",html: "Consigner chaque entrée et chaque sortie à la main devient vite lassant. <strong class='text-white'>PickMyTrade relie vos alertes TradingView directement à votre compte Tradovate</strong>, de sorte que chaque trade est passé et enregistré pour vous. Vos rapports restent complets et votre journal se remplit tout seul, sans aucun clic manuel." },
  ], it: [
    { type: "paragraph",html: "Ha bisogno dei report del suo conto Tradovate? Magari sta verificando le esecuzioni, preparando la dichiarazione dei redditi, alimentando un journal di trading o configurando un'automazione come PickMyTrade. Qualunque sia il motivo, ecco come visualizzare e scaricare i report di performance filtrati per data, passo dopo passo." },
    { type: "heading",text: "Cosa sono i report del conto Tradovate?" },
    { type: "paragraph",html: "I report del conto sono il registro integrato di tutto ciò che accade nel conto: ogni esecuzione, ogni ordine, ogni movimento di liquidità e la sua performance di trading complessiva. Le serviranno ogni volta che vorrà controllare il P&L di un periodo specifico, esportare dati per un journal o per il suo commercialista, oppure verificare un'esecuzione che non la convinceva del tutto." },
    { type: "heading",text: "Visualizzare i report del conto Tradovate: passo dopo passo" },
    {
      type: "steps",
      items: [
        { title: "Aprire il pannello Reports", html: "Nella piattaforma Tradovate, clicchi sull'icona <strong class='text-white'>Reports</strong> nella barra degli strumenti. Può arrivarci anche cliccando sulla barra del margine/saldo nella parte superiore dello schermo. In entrambi i casi accede alla vista dei report del conto, dove si trovano tutti i tipi di report.", image: {"src":`${IMG}/tradovate-account-reports-1.png`,"alt":"Barra degli strumenti di Tradovate con l'icona Reports per aprire i report del conto"} },
        { title: "Scegliere un tipo di report", html: "Selezioni il report che le serve dalle schede. I più comuni sono <strong class='text-white'>Performance</strong>, <strong class='text-white'>Fills</strong>, <strong class='text-white'>Orders</strong>, <strong class='text-white'>Position History</strong>, <strong class='text-white'>Cash History</strong> e <strong class='text-white'>Account Balance History</strong>. Scelga Performance per una panoramica del P&L, oppure Fills quando le serve il dettaglio trade per trade con i costi associati.", image: {"src":`${IMG}/tradovate-account-reports-2.png`,"alt":"Report del conto Tradovate con le schede dei tipi di report, tra cui Performance e Fills"} },
        { title: "Impostare l'intervallo di date", html: "Scelga un'impostazione predefinita come <strong class='text-white'>Today</strong>, <strong class='text-white'>This Week</strong> o <strong class='text-white'>This Month</strong>, oppure selezioni <strong class='text-white'>Custom</strong> e inserisca le date From e To. Clicchi su Go e il report viene generato per quel periodo.", image: {"src":`${IMG}/tradovate-account-reports-3.png`,"alt":"Filtro dell'intervallo di date dei report del conto Tradovate con i campi From e To e il pulsante Go"} },
        { title: "Esaminare la performance di trading", html: "Il report Performance mostra il P&L complessivo, il numero di trade, la percentuale di successo, il drawdown, il run-up e i grafici di profitti/perdite per l'intervallo scelto. Scorrendo verso il basso trova l'elenco dettagliato dei trade eseguiti, ciascuno con il proprio ingresso, uscita e P&L.", image: {"src":`${IMG}/tradovate-account-reports-4.png`,"alt":"Report Performance di Tradovate con P&L, percentuale di successo, drawdown ed elenco dei trade"} },
        { title: "Scaricare il report", html: "Utilizzi l'opzione di download per esportare in <strong class='text-white'>CSV</strong> (ideale per fogli di calcolo e journal di trading) o in <strong class='text-white'>PDF</strong> (ideale per archivio e imposte). Un aspetto merita attenzione: quando esporta le esecuzioni per riconciliare il P&L, si assicuri che le colonne di commissioni e spese siano incluse, altrimenti i suoi numeri non corrisponderanno al netto del conto.", image: {"src":`${IMG}/tradovate-account-reports-5.png`,"alt":"Opzioni di download dei report del conto Tradovate per l'esportazione in CSV e PDF"} },
      ],
    },
    { type: "heading",text: "Perché Le serve" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Documenti fiscali</strong>, consegni al suo commercialista un'esportazione pulita di P&L o esecuzioni filtrata per data.",
