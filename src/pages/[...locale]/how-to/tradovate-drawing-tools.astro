---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "tradovate-drawing-tools";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/how-to/${SLUG}`;

const META_TITLE = "Use Drawing Tools on Tradovate Charts";
const META_DESCRIPTION =
  "Draw trendlines, rays, and shapes on your futures charts with simple click-to-place anchors, then edit, lock, hide, or delete any chart drawing fast.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Zeichenwerkzeuge in Tradovate-Charts verwenden", es: "Cómo usar las herramientas de dibujo en los gráficos de Tradovate", fr: "Utiliser les outils de dessin sur les graphiques Tradovate", it: "Come usare gli strumenti di disegno sui grafici Tradovate" },
  dek: { en: "Want to mark up your Tradovate charts with trendlines, rays, or a Fibonacci? Here's the full walkthrough for drawing, styling, and managing chart objects, click-to-place, not click-and-drag.", de: "Möchten Sie Ihre Tradovate-Charts mit Trendlinien, Strahlen oder einem Fibonacci markieren? Hier die komplette Anleitung zum Zeichnen, Gestalten und Verwalten von Chart-Objekten: per Klick platzieren, nicht per Klicken und Ziehen.", es: "¿Quiere marcar sus gráficos de Tradovate con líneas de tendencia, rayos o un Fibonacci? Esta es la guía completa para dibujar, dar estilo y gestionar objetos del gráfico: se colocan con un clic, no haciendo clic y arrastrando.", fr: "Vous voulez annoter vos graphiques Tradovate avec des lignes de tendance, des demi-droites ou un Fibonacci ? Voici le guide complet pour dessiner, styliser et gérer les objets du graphique : on les place par clic, pas par glisser-déposer.", it: "Vuole annotare i Suoi grafici Tradovate con trendline, semirette o un Fibonacci? Ecco la guida completa per disegnare, formattare e gestire gli oggetti del grafico: si posizionano con un clic, non trascinando." },
  readTime: { en: "5 min read", de: "5 Min. Lesezeit", es: "Lectura de 5 min", fr: "Lecture : 5 min", it: "Lettura di 5 min" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "Support, resistance, a trendline off the session low, half of reading a chart is marking it up. Tradovate's drawing tools live right on the chart, so you can sketch levels, box off a range, or drop a Fibonacci without leaving the platform. The workflow is a little different from what you might expect, though: it's click-to-place, not click-and-drag. Get that one habit right and the rest is quick. Here's the full walkthrough." },
    { type: "heading", text: "How Tradovate Drawing Tools Work" },
    { type: "paragraph", html: "Every drawing tool sits in a small toolbar attached to the chart, and each object you draw is anchored to a price and a time on the chart, so it stays put as you scroll and zoom. You've got the usual kit: trendlines and rays, horizontal and vertical lines, rectangles and zones, Fibonacci, arrows, and text. A trendline can extend as a plain line in both directions or as a ray that runs off one end. Once something's on the chart, you can restyle it, lock it so you don't nudge it by accident, or clear the whole set in one click." },
    { type: "heading", text: "Drawing on a Tradovate Chart: Step by Step" },
    {
      type: "steps",
      items: [
        { title: "Open the Drawing Toolbar", html: "Hover your cursor over the chart and the toolbars fade in along the <strong class='text-white'>upper-left</strong> corner. Click the <strong class='text-white'>Drawing Tools</strong> icon on that vertical strip, it's the drawing/pencil-style icon near the bottom of the toolbar. The tool menu pops out to the side.", image: { src: `${IMG}/tradovate-drawing-tools-1.png`, alt: "Tradovate chart with the Drawing Tools icon highlighted on the upper-left toolbar" } },
        { title: "Pick a Drawing Tool", html: "In the menu that opens, <strong class='text-white'>left-click once</strong> on the tool you want to arm it, trendline, ray, horizontal line, vertical line, rectangle, Fibonacci, arrow, or text. That's it; the tool is now active and waiting for your first click on the chart.", image: { src: `${IMG}/tradovate-drawing-tools-2.png`, alt: "Tradovate Drawing Tools menu showing trendline, ray, line, rectangle and Fibonacci options" } },
        { title: "Click to Draw on the Chart", html: "Here's the part that trips people up. <strong class='text-white'>Left-click once</strong> on the chart to drop your first anchor, move the cursor to where you want it to end, then <strong class='text-white'>left-click again</strong> to set the second anchor and finish the object. Don't click and drag to start a drawing, that pans the chart instead of placing your anchor. Two clean clicks and the line, ray, or box is down.", image: { src: `${IMG}/tradovate-drawing-tools-3.png`, alt: "Trendline being drawn on a Tradovate chart between two click anchor points" } },
        { title: "Style the Drawing in Properties", html: "Want a fatter line or a different color? <strong class='text-white'>Double-click</strong> the object (or right-click it) to open its <strong class='text-white'>Properties</strong> window. From there you can change color, thickness, line style, and how far the object extends; for zones and rectangles you can dial in opacity too. If you like a look, flip on <strong class='text-white'>Save As Default</strong> so the next drawing of that type inherits the same settings.", image: { src: `${IMG}/tradovate-drawing-tools-4.png`, alt: "Tradovate drawing Properties window with color, thickness and line style settings" } },
        { title: "Move, Lock, Hide, or Delete Drawings", html: "To reshape an object, click it and drag one of its anchor points; to move the whole thing, drag its body. When your chart's the way you want it, jump back into the <strong class='text-white'>Drawing Tools</strong> menu and use <strong class='text-white'>Lock Drawings</strong> so you can't shove them around by mistake, or <strong class='text-white'>Hide Drawings</strong> to tuck them away without deleting anything. Need a clean slate? <strong class='text-white'>Remove All Drawings</strong> sits at the bottom of that menu. To delete a single object, open its Properties and click <strong class='text-white'>Remove</strong>.", image: { src: `${IMG}/tradovate-drawing-tools-5.png`, alt: "Tradovate Drawing Tools menu showing Lock Drawings, Hide Drawings and Remove All Drawings" } },
      ],
    },
    { type: "quote", html: "<strong class='text-white'>Ruler trick:</strong> hold <strong class='text-white'>Shift</strong> while you draw and Tradovate shows the plot details at each anchor, price on the Y-axis, timestamp on the X-axis, and the delta between points. It turns a plain line or rectangle into a quick measuring tool." },
    { type: "heading", text: "Why This Matters" },
    {
      type: "list",
      items: [
        "Mark your key levels once and trade off them all session without re-drawing.",
        "Use rays and trendlines to project a slope forward as price develops.",
        "Box off supply and demand zones so your bias is obvious at a glance.",
        "Lock the important stuff so a stray click doesn't wreck your levels.",
        "Measure a move fast with the Shift-key ruler before you commit to a trade.",
      ],
    },
    { type: "heading", text: "Take the Trade Off the Chart with PickMyTrade" },
    { type: "paragraph", html: "Drawing the level is the planning. The hard part is acting on it the instant price gets there. <strong class='text-white'>PickMyTrade takes your TradingView alerts and fires them into your Tradovate account as live orders automatically</strong>, so the setup you mapped on the chart becomes a real trade without you racing to click." },
  ], de: [
    { type: "paragraph",html: "Unterstützung, Widerstand, eine Trendlinie vom Session-Tief: Die Hälfte der Chartanalyse besteht darin, ihn zu markieren. Die Zeichenwerkzeuge von Tradovate befinden sich direkt im Chart, sodass Sie Levels skizzieren, eine Range einrahmen oder ein Fibonacci setzen können, ohne die Plattform zu verlassen. Der Ablauf unterscheidet sich allerdings etwas von dem, was Sie vielleicht erwarten: Es wird per Klick platziert, nicht per Klicken und Ziehen. Haben Sie diese eine Gewohnheit im Griff, geht der Rest schnell. Hier die komplette Anleitung." },
    { type: "heading",text: "So funktionieren die Zeichenwerkzeuge von Tradovate" },
    { type: "paragraph",html: "Jedes Zeichenwerkzeug befindet sich in einer kleinen Symbolleiste am Chart, und jedes gezeichnete Objekt ist an einen Preis und eine Zeit im Chart gebunden, sodass es beim Scrollen und Zoomen an Ort und Stelle bleibt. Sie haben das übliche Repertoire: Trendlinien und Strahlen, horizontale und vertikale Linien, Rechtecke und Zonen, Fibonacci, Pfeile und Text. Eine Trendlinie kann als einfache Linie in beide Richtungen oder als Strahl verlaufen, der an einem Ende ins Unendliche läuft. Sobald etwas im Chart liegt, können Sie es neu gestalten, sperren, damit Sie es nicht versehentlich verschieben, oder den gesamten Satz mit einem Klick löschen." },
    { type: "heading",text: "Im Tradovate-Chart zeichnen: Schritt für Schritt" },
    {
      type: "steps",
      items: [
        { title: "Die Zeichenwerkzeug-Leiste öffnen", html: "Bewegen Sie den Mauszeiger über den Chart, und die Symbolleisten blenden sich entlang der <strong class='text-white'>oberen linken</strong> Ecke ein. Klicken Sie in dieser vertikalen Leiste auf das Symbol <strong class='text-white'>Drawing Tools</strong>: Es ist das Zeichen-/Stiftsymbol im unteren Bereich der Leiste. Das Werkzeugmenü klappt zur Seite auf.", image: {"src":`${IMG}/tradovate-drawing-tools-1.png`,"alt":"Tradovate-Chart mit hervorgehobenem Drawing-Tools-Symbol in der oberen linken Symbolleiste"} },
        { title: "Ein Zeichenwerkzeug auswählen", html: "Klicken Sie im geöffneten Menü <strong class='text-white'>einmal mit links</strong> auf das gewünschte Werkzeug, um es zu aktivieren: Trendlinie, Strahl, horizontale Linie, vertikale Linie, Rechteck, Fibonacci, Pfeil oder Text. Das war's schon; das Werkzeug ist jetzt aktiv und wartet auf Ihren ersten Klick im Chart.", image: {"src":`${IMG}/tradovate-drawing-tools-2.png`,"alt":"Tradovate-Menü Drawing Tools mit den Optionen Trendlinie, Strahl, Linie, Rechteck und Fibonacci"} },
        { title: "Per Klick im Chart zeichnen", html: "Jetzt kommt der Teil, über den viele stolpern. <strong class='text-white'>Klicken Sie einmal mit links</strong> in den Chart, um den ersten Ankerpunkt zu setzen, bewegen Sie den Mauszeiger an die Stelle, an der das Objekt enden soll, und <strong class='text-white'>klicken Sie erneut mit links</strong>, um den zweiten Ankerpunkt zu setzen und das Objekt abzuschließen. Beginnen Sie eine Zeichnung nicht mit Klicken und Ziehen, denn das verschiebt den Chart, statt Ihren Ankerpunkt zu setzen. Zwei saubere Klicks, und die Linie, der Strahl oder das Rechteck steht.", image: {"src":`${IMG}/tradovate-drawing-tools-3.png`,"alt":"Trendlinie, die in einem Tradovate-Chart zwischen zwei angeklickten Ankerpunkten gezeichnet wird"} },
        { title: "Die Zeichnung in den Properties gestalten", html: "Sie möchten eine dickere Linie oder eine andere Farbe? <strong class='text-white'>Doppelklicken</strong> Sie auf das Objekt (oder klicken Sie mit rechts darauf), um das Fenster <strong class='text-white'>Properties</strong> zu öffnen. Dort können Sie Farbe, Stärke, Linienstil und die Ausdehnung des Objekts ändern; bei Zonen und Rechtecken lässt sich auch die Deckkraft einstellen. Gefällt Ihnen eine Darstellung, aktivieren Sie <strong class='text-white'>Save As Default</strong>, damit die nächste Zeichnung dieses Typs dieselben Einstellungen übernimmt.", image: {"src":`${IMG}/tradovate-drawing-tools-4.png`,"alt":"Tradovate-Fenster Properties einer Zeichnung mit Einstellungen für Farbe, Stärke und Linienstil"} },
        { title: "Zeichnungen verschieben, sperren, ausblenden oder löschen", html: "Um ein Objekt umzuformen, klicken Sie darauf und ziehen Sie einen seiner Ankerpunkte; um das gesamte Objekt zu verschieben, ziehen Sie an seinem Körper. Sieht Ihr Chart so aus, wie Sie ihn möchten, öffnen Sie wieder das Menü <strong class='text-white'>Drawing Tools</strong> und verwenden Sie <strong class='text-white'>Lock Drawings</strong>, damit Sie sie nicht versehentlich verschieben, oder <strong class='text-white'>Hide Drawings</strong>, um sie auszublenden, ohne etwas zu löschen. Brauchen Sie einen sauberen Neustart? <strong class='text-white'>Remove All Drawings</strong> steht am unteren Ende dieses Menüs. Um ein einzelnes Objekt zu löschen, öffnen Sie dessen Properties und klicken Sie auf <strong class='text-white'>Remove</strong>.", image: {"src":`${IMG}/tradovate-drawing-tools-5.png`,"alt":"Tradovate-Menü Drawing Tools mit Lock Drawings, Hide Drawings und Remove All Drawings"} },
      ],
    },
    { type: "quote",html: "<strong class='text-white'>Lineal-Trick:</strong> Halten Sie beim Zeichnen die Taste <strong class='text-white'>Shift</strong> gedrückt, und Tradovate zeigt an jedem Ankerpunkt die Plotdetails an: den Preis auf der Y-Achse, den Zeitstempel auf der X-Achse und das Delta zwischen den Punkten. So wird aus einer einfachen Linie oder einem Rechteck ein schnelles Messwerkzeug." },
    { type: "heading",text: "Warum das wichtig ist" },
    {
      type: "list",
      items: [
        "Markieren Sie Ihre wichtigen Levels einmal und handeln Sie die ganze Session danach, ohne neu zu zeichnen.",
        "Nutzen Sie Strahlen und Trendlinien, um eine Steigung nach vorn zu projizieren, während sich der Kurs entwickelt.",
        "Rahmen Sie Angebots- und Nachfragezonen ein, damit Ihre Tendenz auf einen Blick klar ist.",
        "Sperren Sie das Wichtige, damit ein versehentlicher Klick Ihre Levels nicht ruiniert.",
        "Messen Sie eine Bewegung schnell mit dem Shift-Tasten-Lineal, bevor Sie sich auf einen Trade festlegen.",
      ],
    },
    { type: "heading",text: "Den Trade direkt vom Chart mit PickMyTrade ausführen" },
    { type: "paragraph",html: "Das Zeichnen des Levels ist die Planung. Schwierig ist es, im selben Moment zu handeln, in dem der Kurs dort ankommt. <strong class='text-white'>PickMyTrade nimmt Ihre TradingView-Alerts und leitet sie automatisch als Live-Orders an Ihr Tradovate-Konto weiter</strong>, sodass das im Chart eingezeichnete Setup zu einem echten Trade wird, ohne dass Sie hektisch klicken müssen." },
  ], es: [
    { type: "paragraph",html: "Soporte, resistencia, una línea de tendencia desde el mínimo de la sesión: la mitad de leer un gráfico consiste en marcarlo. Las herramientas de dibujo de Tradovate están integradas en el gráfico, así que puede trazar niveles, enmarcar un rango o colocar un Fibonacci sin salir de la plataforma. El flujo de trabajo es algo distinto de lo que podría esperar: se coloca con un clic, no haciendo clic y arrastrando. Si domina ese hábito, el resto es rápido. Esta es la guía completa." },
    { type: "heading",text: "Cómo funcionan las herramientas de dibujo de Tradovate" },
    { type: "paragraph",html: "Cada herramienta de dibujo se encuentra en una pequeña barra de herramientas adjunta al gráfico, y cada objeto que dibuja queda anclado a un precio y a un momento del gráfico, por lo que se mantiene en su sitio al desplazarse y hacer zoom. Dispone del kit habitual: líneas de tendencia y rayos, líneas horizontales y verticales, rectángulos y zonas, Fibonacci, flechas y texto. Una línea de tendencia puede extenderse como una línea simple en ambas direcciones o como un rayo que sigue indefinidamente por un extremo. Una vez que algo está en el gráfico, puede cambiarle el estilo, bloquearlo para no moverlo por accidente o borrar todo el conjunto con un clic." },
    { type: "heading",text: "Dibujar en un gráfico de Tradovate: paso a paso" },
    {
      type: "steps",
      items: [
        { title: "Abra la barra de dibujo", html: "Coloque el cursor sobre el gráfico y las barras de herramientas aparecerán gradualmente a lo largo de la esquina <strong class='text-white'>superior izquierda</strong>. Haga clic en el icono <strong class='text-white'>Drawing Tools</strong> de esa franja vertical: es el icono de estilo dibujo/lápiz, cerca de la parte inferior de la barra. El menú de herramientas se despliega hacia un lado.", image: {"src":`${IMG}/tradovate-drawing-tools-1.png`,"alt":"Gráfico de Tradovate con el icono Drawing Tools resaltado en la barra de herramientas superior izquierda"} },
        { title: "Elija una herramienta de dibujo", html: "En el menú que se abre, haga <strong class='text-white'>un solo clic izquierdo</strong> en la herramienta que desee para activarla: línea de tendencia, rayo, línea horizontal, línea vertical, rectángulo, Fibonacci, flecha o texto. Eso es todo; la herramienta ya está activa y espera su primer clic en el gráfico.", image: {"src":`${IMG}/tradovate-drawing-tools-2.png`,"alt":"Menú Drawing Tools de Tradovate con las opciones de línea de tendencia, rayo, línea, rectángulo y Fibonacci"} },
        { title: "Haga clic para dibujar en el gráfico", html: "Esta es la parte que desconcierta a mucha gente. Haga <strong class='text-white'>un clic izquierdo</strong> en el gráfico para colocar el primer ancla, mueva el cursor hasta donde quiera que termine y haga <strong class='text-white'>otro clic izquierdo</strong> para fijar la segunda ancla y terminar el objeto. No empiece un dibujo con clic y arrastre, porque eso desplaza el gráfico en lugar de colocar su ancla. Con dos clics limpios queda la línea, el rayo o el recuadro.", image: {"src":`${IMG}/tradovate-drawing-tools-3.png`,"alt":"Línea de tendencia dibujándose en un gráfico de Tradovate entre dos puntos de ancla marcados con clic"} },
        { title: "Dé estilo al dibujo en Properties", html: "¿Quiere una línea más gruesa o un color distinto? Haga <strong class='text-white'>doble clic</strong> en el objeto (o clic derecho sobre él) para abrir su ventana <strong class='text-white'>Properties</strong>. Desde allí puede cambiar el color, el grosor, el estilo de línea y hasta dónde se extiende el objeto; en zonas y rectángulos también puede ajustar la opacidad. Si le gusta un aspecto, active <strong class='text-white'>Save As Default</strong> para que el siguiente dibujo de ese tipo herede los mismos ajustes.", image: {"src":`${IMG}/tradovate-drawing-tools-4.png`,"alt":"Ventana Properties de un dibujo de Tradovate con ajustes de color, grosor y estilo de línea"} },
        { title: "Mueva, bloquee, oculte o elimine dibujos", html: "Para remodelar un objeto, haga clic en él y arrastre uno de sus puntos de ancla; para mover el objeto completo, arrastre su cuerpo. Cuando su gráfico esté como desea, vuelva al menú <strong class='text-white'>Drawing Tools</strong> y use <strong class='text-white'>Lock Drawings</strong> para no moverlos por error, o <strong class='text-white'>Hide Drawings</strong> para ocultarlos sin borrar nada. ¿Necesita empezar de cero? <strong class='text-white'>Remove All Drawings</strong> está al final de ese menú. Para eliminar un solo objeto, abra sus Properties y haga clic en <strong class='text-white'>Remove</strong>.", image: {"src":`${IMG}/tradovate-drawing-tools-5.png`,"alt":"Menú Drawing Tools de Tradovate con Lock Drawings, Hide Drawings y Remove All Drawings"} },
      ],
    },
    { type: "quote",html: "<strong class='text-white'>Truco de la regla:</strong> mantenga pulsada la tecla <strong class='text-white'>Shift</strong> mientras dibuja y Tradovate muestra los detalles del trazado en cada ancla: el precio en el eje Y, la marca de tiempo en el eje X y la diferencia entre puntos. Convierte una simple línea o un rectángulo en una herramienta de medición rápida." },
    { type: "heading",text: "Por qué es importante" },
    {
      type: "list",
      items: [
        "Marque sus niveles clave una vez y opere con ellos durante toda la sesión sin volver a dibujar.",
        "Use rayos y líneas de tendencia para proyectar una pendiente hacia adelante a medida que evoluciona el precio.",
        "Enmarque las zonas de oferta y demanda para que su sesgo sea evidente de un vistazo.",
        "Bloquee lo importante para que un clic perdido no arruine sus niveles.",
        "Mida un movimiento rápidamente con la regla de la tecla Shift antes de comprometerse con una operación.",
      ],
    },
    { type: "heading",text: "Lleve la operación del gráfico a la realidad con PickMyTrade" },
    { type: "paragraph",html: "Dibujar el nivel es la planificación. Lo difícil es actuar en el instante en que el precio llega allí. <strong class='text-white'>PickMyTrade toma sus alertas de TradingView y las envía automáticamente a su cuenta de Tradovate como órdenes reales</strong>, de modo que el setup que marcó en el gráfico se convierte en una operación real sin que tenga que correr a hacer clic." },
  ], fr: [
    { type: "paragraph",html: "Support, résistance, une ligne de tendance partant du plus bas de la séance : lire un graphique, c'est pour moitié l'annoter. Les outils de dessin de Tradovate sont directement intégrés au graphique, ce qui vous permet de tracer des niveaux, d'encadrer une zone de range ou de poser un Fibonacci sans quitter la plateforme. Le fonctionnement est toutefois un peu différent de ce à quoi vous pourriez vous attendre : on place par clic, pas par glisser-déposer. Maîtrisez cette habitude, et le reste va vite. Voici le guide complet." },
    { type: "heading",text: "Comment fonctionnent les outils de dessin de Tradovate" },
    { type: "paragraph",html: "Chaque outil de dessin se trouve dans une petite barre d'outils rattachée au graphique, et chaque objet que vous dessinez est ancré à un prix et à une heure du graphique, de sorte qu'il reste en place lorsque vous faites défiler ou zoomez. Vous disposez de la panoplie habituelle : lignes de tendance et demi-droites, lignes horizontales et verticales, rectangles et zones, Fibonacci, flèches et texte. Une ligne de tendance peut s'étendre comme une simple ligne dans les deux directions ou comme une demi-droite qui file à l'infini d'un côté. Une fois un objet sur le graphique, vous pouvez le restyliser, le verrouiller pour ne pas le déplacer par erreur, ou effacer tout l'ensemble en un clic." },
    { type: "heading",text: "Dessiner sur un graphique Tradovate : pas à pas" },
    {
      type: "steps",
      items: [
        { title: "Ouvrir la barre de dessin", html: "Passez le curseur sur le graphique et les barres d'outils apparaissent progressivement le long du coin <strong class='text-white'>supérieur gauche</strong>. Cliquez sur l'icône <strong class='text-white'>Drawing Tools</strong> de cette bande verticale : c'est l'icône de type dessin/crayon, vers le bas de la barre. Le menu des outils s'affiche sur le côté.", image: {"src":`${IMG}/tradovate-drawing-tools-1.png`,"alt":"Graphique Tradovate avec l'icône Drawing Tools mise en évidence dans la barre d'outils supérieure gauche"} },
        { title: "Choisir un outil de dessin", html: "Dans le menu qui s'ouvre, faites <strong class='text-white'>un seul clic gauche</strong> sur l'outil voulu pour l'activer : ligne de tendance, demi-droite, ligne horizontale, ligne verticale, rectangle, Fibonacci, flèche ou texte. C'est tout ; l'outil est désormais actif et attend votre premier clic sur le graphique.", image: {"src":`${IMG}/tradovate-drawing-tools-2.png`,"alt":"Menu Drawing Tools de Tradovate affichant les options ligne de tendance, demi-droite, ligne, rectangle et Fibonacci"} },
        { title: "Cliquer pour dessiner sur le graphique", html: "Voici le point qui piège beaucoup de monde. Faites <strong class='text-white'>un clic gauche</strong> sur le graphique pour poser votre première ancre, déplacez le curseur jusqu'à l'endroit où vous voulez terminer, puis faites <strong class='text-white'>un nouveau clic gauche</strong> pour définir la seconde ancre et terminer l'objet. Ne commencez pas un dessin par un clic suivi d'un glissement : cela déplace le graphique au lieu de placer votre ancre. Deux clics nets, et la ligne, la demi-droite ou le rectangle est en place.", image: {"src":`${IMG}/tradovate-drawing-tools-3.png`,"alt":"Ligne de tendance en cours de tracé sur un graphique Tradovate entre deux points d'ancrage cliqués"} },
        { title: "Styliser le dessin dans Properties", html: "Vous voulez une ligne plus épaisse ou une autre couleur ? <strong class='text-white'>Double-cliquez</strong> sur l'objet (ou faites un clic droit dessus) pour ouvrir sa fenêtre <strong class='text-white'>Properties</strong>. Vous pouvez y modifier la couleur, l'épaisseur, le style de ligne et la distance sur laquelle l'objet s'étend ; pour les zones et les rectangles, vous pouvez aussi régler l'opacité. Si un rendu vous plaît, activez <strong class='text-white'>Save As Default</strong> pour que le prochain dessin de ce type hérite des mêmes réglages.", image: {"src":`${IMG}/tradovate-drawing-tools-4.png`,"alt":"Fenêtre Properties d'un dessin Tradovate avec les réglages de couleur, d'épaisseur et de style de ligne"} },
        { title: "Déplacer, verrouiller, masquer ou supprimer des dessins", html: "Pour remodeler un objet, cliquez dessus et faites glisser l'un de ses points d'ancrage ; pour déplacer l'ensemble, faites glisser son corps. Quand votre graphique est comme vous le souhaitez, retournez dans le menu <strong class='text-white'>Drawing Tools</strong> et utilisez <strong class='text-white'>Lock Drawings</strong> pour ne pas les bousculer par erreur, ou <strong class='text-white'>Hide Drawings</strong> pour les masquer sans rien supprimer. Besoin de repartir de zéro ? <strong class='text-white'>Remove All Drawings</strong> se trouve en bas de ce menu. Pour supprimer un seul objet, ouvrez ses Properties et cliquez sur <strong class='text-white'>Remove</strong>.", image: {"src":`${IMG}/tradovate-drawing-tools-5.png`,"alt":"Menu Drawing Tools de Tradovate affichant Lock Drawings, Hide Drawings et Remove All Drawings"} },
      ],
    },
    { type: "quote",html: "<strong class='text-white'>L'astuce de la règle :</strong> maintenez la touche <strong class='text-white'>Shift</strong> enfoncée pendant que vous dessinez et Tradovate affiche les détails du tracé à chaque ancre : le prix sur l'axe Y, l'horodatage sur l'axe X et l'écart entre les points. Cela transforme une simple ligne ou un rectangle en un outil de mesure rapide." },
    { type: "heading",text: "Pourquoi c'est important" },
    {
      type: "list",
      items: [
        "Marquez vos niveaux clés une fois et tradez à partir d'eux toute la séance sans redessiner.",
        "Utilisez des demi-droites et des lignes de tendance pour projeter une pente vers l'avant à mesure que le prix évolue.",
        "Encadrez les zones d'offre et de demande pour que votre biais soit évident d'un coup d'œil.",
        "Verrouillez l'essentiel pour qu'un clic accidentel ne ruine pas vos niveaux.",
        "Mesurez un mouvement rapidement avec la règle de la touche Shift avant de vous engager dans un trade.",
      ],
    },
    { type: "heading",text: "Passez du graphique au trade avec PickMyTrade" },
    { type: "paragraph",html: "Dessiner le niveau, c'est la planification. Le plus difficile est d'agir à l'instant où le prix y arrive. <strong class='text-white'>PickMyTrade prend vos alertes TradingView et les envoie automatiquement sur votre compte Tradovate sous forme d'ordres réels</strong>, de sorte que le setup repéré sur le graphique devienne un vrai trade sans que vous ayez à vous précipiter pour cliquer." },
  ], it: [
    { type: "paragraph",html: "Supporto, resistenza, una trendline dal minimo di sessione: metà della lettura di un grafico consiste nel segnarlo. Gli strumenti di disegno di Tradovate si trovano direttamente sul grafico, quindi può abbozzare livelli, racchiudere un range o inserire un Fibonacci senza uscire dalla piattaforma. Il flusso di lavoro è però un po' diverso da quello che potrebbe aspettarsi: si posiziona con un clic, non trascinando. Acquisita questa abitudine, il resto è rapido. Ecco la guida completa." },
    { type: "heading",text: "Come funzionano gli strumenti di disegno di Tradovate" },
    { type: "paragraph",html: "Ogni strumento di disegno si trova in una piccola barra degli strumenti collegata al grafico, e ogni oggetto che disegna è ancorato a un prezzo e a un orario del grafico, quindi resta al suo posto mentre scorre e zooma. Ha a disposizione il kit abituale: trendline e semirette, linee orizzontali e verticali, rettangoli e zone, Fibonacci, frecce e testo. Una trendline può estendersi come una semplice linea in entrambe le direzioni o come una semiretta che prosegue da un lato. Una volta che qualcosa è sul grafico, può cambiarne lo stile, bloccarlo per non spostarlo per errore o cancellare l'intero set con un clic." },
    { type: "heading",text: "Disegnare su un grafico Tradovate: passo dopo passo" },
    {
      type: "steps",
      items: [
        { title: "Apra la barra di disegno", html: "Passi il cursore sul grafico e le barre degli strumenti compaiono in dissolvenza lungo l'angolo <strong class='text-white'>in alto a sinistra</strong>. Clicchi sull'icona <strong class='text-white'>Drawing Tools</strong> di quella striscia verticale: è l'icona in stile disegno/matita, vicino alla parte inferiore della barra. Il menu degli strumenti si apre di lato.", image: {"src":`${IMG}/tradovate-drawing-tools-1.png`,"alt":"Grafico Tradovate con l'icona Drawing Tools evidenziata nella barra degli strumenti in alto a sinistra"} },
        { title: "Scelga uno strumento di disegno", html: "Nel menu che si apre, faccia <strong class='text-white'>un solo clic sinistro</strong> sullo strumento desiderato per attivarlo: trendline, semiretta, linea orizzontale, linea verticale, rettangolo, Fibonacci, freccia o testo. Tutto qui; lo strumento è ora attivo e attende il Suo primo clic sul grafico.", image: {"src":`${IMG}/tradovate-drawing-tools-2.png`,"alt":"Menu Drawing Tools di Tradovate con le opzioni trendline, semiretta, linea, rettangolo e Fibonacci"} },
        { title: "Clicchi per disegnare sul grafico", html: "Questa è la parte che mette in difficoltà molti. Faccia <strong class='text-white'>un clic sinistro</strong> sul grafico per posizionare il primo ancoraggio, sposti il cursore dove vuole che termini, poi faccia <strong class='text-white'>un altro clic sinistro</strong> per fissare il secondo ancoraggio e completare l'oggetto. Non inizi un disegno con clic e trascinamento: così sposta il grafico invece di posizionare il Suo ancoraggio. Due clic netti e la linea, la semiretta o il riquadro è posizionato.", image: {"src":`${IMG}/tradovate-drawing-tools-3.png`,"alt":"Trendline in fase di disegno su un grafico Tradovate tra due punti di ancoraggio cliccati"} },
        { title: "Formatti il disegno in Properties", html: "Vuole una linea più spessa o un colore diverso? Faccia <strong class='text-white'>doppio clic</strong> sull'oggetto (oppure clic destro) per aprire la sua finestra <strong class='text-white'>Properties</strong>. Da lì può cambiare colore, spessore, stile della linea e fin dove si estende l'oggetto; per zone e rettangoli può regolare anche l'opacità. Se Le piace un aspetto, attivi <strong class='text-white'>Save As Default</strong> in modo che il disegno successivo di quel tipo erediti le stesse impostazioni.", image: {"src":`${IMG}/tradovate-drawing-tools-4.png`,"alt":"Finestra Properties di un disegno Tradovate con le impostazioni di colore, spessore e stile della linea"} },
        { title: "Sposti, blocchi, nasconda o elimini i disegni", html: "Per rimodellare un oggetto, ci clicchi sopra e trascini uno dei suoi punti di ancoraggio; per spostarlo per intero, trascini il suo corpo. Quando il grafico è come desidera, torni nel menu <strong class='text-white'>Drawing Tools</strong> e usi <strong class='text-white'>Lock Drawings</strong> per non spostarli per sbaglio, oppure <strong class='text-white'>Hide Drawings</strong> per nasconderli senza eliminare nulla. Le serve una lavagna pulita? <strong class='text-white'>Remove All Drawings</strong> si trova in fondo a quel menu. Per eliminare un solo oggetto, apra le sue Properties e clicchi su <strong class='text-white'>Remove</strong>.", image: {"src":`${IMG}/tradovate-drawing-tools-5.png`,"alt":"Menu Drawing Tools di Tradovate con Lock Drawings, Hide Drawings e Remove All Drawings"} },
      ],
    },
    { type: "quote",html: "<strong class='text-white'>Il trucco del righello:</strong> tenga premuto <strong class='text-white'>Shift</strong> mentre disegna e Tradovate mostra i dettagli del tracciato a ogni ancoraggio: il prezzo sull'asse Y, il timestamp sull'asse X e la differenza tra i punti. Trasforma una semplice linea o un rettangolo in un rapido strumento di misura." },
    { type: "heading",text: "Perché è importante" },
    {
      type: "list",
      items: [
        "Segni i Suoi livelli chiave una volta sola e operi su di essi per tutta la sessione senza ridisegnare.",
        "Usi semirette e trendline per proiettare una pendenza in avanti man mano che il prezzo si sviluppa.",
        "Racchiuda le zone di offerta e domanda in riquadri, così il Suo bias è evidente a colpo d'occhio.",
        "Blocchi ciò che è importante, così un clic accidentale non rovina i Suoi livelli.",
        "Misuri un movimento rapidamente con il righello del tasto Shift prima di impegnarsi in un trade.",
      ],
    },
    { type: "heading",text: "Porti il trade dal grafico alla realtà con PickMyTrade" },
    { type: "paragraph",html: "Disegnare il livello è la pianificazione. La parte difficile è agire nell'istante in cui il prezzo ci arriva. <strong class='text-white'>PickMyTrade prende i Suoi alert di TradingView e li invia automaticamente al Suo conto Tradovate come ordini reali</strong>, così il setup che ha tracciato sul grafico diventa un trade vero senza che debba affannarsi a cliccare." },
  ] },
  ctaHeading: { en: "Turn Your Chart Levels Into Trades", de: "Machen Sie aus Ihren Chart-Levels Trades", es: "Convierta los niveles de su gráfico en operaciones", fr: "Transformez vos niveaux de graphique en trades", it: "Trasformi i livelli del grafico in trade" },
  ctaText: { en: "PickMyTrade fires your TradingView alerts into Tradovate as live orders automatically, so the setup you mapped on the chart becomes a real trade without you racing to click.", de: "PickMyTrade leitet Ihre TradingView-Alerts automatisch als Live-Orders an Tradovate weiter, sodass das im Chart eingezeichnete Setup zu einem echten Trade wird, ohne dass Sie hektisch klicken müssen.", es: "PickMyTrade envía automáticamente sus alertas de TradingView a Tradovate como órdenes reales, de modo que el setup que marcó en el gráfico se convierte en una operación real sin que tenga que correr a hacer clic.", fr: "PickMyTrade envoie automatiquement vos alertes TradingView vers Tradovate sous forme d'ordres réels, de sorte que le setup repéré sur le graphique devienne un vrai trade sans que vous ayez à vous précipiter pour cliquer.", it: "PickMyTrade invia automaticamente i Suoi alert di TradingView a Tradovate come ordini reali, così il setup che ha tracciato sul grafico diventa un trade vero senza che debba affannarsi a cliccare." },
  ctaButtonText: { en: "Start Your Free 7-Day Trial", de: "Starten Sie Ihre kostenlose 7-Tage-Testphase", es: "Comience su prueba gratuita de 7 días", fr: "Commencez votre essai gratuit de 7 jours", it: "Inizi la Sua prova gratuita di 7 giorni" },
  ctaUrl: "https://app.pickmytrade.trade/?register=true&utm_source=content&utm_medium=how-to",
  faqHeading: { en: "Frequently Asked Questions", de: "Häufig gestellte Fragen", es: "Preguntas frecuentes", fr: "Questions fréquentes", it: "Domande frequenti" },
  faqs: { en: [
    { q: "Why is my drawing moving the chart instead of appearing?", a: "You're click-and-dragging to start. Tradovate reads a drag as a pan. Left-click once to place the first anchor, then left-click again for the second, single clicks, not a drag." },
    { q: "How do I delete just one drawing without clearing the chart?", a: "Double-click the object to open its Properties window and click Remove. That removes only that object. Remove All Drawings in the Drawing Tools menu is the nuclear option that clears everything." },
    { q: "My drawings disappeared or won't stay on the chart, what happened?", a: "Drawings anchor to a specific date and timeframe, so scrolling far from where you drew, or switching devices or intervals, can make them look gone." },
  ], de: [
    { q: "Warum verschiebt sich der Chart, statt dass meine Zeichnung erscheint?", a: "Sie beginnen mit Klicken und Ziehen. Tradovate wertet ein Ziehen als Verschieben des Charts. Klicken Sie einmal mit links, um den ersten Ankerpunkt zu setzen, und dann erneut mit links für den zweiten, also einzelne Klicks, kein Ziehen." },
    { q: "Wie lösche ich nur eine Zeichnung, ohne den Chart zu leeren?", a: "Doppelklicken Sie auf das Objekt, um sein Fenster Properties zu öffnen, und klicken Sie auf Remove. Dadurch wird nur dieses Objekt entfernt. Remove All Drawings im Menü Drawing Tools ist die Radikallösung, die alles löscht." },
    { q: "Meine Zeichnungen sind verschwunden oder bleiben nicht im Chart, was ist passiert?", a: "Zeichnungen sind an ein bestimmtes Datum und einen bestimmten Zeitrahmen gebunden. Wenn Sie weit von der Stelle wegscrollen, an der Sie gezeichnet haben, oder das Gerät bzw. das Intervall wechseln, können sie daher verschwunden wirken." },
  ], es: [
    { q: "¿Por qué mi dibujo mueve el gráfico en lugar de aparecer?", a: "Está empezando con clic y arrastre. Tradovate interpreta un arrastre como un desplazamiento del gráfico. Haga un clic izquierdo para colocar el primer ancla y otro clic izquierdo para el segundo: clics sencillos, no un arrastre." },
    { q: "¿Cómo elimino un solo dibujo sin borrar todo el gráfico?", a: "Haga doble clic en el objeto para abrir su ventana Properties y pulse Remove. Eso elimina solo ese objeto. Remove All Drawings, en el menú Drawing Tools, es la opción drástica que borra todo." },
    { q: "Mis dibujos han desaparecido o no se mantienen en el gráfico, ¿qué ha pasado?", a: "Los dibujos se anclan a una fecha y un marco temporal concretos, así que si se desplaza lejos de donde dibujó, o cambia de dispositivo o de intervalo, pueden parecer desaparecidos." },
  ], fr: [
    { q: "Pourquoi mon dessin déplace-t-il le graphique au lieu d'apparaître ?", a: "Vous commencez par un clic suivi d'un glissement. Tradovate interprète un glissement comme un déplacement du graphique. Faites un clic gauche pour placer la première ancre, puis un autre clic gauche pour la seconde : des clics simples, pas un glissement." },
    { q: "Comment supprimer un seul dessin sans vider le graphique ?", a: "Double-cliquez sur l'objet pour ouvrir sa fenêtre Properties, puis cliquez sur Remove. Cela supprime uniquement cet objet. Remove All Drawings, dans le menu Drawing Tools, est l'option radicale qui efface tout." },
    { q: "Mes dessins ont disparu ou ne restent pas sur le graphique, que s'est-il passé ?", a: "Les dessins sont ancrés à une date et à une unité de temps précises ; si vous vous éloignez beaucoup de l'endroit où vous avez dessiné, ou si vous changez d'appareil ou d'intervalle, ils peuvent sembler avoir disparu." },
  ], it: [
    { q: "Perché il mio disegno sposta il grafico invece di comparire?", a: "Sta iniziando con un clic e trascinamento. Tradovate interpreta il trascinamento come uno spostamento del grafico. Faccia un clic sinistro per posizionare il primo punto di ancoraggio e un altro clic sinistro per il secondo: clic singoli, non un trascinamento." },
    { q: "Come elimino un solo disegno senza svuotare il grafico?", a: "Faccia doppio clic sull'oggetto per aprire la sua finestra Properties e clicchi su Remove. In questo modo viene rimosso solo quell'oggetto. Remove All Drawings, nel menu Drawing Tools, è l'opzione drastica che cancella tutto." },
    { q: "I miei disegni sono scomparsi o non restano sul grafico, che cosa è successo?", a: "I disegni sono ancorati a una data e a un timeframe specifici, quindi se scorre molto lontano da dove ha disegnato, oppure cambia dispositivo o intervallo, possono sembrare spariti." },
  ] },
  relatedHeading: { en: "Related Guides", de: "Weiterführende Anleitungen", es: "Guías relacionadas", fr: "Guides associés", it: "Guide correlate" },
  disclosureText: { en: `This guide is for educational and informational purposes only and is not financial, investment, or trading advice. Trading futures and other leveraged products carries a substantial risk of loss and is not suitable for every investor. PickMyTrade is an independent third-party automation platform and is not affiliated with, endorsed by, or sponsored by Tradovate, Inc. "Tradovate" and all related names, logos, and trademarks are the property of their respective owners. Platform features and steps change over time, so always confirm the current process in the official Tradovate platform and documentation before acting.`, de: "Diese Anleitung dient ausschließlich Bildungs- und Informationszwecken und stellt keine Finanz-, Anlage- oder Handelsberatung dar. Der Handel mit Futures und anderen gehebelten Produkten birgt ein erhebliches Verlustrisiko und ist nicht für jeden Anleger geeignet. PickMyTrade ist eine unabhängige Automatisierungsplattform eines Drittanbieters und steht in keiner Verbindung zu Tradovate, Inc., wird nicht von Tradovate, Inc. unterstützt oder gesponsert. „Tradovate“ sowie alle zugehörigen Namen, Logos und Marken sind Eigentum ihrer jeweiligen Inhaber. Plattformfunktionen und Schritte ändern sich im Laufe der Zeit. Prüfen Sie daher stets den aktuellen Ablauf in der offiziellen Tradovate-Plattform und -Dokumentation, bevor Sie handeln.", es: "Esta guía tiene fines exclusivamente educativos e informativos y no constituye asesoramiento financiero, de inversión ni de trading. Operar con futuros y otros productos apalancados conlleva un riesgo sustancial de pérdida y no es adecuado para todos los inversores. PickMyTrade es una plataforma de automatización independiente de terceros y no está afiliada, respaldada ni patrocinada por Tradovate, Inc. «Tradovate» y todos los nombres, logotipos y marcas relacionados son propiedad de sus respectivos titulares. Las funciones y los pasos de la plataforma cambian con el tiempo, por lo que debe confirmar siempre el proceso vigente en la plataforma y la documentación oficiales de Tradovate antes de actuar.", fr: "Ce guide est fourni à des fins strictement éducatives et informatives et ne constitue pas un conseil financier, d'investissement ou de trading. Le trading de contrats à terme et d'autres produits à effet de levier comporte un risque de perte important et ne convient pas à tous les investisseurs. PickMyTrade est une plateforme d'automatisation tierce indépendante, non affiliée à Tradovate, Inc., ni approuvée ou parrainée par celle-ci. « Tradovate » ainsi que tous les noms, logos et marques associés sont la propriété de leurs détenteurs respectifs. Les fonctionnalités et les étapes de la plateforme évoluent avec le temps : vérifiez toujours la procédure en vigueur dans la plateforme et la documentation officielles de Tradovate avant d'agir.", it: "Questa guida ha esclusivamente finalità educative e informative e non costituisce consulenza finanziaria, di investimento o di trading. Il trading di futures e di altri prodotti a leva comporta un rischio sostanziale di perdita e non è adatto a tutti gli investitori. PickMyTrade è una piattaforma di automazione indipendente di terze parti e non è affiliata, approvata né sponsorizzata da Tradovate, Inc. «Tradovate» e tutti i nomi, loghi e marchi correlati sono di proprietà dei rispettivi titolari. Le funzionalità e i passaggi della piattaforma cambiano nel tempo: confermi sempre la procedura attuale nella piattaforma e nella documentazione ufficiali di Tradovate prima di agire." },
};
const data: GuideArticleData = resolveGuideContent(content, locale, related);

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: data.faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: `${SITE_URL}${withSlash(localizedPath(locale))}` },
    { "@type": "ListItem", position: 2, name: "How-To", item: `${SITE_URL}${withSlash(localizedPath(locale, "how-to"))}` },
    { "@type": "ListItem", position: 3, name: content.h1[locale], item: `${SITE_URL}${withSlash(localizedPath(locale, `how-to/${SLUG}`))}` },
  ],
};

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: content.h1[locale],
  description: content.dek[locale],
  image: `${SITE_URL}${IMG}/tradovate-drawing-tools-1.png`,
  publisher: { "@type": "Organization", name: "PickMyTrade", logo: { "@type": "ImageObject", url: `${SITE_URL}/assets/logo.png` } },
  datePublished: "2026-07-08",
  dateModified: "2026-07-08",
  mainEntityOfPage: { "@type": "WebPage", "@id": `${SITE_URL}${withSlash(localizedPath(locale, `how-to/${SLUG}`))}` },
};
---

<BaseLayout
  locale={locale}
  title={`${content.h1[locale]} | PickMyTrade`}
  description={content.dek[locale]}
  ogType="article"
  ogImage={`${IMG}/tradovate-drawing-tools-1.png`}
  ldJson={[breadcrumbSchema, faqSchema, articleSchema]}
>
  <GuideArticle locale={locale} data={data} sectionPath="how-to" />
</BaseLayout>
