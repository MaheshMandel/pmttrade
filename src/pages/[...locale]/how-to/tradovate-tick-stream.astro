  ctaUrl: "https://app.pickmytrade.trade/?register=true&utm_source=content&utm_medium=how-to",
  faqHeading: { en: "Frequently Asked Questions", de: "Häufig gestellte Fragen", es: "Preguntas frecuentes", fr: "Questions fréquentes", it: "Domande frequenti" },
  faqs: { en: [
    { q: "Is the Tick Stream the same as Time & Sales?", a: "Functionally, yes. It is Tradovate's tape, one row per executed trade. Some builds label the module Tick Stream and others call it T&S or Time & Sales, so check the exact name in your platform." },
