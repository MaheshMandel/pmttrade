  ctaHeading: { en: "Act on the Tape Without Fumbling for the Mouse", de: "Handeln Sie nach dem Tape, ohne nach der Maus zu suchen", es: "Actúe sobre la cinta sin buscar el ratón", fr: "Agissez sur le tape sans chercher la souris", it: "Agisca sul tape senza cercare il mouse" },
