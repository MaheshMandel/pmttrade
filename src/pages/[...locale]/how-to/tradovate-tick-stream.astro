---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "tradovate-tick-stream";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/how-to/${SLUG}`;

const META_TITLE = "Read Order Flow With the Tradovate Tick Stream";
const META_DESCRIPTION =
  "See every futures print and its size on the tape. Open the Tick Stream, read buy and sell prints, and filter by volume to spot big orders.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate API", de: "Tradovate API", es: "Tradovate API", fr: "Tradovate API", it: "Tradovate API" },
  h1: { en: META_TITLE, de: "Orderflow mit dem Tradovate Tick Stream lesen", es: "Lea el flujo de órdenes con el Tick Stream de Tradovate", fr: "Lire le flux d'ordres avec le Tick Stream de Tradovate", it: "Leggere l'order flow con il Tick Stream di Tradovate" },
  dek: { en: "The tape tells you what is actually trading, not what might trade. Here's how to open the Tradovate Tick Stream, read it, and filter it to the prints that matter.", de: "Das Tape zeigt Ihnen, was tatsächlich gehandelt wird, nicht, was möglicherweise gehandelt wird. So öffnen Sie den Tradovate Tick Stream, lesen ihn und filtern ihn auf die Prints, die zählen.", es: "La cinta le muestra lo que realmente se está negociando, no lo que podría negociarse. Así puede abrir el Tick Stream de Tradovate, leerlo y filtrarlo para ver solo las operaciones que importan.", fr: "Le tape vous montre ce qui se négocie réellement, pas ce qui pourrait se négocier. Voici comment ouvrir le Tick Stream de Tradovate, le lire et le filtrer pour ne garder que les prints qui comptent.", it: "Il tape Le mostra ciò che viene effettivamente scambiato, non ciò che potrebbe esserlo. Ecco come aprire il Tick Stream di Tradovate, leggerlo e filtrarlo sui print che contano." },
  readTime: { en: "5 min read", de: "5 Min. Lesezeit", es: "Lectura de 5 min", fr: "Lecture : 5 min", it: "Lettura di 5 min" },
  lastUpdated: "2026-07-10",
  blocks: { en: [
    { type: "paragraph", html: "The tape tells you what is actually trading, not what might trade. Tradovate's Tick Stream prints every trade that crosses in your contract, along with the size behind it, so you watch real buying and selling hit the market live. Here is how to open it, read it, and filter it to the prints that matter." },
    { type: "heading", text: "What the Tick Stream Shows You" },
    { type: "paragraph", html: "Every row in the Tick Stream is one print, a single executed trade. As trades cross, new rows stack in at the top with the price, the contracts, and the time. The module shows every print and the volume tied to it, and you can filter that stream by volume, which turns a blur of ticks into something you can read." },
    { type: "paragraph", html: "Color does the heavy lifting. Buys print in green, sells print in red, so a wall of green means buyers are lifting offers and a run of red means sellers are hitting bids. The header shows the last traded price, the session's net change in points and percent, and total volume so far." },
    { type: "heading", text: "Read the Tradovate Tick Stream: Step-by-Step" },
    {
      type: "steps",
      items: [
        { title: "Open a Tick Stream Module", html: "Open your module launcher (the add-module or plus control in the Tradovate web platform) and pick the Tick Stream. Depending on your build, the same module may show up as T&amp;S or Time &amp; Sales, the classic name for a tape. Dock it next to your chart or DOM so you can watch price and flow together." },
        { title: "Load Your Contract and Confirm Live Data", html: "Select the contract you are trading, and use the current front-month (the active ES or NQ, not a continuous symbol). Then make sure you are on live data. A delayed feed still fills the stream, but the prints lag the real market, which is worthless for reading flow. If your quotes look delayed, subscribe to real-time market data before you trust the tape." },
        { title: "Read Each Print", html: "Read the rows. Each line gives you the price, the size (contracts in that single print), and the time. Green marks a buy at the ask, red marks a sell at the bid. Size is where the story sits: a steady drip of one and two lots is noise, while a sudden 50 or 100 lot is a real participant showing their hand. Watch whether the big prints keep hitting the same side." },
        { title: "Filter by Volume to Isolate Big Orders", html: "This is the setting that makes the Tick Stream worth running. Set the Volume Filter to a minimum contract size (it defaults to 1, which shows everything) and the stream hides any print below that number. Bump it to 25 or 50 and only the size that moves price remains. Pick a threshold that fits your contract; a big print in ES looks nothing like one in a thin micro." },
        { title: "Pair It With the DOM and Run a Second Stream", html: "The tape reads best next to depth. Put the Tick Stream beside a SuperDOM ladder so you can see where big prints land relative to resting bids and offers. One habit worth building: keep two streams open, one unfiltered for context and one filtered high for the whales. Lean on a single filtered stream and you lose the surrounding flow that gives those big prints their meaning." },
      ],
    },
    { type: "heading", text: "What the Columns and Colors Mean" },
    {
      type: "table",
      headers: ["Element", "What it tells you"],
      rows: [
        ["Price", "The price that single trade executed at."],
        ["Size", "Contracts in that one print. Large sizes flag real participants."],
        ["Time", "When the trade crossed the tape."],
        ["Green print", "A buy, traded at the ask (a buyer lifted the offer)."],
        ["Red print", "A sell, traded at the bid (a seller hit the bid)."],
        ["Header", "Last price, session net change in points and percent, and total session volume."],
      ],
    },
    { type: "heading", text: "How to Actually Use the Tape" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Watch for absorption.</strong> Heavy size pounding one side while price barely moves means someone is soaking it up.",
        "<strong class='text-white'>Line up big prints with your levels.</strong> Size arriving at support or resistance is a tell.",
        "<strong class='text-white'>Never trade the tape alone.</strong> Confirm it against the DOM and your chart first.",
        "<strong class='text-white'>Tune the filter per session.</strong> Overnight size is not the same as regular-hours size.",
      ],
    },
    { type: "heading", text: "Automate Your Entries With PickMyTrade" },
    { type: "paragraph", html: "Reading the tape is one thing; acting on it fast is another. PickMyTrade links your TradingView alerts straight to your Tradovate account, so the second your setup triggers, the order fires without you fumbling for the mouse while the tape moves." },
  ], de: [
    { type: "paragraph",html: "Das Tape zeigt Ihnen, was tatsächlich gehandelt wird, nicht, was möglicherweise gehandelt wird. Der Tick Stream von Tradovate druckt jeden Trade, der in Ihrem Kontrakt zustande kommt, samt der dahinterstehenden Größe, sodass Sie echtes Kaufen und Verkaufen live am Markt beobachten. So öffnen Sie ihn, lesen ihn und filtern ihn auf die Prints, die zählen." },
    { type: "heading",text: "Was der Tick Stream Ihnen zeigt" },
    { type: "paragraph",html: "Jede Zeile im Tick Stream ist ein Print, also ein einzelner ausgeführter Trade. Sobald Trades zustande kommen, reihen sich neue Zeilen oben ein, mit Preis, Kontrakten und Uhrzeit. Das Modul zeigt jeden Print und das dazugehörige Volumen, und Sie können diesen Stream nach Volumen filtern, wodurch aus einem Gewirr von Ticks etwas Lesbares wird." },
    { type: "paragraph",html: "Die Farbe leistet die Hauptarbeit. Käufe werden grün, Verkäufe rot gedruckt: Eine Wand aus Grün bedeutet, dass Käufer Angebote aufnehmen, und eine Serie in Rot, dass Verkäufer auf Gebote schlagen. Die Kopfzeile zeigt den zuletzt gehandelten Preis, die Nettoveränderung der Session in Punkten und Prozent sowie das bisherige Gesamtvolumen." },
    { type: "heading",text: "Den Tradovate Tick Stream lesen: Schritt für Schritt" },
    {
      type: "steps",
      items: [
        { title: "Ein Tick-Stream-Modul öffnen", html: "Öffnen Sie Ihren Modulstarter (das Symbol zum Hinzufügen von Modulen oder das Pluszeichen in der Tradovate-Webplattform) und wählen Sie den Tick Stream. Je nach Version erscheint dasselbe Modul als T&amp;S oder Time &amp; Sales, der klassische Name für ein Tape. Docken Sie es neben Ihrem Chart oder Ihrer DOM an, damit Sie Kurs und Flow gemeinsam beobachten können." },
        { title: "Kontrakt laden und Live-Daten bestätigen", html: "Wählen Sie den Kontrakt, den Sie handeln, und verwenden Sie den aktuellen Front-Month (das aktive ES oder NQ, kein fortlaufendes Symbol). Stellen Sie dann sicher, dass Sie Live-Daten nutzen. Ein verzögerter Feed füllt den Stream zwar ebenfalls, aber die Prints hinken dem echten Markt hinterher, was zum Lesen des Flows wertlos ist. Wirken Ihre Kurse verzögert, abonnieren Sie Echtzeit-Marktdaten, bevor Sie dem Tape vertrauen." },
        { title: "Jeden Print lesen", html: "Lesen Sie die Zeilen. Jede Zeile liefert Ihnen den Preis, die Größe (Kontrakte in diesem einzelnen Print) und die Uhrzeit. Grün steht für einen Kauf zum Ask, Rot für einen Verkauf zum Bid. In der Größe steckt die eigentliche Geschichte: Ein stetiges Tröpfeln von Ein- und Zweier-Lots ist Rauschen, während plötzliche 50 oder 100 Lots ein echter Marktteilnehmer sind, der seine Karten aufdeckt. Achten Sie darauf, ob die großen Prints immer wieder dieselbe Seite treffen." },
        { title: "Nach Volumen filtern, um große Orders zu isolieren", html: "Das ist die Einstellung, die den Tick Stream erst wertvoll macht. Setzen Sie den Volume Filter auf eine Mindestkontraktgröße (Standard ist 1, was alles anzeigt), und der Stream blendet jeden Print unterhalb dieser Zahl aus. Erhöhen Sie auf 25 oder 50, und es bleibt nur die Größe übrig, die den Kurs bewegt. Wählen Sie eine Schwelle, die zu Ihrem Kontrakt passt; ein großer Print im ES sieht völlig anders aus als einer in einem dünnen Micro." },
        { title: "Mit der DOM kombinieren und einen zweiten Stream betreiben", html: "Das Tape liest sich am besten neben der Markttiefe. Platzieren Sie den Tick Stream neben einer SuperDOM-Leiter, damit Sie sehen, wo große Prints relativ zu den ruhenden Geboten und Angeboten landen. Eine Gewohnheit, die sich lohnt: Halten Sie zwei Streams offen, einen ungefilterten für den Kontext und einen hoch gefilterten für die Wale. Wer sich auf einen einzigen gefilterten Stream verlässt, verliert den umgebenden Flow, der diesen großen Prints ihre Bedeutung gibt." },
      ],
    },
    { type: "heading",text: "Was die Spalten und Farben bedeuten" },
    { type: "table", headers: ["Element","Was es Ihnen sagt"], rows: [
      ["Preis","Der Preis, zu dem dieser einzelne Trade ausgeführt wurde."],
      ["Größe","Kontrakte in diesem einen Print. Große Größen verraten echte Marktteilnehmer."],
      ["Zeit","Wann der Trade über das Tape lief."],
      ["Grüner Print","Ein Kauf, gehandelt zum Ask (ein Käufer hat das Angebot aufgenommen)."],
      ["Roter Print","Ein Verkauf, gehandelt zum Bid (ein Verkäufer hat auf das Gebot geschlagen)."],
      ["Kopfzeile","Letzter Preis, Nettoveränderung der Session in Punkten und Prozent sowie das Gesamtvolumen der Session."],
    ] },
    { type: "heading",text: "Wie Sie das Tape wirklich nutzen" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Achten Sie auf Absorption.</strong> Wenn große Größen auf eine Seite hämmern und der Kurs sich kaum bewegt, saugt jemand sie auf.",
        "<strong class='text-white'>Gleichen Sie große Prints mit Ihren Niveaus ab.</strong> Größe, die an Unterstützung oder Widerstand eintrifft, ist ein Hinweis.",
        "<strong class='text-white'>Handeln Sie nie allein nach dem Tape.</strong> Bestätigen Sie es zuerst mit der DOM und Ihrem Chart.",
        "<strong class='text-white'>Passen Sie den Filter pro Session an.</strong> Größen über Nacht sind nicht dasselbe wie Größen in den regulären Handelszeiten.",
      ],
    },
    { type: "heading",text: "Automatisieren Sie Ihre Einstiege mit PickMyTrade" },
    { type: "paragraph",html: "Das Tape zu lesen ist eine Sache, schnell darauf zu reagieren eine andere. PickMyTrade verbindet Ihre TradingView-Alerts direkt mit Ihrem Tradovate-Konto, sodass die Order in dem Moment ausgelöst wird, in dem Ihr Setup eintritt, ohne dass Sie nach der Maus tasten müssen, während das Tape läuft." },
  ], es: [
    { type: "paragraph",html: "La cinta le muestra lo que realmente se está negociando, no lo que podría negociarse. El Tick Stream de Tradovate imprime cada operación que se cruza en su contrato, junto con el tamaño que hay detrás, de modo que usted ve en vivo cómo las compras y ventas reales golpean el mercado. Así puede abrirlo, leerlo y filtrarlo para ver solo los prints que importan." },
    { type: "heading",text: "Qué le muestra el Tick Stream" },
    { type: "paragraph",html: "Cada fila del Tick Stream es un print, una única operación ejecutada. A medida que se cruzan operaciones, las nuevas filas se apilan en la parte superior con el precio, los contratos y la hora. El módulo muestra cada print y el volumen asociado, y usted puede filtrar ese flujo por volumen, lo que convierte un borrón de ticks en algo legible." },
    { type: "paragraph",html: "El color hace el trabajo pesado. Las compras se imprimen en verde y las ventas en rojo, de modo que una pared de verde significa que los compradores están tomando ofertas y una racha de rojo significa que los vendedores están golpeando bids. El encabezado muestra el último precio negociado, la variación neta de la sesión en puntos y porcentaje, y el volumen total hasta el momento." },
    { type: "heading",text: "Cómo leer el Tick Stream de Tradovate: paso a paso" },
    {
      type: "steps",
      items: [
        { title: "Abra un módulo Tick Stream", html: "Abra su selector de módulos (el control de añadir módulo o el signo más en la plataforma web de Tradovate) y elija el Tick Stream. Según su versión, el mismo módulo puede aparecer como T&amp;S o Time &amp; Sales, el nombre clásico de una cinta. Acóplelo junto a su gráfico o DOM para poder observar precio y flujo a la vez." },
        { title: "Cargue su contrato y confirme que los datos son en vivo", html: "Seleccione el contrato que opera y use el mes frontal actual (el ES o NQ activo, no un símbolo continuo). Después asegúrese de estar con datos en vivo. Un feed retrasado también llena el flujo, pero los prints van por detrás del mercado real, lo cual no sirve para leer el flujo. Si sus cotizaciones parecen retrasadas, suscríbase a datos de mercado en tiempo real antes de confiar en la cinta." },
        { title: "Lea cada print", html: "Lea las filas. Cada línea le da el precio, el tamaño (contratos en ese único print) y la hora. El verde marca una compra al ask y el rojo una venta al bid. El tamaño es donde está la historia: un goteo constante de lotes de uno y dos es ruido, mientras que un repentino lote de 50 o 100 es un participante real mostrando sus cartas. Observe si los prints grandes siguen golpeando el mismo lado." },
        { title: "Filtre por volumen para aislar las órdenes grandes", html: "Este es el ajuste que hace que valga la pena ejecutar el Tick Stream. Establezca el Volume Filter en un tamaño mínimo de contratos (por defecto es 1, que lo muestra todo) y el flujo oculta cualquier print por debajo de ese número. Súbalo a 25 o 50 y solo queda el tamaño que mueve el precio. Elija un umbral adecuado a su contrato; un print grande en ES no se parece en nada a uno en un micro poco líquido." },
        { title: "Combínelo con la DOM y ejecute un segundo flujo", html: "La cinta se lee mejor junto a la profundidad. Coloque el Tick Stream al lado de una escalera SuperDOM para ver dónde caen los prints grandes en relación con los bids y offers en reposo. Un hábito que vale la pena crear: mantenga dos flujos abiertos, uno sin filtrar para el contexto y otro con un filtro alto para las ballenas. Si se apoya en un único flujo filtrado, pierde el flujo circundante que da sentido a esos prints grandes." },
      ],
    },
    { type: "heading",text: "Qué significan las columnas y los colores" },
    { type: "table", headers: ["Elemento","Qué le indica"], rows: [
      ["Precio","El precio al que se ejecutó esa operación individual."],
      ["Tamaño","Contratos en ese único print. Los tamaños grandes señalan participantes reales."],
      ["Hora","Cuándo se cruzó la operación en la cinta."],
      ["Print verde","Una compra, negociada al ask (un comprador tomó la oferta)."],
      ["Print rojo","Una venta, negociada al bid (un vendedor golpeó el bid)."],
      ["Encabezado","Último precio, variación neta de la sesión en puntos y porcentaje, y volumen total de la sesión."],
    ] },
    { type: "heading",text: "Cómo usar realmente la cinta" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Esté atento a la absorción.</strong> Un gran tamaño golpeando un lado mientras el precio apenas se mueve significa que alguien lo está absorbiendo.",
        "<strong class='text-white'>Alinee los prints grandes con sus niveles.</strong> Un tamaño que llega a un soporte o resistencia es una señal.",
        "<strong class='text-white'>Nunca opere solo con la cinta.</strong> Confírmela antes con la DOM y su gráfico.",
        "<strong class='text-white'>Ajuste el filtro en cada sesión.</strong> El tamaño nocturno no es igual que el del horario regular.",
      ],
    },
    { type: "heading",text: "Automatice sus entradas con PickMyTrade" },
    { type: "paragraph",html: "Leer la cinta es una cosa; actuar rápido sobre ella es otra. PickMyTrade conecta sus alertas de TradingView directamente con su cuenta de Tradovate, de modo que en el instante en que se activa su setup, la orden se dispara sin que usted tenga que buscar el ratón mientras la cinta se mueve." },
  ], fr: [
    { type: "paragraph",html: "Le tape vous montre ce qui se négocie réellement, pas ce qui pourrait se négocier. Le Tick Stream de Tradovate affiche chaque transaction qui passe sur votre contrat, avec la taille qui l'accompagne, ce qui vous permet de voir en direct les vrais achats et ventes frapper le marché. Voici comment l'ouvrir, le lire et le filtrer pour ne garder que les prints qui comptent." },
    { type: "heading",text: "Ce que le Tick Stream vous montre" },
    { type: "paragraph",html: "Chaque ligne du Tick Stream est un print, une seule transaction exécutée. À mesure que les transactions passent, de nouvelles lignes s'empilent en haut avec le prix, les contrats et l'heure. Le module affiche chaque print et le volume associé, et vous pouvez filtrer ce flux par volume, ce qui transforme un flou de ticks en quelque chose de lisible." },
    { type: "paragraph",html: "La couleur fait le gros du travail. Les achats s'impriment en vert, les ventes en rouge : un mur de vert signifie que les acheteurs prennent les offres, et une série de rouge que les vendeurs frappent les bids. L'en-tête affiche le dernier prix négocié, la variation nette de la séance en points et en pourcentage, ainsi que le volume total à ce stade." },
    { type: "heading",text: "Lire le Tick Stream de Tradovate : pas à pas" },
    {
      type: "steps",
      items: [
        { title: "Ouvrez un module Tick Stream", html: "Ouvrez votre lanceur de modules (la commande d'ajout de module ou le signe plus dans la plateforme web Tradovate) et choisissez le Tick Stream. Selon votre version, le même module peut apparaître sous le nom T&amp;S ou Time &amp; Sales, le nom classique d'un tape. Ancrez-le à côté de votre graphique ou de votre DOM afin de suivre ensemble le prix et le flux." },
        { title: "Chargez votre contrat et confirmez que les données sont en direct", html: "Sélectionnez le contrat que vous tradez et utilisez le contrat du mois en cours (l'ES ou le NQ actif, pas un symbole continu). Assurez-vous ensuite d'être en données en direct. Un flux différé remplit aussi le Tick Stream, mais les prints sont en retard sur le marché réel, ce qui est sans valeur pour lire le flux. Si vos cotations semblent différées, abonnez-vous aux données de marché en temps réel avant de vous fier au tape." },
        { title: "Lisez chaque print", html: "Lisez les lignes. Chaque ligne vous donne le prix, la taille (les contrats de ce print unique) et l'heure. Le vert marque un achat à l'ask, le rouge une vente au bid. La taille est là où se trouve l'histoire : un filet régulier de lots de un et deux n'est que du bruit, alors qu'un lot soudain de 50 ou 100 est un vrai intervenant qui dévoile son jeu. Observez si les gros prints continuent de frapper le même côté." },
        { title: "Filtrez par volume pour isoler les gros ordres", html: "C'est le réglage qui rend le Tick Stream utile. Réglez le Volume Filter sur une taille minimale de contrats (1 par défaut, ce qui affiche tout) et le flux masque tout print inférieur à ce nombre. Montez à 25 ou 50 et seule subsiste la taille qui fait bouger le prix. Choisissez un seuil adapté à votre contrat ; un gros print sur l'ES n'a rien à voir avec un gros print sur un micro peu liquide." },
        { title: "Associez-le à la DOM et lancez un second flux", html: "Le tape se lit mieux à côté de la profondeur. Placez le Tick Stream à côté d'une échelle SuperDOM pour voir où atterrissent les gros prints par rapport aux bids et aux offres en attente. Une habitude à prendre : gardez deux flux ouverts, l'un non filtré pour le contexte et l'autre filtré haut pour les baleines. Si vous vous appuyez sur un seul flux filtré, vous perdez le flux environnant qui donne leur sens à ces gros prints." },
      ],
    },
    { type: "heading",text: "Ce que signifient les colonnes et les couleurs" },
    { type: "table", headers: ["Élément","Ce qu'il vous indique"], rows: [
      ["Prix","Le prix auquel cette transaction unique a été exécutée."],
      ["Taille","Les contrats de ce seul print. Les grandes tailles révèlent de vrais intervenants."],
      ["Heure","Le moment où la transaction est passée sur le tape."],
      ["Print vert","Un achat, négocié à l'ask (un acheteur a pris l'offre)."],
      ["Print rouge","Une vente, négociée au bid (un vendeur a frappé le bid)."],
      ["En-tête","Dernier prix, variation nette de la séance en points et en pourcentage, et volume total de la séance."],
    ] },
    { type: "heading",text: "Comment vraiment utiliser le tape" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Guettez l'absorption.</strong> Une grosse taille qui martèle un côté alors que le prix bouge à peine signifie que quelqu'un l'absorbe.",
        "<strong class='text-white'>Alignez les gros prints sur vos niveaux.</strong> Une taille qui arrive sur un support ou une résistance est un indice.",
        "<strong class='text-white'>Ne tradez jamais le tape seul.</strong> Confirmez-le d'abord avec la DOM et votre graphique.",
        "<strong class='text-white'>Ajustez le filtre selon la séance.</strong> La taille de nuit n'est pas la même que celle des heures régulières.",
      ],
    },
    { type: "heading",text: "Automatisez vos entrées avec PickMyTrade" },
    { type: "paragraph",html: "Lire le tape est une chose ; agir vite en est une autre. PickMyTrade relie vos alertes TradingView directement à votre compte Tradovate : à la seconde où votre setup se déclenche, l'ordre part sans que vous ayez à chercher la souris pendant que le tape défile." },
  ], it: [
    { type: "paragraph",html: "Il tape Le mostra ciò che viene effettivamente scambiato, non ciò che potrebbe esserlo. Il Tick Stream di Tradovate stampa ogni operazione che si incrocia sul Suo contratto, insieme alla dimensione che c'è dietro, così può osservare dal vivo i veri acquisti e le vere vendite che colpiscono il mercato. Ecco come aprirlo, leggerlo e filtrarlo sui print che contano." },
    { type: "heading",text: "Che cosa Le mostra il Tick Stream" },
    { type: "paragraph",html: "Ogni riga del Tick Stream è un print, una singola operazione eseguita. Man mano che le operazioni si incrociano, nuove righe si impilano in alto con il prezzo, i contratti e l'ora. Il modulo mostra ogni print e il volume associato, e può filtrare quel flusso per volume, trasformando un'accozzaglia di tick in qualcosa di leggibile." },
    { type: "paragraph",html: "Il colore fa il grosso del lavoro. Gli acquisti vengono stampati in verde, le vendite in rosso: un muro di verde significa che i compratori stanno prendendo le offerte, una serie di rosso che i venditori stanno colpendo i bid. L'intestazione mostra l'ultimo prezzo scambiato, la variazione netta della sessione in punti e in percentuale, e il volume totale finora." },
    { type: "heading",text: "Leggere il Tick Stream di Tradovate: passo dopo passo" },
    {
      type: "steps",
      items: [
        { title: "Apra un modulo Tick Stream", html: "Apra il Suo selettore di moduli (il controllo per aggiungere un modulo o il segno più nella piattaforma web di Tradovate) e scelga il Tick Stream. A seconda della versione, lo stesso modulo può comparire come T&amp;S o Time &amp; Sales, il nome classico di un tape. Lo agganci accanto al Suo grafico o alla DOM per osservare insieme prezzo e flusso." },
        { title: "Carichi il contratto e confermi che i dati siano in tempo reale", html: "Selezioni il contratto che opera e usi il front-month corrente (l'ES o l'NQ attivo, non un simbolo continuo). Poi si assicuri di avere dati in tempo reale. Un feed ritardato riempie comunque il flusso, ma i print arrivano in ritardo rispetto al mercato reale, il che è inutile per leggere il flusso. Se le Sue quotazioni sembrano ritardate, si abboni ai dati di mercato in tempo reale prima di fidarsi del tape." },
        { title: "Legga ogni print", html: "Legga le righe. Ogni riga Le dà il prezzo, la dimensione (i contratti in quel singolo print) e l'ora. Il verde indica un acquisto all'ask, il rosso una vendita al bid. La storia sta nella dimensione: un flusso costante di lotti da uno e due è rumore, mentre un improvviso lotto da 50 o 100 è un vero partecipante che scopre le sue carte. Osservi se i grandi print continuano a colpire sempre lo stesso lato." },
        { title: "Filtri per volume per isolare gli ordini grandi", html: "Questa è l'impostazione che rende utile il Tick Stream. Imposti il Volume Filter su una dimensione minima di contratti (il predefinito è 1, che mostra tutto) e il flusso nasconde ogni print inferiore a quel numero. Lo porti a 25 o 50 e resta solo la dimensione che muove il prezzo. Scelga una soglia adatta al Suo contratto; un grande print sull'ES non ha nulla a che vedere con uno su un micro poco liquido." },
        { title: "Lo abbini alla DOM e avvii un secondo flusso", html: "Il tape si legge meglio accanto alla profondità. Metta il Tick Stream vicino a una scala SuperDOM per vedere dove cadono i grandi print rispetto ai bid e alle offerte in attesa. Un'abitudine da coltivare: tenga aperti due flussi, uno non filtrato per il contesto e uno filtrato in alto per le balene. Se si affida a un solo flusso filtrato, perde il flusso circostante che dà significato a quei grandi print." },
      ],
    },
    { type: "heading",text: "Che cosa significano le colonne e i colori" },
    { type: "table", headers: ["Elemento","Che cosa Le indica"], rows: [
      ["Prezzo","Il prezzo al quale è stata eseguita quella singola operazione."],
      ["Dimensione","I contratti in quel singolo print. Le dimensioni elevate segnalano veri partecipanti."],
