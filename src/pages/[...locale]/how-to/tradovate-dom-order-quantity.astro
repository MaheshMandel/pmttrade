---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "tradovate-dom-order-quantity";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/how-to/${SLUG}`;

const META_TITLE = "Set Default Order Quantity in the Tradovate DOM";
const META_DESCRIPTION =
  "Set your contract size in the depth-of-market ladder before you trade, and learn why you can't resize an order that's already working on the book.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Standard-Ordermenge in der Tradovate-DOM festlegen", es: "Establezca la cantidad de orden predeterminada en el DOM de Tradovate", fr: "Définir la quantité d'ordre par défaut dans le DOM Tradovate", it: "Impostare la quantità d'ordine predefinita nel DOM di Tradovate" },
  dek: { en: "Need to set your order quantity on the Tradovate SuperDOM? Here's where to set your contract size, plus the one thing the ladder won't let you do: resize an order that's already live.", de: "Möchten Sie Ihre Ordermenge im Tradovate SuperDOM festlegen? Hier stellen Sie Ihre Kontraktgröße ein, plus das Eine, was die Preisleiter nicht zulässt: die Größe einer bereits aktiven Order ändern.", es: "¿Necesita establecer la cantidad de su orden en el SuperDOM de Tradovate? Aquí se fija el tamaño del contrato, además de lo único que la escalera no le permite hacer: cambiar el tamaño de una orden que ya está activa.", fr: "Vous devez définir la quantité de vos ordres sur le SuperDOM Tradovate ? Voici où régler la taille de votre contrat, ainsi que la seule chose que l'échelle ne permet pas : redimensionner un ordre déjà actif.", it: "Deve impostare la quantità dei suoi ordini sul SuperDOM di Tradovate? Ecco dove impostare la dimensione del contratto, più l'unica cosa che la scala non consente: ridimensionare un ordine già attivo." },
  readTime: { en: "4 min read", de: "4 Min. Lesezeit", es: "Lectura de 4 min", fr: "Lecture : 4 min", it: "Lettura di 4 min" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "Every order you fire off the ladder goes out at whatever number sits in the Qty box. Set that once and it holds as your working size, so you're not fat-fingering contract counts in a fast market. Here's where to set your order quantity on the Tradovate SuperDOM, plus the one thing the ladder won't let you do: resize an order that's already live." },
    { type: "heading", text: "What \"Default Quantity\" Actually Means on the DOM" },
    { type: "paragraph", html: "On the Tradovate SuperDOM, the Qty field at the top of the ladder is your order size, and whatever you leave it at is the size the next buy or sell uses. A fresh DOM opens at 1 contract. Change it once and it holds for that ladder until you change it again, which is as close to a \"default\" as the DOM gives you. Order defaults can shift depending on where you open order entry from, so glance at the Qty box before you send anything." },
    { type: "heading", text: "Setting Your Order Quantity: Step-by-Step" },
    {
      type: "steps",
      items: [
        { title: "Open the SuperDOM for Your Contract", html: "In the Tradovate Web Trader, open a SuperDOM and load the contract you want to trade. If you're new to the ladder itself, our guide to placing orders on the Tradovate SuperDOM walks through the whole layout first." },
        { title: "Find the Qty Control at the Top of the Ladder", html: "Look at the top of the SuperDOM module, above the price ladder. That's where the quantity control lives, and it's the number that drives every order you send from this ladder. Worth knowing exactly where it sits before you're in a trade." },
        { title: "Set Your Contract Count", html: "Type the number of contracts you want directly into the Qty box, or click the plus and minus steppers to nudge it up and down. Trading 3 lots? Set it to 3 and leave it there. If you find yourself changing size a lot during a session, setting up keyboard hotkeys in Tradovate can speed up size changes once you've got your base size dialed in." },
        { title: "Make Your Size Hold as the Default", html: "Whatever you leave in the Qty box stays put as the working quantity for that ladder until you change it, so you don't have to re-enter it before each order. If you want a size that survives across sessions, open the module <strong class='text-white'>Settings</strong> through the gear icon at the top-right of the DOM and check for a default-quantity option there. Confirm the exact wording in your current build, since the settings layout gets refreshed from time to time." },
        { title: "Send the Order at Your Set Size", html: "With your quantity set, click a price on the bid or ask side of the ladder to place a working order, or use the <strong class='text-white'>Buy Market</strong> and <strong class='text-white'>Sell Market</strong> buttons for an immediate fill. Either way, the order goes out at the number in the Qty box, no per-order typing needed." },
      ],
    },
    { type: "heading", text: "The Limitation: You Can't Resize a Working Order" },
    { type: "paragraph", html: "Here's where people get tripped up. Once an order is resting on the book, its quantity is frozen. You can drag the price up and down the ladder all day, but the DOM won't let you change the number of contracts on an order that's already live. The Qty box only sets the size of the <em>next</em> order you send, not orders already sitting out there." },
    {
      type: "table",
      headers: ["On a working (resting) order", "Can you change it?"],
      rows: [
        ["Price / order level", "Yes, drag it on the ladder or chart"],
        ["Quantity (number of contracts)", "No, you have to cancel and re-place"],
      ],
    },
    { type: "paragraph", html: "So if you've got 2 contracts working and you decide you want 4, you have two clean options:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Cancel and re-place</strong>, kill the existing order and send a fresh one at the new size.",
        "<strong class='text-white'>Scale in</strong>, leave the original order and add a separate order for the extra contracts.",
      ],
    },
    { type: "paragraph", html: "You'll manage those live orders from the ladder or from the Tradovate Orders module, where cancelling and re-submitting is quick. It's a small quirk, but knowing it ahead of time keeps you from stabbing at a number that was never going to change." },
    { type: "heading", text: "Why You'd Need This" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Trade at the right size</strong>, a locked Qty box means fewer contract-count errors under pressure.",
        "<strong class='text-white'>Know the cancel/replace rule</strong>, plan your sizing before you send, because you can't resize a live order.",
        "<strong class='text-white'>Respect account limits</strong>, max position and contract caps vary by firm and account size, so check your firm's current rules before you scale up.",
      ],
    },
    { type: "heading", text: "Automate This with PickMyTrade" },
    { type: "paragraph", html: "If you'd rather your size and routing come straight from your strategy instead of a Qty box, <strong class='text-white'>PickMyTrade sends your TradingView alerts through to your Tradovate account with the quantity baked into each signal</strong>. Your entries and exits fire at the size you defined, no clicking the ladder mid-move." },
  ], de: [
    { type: "paragraph",html: "Jede Order, die Sie über die Preisleiter absetzen, geht mit der Zahl im Qty-Feld hinaus. Legen Sie sie einmal fest und sie bleibt Ihre aktuelle Größe, sodass Sie in einem schnellen Markt keine Kontraktzahlen verfehlen. So legen Sie Ihre Ordermenge im Tradovate SuperDOM fest, plus das Eine, was die Preisleiter nicht zulässt: die Größe einer bereits aktiven Order ändern." },
    { type: "heading",text: "Was „Standardmenge“ in der DOM tatsächlich bedeutet" },
    { type: "paragraph",html: "Im Tradovate SuperDOM ist das Feld Qty oben an der Preisleiter Ihre Ordergröße, und der Wert, den Sie dort stehen lassen, ist die Größe, die der nächste Kauf oder Verkauf verwendet. Eine frische DOM öffnet mit 1 Kontrakt. Ändern Sie ihn einmal, bleibt er für diese Preisleiter bestehen, bis Sie ihn erneut ändern, das kommt einem „Standard“ am nächsten, den die DOM bietet. Order-Standardwerte können je nachdem variieren, von wo aus Sie die Ordereingabe öffnen, werfen Sie daher vor dem Absenden einen Blick auf das Qty-Feld." },
    { type: "heading",text: "Ordermenge festlegen: Schritt für Schritt" },
    {
      type: "steps",
      items: [
        { title: "Das SuperDOM für Ihren Kontrakt öffnen", html: "Öffnen Sie im Tradovate Web Trader ein SuperDOM und laden Sie den Kontrakt, den Sie handeln möchten. Wenn Ihnen die Preisleiter selbst neu ist, führt unsere Anleitung zum Platzieren von Orders im Tradovate SuperDOM zunächst durch das gesamte Layout." },
        { title: "Das Qty-Steuerelement oben an der Preisleiter finden", html: "Sehen Sie oben im SuperDOM-Modul über der Preisleiter nach. Dort befindet sich das Mengensteuerelement, und es ist die Zahl, die jede von dieser Preisleiter gesendete Order bestimmt. Es lohnt sich, genau zu wissen, wo es sitzt, bevor Sie sich in einem Trade befinden." },
        { title: "Ihre Kontraktzahl festlegen", html: "Geben Sie die gewünschte Kontraktzahl direkt in das Qty-Feld ein oder klicken Sie auf die Plus- und Minus-Schaltflächen, um sie nach oben oder unten zu verändern. Sie handeln 3 Lots? Setzen Sie 3 ein und lassen Sie es dabei. Wenn Sie die Größe während einer Sitzung oft ändern, können Tastenkürzel in Tradovate Größenwechsel beschleunigen, sobald Ihre Basisgröße feststeht." },
        { title: "Ihre Größe als Standard beibehalten", html: "Was auch immer Sie im Qty-Feld stehen lassen, bleibt als aktuelle Menge für diese Preisleiter bestehen, bis Sie sie ändern, sodass Sie sie nicht vor jeder Order neu eingeben müssen. Wenn Sie eine Größe möchten, die sitzungsübergreifend erhalten bleibt, öffnen Sie die Modul-<strong class='text-white'>Settings</strong> über das Zahnradsymbol oben rechts in der DOM und suchen Sie dort nach einer Option für die Standardmenge. Bestätigen Sie die genaue Bezeichnung in Ihrer aktuellen Version, da das Einstellungslayout von Zeit zu Zeit überarbeitet wird." },
        { title: "Die Order in Ihrer festgelegten Größe senden", html: "Ist Ihre Menge festgelegt, klicken Sie auf einen Preis auf der Bid- oder Ask-Seite der Preisleiter, um eine aktive Order zu platzieren, oder nutzen Sie die Schaltflächen <strong class='text-white'>Buy Market</strong> und <strong class='text-white'>Sell Market</strong> für einen sofortigen Fill. In beiden Fällen geht die Order mit der Zahl im Qty-Feld hinaus, ohne dass Sie sie für jede Order neu eintippen müssen." },
      ],
    },
    { type: "heading",text: "Die Einschränkung: Eine aktive Order lässt sich nicht in der Größe ändern" },
    { type: "paragraph",html: "Hier stolpern viele. Sobald eine Order im Orderbuch ruht, ist ihre Menge festgeschrieben. Sie können den Preis den ganzen Tag über die Preisleiter ziehen, aber die DOM lässt Sie nicht die Kontraktzahl einer bereits aktiven Order ändern. Das Qty-Feld legt nur die Größe der <em>nächsten</em> Order fest, die Sie senden, nicht die bereits im Markt liegender Orders." },
    { type: "table", headers: ["Bei einer aktiven (ruhenden) Order","Können Sie es ändern?"], rows: [
      ["Preis / Orderniveau","Ja, ziehen Sie sie auf der Preisleiter oder im Chart"],
      ["Menge (Anzahl der Kontrakte)","Nein, Sie müssen stornieren und neu aufgeben"],
    ] },
    { type: "paragraph",html: "Wenn Sie also 2 Kontrakte im Markt haben und sich für 4 entscheiden, haben Sie zwei saubere Optionen:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Stornieren und neu aufgeben</strong>, die bestehende Order löschen und eine neue in der neuen Größe senden.",
        "<strong class='text-white'>Aufstocken</strong>, die ursprüngliche Order belassen und eine separate Order für die zusätzlichen Kontrakte hinzufügen.",
      ],
    },
    { type: "paragraph",html: "Diese aktiven Orders verwalten Sie über die Preisleiter oder das Tradovate-Modul Orders, in dem Stornieren und erneutes Senden schnell geht. Es ist eine kleine Eigenheit, aber wenn Sie sie vorab kennen, versuchen Sie nicht, eine Zahl zu ändern, die sich nie ändern ließ." },
    { type: "heading",text: "Wozu Sie das brauchen" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>In der richtigen Größe handeln</strong>, ein festgelegtes Qty-Feld bedeutet unter Druck weniger Fehler bei der Kontraktzahl.",
        "<strong class='text-white'>Die Storno-und-Neu-Regel kennen</strong>, planen Sie Ihre Größe vor dem Senden, denn eine aktive Order lässt sich nicht in der Größe ändern.",
        "<strong class='text-white'>Kontolimits beachten</strong>, maximale Positions- und Kontraktgrenzen variieren je nach Firma und Kontogröße. Prüfen Sie daher die aktuellen Regeln Ihrer Firma, bevor Sie aufstocken.",
      ],
    },
    { type: "heading",text: "Automatisieren Sie das mit PickMyTrade" },
    { type: "paragraph",html: "Wenn Ihre Größe und Ihr Routing lieber direkt aus Ihrer Strategie statt aus einem Qty-Feld kommen sollen: <strong class='text-white'>PickMyTrade leitet Ihre TradingView-Alerts mit der in jedes Signal eingebauten Menge an Ihr Tradovate-Konto weiter</strong>. Ihre Ein- und Ausstiege werden in der von Ihnen definierten Größe ausgelöst, ohne dass Sie mitten in der Bewegung auf die Preisleiter klicken müssen." },
  ], es: [
    { type: "paragraph",html: "Cada orden que lanza desde la escalera sale con el número que figure en el cuadro Qty. Establézcalo una vez y se mantiene como su tamaño de trabajo, para que no se equivoque con el número de contratos en un mercado rápido. Aquí se explica dónde establecer la cantidad de su orden en el SuperDOM de Tradovate, además de lo único que la escalera no le permite hacer: cambiar el tamaño de una orden que ya está activa." },
    { type: "heading",text: "Qué significa realmente «cantidad predeterminada» en el DOM" },
    { type: "paragraph",html: "En el SuperDOM de Tradovate, el campo Qty de la parte superior de la escalera es el tamaño de su orden, y lo que deje ahí es el tamaño que usará la siguiente compra o venta. Un DOM nuevo se abre con 1 contrato. Cámbielo una vez y se mantiene para esa escalera hasta que lo vuelva a cambiar, que es lo más parecido a un «predeterminado» que ofrece el DOM. Los valores predeterminados de las órdenes pueden variar según desde dónde abra la entrada de órdenes, así que eche un vistazo al cuadro Qty antes de enviar nada." },
    { type: "heading",text: "Establecer la cantidad de su orden: paso a paso" },
    {
      type: "steps",
      items: [
        { title: "Abra el SuperDOM de su contrato", html: "En el Web Trader de Tradovate, abra un SuperDOM y cargue el contrato que desea operar. Si la propia escalera le resulta nueva, nuestra guía para colocar órdenes en el SuperDOM de Tradovate repasa primero todo el diseño." },
        { title: "Localice el control Qty en la parte superior de la escalera", html: "Mire la parte superior del módulo SuperDOM, sobre la escalera de precios. Ahí está el control de cantidad, y es el número que rige cada orden que envía desde esta escalera. Conviene saber exactamente dónde está antes de estar dentro de una operación." },
        { title: "Establezca su número de contratos", html: "Escriba el número de contratos que desea directamente en el cuadro Qty, o haga clic en los botones de más y menos para subirlo y bajarlo. ¿Opera 3 lotes? Póngalo en 3 y déjelo así. Si cambia de tamaño a menudo durante una sesión, configurar atajos de teclado en Tradovate puede acelerar los cambios de tamaño una vez que tenga fijado su tamaño base." },
        { title: "Haga que su tamaño se mantenga como predeterminado", html: "Lo que deje en el cuadro Qty permanece como la cantidad de trabajo de esa escalera hasta que lo cambie, así que no tiene que volver a introducirlo antes de cada orden. Si desea un tamaño que sobreviva entre sesiones, abra los <strong class='text-white'>Settings</strong> del módulo mediante el icono de engranaje en la parte superior derecha del DOM y busque ahí una opción de cantidad predeterminada. Confirme el texto exacto en su versión actual, ya que el diseño de la configuración se renueva de vez en cuando." },
        { title: "Envíe la orden con el tamaño establecido", html: "Con su cantidad fijada, haga clic en un precio del lado de oferta o demanda de la escalera para colocar una orden activa, o use los botones <strong class='text-white'>Buy Market</strong> y <strong class='text-white'>Sell Market</strong> para una ejecución inmediata. En ambos casos, la orden sale con el número del cuadro Qty, sin necesidad de teclearlo en cada orden." },
      ],
    },
    { type: "heading",text: "La limitación: no se puede cambiar el tamaño de una orden activa" },
    { type: "paragraph",html: "Aquí es donde mucha gente tropieza. Una vez que una orden está en reposo en el libro, su cantidad queda congelada. Puede arrastrar el precio arriba y abajo por la escalera todo el día, pero el DOM no le deja cambiar el número de contratos de una orden que ya está activa. El cuadro Qty solo fija el tamaño de la <em>siguiente</em> orden que envíe, no el de las órdenes que ya están en el mercado." },
    { type: "table", headers: ["En una orden activa (en reposo)","¿Puede cambiarlo?"], rows: [
      ["Precio / nivel de la orden","Sí, arrástrela en la escalera o en el gráfico"],
      ["Cantidad (número de contratos)","No, tiene que cancelar y volver a colocarla"],
    ] },
    { type: "paragraph",html: "Así que si tiene 2 contratos activos y decide que quiere 4, tiene dos opciones limpias:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Cancelar y volver a colocar</strong>, eliminar la orden existente y enviar una nueva con el tamaño nuevo.",
        "<strong class='text-white'>Escalar la entrada</strong>, dejar la orden original y añadir una orden aparte para los contratos adicionales.",
      ],
    },
    { type: "paragraph",html: "Gestionará esas órdenes activas desde la escalera o desde el módulo Orders de Tradovate, donde cancelar y reenviar es rápido. Es una peculiaridad menor, pero saberlo de antemano evita que se empeñe en cambiar un número que nunca iba a cambiar." },
    { type: "heading",text: "Por qué necesitaría esto" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Operar con el tamaño correcto</strong>, un cuadro Qty fijado significa menos errores de número de contratos bajo presión.",
        "<strong class='text-white'>Conocer la regla de cancelar y volver a colocar</strong>, planifique su tamaño antes de enviar, porque no puede cambiar el tamaño de una orden activa.",
        "<strong class='text-white'>Respetar los límites de la cuenta</strong>, los límites de posición máxima y de contratos varían según la firma y el tamaño de la cuenta, así que consulte las reglas actuales de su firma antes de aumentar el tamaño.",
      ],
    },
    { type: "heading",text: "Automatice esto con PickMyTrade" },
    { type: "paragraph",html: "Si prefiere que su tamaño y su enrutamiento procedan directamente de su estrategia en lugar de un cuadro Qty, <strong class='text-white'>PickMyTrade envía sus alertas de TradingView a su cuenta de Tradovate con la cantidad incorporada en cada señal</strong>. Sus entradas y salidas se disparan con el tamaño que usted definió, sin hacer clic en la escalera en pleno movimiento." },
  ], fr: [
    { type: "paragraph",html: "Chaque ordre que vous lancez depuis l'échelle part avec le nombre qui figure dans la case Qty. Réglez-le une fois et il reste votre taille de travail, de sorte que vous ne vous trompez pas de nombre de contrats sur un marché rapide. Voici où définir la quantité de vos ordres sur le SuperDOM Tradovate, ainsi que la seule chose que l'échelle ne permet pas : redimensionner un ordre déjà actif." },
    { type: "heading",text: "Ce que signifie réellement la « quantité par défaut » sur le DOM" },
    { type: "paragraph",html: "Sur le SuperDOM Tradovate, le champ Qty en haut de l'échelle est la taille de votre ordre, et la valeur que vous y laissez est la taille que le prochain achat ou la prochaine vente utilisera. Un DOM neuf s'ouvre à 1 contrat. Changez-la une fois et elle reste pour cette échelle jusqu'à ce que vous la changiez à nouveau, ce qui est ce qui se rapproche le plus d'un « défaut » dans le DOM. Les valeurs par défaut des ordres peuvent varier selon l'endroit d'où vous ouvrez la saisie d'ordre ; jetez donc un œil à la case Qty avant d'envoyer quoi que ce soit." },
    { type: "heading",text: "Définir la quantité de votre ordre : pas à pas" },
    {
      type: "steps",
      items: [
        { title: "Ouvrir le SuperDOM de votre contrat", html: "Dans le Web Trader Tradovate, ouvrez un SuperDOM et chargez le contrat que vous souhaitez trader. Si l'échelle elle-même est nouvelle pour vous, notre guide sur le placement d'ordres sur le SuperDOM Tradovate présente d'abord toute la disposition." },
        { title: "Repérer le contrôle Qty en haut de l'échelle", html: "Regardez le haut du module SuperDOM, au-dessus de l'échelle des prix. C'est là que se trouve le contrôle de quantité, et c'est le nombre qui pilote chaque ordre envoyé depuis cette échelle. Mieux vaut savoir exactement où il se trouve avant d'être en position." },
        { title: "Régler votre nombre de contrats", html: "Saisissez le nombre de contrats souhaité directement dans la case Qty, ou cliquez sur les boutons plus et moins pour l'augmenter ou le diminuer. Vous tradez 3 lots ? Réglez sur 3 et laissez-le. Si vous changez souvent de taille pendant une session, configurer des raccourcis clavier dans Tradovate peut accélérer les changements de taille une fois votre taille de base établie." },
        { title: "Faire de votre taille la valeur par défaut", html: "Ce que vous laissez dans la case Qty reste la quantité de travail de cette échelle jusqu'à ce que vous la changiez, vous n'avez donc pas à la ressaisir avant chaque ordre. Si vous voulez une taille qui survive d'une session à l'autre, ouvrez les <strong class='text-white'>Settings</strong> du module via l'icône d'engrenage en haut à droite du DOM et cherchez-y une option de quantité par défaut. Vérifiez le libellé exact dans votre version actuelle, car la disposition des paramètres est remaniée de temps en temps." },
        { title: "Envoyer l'ordre à la taille définie", html: "Une fois votre quantité définie, cliquez sur un prix du côté bid ou ask de l'échelle pour placer un ordre actif, ou utilisez les boutons <strong class='text-white'>Buy Market</strong> et <strong class='text-white'>Sell Market</strong> pour une exécution immédiate. Dans les deux cas, l'ordre part avec le nombre de la case Qty, sans saisie à chaque ordre." },
      ],
    },
    { type: "heading",text: "La limite : impossible de redimensionner un ordre actif" },
    { type: "paragraph",html: "C'est là que beaucoup trébuchent. Une fois qu'un ordre repose dans le carnet, sa quantité est figée. Vous pouvez faire glisser le prix de haut en bas de l'échelle toute la journée, mais le DOM ne vous laisse pas modifier le nombre de contrats d'un ordre déjà actif. La case Qty ne définit que la taille du <em>prochain</em> ordre que vous envoyez, pas celle des ordres déjà en attente." },
    { type: "table", headers: ["Sur un ordre actif (en attente)","Pouvez-vous le modifier ?"], rows: [
      ["Prix / niveau de l'ordre","Oui, faites-le glisser sur l'échelle ou le graphique"],
      ["Quantité (nombre de contrats)","Non, il faut annuler et repasser l'ordre"],
    ] },
    { type: "paragraph",html: "Donc si vous avez 2 contrats actifs et décidez d'en vouloir 4, vous avez deux options propres :" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Annuler et repasser</strong>, supprimer l'ordre existant et en envoyer un nouveau à la nouvelle taille.",
        "<strong class='text-white'>Renforcer la position</strong>, laisser l'ordre d'origine et ajouter un ordre distinct pour les contrats supplémentaires.",
      ],
    },
    { type: "paragraph",html: "Vous gérerez ces ordres actifs depuis l'échelle ou depuis le module Orders de Tradovate, où l'annulation et le renvoi sont rapides. C'est une petite particularité, mais la connaître à l'avance vous évite de vous acharner sur un nombre qui n'allait jamais changer." },
    { type: "heading",text: "Pourquoi en avoir besoin" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Trader à la bonne taille</strong>, une case Qty verrouillée signifie moins d'erreurs de nombre de contrats sous pression.",
