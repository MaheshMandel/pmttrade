---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "tradovate-export-order-ids";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/how-to/${SLUG}`;

const META_TITLE = "Export Tradovate Trade Reports & Find Order IDs";
const META_DESCRIPTION =
  "Find any Tradovate Order ID fast: export the Orders report as CSV or PDF and match each fill's exact price, timestamp, and status.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Tradovate-Handelsberichte exportieren und Order-IDs finden", es: "Exporte informes de trading de Tradovate y encuentre los Order ID", fr: "Exporter les rapports de trading Tradovate et retrouver les Order ID", it: "Esportare i report di trading di Tradovate e trovare gli Order ID" },
  dek: { en: "Need a clean record of every order you've placed in Tradovate, the unique Order ID, the fill price, the exact timestamp? Here's how to export a trade report, step by step.", de: "Sie benötigen eine saubere Aufstellung jeder in Tradovate platzierten Order, mit eindeutiger Order-ID, Ausführungspreis und exaktem Zeitstempel? So exportieren Sie einen Handelsbericht Schritt für Schritt.", es: "¿Necesita un registro limpio de cada orden que ha colocado en Tradovate, con el Order ID único, el precio de ejecución y la marca de tiempo exacta? Así se exporta un informe de operaciones, paso a paso.", fr: "Besoin d'un relevé propre de chaque ordre passé dans Tradovate, avec l'Order ID unique, le prix d'exécution et l'horodatage exact ? Voici comment exporter un rapport de trades, étape par étape.", it: "Ha bisogno di un registro pulito di ogni ordine inserito in Tradovate, con l'Order ID univoco, il prezzo di esecuzione e l'orario esatto? Ecco come esportare un report delle operazioni, passo dopo passo." },
  readTime: { en: "5 min read", de: "5 Min. Lesezeit", es: "Lectura de 5 min", fr: "Lecture : 5 min", it: "Lettura di 5 min" },
  lastUpdated: "2026-07-08",
  heroImage: { src: `${IMG}/tradovate-export-order-ids-1.png`, alt: { en: "Tradovate account dropdown showing the gear icon and Account Reports option", de: "Tradovate account dropdown showing the gear icon and Account Reports option", es: "Tradovate account dropdown showing the gear icon and Account Reports option", fr: "Tradovate account dropdown showing the gear icon and Account Reports option", it: "Tradovate account dropdown showing the gear icon and Account Reports option" } },
  blocks: { en: [
    { type: "paragraph", html: "Need a clean record of every order you've placed in Tradovate, the unique Order ID, the fill price, the exact timestamp? Maybe you're auditing fills, prepping for taxes, disputing an execution, or wiring up automation. Whatever the reason, here's how to export a trade report and pull each Order ID, one step at a time." },
    { type: "heading", text: "What Is a Tradovate Order ID?" },
    { type: "paragraph", html: "An Order ID is the unique number Tradovate stamps on every order the second you submit it. That number stays glued to the order through every fill, modification, and cancellation, which is exactly why it's the most reliable way to look up what actually happened to a trade: the price it filled at, when it filled, and where it ended up. You'll find Order IDs inside the <strong class='text-white'>Orders</strong> report under Tradovate's Account Reports." },
    { type: "heading", text: "Export a Trade Report in Tradovate: Step-by-Step" },
    {
      type: "steps",
      items: [
        { title: "Open Account Reports", html: "In the Tradovate web or desktop trader, click your <strong class='text-white'>account name</strong> in the top-right corner to open the account dropdown. Then click the <strong class='text-white'>gear/settings icon</strong> and choose <strong class='text-white'>Account Reports</strong>." },
        { title: "Open the Orders Tab", html: "Inside the Account Reports panel, click the <strong class='text-white'>Orders</strong> tab. This one lists every order tied to the account, unlike <strong class='text-white'>Fills</strong>, <strong class='text-white'>Positions</strong>, or <strong class='text-white'>Cash History</strong>, which each slice your activity a different way." },
        { title: "Set Your Date Range and Filters", html: "Pick a date range with the quick presets, <strong class='text-white'>Today</strong>, <strong class='text-white'>Yesterday</strong>, <strong class='text-white'>This Week</strong>, <strong class='text-white'>This Month</strong>, or type custom <strong class='text-white'>From/To</strong> dates if you need a specific window. Want to narrow things down further? Use the <strong class='text-white'>Add Filter</strong> dropdown to filter by Contract, Product, Account, or Order Status. When it looks right, click <strong class='text-white'>Go</strong> to generate the report." },
        { title: "Export as CSV or PDF", html: "With the report on screen, pick your format. <strong class='text-white'>Download CSV</strong> gives you a spreadsheet you can sort, slice, and import into a journal. <strong class='text-white'>Download PDF</strong> gives you a clean, print-ready record. Either way, Tradovate builds the file and drops it into your downloads." },
        { title: "Find the Order ID Column", html: "Open the exported file. Every row is a single order, and the <strong class='text-white'>Order ID</strong> column (sometimes labeled <em>order number</em>) sits right alongside Action, Qty, Contract, Type, Status, Fill Time, Fill Price, and Account. Match the Order ID to the trade you're chasing down and you've got its price, its timestamp, and its execution status in one line." },
      ],
    },
    { type: "image", src: `${IMG}/tradovate-export-order-ids-2.png`, alt: "Tradovate Account Reports panel with the Orders tab selected" },
    { type: "image", src: `${IMG}/tradovate-export-order-ids-3.png`, alt: "Tradovate Orders report date-range presets and Add Filter dropdown" },
    { type: "image", src: `${IMG}/tradovate-export-order-ids-4.png`, alt: "Tradovate Orders report showing the Download CSV and Download PDF export buttons" },
    { type: "image", src: `${IMG}/tradovate-export-order-ids-5.png`, alt: "Exported Tradovate Orders report with the Order ID column highlighted" },
    { type: "heading", text: "Why You'd Need This" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Auditing fills</strong>, confirm the exact price and time an order executed.",
        "<strong class='text-white'>Tax records</strong>, hand a clean, dated report to your accountant at year-end.",
        "<strong class='text-white'>Disputing a fill</strong>, reference the specific Order ID when you contact the help desk.",
        "<strong class='text-white'>Journaling</strong>, import trades into tools like TradesViz, TradeZella, or Edgewonk.",
        "<strong class='text-white'>Reconciling automation</strong>, match automated orders back to the alerts that triggered them.",
      ],
    },
    { type: "heading", text: "Automate This with PickMyTrade" },
    { type: "paragraph", html: "If you're exporting reports mostly to double-check that your automated orders fired correctly, PickMyTrade saves you the round-trip. It links your TradingView alerts straight to your Tradovate account, so every signal becomes a real order, with its own Order ID logged automatically, and no clicking back and forth between the chart and the reports panel. Export a report later, and each row lines up cleanly with the alert that created it." },
  ], de: [
    { type: "paragraph",html: "Sie benötigen eine saubere Aufstellung jeder in Tradovate platzierten Order, mit eindeutiger Order-ID, Ausführungspreis und exaktem Zeitstempel? Vielleicht prüfen Sie Ausführungen, bereiten Ihre Steuererklärung vor, beanstanden eine Ausführung oder richten eine Automatisierung ein. Was auch immer der Grund ist: So exportieren Sie einen Handelsbericht und ziehen Schritt für Schritt jede Order-ID heraus." },
    { type: "heading",text: "Was ist eine Tradovate-Order-ID?" },
    { type: "paragraph",html: "Eine Order-ID ist die eindeutige Nummer, die Tradovate jeder Order in dem Moment zuweist, in dem Sie sie absenden. Diese Nummer bleibt der Order über jede Ausführung, Änderung und Stornierung hinweg zugeordnet. Genau deshalb ist sie der verlässlichste Weg, nachzuvollziehen, was mit einem Trade tatsächlich geschehen ist: zu welchem Preis er ausgeführt wurde, wann das geschah und wo er am Ende gelandet ist. Order-IDs finden Sie im Bericht <strong class='text-white'>Orders</strong> unter den Account Reports von Tradovate." },
    { type: "heading",text: "Handelsbericht in Tradovate exportieren: Schritt für Schritt" },
    {
      type: "steps",
      items: [
        { title: "Account Reports öffnen", html: "Klicken Sie im Tradovate-Webtrader oder Desktop-Trader oben rechts auf Ihren <strong class='text-white'>Kontonamen</strong>, um das Konto-Dropdown zu öffnen. Klicken Sie anschließend auf das <strong class='text-white'>Zahnrad-/Einstellungssymbol</strong> und wählen Sie <strong class='text-white'>Account Reports</strong>." },
        { title: "Tab „Orders“ öffnen", html: "Klicken Sie im Bereich Account Reports auf den Tab <strong class='text-white'>Orders</strong>. Er listet jede mit dem Konto verbundene Order auf, im Gegensatz zu <strong class='text-white'>Fills</strong>, <strong class='text-white'>Positions</strong> oder <strong class='text-white'>Cash History</strong>, die Ihre Aktivität jeweils anders aufschlüsseln." },
        { title: "Zeitraum und Filter festlegen", html: "Wählen Sie den Zeitraum über die Schnellauswahl, <strong class='text-white'>Today</strong>, <strong class='text-white'>Yesterday</strong>, <strong class='text-white'>This Week</strong>, <strong class='text-white'>This Month</strong>, oder geben Sie eigene <strong class='text-white'>From/To</strong>-Daten ein, wenn Sie ein bestimmtes Zeitfenster benötigen. Möchten Sie weiter eingrenzen? Nutzen Sie das Dropdown <strong class='text-white'>Add Filter</strong>, um nach Contract, Product, Account oder Order Status zu filtern. Wenn alles passt, klicken Sie auf <strong class='text-white'>Go</strong>, um den Bericht zu erstellen." },
        { title: "Als CSV oder PDF exportieren", html: "Wählen Sie bei angezeigtem Bericht Ihr Format. <strong class='text-white'>Download CSV</strong> liefert eine Tabelle, die Sie sortieren, filtern und in ein Journal importieren können. <strong class='text-white'>Download PDF</strong> liefert einen sauberen, druckfertigen Nachweis. In beiden Fällen erstellt Tradovate die Datei und legt sie in Ihren Downloads ab." },
        { title: "Die Spalte „Order ID“ finden", html: "Öffnen Sie die exportierte Datei. Jede Zeile entspricht genau einer Order, und die Spalte <strong class='text-white'>Order ID</strong> (manchmal als <em>Order-Nummer</em> bezeichnet) steht direkt neben Action, Qty, Contract, Type, Status, Fill Time, Fill Price und Account. Ordnen Sie die Order-ID dem gesuchten Trade zu, und Sie haben Preis, Zeitstempel und Ausführungsstatus in einer Zeile." },
      ],
    },
    { type: "image",src: `${IMG}/tradovate-export-order-ids-2.png`,alt: "Tradovate-Bereich Account Reports mit ausgewähltem Tab Orders" },
    { type: "image",src: `${IMG}/tradovate-export-order-ids-3.png`,alt: "Datumsvorgaben und Dropdown Add Filter im Tradovate-Orders-Bericht" },
    { type: "image",src: `${IMG}/tradovate-export-order-ids-4.png`,alt: "Tradovate-Orders-Bericht mit den Export-Schaltflächen Download CSV und Download PDF" },
    { type: "image",src: `${IMG}/tradovate-export-order-ids-5.png`,alt: "Exportierter Tradovate-Orders-Bericht mit hervorgehobener Spalte Order ID" },
    { type: "heading",text: "Wofür Sie das brauchen" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Ausführungen prüfen</strong>, bestätigen Sie den exakten Preis und Zeitpunkt, zu dem eine Order ausgeführt wurde.",
        "<strong class='text-white'>Steuerunterlagen</strong>, übergeben Sie Ihrem Steuerberater zum Jahresende einen sauberen, datierten Bericht.",
        "<strong class='text-white'>Ausführung beanstanden</strong>, nennen Sie die konkrete Order-ID, wenn Sie den Support kontaktieren.",
        "<strong class='text-white'>Journaling</strong>, importieren Sie Trades in Tools wie TradesViz, TradeZella oder Edgewonk.",
        "<strong class='text-white'>Automatisierung abgleichen</strong>, ordnen Sie automatisierte Orders den Alerts zu, die sie ausgelöst haben.",
      ],
    },
    { type: "heading",text: "Automatisieren Sie das mit PickMyTrade" },
    { type: "paragraph",html: "Wenn Sie Berichte hauptsächlich exportieren, um zu prüfen, ob Ihre automatisierten Orders korrekt ausgelöst wurden, erspart Ihnen PickMyTrade den Umweg. Es verbindet Ihre TradingView-Alerts direkt mit Ihrem Tradovate-Konto, sodass jedes Signal zu einer echten Order wird, deren Order-ID automatisch protokolliert wird, ganz ohne Hin- und Herklicken zwischen Chart und Berichtsbereich. Exportieren Sie später einen Bericht, ordnet sich jede Zeile sauber dem Alert zu, der sie erzeugt hat." },
  ], es: [
    { type: "paragraph",html: "¿Necesita un registro limpio de cada orden que ha colocado en Tradovate, con el Order ID único, el precio de ejecución y la marca de tiempo exacta? Quizá esté auditando ejecuciones, preparando impuestos, disputando una ejecución o configurando una automatización. Sea cual sea el motivo, así se exporta un informe de operaciones y se obtiene cada Order ID, paso a paso." },
    { type: "heading",text: "¿Qué es un Order ID de Tradovate?" },
    { type: "paragraph",html: "Un Order ID es el número único que Tradovate asigna a cada orden en el instante en que la envía. Ese número permanece ligado a la orden a lo largo de cada ejecución, modificación y cancelación, y por eso es la forma más fiable de consultar qué ocurrió realmente con una operación: el precio al que se ejecutó, cuándo se ejecutó y en qué estado terminó. Encontrará los Order ID dentro del informe <strong class='text-white'>Orders</strong> en los Account Reports de Tradovate." },
    { type: "heading",text: "Exportar un informe de operaciones en Tradovate: paso a paso" },
    {
      type: "steps",
      items: [
        { title: "Abra Account Reports", html: "En el trader web o de escritorio de Tradovate, haga clic en el <strong class='text-white'>nombre de su cuenta</strong> en la esquina superior derecha para abrir el menú desplegable de la cuenta. A continuación, haga clic en el <strong class='text-white'>icono de engranaje/ajustes</strong> y elija <strong class='text-white'>Account Reports</strong>." },
        { title: "Abra la pestaña Orders", html: "Dentro del panel Account Reports, haga clic en la pestaña <strong class='text-white'>Orders</strong>. Esta enumera todas las órdenes asociadas a la cuenta, a diferencia de <strong class='text-white'>Fills</strong>, <strong class='text-white'>Positions</strong> o <strong class='text-white'>Cash History</strong>, que desglosan su actividad de otra manera." },
        { title: "Defina el rango de fechas y los filtros", html: "Elija un rango de fechas con los ajustes rápidos, <strong class='text-white'>Today</strong>, <strong class='text-white'>Yesterday</strong>, <strong class='text-white'>This Week</strong>, <strong class='text-white'>This Month</strong>, o escriba fechas <strong class='text-white'>From/To</strong> personalizadas si necesita un periodo concreto. ¿Quiere acotar aún más? Use el menú desplegable <strong class='text-white'>Add Filter</strong> para filtrar por Contract, Product, Account u Order Status. Cuando todo esté correcto, haga clic en <strong class='text-white'>Go</strong> para generar el informe." },
        { title: "Exporte en CSV o PDF", html: "Con el informe en pantalla, elija el formato. <strong class='text-white'>Download CSV</strong> le ofrece una hoja de cálculo que puede ordenar, filtrar e importar a un diario de trading. <strong class='text-white'>Download PDF</strong> le ofrece un registro limpio y listo para imprimir. En ambos casos, Tradovate genera el archivo y lo guarda en sus descargas." },
        { title: "Localice la columna Order ID", html: "Abra el archivo exportado. Cada fila es una única orden, y la columna <strong class='text-white'>Order ID</strong> (a veces denominada <em>número de orden</em>) aparece junto a Action, Qty, Contract, Type, Status, Fill Time, Fill Price y Account. Relacione el Order ID con la operación que busca y tendrá su precio, su marca de tiempo y su estado de ejecución en una sola línea." },
      ],
    },
    { type: "image",src: `${IMG}/tradovate-export-order-ids-2.png`,alt: "Panel Account Reports de Tradovate con la pestaña Orders seleccionada" },
    { type: "image",src: `${IMG}/tradovate-export-order-ids-3.png`,alt: "Ajustes predefinidos de rango de fechas y menú desplegable Add Filter del informe Orders de Tradovate" },
    { type: "image",src: `${IMG}/tradovate-export-order-ids-4.png`,alt: "Informe Orders de Tradovate con los botones de exportación Download CSV y Download PDF" },
    { type: "image",src: `${IMG}/tradovate-export-order-ids-5.png`,alt: "Informe Orders de Tradovate exportado con la columna Order ID resaltada" },
    { type: "heading",text: "Para qué le sirve" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Auditar ejecuciones</strong>, confirme el precio y la hora exactos a los que se ejecutó una orden.",
        "<strong class='text-white'>Registros fiscales</strong>, entregue a su contable un informe limpio y fechado al cierre del año.",
        "<strong class='text-white'>Disputar una ejecución</strong>, cite el Order ID concreto al contactar con el servicio de asistencia.",
        "<strong class='text-white'>Diario de trading</strong>, importe operaciones a herramientas como TradesViz, TradeZella o Edgewonk.",
        "<strong class='text-white'>Conciliar la automatización</strong>, relacione las órdenes automáticas con las alertas que las activaron.",
      ],
    },
    { type: "heading",text: "Automatice esto con PickMyTrade" },
    { type: "paragraph",html: "Si exporta informes sobre todo para comprobar que sus órdenes automáticas se ejecutaron correctamente, PickMyTrade le ahorra el viaje de ida y vuelta. Conecta sus alertas de TradingView directamente con su cuenta de Tradovate, de modo que cada señal se convierte en una orden real, con su propio Order ID registrado automáticamente, y sin ir y venir entre el gráfico y el panel de informes. Si exporta un informe más adelante, cada fila coincide limpiamente con la alerta que la generó." },
  ], fr: [
    { type: "paragraph",html: "Besoin d'un relevé propre de chaque ordre passé dans Tradovate, avec l'Order ID unique, le prix d'exécution et l'horodatage exact ? Peut-être auditez-vous vos exécutions, préparez-vous vos impôts, contestez-vous une exécution ou mettez-vous en place une automatisation. Quelle que soit la raison, voici comment exporter un rapport de trades et récupérer chaque Order ID, étape par étape." },
    { type: "heading",text: "Qu'est-ce qu'un Order ID Tradovate ?" },
    { type: "paragraph",html: "Un Order ID est le numéro unique que Tradovate attribue à chaque ordre à la seconde où vous le soumettez. Ce numéro reste associé à l'ordre à travers chaque exécution, modification et annulation ; c'est précisément pourquoi il constitue le moyen le plus fiable de retrouver ce qui s'est réellement passé pour un trade : le prix d'exécution, le moment de l'exécution et l'état final. Vous trouverez les Order ID dans le rapport <strong class='text-white'>Orders</strong> des Account Reports de Tradovate." },
    { type: "heading",text: "Exporter un rapport de trades dans Tradovate : pas à pas" },
    {
      type: "steps",
      items: [
        { title: "Ouvrez Account Reports", html: "Dans le trader web ou de bureau Tradovate, cliquez sur le <strong class='text-white'>nom de votre compte</strong> en haut à droite pour ouvrir le menu déroulant du compte. Cliquez ensuite sur l'<strong class='text-white'>icône d'engrenage/paramètres</strong> et choisissez <strong class='text-white'>Account Reports</strong>." },
        { title: "Ouvrez l'onglet Orders", html: "Dans le panneau Account Reports, cliquez sur l'onglet <strong class='text-white'>Orders</strong>. Il répertorie tous les ordres liés au compte, contrairement à <strong class='text-white'>Fills</strong>, <strong class='text-white'>Positions</strong> ou <strong class='text-white'>Cash History</strong>, qui découpent chacun votre activité différemment." },
        { title: "Définissez la période et les filtres", html: "Choisissez une période avec les préréglages rapides, <strong class='text-white'>Today</strong>, <strong class='text-white'>Yesterday</strong>, <strong class='text-white'>This Week</strong>, <strong class='text-white'>This Month</strong>, ou saisissez des dates <strong class='text-white'>From/To</strong> personnalisées si vous avez besoin d'une fenêtre précise. Envie d'affiner ? Utilisez le menu déroulant <strong class='text-white'>Add Filter</strong> pour filtrer par Contract, Product, Account ou Order Status. Quand tout est correct, cliquez sur <strong class='text-white'>Go</strong> pour générer le rapport." },
        { title: "Exportez en CSV ou en PDF", html: "Le rapport étant affiché, choisissez votre format. <strong class='text-white'>Download CSV</strong> vous donne un tableur que vous pouvez trier, filtrer et importer dans un journal de trading. <strong class='text-white'>Download PDF</strong> vous donne un document propre, prêt à imprimer. Dans les deux cas, Tradovate génère le fichier et le place dans vos téléchargements." },
        { title: "Repérez la colonne Order ID", html: "Ouvrez le fichier exporté. Chaque ligne correspond à un seul ordre, et la colonne <strong class='text-white'>Order ID</strong> (parfois appelée <em>numéro d'ordre</em>) se trouve juste à côté de Action, Qty, Contract, Type, Status, Fill Time, Fill Price et Account. Associez l'Order ID au trade que vous recherchez et vous obtenez son prix, son horodatage et son statut d'exécution sur une seule ligne." },
      ],
    },
    { type: "image",src: `${IMG}/tradovate-export-order-ids-2.png`,alt: "Panneau Account Reports de Tradovate avec l'onglet Orders sélectionné" },
    { type: "image",src: `${IMG}/tradovate-export-order-ids-3.png`,alt: "Préréglages de période et menu déroulant Add Filter du rapport Orders de Tradovate" },
    { type: "image",src: `${IMG}/tradovate-export-order-ids-4.png`,alt: "Rapport Orders de Tradovate avec les boutons d'export Download CSV et Download PDF" },
    { type: "image",src: `${IMG}/tradovate-export-order-ids-5.png`,alt: "Rapport Orders Tradovate exporté avec la colonne Order ID mise en évidence" },
    { type: "heading",text: "Pourquoi vous en avez besoin" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Auditer les exécutions</strong>, confirmez le prix et l'heure exacts d'exécution d'un ordre.",
        "<strong class='text-white'>Justificatifs fiscaux</strong>, remettez à votre comptable un rapport propre et daté en fin d'année.",
        "<strong class='text-white'>Contester une exécution</strong>, indiquez l'Order ID précis lorsque vous contactez le support.",
        "<strong class='text-white'>Journal de trading</strong>, importez vos trades dans des outils comme TradesViz, TradeZella ou Edgewonk.",
        "<strong class='text-white'>Réconcilier l'automatisation</strong>, rapprochez les ordres automatisés des alertes qui les ont déclenchés.",
      ],
    },
    { type: "heading",text: "Automatisez cela avec PickMyTrade" },
    { type: "paragraph",html: "Si vous exportez des rapports surtout pour vérifier que vos ordres automatisés se sont bien déclenchés, PickMyTrade vous épargne l'aller-retour. Il relie vos alertes TradingView directement à votre compte Tradovate, de sorte que chaque signal devient un véritable ordre, avec son propre Order ID enregistré automatiquement, sans navigation incessante entre le graphique et le panneau des rapports. Exportez un rapport plus tard, et chaque ligne correspond proprement à l'alerte qui l'a créée." },
  ], it: [
    { type: "paragraph",html: "Ha bisogno di un registro pulito di ogni ordine inserito in Tradovate, con l'Order ID univoco, il prezzo di esecuzione e l'orario esatto? Magari sta verificando le esecuzioni, preparando le tasse, contestando un'esecuzione o configurando un'automazione. Qualunque sia il motivo, ecco come esportare un report delle operazioni e ricavare ogni Order ID, un passaggio alla volta." },
    { type: "heading",text: "Che cos'è un Order ID di Tradovate?" },
    { type: "paragraph",html: "Un Order ID è il numero univoco che Tradovate assegna a ogni ordine nel momento stesso in cui lo invia. Quel numero resta legato all'ordine attraverso ogni esecuzione, modifica e cancellazione, ed è proprio per questo il modo più affidabile per verificare che cosa è realmente accaduto a un'operazione: il prezzo a cui è stata eseguita, quando e come si è conclusa. Troverà gli Order ID nel report <strong class='text-white'>Orders</strong> all'interno degli Account Reports di Tradovate." },
    { type: "heading",text: "Esportare un report delle operazioni in Tradovate: passo dopo passo" },
    {
      type: "steps",
      items: [
        { title: "Apra Account Reports", html: "Nel trader web o desktop di Tradovate, clicchi sul <strong class='text-white'>nome del conto</strong> in alto a destra per aprire il menu a discesa dell'account. Poi clicchi sull'<strong class='text-white'>icona a ingranaggio/impostazioni</strong> e scelga <strong class='text-white'>Account Reports</strong>." },
        { title: "Apra la scheda Orders", html: "All'interno del pannello Account Reports, clicchi sulla scheda <strong class='text-white'>Orders</strong>. Elenca tutti gli ordini associati al conto, a differenza di <strong class='text-white'>Fills</strong>, <strong class='text-white'>Positions</strong> o <strong class='text-white'>Cash History</strong>, che suddividono ciascuno la sua attività in modo diverso." },
        { title: "Imposti intervallo di date e filtri", html: "Scelga un intervallo di date con i preset rapidi, <strong class='text-white'>Today</strong>, <strong class='text-white'>Yesterday</strong>, <strong class='text-white'>This Week</strong>, <strong class='text-white'>This Month</strong>, oppure digiti date <strong class='text-white'>From/To</strong> personalizzate se le serve una finestra specifica. Vuole restringere ulteriormente? Usi il menu a discesa <strong class='text-white'>Add Filter</strong> per filtrare per Contract, Product, Account o Order Status. Quando tutto è corretto, clicchi su <strong class='text-white'>Go</strong> per generare il report." },
        { title: "Esporti in CSV o PDF", html: "Con il report a schermo, scelga il formato. <strong class='text-white'>Download CSV</strong> le fornisce un foglio di calcolo che può ordinare, filtrare e importare in un diario di trading. <strong class='text-white'>Download PDF</strong> le fornisce un documento pulito, pronto per la stampa. In entrambi i casi, Tradovate crea il file e lo salva nei suoi download." },
        { title: "Trovi la colonna Order ID", html: "Apra il file esportato. Ogni riga è un singolo ordine e la colonna <strong class='text-white'>Order ID</strong> (a volte indicata come <em>numero d'ordine</em>) si trova accanto ad Action, Qty, Contract, Type, Status, Fill Time, Fill Price e Account. Abbini l'Order ID all'operazione che sta cercando e avrà prezzo, orario e stato di esecuzione in un'unica riga." },
      ],
    },
