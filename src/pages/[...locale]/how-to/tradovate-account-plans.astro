---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "tradovate-account-plans";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/how-to/${SLUG}`;

const META_TITLE = "Tradovate Plans: Free vs Monthly vs Lifetime";
const META_DESCRIPTION =
  "Tradovate account plans explained: compare Free, Monthly, and Lifetime tiers on cost and per-side commissions to pick the cheapest for you.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Tradovate-Pläne: Free vs. Monthly vs. Lifetime", es: "Planes de Tradovate: Free vs Monthly vs Lifetime", fr: "Plans Tradovate : Free vs Monthly vs Lifetime", it: "Piani Tradovate: Free vs Monthly vs Lifetime" },
  dek: { en: "Picking the right Tradovate plan can quietly save you hundreds of dollars a year in commissions, or cost you that much if you guess wrong. Here's how the three account plans stack up and how to land on the cheapest one for the way you actually trade.", de: "Der richtige Tradovate-Plan kann Ihnen unbemerkt Hunderte Dollar Kommissionen pro Jahr sparen, oder genauso viel kosten, wenn Sie falsch raten. So schneiden die drei Kontopläne ab und so finden Sie den günstigsten für die Art, wie Sie tatsächlich handeln.", es: "Elegir el plan de Tradovate adecuado puede ahorrarle discretamente cientos de dólares al año en comisiones, o costarle lo mismo si se equivoca. Así se comparan los tres planes de cuenta y cómo llegar al más barato para la forma en que realmente opera.", fr: "Choisir le bon plan Tradovate peut vous faire économiser discrètement des centaines de dollars de commissions par an, ou vous coûter autant si vous vous trompez. Voici comment se comparent les trois plans de compte et comment choisir le moins cher selon votre façon réelle de trader.", it: "Scegliere il piano Tradovate giusto può farle risparmiare in silenzio centinaia di dollari l'anno in commissioni, o costarle altrettanto se sbaglia. Ecco come si confrontano i tre piani del conto e come arrivare al più economico per il modo in cui opera davvero." },
  readTime: { en: "6 min read", de: "6 Min. Lesezeit", es: "Lectura de 6 min", fr: "Lecture : 6 min", it: "Lettura di 6 min" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "Picking the right Tradovate plan can quietly save you hundreds of dollars a year in commissions, or cost you that much if you guess wrong. Whether you're a new futures trader shopping brokers or wiring up automation with PickMyTrade, here's how the three Tradovate account plans stack up and how to land on the cheapest one for the way you actually trade." },
    { type: "heading", text: "What Are Tradovate Account Plans?" },
    { type: "paragraph", html: "A Tradovate account plan (you'll sometimes see it called a membership) sets the per-side commission you pay on every futures contract you trade. Every account opens on the Free plan by default. Pay a monthly or one-time fee and your commission rate drops in steps. You only need one plan per login, and you can move between tiers whenever your trading changes." },
    { type: "heading", text: "Choosing Your Tradovate Plan: Step-by-Step" },
    {
      type: "steps",
      items: [
        { title: "Understand the Three Tiers", html: "Tradovate runs three plans, and each one trades a fixed subscription cost against your commission rate: <strong class='text-white'>Free</strong>, no monthly fee, but the highest per-contract commissions; <strong class='text-white'>Monthly</strong>, a flat monthly fee that pulls your commissions down; and <strong class='text-white'>Lifetime</strong>, a bigger one-time payment (or a few installments) that locks in the lowest commissions for good. Prices and exact rates shift over time, so check the current numbers on Tradovate's live pricing page before you commit to anything." },
        { title: "Compare Per-Side Commissions", html: "The real difference between the tiers is the <strong class='text-white'>commission per side</strong>, you pay it once when you enter and again when you exit. Micro contracts always cost less than standard e-minis, and no matter which tier you're on you'll still pay exchange, clearing, and NFA fees on top of the commission. See the table below for how the tiers lined up as of July 2026, confirm the live rates before you decide." },
        { title: "Find Your Break-Even Point", html: "The right plan comes down to how many contracts you trade. A paid plan only starts saving you money once the commission you shave off outweighs its fixed cost. For a quick gut check, divide the monthly fee by the per-side commission you'd save versus Free, that tells you how many sides you'd need to trade each month just to break even. Trade occasionally or in small size and Free usually wins. Trade actively every day and Monthly or Lifetime tends to come out ahead." },
        { title: "Select or Switch Your Plan", html: "You change plans inside the Tradovate Web Trader, not on the website. Log in to the Tradovate Web Trader, open <strong class='text-white'>Application Settings</strong> (top-right), then the <strong class='text-white'>Subscriptions</strong> (Plans) tab. In the <strong class='text-white'>Membership</strong> section, click <strong class='text-white'>Upgrade</strong> and choose your new plan, want to split Lifetime into installments? Toggle the <strong class='text-white'>4 Payments</strong> option first. Confirm and pay with your account balance or a card, then log out and back in so the new plan shows on the <strong class='text-white'>Settings &rsaquo; Plans</strong> page." },
      ],
    },
    {
      type: "table",
      headers: ["Plan", "Cost", "Micros (per side)", "Standard e-mini (per side)"],
      rows: [
        ["Free", "$0 / month", "$0.39", "$1.29"],
        ["Monthly", "$99 / month", "$0.29", "$0.99"],
        ["Lifetime", "$1,499 one-time (or 4 &times; $499)", "$0.09", "$0.59"],
      ],
    },
    { type: "paragraph", html: "Exchange, clearing, and NFA fees apply on all three tiers and aren't baked into the figures above." },
    { type: "heading", text: "Why You'd Need This" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Cut trading costs</strong>, matching your plan to your volume can save you real money on commissions.",
        "<strong class='text-white'>Budget accurately</strong>, know your fixed monthly cost before you go live.",
        "<strong class='text-white'>Compare brokers fairly</strong>, line Tradovate's all-in rate up against the alternatives.",
        "<strong class='text-white'>Avoid surprise fees</strong>, the Free plan can carry an inactivity fee if you don't trade within a set window, and prop-firm and evaluation rules vary by firm and account size, so check your firm's current rules too.",
      ],
    },
    { type: "heading", text: "Automate This with PickMyTrade" },
    { type: "paragraph", html: "<strong class='text-white'>PickMyTrade wires your TradingView alerts straight through to your Tradovate account</strong>. Once you've settled on a plan, your strategy executes on its own, no manual clicks, no missed fills, whatever commission tier you land on." },
  ], de: [
    { type: "paragraph",html: "Der richtige Tradovate-Plan kann Ihnen unbemerkt Hunderte Dollar Kommissionen pro Jahr sparen, oder genauso viel kosten, wenn Sie falsch raten. Ob Sie als neuer Futures-Trader Broker vergleichen oder eine Automatisierung mit PickMyTrade einrichten: So schneiden die drei Tradovate-Kontopläne ab und so finden Sie den günstigsten für die Art, wie Sie tatsächlich handeln." },
    { type: "heading",text: "Was sind Tradovate-Kontopläne?" },
    { type: "paragraph",html: "Ein Tradovate-Kontoplan (manchmal auch Mitgliedschaft genannt) legt die Kommission pro Seite fest, die Sie für jeden gehandelten Futures-Kontrakt zahlen. Jedes Konto startet standardmäßig im Free-Plan. Wenn Sie eine monatliche oder einmalige Gebühr zahlen, sinkt Ihr Kommissionssatz stufenweise. Sie benötigen nur einen Plan pro Login und können die Stufe jederzeit wechseln, wenn sich Ihr Handel ändert." },
    { type: "heading",text: "Ihren Tradovate-Plan wählen: Schritt für Schritt" },
    {
      type: "steps",
      items: [
        { title: "Die drei Stufen verstehen", html: "Tradovate bietet drei Pläne, und jeder wägt feste Abokosten gegen Ihren Kommissionssatz ab: <strong class='text-white'>Free</strong>, keine Monatsgebühr, aber die höchsten Kommissionen pro Kontrakt; <strong class='text-white'>Monthly</strong>, eine feste Monatsgebühr, die Ihre Kommissionen senkt; und <strong class='text-white'>Lifetime</strong>, eine größere Einmalzahlung (oder einige Raten), die die niedrigsten Kommissionen dauerhaft sichert. Preise und genaue Sätze ändern sich im Laufe der Zeit, prüfen Sie daher die aktuellen Zahlen auf der Live-Preisseite von Tradovate, bevor Sie sich festlegen." },
        { title: "Kommissionen pro Seite vergleichen", html: "Der eigentliche Unterschied zwischen den Stufen ist die <strong class='text-white'>Kommission pro Seite</strong>, Sie zahlen sie einmal beim Einstieg und noch einmal beim Ausstieg. Micro-Kontrakte kosten immer weniger als Standard-E-Minis, und unabhängig von der Stufe zahlen Sie zusätzlich zur Kommission Börsen-, Clearing- und NFA-Gebühren. In der Tabelle unten sehen Sie, wie die Stufen im Juli 2026 lagen. Bestätigen Sie die aktuellen Sätze, bevor Sie sich entscheiden." },
        { title: "Ihren Break-even-Punkt finden", html: "Der richtige Plan hängt davon ab, wie viele Kontrakte Sie handeln. Ein kostenpflichtiger Plan spart erst dann Geld, wenn die eingesparte Kommission seine Fixkosten übersteigt. Für eine schnelle Faustregel teilen Sie die Monatsgebühr durch die Kommission pro Seite, die Sie gegenüber Free sparen würden, das zeigt, wie viele Seiten Sie pro Monat handeln müssten, um nur den Break-even zu erreichen. Wenn Sie gelegentlich oder in kleiner Größe handeln, gewinnt meist Free. Wenn Sie täglich aktiv handeln, liegen Monthly oder Lifetime tendenziell vorn." },
        { title: "Plan auswählen oder wechseln", html: "Sie ändern Ihren Plan im Tradovate Web Trader, nicht auf der Website. Melden Sie sich im Tradovate Web Trader an, öffnen Sie <strong class='text-white'>Application Settings</strong> (oben rechts) und dann den Tab <strong class='text-white'>Subscriptions</strong> (Plans). Klicken Sie im Bereich <strong class='text-white'>Membership</strong> auf <strong class='text-white'>Upgrade</strong> und wählen Sie Ihren neuen Plan. Möchten Sie Lifetime in Raten aufteilen? Aktivieren Sie zuerst die Option <strong class='text-white'>4 Payments</strong>. Bestätigen Sie und zahlen Sie mit Ihrem Kontoguthaben oder per Karte, melden Sie sich dann ab und wieder an, damit der neue Plan auf der Seite <strong class='text-white'>Settings &rsaquo; Plans</strong> angezeigt wird." },
      ],
    },
    { type: "table", headers: ["Plan","Kosten","Micros (pro Seite)","Standard-E-Mini (pro Seite)"], rows: [
      ["Free","$0 / Monat","$0.39","$1.29"],
      ["Monthly","$99 / Monat","$0.29","$0.99"],
      ["Lifetime","$1,499 einmalig (oder 4 &times; $499)","$0.09","$0.59"],
    ] },
    { type: "paragraph",html: "Börsen-, Clearing- und NFA-Gebühren fallen bei allen drei Stufen an und sind in den obigen Zahlen nicht enthalten." },
    { type: "heading",text: "Warum Sie das benötigen" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Handelskosten senken</strong>, wenn Sie Ihren Plan an Ihr Volumen anpassen, sparen Sie bei den Kommissionen echtes Geld.",
        "<strong class='text-white'>Genau budgetieren</strong>, kennen Sie Ihre festen Monatskosten, bevor Sie live gehen.",
        "<strong class='text-white'>Broker fair vergleichen</strong>, stellen Sie die Gesamtsätze von Tradovate denen der Alternativen gegenüber.",
        "<strong class='text-white'>Überraschungsgebühren vermeiden</strong>, der Free-Plan kann eine Inaktivitätsgebühr verlangen, wenn Sie innerhalb eines bestimmten Zeitraums nicht handeln, und die Regeln von Prop-Firmen und Evaluierungen unterscheiden sich je nach Firma und Kontogröße. Prüfen Sie daher auch die aktuellen Regeln Ihrer Firma.",
      ],
    },
    { type: "heading",text: "Automatisieren Sie das mit PickMyTrade" },
    { type: "paragraph",html: "<strong class='text-white'>PickMyTrade leitet Ihre TradingView-Alerts direkt an Ihr Tradovate-Konto weiter</strong>. Sobald Sie sich für einen Plan entschieden haben, führt sich Ihre Strategie von selbst aus, ohne manuelle Klicks, ohne verpasste Fills, egal in welcher Kommissionsstufe Sie landen." },
  ], es: [
    { type: "paragraph",html: "Elegir el plan de Tradovate adecuado puede ahorrarle discretamente cientos de dólares al año en comisiones, o costarle lo mismo si se equivoca. Tanto si es un trader de futuros novato que compara brókers como si está montando una automatización con PickMyTrade, así se comparan los tres planes de cuenta de Tradovate y cómo llegar al más barato para la forma en que realmente opera." },
    { type: "heading",text: "¿Qué son los planes de cuenta de Tradovate?" },
    { type: "paragraph",html: "Un plan de cuenta de Tradovate (a veces llamado membresía) establece la comisión por lado que paga por cada contrato de futuros que opera. Todas las cuentas se abren por defecto con el plan Free. Si paga una cuota mensual o única, su tarifa de comisión baja por escalones. Solo necesita un plan por inicio de sesión y puede cambiar de nivel cuando cambie su operativa." },
    { type: "heading",text: "Cómo elegir su plan de Tradovate: paso a paso" },
    {
      type: "steps",
      items: [
        { title: "Entienda los tres niveles", html: "Tradovate ofrece tres planes, y cada uno equilibra un coste de suscripción fijo frente a su tarifa de comisión: <strong class='text-white'>Free</strong>, sin cuota mensual, pero con las comisiones por contrato más altas; <strong class='text-white'>Monthly</strong>, una cuota mensual fija que reduce sus comisiones; y <strong class='text-white'>Lifetime</strong>, un pago único mayor (o unos pocos plazos) que fija las comisiones más bajas para siempre. Los precios y las tarifas exactas cambian con el tiempo, así que consulte las cifras vigentes en la página de precios en vivo de Tradovate antes de comprometerse con nada." },
        { title: "Compare las comisiones por lado", html: "La verdadera diferencia entre los niveles es la <strong class='text-white'>comisión por lado</strong>, la paga una vez al entrar y otra al salir. Los contratos micro siempre cuestan menos que los e-minis estándar, y en cualquier nivel seguirá pagando tarifas de bolsa, compensación y NFA además de la comisión. Consulte la tabla de abajo para ver cómo se situaban los niveles en julio de 2026 y confirme las tarifas vigentes antes de decidir." },
        { title: "Encuentre su punto de equilibrio", html: "El plan adecuado depende de cuántos contratos opere. Un plan de pago solo empieza a ahorrarle dinero cuando la comisión que se ahorra supera su coste fijo. Para una estimación rápida, divida la cuota mensual entre la comisión por lado que ahorraría frente a Free; eso le indica cuántos lados tendría que operar cada mes solo para llegar al punto de equilibrio. Si opera de forma ocasional o con poco tamaño, Free suele ganar. Si opera activamente todos los días, Monthly o Lifetime tienden a salir mejor." },
        { title: "Seleccione o cambie su plan", html: "Cambia de plan dentro del Tradovate Web Trader, no en el sitio web. Inicie sesión en el Tradovate Web Trader, abra <strong class='text-white'>Application Settings</strong> (arriba a la derecha) y después la pestaña <strong class='text-white'>Subscriptions</strong> (Plans). En la sección <strong class='text-white'>Membership</strong>, haga clic en <strong class='text-white'>Upgrade</strong> y elija su nuevo plan; ¿quiere dividir Lifetime en plazos? Active primero la opción <strong class='text-white'>4 Payments</strong>. Confirme y pague con el saldo de su cuenta o con una tarjeta, y luego cierre sesión y vuelva a iniciarla para que el nuevo plan aparezca en la página <strong class='text-white'>Settings &rsaquo; Plans</strong>." },
      ],
    },
    { type: "table", headers: ["Plan","Coste","Micros (por lado)","E-mini estándar (por lado)"], rows: [
      ["Free","$0 / mes","$0.39","$1.29"],
      ["Monthly","$99 / mes","$0.29","$0.99"],
      ["Lifetime","$1,499 pago único (o 4 &times; $499)","$0.09","$0.59"],
    ] },
    { type: "paragraph",html: "Las tarifas de bolsa, compensación y NFA se aplican a los tres niveles y no están incluidas en las cifras anteriores." },
    { type: "heading",text: "Por qué lo necesitaría" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Reducir los costes de trading</strong>, ajustar su plan a su volumen puede ahorrarle dinero real en comisiones.",
        "<strong class='text-white'>Presupuestar con exactitud</strong>, conozca su coste mensual fijo antes de operar en real.",
        "<strong class='text-white'>Comparar brókers de forma justa</strong>, ponga la tarifa total de Tradovate al lado de las alternativas.",
        "<strong class='text-white'>Evitar tarifas sorpresa</strong>, el plan Free puede incluir una tarifa de inactividad si no opera dentro de un plazo determinado, y las normas de las prop firms y de las evaluaciones varían según la firma y el tamaño de la cuenta, así que consulte también las normas vigentes de su firma.",
      ],
    },
    { type: "heading",text: "Automatice esto con PickMyTrade" },
    { type: "paragraph",html: "<strong class='text-white'>PickMyTrade conecta sus alertas de TradingView directamente con su cuenta de Tradovate</strong>. Una vez que haya elegido un plan, su estrategia se ejecuta sola, sin clics manuales, sin ejecuciones perdidas, sea cual sea el nivel de comisión en el que termine." },
  ], fr: [
    { type: "paragraph",html: "Choisir le bon plan Tradovate peut vous faire économiser discrètement des centaines de dollars de commissions par an, ou vous coûter autant si vous vous trompez. Que vous soyez un nouveau trader de futures qui compare les courtiers ou que vous mettiez en place une automatisation avec PickMyTrade, voici comment se comparent les trois plans de compte Tradovate et comment trouver le moins cher selon votre façon réelle de trader." },
    { type: "heading",text: "Que sont les plans de compte Tradovate ?" },
    { type: "paragraph",html: "Un plan de compte Tradovate (parfois appelé abonnement) fixe la commission par côté que vous payez sur chaque contrat de futures négocié. Tout compte s'ouvre par défaut sur le plan Free. Si vous payez des frais mensuels ou uniques, votre taux de commission baisse par paliers. Un seul plan par identifiant suffit, et vous pouvez changer de niveau chaque fois que votre trading évolue." },
    { type: "heading",text: "Choisir votre plan Tradovate : étape par étape" },
    {
      type: "steps",
      items: [
        { title: "Comprenez les trois niveaux", html: "Tradovate propose trois plans, et chacun met en balance un coût d'abonnement fixe et votre taux de commission : <strong class='text-white'>Free</strong>, sans frais mensuels, mais avec les commissions par contrat les plus élevées ; <strong class='text-white'>Monthly</strong>, des frais mensuels forfaitaires qui réduisent vos commissions ; et <strong class='text-white'>Lifetime</strong>, un paiement unique plus important (ou quelques versements) qui verrouille durablement les commissions les plus basses. Les prix et les taux exacts évoluent avec le temps ; vérifiez donc les chiffres actuels sur la page de tarifs en direct de Tradovate avant de vous engager." },
        { title: "Comparez les commissions par côté", html: "La vraie différence entre les niveaux est la <strong class='text-white'>commission par côté</strong> : vous la payez une fois à l'entrée et une autre fois à la sortie. Les contrats micro coûtent toujours moins cher que les e-minis standard, et quel que soit votre niveau, vous paierez encore des frais de bourse, de compensation et de NFA en plus de la commission. Consultez le tableau ci-dessous pour voir comment se situaient les niveaux en juillet 2026 ; confirmez les taux actuels avant de décider." },
        { title: "Trouvez votre seuil de rentabilité", html: "Le bon plan dépend du nombre de contrats que vous tradez. Un plan payant ne commence à vous faire économiser de l'argent que lorsque la commission économisée dépasse son coût fixe. Pour une estimation rapide, divisez les frais mensuels par la commission par côté que vous économiseriez par rapport à Free : cela vous indique combien de côtés vous devriez trader chaque mois rien que pour atteindre le seuil de rentabilité. Si vous tradez occasionnellement ou en petite taille, Free l'emporte généralement. Si vous tradez activement chaque jour, Monthly ou Lifetime ont tendance à sortir gagnants." },
        { title: "Sélectionnez ou changez votre plan", html: "Vous changez de plan dans le Tradovate Web Trader, et non sur le site web. Connectez-vous au Tradovate Web Trader, ouvrez <strong class='text-white'>Application Settings</strong> (en haut à droite), puis l'onglet <strong class='text-white'>Subscriptions</strong> (Plans). Dans la section <strong class='text-white'>Membership</strong>, cliquez sur <strong class='text-white'>Upgrade</strong> et choisissez votre nouveau plan ; vous souhaitez fractionner Lifetime en versements ? Activez d'abord l'option <strong class='text-white'>4 Payments</strong>. Confirmez et payez avec le solde de votre compte ou par carte, puis déconnectez-vous et reconnectez-vous pour que le nouveau plan s'affiche sur la page <strong class='text-white'>Settings &rsaquo; Plans</strong>." },
      ],
    },
    { type: "table", headers: ["Plan","Coût","Micros (par côté)","E-mini standard (par côté)"], rows: [
      ["Free","$0 / mois","$0.39","$1.29"],
      ["Monthly","$99 / mois","$0.29","$0.99"],
      ["Lifetime","$1,499 en une fois (ou 4 &times; $499)","$0.09","$0.59"],
    ] },
    { type: "paragraph",html: "Les frais de bourse, de compensation et de NFA s'appliquent aux trois niveaux et ne sont pas inclus dans les chiffres ci-dessus." },
    { type: "heading",text: "Pourquoi vous en auriez besoin" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Réduire vos coûts de trading</strong>, adapter votre plan à votre volume peut vous faire économiser de l'argent réel sur les commissions.",
        "<strong class='text-white'>Établir un budget précis</strong>, connaissez vos coûts mensuels fixes avant de passer en réel.",
        "<strong class='text-white'>Comparer les courtiers équitablement</strong>, mettez le tarif tout compris de Tradovate en regard des alternatives.",
        "<strong class='text-white'>Éviter les frais surprises</strong>, le plan Free peut comporter des frais d'inactivité si vous ne tradez pas dans un délai donné, et les règles des prop firms et des évaluations varient selon la société et la taille du compte ; vérifiez donc aussi les règles actuelles de votre société.",
      ],
    },
    { type: "heading",text: "Automatisez cela avec PickMyTrade" },
    { type: "paragraph",html: "<strong class='text-white'>PickMyTrade relie vos alertes TradingView directement à votre compte Tradovate</strong>. Une fois votre plan choisi, votre stratégie s'exécute toute seule, sans clics manuels, sans exécutions manquées, quel que soit le niveau de commission que vous retenez." },
  ], it: [
    { type: "paragraph",html: "Scegliere il piano Tradovate giusto può farle risparmiare in silenzio centinaia di dollari l'anno in commissioni, o costarle altrettanto se sbaglia. Che sia un nuovo trader di futures che confronta i broker o che stia configurando un'automazione con PickMyTrade, ecco come si confrontano i tre piani del conto Tradovate e come arrivare al più economico per il modo in cui opera davvero." },
    { type: "heading",text: "Che cosa sono i piani del conto Tradovate?" },
    { type: "paragraph",html: "Un piano del conto Tradovate (a volte chiamato abbonamento) stabilisce la commissione per lato che paga su ogni contratto futures che negozia. Ogni conto si apre per impostazione predefinita con il piano Free. Se paga una quota mensile o una tantum, la sua commissione scende a gradini. Serve un solo piano per login e può passare da un livello all'altro ogni volta che il suo trading cambia." },
    { type: "heading",text: "Scegliere il suo piano Tradovate: passo dopo passo" },
    {
      type: "steps",
      items: [
        { title: "Comprenda i tre livelli", html: "Tradovate offre tre piani, e ciascuno bilancia un costo di abbonamento fisso rispetto alla sua commissione: <strong class='text-white'>Free</strong>, nessuna quota mensile, ma le commissioni per contratto più alte; <strong class='text-white'>Monthly</strong>, una quota mensile fissa che abbassa le sue commissioni; e <strong class='text-white'>Lifetime</strong>, un pagamento una tantum più consistente (o alcune rate) che blocca per sempre le commissioni più basse. I prezzi e le tariffe esatte cambiano nel tempo, quindi verifichi i numeri attuali sulla pagina dei prezzi live di Tradovate prima di impegnarsi." },
        { title: "Confronti le commissioni per lato", html: "La vera differenza tra i livelli è la <strong class='text-white'>commissione per lato</strong>: la paga una volta all'ingresso e un'altra all'uscita. I contratti micro costano sempre meno degli e-mini standard e, a prescindere dal livello, pagherà comunque le commissioni di borsa, di compensazione e di NFA in aggiunta alla commissione. Veda la tabella qui sotto per come si collocavano i livelli a luglio 2026; confermi le tariffe attuali prima di decidere." },
        { title: "Trovi il suo punto di pareggio", html: "Il piano giusto dipende da quanti contratti negozia. Un piano a pagamento inizia a farle risparmiare solo quando la commissione risparmiata supera il suo costo fisso. Per una stima rapida, divida la quota mensile per la commissione per lato che risparmierebbe rispetto a Free: questo le dice quanti lati dovrebbe negoziare ogni mese solo per arrivare al pareggio. Se opera occasionalmente o con size ridotte, di solito vince Free. Se opera attivamente ogni giorno, Monthly o Lifetime tendono ad avere la meglio." },
        { title: "Selezioni o cambi il suo piano", html: "Il piano si cambia all'interno del Tradovate Web Trader, non sul sito web. Acceda al Tradovate Web Trader, apra <strong class='text-white'>Application Settings</strong> (in alto a destra), poi la scheda <strong class='text-white'>Subscriptions</strong> (Plans). Nella sezione <strong class='text-white'>Membership</strong>, clicchi su <strong class='text-white'>Upgrade</strong> e scelga il suo nuovo piano; vuole dividere Lifetime in rate? Attivi prima l'opzione <strong class='text-white'>4 Payments</strong>. Confermi e paghi con il saldo del conto o con una carta, poi si disconnetta e riaccede affinché il nuovo piano compaia nella pagina <strong class='text-white'>Settings &rsaquo; Plans</strong>." },
