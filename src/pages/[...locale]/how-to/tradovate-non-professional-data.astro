---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "tradovate-non-professional-data";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/how-to/${SLUG}`;

const META_TITLE = "Sign the Non-Professional Data Agreement in Tradovate";
const META_DESCRIPTION =
  "Sign the Tradovate non-professional market data agreement to unlock lower real-time futures data rates. See who qualifies and how to certify.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Die Vereinbarung für nicht-professionelle Nutzer in Tradovate unterzeichnen", es: "Firme el Acuerdo de Datos para Usuarios No Profesionales en Tradovate", fr: "Signer l'accord de données pour utilisateurs non professionnels dans Tradovate", it: "Firmare l'Accordo sui Dati per Utenti Non Professionali in Tradovate" },
  dek: { en: "Sign the Tradovate non-professional market data agreement to unlock lower real-time futures data rates. See who qualifies and how to certify.", de: "Unterzeichnen Sie die Tradovate-Marktdatenvereinbarung für nicht-professionelle Nutzer, um günstigere Echtzeit-Futures-Daten freizuschalten. Erfahren Sie, wer sich qualifiziert und wie Sie die Erklärung abgeben.", es: "Firme el acuerdo de datos de mercado para usuarios no profesionales de Tradovate para acceder a tarifas más bajas de datos de futuros en tiempo real. Descubra quién califica y cómo certificarse.", fr: "Signez l'accord de données de marché non professionnel de Tradovate pour accéder à des tarifs réduits sur les données de contrats à terme en temps réel. Découvrez qui est éligible et comment certifier.", it: "Firmi l'accordo sui dati di mercato per utenti non professionali di Tradovate per ottenere tariffe più basse sui dati dei futures in tempo reale. Scopra chi ne ha diritto e come effettuare la certificazione." },
  readTime: { en: "6 min read", de: "6 Min. Lesezeit", es: "Lectura de 6 min", fr: "Lecture : 6 min", it: "Lettura di 6 min" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "Real-time futures data isn't free, but most retail traders pay far less than they think, if they certify correctly. Before Tradovate streams live exchange quotes, you have to sign a market data agreement and declare whether you're a professional or non-professional subscriber. Pick Non-Professional (and you almost certainly qualify), and you pay the low retail rate instead of the steep professional one. Here's how to sign it and lock in the cheaper rate." },
    { type: "heading", text: "Why This One Form Decides Your Data Bill" },
    { type: "paragraph", html: "Tradovate carries CME Group data, and the exchange sets two very different price tiers. Professional subscribers pay a premium, often hundreds of dollars a month across the exchanges, while non-professional rates are a small fraction of that. Exact fees vary by exchange and change over time, so check Tradovate's current market-data rates. The gap is big enough that the certification is worth getting right the first time." },
    { type: "paragraph", html: "The catch: the exchange won't turn on real-time quotes until you've signed. Skip it and you're stuck on a 10-minute delayed feed, the root of a lot of \"my charts are frozen\" headaches." },
    { type: "heading", text: "Non-Professional or Professional: Which Are You?" },
    { type: "paragraph", html: "This isn't a matter of preference, the exchange defines it. You generally qualify as <strong class='text-white'>non-professional</strong> only if you meet all of these conditions:" },
    {
      type: "table",
      headers: ["You likely qualify as Non-Professional if…", "You're Professional if…"],
      rows: [
        ["You're a natural person (an individual), not a company or corporate account", "You subscribe on behalf of a business, firm, or employer"],
        ["You use the data for your own personal trading only", "You use the data for business purposes or to manage other people's money"],
        ["You're not registered or qualified with the SEC, CFTC, or any securities/futures exchange or regulator (FINRA, NFA, and the like)", "You're registered or qualified with any of those bodies, or perform similar functions"],
        ["You're not acting as an investment adviser or asset manager", "You give investment advice or manage assets professionally"],
        ["You trade with your own capital", "You trade with capital provided by others, or share trading profits under an agreement"],
      ],
    },
    { type: "paragraph", html: "If every item on the left describes you, select Non-Professional. If any item on the right applies, you're Professional, and certifying incorrectly can get your data reclassified and back-billed later. The exchange makes the final call." },
    { type: "heading", text: "How to Sign the Non-Professional Agreement: Step-by-Step" },
    {
      type: "steps",
      items: [
        { title: "Open Tradovate in a Desktop Web Browser", html: "Sign in to the Tradovate web trader on a desktop browser. This part matters: the agreement isn't supported on the mobile app, so if you only ever log in on your phone, you'll never see the screen that unlocks live data. Use the browser platform to get it done." },
        { title: "Open the Market Data Subscriber Certification", html: "For a fresh account, the market data subscriber certification pops up automatically the first time you log in. Already clicked past it? Open <strong class='text-white'>Application Settings</strong>, head to the <strong class='text-white'>Market Data</strong> (or <strong class='text-white'>Subscriptions</strong>) area, and start or review the exchange data agreement from there. Either path lands you on the same certification." },
        { title: "Confirm You Qualify, Then Select Non-Professional", html: "The certification lists the qualifying conditions for non-professional status, the same criteria in the table above. Read them, confirm they all apply to you, and select <strong class='text-white'>Non-Professional</strong>. This is the single most important choice on the form, because it sets your rate tier. For the vast majority of retail futures traders, Non-Professional is the correct and cheaper answer." },
        { title: "E-Sign With Your Full Name and Submit", html: "Next you'll accept the subscriber agreement and provide an electronic signature. Tick the agreement checkboxes, then type your full name into the signature field <strong class='text-white'>exactly</strong> as it's printed just above the box, same spelling, capitalization, and spacing. A small mismatch is the most common reason the form refuses to submit. Once it matches, the submit button activates. Click it." },
        { title: "Wait for Activation and Verify Live Data", html: "Your feed doesn't switch on the instant you sign. Depending on demand, activation takes anywhere from <strong class='text-white'>10 to 90 minutes</strong>. The quickest status check is the color of the instrument name on a chart or DOM: <strong class='text-white'>white means live data is flowing</strong>, <strong class='text-white'>orange means it's still delayed</strong>. Still orange after 90 minutes? Log out and back in, a fresh session usually pulls the entitlement through." },
      ],
    },
    { type: "heading", text: "Automate Once Your Data's Live" },
    { type: "paragraph", html: "With non-professional data certified and real-time quotes flowing, PickMyTrade routes your TradingView alerts straight into Tradovate, entries, stops, and targets fire automatically, no manual clicking on the DOM. It's the fastest way to turn a properly subscribed account into a hands-free setup." },
  ], de: [
    { type: "paragraph",html: "Echtzeit-Futures-Daten sind nicht kostenlos, aber die meisten Privatanleger zahlen weit weniger, als sie denken, sofern sie korrekt zertifizieren. Bevor Tradovate Live-Kurse der Börse streamt, müssen Sie eine Marktdatenvereinbarung unterzeichnen und angeben, ob Sie professioneller oder nicht-professioneller Abonnent sind. Wählen Sie „Non-Professional“ (und Sie qualifizieren sich mit hoher Wahrscheinlichkeit dafür), zahlen Sie den günstigen Privatkundentarif statt des hohen professionellen Tarifs. So unterzeichnen Sie sie und sichern sich den günstigeren Tarif." },
    { type: "heading",text: "Warum dieses eine Formular Ihre Datenkosten bestimmt" },
    { type: "paragraph",html: "Tradovate liefert Daten der CME Group, und die Börse legt zwei sehr unterschiedliche Preisstufen fest. Professionelle Abonnenten zahlen einen Aufschlag, oft mehrere hundert Dollar pro Monat über alle Börsen hinweg, während die Gebühren für nicht-professionelle Nutzer nur einen Bruchteil davon betragen. Die genauen Gebühren variieren je nach Börse und ändern sich im Laufe der Zeit. Prüfen Sie daher die aktuellen Marktdatengebühren von Tradovate. Der Unterschied ist groß genug, dass sich eine korrekte Zertifizierung gleich beim ersten Mal lohnt." },
    { type: "paragraph",html: "Der Haken: Die Börse schaltet Echtzeit-Kurse erst frei, wenn Sie unterschrieben haben. Wenn Sie das überspringen, bleiben Sie bei einem um 10 Minuten verzögerten Feed, die Ursache vieler Beschwerden wie „Meine Charts sind eingefroren“." },
    { type: "heading",text: "Nicht-professionell oder professionell: Was trifft auf Sie zu?" },
    { type: "paragraph",html: "Das ist keine Frage der Präferenz, sondern wird von der Börse definiert. In der Regel gelten Sie nur dann als <strong class='text-white'>nicht-professionell</strong>, wenn Sie alle folgenden Bedingungen erfüllen:" },
    { type: "table", headers: ["Sie qualifizieren sich wahrscheinlich als nicht-professioneller Nutzer, wenn …","Sie sind professionell, wenn …"], rows: [
      ["Sie eine natürliche Person (Einzelperson) sind, kein Unternehmen und kein Firmenkonto","Sie im Auftrag eines Unternehmens, einer Firma oder eines Arbeitgebers abonnieren"],
      ["Sie die Daten ausschließlich für Ihren eigenen privaten Handel nutzen","Sie die Daten für geschäftliche Zwecke nutzen oder das Geld anderer Personen verwalten"],
      ["Sie nicht bei der SEC, der CFTC oder einer Wertpapier-/Terminbörse oder Aufsichtsbehörde (FINRA, NFA und Ähnliche) registriert oder zugelassen sind","Sie bei einer dieser Stellen registriert oder zugelassen sind oder ähnliche Funktionen ausüben"],
      ["Sie nicht als Anlageberater oder Vermögensverwalter tätig sind","Sie Anlageberatung erbringen oder professionell Vermögen verwalten"],
      ["Sie mit Ihrem eigenen Kapital handeln","Sie mit Kapital handeln, das andere bereitstellen, oder Handelsgewinne aufgrund einer Vereinbarung teilen"],
    ] },
    { type: "paragraph",html: "Wenn alle Punkte in der linken Spalte auf Sie zutreffen, wählen Sie „Non-Professional“. Trifft auch nur ein Punkt in der rechten Spalte zu, sind Sie professioneller Nutzer, und eine falsche Zertifizierung kann dazu führen, dass Ihre Daten später neu eingestuft und rückwirkend abgerechnet werden. Die endgültige Entscheidung trifft die Börse." },
    { type: "heading",text: "So unterzeichnen Sie die Vereinbarung für nicht-professionelle Nutzer: Schritt für Schritt" },
    {
      type: "steps",
      items: [
        { title: "Tradovate in einem Desktop-Webbrowser öffnen", html: "Melden Sie sich im Tradovate-Web-Trader in einem Desktop-Browser an. Das ist wichtig: Die Vereinbarung wird in der mobilen App nicht unterstützt. Wenn Sie sich also nur auf dem Smartphone anmelden, sehen Sie nie den Bildschirm, der die Live-Daten freischaltet. Nutzen Sie dafür die Browser-Plattform." },
        { title: "Die Zertifizierung als Marktdatenabonnent öffnen", html: "Bei einem neuen Konto erscheint die Zertifizierung als Marktdatenabonnent beim ersten Login automatisch. Haben Sie sie bereits weggeklickt? Öffnen Sie <strong class='text-white'>Application Settings</strong>, wechseln Sie in den Bereich <strong class='text-white'>Market Data</strong> (oder <strong class='text-white'>Subscriptions</strong>) und starten oder prüfen Sie dort die Börsendatenvereinbarung. Beide Wege führen zur selben Zertifizierung." },
        { title: "Bestätigen Sie Ihre Berechtigung und wählen Sie „Non-Professional“", html: "Die Zertifizierung führt die Bedingungen für den nicht-professionellen Status auf, dieselben Kriterien wie in der Tabelle oben. Lesen Sie sie, bestätigen Sie, dass alle auf Sie zutreffen, und wählen Sie <strong class='text-white'>Non-Professional</strong>. Dies ist die wichtigste Auswahl im Formular, denn sie legt Ihre Tarifstufe fest. Für die große Mehrheit der privaten Futures-Trader ist „Non-Professional“ die richtige und günstigere Antwort." },
        { title: "Mit vollständigem Namen elektronisch unterschreiben und absenden", html: "Als Nächstes akzeptieren Sie die Abonnentenvereinbarung und geben eine elektronische Signatur ab. Setzen Sie die Häkchen bei den Vereinbarungen und geben Sie dann Ihren vollständigen Namen <strong class='text-white'>exakt</strong> so in das Signaturfeld ein, wie er direkt über dem Feld gedruckt steht, mit gleicher Schreibweise, Groß- und Kleinschreibung und Abständen. Eine kleine Abweichung ist der häufigste Grund, warum das Formular nicht abgesendet werden kann. Sobald alles übereinstimmt, wird die Schaltfläche zum Absenden aktiv. Klicken Sie darauf." },
        { title: "Auf die Aktivierung warten und Live-Daten prüfen", html: "Ihr Datenfeed wird nicht in dem Moment aktiviert, in dem Sie unterschreiben. Je nach Auslastung dauert die Aktivierung zwischen <strong class='text-white'>10 und 90 Minuten</strong>. Am schnellsten prüfen Sie den Status an der Farbe des Instrumentennamens in einem Chart oder DOM: <strong class='text-white'>Weiß bedeutet, dass Live-Daten fließen</strong>, <strong class='text-white'>Orange bedeutet, dass sie noch verzögert sind</strong>. Nach 90 Minuten immer noch orange? Melden Sie sich ab und wieder an, eine neue Sitzung übernimmt die Berechtigung in der Regel." },
      ],
    },
    { type: "heading",text: "Automatisieren, sobald Ihre Daten live sind" },
    { type: "paragraph",html: "Mit zertifizierten nicht-professionellen Daten und fließenden Echtzeit-Kursen leitet PickMyTrade Ihre TradingView-Alarme direkt an Tradovate weiter: Einstiege, Stopps und Ziele werden automatisch ausgelöst, ganz ohne manuelles Klicken im DOM. Es ist der schnellste Weg, aus einem korrekt abonnierten Konto ein freihändiges Setup zu machen." },
  ], es: [
    { type: "paragraph",html: "Los datos de futuros en tiempo real no son gratuitos, pero la mayoría de los operadores minoristas paga mucho menos de lo que cree, si se certifica correctamente. Antes de que Tradovate transmita cotizaciones en vivo de la bolsa, debe firmar un acuerdo de datos de mercado y declarar si es suscriptor profesional o no profesional. Elija Non-Professional (y casi con seguridad califica) y pagará la tarifa minorista baja en lugar de la elevada tarifa profesional. Aquí le explicamos cómo firmarlo y asegurar la tarifa más económica." },
    { type: "heading",text: "Por qué este único formulario decide su factura de datos" },
    { type: "paragraph",html: "Tradovate ofrece datos de CME Group, y la bolsa establece dos niveles de precio muy diferentes. Los suscriptores profesionales pagan una prima, a menudo de cientos de dólares al mes entre todas las bolsas, mientras que las tarifas para no profesionales son una pequeña fracción de eso. Las tarifas exactas varían según la bolsa y cambian con el tiempo, así que consulte las tarifas de datos de mercado actuales de Tradovate. La diferencia es lo bastante grande como para que valga la pena hacer la certificación bien a la primera." },
    { type: "paragraph",html: "El inconveniente: la bolsa no activará las cotizaciones en tiempo real hasta que haya firmado. Si lo omite, se quedará con un feed retrasado 10 minutos, la raíz de muchos problemas de tipo «mis gráficos están congelados»." },
    { type: "heading",text: "No profesional o profesional: ¿cuál es usted?" },
    { type: "paragraph",html: "No es cuestión de preferencia, lo define la bolsa. En general, solo califica como <strong class='text-white'>no profesional</strong> si cumple todas estas condiciones:" },
    { type: "table", headers: ["Probablemente califique como no profesional si…","Es profesional si…"], rows: [
      ["Es una persona física (un individuo), no una empresa ni una cuenta corporativa","Se suscribe en nombre de un negocio, una firma o un empleador"],
      ["Usa los datos únicamente para su propia operativa personal","Usa los datos con fines comerciales o para gestionar el dinero de otras personas"],
      ["No está registrado ni habilitado ante la SEC, la CFTC ni ninguna bolsa de valores o futuros u organismo regulador (FINRA, NFA y similares)","Está registrado o habilitado ante cualquiera de esos organismos, o desempeña funciones similares"],
      ["No actúa como asesor de inversiones ni gestor de activos","Ofrece asesoramiento de inversión o gestiona activos de forma profesional"],
      ["Opera con su propio capital","Opera con capital aportado por otros, o comparte las ganancias de trading en virtud de un acuerdo"],
    ] },
    { type: "paragraph",html: "Si todos los elementos de la izquierda lo describen, seleccione Non-Professional. Si se aplica cualquier elemento de la derecha, es profesional, y certificarse de forma incorrecta puede hacer que sus datos se reclasifiquen y se le facture con carácter retroactivo más adelante. La bolsa toma la decisión final." },
    { type: "heading",text: "Cómo firmar el acuerdo para no profesionales: paso a paso" },
    {
      type: "steps",
      items: [
        { title: "Abra Tradovate en un navegador web de escritorio", html: "Inicie sesión en el Tradovate web trader desde un navegador de escritorio. Esto es importante: el acuerdo no es compatible con la aplicación móvil, así que si solo inicia sesión desde el teléfono, nunca verá la pantalla que activa los datos en vivo. Use la plataforma del navegador para completarlo." },
        { title: "Abra la certificación de suscriptor de datos de mercado", html: "En una cuenta nueva, la certificación de suscriptor de datos de mercado aparece automáticamente la primera vez que inicia sesión. ¿Ya la cerró? Abra <strong class='text-white'>Application Settings</strong>, vaya al área <strong class='text-white'>Market Data</strong> (o <strong class='text-white'>Subscriptions</strong>) e inicie o revise desde allí el acuerdo de datos de la bolsa. Ambos caminos llevan a la misma certificación." },
        { title: "Confirme que califica y seleccione Non-Professional", html: "La certificación enumera las condiciones para el estado no profesional, los mismos criterios de la tabla anterior. Léalas, confirme que todas se aplican a usted y seleccione <strong class='text-white'>Non-Professional</strong>. Esta es la elección más importante del formulario, porque determina su nivel de tarifa. Para la gran mayoría de los operadores minoristas de futuros, Non-Professional es la respuesta correcta y más económica." },
        { title: "Firme electrónicamente con su nombre completo y envíe", html: "A continuación aceptará el acuerdo de suscriptor y proporcionará una firma electrónica. Marque las casillas del acuerdo y escriba su nombre completo en el campo de firma <strong class='text-white'>exactamente</strong> como aparece impreso justo encima del cuadro, con la misma ortografía, mayúsculas y espacios. Una pequeña discrepancia es el motivo más común por el que el formulario no se envía. Cuando coincida, se activará el botón de envío. Haga clic en él." },
        { title: "Espere la activación y verifique los datos en vivo", html: "Su feed no se activa en el instante en que firma. Según la demanda, la activación tarda entre <strong class='text-white'>10 y 90 minutos</strong>. La forma más rápida de comprobar el estado es el color del nombre del instrumento en un gráfico o DOM: <strong class='text-white'>blanco significa que los datos en vivo están fluyendo</strong>, <strong class='text-white'>naranja significa que siguen retrasados</strong>. ¿Sigue en naranja después de 90 minutos? Cierre sesión y vuelva a iniciarla; una sesión nueva suele aplicar la autorización." },
      ],
    },
    { type: "heading",text: "Automatice cuando sus datos estén activos" },
    { type: "paragraph",html: "Con los datos no profesionales certificados y las cotizaciones en tiempo real fluyendo, PickMyTrade envía sus alertas de TradingView directamente a Tradovate: entradas, stops y objetivos se ejecutan automáticamente, sin clics manuales en el DOM. Es la forma más rápida de convertir una cuenta correctamente suscrita en una configuración sin intervención manual." },
  ], fr: [
    { type: "paragraph",html: "Les données de contrats à terme en temps réel ne sont pas gratuites, mais la plupart des traders particuliers paient bien moins qu'ils ne le pensent, à condition de certifier correctement. Avant que Tradovate ne diffuse les cotations en direct de la bourse, vous devez signer un accord de données de marché et déclarer si vous êtes abonné professionnel ou non professionnel. Choisissez Non-Professional (et vous y êtes presque certainement éligible) et vous paierez le faible tarif des particuliers plutôt que le tarif professionnel élevé. Voici comment le signer et bénéficier du tarif le plus avantageux." },
    { type: "heading",text: "Pourquoi ce seul formulaire détermine votre facture de données" },
    { type: "paragraph",html: "Tradovate propose les données du CME Group, et la bourse fixe deux niveaux de prix très différents. Les abonnés professionnels paient une prime, souvent plusieurs centaines de dollars par mois sur l'ensemble des bourses, alors que les tarifs non professionnels n'en représentent qu'une petite fraction. Les frais exacts varient selon la bourse et évoluent avec le temps ; consultez donc les tarifs de données de marché actuels de Tradovate. L'écart est suffisamment important pour que la certification mérite d'être bien faite du premier coup." },
    { type: "paragraph",html: "Le piège : la bourse n'activera pas les cotations en temps réel tant que vous n'aurez pas signé. Si vous passez cette étape, vous resterez sur un flux différé de 10 minutes, à l'origine de nombreux problèmes du type « mes graphiques sont figés »." },
    { type: "heading",text: "Non professionnel ou professionnel : quel est votre statut ?" },
    { type: "paragraph",html: "Ce n'est pas une question de préférence, c'est la bourse qui le définit. En général, vous n'êtes <strong class='text-white'>non professionnel</strong> que si vous remplissez toutes ces conditions :" },
    { type: "table", headers: ["Vous êtes probablement éligible au statut non professionnel si…","Vous êtes professionnel si…"], rows: [
      ["Vous êtes une personne physique (un particulier), et non une société ou un compte d'entreprise","Vous vous abonnez pour le compte d'une entreprise, d'un cabinet ou d'un employeur"],
      ["Vous utilisez les données uniquement pour votre propre trading personnel","Vous utilisez les données à des fins professionnelles ou pour gérer l'argent d'autres personnes"],
      ["Vous n'êtes pas enregistré ni agréé auprès de la SEC, de la CFTC ou de toute bourse de valeurs ou de contrats à terme ou autorité de régulation (FINRA, NFA et équivalents)","Vous êtes enregistré ou agréé auprès de l'un de ces organismes, ou vous exercez des fonctions similaires"],
      ["Vous n'agissez pas en tant que conseiller en investissement ou gestionnaire d'actifs","Vous fournissez des conseils en investissement ou gérez des actifs à titre professionnel"],
      ["Vous tradez avec votre propre capital","Vous tradez avec des capitaux fournis par d'autres, ou partagez les profits de trading dans le cadre d'un accord"],
    ] },
    { type: "paragraph",html: "Si tous les éléments de gauche vous décrivent, sélectionnez Non-Professional. Si un seul élément de droite s'applique, vous êtes professionnel, et une certification incorrecte peut entraîner un reclassement de vos données et une refacturation rétroactive. La décision finale appartient à la bourse." },
    { type: "heading",text: "Comment signer l'accord non professionnel : étape par étape" },
    {
      type: "steps",
      items: [
        { title: "Ouvrir Tradovate dans un navigateur web de bureau", html: "Connectez-vous au Tradovate web trader depuis un navigateur de bureau. C'est important : l'accord n'est pas pris en charge dans l'application mobile ; si vous ne vous connectez que depuis votre téléphone, vous ne verrez donc jamais l'écran qui active les données en direct. Utilisez la plateforme web pour le faire." },
        { title: "Ouvrir la certification d'abonné aux données de marché", html: "Pour un nouveau compte, la certification d'abonné aux données de marché s'affiche automatiquement à la première connexion. Vous l'avez déjà fermée ? Ouvrez <strong class='text-white'>Application Settings</strong>, rendez-vous dans la zone <strong class='text-white'>Market Data</strong> (ou <strong class='text-white'>Subscriptions</strong>), puis lancez ou consultez l'accord de données de la bourse à partir de là. Les deux chemins mènent à la même certification." },
        { title: "Confirmer votre éligibilité, puis sélectionner Non-Professional", html: "La certification énumère les conditions du statut non professionnel, les mêmes critères que dans le tableau ci-dessus. Lisez-les, confirmez qu'elles s'appliquent toutes à vous, puis sélectionnez <strong class='text-white'>Non-Professional</strong>. C'est le choix le plus important du formulaire, car il détermine votre niveau tarifaire. Pour la grande majorité des traders particuliers de contrats à terme, Non-Professional est la bonne réponse, et la moins chère." },
        { title: "Signer électroniquement avec votre nom complet et valider", html: "Vous allez ensuite accepter l'accord d'abonné et fournir une signature électronique. Cochez les cases de l'accord, puis saisissez votre nom complet dans le champ de signature <strong class='text-white'>exactement</strong> tel qu'il est imprimé juste au-dessus de la zone, avec la même orthographe, les mêmes majuscules et les mêmes espaces. Un petit écart est la raison la plus fréquente pour laquelle le formulaire refuse de se valider. Une fois que tout correspond, le bouton de validation s'active. Cliquez dessus." },
        { title: "Attendre l'activation et vérifier les données en direct", html: "Votre flux ne s'active pas à l'instant où vous signez. Selon la demande, l'activation prend entre <strong class='text-white'>10 et 90 minutes</strong>. Le moyen le plus rapide de vérifier le statut est la couleur du nom de l'instrument sur un graphique ou un DOM : <strong class='text-white'>blanc signifie que les données en direct arrivent</strong>, <strong class='text-white'>orange signifie qu'elles sont encore différées</strong>. Toujours orange après 90 minutes ? Déconnectez-vous puis reconnectez-vous ; une nouvelle session récupère généralement le droit d'accès." },
      ],
    },
    { type: "heading",text: "Automatisez dès que vos données sont actives" },
    { type: "paragraph",html: "Une fois les données non professionnelles certifiées et les cotations en temps réel disponibles, PickMyTrade achemine vos alertes TradingView directement vers Tradovate : entrées, stops et objectifs se déclenchent automatiquement, sans aucun clic manuel sur le DOM. C'est le moyen le plus rapide de transformer un compte correctement abonné en configuration entièrement automatisée." },
  ], it: [
    { type: "paragraph",html: "I dati dei futures in tempo reale non sono gratuiti, ma la maggior parte dei trader retail paga molto meno di quanto pensi, se certifica correttamente. Prima che Tradovate trasmetta le quotazioni in tempo reale della borsa, Lei deve firmare un accordo sui dati di mercato e dichiarare se è un abbonato professionale o non professionale. Scelga Non-Professional (e quasi certamente ne ha diritto) e pagherà la tariffa retail ridotta anziché quella professionale elevata. Ecco come firmarlo e assicurarsi la tariffa più conveniente." },
    { type: "heading",text: "Perché questo modulo decide il costo dei Suoi dati" },
    { type: "paragraph",html: "Tradovate offre i dati del CME Group e la borsa fissa due livelli di prezzo molto diversi. Gli abbonati professionali pagano un sovrapprezzo, spesso centinaia di dollari al mese tra le varie borse, mentre le tariffe per i non professionali ne sono una piccola frazione. Le tariffe esatte variano a seconda della borsa e cambiano nel tempo, quindi controlli le tariffe attuali dei dati di mercato di Tradovate. Il divario è abbastanza ampio da rendere importante fare la certificazione correttamente al primo tentativo." },
    { type: "paragraph",html: "Il problema: la borsa non attiverà le quotazioni in tempo reale finché non avrà firmato. Se salta questo passaggio, resterà con un feed ritardato di 10 minuti, all'origine di molti problemi del tipo «i miei grafici sono bloccati»." },
    { type: "heading",text: "Non professionale o professionale: qual è il Suo caso?" },
    { type: "paragraph",html: "Non è una questione di preferenza, lo definisce la borsa. In genere ha diritto allo status di <strong class='text-white'>non professionale</strong> solo se soddisfa tutte queste condizioni:" },
    { type: "table", headers: ["Probabilmente è non professionale se…","È professionale se…"], rows: [
      ["È una persona fisica (un privato), non un'azienda né un conto aziendale","Si abbona per conto di un'impresa, di una società o di un datore di lavoro"],
      ["Usa i dati solo per il Suo trading personale","Usa i dati per scopi commerciali o per gestire il denaro di altre persone"],
      ["Non è registrato né qualificato presso la SEC, la CFTC o qualsiasi borsa valori/futures o autorità di regolamentazione (FINRA, NFA e simili)","È registrato o qualificato presso uno qualsiasi di questi enti, o svolge funzioni analoghe"],
      ["Non opera come consulente di investimento o gestore patrimoniale","Fornisce consulenza di investimento o gestisce patrimoni a livello professionale"],
      ["Opera con il proprio capitale","Opera con capitale fornito da altri, o condivide i profitti di trading in base a un accordo"],
    ] },
    { type: "paragraph",html: "Se tutti gli elementi a sinistra La descrivono, selezioni Non-Professional. Se si applica anche un solo elemento a destra, è professionale, e una certificazione errata può portare alla riclassificazione dei Suoi dati e a un addebito retroattivo in seguito. La decisione finale spetta alla borsa." },
    { type: "heading",text: "Come firmare l'accordo per non professionali: passo dopo passo" },
    {
      type: "steps",
      items: [
        { title: "Apra Tradovate in un browser web desktop", html: "Acceda al web trader di Tradovate da un browser desktop. Questo è importante: l'accordo non è supportato nell'app mobile, quindi se accede solo dal telefono non vedrà mai la schermata che sblocca i dati in tempo reale. Usi la piattaforma nel browser per completare l'operazione." },
        { title: "Apra la certificazione di abbonato ai dati di mercato", html: "Per un nuovo account, la certificazione di abbonato ai dati di mercato compare automaticamente al primo accesso. L'ha già chiusa? Apra <strong class='text-white'>Application Settings</strong>, vada nell'area <strong class='text-white'>Market Data</strong> (o <strong class='text-white'>Subscriptions</strong>) e avvii o rivedga da lì l'accordo sui dati della borsa. Entrambi i percorsi portano alla stessa certificazione." },
        { title: "Confermi di averne diritto, poi selezioni Non-Professional", html: "La certificazione elenca le condizioni per lo status di non professionale, gli stessi criteri della tabella qui sopra. Le legga, confermi che si applicano tutte al Suo caso e selezioni <strong class='text-white'>Non-Professional</strong>. È la scelta più importante del modulo, perché determina il Suo livello tariffario. Per la grande maggioranza dei trader retail di futures, Non-Professional è la risposta corretta e più conveniente." },
        { title: "Firmi elettronicamente con il Suo nome completo e invii", html: "Successivamente accetterà l'accordo per l'abbonato e fornirà una firma elettronica. Spunti le caselle dell'accordo, poi digiti il Suo nome completo nel campo della firma <strong class='text-white'>esattamente</strong> come è stampato appena sopra il riquadro, con la stessa grafia, le stesse maiuscole e gli stessi spazi. Una piccola discrepanza è il motivo più comune per cui il modulo non si invia. Quando coincide, il pulsante di invio si attiva. Lo clicchi." },
        { title: "Attenda l'attivazione e verifichi i dati in tempo reale", html: "Il Suo feed non si attiva nell'istante in cui firma. A seconda della domanda, l'attivazione richiede da <strong class='text-white'>10 a 90 minuti</strong>. Il modo più rapido per controllare lo stato è il colore del nome dello strumento su un grafico o sul DOM: <strong class='text-white'>bianco significa che i dati in tempo reale arrivano</strong>, <strong class='text-white'>arancione significa che sono ancora ritardati</strong>. Ancora arancione dopo 90 minuti? Esca e riaccede: una nuova sessione di solito recepisce l'abilitazione." },
      ],
    },
    { type: "heading",text: "Automatizzi quando i dati sono attivi" },
    { type: "paragraph",html: "Con i dati non professionali certificati e le quotazioni in tempo reale attive, PickMyTrade instrada i Suoi alert di TradingView direttamente su Tradovate: ingressi, stop e target scattano automaticamente, senza clic manuali sul DOM. È il modo più rapido per trasformare un account correttamente abbonato in una configurazione completamente automatica." },
  ] },
  ctaHeading: { en: "Automate Your Tradovate Trades", de: "Automatisieren Sie Ihre Tradovate-Trades", es: "Automatice sus operaciones en Tradovate", fr: "Automatisez vos trades Tradovate", it: "Automatizzi i Suoi trade su Tradovate" },
  ctaText: { en: "With your data certified and live, let PickMyTrade route TradingView alerts straight into Tradovate.", de: "Sobald Ihre Daten zertifiziert und live sind, leitet PickMyTrade TradingView-Alarme direkt an Tradovate weiter.", es: "Con sus datos certificados y activos, deje que PickMyTrade envíe las alertas de TradingView directamente a Tradovate.", fr: "Une fois vos données certifiées et actives, laissez PickMyTrade acheminer les alertes TradingView directement vers Tradovate.", it: "Con i dati certificati e attivi, lasci che PickMyTrade instradi gli alert di TradingView direttamente su Tradovate." },
  ctaButtonText: { en: "Start Your Free 7-Day Trial", de: "Starten Sie Ihre kostenlose 7-Tage-Testphase", es: "Comience su prueba gratuita de 7 días", fr: "Commencez votre essai gratuit de 7 jours", it: "Inizi la prova gratuita di 7 giorni" },
  ctaUrl: "https://app.pickmytrade.trade/?register=true&utm_source=content&utm_medium=how-to",
  faqHeading: { en: "Frequently Asked Questions", de: "Häufig gestellte Fragen", es: "Preguntas frecuentes", fr: "Questions fréquentes", it: "Domande frequenti" },
  faqs: { en: [
    { q: "Do I really save money by signing as non-professional?", a: "Yes. Professional data rates run far higher, often into the hundreds of dollars a month across exchanges, while non-professional rates are a small fraction of that. Exact fees vary by exchange and change over time, so confirm the current numbers on Tradovate's market-data rates page." },
    { q: "Why won't the agreement appear on my phone?", a: "The certification and signature steps only run in the Tradovate web app on desktop. Sign the agreement once in a browser, and your entitlement then follows your account into the mobile and desktop apps." },
    { q: "What if I picked the wrong status?", a: "Contact Tradovate support to correct it. The exchange makes the final professional/non-professional determination and can reclassify or back-bill accounts that certified incorrectly, so it's worth fixing rather than leaving it." },
  ], de: [
    { q: "Spare ich wirklich Geld, wenn ich als nicht-professioneller Nutzer unterschreibe?", a: "Ja. Die Datengebühren für professionelle Nutzer sind deutlich höher, oft mehrere hundert Dollar pro Monat über alle Börsen hinweg, während die Gebühren für nicht-professionelle Nutzer nur einen Bruchteil davon betragen. Die genauen Gebühren variieren je nach Börse und ändern sich im Laufe der Zeit. Bestätigen Sie daher die aktuellen Zahlen auf der Seite mit den Marktdatengebühren von Tradovate." },
    { q: "Warum erscheint die Vereinbarung nicht auf meinem Smartphone?", a: "Die Schritte für Zertifizierung und Unterschrift werden nur in der Tradovate-Web-App auf dem Desktop ausgeführt. Unterzeichnen Sie die Vereinbarung einmal im Browser, dann gilt Ihre Freischaltung automatisch auch in den mobilen und Desktop-Apps." },
    { q: "Was ist, wenn ich den falschen Status gewählt habe?", a: "Wenden Sie sich an den Tradovate-Support, um dies zu korrigieren. Die endgültige Einstufung als professionell oder nicht-professionell trifft die Börse, die Konten bei falscher Zertifizierung neu einstufen oder rückwirkend abrechnen kann. Es lohnt sich daher, dies zu korrigieren, statt es so zu belassen." },
  ], es: [
    { q: "¿Realmente ahorro dinero al firmar como no profesional?", a: "Sí. Las tarifas de datos para profesionales son mucho más altas, a menudo de cientos de dólares al mes entre todas las bolsas, mientras que las tarifas para no profesionales son una pequeña fracción de eso. Las tarifas exactas varían según la bolsa y cambian con el tiempo, así que confirme las cifras actuales en la página de tarifas de datos de mercado de Tradovate." },
    { q: "¿Por qué no aparece el acuerdo en mi teléfono?", a: "Los pasos de certificación y firma solo funcionan en la aplicación web de Tradovate en el escritorio. Firme el acuerdo una vez en un navegador y su autorización se aplicará después a su cuenta en las aplicaciones móvil y de escritorio." },
    { q: "¿Y si elegí el estado equivocado?", a: "Póngase en contacto con el soporte de Tradovate para corregirlo. La bolsa toma la determinación final entre profesional y no profesional y puede reclasificar o facturar con carácter retroactivo las cuentas que se certificaron de forma incorrecta, así que conviene corregirlo en lugar de dejarlo así." },
  ], fr: [
    { q: "Est-ce que j'économise vraiment en signant en tant que non professionnel ?", a: "Oui. Les tarifs de données professionnels sont bien plus élevés, souvent plusieurs centaines de dollars par mois sur l'ensemble des bourses, alors que les tarifs non professionnels n'en représentent qu'une petite fraction. Les frais exacts varient selon la bourse et évoluent avec le temps ; vérifiez donc les montants actuels sur la page des tarifs de données de marché de Tradovate." },
    { q: "Pourquoi l'accord n'apparaît-il pas sur mon téléphone ?", a: "Les étapes de certification et de signature ne fonctionnent que dans l'application web Tradovate sur ordinateur. Signez l'accord une fois dans un navigateur, et votre droit d'accès suivra ensuite votre compte dans les applications mobile et de bureau." },
    { q: "Que faire si j'ai choisi le mauvais statut ?", a: "Contactez l'assistance Tradovate pour le corriger. C'est la bourse qui détermine en dernier ressort le statut professionnel ou non professionnel, et elle peut reclasser ou refacturer rétroactivement les comptes certifiés à tort ; il vaut donc mieux corriger la situation plutôt que de la laisser en l'état." },
  ], it: [
    { q: "Risparmio davvero firmando come non professionale?", a: "Sì. Le tariffe dei dati per i professionali sono molto più alte, spesso centinaia di dollari al mese tra le varie borse, mentre quelle per i non professionali ne sono una piccola frazione. Le tariffe esatte variano a seconda della borsa e cambiano nel tempo, quindi verifichi gli importi attuali nella pagina delle tariffe dei dati di mercato di Tradovate." },
    { q: "Perché l'accordo non compare sul mio telefono?", a: "I passaggi di certificazione e firma funzionano solo nell'app web di Tradovate su desktop. Firmi l'accordo una volta in un browser e la Sua abilitazione seguirà poi il Suo account nelle app mobile e desktop." },
    { q: "E se avessi scelto lo status sbagliato?", a: "Contatti il supporto di Tradovate per correggerlo. La borsa stabilisce in via definitiva la classificazione come professionale o non professionale e può riclassificare o riaddebitare retroattivamente gli account certificati in modo errato, quindi conviene correggerlo anziché lasciarlo com'è." },
  ] },
  relatedHeading: { en: "Related Guides", de: "Verwandte Anleitungen", es: "Guías relacionadas", fr: "Guides associés", it: "Guide correlate" },
  disclosureText: { en: `This guide is for educational and informational purposes only and is not financial, investment, or trading advice. Trading futures and other leveraged products carries a substantial risk of loss and is not suitable for every investor. PickMyTrade is an independent third-party automation platform and is not affiliated with, endorsed by, or sponsored by Tradovate, Inc. "Tradovate" and all related names, logos, and trademarks are the property of their respective owners. Platform features and steps change over time, so always confirm the current process in the official Tradovate platform and documentation before acting.`, de: "Diese Anleitung dient ausschließlich Bildungs- und Informationszwecken und stellt keine Finanz-, Anlage- oder Handelsberatung dar. Der Handel mit Futures und anderen gehebelten Produkten birgt ein erhebliches Verlustrisiko und ist nicht für jeden Anleger geeignet. PickMyTrade ist eine unabhängige Automatisierungsplattform eines Drittanbieters und steht in keiner Verbindung zu Tradovate, Inc., wird von dieser weder unterstützt noch gesponsert. \"Tradovate\" und alle zugehörigen Namen, Logos und Marken sind Eigentum ihrer jeweiligen Inhaber. Plattformfunktionen und Schritte ändern sich im Laufe der Zeit; bestätigen Sie daher stets den aktuellen Ablauf in der offiziellen Tradovate-Plattform und -Dokumentation, bevor Sie handeln.", es: "Esta guía tiene fines exclusivamente educativos e informativos y no constituye asesoramiento financiero, de inversión ni de trading. Operar con futuros y otros productos apalancados conlleva un riesgo sustancial de pérdida y no es adecuado para todos los inversores. PickMyTrade es una plataforma de automatización independiente de terceros y no está afiliada, avalada ni patrocinada por Tradovate, Inc. \"Tradovate\" y todos los nombres, logotipos y marcas relacionados son propiedad de sus respectivos titulares. Las funciones y los pasos de la plataforma cambian con el tiempo, por lo que debe confirmar siempre el proceso actual en la plataforma y la documentación oficiales de Tradovate antes de actuar.", fr: "Ce guide est fourni uniquement à des fins éducatives et informatives et ne constitue pas un conseil financier, d'investissement ou de trading. Le trading de contrats à terme et d'autres produits à effet de levier comporte un risque de perte important et ne convient pas à tous les investisseurs. PickMyTrade est une plateforme d'automatisation tierce indépendante et n'est ni affiliée à Tradovate, Inc., ni approuvée ni parrainée par cette dernière. « Tradovate » ainsi que tous les noms, logos et marques associés sont la propriété de leurs détenteurs respectifs. Les fonctionnalités et les étapes de la plateforme évoluent avec le temps ; vérifiez donc toujours la procédure actuelle sur la plateforme et dans la documentation officielles de Tradovate avant d'agir.", it: "Questa guida ha esclusivamente scopo educativo e informativo e non costituisce consulenza finanziaria, di investimento o di trading. Il trading di futures e di altri prodotti a leva comporta un rischio di perdita sostanziale e non è adatto a ogni investitore. PickMyTrade è una piattaforma di automazione indipendente di terze parti e non è affiliata, approvata né sponsorizzata da Tradovate, Inc. \"Tradovate\" e tutti i nomi, loghi e marchi correlati sono di proprietà dei rispettivi titolari. Le funzionalità e i passaggi della piattaforma cambiano nel tempo, quindi verifichi sempre la procedura attuale nella piattaforma e nella documentazione ufficiali di Tradovate prima di agire." },
};
const data: GuideArticleData = resolveGuideContent(content, locale, related);

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: data.faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: `${SITE_URL}${withSlash(localizedPath(locale))}` },
    { "@type": "ListItem", position: 2, name: "How-To", item: `${SITE_URL}${withSlash(localizedPath(locale, "how-to"))}` },
    { "@type": "ListItem", position: 3, name: content.h1[locale], item: `${SITE_URL}${withSlash(localizedPath(locale, `how-to/${SLUG}`))}` },
  ],
};

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: content.h1[locale],
  description: content.dek[locale],
  image: `${SITE_URL}/assets/og-default.webp`,
  publisher: { "@type": "Organization", name: "PickMyTrade", logo: { "@type": "ImageObject", url: `${SITE_URL}/assets/logo.png` } },
  datePublished: "2026-07-08",
  dateModified: "2026-07-08",
  mainEntityOfPage: { "@type": "WebPage", "@id": `${SITE_URL}${withSlash(localizedPath(locale, `how-to/${SLUG}`))}` },
};
---

<BaseLayout
