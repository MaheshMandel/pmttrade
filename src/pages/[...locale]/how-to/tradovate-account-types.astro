---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "tradovate-account-types";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/how-to/${SLUG}`;

const META_TITLE = "Tradovate Account Types: Individual, Joint, IRA & More";
const META_DESCRIPTION =
  "Tradovate account types explained: compare individual, joint, IRA, corporate, LLC, trust and entity accounts to pick the right one before you apply.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Tradovate-Kontotypen: Einzelkonto, Gemeinschaftskonto, IRA und mehr", es: "Tipos de cuenta de Tradovate: individual, conjunta, IRA y más", fr: "Types de comptes Tradovate : individuel, joint, IRA et plus", it: "Tipi di conto Tradovate: individuale, cointestato, IRA e altro" },
  dek: { en: "Before you fill out a single field on the Tradovate application, you have to answer one question: whose account is this? Here's how each account type works so you can choose with confidence.", de: "Bevor Sie ein einziges Feld im Tradovate-Antrag ausfüllen, müssen Sie eine Frage beantworten: Wem gehört das Konto? So funktioniert jeder Kontotyp, damit Sie mit Sicherheit wählen können.", es: "Antes de rellenar un solo campo de la solicitud de Tradovate, debe responder a una pregunta: ¿de quién es la cuenta? Así funciona cada tipo de cuenta para que pueda elegir con confianza.", fr: "Avant de remplir le moindre champ de la demande Tradovate, vous devez répondre à une question : à qui appartient le compte ? Voici comment fonctionne chaque type de compte afin que vous puissiez choisir en toute confiance.", it: "Prima di compilare un solo campo della domanda Tradovate, deve rispondere a una domanda: di chi è il conto? Ecco come funziona ciascun tipo di conto, così potrà scegliere con sicurezza." },
  readTime: { en: "5 min read", de: "5 Min. Lesezeit", es: "Lectura de 5 min", fr: "Lecture : 5 min", it: "Lettura di 5 min" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "Before you fill out a single field on the Tradovate application, you have to answer one question: whose account is this? Are you trading your own money, sharing an account with a partner, running it through a company, or investing for retirement? Each answer points you to a different account type, and picking the wrong one is the fastest way to stall your application. Here's how each type works so you can choose with confidence." },
    { type: "heading", text: "What Are Tradovate Account Types?" },
    { type: "paragraph", html: "A Tradovate account type is the legal ownership structure you choose when you open a futures trading account. It decides who owns the account, how the profits get taxed, and which documents you'll have to submit with your application. Tradovate offers individual, joint, entity (corporate, LLC, partnership and trust) and IRA/retirement accounts. Match the account to your situation up front, and funding and trading go a lot smoother." },
    { type: "heading", text: "Tradovate Account Types Explained: Step-by-Step" },
    {
      type: "steps",
      items: [
        { title: "Individual and Joint Accounts", html: "An individual account is owned and traded by one person, and it's the quickest to open. The online application usually takes only a few minutes. A joint account is shared by two or more people, say a spouse or a business partner. Every holder gets named on the application, and each one provides their own identity documents, so gather those before you start." },
        { title: "Entity Accounts (Corporate, LLC, Partnership, Trust)", html: "Trade through a business or legal structure and Tradovate has you covered with corporate, LLC, partnership and trust accounts. These are owned by the entity rather than an individual, so expect more paperwork: formation documents, an EIN or tax ID, and the names of everyone authorized to trade on the account. Pick the structure that matches how the business is actually registered, not the one that sounds closest." },
        { title: "IRA and Retirement Accounts", html: "Yes, you can trade futures inside a retirement account. Tradovate offers IRA accounts through a third-party custodian, Equity Trust, which partners with Tradovate to service retirement clients. When you apply, select <strong class='text-white'>IRA</strong> as the Account Type and enter <strong class='text-white'>Equity Trust</strong> as your Account Custodian. Equity Trust holds the retirement funds while you trade futures inside the IRA. One thing that trips people up: even if you already have a Tradovate or NinjaTrader login, you still have to complete a separate application for the IRA." },
        { title: "Select Your Account Type in the Application", html: "Open the Tradovate account application and choose your account type from the Account Type field, then enter your personal or entity details and upload the required identity documents. Submit the form, and Tradovate's New Accounts team reviews it and emails you once processing is complete. Minimum deposit requirements vary by account type and change over time, so check Tradovate's current funding requirements before you move any money." },
      ],
    },
    { type: "heading", text: "Why You'd Need This" },
    {
      type: "list",
      items: [
        "Choosing the right ownership and tax structure before you apply",
        "Opening a joint account to trade alongside a spouse or partner",
        "Trading futures through a company using a corporate, LLC, partnership or trust account",
        "Investing for retirement in a tax-advantaged IRA via Equity Trust",
        "Having the correct documents ready so your application isn't delayed",
      ],
    },
    { type: "heading", text: "Automate This with PickMyTrade" },
    { type: "paragraph", html: "Once your Tradovate account is open, <strong class='text-white'>PickMyTrade links your TradingView alerts straight to it</strong>, so entries, exits and bracket orders fire automatically across whichever account type you chose, with no manual clicks." },
  ], de: [
    { type: "paragraph",html: "Bevor Sie ein einziges Feld im Tradovate-Antrag ausfüllen, müssen Sie eine Frage beantworten: Wem gehört das Konto? Handeln Sie mit Ihrem eigenen Geld, teilen Sie sich ein Konto mit einem Partner, führen Sie es über ein Unternehmen oder investieren Sie für den Ruhestand? Jede Antwort führt zu einem anderen Kontotyp, und die falsche Wahl ist der schnellste Weg, Ihren Antrag ins Stocken zu bringen. So funktioniert jeder Typ, damit Sie mit Sicherheit wählen können." },
    { type: "heading",text: "Was sind Tradovate-Kontotypen?" },
    { type: "paragraph",html: "Ein Tradovate-Kontotyp ist die rechtliche Eigentumsstruktur, die Sie bei der Eröffnung eines Futures-Handelskontos wählen. Er bestimmt, wem das Konto gehört, wie die Gewinne besteuert werden und welche Dokumente Sie mit Ihrem Antrag einreichen müssen. Tradovate bietet Einzelkonten, Gemeinschaftskonten, Unternehmenskonten (Corporate, LLC, Partnership und Trust) sowie IRA-/Altersvorsorgekonten an. Wenn Sie den Kontotyp von Anfang an passend zu Ihrer Situation wählen, laufen Einzahlung und Handel deutlich reibungsloser." },
    { type: "heading",text: "Tradovate-Kontotypen erklärt: Schritt für Schritt" },
    {
      type: "steps",
      items: [
        { title: "Einzel- und Gemeinschaftskonten", html: "Ein Einzelkonto gehört einer einzelnen Person und wird von ihr gehandelt; es ist am schnellsten eröffnet. Der Online-Antrag dauert in der Regel nur wenige Minuten. Ein Gemeinschaftskonto wird von zwei oder mehr Personen geteilt, etwa von Ehepartnern oder Geschäftspartnern. Jeder Inhaber wird im Antrag genannt und legt seine eigenen Ausweisdokumente vor. Halten Sie diese daher bereit, bevor Sie beginnen." },
        { title: "Unternehmenskonten (Corporate, LLC, Partnership, Trust)", html: "Wenn Sie über ein Unternehmen oder eine Rechtsstruktur handeln, bietet Tradovate Corporate-, LLC-, Partnership- und Trust-Konten an. Diese gehören der juristischen Einheit und nicht einer Einzelperson. Rechnen Sie daher mit mehr Papierkram: Gründungsunterlagen, eine EIN bzw. Steuernummer und die Namen aller Personen, die auf dem Konto handeln dürfen. Wählen Sie die Struktur, die der tatsächlichen Registrierung des Unternehmens entspricht, und nicht diejenige, die am ehesten passend klingt." },
        { title: "IRA- und Altersvorsorgekonten", html: "Ja, Sie können Futures in einem Altersvorsorgekonto handeln. Tradovate bietet IRA-Konten über einen externen Verwahrer an, Equity Trust, der mit Tradovate zusammenarbeitet, um Altersvorsorgekunden zu betreuen. Wählen Sie bei Ihrem Antrag <strong class='text-white'>IRA</strong> als Account Type und geben Sie <strong class='text-white'>Equity Trust</strong> als Account Custodian ein. Equity Trust verwahrt die Altersvorsorgegelder, während Sie innerhalb der IRA Futures handeln. Ein Punkt, an dem viele scheitern: Selbst wenn Sie bereits ein Tradovate- oder NinjaTrader-Login haben, müssen Sie für die IRA einen separaten Antrag ausfüllen." },
        { title: "Kontotyp im Antrag auswählen", html: "Öffnen Sie den Tradovate-Kontoantrag und wählen Sie Ihren Kontotyp im Feld Account Type aus. Geben Sie anschließend Ihre persönlichen bzw. unternehmensbezogenen Daten ein und laden Sie die erforderlichen Ausweisdokumente hoch. Senden Sie das Formular ab. Das New-Accounts-Team von Tradovate prüft es und benachrichtigt Sie per E-Mail, sobald die Bearbeitung abgeschlossen ist. Die Mindesteinzahlungen unterscheiden sich je nach Kontotyp und ändern sich mit der Zeit. Prüfen Sie daher die aktuellen Finanzierungsanforderungen von Tradovate, bevor Sie Geld überweisen." },
      ],
    },
    { type: "heading",text: "Wann Sie das brauchen" },
    {
      type: "list",
      items: [
        "Die richtige Eigentums- und Steuerstruktur wählen, bevor Sie den Antrag stellen",
        "Ein Gemeinschaftskonto eröffnen, um gemeinsam mit Ehepartner oder Partner zu handeln",
        "Futures über ein Unternehmen mit einem Corporate-, LLC-, Partnership- oder Trust-Konto handeln",
        "Mit einer steuerbegünstigten IRA über Equity Trust für den Ruhestand investieren",
        "Die richtigen Dokumente bereithalten, damit sich Ihr Antrag nicht verzögert",
      ],
    },
    { type: "heading",text: "Automatisieren Sie dies mit PickMyTrade" },
    { type: "paragraph",html: "Sobald Ihr Tradovate-Konto eröffnet ist, <strong class='text-white'>verbindet PickMyTrade Ihre TradingView-Alerts direkt damit</strong>, sodass Einstiege, Ausstiege und Bracket-Orders für jeden gewählten Kontotyp automatisch und ohne manuelle Klicks ausgeführt werden." },
  ], es: [
    { type: "paragraph",html: "Antes de rellenar un solo campo de la solicitud de Tradovate, debe responder a una pregunta: ¿de quién es la cuenta? ¿Opera con su propio dinero, comparte una cuenta con una pareja, la gestiona a través de una empresa o invierte para su jubilación? Cada respuesta le lleva a un tipo de cuenta distinto, y elegir el equivocado es la forma más rápida de que su solicitud se atasque. Así funciona cada tipo para que pueda elegir con confianza." },
    { type: "heading",text: "¿Qué son los tipos de cuenta de Tradovate?" },
    { type: "paragraph",html: "Un tipo de cuenta de Tradovate es la estructura legal de titularidad que elige al abrir una cuenta de trading de futuros. Determina quién es el propietario de la cuenta, cómo tributan los beneficios y qué documentos tendrá que presentar con su solicitud. Tradovate ofrece cuentas individuales, conjuntas, de entidad (corporación, LLC, sociedad y fideicomiso) y cuentas IRA/de jubilación. Si ajusta el tipo de cuenta a su situación desde el principio, la financiación y la operativa resultan mucho más sencillas." },
    { type: "heading",text: "Tipos de cuenta de Tradovate explicados: paso a paso" },
    {
      type: "steps",
      items: [
        { title: "Cuentas individuales y conjuntas", html: "Una cuenta individual pertenece a una sola persona, que es quien opera con ella, y es la más rápida de abrir. La solicitud en línea suele llevar solo unos minutos. Una cuenta conjunta la comparten dos o más personas, por ejemplo un cónyuge o un socio. Todos los titulares figuran en la solicitud y cada uno aporta sus propios documentos de identidad, así que téngalos a mano antes de empezar." },
        { title: "Cuentas de entidad (corporación, LLC, sociedad, fideicomiso)", html: "Si opera a través de una empresa o estructura legal, Tradovate ofrece cuentas de corporación, LLC, sociedad y fideicomiso. Pertenecen a la entidad y no a una persona física, por lo que debe esperar más papeleo: documentos de constitución, un EIN o número de identificación fiscal y los nombres de todas las personas autorizadas a operar en la cuenta. Elija la estructura que coincida con el modo en que la empresa está realmente registrada, no la que le parezca más parecida." },
        { title: "Cuentas IRA y de jubilación", html: "Sí, puede operar con futuros dentro de una cuenta de jubilación. Tradovate ofrece cuentas IRA a través de un custodio externo, Equity Trust, que colabora con Tradovate para atender a los clientes de jubilación. Al presentar su solicitud, seleccione <strong class='text-white'>IRA</strong> como Account Type e introduzca <strong class='text-white'>Equity Trust</strong> como Account Custodian. Equity Trust custodia los fondos de jubilación mientras usted opera con futuros dentro de la IRA. Un detalle que confunde a muchos: aunque ya tenga un acceso de Tradovate o NinjaTrader, debe completar una solicitud independiente para la IRA." },
        { title: "Seleccione su tipo de cuenta en la solicitud", html: "Abra la solicitud de cuenta de Tradovate y elija su tipo de cuenta en el campo Account Type; después, introduzca sus datos personales o de la entidad y suba los documentos de identidad requeridos. Envíe el formulario y el equipo de New Accounts de Tradovate lo revisará y le enviará un correo cuando el trámite haya finalizado. Los requisitos de depósito mínimo varían según el tipo de cuenta y cambian con el tiempo, así que consulte los requisitos de financiación actuales de Tradovate antes de mover dinero." },
      ],
    },
    { type: "heading",text: "Por qué lo necesitaría" },
    {
      type: "list",
      items: [
        "Elegir la estructura de titularidad y fiscal adecuada antes de presentar la solicitud",
        "Abrir una cuenta conjunta para operar junto con su cónyuge o pareja",
        "Operar con futuros a través de una empresa mediante una cuenta de corporación, LLC, sociedad o fideicomiso",
        "Invertir para la jubilación en una IRA con ventajas fiscales a través de Equity Trust",
        "Tener preparados los documentos correctos para que su solicitud no se retrase",
      ],
    },
    { type: "heading",text: "Automatice esto con PickMyTrade" },
    { type: "paragraph",html: "Una vez abierta su cuenta de Tradovate, <strong class='text-white'>PickMyTrade conecta sus alertas de TradingView directamente con ella</strong>, de modo que las entradas, salidas y órdenes bracket se ejecutan automáticamente con el tipo de cuenta que haya elegido, sin clics manuales." },
  ], fr: [
    { type: "paragraph",html: "Avant de remplir le moindre champ de la demande Tradovate, vous devez répondre à une question : à qui appartient le compte ? Tradez-vous votre propre argent, partagez-vous un compte avec un partenaire, le gérez-vous via une société ou investissez-vous pour votre retraite ? Chaque réponse mène à un type de compte différent, et choisir le mauvais est le moyen le plus rapide de bloquer votre demande. Voici comment fonctionne chaque type afin que vous puissiez choisir en toute confiance." },
    { type: "heading",text: "Que sont les types de comptes Tradovate ?" },
    { type: "paragraph",html: "Un type de compte Tradovate est la structure juridique de propriété que vous choisissez en ouvrant un compte de trading de futures. Il détermine qui possède le compte, comment les gains sont imposés et quels documents vous devrez soumettre avec votre demande. Tradovate propose des comptes individuels, joints, d’entité (société, LLC, partnership et trust) et IRA/retraite. Adaptez le compte à votre situation dès le départ, et l’alimentation comme le trading se dérouleront bien plus facilement." },
    { type: "heading",text: "Les types de comptes Tradovate expliqués : étape par étape" },
    {
      type: "steps",
      items: [
        { title: "Comptes individuels et comptes joints", html: "Un compte individuel appartient à une seule personne, qui le trade, et c’est le plus rapide à ouvrir. La demande en ligne ne prend généralement que quelques minutes. Un compte joint est partagé par deux personnes ou plus, par exemple un conjoint ou un associé. Chaque titulaire est nommé dans la demande et fournit ses propres pièces d’identité ; rassemblez-les donc avant de commencer." },
        { title: "Comptes d’entité (société, LLC, partnership, trust)", html: "Si vous tradez via une entreprise ou une structure juridique, Tradovate propose des comptes corporate, LLC, partnership et trust. Ils appartiennent à l’entité et non à un particulier ; attendez-vous donc à davantage de formalités : documents de constitution, un EIN ou numéro d’identification fiscale, et les noms de toutes les personnes autorisées à trader sur le compte. Choisissez la structure qui correspond à l’enregistrement réel de l’entreprise, et non celle qui s’en rapproche le plus." },
        { title: "Comptes IRA et de retraite", html: "Oui, vous pouvez trader des futures au sein d’un compte de retraite. Tradovate propose des comptes IRA via un dépositaire tiers, Equity Trust, qui s’associe à Tradovate pour servir les clients de retraite. Lors de votre demande, sélectionnez <strong class='text-white'>IRA</strong> comme Account Type et saisissez <strong class='text-white'>Equity Trust</strong> comme Account Custodian. Equity Trust conserve les fonds de retraite pendant que vous tradez des futures au sein de l’IRA. Un point qui piège souvent : même si vous disposez déjà d’un identifiant Tradovate ou NinjaTrader, vous devez remplir une demande distincte pour l’IRA." },
        { title: "Sélectionnez votre type de compte dans la demande", html: "Ouvrez la demande de compte Tradovate et choisissez votre type de compte dans le champ Account Type, puis saisissez vos informations personnelles ou celles de l’entité et téléversez les pièces d’identité requises. Soumettez le formulaire : l’équipe New Accounts de Tradovate l’examine et vous envoie un e-mail une fois le traitement terminé. Les dépôts minimums varient selon le type de compte et évoluent avec le temps ; consultez donc les exigences de financement actuelles de Tradovate avant de transférer des fonds." },
      ],
    },
    { type: "heading",text: "Pourquoi vous en auriez besoin" },
    {
      type: "list",
      items: [
        "Choisir la bonne structure de propriété et de fiscalité avant de faire votre demande",
        "Ouvrir un compte joint pour trader avec un conjoint ou un partenaire",
        "Trader des futures via une société avec un compte corporate, LLC, partnership ou trust",
        "Investir pour la retraite dans une IRA à fiscalité avantageuse via Equity Trust",
        "Avoir les bons documents prêts pour que votre demande ne soit pas retardée",
      ],
    },
    { type: "heading",text: "Automatisez cela avec PickMyTrade" },
    { type: "paragraph",html: "Une fois votre compte Tradovate ouvert, <strong class='text-white'>PickMyTrade relie vos alertes TradingView directement à celui-ci</strong> : les entrées, sorties et ordres bracket s’exécutent automatiquement, quel que soit le type de compte choisi, sans clic manuel." },
  ], it: [
    { type: "paragraph",html: "Prima di compilare un solo campo della domanda Tradovate, deve rispondere a una domanda: di chi è il conto? Opera con il suo denaro, condivide un conto con un partner, lo gestisce tramite una società o investe per la pensione? Ogni risposta porta a un tipo di conto diverso, e sceglierne uno sbagliato è il modo più rapido per bloccare la domanda. Ecco come funziona ciascun tipo, così potrà scegliere con sicurezza." },
    { type: "heading",text: "Che cosa sono i tipi di conto Tradovate?" },
    { type: "paragraph",html: "Un tipo di conto Tradovate è la struttura legale di titolarità che sceglie quando apre un conto di trading sui futures. Stabilisce chi possiede il conto, come vengono tassati i profitti e quali documenti dovrà presentare con la domanda. Tradovate offre conti individuali, cointestati, di entità (società, LLC, partnership e trust) e IRA/pensionistici. Abbini il conto alla sua situazione fin dall’inizio e finanziamento e trading saranno molto più semplici." },
    { type: "heading",text: "I tipi di conto Tradovate spiegati: passo dopo passo" },
    {
      type: "steps",
      items: [
        { title: "Conti individuali e cointestati", html: "Un conto individuale è intestato e operato da una sola persona ed è il più rapido da aprire. La domanda online di solito richiede solo pochi minuti. Un conto cointestato è condiviso da due o più persone, ad esempio un coniuge o un socio. Ogni titolare viene indicato nella domanda e fornisce i propri documenti d’identità, quindi li prepari prima di iniziare." },
        { title: "Conti di entità (società, LLC, partnership, trust)", html: "Se opera tramite un’impresa o una struttura legale, Tradovate offre conti corporate, LLC, partnership e trust. Sono intestati all’entità e non a una persona fisica, quindi si aspetti più documentazione: atti costitutivi, un EIN o codice fiscale e i nomi di tutte le persone autorizzate a operare sul conto. Scelga la struttura che corrisponde a come l’impresa è effettivamente registrata, non quella che sembra più simile." },
        { title: "Conti IRA e pensionistici", html: "Sì, può operare sui futures all’interno di un conto pensionistico. Tradovate offre conti IRA tramite un custode terzo, Equity Trust, che collabora con Tradovate per servire i clienti pensionistici. Al momento della domanda, selezioni <strong class='text-white'>IRA</strong> come Account Type e inserisca <strong class='text-white'>Equity Trust</strong> come Account Custodian. Equity Trust custodisce i fondi pensionistici mentre lei opera sui futures all’interno dell’IRA. Un punto su cui molti inciampano: anche se ha già un login Tradovate o NinjaTrader, deve completare una domanda separata per l’IRA." },
        { title: "Selezioni il tipo di conto nella domanda", html: "Apra la domanda di apertura del conto Tradovate e scelga il tipo di conto dal campo Account Type, poi inserisca i suoi dati personali o quelli dell’entità e carichi i documenti d’identità richiesti. Invii il modulo: il team New Accounts di Tradovate lo esamina e le invia un’e-mail al termine dell’elaborazione. I requisiti di deposito minimo variano in base al tipo di conto e cambiano nel tempo, quindi verifichi i requisiti di finanziamento attuali di Tradovate prima di spostare denaro." },
      ],
    },
    { type: "heading",text: "Perché potrebbe servirle" },
    {
      type: "list",
      items: [
        "Scegliere la giusta struttura di titolarità e fiscale prima di presentare la domanda",
        "Aprire un conto cointestato per operare insieme al coniuge o al partner",
        "Operare sui futures tramite una società con un conto corporate, LLC, partnership o trust",
        "Investire per la pensione in un’IRA a tassazione agevolata tramite Equity Trust",
        "Avere pronti i documenti corretti perché la domanda non subisca ritardi",
      ],
    },
    { type: "heading",text: "Automatizzi tutto con PickMyTrade" },
    { type: "paragraph",html: "Una volta aperto il conto Tradovate, <strong class='text-white'>PickMyTrade collega i suoi alert di TradingView direttamente ad esso</strong>, così ingressi, uscite e ordini bracket partono automaticamente con qualunque tipo di conto abbia scelto, senza clic manuali." },
  ] },
  ctaHeading: { en: "Automate Your Tradovate Trades", de: "Automatisieren Sie Ihre Tradovate-Trades", es: "Automatice sus operaciones en Tradovate", fr: "Automatisez vos trades Tradovate", it: "Automatizzi i suoi trade su Tradovate" },
  ctaText: { en: "Once your account is open, let entries, exits, and brackets fire automatically. PickMyTrade links your TradingView alerts straight to your Tradovate account.", de: "Sobald Ihr Konto eröffnet ist, lassen Sie Einstiege, Ausstiege und Brackets automatisch ausführen. PickMyTrade verbindet Ihre TradingView-Alerts direkt mit Ihrem Tradovate-Konto.", es: "Una vez abierta su cuenta, deje que las entradas, salidas y brackets se ejecuten automáticamente. PickMyTrade conecta sus alertas de TradingView directamente con su cuenta de Tradovate.", fr: "Une fois votre compte ouvert, laissez vos entrées, sorties et brackets s’exécuter automatiquement. PickMyTrade relie vos alertes TradingView directement à votre compte Tradovate.", it: "Una volta aperto il conto, lasci che ingressi, uscite e bracket partano automaticamente. PickMyTrade collega i suoi alert di TradingView direttamente al suo conto Tradovate." },
  ctaButtonText: { en: "Start Your Free 7-Day Trial", de: "Starten Sie Ihre kostenlose 7-Tage-Testphase", es: "Comience su prueba gratuita de 7 días", fr: "Commencez votre essai gratuit de 7 jours", it: "Inizi la prova gratuita di 7 giorni" },
