---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "tradovate-close-account";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/how-to/${SLUG}`;

const META_TITLE = "How to Close Your Tradovate Account";
const META_DESCRIPTION =
  "Close a Tradovate account the right way: zero out your balance, cancel plan and add-on renewals, and dodge surprise inactivity fees and charges.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "So schließen Sie Ihr Tradovate-Konto", es: "Cómo cerrar su cuenta de Tradovate", fr: "Comment fermer votre compte Tradovate", it: "Come chiudere il Suo account Tradovate" },
  dek: { en: "Tradovate doesn't hand you a delete button. Here's exactly how to close an account by zeroing your balance and killing every renewal, step by step.", de: "Tradovate bietet keinen Löschen-Button. So schließen Sie ein Konto Schritt für Schritt, indem Sie den Kontostand auf null bringen und jede Verlängerung beenden.", es: "Tradovate no ofrece un botón para eliminar la cuenta. Así se cierra una cuenta paso a paso: dejando el saldo en cero y cancelando todas las renovaciones.", fr: "Tradovate ne propose pas de bouton de suppression. Voici, étape par étape, comment fermer un compte en ramenant votre solde à zéro et en désactivant chaque renouvellement.", it: "Tradovate non offre un pulsante per eliminare l'account. Ecco, passo dopo passo, come chiudere un account azzerando il saldo e disattivando ogni rinnovo." },
  readTime: { en: "5 min read", de: "5 Min. Lesezeit", es: "Lectura de 5 min", fr: "Lecture : 5 min", it: "Lettura di 5 min" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "Here's the part that trips people up: Tradovate doesn't hand you a big red \"Delete My Account\" button. There's no form to submit and no 30-day countdown to sit through. You close a Tradovate account by doing two things, pulling your money out so the balance sits at zero, and switching off every subscription that would otherwise auto-renew. Do both and the account goes dormant. No inactivity fees, no stray charges, nothing left hanging over you." },
    { type: "paragraph", html: "That's the whole game. The steps below run through it in order, and there's a note at the bottom for anyone on a prop-firm evaluation account, that one works differently." },
    { type: "heading", text: "What \"Closing\" Actually Means Here" },
    { type: "paragraph", html: "Tradovate treats an account as closed once it holds no money and has nothing set to renew. There's no deletion step because there's nothing to delete on your end, a zero balance with all renewals off <em>is</em> the closed state. The flip side matters too: leave a few dollars in the account or a live plan attached, and you can keep getting billed or catch an inactivity fee down the line. So the target is simple. A clean $0 balance and not a single active renewal." },
    { type: "heading", text: "Before You Start" },
    {
      type: "list",
      items: [
        "Close out any open positions so nothing's live when you withdraw.",
        "Know which plan you're on, <a href='https://pickmytrade.trade/how-to/tradovate-account-plans/'>Free, Monthly, or Lifetime</a>, and list any add-ons or data feeds you pay for.",
        "Personal account or prop-firm evaluation? They close through completely different doors (details at the end).",
      ],
    },
    { type: "heading", text: "The Steps" },
    {
      type: "steps",
      items: [
        { title: "Flatten Positions and Withdraw Your Full Balance", html: "Close any open trades first. Then request a withdrawal for the <strong class='text-white'>entire</strong> cash balance, either by ACH or wire. You can't call an account closed while money is still parked in it, so this comes first. Withdrawals take a few business days to land, so start here and let it clear before you move on. If you're fuzzy on the mechanics, the <a href='https://pickmytrade.trade/how-to/tradovate-withdraw-funds/'>Tradovate withdrawal walkthrough</a> covers ACH versus wire, fees, and timing." },
        { title: "Cancel Your Monthly Account Plan", html: "Head to your Account Dashboard, the billing side of Tradovate, not the trading app. Open the User Profile menu in the top-right corner, choose <strong class='text-white'>Settings</strong>, then open the <strong class='text-white'>Plans</strong> tab. Under your Monthly Account Plan you'll find a <strong class='text-white'>Cancel Plan</strong> option. Click it and you'll see an expiration date appear: you keep the plan through the billing period you already paid for, and you won't be charged again after that. On the Free plan? Skip this step. On Lifetime? There's no recurring plan to cancel, so you skip it too." },
        { title: "Cancel Add-On and Market-Data Subscriptions", html: "This is the one people forget, and it's usually what causes a charge to sneak through after everything else is done. In the trading platform, open <strong class='text-white'>Application Settings</strong> and go to <strong class='text-white'>Subscriptions</strong>. Scroll to <strong class='text-white'>Market Data</strong> and check for any add-ons too, things like a TradingView connection, API access, or an exchange data feed. Hit <strong class='text-white'>Cancel Renewal</strong> on each one. The feed keeps running through the end of the current month, then it stops for good. Cancel every item you find; a single live data subscription is enough to keep the account \"active\" and billable." },
        { title: "Confirm a Zero Balance and No Active Renewals", html: "Loop back through Settings and the Subscriptions page and give it a once-over. The balance should read $0. Every subscription and plan should show an <em>expiration date</em> rather than a renewal date. Once nothing is set to renew and there's no cash sitting in the account, you're finished, Tradovate now treats it as closed, and with a zero balance and canceled renewals you won't be assessed inactivity fees or any other charges." },
      ],
    },
    { type: "heading", text: "Prop Firm and Evaluation Accounts Are a Different Story" },
    { type: "paragraph", html: "If your Tradovate login came bundled with a prop firm, Apex, Topstep, and the rest, you don't close it from here. There's no balance you personally own to withdraw, and the subscription is billed by the firm, not by Tradovate. You cancel through the firm's own dashboard and contact their support to end the evaluation or funded account. Refund windows, notice periods, and reset rules vary by firm and account size, so check your firm's current rules before you pull the plug." },
    { type: "heading", text: "Still Seeing Charges After All That?" },
    { type: "paragraph", html: "If a charge lands after you've zeroed the balance and killed every renewal, email <strong class='text-white'>support@tradovate.com</strong> with your account details and ask them to confirm the account is inactive. Because there's no formal \"close my account\" ticket, that quick confirmation message is a smart last step, it puts the closure on record and flags anything you might have missed." },
    { type: "heading", text: "Automate This with PickMyTrade" },
    { type: "paragraph", html: "Leaving because babysitting entries and exits by hand wore you down? Before you walk away from futures entirely, see how <strong class='text-white'>PickMyTrade automates your Tradovate orders</strong> straight from TradingView alerts, no manual clicking, no missed fills." },
  ], de: [
    { type: "paragraph",html: "Hier stolpern viele: Tradovate bietet keinen großen roten „Konto löschen“-Button. Es gibt kein Formular zum Absenden und keinen 30-Tage-Countdown, den Sie abwarten müssten. Ein Tradovate-Konto schließen Sie, indem Sie zwei Dinge tun: Sie ziehen Ihr Geld ab, sodass der Kontostand bei null liegt, und Sie schalten jedes Abonnement ab, das sich sonst automatisch verlängern würde. Wenn Sie beides erledigen, ruht das Konto. Keine Inaktivitätsgebühren, keine unerwarteten Abbuchungen, nichts, was noch über Ihnen schwebt." },
    { type: "paragraph",html: "Das ist schon alles. Die folgenden Schritte führen Sie der Reihe nach durch den Vorgang, und am Ende finden Sie einen Hinweis für alle, die ein Prop-Firm-Evaluierungskonto nutzen, denn dort läuft es anders." },
    { type: "heading",text: "Was „Schließen“ hier tatsächlich bedeutet" },
    { type: "paragraph",html: "Tradovate betrachtet ein Konto als geschlossen, sobald es kein Guthaben mehr enthält und nichts mehr zur Verlängerung ansteht. Einen Löschschritt gibt es nicht, weil auf Ihrer Seite nichts zu löschen ist: Ein Kontostand von null bei deaktivierten Verlängerungen <em>ist</em> der geschlossene Zustand. Umgekehrt gilt: Lassen Sie ein paar Dollar auf dem Konto oder einen aktiven Tarif verknüpft, können weiterhin Gebühren anfallen oder später eine Inaktivitätsgebühr. Das Ziel ist also einfach: ein sauberer Kontostand von $0 und keine einzige aktive Verlängerung." },
    { type: "heading",text: "Bevor Sie beginnen" },
    {
      type: "list",
      items: [
        "Schließen Sie alle offenen Positionen, damit bei der Auszahlung nichts mehr läuft.",
        "Wissen Sie, welchen Tarif Sie nutzen, <a href='https://pickmytrade.trade/how-to/tradovate-account-plans/'>Free, Monthly oder Lifetime</a>, und notieren Sie alle Add-ons oder Datenfeeds, die Sie bezahlen.",
        "Privatkonto oder Prop-Firm-Evaluierung? Beide werden auf völlig unterschiedlichen Wegen geschlossen (Details am Ende).",
      ],
    },
    { type: "heading",text: "Die Schritte" },
    {
      type: "steps",
      items: [
        { title: "Positionen glattstellen und den gesamten Kontostand auszahlen", html: "Schließen Sie zuerst alle offenen Trades. Beantragen Sie dann eine Auszahlung des <strong class='text-white'>gesamten</strong> Guthabens, entweder per ACH oder per Überweisung (Wire). Ein Konto lässt sich nicht als geschlossen betrachten, solange noch Geld darauf liegt, deshalb steht dieser Schritt an erster Stelle. Auszahlungen brauchen einige Werktage, beginnen Sie also hier und lassen Sie sie durchlaufen, bevor Sie weitermachen. Wenn Ihnen die Abläufe nicht ganz klar sind: Die <a href='https://pickmytrade.trade/how-to/tradovate-withdraw-funds/'>Anleitung zur Tradovate-Auszahlung</a> erklärt ACH im Vergleich zu Wire, Gebühren und Dauer." },
        { title: "Monatlichen Kontotarif kündigen", html: "Öffnen Sie Ihr Account Dashboard, also die Abrechnungsseite von Tradovate, nicht die Trading-App. Öffnen Sie oben rechts das Menü „User Profile“, wählen Sie <strong class='text-white'>Settings</strong> und öffnen Sie dann den Tab <strong class='text-white'>Plans</strong>. Unter Ihrem Monthly Account Plan finden Sie die Option <strong class='text-white'>Cancel Plan</strong>. Klicken Sie darauf, und es erscheint ein Ablaufdatum: Sie behalten den Tarif bis zum Ende des bereits bezahlten Abrechnungszeitraums und werden danach nicht erneut belastet. Sie nutzen den Free-Tarif? Dann überspringen Sie diesen Schritt. Lifetime? Dort gibt es keinen wiederkehrenden Tarif zu kündigen, auch hier überspringen Sie ihn." },
        { title: "Add-on- und Marktdaten-Abonnements kündigen", html: "Das ist der Punkt, den viele vergessen, und meist der Grund, warum nach allem anderen noch eine Abbuchung durchrutscht. Öffnen Sie in der Trading-Plattform <strong class='text-white'>Application Settings</strong> und gehen Sie zu <strong class='text-white'>Subscriptions</strong>. Scrollen Sie zu <strong class='text-white'>Market Data</strong> und prüfen Sie auch auf Add-ons, etwa eine TradingView-Anbindung, API-Zugang oder einen Börsendatenfeed. Klicken Sie bei jedem Eintrag auf <strong class='text-white'>Cancel Renewal</strong>. Der Feed läuft bis zum Ende des laufenden Monats weiter und stoppt dann endgültig. Kündigen Sie jeden Eintrag, den Sie finden; ein einziges aktives Datenabonnement genügt, damit das Konto „aktiv“ und abrechenbar bleibt." },
        { title: "Kontostand von null und keine aktiven Verlängerungen bestätigen", html: "Gehen Sie noch einmal durch Settings und die Seite Subscriptions und prüfen Sie alles kurz. Der Kontostand sollte $0 anzeigen. Bei jedem Abonnement und jedem Tarif sollte ein <em>Ablaufdatum</em> statt eines Verlängerungsdatums stehen. Sobald nichts mehr zur Verlängerung ansteht und kein Guthaben auf dem Konto liegt, sind Sie fertig: Tradovate behandelt es nun als geschlossen, und bei einem Kontostand von null und gekündigten Verlängerungen fallen weder Inaktivitätsgebühren noch andere Kosten an." },
      ],
    },
    { type: "heading",text: "Prop-Firm- und Evaluierungskonten sind ein anderer Fall" },
    { type: "paragraph",html: "Wenn Ihr Tradovate-Login zusammen mit einer Prop Firm kam, etwa Apex, Topstep und andere, schließen Sie ihn nicht hier. Es gibt kein Guthaben, das Ihnen persönlich gehört und das Sie auszahlen könnten, und das Abonnement wird von der Firma abgerechnet, nicht von Tradovate. Sie kündigen über das Dashboard der Firma und wenden sich an deren Support, um das Evaluierungs- oder Funded-Konto zu beenden. Rückerstattungsfristen, Kündigungsfristen und Reset-Regeln unterscheiden sich je nach Firma und Kontogröße, prüfen Sie also die aktuellen Regeln Ihrer Firma, bevor Sie den Stecker ziehen." },
    { type: "heading",text: "Trotzdem noch Abbuchungen nach alledem?" },
    { type: "paragraph",html: "Wenn nach dem Zurücksetzen des Kontostands auf null und dem Beenden aller Verlängerungen dennoch eine Abbuchung eingeht, schreiben Sie mit Ihren Kontodaten an <strong class='text-white'>support@tradovate.com</strong> und bitten Sie darum, zu bestätigen, dass das Konto inaktiv ist. Da es kein formelles Ticket „Mein Konto schließen“ gibt, ist diese kurze Bestätigungsnachricht ein kluger letzter Schritt: Sie hält die Schließung fest und weist auf alles hin, was Ihnen vielleicht entgangen ist." },
    { type: "heading",text: "Automatisieren Sie das mit PickMyTrade" },
    { type: "paragraph",html: "Gehen Sie, weil Sie das manuelle Betreuen von Ein- und Ausstiegen ermüdet hat? Bevor Sie sich ganz vom Futures-Handel verabschieden: Sehen Sie, wie <strong class='text-white'>PickMyTrade Ihre Tradovate-Orders automatisiert</strong>, direkt aus TradingView-Alerts, ohne manuelles Klicken und ohne verpasste Fills." },
  ], es: [
    { type: "paragraph",html: "Aquí es donde se atascan muchos: Tradovate no ofrece un gran botón rojo de «Eliminar mi cuenta». No hay formulario que enviar ni una cuenta atrás de 30 días que esperar. Una cuenta de Tradovate se cierra haciendo dos cosas: retirar su dinero para que el saldo quede en cero y desactivar toda suscripción que de otro modo se renovaría automáticamente. Si hace ambas, la cuenta queda inactiva. Sin comisiones por inactividad, sin cargos inesperados, sin nada pendiente." },
    { type: "paragraph",html: "Eso es todo. Los pasos siguientes lo recorren en orden, y al final hay una nota para quienes tienen una cuenta de evaluación de una prop firm, que funciona de otra manera." },
    { type: "heading",text: "Qué significa realmente «cerrar» aquí" },
    { type: "paragraph",html: "Tradovate considera cerrada una cuenta cuando no tiene fondos y no tiene nada programado para renovarse. No existe un paso de eliminación porque, por su parte, no hay nada que eliminar: un saldo en cero con todas las renovaciones desactivadas <em>es</em> el estado cerrado. La otra cara también importa: si deja unos dólares en la cuenta o un plan activo asociado, puede seguir recibiendo cargos o una comisión por inactividad más adelante. El objetivo es, por tanto, sencillo: un saldo limpio de $0 y ninguna renovación activa." },
    { type: "heading",text: "Antes de empezar" },
    {
      type: "list",
      items: [
        "Cierre las posiciones abiertas para que no quede nada activo al retirar fondos.",
        "Sepa en qué plan está, <a href='https://pickmytrade.trade/how-to/tradovate-account-plans/'>Free, Monthly o Lifetime</a>, y anote los complementos o feeds de datos que paga.",
        "¿Cuenta personal o evaluación de una prop firm? Se cierran por vías completamente distintas (detalles al final).",
      ],
    },
    { type: "heading",text: "Los pasos" },
    {
      type: "steps",
      items: [
        { title: "Cierre las posiciones y retire todo el saldo", html: "Primero cierre las operaciones abiertas. Después solicite un retiro de <strong class='text-white'>todo</strong> el saldo en efectivo, ya sea por ACH o por transferencia bancaria (wire). No se puede dar por cerrada una cuenta mientras quede dinero en ella, por eso este paso va primero. Los retiros tardan unos días hábiles en llegar, así que empiece por aquí y deje que se complete antes de continuar. Si no tiene claro cómo funciona, la <a href='https://pickmytrade.trade/how-to/tradovate-withdraw-funds/'>guía de retiros de Tradovate</a> explica ACH frente a wire, comisiones y plazos." },
        { title: "Cancele su plan de cuenta mensual", html: "Vaya a su Account Dashboard, la parte de facturación de Tradovate, no la aplicación de trading. Abra el menú User Profile en la esquina superior derecha, elija <strong class='text-white'>Settings</strong> y abra la pestaña <strong class='text-white'>Plans</strong>. Bajo su Monthly Account Plan encontrará la opción <strong class='text-white'>Cancel Plan</strong>. Haga clic y aparecerá una fecha de vencimiento: conserva el plan durante el período de facturación que ya pagó y no se le cobrará de nuevo después. ¿Está en el plan Free? Omita este paso. ¿En Lifetime? No hay un plan recurrente que cancelar, así que también lo omite." },
        { title: "Cancele los complementos y las suscripciones de datos de mercado", html: "Este es el que la gente olvida y, normalmente, el que hace que se cuele un cargo cuando todo lo demás está hecho. En la plataforma de trading, abra <strong class='text-white'>Application Settings</strong> y vaya a <strong class='text-white'>Subscriptions</strong>. Desplácese hasta <strong class='text-white'>Market Data</strong> y compruebe también si hay complementos, como una conexión de TradingView, acceso a la API o un feed de datos de una bolsa. Pulse <strong class='text-white'>Cancel Renewal</strong> en cada uno. El feed sigue funcionando hasta finales del mes en curso y después se detiene definitivamente. Cancele todo lo que encuentre; una sola suscripción de datos activa basta para mantener la cuenta «activa» y facturable." },
        { title: "Confirme un saldo de cero y ninguna renovación activa", html: "Vuelva a recorrer Settings y la página Subscriptions y haga una última revisión. El saldo debe indicar $0. Cada suscripción y cada plan debe mostrar una <em>fecha de vencimiento</em> en lugar de una fecha de renovación. Cuando nada esté programado para renovarse y no quede efectivo en la cuenta, ha terminado: Tradovate la trata ahora como cerrada y, con saldo cero y renovaciones canceladas, no se le aplicarán comisiones por inactividad ni otros cargos." },
      ],
    },
    { type: "heading",text: "Las cuentas de prop firm y de evaluación son otra historia" },
    { type: "paragraph",html: "Si su acceso a Tradovate venía incluido con una prop firm, como Apex, Topstep y otras, no la cierra desde aquí. No hay un saldo que usted posea personalmente para retirar y la suscripción la factura la firma, no Tradovate. Cancela desde el panel de la propia firma y contacta con su soporte para terminar la cuenta de evaluación o financiada. Los plazos de reembolso, los avisos previos y las reglas de reinicio varían según la firma y el tamaño de la cuenta, así que consulte las reglas vigentes de su firma antes de dar el paso." },
    { type: "heading",text: "¿Sigue viendo cargos después de todo esto?" },
    { type: "paragraph",html: "Si entra un cargo después de dejar el saldo en cero y cancelar todas las renovaciones, escriba a <strong class='text-white'>support@tradovate.com</strong> con los datos de su cuenta y pida que confirmen que la cuenta está inactiva. Como no existe un ticket formal de «cerrar mi cuenta», ese breve mensaje de confirmación es un último paso inteligente: deja constancia del cierre y señala cualquier cosa que se le haya podido pasar." },
    { type: "heading",text: "Automatice esto con PickMyTrade" },
    { type: "paragraph",html: "¿Se va porque vigilar manualmente entradas y salidas lo agotó? Antes de alejarse por completo de los futuros, vea cómo <strong class='text-white'>PickMyTrade automatiza sus órdenes de Tradovate</strong> directamente desde las alertas de TradingView, sin clics manuales y sin ejecuciones perdidas." },
  ], fr: [
    { type: "paragraph",html: "Voici ce qui piège beaucoup de monde : Tradovate ne propose pas de gros bouton rouge « Supprimer mon compte ». Il n'y a pas de formulaire à envoyer ni de compte à rebours de 30 jours à attendre. Vous fermez un compte Tradovate en faisant deux choses : retirer votre argent pour que le solde soit à zéro, et désactiver tous les abonnements qui se renouvelleraient automatiquement. Si vous faites les deux, le compte devient dormant. Pas de frais d'inactivité, pas de prélèvements imprévus, plus rien qui vous pende au nez." },
    { type: "paragraph",html: "C'est tout le principe. Les étapes ci-dessous le déroulent dans l'ordre, et une note en bas de page s'adresse à ceux qui ont un compte d'évaluation chez une prop firm : le fonctionnement y est différent." },
    { type: "heading",text: "Ce que « fermer » signifie réellement ici" },
    { type: "paragraph",html: "Tradovate considère un compte comme fermé dès qu'il ne contient plus de fonds et que rien n'est programmé pour se renouveler. Il n'y a pas d'étape de suppression, car il n'y a rien à supprimer de votre côté : un solde à zéro avec tous les renouvellements désactivés <em>est</em> l'état fermé. L'inverse compte aussi : si vous laissez quelques dollars sur le compte ou un forfait actif, vous pouvez continuer à être facturé ou recevoir des frais d'inactivité plus tard. L'objectif est donc simple : un solde net de $0 et aucun renouvellement actif." },
    { type: "heading",text: "Avant de commencer" },
    {
      type: "list",
      items: [
        "Clôturez toutes les positions ouvertes afin que rien ne soit actif au moment du retrait.",
        "Sachez quel forfait vous avez, <a href='https://pickmytrade.trade/how-to/tradovate-account-plans/'>Free, Monthly ou Lifetime</a>, et listez les modules complémentaires ou flux de données que vous payez.",
        "Compte personnel ou évaluation chez une prop firm ? Ils se ferment par des voies complètement différentes (détails à la fin).",
      ],
    },
    { type: "heading",text: "Les étapes" },
    {
      type: "steps",
      items: [
        { title: "Clôturez les positions et retirez la totalité du solde", html: "Fermez d'abord toutes les positions ouvertes. Demandez ensuite le retrait de <strong class='text-white'>la totalité</strong> du solde en espèces, par ACH ou par virement (wire). Vous ne pouvez pas considérer un compte comme fermé tant qu'il contient de l'argent ; cette étape passe donc en premier. Les retraits mettent quelques jours ouvrés à arriver : commencez par là et laissez-le aboutir avant de poursuivre. Si le fonctionnement vous échappe, le <a href='https://pickmytrade.trade/how-to/tradovate-withdraw-funds/'>guide de retrait Tradovate</a> détaille ACH et wire, les frais et les délais." },
        { title: "Annulez votre forfait de compte mensuel", html: "Rendez-vous sur votre Account Dashboard, la partie facturation de Tradovate, et non l'application de trading. Ouvrez le menu User Profile en haut à droite, choisissez <strong class='text-white'>Settings</strong>, puis ouvrez l'onglet <strong class='text-white'>Plans</strong>. Sous votre Monthly Account Plan, vous trouverez l'option <strong class='text-white'>Cancel Plan</strong>. Cliquez dessus et une date d'expiration s'affiche : vous conservez le forfait jusqu'à la fin de la période de facturation déjà payée, et vous ne serez plus débité ensuite. Vous êtes sur le forfait Free ? Passez cette étape. Sur Lifetime ? Il n'y a pas de forfait récurrent à annuler, vous la passez donc aussi." },
        { title: "Annulez les modules complémentaires et les abonnements de données de marché", html: "C'est celle que tout le monde oublie, et c'est généralement ce qui laisse passer un prélèvement une fois tout le reste terminé. Dans la plateforme de trading, ouvrez <strong class='text-white'>Application Settings</strong> et allez dans <strong class='text-white'>Subscriptions</strong>. Faites défiler jusqu'à <strong class='text-white'>Market Data</strong> et vérifiez aussi la présence de modules complémentaires, comme une connexion TradingView, un accès API ou un flux de données d'une bourse. Cliquez sur <strong class='text-white'>Cancel Renewal</strong> pour chacun. Le flux continue jusqu'à la fin du mois en cours, puis s'arrête définitivement. Annulez chaque élément trouvé ; un seul abonnement de données actif suffit à garder le compte « actif » et facturable." },
        { title: "Vérifiez un solde nul et l'absence de renouvellements actifs", html: "Repassez par Settings et la page Subscriptions pour un dernier contrôle. Le solde doit afficher $0. Chaque abonnement et chaque forfait doit indiquer une <em>date d'expiration</em> plutôt qu'une date de renouvellement. Dès que rien n'est programmé pour se renouveler et qu'il n'y a plus d'argent sur le compte, c'est terminé : Tradovate le considère désormais comme fermé, et avec un solde nul et des renouvellements annulés, aucun frais d'inactivité ni autre frais ne vous sera appliqué." },
      ],
    },
    { type: "heading",text: "Les comptes de prop firm et d'évaluation, c'est une autre histoire" },
    { type: "paragraph",html: "Si votre identifiant Tradovate vous a été fourni avec une prop firm, comme Apex, Topstep et les autres, vous ne le fermez pas d'ici. Il n'y a pas de solde que vous possédez personnellement à retirer, et l'abonnement est facturé par la firme, pas par Tradovate. Vous annulez depuis le tableau de bord de la firme et contactez son support pour mettre fin au compte d'évaluation ou financé. Les délais de remboursement, les préavis et les règles de réinitialisation varient selon la firme et la taille du compte ; vérifiez donc les règles en vigueur de votre firme avant de franchir le pas." },
    { type: "heading",text: "Vous voyez encore des prélèvements après tout cela ?" },
    { type: "paragraph",html: "Si un prélèvement arrive après que vous avez ramené le solde à zéro et désactivé tous les renouvellements, écrivez à <strong class='text-white'>support@tradovate.com</strong> avec les informations de votre compte et demandez-leur de confirmer que le compte est inactif. Comme il n'existe pas de ticket officiel « fermer mon compte », ce court message de confirmation est une dernière étape judicieuse : il officialise la fermeture et signale tout ce qui aurait pu vous échapper." },
    { type: "heading",text: "Automatisez cela avec PickMyTrade" },
    { type: "paragraph",html: "Vous partez parce que surveiller manuellement vos entrées et sorties vous a épuisé ? Avant de quitter complètement les contrats à terme, découvrez comment <strong class='text-white'>PickMyTrade automatise vos ordres Tradovate</strong> directement à partir des alertes TradingView, sans clics manuels et sans exécutions manquées." },
  ], it: [
    { type: "paragraph",html: "Ecco il punto in cui molti si bloccano: Tradovate non offre un grande pulsante rosso «Elimina il mio account». Non c'è alcun modulo da inviare né un conto alla rovescia di 30 giorni da attendere. Un account Tradovate si chiude facendo due cose: prelevando il Suo denaro in modo che il saldo sia a zero e disattivando ogni abbonamento che altrimenti si rinnoverebbe automaticamente. Se fa entrambe le cose, l'account diventa dormiente. Nessuna commissione di inattività, nessun addebito imprevisto, nulla che resti in sospeso." },
    { type: "paragraph",html: "Questo è tutto. I passaggi seguenti la guidano in ordine, e in fondo c'è una nota per chi ha un account di valutazione presso una prop firm, che funziona in modo diverso." },
    { type: "heading",text: "Che cosa significa davvero «chiudere» in questo caso" },
    { type: "paragraph",html: "Tradovate considera chiuso un account quando non contiene fondi e non ha nulla in programma per il rinnovo. Non esiste un passaggio di eliminazione perché, da parte Sua, non c'è nulla da eliminare: un saldo a zero con tutti i rinnovi disattivati <em>è</em> lo stato di chiusura. Vale anche il contrario: se lascia qualche dollaro nell'account o un piano attivo collegato, può continuare a ricevere addebiti o una commissione di inattività in seguito. L'obiettivo è quindi semplice: un saldo pulito di $0 e nemmeno un rinnovo attivo." },
    { type: "heading",text: "Prima di iniziare" },
    {
      type: "list",
      items: [
        "Chiuda tutte le posizioni aperte, così non c'è nulla di attivo quando preleva.",
        "Sappia quale piano ha, <a href='https://pickmytrade.trade/how-to/tradovate-account-plans/'>Free, Monthly o Lifetime</a>, ed elenchi gli add-on o i feed di dati che paga.",
        "Account personale o valutazione presso una prop firm? Si chiudono attraverso strade completamente diverse (dettagli alla fine).",
      ],
    },
    { type: "heading",text: "I passaggi" },
    {
      type: "steps",
      items: [
        { title: "Chiuda le posizioni e prelevi l'intero saldo", html: "Chiuda prima di tutto le operazioni aperte. Poi richieda il prelievo dell'<strong class='text-white'>intero</strong> saldo in contanti, tramite ACH o bonifico (wire). Non può considerare chiuso un account finché ci sono ancora fondi al suo interno, quindi questo passaggio viene per primo. I prelievi richiedono alcuni giorni lavorativi per arrivare: inizi da qui e lasci che si completi prima di proseguire. Se non ha chiari i dettagli, la <a href='https://pickmytrade.trade/how-to/tradovate-withdraw-funds/'>guida al prelievo di Tradovate</a> spiega ACH e wire, commissioni e tempistiche." },
        { title: "Annulli il Suo piano account mensile", html: "Vada al Suo Account Dashboard, la parte di fatturazione di Tradovate, non l'app di trading. Apra il menu User Profile in alto a destra, scelga <strong class='text-white'>Settings</strong> e apra la scheda <strong class='text-white'>Plans</strong>. Sotto il Suo Monthly Account Plan troverà l'opzione <strong class='text-white'>Cancel Plan</strong>. Ci clicchi e comparirà una data di scadenza: mantiene il piano per il periodo di fatturazione già pagato e in seguito non verrà addebitato di nuovo. Ha il piano Free? Salti questo passaggio. Lifetime? Non c'è alcun piano ricorrente da annullare, quindi lo salta comunque." },
        { title: "Annulli gli add-on e gli abbonamenti ai dati di mercato", html: "È il passaggio che tutti dimenticano e di solito è la causa di un addebito che passa dopo che tutto il resto è stato fatto. Nella piattaforma di trading, apra <strong class='text-white'>Application Settings</strong> e vada su <strong class='text-white'>Subscriptions</strong>. Scorra fino a <strong class='text-white'>Market Data</strong> e controlli anche la presenza di add-on, come una connessione TradingView, l'accesso API o un feed di dati di una borsa. Clicchi su <strong class='text-white'>Cancel Renewal</strong> per ciascuno. Il feed continua fino alla fine del mese in corso, poi si ferma definitivamente. Annulli ogni voce che trova; basta un solo abbonamento dati attivo per mantenere l'account «attivo» e fatturabile." },
        { title: "Confermi un saldo a zero e nessun rinnovo attivo", html: "Ripassi da Settings e dalla pagina Subscriptions per un ultimo controllo. Il saldo deve indicare $0. Ogni abbonamento e ogni piano deve mostrare una <em>data di scadenza</em> anziché una data di rinnovo. Quando nulla è in programma per il rinnovo e non ci sono più contanti nell'account, ha finito: Tradovate ora lo considera chiuso e, con saldo zero e rinnovi annullati, non Le verranno applicate commissioni di inattività né altri addebiti." },
      ],
    },
    { type: "heading",text: "Gli account prop firm e di valutazione sono un'altra storia" },
    { type: "paragraph",html: "Se il Suo login Tradovate è arrivato insieme a una prop firm, come Apex, Topstep e le altre, non lo chiude da qui. Non c'è un saldo che Le appartiene personalmente da prelevare e l'abbonamento è fatturato dalla firm, non da Tradovate. Annulli tramite la dashboard della firm e contatti il suo supporto per terminare l'account di valutazione o finanziato. I termini di rimborso, i preavvisi e le regole di reset variano in base alla firm e alle dimensioni dell'account, quindi controlli le regole correnti della Sua firm prima di procedere." },
    { type: "heading",text: "Vede ancora addebiti dopo tutto questo?" },
    { type: "paragraph",html: "Se arriva un addebito dopo che ha azzerato il saldo e disattivato ogni rinnovo, scriva a <strong class='text-white'>support@tradovate.com</strong> con i dati del Suo account e chieda di confermare che l'account è inattivo. Poiché non esiste un ticket formale «chiudi il mio account», quel breve messaggio di conferma è un ultimo passo intelligente: mette a verbale la chiusura e segnala tutto ciò che potrebbe esserle sfuggito." },
    { type: "heading",text: "Automatizzi tutto questo con PickMyTrade" },
    { type: "paragraph",html: "Se ne va perché gestire a mano ingressi e uscite L'ha sfinita? Prima di abbandonare del tutto i futures, scopra come <strong class='text-white'>PickMyTrade automatizza i Suoi ordini Tradovate</strong> direttamente dagli alert di TradingView, senza clic manuali e senza esecuzioni mancate." },
  ] },
  ctaHeading: { en: "Automate Your Tradovate Trades", de: "Automatisieren Sie Ihre Tradovate-Trades", es: "Automatice sus operaciones en Tradovate", fr: "Automatisez vos trades Tradovate", it: "Automatizzi i Suoi trade su Tradovate" },
  ctaText: { en: "Before you walk away from futures entirely, see how PickMyTrade automates your Tradovate orders straight from TradingView alerts, no manual clicking, no missed fills.", de: "Bevor Sie sich ganz vom Futures-Handel verabschieden: Sehen Sie, wie PickMyTrade Ihre Tradovate-Orders direkt aus TradingView-Alerts automatisiert, ohne manuelles Klicken und ohne verpasste Fills.", es: "Antes de alejarse por completo de los futuros, vea cómo PickMyTrade automatiza sus órdenes de Tradovate directamente desde las alertas de TradingView, sin clics manuales y sin ejecuciones perdidas.", fr: "Avant de quitter complètement les contrats à terme, découvrez comment PickMyTrade automatise vos ordres Tradovate directement à partir des alertes TradingView, sans clics manuels et sans exécutions manquées.", it: "Prima di abbandonare del tutto i futures, scopra come PickMyTrade automatizza i Suoi ordini Tradovate direttamente dagli alert di TradingView, senza clic manuali e senza esecuzioni mancate." },
