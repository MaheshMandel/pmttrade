---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "tradovate-select-prop-accounts";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/how-to/${SLUG}`;

const META_TITLE = "Switch Between Prop Firm Accounts in Tradovate";
const META_DESCRIPTION =
  "Select and switch your active prop firm account from the account dropdown before every trade, so orders never hit the wrong evaluation.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Zwischen Prop-Firm-Konten in Tradovate wechseln", es: "Cambiar entre cuentas de prop firm en Tradovate", fr: "Basculer entre vos comptes de prop firm dans Tradovate", it: "Passare da un conto prop firm all'altro in Tradovate" },
  dek: { en: "Running two or three prop evaluations at once? Here's how to pick the right active account in Tradovate, and how to check it before you send anything.", de: "Sie betreiben zwei oder drei Prop-Evaluierungen gleichzeitig? So wählen Sie in Tradovate das richtige aktive Konto aus und prüfen es, bevor Sie etwas absenden.", es: "¿Gestiona dos o tres evaluaciones prop a la vez? Así se elige la cuenta activa correcta en Tradovate y cómo comprobarla antes de enviar nada.", fr: "Vous menez deux ou trois évaluations prop en parallèle ? Voici comment sélectionner le bon compte actif dans Tradovate et comment le vérifier avant d'envoyer quoi que ce soit.", it: "Gestisce due o tre valutazioni prop contemporaneamente? Ecco come selezionare il conto attivo giusto in Tradovate e come verificarlo prima di inviare qualsiasi cosa." },
  readTime: { en: "5 min read", de: "5 Min. Lesezeit", es: "Lectura de 5 min", fr: "Lecture : 5 min", it: "Lettura di 5 min" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "Running two or three prop evaluations at the same time is normal now. The trouble shows up the second you fire an order and it lands in the wrong account, a rule breach on an account you weren't even trading, or a fill you can't take back. Tradovate keeps every account you're entitled to in one place, and switching the active one takes a single click. Here's how to pick the right account, and more importantly, how to check it before you send anything." },
    { type: "heading", text: "Before You Switch" },
    { type: "paragraph", html: "Your prop accounts only show up once you log in with the credentials your firm handed you, usually a username in the <code>TRAD######</code> format, not your personal Tradovate email. If a funded or evaluation account isn't in the list, you're almost always signed into the wrong profile. Log out and back in with the firm's login and the account appears." },
    { type: "paragraph", html: "One thing worth keeping front of mind: each account carries its own risk rules. Your trailing drawdown, daily loss limit, and max position all change the moment you switch. What's safe on a $150k eval can blow a smaller one. Exact limits vary by firm and account size, check your firm's current rules rather than assuming they carry over." },
    { type: "heading", text: "How to Switch Your Active Account" },
    {
      type: "steps",
      items: [
        { title: "Log In with Your Prop Firm Credentials", html: "Open Tradovate on web or the desktop app and sign in with the username and password from your prop firm's dashboard. Every account tied to those credentials, live evals, funded accounts, and any resets, loads in the same session." },
        { title: "Find the Account Name at the Top", html: "Look at the top-center of the platform. The name sitting there is your active account. Every DOM click, order, and position routes to that account until you change it, so it's the first thing to read whenever you sit down to trade." },
        { title: "Open the Dropdown and Pick an Account", html: "Click the account name. A dropdown opens listing every account you're logged into. Pick the one you want to trade. If you juggle a lot of accounts, the names your firm assigns (like the <code>TRAD######</code> string plus a label) are what you'll be scanning here, so it helps to know which is which." },
        { title: "Confirm the Switch", html: "The account you picked now shows in the top-center slot, and the Positions, Orders, and Account modules refresh to match it. There's no logout and no reconnect, the switch is instant. Take a second to confirm the balance and open positions look like the account you expected before you do anything else." },
        { title: "Check the Account on the Order Widget", html: "This is the step that actually saves accounts. Every DOM and Order Ticket carries its own account field, and it doesn't always follow the top-center selector the way you'd assume. Before you click buy or sell, glance at that field on the widget you're about to trade from and make sure it reads the account you meant. Two seconds here beats an accidental fill on the wrong eval." },
      ],
    },
    { type: "heading", text: "If an Account Is Missing from the List" },
    { type: "paragraph", html: "Two things usually explain a missing account. Either you're logged in under the wrong credentials, personal instead of prop, or one firm's login when the account belongs to another, or the account hasn't finished provisioning yet after a purchase or reset. Log out and back in first. If it still won't appear, the firm controls that account, so reach out to them rather than Tradovate support." },
    { type: "heading", text: "Automate This with PickMyTrade" },
    { type: "paragraph", html: "Trading the same setup across several prop accounts by hand is where mistakes creep in. <strong class='text-white'>PickMyTrade routes one TradingView alert to every Tradovate account at once</strong>, so you set the strategy once and each account fires together, no manual switching between them." },
  ], de: [
    { type: "paragraph",html: "Zwei oder drei Prop-Evaluierungen gleichzeitig zu betreiben, ist heute normal. Das Problem zeigt sich in dem Moment, in dem Sie eine Order absenden und sie im falschen Konto landet: ein Regelverstoß bei einem Konto, das Sie gar nicht handeln wollten, oder eine Ausführung, die sich nicht mehr rückgängig machen lässt. Tradovate hält alle Konten, auf die Sie Anspruch haben, an einem Ort, und das aktive Konto wechseln Sie mit einem einzigen Klick. So wählen Sie das richtige Konto aus und, wichtiger noch, so prüfen Sie es, bevor Sie etwas absenden." },
    { type: "heading",text: "Bevor Sie wechseln" },
    { type: "paragraph",html: "Ihre Prop-Konten erscheinen erst, wenn Sie sich mit den Zugangsdaten anmelden, die Ihre Firma Ihnen mitgeteilt hat, in der Regel ein Benutzername im Format <code>TRAD######</code> und nicht Ihre persönliche Tradovate-E-Mail-Adresse. Wenn ein finanziertes Konto oder ein Evaluierungskonto nicht in der Liste steht, sind Sie fast immer mit dem falschen Profil angemeldet. Melden Sie sich ab und mit dem Login Ihrer Firma wieder an, dann erscheint das Konto." },
    { type: "paragraph",html: "Eines sollten Sie stets im Blick behalten: Jedes Konto hat seine eigenen Risikoregeln. Ihr Trailing Drawdown, das tägliche Verlustlimit und die maximale Positionsgröße ändern sich in dem Moment, in dem Sie wechseln. Was bei einer 150k-Evaluierung sicher ist, kann ein kleineres Konto ruinieren. Die genauen Limits variieren je nach Firma und Kontogröße. Prüfen Sie die aktuellen Regeln Ihrer Firma, statt anzunehmen, dass sie übertragbar sind." },
    { type: "heading",text: "So wechseln Sie Ihr aktives Konto" },
    {
      type: "steps",
      items: [
        { title: "Mit den Zugangsdaten Ihrer Prop-Firma anmelden", html: "Öffnen Sie Tradovate im Web oder in der Desktop-App und melden Sie sich mit dem Benutzernamen und dem Passwort aus dem Dashboard Ihrer Prop-Firma an. Alle mit diesen Zugangsdaten verknüpften Konten, also Live-Evaluierungen, finanzierte Konten und eventuelle Resets, werden in derselben Sitzung geladen." },
        { title: "Den Kontonamen oben suchen", html: "Schauen Sie in die obere Mitte der Plattform. Der dort angezeigte Name ist Ihr aktives Konto. Jeder DOM-Klick, jede Order und jede Position wird diesem Konto zugeordnet, bis Sie es ändern. Es ist also das Erste, was Sie lesen sollten, wenn Sie sich zum Handeln hinsetzen." },
        { title: "Dropdown öffnen und ein Konto auswählen", html: "Klicken Sie auf den Kontonamen. Es öffnet sich ein Dropdown mit allen Konten, bei denen Sie angemeldet sind. Wählen Sie das Konto aus, das Sie handeln möchten. Wenn Sie viele Konten verwalten, sind die von Ihrer Firma vergebenen Namen (etwa der <code>TRAD######</code>-String plus eine Bezeichnung) das, wonach Sie hier suchen. Es hilft daher, zu wissen, welches welches ist." },
        { title: "Den Wechsel bestätigen", html: "Das ausgewählte Konto erscheint nun oben in der Mitte, und die Module Positions, Orders und Account werden entsprechend aktualisiert. Es gibt kein Abmelden und kein erneutes Verbinden, der Wechsel erfolgt sofort. Nehmen Sie sich einen Moment Zeit, um zu prüfen, dass Kontostand und offene Positionen zu dem erwarteten Konto passen, bevor Sie etwas anderes tun." },
        { title: "Konto im Order-Widget prüfen", html: "Dieser Schritt rettet tatsächlich Konten. Jedes DOM und jedes Order Ticket hat sein eigenes Kontofeld, und es folgt nicht immer der Auswahl oben in der Mitte, wie man annehmen würde. Werfen Sie vor dem Klick auf Kaufen oder Verkaufen einen Blick auf dieses Feld in dem Widget, von dem aus Sie handeln, und vergewissern Sie sich, dass dort das gewünschte Konto steht. Zwei Sekunden hier sind besser als eine versehentliche Ausführung in der falschen Evaluierung." },
      ],
    },
    { type: "heading",text: "Wenn ein Konto in der Liste fehlt" },
    { type: "paragraph",html: "Zwei Dinge erklären ein fehlendes Konto meistens. Entweder sind Sie mit den falschen Zugangsdaten angemeldet, also privat statt Prop oder mit dem Login einer Firma, obwohl das Konto zu einer anderen gehört, oder das Konto wurde nach einem Kauf oder Reset noch nicht fertig bereitgestellt. Melden Sie sich zuerst ab und wieder an. Erscheint es dennoch nicht, kontrolliert die Firma dieses Konto. Wenden Sie sich dann an sie und nicht an den Tradovate-Support." },
    { type: "heading",text: "Mit PickMyTrade automatisieren" },
    { type: "paragraph",html: "Dasselbe Setup manuell über mehrere Prop-Konten zu handeln, ist der Punkt, an dem sich Fehler einschleichen. <strong class='text-white'>PickMyTrade leitet einen TradingView-Alert gleichzeitig an alle Tradovate-Konten weiter</strong>. Sie richten die Strategie einmal ein, und jedes Konto wird gemeinsam ausgelöst, ganz ohne manuelles Wechseln." },
  ], es: [
    { type: "paragraph",html: "Gestionar dos o tres evaluaciones prop al mismo tiempo es lo normal hoy en día. El problema aparece en el instante en que envía una orden y acaba en la cuenta equivocada: una infracción de reglas en una cuenta que ni siquiera estaba operando, o una ejecución que no se puede deshacer. Tradovate mantiene en un solo lugar todas las cuentas a las que tiene derecho, y cambiar la cuenta activa lleva un solo clic. Así se elige la cuenta correcta y, lo que es más importante, cómo comprobarla antes de enviar nada." },
    { type: "heading",text: "Antes de cambiar" },
    { type: "paragraph",html: "Sus cuentas prop solo aparecen una vez que inicia sesión con las credenciales que le entregó su firma, normalmente un nombre de usuario con el formato <code>TRAD######</code>, no su correo personal de Tradovate. Si una cuenta fondeada o de evaluación no aparece en la lista, casi siempre es porque ha iniciado sesión con el perfil equivocado. Cierre sesión y vuelva a entrar con el acceso de la firma, y la cuenta aparecerá." },
    { type: "paragraph",html: "Conviene tener presente algo: cada cuenta tiene sus propias reglas de riesgo. Su trailing drawdown, el límite de pérdida diaria y la posición máxima cambian en cuanto cambia de cuenta. Lo que es seguro en una evaluación de 150k puede hacer saltar una más pequeña. Los límites exactos varían según la firma y el tamaño de la cuenta; consulte las normas vigentes de su firma en lugar de suponer que se mantienen." },
    { type: "heading",text: "Cómo cambiar su cuenta activa" },
    {
      type: "steps",
      items: [
        { title: "Inicie sesión con las credenciales de su prop firm", html: "Abra Tradovate en la web o en la aplicación de escritorio e inicie sesión con el usuario y la contraseña del panel de su prop firm. Todas las cuentas asociadas a esas credenciales, evaluaciones en vivo, cuentas fondeadas y cualquier reinicio, se cargan en la misma sesión." },
        { title: "Localice el nombre de la cuenta en la parte superior", html: "Mire la parte superior central de la plataforma. El nombre que aparece ahí es su cuenta activa. Cada clic en el DOM, cada orden y cada posición se dirige a esa cuenta hasta que la cambie, así que es lo primero que debe leer cada vez que se sienta a operar." },
        { title: "Abra el desplegable y elija una cuenta", html: "Haga clic en el nombre de la cuenta. Se abre un desplegable con todas las cuentas en las que ha iniciado sesión. Elija la que desea operar. Si maneja muchas cuentas, lo que irá buscando aquí son los nombres que asigna su firma (como la cadena <code>TRAD######</code> más una etiqueta), por lo que conviene saber cuál es cuál." },
        { title: "Confirme el cambio", html: "La cuenta elegida aparece ahora en el espacio superior central, y los módulos Positions, Orders y Account se actualizan para coincidir. No hace falta cerrar sesión ni reconectar, el cambio es instantáneo. Tómese un segundo para confirmar que el saldo y las posiciones abiertas corresponden a la cuenta esperada antes de hacer cualquier otra cosa." },
        { title: "Compruebe la cuenta en el widget de órdenes", html: "Este es el paso que de verdad salva cuentas. Cada DOM y cada Order Ticket tiene su propio campo de cuenta, y no siempre sigue al selector superior central como cabría esperar. Antes de pulsar comprar o vender, eche un vistazo a ese campo en el widget desde el que va a operar y asegúrese de que muestra la cuenta que quería. Dos segundos aquí valen más que una ejecución accidental en la evaluación equivocada." },
      ],
    },
    { type: "heading",text: "Si falta una cuenta en la lista" },
    { type: "paragraph",html: "Dos cosas suelen explicar una cuenta ausente. O bien ha iniciado sesión con las credenciales equivocadas, personales en lugar de prop, o las de una firma cuando la cuenta pertenece a otra, o bien la cuenta aún no ha terminado de aprovisionarse tras una compra o un reinicio. Cierre sesión y vuelva a entrar primero. Si sigue sin aparecer, la firma controla esa cuenta, así que contáctela a ella y no al soporte de Tradovate." },
    { type: "heading",text: "Automatice esto con PickMyTrade" },
    { type: "paragraph",html: "Operar el mismo setup en varias cuentas prop a mano es donde se cuelan los errores. <strong class='text-white'>PickMyTrade enruta una sola alerta de TradingView a todas las cuentas de Tradovate a la vez</strong>, de modo que configura la estrategia una vez y cada cuenta se dispara al mismo tiempo, sin cambiar manualmente de una a otra." },
  ], fr: [
    { type: "paragraph",html: "Mener deux ou trois évaluations prop en même temps est devenu normal. Le problème survient à l'instant où vous envoyez un ordre et qu'il atterrit sur le mauvais compte : une violation de règle sur un compte que vous ne tradiez même pas, ou une exécution impossible à annuler. Tradovate regroupe en un seul endroit tous les comptes auxquels vous avez droit, et changer de compte actif se fait en un clic. Voici comment choisir le bon compte et, surtout, comment le vérifier avant d'envoyer quoi que ce soit." },
    { type: "heading",text: "Avant de basculer" },
    { type: "paragraph",html: "Vos comptes prop n'apparaissent qu'une fois connecté avec les identifiants que votre firme vous a remis, généralement un nom d'utilisateur au format <code>TRAD######</code> et non votre e-mail personnel Tradovate. Si un compte financé ou d'évaluation ne figure pas dans la liste, c'est presque toujours que vous êtes connecté avec le mauvais profil. Déconnectez-vous puis reconnectez-vous avec l'identifiant de la firme, et le compte apparaîtra." },
    { type: "paragraph",html: "Un point à garder en tête : chaque compte a ses propres règles de risque. Votre drawdown suiveur, votre limite de perte quotidienne et votre position maximale changent dès que vous basculez. Ce qui est sans danger sur une évaluation de 150k peut faire exploser un compte plus petit. Les limites exactes varient selon la firme et la taille du compte ; consultez les règles en vigueur de votre firme plutôt que de supposer qu'elles se reportent d'un compte à l'autre." },
    { type: "heading",text: "Comment changer de compte actif" },
    {
      type: "steps",
      items: [
        { title: "Connectez-vous avec les identifiants de votre prop firm", html: "Ouvrez Tradovate sur le web ou dans l'application de bureau et connectez-vous avec le nom d'utilisateur et le mot de passe issus du tableau de bord de votre prop firm. Tous les comptes liés à ces identifiants, évaluations en réel, comptes financés et éventuelles réinitialisations, se chargent dans la même session." },
        { title: "Repérez le nom du compte en haut", html: "Regardez le haut au centre de la plateforme. Le nom qui s'y trouve est votre compte actif. Chaque clic sur le DOM, chaque ordre et chaque position est acheminé vers ce compte tant que vous ne le changez pas : c'est donc la première chose à lire chaque fois que vous vous installez pour trader." },
        { title: "Ouvrez la liste déroulante et choisissez un compte", html: "Cliquez sur le nom du compte. Une liste déroulante s'ouvre avec tous les comptes auxquels vous êtes connecté. Choisissez celui que vous voulez trader. Si vous jonglez avec beaucoup de comptes, ce sont les noms attribués par votre firme (comme la chaîne <code>TRAD######</code> accompagnée d'un libellé) que vous allez parcourir ici : il est donc utile de savoir lequel est lequel." },
        { title: "Confirmez le changement", html: "Le compte choisi s'affiche désormais en haut au centre, et les modules Positions, Orders et Account se mettent à jour en conséquence. Pas de déconnexion ni de reconnexion, le changement est instantané. Prenez une seconde pour vérifier que le solde et les positions ouvertes correspondent bien au compte attendu avant de faire quoi que ce soit d'autre." },
        { title: "Vérifiez le compte sur le widget d'ordre", html: "C'est l'étape qui sauve réellement des comptes. Chaque DOM et chaque Order Ticket possède son propre champ de compte, et il ne suit pas toujours le sélecteur du haut au centre comme on pourrait le supposer. Avant de cliquer sur acheter ou vendre, jetez un œil à ce champ sur le widget depuis lequel vous allez trader et assurez-vous qu'il affiche le compte voulu. Deux secondes ici valent mieux qu'une exécution accidentelle sur la mauvaise évaluation." },
      ],
    },
    { type: "heading",text: "Si un compte manque dans la liste" },
    { type: "paragraph",html: "Deux causes expliquent généralement un compte manquant. Soit vous êtes connecté avec les mauvais identifiants, personnels au lieu de prop, ou ceux d'une firme alors que le compte appartient à une autre, soit le compte n'a pas fini d'être provisionné après un achat ou une réinitialisation. Déconnectez-vous puis reconnectez-vous d'abord. Si le compte n'apparaît toujours pas, c'est la firme qui le contrôle : contactez-la plutôt que le support de Tradovate." },
    { type: "heading",text: "Automatisez cela avec PickMyTrade" },
    { type: "paragraph",html: "Trader le même setup sur plusieurs comptes prop à la main, c'est là que les erreurs se glissent. <strong class='text-white'>PickMyTrade achemine une seule alerte TradingView vers tous vos comptes Tradovate à la fois</strong> : vous configurez la stratégie une seule fois et chaque compte se déclenche simultanément, sans basculer manuellement de l'un à l'autre." },
  ], it: [
    { type: "paragraph",html: "Gestire due o tre valutazioni prop nello stesso momento oggi è normale. Il problema emerge nell'istante in cui invia un ordine e finisce nel conto sbagliato: una violazione delle regole su un conto che non stava nemmeno operando, o un'esecuzione che non si può annullare. Tradovate tiene in un unico posto tutti i conti a cui ha diritto e cambiare il conto attivo richiede un solo clic. Ecco come scegliere il conto giusto e, soprattutto, come verificarlo prima di inviare qualsiasi cosa." },
    { type: "heading",text: "Prima di cambiare" },
    { type: "paragraph",html: "I Suoi conti prop compaiono solo dopo l'accesso con le credenziali che la Sua società Le ha fornito, di solito un nome utente nel formato <code>TRAD######</code> e non la Sua e-mail personale di Tradovate. Se un conto finanziato o di valutazione non è presente nell'elenco, è quasi sempre perché ha effettuato l'accesso con il profilo sbagliato. Esca e rientri con le credenziali della società e il conto comparirà." },
    { type: "paragraph",html: "Una cosa da tenere sempre presente: ogni conto ha le proprie regole di rischio. Il trailing drawdown, il limite di perdita giornaliera e la posizione massima cambiano nel momento in cui passa a un altro conto. Ciò che è sicuro su una valutazione da 150k può far saltare un conto più piccolo. I limiti esatti variano in base alla società e alla dimensione del conto: verifichi le regole attuali della Sua società invece di dare per scontato che valgano anche altrove." },
    { type: "heading",text: "Come cambiare il conto attivo" },
    {
      type: "steps",
      items: [
        { title: "Accedere con le credenziali della prop firm", html: "Apra Tradovate sul web o nell'app desktop e acceda con il nome utente e la password della dashboard della Sua prop firm. Tutti i conti associati a quelle credenziali, valutazioni live, conti finanziati ed eventuali reset, vengono caricati nella stessa sessione." },
        { title: "Trovare il nome del conto in alto", html: "Guardi in alto al centro della piattaforma. Il nome che vi compare è il Suo conto attivo. Ogni clic sul DOM, ogni ordine e ogni posizione viene instradato a quel conto finché non lo cambia, quindi è la prima cosa da leggere ogni volta che si siede a operare." },
        { title: "Aprire il menu a tendina e scegliere un conto", html: "Faccia clic sul nome del conto. Si apre un menu a tendina con tutti i conti a cui ha effettuato l'accesso. Scelga quello che desidera operare. Se gestisce molti conti, ciò che scorrerà qui sono i nomi assegnati dalla società (come la stringa <code>TRAD######</code> più un'etichetta), quindi è utile sapere quale sia quale." },
        { title: "Confermare il cambio", html: "Il conto scelto compare ora nello spazio in alto al centro e i moduli Positions, Orders e Account si aggiornano di conseguenza. Non occorre uscire né riconnettersi, il cambio è immediato. Si prenda un istante per verificare che il saldo e le posizioni aperte corrispondano al conto previsto prima di fare qualsiasi altra cosa." },
        { title: "Controllare il conto sul widget degli ordini", html: "È il passaggio che salva davvero i conti. Ogni DOM e ogni Order Ticket ha un proprio campo conto, e non sempre segue il selettore in alto al centro come ci si aspetterebbe. Prima di premere acquista o vendi, dia un'occhiata a quel campo sul widget da cui sta per operare e si assicuri che riporti il conto desiderato. Due secondi qui valgono più di un'esecuzione accidentale sulla valutazione sbagliata." },
      ],
    },
    { type: "heading",text: "Se un conto manca dall'elenco" },
    { type: "paragraph",html: "Due cause spiegano di solito un conto mancante. O ha effettuato l'accesso con le credenziali sbagliate, personali anziché prop, oppure quelle di una società quando il conto appartiene a un'altra, oppure il conto non ha ancora completato il provisioning dopo un acquisto o un reset. Esca e rientri per prima cosa. Se continua a non comparire, quel conto è controllato dalla società: si rivolga a lei e non all'assistenza di Tradovate." },
    { type: "heading",text: "Automatizzare tutto con PickMyTrade" },
    { type: "paragraph",html: "Operare lo stesso setup su più conti prop a mano è il punto in cui si insinuano gli errori. <strong class='text-white'>PickMyTrade instrada un solo alert di TradingView a tutti i conti Tradovate contemporaneamente</strong>: imposta la strategia una volta sola e ogni conto si attiva insieme, senza passare manualmente dall'uno all'altro." },
  ] },
  ctaHeading: { en: "Fire Every Account Together", de: "Alle Konten gemeinsam auslösen", es: "Dispare todas las cuentas a la vez", fr: "Déclenchez tous vos comptes ensemble", it: "Attivi tutti i conti insieme" },
