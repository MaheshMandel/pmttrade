---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "tradovate-manage-alerts-log";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/how-to/${SLUG}`;

const META_TITLE = "Edit, Reset & Delete Alerts in Tradovate's Log";
const META_DESCRIPTION =
  "Manage your futures alerts log: edit conditions, re-arm a triggered alert, dismiss or disable it, and delete the ones you no longer need.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Alarme im Tradovate-Log bearbeiten, zurücksetzen und löschen", es: "Cómo editar, restablecer y eliminar alertas en el registro de Tradovate", fr: "Modifier, réinitialiser et supprimer des alertes dans le journal Tradovate", it: "Modificare, reimpostare ed eliminare gli alert nel registro di Tradovate" },
  dek: { en: "A price alert that already fired, or one you fat-fingered a level on, both get cleaned up in the same place. Here's how to work the Alerts log without deleting alerts you actually still want.", de: "Ein Preisalarm, der bereits ausgelöst wurde, oder einer, bei dem Sie sich beim Level vertippt haben: Beides bereinigen Sie an derselben Stelle. So arbeiten Sie mit dem Alerts-Log, ohne Alarme zu löschen, die Sie eigentlich noch brauchen.", es: "Una alerta de precio que ya se disparó, o una en la que se equivocó de nivel, se limpian en el mismo lugar. Así se trabaja con el registro de alertas sin eliminar alertas que todavía quiere conservar.", fr: "Une alerte de prix déjà déclenchée, ou une dont vous avez mal saisi le niveau : les deux se règlent au même endroit. Voici comment utiliser le journal des alertes sans supprimer des alertes dont vous avez encore besoin.", it: "Un alert di prezzo già scattato, o uno in cui ha sbagliato un livello, si sistemano nello stesso posto. Ecco come usare il registro degli alert senza eliminare alert che desidera ancora." },
  readTime: { en: "5 min read", de: "5 Min. Lesezeit", es: "Lectura de 5 min", fr: "Lecture : 5 min", it: "Lettura di 5 min" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "You set a price alert on ES, it fired an hour ago, and now it's just sitting there in your workspace doing nothing. Or maybe you fat-fingered the level and need to nudge it a few ticks. Either way, the Alerts log is where you clean all of that up. It's the one screen that shows every alert you've built, what state it's in, and gives you the buttons to fix, re-arm, mute, or throw them out." },
    { type: "paragraph", html: "Here's how to work the log without deleting alerts you actually still want." },
    { type: "heading", text: "What the Alerts Log Shows You" },
    { type: "paragraph", html: "Open the log and every alert you've created lands in one list, sorted by state:" },
    {
      type: "table",
      headers: ["State", "What it means"],
      rows: [
        ["Active", "Armed and watching. It hasn't fired yet and will trigger the moment its condition is met."],
        ["Triggered", "The condition already hit. It fired once and won't fire again until you re-arm it."],
        ["Disabled", "Paused. It stays in your list but won't fire until you switch it back on."],
      ],
    },
    { type: "paragraph", html: "For each alert you can read its condition (the instrument, position, or account value it's watching, and whether price crosses above, crosses below, or touches a level), the message attached to it, an expiration time, and how many times it has fired. That trigger count is handy when you're wondering whether an alert actually did its job while you were away from the desk." },
    { type: "heading", text: "Manage Alerts in the Log: Step-by-Step" },
    {
      type: "steps",
      items: [
        { title: "Open the Alerts Log", html: "Find the bell-shaped Alerts icon at the top of your workspace, sitting next to the New (+) menu button. Click it to open the New Alert menu, then open the <strong class='text-white'>Alerts Log</strong> (also labeled the <strong class='text-white'>List of Alerts</strong> tab). When an alert has fired, that same bell shows a red dot and your browser plays a sound, so it's usually the thing that sends you here in the first place." },
        { title: "Edit an Alert", html: "Hover over the alert you want to change (or right-click it) and pick <strong class='text-white'>Edit</strong>. That reopens the alert with its current settings, so you can move the price level, flip the condition from crosses-above to crosses-below, rewrite the message, or push out the expiration. Save it and the alert goes back to Active with your new settings. Editing beats deleting and rebuilding from scratch, especially for an alert with a condition you've fine-tuned over time." },
        { title: "Reset (Re-Arm) a Triggered Alert", html: "Once an alert fires, it flips to Triggered and goes quiet. It won't watch that level again on its own. To put it back on duty, hover over the triggered alert and choose <strong class='text-white'>Reset</strong>. That re-arms it with the exact same condition, no rebuilding needed. This is the move for a level you want to hear about every time price revisits it, like the top of a range you keep fading." },
        { title: "Dismiss or Disable an Alert", html: "Two different jobs here, so don't mix them up. <strong class='text-white'>Dismiss</strong> clears the triggered notification and the red dot without deleting the alert. <strong class='text-white'>Disable</strong> pauses an alert entirely, dropping it into the Disabled group so it stops firing but stays in your list for later. Reach for Disable when you're stepping away from a setup for a session but you know you'll want that same level back next week. Nothing's lost, and you flip it back to Active in one click." },
        { title: "Delete an Alert", html: "When you're truly done with an alert, hover over it (or right-click) and choose <strong class='text-white'>Delete</strong>. That pulls it out of the log for good. There's no undo, so make sure you're deleting the dead level and not the one you meant to disable. If there's any chance you'll want the condition again, disable it instead. A clean log is worth keeping, though. Ten stale triggered alerts make it hard to spot the one that actually matters." },
      ],
    },
    { type: "heading", text: "A Few Habits That Keep the Log Usable" },
    { type: "paragraph", html: "Reset the alerts you trade around often instead of rebuilding them. Disable the ones tied to a setup you'll revisit rather than deleting them. And every so often, clear out the truly dead triggered alerts so the log stays readable at a glance. If your alerts are meant to <em>do</em> something, not just ping you, that's where automation comes in." },
    { type: "heading", text: "Automate This with PickMyTrade" },
    { type: "paragraph", html: "Tired of watching for alerts and clicking in the order yourself? <strong class='text-white'>PickMyTrade turns your TradingView alerts into live Tradovate orders automatically</strong>, so a trigger becomes a fill without you at the keyboard." },
  ], de: [
    { type: "paragraph",html: "Sie haben einen Preisalarm auf ES gesetzt, er wurde vor einer Stunde ausgelöst und liegt nun einfach untätig in Ihrem Arbeitsbereich. Oder Sie haben sich beim Level vertippt und müssen ihn um ein paar Ticks verschieben. In beiden Fällen räumen Sie im Alerts-Log auf. Es ist der eine Bildschirm, der jeden von Ihnen erstellten Alarm samt Status zeigt und Ihnen die Schaltflächen gibt, um ihn zu korrigieren, neu zu aktivieren, stummzuschalten oder zu entsorgen." },
    { type: "paragraph",html: "So arbeiten Sie mit dem Log, ohne Alarme zu löschen, die Sie eigentlich noch wollen." },
    { type: "heading",text: "Was das Alerts-Log Ihnen zeigt" },
    { type: "paragraph",html: "Wenn Sie das Log öffnen, landet jeder von Ihnen erstellte Alarm in einer Liste, sortiert nach Status:" },
    { type: "table", headers: ["Status","Bedeutung"], rows: [
      ["Active","Scharf und beobachtend. Er wurde noch nicht ausgelöst und feuert, sobald seine Bedingung erfüllt ist."],
      ["Triggered","Die Bedingung ist bereits eingetreten. Er wurde einmal ausgelöst und feuert nicht erneut, bis Sie ihn wieder scharf stellen."],
      ["Disabled","Pausiert. Er bleibt in Ihrer Liste, feuert aber nicht, bis Sie ihn wieder einschalten."],
    ] },
    { type: "paragraph",html: "Für jeden Alarm sehen Sie seine Bedingung (das Instrument, die Position oder den Kontowert, den er beobachtet, und ob der Preis ein Level nach oben kreuzt, nach unten kreuzt oder berührt), die zugehörige Nachricht, eine Ablaufzeit und wie oft er ausgelöst wurde. Diese Auslösezahl ist praktisch, wenn Sie sich fragen, ob ein Alarm seinen Job getan hat, während Sie nicht am Schreibtisch waren." },
    { type: "heading",text: "Alarme im Log verwalten: Schritt für Schritt" },
    {
      type: "steps",
      items: [
        { title: "Das Alerts-Log öffnen", html: "Suchen Sie das glockenförmige Alerts-Symbol oben in Ihrem Arbeitsbereich, neben der Menüschaltfläche New (+). Klicken Sie darauf, um das Menü New Alert zu öffnen, und öffnen Sie dann das <strong class='text-white'>Alerts Log</strong> (auch als Registerkarte <strong class='text-white'>List of Alerts</strong> bezeichnet). Wenn ein Alarm ausgelöst wurde, zeigt dieselbe Glocke einen roten Punkt und Ihr Browser spielt einen Ton ab, sodass genau das Sie meist überhaupt erst hierher führt." },
        { title: "Einen Alarm bearbeiten", html: "Bewegen Sie den Mauszeiger über den Alarm, den Sie ändern möchten (oder klicken Sie mit der rechten Maustaste darauf), und wählen Sie <strong class='text-white'>Edit</strong>. Der Alarm öffnet sich mit seinen aktuellen Einstellungen erneut, sodass Sie das Preislevel verschieben, die Bedingung von „kreuzt nach oben“ auf „kreuzt nach unten“ ändern, die Nachricht umschreiben oder den Ablauf verlängern können. Speichern Sie, und der Alarm ist mit Ihren neuen Einstellungen wieder Active. Bearbeiten ist besser als Löschen und Neuaufbauen, besonders bei einem Alarm mit einer Bedingung, die Sie über die Zeit verfeinert haben." },
        { title: "Einen ausgelösten Alarm zurücksetzen (neu scharf stellen)", html: "Sobald ein Alarm feuert, wechselt er zu Triggered und wird still. Er beobachtet dieses Level nicht von selbst erneut. Um ihn wieder in den Dienst zu stellen, bewegen Sie den Mauszeiger über den ausgelösten Alarm und wählen <strong class='text-white'>Reset</strong>. Damit wird er mit exakt derselben Bedingung wieder scharf, ohne Neuaufbau. Das ist der richtige Schritt für ein Level, über dessen Wiederbesuch durch den Preis Sie jedes Mal informiert werden möchten, etwa die Oberkante einer Range, die Sie immer wieder faden." },
        { title: "Einen Alarm verwerfen oder deaktivieren", html: "Das sind zwei verschiedene Aufgaben, verwechseln Sie sie also nicht. <strong class='text-white'>Dismiss</strong> löscht die Benachrichtigung des ausgelösten Alarms und den roten Punkt, ohne den Alarm zu löschen. <strong class='text-white'>Disable</strong> pausiert einen Alarm vollständig und legt ihn in die Gruppe Disabled, sodass er nicht mehr feuert, aber für später in Ihrer Liste bleibt. Greifen Sie zu Disable, wenn Sie sich für eine Sitzung von einem Setup entfernen, aber wissen, dass Sie dasselbe Level nächste Woche wieder brauchen. Nichts geht verloren, und mit einem Klick schalten Sie ihn zurück auf Active." },
        { title: "Einen Alarm löschen", html: "Wenn Sie mit einem Alarm endgültig fertig sind, bewegen Sie den Mauszeiger darüber (oder klicken Sie mit der rechten Maustaste) und wählen <strong class='text-white'>Delete</strong>. Er wird dauerhaft aus dem Log entfernt. Es gibt kein Rückgängig, stellen Sie also sicher, dass Sie das tote Level löschen und nicht jenes, das Sie eigentlich deaktivieren wollten. Besteht die Möglichkeit, dass Sie die Bedingung wieder brauchen, deaktivieren Sie ihn stattdessen. Ein aufgeräumtes Log lohnt sich aber. Zehn veraltete ausgelöste Alarme machen es schwer, den einen zu erkennen, der wirklich zählt." },
      ],
    },
    { type: "heading",text: "Einige Gewohnheiten, die das Log nutzbar halten" },
    { type: "paragraph",html: "Setzen Sie Alarme, um die Sie häufig herum handeln, zurück, statt sie neu aufzubauen. Deaktivieren Sie jene, die zu einem Setup gehören, das Sie wieder aufgreifen, statt sie zu löschen. Und räumen Sie ab und zu die wirklich toten ausgelösten Alarme auf, damit das Log auf einen Blick lesbar bleibt. Wenn Ihre Alarme etwas <em>bewirken</em> sollen, statt Sie nur zu benachrichtigen, kommt die Automatisierung ins Spiel." },
    { type: "heading",text: "Automatisieren Sie das mit PickMyTrade" },
    { type: "paragraph",html: "Haben Sie es satt, auf Alarme zu warten und die Order selbst einzutippen? <strong class='text-white'>PickMyTrade wandelt Ihre TradingView-Alarme automatisch in echte Tradovate-Orders um</strong>, sodass aus einem Auslöser ein Fill wird, ohne dass Sie an der Tastatur sitzen." },
  ], es: [
    { type: "paragraph",html: "Configuró una alerta de precio en ES, se disparó hace una hora y ahora simplemente está ahí en su espacio de trabajo sin hacer nada. O quizá se equivocó de nivel y necesita moverlo unos ticks. En ambos casos, el registro de alertas es donde lo arregla todo. Es la única pantalla que muestra cada alerta que ha creado, en qué estado está, y le da los botones para corregirla, rearmarla, silenciarla o descartarla." },
    { type: "paragraph",html: "Así se trabaja con el registro sin eliminar alertas que todavía quiere conservar." },
    { type: "heading",text: "Qué le muestra el registro de alertas" },
    { type: "paragraph",html: "Al abrir el registro, cada alerta que ha creado aparece en una sola lista, ordenada por estado:" },
    { type: "table", headers: ["Estado","Qué significa"], rows: [
      ["Active","Armada y vigilando. Aún no se ha disparado y lo hará en cuanto se cumpla su condición."],
      ["Triggered","La condición ya se cumplió. Se disparó una vez y no volverá a hacerlo hasta que la rearme."],
      ["Disabled","En pausa. Permanece en su lista pero no se disparará hasta que la vuelva a activar."],
    ] },
    { type: "paragraph",html: "De cada alerta puede leer su condición (el instrumento, la posición o el valor de la cuenta que vigila, y si el precio cruza por encima, cruza por debajo o toca un nivel), el mensaje asociado, una hora de vencimiento y cuántas veces se ha disparado. Ese contador de disparos es útil cuando se pregunta si una alerta cumplió su función mientras usted estaba lejos del escritorio." },
    { type: "heading",text: "Gestione alertas en el registro: paso a paso" },
    {
      type: "steps",
      items: [
        { title: "Abra el registro de alertas", html: "Busque el icono de campana de Alerts en la parte superior de su espacio de trabajo, junto al botón de menú New (+). Haga clic para abrir el menú New Alert y luego abra el <strong class='text-white'>Alerts Log</strong> (también denominado pestaña <strong class='text-white'>List of Alerts</strong>). Cuando una alerta se ha disparado, esa misma campana muestra un punto rojo y su navegador emite un sonido, así que normalmente es lo que le trae hasta aquí." },
        { title: "Edite una alerta", html: "Coloque el cursor sobre la alerta que quiere cambiar (o haga clic derecho sobre ella) y elija <strong class='text-white'>Edit</strong>. Eso reabre la alerta con su configuración actual, de modo que puede mover el nivel de precio, cambiar la condición de cruza por encima a cruza por debajo, reescribir el mensaje o ampliar el vencimiento. Guárdela y la alerta vuelve a estar Active con la nueva configuración. Editar es mejor que eliminar y reconstruir desde cero, sobre todo en una alerta con una condición que ha ido afinando con el tiempo." },
        { title: "Restablezca (rearme) una alerta disparada", html: "Una vez que una alerta se dispara, pasa a Triggered y se queda en silencio. No volverá a vigilar ese nivel por sí sola. Para ponerla de nuevo en servicio, coloque el cursor sobre la alerta disparada y elija <strong class='text-white'>Reset</strong>. Eso la rearma con exactamente la misma condición, sin reconstruirla. Es el movimiento adecuado para un nivel del que quiere enterarse cada vez que el precio lo vuelve a visitar, como el techo de un rango que sigue operando a la contra." },
        { title: "Descarte o desactive una alerta", html: "Son dos tareas distintas, así que no las confunda. <strong class='text-white'>Dismiss</strong> borra la notificación de disparo y el punto rojo sin eliminar la alerta. <strong class='text-white'>Disable</strong> pausa una alerta por completo, enviándola al grupo Disabled para que deje de dispararse pero permanezca en su lista para más adelante. Use Disable cuando se aparte de un setup durante una sesión pero sepa que querrá ese mismo nivel la semana próxima. No se pierde nada, y la vuelve a pasar a Active con un clic." },
        { title: "Elimine una alerta", html: "Cuando haya terminado de verdad con una alerta, coloque el cursor sobre ella (o haga clic derecho) y elija <strong class='text-white'>Delete</strong>. Eso la saca del registro de forma definitiva. No hay deshacer, así que asegúrese de eliminar el nivel muerto y no el que pensaba desactivar. Si existe alguna posibilidad de que vuelva a querer la condición, desactívela en su lugar. Eso sí, merece la pena mantener el registro limpio. Diez alertas disparadas obsoletas dificultan ver la que realmente importa." },
      ],
    },
    { type: "heading",text: "Algunos hábitos que mantienen el registro útil" },
    { type: "paragraph",html: "Restablezca las alertas alrededor de las que opera a menudo en lugar de reconstruirlas. Desactive las vinculadas a un setup que retomará en vez de eliminarlas. Y de vez en cuando, limpie las alertas disparadas realmente muertas para que el registro siga siendo legible de un vistazo. Si sus alertas están pensadas para <em>hacer</em> algo, no solo para avisarle, ahí es donde entra la automatización." },
    { type: "heading",text: "Automatice esto con PickMyTrade" },
    { type: "paragraph",html: "¿Cansado de vigilar alertas e introducir la orden usted mismo? <strong class='text-white'>PickMyTrade convierte sus alertas de TradingView en órdenes reales de Tradovate de forma automática</strong>, para que un disparo se convierta en una ejecución sin que usted esté al teclado." },
  ], fr: [
    { type: "paragraph",html: "Vous avez posé une alerte de prix sur ES, elle s’est déclenchée il y a une heure et elle traîne maintenant dans votre espace de travail sans rien faire. Ou peut-être avez-vous mal saisi le niveau et devez-vous le déplacer de quelques ticks. Dans les deux cas, c’est dans le journal des alertes que vous faites le ménage. C’est le seul écran qui affiche chaque alerte que vous avez créée, son état, et qui vous donne les boutons pour la corriger, la réarmer, la mettre en sourdine ou la jeter." },
    { type: "paragraph",html: "Voici comment utiliser le journal sans supprimer des alertes que vous voulez encore." },
    { type: "heading",text: "Ce que le journal des alertes vous montre" },
    { type: "paragraph",html: "Ouvrez le journal et chaque alerte que vous avez créée apparaît dans une seule liste, triée par état :" },
    { type: "table", headers: ["État","Signification"], rows: [
      ["Active","Armée et à l’affût. Elle ne s’est pas encore déclenchée et le fera dès que sa condition sera remplie."],
      ["Triggered","La condition a déjà été atteinte. Elle s’est déclenchée une fois et ne se redéclenchera pas tant que vous ne l’aurez pas réarmée."],
      ["Disabled","En pause. Elle reste dans votre liste mais ne se déclenchera pas tant que vous ne l’aurez pas réactivée."],
    ] },
    { type: "paragraph",html: "Pour chaque alerte, vous pouvez lire sa condition (l’instrument, la position ou la valeur du compte qu’elle surveille, et si le prix franchit un niveau à la hausse, à la baisse ou le touche), le message associé, une heure d’expiration et le nombre de fois où elle s’est déclenchée. Ce compteur de déclenchements est pratique quand vous vous demandez si une alerte a bien fait son travail pendant que vous étiez loin de votre bureau." },
    { type: "heading",text: "Gérer les alertes dans le journal : pas à pas" },
    {
      type: "steps",
      items: [
        { title: "Ouvrir le journal des alertes", html: "Repérez l’icône de cloche Alerts en haut de votre espace de travail, à côté du bouton de menu New (+). Cliquez dessus pour ouvrir le menu New Alert, puis ouvrez le <strong class='text-white'>Alerts Log</strong> (aussi appelé onglet <strong class='text-white'>List of Alerts</strong>). Lorsqu’une alerte s’est déclenchée, cette même cloche affiche un point rouge et votre navigateur émet un son : c’est généralement ce qui vous amène ici en premier lieu." },
        { title: "Modifier une alerte", html: "Survolez l’alerte que vous voulez changer (ou faites un clic droit dessus) et choisissez <strong class='text-white'>Edit</strong>. L’alerte se rouvre avec ses paramètres actuels : vous pouvez déplacer le niveau de prix, faire passer la condition de « franchit à la hausse » à « franchit à la baisse », réécrire le message ou repousser l’expiration. Enregistrez et l’alerte redevient Active avec vos nouveaux paramètres. Modifier vaut mieux que supprimer et reconstruire de zéro, surtout pour une alerte dont vous avez affiné la condition au fil du temps." },
        { title: "Réinitialiser (réarmer) une alerte déclenchée", html: "Une fois qu’une alerte se déclenche, elle passe à Triggered et se tait. Elle ne surveillera pas ce niveau à nouveau d’elle-même. Pour la remettre en service, survolez l’alerte déclenchée et choisissez <strong class='text-white'>Reset</strong>. Elle est alors réarmée avec exactement la même condition, sans reconstruction. C’est le bon geste pour un niveau dont vous voulez être informé chaque fois que le prix le revisite, comme le haut d’une range que vous continuez à contrer." },
        { title: "Ignorer ou désactiver une alerte", html: "Ce sont deux tâches différentes, ne les confondez donc pas. <strong class='text-white'>Dismiss</strong> efface la notification de déclenchement et le point rouge sans supprimer l’alerte. <strong class='text-white'>Disable</strong> met une alerte complètement en pause, en la plaçant dans le groupe Disabled : elle cesse de se déclencher mais reste dans votre liste pour plus tard. Utilisez Disable quand vous vous éloignez d’un setup le temps d’une séance mais savez que vous voudrez ce même niveau la semaine prochaine. Rien n’est perdu, et vous la repassez en Active en un clic." },
        { title: "Supprimer une alerte", html: "Quand vous en avez vraiment fini avec une alerte, survolez-la (ou faites un clic droit) et choisissez <strong class='text-white'>Delete</strong>. Elle est retirée du journal définitivement. Il n’y a pas d’annulation, assurez-vous donc de supprimer le niveau mort et non celui que vous vouliez désactiver. S’il y a la moindre chance que vous ayez de nouveau besoin de la condition, désactivez-la plutôt. Un journal propre vaut toutefois la peine d’être entretenu. Dix alertes déclenchées obsolètes rendent difficile de repérer celle qui compte vraiment." },
      ],
    },
    { type: "heading",text: "Quelques habitudes pour garder le journal exploitable" },
    { type: "paragraph",html: "Réinitialisez les alertes autour desquelles vous tradez souvent au lieu de les reconstruire. Désactivez celles liées à un setup que vous reprendrez plutôt que de les supprimer. Et de temps en temps, nettoyez les alertes déclenchées vraiment mortes pour que le journal reste lisible d’un coup d’œil. Si vos alertes sont censées <em>faire</em> quelque chose, et pas seulement vous prévenir, c’est là que l’automatisation intervient." },
    { type: "heading",text: "Automatisez tout cela avec PickMyTrade" },
    { type: "paragraph",html: "Vous en avez assez de surveiller les alertes et de saisir l’ordre vous-même ? <strong class='text-white'>PickMyTrade transforme automatiquement vos alertes TradingView en ordres Tradovate réels</strong>, pour qu’un déclenchement devienne une exécution sans que vous soyez au clavier." },
  ], it: [
    { type: "paragraph",html: "Ha impostato un alert di prezzo su ES, è scattato un’ora fa e ora è lì nel Suo spazio di lavoro senza fare nulla. Oppure ha sbagliato il livello e deve spostarlo di qualche tick. In entrambi i casi, il registro degli alert è il posto dove sistema tutto. È l’unica schermata che mostra ogni alert che ha creato, in che stato si trova, e Le dà i pulsanti per correggerlo, riarmarlo, silenziarlo o eliminarlo." },
    { type: "paragraph",html: "Ecco come usare il registro senza eliminare alert che desidera ancora." },
    { type: "heading",text: "Cosa Le mostra il registro degli alert" },
    { type: "paragraph",html: "Apra il registro e ogni alert che ha creato compare in un unico elenco, ordinato per stato:" },
    { type: "table", headers: ["Stato","Cosa significa"], rows: [
      ["Active","Armato e in osservazione. Non è ancora scattato e lo farà non appena la sua condizione sarà soddisfatta."],
      ["Triggered","La condizione si è già verificata. È scattato una volta e non scatterà di nuovo finché non lo riarma."],
      ["Disabled","In pausa. Resta nel Suo elenco ma non scatterà finché non lo riattiva."],
    ] },
    { type: "paragraph",html: "Per ogni alert può leggere la sua condizione (lo strumento, la posizione o il valore del conto che osserva, e se il prezzo incrocia un livello al rialzo, al ribasso o lo tocca), il messaggio associato, un orario di scadenza e quante volte è scattato. Quel contatore degli scatti è utile quando si chiede se un alert abbia fatto il suo lavoro mentre era lontano dalla scrivania." },
    { type: "heading",text: "Gestire gli alert nel registro: passo dopo passo" },
